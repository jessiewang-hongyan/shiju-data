[{"title":"晓晴西郊马上","author":"贺铸","text":"夜雨萧萧彻晓闻，不应为我扫尘纷。\n弄鞭十里西郊道，但见青山纳白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别僧永","author":"贺铸","text":"三处分携跨两年，浮云生计本悠然。\n江山胜地端相待，大有东南未尽缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题左顾亭二首 其一","author":"贺铸","text":"馀不亭下舣归舟，访古怀贤百刻留。\n办得千金脱元绪，此心端不为封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题左顾亭二首 其二","author":"贺铸","text":"亭际高枞满百围，不无山鬼此焉依。\n咿呦为话当年事，曾见将军佩印归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病告中答王锜见招","author":"贺铸","text":"伏枥驽骀伏枕人，不应俱是厌京尘。\n东城自有乘肥客，白苧新裁探候春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离冠氏道中","author":"贺铸","text":"别酒厌厌一据鞍，远林微径雪迷漫。\n伤心不似来时路，柳摆东风絮作团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊会亭","author":"贺铸","text":"后日符离复舍舟，马蹄尘土入徐州。\n祇应明月曾相识，伴我时登燕子楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅华寄清凉和上人","author":"贺铸","text":"石头城上客，领取一枝梅。\n何事春消息，今从江北来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦后闻蛩","author":"贺铸","text":"笼灯耿欲灭，枕下虫声切。\n底许事相关，煎人肠断绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清燕堂","author":"贺铸","text":"雀声啧啧燕飞飞，在得残红一两枝。\n睡思乍来还乍去，日长披卷下帘时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野步","author":"贺铸","text":"津头微径望城斜，水落孤村格嫩沙。\n黄草庵中疏雨湿，白头翁妪坐看瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄埭魏氏见江亭","author":"贺铸","text":"浮生欲寄酒杯间，马上谁容一日闲。\n不是登高粗能赋，老夫真负尔江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒宵叹","author":"贺铸","text":"可怜明月光，委曲照空床。\n自是元无梦，更悲今夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡冷水涧投宿万岁岭","author":"贺铸","text":"萧萧黄叶下清沟，白鸟飞来故少留。\n今夜行人短亭宿，小窗风雨梦渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游夷门资福佛祠园","author":"贺铸","text":"百根高树挂凌霄，鶗鴂飞来深处巢。\n心喜它年有归著，白衣居士此诛茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登兴国寺楼","author":"贺铸","text":"怪槐风动绿鬅鬙，廊外时闻演梵僧。\n怊怅无人共樽酒，可怜明月最高层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登如方山","author":"贺铸","text":"楚郊十月尚闻蝉，傍道黄华亦可怜。\n特上西山最高处，长安应在夕阳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答陈传道五首 其二","author":"贺铸","text":"游梁复归宋，南北更相送。\n失得两如何，劳劳不如梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答陈传道五首 其三","author":"贺铸","text":"游宦几人达，不知强健归。\n未容誇昼锦，几见化缁衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答陈传道五首 其五","author":"贺铸","text":"倒橐黄金尽，方悲行路难。\n桂薪炊玉粒，可是乐长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铸年五十八因病废得旨休致一绝寄呈姑苏毗陵诸友","author":"贺铸","text":"求田问舍向吴津，欲著衰残老病身。\n未拜君恩赐剡曲，归来且醉鉴湖春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴六首 其二","author":"贺铸","text":"青鵳啖雀雏，饫饱侮鸢乌。\n不知皂雕力，拿杀北城狐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴六首 其一","author":"贺铸","text":"雏雀学翻飞，不知毛羽微。\n青鵳笑高树，待尔饱朝饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧居对雨二首 其一","author":"贺铸","text":"檐雨溅溅滴砌沙，绿丛深处一榴花。\n小窗隐几俄成梦，堪笑无功饭后茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧居对雨二首 其二","author":"贺铸","text":"平沙四绕护城堤，小雨经旬不作泥。\n似与幽人慰牢落，一双黄鸟隔墙啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题芭蕉叶","author":"贺铸","text":"十亩荒池涨绿萍，南风不见芰荷生。\n隔窗赖有芭蕉叶，未负潇湘夜雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题承天寺竹轩","author":"贺铸","text":"征衫初解就僧床，惠我翛然一枕凉。\n赤日黄尘畏途里，此君风味可能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题毗陵僧舍二首 其一","author":"贺铸","text":"古寺相留跨两年，穷通出处固天然。\n短檠灯火掩书卷，屡听芭蕉夜雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题项羽庙三首 其一","author":"贺铸","text":"分张天下付群雄，回首咸阳卷地空。\n六国三秦随扰攘，锦衣何暇到江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题项羽庙三首 其二","author":"贺铸","text":"楚都陈迹久灰埃，一曲虞兮尚寄哀。\n不作偷生渡江计，可须千里更西来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题项羽庙三首 其三","author":"贺铸","text":"三户睢盱竟破秦，君王武略世称神。\n途穷一夜无遗恨，挈首殷勤予故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题流香亭","author":"贺铸","text":"秋色朝来已十分，远山清瘦露云根。\n芙蕖昨夜惊风雨，叶叶流香有泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题海陵寓舍二首 其一","author":"贺铸","text":"池上千条柳，依依解占春。\n自怜衰飒鬓，不与物争新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题海陵寓舍二首 其二","author":"贺铸","text":"池上雪初消，春鸦已占巢。\n自怜流寓迹，无地可诛茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题贾氏废园","author":"贺铸","text":"丞相园林半手栽，清樽曾为几人开。\n荒榛野蔓换桃李，惭愧春风如故来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赠芥堂老僧遇来","author":"贺铸","text":"岁计江边二顷田，不能多应世间缘。\n闭门密竹荒松里，杯粥炉香六十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"魏城东","author":"贺铸","text":"短短宫墙见杏花，霏霏晚雨湿啼鸦。\n欲将今夜思归梦，凭仗春风吹到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日怀京都旧游","author":"贺铸","text":"昔年九日登临处，把酒梁王旧吹台。\n今年九日登临处，江上黄华殊未开。\n一川落日随朝下，万里西风送雁来。\n节物可惊人更老，宦情归计两悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日寄维扬刘明仲","author":"贺铸","text":"扬舲瓜步背瓜洲，底处孤亭是玉钩。\n蜡烛有心啼别夜，布帆无恙到南州。\n黄华嘉节与何事，白发故人分取愁。\n赖有沧江知客恨，长年西北望京流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登戏马台","author":"贺铸","text":"当时节物此山川，倦客登临独惘然。\n戏马台荒年自久，射蛇公去事空传。\n黄华半老清霜后，白鸟孤飞落照前。\n不与兴亡城下水，稳浮渔艇入淮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十日寄潘邠老","author":"贺铸","text":"明月昔如许，怀人殊不来。\n徒歌桃叶曲，又负菊华开。\n尺纸缄愁去，扁舟载梦回。\n它年鸡黍约，千里信悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二日席上赋","author":"贺铸","text":"仲宣何遽向荆州，谢惠连须更少留。\n二日旧传挑菜节，一樽聊解负薪忧。\n向人草树有佳色，带郭江山皆胜游。\n载酒赋诗从此始，它年耆老话风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳晚泊龟山作","author":"贺铸","text":"薄暮东风不满帆，迟迟未忍去淮南。\n故园犹在北山北，佳节可怜三月三。\n兰叶自供游女佩，芸编聊对故人谈。\n洛桥车骑相望客，曾为吴儿几许惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与张历阳追怀从禽之乐因赋","author":"贺铸","text":"宜秋门外养鹰坊，好草陂头射雉场。\n油幕毡庐张野饮，锦袍貂帽结戎装。\n兴阑落日黄尘断，梦后西风白发长。\n谁念江湖独流寓，此情难话与渔郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广陵茱萸湾晚泊","author":"贺铸","text":"冷云抛雪未成花，过埭东风冻著沙。\n荻浦渔归初下雁，枫桥市散祗啼鸦。\n旧闻南国饶春事，行见东风换物华。\n老病心情亦何有，药囊诗卷是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋日怀寄潘邠老赋","author":"贺铸","text":"西戍角声清且哀，东城鼓动殷然雷。\n雨阑伏槛月可待，风横舣舟君不来。\n得酒未容欢独伯，把书端与睡为媒。\n雪堂敛谷急还舍，更约头陀黄菊开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌江广圣寺虚乐亭","author":"贺铸","text":"避雨孤篷泊柳阴，潮回溪曲稻花深。\n有时白鹭窥鱼下，竟日青蛙伴我吟。\n酒敌无人情落漠，云乡何处老侵寻。\n诛茅拟卜终焉计，不为清风暂解襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌江东乡往还马上作二首 其一","author":"贺铸","text":"黄尘随马染征衣，十里江皋送客晖。\n废井草荒蛙黾怒，下田沙涨芋魁肥。\n解缨拂树弄清浅，横榻扫云飞翠微。\n人生事事不如意，终日念归何日归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌江东乡往还马上作二首 其二","author":"贺铸","text":"悠悠东去欲何之，草草西还可是归。\n残日两竿荒戍远，青山满眼故园非。\n江田经雨菰蒋熟，石路无风蠛蠓飞。\n回羡耕夫闲胜我，早收鸡犬闭柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌江北道中作","author":"贺铸","text":"寒麦田畴雪糁花，暮潮洲渚水吞沙。\n凫鹥长作渔舟伴，桑柘深藏老圃家。\n浊酒纵贤谁与醉，青山有价不容赊。\n南来学得沧浪唱，却著征衫袖马挝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌江石跂觜晚望有怀","author":"贺铸","text":"山色相衔类太行，江流东去亦浑黄。\n鲈鱼鲙美招来客，鸿雁书迟梦故乡。\n五斗月支何足道，一帆风便可能忘。\n归田有计非今日，莫把移文揭草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌江泛舟寓目","author":"贺铸","text":"沧江浩渺寄星槎，望极纷纷两眼花。\n但见潮头澍木杪，直疑山背落天涯。\n鸱夷信得平生乐，仲御尤宜抵死誇。\n伧父惭非能赋手，渔郎若个是诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书国志陈登事后","author":"贺铸","text":"求田问舍良可嘉，元龙偶未思之耶。\n黄鼠长为太仓耗，白云犹有青山家。\n人生欻尔待钻石，世故纷然劳算沙。\n销磨髀肉亦何事，竟作子阳同井蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内翰出龙眠居士写真图","author":"贺铸","text":"落墨龙眠品入神，横筇一见谪仙人。\n孤云老鹤来何处，异石清流有是身。\n瞻仰生风开鬓发，卷舒盥手敬星辰。\n他年莫用黄金铸，传在人间此逼真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"历阳十咏 其二 鸡笼山","author":"贺铸","text":"楚姥昔奔迸，馀生脱沈沦。\n家禽不忍置，信谓妇人仁。\n空笼欻变化，千载高嶙峋。\n可待历湖水，复生桑下尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬申上元有怀金陵旧游","author":"贺铸","text":"瓦官大庭千步方，灯如流萤月如霜。\n高僧共礼旃檀像，游女来焚薰陆香。\n旧国破亡何物在，少年逐乐个侬狂。\n别来白社更牢落，回首衡湘春梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方明古免丧西上山阴贺铸方回以诗送行非敢赠言聊书美志","author":"贺铸","text":"西上迟迟谁挽留，了君方寸慕松楸。\n三年既尽亦当起，五斗有馀非所求。\n早岁向风劳企羡，残生指日愿依投。\n得官傥近柴桑里，应许江边著钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼王子开五首 其五","author":"秦观","text":"已矣知无憾，贤愚共此途。\n白驹驰白日，黄发掩黄垆。\n和氏终归赵，干将不葬吴。\n驽痾如可彊，犹拟奠生刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼王子开五首 其二","author":"秦观","text":"卓尔金闺彦，颀然玉笋班。\n周旋三友益，零落十年间。\n轣辘灵輀动，悠扬素旐还。\n暮年还抱爱，应复辨追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙寅舟次宋城作","author":"贺铸","text":"水馆四边村，登临奈断魂。\n黄花开小径，红粉哭高原。\n舟楫逢新火，松楸老故园。\n斜阳一千里，依约是苏门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永城邂逅周元通再索诗赠别","author":"贺铸","text":"汎汎流萍滚滚蓬，偶然南北偶然逢。\n一樽通济桥边酒，两夜临濉驿外钟。\n行矣风波宜尚慎，归哉尘土不相容。\n事功早立须知退，学稼它年访老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉津晚归马上","author":"贺铸","text":"落日南城陌，东风禁火时。\n醉醒皆自得，单袷正相宜。\n绿树侵高阁，繁花泪曲池。\n未应判节物，可奈故园思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示王泌","author":"贺铸","text":"违离南北几星霜，短发萧萧带尺长。\n执戟郎效官落拓，楚丘生触绪悲凉。\n双凫乘雁谁比数，拉虎批熊犹健彊。\n端恨养疴妨废酒，樽前都属个侬狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴龙节日渡江怀寄二友弟兼示同行","author":"贺铸","text":"燕庭冠佩拜炉香，丸剑纷纷想定场。\n江上烹鱼犹得信，座中惊雁已离行。\n浇愁酩酊一樽酒，破睡咿哑两橹床。\n不特赋诗怀二仲，故呈凡韵恼支郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再送潘仲宝兼寄彭城交旧","author":"贺铸","text":"风雨扁舟幸少留，为君持酒话徐州。\n白鱼紫蟹秋初美，戏马飞鸿梦屡游。\n二阮年来知健否，季真老去尽归休。\n白云庄畔多闲地，不惜横刀直换牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再酬讷师兼简清凉和上人","author":"贺铸","text":"莫谓功名是可希，定知求法不求衣。\n此身于世百无用，异日与君同所归。\n遮眼何关黄卷在，安心更悟白牛非。\n清凉有道平如掌，岂比他方大铁围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同王克慎宿清凉寺兼示和上人孙安之","author":"贺铸","text":"六代风流不可寻，石头胜槩古犹今。\n疏钟答响江山迥，啼鸟忘形松竹深。\n借问白云谁卜筑，拟要明月共登临。\n终投逸少兴公社，蔬粥麻衣事道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同毕绍寓泊永城招李深昆仲","author":"贺铸","text":"满城杨柳正黄繁，几处鞦韆出短垣。\n经雨河流失清浅，带云春色乍寒暄。\n从来嵇阮耽琴酒，况得机云好弟昆。\n咫尺津亭望斋馆，杖藜相过莫辞烦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同道通师之香林马上","author":"贺铸","text":"冰霜节候迟，淮楚早春时。\n白草风头急，黄云日脚垂。\n鸟声投古戍，马力倦长陂。\n吾有官箴畏，劳生尔浪为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮舟居卧病怀寄金陵和上人","author":"贺铸","text":"野泊岁云暮，念归期正赊。\n津童为过客，商舶是邻家。\n雪密鱼依罧，潮回蚌委沙。\n南州人健否，不寄早梅华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州叙游","author":"贺铸","text":"迷藏九曲属樵耕，野草闲花故有情。\n废苑春风遽如许，隔江山色可怜生。\n新声度曲复谁道，古井酌泉聊独清。\n杜紫微灵定相笑，青楼薄倖不知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早发王村道中寄李智父","author":"贺铸","text":"鸡鸣戒徒御，驱马度前陂。\n得雨人耕早，边山日上迟。\n罢休何复道，会合邈无期。\n赖有西来水，悠悠慰我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]