[{"title":"和刘后村杂兴 其八","author":"胡仲弓","text":"近学时妆越样新，空遗畎亩处忠臣。\n烛之武老未为老，刘伯龙贫可是贫。\n造物不应推若辈，江山亦合助诗人。\n挂冠神武当年事，明哲从来要保身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和希膺韵","author":"胡仲弓","text":"醉将浓墨写乌丝，湖海相逢彼一时。\n洗竹仅留墙外笋，买花空拣担头枝。\n白鸥早已寒前约，青鸟谁知误后期。\n惆怅玉箫声已断，倚阑重省寄来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李希膺见寄","author":"胡仲弓","text":"半生几坐阮途穷，可是推敲得句工。\n所见豪雄惟子共，此音今古更谁同。\n西风有檄催行李，明月无情照酒筒。\n我去君留差左计，媒身岂在泛莲红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李希膺春日醉吟","author":"胡仲弓","text":"节物催人白发新，放怀不减少年春。\n叵罗酌酒犹堪醉，古锦为囊未是贫。\n清坐相看情不恶，淡交至久味方真。\n妓围笑指红楼去，寂寞穷吟胡楚宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杜友游清源洞韵","author":"胡仲弓","text":"涉险何如过虎牢，白云堆里著身高。\n登临我欲招元亮，谈笑时能接李翱。\n人境下看犹粟粒，洞天西去有蟠桃。\n学仙恐是虚无说，且向峰头跨六鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和际书记见寄","author":"胡仲弓","text":"人生随聚散，水面看浮萍。\n梦入江湖社，诗传河岳灵。\n免毫挥月颖，鹤毳落霜翎。\n未洗尘埃脚，何因访柏庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和抱拙韵 其一","author":"胡仲弓","text":"关关鸠妇亦收声，天意犹悭一日晴。\n槐绿尽供春昼梦，梅黄尚忆岁寒盟。\n海边书托文鳞便，户外诗来喜鹊鸣。\n千里宦情随处好，秋风何用记莼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和枯崖山居韵","author":"胡仲弓","text":"自了尘缘后，山林恨不深。\n百年浑是梦，万事付无心。\n秋月寮中话，清风竹外吟。\n湖东多胜践，何日共幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和枯崖悟上人韵","author":"胡仲弓","text":"相逢疑夙昔，不拟定交初。\n馈我诗盈轴，知君腹有书。\n空门容不得，吟属问何如。\n云是汤休辈，毋令相见疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵同叔送桂花韵","author":"胡仲弓","text":"少年折桂已心灰，才臭清芬鼻观开。\n喜见月宫和影落，传闻天女散花来。\n黄金枝上留仙粟，白玉台前绝世埃。\n聚远楼空成感慨，不堪时节苦相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和梅臞瀑布韵","author":"胡仲弓","text":"银河清夜决，一派落岩前。\n雷激惊龙蛰，霜飞冷鹤眠。\n醉乡思入圣，吟骨欲登仙。\n世路风波恶，山中别有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和溪翁二首 其二","author":"胡仲弓","text":"片帆湖海阔，移缆晋江滨。\n客思蛩边老，秋蝉雁外新。\n同吟儿对榻，独酌影随身。\n暗卜归时节，修书托便鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和溪翁二首 其一","author":"胡仲弓","text":"学僧居丈室，不似客途中。\n独榻卧明月，长廊受晚风。\n书痴成病懒，诗债喜穷工。\n汩汩尘埃者，吾今愧此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颐斋梅花韵","author":"胡仲弓","text":"寒谷有春意，南枝向北山。\n自经题品后，落在是非间。\n林外竹相亚，篱根鹤伴閒。\n折来休用插，恐点鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和瞻甫韵","author":"胡仲弓","text":"住在壶中小有天，故山猿鹤作忘年。\n云归每失棋盘石，人去不生丹灶烟。\n肯信玉华空有洞，自贪黄粟便无仙。\n我来立尽斜阳暮，犹撚吟髭风月边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜行口占","author":"胡仲弓","text":"夜程多晦昧，举步要分明。\n肯以中途废，须寻直道行。\n心灯长不烬，眼镜自然清。\n白昼昏迷者，荆榛满路生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜过萧寺","author":"胡仲弓","text":"寻僧过野寺，清话捧茶瓯。\n幡影风生树，钟声月在楼。\n梅花薰纸帐，贝叶看银钩。\n为问西来意，因成一夜留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮颐斋以灯前细雨檐花落为韵分得前字又得花字赋二首 其二","author":"胡仲弓","text":"万仞骚台立海涯，堂堂笔阵走龙蛇。\n唤回蝴蝶三更梦，吟落荼蘼一架花。\n座上风流追靖节，酒边豪放逼刘叉。\n幅巾危坐清源□，小待山阴渐熟瓜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮颐斋以灯前细雨檐花落为韵分得前字又得花字赋二首 其一","author":"胡仲弓","text":"春去如惜别，泪雨滴檐前。\n酒病思卢橘，吟魂逐杜鹃。\n堂虚香穗直，风定烛花圆。\n万籁沈清夜，瓦沟闻落泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝应寺","author":"胡仲弓","text":"来借维摩榻，披襟待晚凉。\n鸣蜩喧古木，斗雀堕虚廊。\n染翰题新壁，移樽避夕阳。\n二公亭畔路，爱惹芰荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"废寺","author":"胡仲弓","text":"钟鼓萧条久，谁从此地来。\n僧房无户牖，佛面有尘埃。\n碑断眠荒草，廊空长绿苔。\n鸺鹠并蝙蝠，时或此徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明发","author":"胡仲弓","text":"明发占鸡唱，停骖数暝鸦。\n半生多在路，十日九怀家。\n照水芙蓉色，满园荞麦花。\n归田何日是，对客话桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松湾访僧","author":"胡仲弓","text":"一关锁已透，见性复明心。\n佛屋灯常续，禅房春又深。\n楼空遗稿在，琴古暗尘侵。\n待约许询辈，时来访道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祈雪","author":"胡仲弓","text":"天意怜贫者，冬深雪尚悭。\n朔风吹黑道，云气护青山。\n色瑞占三白，年丰露一斑。\n调元人已老，事体颇相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵 其二","author":"胡仲弓","text":"掩目新亭路，人言似洛阳。\n山河多改变，今古几兴亡。\n有观空鳷鹊，无台栖凤凰。\n当年足歌舞，不拟是偏方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵 其一","author":"胡仲弓","text":"龙虎犹盘踞，前头白鹭洲。\n为今形胜地，往昔帝王州。\n人物金陵古，风烟玉树秋。\n六朝罗绮迹，分付大江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金粟道人","author":"胡仲弓","text":"曾食如瓜枣，蟠桃几度开。\n石榴书壁去，金粟满包来。\n云气侵丹灶，春山入酒杯。\n步虚声渐远，何处觅蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青莲寺避暑","author":"胡仲弓","text":"尽日畏炎夏，随缘到上方。\n此心无热恼，何地不清凉。\n款话移禅榻，高眠背夕阳。\n衣巾并枕簟，长带佛炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯储秀野赴广西制司参议","author":"胡仲弓","text":"时艰急似救头燃，快趁春风著一鞭。\n人道轻车谙路熟，我疑重阃得君贤。\n狨衣便带杨花雪，鹤骨犹胜桂岭烟。\n兵画近来无可议，只消买静向南边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南地","author":"胡仲弓","text":"数点青来海上山，山根断处水漫漫。\n为无南雪地偏暖，才有北风天便寒。\n生理尽归蛮贾去，宦游直作瘴乡看。\n尘迷钜野家何在，纵有云梯见亦难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南雪","author":"胡仲弓","text":"南地无寒脉，胡为雪载涂。\n草池方积玉，瓦屋又跳珠。\n鱼冻难争水，鸦饥懒哺雏。\n玉堂与茅舍，随分有红炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀黄鸟","author":"胡仲弓","text":"怜君金缕衣，失脚蹈危机。\n自是我心恻，非关物命微。\n引雏谁共食，求友便忘归。\n送汝入幽谷，惊魂何处飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客里","author":"胡仲弓","text":"客里多风雨，征衣不厌重。\n轻车须稳驾，狭路易相逢。\n滩浅水声激，山深云气浓。\n迎人野花笑，绝色若为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将之官越上留别诸友","author":"胡仲弓","text":"一官如许冷，况复是清贫。\n槐市风何古，兰亭本却真。\n春行蓬岛外，月满鉴湖滨。\n想得同吟者，携诗举似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思故乡","author":"胡仲弓","text":"随龙南渡后，五世作泉人。\n仅识传家谱，空馀报国身。\n中原无马迹，钜野隔边尘。\n北定知何日，归期未有因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"胡仲弓","text":"春事都无十日留，何妨款段出城游。\n榴花不入诗人眼，柳絮偏供客子愁。\n枝上五禽言似诉，笼中二鼠去如流。\n斜风细雨湖山路，一片花飞人倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴 其七","author":"方岳","text":"鹤骨崭崭疾未瘳，怯行山亦倦登楼。\n久知老去事当尔，自入春来雨不休。\n虚器甚惭居士屩，实封难觅醉乡侯。\n小迟须有佳晴日，待试山翁已健不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴 其十三","author":"方岳","text":"冲雨冲泥处处行，物情殊不可诗情。\n牡丹又是一年过，春事略无三日晴。\n先后笋争滕薛长，东西鸥背晋齐盟。\n山居寂寞谁堪共，杞?菊苗俱可耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴 其十四","author":"方岳","text":"净扫山房不以贫，旋炊野饭唤比邻。\n子规啼处一村雨，芍药开时三径春。\n丘壑自成安乐国，渔樵尚有老成人。\n茅檐相对坐终日，只说桑麻语自真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴 其十一","author":"方岳","text":"高下云藏野老家，纵横水漱竹篱斜。\n勒将春去许多雨，流出山来都是花。\n白首风烟三径草，清时鼓吹一池蛙。\n身閒不耐閒双手，洗甑炊香夜作茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴 其八","author":"方岳","text":"春来多病感颓龄，草药泥瓶不暂停。\n身似漏船难补贴，齿如败屐久凋零。\n炎黄岂解留年寿，庄老聊堪悦性灵。\n长剑拄颐儿戏耳，底须麟阁更图形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池州溪桥","author":"李昴英","text":"万里长江吸一杯，等闲袖剑九华来。\n溪桥独坐无人识，又驾长风跨鹤回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴 其三","author":"方岳","text":"野性最于鱼鸟亲，自知不是世间人。\n生成雪壑冰崖面，收得烟蓑雨笠身。\n杨柳春来青眼旧，山林老去白头新。\n毋多感慨令君瘦，独立斜阳一欠伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日过西湖","author":"胡仲弓","text":"百花如锦柳如烟，妆点西湖二月天。\n便道过从来四圣，扁舟旖旎访三贤。\n钱塘门外苏堤上，丰乐楼前芝寺边。\n个里万般俱索价，惟馀风月不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春郊晚归","author":"胡仲弓","text":"苔钱随履迹，柳絮点春衣。\n塔影留残照，钟声出翠微。\n扶将藜杖去，挑取锦囊归。\n缓步微吟久，重城半掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚山茶花数朵艳甚","author":"胡仲弓","text":"万红彫落尽，留住隔年花。\n独艳迎人笑，残妆带雨斜。\n物情无老少，春意自繁华。\n颜色休相妒，风流别一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴","author":"胡仲弓","text":"寒斋浅酌喜新晴，绝倒湘累赋独醒。\n清坐苦无佳客话，朗吟生怕俗人听。\n五湖四海双尘屐，万壑千岩一画屏。\n云雨从来翻覆手，黄昏更看照泥星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枯崖韵速藏叟和篇","author":"胡仲弓","text":"暗尘侵古镜，抱膝月台吟。\n大吕呼不出，小诗留至今。\n五言诗未下，什袭意何深。\n莫是推敲了，禅馀自赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柬倪梅村","author":"胡仲弓","text":"萧寺相逢喜溢眉，未言心事我先知。\n半生风月樽中酒，十载江湖社里诗。\n满眼秋容关客况，背时春色到南枝。\n翻思旧日长安市，醉拍栏干歌楚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柬萧芸庄","author":"胡仲弓","text":"十载江湖梦，鸿飞不到君。\n近闻吟思苦，半为宦情分。\n往事随流水，怀人看暮云。\n相逢又相别，安得细论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪楼分得车字韵","author":"胡仲弓","text":"江湖诗境阔，终不似楼居。\n老怕吟毡冷，生来酒兴疏。\n爱閒随有鹤，因病出无驴。\n莫笑柴扉窄，犹堪长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独倚","author":"胡仲弓","text":"独倚危楼望，清风动斗牛。\n功名两蛮触，身世一蜉蝣。\n乐道贫何损，吟诗醉便休。\n静中生万感，烧烛看吴钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"结交叹","author":"胡仲弓","text":"湖海相逢一笑嬉，纳交如此岂男儿。\n论心尽道同兰臭，临事无闻伐木诗。\n管鲍虽贫犹忍弃，左羊至死更相知。\n岁寒不负松筠约，除却梅花耐久谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虹桥","author":"胡仲弓","text":"才过虹桥渡，漫山皆紫泥。\n鸥边秋水落，牛背夕阳低。\n酒向污樽饮，诗从板壁题。\n江郎在何许，灵石与天齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺林自知兄登第","author":"胡仲弓","text":"贺客来迟休怪余，新篇准备暮春初。\n群儿得志诚逾望，一第于君非有馀。\n喜脱平生场屋债，饱看太古圣贤书。\n由来天爵无穷乐，人爵虽荣百不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送丁鍊师归福堂","author":"胡仲弓","text":"易东流派远，千载见斯人。\n金鼎烹龙虎，丹书役鬼神。\n形臞心更古，食淡语尤真。\n野鹤冲天去，空馀华表身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送后村去国二首 其二","author":"胡仲弓","text":"累疏笺天乞挂冠，此时便合整归鞍。\n玉音不许难轻去，局面那知竟未安。\n但得中朝常有道，何妨右史左迁官。\n此行不被梅花累，把作寻常物外看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送后村去国二首 其一","author":"胡仲弓","text":"人言责备过春秋，笑出修门肯怨尤。\n去国早知如许急，劝君何事莫来休。\n是非不信无公论，胜负常关第一筹。\n史笔未青先结局，天刑人祸免推求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送汤武谕倅吴门","author":"胡仲弓","text":"诸贤出处最关时，独有先生早见机。\n汉匮昔曾藏谏笔，吴江今可浣朝衣。\n剩留千古清名在，带得一身公论归。\n世事如棋吾懒著，敢将局面例言非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李茂先去国","author":"胡仲弓","text":"榻前一疏犯龙颜，身在危疑进退间。\n自是直言难见售，却于大义颇相关。\n孤忠力为朝廷计，众望公归台省班。\n毕竟名高人所忌，且移别眼看青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送松坡下第调官南归","author":"胡仲弓","text":"同点龙门额，君先赋式微。\n自怜为客久，不忍送人归。\n受钺张油幕，行囊富綵衣。\n江干回首处，云树两依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送罗去华","author":"胡仲弓","text":"江湖如许阔，无地著诗流。\n难觅青精饭，空回明月舟。\n分甘贫国士，莫谒富民侯。\n随处风波恶，无鱼可上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送枯崖归囊山","author":"胡仲弓","text":"江湖无足禁，信步到温陵。\n借榻同为客，打包别有僧。\n禅心如止水，诗句可传灯。\n已尽山阴兴，归欤扫葛藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵汝楫分教建安","author":"胡仲弓","text":"又领皋比走建安，青衿喜色上眉端。\n诗因老去难言别，毡到春来不觉寒。\n当日紫阳传授学，他年粉省校雠官。\n圣门岂必肯私淑，莫把规随一例看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵明叔分教潮阳","author":"胡仲弓","text":"昌黎遗俗在，兴教更烦君。\n地产无名木，春生半水芹。\n诗歌麟趾化，笔补鳄鱼文。\n莫厌官毡冷，相期粉省芸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵庸斋去国","author":"胡仲弓","text":"十年居要路，依旧老书生。\n公论是非定，宗臣去就轻。\n群鸦分地噪，一凤仰天鸣。\n善类俄星散，何因见太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢刑部使君赴召 其二","author":"胡仲弓","text":"中和报政二年间，五马朝天不可攀。\n南国愿留申伯住，东山催起谢公还。\n银钩铁画辉棠荫，玉鉴冰壶照笋斑。\n名在御屏推课最，前途重见玺书颁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]