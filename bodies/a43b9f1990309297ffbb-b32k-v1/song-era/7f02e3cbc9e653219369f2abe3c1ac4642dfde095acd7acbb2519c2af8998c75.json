[{"title":"雨后田间杂纪五首 其五","author":"杨万里","text":"正是山花最闹时，浓浓淡淡未离披。\n映山红与昭亭紫，挽住行人赠一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后田间杂纪五首 其四","author":"杨万里","text":"晴路无泥亦未埃，野云尽薄不全开。\n满山都是长松树，无数杨花何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后田间杂纪五首 其三","author":"杨万里","text":"行到深村麦更深，放低小轿过桑阴。\n再三传语春寒道，好为农家惜绿针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后田间杂纪五首 其二","author":"杨万里","text":"田水高低各斗鸣，溪流奔放更驩声。\n小儿倒撚青梅朵，独立茅檐看客行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后田间杂纪五首 其一","author":"杨万里","text":"稻田滴水价千金，溪涧求分不肯分。\n一雨万畦都水足，却将倾泻作溪浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后行郡圃","author":"杨万里","text":"雨馀行脚古城隈，为爱危亭首屡回。\n无数菊苗齐老去，多时花径不曾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后步东园","author":"杨万里","text":"晴缫金线不胜垂，寒勒青针未放齐。\n拄杖能言忽相报，三三径里已无泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后独登舍北山顶","author":"杨万里","text":"山下生愁热不除，山头小立气全苏。\n自缘著脚高低别，万壑清风岂是无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后晚步郡圃二首 其二","author":"杨万里","text":"风勒归云带雨回，不容老子小徘徊。\n拨忙也到池亭上，昨日卷荷今尽开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后晚步郡圃二首 其一","author":"杨万里","text":"画舫鸣钲野寺钟，暮声惊破翠烟重。\n好风不解藏天巧，彫碎孤云作数峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后登度雪台","author":"杨万里","text":"三日东园近却赊，东风剪剪雨斜斜。\n春容雨打风吹尽，犹有金沙最后花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨作抵暮复晴五首 其五","author":"杨万里","text":"风伯颠狂太劣生，雨师懒困洒来轻。\n若言不被云君误，谁放斜阳作晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨作抵暮复晴五首 其四","author":"杨万里","text":"清平如席是淮流，风起雷奔怒不休。\n一浪飞来惊落胆，早知祇要打船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨作抵暮复晴五首 其三","author":"杨万里","text":"雨痕拂水有如无，雨点飞空密复疏。\n白鹭窥鱼浑欲下，被风吹起不由渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨作抵暮复晴五首 其二","author":"杨万里","text":"细雨如尘复似烟，两淮渡口各收船。\n南商北贾俱星散，古庙无人烧纸钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨作抵暮复晴五首 其一","author":"杨万里","text":"栖鹊无阴庇湿衣，行人仄伞避斜丝。\n船兵归后轿兵去，独立淮河暮雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨足晓立郡圃荷桥","author":"杨万里","text":"郡池六月水方生，便有新荷贴水轻。\n雨后独来无个事，闲听啼鸟话升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨里问讯张定叟通判西园杏花二首 其二","author":"杨万里","text":"梅不嫌疏杏要繁，主人何忍折令残。\n也知雨意将无恶，为勒芳菲故故寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨里问讯张定叟通判西园杏花二首 其一","author":"杨万里","text":"白白红红一树春，晴光炫眼看难真。\n无端昨夜萧萧雨，细锦全机卸作茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨夜独酌","author":"杨万里","text":"清明未到未和柔，过了清明春又休。\n烛下看花遍有思，醉中听雨也无愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨霁","author":"杨万里","text":"雨为梅花遣尽尘，柳勾日影自传神。\n不须苦问春多少，暖幕晴帘总是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"促织","author":"杨万里","text":"一声能遣一人愁，终夕声声晓未休。\n不解缫丝替人织，强来出口促衣裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华道中二首 其二","author":"杨万里","text":"骑吏欢呼不要嗔，二千里外北归人。\n殷勤自掬曹溪水，净洗先生面上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华道中二首 其一","author":"杨万里","text":"清晓新晴物物熙，小风淡日暖归旗。\n不堪回首南华路，去岁梅花细雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南斋前众树披猖红梅居间不肆因为剪剔","author":"杨万里","text":"道是司花定有神，元来造化在诗人。\n扫除碧树无情朵，放出红梅恣意春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南斋前梅花二首 其二","author":"杨万里","text":"朝朝蚤起挂南窗，要看梅花试晓妆。\n两树相挨前后发，老夫一月不烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南望阁皂山","author":"杨万里","text":"惭愧多情阁皂山，去年迎我上西船。\n今来送我还东去，四日相随到进贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南雄驿前双柳","author":"杨万里","text":"外计堂前柳绝奇，南中无此两涡丝。\n午风不动休嫌暑，要看枝枝自在垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南雄解舟","author":"杨万里","text":"一昨春江上水船，即非上水是登天。\n如今下濑江无水，始信登天却易然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南溪上种芙蓉","author":"杨万里","text":"夹水芙容密密栽，缘溪斜立照溪开。\n放教十里红将去，不尽溪流不要回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南溪山居秋日睡起","author":"杨万里","text":"客至从嗔不著冠，起来信手揽书看。\n小蜂得计欺侬睡，偷饮晴窗砚滴乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南溪弄水回望山园梅花","author":"杨万里","text":"梅从山上过溪来，近爱清溪远爱梅。\n溪水声声留我住，梅花朵朵唤人回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南溪薄晚观水","author":"杨万里","text":"谁将沙砾壅堤斜，水怒冲堤自决沙。\n无数小鱼齐乱跳，琉璃盘底簸银花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城头秋望 其二","author":"杨万里","text":"未得霜晴未是晴，霜晴无复点云生。\n鹭鸶不遣鱼惊散，移却惟愁水作声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城头秋望 其一","author":"杨万里","text":"秋光好处顿胡床，旋唤茶瓯浅著汤。\n隔树漏天青破碎，惊风度竹碧匆忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城头晓步二首 其二","author":"杨万里","text":"城东行遍却城西，欲问梅花乞一枝。\n雪糁久团霜后朵，嗔人频看故开迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城头晓步二首 其一","author":"杨万里","text":"古城秋后不胜荒，人迹新行一径长。\n竹影已摇将午日，草根犹有夜来霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城壕冰泮","author":"杨万里","text":"雪力平欺半月晴，东风今日始开冰。\n长壕彻底都销尽，只有楼阴玉一棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至永丰县","author":"杨万里","text":"清和天气半阴晴，下轿携筇取次行。\n不奈永丰山色好，云窥雾看未分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至建昌","author":"杨万里","text":"梅雨芹泥路不佳，闷来小歇野人家。\n绿萍池沼垂杨里，初见芙蕖第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至萍乡欲宿为重客据馆乃出西郊","author":"杨万里","text":"哦诗浑忘路高低，忽怪松梢与路齐。\n准拟醉眠萍实驿，驿西西去更山西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将近许市望见虎丘","author":"杨万里","text":"许市人家远树前，虎丘山色夕阳边。\n石桥分水入别港，茅屋垂杨仍钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将赴高安出吉水报谒县官归涂宿五峰寺二首 其二","author":"杨万里","text":"野寺重来记昨游，一弹指顷几经秋。\n五峰绝顶双松树，相识儿时到白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将赴高安出吉水报谒县官归涂宿五峰寺二首 其一","author":"杨万里","text":"风暄雨暖日和柔，道是秾春不道秋。\n楚楚江枫新结束，柿红衫子锦缠头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将睡四首 其四","author":"杨万里","text":"睡去非不愿，热来无奈何。\n蒙渠致西爽，为汝守南柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将睡四首 其三","author":"杨万里","text":"已被诗为祟，更添茶作魔。\n端能去二者，一武到无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将睡四首 其二","author":"杨万里","text":"一更打二点，夜夜此时睡。\n今夜当此时，不睡缘底事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将睡四首 其一","author":"杨万里","text":"老夫岂不眠，只是眠未得。\n若到睡思来，华胥是谁国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尝桃","author":"杨万里","text":"金桃两饤照银杯，一是栽来一买来。\n香味比尝无两样，人情毕竟爱亲栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山寺竹枝词五首 其五","author":"杨万里","text":"天齐浪自说浯溪，峡与天齐真个齐。\n未必峡山高尔许，看来只恐是天低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山寺竹枝词五首 其四","author":"杨万里","text":"一滩过了一滩奔，一石横来一石蹲。\n若怨古来天设险，峡山不到也由君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山寺竹枝词五首 其三","author":"杨万里","text":"龟鱼到此总回头，不但龟鱼蟹亦愁。\n底事诗人轻老命，犯滩冲石去韶州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山寺竹枝词五首 其二","author":"杨万里","text":"一水双崖千万萦，有天无地只心惊。\n无人打杀杜鹃子，雨外飞来头上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山寺竹枝词五首 其一","author":"杨万里","text":"峡里撑船更不行，棹郎相语改行程。\n却从西岸抛东岸，依旧船头不可撑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居三咏 其三 诚斋","author":"杨万里","text":"浯溪见了紫岩回，独笑春风尽放怀。\n谩向世人谈昨梦，便来唤我作诚斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居三咏 其一 钓雪舟","author":"杨万里","text":"青鞋黄帽绿蓑衣，钓雪舟中雪政飞。\n归自严州无一物，扁舟载得钓台归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居感兴","author":"杨万里","text":"葛制冰餐消几钱，云栖水宿本臞仙。\n回头背汗浑如雨，赚却闲身四十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"度雪台","author":"杨万里","text":"二月尽头三月来，红红白白一齐开。\n酴醾正要金沙映，莫道金沙只漫栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦通以诗送石菖蒲和谢之","author":"杨万里","text":"笑拂孤芳旋汲泉，忽如身堕晓霜天。\n一生寒瘦知何用，只得清名垂万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦通叔祖约游云水寺二首 其二","author":"杨万里","text":"竹深草长绿冥冥，有路如无又断行。\n风亦恐吾愁寺远，殷勤隔雨送钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦通叔祖约游云水寺二首 其一","author":"杨万里","text":"出门天色阴晴半，著雨途间进退难。\n知得招提在何许，只凭田父指林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拾柏子","author":"杨万里","text":"皱壳倾来紫麦新，中藏琼米不胜珍。\n胡桃松实何曾吃，却嚼秋风柏子仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六绝句 其一","author":"杨万里","text":"远目随天去，斜阳著树明。\n犬知何处吠，人在半山行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六绝句 其五","author":"杨万里","text":"日落碧簪外，人行红雨中。\n幽人诗酒里，又是一春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六绝句 其二","author":"杨万里","text":"春醉非关酒，郊行不问涂。\n青天何处了，白鸟入空无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六绝句 其六","author":"杨万里","text":"春色有情意，桃花生暮寒。\n只应催客子，不遣立江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六绝句 其三","author":"杨万里","text":"雾气因山见，波痕到岸消。\n诗人元自懒，物色故相撩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六绝句 其四","author":"杨万里","text":"江水夜韶乐，海棠春贵妃。\n殷勤向春道，莫遣一花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春半闻归雁","author":"杨万里","text":"春光深浅没人知，我正南归雁北归。\n头上一声如话别，一生长是背人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽夜坐三首 其三","author":"杨万里","text":"病夫说病诉旁人，它自开眉我自颦。\n后有病夫看病句，不须告诉亦沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽夜坐三首 其二","author":"杨万里","text":"疾痛呼天天岂知，知而不管亦何为。\n偶拈白傅长庆集，又得驩欣片子时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽夜坐三首 其一","author":"杨万里","text":"春光草草病中休，病眼逢春道是秋。\n祗有青灯怜此老，伴人无睡照人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽舍舟馀杭雨后山行二首 其二","author":"杨万里","text":"树树低桑不要梯，溪溪新涨总平堤。\n杜鹃知我归心急，林外飞来头上啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽舍舟馀杭雨后山行二首 其一","author":"杨万里","text":"前夕船中索簟眠，今朝山下觉衣单。\n春归便肯平平过，须做桐花一信寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴","author":"杨万里","text":"春晴幸好却春阴，云意涔涔半欲霖。\n日色忽开云又合，急收碎影一帘金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴忽霁","author":"杨万里","text":"云膜辛勤护日华，一重縠子一重纱。\n玉奁忽透菱花影，淡与油窗描杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜孤坐三首 其三","author":"杨万里","text":"老来觅句苦难成，细把风斤镂薄冰。\n行到长廊人寂寂，隔窗一点读书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜孤坐三首 其二","author":"杨万里","text":"梅花雪后杏花风，老面逢春只强红。\n诗句行来行去里，情怀不醉不醒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜孤坐三首 其一","author":"杨万里","text":"儿女齁齁鼻息声，虚堂谁伴一先生。\n春寒夜静灯花落，数尽残更睡不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]