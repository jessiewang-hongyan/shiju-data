[{"title":"弟子厚自相山徙居湖塘又复一月矣距外除只数日间光景漂流徒成感慨读新诗兴不能已辄和韵","author":"王之道","text":"相逢休访楚江萍，我老无能一壮丁。\n卜宅又惊三浃日，御琴空感再周星。\n新愁卯酒心先醉，气怯春寒梦易醒。\n却喜故山遥在眼，举头时见竹青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沙窝道中","author":"王之道","text":"十里沙窝路，晴云向暮开。\n褰裳九过水，驻马一观梅。\n岁晚松篁茂，山寒虎豹哀。\n不因王事迫，谁肯此间来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏台悯农","author":"王之道","text":"稻田高下欲分畦，积潦瀰茫隔寸堤。\n天意未收连夜雨，农功良苦半身泥。\n一丸莫救风涛决，千顷空怜稼穑低。\n朝满夕除应可信，望晴心绪忆昌黎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还通上人卷","author":"王之道","text":"格清词苦与谁论，携绕钱塘给事坟。\n所得岂容人继和，朗吟应被鹤听闻。\n月轮冷照千岩雪，霞片轻装万叠云。\n投向吾庐卜知己，拟将诗草为师焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居","author":"王之道","text":"五斗不尔竞，一区聊自营。\n閒看探花信，静坐听松声。\n约客酒初熟，访僧诗漫成。\n有时过闾里，往往竞邀迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光诗首句云饱食复闲眠又成二章 其二 闲眠","author":"司马光","text":"秋怀一事无，暑尽昼凉初。\n竹户静长闭，藜床安有馀。\n逍遥化胡蝶，容易入华胥。\n天上多官府，神仙恐不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒眠","author":"王之道","text":"乍暖经行久，新凉出浴初。\n酒酣春昼永，食饱午钟馀。\n我懒喜聊复，君閒应乐胥。\n年来苦奔走，此味竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丁景仁三叉河留题赠李仲山","author":"王之道","text":"飘零双鬓已星星，万里江湖寄此身。\n山拥青螺初洗雨，水浮苍壁似围春。\n别来兴废同千古，此去荣枯会一新。\n葭薍弥天草如积，宽予犹赖有斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子薳泛江送客用老杜韵","author":"王之道","text":"北风还入夜，波怒未能平。\n江气云烟重，山光水墨轻。\n荧荧渔火乱，惨惨暮寒生。\n咫尺淮乡路，淹留系此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子薳官牌夹口韵是日闻官军破虔贼","author":"王之道","text":"滞留嗟是役，艰险笑吾生。\n此去和风顺，朝来虔贼平。\n湖山争喜气，雁鹜送欢声。\n千里前塘路，应知客念轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子薳春江用老杜韵","author":"王之道","text":"欲去未成去，朔风鸣怒涛。\n片帆洲外举，列岫雾中高。\n竹屋雨沾被，纸窗寒透袍。\n遥应望归艇，向夕走儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和历阳李簿见寄","author":"王之道","text":"短鬓纷垂白，衰颜悴带黄。\n多寒冬更甚，少睡夜能长。\n旧学长荒废，新知感爱忘。\n何时一樽酒，谈咏带江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天宁因上人次韵","author":"王之道","text":"日月漂流一鸟过，别来心迹病维摩。\n是非孰辨聊分谤，诞信相讥要止讹。\n摇落独怜松不改，澄清尝见海无波。\n句中有眼劳开警，更问诸人会得么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老归自属邑三首 其三","author":"王之道","text":"诗涛难放笔头乾，归及初晴素魄圆。\n善誉敢论当世比，佳萹应任老夫传。\n凌云列岫堆螺髻，出水新荷点翠钿。\n报政还朝知不晚，追随能复记当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老归自属邑三首 其二","author":"王之道","text":"往来阴雨恰弥旬，滑滑那堪鸟语频。\n行色可无三日霁，旅怀应付万家春。\n欣闻郊劳开瑶席，想见车旋入锦茵。\n何幸诗筒时寄我，慰怀须信有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老归自属邑三首 其一","author":"王之道","text":"行县归来赋陟冈，青梅应快一樽尝。\n诗成妙墨挥张圣，酒到高歌发楚狂。\n夹道野花围步障，两行官妓簇桥梁。\n嗟予贫悴跧蓬荜，不及郊迎笑举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑二首 其二","author":"王之道","text":"杨柳依依半掩扉，新晴疏影弄斜晖。\n好花觅句忍轻负，幽鸟劝沽良重违。\n閒爱青苔缘砌上，静看蝴蝶扑窗飞。\n雨多不觉芜菁过，又喜盘中笋蕨肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老按属邑二首 其一","author":"王之道","text":"高车西去忽踰旬，坐想登临得句频。\n杨柳阴交山径晚，酴醾香满驿亭春。\n吟馀扫壁时挥翰，醉里投床任吐茵。\n闻说归来欢喜甚，故人相遇是诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孔纯老送司法吴德声","author":"王之道","text":"舞腰回雪奏伊凉，饯设铃齐举别觞。\n如子固宜倾坐客，顾予何计挽征艎。\n交情旧喜推东道，归梦先应到北堂。\n花柳枝头春已闹，伫观超擢寘周行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文倅侯彦嘉二首 其二","author":"王之道","text":"晖晖晴日树头平，望外遥山宿雾轻。\n积潦夜增南浦涨，微风朝送北窗清。\n滞留羁客牵归思，陶写新诗尽物情。\n谁谓春宵常苦短，老来无寐厌长更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文倅侯彦嘉二首 其一","author":"王之道","text":"相逢珠玉走佳章，顾我无能更老苍。\n尝鼎固应从指染，冲天行喜见云翔。\n向来别恨江同远，此去诗情日共长。\n才似二公今二妙，山庭渊角绣肝肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方正叔芍药","author":"王之道","text":"院落青和昼漏长，曲栏高槛倚新妆。\n未饶玉蕊来仙女，那羡莲花似阿郎。\n遣兴勉从吾辈在，追欢难入少年场。\n开缄忽得惊人句，满纸云烟翰墨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方景南参议见赠","author":"王之道","text":"向来疏率任天真，此去扶持护善邻。\n只恐磨砖难作镜，已知行水戒推轮。\n箪瓢本是吾家物，轩冕宁容我辈人。\n多谢诸公共推毂，欣欣寒谷暗生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王冲之喜雨呈张文伯","author":"王之道","text":"指点邦人著眼看，鲁侯雩祭正玄端。\n望来已见千山雨，此去那忧百谷乾。\n高廪有期从穧敛，奔霆何处起龙蟠。\n新诗得得书灵应，传与群公好纵观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王觉民简褒山因上人枣岭魏欣然二首 其二","author":"王之道","text":"君来踰半月，未果一尊同。\n湖水寒应碧，山梨雨自红。\n何时过北牗，今日转西风。\n相去无他地，孤城杖屦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王觉民简褒山因上人枣岭魏欣然二首 其一","author":"王之道","text":"七行才业在，宁久困无津。\n秋到搏风翼，春回纵壑鳞。\n褒山方竞秀，枣岭益争新。\n珍重二三子，诗骚追古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘与可二首 其二","author":"王之道","text":"野塘春草遍，芳树老藤缠。\n远信占黄耳，清游任白颠。\n山光晴抹黛，湖气暖腾烟。\n我有边韶癖，何妨昼日眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘与可二首 其一","author":"王之道","text":"老来无柰懒，春至不胜情。\n万石嗟遗迹，双鱼谢寄声。\n压花朝雨重，酾酒夜泉鸣。\n细把君诗读，冰壶表里清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因上人三首 其三","author":"王之道","text":"白云飞处是吾家，石眼泠泠水一车。\n醉日到来应种竹，梅时过尽好藏茶。\n遥怜壶枣初成实，似说占禾半吐花。\n已得伽陀微妙句，归欤香火讽啰耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因上人三首 其二","author":"王之道","text":"归骑何时遂到家，苍头猎猎走风车。\n丑妻终胜长为客，薄酒能无更饮茶。\n梦断北窗凉似水，望中南亩雨飞花。\n采莲游女应相识，早晚扁舟访若耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因上人三首 其一","author":"王之道","text":"一抨兰若复谁家，坐见羲和下日车。\n燥吻未濡莲社酒，枯肠空搅玉川茶。\n摇风绿竹初翻箨，过雨红葵甚放花。\n得句至今频示我，安能郁郁久兹耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因格非见寄二首 其二","author":"王之道","text":"兀坐时看屋，閒居昼掩门。\n吴吟聊遣兴，楚些欲招魂。\n否泰宜周易，行藏付鲁论。\n不须伤老大，眠食度朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和因格非见寄二首 其一","author":"王之道","text":"青山如我约，终日对柴门。\n学道未忘念，怀君空断魂。\n时来当有用，事往置无论。\n反覆新诗读，谁知老眼昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孙延寿喜雨述怀韵","author":"王之道","text":"小雨霏霏夜接朝，乍惊和气入民谣。\n官逋庶为麦秋缓，酒价定随人意饶。\n欲落枣花蚕断茧，半黄梅子稻移苗。\n书生不惯征徭苦，牢落僧房不自聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和州得旨移粟宣城舟中和何希渊韵","author":"王之道","text":"辙鱼应怪决江流，千里重为叠嶂游。\n颇惯黑甜相对美，可无赤糙为宽忧。\n干戈在眼心还折，勋业何时鬓早秋。\n已办卖刀归买犊，不妨多种白江州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和巩兴宗题回峰寺赠明山主","author":"王之道","text":"江共烟云远，山连薮泽长。\n日从三伏烈，风借九秋凉。\n休作桃花观，聊同柏子香。\n相逢无一事，不必下禅床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和江和仲","author":"王之道","text":"把读新诗忆旧家，深村羸犊短辕车。\n年丰野老常携酒，客至幽禽自唤茶。\n乱后所存惟五柳，老来无意约山花。\n相逢何必曾相识，乘兴时来过此耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和许端夫兄弟二首时端夫出守当涂 其一","author":"王之道","text":"灯火当年记马行，一时人物玩垂裳。\n旧游乱后半芜没，新贵迩来多罪亡。\n我有埙篪相应和，君同兰玉竞芬芳。\n高文已见含元赋，不用研思古战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和许端夫兄弟二首时端夫出守当涂 其二","author":"王之道","text":"相喜何须日寄声，如君无处不知名。\n纵观妙墨云烟动，想见新诗欬唾成。\n带雪山川增绮丽，向春梅柳自欣荣。\n好将十咏图归去，稳步花砖继李程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯父仲球立春即事二首 其二","author":"王之道","text":"对雪酬春付酒杯，兵馀真似复然灰。\n路通千里传书去，人喜三军破贼回。\n梅萼封檀香未彻，湖声撞玉冻初开。\n疏篱败屋休兴叹，幸事群凶不再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯父仲球立春即事二首 其一","author":"王之道","text":"怪得青腰稍霁威，却应缇室报飞灰。\n摇风柳带缘冰重，破冻溪流与岸回。\n群盗传闻湖外去，愁云准拟岁前开。\n玉盘丝菜今萧索，赖有诗筒日往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和余元明时元明邀余同李次元夜饮","author":"王之道","text":"坐中强半是同年，赖有斯人席更圆。\n跨马未须贪远道，举觞聊复望青天。\n枯荷折苇三墩路，明月清风百丈船。\n俯仰便成陈迹恨，须知此集不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和余时中元夕二首 其二","author":"王之道","text":"罗绮行歌夜，杯盘坐笑春。\n舞衫催急管，步障拥佳人。\n灯火珠星粲，楼台璧月新。\n传柑良可乐，黼座玉音亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和余时中元夕二首 其一","author":"王之道","text":"今夕知何夕，熙熙万室春。\n歌楼醒醉客，灯市往来人。\n劝酒行杯促，联诗得句新。\n铜壶休见迫，欢笑正相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应资深九日游康乐园二首 其二","author":"王之道","text":"里社安閒得久生，金华端不羡初平。\n山林应有清修重，轩冕还将道义轻。\n诗捷口占那复藁，酒豪盆酌不论觥。\n一斑已幸窥秋句，囷廪他时冀倒倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应资深九日游康乐园二首 其一","author":"王之道","text":"村落潇潇晚吹生，斜阳天际与林平。\n黄花照眼吟肩耸，红袖扶头醉帽轻。\n可惯探题仍击钵，敢辞偿令独浮觥。\n相逢又复惊相别，樽酒何妨意气倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张元礼","author":"王之道","text":"力学三年看有成，龙蛇蟠蛰冀存身。\n一杯饯别初迎腊，千里归来欲送春。\n爱日光阴宜共惜，及时德业要争新。\n吾家丛桂风流在，速取高科慰老亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张公仪","author":"王之道","text":"醉中行草绾秋蛇，十载风棂忆旧家。\n朋旧乱多从鬼录，诗书閒益富生涯。\n稻塍绿合迷秧马，沙嘴潮回下钓车。\n归去西畴新雨足，饭粳应不羡胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文纪咏雪二首 其二","author":"王之道","text":"朝来经阁课楞严，撩乱飞花竞扑帘。\n似是青腰誇黑帝，故教姑射混无盐。\n地炉无奈貂裘薄，斗酒难供座客添。\n诗债恼人眠不得，夜寒残管亦须拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文纪咏雪二首 其一","author":"王之道","text":"万境沉沉夜气严，广寒初下水晶帘。\n三杯强沃浇肠酒，一捻聊分暖砚盐。\n已恨梅梢遭挫折，可堪风物为般添。\n才高柳絮虽难到，此语于今亦恶拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张安国舍人","author":"王之道","text":"判花西掖妙当年，曾见声华振日边。\n文翰共推唐李峤，功名将踵汉韦贤。\n江山到处供诗笥，风月多情付酒船。\n琳馆正应聊尔耳，会看鹏击水三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张序臣合肥驿中诗","author":"王之道","text":"橐皋何处合肥东，知有诗翁杖履中。\n鲁会一时归寂寞，吴吟千载发清雄。\n湖山照碧朦胧日，鞍马欺寒料峭风。\n春入花梢人易感，莫教房闼叹飞蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张咏老知县","author":"王之道","text":"照蔀辉辉碧夜光，贫儿那复苦悲凉。\n得鱼始信筌无用，斲垩终期鼻不伤。\n我类槁苗犹欠雨，君同脩竹饱经霜。\n诗成病眼昏加涩，欲写还忧细作行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张彦智中秋对月","author":"王之道","text":"万里青天霁色开，嫦娥驾玉上云来。\n楼中胜饮八仙聚，物外清谈三语该。\n空翠水光争滉漾，漏声钟韵共徘徊。\n秋盘应爱金樱好，红抺佳人醉里腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张彦智对雪","author":"王之道","text":"雪山何处觅瞿昙，压尽江南瘴与岚。\n待伴可堪风作党，交光应喜月成三。\n濯巾漉酒供杯勺，涉笔联诗尚笑谈。\n柳絮自今轻谢句，使君才气擅东南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李难老","author":"王之道","text":"半生场屋弄朱衣，犹喜春来破白归。\n同辈交游惟我拙，一时人物似君稀。\n风神要在山庭峻，辞吐初疑锯屑飞。\n州县未应淹骥足，钓名谁羡子陵矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和沈次韩秋日雨后督子厚报","author":"王之道","text":"江槛连朝雨，山斋昨夜凉。\n不知新稻熟，深怪晚炊香。\n得句君应喜，闻风我漫狂。\n绣溪行乐处，云水几千章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和沈进可检法秋夜饮客待月","author":"王之道","text":"欲雨云容合，濒江水气浮。\n笑谈初入夜，灯火适逢秋。\n巧借三豪便，还成一醉谋。\n投琼酬木李，秪使老夫羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和连圣举呈张彦智","author":"王之道","text":"公望岩岩映广东，曲江重见旧家风。\n威行草木霜争肃，春到湖山雪自融。\n至喜此心鱼鸟共，去思前日吏民同。\n从今不复忧兵火，却敌如公笑语中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邹进士","author":"王之道","text":"望外青山便到家，冯驩何患出无车。\n坐逢石鼎应联句，箧有龙潭敢斗茶。\n樽酒几时同竹叶，功名终日鉴菱花。\n君看一雨苏群槁，所至人心乐否耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲二首 其二","author":"王之道","text":"相逢怜我太衰颜，冰雪精神照座间。\n霁日有情茶乳合，春风无力柳丝閒。\n肯从逋客来三径，秪恐佳人赋二山。\n旧说毛公今见否，似闻新向玉京还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲二首 其一","author":"王之道","text":"人似平原字亦颜，诗成长在笑谈间。\n试看落笔云烟疾，难放摇春草木閒。\n美俗未容窥制锦，劝耕聊得伴行山。\n惭将郑腊酬荆璞，无怪年时债未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲春日偶成二首 其二","author":"王之道","text":"江表归来得自由，旧乡能复到温柔。\n辞源已见流三峡，笔力当期挽万牛。\n白日忍从黄雾塞，青天那复黑云浮。\n扫除骄寇还强汉，会有忠良告远猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈勉仲春日偶成二首 其一","author":"王之道","text":"帷幄何人正坐筹，匈奴轻汉索怀柔。\n回銮未睹迎天驷，劝穑还惊出土牛。\n雨过池塘新涨绿，春归原野霁烟浮。\n中兴自古须群策，更愿君王慎厥猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]