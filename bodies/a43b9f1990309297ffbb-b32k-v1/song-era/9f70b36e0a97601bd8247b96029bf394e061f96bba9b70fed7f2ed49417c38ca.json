[{"title":"三月十九日过松江五绝 其二","author":"汪莘","text":"万顷烟波短棹飞，一双鸥鸟弄斜晖。\n如今频作姑苏客，遥指当年旧钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月十九日过松江五绝 其五","author":"汪莘","text":"笠泽沧波拥洞庭，望中七十二峰青。\n待偕龙女乘云去，占取参天一画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月十九日过松江五绝 其三","author":"汪莘","text":"煎茶徐读散人传，对酒朗吟渔父词。\n除却月风同此意，祗应烟雨暗相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月谢吴子文","author":"汪莘","text":"为我归途怯晚风，解袍添我意何穷。\n念君夜度青松岭，亦恐寒侵气体中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉夏偶兴 其三","author":"汪莘","text":"两镜手提如合璧，两光相摄万重光。\n重重楼阁重重户，有个瞳人里面藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉夏偶兴 其一","author":"汪莘","text":"雨后荷盘可乾汞，日中莲座自焚香。\n儿童拗断垒珠柄，牵出银丝随手长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉夏偶兴 其二","author":"汪莘","text":"剥开莲子见芳鲜，花叶同心缩翠拳。\n欲记池莲多少朵，一枝荷叶一枝莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己酉夏偶兴 其四","author":"汪莘","text":"两灯射壁两重光，一影俱生一影傍。\n假使百灯同一室，百身还只一身忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中元夜兴","author":"汪莘","text":"东院长廊约二更，风雷送雨正冥冥。\n忽看电掣金蛇过，照出青天一点青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子岁云峰写望","author":"汪莘","text":"西极层云最上层，碧云峰著白云楞。\n六龙顶佩斜阳下，恰似青纱一点灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东行途中有感","author":"汪莘","text":"一路桃花愁杀人，柳塘茅屋正宜春。\n春风不是不相识，不遣春山养病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去昌化县西四十里留宿陈东鲁南楼","author":"汪莘","text":"碧玉山中白玉溪，武陵村落午时鸡。\n南楼一觉春宵雨，夹路桃花送马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月十二日携家如钱塘二十二日过湖至九里松船步头秦家安泊凡住百日八月还家仲冬题金德恭东园","author":"汪莘","text":"昔年曾访此林坰，今日重来倍有情。\n道在山中人不会，竹风柏日总分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申六月闻晦庵先生除兵部侍郎","author":"汪莘","text":"韩范诸公各一时，贤豪久速系安危。\n从来功业知难就，未敢先赓庆历诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其十","author":"汪莘","text":"绕屋桃花可得追，迎门犹有海棠枝。\n牡丹未放酴醾小，并入青梅煮酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其九","author":"汪莘","text":"西湖杨柳欲栖乌，遥想溪山似画图。\n二月到家寒食近，末梢春境忆西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其八","author":"汪莘","text":"白昼春光绿染衣，东风千里挂帆归。\n竹篱红白花相映，只听鸡声在翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其七","author":"汪莘","text":"二月湖山把酒中，呼猿洞口水涵空。\n醉来剥尽新花蕊，百叠生红未见风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其六","author":"汪莘","text":"塞空春意总分明，桃李无言却混成。\n刚被幽禽知此意，风前拈出两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其五","author":"汪莘","text":"闲来此意本翛然，一点清愁出意边。\n亦似东君无定准，乍晴乍雨恼花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其四","author":"汪莘","text":"香鞯绣轭急朝昏，李陌桃蹊不尽樽。\n满席落花人睡起，始知春兴属柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其三","author":"汪莘","text":"一层山只一溪斜，偃卧东风恋日华。\n莫把江行生旅思，他年忆此胜还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其二","author":"汪莘","text":"薄晚东风一岸巾，波光挟日战龙鳞。\n寻思来往成何事，只向人间得此人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅西归江行春怀十首 其一","author":"汪莘","text":"江行二月正清新，无主桃花不恋春。\n老去情怀甚年少，少年未解惜芳晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日山行","author":"汪莘","text":"远山残雪献年华，翠黛千层蹙浪花。\n天上画屏描不得，懒移皮屐下邻家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲春溪行即事","author":"汪莘","text":"竹外夭桃分外明，一枝折得绕溪行。\n春风谁道全无主，胡蝶飞来花上争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵 其一","author":"汪莘","text":"长恨无人共一杯，直知好友自天来。\n渊明到死真成菊，和靖平生却是梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵 其二","author":"汪莘","text":"接得南枝即按杯，似和霜月带将来。\n自从驿使相逢后，千载无人解寄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再到","author":"汪莘","text":"半近烟村半近城，东园花木锁柴荆。\n我来独对南山立，始信陶潜两眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回至松江 其二","author":"汪莘","text":"深林茅屋隐渔樵，时有扁舟过石桥。\n谁把客星入图画，晓风残月伴吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回至松江 其一","author":"汪莘","text":"欲向江南采白蘋，杜鹃啼后已无春。\n洞庭龙女云中降，手把双珠笑赠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次潘别驾韵","author":"汪莘","text":"野店溪桥柳色新，千愁万恨为何人。\n殷勤织就黄金缕，带雨笼烟过一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自去秋疾作正月尚未全愈晓枕有怀","author":"汪莘","text":"插柳栽花便满林，午天蜂蝶晓天禽。\n老来病损浑无力，报答春光只有心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过丹阳界中新丰市","author":"汪莘","text":"道过新丰沽酒楼，不须濯足故相酬。\n华山仙伯徐思看，争遣时人识马周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛小舟入莲荡微雨即事","author":"汪莘","text":"水光如锦叶如烟，微雨相从到洞天。\n翠盖红妆无处避，一时挨入木兰船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛酉正月初八日入郡赴高校书之约二十二日出西郊即事","author":"汪莘","text":"竹篱茅屋两三家，白昼青春自岁华。\n碧縠水边搓柳线，绿罗天畔绣桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰十一月东行腊月立春夜秀州船埸桥玩月甲辰正月廿四日出都城廿七日晓行即事","author":"汪莘","text":"鸦声欲断雉声起，柳眼已青桑眼黄。\n故乡春事正如许，春事只缘思故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到高亭山望南北高峰","author":"汪莘","text":"每泛西湖不忍还，高亭数叠出云间。\n如今回至高亭路，却望西湖数叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜兴","author":"汪莘","text":"簟纹如水浸蟾光，睡觉湖边月半床。\n道是广寒疑不是，月中那得藕花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐有感","author":"汪莘","text":"前贤相遇是前程，不见斯人莫误行。\n白面书生那解事，只将文字住京城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟秋朔日天台刘允叔和叔乡人陈思敬饯饮钱塘门外双清楼上","author":"汪莘","text":"西湖日日可寻芳，楼上凭栏意未忘。\n斫取荷花三万朵，作他贫女嫁衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季夏之末鹃声不已","author":"汪莘","text":"念尔残春啼不休，若为春夏抱春愁。\n亦知春去年年事，忆似前时春尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直院自言愿所以相拯之意有非毫楮所可宣者归途口占一绝为寄","author":"汪莘","text":"倾国佳人默怨天，红颜过了拜尊前。\n世家大族多兄嫂，独得公姑分外怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其八","author":"汪莘","text":"下帘读易有深功，一炷清香过日中。\n赤帝元来协青帝，南风初至似东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其九","author":"汪莘","text":"槐叶风清莺哺子，麦苗露湿雉寻媒。\n道人不出方壶境，坐见天时去又来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其四","author":"汪莘","text":"野水平桥细浪生，柴门草长断人行。\n园林霁后春如在，燕雀鸣时夏正清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其十","author":"汪莘","text":"檐前花放不忍折，庭下草深仍懒锄。\n苦雨晴时春已尽，可怜新月挂清虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其五","author":"汪莘","text":"即日南风清且微，北窗心静见天机。\n林莺母子声相应，野蝶雌雄性共飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其六","author":"汪莘","text":"春去江南水拍天，经旬茅屋罕炊烟。\n石墙颓毁板桥断，始觉贫家气象全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其一","author":"汪莘","text":"石桥南北碧桃香，翠叶交柯水面凉。\n终岁方壶无一事，春来也为种花忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其三","author":"汪莘","text":"夏雨春风穷管仲，停云荣木老渊明。\n断红池馆无人到，犹有黄鹂一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其二","author":"汪莘","text":"不赋杜鹃三十秋，今愁不比昔时愁。\n杜鹃岂是催春去，为见春来啼不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交风雨弥旬耳目所触即事十绝 其七","author":"汪莘","text":"雷电阴晴共一帘，残春首夏境相兼。\n闲寻稚笋今朝长，静数新荷昨夜添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳枝词","author":"汪莘","text":"缲出烟丝轻袅袅，扫成雪帚重垂垂。\n风流举世无过柳，总合殷勤把一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其四","author":"汪莘","text":"水边杨柳怯秋风，忆昨杏花相映红。\n心地不随时节变，始知天下有英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其二","author":"汪莘","text":"天外涵天心广大，月中吐月性光明。\n夜来飞上昆崙顶，独倚琼楼啸一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其六","author":"汪莘","text":"七尺经霜翠竹竿，斩来石壁钓江湍。\n丝头垂下骊龙口，掣得明珠似月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其三","author":"汪莘","text":"一旦秋风起洛滨，东归聊复寄鲈莼。\n如今已在渔乡住，宜与清朝作散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其一","author":"汪莘","text":"闲步水南因水北，仍从山后复山前。\n日归海底龙方觉，月到天心虎正眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其五","author":"汪莘","text":"萝衣袅袅带凉风，人道秋空岂是空。\n白日不知天上事，众星环拱紫微宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其七","author":"汪莘","text":"秋天尤觉晓天清，仰首看天俯首行。\n不但长歌声似鹤，一身浑似鹤般轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其十","author":"汪莘","text":"虞帝周王不复生，几多豪杰应离明。\n凤凰览遍真难合，直至而今欠一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其九","author":"汪莘","text":"一带青峦失旧青，荻花枫叶夕阳明。\n闲思天上多官府，自是幽人道未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其八","author":"汪莘","text":"玉露金风刮夜天，疏桐缺月耿窗前。\n十诗未尽穷愁志，说与家僮汝自眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其七","author":"汪莘","text":"伤春未了又悲秋，无复欢悰到酒舟。\n茅屋半攲篱半倒，伏羲一卷在床头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其六","author":"汪莘","text":"曾向潇湘遇水仙，倏来如月去如烟。\n深林一笑闻山鬼，余处幽篁不见天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其五","author":"汪莘","text":"自分为人类鲁皋，几将心事泛吴舠。\n手抟日月供宸笔，拣尽金鸡玉兔毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其四","author":"汪莘","text":"北渚风生禾叶秋，洞庭波起夕阳收。\n楚人临水为谁立，帝子隔烟相对愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其三","author":"汪莘","text":"秋云无复似春浓，天地何人到此穷。\n斜日淡烟今古恨，如何都付与孤鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其二","author":"汪莘","text":"四野秋风交敝庐，时平不用蔺相如。\n有人来问生涯事，指点蓑衣学钓鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其一","author":"汪莘","text":"形骸攲仄面皮黄，破屋三间号柳塘。\n自大暑来真畏暑，到微凉处便知凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵君十绝 其一","author":"汪莘","text":"皂盖朱轓练水滨，春生秋杀总精神。\n须知爱士何曾泛，屈指应无第二人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵君十绝 其四","author":"汪莘","text":"归去苕溪理钓蓬，风清月白水精宫。\n青莲居士争闲得，时答天书一两通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵君十绝 其八","author":"汪莘","text":"有客胸藏太息书，萧萧白发不堪梳。\n君王若问江东士，莫只相怜诵子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵君十绝 其二","author":"汪莘","text":"醉把金鞭度绿杨，军民夹道笛声长。\n红旗千面诗千首，半杂风云入建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵君十绝 其五","author":"汪莘","text":"风雨黄昏自掩扉，灯前时复一歔欷。\n儿曹相问缘何事，为道君侯早晚归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵君十绝 其三","author":"汪莘","text":"荷叶高高荷蕊低，夕阳初落画桥西。\n湖州士女来相接，争拥兰舟入霅溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵君十绝 其七","author":"汪莘","text":"练水至清无浅深，使君何日再登临。\n请看江上千株柳，尽是君民离别心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]