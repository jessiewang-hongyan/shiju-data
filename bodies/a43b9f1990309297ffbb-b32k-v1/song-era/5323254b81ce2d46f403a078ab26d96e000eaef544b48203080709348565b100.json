[{"title":"宝祐二年皇子冠二十首 其十","author":"郊庙朝会歌辞","text":"帝子惟贤，懋昭厥德。\n跪冠于房，玄冠有特。\n鼓钟喤喤，威仪抑抑。\n百礼既洽，祚我王国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其九","author":"郊庙朝会歌辞","text":"秩秩宾筵，笾豆孔嘉。\n帝子至止，衿缨振华。\n周旋陟降，礼行三加。\n成人有德，匪骄匪奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其八","author":"郊庙朝会歌辞","text":"兹惟阼阶，厥义有在。\n历阶而升，敬谨将冠。\n经训昭昭，邦仪粲粲。\n正纚宾筵，寿考未艾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其七","author":"郊庙朝会歌辞","text":"吉圭休成，其日南至。\n天子有诏，冠尔皇嗣。\n为国之本，隆邦之礼。\n拜而受之，式共敬止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其六","author":"郊庙朝会歌辞","text":"我有嘉宾，直大以方。\n亦既至止，厥德用光。\n冠而字之，厥义孔彰。\n表里纯备，黄耇无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其五","author":"郊庙朝会歌辞","text":"有来振振，月重轮兮。\n瑜玉在佩，綦组明兮。\n左徵右羽，德结旌兮。\n步中采荠，矩彟循兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其四","author":"郊庙朝会歌辞","text":"路寝辟门，黼坐恭己。\n群公在庭，所重维礼。\n正心齐家，以燕翼子。\n于万斯年，王心载喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其一","author":"郊庙朝会歌辞","text":"于皇帝德，乃圣乃神。\n本支百世，立爱惟亲。\n敬共冠事，以明人伦。\n承天右序，休命用申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其十四 亚献用《正安》。","author":"郊庙朝会歌辞","text":"已象文治，乃观武成。\n进退可度，威仪克明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其十一 太祖室用《大定》。","author":"郊庙朝会歌辞","text":"猗欤太祖，受命于天。\n化行区宇，功溢简编。\n武威震耀，文德昭宣。\n开基垂统，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其六 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"维牺维牲，以炰以烹。\n植其鼗鼓，洁彼铏羹。\n孔硕兹俎，于穆厥声。\n肃雍显相，福禄来成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其一 迎神用《礼安》。","author":"郊庙朝会歌辞","text":"肃肃清庙，奉祠来诣。\n格思之灵，如在之祭。\n克谨威仪，载严容卫。\n降福孔皆，以克永世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其三 奠瓒用《瑞木》。","author":"郊庙朝会歌辞","text":"木符启瑞，著象成文。\n于昭大号，协应明君。\n灵命有属，鸿禧洞分。\n歌以升荐，休嘉洽闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其四 又用《驯象》。","author":"郊庙朝会歌辞","text":"嘉彼驯象，来归帝乡。\n南州毓质，中区效祥。\n仁格巨兽，德柔遐荒。\n有感斯应，神化无方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其八 顺祖室用《大宁》。","author":"郊庙朝会歌辞","text":"元钟九千，生于仲吕。\n崇台九层，起于累土。\n赫日之升，明夷为主。\n孝孙作帝，式由祖武。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其二 皇帝行用《隆安》。","author":"郊庙朝会歌辞","text":"工祝升阶，宾尸在位。\n祗达孝思，允修毖祀。\n显相有仪，克恭乃事。\n俨恪其容，通此精意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其九 翼祖室用《大顺》。","author":"郊庙朝会歌辞","text":"明明我祖，积德攸宜。\n肇继瓜瓞，将隆本支。\n爰资庆绪，式昭帝基。\n于穆清庙，永洽重熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其七 酌献僖祖室用《大善》。","author":"郊庙朝会歌辞","text":"汤汤洪河，经启长源。\n郁郁嘉木，挺生本根。\n大哉崇基，出乎庆门。\n发祥垂裕，永世贻孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其十六 彻豆用《丰安》。","author":"郊庙朝会歌辞","text":"肥腯之牲，既析既荐。\n郁鬯之酒，已酌已献。\n祝辞亦陈，和奏斯遍。\n享礼具举，彻其有践。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其五 又用《玉乌》。","author":"郊庙朝会歌辞","text":"素乌爰止，淳精允臧。\n名符瑞牒，色应金方。\n洁白容与，翘英奋扬。\n孝思攸感，皇德逾张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其十五 终献用《正安》。","author":"郊庙朝会歌辞","text":"常武徂征，诗人所称。\n总干山立，厥象伊凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其十二 太宗室用《大盛》。","author":"郊庙朝会歌辞","text":"赫赫皇运，明明太宗。\n四隩咸暨，一变时雍。\n睿文炳焕，圣德温恭。\n千龄万祀，永播笙镛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆以来祀享太庙十六首 其十 宣祖室用《大庆》。","author":"郊庙朝会歌辞","text":"艰难积行，绵长钟庆。\n同人之时，得主乃定。\n既叙宗祧，乃修舞咏。\n经武开先，永昭丕命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆御楼三首 其三 降坐用《隆安》。","author":"郊庙朝会歌辞","text":"华缨就列，左衽来王。\n帝仪炳焕，大乐铿锵。\n礼成峣阙，言旋未央。\n一人有庆，万寿无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 降坐用《圣安》。","author":"郊庙朝会歌辞","text":"长乐居尊，盛容有炜。\n文王事亲，万国归美。\n朝会之则，邦家之纪。\n受福于天，克昭隆礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 其二 酒再行作《四海会同之舞》。","author":"郊庙朝会歌辞","text":"左秉朱干，右挥玉戚。\n以象武缀，以明皇德。\n天子荣养，群臣述职。\n四夷宾附，罔不承式。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 其一 酒再行作《四海会同之舞》。","author":"郊庙朝会歌辞","text":"七德之舞，四朝用康。\n有如姬姒，助集周邦。\n威克厥爱，居安不忘。\n风旋山立，济济皇皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 其二 酒一行毕作《厚德无疆之舞》。","author":"郊庙朝会歌辞","text":"至矣坤元，道符惟圣。\n就养宸极，助隆善政。\n翟籥纷举，笙镛协应。\n翱翔有容，表德之盛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 其一 酒一行毕作《厚德无疆之舞》。","author":"郊庙朝会歌辞","text":"尧母之圣，放勋为子。\n同心协谋，柔远能迩。\n以德康俗，以文兴治。\n斯焉象功，罔不昭济。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 其三 群臣酒行用《礼安》。","author":"郊庙朝会歌辞","text":"礼均孝慈，乐合韶武。\n至德光矣，鸿恩亦溥。\n上下和济，华夷乐湑。\n盏斝三行，盛仪斯举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 其二 群臣酒行用《礼安》。","author":"郊庙朝会歌辞","text":"湛湛零露，晞于载阳。\n我有旨酒，群臣乐康。\n既饮以德，亦图尔良。\n永言修辅，用协天常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 其一 群臣酒行用《礼安》。","author":"郊庙朝会歌辞","text":"肃肃临下，有威有容。\n循循事上，惟信惟忠。\n盛礼兴乐，示慈训恭。\n君臣协吉，惟道之从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 三举酒用《奇木连理》。","author":"郊庙朝会歌辞","text":"王化无外，坤珍效灵。\n旁枝内附，直干来并。\n群分非一，祺祥绍登。\n至诚攸感，海县斯宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 再举酒用《寿星》。","author":"郊庙朝会歌辞","text":"现彼南极，昭然瑞文。\n腾光丙位，荐寿中宸。\n太史骈奏，升歌有闻。\n轩宫就养，亿万斯春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 皇太后初举酒用《玉芝》。","author":"郊庙朝会歌辞","text":"烨烨灵芝，生于殿闱。\n照映华拱，纷敷玉蕤。\n感召元和，光符圣期。\n祥篇协吉，百福咸宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 上寿用《福安》。","author":"郊庙朝会歌辞","text":"盛礼煌煌，六衣有光。\n千官在位，百福称觞。\n坤德慈仁，邦斯淑祥。\n如山之寿，佑圣无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 皇帝上寿酒用《崇安》。","author":"郊庙朝会歌辞","text":"天子之德，形于四方。\n尊亲立爱，化洽风扬。\n圣母袆衣，明君黼裳。\n因时献寿，克盛朝章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 公卿入门用《礼安》。","author":"郊庙朝会歌辞","text":"帝率四海，承颜尽恭。\n端闱肃设，群后来同。\n玉佩锵鸣，衣冠有容。\n英韶节步，磬管雍雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道元年章献明肃皇太后朝会十五首 皇太后升坐用《圣安》。","author":"郊庙朝会歌辞","text":"圣母有子，重光类禋。\n圣皇事母，感极天人。\n百辟在庭，九仪具陈。\n礼容之盛，万国咸宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道亲享先农十首 其十 送神用《静安》。","author":"郊庙朝会歌辞","text":"献终豆彻，礼备乐成。\n祠容肃肃，风驭冥冥。\n三时务本，一垡躬耕。\n人祇胥悦，祉福是膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2028,