ter":2034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道亲享先农十首 其二 皇帝升降用《隆安》。","author":"郊庙朝会歌辞","text":"冕服在御，坛壝有仪。\n陟降左右，天惟显思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道亲享先农十首 其一 迎神用《静安》。","author":"郊庙朝会歌辞","text":"稼政之本，民食惟天。\n甫田兆岁，后稷其先。\n灵坛既祀，黛耜攸虔。\n乃圣能享，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"治平皇太后皇后册宝三首 其二 太尉等奉册宝入门用《正安》。","author":"郊庙朝会歌辞","text":"晬仪临拱，丕命明扬。\n鸾回宝势，鸿贯瑶光。\n礼成乐备，德裕名芳。\n肇基王化，永懋天祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其十三","author":"郊庙朝会歌辞","text":"太任徽音，太姒是嗣。\n则百斯男，周室以炽。\n天子万年，受兹女士。\n如姒事任，从以孙子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其十二","author":"郊庙朝会歌辞","text":"宝字煌煌，册书粲粲。\n副笄加饰，袆褕有烂。\n祗若帝休，委蛇乐衎。\n亿万斯年，永膺宸翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其十一","author":"郊庙朝会歌辞","text":"窈窕其容，淑嫕其姿。\n烂其如云，瞻我母仪。\n曰天之妹，作合惟宜。\n粲然舞抃，畴不肃祗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其十","author":"郊庙朝会歌辞","text":"素月澄辉，众星显列。\n炳为天文，各有攸别。\n椒房既正，阴教斯设。\n关雎麟趾，应如响捷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其九","author":"郊庙朝会歌辞","text":"礼既行兮，厥位孔安。\n母仪正兮，容止可观。\n奉东朝兮，常得其欢。\n求淑女兮，岂乐多般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其八","author":"郊庙朝会歌辞","text":"镂苍玉兮，盛德载扬。\n铸南金兮，作镇椒房。\n虔受赐兮，有烨有光。\n宜室家兮，朱芾斯皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其六","author":"郊庙朝会歌辞","text":"款承祗事，时惟肃雍。\n跪奉册宝，陈于法宫。\n以俯以仰，有仪有容。\n明神介之，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其五","author":"郊庙朝会歌辞","text":"猗欤贤后，德本性成。\n承天致顺，溯日为明。\n作配俪极，王化以行。\n万有千岁，奉祀宗祊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其四","author":"郊庙朝会歌辞","text":"朝阳已升，薰风习至。\n乐奏既成，礼容亦备。\n玉佩锵鸣，帝徐举趾。\n壶政穆宣，以听内治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其三","author":"郊庙朝会歌辞","text":"穆穆睟容，如天之临。\n赫赫明命，如玉之音。\n虔恭出门，礼容兢兢。\n涂山生启，夏道以兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其二","author":"郊庙朝会歌辞","text":"天子当阳，群工就列。\n册宝既陈，钟鼓备设。\n上公奉事，容庄心协。\n克相盛礼，光昭玉牒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其一","author":"郊庙朝会歌辞","text":"天地奠位，乾坤以分。\n夫妇有别，父子相亲。\n圣王之治，礼重婚姻。\n端冕从事，是正大伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十年发皇太后册宝八首 其七 太傅奉册授提点官用《礼安》。","author":"郊庙朝会歌辞","text":"肃雍长乐，克笃其庆。\n河洲茂德，沙麓启圣。\n是生睿哲，蚤隆丕运。\n钦称鸿宝，永膺天命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十年发皇太后册宝八首 其六 太傅奉册授提点官用《礼安》。","author":"郊庙朝会歌辞","text":"孝奉天仪，信维休德。\n发越徽音，礼文靡忒。\n永保嘉祥，时万时亿。\n归于东朝，含饴燕息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十年发皇太后册宝八首 其五 太傅奉册宝入门用《圣安》。","author":"郊庙朝会歌辞","text":"静顺坤仪，圣神是育。\n懿铄昭陈，镂文华玉。\n乐奏既备，礼仪不渎。\n导迎善祥，翟车归毣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十年发皇太后册宝八首 其四 太傅奉册宝出门用《圣安》。","author":"郊庙朝会歌辞","text":"肃肃东朝，帝隆孝治。\n猗欤丕称，宝册斯备。\n皇扉四辟，导迎庆瑞。\n德迈太任，有周卜世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十年发皇太后册宝八首 其三 侍中奉宝诣皇帝褥位用《礼安》。","author":"郊庙朝会歌辞","text":"祖启瑶光，诞生明圣。\n尊极母仪，帝庸作命。\n宝章煌煌，导以笙磬。\n还燕慈宁，邦家徯庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴十年发皇太后册宝八首 其二 中书令奉册诣皇帝褥位用《礼安》。","author":"郊庙朝会歌辞","text":"声乐备陈，礼容罔忒。\n相维辟公，虔奉玉册。\n皇则受之，慕形于色。\n既寿且康，与天无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]