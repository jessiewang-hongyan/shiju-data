[{"title":"谢郭景文寄鱼鲊","author":"王庭圭","text":"开缄如见故人面，仍喜故园风物来。\n想见金刀落飞雪，何时斫脍共衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中喜梁养源惠炭","author":"王庭圭","text":"雪里乌薪绝市珍，能令寒屋坐生春。\n此中有句谁能道，暖得曲身成直身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上","author":"王庭圭","text":"沅陵春尽草萋萋，忽见扁舟系柳堤。\n谁寄愁心与明月，肯随君到夜郎溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"窜居夜郎雪中杜门数日不出忽郡中送春来始知今日立春","author":"王庭圭","text":"东风来从几万里，雪拥江梅未放花。\n忽见土牛惊换岁，始知春色到天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食日孟司理送酒","author":"王庭圭","text":"两翁俱是江南客，寒食他乡叹滞留。\n燕舞莺啼春未老，一樽分我洗穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭仲质南窗二首 其一","author":"王庭圭","text":"东风吹月下长汀，窗外鸡号天猝明。\n时有诸生来问字，隔江犹听讲书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭仲质南窗二首 其二","author":"王庭圭","text":"檐外群山碧四围，风帆过尽小平堤。\n先生独坐纱帷里，挂起南窗月满溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐听沅江水声二首 其一","author":"王庭圭","text":"雨过风林生夜清，坐邀明月正关情。\n渔童酒醒莫吹笛，要听一江秋浪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐听沅江水声二首 其二","author":"王庭圭","text":"水急滩高欲倒倾，来如万鼓绕山鸣。\n奔流更借洞庭阔，飞浪朝宗壮此声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辰州立春清首座送生菜饼","author":"王庭圭","text":"闻道春风今日回，走寻消息傍寒梅。\n恨无纤手挑生菜，也有青丝满饤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王岩老携诗见访诗未究雪下索余作诗赠之 其一","author":"王庭圭","text":"扣门有客怀珠玉，被褐长吟坐晚晖。\n雪打窗扉忽惊起，还将破帽盖头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王岩老携诗见访诗未究雪下索余作诗赠之 其二","author":"王庭圭","text":"君归大酉峰前住，岁晚枫丹蕉叶黄。\n试访酉阳岩石里，秦人逸兴未应亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初寒方葺火阁而会溪知城周子康惠竹帘火炉宁公瑞惠蒲团便足了一岁无事矣作二绝答之 其一","author":"王庭圭","text":"细柳将军来护塞，夜郎迁客正穷居。\n火炉恰恰帘垂地，足了三冬读我书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初寒方葺火阁而会溪知城周子康惠竹帘火炉宁公瑞惠蒲团便足了一岁无事矣作二绝答之 其二","author":"王庭圭","text":"户外霜风入骨酸，谁褰纸阁问平安。\n正忧坐客寒无席，遗我新蒲入突栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赠王保躬求小山石二首 其一","author":"王庭圭","text":"扁舟斗转五溪湾，湘北湘南饱看山。\n袖里云岑皆寸碧，一拳分手亦何悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赠王保躬求小山石二首 其二","author":"王庭圭","text":"岩蟠蛟虎石骨瘦，地饱霜风山脚寒。\n我欲借君修月手，为持玉斧劈烟峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄子老 其一","author":"王庭圭","text":"半程蹉过夜郎溪，不到昌溪问路岐。\n空使辰州亭下客，隔江招手立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄子老 其二","author":"王庭圭","text":"古锦林边狮子吼，一声惊倒五溪蛮。\n何人来问山中景，寺在千岩万壑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访清首座观蔷薇二首 其一","author":"王庭圭","text":"红玉蕊攒青玉枝，群芳净尽独开时。\n只应天女回轩晚，散得天花满竹篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访清首座观蔷薇二首 其二","author":"王庭圭","text":"花开花落春何在，宴坐高僧总不知。\n空色难谩禅伯眼，蔷薇应待老夫诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别陈君授 其一","author":"王庭圭","text":"十载投荒坐献书，忽逢飞诏下荆巫。\n归来好上升平颂，已死奸谀不足诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别陈君授 其二","author":"王庭圭","text":"雷雨沅湘振滞冤，皇恩普出九重天。\n乞儿犹恋权门火，应谓死灰能复燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离辰州二首 其一","author":"王庭圭","text":"逐客休嗟行路难，归鸿心在杳冥间。\n初惊草尾千重浪，险渡湖头十八滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离辰州二首 其二","author":"王庭圭","text":"行尽黄茅白苇丛，举头忽见两三峰。\n青青尽出湘天景，如觉身离蛮蜒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻小舟东下忽见巨舰有作","author":"王庭圭","text":"本是蓬头渔钓客，飘如行脚水云僧。\n谁家巨舰和州载，笑我扁舟一叶轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵任子严 其一","author":"王庭圭","text":"解访江南处士庐，行藏正自与时迂。\n题诗更及夜郎客，此段如今绝世无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵任子严 其二","author":"王庭圭","text":"君是石渠东观人，小邦聊见宰官身。\n山僧似不孤题品，众角丛中有一麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书觉范诗后","author":"王庭圭","text":"忆探骊龙颔底珠，湘山同赋夜啼乌。\n当时吟罢鬼神泣，此段如今扫地无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏赠文彦明 其一","author":"王庭圭","text":"江淹才尽一双笔，庾信穷生万斛愁。\n对客安能吐佳句，墙东老驵正操矛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏赠文彦明 其二","author":"王庭圭","text":"酒酣拔剑悲生事，病起扶藜踏浅莎。\n逆旅正如蝴蝶梦，还家试听扊扅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和罗思武作子房孔明二诗见赠 其一","author":"王庭圭","text":"子房夜半参黄石，手握豹韬挥八极。\n苍黄忽起振长流，天地风云皆动色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和罗思武作子房孔明二诗见赠 其二","author":"王庭圭","text":"三雄战争海水赤，欲揽英豪扶紫极。\n南阳唤起卧龙人，至今草木生颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周孟觉记皮老人事三首 其一","author":"王庭圭","text":"百年人物已无馀，况说铜人鼓铸初。\n欲著承平旧时事，政须此老助潜夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周孟觉记皮老人事三首 其二","author":"王庭圭","text":"何物庞眉一老翁，能谈庆历至熙丰。\n只应坐厌听鼙鼓，到处逢人说耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周孟觉记皮老人事三首 其三","author":"王庭圭","text":"人寿何曾有百年，再逢甲子换新元。\n眼明重见清平日，自可治聋听好言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吉州凌波亭月夜","author":"王庭圭","text":"螺浦东边雪浪生，峰头月出半轮明。\n扁舟欲载银蟾去，一听苍龙水底鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠日者张谷","author":"王庭圭","text":"夜坐吟诗窜夜郎，君将何术考休祥。\n近来偷得西华法，不敢烦君算短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未春被召东山益老来贺曰赵州八十犹行脚以诗答之云","author":"王庭圭","text":"八十心犹未悄然，横担拄杖布行缠。\n都城游遍归来日，却使谁还汤水钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张正伯求木樨","author":"王庭圭","text":"九里飞香隔岸闻，绣帘朱户閟清芬。\n千林落蕊扫不尽，分我幽窗一炷云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄秀才归临川","author":"王庭圭","text":"倾盖江头酒一樽，高楼惊坐去如云。\n别君无语独长啸，尚想清音半岭闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜郎东归黄去非自双井来惠以新诗妙画次韵三绝句赠别 其一","author":"王庭圭","text":"窜逐三危山尽头，出门入门谁与游。\n归来颇复见此客，下笔论诗不肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜郎东归黄去非自双井来惠以新诗妙画次韵三绝句赠别 其二","author":"王庭圭","text":"派后江西出一枝，传家句法自新奇。\n诸方知子善哮吼，恐是窟中狮子儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜郎东归黄去非自双井来惠以新诗妙画次韵三绝句赠别 其三","author":"王庭圭","text":"细看君诗如看画，无声诗里画何如。\n蟠胸秀句吐不尽，落笔因成赤鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别僧绍存 其一","author":"王庭圭","text":"住山骨相无人识，何处头陀忽扣关。\n第一座中闻謦欬，已知输却大沩山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别僧绍存 其二","author":"王庭圭","text":"踢倒净瓶呼木?，华林已坐一生穷。\n却教一座沩山主，都在头陀相法中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵伯达二绝句 其一","author":"王庭圭","text":"王孙疑是李长吉，诗句兼如孟浩然。\n乱后相逢初识面，便当倾廪与谈天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵伯达二绝句 其二","author":"王庭圭","text":"邂逅闻弦即赏音，况逢清境夜携琴。\n一樽相遇烟霞外，不废江湖万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彭青老咏雪三绝句 其一","author":"王庭圭","text":"雪窗未怕笔头乾，能写春江三峡寒。\n笑指渔翁卧蓬里，不知流下钓鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彭青老咏雪三绝句 其二","author":"王庭圭","text":"天公剪水散花林，试比江梅色浅深。\n梁苑词人能赋咏，终篇不作苦寒吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彭青老咏雪三绝句 其三","author":"王庭圭","text":"莫倚雪车诗句好，池台草木待春风。\n稍晴更上高楼望，要看馀霞散晚红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠曦上人二绝句 其一","author":"王庭圭","text":"学诗真似学参禅，水在瓶中月在天。\n夜半鸣钟惊大众，斩新得句忽成篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠曦上人二绝句 其二","author":"王庭圭","text":"寺倚村南涧水开，终年行脚看山回。\n卢仝欲洗尘埃渴，入寺却愁曦未来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘惠直梅花二绝句 其一","author":"王庭圭","text":"雪压寒梢玉作容，岭头相见又东风。\n人间欲问春消息，半在竹桥溪影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘惠直梅花二绝句 其二","author":"王庭圭","text":"吴姬玉面如相识，寒立山隈欲下来。\n先与江南作春色，一枝倾倒向人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜郎归日答葛令惠诗","author":"王庭圭","text":"七载投荒万里馀，交游半作晓星疏。\n门前梅柳换新叶，忽得故人相问书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南岳张道人见访言论亹亹若有所自非鹿鹿然者也摭其语作诗赠之三十年相见为汝掀髯一笑考其所自也","author":"王庭圭","text":"唤起赤龙耕玉池，池边龙虎自交驰。\n周天一毂三十辐，十二楼前看雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李宜仲以诗寄龙涎三首 其一","author":"王庭圭","text":"愁眉此日为君开，谁道岭南无雁回。\n邂逅江南逢驿使，龙涎风味敌官梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李宜仲以诗寄龙涎三首 其二","author":"王庭圭","text":"鹊噪柴门晓未开，香风撩我梦惊回。\n恨无好句酬高咏，唤起谪仙苏与梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李宜仲以诗寄龙涎三首 其三","author":"王庭圭","text":"谤投山箧书犹在，力挽九关天可回。\n胡不北归陈苦语，莫贪南海恋甜梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏向文刚生子","author":"王庭圭","text":"平生只欠掌中珠，天与此儿聊慰渠。\n郎罢新来著綵服，要令啼戏觅银鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和曾英伯","author":"王庭圭","text":"江东渭北关心事，樽酒论文更不疑。\n马上皱眉应得句，诗筒聊复寄微之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雷秀才尝学诗于吕居仁能谈江西宗派中事辄次居仁韵二绝赠行 其一","author":"王庭圭","text":"逐客归寻溪上居，钓竿犹挂洞庭湖。\n忽逢雷子谈诗派，传法传衣共一途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雷秀才尝学诗于吕居仁能谈江西宗派中事辄次居仁韵二绝赠行 其二","author":"王庭圭","text":"闻有牙签万卷藏，槐花应笑举人忙。\n向来阅士知多少，他日昂霄见此郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周秀才取古物作十绝句见惠如丰城临平鼓之类作一绝句题其后","author":"王庭圭","text":"众宝沈埋万古悲，斩新拈出更题诗。\n临平石鼓无人识，谁把铜鱼作鼓椎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠写真胡生二绝句 其一","author":"王庭圭","text":"欲貌卢溪真面目，非儒非佛亦非仙。\n莫将踏碓卢行者，唤作骑驴孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠写真胡生二绝句 其二","author":"王庭圭","text":"误著儒衣到骨穷，儿童拍手笑衰翁。\n钓鱼艇子今无恙，置我五湖烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十四夜彦和置酒待月遇雨","author":"王庭圭","text":"君方置酒待月明，便有微云薄太清。\n雨罢阴云尝解驳，且教霖雨慰苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次前题两首 其一","author":"王庭圭","text":"玉宇初凉江练静，夜深风雨更凄清。\n从教洗出峰头路，云破星翻月自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次前题两首 其二","author":"王庭圭","text":"坐待凉蟾雨欲倾，一樽相对晚风清。\n甲兵正要天河洗，秉烛无妨对曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观兢渡次壁间绝句四首 其一","author":"王庭圭","text":"共坐南窗待月明，云间忽见大江横。\n钓鱼船上谁家笛，吹出骚人万古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观兢渡次壁间绝句四首 其二","author":"王庭圭","text":"红旗画鼓照江明，两岸争看万目横。\n夺得锦标谁助喜，呼声动地见真情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观兢渡次壁间绝句四首 其三","author":"王庭圭","text":"昔年买酒论文地，回雁峰前雁阵横。\n白首相逢夜郎道，不因生死见交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观兢渡次壁间绝句四首 其四","author":"王庭圭","text":"心如止水贮空明，还似虚舟尽日横。\n妙语忽然穿月胁，笔端那有俗间情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢子发惠茶","author":"王庭圭","text":"打门谁送双圆璧，惊觉茅檐昼日眠。\n便觉清风生两腋，梦魂飞到月轮边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒僧惠端不遇","author":"王庭圭","text":"僧扉深倚碧岩隈，何处看云久未回。\n日暮鸣钟应不语，嗔人马迹涴苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘端礼 其一","author":"王庭圭","text":"槐花又是一番黄，天马飘飘不可缰。\n但得顷田耕负郭，肯将斗酒博西凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]