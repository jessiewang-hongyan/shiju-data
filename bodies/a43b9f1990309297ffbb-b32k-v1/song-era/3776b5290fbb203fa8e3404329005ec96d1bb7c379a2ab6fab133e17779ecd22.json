[{"title":"遇故人","author":"李公明","text":"虚窗桂子打风声，夜酌沉沉夜气清。\n三十年间不须说，可堪相照发星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫作 其一","author":"李公明","text":"测测日西去，去来无尽时。\n百年无半在，一事更何为。\n草屋倚寒木，疏梅横短篱。\n直能捐世虑，何处不忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曹坑铺","author":"李公明","text":"明星落深水，晚电起孤云。\n去去风前棹，迢迢竹外村。\n山回依草驿，岸落出芦根。\n亲月照人冷，今宵清梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李公寅","text":"岭分东粤封疆阔，天限中原气象雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樵川郊行","author":"李方子","text":"避人忘井邑，耽静步郊原。\n落叶风能扫，寒花霜更繁。\n山空樵响答，滩浅榜声喧。\n愿结山阳伴，长年此灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜游漓江上","author":"李升之","text":"漓江开遍四时花，游览都忘屐齿赊。\n风景虽宜秋向老，关山无奈客思家。\n漏传楼上三通鼓，水落滩头几尺沙。\n京国未归乡信断，阵鸿何处贴云斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题天竺寺壁","author":"李天才","text":"走杀东头供奉官，御香频降雨犹悭。\n相公端坐都堂里，天竺观音又下山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题句容酒肆壁","author":"李天才","text":"青裙白面哄挑菜，茅舍竹篱疏见梅。\n春事隔年无信息，一声啼鸟唤将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 灯花","author":"李天骥","text":"又何须、向明还灭，寒花点缀孤影。\n玉龙度海吹鱼浪，烟淡宝钗横鬓。\n斜又整。\n是虫滴骊珠、两两相交颈。\n夜长人静。\n恁玉果低抛，金钱暗卜，此意有谁领。\n欢娱事，料想凭伊先应。\n帕绡新泪独凝。\n银篦未忍轻挑下，只恐暗风吹烬。\n重记省。\n怕莫是、明朝有个青鸾信。\n怎知无定。\n算只解窥人，人孤影只，成瘦又成病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 梦中作","author":"李太古","text":"尽道是伤春，不似悲秋怨。\n门外分明见远山，人不见，空肠断。\n朝来一霎晴，薄暮西风远。\n却忆黄花小雨声，误落下、三四点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永遇乐","author":"李太古","text":"玉砌标鲜，雪园风致，似曾相识。\n蝉锦霞香，乌丝云湿，吹渴蟾蜍滴。\n青青白白，关关滑滑，寒损铢衣狂客。\n尽声声、不如归去，归也怎生归得。\n含桃红小，香芹翠软，惆怅宜城山色。\n百折浮岚，几湾流水，那一些儿直。\n落花情味，露花魂梦，蒲花消息。\n抚纤眉，织乌西下，为君凝碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子","author":"李太古","text":"月下秦淮海，花前晏小山。\n二仙仙去几时还。\n留得月魂花魄、在人间。\n河汉流旌节，天风袅佩环。\n满空香雾湿云鬟。\n何处一声横笛、杏花寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恋绣衾","author":"李太古","text":"橘花风信满院香。\n摘青梅、犹自怕尝。\n向绿密、红疏处，喜相逢、飞下一双。\n堪怜堪惜还堪爱，唤青衣、推上绣窗。\n暗记得、凭肩语，对菱花、啼损晚妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"李太古","text":"西风海色秋无际。\n双泪如铅水。\n白羊成队梦初平。\n挂杖敲云、云外晓鸿惊。\n小琼闲抱银筝笑。\n问有芳卿否。\n玉书分付莫开封。\n明日人间临水、拾流红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游金庭观","author":"李太澄","text":"步步溪山转几重，五云深处敞琳宫。\n峰峦秀拥神仙至，门径清无世俗风。\n昼静棋声深院里，月明琴弄夜堂中。\n丹成仙子无馀事，祇待蟠桃信息通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹧鸪","author":"李夫人","text":"新晴庭院暑风轻。\n瑞气朝来特地清。\n霞帔羽衣筠竹杖，萱堂真有寿星明。\n自来忠孝传家世，所以芝兰满户庭。\n簪笏成行称寿处，老来皆已鬓星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自咏","author":"李少和","text":"宝珠探妙得真宗，五色分明焕太空。\n解下连环竟超越，郁罗深处宴鸿濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题翠蛟亭","author":"李斗南","text":"壮士传观山石间，腰头宝剑祥光吐。\n摩挲醉眼叱海神，嫌杀蛟龙作妖舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀","author":"李氏","text":"门对云霄碧玉流，数声渔笛一江秋。\n衡阳雁断楚天阔，几度潮来问故舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汲水诗","author":"李氏","text":"汲水佳人立晓风，青丝辗尽辘轳空。\n银瓶触破残妆影，零乱桃花满井红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽公择兄","author":"李氏","text":"久历金门贵，未酬黄屋知。\n如闻天禄客，抱恨作铭时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖","author":"李氏","text":"舞凤翔龙拱帝城，秀涵积水驻川灵。\n青山楼观排云出，画舫笙歌隔柳听。\n撩乱花光浮绮陌，参差马影绕旗亭。\n振衣直上南峰顶，谁似盘溪却独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书红帕","author":"李氏","text":"囊香著郎衣，经绡著郎手。\n此意不及绡，共郎永长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"极相思 赠张浩","author":"李氏","text":"日红疏翠密晴暄。\n初夏困人天。\n风流滋味，伤怀尽在，花下风前。\n后约已知君定，这心绪、尽日悬悬。\n鸳鸯两处，清宵最苦，月甚先圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"李氏","text":"无力蔷薇带雨低。\n多情蝴蝶趁花飞。\n流水飘香乳燕啼。\n南浦魂销春不管，东阳衣减镜先知。\n小楼今夜月依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李氏","text":"清朝富贵利名在，结发夫妻日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弹琴","author":"李氏女","text":"昔年刚笑卓文君，岂信丝桐解误身。\n今日未弹心已乱，此心元自不由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拾得破钱","author":"李氏女","text":"半轮残月掩尘埃，依稀犹有开元字。\n想见清光未破时，买尽人间不平事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿苑寺一击轩二首 其二","author":"李长民","text":"密密堂堂悟有时，躁求那便契精微。\n凭谁举似圆居士，好助香岩證上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿苑寺一击轩二首 其一","author":"李长民","text":"我听风篁是梵音，如何俗耳等闲闻。\n自来击处无人会，千古知心只此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南蒋庄四首 其四","author":"李长民","text":"寒来惟喜睡，忽忽又朝暾。\n地迥霜逾白，庭空鹊自喧。\n甑头烟半吐，盏面酒微温。\n莫问乌银价，晴檐好负暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南蒋庄四首 其三","author":"李长民","text":"今旦商飙起，萧然云气秋。\n稚蛩工促织，老蔓拟牵牛。\n莫赋潘安阁，聊登王粲楼。\n家园归未得，孤梦绕松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南蒋庄四首 其二","author":"李长民","text":"郊居人事绝，倦暑每晨兴。\n莲□池中佛，笋供林下僧。\n吟馀厌蝉噪，望远喜禾登。\n朝市忘怀久，何劳羡赐冰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南蒋庄四首 其一","author":"李长民","text":"愁卧愁亭上，兰时忽过中。\n幽人倦赏物，青帝谩施功。\n柳眼依依碧，桃梢冉冉红。\n真须家酿酒，一醉百花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海盐道中","author":"李长民","text":"一舸凌风去，萦纡度几村。\n水清鱼视子，地美稻生孙。\n山近尘埃远，秋晴枕席温。\n悠悠向何所，欸乃武陵源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张师言知台州二首 其二","author":"李长民","text":"皖岭潜溪已厌观，此行更赏浙东山。\n云开天姥极清旷，雾暗石桥穷险难。\n年德俱高真召杜，风情未减眷樊蛮。\n侧闻侍从多虚位，宁许耆英便赐闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张师言知台州二首 其一","author":"李长民","text":"岧峣台岳镇东陬，地近行都委寄优。\n就付金庭老宫使，曾持虎节古扬州。\n行春想见勤宣布，访古无因预唱酬。\n我诵甘棠增感慨，愿公封殖表前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"廉堂","author":"李长民","text":"政拙惭无善最闻，但欣青嶂对谁门。\n公馀静室聊观易，客到廉堂谩洁樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李长民","text":"地迥七杉成斗野，雨馀双练泻晴川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见旧题壁","author":"柯梦得","text":"小迟点笔醉还嗔，画断萧梁古佛尘。\n今日重来应抵掌，十年分付未逢人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚望","author":"柯梦得","text":"无数寒鸦来远钟，物华心迹偶然同。\n不知海北江南路，更有愁人立晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方公祠堂迎送神曲","author":"柯梦得","text":"思公不见兮我心愁，渺八荒兮远游。\n严祀事兮岁修，几来下兮淹留，勤恤祈天兮惠泽周。\n如父母兮子孙谋，非公休我兮我何以休，谁知公心兮不独桂人是忧。\n蘅杜兮荐羞，桂醑兮芬浮。\n临飨兮谁酢酬，胥乐兮和气流。\n是感是慕兮无昭幽，惠我桂人兮百千秋。\n菲荐毕陈兮歆斯鉴斯，歌鼓方洽兮送歌继之。\n拥翠云兮祥风驰，乘雾毂兮扬桂旗。\n秀峙兮瑩澌，可游兮可嬉。\n来何从兮去莫追，怅望不及兮天一涯。\n化灾沴兮景贶绥，愿倏尔兮祀事孔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陌上桑","author":"柯梦得","text":"朝采陌上桑，暮采陌上桑。\n一桑十日采，不见薄情郎。\n正是吴头桑叶绿，行人莫唱江南曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"柯梦得","text":"龙首山头桑苧翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谈命严叔寓","author":"李长沙","text":"平时已秉班扬笔，暇处不妨甘石经。\n吾里忻传日边信，君言频中斗杓星。\n会稽夫子馀诗礼，巴蜀君平旧典型。\n历历周天三百度，更参璿玉到虞廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与致道约游阳华寻以雨阻追和山谷集中岑公涧二绝句韵 其二","author":"李长庚","text":"阳华妙处吾能说，泉响风摇环佩声。\n定是山灵嫌俗驾，电光掣过雨如倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与致道约游阳华寻以雨阻追和山谷集中岑公涧二绝句韵 其一","author":"李长庚","text":"垂垂雨脚几时晴，便拟扁舟乘兴行。\n想得斜川今更好，胜游恨不继渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈士淳主簿举似与严庆曾主簿邓伯允仙尉同到阳华佳句且有岩下弄琴舟中吹笛之乐长庚虽不奉胜游辄继高韵 其三","author":"李长庚","text":"云水光中语更清，从他山寺晚钟鸣。\n满船载月归来好，一笛穿云裂石声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈士淳主簿举似与严庆曾主簿邓伯允仙尉同到阳华佳句且有岩下弄琴舟中吹笛之乐长庚虽不奉胜游辄继高韵 其一","author":"李长庚","text":"说着幽岩意已清，那堪地近一牛鸣。\n尘萦俗累不容到，若见山灵烦寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈士淳主簿举似与严庆曾主簿邓伯允仙尉同到阳华佳句且有岩下弄琴舟中吹笛之乐长庚虽不奉胜游辄继高韵 其二","author":"李长庚","text":"阳华山水自双清，况弄朱弦金石鸣。\n我是行人那敢听，恐翻别调作离声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙甲寅五月十七日从令尹张济之早饭狮子岩晚饮阳华岩夜阑乘月泛舟而归 其一","author":"李长庚","text":"朝游狮子晚阳华，玩水看山乐可涯。\n野鹤沙鸥惯看客，一双对立渡头沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙甲寅五月十七日从令尹张济之早饭狮子岩晚饮阳华岩夜阑乘月泛舟而归 其二","author":"李长庚","text":"到此令人忆漫郎，笔端妙语发天藏。\n泉声漱玉生秋思，不减湖中五月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙癸丑二月二十六日蒋助教言正招游阳华婆娑岩下薄暮乃归得诗五绝以纪其事 其二","author":"李长庚","text":"偶寻三径到阳华，碧玉珍珑真可家。\n追想旧游如梦寐，摩挲石刻但咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙癸丑二月二十六日蒋助教言正招游阳华婆娑岩下薄暮乃归得诗五绝以纪其事 其三","author":"李长庚","text":"岩下留连且尽欢，不知红日半衔山。\n归时林壑风烟暝，赖有昏鸦相伴还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙癸丑二月二十六日蒋助教言正招游阳华婆娑岩下薄暮乃归得诗五绝以纪其事 其一","author":"李长庚","text":"春风今日扇微和，触目江山发兴多。\n如画幽岩无十里，轻衫短帽得婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙癸丑二月二十六日蒋助教言正招游阳华婆娑岩下薄暮乃归得诗五绝以纪其事 其五","author":"李长庚","text":"我识阳华六十年，当时面目故依然。\n清泉白石都无恙，华发苍颜只自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙癸丑二月二十六日蒋助教言正招游阳华婆娑岩下薄暮乃归得诗五绝以纪其事 其四","author":"李长庚","text":"我老思为漫浪翁，暂来却恨去匆匆。\n山头日色赤如血，照映川原草木红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯清明约邓致道游阳华","author":"李长庚","text":"我来挈挈倦尘沙，下马无心更忆家。\n不怨客中逢熟食，只知醉里是生涯。\n花边顿觉春光老，柳外还惊日脚斜。\n甚欲与君寻胜去，何妨著脚到阳华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己巳七月游阳华","author":"李长庚","text":"遥指断崖如削瓜，碧云一朵是阳华。\n莫言空洞中无物，须信崭巉不可家。\n已听泉声响环佩，更看山色媚烟霞。\n一邱一壑平生事，不觉归鞍带暝鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵江府判游阳华江丈□春间携家再来","author":"李长庚","text":"尘外非无境，壶中自有天。\n从来招别驾，于此漱寒泉。\n铭已得元结，记须烦子年。\n重游知更好，出谷趁莺迁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑仲冬自宁远来游阳华","author":"李长庚","text":"沿崖渡水六七里，划见幽岩画屏倚。\n却蹑长虹信步行，下瞰浅清皆脚底。\n漫郎泉石之董狐，妙语品题良不诬。\n千岩万壑果何似，吾家九疑真不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长庚绍兴十九年七月十九日尝游阳华后十有二年复以是月是日从乡曲诸公再到岩下感今追昔因成十韵","author":"李长庚","text":"阳华近七里，不到馀十年。\n乃知声名锁，能障山水缘。\n今日与邻曲，胜游追斜川。\n瘦藤穿荦确，一叶弄潺湲。\n岩扃隐翠竹，梵宇净青莲。\n一笑蹑飞虹，毛骨清欲仙。\n婆娑宝璎珞，放浪玉壶天。\n曲肱卧盘石，涤耳听流泉。\n片云飞雨来，更觉秋凛然。\n酒尽与归去，千林昏暝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙甲寅五月十七日从令尹张济之早饭狮子岩晚饮阳华岩夜阑乘月泛舟而归 其三","author":"李长庚","text":"雨馀山色媚晴晖，无事孤云自在飞。\n坐到黄昏尤不恶，载将明月满船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源","author":"李韦之","text":"商山四老人，避世还出世。\n桃源独终隐，坐看日月逝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白纻辞","author":"李丙","text":"娇如花，美如玉，越溪女儿十五六。\n光风入帘睡初足，起画修眉远山绿。\n飞香走红三月心，一声白纻千黄金。\n高堂客散灯火深，醉鬓斜钗夜沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜夜曲","author":"李丙","text":"玉窗结怨歌幽独，弦绝鸾胶几时续。\n铜龙漏促春夜长，冷雨酸风乱心曲。\n閒熏翠被郁金香，拂拭绣枕屏山绿。\n飞飞乳燕归不归，寂寞流苏帐前烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋江西立上人中岩","author":"李功父","text":"一室在山心，君栖背俗深。\n四傍通古道，八面见平林。\n禅有藏云穴，吟无碍月岑。\n时情任偏党，谁可浼幽襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]