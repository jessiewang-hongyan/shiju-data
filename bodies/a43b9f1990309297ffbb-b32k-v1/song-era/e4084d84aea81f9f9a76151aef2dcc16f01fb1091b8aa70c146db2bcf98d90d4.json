[{"title":"端午书事","author":"白子仪","text":"火云方炽又风薰，谁柅天边午日轮。\n靖郭所生为贵子，灵均已死作忠臣。\n朝衣耻立鸡争地，宾幄难量狗盗人。\n休语前书忧喜事，浴兰角黍是良辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑伏偶书呈端祖抑之","author":"白子仪","text":"岁时三伏每相承，雨汗居人因不胜。\n况是五弦均长养，何须六幕苦炎蒸。\n中乾愿沃仙盘露，上赐堪加凌室冰。\n安得天风破烦溽，释然群动返清澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初伏后偶书呈抑之","author":"白子仪","text":"炎天三伏经初伏，火烈石焚疑此时。\n钩带已逢瓜入座，扶疏还爱树成帷。\n良田广宅富家事，万壑千岩逋客期。\n顾念宿心俱未适，但惭种种鬓垂丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西归中秋夜宿三泉寄仙之公南","author":"白子仪","text":"日涉征涂信马前，鸿飞时节几怀贤。\n青山渐向故园近，皓月更临归驿圆。\n四乘光荣惭太子，一箪穷陋本颜渊。\n江皋上客红莲幕，犹荷明恩未弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景孙八月十四日惠酒","author":"白子仪","text":"金瓮兰英见贶时，桂轮犹惜一分亏。\n未知望夜谁同赏，先喜醉乡今有期。\n飞盖正怀曹子建，登楼何待庾元规。\n薄帷长簟忘秋兴，且洗清尘举渌卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜呈抑之","author":"白子仪","text":"逸景运寒燠，良辰徒送迎。\n冬权讫昏暮，岁籥改黎明。\n华发任疏飒，宿心无变更。\n唯凭一樽酒，时得慰劳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耆英会诗二首 其一","author":"刘几","text":"司徒硕德今无比，太尉殊勋固绝伦。\n偶以暮年陪盛宴，喜将白发照青春。\n八公有秽山空著，四皓当衰心且伸。\n元老相望疏迹在，不应此会愧前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耆英会诗二首 其二","author":"刘几","text":"制举省元推二相，龙头昔日属宣猷。\n人间盛事并遐算，一席几盈九百筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耆英会诗","author":"冯行己","text":"书称五福寿为先，有德人方得寿延。\n自愧栎樗非远器，谁应齿发亦遐年。\n立身官未三公贵，推老名陪二相贤。\n喜把衰容模梵宇，惭无纤效勒燕然。\n当时遭遇承陶冶，今日光荣预燕筵。\n从此洛城增胜概，又新重作画图传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读元颜二公中兴颂碑","author":"陈统","text":"中兴碑颂□峥嵘，三百年来蠹不生。\n湘水无穷流善价，□山长在耸高名。\n文传幼妇词原赡，翰洒崩云笔力精。\n按部舣舟思访古，拂尘珍赏眼偏明。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经浯溪元次山旧隐","author":"陈统","text":"次山曾此隐，溪壑水清漪。\n废宅群山合，高名千古垂。\n修篁森钓渚，乐石耸丰碑。\n唯有乔林色，苍苍似昔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵峰院","author":"湛俞","text":"禅林潇洒倚危巅，税驾登临思豁然。\n万里碧光晴望海，一堂幽响夜听泉。\n寒龛能卧清凉地，古洞云归黯淡天。\n好景自嗟吟不尽，拟凭图画寄诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建茶和罗拯韵","author":"湛俞","text":"御茗毓何峰，烟岚十二重。\n玉泉新吐凤，金饼五盘龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"湛俞","text":"茉莉晓迷琼槛白，荔枝秋昳绮筵红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"湛执中","text":"人在蓬壶颓白玉，地连兜率布黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澄虚亭","author":"徐良佐","text":"一溪水浸群峰绿，潋滟长湖澄数曲。\n波光如练映危亭，倚槛最宜凝远目。\n亭前日日舟人行，千里万里风帆轻。\n长汀回首望不尽，接天岚气何其清。\n隔溪南下乾元路，古松峭拔藏禅宇。\n馀不祠前千尺潭，昔有灵龟曾左顾。\n时迁岁改名独存，德清从此民俗淳。\n山奇水秀冠南国，是处疑有桃花源。\n过桥稍转十馀步，家家相向开朱户。\n大都川泽气多寒，时时猛点菰蒲雨。\n晚来忽霁凉意新，一片两片归岩云。\n惆怅王维不在世，把笔欲画今无人。\n老夫歌诗久不作，对此吟情岂宜薄。\n簿书推去试新吟，眼前好景难道著。\n城中美酒斗十千，浦口鱼肥卖得钱。\n夜深却羡渔翁乐，醉饱溪心明月眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招提院静照堂","author":"王异","text":"珍重慧空营妙隐，标题静照作佳名。\n新堂复胜牛车乐，旧阁如抛火宅萦。\n万虑根源尘外息，一轩景物鉴中明。\n夜深宴坐心虚寂，檀蕙烟微风月清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自然亭","author":"张徵","text":"久雨妨渔复滞樵，自然亭上一逍遥。\n万缘不自闲中起，百事唯于睡里消。\n老去自知如蠛蠓，病来谁悟似芭蕉。\n爱名之世忘名客，幸有山林旧市朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书故三司副使陈公亚之诗轴后","author":"张徵","text":"破锦囊开玉振金，舍人胸次右丞心。\n为时黼藻衣冠薮，与国丹青翰墨林。\n慷慨似谁双舞剑，风流随处一歌琴。\n燕贻苦志追先烈，子夏何须论浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀呈江阴军","author":"裴若讷","text":"男儿忧道不忧贫，匣有焦桐箧有文。\n却访姑苏台下隐，满船明月一溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江阴绝句","author":"裴若讷","text":"紫莼江上是吾家，一叶扁舟一钓车。\n何必陶公种鱼法，雨汀烟渚尽生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"裴若讷","text":"渔人借问去何处，白酒香甜紫蟹肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题曲水阁","author":"邵必","text":"凿石得春渠，波环阁势孤。\n新痕涨微雨，远碧注平湖。\n士俗山阴旧，风光洛曲殊。\n回眸见危岭，凭槛有惊凫。\n坠蕊浮旋濑，疏篁荫叠栌。\n人閒多拾翠，鱼乐半依蒲。\n河朔谁觞友，沂津昔咏儒。\n遗芬知未泯，游盖此为娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"邵必","text":"我尝淮上送君行，前日郎官此日卿。\n一道清风新使节，万家和气旧民情。\n西山药味迎秋熟，同浦波光照物明。\n佳景多才雅相值，高吟应未负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钱公辅众乐亭 其一","author":"邵必","text":"海边民物鲜欢娱，太守经营与众俱。\n园圃新阴多杞柳，池塘生意足鱼蒲。\n长空不碍高飞鹄，浅水兼容短胫凫。\n此乐有谁知我趣，归来红旆日西晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钱公辅众乐亭 其二","author":"邵必","text":"城外千帆海舶风，城中居市苦憧憧。\n几生佳景为民老，一日贤侯与我同。\n道上槐阴连帟翠，水边人面照花红。\n寄言乐有时还尽，徒见甘棠忆召公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"邵必","text":"素壁镵诗尚未泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈述古仙居岩老堂诗","author":"崔黄臣","text":"床头数卷书，足以乐樵渔。\n众谓衣冠传，自同岩谷居。\n潜心富仁智，育德审盈虚。\n刺史如相访，渊明有旧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鼓角山","author":"吴世延","text":"黎明骑马出城阃，鼓角山前访故人。\n白水一陂浮鹤背，青田千里叠虬鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孔司封题蓬莱阁","author":"沈绅","text":"三山对峙海中央，高阁新题紫翠房。\n玉铉相君颁瑞地，金貂仙子挂冠乡。\n云随步武鳌头稳，风满中裾鹤背凉。\n吸尽流霞不知醉，直须乘月据胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州 其一","author":"沈绅","text":"天街雨歇槐飞花，镇东新府腰青緺。\n晓排阊阖辞玉皇，肃斋先过文德衙。\n赤墀再拜升东涂，赭袍前对明朱霞。\n公行早为上所器，恩言褒宠何光华。\n翰林紫微文章公，欢然惜去宴头加。\n东堂西府争落笔，诗艳万丈灵星槎。\n行周四方心尚壮，劲气晚节开胡沙。\n东南便乡久思归，翠岩白水得地嘉。\n秋风鲈鱼正鲜肥，旗鼓满城看过家。\n吾乡禹功有馀烈，旧俗质厚民不哗。\n比年天时苦荒札，大资公已勤栉爬。\n行当下车镇清和，仁贤相继自足夸。\n蓬莱到日望三山，海波浸眼穷天涯。\n酒浓诗豪真乐都，莫为画船留若耶。\n公才甚高宜大用，归来禁鼓听新挝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州 其二","author":"沈绅","text":"千兵督府占楼居，刻锁君门一夕虚。\n为厌承明新递直，却探禹穴旧藏书。\n家头鼓角闻初近，座上湖山画不如。\n一道政清貔虎肃，四星密拱紫微车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题寒亭山壁","author":"沈绅","text":"元子此始来，大暑生冻骨。\n名亭阳崖角，高文犹仿佛。\n我行冰雪天，噤语揖风物。\n银江走碧涨，九疑抱云窟。\n它年名不磨，至者戒无忽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"褚珵","text":"元稹唐朝辅相材，全家曾住小蓬莱。\n公今得请为藩去，事异当时谪宦来。\n雅意未应亡魏阙，归心且喜过苏台。\n茂林修竹仁风动，紫蟹黄柑宴席开。\n听讼初承召公后，递诗须继乐天才。\n政成不待三年报，入告谋猷岂晚哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢王介甫","author":"薛利和","text":"一路生灵陡顿贫，庙堂康济岂无人。\n君王若问茶租日，请把茶租乞与人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文惠公独游亭","author":"薛利和","text":"轩槛前临一水湄，此亭谁见独游时。\n春风坐处无人伴，秋月行来有影随。\n文酒等闲辜会友，溪山赢得自裁诗。\n城东老屋今仍旧，当日高踪孰可追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩亭","author":"薛利和","text":"岭脊孤亭势倚云，前临城邑后荒村。\n八千里外人归久，四百年间木尚存。\n直北恶溪泉滚滚，落南瘴海雾昏昏。\n先生伟绩传青史，万古民怀逐鳄恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖亭","author":"薛利和","text":"一泓泉色涨漪涟，窃号西湖几百年。\n泛出芰荷钱万叠，洗开杨柳眼三眠。\n雪鸥卧听禅僧磬，锦鲤行惊钓客船。\n若比钱塘江上景，欠他十里好风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"薛利和","text":"傍人笑我无蓝袖，今日朱衣岭上归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游胜法寺兼简深公","author":"陆绾","text":"道旁有古寺，岿然耸梅林。\n迩来衣褐徒，包祸岁月深。\n埋伏狡兔穴，啸聚恶木阴。\n安得智慧剑，力斩奸邪心。\n吾师曹溪流，所在人依钦。\n郡邑两交疏，来发云雷音。\n初如碎瓦砾，乃见真球琳。\n瞽者破其瞽，瘖者破其瘖。\n有若鸾凤巢，无复鸱鸮禽。\n嗟予困吏役，海岸宜投簪。\n扁舟扣禅户，清风满衣襟。\n高论松桂间，为师挥玉琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招提院静照堂","author":"闻人安道","text":"清虚结宇卜新居，寂静标名欲性纯。\n直向万缘无断处，应为一念不生人。\n风幡震动殊非闹，水月澄明未是真。\n宴坐经行惟此地，个中消息与谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"闻人安道","text":"秋浦澄明郡境清，天然岩岫作南屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧落洞","author":"李京","text":"赏景尘嚣外，放怀岑寂中。\n寒崖映流水，古桧生清风。\n坐有琴酒乐，路非车马通。\n何当遂初志，来此期芝翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刻浯溪石上","author":"柳应辰","text":"浯溪石上大江边，心记闲将此地镌。\n自有后来人屈指，四千六百甲寅年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浯溪","author":"柳应辰","text":"不能歌，不能吟，潇湘江头千古心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石角山","author":"柳应辰","text":"□□□□山几重，与君吟望意无穷。\n当时共指白云外，今日独行青嶂中。\n案牍暂休聊自适，篮舆乘隙若为同。\n九嶷秋约心先到，岩月斓斑桂子红。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范阳同年示及零陵三题率然为答甚愧妍唱 其一 火星岩","author":"俞希孟","text":"信美真灵宅，呀然洞府通。\n皇家尊盛德，南夏享阴功。\n庙貌邻炎帝，峰名比祝融。\n游人思所谓，无独爱嵌空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范阳同年示及零陵三题率然为答甚愧妍唱 其二 朝阳岩","author":"俞希孟","text":"旭日多横照，幽岩得粹华。\n次山名此地，潇水汇其涯。\n峭壁生云叶，危根溅浪花。\n终携羡门侣，晨坐咽东霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范阳同年示及零陵三题率然为答甚愧妍唱 其三 澹山岩","author":"俞希孟","text":"岩腹潜云构，清凉十亩间。\n天留盘古穴，人识宝陁山。\n坏像烟岚湿，高僧岁月闲。\n圣时无遁客，佳境付禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"俞希孟","text":"若把东闽比西洛，可将陈紫敌姚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三岩诗 火星岩","author":"卢臧","text":"岩扃瞰群阜，畴昔道宫邻。\n荧惑标名旧，浮屠缔构新。\n石寒长滴乳，池润不生尘。\n吾到期深入，虬蛇勿噬人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三岩诗 朝阳岩","author":"卢臧","text":"潇湘峻岸傍，岩穴号朝阳。\n全会江云势，先分海日光。\n高深惊险易，冬夏返温凉。\n谁肯弃尘世，探穷仙者乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三岩诗 澹山岩","author":"卢臧","text":"谁开仙窟宅，非与众岩俦。\n树响晴翻雨，岚凉夏变秋。\n禽灵啼复断，云怪吐还收。\n深羡群僧住，嗟予莫少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和祖无择《途次金陵逢同年沈五判官》","author":"沈逊","text":"一自曾经别，于今叹索居。\n善交思柳惠，多病是相如。\n官下频无况，天涯每得书。\n旧怀长惋叹，此会合踌躇。\n晓露生兰苑，秋风动鲙鱼。\n萧然林野性，与世转为疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵阅道游海云山","author":"霍交","text":"山深藏古寺，旁枕旧方池。\n鼓响揭云外，石探从水涯。\n使旌游不倦，瑞麦献相随。\n事简民同乐，归心莫竞驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵抃赋新繁周表权如诏亭诗","author":"白贽","text":"亭名诏语密相沿，须信从来教义全。\n肯构尝探诗礼业，出纶特表父师贤。\n早安素履知文富，晚服朱衣称赏筵。\n不是韦家专讲学，岂闻幡戟到门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游琅邪寺","author":"周圻","text":"杉松夹道绿森森，古寺尤欣结客寻。\n殿阁长时异香满，亭台佳处白云深。\n清泉迸石落寒谷，幽鸟避人穿茂林。\n缓步闲看旧题咏，盆池莲叶几浮沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香山寺","author":"韩综","text":"信马盘桓上碧穹，云埋松翠梵王宫。\n老僧细说禅机话，深会菩提色即空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诃孟子","author":"李觏","text":"完廪捐阶未可知，孟轲深信亦还疑。\n岳翁方且为天子，女婿如何弟杀之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"苏洵","text":"雀鷇含淳音，竹荫抱静节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"科漏新成 其二","author":"程师孟","text":"风雨虽昏漏不移，百年应未失毫釐。\n须知万户千门里，正得人间吉凶时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"唐介","text":"越林多蔽天，黄柑杂丹橘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"王说","text":"晓色光华去玉京，画船新指会稽行。\n地严琐闼通班贵，道出吴门过里荣。\n亭惹春云兰渚静，波涵秋月鉴湖清。\n吏师诗匠高当世，卧镇何妨咏太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广胜寺","author":"王说","text":"山亭十里见纤微，暂出红尘已息机。\n次第一行寒雁去，浅深千片乱霞飞。\n青山不断何年有，流水无穷底处归。\n自古兴亡安足问，世间人事转头非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自况三首 其一","author":"邵雍","text":"名利场中难著脚，林泉路上早回头。\n不然半百残躯体，正被风波汩未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治乱吟五首 其一","author":"邵雍","text":"乱多于治，害多于利。\n悲多于喜，恶多于美。\n一阴一阳，柰何如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人心","author":"邵雍","text":"弟兄尚路人，它人安可从。\n人心方寸间，山海几千重。\n轻言托朋友，对面九嶷峰。\n多花必早落，桃李不如松。\n管鲍死已久，何人继其踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]