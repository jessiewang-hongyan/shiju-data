[{"title":"种松添竹口占二绝 其二","author":"张侃","text":"种得成时我已归，明年此际弄秋晖。\n丁宁园叟频浇灌，要见元功无尽机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵竹林玉老三首 其一","author":"张侃","text":"笔法有神缘剑舞，诗坛游戏也无妨。\n却嫌踏破铁门限，刬草堂前化鞠场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵竹林玉老三首 其二","author":"张侃","text":"我似吴牛喘月光，领疮磨鞅巧相妨。\n何时饱听林间笛，了却官租稼涤场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵竹林玉老三首 其三","author":"张侃","text":"晚景奔忙驹过隙，闹中且觅静何妨。\n时宜正要新声巧，贺老龙钟莫定场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"独坐","author":"张侃","text":"破愁浅酌贤人酒，觅句还寻君子花。\n造物于予元自厚，闭门独坐日初斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻鹊","author":"张侃","text":"举头闻鹊心偏喜，的是庭闱初寄书。\n报语加餐眠稳外，只留清白替菑畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"张侃","text":"村烟四五水成湾，拍拍凫翁意自閒。\n秋雨不能回众绿，洗开霜色露寒山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月朔","author":"张侃","text":"一春多雨阻清游，留得名花到暮秋。\n偶见来禽与仙杏，淡红残粉亦风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大龙寺荆公诗石","author":"张侃","text":"宰邑归来便老成，岂知诗句是心声。\n细看野水无人渡，终胜蟠龙守此清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中独步家园","author":"张侃","text":"北风掠地尽无尘，惜许林园未有春。\n小试囊中餐玉法，谁为天外散花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月晚访梅","author":"张侃","text":"墙隈杨柳已垂丝，岸北梅花始着枝。\n风掠晴香觅诗句，容渠开晚占春时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其一","author":"张侃","text":"旧冬全未见梅枝，多是江南春讯迟。\n今日相逢犹摘索，翠涛笺上写新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其二","author":"张侃","text":"蹋雪西村探古梅，一株寂寞为谁开。\n不消弦管与弹压，自有骚翁时往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其三","author":"张侃","text":"一冬多雪更多阴，问讯溪梅春未深。\n等得春来花已漫，孤高不改岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其四","author":"张侃","text":"半生见梅唤作兄，我诗政见梅边清。\n前回待欲唤曾子，惜许疏蟾未弄明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其五","author":"张侃","text":"不作等閒桃李色，一声羌笛怨惊尘。\n偶思今岁开花晚，要醉风前烂熳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其六","author":"张侃","text":"琉璃木叶衬琼英，折得归来照眼明。\n闻道此花清似我，莫言避俗太无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其七","author":"张侃","text":"剪蜡匀脂别样妆，吐芳先与探春光。\n为缘骨相天然好，所欠江头细细香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其八","author":"张侃","text":"近来疏懒任方圆，参取梅花句里禅。\n三尺枯藤同所好，断无人似拙翁颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其九","author":"张侃","text":"春已多时花渐繁，劝梅未用点苔斑。\n隔尘自有元规扇，要见风流庆历间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅时往来郊外十绝 其十","author":"张侃","text":"溪边小圃半荒芜，数种梅栽莫负渠。\n香色几年吟不尽，蜂须先得妙工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄木香","author":"张侃","text":"名花爱向春深月，幻作人间黄玉花。\n裛露承风娇不尽，好将逸语为渠誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日二首 其一","author":"张侃","text":"木香堆架渐开花，旁径蔷薇锦未斜。\n风劈柳丝成乱絮，轻轻飞入野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日二首 其二","author":"张侃","text":"春光到此未须归，绿替红残已暗围。\n说与群儿休赶逐，要看宛转自然飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贉村望潮","author":"张侃","text":"沿江一曲水通村，潮拍平沙满旧痕。\n落日镕金潮又涨，水天直接海山门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题睡布袋","author":"张侃","text":"佛身广大遍虚空，收拾归来一衲中。\n走入睡乡推未觉，只缘认得主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后","author":"张侃","text":"连朝风雪满空来，喜得新晴万象回。\n甚欲出门寻野兴，梅花多是旁春开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题等慈寺后经略潘德鄜旧居三绝 其一","author":"张侃","text":"父兄师友俱鸣世，培养都缘岁月深。\n忍得清贫忘宠辱，至今声誉蔼儒林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题等慈寺后经略潘德鄜旧居三绝 其二","author":"张侃","text":"中书当日冠天下，半世浮萍无定居。\n却是子孙能力守，结茅随分并精庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题等慈寺后经略潘德鄜旧居三绝 其三","author":"张侃","text":"古来名士都如此，后世虚浮类鄙之。\n赖有晦翁高著眼，青青钜竹荫檐楣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊杨园诗","author":"张侃","text":"名园依水跨官塘，古木扶疏围夕阳。\n粉蝶不来蜂又去，一双燕子话凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其一","author":"张侃","text":"半夜燃萁车堰归，县街灯火已稀微。\n路人莫笑奔波甚，领略江山暂解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其二","author":"张侃","text":"旋呼篷艇到新桥，日影随寒上柳梢。\n乌帽䊶裙真野服，又乘山轿过山腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其三","author":"张侃","text":"宿雾漫山寒未开，老僧笑我四番来。\n功名迁转都如此，颇羡幽人隐涧隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其四","author":"张侃","text":"百漏船东竹似椽，一杯茗粥说痴禅。\n恰如二月乌㩜角，村北村南童稚颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其五","author":"张侃","text":"贫民逐利可怜生，水附泥乾卤渐成。\n多得卤成求浅利，问天乞取一冬晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其六","author":"张侃","text":"沿湖水浅滩势斜，小儿并滩运鱼叉。\n风力如铦双股冷，青帘侧边是侬家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其七","author":"张侃","text":"秋晚曾来十日过，满田稗子绿成窠。\n年荒只待州家榜，分数搀多喜若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其八","author":"张侃","text":"星移山转度寒沙，到得塍头鼓二挝。\n忽忆昔年斗门渡，风翻浪叶橹攲斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其九","author":"张侃","text":"敲开野店旋吹灯，旧酒重温盏易冰。\n十五年来随分过，任人呼作在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪程十绝 其十","author":"张侃","text":"冬晴全未见梅花，篱角黄花尚缀葩。\n剩喜交情真耐事，风流不到五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海际民田","author":"张侃","text":"良田水旱不妨耕，海际成田禾罕生。\n一夜潮来留剩水，民家辛苦望西成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐","author":"张侃","text":"繁弦脆管挟春华，都属侯门富贵家。\n我独萧然无一事，清宵兀坐听鸣蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题旌教院僧房云舫又名百漏船三首 其一","author":"张侃","text":"山僧成岁枕云根，岂是无心直漫云。\n更辟短窗临涧水，自题云舫见殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题旌教院僧房云舫又名百漏船三首 其二","author":"张侃","text":"云片东西自在飞，偶然连缀又成衣。\n商量做雨竟何事，刻画奇峰便忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题旌教院僧房云舫又名百漏船三首 其三","author":"张侃","text":"既名云舫知归宿，何用多言惹是非。\n水到渠成添百漏，可怜未解箭真机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳树汇","author":"张侃","text":"望望孤城绿树根，平沙连屋草连云。\n夕阳坡上人牛小，耕出羌王古印文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟子汇","author":"张侃","text":"暝入荒山近十里，茅屋人家隔溪水。\n青灯一夜不成眠，明日长征又如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"始宁泉","author":"张侃","text":"始宁花木今何在，一派山泉纪此清。\n说与老僧频整葺，世间难保是虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寺楼舒目","author":"张侃","text":"风尽天阴分野色，雁眠云影得新晴。\n江台寺里閒登览，屋绕吴山画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其一","author":"张侃","text":"一九才过二九来，见人相唤袖难开。\n外头天色时时转，雪急因风缓缓回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其二","author":"张侃","text":"三九寒威渐渐强，颠风刮面怎禁当。\n篱头觱栗从头响，添得人愁线样长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其三","author":"张侃","text":"沽酒烹鱼送旧年，情知四九在冬前。\n烘来布被何曾暖，身作弯弓宿露天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其四","author":"张侃","text":"今年灯市好安排，雪柳香梅费剪裁。\n岁月匆匆临五九，太阳门户向东开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其五","author":"张侃","text":"冬深生冷喜新春，赋得贫穷敢怨人。\n六九数终风扇动，放些意气走芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其六","author":"张侃","text":"转头七九数过三，无事閒从野老谈。\n花气熏人能样猛，脱来布衲两头担。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其七","author":"张侃","text":"五五三三抛堶忙，柳丝深处映陂塘。\n狸奴犬子寻阴地，八九春中日正长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代吴儿作小至后九九诗八解 其八","author":"张侃","text":"我侬閒过谢皇天，只愿从今大有年。\n九九数来无可数，都将犁把去耕田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家园散策二绝 其一","author":"张侃","text":"山容娟丽青无尽，心地宽閒乐有涯。\n春讯不应梅占断，风流犹有海棠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家园散策二绝 其二","author":"张侃","text":"散策家园日护云，静看溪水碧生粼。\n春光不为名花老，赢得年年锦绣新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫人斜","author":"张侃","text":"涂脂抹粉岂长妍，得宠宜思辱在先。\n万古宫人斜上望，淡烟衰草为凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔷薇三绝 其一","author":"张侃","text":"多谢东风巧剪裁，朱朱白白待春开。\n偶因无事寻诗句，又见沿蹊锦绣堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔷薇三绝 其二","author":"张侃","text":"雨回新绿方留润，日映轻红无尽娇。\n为惜江南春事好，对香吹水入金焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔷薇三绝 其三","author":"张侃","text":"蔷薇开尽知春晚，燕子閒来又日西。\n却恨丹青描不得，旋将心事付深闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"近于小圃筑堂名曰秀野隔河插木芙蕖旧有诗云","author":"张侃","text":"二十四番花信风，凝脂剪翠巧妆容。\n谁言桃李芳春后，不似沿流锦绣中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再吟二绝 其一","author":"张侃","text":"绕堤尽种木芙蕖，杨柳阴中动碧虚。\n待得秋来花胜锦，柳丝断续怕风梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再吟二绝 其二","author":"张侃","text":"二十四番风报信，名花开了便匆匆。\n谁言造化无穷尽，又报秋花第一风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶吟","author":"张侃","text":"将花作婢那解语，唤竹为奴亦浪名。\n雾鬓云鬟休用怨，主翁先有不平鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"范园","author":"张侃","text":"隐之立异酌贪泉，直使吾名四海传。\n得似范公全雅志，只将清白遗时贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"轩亭","author":"张侃","text":"篮舆清晓过轩亭，轩外山围未了青。\n我意他年寻一壑，只因今日眼曾经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"延桂堂","author":"张侃","text":"静看桂影上帘栊，几度吟诗句未工。\n从此相忘天地外，主人袖手小阑东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小池","author":"张侃","text":"小池栽得数枝莲，也占新凉七月天。\n说道南湾纳空阔，尽将野意换韶妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水月泉","author":"张侃","text":"水清月白又初秋，㶁㶁山泉入涧流。\n我已重来君解否，生平厌作是非谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江下","author":"张侃","text":"昔曾襆被宿江浔，风雨欺人春未深。\n转盼六年重到此，越山依旧隐云心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丈亭","author":"张侃","text":"潮水冲沙未转清，急摇双橹似鹅鸣。\n须臾停橹依荒岸，草屋疏灯记夜程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题怀谢驿","author":"张侃","text":"谢公洗屐水平池，笑傲东山望一时。\n究竟后人能尚友，驿名怀谢著深思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶得","author":"张侃","text":"客舍墙根草未生，市桥官柳已欣荣。\n洪钧造物元无意，只是东风有世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"张侃","text":"竹奴角簟颇相宜，正是书斋寂静时。\n白鸟忽穿林影去，自携纨扇细题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书二绝 其一","author":"张侃","text":"静观万物各随缘，天亦何心付自然。\n鸲鹆不材鹦鹉贵，岂知鸲鹆得天年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]