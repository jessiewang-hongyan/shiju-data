[{"title":"七夕怀徐十用去年所赋东坡清凉韵","author":"李彭","text":"幽人喜雨静无尘，雨罢幽虫料理人。\n顾我维摩方卧病，忆君徐稚是前身。\n钟鸣祗树年华隔，潮上吴江月色新。\n共看牵牛渡河汉，月残露脚湿纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏次人韵","author":"李彭","text":"人言鼓吹来诗思，鸣鹤遂闻长阜音。\n细读一犁新句好，始知三语用功深。\n自甘散木傲霜节，懒作幽云出岫心。\n茗盌炉芬清昼永，流莺捎蝶过墙阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送果上人坐兜率夏","author":"李彭","text":"落絮霏霏搅客心，鸣鸠历历唤春阴。\n未于莲社添宗炳，已向兰亭减道林。\n远峤烟横钟磬晚，禅天目断薜萝深。\n诗缘酒废苦无思，为子送将聊一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中次珍书记韵","author":"李彭","text":"沙头作别数峰暝，意逐屯云愁晏阴。\n雨打船篷藏枉渚，钟残客梦忆禅林。\n山重水复归棹远，鱼跃鹭飞寒苇深。\n何日支郎访玄度，倚松停策伴微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用师川题驹甫诗卷后韵","author":"李彭","text":"梦中逐客幻中归，荆楚瓯闽好赋诗。\n谁谓涪翁呼不起，细看宅相力能追。\n太冲文价轻皇甫，籍也辞源怯退之。\n丘壑同盟从已定，莫令鬼祟作愁眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"李彭","text":"槐火煎茶气味新，东园肯让兔园春。\n鸟摧秾李沾衣袂，蝶绕夭桃傍鬓唇。\n回策如萦峻仪范，好诗转弹绝风尘。\n颇胜袁粲饮无偶，步屧白杨要恶宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贻王充道隐士","author":"李彭","text":"忆昨涪翁虎溪别，雁来一字不宁收。\n劳君为传三月信，遣我少宽千斛愁。\n烟艇方游建业水，玉人犹在仲宣楼。\n何时挂席西湖去，藜杖青鞋鹦鹉洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潮州木龟有堂旧在天庆观北极殿之左近为道流窃取而去今莫知所在矣","author":"李彭","text":"长生要自食山藓，妙语宁闻葛稚川。\n忽见灵龟藏六用，定巢莲叶阅千年。\n刳肠已笑清江使，曳尾聊同修水边。\n悬想偷儿难卜夜，守闾黄耳得安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿侍其云叟书斋","author":"李彭","text":"高斋解榻留我宿，破梦惊涛翻疾雷。\n水鸟时呼山鸟语，朝帆才去暮帆来。\n百年荣落真堕甑，一世称讥同死灰。\n珍重秦淮隐君子，只今风月且衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹枕","author":"李彭","text":"湘江翠竹斩云根，偃月初无刻削痕。\n尚想繁柯俱笨尊，宁经綵凤屡飞翻。\n佳眠时有池塘梦，避暑不劳河朔樽。\n殷殷晴雷喧白昼，儿童走报雨翻盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过林子幽居","author":"李彭","text":"卧听山城罢击柝，策蹇过君霜满须。\n窗间山好天欲曙，庭下菜肥人愈臞。\n我非当世可领袖，君合于今称楷模。\n谢公小草恐未免，怀宝要令真不沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同安即事","author":"李彭","text":"摇落霜林秋兴新，舍舟寻壑自冥尘。\n云光山色解迎客，松气竹氛俱着人。\n汉上营诗多累句，孟生题壁欲伤神。\n频伽依旧丁宁语，应笑华颠映角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怡颜堂","author":"李彭","text":"心远由来地自偏，有琴何必问无弦。\n新醪清浊动秋兴，老树扶疏可昼眠。\n失学已从儿辈懒，哦诗常苦后生传。\n此腰倔强应难折，尚愧颜公二万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周明府国镇寄诗有招隐之意次韵以报之","author":"李彭","text":"绝壑平生深遁逃，相期推毂敌英豪。\n绿葵白薤堪扶老，黄帽青鞋非养高。\n薰浴悬知惭管葛，经纶何敢望崔毛。\n新诗如对故人面，清夜不眠鸡屡号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予以王褒僮约授嗣行叟叟有书抵予并求跛奚移文且云要与僮约作伉俪以此诗戏之","author":"李彭","text":"髯奴上券归公许，跛奚移文犹见催。\n臧获要令成伉俪，文章相与挟风雷。\n目成眉语似真尔，足蹑心邀安在哉。\n大士好奇聊一戏，不应禅寂便寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏何人表","author":"李彭","text":"示疾维摩难共语，谁堪问疾坐绳床。\n也知世乏长桑手，尽用枕中鸿宝方。\n马价不须劳广汉，牛衣何用泣王章。\n清凉心地俱安稳，特访名园顾辟疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲豫买侍儿作小诗戏之","author":"李彭","text":"霜鹗横空河汉秋，聊随鸡鹜稻梁谋。\n却将属国旧长剑，换得石城新莫愁。\n要遣短辕无复驭，定看遥集解忘忧。\n匡山醉客时相访，莫下疏帘作障羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪上","author":"李彭","text":"门前浑是浣花溪，坊里深疑号碧鸡。\n短艇波横随暮霭，遥岑雨歇看朝隮。\n髯奴便了能沽酒，稚子添丁解灌畦。\n欲赋郊居追沈约，只愁误读作雌霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扇上画雪景戏书","author":"李彭","text":"醉馀澹墨写生绡，咫尺真成万里遥。\n短棹船归剡溪曲，披蓑人渡浣花桥。\n暑中松雪俄辉映，月里山河俱动摇。\n凛凛寒生立毛发，从今褦襶不须嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月二日大雪","author":"李彭","text":"天公长作狡狯戏，舍北舍南无限春。\n密密疏疏桃著糁，娉娉袅袅柳含尘。\n老人已老难复少，故衣虽故昔经新。\n岸荠未花汤饼滑，何劳象白间猩唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得了翁书","author":"李彭","text":"都司宁拂御炉香，严谴归来鬓未霜。\n麟阁他年看赫弈，兽樽今日久凄凉。\n楚氛闻说行将弭，汉道真成喜再昌。\n莫作湘累吟泽畔，锋车促召据南床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐山道中见梅花","author":"李彭","text":"江头细草已摇春，幽谷疏梅尚著人。\n未许扬州动诗兴，却嫌戚里妒妆新。\n范郎鄙枣不同传，汉省含香可买邻。\n蝶翅蜂须莫浪喜，元无一物涴香尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦雨","author":"李彭","text":"陵陂麦熟晚云黄，妇姑当穫相扶将。\n溪山作雨水漂屦，芝菌对床蜗篆梁。\n宴坐翻疑谷帘下，梦回恐在漏天旁。\n何时晴岚来入户，撩我浩歌倾一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江梅","author":"李彭","text":"江梅疏雨弄晴曛，割取江东一信春。\n剩得耐寒惊蛱蝶，竟来占醉倒纶巾。\n未容作赋重招屈，岂敢含毫论过秦。\n何日大梅梅子熟，从渠高浪白如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起","author":"李彭","text":"鸟鸟声乐报新晴，睡罢南窗午醉醒。\n恶客从讥玄尚白，斯人相向眼终青。\n渚蒲汀草垂垂发，幕燕林莺续续听。\n日籴太仓真细事，安寻佳句遣沉冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次妙明观韵","author":"李彭","text":"春岸波平汀草深，野航荡桨恣幽寻。\n星坛香转来真侣，菌阁钟鸣生道心。\n忆昨霓旌归紫府，尚馀鸿宝作黄金。\n肩吾戏吐烟霞语，缥缈欲仙难陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答仲兄元亮","author":"李彭","text":"杨柳江头人迹稀，心随钟度远山迟。\n忽传忆弟看云句，想见流觞曲水时。\n人比封胡终有恨，韵低徐庾敢言诗。\n青春欲谢子规叫，莫惜归帆赴后期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用元亮韵寄驹甫","author":"李彭","text":"才名绿发斗牛垂，天禄雠书何太迟。\n却扫未尝嗟半菽，养疴不是傲当时。\n铺张大对明光手，收卷裁成邺下诗。\n见底冰壶最清澈，何时照眼会心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用元亮韵答师川篇末见寄","author":"李彭","text":"蚤岁闻君万人敌，定交已悔十年迟。\n中间会面无虚日，底事分携用此时。\n不隔南云无过雁，犹因北阮著新诗。\n征车欲作日边去，傥赴幽园茗果期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复用迟字韵呈元亮","author":"李彭","text":"去日关河雪打围，缝裳密密恐归迟。\n忽看高笋成筠处，始见残樽下马时。\n暮雨萧萧聊洗恨，东园物物总宜诗。\n莫言心赏随年薄，勤赴幽人林下期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东台","author":"李彭","text":"门巷依依称意苔，杖藜野色逐人开。\n马驹卓锡今应在，康乐翻经那复来。\n云物苍茫山远近，波声宛转水萦回。\n风流赖有潘怀县，一洗从前猿鹤哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵徐师川喜洪驹父归自临汀之作","author":"李彭","text":"赤壁烟波翻渺溟，长沙卑湿重行行。\n一觞一咏劳清梦，三沐三薰慰别情。\n不作畔牢愁执戟，共吟哀郢哭初平。\n生来竞病几牢落，漫兴安能学背城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"度章水道中戏用城字韵呈驹甫师川","author":"李彭","text":"楚波不动晚山青，顾兔西来照我行。\n野鸟钩辀如有意，渔歌欸乃亦多情。\n湖边倒载思山简，机上回纹念始平。\n欲觅澄江如练句，乞灵须向谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答季智伯弟","author":"李彭","text":"废诗不复匠苏州，蠹简于人风马牛。\n喜有丘明能撰次，极知水部愈风流。\n句分竞病应难敌，家有封胡可解忧。\n共叹宣城游岱早，剩招去干不能收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠苏仲豫","author":"李彭","text":"平生照眼玉壶冰，解向朝阳续凤鸣。\n黄鹄楼前重会面，白莲社里定交情。\n疏才我亦怜文举，大雅君应笑正平。\n贳酒临邛聊复尔，莫令狗监污高明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠王环中","author":"李彭","text":"拄策前年访草堂，挂帆烟际在西江。\n诗随鸿雁来春渚，梦逐蟾蜍入夜窗。\n辞聘知君追孺子，屡空嗟我似穷庞。\n菟裘欲买为邻并，岁晚相期倒百缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠张仲义","author":"李彭","text":"春衫试吏楚江濆，真以文昌思不群。\n未暇等陶辞小秩，何妨慕谢始精文。\n壁间妙句流黄素，松下英姿大壑云。\n但恐承明赖公等，不容蛮府作参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉赠介然","author":"李彭","text":"弹压诸方化城老，聊同懒瓒恣佳眠。\n云随雷下雨归壑，竹引窗间风动烟。\n昼静冥搜徒觅句，道安高论愧弥天。\n丛林良药今无有，绝影须公为著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿同安用旧韵呈云叟","author":"李彭","text":"蒲柳望秋今复衰，遥岑雨罢抹修眉。\n寒林要使入方尺，妙笔悬知愧画师。\n不见扬雄草玄手，细看束晰补亡诗。\n何时共饮建业水，更把北山烟雨犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游同安寺","author":"李彭","text":"郭内那知草色新，道人庭宇别藏春。\n高榆风度青含荚，艳杏雨馀红退唇。\n茗盌薰炉清有致，禅天金地夐无尘。\n裁诗得句如拱璧，不费咸阳设九宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游昭德观","author":"李彭","text":"晓随归雁影联翩，来访仇池小有天。\n万籁虚徐杂钟磬，一源淳朴异山川。\n云霾大壑真游远，风扫石楠佳句传。\n司命峰前徐孺子，几时风雪对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏牛卿用韵见贻次韵答之夏先君子与先平阳厚善","author":"李彭","text":"君合雍容供奉班，彤墀紫仗近天颜。\n误随手板落趋走，却望家山思燕閒。\n使君铜狄悲游岱，令尹玉棺今赐环。\n樽前回首二十载，更话幽禅未易攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客有和予颜字韵诗者答之","author":"李彭","text":"蛮花初捲簟文斑，苦被秋风吹老颜。\n慰眼既亲还有旧，起予多病复思閒。\n暮年倚仗心三径，看子著鞭腰九环。\n小屈尉曹吴会去，莫因横槊废跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送规老住虔之慈云","author":"李彭","text":"禅翁竟补栖禅处，兔角龟毛杖佛僧。\n久厌宗雷同保社，却凭章贡浊埃尘。\n定携天上苍鹰爪，去接西江白业宾。\n大庾岭头梅正好，同风千里一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊外书事","author":"李彭","text":"郊原野老带经锄，童稚何知竞挽须。\n我亦弥年躬井臼，儿能终日课樵苏。\n颇思鸥阁仍虬户，那似松醪伴酪奴。\n志大才疏苦多累，真须鹿鹿效周谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何思举韵寄元亮兼简性之","author":"李彭","text":"避冷幽窗歌扊扅，鸦啼疏柳把南枝。\n长须勿送平安报，满眼仍看竞病诗。\n稚子每嗟檐隙短，波臣常梗客行迟。\n应贪左辖蓝田会，落雪官梅动兴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和许秀才见赠许病目良苦","author":"李彭","text":"木末鸦啼负郭村，无人白昼掩柴门。\n诗来或作破客梦，语妙直堪排帝阍。\n抱瘵端如叔夜懒，幽怀思对阮生论。\n何时还子读书眼，解脱无根须返元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和冯仲宣韵","author":"李彭","text":"秋风寂寞仲宣楼，金狄伤嗟卧一丘。\n喜有斯人出淮海，追还旧观极风流。\n莫将起草明光手，去伴诸郎肉食谋。\n我欲清江理烟艇，寻君楚尾及吴头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬谢幼槃","author":"李彭","text":"窗间远岫谢玄晖，人物煌煌三秀芝。\n黄耳来时得佳句，碧云合处起幽思。\n深闺复见解围手，胜日应多赠妇辞。\n念我庞婆最痴绝，只能举案解支颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉酬幼槃","author":"李彭","text":"结庐不入遗民社，好客初无仲蔚蒿。\n度鸟冥冥与心远，孤峰峭峭伴名高。\n樽前著我醉千日，镜里缘君减二毛。\n安得买邻挥百万，拍浮左手更持螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵呈之忱彦先彦达兼呈幼槃","author":"李彭","text":"割据溪山天下豪，长松独许倚青蒿。\n小巫政自雄河朔，浅器从来鄙奉高。\n烂醉何劳愤田窦，淳风相与继崔毛。\n不知底事真奇语，且向窗前嚼二螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次驹甫涵虚阁韵","author":"李彭","text":"梦中占梦偶相逢，山上有山随转篷。\n我自持觞酹玄酒，君应临水洗蛮风。\n行参鹓鹭峨冠客，岂是江湖把钓翁。\n暇日频来裁锦句，要看玉手乱殷红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"紫霄道中","author":"李彭","text":"山行积石路逶迤，村径成门逐处移。\n一点炊烟生虎穴，四来暝色到牛衣。\n畏人沙鸟飞南陇，傍母山猿恋北枝。\n雁塔崔嵬临画峤，墨云霮䨴起方池。\n髯秦昔别留奇画，病可虽亡馀好诗。\n羊祜不如铜雀妓，蔡邕尚有虎贲儿。\n开颜欲效东篱醉，真隐惭无谷口姿。\n安得膏腴盈二顷，雍雍唤取共扶犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"唤渡亭","author":"李彭","text":"草风兼沙雨，依约渭河边。\n昔人宁唤渡，绝唱颇清绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书山水枕屏四段 其一","author":"李彭","text":"遥岑天南端，野彴垂杨下。\n萧散策寒藤，绿云复观化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书山水枕屏四段 其二","author":"李彭","text":"澄江真皎镜，短艇戏鸣榔。\n无复机心动，不惊鸥鸟行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书山水枕屏四段 其三","author":"李彭","text":"孤峰上排霄，群木尽生意。\n持竿坐石矶，高怀在云际。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书山水枕屏四段 其四","author":"李彭","text":"复阁耿苍烟，斜晖挂木末。\n卷帆何处船，危樯待明发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪投宿圜通以野雪盖精庐为韵赋五诗并书涂中所见 其一","author":"李彭","text":"寒雪尽垂空，玉色粲万瓦。\n默默行五牙，郁霭望黄野。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪投宿圜通以野雪盖精庐为韵赋五诗并书涂中所见 其二","author":"李彭","text":"昔我游山阴，杂花纷似雪。\n重来雪作团，远树皓已结。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪投宿圜通以野雪盖精庐为韵赋五诗并书涂中所见 其三","author":"李彭","text":"山翁雪垂素，相逢乃倾盖。\n同看艳雪舞，尽此威迟态。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪投宿圜通以野雪盖精庐为韵赋五诗并书涂中所见 其四","author":"李彭","text":"借问佩苍玉，何如煮黄精。\n古来涧谷槃，价自重连城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雪投宿圜通以野雪盖精庐为韵赋五诗并书涂中所见 其五","author":"李彭","text":"马疲如客饥，税鞅文公庐。\n人好雪亦好，何啻射洪乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"迎阳阁","author":"李彭","text":"扶桑有玉书，郁仪善相保。\n朝暾到颓檐，危坐填血脑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予夏中卧病起已见落叶因取渊明诗门庭多落叶慨然知已秋赋十章遣兴 其一","author":"李彭","text":"西岭障斜日，澄江来绕门。\n归鸦千万点，暝色入远村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予夏中卧病起已见落叶因取渊明诗门庭多落叶慨然知已秋赋十章遣兴 其二","author":"李彭","text":"燕坐修白业，焚香观黄庭。\n清霄降真侣，弭节或见聆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]