[{"title":"孤山","author":"贾似道","text":"半是楼台换却村，几回独立更销魂。\n断堤野水梅花宅，千古春风月一痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拖肚黄","author":"贾似道","text":"头项焦黄身黑粗，更兼腿大及臀拖。\n若还牙齿尖而厚，日斗数番也不多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松","author":"贾似道","text":"城中得此观，不用远寻幽。\n松影半坛月，竹色一帘秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"油纸灯 其二","author":"贾似道","text":"头混腿脚一身黄，翅滑牙红促织王。\n易名叫做油莉挞，赌花管取满头装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"油纸灯 其一","author":"贾似道","text":"头圆腿壮遍身黄，翅滑如油肉带苍。\n牙钳一对如红色，此物虫中是霸王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青麻头","author":"贾似道","text":"掺青皱翅紫麻头，肚白身肥牙似钩。\n毛项花牙长腿脚，斗鸡生相斗三秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"促织论赋","author":"贾似道","text":"促织斗时人要主，贪财饶大虫辛苦。\n总然赢得已著伤，当场必误下锋主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养法十二条 其一","author":"贾似道","text":"盆须用古不须新，盆热天炎色要昏。\n养过重阳九月九，旧盆不用换新盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养法十二条 其三","author":"贾似道","text":"下食须当过日中，若还不准是场空。\n水清无要如冰冷，须要安些蜀地铜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养法十二条 其二","author":"贾似道","text":"养到天寒霜降时，附子煎汤冷浴伊。\n常把盆中围得密，此时方用水窝儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养胎","author":"贾似道","text":"虫腹怀胎号产魔，落胎全仗水虾婆。\n切须养办心休急，斗者之时败者多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸淳三年生日口号","author":"贾似道","text":"君恩犹使居湖曲，年未为高奈病何。\n做却潞公官职了，较来谢事不争多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总言 其二","author":"贾似道","text":"其中奥妙细谈推，依此之中必作魁。\n三分之中晓得一，常常得胜带花回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独脚","author":"贾似道","text":"独脚全凭绰菆功，助帮其拐可成功。\n切须休要饶他大，两腿俱全力不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草三段 其二","author":"贾似道","text":"满头白粉紫葡萄，并无纹理项青毛。\n更兼淡薄轻银翅，三段之名亦似高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草三段 其一","author":"贾似道","text":"麻头青项白毛丁，金翅绉绉肉带青。\n腿脚班黄牙似炭，当场健战众皆惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香师■铃","author":"贾似道","text":"香师红额共■铃，只好三番两次赢。\n卸却红铃难保久，总然赢得也无情。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浴雌","author":"贾似道","text":"喂食三尾时时铃，免使虫儿咬失伤。\n常将三尾频频浴，解使呼雌有彩光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真三段","author":"贾似道","text":"紫头青项有毛长，金翅生来肉带苍。\n两腿圆长班白色，红牙一对没人当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真青","author":"贾似道","text":"青色头如菩提子，项上毛青靛染成。\n牙铃更得芝麻白，任君尽斗足欢情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真黄","author":"贾似道","text":"天生金色遍身黄，肉腿如同金箔装。\n更生一付乌牙齿，敌尽诸虫不可当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真紫","author":"贾似道","text":"紫者如同著紫袍，头浓刚性项如毛。\n钳更细长如血色，独占场中第一豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绣花针","author":"贾似道","text":"小能敌大果然强，虫小赢多必是良。\n累胜上肩魁大者，这般虫小也非常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"配合 其一","author":"贾似道","text":"呼雌之法与君知，不贴之时便换雌。\n一个不贴又一个，若还呼久太非宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"配合 其二","author":"贾似道","text":"蛩声不发莫添双，呼叫连绵情性狂。\n三尾黑头须是小，剪须去爪正相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"啖色头","author":"贾似道","text":"黑头红项背身跎，更兼大腿及捶拖。\n牙齿赤红如钳样，连赢数阵不为多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其一","author":"贾似道","text":"朔风吹雨正尘埃，忽见江梅驿使来。\n忆著家山石桥畔，一枝冷落为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其二","author":"贾似道","text":"山北山南雪半消，村村店店酒旗招。\n春风过处人行少，一树疏花傍小桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其三","author":"贾似道","text":"尘外冰姿世外心，宜晴宜雨更宜阴。\n收回疏影月初坠，约住寒香雪正深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花翅 其二","author":"贾似道","text":"翅似梅花蜘蛛形，身上如同梅花片。\n如此之虫亦怪哉，满场斗胜真堪羡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花翅 其一","author":"贾似道","text":"翅似梅花口似刀，番来覆去咬千交。\n总然赢得他每者，只好看盆无二遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深紫","author":"贾似道","text":"紫者当头要紫浓，更兼翅胁与身同。\n头红项阔阴阳翅，赢尽场中有大功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琵琶翅 其二","author":"贾似道","text":"琵琶项上带销金，又看须长六足明。\n若是黑青全没用，腿长肉厚满场赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫麻","author":"贾似道","text":"头麻项路透金丝，项毛翅绉腿班狸。\n四脚兼黄肉带赤，秋虫见影不相持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫麻头","author":"贾似道","text":"麻头项上透金丝，项毛翅绉腿班狸。\n脚亦微黄肉带赤，秋虫见了怎支持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁忌","author":"贾似道","text":"硫黄橘气最难当，煎药须教莫近傍。\n顿处常教遮得暗，切须休露太阳光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与友人会宿城中","author":"贾似道","text":"江湖相隔久，不料宿京城。\n终夜同谈笑，对床如弟兄。\n湿萤飞复落，残烛灭还明。\n此去仍多事，重期未必成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台石桥","author":"贾似道","text":"古路行终日，僧房出翠微。\n瀑为煎茗水，云是坐禅衣。\n尊者难相遇，游人又独归。\n一猿桥外急，却是不忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天竺通元庵分韵得閒字","author":"贾似道","text":"十里高松树，松边屋数间。\n客同终夜话，心是一般閒。\n灯色难禁雨，秋声不离山。\n明朝分手后，俗事不相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归葛岭旧居","author":"贾似道","text":"罢官归旧宅，山水得频过。\n息影堤边树，清心湖面波。\n劳无功可纪，顽有命相磨。\n见说连朝雨，田家正剪禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用三尾贴法歌","author":"贾似道","text":"蛩吟三尾莫添双，呼叫连绵怕性狂。\n三尾黑头须用小，尖头独脚始相当。\n喂交三尾时常饱，免致虫吟误损伤。\n更将三尾频频浴，解使雌雄有彩光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药 其三","author":"贾似道","text":"上了甘泉三捷书，长淮万里一尘无。\n清和时节如春在，红药精神与昔殊。\n丛玉生香歌可谱，围金有客瑞重图。\n公堂且尽今朝醉，已问君王乞鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药 其二","author":"贾似道","text":"温温玉立绿阴中，不犯芳菲逐万红。\n折尽长淮多暇日，簪联四座足春风。\n应如庆历梅花瑞，况有昌黎属句工。\n问得君王乞身去，移根栽傍曲栏东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药 其一","author":"贾似道","text":"又是扬州芍药时，花应笑我赋归迟。\n满堂留得春如画，对酒何妨鬓似丝。\n玉立黄尘那可到，锦围红蜡最相宜。\n买山若就当移种，此际谁能杖履随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论翅 其一","author":"贾似道","text":"紫翅青金翅，木翅与油单。\n黑色全如墨，梅花两瓣攒。\n松阔偕长短，蓑衣得更难。\n遮身不见节，薄绉另相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜鹃","author":"贾似道","text":"一年一番听，无事亦低眉。\n催得人归去，由来自不知。\n春山穿翠霭，月树滴燕脂。\n遗恨因亡国，流传似可疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸淳庚午冬大雪遗安抚潜侍郎 其三","author":"贾似道","text":"穷年枯坐似禅林，为喜祥霙写我心。\n归去来兮怀靖节，不能者止愧周任。\n西园佳话从知旧，东国诸贤复见今。\n满斛明珠逾美瑞，定应摹刻遍碑荫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸淳庚午冬大雪遗安抚潜侍郎 其一","author":"贾似道","text":"腊前又放玉园林，一片花飞一片心。\n瀌奕端由人所召，燮调多愧病难任。\n乾坤浩浩无偏处，田野穰穰更自今。\n但得诸贤成此乐，擢舟我欲去山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总言 其三","author":"贾似道","text":"虫性分悲喜，世人难得知。\n嚼牙能斗口，鼓翅得赢时。\n须识蝇头牵，傍危则自知。\n总然虫禁齿，如病遇良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草","author":"贾似道","text":"草木起寒色，望来秋更清。\n舟横遥夜月，风度隔城更。\n避俗心虽在，休官疏未行。\n空惭旧吟侣，有句续唐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琼花","author":"贾似道","text":"寂寂蕃釐观里花，伊谁封殖得名嘉。\n应知天下无他本，惟有扬州是尔家。\n种雪春温团影密，攒冰香重压枝斜。\n倚阑莫问荣枯事，付与东风管物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题促织 其二","author":"贾似道","text":"玉罐金笼喂养频，王孙珍爱日相亲。\n争雄肯负东君意，决胜宁辞一芥身。\n鼓翼有声如唱凯，洗□□□□生嗔。\n大哉天地生群物，羡尔区区志不伦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题促织 其一","author":"贾似道","text":"玉绳低转过南楼，人在冰壶夜色幽。\n湛湛露华凉似洗，啾啾蛩韵巧如讴。\n絮叨高下恣情诉，断续悠扬不肯休。\n叫彻五更寻隐处，自封门户共雌俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠孤山周道士","author":"贾似道","text":"梅花和靖宅，此处住来清。\n肯以诗为事，终于世有名。\n山空丹鹤老，湖净白鸥明。\n时亦扶筇出，何曾踏帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌麻","author":"贾似道","text":"乌麻头路透银丝，项阔毛班肉带黑。\n更若翅乌牙钳赤，得遇此虫真有益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月头线额","author":"贾似道","text":"线额空纹彩更良，月头堪惜不久长。\n应是腿寒终不耐，柰何脚小便寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白牙青","author":"贾似道","text":"紫头银线项青毛，银牙白脚绝伦高。\n可柰秋风消索处，自然勇力不相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白麻头","author":"贾似道","text":"黄色辉光耀似金，枣红牙齿利如针。\n更有葡萄毛肉体，日交三度也还赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红头紫","author":"贾似道","text":"红头紫翅最刚强，项若朱砂腿浑长。\n牙齿湾尖桑剪样，秋冬历遍莫能当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论土狗形","author":"贾似道","text":"头粗项阔肚低拖，翼翅生来半背铺。\n脚腿壮肥身巨■，当头起线叫如锣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论肉 其二","author":"贾似道","text":"肉色欠纯正，腰上多红铃。\n月头红白间，百战不能赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论形","author":"贾似道","text":"钳象蜈蚣钳，嘴象狮子嘴。\n头象蜻蜓头，腿象蚱蜢腿。\n颜色要相当，毛燥斯为美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论灶鸡形","author":"贾似道","text":"头尖项细肚皮拖，白翅生来满背铺。\n腿脚不长身懒拥，当头金线叫喽啰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论龟鹤形","author":"贾似道","text":"头如蚕嘴肚如琴，两翅啾啾叫不鸣。\n识者若逢此促织，这般号作大将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论真黄色","author":"贾似道","text":"翅金肉白顶红麻，项糁毛青腿少瑕。\n更有一双牙似墨，这般相貌最为佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论虾青色","author":"贾似道","text":"有等名为虾壳青，比似青来翅不金。\n不问牙钳白不白，须看项上带毛丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论虾青形","author":"贾似道","text":"龟背虾青不宜红，腿脚俱长斗不慵。\n色黑貌凡非物类，金丝透顶绝伦虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论虾脊龟形","author":"贾似道","text":"龟形虾脊不宜红，腿脚俱长力不庸。\n色黑体肥毛白项，金丝金线绝伦虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论项 其三","author":"贾似道","text":"青项堆青钿，白毛根闪青。\n朱砂火盆底，桃皮等类形。\n白腐冬瓜大，宽臊垒起星。\n毛丁有胳?，入手不当轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论项 其一","author":"贾似道","text":"项似蜻蜓样，毛丁又起班。\n更兼形色正，打遍世无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论真白色","author":"贾似道","text":"白头白项翅如银，上手观来一似冰。\n枣红牙齿如针利，总无骨肉似将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论真黑色","author":"贾似道","text":"黑者须当头似漆，仔细看来无别色。\n于中牙肚白如银，到作将军为第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论淡黄色","author":"贾似道","text":"肉白红头项掺青，头粗脚壮齿如针。\n这般虫子非容易，九遍交锋十次赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论深青色","author":"贾似道","text":"颜色深沉似污泥，紫头青项尽相宜。\n齿长腹肚兼华白，斗到秋深花带归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论脸 其二","author":"贾似道","text":"酒醉猫儿脸，花花白路纹。\n此般生像者，弃物不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论紫青色","author":"贾似道","text":"紫头青项背如龟，青不青兮紫不绯。\n仔细看来茄子色，更兼腿大最为奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论腿 其一","author":"贾似道","text":"大腿圆长健，小脚粗铁线。\n班白黄色真，此名金不换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]