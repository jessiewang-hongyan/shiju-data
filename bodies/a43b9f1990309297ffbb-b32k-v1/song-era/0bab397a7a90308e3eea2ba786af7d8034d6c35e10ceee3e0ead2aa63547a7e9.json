[{"title":"东村散步有怀张汉州","author":"陆游","text":"扶杖村东路，秋来始此回。\n寒鸦盘阵起，野菊卧枝开。\n忧国丹心折，怀人雪鬓催。\n房湖八千里，那得尺书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩","author":"陆游","text":"僻巷地无喧，闲人虑不烦。\n刺舟回北渚，岸帻倚东轩。\n乳鹊行苔径，驯獐触笋藩。\n作劳怜野老，唤取倒清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩","author":"陆游","text":"终日在东厢，闲消百刻香。\n一枰分黑白，双砚列朱黄。\n荷气侵帘馥，桐阴覆井凉。\n前知今夕梦，孤榜上潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东邻筑舍与儿辈访之为小留","author":"陆游","text":"甲第潭潭莫羡渠，穷人从昔爱吾庐。\n茆茨新洁嗟何欠，邻里追随故不疏。\n瓮酱芬香盘早兔，臼齑珍酽脍寒鱼。\n年丰日有携尊兴，家乘从今不一书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东岭","author":"陆游","text":"云罅漏斜日，驾言东岭行。\n鸦翻半天黑，鹭起一川明。\n小立照沟水，欲归闻角声。\n君看浮世事，何处异棋枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东斋","author":"陆游","text":"著脚红尘已恨深，便应毕世住山林。\n贵人自作宣明面，老子曾闻正始音。\n议论坐狂当永弃，簿书缘病复难任。\n东斋幽寂凭谁画，开幔床横一素琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东斋夜兴","author":"陆游","text":"山城残角伴疏钟，拥褐颓然一病翁。\n纸帐灯明蹙龟甲，铜瓶火熟起松风。\n雨来尤觉睡味美，酒后不知愁思空。\n忽忆江湖泊船夜，号鸣避弋闹群鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东偏小室去日最远每为逃暑之地戏作五字","author":"陆游","text":"肃肃檐阴转，泠泠笕水鸣。\n高墉日气远，方簟午风清。\n渴爱餐浆美，慵便葛屦轻。\n新秋忽在眼，结束问山程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东堂晨起有感","author":"陆游","text":"不解飞车越九州，青鞋处处为山留。\n百年未尽且作梦，三日闲行聊散愁。\n世上几经华表柱，尊前好在黑貂裘。\n龙泉幸是无人斸，暮露光芒上斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖新竹","author":"陆游","text":"插棘编篱谨护持，养成寒碧映沦漪。\n清风掠地秋先到，赤日行天午不知。\n解箨时闻声簌簌，放梢初见叶离离。\n官闲我欲频来此，枕簟仍教到处随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗","author":"陆游","text":"腊近寒何薄，秋衣著尚宜。\n年光祈雪见，节物卖灯知。\n川日初沉后，楼钟欲动时。\n东窗对儿子，聊与细论诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗小酌二首 其二","author":"陆游","text":"市尘远不到林塘，嫩暑轩窗昼漏长。\n蚕妾趁时争盐茧，农夫得雨正移秧。\n徒行有客惊顽健，烂醉无人笑老狂。\n却掩庵门径投枕，鼾声雷起撼藜床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗小酌二首 其一","author":"陆游","text":"乌帽翩仙白苧凉，东窗随事具杯觞。\n流年不贷世人老，造物能容吾辈狂。\n藤叶成阴山鸟下，桧花满地蜜蜂忙。\n何人画得农家乐，咿轧缫车隔短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗独坐书怀","author":"陆游","text":"秋豪外物不关心，竹坞梅村惜未深。\n蓬户夜凉灯煜爚，盆山雨润木萧森。\n洁斋入静三熏沐，宴坐降魔七纵擒。\n但恨图书阙调护，不胜鼠啮与虫侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗偶书二首 其一","author":"陆游","text":"东窗终日静愔愔，消尽平生幻妄心。\n秋气未催群木脱，老怀先感百虫吟。\n屏风叠邃思庐阜，冠子峰高忆少林。\n安得吾身且强健，一藤随处更幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗偶书二首 其二","author":"陆游","text":"万事何曾有速淹，熊蹯鱼腹自难兼。\n山川置掌犹能取，日月无胶可得黏。\n稚子幸堪持几杖，老生元自惯齑盐。\n清晨临镜还三叹，雪颔今年无处添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗遣兴三首 其二","author":"陆游","text":"巾屦长闲客，帘栊薄暑天。\n巢空重乳燕，叶密未鸣蝉。\n壶箭看多算，图书理断编。\n悠然已日夕，却上采菱船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗遣兴三首 其一","author":"陆游","text":"巷陌过从少，园林景物新。\n群鱼时戏藻，驯雉每依人。\n映户槐阴密，堆盘麦饵珍。\n残春又陈迹，抚事一伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东窗遣兴","author":"陆游","text":"东窗徙倚当闲游，水长池鱼自满沟。\n花气袭人浑欲醉，鸟声唤客又成愁。\n百年光景输攲枕，万里风烟入倚楼。\n欲写乌丝还懒去，诗名老去判悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱三首 其三","author":"陆游","text":"东偏隙地作疏篱，遇兴无非一笑时。\n陪客投壶新罚酒，与儿斗草又输诗。\n山桃溪杏栽俱活，药镵渔竿动自随。\n家事犹令罢关白，固应黜陟不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱三首 其一","author":"陆游","text":"东篱深僻懒衣裳，书卷纵横杂药囊。\n无吏徵租终日睡，得钱沽酒一春狂。\n新营茅舍轩窗静，旋煮山蔬匕箸香。\n戏集句图书素壁，本来无事却成忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱三首 其二","author":"陆游","text":"漫道深居昼掩关，东篱栽接不曾闲。\n每因清梦游敷水，自觉前身隐华山。\n花发时时携绿酒，客来往往羡朱颜。\n药炉安著犹无地，拟展茅茨一两间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂书四首 其二","author":"陆游","text":"桃李成尘土，来禽始著花。\n病夫犹枕上，春事又天涯。\n巷陌鞦韆梦，帘栊燕子家。\n野僧来问讯，强把半瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂书四首 其一","author":"陆游","text":"芳草初侵路，青梅已破枝。\n雨来鸠逐妇，日出雉求雌。\n莽莽江湖远，悠悠岁月移。\n老人观物化，隐几独多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂书四首 其三","author":"陆游","text":"老厌人间事，闲知造物功。\n草生三径绿，花发一窗红。\n幽境嚣尘外，流年啸傲中。\n所嗟侪辈尽，论旧只春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂书四首 其四","author":"陆游","text":"身与春俱老，愁随日渐长。\n帘栊听语燕，涧谷撷幽芳。\n酒榼常从后，诗囊亦在傍。\n闲行无定处，随意据胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂题五首 其四","author":"陆游","text":"南陌归虽久，东篱兴又新。\n无求觉身贵，好俭失家贫。\n引水常终日，栽花又过春。\n桃源不须觅，已是葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂题五首 其一","author":"陆游","text":"终日在东篱，清和适此时。\n莺声如妒梦，花气欲撩诗。\n爱客茶新碾，留僧饭别炊。\n流年随手过，不觉近期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂题五首 其三","author":"陆游","text":"昨日一花坼，今朝一草生。\n深林鸠妇聒，高栋燕巢成。\n熟果檐间堕，残书枕畔横。\n庵居澹无事，作意领新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂题五首 其二","author":"陆游","text":"深居远悔吝，简事养精神。\n曳杖一萧散，待茶时欠伸。\n风生丛竹啸，露坼野花新。\n自作东篱后，经旬不过邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东篱杂题五首 其五","author":"陆游","text":"沟声流激激，篱影立疏疏。\n平旦来浇药，临昏尚看鱼。\n比邻怪疏索，风月伴踌躇。\n安得王摩诘，凭渠画草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍自京尘中得归故山作五字识喜","author":"陆游","text":"门巷如秋爽，轩窗抵海宽。\n初还绶若若，已觉面团团。\n引睡拈书卷，偷闲把钓竿。\n人生快意事，五月出长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍凉","author":"陆游","text":"凉风苏病骨，摇落起诗情。\n一病辄数日，几诗终此生。\n招呼丹灶客，结束玉霄行。\n预想溪桥路，三更待月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍晴出游","author":"陆游","text":"八十山翁病不支，出门也赋喜晴诗。\n小楼酒旆阑街处，深巷人家晒练时。\n本借微风攲帽影，却乘新暖弄鞭丝。\n归来幸有流香在，剩伴儿童一笑嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍晴至园中","author":"陆游","text":"药笈渔竿每自随，枯筇短帽恰相宜。\n投林但有穷猿喜，伏枥元无老骥悲。\n岩溜甘寒通碧沼，野梅清绝隔疏篱。\n放翁老甚情怀懒，那办题诗寄所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍晴行西村","author":"陆游","text":"堤树丛祠北，烟村古埭南。\n买鱼论木盎，挑荠满荆篮。\n积潦经旬月，晴光见二三。\n农功殊可念，保麦复祈蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰亭","author":"陆游","text":"兰亭绝胜擅吾州，病起身闲得纵游。\n曲水流觞千古胜，小山丛桂一年秋。\n酒酣起舞风前袖，兴尽回桡月下舟。\n江左诸贤嗟未远，感今怀昔使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夕二首 其二","author":"陆游","text":"不寐起中夕，披衣增慨慷。\n千金空市骨，三沐竟刳肠。\n世事粗能识，吾生安用长。\n布裘茆屋底，死去亦芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夕二首 其一","author":"陆游","text":"犬吠惊飘叶，禽喧换宿枝。\n堕空霜肃肃，垂地斗离离。\n野叟读书罢，高城吹角悲。\n功名浑错料，老病却如期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夕闲咏","author":"陆游","text":"柳眼梅须漏泄春，江南又见物华新。\n终年幽兴遗身世，半夜孤吟怆鬼神。\n客有疏亲俱握手，酒无贤圣总濡唇。\n放翁自命君无笑，家世从来是散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日","author":"陆游","text":"室中恰受一蒲团，也抵三千世界宽。\n上策莫如扃户坐，苦闲犹复取书看。\n蔬青饭软枝梧老，窗白炉新准备寒。\n堪笑此翁幽独惯，却嫌儿女话团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日","author":"陆游","text":"短景匆匆过，新寒亹亹来。\n客游聊戏耳，世事亦悠哉。\n绿动连村麦，香吹到处梅。\n锦城花柳窟，归去看春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日二首 其一","author":"陆游","text":"故里躬耕后，颓龄耄及前。\n开门无客至，得句有僧传。\n忽忽身如梦，迢迢日似年。\n会当乘小雪，夜上剡溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日二首 其二","author":"陆游","text":"客至惟清坐，真贫不是悭。\n援琴排遣闷，合药破除闲。\n引鹤时穿屐，逢梅一破颜。\n怪来寒彻骨，夜雪冒南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日观渔猎者","author":"陆游","text":"人閒渔猎各相从，南陌东阡处处逢。\n绣羽触机馀耿介，锦鳞出网尚噞喁。\n傍观扶杖常移日，就买还家足御冬。\n更待风霜都过尽，却从春野看春农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日园中作","author":"陆游","text":"园荒阙扫除，篱败且枝梧。\n久旱池萍死，新霜野蔓枯。\n寒炉殊未议，浊酒却时酤。\n飞动郊原兴，饥鹰待指呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日排闷二首 其一","author":"陆游","text":"老欲躬耕力弗强，但应卖药似韩康。\n陈编时见古成败，旧友不知今在亡。\n已返山林遗世事，尚凭诗酒答年光。\n此身自笑如稊米，加损宁能系太仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日排闷二首 其二","author":"陆游","text":"地炉微火伴寒灰，垂野江云暝不开。\n欲睡手中书自堕，半酣窗外雪初来。\n渡头照影闻征雁，篱角吹香得早梅。\n佛粥春盘俱不远，离离斗柄欲东回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至","author":"陆游","text":"老遇阳生海上村，川云漠漠雨昏昏。\n邻家祭彻初分胙，贺客泥深不到门。\n万卷纵横忘岁月，百年行止付乾坤。\n明朝晴霁犹堪出，南陌东阡共一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至","author":"陆游","text":"岁月难禁节物催，天涯回首意悲哀。\n十年人向三巴老，一夜阳从九地来。\n上马出门愁敛版，还家留客强传杯。\n探春漫道江梅早，盘里酥花也斗开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至后一日书","author":"陆游","text":"霜霰新冬后，年龄大耋时。\n功名久无梦，文字略存诗。\n丘垄归何憾，琴书付有儿。\n痴人痴到底，更欲数期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬初至法云","author":"陆游","text":"晓日曈昽露未乾，东中十月始微寒。\n牛闲处处农功毕，米贱家家酒盏宽。\n烟浦白鸥迎鼓枻，渔村红树入凭阑。\n归舟莫恨无人语，手把陶诗侧卧看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬初薄霜病躯益健欣然有赋","author":"陆游","text":"古服追随野老欢，竖裁布褐缩缝冠。\n霜清顿洗肺肝热，木落更知山泽宽。\n斗酒敢言嫌鲁薄，杯羹聊得学吴酸。\n一贫自是书生分，忍愧看人却似难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜","author":"陆游","text":"穷巷萧条早闭门，北窗灯火夜昏昏。\n老于俗事不挂眼，愁忆故人空断魂。\n急雪打窗飞砾细，狂风卷野怒涛翻。\n土床纸帐寒无寐，彊把村醅不厌浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜","author":"陆游","text":"悠悠孤梦伴馀酲，窗下寒灯黮闇明。\n雪意欲成风正恶，渔舟忽过雁群鸣。\n志衰但有徂年感，身没应无后世名。\n犹幸耄期身粗健，天公元不负书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜二首 其一","author":"陆游","text":"岁晚风霜恶，将如遥夜何。\n残灯挑更暗，寒犬吠偏多。\n支枕成孤咏，怀人起浩歌。\n梅花不解饮，谁伴醉颜酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜二首 其二","author":"陆游","text":"忽忽流年恨，悠悠独夜情。\n向人灯欲语，绕舍露如倾。\n梦每轻千里，愁偏怯五更。\n殷勤桑落酒，好为解馀酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜","author":"陆游","text":"飕飕黄叶欲辞枝，况著霜风抵死吹。\n投老难逢身健日，读书偏爱夜长时。\n孤村月白闻衣杵，破灶烟青煮芋糜。\n不是用心希陋巷，为儒自合耐寒饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜","author":"陆游","text":"杞菊家风有自来，充饥藜糁不盈杯。\n云迷野渡一声雁，雪暗山村千树梅。\n宴坐何妨面庵壁，长吟且复画炉灰。\n岁残尚恨新春远，欲挽天边斗柄回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜","author":"陆游","text":"北斗挂屋角，西风惊雁群。\n山寒岁云暮，人静夜中分。\n酒滴糟床雨，香生纸帐云。\n眼花书课减，旧学失锄耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜","author":"陆游","text":"多病睡眠少，长闲怀抱清。\n昏灯照残梦，寒漏下高城。\n落月澹将没，栖禽静复惊。\n谁言冬夜永，辗转已窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜不寐","author":"陆游","text":"老眼睡眠少，空村霜露凄。\n铮铮闻叩铁，喔喔数鸣鸡。\n月入知窗破，衾单幸屋低。\n明晨炊米尽，吾起不容稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜不寐至四鼓起作此诗","author":"陆游","text":"秦吴万里车辙遍，重到故乡如隔生。\n岁晚酒边身老大，夜阑枕畔书纵横。\n残灯无焰穴鼠出，槁叶有声村犬行。\n八十将军能灭虏，白头吾欲事功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜月下作","author":"陆游","text":"造物宁能困此翁，浩歌庭下答松风。\n煌煌斗柄插天北，焰焰月轮生海东。\n皂纛黄旗都护府，峨冠长剑大明宫。\n功名晚遂从来事，白首江湖未叹穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜对书卷有感","author":"陆游","text":"人生如梦终当觉，世事非天孰可凭。\n万卷虽多当具眼，一言惟恕可铭膺。\n所闻要足敌忧患，吾道岂其无废兴。\n白发萧萧年八十，依然父子短檠灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜戏书三首 其二","author":"陆游","text":"将挂衣冠彊小留，期年毕竟是归休。\n青毡独拥欺霜夜，浊酒频倾洗客愁。\n鹤影冷翻丹井月，雁声遥带玉关秋。\n一生自笑闲中过，不为功名也白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜戏书三首 其三","author":"陆游","text":"老树霜馀已尽红，纵横落叶满庭中。\n一钩澹澹西南月，万鼓凭凭东北风。\n赊酒每惭添旧券，读书何计策新功。\n蓬窗坐睡摧颓甚，隔竹敲茶赖小童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]