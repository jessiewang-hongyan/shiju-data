[{"title":"七言","author":"张耒","text":"飞鸿归尽燕将还，亭院深沉人倚栏。\n斜搭鞦韆寒食雨，已黄杨柳暮春寒。\n密毬杏萼红如糁，半落梅花香未残。\n人世年年非旧事，感时惟有泪汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日独游怀故人","author":"张耒","text":"故人分散在天涯，九日登临独叹嗟。\n人世光阴催日日，乡闾时节自家家。\n风烟满眼临秋尽，鼓角荒城送日斜。\n取醉凭谁正乌帽，遣愁犹强插黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月十八日梦中作闻雁诗","author":"张耒","text":"何日离燕碛，来投江上洲。\n高鸣云际夜，冷度雨中秋。\n缯缴远须避，稻粱寒未收。\n春风归翼便，容易一冬留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十二日立秋夜行泊林皇港二首 其二","author":"张耒","text":"吴楚封疆接，东南泽国宽。\n江流秋日尽，山对暮云闲。\n囊有离骚赋，头馀骑省斑。\n前秋聊把酒，一笑且开筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十二日立秋夜行泊林皇港二首 其一","author":"张耒","text":"萧萧晚风起，孤舟愁思生。\n篷窗一萤过，苇岸数蛩鸣。\n老大畏为客，风波难计程。\n家人夜深语，应念客犹征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十七日欲招客饮而风霾不果有作","author":"张耒","text":"欲携佳客燕高堂，园馆春风又作狂。\n犹挟冰霜馀意气，未分桃李好风光。\n青山无赖藏云岫，流水生波滟野塘。\n不饮何妨还燕坐，闭门扫地独焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月三日舣舟徐城戏呈戚郎","author":"张耒","text":"自嗟为客久，羁旅过淮时。\n雪野挑蔬瘦，霜天暖酒迟。\n流年下坡毂，万事一枰棋。\n异日怀陈迹，孤舟近古祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人家","author":"张耒","text":"人家依古木，鸡犬乱山深。\n积雪暗犹壮，寒云晚易阴。\n断荷攲冻水，孤月战风林。\n稍稍栖乌定，饥啼何处禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十一日晨兴三首 其一","author":"张耒","text":"老人秋少睡，禅诵每晨兴。\n邻碓舂残月，床蛩语暗灯。\n高林鸟声起，幽草露华凝。\n筇杖兼禅榻，生涯一野僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十一日晨兴三首 其三","author":"张耒","text":"江上秋阴合，柯山晓雨来。\n貂裘欲辞箧，纨扇已生埃。\n落叶湿相藉，晚花寒未开。\n殷勤探黄菊，九日泛清杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十一日晨兴三首 其二","author":"张耒","text":"端居岁已宴，杖履亦萧然。\n云露窗前日，秋明树外天。\n大江寒欲落，诸岭霁逾鲜。\n白首无聊剧，昏昏只醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月七日五首 其四","author":"张耒","text":"三杯无奈醉，一褐有馀温。\n眼下幸无事，世间何足论。\n山僧元饱饭，词客谩招魂。\n杖策知何诣，门前老圃村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月七日五首 其一","author":"张耒","text":"寒更催欲尽，曙色转鸡吭。\n鸣雁背晓斗，清笳吟宿霜。\n空山岁华晚，故园归梦长。\n晨起临清镜，悲嗟发已苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十六日旦闻东堂啄木声忽记作福昌尉时在山间环舍多老木腊后春初此鸟尤多声态不一今琵琶筝中所效既不类又百不得一二云","author":"张耒","text":"睡馀闻啄木，忽忆福昌春。\n官舍题诗壁，如今经几人。\n犹能老耽酒，依旧拙谋身。\n尚想兰宫路，东风清洛滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月十七日移病家居成五长句 其四","author":"张耒","text":"从今羞复走功名，卤莽因循已半生。\n心遣我愚应有谓，眼看人智亦何成。\n梦为蝴蝶因观化，目送飞鸿漫寄情。\n堪笑妻儿怀土甚，谪期未满已谋行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月十七日移病家居成五长句 其五","author":"张耒","text":"纸窗低下火炉边，有底宜人意若便。\n移疾何妨闲五日，放慵犹欲醉终年。\n平生亲友怀天末，谈笑妻儿在目前。\n谁似匡庐白居士，暮年华发洛阳仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月十七日移病家居成五长句 其三","author":"张耒","text":"凭高游目快遐瞻，落日孤云与水兼。\n万顷泽空供雪意，一枝梅笑破冬严。\n擎苍未减飞扬兴，引满何辞斗石添。\n杨柳催春兼警客，荒沟照影弄纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月十七日移病家居成五长句 其二","author":"张耒","text":"老去尘怀痛洗煎，虚舟不系任回沿。\n寸心若变有如日，万事不忧终在天。\n莫为饥寒弃南亩，须知穮蓘有丰年。\n桃符侲子喧闾巷，又向江城十岁捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十日夜大雨雹震电先是数日极暖至是方稍晴","author":"张耒","text":"江乡节候异中州，十月狂雷震未休。\n二年到耳同常事，一夜雨声如蚤秋。\n想见麦畦添宿润，更欣蔬甲长新柔。\n东堂晚望无氛祲，洗出樊山紫翠浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万松亭有感","author":"张耒","text":"荦确山行穿翠微，石云秋露湿秋衣。\n朦胧小睡还成梦，讽咏新诗且疗饥。\n千里归来人事改，四年辛苦旧容非。\n祇应亭下青云盖，依旧苍腰耸十围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三乡怀古","author":"张耒","text":"清洛东流去不还，汉唐遗事有无间。\n庙荒古木连空谷，宫废春芜入乱山。\n南陌絮飞人寂寂，空城花落鸟关关。\n登临几度游人老，又对东风鬓欲斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月一日马令送花","author":"张耒","text":"未说浔阳别泪痕，江边蘋芷不胜繁。\n不知来岁在何处，又对新花忆故园。\n插帽每惭辉白发，飞香曾伴照清尊。\n去年今日淮阳道，落絮残红正断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月十二日作诗董氏欲为筑堂","author":"张耒","text":"黄鸟声中花已尽，绿杨风外日何长。\n柯家山下有幽筑，云梦泽南飞故乡。\n老病裌衣犹怯冷，春深煮酒渐闻香。\n本无智术争荣辱，只斗尊前身健强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元日驾回登楼二首 其二","author":"张耒","text":"长街十二远相通，阊阖峨峨彩雾红。\n天白华灯交皓月，楼寒朱幕荡春风。\n车头笑语归时醉，城下传呼夜向中。\n自古长安多乐事，周南留滞意何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元日驾回登楼二首 其一","author":"张耒","text":"紫雾氛霏阊阖开，团团明月上天来。\n香车百两天街晚，清跸一声仙仗回。\n灯隔画帘时闪烁，风穿高幕故徘徊。\n太平日久多閒暇，簪笏从容侍燕杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元后步西园","author":"张耒","text":"物态欣欣换旧年，收灯城市却萧然。\n风光欲到冰霜树，日月初回雨露天。\n近水远山情脉脉，碧云芳草思绵绵。\n酬春欲办千缸酒，洒扫花前作醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元思京辇旧游三首 其三","author":"张耒","text":"随计当年寄玉京，一时交结尽豪英。\n倒觥凌乱迷筹饮，醉帽敧斜并辔行。\n仕路飞腾输俊杰，山城憔悴感功名。\n佳晨强酌清樽酒，寒竹萧萧月正明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元思京辇旧游三首 其二","author":"张耒","text":"九门灯火夜交光，罗绮风来扑面香。\n信马恣穿深柳巷，随身偷看隔帘妆。\n身居薄宦安知乐，心逐流年暗减狂。\n留滞山城莫嗟叹，貂蝉从古属金张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元思京辇旧游三首 其一","author":"张耒","text":"万雉春城逼绛霄，上元雕辇盛游遨。\n迟迟瑞日低彤伞，焯焯荣光上赭袍。\n云捲朱帘开綵雉，山盘玉阙枕仙鳌。\n长安一别将华发，溪竹山城夜寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下春风岭","author":"张耒","text":"东归已过春风岭，度尽千山路渐平。\n人事水泡能几日，流光驹隙却堪惊。\n居人落落多新屋，行店依依认旧程。\n世事饱谙身已老，区区来往笑浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与李文举登梦野亭","author":"张耒","text":"樽俎相逢散百忧，虽非吾土共登楼。\n天边云送荆王雨，江上枫彫宋玉秋。\n华发不堪怀故国，清杯相与散牢愁。\n清谈七泽谁强健，莫学骚人赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久阴忽晴作诗寄秬秸时二子沿干在阳翟镇","author":"张耒","text":"想尔扁舟野岸横，久阴今旦喜晴明。\n天寒野旷北风利，云霁江浑春水生。\n家近冻醪时可致，旅庖鸣雁足供烹。\n东园早作归来计，红紫纷纷日向荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之天长会宿僧院","author":"张耒","text":"萧条林下寺，客至解尘鞍。\n雨过月逾白，夜深秋向寒。\n老僧无俗累，爱客故盘桓。\n之子静相对，松风清石栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪中李提举惠玻璃泉两榼二首 其二","author":"张耒","text":"峰高冻雪埋苍玉，河静黄沙咽浊流。\n嗟我残年为远客，烦君双榼散羁愁。\n屠苏禦岁将传盏，綵胜宜春欲插头。\n痛饮须知谋日富，无田何用庆来麰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪中李提举惠玻璃泉两榼二首 其一","author":"张耒","text":"南山春雪冻云凝，暗火青灯急霰声。\n栗烈残年新庆雪，玻璃美酒旧知名。\n饥肠未惯犹空吼，冻脸何知辄妄赪。\n隐忍且须留一榼，晴明待作探梅行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪苦寒五更无睡枕上成两篇 其二","author":"张耒","text":"雪气著我屋，鸡肤畏薄衾。\n春寒竹窗睡，晓梦故乡心。\n多病妨豪饮，无私称苦吟。\n小炉炽新炭，卯酒再三斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪苦寒五更无睡枕上成两篇 其一","author":"张耒","text":"大雪人迹绝，衡门闭不知。\n寒城悲角迥，幽谷晓鸡迟。\n岁月去如失，穷通默自知。\n但知饱寝饭，天道两无私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大暑戏赠希古","author":"张耒","text":"去年挥汗对淮流，寒暑那知复一周。\n土润何妨兼伏暑，火流行看放清秋。\n鬓须总白难相笑，观庙俱閒好并游。\n只怕樽前誇酒量，一挥百盏不言休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小雨","author":"张耒","text":"小雨廉纤晚，幽花寂历秋。\n嘉时空冉冉，白日付悠悠。\n乱思工萦恨，危肠只贮愁。\n唯应时扣寂，一念万缘休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山下","author":"张耒","text":"山下疏钟日夜催，城头画角五更哀。\n流年忽忽愁中过，世事纷纷空里来。\n沮溺漫高轻世节，管商空尽济时才。\n古来扰扰今何有，一熟黄粱梦已回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"张耒","text":"驱马春山去，山蹊绕涧斜。\n浅清沙岸水，疏瘦石岩花。\n放荡从生事，殷勤向物华。\n依微听鸡犬，深柳映人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山夜","author":"张耒","text":"更漏孤城迥，帘帷静夜长。\n天高风送雁，月冷树浮霜。\n晚菊差池绿，高桐次第黄。\n晓来南国梦，不觉寄他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山舍","author":"张耒","text":"萧萧山舍静，谁复与相亲。\n琴酒忘尘事，诗书有古人。\n岁丰民事少，地辟土风淳。\n聊乐身无事，功名丧我真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出都之宛丘赠寄参寥","author":"张耒","text":"萧然耳目清，驱马别都城。\n岸断秋光出，川平雨气横。\n浮生归物理，闲景付诗情。\n岁晚江湖客，何为滞玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己卯十二月二十日感事二首 其二","author":"张耒","text":"蹉跎流落已华颠，又见荆湖一岁迁。\n人怯苦寒愁日短，天收残腊放新年。\n园林寂历飘梅后，里巷经过爆竹前。\n自料知非犹得在，潜心久学卫蘧先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己卯十二月二十日感事二首 其一","author":"张耒","text":"高楼乘兴独登临，搔首天涯岁暮心。\n带雪腊风藏泽国，犯寒春色著烟林。\n山川极目风光异，岁月惊怀老境侵。\n可是斯文天未丧，楚囚何事涕沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未早春有感","author":"张耒","text":"南国柳黄莺未知，人情何事憾春迟。\n雪抽宿麦晴来叶，雨长枯榆烧后枝。\n载酒有谁寻寂寞，受薪只合学支离。\n近知壁观安心法，亦拟平治不作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋无月戏呈希古年兄","author":"张耒","text":"放逐江湖一钓舟，萧条故国又逢秋。\n炎凉始信来如旧，岁月相催逝不留。\n日落千蛩喧户牖，风高一雁下汀洲。\n地无积潦蟾华好，谁买新醪作夜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书直舍","author":"张耒","text":"为官不治民，清坐晚秋晨。\n随事文书了，偷闲笔砚亲。\n吏归雅集定，门锁月华新。\n野鸟何劳问，穷通理有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书壁","author":"张耒","text":"晴窗浴罢试春衣，芳草江南三月时。\n阴合园林禽语乐，风和庭院絮飞迟。\n漫郎官事只画诺，骚客生涯惟赋诗。\n极目江天已多恨，何须木落长年悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书壁","author":"张耒","text":"后院人稀到，荒池半是苔。\n好花随地有，幽鸟自山来。\n靡靡香草合，阴阴夏木催。\n昭亭有佳色，每至不容回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予元丰戊午岁自楚至宋由柘城至福昌年二十有五后十年当元祐二年再过宋都追感存殁怅然有怀","author":"张耒","text":"宋玉台前官树林，十年孤客独沾襟。\n白头青鬓隔存殁，落日断霞无古今。\n暮云梁苑雁鹜暗，久泛吴船江海深。\n阅世悲欢嗟老眼，呼儿取酒十分斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"今早将饮酒闻莺有感","author":"张耒","text":"萧条古兰若，春日等閒斜。\n唧唧初闻燕，匆匆又过花。\n旧游都似梦，到处即为家。\n把酒听莺处，羁怀感岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以病在告寄杨器之","author":"张耒","text":"饮冷寒中不自知，故应病骨易尪羸。\n老人素懒何妨病，太守兼容得自私。\n雨汗欺风元自湿，火云挟日故行迟。\n江楼清绝真孤负，正是斋居禁酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内生日","author":"张耒","text":"从我奔驰走四方，清贫殊不厌糟糠。\n黔娄环堵贫常醉，寿母高堂老亦康。\n夷险百为吾有命，穷通一意子真刚。\n今年生日心无事，好为儿孙举寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双凫","author":"张耒","text":"双凫元自白，况乃小池清。\n逐伴知身洁，当庭独眼明。\n暖沙晴共戏，寒渚夜多惊。\n何事秋风起，轩然向主鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双槐晚秀三月一日初见新叶","author":"张耒","text":"东皇无处著繁华，亦复分张到我家。\n他日老苍悲败蘖，今晨嫩绿出新芽。\n秃翁承弁纤纤发，村妇萦鬟草草花。\n桃李蹊中人绝迹，绿阴门巷正藏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太府李萃卿挽词","author":"张耒","text":"妙誉驰场屋，家风在搢绅。\n使华推厚德，卿月上通津。\n齿德时方重，山丘迹已陈。\n长年先友泪，怀感独沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太皇太后挽词","author":"张耒","text":"共政艰难际，临朝保佑初。\n经纶付耆老，利泽到樵渔。\n礼盛谦常抑，功成委不居。\n圣君深致孝，尽守典刑馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太皇太后挽词","author":"张耒","text":"坐安民物由修己，默合神明为至公。\n他日已占怀月梦，后来方信补天功。\n四时化育坤无事，六合清明日正中。\n九载忧勤已陈迹，空留双阙对青嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少年","author":"张耒","text":"朱绳缚天狗，白羽射旄头。\n新佩将军印，初成甲第楼。\n绮罗诸院夜，鞍马五陵秋。\n惟有如霜鬓，令君览镜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文周翰惠酒以诗谢之","author":"张耒","text":"一梦东都白发新，天涯同是吊灵均。\n读书久误平生事，饮酒聊娱现在身。\n汉上卧龙新得雨，江边饥雁晚知春。\n黄髯相见应相问，为道真成泽畔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"张耒","text":"蔌蔌鸣叶下，初无风过之。\n流年一如此，慷慨使心悲。\n平日谈尧舜，立朝羞自私。\n温炉煖老客，聊复此栖迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日落","author":"张耒","text":"日落长云暗，风悲古岸秋。\n渚鸥遥避客，野蝶戏随舟。\n疏拙资微禄，飘零厌远游。\n若无尊里酒，何物与消愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜怀陈永源","author":"张耒","text":"众喧息遥夜，爽气渍烦襟。\n殷勤低檐月，入幌来相寻。\n平生学虚静，每为多病侵。\n卧想陈夫子，幅巾修竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]