[{"title":"回至泰阳村得家信二首 其一","author":"张镃","text":"乾鹊飞鸣绕路隅，长须迎望果持书。\n鸡豚本自无烦饷，七日山行惯食蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夙兴","author":"张镃","text":"霜池微带月痕斜，风竹声如撒细沙。\n坐到晓窗尤可爱，只愁烘损腊梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安溪道中","author":"张镃","text":"染晴波色重于蓝，烟坞人家屋两三。\n明月在山天在水，后回休睡泊溪南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻桂南山至崇寿院因往灵石三首 其三","author":"张镃","text":"山头藤断空垂子，亭下泉荒不满池。\n老衲坐来知敬客，南音犹记鬼仙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻桂南山至崇寿院因往灵石三首 其二","author":"张镃","text":"迎客山僧未下廊，好风吹鼻便生狂。\n莫疑佛宇清芬烈，薝卜曼殊共借香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻桂南山至崇寿院因往灵石三首 其一","author":"张镃","text":"折枝登几已孤妍，况值风林水石边。\n荦确路斜飞盖歇，丁宁茅店略停烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻梅三首 其三","author":"张镃","text":"韩园邂逅一来寻，还忆朱栏小院深。\n相对两亭无四壁，定参陶令不弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻梅三首 其二","author":"张镃","text":"柴界墙头蜂未窥，草烟沙径亦空枝。\n要知愁结吹香晚，铁石心肠欠我诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻梅三首 其一","author":"张镃","text":"绀碧烘晴水照天，断槎荒葑牧羝田。\n数旬不踏苏堤路，专为梅花跨晓鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尖檐帽","author":"张镃","text":"落魄青楼倒接䍦，醉花争插乱红欹。\n如今两垫纶巾角，汝帽尖新却自宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁旦立春 其四","author":"张镃","text":"从此车书看混同，王春丕建四时功。\n八千岂但庄椿比，宸极光符万岁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁旦立春 其六","author":"张镃","text":"结宇城隅野老同，只将歌咏纪元功。\n枯荄亦喜春回早，为在条风振拂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁旦立春 其一","author":"张镃","text":"天心历数本相同，何事偏窥造化功。\n苍震欲承乾健力，岁端春肇一时中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁旦立春 其三","author":"张镃","text":"赞美平时万口同，耸观造化协天功。\n圣朝家法皆仁德，宽大应符帝诏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁旦立春 其二","author":"张镃","text":"授受须知道一同，机缄默运仰神功。\n重轮赫日当天照，万国阳和淑气中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁旦立春 其五","author":"张镃","text":"宝翰钟王妙与同，虎龙腾跃更新功。\n诗成秦观如佳兆，适契青宫得意中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏仿韩致光体","author":"张镃","text":"意懒风前侧帽檐，落梅红在麦修纤。\n归家说尽单行处，可奈温香翡翠奁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏成白发二首 其二","author":"张镃","text":"朝朝摘白发，新生亦非黑。\n纵使白不生，秃翁还讳得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏成白发二首 其一","author":"张镃","text":"怕见人言老，梳头夜二更。\n谁知灯烛夜，漏逗愈分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏咏咸蛤","author":"张镃","text":"盐作栖巢涕作脂，樽前风味不胜低。\n纵教一衲被云水，无奈胸中著淤泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏答客问","author":"张镃","text":"桂隐芙蓉盛，柴门日日开。\n若无诗与酒，不请看花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题重台梅","author":"张镃","text":"只将单萼缀层花，弱骨丰肌自一家。\n戴几朵来谁可称，宝钗双燕绿云斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其四","author":"张镃","text":"初时华节漕江东，台阁争留省阁中。\n换得一州如斗大，便无人挽信诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其三","author":"张镃","text":"闻道匆匆不住程，如今应已到乡城。\n亦通朝路音书不，朝外可能空旧情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其一","author":"张镃","text":"老子生来铁面皮，要渠嬉笑莫过诗。\n可怜百巧卿云手，拙直今年一奏词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其二","author":"张镃","text":"送公萧寺意徘徊，客众登车不忍归。\n明日尚将诗寄我，要令鹤骨转难肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其五","author":"张镃","text":"少有羊曾踏菜园，更教清苦嚼筠根。\n何如添得如椽笔，就向西江一口吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其六","author":"张镃","text":"螀寒蚓叫亦何心，老贼奚堪领活深。\n非是交游无远别，几回因此惨离襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其七","author":"张镃","text":"诸子分镳不待鞭，愈怜肥犬满人前。\n何须妙处趋庭说，心学乘閒尽底传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀新筠州杨秘监寄赠八绝兼桂隐茶 其八","author":"张镃","text":"茗芽封去且随书，林下多惭好物无。\n鼻孔撩天犹得在，却须持赠竹香炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴 其三","author":"张镃","text":"细读南山扣角歌，机锋投处几曾多。\n道人不踏门前路，敝帚其如自爱何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴 其一","author":"张镃","text":"迢遥秦陇旧家山，百万貔貅拥节还。\n读尽一编时自许，西风吹梦玉门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕浩然四首 其四","author":"张镃","text":"天然风景异人为，门外南湖不姓西。\n指日芙蓉盛行发，何须出郭看苏堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕浩然四首 其三","author":"张镃","text":"秋水清来不钓鱼，有时遮眼强寻书。\n过从闲客犹全少，况是朝官更合疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕浩然四首 其二","author":"张镃","text":"作诗谁道有梯阶，当下由人肯放开。\n字字不为声病缚，知君得处自天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕浩然四首 其一","author":"张镃","text":"小筑茅堂亦有厅，规摹林野自然清。\n仙风道骨真人后，过我应除喝道声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵京口叔祖见寄四首 其四","author":"张镃","text":"汲古无初不读书，屠苏新制帖僧庐。\n痴禅昼夜蒲团上，贪睡犹胜学宰予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵京口叔祖见寄四首 其三","author":"张镃","text":"病起逢春自献酬，醉狂诗体类俳优。\n追攀雄杰诚堪笑，寄去稽迟更合羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵京口叔祖见寄四首 其二","author":"张镃","text":"山堂初展称婆娑，曲径移栽杂树多。\n应是我翁归舍后，便登繁要亦来过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵京口叔祖见寄四首 其一","author":"张镃","text":"欲诉中心话许长，尺书恨不寄千张。\n新篇喜逐东风好，变尽人间草木荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵茂洪觅腊梅","author":"张镃","text":"世路?崟费折枝，退耕非我更其谁。\n真花似假无心咏，只诵涪翁旧日诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵姜邦桀见访留赠三诗 其二","author":"张镃","text":"绕林游遍更沿陂，薄暑车行不下帷。\n最喜竹君相伴久，见渠生子子生儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵姜邦桀见访留赠三诗 其一","author":"张镃","text":"饱看朝霞与暮云，一丘一壑大无尘。\n关门果是倦迎客，倒屣还因有句人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵姜邦桀见访留赠三诗 其三","author":"张镃","text":"何曾一事扰中扃，醉便投床梦亦清。\n书卷犹嫌旧时习，未能熟处放教生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐衡仲饷淮白鱼","author":"张镃","text":"谩浪功名付直钩，谁能鏖战学焚舟。\n随人不但羹鱼美，解道江?似鹿头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬王之孟见赠","author":"张镃","text":"相逢未问有诗新，识得全然少得人。\n莫怪世间多不爱，翰林憔悴少陵贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬王梦得西湖上见寄","author":"张镃","text":"一萼香红未破尘，绿波惊眼自摇春。\n晴新策蹇湖边去，供作他年画里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬张郎中赋水蕉四首 其四","author":"张镃","text":"往年植处倚苍岏，曾蔽秋苔两席宽。\n别后不因贪水宿，儿孙那得许萧寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬张郎中赋水蕉四首 其三","author":"张镃","text":"诗卷寻常要往回，今朝却怕此诗来。\n只缘快读清凉语，返觉林居有世埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬张郎中赋水蕉四首 其二","author":"张镃","text":"火云空际正巑岏，漫瞰平湖百亩宽。\n叶叶是风根是雪，一窗因尔忽生寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬张郎中赋水蕉四首 其一","author":"张镃","text":"春去论年卒未回，溪头传信却先来。\n绿笺展尽全无字，此语何堪谕俗埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上 其三","author":"张镃","text":"海榴如火发高丛，空斗炎炎烈日红。\n争似栀花浑是雪，净香薰透一池风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上 其二","author":"张镃","text":"波纹回处恰双鱼，小草花红点绿蒲。\n不是幽人相管领，枉教造化着工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上 其一","author":"张镃","text":"绿卷晴荷插满池，珍禽来惯帖船飞。\n看云只似寻常立，何独今朝忘却归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上木芙蓉欲开述兴二首 其二","author":"张镃","text":"岸巾三酌便酣眠，堕地鸾笺写未全。\n明日满城人定说，若无诗累是神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上木芙蓉欲开述兴二首 其一","author":"张镃","text":"芙蓉环望压波明，燕尾舟从绿处撑。\n待得花成红沓堕，老夫天地锦纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池边二绝 其一","author":"张镃","text":"屡欲池边看晓烟，晓烟多是独贪眠。\n红渠似怪人来晚，不肯回头却粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红佛见笑花","author":"张镃","text":"芳菲成梦雨廉纤，慰眼娇红敢浪嫌。\n不但瞿昙当发笑，老夫初看亦掀髯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约斋","author":"张镃","text":"博学非能事，详言道转乖。\n只因省气力，处处是吾斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自锡山归舟中三首 其三","author":"张镃","text":"帆腰风便得归程，天末层云暗又明。\n浅色鸡儿深色草，知谁教汝唤诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自锡山归舟中三首 其二","author":"张镃","text":"破驿遥临放马场，两鸦飞下更苍凉。\n东风莫起雕鞍兴，白发欺人念故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自锡山归舟中三首 其一","author":"张镃","text":"墙上夭桃竹顶齐，矮桥横水屋横陂。\n主翁受用三竿日，门外催租总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行观新月","author":"张镃","text":"一痕如掐夕天涯，望转青林出没时。\n不是山高爱藏月，月光犹嫩怯人窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过良渚","author":"张镃","text":"船出修门未有诗，直须凤口汎晴溪。\n缘何触景方吟得，拙句频年不立题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芍药花二首 其二","author":"张镃","text":"吟笺欠向此花题，未信翻阶句绝奇。\n三嗅苍髯惹黄粉，又成空对剪来枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芍药花二首 其一","author":"张镃","text":"自古风流芍药花，花娇袍紫叶翻鸦。\n诗成举向东风道，不愿旁人定等差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次下渚湖二首 其二","author":"张镃","text":"野童绿草牧鹅群，诗料今朝得几分。\n俯仰纵横皆合律，云如层树树如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次下渚湖二首 其一","author":"张镃","text":"绵延苍岫补林空，菱荇通船万镜中。\n黄白花明如绣出，蜻蜓犹爱蓼成丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次德清 其三","author":"张镃","text":"渐凉山水倍清华，不说渔樵亦自嘉。\n好是趁人全省力，龟溪才过又荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次德清 其二","author":"张镃","text":"浮图立处觉天低，迎我船行十里时。\n不是前山明复暗，那知头上白云移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次德清 其一","author":"张镃","text":"波鸣船板唤晨兴，倦睫揩摩得梦醒。\n到县阴晴休更问，野禽声已喜人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西庄夜归","author":"张镃","text":"草声真似过田间，唧唧虫催兴未阑。\n珍重小舆能从我，夜深穿遍竹阴寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观水上斜照","author":"张镃","text":"吹落天河入水中，分明金镀晚来风。\n若非日脚流成汁，平楚青还染得红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访安福寺叶上人","author":"张镃","text":"苍苔径入旧栽竹，树里桥横新凿池。\n丈室稳居清绝地，岂容支遁不能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过枫桥寺","author":"张镃","text":"妙绝吾宗有旧题，趁晴径过敢留诗。\n只消记取今朝景，不是乌啼月落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过野翁亭因登岝崿山憩崇寿院僧轩共成四绝句 其二","author":"张镃","text":"溪流逢旱息潺淙，野彴横趋乱石中。\n莫恨铁冠人已去，我来权合号山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过野翁亭因登岝崿山憩崇寿院僧轩共成四绝句 其一","author":"张镃","text":"古县依山惬乍游，欲行因路始穷幽。\n搀空石壁樛林合，更做行程急也留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过野翁亭因登岝崿山憩崇寿院僧轩共成四绝句 其四","author":"张镃","text":"岩隈萧寺得跻攀，数翠邀岚不复难。\n已向城中专一壑，更须随处款青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]