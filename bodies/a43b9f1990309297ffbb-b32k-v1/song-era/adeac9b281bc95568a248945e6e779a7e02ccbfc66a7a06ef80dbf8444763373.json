[{"title":"次韵答王声见赠","author":"葛胜仲","text":"平生未分作臞仙，抵柲英豪不直钱。\n效智连年居定鼎，策勋何日上凌烟。\n高情独寄猗兰操，壮志应存宝剑篇。\n途辙悬知腾上速，请看火色映鸢肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和目疾韵","author":"葛胜仲","text":"幻翳乘虚近漆瞳，轻云蔽月有无中。\n废书暂阻雠三豕，妨射何因落两鸿。\n慧眼水清知吉梦，药师经验表奇功。\n疾平岂但开岩电，反照观身觉内通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居书怀六首 其一","author":"葛胜仲","text":"材疏出仕久知难，境胜谋居自考槃。\n反抱关为知道在，赖閒处著得身安。\n离骚每向醉中读，周易仍于病里看。\n万顷烟波时击汰，浟浟籊籊弄晴竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居书怀六首 其二","author":"葛胜仲","text":"环堵翛然一亩宽，更无尘雾苦相干。\n森森佳树木奴实，湛湛清池地镜寒。\n三益时瞻玉界尺，一杯何用肉台盘。\n官閒坐享无功禄，更恐风人刺伐檀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居书怀六首 其三","author":"葛胜仲","text":"观名计利了非真，何似江湖习隐沦。\n户小但期茶当酒，家贫那有蜡充薪。\n五花自喜风翻簟，一角人看雨垫巾。\n上界神仙多护短，不辞长作葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居书怀六首 其四","author":"葛胜仲","text":"不识痈疽与瘠环，柴门虽设自常关。\n木鸡养就都无累，刍狗陈来分合閒。\n聊复读书牛背上，谁能横槊马蹄閒。\n子亭结筑临溪面，瓢饮新来待学颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居书怀六首 其五","author":"葛胜仲","text":"我贵从教知我希，静观物化养天机。\n名呼池面游鱼狎，缕系梁间旧燕飞。\n安石困应存远志，姜维那遽觅当归。\n人生安乐他何恤，怅望乡枌与愿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居书怀六首 其六","author":"葛胜仲","text":"清时鸳鹭正充庭，何事抽簪喜退耕。\n百步穿杨防偶蹶，一卮赏画保先成。\n獭皮冠小随时用，猪鼻车低取意行。\n官柳野梅春意动，莫教诗酒负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢太守惠茶","author":"葛胜仲","text":"林亭冻卉未芳华，已享先春正焙芽。\n活火急呼汤饼客，缄囊来自使君家。\n破看鲜馥欺瑶草，煮验漂浮漾枣花。\n不预头纲评四品，恍惊流落滞天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新茶","author":"葛胜仲","text":"壑源苞贡及春分，玉食分甘赐旧勋。\n水厄阳侯宜避席，天随陆子合同群。\n珍同内府新苍璧，味压元丰小矞云。\n便请加笾先果腹，鹅无留掌鳖添裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢通判惠茶用前韵","author":"葛胜仲","text":"色味新香各十分，可无桑苧与书勋。\n打门赠我令呼客，好事知君最出群。\n饮罢清风引仙阙，睡馀妖梦破朝云。\n贫无列屋纤纤手，捧盌齐眉但布裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郭大夫见寄","author":"葛胜仲","text":"泗上频蒙访寓公，十年乖隔马牛风。\n谁知迈往青云士，尚寄哀迟白发翁。\n浮食即今尸靖馆，育材当日谩儒宫。\n寄声有道劳虚奖，窭籔方安鼠技穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋夜宿舞阳精舍","author":"葛胜仲","text":"居心纯静眼无尘，此夜清光遍广轮。\n乖隔谩嗟千里共，澄明还是一年新。\n已抛世外无穷事，独喜尊前见在身。\n却忆帝城通夕看，清歌百阕会三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月三日游风穴白云寺呈通判二首 其一","author":"葛胜仲","text":"世传三穴起长风，此理诚难识所从。\n觉性未能参七祖，禅扃聊欲访千峰。\n桃溪溯日红霞烂，麦陇酣春翠浪浓。\n簿领回回清兴少，乍寻岩壑愧尘容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月三日游风穴白云寺呈通判二首 其二","author":"葛胜仲","text":"秀野班春过梵宫，贤僚况复肯相从。\n风缘禦寇来幽穴，云为渊明出远峰。\n柳色直将波共绿，花光疑与酒争浓。\n一庵此境堪肥遁，寄语山灵幸见容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四桂坊","author":"葛胜仲","text":"蕊榜连年诏墨黄，联翩恩绶月中香。\n家声旧踵三槐位，儒学今标四桂坊。\n酬唱共传花萼集，笑谈应聚德星堂。\n门同列戟知非晚，更遣乡评服义方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾家故事子侄登第必有酬献诗什去岁立悌立经二侄并中科选未有庆以诗者偶示四韵","author":"葛胜仲","text":"充闾秀气我家多，又喜双龙并化梭。\n同榜连荣追绍圣，传名跻甲首宣和。\n朝班鸣玉犹升舍，冠岁横金又中科。\n四叶登华谁得似，会看盛事入编摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵觉心道人游郡园","author":"葛胜仲","text":"牢落踰年坐斗州，窥园逢胜辄迟留。\n招邀风月千章木，收拾峰峦百尺楼。\n云叶悠扬疑独鹤，浪花浮动想饥鸥。\n道人知被烟霞锢，当是空门第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留二季父二首 其一","author":"葛胜仲","text":"敢向明时叹滞淹，得官迎养富鱼盐。\n百年永抱双亲恨，五斗犹欣二父沾。\n寿耋名应书绿字，康宁药不待青黏。\n虚堂梧竹饶幽趣，正好端居养智恬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留二季父二首 其二","author":"葛胜仲","text":"羁宦栖栖易感怀，一秋聊得病颜开。\n幸蒙南巷携家至，更喜东床自远来。\n鹄发二翁频撰屦，鸰原群从共衔杯。\n家山莫便怀中隐，风月跻攀更几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和若拙弟说汝州可居已约卜一丘韵","author":"葛胜仲","text":"汝海膏腴人共说，封疆况是接同州。\n指囷待惠知无日，负米躬耕会有秋。\n林下要须三径足，橐中更莫一钱留。\n饭抄云子当同饱，官职来迟且自休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陆岩老祠部见寄五首 其一","author":"葛胜仲","text":"山城岑寂偶分麾，聊欲藏瘝一再期。\n岂有声华如所誉，得非朋旧猥相欺。\n久钦黄发嘉猷壮，初喜青天宿雾披。\n尚恨匆匆还执别，不容重醉习家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陆岩老祠部见寄五首 其二","author":"葛胜仲","text":"绕郭芙蓉十里城，画桥烟水接东瀛。\n蘋洲倒照苍山影，花濑遥闻白苧声。\n问舍求田应犯虑，浮家泛宅未忘情。\n催科拙似阳公考，敢觊屏风录姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陆岩老祠部见寄五首 其三","author":"葛胜仲","text":"溪南溪北梵王宫，踊甓亭亭耸半空。\n红靺鞨沉山带日，碧琉璃净水无风。\n云迷翠阁参差见，舟舣朱桥缭绕通。\n泚笔凭谁写东绢，尽将烟景荐重瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陆岩老祠部见寄五首 其四","author":"葛胜仲","text":"词场弱岁以文鸣，落落寒松见老成。\n剧郡神君频结课，中台郎位早飞声。\n当年威令千人废，此日精神一座倾。\n欲试閒窗鸿笔健，春容诗轴灿琼英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陆岩老祠部见寄五首 其五","author":"葛胜仲","text":"镜中双鬓未全华，退隐林泉意绪嘉。\n春圃带烟锄径草，夜灯和雨看檐花。\n神能自卫同干越，老更知涂似渥洼。\n文注五河初不竭，从来惟属士衡家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何总管等慈寺诗二首 其一","author":"葛胜仲","text":"寺门修竹映长楸，景似江村事事幽。\n山叠青螺云绕屋，月升紫磨水明楼。\n梦中他日应知路，天上从今与寄愁。\n竞病将军功已就，却将高兴赋沧州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何总管等慈寺诗二首 其二","author":"葛胜仲","text":"古寺萧清汝水湄，寓公仍有庾征西。\n机轮宛转春寒硙，浮线萦纡漾小溪。\n入定僧閒多却扫，深春人去自成蹊。\n一杯相属知何日，成事因须共到齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯氏丧归有日遣立方祭奠","author":"葛胜仲","text":"灵轜东下启铭旌，羁宦茕茕逗楚城。\n遣奠聊凭贻厥力，衔哀遥致友于情。\n虎闱典教曾同遇，雁塔书名亦并荣。\n齿脱发稀吾老矣，可堪回首望前楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵景纯将赴襄阳眷恋里第","author":"葛胜仲","text":"枳棘栖鸾岂所宜，盐车服骥暂缰鞿。\n少而好学书饶读，壮不贪荣誉自归。\n重去故山抛小隐，懒趋名路触危机。\n寄言汉广徜徉者，聊赏风光且莫违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙若拙宠次陈敏彦韵三和 其一","author":"葛胜仲","text":"彤墀日觐赤霜袍，何苦怀归问大刀。\n吴坂未逢惊騕袅，丰城行见拭豪曹。\n庙堂仄席方求助，筦库飞刍莫讳劳。\n即向词垣摛外翰，当年仙桂几枝高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙若拙宠次陈敏彦韵三和 其二","author":"葛胜仲","text":"寺居岑寂近方袍，贫舍分瓜每借刀。\n隶事旧闻轻叔宝，读书今却笑敖曹。\n珍姿浑厚韬和璞，利刃坚刚敌孟劳。\n桂树独生千仞表，太丘家世显名高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙若拙宠次陈敏彦韵三和 其三","author":"葛胜仲","text":"韶颜秘殿赐恩袍，白首山城始梦刀。\n竹坞有诗缘二妙，棠阴无讼赖诸曹。\n消閒不废持螯饮，结课曾微汗马劳。\n更拟松江理烟艇，如归亭上踵三高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宋景纯寄陈去非昆仲","author":"葛胜仲","text":"云台献纳愧先贤，端合尘迷簿领閒。\n政似阳城惟下下，文如祖咏只班班。\n著书大似屋中屋，择禄甘从山上山。\n揣分量材宜置散，敢于造物怨偏悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叔父承事用先公旧韵作诗次韵和呈","author":"葛胜仲","text":"西笑惟携插架书，雍容车骑不求都。\n观光凤阙前踪在，寄恨鸰原往事徂。\n喜见教忠跻显仕，勉从迎养涉修途。\n新诗清婉追棠棣，乐孺当年共究图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和元方寄若拙弟托觅颜渊之五十亩韵","author":"葛胜仲","text":"下田弥望股清流，谋食谁言必本州。\n且复种粳资口腹，早知籍稻载春秋。\n携家便可随丰俭，仕国从今委去留。\n饘粥粗供吾事济，寸心安静得休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙若拙见和复次韵","author":"葛胜仲","text":"逸气轩轩盖搢绅，后来之秀子其人。\n文如范晔无空设，学似扬雄已大醇。\n记问五花能夺簟，风标一角共传巾。\n怪来吐句皆清警，胸次应无庾亮尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏蒙孝立朝请同年赴九日燕集翌日以佳篇须酒谨依韵上谢","author":"葛胜仲","text":"新稻翻匙羹芋魁，慇勤重客肯相陪。\n醉归已彻重城漏，睡起应寻十日杯。\n欲得杜康连榼至，因令毛颖寄辞来。\n扶头往饷宜频釂，更喜输租罢与催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迩日诗卷承若拙编为小集见示且有诗因次韵","author":"葛胜仲","text":"骊珠鱼目两无遗，卷帙深烦为析釐。\n赋咏粗疏惭短笔，赓酬刻画赖连枝。\n似闻警策眈佳句，何用编摩载恶诗。\n敢请冠篇重作序，二难文采胜延之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵景纯后圃宴集","author":"葛胜仲","text":"携装过我路漫漫，聊命杯铛为禦寒。\n漏月竹疏怜影碎，干霄楸老见根蟠。\n城头飞屐千峰迥，楼角凭栏六幕宽。\n尚欲相留过残腊，小园佳致雪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景纯到汝数日遽求别仆固不敢留客然宋伯举为兄苏勤道为妇之兄遽见去似非人情辄赋是诗率二僚留之","author":"葛胜仲","text":"奉留高客敢同黄，恃有亲亲与雁行。\n乐孺诚宜赋棠棣，盘桓何畏啬槟榔。\n敬通叔达无争论，法护僧弥各擅长。\n二义周官如问得，且看姜被莫腾装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"懋南博士暂出回邑以盛藻见观谨依韵奉和二首 其一","author":"葛胜仲","text":"五十之年岁又开，劾归不勇尚徘徊。\n家徒四壁谢金埒，第乏一区惭玉杯。\n彊欲安心师达磨，懒谈真我类投灰。\n吾僚轻作经时别，犹喜民谣挽得回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"懋南博士暂出回邑以盛藻见观谨依韵奉和二首 其二","author":"葛胜仲","text":"公退萧閒闭息深，从来县谱用山阴。\n威棱少霁髯垂几，才韵频将笔捶琴。\n取急卧家聊小憩，捧符还郡却幽寻。\n风流若把名香拟，堪作盈斤百和沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提宫工部兄携家见过辄成律诗二首上呈 其一","author":"葛胜仲","text":"剥啄欣闻夜叩关，相迎一笑解愁颜。\n枉帆虽落十人后，过饭今成五郡间。\n自役其身惭鞍掌，无求于世羡萧閒。\n何如赴陇从招隐，却遣幽丛问小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提宫工部兄携家见过辄成律诗二首上呈 其二","author":"葛胜仲","text":"相逢虽幸慰暌离，忧患仍年触境悲。\n琴与俱亡念同气，缶犹难击怆齐眉。\n筋驽肉缓奔名懒，意广才疏见事迟。\n只待归资堪问舍，一封投劾去追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福国讳日寿宁院作呈工部兄","author":"葛胜仲","text":"一官随牒浪推移，不到名山二十期。\n踊甓独存煨烬日，布金重见鼎新时。\n旧游已起人琴恨，净供还增奁镜悲。\n赖是一般官拓落，林泉深处得追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近辟禄隐轩建瓢饮亭季父以诗寄题和韵","author":"葛胜仲","text":"稚节争名翰墨场，中年习隐水云乡。\n遭时有幸常温饱，济世无能分退藏。\n山色不于羁客秘，日华端为散人长。\n身閒却笑东方朔，避世金门傲武皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵景纯见寄叙相从之乐","author":"葛胜仲","text":"许昌旧姓有文儒，得得西来过燕居。\n访我肯题门有凤，馆君深愧食无鱼。\n鄣泥难为清游惜，便面频将好句书。\n尚遣雅才淹簿领，好贤谁赋卫干旟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬景纯道中见寄之什","author":"葛胜仲","text":"惭无才望照簪绅，剖竹藩房误长人。\n堪笑为官常拓落，独知取友爱真醇。\n吏休时著煎茶帽，客去今閒漉酒巾。\n曷日清扬重会面，划开河汉涤心尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友乡寄谢并月波酒和其韵","author":"葛胜仲","text":"长须剥啄叩柴扃，令弟官清远寄声。\n擿句已欣资艺圃，漱醪兼赖破愁城。\n牵丝闻说恢材力，露板应连上姓名。\n犹忆具区分袂处，孤帆一点怆离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔才幽居二首 其一","author":"葛胜仲","text":"世涂艰险动难谐，学士深居但柏斋。\n紫翠当门流水过，碧鲜遮槛好风怀。\n角巾家巷便高枕，手板公廷厌没阶。\n天地百年真逆旅，谁能巧宦役筋骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔才幽居二首 其二","author":"葛胜仲","text":"粗才濩落与时乖，湖海幽居一竹斋。\n月径清游疑不夜，风窗高趣到无怀。\n身閒有分白莲社，地禁无心红药阶。\n只待匡庐官秩满，一章程奏乞残骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵工部兄见寄三首 其一","author":"葛胜仲","text":"影落邗沟是我家，端来吴地寄生涯。\n蜗庐困卧身何择，蝶梦时归路不遐。\n幽径任荒陶令菊，閒门聊莳邵侯瓜。\n西还约醉中秋月，屈指同襟尚阻赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵工部兄见寄三首 其二","author":"葛胜仲","text":"文采清华自一家，行身所到讵能涯。\n学该古昔仍知要，识造高明岂不遐。\n英晤早明当道李，勤书频事镇心瓜。\n似闻忧国头今白，法会无钱想尚赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵工部兄见寄三首 其三","author":"葛胜仲","text":"朱门十万一贫家，鼓枻西归怅未涯。\n数米称薪嗟隐约，望云临水负幽遐。\n清音且听雉登木，曲路任从蝇集瓜。\n午饭萧然无脍鲤，须知滋味已能赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔才以诗卷见还有作","author":"葛胜仲","text":"委巷歌谣愧斐狂，雷门布鼓背生芒。\n凤毛忽尔惊悬罄，鱼目真能引夜光。\n义重肯为流俗变，意勤仍以古风将。\n怪来巾笥多珍玩，获奉英游已五霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昌化紫霄阁次长老仲希赋","author":"葛胜仲","text":"溪山佳处不须招，未到心旌每动摇。\n渐喜田园挽陶令，敢将笔砚伏君苗。\n黑云含雨迷江馆，白鸟冲烟映市桥。\n回首海宁惊谪梦，挽舟犹记笏垂腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去南阳有日书怀二首 其一","author":"葛胜仲","text":"奠食无劳合退休，君恩误付百花洲。\n未温坐席已当去，偶带泥封得少留。\n官意正如彊弩末，归心先问大刀头。\n略无涓滴苏民隐，空使闾阎说旧侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去南阳有日书怀二首 其二","author":"葛胜仲","text":"离吴州好冠西畿，左竹才交赋式微。\n云巘遐观空杳霭，春郊细履负芳菲。\n薄游颇似桑三宿，重到谁惊柳十围。\n诺画诸僚皆府望，不容坐啸久焉依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡斋书怀","author":"葛胜仲","text":"暂摆尘劳坐燕居，野人偏与世情疏。\n马牛价杂慵钩距，凫鹜行多厌簿书。\n同醉径须邀绿竹，盗香无复念红蕖。\n不持黄卷来遮眼，可惜炎天化日舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南阳诸僚和留别诗再和二首 其一","author":"葛胜仲","text":"王事勤劳得少休，全家喜复入汀洲。\n懒于荣路占淹速，尚有浮生任去留。\n名誉未须惊谷口，功名终亦困壶头。\n归栖拟种千竿竹，便与题为潇洒侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]