[{"title":"送僧惠日归蟠龙山","author":"王炎","text":"宴坐团蒲稳，何缘有此行。\n理元无作止，事亦要经营。\n鹤锡寻归路，龙宫出化城。\n更于文字外，会取法无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中游观之地清风楼为第一前此诸公有诗似觉摹写未尽辄成唐律一篇约魏倅同赋不拘和韵可也","author":"王炎","text":"山屏四面碧相重，苕霅无声泻玉虹。\n万户连甍皆在下，一楼飞栋独当中。\n不容半点浮尘到，但觉无边爽气通。\n安得翛然辞物役，披襟终日挹清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜官舍独坐","author":"王炎","text":"半世更忧患，微霜入鬓边。\n旅怀尊有酒，官况客无毡。\n故国踰千里，浮生又一年。\n遥怜小儿女，今夜话灯前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食楞梅","author":"王炎","text":"是处杨家果，求如此种难。\n色深浑是紫，味美更无酸。\n磊磊堆盘润，津津绕齿寒。\n品高何以辨，但把一楞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吴耀远","author":"王炎","text":"孤陋无如我，交亲赖有君。\n方图来往数，岂意死生分。\n自卜牛眠地，今归马鬣坟。\n不能浇斗酒，忍遽述铭文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家仆来丛桂告米粟不继","author":"王炎","text":"来时花柳未全春，燕子将雏已夏深。\n破镜望中占远信，扊扅歌里有悲音。\n青衫得禄犹弹铗，白发欺人欲上簪。\n筑室买田谋小隐，探囊何日有黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅中书怀","author":"王炎","text":"燕子未归寒已退，海棠半落雨初晴。\n他乡异县见春色，远水平芜关客情。\n道路不来黄犬信，烟波深负白鸥盟。\n数奇落在千官底，敢叹儒冠误此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅中思家","author":"王炎","text":"野田既雨水皆满，山路无风花自香。\n且复将身供世事，也能随处对春光。\n绝嫌俗物眼多白，未办生涯髯已苍。\n待看楂梨粗可教，老夫耕钓即韬藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅兴","author":"王炎","text":"白眼看时事，刚肠厌俗流。\n也知蜂有毒，未信鼠堪投。\n熟睡消磨日，清吟拨置愁。\n倚门应望切，早晚赋刀头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮碧亭","author":"王炎","text":"凫舄飞来空翠间，万家联络拥风烟。\n个中杖屦宜频到，此外楼台总浪传。\n山似蓬莱差可近，水疑渤澥欲无边。\n湘妃度曲冯夷舞，招我骑鲸意亦仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间即事","author":"王炎","text":"暂留野次倦征行，差觉山林气味清。\n日酿梅酸新雨过，山连空翠淡烟横。\n东皋水满起农事，南国草青回雁程。\n拨置文书聊隐几，笙歌一部听蛙鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中恕子投劾同归","author":"王炎","text":"萧萧华发更何为，元是穷乡一布衣。\n同产弟兄谁见在，馀生父子独相依。\n我缘多病念家切，汝为爱亲投劾归。\n出处不齐难逆定，时来还自刺天飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄蒋主簿","author":"王炎","text":"过我匆匆去，难淹长者车。\n岁华今又晚，官况近何如。\n不是无才具，渠忧少荐书。\n因君问公干，久不寄双鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄德瑩弟二首 其二","author":"王炎","text":"洞庭秋水望中天，侧目飞鸿断复连。\n得句信知神入梦，浇愁不惯酒中仙。\n秋风白发欺来日，夜雨青灯忆往年。\n用拙不妨消息好，关山明月两茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄德瑩弟二首 其一","author":"王炎","text":"牢落羁旅隔楚东，青山梦入往来中。\n离心落雁惊秋雨，醉眼开花昨夜风。\n一壑若为甘小隐，三江何日挂归篷。\n谋生向坐文穷计，识破誵讹虑已空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得昭叔弟书","author":"王炎","text":"十年客馆出无车，倦迹归来守敝庐。\n林下巢倾乌哺断，天边风急雁行疏。\n欲传消息苦无便，喜报平安今有书。\n行李何时能缓带，对床风雨且幽居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县圃黄梅半堕草间","author":"王炎","text":"荷锄芟草唤畦丁，手拾黄梅绕树行。\n结子青青随雨老，开花白白本冰清。\n尝新争擘红泥酒，知味谁调玉鼎羹。\n齿软眉颦遭弃掷，误从雪里竞欣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春书怀简陈巽叔二首 其二","author":"王炎","text":"花片已零落，绿阴遮短墙。\n园蔬春笋长，官酒腊醅香。\n挥麈故人少，杜门閒日长。\n不妨时过我，谈笑倚绳床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春书怀简陈巽叔二首 其一","author":"王炎","text":"畏病不多酌，遣情时自吟。\n絮飞春漠漠，树密午阴阴。\n壮县今岑寂，微官有陆沉。\n青山啼杜宇，未断故园心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清化寓居","author":"王炎","text":"委巷何深僻，侨居太寂寥。\n古墙行络石，乔木上凌霄。\n赋就贫难逐，诗成隐莫招。\n固穷吾辈事，心地要逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日先茔挂楮钱","author":"王炎","text":"昔人最重去坟墓，绝喜归来老一丘。\n岂是他山无笋蕨，只缘故国有松楸。\n百年暂住人间世，千古俱为地下游。\n色境悲欢虽梦事，楮钱聊挂树梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧参议雪中宴客朱佥判有诗因次韵 其一","author":"王炎","text":"飞花落絮自何来，勾引诗翁酌梓罍。\n濯鼎有冰宜煮茗，携筇无路可寻梅。\n江城琼玉踰千顷，古锦珠玑溢百枚。\n闻道夜阑车马散，难窥鹤氅御风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧参议雪中宴客朱佥判有诗因次韵 其二","author":"王炎","text":"不惯长安曳履游，贪看冰柱满檐头。\n素花一色如梅岭，碎玉无声欠竹楼。\n蜡炬欲残方夜永，金钗半醉自春浮。\n无毡独坐君知否，也捲陈编索酒舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧参政挽诗二首 其二","author":"王炎","text":"东府才登用，南园即退藏。\n不欺身自正，无欲气能刚。\n士共悲梁坏，朝应惜鉴亡。\n臧孙宜有后，世出甲科郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧参政挽诗二首 其一","author":"王炎","text":"正学无阿世，危言不顾身。\n旁观多侧目，独立屡撄鳞。\n八叶钧衡后，三朝柱石臣。\n晚方陪国论，终不尽经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒告成庙","author":"王炎","text":"玉帛何年会，衣冠此地藏。\n物存惟窆石，神变失梅梁。\n并海山川尽，踰河道路长。\n六臣陪庙食，千古共烝尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野次欲访于从周不果因寄二首 其二","author":"王炎","text":"佳士不可见，清游难豫期。\n此心虽眷眷，欲去却迟迟。\n白酒应新熟，黄粱亦可炊。\n稍閒当跃马，说与主人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野次欲访于从周不果因寄二首 其一","author":"王炎","text":"见说南山下，云霞好隐居。\n草深幽径断，心远俗人疏。\n倚杖时观穫，焚香只读书。\n宦游无此乐，令我忆吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野次遇雨","author":"王炎","text":"木末云屯飞雨暗，柳梢水到小溪深。\n身随王事有行役，家在江南无信音。\n但得林泉堪著眼，莫将轩冕更关心。\n拂衣何日径归去，青鬓不禁愁绪侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铦老许相过不至炎约尧章访之又以事夺铦寄二诗次其韵 其二","author":"王炎","text":"南山藏雾豹，几欲访幽深。\n诗到如相挽，盟寒尚可寻。\n惠初从柳子，支遁会山阴。\n此事今寥落，期公慰我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中官舍独坐闻薪炭翔贵因成长句","author":"王炎","text":"天寒吹堕一尺雪，官冷酿成千斛愁。\n酌酒到花非所欲，束薪如桂若为谋。\n风前鹤氅谁携策，江上渔蓑自舣舟。\n凭仗六龙回日毂，稍分轻暖到南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄致政挽诗二首 其二","author":"王炎","text":"禄养更迎侍，消摇介寿康。\n壮图虽偃屈，潜德竟辉光。\n可惜今埋玉，无由自奠觞。\n他年观上冢，千骑拥龙冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄致政挽诗二首 其一","author":"王炎","text":"后学资模楷，先生久里居。\n两儿联玉笋，三命佩银鱼。\n米廪无重席，蓬山孰校书。\n如何遗此老，宰木遽萧疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜祝季通相访","author":"王炎","text":"一笑掀髯语不休，只鸡斗酒少淹留。\n读书未疗一身困，弹剑同怀千岁忧。\n乔木拥烟村落冷，西风吹雨稻粱秋。\n此中可觅离骚句，跃马重来溪上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓江陵能仁僧舍二首 其二","author":"王炎","text":"容膝非无地，安心即是家。\n焚香翻贝叶，汲水养梅花。\n无客同持酒，呼僧共煮茶。\n夜寒烧木佛，谁是老丹霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓江陵能仁僧舍二首 其一","author":"王炎","text":"客里岁月晚，春生梅柳枝。\n弟兄嗟别久，儿女话归迟。\n拙直将安用，飞腾敢自期。\n老支刚笑我，底事作痴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游水乐洞","author":"王炎","text":"路向峰腰转，泉从洞口来。\n决渠飞瀑布，伐石作崔嵬。\n胜境难频到，幽怀只暂开。\n登临兴不尽，日昃故须回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游刘寺次林子长郎中韵","author":"王炎","text":"琳琅触目聚潜郎，假日相携入酒乡。\n小凭笋舆穿野径，却寻萧寺涉脩廊。\n意行尘外襟怀爽，身坐梅边笑语香。\n头白倦游休叹息，喜迎一线日华长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游閤皂","author":"王炎","text":"灶臼依然在翠微，重重台殿锁双扉。\n可怜千载碧杉老，不见两翁黄鹤归。\n小倚脩篁飞玉子，更升虚室奏金徽。\n渺茫且置神仙事，输却清閒属羽衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游景德","author":"王炎","text":"老怯莺花笑，春残一出游。\n城隅寻古寺，柳下系扁舟。\n身健聊乘兴，心閒不著愁。\n支郎能款语，清坐小迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游稽山","author":"王炎","text":"失脚来苕霅，春风一棹还。\n寻幽探禹穴，问讯到稽山。\n意在烟霞外，身居井邑间。\n桃花应冷笑，头白不能閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘阴道中","author":"王炎","text":"道出昌江险，翩翩马足轻。\n流萍嗟远宦，行李偶南征。\n地带长沙湿，川通湘水清。\n凄凉怀屈贾，天阔莫云平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登四望亭","author":"王炎","text":"春老飞花尽，园林遍绿阴。\n凭高聊寓目，念远更伤心。\n剧郡才难称，衰年病易侵。\n不如休歇去，吾意决投簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"窗外紫竹","author":"王炎","text":"疏篱短栅外钩联，聚立龙孙已嶷然。\n向日斧斤几不赦，而今苗裔尚能全。\n少时秀色青珉润，岁晚英标紫玉坚。\n借与风烟扶直气，稍加岁月定参天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴","author":"王炎","text":"度腊殊多雨，开年亦未晴。\n地卑常础润，月堕忽霜明。\n茅舍烟犹湿，秧畴水可耕。\n幽花并细草，随意也欣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪上寻梅不遇","author":"王炎","text":"玄冬用事秃千林，蓓蕾凌寒瘦不禁。\n已唤苍头篘腊脚，未逢玉颊吐春心。\n客居避俗遨游少，老境看花感慨深。\n属付绿衣歌舞地，吹香一笑慰幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪上晚步二首 其二","author":"王炎","text":"风定留黄叶，波清涌白沙。\n前山惟道院，断岸半渔家。\n老去忘时事，閒中度岁华。\n经旬如再出，便可探梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪上晚步二首 其一","author":"王炎","text":"山静色不改，溪深流自迟。\n缓行聊寓目，小立却支颐。\n樵斧寒尤响，渔舟晚更移。\n老夫无伴侣，稚子独追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲圻道中遇雪二首 其二","author":"王炎","text":"天惨云垂地，风寒雪塞涂。\n骤看花满眼，己觉粟生肤。\n冷屋无鸣漏，冰枝有立乌。\n马寒如猬缩，行役厌驰驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲圻道中遇雪二首 其一","author":"王炎","text":"马上寒生手欲龟，田庐人静爨烟稀。\n疑逢海上双银阙，想见云中万玉妃。\n野店避风聊解辔，地炉围火自熏衣。\n劳生今被微官缚，何日衡茅独掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解官到郡诸丈置酒岳阳楼招炎为客邓巴陵索诗","author":"王炎","text":"重上危楼览洞庭，故人一笑对飞觥。\n君山只似艑山绿，江水不如湘水清。\n一日胜游成乐事，三年俗状夺诗情。\n天涯邂逅还离别，莫惜樽前底里倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬李秀才","author":"王炎","text":"系马松根倦欲休，入门解逅得诗流。\n暑天客里难行路，莫雨山间便觉秋。\n共对青灯谭世事，惜无斗酒破牢愁。\n黄花可摘吾当返，肯过桃溪一醉不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬陈叔裕四首 其四","author":"王炎","text":"天台远在浙江东，景物应曾到梦中。\n但有锦囊盛白雪，苦无罗袜舞回风。\n闭门花鸟春心薄，隐几诗书日力穷。\n益友琢磨吾岂敢，西邻仙吏有诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬陈叔裕四首 其三","author":"王炎","text":"未能筑室隐墙东，偶尔书名宦牒中。\n罗雀门空无俗物，骑鲸客至有仙风。\n刀头虽折故乡远，锥末不营生理穷。\n意欲挽君来酒国，接䍦倒著任山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬陈叔裕四首 其二","author":"王炎","text":"花枝破蕾作轻红，渐有春愁入眼中。\n傥可登楼销暇日，幸无举扇障西风。\n朱弦自奏难谐俗，白璧深藏莫丑穷。\n樽酒论文期款曲，骊驹催客陋江翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬陈叔裕四首 其一","author":"王炎","text":"扣关倒屣略从容，惊见文章豹管中。\n水阔山遥俱倦客，花明柳暗又东风。\n锦囊收拾语皆好，黄卷沉潜经可穷。\n会看卧龙腾踏去，知贤吾或似庞翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉定丁丑十二月谋葬贵孙老病不能与事但此心伤痛因成小诗以写其哀","author":"王炎","text":"念汝方青鬓，嗟予久白须。\n在亡终不免，寿夭太相殊。\n有恨心如割，无言泪陨珠。\n何堪植马鬣，玉树閟黄垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔬食","author":"王炎","text":"瓠白吾何有，人言太瘦生。\n富儿皆肉食，我辈但藜羹。\n安得万钱费，应无五鼎烹。\n饥肠雷欲吼，一饱亦何营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题大禹庙","author":"王炎","text":"夏后南巡地，登临一慨然。\n卑宫今造寺，菲饮孰名泉。\n古道知难复，人情信误传。\n不随时俗改，惟有旧山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题白蘋亭","author":"王炎","text":"得句柳刺史，筑亭颜鲁公。\n二贤虽异代，千古有遗风。\n苕水永不尽，蘋洲今半空。\n老怀多感慨，访古意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题岳阳守张仲骏浮光亭","author":"王炎","text":"三边水墨画遥山，下有玻璃万顷寒。\n蟾兔上时留倒影，鱼龙舞处动微澜。\n旧来楼观东西出，未觉乾坤表里宽。\n更向上头高著眼，湖光今作一杯看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题徐商叟参议儒荣阁","author":"王炎","text":"神皋北望几伤情，海上何人议北盟。\n青简成编裨史事，紫泥封玺奖儒荣。\n书藏金匮人争问，身到蓬山志亦亨。\n佩印累累真漫耳，婆娑林下有香名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄元静广先楼","author":"王炎","text":"闻道楼居好，翚飞百尺馀。\n箕裘能袭旧，丹雘遂如初。\n生理万钟粟，义方千卷书。\n家声将益大，车马炫门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题碧澜亭","author":"王炎","text":"一色挼蓝染碧流，翚飞恰对白蘋洲。\n风清六月非朱夏，气爽三时似素秋。\n自笑品题无翰墨，也知领略欠觥筹。\n凫鸥定怪霜髯叟，难洗胸中万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题墨妙亭","author":"王炎","text":"晋唐行草可同科，乐石雕镌便不磨。\n几载雨淋兼日炙，一朝云集又星罗。\n要知访古搜求尽，应为凝香暇逸多。\n潇洒高怀堪健羡，簿书堆案意如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠平首座","author":"王炎","text":"家在青山下，投閒岁月多。\n杜门长却扫，杖锡独经过。\n学佛非无法，哦诗恐是魔。\n愿言行古路，莫遣覆藤萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]