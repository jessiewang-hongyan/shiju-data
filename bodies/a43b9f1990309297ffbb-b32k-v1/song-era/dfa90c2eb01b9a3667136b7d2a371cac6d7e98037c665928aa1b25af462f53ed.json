[{"title":"闲行吟 其三","author":"邵雍","text":"买卜稽疑是买疑，病深何药可能医。\n梦中说梦重重妄，床上安床叠叠非。\n列子御风徒有待，夸夫逐日岂无疲。\n劳多未有收功处，踏尽人间闲路岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲行吟 其一","author":"邵雍","text":"长忆当年扫弊庐，未尝三径草荒芜。\n欲为天下屠龙手，肯读人间非圣书。\n否泰悟来知进退，乾坤见了识亲疏。\n自从会得环中意，闲气胸中一点无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲吟","author":"邵雍","text":"忽忽闲拈笔，时时乐性灵。\n何尝无对景，未始便忘情。\n句会飘然得，诗因偶尔成。\n天机难状处，一点自分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居吟","author":"邵雍","text":"闲居须是洛中居，天下闲居皆莫如。\n文物四方贤俊地，山川千古帝王都。\n绝奇花畔持芳醑，最软草间移小车。\n只有尧夫负亲旧，交亲殊不负尧夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适吟","author":"邵雍","text":"春看洛城花，秋玩天津月。\n夏披嵩岑风，冬赏龙山雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适吟五首 其三","author":"邵雍","text":"莫将真气助忧伤，愤死英豪世更长。\n陌上虽多马跳跃，天边亦有凤翱翔。\n三千宾客磨圭角，百二山河拥剑铓。\n等是一场春梦过，自馀恶足自悲凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之少卿六老诗仍见率成七首 其三","author":"邵雍","text":"六翁谁让少年场，老不羞人任意狂。\n同向静中观物动，共于闲处看人忙。\n天心月满蟾蜍动，水面风微菡萏香。\n肯信人间有忧事，新醅正熟景初凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和张元伯职方岁除","author":"邵雍","text":"及正四十六，老去耻无才。\n残腊方回律，新春又起灰。\n非唯忘利禄，况复外形骸。\n白发已过半，光阴任自催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和淮南宪张司封","author":"邵雍","text":"庭梧叶半黄，篱菊初受霜。\n向晚意不快，把酒西南望。\n望君不见君，但见鸿南翔。\n正欲思寄书，自成书数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人语道吟","author":"邵雍","text":"吾道昭昭是可尊，岂宜他适复□□。\n珠藏水底川须媚，月到天心夜不昏。\n礼乐不□□□□，诗书自可造形论。\n直须去尽秋毫迹，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和云","author":"邵雍","text":"万里幕四垂，一片云自飞。\n秪知根抱石，不为天为衣。\n既来曾无心，却去宁有机。\n未能作霖雨，安用帝乡归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安之小园五题","author":"邵雍","text":"小园新葺不离家，高就岗头低就窊。\n洛邑地疑偏得胜，天津人至又非赊。\n宜将阆苑同时语，莫共桃源一道誇。\n闻说一轩多种药，只应犹欠紫河车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和北京王郎中见访留诗","author":"邵雍","text":"车从赏春来北京，耿君先期已驰情。\n此时殒霜奈何重，今岁花开徒有声。\n既辱佳章仍坠刺，宁无累句代通名。\n天之才美应自惜，料得不为时虚生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邢和叔学士见别","author":"邵雍","text":"世路如何若大东，相逢不待语言通。\n观君自比诸葛亮，顾我殊非黄石公。\n讲道污隆无巨细，语时兴替有初终。\n出人才业尤须惜，慎勿轻为西晋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和君实端明洛阳看花 其三","author":"邵雍","text":"洛阳交友皆奇杰，递赏名园只似家。\n却笑孟郊穷不惯，一日看尽长安花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和君实端明洛阳看花 其一","author":"邵雍","text":"洛阳最得中和气，一草一木皆入看。\n饮水也须无限乐，况能时复举杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张子望洛城观花","author":"邵雍","text":"造化从来不负人，万般红紫见天真。\n满城车马空撩乱，未必逢春便得春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陕令张师柔石柱村诗","author":"邵雍","text":"君为陕县令，我实康公孙。\n始祖有遗烈，托君访其存。\n夫君有诗来，题云石柱村。\n石柱之始立，于古无所根。\n就勒分陕铭，惟唐人之言。\n既历年所多，首尾无完文。\n难以从考正，将焉求其源。\n我患读书寡，知识无过人。\n经书史传外，不能破群昏。\n从长卿公羊，宜自陕而分。\n从君陈毕命，宜成周而云。\n二者兼取之，于义似或尊。\n分政东西郊，可以陕洛论。\n此说如近之，庶几缓纷纭。\n甘棠之蔽芾，石柱之青新。\n当时之盛事，予不得而亲。\n二南之正化，二公之清芬。\n千载之美谈，予可得而闻。\n弃经而任传，儒者固不遵。\n作诗以明之，驰此庸报君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和秋夜","author":"邵雍","text":"久畏夏暑日，喜逢秋夜天。\n急雨过脩竹，凉风摇晚莲。\n岂谓败莎蛩，能继衰柳蝉。\n安得九皋禽，清唳一洒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和貂褥筇杖二物皆范景仁所惠","author":"邵雍","text":"君子亦保物，保故不保新。\n筇生蜀部石，貂走阴山尘。\n善扶巇崄路，能暖瘦羸身。\n行坐不可舍，常如睹斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垂柳长吟","author":"邵雍","text":"垂柳有两种，有长有短垂。\n唯兹长一种，偏与静相宜。\n院宇深春后，亭台晚景时。\n不胜烟羃羃，无奈日迟迟。\n霢霂雨初过，清泠风乍吹。\n章台街左右，华表柱东西。\n起眼出墙树，拂头当路枝。\n翩翻绿罗带，缥缈缕金衣。\n荡飏飘晴絮，缤纷舞暖丝。\n丝牵寸肠断，絮入万家飞。\n婀娜王恭韵，婆娑赵后姿。\n脩妍张绪少，柔软沈侯羸。\n濯濯青拖地，毵毵翠绕池。\n般添花灼灼，引惹草萋萋。\n郁郁笼山馆，疏疏映酒旗。\n赠人人自泣，驻马马还嘶。\n影里咿哑去，阴中轣辘归。\n凄凉装暝霭，淡薄挂斜晖。\n懊恼轻攀折，忧愁重别离。\n早衰缘傍道，先茂为临溪。\n楼外蝉才噪，桥边莺又啼。\n生憎遮望眼，死恨学妆眉。\n远客莫知数，长条曾系谁。\n经霜尽憔悴，来岁却依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垂柳短吟","author":"邵雍","text":"临溪拂水正依依，更被狂风来往吹。\n薄暮不胜烟羃羃，深春无奈日迟迟。\n谁家缥缈青罗帔，何处蹁跹金缕衣。\n犹恐离人肠未断，满天仍着乱花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"学佛吟","author":"邵雍","text":"饱食丰衣不易过，日长时节奈愁何。\n求名少日投宣圣，怕死老年亲释迦。\n妄欲断缘缘愈重，徼求去病病还多。\n长江一片常如练，幸自无风又起波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"所失吟","author":"邵雍","text":"所失弥多所得微，中间赢得一歔欷。\n人荣人悴乃常理，花谢花开何足追。\n偶尔相逢却相别，乍然同喜又同悲。\n只消照破都无事，何必区区更辩为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"担折","author":"邵雍","text":"禹士力生头，都知闲做弄。\n直待担子折，恁待柴束重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下五吟 其一","author":"邵雍","text":"真工造化岂容私，拙者为谋亦甚微。\n安乐窝深初起后，太和汤酽半醺时。\n长年国里篮舁往，永熟乡中杖策归。\n身似升平无一事，数茎髭白任风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下吟","author":"邵雍","text":"林下一般奇，俗人那得知。\n乍圆明月夜，才放好花枝。\n美酒未斟满，佳宾莫放归。\n世间优我辈，幸有这些儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下局事吟","author":"邵雍","text":"闲人亦也有官守，官守一身四事有。\n一事承晓露看花，一事迎晚风观柳。\n一事对皓月吟诗，一事留佳宾饮酒。\n从事于兹二十年，欲求同列谁能否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治乱吟五首 其五","author":"邵雍","text":"天能生而不能养，地能养而不能生。\n火能烹而不能沃，水能沃而不能烹。\n天地尚犹无全功，水火何由有全能。\n得用二者交相养，反为二者交相凌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治乱吟五首 其三","author":"邵雍","text":"精义入神以致用，利用出入之谓神。\n神无方而易无体，藏诸用而显诸仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治乱吟五首 其二","author":"邵雍","text":"中原一片闲田地，曾示三皇与五帝。\n三皇五帝子孙多，或贱或贫或富贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知识吟","author":"邵雍","text":"目见之谓识，耳闻之谓知。\n奈何知与识，天下亦常稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知幸吟","author":"邵雍","text":"鸡职在司晨，犬职在守禦。\n二者皆有功，一归于报主。\n我饥亦享食，我寒亦受衣。\n如何无纤毫，功德补于时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知非吟","author":"邵雍","text":"今日已前事，知非心可凭。\n虚言安足道，实行又何矜。\n无药医衰老，有诗歌圣明。\n纵然时饮酒，未肯学刘伶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗画吟","author":"邵雍","text":"画笔善状物，长于运丹青。\n丹青入巧思，万物无遁形。\n诗画善状物，长于运丹诚。\n丹诚入秀句，万物无遁情。\n诗者人之志，言者心之声。\n志因言以发，声因律而成。\n多识于鸟兽，岂止毛与翎。\n多识于草木，岂止枝与茎。\n不有风雅颂，何由知功名。\n不有赋比兴，何由知废兴。\n观朝廷盛事，壮社稷威灵。\n有汤武缔构，无幽厉欹倾。\n知得之艰难，肯失之骄矜。\n去巨蠹奸邪，进不世贤能。\n择阴阳粹美，索天地精英。\n籍江山清润，揭日月光荣。\n收之为民极，著之为国经。\n播之于金石，奏之于大庭。\n感之以人心，告之以神明。\n人神之胥悦，此所谓和羹。\n既有虞舜歌，岂无皋陶赓。\n既有仲尼删，岂无季札听。\n必欲乐天下，舍诗安足凭。\n得吾之绪馀，自可致升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗史吟","author":"邵雍","text":"史笔善记事，长于炫其文。\n文胜则实丧，徒憎口云云。\n诗史善记事，长于造其真。\n真胜则华去，非如目纷纷。\n天下非一事，天下非一人。\n天下非一物，天下非一身。\n皇王帝伯时，其人长如存。\n百千万亿年，其事长如新。\n可以辩庶政，可以齐黎民。\n可以述祖考，可以训子孙。\n可以尊万乘，可以严三军。\n可以进讽谏，可以扬功勋。\n可以移风俗，可以厚人伦。\n可以美教化，可以和疏亲。\n可以正夫妇，可以明君臣。\n可以赞天地，可以感鬼神。\n规人何切切，诲人何谆谆。\n送人何恋恋，赠人何勤勤。\n无岁无嘉节，无月无嘉辰。\n无时无嘉景，无日无嘉宾。\n樽中有美禄，坐上无妖氛。\n胸中有美物，心上无埃尘。\n忍不用大笔，书字如车轮。\n三千有馀首，布为天下春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗酒吟","author":"邵雍","text":"圣人难处口能宣，何止千年与万年。\n心静始能知白日，眼明方会看青天。\n鬼神情状将诗写，造化功夫用酒传。\n传写不干诗酒事，若无诗酒又难言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诚明吟","author":"邵雍","text":"孔子生知非假习，孟轲先觉亦须脩。\n诚明本属吾家事，自是今人好外求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"责己吟","author":"邵雍","text":"不为十分人，不责十分事。\n既为十分人，须责十分是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金玉吟","author":"邵雍","text":"良金美玉信难偕，好物其来最受埋。\n盗蹠免兵非积善，仲尼无土反成猜。\n中孚既若须为信，无妄因何却有灾。\n莫若致之为外事，心源可乐是昭回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"举酒吟","author":"邵雍","text":"闲与宾朋饮酒杯，杯中长似有花开。\n清谈才向口中出，和气已从心上来。\n物外意非由象得，坐间春不自天回。\n施之天下能如此，天下何忧不放怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园南晚步思亡弟","author":"邵雍","text":"南园之南草如茵，迎风晚步清无尘。\n不得与尔同欢欣，又疑天上有飞云。\n一片世间来作人，飘来飘去殊无因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"待物吟","author":"邵雍","text":"待物莫如诚，诚真天下行。\n物情无远近，天道自分明。\n义理须宜顾，才能不用矜。\n世间闲缘饰，到了是虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四义吟","author":"邵雍","text":"小人固无知，唯以利为视。\n君子固不欺，见得还思义。\n思义不顾死，见利或忘生。\n二者之所起，平之与不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思山吟 其一","author":"邵雍","text":"看即青山与白云，寻思没量大功勋。\n未知乐处缘何事，岂止饥时会茹荤。\n千首拙诗难著怨，一樽芳醑别涵春。\n壶中日月长多少，能老红尘几辈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思山吟 其二","author":"邵雍","text":"秪恐身闲心未闲，心闲何必住云山。\n果然得手情性上，更肯埋头利害间。\n动止未尝防忌讳，语言何复著机关。\n不图为乐至于此，天马无踪自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思郑州陈知默因感其化去不得一识面","author":"邵雍","text":"美物须绝代，异人须不世。\n造化生得成，谅亦非容易。\n旷世耳可闻，同时目能视。\n陈子同时人，奈何闻诸耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思程氏父子兄弟因以寄之 其二","author":"邵雍","text":"气候如当日，山川似旧时。\n独来还独往，此意有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恍惚吟","author":"邵雍","text":"恍惚阴阳初变化，氤氲天地乍回旋。\n中间些子好光景，安得功夫入语言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"战国吟","author":"邵雍","text":"七国之时尚战争，威强知诈一齐行。\n廉颇白起善用兵，苏秦张仪善纵横。\n朝为布衣暮公卿，昨日鼎食今鼎烹。\n范雎谢相何心情，蔡泽入秦何依凭。\n始皇奋袂天下宁，二世乞为氓不能。\n三千宾客愤未平，百二山河汉已兴。\n所存旧物惟空名，残阳衰草山川形。\n都似一场春梦过，自馀恶足语威狞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故连昌宫","author":"邵雍","text":"洛水来西南，昌水来西北。\n二水合流处，宫墙有遗壁。\n行人徒想像，往事皆陈迹。\n空馀女几山，正对三乡驿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春去吟","author":"邵雍","text":"春去休惊晚，夏来还喜初。\n残芳虽有在，得似绿阴无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春去吟","author":"邵雍","text":"好物足艰难，都来数日间。\n既为风搅挠，又被雨摧残。\n富贵醉初醒，神仙梦乍还。\n游人不知止，依旧倚朱栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴 其二","author":"邵雍","text":"花好难久观，月好难久看。\n花能五七日，月止十二圆。\n圆时仍龃龉，开处足摧残。\n风雨寻常事，人心何不安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春吟 其一","author":"邵雍","text":"花开春正好，花谢春还暮。\n不意子规禽，犹能道归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春吟 其二","author":"邵雍","text":"春来蝴蝶乱，春去子规啼。\n安得如前日，和风初扇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春吟 其三","author":"邵雍","text":"禽不通人情，唯知春已暮。\n亦或叫提壶，亦或叫归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼睡","author":"邵雍","text":"昼睡功夫未易偕，羲皇以上合安排。\n心间无事饱食后，园里有时闲步回。\n未午庭柯莺屡啭，已残花径客稀来。\n请观世上多愁者，枕簟虽凉无此怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉布吟","author":"邵雍","text":"名为泉布者，无足走人间。\n善发难言口，能开不笑颜。\n偿逋小续命，赒急大还丹。\n唯有商山老，非干买得闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洗心吟","author":"邵雍","text":"人多求洗身，殊不求洗心。\n洗身去尘垢，洗心去邪淫。\n尘垢用水洗，邪淫非能淋。\n必欲去心垢，须弹无弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洛阳春吟 其三","author":"邵雍","text":"桃李花开人不窥，花时须是牡丹时。\n牡丹花发酒增价，夜半游人犹未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐吟 其一","author":"邵雍","text":"天告自丁宁，人多不肯听。\n四时皆有景，万物岂无情。\n祸福眼前事，是非身后名。\n谁能事闲气，浪与世人争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独赏牡丹","author":"邵雍","text":"赏花全易识花难，善识花人独倚栏。\n雨露功中观造化，神仙品里定容颜。\n寻常止可言时尚，奇绝方名出世间。\n赋分也须知不浅，算来消得一生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇极经世一元吟","author":"邵雍","text":"天地如盖轸，覆载何高极。\n日月如磨蚁，往来无休息。\n上下之岁年，其数难窥测。\n且以一元言，其理尚可识。\n一十有二万，九千馀六百。\n中间三千年，迄今之陈迹。\n治乱与废兴，著见于方策。\n吾能一贯之，皆如身所历。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]