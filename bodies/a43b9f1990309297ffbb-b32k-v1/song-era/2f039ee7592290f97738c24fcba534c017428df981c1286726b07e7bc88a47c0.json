[{"title":"春晚","author":"林尚仁","text":"春事又无几，阴晴苦不齐。\n久贫交味薄，多病语声低。\n落絮行风径，归云度晚溪。\n故乡二千里，日夜子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日书怀","author":"林尚仁","text":"十年客路叹飘蓬，历尽风霜鬓欲空。\n睡少半疑茶作祟，愁多全觉酒无功。\n数蛩厌静鸣秋雨，一叶惊寒落晚风。\n惆怅故园归未得，草荒篱下菊花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺陈石泉宰华亭归","author":"林尚仁","text":"天下称繁邑，一廉如此希。\n政成人惜去，官满鹤先归。\n家学传金管，春风入紫薇。\n知音正当路，健翼看高飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人别","author":"林尚仁","text":"此心偶无事，君复叙离情。\n江国多寒色，春风几日程。\n雪添行李重，船逐浪花轻。\n后夜应相忆，空山月正明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨巨川游边","author":"林尚仁","text":"此行不必话离愁，且举匏樽醉几筹。\n天下岂无山可买，男儿当与国分忧。\n剑辞星匣边风凛，船驾云帆海月流。\n莫道读书无用处，读书方有用兵谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林云岫归省","author":"林尚仁","text":"西风吹客衣，束担出王畿。\n千里莫嫌远，几人犹未归。\n山空秋鹤瘦，天阔暮云飞。\n料得还家日，将诗寿綵闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅怀","author":"林尚仁","text":"欲暮西风引客愁，十年如梦住他州。\n故交零落谁知己，往事凄凉叹白头。\n一纸音书灯下泪，满城砧杵月明秋。\n早知世路风波险，只在山中煮石休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄乡友","author":"林尚仁","text":"此身拘不得，暮楚又朝吴。\n故国几人在，三年一字无。\n天风潮信急，江月雁声孤。\n久不看明镜，年来有白须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄西湖友人","author":"林尚仁","text":"湖边春更好，别后费吟思。\n载酒曾游处，忆君同醉时。\n面风花落易，背日雪消迟。\n早晚携琴去，山中与鹤期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴宗之","author":"林尚仁","text":"在家犹苦热，客路足应疲。\n书剑果何地，江湖非旧时。\n久晴苗欲雨，多病药如饴。\n忆自分携后，知心更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄表兄郑古潭","author":"林尚仁","text":"江湖风浪恶，飘泊此依依。\n白发亲俱老，深春人未归。\n云留行李住，风遣落花飞。\n强饮杯中物，芳心莫易违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅雨","author":"林尚仁","text":"繁声不可听，点滴似秋霖。\n溪长欲无岸，窗低微复阴。\n葛衣凉意重，础石润痕深。\n欲出愁泥泞，依依独客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清真观","author":"林尚仁","text":"一宫占断水中央，瘦竹添丁护短墙。\n老鹳声中松子落，游鱼影里藕花香。\n云房不雨琴常润，池阁无风榻自凉。\n拟办隐心终老此，便须归与鹤商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜友人为僧","author":"林尚仁","text":"身披云衲瘦伶俜，一刺新添得寺名。\n餐供未便趺足坐，诵经犹作读书声。\n禅窗欲晚闻钟掩，吟履逢秋踏叶行。\n应是千生修得到，几人头白尚无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜即事","author":"林尚仁","text":"吟苦过于颠，吟成亦自怜。\n冻油灯影薄，深屋语声圆。\n分月照归客，避寒移卧毡。\n一冬少闲日，不得到梅边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓华亭下砂盐场","author":"林尚仁","text":"地僻民居少，官勤国课优。\n远程驱瘦马，小港碍行舟。\n晴日盐花晓，风潮海气秋。\n野人因买鹤，半月此迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游阳明洞天","author":"林尚仁","text":"每个虚亭坐片时，旋寻古迹上岩梯。\n石含秋色苔痕老，洞接云天树影低。\n樵客出林惊虎啸，道人临水听猿啼。\n吟边欲记阳明事，恐动山灵不敢题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新昌道中","author":"林尚仁","text":"春红落尽雨霏霏，为怯轻寒尚夹衣。\n村路每于泥处滑，乡音渐与市人非。\n护蚕溪女条桑去，抱布山翁换米归。\n世味遍尝只如此，几番清梦落渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤","author":"林尚仁","text":"楚楚异凡禽，相看瘦不禁。\n饥寻芝朮晚，梦忆海山深。\n华表千年事，青天万里心。\n一声唳清夜，霜月满疏林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠许紒岩","author":"林尚仁","text":"年齿未三十，清名已照人。\n才高犹苦学，俸薄不言贫。\n留客醉终日，爱花吟过春。\n自怜闲未得，满面扑京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠褚雪巘","author":"林尚仁","text":"多年林下隐，犹带旧儒酸。\n自说因诗苦，还如学易难。\n晓窗花气润，夜枕雨声寒。\n又欲名山去，应寻胜迹看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒里","author":"林尚仁","text":"閒里身心得自如，春风茅屋燕同居。\n松花满地溪云滑，一榻晴窗卧看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮药房陈户山居分韵得閤字","author":"林尚仁","text":"常人厌寂寥，隐士畏喧杂。\n山居主人百好无，终日哦诗闭书閤。\n我本山中人，心事亦颇合。\n杖藜约客行幽深，来扣吟扉坐陈榻。\n不叙寒暄说晚唐，满座春风屡倾榼。\n霜晴沙路软如泥，谷鸟相呼声自答。\n花时不饮空白头，世味由来如嚼蜡。\n祇怜无梦化作蝴蝶飞，绕尽百花深处日千匝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冰玉堂","author":"林庚","text":"柳凹放出一山来，堂闯秋壶恰剪裁。\n门冷和他公事少，吟清添我宦情灰。\n非无景物皆天与，只许梅花带雪开。\n泉石相辉忻自赏，不知省得几尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东山高卧","author":"林放","text":"三间老屋青山幽，清风洒洒寒飕飕。\n脱巾坦腹卧其下，此身直与渊明俦。\n老松飞翠落夏簟，六月不暑凉于秋。\n人生百年一梦幻，世间万事空悠悠。\n一声野鹤忽惊醒，山炉活火茶烟浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠琴僧","author":"林放","text":"霜林凋落云影垂，朔风猎猎鼓寒威。\n偶来禅房访虚寂，上人为我弹金徽。\n此调悠悠泯千载，今日忽闻一嗟咨。\n上人所弹不在指，我亦非于耳听之。\n霜天玉磬敲清晓，夜月秋声动翠微。\n举世纷纷爱筝筑，寂寥古意谁能知。\n过门不是钟期子，慎勿汗漫调朱丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中春晓","author":"林昉","text":"婆饼焦啼晓户开，冷东风里惜残梅。\n片云祇傍檐头宿，昨夜何山作雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖","author":"林昉","text":"小舫撑春花浪香，第三桥底弄晴光。\n吟边飞起轻鸥片，十里天风舞绿杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜笛","author":"林昉","text":"夜寒孤笛水边楼，忆著西风古塞头。\n一曲落梅吹得苦，吹人不管听人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中过周氏山庄","author":"林昉","text":"吠犬柴门扣未开，满身风雨立苍苔。\n翠禽一个高枝上，啄得残桃落地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南屏山画猿","author":"林昉","text":"古木悬藤臂半钩，何年影落此山秋。\n三声远忆巴江月，夜半孤舟起客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻子规 其一","author":"林昉","text":"飞到一枝上，须啼三五声。\n烟中犹彷佛，月下最分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻子规 其二","author":"林昉","text":"积泪消春色，好花思锦城。\n贵人难入耳，祇是恼羁情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"林昉","text":"衡门客去懒冠巾，尽日看山自在身。\n饮涧猿来惊照影，泊枝禽起近冲人。\n黑云欲雨易成晚，红叶如花不当春。\n却忆东门牵犬恨，当年何似布衣贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古碑","author":"林昉","text":"文残字磨灭，往事记何人。\n抛在空林下，正当荒墓林。\n夕阳斜见影，古藓厚生鳞。\n不是逢狂客，谁来与拂尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同郑鲁望听杜鹃","author":"林昉","text":"每到桃花发，山鹃叫得频。\n今年同听处，吴下未归人。\n客泪滴残月，物情愁暮春。\n胥江有清水，聊与濯衣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老树","author":"林昉","text":"元是谁人种，枯残此涧东。\n半身虚映水，一叶尚摇风。\n著雨禽初散，当暄蚁欲空。\n年时浓绿影，何处夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访隐者","author":"林昉","text":"晓入南山路，松风最好听。\n候扉黄犬睡，寻食老鸦灵。\n童子炊方熟，先生醉未醒。\n借来一榻坐，看尽相牛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迁居","author":"林昉","text":"破帽老骑驴，霜风落木初。\n江湖难独立，贫病又迁居。\n楚客旧留剑，岳僧秋寄书。\n草玄吾不解，空愧子云庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊越浦","author":"林昉","text":"老树津亭缆客舟，芙蕖香歇蓼花抽。\n越山只作古时翠，胥水半随人事流。\n别港雁声天有月，断桥渔火夜分秋。\n翻然自笑芒鞋脚，十载风波走几州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春归","author":"林昉","text":"南北春归有许忙，一晴轻策度林塘。\n柳摇别岸东风瘦，花落断桥流水香。\n老去客游空剑气，日来心事只诗囊。\n幽情一点云天远，独鸟无声飞夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓","author":"林昉","text":"薄衣初试晓寒轻，云阁残阴雨弄晴。\n落去好花微有恨，生来野草半无名。\n丹心爱国劳难破，白发欺人镊又生。\n瘦绕石栏三十匝，绿杨何处脆莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋戍","author":"林昉","text":"军头夜点名，新戍起秋程。\n月色黄弓甲，风沙黑渭城。\n断笳清泪满，落叶此生轻。\n努力供王事，归来享太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之湘阴谒知己","author":"林昉","text":"一声歌未断，江动欲潮生。\n是月寒露下，故人湘水行。\n沙云晴见雁，船火夜闻筝。\n谢令应相喜，先期发吏迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送西秦张仲实游大涤洞天","author":"林昉","text":"此时仙兴发，九锁访名峰。\n玉洞昼飞鼠，石池春浴龙。\n异人花外见，道士酒边逢。\n余欲采芳茗，白云何所从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送秀才归南海","author":"林昉","text":"归路番禺远，蛮乡岛屿经。\n天黄春有瘴，海黑夜无星。\n北帖船中看，南歌枕上听。\n遥知到家日，蜩响荔枝青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病目","author":"林昉","text":"病目两旬馀，深斋只另居。\n客知多寄药，妻劝少看书。\n畏热灯羞近，贪凉发屡梳。\n平生心喜菊，因此剩栽锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登龙山塔寺","author":"林昉","text":"吴越夕阳多远山，塔楼高处九秋寒。\n江豚吹浪腥风湿，野鸟行空翥雪乾。\n白日潮声僧老尽，黄埃世路客游难。\n海门航散孤云落，酒醒不堪深倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓬门","author":"林昉","text":"新笋绿沿坡，蓬门谁见过。\n社寒来燕少，晚雨落花多。\n瘦骨诗医俗，衰容酒借和。\n故园空有梦，客路正风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题所寓壁","author":"林昉","text":"世路机关险似棋，未逢好著费支持。\n但能不作亏心事，何往非吾得意时。\n草著雨馀青转耐，发因闲里白偏迟。\n一湖水影群山聚，朝暮相看消几诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾生古剑","author":"林昉","text":"三尺非凡铁，年深铸字漫。\n每寻闲处挂，不敢醉时看。\n紫电光犹湿，苍蛟血未乾。\n边秋方用武，莫恨致身难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别","author":"林昉","text":"傍桥买得小溪船，略举离杯去意悬。\n一水夕阳红荡影，数峰晴树碧生烟。\n秋声不断云间雁，别恨空长柳外蝉。\n后夜他州看明月，定知相忆未成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古冢行","author":"林昉","text":"山前月照青杉树，下有古人葬时路。\n古人葬时多子孙，今日子孙无问处。\n花开花谢年复年，新坟渐满古坟边。\n犹起高楼与大屋，长为子孙忧不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答黎教授 其二","author":"林昉","text":"共坐栏边日欲斜，更将金蕊泛流霞。\n欲知却老延龄药，百草枯时始见花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题所寓壁","author":"林昉","text":"鹿群上遥岑，云影抵苍壁。\n无客来敲门，倚松读周易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张高士","author":"林昉","text":"短发蓬蓬戴小冠，客来欢喜爱供看。\n鹤孙夜养翎犹湿，童子南归语尚蛮。\n击磬花边禽醒悟，持经窗下竹平安。\n自言薄有耕桑地，无事干人不出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王仙君坛","author":"林杰","text":"羽客已登云路去，丹砂草木尽凋残。\n不知千岁归何日，空使时人扫旧坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂诗 其一","author":"林泳","text":"落日吟诗望戍楼，烟花空忆古扬州。\n开明桥下千家市，但见朝朝挂髑髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂诗 其三","author":"林泳","text":"雄勇将军赴上流，三千选士一时休。\n营中妇女支官料，犹道儿郎在鄂州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州杂诗 其二","author":"林泳","text":"角声吹月上城头，薄酒千杯不疗愁。\n要觅当年杜书记，栀灯数朵竹西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其七","author":"林泳","text":"一念重来如祖忍，三生尽见有图澄。\n虎虽化女心常在，鹰已为鸠眼可憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其三","author":"林泳","text":"坏事曾闻嗔怪鬼，捉囚可不畏天公。\n抚床卫瓘宁非醉，对策刘蕡恐是风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其八","author":"林泳","text":"身无用处法当隐，诗要工时例是穷。\n东海校书称钓客，香山学士作渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其四","author":"林泳","text":"仙掌承来求大药，法身赎得费千金。\n两宗曾误国家事，百世谁明佛老心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其二","author":"林泳","text":"弃稿谩浮瓢里去，爱诗曾入藏中来。\n护持不信无神物，磨灭应难入劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其十","author":"林泳","text":"人生作计蛇添足，世事难知卵有毛。\n养得元身差快乐，具他法眼始孤高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其九","author":"林泳","text":"俗交毋惜三分话，道眼须看上一层。\n太傅莫疑高屐客，都官休厌紫衣僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其五","author":"林泳","text":"兴亡岂料秦为晋，广莫宁知魏有梁。\n万岁是非同变灭，四维上下可思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其六","author":"林泳","text":"恨无短剑乘风去，纵有长绳奈日何。\n谩说千年归鹤表，最怜九代入鸡窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂述 其一","author":"林泳","text":"号谪仙人太白老，称村夫子少陵诗。\n眼花贺监犹差黠，气性杨公却自痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论诗绝句依老人韵 其一","author":"林泳","text":"删后纷纷竞长雄，诗家妙处几家同。\n门前荒草深三尺，老艾当年说国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论诗绝句依老人韵 其二","author":"林泳","text":"风骚一脉苦难知，媲白抽黄世不疑。\n沈谢诸人声律起，千年无复性情诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]