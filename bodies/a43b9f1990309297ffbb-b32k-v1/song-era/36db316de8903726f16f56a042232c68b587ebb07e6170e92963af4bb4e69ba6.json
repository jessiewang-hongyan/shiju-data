[{"title":"戚夫人","author":"李觏","text":"百子池头一曲春，君恩和泪落埃尘。\n当时应恨秦皇帝，不杀南山皓首人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梁帝","author":"李觏","text":"凝旒南面总虚名，庙祀何曾暂割牲。\n但学禅心能忍辱，莫羞侯景陷台城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中见梅花二首 其二","author":"李觏","text":"数枝斜出短墙阴，密雪无端苦见侵。\n天意似怜群木妒，尽教枯朽作瑶林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中见梅花二首 其一","author":"李觏","text":"品物由来貌取难，共言花卉易凋残。\n宁知姑射冰肌侣，也学松筠耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中赠柳枝","author":"李觏","text":"暖气来时柳眼新，一场冰雪更愁人。\n要知真宰无诚信，取次东风未是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麻源题壁","author":"李觏","text":"一到麻源日又曛，几回欲起却逡巡。\n世间岂是无山水，不奈閒人好聒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景阳宫井","author":"李觏","text":"以色从人自古然，幸逢圣主得称贤。\n太王姜女来岐下，应不相将堕井泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游寺醉归却寄同坐","author":"李觏","text":"江村古寺偶閒行，一饮全疑酒有灵。\n水底屈原应大笑，我今独醉众人醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登越山","author":"李觏","text":"腊后梅花破碎香，望中情地转凄凉。\n游山只道寻高处，高处何曾见故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葛陂怀古","author":"李觏","text":"长房化去已千年，鬼魅纷纷不畏天。\n老鳖若来为太守，何人杀向葛陂边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢传神平上人","author":"李觏","text":"蕞陋徒烦妙笔传，呼儿看了独凄然。\n丹青不解随人老，相似都来得几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢知县徐殿丞示及新诗","author":"李觏","text":"当时子贱好援琴，千载谁传治世音。\n珍重南城多暇日，尽将风化入清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡思","author":"李觏","text":"睡魔气势重千钧，压倒心閒食饱人。\n莫笑坐间常似醉，当年满腹是精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起","author":"李觏","text":"簟卷鳞纹帐系纱，六龙西降树阴斜。\n秪应梦里成胡蝶，犹记南园数种花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣兴","author":"李觏","text":"境入东南处处清，不因辞客不传名。\n屈平岂要江山助，却是江山遇屈平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧志月碧云轩改为景云轩因书二首 其二","author":"李觏","text":"景云持律冠当年，遗迹虽沈古寺存。\n释子若能精进去，便应题作景云轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧志月碧云轩改为景云轩因书二首 其一","author":"李觏","text":"长见江淹杂体诗，碧云非是惠休词。\n试言日暮佳人怨，何事高僧却得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲汉武","author":"李觏","text":"甲帐居神本妄言，露盘犹在国东迁。\n欲知千载金人泪，为耻君王不得仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"儒行","author":"李觏","text":"一死相从患难时，何人能与古人齐。\n郦生泉下还知否，卖友而今价转低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕雀 其二","author":"李觏","text":"绣户珠帘见最频，暖来寒去但安身。\n翟公门下时飞入，全胜交情斗顿人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕雀 其一","author":"李觏","text":"燕子从来巧语声，主人相爱是常情。\n黄头老雀何能解，饱食官仓过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠日者邹生","author":"李觏","text":"贤不必通愚不穷，悠悠无处问苍穹。\n可怜富贵君之柄，断在山人指掌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜","author":"李觏","text":"夜落无人见，朝看到处新。\n非君有分别，力不柰松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"璧月","author":"李觏","text":"璧月迢迢出暮山，素娥心事问应难。\n世间最解悲圆缺，秪有方诸泪不乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"李觏","text":"天孙何许是来时，月意愔愔露气微。\n可道星河难得过，自缘乌鹊合高飞。\n秋宵已胜春宵短，今会还如古会稀。\n早晚望夫能化石，尽分人世作支机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书寄祖龙图","author":"邵雍","text":"三十年交旧，相逢各白头。\n海壖曾共饮，洛社又同游。\n脱屣风波地，开怀松桂秋。\n两眉从此后，应不著闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千福寺昧轩","author":"李觏","text":"何人指蒙昧，题作此轩名。\n天理自昼夜，道心无晦明。\n用当群物化，舍去一毛轻。\n磊磊山前寺，时闻钟磬声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小女","author":"李觏","text":"惜汝今何恃，言来泪满襟。\n死生虽分定，襁褓累人心。\n饥买邻家乳，寒劳祖母针。\n岂知泉路隔，时拨穗帷寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小雨","author":"李觏","text":"已是蛟龙未肯忙，谁教螮蝀更相妨。\n来时槁叶疏疏响，过后浮云片片光。\n径草微滋垂粉汗，砌沙圆滴簇蜂房。\n嗟予不及高飞鸟，先得天边几点凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山舍寓止","author":"李觏","text":"无计奈疏拙，走逃云水隈。\n鹤饥虽厌夜，龙睡却嫌雷。\n师友关千古，穷通付一杯。\n商岩版筑者，底处有梯媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐","author":"李觏","text":"四壁空空绝语声，困来终是睡难成。\n孤灯要与人相背，寒漏苦教天不明。\n累月故园无信息，几般閒事恼心情。\n别愁若解生华发，一夕应添一万茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀寄介夫","author":"李觏","text":"弃材幸免杂舆薪，收拾缁衣出洛尘。\n渐老得閒才是性，谩言成谑且随人。\n能传身后须文字，要识胸中只鬼神。\n俗子不劳轻毁誉，问天长乞醉乡春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书松陵唱和","author":"李觏","text":"天命相逢陆与皮，当年才调两权奇。\n朝端未有输忠处，诗外应无用力时。\n意古直摩轩昊顶，言微都泄鬼神私。\n近来此道中兴也，泉下英魂知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书麻姑庙","author":"李觏","text":"流俗好仙方学道，至人乐道自成仙。\n飞升若也由贪欲，紫府还应用诈权。\n尘里笙歌千古梦，洞中星斗几家天。\n无心便是归真日，姹女河车总谩传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五龙塘","author":"李觏","text":"世传鳞物有蟠时，分得寒泉住翠微。\n天命虽教为润泽，神心终是索虔祈。\n一围石岸刓无迹，几族阴云禁不飞。\n风脚斗回波面黑，向人浑似逞严威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太平州十咏亭","author":"李觏","text":"客游无日暂开颜，姑孰溪边偶得閒。\n风景直疑图画出，古今都似梦魂间。\n桓温罪逆休重问，谢傅英灵已不还。\n深美谪仙遗世务，酒船椎鼓浪如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙子冬至夜酒醒","author":"李觏","text":"尽道一阳初复时，不期风雨更凄凄。\n凌辰出去逢人饮，沈醉归来满马泥。\n多恨恐成干斗气，欲言那得上天梯。\n灯青火冷睡半醒，残叶打窗乌夜啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东岩精舍","author":"李觏","text":"像设彼何时，高僧白衲衣。\n水寒吞日气，树老惯霜威。\n幡影捎天近，钟声落谷微。\n可怜成道易，无事即无机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖","author":"李觏","text":"古郡城池已瞰江，重湖更在郡东方。\n水仙坐下鱼鳞赤，龙女门前橘树香。\n路绝尘埃非洒扫，地无风雨亦清凉。\n使君待客多娱乐，只有醒时觉异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书答陈次公","author":"李觏","text":"咄咄休休一世閒，百年都是浪悲欢。\n高谈不待傍人笑，立事须知自古难。\n时见老颜来鉴里，已将生计托云端。\n六鳌未可挥刀斫，肯便临溪把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"关徐","author":"李觏","text":"云长不绝旧君情，元直终随老母行。\n立效报公何感慨，指心辞主更分明。\n三方本以兵攻战，一士能为国重轻。\n多谢曹刘存大度，任教忠孝得成名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送阎判官","author":"李觏","text":"乡树江淮接，军筹岁月深。\n从公虽尽力，当路少知音。\n赋命休重问，离觞且满斟。\n君言鹏与鴳，何者是飞沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"匈奴传","author":"李觏","text":"汉家经武意如何，也信狼心欲偃戈。\n岂是虏庭佳丽少，自缘婚礼货财多。\n女从宗室方抡择，赋出齐民更刮摩。\n若向大臣求侄媵，当时谁肯议通和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同徐殿丞游麻姑山陈屯田闻之以诗见寄次韵第二首","author":"李觏","text":"尘寰渐远渐凄清，似向昆崙采玉英。\n此地已知邻华子，几人犹道识方平。\n步高那复肌肤重，心逸都疑羽翼生。\n苦恨俗缘无了处，归来依旧马蹄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回明上人诗卷","author":"李觏","text":"学佛有馀力，吟诗过一生。\n情閒气燄少，句好琢磨成。\n柏竹门庭古，冰霜笔砚清。\n输他饱食者，终日自无营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回胡舜元赋稿","author":"李觏","text":"一把长篇读，惊嗟即过旬。\n谁知后来者，还似老成人。\n古训但时习，英辞当日新。\n惭无称荐力，空此见天麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回黄通诗篇","author":"李觏","text":"老杜没已久，嗟哉吾子心。\n时人任诟病，独自革浮淫。\n美玉宁须琢，朱弦岂在音。\n钟期如未见，慎勿等閒吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回廖解元所业","author":"李觏","text":"昔者闻乡举，良田恐甚芜。\n于今观日益，珍树已垂珠。\n众恶吾虽察，谦卑孰敢踰。\n圣贤明训在，只此是亨衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早归","author":"李觏","text":"病马不妨骑，出门常便归。\n见人无事说，是物与心违。\n通塞元关命，驱驰转觉非。\n莫教尘里汗，坏却箧中衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早夏偶作","author":"李觏","text":"閒愁不觉过年光，强半精神似醉乡。\n几度雨来成恶热，有时云断见斜阳。\n古人事业尘空满，故国园林草自长。\n赖得南华怜我病，一篇齐物胜医方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起有怀","author":"李觏","text":"草草西风动葛衣，呼僮前启竹间扉。\n山僧好睡钟声晏，社户多贫酒气微。\n岂是客愁浑较可，秪因书卷解忘归。\n旴江百里清无滓，枉属閒人坐钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵阎判官除夜","author":"李觏","text":"密雪穿窗入，孤灯向壁光。\n老来人不觉，梦断酒犹香。\n世事休思虑，年华任短长。\n朽株难长育，空此见春阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答史太博","author":"李觏","text":"驿使将诗访远山，发函宁暇正衣冠。\n秦城未割难论价，燕谷才吹已不寒。\n佔毕有心忘老至，惰农无罚贺恩宽。\n一枝数粒唯知分，岂是明时学考槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答陈殿丞","author":"李觏","text":"不能随薄俗，非是向深山。\n自喜道无屈，所嗟心未閒。\n酒乡贫更入，诗债病犹还。\n一字成虚美，通宵只厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答陈殿丞见寄","author":"李觏","text":"颠倒江湖二十春，干时的是妄庸人。\n先容不肯收蟠木，高足无从得要津。\n众与善名酬苦志，莫将吟味养閒身。\n食田饮井知谁力，下有骄儿上有亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬屯田陈丈见寄","author":"李觏","text":"老年才到病还催，老病成丛拨不开。\n腹冷有时如咽雪，耳虚终日独闻雷。\n半生辛苦归三径，万恨销磨向一杯。\n赖得竹窗无事处，清风频共故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池亭小酌得和字","author":"李觏","text":"客思都无著，临池一醉歌。\n唤春呈物象，移性入天和。\n月影碎荆玉，波纹纬蜀罗。\n相看尽仙骨，俗态巳无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自咏","author":"李觏","text":"俗态共纷纷，吾心谁与论。\n几因清夜梦，还见古人魂。\n圣域宁无乐，文家别有尊。\n此身聊自足，独恐累儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自解","author":"李觏","text":"人生何苦要多才，百虑攒心摘不开。\n夜月几曾无梦处，春风只管送愁来。\n秃毫强会悠悠事，浮世无过满满杯。\n看取秦坑烟焰里，是非同作一抔灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阶基","author":"李觏","text":"堂前一级似阶墀，无石无砖只旧基。\n泥饰顷因年节近，蹋崩唯是客行时。\n谁曾罗袜双来上，多谢苍苔久不离。\n从此便成贫景致，竹帘垂处最相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君赐以新诗相示因成四十字答之","author":"李觏","text":"君诗三十首，一一敌琅玕。\n语近终非俗，情閒不似官。\n姑山蟠郡碧，旴水蘸天寒。\n景物将才思，相期李杜坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君锡宰寿春","author":"李觏","text":"沦落多愁笑不成，水边还是送君行。\n官为令长前程好，地近乡关喜气生。\n百里有人观惠术，三年唯我见交情。\n山中后夜思贤处，风月犹应似旧清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听周大师琴","author":"李觏","text":"已解琴中意，更加弦上声。\n他人郑卫杂，此手鬼神惊。\n深夜众籁息，寒天孤月明。\n四邻应得睡，浊酒且同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村行","author":"李觏","text":"产业家家坏，诛求岁岁新。\n平时不为备，执事彼何人。\n朱户仍奢侈，柴门转窭贫。\n若非衢室畔，无用说悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵源洞","author":"李觏","text":"才出尘来尚未知，渐攀藤竹渐临危。\n伏流似是龙藏处，古树应无春到时。\n谁把石崖齐刬削，直教云气当帘帷。\n良工画得犹宜秘，莫与凡夫肉眼窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远山","author":"李觏","text":"最能牵病眼，天际一山横。\n尽日是秋色，无人知地名。\n暗时云自合，缺处路应平。\n才子沾衣泪，千秋共此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒夜","author":"李觏","text":"披衣坐小亭，夜气拂人清。\n月暗先成晕，虫吟不识名。\n举杯期混沌，开卷赏茎英。\n此兴知谁会，松风鹤睡惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居","author":"李觏","text":"无物可劳情，空郊日闭扃。\n雨吟春破碎，贫饮客凋零。\n世事重江险，才名一梦醒。\n同心秪松柏，见我尚青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡","author":"李觏","text":"嗟尔羽虫类，昂然冠距粗。\n徒为识昏晓，犹未免庖厨。\n年少苦令斗，主人频见呼。\n宁思避弋者，天外去鸿孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龟峰精舍","author":"李觏","text":"去县二十里，路平时正春。\n四山唯有石，一寺更无尘。\n融结疑天意，经营忆古人。\n但知安乐处，何必是金身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和屯田陈丈寄唐休次韵","author":"李觏","text":"白屋从来未有官，一名须作佛名看。\n彦伦北谷重归去，安石东山足旧欢。\n常调几时趍凤阙，湛恩唯待立鸡竿。\n胸中况是多奇蕴，自此阳春退苦寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]