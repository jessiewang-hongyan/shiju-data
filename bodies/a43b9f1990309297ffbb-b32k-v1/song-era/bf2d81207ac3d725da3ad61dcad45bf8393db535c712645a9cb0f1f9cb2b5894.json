[{"title":"偈颂一百三十六首 其二十五","author":"释惟一","text":"这个老汉，殊无所解。\n不惟屈屈曲曲，且是顽顽赖赖。\n我昔没兴见之，直至而今叵耐。\n烧炷香，礼三拜。\n吃拳打拳，彼此莫怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十四","author":"释惟一","text":"翠柳堤边舞，黄莺树上鸣。\n瞿昙真实相，历历在而今。\n谁言入灭向双林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十三","author":"释惟一","text":"惠力大宝藏，日转万亿匝。\n一日万亿匝，千日千万亿。\n愿以转轮数，仰祝天子寿。\n惟愿天子寿，复倍转轮数。\n繁开玉叶茂金枝，永与法轮无尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十一","author":"释惟一","text":"目视云霄，有一拳未敢分付。\n日游闹市，三十棒且待别时。\n遇坎则止，乘流而行。\n既无迹于去来，宁有心于动静。\n昨日恁么，逸翮独翔，孤风绝侣。\n今日不恁么，玩江月，听松风。\n拈起閤皂山，浓蘸清江水。\n平展金凤洲，写出祖师意。\n贴向十字街头，俾人人知道，一年十二月，腊月是年尾。\n宝祐改元，又从头起。\n万年万年更万年，清江依旧清无底。\n道泰不传天子令，时清休唱太平歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二十","author":"释惟一","text":"横一丈，竖一丈。\n满室风生，半窗月上。\n山僧要坐便坐，要起便起，终不向这里无风起浪。\n诸人若不散去，照顾劈脊拄杖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十九","author":"释惟一","text":"无碍慧门，铁壁铁壁。\n一击击开，不劳馀力。\n几人把手拽不入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十七","author":"释惟一","text":"秋风捲地，秋水连天。\n千山影瘦，万木萧然。\n渔笛数声江上月，樵歌一曲岭头烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十五","author":"释惟一","text":"可祖齐腰立雪，长庆坐破蒲团。\n一人铁壁觑要透，一人沧海沥须乾。\n铁壁透，沧海乾，出礼三拜依位立，捲起帘来天下宽。\n堪悲堪笑，何易何难。\n信道梅花香扑鼻，须是彻骨一番寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十四","author":"释惟一","text":"虎溪冰瑩长空月，凤岭松吟后夜风。\n堪笑堪悲翁老子，俨然不改旧时容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十三","author":"释惟一","text":"旧日重阳，今日重阳，篱菊披金浅浅黄。\n休讶去年蓬鬓，今岁半成霜。\n喜得同人相访，那边风景，此间风景，且莫论量。\n相与对花赊一醉，高歌大笑，手舞足蹈，听教人道掣颠狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十二","author":"释惟一","text":"皎洁中秋月，清光处处同。\n是人皆照破，无水不形容。\n圆满纤尘净，婆娑桂影重。\n古今争赏玩，谁到广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十一","author":"释惟一","text":"禅禅，风生木杪，叶坠庭前。\n唧唧寒蛩吟破壁，声声归雁度辽天。\n诸人若也会得，此去吴屯不远。\n若也不会，蓝溪水透洋边。\n阿呵呵，笑倒武夷张大仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十","author":"释惟一","text":"建岭云，建溪水。\n缥缈无边，渊深无底。\n尽情收拾归来，点滴无非珍贵。\n抛向诸人面前，切忌自生拟议。\n见之不取，思之千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九","author":"释惟一","text":"今日上元令节，雨意连绵未歇。\n过去燃灯如来，全体一时漏泄。\n檐头滴滴，分明历历。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八","author":"释惟一","text":"微雨润枯荄，严风搅林木。\n梅唇已破香，柳眼眠未足。\n尘世竞奔忙，光景相追逐。\n林间无事人，好唱云门曲。\n今朝腊月二十五，明朝腊月二十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七","author":"释惟一","text":"伏虎岩前，螺江江上。\n一去一来，无去来相。\n今朝古辟支，昔日翁和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六","author":"释惟一","text":"露冷风清，山空月明。\n天际归鸿书梵字，夜深砧杵送秋声。\n眼觑不见，耳听不闻。\n与君倾尽此时心，莫认山河作眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五","author":"释惟一","text":"今朝十五，明朝十六。\n瓠苦瓜甜，松直棘曲。\n辟支老汉，炎夏衣楮，严冬浴冰，谩自辛勤，徒劳检束。\n争似而今禅和，三三两两，水边林下，寒向火，热乘凉，又谁管你地覆天翻，天翻地覆。\n是玉也大奇，只恐不是玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其三","author":"释惟一","text":"夜夜明星现，有眼谁不见。\n此夜老瞿昙，却被明星转。\n直至而今双眼花，无瑕白玉自生瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其二","author":"释惟一","text":"浴冰桥畔，伏虎岩前。\n雪消松杪，春到梅边。\n古佛眼睛突出，瞿昙面目昭然。\n认著依前隔大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一","author":"释惟一","text":"是法住法位，世间相常住。\n佛殿对三门，灯笼挂露柱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其四 除夜","author":"释惟一","text":"腊月二十八九，家家户户尽有。\n不是北禅露地牛，便是清源白家酒。\n罗列杯盘，同欢共笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其三 除夜","author":"释惟一","text":"今岁今宵尽，日日日从东畔出。\n明年明日来，朝朝鸡向五更啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其二 岁夜","author":"释惟一","text":"叔季精神元似旧，慧慈面目只如新。\n来年年是去年年，今日日同明日日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其一 除夜","author":"释惟一","text":"腊月尽是岁除夜，明朝又是正月一。\n年去年来无尽期，拄杖依前乌律律。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释惟一","text":"凛然夷齐之风，翛然巢许之态。\n横作竺乾之孽，崛起释门之害。\n口吧吧地说尽万千，究竟不知有这一解。\n人皆谓金粟如来示现毗耶，我只道病多谙药性底耆年婆罗门者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪峰化士请赞","author":"释惟一","text":"藞藞苴苴，潇潇洒洒。\n严冷时温若阳春，褊急处宽踰大海。\n才开口，平日说。\n脱空却嫌人，无事谤般若。\n有时突出一句乡谈，佛也不能觑他缝罅。\n从来闽蜀本同风，相逢自有知音者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪峰真觉祖师赞","author":"释惟一","text":"弄出鳖鼻蛇，弹起广陵曲。\n清韵难可掩，毒气不可触。\n瞻之不足听不足，千古万古福城福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄檗断际禅师赞","author":"释惟一","text":"大机磅礴，大用纵横，要掌便掌。\n大中天子，掌中突出，要棒便棒。\n济北大树，棒头挺生。\n大唐国里只一人，千古仰之日月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞","author":"释惟一","text":"赤土画簸箕，冬瓜作碓嘴。\n舂碎铁蒺藜，簸出长粳米。\n不须淘汰，不须炊饱，尽世人人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"裴相国赞","author":"释惟一","text":"咄这措大，极是叵耐。\n操我戈矛，入我疆界。\n扑灭圆觉大光明藏，沥乾圭峰无边义海。\n所至皆望风退衄，末后遭檗山和赃捉败。\n纳款投降，愿为弟子，奉事无懈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题草虫图","author":"释惟一","text":"长茎短茎芳草翠，东个西个秋虫寒。\n平白祖翁田一片，时人莫作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其三十一","author":"释惟一","text":"发机外机，遣句中句。\n明眼衲僧，不知落处。\n知落处，南山起云，北山下雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其十一","author":"释惟一","text":"即心是佛，砒霜狼毒。\n起死回生，不消一服。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其十","author":"释惟一","text":"临济栽松，一椎两当。\n山门境致，后人标榜。\n锄头打地，灭却吾宗，阴凉大树起清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其九","author":"释惟一","text":"一物不为，千圣不识。\n静夜霜钟，澄潭秋月。\n清音绝听，清影难窥，药峤石头曾未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其三","author":"释惟一","text":"绝毫绝釐，日面月面。\n号令四驰，风行草偃。\n拔山超海杳无踪，风从龙兮云从龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二九","author":"释惟一","text":"斗粟可舂，尺布可缝。\n情深义重，山包海容。\n载笑载言，喜而欲舞。\n岂无他人，不如我同父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十二","author":"释惟一","text":"琢雪雕冰，攒花簇锦。\n邻义昭昭，友义烱烱。\n扶人上树，推人下井。\n劫石可消，此恨难殒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十九","author":"释惟一","text":"德山推倒，云门打杀。\n黄檗烧香，殷人以柏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十八","author":"释惟一","text":"宗通说通，抹过西东。\n无两舌头，有双箭锋。\n因甚如此，闽蜀同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十七","author":"释惟一","text":"今朝结制，制如何结。\n内不放出，外不放入。\n壁立千仞，千仞壁立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其十六","author":"释惟一","text":"罗绮丛中，笙歌社里。\n灯明如来，放光现瑞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其十二","author":"释惟一","text":"和尚尊位如何，突出日面月面。\n光艳烁破乾坤，五眼觑之不见。\n觑得见，何似寻常腊月扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其四","author":"释惟一","text":"和暖上元天气，是处笙歌动地。\n瑞岩无可设施，随分放灯一二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与行肇师宿庐山栖贤寺","author":"释惟凤","text":"冰瀑寒侵室，围炉静话长。\n诗心全大雅，祖意会诸方。\n磬断危杉月，灯残古塔霜。\n无眠向遥夕，又约去衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吊长禅师","author":"释惟凤","text":"霜钟侵漏急，相吊晓悲浓。\n海客传遗偈，林僧写病容。\n漱泉流落叶，定石集鸣蛩。\n回首云门望，残阳下远峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋灯","author":"释惟凤","text":"耿耿销深暗，孤窗岂暂忘。\n照回秋梦断，静引夜吟长。\n病鼠惊空穴，寒萤聚缺墙。\n邻居还共惜，及物有馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送史馆李学士任和州","author":"释惟凤","text":"历阳南望极，岸远石城危。\n去梦惊潮断，行吟见雁随。\n淮帆向风阔，楚木落秋迟。\n到日应闲卧，公心帝自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈豸处士","author":"释惟凤","text":"草长开路微，离思更依依。\n家远知琴在，时清买剑归。\n孤城回短角，独树隔残辉。\n别有邻渔约，相迎扫钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送徐涉南归","author":"释惟凤","text":"长安来雁急，相顾话离心。\n日落思家远，天寒归路深。\n秋光生独树，夕吹响孤砧。\n渐入云乡望，应无越客吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题河中柴给事望云亭","author":"释惟凤","text":"郡闲思退隐，嘉致望云秋。\n旧客容谁访，新诗许我留。\n棋窗寒日短，琴幌夜灯幽。\n青琐无归梦，期僧话沃洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄兆上人","author":"释惟凤","text":"久负中条约，深秋兴若何。\n白云归望远，黄叶意空多。\n静卧侵仙掌，微吟隔楚波。\n飞书答招隐，迢递寄烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄希昼","author":"释惟凤","text":"关中吟鬓改，多事与心违。\n客路逢人少，家书入关稀。\n秋声落晚木，夜魄透寒衣。\n几想林间社，他年许共归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄昭文馆陈学士","author":"释惟凤","text":"秋深荒外客，独上望京台。\n远信未封去，新鸿又见来。\n地寒边树短，天静瘴云开。\n无限心相向，南宫卧锦才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄登封宰韩殿丞","author":"释惟凤","text":"前秋登阁晚，吟次见晴云。\n中岳耸当县，三年静对君。\n朱衣借客典，清俸买书分。\n别后逢摇落，相思隔晋汾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答宇昭师","author":"释惟凤","text":"要地无闲日，吟踪肯暂过。\n林泉归计晚，雨雪向春多。\n径僻稀来客，庭荒半长莎。\n独眠思旧约，寒梦绕烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姑射山诗题曾山人壁","author":"释惟凤","text":"东西望朔漠，姑射独崔嵬。\n一片两片云，终南太华来。\n根绕黄河曲，影落清渭隈。\n深涧饮渴虹，邃洞生秋雷。\n古径穷难尽，晴岚拨不开。\n海鹏飞上迟，边风劲触回。\n傲隐非他古，依灵有奇才。\n曾生心若何，猿声终夜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"释惟凤","text":"草檄飞燕垒，降幡入汉营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"释惟凤","text":"岸尽吴山出，潮平越树低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"释惟凤","text":"众星随手举，万物应心平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"释惟凤","text":"寺近东溟日，山连北固春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神移泉","author":"释惟岳","text":"岩头瀑布泻寒烟，井底澄清浸月圆。\n性水真空周法界，神从何处更移泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涵虚沼","author":"释惟岳","text":"碧虚涵沼沼涵虚，虚沼员同绝欠馀。\n夜月丽虚知是影，更谁临沼照蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"释惟茂","text":"四面峰峦翠入云，一溪流水漱山根。\n老僧只恐山移去，日午先教掩寺门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送南浦明公归日本","author":"释惟俊","text":"空手东来已十霜，依然空首□回樯。\n明明一片祖师意，莫作唐朝事举扬。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中作","author":"释惟政","text":"桥上山万重，桥下水千里。\n惟有白鹭鸶，见我常来此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自题像","author":"释惟政","text":"貌古形疏倚杖藜，分明画出须菩提。\n解空不许离声色，似听孤猿月下啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞侍郎蒋公宴客见招","author":"释惟政","text":"昨日曾将今日期，出门倚杖又思惟。\n为僧只合居岩谷，国士筵中甚不宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈九首 其五","author":"释惟清","text":"天机藏不得，花笑鸟啼时。\n不待重拈出，当人合自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈九首 其一","author":"释惟清","text":"浮云散尽狂波止，天上玉蟾水底圆。\n皎洁迥然通湛寂，此时消息若为传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释惟清","text":"何知龙肉即猪肉，细语粗言尽入神。\n惜彼当年老居士，大机曾未脱根尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]