[{"title":"齐天乐 填温飞卿南曲","author":"卫元卿","text":"藕花洲上芙蓉楫，羞郎故移深处。\n弄影萍开，搴香袖罥，鸂鶒双双飞去。\n垂鞭笑顾。\n问住否横塘，试窥帘户。\n妙舞妍歌，甚时相见定相许。\n归来憔悴锦帐，久尘金犊幰，连娟黛眉颦妩。\n扇底红铅，愁痕暗渍，消得腰支如杵。\n鸾弦解语。\n镇明月西南，伴人凄楚。\n闷拾杨花，等闲春又负。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石通洞","author":"卫石卿","text":"空嵌两洞石相通，翠筱娟娟碧雾笼。\n手扶青藜访奇古，岩洞妙墨识涪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"卫时敏","text":"骑鲸紫霞客，来作世耆英。\n襟怀金玉循良，名字古无人。\n所至民歌遗爱，脱屣归来绿野，笑傲乐天真。\n不学渭滨老，公子自长生。\n一杯酒，再三祝，八十春。\n从今细数庆集，百度似今辰。\n绿鬓朱颜长好，何事紫芝仙草，兰玉自诜诜。\n盛事有如此，谁道四难并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"卫时敏","text":"春风桃李，问耐寒何似，霜松雪柏。\n珍重拨烦京兆手，早岁声名霹雳。\n收卷经论，摆遗荣利，物外多闲适。\n熊经龟咽，真传秘诀消息。\n奉秩初满华严，韶颜转映，绿鬓方瞳碧。\n况□□云供宴几，静对凫翁鹤客。\n只恐日边，蒲轮催动，密侍钧天席。\n上玉卮尧殿，长生倍注仙籍。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其四","author":"卫宗武","text":"古寺僧窗借榻眠，桑柔柳暗乍晴天。\n梦残一枕春酲醒，木杪钟声破晓烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其三","author":"卫宗武","text":"麦畦桑陇夹蔬花，远水晖晖日欲斜。\n一片野光涵列岫，翠微深处有人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其八","author":"卫宗武","text":"红紫飘零笋蕨抽，一年芳事又成休。\n榆钱万叠春难买，落絮随风万点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其五","author":"卫宗武","text":"乐天不废空门友，杜老犹交赞上人。\n茶灶笔床时一到，研谭尽日与僧亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其一","author":"卫宗武","text":"曲波岸岸浮清屿，绿树村村间野花。\n一望川原春冉冉，断霞残照落栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其七","author":"卫宗武","text":"山横数里如鬟耸，水界千畴似砥平。\n花事已阑农事动，村村雨足一犁耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其六","author":"卫宗武","text":"两度来游饱看山，又回双桨溯晴澜。\n山光每恨舟难载，点染篇章作画看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其九","author":"卫宗武","text":"开到荼蘼花事休，妇桑男亩又从头。\n阳春有脚堂堂去，万缕垂杨系不留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其十","author":"卫宗武","text":"乱擘晴绵清昼迟，阴阴古木绿云齐。\n僧窗尽日无尘事，梦破一声春鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行 其二","author":"卫宗武","text":"野芳未放青春去，林鸟长随白日閒。\n山色殢人归未得，杖藜日日扣松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为慈上人赋云溪 其一","author":"卫宗武","text":"油然出岫擘晴绵，点缀青空水接天。\n心迹两閒无俗累，静观飞跃乐鱼鸢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为慈上人赋云溪 其二","author":"卫宗武","text":"白衣苍狗任从渠，不碍波涵一太虚。\n雅契高僧方寸地，卷舒流止自如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中新霁","author":"卫宗武","text":"宿雨初收晓日升，晴川远浸数峰青。\n西风一洗林峦翳，收拾秋容入画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赋蜡梅 其二","author":"卫宗武","text":"能向早梅前独秀，何妨秋卉后才香。\n祇嫌一种开何晚，直待东风为发扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赋蜡梅 其一","author":"卫宗武","text":"将到穷冬寂寞乡，谁知花事未渠央。\n最怜剪蜡翻新样，却笑烧铅作素妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访桂","author":"卫宗武","text":"行秋遍历谷之阳，粲粲岩花竞晚芳。\n僧宇尽成金粟界，天风处处散天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"坟庵棋罢对月","author":"卫宗武","text":"僧庵恰好傍山坳，门外幽泉碎玉敲。\n棋罢道人心似水，一钩新月挂松梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近吟 其三","author":"卫宗武","text":"七十三年老病身，扁舟于此往来频。\n吴兴故老消磨尽，却认青山作故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近吟 其四","author":"卫宗武","text":"晚年打透利名关，十载尤欣老得閒。\n拟约绮园为隐侣，却愁无处觅商山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近吟 其一","author":"卫宗武","text":"泉石涓涓作玉鸣，天寒林静鸟无声。\n松香一篆书横几，人与秋山一色清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近吟 其二","author":"卫宗武","text":"历历疏林点暮鸦，幽幽雨砌菊犹花。\n浮云卷尽四山碧，倚遍乔松待月华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩 其一","author":"卫宗武","text":"芳事从今鼎鼎来，看看花片扑楼台。\n一和既盎寒如扫，锦绣香中图画开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩 其三","author":"卫宗武","text":"绛帷深密障严霜，衿佩芬芳聚一堂。\n竹外琅琅听春诵，咿唔声里带诗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩 其四","author":"卫宗武","text":"一片花飞未减春，方来赪紫盖如云。\n新晴剩拟扶鸠杖，试探芳辰有几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩 其五","author":"卫宗武","text":"馀寒威压皑浮琼，粉黛群空欠肉屏。\n欲著春衫忆纤手，不劳陆展染青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和咏梅 其三","author":"卫宗武","text":"年前疏秀明于雪，年后芬敷蓊若云。\n有色有香尤耐久，十分春事占三分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和咏梅 其二","author":"卫宗武","text":"点检春工首到梅，枝枝羞涩未全开。\n试看诗句相料理，换得清香入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和咏梅 其一","author":"卫宗武","text":"独占东风第一筹，孤芳不与众芳侔。\n飘零犹待调金鼎，未逐凡花浪蕊休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和沾上人韵","author":"卫宗武","text":"易地开山辟广居，静中妙趣契真如。\n自怜至老无闻达，抛却儒书读化书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和海棠韵","author":"卫宗武","text":"鬓雾鬟云衬脸红，嫣然一笑倚春风。\n直疑倾国倾城魄，聚入此花颜色中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和象翁绝句 其三","author":"卫宗武","text":"舟行必水陆行车，此地无桑只种麻。\n安得野蚕生活万，化成丝茧遍家家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和象翁绝句 其二","author":"卫宗武","text":"恰好轩窗傍竹开，绝胜舞榭与歌台。\n枞枞甲刃丈夫立，弹压炎威不敢来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和象翁绝句 其一","author":"卫宗武","text":"春花色色俱成梦，夏实累累结满枝。\n独有葵榴媚清昼，薰风时度五弦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和象翁绝句 其四","author":"卫宗武","text":"浮生一梦寄南柯，乌兔双驰迅若梭。\n世事如棋知几变，救时无著奈时何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄山秋吟 其二","author":"卫宗武","text":"珠露瀼瀼金作风，秋声凄怨入焦桐。\n骎骎碧树霜痕染，那复宫题叶上红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄山秋吟","author":"卫宗武","text":"有山静而秀，有水清且漪。\n风霜空宿翳，草木含幽姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄山秋吟 其五","author":"卫宗武","text":"何草青青不渐黄，班姬悲扇语凄凉。\n佳人笑别乘鸾女，相见毋嫌日尚长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄山秋吟 其四","author":"卫宗武","text":"从教日日把巫焚，无补河流一尺浑。\n甘霔要从方寸出，土龙刍狗不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄山秋吟 其一","author":"卫宗武","text":"铮然梧叶响敲风，凉月疏星秋正中。\n万顷水花浑老尽，一簪醉日倚残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄山秋吟 其三","author":"卫宗武","text":"潇潇清思浩无涯，红蓼滩头屋数家。\n小艇寻秋缘苇去，纷纷雪絮讶杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄山秋吟 其六","author":"卫宗武","text":"气序循环盛复衰，花随春老叶秋飞。\n一年光景消磨半，又见罗衣换葛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和僧房岩桂","author":"卫宗武","text":"叠金缀粟映明霞，移下蟾宫一树花。\n最好色香俱洗净，纷纷桂子落袈裟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中过秀城","author":"卫宗武","text":"万井民庐接梵宫，鼓声悲壮丽谯雄。\n人民郛郭浑如旧，烟雨冥迷黯淡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣妙寺偶成 其二","author":"卫宗武","text":"满座清风来古木，半窗斜日下危岑。\n观僧弈罢了无事，一枕凉生冰雪襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"卫宗武","text":"化工溥至仁，生机运不停。\n荣观遍原野，宇宙一丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"卫宗武","text":"天公要与物为春，人事纷纷蔼若云。\n锦绣山川谁管领，祇应鱼鸟得平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝交","author":"卫宗武","text":"北山有鸣鸮，不洁而嗤凤。\n宜下绝交书，埙篪非伯仲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"览古","author":"卫宗武","text":"治忽无常形，今古无常势。\n必有非常人，以制非常世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻桂","author":"卫宗武","text":"山光水色染秋容，天际明霞一线红。\n冉冉有香来鼻观，广寒花气散晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阅道书 其一","author":"卫宗武","text":"穆穆皇皇九五居，舍儒为政岂良图。\n不思济世思超世，佞佛求仙总是愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阅道书 其二","author":"卫宗武","text":"抱璞含和道俗同，寥寥万代想皇风。\n后来贤智知多少，未似当年牧马童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望霁","author":"卫宗武","text":"阴阳互阖辟，宇宙几洪荒。\n重明丽乎正，万象生辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萤","author":"卫宗武","text":"本从腐草生，聚为寒士灯。\n一朝书课效，功宁不汝矜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴","author":"卫宗武","text":"积涝初收喜气浮，三农不负稻粱谋。\n临流一望舒眵目，数叠青峦万亩秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赓沈赞府题二陆草堂 其一","author":"卫宗武","text":"二俊书堂历几秋，风云壮志浩难收。\n傥知莼美过羊酪，应返故山寻胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜂","author":"卫宗武","text":"为巢倒悬树，窍窍自成房。\n螫人虽有毒，终为人所伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜘蛛","author":"卫宗武","text":"经纬智何多，网张犹设罗。\n但知为物阱，更有物谁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其六","author":"卫宗武","text":"十分花事九分隳，开到木兰春已漓。\n惟有松筠助山色，青青不改岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其三","author":"卫宗武","text":"雨芽初试美于饴，尤胜新醅出榨时。\n坐对青山两清绝，肝脾溢出百篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其十","author":"卫宗武","text":"面面青山悦客情，扶筇到处有云生。\n归来瀹茗陪僧话，百尺乔松莺数声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其五","author":"卫宗武","text":"二阮当年总解诗，夷吾父子亦能棋。\n家庭粗有消閒乐，未似登山临水时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其九","author":"卫宗武","text":"应接山光到夕阳，候禽聒聒送春忙。\n年华鼎鼎催人老，将见青青梅子黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其七","author":"卫宗武","text":"众植惟推杞梓尊，邓林翘楚已无存。\n谁家一树花浮雪，犹喜刺桐花有孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其四","author":"卫宗武","text":"穷源几曲径深长，隐隐野花时度香。\n乔木森森走虬凤，稚松叠叠散牛羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其二","author":"卫宗武","text":"密依林谷远风埃，贞色幽姿不假裁。\n九畹芳残犹有蕙，光风拂拂转香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅山和丹岩晚春韵 其一","author":"卫宗武","text":"叠叠青山叠叠林，风松石涧自成琴。\n个中迥与世尘隔，试问入山深未深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画轴卷后","author":"卫宗武","text":"林阜玉参差，寒乌千万斯。\n直疑飞绕处，错认月明枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壑下墓松诗","author":"卫宗武","text":"耸壑松林逾百尺，几年培植至今存。\n可怜一旦成薪槱，曾见曾高长子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十生朝制坡帽","author":"卫宗武","text":"喜至生朝疾有瘳，旋裁坡老帽蒙头。\n肖形雅称氅披鹤，缓步何须杖策鸠。\n皓首今为七十老，黄花更有几番秋。\n明年准拟抛家宅，水北山南狎野鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和咏梅 其二","author":"卫宗武","text":"几回渴想此癯仙，谁为招邀倏在前。\n明艳弗为诸垢染，孤标独出众芳先。\n不矜颜色自奇绝，绰有馨香祇暗传。\n空想名园千树发，何时持酒向花边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和咏梅 其一","author":"卫宗武","text":"逸气飘飘似欲仙，不论茅舍玉堂前。\n众芳无此风神秀，十友推为行辈先。\n佳实尚堪为世用，香名更喜有诗传。\n萧萧白发差同色，也欲拈花上鬓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又题霅陇坟庵","author":"卫宗武","text":"斗大山庵历几春，茂林丰草绿初匀。\n青山缭绕犹列戟，玉涧萦回似曳绅。\n新竹羽成雏凤尾，古松鳞长老龙身。\n吾年已迈嗟无用，表道泷冈尚欠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下岭","author":"卫宗武","text":"下岭望前村，参差去路分。\n数畴田接垄，一穗爨生云。\n古树藏山胁，幽泉漱石龈。\n岩居非不隐，士马亦纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]