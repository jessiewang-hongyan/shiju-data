[{"title":"和施德远双莲韵二首 其一","author":"袁说友","text":"老向尘埃度岁华，不堪才拙负州家。\n天公著意成丰岁，地产无心出异葩。\n乱翠绡中双晕脸，抹青山外两凝霞。\n何人欲采莲归去，我有轻舟试一拿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和某提举喜雪韵","author":"袁说友","text":"冷彻狐裘薄，风团柳絮堆。\n雪先迎腊至，梅怯后时开。\n晓色连山老，年华两鬓催。\n浮生惊节物，谁与赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和洪叔炳主簿浮玉亭韵","author":"袁说友","text":"亭为君来又得名，公馀赢取眼双明。\n溪光影碎黄金艳，波面声流白玉琤。\n夜半吴歌缘底恨，晚来山色不胜情。\n风光我欲平分破，故把吟边当结盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵成子提干喜雨韵 其一","author":"袁说友","text":"一天膏泽下民区，此意拳拳敢自居。\n欲写吴歌誇岁好，苦无杰语愧才虚。\n稍留佳客联珠履，共酹馀觞笑曲车。\n试问苏州两年熟，岂无名笔作农书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵成子提干喜雨韵 其二","author":"袁说友","text":"十年三已冒为州，每每于民有旱忧。\n午听雷声鸣屋角，晚惊雨脚压云头。\n及时三日为霖好，为汝千箱乐岁求。\n欲办一椽名喜雨，愧无老笔赞宸旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵周锡制干峡中韵四首 其四","author":"袁说友","text":"绝景都忘峡路长，江风时送野花香。\n峰排玉帐腰凝雪，泉溜珠帘乳滴房。\n后日奇山犹续续，而今伟观已堂堂。\n雄篇曲尽形容妙，满袖珠玑到旅囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵周锡制干峡中韵四首 其三","author":"袁说友","text":"急峡高流日夜东，嵌空怪石浪穿砻。\n涛喧滩口波翻雪，云断山腰气吐虹。\n几阵堂堂峰硉矹，一泉滴滴水玲珑。\n我行天下今将半，安得名山如此工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵周锡制干峡中韵四首 其二","author":"袁说友","text":"千仞山头更有山，一山去后一山还。\n林峦有路春回绿，仙洞无人夜启关。\n岫列千屏森葆卫，石藏五色像形颜。\n举头待向峡中望，见说青天近一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵周锡制干峡中韵四首 其一","author":"袁说友","text":"西陵峭壁路初经，但见搀空两岸青。\n天近下连苍玉嶂，山高傍涌翠云屏。\n划开龙虎流三峡，敕下雷霆遣六丁。\n终日横风倚江转，恍疑身世在沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和闾丘资深转运判官送张同年韵","author":"袁说友","text":"造门剥啄笑谈馀，过我频迂长者车。\n八咏继吴推翰长，一封谕蜀属相如。\n岷峨诗富追风雅，韶濩声谐复古初。\n仰止骚坛方北面，不堪官事蠹书鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和兼善韵","author":"袁说友","text":"江湖踪迹厌萍游，只有诗魔老未休。\n平日故人谈语句，期年裹眼识风流。\n自能作意閒中趣，无复关心世外愁。\n趁此百年身偶健，为君一语竟须酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐英韵","author":"袁说友","text":"客久催归驭，愁牢爱大杯。\n骊驹勤咏叹，行李尚淹回。\n皇甫有书至，盖公何日来。\n巾车莫濡滞，祇此趣盐梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和浦勉道转运判官巡行出关韵","author":"袁说友","text":"涛雷殷昼候前驱，驷马桥边使者车。\n风约江声喧笑语，山迎雨脚傍阎闾。\n城头北海倾樽后，马耳西风揽辔初。\n关外秋来闻小熟，更将馀瘵入呵嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和资深同游尘外亭韵","author":"袁说友","text":"城南绝景半林端，城北荷塘十亩宽。\n风月无尘频入座，江山吊古一凭栏。\n瀛红浅露娇啼脸，绡翠轻飔醉倚干。\n日暮对花吟不足，三翁步屧小桥看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和梁曹池阳道中遇雪韵","author":"袁说友","text":"痴儿汩汩尚寻梅，点检花梢次第开。\n客里相逢秋日好，雪中重喜故人来。\n岁寒过我留佳句，夜半论文酹此杯。\n毋疾其驱行有诏，江头准拟送君回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和野堂僧子惠韵","author":"袁说友","text":"与公林下昔閒人，别后书来意转亲。\n老去兴怀空缱绻，诗来得句爱清新。\n眼看吴地千峰月，心在苕溪一钓纶。\n犹得支郎消息好，锦囊时寄笔端春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和惠老元日立春复雪韵","author":"袁说友","text":"一声春正晓，雪里荐新年。\n揽镜星霜久，催人岁月迁。\n化工原著意，物态漫争妍。\n我老心尤远，居閒觉地偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和惠老自上方来住广福寺","author":"袁说友","text":"岁晚逢三友，身閒爱一丘。\n喜闻孤锡至，又向白蘋留。\n失笑拈花手，无人野渡舟。\n个中须具眼，著语待公酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和惠国博韵","author":"袁说友","text":"平生心赏有高踪，更喜夤缘造化中。\n语次欲传须柳子，诗宗不愧是江翁。\n无言可究称醇德，有眼能看拜下风。\n共睹谢庭兰玉秀，只今攀桂广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程阁学观雪韵","author":"袁说友","text":"入竹投窗细细添，两山琼玉称遐瞻。\n巧于夜半将新岁，每以风回蹴上帘。\n寒雀栖枝惊落屑，饥乌鸣食讶堆盐。\n正须度腊成三白，已觉西风势转严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虞仲房潼川运使韵","author":"袁说友","text":"西湖樽俎忆风流，今日樯乌过我州。\n万里相忘嗟又别，九华何惜更同游。\n中郎有字新镌石，小子无言只点头。\n及此公馀多暇日，为君作计且邀留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘德久韵","author":"袁说友","text":"曾读桐江路上题，斯文便合请君司。\n向来吴会连朝语，晚岁扬州七字诗。\n忧世自怜闻道晚，论心犹恨结交迟。\n帆樯百里孤吟罢，坐爱雄风约雨师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和薛子晋来庆癸未登第韵二首 其二","author":"袁说友","text":"寒荄也趁百花新，眼懒犹贪上国春。\n五技怪能成薄命，一名却喜继前人。\n唤将好意诗频赋，洗却閒忧酒再巡。\n底事牛堪有归序，韩公平日最相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和薛子晋来庆癸未登第韵二首 其一","author":"袁说友","text":"云雾油然托应龙，姓名偶彻大明宫。\n胪传殿庑千官肃，声到旌旗万马雄。\n黄蝶飞来惊拜命，青衫误著敢言功。\n如何李合犹能第，造物何心本至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和薛公叔留都城韵","author":"袁说友","text":"年来更觉一身难，却扫应须早闭关。\n老矣壮怀空岁月，归欤活计只溪山。\n未堪鹍化摇而上，肯类蝇营去复还。\n白璧深藏有馀地，区区何必苦跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孟子开宰馀杭二首 其二","author":"袁说友","text":"得友宁论少，登门不愧迟。\n交游今有几，襟抱独相期。\n笑我方椎钝，如公政骤驰。\n我今怀旧意，不敢爱于诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孟子开宰馀杭二首 其一","author":"袁说友","text":"畿邑三年令，先声百里春。\n公朝勤恤隐，吾道足亲民。\n不作劳人想，犹堪发刃新。\n从渠清俗论，峨豸已知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"季提刑自夔宪知常德府","author":"袁说友","text":"十年踪迹两参商，解后天涯一咏觞。\n老景不堪朋旧别，客怀惟觉岁时长。\n猛辞蜀道浮江白，稳上吴船逆诏黄。\n我欲著鞭归路日，更期相过水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳大用寺簿惠佩刀","author":"袁说友","text":"文阵谈锋不可当，小恢游刃向朝行。\n一夫敌尔嗟长剑，十九人中见颖囊。\n徐子身非逢季札，吕虔心已识王祥。\n善刀我亦知藏去，他日犹烦赐尚方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庖人舟以风殿后早饭不继","author":"袁说友","text":"帆席搀前去，炊烟落后陈。\n一杯羹已饫，方丈食何因。\n自分贫兼客，休嗟愁杀人。\n江风吹送稳，晚酌待频频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武康县治松桂林二首 其二","author":"袁说友","text":"诗竞山川秀，亭随草木新。\n弦歌鲁言偃，吏隐汉梅真。\n淇苑雪霜操，广寒宫殿春。\n相望不百里，一苇要身亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武康县治松桂林二首 其一","author":"袁说友","text":"松桂论交久，诗书造道深。\n犹于官事日，不忘岁寒心。\n此地赓酬句，他年蔽芾阴。\n男邦有佳政，应促诏纶音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治药","author":"袁说友","text":"药采人间足，方从肘后参。\n年来医罕问，老去病多谙。\n风雨关淫疾，刀圭辨苦甘。\n君看不龟手，犹败越人南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沿溪转山入野亭小饮甚适","author":"袁说友","text":"惜此青青一日春，爱閒因得两三人。\n放身度密穷山崦，随意居宽趁水滨。\n逸饮不成愁淡薄，苦吟终是喜清新。\n物华时世相流转，今古之间几窖尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊沙市","author":"袁说友","text":"雪浪云烟日卷舒，去城远近聚廛居。\n千年堤岸围沙市，十里人烟半竹庐。\n荆国平分荆水阔，楚楼遥接楚天馀。\n江民日与波神狎，只把涛雷当噏嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊姑苏馆","author":"袁说友","text":"冲风挟雨到苏州，赢得樯乌半日留。\n岂是甘棠无剪伐，浪持使节几经由。\n群观底事多耆老，一笑犹能认故侯。\n回首齐云旧游处，西山端欲送行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊金陵得仲元书","author":"袁说友","text":"亲戚不忍别，弟兄那可离。\n枕边鸿雁信，天外鹡鸰诗。\n老大须长健，音书莫较迟。\n今朝万金至，无语不成思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知止堂","author":"袁说友","text":"先生七十已垂车，父子俱荣出帝都。\n当世若无知止者，公朝何以励贪夫。\n升堂展卷人何在，访竹寻梅色尚臞。\n我老自怜生也后，拊编犹得叹前芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"练湖","author":"袁说友","text":"练湖四十里，往往半徐州。\n巨浸膏千亩，馀波济万艘。\n回旋迷宿鸟，浩荡狎飞鸥。\n父老相迎问，犹怀旱暵忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴府学斋宿","author":"袁说友","text":"从容黉舍日西流，浅饮犹看夜气浮。\n小款话时殊淡薄，细论文处转清幽。\n诸公学业方加锐，一战功名要早收。\n我了斋祠便归赋，故园已作梦中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"肃客借重金紫绶","author":"袁说友","text":"平生青紫滥于身，更冒金章肃使宾。\n何以假为诚岂敢，乌知非有笑无因。\n猿狙自是羞华服，鹓鹭姑容接后尘。\n回首纷纷天下事，有时宜假不宜真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试砚","author":"袁说友","text":"断璧推良质，寒窗足雅供。\n点分鸲眼秀，色渍马肝浓。\n岩浸端溪月，纹藏古歙峰。\n可怜方寸石，笔下几迎逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诚斋指檐头雪为诗材二首 其二","author":"袁说友","text":"使旌猎猎昼连宵，剩说吟边涌思飘。\n晓枕已哦千树雪，夜船更踏一溪瑶。\n谁将春霰天然巧，来伴寒梅别样标。\n赢得袁家僵卧者，开门今为好诗撩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诚斋指檐头雪为诗材二首 其一","author":"袁说友","text":"春风著意向春宵，巧作冰澌细细飘。\n正好千门竞灯火，故添万瓦灿琼瑶。\n谁怜梅蕊犹含玉，大遣杨花为夺标。\n一段风光付诗手，物华正恐为君撩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闸柱","author":"袁说友","text":"三丈围宽两木灵，千年闸骨状如城。\n扬帆欲过心先动，击柱才闻念已惊。\n东越梅梁犹逞异，南城老树也为精。\n昔闻求福木居士，今向枯株免祸成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中即事","author":"袁说友","text":"夜雨恰一尺，新秧高九分。\n烟深数峰暗，涧急满山闻。\n苍蔚添新翠，溟濛蔼暮云。\n田家方乐岁，泥淖也忘勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯金使出北关风雨大作","author":"袁说友","text":"出郭初行十里赊，狂风急雨闹田家。\n香粳饱熟云翻浪，荞麦新开雪作花。\n浅水半村环野趣，好山一带接京华。\n晚来踏尽临平路，风脚全收雨脚斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯送蜀进士入奉廷对","author":"袁说友","text":"蜀才卓荦照宾筵，秀出斯文万选钱。\n圣主龙飞初策士，皇朝春好正朝天。\n丹墀独对三千字，黄甲重魁四十年。\n归把群书观未见，要令学业到纯全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞氏园","author":"袁说友","text":"好景环深院，名园得故家。\n楼高春带月，池曲晓催花。\n亭著城头稳，溪浮眼界赊。\n成阴虽岁月，老树看槎牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姚行简抚干归霅川","author":"袁说友","text":"一见油然慰所望，巾车更辱到他乡。\n相从乐处光阴速，索笑浓时意味长。\n樽酒未堪留好客，湖山早已送归艎。\n秋来尚忆门前路，莫惜溪头屡买航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尝顾渚新茶","author":"袁说友","text":"碧玉团枝种，青山撷草人。\n先春迎晓至，未雨得芽新。\n云叠枪旗细，风生齿颊频。\n何人修故事，香味彻枫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"屋后植竹","author":"袁说友","text":"稳袖三年手，新锄十丈园。\n傍山移早筀，扫径斸孤根。\n琐碎梢头影，凄凉竹外村。\n可人风月地，头角见龙孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"持课","author":"袁说友","text":"梦接三乘境，香胜一炷薰。\n风窗独趺坐，鸟雀听声闻。\n目想金刚会，心存贝叶文。\n稍蠲烦恼毒，天雨看缤纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故人爽贷粟之约","author":"袁说友","text":"小泊渔舟晚，春风燕子回。\n从渠三月约，误我一舟来。\n风雨故相厄，溪山犹可陪。\n人生竟何有，此抱向谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日怀钱塘西湖","author":"袁说友","text":"只今春色满皇州，料得西湖已纵游。\n出郭竞联城下骑，循堤同上柳边舟。\n恨无两翼从渠去，曾有诸公念我不。\n到底长安风物外，远方何敢诧遨头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞庭立峰","author":"袁说友","text":"绝壁横翔势，当轩伟岸姿。\n一峰云欲下，乱藓雨频滋。\n独立霜寒耐，衔空月影筛。\n缅怀黄石事，犹想谷城时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玲珑山","author":"袁说友","text":"颇怪玲珑景，浑疑雷雨穿。\n灯分岩下径，目骇洞中天。\n傍磴莓苔合，环山草木鲜。\n白云时欲下，烟锁闭神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盆池荷花","author":"袁说友","text":"根向盆池束，华敷菡萏丛。\n细擎深院宇，低袅半窗风。\n蘸水凝绡翠，当轩试脸红。\n化工虽力浅，犹折小莲蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝子正从范使君锻以诗寄之","author":"袁说友","text":"柳下嵇郎好在无，深居应得静工夫。\n丹成便许随鸡犬，分定初知豢鹤凫。\n痒处端能窥鸟爪，梦中不用断龙胡。\n别来亦有閒忙事，日向黄家问酒垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝粮","author":"袁说友","text":"旧索长安米，今无负郭田。\n平生一饱计，岁晚百忧煎。\n漂母今何有，王孙空自怜。\n日高亭欲午，寒屋灶无烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡元迈编吕仙翁传","author":"袁说友","text":"工夫未达性中天，九转还丹漫费年。\n至理本无多智巧，此公自有一神仙。\n绝知开卷翁如在，剩欲忘言意自传。\n功行世间千百亿，诸天更办笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵再可邦君六月雨应祷","author":"袁说友","text":"长夏何堪日日晴，德音优渥遍群氓。\n黄堂少试为霖手，赤地今传喜雨声。\n诚意自知关善政，天心正不远人情。\n四郊已报四家语，一饱应无百计营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送叶表侄归乡","author":"袁说友","text":"枌榆离别几春秋，作计吴中祇谬悠。\n回首故园三叹息，喜公归路两经由。\n怀乡谁不思邱首，游宦余方愧督邮。\n千里相忘未归去，家山时向梦中求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年曾南仲寺丞知温州","author":"袁说友","text":"久同朝迹又同年，更送旌麾过海边。\n多士向来亲戴席，斯民今幸得苏天。\n潜心阁上书千卷，雁荡山中草一川。\n小待公馀寻旧迹，便归玉笋听鸣鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕武仲司户范纯之司法赴南宫试","author":"袁说友","text":"欣然愿作送行诗，盛事江邦独见之。\n酾酒且同明月醉，驱车未怕朔风吹。\n相逢暂入红莲幕，稳去高攀丹桂枝。\n莫负玉阶方寸地，为言民力要扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]