[{"title":"谢仁老寄所画李长者出山相五首 其五","author":"邹浩","text":"一真境界孰能参，赖有斯人作指南。\n更赖殷勤招唤得，不知流落在烟岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦道","author":"邹浩","text":"谁谓南方世乏人，斯人见义若风生。\n吉凶祸福略无惜，父子弟兄同此情。\n袖里珠光携合浦，胸中潭影到昭平。\n它年野史谁操笔，定以青编著姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读张氏金塘阡表","author":"邹浩","text":"大笔从来不妄褒，特于阡表勇挥毫。\n当年种德已如此，今日里门宜自高。\n云带洞山常蔼蔼，雨钟明水转滔滔。\n追荣更有丰碑在，行矣巍然压巨鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻周仲修复致仕","author":"邹浩","text":"继述嘉谋圣主知，拂衣缘底便言归。\n往而能返非难事，安不忘危是识机。\n西子扁舟藏国艳，鲈鱼一箸出江肥。\n公乎有地相容否，才脱拘挛去似飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻朱世英再知江宁府","author":"邹浩","text":"归领真祠未几时，牙兵重展旧旌旗。\n向来孰不歌来暮，今去欢然释去思。\n竹马渡江腾骏足，甘棠拂户动高枝。\n钟山只恐违初兴，径入鹓行侍玉墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示长卿二绝 其一","author":"邹浩","text":"慑处炎荒已二年，亲朋书问亦茫然。\n独君风义能终始，不管烟岚肯着鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示长卿二绝 其二","author":"邹浩","text":"一别和州二十年，山长水阔去无缘。\n因君说起外家事，特地栏边心怅然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示二黄","author":"邹浩","text":"摩尼超出衲衣中，五色随方照不穷。\n八万四千清净眼，一齐开了见真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜闻鸣桹 其一","author":"邹浩","text":"鸣桹声响五更初，恰似京城叩木鱼。\n梦里犹疑趁朝晚，几回惊起揽衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜闻鸣桹 其二","author":"邹浩","text":"渔人于我本无情，我自情生梦里惊。\n惊起却眠方记得，新条不得到京城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书喜","author":"邹浩","text":"仲冬月吉吉可知，日南长至恩光期。\n一阳火复验内揵，八陛圆坛严上仪。\n玉辂回銮天倍喜，金鸡肆赦人均禧。\n倚门朝夕可宽念，綵衣归去今其时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜晴","author":"邹浩","text":"一阳初欲与时亨，便觉群阴不敢行。\n寒雨断飞天皎洁，冷云收翳日晶明。\n泥乾屐齿都无阻，气协花心倍有情。\n天运回旋吾道长，欣欣此际孰能名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙宫庙","author":"邹浩","text":"千仞巉岩一径通，可扪天处是仙宫。\n婵娟并席谁家子，缥缈吹衣万窍风。\n初月淡笼眉拂拂，晚云低绕鬓??。\n邦人不复知端的，但说常能助岁功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周御史庙","author":"邹浩","text":"忠言直节动天聪，名在升平北斗中。\n阴德久宜家有后，光灵今与国无穷。\n庭前乌集当年柏，门外风生旧日骢。\n公不世情应我顾，一觞聊复以诚通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙兴观有感","author":"邹浩","text":"自罢龙兴节，人间几岁穷。\n偶观尘榜暗，追感御炉穹。\n万事遗高躅，三清肃下风。\n钧天在何许，犹冀梦魂通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枯荷","author":"邹浩","text":"万顷菱荷一一荒，骈头相倚卧池塘。\n追惟弄日摇深绿，不谓凌风折败黄。\n饥雁飞衔投远渚，寒鱼浮触动斜阳。\n那知凛凛梢云者，自有松筠傲雪霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒步","author":"邹浩","text":"冬来风雨并，今日偶晴明。\n况是亲朋集，聊将笑语行。\n青云随步武，朱鹭入逢迎。\n无限欣然思，都随指顾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟 其一","author":"邹浩","text":"乘兴扁舟过赵村，满家滩上水连云。\n欣然便欲寻源去，织女机边日未曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟 其二","author":"邹浩","text":"风净一奁水镜，云开两行山屏。\n白鹭亦知人意，飞来伫立寒汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登鹏高亭基","author":"邹浩","text":"野烧无踪知几年，故亭遗址尚依然。\n巍巍稳据山千仞，渺渺前当水一川。\n地展云衣深固护，天回松盖巧周旋。\n重兴栋宇非难事，坐使风光集绮筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铜池","author":"邹浩","text":"匀叠滩头碎石，满添江面清流。\n聊向个中儿戏，不知何处尘浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示长卿","author":"邹浩","text":"君与我同庚子生，连年忧患亦纵横。\n天高休说不可问，心下直须深自明。\n运属时雍人正乐，祀严郊报礼初成。\n涤瑕荡垢知多少，行矣欣欣木再荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送长卿 其一","author":"邹浩","text":"有口如钳方鲜语，无心似水始能思。\n杯中一片閒天地，占得新阳君与知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送长卿 其二","author":"邹浩","text":"阳朔千山与万山，生绡图写北人看。\n君今款段穿云去，莫厌崎岖行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阳朔路","author":"邹浩","text":"云里峰峦千万重，中间一路与天通。\n新阳已约为前导，回我车轮朝帝宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄长卿","author":"邹浩","text":"乌衔霁色朝迎马，蟾吐澄辉夜照眠。\n日月于君已如此，不须星历问行年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"邹浩","text":"朝天坊里朝天客，拱北轩中拱北人。\n惟有苍苍知此意，只应潜为启严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄参寥 其一","author":"邹浩","text":"云岫庵头挂钵囊，旃檀一瓣自馨香。\n建隆消息天然别，妙总流通笔放光。\n南岭梅花空自得，西湖沤鸟宛相望。\n师如水净吾如月，照入清泠知有方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄参寥 其二","author":"邹浩","text":"上东门外解船时，赴感汝阴师未归。\n松麈对谈能几日，瘴乡孤坐但忘机。\n珠腾甓社淮南冷，山折成都蜀道非。\n属耳朱弦谁莫逆，只应袖手看鸿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜捷应方成","author":"邹浩","text":"上医医国有谁知，且集方书捷用之。\n疾苦一齐安乐后，自然遭遇太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"他处梅自十月已开烂熳独此今方作花睹之欣然 其一","author":"邹浩","text":"惊怪江梅独未开，含芳元是待冬来。\n新阳夙驾无多日，已向枝头各自催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"他处梅自十月已开烂熳独此今方作花睹之欣然 其二","author":"邹浩","text":"东君消息到梅梢，满眼轻盈渐解苞。\n绕树更忙须百匝，行看新样插云髾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"他处梅自十月已开烂熳独此今方作花睹之欣然 其三","author":"邹浩","text":"梅将喜信自天来，光动书楼趁暖开。\n花比去年真个好，一齐欣送我侬回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治梅圃 其一","author":"邹浩","text":"只有今年对此花，此花欣送我还家。\n呼童扫溉放花出，作意相从归去誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治梅圃 其二","author":"邹浩","text":"中间篱障压根蟠，四面荆榛逼树攒。\n今日削除随手净，放梅高出紫云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放竹鸡","author":"邹浩","text":"鼓翅出樊笼，双飞意气同。\n便鸣泥滑滑，深应竹丛丛。\n善也还天性，时哉属岁丰。\n弋人情已得，宁复堕机中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拱梅亭","author":"邹浩","text":"陆沉无复似当年，高压云根气象全。\n四面山川趋指顾，一时草木避蕃鲜。\n垂檐鼎实须归帝，起槛龙香必动天。\n自我发挥人共乐，风流从此映来仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀长卿 其一","author":"邹浩","text":"香醅新拨一尊浓，准拟君来笑语同。\n缘底留连过初约，凭栏日日望归蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀长卿 其二","author":"邹浩","text":"深情知在霈恩边，肯为閒花醉后颠。\n不是看山驻阳朔，即应倚担待长船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小树","author":"邹浩","text":"一株短短八九寸，四面青青千百枝。\n作供佛前偕瑞竹，移根石上入铜池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小雨","author":"邹浩","text":"梅圃初成尘土飞，早来烟雨便霏微。\n天时人事欣相得，可验蒙恩朝夕归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻吴圣取还朝","author":"邹浩","text":"庚子频年忧患同，君依坟土我飘蓬。\n闻君已复云霄上，顾我须逃瘴雾中。\n学校他年齐出处，朝廷今日异穷通。\n敝庐归去无他事，惟愿时和岁岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯花甚奇","author":"邹浩","text":"草赦今朝锁北门，灯花来报我蒙恩。\n巧当楼阁中间立，高出光明几次繁。\n辽绝虽然如异域，生成本不间孤根。\n此身曲荷乾坤力，仰答洪私它日论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山禽","author":"邹浩","text":"一鸟飞从何处来，归去归去声声催。\n炉烟正自山阁起，天意俄从云路开。\n三年至日阻为寿，万里膝下今当回。\n迎祥拜贶不胜喜，满引贺酒千百杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用老杜至日怀太白韵怀诸弟","author":"邹浩","text":"罗拜为亲寿，遥知亦我思。\n阳生萱草色，心入棣华诗。\n帝泽来非久，莱衣戏不迟。\n为言多置酒，归趁赏花期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀旧","author":"邹浩","text":"辛巳年冬导驾行，朝从太庙出青城。\n雪迎天仗徐徐舞，日向龙颜淡淡明。\n不待衔枚人自肃，惟观夹道喜相仍。\n今朝倍复如初盛，遥拱神京空此诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日依韵和老杜五首 其一","author":"邹浩","text":"岁月惊如弩发床，千官坛下又成行。\n燔柴香蔼六变乐，奠玉殷勤三上香。\n当日佩綪躬进酒，兹辰目断望垂裳。\n端诚舞蹈无因预，空想中天瑞气长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日依韵和老杜五首 其二","author":"邹浩","text":"蛮风吹鬓鬓毛斑，非复登楼旧日颜。\n上主亦应怜久窜，孤臣尤切望今还。\n金鸡欢动栏杆外，綵服光生骨肉间。\n归去此恩何以报，惟将香火祝南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日依韵和老杜五首 其三","author":"邹浩","text":"黄宫初气重氤氲，喜色朝来便着人。\n知有归期亲望我，更无它事我思亲。\n堂前献寿开金盏，岭外蒙恩戴玉宸。\n一笑承颜胜六印，功名岂复羡仪秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日依韵和老杜五首 其四","author":"邹浩","text":"当关无复守门催，欲晓鸡声唤起来。\n一炷寿香瞻白发，三杯贺酒写红灰。\n看棚尚倚天街柳，恩信先通桂岭梅。\n但喜奉身归膝下，自馀皆是鲁禽杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日依韵和老杜五首 其五","author":"邹浩","text":"惭愧君恩似日长，终然倾否肇三阳。\n休思往事追华贯，且喜馀生脱瘴乡。\n俛仰自知诚自幸，尊卑相守免相望。\n外炎内热从兹尽，别是人间一味凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同仲亶长卿观梅","author":"邹浩","text":"雨后江山欲放春，更无一点旧风尘。\n对花若不饮一盏，却恐梅花解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同长卿梅下饮茶","author":"邹浩","text":"不置一杯酒，惟煎两碗茶。\n须知高意别，用此对梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张纠惠吴洞簦","author":"邹浩","text":"茶选修仁方破碾，簦分吴洞忽当筵。\n君谟远矣知难作，试取一瓢江水煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和答稷臣见贻之句","author":"邹浩","text":"瘴疠侵凌鬓欲华，凤凰飞诏下天涯。\n有知病骨将枯日，忽遇灵丹蹑彩霞。\n赫赫千龄方启运，熙熙六合共为家。\n此恩碎首知难报，空感来篇似永嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和李学文所示二篇 其一","author":"邹浩","text":"材气无双是陇西，扁舟还指旧山溪。\n非关吕览难更字，要使班输别造梯。\n尘外光阴归作者，道中消息在寥兮。\n它年峻捷黄金榜，路入三吴手重携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和李学文所示二篇 其二","author":"邹浩","text":"大明端拱赭衣红，正想豪英入彀中。\n但使学优迎命达，莫将年少叹途穷。\n三秋水阔鱼依藻，一日天高鹤出笼。\n持我此篇归献寿，苍梧欢动晓来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移汉阳","author":"邹浩","text":"汉阴丈人浑沌修，汉阳居士逍遥游。\n中分汉水共天地，能别此心惟白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画山 其一","author":"邹浩","text":"几年密与画山邻，今日归航驻水滨。\n天亦有心酬我愿，敛云收雾日光新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画山 其二","author":"邹浩","text":"三峰阔展映天长，大巧由来未易量。\n我欲移归殿前去，万年千载对君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画山 其三","author":"邹浩","text":"扫成屏障几千春，洗雨吹风转更明。\n应是天工醉时笔，重重粉墨尚纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"展画亭","author":"邹浩","text":"丹青一笔妙难窥，万古长如初画时。\n浓淡乾坤偏掩映，卷舒云雾巧追随。\n深藏尘表天元爱，不到炎方世岂知。\n展出高亭快人目，舍君风韵更谁为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小舟枕上","author":"邹浩","text":"船头钻入北来风，继日连宵闭短篷。\n多少峰峦多少意，一齐收在枕屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登碧岩寺卢舍那瑞像阁 其一","author":"邹浩","text":"楼阁门开处处通，毗卢出现眼光中。\n为人重说二愚品，岩下滩声西北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登碧岩寺卢舍那瑞像阁 其二","author":"邹浩","text":"我自南方稽首回，大千经卷出尘埃。\n十方三世都圆了，卢舍那尊金色开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登碧岩寺卢舍那瑞像阁 其三","author":"邹浩","text":"我住莲华法界中，尘尘刹刹本来同。\n旃檀一瓣聊兴供，吹满岩前万窍风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与梦立行入长安虚 其一","author":"邹浩","text":"恰到长安风色晴，一条石径坦然平。\n与君曳杖寻虚去，全似仙宫岭下行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与梦立行入长安虚 其二","author":"邹浩","text":"久不上船思上船，偶然纵步是长安。\n何须更望君平卜，但把虚名子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗米滩","author":"邹浩","text":"粥饭都来一斗粮，滩前吃了倍苍黄。\n把如立作山头石，何似急行归故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捍门山","author":"邹浩","text":"扬子江头舟楫回，海门山对润州开。\n故乡归去六千里，先入捍门山里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过雉山 其一","author":"邹浩","text":"客睡当年托雉山，杜鹃声切枕难安。\n今朝归向山头过，不见杜鹃空梦残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过雉山 其二","author":"邹浩","text":"苾刍曾向定中观，谓我南迁使可还。\n过了三年方语验，聊将一笑谢禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示寿宁长老如晓 其一","author":"邹浩","text":"十二年中独自春，应缘还现寿宁身。\n南方衲子闻知否，便是黄龙旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]