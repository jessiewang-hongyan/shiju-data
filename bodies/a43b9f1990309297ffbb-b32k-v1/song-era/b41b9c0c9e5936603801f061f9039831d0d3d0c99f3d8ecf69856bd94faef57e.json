[{"title":"过丰城访甘叔异闻在曲江之矶头庵放舟过之棹未及弭迎劳之诗已至次韵上呈","author":"赵蕃","text":"竟日江行历抵寻，耸然高屋在深林。\n夷犹未觉矶头远，下上方知磴级深。\n好句已从天上落，快谈仍慰别来心。\n经行剩约重来见，岭海他年无雁音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过从礼","author":"赵蕃","text":"崖壁怒开张，盆山草木苍。\n高深类盘古，琐细亦禅房。\n雨润画粘壁，风微书散床。\n小留谈不恶，而我病成妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过分水岭二首 其二","author":"赵蕃","text":"不历闽山险，空云蜀道难。\n有泉皆瀑布，无路不纡盘。\n酒薄愁难破，诗成鼻为酸。\n举头唯见日，何处是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过分水岭二首 其一","author":"赵蕃","text":"水激风仍疾，山丛日易收。\n才欣稍妍暖，忽恐变飕飗。\n久客奚多感，对兹真欲愁。\n无为尚絺绤，当复念衣裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过水寺 其一","author":"赵蕃","text":"步向溪南寺，行寻白社徐。\n祗言犹作客，不悟已迁居。\n照壁诗无恙，当轩竹未疏。\n挂包蕲异日，我欲掇其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过水寺 其二","author":"赵蕃","text":"未见南溪泛，一看洞府家。\n径荒冲暮雀，林静起栖鸦。\n锁钥何其密，推敲漫自加。\n及归已薄暮，渔火在园沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过水南甚早","author":"赵蕃","text":"夜雨晓仅止，前山云未收。\n陂田飞宿鹭，社木唤晴鸠。\n云里浮图级，滩边贾客舟。\n故知山可住，不觉利能谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过玉光呈吴丞","author":"赵蕃","text":"又见秋风拉芰荷，也无官柳共婆娑。\n青山只作向来看，白发自惊重到多。\n莫道予方有公事，须知地僻少经过。\n数公句刻虽无恙，题榜风流欠景坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过吉水问萧伯和兄弟云在县四十里之罗陂远不及见以诗寄之并呈仲和","author":"赵蕃","text":"忆昨携诗辱报诗，再来有约竟乖期。\n不应置我毋庸友，何自令人极所思。\n千里叶舟黄落后，一官斗粟倦游时。\n访寻不见萧齐处，风雨何由话别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过在伯于学中因而留饭","author":"赵蕃","text":"种竹栽桃久已成，滋芹折杏尚留情。\n一官何可占遐志，万卷悬知有旧盟。\n得酒更能频饮我，赋诗未稳每从兄。\n向来淮拟俱归去，今日参差不遂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过西峰主人适出回访刘伯山不值云过黄永新也","author":"赵蕃","text":"佛寺兴已尽，隐庐来不赊。\n隤基濒野水，瘦竹隐疏花。\n试挽添丁问，云过叔度家。\n清谈固难觅，渴肺颇思茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过吴江访尉曹李仲纯不值代简寄之","author":"赵蕃","text":"晓寻仙尉向吴江，闻道乘舟警吠厖。\n渔具画图赊面觌，松陵酬倡阻心降。\n因人尚拟它时寄，共看无因绝境双。\n二季一翁新作别，望君须遣候船窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过陈莘叔尹因以赠之","author":"赵蕃","text":"几从邢子问先友，相与谈公口不空。\n治狱尽心无诡论，挂冠犹健有高风。\n峥嵘正尔尚豪气，矍铄未应闲是翁。\n两月淹留见何晚，竹林松径暂时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过叔文园亭题于竹上","author":"赵蕃","text":"一亭幽入径，万竹上参天。\n我欲成閒咏，君能起醉眠。\n清风谁为起，宿雨昼犹悬。\n莫厌此物聒，管弦非自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过周文显所居","author":"赵蕃","text":"不谓于兹世，而能有若人。\n藤萝为遮屋，图史漫娱身。\n安邑谁为令，黔娄自守贫。\n他时独行传，端可并麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过明叔有诗次韵","author":"赵蕃","text":"出门无所诣，引兴独兹长。\n万事一杯酒，三春百草芳。\n暇能过巷隐，痴岂累官忙。\n久坐疑成晚，樵归渔返乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过秉文","author":"赵蕃","text":"相过每饮必论诗，湿吻沫濡真自痴。\n名且不为身后计，意宁能问俗间疑。\n世皆竞取君公谓，我独何妨尔汝为。\n日暮剧谈殊未了，临分更为月迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过南昌以病不入城纵望偶题","author":"赵蕃","text":"滕王阁上退之碑，徐孺祠中鲁直诗。\n往客欠游常系梦，今行缘病复愆期。\n霜彫南浦短长柳，云掩西山浓澹姿。\n落照有情增我恨，晚风无力度帆迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过贵溪数里望月岩作","author":"赵蕃","text":"宿雨洗清秋，行行早放舟。\n团团正林杪，隐隐半岩幽。\n永谢妖蟆食，宁须玉斧修。\n少微并婺女，何事独名州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过钦止","author":"赵蕃","text":"一饭肯留我，群书容恣翻。\n雨收还摵摵，云破复昏昏。\n山水琴中趣，桑麻野外论。\n淡交真有味，炎附卒成燔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过商叟林居蒙示半村诗集及曾吉父宏父王元渤诗卷因用前者奉简之韵作二诗上呈商叟许抄半村诗集见遗故及之 其二","author":"赵蕃","text":"结交早日类知名，岂但当年王与曾。\n野鹜家鸡随所嗜，玉环飞燕讵宜憎。\n筌蹄久矣成深悟，驽马犹当勉未能。\n好取他山细摹刻，客来传写怕相仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过商叟林居蒙示半村诗集及曾吉父宏父王元渤诗卷因用前者奉简之韵作二诗上呈商叟许抄半村诗集见遗故及之 其一","author":"赵蕃","text":"只道诗家无续灯，半村今喜见孙曾。\n非关竽瑟异王好，自是文章多命憎。\n题赠向人无苦秘，流传后世岂无能。\n溪头剩欲连朝住，舟子催行底见仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过黄狗步","author":"赵蕃","text":"古步经黄狗，平沙隐白鸥。\n顺流翻逆浪，欲去若苛留。\n历历川原路，萧萧风雨秋。\n颓然怕看镜，白尽几分头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过曾季永","author":"赵蕃","text":"饭馀颇欲步寻茶，行到溪头小饮家。\n密竹自悭今岁笋，酴醾犹有后番花。\n耽诗叹我寒仍瘦，养气知君老更华。\n夏木扶疏更应好，要分犊草伴鸥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过曾季永见壁间张安国所书天下第一真仙之岩知有融州便托附贾季承书作二诗呈季永且怀季承 其二","author":"赵蕃","text":"不见融州使，无从可寄书。\n仙岩忽逢字，驿骑想非疏。\n室近宜人桂，官胜冲尹驴。\n江南热犹剧，岭外比何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过曾季永见壁间张安国所书天下第一真仙之岩知有融州便托附贾季承书作二诗呈季永且怀季承 其一","author":"赵蕃","text":"见井渴已止，投林心更欣。\n行方触炎热，坐觉远尘纷。\n谁满鹓鹭集，子犹麋鹿群。\n融州在何处，壁字带岩云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过潼川之飞乌县见馀干丞相题驿舍诗有感次韵","author":"赵蕃","text":"道学元无伪，标名徒尔劳。\n孤忠天不管，一死世尤高。\n未洗边庭血，先焚董腹膏。\n乱离元有自，附壁为三号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邢氏园池上作","author":"赵蕃","text":"可意于兹夕，乃能来此风。\n稻畦初吠蛤，草岸已鸣虫。\n三径思茅屋，归艎忆钓筒。\n渊明宁隐者，鲁望岂渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邢兄大声以重九日置酒约梁丈仁伯段兄元衡蕃亦与焉赋诗二首 其二","author":"赵蕃","text":"栗里当年节，柯山七字诗。\n举觞非徇俗，怀往要销悲。\n暑络肤侵凛，风巾鬓飒衰。\n多君能醉我，有客更同之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邢兄大声以重九日置酒约梁丈仁伯段兄元衡蕃亦与焉赋诗二首 其一","author":"赵蕃","text":"解印何其勇，五噫谁谓狂。\n云仍有人物，家世未荒凉。\n学造渊骞寝，文推翰墨场。\n论交有如此，敢恨落殊方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邬子对月","author":"赵蕃","text":"庭户容才咫，江湖见每赊。\n秋毫浑可数，纤翳不能遮。\n颇念从此去，还愁兴尽嗟。\n不如沽酒饮，饮醉卧芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问宿","author":"赵蕃","text":"川原泥滑汰，山岭石粗疏。\n经历虽云恶，驰驱不暇徐。\n逢人询野寺，对宿祗村墟。\n薄莫须安止，平明议所如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"两日不见在伯风雨中有怀因以简之","author":"赵蕃","text":"卧闻急雨响林柯，想见江头声更多。\n两日不来百忧集，一杯犹忆醉时歌。\n已孤柿栗霜天熟，其柰衣裘卒岁何。\n掾奉酸寒古云叹，治时还重力田科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"两日随钱丈放舟恬无风浪今日别归仍值逆风作长句寄钱丈","author":"赵蕃","text":"大舸帆高掠浦飞，小舟笪短溯滩归。\n虽云来去难俱遂，自是神人相不违。\n赖得好山看要熟，不妨晚雨落仍微。\n迟回半日夫何叹，于此因知造物机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严从礼折送牡丹且副以诗次韵","author":"赵蕃","text":"几日云昏病亦昏，问春咫尺负名园。\n两枝何自落书几，一笑为之开酒尊。\n怪底江南新种得，未饶洛下旧名喧。\n不然故有栽培力，能使芳根学返魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严先辈诗送红梅次韵","author":"赵蕃","text":"尽道梅花白，能红又一奇。\n浑疑丹换骨，不是酒侵肌。\n看此敷腴色，思侬少壮时。\n盛年虽不再，犹拟岁寒知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯玉夜过因谈西湖石笋峰旧游用初三日韵","author":"赵蕃","text":"相识欣佳士，常谈厌老生。\n湖山游息处，风月笑言情。\n岂但沈疴愈，能令老眼明。\n无嫌数呼唤，政尔一殷兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀干月夜","author":"赵蕃","text":"风月随地有，溪山天下稀。\n临流醒客寐，静夜觉渔归。\n浥浥露侵鬓，飞飞萤点衣。\n鹭鸥栖亦稳，知我故忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀干放舟后作时以病不饮故见之诗","author":"赵蕃","text":"月驶云俱驶，风恬浪亦恬。\n浑如画横轴，又似镜开奁。\n蛮子钓未已，长年行不厌。\n素羸同李贺，止酒效陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"佥判丈两赐新字韵诗因次韵兼简文显","author":"赵蕃","text":"连朝枉诗句，俊逸且清新。\n叹我徒劳思，知公固绝人。\n林园能数驾，风雨未妨辰。\n作底周夫子，关门懒似真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初七日雨殊未沾足作四十字","author":"赵蕃","text":"上天怜久旱，赫日变浓阴。\n要使今年熟，须成三日霖。\n萧疏财却暑，点滴谩过林。\n问我无田客，那怀闵雨心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初二日复雨偶成","author":"赵蕃","text":"秋旱连冬势未平，何期小雨趁元正。\n休论忽忽生为乐，且对欣欣木向荣。\n已分终身乐贫贱，自无岐路觅功名。\n独于诗律存馀习，三日不谈荆棘生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初二日蚤发亲捷","author":"赵蕃","text":"水落滩鸣急，山高雾散迟。\n夜愁馀响递，晨幸日光披。\n颇忆茱萸饮，还思薏苡赍。\n异乡逢物色，老病益清羸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初八日人事少閒命车出游因以寻诗首访滕王阁纷然屠沽思为之败已过东湖得孺子亭亭阁幽邃乃陈阜卿复作者一时诗板甚多择数知名句录之又东数步得孺子祠有像设及曾公衮书南丰所作祠堂记及沈持要重立岁月壁崩粪积殊异敬事迤逦避雨入总持寺谒澹台子羽墓阅雷公祠墓有大篆立于其前祠有乐章无尽所作雨止绝南昌县径还舣舟之地作五诗","author":"赵蕃","text":"细雨微风湖上亭，柳深荷密竞青青。\n生平漫与形神接，客里孤游耳目醒。\n题咏纷纭几诗板，画图零落半幽屏。\n像祠只在荒墩外，小复舆篮更一经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初八日过总持以雨不得观龙井休日再往经孺子亭又过南昌县侧访梅仙旧宅黄冠居之观名屡易今为报恩光孝","author":"赵蕃","text":"满城车马走尘埃，湖上幽蹊长积苔。\n喟叹高风尚千载，殷勤两日为重来。\n吾生讵老五斗米，此地终期三径开。\n大厦崇成非往者，况予拥肿自樗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初十日早立寺门作","author":"赵蕃","text":"春天阴晴无定姿，阴云未卷晴风吹。\n青山表见花颜色，绿竹增添鹭羽仪。\n郭外不知谁是主，眼中今日我题诗。\n人生何物非邮传，敢谓吾庐不在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初五日晚雨欲舣舟大琛而舟行过焉示成父弟","author":"赵蕃","text":"一雨晚来凉，山长水又长。\n寻诗贪屿岛，沽酒误村场。\n萧瑟听连夕，飘流入异乡。\n对眠还晤语，浑忆在山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初见梅怀玉山友弟","author":"赵蕃","text":"江路野梅初折来，班班已有数花开。\n细看浑觉风神在，且老空惊鬓发摧。\n我所思兮千万里，知其趣尔五三杯。\n半年未有音书至，未过衡阳雁已回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初四日同诸公饮饯共叔于株林明日再往共叔为置饭归途赋此寄之","author":"赵蕃","text":"一别定不免，重来聊见情。\n匆匆置朝饭，愦愦困馀酲。\n会合知何日，升沉恐异情。\n毋忘尺书寄，慰此寸心倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏山居有怀长沙从游四首 其四","author":"赵蕃","text":"想见湘西路，扶疏夏木长。\n佛龛钟磬寂，书屋简编香。\n破雾穿晨屦，冲风唤晚航。\n向居嫌是客，今梦却同乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏山居有怀长沙从游四首 其三","author":"赵蕃","text":"府谷我先契，诸公吾辈流。\n悬知盍簪际，颇解忆人不。\n蕙逐光风转，莺啼出谷幽。\n因声烦为我，传写寄荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏山居有怀长沙从游四首 其二","author":"赵蕃","text":"我爱长沙国，全如洛与伊。\n诸公早闻道，老我谩耽诗。\n忆昨相追逐，何知有别离。\n湘西一回首，莽莽便天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏山居有怀长沙从游四首 其一","author":"赵蕃","text":"日者因回使，人才致一书。\n有怀那再写，为况又何如。\n贾傅长沙国，陶公五柳庐。\n文章且难进，可向友朋疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别马庄甫","author":"赵蕃","text":"邂逅成深识，慇勤不作遥。\n鹅湖书后约，汭口骑能招。\n奔逸君诚俊，衰摧我不聊。\n嗜书甘寂寞，破敌看嫖姚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别邢公昭丈","author":"赵蕃","text":"适远能忘别，冲行敢惮泥。\n野航初唤渡，茅屋正啼鸡。\n雨后妨梅步，风前对竹题。\n因公动高兴，忆我旧幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别杨谨仲","author":"赵蕃","text":"篱竹又离箨，沼荷还叠钱。\n我来成伫立，公为起高眠。\n清静子云宅，扶疏陶令篇。\n三年浑易尔，此别各苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别沈二弟","author":"赵蕃","text":"一别动五载，此生能几回。\n其间何不有，祇是恐生哀。\n我病真衰矣，君才盍勉哉。\n要留还索去，风雨更漼漼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别近呈明叔","author":"赵蕃","text":"靖节甘忤俗，子云空解嘲。\n纷纷多面友，了了独心交。\n四海叹浮梗，三年嗟系匏。\n语离无几日，梅蕊况江郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别宗父","author":"赵蕃","text":"许日问何滞，今晨真遂行。\n人生苦飘泊，岁事复峥嵘。\n鹤发欠亡恙，燕雏怜未成。\n临分再三语，不为别离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别范建康","author":"赵蕃","text":"早日学诗才得穷，人穷乃复愧诗工。\n如公久已独步外，顾我何堪猥诵中。\n岁晚人家方墐户，地长客子尚飘蓬。\n如闻深讲救荒政，忍使箪瓢独屡空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别赵叔","author":"赵蕃","text":"汉廷无出右，天下举归心。\n岁晚雪霜干，春馀桃李阴。\n班崇贰卿贵，掾落五溪深。\n勿谓无回雁，邮传可嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别赵信州","author":"赵蕃","text":"拍拍桃花水，轻轻莲叶舟。\n生憎冲野马，失喜见沙鸥。\n漫浪端如此，饥寒信有不。\n未探怀玉蕴，且访九华幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别赵常德","author":"赵蕃","text":"旧诗零落似前生，岂意公能识姓名。\n青眼何堪辱如故，白头自觉已无成。\n普天无复归耕处，薄禄谩为糊口营。\n今日违离定何往，壶头路险更秦城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别徐运使","author":"赵蕃","text":"风声富贵每多偏，造物于公独俾全。\n笑我效颦忘露丑，不知学步返难前。\n侏儒自合奉囊粟，卫尉何曾直一钱。\n我地有饥能任耻，熟闻高义薄云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别晦庵","author":"赵蕃","text":"身堕南州已觉赊，五溪从此更天涯。\n别肠何止成万转，霜鬓不堪今半加。\n颇念客留同此日，绝怜归梦每还家。\n公如踵赴仙都约，犹拟颉颃飞佩霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]