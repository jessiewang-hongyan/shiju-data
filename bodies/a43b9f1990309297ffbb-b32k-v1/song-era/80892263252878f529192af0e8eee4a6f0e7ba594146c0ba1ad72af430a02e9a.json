:"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其十四","author":"赵炅","text":"口爽哀滋味，深思命本根。\n心邪迷妄相，圣法教中言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十三","author":"赵炅","text":"道门长啸扣玄关，咀嚼盈虚口不闲。\n峰顶怡情松作笠，五湖来往看人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十六","author":"赵炅","text":"昆崙山上玉楼前，五色祥光混紫烟。\n景物不同人世界，群仙时醉卧花眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其四十二","author":"赵炅","text":"无名大道气雄雄，日月昭明显圣功。\n舒卷好将浮世誉，亦同天上在人中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其三十二","author":"赵炅","text":"逍遥物外未曾抛，念诵时将玉磬敲。\n虽不临坛深发愿，梦魂常忆大仙教。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其七十七","author":"赵炅","text":"天门地户秘机深，谁测玄微妙理心。\n唯有丹田身外境，清虚恬澹影森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45895,