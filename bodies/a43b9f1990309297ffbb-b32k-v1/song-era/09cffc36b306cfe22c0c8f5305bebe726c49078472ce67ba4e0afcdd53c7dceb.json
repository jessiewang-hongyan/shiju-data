[{"title":"又次韵三绝 其一","author":"李之仪","text":"款步昔陪下泽，剧谈今愧高流。\n又喜秋来相见，暂同南陌东丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵三绝 其二","author":"李之仪","text":"华屋暂离星斗，沧江归弄波涛。\n可得遽通来信，便知却整还舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵三绝 其三","author":"李之仪","text":"旱日能诗传信，新来投笔从班。\n身世且依魏阙，烟云休恋钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旌德王承议挽词","author":"李之仪","text":"彭蠡湖边一笑初，绿衣相见论葭莩。\n四千里外空搔首，三十年来屡揽须。\n方卜他时共兰若，岂知今日奠生刍。\n穷途只有思君泪，无复吟君屋上乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱君倚夫人仙源郡君挽词","author":"李之仪","text":"春生复秋落，物物犹帝力。\n哀哉劬劳恩，甘藟至诚实。\n棘心咏诗人，常恐一旦失。\n何乃不我报，皎皎如白日。\n痛哉胡为生，每念气填臆。\n仰君犹长庚，华发萃众德。\n岁时捧金樽，门户几万石。\n常云我有子，未易先尺璧。\n伯仁非碌碌，到此辄自惑。\n庶几德有相，睥睨莫我逼。\n颇闻君有言，既跌不见谪。\n李杜苟齐名，死且不足惜。\n孰不斯言愧，谓君寿无极。\n岂知属纩书，何为在吾侧。\n堂堂古益友，千载同此室。\n撼铎倘能参，我泪不虚滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俞清老挽词二首 其一","author":"李之仪","text":"生涯真断梗，身世委虚舟。\n直欲超千劫，都将付一沤。\n纵横无滞碍，游戏任沈浮。\n报尽随缘去，聊从一笑休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俞清老挽词二首 其二","author":"李之仪","text":"寒食相披拂，方时欲适然。\n君应寻故约，我亦赴新阡。\n但怪沈来雁，那知已逝川。\n风流有千里，未愧昔人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈氏母夫人挽词二首 其一","author":"李之仪","text":"白首严冰雪，清风逼里闾。\n空残贝叶偈，不见锦囊书。\n表表名终在，诜诜庆有馀。\n会如华夏约，他日看高车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈氏母夫人挽词二首 其二","author":"李之仪","text":"子令人空毁，孙贤我故钦。\n成家信如玉，传世果非金。\n不作寻常去，方知积累深。\n天花长满裓，应悟本来心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂挽诗四首 其一","author":"李之仪","text":"报地三千箓，年光八十春。\n却寻来处路，重接社中人。\n杖履空平日，幢幡想去尘。\n莲开布金底，又见一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂挽诗四首 其二","author":"李之仪","text":"方报先同穴，俄闻改葬期。\n祇应偕老约，不拟异他时。\n已矣如何憾，贤哉有剩悲。\n会看松柏路，赐篆耸丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂挽诗四首 其三","author":"李之仪","text":"汉室传经后，唐朝旧族家。\n柔明惟典则，专静辍纷华。\n得配同高寿，流光固未涯。\n定应知去路，门外列三车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂挽诗四首 其四","author":"李之仪","text":"子令钦平昔，多惭接俊游。\n升堂称有志，执奠叹无由。\n逝水空归壑，春风忽变秋。\n箫声到原尽，千载想风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观世音赞","author":"李之仪","text":"大慈大悲大威德，补陀落山住孤绝。\n三界轮回若热恼，一闻我名便清凉。\n名虽可闻见不得，随所建立即如见。\n施者受者不退心，常如心在光明里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩居士赞","author":"李之仪","text":"毗耶离城，此去几许。\n一睹慈光，如到其所。\n八万四千，翻风驾雨。\n枯者即荣，堕者斯举。\n周遍恒沙，了无一语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧严永长老赞","author":"李之仪","text":"我昔同登法云地，道场不异耆闇山。\n指出后身自在通，当日曾闻新受记。\n秀眉明目坏色衣，谁其写成比丘相。\n只这便是紫金容，在在处处咸恭敬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西庵琳老真赞","author":"李之仪","text":"西庵老人，谁不赞叹。\n东辙西蹊，路头坐断。\n维三昧力，化身千百。\n北雨南云，青天霹雳。\n岂待形容，何处不见。\n须知闹市里，便是百草头荐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常州荐福琄老真赞","author":"李之仪","text":"无形而袭人之鼻者香，不谋而同人之舌者名。\n名因香而及远，香因名而有声。\n然则红梅老子固如是乎。\n投闇即闇，投明即明。\n随波逐浪，应物观形。\n夫是之谓驴手佛脚，而真得无学于保宁者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门大师真赞","author":"李之仪","text":"织得蒲鞋无脚著，大雪漫山却伸脚。\n嬲人枉了三则语，传家只用一字错。\n至今儿孙满天下，伸头缩颈如鹳鹤。\n捩转嘴面有商量，学得马骑被驴扑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪峰真赞","author":"李之仪","text":"衮毬输了一只脚，答语失了一只眼。\n却将两只杀人手，不妨捞虾只摸蚬。\n踏翻船子月是谁，撞破烟楼如掣电。\n树倒藤枯笑呵呵，春光更觉家家遍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦堂宝觉真赞","author":"李之仪","text":"不勉而中，不思而得。\n从容中道，是为极则。\n胡来胡现，汉来汉现。\n随所运用，莫非方便。\n在迩求远，知深昧浅。\n头上安头，以口为眼。\n以相而现，略无异同。\n一有所扣，则犹撞钟。\n缘不我契，漫尔形容。\n稽首导师，如日方中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李太白赞","author":"李之仪","text":"龙不可收，虎不可缚。\n矫矫世路，彼自清浊。\n醉遣脱靴，孰贵孰贱。\n弄月沧波，万顷一线。\n图画如好，虽曰糟粕。\n对之超然，鲸尾欲捉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姑溪自赞 其一","author":"李之仪","text":"蒿目以游千世，铁心以践其志。\n有时端委以即事，忽尔卖针而买醉，岂所谓逆行顺行莫测者欤。\n盖得之自是不得，是以听天命而已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姑溪自赞 其二","author":"李之仪","text":"偶乘扁舟，一日千里。\n若遇胜境，终年不移。\n故能屈御手调羹而亲饷，命力士脱靴而不疑。\n予私淑诸人也，故欲与之同归。\n鸦然于腮而不售，羊然绕领而犹痴。\n人固欲其售，尔谓之痴也，予方游戏以随时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李伯时画姑溪濯足图赞","author":"李之仪","text":"濯余足兮寒泉，振余衣兮古丘。\n洞胸中之滞碍，眇云散而水流。\n识此行之非祸，乃造物之予休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董曼老画姑溪赞","author":"李之仪","text":"野老形容，公子刷砑。\n谓俗则数珠挂于臂上，谓僧则髭须满于颔下。\n以我为牛则为之牛，以我为马则为之马。\n不妨随俗流通，何必分真辨假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李伯时画马赞","author":"李之仪","text":"饮不以鼻，投不以趾。\n虽梦亦然，理自应尔。\n吾师东坡，尝有是语。\n天机所同，惟伯时父。\n东坡形容，伯时位置。\n曹韩少陵，俱落第二。\n吾私淑诸，限隔九泉。\n笔头落处，几至潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送戴道人","author":"李之仪","text":"懒将身世问穷通，邂逅僧轩一席同。\n已叹故家如坠叶，可堪白发共飘蓬。\n冥搜固出能言外，妙用都归指掌中。\n咫尺京师莫辞远，有云何患不乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏花亭致语口号","author":"李之仪","text":"绿阴初合燕归来，煮酒新尝换拨醅。\n不独江山想王谢，须知宾客尽邹枚。\n十分欢意休教剩，万斛愁心亦自开。\n倒载任他路人笑，更将何处作春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还俗道士","author":"李之仪","text":"闻道华阳客，儒衣谒紫微。\n旧山连药卖，孤鹤带云归。\n柳市名犹在，桃源梦已稀。\n还家见鸥鸟，应愧背船飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"李之仪","text":"美人在时花满堂，美人去后留空床。\n床上绣衾闲不寝，至今三载犹馀香。\n香亦竟不灭，人亦竟不来。\n相思复相忆，白露湿苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋秀远堂","author":"赵德孺","text":"翰林李谪仙，埋骨青山下。\n平生爱此山，老去终不舍。\n放逐鹓鹭行，追随鸡黍社。\n文采今尚存，英风满松槚。\n寥寥五百年，好尚世所寡。\n韩子荆州后，为求袭良冶。\n乃祖当时辈，异代同潇洒。\n结堂山之阳，真趣非少假。\n秀色来天外，远势包平野。\n烟岚浮翠黛，揽之不容把。\n徜徉盘谷游，屡请秣吾马。\n时无谪仙人，登临谁赋者。\n九原如可作，一奠招魂斝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中隐庵","author":"赵德孺","text":"在昔避世贤，隐居岂自喜。\n甘守西山饿，清洗颍阳耳。\n一旦事高尚，万古激贪鄙。\n孰谓乐山林，便可轻朝市。\n窃笑效颦人，不知捧心美。\n妄将凡庸姿，敢希明哲轨。\n盗此嘉遁名，纷若干时子。\n仕途指捷径，矫伪污青史。\n圣朝扬仄陋，采录无遐迩。\n不遗下体葑，况乃中乡芑。\n多士生此时，贫且贱焉耻。\n梦自傅岩来，猎从渭滨起。\n隐君闻此风，翻然乌可已。\n聊为知者道，庶达名庵旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其一","author":"周彦质","text":"正朝排仗谨天元，常服无令入禁阍。\n十样冠裳五千袭，紫宸前殿对诸蕃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二","author":"周彦质","text":"大内相连辟迩英，每延禁从侍谈经。\n君王克谨持盈戒，无逸新书易画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三","author":"周彦质","text":"君王端的似唐虞，仁政天心若合符。\n不独四方传瑞牒，灵芝甘露满皇都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四","author":"周彦质","text":"圣主词章尽典谟，宫嫔一一究诗书。\n如今转觉西京陋，只说班家有婕妤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五","author":"周彦质","text":"主上慈仁笃友于，二王恩眷古无如。\n外朝迥与班联别，玉带仍令佩玉鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六","author":"周彦质","text":"圣人制作合天规，大晟初成按乐时。\n果见晴空鸾鹤舞，未饶当日凤凰仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七","author":"周彦质","text":"圣主词源涌巨澜，恤民手诏月常颁。\n一回传出惊新丽，多少词臣愧汗颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八","author":"周彦质","text":"万里封疆匝普天，君王神武不开边。\n河西房下文书少，枢府经年罢密宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九","author":"周彦质","text":"圣主威声慑四溟，洮湟鄯廓指呼平。\n如今都护无公事，但奏诸藩进奉名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十","author":"周彦质","text":"四海丰登五纬明，君王高拱守盈成。\n词臣合进烝崧颂，更向何年咏太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十一","author":"周彦质","text":"五云楼阙耸天颜，龙烛交光万寿山。\n缥缈祥风来帝所，御香时得到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十二","author":"周彦质","text":"稀微斜照影鳌山，黼座高临缥缈间。\n共祝吾皇千万寿，年年华阙觐天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十三","author":"周彦质","text":"太一元宵驾幸初，喧阗丝管拥銮舆。\n主家夹道金车驻，步障徐开奏起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十四","author":"周彦质","text":"圣主忧勤尽至仁，玉炉清夜拱星辰。\n谁知漏永虔祈处，不为皇躬只为民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十五","author":"周彦质","text":"元宵鼓吹满严城，万烛荧煌御驾行。\n才入端门回凤辇，两军游艺一齐呈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十六","author":"周彦质","text":"洛阳花使款银台，魏紫姚黄次第来。\n调护须知青帝力，进呈方是十分开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十七","author":"周彦质","text":"圣主忧民手诏书，颁宣经月罕尝虚。\n周旋曲尽斯民瘼，远使观风未必如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十八","author":"周彦质","text":"华封献祝协休祥，已见诜诜十七王。\n宗德祖公钟圣世，子孙千亿正蕃昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其十九","author":"周彦质","text":"千官班列未央宫，称贺盐池课复充。\n助顺固知天地力，由来威断自宸衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十","author":"周彦质","text":"宫嫔春昼步庭前，曲砌轻风?柳绵。\n二十四番花信后，融怡还作困人天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十一","author":"周彦质","text":"文思主吏籍通闺，逐节供须各品题。\n知是禁园挑菜日，雕床十扛进金篦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十二","author":"周彦质","text":"君王博学古无如，羲献奇踪购得初。\n裁处万机无一事，睿思深殿自临书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十三","author":"周彦质","text":"吾君友爱古难方，棣萼深情不暂忘。\n求得万机休暇日，披香深殿燕亲王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十四","author":"周彦质","text":"未明冠佩集龙楼，上宰貂蝉导冕旒。\n羌虏欢呼瞻盛礼，躬迎八宝受天休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十五","author":"周彦质","text":"初升直笔喜迁官，妙札何曾数彩鸾。\n莫谓纤纤持管弱，风雷雨露在毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十六","author":"周彦质","text":"绣襟金钩玉轴斜，宫娥当殿奏琵琶。\n急弹犀拨如飞电，端不轻侵御画花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十七","author":"周彦质","text":"新拜贤妃国媛才，穹崇品秩视三台。\n捧麻入谢天恩后，院院嫔嫱展贺来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十八","author":"周彦质","text":"后苑繁花间绿杨，龙楼辉赫缕金装。\n遥知黼座登临处，栏楯狻猊尽吐香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二十九","author":"周彦质","text":"翠弁仙衣下玉廊，修真宫女夜焚香。\n舒徐有月随莲步，绰约无人见靓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十","author":"周彦质","text":"诏许珠玑饰珥钿，遐方翡翠贡都捐。\n九重一语天恩博，亿万珍禽性命全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十一","author":"周彦质","text":"神都三月盛风光，修禊宫中乐事长。\n银字笙簧随步辇，相将曲水侍流觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十二","author":"周彦质","text":"春昼阴添一倍长，鞦韆娱乐集嫔嫱。\n綵缯画板高高送，来去随风散异香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十三","author":"周彦质","text":"樱桃初进绿筠笼，蜜酪随供綵帕蒙。\n靸面金盘五十只，传宣先赐二王宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十四","author":"周彦质","text":"圣主仪刑自智临，嫔嫱博古趣何深。\n金虬香里芸窗静，满几诗书一弄琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十五","author":"周彦质","text":"祝应多男属圣君，词臣常备洗儿文。\n高禖喜燕排旬有，包子红绡叠日分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十六","author":"周彦质","text":"春晴太液漾漪涟，柳绿花明艳冶天。\n十二栏干帘半捲，瑶津亭下按龙船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十七","author":"周彦质","text":"宫阁春来乐事添，喜逢新燕入高檐。\n从今欲使营巢便，故遣终朝不下帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]