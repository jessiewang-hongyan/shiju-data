[{"title":"元夕八首 其六","author":"陈世崇","text":"女童清乐玉琮琤，一道群丝缓合笙。\n更看苏家坊傀儡，软风娇送杵歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕八首 其五","author":"陈世崇","text":"买市今宵看帅臣，九衢车马隘香尘。\n欢呼百姓同沾惠，无限搀行卖卜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕八首 其四","author":"陈世崇","text":"麝圆䭔拍澄沙团，馉饳糖霜乳橘盘。\n蕉叶柿花宜利少，叫声浑杂市声欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕八首 其三","author":"陈世崇","text":"风飘蹀躞步摇轻，相唤相呼去看灯。\n笑整玉梅藏素手，香肩三角卸吴绫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕八首 其二","author":"陈世崇","text":"苍头喝道烛光微，梅压乌云柳压眉。\n打块成团娇又颤，闹蛾簇簇翠冠儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕八首 其一","author":"陈世崇","text":"看灯螃蟹月前供，迓鼓金销画领中。\n帘捲重楼灯乍试，柳稍风暖雪初融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾氏诸帖","author":"陈世崇","text":"南丰而后艇斋君，忠义词章萃一门。\n手泽流芳凌劫火，钦承犹得到来孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与士繇游金山翼日分袂二绝 其二","author":"陈东","text":"京口瓜洲一水间，秋风重约到金山。\n江山自为离人好，不为离人数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与士繇游金山翼日分袂二绝 其一","author":"陈东","text":"早别金山恰晓钟，离帆分破一江风。\n瓜洲渡口波声远，后夜相思明月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邵予可弹琴二首 其二","author":"陈东","text":"漫说朱弦大古清，政无矇瞽在周庭。\n高山流水本无事，安用区区里耳听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邵予可弹琴二首 其一","author":"陈东","text":"雷公徽玉粲明星，照出师襄指下声。\n可怜此地无人识，唤作新来黑瘦筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邵予可卖俸豆","author":"陈东","text":"休论斥卤与膏腴，豆藿连阡稻麦无。\n举世纷纷宝鱼目，投人慎勿以明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮二绝 其一","author":"陈东","text":"笋芽鹅炙殊可口，明月清风不着钱。\n坐对青州一从事，共君今夜不须眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"律诗三十韵仅存二韵","author":"陈东","text":"山岳遭埋没，乾坤着蔽蒙。\n已成堆积势，渐费扫除功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偶题","author":"陈东","text":"驱除睡思茶瓯外，收拾春光酒盏中。\n万种穷愁浑不问，世间此乐几人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶","author":"陈东","text":"偏爱君家碧玉盘，建溪云脚未尝乾。\n书生自恨无金换，聊以诗章乞数团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人丧二绝 其一","author":"陈东","text":"欲认青帘索酒尝，俄惊丹旐送君丧。\n吕庄编户伤心切，愁对清风想杜康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐氏哀词代作","author":"陈东","text":"忆昔常随祖母过，登堂共庆尚垂胡。\n十年未远皆流荡，地下相逢果有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颖川二绝 其二","author":"陈东","text":"我来颖川何所见，青青古柏古城傍。\n知是荀陈手亲植，令人不觉泪行行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴公辅庵","author":"陈东","text":"一径萦回屋数间，我来聊欲寄清闲。\n道人杖履知何处，空锁烟霞万叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与虞章舜卿二表弟季明游兼胜亭有作三律 其二","author":"陈东","text":"野旷湖山远，林深松竹幽。\n旧题看壁立，前事逐萍浮。\n荏苒荒三径，依稀度九秋。\n故人应念我，雅会莫迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与虞章舜卿二表弟季明游兼胜亭有作三律 其三","author":"陈东","text":"三子皆吾弟，阿章才更豪。\n风流江左旧，句法杜陵高。\n雅志在五马，壮心连六鳌。\n时哉偶未与，日且醉金舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与虞章舜卿二表弟季明游兼胜亭有作三律 其一","author":"陈东","text":"危亭兼雅胜，胜景足奇观。\n湖水涵天入，山云带雨蟠。\n千松偃夜月，万竹撼春寒。\n玉井汲甘冷，尘缘那得干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同舍李冲寿夜坐","author":"陈东","text":"时引金杯拔剑看，光芒高彻斗牛寒。\n要令世事从心淡，可谓人情彻鼻酸。\n经术岂应穷皓首，文章何用苦雕肝。\n吾徒行与功名会，莫作羁人日夜叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彦隽母挽章二首 其二","author":"陈东","text":"少驰贤孝誉，来配颍川家。\n虽夺共姜誓，曾无贤母瑕。\n一乡蒙爱惠，百口藉生涯。\n享福踰中寿，归与勿怨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彦隽母挽章二首 其一","author":"陈东","text":"人生五福古难全，天赋夫人独不偏。\n内行无惭诗妇孝，母仪何啻穆姜贤。\n庭帏已叹芳魂独，宗族空留旧事传。\n惟有南陔多少恨，忍看松柏锁寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜独坐有感一章奉呈师说令尹奉议光明主簿虞章","author":"陈东","text":"依依客馆夜燃膏，子夜羁愁无处逃。\n闲炷炉香听夜雨，快斟杯酒读离骚。\n休惊时节云何速，独吊古人殊不遭。\n一阵晓寒催画角，朝来爽气碧山高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄仲达归温州仍寄诸友","author":"陈东","text":"长安市上喜相逢，倾盖恩情久要同。\n几载暌违劳想梦，一樽邂逅写情衷。\n家山柑橘正酣露，江岸帆樯忽饱风。\n归去借声询旧友，项髯方浪薛芹宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自许昌如蔡与石士繇酌别一章","author":"陈东","text":"太学诸生出许昌，抱关夫子特相将。\n轻衣短帽秋风里，瘦马羸童古柳傍。\n黄叶翻翻惨离思，浊醪沃沃浇愁肠。\n欲知此别情怀恶，正是平生气味长。\n公归且作诗书伴，我去还依鸿雁行。\n酒阑径渡石桥子，回首高城挥夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大雪与同舍生饮太学初筮斋","author":"陈东","text":"飞廉强搅朔风起，朔雪飘飘洒中土。\n雪花着地不肯消，亿万苍生受寒苦。\n天公刚被阴云遮，那知世人冻死如乱麻。\n人间愁叹之声不忍听，谁肯采摭传说闻达太上家。\n地行贱臣无言责，私忧过计如杞国。\n揭云直欲上天门，首为苍生讼风伯。\n天公倘信臣言怜世间，开阳阖阴不作难。\n便驱飞廉囚下酆都狱，急使飞雪作水流潺潺。\n东方日出能照耀，坐令和气生人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尹馆作此觅酒召李顺之饮","author":"陈东","text":"今日天色恶，酒壶恰已空。\n何来进童子，挈榼问主翁。\n主翁正对客，兀坐书堂中。\n诸生功课毕，鼓瑟歌醉翁。\n爱酒欲出门，杖头无青铜。\n春衣典又尽，搜索计已穷。\n酒兴不可遏，不免作诗呼进童。\n空壶挈将纳宅库，为我却致䨥灰红。\n得酒须寻爱酒伴，更烦与召陇西翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵士繇惜别","author":"陈东","text":"男儿自有四方志，离别岂能动刚肠。\n功名未遂身未死，白眼青青频举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏桃花菊一章","author":"陈东","text":"潘郎尝望尘，陶令亟避俗。\n胸中定何如，清浊在一瞩。\n河阳艳桃春，彭泽郁秋菊。\n所好邈如许，二子殊品目。\n诗人易评量，忍使混衡斛。\n当使冰鉴磨，要遣须眉烛。\n勿容脂粉姿，滥入圭璋录。\n神仙真渺茫，浪说武陵谷。\n不如临清潭，饮水乐自足。\n谁令春雨红，点污秋株绿。\n寒根岂无知，风霜怒应蓄。\n令尹非安仁，腰带肯轻束。\n脱巾漉酒浆，黄花泛新馥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮二绝 其二","author":"陈东","text":"欣然有意引陶潜，此意何妨俗士嫌。\n三百青钱亦希有，速将趁取夜厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人丧二绝 其二","author":"陈东","text":"初成大厦势巍巍，有意于门驷马车。\n未乾壁土君先已，贺燕翻随吊鹤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒王乐道之子闻方饭绝客一绝","author":"陈东","text":"晚生恨不及前辈，来访诸郎观典型。\n吐握风流何寂寞，满林风竹自秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢温州黄仲达送鄂州瓜齑","author":"陈东","text":"黄夫子从汶上来，三束瓜齑送风土。\n应知我亦困齑盐，肯食沽酒与市脯。\n食肉者鄙无远谋，甲第纷纷何足数。\n饭蔬饮水真乐哉，千古风流想尼父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋黄鲁直买米帖","author":"陈东","text":"广文弦歌饭不足，要是古来贤达人。\n山谷有钱能买米，比之鲁公殊未贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颖川二绝 其一","author":"陈东","text":"我家本出颖川住，几世不曾归颍川。\n今我暂来忽暂去，太丘风流谁与传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 七夕","author":"陈东","text":"我笑牛郎织女，一年一度相逢。\n欢情尽逐晓云空。\n愁损舞鸾歌凤。\n牛女而今笑我，七年独卧西风。\n西风还解过江东。\n为报佳期入梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"陈东","text":"风动一轩花竹，琅玕青锦薰笼。\n怜才自是宋墙东。\n更识琴心挑弄。\n暮雨乍收寒浅，朝云又起春浓。\n冰肌玉骨信俱融。\n不比巫山闲梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦刷子","author":"陈东","text":"谁斫碧琅玕，影撼半庭风月。\n尚有岁寒心在，留得数根华发。\n龙孙受戏碧波涛，喜动清风发。\n到得浪花深处，□一瓯香雪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 元夕","author":"陈东","text":"半生羁旅，几度经元夜。\n长是竞虚名，把良宵、等闲弃舍。\n去年元夜，道得□身闲，依旧是，客长安，寂寞孤眠者。\n今年元夜。\n也则非乡社。\n却有人□约，携手□、灯前月下。\n那知风雨，此事又参差，成怨恨，独凄惶，清泪潸然洒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"保应庙","author":"陈东之","text":"投迹空山计已非，江都消息乱来稀。\n庙前几种春香草，错怪王孙去不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游沃洲山","author":"陈东之","text":"我本名山人，屡作名山兴。\n天台一住三十年，尽日扪萝陟云磴。\n上揽四万八千丈之高秋，参差明河两肩并。\n下瞰三百六十度之朝暾，灭没飞烟八荒净。\n或随仙气得丹床，双阙夜深看斗柄。\n今年积雨天地晴，一策快作西南征。\n沃洲最佳天姥胜，连山直下秋峥嵘。\n竹萌修纤会稽箭，芝茎菌蠢商山英。\n秋阳不碎空翠影，绝壑倒泻银河声。\n山腰细路如丝直，三两渔樵行落日。\n炊烟暝色小茅屋，松子秋声断崖石。\n溪流饭屑胡麻香，土软春膏霜朮白。\n送书松际有猿公，问酒涧阴多木客。\n青冥楼阁仙人家，郁蓝流光泻晴碧。\n霓旌队下鹤万群，绛节朝回云五色。\n人间但有桃花源，桃花春香流水浑。\n三生凡骨不得到，两耳夜半空听猿。\n李白寻真不得返，支遁卜筑远费钱。\n至今山灵护光怪，石萝山薜馀秋妍。\n陈郎故宅更深閟，鸡犬林塘隔尘世。\n清秋著屐一登之，路僻夕阴门半个。\n盘陀石在长楠阴，脱略尘缨换秋意。\n晴窗示我两山图，老眼摩挲观一二。\n便挥健笔写我诗，惜哉赏音今绝稀。\n谪仙一去五百载，人间山水无清辉。\n旧时仙人白云唱，怪我白首归何时。\n我生白首历浩劫，眼中亿万虫沙春梦非。\n陈郎挽我十日住，掉头不顾自有南山期。\n餐霞绝粒鍊精魄，长生之学非荒嬉。\n三千年前有宿约，来已不早归不迟。\n长揖群仙谢儿辈，倒挟万里冥鸿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思","author":"陈东甫","text":"花深深。\n柳阴阴。\n度柳穿花觅信音。\n君心负妾心。\n怨鸣琴。\n恨孤衾。\n钿誓钗盟何处寻。\n当初谁料今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南","author":"陈东甫","text":"芳思远，南苑惜春时。\n翠柳枝柔金笛怨，碧桃花老玉笙悲。\n风日正迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"陈东甫","text":"西风竹。\n风入翠烟□矗。\n红小阑干知几曲。\n声声敲碧玉。\n窗下凤台银烛。\n断梦已惊难续。\n曾伴去年庭下菊。\n夜阑听雨宿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿黎拙翁","author":"陈仪庆","text":"名重河汾道更尊，只将拙日养吾存。\n南州佳士争倾盖，阙里诸生半在门。\n一笑何妨延贺客，六旬今已见曾孙。\n斯文寿脉天同久，挺挺霜松傲岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过武侯庙","author":"陈古","text":"群雄角逐自驱除，邂逅真龙起畏途。\n材并管萧非亚匹，气吞曹马直庸奴。\n两朝冠盖尊元老，千载风云屈壮图。\n天欲鼎分终割据，可怜忧国竟捐躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"志怪","author":"陈古遇","text":"沉沉万仞渊，下有骊龙珠。\n佩之寿松乔，售之富侔都。\n贪夫临渊羡，重利轻微躯。\n百金不龟药，千金水犀珠。\n丹砂与翠羽，陆产海所无。\n赍装涛浪中，巨阙光炯如。\n粲粲两青童，骈肩问所须。\n再拜上珠翠，敢问龙起居。\n青童粲玉齿，云龙卧玄虚。\n为君穷珠山，鞭云取长驱。\n云急风更恶，苍梧来时徐。\n丹药两须失，哀哉饱鲸鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫饮酒","author":"陈古遇","text":"莫饮酒，酒醒骂人绕盆走。\n酒香入脑头欲旋，骂声渐低涎落口。\n草履有长短，伸脚可试否。\n未论身后五车书，已随生前一杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马别主","author":"陈古遇","text":"马别主兮，涕泗沾臆。\n士别主兮，喜见颜色。\n于嗟马兮，胡恋而驻。\n于嗟士兮，胡弃而背。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中冬至","author":"陈必复","text":"读易烧香自闭门，懒于世故苦纷纷。\n晓来静处参生意，春到梅花有几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归来","author":"陈必复","text":"小笠轻蓑卧短篷，晓歌楚曲和渔翁。\n片帆自识归来路，借得清江一钓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜轩纳凉","author":"陈必复","text":"银床破睡雾笼纱，翠簟湘纹捲浪斜。\n小院夜深凉似水，一池明月浸荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽兴","author":"陈必复","text":"自折疏花插小瓶，醉眠明月读骚经。\n白云也识幽人意，分与秋山一半青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居","author":"陈必复","text":"接砌斜通径，缘篱矮结墙。\n地卑蜗篆壁，山暖蜜分房。\n过雨林亭静，落花春昼长。\n幽居差省事，犹有课诗忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书西斋几","author":"陈必复","text":"半枕午窗梦，一声啼鸟清。\n雨深花有恨，春老柳无情。\n退觉身名重，閒知世事轻。\n杜门非谢客，懒甚阙将迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书斋戏题","author":"陈必复","text":"数檐隙地葺幽斋，小作轩窗傍竹开。\n行蚁上缘风折笋，饥鸦争啄雨残梅。\n闭门惟有读书乐，爱客苦无佳士来。\n最忆西湖柳阴底，扁舟欲去尚徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月十三日偶成","author":"陈必复","text":"富贵真同一蚁丘，宠荣多处独多忧。\n静观草木自生意，晚爱溪山多胜游。\n竹岂有情那得醉，鸡宁解语亦能愁。\n纷纷数子成何事，只合求田问舍休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百五节","author":"陈必复","text":"独游苦无侣，偶步到前川。\n春水绿于染，山花红欲然。\n冷烟寒食月，小雨浴蚕天。\n此去嬉游少，风光又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日酌悠然赋坐客悠字韵","author":"陈必复","text":"东风第一番春游，白袷清樽半日休。\n花气未醒蜂蝶懒，宿寒犹殢雨云愁。\n人烟带郭居全少，林沼当轩趣迥幽。\n吟过小桥归梦晚，乱钟何处思悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东吴逆旅","author":"陈必复","text":"他乡又寒食，牢落动归心。\n世事少如意，明时无赏音。\n江湖千里客，桑柘一春深。\n昨夜还家梦，西窗见绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东野故居","author":"陈必复","text":"先生高隐地，遗迹尚堪寻。\n出郭祇疑近，入村还觉深。\n秋光淡平野，暝色带遥岑。\n几度祠边过，诗成不敢吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出郭","author":"陈必复","text":"泥深留屐齿，出郭少人行。\n远磬含馀韵，疏帘透薄明。\n浮云时态异，流水世情轻。\n只读南华了，年来悟养生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]