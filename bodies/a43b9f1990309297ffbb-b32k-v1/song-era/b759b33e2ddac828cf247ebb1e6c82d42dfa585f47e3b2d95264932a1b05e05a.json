[{"title":"太平州作二首 其一","author":"黄庭坚","text":"欧靓腰支柳一涡，小梅催拍大梅歌。\n舞馀片片梨花雨，奈此当涂风月何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆邢惇夫","author":"黄庭坚","text":"诗到随州更老成，江山为助笔纵横。\n眼看白璧埋黄壤，何况人间父子情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句：诗二句","author":"苏轼","text":"东家近新富，满地布苔钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木龟亭留题","author":"黄庭坚","text":"南台西路木龟坊，乃是灵蛙赑屃藏。\n从此改名杉蚵蚾，恐来吞月直须防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王才元舍人许牡丹求诗","author":"黄庭坚","text":"闻道潜溪千叶紫，主人不剪要题诗。\n欲搜佳句恐春老，试遣七言赊一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王立之以小诗送并蒂牡丹戏答二首 其二","author":"黄庭坚","text":"露晞风晚别春丛，拂掠残妆可意红。\n多病废诗仍止酒，可怜虽在与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王立之以小诗送并蒂牡丹戏答二首 其一","author":"黄庭坚","text":"分送香红惜折残，春阴醉起薄罗寒。\n不如王谢堂前燕，曾见新妆并倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王立之承奉诗报梅花已落尽次韵戏答","author":"黄庭坚","text":"南枝北枝春事休，榆钱可穿柳带柔。\n定是沈郎作诗瘦，不应春能生许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王厚颂二首 其二","author":"黄庭坚","text":"夕阳尽处望清闲，想见千岩细菊斑。\n人得交游是风月，天开图画即江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王厚颂二首 其一","author":"黄庭坚","text":"八风动摇人不闲，五羖自鬻鬓毛斑。\n文章书画当富贵，惟有如今至乐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见二十弟倡和花字漫兴五首 其五","author":"黄庭坚","text":"池面白鱼吹落絮，□□□□退枯花。\n无因光禄赐官酒，且学潞公灌蜀茶。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见二十弟倡和花字漫兴五首 其四","author":"黄庭坚","text":"邺城也似洛城阔，□□园林学养花。\n欲把一樽随饮处，□□处处锁官茶。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见二十弟倡和花字漫兴五首 其三","author":"黄庭坚","text":"睡起草玄三亩宅，无人载酒眼昏花。\n不知谁劝路门讲，天上日长坐赐茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见二十弟倡和花字漫兴五首 其二","author":"黄庭坚","text":"官驼鸣铎逐盐车，只见风尘不见花。\n空作江南江北梦，辛夷踯躅倚山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见二十弟倡和花字漫兴五首 其一","author":"黄庭坚","text":"落絮游丝三月候，风吹雨洗一城花。\n未知东郭清明酒，何似西窗谷雨茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙留别","author":"黄庭坚","text":"折脚铛中同淡粥，曲腰桑下把离杯。\n知君不是南迁客，魑魅无情须早回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世弼病方家不善论蛤蜊之功戏答","author":"黄庭坚","text":"伯乐无传骥空老，重华不见士长饥。\n从来万事乖名实，岂但药翁论蛤蜊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东林寺二首 其二","author":"黄庭坚","text":"胜地东林十八公，庐山千古一清风。\n渊明岂是难拘束，正与白莲出处同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东林寺二首 其一","author":"黄庭坚","text":"白莲种出净无尘，千古风流社里人。\n禅律定知谁束缚，过溪沽酒见天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东禅长老梦偈","author":"黄庭坚","text":"伐木丁丁斧下鸣，隔溪便应谷中声。\n不因蘋末微风起，漂影溪光本自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代二螯解嘲","author":"黄庭坚","text":"仙儒昔日卷龟壳，蛤蜊自可洗愁颜。\n不比二螯风味好，那堪把酒对西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出礼部试院王才元惠梅花三种皆妙绝戏答三首 其三","author":"黄庭坚","text":"病夫中岁屏杯杓，百叶缃梅触拨人。\n拂杀官黄春有思，满城桃李不能春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出礼部试院王才元惠梅花三种皆妙绝戏答三首 其二","author":"黄庭坚","text":"舍人梅坞无关锁，携酒俗人来未曾。\n旧时爱菊陶彭泽，今作梅花树下僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出礼部试院王才元惠梅花三种皆妙绝戏答三首 其一","author":"黄庭坚","text":"城南名士遣春来，三月乃见腊前梅。\n定知锁著江南客，故放绿阴春晚回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园步折梅寄君庸","author":"黄庭坚","text":"林中破笑派雪雨，不著世间笑粉尘。\n覆入晓风香满袖，无人同咏一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史彦升送春花","author":"黄庭坚","text":"千林摇落照秋空，忽散秾花在眼中。\n蝶绕蜂随俱入座，君家女手化春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四休居士诗三首 其一","author":"黄庭坚","text":"富贵何时润髑髅，守钱奴与拘官囚。\n太医诊得人间病，安乐延年万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁子与追和予岳阳楼诗复次韵二首 其二","author":"黄庭坚","text":"轩皇乐罢拱朝班，天地为家不闭关。\n惟有金炉紫烟起，至今留作御前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁子与追和予岳阳楼诗复次韵二首 其一","author":"黄庭坚","text":"去年新霁独凭栏，山似樊姬拥髻鬟。\n个里宛然多事在，世间遥望但云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡斋二首 其二","author":"黄庭坚","text":"成巢不处避岁鹊，得巢不安呼妇鸠。\n金钱满地无人费，一斛明珠薏苡秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡斋二首 其一","author":"黄庭坚","text":"生平浪学不知株，江北江南去荷锄。\n窗风文字翻叶叶，犹似劝人勤读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原宴坐二首 其二","author":"黄庭坚","text":"黄落委庭观九州，虫声日夜戒衣裘。\n金钱满地无人费，一斛明珠薏苡秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原宴坐二首 其一","author":"黄庭坚","text":"老作儒生不解事，江南有田归荷锄。\n北窗风来举书叶，犹似劝人勤读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉笥山","author":"黄庭坚","text":"上天下地似探梯，怪石巉岩衬马蹄。\n拟是客程行不得，隔林犹听杜鹃啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵戏公静","author":"黄庭坚","text":"偶逢携酒便与饮，竟别我为何等人。\n兔月龙团不当惜，长卿消渴肺生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"黄庭坚","text":"韭苗香煮饼，野老不知春。\n看镜道如咫，倚楼梅照人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵 其一","author":"黄庭坚","text":"春工调物似盐梅，一一根中生意回。\n风日安排催岁换，丹青次第与花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵 其三","author":"黄庭坚","text":"酒有全功笔有神，可将心付白头新。\n春盘一任人争席，莫道前衔是近臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其四","author":"黄庭坚","text":"延和西路古槐阴，不隔朝宗夙夜心。\n公有胸中五色线，平生补衮用功深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其三","author":"黄庭坚","text":"万国归心天不言，诸儒争席异临轩。\n圣功典学形歌颂，更觉曹刘不足吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其二","author":"黄庭坚","text":"风棂倒影日光寒，尧日当中露正乾。\n殿上给扶鸣汉履，螭头簪笔见秦冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其一","author":"黄庭坚","text":"隆儒殿阁对横经，咫尺清都雨露零。\n见说文星环北极，人间无路仰天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答吉老二首 其二","author":"黄庭坚","text":"贤劳王事一归休，霜落园林失九秋。\n想得君家乌鹊喜，蛛丝萦绕玉搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答吉老二首 其一","author":"黄庭坚","text":"水宿风餐甚劳苦，勉旃吾子富春秋。\n我愧疲民欲归去，麦田春雨把锄头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其十","author":"黄庭坚","text":"滞梦停愁乱性灵，安眠灭念闭幽扃。\n体中忽觉有佳处，读易一篇如酒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其九","author":"黄庭坚","text":"双盘锦带丁香结，窄袖春衫甘草黄。\n旧赠恐能开宝匣，新年时候梦残妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其八","author":"黄庭坚","text":"风光琰琰动春华，回首烟波万里赊。\n山似翠屏西子国，溪如罨画越王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其七","author":"黄庭坚","text":"雨馀花色倍鲜明，最是春深多晚晴。\n美酒壮人如敌国，千金一笑买倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其六","author":"黄庭坚","text":"玉壶耽耽浸晴霞，庭有三春接续花。\n准拟只无难白发，金炉谁为煮黄芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其五","author":"黄庭坚","text":"抹裙彩凤盘宫锦，插鬓真珠络贝多。\n酒恶花愁梦多魇，灵砂犀角费频魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其四","author":"黄庭坚","text":"红紫欲疏啼百劳，洞宫春色醉蟠桃。\n虚窗酒病扶头起，强取金钗痒处搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其三","author":"黄庭坚","text":"行云行雨迷三峡，归凤求凰振九苞。\n月白花红倾酒满，不将春色等闲抛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其二","author":"黄庭坚","text":"吴中风物最娇饶，百里春风酒旆摇。\n往往贵人留骑从，少年丛里贳金貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和元礼春怀十首 其一","author":"黄庭坚","text":"回肠无奈别愁煎，待得鸾胶续断弦。\n最忆钱塘风物苦，西湖月落采菱船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答并简康国兄弟四首 其四","author":"黄庭坚","text":"日中一饭蒙头睡，黄叶堆门莫扫除。\n夜半枕前师子吼，起来烧却野狐书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答并简康国兄弟四首 其三","author":"黄庭坚","text":"须弥椎打虚空鼓，撼得毗卢海月昏。\n四海无波安乐住，陈家松下小柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答并简康国兄弟四首 其二","author":"黄庭坚","text":"妙舌寒山一居士，净居金粟几如来。\n玄关无键直须透，不得春风花不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答并简康国兄弟四首 其一","author":"黄庭坚","text":"瞿昙不解祖师机，却许狸奴白牯知。\n道人只要贫到骨，沈却黄金卖笊离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答静翁并以筇竹一枝赠行四首 其四","author":"黄庭坚","text":"万事实头方稳当，十分足陌莫跷除。\n困来展席日里睡，读尽空中鸟迹书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答静翁并以筇竹一枝赠行四首 其三","author":"黄庭坚","text":"一筇九节添行李，用得人间处处尊。\n只要上山行饱饭，莫将风雪打人门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答静翁并以筇竹一枝赠行四首 其二","author":"黄庭坚","text":"栽松道者身先老，放下锄头好再来。\n八万四千关捩子，与公一个锁匙开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答静翁并以筇竹一枝赠行四首 其一","author":"黄庭坚","text":"南鸿北雁年年客，有个生涯主不知。\n撼动从来忧乐事，夜窗风叶响棠梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘邦直送早梅水仙花四首 其四","author":"黄庭坚","text":"钱塘昔闻水仙庙，荆州今见水仙花。\n暗香静色撩诗句，宜在林逋处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘邦直送早梅水仙花四首 其三","author":"黄庭坚","text":"得水能仙天与奇，寒香寂寞动冰肌。\n仙风道骨今谁有，淡扫蛾眉簪一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘邦直送早梅水仙花四首 其二","author":"黄庭坚","text":"探请东皇第一机，水边风日笑横枝。\n鸳鸯浮弄婵娟影，白鹭窥鱼凝不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘邦直送早梅水仙花四首 其一","author":"黄庭坚","text":"簸船綪缆北风嗔，霜落千林憔悴人。\n欲问江南近消息，喜君贻我一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"压沙寺梨花","author":"黄庭坚","text":"压沙寺后千株雪，长乐坊前十里香。\n寄语春风莫吹尽，夜深留与雪争光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊死心禅师偈","author":"黄庭坚","text":"海风吹落楞伽山，四海禅徒著眼看。\n一把柳丝收不得，和烟搭