[{"title":"侍屏翁领客游雪山分得生字","author":"戴炳","text":"雪峰峰顶寺，来此定诗盟。\n山瀑分云影，松风乱雨声。\n眼明春树绿，心醒晓钟清。\n未好言归去，尘中事又生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕兄侍屏翁探梅屏山分得空字","author":"戴炳","text":"踏破登山屐，来寻傍水丛。\n眼明千树底，春入数花中。\n格瘦诗难写，香寒酒易空。\n狂歌归秉烛，惊怪走儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岂潜弟平远图","author":"戴炳","text":"卜筑占宽閒，修篁老树间。\n八窗开宇宙，一室贮云山。\n野旷行人少，天遥去鸟还。\n悠然会心处，妙语彻玄关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢赵山台见访","author":"戴炳","text":"寂寞海东头，殷勤贵客舟。\n如何经岁约，祇作数宵留。\n清玩分行箧，高吟压小楼。\n更须谋再会，同醉菊花秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"腊前见兰花","author":"戴炳","text":"兰丛才一干，独向腊前开。\n托荫偏宜竹，先春不让梅。\n韵从幽处见，香自静中来。\n便欲纫芳佩，灵均唤不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安居","author":"戴炳","text":"安居元自好，春昼更迟迟。\n雪涌煎茶鼎，云生浴砚池。\n栽荷填废沼，移竹补疏篱。\n犹有闲光景，攲眠续旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵屏翁咏梅","author":"戴炳","text":"芳信基花事，东君思亦奇。\n横枝疏蓓蕾，半树老丰姿。\n心共寒霜苦，香惟夜月知。\n最怜清梦觉，疏影竹窗时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵屏翁观梅","author":"戴炳","text":"晓寒篱落外，一见一番新。\n唤觉群芳梦，先钟万古春。\n冷香宜醉寝，真色任烟邻。\n更喜连朝雪，飞花为辟尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"项宜父涉趣园","author":"戴炳","text":"四面山回合，中间百亩畦。\n入门惟见竹，绕屋半栽梅。\n果熟霜前树，鱼肥雨后溪。\n秋来饶景物，斟酌费诗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小酌会芳分得阴字","author":"戴炳","text":"暇日频相顾，清风旧竹林。\n功名春后梦，吟咏老来心。\n世事随流水，年芳付绿阴。\n悠然千古意，闲理断纹琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉峰登眺得初字","author":"戴炳","text":"玉峰奇绝处，短策步崎岖。\n海近潮声壮，山空树影疏。\n吟情危眺外，饮兴薄寒初。\n数点新来雁，高飞不羡渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小楼扁山海图郑安道酒边有诗因次韵","author":"戴炳","text":"等閒成小集，危眺豁幽情。\n四面画图出，一襟天地清。\n晚云山晻霭，夜月海空明。\n自有兹楼景，输君第一评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵屏翁新秋","author":"戴炳","text":"检点新秋事，天公赐已丰。\n秋床梧叶雨，晓袂竹林风。\n阅世心先老，伤时酒易中。\n谁将和战议，细与问元戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"己亥十月晦大雷雨","author":"戴炳","text":"舛运频年见，忧时百虑灰。\n入冬常苦雨，昨夜又轰雷。\n土烂麦难种，虫伤菜失栽。\n儿童不解事，喜报海棠开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次屏翁冬日韵","author":"戴炳","text":"晓起冲寒出，霜明日未晞。\n麦丰来岁本，梅漏早春机。\n水涸鱼深隐，蜜成蜂倦飞。\n静中参物理，一一见精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自武林还家道由剡中","author":"戴炳","text":"一筇双不借，役役又东还。\n野渡浅深水，夕阳高下山。\n光阴虚我老，造物靳人閒。\n高躅思吾祖，鸣琴独闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵屏翁新元聚拜","author":"戴炳","text":"履端来聚拜，和气洽昌辰。\n蕃衍如今日，栽培岂一人。\n诗书延泽润，忠厚续长春。\n相祝无多语，年新德又新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵君玉弟春事","author":"戴炳","text":"海棠红未了，又近牡丹时。\n送日多忙事，酬春欠好诗。\n暖风催麦早，晴晷转花迟。\n不尽清游兴，重为上巳期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵晚春二首 其一","author":"戴炳","text":"一襟尘欲满，刮眼得新诗。\n风絮遗春恨，烟花隔岁期。\n笋抽虫半蚀，樱熟鸟先窥。\n光景浑如此，心闲即好时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵晚春二首 其二","author":"戴炳","text":"田园深有趣，已分隐柴扃。\n老去情多感，春来梦少灵。\n游丝捲晴日，飞絮入空庭。\n预识今年好，啼鹃枕上听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚即事","author":"戴炳","text":"春郊农务急，野岸水痕高。\n蒲渚鸣姑恶，桑林啭伯劳。\n整栏扶芍药，搴网护樱桃。\n不改穷居乐，何妨见二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵屏翁初夏会芳小集","author":"戴炳","text":"一觞还一咏，竟日醉难成。\n坐石惊云湿，临池爱水平。\n密林宜午荫，啼鸟尚春声。\n更有樱桃约，明朝且愿晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏初郊行","author":"戴炳","text":"晴雨天难测，寒暄气未齐。\n连村多绿树，终日啭黄鹂。\n田水冲塍断，山云着地低。\n偶随农叟语，不觉过桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僻居","author":"戴炳","text":"地僻尘嚣远，身闲趣味深。\n清池涵竹色，老树带藤阴。\n引鹤随閒步，招蝉伴醉吟。\n有时燃古鼎，隐几自观心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亦龙弟覆篑累石作亭其阴屏翁名曰野亭索诗谩赋二首 其一","author":"戴炳","text":"幽栖得真趣，隙地巧经营。\n花竹有和气，林园无俗情。\n带经休树影，抱瓮俯池清。\n我亦甘肥遁，相从乐此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亦龙弟覆篑累石作亭其阴屏翁名曰野亭索诗谩赋二首 其二","author":"戴炳","text":"高怀抗尘外，林杪着三间。\n绿绕村边树，青浮海上山。\n目穷天变化，心静地宽闲。\n鸥鸟知人乐，忘机亦往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋晚","author":"戴炳","text":"西风澄晓气，凝观惬幽情。\n草润蛩声滑，松凉鹤梦清。\n吟怀依水静，病思得秋轻。\n忽忆登高近，循篱看菊英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"屏翁领诸孙小集亦龙弟野亭君玉即席有诗次韵","author":"戴炳","text":"结屋新亭好，登临雅兴长。\n心融八窗白，尘隔九衢黄。\n泛菊金英碎，尝粳玉颗香。\n更期梅着蕊，来赏小春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑安道终岁相聚临别以诗见贻次韵为谢","author":"戴炳","text":"解把诗言别，那无计可留。\n梅花两心事，寒雁五更愁。\n我亦高悬榻，君须独卧楼。\n后回相忆处，莫返雪中舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江滨晚霁","author":"戴炳","text":"十里平沙路，人行晚霁间。\n水光涵远树，云影度空山。\n吹浪江豚怒，摩霄野鹤闲。\n渔翁醉吹笛，小艇泊前湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十日取野菊泛酒","author":"戴炳","text":"野径菊仍好，村垆酒亦嘉。\n未应今日蕊，便是背时花。\n心在家千里，身犹客九华。\n官程难久驻，风雨暮山斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山家小憩即景效药名体","author":"戴炳","text":"柴门通草径，茅屋桂枝间。\n修竹连翘木，高松续断山。\n仰空青荫密，扫石绿花斑。\n傍涧牵牛饮，白头翁自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从板桥买舟上青阳","author":"戴炳","text":"卸马板桥西，扁舟逆上溪。\n水锼岩骨断，烟截树头齐。\n野鸭惊人起，村鸡上树啼。\n老农头雪白，犹自把锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池州","author":"戴炳","text":"一城方九里，宛在水中坻。\n额揭颜公字，碑传杜牧诗。\n昔年称上郡，今日逼边陲。\n莫望长江北，天寒风正悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有永嘉薛君自号云屋来池阳以诗见贻用韵答之","author":"戴炳","text":"清晨闻剥啄，喜得薛能诗。\n风月一囊锦，江湖两鬓丝。\n寒城吹角夜，孤馆拥衾时。\n谁会吟心苦，梅花是旧知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有方叔材用余和薛云屋歌见贻次韵奉酬","author":"戴炳","text":"江湖前辈尽，何敢易言诗。\n鼠璞元非玉，蛛罗不是丝。\n池塘生草处，风雪跨驴时。\n此是真吟境，从来几个知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春前五日得雪","author":"戴炳","text":"雪作春前瑞，银城拥万家。\n太婆头欲白，九子顶先华。\n压麦嘉培本，封梅惜损花。\n家童解人意，烧鼎问烹茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵怀古","author":"戴炳","text":"尚闻深巷语乌衣，无复高堂彩凤仪。\n栋宇半攲元帝庙，香烟争奉志公祠。\n六朝兴废千年梦，独客登临万古悲。\n莫上钟山望淮北，西风禾黍更离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽栖","author":"戴炳","text":"幽栖颇喜隔嚣喧，无客柴门尽日关。\n汲水灌花私雨露，临池叠石幻溪山。\n四时有景常能好，一世无人放得闲。\n清坐小亭观众妙，数声黄鸟绿阴间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"此生","author":"戴炳","text":"此生毕竟已蹉跎，有酒何妨醉且歌。\n人世尽缘愁得老，春花偏被雨相魔。\n草欺兰瘦能香否，杏笑梅残奈俗何。\n试上东楼看春景，海山无数列青螺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自况","author":"戴炳","text":"多赀徒作守钱奴，伏腊无忧便有馀。\n世路本夷休自险，人情太密反成疏。\n非图报施方为善，岂为功名始读书。\n门外良田堪种秫，自牵黄犊试犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书房","author":"戴炳","text":"书房清晓焚香坐，转觉幽栖趣味真。\n怪石一根云态度，早梅半树雪精神。\n池鱼自乐谁知我，林鸟相忘不避人。\n得丧由来天自定，莫将闲虑恼闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"移古梅植于贮清之侧已有生意喜而赋之","author":"戴炳","text":"剥尽皮毛真实在，几年孤立小溪浔。\n人来人去谁青眼，花落花开自苦心。\n不是野夫同臭味，难教君子出山林。\n巡檐日日窥生意，一朵先春直万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再得古梅小而益怪首蒙屏翁品题因次韵","author":"戴炳","text":"爱渠怪怪复奇奇，冒雪遥凭健步移。\n竹外池边栽恰好，山巅水际梦多时。\n百年死质馀生意，一片孤槎带好枝。\n寄语花神勤守护，品题莫负老仙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初游方岩山","author":"戴炳","text":"图志旧尝看纪载，杖藜今得遍经行。\n渔翁化石几年钓，仙客有田何世耕。\n千尺枯崖蜕龙骨，一帘飞瀑撼雷声。\n相传逸少曾来此，惜不镌岩记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观败棋者戏作","author":"戴炳","text":"看人出着笑人低，及至当枰却自迷。\n角上仅全输了腹，东边才活丧于西。\n欲装劫去多难补，待算征来恰又提。\n天下未应无妙手，劝君莫爱墨狻猊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牡丹","author":"戴炳","text":"万巧千奇费剪裁，琼瑶锦绣簇成堆。\n世间妖女轮回魄，天上仙姬降谪胎。\n笑脸倚风娇欲语，醉颜酣日困难抬。\n东君若使先春放，羞杀群花不敢开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜有秋","author":"戴炳","text":"去年已作填沟计，谁料今年见有秋。\n天意乘除元自定，人生伏腊谩多忧。\n满盆淅玉休论价，成斛量金不计筹。\n最是野夫欢喜处，春风百瓮绕床头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次君玉弟闻新雁","author":"戴炳","text":"霜风飒飒荻花洲，避北趋南巧自谋。\n仙翮飞残千里月，寒声催老一天秋。\n乍教骚客惊诗梦，莫为征夫寄别愁。\n汝度塞垣应未久，新来烟燧已沉不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵东渠兄观梅","author":"戴炳","text":"诗眼非梅不可遮，三葩五蕊便堪嘉。\n瘦如饭颗逢工部，老似磻溪卧子牙。\n水影月香参众妙，弟酬兄倡自成家。\n快篘新酝同清赏，莫待枝头烂缦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居幽事","author":"戴炳","text":"閒居幽事属田园，何必山林始避喧。\n足水早禾分母子，多年修竹见翁孙。\n欣然胜败无心弈，兀尔醉醒随意樽。\n昨夜一番雷雨过，绿波微涨曲池痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘穷","author":"戴炳","text":"自甘穷处更何疑，坎止流行信所之。\n不学昌黎驱五鬼，肯随子厚骂三尸。\n堂堂白发欺人出，耿耿青灯独己知。\n细嚼黄花香满齿，清风千古一东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彭希圣姊夫赴三山民曹","author":"戴炳","text":"槐笏绿衫初作吏，要须立脚自廉勤。\n闾阎疾苦宜加意，廒廥奇赢莫与闻。\n少啖荔枝防美疢，多栽茉莉挹清芬。\n公馀览遍佳山水，倘有诗篇寄海云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"己亥九日屏翁约诸孙登高西屿阻风舟行不前遂会于吾家山海图之上酒边翁有诗留题因次韵","author":"戴炳","text":"良辰乐事两相关，喜我楼台便往还。\n不用移舟过西屿，只消把酒对南山。\n风于破帽如相约，菊为新篘欲笑颜。\n留作千年佳话处，诗翁醉墨照楣间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"如京至西兴阻风雨","author":"戴炳","text":"月将圆夜出乡关，才到西兴月又残。\n老去问名先已懒，近来行路觉尤难。\n云烟漠漠吴山暗，风雨潇潇浙水寒。\n识破人生真逆旅，此身何处不堪安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕感兴二首 其一","author":"戴炳","text":"家家欢笑迓星期，我辈相邀只酒卮。\n矫俗何须标犊鼻，甘愚不解候蛛丝。\n新秋光彩月来处，半夜清凉风起时。\n一曲玉箫尘外意，此音除是鹤仙知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕感兴二首 其二","author":"戴炳","text":"相传牛女起何时，无柰人间事转痴。\n青鸟蟠桃方士信，金钗钿合逆胡基。\n一杯记节图成醉，万感因秋却易悲。\n遗恨古今流不尽，银潢耿耿接天池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"抵池阳未入关泊于齐山数日因穷岩壑之胜","author":"戴炳","text":"瘦策相扶上翠微，眼惊奇怪足忘疲。\n三十六洞犹昔者，四百馀年无牧之。\n涨水淼瀰春雨后，远山重叠夕阳时。\n几多江北江南恨，问着沙鸥总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘叔子总干夜坐感秋韵","author":"戴炳","text":"秋风远客叹飘零，满镜吴霜故故明。\n酒盏论心疏旧约，诗筒到眼快新评。\n短檠伴我夜深静，长笛何人月下横。\n步绕空庭吟未竟，隔林鸲鹆又传更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代简约诸同官探梅","author":"戴炳","text":"信是抟沙放手开，渴心空想细论杯。\n等閒不见便逾月，如此相从能几回。\n旧雨已孤重九菊，新诗宜探小春梅。\n骑驴索句真颜面，要向清溪洗出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烧灯夕宋明府自置酒见招席上复赋诗因次韵定诗盟并致别意","author":"戴炳","text":"苦用吟心续祖灯，得君印證愈分明。\n一聆此日鸡窗话，尽洗前时蚓窍声。\n飏柳轻风寒忽暖，催花小雨湿还晴。\n眼前总是诗光景，可惜明朝又远行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋暮出关即事","author":"戴炳","text":"俗尘汩汩负清游，重出城来已暮秋。\n水洗柳根攲断岸，霜摧芦叶拥荒洲。\n乡音不到愁来雁，野性无拘羡去鸥。\n可惜一堤明月好，隔关难作夜深留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日独倚东楼","author":"戴炳","text":"重阳过了秋逾爽，自豁楼窗眺晚西。\n野外倒涵天影动，海云平压雁行低。\n兴来频放深杯饮，吟到须还大字题。\n近喜书房添一宝，陶泓买得古端溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵屏翁壬寅九日再题小楼","author":"戴炳","text":"佳节相过共举觞，为萸菊醉亦何妨。\n须知我辈襟怀事，不是时人酒肉狂。\n落雁影边寒水碧，归鸦啼处夕阳黄。\n诗翁樽俎风流在，老气横吞年少场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初冬梅花偷放颇多","author":"戴炳","text":"清樽才了黄花债，又被梅花恼杀人。\n碎点南枝无数雪，探支东帝几分春。\n精神全向疏中足，标格端于瘦处真。\n彻夜苦吟无好语，梦随双月步溪漘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石屏后集锓梓敬呈屏翁","author":"戴炳","text":"新刊后藁又千首，近日江湖谁有之。\n妙似豫章前集语，老于夔府后来诗。\n梅深岁月枝逾古，菊饱风霜色转奇。\n要洗晚唐还大雅，愿扬宗旨破群痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]