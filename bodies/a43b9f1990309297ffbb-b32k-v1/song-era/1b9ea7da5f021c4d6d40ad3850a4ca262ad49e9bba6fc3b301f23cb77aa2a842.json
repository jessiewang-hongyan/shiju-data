[{"title":"和酬入内赵供奉见赠","author":"魏野","text":"出入宫闱侍从官，再过林下信温颜。\n朝天驻足因临水，驰驲回头入望山。\n捧诏正当趋桂殿，寄诗那忽到松关。\n老来诗思尤枯竭，莫怪阳春不旋还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬孙大谏见访之什","author":"魏野","text":"冬日开门忽似春，温颜和气接如亲。\n贵能尚故寻村叟，醉误犹呼作舍人。\n茜旆空林行藓上，椹袍拂石坐溪滨。\n仍留雅咏酬虽晚，每看长先整角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬何泳推官见赠","author":"魏野","text":"杜牧科名李贺曹，初官花幕莫辞劳。\n年颜不似诗情老，公器还如酒户高。\n我称卧游蓝碧嶂，君宜立近赭黄袍。\n雅章酬晚惭慵拙，吟社何人与破逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬张井见赠","author":"魏野","text":"溪上闲居四十春，春溪兰佩蕙为绅。\n自知吟咏非经济，谁道机谋学渭滨。\n三尺焦桐胜面友，数家老叟是比邻。\n少年多谢携诗什，来访疏慵潦倒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬李殿院以野将游吴蜀二首 其二","author":"魏野","text":"携得筇枝背得琴，欲浮蜀浪陟吴岑。\n本期胜境酬双眼，却恨虚名阻片心。\n出似蓬飘宁免醉，住如匏系不妨吟。\n重酬雅咏重思想，太守相留意最深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬李殿院以野将游吴蜀二首 其一","author":"魏野","text":"将从两蜀下三湘，清世那忧道路长。\n杖屦虽然游自在，旌旗宁免别凄凉。\n召公化实宜歌咏，谢傅诗尤愧发扬。\n愿得德星归未动，光芒依旧照毫芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬李殿院见访之什","author":"魏野","text":"清嫌水有不清泠，闲拥朱轮扣掩扃。\n乐广喜披溪上雾，戴逵惭认月边星。\n高情称就云为幕，雅咏宜镌石作屏。\n竹里小亭从此后，因君堪号降贤亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬益州刘大著同运使薛端公见寄之什","author":"魏野","text":"遥思锦水会荀陈，共指棠郊忆卧云。\n青眼虽然蒙望我，丹心不觉恨输君。\n离情杳杳三千里，老病厌厌八九分。\n唯待急徵同赴阙，一时得见向溪濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和臧奎秋夜书怀","author":"魏野","text":"林中独坐欲中宵，落叶纷纷触坏袍。\n月影渐移蛩韵急，露华初上鹤声高。\n四时催老秋偏感，万事萦心夜更劳。\n犹赖清风知我意，频吹庭竹助萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蹇藏用暮秋郊居言怀二首 其二","author":"魏野","text":"敢学宣尼叹道穷，闲心何处不相容。\n交朋尽笑龟蒙散，邻里偏谙叔夜慵。\n晚吹清泠彫万木，残霞红澹映三峰。\n为怜今岁于中稔，欲遣儿孙亦务农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蹇藏用暮秋郊居言怀二首 其一","author":"魏野","text":"村落秋穷兴莫穷，黄花红叶照衰容。\n时平转称千般巧，年长仍添一倍慵。\n林下携筇闻远水，洞中攲枕见前峰。\n与君邻里何相似，来往人多是老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏竹杯珓子","author":"魏野","text":"谁知破筠根，还同一气分。\n吉凶终在我，翻覆谩劳君。\n酒欲祈先酹，香临掷更焚。\n吾尝学丘祷，懒把祝云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏怀","author":"魏野","text":"静顾身兼世，何须哂复吁。\n境牵情各有，道断事皆无。\n拜少腰宁负，眠多眼不辜。\n权豪任相笑，适性自为娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏怀","author":"魏野","text":"道心虽博爱，遇物忽难兼。\n树更因巢惜，云曾为月嫌。\n酒中宁有感，诗里觉无厌。\n渐老成何事，疏慵病转添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河中孙学士以诗见寄因次本韵继和三章用为酬赠 其三","author":"魏野","text":"山前衙署枕河湄，遂意荣居事可知。\n华省图书虽暂别，故乡风物似相随。\n绕城奔浪喧更鼓，隔岸征帆映酒旗。\n刻石将同王阁长，永留遗爱向歌诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河中孙学士以诗见寄因次本韵继和三章用为酬赠 其二","author":"魏野","text":"入居兰省归群望，出守薄关自圣知。\n清禁乍辞仙漏远，白楼闲上彩笺随。\n伯夷庙下停金勒，大舜门中亚绣旗。\n遥想雄藩多少境，祇应公暇遍留诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河中孙学士以诗见寄因次本韵继和三章用为酬赠 其一","author":"魏野","text":"表里山河舜帝基，圣君馆殿选贤知。\n开筵想任佳人拥，游寺应嫌俗吏随。\n政讶龚黄推绝席，文疑元白竖降旗。\n逍遥楼迥闲登处，几感皇唐御制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知玄武县薛秘丞继示手书因以谢","author":"魏野","text":"至交忘贵贱，岂可与常论。\n少似君书札，多于我梦魂。\n杨岐从蜀邑，雁递到烟村。\n倒箧时将读，谁言我眼昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经嵩阳废观因有戏题","author":"魏野","text":"嵩阳多废观，欲验少碑文。\n地属村夫子，苔漫石老君。\n草生泉更浸，松死烧犹焚。\n欲问神仙事，悠悠空白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述怀","author":"魏野","text":"东郭魏仲先，生计且随缘。\n任懒自扫地，更贫谁怨天。\n有名閒富贵，无事小神仙。\n不觉流光速，身将半百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咸阳道中作","author":"魏野","text":"渭水冻无波，终南翠色多。\n云临残照霁，客向故城过。\n惊雁远犹叫，牧童寒不歌。\n心愁人不会，谓我欲求何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将游蜀中恨有所滞至情难蓄发为拙诗寄锦川峡路薛田臧奎二运使提刑杨及","author":"魏野","text":"却为虚名动叹嗟，难如云鹤转天涯。\n两川尚阻寻三友，四海空传是一家。\n白发无多残岁月，青城何限好烟霞。\n此生不遂闲游去，蜀魄巴猿恨莫誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日述怀","author":"魏野","text":"春暖出茅亭，携筇傍水行。\n易谙驯鹿性，难辨斗禽情。\n妻喜栽花活，童誇斗草赢。\n翻嫌我慵拙，不解强谋生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日怀王专","author":"魏野","text":"菊花原上立，村落雨晴初。\n晚吹清群物，秋光澹太虚。\n空看新雁字，不得故人书。\n犹赖华亭鹤，林閒伴索居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋霁草堂闲望","author":"魏野","text":"草堂高迥胜危楼，时节残阳向晚秋。\n野色青黄禾半熟，云容黑白雨初收。\n依依永巷闻村笛，隐隐长河认客舟。\n正是诗家好风景，懒随前哲却悲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻不出院真公","author":"魏野","text":"闭户头初剃，今来已白头。\n五侯堂上见，四海定中游。\n凿井还依砌，栽松欲映楼。\n人间思虑绝，拥衲任经秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻司马池","author":"魏野","text":"年少老成人，林间访我频。\n文虽如貌古，道不似家贫。\n题柱宁惭祖，干时不为身。\n鳌山将首冠，莫叹尚沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送三门发运辛寺丞赴阙","author":"魏野","text":"山河仗忠信，尽室去安然。\n白浪为行路，红旗认坐船。\n禹门辞有燕，隋柳到无蝉。\n岂羡乘槎客，风流载管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送马共之任内江县尉兼主簿","author":"魏野","text":"驴上吟诗贾岛同，内江归去指江东。\n封疆半在猿声里，道路多穿竹箐中。\n想得两衙长锁印，应过三载不张弓。\n重登制策高科在，笔砚公馀莫废功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元上人归宁","author":"魏野","text":"禅性虽无著，偏亲奈白头。\n直应飞锡到，方是倚门休。\n雪里犹思去，花前岂易留。\n如何迎侍得，住近免离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送太白山人俞太中之商于访道友王知常洎归故山","author":"魏野","text":"羡我诗中偶有名，输君物外更无萦。\n水声山色为声色，鹤性云情是性情。\n四皓云间寻旧友，三清路上指前程。\n连天太白从今去，林下何时得再迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送太博知荣州","author":"魏野","text":"莫叹迢迢远帝京，且怜叱驭继家声。\n歌钟竞出棠郊送，鼓角应过剑阁迎。\n棕叶带风惊玉勒，梅花和雪照红旌。\n下车遥想无馀事，政誉遥同在陕城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送无用上人游中条","author":"魏野","text":"迢递中条寺，秋寻忘险途。\n屐踪临水有，锡影入云无。\n像阁分秦树，经窗见舜都。\n我曾题壁处，闲看想踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王专王衢之许下自维扬谒孙学士王舍人","author":"魏野","text":"蹇驴并跨引羸僮，两地迢迢谒至公。\n才力互相鹦鹉敌，交情深与鹡鸰同。\n薛能诗在僧楼上，张祜名题酒肆中。\n到日知君寻赏处，醉吟还可继遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王专李安赴举","author":"魏野","text":"同解约同歧，情怀独若为。\n问愁离郡早，留恐到京迟。\n岁晚催行计，时丰省举资。\n前春浑化去，莫忘野人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王专推官赴任河中","author":"魏野","text":"声华籍籍祖风存，况佐风流谢使君。\n健笔想无诗债负，漏卮应少酒知闻。\n趣装剑懒从人借，谒庙香非为己焚。\n好对前山思节俭，夷齐饿死舜耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王专著作之任犀浦","author":"魏野","text":"西山宰字选清强，东观修文辍佐郎。\n濯锦江边趋郡府，浣花溪上问封疆。\n半年讼必消民境，数月歌应彻帝乡。\n百里旧闻风物好，公馀遥想入篇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王太尉赴诏二首 其二","author":"魏野","text":"三朝元老状元稀，乞赴彤庭诏便依。\n金鼎位高将正拜，璧田家近恐妨归。\n殊恩每过莓苔径，别泪偏沾薜荔衣。\n从此征车东去后，甘棠风物减光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王太尉赴诏二首 其一","author":"魏野","text":"功名不独世推降，五福天钟更少双。\n倚注即看宣几杖，休闲唯待让旌幢。\n家园到想倾金箧，御宴迎应倒玉缸。\n重过嵩山定回首，白云深锁旧吟窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王太博出镇桂林","author":"魏野","text":"主上求人镇大藩，桂林虽远莫嗟叹。\n薛能嘉树非真命，韩愈潮阳是谪官。\n甘雨将沾蛮草润，仁风先扫瘴烟残。\n龙钟不得相随去，愿寄州图枕石看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王太博抽赴阙","author":"魏野","text":"宪府吾皇注意偏，君今应诏合居先。\n蛾眉班缀千官上，廌角威扬万乘前。\n贵戚望风从此日，贫交披雾是何年。\n难忘枉驾相辞处，草屋门开雪满天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王太博知建昌军","author":"魏野","text":"莫叹三山隔五云，建昌境好说纷纷。\n虽然尚作贫才子，犹免潜呼老使君。\n远逐朱轮输雁阵，闲亲画舸羡鸥群。\n棠郊独恨分携后，高论何时得再闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王迁归青社","author":"魏野","text":"此别重伤情，寒天二十程。\n弟分微禄送，儿逐蹇驴行。\n雪蔽千山色，冰含万水声。\n何时再相见，去去海边城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王秘丞赴阙","author":"魏野","text":"诏下儒中选将臣，众推何处避君恩。\n图书官职人间美，斧钺威权阃外尊。\n兰省交朋迎适愿，棠郊寒士送销魂。\n功成伫听居藩翰，肯忆渔樵在水村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王辟太博赴阙呈刘正言","author":"魏野","text":"吟坐俱头白，分携重怆情。\n才堪亲帝座，贫不似官行。\n晓雾迷山径，秋霖破驿程。\n唯应刘小谏，到阙始相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王辟赴举","author":"魏野","text":"何必问龟长，知音在玉堂。\n十全才众许，双美卷亲装。\n云少离山驿，尘多近帝乡。\n花时新榜帖，先为达岩房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王衢之任德之推官","author":"魏野","text":"从军重叠继家声，雅称风流旧信灵。\n功业即看辉圣日，科名先已应台星。\n丝蚕地说连河朔，戎马尘闻近虏庭。\n正是穷秋雨多际，不堪回首向郊坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送丕上人南游","author":"魏野","text":"江山独去游，游遍始应休。\n云外敲清磬，船中剃白头。\n阻风孤岛晚，听雨二林秋。\n南国多嘉境，诗牌几处留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送冯介迎觐","author":"魏野","text":"离声无管弦，空把指频弹。\n惟子犹为客，何人不作官。\n前程贫岂易，后会老应难。\n拜想高堂下，麻衣泪始乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送外甥李渭进士赴举","author":"魏野","text":"棠树抡材过礼闱，孤寒得解更光辉。\n进身喜逐贤侯表，裹足愁分老母衣。\n千里冬残伤独去，一家春尽待荣归。\n头方念尔还如我，到阙何人许扣扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送石太尉移镇许昌","author":"魏野","text":"厌居棠树远京师，新自飞章白玉墀。\n许郡虎符依口得，凉州龙节逐身移。\n离声银字调家乐，行李金函锁御诗。\n想到即徵归密地，碧波亭上不多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送乔职方赴阙","author":"魏野","text":"一种徵书下九重，汉唐贤士岂能同。\n定归金马殊黄散，不解银鱼胜白公。\n千骑拥行歧路满，万人泣送郡城空。\n他时若继前交代，肯意棠郊鹤发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送任秉南归","author":"魏野","text":"归觐江山远，如何叙别离。\n数杯村店酒，一首野人诗。\n趁渡怜舟稳，贪程恨马羸。\n遥思到家日，已过落花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘大著赴任益州司理","author":"魏野","text":"金口亲除向锦川，一般监郡最荣迁。\n从来才已欺鹦鹉，此去冤应雪杜鹃。\n迎接僧携筇竹杖，歌谣民写浣花笺。\n移风定不妨吟笑，绝唱宜磨玉垒镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘烨大著移任龙门知县","author":"魏野","text":"天上书先梦里传，到施仁政减春寒。\n尚虚鳌岭神仙任，暂作龙门父母官。\n愁闷岂惟增假寐，笑谈直恐绝真欢。\n不缘潦倒长相逐，免得离情有万端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙状元监丞赴阙","author":"魏野","text":"诏命虽殊异，行装亦等闲。\n蓬壶如得路，藜杖似归山。\n赴约过嵩岭，辞家到竹关。\n从兹位清峻，野客转难攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙推官之阙下","author":"魏野","text":"此去知君免叹嗟，荐章先已到京华。\n宾筵沉滞才虽久，仙省遨游路不赊。\n绿映酒旗村店柳，红迎诗笔御园花。\n几多祖席棠郊外，马上回看日已斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙磻西游","author":"魏野","text":"贫居胜富贵，况复是贫游。\n前路谁青眼，高堂母白头。\n秦山晴望好，陇水夜听愁。\n早作归宁计，逢欢莫滞留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送县宰王希之阙下","author":"魏野","text":"到任预忧替，替归贫类初。\n离情似芳草，远道逐征车。\n遗爱偏留记，行装祇担书。\n将来好官职，愿载此间除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴石赴举","author":"魏野","text":"吴生重赴举，轻别重伤心。\n贫友欲沽酒，豪家不典琴。\n溪僧来会送，国士到争寻。\n预想登科后，无因访竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张先宁觐","author":"魏野","text":"千里宁亲去，青春胜老莱。\n苦辞留不住，堪送到方回。\n行色秋仍惨，离声晚更哀。\n前程如有信，新雁好凭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送怀古上人游钱塘","author":"魏野","text":"正当摇落日，忽忆向江天。\n猿避经行路，鸥随入定船。\n袖携诗卷重，杖揭钵囊偏。\n约我湖心寺，相寻结白莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李安赴举","author":"魏野","text":"野客复何陈，贤侯首荐人。\n俗流宁肯饯，良璞不嫌贫。\n棠树离偏晓，函关过已频。\n花时好消息，伫听向溪滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李殿院移镇淮阳","author":"魏野","text":"花骢秋健绣旗开，渐远棠郊近帝台。\n耳目紧官终拜去，股肱雄镇暂迎来。\n两州将相为交代，三径渔樵阻接陪。\n犹赖雅章留刻石，时时闲看拂尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨侍禁赴阙时有甄先生相随","author":"魏野","text":"一种皇华觐紫宸，文资换必异常伦。\n随轩已有三茅客，下榻宁无两制人。\n清洛听应移足懒，碧嵩看想转头频。\n他时乞得休官后，莫负前言作善邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]