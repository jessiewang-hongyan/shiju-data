[{"title":"失调名 其三","author":"詹克爱","text":"后会不知谁健，茱萸莫厌重看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其二","author":"詹克爱","text":"空将别泪，洒作人间雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀 其二","author":"詹初","text":"独坐终日闭寒庐，回首生年五十初。\n岁月不知垂老至，惟从愤乐自如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀 其一","author":"詹初","text":"小溪流水自悠悠，策杖南林入早秋。\n随地人生俱可乐，浮云富贵复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云掩月 其二","author":"詹初","text":"心如明月物如云，心放应为物所分。\n欲反此心须去物，原来还自在天君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月 其二","author":"詹初","text":"水中月影还是影，天上一真影万川。\n水里月影人共识，一真谁复见先天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观春","author":"詹初","text":"万木春来花满枝，忽来忽去迭无时。\n此中还有此中意，说向傍人人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沐浴 其二","author":"詹初","text":"閒浴溪头静自居，此身已濯心何如。\n此心欲濯静中去，静定由来物自除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沐浴 其一","author":"詹初","text":"暮春河水暖春晖，浴罢悠悠自坐矶。\n弄柳乘风兴未尽，高歌一曲日西归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松竹","author":"詹初","text":"青翠春来未见奇，丽红正是夭夭时。\n霜寒十月花开尽，祗有松筠秀旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"詹初","text":"白云冉冉度南园，绿柳明花处处然。\n云物无心心自适，优游无我我忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春归","author":"詹初","text":"生意无端绿满枝，闭门高卧日迟迟。\n一编周易年年把，门外春归总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋至","author":"詹初","text":"方趁夏日永，不知秋已清。\n秋清岁即晚，吾道终何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻胡人入寇","author":"詹初","text":"老来不忍闻征战，征战偏从老岁闻。\n静里追思生乱者，令人无语对斜曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读易","author":"詹初","text":"先天本无言，有言即后天。\n欲知先天易，须在无言前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"詹初","text":"何须身外更求荣，荣在吾身尔自轻。\n但得仁荣真尊爵，荣华世上总虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄柳塘汪叔耕三首 其一","author":"詹初","text":"不闻尔言久，因觉我言非。\n欲得尔之善，真期尔指归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅","author":"詹初","text":"万木枯岁晚，寒梅独不移。\n幽香对白雪，清景月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凿流塘二首 其一","author":"詹初","text":"门前凿三塘，流水常不息。\n逝者诚如斯，间断伊谁忒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒松草阁","author":"詹初","text":"数椽草阁构新成，四面苍松入户清。\n霜雪须教长不改，后凋端与尔为盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新春","author":"詹初","text":"岁月新更又一春，迎春还是旧年人。\n愿除旧妄生新意，端与新年日日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漫兴","author":"詹初","text":"秋风独坐野塘前，水上游鱼自有天。\n真意更须何处觅，知音从古在无弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读李敬业传","author":"詹初","text":"閒笑唐明主，深怜李绩忠。\n如何一谄献，便使百年恫。\n武后兴唐乱，英公奋义戎。\n那知成祸者，祸惨亦归躬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窗树","author":"詹初","text":"雨过窗前树，天然生意新。\n枝条枯昨日，萌檗长今晨。\n根本原无改，濡滋自有神。\n静看微物理，应识养心真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感叹","author":"詹初","text":"岁月蹉跎六十乘，嗟予德业竟何能。\n善无一得过恒有，力尽千般志尚弘。\n学易一编终法孔，反身三省死如曾。\n漫嘲吾老成衰朽，定举全仁重任胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题程栖竹居士卷","author":"詹初","text":"此翁日日对脩竹，竹上风清心亦清。\n高节有常原自劲，中虚无物本来成。\n美淇君子诗为咏，贯岁圣人礼作盟。\n林里七贤真浪迹，怜君不慕七贤名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中道","author":"詹初","text":"圣贤自古执其中，允执此中万理通。\n万理由来心自得，心同方是理大同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书白乐天琵琶行后","author":"詹初","text":"浔阳夜泊送客船，船上谁人白乐天。\n坐闻一曲琵琶奏，青衫何用涕泗涟。\n岂知通穷良有命，君子当之无怨焉，虚使歌行世上传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云掩月 其一","author":"詹初","text":"游云纷扰混太清，苍茫万里晦月明。\n岂是贞明能为改，却缘外面纵且横。\n纵横云霭尽能拨，一轮即见当天发。\n当天皎皎月照人，今古何曾人照月。\n千江万江月尽圆，千人万人谁知焉。\n李白江头捉月死，尽笑李白醉而颠。\n江中那有月可捉，举首独立空茫然。\n空茫然，月在天，古来祗有一心传。\n休教心外便便言，当时岂啻李白醉江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心如谷种","author":"詹初","text":"人心如谷种，生生本无时。\n虽然有生意，培养贵自知。\n不耘诚为昧，揠苗良可悲。\n戒病复有事，苗秀实可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月 其一","author":"詹初","text":"天上一轮影万轮，一轮方是月明真。\n祗寻天上一轮月，水里万千何足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出心原","author":"詹初","text":"行行涉南原，遥望北山岑。\n上有千尺崖，下有高树林。\n高林转幽隩，戛然啼双禽。\n流水自迅逝，白云澹无心。\n策杖者谁子，閒来坐春阴。\n相逢择林下，携手溪水滨。\n对之两无言，悠然鸣素琴。\n素琴清且越，畅以披冲襟。\n冲襟良自尔，那知春已深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归田","author":"詹初","text":"归田漫云苦，田野乐有馀。\n忙去一犁黍，閒来万卷书。\n食赡忘帝力，理见识心虚。\n随地平生意，从今可自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田居","author":"詹初","text":"南开数亩田，妻子共锄耕。\n比岁颇丰稔，仰天歌治弘。\n忧贫本匪念，忘物自怡情。\n遥忆执舆者，问津来上平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀","author":"詹初","text":"閒居忽有怀，怅然令心恫。\n世人尚浮沉，君子难苟同。\n是以盖世贤，飘然返山中。\n栖迟竹林下，明道善其躬。\n如何彼之子，居常起波风。\n屈原泣泽畔，仲尼悲道穷。\n贤圣尚如此，吾身那可容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感","author":"詹初","text":"世道已趋末，人心觉更殊。\n逐逐在势利，权势竞吹嘘。\n忠言翻为怨，成风在谄谀。\n谄谀势立至，势去还踌躇。\n小人誇得志，君子思归欤。\n不忍同世浊，深山高结庐。\n闭门守吾拙，势利安可居。\n势利一时荣，时过祸反予。\n不如守贫贱，履道常坦如。\n所以介然志，三公不易诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求心斋","author":"詹初","text":"生生天地心，吾人秉其真。\n虚灵无一物，纯然惟元仁。\n如何彼放失，物欲共沉沦。\n客感乃为主，本主翳埃尘。\n鉴此去物欲，而求我真纯。\n求之真即见，端然还在身。\n祗恐物与欲，乘间复来侵。\n念兹心益奋，日夜终惟寅。\n戒惧与谨独，式用存吾神。\n于焉生生意，始与天地伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄体仁宗叔一首","author":"詹初","text":"一从示至教，日觉旧行非。\n但恨范模远，终为物欲欺。\n有知无取正，积惑总成疑。\n独有依归念，端然未改移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻杵","author":"詹初","text":"静夜无人语，何处送杵声。\n米以杵而出，杵以多而精。\n小事尚如此，况于吾性成。\n所以古圣贤，寝食不遑宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻莺","author":"詹初","text":"忽尔闻莺语，语巧真如簧。\n呼童逐之去，不使鸣我傍。\n语巧是非乱，语拙道吾常。\n守道由拙得，不仁为巧亡。\n吾宁道吾拙，翻为巧者伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花","author":"詹初","text":"桃花灼灼斗春芳，一见如云满目光。\n不识冬来霜雪遍，芳意争似竹松长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄柳塘汪叔耕三首 其三","author":"詹初","text":"数月未论心，此心觉还真。\n矢以惺惺法，始终奉此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄柳塘汪叔耕三首 其二","author":"詹初","text":"久未从君行，出门无可去。\n思尔行之善，秉烛坐至曙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄黄直卿","author":"詹初","text":"忆昔年犹壮，庐山侍读书。\n叨为三友末，相隔廿年馀。\n君道多朋合，余非独索居。\n缘兹君日益，余昧愈成愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜日","author":"詹初","text":"吾闻古君子，发愤竞分阴。\n漫以一朝逸，终辜百岁心。\n嫌秋昼短入，爱夏刻长临。\n三省吾身过，专诚学子参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凿流塘二首 其二","author":"詹初","text":"旧为沙泥场，今为流水域。\n混混固有源，开导吾为德。\n人心凝物欲，已有犹当克。\n已去心源澄，活泼自无塞。\n万汇当其前，水鉴真明极。\n徘徊此塘滨，永为立心则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登圣山","author":"詹初","text":"抠衣上圣山，徘徊四望通。\n下视小区邑，上视高苍穹。\n小者吾诚高，高者吾何从。\n浑浑道无极，求之不可穷。\n而欲穷其际，亦曰执一中。\n一中苟在斯，卑高大小同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新荷","author":"詹初","text":"青荷小小初凌水，梗直中虚不著尘。\n为道人心本然处，直虚原与物为同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题岱山水云幽居","author":"詹初","text":"幽居避俗氛，世事那复闻。\n閒浴池塘水，静看山岭云。\n云自无心出，水从有本分。\n水云真自得，吾与尔为群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"训子","author":"詹初","text":"呼尔群儿，示尔儿知。\n俭则本立，学则智资。\n时逐勿逐，古圣是规。\n守道安贫，我所慕思。\n竞势趋豪，我心实悲。\n毋谓放巧，毋谓谨痴。\n毋谓恶小，乃以自欺。\n毋谓善小，弃而不为。\n为善去恶，奋志乘时。\n少壮不力，老大何追。\n尔父虽昧，所言则宜。\n永以为训，无为我遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"理气","author":"詹初","text":"理本无象，气为有形。\n气为理载，理以气乘。\n匪理气粗，匪气理冥。\n气以理神，理以气弘。\n二者相须，其道分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄远","author":"詹茂光妻","text":"锦江江上探春回，销尽寒冰落尽梅。\n争得儿夫似春色，一年一度一归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吏隐山","author":"詹迥","text":"五云古名邑，维东有崇山。\n群峰屹罗列，一水相回环。\n李侯筑崇台，吏隐于其间。\n斯人不可见，篆蚀苔文斑。\n我来访遗迹，临风发长叹。\n洗尊挹?醁，落日犹忘还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小桃源","author":"詹复","text":"远寻瑶草到仙家，冲破云间一片霞。\n道士不知兴废事，又来溪上种桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游仙","author":"詹琦","text":"弱龄秉永向，撰念游蓬瀛。\n腾盖玄圃台，投辔赤霞城。\n紫府五香馥，丹丘四照萦。\n班龙何夭矫，青凤来相迎。\n道逢王子乔，手曳芙蓉旌。\n灵风袭霓裳，邀我谒瑶京。\n天帝坐丛霄，群仙列两楹。\n羽节自飘扬，众乐锵然鸣。\n授我金龟秘，锡我玉室名。\n渴漱沆瀣浆，饥饵橘树英。\n忘形思入玄，道在岂求赢。\n流觉神驱尽，逍遥云翮轻。\n枣花千岁结，桃核万年成。\n海水扬尘竭，天衣拂石平。\n祈年本无分，望仙徒自营。\n寄谢樊笼士，那知遗世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏令燬生佛衔","author":"詹梦璧","text":"共称生佛戴恩波，一饱欢腾鼓腹歌。\n家有佛衔收拾去，人心有佛可收么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题三贤堂","author":"嘉定太学生","text":"和靖东坡白乐天，几年秋菊荐寒泉。\n如今往事都休问，且为官司趁酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"止止庵即事","author":"詹琰夫","text":"小结茅庵倚薜萝，主人心事定如何。\n春风枕上邯郸梦，夜雨灯前云水歌。\n岁月不堪频把玩，山林偏称小婆娑。\n年来欲问长生诀，止止庵中养太和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送袁侍郎","author":"嘉定太学生","text":"天眷频年惜挂冠，谁令今日远长安。\n举幡莫遂诸生愿，祖帐应多行路难。\n去草岂知因害稼，弹乌何事却惊鸾。\n韩非老子还同传，凭仗时人品藻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"湖州士子","text":"可怜戴工部，独树不成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游云门","author":"詹骙","text":"轻裘肥马春三月，到此经游花正红。\n欲觅上方幽隐处，老僧笑指白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳后一日登快哉亭","author":"詹慥","text":"上巳信嘉辰，流觞传旧俗。\n良游怅不遂，吏局方有属。\n东风吹晓雨，万窍嗥林麓。\n疑有泊舟人，狂歌河女曲。\n逾朝始澄霁，物色如新沐。\n城角趋危亭，登临慰幽独。\n纷华埽不见，蝴蝶飞平绿。\n伫倚穷夕曛，悠哉此心目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜","author":"孔平仲","text":"平生最好月，况此秋夜阑。\n长风送荡漾，浩露洗团团。\n仰头视虚空，光采如可餐。\n星辰敛芒角，河汉收波澜。\n更无微云翳，挂此白玉盘。\n六合静皎皎，万木凉珊珊。\n为尔废昏卧，徘徊更漏残。\n更登高处望，历历见湖山。\n爽气集冰雪，清心生羽翰。\n便欲御泠然，因之游广寒。\n一临天池水，沐浴随飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南浦","author":"詹慥","text":"南浦随花去，回舟路已迷。\n暗香无处觅，日落板桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"系舟","author":"詹羲","text":"石廪岩前系小舟，娟娟明月照清秋。\n仙人一夜吹长笛，三十六峰云尽收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"赖仙翁","text":"一条丁水铜鱼塞，三十年来旧相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"赖继善","text":"白日干戈万马尘，铁心不碎竟谁身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑居之","author":"赖铸","text":"窗前落叶正萧萧，夜雨寒灯共寂寥。\n君是居人余是客，明朝相候合江桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"路坦","text":"百里传呼号录公，三年得替普天同。\n惟君四载过常例，更有何人继后风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伐棘篇","author":"路振","text":"伐棘何所山之巅，秋风颾颾棘子丹。\n折根破柢坚且顽，斸夫趑趄汗污颜。\n攒锋束芒趋道还，?之森森缭长藩。\n暮冬号风雪暗天，漏寒不鸣守犬眠。\n主人堂上多金钱，东陵暴客来窥垣。\n举手触锋身陨颠，千矛万戟争后先。\n襟袖结裂不可揎，蹠破指伤流血殷。\n神离气沮走蹁跹，数尺之墙弗复攀。\n索头丑奴搔河壖，朔方屯师连七年。\n木波马领沙填填，气脉不绝如喉咽。\n官军虎怒思吼轩，强弩一发山河穿。\n将不叶谋空即安，玩养小丑成陨颠。\n推刍挽粟徒喧喧，边臣无心靖国艰。\n为余讽此伐棘篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题惠泉师壁","author":"路振","text":"汉公尝说惠泉师，解讲楞严解赋诗。\n今日我来师已去，草堂风雨立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]