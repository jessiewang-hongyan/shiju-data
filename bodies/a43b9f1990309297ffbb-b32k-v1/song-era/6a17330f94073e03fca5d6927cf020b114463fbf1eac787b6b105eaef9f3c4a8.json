[{"title":"绩溪书怀 其二","author":"董楷","text":"阁雪峰阴未肯明，卧听寒玉泻檐声。\n官居不事閒来往，闭户焚香养性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董端公墓","author":"董煟","text":"从来正气关天地，捍禦功成死不妨。\n守土忠贞唐许远，埋轮节概汉张纲。\n麒麟高冢閒金盌，屃赑丰碑重玉堂。\n旷代衣冠谁解识，令人终古泣斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题山寺壁","author":"董遘","text":"寺中荆棘老侵云，恶木狰狞野外村。\n原上狐狸走白日，水边魑魅立黄昏。\n山鬼相呼夜月黑，怪禽恶语向风喧。\n挑灯待晓安能寐，一夜惊忧紧闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上","author":"董颖","text":"万顷沧江万顷秋，镜天飞雪一双鸥。\n摩挲数尺沙边柳，待汝成阴系钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅中追和微之韵示詹次山","author":"董颖","text":"日近长安远，风高易水寒。\n畏途君莫问，何啻上天难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿叶陂用前韵","author":"董颖","text":"别业松间八九椽，何宜清夜对床眠。\n飞流溅沫知何处，环佩馀青到枕前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题龙岩居士墨梅","author":"董颖","text":"龙岩戏墨作横枝，韵胜何妨不入时。\n黑雾玄霜遮缟袂，玉妃谪堕畏人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵质夫艇斋 其二","author":"董颖","text":"瘦竹吟风横笛处，丛蕉著雨打蓬时。\n锦鳞只向铜盘钓，鳙比松江似更奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵质夫艇斋 其一","author":"董颖","text":"画舫风流六一翁，君分小样过江东。\n拥袍坐对舒波月，不减披蓑雪浪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题舫斋","author":"董颖","text":"措顾蛟鼍宅九衢，谁能经济运雄图。\n先生道义为舟楫，可但三江与五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文约赠行","author":"董颖","text":"归买农畴一饱休，乌鸢储肉且身谋。\n扁舟欲趁晚潮发，别袂莫烦樽酒留。\n松菊有情供好梦，氛埃无赖犯征裘。\n明年驿使相逢处，还折梅花寄我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈泽中明府","author":"董颖","text":"能延仓卒客，不以在亡辞。\n错倒蔡邕屣，初无匡鼎诗。\n病多殊怕酒，算少敢谈棋。\n愿见纤纤玉，轻红擘荔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺曾修撰帅江陵 其四","author":"董颖","text":"化蜀归来欲醉吟，君王又起福淮民。\n旌旗光动迟迟日，鼓角声传盎盎春。\n风采十州安抚使，典刑四海老成人。\n屯田小试营平策，蚤晚论思从紫辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺曾修撰帅江陵 其三","author":"董颖","text":"大府山河壮，严城鼓角雄。\n先声消鼠辈，善颂到牛童。\n八境风烟上，千篇咳唾中。\n鳌头聊尔耳，归觐大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺曾修撰帅江陵 其一","author":"董颖","text":"控蜀连吴最上流，清时词伯拜元侯。\n骎骎和气随千骑，籍籍英声慰十州。\n士识朝宗方定价，客依刘表祇销忧。\n三朝开济元勋后，蝉冕还应映黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺曾修撰帅江陵 其五","author":"董颖","text":"麟符虎节烂龙光，势重侯藩壮帝乡。\n那复谢玄将淝水，政烦汲黯守淮阳。\n咄嗟万户无穷惠，清净三州已试方。\n馀事不妨哦妙句，韦郎韵胜寝凝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺曾修撰帅江陵 其二","author":"董颖","text":"荆州刺史苏州似，可但超然五字诗。\n试问清香凝寝处，何如夜雨对床时。\n风流云散心方折，月落参横角更悲。\n堂下为公理脩竹，琳琅他日照幽姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题杨德辰清隐堂借至游老人韵","author":"董颖","text":"杨郎丘壑尚，草堂脩竹林。\n去郭十里近，而无车马音。\n鹤怨不应闻，鸥盟政尔寻。\n九畹兰荃富，三径蓬蒿深。\n窗间焦尾曲，聊答清风吟。\n英英彼白云，出岫得无心。\n渊明既容膝，那复历岖嵚。\n狂夫十年狂，客鬓吴霜侵。\n因君发深省，杖藜合从今。\n寄傲有馀地，不妨成盍簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 子平席上赋","author":"董颖","text":"春浅借和风，吹绿庭皋树。\n依约屏间出紫云，入阁风流处。\n便做铁心肠，也为梅花语。\n欲去东君更挽留，巧栈烟霞路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 元礼席上用少游韵","author":"董颖","text":"红斗风桃，绿肥烟草，杨柳春暗重门。\n五陵佳兴，酿酝付芳尊。\n窈窕笙箫丛里，金猊篆、雾绕云纷。\n勾情也，歌眉低翠，依约鹧鸪村。\n人生须快意，十分春事，才破三分。\n况点检年时，胜客都存。\n更把馀欢卜夜，纵彻晓、蜡泪流痕。\n花阴昼，朱帘未卷，犹自醉昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚 西子词 排遍第八","author":"董颖","text":"怒潮卷雪，巍岫布云，越襟吴带如斯。\n有客经游，月伴风随。\n值盛世。\n观此江山美。\n合放怀、何事却兴悲。\n不为回头，旧谷天涯。\n为想前君事。\n越王嫁祸献西施。\n吴即中深机。\n阖庐死。\n有遗誓。\n句践必诛夷。\n吴未干戈出境，仓卒越兵，投怒夫差。\n鼎沸鲸鲵。\n越遭劲敌，可怜无计脱重围。\n归路茫然，城郭丘墟，飘泊稽山里。\n旅魂暗逐战尘飞。\n天日惨无辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚 第五衮遍","author":"董颖","text":"机有神，征鼙一鼓，万马襟喉地。\n庭喋血，诛留守，怜屈服，敛兵还，危如此。\n当除祸本，重结人心，争奈竟荒迷。\n战骨方埋，灵旗又指。\n势连败。\n柔荑携泣。\n不忍相抛弃。\n身在兮，心先死。\n宵奔兮，兵已前围。\n谋穷计尽，唳鹤啼猿，闻处分外悲。\n丹穴纵近，谁容再归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚","author":"董颖","text":"华宴夕，灯摇醉。\n粉菡萏，笼蟾桂。\n扬翠袖，含风舞，轻妙处，惊鸿态。\n分明是。\n瑶台琼榭，阆苑蓬壶，景尽移此地。\n花绕仙步，莺随管吹。\n宝帐暖留春，百和馥郁融鸳被。\n银漏永，楚云浓，三竿日、犹褪霞衣。\n宿酲轻腕，嗅宫花，双带系。\n合同心时。\n波下比目，深怜到底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚 第四催拍","author":"董颖","text":"耳盈丝竹，眼摇珠翠。\n迷乐事。\n宫闱内。\n争知。\n渐国势凌夷。\n奸臣献佞，转恣奢淫，天谴岁屡饥。\n从此万姓离心解体。\n越遣使。\n阴窥虚实，蚤夜营边备。\n兵未动，子胥存，虽堪伐、尚畏忠义。\n斯人既戮，又且严兵卷土，赴黄池观衅，种蠡方云可矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚","author":"董颖","text":"哀诚屡吐，甬东分赐。\n垂暮日，置荒隅，心知愧。\n宝锷红委。\n鸾存凤去，辜负恩怜，情不似虞姬。\n尚望论功，荣还故里。\n降令曰，吴亡赦汝，越与吴何异。\n吴正怨，越方疑。\n从公论、合去妖类。\n蛾眉宛转，竟殒鲛绡，香骨委尘泥。\n渺渺姑苏，荒芜鹿戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚 第七煞衮","author":"董颖","text":"王公子。\n青春更才美。\n风流慕连理。\n耶溪一日，悠悠回首凝思。\n云鬟烟鬓，玉佩霞裾，依约露妍姿。\n送目惊喜。\n俄迂玉趾。\n同仙骑。\n洞府归去，帘栊窈窕戏鱼水。\n正一点犀通，遽别恨何已。\n媚魄千载，教人属意。\n况当时。\n金殿里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚 第二虚催","author":"董颖","text":"飞云驶。\n香车故国难回睇。\n芳心渐摇，迤逦吴都繁丽。\n忠臣子胥，预知道为邦祟。\n谏言先启。\n愿勿容其至。\n周亡褒姒。\n商倾妲己。\n吴王却嫌胥逆耳。\n才经眼、便深恩爱。\n东风暗绽娇蕊。\n彩鸾翻妒伊。\n得取次、于飞共戏。\n金屋看承，他宫尽废。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚 第十攧","author":"董颖","text":"种陈谋，谓吴兵正炽。\n越勇难施。\n破吴策，唯妖姬。\n有倾城妙丽。\n名称西子。\n岁方笄。\n算夫差惑此。\n须致颠危。\n范蠡微行，珠贝为香饵。\n苎萝不钓钓深闺。\n吞饵果殊姿。\n素肌纤弱，不胜罗绮。\n鸾镜畔、粉面淡匀，梨花一朵琼壶里。\n嫣然意态娇春，寸眸剪水。\n斜鬟松翠。\n人无双、宜名动君王，绣履容易。\n来登玉陛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚","author":"董颖","text":"窣湘裙，摇汉佩。\n步步香风起。\n敛双蛾，论时事。\n兰心巧会君意。\n殊珍异宝，犹自朝臣未与。\n妾何人，被此隆恩，虽令效死。\n奉严旨。\n隐约龙姿忻悦。\n重把甘言说。\n辞俊雅，质娉婷，天教汝、众美兼备。\n闻吴重色，凭汝和亲，应为靖边陲。\n将别金门，俄挥粉泪。\n靓妆洗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄媚 西子词 排遍第九","author":"董颖","text":"自笑平生，英气凌云，凛然万里宣威。\n那知此际。\n熊虎涂穷，来伴麋鹿卑栖。\n既甘臣妾，犹不许，何为计。\n争若都燔宝器。\n尽诛吾妻子。\n径将死战决雄雌。\n天意恐怜之。\n偶闻太宰，正擅权，贪赂市恩私。\n因将宝玩献诚，虽脱霜戈，石室囚系。\n忧嗟又经时。\n恨不如巢燕自由归。\n残月朦胧，寒雨萧萧，有血都成泪。\n备尝险厄返邦畿。\n冤愤刻肝脾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"董颖","text":"云壑酿成千嶂雨，风蘋吹老一汀秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登第报家人","author":"董德元","text":"御笔封题墨未乾，君恩重许拜金銮。\n故乡若问登科事，便是当初老榜官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳梢青","author":"董德元","text":"满腹文章，满头霜雪，满面埃尘。\n直至如今，别无收拾，只有清贫。\n功名已是因循。\n最懊恨、张巡李巡。\n几个明年，几番好运，只是瞒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄彦与从无逸求妻埋铭以研谢之无逸邀予作歌","author":"董瞿老","text":"君不见昌黎翁，南迁益觉文章工。\n滑稽戏作毛颖传，陶泓之族称宏农。\n又不见东坡翁，生涯寄食破研中。\n诋诃龙尾尊凤咮，更誇丹石蒸赤红。\n古来文士耽翰墨，十有八九坐此穷。\n怪君落笔妙言语，四壁才堪蔽风雨。\n几年结柳送奴星，文穷跳梁推不去。\n研能穷人君不鄙，尔来谀墓得龙尾。\n缇巾十袭不妄观，碑字三缣何足拟。\n玉堂视草乃称之，只恐玄文似扬子。\n君誇此研文似罗，奈君鹿裘带索何。\n我虽忍穷亦好事，尚能搜句为君歌。\n呜呼鲁公乞米家食粥，不费银钩写珠玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"蒋子云","text":"叶暗乳鸦啼，风定老红犹落。\n蝴蝶不随春去，入薰风池阁。\n休歌金缕劝金卮，酒病煞如昨。\n帘卷日长人静，任杨花飘泊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过象州","author":"蒋山卿","text":"秦皇开象郡，兹事已千年。\n台古埋秋草，城荒起暮烟。\n江天云漠漠，石岭月娟娟。\n万里惭漂泊，因风怀昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第一山","author":"蒋介","text":"第一山前万里秋，野花衰草替人愁。\n中原好在平如掌，莫把长淮当白沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩禅寺","author":"蒋允中","text":"晓入灵岩寺，灵踪一一穿。\n天聪凿混沌，龙鼻滴潺湲。\n不雨山长湿，微风谷竞喧。\n参旗开障日，鳌柱仰擎天。\n雁异灵山鹫，蒲非华岳莲。\n重台疑魏载，卓笔岂张颠。\n夜月连千嶂，晴云画一川。\n净名常宴坐，行亮昔安禅。\n共乐仙游胜，都将世事捐。\n双鸾知可跨，拟把石碑镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌夜啼","author":"蒋元龙","text":"小桃落尽残红。\n夜来风。\n又是一番春事、不从容。\n翠屏掩。\n芳信断。\n转愁浓。\n可惜日长闲暇、小帘栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮郎归 春雨","author":"蒋元龙","text":"小池芳草绿初匀。\n柳寒眉尚颦。\n东风吹雨细于尘。\n一庭花脸皴。\n莺共蝶，怨还嗔。\n眼前无好春。\n这般天气煞愁人。\n人愁旋旋新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柘川渔火","author":"蒋旦","text":"桃浪流香春雨馀，渔灯深夜出溪湄。\n半篷明灭风生处，数点微茫月上时。\n影落沙汀鸥梦断，光摇芦苇雁栖迟。\n明朝解缆沧浪外，濯足船头唱竹枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题禹庙","author":"蒋白","text":"大禹归天后，南惟此庙存。\n屋腥龙挂影，岩墨电烧痕。\n夜祭云间火，春鼙浪里门。\n到今疏凿水，敢不向东奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 题雄州驿","author":"蒋兴祖女","text":"朝云横度，辘辘车声如水去。\n白草黄沙，月照孤村三两家。\n飞鸿过也，百结愁肠无昼夜。\n渐近燕山，回首乡关归路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独客","author":"蒋华子","text":"独客秋江上，萧萧发欲华。\n终风撼红树，甚雨老黄花。\n丘垄应无恙，音书不到家。\n眠孤怨遥夜，归梦绕鸥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题孙得休居室","author":"蒋华子","text":"住世百来年，童颜只俨然。\n道心丹灶外，诗趣笔床边。\n瓮牖清虚府，盆池小有天。\n云关谁剥啄，端是问神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚谣","author":"蒋华子","text":"汀洲三月杨花飞，河鲀出水江鲚肥。\n雨声翻作断肠曲，薄寒恋恋轻罗衣。\n新愁压眉双碧聚，作意挽春春不住。\n无情恨杀蜀帝魂，不劝归来劝归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"笋","author":"蒋华子","text":"头角崭崭露，江南四月时。\n定应孤竹子，未脱老莱衣。\n怒长支苔石，旁行过棘篱。\n不来能几日，渐学翠鸾飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"补衣","author":"蒋廷玉","text":"百补未成片，何缘御得寒。\n拆时如网裂，纫处著针难。\n色样多无定，花纹斗不完。\n分明类禅衲，其奈戴儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净刹","author":"蒋廷玉","text":"碑上文难读，开山失所传。\n岩松秋落子，石井夜添泉。\n地旷常多月，厨寒不起烟。\n昔年曾有虎，来到寺门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋意","author":"蒋廷玉","text":"秋意如诗淡，又如湘水清。\n无家人易感，有笔画难成。\n月冷砧千杵，江空雁一声。\n梦回蕉叶上，残雨几番鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠陈宗之","author":"蒋廷玉","text":"经营一室面清波，不是儒衣不见过。\n南渡好诗都刻尽，中朝名士与交多。\n分甘书史窝中老，兴在江湖醉后歌。\n门外今年桐又长，不知堪系我船么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶梦麟往惟扬","author":"蒋廷玉","text":"一马扬州路，桃开几树花。\n春光无拣择，淮地亦繁华。\n日惨长江水，风昏古战沙。\n争雄旧时事，君去莫思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绦","author":"蒋廷玉","text":"八百青铜买，归来系黑豹。\n松毛倒垂膝，棕绠曲围腰。\n稳称轻纱帽，宜悬小药瓢。\n有时吟未就，频在手中摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎丘","author":"蒋孝言","text":"秀色回环眼倍明，醒馀洒面竹风清。\n快哉气且吞云梦，便欲飘然上玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题浯溪二首 其二","author":"蒋孝忠","text":"我宋中原二百州，版图渐入掌中收。\n只今更办河清颂，勒向燕然最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题浯溪二首 其一","author":"蒋孝忠","text":"好山好水占浯溪，中直磨崖一片碑。\n试问天齐齐几许，从他元子剩夸毗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贞义女祠","author":"蒋时中","text":"幼年曾读贞女碑，坐想濑水清涟漪。\n试来江东吊李白，瓣香敬谒贞女祠。\n平生不数子胥子，鞭平进诸何至此。\n有金投濑竟何为，当时岂为将军死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄山观","author":"蒋时中","text":"黄鹤山中黄鹤观，黄鹤仙人此修炼。\n功成羽化归丹丘，环佩珊珊度遥汉。\n昔闻有鸟名令威，去家千年今来归。\n仙人一去不复返，长松落雪秋霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题澹山岩","author":"蒋纬","text":"风生崖木响，霭散洞门宽。\n幽径盘危入，青天一面看。\n三冬僧定煖，五月客游寒。\n纵有通神笔，亦应图出难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张道洽","author":"蒋芸","text":"衰柳疏松对夕阳，老来秋思倍堪伤。\n已无上苑千葩秀，仅有东篱一捻黄。\n细诵佳章排宿恨，旋呼村酒纵诗狂。\n西风策马能过我，老圃馀蔬尚未荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张霖溪","author":"蒋芸","text":"漫向潭源晦此身，自嗟无地可投明。\n栽培劲节依岩翠，采撷香芹绕涧清。\n避乱遣怀聊圃治，论交且喜傍山行。\n何时并辔临溪上，静听飞泉万壑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞荐呈余廉访","author":"蒋芸","text":"耒耜生涯远俗嚣，年来无梦到金貂。\n一池皓月□诗骨，满圃春风长药苗。\n愧不漆身吞豫炭，聊将洗耳弃由瓢。\n分甘投老潭源地，为谢云笺莫见招。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归寄余玠","author":"蒋凯","text":"病觉腰金重，君恩报已辜。\n发从秋后落，花向雨中疏。\n诗礼堪谁倚，山川赖有图。\n百年心里事，渔钓老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]