[{"title":"偈颂十四首 其八","author":"释宗杲","text":"青毡本是吾家物，今日重还旧日僧。\n珍重圣恩何以报，万年松上一枝藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其七","author":"释宗杲","text":"荒田无人耕，耕著有人争。\n无风荷叶动，决定有鱼行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其五","author":"释宗杲","text":"佛之一字尚不喜，有何生死可相关。\n当机觌面难回互，说甚楞严义八还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其三","author":"释宗杲","text":"一刀截断生死路，摩醯正眼顶门开。\n无边业障俱锁殒，寒山拾得在天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄无垢居士","author":"释宗杲","text":"上苑玉池方解冻，人间杨柳又垂春。\n山堂尽日焚香坐，长忆毗耶多口人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄福胜长老","author":"释宗杲","text":"真人十八界元空，三十一人同姓吕。\n分散游山各占山，三十一人又同处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"船子和尚赞","author":"释宗杲","text":"蓦口一桡玄路绝，药山之道始流传。\n离钩三寸无消息，觉海方乘般若船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喻郎中观我庵","author":"释宗杲","text":"万物备于我，我观卒未休。\n智者返观我，纵横得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩司谏乐谷","author":"释宗杲","text":"人言至乐在此谷，孰信乐为谷所移。\n以乐均施不乐者，方名真乐丈夫儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和觉禅师赋六湛堂","author":"释妙喜","text":"非湛非摇此法源，当机莫厌假名存。\n直须过量英灵汉，方入无边广大门。\n万境交罗元不二，六窗昼夜未尝昏。\n翻思庞老事无别，掷剑挥空岂有痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文俊禅人求赞","author":"释宗杲","text":"咄这担版汉，从来无所知。\n曾经一顿饱，忘却累年饥。\n动便触人讳，拍盲不识时。\n平生没活计，赤手讨便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三五","author":"释宗杲","text":"衲僧相见莫疑猜，布袋结头今日开。\n露柱著衫南岳去，灯笼脱帽上天台。\n只有云门木上座，终年无去亦无来。\n有时独靠古屏畔，觑破门前下马台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人求赞 其二","author":"释宗杲","text":"邹搜敛似天烝枣，轻轻触著便烦恼。\n身著如来三事衣，口中谤佛法僧宝。\n从来纤芥不与人，一毫不就他人讨。\n蓦然合眼入黄泉，定须聒噪阎罗老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧鹗禅人求赞","author":"释宗杲","text":"这汉一生空倔彊，偏向人前放软顽。\n涅槃路上栽荆棘，解脱门前紧著关。\n不别法身三种病，岂识楞严义八还。\n谩把少林在孔笛，等闲吹过汩罗湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入定观音赞","author":"释宗杲","text":"世间种种音声相，众以耳听非目睹。\n唯此大士眼能观，瞑目谛观为佛事。\n于眼境界无所取，耳鼻舌身意亦然。\n善哉心洞十方空，六根互显如是义。\n眼色耳声鼻嗅香，身触意思无差别。\n当以此观如是观，取此为实成妄想。\n若离妄想取实法，展转惑乱失本心。\n本心既失随颠倒，不见大士妙色身。\n无眼耳鼻舌身意，互显这义亦寂灭。\n亦无在土妙色身，亦无种种音声相。\n佛子能作如是观，永离世间生死苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门和尚赞","author":"释宗杲","text":"开雪峰口，出睦州气。\n袖手俨然，眈眈虎视。\n我说是言，有语无义。\n石火电光，咄哉钝滞。\n伽梨勃窣知是谁，有人续得末后句，许尔亲见渠侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五祖演和尚赞二首 其一","author":"释宗杲","text":"赤骨力地，有?无裤。\n敢与海神，争先斗富。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天童和尚赞","author":"释宗杲","text":"烹佛烹祖大炉韝，锻凡锻圣恶钳锤。\n起曹洞于已坠之际，针膏肓于必死之时。\n善说法要，罔涉离微。\n不起于座，而变荆棘林为梵释龙天之宫而无作无为。\n神澄定灵，雪顶庞眉。\n良工幻出兮，不许僧繇知。\n虚堂张挂兮，梁宝公犹迷。\n个是天童老古锥，妙喜知音更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文殊问疾赞","author":"释宗杲","text":"居士何曾病，是病因问有。\n两眼对两眼，世医咸拱手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无著道人请赞","author":"释宗杲","text":"汝求吾之赞，复赞吾之真。\n大海绝涓滴，须弥无一尘。\n以讦为直而非直，以察为明而非明。\n象王回旋，师子嚬呻。\n性不可会，瞥喜瞥瞋。\n与佛祖为冤敌，与魔外为亲姻。\n自是其是，而人不汝是。\n自神其神，而人不汝神。\n如此为人善知识，少吃酸醋三五升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长灵卓如和尚赞","author":"释宗杲","text":"厚重如山，严冷似铁。\n破毗卢印，坐衲僧舌。\n派出灵源，源清流彻。\n指曜灵寒，呼顾兔热。\n谓此是长灵眼中重著屑，谓此非长灵知君犹未瞥。\n是耶非耶，俱为剩说。\n真耶妄耶，水中捉月。\n而今要见这老人，剔起眉毛须辨别。\n嘉州大像吃一槌，陕府铁牛流出血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋和尚赞二首 其二","author":"释宗杲","text":"肩担一条吉撩棒，棒头挂双破木履。\n尽力撮却布袋口，不知里许有甚底。\n落落魄魄闹市行，藞藞苴苴没羞耻。\n龙华会上若逢渠，定与椎落当门齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋和尚赞二首 其一","author":"释宗杲","text":"三千威仪都不修，八万细行浑不顾。\n只因闹市等个人，被人唤作破落户。\n兜率内院久抛离，纵归迷却来时路。\n稽首弥勒世尊，得恁宽肠大肚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示大悲长老","author":"释宗杲","text":"一棒打破生死窟，当时凡圣绝行踪。\n返笑赵州心不歇，老来犹自走西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示用禅人","author":"释宗杲","text":"未点先行不唧溜，不拨自转已出丑。\n那堪更鼓两片皮，岂止凿空开户牖。\n火中木马空嘶鸣，水底泥牛谩哮吼。\n用禅用禅听我言，拶到悬崖须放手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示法泉侍者","author":"释宗杲","text":"言前超佛祖，日轮正当午。\n豁开三要关，一击涂毒鼓。\n既发上头机，莫问千钧弩。\n放去绝遮拦，捏聚非回互。\n咄哉老瞿昙，住住住住住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示祖元禅人","author":"释宗杲","text":"万仞崖头解放身，起来依旧却惺惺。\n饥餐渴饮浑无事，那论昔人非昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示遵璞禅人","author":"释宗杲","text":"一口吞尽三世佛，正是吾家客作儿。\n争似璞禅无用处，一毛头上便忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示韩令人","author":"释宗杲","text":"说不到处著一句，风前截断千差路。\n超佛越祖只如今，壁立万仞无回互。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示鼎需禅人","author":"释宗杲","text":"面门竖亚摩醯眼，肘后斜悬夺命符。\n瞎却眼，解却符，赵州东壁挂葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冲密禅人求赞","author":"释宗杲","text":"佛祖有密语，有说即不密。\n密禅画吾真，密意已漏泄。\n如析栴檀香，片片体非别。\n密意在其中，密亦如是说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"向侍郎无热轩","author":"释宗杲","text":"勇猛精进过量人，号曰芗林大居士。\n住无变易真实处，而常顺行诸佛法。\n不作世间颠倒业，成办出世胜方便。\n而能于此方便中，幻出难思诸境界。\n复于难思境界中，而现种种殊胜事。\n华林宝树咸放光，接影连辉相鉴彻。\n光色清净如金刚，世间无有能坏者。\n又如无热大宝池，四面分流入于海。\n是海广大无边际，不出居士一毛孔。\n于一毛孔放光明，八万四千同时发。\n不劳居士转舌相，只以此光宣妙法。\n是法即是此光明，不离是光说此法。\n大海毛孔亦复尔，此是芗林无热义。\n是义如空不可量，一一包罗世间相。\n我今以此无义语，略为居士出只手。\n佛子来登无热轩，众宝妙沙开户牖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"守净禅人求赞","author":"释宗杲","text":"瞋恚痴未除，心意识颠倒。\n谈禅信口开，舌头胡乱扫。\n其施汝者不名福田，供养汝者堕三恶道。\n个是云门村僧，即非杜撰长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师玿长老求赞","author":"释宗杲","text":"画得百千本，都卢祇这是。\n师玿好承当，杨岐第七世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庄泉伯检察为先安抚请升堂偈","author":"释宗杲","text":"近来学佛人，少见不颠倒。\n唯务资谈柄，弃大而就小。\n昧却直截事，外边打之绕。\n毕竟那一著，何曾得分晓。\n独有庄居士，真实没虚矫。\n断除烦恼根，烈火烧乾草。\n心地既安然，魔境岂能扰。\n任尔闹浩浩，我常静悄悄。\n末后示真归，如脱破布袄。\n加趺入禅定，皓月临清沼。\n透过生死关，击碎无价宝。\n刚正大丈夫，一了一切了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱主簿请赞","author":"释宗杲","text":"庞老曾升马祖堂，西江吸尽更无双。\n而今妙喜朱居士，觌面分明不覆藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江令请赞","author":"释宗杲","text":"渠本宣州人，生缘在宁国。\n前不尊释迦，后不敬弥勒。\n家贫无饭噇，出家去投佛。\n行脚走诸方，江南遍江北。\n才参临济禅，便作白拈贼。\n眼里有瞳人，肚中无点墨。\n还如跛阿师，说得行不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹庵圭和尚赞","author":"释宗杲","text":"赞叹竹庵也是妙喜，骂詈竹庵也是妙喜，赞之骂之各有所以。\n赞之者为渠具衲僧正眼，骂之者为渠浸在醋瓮里。\n或曰如竹庵之为宗师也，不可赞不可骂。\n精金美玉自有定价，赞之骂之徒增话把。\n妙喜闻之笑而不答，但拊掌叩齿三下，从教渠赞龟打瓦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟峰长老求赞","author":"释宗杲","text":"萧萧洒洒，有取有舍。\n藞藞苴苴，无真无假。\n客来须看，贼来须打。\n一条竹篦，天上天下。\n背触当锋，任人酬价。\n咄哉村僧，少说大话。\n龟年收取挂高堂，从他赞叹从他骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西余端和尚赞","author":"释宗杲","text":"被底礼寅朝，去住随风扫。\n名呼章相公，侮嫚圆照老。\n不托和尚，两拳打翻。\n回头妖僧，一句骂倒。\n只看这几著子，不必问他禅道。\n个是金毛师子儿，狐狸野干徒叫噪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音大士赞","author":"释宗杲","text":"过去正法明，现前观自在。\n眼观诸音声，耳听众妙色。\n二义俱寂灭，谁受此说者。\n是说亦寂灭，谁为此说者。\n能观及所观，能听洎所听。\n返观观听者，是亦无所有。\n大哉观世音，快说如是法。\n是法不思议，听者亦希有。\n我今以一毛，遍量法界空。\n作此如幻言，赞是真实要。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许司理请赞","author":"释宗杲","text":"湛不摇处，正好著力。\n欲识吾真，出阴界入。\n一毛端头，师子返掷。\n赤肉团上，万仞壁立。\n冲密湛然知不知，铁牛生得玉猫儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛灯珣和尚赞","author":"释宗杲","text":"天姿出格萧洒，胸次过人惺惺。\n临济顶中髓，杨岐眼里睛。\n棒头明杀活，喝下显疏亲。\n孤鸾无伴侣，师子不同群。\n钟山佛鉴这嫡子，双径山僧之法兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初祖达磨大师赞","author":"释宗杲","text":"来时已没当门齿，去时唯有一只履。\n葱岭那边逢宋云，十分彰露丑举止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙道禅人求赞","author":"释宗杲","text":"这村僧，无明大。\n少柔和，多褊隘。\n爱骂人，舌头快。\n受佛荫，破佛戒。\n不精进，常懈怠。\n谤般若，弥天罪。\n入地狱，永不悔。\n闻者憎，见者怪。\n搅丛林，尤叵耐。\n虚销信施三十年，异世出头偿夙债。\n就中只有一处长，解道鸡屿洋无盖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪状元燕坐轩","author":"释宗杲","text":"不于三界现身意，棹举何如愦愦时。\n寄语轩中燕坐者，好看新月下前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證通身一具金锁骨偈","author":"释宗杲","text":"通身一具金锁骨，堪与人天为规则。\n要识临济小厮儿，便是当年白拈贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如本禅人求赞","author":"释宗杲","text":"真兮妄兮两孤，作对待兮偏枯。\n水凌虚而风静兮月非无，即妄即真兮毒药与醍醐。\n到此谁人识得渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法宝禅人求赞","author":"释宗杲","text":"这无状，世间稀。\n住佛屋，著佛衣。\n噇佛饭，说佛非。\n多忿怒，少慈悲。\n画得似差毫氂，宝禅者应自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑学士请赞","author":"释宗杲","text":"参得圜悟禅，担起睦州版。\n透过祖师关，瞎却顶门眼。\n肚里黑漫漫，这中平坦坦。\n性气得人憎，发时浑不管。\n巩县茶瓶吃一槌，击碎饶州白瓷碗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金华圣者赞","author":"释宗杲","text":"金华圣者谁识，撞著猪头便吃。\n虽然无爱无憎，其奈有损有益。\n使得破落僧徒，也道逆行顺行天莫测。\n若无末后一著，至今有口难分析。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济和尚赞","author":"释宗杲","text":"称锤上捏出汁，枯骨里敲出髓。\n全无些子蕴藉，一味卖弄口嘴。\n更说甚么三要三玄，四种料拣。\n大似青天白日，十字街头，见神见鬼。\n咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临寂颂","author":"释宗杲","text":"生也只恁么，死也只恁么。\n有偈与无偈，是甚么热大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南安岩主赞","author":"释宗杲","text":"赠以之中语，咸云秘密言。\n谁知此老子，非妙亦非玄。\n直截不藏覆，当机火里莲。\n谁人明此意，端坐自擎拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思岳禅人求赞","author":"释宗杲","text":"两耳卓朔口门窄，两眼皮薄鼻露窍。\n一生舌本谩澜翻，何曾唱得胡家调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉州惠安县迎藏经请小参偈","author":"释宗杲","text":"稽首十力大导师，三界独尊无比况。\n示现成佛转法轮，广演无边契经海。\n众生心想念念殊，所转法轮亦差别。\n法轮功德不可量，尽思竭力无能测。\n有大经卷在一尘，量等三千大千界。\n世有聪慧明达人，具足天眼悉知见。\n破尘出经作佛事，不作实与非实想。\n又以无边法界空，纳在佛身一毛孔。\n须弥铁围及大海，一一包容无迫隘。\n一毛既尔馀悉然，导师方便亦如是。\n念念普遍诸毛孔，念念克證金刚慧。\n念念成就佛菩提，念念满足普贤愿。\n而不生于戏论心，亦不住于深境界。\n如梦如幻如水月，如优昙华出世间。\n如是常转大经卷，了无能转所转者。\n三世诸佛诸菩萨，声闻独觉及天人。\n地狱修罗鬼畜等，一一皆承此经力。\n我今复与诸佛子，各生殊胜难遇心。\n还摄此经一归尘，安住毗卢法宝藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝在建邸请升堂偈","author":"释宗杲","text":"豁开顶门眼，照彻大千界。\n既作法中王，于法得自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖传禅人求赞","author":"释宗杲","text":"藞苴全似川僧，萧洒浑如浙客。\n偏向情未生时，拈出报慈一隔。\n尊性不定，莫可窥测。\n见小时嫌蟭螟眼太宽，见大时谓太虚空忒窄。\n似这般底阿师，如何受人天供养，好与劈腮一掴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂清和尚赞","author":"释宗杲","text":"凛凛孤风世所稀，碧眸炯炯电光辉。\n贫儿示与衣中宝，富者教伊赤体归。\n毒手惯曾烹佛祖，洪炉常用大钳锤。\n小根魔子还知否，此是吾家真白眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵通判请赞","author":"释宗杲","text":"渭汝是善人耶，嫉恶之太甚。\n谓汝是恶人耶，好贤而乐善。\n而于善恶两涂之间了无遗恨。\n咦，好个自是汉，高谈无畔岸，成佛作祖且缓缓。\n这一则公案，分付赵通判。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送了明长老归长芦","author":"释宗杲","text":"人言棒头出孝子，我道怜儿不觉丑。\n长芦长老恁么来，妙喜空费一张口。\n从教四海妄流传，野干能作师子吼。\n孰云无物赠伊行，喝下铁围山倒走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送法轮思藏主化钟","author":"释宗杲","text":"覆为钟，仰为鼎。\n自是法轮家风，妙喜争取驰骋。\n思禅人，固相请。\n援毫临纸忽猛省，一声直透须弥顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送超僧鉴","author":"释宗杲","text":"桶底脱时大地阔，命根断处碧潭清。\n好将一点红炉雪，散作人间照夜灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻监务请赞","author":"释宗杲","text":"谓汝太惺惺，时复放淈?。\n谓汝太褊急，间或又容物。\n既作人天师，开口便轻忽。\n庄严贤劫中，且无如此佛。\n寄语闻子清，莫信这个贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]