[{"title":"好事近 其五 海棠","author":"周紫芝","text":"春似酒杯浓，醉得海棠无力。\n谁染玉肌丰脸，做燕支颜色。\n送春风雨最无情，吹残也堪惜。\n何似且留花住，唤小鬟催拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其三","author":"周紫芝","text":"帘外一声歌，倾尽满城风月。\n看到酒阑羞处，想多情难说。\n周郎元是个中人，如今鬓如雪。\n自恨老来肠肚，诮不堪摧折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其一 青阳道中见梅花。是日微风，花已有落者","author":"周紫芝","text":"江路绕青山，山翠扑衣轻湿。\n谁酿晚来云意，做一天愁色。\n竹溪斜度尽篮舆，疏梅暗香入。\n何处最关心事，恨落梅风急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其四","author":"周紫芝","text":"雨后欲斜阳，红满井梧风叶。\n还是夜来时候，共小轩明月。\n不关纤手与调冰，消除这些热。\n自是月娥肌骨，似玉壶香雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其六","author":"周紫芝","text":"秋意总关愁，那更与君轻别。\n从此共谁同醉，恨老来风月。\n遥知手板笑看云，江边醉时节，应为老人回首，记白头如雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子 其二","author":"周紫芝","text":"碧梧和露滴清秋。\n小庭幽。\n翠烟流。\n羞带一襟，明月上危楼。\n苦恨秋江风与月，偏管断，这些愁。\n此情空道两绸缪。\n信悠悠。\n几时休。\n到得如今，刬地见无由。\n拟待不能思想得，无限事，在心头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子 其一","author":"周紫芝","text":"夕阳低尽柳如烟。\n淡平川。\n断肠天。\n今夜十分，霜月更娟娟。\n怎得人如天上月，虽暂缺，有时圆。\n断云飞雨又经年。\n思凄然。\n泪涓涓。\n且做如今，要见也无缘。\n因甚江头来处雁，飞不到，小楼边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西地锦","author":"周紫芝","text":"雨细欲收还滴。\n满一庭秋色。\n阑干独倚，无人共说，这些愁寂。\n手把玉郎书迹。\n怎不教人忆。\n看看又是黄昏也，敛眉峰轻碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其七","author":"周紫芝","text":"谁把蓝揉翡翠，天将蜡做梅花。\n晚来秋水映残霞。\n水墨新描图画。\n纸上写将心去，眼边送却愁来。\n今回相见比前回。\n心下忡忡越㬠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其六 和孙子绍拒霜词","author":"周紫芝","text":"天意未教秋老，花容刬地宜霜。\n酒肌红软玉肌香。\n不与梨花同样。\n来伴孙郎小宴，临风为舞霓裳。\n更深绿水照红妆。\n便是采莲船上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其五 席上赋双荔子","author":"周紫芝","text":"连理枝头并蒂，同心带上双垂。\n背灯偷赠语低低。\n一点浓情先寄。\n翡翠钗头摘处，鸳鸯枕上醒时。\n酸甜红颗阿谁知。\n别是人间滋味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其三","author":"周紫芝","text":"罗袖云轻雾薄，醉肌玉软花柔。\n相逢不道有春愁。\n只道春来微瘦。\n一点人间深意，数声柳下轻讴。\n带将离恨上归舟。\n肠断月斜时候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一","author":"周紫芝","text":"画幕灯前细雨，垂莲盏里清歌。\n玉纤持板隔香罗。\n不放行云飞过。\n今夜尘生洛浦，明朝雨在巫山。\n羞蛾且莫斗弯环。\n不似司空见惯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二","author":"周紫芝","text":"池面风翻弱絮，树头雨退嫣红。\n扑花蝴蝶杳无踪。\n又做一场春梦。\n便是一成去了，不成没个来时。\n眼前无处说相思。\n要说除非梦里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其四","author":"周紫芝","text":"发白犹敧旅枕，溪深未挂烟莎。\n往来苕霅意如何。\n应有轻鸥笑我。\n细算年来活计，只消一个渔舟。\n金鱼无分不须求。\n只乞鲈鱼换酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其二","author":"周紫芝","text":"月棂疏影照婵娟。\n闲临小玉盘。\n枣花金钏出纤纤。\n棋声敲夜寒。\n飞雹冷，水精圆。\n夜深人未眠。\n笑催炉兽暖衾鸳。\n莫教银漏残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其三 西湖摘杨梅作","author":"周紫芝","text":"西湖山下水潺潺。\n满山风雨寒。\n枝头红日晓斓斑。\n越梅催晓丹。\n连翠叶，拥金盘。\n玉池生乳泉。\n此生三度试甘酸。\n欲归归尚难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其一","author":"周紫芝","text":"酴醾花谢日迟迟。\n杨花无数飞。\n章台侧畔尽风吹。\n飘零无定期。\n烟漠漠，草萋萋。\n江南春尽时。\n可怜踪迹尚东西。\n故园何日归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沙塞子 其一 中秋无月","author":"周紫芝","text":"秋云微淡月微羞。\n云黯黯、月彩难留。\n只应是、嫦娥心里，也似人愁。\n几时回步玉移钩。\n人共月、同上南楼。\n却重听、画阑西角，月下轻讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沙塞子 其二 席上送赵戒叔，时东南方扰","author":"周紫芝","text":"玉溪秋月浸寒波。\n忍持酒、重听骊歌。\n不堪对、绿阴飞阁，月下羞蛾。\n夜深惊鹊转南柯。\n惨别意、无奈愁何。\n他年事、不须重问，转更愁多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏幕遮 其二","author":"周紫芝","text":"老相邀，山作伴。\n千里西来，始识庐山面。\n爱酒扬雄浑不管。\n天与邻翁，来慰穷愁眼。\n似惊鸿，吹又散。\n画舸横江，望断江南岸。\n地角天涯无尽远。\n一阕清歌，且放梨花满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏幕遮 其一","author":"周紫芝","text":"水傍边，山尽处。\n唤取云来，共我山头住。\n分得一江风共雨。\n满院芙蓉，更听红妆舞。\n趁霜晴，闲独步。\n那里烟村，有个梅花树。\n小径斜穿来又去。\n醉后知他，有甚青云路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波令/定风波","author":"周紫芝","text":"梅粉梢头雨未乾。\n淡烟疏日带春寒。\n暝鸦啼处，人在小楼边。\n芳草只随春恨长，塞鸿空傍碧云还。\n断霞销尽，新月又婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 雨后至玉壶轩","author":"周紫芝","text":"跳珠雨罢风初静，阑槛凭虚。\n绛阙清都。\n只在仙人碧玉壶。\n九原唤起王摩诘，画作新图。\n十里芙蕖。\n乞与知章老鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 将离武林","author":"周紫芝","text":"云踪老去浑无定，飘泊寒空。\n又被东风。\n吹过江南第几峰。\n长安市上看花眼，不到衰翁。\n好趁归鸿。\n家在西岩碧桂丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中花令 吴兴道中，颇厌行役，作此曲寄武林交旧","author":"周紫芝","text":"山雨细、泉生幽谷，水满平田。\n雪茧红蚕熟后，黄云陇麦秋间。\n武陵烟暖，数声鸡犬，别是山川。\n嗟老去、倦游踪迹，长恨华颠。\n行尽吴头楚尾，空惭万壑千岩。\n不如休也，一庵归去，依旧云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉案 其一 凌歊台怀姑溪老人李端叔","author":"周紫芝","text":"青鞋忍踏江沙路。\n恨人已、骑鲸去。\n笔底骅骝谁与度。\n西州重到，可怜不见，华屋生存处。\n秋江渺渺高台暮。\n满壁栖鸦醉时句。\n飞上金鸾人漫许。\n清歌低唱，小蛮犹在，空湿梨花雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉案 其二","author":"周紫芝","text":"梅花落尽人谁管。\n暗凄断、伤春眼。\n雪后平芜春尚浅。\n一簪华发，满襟离恨，羞做东风伴。\n斗花小斛兰芽短。\n犹是当时旧庭院。\n拟把新愁凭酒遣。\n春衫重看，酒痕犹在，忍放金杯满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其一","author":"周紫芝","text":"水远山长何处去，欲行人似孤云。\n十分瘦损沈休文。\n忍将秋水镜，容易与君分。\n试问梨花枝上雨，为谁弹满清尊。\n一江风月黯离魂。\n平波催短棹，小立送黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其二 送光州曾使君","author":"周紫芝","text":"记得武陵相见日，六年往事堪惊。\n回头双鬓已星星。\n谁知江上酒，还与故人倾。\n铁马红旗寒日暮，使君犹寄边城。\n只愁飞诏下青冥。\n不应霜塞晚，横槊看诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其二","author":"周紫芝","text":"雾帐兰衾暖，薰炉宝篆浓。\n眼波犹带睡朦胧。\n卧听晓来双燕、语春风。\n螺浅欢馀黛，霞销枕处红。\n断云飞雨怕匆匆。\n欲去且留情绪、两冲冲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其一 方钱唐出侍儿，范谢州要予作此词","author":"周紫芝","text":"蝉薄轻梳鬓，螺香浅画眉。\n西湖人道似西施。\n人似西施浓淡、更相宜。\n画烛催歌板，飞花上舞衣。\n殷勤犹劝玉东西。\n不道使君肠断、已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 其三","author":"周紫芝","text":"白羽传觞急，金鞍跃马迟。\n云间彩凤看双飞。\n飞上碧梧枝上、稳双栖。\n林下风流女，堂东坦腹儿。\n此郎标韵世间稀。\n好为伯鸾举案、又齐眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"品令 其一 重九前一日，飞卿携酒相过，坐中歌空青送客词，因用其韵。是日淮上贼军退舍","author":"周紫芝","text":"西风持酒。\n诮不做、愁时候。\n机云兄弟，坐中玉树，琼枝高秀。\n且莫劝人归去，坐来未久。\n甘泉书奏。\n报幽障、沈烽后。\n明朝重九，茱萸休恼，泪沾襟袖。\n怕衰黄花，也解笑人白首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"品令 其二 九日寓居招提，旅中不复出，步上西庵绝顶，撷黄菊一枝，凄然有感，复作此歌","author":"周紫芝","text":"霜蓬零乱。\n笑绿鬓、光阴晚。\n紫茱时节，小楼长醉，一川平远。\n休说龙山佳会，此情不浅。\n黄花香满。\n记白苎、吴歌软。\n如今却向，乱山丛里，一枝重看。\n对著西风搔首，为谁肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五禽言 其四 思归乐","author":"周紫芝","text":"山花冥冥山欲雨，杜鹃声酸客无语。\n客欲去山边，贼营夜鸣鼓。\n谁言杜鹃归去乐，归来处处无城郭。\n春日暖，春云薄。\n飞来日落还未落，春山相呼亦不恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭君怨","author":"周紫芝","text":"满院融融花气。\n红绣一帘垂地。\n往事忆年时。\n只春知。\n风又暖。\n花渐满。\n人似行云不见。\n无计奈离情。\n恶销凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌","author":"周紫芝","text":"江梅吹尽，更幽兰香度。\n可惜浓春为谁住。\n最嫌他、无数轻薄桃花，推不去，偏守定、东风一处。\n病来应怕酒，□眼常醒，老去羞春似无语。\n准拟强追随，管领风光，人生只、欢期难预。\n纵留得、梨花做寒食，怎吃他朝来，这般风雨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一 西池桃花落尽赋此","author":"周紫芝","text":"燕子风高，小桃枝上花无数。\n乱溪深处。\n满地飞红雨。\n唤得春来，又送春归去。\n浑无绪。\n刘郎前度。\n空记来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其二 内子生日","author":"周紫芝","text":"人道长生，算来世上何曾有。\n玉尊长倒。\n早是人间少。\n四十年来，历尽闲烦恼。\n如今老。\n大家开口。\n赢得花前笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎","author":"周紫芝","text":"白首归何晚。\n笑一椽、天教付与，楚江南岸。\n门外春山晚无数，只有匡庐似染。\n但想像、红妆不见。\n谁念香山当日事，漫青衫、泪湿人谁管。\n歌旧曲，空凄怨。\n将军未老身归汉。\n算功名、过了唯有，古词尘满。\n谁似渊明拚得老，饱看云山万点。\n况此老、斜川不远。\n终待我他年自，剪黄花、一酹重阳盏。\n君为我，休辞劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴桃源/如梦令 其二","author":"周紫芝","text":"林外野塘烟腻。\n衣上落梅香细。\n瘦马步凌兢，人在乱山丛里。\n憔悴。\n憔悴。\n回望小楼千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴桃源/如梦令 其三","author":"周紫芝","text":"绿尽小池芳草。\n门外柳垂春昼。\n花上雨廉纤，帘幕燕来时候。\n消瘦。\n消瘦。\n依约粉香襟袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴桃源/如梦令 其四 与孙祖恭求酴醾","author":"周紫芝","text":"旧日酴醾时候。\n酒涴粉香襟袖。\n老去惜春心，试问孙郎知否。\n花瘦。\n花瘦。\n剪取一枝重嗅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴桃源/如梦令 其一","author":"周紫芝","text":"帘幕疏疏风透。\n庭下月寒花瘦。\n宽尽沈郎衣，方寸不禁僝僽。\n难受。\n难受。\n灯暗月斜时候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"周紫芝","text":"无限春情不肯休。\n江梅未动使人愁。\n东昏觑得玉奴羞。\n对酒情怀疑是梦，忆花天气黯如秋。\n唤春云梦泽南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"周紫芝","text":"多病嫌秋怕上楼。\n苦无情绪懒抬头。\n雁来不寄小银钩。\n一点离情深似海，万重凄恨黯如秋。\n怎生禁得许多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四 和陈相之题烟波图","author":"周紫芝","text":"水上鸣榔不系船。\n醉来深闭短篷眠。\n潮生潮落自年年。\n一尺鲈鱼新活计，半蓑烟雨旧衣冠。\n庙堂空有画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其七","author":"周紫芝","text":"学画双蛾苦未成。\n鬓云新结翠鬟轻。\n伴人歌笑已多情。\n飞絮乱花闲院宇，舞鸾歌凤小娉婷。\n阳关休唱断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"周紫芝","text":"欲醉江梅兴未休。\n待篘春瓮洗春愁。\n不成欢绪却成羞。\n天意若教花似雪，客情宁恨鬓如秋。\n趁他何逊在扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 今岁冬温，近腊无雪，而梅殊未放。戏作浣溪沙三叠，以望发奇秀","author":"周紫芝","text":"近腊风光一半休。\n南枝未动北枝愁。\n嫦娥莫是见人羞。\n么凤不传蓬岛信，杜鹃空办鹤林秋。\n便须千杖打梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其六","author":"周紫芝","text":"醽醁新翻碧玉壶。\n水精钗袅绛纱符。\n吴姬亲手碎菖蒲。\n彩索系时新睡起，榴花剪处要人扶。\n心情还似去年无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"周紫芝","text":"落日在阑干。\n风满晴川。\n坐来高浪拥银山。\n白鹭欲栖飞不下，却入苍烟。\n千里水云寒。\n正绕烟鬟。\n拍浮须要酒杯宽。\n天与吾曹供一醉，不是人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其一 己未除夜","author":"周紫芝","text":"江上送年归。\n还似年时。\n屠苏休恨到君迟。\n觅得醉乡无事处，莫放愁知。\n红灺一灯垂。\n应笑人衰。\n鹤长凫短怨他谁。\n明日江楼春到也，且醉南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦楼月/忆秦娥","author":"周紫芝","text":"东风歇。\n香尘满院花如雪。\n花如雪。\n看看又是，黄昏时节。\n无言独自添香鸭。\n相思情绪无人说。\n无人说。\n照人只有，西楼斜月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"周紫芝","text":"春闲昼永。\n城下江深山倒影。\n净扫风埃。\n收拾烟光入句来。\n短窗闲倚。\n身似浮云门似水。\n谁伴馀年。\n结得青山一个缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二 汤词","author":"周紫芝","text":"门外青骢月下嘶。\n映阶笼烛画帘垂。\n一曲阳关声欲尽，不多时。\n凤饼未残云脚乳，水沈催注玉花瓷。\n忍看捧瓯春笋露，翠鬟低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其四 晁别驾生日","author":"周紫芝","text":"当年文伯。\n曾是东坡门下客。\n文采风流。\n奕叶传芳总未休。\n为公持酒。\n愿祝彩衣无限寿。\n归觐枫宸。\n剩醉长安几度春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二 内子生日","author":"周紫芝","text":"蓬莱三岛。\n上有青青千岁草。\n玉佩烟鬟。\n来作人间一笑欢。\n麻姑行酒。\n萼绿华歌清韵袅。\n玉秀兰芳。\n醉舞东风彩袖长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 雨中熟睡","author":"周紫芝","text":"快风消暑。\n门近雨边梅子树。\n昼梦腾腾。\n急雨声中唤不醒。\n轻衫短箑。\n林下日长聊散发。\n无计医贫。\n长作云山高卧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"周紫芝","text":"西山岩桂。\n常恨香闻烟雨外。\n何似君家。\n戏彩堂前早试花。\n黄金千粟。\n风撼芳条香馥馥。\n一剪无多。\n桃李漫山奈俗何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其六","author":"周紫芝","text":"东风庭户。\n红满桃花树。\n准拟踏青南陌路。\n双凤绣鞋新做。\n秋千月挂黄昏。\n画堂深掩朱门。\n立尽花阴归去，此时别是销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一","author":"周紫芝","text":"芦州晚净。\n雨罢江如镜。\n属玉双飞栖不定。\n数点晚来烟艇。\n梦回满眼凄凉。\n一成无奈思量。\n舟在绿杨堤下，蝉嘶欲尽斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]