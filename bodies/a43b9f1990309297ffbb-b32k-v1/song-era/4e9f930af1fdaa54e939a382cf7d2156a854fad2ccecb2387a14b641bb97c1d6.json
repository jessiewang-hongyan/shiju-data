[{"title":"真母吴氏挽词二首 其二","author":"刘克庄","text":"族昔多名婿，今观子更奇。\n他年槐树谶，早岁柏舟诗。\n割股延姑寿，抽簪活众饥。\n事皆堪入史，何必墓傍碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真母吴氏挽词二首 其一","author":"刘克庄","text":"系出自华宗，来嫔隐约中。\n贫能安苦节，贵愈积阴功。\n立志如欧母，生儿似富公。\n如闻新窆处，神告在溪东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真州北山","author":"刘克庄","text":"忆昔胡儿入控弦，官军迎战北山边。\n笳箫有主安新葬，蓑笠无人垦废田。\n兵散荒营吹戍笛，僧从败屋起茶烟。\n遥怜钟阜诸峰好，闲锁行宫九十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真珠花","author":"刘克庄","text":"匝地无人管，逢春作意开。\n得非回合浦，又似下瑶台。\n点点垂鲛泪，累累夺蚌胎。\n主君休爱惜，曾累伏波来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真隐寺","author":"刘克庄","text":"出郭斜阳已在山，夜深乘月到江干。\n奴敲小店牢扃户，僧借虚堂径挂单。\n骇浪急回因胆薄，逆风小住为心宽。\n投床一枕潇湘梦，无柰霜钟苦唤残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秘书弟牵玉羔为寿将以唐律次韵一首","author":"刘克庄","text":"玉羔直岁讵能神，羝触堪嗟命不辰。\n昔比素丝曾著节，今为白石且眠春。\n同人挟策安能牧，小弟磨刀恐未仁。\n六日披裘把竿钓，拟他五羖岂其伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答黄德远","author":"刘克庄","text":"闹处掉头挥手去，定中惟影与形俱。\n幼而好赋同侪少，老矣劬书独学孤。\n后殿君如傲霜菊，早衰吾似望秋蒲。\n痴人多恋黄粱梦，不信先生梦也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翀甫侄西上","author":"刘克庄","text":"同向溪边卜一丘，独怜出处不同谋。\n吾今老矣佚吾老，子好游乎与子游。\n漫对芝兰怀幼度，可教白马笑之罘。\n人生无过家山好，京洛风尘莫久留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其十","author":"刘克庄","text":"此篇不是臣当笔，清晓貂珰忽踵门。\n朕欲散文安用偶，卿多古意勿伤繁。\n院收同列残篇去，家有先朝圣笔存。\n臣亿何尝无气性，刍言安得及王言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其九","author":"刘克庄","text":"卫王自谓过伊周，奕叶珥貂何足酬。\n四世五公禁太盛，六卿三家僣有由。\n地寒曾为国远虑，天高未察臣志谋。\n京桧令终真幸矣，何须接踵贵吊攸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其八","author":"刘克庄","text":"尧言播告几丝纶，服汉衣冠易介鳞。\n羞战黑山为虏将，俾王青社备藩臣。\n招怀河北来降者，响附山东听诏人。\n可惜蹉跎隳晚节，圣恩尚许庙为神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其七","author":"刘克庄","text":"善和坊里早多病，翰墨场中竟策勋。\n径以文辞擢臣向，俄而科第与刘蕡。\n上方好问经疑义，予不能通史阙文。\n拈起祈招犹未识，安知五典与三坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其六","author":"刘克庄","text":"京华汩没易忘归，欲去还如鸟著?。\n但见朝臣均佚诏，未闻御制送行诗。\n执殳昔慕前驱伯，弃扇今如失宠姬。\n白首渔翁空感慨，当时饯客半皋夔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其五","author":"刘克庄","text":"忆昔叨陪册府仙，曾陈大计璪琉前。\n探符痴妄空劳矣，当璧休祥已灼然。\n奉玺相真曾浴日，倚楹女岂敢贪天。\n分明狐赵俱酿赏，不似之推隐去贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其四","author":"刘克庄","text":"端平忝缀鹓行末，曾抗纲常疏一通。\n诸老不能回横议，孤臣犹记寤清衷。\n鹤林莫掣傲象肘，乌府甘弯射羿弓。\n西涧相君知我者，箧中尚书记遗忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其三","author":"刘克庄","text":"甫入乌台宾客贺，举朝侧耳听抨弹。\n臣方抗奏婴龙颔，上已批依免豸冠。\n皦日方中宁有蔽，佞山一拔了无难。\n追攀老艾吾安敢，聊喜词臣不辱官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其二","author":"刘克庄","text":"拥万貔貅佩玉麟，内防天堑外边尘。\n昔尝以处范韩老，今奈何可许史亲。\n孤士但知怒螳臂，先皇不罪批龙鳞。\n此身只合山阴住，长作陵边洒扫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耄志十首 其一","author":"刘克庄","text":"富贵浮荣何足道，纲常大义讵容差。\n皆云养子将防老，岂若娇婴未识爷。\n上欲夺情俾归衮，臣宁断腕不操麻。\n向非十日留黄力，辇路几于误筑沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"获砚","author":"刘克庄","text":"二砚温如玉琢成，信知天地有精英。\n马肝紫润尤宜沐，鹆眼青圆宛似生。\n未爱潘郎呼作友，便教米老拜为兄。\n今年几案多奇获，应是穷儒命渐亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚊二首 其二","author":"刘克庄","text":"昔曾蹴龙象，而况尔区区。\n敢以一只口，当吾七尺躯。\n□生形猥琐，扑杀血模糊。\n欲换秋衣著，渠犹恋布襦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚊蝇五言一首","author":"刘克庄","text":"蚊集殊难散，蝇驱已复回。\n偏能侵枕簟，尤喜败樽罍。\n恰则噬脐去，何曾洗足来。\n化工生育尔，岂不甚仁哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚍蜉一首","author":"刘克庄","text":"梅月炎官尚敛威，纷纷此物傍綀衣。\n扑灯似怕光芒掩，撼树都忘力量微。\n因爱积阴憎景日，逆知将雨泄天机。\n未应蚁子浑无援，时至皆能插羽飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被旨趣行和计院兄韵 其一","author":"刘克庄","text":"耄耋即今同队少，宗盟于我数年加。\n陈根尚□□□□，新咏真堪续棣华。\n狂老监犹能嗜酒，□□□□□生花。\n何时手板抽还了，杖履追随莫去家。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被旨趣行和计院兄韵 其二","author":"刘克庄","text":"李邕眉宇误人看，敢□□□□□翰。\n此去□□□□□，向来上雍从和銮。\n□□□□如前梦，乌不相寻待岁寒。\n临□□□开酒禁，人间不似醉乡宽。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其九 陈珽判官","author":"刘克庄","text":"每抱怀中玉雪如，吴霜不觉点虬须。\n生三槐裔皆当贵，为六梅孙莫太臞。\n抹黛村眉惭丑怪，约黄宫额费妆涂。\n南园树老花零落，还许邹枚访旧无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其三 鲍","author":"刘克庄","text":"诗境千梅匝草堂，参军今又课梅忙。\n悬知句子追群谢，每见乡人说季方。\n处士骨寒谁得髓，老夫鼻塞尚闻香。\n请君摘出惊人语，玉篴横吹入乐章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其七 方至贡元","author":"刘克庄","text":"贫儿篱下看花窠，曾见千株玉雪么。\n画得诗禅三昧少，诗如无住一联多。\n过时结实心犹苦，从古调羹味在和。\n我坐耸肩穷到老，君肩欲耸又如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其六 三山林天麟","author":"刘克庄","text":"方扃北户逃生客，忽折南枝寄病翁。\n雪里骑驴非俗格，茶边放鹤有家风。\n写真影过于形好，凿窍香来与鼻通。\n不敢袖归防电取，殷勤返璧锦囊中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其八 方蒙仲制干","author":"刘克庄","text":"出香影外别商量，尽撷菁英发秘藏。\n难把微酸谐众口，只消一白赛宫妆。\n却疑彼相调金鼎，未召斯人试玉堂。\n便好去供春帖子，君才何止倍秦郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其五 王教景长","author":"刘克庄","text":"盘屈高才入短章，卷中字字挟冰霜。\n直探宝藏珠盈掬，倒泻金茎露浣肠。\n铁笛一枝横夜月，水沉三舍避天香。\n妙年早去吟薇药，莫共侬争寂寞乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其二 何谦","author":"刘克庄","text":"字字追还水部公，篇篇压倒后村翁。\n可怜和靖拘香影，更笑花光著色空。\n自许铁心坚晚节，渠能粉面向春风。\n菁华落尽惟枯蘖，赖有何郎嗜好同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其一 赵监簿志仁","author":"刘克庄","text":"诗至中山不可加，直将幽澹扫秾华。\n宁依处士坟前竹，不爱都人担上花。\n老子骚魂常住世，郎君吟笔又名家。\n遥知丈室无天女，纸帐香篝瘦影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸人颇有和余百梅诗者各赋一首 其四 方监镇楷","author":"刘克庄","text":"百首初成六十馀，朝涂暮改费居诸。\n谁将綵笔传于子，人怪青春小似余。\n一笑拈花差易耳，三年刻楮欲何如。\n梅兄樗叟俱枯槁，总把风光义让渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公和差须二诗不已又得二首 其二","author":"刘克庄","text":"乏萧生表褚公须，那更痴年已倍瑜。\n爱北征诗穷愈壮，鄙东封稿死犹谀。\n誉臣亦有毁臣者，知我宁无罪我乎。\n惜取宝珍常自照，底须揭日耀群愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公和差须二诗不已又得二首 其一","author":"刘克庄","text":"壮志蹉跎隐事差，瓣香稽首向南华。\n岁收别业无千绢，晨起斋厨止一麻。\n麦饭何妨荐寒食，榆钱元不济贫家。\n金瓶烂熳簪姚魏，谁问幽兰涧底花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其二","author":"刘克庄","text":"目眚陈编懒更窥，博通似恐泄天机。\n大愚苦要骑麟下，小黠犹能化鹤归。\n觅句瘦肩两山耸，绝粮乾咽上池肥。\n平生慕用徐先辈，异世溪边共一矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其六","author":"刘克庄","text":"时事浑如坐井窥，逢人不敢问边机。\n连营未寄寒衣去，故里何心昼锦归。\n笑矍铄翁鸢跕堕，爱玄真子鳜鱼肥。\n绿阴多处宜垂钓，莫管楸花落满矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其三","author":"刘克庄","text":"别无穴隙可钻窥，常恐冥行践骇机。\n恰则赐环烦内引，俄然只履已西归。\n都忘紫禁烟花绕，绝喜青山笋蕨肥。\n应被水村翁冷笑，争墩未了又争矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其四","author":"刘克庄","text":"觉海难将浅见窥，打包径去契禅机。\n何曾蝴蝶暂成梦，除却杜鹃谁劝归。\n江上风涛犹汹涌，盘中泉土颇甘肥。\n自当叱犊勤耕野，不必然犀往照矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其五","author":"刘克庄","text":"聃书深远绝难窥，止足书中向上机。\n但看杖扶博山入，不知扇赐曲江归。\n年饥方虑沟中瘠，旰食欲令天下肥。\n念此令人生内热，溪边赖有涤烦矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其九","author":"刘克庄","text":"陆海潘江莫测窥，手挥巧斲执神机。\n昔如鲁野麟初获，今似辽天鹤独归。\n外物何殊竿木戏，内丹不待药苗肥。\n只愁户外蒲轮至，去坐狨鞯勿坐矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其七","author":"刘克庄","text":"户外荒园久不窥，桔槔已息汉阴机。\n与鸡窠老略相似，微鹿门翁谁与归。\n训俭家才支伏腊，力农田不问硗肥。\n由来位重多忧责，未必沙堤胜石矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其十","author":"刘克庄","text":"高屋从来有鬼窥，铁门关枉费心机。\n逃尧欲去未忍去，舍鲁不归何处归。\n款段马知如狗大，堂厨羊不似蚝肥。\n赐金未可都挥散，要买荒山鹤断矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其八","author":"刘克庄","text":"指法金针不许窥，笑他贫女织寒机。\n谪仙曲奏调羹赐，之问诗成夺锦归。\n论定会盼银信召，眷浓漫妒玉环肥。\n溪边鸥鹭偷相语，只怕先生又下矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公载酒贺余休致水村农卿有诗次韵 其一","author":"刘克庄","text":"圣世鸟巢可俯窥，乞身岂必避危机。\n牛车径驾史儋出，麟笔曾嘉季友归。\n迂叟相邀入真率，乖崖安肯慕轻肥。\n山林深密云天远，存阙心宁不可矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读大行皇帝遗诏感恩哀恸六首 其六","author":"刘克庄","text":"士有一长斯可矣，文兼众妙古难之。\n元丰御览诸生赋，淳化屏题侍读诗。\n序建隆须还巩笔，记储祥必待苏碑。\n臣于四美安能备，虚受先皇不世知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读大行皇帝遗诏感恩哀恸六首 其五","author":"刘克庄","text":"批凤提鳌间世遭，老臣全未报丝毫。\n封还不觉天颜近，劝诵偏知帝学高。\n户外昭容犹紫袖，柩前诸后更黄袍。\n暮年泪滴藏山稿，畴昔曾经圣笔褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读大行皇帝遗诏感恩哀恸六首 其四","author":"刘克庄","text":"禁中宣召佯狂李，度外蒐罗不第蕡。\n先帝英明亲擢汝，孤臣老死敢忘君。\n坏麻讵忍加城罪，庭著居常读轼文。\n纵使天光留只眼，此生无复望尧云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读大行皇帝遗诏感恩哀恸六首 其三","author":"刘克庄","text":"圣度如天未易量，每怜孤直赦疏狂。\n中伤竞发千钧弩，拂拭重登七宝床。\n昔忝未归同二老，今无殉死愧三良。\n鼎湖望断灵斿远，血泪才乾又数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读大行皇帝遗诏感恩哀恸六首 其二","author":"刘克庄","text":"或犯威颜批逆鳞，容如天地养如春。\n早年憔悴行吟者，岁晚赓歌喜起人。\n风雨无终飘暴意，雪霜有大发生仁。\n才衰莫颂文之德，虚忝词臣与史臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读大行皇帝遗诏感恩哀恸六首 其一","author":"刘克庄","text":"昨者欃枪久未收，宫中斋素却珍羞。\n宵衣密遣庚牌递，露布差宽丙枕忧。\n大渐忽然开玉锁，积勤端为保金瓯。\n尧民莫不如丧考，况侍尧阶近璪旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读友人奏藁","author":"刘克庄","text":"首规旒冕次钧衡，纸价遥知贵洛城。\n谷永有知应愧死，曹蜍无气谩偷生。\n弘宽敛衽惭三策，桑濮收声让九成。\n闻说龙天俱赞叹，法筵第一义分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读太白诗一首和竹溪","author":"刘克庄","text":"翰林万里出峨嵋，曾受开元帝异知。\n只道高爷能毁鬲，无端环子亦嗔痴。\n空传飞燕当时句，难觅骑鲸以后诗。\n的是长庚星现世，秕糠伯友与王师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史","author":"刘克庄","text":"绝漠犁庭功可喜，与天争鼎志堪悲。\n吠江帝剖为羓去，避地民劳若蚁移。\n河决固非束薪塞，厦倾欲以一绳维。\n英雄到了多遗恨，孺子林宗百世师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读竹溪诗一首","author":"刘克庄","text":"不敢匆匆看，晴窗几绝编。\n参它少陵髓，饶得弈秋先。\n友愿低头拜，师曾枕膝传。\n已将牌印子，牒过竹溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读邸报二首 其二","author":"刘克庄","text":"瑶编对秉初修笔，粉署同携夜直衾。\n虎既蒙皮甘搏噬，鹤因疮羽久呻吟。\n尽归一网机犹浅，横说三纲害最深。\n想到鄮山多暇日，轲书毋惜细研寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读邸报二首 其一","author":"刘克庄","text":"并驱华毂适通逵，中路安知判两岐。\n邪等惟余尤甚者，好官非汝孰为之。\n累臣放逐无还理，陛下英明有寤时。\n闻向萧山呼渡急，想追前事亦颦眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读陈汤传","author":"刘克庄","text":"短后衣装腰宝刀，空言无实世滔滔。\n掉齐虏舌何其易，斩郅支头岂不豪。\n异代武夫犹夺气，当时文吏苦吹毛。\n汉廷谁是持衡者，只罪邀功不赏劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读金銮密记","author":"刘克庄","text":"仗下千官走似麇，仓皇谁扈属车尘。\n禁中陆九艰危共，殿上朱三苦死嗔。\n当日横身抗岐汴，暮年避地客瓯闽。\n小窗细读金銮记，始信香奁属别人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读崇宁后长编二首 其二","author":"刘克庄","text":"陈迹分明断简中，才看卷首可占终。\n兵来尚恐妨恭谢，事去徒知悔夹攻。\n丞相自言芝产第，太师频奏鹤翔空。\n如何直到宣和季，始忆元城与了翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读崇宁后长编二首 其一","author":"刘克庄","text":"自入崇宁政已荒，由来治忽系毫芒。\n初为御笔行中旨，渐取兵权付左珰。\n玉带解来攽贵倖，珠袍脱下赐降羌。\n诸公日侍钧天宴，不道流人死瘴乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资殿清惠陈公哀诗三首 其三","author":"刘克庄","text":"端平元祀王正月，我与公同被特招。\n甲午英游小元祐，庚申景运再陈桥。\n可怜转枕成春梦，犹忆联鞍趁早朝。\n若见西山询学子，为言衰鬓雪萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]