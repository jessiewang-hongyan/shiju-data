2fe5294295f79689","path":"宋_3.csv","pointer":62262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"释德洪","text":"屋破不至露寝，食乏不至餐毡。\n此身投老未死，万事一切随缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登洪崖桥与通端三首 其一","author":"释德洪","text":"行尽几重添秀，雷奔响落晴空。\n散坐煮茶为别，云间一径微通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登洪崖桥与通端三首 其二","author":"释德洪","text":"鸡声乱人语秀，山色涴我衣裳。\n洗尽人间热恼，还君坐上清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登洪崖桥与通端三首 其三","author":"释德洪","text":"同到洪崖桥上，水光射著山寒。\n为君更吐妙语，乞与西山老端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人二首 其一","author":"释德洪","text":"玉骨解藏岁月，饥肤不受尘埃。\n落笔惊鸿掠纸，延僧春露浮杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人二首 其二","author":"释德洪","text":"寂寥空山独夜，萧条古木清秋。\n风月谁家捣练，江头何处钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其一","author":"释德洪","text":"闲房古寺陈尊宿，对石谈经生法师。\n万壑松风一轩月，冷斋清夜想丰姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其二","author":"释德洪","text":"石门冢木团云雨，偶爱车轮烟翠深。\n火种刀耕期饱暖，问心求法谩追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其三","author":"释德洪","text":"夜冢髑髅元是水，客杯弓影竟非蛇。\n个中无地容生灭，笑把遗编篆缕斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其四","author":"释德洪","text":"粪火但知黄独美，银钩那识紫泥新。\n尚无心绪收寒涕，岂有工夫问俗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其五","author":"释德洪","text":"瘦行清坐老垂垂，栗色伽梨取次披。\n岩壑形骸虽可画，烟霞痼疾不须医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其六","author":"释德洪","text":"闲中不省岁月改，但见四山青又黄。\n指客却随流水去，笑渠世路未全忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其七","author":"释德洪","text":"车轮峰作碧螺旋，不用招邀自满轩。\n等是世间无用物，故宜相对两忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读古德传八首 其八","author":"释德洪","text":"绝知名迹能妨道，正恐师承亦累人。\n问法沙弥莫饶舌，百年逆旅要同尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读法华五首 其一","author":"释德洪","text":"在宅觅车犹是欲，出门露坐始无依。\n载行一兽无名字，但爱雪山香草肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读法华五首 其二","author":"释德洪","text":"火宅纵横皆暗弊，化城触处是光明。\n子争狂走欲方炽，宝所依然念不生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读法华五首 其三","author":"释德洪","text":"塔解听经无两耳，佛称全体有分身。\n宝书读罢惊清昼，叶叶花花总是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读法华五首 其四","author":"释德洪","text":"慈和自是山林服，知见长凝宴寝香。\n要与如来同止宿，却须常拂法空床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读法华五首 其五","author":"释德洪","text":"阿字义深当自读，般舟行苦与谁行。\n人言成辨须三世，我欲圆成在此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠诵法华僧","author":"释德洪","text":"生存异梦传书镇，骨冷青莲出瓦棺。\n试看法华精进力，两翁先已为开端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"合妙斋二首 其一","author":"释德洪","text":"雨过东南月清亮，意行深入碧萝层。\n露眠不管牛羊践，我是钟山无事僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"合妙斋二首 其二","author":"释德洪","text":"未饶拄杖挑山衲，差胜袈裟裹草鞋。\n吹面谷风冲虎过，归来松雨撼空斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读大智度论","author":"释德洪","text":"眼不自见宁见物，去来不见宁见今。\n万物只今全体露，镜里有空无路寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"注十明论","author":"释德洪","text":"了知无性灭无明，空慧须从戒定生。\n频呼小玉元无意，只要檀郎认得声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汾阳十智同真二首 其一","author":"释德洪","text":"十智同真面目全，于中一智是根源。\n如今要见汾阳老，劈破三玄作两边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汾阳十智同真二首 其二","author":"释德洪","text":"十智同真选佛科，汾阳佛法本无多。\n爱心竭处寻真智，面目分明会也么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁州闻东坡殁于毗陵书精进寺壁三首 其一","author":"释德洪","text":"浊世肯留竟何意，玉芙蓉出淤泥中。\n谁谓秋来亦零落，病收衰泪泣西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁州闻东坡殁于毗陵书精进寺壁三首 其二","author":"释德洪","text":"姓名自可磨千古，文字收藏付六丁。\n唾雾珠消君勿笑，梦回比物镇长灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁州闻东坡殁于毗陵书精进寺壁三首 其三","author":"释德洪","text":"才疏意广孔文举，身健长贫白乐天。\n一代风流今已矣，三吴云水固悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽居士以峡州天宁见邀作此辞免六首 其一","author":"释德洪","text":"吹毛用了急须磨，铁脊师兄舌太多。\n祖佛命根俱截断，笑中惊倒老维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽居士以峡州天宁见邀作此辞免六首 其二","author":"释德洪","text":"维摩愿力元无尽，重见真州宰辅身。\n舌本雷槌烹佛祖，笔端和气活生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽居士以峡州天宁见邀作此辞免六首 其三","author":"释德洪","text":"四夷八蛮想风采，灶妇乳儿知姓名。\n寄语袖中调鼎手，未容扶杖独经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽居士以峡州天宁见邀作此辞免六首 其四","author":"释德洪","text":"五达衢头梵刹新，著书来唤住山人。\n折松惯扫和云石，披衲难随没马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽居士以峡州天宁见邀作此辞免六首 其五","author":"释德洪","text":"亦欲便随流水出，重惟我法付王臣。\n回看坐睡横眠处，折脚铛儿解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽居士以峡州天宁见邀作此辞免六首 其六","author":"释德洪","text":"龟毛索子衲僧冤，阔角关西亦被穿。\n小犊鼻头无觅处，听渠露地且闲眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到善溪慧照庵寄张无尽五首 其一","author":"释德洪","text":"明月洲头一笛风，暮云灭尽水吞空。\n倚筇笑语无人问，疑是西湖落梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到善溪慧照庵寄张无尽五首 其二","author":"释德洪","text":"山勒回流作窟盘，翠萝绾带结鸳鸾。\n故应此境幽难画，乞与庵僧自在看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到善溪慧照庵寄张无尽五首 其三","author":"释德洪","text":"形胜迥分千里远，地灵还受众峰朝。\n从来庆泽流无尽，异事先看继八萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到善溪慧照庵寄张无尽五首 其四","author":"释德洪","text":"世辩不妨无骨舌，好山难绊自由身。\n从教折脚铛儿笑，且欲南来识凤麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到善溪慧照庵寄张无尽五首 其五","author":"释德洪","text":"公有自然台辅望，与民同乐亦同忧。\n我惭雅思非支遁，亦伴东山烂熳游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽见和复次其韵五首 其一","author":"释德洪","text":"谩说毗耶问疾风，主宾信手画虚空。\n争如快活月洲老，万事收藏一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽见和复次其韵五首 其二","author":"释德洪","text":"窗外云閒如去鹤，门前山好似翔鸾。\n此时更有疑情在，试借疑情面目看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽见和复次其韵五首 其三","author":"释德洪","text":"一丘一壑思迢迢，莫把山林较市朝。\n江上相逢两无语，夕阳衰草暮萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽见和复次其韵五首 其四","author":"释德洪","text":"公是睡龙今缩首，我如江月且分身。\n人间一戏成何事，冢外君看半卧麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无尽见和复次其韵五首 其五","author":"释德洪","text":"虽然无證复无修，扑破虚空亦可忧。\n欲识老庞端的处，饭馀摩腹且閒游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答之十首 其一","author":"释德洪","text":"金篦抉膜去重重，露出当时晦昧空。\n拨转上头关棙子，莫教更堕有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答之十首 其二","author":"释德洪","text":"晚来妙语逼人寒，逸气翩翩栖凤鸾。\n珍重平生造物手，十分拈出与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答之十首 其三","author":"释德洪","text":"拥衾睡美无人唤，闲忆当年趁早朝。\n今伴赤松聊卒岁，后来功业付曹萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答之十首 其四","author":"释德洪","text":"众生烦恼乱如尘，共现如来智智身。\n自笑露腮狂宝志，识公天上石麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答之十首 其五","author":"释德洪","text":"楼阁不劳弹指入，众魔相顾匆惊忧。\n回光却复思初友，从此南询可罢游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答之十首 其六","author":"释德洪","text":"此法从来妙莫穷，何须痴坐学观空。\n劈开结角罗纹处，摄入圆伊三点中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答之十首 其七","author":"释德洪","text":"法本无差须拣择，楚鸡元不是青鸾。\n当机一镞三关破，觌体分明箭后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]