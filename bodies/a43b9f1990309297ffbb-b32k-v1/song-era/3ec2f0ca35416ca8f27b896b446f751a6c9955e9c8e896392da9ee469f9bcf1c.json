[{"title":"寄云峰饶安国","author":"刘黻","text":"千年古松树，树下两翁吟。\n语不到时事，笑皆非壮心。\n江添明月净，山共白云深。\n寂寞砖趺在，何时重许寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄冯贺州","author":"刘黻","text":"鸣凤起朝阳，斯文气脉昌。\n谏书留北阙，诗笔化南荒。\n湖柳生新意，冈梅续旧芳。\n相期功行远，何但说龚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄朱德卿","author":"刘黻","text":"世事何拘束，清吟祗羡君。\n半窗听夜雨，一雁叫秋云。\n壁润琴音涩，山寒酒力分。\n何时野堂上，重与看骚文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄徐径畈吏部","author":"刘黻","text":"舍则安贫用则行，休嗟时事几番更。\n鸾皇只向明时出，鬼魅偏为暗处生。\n改秩屡勤天子诏，养亲甘共野人耕。\n要知出处惟参易，莫学鸱夷变姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郭仙尉","author":"刘黻","text":"三千里外人，梅下忽逢君。\n共对鸦山月，如依雁荡云。\n命奇明主弃，心白老天闻。\n贳酒非耽饮，烦渠禦瘴氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄菊庐舅氏","author":"刘黻","text":"文章时不偶，鬓影想苍苍。\n抱剑客千里，忆家书数行。\n草莱荒菊圃，风雨冷诗堂。\n若问求安策，东归策最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄解性存","author":"刘黻","text":"相望才咫尺，会面若登天。\n破屋人多厌，空山月独怜。\n未贫犹有易，屡旱却无田。\n时到青松下，西风伴鹤眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄魏佥判","author":"刘黻","text":"君住龟山我雁山，天教识面帝圻间。\n书楼自喜看山色，诗卷相寻待月删。\n镜不可欺知貌改，寝惟无梦觉心閒。\n西湖大有真泉石，何日携琴更出关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得弟书","author":"刘黻","text":"我自甘流落，翻令汝不眠。\n世嗤伯氏拙，家赖阿奴贤。\n地恶烟为瘴，书迟日作年。\n何时风雨夕，炙火勘新编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"刘黻","text":"之子孤高势莫攀，分甘肥遁此林间。\n独先草木有生意，几历风霜无老颜。\n气质泠泠全太古，声名籍籍重孤山。\n时人却拟调羹手，到底调羹不似閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上","author":"刘黻","text":"翠华南渡后，此地独防秋。\n明月家家泪，西风处处愁。\n鼓鼙寒出塞，烽火夜分楼。\n征战何时息，长河万古流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章江信笔","author":"刘黻","text":"自从谪向章江上，两饭惟听宝界钟。\n尚忆贾生陈痛哭，肯为胡广说中庸。\n春风举世知骑鹤，夜雨何人识卧龙。\n吾道未嫌拘絷苦，一编炯炯照人胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山楼","author":"刘黻","text":"风生汐恶舟难去，独上危楼立暮云。\n数片斜阳随处没，一声清磬隔江闻。\n庙灵古木悬新纸，碑老苍苔补断文。\n惭愧年丰官酒贱，往来人每乐醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜刘主簿归","author":"刘黻","text":"同是青藜一祖来，晚成天欲老其才。\n家传虎榜新承渥，人说牺经旧屡魁。\n春色风流都羡柳，岁寒事业莫过梅。\n谁怜历落如蕡者，閒把离骚咽一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游太玉峰","author":"刘黻","text":"一秋吟不尽，才拙愧黄花。\n极目皆成市，论心有几家。\n淡交期白发，清话證丹砂。\n却忆分携处，寒林集暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游长渠石洞","author":"刘黻","text":"六月访古壑，衣巾全似秋。\n多无百年寿，能得几番游。\n泛酒月流硖，听笙云满楼。\n相忘有樵者，来往共夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登舟西郭别城友","author":"刘黻","text":"久静还思动，离觞江上斟。\n文章关世道，科目坏人心。\n门掩溪云早，舟横野水深。\n清猿不解事，应向故山寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月六日见雪","author":"刘黻","text":"一冬长是暖，见雪独精神。\n田野眠方稳，湖山认不真。\n众禽忧失树，孤客喜忘贫。\n只此严凝气，中含造化仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊雪","author":"刘黻","text":"八窗唯一色，稚子诧天花。\n不稔已多岁，无寒能几家。\n山川增古老，宇宙顿奢华。\n冻坐无他事，呼松自煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢胡编校惠药医膝病遂以药名赋","author":"刘黻","text":"益智莫如愚，谁甘遂作非。\n年增思续断，亲老忆当归。\n起石安吟久，防风见客稀。\n前胡古君子，松节自相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋求仁斋和赵使君","author":"刘黻","text":"一编论语半言仁，克复工夫理趣真。\n敛在黄堂三寸地，散为横浦十分春。\n元阳有宰群霾伏，太极无边万象陈。\n生意源源如谷种，即为天地本来身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋顽石坐寄中上人","author":"刘黻","text":"一日复一日，坐来空世尘。\n清潭常见月，老木不知春。\n室静佛为證，山深石作邻。\n莫询门外路，风雨暗荆榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋望云寮","author":"刘黻","text":"家山一望三千里，华发双亲七十稀。\n自许朴忠宽社稷，谁知甘旨误庭闱。\n菜根有味逢春雨，草色无边傍日晖。\n总总白云何处是，夜寒结梦但东归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋渔村晚照","author":"刘黻","text":"自许同渔者，筑庐云水乡。\n利名俱是幻，鸥鹭亦相忘。\n古塔明秋树，归舟动夕阳。\n临流不尽意，何必问潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋鹿岩贾司理所筑怀京台","author":"刘黻","text":"铜驼无万里，长忆再游难。\n岁月英雄老，山河草木寒。\n梦随归雁远，愁赖酒杯宽。\n寂寞先朝事，斜阳莫倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道源","author":"刘黻","text":"父师兄弟一堂深，貌像如生世所钦。\n直向端倪明万古，不专佔毕诏来今。\n地灵香火溪山护，岭近衣冠岚雾侵。\n千派万流同一水，来从濂洛洗人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩文公","author":"刘黻","text":"斯文久矣叹荆榛，一疏披忠彻紫宸。\n不忍中原沦左衽，甘寻南土作累臣。\n邹轲以后功何逊，鲁道于今脉尚新。\n宇宙欲昏星斗落，空山韩木亦悲春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谪居","author":"刘黻","text":"无垢双趺十四年，予今恰已一年全。\n开窗剩向春风坐，闭户閒听暮雨眠。\n白发相寻非偶尔，青山可对只依然。\n蘧庐世事皆如此，且诵先生庭草篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春寄友","author":"刘黻","text":"春归无路寻，烟水一村深。\n中酒易成癖，惜花空用心。\n嫩刍青引犊，新树绿藏禽。\n每念离乡友，经年不寄吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其二 二忠堂","author":"刘黻","text":"斯道今犹古，相望百载间。\n孤忠如白日，遗像对青山。\n寂寞吾儒事，崎岖世路艰。\n圣朝仁脉在，先后惨生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其七 六祖","author":"刘黻","text":"碓头功行满，非意祖师名。\n世事春风过，禅心夜月明。\n清泉灵石窦，老钵镇山城。\n冷看梅花笑，纷纷事送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其八 东坡祠","author":"刘黻","text":"何年海上还，坐镇此山川。\n笔砚归京阙，衣冠带瘴烟。\n一生忠胆在，万古党名传。\n吾道多流落，西风问老天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其一 周程三先生书院","author":"刘黻","text":"千载斯文冷，先生以道鸣。\n山川师友趣，日月弟兄情。\n门静一松在，源深双浦横。\n儿童游里巷，犹喜说周程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其九 宝界寺","author":"刘黻","text":"城中惟一寺，僧老雪盈头。\n曾识神仙到，仍多谏议游。\n钟闻香火夕，碑隐桂杉秋。\n可惜高堂上，双趺石不留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其五 贤女祠","author":"刘黻","text":"山崦人家聚，路旁贤女祠。\n不移初嫁志，宁殒及笄时。\n古木有生意，清潭即旧知。\n吾宗女犹尔，况复号男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其六 梅岭","author":"刘黻","text":"曲江曾凿险，梅岭到今誇。\n何代移来树，几人羞此花。\n诛茅新佛屋，盖竹半樵家。\n冷煖分南北，谁兴世道嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其四 湛泉","author":"刘黻","text":"境僻远尘迹，湛然风雨林。\n一泉通地脉，千古照人心。\n灌菊增花蘤，煎茶得味深。\n石渠才此尔，谁向道山寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其十 解太尉墓","author":"刘黻","text":"桧肉不可食，但增忠义悲。\n焚香临决日，扼腕议和时。\n偃月人何在，凌烟草亦知。\n曾闻无垢语，刊入墓头碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦十咏 其三 横浦","author":"刘黻","text":"地与崆峒接，中多隐者韬。\n山腰僧寺小，水口古榕高。\n粗石草木瘦，细民衣食劳。\n予来无一事，吟荇补离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横浦有感","author":"刘黻","text":"风雨忧时梦不成，忍将佞舌博功名。\n学如谷永生何辱，节若刘陶死亦荣。\n苍藓无心同客静，寒梅有眼照人明。\n此邦风物多淳古，曾识濂溪与二程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题江湖伟观","author":"刘黻","text":"柳残荷老客凄凉，独对西风立上方。\n万井人烟环魏阙，千年王气到钱塘。\n湖澄古塔明寒屿，江远归舟动夕阳。\n北望中原在何所，半生赢得鬓毛霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吟所","author":"刘黻","text":"为吟新搆屋，喧寂一溪分。\n洗竹夜留月，开门朝放云。\n佛藏孤塔见，虎啸别山闻。\n予喜频来此，幽情尔共云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题花岩","author":"刘黻","text":"厌听朝鸡唱，归来觅柳栽。\n半山张锦绣，一水隔尘埃。\n寻壑疑无路，看潮别有台。\n仙人不可见，孤鹤夜深回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飘零","author":"刘黻","text":"飘零吾道在，安处即为家。\n夜雨生蒲叶，秋风到蓼花。\n貌添平日瘦，学悟少年差。\n白足閒相问，蕉溪一供茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠江山人","author":"刘黻","text":"相山如相人，不论肥与瘠。\n神气参有无，毫釐千里隔。\n今古非茫茫，山骨水为液。\n谁欤璞辂翁，眼为天地碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太玉洞听琴","author":"刘黻","text":"无弦不成声，有弦多失真。\n真声在何所，和陶方寸春。\n文操惜已远，孔坛嗟复陈。\n所以桑濮响，郑卫波嬴秦。\n讵知幽谷间，乃闻太古淳。\n游鱼出春水，鸣鹤横霜晨。\n休羡广陵秘，是雅皆怡神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和题临赋 其一","author":"刘黻","text":"近南逢剧暑，多病客难禁。\n与物甘同静，何人肯见寻。\n望云生远梦，看月得禅心。\n咫尺西关路，输君杖履临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一舸","author":"刘黻","text":"一舸泛漭沆，风涛正掀舞。\n驾空赫鱼龙，沈浮未知所。\n同舟一性命，俱父父母母。\n倚门望儿归，天亦谅辛苦。\n胡为托笑言，射影学溪弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三十一岁吟","author":"刘黻","text":"三十一年鸿荡癯，只影流落长江湄。\n耐寒忍苦还力饥，寤寐千古圣贤书。\n有时理到意独会，有时欲动心如痴。\n有时目睫交宇宙，有时咫尺生藩篱。\n有时开口邈豪杰，有时瞑目惭婴儿。\n坚凝力量在深省，但守潇潇风雨鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与李叔夔钱子云同游兴教寺约齐都巡","author":"刘黻","text":"古寺坏壁存菩提，又有达磨苍龙如。\n我来问讯若旧知，宇宙中间真蘧庐。\n朋侪邂逅谁亲疏，秋风相对一笑醵。\n杯行草草复徐徐，山僧野朴谈古初。\n谓元城老当此居，浩叹不足歌继之。\n满庭灿灿木芙蕖，疑是莱柏邓栟榈。\n人多病俗不可医，天欲废道还从渠。\n儒生腹大能几围，但教盛酒勿盛书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兀兀栖精庐","author":"刘黻","text":"兀兀栖精庐，青山日相对。\n静照年少非，动虞壮士悔。\n耕锄计已晚，畚筑力犹耐。\n夜卧司马衾，晨餐鲁直菜。\n自计清庙修，谁知圜壁坏。\n人情春水波，世事寒云态。\n直道丛百谪，孤踪绕群吠。\n拘累僒形骸，忧危积肝肺。\n逢人口即瘖，出户足如碍。\n周程俨范模，刘张遗謦欬。\n涤垢学归愚，达增务韬晦。\n志苦秋不磨，发白春匪载。\n采菊聊倾觞，延兰可纫佩。\n官馈乏三月，家书隔千载。\n楚语欲听惯，峒关惊未溃。\n冥冥瘴雾间，冂冂灵光在。\n莫挥感时泪，山水怡吾爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中兴更化诗","author":"刘黻","text":"东南天一隅，谁起铜驼思。\n雁荡山之臞，匕饭悲黍离。\n矫首中兴期，儒风昌四维。\n阴霾苦凝冱，光景几逶迟。\n鸱鸮腾恶音，蛇虺纷剥脂。\n忠愤发夜气，历历排奸辞。\n黎明叫阊阖，骨鲠苍旻知。\n阳嘘一脉春，万宇同掀眉。\n睿智觉今是，庙断消前非。\n畴昔两揆贤，烛照朋邪欺。\n化弦易新调，活著扶危机。\n孽蜮遁妖迹，鸣凤览德辉。\n聋聩一苏醒，皇运兴炎基。\n耿耿忠孝图，炳炳恢复规。\n有志竟成事，失机将奚为。\n布帛可禦寒，谷粟能疗饥。\n盘错见利器，疾病知良医。\n今日坠悠邈，千古羞涂碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六友诗寄林景云留寿国林道初俞季渊 其五 节友","author":"刘黻","text":"节友独爱秋，相得匪迟暮。\n受气惟至正，睟见黄与素。\n饱谙风露味，甘守烟霞痼。\n如何千载人，仅一渊明遇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六友诗寄林景云留寿国林道初俞季渊 其三 净友","author":"刘黻","text":"净友何亭亭，修洁得自性。\n本生淤泥中，乃与玉同瑩。\n一净消万暑，特立起群敬。\n色香非色香，是谓花之圣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六友诗寄林景云留寿国林道初俞季渊 其二 直友","author":"刘黻","text":"直友古耐交，莫问三两个。\n玉立君子姿，足以警吾惰。\n虚心内有容，劲节老无挫。\n荒远亲旧违，得汝乃自贺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六友诗寄林景云留寿国林道初俞季渊 其四 高友","author":"刘黻","text":"高友住山中，无心涉尘圃。\n山中有明月，明月照栖鹭。\n幽人眠不成，披衣起閒步。\n相得静无际，勿讶秦官污。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六友诗寄林景云留寿国林道初俞季渊 其六 清友","author":"刘黻","text":"清友天赋完，岁晚树独暖。\n粲此白玉英，瑟彼清庙瓒。\n香自根中来，冰雪匪压断。\n一见一回老，殷勤呼茗椀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六友诗寄林景云留寿国林道初俞季渊 其一 静友","author":"刘黻","text":"静友性不凡，惟嗜土石瘦。\n与草似无瘉，于吾如有旧。\n抱独足养真，韬芳何深茂。\n清风苦好事，揄扬古今宙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六无吟","author":"刘黻","text":"食无肉兮出无友，居无室兮病无医。\n冬无炭兮夏无泉，祠有坡翁慰我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月","author":"刘黻","text":"天公属月为眼睛，晓夜不息天中行。\n痴人习见圆复缺，谓此眼睛非长明。\n渠思一照千古白，奚分朔望阴与晴。\n彼昏病痴苦营营，以月视之蝇在罂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风水","author":"刘黻","text":"不雨五十日，一雨生意回。\n讵料雨复痴，日日闻震雷。\n中元节倏届，巨飙恣喧豗。\n故挽水倒流，能撼山欲摧。\n掀茅与扬沙，境境人号哀。\n馀禾垫西圳，大木横荒垓。\n芝田逮楠溪，廛井归丘莱。\n飘骸填港汇，悲魄栖山隈。\n吁嗟今之人，瘥札相辘轠。\n吁天岂耄昏，静□□□□。\n积乖必致盭，养烬终成炱。\n造化一感应，予夺何心哉。\n未闻豳诗官，租税星火催。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙辰吟","author":"刘黻","text":"熙宁岁丙辰，海内厄安石。\n庆元岁丙辰，伪学禁如织。\n宝祐复丙辰，衣冠堕荆棘。\n龙蛇数云恶，郑玄炳先识。\n诸生不齰舌，投荒诚予职。\n鸺鹠号屋头，鼯鼠搅床侧。\n云集肤已粟，日出汗欲赤。\n瘴疠半南州，可轩靠神力。\n所寓乃略同，苍苔共岑寂。\n丙辰自丙辰，焚香且读易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东坡竹石","author":"刘黻","text":"坡翁北归留戏笔，数竹离奇生磈石。\n世如有凤必先知，碌碌凡禽谁得识。\n风不声兮月不影，山僧笑我移枯瘠。\n岭阯每苦烟瘴深，烟瘴何曾祸忠直。\n天使无垢来此邦，要与坡翁发真迹。\n大书特书等傲岸，方寸一虚隘八极。\n何年移植蓬莱宫，清风逼人寒半壁。\n枝可磨，叶可摘，石上根，祗如昔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东皋","author":"刘黻","text":"天然岩壑怪，官况此中閒。\n台阁人烟上，阑干树影间。\n引泉归月沼，分菊上秋山。\n咫尺神仙洞，听笙忘却还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]