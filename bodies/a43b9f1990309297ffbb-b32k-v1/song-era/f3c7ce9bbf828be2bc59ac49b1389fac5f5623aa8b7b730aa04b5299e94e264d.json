[{"title":"次前韵答原伯二首 其二","author":"周孚","text":"涪翁所传法，皎与日星俱。\n举世沦燕说，看公走郑巫。\n至音常想像，戆腹谩模苏。\n安得空桑曲，相从奏坐隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄宛陵陈丈","author":"周孚","text":"莫云低处是江东，病眼凄迷夕照红。\n千里相望空咄咄，一书欲寄竟匆匆。\n已休心迹嚣尘外，更付功名笔研中。\n遥想家居老彭泽，晚年身世只僧同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵印老别峰壁间枯木二首 其一","author":"周孚","text":"与世争春念已忘，道人还许寄斋房。\n草间翁仲真知己，试问曾经几度霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵印老别峰壁间枯木二首 其二","author":"周孚","text":"耒阳祠宇渺天涯，幻事何须置齿牙。\n肯伴石翁林下客，优昙当有寄生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵前篇属印禅师后篇属选上人二首 其一","author":"周孚","text":"老禅真与世相忘，十载惊涛溅石房。\n指似贞心人不解，断槎素壁白如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵前篇属印禅师后篇属选上人二首 其二","author":"周孚","text":"阿师曾入丹渊室，买马今年得锯牙。\n树倒藤枯渠解写，老夫真欲笑桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵从之喜雨","author":"周孚","text":"倏看半岭莫云张，无复烧空更夕阳。\n螟?初逢辟邪玉，畦塍真有反生香。\n遥知涸泽还应涨，便觉炎风也自凉。\n回互凶丰一翻手，君看造物信难量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄侍郎仲秉赴泸南","author":"周孚","text":"召杜久不作，公来甫期年。\n吾民亦何负，今公返三川。\n王命不可稽，无由挽公船。\n累累婴儿啼，政复来道边。\n惊鸿未安集，叹息渠可怜。\n公才岷峨秀，风度晋魏前。\n宜方次公驾，可拍叔度肩。\n兹行去中都，江月六上弦。\n虽云诸侯师，我意终欿然。\n孝友当处中，此翁那戍边。\n落日照归旌，春江动离筵。\n饯公野王筝，老泪如迸泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄士美","author":"周孚","text":"长夏苦不佳，汤熨方少休。\n床头得新诗，恍若从子游。\n绚烂晚花秀，萦纡莫江流。\n寒蝉久聒耳，见此长鸣鸥。\n吾友苏季子，莫年专一丘。\n相从寄琢磨，喜子今得俦。\n隋珠荆文璧，子馈渠则酬。\n寄声问平安，忆此衰病不。\n亲交半九泉，老境集百忧。\n能来叙离阔，过是吾何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵赠从之并寄朝美士美","author":"周孚","text":"大汤陈元方，小汤许文休。\n向来京江岸，政作汝颍游。\n一随简书去，寒江自湍流。\n我瞻天际鸿，渠叹波上鸥。\n之子虽近交，襟怀亦林丘。\n缅惟两玉人，非子孰可俦。\n高标互晖映，妙语相应酬。\n鼎立照茅茨，何日能此不。\n句曲向荆溪，迁徙非所忧。\n得客三士间，衰年更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听环上人琴","author":"周孚","text":"幽弦窈眇方秋蝇，和音条鬯俄春莺。\n断冰哀玉俱入耳，听尽清商听清徵。\n浮云敛尽江月明，不意莫耳闻此声。\n夷中知白骨已朽，后来如师亦希有。\n但忧曲古世罕听，那不少徇时人情。\n宁甘弦断挂壁角，缠声鹿鸣渠不学。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送俞君任","author":"周孚","text":"中岁厌乖隔，此行几挽裾。\n故交还去子，老境孰知予。\n雪屋传觞处，春波解缆初。\n相过每仓卒，欲留重踟蹰。\n身健宜加饭，官閒剩著书。\n它年赤车召，留眼看相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次从之韵招从之","author":"周孚","text":"学子今方竹苇如，自怜老腹独空虚。\n短畦小摘犹能饭，荒径徐行可当车。\n世事从来多卤莽，吾侪何自有赢馀。\n肯来蠹简同签整，却恐令君得异书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许叔庸生日","author":"周孚","text":"酌公以京江潋滟之酒，寿公以海蕃氤氲之香。\n南山威凤下烟雾，北岳老松凌雪霜。\n十年阴功不胜纪，僵仆为苏痿为起。\n况复旌阳嫡孙子，火枣交梨固应尔。\n公衮元圭侍丹扆，不待渠侬菊潭水，千二百岁从今始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄陈道人时在吕城窦氏庄","author":"周孚","text":"渠家五桂后，卜宅近青郊。\n老竹窗前干，寒松屋外梢。\n才抛汗脚袜，真得盖头茅。\n落日春山路，病夫还解包。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀陈杜二丈二首 其一","author":"周孚","text":"容南老守几时回，更拚重看江上梅。\n便热藤笙犹可漆，未寒筒布会须裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀陈杜二丈二首 其二","author":"周孚","text":"寄语金陵汉郡丞，与谁同醉复同醒。\n不须吊古乌衣巷，且复寻春白下亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄幼安","author":"周孚","text":"送君城西原，春水今凿冰。\n两州灌瓜地，一往竟未能。\n衡门闭青苔，欲语谁复应。\n招邀西飞鸿，因得问寝兴。\n向时金华翁，与君尝伏膺。\n清谈尚尊俎，高标忽丘陵。\n梁木果尔摧，天理安可凭。\n吾侪鬼揶揄，可但世所憎。\n霜风拉枯桑，嘱君护茵凭。\n我病比复加，日饭那得升。\n残年卧闾巷，盛事望友朋。\n得见君奋飞，吾甘老薪蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄从之时闻游善权寺","author":"周孚","text":"曲槛临烟雨，书来政独凭。\n断崖青自献，森树绿相仍。\n胜践吾方梦，长閒子未应。\n聊烦相佳处，衰老欲依僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠侯元英予病疗之而愈","author":"周孚","text":"此生毛发燎洪炉，二竖骎骎更捣虚。\n恶剧方渠甚炮炙，残年非子已丘墟。\n较量绝艺真神似，惊怪羸骸却壮如。\n莫道何颙百无著，识君尝自十年初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题所画梅竹二首 其一","author":"周孚","text":"东坡戏作有声画，叹息何人为赏音。\n雨叶烟梢出新意，老夫知子用功深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题所画梅竹二首 其二","author":"周孚","text":"骎骎老境困埃尘，开卷霜林解笑人。\n画地馋涎君莫怪，十年魂断故园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱子代兼怀君任教授年兄二首 其一","author":"周孚","text":"吴门南望水漫漫，拟欲高飞欠羽翰。\n老境思渠甚饥渴，尺书烦子问平安。\n自知谱牒俱冰氏，敢厌班资但虱官。\n它日相逢吾有约，秋霜侵鬓折腰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱子代兼怀君任教授年兄二首 其二","author":"周孚","text":"粲粲新诗堕我前，夜深霜月照琼田。\n共惊败榻才三语，大胜尘编更十年。\n伏枥世谁怜老骥，浮空君自笑饥鸢。\n一穷似我那须怪，解困吾曹始是天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别乡旧","author":"周孚","text":"耕田畏秋旱，我老将奈何。\n清晨一叶舟，凌此万顷波。\n此岂我欲然，食口如雁鹅。\n逢迎非本心，惭负生积疴。\n君看柴桑翁，当时亦弦歌。\n人前强磨洗，谓与渠同科。\n悠悠天壤间，何向非南柯。\n餐钱苟有赢，吾愿初无多。\n归从五㹀牛，自种千把禾。\n不学陶士衡，衰年更婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄从之时闻黄丈仲秉初亡","author":"周孚","text":"陇月撩人特地圆，真成千里共婵娟。\n尺书好附今年雁，别酒尝听去夏蝉。\n二顷未知何处是，九原谁似此翁贤。\n老怀欲语还惆怅，肠断春江上水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵题南仲诗卷兼柬廷珍","author":"周孚","text":"新诗可但老夫降，窥杜真能见牖窗。\n静夜飞泉鸣远壑，莫秋孤月印晴江。\n弦从渠去虽难续，鼎自君来信可扛。\n银烛高张那得尔，且揩眵眼伴残缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵鹤林伸书记","author":"周孚","text":"不须沽酒别陶潜，修竹阴阴翠满帘。\n拂拭面前尘土案，与君相对课楞严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日者吴九万精三命又精于相三命则吾不知骨相不媚则吾自知之","author":"周孚","text":"官槐广文舍，愧子独来频。\n老境宁高位，衰年只病身。\n平生长孺戆，半世子云贫。\n照影吾犹笑，如渠岂贵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠胡应诚","author":"周孚","text":"攲倾老屋寄江滨，曾见官居四过春。\n两屐崎岖那惮远，一尊仓卒不言贫。\n旧游到此俱尘迹，异县惟君是故人。\n偪仄老怀无与语，更炊香稻住逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招陈生饭","author":"周孚","text":"别甑炊香饭，吾方望子来。\n难从瘦筇觅，试著小诗催。\n老语元谁听，幽怀始此开。\n虚庭伫明月，相与少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次陈生韵","author":"周孚","text":"子肯来从我，尘沙两鬓黄。\n饥鹰那择肉，老雁尚随阳。\n蠹简真堪怨，寒醅未易忘。\n嘐嘐浴沂老，吾敢笑渠狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄何髯","author":"周孚","text":"髯何不见二年馀，落魄京尘强健无。\n淮上风沙尤可厌，今年我亦白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭彦康次德裕韵","author":"周孚","text":"力学世不售，甘心委埃尘。\n悠悠长夜台，一往不愿晨。\n虽过贾谊年，竟似黔娄贫。\n施施者谁子，佩玉拖朝绅。\n交游能几何，又复失此人。\n妙语不可继，老怀向谁亲。\n忆昔共艰阨，我躯犹子身。\n右毂忽尔摧，此去良苦辛。\n岂无堂堂交，政恐难与仁。\n载歌黄鸟诗，老泪淋衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汪倅生日二首 其一","author":"周孚","text":"寄语溪头赤鲩公，只今为计莫匆匆。\n直须整顿乾坤了，却驾飙轮迓此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汪倅生日二首 其二","author":"周孚","text":"大儿文采汉于菟，叔季骎骎汗血驹。\n当有传家如此少，请公但醉碧琳腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其一 奎文阁","author":"周孚","text":"煌煌百宝函，珠璧烂星月。\n惊倒西域胡，祥光与天接。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其二 妙高台","author":"周孚","text":"江云隐檐楹，海月净窗几。\n安得德云来，与渠同徙倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其三 付衣堂","author":"周孚","text":"大地不解容，四众俱欲杀。\n不辨如是心，定难消此衲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其四 玉鉴堂","author":"周孚","text":"微风不动波，瑩可照毛发。\n谁解与渠磨，寒空秋夜月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其五 头陀岩","author":"周孚","text":"馀妖屏蛇虺，老屋化金碧。\n惜无柳柳州，为铭岩下石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其六 雄跨堂","author":"周孚","text":"一辱云汉章，林壑遂增价。\n便是补陀峰，还须避三舍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其七 楞伽室","author":"周孚","text":"不见碧眼胡，忽忽心未稳。\n印心须此经，烦君剩传本。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其八 吞海亭","author":"周孚","text":"谁云沧溟深，一吸了无在。\n试问何样人，身如椰子大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其九 浸月亭","author":"周孚","text":"寥寥清夜月，现此亭中水。\n谁能同斯游，归唤寒山子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山十咏呈坦叔 其十 卷雪亭","author":"周孚","text":"方惊匹练横，忽骇群羊散。\n纵使踣苍崖，老禅唯解看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵漕再可生日 其一","author":"周孚","text":"不待丹砂入颊红，长生元复自阴功。\n但令仁与甘棠似，甲子三周会见公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵漕再可生日 其二","author":"周孚","text":"万顷春江一苇杭，追锋归去觐明光。\n明年此夜端门宴，应向红云侍玉皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵漕再可生日 其三","author":"周孚","text":"一杯请寿碧琳腴，倦客骎骎欲白须。\n会见庙堂登圣相，自甘山泽著臞儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送周誉卿尉通城","author":"周孚","text":"别君所畦槐，忽已荫檐瓦。\n三年望归船，老屋勤扫洒。\n只今十日款，信是天所假。\n朝粳语已麋，夜烛醉还灺。\n儿童互窥觇，有客如此寡。\n观君岂癯仙，鬓苍面如赭。\n不应酸寒债，亦复似东野。\n匆匆从此去，孰是知音者。\n折腰易斗粟，吾辈计亦下。\n我场无良苗，何由絷君马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何山人欲为僧","author":"周孚","text":"来偿绮语债，各已鬓星星。\n宿债吾方困，迷涂子遽醒。\n真为镜空老，不负佛名经。\n一纸龙钟语，怜君独肯听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书日新烟江秋晚图后","author":"周孚","text":"莫年何处是菟裘，逆帽黄尘子更愁。\n开卷只今先有谶，晚烟寒苇两沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题宣书记塞门积雪图此图真柳子厚所谓千山鸟飞绝万径人踪灭者若孤舟蓑笠翁独钓寒江雪则以余诗见之","author":"周孚","text":"冰崖雪岭斗巉岩，中有新诗子试参。\n短笠轻蓑钓寒濑，为君题出是江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵从之诗来次韵寄之","author":"周孚","text":"论高不蘧蒢，语妙无摘裂。\n堂堂正始流，渠可补此缺。\n斯文久不见，老意今始惬。\n摩挲斲轮具，两手付已决。\n吾闻古志士，立操凛冰雪。\n方其自树立，政复谁识别。\n书成付后世，岂为儿辈设。\n浮云虽晻郁，孤月终皎洁。\n此言如苦荼，乞子甘齿颊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李清宇因寄滁阳旧游","author":"周孚","text":"君行还过永阳郡，忽忆老夫尝赋诗。\n庶子泉头纳凉处，醉翁亭上送秋时。\n春来猿鸟应思我，别后林泉定付谁。\n为语东风木芍药，暮年衰鬓不相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠相者","author":"周孚","text":"卧沙老木强雕锼，正自旁人替子羞。\n纵使今年果腾踏，也应笑倒邓元侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张元功见贻","author":"周孚","text":"山林未成归，须鬓各已老。\n下田我方耘，薄俸子始饱。\n缅怀千里驾，荒径宿秋草。\n谁知剥啄声，真来慰怀抱。\n崎岖得一笑，支拄费百巧。\n羁穷了如旧，但觉诗愈好。\n青山艳桃李，渌水漾芹藻。\n惟时夏正中，触热畏长道。\n子车且休息，我屋当洒扫。\n觌面尚未旬，语离无乃早。\n槐阴可纵觞，共子一倾倒。\n但恐老伯松，羞观太玄草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄陈德厚","author":"周孚","text":"骎骎胡马骄，漠漠楚氛恶。\n妖区未灰钉，剧阵猛刺斫。\n向来百金躯，垂老付沟壑。\n头涔何必疗，心悸还自愕。\n平生陈孺子，夙佩千金诺。\n渠如早奋飞，艰岁终有托。\n那知亦蹭蹬，正复同索寞。\n污池杂蛟蜃，丛艾纷燕雀。\n穷檐倚楹叹，搏击望一鹗。\n祝君鲁曹子，玉陛奏方略。\n铭功灿燕石，画像雄汉阁。\n平时万户赏，端不羞卫霍。\n屠羊反故肆，吾分本藜藿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书王伟诗卷六言二首 其一","author":"周孚","text":"玩世子方穷巷，怀人渠已荒丘。\n文举旧陪何尹，退之今信宣州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书王伟诗卷六言二首 其二","author":"周孚","text":"政自磊磊落落，不须草草匆匆。\n尝兴怀后山老，肯著眼豫章公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦与辛幼安遇于一精舍予赋诗一篇觉而记其卒章云它年寄书处当记卢仝穷因赋此诗寄之","author":"周孚","text":"秋霜草花落，梦君浮屠宫。\n羁魂得清游，短章见深衷。\n破屋仰见天，何人记卢仝。\n相逢大槐国，一笑仍匆匆。\n与君十年交，九年悲转蓬。\n君行牛斗南，我在淮汉东。\n修途缭山岳，此会何缘同。\n伏枕自叹息，衰怀托西风。\n啾啾篱间雀，冉冉天际鸿。\n担簦亦何憾，吾生自当穷。\n扁舟具蓑笠，久已藏胸中。\n它年君来时，苇间寻此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代人作孙尚书挽词二首 其一","author":"周孚","text":"耆德今无几，公谁敢比肩。\n甘泉方旧籍，京兆遽新阡。\n清议今何负，遗书竟莫传。\n单杯无自奠，老泪倍潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代人作孙尚书挽词二首 其二","author":"周孚","text":"平生玩鸥老，韩孟复相逢。\n暮齿俱三虎，中途止一龙。\n公今还此逝，吾老欲谁从。\n它日延陵剑，犹堪挂墓松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵从之","author":"周孚","text":"皖公城外佳山水，经岁登临亦快哉。\n未省曾逢玉蟾否，已应亲吊石牛来。\n洗空俗垢吾方羡，收尽诗材子始回。\n紫笋旧芽应好在，午窗春鼾正如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题薛希谊傲窗","author":"周孚","text":"平生湖海老元龙，何事低徊向此中。\n耻把旷怀陪聚蚁，力将幽趣付冥鸿。\n甑当堕处真堪笑，锥到无时未服穷。\n他日徵来豹林谷，尚应叉手对诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]