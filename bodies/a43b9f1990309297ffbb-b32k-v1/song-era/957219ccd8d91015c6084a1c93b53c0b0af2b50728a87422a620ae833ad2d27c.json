[{"title":"次韵程弟 其八","author":"方岳","text":"莫为盘飧烹不鸣，借公松石听溪声。\n貂蝉只是麒麟楦，寄语诸公卿自卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其六","author":"方岳","text":"柴门虽设不曾开，俗面向人三寸埃。\n却是前溪双白鹭，门关不住又飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢兄立春戏拟春帖子 其三","author":"方岳","text":"天地春回万寿杯，宫云留雪玉崔嵬。\n晓供帖子琼幡重，携得韶风下殿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢兄立春戏拟春帖子 其二","author":"方岳","text":"天家观阙玉重重，逼入春皇一信风。\n生意无边青欲动，微茫淡霭暖烟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢兄立春戏拟春帖子 其一","author":"方岳","text":"泉脉晴融太液池，内人初晓玉参差。\n东风认得农祥正，吹作丰年御制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢兄立春戏拟春帖子 其四","author":"方岳","text":"天与君王共一仁，只将仁与物为春。\n要令率土无枯槁，未赏冰池皱玉粼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢兄立春戏拟春帖子 其五","author":"方岳","text":"青旗簇仗赐银幡，共以升平奉至尊。\n阊阖千官花底散，紫泥香熟诏书温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬因胜老 其二","author":"方岳","text":"雁落平沙字字愁，打包不肯与山留。\n一篷烟雨载秋去，诗在江南芦荻洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬因胜老 其一","author":"方岳","text":"误脱农蓑拾汉科，空山奈此月明何。\n秋风又跨扬州鹤，行路正难愁思多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬因胜老 其三","author":"方岳","text":"浅山如霁水连天，江北江南路几千。\n入梦老亲双白发，归欤早及菊花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬奚兄 其二","author":"方岳","text":"但得梅花过一冬，那须圣酒送文穷。\n扬州不见梅花面，莫是何郎句未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬清脩老","author":"方岳","text":"玉堂老作清脩记，曾许渠为我辈人。\n髣髴三生虎溪笑，偶然一见面如春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬率翁 其二","author":"方岳","text":"但得清溪裹草堂，溪头山色有炎凉。\n秋崖一出四年矣，想见松花满石床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬率翁 其一","author":"方岳","text":"戍楼梦不到中州，杜牧新愁亦倦游。\n留得荷锄双手在，山寒芋栗要人收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君室 其一","author":"方岳","text":"匪书谁与稽，匪竹谁与居。\n以书造竹所，俯仰千载馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约鲁山兄","author":"方岳","text":"莫说寻芳已后时，春蔬解甲茗搴旗。\n松风石铫晴云盌，不是吾曹未必奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自嘲","author":"方岳","text":"耕雨虽微负郭田，卧云不用买山钱。\n春蓑健犊宁无语，又写前衔见集贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日","author":"方岳","text":"至日观书不几行，梅梢横影月昏黄。\n汉家红影无人见，未必曾添一线长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行田 其二","author":"方岳","text":"老农具榻茅茨底，准拟先生欲岸巾。\n笑道已呼儿贳酒，月明且不厌家贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行田 其一","author":"方岳","text":"屋头乌桕午阴密，牛与牧童相对眠。\n不是官中催税急，十年前已学耕田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观山","author":"方岳","text":"一层云放一层山，小市人家翠欲环。\n检点只疑低数尺，一层山向隐云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观刈 其一","author":"方岳","text":"石田荦确底须嫌，苦说频年不下镰。\n烟雨一犁经老手，翻匙香雪十分甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观刈 其二","author":"方岳","text":"蹄豚盂酒祝瓯窭，一饱人间百事休。\n已约山妻同野饭，今年又胜去年秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观刈 其三","author":"方岳","text":"秋来谁不负归田，炊玉尝新喜欲颠。\n乞我一年横短笛，太平有象是丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观天井","author":"方岳","text":"雷斧何年翠凿成，老龙吟苦雪涛惊。\n霜晴未用为霖在，留与春蓑作太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观池中鸂鶒逐其自外来者","author":"方岳","text":"久住成家不见猜，傍船水暖逐毰毸。\n岸沙能占春多少，长恐诸侯客子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观荷 其一","author":"方岳","text":"南薰独擅水云乡，不许人间别有香。\n是草是花开一遍，春风却似欠商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观荷 其二","author":"方岳","text":"春红树树或丛丛，一一托根尘土中。\n不道独清冰氏子，炎天玉立水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观荷 其四","author":"方岳","text":"莲有濂溪梅有逋，两家言句满江湖。\n自怜尚与梅花隔，曾识先生太极图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观荷 其五","author":"方岳","text":"花叶根茎迥不同，略无些子犯春风。\n羽衣纵落寻芳后，解作清凉烈日中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梅 其二","author":"方岳","text":"卧疴半月不曾来，等得来时渐次开。\n世外交情无久近，岁寒然后始知梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梅 其三","author":"方岳","text":"几日商量雪不成，竹边寒得瘦棱层。\n秋崖老子缩如猬，撚断吟髭寸寸冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梅 其四","author":"方岳","text":"片片随风隔坞飘，野香相逐过溪桥。\n今年便觉春风早，雪不成绵到地消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梅 其五","author":"方岳","text":"较似年时劣不如，花头小小两疏疏。\n但令半点微酸在，憔悴空山尽有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梅 其六","author":"方岳","text":"老树槎枒只一花，气条亦不放横斜。\n无风无雨无烟月，独立人间莫怨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访恭率翁不值","author":"方岳","text":"且容晴梦泊鸥沙，传语茶头莫点茶。\n山客不归秋自老，满城风雨又黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过楚道人舍 其一","author":"方岳","text":"纷纷俗子俗到骨，对面有山那得看。\n不料楚髯能辨此，夜深月冷石阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过楚道人舍 其二","author":"方岳","text":"平生诗友刘宾客，醉墨曾传到雪庐。\n煞说竹溪茅屋好，便能诗亦不如渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过缙云胡君作茶古松下丛兰中","author":"方岳","text":"十丈苍皮带雪僵，山云归晚泊书床。\n不缘曾读离骚熟，兰亦欺人未肯香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严陵待锁 其一","author":"方岳","text":"一舸秋风梦亦寒，津人只作贾胡看。\n断桥袖手暮烟合，等得芦花雪满滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别子才司令","author":"方岳","text":"不如意事常八九，可与语人无二三。\n自识荆门子才甫，梦驰铁马战城南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别汤卿不值","author":"方岳","text":"云深只以竹为墙，新雨才乾径草长。\n野鹤已随溪客远，一方玄玉带诗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"方岳","text":"自刈香粳税水舂，旋篘新酒搦泥封。\n晚菘种已无馀地，不枉归田学老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其二","author":"方岳","text":"荒烟疏树野人家，竹外寻诗一径斜。\n山鸟亦知人意思，忽翻残雪啄梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其一","author":"方岳","text":"野径孤横雪外枝，岁寒了不受春知。\n世间所谓奇男子，除却梅花更是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其十","author":"方岳","text":"残鬓萧萧不满梳，秋风椎髻立庭除。\n日明照见崚嶒影，自是山僧不是予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其九","author":"方岳","text":"得摇牙处尽摇牙，底用鸣声绕鬓哗。\n政自为渠眠不熟，西风吹叶打窗纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其八","author":"方岳","text":"赤日黄埃槁欲焚，赛神迎佛正纷纷。\n天公老手何关汝，一雨晴无一点云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其七","author":"方岳","text":"岩暝林霏日夕佳，百年宁复此秋崖。\n不须更问青乌子，一锸相随死便埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其六","author":"方岳","text":"记得秋风此削瓜，偶遗子亦自成花。\n生生造化无终极，但有根芽未可涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其五","author":"方岳","text":"龙骨翻翻水倒流，藕花借与稻花秋。\n鱼兼熊掌不可得，宁负风光救口休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其四","author":"方岳","text":"藤蔓穿篱碍草扉，与僮扶起绕松围。\n髯龙鳞甲动云雨，缚著空山莫遣飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其三","author":"方岳","text":"畦丁亸懒欲谁欺，趁我山行始一犁。\n只有山花山鸟笑，主人元自不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其二","author":"方岳","text":"野塘尺水亦生烟，宁有馀波可及田。\n商略且为鱼作计，须臾毋死待丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事十首 其一","author":"方岳","text":"窥园何物愠无端，疥手偷将玉雪团。\n不道主林神忌讳，鸟乌声乐并催残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君用致红梅云不开数年矣","author":"方岳","text":"山家已作枯槎看，带雪移来却自春。\n一夜揣摩花意思，宁将醉面向村人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李监饟四物各以一绝答之 土瓜","author":"方岳","text":"蹲鸱不紫茯苓黄，初斸春烟带土香。\n久觉相如诗肺渴，入山餐玉不传方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊牛口","author":"苏轼","text":"日落红雾生，系舟宿牛口。\n居民偶相聚，三四依古柳。\n负薪出深谷，见客喜且售。\n煮蔬为夜飧，安识肉与酒。\n朔风吹茅屋，破壁见星斗。\n儿女自咿嚘，亦足乐且久。\n人生本无事，苦为世味诱。\n富贵耀吾前，贫贱独难守。\n谁知深山子，甘与麋鹿友。\n置身落蛮荒，生意不自陋。\n今予独何者，汲汲强奔走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李监饟四物各以一绝答之 鹅鲊","author":"方岳","text":"翠箬红泥曲米春，篆滩风月入厨珍。\n谁令渠识黄庭字，且醉胸中无字人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李监饟四物各以一绝答之 鲟鲊","author":"方岳","text":"肉未为奇骨最奇，透明玛瑙碎琉璃。\n老饕不奈残牙齿，却爱桃花软玉脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汪圣权自开寿域作小亭其前植桂环之谒予作扁有诗云不分桂籍一毫月枉踏槐花十八秋其志亦可悲也已为题曰桂穴而系之诗 其一","author":"方岳","text":"老蚕作茧自缠裹，不肯生前只么休。\n却后百年牢记取，满身明月桂花秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汪圣权自开寿域作小亭其前植桂环之谒予作扁有诗云不分桂籍一毫月枉踏槐花十八秋其志亦可悲也已为题曰桂穴而系之诗 其二","author":"方岳","text":"白头不了秋风债，桂穴锄云种一枝。\n与世今迷日五色，莫教地下有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汪运干饷酒 其一","author":"方岳","text":"长须手挈一壶酒，问识浣花工部无。\n蓑笠荷锄烟雨外，再三不信是耕夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汪运干饷酒 其二","author":"方岳","text":"酒吾甚爱径须醉，快洗平生老瓦盆。\n中有笔峰能画我，一牛横笛过孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹多不开花","author":"方岳","text":"韶风万物照我庐，昨岁骈头今并疏。\n自是爱花心不足，何知物物有乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹多不开花","author":"方岳","text":"少作花头多作丛，十分能有几分红。\n春工自不容人力，抱瓮穷年笑此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"社日","author":"方岳","text":"燕子今年掯社来，翠瓶犹有去年梅。\n丁宁莫管杏花俗，付与春风一道开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"社日益明叔见过","author":"方岳","text":"溪云酝酿社公雨，肯踏寒莎过阿戎。\n亦有小诗拈未出，且携瀑布煮春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉","author":"方岳","text":"数叶芭蕉数叶秋，灯长雨久不眠愁。\n灵溪寺里夜曾听，又听灵溪溪水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉","author":"方岳","text":"自是愁人愁不消，非干雨里听芭蕉。\n芭蕉易去愁难去，移向梧桐转寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还留石亭","author":"方岳","text":"枯荷折苇卧凫鸥，小雨轻烟画出秋。\n自唤短篷将老砚，石亭寻客了诗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居无与酬答因假庭下三物作 竹答梅","author":"方岳","text":"不随桃李共争春，犹作疏花向世人。\n耸壑未妨吾独步，要看晚节玉璘珣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居无与酬答因假庭下三物作 桃讽梅","author":"方岳","text":"不肯春风时世妆，岁寒崖谷倚冰霜。\n人间亦有知香者，盍遣一枝横出墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居无与酬答因假庭下三物作 梅问竹","author":"方岳","text":"一壑烟寒孰与娱，横斜影对此君臞。\n风饕雪虐转强项，惟我与君其是夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居无与酬答因假庭下三物作 梅谢桃","author":"方岳","text":"下欲成蹊春已残，雨红犹自有人看。\n极知不与君同调，但守平生一点酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈汤卿致绍梅","author":"方岳","text":"林下风流自一家，纵施朱亦不奢华。\n冷香犹带灞桥雪，不比春风桃杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮荼蘼花下招蔡公庆","author":"方岳","text":"春工管不了霓裳，风自南来占取香。\n一夜谢池晴雪满，无人说与蔡中郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龟巢夜宴","author":"方岳","text":"落日鸳鸯睡浅坡，荷花初醒水微波。\n玉箫吹断晴云湿，最觉池宽得月多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]