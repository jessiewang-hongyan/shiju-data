[{"title":"题陈山飞星石","author":"鲁应龙","text":"锦石双星下翠微，忽看移入小岩扉。\n灵光夜静归山径，翠影秋寒上拂衣。\n滇海始知鲸欲动，零陵不独燕能飞。\n只今五色曾何补，自采奇峰筑钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洗药源","author":"鲁宗道","text":"采得千年药，临流净洗藏。\n至今源里水，犹带旧时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莲花源","author":"鲁宗道","text":"花开十丈照峰头，露褪红衣烂不收。\n太乙真人多逸兴，稳眠一叶泛中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登黄山","author":"鲁宗道","text":"三十六峰凝翠霭，数千馀仞锁岚烟。\n轩皇去后无消息，白鹿青牛何处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归护国寺","author":"鲁宗道","text":"倏来倏去本无心，旧国王家念正深。\n犹喜大缘逢景运，不辞千里答嘉音。\n人间话道经三伏，岛外栖禅指二林。\n留别皇都有新偈，苦将泡幻喻升沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汤泉院壁","author":"鲁宗道","text":"黄山胜地烟霞明，朱砂泉暖肌肤醒。\n鸟声不断山不坏，今人古人徒营营。\n暂来谁更辞硗确，抖擞尘缨聊浣濯。\n灵泉去病功绩深，无人复创为高阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百丈甘","author":"鲁某","text":"碧玉纤纤百丈高，仙家曾用酝香醪。\n至今绿叶挼成酒，不使刘伶更藉糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"鲁某","text":"锦步斜开四十里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"鲁某","text":"一条仙帔织青霓，松雪岩前伴鹤栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚 其一","author":"释道潜","text":"叠颖丛条翠欲流，午阴浓处听鸣鸠。\n儿童赌罢榆钱去，狼藉春风漫不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观武侯阵图","author":"鲁訔","text":"西川汉鼎倚纶巾，翠石累累作阵新。\n一夜扫云惊虎旅，九天飞雨泣龙鳞。\n当年已落中原胆，今日犹怜故国身。\n曾踏斜阳看旧垒，英雄千古只伊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏才德","author":"鲁訔","text":"韵如风蝉蜕尘垢，气如春容在杨柳。\n风流翰墨俱细事，自是吾家道门友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"鲁訔","text":"坐啸蓬宫，移旌天府，往来三岛十洲。\n况瑞霭当年，初下琼楼。\n自是长生伴侣，那堪更河润神州。\n人争叹，威名福寿，衮衮压潮头。\n金瓯。\n须满泛，天厨禁脔，相酝□□。\n□□□□日，此会风流。\n正是湖山春媚，千秋岁、□□民猷。\n还知道，金瓯未拜，先拜富民侯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次唐彦猷顾亭林韵","author":"鲁晦之","text":"烟雨三家市，黄门卜此居。\n著书千纸在，祠宇几椽疏。\n潮汐成今古，牛羊有里墟。\n举兵锄逆节，风烈照无馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事三首呈郎中机宜 其一","author":"廉布","text":"避地意何适，同时得二贤。\n才名谁敢并，萧散或堪怜。\n浊酒宁非道，枯藤自会禅。\n尚须浮碧海，风月夜同船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事三首呈郎中机宜 其三","author":"廉布","text":"山路入云烟，精蓝沧海边。\n崖沙留虎迹，石壁曳蛟涎。\n猿啸千山寂，鸟惊半月弦。\n忧来非一事，种种上华巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事三首呈郎中机宜 其二","author":"廉布","text":"地僻春将半，僧房客暂休。\n连山花雾暗，半岭竹云愁。\n将士戈犹枕，书生笔屡投。\n黠羌兵未戢，上有自焚忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵","author":"廉布","text":"当年对元夕，载酒向淮湾。\n宝瑟荣珠袖，青藜照玉山。\n蛮村当此夜，璧月独临关。\n尚忆追游胜，萧萧双鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵","author":"廉布","text":"避地来何所，穷山沧海边。\n雄图今寂寞，吾道昔迍邅。\n宴食甘粗饭，偷生忍击鲜。\n乡闾重回首，挥泪入淮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"廉布","text":"独倚寒岩生意绝，任他桃李自成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"愈上人","text":"闲伴孤云自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耆英会诗 其一","author":"楚建中","text":"自顾颓龄七十馀，久惭顽钝费洪炉。\n归逢大老耆年会，衰朽形骸愧画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耆英会诗 其二","author":"楚建中","text":"二相谟猷烂史编，诸公才业过前贤。\n好图仪像传来世，何事顽疏亦比肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂花","author":"楚娘","text":"丹桂迎风蓓蕾开，摘来斜插竟相偎。\n清香不与群芳并，仙种原从月里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子 题壁间","author":"楚娘","text":"去年梅雪天，千里人归远。\n今岁雪梅天，千里人追怨。\n铁石作心肠，铁石刚犹软。\n江海比君恩，江海深犹浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都下作","author":"楼云卧","text":"红尘车马道，曾向闹中看。\n贵贱人多等，利名心一般。\n侯门崇嗜欲，客路薄孤寒。\n谁肯翻然悟，寻仙求大丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"楼扶","text":"夜深更拥寒衾坐，明月梅花共一窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水龙吟 次清真梨花韵","author":"楼枎","text":"素蛾洗尽繁妆，夜深步月秋千地。\n轻腮晕玉，柔肌笼粉，缁尘敛避。\n霁雪留香，晓云同梦，昭阳宫闭。\n怅仙园路杳，曲栏人寂，疏雨湿、盈盈泪。\n未放游蜂叶底。\n怕春归、不禁狂吹。\n象床困倚，冰魂微醒，莺声唤起。\n愁对黄昏，恨催寒食，满襟离思。\n想千红过尽，一枝独冷，把梅花比。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沁园春 登候涛山","author":"楼枎","text":"开辟以来，便有此山，独当怒涛。\n正秋空万里，寒催雁信，尘寰一簇，轻等鸿毛。\n小可诗情，寻常酒量，到此应须分外豪。\n难为水，算平生未有，此番登高。\n飘飘。\n身踏金鳌。\n笑终日风波无限劳。\n看樯乌缥缈，帆归远浦，廛鱼杂沓，网带馀潮。\n待约诗人，相将月夜，取次携杯持蟹螯。\n乘桴意，问谁人领解，空立亭皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"楼枎","text":"丝丝杨柳莺声近。\n晚风吹过秋千影。\n寒色一帘轻。\n灯残梦不成。\n耳边消息在。\n笑指花梢待。\n又是不归来。\n满庭花自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二郎神","author":"楼采","text":"露床转玉，唤睡醒、绿云梳晓。\n正倦立银屏，新宽衣带，生怯轻寒料峭。\n闷绝相思无人问，但怨入、墙阴啼鸟。\n嗟露屋锁春，晴风暄昼，柳轻梅小。\n人悄。\n日长谩忆，秋千嬉笑。\n怅烬冷炉薰，花深莺静，帘箔微红醉袅。\n带结留诗，粉痕销帕，情远窃香年少。\n凝恨极，尽日凭高目断，淡烟芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其二","author":"楼采","text":"汗粉难融，袖香新窃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其一 紫丁香","author":"楼采","text":"珠蹙花舆，翠翻莲额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉楼春","author":"楼采","text":"东风破晓寒成阵。\n曲锁沈香簧语嫩。\n凤钗敲枕玉声圆，罗袖拂屏金缕褪。\n云头雁影占来信。\n歌底眉尖萦浅晕。\n淡烟疏柳一帘春，细雨遥山千叠恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉漏迟","author":"楼采","text":"絮花寒食路。\n晴丝罥日，绿阴吹雾。\n客帽欺风，愁满画船烟浦。\n彩柱秋千散后，怅尘锁、燕帘莺户。\n从间阻。\n梦云无准，鬓霜如许。\n夜永绣阁藏娇，记掩扇传歌，剪灯留语。\n月约星期，细把花须频数。\n弹指一襟幽恨，谩空趁、啼鹃声诉。\n深院宇。\n黄昏杏花微雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其一","author":"楼采","text":"人去玉屏间，逗晓柳丝风急。\n帘外杏花细雨，罥春红愁湿。\n单衣初试曲尘罗，中酒病无力。\n应是绣床慵困，倚秋千斜立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法曲献仙音","author":"楼采","text":"花匣么弦，象奁双陆，旧日留欢情意。\n梦到银屏，恨裁兰烛，香篝夜阑鸳被。\n料燕子重来地。\n桐阴锁窗绮。\n倦梳洗。\n晕芳钿、自羞鸾镜，罗袖冷，烟柳画栏半倚。\n浅雨压荼蘼，指东风、芳事馀几。\n院落黄昏，怕春莺、惊笑憔悴。\n倩柔红约定，唤取玉箫同醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹤仙","author":"楼采","text":"冻痕销梦草。\n又招得春归，旧家池沼。\n园扉掩寒峭。\n倩谁将花信，遍传深窈。\n追游趁早。\n便裁却、轻衫短帽。\n任残梅、飞满溪桥，和月醉眠清晓。\n年小。\n青丝纤手，彩胜娇鬟，赋情谁表。\n南楼信杳。\n江云重，雁归少。\n记冲香嘶马，流红回岸，几度绿杨残照。\n想暗黄，依旧东风，灞陵古道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十四日携家泛月次韵 其三","author":"楼钥","text":"稍先一日我中秋，行遍芙蓉与菊洲。\n作意安排却非适，不如乘兴径行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十四日携家泛月次韵 其五","author":"楼钥","text":"草草真成一段奇，比邻非不借馀辉。\n板舆何敢侵风露，略望檐间且劝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十四日携家泛月次韵 其一","author":"楼钥","text":"月到平湖金作波，一城惟此占秋多。\n水晶宫里清无比，何用重登汉馺娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十四日携家泛月次韵 其四","author":"楼钥","text":"犹记年时看水嬉，不如此夜月相宜。\n仙翁一醉非尘世，为问姮娥知未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月四日晚霹雳碎大柳木","author":"楼钥","text":"秋分雷自合收声，白露明朝忽震霆。\n怪得坐中惊欲倒，邻墙老柳碎中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月十七日夜","author":"楼钥","text":"蛰虫坯户六经旬，掣电惊雷若莫春。\n震起昆虫千百亿，不知何处更容身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次郑性之悬尉韵 其一","author":"楼钥","text":"槁项疲农病夏畦，喜闻烟雨四天垂。\n旋寻粳稻供糜粥，惊见新香玉满匙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次郑性之悬尉韵 其二","author":"楼钥","text":"闵雨才宽又畏风，从朝愁到夕阳舂。\n谁教官到二千石，不学当年邴曼容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次郑性之悬尉韵 其三","author":"楼钥","text":"几番好雨应先占，欣见阶庭绿草纤。\n秋后阴晴犹未定，更看新月卧磨镰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次郑性之悬尉韵 其四","author":"楼钥","text":"爰居集鲁要先知，飞雪侵春久已疑。\n惭愧风师幸安静，敢将虎口斗龙痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上史太傅 其一","author":"楼钥","text":"一坡烟水绿湾环，竹树楼台缥缈间。\n但说一丘藏曲折，谁知更有四明山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上史太傅 其三","author":"楼钥","text":"衮绣堂中语夜分，几将经史细评论。\n不知世上三公贵，祇是东湖八行孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上史太傅 其二","author":"楼钥","text":"二十里云随步生，潺湲洞里访青棂。\n山中要识无穷趣，看取南雷问答经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪赵振文寄诗言乘月泛舟清甚次韵 其一","author":"楼钥","text":"老我心知笔力衰，颇欣腊雪瑞清时。\n三茅奇观亦难遇，白玉峰头灯万枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪赵振文寄诗言乘月泛舟清甚次韵 其三","author":"楼钥","text":"雪光绝胜水银银，未觉仙家隔一尘。\n真境宜君著佳句，赏心乐事更良辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪赵振文寄诗言乘月泛舟清甚次韵 其二","author":"楼钥","text":"万玉真妃摇佩琚，梁园授简属相如。\n莫嫌一水限吴越，两岸交辉合太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪赵振文寄诗言乘月泛舟清甚次韵 其五","author":"楼钥","text":"旧闻老具擅诗声，夜泛钱塘向凤城。\n今日清游更豪逸，雪花和月带潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪赵振文寄诗言乘月泛舟清甚次韵 其四","author":"楼钥","text":"见说中宵泛綵舟，何人同赏大江流。\n阳冰伯雪应为伴，更约禅人白道猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子成兄年八十六史子久八十二舅氏八十一会于适斋次韵二绝 其一","author":"楼钥","text":"堂中三寿喜同时，黄发相逢齿更儿。\n参坐共谈宣政旧，风流不许后生知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子成兄年八十六史子久八十二舅氏八十一会于适斋次韵二绝 其二","author":"楼钥","text":"闾里旧游能几人，适斋犹有笔如神。\n莫言二老升沈异，各现宰官居士身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小雨","author":"楼钥","text":"好风先雨到危栏，却送残云过别山。\n不用开襟强披拂，自然凉意满人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小酌元卫弟听雨","author":"楼钥","text":"小阁临流暑气清，藕花的的照人明。\n移床更近栏边坐，要听棋声杂雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小溪道中 其二","author":"楼钥","text":"后衕环村尽溯游，凤山寺下换轻舟。\n舟人努力双篙急，引得清溪逆岸流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小溪道中 其一","author":"楼钥","text":"簇簇苍山隐夕晖，遥看野雁著行归。\n久之不动方知是，一搭碎云寒不飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山阴道中 其一","author":"楼钥","text":"昨望山阴古道中，蕺山直上最高峰。\n今朝更踏山阴道，却向云间认八松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广轩夜望","author":"楼钥","text":"点点万家灯，风清醉复醒。\n广轩高绝处，俯瞰一天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹桂","author":"楼钥","text":"碧云步障紫金蕤，风静秋高千万枝。\n娇额涂黄元自好，是谁深传蜜烟脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌戍道中","author":"楼钥","text":"田在港西家港东，断桥春水步难通。\n束芦挟瓮稳来去，不碍小船分钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从子沨送梅枝戏作","author":"楼钥","text":"向来地暖见东嘉，带叶江梅殿岁华。\n不似青春三月暮，南枝梅子北枝花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从子涤濯寒纳凉","author":"楼钥","text":"杨柳阴阴映粉墙，密云藏雨晚来凉。\n高荷欲出栏干上，笑挹红英吸净香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以十月桃杂松竹置瓶中照以镜屏用潚韵","author":"楼钥","text":"中有桃源天地宽，杳然溪照武陵寒。\n莫言洞府无由入，试向桃花背后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以玉兰赠王习父 其二","author":"楼钥","text":"华屋翚飞庆事绵，芝兰玉树喜庭前。\n似闻楚畹芽初茁，便看蓝田生晚烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以玉兰赠王习父 其一","author":"楼钥","text":"一种香兰玉色新，仙家分得蕊宫春。\n调高韵胜谁能称，付与能言解语人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日","author":"楼钥","text":"岁当庚午旦庚寅，最喜明朝遇上辛。\n五福来临吴越分，更欣三日即攽春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"午暑","author":"楼钥","text":"炎官火伞罩中区，病老低垂气不苏。\n难学孙儿频饮冷，时将冰水洗霜须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]