[{"title":"己酉中元","author":"韩琦","text":"烦蒸求得到中元，馀酷侵人尚鲜欢。\n病塞不能冲酒堰，气清终已倒盂兰。\n陈编就榻将开懒，危阁凌风欲下难。\n闻道禾弮尽踰尺，日西偏喜夕霞丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋席上","author":"韩琦","text":"去年西洛过中秋，正怯清光刺病眸。\n此夜北都逢好月，喜延嘉客上高楼。\n真居自与风尘绝，雅句须穷造化搜。\n但引流霞歌白雪，岂殊身在广寒游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日水阁","author":"韩琦","text":"池馆隳摧古榭荒，此延嘉客会重阳。\n虽渐老圃秋容淡，且看寒花晚节香。\n酒味已醇新过热，蟹黄先实不须霜。\n年来饮兴衰难强，漫有高吟力尚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和机宜强至都官喜雪","author":"韩琦","text":"繁云凝结远成堆，雪意应随雅客来。\n满地妆梅知腊近，一天风絮误春回。\n玳攲宾席豪诗笔，珠沃歌喉滑醉杯。\n病叟有心萌酒战，明轰钟鼓不衔枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵再答","author":"韩琦","text":"天和人意共昏昏，飘掷繁霙助客樽。\n正会笙歌开醉目，忽惊珠玉得嘉言。\n已凌衰鬓争霜采，更拂妖颜上粉痕。\n东阁有贤才调雅，愧无优礼绍公孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雅集堂","author":"韩琦","text":"过马传名事莫详，我严宾集在更张。\n不资金石升堂乐，务接芝兰入室香。\n农穫大丰歌滞穗，讼销群枉阒甘棠。\n时闻雅席延诸彦，病守心閒兴亦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望宸阁雪后","author":"韩琦","text":"重阴初释六花残，试倚危栏一望看。\n魂爽顿如居物外，句新难得上毫端。\n酒收豪席珊瑚碎，风刮仙盘沆瀣乾。\n化就兜罗绵世界，鹫宫高插白云寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己酉岁除夜雪","author":"韩琦","text":"故历将除夜未晨，暖风轻送六霙匀。\n及时皆喜逢三白，伺晓何妨具五辛。\n一箭尚留终在腊，万花潜发欲惊春。\n藏阄令恶传杯速，欢杀红炉守岁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴席上","author":"韩琦","text":"腊寒初破作春阴，澌涩铜乌远漏沉。\n气折笙簧声易软，涧匀梅柳色潜深。\n已催豪侠将狂兴，更恼衰残欲病心。\n任展轻销谁画得，雾昏楼阁半遥林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙兴灯夕","author":"韩琦","text":"花雨交加坠宝坊，万灯全掩玉蟾光。\n几时莲与春风偶，此夜人如蜡日狂。\n欲乐一知趋寿域，路迷无处不仙乡。\n当筵自是壶中景，莫访金吾漏短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元遇雨席上","author":"韩琦","text":"此夕浓阴送雨来，冥然天意可轻猜。\n欲催嘉卉乘时发，似抑妖莲作伪开。\n强沸金丝终断续，半濡罗绮尚徘徊。\n待前一任游人散，且听新声尽醉罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雪","author":"韩琦","text":"几阵风凝霰作床，稳承花雪入春芳。\n南园蝶舞都疑梦，北岭梅开只欠香。\n气暖不容冰笋就，润深潜引麦针长。\n衰翁未得阳和助，且自宜城抵醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中和节后园","author":"韩琦","text":"半销残雪在庭柯，寂寞园林试强过。\n正病寒威连月困，不知春色一朝多。\n小桃楼角香心动，百舌枝头语意和。\n促理新声加酿酒，只忧韶景去如梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春释奠","author":"韩琦","text":"明祀严先甲，喜辰历上丁。\n采芹因旧馆，释菜协前经。\n俎豆由斯学，粢盛信匪馨。\n欲知时祭重，百世仰仪刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"康戌二月十六日寒食会雅集堂","author":"韩琦","text":"百五嘉辰此命筵，中分春色极芳妍。\n花遗嫩靥饶风地，云坼轻阴半雨天。\n淑景万容妆节物，胜游千路入神仙。\n酣杯莫顾归时夜，藏火难逢月尚圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会压沙寺观梨花","author":"韩琦","text":"同赏利花过净坊，压沙幽阒面平冈。\n孤园不治黄金界，醉笔徒誇白雪香。\n风急几翻云影乱，殿深全掩玉毫光。\n朝来经雨低含泪，竞写真妃寂寞妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和宋适推官压沙惠诗","author":"韩琦","text":"天知人意喜春娱，故作轻云捲复舒。\n风撼花飞铺宴席，雨平沙稳助流车。\n蛾颦嫩叶初眠柳，马茁柔椿未荐蔬。\n何必笙歌喧坐上，且延欢伯侍香裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过全福寺","author":"韩琦","text":"伊昔豪英袭将牙，更崇因果欲何加。\n精蓝世自传缁服，绘像尘谁障碧纱。\n诗好盈编堆锦组，字奇随笔走龙蛇。\n空馀旧史高风在，衰替嗟吾外氏家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳会许公亭二首 其一","author":"韩琦","text":"三月三来御水涯，古亭春色绿相遮。\n牡丹已认冠丛叶，郁李真疑绶引花。\n侍妓寝歌成雅席，恶风吹酒入微沙。\n土囊终夕从飘怒，不障清欢祓禊家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳会许公亭二首 其二","author":"韩琦","text":"元巳乘闲到许亭，胜游差远几开扃。\n寻春自失花颜素，爱客偏回柳眼青。\n曲水事遥存燕喜，甘棠人去想仪形。\n禊筵莫愬杯行数，归辔迎风酒易醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和通判钱昌武郎中上巳许公亭惠诗","author":"韩琦","text":"亭馆萧然古岸头，园林虽雅背清流。\n感时堪惜芳菲过，拖病须从祓禊游。\n归舰逆风乘醉去，落花随水带香浮。\n贰车欲继山阴事，立赋新篇不易酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和留守宋适推官游宴御河二首 其一","author":"韩琦","text":"笳鼓齐喧泛御津，何妨同欲乐兹辰。\n中三节物初过五，八十春光未破旬。\n红旆厌风收电脚，绿波伤棹散鱼鳞。\n欲知治世升平象，请看熙熙两岸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和留守宋适推官游宴御河二首 其二","author":"韩琦","text":"三月春容骀荡天，御流飞舸引双旃。\n十分芳景无三二，四合游人有万千。\n花任风残犹逐水，酒随歌半已空船。\n病夫且伴嘉宾醉，不过明朝卯尚眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月十八日上水关","author":"韩琦","text":"河曲春游得旧传，使君从俗上兰船。\n低篷密罩香罗绮，小艇交飏细管弦。\n有献满盘烘芍药，竞豪临水落鞦韆。\n归来夹岸民观甚，望远应疑李郭仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月十八日会望春亭","author":"韩琦","text":"此日倾城乐御河，作河生日语应讹。\n波涵祛服千花乱，风壮欢声万曲和。\n元巳嬉游非俗尚，十洲光景得春多。\n衰翁欲尽都人兴，醉弁归同夕照俄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西园初暑","author":"韩琦","text":"可爱西园夏景长，南来风好拂襟凉。\n楼台轩豁年殊旧，池沼乾枯雨未滂。\n群鸟护雏时起斗，众花成子几堪尝。\n欲知逃暑芳樽味，似过林禽玉溜浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄西台子渊赵学士","author":"韩琦","text":"昔年瀛馆接仙才，官路升沈孰可猜。\n直使庸驽叨上笏，却教贤杰老西台。\n莫悲居处荒三径，且把功名寄一杯。\n应笑位高归去晚，谤多终日怒蚊雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦热未雨","author":"韩琦","text":"骄阳为虐极烦歊，万物如焚望沃焦。\n举世不能逃酷吏，几时还得快凉飙。\n精祈拟责泥龙效，大索谁诛旱魃妖。\n翘首岱云肤寸起，四方膏泽尽良苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨足晚晴","author":"韩琦","text":"掣电搜龙发怒雷，欲驱时旱涤民灾。\n四溟滂泽三农足，万宇愁襟一夕开。\n虹影渐从天外散，蝉声初到枕边来。\n高楼小酌清风满，不胜当年避暑杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚戌秋分","author":"韩琦","text":"淅淅风清叶未凋，秋分残景自萧条。\n禾头无耳时微旱，蚊嘴生花毒渐消。\n钱迸嫩苔陈阁静，字横宾雁楚天遥。\n西园宴集偏宜夜，坐看圆蟾过丽谯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋遇雨","author":"韩琦","text":"待月中秋一肆筵，雨轻云晦似无缘。\n何须寒影摇杯面，且命高歌醉目前。\n莫向此宵空怅望，定应明夜亦婵娟。\n凭栏可奈时人意，不爱清光只重圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和通判钱昌武郎中中秋遇雨","author":"韩琦","text":"灵祠躬祷极伸虔，唯恐愆阳病晚田。\n不恨高楼空宴月，却欣丰泽入民天。\n且歌多稼将栖亩，莫赋嘉期动隔年。\n愧误宾轩侵夜散，阻看银界烂三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋筵散雨馀见月色","author":"韩琦","text":"正苦中秋暝雨侵，忽惊凉月绽云深。\n壶光未透冰涵玉，鉴影微昏藓上金。\n彩笔怨吟几绝望，巨觥酣战欲重寻。\n孀娥似慰人心郁，时放蟾辉漏薄阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九会安正堂","author":"韩琦","text":"欲安衰朽敞虚堂，窃信孤忠敢自当。\n本幸岁时同众乐，适开樽俎遇重阳。\n黄花旋插香环坐，翠岭新成妙出墙。\n留与邺都为故事，年年常占好风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九晚登骑山楼","author":"韩琦","text":"萧疏嘉节得阳重，病守西园此又逢。\n且奉宾欢穷胜事，莫悲秋色动衰容。\n管喧银字凌歌席，菊碎金铃上醉钟。\n何必更临高处会，北楼深古近骑峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"压沙寺梨","author":"韩琦","text":"压沙千亩敌侯封，珍果诚非众品同。\n自得嘉名过冰蜜，谁知精别有雌雄。\n常滋沆瀣充肌脆，不假燕脂上颊红。\n四海举皆推美味，任从潘赋纪张公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卿师上人","author":"韩琦","text":"区区京毂几经春，不退方能运法轮。\n欲举筌蹄皆自达，纵罗寒暑岂吾辛。\n大千虽纳宁多施，一切谁名得度人。\n我已心中了无物，重烦师说究微尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谢山人归紫霄旧隐","author":"韩琦","text":"董君坛侧杏林新，高卧云霞独一身。\n已究丹经成大药，更居仙府得长春。\n仁心务济谁思报，道术逢知即示真。\n暂别山来应自笑，紫霄曾未识红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"通判钱昌武代归以诗见别次韵为答","author":"韩琦","text":"衰病何堪治邺台，贰车犹喜得高才。\n方资庖刃投虚利，忽怆瓜时及代回。\n别袂醉分云共惨，去涂尘寂雪初培。\n剑光久已冲牛斗，力振沈埋尚愧雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屡雪","author":"韩琦","text":"欲识经冬气倍和，高穹回瞩念民瘥。\n尽搜秋夏乘龙起，并与寰区瑞雪多。\n是处玉峰开璧府，几番云浪溢银河。\n来牟定过前年麦，销得衰翁醉又歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪十十韵","author":"韩琦","text":"天宇昏凝幕，星潢冻漏津。\n报丰推上瑞，散利浃无垠。\n皓彩生和烛，深仁出化钧。\n乘时驱疠气，几日困疲民。\n满慰三农望，潜基万国春。\n道山谁辨玉，佛界普成银。\n缓舞疑翻佩，徐来类积薪。\n盘高擎露蕊，隙细入驹尘。\n易掩妖颜嫭，难藏厚地珍。\n坠轻时断续，势猛忽纷纶。\n肯使瑕瑜见，惟思沃瘠均。\n歌妍皆似郢，璧碎不因秦。\n辀冷侵驯鹿，符光逼琢麟。\n充盈是溪壑，挺特有松筠。\n近岭梅先发，濒江练更匀。\n楼台竞环丽，蟾兔起精神。\n病骨惊心怯，书帷忆旧亲。\n风流资醉目，豪放任诗人。\n陈阁方多暇，睢园喜命宾。\n宜城须大引，佳味过吴醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和张宗益工部初到相台书事","author":"韩琦","text":"园池开拓费经筹，雅意奚专自宴休。\n好事庶逢贤守继，康时聊便里民游。\n一闻公暇闲无敌，顿激归心浩不收。\n早晚再容怀绶乐，赤松高趣遂希留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"韩琦","text":"铜雀台边事少州，名郎来守喜安休。\n吾民正遂歌襦乐，我里甘忘衣锦游。\n诗笔入神春益健，宴杯穷赏夜方收。\n凤池时复思豪夺，争奈乡人欲借留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵和题休逸台","author":"韩琦","text":"昔年衣绣临吾乡，后圃力变池亭荒。\n井梁生涩卧耕壤，螺榭岌嶪营高冈。\n易为隅柱极增观，下视众岭森成行。\n锦鳞遂落闲者钓，谁喧歌酒台东堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和题休逸台","author":"韩琦","text":"台前风景无时良，台上之乐殊未荒。\n开筵真侣在蓬岛，练句美玉生昆冈。\n铜壶报刻缓星箭，金钗送酒排花行。\n铃斋长寂得吏隐，便是道家虚白堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答张宗益工部","author":"韩琦","text":"昔忝临漳守，娱心自退公。\n闲愁放天上，真境得壶中。\n燕处虽云适，规模惜未丰。\n恢园隳旧堞，困宇出新工。\n材品珍方用，花名异始充。\n泉分洹水堰，梁下邺城宫。\n今始推良牧，褒辞借病翁。\n笙镛谐庙瑟，珠玉满邮筒。\n讵敢矜前政，徒知偃下风。\n北堂留衣锦，西巘峻维嵩。\n休逸檐梢月，荣归浪衬虹。\n班条多暇日，清赏此何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残腊","author":"韩琦","text":"北土严凝气候偏，腊残池馆愈萧然。\n长河冰塞多寒地，密雪云繁三白天。\n妆点瑶林连雾凇，沈埋茵草未羊眠。\n但知催酿宜城酝，终见春芳次第妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政宫师张相公","author":"韩琦","text":"早谢枢衡贵，逍遥哂众愚。\n乐从黄卷得，游命赤松俱。\n风雅樽前事，云山世外娱。\n何妨紫虚下，散发伴樵苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答相州张宗益工部","author":"韩琦","text":"处暗频惊掷夜光，千金高价恨难偿。\n蟠桃入口知仙味，钧奏醒魂认帝乡。\n辩解重围思亹亹，战逢强阵怯堂堂。\n怀归自是衰疲甚，不为吾刚挫旧肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵答","author":"韩琦","text":"故人怜旧政，褒惜一何深。\n营葺推勤治，优闲称道心。\n池台资胜事，风月入高吟。\n酒户虽难角，诗盟已屡寻。\n词豪甘自屈，气锐敢轻侵。\n奇变云霞烂，冥搜海岳阴。\n暄和生嶰律，淡泊寄陶琴。\n但愧衰聋耳，安能别大音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥二月十五日","author":"韩琦","text":"倏忽韶光一半过，寒威犹尚压暄和。\n故摧春色欢终减，屡失花期日旋那。\n病骨不禁风料峭，衰悰难遏醉吟哦。\n凭栏更为芳菲惜，重取轻苫拥旧科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥寒食","author":"韩琦","text":"寒食春城是处花，唐贤诗好此难加。\n柳眉拖雾舒还皱，日脚萦云绽复遮。\n扢抓喜随膏雨解，鞦韆闲任綵绳斜。\n芳辰只愧樽前淡，妓版停歌不振牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明会压沙寺","author":"韩琦","text":"时节清明府事閒，压沙高会敞禅关。\n妓歌沈席摧莺舌，花影摇樽衒粉颜。\n春色满添膏泽后，人心和入醉游间。\n坐中尤觉风来好，白雪飞香混博山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同赏梨花","author":"韩琦","text":"兴福梨珍号素封，千株花发此欣逢。\n风开笑脸轻桃艳，雨带啼痕自玉容。\n蝶舞只疑残靥坠，月明唯觉异香浓。\n寻春已恨来伤晚，莫厌频挥潋滟钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又一阕","author":"韩琦","text":"花下延宾启宴杯，回头香雪即成堆。\n主人自挈宜城酿，不为青旗趁尔来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥上巳会许公亭","author":"韩琦","text":"修禊园林枕御津，宴亭轩豁足娱宾。\n羲皇治世舒长日，昆阆仙风烂熳春。\n脱俗且将诗送酒，纵吟须仗笔争神。\n会馀俯仰皆陈迹，不醉山阴定笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许公亭席上别镇帅吕公孺谏议","author":"韩琦","text":"元日津亭景物嘉，喜留轩驭弭高牙。\n棠阴共识思贤地，柳色偏伤赠别家。\n御水少陪乘兴棹，潭园难趁及时花。\n杯深莫拒勤拳意，去路音辉日日赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同赏牡丹","author":"韩琦","text":"国艳孤高岂自媒，寒乡加力试栽培。\n当时尚昧随和贵，今日真逢左魏开。\n名品已先推洛谱，梦魂唯恐失阳台。\n花王亲视风骚将，中的方应赏巨杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥三月十八日游御河二首 其一","author":"韩琦","text":"都人殚出集河湄，犹记从初放水时。\n三五已过修禊宴，浃旬行作送春诗。\n微波溅袜仙浮棹，曲岸当垆柳映旗。\n自笑遨头衰复病，也同欢俗恣追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛亥三月十八日游御河二首 其二","author":"韩琦","text":"从俗沿流辄命筵，平沙经雨润河壖。\n百泉遥派初来日，三月深春欲去天。\n夹岸绮罗香未散，几船弦管沸争前。\n波间无限能泅者，不信迎潮绝技先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游河遇雨","author":"韩琦","text":"开席临流雨骤侵，都人殊郁胜游心。\n侍娃不见尘生袜，农谷偏欣陇拔针。\n郢雪斗高闲未接，峡云争去杳难寻。\n无过却下船中坐，岂废衰翁醉又吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政赵少卿","author":"韩琦","text":"登科常愧处卢前，叙齿于兄小十年。\n鹤不乘轩犹自若，鸿谁能弋已安然。\n山头俗驾归诚晚，湖外扁舟见独先。\n惟有大钧公道在，方圆随物旧同甄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]