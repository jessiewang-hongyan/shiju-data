[{"title":"和景夔梅四首 其一","author":"张明中","text":"雪映横塘月浸阶，半扃庭户未全开。\n猛香特地清人骨，多谢溪风为送来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柽桐二首 其二","author":"张明中","text":"石榴安敢拟柽桐，借问司花也不中。\n鹤顶丹砂猩血服，试评却有此来红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柽桐二首 其一","author":"张明中","text":"百花耐久说柽桐，选甚薰风秋雨中。\n谁道花无红十日，此花日日醉潮红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶里桃花","author":"张明中","text":"折得蒸红簪小瓶，掇来几案自生春。\n珠唇绛口都开了，始信桃花解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公咏探春花二首 其二","author":"张明中","text":"海棠伎俩山茶色，未叶先花作么生。\n道是探春春已半，命名都不近人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公咏探春花二首 其一","author":"张明中","text":"飞琼将命下瑶台，欲探新春口未开。\n刚被东风留住著，却酡醉脸未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠红桃二首 其二","author":"张明中","text":"报我勤渠有木桃，肤腴密洒茜花膏。\n枯肠消得三十颗，只恐儿曹赋老饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠红桃二首 其一","author":"张明中","text":"朱雀窗间小小窥，诙谐儿子已心知。\n如何仙种今流落，万颗甘寒付阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋山茶示陈慧甫三首 其三","author":"张明中","text":"春风未晚凌霜叶，夜雨催开红玉花。\n绛雪腻酥犹未有，饥蜂瘦蝶漫交加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋山茶示陈慧甫三首 其二","author":"张明中","text":"檀心绛蕊压墙低，南海山根巧自移。\n浓艳未应输石醋，吹香底用倩风姨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋山茶示陈慧甫三首 其一","author":"张明中","text":"老叶莍红为怯冬，却将醉脸对东风。\n丹砂一夜匀千萼，造化如何不费工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝉二首 其二","author":"张明中","text":"抱叶吟风相后先，绿杨影里夕阳天。\n如何不管人孤寂，却把繁声暗里牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝉二首 其一","author":"张明中","text":"翅剪霜绡别样轻，腹饕风露有馀清。\n一泓池水两垂柳，彼此赓酬无限声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朱陵观三首 其三","author":"张明中","text":"不怪丰年屡足书，此乡民力看何如。\n依山靠岭都开垦，二岁为新三岁畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朱陵观三首 其二","author":"张明中","text":"一雨丝丝弄小春，物情何许旧还新。\n青枫忽换红装束，却笑松杉满面尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朱陵观三首 其一","author":"张明中","text":"攲窗飋飋漏风声，坏壁斜斜半草行。\n莫怨空斋对尘榻，碧油幢下是书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕二首 其二","author":"张明中","text":"乌衣国里未安渠，万里来从天一隅。\n道是能传香阁恨，来时曾到故乡无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕二首 其一","author":"张明中","text":"芹泥夹岸融融日，野水当门淡淡花。\n王谢堂前旧时客，如何肯访野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二日紫牡丹","author":"张明中","text":"见说西京有魏家，瑞云吹紫染芳华。\n移将万里豪门贵，幻出千枝倾国葩。\n新佩荷囊重渍色，更乘兰馥七香车。\n倡花野蕊都销尽，来配姚黄得共誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小亭前白牡丹","author":"张明中","text":"旧说花王称洛苏，洛苏还识此花无。\n紫绡层出黄金蕊，粉面仍看白玉肤。\n带雨含情挥泪重，迎风无力欲人扶。\n不堪老大浑无味，妒见渠侬美且都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白牡丹","author":"张明中","text":"看诗醉眼便醒苏，索句吟花一字无。\n虢国夫人呈素面，滕家仙子削琼肤。\n姚黄于后贪妖冶，魏紫逢君用夹扶。\n试问此花清白不，不闻吁咈只闻都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吉祥寺默轩","author":"张明中","text":"默识何销语话详，心斋也则坐能忘。\n如何孔氏家传底，却在高僧衣钵傍。\n并把禅机俱寂灭，不教妙理费商量。\n白云深锁轩前路，看尽金炉几篆香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延昌观道纪堂","author":"张明中","text":"马迁信史炳丹青，黄老搀先六籍名。\n清净元非人纪有，虚无幻出道家声。\n时挥麈尾谈天统，冷笑蝇头闹世情。\n待饮琼浆擗麟脯，芙蓉为馆玉为城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冷斋","author":"张明中","text":"雨湿桑枢夜不关，北窗谁更肯遮阑。\n冷侵砚滴浑无润，冻折诗眉未系寒。\n万里云容同水墨，四垂檐溜欲琅玕。\n梅花枝上春应到，袖手窗前子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到野寺","author":"张明中","text":"支杖寻春过小溪，小溪过了到招提。\n插天翠巘青丝幛，委地落花红绣泥。\n个里嚣尘都净尽，只馀啼鸟自东西。\n兴浓底用忙归去，莫管山衔晚日低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和书壁","author":"张明中","text":"平生蹇足愧蹒跚，流落荒凉强自安。\n边月一声秋雁切，江风五鼓漏花寒。\n青灯黄奶令人老，流水高山底处弹。\n须信穷通翻覆手，到头应不误儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈丞题阳家洞","author":"张明中","text":"溪缭飞虹听不潺，山雕翠玉望来寒。\n门墙面水临桥静，今古无虞枕自安。\n桐帽棕鞋非巧伪，花朝月夕几团栾。\n个中习尚元淳厚，论性空烦喻决湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔子梅","author":"张明中","text":"暖入孤根冷莫欺，冰魂幻出许多奇。\n轻霜弄粉清无涴，淡月浮香暗自知。\n莫管玉龙横吹晓，要陪鸾鉴巧妆时。\n作诗换取梅花好，未必梅花肯要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金凤花","author":"张明中","text":"妃子钗头小凤轻，飞来阑槛斗芳英。\n何曾枳棘栖留著，却傍梧桐雨露荣。\n浓紫鲜红兼瑩白，春暄夏热更秋清。\n冷斋尘榻空淹汝，不去秦楼作么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"活人","author":"张明中","text":"扁鹊仓公一笑还，顿令僵仆忽开颜。\n君于那处传衣钵，名与古人齐等班。\n直欲阴功垂后世，肯同流俗战蜗蛮。\n书生若得君医法，医国还同反掌间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋前红黄心芍药","author":"张明中","text":"斗绝山原春亦妍，一栏红药小池边。\n淡妆玉脸半醒醉，高拥檀心相后先。\n头重小垂娇眩日，肌明偏喜掩轻烟。\n如何客里生疏手，不折红香来几前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶簪绯桃","author":"张明中","text":"谁向南园剪腻云，胆瓶微浸两枝春。\n一家姊妹红装束，千种精神粉淡匀。\n只有低昂分大小，更无妍巧可俦伦。\n绮窗书僻浑无耐，唤取渠侬作上宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莺","author":"张明中","text":"柳接飞来影，花翻过后枝。\n金衣摇日色，簧口弄晴丝。\n游子错回首，何人涩小词。\n杨园好风景，莫与负佳期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢陈教授","author":"张明中","text":"倒峡词章了不难，气吞云梦有馀宽。\n社间宰相当推汉，圯下书生空念韩。\n倾盖金兰如旧契，把杯鱼水便相欢。\n诗肩耸折酬君贶，弄斧般门奚足看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢叔子阳丈惠诗","author":"胡宿","text":"老子诗名久废閒，喜君步骤少陵坛。\n句敲金玉声名远，韵险车斜心胆寒。\n倾出囊中和月露，皎如盘底走珠丸。\n苦藏难没诗家事，会看尘冠早一弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠三贤文集三首 其三","author":"张明中","text":"三子久埋没，遗文富百篇。\n冰涵心底鉴，雪释性中天。\n济楚鲤庭下，澜翻萤案边。\n著靴鬼为祟，容易复青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠三贤文集三首 其二","author":"张明中","text":"璧水还多士，文锋岂易戡。\n积分升以内，优占斗维南。\n天府荣登四，人材况有三。\n秀钟蕞尔地，如许富奇男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠三贤文集三首 其一","author":"张明中","text":"□□修藏日，干戈澒洞秋。\n诗文工雾縠，论议壮春流。\n潋水昔三子，庐陵旧一欧。\n自怜生已晚，不获与同游。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠诗","author":"胡宿","text":"君诗来贶我难当，语带诚斋句妙香。\n鲛室垂垂新下泣，蚌珠颗颗烂生光。\n魂飞锦里花争巧，梦到池塘草又芳。\n早晚交游逢大手，急将名姓为传扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶","author":"张明中","text":"揽得风光忘却愁，千葩万蕊恣追游。\n香须点染黄金湿，小翅轻翻白玉柔。\n舞态恨渠春昼短，狂情不管好花羞。\n腻酥绛雪都相识，莫向红窗绣室休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"澹轩","author":"张明中","text":"主张老氏欲何求，恬澹中间觅自由。\n直把冲虚超俗界，何须刍豢作嘉羞。\n满怀明月黄庭古，一段清风白帝秋。\n载咏此轩新句子，羡君杰出道家流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠杨山人","author":"张明中","text":"有客针磁觅秀峰，展松高识可追风。\n掌中诀是眼中法，天上仙为地上翁。\n不向个边求指顾，更于何处访穷通。\n荷囊金紫无难致，莫问肥家金粟红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回乡偶书","author":"张明中","text":"不见眉间半点黄，花开花落总他乡。\n子规偏向三更月，唤起愁人也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拒霜二首 其二","author":"张明中","text":"九月清霜可拒哉，芙蓉刚欲拒霜开。\n不知拒著清霜后，还有三冬傲雪材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拒霜二首 其一","author":"张明中","text":"天与司花细细论，秋花虽是殿花军。\n拒霜假得后凋操，造化岂容先策勋。\n浓著胭脂潮醉晕，蹙成玉板摺裙纹。\n游蜂识尽千红紫，只这寒芳竟不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟盘","author":"张明中","text":"君不见夹谷伯图方凑辐，英雄摧挫俳优戮。\n又不见金谷妙歌翻绮縠，到头也则贻羞辱。\n尽渠富贵莫拟伦，岂如李愿归盘谷。\n君今筑台名拟盘，看尽浮云几翻覆。\n茂林修竹同岁寒，明月清风伴幽独。\n抱琴高卧西窗红，哦诗更尽杯中绿。\n双蜗蛮触战方酣，藜杖逍遥巾一幅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邻笛","author":"张明中","text":"璧云和云两不移，一天染就碧玻璃。\n生憎哽咽邻家笛，彼自追欢我自悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欧阳新卿赋薇药","author":"张明中","text":"东皇又罢调春手，花飞十不啻八九。\n不论韦曲与少城，卸尽锦机忍回首。\n唯馀芍药不搀先，却与蔷薇相争妍。\n小栏逼束恣娇姹，高架支撑尽蔓延。\n倡花冶蕊都妆靓，赢得先开不相见。\n若令环列见倾城，羞杀群芳争掩面。\n瑞云吹紫染二葩，只让西京一魏家。\n新佩荷囊重渍色，更乘兰馥七香车。\n主人寿乐献寿觞，哦诗都带花边香。\n看来诗胞云梦豁，只愁拶破古锦囊。\n昨宵点滴山间雨，弄晴剩著花上露。\n主人晓起试吸将，便得长生之妙处。\n醉潮玉颊十分红，主人与花恰相同。\n兴来持酒绕艳丛，更折繁枝簪席东。\n看花醉眼未惺松，忽然跳入花蕊宫。\n寿仙喜与花仙逢，更入太史滑稽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郭落成新宅","author":"张明中","text":"人言创业世所难，我谓守成宁易得。\n守成创业并二难，况以守成而建宅。\n翼翼翚飞奂且轮，均输殚巧断云斤。\n晴岚暖翠十分好，水镜山鬟四序新。\n子仪甲第在何许，匆此巍峨基千古。\n诸郎他日到凤池，便是潭潭公相府。\n嘉宾满座酒盈樽，常棣怡怡堂上春。\n书生无物表贺成，袖有新诗聊当野人芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋楼之西有木花","author":"张明中","text":"密荫繁枝覆檐额，万蕊千葩描不得。\n晚风不动日微烘，游蜂成阵香成国。\n野花有史说山矾，尺许来高尘土间。\n树头初拆千脐麝，花女吹香宁复悭。\n试登楼上凭阑看，花与诗人忽为伴。\n恍疑身在广寒宫，笑折一枝归几案。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真帅","author":"张明中","text":"也不学肉作台盘与屏风，自然席上浮春容。\n也不学论功封侯为羹颉，无妨门外多车辖。\n看来不俭亦不丰，知渠别有个家风。\n嚅哜吾道为殽核，脍炙人口有诗筒。\n要知应酬任真意，略去繁文并缛礼。\n尽渠世态谩炎凉，真帅堂中蜀君子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔷薇","author":"张明中","text":"长养风来新样凉，蔷薇娇姹靓浓妆。\n贵妃得酒沁红色，更著领巾龙脑香。\n万花卸尽锦机空，留得蔷薇揖晓风。\n剩把胭脂匀笑靥，不施铅粉涴潮红。\n东君来与夏交割，西子出为春送终。\n不是□□閒暇客，也拚终日对芳丛。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静室","author":"张明中","text":"当年梁武造佛寺，子云飞帛书萧字。\n李君得字煨烬中，建立小室有深意。\n如今静室傍花岩，此室比心为一致。\n峰峦底里著轩窗，明月清风为谁至。\n三千世界阔如许，杂遝喧嚣鼎方沸。\n铜炉添穗坐结趺，更倩白云锁苍翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题活人堂","author":"张明中","text":"臞仙浩养蓬莱山，炼成九转黄金丹。\n丹成不忍都餐饵，刀圭留得活人间。\n上池之水君曾饮，咄嗟取效千仓廪。\n祝君更学宝藏公，两月超迁到三品。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾运使水亭","author":"张明中","text":"笥山之水磨铜绿，秀气都在山之麓。\n就中卜筑小仙居，面面轩亭看不足。\n主人倒屣浮春容，囊诗拶破古锦红。\n书生幸有登龙便，愿到坛边揖下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠曾五行","author":"张明中","text":"洪水滔天泛滥秋，鲧汩五行贻帝忧。\n禹膺天锡箕释囚，洪范五行著九畴。\n尔后星家几者流，车载斗量二百州。\n是中谈吐俱悠悠，曾君独可古人俦。\n逢人何许便相投，祸福累累龟告犹。\n许我诗书晚到头，盐车宁久伏骅骝。\n异时果若斯言酬，看君羲和职里独步运星筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠棋客黄尤工象棋","author":"张明中","text":"黑甜政饱谁剥啄，手提楸枰敲软玉。\n浩浩胸中龙虎韬，冷笑局边人射鹄。\n粤昔尝闻黄石公，圯桥一卷岂易通。\n报韩孺子未传者，秘谋犹有在江夏。\n君今寓意在弈棋，计画何止六出奇。\n长驱席卷容易取，不羡宣城与别墅。\n皇家今欲复土疆，烦公赤手缚鬼章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 灯花","author":"张林","text":"白玉枝头，忽看蓓蕾，金粟珠垂。\n半颗安榴，一枝秾杏，五色蔷薇。\n何须羯鼓声催。\n银釭里、春工四时。\n却笑灯蛾，学他蝴蝶，照影频飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐多令","author":"张林","text":"金勒鞚花骢。\n故山云雾中。\n翠蘋洲、先有西风。\n可惜嫩凉时枕簟，都付与、旧山翁。\n双翠合眉峰。\n泪华分脸红。\n向尊前、何太匆匆。\n才是别离情便苦，都莫问、淡和浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其十","author":"张枢","text":"紫阁深严邃殿西，书林飞白揭宸奎。\n黄封缴进升平奏，直笔夫人看内批。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其九","author":"张枢","text":"回廊隔树帘帘捲，曲水穿桥路路通。\n禁漏滴斜花外日，御香薰暖柳边风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其八","author":"张枢","text":"银簧乍靘参差竹，玉轴新调尺合弦。\n奏罢六么花十八，水晶帘底赐金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其七","author":"张枢","text":"晚凉开院近中秋，香染金风倚桂楼。\n花月新篇初唱彻，内人传旨索歌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其六","author":"张枢","text":"灿锦堂西过夕阳，水风吹起芰荷香。\n内监催扫池边地，准备官家纳晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其五","author":"张枢","text":"笙歌散后归深院，花柳阴中过曲廊。\n静掩金铺三十六，黄昏处处爇衙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词十首 其四","author":"张枢","text":"翠枝斜插滴金花，特髻低蟠贴水荷。\n应奉人多宣唤少，海棠花下看飞梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]