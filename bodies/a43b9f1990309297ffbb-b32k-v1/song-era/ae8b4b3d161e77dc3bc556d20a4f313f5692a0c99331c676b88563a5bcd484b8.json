[{"title":"张子仪太社折送秋日海棠二首 其二","author":"杨万里","text":"木蕖篱菊总无光，秋色今年付海棠。\n为底夜深花不睡，翠纱袖上月和霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张子仪太社折送秋日海棠二首 其一","author":"杨万里","text":"新样西风较劣些，重阳还放海棠花。\n春红更把秋霜洗，且道精神佳不佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张仲良久约出郊以诗督之二首 其一","author":"杨万里","text":"百花亭下花如海，子厚宅前溪似油。\n幕下风流法曹掾，坐窗犹未作遨头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张仲良久约出郊以诗督之二首 其二","author":"杨万里","text":"只道今春不肯晴，已晴谁遣不郊行。\n忍违花底提壶语，不虑屋头鸠妇鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张尉惠诗和韵谢之三首 其三","author":"杨万里","text":"老去才情半掬悭，不愁不退岂愁前。\n清风明月无拘管，与子分张更一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张尉惠诗和韵谢之三首 其二","author":"杨万里","text":"软红尘里眼曾开，苦被新诗猛唤回。\n借问锦心能底巧，更从月胁摘将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张尉惠诗和韵谢之三首 其一","author":"杨万里","text":"下笔生波便百川，字间句里总超然。\n读来清气凉人骨，六月真成九月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忧患感叹二首 其一","author":"杨万里","text":"醉里还多感，醒来却更愁。\n醉醒都不是，愁感几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀山庄子仁侄二首 其二","author":"杨万里","text":"吾家小阮未西归，日日相从郡圃嬉。\n黄菊拒霜今笑我，先生也有独来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀山庄子仁侄二首 其一","author":"杨万里","text":"危亭独上忽徬徨，欠个山庄堕我傍。\n却是向来相聚日，老怀未解忆山庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"折花","author":"杨万里","text":"指似青童折海棠，繁枝仍要艳花房。\n痴眉騃眼生疏手，颤脱花房闷一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"攸山望石臼湖","author":"杨万里","text":"雨中深闭轿窗纱，惊见孤光射眼花。\n一顾平湖山尽处，碧铜镜外走青蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旱后喜雨四首 其四","author":"杨万里","text":"密洒疏飘尽自由，通宵到晓未须休。\n平生愁听芭蕉雨，何事今来听不愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旱后喜雨四首 其三","author":"杨万里","text":"竟夏兴云只苦风，入秋今雨稍宜农。\n怪来霹雳轰枯树，知向前山起卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旱后喜雨四首 其二","author":"杨万里","text":"检校西畴首忍回，雨佳小恨较迟来。\n抄云淅玉何曾梦，只拟禾孙作粥材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旱后喜雨四首 其一","author":"杨万里","text":"云头造次便能开，雨脚商量半欲来。\n旧日催诗元要雨，如今雨却索诗催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李与贤来访自言所居幽胜甚似剡溪因以似剡名其庵出闲居五咏因次其韵五首 其五","author":"杨万里","text":"漫浪江湖天一方，故人不见两三霜。\n对床说尽平生话，黄叶声中秋夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李与贤来访自言所居幽胜甚似剡溪因以似剡名其庵出闲居五咏因次其韵五首 其四","author":"杨万里","text":"见说幽居绕万松，栽梅能白杏能红。\n人行剡曲溪山里，家住辋川图画中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李与贤来访自言所居幽胜甚似剡溪因以似剡名其庵出闲居五咏因次其韵五首 其三","author":"杨万里","text":"溪上新桥是凤林，残风剩雨做秋阴。\n先生小试南风手，写得一川山水音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李与贤来访自言所居幽胜甚似剡溪因以似剡名其庵出闲居五咏因次其韵五首 其二","author":"杨万里","text":"山似剡溪溪似油，人如诗句句如秋。\n无边春里花饶笑，有底忙时草唤愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李与贤来访自言所居幽胜甚似剡溪因以似剡名其庵出闲居五咏因次其韵五首 其一","author":"杨万里","text":"玉壶冰段露金茎，未抵闲居五咏清。\n休道曹诗成七步，不须三步已诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李花","author":"杨万里","text":"李花宜远更宜繁，惟远惟繁始足看。\n莫学江梅作疏影，家风各自一般般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨花","author":"杨万里","text":"只道垂杨管别离，杨花一去不思归。\n浮踪浪迹无拘束，飞到蛛丝也不飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"极暑题钓雪","author":"杨万里","text":"暑中北阁望南窗，将谓南窗分外凉。\n到得南窗还更热，芙蕖和蕊落幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沙溪江亭","author":"杨万里","text":"渔舟竟日不知还，水碓无人也不闲。\n斫却江头一丛柳，当愁无地著江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皂角林","author":"杨万里","text":"水漾霜风冷客襟，苔封战骨动人心。\n河边独树知何木，今古相传皂角林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"社雨","author":"杨万里","text":"时节从来好雨知，今朝社日顿霏微。\n落花只得春风舞，湿却残香不得飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芙蓉盛开戏简子文克信","author":"杨万里","text":"芙蓉得雨一齐开，开尽秋花客不来。\n到得客来花已老，晚妆犹可两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉三首 其三","author":"杨万里","text":"檐牙窗额两三株，只欠王维画雪图。\n开卷不题元字脚，碧窗圜蜡有如无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉三首 其二","author":"杨万里","text":"萧萧洒洒复婷婷，一半风流一半清。\n不为暑窗添午荫，却来愁枕作秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉三首 其一","author":"杨万里","text":"骨相玲珑透八窗，花头倒挂紫荷香。\n绕身无数青罗扇，风不来时也不凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花下夜饮","author":"杨万里","text":"夜深移入小杯盘，回首花枝不忍看。\n岂与海棠情分薄，老夫自是怯春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花果","author":"杨万里","text":"野花山果绝芳馨，借问行人不识名。\n蜂蝶行粮猿鹤饭，一生口分两无争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其五","author":"杨万里","text":"红红紫紫尽纭纭，韵处终输庾岭君。\n未说玉花冰雪骨，新阴先绿半春云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其六","author":"杨万里","text":"常年十月未花开，雪片今年九月回。\n便有早梅随早雪，一枝笑看万花摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其四","author":"杨万里","text":"梅诗脱口已流传，要趁梅前更雪前。\n唤醒诚斋山里梦，落英如雪枕砖眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其八","author":"杨万里","text":"老见千花眼便昏，忆梅长为赋招魂。\n只今身住西湖上，不羡淮南岭上村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其一","author":"杨万里","text":"健青新走一梢长，外日东风引得狂。\n定自今番春色里，新枝别样占年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其二","author":"杨万里","text":"年年春信遣人疑，赚出诗人枉觅诗。\n著意探梅偏不发，月斜偶见一横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其七","author":"杨万里","text":"今岁略无霜报寒，忽然一夜雪漫漫。\n雪花要作梅花地，十月早梅和雪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其十","author":"杨万里","text":"老懒狂吟不要工，爱君七字晋唐风。\n更烦传语梅花道，火急齐开小至中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其三","author":"杨万里","text":"騃女痴儿总爱梅，道人衲子亦争栽。\n何如雪后琼瑶迹，印记诗人独自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔和张功父玉照堂十绝句 其九","author":"杨万里","text":"玉照堂中瀹早茶，下临溪水织纹纱。\n十诗小试春风手，催发溪梅两岸花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔送济翁弟过浙东谒丘宗卿二首 其二","author":"杨万里","text":"若见丘迟问老夫，为言臞似向来臞。\n更将双眼寄吾弟，带去稽山看鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔送济翁弟过浙东谒丘宗卿二首 其一","author":"杨万里","text":"出省还家思已昏，答书见客腹仍烦。\n政愁独酌无佳客，家里诗人忽扣门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛酉正月十一日东园桃李盛开","author":"杨万里","text":"千万重山见复遮，两三点雨直还斜。\n行穿锦巷入雪巷，看尽桃花到李花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近峡","author":"杨万里","text":"望峡初愁远，当前忽不知。\n如何船进处，却在棹停时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近腊暄甚","author":"杨万里","text":"霜日知春有信归，腊前偷暖漏春晖。\n北风也剪寒梢叶，吹作鹅黄乱蝶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"进贤初食白菜因名之以水精菜云二首 其二","author":"杨万里","text":"江西菜甲要霜栽，逗到炎天总不佳。\n浪说水菘水芦菔，硬根瘦叶似生柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"进贤初食白菜因名之以水精菜云二首 其一","author":"杨万里","text":"新舂云子滑流匙，更嚼冰蔬与雪齑。\n灵隐山前水精菜，近来种子到江西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远树","author":"杨万里","text":"行行远树惨无聊，脱尽清阴只有梢。\n霜干瘦来无可庇，更能庇得鹭鸶巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连日二相过史局不到省中后园杏花开尽","author":"杨万里","text":"史馆频催史笔迟，道山还解有忙时。\n后园两日不曾到，开尽杏花人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰三月二日发船广州来归亭下之官宪台","author":"杨万里","text":"诗人政坐爱闲游，天遣南游天尽头。\n到得广州天尽处，方教回首向韶州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰六月立秋后暮热追凉郡圃二首 其二","author":"杨万里","text":"夏欲尽头秋欲初，小凉未苦爽肌肤。\n夕阳幸自西山外，一抹斜红不肯无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰六月立秋后暮热追凉郡圃二首 其一","author":"杨万里","text":"上得城来眼顿明，暮山争献数尖青。\n垂杨舞罢西风叶，一叶多时独未停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居初夏午睡起二绝句 其二","author":"杨万里","text":"松阴一架半弓苔，偶欲看书又懒开。\n戏掬清泉洒蕉叶，儿童误认雨声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其十二","author":"杨万里","text":"风力掀天浪打头，只须一笑不须愁。\n近看两日远三日，气力穷时会自休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其十一","author":"杨万里","text":"大风动地卷波头，索酒频添醉未休。\n不判明朝教作病，却图今夕要忘愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其十","author":"杨万里","text":"南人方理北归舟，北地风来便作愁。\n不道北船等多日，北风不作不成休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其九","author":"杨万里","text":"船上犹馀一日粮，湖心粮尽籴何乡。\n仙家辟谷从谁学，明日无炊即秘方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其八","author":"杨万里","text":"湖心何许有人烟，上下双天两点山。\n犬吠鸡鸣四船里，旋成水国一家村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其七","author":"杨万里","text":"新诗哦罢倦来眠，蝴蝶飞游八极边。\n船外风涛如霹雳，一声不到睡乡天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其六","author":"杨万里","text":"一风抛起万琼楼，几子康郎总掉头。\n莫怕浪高洲尽没，海船下碇并无洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其五","author":"杨万里","text":"书策看来已觉烦，诗篇厌了更休论。\n客心未便无安顿，试数油窗雨点痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其四","author":"杨万里","text":"问来邬子到南康，水路都来两日强。\n屈指行程谁道远，如今不敢问都昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其三","author":"杨万里","text":"一夜颠风翻却天，簸将白浪到天边。\n康郎尚自无根脚，斗大洲头却系船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其二","author":"杨万里","text":"同列诸公总劝予，归时切莫过重湖。\n婺源五岭祁门峡，今是危涂是坦涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷歌行十二首 其一","author":"杨万里","text":"山行旧路不堪重，及汎湖波又阻风。\n世上舟车无一稳，乾坤可是剩诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风钟家村观岸傍物化二首 其二","author":"杨万里","text":"壳如蝉蜕湿仍新，那复浮嬉浪底春。\n却把今身飞照水，不知石上是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风钟家村观岸傍物化二首 其一","author":"杨万里","text":"水虫才出绿波来，细看爬沙上石崖。\n化作蜻蜓忽飞去，几时飞去却飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风泊钟家村离英州已三日才行二十里二首 其二","author":"杨万里","text":"满船儿女厌江行，我爱江行怕入城。\n惭愧风师教款曲，为分一舍作三程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风泊钟家村离英州已三日才行二十里二首 其一","author":"杨万里","text":"南游端为看山来，过眼匆匆首屡回。\n不是阻风船不进，何缘看尽万崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饭罢散策遇细雨二首 其二","author":"杨万里","text":"极知秋旱已难医，所喜阴云忽四垂。\n毕竟不成檐半滴，辛勤枉费雨千丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饭罢散策遇细雨二首 其一","author":"杨万里","text":"秋暄团扇尚堪携，病脚朝来健似飞。\n偶到溪头晴唤出，未穷山顶雨催归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸠衔枝营巢树间经月不成而去","author":"杨万里","text":"鸠妇那知自不材，树阴疏处起楼台。\n可怜积木如山样，一桷何曾架得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麦田","author":"杨万里","text":"无边绿锦织云机，全幅青罗作地衣。\n个是农家真富贵，雪花销尽麦苗肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]