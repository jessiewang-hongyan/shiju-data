[{"title":"别武夷途中偶成寄观妙法师","author":"李纲","text":"道妙观来物物通，武夷仙境幸相逢。\n溪流玉雪三三曲，山锁云霞六六峰。\n去路归鞍方眷恋，淡烟疏雨正蒙茸。\n羡师日在神仙窟，回首岩峦紫翠重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题观妙师阁皂山旧隐观云轩","author":"李纲","text":"独搆幽轩福地阴，飞云对面起青岑。\n但知映日能成色，谁信崇朝解作霖。\n苒苒行云宁有迹，霏霏出岫本无心。\n道人默坐观舒卷，至理应符妙意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇安令朱邈公达送示武夷图因成绝句","author":"李纲","text":"秀气蜿蜒作武夷，岩峦窈窕白云飞。\n再游未尽平生兴，六幅生绡画得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自分水岭过江南","author":"李纲","text":"行尽闽山万屈盘，江南形势陡然宽。\n山平水远望不尽，木落草枯霜始寒。\n醉里讴吟聊自适，梦中往复本非难。\n谁言春信年年早，笑指江梅试折看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山约高无咎同游石井","author":"李纲","text":"岩洞嵌空凿翠崖，一泓云液贮琼瑰。\n幽人须信耽泉石，茗饮相招特特来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自铅山迂路至吴园","author":"李纲","text":"迂路入江南，寒烟锁翠岚。\n清晨游石井，薄暮宿了岩。\n月冷不成梦，鸡号还整骖。\n吴园才数舍，去去指龙潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴园","author":"李纲","text":"当时亲迎到吴园，屈指重来十七年。\n身世恍然如一梦，从今归去老林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题月岩","author":"李纲","text":"广寒宫殿寄幽岩，忌满非缘玉斧戡。\n皓魄半轮横道左，清光千古照江南。\n阴精凝结元无质，神化胚胎岂易探。\n好是月华生碧落，扶疏桂影远相参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿黄藤驿","author":"李纲","text":"古驿号黄藤，休鞍夜已灯。\n溪寒水清浅，山瘦石棱层。\n豪客路方阻，岁寒阴始凝。\n开怀惟仗酒，独酌醉瞢腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弋阳道中","author":"李纲","text":"南去北来皆岁暮，流年苒苒过光阴。\n江南须信风烟好，浙右方虞寇盗深。\n云外山深横笔格，月中滩响叠琴心。\n卧龙三顾今寥落，抱膝空为梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望龟峰","author":"李纲","text":"饶阳景物犹武夷，岩石崛起多瑰奇。\n此峰厥状更诡异，举首曳尾如灵龟。\n穹隆曝甲正霜晓，蹒跚引气当晴晖。\n故知造化巧凝结，欲问所以良难推。\n我疑龙伯钓溟渤，六鳌连引背负归。\n中途遗一尚赑屃，直欲赴海冠峨巍。\n又疑清江使河伯，波涛相失留于斯。\n化为巨石峙千古，虽欲钻灼无由施。\n茫茫神怪不可诘，但使风景增清辉。\n我来闽岭厌山水，见此还复伸双眉。\n颇嗟行役不果到，侧身西望生长悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鸣山驿次韵蔡君谟续梦作","author":"李纲","text":"一梦神游紫府天，觉来身寄驿亭眠。\n何须怅望吹箫女，独跨青鸾入翠烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿安仁云锦堂","author":"李纲","text":"一宿溪边云锦堂，烟村浮动野梅香。\n沙平水澹近江浦，天阔山遥多夕阳。\n北陆寒凝风眇眇，东吴音断意茫茫。\n片言无补空来往，赢得萧条两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馀干","author":"李纲","text":"岁寒迂路过江乡，叹息飞蓬堕渺茫。\n云锦洞深烟水远，琵琶洲转暮滩长。\n田园归去荒三径，金鼓传闻震一方。\n极目东吴何处是，断霞轻霭落残阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚行","author":"李纲","text":"岁杪旅怀恶，驱车残照中。\n暮云千里碧，落日半轮红。\n掠水起行雁，隔林闻远钟。\n休鞍僧舍闲，皓月又生东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题安国寺翠玉亭呈平老","author":"李纲","text":"兰若何年种碧瑜，凌霄高节笑楸梧。\n渭川谩说三千亩，杜牧宜誇十万夫。\n月舞清阴金影碎，风敲幽韵玉音敷。\n烦师长养休斤斧，试问江南有此无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题仁义驿岁寒堂范文正公所植六松","author":"李纲","text":"江驿森森六本松，蜿蜒枝干走虬龙。\n烟滋鳞甲苍颜老，云惹须髯美荫浓。\n独立雪霜君子操，曾因风雨大夫封。\n不栽桃李追时好，叹息前贤意可宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻浙东方寇大作道路不通迂路由江南以归有感二首 其一","author":"李纲","text":"理装适吴会，避寇由江滨。\n宁知治安世，乃作途穷人。\n风涛岂不险，舟楫尚可因。\n失身入畏涂，难以理义陈。\n平生笑子美，逃乱走踆踆。\n如今翻自笑，亦须谋此身。\n此身何足惜，上有高年亲。\n骨肉几百口，干戈已相邻。\n以我此日心，知彼无辜伦。\n安得济川舟，载之适通津。\n徙置安乐土，不知战斗尘。\n已矣可奈何，愿为太平民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻浙东方寇大作道路不通迂路由江南以归有感二首 其二","author":"李纲","text":"东南久无备，盗贼起不虞。\n揭竿与荷锄，皆是耕田夫。\n谁为捕逐者，得官缘苞苴。\n不读一行字，况复知孙吴。\n厥初既轻敌，屡北辄睢旴。\n屯兵非不多，一扫不复馀。\n虎兕出于柙，是谁之过欤。\n凶焰陵郡县，良民遭戮屠。\n坐令腹心地，化为豺豕区。\n除恶当务早，滋蔓良难图。\n王师何日出，努力观庙谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童子驿见梅花 其一","author":"李纲","text":"天滑云腴凝不流，岁寒迂骑过南洲。\n黄昏孤馆沈吟处，赖有江梅慰客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童子驿见梅花 其二","author":"李纲","text":"江南为客见江梅，似为行人特特开。\n数点枝头凝玉雪，隔窗和月送香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题 其一","author":"李纲","text":"霜风响枯林，旷野惨寒色。\n川路阻且长，客子方远适。\n东吴眇何在，仰羡归飞翼。\n惟有溪边梅，犹能慰愁寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题 其二","author":"李纲","text":"水落潮乾人取途，西风索索响黄芦。\n沙头惊起数行雁，恰似旧藏芦雁图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题建德县开化寺","author":"李纲","text":"路绕江南烟水村，梅花的皪正销魂。\n峰峦影里过山邑，鼙鼓声中念故园。\n残腊未曾看雪舞，劲风何事扫云屯。\n拙翁自笑平生拙，欲叩天阍更一言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题紫岩驿","author":"李纲","text":"稚年曾向此途行，半世重来若泛萍。\n山径车声欣路坦，江村市合厌鱼腥。\n连天霜草萧萧白，蟠岭云松郁郁青。\n久旅怀家归尚远，暮烟残照宿邮亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠池守张闳道","author":"李纲","text":"绣衣执法出霜台，邂逅还如特特来。\n华省旧曾陪笑语，清溪今复接樽罍。\n喜公笔有江山气，顾我心如世味灰。\n天下苍生待经济，坐看蟠蛰起春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同天宁聪老游齐山次杜牧之韵","author":"李纲","text":"东风初起白云飞，禅客相邀步翠微。\n童稚旧游如梦到，江山今幸假途归。\n岩峦窈窕笼轻霭，鸥鹭翩翻舞夕晖。\n归觐庭闱询往事，箧中先整老莱衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题弄水亭","author":"李纲","text":"萧条秋浦景如秋，谁信猿声使客愁。\n烟树森森连远峤，水田漠漠集飞鸥。\n高楼吹角增离恨，古驿停骖忆旧游。\n亦欲题诗江祖石，谪仙遗迹最风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自池口登舟","author":"李纲","text":"水落溪乾不可舟，春潮理棹浅沙头。\n多风烟浪鳞鳞起，欲雪江云苒苒浮。\n涉险物情终共畏，临流归兴浩难收。\n波神借我风帆便，鼓柁清江汗漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其一","author":"李纲","text":"理棹适江干，初欣眼界宽。\n日蒸江气白，风约橹声寒。\n蒋诩谋新径，钟仪只旧冠。\n浮云休蔽日，直北是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其二","author":"李纲","text":"春江彻底清，沙尾见潮生。\n朝气嘘成雾，南风战作晴。\n岸移看树远，船稳信波平。\n览尽江山胜，还悲万古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其三","author":"李纲","text":"渺渺春江稳，融融午睡腴。\n梦回双橹急，望极片帆孤。\n皱水风还逆，维舟日欲晡。\n云中有行雁，苒苒下平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其四","author":"李纲","text":"春光摇画鹢，江影浸长天。\n浪势随潮急，涡痕逐橹圆。\n避风依岛屿，防寇问人烟。\n深念还愁绝，高歌且醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其五","author":"李纲","text":"江阔水云暮，风高舟楫停。\n落帆归别浦，宿雁集回汀。\n霜苇萧萧白，烟岚朵朵青。\n夜来江色静，寒浴一天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其六","author":"李纲","text":"朝来问风信，五两向南飞。\n旅泊添春恨，舟行与愿违。\n瓶梅空的的，岸柳已依依。\n寂寞江南路，那知自此归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其七","author":"李纲","text":"春江望不极，惨淡起层阴。\n烟雨濛濛湿，云涛渺渺深。\n怀家千里意，报国一生心。\n叹息知音少，空为梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其八","author":"李纲","text":"晚泊铜陵口，烟村八九家。\n岸沙崩浪响，江雨带风斜。\n泛泛浮波雁，捎捎接翅鸦。\n无情东注水，对尔叹年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其九","author":"李纲","text":"杳杳楚天阔，悠悠江浦清。\n便风帆腹满，顺水橹腰轻。\n烟澹山逾碧，云高雨易晴。\n无心问渔父，浊酒慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行十首 其十","author":"李纲","text":"春到江波绿，潮来浦溆深。\n晓风看五两，家信抵千金。\n笑读谪仙句，病为庄舄吟。\n世途游历遍，归去老山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游五松山观李太白祠堂","author":"李纲","text":"大江东南流，鼓柁江水上。\n薄游五松山，获见谪仙像。\n呜呼天宝间，治乱如反掌。\n兵戈暗中原，豪杰多长往。\n谪仙当此时，逸气隘天壤。\n脱身来江东，缥渺青霞赏。\n作诗几千篇，醉笔笼万象。\n迄今有遗祠，识者共瞻仰。\n嗟予岂后裔，愚拙谁复尚。\n珥笔玉殿螭，谪官闽岭瘴。\n荷恩许生还，冒险理归桨。\n于焉觌仙风，足以慰遐想。\n愿言继清芬，何由揖英爽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中读书有感","author":"李纲","text":"渺渺波涛淅淅风，此身忽在大江东。\n浮家泛宅云烟里，思古伤今图史中。\n盗贼从来能伺衅，治安自昔戒除戎。\n我今惟愿兵戈息，归作梁溪老钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铜陵阻风","author":"李纲","text":"春色到江渚，梅花正断魂。\n风波留远棹，烟雨湿寒村。\n雁过传遗响，潮来没旧痕。\n凄凉一樽酒，愁绝与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题护法寺瑛老默堂","author":"李纲","text":"维摩丈室何年设，满目江山自风月。\n道中试露默中机，千偈澜翻本无说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵和瑛老颂","author":"李纲","text":"默堂前对五松山，敌面机锋一瞬间。\n禅客相逢休拟议，草鞋价直欲谁还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自铜陵行四十里风复作泊江北岸地名散潭属淮南 其一","author":"李纲","text":"襟带江淮一望间，夕阳舣棹散潭湾。\n波涛汹涌暮天阔，鸥鹭飘飖渔艇閒。\n风壮又还依北渚，云深不复见南山。\n浙河千里何时到，过去飞鸿不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自铜陵行四十里风复作泊江北岸地名散潭属淮南 其二","author":"李纲","text":"镜中渐觉鬓丝多，半世劳生可奈何。\n极望不来青足鸟，满江更起白头波。\n扬帆贾客风前笛，撒网渔人月下歌。\n自断此生甘寂寞，毗耶归作老维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自铜陵行四十里风复作泊江北岸地名散潭属淮南 其三","author":"李纲","text":"平生性酷爱江山，今日江山满目前。\n明月清风人寂寂，淡烟轻霭露涓涓。\n波声撼岸连淮壤，雁阵惊寒入楚天。\n慨念往来成底事，一杯浊酒且安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春睡 其一","author":"李纲","text":"半生游宦鬓毛霜，依旧图书对晓窗。\n卯酒一杯春日暖，卧听鸣橹下清江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春睡 其二","author":"李纲","text":"居士终朝只念归，日行百里尚嫌迟。\n小窗春梦分明到，叹息啼乌唤觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜泊繁昌","author":"李纲","text":"系缆繁昌口，清江夜渺然。\n寒星随浪闪，孤月向人圆。\n汉渚乘槎客，云川控鲤仙。\n何须论往事，且泛碧波船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试九华朱觐墨","author":"李纲","text":"九华山顶老松烟，名重初因玉局仙。\n样古法精圭并制，胶清煤馥玉同坚。\n试将毛颖轻轻染，须遣陶泓细细研。\n居士年来无恋著，惟于三子欲逃禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"未至芜湖四十里阻风","author":"李纲","text":"一夜寒云凝不开，北风吹雨带潮来。\n涛翻天末银山涌，浪打沙头霹雳摧。\n心在浙西音断绝，身留江左意徘徊。\n无聊独酌开怀抱，赖有窗间数点梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草宰执书论方寇事戏成","author":"李纲","text":"江浙巨盗起，东南皆震惊。\n王师殊未出，赤子若为情。\n试赠绕朝策，愿飞燕将城。\n非因肉食鄙，只欲庙谟成。\n汲黯复妄发，终军思请行。\n怀亲寸心急，报国一身轻。\n曹刿亦问战，申胥还乞兵。\n群公佐天子，努力剪鲵鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元舟中有感","author":"李纲","text":"前年扈清跸，玉辇临端门。\n鳌山綵构耸，露台歌吹喧。\n去年谪沙阳，旅泊亦游观。\n士女隘衢巷，灯火满溪山。\n今年过江南，舣舟烟水湾。\n风高不可进，极目云涛翻。\n蜜炬照独酌，红炉凌夜寒。\n感事心欲折，强歌声无欢。\n坐看江边月，飞上青云端。\n清光不改旧，对我还团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐 其一","author":"李纲","text":"春夜沈沈灯影明，卷书兀坐忽三更。\n不知船外风多少，但听满江波浪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐 其二","author":"李纲","text":"波涛漠漠雨纷纷，夜泊江南烟水村。\n慨念平生都不寝，可怜心事向谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至芜湖闻贼陷钱塘复为官军所得有感 其一","author":"李纲","text":"督府繁华一扫空，须知狂寇计非庸。\n庙堂若为苍生计，早筑高坛拜卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至芜湖闻贼陷钱塘复为官军所得有感 其二","author":"李纲","text":"巨盗乘虚起浙东，猖狂如在笑谈中。\n钱塘犹喜官军复，破贼须从此立功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自芜湖江行至采石 其一","author":"李纲","text":"万顷春江彻底清，天风不动镜泓澄。\n画船安稳摇空翠，疑在琉璃地上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自芜湖江行至采石 其二","author":"李纲","text":"江水春来绿似蓝，临流高石翠巉岩。\n波恬舟稳已堪喜，况是清风借一帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阻风泊慈湖夹焚香默祷有长鱼跃波而江豚出没舟人大惊抵暮风便因命解舟乘月泛禁江一夕至金陵盖数百里作二绝以纪其事 其一","author":"李纲","text":"江豚出没白波中，十丈神鱼跃晚空。\n知是阳侯怜我拙，故教来助一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阻风泊慈湖夹焚香默祷有长鱼跃波而江豚出没舟人大惊抵暮风便因命解舟乘月泛禁江一夕至金陵盖数百里作二绝以纪其事 其二","author":"李纲","text":"露气漫漫欲结霜，扁舟夜下秣陵江。\n烟波如席月如昼，快意倒尽黄金缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同李似之游蒋山","author":"李纲","text":"北风阻行舟，驾言游蒋山。\n相携得良友，谈笑穷跻攀。\n松林静杳冥，殿阁罗烟鬟。\n宝公骨已冷，白塔孤云间。\n乘高望长空，极目波涛翻。\n东南正戎马，戈甲照江干。\n与子适相遇，偷此半日闲。\n怀古六朝远，道旧一笑欢。\n忆昨赐对初，接武玉殿班。\n螭坳珥史笔，每惭追继难。\n迂疏与世违，谪官堕瓯蛮。\n宽恩幸脱去，假道来江关。\n邂逅两萍梗，飘泊惊风幡。\n回首顾浙河，不知涕泗潸。\n著鞭愿努力，世路方多艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂示勤老","author":"李纲","text":"平生闻说蒋山勤，今日相逢过所闻。\n还似泉公唤居士，一声吹散满天云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉酬李似之见赠","author":"李纲","text":"吾宗才气世无双，用与时行舍亦藏。\n殿陛同瞻龙衮绣，螭坳继染御炉香。\n紫荷持橐将清禁，贝叶翻经见宝坊。\n仄席正思经济手，伫观趣召侍颙昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]