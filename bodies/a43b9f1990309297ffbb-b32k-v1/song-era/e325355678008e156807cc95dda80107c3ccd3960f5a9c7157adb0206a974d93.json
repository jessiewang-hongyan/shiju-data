[{"title":"次韵潘先生寒食有感 其一","author":"王十朋","text":"花媚韶光柳弄烟，箫声处处卖饧天。\n谁知子厚怀桑梓，北望长号又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘先生寒食有感 其二","author":"王十朋","text":"无赖杨花趁暖风，旅中节物与愁逢。\n一声杜宇啼春怨，知在花梢第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘先生寒食有感 其三","author":"王十朋","text":"人间寒食几经年，甲子谁能记后先。\n且尽一杯蓝尾酒，莫将身事恼生前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼僧德芬 其一","author":"王十朋","text":"身著方袍十一年，缁林头角稍轩轩。\n参禅早悟前三旨，学道思归不二门。\n花落絮飞浮世尽，风清月白片心存。\n异时我作高僧传，为记严公有此孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼僧德芬 其二","author":"王十朋","text":"妙龄萧洒脱尘笼，高揖禅林话苦空。\n万水千山新道眼，一瓶二钵旧家风。\n圆镜肇论能知趣，笔法诗章稍自工。\n圆泽精魂定何所，想随流水到天童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼禅法师","author":"王十朋","text":"阁中高隐岁华深，龟鹤精神老不侵。\n宝剑妙传驱鬼术，灵丹长有济人心。\n弥明石鼎方联句，弘景袈裟遽掩衾。\n借问青牛何处去，九天云路杳难寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毛虞卿见过","author":"王十朋","text":"故人访吾庐，况是清和节。\n高槐绿成阴，芳草碧未歇。\n携手山间行，清兴浩然发。\n呼童具鸡黍，浊酒醅初泼。\n贫居愧荒凉，野蔌草罗列。\n盘实饤梅豆，蔬餐荐薇蕨。\n主礼虽甚微，客色未尝觖。\n醉翁山水意，不为壶觞设。\n蟹眼煎新汲，雀舌烹春撷。\n浇君文字肠，掉我清谈舌。\n人生会面难，岁月易飘忽。\n君姑为我留，匆匆莫言别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读孙子尚旧所寄书","author":"王十朋","text":"故人之书不易得，片纸只字皆可惜。\n收拾永为巾笥藏，纵得千金不愿易。\n开缄展转时一读，读未能终泪横臆。\n之人门地盛衣冠，万里家居帝王宅。\n干戈缭绕飘吾乡，倾盖论交似畴昔。\n我年初冠君犹少，握手游从忝联璧。\n金溪风月供醉吟，君唱我酬常即席。\n君诗句句清且新，高压曹刘倒元白。\n我才短浅何足论，彊伴宁容小生敌。\n追风骏足横海鳞，暂困盐车与污泽。\n掉头一去不可寻，南北茫茫烟水隔。\n往年雁字时复传，近日诗筒杳难觅。\n眼中不见故人面，纸上空怀故人迹。\n人生会合能几回，一别八年同瞬息。\n我去无由君不来，尊酒相逢更何夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋彦才挽词","author":"王十朋","text":"德著吾乡月旦评，丘园萧散傲虚名。\n袍虽不夺诗尤好，秋不曾悲赋自清。\n早挂儒冠知有命，晚凭贝叶悟无生。\n人间月落天池后，定向维摩顶上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋孺人挽词","author":"王十朋","text":"晚岁归来奉伯鸾，力将勤俭济艰难。\n鹿车共挽甘从鲍，熊胆亲调欲慕韩。\n镜里玉容犹未老，梦中银漏忽惊残。\n通家贱子非房杜，长记登门酒尽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"先君子去世五十日孤某入四友室睹平生遗迹哀号痛哭绝而复苏既而书四十字以寄罔极之思","author":"王十朋","text":"先子神何在，人亡迹尚存。\n业馀经史案，趣寄圣贤尊。\n榻冷宁攲枕，堂虚已盖棺。\n晨昏徒泣血，无路报深恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李府君挽词","author":"王十朋","text":"利涂名路两崎嵚，甘向田园事陆沉。\n一顷膏腴生计足，四时香火佛缘深。\n筑门东海于公意，教子燕山窦老心。\n衔涕为公铭隐德，不缘谀墓欲黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈景公挽词 其一","author":"王十朋","text":"冠玉堂堂骨相奇，起家消息露蓍龟。\n齿牙不妄千金诺，度量难窥万顷陂。\n车辙过门多长者，箕裘传业有佳儿。\n西园新卜松楸地，记得公颜向此怡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈景公挽词 其二","author":"王十朋","text":"先子于公分颇深，晚年出处恨商参。\n虽脩北海通家好，未遂香山会老心。\n尽道吉人俱未艾，谁知凶讣遽相寻。\n三年落尽思亲泪，今日登门又满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵万乔年李唐英二绝 其一","author":"王十朋","text":"七贤林下共忘机，更有新诗为发挥。\n竹叶一尊添逸兴，薰风吹散脸红微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵万乔年李唐英二绝 其二","author":"王十朋","text":"黉舍炎炎畏日长，竹亭取次纳新凉。\n文章风月须兼美，莫使时人恨海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送章生端武","author":"王十朋","text":"麟经绝笔今几年，学者异说何纷然。\n操矛入室务相伐，谁能浚井得美泉。\n梅溪野人独好古，遗经独抱期心传。\n从予讲论有赵陆，得趣往往忘蹄筌。\n章生妙龄固可畏，圣经贤传思穷研。\n赢粮远来若有意，席未及暖俄言还。\n岂厌先生纸上语，奥境不见徒留连。\n春秋明日遂东矣，情钟我辈徒拳拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送罗生少陆","author":"王十朋","text":"罗生黄山来，从我梅溪游。\n齿发最年少，学问能自修。\n短檠照深夜，细字书蝇头。\n大业心欲潜，遗编力旁搜。\n新文有佳趣，日进殊未休。\n吾愧河汾翁，子学常与收。\n行将拭老眼，万里看骅骝。\n一叶下庭皋，大火当西流。\n遥望河阳云，俄登李膺舟。\n交朋重惜别，挽袖终不留。\n吾肠百鍊刚，亦作茧绪抽。\n籍也不吾叛，寻盟定高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茹生履","author":"王十朋","text":"灯火勤劳觉瘦生，望云心断涕从横。\n贤关春信无多日，手折梅花赠子行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑冬罢会呈诸友","author":"王十朋","text":"缪意开家塾，微才愧斗筲。\n虽逃有若叱，宁兑孝先嘲。\n尚赖知心友，能全耐久交。\n殷勤惜别意，终日在梅梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上遇风二绝 其一","author":"王十朋","text":"薄暮登舟海飓生，短篷攲侧浪峥嵘。\n江神正好怜行客，莫待他时却世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上遇风二绝 其二","author":"王十朋","text":"弭棹乾门浪未平，同舟太半已山行。\n自惭不是娄师德，免葬江鱼赖友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿黄岩妙智院","author":"王十朋","text":"问讯开山始，于今二百年。\n径幽微见竹，社废尚遗莲。\n观颂思元老，游庵忆旧禅。\n匆匆一宿客，未尽涤尘缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过黄岩","author":"王十朋","text":"三日离家客，悠然觉路长。\n梅花十里眼，竹叶一杯肠。\n诗思贪佳境，眉头忆故乡。\n江山看未足，回首隔沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿庆善寺","author":"王十朋","text":"刚被篙工误，迟留一日装。\n川涂隔浩渺，灯火乱昏黄。\n呼仆回行李，寻僧宿上方。\n山前十里雪，夜入梦魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过天台","author":"王十朋","text":"目逆神仙路，丹成未暇跻。\n雪深封佛垄，云暗锁桃溪。\n流水无还有，乱山高复低。\n欲寻刘阮洞，归路恐成迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过新昌","author":"王十朋","text":"杖屦登关岭，山行无住时。\n客情浑在眼，乡思苦关眉。\n石现金仙像，溪蟠阮肇祠。\n越山都几点，收拾上新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观石佛","author":"王十朋","text":"土木涂金巧逼真，总随浮幻化埃尘。\n何人著意镌山骨，长现金刚不坏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戴溪亭","author":"王十朋","text":"高士逃名隐此溪，凭栏遐想独徘徊。\n不知吾祖乘舟后，得得谁从雪里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹娥庙","author":"王十朋","text":"恸哭无寻处，投江竟得尸。\n风高烈女传，名重外孙碑。\n荒草没孤冢，洪涛舂古祠。\n怀沙为谁死，翻愧是男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿驿奥","author":"王十朋","text":"未是他乡客，思家已断魂。\n明朝春色好，宿处近花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题灵峰三绝 其一","author":"王十朋","text":"家在梅溪水竹间，穿云蜡屐可曾闲。\n雁山新入春游眼，却笑平生未见山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题灵峰三绝 其二","author":"王十朋","text":"洞中大士半千身，住世端能了世因。\n应笑玉箫峰下客，马蹄长践利名尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题灵峰三绝 其三","author":"王十朋","text":"三宿灵峰不为禅，茶瓯随分结僧缘。\n明朝杖屦丹丘去，带得烟霞过海船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出雁山","author":"王十朋","text":"三宿山中始出山，出山心尚在山间。\n浮名夺我林泉趣，不及高僧一味闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"关岭遇雪","author":"王十朋","text":"路近剡溪春雪深，此行有愧子猷寻。\n驱驰千里争蜗角，孤负扁舟自在心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过鉴湖 其一","author":"王十朋","text":"谁把青铜铸鉴湖，湖光冷浸越王都。\n东风二月西游客，买得扁舟入画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过鉴湖 其二","author":"王十朋","text":"春水如天浪未生，扁舟真在鉴中行。\n渔人不问君王觅，占得湖光亦自荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜独酌","author":"王十朋","text":"月色撩人不忍眠，杖头独挂百青钱。\n一杯竹叶那能醉，浇起乡心更黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太学寄梦龄昌龄弟","author":"王十朋","text":"东望家山几断魂，白云飞尽路漫漫。\n须知太学齑盐味，不似亲闱菽水欢。\n事业未应孤铁砚，弟兄犹喜尽儒冠。\n行飞直待秋风便，好作排空雁字看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁卯秋赴鹿鸣宴次太守赵殿撰韵","author":"王十朋","text":"食苹开燕副招求，梦草诗成宠士流。\n要得异才联虎榜，亦容下客盗狐裘。\n早脩慧业钦灵运，妄赞元经愧子游。\n刺史笑谈风满席，定应吹拂到瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴省治装有感","author":"王十朋","text":"记得离家柳未黄，归来三径菊花香。\n一年强半身为客，席未遑安又趣装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再过雁山三绝 其一 大龙湫","author":"王十朋","text":"龙大那容在此湫，银河得得为飞流。\n好乘风雨昂头角，直到天池最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再过雁山三绝 其二 天柱峰","author":"王十朋","text":"女蜗石烂若为脩，四海咸怀杞国忧。\n谁识山中真柱石，擎天功业胜伊周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再过雁山三绝 其三 天聪洞","author":"王十朋","text":"重华疑到此山中，凿石疏岩达四聪。\n端为草茅忧世士，不教无路献孤忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思归","author":"王十朋","text":"窗外西风竹数竿，秋声终夜趣归鞍。\n吾庐此去八百里，归到家时天未寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别太学同舍","author":"王十朋","text":"二年客贤关，倾盖皆故人。\n况我同舍郎，何异手足亲。\n齑盐共牢落，灯火同悲辛。\n坐觉岁月忘，所赖朋友仁。\n西风起天末，淅沥吹江蘋。\n思归适所愿，惜别还沾巾。\n祖席歌骊驹，别肠转车轮。\n离索恐孤陋，重来约新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰闰八月归临安观旧题脩竹黄杨丁香慨然有感复书三绝于后 其一","author":"王十朋","text":"吾家风物富檀栾，最爱青青耐岁寒。\n千里归来面苍玉，不烦时复报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰闰八月归临安观旧题脩竹黄杨丁香慨然有感复书三绝于后 其二","author":"王十朋","text":"同日种松今合抱，后来栽柳已参天。\n笑看轩外黄杨树，我亦如君厄闰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰闰八月归临安观旧题脩竹黄杨丁香慨然有感复书三绝于后 其三","author":"王十朋","text":"蕙兰憔悴菊萎秋，叶底藏春已数头。\n诗客不知花韵别，却言空结雨中愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宝印叔题止庵三绝 其一","author":"王十朋","text":"凿石依山作小庵，花香入座月侵檐。\n虽然眼界无多地，解使人天竞耸瞻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宝印叔题止庵三绝 其二","author":"王十朋","text":"容膝茅庵不妄开，欲令人悟止由来。\n个中妙意知谁解，多作休休莫莫猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宝印叔题止庵三绝 其三","author":"王十朋","text":"晚学无由识道真，前贤未许继芳尘。\n道从何进从何止，敢叩无为绝学人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翁府君挽词","author":"王十朋","text":"场屋收功不在身，兰馨玉润总奇人。\n过庭诗礼家风变，坦腹门阑喜气新。\n华屋产芝虽美瑞，白头生齿误青春。\n篮舆方起南游兴，无奈今年岁在辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月十九日雷二十一日雪","author":"王十朋","text":"前日始惊雷失令，今朝忽见雪漫天。\n寒窗夜拥黄紬坐，闲读春秋隐九年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵表叔余叔成示儿","author":"王十朋","text":"父子乃天性，钟情谁不然。\n教之以义方，先贤有名言。\n日严在所尚，私念宜舍旃。\n君子不自教，遣随师友肩。\n青紫乃馀事，要当知圣贤。\n居家务孝弟，立行防悔愆。\n穷当慕颜回，达勿为公孙。\n庶几幼所学，终身可行焉。\n不见下邳丈，秀发从妙年。\n束书入贤关，日与英隽联。\n忽作何蕃归，甘旨奉晨昏。\n丘园事高尚，腹笥常便便。\n过庭有奇儿，诗礼得家传。\n勉哉尊所闻，慎勿学乡原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"表叔陈景韶挽词 其一","author":"王十朋","text":"问舍求田事，元龙意本轻。\n功名孤壮志，诗酒送平生。\n李密伤为弟，刘牢喜有甥。\n诗书已三世，二子盍升卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"表叔陈景韶挽词 其二","author":"王十朋","text":"先友嗟无几，公今亦古人。\n平门散车辙，蕃榻锁埃尘。\n甚愧常公厚，深知管子贫。\n平生谈笑地，感激泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏述师葡萄","author":"王十朋","text":"柱杖拈馀戏插泥，草龙珠帐挂檐西。\n荔枝体物差胜枣，毕竟俱非善品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一月七日东山省坟因思先子昔年题壁有山光水色两依依之句，旧屋已坏墨迹不留山水依然感叹不已因成一绝","author":"王十朋","text":"松楸一见一伤心，亭院凄凉惨树阴。\n记得先君旧题壁，水光山色恨难禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄万大年","author":"王十朋","text":"九万程遥共退飞，江南竹叶后先归。\n儒冠到底输纨裤，关吏还应笑布衣。\n虽欠姓名联桂籍，不妨欢笑奉亲闱。\n殷勤尊酒论文约，却恨还乡与愿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万季梁和诗留别再用前韵","author":"王十朋","text":"三年燕雁不同飞，一笑相逢慰远归。\n搜我肺肠茶著令，饮君文字酒淋衣。\n诗方唱和如仙馆，人遽飘零似省闱。\n毕竟此心元不别，祇应形影暂相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将过万桥用前韵寄大年先之","author":"王十朋","text":"三年在阜不鸣飞，侧翅俱从旧路归。\n师德量宽真耐事，沈郎诗瘦不胜衣。\n都缘有职供甘旨，可是无心恋阙闱。\n酒发葡萄螯斫雪，定知此愿不吾违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种兰有感","author":"王十朋","text":"芝友产岩壑，无人花自芳。\n苗分郑七穆，秀发谢诸郎。\n世竞怜春色，人谁赏国香。\n自全幽静操，不采亦何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵","author":"王十朋","text":"谁棹深林秀，遥分奕叶芳。\n秉殊溱上客，握拟殿中郎。\n眼净见幽韵，心清闻远香。\n当门不及种，践履恐成伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月晦日与同舍送春于梅溪因诵贾阆仙诗云三月更当三十日，风光别我苦吟身共君今夜不须睡未到晓钟犹是春时有二十八人遂以齿序分韵","author":"王十朋","text":"记得来时手自探，预知今日思难堪。\n树头绿暗莺如诉，地上红多蝶尚贪。\n此夜钟声那忍听，明朝酒盏可能酣。\n却因送别还惊我，老境如蚕已食三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]