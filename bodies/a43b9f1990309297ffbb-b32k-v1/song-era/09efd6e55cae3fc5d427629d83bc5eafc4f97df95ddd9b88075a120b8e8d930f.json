[{"title":"廛中佛事","author":"释惟一","text":"几回走巷复穿衢，货卖南方镇海珠。\n一栲栳都倾出了，不知酬价有人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题群牧图","author":"释惟一","text":"雨过桃林草正肥，休征牧放恰相宜。\n擎头戴角群然乐，喜见太平无事时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"懒牛","author":"释惟一","text":"鼻绳拽脱了无拘，慵有馀兮顽有馀。\n芳草满前浑不顾，眠云卧月只如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"镜空","author":"释惟一","text":"团团荷叶不相似，豁豁大虚难比伦。\n个里洞然无一物，拟于何处拂埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼疏山塔 其二","author":"释惟一","text":"江横一练平，山色四时青。\n水足柴犹富，人多爨不停。\n无弦犹自韵，有耳几曾听。\n槁矣齐檐柏，频看涕忽零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼疏山塔 其一","author":"释惟一","text":"造塔当年事，喧传直至今。\n示人千古意，与匠两三金。\n不得罗山语，谁知矮叔心。\n瓣香来作礼，肯顾白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其十七","author":"释惟一","text":"万法不为侣，一口吸西江。\n玉磬才槌动，金钟应手撞。\n三三元是九，两两不成双。\n此意凭谁委，令人忆老庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十四","author":"释惟一","text":"吾心似秋月，秋月似吾心。\n双照纤尘净，俱清万籁沉。\n十分明又白，一样古犹今。\n不是寒山子，何人解此吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其七十九","author":"释惟一","text":"雅爱中秋月，多情似故人。\n在天何皎皎，照我更频频。\n圆影随流水，清光绝点尘。\n孤高攀不及，觌面最相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其五十九","author":"释惟一","text":"经诵三千部，曹溪一句忘。\n尘尘皆宝所，处处是家乡。\n云净天如洗，潭清月愈光。\n须知远烟浪，别有好商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师惠林师孙法济请赞","author":"释惟一","text":"齿豁头童，眼昏耳聋。\n不忘所嗜乾屎橛，未忍轻抛栗棘蓬。\n以此踞丛林，以此济贫穷。\n只缘真实不脱空，故得孝子慈孙写真而绘容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师惠彰请赞","author":"释惟一","text":"顾我游世间，如云在天上。\n任缘而去住，不作去住想。\n南北信所之，东西无定向。\n为人少方便，动便拦腮掌。\n恁地去离泥水底本师，如何却唤作环溪和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马郎妇赞","author":"释惟一","text":"云开天竺，月照金沙。\n心心妙法，念念莲华。\n未必将身许马家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文殊赞","author":"释惟一","text":"或草为衣，或狮为舆。\n千变万化，无二文殊。\n虽然觅则不可得，五台山色犹如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月华崧上人之杭","author":"释惟一","text":"月华如水夜沉沉，一曲箫韵韵更清。\n曲罢莫言无觅处，西湖后夜转堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见侍者乞语为入道蹊径","author":"释惟一","text":"入道蹊径无蹊径，日用现行何不省。\n和南问讯已乖张，应对宾朋曾不隐。\n同盂共饭况三年，话破那知万万千。\n今日炷香重觅语，许时聚首成徒然。\n老僧更不能忉怛，痛掌宁辞当面搭。\n从教负痛走出门，呼天怨骂齿没舌秃口未合。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对月了残经赞","author":"释惟一","text":"古教只知遮老眼，银蟾不觉上孤峰。\n看来看到无看处，光境俱忘一卷终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释惟一","text":"逢人乞一文，袋里敌国富。\n不是下生迟，嫌佛不肯做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞","author":"释惟一","text":"耳门圆照，日月两间。\n悲愿洪深，衣被四海。\n方便智慧，靡不圆融。\n见闻觉知，无能障碍。\n人间天上独优游，是则名为观自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奇都管请赞","author":"释惟一","text":"牧以卑，守以规，迅雷疾风，铁石不移。\n须弥其颓，只手力持。\n电光石火里驱耕夺食，春风和气中摧枯拉萎。\n极等没意智，阖国少人知，知之梓府牛峰奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定翁","author":"释惟一","text":"日用千差万别中，如如不动等虚空。\n春妍秋靖几更变，此老何曾改旧容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴雪峰示圭上人","author":"释惟一","text":"上人辞我去行脚，我亦早晚行脚去。\n天涯海角或重逢，钵饭茎齑又相聚。\n自笑年登六十七，眼昏耳聩脚无力。\n触事无能只面墙，百千追悔有何益。\n少壮学道宜加鞭，危亡不顾勇直前。\n如一人与万人敌，破坚挫锐成万全。\n放牛归马群务息，好是太平无事日。\n塞北归鸿截雾飞，江南野水连天碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孚藏主归江西","author":"释惟一","text":"云卧胸中蟠万卷，舌端笔端皆具眼。\n评今论古知几何，寥寥百年骨不冷。\n有孙挺特尤掀腾，富有蕴藉如弗能。\n韬光铲彩事枯硬，不学乃翁牵葛藤。\n壁立万仞出一语，佛祖应无启口处。\n有时一默渊且深，尽大地人难指注。\n脚尖踢倒凌霄峰，挥剑活屠潭底龙。\n三条椽下四世界，破蒲团边兜率宫。\n秋风忽起故山兴，归本无归语何剩。\n江湖斫额应望君，莫作秤锤落深井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其八","author":"释惟一","text":"直下是，直下是。\n上是天，下是地。\n日暖风和，花酣柳醉。\n玉笛才轰，朱弦奏起。\n音响和同一会家，相逢彼此各天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其三十六","author":"释惟一","text":"问我家风，识你家风。\n将谓耳背，元来耳聋。\n指南为北，问西答东。\n阿呵呵，赵州恰恰似天童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其三十","author":"释惟一","text":"沩峤冬天轰霹雳，仰山夏月降严霜。\n铁锤两个都无孔，打就乾坤自厮当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其二十五","author":"释惟一","text":"曹溪门下南来燕，终日呢喃话祖翁。\n话尽离微人不会，不如养羽候秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其二十四","author":"释惟一","text":"雪里垂丝古钓台，锦鳞拂拂上钓来。\n船头拨转归何处，又向芦花深处挨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其二十","author":"释惟一","text":"老倒赵州无本据，翻手为云覆手雨，觌面当机不覆藏，往往少人知落处。\n知落处，是甚闲家具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其十九","author":"释惟一","text":"真觉祖师展两手，云门一举四十九。\n空王殿已峭巍巍，千古万古犹仍旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其十八","author":"释惟一","text":"无位真人活鱍鱍，赤肉团上为窠窟。\n纵横妙用可怜生，七出八没难捉摸。\n推不去，挽不住，拟议寻思无觅处。\n无觅处，在这里，握则一拳，开则五指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其十三","author":"释惟一","text":"自己将来更问谁，须弥还更戴须弥。\n九峰末上能行令，免得重重涉水泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十六首 其七","author":"释惟一","text":"不落宫商太古音，无劳弦上发清声。\n高山流水有馀意，除却子期谁解听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其八十九","author":"释惟一","text":"元正启祚，万物咸新。\n觅一毫旧相，了不可得，千年桃核里，元是旧时仁。\n觅一毫新相，了不可得，新旧之相既不可得，不可得亦不可得。\n道泰时清万国宁，咸淳二年正月一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其九十六","author":"释惟一","text":"秋雨乍晴，秋天如洗。\n九日菊花新，千林黄叶坠。\n人人只知骤步登高，往往蹉过自家稳密田地。\n切忌，切忌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其六十","author":"释惟一","text":"直下是，直下是。\n这边那边，满眼满耳。\n绵绵兮长存，湛湛兮不痕，拟议依前隔海门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一三六","author":"释惟一","text":"生本不有，死亦无空。\n湖光晴潋滟，山色雨濛泷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一三五","author":"释惟一","text":"去秋双峨摧，今夏芝岩坠。\n松江松惨然，花屿花流涕。\n惟有长空孤月圆，东西分照两无偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一三四","author":"释惟一","text":"故人义重，访我岩扉。\n鸟啼花笑，云淡风微。\n莫怪坐来频劝酒，自从别后见君稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一三三","author":"释惟一","text":"偏中正，正中偏。\n正偏不及处，别是一壶天。\n水澄澄，风细细，云澹澹，月娟娟。\n金针兮纤纤，玉线兮绵绵。\n以此续洞脉于既微，以此大丹霞之正传。\n作兴太白，特游戏之馀焉。\n今不在后，昔不在前。\n光明藏中，初无间然，一杯粗茗一炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一三二","author":"释惟一","text":"海山雨歇，水国云藏。\n薰风南来，殿阁生凉。\n佛出身处，昭然孔彰。\n堪笑当年奚老子，无端好肉上剜疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一三一","author":"释惟一","text":"秋风清，秋月白，秋水共长天一色。\n不是心外境，亦非目前法。\n可中一见便知归，平步广寒攀桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一三○","author":"释惟一","text":"夏令更新，春归奏勋。\n秧田铺翠，麦陇翻云。\n日犹舒暖，风已来熏。\n目击道存如不委，更饶一喝主宾分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二八","author":"释惟一","text":"谓吾灭度，未免落断见。\n谓吾不灭度，未免落常见。\n二见俱遣除，十方佛皆现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二七","author":"释惟一","text":"泯志灰心，参禅学道。\n无烦恼中，自讨烦恼。\n何不向老胡未来已前，试著眼看，自己分上有何欠少。\n天童恁么道，不入深村入荒草。\n不许夜行，投明须到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二六","author":"释惟一","text":"去时元只空双手，归日依前双手空。\n底事两肩担不起，打开畐塞满玲珑。\n姑苏明月，苕霅清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二五","author":"释惟一","text":"仲春渐暖，是处花开。\n夭桃烘日晕生脸，红杏吟风笑满腮。\n是今弥勒，是古如来，一一分身不用猜。\n有人一见便见，敢保老兄未彻。\n即色即声求不可，离声离色觅犹乖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二四","author":"释惟一","text":"鼓报四更，地摇六震。\n火焰为三世诸佛说法，三世诸佛立地听。\n虚空有尽，大道无穷。\n穷则变，变则通。\n信手拈将茎草插，琼楼玉殿凌苍穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二三","author":"释惟一","text":"休去歇去，玲珑岩上落花雨。\n消焉息焉，路入清关别有天。\n尘不到，暑不到，行亦禅，坐亦禅，高蹈威音未朕前。\n吃粥吃饭过，听风听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二二","author":"释惟一","text":"走尽四天下，只在一尘中。\n不离一尘中，周遍四天下。\n不是神通，亦非力假。\n有人知得著落，许你入妙喜世界，是不动如来。\n其或未然，一任钻龟打瓦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二一","author":"释惟一","text":"旧时日月，旧日山川。\n东西不易，南北不迁。\n水云杂沓，龙象骈阗，古佛家风尚俨然。\n雨过千林开翠幄，月临双沼浸银蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一二○","author":"释惟一","text":"函盖乾坤句，随波逐浪句，截断众流句，三句尽在此。\n不多一字，不少一字。\n众眼难瞒，分明举似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一九","author":"释惟一","text":"天门一合，十方无路。\n似海之深，如山之固。\n如何造入，步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一八","author":"释惟一","text":"马师一喝大雄峰，直得三日双耳聋。\n今日松山聋更甚，半年不复闻鼓钟。\n依俙钝铁，彷佛顽铜。\n只好投之火聚中，火馀烜赫地通红。\n几多错认，鸟啼月落，煜煜晓星明向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一七","author":"释惟一","text":"衲僧行处，孤风凛然。\n动无妄动，言无妄言。\n如履薄冰，如临深渊。\n不须明祖意，只此是单传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一六","author":"释惟一","text":"一年十二月，是腊月年尾。\n腊月三十日，过了三之二。\n雪峰昼里夜里，波波挈挈，手不释杓，脚不离地，理会甚底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一五","author":"释惟一","text":"自夏及秋，频频出入。\n送旧迎新，奔驰不歇。\n十字街头忽吃攧，起来拾得胡饼只。\n今日不辞举似诸人，团团圆圆，皎皎洁洁，十成脱似中秋月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一四","author":"释惟一","text":"辛未元正有则语，大地无人知落处。\n屋角山禽破晓啼，为人一一从头举。\n岁旦无风，甲子不雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一三","author":"释惟一","text":"绿水青山，红尘闹市。\n一大藏教，满眼满耳。\n这里有人拣辨得出，入则个个归元，出则无无不是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一二","author":"释惟一","text":"三十年前，无交涉处有交涉。\n三十年后，有交涉处无交涉。\n须无交涉，饮恨难忘，含悲含笑一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一一","author":"释惟一","text":"节届中秋，凉飙四起。\n万里无云，一天如洗。\n明皎皎月上孤峰，香拂拂桂飘庭际。\n以我为隐乎，吾无隐乎尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一一○","author":"释惟一","text":"昔日不生，今日不灭。\n出入飞鸢岭，未曾有出入。\n洞山不曾到，投子不相识。\n若道嗣德山，未免自屈抑。\n象骨巍巍摩碧空，寒泉皎皎浸明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○九","author":"释惟一","text":"人人头顶天，脚踏地，眼里放光，鼻孔出气，与他诸佛诸祖无别无异。\n因甚握节当胸，听我谩你。\n莫有不被谩□么，我且问你，鸡寒上树，鸭寒下水，毕竟是祖意是教意。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○八","author":"释惟一","text":"杨岐栗棘蓬，吞著碍喉咙。\n东山铁馂馅，浑崙苦磝磝。\n诸人若要省力，不如参一个平实。\n楚王渡江得萍实。\n大如斗，赤如日，剖而食之甜如蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○七","author":"释惟一","text":"不思善，不思恶。\n孤迥迥，活鱍鱍。\n不用追寻，不劳捉摸，只贵诸人知著落。\n知著落，杨岐驴子三只脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○六","author":"释惟一","text":"我心似秋月，道似又还别。\n秋月有亏盈，吾心无损益。\n人人只知登楼赏玩向天边觅，殊不知自己衣单下有个光明藏子十分圆满十分皎洁。\n信得及，见得彻。\n非惟一夕欢，千古可怡悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十六首 其一○五","author":"释惟一","text":"入理深谈，语非语，默非默。\n量材补职，武是武，文是文。\n用舍临时，剸裁在我。\n只如将丈六金身作一茎草用，将一茎草作丈六金身用。\n寰中天子敕，塞外将军令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]