[{"title":"行在春晚有怀故隐","author":"陆游","text":"老辱明时乞一官，逢春惆怅独无欢。\n旧人零落北音少，市肆萧疏民力殚。\n归计已栽千个竹，残年合挂两梁冠。\n石帆山路频回首，箭茁莼丝正满槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行年","author":"陆游","text":"行年过七十，与世两相忘。\n墨沼龟鱼乐，药园芝朮香。\n吾生一虫臂，世路几羊肠。\n楮弁新裁就，翛然学道装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行至严州寿昌县界得请许免入奏仍除外官感恩述怀","author":"陆游","text":"晓传尺一到江村，拜起朝衣渍泪痕。\n敢恨帝城如日远，喜闻天语似春温。\n翰林惟奉还山诏，湘水空招去国魂。\n圣主恩深何力报，时从天末望修门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行过西山至柳姑庙晚归","author":"陆游","text":"倚杖西山麓，褰衣古庙壖。\n断云依钓浦，细雨压炊烟。\n废学惭诗退，安贫觉气全。\n霜天日易晚，钟鼓隔城传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行饭至湖上","author":"陆游","text":"行饭消摇日有常，青鞋又到古祠傍。\n残芜满路无多绿，落叶投空不待黄。\n只道诗书能发冢，岂知博簺亦亡羊。\n此身只合都无事，时向湖桥看戏场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行饭至湖桑堰东小市","author":"陆游","text":"饱食无营是处游，偶然来到埭东头。\n芒鞋也似双凫快，渔艇真如一叶浮。\n樵担行歌冲暝色，酒旗遮路卖新篘。\n任朱二老今安在，叹息黄茅拥故丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行饭至新塘夜归","author":"陆游","text":"门前徙倚尚馀霞，湖上归来月满沙。\n云湿一声新到雁，林昏数点后栖鸦。\n凄迷篱落开寒菊，郑重比邻设夜茶。\n早议挂冠君会否，暮年心念不容差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行饭暮归","author":"陆游","text":"宿疾去如扫，出门芒屦轻。\n菊丛寒蝶闹，枫叶夕阳明。\n结阵看鸦集，衔衣喜犬迎。\n踟蹰搔白首，诗句入经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行饭暮归","author":"陆游","text":"暂置观书不耐闲，飘然梅坞竹篱间。\n霜风尽脱千林叶，云气平沉一面山。\n笑唤筇枝扶蹇步，聊凭村酒借朱颜。\n庙壖墙下归来晚，宿鸟纷纷已渐还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行武担西南村落有感","author":"陆游","text":"骑马悠然欲断魂，春愁满眼与谁论。\n市朝迁变归芜没，涧谷谽谺互吐吞。\n一径松楠遥见寺，数家鸡犬自成村。\n最怜高冢临官道，细细烟莎遍烧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行绵州道中","author":"陆游","text":"三年客江硖，万死脱鱼鼋。\n平地从今始，穷涂敢复论。\n园畦棋局整，坡垄海涛翻。\n瘦犊应多恨，泥涂伏短辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西兴泊舟","author":"陆游","text":"衰发不胜白，寸心殊未降。\n避风留水市，岸帻倚船窗。\n日上金镕海，潮来雪捲江。\n登临数奇观，未易敌吾邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西村","author":"陆游","text":"乱山深处小桃源，往岁求浆忆叩门。\n高柳簇桥初转马，数家临水自成村。\n茂林风送幽禽语，坏壁苔侵醉墨痕。\n一首清诗记今夕，细云新月耿黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西村劳农","author":"陆游","text":"川云散尽十分晴，缭出溪头信意行。\n片片飞花随步远，离离芳草上墙生。\n村深日暖单衣爽，路转沙平两履轻。\n膰肉芬香坊酒酽，因来聊得饷春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西村晚归","author":"陆游","text":"小坞花垂尽，平堤草次迷。\n日长莺语久，风定絮飞低。\n子响闻棋院，舟横傍钓溪。\n归途不知处，依约埭东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西村暮归","author":"陆游","text":"天气清和修禊后，土风淳古结绳前。\n村村陂足分秧水，户户门通入郭船。\n亭障盗消常息鼓，坊场酒贱不论钱。\n行人争看山翁醉，头枕槐根卧道边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西村醉归","author":"陆游","text":"侠气峥嵘盖九州，一生常耻为身谋。\n酒宁剩欠寻常债，剑不虚施细碎雠。\n岐路凋零白羽箭，风霜破弊黑貂裘。\n阳狂自是英豪事，村市归来醉跨牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西邻亦新葺所居复与儿曹过之","author":"陆游","text":"竹屋茆檐烟火微，长歌相应负禾归。\n穷居幸可支朝夕，世事何曾有是非。\n新茁畦蔬经宿雨，半开篱槿弄斜晖。\n老翁略与吾年等，眷眷遮留莫苦违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西岩翠屏阁","author":"陆游","text":"把酒孤亭半日留，西岩独擅鹤山秋。\n也知绝境终难赋，且喜闲身得纵游。\n鹘起危巢时磔磔，鹿鸣深涧暮呦呦。\n人生适意方为乐，甲第朱门秖自囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西林院","author":"陆游","text":"一邦尽对江边像，试比西林总不如。\n群玉萧森开士宅，五云飞动相君书。\n磴危渐觉山争出，屐响方惊阁半虚。\n安得弃官长住此，一杯香饭荐珍蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西郊","author":"陆游","text":"七十辞北阙，五亩寄西郊。\n泳水鱼依藻，摩云鹤结巢。\n丐僧时问疾，卜叟或论交。\n社栎天全汝，宁当叹系匏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西城","author":"陆游","text":"市步群嚣散，关门夕照明。\n河流倒桥影，雪野聚乌声。\n繁杵闻深巷，寒烟下废城。\n匆匆船尽发，争趁早潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西斋雨后","author":"陆游","text":"香碗灰深微炷火，茶铛声细缓煎汤。\n百年浮世几人乐，一雨虚斋三日凉。\n帘外微风斜燕影，池边残照敛萱房。\n纱幮石枕萧然卧，付与今宵幽梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西斋遣兴","author":"陆游","text":"桐叶秋先霣，菊花寒更香。\n酒边聊兀兀，身外本茫茫。\n小憩元非睡，长吟偶似狂。\n忽然思把卷，一笑就窗光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西窗","author":"陆游","text":"西窗偏受夕阳明，好事能来慰此情。\n看画客无寒具手，论书僧有折钗评。\n姜宜山茗留闲啜，豉下湖莼喜共烹。\n酒䏑朱门非我事，诸君小住听松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西窗独酌","author":"陆游","text":"却扫衡门岁月深，残骸况复病交侵。\n平生所学为何事，后世有人知此心。\n水落枯萍黏破块，霜高丹叶照横林。\n一樽浊酒西窗下，安得无功与共斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西窗睡起","author":"陆游","text":"老便寂寂厌纷纷，借得禅房卧看云。\n夜宴怕逢觥录事，秋山佣伴猎将军。\n馀年敢望十寒暑，夙习正须三沐熏。\n斜日满窗谁唤起，数声啼鸟隔溪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西楼夕望","author":"陆游","text":"夜郎城里叹途穷，赖有西楼著此翁。\n溪鸟孤飞寒霭外，野人参语夕阳中。\n苍天可恃何曾老，白发缘愁却未公。\n俗态十年看烂熟，不如留眼送归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西路口山店","author":"陆游","text":"日薄霜清十月天，马蹄声里送流年。\n店当古路三叉处，山似孤云两角边。\n淹泊自悲穷不醒，衰残更著病相缠。\n榆关瀚海知何在，目送飞鸿入暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观长安城图","author":"陆游","text":"许国虽坚鬓已斑，山南经岁望南山。\n横戈上马嗟心在，穿堑环城笑虏孱。\n日暮风烟传陇上，秋高刁斗落云间。\n三秦父老应惆怅，不见王师出散关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观村童戏溪上","author":"陆游","text":"雨馀溪水掠堤平，闲看村童戏晚晴。\n竹马踉蹡冲淖去，纸鸢跋扈挟风鸣。\n三冬暂就儒生学，千耦还从父老耕。\n识字粗堪供赋役，不须辛苦慕公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观身","author":"陆游","text":"欲去浮华累，先观老病身。\n浊醪何负汝，淡饭最宜人。\n意气随年往，工夫愧日新。\n祇将闲送老，虚作太平民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观邸报感怀","author":"陆游","text":"六圣涵濡寿域民，耄年肝胆尚轮囷。\n难求壮士白羽箭，且岸先生乌角巾。\n幽谷主盟猿鹤社，扁舟自适水云身。\n却看长剑空三叹，上蔡临淮奏捷频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观画山水","author":"陆游","text":"古北安西志未酬，人间随处送悠悠。\n骑驴白帝城边雨，挂席黄陵庙外秋。\n大网截江鱼可脍，高楼临路酒如油。\n老来无复当年快，聊对丹青作卧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观棋","author":"陆游","text":"一枰翻覆战枯棋，庆吊相寻喜复悲。\n失马翁言良可信，牧猪奴戏未妨为。\n白蛇断处真成快，黑帜空时又一奇。\n敛付两奁来对酒，泠泠听我诵新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访山家","author":"陆游","text":"舍舟步上若耶溪，寿栎修藤路欲迷。\n僧院倚山驯栗鼠，野塘涨水下茭鸡。\n草侵古路迢迢远，云傍行人故故低。\n薄暮但寻遗毳去，山家正在鹤巢西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访毛平仲问疾与其子适同游柯山观王质烂柯遗迹","author":"陆游","text":"篮舆访客过仙村，千载空馀一局存。\n曳杖不妨呼小友，还家便恐见来孙。\n林峦巉绝秋风瘦，楼堞参差暮气昏。\n酒美鱼肥吾事毕，一庵那得住云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访村老","author":"陆游","text":"强健如翁举世稀，夜深容我叩门扉。\n大儿叱犊戴星出，稚子捕鱼乘月归。\n骨肉团栾无远别，比邻假贷不相违。\n人间可羡惟农亩，又见秋灯照捣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访杨先辈不遇因至石室","author":"陆游","text":"访客客已去，追凉成独行。\n衣冠严汉殿，草木拱秦城。\n古甃苍苔滑，空庭落日明。\n出门还傥恍，列屋打碑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访客不遇","author":"陆游","text":"风急斜吹帽，泥深乱溅衣。\n杜门常畏骂，访客却空归。\n老马举蹄懒，枯槐无叶飞。\n驰驱几时了，散发忆苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访客至北门抵暮乃归","author":"陆游","text":"北郭那辞十里遥，上车且用慰无聊。\n九衢浩浩市声合，四野酣酣雪意骄。\n清镜新磨临绿浦，长虹横绝度朱桥。\n归来熟睡明方起，卧听邻墙趁早朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访昭觉老","author":"陆游","text":"久矣耆年罢送迎，喜闻革履下堂声。\n游山笑我蓦直去，过夏怜君太瘦生。\n庭际楠阴凝昼寂，墙头鹊语报秋晴。\n功名已付诸贤了，长作闲人乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访野人家","author":"陆游","text":"山入柴门窄，桥通野路长。\n群童挑燕笋，幼妇采鸡桑。\n淳古非今俗，留连到夕阳。\n盘飧敢辞饱，满箸药苗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访野老","author":"陆游","text":"农事元知要细评，野人有旧得寻盟。\n林深未见果蔬地，舍近先闻鸡犬声。\n春水筑塘谋竭作，阳坡卧犊约同耕。\n老来常叹人情薄，深愧今朝倒屣迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访隐者","author":"陆游","text":"湖曲有隐者，时时容叩门。\n人如钓渭叟，地似避秦村。\n笑语嚣尘远，衣冠古制存。\n山寒归路晚，相与尽瓢樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访僧支提寺","author":"陆游","text":"高名每惯习凿齿，巨眼忽逢支道林。\n共夜不知红烛短，对床空叹白云深。\n满前钟鼓何曾忍，匝地毫光不用寻。\n欲识天冠真面目，鸟啼猿啸总知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迂拙","author":"陆游","text":"迂拙宜归早，乘除得死迟。\n老稀朝市梦，穷足道途诗。\n哗世无它技，忘怀自一奇。\n故溪幽绝处，惟许白鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过广安吊张才叔谏议","author":"陆游","text":"春风疋马过孤城，欲吊先贤涕已倾。\n许国肺肝知激烈，照人眉宇尚峥嵘。\n中原成败宁非数，后世忠邪自有评。\n叹息知人真未易，流芳遗臭尽书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过六和塔前江亭小憩","author":"陆游","text":"断岸孤亭日莫时，栏边聊试葛巾攲。\n偶观挂席乘潮快，便觉悬车纳禄迟。\n痛饮相如无奈渴，清言叔宝不胜羸。\n年来亲友凋零尽，惟有江山是旧知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过东邻归小憩","author":"陆游","text":"篮舆过邻曲，绿野喜新晴。\n暖日生花气，丰年入碓声。\n筑陂乡竭作，买犊户深耕。\n归舍还寻睡，残书傍枕横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过东?滩入马肝峡","author":"陆游","text":"书生就食等奔逃，道路崎岖信所遭。\n船上急滩如退鹢，人缘绝壁似飞猱。\n口誇远岭青千叠，心忆平波绿一篙。\n犹胜溪丁绝轻死，无时来往驾?艚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过玉山辱芮国器检详留语甚勤因寄此诗兼呈韩无咎右司","author":"陆游","text":"辽东归老白襦裙，名字何堪遣世闻。\n便谓与公长契阔，不知留语故慇勤。\n诗章有便犹应寄，禄米无多切莫分。\n倘见右司烦说似，每因风月怆离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过夷陵适值祈雪与叶使君清饮谈括苍旧游既行舟中雪作戏成长句奉寄","author":"陆游","text":"巴楚夷陵酒最醇，使君风味更清真。\n少年恨不从豪饮，薄宦那知托近邻。\n本拟笙歌娱病客，却催雨雪恼行人。\n朝来冻手题诗寄，莫笑攲斜字不匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过江山县浮桥有感","author":"陆游","text":"堪笑行人日日忙，又扶衰病过浮梁。\n滩流急处水禽下，桑叶空时村酒香。\n枯蘖敢怀贪雨露，饥鸿自悯犯风霜。\n宦途商略无安处，早晚归耕剡曲旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过村店有感","author":"陆游","text":"细篾络丹柿，枯篱悬碧花。\n炊烟生旅灶，野水漱寒沙。\n栖鸟争投树，归牛自识家。\n恍然游蜀路，搔首忆天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邻曲","author":"陆游","text":"黄云卷尽绿针齐，夏木阴阴满古堤。\n耆老往来无负戴，比邻问道有提携。\n暑天渐近便餐酪，吴俗相传尚鲙齑。\n共喜丰年多乐事，扶归先判醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邻家","author":"陆游","text":"今日病良已，筇枝发兴新。\n高居遗世事，一笑过吾邻。\n夕照明丹叶，秋风老白蘋。\n素衣虽化尽，不为犯京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邻家","author":"陆游","text":"扶杖过吾邻，相誇自在身。\n年丰称贷少，酒贱往来频。\n群散鸡归栅，声喧雀噪囷。\n丁宁语儿子，切勿厌沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邻家","author":"陆游","text":"病去诗情动，寒深酒戒开。\n儿孙扶每出，邻里唤还来。\n云重时飞雪，春迟未见梅。\n山园多芋栗，夜话且燔煨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邻家戏作","author":"陆游","text":"老脱朝冠岸幅巾，时时乘兴过比邻。\n瓶无储粟吾犹乐，步有新船子岂贫。\n醅瓮香浮花露熟，药栏土润玉芝新。\n相从觅笑真当勉，又过浮生一岁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过采石有感","author":"陆游","text":"短衣射虎早霜天，叹息南山又七年。\n唾手每思双羽箭，快心初见万楼船。\n平波漫漫看浮马，高柳阴阴听乱蝉。\n明日重寻石头路，醉鞍谁与共联翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过能仁光孝寺欲访昕老会府中速客遂不果入","author":"陆游","text":"春日城南过宝坊，驰驱不得驻车箱。\n高门临道净如拭，杰屋凌空势欲翔。\n斋近钟鱼初送响，风微松桧自生香。\n暂来堪笑忙如许，坐羡高人白昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过绿杨桥","author":"陆游","text":"过县东驰十里遥，行吟不觉度溪桥。\n硙轮激水无时息，酒旆迎风尽日摇。\n半掩店门灯煜煜，横穿村市马萧萧。\n秦吴万里行几遍，莫恨尊前绿鬓凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过野人家有感","author":"陆游","text":"纵辔江皋送夕晖，谁家井臼映荆扉。\n隔篱犬吠窥人过，满箔蚕饥待叶归。\n世态十年看烂熟，家山万里梦依稀。\n躬耕本是英雄事，老死南阳未必非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过湖上僧庵","author":"陆游","text":"西庵每过未尝开，邂逅清言始此回。\n陶令巾车寻壑去，巳公茅屋赋诗来。\n奇香炷罢云生岫，瑞茗分成乳泛杯。\n便恐从今往还熟，入门猿鸟不惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过猷讲主桑渎精舍","author":"陆游","text":"寂寞衡门傍水开，放翁曳杖此徘徊。\n林疏时见钓篷过，风急忽闻菱唱来。\n讲罢绳床悬麈柄，斋馀童子供茶杯。\n解衣许我闲摩腹，又作幽窗梦一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]