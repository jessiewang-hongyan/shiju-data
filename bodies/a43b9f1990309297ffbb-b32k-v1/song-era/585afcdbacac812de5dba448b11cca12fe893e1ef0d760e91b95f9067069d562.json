[{"title":"林景云令祖夫妻随其子各居同日葬","author":"薛嵎","text":"真诰岩前旧筑居，夫妻双化是仙期。\n至今耕陇桑麻地，全似桃源晋宋时。\n窀穸同晨符吉卜，亲朋分夜别灵帷。\n诗书孙子名方盛，锦诰重恩日未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林景云参学","author":"薛嵎","text":"一门四世同堂乐，门外传呼释褐归。\n自此高车访游旧，屏将呵从叩渔扉。\n三冬晴暖春寒在，千里诗书野意违。\n又说携琴搜逸谱，休嫌古调按今徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"育王寺","author":"薛嵎","text":"寺在众山里，白云深更深。\n不知行乐意，何似坐禅心。\n护塔龙常在，倚松僧独吟。\n渡江前赐字，珍重到于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茅屋","author":"薛嵎","text":"茅舍竹椽短，不劳朱垩施。\n高无神鬼瞰，贫与子孙宜。\n近古意全朴，当风势亦危。\n梅花有幽致，一树隔疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊外隐居","author":"薛嵎","text":"自是山林士，非因失志馀。\n儿童知稼穑，猿鹤近诗书。\n曙色浮沧海，春风满太虚。\n固穷须学力，不敢废经锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑氏时斋","author":"薛嵎","text":"力学竞分阴，俄惊岁月深。\n岂为科举地，自遂读书心。\n名教有馀乐，尘埃不可寻。\n肯同碌碌者，白首尚籯金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青藜阁为林景云赋","author":"薛嵎","text":"九斗峰前太乙临，星辰亦监此时心。\n楼高不碍光芒入，坐久忽惊风露深。\n千古圣贤书里见，吾身学问性中寻。\n夜窗勤苦追先哲，名字何分昔与今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣氏梅边","author":"薛嵎","text":"自入孤山咏，梅花最识诗。\n喜逢吟苦友，共此岁寒期。\n曙色雪初霁，暗香春未知。\n前村风景别，祇是爱茅茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春半","author":"薛嵎","text":"春半数风雨，水村增晓寒。\n不辞蓑笠重，自觉起居安。\n隔雾山疑失，占晴础未乾。\n可怜桃与李，无语受摧残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晴泛湖","author":"薛嵎","text":"平湖新涨绿，沙觜净涵波。\n芳草思无际，春风情最多。\n移舟动山影，止乐听渔歌。\n得意唯鸿鹄，高飞避网罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"省试舟中","author":"薛嵎","text":"阙下春光近，囊金又一空。\n霜风欺败絮，星斗隔疏篷。\n世道谁能挽，妻孥见未同。\n青灯对黄册，销尽几英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日书怀","author":"薛嵎","text":"万事荣枯一聚尘，尘中谁是独醒人。\n壮无学力吟将退，老入贤关路转贫。\n昨夜立秋凉到晓，空斋对月静如宾。\n首阳千载蕨薇绿，唯有夷齐纪逸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜宋希仁同吟松风阁有感","author":"薛嵎","text":"相逢长日坐如痴，瘦得吟肩耸过颐。\n天意复生郊岛在，人心自逐古今移。\n高秋月色行松顶，半夜山中读楚辞。\n此道若无千载后，尘昏何处照妍媸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋试下有感","author":"薛嵎","text":"焦桐何处是知音，犹向残编惜寸阴。\n此日便为终隐计，青山已负十年心。\n梅花独对寒流洁，野鸟高飞古木深。\n万古红尘徒扰扰，几人头上有朝簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵东阁奏院去国","author":"薛嵎","text":"帆远浙江风，莼鲈趣一同。\n无人持国是，举世咎诗穷。\n身退山林重，心怡学问充。\n冥鸿离罾缴，瞬息九霄空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵东阁倅越","author":"薛嵎","text":"百指忍贫需远次，壮心销尽鬓丝知。\n身如韦素居常泰，官被声名折得迟。\n束檐喜闻千里戍，出山唯有十年诗。\n兰亭风月应须记，人物依稀似晋时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追惜永嘉前政知县赵大猷时景定改元","author":"薛嵎","text":"兴言民父恩犹在，何故年来尽不如。\n清节苦于为士日，归装轻似到官初。\n月明往事寻思遍，灯下怀人音问疏。\n矫首天朝除目到，放教田里得安居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送友人之括苍","author":"薛嵎","text":"石门当半道，想见泊舟时。\n伴鹤立终日，就岩题几诗。\n近山秋易老，问隐地偏宜。\n我亦江湖去，心期尔得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘荆山","author":"薛嵎","text":"束书入京阙，忧国最情深。\n天意有兴废，人才无古今。\n布衣万言疏，孤剑一生心。\n直道嗟难遇，贾生终陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋饮冰过四明郡斋 其一","author":"薛嵎","text":"元戎招士重亲临，喜遂诗书万里心。\n乍免客愁供帐具，暂停游事戟门深。\n秋空矫首瞻魁彩，夜烛凭花听雁音。\n从此文名沧海阔，好风三日到鸡林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋饮冰过四明郡斋 其二","author":"薛嵎","text":"忆昔曾登太白巅，闲云留我石床眠。\n集诗删失题犹记，人事乖违岁屡迁。\n极羡故交游汗漫，不禁离思对婵娟。\n山中乏致兼金馈，形迹相忘二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送松风僧渊中二公游方","author":"薛嵎","text":"无累云相似，悠悠天地间。\n新秋生远思，此去未应还。\n撼锡惊栖鹤，听松思故山。\n吟诗与说法，同是一机关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送廉村宗人薛庭芝薛如晦还里","author":"薛嵎","text":"老我儒冠误，怜君亦固穷。\n山川居壤异，友爱所天同。\n江渡乘潮阔，霜林逐晓空。\n永怀楸垄敬，淹泊志难通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧自然过许峰","author":"薛嵎","text":"知心逢岂易，语别喜从容。\n因得静中趣，又寻云外峰。\n吟篇题在竹，拄杖曲如松。\n后会期难定，来书勿厌重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游雁山分得六题 其六 五老峰","author":"薛嵎","text":"岩前看不足，化此石为身。\n忆昔白头者，于中第几人。\n相逢应失笑，久立岂迷津。\n勿厌薜萝密，痴容免俗嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游雁山分得六题 其四 水帘谷","author":"薛嵎","text":"石壁斧修痕，风泉断续闻。\n琉璃光闪日，空洞湿飞云。\n妙出神功造，源从湫底分。\n谁能为钩起，深处谒龙君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游雁山分得六题 其二 龙鼻水","author":"薛嵎","text":"怪极生真想，饥凶祷请勤。\n半身鳞甲具，一勺渺瀰分。\n应谷声如鬼，飞空石碍云。\n精诚随寓在，亦以感通闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游雁山分得六题 其一 荡顶","author":"薛嵎","text":"高平馀十里，湖湗落中间。\n此地可耕凿，长年迷草菅。\n一庵犹有路，四望忽无山。\n道者了经课，慰余登陟艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游雁山分得六题 其五 照胆潭","author":"薛嵎","text":"彼我俱澄澈，中涵理趣深。\n游鯈具龙体，幽洞通潭心。\n影动猿摇树，沙明日耀金。\n片岩经霹雳，痕凿到于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜苦雨","author":"薛嵎","text":"华发负沧洲，星霜又一周。\n未凭终夜雨，能洗隔年愁。\n池草起吟思，树禽栖屋头。\n空馀壮心在，灯下看吴钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"项大著挽诗","author":"薛嵎","text":"耻为恩门屈，宁辞御史迁。\n力陈归老疏，自尽读书年。\n秘府神游地，浮荣梦觉前。\n世间真不死，未必属苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭中师雪崖","author":"薛嵎","text":"众里知心少，唯师是故人。\n临终书未答，昨夜梦全真。\n鹤唳浑如哭，花开不似春。\n近逢同住者，得问病元因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭瓢饮陈子在 其二","author":"薛嵎","text":"蝉蜕尘埃外，闲身乐未涯。\n山林天岂靳，脩短数难移。\n吟砚谁濡墨，空瓢想挂枝。\n深衣古贤貌，犹觊梦来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭瓢饮陈子在 其四","author":"薛嵎","text":"寝食难忘置，心怀故友情。\n花枝封蜡寄，诗递出门迎。\n忍听偏亲哭，相期嗣子成。\n乘除理终定，人事未容轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭瓢饮陈子在 其三","author":"薛嵎","text":"每恨去城远，番番语别难。\n论交置疏数，尽醉就团栾。\n事往遽成感，松彫不待寒。\n尚馀亲翰墨，收泪再三看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭瓢饮陈子在 其一","author":"薛嵎","text":"案头萤火散，惆怅夜吟魂。\n路暗重泉迥，堂空半影存。\n命无藜藿富，书独鬼神尊。\n猿鹤声声怨，愁人不可言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭薛元善兄弟","author":"薛嵎","text":"寂寞一窗灯，随风灭又明。\n空堂连夜雨，白发哭儿声。\n树色悲摇落，交情隔死生。\n唯应骨肉爱，为鬼亦同行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐补阙清风亭","author":"薛嵎","text":"去国遗忠荩，朝盘托讽深。\n因知洁己意，亦是爱君心。\n貌像意全古，子孙贫至今。\n清风如可继，块土已埋沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐太古主清江簿","author":"薛嵎","text":"四灵诗体变江西，玉笥峰青首入题。\n旧隐乍违鸥鹭去，新篇高与簿书齐。\n身闲自喜瓜期远，俸薄还因楮价低。\n掺别正逢寒食日，洞庭春渌草萋萋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈运管安人孙氏","author":"薛嵎","text":"舅家如母在，恸哭泪沾襟。\n平日经声断，兹晨佛力深。\n墓庐犹手构，梱则是夫箴。\n山上半慈竹，从知契夙心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅中秋夜","author":"薛嵎","text":"车马日西东，阮生途自穷。\n三年辞旧国，今日又秋风。\n边雁凄凉过，池花寂寞红。\n邦人惯相识，渐觉语音通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅店早起","author":"薛嵎","text":"半醒梦犹在，拥衾无限情。\n晓窗灯影淡，山路雪吟清。\n岁暮羡归客，囊空兼去程。\n故书多废理，惊愧动心旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柴门","author":"薛嵎","text":"春风随处好，吟事又相催。\n触石云飞去，呼童鹤误来。\n杖藜无疾步，花地有香埃。\n不许车尘入，柴门只半开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中感兴","author":"薛嵎","text":"风霜岁又除，藜杖步徐徐。\n儿辈忧无药，床头喜有书。\n背因曝日暖，交为诉贫疏。\n天定由人事，不如深闭庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真隐寺呈延上人","author":"薛嵎","text":"塔光圆照室，香炷读经晨。\n林下有清福，尘中无悟人。\n岩阴常候雨，松色不知春。\n青草何年墓，标题界碣新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"素上人圆鉴","author":"薛嵎","text":"何须百鍊取晶荧，大化非由巧力成。\n所性本来无阙蚀，认形却恐未分明。\n寒泉深夜辘轳静，素魄中天世界清。\n到此万缘皆了了，笑他拂拭堕缠萦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"素上人游方","author":"薛嵎","text":"山深不可见，一锡又云飞。\n梵译通方语，林霜点衲衣。\n神闲生境寂，思苦入吟微。\n寒月空相照，何人夜扣扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾鹿岩","author":"薛嵎","text":"不是长江派，因何亦好吟。\n从知世味淡，自觉野情深。\n科举无名字，案头唯古今。\n新铭为读尽，可惜老山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭氏抗云楼","author":"薛嵎","text":"宴坐群峰表，太空无一尘。\n青山独往意，白首自由身。\n放鹤重霄阔，凭栏万木春。\n纷纷荆棘里，跬步亦逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭氏遗经堂","author":"薛嵎","text":"校雠存手泽，肯构烱前光。\n际此圣明代，应无屋壁藏。\n半窗分雪影，群蠹避芸香。\n静想趋庭意，居然师友旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高氏石云","author":"薛嵎","text":"阆仙曾得句，月下自推敲。\n以此幽闲趣，长为淡泊交。\n水寒梅照影，霜滑鸟归巢。\n余亦同怀者，从君结把茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄公衮舍弟","author":"薛嵎","text":"每恨世交薄，相期情最深。\n秋风一回首，明月两关心。\n鹤病难为药，砂顽不化金。\n余生百计拙，耐可事清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄宋希仁兄弟","author":"薛嵎","text":"咫尺不相见，闭门唯苦吟。\n听残寒夜雨，灰尽壮年心。\n身外一贫在，灯前百虑深。\n所欣交友义，白首亦如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄罗浮杨天经居士","author":"薛嵎","text":"罗浮峰对海坛峰，只隔长江半里风。\n君向西方了生死，我于易象悟穷通。\n数声清梵空林下，一幅渔罾落照中。\n各各闭门无俯仰，不相同处偶相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄珂雪屋","author":"薛嵎","text":"积雪覆茅屋，僧居清更清。\n浮生千劫尽，长日一灯明。\n野鸟呼能下，山灵避不行。\n旧时江月住，时听诵经声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"康氏端斋","author":"薛嵎","text":"于焉能取友，人己两无偏。\n立行有如此，前脩宜比肩。\n吟情近风雅，胸次著林泉。\n愧我全迂僻，交游又十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼张寺丞","author":"薛嵎","text":"五马归来绝送迎，全将沤泡视浮荣。\n宅依林麓楼台小，门有诗书气味清。\n身后只如僧冷淡，墓头曾是手经营。\n夫人扶疾秋窗下，深夜看经带哭声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村会诸友戏呈","author":"薛嵎","text":"矶头濯足动沧浪，独醒何曾与世妨。\n尽写骚经粘屋壁，未逢渔父似潇湘。\n远山不离烟云色，流水时闻兰杜香。\n制得荷衣恐惊俗，对人称是楚贤装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村有感","author":"薛嵎","text":"小窗长日苦吟声，独倚阑干看晚晴。\n居士莫疑贫可弃，春风不为病相轻。\n梅边纸帐重重影，壁上离骚字字清。\n鸥鹭往来情更熟，只消此地度残生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村即事","author":"薛嵎","text":"维舟古渡头，四望是汀洲。\n水阔唯宜夏，荷枯不碍秋。\n困归牛背稳，晓汲井云浮。\n独坐愁无侣，多番为月留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村远望因思槐径弟同游之乐","author":"薛嵎","text":"满山残雪满溪云，唯有沙鸥独见亲。\n往事不堪频入梦，吟篇无数更愁人。\n扁舟欲渡同谁载，破衲蒙头近六旬。\n尚拟来生因可结，凄凉何处问苍旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔村偶题","author":"薛嵎","text":"莫道柴门窄，断无车马声。\n苦吟成集少，久病见人生。\n花落寒犹在，春阴雨未成。\n渔村名自我，鸥鹭勿相轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖外别业四咏 其二 渔村晚照","author":"薛嵎","text":"旧游忆得潇湘路，今喜烟波似旧时。\n泽畔怕逢渔父问，桃源已被世人知。\n数家草市添新户，一树寒鸦傍古祠。\n兰杜香深洲渚阔，小窗长日赋骚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家","author":"薛嵎","text":"生涯渔业在，屋漏旋增茅。\n莫道直钩拙，翻同稚子敲。\n夜灯切竹火，宾坐具山肴。\n中有白头者，离骚手自抄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖外泛雪","author":"薛嵎","text":"雨雪连朝意未休，支筇难步最高楼。\n梅花不识春风面，野水相平古渡头。\n船上看山无屋碍，尘中阅世似沤浮。\n一生穷苦缘诗僻，莫把诗穷认作愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢松冈侄惠诗","author":"薛嵎","text":"韦布名犹盛，诗书不负人。\n每过临水宅，长想钓鱼身。\n思苦诗难和，岁寒交始真。\n乃翁怜病久，余病复兼贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋山云侄偶锄","author":"薛嵎","text":"扶犁人所贱，何苦事耕耘。\n生意未终息，雨声曾厌闻。\n诗书长在手，畚锸岂劳君。\n祇恐青云上，能将此志分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋中上人顽坐","author":"薛嵎","text":"嗜吟忘夜冻，立雪此同机。\n工苦精灵聚，毫端造化归。\n石床趺半结，荒径叶频飞。\n客至应相讶，无心听扣扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王九山沧浪阁","author":"薛嵎","text":"千年孺子吟，谁会此时心。\n方寸有泾渭，烟波无古今。\n水禽知雨候，山气爱秋深。\n不尽凭栏意，桡歌归故林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]