[{"title":"同游赏心亭用前韵 其二","author":"史浩","text":"赏心多乐事，快目喜联犀。\n雪浪翻空急，江云过眼低。\n天寒风着袂，兴尽马旋蹄。\n归路仍泥滑，林间语竹鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪景卢右司问梅","author":"史浩","text":"东皇荣万木，首倡属江梅。\n得地应先发，须时不受催。\n可堪连日冷，未忍一樽开。\n竹外摇残雪，知君到几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵皇孙所和二诗 其一","author":"史浩","text":"锦绣环清跸，祥云捧日华。\n千官鹓鹭集，万骑虎貔誇。\n馀孽皇威远，中原望眼赊。\n遥怜太液水，波煖欲生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵皇孙所和二诗 其二","author":"史浩","text":"岁晚垂弧旦，雍容从北征。\n龙舟瞻日表，兔苑足诗情。\n况有流霞美，何辞醉玉倾。\n祝君无限寿，烟阁寄功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯冯圆中吏部出守","author":"史浩","text":"蚤岁登巍第，即潜正黑头。\n一封忧国虑，五马便乡州。\n笔底平生学，胸中康济谋。\n胜须勤蓄积，圣主欲兼收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"进明堂庆成诗","author":"史浩","text":"六阅淳熙祀，秋高日仲辛。\n大君敷涣号，重屋荐明禋。\n玉辂兴清庙，龙旂亘紫宸。\n云阴连夜解，霁色一朝新。\n周礼樽罍备，虞韶乐舞陈。\n合宫天地并，侑席祖宗均。\n峻墄登三献，脩楹秩百神。\n肃祗伸睿意，肸蚃降高旻。\n宣室宜膺福，慈闱亟拱宸。\n簪花驰万骑，归胙见双亲。\n釐事超隆古，年龄肇亿春。\n蓼萧覃有截，成命播无垠。\n惠馂颁群后，恩波逮老臣。\n祝尧非健笔，徒学华封人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"经筵读正说终篇恭进谢恩感遇诗","author":"史浩","text":"帝祚隆三叶，仁风被九垠。\n泥金封禅后，汗简典坟新。\n祖训敷皇极，奎星耀紫宸。\n儒家尊首志，文论歉前尘。\n好生兵遂偃，崇俭俗还淳。\n传宝参河洛，重光待圣神。\n求讲深紬绎，退访极咨询。\n治绍尧稽古，欢谐舜事亲。\n披编兹有获，彻卷岂辞频。\n锡予恩波浃，荣华宴俎陈。\n奏诗无杰句，拜手愧名臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵孙季和东湖二诗 其二","author":"史浩","text":"水拭双鸾镜，山环六曲屏。\n云端迸朝日，木杪见疏星。\n梅坞春长在，柴门夜不扃。\n援琴谁写景，思得与君听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送安之往依沈叔晦师席","author":"史浩","text":"吾孙年甫冠，抗志在青冥。\n重趼轻千里，求师为一经。\n功名适来去，器识是丁宁。\n既得贤模范，归欤喜过庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蚁王得知字","author":"史浩","text":"蠢蠢称蝼蚁，尊王世所知。\n峻台存主礼，环穴受臣仪。\n依战如扬武，排行似出师。\n南柯虽一梦，治国得良规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜃楼得生字","author":"史浩","text":"青蘋风乍息，巨浸欲潮平。\n毒雾方看吐，层楼忽已成。\n凭栏无海若，吞鸟类罗生。\n安得挥长剑，驱除致永清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蛩吟得时字","author":"史浩","text":"虫唯蜻蛚类，近渐实知时。\n露重哦寒晓，更深揽夜思。\n堂中讥晋什，床下诵幽诗。\n唧唧俱成咏，何曾撚断髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花须得中字","author":"史浩","text":"花有千跗萼，藏须向个中。\n怒张擎晓日，笑剪寄春风。\n虬捲香丝乱，龙掀腻粉丛。\n露沾尤的皪，唾玉在髼鬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳带得归字","author":"史浩","text":"渭水亭亭柳，春柔可绾衣。\n烟添染黛色，风束舞腰围。\n对影同心在，攀条解赐归。\n行人系不住，结绶上王畿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨丝得秋字","author":"史浩","text":"千丝棼不乱，细雨忽盈眸。\n密密如机捲，疏疏岂茧抽。\n纫裳难作缝，欲钓不胜钩。\n霢霂知何事，收功在有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"豆粥得容字","author":"史浩","text":"残腊风霜劲，嘉宾嘉会逢。\n清泉云子滑，熟末桂香浓。\n金谷咄嗟具，芜蒌仓猝供。\n争如金雅宴，樽酒共舂容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙花得看字","author":"史浩","text":"奇姿擅水仙，长向雪中看。\n翠碧瑶簪盍，鹅黄粉袂攒。\n夜阑香苒苒，风过佩珊珊。\n著在冰霜里，姮娥御广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钟馗图得人字","author":"史浩","text":"虬须张怒目，蓝绶亸乌巾。\n抃舞身无定，驱除梦有神。\n收功祛疟鬼，流咏起唐人。\n图画高悬处，明朝庆履新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"椒盘得多字","author":"史浩","text":"有美椒盘献，三朝庆始和。\n灵茎丛玉敦，酝酒满金荷。\n不向汤铭见，其如晋颂何。\n欲知勤祝处，功在历年多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗社得神字","author":"史浩","text":"今宵文会友，作句擅清新。\n始也诗言志，终焉笔有神。\n既无折角者，宁有面墙人。\n只待逢真主，艰难七月陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叔父知县庆宅并章服","author":"史浩","text":"芝检荧荧金缕黄，拜恩初捧鹊炉香。\n花笼丽日晖朱绶，燕啄新泥上画梁。\n歌遏行云莺睍睆，舞飘回雪蝶轻狂。\n一卮竞祝双椿老，伫看于飞到玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵权郡钱直阁鹿鸣宴","author":"史浩","text":"去去无材策治安，全资风力助轻翰。\n欲平紫气频侵斗，当倩中书为脱冠。\n香入梅梢春意近，德将鲸饮玉杯残。\n珠玑更复传华衮，荣比青霄驾綵鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱直阁和吕支盐梅花","author":"史浩","text":"隐隐仙安迥出群，朅来还是一番春。\n山墙倚雪凝姑射，水国临风咏洛神。\n清洗娇腮全恶粉，快飞幽馥去朝真。\n直交别浦停三弄，羞作高楼欲坠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵汪元举以诗觅时季和海棠花栽","author":"史浩","text":"一纸淋漓醉墨鲜，锦囊连夜到溪边。\n搜求仙种宁辞远，恼乱花神不使眠。\n弄影未看妃子态，补亡先得少陵篇。\n明年应向东风里，百绕雕栏玉步连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王正之惊蛰有感言归","author":"史浩","text":"闻说天家起阿香，揽桃催杏脸无央。\n夜蟾不解照仙李，朝雨何妨梦楚王。\n知买扁舟成折柳，剩哦佳句作甘棠。\n故园风物虽云好，何必归程遽许忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江倅出家乐","author":"史浩","text":"沈沈春酌话绸缪，花月行船看拍浮。\n手束柔荑调雁柱，袖翻纹锦出香毬。\n未攀青子犹如豆，欲脍赪鳞始上钩。\n蓬岛古来无觅处，我曹今此得真游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"范干招兄显道","author":"史浩","text":"片帆落处是三山，绝景尘居了不关。\n梦草池塘如有得，对床风雨亦非艰。\n骑鲸渡海风生腋，挥麈谈玄笑满颜。\n从此清名追二陆，锦囊赓和不容閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴 其一","author":"史浩","text":"人言铨选异堂除，我笑兹言亦太迂。\n四海九州均一治，六曹三省岂殊途。\n春风到处林无槁，夏雨通时物尽濡。\n会得只将忠实报，门生恩府漫称呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴 其二","author":"史浩","text":"世间谀佞枉求多，忠实由来曷可磨。\n谋寝两淮须仗汲，乱消六馆独由何。\n当年乌府心无挠，今日鸾台道不颇。\n若也随时效谀佞，岂能功业许巍峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴 其三","author":"史浩","text":"人材莫谓世全无，用则贤良弃则愚。\n孔圣既生颜闵在，周家才起甫申俱。\n归恩报德还忠实，附热趋炎属佞谀。\n散尽田文门下客，独馀冯子是名儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴 其四","author":"史浩","text":"世间无处是坚牢，富贵功名亦谩劳。\n一昃一盈天外月，再生再汐海中潮。\n红尘衮衮知何补，白发骎骎谁得饶。\n加我数年专读易，定须轻举到烟霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送商筑叟赴南省","author":"史浩","text":"少微烨烨瑞光开，壮士昂头出草莱。\n健笔伫倾三峡水，晴空争听一声雷。\n恩承淡墨金门启，宴锡奇花玉女栽。\n预想春风掉归鞅，西郊翠霭上衣来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵商筑叟雪","author":"史浩","text":"风威云势两徘徊，故遣瑶花扑面来。\n兔苑芳菲谈笑得，玉京门阙等閒开。\n光浮编简浑疑月，香入杯觞始认梅。\n为报寒乡几冰室，功成却拟放春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上平江守徐侍郎生日 其一","author":"史浩","text":"翼轸腾光万代尊，地灵人杰萃侯门。\n紫芝秀宇尘无染，黄宪澄波挠不浑。\n泥湿丹书双彩凤，香凝画戟两朱轮。\n生朝有客成飘泊，犹寄巢莲碧玉樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上平江守徐侍郎生日 其二","author":"史浩","text":"时节文章与盛衰，我公端合振中微。\n玉锋修满姮娥月，天巧分残织女机。\n正始风流回治世，豫章宗派得传衣。\n知音久矣烦牙颊，一瓣炉熏心所归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上绍兴守俞阁学生日 其一","author":"史浩","text":"扶舆光气拥清苕，竦记真儒载诞朝。\n天令聿新青帝律，王正初御紫宸朝。\n已开师幕居东陕，行握台符侍九霄。\n春醑如渑介眉寿，亦应兼喜颂陈椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上绍兴守俞阁学生日 其二","author":"史浩","text":"试向黄堂寿我公，庞眉齯齿气冲融。\n乌飞会看三松老，鲸饮何辞百榼空。\n的皪方瞳曜迟日，扶疏绿鬓受春风。\n摩挲铜狄长安道，肉眼它年记此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上绍兴守俞阁学生日 其三","author":"史浩","text":"自从戟钺临东阃，恋恋车尘拜紫芝。\n排雾已逢回阮眼，持蠡谁解测黄陂。\n知音不借一人誉，走驿聊驰千岁诗。\n桃李从今满天下，月明乌鹊得依枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵高宰谢朱倅惠酒","author":"史浩","text":"仙庐深倚翠微间，酬答风烟肯暂閒。\n不遣长须干美政，却驰双榼破愁颜。\n句高饭颗人应瘦，醉著河阳鬓未班。\n楚客秋情正无赖，并须乞取展眉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上高提举生日 其一","author":"史浩","text":"淡荡春光二月馀，郁葱佳气霭扶舆。\n杏园高萼红千颗，银汉新蟾玉一梳。\n控鹤暂辞仙府籍，观风聊拥使星车。\n香萦画戟簪裾盍，赢得长生几卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上高提举生日 其二","author":"史浩","text":"圣主龙飞念故人，侯门雨露一番新。\n登瀛已宠皇华贵，被綵专荣白发亲。\n好语旧闻千岁鹤，仁风今扇七州春。\n定知福寿无边际，坐看云来舞绣茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟进讲筵尚书终篇锡宴诗 其一","author":"史浩","text":"煌煌典诰炳丹青，圣主于今集大成。\n已究商周真灏噩，固知尧禹本聪明。\n神驰帝乐翔云海，恩逐天香到酒觥。\n下拜龙威瞻咫尺，群臣始觉倍光生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟进讲筵尚书终篇锡宴诗 其二","author":"史浩","text":"蚤朝论道沃宸聪，更许经生侍九重。\n万卷精微归一览，小儒糟粕受三冬。\n明兼舜目超唐汉，宴锡需云法祖宗。\n愧乏涓尘裨海岳，今辰亦得奉舂容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题蒋学正三径庵 其一","author":"史浩","text":"浮名两角竞蜗牛，举世谁人肯罢休。\n鼻祖独能轻汉魏，耳孙宁不慕羊求。\n似闻竹外三家市，犹占溪头十里秋。\n安得枯藤破烟暝，细寻佳处赋清幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题蒋学正三径庵 其二","author":"史浩","text":"纷纷俗子信么么，过眼何须问唯阿。\n三径固知皆坦路，一庵聊复障颓波。\n陶潜彭泽思松菊，贺老鉴湖吟芰荷。\n闻说与君同得道，月明风静每相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题左举善郊居四绝 其一 草堂","author":"史浩","text":"莫随朝叩合休休，万里今谁没白鸥。\n付与幽人几椽屋，不须吴咏忆扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题左举善郊居四绝 其二 听松","author":"史浩","text":"不吟柳绿与桃红，久要论交十八公。\n想得阶前月如剪，独将双耳立西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题左举善郊居四绝 其三 浮香","author":"史浩","text":"横枝靓立碧山傍，喷得幽香度短墙。\n更欲移筇约和靖，小风吹月咏沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题左举善郊居四绝 其四 总相宜堂","author":"史浩","text":"自倚倾城绰约娘，不争时世作新妆。\n若将西子相唐突，正恐莲花似六郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题处州录参厅平远楼","author":"史浩","text":"山川著意吐幽奇，秾淡风烟总令姿。\n大似鹅溪垂数幅，饱看摩诘画中诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵恩平郡王晚步","author":"史浩","text":"步履蘅皋取次游，日华清淡雨云浮。\n天公不喜烧银烛，乞与归途玉一钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵馆中秋香 其二","author":"史浩","text":"亭亭万叶剪青罗，岂为冰霜便改柯。\n满著珠玑间金粟，倩谁纤手剖天鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分题得花露双字韵","author":"史浩","text":"凝红湿翠媚春江，残月幽香度晓窗。\n正恐枝头珠作颗，冷惊宿蝶去双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题雪窦随凫岩","author":"史浩","text":"纷纷飞雪堕青天，穷彻随凫信有源。\n想得王乔之帝所，每来岩下涤潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"因见父老云东湖九百九十顷七十二溪故有是作","author":"史浩","text":"东湖九百九十顷，七十二溪攒翠波。\n乞我扁舟任飘泊，却敲明月叫渔歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和建王春晚园中赏玩","author":"史浩","text":"静院朝回静鼓琴，浴沂新咏间清音。\n燕閒未省忘稽古，始信贤王宝寸阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题严陵钓台","author":"史浩","text":"功名于道九牛毛，无怪先生抵死逃。\n漠漠桐江千古后，云台何似钓台高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题雪窦飞雪亭","author":"史浩","text":"苍岷万仞起岩峦，悬瀑霏霏六月寒。\n波及下方俱润泽，人间须作六花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题雪窦妙峰亭","author":"史浩","text":"松篁一径曲通桥，直上危亭十里遥。\n但觉群生俱頫首，不知身已在云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁酉八月十三日夜以经筵官番宿翰苑予十五年前曾为学士 其一","author":"史浩","text":"玉堂夜直看蝇头，烛尽双莲兴未休。\n檐外忽惊凉月在，正移花影到银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁酉八月十三日夜以经筵官番宿翰苑予十五年前曾为学士 其二","author":"史浩","text":"忆昔初为鳌禁游，油拳草制拜公侯。\n沈思十五年前事，壮志消磨雪满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁酉八月十三日夜以经筵官番宿翰苑予十五年前曾为学士 其三","author":"史浩","text":"青烟漠漠已潜收，但见银潢双派流。\n白玉一轮尤皎洁，始知后夜是中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 和镇国闻笛","author":"史浩","text":"碧溪浮月练光寒，一曲风传到枕前。\n应在南楼尽深处，玉梅飞坠学榆钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 苔钱","author":"史浩","text":"谁将翠靥出青箱，散在瑶阶作孔方。\n好是楼头三弄后，田田买断落梅香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 草茵","author":"史浩","text":"眼眩初疑绿锦张，风回犹带袜尘香。\n连堤费尽天孙巧，乞与行人卧夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 野望","author":"史浩","text":"閒云黯淡草萋萋，楚泽风高雁阵低。\n拟倩王维画平远，正须六幅剪鹅溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 笋指","author":"史浩","text":"春来初见着斑衣，一束纤纤玉未肥。\n试捧银笙按工尺，听君一曲阮郎归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 羞","author":"史浩","text":"隐隐双娥翠黛攒，半遮团扇下云端。\n背人不语为何事，娇怯应嫌众目看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]