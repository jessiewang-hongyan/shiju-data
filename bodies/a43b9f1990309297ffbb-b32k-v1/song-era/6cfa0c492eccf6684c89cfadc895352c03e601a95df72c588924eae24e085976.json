[{"title":"寄久监收","author":"释重显","text":"田中稻熟及时收，颗粒圆成免外求。\n一日归来古岩上，白云红树共悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄于秘丞 其一","author":"释重显","text":"石径通岩窦，引步藏攲侧。\n蓬莱人不来，扫尽苍苔色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄乌龙长老","author":"释重显","text":"雪带烟云冷不开，相思无复上高台。\n江山况是数千里，只听嘉声动地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄内侍太保 其二","author":"释重显","text":"萝龛藓室狎猿猱，忽捧纶言挂紫袍。\n恩大不知何以报，五云天上望空劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄内侍太保 其一","author":"释重显","text":"千尺岩泉喷冷声，草堂云淡竹风清。\n蒲团时倚无他事，永日寥寥谢太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄天童凝和尚","author":"释重显","text":"经旬抱疾阻春霖，莎砌重重藓晕侵。\n曾约偕游未能得，暮山空锁碧云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄太平端和尚","author":"释重显","text":"千朵危峰杳霭间，石房长带瀑声寒。\n鸟啼花发寻常事，松本青青雪里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄四明使君沈祠部 其二","author":"释重显","text":"苍苍德也亦如斯，政化全归副倚毗。\n十万人家写春色，不知谁解立生祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄四明使君沈祠部 其一","author":"释重显","text":"露冕民谣物物成，江山千里古风清。\n曹溪客是无机者，日在深云听颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘秀才","author":"释重显","text":"远远飞来一幅书，愈风诚重复何如。\n相逢相见未期日，目断千山插太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄池阳曾学士","author":"释重显","text":"山万重兮水万枝，堆青流碧冷便宜。\n算来免得生遥恨，不在诗情在祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄员外黄君","author":"释重显","text":"碧岫层层列杳冥，涟漪环绕贲寒青。\n韬藏未识古君子，空仰嘉声过洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李都尉","author":"释重显","text":"水月拈来作者殊，东西南北谩区区。\n也知金粟李居士，端坐重城笑老卢。\n咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄灵隐惠明禅师 其一","author":"释重显","text":"千峰影里叶初凋，极望还将慰寂寥。\n也谓毫端不相隔，秋云秋水奈遥遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈悦秀才","author":"释重显","text":"水中得火旨何深，握草由来不是金。\n莫道庄生解齐物，几人穷极到无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄承天长老","author":"释重显","text":"道义相资复是谁，岩房深夜思迟迟。\n海山云静见孤月，高照婺城人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄送疑长老","author":"释重显","text":"德不孤兮必有邻，四明留住是因循。\n如今高步钱塘境，只许灵山个老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄海会之长老","author":"释重显","text":"百花开后一花开，风递清香远远来。\n谁问黄梅不平事，照中依旧惹尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曹都护","author":"释重显","text":"故国休言万里程，为官为释且分明。\n道存不必曾倾盖，俱有清风匝地生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦迹自贻","author":"释重显","text":"图画当年爱洞庭，波心七十二峰青。\n如今高卧思前事，添得卢公倚石屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"释重显","text":"春光冉冉岸烟轻，水面无风钓艇横。\n千尺丝纶在方寸，不知何处得鲲鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜禅人回山","author":"释重显","text":"别我游方意未论，瓶盂还喜到云根。\n旧岩房有安禅石，再折松枝拂藓痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答当生不生","author":"释重显","text":"咄咄休强名，刍狗亦为累。\n寂寥金粟身，曾未求诸己。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢张太保见访","author":"释重显","text":"老病还同叶半凋，经旬门掩夜萧萧。\n海城都护曾垂访，一片清风慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢郎给事送建茗","author":"释重显","text":"陆羽仙经不易誇，诗家珍重寄禅家。\n松根石上春光里，瀑水烹来斗百花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢鲍学士惠腊茶","author":"释重显","text":"丛卉乘春独让灵，建溪从此振嘉声。\n使君分赐深深意，曾涤禅曹万虑清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋月生云际送诚监寺","author":"释重显","text":"皎洁离云鹤梦时，孤光还与雪相宜。\n金盂后夜重垂影，拂尽天风不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道贵如愚","author":"释重显","text":"雨过云凝晓半开，数峰如画碧崔嵬。\n空生不解岩中坐，惹得天花动地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬李校书","author":"释重显","text":"一回辞我一回吟，眷恋岩丛意转深。\n翻谢霜松不凋落，与君同有岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问四宾主因而有颂颂之 其九","author":"释重显","text":"宾主分不分，颟顸绝异闻。\n解布劳生手，寄言来白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问缘生义","author":"释重显","text":"义列缘生笑未闻，孰呈布鼓向雷门。\n金刚铁券诸方问，报道三千海岳昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静而善应 其二","author":"释重显","text":"对扬殊特本同参，谁自辽空强指南。\n今古不存师弟子，一轮秋月印寒潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠琴僧","author":"释重显","text":"太古清音发指端，月当松顶夜堂寒。\n悲风流水多呜咽，不听希声不用弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千里不来","author":"释重显","text":"不见古君子，因循又隔秋。\n浮生多自掷，好事更谁留。\n碧巘高沉月，寒云静锁楼。\n宗雷何处是，白鸟下汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺送僧","author":"释重显","text":"雪霁莲峰顶，孤禅起石床。\n向时机自绝，异域路空长。\n啼狖冲寒影，归鸿见断行。\n后期无定迹，烟水共茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永丰庄新植径松忽二本邻偃抒辞纪之","author":"释重显","text":"双偃松何似，螺文结数遭。\n清声虽竞发，寒影不相高。\n对客圆分盖，孤禅翠滴袍。\n若教图画得，争奈有萧搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同于秘丞赋瀑泉","author":"释重显","text":"大禹不知凿，来源亦自成。\n色应邻众白，声合让孤清。\n远势曾吞海，飞流未喷鲸。\n灵槎如可泛，天派问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陆学士夏日见寄","author":"释重显","text":"良牧归诗匠，雅风消郁蒸。\n官清难滞爵，吏散远同僧。\n棠树非烟合，仙槎碧浪乘。\n因思穷万化，千古更无能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范监簿 其一","author":"释重显","text":"吏散帘垂思莫穷，山光溪影恣相容。\n谁誇靖节偏栽柳，自笑隐居高听松。\n丹阙尚遥芝检密，讼庭闲列藓花重。\n岩间野客虽多病，终再携筇谒士龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾推官示嘉遁之什","author":"释重显","text":"少微星出古风还，匝地声光不掩关。\n三馆峻迁同陌路，九华高卧是蓬山。\n岩莎步入祥麟稳，海树飞来白凤闲。\n祗恐致君休未得，蒲轮重到薜萝间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晴野步","author":"释重显","text":"乘兴携多士，迟迟傍水濆。\n春山不在目，啼鸟共谁闻。\n片石寒笼藓，残花冷衬云。\n只应融老辈，庵际境犹分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送天童普和尚","author":"释重显","text":"迢迢别海涯，帆挂杪秋时。\n岛树落寒叶，人谁访祖师。\n浪开游象急，天阔过鸿迟。\n早晚归林下，千徒不共知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郎侍郎致政归钱塘","author":"释重显","text":"帆挂西风别海城，二疏千古道相应。\n谁誇富贵沽时誉，自笑经纶作技能。\n残叶赋题红片片，远山供望碧层层。\n武林到日符嘉遁，高访岩扃祇许僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送通判刘国博","author":"释重显","text":"为星当贰职，权化不相饶。\n白屋如多恨，清风何处消。\n岸鸥窥列旆，天辟看升朝。\n别有生灵意，寒枝未变条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱太博应贤良选","author":"释重显","text":"贤才当召试，彪炳对吾君。\n千古不遗恨，八元应主文。\n岸花明列旆，天籁拂微云。\n后夜观垂象，中台位已分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送铁佛专使","author":"释重显","text":"荷策来寻我，泛舟思旧山。\n不知何处月，相照在深湾。\n风助秋涛急，云兼野树闲。\n到时如请益，先忆赵州关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送简能禅者归仙都","author":"释重显","text":"荷策下丹嶂，纷纷雪正飞。\n浮生谁未到，旧国自重归。\n云背猿声断，天遥鹗影微。\n莲城古风月，又得振清机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧","author":"释重显","text":"知方流古意，云树别诸邻。\n月不澄微水，山应立是尘。\n静空孤鹗远，高柳一蝉新。\n欲究劳生问，归思莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧","author":"释重显","text":"凉飙新叶坠岩阴，禅起高秋别翠岑。\n孤月冷光清有兴，断云闲影合无心。\n瓶分吴浪情何极，钵化膺门道更深。\n好是却回旧房日，倚栏同看橘铺金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧之金陵","author":"释重显","text":"胜游生末迹，杳自狎时群。\n卷衲消寒木，扬帆寄断云。\n曙瓶花外汲，午磬浪边闻。\n别后石城月，依依远共分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作","author":"释重显","text":"列岫霁新雨，凭栏秪澹交。\n夕阳明远水，秋叶露空巢。\n思极曾无玷，神清未动爻。\n祇应千古意，谁得共云坳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石秘校","author":"释重显","text":"重林冥坐久，引望复迟迟。\n烦暑未消日，凉风来几时。\n天云飞积火，岩溜散垂丝。\n欲拟相寻去，浮生已共知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋瑞雪送穆大师","author":"释重显","text":"五六皆名出，飘花独见稀。\n若教同一色，还似负群机。\n玉马犹空说，铜驼转更非。\n争如千万里，相对共依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞于秘丞","author":"释重显","text":"永夜潜思槁木身，蓬仙门馆渐经旬。\n虽干清政为高客，争奈白云无主人。\n岩泻瀑泉机未息，雨零寒叶梦犹频。\n此时贤宰容归去，古像焚檀祝有因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧归霅上","author":"释重显","text":"海国浮轻楫，悠悠兴未阑。\n草随春岸绿，风倚夜涛寒。\n沙鹭宜相狎，霜蟾望更宽。\n河声西听日，谁得共云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三宝赞 佛宝","author":"释重显","text":"甘蔗流苗应刹尘，觉场高发利生因。\n紫金莲捧千轮足，白玉毫飞万德身。\n孤立大方资定惠，等观含类舍怨亲。\n挨星相好中天主，匝地名闻出世人。\n螺发右旋仙岛碧，月眉斜印海门新。\n鸾翔凤舞非殊品，象转龙蟠绝比伦。\n璎珞聚中腾瑞色，花鬘影里夺芳春。\n慈仪恋望知何极，梵德言辞莫可陈。\n胸字杳分无量义，顶珠常照百由旬。\n双林孰谓归圆寂，坐断乾坤日见真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三宝赞 法宝","author":"释重显","text":"后得智生功德聚，大悲留演润禽鱼。\n贯花虽自科千品，标月还归理一如。\n过量劫应期广布，刹那心合未忘书。\n四衢道内抛红焰，五欲波中绽白蕖。\n排斥众魔登寿域，引携诸子上安车。\n义天星象荧荧也，辞海波澜浩浩欤。\n违背此恩难拯拔，遭逢末世岂踌躇。\n闻来半偈须相敩，惜去全身莫共居。\n飞辩恨曾亏激问，颐幽欣且免长嘘。\n生生顶奉辉心镜，廓照尘劳信有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三宝赞 僧宝","author":"释重显","text":"方袍圆顶义何宣，续焰千灯岂小缘。\n花雨座前犹滞相，虎驯庵畔尚稽诠。\n岩栖冢宿难依望，鹤貌云心迥洒然。\n宝杖夜鸣寒峤月，铜瓶秋漱碧潭烟。\n名标练若澄諠猾，迹念昏衢警睡眠。\n林下雅为方外客，人间堪作火中莲。\n情高不是超三际，道在非同入四禅。\n浮世勉谁知逝水，深峰甘自听飞泉。\n苾刍草馥僧祇后，玳瑁盂传古佛先。\n珍重觉皇有真子，坤维高步列金田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行逢勤禅德","author":"释重显","text":"乳岩秋日无他作，策杖层层止寥廓。\n四顾有谁分野情，一点彤云起深壑。\n藓石迟迟略轻踞，逢个衲僧忽骤步。\n频唤回头不肯回，及至回兮眉卓竖。\n阿喇喇，千里万里横该抹。\n咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌龙和尚","author":"释重显","text":"空岩清夜坐，藓径积深雪。\n瞑目思古人，彻曙落残月。\n童敲石磬寒，猿挂枯枝折。\n杳杳无限情，分明向谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门俱字","author":"释重显","text":"百草头，何太极，重与禅徒下锥刺。\n云门俱字好参详，雪峰辊毬亦端的。\n黛非青兮蓝一色，辰锦砂兮敢言赤。\n紫罗帐里有真珠，曹溪路上生荆棘。\n还会么，此时若不究根源，直向当来问弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日暮游东涧 其五","author":"释重显","text":"极目生晚照，蓬莱匪仙境。\n钓得十二鳌，重来谢孤影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日暮游东涧 其三","author":"释重显","text":"极目生晚照，幽情眷兰芷。\n白蘋叶里风，不在秋江起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日暮游东涧 其一","author":"释重显","text":"极目生晚照，溪云偶成朵。\n大朴曾未分，青山自唯我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日暮游东涧 其二","author":"释重显","text":"极目生晚照，远树笼微阴。\n谁知清浅流，别有沧海深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"令僧把衲","author":"释重显","text":"七八既难，直须教透。\n来不在前，去不在后。\n粗细自看，紧缓相就。\n一日圆成呈似君，想得诸方未知有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玄沙和尚","author":"释重显","text":"本是钓鱼船上客，偶除须发著袈裟。\n祖佛位中留不得，夜来依旧宿芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示众","author":"释重显","text":"丫角女子白头丝，报你诸方作者知。\n借问住山何境界，春风??，春鸟喧喧。\n翠峰不能助发，心印却是他传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再成古诗","author":"释重显","text":"霜花一镊中，玉童摘未摘。\n斯言如不闻，千古动愁色。\n因忆商山吟，在乌如在白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因事示众","author":"释重显","text":"客从远方来，遗我径寸璧。\n中有四个字，字字无人识。\n清涵鲸海宽，冷射蟾轮窄。\n今朝呈似看，请道末后句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因事示众","author":"释重显","text":"石本落落，玉自碌碌。\n古之今之，一何?速。\n师子不咬麒麟，猛虎不食伏肉。\n君不见洞庭孤岛烟浪深，木马追风有人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因游育王亭寄收主郎给事","author":"释重显","text":"冷翠千万峰，当轩列如黛。\n蒲团及禅板，永日澹相对。\n彤云曾无机，烧松亦成盖。\n远谢幽隐情，难与台星会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":17057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]