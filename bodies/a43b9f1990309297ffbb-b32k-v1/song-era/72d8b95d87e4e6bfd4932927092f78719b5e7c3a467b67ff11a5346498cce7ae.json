[{"title":"和欧阳内翰内直对月见寄","author":"韩维","text":"新衔佳命上金銮，递直连初寝未安。\n霜气稍依罗幕重，月华先近玉堂寒。\n诏函裁罢骞灵凤，诗句书成舞瑞鸾。\n学省地閒清赏隔，怀贤空向斗杓看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和盈祖中散见寄","author":"韩维","text":"朝言民事两无裨，谢病还家独掩扉。\n散发时从溪叟乐，荷锄仍逐野农归。\n山当楼槛千螺髻，柳绕湖波万羽旂。\n雕鴳逍遥各天分，抢榆何意著云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和原甫立春日拜赐归不赴邻几会","author":"韩维","text":"上阁群公拜赐归，九衢春色遍熙熙。\n后房丝竹争相命，穷巷箪瓢亦我期。\n浊酒满樽聊混俗，嘉蔬登俎在随时。\n刘郎固自多幽思，门掩东风独赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和原甫对月招江梅不至","author":"韩维","text":"尘事无时已，归休虑暂空。\n超飖广庭步，萧散葛衣风。\n默与清樽对，心期静者同。\n独怜新月色，百过达幽丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公初春","author":"韩维","text":"春物华犹少，春风思已多。\n新黄先入柳，微绿自生波。\n酒兴潜倾倒，诗情暗揣摩。\n流年不须问，判作白头歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公答张提刑州名诗三首 其二 讲德","author":"韩维","text":"上德钦明代，中阶翊亮司。\n夔龙曜勋业，鸾凤肃威仪。\n复古高文丽，为邦惠化绥。\n还当奉侯瑞，归辅太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公答张提刑州名诗三首 其三 陈情","author":"韩维","text":"濠上蒙庄达，田中彭泽归。\n安能陈道德，直可景光辉。\n欣奉燕台集，恭陪汉相威。\n阳春回丽曲，清越满金徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公答张提刑州名诗三首 其一 颂圣","author":"韩维","text":"文德绥中夏，威灵镇远夷。\n恩灵沧海润，基业泰山维。\n汉曲白麟应，虞韶丹凤仪。\n伪儒蒙景化，鼓舞庆淳熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公答邵校勘","author":"韩维","text":"两朝典策成挥笔，二府勋庸在运筹。\n历践枯荣皆德举，重陪閒燕是恩留。\n康宁必有神明劳，萧洒真无世俗忧。\n早晚安车赐高退，碧嵩清颍从公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曼叔","author":"韩维","text":"官路飘蓬奈别何，塞垣相见此情多。\n酒樽重喜为亲寿，华发犹能继子歌。\n行树坐思新种色，断冰应泛晚来波。\n紫荆山下游从少，独把雕章醉后哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和象之北轩书事","author":"韩维","text":"舍北多嘉树，重阴及四邻。\n清风常满竹，好鸟不惊人。\n图史无它物，讴吟佚此身。\n应容千里客，一醉倒冠巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和象之河上见怀之作","author":"韩维","text":"一昨芳郊祖画轮，索居南北对残春。\n忽传河上相望意，未觉庵中独处人。\n几有高怀投绂冕，尚缘微禄走风尘。\n世间万事徒劳耳，清颍归来理钓纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁","author":"韩维","text":"平池旋涨西山雨，密竹频惊北户风。\n垂箔屡销檀炷紫，出门时看杏梢红。\n酒成岂见甘而坏，花在须知色即空。\n只怪彫章今日至，不知清醉昨宵同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁之什","author":"韩维","text":"美疢随冰释，微阳应律生。\n严风散馀燠，密雪暗深更。\n预喜衔杯集，当期策杖行。\n知公有新庆，金奏动皇情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁元夕 其二","author":"韩维","text":"禁户千通鼓，天街万点灯。\n怀君瑩如玉，驱马不嫌冰。\n乐事看流俗，狂游记旧朋。\n回思真梦幻，不待访林僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁元夕 其一","author":"韩维","text":"月上朱楼角，风摇翠筱层。\n传声回步辇，满目烂行灯。\n箫鼓千门沸，弓刀万马腾。\n诗翁怀盛事，眉雪惨霜棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁赋才元寄牡丹图","author":"韩维","text":"胜事常归蜀，奇葩又验今。\n仙官裁样巧，彩笔费工深。\n白岂容施粉，红须陋间金。\n不嗟珍赏异，千里见君心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁同游南园","author":"韩维","text":"喜公新就好林塘，方驾来游属盛阳。\n广厦阴凉回暑气，平波炎赫变秋光。\n酒中未免分清浊，身外何曾校短长。\n地胜人高多乐事，须知洵美是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁同稚卿湖光亭对雪","author":"韩维","text":"共喜忘怀势利间，每逢嘉景便开颜。\n梅花冒雪轻红破，湖面先春嫩绿还。\n浮蚁浓来当为釂，冥鸿高举不须攀。\n我惭习气欢狂在，未及仙翁一纪闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁湖中","author":"韩维","text":"繁花乱委茵铺锦，弱柳交垂绿作笼。\n竹影入波添旧翠，桥阴横岸见新红。\n临觞善谑如平日，落笔佳章有古风。\n早乏斯文华国体，更将何术代天工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁探春 其二","author":"韩维","text":"才疏非所用，身退此其时。\n静默安虚室，忧虞履薄凘。\n景和闻鹊稔，花近候梅知。\n杖履从兹数，非公孰与期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁探春 其一","author":"韩维","text":"山色青螺髻，清波绿鸭头。\n已欣春事起，那问岁阴流。\n玉蚁新浮盎，金鳞恰上钩。\n衰年怯多酌，尤怕范家瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁喜晴","author":"韩维","text":"浓阴开积晦，和气散馀凄。\n碧爱城阴草，红知花下泥。\n啼鸡一声尽，归雁数行低。\n溪路桃争发，须防去棹迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景仁寒食","author":"韩维","text":"韶华已过半，感叹固多同。\n万室初藏火，千花竞笑风。\n林光高蔼蔼，山气远葱葱。\n洒泪松阡里，伤心白发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景彝圣俞马上见槐花","author":"韩维","text":"天津南望两涯间，蓊若青云乍吐山。\n花叶相催何日已，尘埃不断几人闲。\n郎官萧洒裁诗丽，博士龙钟叹鬓班。\n我独无诗亦无叹，朝驱羸马暮知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾令绰买宅贻景仁","author":"韩维","text":"久治孤学慕轲丘，投老还乡寡所求。\n蓬荜随缘安静默，林泉乘兴访深幽。\n高门此地成君志，方驾何时写我忧。\n白首故人知所待，一竿同钓鸭陂头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾令绰资政西湖见贻","author":"韩维","text":"虎节尝三换，琳宫亦再来。\n白添新鬓发，红识旧亭台。\n酒为迎寒好，花应趁暖栽。\n但愁衰谢意，未到已思回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾通判招饮后见贻","author":"韩维","text":"竹际松间构小堂，高眠客榻燕华觞。\n每询浊酒频加酿，不问馀金几在囊。\n自愧效陶无好语，敢烦凌杜发新章。\n庆门又喜亲才子，藉藉声华满士乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和谢主簿游西湖","author":"韩维","text":"云阴开剥日光穿，和气随风近酒船。\n湖面波清浑见底，楼头山碧自生烟。\n兴长不忍回孤棹，歌懒才能逐缓弦。\n因子樽前话归计，醉魂先到岘山边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之","author":"韩维","text":"风骚宿将勇于行，白日堂堂整旆旌。\n再鼓未甘衰战气，千毫犹可奉诗情。\n忘机始验朋欢浃，受恶方知酒令明。\n了得本来常寂灭，一尘何足累无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之宴张大夫家园","author":"韩维","text":"郎官高会一时贤，胜践幽栖近接联。\n敢论怀黄誇故国，聊欣垂白上华筵。\n同心况是论交旧，二首何疑贵老年。\n东里作诗成故事，明珠当尽落吾前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之宴景仁新第","author":"韩维","text":"华构经营不日成，宛如图画著丹青。\n温貂密坐浮香篆，绿蚁盈斟照弁星。\n得地新篁皆袅袅，凌霜修桧自亭亭。\n祝公眉寿长康乐，不学痴人事醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之燕西湖","author":"韩维","text":"三月韶华大半过，好花零谢已无多。\n暮年光景如残梦，浮世尘劳付浩歌。\n游子有时眠岸草，啼禽终日在庭柯。\n白头不作垂钩客，辜负春湖十里波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和詹叔游庐山见寄","author":"韩维","text":"香炉峰色压群山，仰眺频攲使者冠。\n江面烟波摇紫翠，佛宫金碧照晴寒。\n密藏幽谷梅千树，散走鸣泉竹万竿。\n今日顿惊尘虑尽，一章佳句雪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉同中道锁宿南宫思宝奎殿前花树子","author":"韩维","text":"曾见芳春二月时，弱枝繁萼动辉辉。\n难忘绝艳惊心丽，重惜良游与意违。\n好事几人能载酒，感时今日为沾衣。\n南宫老树无妍思，坐想东风绛雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉同景仁九日宴相公新堂","author":"韩维","text":"高堂突兀里人惊，丞相规模固自宏。\n移石远分嵩峤色，凿池切放潩泉声。\n茱萸结佩聊同俗，鹦鹉传杯岂吝情。\n右席先生亦华构，便应次第落新成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和介甫正月二日","author":"韩维","text":"春意来何早，乾坤润泽中。\n雪明初照日，云断欲随风。\n世事蚊虻过，身谋雁鹜同。\n诸君亦诗酒，吾道未应穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和乐道","author":"韩维","text":"昔闻有客荐扬雄，清世文章又见公。\n奏赋独高天下士，辞荣远继古人风。\n怀贤不啻三秋久，置酒须期十日中。\n幸有红芳妆点在，可无多愧白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和乐道席上见诒","author":"韩维","text":"大隗山前一老翁，幸分州契接群公。\n饮豪肯放兵先北，论合须欣水必东。\n坐对华灯燃宝檠，行看红艳发珍丛。\n良辰胜事从兹始，嘉与吾民乐岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和乔年馆宿","author":"韩维","text":"蓬莱仙构斗魁旁，递直初登汉署郎。\n云向城头收暝色，月从楼角放寒光。\n行看砌菊嗟残艳，坐对书芸袭暗香。\n景物过清浑不寐，素经雠罢得新章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和仲通秋宴","author":"韩维","text":"参差天仗拂云台，雉尾分行剑佩来。\n万寿称觞臣节罄，九韶张乐帝颜开。\n班趋玉佩花相斗，舞入文茵雪屡回。\n疏贱恭承湛露赐，惭无辞藻咏康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和君俞佳雪二首 其一","author":"韩维","text":"老来事事皆抛尽，惟独忧民尚有心。\n深喜天公回气象，便同田父作讴吟。\n缘何更得闾阎暖，恨不偏于垄麦深。\n禅伯静中知我意，琅琅佳句玉其音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和君俞佳雪二首 其二","author":"韩维","text":"居尘不染先生意，与众同忧太守心。\n两处本来非异事，一时都把付高吟。\n忽惊瑞相家家遍，潜助春功日日深。\n拥鼻临池哦丽句，水泉风竹共清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和杨直讲除夜偶书","author":"韩维","text":"杨公白首困青騧，坐对流阴颇自嗟。\n半夜星文穷斗次，平明春色遍人家。\n漫将愁思惊天运，好看新诗待物华。\n何日一樽相就醉，为君先探此园花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和运判朝散登乐山亭","author":"韩维","text":"看山日日上孤城，不问云昏与雪晴。\n六六高峰长秀色，双双啼鸟忽春声。\n心惊流水光阴逝，身慕冥鸿羽翼轻。\n方促吏文严指使，不知诗兴坐中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和府判学士景彝喜雪","author":"韩维","text":"朔风收尽冻云漫，细洒狂飘入夜寒。\n润浃土膏谣万俗，喜闻玉色舞千官。\n川原谁作呼鹰出，楼观朝宜跋马看。\n亚尹勤民流咏叹，一章高唱掩幽兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答乐道","author":"韩维","text":"禁职台纲佚旧儒，青林华屋俨高居。\n炎天久隔挥犀论，暇日聊脂载酒车。\n雨逼秋容生户牖，风回凉思入襟裾。\n东朝第一推调护，圣主宁容久卧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答宋中道服除还朝示亲友","author":"韩维","text":"喧然佳句落神都，哀此援琴尚有馀。\n未见校文登子政，空传为赋似相如。\n道存固可轻华冕，谈进当知得异书。\n推毂贤豪非我事，所期诗酒乐朋裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬君俞","author":"韩维","text":"夫君有奇尚，与世实相差。\n不饮三春酒，唯看九日花。\n名虽贤士籍，心自法王家。\n顾我何能尔，东风醉弁斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬君俞席上偶成","author":"韩维","text":"候月纱笼合，看梅翠幄开。\n满城均俗乐，同闬得君来。\n笑极时倾弁，欢狂欲倒罍。\n赋诗惭善祝，凡器岂公台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤雁","author":"韩维","text":"节物何催逼，翩翩不可留。\n枫丹湘渚暮，芦白楚江秋。\n只影侵霜月，孤鸣入戍楼。\n天高云路杳，安稳过罗浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝奎殿前花树子去年与宋中道同赋今复答宋诗","author":"韩维","text":"长条飞动不依栏，淡粉浓朱巧作团。\n无语不辞终日立，有情曾是隔年看。\n春罗试舞衣新换，古锦藏诗墨未乾。\n我为愁多悲节物，欲酬佳句泪沾翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"废烽台","author":"韩维","text":"耆老不可问，高台荆棘间。\n一时戎马散，千古暮鸦还。\n事往孤鸿断，人来落照閒。\n兴亡无限恨，惨淡对河关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招王微之","author":"韩维","text":"龙图老学士，腰痛比如何。\n久阕新诗和，应寻曲旧歌。\n梅红轻绽萼，池绿细生波。\n欲与君同醉，春风试舞罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武牢道中","author":"韩维","text":"春寒驱传马，西度虎牢关。\n草树高低雪，烟云左右山。\n英豪攻战地，风物笑谈间。\n俯仰看今古，翛然百虑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍隆池上对月","author":"韩维","text":"野月来何处，东池柳影深。\n微生水风力，稍散暝云阴。\n冷极萤沈草，明多鹊动林。\n欲知清绝兴，不寐有孤吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范公新池","author":"韩维","text":"忘机人似汉川阴，取友从来亦断金。\n华屋万楹开里第，清池十顷是家林。\n笙歌喧甚犹能默，觞斝飞馀不废吟。\n便欲与君从此适，藕花风外一披襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范奉议作西江月劝酒","author":"韩维","text":"故里亲交半柏城，坐中牢落似明星。\n雨多秋草荒三径，零重寒花坼万铃。\n闲后并和诗笔废，兴来未放酒杯停。\n樽前一曲西江月，犹识当年旧典刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨过化光西斋","author":"韩维","text":"华屋衡茅接，闲门杖屦通。\n客来非载酒，君坐正书空。\n白菊晚霜后，青蔬寒雨中。\n从今日无事，来听竹窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临汝遇雨","author":"韩维","text":"回风萧飒过山西，一望平郊雨脚齐。\n但使农畴苏旱稼，敢辞客路踏春泥。\n暮投野寺明灯宿，声入幽窗绿树低。\n明日尘清洛阳道，呼童严驾候晨鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西二首 其二","author":"韩维","text":"西城驰道直如弦，百顷晴波御柳边。\n韶乐铿轰罗帐殿，春旗偃蹇近楼船。\n曲江未赐唐家燕，灵沼空思镐邑篇。\n几日金舆下阊阖，鱼龙奇戏出中渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西二首 其一","author":"韩维","text":"绣鞅金羁十里尘，共传恩诏乐芳辰。\n千重翠木开珍圃，百尺朱楼压宝津。\n御麦初长遮雊雉，宫花未识骇游人。\n自怜穷僻看山眼，来对天池禁籞春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春朝","author":"韩维","text":"燕语闻多日，蚕眠过几宵。\n花深不辨蝶，柳暗欲迷桥。\n便面金环重，障泥玉勒骄。\n黄公酒垆上，谁贳阮孚貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春霁忆洛阳","author":"韩维","text":"少年结客洛阳时，闲傍东风驻马蹄。\n山色远饶潘岳宅，波光轻撼窈娘堤。\n花繁到处红如堵，酒好寻常醉似泥。\n赖有金台旧知己，应怜魂断虎牢西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独坐","author":"韩维","text":"雪屋生寒劲，风灯落烬频。\n惊号独过雁，默坐未眠人。\n世事存伤没，年华故换新。\n还将寂寞意，强与冻醪亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览杨乐道洛下诸诗","author":"韩维","text":"昔驱羸马望嵩云，正值嵩阳踯躅春。\n千古废兴都邑地，百年劳苦宦游身。\n曾耽胜事留连久，忽见新诗叹息频。\n君欲买山能遂否，它时愿作社中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]