[{"title":"耕图二十一首 其十七 簸扬","author":"楼璹","text":"临风细扬簸，糠秕零风前。\n倾泻雨声碎，把玩玉粒圆。\n短裙箕帚妇，收拾亦已专。\n岂图较斗升，未敢忘凶年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耕图二十一首 其十三 灌溉","author":"楼璹","text":"揠苗鄙宋人，抱瓮惭蒙庄。\n何如衔尾鸦，倒流竭池塘。\n䆉稏舞翠浪，籧篨生昼凉。\n斜阳耿衰柳，笑歌閒女郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琼花行","author":"楼镰","text":"琼花未信无双无，特与翔鹤游江都。\n炷香展敬下古殿，相羊盘礴亭南隅。\n我欲歌之词，我欲声之诗。\n龙蛇满四壁，妍丑纷淋漓。\n一笑讯花花不语，斯须花以臆对之。\n自从天上来蕃釐，墨卿楚客知心谁。\n本来有是自三异，惠肃一辩公宠贲。\n厥今太守有父风，两句写出无双意。\n直教弹压千万春，香不随风潜堕地。\n我闻此语警且喜，不孤迢递来千里。\n花兮报称为如何，年年三月花开多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢康侍郎送米","author":"甄龙友","text":"折腰乡里愧陶潜，五斗黄陈饭莫嫌。\n一介古来难取与，先生伤惠我伤廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳阳楼望洞庭","author":"甄龙友","text":"风定空澄气浑然，恍如太极未分前。\n只因有浪知为水，若遇无云总是天。\n旧说君山张帝乐，新同老木识飞仙。\n而今大洞黄庭客，又著题诗记岁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽薛艮斋 其三","author":"甄龙友","text":"有子才而美，知君死不亡。\n刀圭徒有验，兵法岂无妨。\n玉树新埋没，金丹旧渺茫。\n魂兮来止些，极乐在西方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽薛艮斋 其二","author":"甄龙友","text":"赠别文章妙，分携六见秋。\n真书藏相府，循吏说湖州。\n不作三公入，同谁八极游。\n朔风吹壮泪，应满藕池头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽薛艮斋 其一","author":"甄龙友","text":"骥不由穷巷，龙曾演瑞图。\n衣传袁道洁，梦接邵尧夫。\n四十年全未，三千行岂无。\n飘然何太速，愁杀奠生刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望君山","author":"甄龙友","text":"大洞黄庭太乙家，君山一叶泛莲花。\n南征客认湘灵瑟，北上人疑汉使槎。\n尚想飞仙游白鹤，偶于怀袖落青蛇。\n玉皇香案真如此，我欲晨奔到广霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薛氏镜山","author":"甄龙友","text":"我生不是先，偶与前辈隔。\n古人犹爱水，况此千丈碧。\n孤圆本然明，万象纷如绎。\n行吟鬼破胆，坐钓风生腋。\n疏梅逞晨妆，漏月印金璧。\n奇峰列云影，平桥涨春泽。\n四时如劈剪，一照成虚射。\n缅想亭中人，屡憩泉上石。\n心空见了了，起觅已他适。\n吾诗复何言，镜镜如痕迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临安北山大佛头颂","author":"甄龙友","text":"色如黄金，面如满月。\n尽大地人，只见一橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头","author":"甄龙友","text":"西风新叶堕，南国九秋初。\n周天三百六十五度，片云无。\n上有迢迢河汉，下有滔滔江水，横载洞庭湖。\n一叶放流去，人在浑仪图。\n满虚空，张宝盖，缀明珠。\n玻璃为地，游戏乾象驾坤舆。\n烂醉蓬莱方丈，遍入华严法界，试问夜何如。\n北斗转魁柄，东海欲飞乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 寿木状元十月廿二","author":"甄龙友","text":"十月小阳春。\n放榜梅花作状元。\n重庆礼成三日后，生贤。\n第一龙飞不偶然。\n劝酒自弹弦。\n更著斑衣寿老仙。\n见说海坛沙涨也，明年。\n此夜休嗔我近前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺新郎","author":"甄龙友","text":"思远楼前路。\n望平堤、十里湖光，画船无数。\n绿盖盈盈红粉面，叶底荷花解语。\n斗巧结、同心双缕。\n尚有经年离别恨，一丝丝、总是相思处。\n相见也，又重午。\n清江旧事传荆楚。\n叹人情、千载如新，尚沈菰黍。\n且尽尊前今日醉，谁肯独醒吊古。\n泛几盏、菖蒲绿醑。\n两两龙舟争竞渡，奈珠帘、暮卷西山雨。\n看未足，怎归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霜天晓角 题赤壁","author":"甄龙友","text":"峨眉仙客。\n四海文章伯。\n来向东坡游戏，人间世、著不得。\n去国谁爱惜。\n在天何处觅。\n但见尊前人唱，前赤壁、后赤壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居","author":"甄圭","text":"深坞人稀到，重门昼亦关。\n白云秋舍静，明月夜窗闲。\n径掩花开落，帘通燕往还。\n穷居聊自适，却忆谢东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头","author":"甄良友","text":"直节傲山雪，偃盖咏松风。\n天香真色来报，春信月明中。\n六七日分景纬，五百年间英气，相值产维崧。\n君子中庸也，天下有胡公。\n把州麾，将漕计，简渊衷。\n淳熙新政，往风虎，趁云龙。\n底用玉卮卜寿，看取天然难老，高竹与长松。\n更有红梅实，调鼎告成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"甄良友","text":"希夷本是儒先祖。\n云仍来自神仙所。\n前日一阳生。\n德星今夜明。\n灵椿殊未老。\n仙桂双双好。\n好是百花魁。\n年年称寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 钱参政","author":"甄良友","text":"华表鹤重来，嘉禾合穗。\n天命真人救斯世。\n故仙子来佐，中兴之际。\n这回真是个，风云会。\n天水庆源，钱塘潮势。\n主圣臣贤千岁。\n半钩月小，一剪梅花香细。\n太平无事也，休辞醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"甄良友","text":"杲杲重光，遥山耸翠，九天秋气高明。\n露团仙掌，初月挂前星。\n帝念吾君父子，亲传授、光启中兴。\n生储后，是为三圣，一道以相承。\n升平。\n当此际，黄花照座，丹桂充庭。\n对雨宫喜色，百辟欢声。\n好是橙黄橘绿，宣猷殿、酒碧香清。\n重重庆，尧仁舜孝，亲见禹功成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"甄良友","text":"照水绮霞明木杪。\n彩翼双栖，未觉桐阴少。\n正是一年秋色好。\n世间重睹香山老。\n祝寿人如群玉绕。\n满酌金莲，愿永谐歌笑。\n仙客莫疑来不早。\n洞中日月天昏晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿猿洞和程师孟韵","author":"福州运判","text":"晓来人语□□惊，空有三元□□亭。\n冻酒点唇浮白蚁，秾桃迷眼落红星。\n地名小酉神仙窟，天设湘阴水墨屏。\n蕴藉莫誇洞庭记，移文休勒北山扃。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"福州幕官","text":"从渠腰下有金带，何处山中无菜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题壁二首 其二","author":"福州僧","text":"当初只欲转头衔，转得头衔转不堪。\n何似仁王高阁上，倚栏闲唱望江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题壁二首 其一","author":"福州僧","text":"不嫌夫婿丑，亦勿厌深村。\n但得一回嫁，全胜不出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂蔡君谟 其一","author":"福建士人","text":"道边松，大义渡至漳泉东。\n问谁植之我蔡公，岁久广阴如云浓。\n甘棠蔽芾安可同，委蛇夭矫腾苍龙。\n行人六月不知暑，千古万古长清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂蔡君谟 其二","author":"福建士人","text":"洛阳桥，一望五里排琨瑶。\n行人不忧沧海潮，冲冲往来乘仙飙。\n蔡公作成去还朝，玉虹依旧横青霄。\n考之溱洧功何辽，千古万古无倾摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子","author":"福建士子","text":"月上小楼西，鸡唱霜天晓。\n泪眼相看话别时，把定纤纤手。\n伊道不忘人，伊却都忘了。\n我若无情似你时，瞒不得、桥头柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"窦夫人","text":"去时梅蕊全然少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过邠州留题","author":"窦仪","text":"多少樊笼不敢开，强拘物性要相陪。\n何时得似邠州守，德政临民鹤自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺李昉","author":"窦仪","text":"厩马牵来哕哕嘶，马蹄随步蹑云梯。\n新街锦帐达三字，旧制星垣放五题。\n视草健毫从席选，受降恩诏待公批。\n仙才已在神仙地，逢见刘晨为指迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北海题渚宫","author":"窦俨","text":"纪南南望水城宽，水色天光混一般。\n大抵江乡足诗景，咏吟如把画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆郊祀八首 其八 送神用《高安》。","author":"郊庙朝会歌辞","text":"倏兮而来，忽兮而回。\n云驭杳邈，天门洞开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆郊祀八首 其七 亚献、终献用《正安》。","author":"郊庙朝会歌辞","text":"谓天盖高，其听孔卑。\n闻乐歆德，介以福禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆郊祀八首 其六 饮福用《禧安》。","author":"郊庙朝会歌辞","text":"洁兹五齐，酌彼六尊。\n致诚斯至，率礼弥敦。\n以介景福，永隆后昆。\n重熙累洽，帝道攸尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆郊祀八首 其五 酌献用《禧安》。","author":"郊庙朝会歌辞","text":"丹云之爵，金龙之杓。\n挹于尊罍，是曰清酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆郊祀八首 其三 奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"嘉玉制币，以通神明。\n神不享物，享于克诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆郊祀八首 其二 皇帝升降用《隆安》。","author":"郊庙朝会歌辞","text":"步武舒迟，升坛肃祗。\n其容允若，于礼攸宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆郊祀八首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"在国南方，时维就阳。\n以祈帝祉，式致民康。\n豆笾鼎俎，金石丝簧。\n礼行乐奏，皇祚无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题臞庵","author":"蒙与义","text":"一岛风烟水四围，轩亭窈窕更幽奇。\n眼中泉石论溪买，行处壶觞逐境移。\n倦马虺隤前日路，寒松偃蹇旧年枝。\n自嗟老去殊痴绝，一月春愁废作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"蒲公","text":"史君唾手了雄边，半夜移春入北园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"蒲寿宬","text":"盈盈一水望牵牛，欲渡银河不自由。\n月照纤纤织素手，为君裁出翠云裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又渔父四首 其四","author":"蒲寿宬","text":"青山淡淡水悠悠，有客江边孟浪游。\n渔父相逢欲借问，掉头吟咏不相酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又渔父四首 其三","author":"蒲寿宬","text":"海光潋滟月团圆，一颗明珠落玉盘。\n鸥鹭不知何处宿，白头閒坐把鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又渔父四首 其二","author":"蒲寿宬","text":"钓得鱼来日又斜，潮回无路可归家。\n炙鱼当饭且一饱，閒看白鸥飞浪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又渔父四首 其一","author":"蒲寿宬","text":"昨日卖鱼到城郭，暑气千门正炮烙。\n买酒归来风露凉，始信人间渔父乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中秋晓","author":"蒲寿宬","text":"命策空山风露冷，野花无数不知名。\n林丛深处无人问，时吐秋芬一样清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞泉","author":"蒲寿宬","text":"藓壁轻飞雾雨寒，一帘清漱玉珊珊。\n游鳞莫羡层澜去，镂雪雕冰满肺肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书香炉瀑布图后","author":"蒲寿宬","text":"飞流三百丈，日射碧琉璃。\n一气何终极，淋漓自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书滴翠岩壁","author":"蒲寿宬","text":"萝衣湿寒翠，苔锦上嶙峋。\n一榻千峰里，因诗忆古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心泉二首 其二","author":"蒲寿宬","text":"骤来惊辟易，久视益虚无。\n咫尺星堪摘，波摇又走珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心泉二首 其一","author":"蒲寿宬","text":"涓涓万古意，湛湛一尘无。\n明月来窥镜，宵寒露滴珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月岩","author":"蒲寿宬","text":"皎皎应如欲下弦，为谁长挂此岩前。\n行人莫笑中空洞，空洞中间尽是天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水碓","author":"蒲寿宬","text":"午枕閒随梦出尘，觉来不记是城闉。\n寂无人语惟闻碓，恐有穿腰持石人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉女峰","author":"蒲寿宬","text":"玉女攒空拥雾鬟，铁心千古照溪湾。\n愿分一滴清溪水，去洗人间脂粉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白须","author":"蒲寿宬","text":"月照当襟雪，终剪施摩诘。\n我作白须行，而得养生术。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早梅","author":"蒲寿宬","text":"荷已全凋菊未残，一枝的皪照江干。\n暖风莫诧搀先意，留取清芬待岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次枯崖上人催梅韵","author":"蒲寿宬","text":"黄叶萧萧雨滴阶，梦魂飞到瀑边梅。\n遥知楖栗山中老，一日花间一百回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵","author":"蒲寿宬","text":"绝顶秋高风露寒，倚阑心事到梅间。\n谁知岁晚相思意，欲种梅花满此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上闻笛","author":"蒲寿宬","text":"笛声何处水茫茫，潮落沙寒月照廊。\n嵇吕成尘不可觅，满襟清泪忆山阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江横信笔","author":"蒲寿宬","text":"潮汐有赢缩，江横无古今。\n鱼龙任掀舞，孤月在天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百花洲梅","author":"蒲寿宬","text":"孤根宁不在栽培，枝北枝南春一回。\n尽道游鱼是佳谶，不知洲上有花魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饭牛歌","author":"蒲寿宬","text":"新秧插遍水盈畴，童稚相呼去饭牛。\n极目平坡烟草细，歌声何处雨飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏狸","author":"蒲寿宬","text":"买鱼日日与狌狸，捕鼠有心奚待饥。\n但免翻盆与覆碗，何须要见血淋漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怡云","author":"蒲寿宬","text":"把作一片画，晴阴浑不同。\n不知谁是画，伫立意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其十","author":"蒲寿宬","text":"芳郊望无际，逐草任西东。\n世上千场梦，人间一笛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其九","author":"蒲寿宬","text":"生来在田野，少小学耕锄。\n敢望多名誉，随人角挂书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其八","author":"蒲寿宬","text":"老翁分社酒，匕箸小孩提。\n黄犊今堪驾，明年学把犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其七","author":"蒲寿宬","text":"野花簪短笠，露湿蔓青青。\n莫笑儿童小，人间河鼓星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其六","author":"蒲寿宬","text":"斜阳归处险，路熟了无疑。\n结草为衣著，圈葭作竹吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其五","author":"蒲寿宬","text":"前山飞暮雨，牛上展青蓑。\n回首牛呼犊，哀音儿唱歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其四","author":"蒲寿宬","text":"倦来牛背卧，一觉度前冈。\n牛饱儿呼馁，归来煨芋香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]