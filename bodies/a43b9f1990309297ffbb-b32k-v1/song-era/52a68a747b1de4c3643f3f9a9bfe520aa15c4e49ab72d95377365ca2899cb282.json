[{"title":"解舟雷江过东流县","author":"杨万里","text":"云散烟还合，天昏日半烘。\n青山犹淡白，碧水欲轻红。\n棹进欣恬浪，公无怨逆风。\n回思五湖里，敢望大江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"路口回望方山","author":"杨万里","text":"钟阜回头失，方山恋眼寒。\n似巾檐短帽，如覆玉雕盘。\n每恨青苍远，因行反覆看。\n归时记面目，城里指云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"路逢故将军李显忠以符离之役私其府库士怨而溃谪居长沙","author":"杨万里","text":"贪将如中使，兵书不误今。\n只悲熊耳甲，谁怨袅蹄金。\n贾傅奚同郡，朱游独折心。\n书生何处说，诗罢自长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞栖真室盖晋仙人李八百故居之址中有遗像云","author":"杨万里","text":"李真宅子故依然，道院西偏古洞前。\n一日身游八百里，三番花落九千年。\n剑池丹井俱苍藓，绛节霓旌已碧天。\n借问飞仙那用步，步行犹是地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣人探梅翟园云尚未开","author":"杨万里","text":"传语翟园千树梅，不应藞苴索诗催。\n今年雪后悄无信，去岁腊前强半开。\n我欲明朝携酒去，花须连夜唤春回。\n东风肯报南枝否，待釂东风三百杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣闷","author":"杨万里","text":"江树深春色，村鸡薄晚声。\n雨添青笠重，人减画船轻。\n遣闷惟须睡，哦诗只强成。\n独判连日雨，却惜半朝晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲈鱼","author":"杨万里","text":"两年三度过垂虹，每过垂虹每雪中。\n要与鲈鱼偿旧债，不应张翰独秋风。\n买来一尾那嫌少，尚有杯羹慰老穷。\n祗是莼丝无觅处，仰天大笑笑天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲎酱","author":"杨万里","text":"忽有瓶罂至，捲将江海来。\n玄霜冻龟壳，红雾染珠胎。\n鱼鲊兼虾鲊，奴才更婢才。\n平章堪一饭，断送更三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮归","author":"杨万里","text":"山色偏宜暮，桐声小作秋。\n人行溪侧畔，天在树梢头。\n学懒真成懒，知休却得休。\n遣愁愁不去，愁尽自无愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮泊鼠山闻明朝有石塘之险","author":"杨万里","text":"下水船逢上水船，夕阳仍更涩沙滩。\n雁来野鸭却惊起，我与舟人俱仰看。\n回望雪边山已远，如何篷底暮犹寒。\n今宵莫说明朝路，万石堆心一急湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮雨既霁将儿辈登多稼亭","author":"杨万里","text":"一霎滂沱一霎晴，檐间点滴尚残声。\n水将树影乱揉碎，月与日光相对明。\n试数六宵还五雨，坐令夏热作秋清。\n儿曹小住休归去，更听风蝉子细鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮寒","author":"杨万里","text":"过雁双仍急，寒鸦只已多。\n绝怜晴色好，无奈暮寒何。\n眼病书休读，心劳句尚哦。\n老生穷事业，此外岂无他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午前一日含笑初拆","author":"杨万里","text":"一点瓜香破醉眠，误它酒客枉流涎。\n如何滴露牛心李，化作垂头玉井莲。\n初喜晓光将莞尔，竟羞午影不嫣然。\n忽看吐下金樱核，蔌蔌声乾暮叶边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午前一日阻风鄱阳湖观竞渡","author":"杨万里","text":"恶风夜半阻归船，端欲留人作胜缘。\n千里携家观竞渡，五湖新涨政黏天。\n棹翻波浪山如雪，醉杀儿郎喜欲颠。\n得去更佳留亦好，吾曹何处不欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午独酌","author":"杨万里","text":"招得榴花共一觞，艾人笑杀老夫狂。\n子兰赤口禳何益，正则红船看不妨。\n团粽明朝便无味，菖蒲今日么生香。\n一生幸免春端帖，可遣渔歌谱大章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠樾亭前莺巢","author":"杨万里","text":"仰听金衣语，偶窥莺妇巢。\n深穿乔木里，危挂弱枝稍。\n啄抱双双子，经营寸寸茅。\n何时雏脱壳，新哢响交交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅","author":"杨万里","text":"栗玉圆彫蕾，金钟细著行。\n来从真蜡国，自号小黄香。\n夕吹撩寒馥，晨曦透暖光。\n南枝本同姓，唤我作它杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲淮浪","author":"杨万里","text":"碧琉璃地展青罗，横作一波仍万波。\n突起银山倚空立，碎成雪阵掠人过。\n争先打岸终谁胜，淘尽浮沙奈汝何。\n借与楼船泄馀怒，摇来兀去尽从佗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横山","author":"杨万里","text":"已过方山了，横山更绝奇。\n争高一尖喜，妒逸众青追。\n万马头惊拶，千旗脚恣吹。\n娟峰恰三五，隔柳尚参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横山塔","author":"杨万里","text":"相识横山塔，于今十五年。\n孤标立绝顶，秃影照清川。\n寂寞无香火，将迎几舫船。\n吾衰岂重过，珍重塔中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樱桃","author":"杨万里","text":"樱桃一雨半彫零，更与黄鹂翠羽争。\n计会小风留紫脆，殷勤落日弄红明。\n摘来珠颗光如湿，走下金盘不待倾。\n天上荐新旧分赐，儿童犹解忆寅清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潮阳海岸望海","author":"杨万里","text":"动地惊风起海陬，为人吹散两眉愁。\n身行岛北新春后，眼到天南最尽头。\n众水更来何处著，千峰赴此却回休。\n客间供给能消底，万顷烟波一白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉吟二首 其二","author":"杨万里","text":"三春草草眼中过，未抵三冬乐事多。\n烛焰双丫红再合，酒花半蕾碧千波。\n孤寒霜月侬相似，跌宕雪风谁奈何。\n道是闲人没勋绩，一枝樵斧一渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉吟二首 其一","author":"杨万里","text":"十载人间乐与忧，几曾半点到心头。\n梧桐叶上秋无价，蟋蟀声中月亦愁。\n暮角晓钟何日了，苍颜华发此生休。\n吟颠醉蹶知无益，利走名奔有命不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤延之右司遂初堂二首 其二","author":"杨万里","text":"诗瘦山如瘦，人遐室更遐。\n荒林庾信宅，古木谢敷家。\n医国君臣药，逃名子母瓜。\n只愁归未得，绿却白鸥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤延之右司遂初堂二首 其一","author":"杨万里","text":"漫仕风中絮，归心水上鸥。\n把茅新结屋，藜杖旧经丘。\n花底春勾引，灯前夜校雠。\n何如添我住，二老更风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王宣子新作吉州学前咏归亭","author":"杨万里","text":"使君见处我何言，且上斯亭一笑还。\n便有醒然新气象，何曾改却旧江山。\n咏归风味谁知点，克己工夫未减颜。\n个里诸生高著眼，仕和不仕得相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题东江刘长元勤有斋","author":"杨万里","text":"蠹简三更寂，寒灯半点悭。\n不知门外雪，已失月中山。\n白璧非愁禹，黄金只铸颜。\n时来漫拈出，掇取桂枝还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永新吴景苏主簿梯云楼","author":"杨万里","text":"谁道青云不可梯，君家楼阁与云齐。\n诤臣内相名垂日，谏草词头字印泥。\n我昔曾为禾水客，梦中犹忆义山西。\n仇香自有家声在，岂使鸾皇棘上栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙归寺壁","author":"杨万里","text":"题字才前岁，冲寒又此行。\n竹能知雨至，窗不隔江清。\n走檄还曾了，禁人未肯晴。\n息肩更须喜，问路可怜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘寺僧房","author":"杨万里","text":"曾醉山间金叵罗，山应识我我怀它。\n顿添花竹明松桧，依旧菰蒲暗芰荷。\n试问锦屏无恙否，向来梅树已无多。\n未须看遍新亭榭，胜日重来一一过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘直卿崇兰轩","author":"杨万里","text":"风亦何须过，林仍不厌深。\n莫将春色眼，来看岁寒心。\n政坐香通国，端令佩满襟。\n楚人更饶舌，得免世间寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘朝英进斋","author":"杨万里","text":"灯火三更雨，诗书一古琴。\n惟愁脚力软，未必圣门深。\n莫笑云端树，初如涧底针。\n不应将一第，用破半生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘道原墓次刚直亭","author":"杨万里","text":"山南山北蔚松楸，四海千年仰二刘。\n迂叟馈缣宁冻死，伯夷种粟几时秋。\n平生铁作三尺喙，土苴人间万户侯。\n庐阜作江江作阜，始应父子不传休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吉水余端蒙明府县门飞凫阁","author":"杨万里","text":"尘外尘中尽静喧，阁前阁后且山川。\n秋生疏雨微云处，月仄青原白鹭边。\n眼冷庾楼聊复此，人如叶令更差贤。\n从公欲往其如懒，著句无佳莫浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吴江三高堂 其二 张季鹰","author":"杨万里","text":"京洛缁尘点素衣，秋风日夕唤人归。\n鲈鱼不解疏张翰，羊酪偏能留陆机。\n二晋兴亡几春草，三吴人物尚渔矶。\n空令千古华亭鹤，犹为诸贤说是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吴江三高堂 其三 陆鲁望","author":"杨万里","text":"读尽诗书不要官，饥寒欲死岂无田。\n生憎俗子慵开眼，逢著诗人便绝弦。\n笠泽弁山三益友，笔床茶灶一鱼船。\n羡渠赤脚弄明月，踏破五湖光底天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吴江三高堂 其一 范蠡","author":"杨万里","text":"霸越亡吴未害仁，不妨报国并酬身。\n风云长颈无遗恨，雪月扁舟更绝尘。\n还了君王采香径，须饶老子苧罗人。\n鸱夷若是真高士，张陆何堪作近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题连沧观呈太守张几仲","author":"杨万里","text":"开窗纳尽大江秋，天半飞楼不是楼。\n独立南徐鳌绝顶，下临北固虎回头。\n蒜山旧址空黄鹤，瓜步新城照白鸥。\n好事主人酌诗客，风烟一眼到扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龟山塔前一首唐律后一首进退格 其一","author":"杨万里","text":"龟山独出压淮流，宝塔仍居最上头。\n银笔书空天作纸，玉龙拔地海成湫。\n向来一厄遭群犬，挽以六丁兼万牛。\n逆血腥膻化为碧，空馀风雨鬼啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题盱眙军东南第一山 其二","author":"杨万里","text":"建隆家业大于天，庆历春风一万年。\n廊庙谋谟出童蔡，笑谈京洛博幽燕。\n白沟旧在鸿沟外，易水今移淮水前。\n川后年来世情了，一波分护两涯船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题盱眙军东南第一山 其一","author":"杨万里","text":"第一山头第一亭，闻名未到负平生。\n不因王事略小出，那得高人同此行。\n万里中原青未了，半篙淮水碧无情。\n登临不觉风烟暮，肠断渔灯隔岸明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题盱眙军玻瓈泉","author":"杨万里","text":"清如淮水未为佳，泉迸淮山好煮茶。\n镕出玻瓈开海眼，更和月露瀹春芽。\n仰看绝壁一千丈，削下青琼无点瑕。\n从事不浇愁肺渴，临泓带雪吸冰花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题临川李子经文藁","author":"杨万里","text":"圣经贤传紧关津，骚客诗家妙斧斤。\n总被先生漏消息，不令后辈隔知闻。\n都城一日纸增价，天下几人贫似君。\n不要绨袍却归去，平生笑杀送穷文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南雄驿外计堂","author":"杨万里","text":"携家度岭夜乘槎，小泊凌江水北涯。\n二月山城无菜把，一年春事又杨花。\n举头海国星辰近，回顾梅山草树遮。\n客子相逢闻好语，看山只欠到南华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题姜店水亭子","author":"杨万里","text":"帘拂云间竹，窗摇水下天。\n栏干斜倚处，风物正凄然。\n送眼看群叟，收罾得小鲜。\n可怜碧玉沼，不种一枝莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题徐衡仲西窗诗编","author":"杨万里","text":"江东诗老有徐郎，语带江西句子香。\n秋月春花入牙颊，松风涧水出肝肠。\n居仁衣钵新分似，吉甫波澜并取将。\n岭表旧游君记否，荔支林里折桄榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题浩然李致政义概堂","author":"杨万里","text":"非侠非狂非逸民，读书谋国不谋身。\n一封北阙三千牍，再活西州六万人。\n雨露晚从天上落，芝兰亲见掌中新。\n仁心义概丝纶语，长挂巴山月半轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题族弟道卿贫乐斋","author":"杨万里","text":"雪茹冰餐入骨香，帽欹驴瘦尽诗狂。\n人传幼妇皆称绝，鬼笑家兄不姓方。\n细雨寒灯初梦短，断丝枯木一声长。\n上天已办河东赋，岂有长贫执戟郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾良臣思堂","author":"杨万里","text":"谢墅新成了，潘舆竟不归。\n升堂仰遗像，下拜泣沾衣。\n反哺乌何在，卧冰鱼自肥。\n梦中环佩响，惊喜觉来非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题湘中馆二首 其一","author":"杨万里","text":"清境故应好，新寒殊不胜。\n征衣愁著尽，凭槛喜犹能。\n乱眼船离岸，关心山见棱。\n个中有句在，下语更谁曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题谢昌国桂山堂","author":"杨万里","text":"艮斋引袖出明光，归卧西江一草堂。\n种满山中浑是桂，怪来月窟更无香。\n九秋金粟供朝饭，三径黄花并夕粮。\n履上星辰冠上豸，一时脱却濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩连岭店","author":"杨万里","text":"此馆初明眼，前山正接眉。\n热嫌连日甚，凉惜两朝迟。\n雨竹何其重，风鸥不自持。\n庭闱犹百里，早已豁愁思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠节推学士","author":"杨万里","text":"奏篇惊倒汉廷臣，一眼元无四海人。\n天下无双聊小却，洛阳年少是前身。\n云鹏飞上偏嫌早，雾豹深藏更几春。\n宽作十年相见著，剩将风雪试松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠刘景明来访","author":"杨万里","text":"研席相从昔少年，白头谁信两苍然。\n来从八桂三湘外，忆折双松十载前。\n告我明朝还又别，对床终夕不成眠。\n交游存没休休说，且为梅花釂玉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠别罗时清","author":"杨万里","text":"四岁相从亦快哉，东游兴尽却西回。\n诗中风月无疆界，圣处宫庭元洞开。\n握手论文两凄断，登山临水重徘徊。\n亦山亭下梅花径，明日先生独自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠周敬伯","author":"杨万里","text":"万方英杰集桥门，作么吾州不数人。\n之子独携一方策，短檠以外四无邻。\n岁云暮矣犹为客，归去来兮未立身。\n待上六鳌头上立，还家藉手拜双亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠尚长道签判","author":"杨万里","text":"今代高人尚子平，风流文采旧家声。\n合于玉笋班中立，却向红莲幕里行。\n天色恼人浑欲雪，烛花照别若为情。\n日边已办除书著，莫恋南楼秋月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜露","author":"杨万里","text":"落照红犹剩，初星白未真。\n霜威能夺月，寒力故欺人。\n哀雁知谁怨，吟蛩独我亲。\n老来忧患里，忍泪已沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霰","author":"杨万里","text":"雪花遣霰作前锋，势颇张皇欲暗空。\n筛瓦巧寻疏处漏，跳阶误到暖边融。\n寒声带雨山难白，冷气侵人火失红。\n方讶一冬暄较甚，今宵敢叹卧如弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赣守张子智舍人寄诗送酒和韵谢之","author":"杨万里","text":"谁言天上张公子，飞下崆峒看晓晴。\n为爱东坡题八境，却同严助厌承明。\n诗来风雨荒凉后，语带江山紫翠横。\n更遣曲生相暖热，十年同社再寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代钱塘宰莫子章贺皇太子生辰","author":"杨万里","text":"寒外乾坤净，霜前殿阁新。\n如何震一索，顿有月重轮。\n甲观堂初画，青宫榜更银。\n三天同日晓，一气八荒春。\n东序翻周学，南阳摘汉亲。\n承祧英类祖，问寝孝通神。\n帝子临京邑，藩寮著野人。\n天将重九节，瑞应诞弥辰。\n萸菊双为寿，山河总效珍。\n前星环紫极，长照漆园椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟上舍寒江动碧虚诗","author":"杨万里","text":"江远澄无底，秋深分外寒。\n太虚元碧净，倒影动清湍。\n浪雪翻空碎，天蓝落镜看。\n光摇芦叶冷，声战蓼花乾。\n画手雕心苦，诗脾觅句难。\n人间那有许，我欲把渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟归院柳边迷诗","author":"杨万里","text":"玉殿朝初退，金门马不嘶。\n院深归有处，柳暗迹都迷。\n紫陌春无际，青丝舞正齐。\n风烟忘近远，楼阁问高低。\n残雪莺声外，斜阳凤掖西。\n少陵花底路，物物献诗题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟玉水记方流诗","author":"杨万里","text":"观水那无术，曾于往记求。\n是间还韫玉，其外必方流。\n缜栗渊潜久，英华气上浮。\n清波皆中矩，宝祲直横秋。\n金海芒相贯，璿源折以幽。\n端如君子德，不病暗中投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]