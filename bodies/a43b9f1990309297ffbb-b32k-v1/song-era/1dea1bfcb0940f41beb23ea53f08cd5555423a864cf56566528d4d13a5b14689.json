[{"title":"次韵嘉父喜雪","author":"晁补之","text":"六出先春兆物华，故撩高韵发车斜。\n散榆天上齐飞筴，布玉畦中尽吐芽。\n梁苑俊游风不极，剡溪清泛月无涯。\n雄豪乐事幽人咏，都属江南太守家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵履常见贻","author":"晁补之","text":"人皆爱陈子，新雨尚能来。\n但使门多客，何嫌室自埃。\n弓旌无远野，城郭有遗才。\n底日常侯舍，传声四辈催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵毅父户部兄游栖岩寺","author":"晁补之","text":"恐是初禅第一天，千秋龙象镇危巅。\n坐看玉井莲飘叶，绝胜香垆日照烟。\n点点蚁封知晋甸，纷纷雁背向秦川。\n要须浩荡奇言称，付与南华旧老仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵毅父提刑将至蒲见寄","author":"晁补之","text":"骑报山云见旗脚，吏趋原雪没靴翁。\n朅来定坐玄犹白，捷去还忧易又东。\n他日江湖空白首，只今关陇有清风。\n登瀛契分南迁梦，十五年来事事同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自画山水寄无斁题其上","author":"晁补之","text":"湘吴昔穷览，怀抱自难忘。\n毫素开尘牖，江山入草堂。\n寄君花县里，虚我竹林傍。\n何物酬斯赠，清诗要一囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自蒲赴湖早行作","author":"晁补之","text":"小隐幽情薄宦身，五更骑马寿安尘。\n春如流水行随客，晓与青山气逼人。\n报国丹心千载事，对花霜鬓一番新。\n秦吴绝域从来恨，我已能知莫问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自蒲赴湖至板桥逢杜谋伯","author":"晁补之","text":"二年两度踏京尘，犹喜常逢杜子春。\n文学老来从旧日，金兰同好更何人。\n身惭随檄终难强，计欲归耕未敢陈。\n正是桃花红似血，不应无酒但沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别关景晖二首 其二","author":"晁补之","text":"笔陈云横未易陪，雁门端见压城摧。\n栎中麋出君抟饭，地上蛇成我夺杯。\n好在田园心事懒，罢休簪组鬓毛催。\n稽山为有知章否，欲泛扁舟定却回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴松道中二首 其二","author":"晁补之","text":"晓路雨萧萧，江乡叶正飘。\n天寒雁声急，岁晚客程遥。\n鸟避征帆却，鱼惊荡桨跳。\n孤舟宿何许，霜月系枫桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴松道中二首 其一","author":"晁补之","text":"停舟傍河浒，四顾尽荒原。\n日落狐鸣冢，天寒犬吠村。\n系帆凌震泽，抢雨入盘门。\n怅望夫差事，吴山閟楚魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈曹子方","author":"晁补之","text":"曹子金门等陆沉，壮年裘马四方心。\n檄传白羽从沙井，诗写红巾遍武林。\n兵甲胸中无敌国，丝桐世外有知音。\n相逢不饮何为者，祗作寒厅拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"求仁复示怨句次韵","author":"晁补之","text":"闻说高情久沉寥，絷维谁与永今朝。\n五车犹累方书好，万物先从辩说彫。\n已向季咸心独醉，更缘顺子意都消。\n清秋璧月凉如水，莫遣纤云翳紫霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮校理盛居中家次韵二首 其一","author":"晁补之","text":"骑鸾玉府尽仙真，短羽愁攀天汉滨。\n诗懒便应推老手，饮豪独未后诸宾。\n宫壶银箭刚知夜，笼烛金华已报春。\n倒载微吟笑儿稚，时清宁是习池人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮校理盛居中家次韵二首 其二","author":"晁补之","text":"一倒南斋玉宇醇，绝胜不醉楚江滨。\n骊驹且莫催归御，鸲鹆何妨属坐宾。\n我尚少年新白发，君须痛饮敌青春。\n未愁驱使无诗句，怕遣壶空花笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和二叔父少监入馆见赐诗","author":"晁补之","text":"楩楠要是晚方成，雄朔遗风世共惊。\n屑去未惊容必去，逃名还自得高名。\n歌行元白辞涛壮，书画钟王笔势精。\n乘马辎车何足算，不将稽古愧桓荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王定国见寄","author":"晁补之","text":"请说当年王武子，淮南别乘谪仙人。\n自从金马还通籍，直恐琼花便不春。\n遗爱谁方府中步，旧时独埽壁间尘。\n平山送目思公子，自许诗成觉有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石明叔喜雪","author":"晁补之","text":"解冻南风故未薰，六英先岁舞车尘。\n尽消日观千岩雪，初破江梅一萼春。\n立召金闺通籍客，更呼花艳大堤人。\n使君日饮无功业，同乐何妨亦为民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和欧阳宣德经野步","author":"晁补之","text":"溯风何敢祝淮神，青律飞灰气自醇。\n顾我衰容唯殢酒，因君佳句始知春。\n山中桂子年年好，观里桃英日日新。\n延对彤廷须努力，詹生学问及昌辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招缙云守关彦远教授曾彦和集平山堂次关韵","author":"晁补之","text":"蜀冈势与蜀山通，龙虎盘挐上紫空。\n小语还忧惊太一，高堂元自在天中。\n少师杨柳无遗迹，承旨歌谣有旧风。\n斜日芜城易兴感，忘怀犹喜故人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泗州王谏议明叟留饮","author":"晁补之","text":"云水东游蚤岁怀，半生尘土却教回。\n两行堤柳关心在，一点淮山入眼来。\n北省主人誇酒好，南风稚子喜帆开。\n扬州底事牵行色，端为琼花芍药催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院呈文潜用前韵","author":"晁补之","text":"神交千古圣贤中，尚想铜山应洛钟。\n倾盖十年唯子旧，知音一世更谁逢。\n天如蚁磨骎骎旦，谈似缲车亹亹从。\n邻榻邓侯那不共，拥衾百首兴方浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叙旧感怀呈提刑毅父并再和六首 其六","author":"晁补之","text":"亲见扬雄自不惊，吾人要使后人评。\n白圭未可轻三复，小草须防得二名。\n太华耸天如剑立，黄河蹙野似军行。\n栖迟自忆衡门后，可是登楼不称情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叙旧感怀呈提刑毅父并再和六首 其五","author":"晁补之","text":"郎潜如我未宜惊，户部须推宰相评。\n他日碧山思却走，当年紫府已收名。\n共知白发生青鬓，未废长歌续短行。\n樽酒不空多坐客，君家馀事足陶情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叙旧感怀呈提刑毅父并再和六首 其四","author":"晁补之","text":"须弥纳芥事堪惊，千岁聊堪一日评。\n世上相逢俱梦寐，古来何处是功名。\n簿书听我依稀了，云水陪君浩荡行。\n便与此山同不朽，不应惆怅复牵情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叙旧感怀呈提刑毅父并再和六首 其三","author":"晁补之","text":"二人射策几人惊，要与三苏共入评。\n先圣子孙多异禀，累朝图牒有高名。\n书传科斗犹须定，钓拂珊瑚未可行。\n子墨文章豪气在，登临怀古一含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叙旧感怀呈提刑毅父并再和六首 其二","author":"晁补之","text":"赋成庚子尚魂惊，往事如风未暇评。\n长乐钟前偶相对，凌烟图上等浮名。\n登车岂是君无意，襆被何妨我自行。\n更许心亲遗貌敬，老来尤见旧交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叙旧感怀呈提刑毅父并再和六首 其一","author":"晁补之","text":"儿童豪气自堪惊，未入乡人月旦评。\n叔向亦闻呼使上，子将一见便知名。\n平生兰省追高步，老去秦川共此行。\n赖有蒲城桑落酒，高楼条华慰人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复用前韵寄题慎思豪塘居","author":"晁补之","text":"玉泉飞落白霞峰，散入山田亩十钟。\n邓子结庐真世外，陶公脱屣更谁逢。\n莺啼春竹风烟近，龙起秋堂雨雹从。\n谁使山人空蕙帐，蓬莱金殿兴方浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨呈文潜","author":"晁补之","text":"倦将乌帽障黄日，一雨新开春已融。\n忽惊宫瓦出新碧，更喜海棠舒小红。\n爱酒邻张不可奈，听歌老谢无由同。\n春如行客祗欲去，若为挽取须壶空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"济州道中寄叶勋秀才","author":"晁补之","text":"晓路入西郊，新霜著鬓毛。\n贫交借羸马，慈母授征袍。\n野静狐狸出，天寒雁鹄高。\n艰难忆亲旧，清泪渍平皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴元老刘园之集呈十二朝请十五推官二叔父兼呈元老邦式诸公","author":"晁补之","text":"故乡等作异乡愁，常笑吾生不自谋。\n百日狂风春草草，十年归梦客悠悠。\n倦游情话陪诸父，老罢亲锄学故侯。\n得坎乘流两皆可，名亭应不用三休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴蒲道中寄洛倅王定国","author":"晁补之","text":"莫嫌马上过春风，得句桃溪柳涧中。\n王事勤君急星火，客程驱我正萍蓬。\n朅来尚可轻千里，归去何妨共两翁。\n学道如今有微力，作官求了不求功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送长道客滑道士","author":"晁补之","text":"海山兜率事悠悠，底处仍须著力修。\n莫认箭边曾有鹿，安知蓑外是无牛。\n社樗共作支离病，园絮同为汗漫游。\n亦见颜公为言此，春风过尽不抬头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送昙秀师归庐山梦斋","author":"晁补之","text":"扁舟又过楚江东，庐阜霜晴翠埽空。\n四海五湖皆逆旅，千岩万壑正秋风。\n会观沙界无华处，何必茅斋是梦中。\n已悟三生旧知识，不因天竺寺前逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送欧诚发","author":"晁补之","text":"春风共载扬州路，屈指都疑梦夜阑。\n可是重来俱白发，只堪归去却黄冠。\n为郎我赖文书少，作邑君逢政令宽。\n自古江山胜尘土，莫轻故步爱邯郸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵正夫京东漕","author":"晁补之","text":"朝持使者节，骑出大明宫。\n霜拂蓬壶外，春生海岱东。\n清时忧国事，白首问民风。\n我亦何为者，丹铅点勘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友福建转运判官","author":"程迈","text":"谈经草檄鬓华生，初拥闽山传节行。\n江入桐庐青欲断，溪从剑浦碧来迎。\n茶虽户种租宜薄，盐不家煎价欲平。\n要使祈招歌德意，君恩不为远人轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹子方福建转运判官","author":"晁补之","text":"侏儒未用笑先生，孟博聊堪揽辔行。\n学有人民可尝试，诗须山水与逢迎。\n边夷岂识朝廷治，耕钓唯知吏政平。\n台阁时清多俊彦，萧生雅意未宜轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻慎思说豪塘居","author":"晁补之","text":"闻在豪塘饮，松林日百回。\n当年鹿何往，异世鹤归来。\n未许茅斋并，终期蜡屐陪。\n丹留杉不死，夜气看星魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"原上","author":"晁补之","text":"闭门遗日月，原上感年华。\n久旱无场藿，重阳有野花。\n萧萧几家静，脉脉一歧赊。\n向晚悠然去，秋风马尾斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起答关景晖","author":"晁补之","text":"卧病车马绝，初非遗世人。\n逍遥乍形散，邂逅却情真。\n见护屏能力，相扶竹亦神。\n闲来佐欢喜，漉酒用陶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢蒲乾濠道中寄府教授之道弟","author":"晁补之","text":"冲寒到郡待花开，花未开时却遣回。\n敢意三年容我隐，只如千里访君来。\n二崤毂击何为者，五老云霾安在哉。\n更约劖诗猿虎谷，它年重过埽莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪发运右司叔父集金山次韵","author":"晁补之","text":"报国身无用，还山计欲成。\n烟霞异尘世，江海慰高情。\n幸继阮咸集，恐惭疏受声。\n清诗逢绝景，未觉负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪关彦远曾彦和集龙兴寺咏隋时双鸭脚次关韵","author":"晁补之","text":"风起雷塘陵上尘，雨荒苔院两株春。\n楼台有迹皆馀烬，草木无知尚见珍。\n博士独能名玉棐，使君还许寿灵椿。\n宣城此物常充贡，谁与连艘送万囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀八弟三首 其三","author":"晁补之","text":"扬州全盛吾能说，鸭脚琼花五百年。\n忽见山光好诗轴，却思淮浦旧渔船。\n柴荆故俗真虚老，松菊幽斋已重迁。\n便作扶藜望衡霍，清秋随分有风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀八弟三首 其二","author":"晁补之","text":"平日鸰原左右手，蟨邛前后未须论。\n清秋淮上多诗句，白首篱边近酒樽。\n杜舅高情笃兄弟，先君至性厚闺门。\n两公与尔同师法，相待归来老此园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀八弟三首 其一","author":"晁补之","text":"君好作官容我隐，我专筑室待君归。\n古来奇特俱安用，老去疏慵自不违。\n五府交书何怪密，双林白社未嫌稀。\n先君门户观之子，葵藿吾今遁益肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题宝应无斁凫舄堂二首 其一","author":"晁补之","text":"宾戏令晁子，名堂无乃迂。\n何为仍负弩，祗合便飞凫。\n彭泽且市隐，太丘犹世儒。\n解嘲吾亦倦，系雁一相娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题宝应无斁凫舄堂二首 其二","author":"晁补之","text":"弟才方浚发，兄老更疏迂。\n君自轩轩鹤，吾今泛泛凫。\n何方折腰具，能作列仙儒。\n钧是亡羊事，清樽稍可娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渑池道中寄福昌令张景良通直","author":"晁补之","text":"十年一梦间湖湘，欲往从之道阻长。\n可但知君爱彭泽，不应言我薄淮阳。\n马穿崤底流泉白，鸟下关头落照黄。\n愁作驿亭寒不寐，怀人思古九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阎醇老作默斋","author":"晁补之","text":"净名良久文殊叹，此是如来不二门。\n要识结瘖非是默，应知分别亦无言。\n一弦曾得嵇生愧，三复能令孔子尊。\n正复立谈封万户，时清何害口澜翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景修二十岁袖为乡举之首晚乃尉青田无不遇色其里人晁补之为赋五十六字以别且勉之","author":"晁补之","text":"一尉三千五百里，昔人尝已叹沉英。\n陆机文赋成童妙，梅福官资向老清。\n尽说江山多胜事，且临风月慰高情。\n它年见我长安道，货药无心更避名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游华岳归道中望仙掌","author":"晁补之","text":"深岩踏遍寻归路，仙掌依然在碧虚。\n无限游人重驻马，岂惟狂客倒骑驴。\n挂图天汉朝霞上，落影秦关夕照馀。\n千古全生才一士，可怜登览尽丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庐山","author":"晁补之","text":"丹碧沉沉虎豹闲，松幢引度九重关。\n人间未觉浑无路，天上还惊更有山。\n瑶草红泉供挹酌，金风白露送跻攀。\n良游自叹平生误，便作归来鬓已斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答刘季孙","author":"晁补之","text":"高台撷黄菊，独上忆同登。\n灌木闲相揖，寒鸦偶自朋。\n酒怜旁舍熟，赋喜故人能。\n寂莫西风里，篮舆兴可胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锁试呈同舍三首 其三","author":"晁补之","text":"周行栉比未应充，荐庙方求古鼎钟。\n经眼乍愁千纸积，解颐聊喜一言逢。\n黄花庭槛时虽过，白酒邻槽愿可从。\n更促寄衣真似旅，晓堂初怯露寒浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锁试呈同舍三首 其二","author":"晁补之","text":"天街初月映天河，拜敕东华走马过。\n解榻暂如龟遇木，闭帘还似雉婴罗。\n倦依书册工催睡，闷倚诗篇足当歌。\n可待纷纷厌朱墨，昼闲唯有饮无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锁试呈同舍三首 其一","author":"晁补之","text":"官局悠悠共此行，来时庭菊未含英。\n五更脱叶惊书几，一夜寒砧满禁城。\n诗似凉风来有思，酒如清露挹无声。\n何时骢马催归去，更有林端魄一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴","author":"晁补之","text":"渊明褊志迷归去，叔夜支辞谬养生。\n道有穷通千世运，命无夭寿四时行。\n我能为蝶斯同化，子亦知鱼乃至情。\n谓马谓牛无不可，楚肝越胆太分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"慎思闻家弟无斁捷解见贻用前韵","author":"晁补之","text":"吾弟平生辛苦同，匹雏志举百钧钟。\n自惭操瑟尚不斥，劝使力田终有逢。\n青眼故人欣捷报，白头老母喜占从。\n书林傥预西城集，釂子酣酣杏正浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒲津系桥次李棻韵","author":"晁补之","text":"激箭波涛上，为梁木石雄。\n铁牛惊陕右，流马出关东。\n潦集连艘断，冰融一水通。\n询谋自谁可，贤有赞皇公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潼关道中","author":"晁补之","text":"尘土长安古道深，潼关依旧接桃林。\n使君骢马来何后，道士青牛去莫寻。\n春半河山犹寂莫，日长坑阪正崎嵚。\n平生冷笑元龙误，老觉求田负寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题文潜诗册后","author":"晁补之","text":"君诗容易不著意，忽似春风开百花。\n上苑离宫曾绝艳，野墙荒径故幽葩。\n惬心刍豢非杂俎，垂世江河自一家。\n头白昏昏醉眠处，忆君频夜梦天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凝祥池上联句","author":"张耒","text":"粉垣周十里，丹碧焕神宫。\n楼阁晚多雨，梧桐天早风。\n人来夕照外，鸟起白蘋中。\n何用厌城郭，沧洲佳兴同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]