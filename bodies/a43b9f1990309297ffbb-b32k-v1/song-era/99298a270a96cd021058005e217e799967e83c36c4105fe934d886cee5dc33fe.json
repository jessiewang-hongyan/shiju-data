[{"title":"施进之见过二首 其一","author":"赵蕃","text":"君来能破闷，雨至更蠲愁。\n旧识庐山道，长怀鹦鹉洲。\n相从今十载，一饭未成谋。\n俱作江西去，君车我具舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"既别晦庵复成二诗呈之近欲同游善权不果临行录其湖北道中诗一轴 其二","author":"赵蕃","text":"去始丰城剑，还终大仰禅。\n纵横几诗句，摹写百山川。\n竹使承流日，蓬山促召年。\n侬行亦何为，白首使如迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"既别晦庵复成二诗呈之近欲同游善权不果临行录其湖北道中诗一轴 其一","author":"赵蕃","text":"既返山前棹，还斟枕上杯。\n雪飞如唤住，雁叫苦催回。\n金濑半篙绿，石亭千树梅。\n竟孤陪李郭，亦愧匪邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"既绝湖得顺风顷刻已见弁山二首 其二","author":"赵蕃","text":"几向诗中觅弁峰，倦游何意道兹从。\n欲搜短句五七字，却值浮云千万重。\n颇觉啸歌随趣得，不同应接向人慵。\n连朝苦厌浮家恶，今日翻思此地容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"既绝湖得顺风顷刻已见弁山二首 其一","author":"赵蕃","text":"五日阴霾斗不开，步行湖觜看帆来。\n祇言命有穷年厄，岂料风能今日回。\n自是人心分顺逆，枉于造物示嫌猜。\n篷窗纵雨无深掩，要见前山翠作堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽","author":"赵蕃","text":"南国春方尽，南风吹昼长。\n野香花袭草，秀色麦侵桑。\n客子政怀倦，田家任苦忙。\n怅予终愧汝，垂老未渠央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽日","author":"赵蕃","text":"山密风蟠木，檐疏雨著窗。\n拥衣憎旧絮，酌酒爱新缸。\n放意初无累，冥观久已降。\n一春今日尽，归梦渺三江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨见子畅尉曹与灵鹫长老年公用蕃船字韵唱酬佳什用韵呈年老","author":"赵蕃","text":"几思杖策礼金仙，闻道客来如贯船。\n政恐方成过溪送，不能容此对床眠。\n爱公诗律真馀习，怜我宗门乏厚缘。\n愿以伽佗示深旨，莫将丽藻斗多篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭礼书来告其行日再寄以诗","author":"赵蕃","text":"已执临岐手，仍通叙别书。\n绝知于我厚，何敢向君疏。\n江上留残岁，吴中拟定居。\n莫为南北恨，天地一蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"是夕再题","author":"赵蕃","text":"只道阴能蔽，那知吹忽开。\n萧萧故差胜，皎皎适何来。\n起看宁辞倦，放吟无自哀。\n虽然不可久，白露点苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐晚题","author":"赵蕃","text":"斜日欲向夕，孤怀谁与开。\n慵能翻故纸，閒且拨寒灰。\n海内长为客，江南欲放梅。\n竟将身自絷，宁有水西回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独步寺前待斯远不至","author":"赵蕃","text":"隔墅鸡啼午，经檐鸟唤春。\n静中成野步，老去得閒身。\n咫尺频相觅，追随定几晨。\n村中应倍忆，海内复谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"砚答","author":"赵蕃","text":"食砚固可笑，砚枯还有云。\n先生信难说，吾事亦徒勤。\n岁久当消髀，研穷且断筋。\n不如因坠地，瘗得退之文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日书怀","author":"赵蕃","text":"冉冉年将老，冥冥雨送秋。\n衡门想芜没，萧寺苦淹留。\n工部诗陶写，平南酒拍浮。\n九原如可作，千载愿同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋声","author":"赵蕃","text":"何处忽秋声，千崖万壑并。\n不知繇雨故，直觉太清生。\n絺绤且重著，褐裘须渐营。\n晚禾资秀实，尚有暖而晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋陂道中三首 其三","author":"赵蕃","text":"雨止鸠频唤，雨来鸠暂停。\n愁怀惟惨惨，望极更冥冥。\n鹭举青林破，牛行白水经。\n浑忘峻岭在，便拟午钟听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋陂道中三首 其二","author":"赵蕃","text":"止水通流水，前陂接后陂。\n农夫秧马驶，客子竹舆危。\n五斗真聊尔，百艰谁使之。\n不能惩创在，犹后强裁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋陂道中三首 其一","author":"赵蕃","text":"晨钟离野寺，早市出村墟。\n山在空濛里，路经崩缺馀。\n崎岖方自此，阻绝信非虚。\n却羡林间翮，飞翔得自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨感怀","author":"赵蕃","text":"红叶连峰雨，黄花独径秋。\n一杯聊复酒，万斛不堪愁。\n短发惊时晚，修名怯岁遒。\n山中隐玄豹，江上失轻鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种柏","author":"赵蕃","text":"插柳终惭桂，殷勤买柏栽。\n予如樗栎者，汝自栋梁才。\n今日藩篱护，他年风雨哀。\n人生朝暮尔，此物到云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"药圃旧无竹仆为作诗从闲止乞栽","author":"赵蕃","text":"如闻旧隐竹多有，想见频年笋更添。\n一日借居无不可，数竿分我未伤廉。\n悬知影可连书屋，便恐山无到野檐。\n如许作谋还自笑，未应于此是真潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵溪简李商叟方元直","author":"赵蕃","text":"李侯佳句似阴铿，早向茶山识赣曾。\n涤器宁同长卿逸，闭门不学玉川憎。\n平居尚忆寻君去，南庙应还访我能。\n诗卷当时更谁与，玄英文采被云仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺向伯元通判休致","author":"赵蕃","text":"芗林再世企疏堂，不但私荣国有光。\n毕娶了知家法在，耐官爰自祖风长。\n眼明图史犹年少，手种桧松今老苍。\n父客同时亦同盛，成都卜宅匪它杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺周待制兼直学士院","author":"赵蕃","text":"重闻陆贽掌丝纶，可念公朝道必伸。\n暂向玉堂还旧直，亟从凤沼据通津。\n招来赞普边疆肃，诏感山东德意新。\n谁谓文章财小技，计功端合画麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺魏使君雪用何叔信韵","author":"赵蕃","text":"汉竹初来号令班，不知疆域远长安。\n阳升顿使群阴伏，旱极真成上瑞看。\n比拟敢言风絮乱，丰登预想麦秋寒。\n冰清玉润登临处，不用赋诗名喜欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵龙泉惠书及和三诗且用孙温叟韵作诗见劳次韵","author":"赵蕃","text":"一纸翻翻正复颇，数诗兼与问云何。\n敢言少日期耕籍，但道今年学荷戈。\n已办向人腰为折，更愁逢彼怒成诃。\n知时未暇伤鹈鴂，拨谷惟思和九歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵蕲州枉示数诗皆弋阳往还所作经行道间有怀其人作长句寄之","author":"赵蕃","text":"一饭留人意甚真，数篇仍出好诗新。\n追随却恨向来少，怅望空增别后频。\n到处鹭鸥如习熟，转经山水尽精神。\n可怜吟讽多馀地，只是登临无若人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王子尊赴衡阳丞","author":"赵蕃","text":"王郎妙人物，独步向江东。\n昔尉既不醉，今丞宁肯聋。\n相依唇齿国，忽去马牛风。\n清绝官曹外，何年著我同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送文叔入都兼简陈元龄周畏知文叔之弟华叔 其一","author":"赵蕃","text":"叔夜虽逃懒，元龙政坐豪。\n清谈尽名理，老句逼风骚。\n才大端难屈，时平敢自高。\n骅骝合鸾辂，斥鴳祇蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送文叔入都兼简陈元龄周畏知文叔之弟华叔 其三","author":"赵蕃","text":"松谷门无锁，迂斋席有尘。\n山林从寡伴，台阁政须人。\n才识思难弟，仪型想伯仁。\n诸公皆衮衮，老子自踆踆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送文叔入都兼简陈元龄周畏知文叔之弟华叔 其二","author":"赵蕃","text":"落落初寮裔，英英桐树孙。\n科虽分进士，官亦到词垣。\n近例皆如此，兹行不在言。\n故人谁健在，为我谢陈蕃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王亢宗赴建德尉","author":"赵蕃","text":"雁断行连雨，梧乾叶陨风。\n悲凉今日别，邂逅几时同。\n末路多浮梗，吾生甚转蓬。\n青衫溧阳尉，不叹孟郊穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王汝之江西二首 其二","author":"赵蕃","text":"君行应到郁孤台，惆怅登临记昔孩。\n别酒尚迟三径菊，归鞍好待一枝梅。\n将军揖客能增价，幕府群贤定挽才。\n我亦方谋下吴会，未知何地得重陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王汝之江西二首 其一","author":"赵蕃","text":"一杯浊酒慰飘零，百首新诗见典型。\n笑买扁舟又西去，怅予蓬户只深扃。\n向来雨合滕王阁，复道榛迷孺子亭。\n珍重君行烦寄语，明年访古会重经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王饶州赴召","author":"赵蕃","text":"吾君日旰坐延英，寤寐得人成太平。\n常恐珍才在空谷，岂容旧德久专城。\n颍州便合为丞相，渤海无庸拜水衡。\n今代吴公祇公是，自惭名谢洛阳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王赞子襄","author":"赵蕃","text":"倦能听雨眠窗底，忽起看山到水边。\n遂性不如冲露鸟，流行何况下江船。\n不臻屈子南征地，宁识秦人避世仙。\n邂逅相逢又相别，一杯重把定何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送处州斯远二首 其二","author":"赵蕃","text":"珍重徐斯远，兹行岂漫游。\n过江探禹穴，下水到严州。\n损益观其友，渊源问所由。\n我居如有絷，君去莫能留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送处州斯远二首 其一","author":"赵蕃","text":"孰有如公者，蕲州又处州。\n时人得称诵，氓俗记君侯。\n吏有循良择，官无内外忧。\n愿将田里事，一一奏前旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘伯瑞四首 其四","author":"赵蕃","text":"衡州有贤牧，吾党更监州。\n事作盐梅济，殊非泾渭流。\n斯民均受赐，治状各推优。\n看即蓬山上，联翩两校雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘伯瑞四首 其三","author":"赵蕃","text":"居者与仕者，所知张宋间。\n咸能谓君好，政欲警余顽。\n论已穷千载，才宁减二班。\n何当传副本，免使访名山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘伯瑞四首 其二","author":"赵蕃","text":"远斋无恙日，酬唱几多诗。\n杜集容今附，韩门见昔师。\n青云虽益显，种发欲奚为。\n更欲求馀本，流传海内知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘伯瑞四首 其一","author":"赵蕃","text":"长怀远斋老，赠我五言城。\n世上几朋友，吴中君弟兄。\n频年欣再见，南走怅东征。\n情话悦亲友，交情见死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘通判二首 其二","author":"赵蕃","text":"国祚重兴后，人才应运生。\n端殊飞紫鷟，亦异梦长庚。\n大半庙堂用，若为州县更。\n垂弧贺今日，连茹徯兹行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘通判二首 其一","author":"赵蕃","text":"射策今晁董，摛词昔左班。\n题舆已最课，召节待遄颁。\n鹏背九万里，龙媒十二闲。\n除书看台阁，盛事耸荆蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送向如愚赴庐陵丞","author":"赵蕃","text":"乃祖当年耐官职，远孙今日振家声。\n闭门已尽五车读，补吏反为千里行。\n丞不负君休自厌，诗能穷我竟何成。\n春风尽可宽役役，不用回头数去程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孙子肃子仪兼寄子进","author":"赵蕃","text":"自君来主玉光亭，老柳频看秃又青。\n鸡黍欣留故人饭，文书恶杂长官厅。\n乡来念别今真去，从此微言孰为听。\n伯氏应门季同役，叹予无策佐扬舲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送成父弟赴补试兼属同行亲友","author":"赵蕃","text":"南省新升弟子员，诏来郡国亦详延。\n百年涵养期为用，一日选抡非所先。\n珍重好营当暑服，丁宁休觅候潮船。\n故知同役皆亲友，莫忘书来慰目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邢大声宏音二首 其二","author":"赵蕃","text":"不独论新昏，晏晁原老亲。\n见来能几日，别去忽今晨。\n圣代无迁贾，明时岂避秦。\n长沙武陵地，行乐恐伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邢大声宏音二首 其一","author":"赵蕃","text":"客里送行人，情钟况所亲。\n絮飘吟帽雪，花杂马蹄尘。\n何处为寒食，还家尚及春。\n园林检校事，欠酒著诗陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴提刑赴召三首 其三","author":"赵蕃","text":"只道边城狱讼稀，那知亦有造空为。\n不惟宽大难容止，正畏精明莫可欺。\n已矣榜敲成俗吏，怀哉香火奉湘祠。\n傥蒙一纸闻天奏，便是吹嘘送上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴提刑赴召三首 其二","author":"赵蕃","text":"连朝欲作送公诗，以颂悬知孰愈规。\n万事要当明本末，一身切莫计安危。\n老农不过除荑稗，良药安能弃朮芝。\n勿谓常谈便轻鄙，献言端自戒新奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴提刑赴召三首 其一","author":"赵蕃","text":"拥节西来岁未更，提封略已遍循行。\n洞庭青草绝馀寇，沅水武溪俱力耕。\n勿漫绣衣閒直指，正应天下急澄清。\n治平已召吴公去，材秀何人是贾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孝显彦博昆仲赴补仍用前韵","author":"赵蕃","text":"清时择士岂充员，大辟贤关务远延。\n一日擅场称举子，百年匡国是儒先。\n为言行役加餐饭，仍祝涛江稳放船。\n意惬归来期不晚，秋风觞酒大人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张王臣还峡州兼属峡守郭郎中季勇二首 其二","author":"赵蕃","text":"久矣闻风折角巾，近来乃得诵诗新。\n雨奇晴好西湖赋，梅落草生三峡春。\n再拜因行为多谢，尺书愿寄恐无因。\n靖州傥有平安使，佳句惊人不厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张王臣还峡州兼属峡守郭郎中季勇二首 其一","author":"赵蕃","text":"九州四海张安国，翰墨文章自出奇。\n无复若人空阁象，忽逢难弟更名诗。\n流风善政未云远，家世斯文当属谁。\n我愧不堪门户寄，相逢叹息在于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张王叔孝曾二首 其二","author":"赵蕃","text":"接壤渠阳郡，咸歌别驾贤。\n荐书曾列上，除日听争传。\n水疾山危处，风高木落边。\n栖栖怜倦客，渺渺送归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张王叔孝曾二首 其一","author":"赵蕃","text":"难弟诗初和，难兄盖复倾。\n时方论名位，公独叙交情。\n八座使边节，舍人垂世名。\n用之俱未尽，衮衮看公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张交代琮","author":"赵蕃","text":"历数旴江士，推君父子间。\n夷途有霄汉，蹇步乃荆蛮。\n荐牍方争上，交情勿重攀。\n无缘更州县，小试亦编删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张刚中赴省","author":"赵蕃","text":"王都观阙两巍巍，远道观光亦已稀。\n当念功名方发轫，可辞尘土暂侵衣。\n春风咫尺君得意，晚岁伶仃我欲归。\n傥过南山语吾弟，尺书因冷倦重挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李元藻入浙三首 其三","author":"赵蕃","text":"我作长沙客，诸公多与游。\n闻风亦云旧，识面怅无由。\n忽辱高轩过，仍蒙古句投。\n偶从旁舍去，不办小淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李元藻入浙三首 其二","author":"赵蕃","text":"汉广求才路，严徐出上书。\n朝犹辱徒步，暮已待公车。\n今世无兹辙，夫君欲振裾。\n虽然宁有限，或者为吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李元藻入浙三首 其一","author":"赵蕃","text":"唐室登科士，多因行卷知。\n至今传不朽，犹或谓能诗。\n辟置仍于取，山林亦罔遗。\n莫嗟今古异，穷达岂人为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李仲诗二首 其二","author":"赵蕃","text":"今代知名士，君家萃一门。\n不惟文献在，政是典刑存。\n台阁期平步，沅湘莫断魂。\n平生翰墨事，兹可壮期源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李仲诗二首 其一","author":"赵蕃","text":"武陵曾远客，主簿作南征。\n缅想经行地，犹含赋咏情。\n故人如见问，白发欲千茎。\n却记相逢日，回头岁月惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李袁州汎舟入浙","author":"赵蕃","text":"晦庵无处著，泛宅又吴淞。\n载月初寻棹，看山不藉筇。\n听渠猿鹤怨，心喜鹭鸥逢。\n遥想题诗处，枫桥半夜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈善昌朝","author":"赵蕃","text":"论契繇先世，言交自乃翁。\n俱成落湖外，每恨隔湘中。\n得见无几见，愿同终罕同。\n如闻工赋好，无或嗜诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]