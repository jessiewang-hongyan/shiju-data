[{"title":"武夷鸡窠岩","author":"翁彦约","text":"仙人清磬读黄庭，长听金鸡半夜声。\n一夕都随黄鹤去，满巢明月白云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷三层峰","author":"翁彦约","text":"层峰三叠倚青冥，雾宿云飞自有程。\n杳霭又因关造化，故教人世验阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷毛竹洞","author":"翁彦约","text":"毛竹连云路欲迷，洞门深锁落花迟。\n鲁孙几度春风老，未了仙人一局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙钓台","author":"翁彦约","text":"百粤尧时路未通，曲溪春水没长松。\n老仙台上无明月，不钓凡鱼只钓龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晞真馆","author":"翁彦约","text":"濯濯清溪九曲流，一天风露万山秋。\n凄清不似人间世，月槛云窗特地幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同官李仲益赠张思仲家歌人团茶因题其封","author":"赵令畤","text":"色映宫姝粉，香传汉殿春。\n团团明月魄，却赠月中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈履常汝阴久雪赈饥","author":"赵令畤","text":"坎壈中年坐废人，老来貂鼎视埃尘。\n铁霜带面惟忧国，机阱当前不为身。\n发廪已康诸县命，蠲逋一洗几年贫。\n归来又扫宽民奏，惭愧毫端尔许春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到长安","author":"赵令畤","text":"来往长安未定居，暂将僧舍当吾庐。\n空中说法凭铃语，枕上朝饥听木鱼。\n因果分明休问佛，行藏自信罢占书。\n眼前一物真堪羡，百尺长杨水满渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁以道嘲陈叔易得官入京","author":"赵令畤","text":"闻道诸公置齿牙，买鞯卖展趁年华。\n太平起隐无遗策，空尽嵩山处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋太白醉草","author":"赵令畤","text":"虽自九天分派，不与万李同林。\n步处雷惊电绕，空馀翰墨窥寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋","author":"赵令畤","text":"白藕作花风已秋，不堪残睡更回头。\n晚云带雨归飞急，去作西窗一夜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"被责三十年蒙恩召还行在方驻跸钱塘书呈子常侍郎","author":"赵令畤","text":"三十馀年一梦同，向来朝士尽沈空。\n如今白首趋行阙，不是当年长乐钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠陈处士","author":"赵令畤","text":"疏慵任过少年时，名利难交远近知。\n一洞落花春病酒，满楼明月夜吟诗。\n展编海曲菰蒲叶，杖剪嵩阳楖栗枝。\n却话东林拟重去，伴僧闲逸白莲池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江楼閒望","author":"赵令畤","text":"红尘无处不諠哗，独上江楼四望赊。\n泥水僧归林下寺，待船人立渡头沙。\n云藏岛外啼猿树，竹锁桥边卖酒家。\n吟罢凭栏心更逸，海风吹断暮天霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日居山","author":"赵令畤","text":"乱山深处过严凝，僻静门邻物外僧。\n送客踏穿松径雪，煮茶敲破石池冰。\n朝垂帘幕寒慵卷，夜锁楼台静懒登。\n只待春来归上国，杖藜吟出白云层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"赵令畤","text":"我识之无常缩舌，君能竞病且低头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"赵令畤","text":"酒成碧后方堪饮，花到白来元自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"赵令畤","text":"卧听檐雨作宫商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"赵令畤","text":"紫蟹黄橙知有思，天教出向夜凉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒照师塔二首 其一","author":"释宗敏","text":"苧麻删补后，法律渐凌迟。\n一字谁褒贬，三宗绝见知。\n奔驰事名相，逸荡傲行持。\n独有芝园老，提纲继祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒照师塔二首 其二","author":"释宗敏","text":"兵火焚诸刹，楼台化碧烟。\n松龛横野岸，塑像枕流泉。\n志述都煨烬，功名独不迁。\n高踪杳然梦，不觉涕潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陆傅","text":"枕上吹齑醒宿酒，窗间秉烛拾残棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陆傅","text":"宁知小儿辈，竟坏好家居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭魏夫人","author":"张夫人","text":"香散帘帏寂，尘生翰墨闲。\n空传三壶誉，无复内朝班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李湜","text":"迸石如散珠，穿云似流玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清芬阁","author":"茹东济","text":"舣棹叩朱门，雄飞处士村。\n诗名千古重，庙貌一方尊。\n绿水长溪阔，青山远岫昏。\n辞华谁善继，御史是曾孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"象鼻岩","author":"张元仲","text":"会入苍舒万斛舟，至今鼻准醮清流。\n君王玉辂催行驾，安得身闲伴白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越王城","author":"方叔震","text":"闻道越王避汉兵，窜身岩谷觊偷生。\n如云甲马今何在，只见良田万顷平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王直方","author":"秦觏","text":"不到王家近十年，子猷风韵亦依然。\n旧时朋友今何在，别后新诗谁与传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈东坡","author":"秦觏","text":"十里荷花菡萏初，我公初置有西湖。\n欲将公事湖中了，见说官閒事已无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王直方夜坐","author":"秦觏","text":"帏幔高深夜漏长，颇从诗酒傲冰霜。\n烛花渐暗人初睡，金兽无烟却有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城东寄王越州","author":"高茂华","text":"五年不出青门道，邂逅寻春此一回。\n忽忆秦川贵公子，桃花落尽合归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"高茂华","text":"中途留眼占星聚，一宿披颜觉雾收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张庭坚","text":"儋耳百年经僻陋，眉山二老继驱除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题北山松轩","author":"石公弼","text":"梢云阻日引清风，抱石盘根造物工。\n凌厉四时同一色，不知何岁植岩中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游嘉祐院登般若台","author":"石公弼","text":"萦回岩岫拥高楼，饮海拿云走翠虬。\n欲问此台名般若，一轮明月照中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游日山","author":"石公弼","text":"岚光咫尺见山扃，候得潮来一苇轻。\n惨惨晚堂看日色，森森古殿对江城。\n风敲寒玉惊僧睡，岩落澌冰认雨声。\n不是平生曾到处，因缘今日此中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题樗轩线泉及闻琴","author":"石公弼","text":"竹引高山一线泉，细如丝发亦涓涓。\n莫嫌此去沧溟远，流水更听琴上弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题无垢院 其一","author":"石公弼","text":"沿磴穿岚造竹扉，一轩幽敞坐忘机。\n池镵琼骨容清泚，凭槛时看翡翠飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题无垢院 其二","author":"石公弼","text":"净界曾无一点尘，风疏松竹响天真。\n从来此意少人会，只道林閒无至人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游巾子山诸刹","author":"石公弼","text":"杖策游山寺，终朝事讨寻。\n地危敧石磴，殿古倚云岑。\n曲径行松杪，禅房过竹林。\n奈何幽兴在，他日更登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"赵占龟","text":"四枚豚犬教知书，二顷良田尽有馀。\n鲁酒三杯棋一局，客来浑不问亲疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢传神蔡景直","author":"鲍慎由","text":"驰誉丹青有古风，笔端及我未宜蒙。\n云台麟阁遥相望，枉写褒公与鄂公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王略帖赞","author":"鲍慎由","text":"昭回于天垂英光，跨颉历籀化大荒。\n烟华浓淡赋低昂，一噫万古称天章。\n鸾跨虬引鹄序行，洞天九九归辽阳。\n茫茫十二小劫长，玺完神诃命芾藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨馀","author":"鲍慎由","text":"础润雨欲作，好风每相先。\n萧萧清入帘，令我心洒然。\n闭门倦永夏，枕书日昏眠。\n快此风雨馀，端如濯飞泉。\n盆山有佳趣，草木更幽妍。\n井华养文石，香篆横云烟。\n俯仰方丈间，胜事亦可怜。\n永怀触热子，我劳良独贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读汉书","author":"鲍慎由","text":"汉公事业比阿衡，纯用诗书致太平。\n它日何人颂功德，至今嘲笑亦诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"鲍慎由","text":"万卷堆中种眼花，睡魔亦厌夜深茶。\n平生不草长门赋，岂有黄金送酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曾子开","author":"鲍慎由","text":"白发波波尚问津，可嗟志业在经纶。\n十年于此才三见，四海如公复几人。\n虎穴功名劳唾掌，醉乡风月且藏身。\n平安欲问无来使，何处荒山野水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与郑公华自朐山邻舟行","author":"鲍慎由","text":"舟行有后先，相去能几许。\n铿轰金鼓声，见面不得语。\n水花来幽香，岸柳过疏雨。\n登舻各乘风，解帆会联浦。\n闲携小龙团，睡起就君煮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"鲍慎由","text":"三白岁可期，一饱分已定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"鲍慎由","text":"学诗比登仙，金膏换凡骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"鲍慎由","text":"平池九曲在，春水萦埼■。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"鲍辉","text":"下瞰波澜知海阔，仰观霄汉得天多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄檗寺","author":"李谕","text":"但觉壶中长日月，焉知世上有风波。\n龙收雨雹归岩穴，僧伴烟霞宿鸟窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏贺何端明得子","author":"袁灼","text":"庆门昨夜梦熊罴，晓得明珠照凤池。\n却忆刘郎诗句好，海中仙果子生迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"董行之","text":"赖有遗鞭在黄道，不教追骑及清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"黄蕡","text":"黄栀姑且饶他咏，丹桂行须见我攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉泉院荔枝轩","author":"杨朏","text":"曾观荔枝图，几费丹青妆。\n能红能紫亦能绿，不能写得天然香。\n曾读荔枝谱，品品堪第一。\n较量滋味论高低，大抵闻名不闻实。\n我疑真宰推化工，安排百果分番红。\n杏梅桃李不足数，先教碌碌随春风。\n锦囊玉液相浑沦，百果让作东南元。\n别有真香与味色，一时分付荔枝轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"胡璪","text":"南安建邦庾岭下，小小城池坚四壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"刘渭","text":"庶子泉寒澄雅思，阳冰篆古足清心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"刘况","text":"夜观月色如银色，朝听潮音杂梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆欧段","author":"周行己","text":"岁暮何所思，道南咸与籍。\n出门泥漫漫，跬步成乖隔。\n人情未免俗，节物复感迫。\n念我江海人，纾节慕古昔。\n少年弄柔翰，颇谓得所适。\n岂有轩冕心，况自便菽麦。\n人生不可意，变态忽如弈。\n狼藉太学生，俯就科举责。\n居然五六载，颇不料损益。\n贫贱思富贵，富贵悲迫阨。\n所得九牛毛，置身岂良策。\n何如谢客儿，会稽卜佳宅。\n文章富贵心，山水乐幽僻。\n长安不可居，季冬犹絺绤。\n缅望悲故乡，恨无晨风翮。\n寒窗九转肠，纷乱不可绎。\n此意竟谁语，坐觉鄙吝积。\n不见二三子，讵可论肝膈。\n悠悠百世名，浩浩此生迹。\n离娄烛千里，盲不见咫尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"营居有感","author":"周行己","text":"有鹊衔枯枝，往往营其巢。\n巢成雌卵雏，雏出声嗷嗷。\n雌飞雄啄食，络绎日百遭。\n咄哉谁使汝，理也不可逃。\n旷旷宇宙内，顾奚独汝曹。\n人生结栋宇，斩木与诛茅。\n经营壮有室，耆艾尚勤劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"待李纯如邓子同","author":"周行己","text":"谁云相知好，相知亦吾累。\n一夕不在眼，青灯已无寐。\n晚定李邓交，付托足心地。\n嶷然诸儒中，百马逢一骥。\n对我怀抱豁，轩眉得深意。\n昨朝分手出，冠带修人事。\n淹留久未返，终夕念乖异。\n摇落庭树秋，虚窗发清吹。\n坐起无一欢，出门屡瞻跂。\n归鼓朱丝弦，复理黄卷字。\n弦诵虽曰乐，其如心不遂。\n欻欲往从君，念无晨风翅。\n扫地焚香坐，聊以待君至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题乐文仲惫轩","author":"周行己","text":"古有大隐人，不必在林薮。\n屠钓得贤杰，能出汉庭右。\n用之即为虎，信是经济手。\n乐生淮海来，贫窭常露肘。\n乃翁病风痹，粥食不到口。\n下帘长安市，授经供卯酉。\n生涯一惫轩，貌作槁木朽。\n胆实大于身，豪气贯牛斗。\n往往或下人，恐是黄石叟。\n屈身以伸道，此事古来有。\n贫贱交分薄，益见俗态丑。\n丈夫岂得知，事定盖棺后。\n与尔同一笑，聊进杯中酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题凤翔长孙家集芳亭","author":"周行己","text":"种木须种松，松有四时芳。\n种草须种兰，兰有千里香。\n众木岂不大，秋至即凋伤。\n百草岂不好，露下纷萎黄。\n人生事园圃，用意各有方。\n不贵草木多，只贵草木良。\n但种松与兰，主人家道昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩师求诗归台州","author":"周行己","text":"越鸟栖南枝，胡马依北风。\n人生亦怀土，安能长西东。\n玩公白云老，方丈凭高峰。\n忽为万里游，应缘来晨钟。\n君看伊与洛，二川日溶溶。\n逝者亦如此，流转何时穷。\n我居谢公山，天台一水通。\n莽莽宇宙内，那知忽相逢。\n尘埃识眉宇，觉我耳目聪。\n暂来还复去，有如无根蓬。\n令我长叹息，不得久相从。\n侧身鸡鹜群，仰羡高飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和佛月大师","author":"周行己","text":"朝出太学门，广路长飙飞。\n如可缁尘微，污我如雪衣。\n拟足投清净，入寺扣禅扉。\n遇彼赏心人，发言破夕霏。\n既见弥明句，乃知侯喜微。\n琅琅发妙语，慰此渴与饥。\n小卷大字书，一一各有归。\n更以金玉赠，万丈生光辉。\n日落微云收，明月满书帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠沈彬老","author":"周行己","text":"永嘉人物衰，斯文久零替。\n学徒寡道心，日与风俗敝。\n我生衰敝后，上思千载事。\n实欲闾里间，一一蹈仁义。\n敬重乡人情，翻遭俗眼忌。\n晚得沈夫子，学问有根柢。\n矫矫流辈中，颇识作者意。\n欢然慰吾心，归此同好嗜。\n吾子更我听，士也贵尚志。\n古道自足师，不必今人贵。\n荼苦不异亩，薰莸不同器。\n所忧义理愆，何恤流俗议。\n进道要勇决，取与慎为计。\n去恶如去沙，沙尽自见底。\n积善如积土，土多乃成岿。\n读书要知道，文章实小技。\n子试反覆思，鄙言有深味。\n自非心爱合，安能吐肝肺。\n行行慎取之，纾节思远大。\n岂但劝乡闾，永为斯民赖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"敬赠李方叔","author":"周行己","text":"蛟龙吐云气，雾豹出文采。\n许颍有佳士，翰林风流在。\n吾道固多艰，明时屡危殆。\n嘉谷生螟蝗，稊稗劳取采。\n平生数万言，未料寒与馁。\n天生济世才，发挥必有待。\n伯乐一顾重，岂不价百倍。\n展足造青云，会见绝四海。\n顾我茅苇姿，谬欲渐兰茝。\n达人固多可，借誉饰驽猥。\n丈夫一相知，胸中何磊磊。\n愿作南山松，青青期不改。\n此事虽一时，风流激千载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]