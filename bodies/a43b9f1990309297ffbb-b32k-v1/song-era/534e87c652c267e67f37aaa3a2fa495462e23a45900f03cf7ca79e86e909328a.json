[{"title":"新市杂咏 其六","author":"华岳","text":"不带冠儿不插花，过门佯把扇儿遮。\n嗔人贪数天边雁，失记回头唤吃茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新市杂咏 其五","author":"华岳","text":"小桥相见便相亲，犹带西湖陌上尘。\n欲买一樽聊款曲，归迟还怕小蛮嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新市杂咏 其四","author":"华岳","text":"迟迟莲漏不相催，亭馆无人午夜开。\n风欲捲帘花影动，梦魂疑是故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新市杂咏 其三","author":"华岳","text":"恰把青荷插髻鸦，嗔人偷眼过窗纱。\n一盘珠翠俱抛掷，却向枝头摘杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新市杂咏 其二","author":"华岳","text":"翠翘佯醉倩人扶，约我文君卖酒垆。\n解佩向人陪笑问，一杯容妾佐樽无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新市杂咏 其一","author":"华岳","text":"云鬟烟鬓缕双鸦，一搦宫腰柳带花。\n试问行云何处觅，画桥东畔是奴家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 小春","author":"华岳","text":"闽南十月已春回，无限风光暗里催。\n桃李海棠俱斗艳，谁云梅是百花魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 忆西湖","author":"华岳","text":"十年南国叹徘徊，一片乡心拨不开。\n应是西湖花柳问，风流何事未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 月夜吟","author":"华岳","text":"一声残角送黄昏，独倚阑干空断魂。\n竹影扫阶尘不动，自挨明月闭柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 水禽","author":"华岳","text":"一曲渔歌古渡头，几多鸥鹭起汀洲。\n西风吹散瑶池雪，点破长天万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 会五友","author":"华岳","text":"联翩屐齿破苔痕，醉里觥筹不计陈。\n来日不须关太史，五星今返聚瓯闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 早春","author":"华岳","text":"梅梢弄粉做新晴，积雪残云没一星。\n只把眼前春事卜，麦坡已作佛头青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 江涛","author":"华岳","text":"晓钟搥动巨鳌䟫，枕上春雷一夜轰。\n应是金鳞三十六，化龙头角逞峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 问宿","author":"华岳","text":"紫骝回首客思归，万里家山蝶梦迷。\n问宿莫来林下邸，夜深生怕杜鹃啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 幽居","author":"华岳","text":"独自清閒独自忙，杳无人迹到萧墙。\n眠时不用呼童仆，自有清风为拂床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 春思","author":"华岳","text":"东风吹恨入青楼，满目春容总是愁。\n杨柳织成丝万缕，凭谁裁作翠茸裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 独宿","author":"华岳","text":"朔风号木作严霜，锦被重重冻欲僵。\n夜半脚跟疑已割，梦魂安得到高堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 送行","author":"华岳","text":"秋波春水照残霞，恨雨愁云亸髻鸦。\n飞上领襟随得去，妾身安得似杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 晓望","author":"华岳","text":"长天万里扫清秋，宿雾朝云寸不留。\n向晓残星犹未落，一盘棋子倩谁收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 宿茅亭","author":"华岳","text":"投宿茅亭得夜凉，鹧班摇落奏筼筜。\n青簪击破寒窗纸，漏得山花一线香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 宿溪上","author":"华岳","text":"梦回斜月挂林端，酒力初消怯夜寒。\n何处客舟犹未泊，一声柔橹过前滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 患疮","author":"华岳","text":"前回风疾遍身红，布褐因烧艳火烘。\n两腿热疮今又发，休将纸被把头蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 渔儿","author":"华岳","text":"无肉鸬鹚入水频，双童联网立沙滨。\n问渠归得鱼多少，才可为羹了一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 落花","author":"华岳","text":"东风吹恨上眉头，两岸桃花瞰碧流。\n一片红云飞不起，断霞残照落汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮斋杂咏 嘲染鬓者","author":"华岳","text":"万事关心两鬓秋，柳灰何用苦文羞。\n无情霜雪催年少，閒似青山犹白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"群鸥","author":"华岳","text":"一声渔笛发中流，惊起平沙万点鸥。\n去尽青天回欲集，梨花无数落汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛾眉亭","author":"华岳","text":"天边新月覆双弯，翠敛云浓特地寒。\n我意两山皆土木，诗人浪作有情看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧画","author":"华岳","text":"万景峰前老禅叔，搜罗风月归岩谷。\n胸中有句吐无声，写作生绡三四幅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮秋闻雁有怀 其二","author":"华岳","text":"菊黄萸紫染成愁，妆点西风两鬓秋。\n多少情怀无处托，欲凭归雁问青楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮秋闻雁有怀 其一","author":"华岳","text":"西风吹起别离愁，满目凄凉不奈秋。\n归雁不随残照落，却和柔橹过沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲贺将仕 其一","author":"华岳","text":"花何太喜谁能赋，叶是良媒解寄诗。\n但觉人间传盛事，不知天上集佳期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲贺将仕 其二","author":"华岳","text":"吾身西圛拘犹少，君腹东床坦已多。\n我欲屠牛穷建节，君从欢燕小登科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬晴","author":"华岳","text":"腊月南州不类冬，梨花飘粉小桃红。\n未曾飞动遥山雪，早有春三二月风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲热","author":"华岳","text":"赤帝乘龙驾火车，晴空烧断暮天霞。\n流金烁石休相酷，少皞看看催戍瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题丹青阁","author":"华岳","text":"阁唤丹青似恐疏，丹青难向阁中模。\n诗人醉眼无区别，错认烟霞作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题莲华壁间","author":"华岳","text":"风外落花千万片，水边啼鸟两三声。\n无情惊起阳台梦，独倚閒窗看月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题窗间","author":"华岳","text":"阳虎不名真盗玉，子张何事便书绅。\n圣贤立论有微旨，精义当求妙入神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠吕元玘","author":"华岳","text":"周末见人歌采芑，楚先闻客赋离骚。\n胸中有气不能吐，空使虹蜺万丈高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠别 其四","author":"华岳","text":"娇羞犹记别时言，教我春衣尅可单。\n说与苍头浑忘□，晓来真个作轻寒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠别 其三","author":"华岳","text":"挨定青骢不肯骑，征衫褪领又重提。\n柳风吹不断行色，更倩柔条绊马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠别 其一","author":"华岳","text":"惆怅长亭叹别离，送君东去望西归。\n落花也似知人意，沾定春衫不肯飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠美人别","author":"华岳","text":"花脸送愁和露泣，莺声传恨向人娇。\n别情远去尤难割，相送不须离画桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"华岳","text":"禾落西风黄叶飞，子卿无信雁来迟。\n凄凉自笑刘思父，慷慨难追杜牧之。\n归兴十分浓似酒，愁肠一缕乱如丝。\n凭君细把茱萸问，此会明年健有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日言怀","author":"华岳","text":"凄凄天气间炎凉，破帽翻风客斗狂。\n酒味暗消黄蕊辣，雁声唤得菊花香。\n三京昔拟恢同轨，九日今犹客异乡。\n更仗阿谁上沙漠，为予申意郭汾阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日溪楼远望","author":"华岳","text":"西风寥落做重阳，人在东南水一方。\n地僻阻它鸿雁信，天寒撩我菊萸觞。\n江澄素练鱼翻赤，叶剪红绡蟹结黄。\n不是倚阑迷望眼，欲凭归雁问苏郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上韩平原","author":"华岳","text":"君家勋业在盘盂，莫把头颅问钃镂。\n汉地不埋王莽骨，唐天难庇禄山躯。\n不随召奭始求老，便学孔明终托孤。\n十庙英灵俨如在，谩于宗社作穿窬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与楞伽老瑛上人","author":"华岳","text":"勿谓年来世道艰，都缘彼此不相参。\n一生知己有千万，十事从人无二三。\n红杏无坛堪拱北，白莲有社结和南。\n扁舟若有东归便，断竹枯松寄一担。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小圃","author":"华岳","text":"舍北有馀隙，平禠作小园。\n花存四五本，竹种两三根。\n风伯倩摇佩，月娥烦佐尊。\n谁知方丈里，别有一乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"华岳","text":"布作宽袍竹作冠，萧然万虑不相关。\n数声横笛烟霄外，一个閒人天地间。\n若遇急流须勇退，从教倦鸟不知还。\n百年富贵君休羡，得似浮生半日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不祷","author":"华岳","text":"不炷灵香不诵经，兆杯签榜总欺人。\n穷通只合从天地，祸福何须问鬼神。\n命到死时生莫倖，事当直处曲还伸。\n从今若问开先事，桃李无言二月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丹青阁","author":"华岳","text":"阁上阑干紫翠环，阁中身世异尘寰。\n长虹吸月印秋水，孤鹜伴霞量晚山。\n万里风烟屏帐里，一时人物画图间。\n凌烟须是男儿事，却恐功名未放閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书太乙编年卷尾","author":"华岳","text":"年来太乙犯咸池，三式编年事可疑。\n西北膏腴从脯腊，东南皮肉恐疮痍。\n尧天日月期无已，胡地烟云岁有之。\n更向江湖问同志，中原何日是归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书堂遇雨","author":"华岳","text":"风叠云成片，沟搓水作层。\n湿书移案避，添砚就檐承。\n瓦击声疑雹，窗低暗欲灯。\n须臾西漏日，晴意慢腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双桂堂","author":"华岳","text":"月姊亲移入庆门，广寒今是并肩人。\n分他蟾窟雌雄种，作我萤窗南北邻。\n傲窦虽悭三树玉，比诜翻剩一枝春。\n主人便好鞭黄鹄，斫取魁梢谢紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆弟妹","author":"华岳","text":"别来三载客东南，始信人生聚首难。\n眼底不闻鸿雁信，鼻头常为鹡鸰酸。\n问天不语语徒厉，蓦地上心心类剜。\n安得春风吹马首，卧听行列报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斗斋","author":"华岳","text":"八方无处著瞿昙，百合中间寄一龛。\n满挹酒浆供里北，平量风月借和南。\n腰如可折岂徒五，涎若果流何待三。\n更喜小窗能就拱，夜寒江静著山函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日述怀","author":"华岳","text":"寒入肌肤粟已生，银河冻合水无声。\n梅花漏泄春先到，风色商量雪未成。\n有愧何须问天理，无求方始合人情。\n男儿未际风云会，辜负胸中十万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发书与幼弟及坦斋","author":"华岳","text":"风烟世事不堪听，勿谓封侯胜白丁。\n老眼隔年新旧历，归心连夜短长亭。\n一声蜀鸟惊胡蝶，十幅蛮花寄鹡鸰。\n更向坦斋夫子道，近来双鬓已星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"囚中记贫","author":"华岳","text":"英雄不遇不忧贫，狱吏从教唤不应。\n煮饭只烧沽酒罐，读书权借守囚灯。\n堪嗟世事危如卵，无怪人情冷似冰。\n勿谓功名成倖致，志公终不是閒僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归兴呈吴梦祥","author":"华岳","text":"鱼雁音书少，关山梦寐遥。\n对花思粉面，遇□□□□。\n喜意鹊应报，归心马更骄。\n西风绰鞭?，飞□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"训小童","author":"华岳","text":"饭罢令人唤小童，敢烦捉耳为开蒙。\n芎茶不用焦汤点，纸被还将艳火烘。\n醉欲伴眠当倩月，热求挥汗合邀风。\n它时我建青油幕，廉汝封侯学卫公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"训爨婢","author":"华岳","text":"十载胶庠莫怪穷，旅囊安得有从容。\n无钱休欠牛羊债，有酒只将鱼蟹供。\n班颔昔尝肥似燕，沈腰今已瘦如蜂。\n从今莫恣肥甘口，只撷清蔬祭豢龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买舟浦城","author":"华岳","text":"畏路逢危路，寻舟得小舟。\n始云为得计，终乃复添忧。\n舱狭难伸足，篷低怎举头。\n十围无处著，局促向中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春","author":"华岳","text":"初入京华菊荐香，途中今已过春芳。\n十年恰走万馀里，两鬓几乎一半霜。\n却酒不禁春黯淡，落花愁对月昏黄。\n不堪夜半归心切，更被杜鹃啼断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再继前韵","author":"华岳","text":"俗尘方倥偬，得得访清幽。\n烟练素疑抹，山屏翠欲流。\n松筠扫日月，藤蔓悬春秋。\n物外有馀乐，吾生空白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再祷梅山","author":"华岳","text":"梅山昔扣五通仙，曾许英雄第一签。\n恰遇尘埃当扰扰，如何泥泞尚淹淹。\n若非推入高宗梦，须是遥分太史占。\n他日崧高咏申甫，一香先为大王拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安分呈李竹斋","author":"华岳","text":"风雨思君子，烟霞忆旧游。\n一区山水国，万里帝王州。\n腊瓮香浮玉，春旗雪满瓯。\n安贫随处乐，此外复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"当涂道中","author":"华岳","text":"春晴不慷慨，十日九清阴。\n蝶宿花留粉，莺眠柳借金。\n边尘方障眼，汉壁尚关心。\n醒去愁无奈，杯行满满斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏呈赵可父","author":"华岳","text":"少年场屋擅词锋，审谳无私只奉公。\n夜月兰宫无宿曜，秋霜莲幕有春风。\n明堂难毁周公制，乡校犹存子产功。\n文德自来能服远，更烦刘向为和戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行述怀","author":"华岳","text":"归心夜半已飞扬，唤仆吹灯促晓妆。\n鸡翅拍斜茅店月，马蹄剜破板桥霜。\n二陵万里埋荆棘，十庙百年生稻粱。\n安得有臣如祖逖，慨然击楫誓江长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春即事","author":"华岳","text":"杨柳丝丝弄淡黄，怯寒燕子未归梁。\n晓迷芳草骓騣湿，夜宿閒花蝶翅香。\n得句自惭非子美，赏音犹恐误中郎。\n愿言相约花前醉，莫放春容过海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"华岳","text":"十年忧患客江城，双鬓萧萧已不禁。\n多病不逢医国手，感怀徒有济时心。\n西风吹梦夜寒悄，黄叶满阶秋意深。\n休笑当年杜陵老，白头今亦不胜簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有触述怀","author":"华岳","text":"英雄还要识英雄，不识英雄总是空。\n投鼠在人当忌器，见鸿非我独弯弓。\n情从忠佞分轻重，事戒恩威戾始终。\n说与翠微休截截，三缄从此更须工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]