[{"title":"次韵 其二","author":"张孝祥","text":"饥肠得酒作雷鸣，痛饮狂歌不自程。\n坐上波澜生健笔，归来钟鼓动严城。\n不应此地淹鸿业，盍与吾君致太平。\n伏枥壮心犹未已，须君为我请长缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张司户还蜀","author":"张孝祥","text":"似向川人有夙缘，交游存殁最多贤。\n今年初识张公子，六月还寻上水船。\n万里亲庭心已到，一杯别酒意空传。\n西行剩有新诗句，寄我应书十样笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和仲弥性烟霏佳句兼简贰车 其一","author":"张孝祥","text":"收敛经纶寄一麾，戏分风月与烟霏。\n醉馀綵笔三千首，老去苍官四十围。\n露菊漙秋催落帽，蜡花摧夜照更衣。\n登临纵好难留滞，白发双亲待汝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和仲弥性烟霏佳句兼简贰车 其二","author":"张孝祥","text":"引手星辰逼太微，荡胸云物散空霏。\n莫山好处青成案，秋月明时雪打围。\n竹洗佳人千点泪，荷翻仙子六铢衣。\n西岩定有渔翁宿，障雨拦风不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庾楼和林黄中韵","author":"张孝祥","text":"九月扁舟下水风，一尊佳处与君同。\n眼高四海氛尘外，诗在千山紫翠中。\n倾坐只惊谈麈白，踏筵不怕舞衫红。\n楼头今古无穷事，醉倚胡床月满空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高远亭和林黄中韵","author":"张孝祥","text":"檐桷飞翔入太空，下窥庐岳最高峰。\n亭如岘首应遗爱，诗比西湖欲亢宗。\n天上唤君从此近，酒边著我几时重。\n凭阑欲去仍回首，谁与佳名自点胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与同僚十五人谢晴东明得渊字","author":"张孝祥","text":"灵光便满恒沙界，大士重来七十年。\n秋入郊原成乐岁，风随箫鼓散香烟。\n定知蛮獠安三窟，更遣蛟龙閟九渊。\n太守忧民但逃责，所忻毕至有群贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"释奠","author":"张孝祥","text":"又领诸儒款泮宫，车书同处礼应同。\n柏庭老影留江月，竹屋寒声作社风。\n坐客语残香一穗，候人催起鼓三通。\n归来税冕仍分肉，更觉休官兴未穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风雨石首呈同行寄荆州僚旧","author":"张孝祥","text":"昨日离筵酒未醒，今朝风雨暗江亭。\n近人积水春全绿，隔岸荒山夜却青。\n野吏衣冠行木偶，客船灯火散疏星。\n宽程且作三旬约，要看庐山紫翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行再用前韵","author":"张孝祥","text":"泽畔行吟我独醒，归程不计短长亭。\n西风送浪头头白，芳草随人段段青。\n昨夜疏篷犹窘雨，今朝严鼓欲侵星。\n无人去唤华容宰，画我江行作小屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄子馀","author":"张孝祥","text":"缩肩得句极酸寒，何似黄郎咳唾间。\n少日曾经诸老学，传家自有祖师关。\n词林根柢今谁在，振古风流要力还。\n我老故应无用此，因君犹欲更晞颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"去临川书西津渔家","author":"张孝祥","text":"作客临川又一年，却寻归路浅滩船。\n宦游到处真聊尔，别恨何须更黯然。\n夹道长红惭父老，绕城浓碧记山川。\n无端此地成留滞，定自从渠有宿缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将至池阳呈鲁使君","author":"张孝祥","text":"珍重池阳鲁使君，忘年交契独情亲。\n江山佳处公开府，风雨来时我问津。\n翠逼笋舆松径合，绿随秧马稻畦新。\n东归剩作登临好，病怯诗肠故恼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元设醮毕作长句","author":"张孝祥","text":"绿简朱书自叩真，复炉香雾晚絪缊。\n雪花便作茶花白，春色还随月色新。\n江涨不忧堤万丈，年丰何啻粟千囷。\n微生只拟休官去，拜胙归来吉梦频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐安郡夫人挽章","author":"张孝祥","text":"储祥吴越王家子，媲德蓬莱阁上仙。\n汤沐几年开大国，笄珈长夜掩穷泉。\n鸾台晓月悲尘镜，凤轸春风泣断弦。\n木落荄枯何限恨，藁砧应赋悼亡篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺郊祀","author":"张孝祥","text":"汉统千龄接，虞衡七政齐。\n德馨天自飨，容祲古犹稽。\n舆卫钩陈北，衣冠观阙西。\n雨先清道跸，寒避礼神圭。\n方士朝仙仗，宫垣挟御堤。\n庙芝楹叠璧，帝乐字连奎。\n虚次尤祗慄，怀亲极惨悽。\n珠旒依玉色，兰炬映璇题。\n两相初扶翼，崇坛六降隮。\n高灵森欲堕，诸福应如携。\n燎夜坛三烛，凌霜甲万犀。\n宗藩申宝酌，秘检护金泥。\n奉引星辰烂，旋归锦绣迷。\n端门临五凤，步辇驻双霓。\n日照云裳委，风含綵筤低。\n和声翔四表，嘉泽浸群黎。\n盛事真寥廓，微生荷奖提。\n侍祠叨执爵，著籍缪通闺。\n异宠何由报，孤忠誓不睽。\n裁诗独惭晚，犹得并凫鹥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送颜廷藻归三衢","author":"张孝祥","text":"岁事今如此，公归意若何。\n倚门亲望切，传舍客愁多。\n美谶当圆石，仙游看烂柯。\n一科须俯拾，五字要长哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郭遐龄","author":"张孝祥","text":"去从公府辟，不为故人留。\n国士真如此，台家合见收。\n声名早多误，功业晚方优。\n不必毛锥子，相期定远侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次家君韵 其一","author":"张孝祥","text":"柏禅工立雪，松寿不凋寒。\n笔底波澜壮，胸中宇宙宽。\n登车慵揽辔，投檄愿休官。\n四海英名满，悬知袖手难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次家君韵 其二","author":"张孝祥","text":"忆昔金门直，通班玉殿寒。\n风云黄道近，日月太虚宽。\n法锦罗千仗，宫花覆百官。\n江湖岁将晚，未觉报君难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题玄英先生庙","author":"张孝祥","text":"木老参天直，江清白日闲。\n先生元不死，遗庙亦空山。\n文采云仍似，风流正始间。\n平生子严子，高处得追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谨和老人贻具圆复之什","author":"张孝祥","text":"儒名参墨行，诗律傲宗风。\n老去能从我，生来未识公。\n据梧心已死，行李岁将穷。\n应见维摩诘，天花结习空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王景文 其一","author":"张孝祥","text":"陆行忌豺虎，水去怯风波。\n世路险犹尔，客中愁更多。\n吾生真漫与，天道合如何。\n千古兴亡意，临风一放歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王景文 其二","author":"张孝祥","text":"斯文到之子，砥柱阅颓波。\n致主规模别，伤时疾疢多。\n大臣谗贾谊，逆旅欠常何。\n无路排阊阖，聊当扣角歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王景文 其三","author":"张孝祥","text":"王师行六月，淮海静无波。\n元老前筹密，诸军捷奏多。\n西风向萧瑟，北顾要谁何。\n闻说收兵后，讴吟杂雅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韩中父 其一","author":"张孝祥","text":"天入南郊白，云连朔野昏。\n弼臣开盛府，殇虏哭新魂。\n闻道通轺传，何当拜寝园。\n荒寒岁将晚，愁绝更堪言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韩中父 其二","author":"张孝祥","text":"东邻子韩子，忧国忘晨昏。\n也作漳滨卧，谁招楚些魂。\n旧勋留幕府，新渥到丘园。\n家法传来久，迟君一尽言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东坝","author":"张孝祥","text":"固城朝送客，东坝晚留侬。\n浙近风烟好，春回港汊通。\n北来愁乱辙，南去喜疏篷。\n不是趋朝市，松江学钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过建德","author":"张孝祥","text":"古县依山住，肩舆带雨来。\n闾阎无地著，岩壑有天开。\n野驿编青竹，公庭砌碧苔。\n传闻长官好，小泊亦佳哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟龄侍御以番阳士子之意作五峰亭且赋诗某敬和","author":"张孝祥","text":"庐山真满眼，秀句忆东坡。\n但遣佳名易，悬知得士多。\n云霄身已近，星象手能摩。\n太守文章伯，风行水自波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过岳麓见子云题字偶逢来使因寄二诗 其一","author":"张孝祥","text":"籍甚韩公子，情亲我弟兄。\n星沙逢驿使，岳麓见题名。\n共作三年别，相望五日程。\n湘江接淮水，寄与濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过岳麓见子云题字偶逢来使因寄二诗 其二","author":"张孝祥","text":"故人应问我，客里定何如。\n马铺为行馆，鸡栖是使车。\n四郊多贼垒，五筦欠兵储。\n此去无来雁，因人数寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘子思","author":"张孝祥","text":"送客古城东，阴晴一日中。\n旧怜杉桱碧，新喜荔枝红。\n香火丛祠冷，鱼虾小市空。\n明朝万里别，今夕此尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜与蔡济忠曹公会汎舟自水东归","author":"张孝祥","text":"一舸驾长风，银河此路通。\n波光连月白，烛影到江红。\n五岭经星外，千山飓雾中。\n不知今夜赏，更有几人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹿鸣燕","author":"张孝祥","text":"明庭下温诏，方岳贡群贤。\n巢凤山中客，栖鸾地上仙。\n鱼龙回夜水，雕鹗在秋天。\n添种家乡桂，归途快著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"訾洲即事","author":"张孝祥","text":"一雨便清凉，风回百草香。\n云山米家画，水竹辋川庄。\n僧赋蠲新帖，墙榛斩旧行。\n归鞍乘晚霁，空翠满轻装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罢归","author":"张孝祥","text":"亲老难为住，恩深许放归。\n北行湘水阔，南望瘴烟微。\n兵卫收门戟，征尘上客衣。\n遥知六七月，喜气满庭闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罢归呈同官 其一","author":"张孝祥","text":"去年秋七月，我犯瘴烟来。\n赋少畬田熟，徭归驿路开。\n上恩均雨露，孤迹返蒿莱。\n想像山中趣，参差屐齿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罢归呈同官 其二","author":"张孝祥","text":"岭水常时急，蛮山是处高。\n户输无翠羽，溪瘴有黄茅。\n游子归乡国，斯人滞冗曹。\n临分那忍别，风里鬓萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠江清卿","author":"张孝祥","text":"岭海适相逢，经年飓雾中。\n官闲诗格进，禄薄俸囊空。\n子昔南征鹤，吾今北去鸿。\n江湖渺何许，听唳九霄风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过灵川寄张仲钦兼赠王令尹","author":"张孝祥","text":"尘沙行半日，烟火是灵川。\n县只三家市，渠通十斛船。\n官空无见俸，税重有荒田。\n太息王郎子，栖迟欲四年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"滑石","author":"张孝祥","text":"重来滑石铺，为爱碧泉鸣。\n古甃苔花涩，虚檐桂月明。\n乔林通夜气，密竹动秋声。\n客里清凉地，悠然一振缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兴安","author":"张孝祥","text":"提封连岭海，风土似江吴。\n仙去山藏乳，商归斗算珠。\n劭农多乐岁，厉俗有通儒。\n已过炎关了，吾行且缓驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"炎关","author":"张孝祥","text":"驱马度炎关，身经瘴野还。\n稍馀衣带水，已尽剑铓山。\n海月随人远，湘云似我闲。\n不须占紫气，游戏且人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒸霞谷为曹公会赋","author":"张孝祥","text":"见说蒸霞谷，连山只种桃。\n补成天五色，散作佛千毫。\n月底群仙下，风前细仗高。\n期君成美实，归献赤霜袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登瀛桥为曹公会赋","author":"张孝祥","text":"从此上瀛洲，虹蜺晚未收。\n济川谁作楫，浮海不乘桴。\n弱水三万里，五城十二楼。\n读书群玉府，风袂揖丹丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙戌七月望日自南台游福严书留山中","author":"张孝祥","text":"乞我一枝筇，经行又别峰。\n水流仙界叶，风落化城钟。\n锡去泉无恙，车行石有踪。\n却怜磨衲老，曾见两儒宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和万老","author":"张孝祥","text":"归途正辽邈，此地更淹留。\n落木千山夜，空江万里秋。\n聊为无事饮，莫赋畔牢愁。\n明发催船鼓，风帆过橘洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和","author":"张孝祥","text":"吾行聊复尔，处处贾胡留。\n天入星沙晚，风连梦泽秋。\n未容诗作祟，政要酒浇愁。\n明月无人伴，携君鹦鹉洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三塔寺阻雨 其一","author":"张孝祥","text":"塔上一铃语，湖头三日风。\n苍山在烟外，高浪与天通。\n市迥薪刍少，僧残像教空。\n不妨留滞好，且看夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三塔寺阻雨 其二","author":"张孝祥","text":"倦客三杯酒，高僧一味茶。\n凉风撼杨柳，晴日丽荷花。\n铎语时鸣塔，渔歌晚钓槎。\n停舻快清憩，步稳衬明霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过湘中得诗僧万致一于书无所不读非苟得诗名于僧中者余欲与俱还吴中而万家浯溪将结草庵其上送余至湘阴复归作四十字以别","author":"张孝祥","text":"别去太匆匆，回船梦泽东。\n拟寻行脚路，忽遇打头风。\n梵网威仪在，天花结习空。\n它年三百首，吾为子流通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钦夫子明定叟夜话舟中钦夫说论语数解天地之心圣人之心尽在是矣明日赋诗以别","author":"张孝祥","text":"江北我归去，湘西君卜居。\n谁知对床语，胜读十年书。\n不饮清无寐，来朋乐有馀。\n明朝千里别，密处几曾疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张立之赴临江判官","author":"张孝祥","text":"珍重清江掾，相从五见秋。\n炎凉无改节，夷险有忠谋。\n莲幕开新府，蒲帆漾小舟。\n凄然洞庭野，别意与川流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄陵庙","author":"张孝祥","text":"百世黄陵庙，凄凉屋数间。\n只怜斑楚竹，那记赭湘山。\n访古韩碑在，徵歌屈些闲。\n虞嫔更尧女，莫入水仙班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"磊石","author":"张孝祥","text":"鼓发营田市，帆收磊石山。\n冰纨六十里，烟髻两三鬟。\n天气水云合，人家罾网间。\n晚来风更熟，别浦棹歌还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄州","author":"张孝祥","text":"平生闻赤壁，今日到黄州。\n古戍参差月，空江浩荡秋。\n艰难念时事，留滞岂身谋。\n索索悲风里，沧浪亦白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东坡","author":"张孝祥","text":"系船著西日，曳杖过东坡。\n暗井蛙成部，荒祠鸟作窠。\n老仙骑鹤去，稚子饭牛歌。\n兴废何须问，斯文自不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过蕲口六奉寺丞仲文亲帖之贶今早本约来陈店复勤千骑至冶塘所以招迎之意甚厚感叹不已赋此为谢","author":"张孝祥","text":"故人经岁别，连日几封书。\n不识江头路，仍迂长者车。\n追参空幕府，牵挽到宾除。\n太息交情薄，多公不我疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临发再和","author":"张孝祥","text":"水落鱼成塞，风高雁欲书。\n公为东道主，我滞北辕车。\n边障无传警，朝廷有拜除。\n江干便迎候，此别未云疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仲子弟用同之韵","author":"张孝祥","text":"凄然鸿雁影，晚岁索衣裘。\n惜别湘江夜，归程楚甸秋。\n极知违定省，不敢更淹留。\n明月分携处，无言只是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送谢梦得归昭武","author":"张孝祥","text":"莫吟青玉案，恐弊黑貂裘。\n国步艰难日，人间浩荡秋。\n不须鸟工往，且作贾胡留。\n后夜回春阁，凄然一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钦夫喜雨","author":"张孝祥","text":"佛刹起香云，高低一雨均。\n使君心未已，阁老句还新。\n喜入村乡乐，凉生瓮盎春。\n莫嫌知稼穑，我是种田人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗送荆州进士入都","author":"张孝祥","text":"人才收楚产，宾荐谨周官。\n就日三吴近，披风七泽宽。\n解包珍贡入，瑑玉宝光寒。\n簇仗春旗里，看君策治安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"城西晚步呈王亮采","author":"张孝祥","text":"城西行半日，佳客偶相随。\n古寺寻修竹，荒园读断碑。\n三杯午时酒，一簇晚沙旗。\n春色从今好，重来未可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"压云亭","author":"张孝祥","text":"登临多好处，第一压云亭。\n水作高低白，山分远近青。\n人家半烟树，客柁满春汀。\n剩欲留连晚，归时更摘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]