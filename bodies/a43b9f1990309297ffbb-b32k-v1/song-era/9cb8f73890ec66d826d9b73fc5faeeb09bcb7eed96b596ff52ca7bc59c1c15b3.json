[{"title":"烛影摇红","author":"翁元龙","text":"蜀锦华堂，宝筝频送花前酒。\n妖娆全在半开时，人试单衣后。\n花面围春竞秀。\n如红潮、玉腮微透。\n欲苏还坠，浅醉扶头，朦胧晴昼。\n金屋名姝，眼情空伫闲眉岫。\n世间还有此娉婷，拼尽珠量斗。\n真艳可令消受。\n倩莺催、天香共袖。\n冷烟庭院，淡月梨花，空教春瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"翁元龙","text":"玉纤闲捻花间集。\n赤阑干对芭蕉立。\n薤叶晚生凉。\n竹阴移小床。\n拗莲牵藕线。\n藕断丝难断。\n弹水没鸳鸯。\n教寻波底香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"翁元龙","text":"春心莫共花争发。\n花开不管连环缺。\n梦断小楼空。\n杜鹃啼晓红。\n眼看连理树。\n纤手移筝柱。\n调遍错成声。\n无人知此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"翁元龙","text":"莺树暖。\n弱絮欲成芳茧。\n流水惜花流不远。\n小桥红欲满。\n原上草迷离苑。\n金勒晚风嘶断。\n等得日长春又短。\n愁深山翠浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 赋茉莉","author":"翁元龙","text":"花情偏与夜相投。\n心事鬓边羞。\n薰醒半床凉梦，能消几个开头。\n风轮慢卷，冰壶低架，香雾飕飕。\n更著月华相恼，木犀淡了中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隔浦莲近/隔浦莲近拍","author":"翁元龙","text":"街檐插缀翠柳。\n憔悴清明后。\n泪蜡堆香径，一夜海棠中酒。\n枝上酸似豆。\n莺声骤。\n恨软弹筝手。\n揾眉袖。\n嘶骢过尽平芜，绿衬飞绣。\n沈红入水，渐做小莲离藕。\n亭冷沈香梦似旧。\n花瘦。\n欲留春住时候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞龙吟","author":"翁元龙","text":"清明近。\n还是递趱东风，做成花讯。\n芳时一刻千金，半晴半雨、酬春未准。\n雁归尽。\n离字向人欲写，暗云难认。\n西园猛忆逢迎，翠纨障面，花间笑隐。\n曲径池莲平砌，绛裙曾与，濯香湔粉。\n无奈燕幕莺帘，轻负娇俊。\n青榆巷陌，蹋马红成寸。\n十年梦、秋千吊影，袜罗尘褪。\n事往凭谁问。\n昼长病酒添新恨。\n烟冷斜阳紧。\n山黛远、曲曲阑干凭损。\n柳丝万尺，不如轻鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉桃源 柳","author":"翁元龙","text":"千丝风雨万丝晴。\n年年长短亭。\n暗黄看到绿成阴。\n春由他送迎。\n莺思重，燕愁轻。\n如人离别情。\n绕湖烟冷罩波明。\n画船移玉笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽蔡西山先生","author":"翁升","text":"伤哉道学不容时，力抵先生蹈至危。\n槐棘佥谋虽日伪，草茅公论实难欺。\n苍梧千里地虽远，白首一心天自知。\n借问西山近何似，白云长护紫阳碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双溪驿","author":"翁世修","text":"明月不随双派去，白云长为数峰留。\n夜窗星火归渔艇，晓槛晴岚映市桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨微山","author":"翁仲德","text":"大川东逝近丛林，石壁潮音杂梵音。\n旱望湫龙嘘涧气，沛然甘雨慰农心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸣鹤山","author":"翁仲德","text":"沧海东头鹤阜高，仙人骑鹤下林坳。\n一声唳起扬州去，华表空馀月下巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜飞山","author":"翁仲德","text":"江南雨霁彩云开，眼界空宽翠色排。\n蜀客踌躇还识认，子规啼月夜归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙爪石","author":"翁华","text":"香开岩桂露凄清，翠锁晴岚泼眼明。\n风度南枝乌鹊啭，月斜西坞玉绳横。\n来游十里水云窟，偿我一生丘壑情。\n诗句乞君高挂壁，且容鼻息撼雷鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿参政","author":"翁合","text":"凤凰巢定万年枝，陶铸苍生尽未迟。\n六丈语言同辈服，二郎官职乃翁知。\n味回春茗甘方永，春到寒花淡更奇。\n十有三人共千岁，向羊终社更追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常庵","author":"翁合","text":"我是曾孙孙又孙，今朝始谒武夷君。\n三英秀峙千岩合，九曲平穿两岸分。\n丹壑何年流绛水，幔亭整日锁红云。\n一生湖海江三白，早向溪头累石坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方丈","author":"翁合","text":"武夷奇绝处，水碧更山丹。\n观辟南唐址，祠仍西汉坛。\n山禽酣午梦，野菜健晨餐。\n道士江冲一，新诗有集刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺参政生日古风","author":"翁合","text":"国朝启运星聚奎，太极夫子生濂溪。\n圣远言湮开众迷，接引伊洛为航梯。\n乾精坤粹星端倪，纸上陈迹俱筌蹄。\n南来道统坠涂泥，我考亭翁重挈提。\n及肩诸子户牖低，有山突兀宫墙西。\n道则高矣身颠挤，嘉禾瑞草来庭闱。\n种之美也无稗荑，公尤硗硗头峙犀。\n笔下绝去翰墨畦，删后既醉涂凫鹥。\n三十年前塔上题，只今待漏听朝鸡。\n排海摧嵩鳞屡批，肯美宫室奉妾妻。\n广厦峨冠讲若稽，我欲托国谁放麑。\n知公可仗为筑堤，保我子孙安烝黎。\n谁贤稚老空自赍，有德与位至公齐。\n言如车行得軏輗，尼山上有孤凤栖。\n惟伋传道如取携，鲤与白也难之隮。\n西山家学有根柢，眼中三世琮璋圭。\n言行一一无诃诋，此福如海难测蠡。\n番番黄发齿且儿，倘可撰杖桃李蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 赠陈五星","author":"翁合","text":"口诵百中经，手运周天数。\n试问薇垣一小星，谁知是、韩王普。\n知得客星来，知得贤人聚。\n我若乘槎犯斗牛，莫向常人语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 寿蔡参政","author":"翁合","text":"世事今如许。\n祗先生、寿身寿国，尚堪撑拄。\n一脉宽仁忠厚意，留到如今可数。\n问谁是、擎天一柱。\n名节难全官职易，这娥眉、肯效争妍妒。\n几而作，色斯举。\n沧州万顷舟横渡。\n对和风、桃花流水，一蓑烟雨。\n亲得紫阳传正印，且作斯文宗主。\n世望皋夔伊傅。\n天意须酬平治愿，抚参同、一卷长生谱。\n平治了，仙为侣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄亭铺","author":"翁汝正","text":"落日荒荒下远芜，市桥官柳绿扶疏。\n沙头一霎腥风起，沽酒老翁来卖鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿鸣宴赠歌妓","author":"翁迈","text":"年方十三四，娇羞懒举头。\n舞馀驹皎皎，歌罢鹿呦呦。\n近座香先喷，持杯玉更柔。\n高唐人去远，谁与话风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"翁宏","text":"万木本秋里，孤膛半夜猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"翁甫","text":"秋风两度身为客，已见重阳未到家。\n村酒不堪供节事，祗将青眼看黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠孙花翁","author":"翁甫","text":"我生头发未燥时，花间已歌花翁诗。\n我发既长今渐白，犹见花翁好颜色。\n举酒祝翁寿百年，我为诗孙戏翁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使华亭","author":"翁纬","text":"走清奔碧日潺湲，势与晴江远接连。\n沙草碧侵驱马路，岸花红湿钓鱼船。\n烟生远店收寒雨，风起高梧咽暮蝉。\n徐氏旧居人识否，渡南溪下白云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居即景","author":"范成大","text":"绿遍山原白满川，子规声里雨如烟。\n乡村四月闲人少，才了蚕桑又插田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山雨","author":"翁卷","text":"一夜满林星月白，且无云气亦无雷。\n平明忽见溪流急，知是他山落雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东阳路傍蚕妇","author":"翁卷","text":"两鬓樵风一面尘，采桑桑上露沾身。\n相逢却道空辛苦，抽得丝来还别人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖行","author":"翁卷","text":"湖水添时宿雨晴，野禽无处不春声。\n万株杨柳青如昨，全是东风染得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冯公岭","author":"翁卷","text":"乱峰千叠拂云霓，辐合坑崖立似梯。\n曾向括州州里望，众山却是此山低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻僧","author":"翁卷","text":"秋净日晖晖，间行风满衣。\n寻僧虽不遇，折得菊花归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西风","author":"翁卷","text":"一处西风一处愁，又逢鸣雁在沧洲。\n芙蓉不分秋萧索，斗拆繁红满树头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观落花","author":"翁卷","text":"才看艳蕾破春晴，又见飞花点点轻。\n纵是闲花自开落，东风毕竟亦无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还家夜同赵端行分韵赋","author":"翁卷","text":"莫怪繁霜满鬓侵，半年长路几关心。\n还家点检家中物，依旧清风在竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍外早梅","author":"翁卷","text":"行遍江村未有梅，一花忽向暖枝开。\n黄蜂何处知消息，便解寻香隔舍来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春登南昌城","author":"翁卷","text":"独立高城四望低，望中无物不堪题。\n欲知春事几深浅，芳草青青犹未齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"翁卷","text":"不管秋天阴复晴，秋怀何处不凄清。\n江城几夜无佳月，亦有新诗对雨成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄山人徐灵晖","author":"翁卷","text":"只隔烟霞数里间，本期还往共幽闲。\n宁知逸羽飞相背，我入山来君出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张季思","author":"翁卷","text":"荆吴中隔万山遥，那得相逢话寂寥。\n长忆梅花好时节，访君船泊古枫桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼旧呈赵紫芝","author":"翁卷","text":"忆向城南共说诗，山民与我定相随。\n如今独来还独往，此恨除君人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野望","author":"翁卷","text":"一天秋色冷晴湾，无数峰峦远近间。\n闲上山来看野水，忽于水底见青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁池作","author":"翁卷","text":"包家门外柳垂垂，摇荡春风满雁池。\n为是城中最佳处，每经过此立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东池","author":"翁卷","text":"一池寒水绿粼粼，池上初梅白未匀。\n谁念酒旗飞动处，唐朝曾住作诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"翁卷","text":"山中凡事幸相宜，第一红尘免上衣。\n寻药每同丹客去，拾薪多趁牧儿归。\n鸣泉漱石寒蒲洁，宿雾蒸泥早蕨肥。\n不奈邻峰学禅伴，时时来此叩岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋步月","author":"翁卷","text":"幽兴苦相引，水边行复行。\n不知今夜月，曾动几人情。\n光逼流萤断，寒侵宿鸟惊。\n欲归犹未忍，清露滴三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书隐者所居","author":"翁卷","text":"百事已无机，空林不掩扉。\n蜂沾朝露出，鹤带晚云归。\n石老苔为貌，松寒薜作衣。\n山翁与渔父，相过转依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"友人林居","author":"翁卷","text":"花石与林庐，皆非俗者居。\n铺沙为径软，因竹夹篱疏。\n留客同家食，教儿诵古书。\n常言治生意，只欲似樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平山读书奉寄城间诸友","author":"翁卷","text":"寥寥钟磬音，永日在空林。\n多见僧家事，深便静者心。\n虚亭云片泊，侧径石根侵。\n此去城间远，君应懒出寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日过道上人旧房","author":"翁卷","text":"已知超众相，假质任成灰。\n房是他僧住，门无旧客来。\n冰乾半池水，花落一根梅。\n犹是疑行脚，何年见却回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日登富览亭","author":"翁卷","text":"未委海潮水，往来何不閒。\n轻烟分近郭，积雪盖遥山。\n渔舸汀鸿外，僧廊岛树间。\n晚寒难独立，吟竟小诗还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"处州苍岭","author":"翁卷","text":"步步蹑飞云，初疑梦里身。\n村鸡数声远，山舍几家邻。\n不雨溪长急，非春树亦新。\n自从开此岭，便有客行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉隆宫周道士自足轩","author":"翁卷","text":"贪得无厌者，应难共此居。\n炉中姹女药，案上老君书。\n花竹庭阶洁，风烟户牖虚。\n道人随分外，安坐不求馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈郎中柄知严州","author":"翁卷","text":"频年经虎害，人望使君来。\n地重分旄节，州清管钓台。\n凉天星象动，吉日印符开。\n帝擢平津策，曾知有用才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同赵灵芝杜子野游豫章总持寺","author":"翁卷","text":"满寺是秋风，吹开黄菊丛。\n重林无日到，此地若山中。\n罢磬孤僧出，看碑两客同。\n相传化龙事，神怪理难通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同徐道晖赵紫芝泛湖","author":"翁卷","text":"相见即相亲，吟坛得几人。\n扁舟当是日，胜赏共閒身。\n山雨曾添碧，湖风不动尘。\n晚来渔唱起，处处藕花新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次徐灵渊韵赠赵灵秀","author":"翁卷","text":"一轴黄庭看不厌，诗囊茶器每随身。\n三年在任同仙隐，一日还家只旧贫。\n种得溪蒲生似发，教成野鹤舞如人。\n出门便是登山路，更要遥山翠色匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵葛天民","author":"翁卷","text":"接得诗来胜接书，忆君情思豁然舒。\n却看城里谁家竹，又锁湖边旧住庐。\n曾有退之怜贾岛，岂无得意荐相如。\n欲知别后予踪迹，只向此江閒钓鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行寄赵端行","author":"翁卷","text":"离亭一分手，便送钓船行。\n虽是暂相别，那能忘此情。\n花飞春已老，云散晚方晴。\n诗句空吟得，无人可共评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行药作","author":"翁卷","text":"病倦令人懒欲吟，偶因行药过墙阴。\n烟生园柳暮鸦集，水涸池塘秋草侵。\n有口不须谈世事，无机惟合卧山林。\n西风飒飒吹毛骨，且看满园花似金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过太湖","author":"翁卷","text":"水跨三州地，苏州水最多。\n昔年僧为说，今日自经过。\n亡国岂无恨，渔人休更歌。\n洞庭山一抹，翠霭白云和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初晴道中","author":"翁卷","text":"初晴残湿在，众树碧光鲜。\n幽鹭窥泉立，闲童跨犊眠。\n依山知有寺，过水恨无船。\n石路是谁作，姓名岩上镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"翁卷","text":"省饮不成醉，牢愁将奈何。\n晚烟云半杂，春雪雨相和。\n巷湿人行少，空寒雁叫多。\n凭栏思无极，怀古谩悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事言怀","author":"翁卷","text":"赋得拙疏性，合令纵迹赊。\n相亲惟野客，所论是诗家。\n听雨眠僧屋，看云立钓槎。\n秋来有新句，多半为黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿周益公 其三","author":"李商叟","text":"袖中勋业拂云烟，笔底文章响涧泉。\n已是贵为天下宰，不妨长作地行仙。\n蚁浮玉友秋初熟，鹊报银河月正圆。\n满引寿觞今夜看，相星重入太微垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿昌道中","author":"翁卷","text":"清游从此起，过处必须看。\n背日山梅瘦，随潮海鸭寒。\n平途迷望阔，峻岭疾行难。\n听得居人语，今年冬又残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈西老母氏挽词","author":"翁卷","text":"八十馀年寿，孀居备苦辛。\n成家无别物，有子作诗人。\n远客移书吊，新坟得佛邻。\n秋堂挂遗像，癯若在时身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口即事","author":"翁卷","text":"长流当下流，铁瓮此为州。\n前代多名迹，闲人欲遍游。\n夕阳波上寺，明月戍边楼。\n一曲渔家笛，生予无限愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周氏东山草堂","author":"翁卷","text":"城隅古谢村，博士草堂存。\n唯见烟霞起，全无市井喧。\n鹊来巢木末，鼋出戏蒲根。\n消得吟诗客，凭栏看几番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]