[{"title":"九日青阳道中呈张主簿","author":"喻良能","text":"重阳时候在青阳，野店山肴对举觞。\n菊蕊半开簪鬓好，橘包初破噀人香。\n西风有意吹纱帽，细雨无情湿锦障。\n但得一樽相对饮，不须更问是他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日诸暨道中示兴之","author":"喻良能","text":"客里逢重九，萧萧落叶风。\n略无花对菊，但有鬓如蓬。\n蕉卷新收绿，枫旗半展红。\n登临语宗武，剩喜一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日偕成均同官北山登高二首","author":"喻良能","text":"轻霞朝日两微茫，沙路骎骎十里强。\n照水有情枫叶赤，倚崖无数菊花黄。\n兴酣争举凌云笔，醉熟重浮滟海觞。\n明日蝶愁人亦懒，未须归去苦匆忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月五日周少府卫秀才会饮吴波亭周有诗因次韵","author":"喻良能","text":"碧水初微落，黄花亦未簪。\n三人千里客，尊酒五年心。\n我独年齐白，君皆句似阴。\n不妨铛脚坐，聊作夜深吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二日大雪","author":"喻良能","text":"磬湖二月雪，寒气故裴回。\n面市连天合，银花照眼开。\n送穷穷不去，招隐隐难来。\n幸有曲生在，何妨略耻罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月五日夜梦何茂恭论诗","author":"喻良能","text":"不见水曹久，相思亦已勤。\n梦中不识路，樽酒细论文。\n家食甘春荠，官居采泮芹。\n何时真会面，风月与平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入局言怀","author":"喻良能","text":"学省清秋好，无尘意趣长。\n讲馀帘影静，坐久綵衣凉。\n未有裨王族，真成耗太仓。\n顾惭麋鹿质，亦许玷朝行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十三夜仲季二弟弄月亭对饮","author":"喻良能","text":"今宵端正月，故故向湖山。\n玉兔窥杯凸，冰娥怪鬓斑。\n诗情角里逸，酒胆夏黄悭。\n兴罢度桥处，天风松桂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十五日夜试院玩月呈叶判官徐教授蔡主簿","author":"喻良能","text":"西风细逐桂枝生，秋月圆从屋角明。\n欢伯向人端有意，素娥于客亦多情。\n试吟飞鹊南枝句，更听春蚕食叶声。\n从此涂山添胜事，四翁相遇四难并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十六夜月","author":"喻良能","text":"一更山吐月，万里湛虚明。\n聊当中秋色，堪欣此夜情。\n西风金盏侧，香雾玉簪横。\n却忆青莲语，寒鸦栖复惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十四日亦好亭迟月不至分韵得秋字","author":"喻良能","text":"亦好登临似庾楼，是中风月最宜秋。\n素娥欲赴经年约，行雨潜分一段愁。\n聊复飞觞追胜赏，何妨秉烛事清游。\n明年此夕看明月，千里相思楚水头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月二日与陆明府陈广文黄使君吴都曹江广文同饮于闳中堂修年契也酒后耳热因得小诗呈似","author":"喻良能","text":"菊色犹黄处，梅花未发天。\n三山千里客，一笑六同年。\n公等多朱绂，予方乏坐毡。\n清谈仍痛饮，应作画图传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月十日同幕府诸公游郡圃叶抚属得梅花一枝马抚属有诗因次韵","author":"喻良能","text":"横枝十月要清诗，南国今年尔许迟。\n梦绕故山千叠叠，眼看新萼一枝枝。\n欲知影瘦香微处，未称天寒日暮时。\n却忆玉溪当日树，浅霜深雪总相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十三日携家游裴园","author":"喻良能","text":"笋舆趁晓踏铜驼，休暇仍逢景色和。\n閒挈壶觞游翠霭，尽呼儿女看沧波。\n茫茫烟渚群鸥下，隐隐晴虹短棹过。\n最是小春奇绝处，梅花破萼未全多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十六日工部宿直","author":"喻良能","text":"邃宇近霄汉，微风摇竹梢。\n漏声通五夜，钟韵自三茅。\n衣裌偏宜睡，杯单讵用庖。\n夙兴那敢后，鸡唱已嘐嘐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十四再到永祐陵","author":"喻良能","text":"扁舟投晓出重城，春浪初肥绿满汀。\n竹里几声泥滑滑，河边十里草青青。\n人家艾叶惊飞燕，水面杨花点翠萍。\n渐近昭陵佳气集，五云松柏喜重经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月六日宴李家园亭","author":"喻良能","text":"林园过元巳，流水绕芳丛。\n略彴半寻影，酴醾一扇风。\n杯盘花气里，枕簟鸟声中。\n公子敬爱客，月明樽未空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月六日湖上分韵得山字","author":"喻良能","text":"剩涨三篙水，宽围十里山。\n垂杨飞舞里，细雨有无间。\n把酒从杯溢，题诗任鬓斑。\n青春仍暇日，莫惜晚西还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"之官括苍道出涵碧因题四韵以继宾客刘公之后尘云","author":"喻良能","text":"平生性僻耽山水，不愿加封万户侯。\n但得双鱼长到眼，未须万壑更争流。\n只今奇绝齐三洞，自昔流传遍九州。\n记得当年小盘礴，坐令炎赫变清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"之官桐川道中口占","author":"喻良能","text":"登道重逢驿，离家再及晨。\n云轻山色晓，寒浅鸟声春。\n碧涧梅花老，银杯竹叶新。\n前途风日好，持用悦慈亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山阴","author":"喻良能","text":"绿发经行处，重来两鬓丝。\n共谁论旧事，何处有新诗。\n鉴水春妍蚤，兰亭雪意迟。\n邦人争指似，寿母近期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己酉中秋","author":"喻良能","text":"磬湖秋半溢清波，一岁月明今夕多。\n剩办新诗娱老境，满倾太白醉冰娥。\n一天风露寒衣袂，举室儿童杂笑歌。\n不是钴潭奇绝处，未妨丁夜更娑婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广信道中","author":"喻良能","text":"昔日题诗处，重来续胜游。\n绿阴初入夏，苍鬓几经秋。\n细雨渡头市，孤烟汀际舟。\n溪山虽信美，翻恨不淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋示仲文弟","author":"喻良能","text":"古来佳节是中秋，今比重阳许燕游。\n已觉冰轮无限好，不须玉斧更重修。\n三飞惊鹊纷无定，一点閒云净不留。\n况有阿连同綵戏，何妨呼酒互相酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋终日雾雨予还自都下宿分水岭夜漏约七八刻月出乌饭草荐山之东徘徊窗牖间欣然把酒对之因赋长句","author":"喻良能","text":"乌饭山边白玉团，瑞光千丈溢清寒。\n斜穿逆旅茆茨室，正照先生苜蓿盘。\n聊向青天思太白，却吟飞鹊忆曹瞒。\n今宵不拟逢明月，更向尊前仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋爱山玩月","author":"喻良能","text":"年年秋半在长安，今夕园林且尽欢。\n一笑团栾人似月，十分潋滟酒生澜。\n遍簪丹桂香巾袂，尽吸清辉澡肺肝。\n饮罢月斜吟兴动，挥毫风露一天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乏酒","author":"刘敞","text":"摇落偏悲客，清寒易中人。\n寂寥那自守，淡泊亦殊真。\n浮俗仍皆醉，虚谈浪饮醇。\n高歌傲燕市，忽忆重千钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书大洞僧壁","author":"喻良能","text":"招提閟林麓，鱼鼓白云边。\n地僻疑无路，山深别有天。\n幽花充佛供，好鸟伴僧禅。\n何日征鞭暇，重来借榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书堂","author":"喻良能","text":"每忆书堂好，重来又十年。\n征途聊复尔，风物故依然。\n松竹千岩暮，云烟九月天。\n凭栏佳兴发，欲进剡溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予卧病数日意思殊昏昏中秋强起陪老人把酒对月不敢濡唇吻思去岁在当涂试院与诸公饮酒赋诗又一载矣因成长句","author":"喻良能","text":"楚水涂山各一涯，今年还是去年时。\n古来明月皆如此，我试停杯一问之。\n丹桂飘香知有子，飞乌绕树似无枝。\n直须看到冰轮昃，忍负姮娥隔岁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五舅处士惠访小园作诗为谢","author":"喻良能","text":"五舅多道气，相过茹杞苗。\n意行随绿径，情话竟清宵。\n送酒飞花急，撩人鸟语娇。\n不堪分手处，风雨晚潇潇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月二十二日夜省宿一首","author":"喻良能","text":"省庐频宿直，何异在承明。\n地峻江声近，风轻荷气清。\n鬓毛真骑省，诗思小阴铿。\n记得山村日，驰情向玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月晦日同楼少府由钱塘门至上竺遂游下中竺憩冷泉亭涂中记所历","author":"喻良能","text":"联舆缓步踏葱苍，十里荷香杂稻香。\n庚暑此时无一点，秋风明月洒长廊。\n林间岩洞侵衣润，水际亭台彻骨凉。\n何处山泉落檐溜，恍疑飞雨晓浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天申节望阙口号","author":"喻良能","text":"日永凉生殿阁风，需云宴衎庆流虹。\n明良叶德千龄遇，臣妾倾心万国同。\n葵影缓随羲驭转，榴花高映御袍红。\n西踰葱岭东辽海，长属尧封禹贡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廿五兄宣义见招偕诸弟赴新亭宴集即席有作","author":"喻良能","text":"潇洒新亭好，松长桂亦稠。\n清秋集鸿雁，暇日劝觥筹。\n既远含香直，何辞秉烛游。\n主人情义重，终宴不知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻交代将至喜而成篇","author":"喻良能","text":"三年泮水冷无毡，赢得萧萧雪满颠。\n晚景不妨供綵戏，他乡安敢废诗篇。\n剩将杯酒浇行色，速赁双童担近编。\n任是身归落雁后，乡心先抵磬湖边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文举仙尉以诗寄似兼惠新安纸乳洞茶次韵奉酬","author":"喻良能","text":"闭户莺声老，开缄鲤素新。\n多惭青眼旧，远寄白头人。\n佳楮冰天茧，芳荿雪洞春。\n著书兼破睡，勒谢敢辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月桂堂","author":"喻良能","text":"月桂堂何有，池清桂影横。\n画图宁办此，玉斧巧修成。\n入夜境逾妙，才秋风又生。\n饶阳岩石下，隐约欠分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月桥诗","author":"喻良能","text":"天迥月逾晶，地偏人亦静。\n箫然寻丈桥，寄此绿净境。\n洗盏荐寒光，掬泉弄清影。\n尘远耳目醒，令人发深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长至忆天衣旧游寄王状元","author":"喻良能","text":"去年连辔到朝阳，红日初添一线长。\n八俊偶同人已羡，四难俱得计真良。\n浇肠竹叶惊深碧，插鬓梅花咤浅黄。\n回首只今深似梦，云山烟水正相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东归见梅","author":"喻良能","text":"老大无堪鬓似银，虚名犹复玷簪绅。\n久为碌碌趋朝士，暂作栖栖去国人。\n行李冲寒归故里，江梅偷煖报新春。\n万钟于我何加益，三釜新来喜及亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩即事","author":"喻良能","text":"啸傲东轩得此生，平章物理忆渊明。\n晴塘滟滟起萍浪，夏木阴阴求友声。\n聊欲庶几三不惑，谁能复较四难并。\n旋烧蟹眼烹鹰爪，啜罢呼儿课二京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"印印诗","author":"喻良能","text":"印印秀而好，明眸冰雪肤。\n逢人赏岐嶷，问字识之无。\n若有万金药，真成千里驹。\n空花今已矣，晬日一长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史丞相生辰 其二","author":"喻良能","text":"长才蚤立太平基，奥学曾为帝者师。\n谋叶不资同列断，规存长许后人随。\n金鱼玉带今谁似，橘绿橙黄景最宜。\n再拜祝公千万寿，三江细酌入瑶卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史丞相生辰 其一","author":"喻良能","text":"姓名久已覆金瓯，一品师臣德业优。\n黼扆尚询黄发旧，衮衣难伴赤松游。\n松筠劲节高三事，桃李浓阴遍九州。\n萧叶杨门端可继，只今衮衮富公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司户李岩詹和予庐山诗二十一篇作诗为谢","author":"喻良能","text":"东野龙钟誇白首，岩詹矍铄事清修。\n胸中似有九云梦，笔下倒倾三峡流。\n和我七言清有味，能令三伏凛生秋。\n当年庐阜赏心处，恨不携公九日游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁川","author":"喻良能","text":"平生满耳说宣城，入境云烟照眼明。\n过雨偏浓千嶂碧，未秋先冷数溪清。\n细看菡萏波间色，时听绵蛮竹里声。\n不是多才谢公子，江山犹解发吟情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对厅口号","author":"喻良能","text":"欢声喜气溢黄堂，解愠风清化日长。\n簪绂尽倾千里目，冕旒遥祝万年觞。\n韵敲碧玉檀栾嫩，色斗红妆菡萏香。\n共庆庞恩新浃洽，圣君文母寿无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对镜芙蓉二岭相望仅三十里高不知几百尺十步九折殆不啻蜀道之难也己卯孟秋沿檄过之仆夫告痡己亦罢极因成小诗","author":"喻良能","text":"石镜宁堪对，芙蓉不是花。\n险中多虎迹，平处少人家。\n曲六蛇行迥，攲危鸟道斜。\n白云宜入望，不怕乱山遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"帅参宴客于蓬莱阁林参议有诗次韵呈府公","author":"喻良能","text":"久以嘉谋赞迩英，暂分东浙慰苍生。\n閒携僚吏挥金盏，更遣娉婷吹玉笙。\n霖雨千岩垂欲作，孤舟野水未妨横。\n匪因衮绣归黄閤，还念知章在四明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平湖","author":"喻良能","text":"平湖潋潋浸葱苍，画出风烟十亩强。\n蜜曲六从霜后熟，玉芙蓉向露中芳。\n新开石洞连松碧，低结萸房映菊黄。\n最爱堤边秦地柳，一回春到一回长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊子除夕追和陈简斋除夜一首","author":"喻良能","text":"世事年来已饱更，百年今夕两分平。\n窗间蜡炬偎人煖，瓶里梅花照眼明。\n瓦屋三间聊足喜，鬓霜千丈总堪惊。\n明朝同上西山望，应有江湖春水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"由之流溪回亭午苦热小憩牧马寺","author":"喻良能","text":"长途畏日欲流金，聊向招提觅快襟。\n翠合苔痕人寂寂，凉生柏影院深深。\n苦无俗物败佳思，况有寒泉醒客心。\n一饷清风寄蕲竹，又飞征盖指城阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"由安仁回宿大木寺","author":"喻良能","text":"御史题诗处，山深草木雄。\n一番青烧雨，十里锦帆风。\n婆饼林间语，山茶叶上红。\n明朝入于越，吟咏与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"由当涂回宿齐山用杜牧之韵","author":"喻良能","text":"一望云烟兴欲飞，晴光聊复步熹微。\n几年想像空怀古，今日登临自送归。\n寒菊有花宜靖节，澄江如练忆玄晖。\n夜深静坐清人骨，岩影侵阶月满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"由建宁回三山道中重阳","author":"喻良能","text":"征鞍初自富沙还，乱叶殷红点碧山。\n客里黄花惊度节，镜中白发巧摧颜。\n三休磴道惟频叹，一饭茆檐得暂閒。\n为想成均新榜帖，阿奴才力胜黄间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"由真隐至枕峰寺 其二","author":"喻良能","text":"野外初凉冷，征衫亦未重。\n檀栾溪上竹，勃窣道边榕。\n秋意撩人切，岚光泼眼浓。\n更寻天竺寺，却忆此高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"由真隐至枕峰寺 其一","author":"喻良能","text":"南国清秋杪，长林翠霭重。\n懒黄千顷稻，深碧万株榕。\n峡水风前急，方山雨后浓。\n征鞍何所憩，萧寺枕孤峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石井","author":"喻良能","text":"山右最佳处，有泉生石傍。\n虚明秋后月，清冷雪前霜。\n鳗井真牛后，龙湫可雁行。\n濯缨仍漱齿，政尔不能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立秋日迓宣谕中丞奉怀宋嗣宗","author":"喻良能","text":"绣斧离朝右，羸骖走道周。\n侵星宵不寐，曝日夕初休。\n天地方炎暑，山林漫早秋。\n广文官舍静，应念汗交流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"记六月二十日湖上所见","author":"喻良能","text":"羽客相携六一泉，炎歊立变晓凉天。\n陈朝古桧参天瘦，和靖孤坟傍竹偏。\n却向苏堤剥新芡，更寻萧寺听寒蝉。\n长吟小醉归来晚，足底清风似欲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"记梦","author":"喻良能","text":"小窗幽阁睡初匀，梦到钧天侍紫宸。\n盘号搯桃真异器，果名黄枣岂常珍。\n殊恩并浃鸰原弟，美味初尝鹤发亲。\n愿竭精忠图报称，觉来肝胆已轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相大资叶公挽词 其一","author":"喻良能","text":"双溪钟地谶，一相破天荒。\n道至黄扉重，勋由紫府昌。\n堤成欢百辟，台坼泣群方。\n盛烈铭钟鼎，千秋耿不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相大资叶公挽词 其二","author":"喻良能","text":"德望堂堂重，威名凛凛寒。\n三年衮衣粲，四海寸心丹。\n绿野悲裴度，苍生忆谢安。\n白头宾客在，惭痛泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相王公挽词 其一","author":"喻良能","text":"炎统中兴日，淳熙翊赞功。\n宪邦同吉甫，待旦类周公。\n一品恩荣重，三朝礼貌隆。\n欲知勋业盛，请视鼎彝中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]