Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵宪御史赴江西三绝 其一","author":"苏籀","text":"崆峒日煖岚峦丽，章贡桃花春涨豪。\n避传封人候骢马，道旁武吏各鞬櫜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵宪御史赴江西三绝 其三","author":"苏籀","text":"冷坐从嘲瓶井眉，俗流浅拙更忘遗。\n道鸣庶矣多闻力，建武官僚旧汉仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻邻娃酣讴一绝","author":"苏籀","text":"冶荡淹娴谁尔令，五陵妍騃可怜生。\n兰堂委巷喉呀啭，信有秦声非越声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莳兰一首","author":"苏籀","text":"湘累鞙佩南邦媚，天女襟期绝世芗。\n艺植便应弥九畹，孰知苓藿与詹糖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读范龙阁五丈奏议三绝 其一","author":"苏籀","text":"抚编屡叹才谟远，早岁升堂拜若人。\n亹亹听言皆破的，龙蛇蟠屈负经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读范龙阁五丈奏议三绝 其二","author":"苏籀","text":"奕枰著著穷机变，庖刃恢恢中会通。\n世俗吏能那并比，汗颜血指竟何功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读范龙阁五丈奏议三绝 其三","author":"苏籀","text":"九原英魄谁能作，规略千条殆可寻。\n佐佑艰难揣夷狄，似兹举措好为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成二绝 其一","author":"苏籀","text":"古风未必今人操，老气休祈大吏欢。\n扪腹定无奇士术，萧然且作野人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吕德元时为督府属二绝 其一","author":"苏籀","text":"稍费江南万侧釐，多誊符檄喻亡齐。\n宽然折箠可入汴，已见票姚擒日磾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吕德元时为督府属二绝 其二","author":"苏籀","text":"祖生晚节并刘琨，独免声消贾谧尘。\n虎士淮淝初小捷，谢庭兰玉绝常伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓言一绝","author":"苏籀","text":"輶眇岂任胜妇职，春暾桃蓓未敷莲。\n月娥宫额噫神护，旖旎仙舲托使旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑雨忆衢州一绝","author":"苏籀","text":"衣裳俎豆信华风，酒圣茶颠倚独松。\n夏屋渠渠听聚雨，数寻竹外泻琤淙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游服者二绝 其二","author":"苏籀","text":"畸情灰灺妙龄怀，佳月澄虚适与偕。\n隐几嘘天嗒然趣，参同九锁启仙阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简江国韩尉谢珍惠二绝 其二","author":"苏籀","text":"獠羞峦错儒庖溽，熊掌大嗤牛尾狸。\n饫脔羊膀与驼蹠，芳辛咀噍半酣宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾一绝","author":"苏籀","text":"梅酽兰氲芍药清，旃檀婆律萃天馨。\n试开秦赵当年目，何藉珠帘翡翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廛居一绝","author":"苏籀","text":"天碧绡帱障铁牛，廛居烦促远林丘。\n赫炎炽景烘炀灶，怅望金飙玉露秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潘令度送牡丹绝句","author":"苏籀","text":"剧美温馨逞瑰媚，腻红殷紫叠重台。\n芳晨华月临春阁，倚丽凝娇岂易栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题两黄仙人鍊丹山顶一绝","author":"苏籀","text":"丝毫触石千山泽，喙吻传声万壑雷。\n信有藓书标洞府，不应俗驾半途回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题善草字者一绝","author":"苏籀","text":"獐猎包羞爵秩加，舆人捧腹只呀呀。\n踏摇妍状当垆手，如许银钩殆可嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千叶白浮蕖一首","author":"苏籀","text":"娇酣拟谁似，韵甚莫为怜。\n矧肯媚尘俗，诚能降佛仙。\n洗君凡眼肉，嗟汝淤泥贤。\n三六驼颜侣，荡舟从妒妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小僧乞其师静悟塔铭一首","author":"苏籀","text":"劫火吴宫尽，耆年亦已殂。\n勤拳依佛敕，精苦是僧摸。\n愿力归兜率，宗风化给孤。\n禅心不沦谢，楚些漫招呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行入寺一首","author":"苏籀","text":"执舆入辇蹶痿几，陟险山农笑却时。\n屐齿未常先雍老，翚飞久已见甍楣。\n磴扉百步犹流汗，观阁三休岂易追。\n浪漫悠悠一鸡肋，角巾东路最平夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"才难一首","author":"苏籀","text":"建安谋首先文若，武德机神重伯褒。\n此士不妨门第美，于今景仰太山高。\n卓哉二贤强百万，何较九牛于一毛。\n异代爱才尊尚意，纷纷萎腐见儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕","author":"苏籀","text":"琉璃万宝通明殿，珠翠千层罨画楼。\n匝地薰天月灯影，撼山填郭蚁蜂稠。\n浚都平昔金鳌峙，雍幕寻常锦幰游。\n今岁山城索朋侣，屠门酒酝夥酣讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]