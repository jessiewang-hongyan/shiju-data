[{"title":"醉里","author":"白玉蟾","text":"道人天地便为家，惯见溪山眼不花。\n竹月光中诗世界，松风影里酒生涯。\n醒时吟笑扬州鹤，梦见常骑月府蟆。\n是则官家縻好爵，此生只合饭胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题上清法堂壁","author":"白玉蟾","text":"秋雨悬天风作寒，冷烟锁住屋头山。\n半岩飞鸟一声过，峭壁断云千古闲。\n世俗不知幽静处，神仙隐在有无间。\n夜来小艇篙脱手，醉把霜筇入翠湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题天开图画","author":"白玉蟾","text":"四时风物现安排，醉上高楼眼豁开。\n云散远山元不断，池成明月自然来。\n夕阳妆点丹青树，烟雨和匀水墨梅。\n此是天工无尽巧，何曾染惹俗尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题天宁寺海月亭","author":"白玉蟾","text":"昼潮夜汐大江东，江上东南宝刹雄。\n饭了从容陪海月，禅馀宴寂享松风。\n主宾无间诸尘净，心目相忘万象空。\n橙熟手香吟笔滑，馀情渺在夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题平江府灵岩寺","author":"白玉蟾","text":"万松挟岭壮招提，上有琴台与墨池。\n佛殿尚存今智积，娃宫曾馆古西施。\n太湖远水如奁镜，木渎平田似局棋。\n策杖访回无际塔，日晡聊看草书碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉隆宫壁","author":"白玉蟾","text":"旌阳归去太康年，石灶灰寒古洞前。\n笑斩白龙横蓼岸，醉骑黄鹤步云天。\n金丹玉屑不复得，铁臼石函犹宛然。\n四十二口家何在，猿啸西山柏树烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题华严寺","author":"白玉蟾","text":"匹马追风访地灵，山衔夕照鸟飞惊。\n裴休虽是参黄檗，韩愈何曾嗣哲兄。\n竖拂拈槌吾不会，篇诗斗酒过平生。\n侬家自有修行处，夜夜丹炉炼月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西轩壁","author":"白玉蟾","text":"随身风月几清闲，不做人间泼底官。\n朝饮一壶朱凤髓，暮餐八两黑龙肝。\n打开俗网了无事，缚住时光自驻颜。\n昨夜梦回天上去，琼楼玉阙不胜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题余府浮香亭","author":"白玉蟾","text":"小亭低瞰小池边，日日春风醉管弦。\n盘礴好穷诗世界，登临疑是水神仙。\n玉萍掩映壶中月，锦鲤浮沉镜里天。\n芍药牡丹归去后，花开十丈藕如船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题迎仙堂","author":"白玉蟾","text":"昔日寻师到海涯，手中常袖一青蛇。\n随身风月长为伴，到处溪山总是家。\n玉笥岩前曾结草，金华洞里独餐霞。\n有人问我长生事，默默无言指落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题净明轩","author":"白玉蟾","text":"净几明窗兴味浓，老僧心下万缘空。\n黄鹂睡起摇开竹，白鹤飞来点破松。\n些子溪山藏夜月，无边花柳恼春风。\n真如般若头头是，坐断蒲团子细穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题岳祠","author":"白玉蟾","text":"南来一剑住三山，分得平生风月欢。\n虽宰旌阳应施药，本求勾漏为脩丹。\n蒙庄且慕漆园禄，李老尝为柱下官。\n我视荣华真惯见，何如早炼碧琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题瓮斋","author":"白玉蟾","text":"万轴牙签聚碧芸，数间茅屋锁闲云。\n莺吟芍药一歌女，蚁绕菖蒲万水军。\n香穗横窗盘瘦影，茗花浮枕斗清芬。\n琴心三叠昼眠觉，熟读数篇韩柳文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金粟洞","author":"白玉蟾","text":"白云乱山深复深，洞口枯树鸣幽禽。\n玉雪影梅春寂寞，琅风韵竹夜萧森。\n海流城外青罗带，岩耸天边碧玉簪。\n忆著仙人郑文叔，泪随夕照落平林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南海祠","author":"白玉蟾","text":"何处人间得五羊，海城鼓角咽昏黄。\n无心燕子观秦越，有口檐铃说汉唐。\n九十日秋多雨水，一千年史几兴亡。\n圣朝昌盛鲸波息，万国迎琛舶卸樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钟","author":"白玉蟾","text":"闻道琳宫欲范钟，上皇敕赐万斤铜。\n一模脱出等闲事，千古要知陶铸功。\n敲得星飞惊落月，撞教云破响呼风。\n于今欲为吾皇寿，笑指琼楼贴碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题栖云堂","author":"白玉蟾","text":"高人占断一生閒，长得青山在眼看。\n棋子纵横星点乱，琴弦戛击玉声寒。\n无心门掩苔三径，观化庭栽竹万竿。\n中有玄机人不会，清风明月两丸丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题栖仙馆","author":"白玉蟾","text":"好松好竹好溪山，车马骈阗自往还。\n行客闻篘新酒白，入门路破嫩苔斑。\n我言物外清幽地，却似廛中阛阓间。\n谷粟桑麻空润屋，主人陪接不曾闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题笔架山积翠楼","author":"白玉蟾","text":"万顷平田指掌间，松梢直上与檐干。\n云粘暮色月华湿，树颤秋声天籁寒。\n窗外好山千翡翠，屋头修竹万琅玕。\n楼中啸罢玉龙去，浩荡天风生羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题诸葛桂隐书堂","author":"白玉蟾","text":"豪侠相逢好弟兄，竹篱茆舍聚双星。\n青松影里诗鸿雁，白石岩前酒鹡鸰。\n笔下驱回千铁骑，胸中包得几沧溟。\n令人忆著张华剑，三百年来无血腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清虚堂","author":"白玉蟾","text":"月移花影来窗外，风引松声到枕边。\n长剑舞馀烹茗试，新诗吟就抱琴眠。\n酒醅初泼青螺髓，香篆常烧紫马鞭。\n九曲溪头冲佑观，清虚堂里有神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题舒氏难老亭 其二","author":"白玉蟾","text":"三十三天第一天，玉皇殿下袅轻烟。\n不知劫数今何代，方是延康第二年。\n弱水无船归似箭，华胥有梦且游仙。\n携筇难老亭前坐，且结焚香瀹茗缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题舒氏难老亭 其一","author":"白玉蟾","text":"别是人间一洞天，椿松郁郁起祥烟。\n德同桂种不知岁，福与水流无尽年。\n萱草堂前千古事，莲花池上两神仙。\n莱衣戏綵人无恙，结尽溪山风月缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鼓山超凡阁","author":"白玉蟾","text":"输与黄龙第一筹，于今不到洞宾羞。\n九重城里圣箭子，三百年来粪扫头。\n山月扶疏龛石冷，天风浩荡海槎浮。\n我来会得谦公意，竖起拳头向赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题潜庵","author":"白玉蟾","text":"已把功名等风絮，鹤氅星冠懒成趣。\n谷口人寻虎迹来，林间庵在猿啼处。\n好向青山白云中，参取翠竹黄花句。\n道人珍重老维摩，明日千峰万峰去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鹤林宫","author":"白玉蟾","text":"王邓诸公焉在哉，云屏烟嶂锁苍苔。\n大千国土无双客，第一洞天游两回。\n太极光阴忘甲子，九霄云气接蓬莱。\n桑田海水今如许，劳得朝猿暮鹤哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"澹庵","author":"白玉蟾","text":"平生只要乐清虚，占断人间静处居。\n古壁空悬三尺剑，幽窗闲却一床书。\n远山喜色日初染，枯木凉声风自梳。\n细嚼清闲滋味别，云霞收拾作粮储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕","author":"白玉蟾","text":"新巢故园两依依，似与春花秋叶期。\n雨过池塘得泥迹，日高台榭卷帘迟。\n秋千节后初相见，祓禊人归有所思。\n双侣多情拟凭仗，小笺封就碧云诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕岩游罢与岩主话别","author":"白玉蟾","text":"西风吹作此岩游，满目松筠翠欲流。\n玉燕不飞明月夜，石钟一振晓霜秋。\n惜乎分水便南北，忽尔回头欲去留。\n且去人间办丹料，却来山顶结茆休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薛直岁喜神赞","author":"白玉蟾","text":"和风满面紫芝春，双脸常如酒半醺。\n法箓把除符券柄，宗门立尽栋梁勋。\n凤冠夜戴琼林月，鹤氅朝披玉洞云。\n自是神仙真气象，多生曾是薛真君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠天台老樊","author":"白玉蟾","text":"别后俄经几许春，相逢一笑挹南薰。\n灰头土面无人识，木食草衣嫌俗纷。\n在浙之台今已久，姓樊名邴寂无闻。\n为君传此新诗去，寄与铅山赵翠云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠天庆观","author":"白玉蟾","text":"买得螺江一叶舟，功名如蜡何休休。\n我无曳尾乞怜态，早作灰心不仕谋。\n已学漆园耕白兆，甘为关令候青牛。\n刀圭底事凭谁会，明月清风为点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠王太尉","author":"白玉蟾","text":"笑曳华裾出禁庭，一声长啸万山青。\n归来车马如云拥，扫去簪缨似梦醒。\n红码碯杯斟白酒，碧珊瑚枕倚朱屏。\n也须趁取些强学，作个唐人五达灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠卢隐居","author":"白玉蟾","text":"日高丈五尚酣眠，心下无愁不管天。\n野蔌山肴酬白醑，乾柴净米煮清泉。\n不须求仕如藏用，且自烹茶学玉川。\n时策短筇松竹下，清閒便是地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠冲虚邹道士","author":"白玉蟾","text":"吾师有道貌，山水个中人。\n无著故无累，是清还是真。\n烟霞供笑咏，泉石瀹精神。\n何日分峰隐，诛茅愿卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠危法师","author":"白玉蟾","text":"曾见先生在九华，朝餐玉乳著琼花。\n鹿冠夜戴青城月，鹤氅晨披紫府霞。\n偶携剑在人间世，未把琴归仙子家。\n一笑相逢松竹里，炷香新话啜杯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠吴草裘","author":"白玉蟾","text":"闻道青城有老吴，话头入耳十年馀。\n偶同婺女无忧客，来到天台撞见渠。\n身上衣衫惟布素，口中谈吐尽丹书。\n想君已是千馀岁，谁道神仙世上无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠杜省元","author":"白玉蟾","text":"海外三山一洞天，金楼玉室有神仙。\n南柯国里柯岩叟，白马江边马自然。\n鲸脯味甘供老广，黄麻饭熟饲彭铿。\n金丹炼就炉无火，桃再开花经几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠坦庵告别","author":"白玉蟾","text":"杖头挑起一天云，政是梅花十月春。\n猿叫千山风势恶，雪迷万里雨声频。\n今朝瓢笠游方外，旧处烟霞失主人。\n好去著鞭行所得，他时相见话头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠侯先生","author":"白玉蟾","text":"腰悬龙泉剑，背负寒玉琴。\n阅世几秋雨，随身一纸衾。\n苍髯怒更直，碧眼笑仍深。\n今过青城去，人间何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士岳鬼眼","author":"白玉蟾","text":"眉峰肩井额陂陀，此相曾经鬼眼过。\n知有命存聊尔耳，谓无天定盍如何。\n十常九事未如意，一满三停属甚科。\n佛说我身周法界，恐君莫是烁迦罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠赵县尉","author":"白玉蟾","text":"半斤雷火烧红杏，一滴露珠凝碧荷。\n锦帐中间藏玉狗，宝瓶里面养金鹅。\n铅花朵朵开青蕊，汞叶枝枝发绛柯。\n莫问婴儿并姹女，等闲寻取旧黄婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠赵翠云","author":"白玉蟾","text":"金公姹女到黄家，活捉苍龟与赤蛇。\n偃月炉中烹玉蕊，朱砂鼎里结金花。\n奔归气海名朱骥，飞入泥丸是白鸦。\n昨夜火龙争战后，雪中微见月钩斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠夏知观","author":"白玉蟾","text":"早岁江湖走一遭，归来姓字籍祠曹。\n未还风月烟霞债，又主香灯粥饭劳。\n捲雪楼前更袯襫，驻云堂内饮蒲萄。\n新凉要过庐山去，拟欲从君借小艘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠紫华侍经周希清","author":"白玉蟾","text":"螓首蛾眉天上人，不知何事到红尘。\n神霄蕊笈今谁侍，紫府琪花不敢春。\n无梦去陪王母宴，前生多是紫虚身。\n寄言寻取蓬莱路，风送双鸾上太旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠雷怡真","author":"白玉蟾","text":"地魄天魂日月精，夺来鼎内及时烹。\n祇行龟斗蛇争法，早是龙吟虎啸声。\n神水华池初匹配，黄芽白雪便分明。\n这些是饮刀圭处，渐渐抽添渐渐成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠慵庵卢副宫","author":"白玉蟾","text":"山色凝云翠几重，鸟声惊落夕阳红。\n要携琴去弹秋月，且掇棋来著晚风。\n一度醉眠知事少，数番吟畅觉心空。\n慵庵不与人相与，阁上柴门滋味浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠樗野","author":"白玉蟾","text":"不叹劳生行路难，自怜云水许间关。\n别来五载多怀感，待有尺书无往还。\n微白一钩天外月，淡青数点海边山。\n襟情欲向何人诉，与子篝灯到夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蟠龙庵","author":"白玉蟾","text":"五乳峰前第几峰，碧潭深处有蟠龙。\n半岩冷落孔明雨，一枕萧骚少说风。\n变化爪牙君子竹，埋藏头角大夫松。\n高人凄此结茆屋，天下苍生怨旱虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日同王茂翁联句 其一","author":"白玉蟾","text":"凿冰添砚水，燃干发梅花。\n踏破霜苔径，烧红雪树槎。\n闭门风愈怒，送客日将斜。\n寒甚酒无力，闲多道有芽。\n楮衾眠不暖，苇壁破难遮。\n他日瑶台上，流传仙子家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹤观","author":"白玉蟾","text":"琅庭珍馆一何清，四壁如银窗更明。\n雨馀草色欺苔色，风送松声杂涧声。\n芍药花开今四月，杜鹃啼恨到三更。\n我来暂息白鹤观，忆著故人刘混成。\n松殿空遗金凤舞，芝田不见铁牛耕。\n云迷古洞虎狼吼，烟锁平林鸟雀惊。\n日暮山屏增紫翠，晓来天籁自箫笙。\n杖头挑月过山北，要趁如今几日晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拙庵","author":"白玉蟾","text":"笑携藜杖倚寒松，现世神仙一拙翁。\n冠简投关离玉阙，天人推出镇琳宫。\n身居星弁霞裾上，心在烟都月府中。\n岂是摩挲令发黑，不须服饵自颜红。\n百年赢得十分讷，万事算来俱是空。\n解织蜘蛛空结网，能言鹦鹉被樊笼。\n闲将世味闲中嚼，静把天机静处穷。\n学巧不如藏巧是，忘机不与用机同。\n虚空不语虚空广，造化无声造化公。\n六贼奈人闲不得，十魔见我懒相攻。\n凝神多得佯呆力，养气无非守口功。\n欲雨只消呼瀣沆，要雷略目召丰隆。\n人间若也不容住，学骑白鹤乘天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂礼成","author":"白玉蟾","text":"丰年有高廪，宗祀拜明堂。\n玉辂迎阊阖，银蟾跃未央。\n虎贲森卤簿，龙衮照旂常。\n宝幄燃红炬，璇霄降紫皇。\n竹宫循汉古，茆屋法周荒。\n云蔼箫韶暖，风融黍稷香。\n典刑存郁鬯，陟降奉圭璋。\n水取方诸氏，星沉析木乡。\n金鸡欢舞蹈，翠凤播琳琅。\n何日当封禅，如今尚小康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金液大还丹","author":"白玉蟾","text":"乌兔乾坤鼎，龟蛇复姤坛。\n世间无事客，心内大还丹。\n白虎水中吼，青龙火里蟠。\n汞铅泥蕊艳，金木雪花寒。\n离坎非心肾，东西不肺肝。\n三旬穷七返，九转出泥丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南台舟中联句","author":"白玉蟾","text":"秋阳红若柿，晓雨翠如丝。\n福地逢迎日，江天笑傲时。\n莲胭犹殢水，桂粟已粘枝。\n波静天一色，山低云四垂。\n垂纶怀渭叟，纵棹拟鸱夷。\n上水迟吾乐，西风壮我诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倪昭卿赋赠叶神童 其一","author":"白玉蟾","text":"神童之貌清且奇，神童之道传希夷。\n入室三年丹已熟，肌肤绰约光离离。\n结缯自覆有馀乐，晔晔紫芝堪疗饥。\n跳入壶中人莫见，朝游五岳暮瑶池。\n有时混世来尘境，短发鬅鬙满面垂。\n顷刻龙蛇生笔下，为将高兴寄新诗。\n我疑虚静乐山水，来归旧隐挂冠緌。\n愿策浮云飞碧落，致身绛阙长相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽觉非先生彭吏部","author":"白玉蟾","text":"公本篯仙后，缘何出自闽。\n东山为别久，西浙得书频。\n投老欣添岁，归闲剩得春。\n满朝俱叹誉，八秩向精神。\n见说临终日，鞭霆谒上真。\n不能躬桂酹，千里一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捲雪楼","author":"白玉蟾","text":"烟水苍苍古渡头，神鸦噪罢缆方收。\n泊舟凫渚鸥汀晚，夜入兰宫桂殿秋。\n绿苇黄芦悲落日，白蘋红蓼闹沧洲。\n冥冥千古今如梦，浩浩长江不管愁。\n雁阵归时云似幕，风樯高处月如钩。\n惊涛飞起银花舞，万顷寒光十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋诗二首呈懒翁 其二","author":"白玉蟾","text":"懒翁老白结忘年，秋入淡烟疏雨天。\n醉把黑甜圆个梦，时将草圣放些颠。\n杖藜还尽溪山债，杯酌结交风月缘。\n梭督青童驰讷椠，鳞烦紫吏馈雄篇。\n金华都似一楪大，却贮两枚诗酒仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潘紫岩与余赋雪约不得用色数并实字及比喻","author":"白玉蟾","text":"不似寻常冻，俄而散漫飞。\n羞明犹欲落，等伴未全晞。\n承得圆还碎，看来是复非。\n积深仍密密，舞急转霏霏。\n弗是筛成细，何如拾取归。\n今焉皆璀璨，昨者只浽?。\n扫去依元有，呵来忽渐微。\n乱飘寒转甚，相映远生辉。\n莫踏凹中满，遥知凸处肥。\n严凝吟不厌，凛冽饮无威。\n赏玩真堪乐，丰穰不用祈。\n婵娟虽可待，融散恐几希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]