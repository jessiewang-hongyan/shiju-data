[{"title":"岁律","author":"徐集孙","text":"岁律又侵寻，桃符句索吟。\n经年为客梦，每日在家心。\n眼老看山惯，愁多怯酒深。\n公馀惟读易，世事任浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"徐集孙","text":"华阳暂脱戴朝簪，悔被浮云惹动心。\n世事可惊如雨骤，客怀无限并秋深。\n能归不似天边燕，怯冷愁闻月下砧。\n几许清高堪自慰，官居赖有竹萧森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江湖伟观","author":"徐集孙","text":"昔日山中一小亭，重新轮奂转峥嵘。\n著身梯磴千层上，到眼江湖两派明。\n鼎药丹成仙已去，杯泉墨冷水犹清。\n寿星炯炯无今古，长照东南王气生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹阁","author":"徐集孙","text":"昔日孤山像，重移阁几春。\n骚名垂句法，遗爱稔邦民。\n雨剥一碑古，风摇万竹新。\n来游兴感慨，谁继若而人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中","author":"徐集孙","text":"厌杀人间名利忙，我忘名利只诗狂。\n雅陪云衲三生话，分得渔舟半日凉。\n傍水细看鸥鹭浴，隔芦吹过芰荷香。\n从容饱遂清游胜，那似家居卧竹房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访林可山不值","author":"徐集孙","text":"寻君每自恨迟迟，及扣岩扃误所期。\n空放山间云外鹤，只吟篷底雪中诗。\n孤灯攲枕劳频梦，樽酒凭栏定几时。\n独立小桥回首处，篱边犹喜见横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访诗人","author":"徐集孙","text":"得得访诗仙，平湖水接天。\n身轻如鹤羽，路远买渔船。\n日上荷撑盖，春深柳脱绵。\n造门人已出，冷漱石山泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访僧不遇","author":"徐集孙","text":"特地寻君选佛场，行行踏遍古苔荒。\n不因坐石贪搜句，何事抽单辍赴堂。\n空榻日移悬锡影，别寮风过煮茶香。\n忙中我为閒来到，君本閒人为甚忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余种竹方成扁其室曰竹所友人以诗至用其韵","author":"林尚仁","text":"屋老苔荒席久虚，近分一榻与云俱。\n梅花未种招蜂怨，竹所虽清欠鹤图。\n无事看山如对客，有时隐几亦忘吾。\n过门除却能吟者，不是高僧即老儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭","author":"徐集孙","text":"山远源深绝市声，许由因此隐方成。\n一生独喜枕流好，万事何如酌水清。\n野衲洗心滋味淡，骚人照影利名轻。\n软红尘里浑如醉，谁识斯泉可濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"徐集孙","text":"无端梅潦肆鸣渠，官舍萧条似僦居。\n把酒厌谈天下事，挑灯频读故人书。\n吏抄诗懒多讹字，僮治餐迟少嫩蔬。\n浊世炎蒸方郁郁，庭前新草不令除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜北山同石峰僧来访","author":"徐集孙","text":"梅花同伴瘦，一瘦有谁过。\n岁事那堪晚，心期未易多。\n杯深和月吸，砚冷带冰磨。\n山暝归鸦急，相分独奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵芝寺","author":"徐集孙","text":"梵宇背湖光，朱桥度绿杨。\n折藤维小艇，拂石坐幽房。\n斋版惊閒鹭，苔碑卧夕阳。\n都人喧鼓吹，未识此徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"言事","author":"徐集孙","text":"读了南华枕曲肱，无端客梦冷偏增。\n官将满去多逃吏，诗不吟来少寄僧。\n乱叶打窗猫上案，斜阳过屋鼠窥灯。\n孤山在望何时雪，问讯梅花策瘦藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲赋","author":"徐集孙","text":"梅花白向鬓根生，岁月蹉跎事欠成。\n读过故书温有味，借来新絮冷无情。\n未霜山寺昏钟劲，欲霁湖亭夕照明。\n多少红尘留滞客，可曾归去力春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵冰岩借宿僧房韵","author":"徐集孙","text":"鸥盟乡国外，簪盍把题分。\n旅舍嫌红日，僧房卧白云。\n茶新翻雪乳，砚古带潮纹。\n黜陟人间事，栖心耳不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜过富春","author":"徐集孙","text":"夜船摇兀当乘槎，得与僧俱似出家。\n数幅征帆抛草渡，一团幽梦绕梅花。\n风传山县残更漏，潮练霜江淡月华。\n所恨钓台眠里过，矶边不及理渔车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山访郑渭滨不值","author":"徐集孙","text":"寂寞石琴台，香云拨不开。\n多知骑鹤出，自欲买舟来。\n葑岸春回草，山亭雨谢梅。\n怀人成怅惘，日暮惜空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官舍双桂","author":"徐集孙","text":"翠玉黄金剪缀成，幽香不断袭人清。\n独披月色连宵看，更结秋风来岁盟。\n好梦偏为蛩叫破，吟身那似蝶飞轻。\n纷纷凡卉谁堪眼，说与寒梅蚤合并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杪岁","author":"徐集孙","text":"几多风月费招邀，传舍侵寻一载侨。\n客久梦魂安澹泊，岁残老态厌喧嚣。\n晴空雪片飘梅瓣，冷地春光上柳条。\n世事每从儿戏过，门前歌舞又元霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郑渭滨过访而杜北山诸友继至惜乎招石峰月溪二禅不来","author":"徐集孙","text":"未见南枝与北枝，一清谁可话襟期。\n不嫌添客重行酒，所欠惟僧共说诗。\n竹影因风和雀动，水声带雨启鸥疑。\n黄昏紧闭寒扉坐，自展韦编对伏牺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨作","author":"徐集孙","text":"薰风入断篱，犹自雨凄凄。\n数日无人过，终朝共鹤栖。\n云浓山寺失，水汎板桥低。\n亦有田堪秫，何时得荷犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯平洲僧","author":"徐集孙","text":"天地一身閒，袈裟裹乱山。\n听经离竺寺，结制去云间。\n包重悬诗稿，藤枯带藓斑。\n西风落梧叶，应又向西还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯吴西畴东归","author":"徐集孙","text":"交情寥落若商参，谁是如兰可断金。\n别去社中怀旧友，喜来湖上共新吟。\n好山争似居家看，冷菊难禁在旅心。\n我欲学君归未得，来年竹屋再相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客怀","author":"徐集孙","text":"衣袂半埃尘，堪嗟白发新。\n古今同逆旅，湖海未归人。\n雨霁船争渡，花飞鸟怨春。\n片云千里迥，日日谩烹鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客梦","author":"徐集孙","text":"人生总总汩浮荣，勘破令人厌宦情。\n竹屋无时劳结梦，秫田何日遂归耕。\n雨侵药灶莓苔长，秋透书台笔砚清。\n渐老鬓毛犹未雪，此身犹及见升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日访四圣郑渭滨","author":"徐集孙","text":"访旧孤山去，桃花观里春。\n迎香开道室，借酒酌吟人。\n琴操音还古，蔬盘味却真。\n斜阳各分散，一水隔红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐","author":"徐集孙","text":"老屋萧条半欲斜，绳床独坐看蜂衙。\n经年官况浑如客，计日安书已到家。\n策策冷风删树叶，丝丝暮雨织檐花。\n梦魂不那归心切，小圃堪锄自种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看梅","author":"徐集孙","text":"岁寒气味少人知，一度相逢一度奇。\n不受阳和私点化，惯经风雪冷禁持。\n影横坡老数枝画，香沁逋仙两句诗。\n相对依依吟未得，斜阳归路不妨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵紫芝墓","author":"徐集孙","text":"晚唐吟派续于谁，一脉才昌复已而。\n对月难招青冢魄，见梅如揖紫芝眉。\n四灵人物嗟寥落，千古风骚忆俊奇。\n公去遥遥谁可法，少陵终始是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送叶靖逸之维扬","author":"徐集孙","text":"竹西亭下路，二十四桥迂。\n有志风寒地，携家雨雪途。\n杯酣看玉蕊，橐重载湖珠。\n写就乌丝句，无妨寄雁奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧之毗陵","author":"徐集孙","text":"无意坐林丛，云飞天四空。\n禅心包影外，客梦橹声中。\n胜负机何密，穷通算尽工。\n此行应不错，知遇有诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重拜和靖先生墓","author":"徐集孙","text":"秋声尔许悲，怀古若为思。\n菊老泉堪荐，山孤草亦萎。\n高风留塑鹤，残雨暗荒碑。\n依旧梅千树，无花香似诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻鹤","author":"徐集孙","text":"千年华表竟何荣，曾结孤山夙世盟。\n午夜露零和月冷，一声风静仰天鸣。\n既归蕙帐情何怨，不上扬州韵更清。\n未必湖阴人听得，听来好爵谩营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夕","author":"徐集孙","text":"一岁惊心忽已除，宦游尚自客西湖。\n漫题桃板标茅屋，旋买梅花插瓦壶。\n俸薄幸无赊酒债，官閒却有索诗逋。\n明朝万事从头起，依旧山肩竹样癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"借林可山韵饯萝屋僧","author":"徐集孙","text":"吟卷多题品，君齐贾岛才。\n闻风知竹瘦，载雨过湖来。\n交淡杯中水，儒酸叶底梅。\n便辞京口去，觅取近诗开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽北涧","author":"徐集孙","text":"本分参禅学，吟中透一关。\n清名传北涧，遗像在南山。\n石塔人千古，烟梯屋数间。\n诗魂何处觅，应伴白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽孙花翁","author":"徐集孙","text":"清气散乾坤，人亡名尚存。\n玉寒埋葛岭，墨淡惨秦村。\n井菊风号冢，山花月返魂。\n子孙无处觅，吟客酹芳尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李山房","author":"徐集孙","text":"吟誉先君者，多埋葛岭傍。\n几年千里客，一夕九原伤。\n琴砚遗儿远，棺衾得友偿。\n玉楼天上事，应有旧山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽灵隐僧珏月窗","author":"徐集孙","text":"秋月只清辉，窗明人不归。\n呕心成宿病，蜕骨悟前非。\n书偈辞禅院，缄衾寄母闱。\n猿啼泉石冷，客泪为君挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀里中诸社友","author":"徐集孙","text":"自笑初无作吏能，却因作吏远诗朋。\n与君交讯欠逢雁，知我怀人独是僧。\n客枕梦残听夜雨，乡心愁绝对秋灯。\n何时岁老梅花下，石鼎分茶共煮冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄里中社友","author":"徐集孙","text":"欠作故人书，侵寻半载馀。\n穷吟虽各自，入梦不相疏。\n梅蕊通春信，霜风促岁除。\n待余归故里，鸥约复如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题漱玉","author":"徐集孙","text":"一派潺湲迸石溪，直疑寒碧练玻璃。\n百川流去须归海，万籁喧来有定时。\n桥接丹山横夜月，柳笼碧草拂晴曦。\n吟庐此去虽相近，争似閒鸥立渺瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"智果寺观东坡墨迹参寥泉","author":"徐集孙","text":"煮茗评诗岁月深，堂堂遗像篆烟沉。\n数间老屋关兴废，一段清名无古今。\n碑断乱云封字脚，井昏落叶覆泉心。\n斜阳影里夷犹处，仰止高风不敢吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖西纳凉","author":"徐集孙","text":"小艇撑过第一桥，酌泉桥下掷诗瓢。\n来游道院分荷供，拟拉吟僧遣鹤招。\n暮霭直从渔笛起，月华高过塔灯遥。\n且于静处偷清福，人海惊人涌似潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖亭夜坐","author":"徐集孙","text":"片叶秋风数日程，争如天籁未秋声。\n厌居尘境炎威炽，来纳虚亭夜气清。\n万点萤光移醉眼，一湖蟾影荡吟情。\n笙歌寂寂重关掩，独许高僧并臂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋雪","author":"徐集孙","text":"漫天飘瑞压嚣尘，一夜西湖幻出银。\n煎入茶铛清肺腑，吟归诗句爽精神。\n糁填鹤迹看旋没，封合梅花认不真。\n茅舍竹篱犹富贵，长安安得有贫民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋竹间僧诗藁","author":"徐集孙","text":"借来香墨本，相对坐孤檠。\n句似寒梅好，梦从春草生。\n逼人禅价重，唤我宦情轻。\n一事犹相得，此君同此盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遗僧楮衾","author":"徐集孙","text":"练从秋水桂华乡，雅称分供衲子床。\n一段温和云共软，十分明洁月争光。\n吟魂有梦圆春草，禅骨无因怯晓霜。\n金帐绣衾皆业境，此中清趣最深长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬云间僧见寄","author":"徐集孙","text":"一从湖上别，无处问相知。\n几夜频驰梦，今朝忽寄诗。\n山昏云过湿，院静鹤归迟。\n此去秋风近，应须动客思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝉","author":"徐集孙","text":"高蹈槐梢与柳阴，争鸣直到日西沉。\n初无识见偏容喙，不读诗书却好吟。\n风露细餐虽足饱，山林为计更宜深。\n所谈幸尔非人事，逆耳从来欠赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静中","author":"徐集孙","text":"静中白日十分迟，唤起乡心怯子规。\n客味有如杯水淡，宦情肯被一尘缁。\n瓶储馀粟缘供鹤，俸乏零金为买诗。\n坐久不禁春雨暗，谁家楼上笛频吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠黄羽士","author":"徐集孙","text":"闲披鹤氅紫藤冠，带得林泉骨相寒。\n落魄一身风雪冷，飘蓬千里水云宽。\n素餐洗砚抄诗句，清夜敲钟上醮坛。\n准拟学仙仙遇否，何年炼就九还丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹭","author":"徐集孙","text":"素狎沙鸥水国盟，一生踪迹任飘零。\n漫誇霜雪精神别，难洗虾鱼气习腥。\n点破青山成晓画，飞来红蓼称秋汀。\n江湖出入风波里，比著胎仙欠典刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下竺看猿","author":"徐集孙","text":"渴泉饮罢过别枝，株守山林得便宜。\n伸手攫拿野僧果，贵游玩弄如儿嬉。\n膏粱恣欲甚丘壑，苞苴剩把实囊橐。\n本然无物抛乞与，纵有腥膻医无药。\n劝汝俦侣只依僧，残斋剩核亦洁澄。\n切勿自照具人面，便尔忘却当初洞口呼不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋夜雨","author":"徐集孙","text":"两年客帝畿，圆月浸秋辉。\n今夜月圆时，风雨打门归。\n年年此桂魄，不照今年客。\n明月应团团，只被浮云隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公无渡河","author":"徐集孙","text":"公无渡河，公无渡河，公必欲渡意如何。\n波涛汹涌何足畏，中原未复一身多。\n争知平地有风波，人心之险险于河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰","author":"徐集孙","text":"淡淡九畹质，雅好住山林。\n幽香不求知，伯夷叔齐心。\n世道不复古，纫佩取骚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古乐府","author":"徐集孙","text":"郎别二十春，未报淮头捷。\n空房守节心，羞见双胡蝶。\n滴泪写胭脂，欲寄南雁群。\n恐荡郎客思，封了却还焚。\n妾甘奉姑老，妾甘育子稚。\n它日昼锦归，愿郎无弃置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古意","author":"徐集孙","text":"彼美山中桐，千古生清风。\n斲削罗徽弦，不费胶漆工。\n伊石台有梅，月冷云空濛。\n一弹弹春江，迟日春融融。\n再弹弹招隐，霜木吟樵枫。\n三弹弹离骚，感慨古道隆。\n大羹玄酒味，旨趣回颛蒙。\n世无子期耳，知音未易逢。\n袖手长太息，所听何不同。\n所听非不同，举世郑卫聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"本心参政约游西山分韵得顶字","author":"徐集孙","text":"仆仆事行役，度尽千峰顶。\n恣览亦云倦，困卧殊未醒。\n西爽俄见要，前约欲重订。\n结习若犹在，宁复计两胫。\n天际豁轻阴，溪头横短艇。\n摇手谢篮舆，信步蹋荒径。\n适意自忘远，迷途谁为诇。\n此翁平生意，故自略畦町。\n何妨一笑回，呼童催煮茗。\n两年已三至，我如饫五鼎。\n无乃太属厌，徒欲逃酩酊。\n老笔忽先倡，高标谁与并。\n尚记去载游，金碧光炯炯。\n何处非吾乡，一气相涬溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自君之出矣","author":"徐集孙","text":"自君之出矣，蛾眉不复扫。\n宝鉴委埃尘，玉容为谁好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观秋潮","author":"徐集孙","text":"八月西风嘘沆瀣，长江协候肆澎湃。\n钱塘王气天所钟，非为子胥逞灵怪。\n海门三山缥缈青，双练夹岸奔雷霆。\n蛟龙鼋鼍匿形影，银涛雪浪翻沧溟。\n踏浪群儿惯行险，出没波心旗闪闪。\n须臾潋滟潮信平，荡漾渔舟千万点。\n天低暮霭袭人衣，游子兴尽各云归。\n独有骚翁看不足，吟到夜月扬清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"坚冰","author":"徐集孙","text":"滕六巧呈瑞，平白一尺高。\n霜风凛烈生，挟夜声如号。\n冰澌条玉箸，瓦缝镜银膏。\n茆檐顿暴富，掩映何奢豪。\n晶光动闾里，健羡等儿曹。\n此时轻脆资，坚谓千载牢。\n一旦阳明升，消泮蔑纤毫。\n奚独此为然，世事亦滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"徐集孙","text":"夜半倏惊觉，狂风搅秋鸣。\n掣电起迅雷，骤雨翻盆倾。\n逆知造物意，揫敛万宝成。\n天威不竟夕，须臾山月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]