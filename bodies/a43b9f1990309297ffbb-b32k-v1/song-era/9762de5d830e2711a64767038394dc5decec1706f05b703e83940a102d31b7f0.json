[{"title":"东谷偶成","author":"文同","text":"府事幸稀简，常为东谷游。\n旧山兹彷佛，佳景每迟留。\n断续溪云起，纵横野水流。\n拂衣知未得，聊此慰乡愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东窗","author":"文同","text":"丛榆落碎钿，蔓柳扑轻绵。\n丽畹暗红雾，曲堤横翠烟。\n嘉树正阴合，好禽新语圆。\n东窗日已满，犹托隐囊眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬晚书事","author":"文同","text":"倚杖立亭皋，寒威向晓豪。\n雪乾山色老，风烈树声高。\n残日千鸦舞，孤云一雁号。\n自然成感物，不觉首重搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北园避热","author":"文同","text":"缭绕度回塘，纡馀转短墙。\n引筇聊散诞，入竹得清凉。\n正午禽虫净，初晴果木香。\n移床就高处，更欲解衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北城楼上","author":"文同","text":"满目望不极，城楼当最高。\n地形连楚阔，山势入秦豪。\n平外斜通骆，深中远认褒。\n图经何壮观，故事有萧曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北斋雨后","author":"文同","text":"小庭幽圃绝清佳，爱此常教放吏衙。\n雨后双禽来占竹，秋深一蝶下寻花。\n唤人扫壁开吴画，留客临轩试越茶。\n野兴渐多公事少，宛如当日在山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正肃吴公挽诗 其二","author":"文同","text":"晁董文章重，夔龙德业尊。\n简编成故事，穹壤与长存。\n风旐飘寒陌，霜笳咽晚原。\n谁人碑有道，应不愧斯言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正肃吴公挽诗 其一","author":"文同","text":"虎节归兵日，麟符命使年。\n帝将还二府，人已哭三川。\n清议谁违者，高风自凛然。\n佳城空万古，一圹掩寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永泰刘令清曦亭","author":"文同","text":"木杪照初日，捲帘知晓晴。\n轩窗无限思，图史有馀清。\n露下濛花重，风来泛竹轻。\n何须嫌五斗，持此谢渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉中城楼 其一","author":"文同","text":"解带缓幽忧，登城复上楼。\n断烟横沔水，孤鹜入洋州。\n浩荡成遥望，凄凉起暮愁。\n山中自有桂，何事此淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉中城楼 其二","author":"文同","text":"藓径踏层斑，高林古木间。\n雁随平楚远，云共太虚闲。\n晚霭昏斜谷，晴阳露斗山。\n将身就清旷，名路尔何颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉州王氏林亭","author":"文同","text":"短彴疏篱入野扃，竹烟松露满襟清。\n奔湍激险飞寒响，弱蔓穿深挂晚英。\n惜去更观曾画壁，记来重注旧题名。\n门前便是红尘道，谁肯同过洗俗缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍","author":"文同","text":"园林晓气清，篱巷夕阳明。\n石窦闻寒碓，烟坡见晚耕。\n豚蹄供祷赛，龟壳问阴晴。\n欲识丰年乐，一村鸡犬声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石左藏挽诗二首 其一","author":"文同","text":"世泽传清范，戎韬演秘谋。\n雄藩未赐节，大壑忽移舟。\n谢氏胡床在，羊公羽扇收。\n光华归令子，何恨掩泉丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邛州东园晚兴","author":"文同","text":"公休时得岸轻纱，门外谁知吏隐家。\n斗鸭整群翻荇叶，乳乌无数堕松花。\n携琴秀野弹流水，设席芳洲咏落霞。\n向晚双亲共诸子，相将来此乐无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再送师厚","author":"文同","text":"久使西南此召还，鹿头东去渐云山。\n莫嫌策马经烧栈，正好题诗到散关。\n财利文书犹络绎，边防田地已朱殷。\n奇谋不吐将何用，况是归临咫尺颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘生","author":"文同","text":"历古推任侠，彼刘生者何。\n提槌击朱亥，引剑刺荆轲。\n饮肆扶头出，歌楼掉臂过。\n无人继义勇，关陇气消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吉祥院","author":"文同","text":"攲危一径通，下马转深丛。\n便是尘寰外，可怜烟坞中。\n修篁寒滴雨，老柏静吟风。\n日暮庭前树，归鸦自绕空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后溪晚步","author":"文同","text":"阴阴芳树暗回堤，路入蒙笼转野溪。\n泽雉应媒高复下，林鸦引子歇还啼。\n青蒲宛宛全淹水，紫笋斑斑半出泥。\n倚杖风前感时节，乱烟斜日一蝉嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕惠穆挽诗四首 其四","author":"文同","text":"自出公门下，常蒙礼意勤。\n相看如子姓，交政为郎君。\n每望中书入，俄惊远讣闻。\n何时高冢上，永日哭寒云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕惠穆挽诗四首 其三","author":"文同","text":"忆在南邛日，家君此忽亡。\n公时帅本道，力为济归丧。\n贱息将何报，深恩不可忘。\n如今每念及，惟有泪浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕惠穆挽诗四首 其二","author":"文同","text":"帝御皇图后，公居右府时。\n开陈诸议论，感发止嗟咨。\n自此倾宸眷，方将正宰司。\n胡为便沦谢，天意固难知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕惠穆挽诗四首 其一","author":"文同","text":"文靖登庸久，朝廷政教隆。\n相门无或议，子舍有如公。\n恩泽非徼幸，官荣悉治功。\n至今清论在，常满缙绅中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安仁道中早行","author":"文同","text":"行马江头未晓时，好风无限满轻衣。\n寒蝉噪月成番起，野鸭惊沙作队飞。\n揭揭酒旗当岸立，翩翩鱼艇隔湾归。\n此间物象皆新得，须信诗情不可违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻春","author":"文同","text":"马行如疾轮，十里去寻春。\n盎盎日光丽，鲜鲜云色新。\n楼台出花木，道路夹松筠。\n欲买前村酒，陶然作醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都杨氏江亭","author":"文同","text":"汀洲烟雨卷轻霏，遥望轩窗隐翠围。\n万岭西来供晓色，一江南下载晴晖。\n凫鸥惯入阑干宿，鱼蟹长随舴艋归。\n我亦旧多沧海思，几时如此得苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早晴至报恩山寺","author":"文同","text":"山石巉巉磴道微，拂松穿竹露沾衣。\n烟开远水双鸥落，日照高林一雉飞。\n大麦未收治圃晚，小蚕犹卧斫桑稀。\n暮烟已合牛羊下，信马林间步月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上主人","author":"文同","text":"客路逢江国，人家占画图。\n青林随远岸，白水满平湖。\n鱼小犹论尺，鸥轻欲问铢。\n何时遂休去，来此伴潜夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江原张景通善颂堂","author":"文同","text":"庭前云盖碧巉岩，堂上先生雪满髯。\n说药客来聊下榻，谒斋僧去便垂帘。\n种时法好花难谢，买处钱多石易添。\n子舍光荣身壮健，只将香火事华严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹阁","author":"文同","text":"回庑抱曾阁，萧然深且虚。\n画栏凭曲曲，高竹爱疏疏。\n尘滓外不到，衣襟清有馀。\n每来聊自适，幽意满琴书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹棕","author":"文同","text":"秀干扶疏綵槛新，琅玕一束净无尘。\n重苞吐实黄金穗，密叶围条碧玉轮。\n凌犯雪霜持劲节，遮藏烟雨长轻筠。\n此名未入华林记，谁念西南寂寞春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红树","author":"文同","text":"万叶惊风尽卷收，独馀红树拟禁秋。\n已疑断烧生前岭，更共残霞入远楼。\n枫岸最深霜未落，柿园浑变雨初休。\n劝君莫上青山道，妆点行人分外愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西轩秋日","author":"文同","text":"官舍萧然似隐居，一轩秋色伴恬如。\n深藏宿雨树木暗，高洒夕阳篱落疏。\n景物静思临水石，光阴闲觉入图书。\n此心只有云相信，长畔吟魂绕太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖","author":"文同","text":"丞相淹回地，光容满落晖。\n池塘存旧梦，城郭叹前非。\n烟霭阴晴出，凫鸥远近归。\n松风殊有意，犹欲下金徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观音院怪松","author":"文同","text":"怪松屡见无如此，每度来观说向僧。\n若遇风雷宜守护，恐生头角便飞腾。\n秋声绕殿随斋磬，夜影侵廊对佛灯。\n韦偃毕宏今不在，欲求人画有谁能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访李奂山人隐居","author":"文同","text":"多暇无所适，故来寻隐君。\n搴开压屋树，触散拥门云。\n状貌不妨古，言谈何太文。\n令人重高趣，归去每斜曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过友人溪居","author":"文同","text":"篱巷接菰蒲，闲扉掩自娱。\n水虫行插岸，林鸟过提壶。\n白浪摇秋艇，青烟盖晚厨。\n主人誇野饭，为我煮新芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过永寿县","author":"李石","text":"驱马上危坂，暮鞭摇客愁。\n峰峦惊满目，咫尺拟回头。\n红树映野店，白云藏县楼。\n须知此北下，地底见豳州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过高塶城","author":"文同","text":"颓壁乍高低，中间已乱蹊。\n长原想鹅鹳，大冢记鲸鲵。\n黯澹寒云结，萧疏野草齐。\n兴亡尽遗迹，立马看扶犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过禄氏山斋","author":"文同","text":"过水得凭槛，满川皆夕阳。\n江山逢胜绝，手笔恨荒唐。\n城郭蒙笼近，汀洲杳霭长。\n明朝又东去，尘土入衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余过兴州太守晁侯延之于东池晴碧亭且道其所以为此池亭之意使余赋诗","author":"文同","text":"郑谷题诗处，荒凉不复知。\n使君来问日，景物欲归时。\n崖巘供清溜，亭台绕翠漪。\n主人怜过客，借与傲炎曦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f