ance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张中允先生挽诗三首 其二","author":"文同","text":"乡校咨模范，闺门慕典刑。\n爱看高士传，欲注净名经。\n素节标家牒，芬情勒冢铭。\n近谁瞻碧落，应见少微星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张中允先生挽诗三首 其一","author":"文同","text":"善颂堂中客，华严会里人。\n生为天所祐，没与佛相亲。\n祖送逾千两，哀号动四邻。\n宜祠瑞筠社，永配蜀江神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张次公太博归阆中","author":"文同","text":"制诏频来试玉京，清途犹自滞豪英。\n策高三道竟何用，恩拜二亲方尔荣。\n嵇阮襟怀终旷达，仪秦才术本纵横。\n阆中胜事知无限，且向城南烂漫行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张林宗司勋挽诗三首 其三","author":"文同","text":"素节乡评重，清芬世阅传。\n谢家儿侄盛，穆宅弟兄贤。\n展矣兹良士，嗟乎不永年。\n西风寄哀调，愿为唱新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张林宗司勋挽诗三首 其二","author":"文同","text":"候骑排弓箙，牙门换戟衣。\n使麾方报入，神柩已云归。\n关吏惊来往，乡人叹是非。\n生平幽石在，谁为刻珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张林宗司勋挽诗三首 其一","author":"文同","text":"巫峡乘轺去，涪江拥节还。\n方来赴京兆，又出领潼关。\n髀肉川涂瘦，颠毛案牍斑。\n音容今遂已，清血为公潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张思孺秘校挽诗二首 其二","author":"文同","text":"人前常奉诧，张也好堂堂。\n处众谦和甚，居官志力强。\n当时君壮健，在座我苍浪。\n今日翻相哭，无言问彼苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张思孺秘校挽诗二首 其一","author":"文同","text":"昔在天彭郡，侨居过一冬。\n感君常见访，无日不相从。\n远寺携棋局，高亭把酒钟。\n谁知三载后，孤冢列新松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张道宗比部挽诗三首 其三","author":"文同","text":"忆在南岐日，于今十二年。\n宦途聊邂逅，宾馆重留连。\n正喜谋黄峒，俄惊葬圃田。\n无由执行绋，徒尔泪如泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张道宗比部挽诗三首 其二","author":"文同","text":"见说关西讣，危肠已似刀。\n抚膺成一恸，复魄遂三号。\n旧馆州名桂，新居里曰蒿。\n九泉休负恨，兰玉满儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张道宗比部挽诗三首 其一","author":"文同","text":"学富词章妙，才高志力强。\n帝方知可用，官欲渐难量。\n始得西原使，才终右省郎。\n念公今止此，无语问苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忘忧堂","author":"文同","text":"磴道循城近，垣墙占地幽。\n轩窗谁指画，砚席我优游。\n不许簿书到，恐为图史羞。\n此心元自适，何处欲忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李道士惠琴轩集 其一","author":"文同","text":"驱役精魂入大幽，满编奇绝尽冥搜。\n不教天地略容隐，应与鬼神同访求。\n海藏光芒开宝玉，羽林锋刃立戈矛。\n萧台自好携归去，莫向人间苦暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花","author":"文同","text":"仙杏一番新，妖饶洗露晨。\n待妆忧粉重，欲点要酥匀。\n月淡斜分影，池清倒写真。\n君须怜旧物，曾伴曲江春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨山人归绵竹","author":"文同","text":"一别江梅十度花，相逢重为讲胡麻。\n火铃未降真君宅，金钮曾盟太帝家。\n道气满簪凝绿发，神光飞鼎护黄芽。\n青骡不肯留归驭，又入无为咽晓霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨山人草堂","author":"文同","text":"九陇山人文父后，心闲身健两谁如。\n玉函经外传奇诀，画戟门前创隐居。\n入鼎灵丹黄似橘，隔墙凡境臭如帤。\n何时再到高楠下，倚遍清阴听道书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"运判南园瞻民阁","author":"文同","text":"青都高与紫霄通，独此危栏望不穷。\n万岭过云秋色里，一峰擎雪夕阳中。\n檐楹晓落天仓月，窗户晴吹石阙风。\n民吏安闲财赋足，管弦时复在层空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲乐","author":"文同","text":"昼睡忽过午，好风吹竹床。\n溪云生薄暮，山雨送微凉。\n粉裛衣裳润，兰薰簟席香。\n归来闲且乐，多谢墨君堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居秋日书事","author":"文同","text":"秋雨晚萧萧，端居闲寂寥。\n雀饥争朽穗，蝉病落寒条。\n云过茶烟没，风归砚水摇。\n惟当䛏图史，闲日底能消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居院上方晚景","author":"文同","text":"绕岩萦谷到禅扃，更上危颠最上亭。\n风搅乱鸦盘古木，雨催群鹭下寒汀。\n秋田沟垄如棋局，晚岫峰峦若画屏。\n诗已就成终夕去，远村灯火一星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲遣","author":"文同","text":"庭竹拥高丛，移床就好风。\n掩门休务外，隐几坐忘中。\n世事元何物，人心了即空。\n客来休借问，此意浩无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和张推官元夕","author":"文同","text":"山郡上元荣乐事，大开金地作遨场。\n烟云向晓谁教霁，灯烛乘春自有香。\n紫陌荧煌随步远，綵棚佳丽斗眉长。\n游人莫惜酬高直，买取银蟾一寸光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]