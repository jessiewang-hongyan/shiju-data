[{"title":"同年赵左藏挽诗 其三","author":"林希逸","text":"畴昔号宗英，嵚崎恨莫平。\n晚同蓍用数，早负榜中名。\n握手虽疏阔，惊心隔死生。\n白头慈母在，遥想若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽后村五首 其一","author":"林希逸","text":"九十非为寿，天胡夺此翁。\n两朝名法从，一世大宗工。\n集本家家有，囊封字字忠。\n老龙虽异宠，堪叹梦俄空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽后村五首 其二","author":"林希逸","text":"词源泉万斛，笔欲挽天河。\n诗比欧韩密，文追汉晋多。\n一生名皎皎，四入发皤皤。\n班不登书殿，伤哉可柰何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽后村五首 其三","author":"林希逸","text":"古来皆有死，身岂解千年。\n纵使能仙去，何如以集传。\n骑鲸乌石外，下马钓矶边。\n忍使斯文丧，凭谁问老天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽后村五首 其四","author":"林希逸","text":"云鬓登堂老，论文四十年。\n忆曾同宿处，说到未生前。\n精妙无双手，赓酬共几编。\n耽禅生笑我，去作海山仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽后村五首 其五","author":"林希逸","text":"筋力衰难强，伤心苦涕零。\n箧多留尺素，药仅致空青。\n传后吾何述，生前已自铭。\n帷堂才一恸，恨莫听讴铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拿舟","author":"林希逸","text":"傍晚拿舟入，身如在画图。\n石平疑削玉，湍急见跳珠。\n仙迹回还是，峰名转侧殊。\n竹间人指点，俱识有仙儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题西山","author":"曾宏正","text":"足倦尚跻攀，南来第一山。\n撑空列?嵂，拂阁耸孱颜。\n莫作炎山看，浑疑雁岩间。\n输他痴衲子，终老白云关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题南溪山","author":"曾宏正","text":"老仙乘白龙，飞入白云乡。\n岩前刻舟痕，游子常彷徨。\n清商韵风松，疑有笙鹤翔。\n我欲往从之，居然尘鞅缰。\n酒阑下山去，回首空慨慷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题浯溪","author":"曾宏正","text":"开元初政尽精明，岁晚色□□牝晨。\n胡雏养虎自遗患，马嵬□袜生战尘。\n幸哉有子系民志，宗祏将倾犹未坠。\n当时监国若□避，大物必归安与史。\n较轻量重法受恶，父子至情休责备。\n南内凄凉叶落时，尚胜公侯草间市。\n镂刻摹写皆瑰词，□□以颂而以规。\n我来解嘲千载后，□起九京共评之。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还珠洞","author":"曾宏正","text":"偻指重来二十春，系船犹记旧篙痕。\n飞鸿踏雪空留迹，随水浮萍那有根。\n摸索交游半为鬼，寻思往事黯消魂。\n天涯老泪空横睫，只欲归欤事灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题癸水亭","author":"曾宏正","text":"危亭倚岩隈，嘉名叶地谶。\n时浮桂籍香，永绝戈甲祲。\n败柳袅烟丝，枯荷立霜枋。\n呼僮理吴榜，月夕欲乘兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝阳岩","author":"娄续祖","text":"潇江岩上对朝阳，应有梧桐集凤凰。\n日暮碧云还未合，又看飞镜满清光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题永州淡岩","author":"娄续祖","text":"岩扃寂寂几经春，中有神仙隔世尘。\n不假栋梁为大厦，尽藏今古往来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"经浯溪作","author":"娄续祖","text":"□□□□□浯溪，来读元家颂德碑。\n遗□□□灵武事，□司徒□□□□。\n□□□复开元□，□□□□□□□。\n□□无罪闻宜戒，□□□□□□诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"候涛山","author":"应?","text":"闾尾苍茫四际同，嵬峨岩石奠城东。\n云连波白蒸鳌柱，月带潮青结蜃宫。\n夹树烟笼花气舞，半炉香映日光融。\n苍藤满砌依岚翠，应许乘槎贯斗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董孝子墓","author":"应?","text":"渺渺灵绪土，厥奥名黄杨。\n有汉董徵君，体魄厝其乡。\n人以孝而重，地以孝而扬。\n马鬣松楸里，悠悠思且长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金钱花","author":"章鉴","text":"巧冶都由造化炉，风磨雨洗好形模。\n花神果有神通力，买断春光用得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题大芦寺南山堂","author":"姚希得","text":"结屋临流老此身，溪头顾我更情亲。\n不于南墅多栽橘，只恐东坡解笑人。\n地窄虽无三径乐，心和赢得四时春。\n孤忠耿耿知何补，惟愿年丰作幸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗浮","author":"王胄","text":"传闻此山分蓬岛，锦绣青霞叠相向。\n飞云通天两绝奇，更出上界三峰上。\n凌乘汗漫不可得，倩谁图画丹青状。\n朝真学道走俗子，纪实留题出宗匠。\n何当步虚蹑太微，森列金庭五云仗。\n祇园琳宇出崔嵬，郁葱佳气天容开。\n回头却立睨人境，渺渺瘴雾驱氛埃。\n非惟此地相引领，叹我为尔胡为来。\n他年欲访经行处，请看姓字镵岩隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋刘敏叔画杨诚斋先生探梅图","author":"谢子强","text":"雪里梅花共月明，梅边杖屦一般清。\n江南此景人寂寞，抚卷悠然幽兴生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题御史袁公像","author":"丰芑","text":"先生独得考亭传，一脉斯文瑞应天。\n伯仲学成金玉质，父师道维孔颜□。\n四方翼戴倾冠盖，五代追崇接后先。\n天地钟英应有任，第为濂洛浚渊源。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢恩诗","author":"蔡仲龙","text":"圣朝兴运自天开，又直临轩策草莱。\n廷对自惭无宿构，胪传何意冠群魁。\n幸瞻北阙承殊宠，忍负南山咏有台。\n稽首君恩难报称，誓殚忠赤赞规恢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞","author":"何万里","text":"名山转阅转无穷，到此方知造化功。\n不被翠蛟收拾尽，又收飞玉入胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈氏书馆","author":"余天锡","text":"树阴分影过柴扉，马足车尘到亦稀。\n月下抱琴看鹤舞，阶前回首望云飞。\n兰边修谱香薰草，竹里搜诗翠湿衣。\n若坐小窗读周易，定忘春去与春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"捣药兔长生","author":"吴哲","text":"真水黄芽长，香风玉杵鸣。\n不为三窟计，永伴一轮明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊林和靖处士","author":"凌云","text":"孤山屹屹镇西湖，山上逋仙旧结庐。\n地僻真堪供隐逸，鹤驯全不费招呼。\n旌贤赐粟来天诏，踏雪寻梅入画图。\n留得遗祠表清德，斜阳古木自啼乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东山堂","author":"叶杲","text":"何处著诗癯，岩边有隐庐。\n云生春树合，鱼响夜潭虚。\n住久无他姓，山空应读书。\n平分谢池月，吾亦百年居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒题 其一","author":"叶杲","text":"县花初种已成林，三尺儿童父母心。\n堂上春风生意足，弦歌一曲尽清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒题 其二","author":"叶杲","text":"寻常巷陌燕徘徊，带得春风去不回。\n沧海连天云浪阔，寄将消息上蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒题 其三","author":"叶杲","text":"燕泥犹认旧柴扉，帘影玲珑度落晖。\n细数归期春早晚，一天风絮满池飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒题 其四","author":"叶杲","text":"小园日日管弦声，花落花开若有情。\n春色何时到侬屋，愁风愁雨过清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒题 其五","author":"叶杲","text":"桃李春风又一场，蹴毬墙外落花香。\n劝君莫道归期近，惟有临归日最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒题 其六","author":"叶杲","text":"鞦韆墙外入斜晖，过尽残花客不知。\n春色三分桃李去，一分犹在绿杨枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"陈瑄","text":"似嫌秦阁小，欲际楚天浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蕙岩登塔韵 其一","author":"郑起潜","text":"秋向空高分外澄，排云携手共梯登。\n举头便是蟾宫路，休问青霄有几层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蕙岩登塔韵 其二","author":"郑起潜","text":"巍倚浮图几曲栏，远山屏翠拥林端。\n鹏程便好乘风上，不管琼楼高处寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题渊明采菊图","author":"郑起潜","text":"闲却经纶手，东篱把菊枝。\n先生花外意，难画亦难诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题蜀道难图","author":"郑起潜","text":"蜀道难从古，于今分外难。\n江山风景在，忍把画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游七星岩和曾景亮同年","author":"赵崇垓","text":"地本乎阴窍本空，岩名以斗古传风。\n世人适意为行乐，造物何心著巧功。\n弱水蓬莱仙境界，石桥方广佛神通。\n达观不作尘寰看，笑挹天浆乐在中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游七星岩","author":"曾纯","text":"斗宿垂精插碧空，嵌岩太古石屏风。\n自然一道玲珑穴，谁见五丁开凿功。\n窦里乳泉时点滴，门前沥水暗流通。\n吾侪洞目崧台景，谢屐何曾到此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南园","author":"牟子才","text":"买家喜傍水精宫，正是南园故址中。\n我欲筑堂名六老，追还庆历太平风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宴江检详","author":"牟子才","text":"神螺卷雨入田畴，留得公堂一片秋。\n天上已催郎署去，人间难挽使华留。\n莫嫌仲举题舆晚，犹及东坡秉烛游。\n易在虎皮公在坐，试开宝箧为人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同张倅宴吴吉州","author":"牟子才","text":"新阳葭琯已浮灰，昨夜珠从合浦回。\n晓日鸾旂新竹契，春风龙炙古兰陔。\n青原别驾?丹酒，碧落仙人醉玉梅。\n来岁五更三点入，直迎红药看苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳祐七年丁未十一月朔蔡九轩自江东提刑归抵家时三馆诸公以风霜随气节河汉下文章分韵赋诗送别得河字","author":"牟子才","text":"群玉之峰千丈高，太微左宇凌星河。\n承明著作记仙室，汗青芸香老研磨。\n瀛洲学士水苍佩，清响戛击谐云和。\n我朝仁祖重兹选，涵养泽媲周菁莪。\n一时搜罗尽才杰，论事往往无讥诃。\n四贤景祐国之镇，肯为公议轻倒戈。\n当年枨触鼎鼐意，愿与希文同谪播。\n庆历一客伤众客，醉饱过耳宁有他。\n文符搜索网打尽，谣咏可但仇傲歌。\n古来馆阁有如此，劲气金石相荡摩。\n能令皇图耸天际，势与泰华并嵯峨。\n南箕贝锦半天下，翻作采葛伤谗多。\n视若弁髦如土梗，甚者足蹋鲸海波。\n吁嗟此意久不作，遗响近续应非讹。\n西山有孙剩文采，二十八宿心包罗。\n芳菲弥章楚骚蕙，硕大且俨陈陂荷。\n峨冠蓬岛两冰暑，凌溯迤逦风玉珂。\n俯而就之岂不可，议论乃欲降妖魔。\n纪纲一疏有奇气，几微半语驱沉疴。\n手披逆鳞触震电，心翼汉鼎扶羲娥。\n悠然群聩发深省，诵之穆若清风过。\n凤凰肯啄我伤粟，骐骥岂饫天山禾。\n殿头拜疏勇莫遏，指点归问烟江蓑。\n要津未若急流退，苞栩孰与考槃过。\n使乎六辔咏柔耳，清节人士歌五紽。\n之齐出昼有时义，去就大抵师丘轲。\n蹇予羁旅生也后，颉颃蜚佩应殊科。\n前时连章乞身去，夜梦栩栩思珉璠。\n天高不闻心转切，为人岂忍甘婆娑。\n斧奸心事忧国念，大略相似柯伐柯。\n君今询度我如执，啜其泣矣心谓何。\n君不见熙宁元祐国是易，未尝俯仰惟东坡。\n又不见绍圣更张罹祸惨，百折不挫称涪皤。\n世间富贵何足道，倏忽殆类赴烛蛾。\n妍者妩媚姿夭冶，轻儇佻巧甘媕阿。\n甜淡祇腥八九息，酣寝喧鸣奏鼓鼍。\n谏君超然独醒苏，回首万望蓬一窠。\n倘陪高风驾黄鹄，归傲泉石间壁梭。\n俯佣鱼钩晚获得，远寄或可酬清哦。\n疏桐缺月漏初断，鸿影缥缈还见么。\n他年邂逅谈旧事，抚掌一笑重呵呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雨怀述 其一","author":"牟子才","text":"懒把闲情去问花，花如含泪向天涯。\n二分春色已抛过，几处芳枝蹇未芽。\n羯鼓无功缘底事，莺梢已恨落谁家。\n门前杨柳黄犹淡，为问何时可暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雨怀述 其二","author":"牟子才","text":"把酒临风酹太和，春光九十已无多。\n四阳壮矣阴如此，万卉凄其愁奈何。\n不怕生成销铄尽，祇缘花信等闲过。\n欲将诗句勾晴色，南墅骚人制芰荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆丁大监 其一","author":"牟子才","text":"两朝表异诏言温，忠厚根基百世培。\n岳麓湖湘多秀气，玉杯繁露是奇才。\n词章近接秦而上，学术羞肩汉以来。\n事业元从儒者出，经纶之地自恢恢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆丁大监 其二","author":"牟子才","text":"三瑞堂前香燕凝，诗书一脉浸人心。\n韬峰不露全牛解，振鬣长嘶万马瘖。\n诸县屡丰公事少，期年未及去思深。\n减租除粟兴三学，人口如碑咏到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆丁大监 其三","author":"牟子才","text":"碧露犹馀不尽翰，文章少露豹林斑。\n身行襄蜀江淮外，名在龚黄召杜间。\n使传暂劳濡辔沃，帅幢已耸碧油闲。\n笑谈尽护风寒了，归踏春风辇路班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆丁大监 其四","author":"牟子才","text":"侯门六射喜从逢，今岁丰和夐不同。\n漕挽甫资萧相策，閟宫恰寿鲁僖功。\n鹤归动是三千岁，松梦终当十八公。\n愿举家风祝公寿，夜来已压小槽红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雷雨夜赋绝句","author":"蒋重珍","text":"电飞窗上明如月，雨溜檐前响过泉。\n蠢动有生皆发蛰，是龙那得不升天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题慧山","author":"蒋重珍","text":"龙山慧山两山云，出能为雨入为晴。\n云山之气有敛散，敛散之理斯为神。\n我庐山下为小隐，云为动兮山为静。\n悠然而出物之泽，屹然而峙地之镇。\n我见云山善与俱，云山无情不见余。\n我比云山多此见，不如一似云山无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题惠山","author":"蒋重珍","text":"妄虑散毛发，真源生齿牙。\n我闻甘露饭，即是惠山茶。\n欲驻岁月晚，重游道路遐。\n更须烦稚子，再煮鼎中花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐溪居万卷楼三首 其一","author":"蒋重珍","text":"小艇溪边月，来寻万卷楼。\n遂初读书处，鹤去白云留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐溪居万卷楼三首 其二","author":"蒋重珍","text":"剩有溪山树，书楼迹已陈。\n故人不可见，绕树一悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐溪居万卷楼三首 其三","author":"蒋重珍","text":"万壑注清流，孤烟起暮愁。\n龙山半溪落，雁影过书楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茶","author":"戴翼","text":"骚客辞眠肠正苦，睡魔退听骨先寒。\n未堪入饼供龙焙，且遣一旗登虎坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"棋 其一","author":"戴翼","text":"休将斤斧向般挥，杀处谁知有活机。\n我且双关聊自固，君无一眼漫相围。\n只能暗里龟头缩，怎识伊边虎口危。\n莫向人前誇己会，降旗几度送君归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"棋 其二","author":"戴翼","text":"部曲纵横听指挥，元来棋算即兵机。\n双关似铁吴坚壁，一著还魂汉解围。\n中垒占形包两陕，边隅拓土卷三危。\n一枰未罢兵书至，战退苻秦奏凯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠星术黄太史","author":"戴翼","text":"粤从太极生两仪，大明生东月生西。\n煌煌两日照今古，一昼一夜分主之。\n人具阴阳中造化，亦系日月之所舍。\n在日为命月为身，所主各随其昼夜。\n此数定不差毫毛，惜哉庸术其传讹。\n谈命以日不及月，日本昱昼如夜何。\n甘石不作今已矣，星学之精其能几。\n掌中日月分旦昏，独有黄生精算尔。\n黄生算到毫杪处，吉凶定如鼓应桴。\n奇哉此术真神秘，世人不知反为异。\n俗流何可轻与谈，吾有颍滨月轩记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁皇御舟","author":"黄洪","text":"龙舟大半没西湖，此是先皇节俭图。\n三十六年安静里，棹歌一曲在康衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳祐七年丁未十一月朔蔡久轩自江东提刑归抵家时三馆诸公以风霜随气节河汉下文章分韵赋诗得霜字","author":"黄洪","text":"恋阙心逾赤，乘轺鬓未霜。\n祇家将六学，综国劄三章。\n眷近花明路，风驰锦过乡。\n临分不成饮，相对独凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题忠毅姚公庙 其一","author":"林宋伟","text":"赤心许国自平时，见敌捐躯更不疑。\n权忌皋庸皆遁走，同时死难只青狮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题忠毅姚公庙 其二","author":"林宋伟","text":"农父犁田出宝刀，铜花浸血冷侵毛。\n神锋懔懔冲星斗，未让丰城剑气高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]