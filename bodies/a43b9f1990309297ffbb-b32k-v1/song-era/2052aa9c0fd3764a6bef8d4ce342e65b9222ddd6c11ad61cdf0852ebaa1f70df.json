[{"title":"诉愁","author":"朱淑真","text":"苦没心情只爱眠，梦魂还又到愁边。\n旧家庭院春长锁，今夜楼台月正圆。\n锦夜楼台双凤带，兽炉闲爇水沉烟。\n良辰美景俱成恨，莫问新年与旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"供愁","author":"朱淑真","text":"寂寂疏帘挂玉楼，楼头新月曲如钩。\n不须问我情深浅，钩动长天远水愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无寐二首 其一","author":"朱淑真","text":"吹彻云箫夜未赊，梨花带月映窗纱。\n休将往事思量遍，潋滟新愁乱似麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无寐二首 其二","author":"朱淑真","text":"背弹珠泪暗伤神，挑尽寒灯睡不成。\n卸却凤钗寻睡去，上床开眼到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酒醒","author":"朱淑真","text":"梦回酒醒嚼盂冰，侍女贪眠唤不应。\n瘦㾪江梅知我意，隔窗和月谩腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起二首 其一","author":"朱淑真","text":"起来不喜匀红粉，强把菱花照病容。\n腰瘦故知闲事恼，泪多只为别情浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起二首 其二","author":"朱淑真","text":"懒对妆台指黛眉，任他双鬓向烟垂。\n侍儿全不知人意，犹把梅花插一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清瘦","author":"朱淑真","text":"春花秋月若浮沤，怎得心如不系舟。\n肌骨大都无一把，可怜禁驾许多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闷书","author":"朱淑真","text":"泪粉匀开满镜愁，麝煤拂断远山秋。\n一痕心寄银屏上，不见人来竹叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"掬水月在手","author":"朱淑真","text":"无事江头弄碧波，分明掌上见嫦娥。\n不知李谪仙人在，曾向江头捉得么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弄花香满衣","author":"朱淑真","text":"艳红影里撷芳回，沾惹春风两袖归。\n夹路露桃浑欲笑，不禁蜂蝶绕人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浴罢","author":"朱淑真","text":"浴罢云鬟乱不梳，清癯无力气方苏。\n坐来始觉神魂定，尚怯凉风到坐隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宴谢夫人堂","author":"朱淑真","text":"竹引清风入酒卮，森森凉气暗侵肌。\n冰峦四叠浑无暑，不似人间六月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新春二绝 其一","author":"朱淑真","text":"雪从庾岭梅中尽，春向隋提柳上来。\n多少园林正萧索，纷纷争逐趁时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新春二绝 其二","author":"朱淑真","text":"黄宫阳气几潜伸，玉管吹灰适报春。\n天子只知农事重，躬耕端的为吾民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早春喜晴即事","author":"朱淑真","text":"山明雪尽翠岚深，天阔云开断翳阴。\n漠漠暖烟生草木，薰薰和气动园林。\n诗书遣兴消长日，景物牵情入苦吟。\n金鸭火残香阁静，更调商羽弄瑶琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春日妆成宜春花","author":"朱淑真","text":"青幡碧胜缕金文，柳色梅花逐指新。\n却笑尚为儿女态，宝刀剪綵强为春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春夜感怀","author":"朱淑真","text":"清江碧草两悠悠，各自风流一种愁。\n正是落花寒食夜，夜深无伴倚空楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日作","author":"朱淑真","text":"东风迤逦转南风，万物全归长养功。\n舜岂无心阜民俗，薰薰歌入五弦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暑月独眠","author":"朱淑真","text":"纱幮困卧日初长，解却红裙小罩凉。\n一篆炉烟笼午枕，冰肌生汗白莲香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暑夜","author":"朱淑真","text":"水亭相对已黄昏，静数飞萤过小园。\n窗下孤灯自明灭，无陶独自懒扃门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜有作","author":"朱淑真","text":"暑夕炎蒸著摸人，移床借月卧中庭。\n更深露下衣襟冷，梦到阳台不奈醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜乘凉","author":"朱淑真","text":"满意好风生水面，趁人明月到天心。\n此时情绪谁能会，独坐中庭夜已深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏枕自咏","author":"朱淑真","text":"夏日初长候，风棂暑夕眠。\n衣轻香汗透，睡重翠鬟偏。\n颦绿攒眉小，啼红上脸鲜。\n起来无个事，纤手弄清泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游湖归晚","author":"朱淑真","text":"恋恋西湖景，山头带夕阳。\n归禽翻竹露，落果响芹塘。\n叶倚风中静，鱼游水底凉。\n半亭明月色，荷气恼人香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西楼纳凉","author":"朱淑真","text":"小阁对芙蕖，嚣尘一点无。\n水风凉枕罩，雪葛爽肌肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日游水阁","author":"朱淑真","text":"淡红衫子透肌肤，夏日初长水阁虚。\n独自凭阑无个事，水风凉处读文书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日晚望","author":"朱淑真","text":"极目寒郊外，晚来微雨收。\n陇头霞散绮，天际月悬钩。\n一字新鸿度，千声落叶秋。\n倚楼堪听处，玉笛在渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日行","author":"朱淑真","text":"萧瑟西风起何处，庭前叶叶惊梧树。\n万物收成天地肃，田家芋栗初登圃。\n杳杳高穹片水清，一点秋雕翥云路。\n凄凄空旷雨初晴，凉飙动地收残暑。\n高楼玉笛应清商，天外数声新雁度。\n园林草木半含黄，篱菊黄金花正吐。\n池上枯杨噪晚蝉，愁莲蔌蔌啼残露。\n可怜秋色与春风，几度荣枯新复故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日偶题","author":"朱淑真","text":"芙蓉斜倚胭脂脸，岩桂轻摇金粟花。\n愁思不知秋浩荡，一鞭逸兴绕天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早秋偶笔","author":"朱淑真","text":"肃肃凉风至，凄然景骤清。\n雨馀残暑退，日落晚凉生。\n鹰隼双睛转，梧桐一叶惊。\n试听松竹里，万籁起秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕口占","author":"朱淑真","text":"三秋灵匹此宵期，万古传闻果是非。\n免俗未能还自笑，金针乞得巧丝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早秋有感","author":"朱淑真","text":"西风淅淅收残暑，庭竹萧疏报早秋。\n砌下黄昏微雨后，幽蛩唧唧使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋楼晚望","author":"朱淑真","text":"凉吹晚飕飕，芦花两岸秋。\n夕阳楼上望，独倚泪偷流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜舟行宿前江","author":"朱淑真","text":"扁舟夜泊月明秋，水面鱼游趁闸流。\n更作娇痴儿女态，笑将竿竹掷丝钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋夜家宴咏月","author":"朱淑真","text":"九秋三五夕，此夕正秋中。\n天意一夜别，人心千古同。\n清光消雾霭，皓色遍高空。\n愿把团圆盏，年年对兔宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋夜不见月","author":"朱淑真","text":"不许蟾蜍此夜明，始知天意是无情。\n何当拔去闲云雾，放出光辉万里清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋月","author":"朱淑真","text":"杳杳长空敛雾烟，冰输都胜别时圆。\n风传漏报天将晓，惆怅婵娟又隔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋玩月","author":"朱淑真","text":"独占秋光盛，天工信有偏。\n清晖千里共，皓魄十分圆。\n兔影寒犹弄，蟾蜍老更坚。\n只愁看未足，一去又轻年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上咏月","author":"朱淑真","text":"清宵三五凉风发，湖上闲吟步明月。\n涓涓流水浅又清，皎洁长空纤霭灭。\n水光月色环相连，可怜清景两奇绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜感怀","author":"朱淑真","text":"满院含秋思，蟾辉映一方。\n蛩吟喧曲砌，鸟宿傍回塘。\n木落桐应瘦，宵寒漏正长。\n安仁闲感慨，徒尔鬓苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小阁秋日咏雨","author":"朱淑真","text":"疏雨洗高穹，潇潇滴井桐。\n润烟生砚底，凉气入堂中。\n翠锁交竿竹，红翻落叶枫。\n抚琴闲弄曲，静坐理商宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日得书","author":"朱淑真","text":"秋风本无意，愁思自难禁。\n共月伤千里，来书胜万金。\n代骝惊北吹，越鸟恋南林。\n已有归宁约，何须惜岁阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋深偶作","author":"朱淑真","text":"生杀循环本自然，可堪肃肃出乎天。\n休嗟物理易彫瘁，好看西成报有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮秋","author":"朱淑真","text":"潇潇风雨暗残秋，忍见黄生满径幽。\n恰似楚人情太苦，年年对景倍添愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新冬","author":"朱淑真","text":"日一北而万物生，始知天意在收成。\n愚民未论祁寒理，往往相为嗟怨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霜夜","author":"朱淑真","text":"彤云黯黯暮天寒，半卷珠帘未欲眠。\n独坐小窗无伴侣，可怜霜月向人圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探梅","author":"朱淑真","text":"温温天气似春和，试探寒梅已满坡。\n笑折一枝插云鬓，问人潇洒似谁么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观雪偶成","author":"朱淑真","text":"凭阑观雪独徘徊，欲赋惭无咏絮才。\n盐撒空中如可用，收藏聊与赠羹梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏雪","author":"朱淑真","text":"六出飞花四面来，连山连水皓皑皑。\n玲珑天地苍茫合，的皪园林烂漫开。\n庾岭腊梅寒散乱，章台风柳絮萦回。\n自言空有孤吟癖，览景惭无谢氏才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪夜赓笔","author":"朱淑真","text":"夜雪飞花似月明，交连寒影透门庭。\n只宜挟策临窗坐，免用辛勤更聚萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上雪霁","author":"朱淑真","text":"江水冰消起绿鳞，川原荡涤少烟尘。\n风吹南北溪桥畔，柳色参差欲漏春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赏雪","author":"朱淑真","text":"朱帘暮卷绮筵开，风雪纷纷入酒杯。\n对景恨无飞絮句，从今羞见谢娘才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"围炉","author":"朱淑真","text":"昨夜霜风透胆寒，围炉漫意昔年欢。\n如今独坐无人说，拨闷惟凭酒力宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海棠","author":"朱淑真","text":"天与娇娆缀作花，更于枝上散馀霞。\n少陵漫道多诗兴，不得当时一句誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芍药","author":"朱淑真","text":"芬芳红紫间成丛，独占花王品第中。\n到底只留为谑赠，更劳国史刺民风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牡丹","author":"朱淑真","text":"娇娆万态逞殊芳，花品名中占得王。\n莫把倾城比颜色，从来家国为伊亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄芙蓉","author":"朱淑真","text":"如何天赋与芬芳，徒作佳人淡伫妆。\n试倩东风一为主，轻黄应不让姚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔷薇花 其一","author":"朱淑真","text":"飞葩散乱拥栏香，万朵千枝不计行。\n烂漫初开向清昼，会稽太守乍还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樱桃","author":"朱淑真","text":"为花结实自殊常，摘下盘中颗颗香。\n味重不容轻众口，独于寝庙荐先尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花二首 其一","author":"朱淑真","text":"园林萧索未迎春，独尔花开处处新。\n只有官娃无一事，每将施额斗妆匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花二首 其二","author":"朱淑真","text":"消得骚人几许时，疏篱淡月著横枝。\n破荒的皪香随马，春信先教驿使知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"直竹","author":"朱淑真","text":"劲直忠臣节，孤高列女心。\n四时同一色，霜雪不能侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荷花","author":"朱淑真","text":"暑气炎炎正若焚，荷花于此见天真。\n香房馥郁随风拆，笑脸妖娆映水新。\n间叶浅深殷似点，满池繁媚丽于春。\n年年占得馀芳在，几见当时步步人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"腊月踯躅一枝独开","author":"朱淑真","text":"园林经腊正彫残，独尔花开烂漫鲜。\n借问陇梅知幸否，得陪春卉共时妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乞兰","author":"朱淑真","text":"幽芳别得化工栽，红紫纷纷莫与偕。\n珍重故人培养厚，真香独许寄庭阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"项羽二首 其一","author":"朱淑真","text":"自古兴亡本自天，岂容人力预其间。\n非凭天与凭骓逝，骓不前兮战已闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"项羽二首 其二","author":"朱淑真","text":"盖世英雄力拔山，岂知天意在西关。\n范增可用非能用，徒叹身亡顷刻间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韩信","author":"朱淑真","text":"男儿忍辱志长存，出胯曾无怨一言。\n漂母人亡石空在，不知还肯念王孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张良","author":"朱淑真","text":"功成名遂便归休，天道分明不与留。\n果可人间恋驹隙，何心愿学赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆贾","author":"朱淑真","text":"汉方扰扰袭秦风，勇士相高马上功。\n惟有君侯守奇节，能将新语悟宸衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贾生","author":"朱淑真","text":"文帝为君固有馀，岂容流涕复长吁。\n单于可击非无策，表饵陈来术已疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董生","author":"朱淑真","text":"秦火经来道失真，下帷发愤每劳神。\n谁知异日为无得，只听平津一老臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晁错","author":"朱淑真","text":"七国绵延蔓草图，一言请削独干诛。\n扬雄自负功名志，犹罪当时太失愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘向二首 其一","author":"朱淑真","text":"洽闻博识似君难，况复腾凌宗室间。\n屡谏不容甘畎亩，七侯同日亦何颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘向二首 其二","author":"朱淑真","text":"王氏滔天擅国权，可堪恭显厕其间。\n屡形天谴君非悟，徒使宗臣每犯颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王氏必兴轩","author":"朱淑真","text":"福有根基善有源，必兴缘此敞新轩。\n埋蛇入相真堪慕，屠狗封侯岂足论。\n未必芝兰偏谢砌，好看车马集于门。\n从来天报无先后，不在其身在子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]