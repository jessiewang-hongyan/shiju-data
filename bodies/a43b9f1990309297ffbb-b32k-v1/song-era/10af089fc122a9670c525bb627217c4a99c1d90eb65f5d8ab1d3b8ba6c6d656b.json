[{"title":"上帅漕闵雨十首 其六","author":"彭龟年","text":"白粲十万艘，日夜随东流。\n常平贯虽朽，还作苏民不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其五","author":"彭龟年","text":"豪家低昂心，常对时亏盈。\n卓氏一窖粟，杀人视长平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其三","author":"彭龟年","text":"一冤旱三年，此理乃无欺。\n乖和自相召，天意容何私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其一","author":"彭龟年","text":"天子治平切，一贤远王畿。\n朝廷岂不重，赤子贫无依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为张氏题秀盘阁","author":"彭龟年","text":"扶舆磅礴满清虚，未必山川独有馀。\n欲识秀盘无尽处，吟风弄月得吾初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝输租","author":"彭龟年","text":"佃氓输课稍逡巡，排日呼来不厌频。\n认取私家催米意，莫憎门外督租人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王文伯将校艺漕闱过我取别肯作一夕饮酒竟犹子留之西斋厥明文伯有诗敬赓原韵","author":"彭龟年","text":"已闻鼓箧无秦锐，肯为论文学贾留。\n夺我清风俄顷尔，梦回真若隔三秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘宗元索余赋愚谷古人以愚自命及命人者多矣余不暇辨姑以二绝言愚之理云 其二","author":"彭龟年","text":"命谷为愚谷曰愚，人心难似谷心虚。\n夫君若踏归愚路，坐断人间毁与誉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其十","author":"彭龟年","text":"欲颂公侯学鲁人，怕冲大尹罢长吟。\n亦知已有长生诀，四益斋中四益箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其九","author":"彭龟年","text":"鲰生何幸倚门墙，千里崎岖入帝乡。\n赢得菊花?寿酒，今年又近一重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其八","author":"彭龟年","text":"翁儿一笑大欢足，鸡犬不惊仁意多。\n欲得使君真实谛，直须堂外识中和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其七","author":"彭龟年","text":"湖面拨开双眼翳，湖头拔立一堤金。\n先生能事真如此，捍涤群邪即此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其六","author":"彭龟年","text":"弹压殊非翼翼商，藉公惠养破天荒。\n从今若说京都政，不数前张数后张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其五","author":"彭龟年","text":"天府何为屈我公，谩将烦处压才雄。\n若兼二辅亦可了，万化斡旋犹有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其四","author":"彭龟年","text":"纳湖千顷自源流，淡淡春风百尺楼。\n尽出诗书到功业，只今天下瞩君侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其三","author":"彭龟年","text":"四百山河朝帝京，紫岩有志未全伸。\n知公久抱中原略，日日搜罗度外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其二","author":"彭龟年","text":"尽心堂上得心传，妙处机缄共一天。\n玉骨冰姿更相似，黑头只欠著貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张京尹十首 其一","author":"彭龟年","text":"岷山斗险介巴江，天地精神此晦藏。\n已发峨眉清一段，公家父子又相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王弱翁七首 其七","author":"彭龟年","text":"地熟桑麻易，村深气象醇。\n此行真不恶，今日似阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王弱翁七首 其六","author":"彭龟年","text":"霜螯百镒重，人世一身多。\n我意已凄惨，如君风味何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王弱翁七首 其五","author":"彭龟年","text":"晓日开屏障，篮舆行画图。\n融融万物表，此处是规模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王弱翁七首 其四","author":"彭龟年","text":"浓淡云山色，抑扬风水声。\n体中有佳处，不是喜双清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王弱翁七首 其三","author":"彭龟年","text":"漏恩馀草木，苛敛察箕头。\n犹有形骸碍，谁为根本忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王弱翁七首 其二","author":"彭龟年","text":"猫头争立玉，黄雀剩披绵。\n橘子生犹绿，江南十月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王弱翁七首 其一","author":"彭龟年","text":"不作画梁燕，定非幽谷莺。\n此心无著物，万事莫留名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和向大夫坐韵","author":"彭龟年","text":"道义交情不用盟，鸣谦肯作震雷惊。\n论功平勃非吾事，付与人间仔细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和安成彭清老五首 其五","author":"彭龟年","text":"公馀几上诗书乱，事简庭中雁鹜休。\n乞我新篇洗凡俗，萧萧风雨打窗秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和安成彭清老五首 其四","author":"彭龟年","text":"里中诸老皆公识，破戒相过问故人。\n顾我那能来重客，知公不薄少年新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和安成彭清老五首 其三","author":"彭龟年","text":"铿锵金石三千首，吐纳云烟四十年。\n自有山神回俗驾，不愁大尹触吟鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和安成彭清老五首 其二","author":"彭龟年","text":"闭户长吟何水曹，人间富贵九牛毛。\n博山一缕清香永，馀子不知更几刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和安成彭清老五首 其一","author":"彭龟年","text":"山有乔松隰有台，胸中日月太平开。\n安车不入申公念，祇恐诏从天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寿冈杨先生上丁四首 其四","author":"彭龟年","text":"竹暗横窗日已曛，我方酣寝学羊欣。\n银钩铁画应无限，乞取先生一练裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寿冈杨先生上丁四首 其三","author":"彭龟年","text":"未识平时活国方，只将诗句阅风光。\n盘空笔力今谁敌，独扫千人不可当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寿冈杨先生上丁四首 其二","author":"彭龟年","text":"书窗兀兀到斜曛，羊胛烹来我亦欣。\n莫讶广文官独冷，水光一抹当罗裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寿冈杨先生上丁四首 其一","author":"彭龟年","text":"礼成绵蕝固遐方，揭此威仪日月光。\n他日抗章论祀事，贤侯不减汉平当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张宪吴园山居二首 其二","author":"彭龟年","text":"参天乔木镇山川，栽种成阴知几年。\n仰止名园今老矣，卷舒画轴思悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张宪吴园山居二首 其一","author":"彭龟年","text":"轻辞绿野逐征夫，踏遍溪山总不如。\n莫爱画图尝在眼，渠侬还亦爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐思叔谢向大夫惠柑四首 其四","author":"彭龟年","text":"养生未得仙人术，治病徒寻药裹题。\n安得从公橘中隐，细论火枣与交梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐思叔谢向大夫惠柑四首 其三","author":"彭龟年","text":"作诗浑似谭经戴，夺尽从头席几重。\n文木一经题品后，虚名不数大夫封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐思叔谢向大夫惠柑四首 其二","author":"彭龟年","text":"满满风霜味正肥，厥包万里逐雕题。\n封君莫羡传柑宠，清爽何如楂与梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐思叔谢向大夫惠柑四首 其一","author":"彭龟年","text":"萱草堂中乐泄融，豪家异味可能重。\n政惭陆子怀无橘，锡类那知有颍封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉州詹守五首 其五","author":"彭龟年","text":"柏移平地失崎岖，培壅恩深报一无。\n惟有依归意难尽，不堪㶁㶁水循渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉州詹守五首 其四","author":"彭龟年","text":"乌龙山下晓风轻，白鹭洲前暮霭凝。\n今日可能如昨日，庐陵还解似严陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉州詹守五首 其三","author":"彭龟年","text":"骨鲠嘉言忆旧臣，故应赴诏近严宸。\n席前若下清明问，且说江南一味贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉州詹守五首 其二","author":"彭龟年","text":"谏垣礼乐三千疏，窗下诗书六十年。\n莫讶勾吴留不住，解随膏雨到江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉州詹守五首 其一","author":"彭龟年","text":"平生两耳熟龚黄，今日身亲识大方。\n太史若徵循吏传，一篇气脉在耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其十","author":"彭龟年","text":"好风佳月满襟怀，尝到先生丈室来。\n今日忽为江海别，此心肯逐晚潮回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其九","author":"彭龟年","text":"革履如今远帝庐，眼前忧念总区区。\n黄钟一气元来在，安得先生起亚夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其八","author":"彭龟年","text":"从此褰帷去帝乡，闾阎辛苦足平章。\n皂囊若有新丰奏，才过龙团第一纲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其七","author":"彭龟年","text":"东西一节大江边，来往勤民亦有年。\n未必米盐劳试守，更从根本得深研。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其六","author":"彭龟年","text":"直节亭亭屹不流，冲然襟度更休休。\n世间多少难平事，可惜先生不少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其五","author":"彭龟年","text":"一贤去国四方嗔，却恐猜疑到玉宸。\n急把丐閒书报下，此行犹足律贪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其四","author":"彭龟年","text":"春来苦雪夏来寒，南去愁霖北去乾。\n又报丰年无一事，乞身远去可能安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其三","author":"彭龟年","text":"闻上金华劝讲班，启心长是片言间。\n一从元祐诸公后，得此渊源自玉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其二","author":"彭龟年","text":"亲奉王明御六龙，合登宰路冠诸公。\n未应天子青宫友，犹滞黄幡豹尾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑尚书守建安十首 其一","author":"彭龟年","text":"自从秉节簉明廷，谠论忠言四海倾。\n何事不关天下念，此心无著世间名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其八","author":"彭龟年","text":"手弓皆是虎狼才，巡徼宁无去复来。\n倏去倏来无滞迹，蝗螟虽过不为灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其七","author":"彭龟年","text":"作尉之难似胗尸，一生一死总吾为。\n是心倘有分毫歉，脱手翻车悔莫追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其六","author":"彭龟年","text":"血气谁无未免争，腰牛公牍角蜗情。\n半非半是先须识，但要吾心似水平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其五","author":"彭龟年","text":"椎牛酌酒是民顽，明约科条墟里间。\n若更宽他衣食路，桑间陌上自闲闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其四","author":"彭龟年","text":"若见村中小校师，教将义理训童儿。\n四端五品人人有，莫道冥顽不与知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其三","author":"彭龟年","text":"催科莫作扰人看，趁此登场早了官。\n坐视贪残败吾子，不如自放一分宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其二","author":"彭龟年","text":"圣朝宽令捷惊霆，尉不留心竟不行。\n万事闿端皆在我，安危便可到苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐仲洪尉南安八首 其一","author":"彭龟年","text":"仲洪作尉南安县，示我西园药石辞。\n莫道近民民易扰，官清民近更相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵通判五首 其五","author":"彭龟年","text":"霜风猎猎寒无奈，江水漫漫去莫留。\n欲讯音容无定在，松筠竦竦暮烟浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵通判五首 其四","author":"彭龟年","text":"向来三叠泣阳关，犹望归来肯自宽。\n今日重过更席处，却思人世别离难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵通判五首 其三","author":"彭龟年","text":"风波要自吾心定，泾渭从渠何日分。\n公已著身荣辱外，世间馀子自纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵通判五首 其二","author":"彭龟年","text":"春风千里下屏星，荆棘丛中稻眼青。\n凋瘵已肥身已瘠，丹砂还解此公灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵通判五首 其一","author":"彭龟年","text":"弦歌到处即熙然，桑柘青含淡淡烟。\n肯倩奇花树民怨，为人岁岁作春妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢刘大权为寿","author":"彭龟年","text":"凉月纷纷弄綵衣，桑弧蓬矢拂庭闱。\n不因妙语从君得，何事茅檐星斗稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其十六","author":"彭龟年","text":"捧檄为亲喜，拖绅岂我荣。\n若谋妻与子，宁不愧何平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其十五","author":"彭龟年","text":"冬月不启壁，深虑惊蛰虫。\n物方全性命，如我爱吾宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其十四","author":"彭龟年","text":"物害须当去，无为煦煦仁。\n可怜永某氏，爱鼠却伤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其十三","author":"彭龟年","text":"好毁非佳士，毋轻听彼言。\n如人名父母，急去不须闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其十二","author":"彭龟年","text":"我身何自有，毫发自亲来。\n身且非吾物，何论身外财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其十一","author":"彭龟年","text":"七情随物感，惟怒最难平。\n我若能忘物，如雷动太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其十","author":"彭龟年","text":"为利较锱铢，真成小丈夫。\n脂肥不满腹，罪已塞堪舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其九","author":"彭龟年","text":"宿怨养痈疽，终须殒此躯。\n若能忘物我，天下尽平衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]