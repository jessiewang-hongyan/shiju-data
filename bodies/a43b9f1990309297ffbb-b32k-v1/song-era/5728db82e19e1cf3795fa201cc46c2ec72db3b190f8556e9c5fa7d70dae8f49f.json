[{"title":"索胡学圣诗","author":"欧阳守道","text":"为候君诗十日留，无诗何以别交游。\n自缘白雪难于和，莫把明珠暗处投。\n往施固惭三不报，此鸣傥许两相酬。\n今番但挈空囊去，湘水湘山段段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为琛上人题","author":"欧阳守道","text":"今日有心还有累，当来无窄亦无宽。\n难将世事眉双皱，尽付尘缘指一弹。\n烦恼不从生处有，应酬都向梦中看。\n不知向去宽多少，万里秋空孤月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓雪歌","author":"欧阳守道","text":"上天同云兮雨雪其霏，之子于钓兮在水之湄。\n鱼潜于渊兮不可求思，泌之洋洋兮可以乐饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题兴善院净师月岩图","author":"欧阳守道","text":"君不见长安市，扰扰行人如聚蚁。\n不惟贾客与廛民，往往冠绅大夫士。\n投身闹处思山林，欲归未归长苦心。\n夜深灯火如白昼，呕哑弦管喧繁音。\n孤客欲眠眠不得，四更五更人暂息。\n忽然车毂鸣枕中，百官朝早传呼亟。\n我时起坐一喟然，推窗孤月方流天。\n嗟哉市朝不知夜，挹此清景何由缘。\n归求重觅麋鹿伴，尘劳馀业犹羁绊。\n高僧过我出画图，月照岩心僧仰看。\n有岩有月尽佳哉，僧叉不俗何方来。\n此岩岂是南海观，不然五台峨眉雁荡与天台。\n岩空月圆僧静坐，不用话头劳勘破。\n人言腰钱骑鹤上扬州，何如岩中月下从僧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刻石","author":"欧阳庆甫","text":"地僻人稀能几家，清泉漱玉石攲斜。\n客来访我惭无具，洗甑炊香更点茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游金庭观","author":"欧阳建世","text":"右军平昔爱观鹅，尚有池塘聚渌波。\n但见当时尘迹在，徘徊终日对嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又寄许道人","author":"欧阳修","text":"绿发方瞳瘦骨轻，飘然乘鹤去吹笙。\n郡斋独坐风生竹，疑是孙登长啸声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三桥诗 飞盖","author":"欧阳修","text":"鸣驺入远树，飞盖渡长桥。\n水阔鹭双起，波明鱼自跳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三桥诗 宜远","author":"欧阳修","text":"朱栏明绿水，古柳照斜阳。\n何处偏宜望，清涟对女郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小池","author":"欧阳修","text":"深院无人锁曲池，莓苔绕岸雨生衣。\n绿萍合处蜻蜓立，红蓼开时蛱蝶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小桃","author":"欧阳修","text":"雪里花开人未知，摘来相顾共惊疑。\n便当索酒花前醉，初见今年第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山斋戏书绝句二首 其二","author":"欧阳修","text":"经春老病不出门，坐见群芳烂如雪。\n正当年少惜花时，日日春风吹石裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山斋戏书绝句二首 其一","author":"欧阳修","text":"蜜脾未满蜂采花，麦垄已深鸠唤雨。\n正是山斋睡足时，不觉花间日亭午。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上默诵圣俞诗有感","author":"欧阳修","text":"兴来笔力千钧劲，酒醒人间万事空。\n苏梅二子今亡矣，索寞滁山一醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋不见月问客","author":"欧阳修","text":"试问玉蟾寒皎皎，何如银烛乱荧荧。\n不知桂魄今何在，应在吾家紫石屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰乐亭游春三首 其二","author":"欧阳修","text":"春云淡淡日辉辉，草惹行襟絮拂衣。\n行到亭西逢太守，篮舆酩酊插花归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰乐亭游春三首 其一","author":"欧阳修","text":"绿树交加山鸟啼，晴风荡漾落花飞。\n鸟歌花舞太守醉，明日酒醒春已归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰乐亭游春三首 其三","author":"欧阳修","text":"红树青山日欲斜，长郊草色绿无涯。\n游人不管春将老，来往亭前踏落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"井桐","author":"欧阳修","text":"檐攲碧瓦拂倾梧，玉井声高转辘轳。\n肠断西楼惊稳梦，半留残月照啼乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日长偶书","author":"欧阳修","text":"日长渐觉逍遥乐，何况终朝无事人。\n安得遂为无事者，人间万虑不关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月","author":"欧阳修","text":"天高月影浸长江，江阔风微水面凉。\n天水相连为一色，更无纤霭隔清光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木芙蓉","author":"欧阳修","text":"种处雪消春始动，开时霜落雁初过。\n谁栽金菊丛相近，织出新番蜀锦窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牛","author":"欧阳修","text":"日出东篱黄雀惊，雪销春动草芽生。\n土坡平慢陂田阔，横载童儿带犊行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家","author":"欧阳修","text":"绿桑高下映平川，赛罢田神笑语喧。\n林外鸣鸠春雨歇，屋头初日杏花繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白牡丹","author":"欧阳修","text":"蟾精雪魄孕云荄，春入香腴一夜开。\n宿露枝头藏玉块，晴风庭面揭银杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"休逸台","author":"欧阳修","text":"清谈终日对清樽，不似崇高富贵身。\n已有山川资胜赏，更将风月醉嘉宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再至汝阴三绝 其二","author":"欧阳修","text":"十载荣华贪国宠，一生忧患损天真。\n颍人莫怪归来晚，新向君前乞得身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再至汝阴三绝 其一","author":"欧阳修","text":"黄栗留鸣桑葚美，紫樱桃熟麦风凉。\n朱轮昔愧无遗爱，白首重来似故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再至汝阴三绝 其三","author":"欧阳修","text":"水味甘于大明井，鱼肥恰似新开湖。\n十四五年劳梦寐，此时才得少踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后潭游船见岸上看者有感","author":"欧阳修","text":"喧喧谁暇听歌讴，浪绕春潭逐綵舟。\n争得心如汝无事，明年今日更来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答仲仪口号","author":"欧阳修","text":"弊居回看如蛙穴，华宇来栖若燕身。\n敢望笙歌行乐事，只忧无米过来春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠丁判官","author":"欧阳修","text":"西陵江口折寒梅，争劝行人把一杯。\n须信春风无远近，维舟处处有花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行赠雁","author":"欧阳修","text":"云间征雁水间栖，矰缴方多羽翼微。\n岁晚江湖同是客，莫辞伴我更南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自河北贬滁州初入汴河闻雁","author":"欧阳修","text":"阳城淀里新来雁，趁伴南飞逐越船。\n野岸柳黄霜正白，五更惊破客愁眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自勉","author":"欧阳修","text":"引水浇花不厌勤，便须已有镇阳春。\n官居处处如邮传，谁得三年作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行云","author":"欧阳修","text":"叠叠烟波隔梦思，离愁几日减要围。\n行云自亦伤无定，莫就行云托信归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行次寿州寄内","author":"欧阳修","text":"紫金山下水长流，尝记当年此共游。\n今夜南风吹客梦，清淮明月照孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖戏作示同游者","author":"欧阳修","text":"菡萏香清画舸浮，使君宁复忆扬州。\n都将二十四桥月，换得西湖十顷秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观鱼轩","author":"欧阳修","text":"当年下泽驱羸马，今见犀兵拥碧油。\n位望愈隆心愈静，每来临水玩游鯈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过中渡二首 其二","author":"欧阳修","text":"得归还自叹淹留，中渡桥边柳拂头。\n记得来时桥上过，断冰残雪满河流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过中渡二首 其一","author":"欧阳修","text":"中渡桥边十里堤，寒蝉落尽柳条衰。\n年年塞下春风晚，谁见轻黄弄色时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过塞二首","author":"欧阳修","text":"身驱汉马踏胡霜，每叹劳生祗自伤。\n气候愈寒人愈北，不如征雁解随阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋普明寺竹林小饮饯梅圣俞分韵得亭皋木叶下五首 其五","author":"欧阳修","text":"山水日已佳，登临同上下。\n衰兰尚可采，欲赠离居者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192