[{"title":"题飞霞亭","author":"赵蕃","text":"处处江边阁，悠悠客子诗。\n欲知岁不与，验取鬓中丝。\n风雨凄其作，江山益尔奇。\n怜渠不解语，有恨莫能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东台寺","author":"赵蕃","text":"日日东台寺，今朝一苇杭。\n不关公事了，政以病躯妨。\n大士迁居梦，寒炉得圣香。\n世人空自异，吾道本何方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题旧日所藏晋陶渊明采菊东篱下悠然见南山画","author":"赵蕃","text":"未必形模似，良由意象高。\n见山非得得，遇酒辄陶陶。\n芜没念三径，飘零悲二毛。\n南征傥亡恙，归老旧蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题白龙洞三首 其三","author":"赵蕃","text":"俞君昔行倦，曾此见留题。\n丘壑胸中具，烟云笔下跻。\n如闻在干越，复道走江西。\n使我登临处，依依独杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题白龙洞三首 其二","author":"赵蕃","text":"瘦竹依奇石，流清照古梅。\n那知道傍舍，遽绝眼中埃。\n肯惮巾冲雨，深防屐破苔。\n病来无脚力，一为上崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题白龙洞三首 其一","author":"赵蕃","text":"循除初㶁㶁，出谷重潺潺。\n骤或鸣琴瑟，幽疑杂佩环。\n茶经不载陆，瓢饮合居颜。\n借问龙君事，异辞纷莫删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题龙州亭","author":"赵蕃","text":"亭自君家筑，洲从何代名。\n诸公多好句，老子敢争衡。\n剩欲危栏倚，少须春草生。\n毋庸为鲈去，聊欲赴鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘正之所得绵州摹本画鹰","author":"赵蕃","text":"姿态何雄杰，盘拿更崛奇。\n曾闻左绵画，旧熟少陵诗。\n说似殊方寄，还容老眼窥。\n君手速收卷，燕雀恐惊疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题毕叔文所藏赵祖文画","author":"赵蕃","text":"数月湖山路，未看湖上山。\n尘埃苦相败，疾病亦多关。\n见此微茫画，如行惨澹间。\n小舟帆正饱，何日载余还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江贯道江行晚日图","author":"赵蕃","text":"霞尾千山赤，云腰几树连。\n若非彭蠡正，当是洞庭偏。\n岁月惊飞鸟，功名忆堕鸢。\n开图若有感，归思忽无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题重脩玉光亭","author":"赵蕃","text":"山无古今异，亭有废兴因。\n地迥轮蹄隔，官閒鸥鸟驯。\n仆碑还屋壁，老柳困樵薪。\n载酒论文处，重来感叹频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题重脩堆胜楼","author":"赵蕃","text":"白鹭洲前堆胜楼，相望前后几监州。\n枝梧合付陶谢手，啸傲亦须嵇阮流。\n怪得江山还旧观，只应栏槛有新脩。\n登临愧我焉能赋，假日空成半日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题堂前梅花","author":"赵蕃","text":"废宅委尘埃，梅花亦自开。\n九泉无起日，双鬓有新摧。\n索莫生何理，飘零句易哀。\n若为归去晚，茅屋老苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梅山","author":"赵蕃","text":"望觉林峦合，行知陇亩分。\n转亭桥跨壑，入寺阁连云。\n薪水僮奴事，经禅长少勤。\n令人生爱敬，何止息尘氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题堪隐","author":"赵蕃","text":"考槃何必涧之阿，喧寂由来无异科。\n笔下烟云供点缀，胸中丘壑寄婆娑。\n清谭不负玉麈尾，白酒未孤金叵罗。\n试数王春才几日，落梅将尽鸟闻歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题湘乡道中梅花","author":"赵蕃","text":"道上梅花无数株，似能相与慰穷途。\n色严不畏晨霜劲，馥剩宁须爱日敷。\n落落卒无词客赋，纷纷只了酒家沽。\n虽然根本故亡恙，犹愈松明日夜刳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题新竹示韦德卿","author":"赵蕃","text":"戢戢初成茁，骎骎渐可竿。\n朝幽粉泪渍，午静箨声乾。\n枝且胜栖羽，阴仍合翠寒。\n书斋有馀暇，可以过予看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠马奉先二首值其已病竟不相识 其一","author":"赵蕃","text":"使君何苦向宜州，应为涪翁句法留。\n铜柱宁兴跕鸢叹，金华要遂牧羊求。\n壮时根本先培固，老去波澜重卷收。\n我亦学诗穷未达，是中得处可闻否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠马奉先二首值其已病竟不相识 其二","author":"赵蕃","text":"湘山湘水久经怀，近岁扁舟始一来。\n颇见留传诗句写，故胜摸索画图开。\n城南虽郁平生志，冀北未空千里才。\n壮节曾闻趣除诏，辞官何乃尚徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠王进之","author":"赵蕃","text":"走遍东南数十州，皇皇长愧食为谋。\n阅人政尔亦多矣，有客可能如此不。\n叹我漫知耽句僻，如君真复是诗流。\n相逢颇恨夫何晚，华发萧萧今满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠王教授基仲","author":"赵蕃","text":"先君昔作濡须令，闾里所知清德高。\n末路我今惭世业，一门君乃冠辰髦。\n长公已有朝阳誉，夫子宁淹独冷曹。\n颇念相从问畴昔，不堪岁月去滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠韦德卿秀才","author":"赵蕃","text":"蚌繇珠剖孰为冤，鹤岂鸣皋且唳天。\n对策未居金马上，夜书犹即短檠边。\n子诚异嗜如昌歜，我愧沉痾非藕船。\n永好固知当有报，思眢才索不能篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘子卿时刘将赴官镇江并以道别三首 其三","author":"赵蕃","text":"吾友周信道，坐思终死穷。\n眼中宁复有，地下亦难同。\n梦绝西州路，愁闻北固鸿。\n并游惟伯厚，还愧尺书通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘子卿时刘将赴官镇江并以道别三首 其二","author":"赵蕃","text":"江驿频临我，林园屡过公。\n只言成遂别，何意复来同。\n有用期思勉，无诗枉坐穷。\n旧闻京口酒，准拟醉孤蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘子卿时刘将赴官镇江并以道别三首 其一","author":"赵蕃","text":"幕府江宁日，校书元祐时。\n堂堂公可作，岌岌我何衰。\n孰有入门冠，而淹管库卑。\n用长宜顾问，谁与荐天墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘进父监庙四首 其四","author":"赵蕃","text":"岁晚戒行路，问君何远征。\n风霜虽自苦，坟墓不胜情。\n南徙计岂得，北归边未平。\n非惟慕严父，抑亦念难兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘进父监庙四首 其三","author":"赵蕃","text":"彼美南山石，槎牙更贯之。\n道虽横至宝，谁复赏奇姿。\n叹息已云屡，写摹尝有诗。\n吾曹从行者，名字亦俱垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘进父监庙四首 其二","author":"赵蕃","text":"北客自无几，老亲宁重论。\n客居谁肯记，郊寺辱深存。\n厚义真难得，高情独见敦。\n寒灯仍薄粥，相与话黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘进父监庙四首 其一","author":"赵蕃","text":"退士今安有，微官讵足旌。\n茹蔬知味薄，不饮见神清。\n要是高其事，况堪诗有声。\n淮南人物论，是亦一权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别邹君昆仲","author":"赵蕃","text":"湖北湖南路，俱行不惮疲。\n难追燎须意，姑慰倚门思。\n世士才华取，君家孝友基。\n更能知我友，相与切磋为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别欧阳全真三首 其三","author":"赵蕃","text":"往者赣州牧，与君乡里儒。\n身俱上黄阁，官或伏青蒲。\n荐口宁虚启，才名不可诬。\n下僚如处士，鲠论亦时须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别欧阳全真三首 其二","author":"赵蕃","text":"几日暄寒候，浑如到岭南。\n岑岑无药疗，愦愦祇书耽。\n雨止隅仍漏，鸢飞潦政涵。\n君来得披豁，万里散晴岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别欧阳全真三首 其一","author":"赵蕃","text":"我尚长沙客，君归自五溪。\n放舟知有日，枉驾忽冲泥。\n少慰三年阔，重嗟千里睽。\n交情故如酎，薄饭不嫌齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别徐永叔","author":"赵蕃","text":"忆曾看竹过焦山，重记同舟骇浪间。\n邂逅真成肺肝热，别离空益鬓毛斑。\n刍青饭白吾能设，车殆马烦君莫还。\n此去江淮两萧瑟，为言无遣尺书悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别游子明","author":"赵蕃","text":"频年此地几维舟，愧费主人鸡黍留。\n祇道双凫已朝帝，那知一鹗尚迟秋。\n小能过我谈不恶，重复别君空作忧。\n问讯东归所经历，但云岩石过丫头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别谢茂直","author":"赵蕃","text":"江东何许上饶郡，置吏能淹谢法曹。\n与世相逢腰漫折，对山吟咏首频搔。\n谁怜老去斗升禄，未博平生灯火劳。\n我自都城与君别，一官于此始青袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张次律司理三首 其三","author":"赵蕃","text":"长沙今十日，曾未及湘山。\n旧疾痁频作，方炉火自跧。\n风高知木脱，雨细念梅斑。\n飘泊方兹始，林园未遽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张次律司理三首 其二","author":"赵蕃","text":"及是凡几见，于今乃白头。\n殷勤蒙饭设，缓急与医谋。\n夫子自为德，畸人何足忧。\n诸家何所历，更有若人不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张次律司理三首 其一","author":"赵蕃","text":"长沙有贤掾，京兆出名门。\n笔力追前辈，阴功及后昆。\n龙门首加荐，枢府旧弥敦。\n看即飞腾去，宁当寻尺论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠李子永泳","author":"赵蕃","text":"漫刺平生不妄投，不知我者谓何求。\n平生愿作李君御，问事况闻他秩抽。\n驿舍夜凉陪麈尾，野田风晚从遨头。\n可嗟鞅掌催成去，未尽登临山水幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠杨左司三首 其三","author":"赵蕃","text":"有来闻说上封章，造膝言之外敢昌。\n但见诏除频宠渥，是知明圣识忠良。\n都司万事无不理，一语九州当致康。\n况此十年门下士，反从勾漏吊沉湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠杨左司三首 其二","author":"赵蕃","text":"先生文力早骞腾，今代词人尽服膺。\n已见陈诗歌上寿，更须作颂纪中兴。\n敢如杜集高岑比，尚愧韩门籍湜朋。\n政尔周流不知届，况于朝夕遂师承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠杨左司三首 其一","author":"赵蕃","text":"白下初逢使广轩，始披云雾见青天。\n黄花红叶蒙深赏，白发青衫又十年。\n举室尚为湖外客，一身还上浙江船。\n莼羹鲈鲙虽佳矣，不是东归重惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠沈沅陵","author":"赵蕃","text":"绍圣同年今几家，汎然游宦偶天涯。\n先因避贼来江左，身欠看山到永嘉。\n世禄相期会腾踏，束书宁复漫咨嗟。\n我今山色催归意，君政黄紬稳听衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠砚","author":"赵蕃","text":"一种端溪石，下岩滋别源。\n千金腾有翼，尺璧走非跟。\n自顾婆娑质，适堪椎钝根。\n终焉老茅屋，已矣献金门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠徐处士","author":"赵蕃","text":"南朝文士数徐陵，骑省流风篆法存。\n翰墨了知无异道，丹青今复见诸孙。\n规模要自胸中具，绳尺嫌于笔下论。\n太息艺成头已白，谁能持使献金门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠笔","author":"赵蕃","text":"管城封已失，少室价难高。\n外作萧嵩表，中惭去病鏖。\n纵横才适用，脱略已陈劳。\n自分当频弃，毋庸谓不遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠袁州王教授时会","author":"赵蕃","text":"邂逅相逢索我诗，我诗何有鬓空丝。\n能声故尔愧侯喜，到处其谁说项斯。\n肯约山行频滞雨，预怀别后费相思。\n一官独冷休形叹，斯会簿书都不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠萧参议德藻二首 其二","author":"赵蕃","text":"平生苕霅几扁舟，意在斯人岂漫游。\n闻道千岩有高隐，甚思一见苦无由。\n虽云药石稍亲近，未害烟霞廑揽收。\n况是交承我伯父，援兹论契许前不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠萧参议德藻二首 其一","author":"赵蕃","text":"诸侯宾客湖南盛，东海萧生汉帝知。\n前后相望真一揆，流传况复有新诗。\n乡来识面嗟无地，今日登门可自迟。\n未信千岩趣归去，近传新把峡州麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠墨二首 其二","author":"赵蕃","text":"斲我千年质，成兹数寸瑿。\n当从黑白辨，岂问姓名题。\n愿效文章用，宁辞肌骨刲。\n先生无浪语，略为究端倪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠墨二首 其一","author":"赵蕃","text":"奚李风流远，名家得自贤。\n粗能明款识，不暇别中边。\n岁计一丸足，痴人连屋悬。\n此生能几屐，兹士信超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠颜文炳子明用孙从之韵","author":"赵蕃","text":"微风醒蝶梦，骤雨泻天瓢。\n剥啄携诗过，丁宁寄语邀。\n词臣上雍橐，勋阀侍中貂。\n试问龟藏椟，何如鹤唳霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避雨入总持寺谒澹台子羽墓","author":"赵蕃","text":"濒湖有幽寺，避雨适来过。\n吏役毋庸遽，幽寻所得多。\n雷祠真诡特，古墓绝微讹。\n鸟篆森奇画，龟趺载雅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邂逅徐应卿于都下要之同归不可索诗因作","author":"赵蕃","text":"铅山假尉怀初识，祖印依僧忆屡过。\n看镜余今叹斑白，束书君亦尚奔波。\n肯因艇子俱归否，扪此空囊奈若何。\n好并千岩学诗去，侯门弹铗为悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤雨","author":"赵蕃","text":"乍觉尘成敛，旋闻土亦香。\n沟渠勇飞溅，竹树返青苍。\n既使雷先戒，还资风助狂。\n未充田父望，聊益病夫凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤寒二首 其二","author":"赵蕃","text":"日薄林园静，天寒鸟雀微。\n无人行古径，有客滞荆扉。\n疾病淹时久，新朋枉问稀。\n渐谙风俗异，还觉岁年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤寒二首 其一","author":"赵蕃","text":"一晴疑尚暑，一雨顿能寒。\n气候从兹变，病躯那得安。\n频闻风淅淅，不见日团团。\n附火贪新燎，添衣怯带宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤寒简明叔闻仲威数过之","author":"赵蕃","text":"相逢日日讶冬暄，为此阴寒仅覆翻。\n破屋未愁茅尽卷，近林无奈鸟相喧。\n驰驱短景贪黄卷，咫尺梅花忆故园。\n闻道频迂长者辙，教儿勿掩席为门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曝日二首 其二","author":"赵蕃","text":"肃肃初停照，熙熙顿得春。\n人知受天赐，为我乐尧民。\n体垢便搔抑，坐多忘欠伸。\n阶除失馀润，窗户走游尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曝日二首 其一","author":"赵蕃","text":"勿谓吾居陋，能来晓日多。\n屈伸忘病体，沦浃见天和。\n孰愈万全药，贤于五裤歌。\n食芹真有味，献语欲同科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣丞陈择之官满归清江追饯珠林","author":"赵蕃","text":"经行此地几维舟，我亦飘零苦倦游。\n旱久未教梅破腊，霜迟留得草含秋。\n离怀不似残年促，细雨何如骤雪收。\n底事令人重分首，自兹出处恐殊谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣丞曾幼度相邀过明叔买江天阁幼度有诗明叔与成父弟皆和之亦次韵","author":"赵蕃","text":"落本千山迥，空江一带横。\n画图非意匠，诗句亦天成。\n老我头今白，逢渠眼暂明。\n诘朝山岳隔，杯面莫多争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣州出示马提刑留题麻姑山次韵","author":"赵蕃","text":"发轫名山三十年，每逢佳处一悠然。\n独于此地欠行迹，始信兹游亦属天。\n坛记旧模唐刺史，句题今诵两诗仙。\n和篇末至夫何敢，势似求鱼乃木缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衢州城外","author":"赵蕃","text":"才得新晴半日强，廉纤又复蔽朝光。\n梅花黯黯春将暗，麦垄青青饵欲香。\n野水数弯流以决，晚山几叠澹而长。\n秋风红叶骑驴去，归日侵寻且载阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"口占","author":"赵蕃","text":"稍不作山行，山行眼界生。\n晚禾场已筑，宿麦地初耕。\n丱角收牛策，青裙负水罂。\n自安如有道，所乐是无营。\n我亦怀兹愿，胡为计莫成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见月有怀","author":"赵蕃","text":"中秋不数日，明月未频看。\n向晚云无滓，初宵露未团。\n幽幽但庭内，渺渺属河干。\n地迥空无蔽，滩长静不湍。\n巴童挐小艇，渔父举长竿。\n墨本句中画，诗工珠在盘。\n莫亲谈矻矻，空复夜漫漫。\n客枕成疲卧，书窗记读残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]