[{"title":"十八坊诗 通津","author":"王十朋","text":"大江来自蜀，众水共朝东。\n我欲扁舟去，问津从此通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 义泉","author":"王十朋","text":"官费接筒竹，民蠲沽水钱。\n丁宁后来者，莫负义名泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 永安","author":"王十朋","text":"分鼎江山在，受遗宫阙荒。\n风云时惨淡，疑会旧明良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 折桂","author":"王十朋","text":"月窟何人到，向来标榜新。\n如今折桂者，不止一坊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 知足","author":"王十朋","text":"二疏归去后，林下少休官。\n圣代夔门里，一枝栖故鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 和风","author":"王十朋","text":"郡城深僻处，车马罕经过。\n中有人多少，人和风自和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"制胜楼","author":"王十朋","text":"绝塞依天险，高城瞰阵图。\n公孙曾帝蜀，诸葛欲吞吴。\n尊俎冲千里，关山敌万夫。\n人谋兼地利，端坐静边隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中元日得雨","author":"王十朋","text":"秋阳亢流火，时雨洗中元。\n既贺苗苏槁，还欣暑涤烦。\n德知天地大，功任鬼神言。\n愿作老农圃，一犁耕故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦觉偶成","author":"王十朋","text":"早秋良夜月朦胧，梦觉凉生枕簟中。\n数点过云檐外雨，一声落木陇头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题无隐斋寄交代张真父舍人","author":"王十朋","text":"遥自不欺室，来居无隐斋。\n事君均有犯，得郡两俱佳。\n西蜀去何猛，东瓯归未谐。\n清风数竿竹，时见故人怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漕台赏荷花因诵昌黎太华峰头玉井莲句遂用其韵呈行可","author":"王十朋","text":"天池水落华开莲，绣衣呼宾倾玉船。\n赏花对酒诵佳句，香彻鼻观头风痊。\n韩公思摘太华实，陶令不结东林缘。\n何如君有第一朵，池上许我清芬连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵","author":"王十朋","text":"梦草池塘千顷莲，红云楼阁游人船。\n薰薰风日作夏供，病不须药花能痊。\n朅来夔门念乡国，净友喜结西台缘。\n明年华开各南北，今日有酒宜留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张主管摄郡秭归赠以三绝 其一","author":"王十朋","text":"魏公名德最芬馨，犹子传家有典刑。\n勉力施行诚与善，民谣待向峡中听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张主管摄郡秭归赠以三绝 其二","author":"王十朋","text":"女须归处郡如何，地狭民贫事不多。\n把酒送行无别语，要先抚字后催科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张主管摄郡秭归赠以三绝 其三","author":"王十朋","text":"政术遥传京兆张，笑谈为治定循良。\n诸生相见宜相勉，正是风骚屈宋乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲萄","author":"王十朋","text":"水晶马乳荐新秋，青紫酸甜孰味优。\n只可堆盐饷韩子，不宜酿酒博凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵果州","author":"王十朋","text":"九江话别已经年，三峡相逢岂偶然。\n预扫江头礼宾馆，论文尊酒菊花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄阎普州","author":"王十朋","text":"对策天庭老布衣，直言中已有危机。\n须知东普胜西掖，好买扁舟及早归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十二日雨","author":"王十朋","text":"七月之间旱如燬，祷而得之偶然耳。\n八月又旱农无秋，同僚劝效前日求。\n我方省愆未及祷，沛然一雨苏群槁。\n古人重请应上公，何敢频烦渎苍穹。\n但愿时旸及时雨，不独一州天下普。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盘古庙","author":"王十朋","text":"盘古千千古，江头遗像存。\n伏羲犹后辈，礼殿尽诸孙。\n不屋昔非陋，有祠今未尊。\n东邻二郎庙，巫觋醉朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵果州之子年十四能作大字果州自荆南以诗寄予命书之字画老成异日必名家因赠以诗","author":"王十朋","text":"子政平生宜谅闻，故应有子嗣清芬。\n读书行见破万卷，识字岂惟能八分。\n年少便宜观上国，诗成真可张吾军。\n校雠异日居天禄，玉叶金枝有子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送如上人 其一","author":"王十朋","text":"蜀道青天不易登，飘然云水遇乡僧。\n芒鞋便欲相随去，身缚粗官愧未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送如上人 其二","author":"王十朋","text":"十年作别稽山下，万里相逢峡水西。\n天下名山游已遍，好寻潜涧一枝栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 甘露堂","author":"王十朋","text":"昔日贤太守，堂前零露甘。\n我来无善政，露下亦何堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 万卷堂","author":"王十朋","text":"书读万卷破，少陵观国初。\n登堂吾有愧，头白腹空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 瑞白堂","author":"王十朋","text":"昔日曾夔州，兹堂见三白。\n为瑞不嫌多，年丰最宜麦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 诗史堂","author":"王十朋","text":"谁镌堂上石，光艳少陵章。\n莫作诗人看，斯文似子长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 易治堂","author":"王十朋","text":"风俗无难易，治之端在人。\n古夔尤易治，风俗本来淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 细香堂","author":"王十朋","text":"官舍谁为友，青青只此君。\n细香来燕寝，奚用炷炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 静晖楼","author":"王十朋","text":"占得高明地，长闻燕寝香。\n江流匹练白，竹日万金黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 制胜楼","author":"王十朋","text":"形胜据天险，金汤无以过。\n英雄多失守，制胜在人和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 穿杨亭","author":"王十朋","text":"仁者果何似，宜于射也观。\n穿杨不在手，心地要须端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 无隐斋","author":"王十朋","text":"勿谓江湖远，长如天日临。\n事君何敢隐，中外一般心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 跳珠","author":"王十朋","text":"分得天池水，跳成月峡珠。\n一清夔子国，炎瘴自今无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 土洞","author":"王十朋","text":"穴土谁为洞，温凉欲自私。\n人间有寒暑，坐此岂容知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 柏","author":"王十朋","text":"深山夔子国，古柏静晖楼。\n柯叶今如许，相看几故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 荔","author":"王十朋","text":"谁种楼前荔，周天几岁星。\n子随心地赤，叶到岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 竹","author":"王十朋","text":"郡斋谁种竹，绿荫未多浓。\n我欲添清閟，殷勤护箨龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅杂咏 柑","author":"王十朋","text":"白帝谁云陋，黄柑亦自香。\n一株三百颗，风味自吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前辈有满城风雨近重阳句而不成篇九月六日遇雨因为足之招同官分韵","author":"王十朋","text":"满城风雨近重阳，准拟登高尚渺茫。\n会见明朝天气好，不教孤负菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用前句作七绝 其一","author":"王十朋","text":"重阳无数日，风雨登临缓。\n会见天气佳，黄花插须满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用前句作七绝 其二","author":"王十朋","text":"老对黄花节，遥临白帝城。\n空斋听萧瑟，点点是乡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用前句作七绝 其三","author":"王十朋","text":"江山悲木落，身世叹飘蓬。\n未会登山客，先吹堕帽风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用前句作七绝 其四","author":"王十朋","text":"巫峡有雄风，菊天多细雨。\n知我欲登高，先期洗尘土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用前句作七绝 其五","author":"王十朋","text":"竹叶悲杜陵，秋云吟柳恽。\n家乡雁荡遥，节物龙山近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用前句作七绝 其六","author":"王十朋","text":"灰飞季秋管，云暗巫山峰。\n我欲廓氛曀，试呼黎与重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用前句作七绝 其七","author":"王十朋","text":"节近愁阴雨，云披见太阳。\n殷勤呼酒伴，烂熳醉秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登卧龙山呈同官","author":"王十朋","text":"老逢佳节强跻攀，兴绕东篱愧未还。\n与客携壶登缥缈，寻僧对榻卧幽闲。\n白盐照日一峰古，乌帽吹风双鬓班。\n坐上无非孟嘉辈，卧龙山却胜龙山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登卧龙山呈同官又一绝","author":"王十朋","text":"夔子山高峡天阔，骚人宅近刚肠悲。\n菊花上头不易得，酒盏到手何须辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送何希深舍人赴召","author":"王十朋","text":"十年持节国西门，万里东归德愈尊。\n平叔渊源易论语，子云游戏字方言。\n坐令国体还元气，重见文星照掖垣。\n廊庙诸公倘相问，为言真欲老田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至瞿唐关戏用山名成一绝","author":"王十朋","text":"取友要如山胜己，居官宜似地青帘。\n边庭未静尚赤甲，鼎鼎欲调须白盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其一 瞿唐","author":"王十朋","text":"七日重来白帝城，劳生远宦厌将迎。\n瞿唐莫下今宜下，兴逐渔舟一叶轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其二 滟滪","author":"王十朋","text":"水涨瞿唐势更危，舟人贪进只嫌迟。\n天将此石垂深戒，看取形如象马时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其三 白帝城","author":"王十朋","text":"火德重兴六合同，金行数止一星终。\n鼎分虽愧刘玄德，面缚肯为安乐公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其四 越公堂","author":"王十朋","text":"柱国杨家二世亡，越公遗迹独绵长。\n不能牢固隋基业，枉费精神在一堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其五 三峡堂","author":"王十朋","text":"三峡堂中看倒流，沉舟侧畔过千舟。\n世途险更胜三峡，多少人怀积羽忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其六 石笋","author":"王十朋","text":"白帝祠前石笋三，根连滟滪立相参。\n不知此石能言否，往事应同老柏谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其七 白盐","author":"王十朋","text":"蜀中盐井知多少，功利端能与海分。\n尚使此山真可煮，商功计利更纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其八 赤甲","author":"王十朋","text":"赤甲城连白帝城，子阳曾向此屯兵。\n区区板筑徒劳耳，尚赤由来是汉营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其九 东屯","author":"王十朋","text":"少陵别业古东屯，一饭遗忠畎亩存。\n我辈月叨官九斗，须知粒粒是君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其十 昭烈庙","author":"王十朋","text":"老臣苦欲争天下，嗣子何曾思蜀中。\n古屋数椽犹庙食，伤心地近永安宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其十一 八阵图","author":"王十朋","text":"一家天下裂三都，忠愤填胸出阵图。\n千载相知惟白水，此心元不为吞吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日至瞿唐谒白帝祠登越公三峡堂徘徊览古共成十二绝 其十二 胜己山","author":"王十朋","text":"私心克尽道方大，胜己与游名始成。\n物我太深谁氏子，却将己胜易山名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题无隐斋","author":"王十朋","text":"檐日照我几，竹风清我襟。\n官身心处士，官舍趣山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送喻令","author":"王十朋","text":"扪膝先生有凤毛，三年鱼邑试牛刀。\n要令人被弦歌化，讵肯身辞州县劳。\n贤令首祠唐质肃，诗篇时出楚风骚。\n西归更勉家传学，云翼行看九万高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月九日雪","author":"王十朋","text":"夔子今年雪，初冬已在山。\n峰非是盐白，鬓不为诗班。\n寒律三朝后，雷声八日间。\n潜催子猷棹，乘兴早知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食柑","author":"王十朋","text":"萧山陆橘东坡传，夔子黄柑老杜诗。\n楚越相望五千里，西州滋味独浓知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十日买黄菊二株","author":"王十朋","text":"十月更十日，黄花开满枝。\n鲜鲜如可餐，采采还自疑。\n重阳不堪摘，况后一月期。\n既晚何用好，兹言闻退之。\n天然傲霜性，宁问早与迟。\n不以日月断，深杯为花持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"采菊图","author":"王十朋","text":"渊明耻折腰，慨然咏式微。\n闲居爱重九，采菊来白衣。\n南山忽在眼，倦鸟亦知归。\n至今东篱花，清如首阳薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁彭州归自道山溯流入峡以二诗见寄因次其韵 其一","author":"王十朋","text":"首遇重华辟四门，郡符帅阃误蒙恩。\n路经滟滪少陵鬓，草梦池塘灵运魂。\n马运敢辞论水陆，兵储未暇议营屯。\n故人相见谈时事，耿耿胸中直气存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁彭州归自道山溯流入峡以二诗见寄因次其韵 其二","author":"王十朋","text":"壮夫白首两同年，又继钱塘唱和篇。\n十载音书天上雁，一江风雪峡中船。\n西州贤守得高适，东观人才推孟坚。\n紫陌曾陪探花马，姓名深愧在卢前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁彭州与客登卧龙山送酒二尊 其二","author":"王十朋","text":"天禄归来杨子云，酒随后乘为论文。\n云安曲米瓶双玉，聊助诗人作小醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阎普州赵果州舟中唱和以巨轴见寄酬以二首 其一","author":"王十朋","text":"联舟西上沸欢声，赵璧隋珠照坐明。\n一客词流三峡水，百篇诗压五言城。\n广文旧舍欣重扫，阿买奇儿况侍行。\n我以礼宾名客馆，云安曲米待君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阎普州赵果州舟中唱和以巨轴见寄酬以二首 其二","author":"王十朋","text":"灯结寒花鹊有声，书传双鲤眼增明。\n人言尽是青云士，天遣相逢白帝城。\n富贵有机端可畏，山川非险莫辞行。\n定知蜀道从今易，东普南充盖已倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]