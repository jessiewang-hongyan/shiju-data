[{"title":"题漱玉馆","author":"王宗贤","text":"寓馆欣传漱玉名，泉流古窦响琮琤。\n幽窗偃息惊回梦，误听虚檐雨滴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春閒","author":"王宗道","text":"最喜逍遥泉石间，幽居四面绕青山。\n草迷荒径人稀到，花压重门昼自关。\n古刹风传钟磬远，平畴雨过桔槔閒。\n荷锄手斸园中笋，佐酒三杯壮客颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王实之","text":"碧鸡金马非吾事，白鹭青原欠子诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同林逢吉过小溪寺二首 其二","author":"王居安","text":"浓阴阁雨未全收，屈指相将禊事修。\n不必山阴寻故地，小溪曲水更清幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同林逢吉过小溪寺二首 其一","author":"王居安","text":"方岩胜处是仙家，时有轻云薄雾遮。\n我欲去时君共去，溯流而上看山花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘改之二首 其二","author":"王居安","text":"不识刘郎莫便语，酒酣耳热未全疏。\n士当穷困能无慊，我自斟量愧不如。\n横槊赋诗俱有分，轻裘缓带特其馀。\n当今四野无尘土，宜有奇才在草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘改之二首 其一","author":"王居安","text":"刘子堂堂七尺躯，高谈世事奋髯须。\n观渠论到前贤处，据我看来近世无。\n出语令人惊辟易，处穷无鬼敢揶揄。\n徜徉闹市浑无畏，要是人间烈丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"考试当涂次池阳崎岖山行石多可爱因用袁席之韵","author":"王居安","text":"平生爱奇石，如见古君子。\n一卷窗牖间，时复为隐几。\n兹行池阳路，终日乱山里。\n道傍石丛生，牛羊乱虎兕。\n中有篆籀文，鼎彝间罍洗。\n纵横列簨虡，埋没见追蠡。\n嗟予心好之，愧恨无能徙。\n著手为摩挲，却立复睥睨。\n有似南阳公，可就不可致。\n是宜米元章，一见辄下拜。\n倘可从予招，安车更加礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘改之","author":"王居安","text":"名满江湖刘改之，半生穷困只吟诗。\n人言季布恐难近，我谓郑老真吾师。\n试令满饮至酩酊，愈觉高论生神奇。\n豪家有财不识宝，贫者识之空嗟咨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游委羽山","author":"王居安","text":"几日山不到，到山心自清。\n棱棱有方石，拾得通仙灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潘德久有龙眠三马而失其一俾予赋诗","author":"王居安","text":"三马往往皆龙驹，神骏肯与凡马俱。\n忽不见者其前驱，定应飞上天之衢。\n君得其二已有馀，我欲与君分此图。\n驽才患多不患无，四十万疋将何如。\n龙眠已往不可呼，愈少愈贵宜宝储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 敬次白真人韵","author":"王居安","text":"湖海襟期，烟霞气宇，天下星郎。\n有灵方肘后，年年却老，神锋耳底，夜夜腾光。\n万卷蟠胸，千钟蘸甲，衮衮词源三峡滂。\n功成处，见须弥日月，河岳星霜。\n兴来引笔千行。\n看举世何人是智囊。\n任纵横万变，难瞒道眼，优游自乐，不识愁肠。\n闹市业中，密林静处，鼻观常闻三界香。\n天书到，听笙箫竞奏，幢盖班行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红","author":"王居安","text":"八十归来，方岩下、几竿修竹。\n柴门外，沙铺软路，水流清玉。\n栽接新来桃与李，安排旧日松和菊。\n过小桥、作个看山楼，千峰绿。\n收笔砚，藏棋局。\n酒莫饮，经须读。\n但平平放下，顿超凡俗。\n独睡已无年少梦，闲吟不唱他家曲。\n算人生、万事苦无多，相将足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王居安","text":"高下水痕元自定，后先花信不须催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王居安","text":"只为人前呈颜色，天工罚取不教香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 寿蔡久轩参政，癸丑生","author":"王庚","text":"满劝黄封酒。\n是年年、春色长绕，径花宫柳。\n碧水丹山添清气，岁月兰亭癸丑。\n看枢极、光腾台斗。\n细数中书堂壁记，自欧韩、富范题名后，还有似、我公否。\n好知天意生贤候，正造化安排，孕出五阳之秀。\n何物一阴犹踯躅，尽决还公只手。\n这一著、邦家之寿。\n宰相时来须教做，算人间、是处鱼羹有。\n名与节，久轩久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清芬阁","author":"王念","text":"籍甚诗名世所传，耳孙今始出遗编。\n发扬风教三纲正，包括乾坤一气全。\n峻拔孤峰当□□，□容幽涧落春泉。\n超然远思追前古，好续委蛇二雅篇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠英公大师","author":"王承衎","text":"文章篆籀久传芳，灰志禅门道愈光。\n丰镐有心营宝刹，潇湘无意卧云房。\n陶情早著诗千首，混俗何妨酒百觞。\n若许宗雷重结社，愿持香火学空王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 催妆词","author":"王昂","text":"喜气拥朱门，光动绮罗香陌。\n行到紫薇花下，悟身非凡客。\n不须脂粉涴天真，嫌怕太红白。\n留取黛眉浅处，画章台春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题应天寺","author":"王昌符","text":"何事诗家称剪裁，跨虚相继有楼台。\n水涵春碧雨初霁，山露晓青云半开。\n宝塔礼终僧室静，粉墙题罢使车回。\n此时欲结香莲社，祇为陶潜醉不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴乙卯张安国为右史明清与仲信兄梁举善郭世祯李大正李泳多馆于安国家春日诸友同游西湖至普安寺于窗间得玉钗半股青蚨半文想是游人欢洽所分偶遗之者各赋诗以纪其事","author":"王明清","text":"凄凉宝钿初分际，愁绝清光欲破时。\n留与人间作佳话，绿窗琼户老蛛丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题高房山夜山图","author":"王易简","text":"高侯妙笔生夜光，李侯正倚斗牛旁。\n凄凉看尽吴山月，玉镜台前翠凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游宝林寺","author":"王易简","text":"玄度存遗迹，玄英有旧诗。\n城中独高处，雪后最佳时。\n拂壁书行纪，逢僧问故祠。\n阑干频徙倚，不奈朔风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其九 石壁","author":"王易简","text":"天吴泣海枯，化石空山中。\n陵谷历千变，倒倚蓬莱风。\n铁壁立峭绝，縠波漾玲珑。\n前岩寄游屧，大巧藏神功。\n素屏三十丈，画手谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其一 大涤洞","author":"王易简","text":"萧洒殊庭西，玉室青孱颜。\n华阳隐邃道，元盖浮尘寰。\n紞紞天鼓鸣，烂烂岩屋斑。\n谁悬隔凡石，此已非人间。\n群仙本容物，为我开重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其三 凤洞","author":"王易简","text":"凤兮尔何来，翙翙鸣高岗。\n山风度玉箫，竹实丰糇粮。\n至今嶙峋石，如作毛羽翔。\n深溪阻造极，悬磴聊褰裳。\n踟蹰不忍下，树杪青天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其八 翠蛟亭","author":"王易简","text":"岚阴四围合，涧水数折流。\n试手翻碧海，捲雨来青虬。\n静躁为人役，蓄泄同神谋。\n长歌亭上诗，飞仙不可留。\n倚栏天风寒，问信骑鲸游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其五 来贤岩","author":"王易简","text":"绝壁中嵌空，秀石下插地。\n缅怀玉局仙，于此冠盖萃。\n云泉俨昨游，卉木遗古意。\n青山日迎客，何者传姓字。\n斯人千载名，揽胜乃馀事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其二 栖真洞","author":"王易简","text":"风烟谷口亭，岩穴神仙宅。\n径回閟天光，云湿滴乳液。\n宝盖遥当空，篝火忽奇迹。\n不见茹芝人，残枰弃黑白。\n跻攀幸有逢，筋力何足惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其七 云根石","author":"王易简","text":"行云倏变灭，本作须臾期。\n山灵护清气，英英幻真姿。\n旧雨洗犹在，高风吹不移。\n触石有动意，出岫无还时。\n扶桑如可薪，鍊此白玉芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其六 仙迹岩","author":"王易简","text":"古来得道人，一往无留踪。\n胡为恋幽绝，努力抗祖龙。\n冠簪宛如刻，藓蔓不敢封。\n形化影未灭，石坚诚可通。\n灵仙去已遥，聊尔惊凡庸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其十 丹泉","author":"王易简","text":"泠泠佩行空，湛湛镜无滓。\n至洁漱岩骨，馀润蒸石髓。\n山上真人居，鼎灶长不毁。\n犹闻洗药香，渐作落花水。\n临流且勿尝，清音濯幽耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其四 龙洞","author":"王易简","text":"晴矼步清空，洞户抚巀嶭。\n何年出水龙，张口见齿舌。\n相传此得名，灵骨蜕如雪。\n岂其风霆化，诘曲馀故穴。\n想当夜半归，九锁一时掣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏保母帖","author":"王易简","text":"黄閍断刻得者谁，双松下殉方壶螭。\n其文记述保母李，云是大令之所为。\n点画安知尚年少，笔不可掣从儿时。\n当其翰墨托久计，异哉岁月如前期。\n为怜樵人巧收拾，岂无行道犹嗟咨。\n残砖裹送平原家，阅古众帖奚独遗。\n穷诹远引商是非，具眼落落多传疑。\n尘埃尺纸拂陈迹，闻君好事捲赠之。\n简编无端发汲冢，陵谷何年沈岘碑。\n坐中赏识本易厌，世外隐伏劳旁窥。\n骚人胜士一朝玩，孝子慈孙千古悲。\n君不见钟侯书法亦大奇，下穿墟墓求其师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题大像","author":"王易简","text":"□□未生时，先有此石岩。\n一从下生已，□□□□□。\n初发混沌窍，吐尽龙宫函。\n嗟□□□□，巍坐当空嵌。\n按足大地动，□□□魔芟。\n丹青架楼阁，仅免苔藓缄。\n上方见顶相，下方仰裙衫。\n谁如福智人，独脱神鬼监。\n龛灯集烟耀，天花坠云衔。\n我行岂不遥，迫此十口馋。\n叩门觅津梁，忽睹大力帆。\n善哉此方俗，不解走巫咸。\n仰佛何拳拳，盥佛何掺掺。\n灵石兆三生，神感浃至诚。\n我出唁佛语，谁能知圣凡。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天香 宛委山房拟赋龙涎香","author":"王易简","text":"烟峤收痕，云沙拥沫，孤槎万里春聚。\n蜡杵冰尘，水研花片，带得海山风露。\n纤痕透晓，银镂小、初浮一缕。\n重剪纱窗暗烛，深垂绣帘微雨。\n馀馨恼人最苦。\n染罗衣、少年情绪。\n谩省佩珠曾解，蕙羞兰妒。\n好是芳钿翠妩。\n恨素被浓薰梦无据。\n待剪秋云，殷勤寄与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 浮翠山房拟赋白莲","author":"王易简","text":"翠裳微护冰肌，夜深暗泣瑶台露。\n芳容淡泞，风神萧散，凌波晚步。\n西子残妆，环儿初起，未须匀注。\n看明珰素袜，相逢憔悴，当应被、西风误。\n十里云愁雪妒。\n抱凄凉、盼娇无语。\n当时姊妹，朱颜楼褪酒，红衣按舞。\n别浦重寻，旧盟唯有，一行鸥鹭。\n伴玉颜月晓，盈盈冷艳，洗人间暑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆宫春/高阳台 谢草窗惠词卷","author":"王易简","text":"庭草春迟，汀苹香老，数声佩悄苍玉。\n年晚江空，天寒日暮，壮怀聊寄幽独。\n倦游多感，更西北、高楼送目。\n佳人不见，慷慨悲歌，夕阳乔木。\n紫霞洞窅云深，袅袅馀香，凤箫谁续。\n桃花赋在，竹枝词远，此恨年年相触。\n翠笺芳字，谩重省、当时顾曲。\n因君凝伫，依约吴山，半痕蛾绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 馀闲书院拟赋蝉","author":"王易简","text":"翠云深锁齐姬恨，纤柯暗翻冰羽。\n锦瑟重调，绡衣乍著，聊饮人间风露。\n相逢甚处。\n记槐影初凉，柳阴新雨。\n听尽残声，为谁惊起又飞去。\n商量秋信最早。\n晚来吟未彻，却是凄楚。\n断韵还连，馀悲似咽，欲和愁边佳句。\n幽期谁语。\n怕寒叶凋零，蜕痕尘土。\n古木斜晖，向人怀抱苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 客长安赋","author":"王易简","text":"宫烟晓散春如雾。\n参差护晴窗户。\n柳色初分，饧香未冷，正是清明百五。\n临流笑语。\n映十二阑干，翠嚬红妒。\n短帽轻鞍，倦游曾遍断桥路。\n东风为谁媚妩。\n岁华顿感慨，双鬓何许。\n前度刘郎，三生杜牧，赢得征衫尘土。\n心期暗数。\n总寂寞当年，酒筹花谱。\n付与春愁，小楼今夜雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 紫云山房拟赋莼","author":"王易简","text":"怪鲛宫、水晶帘卷，冰痕初断香缕。\n澄波荡桨人初到，三十六陂烟雨。\n春又去。\n伴点点荷钱，隐约吴中路。\n相思日暮。\n恨洛浦娉婷，芳钿翠剪，奁影照凄楚。\n功名梦，消得西风一度。\n高人今在何许。\n鲈香菰冷斜阳里，多少天涯意绪。\n谁记取。\n但枯豉红盐，溜玉凝秋箸。\n尊前起舞。\n算唯有渊明，黄花岁晚，此兴共千古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇","author":"王易简","text":"暗帘吹雨，怪西风梧井，凄凉何早。\n一寸柔情千万缕，临镜霜痕惊老。\n雁影关山，蛩声院宇，做就新怀抱。\n湘皋遗佩，故人空寄瑶草。\n已是摇落堪悲，飘零多感，那更长安道。\n衰草寒芜吟未尽，无那平烟残照。\n千古闲愁，百年往事，不了黄花笑。\n渔樵深处，满庭红叶休扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王松","text":"旧菊篱边又开了，故人天际未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 闻笛","author":"王武子","text":"红楼十二春寒恻。\n楼角何人吹玉笛。\n天津桥上旧曾听，三十六宫秋草碧。\n昭华人去无消息。\n江上青山空晚色。\n一声落尽短亭花，无数行人归未得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措","author":"王武子","text":"画眉人去掩兰房。\n金鸭懒薰香。\n有恨只弹珠泪，无人与说衷肠。\n玉颜云鬓，春花夜月，辜负韶光。\n闲看枕屏风上，不如画底鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风流子","author":"王泳祖","text":"东风长是客，帘栊静、燕子一双飞。\n看花坞日高，翠阴护晓，柳塘风细，绿涨浮漪。\n肠断处，渭城春树远，江国暮云低。\n芳径听莺，暗惊心事，画檐闻鹊，试卜归期。\n小楼凝伫地，疏窗下，几度对说相思。\n记得菱花交照，素手曾携。\n有新恨两眉，向谁说破，芳心一点，惟我偏知。\n休为多情瘦却，重有来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕一绝句","author":"王炎","text":"轻云捲箔月钩垂，正是青楼乞巧时。\n牛女相望隔河汉，浪传天上有佳期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月二十二日遣怀","author":"王炎","text":"寥落求凰凤，凄凉舐犊牛。\n有时追往事，无处著清愁。\n世故今犹古，年华春复秋。\n西风乘一舸，归去理菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与三山相士林子和三绝 其三","author":"王炎","text":"鱼虾琐细不堪求，水涩溪寒欲断流。\n若叩侯门逢短李，钓鳌便可月为钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与三山相士林子和三绝 其二","author":"王炎","text":"鸢肩燕颔刺天飞，自顾而今已后时。\n巾褐萧然成野老，有何情绪更哦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与三山相士林子和三绝 其一","author":"王炎","text":"年登八十更何为，手足支离视听衰。\n自笑已如鸡失旦，不须苦说鹤知时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子大有游东山之约以诗相趣因次其韵 其三","author":"王炎","text":"万杉深处一轩开，秀色参天费壅培。\n我为不知林壑趣，黄粱梦觉却归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子大有游东山之约以诗相趣因次其韵 其一","author":"王炎","text":"家如锦里先生甫，诗似钱塘处士逋。\n若解山中安稳住，定胜软饱卧流苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子大有游东山之约以诗相趣因次其韵 其二","author":"王炎","text":"今昔东山约略同，但无红袖肯相从。\n不妨小试游山屐，因访骙骙陆士龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子大有游东山之约以诗相趣因次其韵 其四","author":"王炎","text":"猛省香山及辋川，句中摹写共流传。\n烦公检点遗编看，二老元曾赋几篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子用惠鱼四轴以诗谢之 其二","author":"王炎","text":"掉尾扬鬐气象閒，或潜或跃出毫端。\n非鱼知得鱼如许，岂在濠梁子细观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子用惠鱼四轴以诗谢之 其一","author":"王炎","text":"四幅溪藤任卷舒，管城幻出化龙鱼。\n风雷定似梭飞走，莫误呼儿觅素书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小凫","author":"王炎","text":"母鸡伏得两凫雏，驯食庭除不待呼。\n水浴泥行随分足，不知鸥鹭有江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行二绝 其一","author":"王炎","text":"路回秾绿屡低盖，风定落红时点衣。\n行李驰驱无暇日，客情乡思两依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行二绝 其二","author":"王炎","text":"尽日扶舆度乱山，石根古涧水潺潺。\n孤烟时傍翠微起，疑在新安道路间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山间偶成二绝 其二","author":"王炎","text":"隔枝啼鸟唤幽梦，排闼青山无世情。\n绿树阴阴遮日影，虚窗卧看白云行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山间偶成二绝 其一","author":"王炎","text":"人家鸡犬近相闻，村落纡回古木深。\n山客一来尘想尽，水声终日奏鸣琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]