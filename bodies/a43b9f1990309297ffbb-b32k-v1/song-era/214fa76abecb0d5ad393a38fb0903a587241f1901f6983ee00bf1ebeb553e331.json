[{"title":"翠蛟亭 其一","author":"怡然","text":"萦纡九锁山，棱层几叠水。\n谁令翻其源，银涛迸石髓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隔凡柱","author":"怡然","text":"一柱悬通衢，可望不可进。\n老仙指谓予，傍边有捷径。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题雁荡龙鼻水","author":"肱禅师","text":"雨足云收得暂閒，谩将头角寄空山。\n鼻端一滴无多子，引得人人到此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻史弥远占寺偈","author":"育王寺僧","text":"寺前一块地，常有天子气。\n丞相要作坟，不知主何意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"败道道人","text":"瑶峰一别杳难期，消渴从教醉枕攲。\n不信丹青能画得，五更灯暗月来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李白书堂","author":"林桷","text":"江风朝暮半晴阴，绀宇飞甍接翠岑。\n手摘匏瓜曾未遍，身从鸥鹭得相寻。\n千年舞袖云崖冷，几度桃花春水深。\n犹有门前旧诗句，松风万壑老龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临安谣","author":"临安人","text":"满头青，都是假。\n这回来，不作耍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居","author":"张咨","text":"兀兀浮生水上萍，百年那得眼长青。\n醉中但爱杯呼月，镜里惊看鬓易星。\n瓶胆插花时过蝶，石拳栽草也留萤。\n瑶音到手知音少，默诵南华一卷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 赠周锷应举","author":"哑女","text":"风波未息。\n虚名浮利终无益。\n不如早去备蓑笠。\n高卧烟霞，千古企难及。\n君今既已装行色。\n定应雁塔题名籍。\n他年若到南雄驿。\n玉石休分，徒累卞和泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古","author":"□庭倚","text":"宦海漂浮若转蓬，唯馀访古意无穷。\n曾观老柏怀诸葛，今对古楠思郑公。\n遗憾已随流水远，英名仍伴故山雄。\n后来碌碌空千辈，谁许登临继此风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿武夷宫 其一","author":"彦修","text":"学仙独访武夷君，老树垂藤弄夕曛。\n我欲幔亭拚一醉，不知何处奏宾云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿武夷宫 其三","author":"彦修","text":"偶过群仙入武夷，苍崖瑶草白云飞。\n不知何处猿啼月，岩上松花落满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宿武夷宫","author":"彦修","text":"巢松老鹤鸣丹井，笼月梅花摇素影。\n竹敲白露幔亭寒，吟弄紫箫山月冷。\n山月箫声清且幽，幔亭不见昔人游。\n我来欲此腾云雾，笑指三山十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿武夷宫 其二","author":"彦修","text":"月满空山雪满溪，幽人何处吹龙笛。\n醒来和月倚虚窗，鹤翻松露滴云石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓼花","author":"拾遗","text":"分红间白汀州晚，拜雨揖风江汉秋。\n看谁耐得清霜去，却是芦花先白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"昭顺老人","text":"的皪堪为席上珍。\n银铛百沸麝脐薰。\n萧娘欲饵意中人。\n拈处玉纤笼蚌颗，剥时琼齿嚼香津。\n仙郎入口即轻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"某卫尉","text":"清音见江来，载酒送江去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦石岩 其二","author":"□子发","text":"倚空峻壁列松杉，水色岚光总不凡。\n一段画图奇绝处，夕阳天际认归帆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦石岩 其一","author":"□子发","text":"巉巉怪石锦鲜明，不假人为自织成。\n频向水晶帘外立，泉声那更杂溪声。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦石岩 其三","author":"□子发","text":"平昔曾闻锦水名，维舟特向此中行。\n只愁凡骨成仙去，寒却当年泉石盟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游麻姑","author":"□松卿","text":"平生但玩鲁公碑，今日身亲到翠微。\n一径穹窿腾石栈，万松森立护云扉。\n真人得道书丹籍，福地遗踪付羽衣。\n暂得清幽消俗虑，不堪斜日便催归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏答举人索米","author":"某名公","text":"五贯九百五十俸，省钱请作足钱用。\n妻儿尚未厌糟糠，僮仆岂免遭饥冻。\n赎典赎解不曾休，吃酒吃肉何曾梦。\n为报江南痴秀才，更来谒索觅甚瓮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一络索","author":"某两地","text":"为爱金陵佳丽。\n乃分符来此。\n拥麾忽又向淮东，便咫尺、人千里。\n画鼓一声催起。\n邦内人齐跪。\n江山有兴我重来，斟别酒、休辞泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲","author":"某邑妓","text":"十月小春梅蕊破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南山留题和吕元锡韵","author":"某府判","text":"词源浩渺浙江潮，倒泻银河落九霄。\n贝阙珠宫春不老，蓬莱瀛海路非遥。\n多君访古曾携手，愧我劳生漫折腰。\n拟欲诛茅成小隐，山云不薄幸相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高平北岩","author":"□说","text":"路入仙峰不记重，一轩潇洒桧阴中。\n溪山括尽丹青巧，天地驰回造化工。\n风剡鳞波清枕簟，日扶花影上帘栊。\n来游绝异人间景，身世依稀到蕊宫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"某教授","text":"鬓边一点似飞鸦。\n莫把翠钿遮。\n三年两载，千撋百就，今日天涯。\n杨花又逐东风去，随分落谁家。\n若还忘得，除非睡起，不照菱花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"某教授","text":"作法孰为凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"某道士","text":"李郎涉世似虚舟，片帆来渡楚江秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九吟诗 石室","author":"吴昌裔","text":"竹几蒲团石室中，细书抱朴校参同。\n寄声碧眼朱高士，何必携琴下阆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九吟诗 清音","author":"吴昌裔","text":"山出涓寒一道泉，暗声落涧玉铮然。\n辘轳引上泥丸顶，便是人间赤脚仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"洙泗钧翁","text":"巍巍颜鲁公，笔正心亦正。\n凛凛元道州，高节抱幽贞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"洞庭老人","text":"八十沧浪一老翁，芦花江上水连空。\n世间多少乘除事，良夜月明收钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"济州太守","text":"鹦鹉能言争似凤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"珍娘","text":"溪雾溪烟溪景新。\n溶溶春水浸春云。\n碧琉璃底静无尘。\n风扬游丝随蝶翅，雨飘飞絮湿莺唇。\n桃花片片送残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜花容","author":"盼盼","text":"少年看花双鬓绿。\n走马章台管弦逐。\n而今老更惜花深，终日看花看不足。\n坐中美女颜如玉。\n为我一歌金缕曲。\n归时压得帽檐敧，头上春风红蔌蔌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"窃杯女子","text":"桂魄澄辉，禁城内、万盏花灯罗列。\n无限佳人穿绣径，几多妖艳奇绝。\n凤烛交光，银灯相射，奏箫韶初歇。\n鸣鞘响处，万民瞻仰宫阙。\n妾自闺门给假，与夫携手，共赏元宵节。\n误到玉皇金殿砌，赐酒金杯满设。\n量窄从来，红凝粉面，尊见无凭说。\n假王金盏，免公婆责罚臣妾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"窃杯女子","text":"灯火楼台处处新。\n笑携郎手御街行。\n回头忽听传呼急，不觉鸳鸯两处分。\n天表近，帝恩荣。\n琼浆饮罢脸生春。\n归来恐被儿夫怪，愿赐金杯作证明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子","author":"美奴","text":"送我出东门，乍别长安道。\n两岸垂杨锁暮烟，正是秋光老。\n一曲古阳关，莫惜金尊倒。\n君向潇湘我向秦，鱼雁何时到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令","author":"美奴","text":"日暮马嘶人去。\n船逐清波东注。\n后夜最高楼，还肯思量人否。\n无绪。\n无绪。\n生怕黄昏疏雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈寇公二首 其二","author":"茜桃","text":"风劲衣单手屡呵，幽窗轧轧度寒梭。\n腊天日短不盈尺，何似燕姬一曲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈寇公二首 其一","author":"茜桃","text":"一曲清歌一束绫，美人犹自意嫌轻。\n不知织女萤窗下，几度抛梭织得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 寿妇人又受命十月廿七","author":"草夫人","text":"清晓新妆，鸾台畔、潜呼小玉。\n问阿谁庭院，调长生曲。\n报道隔邻人庆寿，新来荣领金花轴。\n细推来、阳月已将周，惟三宿。\n陈□颂，年多祝。\n环珠翠，人如簇。\n奉金杯相庆，满斟醽醁。\n愿享麻姑难老福，屡餐王母蟠桃熟。\n更儿孙、岁岁献莱庭，蓝袍绿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"觉性","text":"细读燕云吟，静听流水琴。\n神游八极高而深，龙溪玉山犹谷响，燕歌吴咏轰雷音。\n人中龙，天外鹤。\n挟泰山，擘华岳。\n醉吟不管天地窄，尧桀谁能分善恶。\n云阁麟台一笑间，招得赤松归碧落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登洪庆观","author":"适宜","text":"行到蓬莱第一宫，却惭仙路印尘踪。\n界开形势昆崙水，送过烟岚黛嵋峰。\n经夏定知非暑气，乘时犹逮看秋容。\n不才佳景难为赋，空立斜阳倚瘦筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"判幸倅求免税丁","author":"郢州太守","text":"松垣笔力破苍溟，欲援任涛免税丁。\n一段风流好公案，锦江重写入图经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"欧阳凯士","text":"冰姿元住藐姑山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落笔峒","author":"倭倭才","text":"峭壁凌空望渺微，层层烟锁雾云衣。\n深山古木高千丈，怪石青苔绕四围。\n空有石衔仙骨在，想应人逐彩鸾飞。\n洞中仙子今何往，欲上雕鞍不忍归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题灵岩寺","author":"卞育","text":"屈指数四绝，四绝中最优。\n此景冠天下，不独奇东州。\n夜月透岩白，乱云和雨收。\n甘泉泻山腹，圣日穿岩头。\n大暑不知夏，爽气常如秋。\n风高松子落，天外钟声浮。\n祖师生朗石，古殿名般舟。\n人巧不可至，天意何所留。\n老僧笑相语，兹事常穷求。\n移出蓬莱岛，待吾仙子游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅诗","author":"冥漠子","text":"红苞紫萼曾欺雪，素艳清香解动人。\n自有风传枝上意，肯教蝶见蕊中真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其一","author":"释圆","text":"本是潇湘一钓客，自东自西自南北。\n只把孤舟为屋宅。\n无宽窄，幕天席地人难测。\n顷闻四海停戈革，金门懒去投书策。\n时向滩头歌月白。\n真高格，浮名浮利谁拘得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题沈知丞园","author":"壶韬","text":"曲径芳塘百亩园，更无烦暑碍风烟。\n留春庭院花如锦，迎月楼台柳舞绵。\n邺架插书金屋底，秦筝度曲绿衣前。\n主人宴罢归来晚，银烛高烧月午天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居颂","author":"振禅师","text":"呵呵呵，瘦松寒竹锁清波。\n有时独坐磐陀上，无人共唱太平歌。\n朝看白云生洞口，暮观明月照娑婆。\n有人问我居山事，三尺杖子搅黄河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日过庄严寺寺僧索诗为留三绝拉舍弟同赋 其二","author":"晁公休","text":"病起支离倚瘦筇，幅巾芒屩竹阴中。\n闻蝉未有惊人句，且就禅床一榻风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日过庄严寺寺僧索诗为留三绝拉舍弟同赋 其三","author":"晁公休","text":"机杼声中禾稻肥，畴瓜区芋绿成畦。\n田家乐事今如许，何日边城息鼓鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日过庄严寺寺僧索诗为留三绝拉舍弟同赋 其一","author":"晁公休","text":"十里溪桥梵宇新，那知陌上涨红尘。\n老僧苦要题名姓，不道林泉皆故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵谢王立之惠红丝花","author":"晁冲之","text":"老来嗜酒无宾主，我醉应眠不遣卿。\n如许此花同九日，为君采掇笑渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与秦少章题汉江远帆五首 其五","author":"晁冲之","text":"石似浣沙石，江如濯锦江。\n征帆向何处，云雾晦蓬窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与秦少章题汉江远帆五首 其四","author":"晁冲之","text":"江阔雁不到，山深猿自迷。\n传闻杜陵老，只在瀼东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与秦少章题汉江远帆五首 其三","author":"晁冲之","text":"雪埋凤林寺，浪打鹿门山。\n今日江风恶，郎船劝不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与秦少章题汉江远帆五首 其二","author":"晁冲之","text":"江山起暮色，草木敛馀昏。\n谁感离骚赋，丹青吊屈原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与秦少章题汉江远帆五首 其一","author":"晁冲之","text":"楚山全控蜀，汉水半吞吴。\n老眼知佳处，曾看八景图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以少炭寄江子之","author":"晁冲之","text":"金籍曾通玉虚殿，仙曹拟拜翠微郎。\n莫嫌薄上温黁火，犹得浓薰笃耨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王敦素许纸不至戏简促之","author":"晁冲之","text":"摩娑垢面戏陶泓，拂拭苍髯笑管城。\n已与陈玄俱绝倒，从君更召楮先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐府二首 其二","author":"晁冲之","text":"自摘酴醾满架空，拟将豪气敌春风。\n欲知盏面玻瓈阔，看照红颜在酒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐府二首 其一","author":"晁冲之","text":"病来饮不敌群豪，笑岸纱巾卸锦袍。\n一座空烦春笋手，玉杯乳酪贮樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉字黄庭经","author":"晁冲之","text":"宝气宵缠北斗间，仙书自把下天坛。\n误缘不是凡心起，月户云窗读字难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"晁冲之","text":"巧胜金花真乐事，堆盘细菜亦宜人。\n自惭白发嘲吾老，不上谯门看打春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏成","author":"晁冲之","text":"长夏轩窗倚碧岑，人间尘土莫相侵。\n榴花不得春风力，颜色何如桃杏深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏留次褒三十三弟","author":"晁冲之","text":"白下春泥尚未乾，汴流更待小潺湲。\n不知汝定成行不，寒食今无数日间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱少章曝麦为雨所漂","author":"晁冲之","text":"看书不觉雨如渑，稚子惊呼妻怒嗔。\n岂意持竿护鸡者，翻同挟策牧羊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵四兄芦 其一","author":"晁冲之","text":"公如柳柳州，柳桥如柳浪。\n恼杀涉溱人，望望不可上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱少章芦桥柳桥二首 其二","author":"晁冲之","text":"洞庭生白波，陇首起黄云。\n渔舟雾里见，羌笛月中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]