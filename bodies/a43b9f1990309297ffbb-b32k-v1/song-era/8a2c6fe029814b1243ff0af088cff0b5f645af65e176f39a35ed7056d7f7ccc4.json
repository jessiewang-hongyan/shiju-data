[{"title":"田六娘子下火","author":"释怀深","text":"浮生三十二春秋，方始修行肯转头。\n底事又随云雨去，烟波江上使人愁。\n休休休，不用愁，聚散还同水上沤。\n直饶寿得三十岁，不免输他这一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁忠训妻与女同下火","author":"释怀深","text":"二十馀年寄此间，盖芜尘土翳朱颜。\n今朝子母应相贺，且喜春来返故关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏先生下火","author":"释怀深","text":"呜呼魏大和，为人性纯厚。\n虽居陋巷中，箪瓢甘自守。\n聚学训童蒙，束脩粗糊口。\n岁晚好吾宗，悟世非长久。\n临行嘱妻子，叮咛诫诸后。\n不学老庄周，说葬成虚谬。\n不学襄阳翁，与女争先后。\n先生之意不如斯，欲效禅家破诸有。\n四众云臻，柴薪已就。\n虽然父子至亲，到此如何可救。\n不须救，生前已付山僧手。\n一枝红燄赠君行，看取神龟火里走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登云从禅师掩土","author":"释怀深","text":"莫问青囊与紫囊，个中风水十分强。\n青龙东去云头转，白虎西来山脚长。\n江月松风皆旧物，绿苔芳草尽吾乡。\n琉璃殿上无知识，木马泥牛暗断肠。\n不问湘南潭北，休论坎短离长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人散灰 其一","author":"释怀深","text":"言公心地最精专，曾学焦山一味禅。\n今日落盆盛白骨，翻身重上谢郎船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人散灰 其二","author":"释怀深","text":"俗寿五十有三，出家一十八夏。\n平生行脚游方，多在盐城兴化。\n最好不曾参禅，免见钻龟打瓦。\n今朝子细看来，也好一场诘霸。\n才公才公莫要怕，焦山布施你，一转古人话。\n净裸裸，赤洒洒，南北东西没可把。\n忽然撞著阎罗王，拈起拂子蓦口打。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人散灰 其三","author":"释怀深","text":"迢迢万里别西川，要学诸方五味禅。\n昨日焦山山下死，剑门关上月重圆。\n既是焦山山下死，因什么却向剑门关上月重圆。\n究竟光明终一体，任他寒影落千江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人散灰 其四","author":"释怀深","text":"衲僧才遇丙丁村，便作霜花骨一盆。\n火后始知梁不坏，翻身跳出是非门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人散灰 其五","author":"释怀深","text":"严兄严兄，善为道路。\n从今换骨洗肠，更莫和泥合土。\n熟处放教生，生处不要住。\n扬子江头浪拍天，莫教湿却娘生裤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人散灰 其六","author":"释怀深","text":"宣州隆上人，丛林游历遍。\n一入焦山门，便下延寿院。\n终朝何辘辘，吃药都无验。\n火后一茎茅，众人皆总见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其一","author":"释怀深","text":"只是旧时行李处，等闲举著便郩讹。\n夜来一阵狂风起，吹落桃花知几多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其二","author":"释怀深","text":"云自何山起，风从甚涧生。\n好个入头处，官路少人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古","author":"释怀深","text":"一火铸成金弹子，团圞都不费钳锤。\n拈来万仞峰头放，打落天边白凤儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞","author":"释怀深","text":"自顾个形骸，举止凡而陋。\n只因放得下，触事皆成就。\n醍醐与毒药，万味同一口。\n美恶尽销融，是故名慈受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元升座偈","author":"释怀深","text":"灵岩上元节，且与诸方别。\n只点一碗灯，大千俱照彻。\n也不用添油，光明长皎洁。\n雨又打不湿，风又吹不灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙尾砚同程致道联句","author":"毛随","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"方城高士","text":"莫讶杖藜归去早，家山闲却一溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题玉华洞","author":"刘峤","text":"洞南石燕接灵龟，狮子峥嵘气与齐。\n碧眼方瞳人不识，三山正在玉华西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李伯纪丞相挽诗三首 其一","author":"陈公辅","text":"豪杰不世出，为时斯间生。\n有心安社稷，无计避功名。\n忧国唯知重，谋身祇觉轻。\n徒令青史上，永永著英声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李伯纪丞相挽诗三首 其二","author":"陈公辅","text":"材大古难用，功多忌更多。\n忠怀冲日月，谗口肆风波。\n此老今亡矣，苍生独奈何。\n应遗一时恨，千载不能磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李伯纪丞相挽诗三首 其三","author":"陈公辅","text":"当时偶同罪，平昔岂相知。\n天下指为党，我公终不疑。\n空怀荆渚乐，已失雁山期。\n此意凭谁诉，临风有泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行诸山道中","author":"陈公辅","text":"我曾天台游，于今四十载。\n一朝忽复来，时节如有待。\n形骸觉老景，景色殊不改。\n雨中寻旧迹，触目云叆叇。\n岩瀑落千寻，涧花纷五彩。\n崖深藓苍苍，溪浅石磊磊。\n昔时所未到，足力胡可殆。\n要当至绝顶，直下小沧海。\n兹山八万丈，端的不吾绐。\n伟哉造化功，疑若有真宰。\n黄精煮甚食，茯苓良可采。\n何当诛茆居，此志终有在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游普庆院","author":"陈公辅","text":"满目云烟万叠山，梵宫深锁翠微间。\n市朝多少纷纷客，输却僧家一味闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天封瑞云阁","author":"陈公辅","text":"晴云漠漠水潺潺，危阁春归白日闲。\n若问祖师消息处，眼前环列是青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"陈公辅","text":"经营堂宇近江滨，退稳功成名遂身。\n门外鱼龙欣得地，圃中花木暖藏春。\n也知朝野思贤相，聊借湖山作主人。\n谁谓周公骄且吝，坐间无日不延宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"陈公辅","text":"平昔勋名绝辈流，正闲赢得去寻幽。\n春风陌上飞千骑，晓日林间映九斿。\n闽岭何妨传雅咏，龙庭行即告嘉猷。\n愿将屡秉钧衡手，留作他年几杖游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张子正观察溪风亭","author":"陈公辅","text":"我家近东城，南湖屡尝游。\n往时古堤岸，路暗行人愁。\n棘篱蔽荒圃，狸鼠呼啾啾。\n好景岂终废，发见端有由。\n张公山西将，帷幄久运筹。\n晚岁倦征讨，雅怀在林邱。\n人方弃不取，公乃得所求。\n除治见佳趣，经营出奇谋。\n竹窗清景乱，梅轩暗香浮。\n中间溪风亭，峥嵘跨碧流。\n虚檐极宏敞，坐见群山幽。\n终夜自泠泠，六月长飕飕。\n荡漾月波起，飘急云霭收。\n旷然天宇间，清思何悠悠。\n高朋几还往，玉斝时劝酬。\n相从同一醉，庶以消百忧。\n羡公强健身，万事心不留。\n独爱池馆闲，永日尝休休。\n公才自无双，何用叹不侯。\n试访旧识中，此乐宁有不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题苍岭","author":"陈公辅","text":"行到山危仆已痡，此身强健不须扶。\n回头指顾重冈险，得似人心险也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"肄业广慈院临别留一绝","author":"陈公辅","text":"来时膏雨迷新野，去日薰风吹旧林。\n寄语主人休惜别，白云南北本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叔厚内翰喜雪诗","author":"陈公辅","text":"动天须假至诚祈，诚若专时定弗违。\n冬后纵无三白应，春前俄有六花飞。\n著人但觉寒威重，拥火犹嫌酒力微。\n聊为使君歌上瑞，麦苗千顷已菲菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪晴可喜戏作四韵奉呈","author":"陈公辅","text":"盈尺阶前瑞已多，晓来天色渐晴和。\n青阳一气应回暖，黄竹三章且罢歌。\n小雨洗时岚滴翠，细风吹处沼生波。\n东郊便好寻芳去，桃李争妍映绮罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予与德升尚书招已懋端明叔厚内翰会饮因有倡和佳篇谩次前韵呈三兄","author":"陈公辅","text":"盛朝多少旧公卿，谁似三人负大名。\n金带并趋清禁路，玉杯同醉白云城。\n吾侪出处真成戏，俗眼观瞻祇自惊。\n便恐名随封诏去，且频开宴慰交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏和德升赏梅因记十三日梅园之游发诸兄一笑","author":"陈公辅","text":"我闻永庆梅，孤标寄岩阴。\n衰年苦多病，咫尺未暇寻。\n公心亦似铁，惜花情却深。\n爱此独株好，何必须满林。\n兹游恨莫陪，有酒谁与斟。\n因思东郊上，琼蕊满髻簪。\n黄昏月下归，翠袖寒易侵。\n想公见戏语，一笑开胸襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石鼓山","author":"陈公辅","text":"有山名石鼓，千古镇南溟。\n大手不劳力，动时天下惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净明寺阅藏经","author":"陈公辅","text":"三载功夫一藏经，非禅非道亦非僧。\n但凭方寸行诸善，也是如来最上乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"陈公辅","text":"白发鬅鬙未得闲，有时览镜笑衰颜。\n逢人载酒宁辞醉，寓意题诗不用删。\n幸有鉴湖堪寄傲，直惭书殿尚通班。\n豁除簿领尘矣了，却上蓬莱看好山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"述怀谢陈去非见访","author":"陈公辅","text":"愧无直节报朝廷，富贵端能一羽轻。\n若比公孙终作相，宁堪汲黯止为卿。\n吾曹学古当然事，俗眼看人只自惊。\n赖有同年曲江客，每回相过语平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句三首 其一","author":"陈公辅","text":"雨过疏窗分外凉，隔帘风引芰荷香。\n江湖六月生秋思，清梦回时月满床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句三首 其二","author":"陈公辅","text":"夹岸古榆清荫密，傍檐斜月冷光疏。\n晚凉一枕邯郸梦，半夜西风已满裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句三首 其三","author":"陈公辅","text":"京国重来一梦间，不堪回首赤城山。\n隋堤古柳年年在，应笑行人鬓已班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"陈公辅","text":"有德传乡里，无金遗子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章序臣得铜雀砚属余作诗","author":"何薳","text":"阿瞒恃奸雄，挟汉令天下。\n惜时无英豪，磔裂异肩踝。\n终令盗坏土，埏作三台瓦。\n虽云当涂高，会有食槽马。\n人愚瓦何罪，沦蛰翳梧槚。\n锡花封雨苔，鸳彩晦云罅。\n当时丹油去，实非谋诸野。\n因之好奇士，探琢助挥写。\n归参端歙材，坚泽未渠亚。\n章侯捐百金，访获从吾诧。\n兴亡何复论，徒足增忿骂。\n但嗟瓦砾微，亦以材用舍。\n徒令瓴甓馀，当擅琼瑰价。\n士患德不修，不忧老田舍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华盖仙山院","author":"何薳","text":"旧闻山隐弥天释，几欲从谈不二门。\n寻到经窗收足座，却应宾主两忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"何藗","text":"不使翠分旁牖去，却缘清甚畏人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"张图南","text":"坐中竞病分明久，驴上推敲兀未裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其一","author":"释绍隆","text":"穷诸玄辩，竭世枢机。\n百千法门，无量妙义。\n总在个里，不隔一丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其二","author":"释绍隆","text":"掩室摩竭，杜口毗耶。\n面壁九年，黄梅夜渡。\n点简将来，翻成计较。\n殊不知日不待火而热，月不待风而凉。\n云龙，风从虎。\n作无作，为无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其三","author":"释绍隆","text":"悠悠世事空浮沉，自爱白云岁月深。\n举眼尽非凡草木，刚然断臂觅安心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其四","author":"释绍隆","text":"寰中天子敕，塞外将军令。\n一句定乾坤，一剑平天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其五","author":"释绍隆","text":"牛头没，马头回，渠无国土。\n无位真人，突出难辩甚处。\n逢渠击石火，闪电光得不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其六","author":"释绍隆","text":"万里浮云捲碧天，年年此夜十分圆。\n令人转忆寒山子，说似吾心恰宛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其七","author":"释绍隆","text":"眼里不著沙，耳里不著水。\n堪笑老俱胝，无端竖一指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其八","author":"释绍隆","text":"大智圆明，体无向背。\n凝然湛寂，弥满太虚。\n覆盖乾坤，常光独露。\n削踪灭迹，离相绝名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其九","author":"释绍隆","text":"炎暑蒸人汗似汤，盐官用底岂寻常。\n轻摇休问犀牛在，拈出清风宇宙凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十","author":"释绍隆","text":"一滴水，一滴冻，喝下风雷彰大用。\n棒头点出眼睛来，照了诸相悉空洞。\n出门撞著须菩提，拶破虚空全体露。\n一片虚凝绝谓情，万里清光飞玉兔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十一","author":"释绍隆","text":"目前无法，万象森然。\n意在目前，突出难辨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十二","author":"释绍隆","text":"离四句，绝百非，阃外风光谁得知。\n牛头没，马头回，空生岩畔碧崔嵬。\n一口吸西江，一句该万象。\n一月普现一切水，一切水月一月摄。\n重重主伴，历历交参。\n品汇兹彰，人天正眼。\n如斯告报，只要知归。\n苟或未然，便见生死。\n交谢寒暑，迭迁北里。\n豪家昨日歌兮今日哭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十三","author":"释绍隆","text":"光非照境，境亦非存。\n光境俱忘，复是何物。\n百草头上，罢却干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十四","author":"释绍隆","text":"日日日东出，日日日西没。\n人命在呼吸，百年轻倏忽。\n蓦地得逢渠，掀翻生死窟。\n放出辽天鹘，万重云一突。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十五","author":"释绍隆","text":"示现天宫补处身，尧风舜日耀乾坤。\n今朝共祝南山寿，万国来朝万乘尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十六","author":"释绍隆","text":"大地撮来粟米粒，一毛头上现乾坤。\n居家不离途中事，常在途中不出门。\n喝一喝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十七","author":"释绍隆","text":"田地隐密，鬼家活计。\n从空放下，坐井窥天。\n虎丘门下，不说老婆禅。\n只要诸人眼横鼻直，三十年后免得敲■打瓦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十八","author":"释绍隆","text":"物宜求新，人宜求旧。\n不起于座，现诸威仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其十九","author":"释绍隆","text":"当阳正体露堂堂，休谓当年付饮光。\n彼既丈夫我亦尔，颍将好肉更剜疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其二十","author":"释绍隆","text":"百鸟不来春又暄，凭栏溢目水如天。\n无心还似今宵月，照见三千及大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其二十一","author":"释绍隆","text":"放一线道，曲为今时。\n性地未明，须凭指注。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其二十二","author":"释绍隆","text":"一二三四五，梅雨炎蒸暑。\n碓觜也生花，道芽知几许。\n古佛与露柱交参，猫儿咬杀犯罪虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其二十三","author":"释绍隆","text":"病起云山草木秋，浮华世事谩悠悠。\n从来万法不为侣，何以韶阳六不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二十七首 其二十四","author":"释绍隆","text":"如来三转于大千，赵州半藏亦如然。\n其轮本来常清净，一念承当谁后先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]