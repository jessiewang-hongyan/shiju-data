[{"title":"偈六十三首 其五十","author":"释道宁","text":"兔走乌飞，暗移时节。\n入夏早三旬，衲僧彻未彻。\n休寻向上关，莫问西来诀。\n健则松径閒行，困则堂中便歇。\n恩光一道皎然，旷劫未尝生灭。\n无物可并雌黄，教我云何剖说。\n回头踏著自家乡，始信秤锤浑是铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十九","author":"释道宁","text":"妙孤峰顶，竟日不逢。\n菩提场中，随处合会。\n孰谓祖师关棙险，等閒拈出与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十八","author":"释道宁","text":"高提祖印，独耀寰区。\n坐却舌头，圣凡罔测。\n声前要旨，妙叶难该。\n句后玄关，金针双锁。\n通人分上，肯受提撕。\n懞懂禅流，徒誇作略。\n设使五湖衲子，四海高人。\n问似龙飞凤舞，答如玉转珠回。\n向本分事中，白云万里。\n诸缘不涉，岂落今时。\n混沌未分全体现，乾坤才剖失便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十七","author":"释道宁","text":"一人发真归源，十方虚空，悉皆销殒。\n浑家不是不进步，无奈当门荆棘生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十六","author":"释道宁","text":"田中稻子已焦黄，颗粒圆成不并常。\n妙手及时收拾后，五湖龙象济饥疮。\n剑为不平离宝匣，药因救病出金瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十五","author":"释道宁","text":"先贤垂范，语真如弦。\n衲子奔波，刚然不顾。\n粉骨碎身未足酬，一句了然超百亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十四","author":"释道宁","text":"云收天际，雾捲长空。\n坐立俨然，谁家风月。\n这里荐得，早涉崎岖。\n更待商量，般雪填井。\n不许夜行刚把火，直须当道与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十三","author":"释道宁","text":"灵山顾视，迦叶亲闻。\n白藕峰前，卢公契旨。\n直饶针芥相投，未免随波逐浪。\n俱成胜负，犹涉驱驰。\n争似青天为幕，夜月为钩。\n卧藤萝下，块石枕头。\n踏得故关田地稳，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其四十","author":"释道宁","text":"万里无云，长天一色。\n不落古今，那该彼此。\n要津把断，风骨旋生。\n设使灵山密付，谩说拈华少室，亲传徒誇得髓。\n师子窟中无异兽，象王行处绝狐踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十九","author":"释道宁","text":"秋日耀长空，秋江浸虚碧。\n伤嗟门外人，处处寻弥勒。\n蓦路忽抬头，相逢不相识。\n剪尽霜前竹，临溪不化龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十六","author":"释道宁","text":"空空至理，杳绝纤埃。\n功勋不到，妙叶难该。\n不落是非中，有无争敢和。\n何劳指注，便请承当。\n过后追风，徒誇好手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十五","author":"释道宁","text":"全提要妙，三藏绝诠。\n海印舒光，该罗法界。\n有情无情，炳然应现。\n有时南州北郡，买卖交关。\n有时看风把柁，顺水行船。\n有时酒肆茶坊，迎宾待客。\n有时投壶走马，歌笑围棋。\n种种多般，要源流出。\n玄关瞥转，大用现前。\n一槩无私，平等大道。\n始知诸佛转法轮，群生解差别。\n目击便归来，秤锤浑是铁。\n如斯告报，正属化门，不犯锋楞。\n善吉岩前草不生，侨尸谩把天花散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十四","author":"释道宁","text":"人天普集，龙象交参。\n大事全彰，云何不顾。\n须待提纲举要，鼓唱玄风。\n蔟锦攒花，以为谛当。\n都无所益，枉费心机。\n奈缘中下之流，无由凑泊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十三","author":"释道宁","text":"空王门下，法令当行。\n列局分司，利生为务。\n无明海内，驾起慈舟。\n入我山中，盛栽忍草。\n伶俜游子，诱引还家。\n直指衣中，久怀至宝。\n获解脱道，證本圆常。\n报佛深恩，方名垂手。\n不伤风化，物义两全。\n金殿玉堂留不住，披毛戴角又重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十二","author":"释道宁","text":"经入藏，禅归海。\n未足衲僧亲道底，拂袖前行归去来，击碎重关门大启。\n长安夜夜家家月，几处笙歌几处愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十一","author":"释道宁","text":"遍界不曾藏，通身无影像。\n相逢莫讶太愚痴，旷劫至今无伎俩。\n无伎俩，少人知。\n大体还他肌骨好，何须照镜画娥眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十","author":"释道宁","text":"浩浩尘中，善能垂手。\n悲智冥符，古今希有。\n深入总持门，气宇冲斗牛。\n目连鹙子，攒眉妙德，空生缄口。\n一句无私，扫际窠臼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十九","author":"释道宁","text":"是法住法位，世间相常住。\n南山叆叇生云，北山滂沱下雨。\n通身是口，阿师比拟。\n徒誇唇觜，把定放行。\n目前火急便还家，莫认殊乡为故里。\n官不容针，私通车马。\n幸对人天，何妨诘问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十八","author":"释道宁","text":"乾坤之内，宇宙之中。\n高悬舜日，大扇尧风。\n祝一人之寿算，祈万世之穹隆。\n唯吾家佛子受赐颇多，物外优游凭何祝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十七","author":"释道宁","text":"大道无私，遇缘展缩。\n年年四月，今朝普请，方来禁足。\n寒山亸袖舞三台，拾得横琴弹一曲。\n一二三，四五六。\n夏雨布长空，清声发幽谷。\n直饶不堕宫商，也是强生节目。\n争如野外农夫，击壤高歌鼓腹。\n不学禅律威仪，免见蜡人随逐。\n丹凤不栖无影树，直透烟霄意自殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十六","author":"释道宁","text":"漏泄春消息，梅花遍界开。\n千峰无异色，平地绝纤埃。\n莫谓白牛无觅处，普贤招手待君来。\n急回首，不须猜。\n乾坤都一片，何用更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十五","author":"释道宁","text":"祖师门下，妙旨无私。\n不堕物机，混融凡圣。\n所以涅槃城里，作者犹嗤。\n明月堂前，道人不顾。\n灰身灭智，岂是丈夫。\n避色逃声，何名作者。\n捞龙打凤，须信男儿。\n露刃藏锋，还他开士。\n化城抹过，宝所非遥。\n独步坤维，何人境界。\n打破画瓶归去后，南山下雨北山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十三","author":"释道宁","text":"药山老汉慎初护末，佛眼难窥。\n院主狭路相逢，等閒蹉过。\n至今千古之下，挂人齿牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十二","author":"释道宁","text":"大家东咬西咬，忽然咬著一个。\n始知是处绿杨堪系马，家家门庭透长安。\n坐断千圣舌头，露出平生光彩。\n莫嫌冷淡无滋味，一饱能忘万劫饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十一","author":"释道宁","text":"先贤垂范，巧妙临时。\n解烹露地白牛，惯炊黍米香饭。\n煮野菜羹，唱村田乐。\n更深夜静，与众分冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十九","author":"释道宁","text":"先贤垂范，流落人间。\n日久岁深，禅人不顾。\n语非玄妙，直透重关。\n画瓶打破，渌水青山。\n莫讶报慈多冷淡，得盘桓处且盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十七","author":"释道宁","text":"滂沱天际雨，嘹喨寺亭钟。\n耳目不到处，翻怜面壁翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十六","author":"释道宁","text":"此方真教体，清净在音声。\n欲入三摩提，实从闻中證。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十五","author":"释道宁","text":"湘山青，湘水碧。\n上下四维，东西南北。\n处处释迦，头头弥勒。\n啐啄同时，无劳外觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十四","author":"释道宁","text":"以字不是八不成，无言童子笑忻忻。\n优昙华现人间瑞，鼻孔通天嗅不闻。\n日月不到处，特地好乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十二","author":"释道宁","text":"熙熙风景不相饶，免见丹霞把佛烧。\n莫谓开炉无一事，汾阳扇子手中摇。\n祖师密旨，杳绝纤埃。\n应用无私，匪亏时节。\n寒时寒，热时热。\n木佛放光明，院主生忻悦。\n绢扇足风凉，衲僧摇不彻。\n分明漏泄天机，底事因何不瞥。\n若也玄关拨转，自然心眼豁开。\n方信普通年远事，岂从葱岭带将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十一","author":"释道宁","text":"问答尖新逞峻机，如将画饼要充饥。\n纵经尘劫空劳力，争似忘言合大虚。\n万古碧潭空界月，再三捞摝始应知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十","author":"释道宁","text":"时光迅速，不与人期。\n刹那异世，早见岁除。\n未明心地，难免狐疑。\n设使问似百川竞注，答如大海吞流。\n古佛堂中，都用不著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其九","author":"释道宁","text":"禅人莫莽卤，二月又初五。\n透彻祖师关，一句该今古。\n春色无高下，园林花木红。\n总持门大启，何处觅圆通。\n休问迷逢达磨，须知垂手尘中。\n踏翻厚地，刺破虚空。\n人天榜样，佛祖家风。\n敢与龙王斗富，自他兼济何穷。\n翻身不露迹，直上妙高峰。\n渠无面目，三界为家。\n解把过头杖，逢春点异花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其七","author":"释道宁","text":"报慈家风，淡薄厨堂。\n诸事萧索，唯有金刚。\n眼睛四海，禅人咬嚼。\n咬得破，旷劫无明。\n须臾销铄，天上人间，自在快乐。\n咬不破，成结缚。\n六用门头，尘缘竞作。\n你咬嚼，閒处著。\n灿烂无瑕，光明闪烁。\n几回觌面相呈，自是诸人讳却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其五","author":"释道宁","text":"开门待知识，知识不来过。\n知识既过，凭何施设。\n金果早朝猿摘去，玉花晚后凤衔来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三","author":"释道宁","text":"未透祖师关，时光如箭急。\n白发皓然生，新年又五日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二","author":"释道宁","text":"不是风动，不是幡动，仁者心动。\n大小老卢，好与三十棒。\n只知穿靴，不觉裤绽。\n鸟啼处处皆相似，花落不闻流水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其一","author":"释道宁","text":"春风习习，春日熙熙。\n鸟啼东岭上，花发树南枝。\n园林并紫陌，赏玩颇相宜。\n行人半醉半醒，游客似憨似痴。\n或歌或舞，或笑或悲。\n头头尽是吾家事，处处全彰妙总持。\n因甚把住，特地生疑。\n辜他古德，努力披陈。\n不省这个意，脩行徒苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辩禅人五羊作丐写师真求赞","author":"释道宁","text":"非幻非真，僧繇难写。\n貌不惊人，权衡保社。\n画虎作猫，指驴为马。\n月彩分辉，风清大夏。\n五羊城里旧知音，觌面相呈那辩也。\n慇勤寄语莫狐疑，便是蒋山宁道者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其四十一","author":"释道宁","text":"宗门奥旨，祖室玄枢。\n不遇当人，翻成影响。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其三十七","author":"释道宁","text":"摩竭掩室，非是通方。\n净名杜词，未为作略。\n总不恁么，罕遇知音。\n方便门中，随宜举唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其三十四","author":"释道宁","text":"衲子玄关，群生命脉。\n锋芒未兆，便好承当。\n文彩才彰，翻成影事。\n空劫已前，乾坤未剖。\n凝然一片，非圣非凡。\n不涉熏脩，岂从外有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其三十二","author":"释道宁","text":"透脱玄关，更无凝滞。\n一瞖落眼，空华乱坠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其二十三","author":"释道宁","text":"大道无私，要由心悟。\n心无形状，全物而彰。\n妙契斯关，万缘俱备。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其八","author":"释道宁","text":"千圣不传，诸祖秘语。\n不惜眉毛，为君亲举。\n衲子抬眸，白云万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其十七","author":"释道宁","text":"难中之难，妙中之妙。\n千圣攒眉，是何关要。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其五","author":"释道宁","text":"棋逢敌手，密行难藏。\n琴遇知音，希声乃布。\n摩竭正令，同道方知。\n捏聚放开，悟迷一决。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其三","author":"释道宁","text":"没弦琴韵，罕遇知音。\n无影林中，难寻足迹。\n同声同气，方辨端倪。\n不是当家，徒劳侧耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十九首 其一","author":"释道宁","text":"宝座既登，清风四起。\n要津把断，凡圣俱亡。\n放一线道，别露风规。\n具眼禅人，一任施设。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其五十五","author":"释道宁","text":"大道皎然，本无迷悟。\n杳忘三际，超越上乘。\n透古透今，非玄非妙。\n通同法界，一种平怀。\n古路无私，何人措足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其三十七","author":"释道宁","text":"应机不妙，展事难谐。\n检点将来，弄巧成拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十","author":"释道宁","text":"凛凛玄风，尘尘三昧。\n信手拈来，曾无障碍。\n不用安排，素非憎爱。\n透过斯关，逍遥自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其十三","author":"释道宁","text":"兵随印转，将逐符行。\n把断要关，不通音信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其八","author":"释道宁","text":"真不掩伪，曲不藏直。\n句里明人，言中辨的。\n处处总持，头头弥勒。\n拟议思量，当门荆棘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送雪峰化主","author":"释道生","text":"三毬辊动错流传，大用何曾得现前。\n千五百僧无顿放，累人走得脚皮穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送道者干澜溪桥","author":"释道生","text":"万古澜溪上，无风浪拍空。\n路穷桥断处，看子展神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其二十一","author":"释道生","text":"明星觑著眼睛枯，绝后何曾得再苏。\n堪笑堪悲缘底事，一年一度被茶糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十九","author":"释道生","text":"平旦清晨三月朝，南山苍翠插云霄。\n不须更觅西来意，窗外数声婆饼焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十五","author":"释道生","text":"浮云散尽月当空，兔子怀胎产大虫。\n跳出风前弄牙爪，至今撼动广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其六","author":"释道生","text":"古帆高挂入曹源，雷动风行海岳昏。\n三十二峰亲坐断，一毛头上定乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其五","author":"释道生","text":"披毛带角入廛来，跳出驴胎堕马胎。\n佛手明明遮不得，从教平地起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其四","author":"释道生","text":"一九与二九，相逢不出手。\n巍巍不动尊，脚不离地走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题长干塔","author":"释道生","text":"舍利无端应念来，浮图平地拥崔嵬。\n当年不假金锤力，争得光明耀九垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题庐山圆通","author":"释道生","text":"水声山色里，猿啸月明天。\n唤作圆通境，更参三十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题烈山","author":"释道生","text":"舟船来往此登临，酹酒烧钱虑转深。\n大抵人心自巇崄，心空山岳自平沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送闻兄持钵","author":"释道生","text":"闻声悟道鸟投笼，祇么无闻道未充。\n和剑拂开悭吝穴，全身辊入是非丛。\n脚头脚尾无虚弁，山北山南有路通。\n一笑归来能事毕，真金百鍊见全功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]