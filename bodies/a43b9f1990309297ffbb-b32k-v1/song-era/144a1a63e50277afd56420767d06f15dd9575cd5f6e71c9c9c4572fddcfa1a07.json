[{"title":"上湖閒泛舣舟石函因过下湖小墅","author":"林逋","text":"平皋望不极，云树远依依。\n及向扁舟泊，还寻下濑归。\n青山连石埭，春水入柴扉。\n多谢提壶鸟，留人到落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园春日","author":"林逋","text":"草烟横碧露华微，乘兴春园懒欲归。\n聚散有情输蛱蝶，浅深无色比蔷薇。\n浮名莫惜千钟贵，急景须防百岁稀。\n一事不堪身衣褐，且偷闲眼看芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小圃春日","author":"林逋","text":"岸帻倚微风，柴篱春色中。\n草长团粉蝶，林暖坠青虫。\n载酒为谁子，移花独乃翁。\n于陵偕隐事，清尚未相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小隐","author":"林逋","text":"门径独萧然，山林屋舍边。\n水风清晚钓，花日重春眠。\n苒苒苔衣滑，磷磷石子圆。\n人寰诸洞府，应合署閒仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小隐","author":"林逋","text":"鲁望无来已百年，又生吾辈在林泉。\n谁知隐遁为高尚，敢道文章到圣贤。\n月界晓窗琴岳润，竹摇秋机墨云鲜。\n南塘一霎霏微雨，更拥渔蓑上钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小隐自题","author":"林逋","text":"竹树绕吾庐，清深趣有馀。\n鹤閒临水久，蜂懒采花疏。\n酒病妨开卷，春阴入荷锄。\n尝怜古图画，多半写樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中冬日","author":"林逋","text":"残雪照篱落，空山无俗諠。\n鸡寒懒下树，人晏独开门。\n废圃春荣动，回塘雾气昏。\n谁家岁酒熟，辍棹忆西村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中寄招叶秀才","author":"林逋","text":"夜鹤晓猿时复闻，寥寥长似耿离群。\n月中未要恨丹桂，岭上且来看白云。\n棋子不妨临水著，诗题兼好共僧分。\n新忧他日荣名后，难得幽栖事静君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅二首 其二","author":"林逋","text":"剪绡零碎点酥乾，向背稀稠画亦难。\n日薄从甘春至晚，霜深应怯夜来寒。\n澄鲜只共邻僧惜，冷落犹嫌俗客看。\n忆著江南旧行路，酒旗斜拂堕吟鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅二首 其一","author":"林逋","text":"众芳摇落独暄妍，占尽风情向小园。\n疏影横斜水清浅，暗香浮动月黄昏。\n霜禽欲下先偷眼，粉蝶如知合断魂。\n幸有微吟可相狎，不须檀板共金尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山村冬暮","author":"林逋","text":"衡茅林麓下，春色已微茫。\n雪竹低寒翠，风梅落晚香。\n樵期多独往，茶事不全忙。\n双鹭有时起，横飞过野塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山谷寺","author":"林逋","text":"才入禅林便懒还，众峰深壑共孱颜。\n楼台冷簇云萝外，钟磬晴敲水石间。\n茶版手擎童子净，锡枝肩倚老僧闲。\n独孤房相碑文在，几认题名拂藓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山舍小轩有石竹二丛鬨然秀发因成二章 其二","author":"林逋","text":"青帘有酒不妨赊，素壁无诗未足誇。\n所重晚芳犹在日，可关秋色易为花。\n深枝苒苒妆溪翠，碎片英英剪海霞。\n莫管金钱好行市，寂寥相对是山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山舍小轩有石竹二丛鬨然秀发因成二章 其一","author":"林逋","text":"麝香眠后露檀匀，绣在罗衣色未真。\n斜倚细丛如有恨，冷摇疏朵欲生春。\n阶前红药推词客，篱下黄花重古人。\n今日含毫与题品，可怜殊不愧清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山阁偶书","author":"林逋","text":"绕舍青山看未足，故穿林表架危轩。\n但将松籁延佳客，常带岚霏认远村。\n吴榜自能凌晚汰，湘累何苦属芳荪。\n馀生多病期怡养，聊此栖迟一避喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中峰","author":"林逋","text":"中峰一径分，盘折上幽云。\n夕照前村见，秋涛隔岭闻。\n长松含古翠，衰药动微薰。\n自爱苏门啸，怀贤思不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中峰行乐却望北山因而成咏","author":"林逋","text":"拂石玩林壑，旷然空色秋。\n归云带层巘，疏苇际沧洲。\n固自堪长往，何为难久留。\n庶将濠上想，聊作剡中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"历阳寄金陵衍上人","author":"林逋","text":"藓晕莎丛古石房，寺和松竹背秋冈。\n骚吟未断云生褐，梵偈重开月照香。\n五老旧游应悄默，六朝闲事肯悲凉。\n西州独客心摇甚，抹碧江天鸟一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无为军","author":"林逋","text":"掩映军城隔水乡，人烟景物共苍苍。\n酒家楼阁摇风旆，茶客舟船簇雨樯。\n残笛远砧闻野墅，老苔寒桧看僧房。\n狎鸥更有江湖兴，珍重江头白一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日卫枢至","author":"林逋","text":"冷话复长吟，俱非俗者心。\n空斋留并宿，几度梦相寻。\n鸟乱槐枝折，烟微雪气侵。\n如何急前去，羸马万山深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出泉水驿","author":"林逋","text":"晓城寒水共萧萧，湿碧吹青路一条。\n烟霭浓间出山驿，林萝深里过溪桥。\n闲情谩会吟兼画，隐事犹输钓与樵。\n多谢孤村人落外，酒旗风急更相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出曹川","author":"林逋","text":"诗怀动叹嗟，驴立帽阴斜。\n雨泺生新碱，茅丛夹旧槎。\n午烟昏独店，冈路透谁家。\n几日江南兴，扁舟泊岸沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城寺水亭","author":"林逋","text":"金井前朝事，林僧问不知。\n绿苔欺破阁，白鸟占閒池。\n清楚曾经晋，荒唐直到隋。\n南廊一声磬，斜照独凝思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梁峡口怀朱严从事之官岭外两夕舟次于此","author":"林逋","text":"苍莽江湾尽入深，数家村坞在山阴。\n烟横落木寒初静，水带微阳晚未沉。\n极览定非他辈事，不来终负此生心。\n鲈鱼斫鲙松醪酒，曾属诗人两日吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤朱寺丞","author":"林逋","text":"妻女飘零五岭头，为君南望涕横流。\n浮荣暂得衣朱绂，远宦寻闻丧白州。\n天与声名还自折，瘴侵编什有谁收。\n朝中交旧知多少，应惜无儿似邓攸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华阳洞","author":"林逋叟","text":"华阳山雨拂轻尘，独步烟霞访隐真。\n笑傲太平云外客，安闲清世梦中身。\n金章名重人称贵，布褐才高道不贫。\n吟罢洞天风正淡，自知凡骨定逢人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊薛公孟","author":"林逋","text":"未第身魂殁帝京，东还长欠奠幽灵。\n遗文尽合编家传，高行谁堪撰墓铭。\n谈柄寂寥尘久暗，墨池荒废草空青。\n三招不见山巾湿，拟画轩昂太白星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安福县途中作","author":"林逋","text":"诗景纷拿且按鞭，坏桥危磴已鸣泉。\n云根道店多沽酒，山崦人家亦种田。\n谷鸟惊啼冲宿雨，野梅愁绝闭寒烟。\n玉梁阁皂堪行遍，回得临江即上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寺居","author":"林逋","text":"浩然巾杖立秋钟，院舍门门细径通。\n柏子有芽生塔地，鹤毛无响堕廊风。\n闲栖已合称高士，清论除非对远公。\n不厌浮尘拟何了，片心难舍此缘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其四","author":"林逋","text":"掉臂何妨入隐沦，高贤应总贵全真。\n次山有以称聱叟，鲁望兼之传散人。\n拂水远天孤榜晚，夹村微雨一犁春。\n不知图画谁名手，状取江湖太古民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其三","author":"林逋","text":"湖上山林画不如，霜天时候属园庐。\n梯斜晚树收红柿，筒直寒流得白鱼。\n石上琴尊苔野净，篱阴鸡犬竹丛疏。\n一关兼是和云掩，敢道门无卿相车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"林逋","text":"散帙挥毫总不忺，病怀愁绪坐相兼。\n苔痕作意生秋壁，树影无端上古帘。\n一壑等闲甘汩汩，五门平昔避炎炎。\n惟应数刻清凉梦，时曲颜肱兴未厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其一","author":"林逋","text":"短褐萧萧顶幅巾，拥书才罢即嚬呻。\n耕樵可似居山者，饮馔长如病酒人。\n闭户不无慵答客，焚香除是静朝贞。\n前贤风概聊希拟，一刺偏多井大春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上春日","author":"林逋","text":"一池春水绿于苔，水上花枝竹间开。\n芳草得时依旧长，文禽无事等闲来。\n年颜近老空多感，风雅含情苦不才。\n独有浴沂遗想在，使人终日此徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上春日即事","author":"林逋","text":"鸳鸯如绮杜蘅肥，鸂鶒夷犹翠潋微。\n但据汀洲长并宿，莫冲烟霭辄惊飞。\n已输谢客清吟了，未忍山翁烂醉归。\n钓艇自横丝雨霁，更从蒲筱媚斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池阳山店","author":"林逋","text":"数家村店簇山旁，下马危桥已夕阳。\n惊鸟忽冲溪霭破，暗花闲堕堑风香。\n时间盘泊心犹恋，日后寻思兴必狂。\n可惜回头一声笛，酒旗斜曳出疏篁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百舌","author":"林逋","text":"柳条初重草初肥，烟湿园林晚未晞。\n百种堪怜巧言语，一般惟久好毛衣。\n欺凌红杏从头宿，讽刺黄鹂趁背飞。\n谁道关关便多事，更能缄默送芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西村晚泊","author":"林逋","text":"弭棹危桥外，霜村乍夕阴。\n田园向野水，樵采语空林。\n白鸟归飞远，青山重复深。\n那堪迟新月，谁复赏微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西岩夏日","author":"林逋","text":"蕙帐萧闲掩弊庐，子真岩石坐来初。\n为惊野鸟巢间乳，懒过邻僧竹里居。\n新溜迸凉侵静语，晚云浮润上残书。\n何烦彊捉白团扇，一柄青松自有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西梁山下泊船怀别润州杲上人","author":"林逋","text":"画图行李是随缘，立别江头雨霁天。\n铁瓮独归三月寺，铜瓶轻挂两潮船。\n吟焚篆籀香初竭，老拥云霞衲已穿。\n昨夜西梁山下月，为师怀想几凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖","author":"林逋","text":"混元神巧本无形，匠出西湖作画屏。\n春水净于僧眼碧，晚山浓似佛头青。\n栾栌粉堵摇鱼影，兰杜烟丛阁鹭翎。\n往往鸣榔与横笛，细风斜雨不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖舟中值雪","author":"林逋","text":"浩荡弥空阔，霏霏接水濆。\n舟移忽自却，山近未全分。\n冻轸间清泛，温炉接薄薰。\n悠然咏招隐，何许叹离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖泛舟入灵隐寺","author":"林逋","text":"水天相映淡浟溶，隔水青山无数重。\n白鸟背人秋自远，苍烟和树晚来浓。\n桐庐道次七里濑，彭蠡湖间五老峰。\n辍棹迟回比未得，上方精舍动疏钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖孤山寺后舟中写望","author":"林逋","text":"天竺横分景色宽，孤山背后泊船看。\n林藏野路秋偏静，水映渔家晚自寒。\n拂拂烟云初淡荡，萧萧芦苇半衰残。\n舂锄数点谁惊起，书破晴云粉字乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖春日","author":"王安国","text":"争得才如杜牧之，试来湖上辄题诗。\n春烟寺院敲茶鼓，夕照楼台卓酒旗。\n浓吐杂芳薰巘崿，湿飞双翠破涟漪。\n人间幸有蓑兼笠，且上渔舟作钓师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过芜湖县","author":"林逋","text":"诗中长爱杜池州，说著芜湖是胜游。\n山掩县城当北起，渡冲官道向西流。\n风稍樯碇网初下，雨摆鱼薪市未收。\n更好两三僧院舍，松衣石发斗山幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园池","author":"林逋","text":"一径衡门数亩池，平湖分张草含滋。\n微风几入扁舟意，新霁难忘独茧期。\n岛上鹤毛遗野迹，岸旁花影动春枝。\n东嘉层构名今在，独愧凭阑负碧漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园庐","author":"林逋","text":"柴关寒井对萧辰，自爱栖迟近古人。\n闲草遍庭终胜俗，好书堆案转甘贫。\n桥边野水通渔路，篱外青山见寺邻。\n懒为躬耕咏梁甫，吾生已是太平民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园庐秋夕","author":"林逋","text":"兰杜裛衰香，开扉趣自长。\n寒烟宿墟落，清月上林塘。\n意想殊为适，形骸固可忘。\n援琴有馀兴，聊复寄吟觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿阳城南写望怀历阳故友","author":"林逋","text":"楚山重叠矗淮濆，堪与王维立画勋。\n白鸟一行天在水，绿芜千阵野平云。\n孤崖拂阁晴光见，极浦渔舟晓未分。\n吟罢骚然略回首，历阳诗社久离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀长吉上人北游","author":"林逋","text":"青山日已远，香裓渐多尘。\n应爱淮流上，聊逢月色新。\n孤禅安逆旅，警句语谁人。\n复有伤离客，中林病过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杏花","author":"林逋","text":"蓓蕾枝梢血点乾，粉红腮颊露春寒。\n不禁烟雨轻欺著，只好亭台爱惜看。\n隈柳旁桃斜欲坠，等莺期蝶猛成团。\n京师巷陌新晴后，卖得风流更一端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居书事兼简陈贤良","author":"林逋","text":"抱关随俗本无能，却掩深居避爱憎。\n两岸解惊秋钓石，风窗花落夜棋灯。\n穿云寄药多山叟，刻竹留诗半野僧。\n吟阁晚凉堪共望，远峰苍翠势层层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴岸晓行","author":"林逋","text":"驴仆剑装轻，寻河早早行。\n孤烟开道店，平野喝农耕。\n老木回堤暗，初阳出浪明。\n羁游事无尽，尘土拂吾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和天竺慈云大师","author":"林逋","text":"林表飞来色，犹怜久卜邻。\n沿洄一水路，梦想五天人。\n谢绝空园草，沉冥满几尘。\n暮云如有得，宁谢寄声频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史宫赞","author":"林逋","text":"门对远岑青，常时亦懒扃。\n久贫惭嗜酒，多病负穷经。\n鹤迹秋偏静，松阴午欲亭。\n蜀庄何足问，惟解事沉冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱仲方送然社师无为还历阳","author":"林逋","text":"归路过东关，行行一锡间。\n破林霜后月，孤寺水边山。\n顶笠冲残叶，腰装歇暮湾。\n香灯旧吟社，清思逐师还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和西湖霁上人寄然社师","author":"林逋","text":"竹下经房号白莲，社师高行出人天。\n一斋巾拂晨钟次，数礼香灯夜像前。\n瞑目几闲松下月，净头时动石盆泉。\n西湖旧侣因吟寄，忆著深峰万万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈湜赠希社师","author":"林逋","text":"瘦靠阑干搭梵襟，绿荷阶面雨花深。\n迢迢海寺浮杯兴，杳杳秋空放鹤心。\n斋磬冷摇松吹杂，定灯孤坐竹风侵。\n锵然更有金书偈，祇许龙神听静吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄亢与季父见访","author":"林逋","text":"积水凝悬馆，船宽或结楼。\n一窗方寄傲，二巷忽同游。\n怨慕采菱曲，苍茫拾翠洲。\n微风起蘋末，归路满清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酬杜从事题壁","author":"林逋","text":"弭盖入衡宇，相看情独深。\n萧疏秋树色，老大故人心。\n佳话频移晷，清飙几拂襟。\n寥然长卿壁，题此比兼金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酬周启明贤良见寄","author":"林逋","text":"治世谁能吊屈平，且披湘帙散幽经。\n春阳尽吐芊芊草，霄极长垂两两星。\n半壁烟岚图太华，一筇风雪访支硎。\n雅吟为惠将何比，明月珊瑚海气腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酬泉南陈贤良见赠","author":"林逋","text":"湛卢生涩鞘秋尘，方册谁谈礼乐因。\n两地贵游无旧识，五天清会有高人。\n泉关茶井当犹惜，火养丹炉看独频。\n扬袂公车莫相调，浮名应未似身亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山后写望","author":"林逋","text":"水墨屏风状总非，作诗除是谢玄晖。\n溪桥袅袅穿黄叶，樵斧丁丁斫翠微。\n返照未沉僧独往，长烟如淡鸟横飞。\n南峰有客锄园罢，闲倚篱门忘却归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山寺","author":"林逋","text":"云峰水树南朝寺，祇隔丛篁作并邻。\n破殿静披齑臼古，斋房闲试酪奴春。\n白公睡阁幽如画，张祜诗牌妙入神。\n乘兴醉来拖木突，翠苔苍藓石磷磷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山寺端上人房写望","author":"林逋","text":"底处凭阑思眇然，孤山塔后阁西偏。\n阴沉画轴林间寺，零落棋枰葑上田。\n秋景有时飞独鸟，夕阳无事起寒烟。\n迟留更爱吾庐近，祇待重来看雪天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]