[{"title":"寄吕帅 其一","author":"徐积","text":"北边控扼重瀛州，虎视鹰扬属壮猷。\n尽道胡人新断臂，安知汉将欲舂喉。\n为文法度堆青简，奉使勋劳半白头。\n六路全秦与全魏，不须野战觅封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕帅 其二","author":"徐积","text":"师屯十万建牙旗，大纛森森重使威。\n燕颔将军宜绣帽，龙骧战士爱犀衣。\n银鎗作队行春去，蜡炬成林校猎归。\n更看铃斋凭几处，文如布阵翰如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕帅 其三","author":"徐积","text":"胡人勇悍真勍敌，汉将威名重泰山。\n隐若金城当一面，横如铁阵控三关。\n防秋甲士屯田去，牧马毡裘避塞还。\n儒帅著书閒暇否，两淮人物太平閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕帅 其四","author":"徐积","text":"帅臣所统在燕南，事事如窥指掌閒。\n仗钺精神堪破虏，扼吭形势正当关。\n十洲部分连沧海，一道军声过黑山。\n文武非徒尹吉甫，前时方叔已平蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕帅 其五","author":"徐积","text":"事皆术内宜谋帅，奇在胸中合运筹。\n战士常骑突阵马，将军须养犒师牛。\n雅歌坐燕春归塞，缓带行吟月上楼。\n且劝主人宜饮酒，边城六月已如秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠刘懋功","author":"徐积","text":"李令归来岁月深，池人得子贵其情。\n定知县事依前简，还记官曹复旧清。\n如问以思谋所贵，能严而恕罚斯轻。\n芙蓉水上人相忆，因寄梅花附此声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠汪判官","author":"徐积","text":"庾郎酝藉本仙材，适自王家池上回。\n杨柳风前红蜡炬，芙蓉香畔白髯腮。\n便摇健笔挥诗藁，仍替衰翁倒酒罍。\n说与泗州倪发句，梦随淮水向东来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠刘閤使","author":"徐积","text":"荦荦雄名骇世閒，堂堂谁敢举头看。\n高谈豹略今无敌，谁污龙泉血未乾。\n蛮贡急趋金殿肃，胡蹝深入铁山閒。\n关中自号诗书将，肯愧齐王在将坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄路倅","author":"徐积","text":"此中可恨恨无山，犹胜纷纷富贵閒。\n绿野尽充公好尚，朱门安得水回环。\n对云披住云边浪，踏月空行月下湾。\n好戴宫纱著宫锦，时时吟去复吟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范君锡观梅 其一","author":"徐积","text":"君看梅艳似何人，不画蛾眉色自真。\n冷寄北风淮上雪，暖思南国岭头春。\n莫嗔俗眼偏相弃，若比夭桃太不匀。\n我共参军同所好，折来酣笑插乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范君锡观梅 其二","author":"徐积","text":"月庭有影终难辨，雪径无香不易分。\n江上肌肤新出浴，岭头环佩忽藏云。\n少他几幅青罗袂，解与何人绣段裙。\n我爱此花真一色，将诗急报范参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校观梅 其一","author":"徐积","text":"若论君颜色，琼瑶未足珍。\n花中谁作偶，物外独先春。\n有艳皆归朴，无妖可媚人。\n江南看已厌，洛浦种还新。\n日晚巫山雨，墙低宋玉邻。\n施朱其已伪，傅粉亦非真。\n堪把歌诗赠，何辞唱和频。\n君篇为第一，便可献枫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校观梅 其二","author":"徐积","text":"寒梅虽淡薄，乃是物之珍。\n天与离群性，花前独步春。\n江皋多冒雪，山路不逢人。\n根本蟠虽久，花趺长自新。\n妖姿虽共处，正色愿相邻。\n纵使红为饰，何如素是真。\n北人殊未识，南国见何频。\n须假东风力，春香到紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄顾瀛州","author":"徐积","text":"本朝谋帅得雄刚，气语无邪面目方。\n掌握事严持斧钺，咽喉地紧扼豺狼。\n铁林猛士新翻阵，幕府奇书旧满囊。\n可减边兵三十万，匈奴走入黑山藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送倪敦复 其一","author":"徐积","text":"手持报简人归后，足步回廊角住声。\n但恐舟行随早晚，此时秋色半阴晴。\n明朝路向云边望，今夜诗须枕上成。\n四壁无灯窗有月，直无老梦到三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送倪敦复 其二","author":"徐积","text":"连朝送客经三日，每夜忘眠约数更。\n枕上寻船无梦去，窗间望月有诗成。\n莫愁病叟添愁思，为恐行人趁晓晴。\n急送村醪追后乘，要教饮处忆南城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送倪敦复 其三","author":"徐积","text":"各自逢人且寄音，仍须南北梦相寻。\n已成凫雁分飞势，更值淮湖连日阴。\n每论事时于义切，重来别后此情深。\n山东定饮登高酒，剩折黄花望我吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕海州","author":"徐积","text":"朱轮海上新迎部，玉笋朝中旧立班。\n曾屈高风来泮水，宜将老梦到朐山。\n霞张列炬红弥野，潮作飞霜白叩关。\n三四百州为第一，日华先照郡楼閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠至几 其一","author":"徐积","text":"淮东学士求新范，海角仙人弃旧居。\n不用更携扬子酝，但来同啖庾郎蔬。\n赤墀待把文章献，黄绶难亲议论馀。\n泮水宫中方就讲，何烦留下橐中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠至几 其二","author":"徐积","text":"西城塔下逢君后，南郭庠中借馆居。\n正共孤甥栖暖席，未如老圃灌寒蔬。\n直生岂敢嗟年暮，饿死犹惭乞祭馀。\n六十衰翁如可教，更忙须遗所藏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠至几 其三","author":"徐积","text":"僧房几载如禅定，州序今来以义居。\n直道褐衣犹胜锦，枉身牢鼎不如蔬。\n何心敢冀浆先馈，无善兼令岁有馀。\n最是学文方自讼，只堪把笔教儿书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠至几 其四","author":"徐积","text":"南州本是诸儒秀，上国宜从大隐居。\n别我好留仙竹杖，送君欲献野芹蔬。\n所惭下士文章陋，未报诸公礼义馀。\n若见汝阴前太守，为言迂阔正谈书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠至几 其五","author":"徐积","text":"谁家门外柳双株，满屋清风是我居。\n霜后正逢篱下菊，雪前已贮瓮中蔬。\n沫流口角耽吟睡，毛坠头心久病馀。\n努力正如初学辈，老瞳昏涩夜看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复明经","author":"徐积","text":"上欲求稽古，天书下四溟。\n儒风久湮郁，诏意乃丁宁。\n削剥因唐氏，源流自汉庭。\n春秋披日月，易象炳丹青。\n礼乐搜潜奥，诗书抉杳冥。\n今焉拘注疏，何谓复明经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋龙图","author":"徐积","text":"吟翁如共老庄游，物外能齐乐与忧。\n鳌背不为三岛客，鱼竿终泛五湖舟。\n何须大使诗来问，合使幽人病为瘳。\n陶令菊花犹有在，未知肯饮一杯不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕清叔 其一","author":"徐积","text":"人为多情乃送君，余虽不送情更深。\n破窗半夜风霜冷，危坐灯前为子吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕清叔 其二","author":"徐积","text":"平生志在青云霄，十年不飞藏羽毛。\n夫子乃是知我者，吟诗赠子何辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕清叔 其三","author":"徐积","text":"匆匆一棹向东行，抖擞空囊无一金。\n买鱼沽酒向村市，典却蔡家焦尾琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕清叔 其四","author":"徐积","text":"深院吟哦夜半时，须有鬼神听此诗。\n吟声往往到明月，淮上有风摇桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋颖叔 其一","author":"徐积","text":"城外人传大使来，吟翁正共客衔杯。\n赤帷便记长安道，骏马仍思御史台。\n义色可令奸胆破，刚姿不为疾风摧。\n公能几日山阳住，待报舟人且倒桅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋颖叔 其二","author":"徐积","text":"盛德尊光不召宾，玉环星弁自迂身。\n北窗卧者陶元亮，大使车中陆子真。\n自道老来心逾壮，若论兵后气弥真。\n所惭旧学非精义，仰负高风如古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之洛阳","author":"徐积","text":"待到伊川濯尽尘，洛阳城下且留身。\n文才得似长沙傅，试问如今有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄苏子由","author":"徐积","text":"午日移阴后，行人罢燕时。\n路从西郭去，船值北风吹。\n梦里犹回首，心中欲附诗。\n从来义如此，两意自相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠慎叔良","author":"徐积","text":"我是东皋叟，君居在屋东。\n已曾同砚席，最好共耕农。\n蕙帐兼栖鹤，篮舆亦带筇。\n若评樵采事，须更唤邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄田大夫","author":"徐积","text":"老掾成迂阔，弥年信不通。\n白头负高义，病眼想清风。\n奉使更三节，题名在两宫。\n有人能举类，旧德起淮东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄慎朝奉","author":"徐积","text":"一别三千里，俱为六十翁。\n日中多俗事，枕上忆清风。\n闻子生双凤，看书快两瞳。\n以囊仍贮果，寄我厥苞红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张景修","author":"徐积","text":"东南未回客，行乐又经年。\n吴市花朝酒，松江月夜船。\n穷阎无屋住，广殿有诗传。\n若论平生事，无如任自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄朱博士","author":"徐积","text":"吴有朱夫子，相知凡几年。\n心怜闭门叟，书附过江船。\n行已为人表，文应许世传。\n临风有馀诲，时复慰皤然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李闳中","author":"徐积","text":"幕官真有道，野叟是何人。\n被此新诗赠，兼之古意醇。\n若论今古事，前是老农身。\n谁谓芙蓉客，能来相顾频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王潜圣 其一","author":"徐积","text":"前日喜重来，今朝复送回。\n出门无仆马，为子走风埃。\n远客有诗赠，短亭无酒杯。\n南州虽得士，东观却遗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王潜圣 其二","author":"徐积","text":"一自渡江津，茫然不记春。\n船谙淮上月，马惯洛阳尘。\n可去问唐举，未须惭买臣。\n终令旧关吏，还似弃繻人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王潜圣 其三","author":"徐积","text":"两翅慢如云，倦飞归故林。\n褐夫怀有玉，贫女叹无金。\n北阙报初罢，南陔情更深。\n升堂拜亲后，先看白头簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王潜圣 其四","author":"徐积","text":"南北倦游客，离家几问津。\n文随年共老，名与德俱新。\n射策谩稽古，抱关犹误亲。\n穷通只如此，宁愧断机人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李守","author":"徐积","text":"千兵州将已严装，犹入西庵曳绣裳。\n坐燕起来中酒色，行春归后落花香。\n难酬高义情弥重，欲述馀恩事更长。\n但看楚人遮道处，草头垂泪湿残阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄林虙","author":"徐积","text":"昔者淮南使，刚中辅以和。\n生前无所苟，身后事如何。\n有子泣枯草，无人诵蓼莪。\n林公为不死，下客谩悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋宪 其一","author":"徐积","text":"节用黄金诏紫泥，皇华仍赋使臣诗。\n三千里路争迎送，五十州官待指挥。\n尽解累囚南到日，却寻急传北归时。\n趣装亦有明珠否，八树成林桂一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋宪 其二","author":"徐积","text":"远服兵刑事可知，全吴分野有星移。\n汉家诏使登车后，蜀道忠臣叱驭时。\n山色迎来城到近，桂香随去马行迟。\n梅林亦是公家管，广帅应须寄北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蹇受之 其一 诗","author":"徐积","text":"出乎志者莫如诗，商也能言得自谁。\n雅颂汉时犹未远，风骚齐后若何衰。\n翰林飞去秋鹰健，工部行来老骥迟。\n亦有孟韩联句好，姓张员外合肩随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蹇受之 其二 笛","author":"徐积","text":"清而劲者笛为奇，哀绝孤高更不卑。\n日暮谁人凭楼处，月明离妇捣衣时。\n何烦作赋摅师愤，最好倾心破主疑。\n一弄便能歌怨曲，唐衢义哭合相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蹇受之 其三 醉","author":"徐积","text":"醉乡恍惚在空虚，若论真恬世所无。\n坐客任贪清者圣，今人何作古之愚。\n宜教侧帽穿花过，更好敲门趁月沽。\n谁似陶潜最潇洒，篮舆归去不须扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢赵朝散","author":"徐积","text":"一识明侯二十年，老农依旧未归田。\n学无所得成迂阔，义有其终尚爱怜。\n下笔自书青竹汗，上樽仍附玉山泉。\n如斯厚意难空饮，待折梅花配酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢秦少游","author":"徐积","text":"讲罢潮沟吟绿槐，手持铜钵待相陪。\n青瞳好客难留住，白足高僧又带回。\n今日许寻陶令菊，明年约寄陆生梅。\n庞公妻子方炊黍，且报舟人莫起桅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李漕","author":"徐积","text":"淮上衰翁何所为，有人宽厚误相知。\n光华奉使方行部，款密成书更附诗。\n在泮饮时常眷眷，乘轺过日倍迟迟。\n缘公礼义如斯重，好寄梅花近北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送云鹤山人","author":"徐积","text":"倦鹤寻流水，閒云归故山。\n青囊书在否，留取教人閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙元规资政游园 其一","author":"徐积","text":"禁烟娱乐且须频，二月风光特地新。\n料得壶中无俗客，更闻歌者尽阳春。\n酒来花下斟琼液，茶向松閒碾玉尘。\n应笑谢安空寂寞，东山终日为何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙元规资政游园 其二","author":"徐积","text":"红作帘帷翠作裀，随轩歌舞一时新。\n未知醒者何如醉，且向樽前莫负春。\n烟重柳梢寒蘸水，日高花径暖生尘。\n自从三月芳菲后，误入桃源又几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙元规资政游园 其三","author":"徐积","text":"竹为篱落水为邻，草碧花红一径新。\n尽日欢声连绿野，满城和气入韶春。\n歌姬汗湿眉閒翠，舞妓香生袜下尘。\n酒阵诗兵皆大敌，未知元帅属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠玉师失鹦鹉 其一","author":"徐积","text":"淮边羁思岭头云，绀彩腾时电影奔。\n一日恰如时辈事，十年空负主人恩。\n良因外貌贪驯性，何况中心狎巧言。\n他日雕笼如再养，玉环金锁铁为门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠玉师失鹦鹉 其二","author":"徐积","text":"淡烟白浦月黄昏，倚遍阑干空倚门。\n接翅定思云外侣，偷栖应望水边村。\n尽传世上新诗去，惟有笼中旧物存。\n便是却来休更养，不能成事只能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢蒋颖叔 其一","author":"徐积","text":"赤帷大乘皇华使，鸣玉锵金访教官。\n红旆缓摇春日晚，清风先入泮宫寒。\n一瓢郑叟醉初醒，五柳陶翁卧不安。\n便著青衫迎谢傅，更无茶果荐杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢蒋颖叔 其二","author":"徐积","text":"吟翁未去水云閒，坐假虚名屈上官。\n忽似仰山心貌竦，更思言事骨毛寒。\n绣衣自可招黄绶，星弁须来对鹖冠。\n莫怪开门迎候早，今冬无雪卧袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泣谢陈德任","author":"徐积","text":"义重江湖叟，情施墟墓閒。\n孤魂慰长夜，老泪湿衰颜。\n一奠方铭骨，三年更倚山。\n更分心两处，恍惚自收还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汤令","author":"徐积","text":"所幸生平世，甘于贫与痾。\n被誉嗤杜簿，挟勇耻荆轲。\n已恨逢君晚，无辞教我多。\n野芹容一献，更索采樵歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"召汝弼","author":"徐积","text":"外府新雠校，问君来不来。\n春随流水远，日被落花催。\n烦子神仙御，尽予贤圣杯。\n何时松径下，同坐踏苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赈饥篇赠程守 其一","author":"徐积","text":"楚有循良守，流民萃一方。\n薪蒸温病骨，菽粟饫饥肠。\n永欲充编户，无心忆故乡。\n恩深何以报，惟有一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赈饥篇赠程守 其二","author":"徐积","text":"乞得诸仓粟，流民获所依。\n已燃薪禦冻，仍用楮为衣。\n病骨蒙新暖，羸肌复旧肥。\n故乡虽有屋，此处可忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送山阳宰高奉议","author":"徐积","text":"大夫归旆暖摇春，正好浮淮向汴津。\n一片青山迎去棹，两堤芳草伴行人。\n当官事业今弥劭，满橐文章老更新。\n记取吾乡蒙实惠，吟翁亦是旧编民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]