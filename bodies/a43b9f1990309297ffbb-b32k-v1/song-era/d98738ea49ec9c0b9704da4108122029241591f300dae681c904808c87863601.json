[{"title":"和陈器之苦雨","author":"张耒","text":"急雨凄风未肯归，三川烟树远凄迷。\n泻山涨潦千霆怒，到地重云万幕低。\n扰扰泥涂同野鹜，萧萧昏晓听邻鸡。\n为君一借扶摇便，静扫平郊散马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈器之谢王渑池牡丹","author":"张耒","text":"十首新诗换牡丹，故邀春色入深山。\n御袍黄粉天然薄，醉脸胭脂分外殷。\n开晚东君留意厚，落迟晴昼伴春閒。\n狂来满插乌纱帽，未拟尊前感鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周廉彦","author":"张耒","text":"天光不动晚云垂，芳草初长衬马蹄。\n新月已生飞鸟外，落霞更在夕阳西。\n花开有客时携酒，门冷无车出畏泥。\n修禊洛滨期一醉，天津春浪绿浮堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和闻莺","author":"张耒","text":"冉冉东风万柳丝，啼莺常自与春期。\n妆残玉枕朝醒后，绣倦纱窗昼梦时。\n文羽自奇非谷隐，好音应合有人知。\n风流潘令多才思，为尔春来几首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晁十七昼眠","author":"张耒","text":"冉冉残春去，悠悠归梦赊。\n窗围幽幌静，风引昼帘斜。\n清荫延高柳，馀红惜晚花。\n山居谙静僻，诗句是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晁应之山中","author":"张耒","text":"康乐虽为吏，不忘山水情。\n我无连璧美，君许托车行。\n幽鸟花前语，春泉竹外鸣。\n勒移无草草，吾友笑功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和得故人书","author":"张耒","text":"来书才一纸，离别意何长。\n应为相思苦，还能细作行。\n水浮新恨阔，花想旧容芳。\n欲问人何处，青楼在帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和葺西斋","author":"张耒","text":"川舟真有待，勿叹滞塘坳。\n自古荆榛地，岂容鸾凤巢。\n君才宜柱石，我志老衡茅。\n从此延风月，新诗与细嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜","author":"张耒","text":"木落风高砧杵伤，孤城更漏入秋长。\n寒生疏牖人无梦，月过中庭树有霜。\n报落梧桐犹陨叶，知时蟋蟀解亲床。\n年年多病浑无寐，静对楞严一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊","author":"张耒","text":"远雁初归枫叶乾，孤舟晚系岸边滩。\n淮声夜静凌风壮，月色秋深照客寒。\n疏拙功名甘阔略，飘零踪迹但悲叹。\n不关酒薄难成醉，自是年来少所欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊泗上阻风雨","author":"张耒","text":"雨昏古岸断人迹，天黑孤城闭水关。\n灯火樽前初拥膝，风云淮上欲移山。\n避人鱼鸟那足怪，吹浪蛟龙不自閒。\n便使乘桴亦何事，沧波岁晚合知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜读贾长江诗效其体","author":"张耒","text":"五字一篇诗，人传贾岛词。\n清秋千古在，幽淡几人知。\n霜夜灯前读，林间静处思。\n恍然如见面，更对七朱丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜意","author":"张耒","text":"每见青桐落，常虞白发侵。\n伤心惟片月，不睡更清砧。\n蟋蟀秋声早，银河夜色深。\n崎岖无限意，萧索一长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜意","author":"张耒","text":"荒城转五更，北斗向谁倾。\n穴斗时争齧，林栖或自惊。\n老来神虑淡，睡足骨毛轻。\n石磬催僧粥，低窗枕畔鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉议杨君予姊丈也廉静乐道不交世俗造道微妙自得不耀未六十而终予实铭其墓其子克一又纂其遗文求书卷末怀想平昔不知涕之横集也","author":"张耒","text":"杨君冢木已萧萧，笔墨遗文久寂寥。\n堕泪交亲悲宿草，长饥奴仆守空瓢。\n平生好事谁能继，后世高名骨已消。\n欲酌一杯浇墓隧，遗魂楚些倘能招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍岁暮感怀书事五首 其五","author":"张耒","text":"笔床茶灶素围屏，潇洒幽斋灯火明。\n木落风霜初十月，坐寒星斗欲三更。\n消磨永夜书盈案，分付閒愁酒满觥。\n干世愈疏身渐老，官閒何苦厌山城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍岁暮感怀书事五首 其四","author":"张耒","text":"北风吹雁去翩翩，流滞周南又一年。\n田为岁荒陶令秫，酒无人乞广文钱。\n香笼钵水清晨咒，坐暖蒲团后夜禅。\n更谢晴明好山色，数峰残雪在檐前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍岁暮感怀书事五首 其三","author":"张耒","text":"霜菊娟娟尚有花，萧条厅树暮啼鸦。\n万竿修竹开侯府，十里青山隐相家。\n麋鹿并游谙野性，诗书相对是生涯。\n冷官自有贫中乐，敢向朱门肉食誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍岁暮感怀书事五首 其二","author":"张耒","text":"修竹高槐交映门，公居潇洒近山云。\n醉眠多似陶彭泽，官况贫于郑广文。\n秋菊捣尘供晓饵，寒松收子和香焚。\n经年门巷无车马，只有清风伴此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍岁暮感怀书事五首 其一","author":"张耒","text":"衙鼓鼕鼕送夕阳，经时无客上高堂。\n渊明柳老秋多雨，子敬毡寒夜有霜。\n山树叶稀晴摘果，斋炉灰煖晓焚香。\n经纶自有英雄在，閒散须教属漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建平途次","author":"张耒","text":"野桥田径滑，官路柳条新。\n流水伴丽日，野花留晚春。\n点空知去翼，冲绿有归人。\n自笑谙岐路，无劳更问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊长平晚望","author":"张耒","text":"川隐夷犹棹，春归杳霭天。\n翠深交岸树，绿野望川田。\n渔酒数家市，船樯何处船。\n登临一回首，无限意茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊舟候水","author":"张耒","text":"一水悠悠断复连，卸帆终日小滩前。\n青旗招饮篙工醉，五两敧风贾客眠。\n树色远分芳草路，鸟行斜断夕阳天。\n渔舟惯伴危樯宿，馈我霜鳞不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊舟都梁亭二首 其二","author":"张耒","text":"微春已动陈根绿，晴日初流大泽澌。\n客路苦寒惟饮酒，老年便暖屡添衣。\n霜林背日梅迟拆，冰渚知春雁早飞。\n江上三年陈迹在，年年穿竹折梅时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊舟都梁亭二首 其一","author":"张耒","text":"旅枕无眠客梦劳，五更旁舍一鸡号。\n汴淮水阔浮梁小，城郭霜晴宝塔高。\n梅锁冷香通雀啄，水翻新绿出渔篙。\n君恩许作还乡客，肯对江蓠赋广骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范参军挽词","author":"张耒","text":"力学志不就，多才宦可嗟。\n生平叔知己，身后妇成家。\n温洛新阡茂，东吴庆系赊。\n功名付儿子，文史旧生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范忠宣挽歌二首 其二","author":"张耒","text":"潇湘卧病吊累沉，赐诏君王用意深。\n多士方怀宣父日，苍生竟失傅岩霖。\n毡裘他日瞻吾父，丹扆何人附旧箴。\n白首门生恩未报，悲词空想薤歌音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范忠宣挽歌二首 其一","author":"张耒","text":"晚生长恨老成空，犹及风流正始中。\n经国谋猷号名相，传家正直似先公。\n回天巨力章犹在，拯溺深言老更忠。\n谁念人心吊邦国，新阡客泣白杨风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院即事呈诸公","author":"张耒","text":"天街落日走鸣珂，咫尺衡门不许过。\n催去据鞍犹鹤望，争观夹道已云罗。\n奏篇定有凌云赋，招隐今无扣角歌。\n最苦清秋孤美睡，通宵三问夜如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院后至诸公","author":"张耒","text":"骢马嘶将近，天门报欲回。\n妻孥怜别久，邻里问归来。\n左学徒仍在，西城宴许陪。\n腹毛何足问，奇捷看渠魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵怀古","author":"张耒","text":"控带洪流古帝城，欲寻旧事半榛荆。\n六朝山色情终在，千古江声憾未平。\n设险丘陵荒蔓草，带城桑柘接新耕。\n十年重到无人问，独立东风一怆情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中五首 其五","author":"张耒","text":"三日雨不止，阴云生我堂。\n晓寒如腊月，冻坐忆朝阳。\n过雁低薄屋，高梅飘度墙。\n呼童倾一榼，独对孟光尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中五首 其四","author":"张耒","text":"春残厌寒搅，雨多空日长。\n饭馀时策杖，睡足独焚香。\n芍药正酣寝，海棠浑未妆。\n贤哉堂下竹，相对只苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中五首 其三","author":"张耒","text":"积雨暗春色，东风还惨悽。\n梅残无复笑，莺怨欲成啼。\n暇日无民讼，芳时有酒携。\n不辞乘兴出，病足畏深泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中五首 其二","author":"张耒","text":"节物即自好，客心何落然。\n早寒清野市，夜雨湿江天。\n破屋疏茅滴，空厨湿苇烟。\n政须一杯酒，相与度残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中五首 其一","author":"张耒","text":"手种阶前树，今朝亦有花。\n春阴寒食节，陋巷逐臣家。\n欲酌消愁酒，先浇破睡茶。\n游人归踏雨，里巷晚喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青阳驿会刘伯声夜话","author":"张耒","text":"奔走倦尘埃，相逢颜暂开。\n语阑灯烬改，饮散月华来。\n行役风霜苦，流年岁月催。\n我愚甘自分，惆怅子多才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青春","author":"张耒","text":"青春忽妍好，半岭丽朝阳。\n谷鸟喜相见，园花明晓妆。\n闲居耽道味，吟眺惜风光。\n扣户有佳客，悠然三举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冒雨归饮酒","author":"张耒","text":"密雨集春庭，花含晓气清。\n喜倾烧酒酽，更御暑衣轻。\n老惜春无日，穷欣岁有成。\n杖藜园径晓，坐见小池平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至汉川夜泊","author":"张耒","text":"水翼飞栖定，连樯宿暝烟。\n苇风惊客梦，江月伴人眠。\n多病閒偏乐，苦吟愁易牵。\n渔郎尔何恨，终夕独鸣舷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至寿州初见淮山二首 其二","author":"张耒","text":"晚系孤舟古岸隈，蒹葭风定渚鸥回。\n山兼野色苍茫去，月向淮心晃荡来。\n秋色解将愁并至，年华偏与客相催。\n青衫手板徒劳尔，富贵功名安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至寿州初见淮山二首 其一","author":"张耒","text":"浩荡平波欲接天，天光波色远相连。\n风鸣雨桨初离浦，岸转青山忽对船。\n泽国秋高添气象，人家南去好风烟。\n步兵何必江东走，自有鲈鱼不值钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至海州明山有作","author":"张耒","text":"望望孤城沧海边，好云深处是人烟。\n鸟飞山静晴秋日，水阔人閒熟稻天。\n旗影远摇沽酒市，棹歌归去隔村船。\n功名富贵非吾事，誓斸明山数亩田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将别普济二首 其二","author":"张耒","text":"孤城淮北晚钟残，落日桥边送客鞍。\n物外楼台秋更豁，山深松竹晚多寒。\n窗风细细侵衣冷，檐雨萧萧到夜阑。\n佳境欲留嗟不可，尘埃踪迹但悲叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将别普济二首 其一","author":"张耒","text":"老槐疏竹寺门幽，九月轻寒袭客裘。\n漠漠淮烟天际晚，萧萧山雨坐中秋。\n风前红叶知时落，篱下黄花对客愁。\n为语老僧无我笑，此生终待老林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将赴上庠偶成","author":"张耒","text":"卷中课最诗成后，枕上功名睡美馀。\n弟子解疑常隐几，轮人能笑久观书。\n山林沉痼时搔首，松菊耽淫自荷锄。\n干世可能寻一饱，齑盐未用食无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屋东","author":"张耒","text":"苍鸠呼雨屋东啼，麦穗初长燕子飞。\n竹里人家鸡犬静，水边官舍吏民稀。\n溪声夜涨寒通枕，山色朝晴翠染衣。\n赖有西邻好诗句，赓酬终日自忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽草二首 其二","author":"张耒","text":"衰草已无赖，秋花只强名。\n雨园蛩响细，寒树鸟啼清。\n淹泊知吾道，幽居见物情。\n唯应有邻叟，足雨问农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽草二首 其一","author":"张耒","text":"幽草堂轩秀，盆池遇雨添。\n新晴雀哺子，永日燕穿帘。\n世事休惊目，闲中且养恬。\n黄公有美酒，时得醉厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怨曲二首 其二","author":"张耒","text":"祖席驻征桡，开帆复信潮。\n隔筵桃叶泣，吹管杏花飘。\n船去鸥飞阁，人归鹿上桥。\n别离惆怅泪，江鹭宿红蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故仆射司马文正公挽词四首 其一","author":"张耒","text":"黼座方恭点，邦家付老臣。\n颂歌民一口，形势国千钧。\n富庶新田里，忠臣旧搢绅。\n裴公恨不早，丘祷叹无神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故仆射司马文正公挽词四首 其三","author":"张耒","text":"经济心犹壮，清羸疾易伤。\n那知两楹奠，遽失万夫望。\n家有诗书积，坟无金玉藏。\n谁知幅巾敛，曾佩上公章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故仆射司马文正公挽词四首 其二","author":"张耒","text":"辞爵浮云外，安民反手中。\n山林独往意，衮绣太平功。\n布被终身俭，貂冠一命崇。\n他年两行泪，碑下泣羊公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故仆射司马文正公挽词四首 其四","author":"张耒","text":"伊洛平生兴，园林独乐居。\n曾过郑公里，得御李膺车。\n华屋当年客，名山异代书。\n定知传不朽，埋玉自沾裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日遣兴","author":"张耒","text":"洛阳自古帝王都，百战荆榛只故墟。\n零乱园林遗物在，嬉游人物古风馀。\n草迷公子障泥锦，花近佳人油壁车。\n漂泊强随游客辔，不辞尘土污衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日遣兴二首 其二","author":"张耒","text":"日烘烟柳软于丝，桃李成尘绿满枝。\n芳草有情随处好，落花无赖信风吹。\n关心伤感知何处，过眼芳菲能几时。\n一病春来妨痛饮，遣愁惟有强裁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日遣兴二首 其一","author":"张耒","text":"流光向老惜芳菲，搔首悲歌心事违。\n绿野染成延昼永，辞红吹尽放春归。\n荆榛废苑人閒牧，风雨空城乌夜飞。\n断送一番桃李尽，可怜桑柘有光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴二首 其二","author":"张耒","text":"溪树昏昏锁暮云，晚山愁黛对含颦。\n不甘小雪犹妨暖，长恨閒阴每占春。\n宝带金貂侯第客，钿车珂马帝京尘。\n王城自古繁华地，回首高歌怅望频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴二首 其一","author":"张耒","text":"漠漠重云向晚低，腊寒新去有馀威。\n风捎檐滴难开幌，润引炉香易著衣。\n把酒自倾金错落，探春谁污锦障泥。\n山城冷落无歌舞，只有芳醪取次携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚有感","author":"张耒","text":"洛川三月鹎鵊鸣，游絮萦空尘不惊。\n茸茸草色铺风软，点点杨花著水轻。\n何处浮云度天末，不妨微雨破春晴。\n江南有客增归思，怅望汀洲蘋芷生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望","author":"张耒","text":"暖日晴薰草，清淮阔浸天。\n地卑连远水，城废入春田。\n目极风灯外，愁悬泪脸边。\n人生苦多感，花柳自年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望","author":"张耒","text":"鸟去晴云外，帆归芳草边。\n平淮分绿野，春树接低天。\n残蘖寒馀烧，新青雨后田。\n年来千里目，容易泪双悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒","author":"张耒","text":"客舍逢桃李，清樽聊自欢。\n梦中经夜雨，醉里度春寒。\n草色远还绿，鸟声晴更繁。\n预期多病眼，花发更辞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒二首 其二","author":"张耒","text":"漠漠阴还合，迢迢日自长。\n云容将雨露，山意自风霜。\n栏甲青辞土，园枝笑倚墙。\n薄寒能几许，春雨满池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒二首 其一","author":"张耒","text":"星霜残腊过，霰雪一冬频。\n云重常昏昼，寒多更入春。\n晚风捎翠暮，轻雨敛微尘。\n满酌山樽酒，驱愁尔最亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"张耒","text":"春尽空馀白日长，枝头青杏已堪尝。\n人閒帘幕燕相语，风暖园林柳半黄。\n病里不知时节换，老来都减少年狂。\n残风浊酒应堪在，更遣流莺送几觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮有感二首 其二","author":"张耒","text":"江城春雨暗，客舍夜灯明。\n搆火添香炷，拥衾闻竹声。\n微明旁舍火，断续远楼更。\n何处离群鸟，孤飞深夜鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]