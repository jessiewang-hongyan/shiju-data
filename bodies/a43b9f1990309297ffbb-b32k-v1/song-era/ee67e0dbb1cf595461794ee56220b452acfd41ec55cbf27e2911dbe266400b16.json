[{"title":"七月六日二首 其二","author":"张耒","text":"山川摇落雁南飞，想见横汾鼓吹时。\n得意刘郎犹叹老，萧条宋玉故应悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月六日二首 其一","author":"张耒","text":"雨洗秋城碧玉天，暮云吹尽月娟娟。\n寂寥谁是清宵伴，只有姮娥最可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月六日二首 其一","author":"张耒","text":"月落暗虫啼不休，五更白露晓悠悠。\n西风是处将摇落，可但梧桐独报秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登高","author":"张耒","text":"黄梨丹柿已催寒，一月西风积雨乾。\n绀滑秋天称行草，却凭秋雁作挥翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月十日菊花烂开","author":"张耒","text":"萧条秋圃风飞叶，却有黄花照眼明。\n已过重阳慵采撷，自嫌亦作世人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十八日","author":"张耒","text":"忆昨秋风吹马蹄，瓦关分袂涕交挥。\n淮阳春物应如锦，犹在柯山送雁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十一日东园桃李未开有感二首 其二","author":"张耒","text":"寄语玄都观里花，饶君繁丽夺朝霞。\n刘郎想到长安日，葵麦风前一叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十一日东园桃李未开有感二首 其一","author":"张耒","text":"日惨东风正怒号，小园寂寂闭蓬蒿。\n可能春色如人事，独发玄都观里桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二日挑菜节大雨不能出","author":"张耒","text":"久将菘芥芼南羹，佳节泥深人未行。\n想见故园蔬甲好，一畦春水辘轳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月五日折梅时经雨梅谢矣","author":"张耒","text":"江云霮䨴未全开，东岭微芒日色来。\n独犯轻寒踏春晓，殷勤更折雨中梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二绝句 其一","author":"张耒","text":"衙斋无事雨初晴，山泽有容春向深。\n何物东风吹不散，祇应多病谪官心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二绝句 其二","author":"张耒","text":"茅檐斜日晓鸡号，水满陂塘荠麦高。\n回首故园空怅望，东门归路绿迢迢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二绝句 其一","author":"张耒","text":"幽窗老客寒无睡，长听城楼晓角悲。\n万里沧溟初浴日，暗鸡先向草间知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二绝句 其二","author":"张耒","text":"岁阴惨澹不可出，竹榻地炉聊自安。\n黄叶满山篱落晚，北风吹雨湿荒寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十八日","author":"张耒","text":"寒食清明人意閒，春城士女出班班。\n柳黄花白楼台外，紫翠江南数叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三乡道中遇雨","author":"张耒","text":"萧萧古道西风雨，惨惨黄昏匹马行。\n未遇功名莫嗟叹，逢时更自忆平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元三绝 其三","author":"张耒","text":"江边灯火似秋萤，哀怨山歌不可听。\n自怪今春牢落甚，禅房止酒读黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元三绝 其二","author":"张耒","text":"沽酒垆边人若市，算商亭下浪连天。\n张君官况今如此，岂有工夫作醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元都下二首 其二","author":"张耒","text":"骄马金鞭白面郎，双鬟小女坐车箱。\n轮声辘辘归何处，留得红笼绛蜡香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元都下二首 其一","author":"张耒","text":"淡薄晴云放月华，晚妆新晕脸边霞。\n管弦楼上争沽酒，巧笑车头旋买花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下直","author":"张耒","text":"留住长安鬓已丝，宫廊还见落梅飞。\n暮云疏雨苍龙阙，不惜障泥策马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨","author":"张耒","text":"攲檐积雨苔生瓦，陋巷人稀泥及门。\n坡下牛羊来远墅，舍旁麻苘接荒村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"女几山","author":"张耒","text":"不复当年端正楼，多情犹问故宫游。\n山川不改繁华尽，须信人生一世浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小雨","author":"张耒","text":"萧萧小雨不能收，一霎西风便似秋。\n枕席夜凉灯火暗，丁丁更漏隔南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋夜酌","author":"张耒","text":"一片秋天碧万寻，月华初上水沈沈。\n遣愁不用先愁醉，更看清光到夜深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予元祐六年六月罢著作佐郎除秘书丞是岁仲冬复除著作郎兼史院检讨复至旧局题屏","author":"张耒","text":"庭树应如我，相逢益老苍。\n别来秋苦雨，但觉瓦松长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予向集贤殿试罢寓居京师尝游西冈钱昌武郎中之第时同会者河东柳子文与钱氏三子夏中予出京今才半年而昔所共游者或东或西有不知所之者古人所谓俯仰之间已为陈迹者欤夫求昨日之我于今日终其身而不得而况偶然相值聚而旋散者欤追记春睡诗一首乃寓钱第所为者","author":"张耒","text":"东风冷峭著衣寒，云影深沉美睡天。\n青杏园林花尽落，晚风吹雨湿鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更","author":"张耒","text":"岁事先教蟋蟀催，暮云楼阙殷轻雷。\n五更庭叶惊残梦，知有清秋犯雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元忠学士八兄耒离京师远蒙追送许惠服丹法托故竟未惠及赋五绝句 其四","author":"张耒","text":"昔见将军破虎鞯，玉堂曾共扫千言。\n功名老去皆蹉跌，相见谆谆劝学仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元忠学士八兄耒离京师远蒙追送许惠服丹法托故竟未惠及赋五绝句 其三","author":"张耒","text":"欲盗羲和一点春，五更注想隔重云。\n如何但欲独不死，分我刀圭未费君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元忠学士八兄耒离京师远蒙追送许惠服丹法托故竟未惠及赋五绝句 其五","author":"张耒","text":"无复颠狂似少时，逢君犹自说蛾眉。\n玉堂旧事君休念，两袖啼痕又送谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元忠学士八兄耒离京师远蒙追送许惠服丹法托故竟未惠及赋五绝句 其二","author":"张耒","text":"衰柳苦催空壁月，悲虫真吊短檠光。\n无情少壮抛人去，只有穷愁气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元忠学士八兄耒离京师远蒙追送许惠服丹法托故竟未惠及赋五绝句 其一","author":"张耒","text":"身逐孤舟似断云，故人追送尚殷勤。\n秋城夜泊西风岸，落叶悲虫独自闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分冬","author":"张耒","text":"莫惊人事浮云变，且作吾侪饱饭行。\n白首分冬聊自劝，江城今夜一阳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"厄台寺三首 其三","author":"张耒","text":"世味嗟予淡莫加，更将诗句寄烟霞。\n自怜落笔无好字，不及扬州王谢家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"厄台寺三首 其二","author":"张耒","text":"峨嵋前约已成空，风雨萧萧送暮钟。\n何用忘机来问话，不如松下谒痴龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"厄台寺三首 其一","author":"张耒","text":"诸佛苍然照殿楹，圆光明满自然灯。\n千年遗事无人问，馆后高眠久属僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commi