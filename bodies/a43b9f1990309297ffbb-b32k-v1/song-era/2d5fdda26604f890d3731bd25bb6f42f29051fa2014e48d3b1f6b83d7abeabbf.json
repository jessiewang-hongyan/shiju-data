d192fe5294295f79689","path":"宋_2.csv","pointer":16857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢东园主人惠荔枝陈紫栽 其二","author":"陈宓","text":"千年老干对壶峰，不数槐庭两翠龙。\n六月薰风腾彩笔，赤瑛苍璧画图供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢东园主人惠荔枝陈紫栽 其一","author":"陈宓","text":"君怜我已是衰翁，乞与长身小圃中。\n不待儿童须远井，眼前双紫烂薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢东庵方处士惠荔枝并诗","author":"陈宓","text":"肺热仍当六月间，文园多病正求安。\n何人乞与黄金掌，玉屑清秋露作团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢何茂才惠诗 其二","author":"陈宓","text":"红尘垂老得何郎，笔力骎骎到马杨。\n更拟他年求妙语，青山深趣为君藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢何茂才惠诗 其一","author":"陈宓","text":"雅思追期正始音，若将掷地定成金。\n年来尘土双侵鬓，赖有清诗时一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢郑夹漈子惠诗索草堂扁榜 其二","author":"陈宓","text":"子长健笔许谁邻，特起先生继获麟。\n摹写遗书礼严像，岂无当代好贤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢郑夹漈子惠诗索草堂扁榜 其三","author":"陈宓","text":"八龄幼子今头白，袖有清诗忽到门。\n前代谩誇棠与笏，何如诗礼典刑存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢雨清水岩 其一","author":"陈宓","text":"楼阁重重俯见山，炎风吹雪到窗间。\n联镳来此班荆坐，分得高僧半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢雨清水岩 其二","author":"陈宓","text":"我来谢雨到名山，记得重来半岁间。\n却笑乖龙太多事，不如科斗得长闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢潘瓜山游东湖惠诗","author":"陈宓","text":"东湖觌面本情亲，到得东湖动隔旬。\n若道四并成浪语，如何寸步不由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其六","author":"陈宓","text":"穷冬天意似奢华，白璧明珠剩作花。\n付与东风向何处，恩勤不为五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其七","author":"陈宓","text":"浓霜轻雪妒清华，暖日烘时祇见花。\n天意似怜尘世界，故将茅舍换仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其四","author":"陈宓","text":"谩自尘劳鬓欲华，故园空锁未开花。\n年年饱看春来去，输与西湖处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其二","author":"陈宓","text":"祇知风骨清于玉，敢把精神看作花。\n一阵异香明月下，定知来自玉皇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其八","author":"陈宓","text":"地宜冬暖早韶华，回首墙东李亦花。\n毕竟晨妆自羞涩，岂堪位置寿阳家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其一","author":"陈宓","text":"天公久不试铅华，尽把清香付此花。\n白玉堂中春未动，等闲攀折野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其三","author":"陈宓","text":"世间何物最鲜华，摇落林中第一花。\n作计莫输蜂蝶后，深房浅萼便为家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其九","author":"陈宓","text":"金掌何人吸露华，争如瓦盏泛霜花。\n移床来傍花边坐，底用云岚顶上家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其十","author":"陈宓","text":"老觉无情恋物华，玉尘那复惜飞花。\n春风祇在襟怀里，试问蓝溪吏隐家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋梅堂闲吟 其五","author":"陈宓","text":"造物全将素作华，牡丹那得号真花。\n古来骚客知多少，貌得精神有几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感时","author":"陈宓","text":"和戎之计最堪嗟，不以恩威以丽华。\n他日渔阳动鼙鼓，祇因争取上林花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感春","author":"陈宓","text":"春来物物尽欣怡，不到人间寒自眉。\n愿得清时同贞观，旅行终日不忧饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感秋","author":"陈宓","text":"西风忽起江枫末，偏喜萧萧弄华发。\n世间何物最坚牢，惟有古来天上月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩题","author":"陈宓","text":"胸襟但贮五千卷，意虑曾无分寸私。\n叹老嗟卑真浅士，古人心事有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉定戊寅秋同蔡念成诸人游三叠泉泉旧名三级改今名岩间莓苔隐然有字如玉色众皆曰古人留题也即而视之其末有密官二字馀皆似字而不可晓他日复往则不复有睹因作诗以纪之","author":"陈宓","text":"去城三十蹑云端，特地山灵纵我观。\n白玉岩边数行字，祇知末后密并官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午日枫亭道中 其一","author":"陈宓","text":"百里青松五月凉，千年忠惠有馀芳。\n后人继此非难事，不为公家虑久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午日枫亭道中 其二","author":"陈宓","text":"去家一宿六十里，便作良辰客异乡。\n觅得菖蒲未成饮，午馀山店索杯尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端砚六绝 其一","author":"陈宓","text":"昔我高皇渡江日，拟将文治复舆图。\n炎方不敢珍韶石，来献君王写禹谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端砚六绝 其五","author":"陈宓","text":"至宝非关少识真，都缘未睹十城珍。\n如何绝域穷南地，却有唐朝辅相人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]