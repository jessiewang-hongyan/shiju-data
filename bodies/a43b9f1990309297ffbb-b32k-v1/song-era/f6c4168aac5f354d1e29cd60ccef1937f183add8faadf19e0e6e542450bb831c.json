[{"title":"偈颂三十首 其九","author":"释印肃","text":"普庵真实不问钱，只要离尘脱业缠。\n一闻千悟方堪委，何须苦苦学神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其七","author":"释印肃","text":"今日不知来日事，贪嗔痴爱度朝昏。\n披毛戴角更相互，岂识修真般若门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其一","author":"释印肃","text":"捏不成团拨不开，何须南岳又天台。\n六根门首无人用，惹得胡僧特地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十二","author":"释印肃","text":"闲步游南陌，惟便野兴多。\n傍花看蝶舞，近柳听莺歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其三 回彭居士书","author":"释印肃","text":"有无俱不到，生灭岂相干。\n得者随机应，未达莫颟顸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其二 回彭居士书","author":"释印肃","text":"议得无心达有心，识心三界自平沉。\n可怜迷望无心者，只道无心境不侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遍虚空界","author":"释印肃","text":"和风周匝万花开，春雾濛濛锁绿苔。\n世人寐语不知意，黄鹤楼前不赏梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睹弟子作颂题窗乃续韵警之 其二","author":"释印肃","text":"石人击鼓木人吹，露柱亲闻脑搭披。\n如是圆音无用处，阎公未肯便饶伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睹弟子作颂题窗乃续韵警之 其四","author":"释印肃","text":"普庵三颂自连拈，寄与提纲本手钳。\n炉鞴稳时无钝铁，何妨矢上更加尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睹弟子作颂题窗乃续韵警之 其三","author":"释印肃","text":"鼻孔辽天是阿谁，权将云雾作衣披。\n迷悟本无唯一性，你全是我我无伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"擎山持杵","author":"释印肃","text":"擎山抱岳疾如风，持杵拈槌解脱空。\n世间有相非身大，须弥总纳一尘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其三十一","author":"释印肃","text":"破头山下起清波，流注黄梅不奈何。\n四度敕宣端不动，尊威妙湛灌娑婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其三十二","author":"释印肃","text":"百鸟衔花未足奇，直须透过始方知。\n五百众中谁委悉，碓头私许老卢锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其二十六","author":"释印肃","text":"德胜王太子，号不如密多。\n指山还梵志，魔群不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其三十六","author":"释印肃","text":"十方诸佛入其中，十波罗蜜一光同。\n十世古今无间隔，十身千亿法身通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其十三","author":"释印肃","text":"迦毗摩罗师，外道成正真。\n了斯第一义，非故亦非新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其二十","author":"释印肃","text":"阇夜多因地，昔为自在天。\n一契无作性，大用得言前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其二","author":"释印肃","text":"谁易阿谁难，多闻不透关。\n忽解空无我，内海更藏山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其六","author":"释印肃","text":"大士弥遮迦，忆昔阿私陀。\n邪正通一道，无法不调和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其十","author":"释印肃","text":"胁本号难生，泥牛入海耕。\n随机千万转，无上亦无行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其二十八","author":"释印肃","text":"菩提达磨大医王，全持正法度南方。\n粉骨碎身应未报，至今不离此心光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其二十二","author":"释印肃","text":"国名常自在，王子摩拿罗。\n化鹤成菩萨，动止涌禅河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其十八","author":"释印肃","text":"伽耶舍多人再来，常持圆鉴离尘埃。\n风铃非响我心应，一返常光更不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三十六祖颂 其四","author":"释印肃","text":"优波耶鞠多，三昧力降魔。\n法传香种子，意气尚周罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三宝 其一","author":"释印肃","text":"圆光应现无心物，大地山河恰似无。\n骊珠一颗非非相，信者权将作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三宝 其二","author":"释印肃","text":"直指人心亲见佛，何劳打瓦作龟爻。\n一片白云横谷口，几多归鸟尽迷巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三宝 其三","author":"释印肃","text":"迷悟本同光，信时无隐藏。\n幻空如梦体，三昧觉华王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈达献菊花求颂","author":"释印肃","text":"满地风光未足奇，霜前秋后吐金枝。\n灵山亲举唯迦叶，今日陈来众共知。\n不独陶生时节用，转为华藏供阿弥。\n閒见定归依彼岸，方知此日献花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"释印肃","text":"普庵见一个虾蟆，度日常吞鳖鼻蛇。\n独立卓然真可畏，身和云月粲星花。\n太公一见便收钓，谢三得意号玄沙。\n几多独兽无藏隐，不断声孤问水涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其四 答彭资深","author":"释印肃","text":"体得寰中物，忘机自葆光。\n老庄言不及，佛祖句难藏。\n槁木非成道，灰心岂离忙。\n资深无欠少，本有不须忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与夏国舅","author":"释印肃","text":"白日上升非偶尔，刹那成佛亦如然。\n个中迥超声色外，恩光满目意连天。\n好明廓彻非思量，一受皇书遍普贤。\n江西风月光无尽，帝里真如万法圆。\n当处饮吞无不足，护持秘密不休年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十二","author":"释印肃","text":"迷指不见月，两处大誵讹。\n来叩普庵老，真心岂奈何。\n除非君自肯，阳春白雪歌。\n毛端如来识，言说用闲多。\n情忘并想尽，不断这摩诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其六","author":"释印肃","text":"普礼三身四智佛，一念阿僧祇劫中。\n身心一如遍法界，法身不灭寿无穷。\n一月六旬权准则，一年四会表参同。\n妄念不生无损益，五千连贯赠寰中。\n所得未尝图别用，共成进纳续宗风。\n初法难传忧不信，黄梅五百独卢公。\n如今个个堪分付，报国资家理不穷。\n莫道祖师西土出，刹那自肯即心通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一心听佛","author":"释印肃","text":"不闻闻了绝狐疑，三界浮嚣总不知。\n泥牛入海通消息，木马横嘶贯紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其十","author":"释印肃","text":"人定亥，坠石痴人犹捣碓。\n忽然舂出古菱花，照地照天无向背。\n今时人，会不会，未了先须除渴爱。\n情忘想尽至无依，体若虚空非内外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其一","author":"释印肃","text":"平旦寅，鸡鸣犬吠足圆音。\n祇这圆音无二听，何劳妄想别求真。\n击钟鼓，了无声，了本无声真好听。\n声錧无体门前客，体合声空个里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其十二","author":"释印肃","text":"鸡鸣丑，飞空著地波波走。\n演若达多再得头，依前不换旧时首。\n无不无，有不有，有无不到休开口。\n拈槌竖拂有谁知，逐迹寻臊真猎狗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其二","author":"释印肃","text":"日出卯，斋粥无□心觉饱。\n钵盂洗了自闲闲，方信赵州机便巧。\n师子儿，全牙爪，惊杀百年老虎豹。\n捏怪文殊劈脑骑，二乘皆道庄严好。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其八","author":"释印肃","text":"日入酉，万户千家无别有。\n相呼相唤去还来，谁识一身非妍丑。\n也无头，也无手，劫火洞然渠不朽。\n猪羊牛马化为真，毫发不留无可守。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其五","author":"释印肃","text":"日南午，大地元来没寸土。\n天上天下独为尊，耀目连睛无可睹。\n石巩痴，逢马祖，自己如空谁射弩。\n三平了道劈开胸，不拄箭锋徒自苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其六","author":"释印肃","text":"日昳未，担板玄沙爱鳖鼻。\n丧身失命几多人，张口送睛何处避。\n不通宗，浑寐语，业识茫茫无本据。\n盲参不体弄蛇人，常被弄蛇穿却鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其三","author":"释印肃","text":"食时辰，金牛作舞笑忻忻。\n漆桶漆桶吃来□，参方谁识老婆心。\n佛祖意，只如今，且无自己及他人。\n雪峰指作一面镜，轮劫猕猴佩苦辛。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其九","author":"释印肃","text":"黄昏戌，更点分明黑如漆。\n一道常光绝世伦，来往不通金密积。\n知不知，识不识，自古至今非外觅。\n木女清宵何所为，混月闲吹无孔笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其四","author":"释印肃","text":"禺中巳，报君学道无门户。\n佛语诸经标此心，此心现时寂灭度。\n本无迷，曷有悟，真我非身谁作做。\n贪嗔痴爱属众生，达者无非涅槃路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其十一","author":"释印肃","text":"夜半子，万事无心谁到此。\n一毛头上了遍圆，永劫不遭邪魅使。\n升高台，挝大鼓，努目摇头如老虎。\n猪羊咬尽更伤人，自己不真长劫苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时歌 其七","author":"释印肃","text":"晡时申，衙鼓鼕鼕妙意新。\n括地该天人不会，如飘野马入迷津。\n不取相，勿疏亲，露体堂堂绝翳尘。\n屠儿一念无诸业，龙女逡巡作佛身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万载县桥疏","author":"释印肃","text":"万载洪机一发，直得耳聋眼瞎。\n放身通济仁心，度尽微尘佛刹。\n劝英贤，须特达，百亿龙天齐鉴察。\n大开宝藏施珠珍，个里无私一毫发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其十一","author":"释印肃","text":"独脚老虎，暗时暗杀人。\n不识是眼睛，与君无著力，溪云罩古城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其八","author":"释印肃","text":"大虚涂毒鼓，有病闻皆愈。\n无病闻皆死，死了却苏来，谁会辜负你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其九","author":"释印肃","text":"无底琉璃井，忽尔堕其中。\n胜修万劫功，跳出跳不出，瘖哑又盲聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其十二","author":"释印肃","text":"无根树子，混盳非出入。\n头尾应皆急，妙了过这边，渡海何曾湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其十","author":"释印肃","text":"分明无背面，相逢不相见。\n年年桃花面，临州下水船，梢公力方便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其二","author":"释印肃","text":"出生入死足通神，全体三生父母灵。\n不是如来知见力，舍身财命卒难升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其七","author":"释印肃","text":"百纳骨董袋，一切皆我入。\n一切莫能入，达此妙纵横，三世佛佛佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与王巡检 其一","author":"释印肃","text":"佛法从来付宰臣，今朝已遇大心人。\n透明幻住超生灭，鉴物无私佑圣庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与汤亨老居士","author":"释印肃","text":"香积厨中烹五味，脚踏天兮头顶地。\n虽然头角各分张，未得个人都了利。\n不然亨老大慈悲，一日无私和众议。\n南方道友不偏枯，到里许人皆具备。\n直教塞口并咽喉，消息出门无不是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与参徒辨事","author":"释印肃","text":"仲元亨老，慇勤圆净。\n此中大事，雪曲高歌。\n骑白牛儿，漫空唱唱啰。\n这家也舂米，那畔争打禾。\n且道乘谁力，天真大老婆。\n近日南方诸道友，斩钉截铁自降魔。\n运水搬柴无不是，神通妙用显摩诃。\n一人办力诸天供，一会修来争奈何。\n移根拔树非邪作，翻有为无万事和。\n楼阁忽然横碧汉，人人功德无空过。\n香积味凭知道者，须教不少亦非多。\n个里不消重委嘱，分明只是这弥陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与廖维高","author":"释印肃","text":"精通三教越禅机，语默同风和者希。\n匝地周天居士眼，元来只在一毫釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大众仰观","author":"释印肃","text":"多身一体少人知，不体无空自执迷。\n除非妙达斯三昧，个里圆观始不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大圆智镜","author":"释印肃","text":"普庵非相亦非名，达本忘情不见人。\n孤月全收无意识，桂轮独耀绝纤尘。\n三祇一念汤消雪，万行须臾火烁冰。\n到此何劳声色问，共君本自镜圆明。\n若将铜器作天真，背黑面青赚学人。\n本性如空含万物，妙明寂照岂容尘。\n山河石壁三春雾，空色全彰六月冰。\n智自圆明非我所，不拘日月定光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化无尽历","author":"释印肃","text":"化城立有谁知意，普雨调和润万机。\n大根枝节全体露，何殊弥勒降生时。\n石儿拍掌连云指，木女含笙和水吹。\n试问灯笼谁解舞，知无我者快拈锤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化米","author":"释印肃","text":"当关击破黄金锁，佛与众生无两个。\n全提吞尽十方空，万亿龙天为护佐。\n雪歌独唱古峰头，风月溪山同赞和。\n从来弘阐在当人，密赖知音共扬播。\n共扬播，非彼我，一钵千家崇善果。\n直叩维摩不二门，狭路相逢休放过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开钟示众法语","author":"释印肃","text":"总中有别异中同，成坏非干这一钟。\n收拾油铛并火熬，圆镕法器隮盲聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无见顶相","author":"释印肃","text":"无影树下谁相识，琉璃殿内绝形名。\n千岩色□祥光现，万壑松风和没人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其五","author":"释印肃","text":"三世诸佛同此路，天无门兮地无户。\n森罗万象一光吞，历劫不曾少盐醋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其八","author":"释印肃","text":"自有山翁样子存，家传祖代没分文。\n南北东西无别有，光明遍照独为尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其二","author":"释印肃","text":"总是吾家入道门，无说说中闻不闻。\n步步透关田地稳，须弥?跳撞昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其六","author":"释印肃","text":"百千方便一乾坤，得者还须皂白分。\n珠体未明成五色，举头鹞子过罗村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四字书窗以印实相 其四 慧","author":"释印肃","text":"田头十字路堂堂，钳口收心便厮当。\n领得摩尼真宝藏，却来警梦表提纲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示众法语 其一","author":"释印肃","text":"矿去金存百鍊周，自从索价没人酬。\n腾今耀古非声色，曾共沩山作牯牛。\n身若浮云心若风，居常不定在虚空。\n忽然风捲云无迹，谁人解识主人公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示众法语 其二","author":"释印肃","text":"大隐居廛小隐山，了心无事没多般。\n休缘到此磨尘垢，绝爱终须耐岁寒。\n百草上参多宝佛，镬头边勘赵州关。\n莫教一击连天地，震动坤维顷刻间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]