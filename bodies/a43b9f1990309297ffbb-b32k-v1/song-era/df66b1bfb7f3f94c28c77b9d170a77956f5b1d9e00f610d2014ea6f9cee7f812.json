[{"title":"寄茂才冯彭年","author":"林逋","text":"异代甘泉赋，谁当颂太微。\n无如摛藻妙，所惜赏音稀。\n渐远江关树，方单客子衣。\n扁舟舣何许，霰雪暮霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄临川司理赵时校书","author":"林逋","text":"远宦风波隔，归期岁月频。\n天形孤鸟晚，烟色大江春。\n驿路向山郭，船樯留估人。\n高台望不极，空使鬓华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄宣城宗言侄","author":"林逋","text":"春水涵波绿渺瀰，江南芳草又离离。\n谢家元住青山郭，郤氏近攀丹桂枝。\n衣下香囊非尔好，床头诗卷愧吾痴。\n中林独处仍多病，早晚能来慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄思齐上人","author":"林逋","text":"松下中峰路，怀师日日行。\n静钟浮野水，深寺隔春城。\n阁掩茶烟晚，廊回雪溜清。\n当期相就宿，诗外话无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄祝长官","author":"林逋","text":"怀想与君劳，区区未剧曹。\n深心赖黄卷，垂老愧青袍。\n临事终存道，为诗转近骚。\n庐江五亩宅，归去亦蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄耏门梁进士","author":"林逋","text":"退隐无山进乏媒，杜门芳草与苍苔。\n贫为吾道应关命，达似他途亦是才。\n人静合寻衙北寺，野凉还上郭西台。\n江干昨夜情多少，风雨吹灯一梦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄胡介","author":"林逋","text":"忆著胡居士，长看古佛书。\n衡门惟老母，一饭共寒蔬。\n墨迹多图鹤，山名爱画庐。\n几回曾会宿，风雪满庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄钱紫微","author":"林逋","text":"晞发起初晨，中丘谢病身。\n空持白云意，遥赠紫微人。\n画毂坊门远，苍苔掖署春。\n元和旧文体，当许继清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄曹南任懒夫","author":"林逋","text":"关门却坐忘，一烬隐居香。\n午濑怀泉瀑，秋耕负晓冈。\n道深玄草在，贫久褐衣荒。\n料得心交者，微吟为楚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄清晓阇梨","author":"林逋","text":"前时春雪晴，林壑趣弥清。\n几忆山阴讲，兼忘谷口耕。\n树丛归夕鸟，湖影浸寒城。\n还肯重相访，柴门掩杜蘅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄傅霖","author":"林逋","text":"葛蔓烟枯束六经，高廉浑与昔贤停。\n黄牙稚子跨牛犊，白眼山人识剑形。\n寒睡草旁林酒壮，晓思河曲雨槎腥。\n传闻曾说平生事，不要清朝梦武丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄辇下传神法相大师","author":"林逋","text":"禁寺诸供奉，如师艺学稀。\n粉轻昏古本，罗重拆秋衣。\n净碱生瓶晕，连阴长竹围。\n算应支遁马，毛骨苦无肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄解州李学士","author":"林逋","text":"解梁贤守古难同，张盖垂鞭自士风。\n馆职久衔疏旧地，郡符重剖枉名公。\n印厅孤坐琴尊外，铃阁清谈易老中。\n闻演丝纶徵诏近，相如文学动天聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题历阳马仲文水轩","author":"林逋","text":"构得幽居近郭西，水轩风景独难齐。\n烟含晚树人家远，雨湿春蒲燕子低。\n红烛酒醒多聚会，粉笺诗敌几招携。\n旅游今日堪搔首，摇落山城困马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹州寄任独复","author":"林逋","text":"交结文章尽世惊，城中幽隐更无营。\n敢将古道为吾事，耻对常流语子名。\n秋思病弹曾独听，太玄闲写待谁评。\n清朝故实蒲轮在，合为高贤下帝京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其一","author":"林逋","text":"吟怀长恨负芳时，为见梅花辄入诗。\n雪后园林才半树，水边篱落忽横枝。\n人怜红艳多应俗，天与清香似有私。\n堪笑胡雏亦风味，解将声调角中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其三","author":"林逋","text":"小园烟景正凄迷，阵阵寒香压麝脐。\n湖水倒窥疏影动，屋檐斜入一枝低。\n画工空向閒时看，诗客休徵故事题。\n惭愧黄鹂与蝴蝶，只知春色在桃溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其二","author":"林逋","text":"几回山脚又江头，绕著孤芳看不休。\n一味清新无我爱，十分孤静与伊愁。\n任教月老须微见，却为春寒得少留。\n终共公言数来者，海棠端的免包羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花二首 其二","author":"林逋","text":"孤根何事在柴荆，村色仍将腊候并。\n横隔片烟争向静，半粘残雪不胜清。\n等闲题咏谁为愧，子细相看似有情。\n搔首寿阳千载后，可堪青草杂芳英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花二首 其一","author":"林逋","text":"宿霭相粘冻雪残，一枝深映竹丛寒。\n不辞日日旁边立，长愿年年末上看。\n蕊讶粉绡裁太碎，蒂疑红蜡缀初乾。\n香刍独酌聊为寿，从此群芳兴亦阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮甸南游","author":"林逋","text":"几许摇鞭兴，淮天晚景中。\n树林兼雨黑，草实著霜红。\n胆气谁怜侠，衣装自笑戎。\n寒威敢相掉，猎猎酒旗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮甸南游","author":"林逋","text":"幽胜程程拟遍寻，不妨淮楚入搜吟。\n藓莎篱落溪庄静，松竹楼台坞寺深。\n数抹晚霞怜野笛，一筛寒水羡沙禽。\n腰间组绶谁能爱，时得闲游是此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮甸城居寄任刺史","author":"林逋","text":"扰扰非吾事，深居断俗情。\n石莎无雨瘦，秋竹共蝉清。\n剑在慵闲拂，诗难忆细评。\n寥然独支枕，淮月上山城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深居杂兴六首 其六","author":"林逋","text":"松竹封侯尚未尊，石为公辅亦云云。\n清华自合论闲客，玄默何妨事静君。\n鹤料免惭尸厚禄，茶功兼拟策元勋。\n幽人不作山中相，且拥图书卧白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深居杂兴六首 其五","author":"林逋","text":"上书可有三千牍，下笔曾无一百函。\n閒卷孤怀背尘世，独营幽事傍云岩。\n僧分乳食来阴洞，鹤触茶薪落蠹杉。\n未似周颙少贞胜，北山应免略相衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深居杂兴六首 其四","author":"林逋","text":"冉冉秋云抱啸台，一兵松竹是闲媒。\n谁闻济北传兵略，枉说山东出相才。\n樵褐短长披搕膝，丹炉高下垒悬胎。\n三千功行无圭角，可望虚皇九锡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深居杂兴六首 其三","author":"林逋","text":"薄夫何苦事奸奸，一室琴书自解颜。\n峰后月明秋啸去，水边林影晚樵还。\n文章敢道长于古，光景浑疑剩却闲。\n多少烟霞好鱼鸟，令人惆怅谢东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深居杂兴六首 其二","author":"林逋","text":"四壁垣衣钓具腥，已甘衡泌号沉冥。\n伶伦近日无侯白，奴仆当时有卫青。\n花月病怀看酒谱，云萝幽信寄茶经。\n茅君使者萧闲甚，独理丛毛向户庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深居杂兴六首 其一","author":"林逋","text":"隐居松籁细铮然，何独微之重碧鲜。\n已被远峰擎??，更禁初月吐娟娟。\n门庭静极霖苔露，篱援凉生袅菊烟。\n中有病夫披白搭，瘦行清坐咏遗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐居秋日","author":"林逋","text":"行药归来即杜门，啸台秋色背人群。\n幽虫傍草晚相映，远水著烟寒未分。\n高亢可能称独行，穷空犹拟赖斯文。\n过从好事今谁是，自笑何如杨子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪三首 其三","author":"林逋","text":"皓然窗户晓来新，画轴碑厅绝点尘。\n洛下高眠应有道，山阴清兴更无人。\n寒连水石鸣渔墅，猛共松篁压寺邻。\n酒渴已醒时味薄，独援诗笔得天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪三首 其二","author":"林逋","text":"湿飘乾堕著溪林，阵猛花尖聚砌阴。\n晓沫平随茶箸薄，冻痕全共药锄深。\n慵多只好披诗看，狂甚无如叩几吟。\n更想天山两三骑，臂鹰拳蹬簇骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪三首 其一","author":"林逋","text":"瓦沟如粉叠楼腰，高会谁能解酒貂。\n清夹晓林初落索，冷和春雨转飘萧。\n堪怜雀避来闲地，最爱僧冲过短桥。\n独有闭关孤隐者，一轩贫病在颜瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄家庄","author":"林逋","text":"黄家庄畔一维舟，总是沿流好宿头。\n野兴几多寻竹径，风情些小上茶楼。\n遥村雨暗鸣寒犊，浅溆沙平下晚鸥。\n更有锦帆荒荡事，茫茫随分起诗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜马先辈及第后见访","author":"林逋","text":"肄业十年初，萧然此饭蔬。\n何期桂枝客，来访竹林居。\n香炷看新诰，尘痕拂旧书。\n回轩应眷眷，将与岭云疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜侄宥及第","author":"林逋","text":"新榜传闻事可惊，单平于尔一何荣。\n玉阶已忝登高第，金口仍教改旧名。\n闻喜宴游秋色雅，慈恩题记墨行清。\n岩扉掩罢无他意，但爇灵芜感盛明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜皎然师见访书赠","author":"林逋","text":"金锡锵然款蠹关，云膏浓渚对跳峦。\n清如霜月三五夕，瘦似烟篁一两竿。\n旧社久抛魂梦破，近诗才举骨毛寒。\n池轩夜静且留宿，往往自将秋籁弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上初春偶作","author":"林逋","text":"梅花开尽腊亦尽，春暖便如寒食天。\n气色半归湖岸柳，人家多上郭门船。\n文禽相并映短草，翠潋欲生浮嫩烟。\n几处酒旗山影下，细风时已弄繁弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上晚归","author":"林逋","text":"卧枕船舷归思清，望中浑恐是蓬瀛。\n桥横水木已秋色，寺倚云峰正晚晴。\n翠羽湿飞如见避，红蕖香袅似相迎。\n依稀渐近诛茅地，鸡犬林萝隐隐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上隐居","author":"林逋","text":"湖水入篱山绕舍，隐居应与世相违。\n闲门自掩苍苔色，来客时惊白鸟飞。\n卖药比尝嫌有价，灌园终亦爱无机。\n如何天竺林间路，犹到秋深梦翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖山小隐 其二","author":"林逋","text":"园井夹萧森，红芳堕翠阴。\n昼岩松鼠静，春堑竹鸡深。\n岁课非无秫，家藏独有琴。\n颜原遗事在，千古壮闲心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖山小隐 其三","author":"林逋","text":"衡门邻晚岛，环堵背寒岗。\n片月通萝径，幽云在石床。\n客游抛鄠杜，渔事拟沧浪。\n管乐非吾尚，昂头肯自方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖山小隐 其一","author":"林逋","text":"猿鸟分清绝，林萝拥翠微。\n步穿僧径出，肩搭道衣归。\n水墅香菰熟，烟崖早笋肥。\n功名无一点，何要更忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖山小隐 其二","author":"林逋","text":"闲搭纶巾拥缥囊，此心随分识兴亡。\n黑头为相虽无谓，白眼看人亦未妨。\n云喷石花生剑壁，雨敲松子落琴床。\n清猿幽鸟遥相叫，数笔湖山又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖山小隐 其一","author":"林逋","text":"道著权名便绝交，一峰春翠湿衡茅。\n庄生已愤鸱鸢赫，杨子休讥蝘蜓嘲。\n潏潏药泉来石窦，霏霏茶蔼出松梢。\n琴僧近借南薰谱，且并闲工子细抄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖村晚兴","author":"林逋","text":"沧洲白鸟飞，山影落晴晖。\n映竹犬初吠，弄船人合归。\n水波随月动，林翠带烟微。\n寺近疏钟起，萧然还掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖楼晚望","author":"林逋","text":"湖水混空碧，凭阑凝睇劳。\n夕寒山翠重，秋净鸟行高。\n远意极千里，浮生轻一毫。\n丛林数未遍，杳霭隔渔舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢马程先辈惠蜀笺","author":"林逋","text":"数幅丹霞夹白云，封题何事寄幽人。\n亏君视草禁中客，乞我浣花溪上春。\n且与巾箱为玩好，更无篇什写清新。\n我来卧病还多感，一笔蛛丝满砚尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"集贤李建中工部尝以七言长韵见寄感存怀没因用追和","author":"林逋","text":"清绝门墙冷似冰，野人怀刺昔曾登。\n新题对雨分萧寺，旧梦经秋说杜陵。\n贫典郡符资月给，老持台宪减霜棱。\n开元文字钟王笔，惆怅临风一烬灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新竹","author":"林逋","text":"粉环匀束绿沉枪，袅露差烟??长。\n卷箔乍惊双眼健，倚阑寻觉百毛凉。\n齐披古锦围山阁，背迸寒犀过寺墙。\n堪笑数根苍翠者，强颜如立少年场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬昼师西湖春望","author":"林逋","text":"笛声风暖野梅香，湖上凭阑日渐长。\n一样楼台围佛寺，十分烟雨簇渔乡。\n鸥横残葑多成阵，柳映危桥未著行。\n终约吾师指芳草，静吟闲步岸华阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧院夏日和酬朱仲方","author":"林逋","text":"一院掩萧森，晨凉又夕阴。\n鹤应输静立，蝉合伴清吟。\n著壁云衣重，通帘竹翠深。\n卧屏来看否，天姥雪千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春寄怀曹南通任寺丞","author":"林逋","text":"跌荡情怀每事同，十年曹社醉春风。\n弹弓园圃阴森下，棋子厅堂寂静中。\n赤脚我犹无一婢，黑头君合作三公。\n江湖今日还劳结，目送归飞点点鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微亭","author":"林逋","text":"亭在江干寺，清凉更翠微。\n秋阶响松子，雨壁上苔衣。\n绝境长难得，浮生不拟归。\n旅怀何计是，西崦入斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虢略秀才以七言四韵诗为寄辄敢酬和幸惟采览","author":"林逋","text":"本无高亮似阳城，但爱松风入耳声。\n五亩自开林下隐，一尊聊敌世间名。\n交谈不远樵农客，弄翰慵誇子墨卿。\n异日青冥肯回顾，夫君门族旧和羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶","author":"林逋","text":"细眉双耸敌秋毫，冉冉芳园日几遭。\n清宿露花应自得，暖争风絮欲相高。\n情人殁后魂犹在，傲吏齐来梦亦劳。\n闲掩遗编苦堪恨，不并香草入离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠当涂朱仲敏","author":"林逋","text":"甚与时流道不同，南朝台阁是家风。\n高闲几格图书畔，冷澹门庭树石中。\n因寄诗牌寻胜景，拟投文卷数名公。\n荣登显达他年后，应笑冥冥弋者鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其三 诗匠","author":"林逋","text":"诗流有匠手，万象片心通。\n山落分题月，花摇刻句风。\n劳形忘底滞，巧思出樊笼。\n唐律如删正，斯人合立功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其五 诗狂","author":"林逋","text":"岸帻都旁若，穷搜无遁形。\n写嫌僧阁窄，吟怕酒船停。\n绝顶寒曾上，闲门夜不扃。\n兴阑犹拍髀，毫末视青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其一 诗将","author":"林逋","text":"风骚推上将，千古耸威名。\n子美尝登拜，昌龄合按行。\n笼纱疑旆影，击钵认金声。\n唱和知谁敌，长驱势已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其二 诗家","author":"林逋","text":"风月骚人业，相传能几家。\n清心长有虑，幽事更无涯。\n隐奥谁知到，陵夷即自嗟。\n千篇如可构，聊拟当豪华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其四 诗笔","author":"林逋","text":"青镂墨淋漓，珊瑚架最宜。\n静援花影转，孤卓漏声迟。\n题柱吾无取，如椽彼一时。\n风骚兼草隶，千古有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其七 诗牌","author":"林逋","text":"矗方标胜概，读处即忘归。\n静壁悬虚白，危楼钉翠微。\n清衔时亦有，绝唱世还稀。\n一片题谁作，吾庐水石围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其八 诗筒","author":"林逋","text":"唐贤存雅制，诗笔仰防闲。\n递去权应紧，封回债已还。\n带班犹恐俗，和节不妨山。\n酒箧将书簏，谁言季孟间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其九 诗壁","author":"林逋","text":"数题留粉堵，还胜在屏风。\n坐读棋慵下，眠看酒恰中。\n僧房秋色冷，山驿晚阳红。\n更有栖迟句，家徒一亩宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张绘秘教九题 其六 诗魔","author":"林逋","text":"花露湿晴春，秋灯落烬频。\n祇缘吟有味，不觉坐劳神。\n寄远情无极，搜奇事转新。\n此魔降不得，珍重五天人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]