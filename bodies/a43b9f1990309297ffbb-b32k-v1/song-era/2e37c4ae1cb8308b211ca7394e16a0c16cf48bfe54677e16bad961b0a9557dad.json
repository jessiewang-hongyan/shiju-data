[{"title":"早发襄邑","author":"刘弇","text":"迢迢汴水吞窈冥，白榆多于天上星。\n林梢碎漏月痕白，草头冷泣萤腰青。\n云霄九重近在目，鹓鹭百翮谁趋庭。\n鸡声马蹄正立敌，断送垢褐疲吾形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜泊建溪丰乐驿前三首 其一","author":"刘弇","text":"坐看云叶洗昭回，磴束天仙玉宇开。\n水染东瓯清到骨，客伤南浦酽于醅。\n雪萌正荐浇酲笋，粉色浑藏艳眼梅。\n稍觅暗芳窥熠耀，更从白石认毰毸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜泊建溪丰乐驿前三首 其二","author":"刘弇","text":"鬖鬖彪弁吹颓鬓，戢戢悬鹑戒早寒。\n漂泊昔游堪冷笑，悠飏短梦迫惊湍。\n霜潭傲险苍虬啸，月碛牵波翠筱团。\n十载南冠攲一叶，背人功业底无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜泊建溪丰乐驿前三首 其三","author":"刘弇","text":"溪灵觅罅吹滩声，削木刺波舟逆行。\n问津候馆得丰乐，回首洞天无玉清。\n愁看迮缆叠石子，快是隔篷眠水晶。\n儿曹灯间动喜色，甑有滑白长腰粳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠邑宰詹志行长官","author":"刘弇","text":"头骨插犀冰照颜，胸襟元自涨清澜。\n吏归申午缘无事，民卧田闾识以宽。\n晤语早倾程子盖，评诗尤逼杜公坛。\n如论妙誉无留赏，合向骁壶作倚竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清真观步翠阁","author":"刘弇","text":"飞梯倒插玉螮蝀，危槛别刻青芙蕖。\n送凉野水旧涵竹，借色春山拟滴裾。\n王乔过凫可坐揖，萧史鸣凤徒纷如。\n眸子欲酸跂予望，吊世清泪横方诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清真观清轩","author":"刘弇","text":"向背仙宫总辟琳，兹轩仍出古城阴。\n千年曾史长存魄，一片巢由不染心。\n秋阔雨高天洗翳，夜凉风软月吹金。\n冰壶早讶贮人世，况复隔溪葱茜深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清真观斋轩","author":"刘弇","text":"物理相悬能几何，是非得丧了无多。\n仙家日月闲庭户，人世浮沉寄唯阿。\n矗橚晓声来杂佩，涟漪春脉涨青罗。\n个中故有天倪在，持语流光任掷梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月波楼","author":"刘弇","text":"玉魄冰魂万顷连，曲栏仍在斗魁边。\n浮天自作通津去，洗客终疑爽气偏。\n不比寻常闲水墨，最宜三五好婵娟。\n翚飞稳蘸明河接，更拟凭虚逼岛仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺氏怡轩","author":"刘弇","text":"盘薄檐牙紫翠间，正缘天属得恬安。\n已闻名教兼三乐，况有家声到二难。\n棠棣萼留春色好，鹡鸰原占洞天宽。\n友于谁复知真适，拾穗荣期似太漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建德县作","author":"刘弇","text":"铜官南部号无事，烟火萧条数百家。\n令尹印章希搭纸，里胥邦赋半催茶。\n山稠别限番君国，潦暗疑通海客槎。\n石磴落当萧寺面，怜渠清绝好生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新开湖诗 其一","author":"刘弇","text":"输写由来未易穷，浑疑天作水仙宫。\n浩无边际蓝吞野，散作沾濡雨卷空。\n末口潦收秋涨缩，污沟波泛暮潮通。\n会当挥楫乘高兴，尽把尘缨濯此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新开湖诗 其二","author":"刘弇","text":"平铺绉縠几千寻，潇洒由来爽客襟。\n天借月华来海上，地蒸云气出波心。\n鱼虾泽国抛残玉，灯火船窗点碎金。\n闻说蚌胎无颣颗，又凭风力舞秋阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送廷允决曹解官舟行赴阙 其一","author":"刘弇","text":"由来佳掾推三语，故有能名擅一方。\n投分稠人期李郭，平心他日到于张。\n囹扉尽洗沉冤魄，贯索时分入夜光。\n举世谩嗟岐路涩，只今腾踏见飞黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送廷允决曹解官舟行赴阙 其二","author":"刘弇","text":"春江活碧染衣浓，闹橹初挨鹢首东。\n岸柳跃丝金稍重，渚梅收糁玉全空。\n腐儒糟粕迂疏后，上客风云感慨中。\n好访瀛洲缀仙客，家山无苦梦壶公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬","author":"刘弇","text":"束书归伴鹤头游，赢得髭根未雪如。\n春圳有田皆杜鄠，晓窗无岫不衡庐。\n糟床最与天真近，鱼沫何妨世态疏。\n鞟足龟腰负芝朮，因君特地愧三馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵表民偶作","author":"刘弇","text":"纷纷仪覆与秦倾，何者竟为吾道行。\n物外金朱犹土梗，兴来诗酒亦功名。\n梦同秋栈萦纡入，分比春兰馥郁生。\n他日未宜轻感慨，劝人归是子规声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政曾宣德十二韵","author":"刘弇","text":"自得逍遥物外情，肯将冠冕谩劳形。\n门前始种先生柳，斗下重添处士星。\n文豹雾中谁逐逐，飞鸿天外自冥冥。\n最怜孤竹人高卧，却讶三闾客独醒。\n放旷七贤林下洞，栖迟六逸水边亭。\n和烟买得花栽润，带雨移来药颗馨。\n凫舄印残苍藓绿，蜗庐筑破远山青。\n消磨日月棋千局，笑傲云霞酒一瓶。\n隐几旋成招隐句，披衣新看养生经。\n小轩静把琴开匣，幽苑深将鹤剪翎。\n明月有时来竹坞，红尘无路到松扃。\n几多九老图中景，都为丹青入障屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上金陵黄尚书安中二首 其一","author":"刘弇","text":"南来踽踽拜前尘，雅眷仍从辙鲋新。\n四照色温初似玉，一时恩到总成春。\n非如学者论糟粕，须信人间得凤麟。\n况有珠玑长满把，冥搜终恐物华贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上金陵黄尚书安中二首 其二","author":"刘弇","text":"千毫回斡自无旁，逸劲仍闻饮石梁。\n黄卷素心因事见，空门真味与閒长。\n扁舟尚录袁临汝，清酒无论顾建康。\n五载转头归一瞬，门阑依旧笑羝羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安中东楼会饮","author":"刘弇","text":"岧峣飞观决层云，主意全倾合坐宾。\n谈笑龙冈下白日，衣冠麟阁识功臣。\n欲穷人目逢山好，未老秋容到酒醇。\n忍对南鸿问寥廓，沉冥谁是蜀庄珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安中铁柱留题","author":"刘弇","text":"隐然平地起嶙峋，千古舂波此与濒。\n九牧贡金殊夏后，三泉下锢笑秦人。\n力回坤轴阴机壮，妙洒银钩榜墨新。\n欲识当年镕铸意，莽芦终恐更非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王公济四美楼","author":"刘弇","text":"寸心不与一物隔，远目自为千里期。\n便共溪山有情分，更缘阡陌识参差。\n层云异日虽轻举，独鸟长年可俯窥。\n缇骑到家春满眼，庾公清兴不应衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王公济兰荄亭","author":"刘弇","text":"闾里传惊饱物华，此亭真是一生涯。\n人知菽水欢终异，地比蓬蒿径自佳。\n岁计黄云千䆉稏，春心青玉几龙蛇。\n不须分外开新畹，故有儿孙敌谢家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李倅惠诗次元韵酬谢","author":"刘弇","text":"寸毫挥洒敌连城，想见仙标白玉京。\n周鼓直须论妙刻，陶琴初不费烦声。\n他年浪许曾窥豹，此日谁堪与濯缨。\n寂寞蓬茨今有助，病躯那复愧登瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵和酬","author":"刘弇","text":"俗眼纷纷少得青，独君襟义富坻京。\n挥斤郢鼻时惊巧，持鼓雷门浪费声。\n正喜珠玑生咳唾，敢期茅蕝被游缨。\n鲰生谫谫难论报，此日方知海是瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九曲池","author":"刘弇","text":"昔帝樯乌下日边，曾留清跸此蹁跹。\n鱼龙窟暗浮春涨，凫雁行低破暝烟。\n星阁摧颓空岁月，芜城埋没旧山川。\n后庭一曲陈家破，更看当年水调传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"支筇","author":"刘弇","text":"蹭蹬年来谁寄声，静支筇竹了无营。\n照衣檐竹露逼冷，过耳海潮风送清。\n岂有稻粱骄雀鼠，终惭醅酒费瓶罂。\n请缨自是男儿事，咄咄胡为过半生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和重阳感怀","author":"刘弇","text":"又逢佳节破牢愁，天卷微云尽放秋。\n一水孤飞临汝桨，几人清兴庾公楼。\n萤腰乱试林塘点，蝇阵微收几案稠。\n黄菊红萸满乌帽，椒丘谁是醉乡谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬锡远孤坐有怀","author":"刘弇","text":"白简差差长蠹鱼，强颜那复计三馀。\n长波不洗客愁去，脱叶似将官况疏。\n行乐醉乡金欲尽，投身老境岁还除。\n因持旧史论窗烛，大半功名不是书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和刘次公以诗见赠","author":"刘弇","text":"格老辞严趣复新，百篇洗眼尽惊人。\n喑呜自是东骚将，潇洒疑非阀阅身。\n快甚天星秋炯炯，富于仓廪昔陈陈。\n终惭不敌齐呀喊，敢议肴羞与栗榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄兜率悦禅师二首 其一","author":"刘弇","text":"三峡当年一锡飞，祖灯曾是密传西。\n示徒端的只消指，灌顶分明别有醍。\n秋衲拥云惊晓榻，病髭镊雪照寒溪。\n知谁解吸西江水，赖有孤禅觉众迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄兜率悦禅师二首 其二","author":"刘弇","text":"箯舆曾约下山颜，白足尘缘等是悭。\n贪为水云留物外，劣容纸墨到人间。\n银潢一掬愁枯肺，金钥千重想上关。\n病客此身似笼鸟，何时毳衲对斓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬何伯修见贻","author":"刘弇","text":"学非歆向擅家声，僮指仍惭左蜀程。\n梦月自怜名旧识，屠龙何补技先成。\n悲缠风树新创钜，心折家园独鸟惊。\n樵斧渔竿有真趣，不应邻叟怪逃名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬何伯修","author":"刘弇","text":"广场较艺号肩摩，笔挫千人敏若梭。\n共喜此声传烜赫，直应无物避爬罗。\n雅音尚汩多哇郑，荆璞谁收屡献和。\n洗眼今看色丝语，快于执热濯东波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬谭履常送致政徐朝奉","author":"刘弇","text":"拔迹朝闺太早生，不容馀蕴付功名。\n肯缘簪绂重回首，似共林塘别有情。\n恰恰冥鸿如素志，来来弊屣薄浮荣。\n留赀无有公何恃，赢得桑榆慰此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王适中渝饮约以诗招之","author":"刘弇","text":"别君倒指倏旬日，顾我摇心如旆旌。\n满引未应勤上客，高谈聊欲破劳生。\n望梅终恐难酬渴，挹露悬知别得清。\n咫尺履綦犹惜到，可能无复故人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送致政吴通直","author":"刘弇","text":"黑头贪作隐中仙，高谢清时五两纶。\n物外收将閒日月，人间归去好溪山。\n二疏等作挥金计，五柳犹迟倦鸟还。\n多少有车悬不得，规规钟漏亦胡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢何舜庸见借画舫还乡","author":"刘弇","text":"好样江边青雀?，愧君暂借不相妨。\n帆樯缥缈青天近，窗户玲珑白日长。\n浓绿迢迢春到水，衰颠种种客还乡。\n却应耆旧遥知羡，况味浑如临汝郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉酬何舜庸寄酒","author":"刘弇","text":"寄来何啻十千价，置处曾非六一身。\n自惭无足斗筲算，暂见已觉神形亲。\n他年换得青田核，此日吹回紫府春。\n剪却愁根真外助，不妨功胜齿亡唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政李元古二首 其一","author":"刘弇","text":"膴仕委蛇四十秋，翻然归作赤松游。\n无瑕旧是千金璧，不系今如一叶舟。\n举世风霜空末路，此身芝朮最良谋。\n新篇晚更追骚雅，何计从公乞愈头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政李元古二首 其二","author":"刘弇","text":"兴味高于鹤在云，去留初不挂毫分。\n郑公乡里新门巷，谢氏芝兰好子孙。\n潇洒笑谈宽日月，优游在世傲乾坤。\n邻翁盛说归欤美，曾是当年朱两轓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴伯玉二首 其一","author":"刘弇","text":"少年腾踏属骅骝，骨相疏明玉照秋。\n湓口犹传旧令尹，豫章聊半古诸侯。\n一官身外真无负，百故胸中自不留。\n论荐由来公道在，谁将卓荦到需头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴伯玉二首 其二","author":"刘弇","text":"瞥去门阑两换春，标规仍惬此来亲。\n能将官况为馀事，别有阳和到后尘。\n衮衮何妨流水淡，纷纷谁数白头新。\n拟论一报归恩地，愧我犹为栾棘人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉系南长老","author":"刘弇","text":"诸方喉舌卷舂容，直指慈幢信长雄。\n翳尽全开扪海月，清多平挹洗天风。\n相望震旦传衣后，别寄西儿妙斲中。\n好把沃洲论五老，冁然重此得支公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送螺川张太守二首 其一","author":"刘弇","text":"西南五马照青螺，众惜班春未几何。\n绿发桑榆收太早，青云岐路剩来多。\n仙家职事清閒好，逋客林泉取次过。\n正恐此身休不得，再看邹律起阳和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送螺川张太守二首 其二","author":"刘弇","text":"凉飔一水漾清虚，画鹢翩翩北去初。\n暂把壮图收绂冕，只留和气到阎闾。\n海边有梦通琳阙，物外无心挂隼旟。\n寄语琅琊好泉石，使君不是赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴伯玉九日同会","author":"刘弇","text":"上林曾共见莺迁，五百英豪气戾天。\n斗在并存嗟白发，成空半已锁黄泉。\n菊花酩酊同今日，桂籍风流记旧年。\n愧辱新诗无以报，误烦褒笔比青钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬张商佐","author":"刘弇","text":"跧迹青纶木不春，洗君眉宇海津津。\n江湖隔阔青螺梦，岁月飘零北固身。\n俯仰未应羞彼俗，漱衔仍喜属吾人。\n嚼螯擘壳怀哉乐，又作秋风一笑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清凉法和禅师","author":"刘弇","text":"东南谁是识弥天，觉海乌藤搅欲乾。\n金色髯耏飞妙吼，云间头角傲秋蟠。\n觚棱势逼嶙峋去，杖屦阴回矗櫹宽。\n十载洒然重洗我，一襟通底是清澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪王纯父燕历阳连云观","author":"刘弇","text":"天门直北八公西，杏栱梅梁脱蔽亏。\n金叶卷空飞鸟影，冰纨浮入茂林姿。\n裁云丽服淮娥踏，熨齿纹线楚客辞。\n十二玉帘浑轴水，瘦龙捎月叫参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江馆三首 其一","author":"刘弇","text":"山川定出书意外，鱼鸟自闲眠对时。\n艇子黏天归一叶，涛头吹雨落千麾。\n截波尚欲论孤剑，应客初惭乏大儿。\n听得渔郎隔溪语，夜来秋色暗江蓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江馆三首 其二","author":"刘弇","text":"无尘一境好仙去，有梦九秋应鹤知。\n弱筱婵娟藏别坞，野荭高下补疏篱。\n秫田百亩堪供酒，脍手千刀间忆鲻。\n未愧镜湖誇贺监，聊将星管觅桓伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江馆三首 其三","author":"刘弇","text":"连云草树纵横幕，点水凫鸥黑白棋。\n日晏厨烟青一穗，暑馀窗雨暗千丝。\n饱闻杨恽生行乐，懒赋张衡我所思。\n软碧会须连月占，恣看飞楫界琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠高邮尉郭奉世","author":"刘弇","text":"好样仙曹斗野西，不将颜色傍人低。\n由来胸腹开濛汜，故有篇章照黑蹄。\n采捧挂门虚昼警，鸱夷浮客趁秋跻。\n风胡去世纯钩蛰，谁取吹毛瑩鸊鹈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵鹫寺","author":"刘弇","text":"蠹粉侵侵抱缭墙，佛祠仍是旧仙乡。\n晴雷殷地溪声转，顽橐吞空洞脉长。\n旦过客分云卧冷，腊高僧煮涧毛香。\n须知剩得天龙护，别绕森严十万冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光相洞","author":"刘弇","text":"仙客当年蜕尘土，洞天此地老烟霞。\n顷来鸡犬如无迹，里许山川别是家。\n辽海不归千岁鹤，武陵频换一番花。\n可能匕上胡麻饭，变得劳生两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自竹岩至杉溪","author":"刘弇","text":"晓寻葱茜踏顽云，越俗闽风杂楚民。\n天窄定藏巫峡雨，溪深疑有武陵春。\n驱寒万籁争奔壑，竞秀千峰自逼人。\n断送残年归马首，却羞头著故纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送狄太守清明日燕莆田共乐亭三首 其一","author":"刘弇","text":"青幢翠葆抱参差，浮客黄金凿落晖。\n一日山川如得主，两眸天地不藏机。\n华胥有国真稀阔，齐物名篇孰是非。\n涩道直西暄绛蜡，卷空箫鼓使君归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送狄太守清明日燕莆田共乐亭三首 其二","author":"刘弇","text":"赤白觚棱插戾翰，东南重此识多盘。\n起从海若三山外，分得壶公一境宽。\n世事升沉随过鸟，物情潇洒属层峦。\n画图恐是天抛掷，乞与莆人恣展看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送狄太守清明日燕莆田共乐亭三首 其三","author":"刘弇","text":"他年胜践归林记，大半豪誇落蔡篇。\n快甚跃壶窥日月，泪疑枯海变桑田。\n觥船照客吹红液，轩槛娇春扑紫烟。\n到得无云剩寥廓，此身仍在鸟飞边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿泗洲院","author":"刘弇","text":"羸骖戢束来闽岭，晚岁峥嵘宿泗洲。\n一缕蝉联通鸟道，万鞓层叠挂民畴。\n林标入夜梢云梵，暖色先春动毳裘。\n谁把地祇金锁掣，踏开行客古今愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建州试院次韵和林原叔监试","author":"刘弇","text":"鹭袍粉白笔摩秋，馀地争看众刃游。\n坚壁赖公专细柳，得壶如我愧中流。\n仆姑此日先穿札，绿绮何心晓报镠。\n恰恰丰隆通蛰户，论功相与副旁求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]