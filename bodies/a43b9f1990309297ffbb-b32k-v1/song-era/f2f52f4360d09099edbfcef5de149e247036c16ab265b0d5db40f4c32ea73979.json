[{"title":"欢喜口号 其二","author":"黄彦平","text":"残魄游魂詟复猜，焚舟弃甲总头回。\n天家会遣杨无敌，磨斧衔枚夜半来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欢喜口号 其六","author":"黄彦平","text":"蜀茶互市入西番，番马来嘶渭水寒。\n为报尧峰吴少保，径招属户会长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欢喜口号 其三","author":"黄彦平","text":"愁见淮阴打阵来，白毡玄甲倒如摧。\n山东降卒时时说，说道番人怕背嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到池州沿檄阻风麻步 其二","author":"黄彦平","text":"贵池鱼味不复美，秋浦猿声自昔哀。\n南人官此欲归去，为问北人来不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到池州沿檄阻风麻步 其一","author":"黄彦平","text":"悲风林际万牛斗，惊浪江间百马奔。\n舟归指点淮南岸，桅折船漂何处村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿坡书事 其一","author":"黄彦平","text":"决决沙泉取次流，小堤闲贮一奁秋。\n莫将霞鹜飞飞影，认作兰成万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿坡书事 其二","author":"黄彦平","text":"拟栽垂柳待栖乌，招买风光计已疏。\n只有碧芦驯白鸟，系愁萦恨不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿香严寺 其二","author":"黄彦平","text":"天生忠孝程伯禹，国有老成黄嗣深。\n山北山南时一过，闲云野鹤故人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明","author":"黄彦平","text":"去国扊扅悲往事，还乡笳鼓愧前修。\n十年过计千章木，一寸离心万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清溪解缆用秀才甫韵寄杜藏用 其二","author":"黄彦平","text":"长年三光占嶰筒，笑语天回西北风。\n高城遂隔不足道，只忆齐山幽桂丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未南徐灯夕","author":"黄彦平","text":"王正三五漫佳节，浊酒寒灯且眼前。\n无复鼓歌祠太一，真成烽火照甘泉。\n疏梅攲雪摇相忆，淡月笼云也自圆。\n北极朝廷知不改，起占天步亦茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十三日步至杏亭","author":"黄彦平","text":"禅房幽讨有谁期，竹径穿花蝶不知。\n山拥暮寒斜照里，树含芳思欲开时。\n和风第放千林喜，胜日闲成一段奇。\n何必红尘污人后，始从箫鼓看繁枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大通铺","author":"黄彦平","text":"寒食祇数日，春光犹一分。\n风烟明杲杲，莺蝶闹纷纷。\n馆地红铺绣，汀洲绿妒裙。\n芳馨有谁遗，吾欲降东君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王子才军中有道人鬻笔既售而去笑曰吾姓名在管中破视有细字曰李洞长求之不复见矣","author":"黄彦平","text":"车马相逢地，龙蛇杂处中。\n从容李洞长，游戏管城公。\n堕履方圯下，跳壶已阆风。\n还同贺水部，乘兴看行宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至节假赋愁阴喜霁 其一","author":"黄彦平","text":"爱日明朝至，寒云此夕同。\n预知鸦啄雪，先验鸟呼风。\n乡国追随外，年华感叹中。\n清愁将浊酒，斟酌并成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至节假赋愁阴喜霁 其二","author":"黄彦平","text":"日出湖山丽，寒销草树芳。\n裙腰先蕙碧，妆额次梅黄。\n目极绵绵道，心清细细香。\n南枝春不浅，东阁兴难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣节有感","author":"黄彦平","text":"漫说南风入舜弦，伤时抚事益悽然。\n愔愔新绿愁鸲鹆，悄悄残红拜杜鹃。\n心折更闻胡部曲，眼明那复御炉烟。\n蒜山瓜步江南北，宝鉴经囊若个边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家春日二首 其二","author":"黄彦平","text":"迟日芳众草，微风被野田。\n荒山有吠犬，穷屋亦炊烟。\n花已清明近，茶将谷雨前。\n供输了官事，粗粝任吾年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家春日二首 其一","author":"黄彦平","text":"纬竹梁溪面，诛茅舍道旁。\n腊收冰下纸，春课社前姜。\n露草牛羊长，风花杖屦香。\n人生但如此，官独为谁忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石祈晚泊","author":"黄彦平","text":"江树繁阴合，江流涨沫浑。\n归舟带圆月，倚棹并衡门。\n表表浮屠迥，连连睥睨昏。\n梅花腾远响，杨柳想新翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石埭道中","author":"黄彦平","text":"地势方呈险，溪流不得平。\n涛头开沸白，石齿聚寒清。\n纳纳三江暮，油油万壑倾。\n澄清浑莫测，泯默谅无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华严院","author":"黄彦平","text":"懒病寻幽意已忘，兹辰得与步同冈。\n一声啼鸟唤愁醒，百尺游丝惹恨长。\n沙际旇供随意绿，雪馀何物返魂香。\n江南春色凡如此，谁作新诗为发扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚楚亭集唐句 其一","author":"黄彦平","text":"百丈牵江色，连樯并米船。\n樵苏喧晚渡，鸥鹭浴晴天。\n问舍惭元德，登楼忆仲宣。\n司存兼吏隐，别有一山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚楚亭集唐句 其二","author":"黄彦平","text":"辇路生春草，云安有杜鹃。\n羁栖投老日，邂逅中兴年。\n纪凤初年逼，迁莺霁景鲜。\n愁宽卑湿地，欣对艳阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱希真赠别 其二","author":"黄彦平","text":"偶伴浮云出，还寻倦翼归。\n溯流扶楚施，长夏及荆扉。\n故国荒乔木，劳歌厌采薇。\n本非求独往，要自隔群飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱希真赠别 其一","author":"黄彦平","text":"白头才半刺，黄卷漫三馀。\n鬓秃丝难理，诗工锦不如。\n登山灵运屐，下泽少游车。\n子念从吾隐，吾能授子书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池州府石埭县","author":"黄彦平","text":"腰舆径度远人村，猿鸟声中日易昏。\n山合翠屏迷出入，路随流水听潺湲。\n驾崖凿壁花无主，洗雨梳风暖自繁。\n只欠相逢具鸡黍，便从人说到桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约建德蔡令游梅山晨起微雪 其二","author":"黄彦平","text":"青回沙际草先知，稍傍芳林上故枝。\n野寺残僧微雪后，冻云寒雁共来时。\n不愁眼里无诗本，却要胸中有画师。\n已拚入城官长骂，留连风物得归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约建德蔡令游梅山晨起微雪 其一","author":"黄彦平","text":"长年踪迹困尘埃，几向名山勒驾回。\n闲约访僧寻野寺，翻成踏雪看官梅。\n岫云要是无心出，溪月犹能有兴来。\n竹折松攲更愁绝，不妨吟赏助清哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴虎臣献书行阙","author":"黄彦平","text":"山北山南烟霭横，破烟啼鸟已催耕。\n能来夜雨连床语，大似春风不世情。\n琳馆陆沉吾已老，金门宠辱子方惊。\n集贤学士应相谓，诗客形容太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙音方丈","author":"黄彦平","text":"弥勒同龛夕，维摩示病情。\n炉残文武火，灯暗短长檠。\n耿介游良苦，温柔梦不成。\n颦眉挑锦字，相忆恨高城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还自豫章寄谢胡帅承公 其二","author":"黄彦平","text":"文献尊皇祖，枢机属老臣。\n中庸镇夷夏，精祲极天人。\n嗣武躬戎服，边头亦战尘。\n毋云予小子，家国待经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还自豫章寄谢胡帅承公 其三","author":"黄彦平","text":"翰墨南州士，弓刀北府兵。\n几年闻战伐，两地费经营。\n伧父吴儿笑，儒冠武弁轻。\n人才广收拾，归共致升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还自豫章寄谢胡帅承公 其一","author":"黄彦平","text":"陆贽挥毫敏，廉颇仗钺频。\n人言绥远俗，吾念隔中宸。\n虎落新军睦，鸡翘旧望亲。\n玉堂清夜直，学士固应真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还自豫章寄谢胡帅承公 其四","author":"黄彦平","text":"误解陈蕃榻，惭升贾谊堂。\n丝纶今典诰，钟铉古铭章。\n窥豹迷深隐，攀龙漫激昂。\n鼎梅同臭味，妙语更难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟兜率寺呈王承可 其一","author":"黄彦平","text":"樯燕惊三叠，刀鱼送两旗。\n雨篱花淡泊，风岸柳参差。\n晚并知名寺，同寻没字碑。\n摩挲几来者，沿溯总何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟兜率寺呈王承可 其二","author":"黄彦平","text":"龙用中宵壮，风扬广岸波。\n不堪簉鸳鹭，合作傍鼋鼍。\n寂寂灵妃瑟，滔滔孺子歌。\n微君澄练手，如我布帆何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临川投赠 其一 黄嗣深","author":"黄彦平","text":"主计怀萧相，临民起次公。\n履声元自识，环赐固宜蒙。\n便觉长安近，宁论茂苑雄。\n别诗无好语，虚忝荐贤中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临川投赠 其四 莫寿朋","author":"黄彦平","text":"发策魁丹陛，摛文重禁林。\n麒麟鞭缕玉，菡萏烛摇金。\n事与京尘改，愁将瘴发侵。\n东还应晚合，未用叹升沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临川投赠 其三 韩子苍","author":"黄彦平","text":"今代昌黎伯，琳宫尚陆沉。\n极知延阁峻，仍记掖垣深。\n简古元和样，精微正始音。\n居然合廊庙，过听著山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故人亭","author":"黄彦平","text":"寒里花开晚，霜馀叶落深。\n云天迷远望，山水费登临。\n瑟鼓英皇怨，沙沉屈贾心。\n高名前后事，苦调短长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡帅见和用韵再寄 其三","author":"黄彦平","text":"国步谁为梗，民生乃见兵。\n选贤丞相府，持节伏波营。\n健笔千钧重，先锋一鸟轻。\n征南多兴绪，相忆暮云平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡帅见和用韵再寄 其一","author":"黄彦平","text":"本朝求治切，大府课功频。\n葵藿长倾日，槐枫远被宸。\n深心怜父老，慈训念君亲。\n奉计他时事，仍看汉相真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡帅见和用韵再寄 其四","author":"黄彦平","text":"挟书游北阙，发策列东堂。\n遽骇豺狼怒，因潜虎豹章。\n已应长寂寞，无复变轩昂。\n公若登台辅，平生或不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨当时夔漕","author":"黄彦平","text":"桃花浪稳布帆张，汉节新除蜀郡郎。\n自昔儒林无别墨，只今文苑有他杨。\n碧鸡回谷光灵远，白狗稠滩道路长。\n我亦郎潜归未得，故溪幽梦炯鸥行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何端卿帅泸 其一","author":"黄彦平","text":"何侯石友平生事，傅粉风流讵可同。\n谁使拥旄三峡外，不留持橐五云中。\n啼猿此去欺残月，回雁因来托便风。\n亦念人生行乐尔，且拈重碧擘轻红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何端卿帅泸 其二","author":"黄彦平","text":"人物当年盛学宫，笑谈尝许小人同。\n分襟短艇江湖去，回首觚棱涕泪中。\n却叙檐花听夜雨，又还菰菜动秋风。\n秪应黄屋收京了，邂逅东华踏软红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄司录 其一","author":"黄彦平","text":"异县伤流落，同官及老成。\n诗书尚家法，谱系更宗盟。\n岁暮一樽酒，阳春千里行。\n双旌定何处，抚字振新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过京口","author":"黄彦平","text":"江北江南形胜地，忆伤游子少年心。\n波分杨柳愁边碧，月带蔷薇笑里阴。\n铁瓮只今虽料理，金山久已罢登临。\n寄声瘗鹤岩头字，莫厌龙蛇万里深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弱水","author":"黄彦平","text":"弱水三千里，仇池十九泉。\n颇疑仙境界，不隔世山川。\n海阔虽无地，壶深别有天。\n何因霜雪后，一壑独苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓发东流如建德途中作","author":"黄彦平","text":"听风听水东流寺，为雨为云建德山。\n拍枕波声犹在耳，参天秀色不违颜。\n春来草草才正月，柳内时时见一斑。\n齑臼工夫浑未有，藁砧行李已来还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿东流县威神寺","author":"黄彦平","text":"雪梅风柳破韶光，又扑征尘宿净坊。\n坏壁老师真数面，隔年题字故斜行。\n王春三月向人好，禅诵六时销日长。\n来往区区秪如此，桃花应亦笑刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事寄怀王彦舟侍郎苏景谟大夫 其三","author":"黄彦平","text":"燕市人初去，辽城鹤共飞。\n兵戈虽向息，闾井已云非。\n险阻千山路，艰难百口归。\n扶携兼老幼，吾见亦依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事寄怀王彦舟侍郎苏景谟大夫 其四","author":"黄彦平","text":"明月人千里，青阳岁又除。\n曲江行有债，幸舍出无舆。\n细写蝇头字，摇看雁足书。\n长江不可厉，幽意若为摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事寄怀王彦舟侍郎苏景谟大夫 其二","author":"黄彦平","text":"绝壑惭怀宝，清时自贡珍。\n光芒殷地发，斤斧响山臻。\n经画烦才吏，馀赢逮细民。\n尚应来汉使，金碧傥能神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事寄怀王彦舟侍郎苏景谟大夫 其一","author":"黄彦平","text":"藨蓘年仍恶，耕桑命亦微。\n原头买茶去，江口换鱼归。\n顾影行犹畏，全生计已非。\n五陵游侠客，裘马本轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二妃庙","author":"黄彦平","text":"舜生诸冯没负夏，南游晚葬苍梧野。\n九峰中隐土一坏，草树苍茫谁辨者。\n皇英不祔只孤坟，妃祠别占清湘原。\n略无石马充故物，但有丛筠志泪痕。\n山川相远终相望，衣冠来游环佩响。\n风急真成鹤羽飞，波寒不隔龙工往。\n鲛室何人相与居，月明警跸万灵趋。\n未论甄后拾翠羽，定见李白骑鲸鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己酉人日","author":"黄彦平","text":"寒梢发颖斗临寅，玉烛初调七日春。\n稍稍江云欲回雁，醺醺花气已撩人。\n胡来莫道长安近，老去空惊甲子频。\n南渡诸君且书剑，北宸双阙正风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五峰竹","author":"黄彦平","text":"此君抱节怀霜露，裁以广寒修月斧。\n区区拔颖陋管城，落落中绳宜册府。\n潜心几绝西门佩，隶古亲传伏生语。\n后来颉颃追时好，客卿子墨先生楮。\n慈恩柿叶剡溪藤，俗嗜纷纷那足数。\n何人喜事翻新制，林下风流微近古。\n宣心写面却缄囊，百草千葩增媚妩。\n青奴小忍供笔砚，晴窗示尔梅花赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元符已卯冬至先君罢兴国令宿皇恐滩有诗云倦客逢长至扁舟泊远滩居常谙寂寞童稚笑相欢后十七年自成均谒告还乡是夕沿斡宿新淦寺有感赋此","author":"黄彦平","text":"去年度长淮，霜月照孤驿。\n今年适异县，香雾依禅寂。\n人生几冬至，南北均行役。\n风枝无停号，遗句诵悽恻。\n生男当门户，堕地要膂力。\n抚我谓我臧，诲我以文术。\n宁知事大谬，木拱玄尚白。\n百巧换千穷，只有不如昔。\n晓灯离室暗，又踏它山碧。\n行行重行行，风尘儿亦得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其一","author":"黄彦平","text":"惊风吹鸿鹄，一举仪天衢。\n劲翮自肃肃，弱羽犹区区。\n时于蒿艾间，得粒鸣相呼。\n永愧燕雀情，我岂不足欤。\n鹏运与鸥没，远近各有图。\n方当绝四海，安敢怀此都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其七","author":"黄彦平","text":"脩竹不受暑，飘然无定著。\n炯炯月明枝，萧萧风陨箨。\n佳人洞天晓，羞多頩怒薄。\n玉雪生林际，绀袖花零落。\n尘埃褦襶子，执热何由濯。\n亦复起遐瞻，层冰架松壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其十","author":"黄彦平","text":"遗堞感至今，平生行乐处。\n英雄除霸王，俯仰成今古。\n昔日城中居，此日城边墓。\n鱼龙与爵马，共尽谁能数。\n悲风天末起，陌上行人去。\n凄凉王仲宣，独咏登楼赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其八","author":"黄彦平","text":"石戴古车辙，人生来往勤。\n双轮不生角，越绝会通秦。\n坐令丘壑姿，化作京洛尘。\n君看钓鱼矶，鼻口罗江津。\n浮走例有役，俛仰俱已陈。\n吾亦永愧尔，东西南北人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其三","author":"黄彦平","text":"古来达士志，爱日怀兢慎。\n皇皇百年心，穆穆三才顺。\n后生不作意，易名才慕蔺。\n感慨能几何，繁华终共尽。\n不须吟梁父，亦勿歌虞殡。\n当从箪瓢人，勇退以为进。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其九","author":"黄彦平","text":"神物有显晦，飞潜不同群。\n为梭蓄雷电，为剑动祥氛。\n鱼服与蛇行，委蛇隐其文。\n嗜欲未可求，物象畴能分。\n一朝逝不留，万里垂天云。\n回首视山泽，凡鳞故纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]