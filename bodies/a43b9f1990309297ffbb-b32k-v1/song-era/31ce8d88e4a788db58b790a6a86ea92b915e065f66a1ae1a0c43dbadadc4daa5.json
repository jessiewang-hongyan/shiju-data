[{"title":"次韵宇文德蒙春日道中二首 其一","author":"郭印","text":"满目风光丽，春连几处村。\n江山挑客思，桃李忆家园。\n飘泊流三峡，穷通付一樽。\n菟裘如可老，归去葺衡门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵师时发溪桥晚眺","author":"郭印","text":"卧溪古木势蜿蜒，伫立斜阳旅思宽。\n湍没岸痕知涨溢，风生水面觉清寒。\n静容桃李敷浓荫，暖放凫鹥浴短翰。\n隐约渭滨真髣髴，行藏都付一渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵余时升见招","author":"郭印","text":"老大逢春意转微，追随不复似当时。\n怜君旧已开三径，顾我今方卜一枝。\n近水遥山元自好，暖风迟日更相宜。\n便当乘兴寻花去，免使园林恨失期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋正纪见贻","author":"郭印","text":"欲蹑神仙境，深穷道德经。\n坎男元服素，离女自披青。\n有意闲眠日，无心出戴星。\n但令炉灶煖，丹熟自然馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵时升春尽之作","author":"郭印","text":"送春仍恨酒杯乾，今夕休眠到漏残。\n歌舞纵无供笑语，宾朋犹有近门阑。\n伤心已讶千林绿，转眼还看万叶丹。\n节去节来君莫问，诗盟从此勿令寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李久善近诗四首 其四","author":"郭印","text":"高人来折节，不免稻粱谋。\n排闷唯诗卷，消愁只茗瓯。\n此时同幕府，何日共仙舟。\n气味难相得，逢君写我忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李久善近诗四首 其三","author":"郭印","text":"黄叶翻空舞，西风又作寒。\n懒将书帙整，愁见酒杯乾。\n物理秋多感，天文夜细看。\n鸾旗犹未返，一介敢偷安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李久善近诗四首 其二","author":"郭印","text":"尘氛蒙帝阙，国难古来稀。\n恻恻民情见，茫茫天道非。\n愚千虑切，孤宦一身微。\n万里瞻行在，神魂日夜飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李久善近诗四首 其一","author":"郭印","text":"凛凛宸居壮，胡为杀气昏。\n奸臣由一辙，乱政出多门。\n天命何曾改，朝纲本自存。\n嗣皇真有志，反手定乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李尧俞良臣论交一首","author":"郭印","text":"深知不作昌时瑞，成茧那能效野蚕。\n世态如云从自薄，交情若水定非甘。\n最怜炊黍张生约，勿笑分财管仲贪。\n欲结他年渔钓友，江湖舍我复谁堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行见寄六首 其六","author":"郭印","text":"我爱使君直，使君怜我真。\n短长才自异，劳逸事还均。\n意在形骸外，人疑手足亲。\n共嗟征赋急，无术济斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行见寄六首 其五","author":"郭印","text":"蜗居营盖了，一色草茅新。\n庭砌才容马，斋房可授宾。\n竹轩聊寄傲，蔬圃未全贫。\n邻舍逢知己，过从岂厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行见寄六首 其四","author":"郭印","text":"华颠何见逼，强半百年身。\n眼瞀文书过，心闲药物亲。\n卫生元有术，却老未逢人。\n此道须君至，寒灯子细陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行见寄六首 其三","author":"郭印","text":"拟作渊明去，宁为祖逖先。\n筑庐须近水，卖剑且求田。\n短烛窥今古，清樽乐圣贤。\n卜邻真有意，相与庆馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行见寄六首 其二","author":"郭印","text":"佳人秋水远，思忆破晨昏。\n酒尚无同把，文谁与细论。\n心交神自契，目击道先存。\n他日如寻访，柴扉水竹村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行见寄六首 其一","author":"郭印","text":"世事惊迁改，人生苦别离。\n一年仍异地，千里共劳思。\n雁足传来信，蝇头写到诗。\n丁宁林下意，端不负心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其十","author":"郭印","text":"圣处沉潜久，心华始发明。\n绝知人事缪，顿觉世缘轻。\n俗薄天难定，时危道不行。\n折腰甘五斗，无意问弓旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其九","author":"郭印","text":"良友何年会，书来细作行。\n柏寒知岁晚，花落笑春忙。\n从宦愆行乐，休心得坐忘。\n神炉丹已就，一粒待君尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其八","author":"郭印","text":"举世趋昏浊，前贤慕独清。\n低回从客笑，怀卷待时平。\n彭泽非难学，菟裘且旋营。\n乐哉莘野趣，功业在深耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其七","author":"郭印","text":"谁念疲民瘠，空令战士肥。\n羽书传警急，花院锁芳菲。\n冠屦将身误，山林与愿违。\n两途俱不遂，衰鬓绿毛稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其六","author":"郭印","text":"江路曾浮宅，悬崖两壁青。\n晴烟笼小艇，落照射高亭。\n花簇红妆岸，鸥群白点汀。\n何时篷底卧，半夜酒初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其五","author":"郭印","text":"弱柳青垂缕，新蒲紫作茸。\n风光明老眼，岁月养衰容。\n涸思诗难巧，孤斟酒易供。\n逍遥北山下，一榻傲羲农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其四","author":"郭印","text":"圆吭高低唱，奇葩赤白章。\n每嗟官束缚，肯放酒颠狂。\n幕燕终难稳，池鱼欲自藏。\n宦游何处好，山北是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其三","author":"郭印","text":"雨过川原秀，烟光画不如。\n人情花动荡，春意鸟分疏。\n造化空陈迹，乾坤一广居。\n小轩聊燕息，夏屋正渠渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其二","author":"郭印","text":"公退幽斋坐，悠然对碧岑。\n吹香花拂拂，围翠竹森森。\n蝶散红芳歇，莺藏绿树深。\n吾心清似水，尘境勿相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜安行嘉陵春日书事十首 其一","author":"郭印","text":"老觉情怀别，愁随节令来。\n草茅思雨露，天地涨氛埃。\n屋雀春弥怨，山云昼不开。\n何人知此意，藜杖独登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨信仲见贻郊居二首 其二","author":"郭印","text":"野老樵夫作比闾，儒宫一亩亦安居。\n浇愁剩买村前酒，引睡频拈架上书。\n江近云烟长到户，人稀鸟鹊自驯除。\n不才已分时流弃，犹幸能延长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨信仲见贻郊居二首 其一","author":"郭印","text":"平生不喜入州闾，林下江边谩卜居。\n解榻延宾同笑语，杜门教子读诗书。\n最怜舍后蔬盈圃，只欠庭前水绕除。\n官路崄巇端可畏，茅茨固就早悬车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邵子文感春之什","author":"郭印","text":"海内风尘涨，人间日月忙。\n鬓霜催晚景，杯蚁负春光。\n闻道花成锦，空怜鸟似簧。\n眼前朱墨乱，无处话愁肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邵子文感春之什","author":"郭印","text":"池塘不似昔年春，蝶乱蜂狂更恼人。\n莫傍花丛看婉娩，且怀诗卷诵清新。\n山林祗管萦魂梦，寰宇无端变劫尘。\n遥想江东忧未歇，可能熟醉巧谋身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵明法游法相院二首 其二","author":"郭印","text":"禅扉尘不杂，景趣自然幽。\n黛色排轩入，仙香绕殿浮。\n傍林滋野兴，出郭契清游。\n归路风埃起，眠沙愧白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵明法游法相院二首 其一","author":"郭印","text":"市近清江隔，林深古寺幽。\n竹光浓欲滴，山色翠交浮。\n咫尺人稀到，寻常客共游。\n机心吾已息，来往不惊鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵南伯唐福道中","author":"郭印","text":"宿雨郊原润，晨风草木凉。\n村醪饶客醉，山鸟笑人忙。\n石罅泉能洁，篱根笋自香。\n箯舆终日倦，惆怅旧林塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵费梦得晚秋感怀三首 其三","author":"郭印","text":"摇落秋风晚，吾衰已一翁。\n不堪居世上，宁忍卧山中。\n帷幄人焉用，尘埃帝尚蒙。\n仰天无计出，老泪溅寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵费梦得晚秋感怀三首 其二","author":"郭印","text":"摇落秋风晚，凄凉又一秋。\n汉家元再造，杞国谩多忧。\n七庙存馀泽，诸公合远谋。\n痛心何日定，直待太平休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵费梦得晚秋感怀三首 其一","author":"郭印","text":"日落秋风晚，孤心正北飞。\n地寒戎马健，天阔塞鸿稀。\n翠葆几时复，青山百匝围。\n何当身傅羽，绝域问龙衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁德夫春日书事二首 其二","author":"郭印","text":"满眼烟光困不胜，群红委地绿堆林。\n空庭鸟下簿书退，小院燕归帘幕深。\n千里故人萦午梦，一樽新酒隔春岑。\n多情柳外莺声啭，似向东风写客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁德夫春日书事二首 其一","author":"郭印","text":"公馀萧散步晴晖，正是韶光懒困时。\n官事暂能逃倥偬，物情深觉变神奇。\n风传小树香浮砌，水接平湖绿满池。\n春草怪来成好梦，西堂句法少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵喻存道二首 其二","author":"郭印","text":"神龙一去渺无踪，落日孤云为惨容。\n溪绕练光秋更白，黛横山色晚尤浓。\n细看风物曾经眼，深达根源自点胸。\n寄宿僧寮清不寐，一轮明月挂枯松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵喻存道二首 其一","author":"郭印","text":"访道寻师积有年，晚逢夫子叹高坚。\n玄关启处功深矣，妙指传来意豁然。\n气会三宫驰圣毂，理归一辙弃尘编。\n工夫到后神明出，夺得天机运用权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曾帅遣意三首 其三","author":"郭印","text":"每入先生室，欣闻所未闻。\n心君降六贼，笔阵扫千军。\n炉鼎无人会，刀圭与客分。\n清斋时隐几，闲看岭头云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曾帅遣意三首 其二","author":"郭印","text":"庶民从号令，喜若听春雷。\n顿却寒威退，全呼暖律回。\n决痈资砭石，调鼎待盐梅。\n坐看罢癃俗，眉间蹙额开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曾帅遣意三首 其一","author":"郭印","text":"文章游戏里，政事笑谈馀。\n种就三田药，编成一帙书。\n情忘心自适，神定气长舒。\n四海曾夫子，何人可学欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵董守流杯池","author":"郭印","text":"巧思潜窥造化儿，更依曲水凿方池。\n灵鳌上钓喧红粉，轻鹢浮觞趁彩旗。\n落涧寒声泉㶁㶁，弄花斜日影迟迟。\n分明作个山阴会，仍有当时幼妇辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵嵩师彦正留别","author":"郭印","text":"两公清气入人肝，玉树森森逼我寒。\n挥麈缤纷惊落屑，和诗来往疾跳丸。\n兴馀不管牙签乱，坐久翻忧蜡炬残。\n轻别莫言吾所讳，重逢应作老翁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其十","author":"郭印","text":"蒲郎吾畏友，诗句屹长城。\n道义千钧重，功名一羽轻。\n邓攸无后嗣，卢老是前生。\n世路羊肠剧，君心若砥平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其九","author":"郭印","text":"世道交相丧，从谁见典型。\n圣贤虽泯没，简籍尚丁宁。\n学欲追三代，心终醉六经。\n如何资发冢，陂麦咏青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其八","author":"郭印","text":"日月当头过，风光转眼稀。\n宦游元自薄，生计亦何微。\n要逐时情好，难令野性违。\n富贫同一饱，幸有北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其七","author":"郭印","text":"州县徒劳耳，春秋奈老何。\n交游双寂寞，名利两蹉跎。\n帙散尤增睡，杯行且强歌。\n故人频梦见，谁道隔山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其六","author":"郭印","text":"事业乖初愿，聪明异昔时。\n病多难止酒，愁极漫哦诗。\n适俗非予好，从人莫己知。\n经营三径就，安用印累累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其五","author":"郭印","text":"茅檐同广厦，野蔌当珍羞。\n拟作蓑衣放，宁为肉食谋。\n沉思如有得，寡欲自无求。\n叹息吾衰甚，年来不梦周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其四","author":"郭印","text":"物齐人即我，天运古犹今。\n但得丹田固，宁忧白发侵。\n情忘心坦坦，神定息深深。\n却笑灵均辈，悲哀泽畔吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其三","author":"郭印","text":"世业工看卷，天资拙治生。\n吏曹容小隐，廪禄代深耕。\n痛饮中贤圣，高吟适性情。\n妻孥随我惯，自不厌藜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其二","author":"郭印","text":"时乱那能定，民生不自聊。\n鬓霜秋冉冉，心旆日摇摇。\n敢簉鹓鸿侣，空贻猿鹤嘲。\n眼前谁可意，风月是清交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受书怀十首 其一","author":"郭印","text":"愤时唯泯默，忧国漫咨嗟。\n上略思黄石，中原望翠华。\n散才甘社栎，系迹类匏瓜。\n世事无穷尽，吾生得有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受同游龙洞之什","author":"郭印","text":"寻幽一访洞中天，路绕青溪水绕山。\n翠径崎岖行竹里，红尘咫尺背人间。\n侵裾爽气冷冰雪，漱玉寒流锵佩环。\n更问石庵窥胜迹，斯游岂复倦跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受瀛游富仁院二首 其二","author":"郭印","text":"脱屣尘埃外，结庐猿鸟旁。\n松门深掩月，花坞静含阳。\n攲枕泉春急，焚香昼景长。\n我无林壑分，世路祇茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蒲大受瀛游富仁院二首 其一","author":"郭印","text":"衲子幽栖地，青山绕四旁。\n林昏知暝霭，溪暖觉迟阳。\n泉石关心久，风光引兴长。\n春云多变态，天末淡微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹夫人","author":"郭印","text":"林下风流在，收归枕簟傍。\n冰肌元本净，玉骨自然凉。\n最是虚心好，由来正节刚。\n炎天长作伴，书夜不能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹杖","author":"郭印","text":"长短身为度，洪纤节自明。\n时时勤执捉，处处伴经行。\n峻坂腰能直，危桥步亦轻。\n化龙他日事，灵寿若为荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红梅","author":"郭印","text":"姿韵清高自一家，不将夭艳唤蜂衙。\n冲寒万木浑无叶，回暖孤根独放花。\n要与雪霜争皎洁，肯随桃李趁繁华。\n更看结实调羹在，疏影寒香未足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老境","author":"郭印","text":"怪来齿发日凋疏，坐阅春秋六十馀。\n鬓雪难消休把镜，眼花易发废观书。\n身边赖有三田实，世上须知一梦虚。\n只办此心赢造化，浮沤起灭不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中见月","author":"郭印","text":"濮上今秋月，于人太有情。\n银盘随水涌，素练截江横。\n岸阔天犹近，船虚夜自明。\n寒光连上下，万里一心清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中早起","author":"郭印","text":"迤逦东方白，犹馀数点星。\n乱鸦啼古木，宿鹭起寒汀。\n日衬残云赤，烟含远岫青。\n江山无限思，不觉是飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中雨霁","author":"郭印","text":"雨声收淅沥，霁色起曈昽。\n山顶云蒸白，江心日射红。\n澄波还古岸，宿雾扫遥空。\n更喜前程快，扁舟得顺风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中遇雨","author":"郭印","text":"小舟初别岸，一雨送斜风。\n点点圆生晕，声声碎打篷。\n云山交惨淡，烟树远冥濛。\n有客披蓑坐，凭谁作画工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西台","author":"郭印","text":"高台垂四顾，遗冢阅千年。\n烟树孤城外，云山落照边。\n峥嵘馀巨石，惨淡接平川。\n往事谁能说，凭栏一怅然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]