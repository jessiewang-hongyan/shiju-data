[{"title":"题开元天宝遗事四首 其四","author":"范成大","text":"剥啄延秋屋上乌，明朝箭道入东都。\n宫中亦有风流阵，不及渔阳突骑粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题开元天宝遗事四首 其三","author":"范成大","text":"朝天车马诏频催，斸得新汤未敢开。\n忽报猪龙掀宇宙，阿瞒虚读相书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题开元天宝遗事四首 其二","author":"范成大","text":"谢蛮舞袖贵妃弦，秦国如花虢国妍。\n不赏缠头三百万，阿姨何处费金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题开元天宝遗事四首 其一","author":"范成大","text":"御前羯鼓透春空，笑觉花奴手未工。\n一曲打开红杏蕊，须知天子是天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题日记","author":"范成大","text":"谁言万事转头空，未转头时亦梦中。\n若向梦中寻梦觉，觉来还入大槐宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题记事册","author":"范成大","text":"划破虚空一剑间，六根同转上头关。\n如今宴坐庵中事，政在凡夫道法间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题传记二首 其一","author":"范成大","text":"莫将綵笔寄朝云，红泪罗巾隔路尘。\n说与东风无限恨，倩风吹断去年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题传记二首 其二","author":"范成大","text":"綵舟归去海山青，寂莫瑶台月自明。\n啼雨落花春已尽，梦魂何必更多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题毕少董翻经图","author":"范成大","text":"绛帐胡沙暗，青编古意深。\n谁知洛下咏，中有越人吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题米元晖吴兴山水横卷","author":"范成大","text":"道场山麓接何山，影落苕溪浸碧澜。\n只欠荷花三十里，橛头船上把渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张晞颜两花图二首 其二 玉梨","author":"范成大","text":"雪薄冰轻不耐春，雨中愁绪月中真。\n莫教梦作云飞去，留伴昭阳第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张晞颜两花图二首 其一 繁杏","author":"范成大","text":"红粉团枝一万重，当年独自费东风。\n若为报答春无赖，付与笙歌鼎沸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李云叟画轴兼寄江安杨简卿明府二绝 其一","author":"范成大","text":"苍烟枯木共荒寒，篱落堤湾汹涨湍。\n归路宛然归未得，閒将李叟画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李云叟画轴兼寄江安杨简卿明府二绝 其二","author":"范成大","text":"新图来自雪边州，皴石枯槎笔最遒。\n明府能诗如此画，为渠题作小营丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨商卿扇","author":"范成大","text":"君归我去两销魂，愁满千山锁瘴云。\n后夜短檠风雨暗，谁能相伴细论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题宝林寺可赋轩","author":"范成大","text":"十里山行杂市声，道傍无处濯尘缨。\n宝林寺里逢修竹，方有诗情约略生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题易元吉獐猿两图二首 其二","author":"范成大","text":"乌逐山公噪，惊麇仰望疑。\n春林无一事，獝狘自生悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题易元吉獐猿两图二首 其一","author":"范成大","text":"择食麇相唤，无人意不惊。\n猿啼风动叶，机熟两忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题现老真","author":"范成大","text":"三十年来共葛藤，如今莲社冷如冰。\n茶瓜樱笋游山会，从此斋厨欠一僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画卷五首 其四","author":"范成大","text":"暑云泼墨送惊雷，坐见前山骤雨来。\n今夜一凉千万里，更无焦卷与尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画卷五首 其三","author":"范成大","text":"春阴十日溪头暗，夜半西风雨脚收。\n但觉奔霆吼空谷，遥知万壑正争流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画卷五首 其二","author":"范成大","text":"欹倾栈路绕山明，隔陇人家犬吠声。\n无限白云堆去路，不知谁识许宣平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画卷五首 其一","author":"范成大","text":"凿落秋江水石明，高枫老柳两滩横。\n君看叠巘云容变，又有中宵雨意生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南塘客舍","author":"范成大","text":"閒里方知得此生，痴人身外更经营。\n君看坐贾行商辈，谁复从容唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题城山挂月堂壁","author":"范成大","text":"百叠烟鬟得眼明，坐来心迹喜双清。\n秋阳满地西风起，犹有啼莺四五声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题城山晚对轩壁","author":"范成大","text":"一枕清风梦绿萝，人间随处是南柯。\n也知睡足当归去，不奈溪山留客何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题秋鹭图","author":"范成大","text":"昨夜新霜冷钓矶，绿荷消瘦碧芦肥。\n一江秋色无人问，尽属风标两雪衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题药方","author":"范成大","text":"孤童亦复梦槐柯，无德无功用福多。\n天理乘除当老病，巢源王诀奈君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题药簏","author":"范成大","text":"合成四大本非真，便有千般病染身。\n地火水风都散后，不知染病是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵希远案鹰图","author":"范成大","text":"学射春山万岁湖，牙门列骑卷平芜。\n如今黄土原边梦，犹识呼鹰嗾犬图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵昌木瓜花","author":"范成大","text":"秋风魏瓠实，春雨燕脂花。\n綵笔不可写，滴露匀朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徐熙风牡丹二首 其二 白花","author":"范成大","text":"寒入仙裙粟玉肌，舞馀全不耐风吹。\n从教旅拒春无力，细看腰支袅袅时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徐熙风牡丹二首 其一 紫花","author":"范成大","text":"蕊珠仙驭晓骖鸾，道服朝元露未乾。\n天半刚风如激箭，绿绡飘荡紫绡寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题羔羊斋外木芙蓉","author":"张镃","text":"慵妆酣酒夕阳浓，洗尽霜根看绮丛。\n绿地团花红锦障，不知庭院有西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄州临皋亭","author":"范成大","text":"夏口风帆赤壁矶，雪堂酾酒竹楼棋。\n系舟一日黄州下，只办登临不办诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蜀果图四首 其一 木瓜","author":"范成大","text":"沈沈黛色浓，糁糁金沙绚。\n却笑宣州房，竞作红妆面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题锦亭","author":"范成大","text":"手开花径锦成窠，浩荡春风载酒过。\n来岁游人应解笑，甘棠终少海棠多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题谭德称扇","author":"范成大","text":"蛮风吹雨瘴江肥，短草荒山鸟不飞。\n尽是泸南肠断句，如今分与故人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题醉道士图","author":"范成大","text":"蜩鴳鹏鹍任过前，壶中春色瓮中天。\n朝来兀兀三杯后，且作人间有漏仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颜桥道中","author":"范成大","text":"村村篱落总新修，处处田畴尽有秋。\n一段农家好风景，稻堆高出屋山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"橙纲","author":"范成大","text":"尧舜方堪橘柚包，穹庐亦复使民劳。\n华清荔子沾恩幸，一骑回时万骑骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂后卢橘一株冬前先开极香","author":"范成大","text":"卢橘花残细细飞，满枝晴日闹蜂儿。\n霜馀有此香无奈，合与称题赋小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕宫","author":"范成大","text":"金盆濯足段文昌，乞索家风饱便忘。\n他日楚人能一炬，又从焦土说阿房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕宾馆","author":"范成大","text":"九日朝天种落驩，也将佳节劝杯盘。\n苦寒不似东篱下，雪满西山把菊看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡阳道中二绝 其一","author":"范成大","text":"桑下芜菁晚，高花出短篱。\n茅檐少春事，惟记浴蚕时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡阳道中二绝 其二","author":"范成大","text":"黑羖钻篱破，花猪突户开。\n空山竹瓦屋，犹有燕飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠临江简寿玉二首简携王仲显使君书来谒并示孔毅甫梦蟾图今庙堂五府皆有题字 其一","author":"范成大","text":"萧滩远客扣田庐，贻我读书楼上书。\n千里故情元共月，错云多病故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠临江简寿玉二首简携王仲显使君书来谒并示孔毅甫梦蟾图今庙堂五府皆有题字 其二","author":"范成大","text":"卷中图画袖中珍，上有三阶五朵云。\n白日青天光范路，未饶蟾窟梦纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠举书记归云丘 其二","author":"范成大","text":"四股涧松雷斧碎，十围岩桂烧痕枯。\n不知阶下跳珠处，旧竹春来有笋无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠举书记归云丘 其三","author":"范成大","text":"青山面目想依依，水石风林入梦思。\n白发苍颜心故在，只如当日看山时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠举书记归云丘 其一","author":"范成大","text":"一枕清风四十霜，孤生无处话凄凉。\n相看只有庞眉客，还在云丘旧草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濯缨亭在吴兴南门外","author":"范成大","text":"凄风急雨脱然晴，当道横山似见迎。\n野水茫茫何用许，烂供游子濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蹋鸱巾","author":"范成大","text":"重译知书自贵珍，一生心愧蹋鸱巾。\n雨中折角君何爱，帝有衣裳易介鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蟠龙瀑布自山顶漫汗淋漓分数道而下望之宛从天降当为城中布水第一","author":"范成大","text":"银汉来从左界天，天风吹浪落苍巅。\n人间只见秧田润，唤作蟠龙洞里泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"覆盆铺","author":"范成大","text":"三登三降冈始断，一步一休日欲斜。\n浊酒半瓶不得煖，覆盆有铺无浆家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鳗井","author":"范成大","text":"决甃神通未易论，雨声留客夜翻盆。\n不辞客路春泥滑，且足秧田旧水痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其九","author":"范成大","text":"当筵女儿歌竹枝，一声三叠客忘归。\n万里桥边有船到，绣罗衣服生光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其八","author":"范成大","text":"滟滪如襆瞿唐深，鱼复阵图江水心。\n大昌盐船出巫峡，十日溯流无信音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其七","author":"范成大","text":"白帝庙前无旧城，荒山野草古今情。\n只馀峡口一堆石，恰似人心未肯平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其三","author":"范成大","text":"新城果园连瀼西，枇杷压枝杏子肥。\n半青半黄朝出卖，日午买盐沽酒归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一龛","author":"范成大","text":"一龛窄似鸟窠禅，世界悠悠任大千。\n与老有情冬后煖，去仙无几日高眠。\n斫开竹后初三径，忘却诗来又一年。\n破戒忽题无味句，劣能成字不成篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙未元日用前韵书怀今年五十矣","author":"范成大","text":"浮生四十九俱非，楼上行藏与愿违。\n纵有百年今过半，别无三策但当归。\n定中久已安心竟，饱外何须食肉飞。\n若使一丘并一壑，还乡曲调尽依稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未春日瓶中梅殊未开二首 其二","author":"范成大","text":"夜雪腊前冻，朝阳春后苏。\n人怜疏蕊瘦，花笑病翁臞。\n露白能多少，寻春似有无。\n诗催全不力，煮水换铜壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未春日瓶中梅殊未开二首 其一","author":"范成大","text":"暖閤无人到，寒枝为我横。\n情钟吹蕊破，静极觉香生。\n老去魂休断，春来眼且明。\n逃禅时索笑，百匝傍窗行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁酉正月二日东郊故事","author":"范成大","text":"椒盘宿酒未全醒，扰扰金鞍逐画軿。\n麦雨一犁随处绿，柳烟千缕几时青。\n客愁旧岁连新岁，归路长亭间短亭。\n万里松楸双泪堕，风前安得讳飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁酉重九药市呈坐客","author":"范成大","text":"莫向登临怨落晖，自缘羁宦阻归期。\n年来厌把三边酒，此去休哦万里诗。\n乌帽不辞欹短发，黄花终是欠东篱。\n若无合坐挥毫健，谁解西风楚客悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二日上沙夜泛","author":"范成大","text":"困倚船窗看斗斜，起来风露满天涯。\n亭亭宿鹭明菰叶，闪闪凉萤入稻花。\n月下片云应夜雨，山根炬火忽人家。\n江湖处处无穷景，半世红尘老岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月三十日夜出关候致远不至","author":"范成大","text":"风劲便轻棹，霜严怯弊裘。\n青山蟠巨浸，红树立沧洲。\n月黑雁犹去，灯寒人更愁。\n烟松漫小岘，何处问鸣驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二十七日病后始能扶头","author":"范成大","text":"复幕重帘苦见遮，暮占栖雀晓占鸦。\n残灯煮药看成老，细雨鸣鸠过尽花。\n心为蚤衰元自化，发从无病已先华。\n更蒙厉鬼相提唱，此去山林属当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月三日登楼有怀金陵宣城诸友","author":"范成大","text":"百尺西楼十二栏，日迟花影对人閒。\n春风已入片时梦，寒食从今数日间。\n折柳故情多望断，落梅新曲与愁关。\n诗成欲访江南便，千里烟波万叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入秭归界","author":"范成大","text":"山根系马得浆家，深入穷乡事可嗟。\n蚯蚓祟人能作瘴，茱萸随俗强煎茶。\n幽禽不见但闻语，野草无名都著花。\n窈窕崎岖殊未艾，去程方始问三巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八十四盘","author":"范成大","text":"冥鸿无伴鹤孤飞，回首尘笼一笑嬉。\n八十四盘新拄杖，万三千乘旧牙旗。\n石梯碧滑云生后，木叶红斑雪霁时。\n说与同行莫惆怅，人间捷径转嵚巇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月十二日枕上晓作","author":"范成大","text":"竹响风成阵，窗明雪已花。\n柴扉吟冻犬，纸瓦啄饥鸦。\n宿酒欺寒力，新诗管岁华。\n日高犹拥被，蓐食愧邻家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月十日海云赏山茶","author":"范成大","text":"门巷欢呼十里村，腊前风物已知春。\n两年池上经行处，万里天边未去人。\n客鬓花身俱岁晚，妆光酒色且时新。\n海云桥下溪如镜，休把冠巾照路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二十四日西楼观雪","author":"范成大","text":"一夜珠帘不下钩，彻明随雪上西楼。\n瑶池万顷昆崙近，玉垒千峰滴博收。\n已报春回南亩润，从教寒勒北枝愁。\n四筵都为丰年醉，录事何须校酒筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]