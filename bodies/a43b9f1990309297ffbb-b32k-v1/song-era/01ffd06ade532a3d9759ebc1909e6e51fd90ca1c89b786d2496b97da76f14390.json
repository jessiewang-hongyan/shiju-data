[{"title":"吊南宜守尉","author":"刘敞","text":"百越谁生祸，南宜遂不师。\n干戈伤耋老，守尉死城陴。\n荒泂招魂远，官军请救迟。\n弱妻携稚子，嗟尔欲何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吊亡卒","author":"刘敞","text":"厉俗侵王略，祅冤积楚氛。\n民荒谁念乱，功败失图勋。\n天子忧南土，戈船促大军。\n何时收尔骨，委祭越江濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨备国博吊屈原","author":"刘敞","text":"知音不恨远，异代忽同声。\n灵魂自识路，幽遇亦含情。\n?记属扬子，临渊悲贾生。\n鬲文激颓俗，会使众人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻夏太尉自长安徙备西边","author":"刘敞","text":"防秋未得还，战士出长安。\n地利山河险，天时关塞寒。\n羌夷避飞将，天子倚良翰。\n见说成功近，秦中意似宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月四日上方寺送随州十一屯田","author":"刘敞","text":"载酒怜春尽，寻芳到翠微。\n绵绵芳草远，飏飏杂花飞。\n俯仰悲陈迹，淹留恨落晖。\n青枫千里目，那复送将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啸台","author":"刘敞","text":"尚有高台在，遗名幸未空。\n不时嗟眼白，失所念途穷。\n已矣先生意，萧然烈士风。\n清芬定谁嗣，漫啸白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日晚夜步过孙监丞","author":"刘敞","text":"幽居巷南北，鸡犬略相闻。\n乘兴偶有适，杖藜聊复勤。\n高城秋草落，密树夕光曛。\n微尔开三径，悠悠麋鹿群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮舟西阳池中","author":"刘敞","text":"爱水都成癖，浮舟不厌频。\n寒泉清见底，刳木略容人。\n故故乘流往，飘飘得意真。\n槎头尺许地，鸥鸟欲相驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西戎乞降","author":"刘敞","text":"南国传消息，西戎送好音。\n怀柔知帝力，启佑亦天心。\n御酒葡萄远，离宫苜蓿深。\n仍闻编旧里，五岳望君临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿山","author":"刘敞","text":"白隰见层峰，巉岩倚碧空。\n上多千岁木，下有百年翁。\n栎社不材永，东陵非义终。\n吾闻仁且寿，故在太平中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山寺","author":"刘敞","text":"野竹檀栾翠，孤峰杳霭青。\n山楼随诘曲，石路上青冥。\n云色移时合，钟声隔水听。\n似闻堪避世，游子未尝经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南泛舟三首 其一","author":"刘敞","text":"乘兴随所适，出郊聊泛然。\n青波能照发，白鹭巧迎船。\n老树悲秋雨，高风急暮蝉。\n孤城隐不见，落日暝浮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南泛舟三首 其二","author":"刘敞","text":"不踏城南陌，从春及素秋。\n萧条非复昔，顾眄莽堪愁。\n白露蒹葭老，清风兰杜幽。\n佯狂惊楚俗，应识棹夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南泛舟三首 其三","author":"刘敞","text":"高岸看为谷，通波几覆城。\n橧巢非太古，野俗竞偷生。\n雨逐行云过，山依返照明。\n楚歌摇落际，更动北归情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斁除苏州掾","author":"刘敞","text":"三年不相见，万里比何如。\n闻道词曹掾，新承选部书。\n弓裘传习在，簪笏抗尘初。\n努力人间世，毋为薄诏除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄州临皋亭","author":"刘敞","text":"春秋黄子国，楚越穆陵关。\n比屋皆编竹，孤城半践山。\n岸泥观虎迹，云水暗荆蛮。\n三入承明客，那能鬓不斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"骤雨","author":"刘敞","text":"炎日大冶沸，清风愁意苏。\n黑云过山岳，白雨覆江湖。\n彷佛鬼神战，腾凌车骑趋。\n森然异气象，真复慰泥涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏夜暴雨","author":"刘敞","text":"大暑积炎夏，沈阴昏楚天。\n疾雷五河裂，飞电万星悬。\n涨泽通南国，孤城斗百川。\n似传黄鸟语，欲反濯龙渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨","author":"刘敞","text":"祇忆风回雪，俄惊地出雷。\n沈阴连甲子，春事总归来。\n湖水寒侵夜，江云去复回。\n开年厌卑湿，不待熟黄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨二首 其一","author":"刘敞","text":"江雨黄梅实，湖云起蛰龙。\n寒生夜床簟，声绝暮山钟。\n药裹添新粉，书编坼旧缝。\n虽知恨卑湿，凉夜尚吾容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨二首 其二","author":"刘敞","text":"颇忆家居日，朝眠一事无。\n迩来趋幕府，曙雨踏泥涂。\n城郭飞鸣鹤，阶除戏浴凫。\n秋风殊不远，行欲问江鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶山送道粹","author":"刘敞","text":"海上相逢少，山中别恨多。\n浮云自向阙，秋水更增波。\n携手意不尽，班荆情若何。\n徘徊强一醉，且勿奏骊歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招晋卿时晋卿到丹阳","author":"刘敞","text":"识心非识面，常恨不相从。\n那作经年别，曾无一日逢。\n兴来清剡雪，吟出暮山峰。\n净埽门前路，期君马系松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"女郎台","author":"刘敞","text":"城郭临湖尽，楼台此地偏。\n动摇浮积水，高绝近诸天。\n应接都无暇，虚空足悟禅。\n尘中故易厌，兴尽惜回船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闵雨","author":"刘敞","text":"风伯会何憾，高云不少留。\n声如鬼神过，势卷日星浮。\n河汉漠无象，鱼龙方自忧。\n古书难尽信，雩舞竟悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"砧妇","author":"刘敞","text":"清霜石上乾，孤响耳中酸。\n岁逼秋芳尽，风量板屋寒。\n君行自悠远，妾意亦艰难。\n此夜关山月，应知带日宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李太傅挽词三首 其一","author":"刘敞","text":"数闻伏阁议，屡上荐贤书。\n任重道空远，名荣身反疏。\n异乡悲鵩鸟，清诏隔公车。\n招隐真虚语，江湖万里馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李太傅挽词三首 其二","author":"刘敞","text":"报国念推毂，逢忧甘噬脐。\n孤鸣一垂翅，举俗竞吹赍。\n山鬼离居远，灵魂失路迷。\n天高不可问，愁意日凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李太傅挽词三首 其三","author":"刘敞","text":"识理未曾误，疾邪惟过深。\n岂忘事反覆，不忍俗浮沈。\n去国尚回顾，埋名方自今。\n异时山水意，恻恻吊鸣琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲁拾遗挽词二首 其一","author":"刘敞","text":"市朝非故日，年代属传闻。\n始兆滕公室，来观季子坟。\n埋名书故事，编简属遗文。\n苦恨相如赋，俱随谏草焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲁拾遗挽词二首 其二","author":"刘敞","text":"西晋登贤日，东堂第一人。\n竞推天下士，争辟幕中宾。\n故国无乔木，流风及搢绅。\n新阡广陵上，荒草欲含春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庶几堂","author":"刘敞","text":"闭门吾自足，况亦近墙东。\n滴滴阶鸣雨，梢梢竹过风。\n绿苔侵杖屦，秋色近梧桐。\n高卧殊多兴，诗成寂寞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延州沈待制挽词","author":"刘敞","text":"诗书谋国体，谈笑却边尘。\n已矣今成昔，归来悲故人。\n馀忠焚谏草，遗恨画麒麟。\n禁角闻鼙鼓，能无忆虎臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祠部王郎中送山水枕屏作","author":"刘敞","text":"枕上万峰合，苍苍惊梦魂。\n如浮武林水，卧向桃花源。\n杖屦几时士，茅茨何处村。\n悠然独往意，欲问复忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城楼望水","author":"刘敞","text":"远水全无地，高城略近天。\n龙吟忽半见，虹饮竞相鲜。\n鱼鳖争乘渚，儿童狭济川。\n秋风只昨日，物意已萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送南昌郭主簿","author":"刘敞","text":"楚剑炟照地，梅真从吏乡。\n簿书非急务，鸿雁试高翔。\n狸品牛尾贵，茶牙鹰瓜长。\n因君访风土，游子不能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏和同年时在荐福寺","author":"刘敞","text":"逃暑涓涓酒，开襟细细风。\n过云催急雨，落日澹秋空。\n树影经行熟，泉声笑语通。\n少年兴不浅，宁与老人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鍊丹井","author":"刘敞","text":"丹成人已去，泉在月空沉。\n轻举非吾事，泓澄似客心。\n饮虽资一腹，贪不近千金。\n更爱双桐好，曾非恶木阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水斋","author":"刘敞","text":"野塘春水平，间客自扬舲。\n鸥鹭时相近，波涛亦俯听。\n榜歌渔父曲，醉读屈平经。\n便欲从兹去，秋河泛客星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长芦口","author":"刘敞","text":"泱漭东流白，微茫远屿青。\n风飙万里浪，性命一浮萍。\n飞鸟戢倦翼，潜蛟浮暗腥。\n由来限南北，天意亦冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登东城楼二首 其一","author":"刘敞","text":"摇落客愁乱，登临秋色空。\n溪流寒更碧，霜树晚增红。\n旷野驻残日，虚轩来朔风。\n怀归复感别，不语向征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登东城楼二首 其二","author":"刘敞","text":"高楼望不极，野兴远相宜。\n宇宙一长啸，山川多所思。\n薄寒才胜酒，短景不禁棋。\n俯仰哀群动，辽辽见尔为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之岭南","author":"刘敞","text":"君去炎方远，行行万里馀。\n渐惊南瘴酷，益见北人疏。\n山谷藏雄虺，溪潭养鳄鱼。\n秋风雁不到，何处俟归书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城楼避暑","author":"刘敞","text":"积水动微吹，高楼浮薄阴。\n登临倦非土，潇洒劝披襟。\n涤涤原野旷，熹熹城郭深。\n浮云空蔽日，无意欲为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄内","author":"刘敞","text":"风雨惊春老，山川入梦遥。\n此时看破镜，何处正吹箫。\n旧种萱丛碧，新归燕语娇。\n佳期漫自笑，不似浙江潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送祖学士使北","author":"刘敞","text":"汉廷用五饵，无复请长缨。\n犹是輶轩使，时通绝域情。\n山川资览眺，战伐想纵横。\n不负四方志，那辞万里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻张六复弃官归","author":"刘敞","text":"应怀折腰辱，复作弃官行。\n颇似陶彭泽，兼疑尚子平。\n兵戈未消散，盗贼苦纵横。\n余亦存丘壑，相期作耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萤","author":"刘敞","text":"翩翩岂自知，历历眩群飞。\n故作穿疏牖，时来鉴薄帷。\n助明清夜永，除害一身微。\n秋草隋宫路，茫茫旧赏非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送签判雍秘丞还朝","author":"刘敞","text":"我有幕中士，名高天下闻。\n方从玉堂召，欲就子虚文。\n相得已非早，送归宁易分。\n期君望此府，急自致青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定水二首 其一","author":"刘敞","text":"定水涵空碧，群山凝远岚。\n渊鱼颇易得，菱实最馀甘。\n旷野应人语，凉风快酒酣。\n谁云陵谷换，自此识南潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定水二首 其二","author":"刘敞","text":"此地去人近，向来幽赏违。\n使君留隼旆，烟水净鱼矶。\n秋入冷蛩急，波明白鹭飞。\n异时江汉兴，抚事更怀归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"索米","author":"刘敞","text":"索米东方朔，端居陆士衡。\n书仍闻北阙，赋亦让南伧。\n感激秋风起，提携夜剑横。\n南军败王略，谁事请长缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王屯田归望山别墅","author":"刘敞","text":"岱阴宿雨霁，汶北秋风过。\n独往予所慕，躬耕人谓何。\n林间鸡黍具，日慕渔樵歌。\n却望青山郭，应知惆怅多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高处士归丰邑别墅","author":"刘敞","text":"不及西京盛，空知鄠杜间。\n衣冠为我累，丘壑羡君还。\n陇麦逢春秀，林花着雨斑。\n鸡豚社下醉，多与谢南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"射雕","author":"刘敞","text":"将军乐射雕，壮士挟乌号。\n影捩重云静，声翻一箭高。\n猎酣生鼻火，空阔散风毛。\n快意中原捷，何辞汗马劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨褒雨中见寄二首 其一","author":"刘敞","text":"佳雨云龙会，高堂河汉声。\n驱除三伏过，埽荡九衢清。\n造物不无意，为霖真有情。\n怜君独高卧，亹亹向群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨褒雨中见寄二首 其二","author":"刘敞","text":"明暗变窗色，萧骚翻树声。\n闭门无所诣，高枕有馀清。\n枥马正局迹，韝鹰多远情。\n分明动秋兴，似欲恼潘生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贳酒","author":"刘敞","text":"小径入村坞，风帘拂暮霞。\n桃源还可宿，樽酒亦容赊。\n举眼青山秀，随松白露斜。\n寻常出郊少，未醉莫还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张学士送酒","author":"刘敞","text":"秋风埽飞叶，客子鬓垂斑。\n好事烦携酒，怀情惬闭关。\n坐看凉月堕，醉送暮鸿还。\n后日相思意，萧萧丛菊间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱桥","author":"刘敞","text":"朱桥柳映潭，忽见似江南。\n风物依然是，登临昔所谙。\n犬声寒隔水，山气晚成岚。\n留恨无人境，幽奇不尽探。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闰月朔日寄府公给事二首 其一","author":"刘敞","text":"良闰百年逢，佳辰献岁同。\n春应随北斗，天与缓东风。\n柳带参差翠，花英点染红。\n韶华供醉眼，未负黑头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闰月朔日寄府公给事二首 其二","author":"刘敞","text":"嘉月重非常，芳期及载阳。\n却因春意晚，得见岁华长。\n馀雪留寒色，新梅著早香。\n祗应勤一醉，持以答风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦日自荐福院泛舟上女郎台","author":"刘敞","text":"晦日疑春晚，佳辰强客游。\n放船无用楫，置酒不惊鸥。\n牵率忘多病，登临乱百忧。\n繁阴欺白日，容易暮云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新雁二首 其一","author":"刘敞","text":"逢时志万里，非为稻粱谋。\n眇眇江汉阻，萧萧霜露秋。\n知机自有素，侧翅莫多愁。\n风起浮云暮，空看片影流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新雁二首 其二","author":"刘敞","text":"万里南飞雁，今年复此逢。\n自难随燕雀，非不病秋冬。\n风急声高下，云深影叠重。\n江湖虽异土，泛泛尔能容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中雁","author":"刘敞","text":"万里羽毛弱，经时霰雪纷。\n江湖更何取，天地正同云。\n影困低如落，声悲远似闻。\n识时端北向，送目感离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯花","author":"刘敞","text":"寒灯不及邻，花艳竞争新。\n重叠芝三秀，分明桂半轮。\n东风谁变律，芳意自惊春。\n流玩堪通夕，长眉莫效颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王秀才自蜀之京留月馀归南都","author":"刘敞","text":"相逢暂相会，又向睢阳行。\n险梦尚存蜀，缁衣空厌京。\n故园见树喜，旧友出郊迎。\n幸去君家近，飞鸿时寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"始秋二首 其一","author":"刘敞","text":"暑兼流火逝，秋共北风回。\n岁晏蒹葭色，宵征蟋蟀哀。\n平分感摇落，留滞怅徘徊。\n知负沧洲约，枯槎八月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"始秋二首 其二","author":"刘敞","text":"秋色忽已改，旅程殊未央。\n水云含变态，山雨送凄凉。\n杳杳青枫暮，菲菲白芷香。\n多才悲宋屈，摇落近沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张器判官","author":"刘敞","text":"王国推多士，闻名二十年。\n白头倾敝盖，珠履尚宾筵。\n礼乐期先进，功名望昔贤。\n激昂知己晚，意气歘飘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]