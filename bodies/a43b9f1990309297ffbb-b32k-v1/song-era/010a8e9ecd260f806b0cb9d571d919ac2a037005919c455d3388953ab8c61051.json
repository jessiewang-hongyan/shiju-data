[{"title":"怀古","author":"释师范","text":"空山寥寥，黄叶萧萧。\n斯人不来兮，暮待之以朝。\n斯人或来兮，两无语而意消。\n归去也，衣飘飘，路迢迢。\n谁同其孤标，月在青霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵照女赞","author":"释师范","text":"有髻垂肩，无鞋磹脚。\n一掬精神，十分销铄。\n最苦拈来泼罩篱，风前索价无人著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花光十梅 平地回春","author":"释师范","text":"万木千花冻未醒，东君无处觅归程。\n抬眸忽见春风面，的皪枝头数点青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花光十梅 正偏自在","author":"释师范","text":"花合花开有正偏，不完全处却完全。\n要知根蒂从何得，多见生埋洞水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花光十梅 高下随宜","author":"释师范","text":"树有高低枝短长，花开随处恰相当。\n都缘妙得毫端趣，竖抹横拖总不妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花光十梅 淡中有味","author":"释师范","text":"半开半合荣枯外，似有似无闲淡中。\n自是一般风味别，笑他红紫斗芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"言法华赞","author":"释师范","text":"褰裳而趋，或然而住。\n咄咄书空，喃喃独语。\n尽语渠侬转法华，知得身心在何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邹编修请赞","author":"释师范","text":"骨棱层，发䰐鬖。\n且不安分，更说指南。\n置须弥卢于一针锋，贮四大海于无底篮。\n不知世有谁知己，朴庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孟保相赞","author":"释师范","text":"澄之不清，混之不杂。\n融融澹澹，辛辛辣辣。\n径山横赞竖赞，终是赞之不著。\n但以手加额，道个南无大慈大悲救苦救难观世音菩萨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定慧圻长老请赞","author":"释师范","text":"诈哑徉聋，指西作东。\n肆无所畏，说大脱空。\n弯弓曾发蓬蒿箭，射中南山白额虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忠道者赞","author":"释师范","text":"听教一味瞌睡，参禅不入炉冶。\n盗橘过于挥剑，骑虎稳如乘马。\n伎俩元来个样生，几乎唤作忠道者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林泉野人","author":"释师范","text":"乐哉林泉人，自得林泉趣。\n渴则掬泉饮，健则穿林去。\n几见幽鸟啼黄叶，聚薰入奏雪飞絮。\n四时适吾意，万象为吾侣。\n有人更问意如何，笑指岩前大松树。\n阿呵呵，快活快活，有甚讨处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金华圣者赞","author":"释师范","text":"饱啖猪头肉，长斋不吃素。\n莫言滋味别，要且少盐醋。\n吽吽，大有著你处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济赞 其一","author":"释师范","text":"善战不动旗鎗，善缚不加绳约。\n其毒犹恒山之蛇，被伤者决定无药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉大道赞","author":"释师范","text":"这瞎秃，无捡束。\n浴龙湫，系蛇腹。\n瓢里酒，钵里肉。\n到头底事若为论，郴州城中六月六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪长老请赞","author":"释师范","text":"西有岷峨，南有雪峰。\n灵龟未爆，爻象重重。\n拈却玄沙白袋，自然千里同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觉际融长老请赞","author":"释师范","text":"无个模样，画个模样。\n既有模样，是甚模样。\n节节危梁十二层，垂垂白发三千丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送无相和尚归乡","author":"释师范","text":"同名同号同桑梓，同住江湖亡彼此。\n有时同上孤峰巅，有时同下沧溟底。\n苦同忧，乐同喜，金博金兮水洗水。\n有时捩转铁面皮，心口全然不相似。\n你若住兮我即行，你若行兮我即止。\n白日青天轰怒雷，平地无风波浪起。\n非不非，是不是，西川大随，桐城投子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送讷堂和尚住秀之天宁","author":"释师范","text":"苏州有，常州有。\n真个有，未尝有。\n贱时倾国不可换，贵则陪钱挜一㪷。\n伸一手，缩一手，日月奔忙，山河倒走。\n济北瞎驴退三步，跛脚云门大张口。\n阿呵呵，只今此话大行，何待三十年后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送侄昭上人归乡","author":"释师范","text":"昭昭灵灵是何物，非物非心亦非佛。\n五湖云衲竞头参，空把光阴恣埋没。\n我游江湖三十有四年，饱饭之馀，一味闲打眠。\n子今迢迢苦寻讨，不知寻讨何慕焉。\n问吾道，今年大熟收成早。\n问吾禅，秋林噪晚声喧喧。\n抖擞屎肠都说了，莫将一字归去容易空流传。\n斯言写就相违别，目断家山云叠叠。\n我亦欲归归不得，千里万里一条铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵龙图归四明","author":"释师范","text":"昔年曾约归四明，掇钵共饭莆菜羹。\n东园蔬荠几衰长，望之何以辜斯盟。\n铿铿小节何足拘，大名当振声谹谹。\n旌旗不动剿胡种，屈伸一臂逾长城。\n淮甸既肃四海肃，丰功盛德应难名。\n了知八珍与藜苋，清闲富贵但等平。\n我罹劫火固无闷，公视昼锦不以荣。\n七佛承承竟何据，六祖忉忉空碗鸣。\n君不见刹竿头上铁龙头，鸿毛至重山岳轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送率庵和尚住云居","author":"释师范","text":"东湖水深蟠老龙，晨昏出没无定踪。\n开口合口喷香雾，举足下足生阴风。\n而今改宅云居去，威风万窍声号怒。\n谓言不是抉珠人，未应轻踏瓯峰路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送凝藏主归蜀","author":"释师范","text":"凝藏主，五载恶相聚。\n我既横点头，公亦未相许。\n就中犹叵耐，拗折露明柱。\n似此拙去就，端的不可恕。\n萧萧九月风露寒，忽来告别还乡去。\n临歧可煞没巴鼻，却要就我觅转语。\n一转语，如何举，湿纸裹大虫，大棒打老鼠。\n阿呵呵，无你会处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"须菩提赞","author":"释师范","text":"头白齿豁，空腹高心。\n被憍尸迦当面上当，对维摩诘甘自屈沉。\n说甚解空称第一，只堪倚杖独沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"破庵赞 其一","author":"释师范","text":"噫嚱吁，何人欤。\n无德可敬，无言可书。\n非横灭族，是真瞎驴。\n有口不能骂得，捲而分付云居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚬子赞 其一","author":"释师范","text":"出手露脚，捞虾摝蚬。\n这穷鬼子，可贵可贱。\n纸钱堆里谩藏身，莫言冷地无人见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济赞 其三","author":"释师范","text":"晴空轰霹雳，官路栽荆棘。\n没兴遭逢著，前凶后不吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十三","author":"释师范","text":"黯澹滩，黯澹滩，十只船来九只翻。\n惟有三山陈上舍，我向陆地里行，看你奈我何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十二","author":"释师范","text":"大匠不巧，大儒不学。\n动辄中方圆，举皆成礼乐。\n堪笑乡村卖卜人，徒劳钻破乌龟壳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十一","author":"释师范","text":"深深亲下拜，三代礼全该。\n此意如不然，玉帛云乎哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十","author":"释师范","text":"腊月三十日，开口便为敕。\n更拟问如何，明朝正月一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十八","author":"释师范","text":"一年三百六十日，日日日从东畔出。\n昨夜黄昏又落西，茫茫无处寻踪迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十四","author":"释师范","text":"种田博饭吃，饱卧长伸脚。\n把将三界来，安向左边著。\n引得龙牙老古锥，手里把柄破木杓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十九","author":"释师范","text":"骨裹皮兮皮裹骨，大随放出辽天鹘。\n东西南北谩抬眸，不知已过新罗国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十七","author":"释师范","text":"铜公塘，铁奉化。\n得人憎，得人怕。\n不是明州人，定说苏州语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十五","author":"释师范","text":"共乐升平道泰时，相逢终不展鎗旗。\n随宜淡饭清茶外，困卧闲行几个知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十八","author":"释师范","text":"千载岩前树，曾无刀斧痕。\n羚羊才触著，满地叶纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十五","author":"释师范","text":"兀兀地思量，无可得思量。\n无可思量处，真个好思量。\n大庾岭头逢六祖，鳌山店上见曾郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其八","author":"释师范","text":"一柄无情雪刃刀，当锋谁敢犯秋毫。\n马师父子亲提掇，血喷千山风怒号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十六","author":"释师范","text":"持来送去样团团，覆阴儿孙义不寒。\n何似当时休擘破，浑崙留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高原","author":"释师范","text":"佛祖仰望不及处，暗通一线几何深。\n冰严雪冷无人会，空泻断崖千万寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二九","author":"释师范","text":"前月只此月，后月亦此月。\n何得尘世人，竞赏中秋节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六","author":"释师范","text":"十四十五，贱如泥土。\n十六十七，贵如金璧。\n此意分明说向谁，天上人间惟我知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二五","author":"释师范","text":"一夏逡巡已过半，往往精勤成懒慢。\n幸然底事十分现成，因甚到夜打叠不办。\n君不见赵州末上见南泉，何似雪峰参老观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十九","author":"释师范","text":"和麸粜面，夹糠炊米。\n半夜三更，瞒神謼鬼。\n冷地有人觑见，直得左手掩鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十五","author":"释师范","text":"有一物，黑似漆，亘古今，无人识。\n却被秋虫知，唧唧空叹息。\n而今拈出普请看，分文不直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一六","author":"释师范","text":"万籁风悽悽，千林露滴滴。\n塞雁起平沙，夜虫吟破壁。\n举一不得，举二放过一著，更听拄杖子露个消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十二","author":"释师范","text":"二由一有，一亦莫守。\n新罗日午打三更，回首面南看北斗。\n堪悲堪笑，黄面禅和到处行脚，只管将鼻孔东边嗅西边嗅。\n自己鼻尖上有一点粪，十个五双因甚不觉臭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三八","author":"释师范","text":"五五二十五，六六三十六。\n纵以大衍数，终是数不足。\n数得足，无不足，碧眼黄头，口哑舌秃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二八","author":"释师范","text":"仰面看天，低头觑地。\n明眼衲僧，讨甚巴鼻。\n岂不见山前明觉寺里有个陈阇黎，解道苏噜苏噜悉哩悉哩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十七","author":"释师范","text":"三日前，五日后，药若不瞑眩，厥疾弗瘳，折脚云门见睦州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七","author":"释师范","text":"来住清凉寺，匆匆一个月。\n闲时闲有馀，忙时忙不彻。\n谁知忙与闲，秤锤浑是铁。\n舜若多神笑点头，骄梵钵提长吐舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二六","author":"释师范","text":"阿剌剌，横该抹。\n天何高，地何阔。\n碧眼与黄头，徒自闹聒聒。\n育王恁么道，也是将盐止渴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十","author":"释师范","text":"夜暗昼明，天平地平。\n三日一雨，五日一晴。\n达磨大师不安本分，被人打落当门板齿，庐山归宗和尚无端拭坏一双眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十三","author":"释师范","text":"作者相逢，你西我东。\n水归沧海，月上孤峰。\n放出城中老鼠，咬杀村里大虫。\n因甚如此，闽蜀同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一八","author":"释师范","text":"横说竖说何曾动著舌头，逆行顺行总是家常茶饭。\n有准绳，无畔岸，吾道一以贯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十六","author":"释师范","text":"上下三指，彼此七马。\n似有似无，半真半假。\n乳峰被人问著，五年分疏不下。\n阿呵呵，笑倒东村王大姊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十六","author":"释师范","text":"太白峰前收阵脚，鉴湖归唱村田乐。\n无端调转入新丰，谁知错处非常错。\n直得洞水逆流，乳峰倒卓。\n石女攒眉，木人泪落。\n此曲如今谁共闻，越山无际天无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一○三","author":"释师范","text":"当明有暗，当暗有明。\n口说如哑，眼见如盲。\n门外一条通驿路，朝朝暮暮有人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十一","author":"释师范","text":"智度菩萨母，容受一切法。\n然于一切法，而离分别相。\n分别既离，诸法如如。\n蜀江万派朝沧海，闽岭千寻插太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一二","author":"释师范","text":"三月春将老，万木献青杪。\n微雨湿残红，泉声杂幽鸟。\n堪悲堪笑，寒山子，归不得，忘却来时道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二四","author":"释师范","text":"木中有火，钻之始明。\n矿中有金，炼之始精。\n诸人分上各各有无价之宝，如何甘自溺于阴入之坑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十五","author":"释师范","text":"过去已过去，未来亦未来，即今名现在，现在安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十","author":"释师范","text":"云门一曲，从来无谱。\n韵出五音，调高千古。\n就中妙旨许谁知，几拟黄金铸子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十七","author":"释师范","text":"大惠老汉无端，随后说难说易。\n拈得口兮失却鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十六","author":"释师范","text":"火焰为三世诸佛说法，三世诸佛立地听。\n听在说处，说在听处。\n听说两忘，如何剖露。\n经入藏，禅归海。\n唯是马簸箕，拈弄有馀态。\n每遇中秋玩月时，寻思直是令人爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十三","author":"释师范","text":"曲中直，直中曲。\n有增减，无数目。\n等闲放在暗窗前，冷地令人看不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十六","author":"释师范","text":"年年是好年，日日是好日。\n好事大家知，今朝正月一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十九","author":"释师范","text":"衲僧门下，无可不可。\n热则到处乘凉，寒则围炉向火。\n饥则餐，困则卧。\n执法修行，如牛拽磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十四","author":"释师范","text":"从这里流出，滔滔无尽日。\n巨浪涌千寻，谁知无一滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一四○","author":"释师范","text":"朝碌碌，暮悠悠。\n非懈怠，非精修。\n华亭船子，北地赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]