[{"title":"别张教授归独登拟岘","author":"陆游","text":"小阁敞朱扉，停车暂息机。\n行人呼晚渡，幼妇浣秋衣。\n霜树攲危堞，风鸦满落晖。\n登临客愁里，况是送将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别杨秀才","author":"陆游","text":"岁暮江头又语离，淡烟衰草不胜悲。\n俗人愦愦宁知子，心事悠悠欲语谁。\n灯暗想倾浇闷酒，路长应和赠行诗。\n人生但要身彊健，一笑相从自有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别荣州","author":"陆游","text":"浮生岁岁俱如梦，一枕轻安亦可人。\n偶落山城无事处，暂还老子自由身。\n啸台载酒云生履，仙穴寻梅雨垫巾。\n便恐清游从此少，锦城车马涨红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别梅","author":"陆游","text":"竹篱数掩傍鱼矶，万点梅花掠地飞。\n正喜巡檐来索笑，已悲临水送将归。\n影横月处愁空绝，子满枝时事更非。\n自古情钟在吾辈，尊前莫怪泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"皋夔无近用，芝朮少奇功。\n上寿当徐致，沉疴忌力攻。\n医传三世久，事历百年中。\n畏与庸人说，终身托病聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事四首 其四","author":"陆游","text":"放翁老去未忘情，镜里森然白发生。\n一片常愁见花落，三声最怕听猿鸣。\n年年双只路傍堠，夜夜短长城上更。\n晚悟一条差似可，孤舟渔火看潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其六","author":"陆游","text":"还乡吴语熟，伏枕越吟悲。\n接客寒温简，过邻几杖随。\n独嗟亲旧少，不觉岁时移。\n陌上人争看，风攲白接䍦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"蒋之奇","text":"渭水岐山不出兵，却携琴剑锦官城。\n醉来身外穷通小，老去人间毁誉轻。\n扪虱雄豪空自许，屠龙工巧竟何成。\n雅闻岷下多区芋，聊试寒炉玉糁羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事四首 其三","author":"陆游","text":"我爱湖山清绝地，抱琴携鹤住茆堂。\n药苗自采盘蔬美，菰米新舂钵饭香。\n南浦风烟无限好，北轩雷雨不胜凉。\n旧交散落无消息，借问黄尘有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其二","author":"陆游","text":"穄饭流匙滑，葵羹出釜香。\n有时留野客，亦复饷邻墙。\n老圃传占法，行僧遗药方。\n未为全绝物，终胜利名场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其二","author":"陆游","text":"遁居无外事，白日不胜长。\n诗为穷差进，琴虽老未忘。\n映窗精试墨，闭閤苦留香。\n年少无相诮，功名事更狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其一","author":"陆游","text":"心与岩泉静，形如野鹤臞。\n朝餐美藜藿，夜学讲唐虞。\n婢老无钗泽，僮寒阙裤襦。\n所欣惟一事，无吏督残租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"云本无心木不材，平生得丧信悠哉。\n钓鱼每过桐江宿，卖药新从剡县回。\n山圃莴蔓晨灌溉，地炉芋栗夜燔煨。\n人情万变吾何预，笑口何妨处处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事四首 其一","author":"陆游","text":"身向人间阅事多，杜门聊得养天和。\n盛衰莫问萧京兆，壮老空悲马伏波。\n日暮城楼传戍角，风生岭路下樵歌。\n君知此段神通否，竖拂能降百万魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"萧骚白发满纶巾，犹是人间诗酒身。\n湖上悲秋新有作，眼边败意绝无人。\n稻粱栖亩雁初下，烟水粘天鸥自驯。\n堪笑推移成老大，时时几杖接乡邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"陶令常耽酒，庞翁不出家。\n安贫炊麦饭，省事嚼茶芽。\n池满浮雏鸭，庭荒噪渴蛙。\n诗成赏音绝，自向小儿誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"归卧已如狐首丘，不妨解剑换吴牛。\n扫空身外闲荣辱，阅尽樽前旧辈流。\n学道漫希僧坐夏，忧时常愧士防秋。\n一年历日开强半，叹息人间岁月遒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其四","author":"陆游","text":"纸洁晴窗暖，粳新午饭香。\n嗜眠为至乐，省事是奇方。\n孤蝶弄秋色，乱鸦啼夕阳。\n诗情随处有，信笔自成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"我本区中士，偶来湖上居。\n时寻一枕梦，闲展数行书。\n得醉常欢甚，无炊亦晏如。\n今朝好天气，一笑命柴车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其五","author":"陆游","text":"井税无馀负，川原已饱犁。\n樵歌归市步，帆影过河堤。\n野实丹兼漆，村醪蜜与齑。\n虽云有丰约，不废醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"万里山河拱至尊，羽林铁骑若云屯。\n群公先正不复作，故国世臣谁尚存。\n河洛可令终左衽，刍荛何自达修门。\n王师一日临榆塞，小丑黄头岂足吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"成败归青史，悲欢付浩歌。\n病从今岁减，诗比去春多。\n高枕观浮世，持杯养太和。\n功名亦易尔，难负此渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"塈壁编茅养病翁，五更拥褐听霜风。\n老鸡栖冷啼偏早，宿火灰深拨更红。\n知我向来惟断简，会心终竟在孤篷。\n东归已卖腰间剑，鲁叟从今不讳穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其三","author":"陆游","text":"日上小窗东，禽鸣高树中。\n乐哉容膝地，著此曲肱翁。\n香迮常迟散，儿来亦旋通。\n所惭贪坐睡，铅椠少新功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事四首 其二","author":"陆游","text":"唐虞千载仰巍巍，太息儒生每背驰。\n经未尽亡君更考，古无不死我何悲。\n钓耕本是求贤地，宵旰今逢愿治时。\n寄谢公卿各努力，为吾君筑太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其一","author":"陆游","text":"云起山容改，潮生浦面宽。\n寒鸦先雁到，乌桕后枫丹。\n年迈狐装帽，时新豆捣团。\n非关嗜温饱，更事耐悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事示儿辈","author":"陆游","text":"今岁霜迟殊未寒，篱东乌桕叶才丹。\n病轻渐喜免求药，老甚难誇能据鞍。\n邻舍僧贫分米少，酒坊人熟督钱宽。\n晚来笑向儿孙说，且得无生一话团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事示子遹","author":"陆游","text":"四十已悲非少年，耄期何事每欢然。\n游山夜雨眠僧院，沽酒秋风上钓船。\n诸友诗章来亹亹，小儿笔势亦翩翩。\n眼边不是常萧索，终忆巢居访老仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即席","author":"陆游","text":"解鞅名园眼倍明，殷勤翠袖劝飞觥。\n海棠红杏欲无色，蛱蝶黄鹂俱有情。\n去日不留春渐老，归舟已具客将行。\n倦游短鬓无多绿，生怕尊前唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴歌","author":"陆游","text":"胜负两蜗角，荣枯一蚁窠。\n人情苦翻覆，吾意久蹉跎。\n困睫凭茶醒，衰颜赖酒酡。\n坐人能听否，试为若吴歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吾年过八十二首 其一","author":"陆游","text":"吾年过八十，久已弃朝簪。\n化蝶有残梦，焦桐无赏音。\n溪声喧夜旦，野色变晴阴。\n欲讲平生学，茫然不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吾庐","author":"陆游","text":"吾庐虽小亦佳哉，新作柴门斸绿苔。\n拄杖每阑归鹤入，钓船时带夕阳来。\n墟烟隔水霏霏合，篱菊凌霜续续开。\n千里安期那可得，笑呼邻父共传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中","author":"陆游","text":"稚竹侵檐绿，新桐覆井凉。\n闲身少羁束，随处得徜徉。\n山鹊惺愡语，藤花掩冉香。\n吾诗有馀思，小复立西厢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中小饮","author":"陆游","text":"此老胸中万顷宽，小园幽径日追欢。\n宁教酒欠寻常债，耻就人求本分官。\n高柳阴浓烟欲暝，丛花红湿露初漙。\n要知泽国年光晚，已过清明尚浅寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中书触目","author":"陆游","text":"气候今年晚，浓霜始此回。\n残梧未全槁，晚菊有初开。\n乌桕先枫赤，寒鸦后雁来。\n西窗夕阳暖，摘橘荐新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中对酒作","author":"陆游","text":"伛偻衰翁雪满颠，爱花耽酒似当年。\n虽无锦障七十里，也有青铜三百钱。\n数掩竹篱分小径，一泓沙井贮寒泉。\n栽红接白株株活，坐拥春工太半权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中归戏作","author":"陆游","text":"醉里来寻涧上花，已飘残雪散馀霞。\n曲生也解欺人老，风伯无端妒物华。\n不恨童心伴蜂蝶，但愁病眼厌风沙。\n归来隐几东窗下，一卷黄庭送日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中作二首 其一","author":"陆游","text":"谁采桄榔寄一枝，北来万里为扶衰。\n风光最爱初寒候，怀抱殊胜未老时。\n闲引微泉成曲涧，尽除枯蔓补疏篱。\n花前自笑童心在，更伴群儿竹马嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中作二首 其二","author":"陆游","text":"病侵衰境频须药，日漏寒云旋作晴。\n幽鸟唤回残枕梦，蛮童扶下野堂行。\n书生本自安穷处，丰岁何妨乐太平。\n新买西村两黄犊，闲招邻曲议春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中作","author":"陆游","text":"幽禽啼不去，红蕊落还开。\n意适时时醉，身闲日日来。\n著书增水品，披句觅桤栽。\n消息吾儿近，扶衰又上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中作","author":"陆游","text":"湖曲旧诛茆，松阴近结巢。\n安闲多熟睡，衰退少新交。\n雨渍丁香结，春生豆蔻梢。\n良晨不把酒，新燕解相嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中作","author":"陆游","text":"纱巾一幅立斜阳，本尚无闲况有忙。\n鸡犬往来空自得，禽鱼翔泳各相忘。\n欲衰莎草无多绿，未落梧桐已半黄。\n徂岁匆匆成绝叹，瓦沟行复见新霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中把酒示邻曲二首 其一","author":"陆游","text":"畏途半世困风波，老返家山得已多。\n野饷虽无食指动，村醅也解醉颜酡。\n梦残正欲还君枕，棋罢那知烂客柯。\n松菊未荒风月在，应容老子且婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中把酒示邻曲二首 其二","author":"陆游","text":"煮豆烹蔬当果殽，固应杯酌尽陶匏。\n池塘潋潋荷浮叶，门巷阴阴笋放梢。\n三亩荒园存故业，一编蠹简得深交。\n弊庐经雨穿将遍，欲向村东自割茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中晚兴","author":"陆游","text":"世故谁能必，书生妄自期。\n年光卷中过，心事鬓边知。\n零落花随水，轮囷笋突篱。\n晚晴山尽出，徙倚独移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中赏梅二首 其一","author":"陆游","text":"阅尽千葩百卉春，此花风味独清真。\n江边晓雪愁欲语，马上夕阳香趁人。\n慰眼红苞初报信，回头青子又生仁。\n羁游偏觉年华速，徙倚阑干一怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园庐","author":"陆游","text":"天假残年使荷锄，白头父子守园庐。\n四朝曾遇千龄会，七世相传一束书。\n物理从来多倚伏，人情莫遣得亲疏。\n功名自有英雄了，吾辈惟当忆遂初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园居","author":"陆游","text":"欲出还中止，微阴却快晴。\n槛花栽尽活，笼鸟教初成。\n身寄江湖久，心知富贵轻。\n还婴吾所證，手自写庵名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"块坐斋中有感","author":"陆游","text":"败席凝尘懒拂除，况能作意去庭芜。\n读书眼力衰难强，对酒心情薄欲无。\n野寺钟鱼思下担，山邮鞍驮忆登途。\n颓然坐睡谁惊觉，寂寞西窗日又晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"坚顽","author":"陆游","text":"小市朝行药，明灯夜读书。\n虽殊带箭鹤，要是脱钩鱼。\n有饭已多矣，无衣亦晏如。\n坚顽君勿怪，岂失遂吾初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"局中春兴","author":"陆游","text":"天知病眼困风沙，借与蓬山阅物华。\n微暖已迎新到燕，轻阴犹护欲残花。\n幽窗寂寂书围座，倦枕时时梦过家。\n立马庭前还小驻，不妨闲试半瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张功甫许见访以诗坚其约","author":"陆游","text":"零落汀蘋露气清，北窗昨夜已秋声。\n书来屡有入东约，坐上极思虚左迎。\n激烈哦诗殷金石，纵横落笔走蛟鲸。\n吾曹此事期千载，老眼相逢剩要惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张时可直阁书报巳得请奉祠云台作长句贺之","author":"陆游","text":"灯前一笑拆书开，喜见冰衔洗俗埃。\n丞相苦留犹不住，诸公欲挽固难回。\n玩鸥有约间何阔，敛版无聊归去来。\n千载伏波应太息，输君谈笑上云台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张季长学士自兴元遣人来因询梁益间事怅然有感","author":"陆游","text":"长记残春入蜀时，嘉陵江上雨霏微。\n垂头驴瘦悲铃驮，截道狐奔脱猎围。\n晓度市桥花欲语，晚投山驿石能飞。\n杜鹃言语元无据，悔作东吴万里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彷徉","author":"陆游","text":"家世由来出楚狂，湖山垂老得彷徉。\n读书坐懒常中废，得句因衰已旋忘。\n万化随缘寓虫臂，百年何处异羊肠。\n忍饥到死知无恨，免使人嘲作饭囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忍穷","author":"陆游","text":"短褐财遮骭，孤烟仅续炊。\n久穷方有味，古语不吾欺。\n坚坐忘昏旦，残年迫耄期。\n尚馀书满屋，手校付吾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"志学","author":"陆游","text":"圣门志学岂能差，山立方当斥百家。\n早忝授经闻博约，晚羞同俗陷浮华。\n风剺槁面寒无褐，雷转饥肠饭有沙。\n漫道衰慵贪睡美，五更和梦听城笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"志喜","author":"陆游","text":"雪鬓萧萧九十翁，短檠犹喜策新功。\n斲轮自得不传处，治水本行无事中。\n山市儿童随小蹇，江村烟雨宿孤篷。\n更知衰疾从今减，万里尘清蜀药通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忧国","author":"陆游","text":"恩许还山已六年，誓凭耕稼饯华颠。\n养心虽若冰将释，忧国犹虞火未然。\n议论孰能忘忌讳，人材正要越拘挛。\n群公亦采刍荛否，贞观开元在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"快晴","author":"陆游","text":"地辟天开斗柄回，今朝红日遍池台。\n新阳苏醒春前柳，轻暖医治雪后梅。\n瓦屋螺青披雾出，锦江鸭绿抱山来。\n衰翁也逐儿童喜，旋拨文书近酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀王美","author":"陆游","text":"理发侵霜白，酡颜借酒红。\n故人千里别，何日一樽同。\n魂梦徒劳蝶，音书不见鸿。\n抱琴虽有意，无语倚西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧","author":"陆游","text":"身是人间一断蓬，半生南北任秋风。\n琴书昔作天涯客，蓑笠今成泽畔翁。\n梦破江亭山驿外，诗成灯影雨声中。\n不须强觅前人比，道似香山实不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀昔","author":"陆游","text":"偶住人间日月长，细思方觉少年狂。\n众中论事归多悔，醉后题诗醒已忘。\n鼍作鲸吞吁莫测，谷堙山堑浩难量。\n老来境界全非昨，卧看萦帘一缕香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀昔","author":"陆游","text":"昔遇高皇帝，华缨接俊游。\n年光一弹指，世事几浮沤。\n故国但青嶂，羁臣今白头。\n平生笑李广，痴绝望封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀绍兴间往还诸公","author":"陆游","text":"早岁从诸杰，森然尽国华。\n辞工出月胁，笔健拔鲸牙。\n道在穷何憾，年殂生有涯。\n湖山元不改，老泪湿风沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀南郑旧游","author":"陆游","text":"南山南畔昔从戎，宾主相期意气中。\n渴骥奔时书满壁，饿鸱鸣处箭凌风。\n千艘粟漕鱼关北，一点烽传骆谷东。\n惆怅壮游成昨梦，戴公亭下伴渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀故山","author":"陆游","text":"老怯京尘化素衣，无端抛掷钓鱼矶。\n碧云又见日将暮，芳草不知人念归。\n万事莫论羁枕梦，一身方堕乱书围。\n岷山学士无消息，空想灯前语入微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]