[{"title":"寄道乡居士三首 其一","author":"释德洪","text":"知有道乡何处是，个中归路滑于苔。\n万机罢后见城郭，一念不生金锁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道乡居士三首 其二","author":"释德洪","text":"抽身世路崎岖处，掣肘功名逼逐人。\n勿谓老来无伎俩，绝踪迹处解藏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道乡居士三首 其三","author":"释德洪","text":"丹霞未见庞居士，已有言词满四方。\n何似他时亲识面，未劳语默强遮藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒准禅师塔","author":"释德洪","text":"同条生不同条死，觌露全机谁后先。\n一句鹘崙难劈破，一时乞与子孙传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"两僧相继而化有感二首 其一","author":"释德洪","text":"丛席凋零空敛眉，争锋唇吻斗轻肥。\n叹无老宿提纲要，时有亡僧为发机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"两僧相继而化有感二首 其二","author":"释德洪","text":"宾朋鸳鹭门如市，声价灵延一世惊。\n只有片时人看好，死生那解替人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谊叟","author":"释德洪","text":"择乳鹅王非鸭类，影鞭良马本龙媒。\n正中妙叶无人会，句里空惊法眼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后寄荷塘幻住庵盲僧四首 其一","author":"释德洪","text":"灵光寂照神通藏，意地经营幻住庵。\n已喜眼根今现證，何妨要耳作同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后寄荷塘幻住庵盲僧四首 其二","author":"释德洪","text":"表里洞然无量相，晦明无计掩藏伊。\n庵中但见人孤坐，门外从教事不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后寄荷塘幻住庵盲僧四首 其三","author":"释德洪","text":"荷塘寺后千竿玉，折脚铛中五合陈。\n静里笑看垂钓者，夜深方见把针人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后寄荷塘幻住庵盲僧四首 其四","author":"释德洪","text":"檐日未通孤坐暖，雪云都放九峰青。\n空阶夜滴闻铃响，卧学荷塘耳诵经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉上人之洞山二首 其一","author":"释德洪","text":"正中妙叶讳当头，洞水从教向逆流。\n唱起新丰旧时曲，要看跃浪斗泥牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉上人之洞山二首 其二","author":"释德洪","text":"八角通红铁弹丸，衲僧未嚼齿先酸。\n笑中抛掷寻常事，石火敲时著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢保福寄蜜","author":"释德洪","text":"蜜脾新满割山房，都是诸花知见香。\n味绝中边深为有，待将无舌为君尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平有老僧顷见大本禅师掩门久不出乃书其壁","author":"释德洪","text":"跛脚阿师六世孙，毗陵古寺独关门。\n也知祖是陈尊宿，平昔高风宛尚存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿慈祥室","author":"释德洪","text":"行智慧心名解脱，绝荆棘地号慈祥。\n烟消火冷诸缘尽，憎爱化为平等光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抚州北景德寺不见古画第五尊罗汉","author":"释德洪","text":"十八声闻解倒根，少丛林汉乱山门。\n知他何处攞斋去，不见堂中第五尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题觉轩","author":"释德洪","text":"自笑忍饥空画饼，谁期击竹丧全身。\n休誇魏药能起死，须信金尘解翳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大风雪中迪吉老寻余钟山二首 其一","author":"释德洪","text":"风声卷地奔万马，雪花连空若推下。\n道人轩渠何所来，笑里丹砂不知价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大风雪中迪吉老寻余钟山二首 其二","author":"释德洪","text":"万事信缘安乐法，一身随分实头禅。\n不知影草声前句，何似和衣粥后眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"背尘轩","author":"释德洪","text":"思虑不及犹为物，分别未忘都是梦。\n阿难树见竟难分，曹溪风幡元不动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵廓然送瑫上人","author":"释德洪","text":"营办胜缘真戏事，临平此偈亦逢场。\n妙无影迹如龙句，应笑痴人戽夜塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游南禅","author":"释德洪","text":"智光广大精进力，化作人间释梵宫。\n我亦生涯无一钵，伴公他日听楼钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十生观音生辰烧香偈示智俱","author":"释德洪","text":"十世为僧生复死，今朝生死不相干。\n从来被眼常遮盖，不信如今借汝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题自肯庵","author":"释德洪","text":"诸方说禅炙手热，此庵默坐如冰冷。\n美食不中饱人餐，他人不肯我自肯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与朱世英夜论玄沙香严云庵宗旨三首 其一","author":"释德洪","text":"子母俱忘脱体看，纤毫才动被渠瞒。\n若非竖亚顶门眼，那辨红垆点雪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与朱世英夜论玄沙香严云庵宗旨三首 其二","author":"释德洪","text":"言下百骸俱脱尽，更无一法覆藏伊。\n亡僧对面分明看，却是禅和眼搭痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与朱世英夜论玄沙香严云庵宗旨三首 其三","author":"释德洪","text":"睡美春来常失晓，日高衾暖懒翻身。\n戏将古寺闲房趣，誇与闹中无事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立上人北游五顶南还画文殊云间之相余政和年秋游翠岩立持以展洪崖桥上时山云廓清万峰剑立溪转雷惊行人悚动忽瞻瑞相如见于岱岳时余闻文殊为根本智智无不立岂独现于五顶耶","author":"释德洪","text":"稽首一切智成就，譬如一月落万水。\n乃知洪崖桥上看，不离文殊一月体。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题永安居士轩壁","author":"释德洪","text":"谩说难酬彼工人，上人言语未全真。\n世间所有皆虚幻，何独芭蕉可喻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山寄诠上人","author":"释德洪","text":"孤筇冒雨出山去，应与道人增笑声。\n永愧萧萧碧岩下，衲衣清散自经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一万回","author":"释德洪","text":"当年随我出西州，到处云山共胜游。\n那料秦淮烟雨里，倚筇看子上孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道逢南岳太上人游京师戏赠其行","author":"释德洪","text":"野外相逢一笑新，十年峰顶卧云人。\n却将南楚登山脚，去踏东华没马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧从事文字禅三首 其一","author":"释德洪","text":"中郎书异为忠孝，右辖诗清付水云。\n林下一灯长到晓，此生真复是知闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧从事文字禅三首 其二","author":"释德洪","text":"一麟众角失精彩，尺璧千崖发耿光。\n借面北人无四目，独馀方寸是慈祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧从事文字禅三首 其三","author":"释德洪","text":"三多授子文章法，坏衲酬吾老大心。\n帘捲暮凉烟翠重，一声云斧觉山深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵狱中谢人惠茶","author":"释德洪","text":"宝公关锁寻常事，谂老家风气味长。\n十载故人情外意，一杯今日雨前香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"随与珉秀七八衲子为办寒具","author":"释德洪","text":"幽人十月犹絺绤，万瓦霜清木叶号。\n赖有西邻念衰冷，夜窗丛手办衣袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道夫三首 其一","author":"释德洪","text":"卧诵故交风雨散，忽惊时序岁时同。\n遥知吏散无馀事，只有花枝绕郭红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道夫三首 其二","author":"释德洪","text":"石渠天禄略上口，长啸簿书欺得人。\n龙卷大身藏一发，儿曹聊尔与相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道夫三首 其三","author":"释德洪","text":"昭默老禅最高遁，孤风闻说不容攀。\n烦君倒用彭泽印，折简招之应出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会广南因上人","author":"释德洪","text":"我昔南游跨海还，梦中常忆海边山。\n匡庐忽见山中客，果笑人间是梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"超然在东华作此招之","author":"释德洪","text":"芒鞋踏破成何事，坐榻尘埋只汗颜。\n斋钵生涯唯涧饮，结茅终待老钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时余适金陵定居定林超然将南归从余游以为诗谶也复次其韵","author":"释德洪","text":"袖手对君增白业，照溪嗟我减朱颜。\n遥知岁晚归心急，不为江南卧看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆上人觅诗","author":"释德洪","text":"平生百态不挂眼，倚杖看云慵解包。\n湘水丛林多古格，何妨一钵稳安巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至邵州示胡强仲三首 其一","author":"释德洪","text":"平生厌饫水云间，老境优游剩得閒。\n远谪瘴乡君勿叹，天教更看海南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至邵州示胡强仲三首 其二","author":"释德洪","text":"情缘不断自消灭，浮念欲生无起因。\n多谢鍊磨金出矿，敢辞枷锁梦中身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至邵州示胡强仲三首 其三","author":"释德洪","text":"卢能岭上容君看，弥勒楼前借汝观。\n成佛捷途当举足，不须平地致艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书资国寺壁","author":"释德洪","text":"行藏独许青山见，议论犹容乱石闻。\n勿谓衲盲贫胜我，溪分明月谷量云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送圆监寺持钵之邵阳","author":"释德洪","text":"丛林职似惊群雁，供给情如反哺乌。\n梅蕊犯寒持钵去，山茶出屋得归无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠钦上人","author":"释德洪","text":"嫩日柔风春恰晓，花光醉人浓可皛。\n到山不必问老师，春色为侬都说了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与法护禅者","author":"释德洪","text":"手抄禅林僧宝传，暗诵石门文字禅。\n拣得湘西好三角，春风归去弄云泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示观上人","author":"释德洪","text":"观公短小精悍色，试手来参五味禅。\n挂起北窗都会取，湘江云水自连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"在百丈寄灵源禅师二首 其一","author":"释德洪","text":"暗中树影平生意，水底鱼踪病后机。\n想见道容无住著，倚藤闲看暮云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"在百丈寄灵源禅师二首 其二","author":"释德洪","text":"平昔追随骨海心，暮年粥饭并丛林。\n朅来万事撩人笑，此去青山为我深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵兀翁","author":"释德洪","text":"渔人寄语兀翁道，出没烟波各有由。\n死见镬汤如攧浪，爱鱼心在未甘休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其一","author":"释德洪","text":"法真有子是弥天，派出南屏共一源。\n鲁钝经旬陪夜语，浪持短绠汲深渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其二","author":"释德洪","text":"危径盘空一线微，游人举足已先疲。\n大圆光透难遮掩，不学龙牙眼似眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其三","author":"释德洪","text":"腾腾兀兀地行仙，依约曾参蚬子禅。\n古庙纸钱堆里睡，从教岁月自推迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其四","author":"释德洪","text":"万层翠巘玉崔嵬，独自凭阑日几回。\n知有芙蓉更深秀，振筇何幸获追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其五","author":"释德洪","text":"凝伫残阳眼力微，孤云偶伴野僧归。\n形容万古沩山色，正赖晴岚与夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其六","author":"释德洪","text":"蟠龙不许在层渊，一句全提赖发宣。\n惭愧儿孙家法在，未施声色透重玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其七","author":"释德洪","text":"宝塔当烦妙语传，要令此地福人天。\n个中已有全身见，何用分身遍大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其八","author":"释德洪","text":"未言酬倡多佳句，半月游山亦自贤。\n我亦生涯无窖子，愿陪香火饯馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵空印游山九首 其九","author":"释德洪","text":"大沩愿力有谁同，贯日精神吐白虹。\n我酌轼公泉叹息，此源有尽水无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗上人求偈之江南","author":"释德洪","text":"川舌一从尝虏馔，山衣三载湿湘云。\n挑包又过江南去，鶗鴂遥知半路闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范上人乞食","author":"释德洪","text":"众魔不敌精进力，万行难过平等心。\n持钵莫辞穿聚落，道人随处是丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济上人求偈二首 其一","author":"释德洪","text":"圆通搥碎牢关后，古镜发光金石开。\n稳坐龙安今七日，从教山路滑于苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济上人求偈二首 其二","author":"释德洪","text":"李珣骨已成丘垄，仲逊身犹占水云。\n扶策南来山满眼，实头乡话与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芭蕉","author":"释德洪","text":"凤尾争高照映人，玉芽明洁出埃尘。\n也知欲救众生病，共现如来智智身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵无诤见怀三首 其一","author":"释德洪","text":"韵倾瘦字试乌丝，苦语偏多别后思。\n青巘君能容易去，白鸥愧我负幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵无诤见怀三首 其二","author":"释德洪","text":"数篙云碧卷晴空，无数岩花落醉红。\n满袖东风疏雨后，却欣春露一瓯同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵无诤见怀三首 其三","author":"释德洪","text":"老眼慵看读过书，十年心迹更谁于。\n青松我欲追三径，白发谁令继二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十日梦人持猕猴见赠乞诗口舌","author":"释德洪","text":"长臂幽姿要性灵，写经欣得尔添瓶。\n不须睡著惺惺著，窗外闻人唤便应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十三日心禅饷余新面白蜜作二首 其一","author":"释德洪","text":"三月东庄新麦熟，碾迟罗细玉尘香。\n要看十字开笼饼，寄与庵头老俨尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十三日心禅饷余新面白蜜作二首 其二","author":"释德洪","text":"老俨年来百不忺，最嫌苦淡不嫌甜。\n蜜中有味中边绝，莫笑山居世味添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与谦知藏二首 其一","author":"释德洪","text":"老烂丛林四十年，平生跛挈但随缘。\n未言亲见云居老，只识归言亦自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]