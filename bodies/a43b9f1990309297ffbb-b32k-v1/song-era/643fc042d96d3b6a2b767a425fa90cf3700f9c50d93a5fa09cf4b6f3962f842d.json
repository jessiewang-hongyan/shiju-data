[{"title":"南湖书事五首 其二","author":"张镃","text":"过午人家起灶烟，被风轻引向晴川。\n须臾却与云阴杂，不碍玻璃镜自圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖书事五首 其一","author":"张镃","text":"初来作舍少人行，桥外如今满市声。\n绕岸种成桃间柳，一家和气万家生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖有鸥成群里闾间云数十年未尝见也实尘中奇事因筑亭洲上榜曰鸥渚仍放言六绝 其二","author":"张镃","text":"旋开斜港放船出，更著小亭临水看。\n软红尘里江山景，便著丹青画亦难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖有鸥成群里闾间云数十年未尝见也实尘中奇事因筑亭洲上榜曰鸥渚仍放言六绝 其四","author":"张镃","text":"朝阳鸣凤国之祥，瑞事吾家鸥鹭行。\n最爱几声烟外响，和他渔艇独敲榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖有鸥成群里闾间云数十年未尝见也实尘中奇事因筑亭洲上榜曰鸥渚仍放言六绝 其一","author":"张镃","text":"居士园门甚处开，傍城犹未著楼台。\n门前湖水三千尺，引得沙鸥亦肯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖有鸥成群里闾间云数十年未尝见也实尘中奇事因筑亭洲上榜曰鸥渚仍放言六绝 其三","author":"张镃","text":"东家西家翁媪说，白洋湖自有多年。\n何曾识见江鸥至，消得主人诗兴颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖赋冬青花四首 其四","author":"张镃","text":"桂子休誇碧满园，小蒲萄实待霜繁。\n他年隐处寻西宅，先认冬青拥寺门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖赋冬青花四首 其三","author":"张镃","text":"酷烈深怜格外香，树边苔气与苍凉。\n莫教糁径浑如雪，快向青阴置竹床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖赋冬青花四首 其二","author":"张镃","text":"上林名字万年枝，高映宫墙侧映池。\n不是移根閒地种，岁寒情性有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖赋冬青花四首 其一","author":"张镃","text":"杂树花香少似君，雨馀风晓或斜曛。\n行人不著清新句，亦合移时驻屐闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春云","author":"张镃","text":"松边寒彩过前山，松下铺毡坐不还。\n泽物为霖休自苦，且来相伴约斋閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"张镃","text":"银叶煎香细雨声，竹阴行处药花明。\n麦光小楷临唐帖，更有人间第一清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日汎舟南湖因遍游近港坐间书客所携四扇 其二","author":"张镃","text":"丝簧同上木兰船，细草熏熏柳色天。\n要是有诗方称此，不然枉作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日汎舟南湖因遍游近港坐间书客所携四扇 其一","author":"张镃","text":"远近高低锦树明，直疑春教蝶多情。\n人间万事思量尽，只好园居过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日汎舟南湖因遍游近港坐间书客所携四扇 其四","author":"张镃","text":"赏玩归来日未斜，门前春水绿杨遮。\n园亭西畔晴尤好，一色墙头见杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日汎舟南湖因遍游近港坐间书客所携四扇 其三","author":"张镃","text":"先须放棹绕湖游，倒看行云水底浮。\n客去莫归朝市说，引渠无意作公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春风","author":"张镃","text":"春风日日过东墙，睡起人閒蝶自忙。\n吹尽玫瑰能底惜，只缘销去一年香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪阻观梅花两诗嘲之 其一","author":"张镃","text":"弄珠萦佩白衣仙，游戏尘寰占岁前。\n却被天公撒龙脑，拥教无地著云軿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪阻观梅花两诗嘲之 其二","author":"张镃","text":"雨声俄混雪声乾，泥泞林堂一到难。\n藉使玉肌无冻粟，可能独自过春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残梅","author":"张镃","text":"雨丝吹冷透窗纱，忽忽东风管鬓华。\n岂为梅残便无恨，草生时节胜看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点视马驿因成两绝 其二","author":"张镃","text":"万里关山过险巇，风廊聊此憩权奇。\n天开径上从兹始，想见长鸣振鬣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点视马驿因成两绝 其一","author":"张镃","text":"别驾今晨检驿亭，道迎羸卒破铜钲。\n当年错做书窗梦，蔽日旌旗出塞兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"珍林","author":"张镃","text":"李枣栗银杏，橙梨柿木瓜。\n杨梅与金橘，不让满园花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盆橘","author":"张镃","text":"懒向江头置木奴，瓦盆聊玩绿垂珠。\n何烦二老输赢决，始悟商山乐不殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相士陈邦彦觅诗","author":"张镃","text":"眼力知君已绝伦，奉传一法更通神。\n看渠天爵高人爵，方是人间富贵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看雁","author":"张镃","text":"晓晴群雁欲何之，正是青天似纸时。\n横斜数行有声字，服杀虚空解作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种腊梅喜成 其二","author":"张镃","text":"僧庐草剑石崖根，惯见西湖不喜论。\n安得便如居士意，移为官舍读书轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种腊梅喜成 其一","author":"张镃","text":"道旁方讶扑人香，金蓓花开满担装。\n尚有松钗挂枝杪，买归偏称插山堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荠花","author":"张镃","text":"荠花繁处蝶争飞，忽忆前年三月时。\n流水流杯人共醉，晚来疏雨又新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"药溪","author":"张镃","text":"野药随宜种，芎苗嚼最香。\n屐痕休厌数，桤树逐溪长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送马舍人赴建康军幕","author":"张镃","text":"柳营谋客自枫宸，去去尖风雁字匀。\n莫把吟诗替横槊，新亭北望正愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其六","author":"张镃","text":"老僧分袂倏三年，犹记芳池跃翠泉。\n新叠两山都未识，北堂引看更东偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其五","author":"张镃","text":"南山好处刘家寺，门里松篁一径冲。\n自有禽声喜迎客，不须知事更鸣钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其四","author":"张镃","text":"岭度慈云境累凉，前看湖面后看江。\n诗魔半饷难调伏，除是休来却易降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其三","author":"张镃","text":"山腰路转涌苍蛇，山下修筠媚白沙。\n正要澄江舒倦眼，莫教缘岸有人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其二","author":"张镃","text":"野香别是一般风，蓦直平冈好翠松。\n更许虚空画山水，细铺霞浪衬云峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其一","author":"张镃","text":"故殿檐阴石汇泉，针鱼苔净乐回旋。\n持杯挹取虽无暇，照影心肠更洒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其十","author":"张镃","text":"欲归停驭重徘徊，破费林间雪一杯。\n留取半山看未了，火云时节约重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其九","author":"张镃","text":"亭桥两面看芙蕖，静数波间小队鱼。\n碧幛弯环遮去路，净天终待此同居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其八","author":"张镃","text":"井分泉脉透巉岩，谁道飞流是假山。\n水鸟树林皆作供，可怜居士只偷閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至无相兰若归过慈云岭小憩崇寿寺书所见十首 其七","author":"张镃","text":"支径坡陀竹最多，箨龙才起更成窠。\n穿岚触翠坳塘出，一片香来得嫩荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送酒诚斋将以五字","author":"张镃","text":"不应杨秘监，无暇问南湖。\n桂树又花发，莲池和叶枯。\n雨声秋最好，尊酒客非无。\n寄去撩诗眼，深惭句法粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送樱桃与范尚书二首 其二","author":"张镃","text":"满架酴醾雪未乾，滴阶红颗照春残。\n知公有意参金鼎，驰送朝霞九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送樱桃与范尚书二首 其一","author":"张镃","text":"谁将绛蜡千枝泪，镕作骊龙百斛珠。\n酪盌冰盘非我称，敢烦西子荐陶朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香玉花","author":"张镃","text":"髣髴是荼蘼，金沙著白衣。\n香于佛见笑，大似野蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸥渚亭次韵茂洪西湖三诗 其一","author":"张镃","text":"出城犹记四年前，朝看西湖到暮烟。\n自有南湖相暖热，可曾频过六桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸥渚亭次韵茂洪西湖三诗 其三","author":"张镃","text":"尘土奔忙举世人，无过白白鬓毛新。\n一般要撰眼前乐，泉石由来乐较真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸥渚偶成二首 其二","author":"张镃","text":"去去西南绿筱湾，折旋遵渚又飞还。\n轻拳击水纤鳞起，滴沥波明一带间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸥渚偶成二首 其一","author":"张镃","text":"昼阴无意到湖亭，引客悠然试一行。\n便有同盟数公在，冒烟挥袂喜相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"