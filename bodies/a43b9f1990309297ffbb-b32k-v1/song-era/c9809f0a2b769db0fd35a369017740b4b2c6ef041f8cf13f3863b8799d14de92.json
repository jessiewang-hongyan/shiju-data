[{"title":"县僚祷雨盘藤庙连日大澍次韵黄超然","author":"王庭圭","text":"□□□□□□□，□□□□□□□。\n□□□□上林抄，半空云走挟雷声。\n旱妖作魃乘时起，天意为霖转眄成。\n莫问田畴水深浅，县前江已拍堤平。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和前韵","author":"王庭圭","text":"江夏无双望久倾，高文犹带玉堂清。\n子云识字终投阁，侯喜能诗新有声。\n偶会风云苏大旱，戏将笔札庆垂成。\n年丰但使无公事，勿虑潢池贼未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜刘世臣仲美及第","author":"王庭圭","text":"同上青云踏玉梯，仍穿月胁取蟾枝。\n江南魁荐星文动，兰省名高天下知。\n共喜秀光前日会，争传真逸老人诗。\n万牛回首扶梁栋，可笑蚍蜉欲撼时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送欧阳广明游仰山兼简慈书记二首 其一","author":"王庭圭","text":"士穷不作儒生酸，岁晚聊为物外观。\n行脚僧从幽径出，集云峰倚半天寒。\n且携几緉登山屐，胜走高门坐马鞍。\n君见堂西旧书记，试求开阁看金襕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送欧阳广明游仰山兼简慈书记二首 其二","author":"王庭圭","text":"不畏霜风射眼酸，要登峰顶作奇观。\n连天野水微生绿，隔岸官梅已破寒。\n试共嵇康寻石髓，要随杜老逐金鞍。\n归来山鸟迎人闹，应是怪君犹布襕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送别曾英发","author":"王庭圭","text":"士元来访颍川公，桑下清谈有素风。\n不扣洪钟安识响，更闻妙句岂宜蒙。\n如君晚节犹堪奋，期我高名莫大穹。\n此别应难问消息，寄书无惜到山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘元弼岁除书事","author":"王庭圭","text":"吟诗辄莫叹年终，岁岁年年事不同。\n蓝尾旋倾人半醉，楼头犹听鼓三通。\n渐看暖律回春槛，且任狂风揭钓篷。\n管有明朝好天色，澹云微雨翠烟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题谭微仲一经堂","author":"王庭圭","text":"汉儒重道独专经，唐室初增博士名。\n韦氏起家仍相国，稚圭能说亦公卿。\n司空城旦污潢潦，古壁遗文粲日星。\n异日诸郎拾青紫，传家何用满筲籯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登鸿飞台","author":"王庭圭","text":"拄杖秋登何处台，天高风急雁声回。\n疏林红叶纷纷下，绕径黄花细细开。\n此地崔嵬聊试脚，明年强健更衔杯。\n绿樽乌帽随时足，无用白衣人送来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"豫章别彭养直","author":"王庭圭","text":"荔子欲丹蕉叶黄，别君南浦正凄凉。\n九疑隔岭共明月，万里穷途非故乡。\n坐见浮云更百态，行吟秋水动三湘。\n金鸡放赦知何日，尚许生还天一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送任子严江西运干","author":"王庭圭","text":"正坐惩羹吹冷齑，送君那复有新诗。\n明朝便恐隔千里，抱病何由把一卮。\n西蜀文章自家法，江南烟雨上楼时。\n东湖滕阁多佳兴，落笔端能寄所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别黄子默","author":"王庭圭","text":"回瞻人在斗南边，目断湘中万里天。\n驱马又过衡岳寺，携家却上洞庭船。\n江湖足了平生事，文字岂徒今世传。\n不共离亭一樽酒，行看待我著归鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郭伟节段廷直见寄二首 其一","author":"王庭圭","text":"山灵未忍勒铭移，空有寒鸦噪竹枝。\n二妙相逢春雾里，老夫将窜夜郎时。\n传看尺素双鱼尾，突过黄初数子诗。\n不上沅江探奇绝，平生谁肯一来兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郭伟节段廷直见寄二首 其二","author":"王庭圭","text":"邂逅江楼初识面，骑驴冲雪耸诗肩。\n谈倾坐客人如玉，蘋满汀洲水拍天。\n君欲摩霄登兔窟，我方载月上渔船。\n夜郎千古穷愁地，窜逐曾留李谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡潇湘江","author":"王庭圭","text":"夜听潇湘江上雨，今朝雨里渡潇湘。\n船冲晓浪涨新碧，山似画图非故乡。\n鸿雁来时应好在，白鸥飞起忽成行。\n论诗安得杜陵老，望岳令渠赋一章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自江上游龙兴至净因寺","author":"王庭圭","text":"晓踏晴沙江上堤，堤平沙尽草萋萋。\n墙头野杏才先发，叶底雏莺自在啼。\n问道渔舟通膴水，只应烟火是桃溪。\n深村疑有秦人在，记取来时路恐迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺王彦恭新除湖北漕","author":"王庭圭","text":"年年新换玉麟符，应为高名满太虚。\n紫塞初分邵阳垒，皇华初上使臣车。\n木牛转粟洞庭野，金马催班待诏庐。\n旗鼓行春真昼锦，可能一访夜郎居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖北总领彭子从郎中","author":"王庭圭","text":"翼轸星边贯索疏，星文夜动紫宸居。\n追锋急召归郎省，持橐犹稽侍玉除。\n六路藩臣供馈饷，五溪蛮子乐耕锄。\n连营十万无饥色，却入承明奉直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚同石子文游欧阳参军园问其主人已物故独一老妇开门亭槛幽雅酴醾方盛开因叹二年卜居邻巷相去数十步而未尝一到作诗记之 其一","author":"王庭圭","text":"百花狼藉草如茵，谁与东皇殿后尘。\n故放酴醾教独步，更无凡木敢争春。\n杖藜亦偶逢幽径，扣户何须问主人。\n坐久忽思归路晚，举头香雪落乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚同石子文游欧阳参军园问其主人已物故独一老妇开门亭槛幽雅酴醾方盛开因叹二年卜居邻巷相去数十步而未尝一到作诗记之 其二","author":"王庭圭","text":"居邻曲巷有朱扉，未许墙东宋玉窥。\n春草满池惊昼梦，酴醾万朵压繁枝。\n湘西江上参军宅，黄四娘家子美诗。\n他日沅陵寻故事，为余收入楚人词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄彦谟通判岳州","author":"王庭圭","text":"奇功已奏紫宸居，新上南州别驾车。\n木叶寒飞洞庭野，楼船光照赤沙湖。\n犹闻豺虎纵横在，已觉江山气象舒。\n万一潢池群盗息，回戈请为扫狂胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱致一来守辰州先致启书余以病未及答而致一压境以诗迎之","author":"王庭圭","text":"丽谯高垒武陵西，西望双红捲使旗。\n玉帐静驱千骑弩，铜符遥镇五溪夷。\n我遭白简为迁客，君拥朱轮把一麾。\n诸洞带刀迎马首，略无征鼓动边陲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰十二月自城东泛舟迁居城西安福寺舟中微雪","author":"王庭圭","text":"朔风吹雪江上来，急桨迎风荡不开。\n渡口云藏伏波庙，山腰雾失楚妃台。\n移居自作泛舟乐，抱瓮还如载酒回。\n岁晚浮家寄何处，两溪春水绿如醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李郎中生日","author":"王庭圭","text":"三槐堂下清阴满，太华峰头绿叶圆。\n天上正开炎帝历，人间初识岁星年。\n名郎早合归华省，藏室行当缀列仙。\n雉堞新崇边垒壮，长城不独有前贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"报恩寺避暑","author":"王庭圭","text":"风枝不动午云蒸，古寺嵯峨倚石层。\n百丈虚廊荫华桷，半帘疏雨断飞蝇。\n病馀已怯金樽酒，捧立仍无玉盌冰。\n奈此人间诸热恼，一杯清茗属高僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙亥立春夜雨平旦大雪","author":"王庭圭","text":"青帝重扃夜半开，先驱雷雨下天来。\n千门万户春风入，小院高楼乐事回。\n但喜新年逢瑞雪，不知平地有瑶台。\n杜陵远客多愁思，忽忆两京初发梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和马德俭韵","author":"王庭圭","text":"两苏共赋灵芝句，知是君家矍铄翁。\n门巷偶邻三径竹，功名当柱五溪铜。\n似闻四海尘初静，犹恐扁舟兴未穷。\n螺子江边无久滞，亦宜抟翮上晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘时举主簿相别三十年忽相遇于沅湘之间古夜郎郡也郡素窘俸馈不继垂橐而归相聚月馀赋诗为别","author":"王庭圭","text":"谪仙适窜夜郎道，主簿归从飞鸟边。\n但喜骑驴得佳句，忽忘挥麈是何年。\n且将肚束三条篾，敢望腰缠十万钱。\n剩斩湘南几竿竹，他时分我钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早春怀叶观察","author":"王庭圭","text":"门前江水有春声，鹭浴沙汀照眼明。\n诗律未堪传乐府，酒兵聊且下愁城。\n无穷涧草争青出，自在岩花绝壁生。\n忽忆江南护戎老，晴窗磨墨听新莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送頔子还庐陵","author":"王庭圭","text":"东归未办武陵舟，送汝翻成一段愁。\n雪点敝裘骑瘦马，春寒几日到荆州。\n湖山天阔洞庭野，吴楚月明黄鹤楼。\n莫苦回瞻白云岭，是行聊学子长游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叶起商杨茂之","author":"王庭圭","text":"池塘春草年年绿，笔力千钧挽莫回。\n南国遗骚拾兰芷，西湖体雪禁梨梅。\n穷途言咏颇寒窘，治世音声无怨哀。\n一览巨编真雅唱，秀苗奇特出荒莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬祝彦直","author":"王庭圭","text":"矍铄犹能一据鞍，将军虽老未甘闲。\n谬携鱼目投龙颔，正类蒹葭倚玉山。\n词力倒倾江汉底，光芒今射斗牛间。\n珠玑赠我应难久，却恐风雷夜掣还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李守拉登谯门观修城","author":"王庭圭","text":"忽见金汤峙塞垣，丽谯雄冠楚山川。\n门开下瞰双溪水，壁立新磨万丈砖。\n招抚番夷应有术，折冲樽俎正临边。\n边头卧鼓休戈甲，坐对春风理管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李宜仲见怀朱崖夜郎二逐客","author":"王庭圭","text":"不因贵贱识交情，此段当令后辈倾。\n三友一龙吾作尾，同时四海孰为兄。\n殊方少客通南北，厚禄无书访死生。\n万里归期应可指，九衢先听卖钗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵段季裕惠诗二首 其一","author":"王庭圭","text":"久战词场力未衰，毫端珠璧粲离离。\n气如八尺九花马，人似千年五聚龟。\n国士无双君自有，痴儿不了我先知。\n七年留滞沅湘道，忽咏青山独往诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵段季裕惠诗二首 其二","author":"王庭圭","text":"谪堕西南海角边，是中乐事亦天全。\n渐闻长乐钟声近，正遇巫阳敕放年。\n客过茅蓬非率尔，诗如锦绣益飘然。\n一樽岂尽平生话，咫尺高楼起暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叶起商","author":"王庭圭","text":"少年携艺试东都，一鼓无成怒奋须。\n便把龙韬取官职，欲随鹏海混程途。\n清言自可容平子，文笔谁堪答挚虞。\n要使貂蝉出金鍪，腐儒宁不愧操觚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和向令制锦轩","author":"王庭圭","text":"大邑大官身所安，欲将何术抚创残。\n久怀利器聊堪试，正见操刀不作难。\n百里光华风俗美，一天清澹水云宽。\n剸裁大巧元无迹，血指从旁袖手观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬刘遂卿","author":"王庭圭","text":"夜郎逐客东归日，倾盖江边侧帽时。\n雾豹隐山宜自养，弓蛇落盏莫生疑。\n古今得失棋千局，湖海飘零酒一卮。\n期子崭然出头角，名场何患少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初至行在","author":"王庭圭","text":"望中楼阁入青冥，疑是长安旧帝城。\n千里荷花开世界，几年羁旅望神京。\n老随丹诏身犹健，梦入华胥眼尚生。\n行尽沙河塘上路，夜深灯火识升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上殿退朝口号","author":"王庭圭","text":"银台南畔晓云飞，路入丹霄上紫薇。\n共看客星朝帝座，敢将汗脚踏天扉。\n遥瞻凤翼差池似，近对龙颜咫尺威。\n自愧衣袍正蓝缕，晚来忽带御香归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王舍人赴明州过阙二首 其一","author":"王庭圭","text":"紫泥初出大明宫，端为朝廷知弱翁。\n平地便开丞相府，乌台先跨玉花骢。\n一时治行无前辈，共喜君王记自公。\n暂假双旌临近辅，聊观海日正曈昽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王舍人赴明州过阙二首 其二","author":"王庭圭","text":"当年玉殿校群材，名占枢垣北斗魁。\n曾入翰林批凤尾，每瞻云气想蓬莱。\n前驱候吏千军肃，遥望天门九扇开。\n咫尺龙颜应入奏，紫霄东畔晓班催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨廷秀求近诗","author":"王庭圭","text":"闻说学诗如学仙，怪来诗思渺无边。\n自怜犹裹痴人骨，岂意妄得麻姑鞭。\n曾似千军初入阵，清于三峡夜流泉。\n只今老钝无新语，枫落吴江恐误传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡邦衡移衡州用坐客段廷直韵","author":"王庭圭","text":"朱崖万里海为乡，百鍊不屈刚为肠。\n复出光芒动星斗，定随雷雨起江湘。\n归期正待春回雁，贺客争持酒满觞。\n笑说开元丞相宅，凄凉偃月上标堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张子家见访惠诗","author":"王庭圭","text":"老去无才可致君，强从诗社立奇勋。\n忽逢天上张公子，应念台州郑广文。\n风月何尝千里隔，江山不用一钱分。\n能来鼓噪助馀勇，气压淮淝百万军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵赠别子家","author":"王庭圭","text":"西掖篇章自一门，君能祖袭有殊勋。\n风流前代黄花句，梦想当年紫凤文。\n月下长吟成独唱，壁间强咏共谁分。\n江头惜别多新咏，秃笔犹堪殿后军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄子默湖南机宜","author":"王庭圭","text":"潢池赤子弄锄耰，天子择日除元侯。\n今君去为幕下士，多材应与幄中筹。\n官弩近围临桂峒，捷书飞入未央楼。\n想当磨盾作露布，何异裴公取蔡州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送同年赵季成知武冈军","author":"王庭圭","text":"收科同日上蓬瀛，独我胡为憔悴生。\n晚节见君乘五马，前驱夹道拥千兵。\n行间峒窟烟霞静，卧听边城鼓角声。\n入境旌旗应动色，更看蛮户带刀迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欧阳彦文晚始得官为边郡狱掾乃州里宿儒于其行也诗以饯之","author":"王庭圭","text":"往日高名动场屋，青衫未足称平生。\n一官曹掾当蛮徼，万里山河列汉营。\n顾我老无投笔志，羡君今去走边城。\n边头已卧将军鼓，早晚书来说太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵文卿之湖南","author":"王庭圭","text":"霜馀新雁点汀蘋，愁绝送君湖水滨。\n自叹老夫如病骥，早知公子是天麟。\n渡湘怀远烟横渚，望岳题诗雨垫巾。\n想见骑驴得佳句，剩将收拾锦囊春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张子家新除浙西抚干见寄","author":"王庭圭","text":"幕府官清比县僚，升沈何啻九牛毛。\n蓬蒿仲蔚今多病，湖海元龙气尚豪。\n丽句早知何水部，旧交谁记柳仪曹。\n相如属思宁迟久，不欲诙俳恐类皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵路节推瑞香幽兰","author":"王庭圭","text":"君家兰玉盈阶砌，傍有薰笼锦一端。\n雅似高人来席上，幽如靓女出林间。\n芳丛欲吐新芽长，深谷知谁著眼观。\n谢氏风流元自有，更留佳客奉清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨文发自长沙相别忽来权邑惠诗次其韵","author":"王庭圭","text":"湘水东边唤渡舟，湘天欲暮使人愁。\n岂期陶令来为县，应念庞公不入州。\n索我题诗今老矣，看君下笔几时休。\n论文把酒诚堪乐，莫叹樽前欠杜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨文黼","author":"王庭圭","text":"乌啼鹊噪竹生风，谁过柴门访病翁。\n清论逼人来亹亹，夕阳归马恨匆匆。\n遥瞻紫极黄云里，却望长安醉眼中。\n南北车书将混一，莫嗟吾道隔西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄伯思求其祖梦升墓铭跋","author":"王庭圭","text":"妙句高文满锦囊，坐惊蓬瓮忽生光。\n君家人物代不乏，文彩风流想未忘。\n千载运中逢太史，诸王殿下识黄香。\n江西多士传心印，又出宗支一派长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡邦衡北归先寄诗二首次韵迎之 其一","author":"王庭圭","text":"无何真是本来乡，莫遣闲愁犯肺肠。\n会见栋梁扶大厦，不将文字吊沈湘。\n挥毫未辩银为管，沽酒奚须玉作觞。\n双竹端能作奇瑞，衡人宜护竹间堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡邦衡北归先寄诗二首次韵迎之 其二","author":"王庭圭","text":"当年大册撼天扉，圣主今呼逐客归。\n应是风云乘此会，便令鹓鹭著行飞。\n久埋剑气冲星气，暂裂荷衣换锦衣。\n稳上丹墀踏龙尾，九霞光里望晨晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和吴思道韵寄郭德耘","author":"王庭圭","text":"乱后交游半不闻，天涯沦落始逢君。\n黔南可怪无驴养，冀北遂当空马群。\n尚使高才淹管库，忽传佳句吐烟云。\n十年雠校金銮殿，依旧无毡似广文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左世绩妙年登第而飘泊遐荒十年不得调盖尝以事忤权贵今公道方开始欲仕进索余赋诗","author":"王庭圭","text":"射策枫庭最妙年，九衢争看若登仙。\n乘鸾岂慕天边贵，失马方知塞上贤。\n华毂朱轮多覆辙，高门大屋尚修椽。\n如今相国开公道，此诗他时亦盛传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬周孟觉","author":"王庭圭","text":"看铸铜人能几何，相逢重得复摩挲。\n江山如画风流在，城郭空惊岁月多。\n岂谓今朝闻正始，更翻新律似元和。\n思君夜久犹伫立，月上松梢映绿萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]