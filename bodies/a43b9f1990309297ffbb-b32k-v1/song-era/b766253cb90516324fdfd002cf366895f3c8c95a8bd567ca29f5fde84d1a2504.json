[{"title":"颂古四首 其四","author":"释仲安","text":"解劈当胸箭，因何只半人。\n为从途路晓，所以不全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其三","author":"释仲安","text":"一段风光画不成，洞房深处畅予情。\n频呼小玉元无事，只要檀郎认得声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释仲安","text":"法王法令没周遮，一片虚凝绝点瑕。\n槌下不开诸圣眼，几多骐骥困盐车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释仲安","text":"百丈堂前辨野狐，紫罗帐里撒真珠。\n谁家别馆池塘里，一对鸳鸯水上浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"润州","author":"仲殊","text":"北固楼前一笛风，断云飞出建昌宫。\n江南二月多芳草，春在濛濛细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花","author":"仲殊","text":"水中仙子并红腮，一点芳心两处开。\n想是鸳鸯头白死，双魂化作好花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望湖亭","author":"仲殊","text":"凝华浮藻五云间，下压凌虚万象闲。\n湖水际天天欲尽，落霞照出洞庭山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题君山洗心堂","author":"仲殊","text":"朝随初日上烟沙，极望淮南不见涯。\n今日江东寒食节，春閒桃李自开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李伯时支遁相马图","author":"仲殊","text":"月窟精神不受羁，白云野老太支离。\n当时若也无人识，骏骨灵心各自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中峰","author":"仲殊","text":"聚远最高亭，登临喜倍增。\n贪陪青眼客，不见白头僧。\n闭户三十载，压云千万层。\n龙珠弹落处，一点白莲灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京口怀古 其二","author":"仲殊","text":"一昨丹阳王气销，尽将豪侈谢尘嚣。\n衣冠不复宗唐代，父老犹能道晋朝。\n万岁楼边谁唱月，千秋桥上自吹箫。\n青山不与兴亡事，只共垂杨伴海潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄左丞席上作","author":"仲殊","text":"瑞麟香暖玉芙蓉，画蜡凝辉到晓红。\n数点漏移衙仗北，一番雨滴甲楼东。\n梦游黄阙鸾巢外，身卧彤帏虎帐中。\n报道谯门初日上，起来帘幕杏花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题玉泉","author":"仲殊","text":"分出瑶池万怪惊，昆墟引落最高层。\n十分清是泉中玉，一漱寒生齿下冰。\n净照更无云影杂，素光疑有露华凝。\n莫教明月从中现，澈底无心伴老僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题翠麓亭","author":"仲殊","text":"素虬盘屈走灵泉，槲叶涂红作画船。\n幡转玉绳光影旋，杯衔金镜酒痕圆。\n篆形綵字方传世，星落光缠忽下天。\n远想螭蟠殊未若，小图河曲宛依然。\n缓浮松酿环云际，不动兰桡到席边。\n上巳浮恩非此日，山阴盛事掩多年。\n从欢未省向尊俎，屡酒何尝议圣贤。\n翰墨主人今独步，双鹅应复降飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"破山光明庵","author":"仲殊","text":"身是光明幢，语是光明经。\n光明聚不散，妙有成真形。\n示现三界前，何劳问丹青。\n坐断龙斗山，宝月孤亭亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"仲殊","text":"凉生宫殿不因秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上苏子瞻","author":"释仲渊","text":"文章落落昌黎老，风物萧萧李谪仙。\n二子本来为独擅，使君才力已双全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石岩花","author":"释仲皎","text":"朱英历历烁晴空，过了花间几信风。\n明日画栏供徙倚，却须有句到芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王性之梅花 其一","author":"释仲皎","text":"白玉丛边碧玉流，见花无复为花羞。\n春风细雨溪山路，洗尽去年今日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王性之梅花 其二","author":"释仲皎","text":"春到寒林雪得知，雪中谁解认芳姿。\n溪山飞上一轮月，香满风前独立时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹","author":"释仲皎","text":"玉棱金线晓妆寒，妙入天工不可干。\n老去只知空境界，浅红深紫梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪作望剡溪","author":"王铚","text":"玉楼琼树晓烟披，拥衲开门四望迷。\n清旷世人谁似我，雪中更到子猷溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静林寺古松","author":"释仲皎","text":"古松古松生古道，枝不生叶皮生草。\n行人不见树栽时，树见行人几回老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东白山轩","author":"释仲皎","text":"竹外泉声急，松心月色寒。\n人间推旷绝，只自倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题西白山齐云阁","author":"释仲皎","text":"山云吹断路头开，此处疑穿月胁来。\n怪底行人看碧落，笑谈容易作风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归云亭","author":"释仲皎","text":"一从飞出岫，舒卷意何长。\n作雨遍天下，乘风归帝乡。\n无心怜洒落，到处自清凉。\n缥缈来空碧，吟边带夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归鸿阁","author":"释仲皎","text":"精舍傍修岭，道心随眼明。\n山遗僧偃迹，水作剡溪声。\n无雨竹亦润，有风松更清。\n上方真可住，不用触归情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀剡川故居 其三","author":"释仲皎","text":"病日飞蝇鬓雪乾，欲扶吾道愧衰残。\n把他杓柄力何倦，还我钁头心便安。\n待摘菜花添午供，便裁荷叶备春寒。\n不辞高卧烟霞里，枕上青山最好看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀剡川故居 其二","author":"释仲皎","text":"断雪流水古岩隈，忆得柴门半扇开。\n雪打子猷船上过，春从灵运屐边来。\n逃禅野榻排芳草，觅句寒崖扫落苔。\n容易三年抛绝去，不胜啼月晓猿哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀剡川故居 其一","author":"释仲皎","text":"烟光流转太骎骎，又见春山换绿阴。\n蝴蝶梦中新岁病，杜鹃声里故乡心。\n焦桐冷却风三尺，瘦竹拖来月一寻。\n早晚掉头归小隐，诛茅千嶂白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东白山啸猿亭","author":"释仲皎","text":"放意在林表，飘然更自由。\n挂烟群木冷，啼月一山秋。\n袅袅清风里，凄凄碧涧头。\n三声融妙听，行客若为愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题西白山观雪","author":"释仲皎","text":"西白名山处，那堪踏雪观。\n四围银世界，一色玉峰峦。\n夜色和天冷，清辉放月寒。\n溪梅初一二，著意为渠看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧入三峰","author":"释仲皎","text":"上人瞿昙裔，律身玉无瑕。\n力究毗尼论，汪汪海无涯。\n振锡复何许，三峰隐苍霞。\n堂上大道师，灵芝发根芽。\n相见涌法施，鼕鼕鼓声挝。\n上人从之游，勿惮岁月遐。\n坐待霜露熟，香风散天葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庵居 其一","author":"释仲皎","text":"啼切孤猿晓更哀，柴门半掩白云来。\n山童问我归何晚，昨夜梅花一半开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释仲皎","text":"未飞三日雪，却报一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释休","text":"恰如刽子气雄豪，便向咽喉下一刀。\n五脏肝心皆砉出，方知王法不相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释休","text":"结夏时左眼半斤，解夏时右眼八两。\n谩云九十日安居，赢得一肚皮妄想。\n直饶七穴八穿，未免山僧拄杖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释休","text":"风动邪，幡动邪，风鸣邪，铃鸣邪。\n非风铃鸣，非风幡动。\n此土与西天，一队黑漆桶。\n诳惑世间人，请看灭胡种。\n山僧不奈何，趁后也打鬨。\n瓠子曲弯弯，冬瓜直儱侗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三首 其一","author":"释先","text":"小林三拜得吾髓，鹫岭拈花一笑新。\n莫谓藏身无影迹，月明照见夜行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三首 其三","author":"释先","text":"十二月初一，岁事将周毕。\n腊月火烧山，旱雷轰霹雳。\n瞌睡师僧惊觉来，三九依前二十九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三首 其二","author":"释先","text":"三转法轮于大千，其轮本来常清净。\n若能奉持速取證，急急如律令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释光祚","text":"东家李四婆，西家来乞火。\n门外立少时，嗔他停滞我。\n恶发走归家，虚心屋里坐。\n可怜群小儿，终日受饥饿。\n有眼不点睛，空锁髑髅破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释兴道","text":"同云欲雪未雪，爱日似晖不晖。\n寒雀啾啾闹篱落，朔风冽冽舞帘帷。\n要会韶阳亲切句，今朝觌面为提撕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武丘寺","author":"释兴肇","text":"高僧危阁侵云际，尽日披襟濯好风。\n极目长川人不见，万株烟树接遥空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎丘","author":"释兴肇","text":"沧海何年涌，秦传虎踞丘。\n池空剑光冷，坟缺鬼吟愁。\n石碍楼台仄，烟深草木稠。\n吴人贪胜概，春尽亦来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三十","author":"释如本","text":"问来答去无偏党，铁壁银山作么通。\n纵夺临机言话堕，遂令千古动悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十九","author":"释如本","text":"一波才动众波随，汩没尘寰几个知。\n突兀须弥横宇宙，纵横妙用更由谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十八","author":"释如本","text":"北斗藏身句，商量几万般。\n贪观天上月，谁觉骨毛寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十七","author":"释如本","text":"须弥座上敛伽黎，海口潮音阐大机。\n世主大檀能藻鉴，灵山嘉会愈增辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十六","author":"释如本","text":"宝寿开堂推出僧，棒头有眼要分明。\n满城人瞎谁能晓，今古清风匝地生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十五","author":"释如本","text":"亲儿弃了复何言，月在波心印碧天。\n独有一身无系累，困眠醒坐任随缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十四","author":"释如本","text":"一喝惊天动地雷，海翻太华洞然开。\n岩头胆丧魂飞也，谩道当时手搦抬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十一","author":"释如本","text":"大方独立峭巍巍，八面玲珑万象围。\n正坐当轩无位位，圆通无碍应群机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十","author":"释如本","text":"不出漫漫草路遮，出门犹更隔天涯。\n回机踏著通霄路，何处青山不是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十九","author":"释如本","text":"似锦桃花满树红，灵云一见便心空。\n当时不遇玄沙老，争得名喧宇宙中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十七","author":"释如本","text":"狗子无佛性，慈悲似海深。\n寻言逐句者，埋没丈夫心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十六","author":"释如本","text":"西来祖意问如何，柏树庭前指似他。\n射虎不真徒没羽，至今天下有誵讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十五","author":"释如本","text":"台山古路是人游，个个寻婆问路头。\n堪笑赵州才勘破，寥寥千古使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十四","author":"释如本","text":"草户柴门谢子来，躬身下拜笑眉开。\n深深密密亲分付，莫道宝山空手回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十三","author":"释如本","text":"特来设粥誇英俊，那知王老更风流。\n打破粥锅呈丑拙，狸奴白牯一齐收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十二","author":"释如本","text":"净瓶踢倒赢山子，体用全彰迈古今。\n洞彻玄关垂手处，到头须是遇知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十一","author":"释如本","text":"大庾岭头功德成，谩言点眼访知音。\n红炉片雪明端的，象外风光照古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十","author":"释如本","text":"南泉麻谷与归宗，道眼元来总不通。\n去礼国师瞻相好，区区只到半途中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其八","author":"释如本","text":"威音王佛是儿孙，王老当时开大言。\n黄檗见机分主伴，典刑千古定宗门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其五","author":"释如本","text":"达磨西来未足誇，少林捏目强生花。\n得皮得髓徒分别，妙性圆明本不差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其四","author":"释如本","text":"草衣木食道人高，传得金襕意气豪。\n此外已知无别法，刹竿倒处累儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三","author":"释如本","text":"一花拈起便承当，正眼传来不覆藏。\n今古流通无间断，枝枝叶叶尽芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二","author":"释如本","text":"殃崛雄雄方勇锐，瞿昙住住息风波。\n杀人作佛当头劄，覆雨翻云在刹那。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其一","author":"释如本","text":"才出胞胎便逸群，周行七步独称尊。\n当时若见云门老，不到如今累子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十二","author":"释如本","text":"小释迦，大文殊。\n闻名号，任称呼。\n藤条在握不能用，被他碧眼谩涂糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十八","author":"释如本","text":"面门出入每相见，日月由来不识真。\n海岳惯游知己少，反身归卧岭头云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其九","author":"释如本","text":"斩了猫儿问谂师，草鞋头戴自知时。\n两堂不是无言对，只要全提向上禨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其七","author":"释如本","text":"百丈野狐，两耳卓朔。\n脱兮不昧，堕兮不落。\n不昧不落，何是何错。\n若于当处不留情，万里晴空步寥廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其六","author":"释如本","text":"日面月面，灵光洞现。\n大地山河，南州北县。\n虽是老婆心切，那知疑杀监院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三十一","author":"释如本","text":"匙挑不上，箸拨不开。\n合掌赞言，善哉善哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]