[{"title":"游天休观道流索诗","author":"李宏","text":"霓旌羽盖下飞仙，名揭司真列洞天。\n一派银河悬落水，数峰石壁锁霏烟。\n潭心雷殷龙应出，井口风回虎未旋。\n端欲相从老岩壑，凌云已觉意飘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿秋霜阁方丈","author":"李宏","text":"青山夭矫虬龙蟠，溪流泻竭滩声乾。\n履霜未落秋尚早，夜半已作貂裘寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和吕居仁泾县旌德道中见寄三首 其一","author":"李宏","text":"笋舆破晓踏新霜，千里调安远办装。\n会约明年追胜集，茱萸细把记重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和吕居仁泾县旌德道中见寄三首 其二","author":"李宏","text":"山环杰阁染深绿，石吐寒泉蹙浪花。\n一夜秋霜不成寐，感时忧国思无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和吕居仁泾县旌德道中见寄三首 其三","author":"李宏","text":"赏溪漱玉声湍激，石壁参天路阻长。\n准拟解鞍能过我，新泉活火茗瓯香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈村道中","author":"李宏","text":"笋舆乘晚上，诘曲过前冲。\n石怪形难似，山深不计重。\n乱流奔绝壑，险径蹑危峰。\n重难为农苦，辛勤更岁凶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其一","author":"释清了","text":"不假千头说，炽然无闲歇。\n深密密处光彩顿生，明历历时混融皎洁。\n若也和身放倒，随流任真。\n始信百般计较不成，运用本无欠缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二","author":"释清了","text":"傍参密旨，妙会玄宗。\n句在混沌前，岂涉今时路。\n在无舕人解语，无情者皆闻。\n通途消耗不分时，灵脉浩流无闲处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其三","author":"释清了","text":"暗里抽横骨，弥天句已彰。\n明中坐舌头，匝地无纹彩。\n混不容其迹，照不留其痕。\n金乌子夜出乾坤，浓云停午生岳面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其四","author":"释清了","text":"穷微丧本，体妙失宗。\n一句截流，渊源及尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其五","author":"释清了","text":"粗中辨细，门里出身。\n石女不孤，机梭暗泄。\n细中辨粗，身里出门。\n暖气虽消岩上雪，冰壶未破劫前春。\n六门活计冷翛然，万顷琉璃寒彻骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其六","author":"释清了","text":"居动而常寂，处暗而愈明。\n不堕二边机，当头谁敢触。\n正按傍提有据，真慈妙应无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其七","author":"释清了","text":"虚玄及尽，见处偏枯。\n明湛不摇，想中渗漏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其八","author":"释清了","text":"藏身处，没踪迹，浩意融时谁辨的。\n没踪迹处莫藏身，蓦移步处妙难寻。\n枯根石里花明秀，劫外威光密密新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其九","author":"释清了","text":"无功妙旨，不涉玄徽。\n一念潜通，全机密运。\n易奏高山流水曲，难传虚空夜明符。\n暗中灵句许谁知，化外威光须自看。\n不行青嶂路，争到白云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十","author":"释清了","text":"家音历历，的要难通。\n绍了非功，忘其担荷。\n户上有动从断径，坐中无照胜燃灯。\n既知活计现成，便合深沈消耗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十一","author":"释清了","text":"刹尘一扫，大小量空，念劫两融。\n前后际断，不离当处，圆应无穷。\n安住是中，周施不怠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十二","author":"释清了","text":"未休休去，未歇歇去。\n豁然宝镜当台，无限清光满户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十三","author":"释清了","text":"莫怪石头饶舌，便道灵源明皎洁。\n功成照不失虚，妙尽明无间歇。\n如今果尔难藏，尽逐秋光漏泄。\n为报海内道人，参取个中时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十四","author":"释清了","text":"披毛游火聚，焰里藏身；戴角混尘泥，光中转步。\n灵珠绝点，卞玉无瑕。\n一念廓融，千机秀发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十五","author":"释清了","text":"里许明如日，丝毫无隔碍。\n一灵不假胞胎，四大孰为主宰。\n如今彻底露堂堂，运用随缘常自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十六","author":"释清了","text":"终日分别，只是分别自心。\n堪笑念彼观音力，毕竟还著于本人。\n黄头老衲，有理难伸。\n为什么有理难伸，贼是家亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十七","author":"释清了","text":"雨洗摩尼增秀色，全身不昧一丝头。\n灵源倾泻无闲歇，添得滁山水逆流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十八","author":"释清了","text":"沿流无定止，真照不留踪。\n千峰秀处鹤难栖，万水澄时鱼自稳。\n樵人罢赏，钓客迷巢，古渡深云，同歌绝韵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其十九","author":"释清了","text":"日月镇长灵，古今常不改。\n如何特地新，各要施三拜。\n及尽无依体自玄，双六盆中休喝彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十","author":"释清了","text":"机回明位，妙尽转身。\n一梦青山，满船白月。\n子夜云收碧汉，中秋露混银河。\n芦花深处蓦相逢，谈笑饮茶无处避。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十一","author":"释清了","text":"百亿毛头，花开不犯春风。\n三冬雪里，争芳全彰浩意。\n云凝谷晓，滴水冰生。\n活计现成，凭谁受用。\n头上青灰三五斗，明明不堕晓来机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十二","author":"释清了","text":"祇恁么，休寻觅，见成堂堂忘得失。\n假使心通无量时，历劫何曾异今日。\n圣僧堂里坐，金刚门外立。\n广长舌相耀乾坤，半夜乌飞白如漆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十三","author":"释清了","text":"运步不当机，个中无肯路。\n明密浩难齐，未前超佛祖。\n及尽回途恁么来，撒手相逢无回互。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十四","author":"释清了","text":"旨外明宗，玄中辨的。\n古帆不挂，洞水逆流。\n黄芦渡口奏阳春，偃月城头吹画角。\n岂止异苗繁茂，须知别有圆音。\n更休烂炒浮沤，便请乘时撒手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十五","author":"释清了","text":"纯清绝点，似镜长明。\n照不失虚，万像体妙。\n细中之细，雪尽冰消。\n功就之功，任运现成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十六","author":"释清了","text":"世尊有密语，古渡春残。\n迦叶不覆藏，落花流水。\n见闻觉知绝，四维上下通。\n玉凤舞中霄，金轮舒半夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十七","author":"释清了","text":"幻灭灭故，非幻不灭。\n光无不透，明无不彻。\n长歌吹起棹头风，永夜恣眠篷底月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十八","author":"释清了","text":"虚而灵，寂而妙。\n明密浩然，犹落鉴照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十九","author":"释清了","text":"道得第一句，不被拄杖子瞒。\n识得拄杖子，犹是途中事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答佛果颂","author":"释清了","text":"运用堂堂本妙，彻底不落鉴照。\n一言及尽锋铓，只个更无孔窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠祥云庵主颂","author":"释清了","text":"相逢相揖眼如眉，百鸟衔花尚未归。\n回首春风吹梦断，旧山云散月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其一","author":"释清了","text":"兀兀不忘机巧，灰来已得纯。\n虚明无间断，净妙绝疏亲。\n密户寒灯晓，灵花古洞春。\n回途赓雪韵，门里绿苔新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其二","author":"释清了","text":"湛寂凝然透，孤明彻底空。\n秋风生古韵，晓月上寒松。\n量外千差泯，机前六用通。\n应缘成底事，毕竟不留踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其三","author":"释清了","text":"意句难分别，风骚格外求。\n提刀空四顾，驻步失全牛。\n落眼情尘脱，归根景象幽。\n万缘俱不到，佛祖莫能酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其四","author":"释清了","text":"彻澄无凝碍，情尘迥脱然。\n全机忘照外，一句未分前。\n枯木云笼透，寒潭月夜圆。\n回头开正眼，芳草破春烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其五","author":"释清了","text":"只么堆堆地，常光密露时。\n玄途明绝朕，妙体廓忘依。\n正去功中转，傍来晓路归。\n丝毫都及尽，不觉口如眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其六","author":"释清了","text":"绝点纯清处，由来是半提。\n虚空休照镜，混沌莫妆眉。\n隐隐忘兼带，寥寥罢晓机。\n雪消寒谷暖，花笑不萌枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其七","author":"释清了","text":"不犯清波句，澄江涵一钩。\n棹头忘一色，功尽丧全机。\n密混凝流处，融通向背时。\n古帆风静夜，任运应高低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其八","author":"释清了","text":"密密梭头事，机丝不挂时。\n木鸡啼晓户，石女夜生儿。\n已发寒灰焰，难埋古冢碑。\n荒郊春草绿，风暖共依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其九","author":"释清了","text":"鸟道通身去，迢迢劫外参。\n随流忘朕兆，痴兀未曾闲。\n瞬视成途辙，扬眉落二三。\n只应无见顶，子夜白云漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释清了","text":"寒明一点堕空林，朕兆依俙已触今。\n目击正容成渗漏，青天白日转迷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释清了","text":"乾坤那畔类难齐，千圣从来不识伊。\n家破人亡迷肯重，夜深寒塔影空垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四首 其三","author":"释清了","text":"万缘歇尽照无时，撒手忘依有路归。\n劫外一壶春色暖，灵苗石上正芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四首 其四","author":"释清了","text":"线道难分处，须知不是伊。\n牛头按尾上，岂借大阳辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣和癸卯宴坐自赞","author":"释清了","text":"三十六年作怪，撞入者个皮袋。\n一千七百衲僧，被你热瞒忒煞。\n如今坐断舌头，直下大千俱坏。\n劫外迢迢晓末明，休把虚空妆五彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞","author":"释清了","text":"信口胡说，七差八错。\n万劫千生，不妨快活。\n情愿生形形色色轮回，肯求诸圣解说。\n谁言遍界没遮栏，雨过青山云一抹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释清了","text":"天晓浓霜白，依然境末分。\n出门无所辨，华鸟寂无闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释清了","text":"离钩三寸如何道，驻拟还同眼里沙。\n篷底月明载归去，劫前风韵落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释清了","text":"问佛分明答惠超，半斤八两不合相饶。\n丛林万古为殃祸，恶语伤人恨不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠清了颂","author":"释佛果","text":"宣化渡头作别，譬如两镜相照。\n何止千里同几百个，全是向上一窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"蔡伸","text":"山水同三峡，烟霞似十洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕范贤良游天王寺登城晚归三绝 其一","author":"楼炤","text":"帝城高堞建朱旗，号召征人厚古陴。\n祇是北风关隘重，纷纷策士说匡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕范贤良游天王寺登城晚归三绝 其二","author":"楼炤","text":"花柳逢春色自妍，天王宫殿五云边。\n署郎漫入招提境，不是探玄学慕仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕范贤良游天王寺登城晚归三绝 其三","author":"楼炤","text":"日落园林淡荡风，晚云参错若相攻。\n分明阵势天边列，诸葛神谋一望中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其一","author":"吴顺之","text":"尧舜垂衣明日月，皋夔论道际风云。\n须知天地生成德，间世真儒辅圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其二","author":"吴顺之","text":"南北通和自古无，如今万里混车书。\n传闻每遣皇华使，外国人争问起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其三","author":"吴顺之","text":"德望岩岩鲁太山，功成天地亦清闲。\n不须百丈磨崖刻，碑在农桑乐业间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其四","author":"吴顺之","text":"西风原上拨黄云，归作人间瓮里春。\n拍手一樽歌既醉，闾阎俱是太平民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其五","author":"吴顺之","text":"老农含笑指家丁，偃伯灵台始见生。\n身手只今大如许，耳根不识鼓鼙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其六","author":"吴顺之","text":"年年周孔道何多，谁为缁黄保不磨。\n却笑纷纷韩孟辈，空言无奈异端何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其七","author":"吴顺之","text":"当年崧岳降生申，底事先春五日期。\n要是穷冬正冰雪，斡回和气遍华夷。\n群生无路答升平，只有年年善颂声。\n长愿遥天无点翳，台星两两倍光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其八","author":"吴顺之","text":"下吏南州把郡符，除恩犹未放江湖。\n诞辰再拜无他祝，愿献蓬莱清浅图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师 其九","author":"吴顺之","text":"万古丛中见玉英，天教正味合和羹。\n枝头春色无穷在，乞与年年荐寿觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杼峰","author":"汪勃","text":"夏后峰前思盛业，鲁公亭畔忆孤忠。\n吴兴胜地东南会，震泽嵎山在眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤巢山 其一","author":"王蕃","text":"古邑荒凉瞰小溪，青山高与白云齐。\n凤凰飞去巢阿阁，未肯重来觅故栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤巢山 其二","author":"王蕃","text":"凤凰飞去听箫韶，燕雀群飞想见嘲。\n记取旧时栖止处，莫教鹰隼误来巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"政和壬辰留题石鱼","author":"王蕃","text":"冬旱江成渚，维鱼记石棱。\n滋濡春遂足，狼戾岁将□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"王蕃","text":"南亩桑麻无旧户，西园桃李变新栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]