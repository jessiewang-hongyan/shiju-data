[{"title":"清风短吟","author":"邵雍","text":"清风兴况未全衰，岂谓天心便弃遗。\n长具斋庄缘读易，每惭疏散为吟诗。\n人间好景皆输眼，世上闲愁不到眉。\n生长太平无事日，又还身老太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逸书吟","author":"邵雍","text":"丹山谁道凤为巢，事下吾能见九苞。\n逸句得时如虎变，大篇成处若神交。\n千端蜀锦新番样，万树春华暖弄梢。\n天马无踪周八极，但临风月镫相敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"随缘吟","author":"邵雍","text":"得路青霄正好冲，休贪粮稻恋深笼。\n要无为后须还朴，好自由时莫厌穷。\n百计用心终上错，一场大梦到头空。\n生涯澹澹随缘过，未肯将身入彀中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜老吟","author":"邵雍","text":"几何能得鬓如丝，安用区区镊白髭。\n在世上官虽不做，出人间事却能知。\n待天春暖秋凉日，是我东游西泛时。\n多少宽平好田地，山翁方始会开眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜春吟","author":"邵雍","text":"春至已将诗探伺，春归更用酒追寻。\n酒因春至春归饮，诗为花开花谢吟。\n花谢花开诗屡作，春归春至酒频斟。\n情多不是彊年少，和气冲心何可任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"插花吟","author":"邵雍","text":"头上花枝照酒卮，酒卮中有好花枝。\n身经两世太平日，眼见四朝全盛时。\n况复筋骸粗康健，那堪时节正芳菲。\n酒涵花影红光溜，争忍花前不醉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山三首 其三","author":"邵雍","text":"乐则行之忧则违，大都知命是男儿。\n至微功业人难必，尽好云山我自怡。\n休惮烟岚虽远处，且乘筋力未衰时。\n平生足外更何乐，富贵荣华过则悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山三首 其二","author":"邵雍","text":"春尽登临正得宜，人情天气两融怡。\n泛舟伊水风回夜，垂钓溪门月上时。\n逸兴剧凭诗放肆，病躯唯仰酒扶持。\n浮生日月无多子，忍向其间更敛眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山三首 其一","author":"邵雍","text":"城邑久居心自倦，闉阇才出眼先明。\n龙门看尽伊川景，女几听残洛水声。\n太室观馀红日旭，天坛望罢白云生。\n此身已许陪真侣，不为锱铢起重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游龙门","author":"邵雍","text":"江天无少异，幽鸟下晴沙。\n路去山形断，川回渡口斜。\n龛岩千万穴，店舍两三家。\n清景四时好，都城况不赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洛川初出厚载门","author":"邵雍","text":"初出都门外，西南指洛陬。\n山川开远意，天地挂双眸。\n村落桑榆晚，田家禾黍秋。\n民间有此乐，何必待封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登女几","author":"邵雍","text":"予看山多矣，未尝逢此奇。\n巨崖如格虎，险石若张旗。\n云意闲舒卷，岩形屡改移。\n丹青难状处，四面尽如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登朝元阁","author":"邵雍","text":"绣岭岌层峦，岧峣十九盘。\n微微经雨后，杳杳出云端。\n往事金舆远，遗踪玉像残。\n至今临渭水，依旧见长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登嵩顶","author":"邵雍","text":"九州环绕若棋枰，万岁嵩高看太平。\n四海有人能统御，中原何复有交争。\n长忧眼见奸雄辈，且愿身为尧舜氓。\n五十三年芜没事，如今方喜看春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人乞碧芦","author":"邵雍","text":"草有可嘉者，莫将萧艾俦。\n扶疏全类竹，苍翠特宜秋。\n风雨声初入，江湖思莫收。\n无功济天下，藉此一淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人见寄","author":"邵雍","text":"鬓毛不患渐成霜，有托琴书子一双。\n既乏长才康盛世，无如高枕卧南窗。\n明知筋力难为强，犹说云山未树降。\n多谢故人相爱甚，辙鱼幸免困西江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人放言","author":"邵雍","text":"经时不见意何如，重出新诗笑语初。\n物理悟来添性淡，天心到后觉情疏。\n已全孟乐君无限，未识蘧非我有馀。\n大率空名如所论，此身甘老在樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人语名教","author":"邵雍","text":"开辟而来世教敷，其间雄者号真儒。\n修身有道名先觉，何代无人达奥区。\n焕若丹青经史义，明如日月圣人途。\n鲰生涵泳虽云久，天下英才敢厚诬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答友人劝酒吟","author":"邵雍","text":"人人谁不愿封侯，及至封侯未肯休。\n大得却须防大失，多忧元只为多求。\n规模焉敢比才士，度量自知非饮流。\n少日何由能强此，况今年老雪堆头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答任开叔郎中昆仲相访","author":"邵雍","text":"竹影战棋罢，闲思安乐窝。\n旷时称不见，联辔幸相过。\n宠莫兼金比，褒逾华衮多。\n从来有诗癖，使我遂成魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答会计杜孝锡寺丞见赠","author":"邵雍","text":"四方多善人，予善未毫分。\n有意空求志，无功漫爱君。\n闲行观止水，静坐看归云。\n老向太平里，朝廷正右文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答李希淳屯田","author":"邵雍","text":"逢时虽出欲胡为，其那天资智识微。\n弊性止堪同蠖屈，薄才安敢望鹏飞。\n长因访旧欢无极，每为寻幽暮不归。\n花爱半开承露看，奈何花上露沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答客","author":"邵雍","text":"人间相识几无数，相识虽多未必知。\n望我实多全为道，知予浅处却因诗。\n升沉休问百年事，今古都归一局棋。\n乘马须求似骐骥，奈何骐骥未来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答客问病","author":"邵雍","text":"世上重黄金，伊予独喜吟。\n死生都一致，利害漫相寻。\n汤剂功非浅，膏肓疾已深。\n然而犹灼艾，用慰友朋心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花短吟","author":"邵雍","text":"满园桃李正离披，更被狂风非意吹。\n长是忧愁初谢处，却须思念未开时。\n奈何红艳易消歇，不似青阴少改移。\n九十日春都去尽，樽前安忍更颦眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人惠笔","author":"邵雍","text":"爱重寄文房，慇勤谢远将。\n兔毫刚且健，筠管直而长。\n静录新诗稿，闲抄旧药方。\n自馀无所用，足以养锋铓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢寿安县惠神林山牒","author":"邵雍","text":"西南有山高崔嵬，乱峰围绕如蓬莱。\n中间有地可容足，泉甘木茂无尘埃。\n诸君之意一何厚，协谋判给如风雷。\n天津八月水波定，便可乘查观一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢圆益上人惠诗一卷","author":"邵雍","text":"览公诗十首，起我意何多。\n似药驱疑疾，如茶涤睡魔。\n月当松皎洁，山隔水嵯峨。\n明日如无事，天津可再过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢富丞相招出仕二首 其二","author":"邵雍","text":"欲遂终焉老闲计，未知天意果如何。\n几重轩冕酬身贵，得似云山到眼多。\n好景未尝无兴咏，壮心都已入消磨。\n鹓鸿自有江湖乐，安用区区设网罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢富丞相招出仕二首 其一","author":"邵雍","text":"相招多谢不相遗，将谓胸中有所施。\n若进岂能禁吏责，既闲安用更名为。\n愿同巢许称臣日，甘老唐虞比屋时。\n满眼清贤在朝列，病夫无以系安危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢富相公见示新诗一轴 其一","author":"邵雍","text":"通衢选地半松筠，元老辞荣向盛辰。\n多种好花观物体，每斟醇酒发天真。\n清朝将相当年事，碧洞神仙今日身。\n更出新诗二十首，其间字字敌阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁恨吟","author":"邵雍","text":"城里住烟霞，天津小隐家。\n经书为事业，水竹是生涯。\n恨为云遮月，愁因风损花。\n恨愁花月外，何暇更知他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新正吟","author":"邵雍","text":"蘧瑗知非日，宣尼读易年。\n人情止于是，天意岂徒然。\n立事情尤倦，思山兴益坚。\n谁能同此志，相伴老伊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春吟","author":"邵雍","text":"多病筋骸五十二，新春犹得共衔杯。\n践形有说常希孟，乐内无功可比回。\n燕去燕来徒自苦，花开花谢漫相催。\n此心不为人休戚，二十年来已若灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睢阳五老图","author":"邵雍","text":"政事浑如春梦闲，人情嚣薄恶儒冠。\n四朝遗列承平日，两世观风树大桓。\n经济安民心不晦，保全传嗣骨无寒。\n乾元恰似诸公意，符节还同一揆看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锦屏春吟","author":"邵雍","text":"锦屏山下有家园，每岁家园过禁烟。\n早是三春天气好，那堪百里主人贤。\n同于一派水边饮，醉向万株花底眠。\n明日归鞍遂东指，上阳风景更暄妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春吟","author":"邵雍","text":"许大春工造物华，一场狼藉但堪嗟。\n群芳委尽绿阴密，游骑去残红日斜。\n台上喧呼成蝶梦，眼前零落空杨花。\n人间万事卒如此，□□庄□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春寄李审言龙图","author":"邵雍","text":"年年长是怕春深，每到春深病不任。\n伤酒情怀因小会，养花天气为轻阴。\n岁华易革向来事，节物难回老去心。\n唯有前轩堪静坐，临风想望旧知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"演绎吟 其一","author":"邵雍","text":"万事入沈吟，其来味更深。\n虽然曾过眼，须是更经心。\n过眼未尽见，经心肯尽寻。\n尽寻能得见，方始是真金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"演绎吟 其三","author":"邵雍","text":"何者谓知音，知音只在心。\n肝脾无效验，钟鼓漫搜寻。\n既若能开物，何须更鼓琴。\n来仪非为凤，只是感人深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"演绎吟 其二","author":"邵雍","text":"何者是真金，真金入骨沈。\n饱曾经煅鍊，足得不沈吟。\n到手何须眼，行身敢放心。\n放心然后乐，天下有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静乐吟","author":"邵雍","text":"和气四时均，何时不是春。\n都将无事乐，变作有形身。\n静把诗评物，闲将理告人。\n虽然无鼓吹，此乐世难伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题留侯庙","author":"邵雍","text":"灭项兴刘如覆手，绝秦昌汉若更棋。\n卷舒天下坐筹日，锻鍊心源辟谷时。\n黄石公传皆是用，赤松子伴更何为。\n如君才业求其比，今古相望不记谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂即事","author":"邵雍","text":"川上数峰青，林间一水明。\n闲云无定体，幽鸟不知名。\n游侣既非约，归期莫计程。\n锱铢人世事，休强作威狞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪吟","author":"邵雍","text":"事体一番新，才新又却陈。\n新陈非利物，义理不由人。\n岁月休惊晚，莺花续报春。\n馀樽幸无恙，宜唱鹧鸪频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪吟二首 其二","author":"邵雍","text":"翠竹丛深啼鹧鸪，鹧鸪声更胜提壶。\n江南江北常相逐，春后春前多自呼。\n迁客销魂惊梦寐，征人零泪湿衣裾。\n愁中闻处肠先断，似此伤怀禁得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪吟二首 其一","author":"邵雍","text":"人间重者是黄金，谁道黄金无处寻。\n不著闲辞文雅意，更将何事悦良心。\n远山四面供清润，幽鸟千般送好音。\n无限春光都去尽，请君听唱鹧鸪吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮自贻","author":"邵雍","text":"当年志意欲横秋，今日思之重可羞。\n事到强图皆屑屑，道非真得尽悠悠。\n静中照物情难隐，老后看书味转优。\n谈麈从容对宾客，荐章重叠误公侯。\n已蒙贤杰开青眼，不顾妻孥怨白头。\n谷口郑真焉敢望，寿陵馀子若为谋。\n鼎间龙虎忘看守，棋上山河废讲求。\n一枕晴窗睡初觉，数声幽鸟语方休。\n林泉好处将诗买，风月佳时用酒酬。\n三百六旬如去箭，肯教襟抱落闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苍苍吟寄答曹州李审言龙图","author":"邵雍","text":"一般颜色正苍苍，今古人曾望断肠。\n日往月来无少异，阳舒阴惨不相妨。\n迅雷震后山川裂，甘露零时草木香。\n幽暗岩崖生鬼魅，清平郊野见鸾凰。\n千花烂为三春雨，万木凋因一夜霜。\n此意分明难理会，直须贤者入消详。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和商守宋郎中早梅","author":"邵雍","text":"山南地似岭南温，腊月梅开已浃辰。\n耻与百花争俗态，独殊群艳占先春。\n角中飘去凄于骨，笛里吹来妙入神。\n秀额妆残黏素粉，画梁歌暖起轻尘。\n宰君惜艳献州牧，太守分香及野人。\n手把数枝重叠嗅，忍教芳酒不濡唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苔钱","author":"邵雍","text":"一雨一番新，非关鼓铸频。\n纵多难赠客，便失不猜人。\n遍地未为富，满阶那济贫。\n买愁须有为，酤酒断无因。\n散处如筹计，重时似索陈。\n不能赒己急，何暇更赒亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春水长吟","author":"邵雍","text":"春在水自渌，春归渌遂休。\n清非不逮渌，春奈胜于秋。\n渌向阳中得，清于冷上求。\n加于清一等，用是渌为优。\n薄薄冰初泮，微微雨乍收。\n渺瀰新岛屿，潋滟旧汀洲。\n荷芰低犹卷，菰蒲嫩已抽。\n蘋蘩虽渐出，藻荇未全稠。\n日暖鸳鸯浴，烟晴翡翠游。\n波平跃双鲤，风静戏群鸥。\n西蜀遨争举，东瓯禊竞修。\n武陵花再识，汉曲佩还投。\n台下溶溶过，堤边漫漫流。\n槛前才泚泚，天外更悠悠。\n泛滥情怀恶，潺湲意思幽。\n远山遮不断，别浦去难留。\n二月溪桥畔，三吴野渡头。\n依前横两桨，特此送孤舟。\n画手方停笔，骚人正倚楼。\n长江飞絮外，只是动离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清风长吟","author":"邵雍","text":"宇宙中和气，清泠无比方。\n与时蠲疾病，为岁造丰穰。\n起自青蘋末，来从翠树傍。\n得逢明月夜，便入故人乡。\n密叶摇重幄，殷花舞靓妆。\n两三声迥笛，千万缕垂杨。\n细度丝桐韵，深传兰蕙香。\n楼台临远水，轩槛近脩篁。\n盛夏驱烦暑，初晴送晚凉。\n轻披绿荷芰，缓透薄衣裳。\n浪走翻翩袂，波生潋滟觞。\n闲愁难著莫，幽思易飞扬。\n快若乘天马，醒如沃蔗浆。\n面前游阆苑，坐上泛潇湘。\n不可将钱买，焉能用斗量。\n依凭全藉德，收贮岂须仓。\n无患兼并取，宁忧寇盗攘。\n以兹为乐事，未始有忧伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一春吟","author":"邵雍","text":"一春九十日，风雨占几半。\n花好不成观，心狂未能按。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十日到城中见交旧","author":"邵雍","text":"年年此际走烟岚，人亦何尝谓我贪。\n归见交亲话清胜，且无防患在三缄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人玉吟","author":"邵雍","text":"玉不自珍人与珍，人珍何谢玉之纯。\n然知粹美始终一，更看清光表里真。\n韬韫有名初在石，琢磨成器却须人。\n古人已死不复见，被褐之言不谬云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人生一世吟","author":"邵雍","text":"前有亿万年，后有亿万世。\n中间一百年，做得几何事。\n又况人之寿，几人能百岁。\n如何不喜欢，强自生憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人寿吟","author":"邵雍","text":"人寿百年间，其间多少难。\n予今六十三，何止于一半。\n骨瘦固非清，发白岂谓算。\n便化不为夭，况且粗康健。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人灵吟","author":"邵雍","text":"天地生万物，其间人最灵。\n既为人之灵，须有人之情。\n若无人之情，徒有人之形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人物吟","author":"邵雍","text":"人破须至护，物破须至补。\n补护既已多，卒归于败露。\n人有人之情，物有物之理。\n人物类不同，情理安有异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人物吟","author":"邵雍","text":"人盛必有衰，物生须有死。\n既见身前人，乃知身后事。\n身前人能兴，身后事岂废。\n兴废先言人，然后语天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人贵有精神吟","author":"邵雍","text":"人贵有精神，精神多不醇。\n有精神而醇，为第一等人。\n不醇无义理；是非随怒喜。\n怒以是为非，喜以非为是。\n怒是善人疏，喜非小人比。\n败国与亡家，鲜有不由此。\n娶妻娶柔和，嫁夫嫁才美。\n安得正妇人，作配真男子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人鬼吟","author":"邵雍","text":"既不能事人，又焉能事鬼。\n人鬼虽不同，其理何尝异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八日渡洛登南山，观喷玉泉会，寿安县张赵尹三君同游","author":"邵雍","text":"渡洛南观喷玉泉，千峰万峰遥相连。\n中间一道长如雪，飞入寒潭不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]