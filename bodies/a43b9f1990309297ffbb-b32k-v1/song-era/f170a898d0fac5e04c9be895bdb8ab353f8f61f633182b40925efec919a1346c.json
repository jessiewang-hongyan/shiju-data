[{"title":"宿青城板桥寺","author":"李新","text":"村落萧萧烟雨收，鹑衣寒竖挽归牛。\n平生脚力未到处，当路贵人安肯游。\n蹶失马蹄无限恐，荒凉僧墅不胜愁。\n北窗季弟还知否，一夜秋声已白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寂照院","author":"李新","text":"道人筑室不草草，燕垒蜂房断有才。\n细细转泉萦屋去，疏疏栽竹放山来。\n琴无杀意客何惮，士怕移文车自回。\n清夜不眠留迟月，噪天耘鼓急如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄舍弟二首 其二","author":"李新","text":"冷浆庭巷四时秋，巧拙时情不解谋。\n远客病容诗共瘦，故乡野水泪通流。\n稍辜破镜刀头约，尽失苍蝇骥尾游。\n他日江湖看生计，鸭头春浪一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄舍弟二首 其一","author":"李新","text":"周三千界贫无敌，垂四十年痴有名。\n不怕贵人讥巧宦，但教穷鬼笑难兄。\n异乡置酒能招客，晓梦还家莫计程。\n起写新诗归寄汝，尚馀山月过窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郑明举香","author":"李新","text":"手匀沉实伴兰荪，著壁青烟未有痕。\n掩鼻新来憎甲俗，拂衣无处避膏昏。\n不成乱臭须持枣，却恐偷生误返魂。\n寄语山间郑夫子，年来悬麝厌当门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇宁寺晚归","author":"李新","text":"远意难随燕燕归，故园春冷杏花稀。\n虚名自古双蜗角，别业从来一钓矶。\n已后无人能立雪，他年知子可传衣。\n结庐薄有西山地，更遣何人赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚过银山","author":"李新","text":"荒溪屈曲中郎篆，白鹭参差玉笋班。\n竿日已移三丈外，水云犹垛两山间。\n石桥梅萼馀香冷，茅店人家晚梦閒。\n幸自归心过飞鸟，不须循指示刀环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚宿江涨桥","author":"许彦国","text":"鸟径青山外，人家苦竹边。\n江城悬夜锁，鱼市散空船。\n岸静涵秋月，林昏宿水烟。\n又寻僧榻卧，夜冷欲无眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清泉馆","author":"李新","text":"晓踏高坡日始悬，清泉未见口生烟。\n飞凫欲到二千里，挟筴徒劳三十年。\n绣带长川初背眼，云根双剑远磨天。\n骕骦齿健嘶风去，更敢披头重著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜鼓道中所见诗","author":"李新","text":"麦秋场圃面颜光，蚕月丝车茧水黄。\n豆饭饷田薅鼓住，田塍收水妇翁忙。\n明沙粲粲流泉慢，绿竹猗猗苦笋香。\n赩日不黔形自黑，剩收斗粉傅何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隐居","author":"李新","text":"伯鸾翠构元临市，靖节幽居最近朝。\n事过自馀安水石，客忙何至走渔樵。\n价高少室仍休问，径捷终南更易招。\n岭上有云如可寄，肯将台鼎换箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜孙伯远王周彦远访","author":"李新","text":"晚闻佳客过烟城，抛檄归来扫榻尘。\n连骑莫忧原叔病，食鲑谁谓庾郎贫。\n定因残雪寻穿履，聊觅江梅遗故人。\n重与论文在何日，自应乘兴一相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普通院","author":"李新","text":"而今漫叟正聱牙，无复新诗赖碧纱。\n行驭乘风方少快，归期破镜尽从差。\n月头渐黑山云?，雨脚更斜江路叉。\n寒士规模新宰相，这回行处亦堤沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游云门山寺","author":"李新","text":"宰官得度却无能，直断曹溪一点灯。\n脱体化为牛马走，只身归是水云僧。\n晚烟破灶迷村落，桴鼓哗空走稻塍。\n弄水看山元未足，半规初月上觚棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游化城寺","author":"李新","text":"山色从来不世情，水光分与万家清。\n连云种竹官租薄，入谷收茶野屩轻。\n小雨结缘留俗客，好风吹梦过江城。\n这回劝饮休辞醉，后日西山第几程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石鼓寺","author":"李新","text":"石鼓寂不振，金声无处求。\n层岩参雾树，乱玉响冰沟。\n破屐前无齿，孤城远见楼。\n山僧痴问客，阿汝谓汤休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游法济寺 其二","author":"李新","text":"暮钟晓磬杂啼鸦，尤觉幽栖与市赊。\n风力吹回千嶂雨，柳阴遮断一溪花。\n苍皮树瘿何妨丑，横水桥虹不厌斜。\n夜半春雷乱车轧，不须鸣鼓助惊茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游罗园","author":"李新","text":"故山新寄小郫筒，春事而今一半空。\n儿女笑从花影外，杯盘香在水光中。\n泉分石溜浑罂白，病得春醅半颊红。\n祓禊山阴已陈迹，试将青草葄衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游雍熙寺","author":"李新","text":"随身刀笔快投空，黄鹄凭君放出笼。\n野马已飞樽俎外，白云端在笑谭中。\n太平老将辜三略，迟钝参军得五穷。\n近日半聋并半哑，莫将佛法问庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上招故人","author":"李新","text":"柳影依窗过，荷香拂枕浮。\n云边山近雨，石下水通秋。\n白藕离新斸，嘉鱼落晚钩。\n还同动情兴，已为扫西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登西楼呈桑彦周","author":"李新","text":"独自行藏莫倚栏，市廛野色不相干。\n是中门户也罗雀，何处身心更梦棺。\n锦水背人朝暮去，雪山随我久长寒。\n一生著作惊磨灭，欲借君家铁砚看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城望江边","author":"李新","text":"山外浮云云外城，江边羌角水中声。\n九分雪发功名晚，一寸冰衔去就轻。\n山与绣屏天刻画，兽编土宇地攲倾。\n早扶藜杖关头去，要向中州看太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答李丞用其韵 其一","author":"李新","text":"四时秋色可春回，古锦囊空信短才。\n纸尾依随丞不负，天西穷绝客何来。\n顽云垂翼山碉暗，乔麦饶花雪岭开。\n投老播流情味恶，孤城移作望乡台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答李丞用其韵 其二","author":"李新","text":"年少文声许过秦，仕涂便失自由身。\n初思鲈鲙翻归兴，不见仙槎却问津。\n道德千言遥胄事，文章万丈当家春。\n鱼从丙穴如收得，更与张华细辨鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢杨秀才惠文编","author":"李新","text":"漆园梦过感天涯，坐客元非借齿牙。\n小杜阿房终是好，沈郎雌霓不容差。\n岂羞东郭先生履，行谢关西孔子家。\n五斗折腰闻道晚，未穷摛藻胜春花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋邓士载祠","author":"李新","text":"高鸟无馀弓自除，由来名盛不堪居。\n易挥道左降王缚，难弭朝端谤箧书。\n更欲平吴功未就，可怜出蜀智何疏。\n凤台山月知冤魄，夜夜停光照故墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隔墙吹箫悲深有作","author":"李新","text":"撄心人事细如蓑，浑有童心奈老何。\n湿雪尽随哀泪堕，清箫不与哭声和。\n归休最病良田少，侵老终怜季子多。\n无命无才犹有友，但怜雄辩正悬河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黑水馆","author":"李新","text":"孤宦轮蹄消岁月，谁缘清赏慰蹉跎。\n曾行轩户昔无处，见在江山今得多。\n雪色云容通剑阁，镜光池溜属天河。\n本来一段真奇绝，不肯关情奈俗何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"催李祖申赏莲会","author":"李新","text":"亭亭绿盖密回塘，缥缈青娥丽素妆。\n雪覆千年巢曳尾，风翻一曲舞霓裳。\n小槽酒滴随悭雨，北海樽空类亢阳。\n何事却妨彭泽醉，几时聊发次公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感事","author":"李新","text":"银涛千里引长吟，玉轸他年有古音。\n云起不知山有助，鸟啼争奈竹无心。\n画蛇可笑须安足，撄市堪悲只见金。\n莫与浮云较休戚，北窗棋酒夜方深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感贫女","author":"李新","text":"天然素质胜铅华，一握青丝过老鸦。\n信手画眉成柳叶，移盆贮水当菱花。\n长忧夜雪侵肌骨，不识春风到齿牙。\n媒妁近来趋势利，终年元未适良家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感俗","author":"李新","text":"回肠惊绀发，汩脚沁寒眸。\n沃壤连千里，封狐媚一丘。\n生憎守钱虏，冷诮富民侯。\n不厌江西水，长年傍屋流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简任安中","author":"李新","text":"边公春梦昼悠扬，借有新嘲不汝妨。\n杖屦未经桃李树，棹歌空忆水云乡。\n子规啼去花应好，燕子归来日渐长。\n稍学渊明惜名酒，扫除斋阁待君尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲静安挽词","author":"李新","text":"舞鸾雏鹄已先飞，曾倚西山泣晚晖。\n老去儿孙雄北阮，古来门户占乌衣。\n萧萧华发犹供祭，历历清谈又解围。\n洞口仙人招白鹤，玉翰何日与云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓬溪道中所见 其二","author":"李新","text":"诗情冷落接坰荒，鸟语钩辀伴日长。\n山馆花烦蜂蜜重，溪桥雨润燕泥香。\n鄂君被暖春回帐，犬子琴閒月到床。\n醉里要归何处是，无功犹解记吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鉴亭","author":"李新","text":"石壁缘云白，松风特地哀。\n断鸿随眼没，秋浪擘山来。\n鼓急船头转，山明雨脚开。\n知公归未得，此作望乡台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮还官寺","author":"李新","text":"新雨初平万顷波，移家归去旧烟萝。\n三年邻里定相笑，八斗才名岂是多。\n地近聊为分袂别，酒醺閒作扣舷歌。\n晚投方丈虽岑寂，客喜谈玄自见过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春泛舟涪江","author":"李新","text":"已把荷衣换钓裘，不妨官柳系渔舟。\n提壶劝酒虽无意，杜宇言归却自由。\n十里江风吹昼梦，一川梅雨敌春愁。\n忘机鸥鹭休飞去，且为閒人更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"磁钓翁","author":"李新","text":"尺巘方壶小，泓泉渤海深。\n陶公慈母手，抔土故人心。\n蓑笠不愁敝，鲦鲿何处寻。\n虚堂值萧瑟，犹苦百虫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"磁钓翁 其二","author":"李新","text":"无心不自任公子，手引龙鱼敌万钧。\n瓦解弟兄惊坠甑，块居烟雨胜流人。\n非关钓誉虽攘臂，未欲垂言却卷纶。\n更与甄陶一抔土，铃斋相伴岂无因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"磁钓翁 其一","author":"李新","text":"磁钓翁宁傍钓矶，且当兀坐小盆池。\n模形陶氏不须怪，入手苍鲸未可知。\n风雨不渝端此志，江湖归去定何时。\n閒惟秋水磻溪客，船入芦花笛卧吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉乡","author":"李新","text":"客至终投辖，朝回讵典衣。\n待眠卿且去，亟酌我将归。\n泉郡新封邑，糟丘小翠微。\n离家今万里，坐隔羽觞飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题小瀛洲","author":"李新","text":"紫霞香雾隔氛尘，拟嘱安期谢海神。\n闻道仙居随处有，故教湖景到来新。\n果成行拾千年子，花落休悲二月春。\n咫尺徐生身不到，自应船载世间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题旧新明县孝义驿","author":"李新","text":"平生职事马蹄尘，三月莺花世路新。\n废邑尚馀当日市，旌门已忘昔年陈。\n长江浪拍西山脚，乔木阴回太古春。\n惟有柳绵情不恶，解将柔远逐行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永康县山光阁","author":"李新","text":"吹鬓东风可但寒，倦飞孤鹤已知还。\n花光弄暖翻承雪，云翼回阴却见山。\n野水曲行林下绿，春禽唤出梦中閒。\n欲营老宅南头住，待驻人间耐久颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题延宾亭","author":"李新","text":"秋叶春风自一村，主人高谊揖公孙。\n未容急去须投辖，却恐重来不置门。\n歌彻晓云归曲席，酒醒残月照空樽。\n何时下客腰悬印，西向偿君一饭恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朱令德祠","author":"李新","text":"全家领项付吴钩，香骨当年谁共收。\n鼎镬九泉留景进，旌幢千骑忆同州。\n唐人铁券惊何语，蜀国壶浆笑旧游。\n古柏参天僧社冷，暮烟风雨使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题明远轩","author":"李新","text":"聊能半日止游缰，拂拂尘裾未涤黄。\n山掩溪光龙脊断，谷传天籁虎风凉。\n乱云过眼不妨好，细径入村何限长。\n独酌苦吟清意在，可怜禽鸟亦相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题质龟轩","author":"李新","text":"百岁才容山鬼知，九渊那许季咸窥。\n事明告我肯三渎，谋既协人何两疑。\n曳尾讵堪从太史，刳肠犹叹漏神蓍。\n试看左顾怀恩处，莫记巢莲睡足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南寺吟轩","author":"李新","text":"市声幽鸟几相呼，指点前村认有无。\n初见江山怀子美，更因楼阁梦姑苏。\n惯看渡口飞桃叶，细结篱根护木奴。\n蹙得锦囊多少句，暮归倾倒九渊珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题绝胜亭","author":"李新","text":"孤鸿落照下沧洲，人在云间选胜幽。\n好梦知君依魏阙，此生惟我识荆州。\n卜居支遁应同志，载酒山公已绝忧。\n他日澄江净如练，主人端在塞垣秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题啸竹轩","author":"李新","text":"借与江风入茂林，低低戛玉伴龙吟。\n琅玕影动分清奏，鸾凤声寒得至音。\n妙处成文元有节，虚中出乐自无心。\n子期一听终区别，流水高山不在吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题筹笔驿","author":"李新","text":"流马飞粮下蜀都，卧龙曾此写雄图。\n金刀有义轻三顾，铜爵虽强视一夫。\n鼎足山河终有汉，雁行兄弟亦忠吴。\n当年若尽毫端计，魏狗还羞不令无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕走马少卿口号","author":"李新","text":"冠盖相逢好驻鞍，况知北陆已迎寒。\n诏归未觉尧天远，星应休辞蜀道难。\n款听话言敦夙契，更催歌舞奉清欢。\n慇勤莫惜通宵醉，归约松梢月影残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一晓发射洪循江而行书二诗州堆馆 其一","author":"李新","text":"少健有力入云耕，耕云不怕山重重。\n岁时伏腊追社集，照水自爱双颊红。\n三十馀年废田舍，芋魁豆饭忘乃翁。\n誓归复讲旧生计，无谓我不如老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一晓发射洪循江而行书二诗州堆馆 其二","author":"李新","text":"翠麦铺茸不罅土，白白红红花日许。\n我行未尽天之涯，马足舆肩已辛苦。\n时名入手无一掬，昔年虎章今化鼠。\n疾归灌畦蔬换肉，无谓我不如老圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上亭书事","author":"李新","text":"自笑痴公日据鞍，谁令生不近长安。\n此条太乐非清职，何物先生祗冷官。\n背日潢污犹鼎沸，隔唇喉舌亦灰乾。\n五浆不馈寻常客，却作行人一等看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪不宜干人","author":"李新","text":"漫瀰江天慁霏雪，市薪黄金粲环玦。\n大寒叵堪出门户，已麾中涓束漫谒。\n著作千卷字不同，下希牧守上三公。\n榻西有酒鹅儿色，鸿音读书句成拍。\n句成拍，不是平生等闲客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"李新","text":"绿树初浮光，嘉禽自行乐。\n厨烟续云根，涧水断冰脚。\n徜徉一樽酒，坐看山花落。\n日暮归去来，嫣香裛罗幕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广都道中作","author":"李新","text":"万花织篱凡几曲，绣屏处处围茅屋。\n家贫张日无罗幕，东风吹开莫吹落。\n居人应笑行客痴，春去春归殊不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞仙道中","author":"李新","text":"鸟衔桃李堕高卑，陵谷逢春花作衣。\n犹忆去年携小筥，上山独自采春薇。\n涧流到海住家处，今我无家何更归。\n修途老来倍酸苦，晚雨一丝愁一缕。\n晓征春事太半无，未尽蜀天已秦语。\n仰看鸿鹄向南飞，笑杀鸱鸢争腐鼠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞练歌呈宋豳州宏父","author":"李新","text":"玉娥入月云钩衣，素裙雪绡云畔垂。\n三山老仙不倦舞，霓裳半在秋江举。\n谢郎解取澄江拟，飞下高城化清泚。\n朝元环佩玉玲珑，天风吹落人间耳。\n六月夸父暍将死，一吸澜翻九河水。\n蟾乡换入石泉中，古柳阴前授琼几。\n清泉无苦多酌我，空洞麟肠已行舸。\n穷源直上翠微峰，小段参差绣岭宫。\n归来泉边却张席，女头残月投苍璧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞将","author":"李新","text":"老翁望封竟无有，自是翁骨生来丑。\n猿臂悬知不入相，且有杀降聊藉口。\n翁今远孙骨虽瘦，不解射雕能饮酒。\n自汉至今太寂寥，何得遥遥纪华胄。\n尚方侯印只方寸，岂有铸金大于斗。\n为翁力取置肘间，令翁千岁无恨颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋夜玄云蔽月行","author":"李新","text":"惆怅中秋不见月，太阴垂云兔藏窟。\n我欲上天扫玄云，桂露团团渍冰阙。\n中天放出千里光，层楼翠阁遥相望。\n一杯一杯重相劝，今年赏汝中秋愿。\n上天高高末由到，玄云愈浓不可扫。\n空庭蜡炬落寒花，宫裘起舞秋风老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]