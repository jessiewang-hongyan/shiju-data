[{"title":"秋兴浩然追忆馆殿幽致偶成长句寄徐休学士","author":"寇准","text":"轺车南去咏江天，闲忆群贤倍黯然。\n御水莎青孤立鹭，宫槐烟冷数声蝉。\n石渠吏散帘风静，凤阙云归霁景鲜。\n幽致不知何日共，思君唯赋帝京篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋访江上友生所居","author":"寇准","text":"苔石半寥落，坐来生远愁。\n故人应罢钓，寒叶自惊秋。\n村隔平沙暝，江和暮霭流。\n徘徊不能去，此处有扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"寇准","text":"落日留不住，默然空泪零。\n败莎侵陋巷，疏叶满闲庭。\n有趣穷风雅，无机敌杳冥。\n浮荣安足恋，归去乱山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜怀归","author":"寇准","text":"渭水苔矶阻旧游，梦回空馆却凝愁。\n一声江笛巴云暝，半夜山风楚树秋。\n星落古池孤影动，灯摇疏壁冷光幽。\n迟明不寐空搔首，踪迹何由得狎鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜怀归","author":"寇准","text":"背窗寒烛影沉沉，楚客乡思欲不禁。\n板阁漏残人自远，水萤光淡夜方深。\n牢愁闻雨眠疏屋，归梦随云彻故林。\n忆著烟村旧风景，柿红时节又鸣砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜怀洛下一上人","author":"寇准","text":"游宦忘机久，心源亦自澄。\n夜听吴苑雨，秋忆洛城僧。\n木叶惊栖鸟，寒窗暗静灯。\n何时过竹院，一得问三乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜独书勉诗友","author":"寇准","text":"西风惊万木，危坐思悠哉。\n故国经年别，秋鸿半夜来。\n人应多弃善，天岂不怜才。\n休学严夫子，荒凉老钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜感兴寄吴顺之","author":"寇准","text":"耿耿不成寐，楚乡经暮秋。\n故人遥海峤，寒月满江楼。\n闭户生苍藓，安闲到白头。\n如何太平日，独不出汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨怀友生","author":"寇准","text":"江城秋雨歇，孤坐役吟身。\n草色荒三径，虫声满四邻。\n边鸿来已近，庭叶落还频。\n对此空搔首，无由面故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"寇准","text":"秋气动天地，恍然情未穷。\n故园应坠叶，昨夜又西风。\n白草侵危堞，寒涛接远空。\n支颐当此景，无语夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋寄江上吟僧","author":"寇准","text":"挂锡在荆楚，杜门无往还。\n潮声到孤寺，月色遍前山。\n一雁惊幽思，西风惨病颜。\n何当重携手，高步白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚闲书","author":"寇准","text":"吟情自觉都无趣，况复离居感物华。\n厌读群书寻野径，闲收落叶煮山茶。\n烧残寒菊花犹在，霜过香橙味转加。\n因想前期重搔首，不堪秋思极长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆南秋望","author":"寇准","text":"西风吹户牖，犹自客荆蛮。\n积水浮秋汉，微阳淡远山。\n蝉稀疏叶尽，雨歇片云闲。\n何日忘簪绂，深居石室间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草","author":"寇准","text":"独步高原上，依依动所思。\n无人寻蕙径，落日满江湄。\n楚泽晴芳处，秦川晚翠时。\n此中兴废事，千古复谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贻赵少府","author":"寇准","text":"夫君何感命，拾载困风尘。\n薄宦须流落，孤吟更苦辛。\n山寒泉易冻，边近草难春。\n珍重常招隐，惭非孟子邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人","author":"寇准","text":"客亭残照里，歌阕独南行。\n芳草无断色，离人多别情。\n远涂方不极，长笛更飞声。\n莫动乡关念，徒令白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人下第归吴","author":"寇准","text":"莺老计还失，负书归故乡。\n杏园无近路，泽国有高堂。\n白鸟迷幽浦，寒猿叫夕阳。\n离怀休堕泪，春草正茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人归吴","author":"寇准","text":"忽忆湖山景，沿流兴不穷。\n孤舟将去夜，绝塞已来鸿。\n白发前期近，沧川旧业空。\n明时方道在，莫更学渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友生下第南归","author":"寇准","text":"频频退礼闱，此去欲忘机。\n霄汉贫难达，江湖老独归。\n程遥秋浪叠，村暝夜灯微。\n应使为儒者，翻悲苦业非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送左眉州之任","author":"寇准","text":"分官离法署，承命守眉州。\n山馆邻孤寺，春城过乱流。\n江云长映日，蜀魄似悲秋。\n到郡扬清政，遗黎病必瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉上人","author":"寇准","text":"新鸿并落叶，正逐朔风飞。\n此地仍分首，何山是所归。\n问程云栈远，宿馆雨灯微。\n莫恨天涯别，重寻志未违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李生归秦中","author":"寇准","text":"酒阑还执手，之子拟归秦。\n风雪过残岁，山川近早春。\n久游诗思苦，远别柳条新。\n后会知何日，空馀泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳登高偶作","author":"寇准","text":"务闲留上客，佳节值重阳。\n旨酒浮仙菊，清歌绕画梁。\n高城明落日，疏树觉微霜。\n且尽登临兴，馀欢尚未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日晚凉","author":"寇准","text":"微凉天气似秋期，风触疏帘影自移。\n远梦有时寻水寺，孤吟终日对莎池。\n笋梢成翠堆轻箨，梅实翻黄压嫩枝。\n兀兀腾腾聊自遣，此怀深谢野僧知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜闲书","author":"寇准","text":"雨濛村落野梅黄，茅阁长吟水气凉。\n幽鸟远声来独树，小荷疏影占前塘。\n闲心终不忘鱼钓，澹水真宜习老庄。\n报国自知无世用，烟蓑何日卧清漳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中书","author":"寇准","text":"多病将经岁，逢迎故不能。\n书惟看药录，客只待医僧。\n壮志销如雪，幽怀冷似冰。\n郡斋风雨后，无睡对寒灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦中感怀寄江外知己","author":"寇准","text":"念子隔江海，浩然时已秋。\n蝉鸣关外树，人在水边楼。\n发白犹搜句，时清尚旅游。\n遥思当永夜，不寐向孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中作","author":"寇准","text":"秋末楚云端，行侵苔藓斑。\n愁肠不厌酒，病眼岂逢山。\n远路有时到，宦游无处闲。\n却思清渭北，烟柳掩柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿江西寺","author":"寇准","text":"独宿西林夜，凝然静拥袍。\n巫云秋暝峡，楚月冷生涛。\n莎败蛩犹噪，乡遥梦亦劳。\n霜风开落叶，还欲续离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄献广南许虞部","author":"寇准","text":"南国江山五十州，星郎从此播芳猷。\n诗穷雅道皆清唱，官重名曹未白头。\n望断蛮村烟树远，吟残岭月海风秋。\n三年政满迎丹诏，谏署重膺仄席求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄漳川隐士 其二","author":"寇准","text":"慵趋大厦恋山薇，立志由来与世违。\n溪上有时逢静钓，雪中长日掩闲扉。\n自知天爵高人爵，不爱朝衣换布衣。\n我逐浮名任飘泊，清泉难得共忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄漳川隐士 其一","author":"寇准","text":"志高长说耻凫趋，岁晏园林恋隐居。\n陋巷自甘栖短褐，侯门终不曳长裾。\n夜吟雪屋冥搜句，春结烟蓑老钓渔。\n为我红尘偶为吏，近来还寄绝交书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赠笠泽处士","author":"寇准","text":"笠泽渔人高节奇，白头犹自著蓑衣。\n吟过竹院僧留宿，钓罢烟江鹤伴归。\n花落砌边春雨歇，酒醒林际夕阳微。\n中朝名士皆知己，多说东来信亦稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"掩卷","author":"寇准","text":"掩卷频秋望，无人共展眉。\n残阳留古树，白鸟下寒池。\n簪组心还倦，风骚志未衰。\n登临一长叹，还失渭川期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜吉上人至","author":"寇准","text":"喜师来访我，幽会兴何长。\n清论都无倦，乡愁顿欲忘。\n疏林秋色暮，虚阁水风凉。\n久坐慵言别，微阳下短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜吉上人至","author":"寇准","text":"邺北至夔城，三千里外程。\n劳寻苦吟伴，独入乱山行。\n楚水秋无际，巴猿夜有声。\n逢师不能寐，因话故乡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓居有怀","author":"寇准","text":"疏林频落叶，孤僻继离骚。\n独坐闻鸿远，闲吟见月高。\n梦回更自永，思苦夜何劳。\n寂寂西郊内，披衣听海涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上作","author":"寇准","text":"极目望南浦，望中生远思。\n雁沉芳草渡，烧断夕阳陂。\n岁月寒萍梗，江山念别离。\n犹馀清夜梦，暂与白云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琼林苑应制","author":"寇准","text":"凤跸出重城，宸游顺物情。\n槛花红蕊盛，苑树绿阴成。\n雨过池塘静，风来殿阁清。\n乐和尧酒满，千载乐升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辇下书怀","author":"寇准","text":"身名长似梦，家计尽萧然。\n旅宦游梁苑，归心满渭川。\n郊原秋变色，桑柘晚生烟。\n愿得长闲去，何妨老一廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辇下春望","author":"寇准","text":"独向东门凝目望，园林无处不啼莺。\n乡心已似杨花乱，归路那堪野草生。\n紫陌尽应趋胜地，红尘谁肯受闲名。\n年来却羡沧江叟，长在湖山听浪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"塞上","author":"寇准","text":"春风千里动，榆塞雪方休。\n晚角数声起，交河冰未流。\n征人临迥碛，归雁别沧洲。\n我欲思投笔，期封定远侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴寄莲岳一二诗禅友","author":"寇准","text":"西风伤远别，前计竞成非。\n芳草此时暮，故山何日归。\n禅应同雅道，贫合长天机。\n翻忆云溪伴，无憀对落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋","author":"寇准","text":"孤吟绕桐砌，时节又西风。\n怅望新秋在，欢娱往事空。\n柳条微减翠，蓼穗已飘红。\n正是多伤感，仍将别恨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚江有吊","author":"寇准","text":"悲风飒飒起长洲，独吊灵均恨莫收。\n深岸自随浮世变，遗魂不逐大江流。\n霜凄极浦幽兰暮，波动寒沙宿雁愁。\n月落烟沈无处泊，数声猿叫楚山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚江夜怀","author":"寇准","text":"西风生远水，萧飒度吟台。\n明日夜还满，故人秋未来。\n寒蛩啼暗壁，败叶下苍苔。\n谁念空江外，年年首重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞庆园观稼奉圣旨次韵","author":"寇准","text":"善苗栖亩昭灵贶，禁苑鸣銮值素秋。\n敛籍神仓符礼本，采诗良耜庆农收。\n宴开云幄皇慈洽，日驻天衢睿赏留。\n千载逢辰增岳抃，清尘叨从属车游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁中偶书所怀呈内翰同年同院二学士","author":"寇准","text":"朝回内省中，默坐对西风。\n秋色澄寒沼，朝阳上古桐。\n龙墀惭近侍，鱼浦忆疏篷。\n会待酬恩了，烟蓑伴钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋感兴","author":"寇准","text":"苒苒前期远，穷途一可伤。\n有时闻落叶，不语立残阳。\n塞草秋先白，溪沙晚更光。\n那堪望天末，燕雁又成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题巴东寺","author":"寇准","text":"寺在啼猿外，门开古涧涯。\n山深微有径，树老半无枝。\n望远云长暝，谈空日渐移。\n恐朝金马去，还失白莲期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨氏别墅","author":"寇准","text":"门巷枕江濆，疑将俗境分。\n湖山晴后见，天籁静中闻。\n径僻苔空老，林寒日渐曛。\n高怀无一事，长岁似孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠宝上人","author":"寇准","text":"重城萧寺虽留滞，野鹤由来性本闲。\n寒磬终宵鸣竹院，虚窗尽日对秋山。\n旋移怪石资吟赏，应有孤云共往还。\n自笑红尘成底事，幽期长是负松间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隐士","author":"寇准","text":"夫子才名重，贫居志未劳。\n吟当寒夜苦，闲到白头高。\n心地通禅寂，田园近海涛。\n不知千载后，谁更续离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隐者","author":"刘镇","text":"夫子生东野，经年不到城。\n爱吟无俗趣，贪画得閒名。\n荒径侵山影，虚堂出燕声。\n我惭为谪吏，泉石负幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠惠政上人","author":"寇准","text":"寥寥长日掩松关，白首忘机古寺间。\n香烬石房终晓讲，叶堆莎径忆秋山。\n澄泉心地清无染，野鹤精神老更闲。\n孤坐有谁同此意，白云空见渚禽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠僧","author":"寇准","text":"重城须久住，尘事日全无。\n落叶惊秋信，思山展旧图。\n貌同仙鹤瘦，心似片云孤。\n念我浮名在，还将静者殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠魏野处士","author":"寇准","text":"人间名利走尘埃，惟子高闲晦盛才。\n攲枕夜风喧薜荔，闭门春雨长莓苔。\n诗题远岫经年得，僧恋幽轩继日来。\n却恐明君徵隐逸，溪云谁得共徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天安殿致斋","author":"寇准","text":"国阳崇大报，王宇藻多仪。\n散致尊王度，怀柔祝帝禧。\n储精通合漠，玩志协徵夷。\n律正风来迥，宵长月上迟。\n漏筒声淅沥，陛戟影流离。\n夙戒群伦序，交欢百虑怡。\n星繁陈法仗，云密荫平逵。\n传晓鸣梢动，威容声率祗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天安殿酌献天书","author":"寇准","text":"圣运昭惟永，高真协降祥。\n方严泰坛祀，先荐釜山章。\n典礼官无旷，涓辰筮有常。\n中天华阙秘，象衮睟容庄。\n宵迥星河灿，风微羽卫扬。\n献酬灵契接，陟降宝仪彰。\n顾諟钦元命，寅恭达上苍。\n弥文辉竹帛，备物俨萧芗。\n尊道宸心至，登春雅俗康。\n犹将奉斋洁，禔福俟穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成安感秋","author":"寇准","text":"蝉噪木叶下，远客忽惊秋。\n凝恨悲晚候，万绪皆如抽。\n芳时同梦幻，急景如奔流。\n念我何为者，年来生百忧。\n贫居负胜事，壮岁伤羁游。\n临民惭墨绶，垂钓思沧洲。\n达则济天下，穷当守一丘。\n胡能效时辈，腼冒随沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县斋春书十二韵","author":"寇准","text":"县幽无俗事，公退只高吟。\n江到荆门阔，山连蜀国深。\n峡云长映日，蛮雨易成霖。\n群雀鸣春院，饥猿叫夜岑。\n庭荒多古木，地僻见沙禽。\n印锁残阳后，人归叠翠阴。\n思乡空索寞，素分信浮沉。\n乐静稀尘累，甘闲负壮心。\n衰容常懒栉，病发岂胜簪。\n寡欲慵求友，防邪每自箴。\n浇风终耻合，前事固难谌。\n望断天涯外，离魂欲不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和御制祀后土","author":"寇准","text":"临晋迎清跸，灵坛备克禋。\n荐诚祠后土，求福为蒸民。\n展义王猷远，推恩庆赐均。\n千官陪汉祀，万国奉虞巡。\n仗卫明初日，郊原丽上春。\n花飞函谷路，柳暗大阳津。\n宿麦深藏雉，柔桑远映人。\n河流回二陕，山势壮三秦。\n箫鼓闻睢上，旌旗过渭滨。\n天声惊远野，兵气慑边邻。\n在镐皇欢洽，横汾睿藻新。\n周南惭滞迹，空想属车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制南郊礼成","author":"寇准","text":"荐降灵符昭瑞命，交修盛则荐清衷。\n朝真曲里扬丕烈，类帝圆坛报昊穹。\n述职万邦咸执玉，来庭异域协占风。\n禹功高大天无极，尧德明如日正中。\n福浸含生臻富寿，泽流绵宇霈庞鸿。\n粢盛丰洁神皆飨，金石和平政本通。\n郁郁云烟当昼丽，熙熙景物共春融。\n群臣抃蹈瞻宸扆，愿比南山祝寿躬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制真游殿上梁","author":"寇准","text":"敦崇妙本膺丕贶，浚发鸿源示永年。\n吉语密传当乙夜，粹仪祗觌拥祥烟。\n皇心翼翼精斋至，祖德绵绵道诲宣。\n诞集纯禧彰锡羡，交修茂典表钦先。\n爰稽大壮新琼宇，仰法殊庭设绮筵。\n山积瑰材咸备矣，神扶华栋见巍然。\n元龟献兆良辰协，哲匠施勤庶艺全。\n四柱如翚循宝势，觚棱削玉灿珠躔。\n黼帷夙设宸居丽，翠葆躬临圣志虔。\n昭答明灵陈盛会，睿词敷畅焕云笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚辰岁将命至巴东时已秋序霜荷索然偶赋是章用遣幽恨","author":"寇准","text":"秉轺偶将命，抚俗烟江湄。\n地僻接穷峡，务简稀公期。\n秋信任无趣，野怀良自宜。\n月白夜蝉响，池暗风荷衰。\n溪云入破牖，山菊开疏篱。\n贳酒不能醉，乡园空结悲。\n徘徊独凝望，目极长天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]