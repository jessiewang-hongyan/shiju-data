[{"title":"喜雨","author":"释元肇","text":"去年民病屡思安，天意为霖不作难。\n地脉无穷窥井浅，波光不断倚楼宽。\n梅林时落黄金弹，荷沼新擎碧玉盘。\n蛙吹莫供闲客耳，一时去和老农欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"释元肇","text":"斗舞争飞住复飘，寒林开尽玉枝条。\n清缘煮茗开蓬户，冷为寻梅过野桥。\n髣髴村前出图画，依稀江上见渔樵。\n墙根屋角且宁耐，留与诗人款寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送杜守","author":"释元肇","text":"一麾长啸静边陲，丹诏飞催上玉墀。\n送别莫辞行路远，感恩深是到州时。\n名垂岘首山能重，誓指江流水自知。\n他日登临见遗爱，太平楼外柳丝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送尹教授","author":"释元肇","text":"雁塔题名二十年，青衫手板坐无毡。\n时清朝野诸公荐，句好江湖万口传。\n杜宇不啼淮树冷，宫莺未老上林烟。\n麟台凤阁思灵彻，只在山边与水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林陶欢","author":"释元肇","text":"不见陶欢今四载，欣然复会在通川。\n行囊觉重添新藁，颜貌如前转少年。\n到处诸侯争下榻，醉来骑马似乘船。\n掉头又向何方去，笑指长洲万顷莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿旧巢","author":"释元肇","text":"故庐重到莫春时，物色风光总欠诗。\n柳絮有情飞满袖，牡丹无语恨空枝。\n燕归不用深垂幕，笋出应须密护篱。\n明日篮舆又东去，迢迢烟草绿相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋","author":"释元肇","text":"满目依然明镜流，无家空折大刀头。\n人间动是经年别，客里尤深此夜愁。\n牢落关河还出塞，萧条江国更登楼。\n不知何处风砧发，添得诗人两鬓秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿西禅","author":"释元肇","text":"竹杖芒鞋去问津，波生鸭绿草铺茵。\n雨迷阡陌留连客，风入园林著摸人。\n寂寞数家收市井，萧条一榻卧埃尘。\n避人幽鸟浑无语，桃李明朝依旧春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵检法","author":"释元肇","text":"津头梅白柳青青，却忆春时送别情。\n纸上有怀难尽写，梦中相见不分明。\n清台婉画从轻典，紫禁催班识重名。\n几欲寄君无好句，夕阳秋色满江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵寺丞中秋韵","author":"释元肇","text":"太守能诗赵倚楼，良宵开宴领清秋。\n挂檐玉鉴明如洗，划汉银河近欲流。\n雅兴自来轻庾亮，颂声翕尔变营丘。\n关河万里须长啸，莫问膏腴在橘洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪","author":"释元肇","text":"竹边声细夜方阑，开尽南窗独自看。\n桃杏学梅唯欠瘦，池塘堆絮怪能寒。\n纤纤尚舞东风力，片片还随晓气乾。\n芳草已滋三径绿，谁知陋巷有袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喝石岩","author":"释元肇","text":"皓首来迎宴坐师，山灵易地致俱胝。\n要知弘法回天力，但看精诚裂石时。\n一径藓苔春寂寞，断崖文字雨淋漓。\n徘徊想像登云处，风撼松杉万壑悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菖蒲田","author":"释元肇","text":"一从神武挂冠缨，便入千峰适性情。\n已向耆英逃姓字，肯因杨柳作歌行。\n石田水冷菖蒲节，茅屋云深薜荔荣。\n白发山僧知此意，时时来听野泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"树王","author":"释元肇","text":"翠丝缜密赤心存，肤腠凌风溜雨皴。\n直节向时曾遇上，微荄率土莫非臣。\n轮囷古柏空生蜀，偃蹇寒松枉仕秦。\n瀑布青山堪带砺，森森同见万年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与印学正","author":"释元肇","text":"郢手由来善运斤，楚天空阔鹗书频。\n蛟龙岂是池中物，虮虱聊为地上臣。\n细雨斜风潜入夜，岸花汀草已知春。\n君如不负虚前席，治体当言寝积薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上浙翁","author":"释元肇","text":"凌霄峰顶极高寒，中有高人把钓竿。\n万里江湖未归客，满天风雪独凭阑。\n医和世遇肱三折，慈氏门开指一弹。\n管领梅花春有意，免教回首望长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见北涧","author":"释元肇","text":"橘洲骨冷不容呼，正始遗音扫地无。\n一代风流今北涧，十年妙语得西湖。\n人皆去献辽东豕，我亦来观屋上乌。\n春尽闭门无恙不，杨花飞作雪模糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄江西益侍者","author":"释元肇","text":"狼伍峰前一御风，十年消息莫相通。\n山从入望何曾极，水若知愁不向东。\n芳草天迷云梦泽，垂杨烟暝馆娃宫。\n闻君已作包桑计，可念馀生尚转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江","author":"释元肇","text":"不到松江又一年，且于佳处小留连。\n千寻彩影虹垂地，万顷清寒玉浸天。\n塘路罕逢骑马客，人家少似钓鱼船。\n三高冷眼应相笑，送往迎来亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次赵莼湖饱看风雨楼韵","author":"释元肇","text":"江山高处据胡床，豪气如虹贯野塘。\n且去已知元亮醉，兴来非是次公狂。\n满天风雨供吟眺，一幅潇湘不卷藏。\n听得鸡鸣还待旦，莼羹虽美在他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次方蕙岩行春韵","author":"释元肇","text":"及时槃乐足幽闲，近自丘园远到关。\n见綵桃符知岁换，带黄杨柳觉春还。\n飘飘衣袂风雩转，草草杯行笑语间。\n高兴磊然降不下，更须相约过西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄江阴史君尹梅津","author":"释元肇","text":"清简何曾五马荣，时艰念虑在生灵。\n江如谢脁诗中静，山似岳阳楼上青。\n戢戢鱼头曝冬日，翩翩鸦字出宸庭。\n三吴父老遥相祝，几向天边望福星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄池阳许史君","author":"释元肇","text":"紫塞将军有重名，雄藩正管翠微亭。\n西来江水依前碧，北面淮山似旧青。\n因报平安逢驿使，悬知临照老人星。\n寄言文选楼中主，莫道汤休语不灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"狼山","author":"释元肇","text":"仙子飞升岁月閒，游人犹向此跻攀。\n五峰寺踞葱茏处，孤塔云撑杳霭间。\n波渺渺边来汉水，望青青际是吴山。\n风帆沙鸟无今古，潮落潮生自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题钓台","author":"释元肇","text":"汉代高人曾钓此，至今山水有清辉。\n多年祠像真还不，旧日台矶是也非。\n尚想扁舟成独往，问他明月几时归。\n双双鸥鹭应相识，飞落前滩更不飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送周伯弜帐管","author":"释元肇","text":"不见山楹喜见君，才名端不愧芳尘。\n青云自古迟佳士，白发如今尚选人。\n鹦鹉洲边文寂寞，滕王阁上句清新。\n相逢无语又相别，红叶残阳野水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送方常簿赴召","author":"释元肇","text":"门径森阴带草堂，脩篁摇翠间垂杨。\n不知梦到三竿日，又拜除音一炷香。\n池上游鱼觅清影，天边仪凤集朝阳。\n袖中大有安时策，长乐钟声夜未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姑苏台放生","author":"释元肇","text":"高台一上一消魂，触目犹多古迹存。\n溪水流来闻越号，舟人指点是胥门。\n烟云弄晓青山澹，城郭初晴碧瓦昏。\n鱼跃鸢飞归至化，当时歌舞不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牡丹","author":"释元肇","text":"娇红腻紫炫晴芳，好本传来自洛阳。\n谱上有方曾换骨，花中无比合称王。\n道妆宜贮黄金屋，素艳堪居白玉堂。\n罗幕重重护风日，几家歌管惜春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送朔斋右司赴宣城","author":"释元肇","text":"鸳鹭胡为久未归，江东民瘦要公肥。\n诏翻云露宫鸦湿，帆起秋风画鹢飞。\n把酒敬亭呼李白，高吟静练压玄晖。\n不须举手遮西日，花待刘郎对紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和魏侍郎登虎丘","author":"释元肇","text":"朱轮千骑出行秋，览胜须登海涌丘。\n水与天光远相接，云遮山色半如羞。\n先贤祠下修时敬，古剑池边记昔游。\n醉墨淋浪足酬唱，归来鼓角动城头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台道中","author":"释元肇","text":"台岭岧峣道路长，周遭无数接青苍。\n溪头枯树如人立，峰顶孤松似伞张。\n片片开田种阶级，家家垒石作门墙。\n篮舆摇兀东风里，却忆西州上野航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万年开新塘","author":"释元肇","text":"八峰聚首最幽奇，驱石拦云贮碧池。\n倒拥旌幢千影树，平沈星象一枰棋。\n争鸣已被蛙先觉，归宿多应鹭未知。\n肝胆到来都照了，何须更待入门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巾山","author":"释元肇","text":"一登峰顶思悠然，始觉城临沧海边。\n水趁半江流缺月，塔将双笔写青天。\n茫茫帆影随潮远，杳杳钟声带郭圆。\n可是任蕃来宿后，独留诗句到今传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西渡","author":"释元肇","text":"复渡钱塘又六年，山川风物只依然。\n海潮有信看人老，江月无情却自圆。\n满棹白蘋催去国，五更朱旆喝朝天。\n独怜皓首江湖上，不立沙鸥一点烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霜夜有感","author":"释元肇","text":"寒漏时闻一两声，夜窗危坐对孤檠。\n半千里外无家客，十五年前旧月明。\n世事萧萧黄叶下，交情汩汩白鸥惊。\n市人应笑疏狂甚，莫怪庞公不入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扬州","author":"释元肇","text":"高陵为谷曲池平，亭馆多存旧日名。\n风月岂关兴废事，江山不尽古今情。\n浪花飞雪雄新堑，杨柳垂云护细营。\n欲识扬州奇绝处，庙前琼树尚敷荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀野园","author":"释元肇","text":"洛阳园圃久荒烟，秀野佳名向此传。\n云外移山高出屋，门前远水静兼天。\n四时争发花无数，五亩中分竹半边。\n不用笙歌与银烛，夜深渔唱月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和上官右史韵","author":"释元肇","text":"虽然身世两相违，不以无为碍有为。\n偶被闲名难免俗，因将黄叶强题诗。\n一年好是中秋节，万事能如采菊时。\n自古圣贤观出处，只今谁解帝王师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归旧隐","author":"释元肇","text":"六载城尘闹压头，一朝脱屣返林丘。\n青山不远迎人笑，绿水依前绕郭流。\n随意野花开欲遍，尽情幽鸟语相留。\n门前若有敲门客，多谢山阴王子猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春","author":"释元肇","text":"顾我疏慵事事休，三间茅屋碧溪头。\n喜添新竹当门碍，踏破苍苔怕客游。\n菜叶不教随水去，松花应待及时收。\n有时乘兴登皋望，上水舟冲下水舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送正西堂","author":"释元肇","text":"弟兄相见竟何如，一见尤胜寄百书。\n况是青春三月莫，相看白首七旬馀。\n劳生衮衮谁休息，世事悠悠我定居。\n索去自言生处乐，乾坤等是一蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄鄂渚印知府","author":"释元肇","text":"黄鹤楼前鹦鹉洲，高持麾节去悠悠。\n功名自古无双地，人物当今第一流。\n句里可逢崔颢者，樽前还得祢生不。\n思君日夜廑西望，欲买浔阳江上舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞庭用白乐天韵 其一","author":"释元肇","text":"两丸跳掷几升沉，谁识仙源洞府深。\n月在波间明片玉，舟从水口出横金。\n夫差醉后无吴舞，范蠡来时有越吟。\n千古烟波兴废事，白鸥渔叟是知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞庭用白乐天韵 其二","author":"释元肇","text":"西缈东峨日未沉，洞庭山水更幽深。\n微茫雪浪疑浮玉，杳霭烟霞似紫金。\n坛上绿毛遗灶冷，橘中皓首采芝吟。\n桃花洞口年年发，自是寻人不尽心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁巳生朝","author":"释元肇","text":"露白风清八月时，晨光初度透熹微。\n更添来岁一分健，便是浮生七十稀。\n识得荣枯皆是妄，了知出处未全非。\n旁人不用相薰祝，自有天香桂子飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄冯深居","author":"释元肇","text":"人世还如客路同，可堪垂老尚飘蓬。\n旧年两向吴中见，今日相思白下东。\n乌鹊桥边望明月，凤凰台上咏秋风。\n满题红叶随流去，惆怅才高命不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董丞相去国","author":"释元肇","text":"宝祐丙辰七月前，相公力请得归田。\n圣朝已致无为治，天下今逢大有年。\n诸葛终身出师表，留侯底事学神仙。\n何人得似鸱夷子，万顷烟波一钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽高鼓院","author":"释元肇","text":"叶堕遥空万景沈，致刍谁不重伤心。\n仕当钓石归来蚤，闲比香山乐更深。\n一片新碑难载德，百年故土绝遗音。\n定从兜率天中去，莫向桃源路上寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上官右史","author":"释元肇","text":"螭坳立后别明光，岁晚婆娑庆幸堂。\n鹤怨只能随发白，菊愁竟不上腰黄。\n西归有地从先垄，北望长江是故乡。\n枌下解空情已尽，西风吹泪湿斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈府判","author":"释元肇","text":"考亭真派落姑苏，克己工夫到物初。\n文好祇教供草檄，命悭聊得坐题舆。\n循良殄瘁悲民社，儒道凋零泣里闾。\n素业可传双桂子，家留经训是菑畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆主簿","author":"释元肇","text":"洽人恩惠在乡闾，石有玙璠水有珠。\n爱日欲烘阴枳棘，寿星怅望落姑苏。\n池台旧宅流沧海，丘垄新封近太湖。\n却忆渡江同到处，寒城渺渺夜啼乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高辇院","author":"释元肇","text":"人生七十古难过，贤德如公未足多。\n晚岁伤心非故土，东洲有泪是恩波。\n青松护垄云成盖，白玉遗箴世不磨。\n湖海旧游终践约，夕阳来此挂烟蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆教授致政","author":"释元肇","text":"去秋哭子过蒸山，岂料今年逝不还。\n自是广文甘独冷，卑从神武乐高闲。\n枌闾南望无回日，莲土西归觉梦间。\n同队相看成白首，先将老泪为君潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈子翔殿元","author":"释元肇","text":"少年飞鹗上秋空，二十四青杨柳风。\n庭草未沾恩绶绿，种花空作状元红。\n三更共渡追前事，半世生涯似梦中。\n燕子归来谈寂寞，旧巢零落布洲东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清月溪","author":"释元肇","text":"万劫高超一念轻，来非住相去何曾。\n定逢葱岭当年使，谁访洪川旧日僧。\n舍利未安无缝塔，伽梨空对短檠灯。\n凌霄多少薰风泪，吹入淮南紫翠层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上雪","author":"释元肇","text":"人道瓯闽不识寒，北风吹雪夜漫漫。\n断蓬折苇沧江上，只作淮南旧日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上秋日","author":"释元肇","text":"湖上新晴人竞游，幽怀无处领清秋。\n夕阳送尽歌船了，始放钟声出寺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋莲","author":"释元肇","text":"波面盈盈照影红，月寒露重怨房空。\n鹭鸶目趁鱼行急，惊得残妆散晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荷叶浦","author":"释元肇","text":"苕花蓼穗细明川，荷盖经风半欲眠。\n隔浦有人歌宛转，日斜不见采莲船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禁渡","author":"释元肇","text":"渺渺烟江春思长，杏花风急燕归忙。\n衔泥不解如精卫，又只来巢旧屋梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"络纬","author":"释元肇","text":"沙塞风高纩帛轻，春蚕到死只吞声。\n寒机未织回文字，夜夜篱边诉月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"起夫","author":"释元肇","text":"木叶初飞夫去时，家家连夜办征衣。\n关河只在淮南北，未著寒衣可得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卖菊","author":"释元肇","text":"故国风烟几换秋，今年看菊御街头。\n长安市上人无数，只买秋光不买愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄归","author":"释元肇","text":"燕子辞巢始别家，杜鹃啼处在天涯。\n十分春事都看了，尽是他人园里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠日者","author":"释元肇","text":"君推造化最幽玄，白屋曾经定状元。\n休向深云问消息，春风只在杏花园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送人","author":"释元肇","text":"春尽江南二月时，盈盈陌上燕差池。\n游丝日暖垂千尺，不为行人系别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]