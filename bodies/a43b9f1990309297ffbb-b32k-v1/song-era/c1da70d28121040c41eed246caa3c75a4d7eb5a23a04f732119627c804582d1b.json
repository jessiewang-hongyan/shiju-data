[{"title":"醉落魄/一斛珠 其二","author":"赵善括","text":"梯横画阁。\n月明江静烟光薄。\n碧山回绕栏干角。\n一缕行云，忽向杯中落。\n樱歌柳舞俱柔弱。\n罗衣不耐江风恶。\n凭谁唤取双黄鹤。\n骑上瑶台，同赴金桃约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其一 江阁","author":"赵善括","text":"梯横画阁。\n碧栏干外江风恶。\n笑声欢意浮杯酌。\n秋水春山，相对称行乐。\n谁家青鸟穿帘幕。\n暗传空有阳台约。\n天公著意称停著。\n寒色人情，都恁两清薄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 其一 前题","author":"赵善括","text":"正彩铃坠盖，玉燕投怀，梦符佳月。\n五百年间，诞中兴人杰。\n杖策归来，入关徒步，万里朝金阙。\n贯日精忠，凌云壮气，妙龄英发。\n名镇重湖，屡凭熊轼，恩满西江，载分龙节。\n有志澄清，誓击中流楫。\n谈笑封侯，雍容谋国，看掀天功业。\n待与斯民，庆公华衮，祝公黄发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 其三 魏相国生日","author":"赵善括","text":"正槐堂日永，梅雨消尘，麦风摇翠。\n天祐昌辰，诞中兴嘉瑞。\n秀伟标姿，从容谋断，笑吐平戎计。\n汉节归来，边尘扫净，鼎司荣贵。\n间世良臣，威严辅政，妩媚承君，道襟冲粹。\n玉券金丹，称功名成遂。\n茂苑烟霞，太湖风月，聊伴凝香醉。\n补衮工夫，调羹手段，如今重试。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 其二 寿司马大监生日","author":"赵善括","text":"正百花堂下，山雨楼前，粲然梅柳。\n和气回春，滟一尊芳酒。\n桂子兰孙，凤歌鸾舞，介我公眉寿。\n天上遐龄，人间独乐，古来稀有。\n壮日题桥，儿时击瓮，名遂功成，自然长久。\n琳馆偷闲，约赤城为友。\n紫诏重颁，黄扉稳步，好试调羹手。\n九世鸡窠，千秋麟阁，玉颜依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"赵善括","text":"雨沐芙蓉秋意清。\n可人风月满江城。\n怜风爱月方留恋，对月临风又送行。\n人渐远，酒须倾。\n只凭一醉遣多情。\n重来休厌刘郎老，明月清风有素盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"赵善括","text":"我是行人更送行。\n潇潇风雨倍伤情。\n征帆西去何须急，飞诏东来分外荣。\n红袖湿，玉尊倾。\n不堪回首暮云平。\n小舟准拟随君去，要听霜天晓角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 和冠之韵","author":"赵善括","text":"忆昔南楼旧使君。\n与君携手蹑浮云。\n如今更到经行处，妙墨新诗得屡闻。\n淮南路，楚江分。\n离尊相属更论文。\n明朝一棹人千里，多少红愁与翠颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 庆佥判王状元","author":"赵善括","text":"玉殿分荣两桂华。\n灵根移植在长沙。\n风姨先绽无双蕊，月姊重开第一花。\n金榜烂，玉音加。\n从今稳步上天霞。\n休夸水击三千里，且歌笙歌十万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 翁广文席上","author":"赵善括","text":"枉道黉堂是冷官。\n深深青琐锁青鸾。\n新诗自得清歌举，和气都消永夜寒。\n花态净，酒杯宽。\n燕娇莺巧有馀欢。\n不因客里东阳瘦，好把西江一吸乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 和朱伯阳","author":"赵善括","text":"画鹢翩翩去似飞。\n季鹰何事忽思归。\n风湍自送征帆稳，云巘须将彩笔挥。\n江作酒，海为卮。\n为君满酌不须辞。\n酒酣渴思回春梦，自笑何时是足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 送林兴国之任","author":"赵善括","text":"楚天风色。\n一夜波翻雪。\n舣岸锦帆不度，天有意、且留客。\n鼓声吹取急。\n离觞须举白。\n看去芳菲时候，日边听、好消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙酉端午联句","author":"赵善括","text":"离骚读罢意沉沉，痛饮狂歌作楚吟。\n鱼腹有灵应瞑目，后来犹自有孙心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳祐壬子王正人谒仙荐芗有感而题","author":"赵善浥","text":"企仰仙岩岁已深，此行一见即知音。\n水帘不卷非朝夕，芝石长生到古□。\n孤鹤来迎疑识面，片云飞去出无□。\n相逢总是旌阳侣，唤起先生问剑□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙都石笋","author":"赵善涟","text":"昆崙失却大龙蟠，迸出层岩一角寒。\n初日烟霞翻锦箨，九天风露混琅玕。\n香涵老翠山灵护，根透鸿濛地轴安。\n天柱直疑为竹祖，仙翁图作子孙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池亭夜游","author":"赵善涟","text":"踏月清诗骨，露华夜已深。\n树摇知鸟宿，波静觉鱼沉。\n报国惭无术，思亲空有心。\n踌躇谁与语，唧唧乱蛩吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀归","author":"赵善涟","text":"游子何时返，家山万里馀。\n望云愁思切，对月赏心疏。\n相严烦龟卜，频逢绝雁书。\n浮名在京国，系我欲何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瀔水驿中","author":"赵善涟","text":"家山迢递白云遮，行役偏愁去路赊。\n朝涉桐江寒入胫，夜眠孤馆梦归家。\n几年城市成春梦，万古江山阅岁华。\n若问归装何所有，担头只许插梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题灵岩寺","author":"赵善悉","text":"江南多名山，雁荡最崒嵂。\n山中多古寺，灵岩渺无匹。\n天柱高摩云，展旗巧障日。\n风榻卧石屏，雾窗涵卓笔。\n上有小龙湫，龙鼻清泉出。\n异哉诺讵罗，来此坐叠膝。\n我亦荡中人，景象颇能悉。\n独秀玩苍翠，重台听萧瑟。\n却穿水帘谷，衣襟寒慄慄。\n还入新月洞，意气何飘逸。\n安期指瓜枣，羡门献梨栗。\n飘瓦孰是非，临歧置得失。\n平生方外游，兹游为第一。\n谩登岭三三，休跨盘七七。\n岂意山尽头，时复有禅室。\n门并双峰尖，路爽千榕密。\n触石浅溪鸣，投林飞鸟入。\n傍人应笑我，观山何时毕。\n笑话傍人道，恨我少登陟。\n作诗寄行役，吾非贪著述。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲兄书至","author":"赵善傅","text":"别后曾无一纸书，忽于今日寄双鱼。\n开缄尽是离乡思，何日重来舜里居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勉善信弟志学","author":"赵善傅","text":"白日如飞去莫羁，于今旧发弗违疑。\n为人欲立持身本，入学先培进德基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜有怀孟兄","author":"赵善傅","text":"日落寒山剪剪风，一行雁字各西东。\n虽然颜面睽千里，料得相思两地同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓居等慈寺感怀","author":"赵善傅","text":"钦从王命寄招提，寂寂荒阶绿草齐。\n明月夜深接佛阁，看来不比汴梁时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜閒 其二","author":"赵善傅","text":"向晚幽栖地，襟怀颇自宜。\n品题风与月，驱使酒兼诗。\n供兴千岩竹，应门一局棋。\n此中无俗虑，高卧复何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜閒 其一","author":"赵善傅","text":"林泉违约久，归此有馀欢。\n引水来新沼，钩帘见好山。\n渔歌能破寂，鸥侣可陪閒。\n荣辱曾何绊，怡然见考槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古楠歌用严郑公韵","author":"赵善期","text":"秀挹奇峰佳客对，凌空下视孤鸿背。\n夜□云□起山根，老蛟飞出崖裂痕。\n高高不放行云度，鸟语去来分晓暮。\n直疑种是万年枝，定应叶渍三危露。\n班输腰斧频□头，婆娑岩壑□□愁。\n□看世事了如梦，静听江声知几秋。\n巴南刺史儒林文，怜汝抱材开鉴赏。\n赓载长谣□更清，琼钩珠佩相联响。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锦绣谷亭","author":"赵善湘","text":"神仙楼观倚空攲，飞上金鳌背上骑。\n万里江山成独立，一天云雨欲低垂。\n人间安得如斯地，事外方知有此奇。\n唤取谪仙来共话，从教习日醉题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵善湘","text":"正是澄清秋雨夜，空传玉蕊发春晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝华岩","author":"赵善?","text":"宝色晴光合，浮岚薄翠微。\n天开今觉路，洞锁古神扉。\n淡拂山僧帽，闲随野客衣。\n日斜凉吹起，林壑更依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪","author":"赵善?","text":"两载真成漫浪游，丰碑重拂倍含羞。\n空怜民力疲刍粟，滥厕时贤动冕旒。\n病骨讵堪胜重寄，归舟喜不负清流。\n家山屈指朝朝□，□老休劳念□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿西湖净寺听僧乐梵呗","author":"赵善漮","text":"天涯知己集琳宫，文武升沉气味同。\n仙乐几回来座上，梵音半夜落天中。\n幻身何日脱尘劫，慧眼于今识色空。\n兴尽归来情不尽，晨昏隐隐丽谯东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游西山 其一","author":"赵善漮","text":"閒向西山顶上游，碧天高挂晚云收。\n雨馀花气浓如酒，风鼓松声冷似秋。\n险句每惊神鬼泣，雅怀不贮古今愁。\n恍疑身在蓬莱境，笑指前溪当弱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游西山 其二","author":"赵善漮","text":"古庙嵯峨占地灵，四山环抱耸螺青。\n松坛鹤去云无伴，石洞龙归雨亦腥。\n弛担樵歌屯别径，倚蓬渔笛起前汀。\n个中真觉凝眸豁，一点心无俗虑萦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中驾幸敝庐恭纪","author":"赵普","text":"贞元重数荚，滕六剧霏花。\n漠漠初濡砌，皑皑欲聚沙。\n闾阎银作界，宫阙玉为家。\n调鼎惭盐撒，沾温觉絮加。\n瑞凝三殿瓦，欣动五云车。\n冰柱撑茅屋，琼枝拥翠华。\n微行停跸警，冷漏静街哗。\n具野曾无隗，磻溪岂问牙。\n公然门驻辇，那信室盘蜗。\n积素堪麟画，飞黄想兔罝。\n一庭看曳练，十道趣宣麻。\n戎索筹先后，雄才辨等差。\n神威殷地轴，御指落天花。\n表贺甘朝稳，裴功敢夜誇。\n雪山行献琯，早晚到星槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游延福寺","author":"赵曾頀","text":"行行出西郊，稍觉嚣尘远。\n风景既已殊，硗确颇忘倦。\n南安古雄州，今亦壮哉县。\n九日一佳景，居然在郊甸。\n地高瞰川原，林杪露堂殿。\n晋朝松百章，存者才一见。\n岁月不我留，寒暑几更变。\n当年秦隐君，轩冕非所羡。\n间关剡溪来，至此获胜践。\n结庐巢其巅，穴石为之砚。\n城市不到足，公卿罕窥面。\n邂逅有至交，相从情缱绻。\n缅怀兴元年，致位在台铉。\n扶持公道开，不绝几如线。\n一言才见疏，斥逐遽遭谴。\n天教流落馀，乃遂山林愿。\n当年筑室处，遗址了难辨。\n独有高士峰，千载猿鹤怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白莲堂 其二","author":"孙邦","text":"心地白莲俱有种，要须功德水方开。\n因师一语千花现，人各始知来处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洴溪桥","author":"赵渥","text":"油井小聚，洴溪之滨。\n夏秋雨集，沟浍皆盈。\n众水所汇，实病于行。\n谁作斯桥，庞君守真。\n宁瘠一己，而利他人。\n此心与桥，为世通津。\n我观地水，如车转轮。\n陵谷变迁，成毁有因。\n桥不足恃，所恃者仁。\n仁者之心，与石不磷。\n矢我铭诗，刻此坚珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺","author":"赵温之","text":"琼姿冰体。\n料莹光乍傅，广寒宫里。\n北陆寒深，南园春先，此后万花方起。\n剪霞斗萼，栽芯砌□，天与高致。\n大潇洒，最宜雪宜月，宜亭宜水。\n好是。\n天涯庾岭上，万株浮动香千里。\n屏写横斜，鬟插垂袅，占尽秀骨清意。\n醉魂易醒，吟兴信来，佳思无际。\n为传语，向东风，甘使无言桃李。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏青游","author":"赵温之","text":"竹外溪边，一枝破寒冲腊。\n莹素肌、玉雕冰刻。\n赋闲标，足馀韵，岂同常格。\n最风流，生来处处尽好，别得造化工力。\n疏影幽香，意思迥然殊绝。\n算不枉、诗人分别。\n冻云深，凉月皎，愈增清冽。\n大潇洒，尤得静中雅趣，不许莺栖燕歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行","author":"赵温之","text":"妖艳相偎，清香交喷。\n花王尤喜来亲迎。\n有如二女事唐虞，群芳休更夸相并。\n小雨资娇，轻风借润。\n天应知我怜孤韵。\n莫惊岁岁有双葩，仪真自古风流郡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太后阁六首 其三","author":"韩维","text":"平晓开朱户，轻寒御练衣。\n宫童移钿扇，庆寿早朝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太后阁六首 其二","author":"韩维","text":"玉律生阳早，金铺上日迟。\n枝间双鹊语，应是报春祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太后阁六首 其一","author":"韩维","text":"正阃成王化，开宫奉母仪。\n身当四海养，寿祝万年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太皇太后阁六首 其五","author":"韩维","text":"长乐钟残宝殿开，鸣梢移仗问安来。\n欲知纯孝通天地，和气氤氲绕御杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太皇太后阁六首 其六","author":"韩维","text":"残冰未放沟声滑，小雨频催柳色新。\n昼漏渐长无一事，坐披黄老味天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太后阁六首 其五","author":"韩维","text":"綵仗朝来散玉京，绮窗新网结初晴。\n静呼宫女教调曲，闲引皇孙看学行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太后阁六首 其四","author":"韩维","text":"金花镂胜随春燕，綵仗萦丝逐土牛。\n迎得韶华入中禁，和风次第遍神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太后阁六首 其六","author":"韩维","text":"九奏清新称玉斝，八珍和旨奉兰羞。\n须知天子娱亲意，不为乘春事燕游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太皇太后阁六首 其四","author":"韩维","text":"镂成宝字题宫户，剪出名花趁御筵。\n人世不知春色早，忽惊歌吹下中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太皇太后阁六首 其一","author":"韩维","text":"位历三朝重，风行四海深。\n坐将仁厚意，潜助发生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太皇太后阁六首 其二","author":"韩维","text":"铜霤消残冻，朱楼拂早霞。\n传声回步辇，来赏小桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太皇太后阁六首 其三","author":"韩维","text":"视膳回天仗，含饴乐圣辰。\n定应彤管笔，书美系王春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夫人閤春帖子 其一","author":"赵湘","text":"渐暖正当挑菜日，轻阴新变养花天。\n君王勤政稀游幸，院院相过理管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夫人阁四首 其一","author":"韩维","text":"腊雪馀香径，朝晖上绮甍。\n翠生兰蕙色，和入管弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夫人阁四首 其二","author":"韩维","text":"重锦褰妆幕，轻罗换舞衣。\n钗头双燕子，先向社前飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁五首 其四","author":"韩维","text":"紫兰红蓼簇春盘，晓逐金壶下太官。\n朝遍三宫归已晚，日华明丽雪消残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁五首 其五","author":"韩维","text":"葭灰已逐阳和动，绣缕初随日景加。\n欲助君王修俭德，不将宫样织新花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁五首 其二","author":"韩维","text":"春色平明到，微风弄綵幡。\n稍回宫柳弱，更助壁椒温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁五首 其一","author":"韩维","text":"后德侔姬国，嫔风协舜家。\n进贤阳为长，修教月增华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁五首 其三","author":"韩维","text":"暖日晖晖动，清渠决决流。\n六宫修岁事，拂拭采桑钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子皇帝阁六首 其五","author":"韩维","text":"晴日渐消宫瓦雪，和风微散御炉烟。\n千官拜舞皇恩罢，綵胜金幡下九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子皇帝阁六首 其六","author":"韩维","text":"早莺啼滑知寒薄，午马休迟觉昼长。\n四海欢康几务暇，箫韶时奉万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子皇帝阁六首 其一","author":"韩维","text":"和气生金殿，微风转画旗。\n年年好春色，先是帝家知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子皇帝阁六首 其四","author":"韩维","text":"昼漏新添刻，春寒早放班。\n恩随宽大诏，一日遍人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子皇帝阁六首 其二","author":"韩维","text":"迎气来归胙，宜春祝降祥。\n皇心勤治切，应喜寸阴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子皇帝阁六首 其三","author":"韩维","text":"醇醴浮金斝，柔蔬饤玉盘。\n尝新兼介寿，齐奉两宫欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]