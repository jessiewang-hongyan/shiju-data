[{"title":"龟潭二首 其二","author":"孙觌","text":"风涟细娟娟，月彩光瀰瀰。\n庭空韵琴筑，故入幽人耳。\n皓白有真色，澹泊非世味。\n谁能听蛙淫，唤汝作鼓吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中泊蜀山见渔人自山半负樵入舟鼓棹而去","author":"孙觌","text":"一嶂横青霭，千沤起碧浔。\n行穿山半腹，坐占水中心。\n蹋雨松蹊滑，冲烟蓼屿深。\n时来有登涉，应不系升沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡桥别墅","author":"孙觌","text":"覆地红深寸，连村翠著行。\n桑空蚕箔满，芹老燕泥香。\n且泥无何饮，徐思有底忙。\n独谣无语悟，倚杖立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示龟潭文上人二首 其一","author":"孙觌","text":"露盖青相倚，云屏翠作围。\n石泉鸣牛枕，径藓上春衣。\n井遂登晨汲，庖烟起夕霏。\n浮生眠食耳，终不羡轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示龟潭文上人二首 其二","author":"孙觌","text":"扫石风生坐，披云雨湿衣。\n飘飘一蝉脱，猎猎两凫飞。\n伏槛观鱼乐，钩帘待燕归。\n疏钟何处寺，出谷自依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读类说二首 其一","author":"孙觌","text":"亡是谈乌有，彭郎得小姑。\n谁言鸠作妇，谩道雁为奴。\n络纬那能织，提壶岂解酤。\n龟兹堪一笑，非马亦非驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读类说二首 其二","author":"孙觌","text":"额痒会出耳，足闲仍有氂。\n石顽飞作燕，楮老孕生鸡。\n枫瘿那因怒，松枋岂是肥。\n君看转丸手，亦复化神奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示枫桥温老","author":"孙觌","text":"阖闾曾城外，寒山古道西。\n若人具双眼，与佛拍肩齐。\n白浪喷鹢首，黄尘送马蹄。\n憧憧南北路，一榻有高栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枫桥璨书记出示近赋长句为诗答之","author":"孙觌","text":"白氎青鞋竹杖随，伏犀插脑看魁奇。\n水如说法翻千偈，山似哦诗蹙两眉。\n率尔扣门依佛宝，欣然命驾有心期。\n匆匆班草河桥上，几日重临慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读灵岩圆首座诗卷二首 其一","author":"孙觌","text":"长廊籍籍履声中，邂逅欢迎得此公。\n会续千灯齐古佛，先拈一瓣供诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读灵岩圆首座诗卷二首 其二","author":"孙觌","text":"万境崩腾倒笔前，飘飘落纸似云烟。\n要看墨妙供千手，莫遣诗翁入两肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"能仁寺悟上人来枫桥访余索诗赋两绝句 其一","author":"孙觌","text":"撚断吟须皱两眉，镂冰琢雪等儿嬉。\n解题孤月如鸡口，堪笑穷郊作许悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"能仁寺悟上人来枫桥访余索诗赋两绝句 其二","author":"孙觌","text":"老去都将笔砚焚，相逢相问只寒温。\n更无一语堪酬对，已入维摩不二门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读沈公序诗卷","author":"孙觌","text":"读书过眼亦千年，脱帽挥毫涌百泉。\n句出惊传龙菌蠢，赋成争诵蜺连蜷。\n铜池茎叶三山秀，玉井根株七泽连。\n容貌魁梧端可想，不应诗瘦自臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟潭二首 其一","author":"孙觌","text":"摆落攀缘断，驱除磊磈平。\n庭松敌老健，潭水伴孤清。\n待月出时看，寻云起处行。\n相随木上坐，徙倚到参横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟潭二首 其二","author":"孙觌","text":"投老一无取，游空百不闻。\n莫参东阁吏，恐污北山文。\n心定对止水，身闲卧白云。\n嗒然吾丧我，何意傲人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山阳守吴子仁遗两鹤喜而赋诗二首 其一","author":"孙觌","text":"本自骖鸾驾，何因下爵罗。\n未冲霄汉去，且傍水云过。\n收拾为闲伴，提携作好歌。\n莫怀轩冕意，风月共婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山阳守吴子仁遗两鹤喜而赋诗二首 其二","author":"孙觌","text":"缟袂真仙驭，玄裳羽客衣。\n千年令威至，万里佐卿归。\n蹋雨青苔院，栖烟白板扉。\n萧条真老伴，相对两忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟过湖洑泊丁山二首 其一","author":"孙觌","text":"鸡犬三家市，蓬蒿一亩宫。\n萝牵篱羃翠，萚陨砌堆红。\n宿鸟来还去，微泉咽复通。\n幽寻殊未已，落日满疏桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟过湖洑泊丁山二首 其二","author":"孙觌","text":"日下残红敛，烟升积翠重。\n鸥轻波浩荡，鱼乐自从容。\n野馌迎秋穫，邻讴相夜舂。\n田翁有真意，一笑酒中逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题洪巨济中大鄱阳园亭四咏 其一 协趣亭","author":"孙觌","text":"一邱破天巧，万壑回春姿。\n使君载酒地，不著鼓吹随。\n翛然一幅巾，自与幽人期。\n水浅欲平杯，风细不满旗。\n疏疏残雨里，独理钓鱼丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题洪巨济中大鄱阳园亭四咏 其二 翠屏洞","author":"孙觌","text":"千岩紫翠中，缥缈浮画栋。\n屏风十二叠，坦坦见空洞。\n攒青照坐寒，老翠湿衣重。\n度曲挽云留，举杯邀月共。\n乐矣殊未央，正作南柯梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题洪巨济中大鄱阳园亭四咏 其三 绿杨桥","author":"孙觌","text":"津树正青青，水拍两岸平。\n千章云外合，一勺烟中横。\n叶密翳鸟语，波清见鱼行。\n湾埼雨初乾，陂露雪正晴。\n谁来听山公，著屐过桥声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题洪巨济中大鄱阳园亭四咏 其四 艮庵","author":"孙觌","text":"高人擅一壑，青山独当门。\n拄笏坐终日，似与若人言。\n微云抱巘出，细溜触石喧。\n绝壁挂夜斗，曾甍上朝暾。\n更探东篱菊，共尽北海尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春霁二首 其一","author":"孙觌","text":"好雨连清夜，寒声满四檐。\n浣此红点注，著柳翠条纤。\n宿潦推舟起，舂涂上屐黏。\n家家挥耒出，途咏满苍黔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春霁二首 其二","author":"孙觌","text":"清飙洗睡昏，好雨惬幽欣。\n共喜当春至，偏宜入夜闻。\n跳波通辙涸，流润驻炉薰。\n潋潋沙头绿，晴来已十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书事二首 其一","author":"孙觌","text":"坐睡抛书卷，行歌泥酒杯。\n那能钻故纸，莫自耻虚罍。\n闲把吟须撚，欣逢笑口开。\n独醒竟何事，空腹吼饥雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书事二首 其二","author":"孙觌","text":"谋身殊落落，随俗信悠悠。\n但使真心住，何嫌老语偷。\n乘风岂有待，过坎且复休。\n人生如寄耳，岂恨拙于鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草堂路遇大风二首 其一","author":"孙觌","text":"覆地云为簇，填空浪作堆。\n昂昂天上坐，虺虺石中雷。\n澒洞千沤发，喧豗百蛰开。\n白鸥底心性，玉羽自毰毸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草堂路遇大风二首 其二","author":"孙觌","text":"云屋互出没，风扇自阖开。\n孤舟系桑本，一曲并岩隈。\n翠甲连筐载，赪鳞贯柳来。\n殷勤慰牢落，为覆掌中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题惠声伯溪亭","author":"孙觌","text":"小槛大红直欲然，乔林老翠自生烟。\n云萝属地青霞帔，雨筴填沟赤仄钱。\n折柳贯鱼初受钓，解龟挽酒看垂莲。\n便须秉烛追良夜，花减春归又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪夜宿致思庵","author":"孙觌","text":"霏霏竹间云，练练天上雪。\n谁遗碧玉壶，化作白银阙。\n孤怀惬幽欣，一笑暖栗冽。\n寒光注老眼，谓是山吐月。\n耿耿清不眠，夜半听竹折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上怀思永二首 其一","author":"孙觌","text":"沙老犹生觜，江寒已伏槽。\n长烟分聚落，短日下亭皋。\n木脱曾巢见，潮生小艇高。\n幽怀谁与悟，不见酒中豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上怀思永二首 其二","author":"孙觌","text":"绝徼三叉路，连舻万斛船。\n一区江上宅，百榼酒中仙。\n有土能埋玉，无胶可续弦。\n摩挲绿苔石，屐齿尚依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读刘方叔诗卷二首 其一","author":"孙觌","text":"雄奇郊岛上，清绝晋隋间。\n已突黄初过，遥追正始还。\n冥搜逐幽好，巧发露天悭。\n莫作鸢肩看，诗成耸两山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读刘方叔诗卷二首 其二","author":"孙觌","text":"思如涌泉出，句似琢冰清。\n刻烛翻千偈，撞钟助一鸣。\n磨天无刃迹，掷地有金声。\n好是衔杯处，云烟落纸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"独坐","author":"孙觌","text":"真境闲自见，衰容老更侵。\n却无愁可解，祇有病相寻。\n莫引千钧发，须存一寸心。\n澹然无愠喜，龟息自深深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十四日半夜大雷雨许楙仲有诗次韵三首 其一","author":"孙觌","text":"万炬红莲陆海中，车如流水马如龙。\n九街画鼓春声满，百柁琼艘蜡味浓。\n底事狂雷翻地轴，叵堪笑电破天容。\n冲泥蹋雨寻归路，竹杖芒鞋取次供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十四日半夜大雷雨许楙仲有诗次韵三首 其二","author":"孙觌","text":"覆雨翻云一霎中，雷鞭击柱起乖龙。\n推愁正倚三杯酽，破睡那能一枕浓。\n桑下持锄如许健，席间失箸若为容。\n诗翁只作啼婴看，万斛珠玑唾手供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十四日半夜大雷雨许楙仲有诗次韵三首 其三","author":"孙觌","text":"尚见暗尘随驷马，忽惊飞电扰群龙。\n玄云合沓涛头上，白雨浑酣乳面浓。\n淡碧鳞鳞生晓涨，小红漠漠放春容。\n只应便作寻芳计，好把鸱夷载酒供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十五日荆溪馆然灯燕北客用前韵","author":"孙觌","text":"虎鼠同游十二宫，何妨蛇蚓杂蛟龙。\n荧煌宝树繁星合，泛艳金茎湛露浓。\n海鸟定知惊矍铄，濠鱼且乐共从容。\n贾生欲系单于颈，应费朝家五饵供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅二首 其一","author":"孙觌","text":"北风剪水玉花飞，翠袖凌寒不自持。\n脉脉含情无一语，水边篱落立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅二首 其二","author":"孙觌","text":"纤纤萝蔓牵茅屋，细细苔花点石矼。\n梦断酒醒山月吐，一枝疏影卧东窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨二首 其一","author":"孙觌","text":"风卷三江立，雷穿九地鸣。\n捎林百鸟散，破柱一龙惊。\n满树春声合，连甍晓溜倾。\n坐看流恶尽，邑里一时清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨二首 其二","author":"孙觌","text":"池涸萍黏块，畦荒麦聚埃。\n乖龙一味睡，幽鸟百般催。\n药裹蒸生菌，衣篝润作梅。\n殷勤一夜雨，洗出翠千堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹间看雪二首 其一","author":"孙觌","text":"乍闻槁雪堕窗前，已见飞花舞道边。\n梦断忽惊山竹裂，一灯照我拥书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹间看雪二首 其二","author":"孙觌","text":"受风岂免长低首，戴雪何妨暂折腰。\n莫道此君无特操，风回雪霁便昂霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题杨令藏春坞三首 其一","author":"孙觌","text":"千岁鹤林仙，故家今尚存。\n吟律破阴冱，扣弦召春温。\n王母仍留核，韩郎为染根。\n暗香先到处，已返玉梅魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题杨令藏春坞三首 其二","author":"孙觌","text":"汝阳红槿帽，欲挽春风回。\n不用宝刀截，试看羯鼓催。\n玉树日日新，金莲步步开。\n仍须觅春草，随人处处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题杨令藏春坞三首 其三","author":"孙觌","text":"花发武陵源，水满蓝桥路。\n人面相映红，迎笑得崔护。\n蜂蝶谩纷纷，寻春不知处。\n时见一叶红，相随水东去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"累石作小山凿池引水注之","author":"孙觌","text":"移山老翁愚，埋盆小儿嬉。\n高蹈遗世纷，幽欣可人意。\n倚树看蜂衙，挑灯照花睡。\n乐哉何所忧，俛仰可卒岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建安掾朱彦实调同安丞归莆田枉道过余十日而别二首 其一","author":"孙觌","text":"公子命巾车，千里过我庐。\n惊飞庭尉爵，喜见丈人乌。\n倚壁方挽膝，推琴欲揽须。\n殷勤更秉烛，孤闷一时摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建安掾朱彦实调同安丞归莆田枉道过余十日而别二首 其二","author":"孙觌","text":"巢枝良易安，瓢饮有馀欢。\n栖栖枳棘间，矫矫如龙鸾。\n抱牍凫鹜进，落笔蛇蛟蟠。\n但令填纸尾，只作马槽看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟潭道中","author":"孙觌","text":"沙净溪行好，烟消野望新。\n数峰山戴雪，一曲坞藏春。\n鱼逐波间伴，禽藏叶底身。\n柳边春信动，眉目已津津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牛山道中","author":"孙觌","text":"松云翠离披，竹日光破碎。\n青荧麦风过，红湿花露坠。\n萍开龟曳尾，树啄鸟擘喙。\n物物如贶予，欣然与心会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罨画连雨溪涨丈馀雨霁水落喜而赋诗二首 其一","author":"孙觌","text":"编筏沿村径，囊沙壅市门。\n苍鳞封老干，黄耳上陈根。\n屋破容身窄，天低望眼昏。\n溪边高树杪，犹有系舟痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罨画连雨溪涨丈馀雨霁水落喜而赋诗二首 其二","author":"孙觌","text":"月挂楼钟晓，风生岛树秋。\n林疏山献状，池漫水分流。\n鹊喜如窥牖，鸥驯亦并舟。\n一声何处笛，莫遣碧云留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈公序亦爱亭二首 其一","author":"孙觌","text":"吟牵东阁兴，静憩北窗眠。\n窟小中生月，文高迥入玄。\n回看甲乙第，已到巳辰边。\n不见门生莠，歌钟尚隐然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈公序亦爱亭二首 其二","author":"孙觌","text":"老蔓牵檐角，青芜点石棱。\n风生长柄麈，花落短檠灯。\n危坐才容膝，攲眠但曲肱。\n胸中九云梦，芥蒂亦何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈公序馀闲亭二首 其一","author":"孙觌","text":"貌古须眉见，情高耳目遗。\n应谐聊玩世，避谤莫吟诗。\n事不关心处，身非抱病时。\n翛然无一事，痛饮是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈公序馀闲亭二首 其二","author":"孙觌","text":"隐几欲忘吾，趋营老更疏。\n判闲聊命酒，引睡谩翻书。\n祗有贫堪逐，都无愤可摅。\n乐哉聊卒岁，应信我知鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎邱沼老豫章诗僧也与余相遇于枫桥方丈诵所作徐献之侍郎生日诗有东湖孺子南极老人之句余爱其工赋小诗寄赠","author":"孙觌","text":"落景下曾城，遥烟起孤戍。\n系舟著鱼矶，曳杖扣僧户。\n忽逢丹霞侣，自诵碧云句。\n噌吰应黄钟，清绝追白纻。\n不落江西派，肯学邯郸步。\n冥搜自天得，妙中有神助。\n寅缘半日留，邂逅一笑遇。\n讵复管中窥，看沐南山雾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴壬子某南迁过疏山上一览亭见拟东坡煨芋诗刻龛之壁间诗律句法良是殆不能辨乃宣卿侍郎守临川时所拟作也后数日道次安仁县一士人吴君出宣卿诗数十解示余奇丽清婉咀嚼有味如啖蔗然读之惟恐尽于是拊卷三叹而后知公置力于斯文久矣又二十年宣卿筑室荆溪山中别营一堂以平生所蓄东坡诗文杂言长短句残章断槁尺牍游戏之作尽椟藏其中号景坡自书榜仍为记刻之某欲具小舟造观而宣卿召用今以集撰守吴门乃赋诗为之先","author":"孙觌","text":"王公制练衣，谢傅捉葵扇。\n歘若置邮然，一昔遍海县。\n东坡百世师，乘云上骑箕。\n文争日月光，气敌嵩华齐。\n诸儒望先觉，坐待成风斲。\n一斤应手挥，郢鼻无留垩。\n公生不并时，关楗同一机。\n识真属具眼，造的今中眉。\n诗亡束晰补，书受伏生所。\n神交接混茫，参差梦中睹。\n授我笔如椽，五色光属联。\n醉上金銮殿，挥泉洒谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言赠鹤林山长老二首 其一","author":"孙觌","text":"玄豹文章雾沐，老龙头角泥蟠。\n莫恨青苔蹋破，要令红柿分残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言赠鹤林山长老二首 其二","author":"孙觌","text":"黄鹤林中佛国，杜鹃花里仙山。\n粗了一生事大，来从半日僧闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东坡先生与蒋魏公游最善宣卿侍郎蓄东坡诗文自公始也心慕手追遂入于室某尝赋景坡堂诗宣卿谓余知音者遂标藏之椟中比守吴门治有状玺书褒进待制敷文阁某驰小舟往贺宣卿出诗三章见属句法华妙为一时绝唱有云正索解人那复得其谁知我固无从此真东坡语也辄次韵书于卷末 其一","author":"孙觌","text":"家声籍籍冠中州，健笔纵横贯九流。\n三世祖孙吴郡牧，两朝人物山亭侯。\n颙卬自快披云睹，衰陋空遗倚玉羞。\n便恐追锋天上去，不辞投辖为公留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]