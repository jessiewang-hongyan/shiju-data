[{"title":"趋石桥初登山岭","author":"赵屼","text":"天梯欲上使人愁，身御长风不自由。\n下视白云生涧底，仰看红日在山头。\n共传此处迷刘阮，自恐今朝犯斗牛。\n归路似从霄汉堕，却来尘世得羁囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岑崎山磨崖","author":"赵㞦","text":"洞门乔木昼阴阴，洞穴嵌空透碧岑。\n偶约骚人同此乐，摇毫静坐发清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"蔡承禧","text":"万室罗纨千舸蓬，绕山楼榭满溪风。\n舟移菡萏芬芳渚，旌倚蓬莱缥缈宫。\n翁子印还多事后，微之名辱宦人中。\n昌时青琐朱轓贵，白首谁何得似公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"蔡承禧","text":"天上玉栏花已折，人间方士术何施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题泰山灵岩寺","author":"陈一向","text":"石龟泉畔铁袈裟，上有猿衔五色花。\n见说道人时挂搭，旋将青拂扫烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠灵岩元长老 其一","author":"陈一向","text":"杖锡池边六月寒，一泓泉鉴漱琅玕。\n直疑夜半天风起，吹落仙人沆瀣盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠灵岩元长老 其二","author":"陈一向","text":"證明台上玉炉烟，童子生云不计年。\n对面飞桥架丹壑，此中别有一家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠灵岩元长老 其三","author":"陈一向","text":"浓岚滴翠晓氤氲，洗我尘襟一二分。\n归步怪来轻欲举，朝衣犹带北山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠灵岩元长老 其四","author":"陈一向","text":"五花殿角片是间，又被红尘引出山。\n第一山前聊驻马，几声鸡犬吠云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮阴有韩亭枚亭步舣舟亭下作","author":"晁端彦","text":"韩枚步骘建三亭，故显当时将相名。\n遐想古人兴废事，乃知英杰此中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无心亭","author":"晁端彦","text":"偶坐兹亭上，清风吹客襟。\n孤云方出岫，相对两无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉眠亭","author":"晁端彦","text":"人生有出处，两事固希全。\n达则都廊庙，致君尧舜前。\n声名喧宇宙，指顾生云烟。\n不然早晦隐，纵意乐当年。\n第一莫如醉，第二莫如眠。\n无悔水乡士，子瞻称其贤。\n埋照不干世，作亭临清泉。\n欢来即痛饮，酣谑竟长筵。\n陶陶非假寐，泯绝平生缘。\n尽得杯中趣，常为枕上仙。\n影从明月照，名任清风传。\n愿君遂此志，其乐更相先。\n醉无三日醒，欲尽百斛船。\n境界如古莽，魂梦游钧天。\n莫学不佞者，徇禄遭缠牵。\n进无济世志，退无负郭田。\n独醒少意绪，寡睡多烦煎。\n风波惊性命，鞍马积胝胼。\n未得立篱下，应难卧瓮边。\n区区为宿仕，短咏愧非妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙湫观瀑","author":"晁端彦","text":"万丈龙湫水，飞流翠碧开。\n泻疑云汉落，涌若海潮来。\n飘洒四时雪，喧阗万壑雷。\n庐山吾未到，气象胜天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹霞山","author":"晁端彦","text":"白鹤山头飞瀑，玉箫峰顶生烟。\n溪上空闻流水，竹间不见真仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诏修两朝国史开局日史院赐筵首相吴公席上有作奉和原韵","author":"林希","text":"调元台极贵，颁宴帝恩馀。\n昔副名山录，今裁史观书。\n天心忧作者，国论属谁欤。\n寂寞怀铅客，容瞻相府车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至吴门示诸弟兼呈伯原教授","author":"林希","text":"梦寐家山忽五春，君恩乞与守符新。\n便推白傅为前政，更得梁鸿作部民。\n入境喜逢馀秉穗，举杯无复叹鲈莼。\n左司西掖诚非据，尤是诗情愧昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之宣城留别吴门效白乐天体","author":"林希","text":"被诏守东吴，夜渡扬子津。\n拭目迎家山，洗我京洛尘。\n此邦多贤豪，况复平生亲。\n初欲循故事，公宴月三旬。\n庶以叙契阔，岂徒乐吾身。\n临州未阅月，吏牍方纷纭。\n避嫌俄得请，主地翻为宾。\n樽酒未重持，行乐知何因。\n物理可胜叹，俯仰迹已陈。\n趣整震泽帆，遥挹敬亭春。\n五月而报政，速哉彼齐人。\n今我若置邮，何德于吴民。\n举手谢吴民，自笑行役频。\n使君不能诗，烦汝迎送勤。\n来惭白太守，去愧谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺滕元发守吴兴","author":"林希","text":"清风楼下两溪春，三十馀年一梦新。\n欲识玉皇香案吏，水晶宫主谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴兴赠贾收二绝句 其一","author":"林希","text":"乐天遗句满吴门，谢朓窗中列岫存。\n试问白蘋洲上客，诗人贾岛有曾孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴兴赠贾收二绝句 其二","author":"林希","text":"岁中谩说易三麾，风月可尝有别离。\n尽是昔贤吟醉地，惜哉此老不能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"林希","text":"政事纵横绝世才，文章侍从冠邹枚。\n南州节制金城固，东省深严琐闼开。\n笑别道山探禹穴，暂辞玉案下蓬莱。\n贺家湖上中秋月，遥听新诗落酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"林希","text":"山川图写几时休，再过萧山岁已周。\n客枕梦中南又北，此身大似一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴兴","author":"林希","text":"绕郭芙蕖拍岸平，花深荡桨不闻声。\n万家笑语荷花里，知是人间极乐城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"林希","text":"壶岭共倾银霅水，墨皇犹展玉楼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"林希","text":"伤心父老江津路，犹想当年上冢行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"林希","text":"争觅山林远城市，不知城市有山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"林希","text":"江声远落西岷外，山色都横北固前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"林希","text":"雨过淮山格嫩绿，日衔沧海露残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"林希","text":"江入海门吞百粤，楼横铁瓮跨三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余至象山得邑西山谷佳处暇日过游因其亭榭泉木离为十咏 西谷","author":"林旦","text":"平昔山林性，今来水石乡。\n栽花寻秀垄，泛酒掬沧浪。\n地暖春常早，云阴夏自凉。\n岁成还北去，魂梦此难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余至象山得邑西山谷佳处暇日过游因其亭榭泉木离为十咏 应真亭","author":"林旦","text":"我爱井泉清，来逢井上铭。\n佳名知故里，绝巘为开亭。\n目外仙舟远，云闲拱木青。\n茫然千古意，谁与问沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余至象山得邑西山谷佳处暇日过游因其亭榭泉木离为十咏 桃源径","author":"林旦","text":"十亩红桃径，穿花过水西。\n清泉来不断，行客到应迷。\n露锦披芳坞，晴霞倒碧溪。\n年年春意在，当会自成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余至象山得邑西山谷佳处暇日过游因其亭榭泉木离为十咏 蓬莱泉","author":"林旦","text":"采药瀛洲去，扁舟竟不还。\n黄金成海外，故井独人间。\n乳滴岩花润，苔封石字斑。\n空令千载后，犹复望三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余至象山得邑西山谷佳处暇日过游因其亭榭泉木离为十咏 濯缨亭","author":"林旦","text":"早岁逐浮名，尘埃已倦行。\n浩然临绝岸，聊此振烦缨。\n世事随波远，吾心自水清。\n营营朝市露，谁识孺歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹闲亭","author":"林旦","text":"昔人尝种竹，此意为山林。\n野翠何凌乱，羁怀得放吟。\n化龙知有节，待凤岂无心。\n怅望山阴客，飘然不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹闲亭 曲水亭","author":"林旦","text":"岩溜抱山急，传觞何太频。\n回看野客醉，还笑浊醪醇。\n汉曲人方远，兰亭迹已陈。\n劳生无足校，酣放即天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹闲亭 灌木亭","author":"林旦","text":"行行竹间径，时此一登临。\n为有凌霄干，长垂满座阴。\n海云生远目，山月照闲心。\n幸免材为累，无言弃掷深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹闲亭 观澜亭","author":"林旦","text":"万古渊源会，凭栏誙一观。\n云涛谁可际，勺水自为难。\n日月闲中永，乾坤物外宽。\n幽人休怅望，平地亦波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹闲亭 射圃","author":"林旦","text":"百步开新圃，弯弧注采正。\n樽罍供乐事，金鼓叠欢声。\n敏手徒为妙，中心自要平。\n何人能举觯，观堵定纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘示子虙昔与次中游题榜尚存","author":"林旦","text":"一望家山上虎丘，凄然魄动念同游。\n林峦不改如平日，蒲柳先衰又几秋。\n敢学登临小东鲁，却因零落恨西州。\n鸰原寂寞归鸿断，未拂前题已泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张祜韵","author":"林邵","text":"山中多白云，云气归如吞。\n目无尘埃污，耳足清净根。\n僧归踏层径，鸟远迷孤村。\n来过人迹少，无客扫松门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孟郊韵","author":"林邵","text":"山僧庞眉苍，翻径坐禅床。\n层轩豁远目，静室便异香。\n微风仙籁响，过雨晴岚光。\n何须向庐阜，此即真道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋赠玉岩 其一","author":"林颜","text":"人在通天第几岩，玉岩形胜最潭潭。\n三钟攘臂适吾乐，五斗折腰真尔惭。\n漫浪著书酬素志，逍遥齐物载清谈。\n超然此道人知少，人日先生为指南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋赠玉岩 其二","author":"林颜","text":"万卷收书肯为贫，长年石室谢纷纭。\n冥鸿有志难寻迹，野鹿无心不出群。\n拔俗风标清似水，视人富贵薄于云。\n柄臣欲强东山起，只恐东山未放君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠玉岩二绝 其一","author":"林颜","text":"一童一鹿自相随，不觉山间笋蕨肥。\n看尽荣枯弹指顷，烧痕青处认春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠玉岩二绝 其二","author":"林颜","text":"瞥然飞电□双瞳，短褐长绦如瘦松。\n白玉岩中无一事，为君题作玉岩翁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜乐池","author":"林颜","text":"石室巉岩五十重，洞房七十二芙蓉。\n夜池惟有仙家乐，笙鹤时来古涧松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彩云轩","author":"林颜","text":"曾是麻姑此降真，玉峰依旧碧桃春。\n他年欲洗尘埃眼，得见红颜散发人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶见蜘蛛因成四韵","author":"翟嗣宗","text":"织丝来往疾如梭，长爱腾空作网罗。\n害物身心虽甚小，漫天纲纪亦无多。\n林间宿鸟应嫌汝，帘外飞蛾亦惧他。\n莫学螳螂捕蝉勇，须知黄雀奈君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古松行","author":"郭祥正","text":"空山古松阅人代，黛色铜姿终不改。\n蚴蟉诘曲还相向，千寻气结云叆叇。\n风雨冥冥秋气深，耳边往往苍龙吟。\n蓬莱仙子有无间，往来白鹤昼常阴。\n百尺樛枝拓金戟，山中十月飞霹雳。\n千年化作虬龙形，流脂下见成灵珀。\n方今楼阁连飞甍，斧斤未敢来相倾。\n晦冥神物共诃护，一物钟灵无不轻。\n我来抚此重叹息，造物由来贵孤直。\n趺坐松前日将暝，谡谡寒风落巾帻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉歌行","author":"郭祥正","text":"明月珠，不可襦，连城璧，不可餔。\n世间所有皆虚无，百年光景驹过隙，功名富贵将焉如。\n君不见北邙山，石羊石虎排无数。\n旧时多有帝王坟，今日累累蛰狐兔，残碑断碣为行路。\n又不见秦汉都，百二山河能险固。\n旧时宫阙亘云霄，今日原田但禾黍，古恨新愁迷草树。\n不如且买葡萄醅，携壶挈榼閒往来。\n日日大醉春风台，何用感慨生悲哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古剑歌","author":"郭祥正","text":"古有名剑似秋水，龙盘虎拿焰欲起。\n鸡林削铁不足言，昆吾百炼安足齿。\n淬花曾瑩鸊鹈膏，掉箾却敲鸾凤髓。\n忆昔破敌如破竹，带霜飞渡桑乾曲。\n电光昼闪白日匿，魑魅走逃罔魉伏。\n于今锈涩混铅刀，夜凉风雨青龙哭。\n冰翼云淡雪花白，血痕冷剥苔花绿。\n我来拔鞘秋风前，毛发凛凛肝胆寒。\n书生无用暂挂壁，夜来虎气腾重泉。\n酒酣闻鸡起欲舞，明星错落银河旋。\n吾闻神物不终藏，丰城紫氛斗牛旁。\n及时与人成大功，岂肯弃置钝锋铓。\n会当斩蛟深入吴潭里，不然仗汝西域击名王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔舟歌","author":"郭祥正","text":"四山飒沓江水流，两岸西风芦荻秋。\n渔歌杳杳隔港浦，烟波冥冥来孤舟。\n渔人举网得赤鲤，鱼尾筛筛相顾喜。\n撑船就岸维树旁，夕阳篷底炊烟起。\n白鹭洲边随意浴，孤云岩际无心逐。\n月明烟岸撇波去，格磔一声山水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楚江行","author":"郭祥正","text":"吾生磊落无滞留，一生好作大江游，任尔龟鼍跋浪蛟龙愁。\n昨夜天风下荆楚，我来此地重怀古。\n洛妃湘女不足数，渺渺兮三闾在何所。\n浩荡烟波江水阔，冥寞神交两相许。\n倒提金斗倾浊醪，滴沥招魂寂无语。\n斜阳衔山暝潮退，两两渔舟迷向背。\n便欲因之垂钓竿，六鳌一掷天门外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九华山行","author":"郭祥正","text":"群山秀色堆寒空，九华一簇青芙蓉。\n谁云九子化为石，聚头论道扶天公。\n深岩自积太古雪，烛龙缩爪羞无功。\n湍流万丈射碧落，此源直与银河通。\n尘埃一点入不得，烟雾五色朝阳烘。\n有时昏昏雷电怒，崩崖裂壁挥长松。\n龙作雨，虎啸风。\n白日变明晦，九子亦惨容，褐冠释氏胡为笑傲于其中。\n我将学彼术，卷舌切愧求童蒙。\n天公信玉女，号令不尔从。\n嗟尔九子竟何补，非泰非华非衡嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谷帘水行","author":"郭祥正","text":"崭崭青壑仙人居，水精帘挂光浮浮。\n中有天乐振天响，真珠琤淙碎珊瑚。\n嫦娥拥月夜相照，天光地瑩倒玉壶。\n又云玉皇醉玉液，琼簟千尺从空铺。\n卧来北斗谏以起，惊风吹落青山隅。\n溶溶万古万万古，竟谁能辨为真虚。\n我来吟哦不知晚，山云四暗山魈呼。\n安得长鲸驾天险，下视灵源知有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹦鹉洲行","author":"郭祥正","text":"猛虎磨牙齿九州，祢生何事来揶。\n黄云屯屯宴宾客，故衣脱去更岑牟。\n渔阳掺挝曲声苦，壮士衔悲寂无语。\n汉朝社稷四百年，海泻涛淙一抔土。\n嗟哉鼓史狂而痴，天运往矣安能追。\n四方血战殊未已，三尺棁杖真何为。\n君不见武昌之国鹦鹉洲，至今芳草含春愁。\n可行则行止则止，死无所益令人羞。\n死无所益令人羞，黄祖曹公均一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潜山行","author":"郭祥正","text":"笑别姑熟州，来作潜山游。\n潜山闻名三十载，写望可以销吾忧。\n晴云如绵挂寒木，广溪镜静涵明秋。\n山头石齿夜璨璨，疑是太古之雪吹不收。\n信哉帝祖驻銮跸，异景怪变谁能求。\n若非青崖见白鹿，安得此地排珠楼。\n群仙长哦空洞绝，绿章封事乘虚辀。\n灵鸟盘旋老鹤舞，华灯散采祥飙浮。\n噫吁嚱，汉武登坛求不得，明皇夜梦推五百。\n宁知司命抱真符，为宋真人开社稷。\n诏书数下修琳宫，殿阁缥缈平诸峰。\n六朝德泽施愈远，九天福祐来无穷。\n君不见潜山之下，潜水之涯。\n菖蒲有九节，白术多紫花。\n采之百拜献君寿，陛下盛德如重华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟","author":"郭祥正","text":"山中吟，白日长，碧霄泉暖菖蒲香。\n仙翁劝我采为食，登高遂觉足力强。\n登高望远远思发，春风浩浩天茫茫。\n美人一别隔沧海，青鸟寄与双明珰。\n青鸟东飞亦不返，草色绿缛云徜徉。\n草色几回绿，云飞无故乡。\n魂迷梦断意何在，山中吟，白日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中乐","author":"郭祥正","text":"寻山佳兴发，一夜渡江月。\n首到庐江元放家，水洞清光数毫发。\n爱之便欲久栖息，又闻灵仙之境敞金阙。\n清风吹我衣，不觉过皖溪。\n危梁千步玉虹卧，松行十里青龙归。\n烟霞绕脚变明晦，忽见殿阁铺琉璃。\n重檐却在迥汉上，倚栏俯视白日低。\n虚庭自作箫籁响，屋角更无飞鸟飞。\n霓幡重重蔽真御，彷佛遥见星文垂。\n长廊纱笼绝笔画，老龟稳载青瑶碑。\n更逢逍遥不死客，齿清发翠桃花肌。\n箫台可到亦非远，云间况有白鹿骑。\n细窥绝景辄大笑，吾曹何事尘中为。\n安得良田三百亩，可以饱我妻与儿。\n长年只在名山里，万事纷纷都不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]