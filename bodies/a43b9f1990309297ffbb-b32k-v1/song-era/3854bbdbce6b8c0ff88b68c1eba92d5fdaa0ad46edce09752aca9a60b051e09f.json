[{"title":"过兴教赠钊上人","author":"苏辙","text":"四十年间此院留，临河看尽往还舟。\n同来并是三年客，听说行藏各自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过豫章","author":"苏辙","text":"白屋可能无孺子，黄圭不是欠陈蕃。\n古人冷淡今人笑，湖水年年刺旧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"两中秋绝句二首 其二","author":"苏辙","text":"两逢重九尉佗城，蜑叟相从倒酒瓶。\n十二年来均寂寞，此心南北两冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"两中秋绝句二首 其一","author":"苏辙","text":"颍川城下两中秋，金气初凝火尚流。\n脾病家人不教饮，官厨好酒亦难求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初至金陵","author":"苏辙","text":"山川过雨晓光浮，初看江南第一州。\n路绕匡庐更南去，悬知是处可忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巫山庙乌","author":"苏辙","text":"巫庙真人古列仙，高心独爱玉炉烟。\n饥乌巧会行人意，来去纷纷噪客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"补种牡丹二绝 其一","author":"苏辙","text":"野草凡花著地生，洛阳千叶种难成。\n姚黄性似天人洁，粪壤埋根气不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰九月重九与父老小饮四绝 其四","author":"苏辙","text":"尉佗城下两重阳，白酒黄鸡意自长。\n卯饮下床虚已散，老年不似少年忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰九月重九与父老小饮四绝 其一","author":"苏辙","text":"九日龙山霜露凝，龙川九日气如烝。\n偶逢闰月还重九，酒熟风高喜不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰九月重九与父老小饮四绝 其三","author":"苏辙","text":"客主俱年六十馀，紫萸黄菊映霜须。\n山深瘴重多寒势，老大须将酒自扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰九月重九与父老小饮四绝 其二","author":"苏辙","text":"获罪清时世共憎，龙川父老尚相寻。\n直须便作乡关看，莫起天涯万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻三游南山九首 传经台","author":"苏辙","text":"轮扁不能令子巧，老聃虽智若为传。\n遗经尚在台如故，弟子今无似喜贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻濠州七绝 四望亭","author":"苏辙","text":"唐史不闻刘嗣之，空传短李旧歌诗。\n高亭毁尽唯存记，犹有区区父老知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻濠州七绝 观鱼台","author":"苏辙","text":"庄子谈空惠子听，郢人斤斧俟忘形。\n莫嗟质丧无知者，对石何妨自说经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻濠州七绝 浮山洞","author":"苏辙","text":"洞府元依水面开，秋潮每到洞门回。\n幽人燕坐门前石，长看长淮船去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻濠州七绝 涂山","author":"苏辙","text":"娶妇山中不肯留，会朝山下万诸侯。\n古人辛苦今谁信，只见清淮入海流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻濠州七绝 逍遥堂","author":"苏辙","text":"猖狂战国古神仙，曳尾泥涂老更安。\n厌世乘云人不见，空坟聊复葬衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻濠州七绝 彭祖庙","author":"苏辙","text":"长说先师似老彭，共疑好学古书生。\n不知亦解餐云母，白日登天万事轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子瞻濠州七绝 虞姬墓","author":"苏辙","text":"布叛增亡国已空，摧残羽翮自令穷。\n艰难独与虞姬共，谁使西来敌沛公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋州园亭三十咏 其三 书轩","author":"苏辙","text":"绿竹覆清渠，尘心日日疏。\n使君遗癖在，苦要读文书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋州园亭三十咏 其三十 北园","author":"苏辙","text":"使君美且仁，遍地种桃李。\n岂独放春花，行看食秋子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋州园亭三十咏 其二十九 南园","author":"苏辙","text":"官是劝农官，种桑亦其所。\n安得陌上人，隔叶攀条语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋州园亭三十咏 其十 待月台","author":"苏辙","text":"夜色何苍苍，月明久未上。\n不上倚城台，无奈东南嶂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋州园亭三十咏 其六 荻浦","author":"苏辙","text":"离披寒露下，萧索微风触。\n摧折有馀青，从横未须束。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋州园亭三十咏 其二十一 禊亭","author":"苏辙","text":"觞流无定处，客醉醒还酌。\n毋令仲御歌，空使人惊愕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋州园亭三十咏 其十四 霜筠亭","author":"苏辙","text":"林高日气薄，竹色净如水。\n寂历断人声，时有鸣禽起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和毛君州宅八咏 其一 凤凰山","author":"苏辙","text":"山川蟠踞偶成形，威凤低回久未行。\n更种梧桐真可致，高飞性似伯夷清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和毛君州宅八咏 其八 山房","author":"苏辙","text":"岸帻携筇夜夜来，蒲团纸帐竹香台。\n直须觅取僧为伴，更为开庵斸草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和毛君州宅八咏 其三 方沼亭","author":"苏辙","text":"池上茅檐覆水低，早来秋雨尚虹霓。\n败荷折苇飞鸿下，正忆渔舟泊故溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和毛君州宅八咏 其五 李八百洞","author":"苏辙","text":"洞府山川百里赊，洞门藤蔓锁烟霞。\n神仙不与人间异，弟妹还应共一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和毛君州宅八咏 其二 披仙亭","author":"苏辙","text":"仙翁旧住蜀江边，千岁归来一鹤翩。\n城郭已非人事改，凄凉遗迹但披仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","poin