:"宋_1.csv","pointer":78264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太后阁六首 其二","author":"苏辙","text":"玉宇宜朱夏，壶冰生晚凉。\n深心念行暍，清夜久焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太后阁六首 其三","author":"苏辙","text":"蚕宫罢采撷，暴室献朱黄。\n翕呷霜纨动，阑班綵缕长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太后阁六首 其四","author":"苏辙","text":"六宫无事著嬉游，百药初成及早收。\n菖歜还羞十二节，椿年自占八千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太后阁六首 其五","author":"苏辙","text":"万寿仍萦长命缕，虚心不著赤灵符。\n民间风俗疑当共，天上清高定尔无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太妃阁五首 其二","author":"苏辙","text":"压蔗出寒浆，敲冰簇画堂。\n人间正袢暑，天上绝清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太妃阁五首 其三","author":"苏辙","text":"九夏清斋奉至尊，消除疠疫去无痕。\n太医争献天师艾，瑞雾长萦尧母门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太妃阁五首 其四","author":"苏辙","text":"纨扇新裁冰雪馀，清风不隔纻罗疏。\n飞升漫写秦公子，荣谢应怜汉婕妤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇太妃阁五首 其五","author":"苏辙","text":"渺渺金河入禁垣，渐台雨过碧波翻。\n共传太液龙舟稳，不似南方竞渡喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇帝阁六首 其一","author":"苏辙","text":"溽暑避华构，清风迎早朝。\n枫槐高自舞，冰雪晚初消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇帝阁六首 其二","author":"苏辙","text":"南讹初应历，五日未生阴。\n灵药收农录，薰风拂舜琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇帝阁六首 其三","author":"苏辙","text":"皇心本夷旷，一气自炎凉。\n不废荆吴旧，民风见未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学士院端午帖子二十七首 皇帝阁六首 其四","author":"苏辙","text":"九门已散秦医药，百辟初颁凌室冰。\n饮食祈君千万寿，良辰更上辟兵缯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer"