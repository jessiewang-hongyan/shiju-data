[{"title":"赠人","author":"吕本中","text":"剩作闲官不计年，得公相近转翛然。\n饱谙文字能生病，始信虚空不住禅。\n水涩船回休进棹，路长马倦莫加鞭。\n漫成拙句为公寿，要作新正第一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"官闲赠人","author":"吕本中","text":"自喜闲官不计员，月叨微禄胜归田。\n药囊往往充诗藁，米券时时当酒钱。\n忍病作劳吾不厌，对人无语子差贤。\n不须更见卢溪老，会得安心即是禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十七日","author":"吕本中","text":"令节今安在，晨钟奉夙兴。\n空庭留素月，广殿有残灯。\n笑语已难记，经游如未曾。\n吾衰得坚卧，差胜住房僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中得舍弟信","author":"吕本中","text":"频通婺女讯，兼得会稽书。\n岁月呻吟里，文章困睡馀。\n百年判憔悴，万里付迂疏。\n尚欲身强健，相从得定居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疥","author":"吕本中","text":"瘙痒挠肤无春冬，为害略与恶疾同。\n只有疮痂不相负，夜阑长满寝衣中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十九日暴热","author":"吕本中","text":"一夜飞蚊绕鬓鸣，却忘时节是新正。\n祗应朝暮须风雨，便作疏檐泻竹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"吕本中","text":"十年不调张廷尉，一字拔人山巨源。\n万事重寻已陈迹，此公相对可忘言。\n故人久已音书绝，古寺终嫌市井喧。\n更欲移家近深僻，漫留书册教儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送向仲告往江西","author":"吕本中","text":"纷纷车马闹如云，膏火煎熬祗自焚。\n亦有故人来问疾，苦无佳思与论文。\n江湖老矣频搔首，毛发翛然政似君。\n他日卜邻犹有约，静中风景要平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其一","author":"吕本中","text":"偶从行李转江湖，所至翛然一物无。\n午枕久拚闲事业，夜窗新有静工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其二","author":"吕本中","text":"少小交游不乏贤，二三豪杰聚临川。\n自从老大飘零尽，独有残诗数百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其三","author":"吕本中","text":"屡试吴中千里莼，闽中荔子亦尝新。\n独游每恨无佳思，正好溪山少故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其四","author":"吕本中","text":"故人自失嵇中散，疾病衰颓转不堪。\n犹喜闲居有贤弟，且随长铗住江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其五","author":"吕本中","text":"张卿别后且郊居，无复黄公旧酒垆。\n试问今年有闲暇，亦随书剑入城无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其六","author":"吕本中","text":"交游畴昔住临川，博士高风世不传。\n饶谢得名三十载，当时已道小汪贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其七","author":"吕本中","text":"故人子弟惟汪谢，每一思之忘寝兴。\n莫道临川便寂寞，后来相继有诸曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其八","author":"吕本中","text":"吏部声名动一时，中原人物未全衰。\n低摧不用还归去，坐守遗经可疗饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其九","author":"吕本中","text":"金溪比岁复何如，二董风流却未疏。\n闻道移家远城市，欲携书籍更深居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川亲旧十首意到辄书不复次序 其十","author":"吕本中","text":"爱贤如渴吴夫子，不染世间儿女尘。\n老病不逢终不悔，后生谁复记斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉怀季平范丈戏成两绝句录呈 其一","author":"吕本中","text":"形骸已病尤宜懒，岁月长贫屡有诗。\n犹得深居少尘事，只如同在岭南时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉怀季平范丈戏成两绝句录呈 其二","author":"吕本中","text":"新年为况复何如，尚有心情打酒无。\n只恐后生行乐处，转嫌吾辈白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中寄胡原仲刘致中","author":"吕本中","text":"累月不寄书，我病亦在床。\n仰见出林鹤，如睹二子翔。\n冰壶贮秋月，所至有辉光。\n僻郡足风雨，深春犹雪霜。\n闽水远而清，闽山深且长。\n何时一尊酒，更复议行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"才元相过三衢偶成近体诗一首奉呈","author":"吕本中","text":"纷纷俗事起如毛，病起南窗厌作劳。\n正欲往来求饭饱，敢将辛苦治名高。\n长闲似称三冬卧，旧学虚蒙一字褒。\n他日相逢有馀地，尚容衰晚斗坚牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题","author":"吕本中","text":"衾稠尚冷知春早，意绪无聊觉病深。\n夜半故诗缘底事，向来馀习正关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄人三首 其一","author":"吕本中","text":"世久无高识，斯人我独知。\n子行吾羡子，虽病敢忘诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄人三首 其二","author":"吕本中","text":"念昔无事日，同升夫子堂。\n江湖晚相见，犹喜共行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄人三首 其三","author":"吕本中","text":"世久趋浮末，于时尔独贤。\n闲游众目外，却立万夫前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄人三首 其四","author":"吕本中","text":"老骥空伏枥，长琴有断弦。\n伤心共隐地，回首更茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄祁居士","author":"吕本中","text":"闻道祁居士，抄书手未停。\n艰难走异县，辛苦抱遗经。\n野寺犹堪隐，人言懒复听。\n十年事夫子，今日得仪型。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人四首 其一","author":"吕本中","text":"病欲相寻久未能，虎丘山下在家僧。\n诸方本末须君记，拈出丛林旧葛藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人四首 其二","author":"吕本中","text":"昔年曾侍老姑傍，诲我全身只退藏。\n长恐风流便疏远，子犹他日及升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人四首 其三","author":"吕本中","text":"跬步无功已厌迟，后生谁复肯从师。\n无人识子闲居意，手冷深藏只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人四首 其四","author":"吕本中","text":"三江古路更深居，白首穷经一丈夫。\n借问新年入城市，亦曾频到虎丘无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄朱希真","author":"吕本中","text":"幕下诸侯老，微言众不听。\n祗应有馀论，时复注前经。\n郡古疏还往，官闲任醉醒。\n主人鹅可换，更为写黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄向县丞","author":"吕本中","text":"念子他时两颊红，十年奔走变衰翁。\n耐官丞相风流在，坐守箪瓢不诉穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中","author":"吕本中","text":"药裹关心老不宜，只今筋力已全衰。\n何由更得身无事，却似他时把酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山城","author":"吕本中","text":"山城雨雪繁，春气来不早。\n思君如和风，未见意已好。\n时蒙枉车骑，笑语得倾倒。\n我能知子贤，子亦怜我老。\n旧交半鬼录，在者迹已扫。\n慨然念平生，令人恶怀抱。\n相从饱吃饭，此计或未保。\n东游有前约，预恐别草草。\n岂无一言赠，妙句写默藁。\n出户仰高山，犹堪慰枯槁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病夫","author":"吕本中","text":"病夫坐稳懒出门，底事逢春作癯瘦。\n故人相寻不惮远，欲以一杯为我寿。\n铺张古昔引大义，劝使忍穷如忍诟。\n感君意气但如昨，顾我情怀已非旧。\n平生甘作蚁旋磨，万事只如船放溜。\n十年参差故乡梦，一心守待灵芝秀。\n辱身窃比柳下惠，疾恶幸逢朱伯厚。\n他时城市望云山，岁晚何由数相就。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题","author":"吕本中","text":"心广体故胖，意肃气自屏。\n颓然万物表，乐此一室静。\n念君久安坐，转觉此味胜。\n疏篱过野马，破牖行日景。\n但令此意真，不必费讥评。\n想当溪山横，更有松竹映。\n隐几得昼眠，此固可补病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成两绝句奉寄文若庭列 其一","author":"吕本中","text":"强欲驰驱老不宜，故人虽在费相思。\n祗应大府多还往，职事虽忙不废诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成两绝句奉寄文若庭列 其二","author":"吕本中","text":"夏子经时不寄书，十年奔走尚穷途。\n不知自到高安县，亦有心情记我无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄闽中亲旧","author":"吕本中","text":"浓阴蔽烈日，小院有馀凉。\n顿觉枕簟好，时闻荷芰香。\n秋成今可必，衰疾未相妨。\n径欲闽中去，寻僧不裹粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"廖用中世綵堂","author":"吕本中","text":"廖氏居七闽，土俗变齐鲁。\n子孙仁且寿，每继先父祖。\n作堂名世綵，此意天所予。\n近者得矜式，远者快先睹。\n今公怀直道，邪正有区处。\n还家上此堂，父祖当笑许。\n小人慕清风，想像濯烦暑。\n孰知少年场，有此毛发古。\n何时望世綵，得听公笑语。\n老松卧岁寒，亦以蔽风雨。\n人或不予知，亦莫予敢侮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剧暑","author":"吕本中","text":"剧暑先庚伏，经旬在炮燔。\n今夕骤雨过，我病亦少安。\n凉风醒病骨，好月上更阑。\n尚恐贼报急，凌风无羽翰。\n闽中故人书，日夜望我还。\n无车载家具，欲往故不难。\n所恨去已晚，不及荔子丹。\n家家有白酒，自足解愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"吕本中","text":"经旬困炮煮，今夕有微风。\n市井嚣尘外，溪山啸傲中。\n秋凉亦不远，吾道恐终穷。\n准拟闽中士，今年一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日","author":"吕本中","text":"斟酒莫辞酒盏宽，酒盏少宽令心安。\n客游无聊思旧欢，旧欢新愁千万端。\n如何不饮空长叹，岁云秋矣风落山。\n白露应节衣裳单，南游并海当不难，雨雪欲下何时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀秋","author":"吕本中","text":"秋风日夜至，念我少年时。\n新凉喜欲舞，至今心未衰。\n心虽未遽衰，老病则已甚。\n颓然坐前阶，乃若两鸟噤。\n子病少则尔，衰羸非独今。\n徘徊以徬徨，何以异夙心。\n死者合已死，空费子百虑。\n在者亦已老，契阔少相遇。\n洗心西方观，子复未肯然。\n胡然竞日力，今年如去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠范十八","author":"吕本中","text":"君去留不得，我穷前未闻。\n如何出笼鹤，更送离山云。\n岁晚逢同志，人稀莫离群。\n肯思临别语，只用十年勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日","author":"吕本中","text":"少年固长贫，长岁复多疾。\n闭门取坚坐，到此多事日。\n不嫌冷如浆，所要甘似蜜。\n旧书堆几案，老眼厌涂乙。\n不如壁角坐，万事付以实。\n况今雨泽足，已觉忧患失。\n秋成日在望，所至有梨栗。\n贼报虽未衰，一饱良可必。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿昔","author":"吕本中","text":"宿昔尚烦暑，平生悲远游。\n长贫不贳酒，虽健懒登楼。\n晚节劳千虑，经年走数州。\n新凉事事好，只是迫防秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人送诗","author":"吕本中","text":"坚坐少愉乐，欲行还滞淫。\n时蒙七字句，可慰十年心。\n岁晚日晷短，天寒霜雪侵。\n主人不厌客，敢辞酒杯深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙 其一","author":"吕本中","text":"澹绿衣裳白玉肤，近人香欲透衣襦。\n不嫌破屋飕飗甚，肯与寒梅作伴无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙 其二","author":"吕本中","text":"破腊迎春开未迟，十分香是苦寒时。\n小瓶尚恐无佳对，更乞江梅三四枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处暑","author":"吕本中","text":"平时遇处暑，庭户有馀凉。\n乙纪走南国，炎天非故乡。\n寥寥秋尚远，杳杳夜光长。\n尚可留连否，年丰粳稻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"教授郑国材挽词","author":"吕本中","text":"松桂在荆棘，所趋故不同。\n虽云被剪伐，所至仰清风。\n念子行古道，箪瓢生屡空。\n我来则已病，不复能从容。\n平生务躬行，圣处久收功。\n坚坐想颜子，欲往吾其从。\n丹旐忽已远，暮霭千万重。\n论文一尊酒，坚坐更谁逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题二首 其一","author":"吕本中","text":"柴门罗雀懒频开，喜有新诗到眼来。\n闻道系舟城脚底，莫乘溪涨便轻回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题二首 其二","author":"吕本中","text":"入秋多病浑无酒，学道无成却读书。\n莫谓穷居便寂寞，天凉犹枉故人车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潘义荣惠木犀二首 其一","author":"吕本中","text":"年年无酒对新秋，辜负凉天懒出游。\n想得故人怜我病，故分岩桂洗穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潘义荣惠木犀二首 其二","author":"吕本中","text":"扫除炎暑脱氛埃，色似菊花香似梅。\n知是西风要清赏，少留阴雨候晴开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次潘都尉富季申冬日探梅韵二首 其一","author":"吕本中","text":"暑退园林物物新，过溪风好月初晨。\n酒壶茶具偏宜坐，细草残花别是春。\n但得主人令客醉，不辞秋冷和诗频。\n从来礼节生疏放，见我狂歌意自亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次潘都尉富季申冬日探梅韵二首 其二","author":"吕本中","text":"开府新从日下归，却寻山水对烟霏。\n剩披诗律留花住，不使亲知到眼稀。\n但见鲲鹏常远举，应怜蜩鴳只卑飞。\n此游尚恨还家早，未许溪头送落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵木犀二首 其一","author":"吕本中","text":"折送幽花与做秋，溪头风物未重游。\n已怜多病逢三益，更喜诗成拟四愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵木犀二首 其二","author":"吕本中","text":"洛阳车马走尘埃，一岁颠狂自探梅。\n还识此花风味否，年年秋后两番开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢潘义荣送菊二首 其一","author":"吕本中","text":"经旬霖雨足莓苔，忽喜双盆送菊来。\n已似风霜憔悴损，主人云是待晴开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢潘义荣送菊二首 其二","author":"吕本中","text":"渐开粉白间微黄，肯与新橙一例香。\n送与衰翁元未称，且留青蕊作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"畜犬","author":"吕本中","text":"王人长年闲，柴户终日闭。\n虽云伴我懒，常有跋扈志。\n端如在笼鹤，又若伏枥骥。\n举首望道路，久欲从此逝。\n恨无陆探微，写此师子戏。\n如何尚摇尾，更作求食计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疥","author":"吕本中","text":"刺刺龊龊疥欲作，今年去年只如昨。\n人生纵病莫病此，此病虽轻更作恶。\n寒窗夜长灯烬落，败人禅观妨人乐。\n安得壮士挽天河，尽洗此疮闲处著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潦倒","author":"吕本中","text":"潦倒心犹在，衰迟分独深。\n如何一朝泪，空费百年心。\n好月思同步，清尊懒独斟。\n惜哉王子敬，谁复叹人琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人","author":"吕本中","text":"他年好兄弟，见我峤南时。\n相对能忘病，清言可疗饥。\n后生宁复有，末俗漫相疑。\n尚想闲居处，疏灯守破帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题","author":"吕本中","text":"疾病侵凌我亦衰，后生谁复更相知。\n可怜日落长安路，不见骅骝整辔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄京口使君","author":"吕本中","text":"使君镇京口，隐若一长城。\n诗律有同社，溪山聊主盟。\n嚣尘不挂念，鸥鸟自忘情。\n曾记贫交否，衰颓判此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]