[{"title":"自题顶相","author":"释居简","text":"谓有为，吾奚为。\n谓无为，吾奚不为。\n待悟而勇为，绝学而无为。\n于戏尽之矣，非吾为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王梁山画像赞","author":"释居简","text":"从事毛锥，壮夫不为。\n置书学剑，弓号马嘶。\n不斩楼兰，夫何自欺。\n堂堂梁山，襟利带夔。\n帝轸遐方，详延瑰琦。\n良马素丝，组以五之。\n维贤作牧，任以抚绥。\n抚绥伊何，恩斯勤斯。\n岂惟怀恩，亦复畏威。\n庶靖氛埃，以偃鼓鼙。\n昔人可师，感夜半鸡。\n哂乃阿瞒，横槊赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"台宗杰首座画像赞","author":"释居简","text":"性具染指，鼎味咸在。\n容膝归休，日用三昧。\n不动口，不饶舌。\n人无闻闻，吾无说说。\n翻嗟普眼，弗见普贤。\n为渠去却，眼中金屑。\n复道行空，白银为阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野月赞","author":"释居简","text":"广寒殿，洪崖井。\n轮有晦朔，景无畦畛。\n悠然随所寓，婆娑弄清影。\n莫羡江楼清，江楼尘污人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释居简","text":"转得头来已是迟，恰如曾未转头时。\n一钱觅得无及处，犹自区区诳阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释居简","text":"五十三人一缕穿，小儿虽小胆如天。\n茫茫烟水无重数，买得风光不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释居简","text":"一字未曾谈般若，谩天谩地尽饶伊。\n祇园乞食归来后，法会因由又是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释居简","text":"剑下十分真，难藏独露身。\n江流石不转，独有蕴空名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其五","author":"释居简","text":"进步竿头踏断桥，太虚凸处水天凹。\n古今吃?知多少，不似阇黎这一交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"释居简","text":"渔翁不耐寒，重沓著蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"李大同","text":"鹿脚花去泣关山，回首沉香一梦閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李长吉","author":"柯梦得","text":"天遣皇孙二十七，若木望来高几尺。\n行空万里是祥云，入地千年成琥珀。\n玉楼渺漠无人到，高台自古悲风早。\n碧云尽处是天衢，更没青青河畔草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和楼倅宗簿 其二","author":"刘宰","text":"余幼好此奇服兮，岁荏苒而华颠。\n闻若人之好修兮，搴众芳而独专。\n结微情以陈词兮，鳞鸿杳以无传。\n惟圣哲之茂行兮，在举能而任贤。\n横江湖以扬舲兮，宁维楫之可捐。\n烂晨光兮破群幽，清风发兮凉气飕飕。\n琼佩兮锵锵，玉鸾鸣兮啾啾。\n时不可兮骤得，君胡为乎此留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李季允侍郎归蜀五绝用禅房花竹幽为韵 其四","author":"刘宰","text":"交情契金兰，燕乐非丝竹。\n我歌古别离，语尽君当续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台道中用陈氏园亭韵 其一","author":"刘宰","text":"笋舆穿过万重山，邂逅登亭一解颜。\n剩欲题诗遍苍石，举头羞见岭云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿直里店二首 其二","author":"刘宰","text":"稻穫田空宿水禽，去来终夜有清音。\n投床倦客无他想，祇有江湖万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钱晋之绿云洞天韵","author":"刘宰","text":"理乱幽人了不闻，扶疏绕舍绿成云。\n洞中不异人间世，一枕邯郸浪策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题子登侄环绿斋","author":"刘宰","text":"竹树回环一亩宫，红尘不到绿阴浓。\n堆前祇有书千卷，善后悬知禄万钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜王节夫过访","author":"刘宰","text":"我方丱角子胜冠，我老君犹鬓未斑。\n可但孤生多疾疢，也输华馆富清閒。\n交情敢忘莺求友，野性终便鹿在山。\n何日归欤同里社，杖藜来往翠微间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送钟元达倅濠","author":"刘宰","text":"喜见弦歌近帝京，又分风月向边城。\n时方急士国家计，事不辞难臣子情。\n塞下规模鼌御史，湟中勋业赵营平。\n君行试与重商略，乌鹊南来数寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漕司檄劝稼望见资州忆王褒李鼎祚 其二","author":"度正","text":"秦接衰周汉接秦，汉儒议论尽真醇。\n如何独著贤臣颂，直使波流到圣臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂马祖因僧问离四句绝百非","author":"释文礼","text":"唤起窗全曙，催归日未西。\n无心花里鸟，更与尽情啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食兔诗","author":"李兼","text":"弱质司明视，虚名直望舒。\n轶迂辞上蔡，能事到中书。\n狡计空多窟，珍盘竟付厨。\n独将毫末效，曾纪汗青馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归护国寺","author":"李简","text":"来赴龙华约，归承帝泽新。\n道高传几祖，言下得何人。\n水想灵溪健，花饶法界春。\n自甘铅钝者，犹望指迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拜赐宫花纪恩诗 其二","author":"许应龙","text":"不用凉州羯鼓催，阳和已逐小春来。\n谁将万点花间艳，都向百官头上开。\n样巧剩裁隋苑彩，影摇斜蘸汉宫杯。\n玉阶再拜君恩重，洋溢欢声遍九垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和闽帅 其二","author":"许应龙","text":"新凿南湖接海潮，油幢领客泛兰桡。\n那知半夜雨声急，却放新晴物色饶。\n尽日登临陪步武，高谈洒落挹风标。\n阳春白雪真难和，泚笔惟书道路谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘉禾百咏 其八十四 读书堆","author":"张尧同","text":"平林标大道，曾是野王居。\n往事将谁语，凄凉六代馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四首 其四","author":"释梵琮","text":"钟声披起郁多罗，信手拈来不在多。\n堪笑当年明上座，狼忙驰逐太奔波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兴 其二","author":"苏泂","text":"贫居应闭门，原宪乃非病。\n读书到周孔，岁晚吾事竟。\n佳哉亦可乐，妙在得所性。\n于时俗虑少，鱼鸟共涵泳。\n芦花深两桨，秋色满湖镜。\n颇怀梅子真，屡起泛舟兴。\n明当文会友，圣处一参订。\n此生饭不足，敢不听于命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坐睡","author":"苏泂","text":"世事困缠纠，谁能复自然。\n看书得坐睡，此乐出于天。\n一适万虑远，重寻已非先。\n相逢问尊宿，会我无心禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶作","author":"苏泂","text":"盘薄意无穷，藏修一亩宫。\n竹鸣知过雨，花动觉微风。\n閒作诗如画，长思色是空。\n人言类摩诘，虽病有神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王主簿韵 其二","author":"陈宓","text":"飞乌哑哑鸣，未倦投深枝。\n如何三年仕，束带事鞯羁。\n丈夫志有在，岂为日再炊。\n事业不足道，空成楚冠縻。\n有时屏朱墨，静坐欲无为。\n不复顾目前，屠沽斗群儿。\n食焉不能怠，况有尸素讥。\n风俗幸朴茂，不与骄侈期。\n抚摩雅无术，一稔适登时。\n吏议尚见贷，兹怀敢萌欺。\n一日事必葺，九仞功易隳。\n垂满得佳友，天怜愚顿姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自任所归游杨村郑氏园","author":"陈宓","text":"碧柳萦沙路，红蕖映竹扉。\n亭随山作态，人与石相依。\n盛暑深岩冷，通天一径微。\n神清非梦境，端的客来希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问梅 其二","author":"陈宓","text":"眼前禁得一枝横，不用千林缀玉英。\n花谢花开浑不问，祇将佳处付诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阙题","author":"陈宓","text":"□□□□□□□，□□□□□□□。\n□□□□□□□，四山甘雨已如倾。\n蚤知县令才能薄，赖有禅翁愿力宏。\n宿麦顿苏民气乐，更期膏润接春耕。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和泉州施通判 其三","author":"陈宓","text":"物性由来易变迁，精金百鍊始知坚。\n相逢即别无佳语，有负慇勤见赠篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二八","author":"释法薰","text":"九十日饭钱且置，浆水钱教谁还。\n若是眼生三角，衲僧便解乘时豹变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其三","author":"释法薰","text":"乞钱钱又无，等人人不见。\n不知兜率天，何如奉化悬。\n拍手呵呵，天回地转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游大涤假宿鸣玉馆偶成","author":"陈洵直","text":"风动归云清，日落众山楚。\n重来兴弥深，托宿此何所。\n浪浪鸣玉泉，恍恍对床雨。\n梦断身高低，尘劳深夜语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送季逢过湘中","author":"赵汝燧","text":"齑盐三十载，刻苦战文场。\n灯火简编夜，江湖髭鬓霜。\n雁声随挂席，秋色欠游湘。\n归日无他物，惟诗满古囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"赵汝燧","text":"鸟残桃见核，虫蠹叶留痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴大帝庙","author":"王遂","text":"曾是东南第一王，眼看此地六兴亡。\n东缘有酒登京口，西为无鱼忆武昌。\n非复虎臣陪殿上，空馀猩鬼泣祠旁。\n何年并建琅玡庙，共对淮山草木长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁在辛酉改元嘉泰庚伏之末拉亲友姚述之鲜长源黎元实逃暑南岩讲河朔故事也聪山主从游竟日因摘东坡山谷诗句集成四章题石壁以纪行","author":"苏植","text":"江山松柏深复深，清风一榻抵千金。\n人间热恼无处洗，借我一庵聊洗心。\n世上功名何日是，我生百事常随缘。\n吟哦相对忌三伏，歌罢曲肱还醉眠。\n水边林下逢衲子，我亦来追六月凉。\n传得黄州新句法，茗搜文字响枯肠。\n作个生涯终未是，谁能铁里斗铮铮。\n相看领会一谈胜，山自白云江自横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"赵与时","text":"寒雁挟风过古木，春鸠带雨集荒园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示槱默 其二","author":"钱时","text":"飞蛾恋逐眼前光，身殒膏火空茫茫。\n蛆蝇变化出复没，生死不离污秽场。\n求之有道得有命，可把枯荣乱邪正。\n进德修业当及时，去去光阴难语进。\n汝为君子无腼颜，啜菽饮水尽亲欢。\n不然正使位一品，九地含羞吾得瞑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上詹仲通县尉 其二","author":"华岳","text":"西风卷荷衣，披披不成幅。\n清霜拆蕙囊，冽冽已成蓿。\n如何独东篱，黄华笑寒菊。\n物之有盛衰，循环若推毂。\n世事良亦然，亦岂物所欲。\n金钿镕落日，零露洒寒玉。\n人皆惜芳菲，谁复念幽独。\n惟有陶渊明，慇勤费培沃。\n簪花从帽落，撚酒醉商陆。\n从此擅秋芳，芙桂非同录。\n问花何以报，剪首荐醽醁。\n他时更粉躯，为公采明目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"热中呈楚南僧","author":"华岳","text":"帝炎执鞭驱赤龙，火车万乘烧长空。\n长空万里俱蕴隆，流金烁石天地同。\n我来亭亭日当午，欲避骄阳竟无所。\n愿求一洒杨柳枝，化作东闽万家雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清富楼 其二","author":"华岳","text":"去年清富屡求诗，今日凭阑约翠微。\n山带野花堪入画，水环汀草欲成围。\n一园黄菊有馀食，两顷白云无限衣。\n说与尘寰守钱虏，不劳魂梦到禅扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大孤山","author":"洪咨夔","text":"汹长江其迅流，岿杰石乎中峙。\n送两目兮双帆，有美人兮千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分歧四绝呈及甫 其二","author":"洪咨夔","text":"送君一程归，别我数里隔。\n定非爱鸡黍，前例无此客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分歧四绝呈及甫 其三","author":"洪咨夔","text":"大儿长如竹，小儿秀如柳。\n迎爷拜新年，颔髭白八九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分歧四绝呈及甫","author":"洪咨夔","text":"客里有底忙，申旦不成梦。\n远归胜新昏，还君春睡重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高倅送糟蟹破故纸芽口占以谢 其二","author":"洪咨夔","text":"蒲筥新芽补骨脂，雨痕照眼碧离离。\n功于枸杞庵藦似，不是山人底得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵映山红","author":"洪咨夔","text":"燧人钻榆出新烟，烟光湿雨山苍然。\n黄鹂怯寒噤未语，有喙三尺惟啼鹃。\n血流染花不知数，赤霞烂熳横丹天。\n前山后山列锦障，上涧下涧敷金莲。\n海棠无香许流亚，石榴有艳疑姻连。\n目光远送空翠表，胜处正在繁芳边。\n七香宝车果安在，东风老去空华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"作茶行","author":"洪咨夔","text":"磨斲女娲补天不尽石，磅礴轮囷凝绀碧臼刳。\n扶桑挂日最上枝，媻跚勃窣生纹漪。\n吴罡小君赠我杵，阿香藁砧授我斧。\n斧开苍璧粲磊磊，杵碎玄玑纷楚楚。\n出臼入磨光吐吞，危坐只手旋乾坤。\n碧瑶宫殿几尘堕，蕊珠楼阁妆铅翻。\n慢流乳泉活火鼎，淅瑟微波开溟涬。\n花风迸入毛骨香，雪月浸澈须眉影。\n太一真人走上莲花航，维摩居士惊起狮子床。\n不交半谈共细啜，山河日月俱清凉。\n桑苧翁，玉川子，款门未暇相倒屣。\n予方抱易坐虚明，参到洗心玄妙旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夜","author":"洪咨夔","text":"市儿数十百，挟炬相追奔。\n争唱卖呆歌，祈以昭易惛。\n我呆大如屋，几腊拥败垣。\n群雏劝我卖，急售价莫论。\n弄巧或成拙，太清不如浑。\n老铁无孔锤，甘守钝性根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病后和黄玉泉韵 其二","author":"郑清之","text":"赤明瀹篆正恢台，戏挹雄风涤闷怀。\n病骨喜随新箨换，好诗忽馈宝珠来。\n巨鱼未纵王褒壑，陋室聊淹禹锡阶。\n且共理身如理国，小须握手咏康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家园即事十三首 其三","author":"郑清之","text":"池荷岸竹閟寒清，肱枕攲眠梦欲成。\n珍重西邻知好事，隔河送过读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵从道赋菜畦春富贵 其二","author":"郑清之","text":"芝田不减商山乐，蔬食谁言孔色矜。\n蒲笋祗应维蔌美，镂钖何必羡韩膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香花","author":"郑清之","text":"粉面芳心碧玉裳，持来宛作故山香。\n征途不觉春如许，更问兰芽几寸长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄商察院","author":"汪莘","text":"窃伏西湖雪鬓催，长歌声断鬼神哀。\n青天有月无人看，白帝行秋待我来。\n近水远山俱冷淡，败荷孤苇尚低回。\n今朝欲向青门道，出到疏篱意已灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"腊月雪后","author":"汪莘","text":"林下雪消添晚汲，山中日出欠晨炊。\n先生茅屋春犹早，只有阶前碧草知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元五年休宁权县郑丞吴山寺劝农次韵 其二","author":"汪莘","text":"凤凰城里旧徘徊，村里吴山跃马来。\n也有旗亭沽酒处，可怜桃杏向人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感秋 其二","author":"汪莘","text":"闲佩仙瓢到柳汀，柳边一点酒旗星。\n斜阳欲落无人惜，空有烟林作画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感秋 其三","author":"汪莘","text":"行到篱边菊已黄，相逢不改旧时香。\n自怜失意秋风后，犹为寒花一举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感秋 其四","author":"汪莘","text":"不须龟筮此生休，死去无心更出头。\n莫说竹篱茅舍事，丹枫一树正悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感秋 其五","author":"汪莘","text":"独步荒山日欲昏，数声乾苇过游魂。\n重岗复涧穿难尽，恍惚随人月一痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"壬戌岁春怀 其二","author":"汪莘","text":"抱疾衡门与药亲，苦无筋力尚精神。\n东风日夜开桃李，不为人间失意人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡禅嵩老集古人佳句成诗编成巨帙以示余钦叹不足辄赋二绝率然悚仄 其二","author":"杨梦信","text":"学诗元不离参禅，万象森罗总现前。\n触著见成佳句子，随机饤饾便天然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]