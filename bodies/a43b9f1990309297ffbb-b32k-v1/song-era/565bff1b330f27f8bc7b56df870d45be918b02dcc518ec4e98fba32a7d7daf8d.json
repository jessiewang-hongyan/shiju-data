[{"title":"八月十四日清溪堂望月","author":"张舜民","text":"客路三湘远，天风八月清。\n云间虽掩映，水底已分明。\n且对当年影，休吟万古情。\n喜君方向满，照我过江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十五日行次渭原走寄熙帅范巽之","author":"张舜民","text":"冻云积雪黯洮泯，晏岁轺车晤过秦。\n夹道清渠翻白浪，绕山铁马走黄尘。\n归鸿袅袅宁无信，塞柳依依欲弄春。\n今夕帐中拚一醉，同年贤帅是乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月十九日诸讲官晨趋迩英前夕初雪沾洽寻有旨权住讲一日既而同子开内翰正夫侍郎元功舍人少伫资善一饫而出诸公嘉其景而被上恩乃谓衰薄不可无作聊书长句深愧斐然","author":"张舜民","text":"西风拔地夜飘霙，天惠胪传讲暂停。\n病眼昏花逋读史，高谈快论阻横经。\n御沟容与冰初合，苑柳扶疏叶未零。\n可是太平占上瑞，衰才殊不解丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上颍昌韩少师丞相兄弟","author":"张舜民","text":"五福犹来萃一门，岁寒方始见松筠。\n白头再喜逢知己，青眼重开为故人。\n当日八龙同孝友，于今二阮卜比邻。\n莫年不作三湘客，犹欲生还一吐茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与张琬同年饮于龙兴寺所居","author":"张舜民","text":"台城风物已凄凄，牢落行人邂逅齐。\n秉烛相看如梦寐，片帆回首又东西。\n依依团扇秋仍好，脉脉青娥恨却低。\n一曲琵琶无限意，时时閒客思都迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山果","author":"张舜民","text":"煮酒堆山果，新茶下粉团。\n似梅嫌足核，如蜜少加酸。\n公子倾金弹，行人漏蜡丸。\n吾乡元不识，归日画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中宫致斋","author":"张舜民","text":"重重绛阙隐琳房，落絮飞花日正长。\n著作未谙青琐闼，祠官还伴紫微郎。\n林藏鹎鴂随莺转，风引酴醾助酒香。\n十载京城倦游客，不知身世在何乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书薛绍彭诗编","author":"张舜民","text":"白杨宿草几离披，忽对遗编动永思。\n棠棣先凋空浩叹，图书不展已多时。\n岂唯独负游山约，何意重看送我诗。\n今日山翁悲复喜，薛家门里有孤儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双松堂","author":"张舜民","text":"叹息前人布政优，手栽松竹助清幽。\n当年拨土人何在，今日捎云势未休。\n直干几排雷雨怒，细声常伴管弦愁。\n若为唤起王摩诘，画个浮休倚白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬戌孙览右司同年以诗见寄用韵和酬","author":"张舜民","text":"孙郎卧省正当年，曾奏嘉谋玉扆边。\n事契且论龙虎榜，行藏休问孝廉船。\n从军脱略矜横槊，禦魅迁流喜执鞭。\n莫怪子云知遇晚，勒铭终欲上燕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王氏松斋诗","author":"张舜民","text":"人传半隐在龙门，天启松斋遇远孙。\n水石蔽亏包废寺，版图磨灭指邻村。\n如将绿野还裴度，不见潜溪付李藩。\n壁土未乾三易主，洛阳城里有名园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邓正字宅见刘明复所画麓山秋景","author":"张舜民","text":"洛阳才子见长沙，自识中丹鬓未华。\n文武才全皆不试，丹青笔妙更谁加。\n老杉列在堂皇上，小景将归学士家。\n我有故山常自写，免教魂梦落天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丛台","author":"张舜民","text":"荆棘芃芃百尺堆，路人云此是丛台。\n雨中漳浦明还灭，门外青山去又来。\n歌啸且从今日乐，是非谁管后人哀。\n靓妆袨服寻为土，不似昆明堑劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东行别碇斋诗","author":"张舜民","text":"宴坐岂不好，有谁强尔行。\n山川不改色，儿女各为情。\n岸隔霜林意，斋空夜水声。\n虚传少陵叟，一室过平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖春日","author":"张舜民","text":"湖外红花间白花，湖边游女驻香车。\n鞦韆对起花阴乱，蹴鞠孤高柳带斜。\n无数小鱼真得所，一双新燕宿谁家。\n故园风景还如此，极目飞魂逐暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧闻台城辱井石上有胭脂泪痕久未之信今见之似是淋漓涂抹之迹失笑不已因成此句","author":"张舜民","text":"平居已无奈，仓卒故难任。\n井上痕犹浅，水中痕更深。\n问鳌何至此，下石尔甘心。\n不及马嵬袜，犹能致万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相宠示白羊御酒之作","author":"张舜民","text":"进酒彤闱盏未乾，春怀元老在长安。\n双壶犹带崤山雪，一酌能消塞北寒。\n好是弟兄同受赐，更邀宾客共交欢。\n逡巡若遇头纲品，感激方明壮士肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过黄州苏子瞻东坡雪堂因书即事题于武昌王叟斋扉","author":"张舜民","text":"欹帆侧柂岭边归，重过东坡叩竹扉。\n床坐凝尘风自扫，江山无主燕空飞。\n门前桃李添新径，井畔梧桐长旧围。\n好在江南王钓叟，为君时复晒渔衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同刘贡甫学士登石鼓合江亭一首","author":"张舜民","text":"乘兴俄成石鼓游，可堪摇落楚江秋。\n岩中名字今何在，亭下潇湘古亦愁。\n万里再惊金马客，一家重上木兰舟。\n却令二水知人意，合势相邀向北流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕子固挽词","author":"张舜民","text":"大块分劳逸，唯君独不均。\n险夷安若性，金石想为人。\n万卷书奚托，重泉恨莫伸。\n谁知丞相子，天地一穷民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙贲知衢州去疑冢以其所得双石作堂乞诗","author":"张舜民","text":"芝兰虽好忌当门，何况庭前恶土墩。\n畚锸才兴双剑出，狐狸尽去老松蹲。\n百年守冢真堪笑，一日开轩亦可尊。\n安得掷从天外去，成都石笋至今存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巩州首阳铺鸟鼠同穴","author":"张舜民","text":"本是巢居物，那容鼠穴中。\n既言无牝牡，何用有雌雄。\n山节曾居蔡，长江网得鸿。\n谁能穷物理，目送渭波东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池州弄水亭","author":"张舜民","text":"清溪望处思悠悠，不独今人古亦愁。\n借尔碧波明似镜，照予白发瑩如鸥。\n江山自美骚人宅，铙鼓常催过客舟。\n惟有角声吹不断，斜阳横起九峰楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至瀛州小雪贻蒋颍叔","author":"张舜民","text":"梁苑瑶池醉梦阑，忽随北客度燕山。\n马头点缀飞才密，日脚微明意尚悭。\n疏布久抛南海上，貂裘初袭两河间。\n好留幕府陪樽俎，刚被行人不放闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次金山贻了元","author":"张舜民","text":"何年灵鹫鸟，飞落大江心。\n石壁虽难转，风波不易禁。\n楼台分左右，日月见浮沉。\n便欲归休庇，长嗟世累深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行湘岸见早梅盛开","author":"张舜民","text":"江上篱边见早梅，天寒地暖数枝开。\n为怜北客漂流远，偷报东君信息回。\n香气轻于新酿熟，襟怀重似故人来。\n舟中莫问无兼有，急急呼儿贳酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次晚洲","author":"张舜民","text":"臈月遭霖雨，孤舟舣暮滩。\n数声归雁断，半岭野梅残。\n无复论偕老，何时展急难。\n江湖卧周岁，此夕最难安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西宫致斋贻裴著作","author":"张舜民","text":"西出都门外，尘埃扑马鞍。\n人家事寒食，星雨仰祠官。\n日永莺千啭，庭闲竹数竿。\n唯怜隔斋禁，不得共清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过山阳有怀","author":"张舜民","text":"山阳过处苦匆匆，想见平生水陆冲。\n但有酒杯浮绿蚁，却无赋笔写游龙。\n江湖风浪三千里，京国莺花一万重。\n他日君恩容北首，故人能作复从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过同州遇雪赠毌清臣","author":"张舜民","text":"左辅沙如水，长春柳未匀。\n精神迎刺史，景物为行人。\n羃䍥梁山外，飘流洛水滨。\n十年门下客，依旧困泥尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邠守李中散取乡人谢事者三人绘像邠学号三友堂予己记之复徵诗","author":"张舜民","text":"出仕归来义两全，真从髫龀至华颠。\n儒冠绘像为三友，龟佩相辉是四贤。\n莫与后生论损益，且于见世作神仙。\n东都九老誇荣贵，未比南豳德行先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"体之推官侍亲出使聊书短篇以浼行色","author":"张舜民","text":"游梁并困洛，谁是故人情。\n未尽环中说，俄成剑外行。\n路遥诗箧重，雪映綵衣明。\n预想东归日，相逢指渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佚老堂为陶敏宣德题","author":"张舜民","text":"未老刚称老，言休即便休。\n浔阳真有后，彭泽善贻谋。\n隐几悲残漏，回头见急流。\n便须移醉石，偃卧北窗幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别房州","author":"张舜民","text":"有客尝谈解散川，偶因晴景到山前。\n溪流似景清无底，石壁如门翠插天。\n夜气结成三洞雨，春渠饮尽一州田。\n临行始觉房陵好，更欲迟留住一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妙莲阁","author":"张舜民","text":"休论雪窦与云峰，且看天台剑戟丛。\n万水千山来阁上，一花六叶现池中。\n谁将色界填空界，不离香风席祖风。\n有底妙莲谈不尽，却成赋笔与兴翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵寿木","author":"张舜民","text":"曲木天然性，叨名席上珍。\n节高工碍手，倚壁快扶人。\n莫问西来意，终为灶下薪。\n他时俘颉利，拜赐敢忘身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花时对雪","author":"张舜民","text":"急霰飘零际，群芳烂熳中。\n半开先逐水，未落已随风。\n兵渡金陵破，尘来绣岭空。\n谁能劳樽酒，暂使客颜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏子瞻哀辞","author":"张舜民","text":"石与人俱贬，人亡石尚存。\n却怜坚重质，不减浪花痕。\n满酌中山酒，重添丈八盆。\n公兮不归北，万里一招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还卷答徐长官","author":"张舜民","text":"才士生平多薄命，文章自昔少知音。\n增添行李妨为客，搜搅肝肠枉用心。\n高阁书存终覆瓿，长门赋丽偶遗金。\n云台幸有功名望，何必孜孜泥古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邻居张民师友孝斋","author":"张舜民","text":"岁晚何人念孔怀，北斋风景似南斋。\n夜寒几借阳城被，归兴徒穿杜子鞋。\n乌鸟争巢时坠屋，丛萱得雨乱侵阶。\n闭门朗讽閒居赋，一任红尘涨六街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龟山寺","author":"张舜民","text":"白塔摇摇波浪间，几多舟楫望禅关。\n天边幡影因心动，堂上潮音到海还。\n我拔一毛犹自苦，师除双臂信如閒。\n中流莫怪频回首，直到江南始见山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人岁暮书怀","author":"张舜民","text":"星回律变数将终，二十年前此邑中。\n天令尚随新岁改，人颜那得旧时红。\n家无妻妾仍多难，腹有诗书可屡空。\n莫笑郑人欺子产，到头留得惠民功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和同使郑内藏见贻之作","author":"张舜民","text":"仗节传呼出紫宸，燕南蓟北望车尘。\n身为五郡循良守，家是三朝宿卫臣。\n对榻梦魂思共得，据鞍吟啸喜相亲。\n驿亭处处逢花发，疑是春光解送人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邠倅王正夫大夫游西湖","author":"张舜民","text":"雨过花开一郡忙，紫微山影照湖光。\n东风不费舟船力，暖日能添罗绮香。\n已拚今朝须尽醉，预愁明日又辞乡。\n饱闻冯翊无花草，唯有城头至乐堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈宪章蜡梅","author":"张舜民","text":"黄宫暖律暗相催，腊后春前见蜡梅。\n青帝不知无蝶至，黄华先赏有蜂来。\n风飘嫩蕊添莺羽，雪驾寒香入酒杯。\n尽道此花居第一，如何更有百花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和喻明仲马上吹笛","author":"张舜民","text":"越客思归黯不平，闲持长笛写秦声。\n羡君气海如斯壮，博我词锋莫敢争。\n江上梅花开又落，陇头流水咽还惊。\n岂知不寐鳏鱼眼，独坐山堂对月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答还卷","author":"张舜民","text":"屈宋功成道不传，后来鸡犬各登仙。\n留连光景随时俗，盗窃声名至暮年。\n陷没李陵因北伐，漂流杜甫为南迁。\n耒阳郴口今吾在，谁与诛茅屋数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜闻刘宫苑舟中琵琶诗","author":"张舜民","text":"系舟江岸两相闻，弦索嘈嘈恍未分。\n不得长安水边见，却于湓浦夜深闻。\n穷愁似影长随我，乐事如年不负君。\n会意檀槽求一醉，世间荣辱任纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岩花","author":"张舜民","text":"托根何太远，得地亦相宜。\n土石生为偶，红香想自知。\n风英将片片，雨实渐离离。\n戍客思攀折，无何历处危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所寓开利寺小池有四色莲花青黄白红红者千叶皆北土所未见者也惜其遐陬有此异卉","author":"张舜民","text":"深山草木自幽奇，四色荷花世所稀。\n孤独园中瞻佛眼，凝祥池上捧天衣。\n白公没后禅林在，王俭归来幕府非。\n水冷风高人不到，却怜鸥鸟日相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"组以时果供馈予以酒为报","author":"张舜民","text":"馑岁无时果，秦人餍草茶。\n开奁惊见李，对客喜浮瓜。\n为乏琼瑶报，聊称旨酒嘉。\n中郎不忧老，有女可传家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南衙寺会宿王鲍二同年","author":"张舜民","text":"遍走长城塞，归由舜阪头。\n榜中千里骏，天外二星流。\n花月仍寒雨，关河逼寺楼。\n宁知十年后，此地并衾裯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀虢县令犹子箅起二 其一","author":"张舜民","text":"匍匐岐山下，三呼已过时。\n臧孙虽有后，伯道竟无儿。\n自是终身痛，空留一县悲。\n老人休雨泪，转面即逢伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复拜朝散郎","author":"张舜民","text":"曾为朝散已多时，起废皇恩许再为。\n学得子文无愠色，笑他白老强题诗。\n虽无妄想追前境，犹有贪心刻后期。\n祇向今冬求致仕，要将恩泽与孙儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣赦","author":"张舜民","text":"击鼓填街道，传声过水滨。\n国严三岁祀，恩洗万方春。\n舟楫随南斗，衣冠拱北辰。\n岭南并岭北，多少望归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳花","author":"张舜民","text":"随风坠露事轻儇，巧占人间欲夏天。\n只恐障空飞似雪，从教糁径白于绵。\n未央宫暖粘歌袖，扬子江清恼客船。\n老去强看愁底事，昏花满眼意茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洒然堂","author":"张舜民","text":"何必彷徉水石间，听君言话已孱颜。\n三湘尽处犹逢竹，五岭回时却见山。\n吏案总教如雁进，灵源我且似鸥闲。\n天边猿鹤皆相识，惟欠携筇日往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书怀","author":"张舜民","text":"凉风起天末，何物动人愁。\n一室关河暮，三年草木秋。\n高文谁吊屈，晚节漫依刘。\n独怪瀼西叟，巴江得久留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日陪陕守成伯阁老过魏清逸草堂诗以志之","author":"张舜民","text":"何处登临散郁陶，草堂依约在东郊。\n笼中凡鸟迎新网，天外冥鸿委旧巢。\n山色茏葱煇綵旆，田歌呕轧杂鸣铙。\n青编虽有知音绝，可是无人学解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚三首 其三","author":"张舜民","text":"谁把霜林染得红，更栽绿竹与长松。\n家家白酒连宵醉，处处新禾彻夜舂。\n半落园林悬橘柚，低回门巷映芙蓉。\n沙鸥性在终难狎，秪解沙头印脚踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚三首 其二","author":"张舜民","text":"官事私忧总不论，每于楼上到黄昏。\n江城日暮须吹角，野寺僧归自掩门。\n秋晚山川多草木，年丰场圃足鸡㹠。\n人生几有渊明乐，稚子迎门酒满樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚三首 其一","author":"张舜民","text":"久雨秋深对晚晴，近山昏黑远山明。\n滩头艇子排行系，水底鱼儿作队行。\n衰柳带风犹喜舞，残蝉送日尚能鸣。\n角冠藜杖何为者，独向溪边忘姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其八","author":"张舜民","text":"冶谷鸦仍乱，空同日欲曛。\n关河围绝壁，鼓角壮中军。\n自纳和戎策，还停草檄文。\n征西好规矩，后世见忠勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其九","author":"张舜民","text":"爱静无由静，思归不得归。\n干时虚碌碌，怀往迥依依。\n菊酒还吹帽，玄霜未授衣。\n知他蘧伯玉，曾悟少年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暮书怀 其六","author":"张舜民","text":"再到崆峒寺，题名尚宛然。\n存亡如昨日，筋力想当年。\n祸福归玄鸐，晨昏听杜鹃。\n此间无虎豹，好著养生编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]