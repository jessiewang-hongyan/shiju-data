[{"title":"和人游仙峰庵三首 其一","author":"朱松","text":"千岩万壑翠萦回，一洗衰翁病眼开。\n落日多情留别岭，秋空无地著浮埃。\n云闲出岫初无意，松老参天岂愿材。\n我是散仙君记取，更鞭鸾凤少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人游仙峰庵三首 其二","author":"朱松","text":"谁麾俗驾挽今回，珍重山翁小径开。\n去觅云峰攀碧落，下看沙劫坏飞埃。\n掬寒露井销尘想，撷翠筠篮富药材。\n彷佛三生曾到此，楼钟重听一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人游仙峰庵三首 其三","author":"朱松","text":"脚底千峰翠浪奔，云端挂此一豪身。\n山河了了穷千界，物我纷纷共一尘。\n浪趁下方追日步，恨非本色住庵人。\n他年八极浮游遍，来读新诗迹未陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄金确然","author":"朱松","text":"金子卧空谷，何人赋白驹。\n僧斟三味酒，客荐一囊书。\n归梦寒应短，诗肠饥自呼。\n强穿东郭履，来煮雪畦蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵菊坡","author":"朱松","text":"露浥秋英湿晓阴，小坡新斸伫幽寻。\n似欺兰畹方披羽，聊对风卮旋屑金。\n采采绕篱吟欲就，垂垂压帽醉难任。\n使君致主唐虞了，三径无忘此日心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芦槛","author":"朱松","text":"手斸修芦著槛栽，使君公退几徘徊。\n想当风雨翻丛急，疑卷江湖入座来。\n未办松窗眠绿浦，且将屐齿印苍苔。\n种成桃李人间满，应念孤根首屡回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再答诸公","author":"朱松","text":"芳节坐晼晚，客怀无一堪。\n柳眠犹自困，花笑为谁含。\n风揭拾遗屋，尘生执戟甔。\n联诗赖诸友，妙句压城南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董邦则求茶轩诗次韵","author":"朱松","text":"一轩新筑敞柴荆，北苑尘飞客思清。\n更买樵青娱晚景，便应卢老是前生。\n千门北阙梦不到，一卷玉杯心自明。\n冷看田侯堂上客，醉中谈笑起相烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仲猷北归二首 其一","author":"朱松","text":"一丘胸次有馀师，空此淹留岁月迟。\n黄墨工夫怜我倦，箪瓢风味要君知。\n新诗落笔惊翻水，俗学回头笑画脂。\n伊洛参同得力句，还家欲举定从谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仲猷北归二首 其二","author":"朱松","text":"欲寻当日故山盟，身世今如海一萍。\n归路上心真了了，愁根入鬓已星星。\n挽衣共釂东西酒，折柳送行长短亭。\n念我知君回首处，萱丛菖叶一时青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄吴致一","author":"朱松","text":"相逢一笑两忘怀，梦绕亲庭首重回。\n世事难磨三尺喙，离愁都付一分杯。\n秋生林薄岁时晚，水落江湖鸿雁来。\n剩作新诗频寄我，天涯时对两眉开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四月十五日上元道中","author":"朱松","text":"乱山身逐简书来，梅子黄时雨未开。\n一苇横斜风叶度，千滩赑屃雪城催。\n危机种种那容避，俗驾骎骎底未回。\n聊复浮游随造物，故园回首思悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄彦武西上","author":"朱松","text":"门掩蓬蒿气浩然，西风笔势更翩翩。\n未忘大学齑盐味，时说定林文字禅。\n芦叶风光倾上国，槐花心绪记当年。\n里门归日车应下，置酒迟君沈水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林丈挽诗","author":"朱松","text":"沈溪耆旧半丘墟，犹有期颐隐市区。\n未展武侯床下拜，已传颜子梦中呼。\n门人会筑三年室，迹客谁留一束刍。\n归卧九原应不恨，何蕃声誉满京都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀黄元声时闻在建上诗中所记建上旧游也","author":"朱松","text":"积雨山城久卧痾，起看横港涨晴波。\n空馀九尺须眉好，奈此一樽风月何。\n怀抱故人长在念，经行佳境想重过。\n东溪回首醉眠处，为问红蕖何许多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书室述怀奉寄民表兄是日得民表书","author":"朱松","text":"丈室无尘棐几横，吏休凫鹜散无声。\n舞风竹影僛僛转，萦梦炉香袅袅清。\n已笑荣枯卢白戏，不须物我触蛮争。\n故人剪烛西窗约，知复何时话此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答人留别之什","author":"朱松","text":"家在大江东复东，去君一舍碧流通。\n那知临水登山处，同寄飞蓬断梗中。\n愁绝杯中千里月，梦萦江上一帆风。\n只今且作须臾意，更典云裘醉小丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月四日宿丹溪道中","author":"朱松","text":"日出露芒重，凉生风叶翻。\n秋粳已照眼，社酒欲香村。\n牛下草莱湿，人归园屋昏。\n个中吾不浅，扰扰与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"求道人自尤溪来还冷斋有诗次其韵","author":"朱松","text":"五年沈水照衰颜，溪上今谁独往还。\n身插乱峰随一锡，梦回萧寺绕千间。\n西风潮落挐音急，斜日尊空醉袖班。\n更觉难追诗力健，大弨久废若为弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘道醇归乌石 其一","author":"朱松","text":"一廛避地本依刘，闻得更书始欲愁。\n旧德镌碑在人口，归装载石压溪舟。\n寄书莫忘青泥信，把酒谁同黄菊秋。\n新阁诗增风月价，自应神物护银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘道醇归乌石 其二","author":"朱松","text":"胸中一壑故超然，耿耿羞争倚市妍。\n万事一尊陶令酒，群儿满世祖生鞭。\n欲投乌石农桑社，尚有灵山香火缘。\n持节重来慰父老，蹊头相送各携钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题白鹿庵壁 其一","author":"朱松","text":"鹿门庞老携客隐，耳冷十年难与俱。\n蝼蚁梦中求曩事，芭蕉林里见今吾。\n游丝弄影分阴转，乔木摩空万壑趋。\n香妙心清无一事，不知何处是华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题白鹿庵壁 其二","author":"朱松","text":"滔滔一世强留连，头上从渠岁月迁。\n老子养生宁解事，小儿有口惯谈天。\n醉来莫负持螯手，老矣终寻种玉田。\n若怪微吟漏消息，九江谁识市门仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与求道人同之福唐","author":"朱松","text":"缚屋双峰云一坞，抛来伴我事幽寻。\n风花踪迹趣虽各，香火因缘情自深。\n浮峡未兴圆泽叹，乘桴还有仲由心。\n三山他日记耆旧，凿齿弥天无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李尧端见嘲食蕨","author":"朱松","text":"真人官府未夤缘，且向龙山作散仙。\n春入晓痕催采蕨，雨翻泥陇忆归田。\n蔬肠我若枵蝉腹，诗格君如击鹘拳。\n箸下万钱谋更鄙，诸公饱死太官膻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧端试茶","author":"朱松","text":"龙文新夸荐缃罗，园吏分尝苦未多。\n自瀹云腴?露井，坐知雪粒采阳坡。\n撑肠君要浇黄卷，爱酒渠方捲白波。\n我亦个中殊不浅，断无踪迹到无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送友生","author":"朱松","text":"剥喙门前久未嗔，定知我辈不羁人。\n午窗唤起梦魂好，一语便知风味真。\n身婴世网坐营口，心识醉乡慵问津。\n忽先秋燕背人去，四角何由生客轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠范直夫","author":"朱松","text":"将军竞病诗成处，南浦春归兰玉丛。\n渐减心情身老大，久乖谈笑路西东。\n乡关落日苍茫外，樽酒寒花寂历中。\n且与寓公同放旷，浩歌相属倚秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招友生","author":"朱松","text":"雨收天气欲清明，犹有馀寒在粥饧。\n马队客勤贪昼永，鳣堂人病想身轻。\n读书有味齑盐好，对境无情梦寐清。\n欲话此怀须我辈，一来蜡屐伴春行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辛亥中秋不见月","author":"朱松","text":"今夕九秋半，心期负隔年。\n劳生灰劫里，微雨客游边。\n旅泊正无酒，阴云遑怨天。\n何时草堂月，相对藉糟眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵罗源谢成章作不烹鸣鸡诗","author":"朱松","text":"彼美司晨族，胶胶职效鸣。\n为怜君子操，宁乏小人羹。\n恩重栖时稳，心危失旦惊。\n未甘乌转夜，聊学雁全生。\n结客观酣斗，要君事割烹。\n那知竞辰子，力学务时成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵汪彦允见寄","author":"朱松","text":"北苑乖期恨昔年，异乡牢落梦江天。\n约游汗漫传新句，许出婵娟有旧缘。\n种种鬓丝何计换，摇摇心旆不胜悬。\n归耕要伴君难老，相与笞鸾作散仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与吴昌国同游灵水院二首 其一","author":"朱松","text":"算舟吏散了无事，与客意行初不谋。\n饱看云涛舞空阔，欣逢泉石媚深幽。\n西汉未试补天手，上界那知鞭凤游。\n剪烛他年忆真赏，莫嗟身世尚沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与吴昌国同游灵水院二首 其二","author":"朱松","text":"来往风流记两翁，天涯今作九秋蓬。\n坐惊秀色悬眉宇，便觉仙峰入手中。\n傲世真成漆园吏，输君不负北窗风。\n书生浪发新亭叹，自笑尊前气吐虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠吴昌国二首 其一","author":"朱松","text":"居越与谁语，得君宽我愁。\n颇惊三日别，更为一樽留。\n食藿有馀味，泣河非所谋。\n相看抚身世，容与愧苍鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠吴昌国二首 其二","author":"朱松","text":"忆我少年日，游君大父閒。\n诸孙嗟契阔，双鬓各斓斑。\n未觉归愚晚，俱尝适俗艰。\n绝知归思急，更觅玉梅攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孔生示二诗答一篇","author":"朱松","text":"岁晚尊前一笑哗，怜君孤愤老天涯。\n诸豪虽识临邛客，陋族难当阙里家。\n会有孟光求共隐，不应牧犊但长嗟。\n青衫华发春风里，择婿犹堪驻宝车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄江少明","author":"朱松","text":"龙卷风云一发蟠，不妨聊作侍祠官。\n高情未许群儿觉，万事何须正眼看。\n问道从公春信近，谈天容我酒杯宽。\n乘桴亦有平生意，回首纷纷行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘仲高怀外舅家梅花","author":"朱松","text":"柯山月下婵娟影，前度刘郎馀故情。\n诗成回首恋三宿，我亦惜花痴半生。\n雁沉寒水菩提长，虫蚀真诠章句清。\n西湖悬绝得鸾喙，可但能专五字城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送景思奉祠之温州","author":"朱松","text":"司祀名郎下紫宸，王师载主尚时巡。\n丕承配极威灵在，对越垂休命秩新。\n幽梦想多春草句，清江为洗涅衣尘。\n行观前席来宣室，可但从容问鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑德与归舟中感怀","author":"朱松","text":"两牛鸣地隔寒流，病起相望客鬓秋。\n闻道唤船归别浦，坐怀联策倚沧洲。\n骚人空复惊摇落，胡贾何须叹滞留。\n会拥蒙冲入河渭，看君黄色上眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李似表取告归晋陵","author":"朱松","text":"酌酒掺归袂，繁阴殊未收。\n心知非远别，自不柰离愁。\n蓬渚倦怀椠，云台归借筹。\n遄来阊阖路，万马避前驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致政宣教魏公挽诗二首 其一","author":"朱松","text":"己自应无憾，人犹叹不遭。\n簪缨门已大，湖海气方豪。\n旧国牛矶外，新阡马鬣高。\n流芳传教子，步武接夔皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致政宣教魏公挽诗二首 其二","author":"朱松","text":"交盖岁云晚，向人怀自倾。\n争棋消永昼，酌茗话平生。\n转手便陈迹，抚书增故情。\n无由从执绋，空想葬箫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘氏挽诗","author":"朱松","text":"馀庆钟兰秀，初占合凤飞。\n那知风不止，遽作露先晞。\n鬻剃筵方彻，齐眉事已非。\n魂车春陌上，空背夕阳归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次钊彦仲傅茂先韵","author":"朱松","text":"强蹋府尘从傅子，立谈江阁识钊郎。\n一尊此地见眉宇，十载相思成鬓霜。\n秋灯煜煜照情话，夜浪翻翻吹客床。\n投名径入农圃社，老矣不梦天门翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建安道中","author":"朱松","text":"荦确复荦确，秋山殊未晴。\n流年半羁旅，此地几经行。\n雪岭今慵照，茅檐欲谩营。\n大钧浑莫问，流坎任馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送蔺廷彦之衡州","author":"朱松","text":"墙东新径去年开，二老扶筇便往来。\n数面何曾三日别，离怀都寄十分杯。\n客亭系马梅争落，官舍裁书雁欲回。\n秉执枢机有知己，未须卜筑向蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"商羊","author":"朱松","text":"异鸟来齐国，仍依殿陛翔。\n从容询鲁相，物色是商羊。\n欲雨追童语，怀山验水祥。\n民宁因备豫，政美谢祈禳。\n止异爰居久，鸣无垤鹳长。\n愿言苏旱虐，主上似宣王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次张演翁林元惠韵","author":"朱松","text":"朱门小驻使君车，二老风流入画图。\n但有觥筹供笑语，从教岁月上髯须。\n诗成华烛留残蜡，客醉高歌叩缺壶。\n更起争棋誇得隽，不应局蹙守边隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公相起犁锄","author":"朱松","text":"帝室尊公相，潭潭大府居。\n从容调鼎铉，奋发自犁锄。\n弼亮恢贤业，班联冠广除。\n艰难同耦日，慷慨辍耕初。\n厚币来莘野，幽人出冀墟。\n渴贤才仄席，何计老田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太康道中二首 其一","author":"朱松","text":"得春榆柳遍平郊，犹见藏鸦影未交。\n动地风来一披拂，青黄浅浅抹林稍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太康道中二首 其二","author":"朱松","text":"一色春匀万树红，坐愁吹作雪漫空。\n谁知榆荚杨花意，只拟春残卷地风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯夕时在泗上五首 其一","author":"朱松","text":"灯花作意照归人，短棹扁舟寂寞滨。\n帝力如春苏万物，遥知太一不威神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯夕时在泗上五首 其二","author":"朱松","text":"云窗月槛仰乘舆，俯看香车出绣襦。\n九陌人人歌帝力，不须微服过康衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯夕时在泗上五首 其三","author":"朱松","text":"鸾驾翩翩驭晚风，积苏宫阙夜濛濛。\n明朝遣觅铁如意，应在凉州酒肆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯夕时在泗上五首 其四","author":"朱松","text":"我欲安心未有方，至人遗迹已茫茫。\n自非窣堵波中老，谁直先生一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯夕时在泗上五首 其五","author":"朱松","text":"我观世界只儿嬉，一戏相从更莫辞。\n绮语未忘馀习在，明朝与和紫姑诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松江三首 其一","author":"朱松","text":"尘缘挽我去渔矶，回首沧洲此愿违。\n偶寄一舟江上去，只无箬笠与蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松江三首 其二","author":"朱松","text":"表里江湖眼界新，解誇奇观属诗人。\n要须一釂三江水，净洗多生舌本尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松江三首 其三","author":"朱松","text":"晴江渺渺跨江干，春涨平湖万顷寒。\n欲挽银潢供砚滴，坐如震泽在毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠碧","author":"朱松","text":"长桥画柱照清沦，俯见游鯈不可缗。\n山影半溪丛筱密，谁知翠碧解藏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋王伯温家酴醾","author":"朱松","text":"翩翩风驭驾花神，更遣酴醾殿晚春。\n压架秾香千尺雪，唤回中酒惜花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王彦行送樱桃","author":"朱松","text":"香英狼籍了无馀，偿我残春一斛珠。\n犹带微酸饷佳客，为嫌啼鸟啄红肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芍药二首 其一","author":"朱松","text":"红颜素脸出春残，袅袅传传态自完。\n闻道扬州冠天下，何年跨鹤往吟看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芍药二首 其二","author":"朱松","text":"舞困春风睡思深，东君更与缠腰金。\n颓檐醉尉花应笑，那有当年幕客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月岩去上饶十里山有侧穴腹背皆洞如月","author":"朱松","text":"凿透巉岩不记春，山腰千古挂冰轮。\n谁知擘破三峰手，聊出婵娟戏路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湛师","author":"朱松","text":"一月分身入万池，道人何处不相随。\n卧听绝壑传风籁，历历新诗世不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]