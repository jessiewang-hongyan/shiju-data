[{"title":"怀故人留题","author":"王庭圭","text":"桃李无言对斜日，可堪回首一凄然。\n子云投阁知何在，太白骑鲸已上天。\n春蚓秋蛇留败壁，金钩玉带锁寒烟。\n人行古木横塘路，门掩长江上水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王秀才","author":"王庭圭","text":"怒发冲冠忘指瑕，要能全璧始还家。\n闭门且任蓬蒿长，落笔当令绮绣华。\n丽句美如青玉案，明珠深贮绛囊纱。\n爱君年少已如许，他日相逢未可涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"波光亭","author":"王庭圭","text":"绕亭春水縠纹生，拍岸风微镜面平。\n日破浪花摇柱础，影浮山翠落檐楹。\n鱼跳莲叶东西动，月涌金盆表里明。\n夜久光凝收绿净，冷涵星汉逼人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酴醾","author":"王庭圭","text":"百花狼藉点青苔，始见酴醾烂漫开。\n虢国朝天嫌粉污，唐昌夜月恐仙来。\n寒梅胜韵聊堪友，秾李凡姿讵敢陪。\n便欲乘风凌倒影，醉寻香径上瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和黄元授送赵敦本赴万安宰","author":"王庭圭","text":"欲救斯民病久尪，想君家谱有奇方。\n但须去恶犹去草，要使牧人如牧羊。\n正值彫残经寇乱，还思激烈咏时康。\n当年手种闲桃李，今日成阴总类棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和元授闵旱","author":"王庭圭","text":"旱魃凌空气愈炎，断无微雨应时沾。\n正忧龙卧深蟠水，安得江声碎泻檐。\n禾黍似堪供野火，妇姑犹拟共腰镰。\n此时政要调元手，谁作商霖慰具瞻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其一","author":"王庭圭","text":"平昔无才可致君，此生何处欲超群。\n今逢四海干戈动，犹得山间卧白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其二","author":"王庭圭","text":"偶携琴剑入山来，惊觉高僧定里回。\n扶下绳床始开眼，嗔人马迹涴苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其三","author":"王庭圭","text":"幡竿插入千岩底，鸟语飞来绝壁间。\n洞口行人迷处所，不知钟梵锁孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其四","author":"王庭圭","text":"山腰危殿倚青葱，知是云峰第几重。\n恐有书生来问道，为凭轻打饭前钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其五","author":"王庭圭","text":"奇峰削出青莲萼，远溜萦回碧玉环。\n气接混茫藏句法，不知谁与破天悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其六","author":"王庭圭","text":"洞里花开透碧霄，溪横三绕赤栏桥。\n他年桥断人迷路，咫尺山源万里遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其七","author":"王庭圭","text":"昔人骑鹤岭头归，应有仙居在翠微。\n绝壁苍藤无处问，时闻清唳揭云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其八","author":"王庭圭","text":"破腊山桃已盛开，飞花无数点青苔。\n莫教流出前溪去，引得鱼舟入洞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其九","author":"王庭圭","text":"岩下逢人说乱离，十年眼底厌旌旗。\n边尘复暗江南路，堪羡山僧总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎己酉十二月五日避乱鸽湖山十绝句 其十","author":"王庭圭","text":"伟岸棱棱似立朝，巍峨冠剑想风标。\n可怜有貌无肝胆，何用昂然近紫霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赠周师禹二首 其一","author":"王庭圭","text":"山中自有陶宏景，窗外谁呼祁孔宾。\n不敢移文约周子，升沈共作太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赠周师禹二首 其二","author":"王庭圭","text":"昼卧柴门打不开，相逢未识济川才。\n那知此夜闻猿处，忽有新诗随雁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠李子安","author":"王庭圭","text":"穷居未有四立壁，负郭兼无二顷田。\n拟斸云根结茅屋，不知谁赠买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵高秀才","author":"王庭圭","text":"腊尽梅花落不停，笛声孤起不堪听。\n且留溪影弄清浅，更看残英动晓星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠松庵僧","author":"王庭圭","text":"庵在深村翠岭坳，狂风捲尽屋头茅。\n断椽破壁何时理，卧看松阴月转梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和郑元清同游殷仲堪读书台二首 其一","author":"王庭圭","text":"晋国衣冠扫地空，渔歌长在水云中。\n倚栏欲问兴亡事，木末琉璃坠晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和郑元清同游殷仲堪读书台二首 其二","author":"王庭圭","text":"池上高台倚碧空，郡楼相对出烟中。\n读书太守今何在，寂寞无人继此风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁道人借示丹经数册阅未遍辄告行归其书赠之以诗二首 其一","author":"王庭圭","text":"丹经汗损几车牛，奥意难从纸上搜。\n相见缠腰无十万，待看骑鹤上扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁道人借示丹经数册阅未遍辄告行归其书赠之以诗二首 其二","author":"王庭圭","text":"夜半沧溟看日头，忽闻风雨下层楼。\n却寻双径朝金阙，又跨苍龙海上游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢彭仲宽惠小茶磨并仙茅二首 其一","author":"王庭圭","text":"踏梯割得紫云归，琢就双轮半尺围。\n晴日午窗新睡起，掌中轻转雪花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢彭仲宽惠小茶磨并仙茅二首 其二","author":"王庭圭","text":"梦具白鸡犹不死，胸吞赤凤得长生。\n向来未识仙茅草，误向松根采茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵魏伯元","author":"王庭圭","text":"公荣自可不与饮，子美何时得细论。\n正遇题舆陈仲举，岂容无礼灌将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"侯大渊惠花","author":"王庭圭","text":"扬州庙下子规啼，曾看花开万玉妃。\n二十四桥明月夜，春风十里捲帘时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和读书台入夜即事二首 其一","author":"王庭圭","text":"池底星光个个添，半钩斜月吐纤纤。\n数声寒笛西风下，人在朱楼捲暮帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和读书台入夜即事二首 其二","author":"王庭圭","text":"云捲寒蟾玉晕添，嫦娥遥想鬓毛纤。\n此时清境非人世，要望烟霄不下帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵卢赞元蒙田寺桥亭夜月","author":"王庭圭","text":"青版桥边秋月明，江风不动縠纹平。\n沙头野鹤摩天起，飞入紫霄云外鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘美中赠段居士","author":"王庭圭","text":"昨夜送人为太守，今朝不记是何年。\n归来一粟庵中坐，水在瓶中月在天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赠慈书记 其一","author":"王庭圭","text":"探骊犹记湘西寺，爱我诗如左禅军。\n慈也果能拈此句，定知词笔带烟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赠慈书记 其二","author":"王庭圭","text":"寂音尊者断声闻，犹似衔枚未战军。\n横出一枝来大仰，如今不赋暮天云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赠慈书记 其三","author":"王庭圭","text":"老洪作语惊一世，笔力可敌千人军。\n足下马驹今复出，纵横踏破岭头云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向文刚三绝 其一","author":"王庭圭","text":"沈谢曹刘拟绝伦，唯公词翰可招魂。\n新诗不拾前人语，文彩风流自一门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向文刚三绝 其二","author":"王庭圭","text":"吏案堆尘番故纸，茶瓯浮雪动吟魂。\n长官政拥黄紬被，卧听排衙昼掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵向文刚三绝 其三","author":"王庭圭","text":"诗仙句法可换骨，岂但能苏九死魂。\n要自胸中出机杼，不须剽掠傍人门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兵火之后家藏坟籍荡然寄居江村欲借书诸公先寄此诗 其一","author":"王庭圭","text":"卜筑江村翠岭坳，喜君书室近衡茅。\n牙签插架几千册，准拟从头借一抄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兵火之后家藏坟籍荡然寄居江村欲借书诸公先寄此诗 其二","author":"王庭圭","text":"闻道藏书埒石渠，仍能一读五行俱。\n不妨借我遮愁眼，胜著闲窗饱蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瓯阳广明病中觅酒","author":"王庭圭","text":"满径蓬蒿贫不病，一区寂寞奈愁何。\n杜门芳草长杨赋，可是无人载酒过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡烈臣卧云庵","author":"王庭圭","text":"小庵深隐红尘外，云在茅檐四角边。\n月落乌啼天欲晓，惊回何处梦游仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和葛德裕寄纸觅兰四绝句 其一","author":"王庭圭","text":"丽句云笺敌夜光，穷儿得宝但能藏。\n惭无好语酬佳惠，徒咏春洲杜若香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和葛德裕寄纸觅兰四绝句 其二","author":"王庭圭","text":"林下无人亦自芳，幽姿闲澹若深藏。\n与君坐上添幽客，胜爇金炉百和香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和葛德裕寄纸觅兰四绝句 其三","author":"王庭圭","text":"君家词翰妙天下，虿尾银钩世所藏。\n赠我云蓝岂宜辱，强吟春草拾馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和葛德裕寄纸觅兰四绝句 其四","author":"王庭圭","text":"两朵幽花费咏章，是中佳境若为藏。\n何时同上瑶台顶，遍玩芝田蕙圃香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听麟师诵经","author":"王庭圭","text":"念经衲子乱如麻，心悟方能转法华。\n待得莲花从口发，自牛车上觅三车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答萧道人","author":"王庭圭","text":"唤起赤龙耕玉池，鹊巢抱出凤凰儿。\n且看火里莲花发，十二楼前雪自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读唐遗录六绝 其一 梁祖纪","author":"王庭圭","text":"深宫三鼓夜方分，梁祖唯知虑太原。\n错料诸儿非彼敌，斩关还入万春门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读唐遗录六绝 其二 李愚刘朐同传","author":"王庭圭","text":"两公罢相由诸吏，提印驩呼颇自誇。\n因谓我曹当快活，月华门外听宣麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读唐遗录六绝 其三 杨师厚","author":"王庭圭","text":"万炬千釭照一城，彩舟犹听棹歌声。\n铁车空驾黎阳石，岂悟碑来祸已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读唐遗录六绝 其四 成汭","author":"王庭圭","text":"劳役三年成巨舰，出师未战失江陵。\n不知雷满和州载，始悟齐山截海名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读唐遗录六绝 其五 安审信","author":"王庭圭","text":"入阁趋班最后时，崇元御史合弹之。\n如何进奉二十万，便逐台中乞索儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读唐遗录六绝 其六 冯道","author":"王庭圭","text":"大帝四朝咸败事，惟君卖国作功臣。\n平生自谓痴顽老，晚节仍为谬语人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵卢赞元江亭即事二绝句 其一","author":"王庭圭","text":"斜日江头春又归，半天垂柳拂云齐。\n流莺向晚浑无赖，隔水飞来枝上啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵卢赞元江亭即事二绝句 其二","author":"王庭圭","text":"江水磨铜鉴面寒，钓鱼人在蓼花湾。\n云间贪看新月上，不觉小舟流下滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县尉任子严出示从军陪大将吴侯游石峒五绝句奉次元韵颂日颂平贼之功喜而有作云 其一","author":"王庭圭","text":"东来骑火照松萝，野老逢迎笑语多。\n共指岩前一方石，将军大剑可横磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县尉任子严出示从军陪大将吴侯游石峒五绝句奉次元韵颂日颂平贼之功喜而有作云 其二","author":"王庭圭","text":"石窟巉岩鬼不开，狂童乘此起氛埃。\n殿前兵马何曾出，旗鼓初从天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县尉任子严出示从军陪大将吴侯游石峒五绝句奉次元韵颂日颂平贼之功喜而有作云 其三","author":"王庭圭","text":"锦带雕弓银马鞍，鸣鞭飞下白云山。\n回头却望经行处，已在青苍杳霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县尉任子严出示从军陪大将吴侯游石峒五绝句奉次元韵颂日颂平贼之功喜而有作云 其四","author":"王庭圭","text":"不待皇恩下九天，将军兵已入卢川。\n奸人妄献招安策，留客丹崖万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县尉任子严出示从军陪大将吴侯游石峒五绝句奉次元韵颂日颂平贼之功喜而有作云 其五","author":"王庭圭","text":"回师小度石门西，铁马嘶风四百蹄。\n不为从军一时乐，扪萝攀径岂能跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠筠州司户施文叔二绝句 其一","author":"王庭圭","text":"高轩过我不停轮，风袂飘如出岭云。\n渭北江东无尽意，何时重得细论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠筠州司户施文叔二绝句 其二","author":"王庭圭","text":"村巷尽无车马尘，君来笑语动比邻。\n儿童惊问此何客，亹亹清言来逼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送周解元赴岳侯军二绝句 其一","author":"王庭圭","text":"将军欲办斩楼兰，子欲从之路匪艰。\n十万奇才并剑客，会看谈笑定天山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送周解元赴岳侯军二绝句 其二","author":"王庭圭","text":"书生投笔未封侯，拔剑聊为万里游。\n燕颔果能飞食肉，要令豹尾出兜鍪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中赠别黄秀才","author":"王庭圭","text":"雪欲漫山冰未澌，梅花破雪吐寒枝。\n溪桥渐见黄昏月，应有横斜倒影诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘虞卿衣弊履穿有号寒之忧赋绝句以道其意","author":"王庭圭","text":"江上丹枫半摇落，檐间青女忽横陈。\n可怜范叔寒如此，谁解绨袍念故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄子馀二绝句 其一","author":"王庭圭","text":"沈谢曹刘俱一体，风流文彩自难兼。\n黄香独负无双誉，不管红尘压帽檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄子馀二绝句 其二","author":"王庭圭","text":"秋风动地吹纤末，夜雨连明搅寸心。\n西北高楼何缥缈，信非吾土莫登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘英臣早春见过二绝句 其一","author":"王庭圭","text":"池草青青细吐芽，梦回疑到惠连家。\n东风未暇吹桃李，先发寒梅第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘英臣早春见过二绝句 其二","author":"王庭圭","text":"春至盘蔬有蕨芽，纸窗竹屋自成家。\n客来清坐不饮酒，旋破龙团泼乳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送罗孟弼 其一","author":"王庭圭","text":"平步蟾宫脚失梯，当年才命巧相违。\n遭时何必由场屋，但著青袍骑马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送罗孟弼 其二","author":"王庭圭","text":"君到吴山莫问禅，禅翁无法与君传。\n若从妙喜觅言句，掀倒禅床却悄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]