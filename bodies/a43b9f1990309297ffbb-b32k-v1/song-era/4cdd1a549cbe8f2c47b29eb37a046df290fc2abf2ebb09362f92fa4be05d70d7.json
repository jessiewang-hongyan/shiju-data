[{"title":"迎翠楼自赋","author":"梁文奎","text":"江山诗兴动，宇宙画图开。\n风捲软红去，云迎霏翠来。\n行藏老身矣，临眺意悠哉。\n倚遍栏杆曲，残阳入酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题增城进士单有明清白传家卷","author":"梁文奎","text":"清如增江水，白如白石山。\n羡尔清白人，栖迟山水门。\n至清不可淆，至白不可淫。\n传子复传孙，一心如一辙。\n山同今古色，水同今古流。\n载阅清白卷，山水两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与晦庵先生同宿清虚庵","author":"梁平叔","text":"幽斋共坐论功夫，借问先生识此无。\n悟得此中真妙诀，人间始信有仙壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"梁安世","text":"南国秋光过二，宾鸿未带初寒。\n洞中驼褐已嫌单。\n洞口犹须挥扇。\n夕照千峰互见，晴空万象都还。\n羡他渔艇系澄湾。\n敧枕玻璃一片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高山堂","author":"梁佐厚","text":"危巅层阁倚云平，一凭阑干醉魄醒。\n霁雨乱山生淡碧，带风寒竹有馀青。\n孤猿傍石来深涧，幽鸟冲烟入画屏。\n却让高僧占仙境，蓬莱不独在沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈休应烹茗廓然亭见送韵","author":"梁克家","text":"已行更为玉泉留，好景烦公杰句收。\n紫帽峰前双鹭下，几多清兴满沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋九月梅花","author":"梁克家","text":"老菊残梧九月霜，谁将先暖入东堂。\n不因造物于人厚，肯放南枝特地香。\n九鼎燮调端有待，百花羞涩敢言芳。\n看来水玉浑相映，好取龙吟播乐章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"梁纯","text":"好峰又是来当面，不惜迟迟下马看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"梁周翰","text":"知有英儒伯始孙，聚书讲学贲丘园。\n征搜合副来贤诏，旌表宜题遍德门。\n举族为人俱孝弟，深幽何草不兰荪。\n小冠子夏来相示，诗版因凭寄竹轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁林宴会之什","author":"梁周翰","text":"宝书惊绝耀天章，飞白亲题赐玉堂。\n瑞彩上腾流素月，朗河下注映丹墙。\n鹤盘吴屿双翎健，鹊顾雕陵巨翼长。\n游雾半收悬组练，轻云斜拂驻鸾皇。\n墨池并获三奇宝，翠琰俱生五色光。\n陪宴禁林知有幸，叩头遥祝万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"梁周翰","text":"宿雨一番蔬甲拆，春山几处茗旗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"梁周翰","text":"谁似金华杨学士，十联诗在御屏间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"梁周翰","text":"百花将尽牡丹坼，十雨初晴太液春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画竹绢扇面","author":"梁宗范","text":"团团纨扇阿谁绷，露出琅玕三两茎。\n密叶旋从人意长，劲枝全藉笔毫生。\n翠筠不动风常在，直节无根色自荣。\n只恐半天雷雨夜，化龙应向手中成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 寿吕道山四十九岁","author":"梁明夫","text":"万里朝天去。\n见浔阳江上，风引仙舟淮浦。\n到得玉阶方寸地，历历苍生辛苦。\n要尽活、江南一路。\n昼绣归来沾御渥，听邦人、箫鼓迎初度。\n龟与鹤，亦掀舞。\n前身定是磻溪吕。\n笑当时、八十始卜，非熊非虎。\n试数行年逢革卦，革命正逢汤武。\n真千载、风云会遇。\n拟向庐山招五老，诣道山、同献蓬莱赋。\n仍剪菊，荐秋露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廓然亭","author":"梁知录","text":"危亭缥渺斗星傍，俯槛连云挂碧苍。\n航快远随飞鸟下，树秾阴覆酒樽凉。\n胡床坐久景方见，诗句评多味最长。\n况有青山对挥麈，每逢高论赏仇香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜怀林叔刚","author":"梁该","text":"凉生秋雨霁，华月上疏林。\n因听落叶响，稍知秋意深。\n芳岁倏已徂，白发鬓边侵。\n故人渺何许，日夜怀徽音。\n无由亲兰藻，何以慰冲襟。\n云中徒矫首，露下空长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登镇海楼闻角声赋","author":"梁栋","text":"听彻哀吟独倚楼，碧天无际思悠悠。\n谁知尽是中原恨，吹到东南第一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢氏梅园","author":"梁栋","text":"纤腰冻欲折，来探前村雪。\n幽禽莫相猜，岁寒心似铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题叶东叔宾月堂","author":"梁栋","text":"人生自是人间客，月亦天边寄此身。\n彼此虚空无著处，谁欤是主复谁宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼","author":"梁栋","text":"思归不觉岁华侵，倦抚旌旗感慨深。\n旧日家乡今日客，一年时序百年心。\n城馀故址元非铁，山得虚名不是金。\n槛外长江成底事，英雄对酒话蹄涔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵三迁有感","author":"梁栋","text":"憔悴城南短李绅，多情乌帽染黄尘。\n读书不了平生事，阅世空存后死身。\n落日江山宜唤酒，西风天地正愁人。\n任他蜂蝶黄花老，明月园林是小春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵废宫","author":"梁栋","text":"六代俄然又一唐，青山坐阅几兴亡。\n心知江左非王业，口说中原是帝乡。\n落日有时登北固，春风吹梦过钱塘。\n荆坟桧宅依然在，留与乌衣话短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨花台","author":"梁栋","text":"春中景物尚凄然，小立崇台古树边。\n潮信不嫌城寂寞，山光似与客留连。\n英雄马鬣无馀地，气势龙蟠得几年。\n眼底兴亡总闲事，不如有酒醉花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒御史张月卿","author":"梁栋","text":"我家元住君邻州，我父当时亦故侯。\n中原百年龙战野，南滨一日鳌吞钩。\n遗黎常恨旧隔绝，故乡喜遇新交游。\n路人行行望骢马，山中却为诗淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题寅叔小园","author":"梁栋","text":"深巷浑无市井喧，主人有客便开樽。\n数竿修竹三间屋，几树閒花一亩园。\n楚岫和云移怪石，秦淮流月下高源。\n此身且比渊明乐，母在高堂子候门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠嘉兴徐同年","author":"梁栋","text":"忆昔青龙在戊辰，马蹄同踏杏园春。\n归田令尹空书晋，执戟郎君尽美新。\n万事不醒中酒圣，一贫无奈讼钱神。\n相逢莫效穷途泣，自古求仁要得仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨有感二首 其二","author":"梁栋","text":"少年不学稼，老大生理拙。\n入山采黄精，穷冬一尺雪。\n虎狼正纵横，原野有白骨。\n伤心重伤心，吾饥何足恤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨有感二首 其一","author":"梁栋","text":"冥云生八荒，骤雨忽然至。\n中宵揭屋破，漏湿无处避。\n床床不得乾，僵立见憔悴。\n娇儿莫啼哭，少须待晴霁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四禽言四首 其三","author":"梁栋","text":"行不得也哥哥，湖南湖北春水多。\n九嶷山前叫虞舜，柰此乾坤无路何。\n行不得也哥哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀毗陵","author":"梁栋","text":"荆溪水腥泊船早，落日无人行古道。\n髑髅有眼不识春，东风吹出青青草。\n荒基犹认是人家，败栅曾将当城堡。\n当时压境兵百万，不脱靴尖堪蹴倒。\n短兵相接逾四旬，毒手尊拳日攻讨。\n内储外援两消沈，一缕人心坚自保。\n孤臣守土轻性命，赤子效死涂肝脑。\n朝廷有爵愧降附，幽壤无恩泽枯槁。\n愿笺司命录英雄，收拾忠魂畀穹昊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日郊游和友人韵","author":"梁栋","text":"忆昔东风御柳斜，枯肠一日万周车。\n壮心难起泥中絮，老眼羞看雾里花。\n巷陌几家无主燕，池塘一种为官蛙。\n江南寒食无烟火，白昼沈沈似月华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送存书记","author":"梁栋","text":"一声两声松子落，一片两片枫叶飞。\n夕阳在山新月上，道人相伴一僧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李北山归建康 其一","author":"梁栋","text":"人生无百年，胡为在远道。\n游子悲故乡，王孙怨芳草。\n有田归去来，无田归亦好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李北山归建康 其二","author":"梁栋","text":"贫贱有饿死，富贵履危机。\n东海不可渔，西山采无薇。\n四方已一气，我今将安归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渊明携酒图","author":"梁栋","text":"渊明无心云，才出便归岫。\n东皋半顷秫，所种不常有。\n苦恨无酒钱，閒却持杯手。\n今朝有一壶，携之访亲友。\n惜无好事人，能消几壶酒。\n区区谋一醉，岂望名不朽。\n閒吟篱下菊，自传门前柳。\n试问刘寄奴，还识此人不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野水孤舟","author":"梁栋","text":"前村雨过溪流乱，行路迷漫都间断。\n孤洲尽日少人来，小舟系在垂杨岸。\n主人空有济川心，坐见门前水日深。\n袖手归来茅屋下，任他鸥鸟自浮沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄葵","author":"梁栋","text":"乾坤有正气，间色皆为臣。\n名葩据中央，红紫谁敢邻。\n倾日不忘君，卫足恐伤身。\n冥然无知识，忠孝出本真。\n林林天地间，戴履而为人。\n明灵秀万物，孰不尊君亲。\n嗟嗟叔季后，利欲泯天伦。\n邈哉望帝国，产此瑞世珍。\n九夏不趋炎，三月不争春。\n高秋风露冷，孤标出清尘。\n背时还独立，揽芳泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋蔬","author":"梁栋","text":"家贫忽暴富，菜种二十七。\n痴儿不解事，问我何从得。\n于义苟有违，吾宁饥不食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一萼红 芙蓉和友人韵","author":"梁栋","text":"怨东风。\n把韶华付去，秾李小桃红。\n黄落山空，香销水冷，此际才与君逢。\n敛秋思、愁肠九结，拥翠袖、应费剪裁工。\n晕脸迎霜，幽姿泣露，寂寞谁同。\n休笑梳妆淡薄，看浮花浪蕊，眼底俱空。\n夜帐云闲，寒城月浸，有人吟遍深丛。\n自前度、王郎去后，旧游处、烟草接吴宫。\n惟有芳卿寄言，蹙损眉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 春梦","author":"梁栋","text":"一场春梦，待从头，说与旁人听著。\n罨画溪山红锦障，舞燕歌莺台阁。\n碧海倾春，黄金买夜，犹道看承薄。\n雕香剪玉，今生今世盟约。\n须信欢乐过情，闲嗔冷妒，一阵东风恶。\n韵白娇红消瘦尽，江北江南零落。\n骨朽心存，恩深缘浅，忍把罗衣著。\n蓬莱何处，云涛天际冥漠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摸鱼儿 登凤凰台","author":"梁栋","text":"枕寒流、碧萦衣带，高台平与云倚。\n燕来莺去谁为主，磨灭谪仙吟墨。\n愁思里。\n待说与山灵，还又羞拈起。\n箫韶已矣。\n甚竹实风摧，桐阴雨瘦，景物变新丽。\n江山在，认得刘郎何寄。\n年来声誉休废。\n英雄不博胭脂井，谁念故人衰悴。\n时有几。\n便凤去台空，莫厌频游此。\n兴亡过耳。\n任北雪迷空，东风换绿，都付梦和醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"梁栋","text":"浮云暗不见青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"梁栋","text":"千株守红死，一点反魂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题周坦戴氏桂林池馆","author":"梁泰来","text":"地偏不受点尘侵，日涉园亭得趣深。\n竹外移梅曾辟径，月中分桂定成林。\n云山环碧醉人眼，池水澄泓鉴此心。\n净几明窗潇洒尽，时携好客一凭临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟山亦好轩","author":"梁泰来","text":"人在远堂山下居，家有远堂堂上书。\n阶苔帘草意自如，有书可读山可庐。\n人于富贵不肯足，我于贫贱乐有馀。\n相逢休问我何好，亦有好处人未知。\n一池斗大泉可掬，一波掌平数丛菊。\n菊吾金，泉吾玉，何用封侯万钟粟。\n君不见孔门乐处无日无，疏食饮水肱常曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冲虚观","author":"梁真素","text":"三千六百丈罗浮，来今往古得仙游。\n转头丹葛如昨日，接武苏辕能几秋。\n石洞尚听黄鹤语，铁桥仍见紫云留。\n当时野老呕吟地，试问山灵记得否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖山楼","author":"梁竑","text":"千峰背负乌聊山，一区面蛰龙停渊。\n壶中日月自天地，淮南鸡犬皆神仙。\n当湖次第列小隐，花坞直与山房连。\n海棠成径当步障，藕花满洲宜泛船。\n竹斋潇潇碧玉干，菊坡采采黄金钱。\n月观无云饱秋色，风松有雷惊昼眠。\n流杯不减昔曲水，烹茶况汲今蒙泉。\n山家四时无不好，跨蹇扶筇性所便。\n主人早岁取科第，策足要津先著鞭。\n声名藉甚四十载，三朝眷注知才贤。\n方今圣人勇于治，搜罗侧隐无弃捐。\n乡里老成相继出，如公自合比其肩。\n遂持一节向江右，即赐十行朝日边。\n那知念念作归计，把玩图画心茫然。\n他日乞身谅未晚，赤松黄石相忘年。\n观公名楼自有意，流行坎止岂非天。\n扁舟过公一夕耳，心屡欲往身无缘。\n逮公来归我亦老，卜邻共赋招隐篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陆贾大夫庙","author":"梁竑","text":"刘郎辛苦逐秦鹿，尚欲长鞭及马腹。\n蛮夷大长梦不惊，海边椎髻乘黄屋。\n江淮貔貅始闲暇，忍使驱令渡篁竹。\n陆生手持尺二组，唤起老子同分肉。\n诗书尚晓骂儒翁，岂忧桀骜难拘束。\n筑坛再拜受王印，雄辨泠泠听不足。\n当时未有北人辅，留寓年深染污俗。\n乍闻高论耳目清，如掩笙簧奏冰玉。\n境中胜处应更履，更溯馀皇到山麓。\n大夫何独粤人重，汉廷公卿俱竦服。\n陈平奇计须深念，张子全身甘辟谷。\n此外候王希识字，带砺功存半诛戮。\n惟君坐使将相欢，燕喜优游刘氏福。\n年少终军学高步，空有英称命难续。\n乃知智者应世间，妙似庖丁奏刀熟。\n往事浮云变灭尽，越水悠悠浸山绿。\n荒祠寂寞傍僧居，日暮饥鸦噪乔木。\n我来三叹重迟留，为酌寒泉荐秋菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归天宁万年禅院","author":"梁鼎","text":"谈空玉殿君恩厚，归兴兰舟泽国赊。\n禅室冷思沧海雪，吟楼晴忆赤城霞。\n经吴屐滑当梅雨，到寺衣香近桂花。\n深愧尘缨未能去，石桥前瀑共尝茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙都山","author":"梁鼎","text":"黄帝升天台，高名壮斗牛。\n孤根斜照水，寒色不知秋。\n藐与群峰并，圆如一笋抽。\n晓妨残月下，晴碍落星流。\n危定胜昆阆，登应见沃洲。\n爱深无尽处，目极更迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀","author":"梁意娘","text":"踪迹浮萍落五湖，一番相别一番疏。\n不知此去从何处，还许春风得见无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶瓶儿","author":"梁意娘","text":"满地落花铺绣。\n春色著人如酒。\n晓莺窗外啼杨柳。\n愁不奈、两眉频皱。\n关山杳。\n音尘悄。\n那堪是、昔年时候。\n盟言辜负知多少。\n对好景、顿成消瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦楼月/忆秦娥","author":"梁意娘","text":"春宵短。\n香闺寂寞愁无限。\n愁无限。\n一声窗外，晓莺新啭。\n起来无语成娇懒。\n柔肠易断人难见。\n人难见。\n这些心绪，如何消遣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题灵洞天福院","author":"梁頠","text":"门外落将三市隔，此中人是几生修。\n千寻古木含云翠，一派寒泉绕槛流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厌气台","author":"梁颢","text":"天生王气何能厌，嬴氏空劳筑此台。\n今日我来台上看，残春寂寞野花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食值雨","author":"梁颢","text":"春波微绿草连门，寒食烟光可断魂。\n细雨隔帘烟火灭，落花风动欲黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食寓怀","author":"梁颢","text":"明日一百五，春风馀几何。\n愁随新火出，病忆故人多。\n草色墙阴合，花香宿雨和。\n耿怀殊不寐，终夕扣壶歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠淳于公归养","author":"梁颢","text":"恳辞浮宦振家声，悬忆高堂指去程。\n选籍便通闺籍美，綵衣兼映锦衣荣。\n推恩半俸供甘旨，守道全家试满盈。\n我恨无亲可归养，与君言别若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕有感","author":"梅尧臣","text":"去年此夕肝肠绝，岁月凄凉百事非。\n一逝九泉无处问，又看牛女渡河归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十一夜闻韩玉汝宿城北马铺","author":"梅尧臣","text":"暗树秋风摆叶鸣，桃枝竹簟冷逾清。\n孤灯淡淡短亭客，半夜萧萧闻雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月雨后有蚊蚋","author":"梅尧臣","text":"春夜一二蚊蚋飞，久不见之尚可喜。\n而今稍喧来聒人，向后更暖奈尔觜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月二十二日回过三沟","author":"梅尧臣","text":"不见沙上双飞鸟，莫取波中比目鱼。\n重过三沟特惆怅，西风满眼是秋蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月三日相公花下小饮赋四题 其二 九月二十八日牡丹","author":"梅尧臣","text":"香包已向青春发，又见秋深特地开。\n应笑菊残无意思，不能邀赋洛阳才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]