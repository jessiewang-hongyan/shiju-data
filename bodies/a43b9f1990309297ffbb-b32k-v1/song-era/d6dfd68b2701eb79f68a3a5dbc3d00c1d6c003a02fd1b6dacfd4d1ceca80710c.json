[{"title":"未试即事杂书 其三","author":"柳子文","text":"万户争看榜，三年此一开。\n异时千载遇，此日四方来。\n价重连城璧，珍逾羽化杯。\n山梁欣有获，置网岂须媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈同院后至诸公","author":"柳子文","text":"秋日同文馆，中官押入回。\n西风初雨后，明月为人来。\n藻鉴凭君许，赓歌愧我陪。\n相逢已忘寝，坐见斗移魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初入试院","author":"柳子文","text":"跫然虽复喜斯行，开豁拘怀赖俊英。\n上国擢材初改辙，众心督战亦乘城。\n何时奏籍瞻霜简，且复安眠听雨声。\n异日尚容休沐会，未惭相约太癯生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试院即事呈诸公","author":"柳子文","text":"高谈初喜听悬河，未厌邻房日夕过。\n蝴蝶乍回尘外梦，蜘蛛看结雨中罗。\n银袍较艺观勍敌，玉帐收功听凯歌。\n共是当年廷试客，锁闱今日合如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再呈慎思诸公兼以言怀","author":"柳子文","text":"侵寻节物过秋风，何处钧天燕鼓钟。\n九日菊花聊一醉，五湖佳士偶相逢。\n挑灯款语时供笑，借纸联诗且漫从。\n待得出闱应放意，百杯追逐兴方浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵呈文潜学士同年","author":"柳子文","text":"才堪斗量君独釜，年少登瀛脱尘土。\n重闱几日锁清秋，酬唱新篇乱如雨。\n读书相逢十载前，君家酥酪和腐乳。\n分题吟思入风云，得意还忘呕心苦。\n晚将衰飒奉英游，漫记雪窗邀夜语。\n平生意气杯酒间，我醉狂歌君起舞。\n即今头白老青衫，但期教子应门户。\n燕颔从君骨相殊，看君鼎食罗五俎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵呈慎思学士","author":"柳子文","text":"咸韶濩武来何方，铿锵入耳安能忘。\n阳春兰芷秋菊芳，金门词客青袍郎。\n昭回下烛光焰长，深山大泽龙蛇苍。\n浩歌激烈元非狂，正逢圣主开明堂。\n风烟关塞收旗枪，舞干两阶臣戎羌。\n喋血拓境谋非臧，边城夜行休赍粮。\n采诗不复嘲青冈，蛜蝛戢羽戍妇床。\n移文北斗猿鹤傍，渥洼朱龙两服骧。\n胥靡版筑罢浚隍，白环楛矢贡篚装。\n航海万里风帆扬，边圉胆落嗟唇亡。\n诸蕃入学愿可偿，槐花举子促书囊。\n成均贡士贤登乡，东门宣诏礼十行。\n我惭驽骀追骕骦，何敢望回不及商。\n毛遂未至空连房，赖有墨妙江都王。\n传模共分此日光，骅骝绿骠两耳黄。\n想见蹙踏披天香，坐觉暑退秋堂凉。\n拘挛龌龊漫引觞，门外乌兔双飞翔。\n悠悠逝川东去央，故山鱼鸟空相望。\n邓侯意气摩秋霜，朝吟百篇暮千章。\n骈罗经史贯列庄，落纸但见书吏忙。\n孔鸾羽仪各效祥，鄙夫不学空面墙。\n先馈不用惊五浆，乌号要须贲育张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藜厅","author":"余授","text":"神僧曾西征，目览江山异。\n深林植杖藜，他日成州治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"余授","text":"绝塞邛崃外，偏城越巂东。\n山含初夏雪，林偃夕阳风。\n地僻无参谒，民淳少讼争。\n睡馀兵放教，衙退吏归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱乔年尉公举男往贺 其一","author":"郑安道","text":"今宵汤饼会，满座桂香来。\n圆月飞金镜，流霞泛玉杯。\n渥洼元异种，丹穴岂凡胎。\n载路声闻彻，祥光烛上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱乔年尉公举男往贺 其二","author":"郑安道","text":"瑞气霭南山，弧悬别墅间。\n此时誇降岳，他日见探环。\n席敞篱花艳，樽浮竹叶斑。\n老夫歌既醉，拄杖月中还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏山草堂四咏 其一 鹭洲钓月","author":"周述","text":"维扬乔木翰林家，底事投閒钓鹭沙。\n真隐每嫌劳物色，烟波深处足生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏山草堂四咏 其二 天马樵云","author":"周述","text":"封事何如乐采薪，崚嶒石磴步堪驯。\n深林不识日昏晓，一任山隈卧白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏山草堂四咏 其三 吴皋东作","author":"周述","text":"天设名区拥翠屏，草堂风度晓鸡声。\n年来不作繁华梦，饭犊郊原学耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏山草堂四咏 其四 月岩夜读","author":"周述","text":"归来筑室月山傍，星斗长悬午夜光。\n清白流芳无别业，诗书堆满竹方床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"俞伟","text":"笠泽渔帆翠叶轻，洞庭山色青螺小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求落籍","author":"周韶","text":"陇上巢空岁月惊，忍看回首自梳翎。\n开笼若放雪衣女，长念观音般若经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周韶落籍","author":"胡楚","text":"淡妆轻素鹤翎红，移入朱阑便不同。\n应笑西园桃与李，强匀颜色待东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"献张郎中","author":"龙靓","text":"天与群芳十样葩，独分颜色不堪誇。\n牡丹芍药人题遍，自分身如鼓子花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周韶落籍","author":"龙靓","text":"桃花流水本无尘，一落人间几度春。\n解佩暂酬交甫意，濯缨还作武陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴作偈","author":"祖庵主","text":"小锅煮菜上蒸饭，菜熟饭香人正饥。\n一补饥疮了无事，明朝依样画猫儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诵华严经","author":"觉禅师","text":"佛具无有生，而能示出生。\n法性如虚空，诸佛于中住。\n无住亦无知，处处皆见佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈圆悟","author":"释祖觉","text":"家住孤峰顶，长年半掩门。\n自嗟身已老，活计付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄圆悟","author":"释祖觉","text":"出林依旧入蓬蒿，天网恢恢不可逃。\n谁信业缘无避处，归来不怕语声高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟山","author":"王雱","text":"当年睥睨此山阿，欲著红楼贮绮罗。\n今日重来无一事，却骑羸马下坡陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"度关山","author":"王雱","text":"万马度关山，关山三尺雪。\n马尽雪亦乾，沙飞石更裂。\n归来三五骑，旌旗映雪灭。\n不见去时人，空流碛中血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春怀","author":"王雱","text":"朝日上屋角，百鸟鸣不休。\n岂复辨名字，但闻闹钩辀。\n乱我读书语，惊我梦寐游。\n弯弓弹使去，暂去还啾啾。\n弹十不得一，穷时来愈稠。\n投弓坐榻上，咄咄空自尤。\n时节使汝鸣，我何为汝雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翠云山","author":"王雱","text":"寺古无邻家，千山抱虚碧。\n门开猿鸟路，殿锁烟霞积。\n老木森回溪，飞湍自淙激。\n曾无车马到，绝境閒今昔。\n逍遥贤大夫，肯此携佳客。\n鸣驺清晓来，归时日常昃。\n不使讼庭空，谁能傲泉石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"王雱","text":"杜家园上好花时，尚有梅花三两枝。\n日暮欲归岩下宿，为贪香雪故来迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王雱","text":"君心莫厌频欢乐，请看云间日西入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其一","author":"释从悦","text":"耳目一何清，端居幽谷里。\n秋风入古松，秋月生寒水。\n衲僧于此更求真，两个猢狲垂四尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其二","author":"释从悦","text":"常居物外度清时，牛上横将竹笛吹。\n一曲自幽山自绿，此情不与白云知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其三","author":"释从悦","text":"无法亦无心，无心复何舍。\n要真尽属真，要假全归假。\n平地上行船，虚空里走马。\n九年面壁人，有口还如哑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其四","author":"释从悦","text":"夜夜抱佛眠，朝朝还共起。\n起坐镇相随，语默同居止。\n欲识佛去处，祇这语声是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞众偈","author":"释从悦","text":"四十有八，圣凡尽杀。\n不是英雄，龙安路滑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢雁门令后作","author":"黄炎","text":"献议条陈十五事，输钱岁减二千缗。\n备员出宰当求瘼，忤旨监司竟累身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠灵岩元长老","author":"梁彦深","text":"高僧升座息尘埃，万虑都忘智眼开。\n今日□□□□□，□知宿世有缘来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巾山广轩","author":"何执中","text":"曲槛小栏干，登临咫尺间。\n望随流水远，高共白云闲。\n亭柏僧归路，江枫客渡湾。\n觉来生羽翼，疑是梦中还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"何执中","text":"香山寂寂听因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北斗岐山","author":"陈次升","text":"土精成石石成星，屈曲安排天北形。\n自是山游玩物者，依稀信步踏苍冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"吴安持","text":"岭表骚然避贼锋，番禺当此每从容。\n故知封豕非无意，自是金城不可攻。\n海峤百年忻受赐，承明三接正酬庸。\n山阴岂足劳公久，能活千人尚有封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸太学倡和","author":"吴安持","text":"翰林墨客奏封章，天子欣然幸国庠。\n綵仗六龙初拥路，青衿三舍已重行。\n隆儒共庆贤尧舜，访道谁知应帝王。\n附凤骞渊皆法从，独惭由也亦升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题赠灵岩鉴公禅师","author":"张会宗","text":"人中令德居高地，天下精蓝占好山。\n四绝名标清世上，十方僧聚白云间。\n二龙珠照看经静，双鹤泉供洗钵閒。\n早晚利荣缰锁脱，性通三教叩禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题通云亭","author":"王孝先","text":"小亭高古占城闉，地迥全无一点尘。\n时有行云自来去，晚来施雨欲留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠佛印禅师","author":"韩宗古","text":"云居古道场，缥缈若化土。\n西有卧龙洞，传闻结庵住。\n晓日射寒岩，翠光入窗户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"韩宗古","text":"东渡吴江景气清，拂云楼阁会稽城。\n乍辞青琐双旌拥，重驾朱轓驷马迎。\n应笑买臣夸郡邸，还同严助厌承明。\n茂林脩竹山阴地，何日陪公载酒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孔司封题蓬莱阁","author":"孙昌龄","text":"突兀轩楹气象豪，使君携客共游遨。\n坐来面揖湖山胜，行处深腾日月高。\n隐约壶中露蓬岛，分明海上涌金鳌。\n宜酬绝景频吟醉，况是东南暂拥旄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"孙昌龄","text":"白狼去后桑田出，仙女升来洞府闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张佑","text":"蟹黄盐满箸，熊白软加笾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观二年戊子三月二十九日请假祀坟和族人升之韵","author":"阳孝本","text":"连日阴云拂晓开，欢声九族一时来。\n江山奇秀浑如画，鼓乐喧阗却似雷。\n三爵香醪浇故垄，满天春色绝纤埃。\n自从菲德叨荣甚，八行初从帝里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步韵奉酬林郡守二首 其一","author":"阳孝本","text":"六槐何日起商岩，未许蟠龙卧碧潭。\n天下苍生还有待，郡中善政却无惭。\n锦囊珠玉成咳唾，绮席风云出笑谈。\n千载通天蒙品藻，恐教虚誉满江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步韵奉酬林郡守二首 其二","author":"阳孝本","text":"家世中条旧素贫，尘编堆积漫缤纷。\n未甘末俗成虚老，却笑劳生漫逐群。\n为爱严陵滩上月，还思巢父岭头云。\n闾阎莫怪衡门陋，旌节曾来有使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尘土黄","author":"刘次庄","text":"翠眉连娟舞袖长，春风自对理容妆。\n染丝绣作双鸳鸯，欲飞不飞在罗裳。\n耳中明月珠，肘后锦香囊。\n凭高欲有寄，所寄在远方。\n追风还君立路傍，岂不有地能相当，请著一鞭尘土黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尘土黄 译","author":"刘次庄","text":"妾本倡家子，笄鬟擅容止。\n名隶倡籍中，生倡即倡死。\n物势本从权，情恩亦遂迁。\n一朝官长怒，独抱锦衾眠。\n日暮倚高楼，青丝系白马。\n岂不谢慇勤，汪汪泪盈把。\n万感自有因，无容遽相亲。\n请君促金勒，妾愿看飞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尘土黄 笺","author":"刘次庄","text":"春台女儿似红玉，曾奉当筵柘枝曲。\n舞成早自得痴名，更傍春风情不足。\n客携黄金欲有赠，多在邻家赌双陆。\n近从新官作颜面，祇得低心随所欲。\n自知久去非所安，夜半东门车特碌。\n秀阙芙蓉潭畔起，每向波间得双鲤。\n水流却上大应难，惟有孤怀似潭水。\n一骑翩翩锦臂鞲，红罗百丈作缠头。\n为言闻得琵琶怨，当门下马欲登楼。\n莫登楼，君马骇。\n无限朱帘薰好香，城北城南无一瞬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江神词","author":"刘次庄","text":"髻插幽兰花，手把菖蒲叶。\n渔郎偷语人，云是江神妾。\n江神昨日鼓云涛，开帆拍天上千艘。\n吴洲女儿弄春水，浪湿船头红绵袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王昭君","author":"刘次庄","text":"敛袂出明光，琵琶道路长。\n初闻胡骑语，未解汉宫妆。\n薄命随尘土，元功属庙堂。\n蛾眉如有用，惭愧羽林郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉眠亭","author":"晁端禀","text":"吏部瓮閒眠，先生窗下卧。\n夜偷绿醑饮，昼喜清风过。\n人为清风快于酒，摆落烦襟洗尘垢。\n吾知醉寝胜闲睡，可以寄天真兮忘世累。\n沟渎超江汉，幕席视天地。\n蝴蝶不知缘变化，黄粱未熟虚营利。\n从来闲处得闲乐，何者功成与名遂。\n陇西夫子称世贤，世家自是酒中仙。\n作亭占得松陵地，东坡名之为醉眠。\n醉复眠兮眠复醉，颐养邹轲浩然气。\n贤人为浊圣人清，昏昏梦寐都忘形。\n花影满身犹未觉，竹风吹面不知醒。\n忆昔乐天贪醉吟，吟哦未免劳其心。\n不如醉睡了无事，其乐陶陶得趣深。\n我身走尘埃，羁鞅殊未息。\n有所思兮在高轩，欲往从之路艰塞。\n无缘一榻同醉眠，空秃千毫挥醉笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪山","author":"晁端禀","text":"琅邪山色连云绿，烟树参差裹岩谷。\n幽香烂熳四时花，翠影交加万竿竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清风亭","author":"晁端禀","text":"物外林泉静，闲中日月长。\n清风飒然至，可以傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翠微亭","author":"晁端禀","text":"晓风吹落秋泉声，夜雨洗出秋山色。\n上有楼台深翠微，可惜丹青图不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无心亭","author":"晁端禀","text":"地与市朝远，云藏山水深。\n长令有心者，到此自无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双井敝庐之东得胜地一区长林巨麓危峰四环泉甘土肥可以结茅庵居是在寅山之颏命曰寅庵喜成四诗远寄鲁直可同魏都士人共和之 其一","author":"黄大临","text":"一溪婉婉如平篆，四野青青似画图。\n阮客放船迷洞府，化人携袂到清都。\n山中安用名丞相，天下于今得广居。\n我即其间构宫室，预愁帝梦有华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双井敝庐之东得胜地一区长林巨麓危峰四环泉甘土肥可以结茅庵居是在寅山之颏命曰寅庵喜成四诗远寄鲁直可同魏都士人共和之 其二","author":"黄大临","text":"山前有路到华胥，下即乾坤极海隅。\n西接洞庭开晓楚，东倾彭蠡浸晴吴。\n四时更代观形化，万物推移见尾闾。\n此世人人少闲暇，每携樽酒自看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双井敝庐之东得胜地一区长林巨麓危峰四环泉甘土肥可以结茅庵居是在寅山之颏命曰寅庵喜成四诗远寄鲁直可同魏都士人共和之 其三","author":"黄大临","text":"手把齐民种莳书，莎衫台笠事耘锄。\n夏栽醉竹馀千个，春粪辰瓜满百区。\n早秫旋舂尝曲药，新粱炊熟自樵苏。\n日西杖屦行山口，招得邻丁作饮徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双井敝庐之东得胜地一区长林巨麓危峰四环泉甘土肥可以结茅庵居是在寅山之颏命曰寅庵喜成四诗远寄鲁直可同魏都士人共和之 其四","author":"黄大临","text":"招得邻丁作饮徒，山家肴蔬盖胥疏。\n就根煨笋连黄箨，和蒂栽瓜带绿须。\n羹熟泽中亲射雁，脍成溪上自罾鱼。\n远怀羊仲荒三径，能似林间今日无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]