[{"title":"陈渭老今夕开阁诚为盛事戏成二小诗以侑坐客 其二","author":"李光","text":"长堤杨柳映门垂，南北行人认酒旗。\n坐上饮流须强醉，休将河水较醇醨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行潘峒诸村爱其岩壑之胜田畴之美因成小诗 其一","author":"李光","text":"烟市云庄自一墟，幽花夹道路萦纡。\n无人与写岩峦胜，聊展营丘半幅图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行潘峒诸村爱其岩壑之胜田畴之美因成小诗 其二","author":"李光","text":"村落家家社酒香，杂花开尽绿阴凉。\n山畦是处田畴美，时有归牛带夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元发惠鸣鸡 其一","author":"李光","text":"尘榻昏昏睡未醒，床头腷膞老鸡声。\n年来学道多晨起，免听城头画角清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元发惠鸣鸡 其二","author":"李光","text":"朱冠玄臆气横秋，得食相呼饱即休。\n语默从来有程度，不妨风雨夜飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客惠予早鸣晚鸣二鸡各赋一绝 其一 早鸣","author":"李光","text":"远和城头角调清，邻鸡寂默尚无声。\n幽人底事偏嫌汝，惊断归乡梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客惠予早鸣晚鸣二鸡各赋一绝 其二 晚鸣","author":"李光","text":"长庚东出月沉西，饱粟贪眠尚稳栖。\n却笑城乌自多事，更筹未急已先啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"反舌","author":"李光","text":"喧喧木杪弄新晴，羁枕惊回梦不成。\n任是舌端能百啭，园林春尽寂无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢文孺寄三接丹岐伯言人各有百二十岁之寿其多夭折者声色害之也如醉后入房等三事皆促寿命之目予来年八十若服此得终其天年道人之遗也","author":"李光","text":"三接灵丹古所传，扶危起死胜神仙。\n衰颜全藉刀圭力，少驻人间四十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予谪海外久矣蒙恩徙郴所寓适与苏仙邻暇日携儿徜徉历览遗集因阅本传不载致仙之因特以事母尽孝行耳自古仙真得道如吴真人之流未有不由此而致者世人不知出此多弃遗父母入深山穷谷中父母冻饿不恤也以此求道去仙远矣因成二小诗题之壁间庶亦少警欲学道而忘其亲者 其一","author":"李光","text":"打包行脚为寻真，偶与苏仙作近邻。\n万里移来今有伴，叩门时许访幽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予谪海外久矣蒙恩徙郴所寓适与苏仙邻暇日携儿徜徉历览遗集因阅本传不载致仙之因特以事母尽孝行耳自古仙真得道如吴真人之流未有不由此而致者世人不知出此多弃遗父母入深山穷谷中父母冻饿不恤也以此求道去仙远矣因成二小诗题之壁间庶亦少警欲学道而忘其亲者 其二","author":"李光","text":"不须辛苦学神仙，九转功成亦偶然。\n但向闺门躬孝行，会须白日上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题义郴传神赞","author":"李光","text":"平生疾恶不量力，指佞击奸期屏迹。\n流落南荒二十年，更无一点烟尘色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昭真宫","author":"李光","text":"造物閟灵境，灵山隐仙躅。\n丹成自飞升，何用驾鸾鹄。\n举手金沙岭，片石聊寄足。\n至今锁烟扉，气象钟清淑。\n井池丹药就，千载湛寒绿。\n我来春雨馀，溢水涨幽谷。\n琤琤落环佩，细细响琴筑。\n黄冠六七辈，一一道机熟。\n余师本缁流，游走遍四渎。\n初明大乘禅，锋辨谁敢触。\n升堂猛虎跪，诸方狐鼠伏。\n晚乃思长生，师许隶宝箓。\n时登玉虚殿，叨迎御舆服。\n俯仰能几时，世事有反覆。\n萧然坐空岩，复理旧松竹。\n却谈京洛梦，感慨气填腹。\n人生梦幻耳，何必苦拘束。\n期师谢冠裳，复见真面目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"裘氏义门","author":"李光","text":"夫何于会稽，卓然有裘氏。\n同居六百年，相聚三千指。\n昔贤钦义方，列奏闻天子。\n恩诏保门闾，光华映闾里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀三峰楼","author":"李光","text":"一川花柳拥雕栏，浓绿浮空四面山。\n便欲移家来住此，不将名姓落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"千岩亭","author":"李光","text":"家用好处寻难遍，日月当门只卧龙。\n欲尽南山岩壑胜，须来亭上少从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题嵊县黄山庵","author":"李光","text":"十载清游得重寻，风门小立契初心。\n上盘直与云天近，下瞰不知岩壑深。\n浥露黄花平衬地，著霜红叶巧依林。\n他年愿结香灯社，竹杖芒鞋数共临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问汉亭","author":"李光","text":"河畔牵牛织女星，东西相望几千程。\n乘槎我欲机边坐，应解停梭问姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"城南池","author":"李光","text":"枯木摧残色境空，西风独占水芙蓉。\n瑶池饮散红妆闹，洛浦人归翠盖重。\n日影透帘香掩苒，月华侵坐客从容。\n闲花琐细能长久，免被移栽太华峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌江","author":"李光","text":"昌江真陋邦，芋魁的盈尺。\n逐客方阨陈，饱食度终日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破山寺","author":"李光","text":"招提清绝冠诸方，溪绕山围胜气藏。\n好在池塘存旧址，依然花木隐禅房。\n风生殿阁元无暑，雨后松篁自有香。\n日暮不教清兴尽，更登绝顶瞰微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胜法寺","author":"李光","text":"舍南舍北竹千竿，镜净无尘碧玉寒。\n中有老人清似水，晚来相对倚栏杆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀香堂","author":"李光","text":"山远江深胜地藏，森森乔木间修篁。\n月林不动参差影，花径常供自在香。\n沉水爇残金鸭冷，落花飞尽绿阴凉。\n神通甚愧维摩老，聊长蛮邦作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东山","author":"李光","text":"才贤国运每相关，出处公遭典午间。\n梦里铅华浑脉脉，萧中芳迹尚班班。\n始高霄汉鸿飞远，终惜云巢凤不还。\n好是南阳扶汉鼎，勋名千古仰东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽李忠定","author":"李光","text":"忠言直节动华夷，肯为投闲更息机。\n南国忽闻梁木折，中原犹望衮衣归。\n平生学术唯心得，晚节功名与愿违。\n老病无因执哀靷，翔风空有泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"李光","text":"此日开轩怀谢傅，直缘谈笑破苻坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"李光","text":"吾衰自不出，孰谓出无友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"李光","text":"吾师坐忘真，卢扁非良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"李光","text":"海薪不论钱，何苦忧无炭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"李光","text":"铜盆湛冰雪，谁谓无寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"李光","text":"昌江古佳郡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕","author":"郑望之","text":"可是今年老也无，儿孙次第饮屠苏。\n一门骨肉知多少，日出高时到老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂","author":"郑望之","text":"熙陵尝赋钓鱼篇，意属磻溪旧所传。\n治世代天今六相，中兴扶日跨群贤。\n已栽桃李满天下，更卜林泉占海边。\n不似东山携妓女，一觞一咏度长年。\n一从奉得去年书，报道江山已定居。\n应料于今台岳畔，还同自昔辋川图。\n君臣终始如公少，将相声名自古无。\n何日雍容陪杖屦，松风山径竹篮舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋汉印","author":"唐悊","text":"关中金印岂秦关，想见风流汉已还。\n大飨似书谯县石，兰亭宁数会稽山。\n空馀此日归囊橐，曾是当年杂佩环。\n万户况将取如斗，此章何足系腰间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题宗室赵大年横卷","author":"唐悊","text":"闻君新得小山川，画手来从郜雍贤。\n不学农夫焉用稼，若为王子岂知田。\n我真垄上躬耕客，亲见人间小隐天。\n始识何年京样熟，菊篱宁似景龙边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题延庆寺 其一","author":"范坦","text":"烟村水寺若江湖，林麓山川入画图。\n壁上薰风为谁制，柄臣曾此耀归途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题延庆寺 其二","author":"范坦","text":"寺阁涵虚跨碧潭，菰蒲枫柳认江南。\n侍臣家世俱游此，雁叙题名在壁龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剑门关","author":"何甫","text":"一门横大道，双剑插长空。\n鼓铸非人力，磨砻任化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广胜寺","author":"曹量","text":"驻车长道莫加鞭，得到幽蓝顿豁然。\n千仞岚高晴聚翠，万年枝花莫生烟。\n满窗夜到天涯月，一枕秋深海眼泉。\n自是寂中有真趣，如何潇洒不忘筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别叶馆伴","author":"韩缴如","text":"泣涕汍澜欲别离，此生无复再来期。\n漫将宝玉陈深意，莫忘思人见物时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽黄忠文公 其一","author":"家诚之","text":"自从朱邸翊元良，圣学磨砻日就将。\n嗜饱岂容登鼎俎，剪桐争肯戏圭璋。\n经筵犹有八图在，御座俄惊一鉴亡。\n恤典隆名虽宠渥，何如大政细平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽黄忠文公 其二","author":"家诚之","text":"棘闱尚记一窗邻，把酒论文情独亲。\n辙迹我犹循井络，履声公已上星辰。\n追思九鼎回天力，莫赎千金报国身。\n老去驱车只剑道，忍看高冢卧麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"冯如愚","text":"地灵人秀谁称首，文属君华武硬弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦中作","author":"王耕","text":"楼上虚怀待月时，写景应难不赋诗。\n一天列宿坐中见，万里青天云外归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云根书院作","author":"谢安时","text":"结屋傍云根，溪山似陆浑。\n钓舟藏荻渚，吟径入花村。\n竹月尽满壁，松风时款门。\n静中元有物，浩气塞乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"李元亮","text":"人闲知昼永，花落见春深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"李元亮","text":"朝雨未休还暮雨，腊寒才过又春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"李元亮","text":"可怜三万六千日，长做东西南北人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草堂寺","author":"孙鳌","text":"双树轮囷五百年，开华结实两争妍。\n我来问道师知否，祖意元无法可传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠故人","author":"綦革","text":"三月杨花满路飞，金人游骑拍鞍归。\n高天二圣犹难保，谁道雄关是可依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祈泽寺 其一","author":"季季","text":"虚窗云暗青灯小，松桧无风春悄悄。\n子规枝上叫梦回，清磬一声山月晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祈泽寺 其二","author":"季季","text":"官南官北添身累，年去年来换鬓青。\n何日归来闲岁月，扫山庐墓过馀龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释妙喜","text":"万仞悬崖忽放身，起来依旧却惺惺。\n饥餐渴饮无馀事，那论昔人非昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释妙喜","text":"通身一穿金锁骨，堪与人天为轨则。\n要识临济小厮儿，便是当年白拈贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和冯济川题枯髅图","author":"释妙喜","text":"只此形骸，即是其人。\n一灵皮袋，皮袋一灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬夜","author":"李若璞","text":"苍苍夜色云云远，叶落风林噪乱鸦。\n香篆暖烟浓结穗，暗窗寒雪密飘花。\n琅琅翠竹幽音碎，耿耿青灯孤影斜。\n忘累俗情添兴雅，晚眠独啜满瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桔槔颂","author":"薛道光","text":"轧轧相从响发时，不从他得豁然知。\n桔槔说尽无生曲，井里泥蛇舞柘枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临终颂","author":"薛道光","text":"铁马奔入海，泥蛇飞上天。\n蓬莱三岛路，元不在西边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其一","author":"薛道光","text":"有物含灵体，无名本自然。\n赤龙藏宇宙，白虎隐丹田。\n北斗南辰下，眉毛助睫边。\n灰心行水火，定息见真铅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其二","author":"薛道光","text":"精气元无本，神灵共一家。\n但能擒五贼，自可结三花。\n甲乙无令失，庚辛不要差。\n一阳归正令，七返转河车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其三","author":"薛道光","text":"此事诚难测，贤愚总不分。\n雀应非凤类，马不入羊群。\n㹀产都三百，乾坤共一斤。\n巡行十二路，赤脚猛将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其四","author":"薛道光","text":"一二三四五，南辰对北辰。\n虎龙含碧玉，金木孕珠珍。\n云散家家月，花开处处春。\n几多云外客，尽是世间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其五","author":"薛道光","text":"受得真仙诀，阴中鍊至阳。\n地雷潜动处，星斗共商量。\n八卦看成母，三才始见昌。\n不愁生死系，但觉地天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其六","author":"薛道光","text":"古仙同一术，妙绝大幽深。\n用意寻庚申，专心事丙壬。\n擒归鸟与兔，捉取水和金。\n辨得东西物，修成不二心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其七","author":"薛道光","text":"窈窕并姿态，娇羞弄软柔。\n无情弦里取，魂魄土中收。\n笄冠联铅汞，灵光射斗牛。\n少阳阴与类，无使老春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其八","author":"薛道光","text":"散诞无拘系，翛然道转高。\n妙中藏黑白，闲里恶尘劳。\n坐卧三峰稳，丹田二气牢。\n定知逃世网，名字列仙曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其九","author":"薛道光","text":"采取须教密，诚心辨丑妍。\n事难寻意脉，容易失寒泉。\n师指青龙汞，配归白虎铅。\n两般都会合，水火鍊经年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其十","author":"薛道光","text":"守一坛中要，机藏十二时。\n数中无走失，火候莫教迟。\n达士方为侣，真仙正合宜。\n几年云水上，怀抱有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其十一","author":"薛道光","text":"人有最灵物，依稀在北辰。\n不知将谓气，识后自然真。\n心净如冰雪，身轻似碧云。\n若无十万岁，作甚世间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其十二","author":"薛道光","text":"廛市通人处，明明与往还。\n悟来惟一物，昧处隔千山。\n神水丹田下，华池水火间。\n一元能造化，返老作童颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其十三","author":"薛道光","text":"巧拙仍藏伏，神精用意包。\n坎离或互用，金木喜相交。\n白雪能同鼎，黄芽共一包。\n乾坤推九六，复姤运初爻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其十四","author":"薛道光","text":"一物分为二，能知二者名。\n鼎炉藏日月，漏滴已三更。\n夫妇同交媾，婴儿始结成。\n脱胎并洗泽，携养镇长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]