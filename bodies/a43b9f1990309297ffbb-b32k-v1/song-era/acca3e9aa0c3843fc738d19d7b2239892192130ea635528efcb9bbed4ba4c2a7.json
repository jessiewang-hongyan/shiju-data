[{"title":"老卿携诗三篇来复答一首","author":"赵蕃","text":"闭门两日病不出，得句谁能就我哦。\n贫家尊酒可怜许，饮君宁得到无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十一","author":"赵蕃","text":"平生食肉吾无相，雨甲烟苗足慰贫。\n几日山行更无此，况堪拈米恶于尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十五","author":"赵蕃","text":"已是酴醾堕玉尘，尚馀芍药殿残春。\n山行寂寞那逢此，喜向僧房见斩新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其四","author":"赵蕃","text":"几日舟行罢作诗，直缘山水剩含辉。\n今朝眼界荒凉甚，却遣毫端为解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其九","author":"赵蕃","text":"积潦当涂三尺强，笋舆那得代浮梁。\n脱靴直厉成孤笑，赤脚踏冰思旧狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十三","author":"赵蕃","text":"参天落落复青青，风过笙竽得细听。\n睡思莫将茶料理，只须卧此片时醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十二","author":"赵蕃","text":"提封俱是太平人，尔辈何缘独苦辛。\n见说穷南有蛮蜑，直疑于此是比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十八","author":"赵蕃","text":"时雨催农不厌多，客行无奈路长何。\n怨咨何与天公事，慷慨聊为劳者歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其六","author":"赵蕃","text":"小立溪头唤野航，雨馀林木倍森凉。\n少焉步到临流寺，鹳鹤飞鸣满夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十九","author":"赵蕃","text":"农事催人未遽央，种秧未了插秧忙。\n田家作苦吾常逸，所愧饥寒趋路旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十四","author":"赵蕃","text":"虬龙夭矫已分形，想象灵根长茯苓。\n安得一椽风雨庇，要思服食制颓龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其二","author":"赵蕃","text":"漠漠平芜远际天，青山若个暗霾烟。\n行人更说桥新断，试遣招呼与借船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其五","author":"赵蕃","text":"快雨悬知亦快晴，解包何惜片时程。\n须臾雨止晴能好，一道云山泼眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其十六","author":"赵蕃","text":"晓雨犹偷客枕安，重烦啼鸟报艰难。\n整车欲去还休歇，云合忘踪山四攒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其一","author":"赵蕃","text":"野市穿残路接溪，败船糜索两相依。\n居人欲渡频回首，客子将行屡揽衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自安仁至豫章途中杂兴十九首 其八","author":"赵蕃","text":"郡邑贪残固合诛，衅端繇尔复何如。\n官军可怖无轻敌，直恐微躯不足锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十二","author":"赵蕃","text":"一春多雨夏当悭，今岁还防似去年。\n玉历检来知小满，又愁阴久碍蚕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十二","author":"赵蕃","text":"滩里惊涛怖杀人，潭中净绿数浮鳞。\n如何咫尺能悬隔，物外区中信莫伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十八","author":"赵蕃","text":"新绿深深嫩更黄，非花非草定何香。\n故山草木皆余爱，最爱抽梢竹过墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其六","author":"赵蕃","text":"夷望山前几钓篷，不惟能雨又能风。\n吾身故作魏王瓠，爱此沿洄敏似鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三","author":"赵蕃","text":"上得矶来势已危，忽然缆断不能支。\n惊心钓渚河边石，值尔应当应手糜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十六","author":"赵蕃","text":"风头日日望西南，雨脚悬知不与参。\n昨夜北风今日冷，又惊数点落毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十四","author":"赵蕃","text":"脱粟粗供朝暮餐，也求鱼菜强充盘。\n鱼今绝市菜无有，欲问居人啖马兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十一","author":"赵蕃","text":"滟滪瞿唐昔未行，狼头鹿角旧闻名。\n辰州瓮子滩头路，夷险不知谁弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十七","author":"赵蕃","text":"一月山行意未厌，晚晴仍对雨纤纤。\n回思浪涌涛翻际，宁有于今安且恬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十八","author":"赵蕃","text":"江涨皆云牵路漫，又云江涨苦无滩。\n割晴耕雨难均得，造物于兹良亦难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十二","author":"赵蕃","text":"明月山前明月池，两崖壁立类磨治。\n浯溪未识应相似，好刻中兴第二碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十五","author":"赵蕃","text":"咫尺青山晓未分，旋开还吐尚纷纷。\n烟云变态有如此，安得斯奇付大文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其八","author":"赵蕃","text":"水势才收一丈馀，晓来雷雨又何如。\n天民天恤应堪恃，我自多忧雪满梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其四十二","author":"赵蕃","text":"牂牁何处莫穷源，万折千矶剧迅奔。\n寸寸上来良亦苦，不知断却几番魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十九","author":"赵蕃","text":"安流倏忽起奔湍，非雨非风势使然。\n尽道川流能险恶，不知世有险于川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二","author":"赵蕃","text":"过了矶头尚有湋，长江万里此为稀。\n怅予何可数乘此，宜尔山禽频劝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其七","author":"赵蕃","text":"晓雨濛濛山欲空，少晴还觉练摇风。\n扁舟十日夫何事，只有看山不负公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十","author":"赵蕃","text":"试手滩头水乱流，铁鎗崖下晚维舟。\n两阶舞羽方閒暇，何事兹名有佩牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十七","author":"赵蕃","text":"患难嗟予已素行，今朝滩里挽仍撑。\n心乎讵敢怀尤怨，命尔何能计死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十七","author":"赵蕃","text":"坐对苍然暮色侵，忽惊萤烛度枝深。\n少年嗜学犹馀志，安得茅檐把卷临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十六","author":"赵蕃","text":"昨日江清可濯缨，今朝潢潦忽能盈。\n发洪想有山崩处，一雨安能作许生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十八","author":"赵蕃","text":"无策资身每自嗤，始谋不善悔何追。\n行乎患难宁今日，何暇更论淹速期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十九","author":"赵蕃","text":"飞流溅沫瀑争砻，电击雷惊江落洪。\n尽日喧喧不能息，诵书妨我课儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其四","author":"赵蕃","text":"钓石疑为借石低，月岩穿石两空梯。\n逃虚尚说闻人喜，况此依然面目迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其九","author":"赵蕃","text":"山鸟初鸣麂度滩，少焉还叫火炎山。\n仆来告我为晴候，穴雨巢风不可删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十三","author":"赵蕃","text":"雨堕初看珠颗圆，风来忽散縠丝牵。\n青山四合江如泻，忆著桐江江上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十","author":"赵蕃","text":"望极千山不见村，忽逢三两仅崖根。\n几年生聚才如此，信是荒寒不足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十","author":"赵蕃","text":"细雨冥冥梅欲黄，故怜时节似江乡。\n有书不读高成束，蒸败蠹侵谁与防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其四十一","author":"赵蕃","text":"大麦虽黄草与长，趁春只用野生桑。\n为生可叹微如是，应坐人稀地力荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其五","author":"赵蕃","text":"草屋竹门江岸旁，三三两两竞携将。\n尔曹应念宦游好，不念西来道阻长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十五","author":"赵蕃","text":"摘得青梅江岸边，儿童竞食也堪怜。\n山青指问红何样，说是石榴花欲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十四","author":"赵蕃","text":"一篙真可百滩空，赣水辰溪大略同。\n我乃涨馀方逆上，终朝歌笑愧篙工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十四","author":"赵蕃","text":"前有天随后老坡，杞粮仍欲寿西河。\n吾今何意更思此，但喜杯羹风味多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十六","author":"赵蕃","text":"不但投林雀闹枝，沙禽水宿亦争涯。\n不然故欲相呼唤，恨我形单影自随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十一","author":"赵蕃","text":"美玉曾闻种得生，精金此地亦陶成。\n不知造物须生此，何似嘉禾令土平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其四十","author":"赵蕃","text":"反照入江雷殷然，直疑飞雨堕谈间。\n不知吹落何方去，突兀犹馀云涌山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其三十一","author":"赵蕃","text":"雨来山色暗成愁，雨后波光翠欲浮。\n山色水光元自好，宦情羁思苦悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其十五","author":"赵蕃","text":"谁道蛮州异故园，夏来草木亦苍然。\n扶疏绕屋平生句，有愧青山啼杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自桃川至辰州绝句四十有二 其二十九","author":"赵蕃","text":"性有耽山且画看，阴晴朝暮若能殚。\n天公似病诗才窄，乞与西来眼界宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自造口放舟至道林院偶题","author":"赵蕃","text":"晓起乘舟江上凉，昼携蕲竹卧僧房。\n隐雷骤作分龙雨，限我潇潇幽梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日雪后简在伯二首 其二","author":"赵蕃","text":"灰里拨阴何，思君欲就哦。\n还忧好时节，来搅或遭呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日雪后简在伯二首 其一","author":"赵蕃","text":"一雪顿能晴，江山万里明。\n故胜茅屋底，空听滴檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至邑有感二首 其二","author":"赵蕃","text":"老稚欢呼南北街，争看前日令君来。\n看花不比玄都观，尽是当时手自栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至邑有感二首 其一","author":"赵蕃","text":"朱弦昔日被歌声，岁月频更感易生。\n唯有锦江桥下水，相逢不改旧时清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中二首 其二","author":"赵蕃","text":"岁月侵人去若奔，雪消归水不留痕。\n诗情本自无多子，深谢江山稍见存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中二首 其一","author":"赵蕃","text":"频岁崎岖道路劳，江山妙处属吾曹。\n欲将一笼盛归去，安得并州快剪刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中雨","author":"赵蕃","text":"秋草犹青可放牛，雨林如豁更鸣鸠。\n荒鸡渺渺三家墅，白鸟悠悠数里洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中独饮","author":"赵蕃","text":"已是支离百不禁，况堪多病苦相侵。\n村沽纵薄可不醉，梅半落时天政阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中晚作二绝 其二","author":"赵蕃","text":"严婺江山天下奇，经行凡作几篇诗。\n何当便毕尚平趣，占断清波垂钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中晚作二绝 其一","author":"赵蕃","text":"天如悭此好江山，故遣风帆送我还。\n日暮白鸥犹未宿，冲烟时复度前湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中清明","author":"赵蕃","text":"三日舟行风打头，春愁那更值羁愁。\n一年谁似清明节，忍向天涯除破休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行遇雪二首 其二","author":"赵蕃","text":"沙嘴萦分直更纡，望中不尽渺愁予。\n晚来一雨便成雪，翠巘修林同一如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行遇雪二首 其一","author":"赵蕃","text":"老树槎牙冻不枯，雪花初集更敷腴。\n悬崖斗峻人踪绝，漠漠荒祠落社乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西轩杂题三首 其三","author":"赵蕃","text":"卧看修筠不见梢，所欣轩户绿阴交。\n蝉吟鸟语尽堪喜，不用先生自解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西轩杂题三首 其二","author":"赵蕃","text":"早风蓬勃不能凉，独卧幽轩日日长。\n赖有图书慰岑寂，左抽右取略无妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西轩杂题三首 其一","author":"赵蕃","text":"晓起看山谓得真，突然山外见嶙峋。\n须臾释屩浑无迹，绝倒山灵解戏人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖雪后","author":"赵蕃","text":"行到湖边却笋舆，眼中浑似画屏纡。\n梅花又作临风笑，亦有高人似旧无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3