[{"title":"自讼 其三","author":"宋祁","text":"坐毡无客冻鸱愁，谈树萧然两见秋。\n执戟不知身寂寞，写书犹得罪风流。\n官閒无日惭轩鹤，机尽多年谢海鸥。\n借问殿科能免否，杜陵男子有耕畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自咏 其一","author":"宋祁","text":"四十为郎信倦游，虚名缰锁太悠悠。\n危心正似葵倾日，衰质先于柳望秋。\n要路风尘疲骥足，故潭烟雨废槎头。\n颍滩渐报耕畴熟，终乞閒身守一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中三首 其三","author":"宋祁","text":"雾迥絙林趾，波生齧岸沙。\n漫红披杏带，短碧上蒲芽。\n鲑菜随宜有，浆醪不用赊。\n行行乐萧散，未觉远京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中三首 其二","author":"宋祁","text":"漠漠朝烟上，霏霏野气和。\n惊鸿自去渚，戏鹜不沈波。\n田畯耕扶耒，溪童食啄蠡。\n绀舟时一眺，䍧践损春莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中三首 其一","author":"宋祁","text":"舟行不碍动，纵目望联堤。\n稍觉前川近，徐惊后树低。\n鱼游随聚沫，禽度带残啼。\n自趣家田路，春清况日携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春野外","author":"宋祁","text":"绿野阳膏动，春旗出晓衢。\n川长罗后乘，林转隐前驱。\n早蕊红粘杏，轻苞紫缀榆。\n桑郊不敢问，直为使君愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行药","author":"宋祁","text":"行药遍城闉，仍逢摇落辰。\n坞风焦粟罅，园露饱梨津。\n远水多成浦，高云自作鳞。\n匕丹无复得，魂断小山人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行药","author":"宋祁","text":"行药来溪上，园秋损物华。\n漫丛繁野菊，荒蔓系寒瓜。\n野旷难藏树，山明即变霞。\n病身慵事事，楼鼓谩催衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园","author":"宋祁","text":"日涉中园路，昌昌春意深。\n鸟新无罢啭，云暖不常阴。\n秀色平连野，芳姿细著林。\n欢言挈斋酒，值兴即徐斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园三月十一日","author":"宋祁","text":"春园来继日，叠叶暗东西。\n荫树都成幄，寻花旋作蹊。\n沼鱼衔尾戏，林鸟合声啼。\n宁暇并州问，山公醉自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园早春二首 其二","author":"宋祁","text":"樽酒不常满，年华祗自春。\n言归虽薄浣，业已负良辰。\n野翠欣欣遍，林红扑扑新。\n其如好风景，料理爱诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园早春二首 其一","author":"宋祁","text":"芳意稍菲菲，春城浓淡晖。\n霞留早阴住，风遣薄寒归。\n细溜兼沙漾，初禽隐叶飞。\n要知刀笔暇，文酒得相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园晚秋见寄","author":"宋祁","text":"中园秋物晓，清玩日无穷。\n暝筱深留翠，寒花浅作红。\n鹤鸣残滴露，蜩咽已凉风。\n谁伴调丝管，心知忆戴崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园晚眺","author":"宋祁","text":"弱柳蒙蒙密，新花衮衮繁。\n贪寻芳茜远，遂到落霞昏。\n亭橑衔山霭，池波撼月痕。\n惜春还语客，慎勿诉馀樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西征道中寄友人","author":"宋祁","text":"赋就江毫一黯然，柳衰犹足代征鞭。\n鲛盘恨极无馀涕，鹍瑟悲多有剩弦。\n斜日楚枫低候雁，早霜秦树送残蝉。\n文章满腹真何益，深愧囊中赵壹钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西斋冬夕","author":"宋祁","text":"西海共摇落，居然彫岁深。\n林疏纵风怒，天惨趣云阴。\n冰沼留寒鹜，灯檐射宿禽。\n怀人感衰鬓，自此不胜簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西斋秋晚","author":"宋祁","text":"霜华零暮节，日气淡长穹。\n池减无留潦，林寒少罢风。\n虫鸣星杼促，蝉起露緌空。\n隐几无纷虑，窥园嗜晚菘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西楼夕望","author":"宋祁","text":"炎氛随日入，岑寂坐遥帷。\n倦鹜昏投浦，惊蝉夜去枝。\n桂华兼月破，槎影带星移。\n珍重窗风好，羲人即此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观上朝","author":"宋祁","text":"郁葱佳气护天台，衔尾茸题隘路槐。\n金箭忽鸣衡漏尽，火城争扑相车来。\n黄人日映仙盘上，阊阖天随禁钥开。\n规地凝深谁得见，渚鸾雍鹭自趋陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观相国长城公留题药师院壁","author":"宋祁","text":"拥节趋瑶县，回舆礼梵仙。\n望云催觐日，零雨记归年。\n蕙露霏毫润，尼珠入局圆。\n斯人具瞻地，二绝贲金田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观烧","author":"宋祁","text":"白草开平野，炎晖照暮云。\n商原宁易向，昆玉怯同焚。\n田烛宵俱远，边烽晓不分。\n方阳休自任，阮瑀久从军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访隐者不遇","author":"宋祁","text":"青萝白石扉，霞薄动春晖。\n鹤去书空在，凫閒舄自飞。\n骖鸾仙驭远，出岫昔心违。\n拂衽雄风动，犹疑禦寇归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访僧舍","author":"宋祁","text":"近郭一牛鸣，金园界宝绳。\n众花天作雨，千焰佛传灯。\n碧柰垂园老，青莲杂漏凝。\n病襟多俗物，时此访南能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过安陆旧居邻里相送","author":"宋祁","text":"绿杨枝外斗阑干，出客鸡鸣过近关。\n岂有车徒休汝上，暂同邻里到方山。\n离魂正对春波苦，羁思犹随倦鸟还。\n多谢沧浪送征棹，更沾馀沫洗衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过朱亥墓","author":"宋祁","text":"屠门遗旧隐，锤袖凛馀风。\n兵下邯郸壁，躯捐嚄唶公。\n种祠群望亚，樵禁九原中。\n异世同樗墓，东西夹汉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洛阳有作","author":"宋祁","text":"郁葱喜气抱天回，飞柱门深拂晓开。\n树绿远随驰道出，尘清曾傍属车来。\n雾中温洛浮仙牒，云表神崧荐寿杯。\n何日东都参第赋，班生犹是令兰台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过郢中","author":"宋祁","text":"紫宙星翻唾雾开，据鞍追昔剩裴回。\n空闻曲里阳春老，不见城西艇子来。\n苦李成蹊谁驻盖，行云无所自萦台。\n江皋鱼鸟留连极，枉被从军驿马催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过惠崇旧居 其一","author":"宋祁","text":"人往名长在，钦风历故居。\n社残莲即老，园废柰仍疏。\n麈忆清谈外，云经合座馀。\n裴回视斋壁，行草暗残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过惠崇旧居 其二","author":"宋祁","text":"虽昧平生契，怀贤要可伤。\n生涯与薪尽，法意共灯长。\n遗画空观貌，残诗孰补亡。\n神期通一语，无乃困津梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐云亭凭高有感","author":"宋祁","text":"凭高极目意茫然，坐对淮南摇落天。\n空把归心同客雁，遂将缄口伴寒蝉。\n一樽醒醉黄花外，万事萧条白发前。\n谁取长弓射鸟翼，休教西日送凋年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐云亭晚瞩","author":"宋祁","text":"山暝日云稷，天清风寖和。\n树花红暗淡，城草绿坡陀。\n归艇冲烟去，昏凫接翅过。\n年华无限乐，判作是狂歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯逢欲予买一田墅因成自讼","author":"宋祁","text":"予从大夫后，禄乃二千馀。\n簪笔论何事，藏山著底书。\n病教年事早，拙使宦情疏。\n合治菟裘未，蜗牛尚有庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兵部学士移镇昭潭","author":"宋祁","text":"樯拂南云舣帛兰，再麾湖外叹违颜。\n封君比籍千头橘，瑞祝标祠九向山。\n迎吏出郊驱驽箙，齐兵下席掩刀环。\n汉条缓布褒书降，后乘蒸青几两还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入蜀州阁道作","author":"宋祁","text":"缘云栈脚转嵯峨，使者重来叱驭过。\n杜宇有冤啼夜月，女萝凭鬼护山阿。\n岩深树气埋苍雾，峡窄江形束素波。\n自问一春行役苦，带环移眼奈衰何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初侍讲筵有感上呈经筵诸公","author":"宋祁","text":"迩英何幸奉经筵，俗状婆娑艾服年。\n兰叶初窥图上字，奎钩乍识禁中天。\n坐凭重席惭清问，能读三坟赖众贤。\n犹藉向来稽古力，不然须合早归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到郡斋三首 其三","author":"宋祁","text":"温省绸缪罢，乡州偃息时。\n鹤情归不怨，凤德老无衰。\n月树供园莳，仙囊续宴卮。\n自惭淮守薄，千里与言诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到郡斋三首 其二","author":"宋祁","text":"我里诚云乐，公今况释劳。\n秋莼不下豉，霜蟹恣持螯。\n林静来晨燎，江喧入夜涛。\n功成奋嘉藻，宁欲傍离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到郡斋三首 其一","author":"宋祁","text":"暂解枢机任，来从海上閒。\n浮云富贵外，一马是非间。\n月衮生潮浦，风香堕桂山。\n苍生虽系望，要作冶城还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初宿东阁追忆文简丁公作","author":"宋祁","text":"辞阁玉堂东，依然昔所从。\n旧池空叹凤，残友不成龙。\n制藁流尘积，砖花驳藓重。\n过车三步约，何日酹茔松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"宋祁","text":"中伏翻无暑，斜阳未即曛。\n暂光风处叶，馀墨雨残云。\n圃埒繁蔬甲，堂坳叠藓文。\n巾㡚殊上喜，文酒半离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴感勾归安簿","author":"宋祁","text":"苑花联醉七经春，犹佩当年一綵纶。\n京邑风尘初倦客，楚伧涂辙欲妨人。\n信潮暮送吴艎稳，公秫秋供箬酎醇。\n江外何因凭尺素，宕渠波恶损文鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈胡希元进士二首 其二","author":"宋祁","text":"茕茕官绶解，落落饮瓢空。\n君惠容藏疾，交情助讳穷。\n倦谈嗟墨客，掉首觏鸿蒙。\n已卜良邻计，无忧吾道东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈胡希元进士二首 其一","author":"宋祁","text":"离邦嗟病免，道旧乐朋簪。\n刻画忘齐丑，膏肓倚郑箴。\n轩鸿溯霄路，和鹤答溪阴。\n为薙求羊径，时容一往寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿上人南游","author":"宋祁","text":"拂晓镮鸣月，迎寒毳拥霞。\n众香摩诘饭，五叶祖师花。\n托宿林枝俯，分风夕影斜。\n前期逢晤赏，持对碧云誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿州十咏 其五 秋香亭","author":"宋祁","text":"兰菊被秋坂，危宇冠层巅。\n杂树自隐日，脩条争刺天。\n石斜苔附秀，樛穷蔓倒悬。\n撷英欲谁遗，伫立徒娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿州十咏 其七 齐云亭","author":"宋祁","text":"肇允缔层宇，岧岧少城隈。\n凭轩肄师孑，中坐合宾罍。\n白日披霞上，苍山障雾回。\n眷言西北道，吾师安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张屯田知兖州","author":"宋祁","text":"汉家关内使驺来，广鲁风旟画隼开。\n地得股肱雄近辅，书留筋骨冠中台。\n儒宫刬壁严祠豆，督府均羊盛宴罍。\n应望仙闾旧车道，倚天娲石篆昭回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张生南归","author":"宋祁","text":"谒舍修容倦刺毛，纷纷朱紫笑银袍。\n吴天破月愁归晚，楚俗伤春忌唱高。\n江步挐舟双打桨，酒亭横帜一持螯。\n平台邹马英游盛，霏霰连天待赋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张亚子庙","author":"宋祁","text":"伟哉真丈夫，庙食此山隅。\n生作百夫特，死为南面孤。\n鹿庖偿故约，雷杼验幽符。\n潼水无时腐，英名相与俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张伯起自蜀还台帘对既讫以有司奉祠蜡方既即斋复引入升太常为博士","author":"宋祁","text":"殿墄涂丹九齿长，珠帘伏奏近天香。\n已传乐职来西蜀，更就清斋得太常。\n夕燎烘庭思结佩，晓兰薰俗滞华阳。\n心倾五日归来路，共举鲑珍釂贺觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张转运席上","author":"宋祁","text":"偃藩多式宴，佳雪屡飘霙。\n意感年将尽，欢容酒剩行。\n伊公调鼎乐，羊祜衣裘轻。\n况属輶轩暇，须容心赏并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张宫苑拜嘉州刺史知恩州","author":"宋祁","text":"二年同守梦刀城，遥节初为北道行。\n飞将负才曾捕虏，伏波见上数论兵。\n剑南剩腊梅迎使，塞下新春柳映营。\n贵宠逼身头未白，七貂终嗣汉西京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀故里偶成","author":"宋祁","text":"先畴少失杏花耕，十载穷尘困缚缨。\n山上有山成久客，吏中非吏得空名。\n吟塘碧草他年废，雾驿哀猿此夜惊。\n何日谒归聊望里，况无车骑得乡评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀滕秘校书","author":"宋祁","text":"解职青袍困，惊年素发多。\n囊中彭泽米，门外下邽罗。\n露鹤惊霄岛，风蜩喝暝柯。\n此时潘簟冷，争奈近秋何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"把酒","author":"宋祁","text":"歌管嘈嘈月露前，且将身世付酡然。\n谩誇鼷鼠机头箭，不识醯鸡瓮外天。\n青史有人讥巧宦，黄金无术治流年。\n君看醉趣兼醒趣，始觉灵均更可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抒叹","author":"宋祁","text":"寒日不我驻，岁阴生事微。\n孤怀百感萃，双鬓二毛稀。\n樵突沉残桂，尘编拥故帏。\n况无安邑累，身托故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抒怀上南京常山公","author":"宋祁","text":"缁帷怅别倏经年，荣路心危重惘然。\n宁死道边终自直，狂歌河上欲谁怜。\n魂随夜蝶星垂地，信断秋鳞水接天。\n早晚承明庆三入，愿持云汉续遗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抒怀恭答待制施正臣","author":"宋祁","text":"谁谓斯人玷玉堂，忧怀易得复难忘。\n素书不答还堆案，长簟无情但竟床。\n涸思论文成轧轧，流年著鬓有苍苍。\n病襟殊忘支离丑，为恃君家白雪章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟明月逐人来","author":"宋祁","text":"玉漏催成夜，兰釭换作晨。\n并花排綵树，分月送游人。\n醉幕星临酒，天街露禁尘。\n轻雷与流水，随意伴香轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李九言寺丞知怀安军金堂县","author":"宋祁","text":"云栈马萧萧，铜章庇邑遥。\n晨晖碧鸡路，春色锦官桥。\n美政方宣布，斯人旧富饶。\n早须飞两舄，归趁汉家朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李中令挽词二首 其二","author":"宋祁","text":"赠窆充幽隧，鸣箫异素轮。\n山丘华屋远，桃李故蹊春。\n使幕被愁雾，谈犀委暗尘。\n须知悟生灭，终得法为身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李中令挽词二首 其一","author":"宋祁","text":"家赐齐侯履，人推郤縠文。\n结婚荣外馆，谋帅得中军。\n盛集追园盖，遒章托陇云。\n不图新渚畔，更作死生分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李处士","author":"宋祁","text":"江天退卧久沈冥，秋入颠毛翠葆惊。\n原宪桑枢贫不病，子真岩石老归耕。\n樵风挂席晨昏至，屐齿登山上下平。\n鄅稻已收霜橘熟，深心宁逐彻侯荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李国博斋中小山作","author":"宋祁","text":"观阁幽期胜，窗扉列岫连。\n千岩状稽岭，一石记平泉。\n迥□仙湖境，低围醉幕天。\n休论真假意，同是到忘筌。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李秘校省觐毕却赴乘氏","author":"宋祁","text":"谢遏香囊奕思馀，短亭暾景驾骊驹。\n客盘饮嗜丰千蹠，仙舄归飞伴两凫。\n官柳摇摇萦早絮，县花的的照晴跗。\n东阳玉骨春偏瘦，省对霞朝忆上都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜少卿知陆州","author":"宋祁","text":"三年去国别尧云，一箧书空此谤分。\n贾谊有才偏陨涕，屈原何赋不思君。\n谏囊久晦沈馀草，绶笥重开续旧薰。\n几日班春向桑野，汉家新诏十行文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨太尉后园假山","author":"宋祁","text":"韬戟严中府，磓星写翠岑。\n岚分一轩翠，云护半庭阴。\n谷响迎壶柘，岩光射庑金。\n时平非聚米，缓带恣幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨初归九江","author":"宋祁","text":"方领思归集鹳庭，樵风千里漾舟舲。\n歌翻桃岸双飞鹄，梦绕天鄣九叠屏。\n上苑昔游赋飘雪，故林良友望贤星。\n迟闻乙奏丛云幄，紫桂窅窊袭袂馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]