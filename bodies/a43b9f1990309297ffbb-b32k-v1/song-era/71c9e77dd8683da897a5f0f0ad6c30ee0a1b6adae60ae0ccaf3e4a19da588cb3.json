[{"title":"答曾无疑校勘","author":"刘克庄","text":"诗到黄初字永和，半生西望溯明河。\n已招学士来儒馆，更欠山人拜谏坡。\n四库旧书存有几，五朝遗老苦无多。\n传闻将讲临雍礼，小驻骊驹白玉珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答番昜使君胡直院二首 其二","author":"刘克庄","text":"久别番君国，山川远间之。\n惟应残梦里，壹似旧游时。\n方草淮南诏，难酬渭北诗。\n都忘今契阔，但记昔追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答番昜使君胡直院二首 其一","author":"刘克庄","text":"老欠人书债，惟公幸恕之。\n不逢斲窗处，即值揽衣时。\n胆薄书行诏，才悭倚閤诗。\n自怜双鬓秃，犹忝属车随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答谢法曹","author":"刘克庄","text":"二诗简澹扫秾华，作者几无以复加。\n璧十五城方定价，桃三千岁一开花。\n选骚意度卑唐体，晋宋文章让谢家。\n莫道老夫今耄矣，平章此事不应差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫泽观","author":"刘克庄","text":"修持尽是女黄冠，自小辞家学住山。\n帘影静垂斜日里，磬声徐出落花间。\n祭星绿简亲书字，避客青衣密掩关。\n最爱粉墙堪试笔，苦无才思又空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月十日至外祖尚书家","author":"刘克庄","text":"古树暗朱门，空阶篆藓痕。\n昔容万间屋，今止数家村。\n泉少池因废，田荒廪尚存。\n遗书零落尽，身愧史迁孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舜庙","author":"刘克庄","text":"粤俗安知帝，遗祠亦至今。\n青山人寂寂，朱户柏森森。\n雨打荒碑缺，苔封古洞深。\n曾闻张侍讲，来此想韶音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葺居一首","author":"刘克庄","text":"兵火间关鬓欲丝，归来聊卜草堂基。\n架留手泽书堪看，爨有躬耕米可炊。\n畏湿先开通水窦，贪明稍斫近檐枝。\n旋移梅树临窗下，准备花时要索诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒋迈说易","author":"刘克庄","text":"新图别义初拈出，四座皆惊昔未闻。\n定是胸中通象数，或于梦里见羲文。\n向来夫子编三绝，近世名儒说七分。\n自笑腐生尊古注，可能挟册便从君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢王尚贤见访","author":"刘克庄","text":"畏跌始知筇有力，怯寒常以衲蒙头。\n诗名吾不如公干，清兴君何减子猷。\n林下方将分半席，江边作么返扁舟。\n骚坛尚有阳岩在，岂必担簦更远求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢景行方寺丞惠衣二首 其二","author":"刘克庄","text":"初裁隐服师杨陆，忽赠身章别一般。\n似雪精絺为表襮，比花文锦作中单。\n何妨俗笑浩然耸，不要人怜范叔寒。\n孰若子衣安且吉，绝胜剑履进贤冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢景行方寺丞惠衣二首 其一","author":"刘克庄","text":"赣州牧念予绝洁，见遗上衣并下裳。\n泽畔羊裘未韬晦，雪中鹤氅太清狂。\n笑金谷友望尘缪，经紫阳翁考古详。\n更惠鸡栖车一乘，十分结裹老文昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢韩孔惠见访","author":"刘克庄","text":"千林黄落涧冰坚，应是江湖作雪天。\n偶有客过居士室，绝无人识孝廉船。\n绣衣二使交章荐，黄册诸郎律赋传。\n莫向明时嗟不遇，乃翁穮蓘子逢年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋得牛驼各一首 其二","author":"刘克庄","text":"形模狞怪骇儿童，技与黔驴大略同。\n葱岭驮经曾有力，岐阳载鼓竟无功。\n效牵尚记随班后，健倒安知卧棘中。\n莫信人言君背贵，肉鞍强似锦鞯蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋得老松老鹤各一首 其二","author":"刘克庄","text":"腥腐年来懒啄吞，䙰褷惟有顶丹存。\n长吭偏到清霄唳，病翅犹当霁月翻。\n云杪孤飞因避箭，壳中新鷇各乘轩。\n士衡晚抱无穷恨，谁向华亭酹一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越台","author":"刘克庄","text":"南帝当年此筑台，称雄亦岂偶然哉。\n谩通异国求阳燧，不道偷儿饮漆杯。\n能使越人存旧迹，始知秦吏有奇才。\n祇今黄屋归何处，但见牛羊夕下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋方寔孙长短句","author":"刘克庄","text":"金针玉指巧安排，直把天孙锦剪裁。\n樊素口中都道得，春莺啭处细听来。\n欲歌郢客声难和，才误周郎首已回。\n可惜禁中无应制，等闲老却谪仙才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋青阳尉古赋","author":"刘克庄","text":"青阳少府笔如椽，袖出骚人体物篇。\n往昔上林推蜀客，后来赤壁有坡仙。\n自言避地侨江表，谁诵凌云向上前。\n萤雪一生家万里，汉庭给札定何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋桂侄梅绝句","author":"刘克庄","text":"老鹤收声只自悲，戛然清唳警衰迟。\n不嫌汝伯无漆发，稍喜吾家有白眉。\n二尺檠边能办此，百花头上更饶谁。\n隆乾衣钵须人继，莫负樊川望阿宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道士","author":"刘克庄","text":"丫髻唐衣八尺长，试看风骨已昂藏。\n丹成屡诧飞升去，客至多称吐纳忙。\n近习星文兼卖卜，每寻洞穴不赍粮。\n或云曾与阵抟遇，拟问先生乞睡方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遗编","author":"刘克庄","text":"短发萧萧老日侵，遗编未敢废研寻。\n薰莸理欲迷通义，衮斧忠邪害恕心。\n笃信圣贤常事左，稍知治乱每忧深。\n人生有腹当盛酒，谁遣吾侪著古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感韩曾一首","author":"项安世","text":"道散斯文体尚浮，韩曾力与化工侔。\n山瞻泰岱岩岩耸，河出昆崙混混流。\n长庆从官销不得，熙宁丞相挽难留。\n沧州奏疏潮州表，犹被人拈作话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叠前韵谢元邃","author":"刘克庄","text":"愈叩新新愈不穷，小儒气索敢争雄。\n安知太白心肠异，但见曹公口鼻同。\n顾我牢愁来泽畔，放君独步向江东。\n他时应制金銮殿，定有蛾眉妒入宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嵩溪驿","author":"刘克庄","text":"舟子初辞去，风吹薄酒醒。\n一茎新鬓白，数点晚山青。\n潦倒弹长铗，荒凉宿短亭。\n邻鸡空喔喔，不似昔年听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"意一元枢称张君平星术相法小诗将行","author":"刘克庄","text":"虽别号君平，谁知异姓名。\n严惟下帘坐，张乃挈家行。\n烽火连畿辅，冰霜滞客程。\n吾穷有诗耳，资汝谒公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感昔","author":"刘克庄","text":"曾见弘文馆盛开，难将汗脚涴金台。\n搜山不见之推出，入海难呼太白来。\n士各自媒谁待聘，世皆欲杀少怜才。\n空存先帝昭回笔，永閟巾箱不忍开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感昔二首 其二","author":"刘克庄","text":"先皇立国用文儒，奇士多为礼法拘。\n澶水归来边奏少，熙河捷外战功无。\n生前上亦知强至，死后人方诔尹洙。\n蝼蚁小臣孤愤意，夜窗和泪看舆图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感昔二首 其一","author":"刘克庄","text":"谈攻说守漫多端，谁把先朝事细看。\n弃夏西陲忘险要，失燕北面受风寒。\n傍无公议扶种李，中有流言沮范韩。\n寄语深衣挥麈者，身经目击始知难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感遇二首","author":"刘克庄","text":"□趁朝参多失晓，不堪舞蹈始休官。\n临危昔以头全□，惩忿今无发指冠。\n醉语唐嗔狂李白，病忘汉免老师丹。\n暮年感泣龙销扇，直到来生泪未乾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新元二首 其一","author":"刘克庄","text":"朝三暮四昔尚童，踰七望八今成翁。\n见佛未肯右肩袒，对客尝称左耳聋。\n叩额有疏拜墀下，断腕无麻纳禁中。\n自怜老病菁华竭，不及花枝岁岁红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新元二首 其二","author":"刘克庄","text":"朝来微霰阁轻阴，揽镜空添雪满簪。\n官送桃符犹懒写，儿酬椒酒勿多斟。\n病于欢事全然淡，老觉春寒未易禁。\n惟有改诗成一癖，消磨不尽少年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新亭","author":"刘克庄","text":"此是晋人游集处，当时风景与今同。\n不干铁锁楼船力，似是蒲葵麈柄功。\n几簇旌旗秋色里，百年陵阙泪痕中。\n兴亡毕竟缘何事，专罪清谈恐未公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新勋侄宰松溪","author":"刘克庄","text":"麦垄青黄接，花封紫皂催。\n汝能驯雉否，吾亦割鸡来。\n琴调谁知者，租瘢岂忍哉。\n试询县斋客，莫也有澹台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新凉理故书有感二首 其二","author":"刘克庄","text":"空花瞥过似浮荣，海水难湔是恶名。\n功比禹轲真学者，罪浮桀纣亦书生。\n国师族覆惭家训，太尉朝危悔宦情。\n束起陈编呼伯雅，胸中磊磈暂浇平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新凉理故书有感二首 其一","author":"刘克庄","text":"□□先帝开宣室，频领群儒上石渠。\n奏牍三千前日事，寓言十九暮年书。\n色空勘破偏盲久，记诵俱忘一载馀。\n西晋诸人惟乐令，肯将名教矫玄虚。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪西","author":"刘克庄","text":"暮止溪西宿，喧呼聒四邻。\n满村无别姓，比屋喜生人。\n解榻勤为黍，烘衣许觅薪。\n客房惟有月，偏照不眠身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其十","author":"刘克庄","text":"豫为终制付诸儿，莫待飞腾变化时。\n涑水书仪非含玉，魏公治命欲披缁。\n外加麟楦中先悴，生著蝉冠死岂知。\n除卸布衾堪覆首，更无一物可相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其九","author":"刘克庄","text":"户外履綦常不到，手中锄柄少曾闲。\n古时废地今花坞，昨日荒陂忽蓼湾。\n牧马童乖能识路，操蛇神黠怕移山。\n颜曾老矣虽难免，犹在长沮桀溺间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其八","author":"刘克庄","text":"村深保社杂樵渔，岁晚溪翁此卜居。\n门下诸生皆去矣，冢旁二客定谁欤。\n即今不惜频投辖，他日毋烦更下车。\n却笑兰亭轻感慨，王侯归处即丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其七","author":"刘克庄","text":"病鹤曾栖禁苑枝，瞥然惊坠羽䙰褷。\n包弹靡靡萧萧制，指摘深深款款诗。\n表圣暇时先卜圹，牧之他日自为碑。\n独惭师说多遗忘，老抱残编嘱付谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其六","author":"刘克庄","text":"自有身来即有愁，谁能身外出神游。\n西方佛比于泡影，南面王输与髑髅。\n儒运金椎尤可笑，魋为石椁更何忧。\n曹瞒遗令空悲慨，铜雀台荒邺水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其五","author":"刘克庄","text":"挟册相从祇一童，林间终日饱松风。\n小窗面野容山入，曲圳分溪与沼通。\n定有裔孙寻远祖，尽教智叟笑愚翁。\n绝怜樗里无标致，一墓何须夹二宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其四","author":"刘克庄","text":"买断荒山手拮据，旋移短树已扶疏。\n尊堂背市知闻少，竹径通溪出入迂。\n辟瓮牖轩聊对卷，改弓弦路劣容车。\n可怜四壁空诸有，客至难营饭与刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其三","author":"刘克庄","text":"曾结丝絇侍玉旒，暮年身世寄沧洲。\n丑容讵得陪三阁，强项安能事五楼。\n何用渡芦登彼岸，偶然斩草乐斯邱。\n牧童窃听商歌起，此老胸中不著愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其二","author":"刘克庄","text":"昔美少年今老黧，云林深处葺幽栖。\n空房安得登伽女，同穴惟应法喜妻。\n尧桀两忘何足辨，彭殇俱尽不须齐。\n灵山弟子都麾去，免绕金棺掩面啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪庵十首 其一","author":"刘克庄","text":"涨水侵门堂跳蛙，偶来常是到昏鸦。\n宛如逆旅主人舍，谁访毗耶居士家。\n煨芋不嫌牛粪火，供茶就用鹿衔花。\n老来脚力全非昔，且可龛中坐结跏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞岩","author":"刘克庄","text":"金碧千间尽，惟庵免劫灰。\n佛归何国去，僧自别峰来。\n巨石神鞭至，悬崖帝凿开。\n幽寻情未已，木杪夕阳催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞峰寺","author":"刘克庄","text":"寺在高山顶，天寒偶一登。\n孤僧营粥饭，诸佛阙香灯。\n潮落洲分派，林疏塔见层。\n危栏宜老眼，欲去几回凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简竹溪二首 其二","author":"刘克庄","text":"驻颜元不待丹砂，筋力浑如昔建牙。\n剥尽皮毛真理窟，分些膏馥与儒家。\n苦吟寒谷应生黍，罢讲诸天亦雨花。\n自笑一生迷传注，傥容北面学南华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简竹溪二首 其一","author":"刘克庄","text":"溪边紫气半空浮，父老携杖看故侯。\n叔夜相思曾命驾，子猷一返少来舟。\n煨残僧芋平分吃，说道天花烂漫休。\n村叟安能留此客，地行仙偶出山游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简叔和诗再寄","author":"刘克庄","text":"弃置而今成秃翁，君恩量给太仓红。\n著鞭纵落诸公后，挥麈犹堪一世雄。\n花月三千篇绝唱，海天九万里刚风。\n胸中本自无冰炭，况读君诗益扫空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腰痛","author":"刘克庄","text":"偶得休文病，行迟卧不安。\n益绵身尚怯，加剂脉犹寒。\n扶出看山易，驱教立雪难。\n边头方募士，自愧已衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙仲书监通守温陵以戴尚书肖望李内翰元善尝历是官即西偏作室匾以西清风月宾主唱和甚盛次韵二首 其二","author":"刘克庄","text":"自北及南捷径行，冰厅消得此嘉名。\n且参光霁儒家景，谁管歌呼吏舍声。\n碎安道琴时好淡，种文正竹话偏清。\n每闻酬倡皆皮陆，耄矣无因共脍鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙仲书监通守温陵以戴尚书肖望李内翰元善尝历是官即西偏作室匾以西清风月宾主唱和甚盛次韵二首 其一","author":"刘克庄","text":"懒即蓬莱访具茨，平分不费一钱赀。\n子綦隐几而闻者，太白停杯以问之。\n螃蟹螯肥毋与事，琵琶调下莫题诗。\n是知二老回头笑，不料清源有此奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩监南岳庙","author":"刘克庄","text":"久问嫖姚乞退闲，今朝准敕放生还。\n人欺解罢青油幕，帝遣监临紫盖山。\n营卒展辞回玉帐，林僧讲贺到柴关。\n丈夫不办封侯事，犹要名标处士间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒜岭","author":"刘克庄","text":"到此思家切，寒衣半泪痕。\n烧馀山顶秃，潮至海波浑。\n仆怕昏无店，人言近有村。\n吾生输野老，笑语掩柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒜岭夜行","author":"刘克庄","text":"岭头无复一人来，渔店收灯户不开。\n松气满山凉似雨，海声中夜近如雷。\n拟披醉发横箫去，只寄乡书与剑回。\n他日有人传肘后，尚堪收拾作诗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲涧寺","author":"刘克庄","text":"齐人陈迹此流传，班史苏诗岂必然。\n故老皆言家即寺，痴儿误入海求仙。\n莫将刘项分羹鼎，来涴巢由洗耳泉。\n欲采菖蒲无觅处，且随箫鼓乐新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜀捷","author":"刘克庄","text":"吠南初谓予堪侮，折北俄闻彼不支。\n挞览果歼强弩下，鬼章有入槛车时。\n钟繇捷表前无古，班固铭诗继者谁。\n白发腐儒心胆薄，一春林下浪攒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞桂帅辟书作","author":"刘克庄","text":"一昨闻公莫府开，梦魂频绕岭头梅。\n久抛靴裤辞军去，忽有弓旌扣户来。\n茅舍相过争借问，荷衣欲出却徘徊。\n旧时檄笔今焚弃，孤负黄金百尺台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辟支岩","author":"刘克庄","text":"不上岩来四十年，高僧灭度我皤然。\n归葱岭路止只履，访草庵基无一椽。\n狂欲片帆浮巨浸，老扶双拐到危巅。\n谁人肯伴黄师伯，何不旁边著两禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦湖新亭告成宸翰大书水村二字以落之二诗辄附贺客之后 其二","author":"刘克庄","text":"自说秋毫尽帝恩，煌煌曦画照乾坤。\n偶留佳客常投辖，怕碍游人不设门。\n枕曲先生传醉种，咏梅处士有诗孙。\n何须更羡东西陕，君管南村我北村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦湖新亭告成宸翰大书水村二字以落之二诗辄附贺客之后 其一","author":"刘克庄","text":"暂辞玉笋眷犹浓，朝野皆知不世逢。\n贺老曾求湖一曲，希夷亦乞华三峰。\n凤衔奎墨飞华扁，虎拜觚棱折御封。\n帝以此翁深易学，除官壹似郑司农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"零陵","author":"刘克庄","text":"画图曾识零陵郡，今日方知画未如。\n城郭恰临潇水上，山川犹是柳侯馀。\n驿亭幽绝堪垂钓，岩室虚明可读书。\n欲买冉溪三亩地，手苫茅栋径移居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]