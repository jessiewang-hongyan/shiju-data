[{"title":"送黄寿老谒淮南贾制帅","author":"李龏","text":"雪边行李别诗朋，诗教龙门在广陵。\n十里红楼明月夜，莫将新句让徐凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分咏得鞋","author":"李龏","text":"一钩金押皂花罗，头似鹦哥小不多。\n记得花时人较醉，窣香曾上木兰坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前有一樽酒","author":"李龏","text":"前有一樽酒，主人奉客客称寿。\n君不见麟不能飞，凤不能走。\n龟灵于人，龙死于斗。\n山有时兮崩，河有时兮决。\n秦皇求仙竟不成，梁皇佞佛何曾彻。\n我今为君拂青萍，履明月，奏云和，歌白雪。\n洗涤尘埃九折肠，澡瀹风雷三寸舌。\n上愿天子圣，下愿宰相贤。\n字民之官不爱钱，四夷妥帖无狼烟。\n有田负郭安里?，秋堂夏屋临平川。\n左手黄卷右青编，糟糠功名一百年。\n坐上日日延俊秀，子孙孙子相绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"当置酒","author":"李龏","text":"故人客秋县，青轩临绣楹。\n颓阳横断柳，短渡隔孤城。\n风莲卸湘绮，露草结秦缨。\n当置一樽酒，前途路未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀友","author":"李龏","text":"幽人只隔一峰云，几度相思叫不闻。\n日暮小溪三四曲，蔷薇如雪落纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"旧馆忆王抱节","author":"李龏","text":"夜雨沧波上，寒塘草市中。\n钟闻两寺应，室掩一床空。\n买醉留僧烛，敲吟折水荭。\n沙边鸣宿雁，亦似哭诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有忆王抱节陈樗堂","author":"李龏","text":"贫驱游海县，常忆老诗朋。\n秋事无人语，危楼怯自登。\n蚌津红日冷，盐灶白烟凝。\n惆怅辽天鹤，缄书唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠黄中为赋澹翁","author":"李龏","text":"世间无味处，子独嗜之深。\n野菜羹前饮，梨花月下吟。\n尽于时态别，更没俗情侵。\n我亦心如水，因题契我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈子玉使君","author":"李龏","text":"黄纸新除郡，欣君得晋陵。\n几年淹俊轨，今日慰亲朋。\n地近家殊便，民淳治易兴。\n何时把麾去，莫废遣书縢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄抱节","author":"李龏","text":"枕簟惊秋客意悲，吴湖一望白云迷。\n风枝蝉老寒声起，野浦莲衰夕艳凄。\n书寄潮船多不到，诗临月馆少曾题。\n离魂每夜生归梦，只绕东迁汉县西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄陈公储","author":"李龏","text":"一岁又将晏，客游今海濆。\n水寒鸥上树，风劲鹘盘云。\n京酝秋曾饮，湖凉夜亦分。\n雪边梅事动，吟思正迷群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬陈复初见寄","author":"李龏","text":"不作科场梦，尘愁鬓亦衰。\n每于明月夜，多忆少年时。\n朗抱花空识，清贫镜独知。\n秋来大江上，件件欠君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桑树","author":"李龏","text":"无花多病枝，唯叶吐春辉。\n蚕不资为食，人应种者稀。\n阴成娇雉宿，椹熟乳莺飞。\n几槎闲红紫，从渠上锦机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风琴","author":"李龏","text":"呦咽高低韵不同，断魂江月更冥朦。\n隔窗暗觅声来处，响落晴霄一线风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信州道中","author":"李龏","text":"试出江东路，葛溪还玉溪。\n滩声喧水石，人语混凫鹥。\n田卧栽禾鼓，桑闲采叶梯。\n春城红酒味，犹忆在江西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清塘","author":"李龏","text":"苧旗风里响连耞，蓼岸飞尘入钓车。\n昨夜碧城疏雨过，断畦秋菜亦抽花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜芭蕉","author":"李龏","text":"绿似春江水染成，窗纱分映色偏明。\n霜风一夜浑梢破，叶上残诗读不行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日子规","author":"李龏","text":"血滴成花不自归，衔愁犹泣在天涯。\n秋声又比春□苦，除却渊明劝得谁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居友","author":"李龏","text":"不事尘中事，如君只一家。\n堕巢收煮茗，闲艇借移花。\n养树填山色，疏池抉草苴。\n妻孥谙地利，亦喜治桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松滨书馆","author":"李龏","text":"一身如鹤信萧闲，又向松滨寄客单。\n世事懒能扪虱话，生涯聊作豢龙看。\n删来稿卷吟还冗，洗过綀衣著倍宽。\n独有会心真得处，小庭幽草绿平栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登苏州齐云楼","author":"李龏","text":"故基何处是吴宫，醉上州城值晚风。\n箫鼓沉沉烟树冷，乱蛙声在落花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登凤凰台","author":"李龏","text":"缭垣桐数树，知是阿谁栽。\n鸣凤久不至，游人空自来。\n春声归百鸟，古意薄层苔。\n缥缈三山外，离云扫弗开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西兴","author":"毛珝","text":"蚤暮船争渡，都城隔岸间。\n昔为渔钓地，今作利名关。\n潮探尘中事，年催客里颜。\n水仙花又发，吾欲老江湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓池之清夷堂","author":"毛珝","text":"堂静草侵廊，羁怀未易忘。\n近城知郡圃，有佛即僧坊。\n恶句书盈壁，空樽垒到墙。\n使君临宠外，满目树苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送客游吴","author":"毛珝","text":"水乡秋易冷，珍重过吴松。\n在旅虽难遣，于诗莫厌攻。\n一轮僧寺月，半夜客船钟。\n况有贤州牧，知音是旧逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小至","author":"毛珝","text":"九地阳初动，披衣起拥炉。\n门前初去马，窗外渐啼乌。\n云色呈金未，梅梢破玉无。\n焚香待天晓，点易自研朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登黄岗清淮门","author":"毛珝","text":"风吹芦叶江头路，江水江天共秋暮。\n边淮寒早客行稀，只有征鸿向南去。\n征鸿自去书不来，远衣未寄凭谁催。\n孤城惨咽暮笳起，城下荒榛接淮水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种竹","author":"毛珝","text":"山居无力尘居俗，有客劝予惟种竹。\n种成贫家可骤富，翠色琅玕绕君屋。\n清晨荷锄斸溪岸，分得溪光入城绿。\n暮年百事课功迟，坐待春风满林玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"墨龙","author":"毛珝","text":"真人尸居雷八荒，断砖残墨生苍茫。\n鲵桓下■九渊黑，神光倒射角与亢。\n明明元气淋漓迹，水底焚槐海波赤。\n周流万化元无极，姑使人心识天则。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘江","author":"毛珝","text":"湘江谁道无情水，宝瑟声寒愁帝子。\n安知日月在中天，万古重瞳元不死。\n楚南楚北千里云，持香遥礼云中君。\n莫起悲风助骚怨，兰枯菊瘁不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东风","author":"毛珝","text":"东风煦妪如慈乳，欲报生成恨无所。\n自粘花片作斑衣，起捧春醪劝春举。\n傍人笑我老如许，我亦笑渠将及汝。\n梅花也笑柳都舞，君如不饮出童羖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浙江","author":"毛珝","text":"白鹇旧事随波去，太极阴阳自吞吐。\n长虹夜贯黑头船，四纪沙迎相公路。\n冯夷作剧真等閒，五都有客雄其间。\n上林三官浪忧国，千年海底生铜山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桧瀑","author":"毛珝","text":"娲皇失补天南角，一道银河落君屋。\n又疑元气自周流，不然泻尽谁能续。\n瀑边老桧尤可人，髯疏骨瘦皮鳞皴。\n崩崖欲压全不惧，夜半潜蛟暗来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富川邂逅戚叔开","author":"毛珝","text":"百虫阫蛰雁奔忙，君从何来两袂霜。\n大冠如箕盍齐鲁，此地无乃惊吠厖。\n钓竿曾笑江湖窄，尺水讵容投犗客。\n取羝为君向东軷，一声裂石扶桑白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎丘","author":"毛珝","text":"阿鸿血染吴苔碧，气彻重泉埋不得。\n千年至宝复归天，颠倒海中飞霹雳。\n至今荒怪列虞初，罅石千寻骇游客。\n寺边别庙是何神，月黑伽蓝问周易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月","author":"毛珝","text":"人言月里仙人住，隐约娑罗树根兔。\n玄霜捣就亦多年，不见有人曾得度。\n清光偏照边城秋，城边白骨胎王侯。\n王侯白骨卒未已，龟蚌吸月独不死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丹阳馆","author":"毛珝","text":"渡江第一南来驿，几度华堂延雁客。\n百年运逐晓云空，愁杀鞮官老无职。\n南徐今日古阳关，不断歌声祖离席。\n国雠已复事尤多，折损年年春柳碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富池庙","author":"毛珝","text":"船头蜀锦三千尺，倒影长虹浸寒碧。\n相逢不是紫髯郎，鹦鹉洲边眼生棘。\n江头箫鼓杂灵鸦，人道阴兵曾护国。\n安知楼下雪千堆，不是吞曹气冲激。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日即事","author":"毛珝","text":"黄花暴日香欲醉，黄蜂抱香暖欲睡。\n老夫邂逅亦欣然，一段先天画前意。\n喧喧归雀聒丛篁，夕风欲转明朝霜。\n花摇蜂醒我亦觉，斜阳一片秋茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓兴国之十咏亭呈诸友","author":"毛珝","text":"断垣荒棘疑无路，忽有幽亭一亩馀。\n不称郡侯来把酒，偏宜野客借观书。\n临阶汲水防苔滑，隔岸看山爱柳疏。\n非有旧交时下顾，十分风味落樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中年","author":"毛珝","text":"中年已悟昔皆非，正学无师更可悲。\n诗道纵能通阃域，圣经曾未涉藩篱。\n拟从周子参无极，更为东莱续近思。\n适意舞雩时一咏，区区何用苦吟为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓泉之定空寺","author":"毛珝","text":"斋钟声断佛香销，闲步虚廊转几遭。\n浊世自缘君不舍，青山岂是俗难逃。\n鸟如留客音声好，松似骄人意气高。\n因悟宿根元自有，栽培功浅长蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"掩卷","author":"毛珝","text":"盈箱积案欲何如，误尽苍生半属渠。\n陆贽外谁无负学，皋陶前是读何书。\n凿开素朴惟三画，斲碎真淳遂五车。\n安得六经行世外，民风尽返结绳初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢胡默堂","author":"毛珝","text":"创新小阁画难成，肯借山翁养病身。\n万事不忧知有命，数椽分庇可无人。\n观书漆几明于镜，攲枕藤床软胜茵。\n终恐傍门心未稳，弊庐虽弊每驰神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓泉之安溪","author":"毛珝","text":"已恨逢人语不通，更堪烟岭隔千重。\n山城纵是如花好，海雾终愁似墨浓。\n远信断无鸿可寄，故乡惟有月相逢。\n閒于荔绿蕉红处，步屧时留到晚钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"毛珝","text":"无雨无云晓色乾，忽惊瑰璧满檐端。\n不教声到窗前觉，应恐愁添屋下寒。\n占瑞农官寻玉尺，析酲公子索金盘。\n柴门睡起无多事，捲上疏帘带竹看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"关心","author":"毛珝","text":"关心岁月似惊波，少日无成奈老何。\n别久帝京知事少，住长客舍识人多。\n典衣酤酒杯难满，借壁题诗字易磨。\n早信出门无遇合，故山只合守樵柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"通之海山楼落成","author":"毛珝","text":"千寻雉堞一朝兴，五马行庖此落成。\n地峻鬼神愁设险，楼高星斗听谈兵。\n霞羞綵帜依山敛，月斗金杯出海明。\n更有万堆飞石在，寄声残羯盍魂惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤凰台","author":"毛珝","text":"江山依旧昔人非，多少兴亡问不知。\n雁去又逢重到日，凤归安得再来时。\n风吹木叶随渔艇，霜压芦花出酒旗。\n特地待吟吟未稳，数声昏笛戍楼吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"学道","author":"毛珝","text":"学道先须学忍贫，缊袍蔬食当华珍。\n抠衣所欠参前辈，开卷犹欣见古人。\n暗坐雨窗心似月，冷眠雪屋气如春。\n向来酷意耽吟事，今亦相忘越与秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠碧蜍","author":"毛珝","text":"鸢飞鱼跃两悠悠，造物何心莫问休。\n但得一杯长在手，不须万户更封侯。\n人间有梦何非蝶，物外忘机即是鸥。\n我亦青鞋行脚者，会摩铜狄话重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人才","author":"毛珝","text":"但得人才即治安，不忧外侮敢相干。\n学关世道方为士，业晓农家始是官。\n国力在兵堪用少，虏情如鬼欲驱难。\n岂无一代奇男子，抱膝无言静处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张梅深四首 其一","author":"毛珝","text":"几踏槐花角寸长，担簦羞作老来忙。\n立身早慕千层塔，阅世今知百戏场。\n从辟谷来惟嗜酒，自栽梅后不烧香。\n人生底为青衫急，亦有秋荷可制裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张梅深四首 其二","author":"毛珝","text":"不用悲歌抚铗长，古无人可免身忙。\n存心未必耕无地，涉世难忘选有场。\n新别水云书尚湿，旧题松桂笔犹香。\n只缘误触神舟走，惆怅京尘涴薜裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张梅深四首 其三","author":"毛珝","text":"我策曾无一策长，一生蚁踏历间忙。\n持经佛寺新投社，寄食田家旧筑场。\n古剑放教龙逐伴，残书分与蠹餐香。\n不愁死去无名在，化作千年老鹤裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张梅深四首 其四","author":"毛珝","text":"凫鹤都休较短长，静非无用动非忙。\n闲将诗卷排科甲，戏把文枰列战场。\n无地可施行话柄，有天须监格心香。\n功名细看时来耳，珍重渔蓑即衮裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古出塞","author":"毛珝","text":"初说戍渔阳，俄传出定襄。\n朝朝征马过，春草不曾长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山月","author":"毛珝","text":"山月共徘徊，山泉酌一杯。\n诗成无笔写，画石记苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书墨竹","author":"毛珝","text":"伯夷有宿世契，子猷结千古交。\n烟外三叶五叶，雨中一梢两梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观星","author":"毛珝","text":"九天有象不虚呈，历历都关国重轻。\n汉客可无经济意，只将牛女问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵","author":"毛珝","text":"绕城无数菜花黄，隔岸蒹葭接大荒。\n不分塞鸿偏得意，年年春老未还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵之堡城 其一","author":"毛珝","text":"四面蒹葭水接天，中间一片是人烟。\n相逢尽喜干戈息，白鹭飞来立战船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵之堡城 其二","author":"毛珝","text":"傍城三十里芙蕖，怪底繁华浙景无。\n元是近边农事少，全凭莲藕当官租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵之堡城 其三","author":"毛珝","text":"边声藉藉早秋风，稻未黄时枣又红。\n莫厌水乡迁避苦，全家载入绿荷中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仪真 其一","author":"毛珝","text":"频年岁稔少干戈，到处人能贩五河。\n只道鹾舟偏辐辏，玉杯泾段近年多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仪真 其二","author":"毛珝","text":"多旨楼边古柳斜，龙渊寺里隔荷花。\n清风尽日无人管，半属僧家半妓家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仪真 其三","author":"毛珝","text":"贩来北枣堪充膳，种得西瓜可析酲。\n总是中原旧风物，不堪今日是边城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚凉","author":"毛珝","text":"窗前洒地著胡床，浴罢闲来坐晚凉。\n更取壁灯移暗处，待他月上竹边墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南山有梅花","author":"毛珝","text":"南山有梅花，高者五丈馀。\n半空发清香，天人为踟蹰。\n城中三尺本，登盆缀流苏。\n进之画堂上，笑彼何粗疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中吟七首 其一","author":"毛珝","text":"幽幽山上松，泠泠松下井。\n白石当银床，青萝作脩绠。\n山翁独酌馀，无客可堪请。\n葛洪分炼丹，陆羽求煎茗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]