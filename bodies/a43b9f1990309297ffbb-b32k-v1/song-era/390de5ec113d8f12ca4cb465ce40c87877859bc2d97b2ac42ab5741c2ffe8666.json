[{"title":"木芙蓉菊花盛开","author":"张耒","text":"空山岑寂何所有，晚菊芙蓉相对幽。\n伴我悠悠过閒日，怜渠灼灼媚穷秋。\n清香但欲持供佛，醉舞何妨插满头。\n此生萍梗难前料，知复明年相见不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水南春望","author":"张耒","text":"洛岸东风送马行，桥横落日半川明。\n天连观阁云垂地，春入山河秀满城。\n老去飘萍甘屏迹，兴来怀古未忘情。\n短歌一曲聊回首，不待悲秋白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牛谷口","author":"张耒","text":"十万全师一战擒，谷盘苍硖路幽深。\n凄凉今古兴亡事，辽阔英雄割据心。\n涨洛暮连诸谷雨，秋云低抱半山阴。\n文皇功业今何处，磨灭荒碑蔓草侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王子开朝散早年以疾病谢事还江阴求诗为别三首 其一","author":"张耒","text":"济物昔所务，舍耕还自非。\n骎骎老将至，忽忽意多违。\n门有王夫子，柴车谢事归。\n令人三叹息，羞涩向尘衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邓学士慎思挽词","author":"张耒","text":"清苦吟诗客，癯羸嗜学身。\n诗书不得力，鬼物定欺人。\n类物传遗学，经书植妙因。\n九原谁与友，千载葬鱼臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邓慎思学士挽词","author":"张耒","text":"青衫献赋逢知己，白首耽书还误身。\n名著道山传故事，政行两郡泣遗民。\n文成典午群疑泮，诗和少陵佳句新。\n叹息苦身成底事，湖坟宿草已愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东池","author":"张耒","text":"东池久不到，摇落过秋中。\n万竹萧萧雨，孤荷袅袅风。\n遣秋诗酒在，久客岁时穷。\n唯有思乡梦，长随洛水东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东堂","author":"张耒","text":"杳杳寒鸡唱，漫漫夜色深。\n斗柄垂地直，河势向江沉。\n林鸟栖欲去，草虫寒尚吟。\n幽人掩蓬荜，不睡拥单衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"他乡","author":"张耒","text":"春寒客古寺，草草过莺花。\n小榼供朝酒，温炉煮夜茶。\n柏庭鸣晓吹，楼角丽朝霞。\n莫叹萍蓬迹，心安即是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日书事二首 其二","author":"张耒","text":"孤城已惨淡，晚色复朦胧。\n日动乌栖叶，云开雁去风。\n草繁田尚绿，霜薄叶微红。\n已是悲摇落，那堪岁更穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日书事二首 其一","author":"张耒","text":"草草漫翁居，心安知有馀。\n风高收野潦，霜晚足园蔬。\n宿火温茶箧，明灯转素书。\n御冬无旨蓄，渍药酒盈壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂书六首 其六","author":"张耒","text":"望极添秋思，楼高动旅怀。\n天寒诸濑急，野阔四山来。\n馀叶能几许，高鸿殊未回。\n年年洛阳道，岁晚厌风埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂书六首 其五","author":"张耒","text":"短景冰霜地，人稀豹虎村。\n风连诸壑动，日带乱山昏。\n浩荡空回首，萧条独掩门。\n东周旧耆老，留滞饱知闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂书六首 其四","author":"张耒","text":"岁暮周南远，惊心鬓欲丝。\n风霜为客老，淮海寄书迟。\n峡冷重云夜，天昏断雁悲。\n山炉通夕火，赖尔独吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂书六首 其三","author":"张耒","text":"一径秋风起，牛羊晚自归。\n寒灯明野店，吠犬守荆扉。\n空峡风霜急，孤村火烛微。\n庭梧摇落尽，栖鸟夜归稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂书六首 其二","author":"张耒","text":"岁暮北风疾，山深寒日昏。\n授衣贫厌补，添纩老须温。\n懒慢抛书卷，晴明到药园。\n邻家新酒熟，吾敢但空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂书六首 其一","author":"张耒","text":"地僻秋将老，山深客未归。\n闭门朝对雨，搜箧冷添衣。\n图暗经阴画，琴昏在匣徽。\n妻孥惯山薮，不复问珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴六首 其六","author":"张耒","text":"击柝山城闭，疏灯野店扃。\n疾风鸣夜谷，晴水动浮星。\n霜翼归何晚，邻机织未停。\n短歌时自和，愁绝更谁听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴六首 其五","author":"张耒","text":"南壁苍崖壮，穷冬井落閒。\n风声先老树，日色避诸山。\n落雁饥相向，啼乌夕自还。\n微微寒月影，蓬户已深关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴六首 其四","author":"张耒","text":"空山身欲老，徂岁腊还来。\n愁怯年年柳，伤心处处梅。\n绿蔬挑甲短，红蜡点花开。\n冰雪知何有，东风日夜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴六首 其三","author":"张耒","text":"池馆留馀雪，西山照夕曛。\n腊催梅蕊迸，春向鸟声新。\n愁思供多病，风光欲近人。\n年年桃李树，相对只伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴六首 其二","author":"张耒","text":"水落桥痕在，沙乾岸草枯。\n霜馀槐老壮，风际竹清疏。\n啄木高逾响，鹡鸰飞且呼。\n二年亲友绝，惟有对禽鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴六首 其一","author":"张耒","text":"小园晴自扫，曝日坐前轩。\n野鼠穿山叶，寒乌啄草根。\n短篱藩隙地，别径入孤村。\n幽趣供岑寂，淹留不复论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日作二首 其二","author":"张耒","text":"泽国久还雨，频妨裘褐温。\n羁怀常悄悄，醉眼任昏昏。\n云赴荆王梦，天迷楚客魂。\n飘萍惟泥酒，吾事肯轻论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日作二首 其一","author":"张耒","text":"南雨不成雪，北风楼观寒。\n眉颦鲁酒薄，肠断楚梅酸。\n云梦寒全薄，湖湘春欲还。\n举头瞻去雁，羡尔有轻翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬节小不佳怀正叔老兄","author":"张耒","text":"老境光阴短景催，新冬又复一年回。\n焚香燕坐衣僧衲，煮药高眠废酒杯。\n处处庖厨鸣瓮缶，年年歌笑惨风埃。\n孟公歌舞犹须雪，未放愁眉取次开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬后三日郊赦到同郡官拜敕回有感","author":"张耒","text":"诏书夜下走风雷，清晓州门拜敕回。\n天上六龙归禁阙，人间一雨到根荄。\n江边时日将舒柳，雪后春光欲到梅。\n白首放臣随众喜，教儿深酌手中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至三首 其三","author":"张耒","text":"孤衾不成寐，起坐听鸡号。\n楼闭更筹静，天寒星斗高。\n萧条陶令酒，清怨楚臣骚。\n凛凛悲秋意，何须待二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至三首 其二","author":"张耒","text":"汴水日夜浅，天寒霜野宽。\n拂衣秋叶乱，冲面北风寒。\n不作归山计，空悲走马鞍。\n济时吾力薄，俯仰一悲叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至三首 其一","author":"张耒","text":"昨夜新霜落，淮南十月初。\n寒云风后白，高木雨来疏。\n功业嗟谋拙，星霜逼岁馀。\n子云真拙者，寂寞为玄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后三日三首 其三","author":"张耒","text":"梅柳有情态，江城过岁除。\n山村见霜橘，江市出寒鱼。\n谪久衣冠懒，身闲故旧疏。\n傍篱挑翠甲，忆我故园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后三日三首 其二","author":"张耒","text":"水国过冬至，风光春已生。\n梅如相见喜，雁有欲归声。\n老去书全懒，闲中酒愈倾。\n穷通付吾道，不复问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后三日三首 其一","author":"张耒","text":"寒暑添线衲，朝晡折足铛。\n何劳问荣辱，便是了平生。\n理自阴阳运，吾宁口舌争。\n深居玩吾宝，不遗世人轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至赠潘郎","author":"张耒","text":"晓镜星星华发新，江山流落未归人。\n五纹暗度人间线，九寸潜通地下春。\n歌笑欣欣环老稚，杯盘草草称清贫。\n与君同是柯山客，窗外梅花解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出都有感","author":"张耒","text":"来时雪尽花初发，归去柳阴蝉乱鸣。\n四序风光半为客，百年飘泊一浮名。\n春来多病思高卧，老去违时畏后生。\n若有黄精换华发，敢随车马到高城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"务中晚作","author":"张耒","text":"官事一酒瓮，寝斋低竹檐。\n朝昏睡过半，老病醉相兼。\n楼晚双旂袅，城昏叠鼓严。\n隔江吹笛处，空碧帖新蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北桥送客","author":"张耒","text":"桥上垂杨系马嘶，桥头船尾插青旗。\n船来船去知多少，桥北桥南长别离。\n亭上几倾行客酒，游人自唱少年辞。\n百年回首皆陈迹，浮世飘零亦可悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发云山近岐亭望光蔡接尉氏","author":"张耒","text":"白草黄茅间瘦田，郊原残暑已萧然。\n泽连楚梦悲秋野，山近尧封望日天。\n浓绿远陂铺晚稼，幽香秋水折残莲。\n热行更益相如渴，怅望华陵陆子泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发长平","author":"张耒","text":"归牛川上渡，去翼望中迷。\n野水侵官道，春芜没断堤。\n川平双桨上，天阔一帆西。\n无酒消羁恨，诗成独自题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发安化回望黄州山","author":"张耒","text":"流落江湖四见春，天恩复与两朱轮。\n几年鱼鸟真相得，从此江山是故人。\n碧落已瞻新日月，故园好在旧交亲。\n此生已免嘲伧父，莫避北风京洛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发泗州","author":"张耒","text":"万艘猎猎战风桅，我亦孤舟别岸隈。\n漠漠晓云生木末，萧萧飞雨送帆开。\n消磨岁月书千卷，零落江湖酒一杯。\n因病得州真漫尔，功名于我亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发金陵折柳亭二首 其一","author":"张耒","text":"绿衮溶溶日，红飞寂寂春。\n青山今古事，芳草去来人。\n歌吹酒家市，帆樯贾客津。\n谁云绝胜地，登眺更伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发金陵折柳亭二首 其二","author":"张耒","text":"桃李蕃晴日，江山秀晚春。\n孤舟多病客，长道未归人。\n豪俗竞行乐，倦游慵问津。\n南山还暮雨，疑有楚台神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月二十日书二首 其二","author":"张耒","text":"久将醉眼视群儿，只与旁观作笑嘻。\n赋芋狙公曾未悟，牵丝木偶几多时。\n云间炎景人方畏，地下微阴谁得知。\n荣谢古今同此理，老翁端坐但忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月二十日书二首 其一","author":"张耒","text":"十步荒园亦懒窥，枕书小醉睡移时。\n健如黄犊时无几，钝似寒蝇老自知。\n休惜飞驰春过眼，但求强健酒盈卮。\n枇杷著子红榴绽，正是清和未暑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四安道中","author":"张耒","text":"地平弥望水，舟稳满帆风。\n黄叶新霜后，青山落照中。\n封疆天象别，风俗岛夷同。\n黯黯危桥夜，疏灯照闭蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老舅寓陈诸况不能尽布以二诗代书得閒为和佳也 其一","author":"张耒","text":"欲知老子居陈事，古寺萧条屋数楹。\n幸免绝粮惭孔圣，更无环堵羡渊明。\n参差拙句何曾是，宠辱浮云无可惊。\n断送光阴须美酒，惟应此事费经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归马二首 其二","author":"张耒","text":"萧萧霜鬓独惊秋，病眼天边暮倚楼。\n已老冯唐犹不遇，思归庾信正多愁。\n溪通积雨流方壮，山入重云翠未休。\n一梦淮南经岁别，菊林还向洛阳浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归马二首 其一","author":"张耒","text":"归马骎骎不受鞭，晚霞如画照晴川。\n萧疏黄叶孤舟岸，零落秋云断雁天。\n临水登山悲楚客，烹鸡酌酒爱诸仙。\n任从老逐霜毛至，莫遣愁来玉盏边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未试即事杂书率用秋日同文馆为首句 其三","author":"张耒","text":"倦枕愁霜苦，晴窗宿雾开。\n幕云当昼合，袍雪与风来。\n元日彤庭实，春风曲水杯。\n何须恋杨柳，圣世要无媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未试即事杂书率用秋日同文馆为首句 其一","author":"张耒","text":"邃馆深鱼钥，华堂静锁闱。\n每劳蛩作伴，不与燕同归。\n古栋蜗成篆，空墙藓作衣。\n寂寥还泛菊，九日莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十日梦在京师","author":"张耒","text":"客睡何展转，青灯暗又明。\n春云藏泽国，夜雨啸山城。\n许国有寸铁，耕田无一成。\n朦胧五更梦，俄顷踏王京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十八日晴霁登柯眺望二首 其二","author":"张耒","text":"寂寂池亭古，园荒草自春。\n东风独游客，迟日未归人。\n久雨众山晦，初晴万境新。\n长歌视天壤，高兴不无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十八日晴霁登柯眺望二首 其一","author":"张耒","text":"柯山通细履，幽步近青红。\n送目无穷浪，吹花尽日风。\n馀生付沮溺，高论看夔龙。\n陈许春多雪，吾行亦欲东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月三日大雪雪晴有感","author":"张耒","text":"平生对雪须千首，何事今春无片词。\n老大怯寒唯泥酒，穷愁须醉不吟诗。\n润催庭柳将开眼，冷送江梅欲别枝。\n何处高楼有残白，旧游无处寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月六日","author":"张耒","text":"杨柳梢头腊雪消，东风犹著晚寒骄。\n新年花柳传芳信，去腊星霜变斗杓。\n来共春烟情冉冉，洒随疏雨泪萧萧。\n蛾眉一闭年华改，纵有遗魂可得招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永宁遣兴三首 其三","author":"张耒","text":"花县春曾到，人家幽谷间。\n市门犹碍石，耕垄尽依山。\n地僻荆榛秀，人稀鱼鸟闲。\n赖逢贤令尹，沉醉不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永宁遣兴三首 其二","author":"张耒","text":"朱颜潘令尹，不肯事轻肥。\n笋径青无地，苔墙绿有衣。\n书勤枯简断，诗疾紫毫飞。\n应笑疏慵尉，朝游暮醉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永宁遣兴三首 其一","author":"张耒","text":"国破空陵墓，时移改要冲。\n人随幽谷路，县隐乱山峰。\n零落荒祠树，悠扬晚寺钟。\n犹传仙旧隐，跨鹿有遗踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永济桥","author":"张耒","text":"墟庙无人吊毁垣，故桥遗址至今存。\n侵波野岸生新草，齧石老沙留旧痕。\n金殿有基藏兔穴，玉舆无路半樵村。\n甘棠古道轮蹄断，落日空山暮雨昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用元韵因寄邦直","author":"张耒","text":"濠上昔相逢，同时执桂丛。\n远游悲聚散，投老信穷通。\n静见贤人节，恬知达士风。\n淹留君莫叹，荣辱竟虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白羊道中二首 其二","author":"张耒","text":"日出客心喜，路平人足轻。\n风高不成冷，雨过有馀清。\n水落溪鱼出，村深田鹳鸣。\n胜游须秀句，多愧谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白羊道中二首 其一","author":"张耒","text":"徒旅已屡憩，过山知几峰。\n空畦鸣野水，坏道拱寒松。\n醁酒自能暖，褐裘初御冬。\n朝饥久未食，林寺已鸣钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋后便凉诗示秬等","author":"张耒","text":"暑别齐纨知有日，秋生蕲竹果如期。\n月明半夜似相觅，角怨五更知为谁。\n风露满天河转后，江山千里雁来时。\n短檠莫倦亲灯火，又见槐花黄满枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乔木","author":"张耒","text":"舍北参天乔木长，依凭清荫护高堂。\n鸟啼杳杳重阴合，风到翩翩翠叶凉。\n已许孤高凌夏日，不妨坚老要秋霜。\n投身麋鹿无人地，非尔烦忧未易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任左藏挽词","author":"张耒","text":"人也隐君子，一官聊自閒。\n谁能学管库，竟尔死茅菅。\n良璞不易剖，大弨终不弯。\n惟应太史录，他日出名山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日不出","author":"张耒","text":"久厌衣冠尘土浸，赐休何苦马骎骎。\n穷冬积雪春不雨，昨日残红今绿阴。\n却扫不知门外事，安禅深得静中心。\n读书陶令非求解，禁酒扬雄不待箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]