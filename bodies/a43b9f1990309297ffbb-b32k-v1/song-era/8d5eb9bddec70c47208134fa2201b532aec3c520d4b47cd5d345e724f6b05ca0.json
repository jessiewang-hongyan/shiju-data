[{"title":"分直玉堂有怀","author":"程公许","text":"儤直稍宽庚伏暑，传宣来自玉皇家。\n冰盘满掬三危露，金榼频?九酝霞。\n衙鼓骤惊行抱牍，索铃犹误吏催麻。\n叵堪厨酿甜如蜜，漫倚桥栏看水花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长生观拜谒碧落侍中观巨楠","author":"程公许","text":"功行三千未易圆，活人阴德最为先。\n一瓢酒酿春江醁，百尺楠藏洞府天。\n道骨想从玄祖受，高风应许裔孙传。\n珥貂碧落犹官府，何似鞭鸾陪散仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨过南溪","author":"程公许","text":"小艇溯洄稳，短篷兴寝劳。\n断崖榕倒影，乱石水翻涛。\n过雨山如沐，终风晚更饕。\n愁须诗自遣，吟罢转萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙子寅月九日五鼓梦馀忆旧作因用韵","author":"程公许","text":"业识萦牵岂自由，幸逢此劫在儒流。\n昏昏心似未磨镜，役役身如不缆舟。\n闻道无缘时已晚，养生欠术鬓先秋。\n向平可谓真男子，家事无关五岳游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北新桥借孙氏宅内有井甘寒又有柳阴度夏为宜","author":"程公许","text":"幸有安居暂寄包，拙如鸠不费营巢。\n日长有井供茶课，客至移床荫树梢。\n无事莫将吟思搅，尽閒且把旧书抄。\n心知守道惟玄默，不用援毫赋解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归班之明日以六参入趁起居","author":"程公许","text":"湖海飘摇误召环，春风入缀紫宸班。\n恭闻聘币及岩穴，不以多材遗蒯菅。\n静念升沉皆命分，喜因蹈舞拜天颜。\n承明莫作官曹看，汗简须凭直笔删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正之二十八日忽小霁领数客过东湖若水有赋为次韵","author":"程公许","text":"积雨酿成寒料峭，漫游稍觉意清真。\n痴云妒日吞还吐，弱柳含烟巧斗新。\n簪屐招呼参楚蜀，肴蔬饤饾杂冬春。\n却嫌车从妨佳趣，那得临流岸白纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月二十日雪","author":"程公许","text":"东皇弭节未多时，忽作漫空六出飞。\n商略田功兴嗣岁，翕张天巧惜阴机。\n麦才覆土欣苏醒，梅久烘晴稍发挥。\n萧寺掩关终日卧，忍寒不著兽红围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月念三日以南床劾论去国憩净慈客馆苏税院惠二诗和韵 其二","author":"程公许","text":"寄包古刹客过门，煨芋残炉晚未温。\n万里风尘迷远望，三峰文献接诸孙。\n湖山春动饶佳趣，杖履时来共至言。\n一笑老仙堤柳畔，人间谁怨复谁恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正旦上寿紫宸微臣以祀太一初献不预赐茶酒退就殿门少歇俟追班拜正旦贺表","author":"程公许","text":"去岁枫桥度岁除，寒灯一盏自抄书。\n谁知东观归翻史，仍许西垣缀佩琚。\n四辟不忧狞虎豹，九成犹恐眩鶢鶋。\n彤墀百拜陈金鉴，只愿中兴似国初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用光弟携儿送至南定","author":"程公许","text":"亲友远追送，后先还故乡。\n殷勤仲光父，嫪恋及江阳。\n执手哽无语，修名那易量。\n归来训子侄，椿桂会联芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋后三日得二侄并侄孙家书","author":"程公许","text":"万里书来印籀红，慰情何但万金同。\n悬丝性命幸存活，扫地生涯甘阨穷。\n老去忧心长似醉，秋来衰鬓乱飞蓬。\n故园未有西归日，且愿平安信数通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春八日自成都起程度剑阁","author":"程公许","text":"萧寺深居稳，春深殊未知。\n偶然成远役，犹幸及芳时。\n麦浪含风软，花光眩日迟。\n客行无复恨，随处可寻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春再雪与禅衲夜话","author":"程公许","text":"蓬莱不肯著痴仙，放去湖山一任颠。\n术不竞时甘敛退，僧知同趣喜留连。\n春深半地雪盈尺，云破遥林月一弦。\n拨尽灰寒吟未稳，不如攲枕惬昏眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和前韵","author":"程公许","text":"条风吹转斗杓东，护日祥云一段红。\n圣主庆成神玺重，老亲喜动寿杯融。\n尘沙自染双蓬鬓，岁月难磨两碧瞳。\n斗印垂腰吾分耳，早看儿辈策新功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游凤凰山寺 其一","author":"程公许","text":"人生出处岂前谋，岁一星周再此游。\n世故鼎来忧似海，壮心空在鬓先秋。\n戎车拥路抽身去，僧钵分香劝我留。\n扰扰战争何日定，从前变灭几浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游凤凰山寺 其二","author":"程公许","text":"西康州隔暮云边，风去不来今几年。\n神眷此山良有以，客行何恨独潸然。\n瑞图那复来阿阁，王泽何当复下泉。\n定慧光中祈印證，等慈心与佛齐肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋","author":"程公许","text":"物华过眼半黄凋，万窍号风夜慄憀。\n一寸古心难石转，三生妄念易冰消。\n铅黄汗笔千年梦，白黑文枰几路饶。\n勘破古今无一事，省烦更好去风瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华阳尉授代喜成二首 其二","author":"程公许","text":"冉冉岁云暮，齐邱促戍忙。\n倦凭南郭几，静寄赞公房。\n梦想蚕丝软，涎流蚁杓香。\n循陔归洁养，一笑乐哄堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华阳尉授代喜成二首 其一","author":"程公许","text":"唱第八年久，折腰三考书。\n上官容我拙，朴学与时疏。\n冷落随阳雁，蹒跚上竹鱼。\n平生经世志，穷达岂关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同二侄一甥游灵隐净慈寺","author":"程公许","text":"韶华倏已三旬过，南北山分两日游。\n翠逻晚寒催暖酒，绿杨风软缓移舟。\n无多官事妨行乐，有许吟情夺隐忧。\n三揖孤山林处士，泰和容许隐巢由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同杨景韩饮虞献子江亭用壁间文与可韵","author":"程公许","text":"晴滩属玉玩烟霏，照眼琅玕碧四围。\n堂荫白茅娱子美，江吟净练忆玄晖。\n谁家鼓吹观游去，何处笭箵罢钓归。\n尚想江南图画里，风帆夜落道人矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同家德清侍尚书杨宝学山行先过上岩访家谐季","author":"程公许","text":"鹤书杳杳上岩云，锦里安车忽暮曛。\n二陆久当为世瑞，一夔留与护香芸。\n中春涧壑晴如暝，亭午松萝气自薰。\n倚槛欲歌招隐赋，客尘痼我不成文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同振之德久分韵赋坐石东坡得坡字","author":"程公许","text":"千年间气落岷峨，惊世声名镇不磨。\n吟咏西湖虽有案，经年儋耳却无波。\n细看据石横藜坐，想见骑龙跨海过。\n山谷老人犹剩语，是非元不到东坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成都萧寺度腊即事示彦威侄二首 其二","author":"程公许","text":"掣电光阴不可追，回头四十九年非。\n万缘勘破姑随顺，至道精探识指归。\n感慨未能忘世虑，因循深恐误时机。\n寒窗细话经纶策，来岁昕廷为发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成都踰旬阴冷深冬时节借馆超悟得子敬德夫二兄相晤语差慰寂寥","author":"程公许","text":"屯阴不动紫金盘，三月凄风横作寒。\n待旦重衾才得暖，感时对酒祇长叹。\n黑云何日三舍避，黄道中天万目看。\n不有对床清夜语，客怀何以解忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江涨有感","author":"程公许","text":"惆怅天涯私自怜，锦囊有句愧重编。\n忍心宽作青梅约，眩眼俄惊丹荔燃。\n浩荡修途今几驿，纷纭归思日如年。\n不因煤颖相料理，何以遣怀风月前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红白芙蓉","author":"程公许","text":"木蕖三数株，能白又能朱。\n晓暮浅深色，醉醒容态姝。\n流霞?玉斝，抽汞养丹炉。\n模写终难尽，秋江有画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自七曲祠下乘马至上亭二首 其二","author":"程公许","text":"仗卫森严九虎关，从前错为敌人宽。\n那知黄竹瑶池梦，历尽青天蜀道难。\n回首烟尘三辅隔，惊心风雨五更寒。\n淋铃一曲上亭驿，好并千秋金镜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自七曲祠下乘马至上亭二首 其一","author":"程公许","text":"征鞍不怕朔风颠，揽尽鱼凫气脉全。\n秦岭剑攒青不断，潼江带小碧相连。\n五云楼殿元皇宅，一柱西南半壁天。\n分职幽明两无愧，玉关快马洗风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自船庄过化城留宿翌旦炷香宣石桥卯塔","author":"程公许","text":"路欲转前岭，僧邀宿化城。\n饭抄青䭀软，茶瀹乳花轻。\n岚雨侵衣润，松风入夜清。\n瓣香宣老塔，坐待日华生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行至罗江以代者爽期得史者书复还涪滨径走富乐山中借馆 其三","author":"程公许","text":"山中有何乐，淹留不复叹。\n濯足涧泉碧，洗耳松风寒。\n清磬度林杪，枯禅兀蒲团。\n拙不会参请，幸勿催抽单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西省斋宿陪侍左史曹舍人话旧以除当字赋诗下教和答 其二","author":"程公许","text":"泼面缁尘不易当，佩兰谁与共祗芳。\n迂顽羞问翻阶药，邂逅容分夹案香。\n且可埋头翻竹素，底须系肘诧银黄。\n看公自致青云上，老我何妨诮斗量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西省斋宿陪侍左史曹舍人话旧以除当字赋诗下教和答 其一","author":"程公许","text":"一行奎画宠新除，左陛濡毫要直书。\n何幸鹓班连省闼，误令鼠璞杂琼琚。\n云窗雾阁非官府，璧月珠星近帝居。\n二十年前旧骚律，琢磨今乃过黄初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观壁间郑宣威早春赏杏花之作司令洪丈命余即事用韵 其一","author":"程公许","text":"乍听归燕语窗栊，催放莲灯万炬红。\n扫尽妖氛春色外，唤回和气雨声中。\n时机翻覆须天定，人事扶持愿岁丰。\n幕府贤劳愧群彦，吟诗留俟采民风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观壁间郑宣威早春赏杏花之作司令洪丈命余即事用韵 其二","author":"程公许","text":"过雨曲尘缲浅绿，倚风绶带娜殷红。\n稍知春在酒深处，尤觉日长书课中。\n典记误令参邺下，封囊也拟学新丰。\n黄云催熟崆峒麦，破敌何须鹤唳风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过万里桥辛巳春仲二十五日送别先君于此俛仰四年不胜感怆","author":"程公许","text":"涨绿平堤万里桥，安舆欲去此迟留。\n了知薪尽无馀火，犹复情痴认刻舟。\n终古不磨方寸恨，深恩未有一分酬。\n回头菽水中年乐，拥袂汍澜涕莫收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余为华阳尉三年事制置使榷牧都漕两使者皆以文字辱知不尽责以吏也既满戍拟濛阳丞归亲旁范使者为改注左绵学官疟病再作未即就戍成二诗呈兄长及诸友 其一","author":"程公许","text":"锦江傲吏真痴绝，公事无多日赋诗。\n风月讳人贪捃拾，烟霞痼我费医治。\n非关疟鬼工为厉，岂有诗人不耐饥。\n三月不曾吟一句，汗颜何以有毛锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余为华阳尉三年事制置使榷牧都漕两使者皆以文字辱知不尽责以吏也既满戍拟濛阳丞归亲旁范使者为改注左绵学官疟病再作未即就戍成二诗呈兄长及诸友 其二","author":"程公许","text":"拄笏西山兴已浓，蚌溪邀我采芙蓉。\n客游旧有诗盟在，官冷新添野性慵。\n世路今方悲梗塞，家山暂许乐从容。\n等閒袖手棋枰外，紫电中宵掣剑锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余拉威济取山路归家用光独溯江再和见贻仍同赋","author":"程公许","text":"冠藤衣葛自萧閒，岩壑精神绘画难。\n着脚兔庭聊试险，同盟鸥社未应寒。\n快晴山色凝朝采，急雨汗流吼夜滩。\n近日诗情差觉胜，剩加砻错怕人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别凌云士友","author":"程公许","text":"三生缘法熟嘉州，乘兴俄成十月留。\n山水纵观方得趣，交朋莫逆忽抽头。\n淋漓张饮梅花岸，惨淡分携杜若洲。\n恨欠白崖陪杖屦，春风和暖及同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别谢德芳","author":"程公许","text":"舣棹江干得款留，曾将避世与君谋。\n谁知事变即勘定，端藉儒先宽顾忧。\n分陕续书劳会计，借筹偶暇语绸缪。\n分携竟作春风约，梅驿瞻云黯暮愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿后溪刘侍郎","author":"程公许","text":"朱颜白发炯双瞳，一念平生造物通。\n内阁图书真学士，西园几杖老仙翁。\n木公金母人间现，桂子桐孙寿籍同。\n遥想綵衣圜四世，后溪无日不春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿李悦斋五首和送三荣使君韵 其五","author":"程公许","text":"磊磊松椿干，渊渊金石声。\n功名宁贳我，富贵本无情。\n陛对三千牍，胸奇百万兵。\n扶持天意在，容我请长缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿李悦斋五首和送三荣使君韵 其二","author":"程公许","text":"宇县风尘暗，军需色目繁。\n时机宁我待，心事向谁论。\n膻聚蚁争慕，泉深骥渴奔。\n非公能借箸，猛虱恐徒扪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿李悦斋五首和送三荣使君韵 其四","author":"程公许","text":"衡泌春无尽，湖天风快哉。\n书堂三寿语，仙籍几生来。\n一发扶周鼎，千金筑隗台。\n人心索调护，根本更须培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿李悦斋五首和送三荣使君韵 其三","author":"程公许","text":"国镇重双璧，宠光均一时。\n姱修甘俗忤，忠愤倚天知。\n闻道徵环急，难忘侧席思。\n分明调鼎味，梅熟雨垂垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿杨浩斋二首 其二","author":"程公许","text":"澒洞风尘涨九垓，万牛何事首空回。\n隐思未易甲兵洗，商略须先根本培。\n望望玺封颁紫阁，骎骎鼎味熟黄梅。\n颂言岂为抠衣旧，黄道方期日月开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿杨浩斋二首 其一","author":"程公许","text":"驾鹤飞来白玉京，疏髯秀色自仙真。\n要看转物天机密，更念居閒学力新。\n孔孟以来扶坠绪，羲黄向上属谁人。\n雅知仁静宜黄耇，仙谷烟霞不尽春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿宪使江寺簿八首以座右公廉勤谨忠信和缓八字为韵 其一","author":"程公许","text":"并生宇宙间，分殊理则同。\n订顽有明训，造化与同功。\n心腹与手足，疴痒均我躬。\n皇皇一仁字，天下皆为公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿宪使江寺簿八首以座右公廉勤谨忠信和缓八字为韵 其七","author":"程公许","text":"和与同近似，同乃异于和。\n九官逊虞廷，儆戒而赓歌。\n不然水济水，后患将如何。\n期公调鼎食，一柱障颓波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山雪","author":"程公许","text":"倚天无数玉巉岩，心觉庐山是雪山。\n未暇双林寻净侣，试招五老对苍颜。\n远游借问有何好，胜赏何曾容暂閒。\n却恨此生云水脚，误随人去踏尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张伯修令君赋诗同韵称庆","author":"程公许","text":"玉节何如素节高，归来喜气溢东皋。\n存耕元自有馀地，嘉植何曾生不毛。\n采石勋名须世济，陵阳今昔几人豪。\n含饴一笑春无价，授简梁园可惮劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟玉溪体赋醴泉墅海棠二首 其二","author":"程公许","text":"濯锦波光绕百遭，夜寒秉烛更须高。\n恨无丽藻供摛翰，聊复重裘索俊羔。\n长笑董仙痴守杏，可怜曼倩坐偷桃。\n若教入侍红云殿，应悔从前俗虑饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟玉溪体赋醴泉墅海棠二首 其一","author":"程公许","text":"东皇张饮锦周遭，华艳偏宜望处高。\n结绮楼深迷玉树，销金帐暖醉羊羔。\n先驱瑞节眩秾李，近侍舞衫环茜桃。\n乞得巫云来芘护，蜚廉作横未应饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李德夫司理即永康官居辟小轩赋诗二首求京花和韵遣送 其二","author":"程公许","text":"西洛风流压众芳，十分国艳与天香。\n护持翠幕千窠锦，羞涩青铜两鬓霜。\n不怕眼花疑保福，且将色相问空王。\n书窗不要笙歌杂，茗椀相娱味更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东川怀古","author":"程公许","text":"平生不踏东川路，乘兴春风烂漫游。\n文冢姓名悬日月，书堂冤愤惨林丘。\n欲呼千载醉魂起，那复少陵诗句遒。\n啼鸟不知人意绪，弄晴刚自说春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步自南定楼至海观","author":"程公许","text":"南定楼西径女墙，等閒杰观借相羊。\n山连六诏夐深阻，城挟三江交淼茫。\n薄晚渡船人意急，清秋倚槛客情荒。\n乾坤杀气凄凉甚，浮海吾宁逐磬襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟登弁山祥应宫之绝顶望太湖窥黄龙洞过倪尚书云岩","author":"程公许","text":"蘋浪蹴帆移别浦，笋舆邀我度遥岑。\n云开震泽水银溢，风掠洞庭螺翠深。\n神井千寻龙起蛰，幽岩四面石成林。\n苏仙诗句倪公赋，万古清风僭嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"连日得关表捷报闻敌骑无复留境上者志喜成诗","author":"程公许","text":"十里旌幢转晓风，行营日报捷书同。\n悠悠何补青油画，栩栩惊回画角雄。\n壮士有怀时拔剑，仁人无策弛张弓。\n天机翕辟一翻手，看取桃林骑火红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邑令招讲上元故事与簿尉同赋二首 其二","author":"程公许","text":"人情悦豫乐音谐，新觉华谯气象佳。\n璧月辉辉三夕永，榆星历历九霄排。\n笙歌围坐花如海，殽核堆山酒若淮。\n富贵方来付公等，五云深处岂无阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]