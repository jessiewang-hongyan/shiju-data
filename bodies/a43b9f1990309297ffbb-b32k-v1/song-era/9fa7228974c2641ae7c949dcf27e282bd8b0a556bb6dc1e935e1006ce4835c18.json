[{"title":"和持国谢见招游湖二首 其一","author":"范纯仁","text":"乐天向老占青蛾，裴令高年欲听歌。\n拟假红妆助欢醉，莫嫌宾主白髯多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和持国谢见招游湖二首 其二","author":"范纯仁","text":"白傅归来西洛宅，裴公居在永丰坊。\n好歌愧乏牛家妓，不见淳于醉后狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李徽之正议","author":"范纯仁","text":"致主唯将盛德临，世推文定总朝簪。\n先门自昔蒙知早，开阁当时用意深。\n功业所存皆国计，忠贤有后见天心。\n冢卿耆德承家庆，福寿康宁映古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过洛谒文潞公游东田","author":"范纯仁","text":"东田不到几经年，孙阁重登荷眷怜。\n清世莫尊唯尚父，朱颜难老是真仙。\n四朝弼亮繄贤业，八表升平赖化权。\n门馆旧生弥幸会，再陪几杖向林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送滕达道龙图交代归阙","author":"范纯仁","text":"三纪分携念友生，天涯相见眼重明。\n诏恩幸忝交承契，尊酒聊伸故旧情。\n我守塞垣华发短，君归乡国锦衣荣。\n何时共老江湖去，鸡黍相过乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晴思西湖寄韩少师","author":"范纯仁","text":"楼阁参差霜叶红，湖光秋色画图中。\n移船影动波心月，横笛声随水面风。\n当日席间先醉客，如今塞上独衰翁。\n思君情绪兼归兴，暗逐汾川日夜东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄西京留守韩玉汝","author":"范纯仁","text":"四朝出处久亲依，共上青云更复谁。\n里室相邻同晏卜，庙堂曾忝奉萧规。\n恩荣过分知难报，忧患频经觉早衰。\n一意待公还宰席，放归箕颍养癃疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日游西山开化归会柳溪示程宪","author":"范纯仁","text":"登高观稼适同时，宾从喧阗逐隼旗。\n殿阁崔巍初日照，林峦萧索晓风吹。\n山空笳鼓穿云响，径险车徒出谷迟。\n坐阻车公归兴速，却寻黄菊醉西池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王定国","author":"范纯仁","text":"守麾犹得长诸侯，全晋提封二十州。\n画角悠扬高戍晚，黄榆摇落故关秋。\n防边战士多乡思，并塞胡儿学汉讴。\n早晚罢兵容请老，邀君同醉潩湖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬程定塞提刑","author":"范纯仁","text":"衰疲敢惮守边州，老去光阴似水流。\n塞马春深无苜蓿，田家雪足望麳麰。\n清笳只解添乡思，白酒聊堪解客愁。\n独喜平刑贤使者，能将德庆绍箕裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读老杜忆弟诗寄二弟","author":"范纯仁","text":"昔贤遇乱多分散，我汝逢时各宦游。\n乃信人生欢聚少，安危俱不免离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄二弟","author":"范纯仁","text":"宦名驱役费光阴，寒暑忧劳昼夜侵。\n多病形骸衰易感，无涯思虑老难禁。\n离群终日嗟予季，聚首何时获我心。\n精力已疲恩未报，怀归体国念俱深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎文潞公再谢重事归洛","author":"范纯仁","text":"河阳洛下春游盛，两处风光属一家。\n不独都人瞻几杖，笑迎唯有满城花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送潞公游河阳河清","author":"范纯仁","text":"安车乘兴赏春妍，荣盛欢康世莫肩。\n旧舍讼棠重蔽芾，昔游昼锦复蝉联。\n子孙拥节迎家府，稚艾争途看寿仙。\n堪叹三川疲病守，陪公不及望公还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛花已开报潞公","author":"范纯仁","text":"花开朝夕望车尘，花意慇勤恰似人。\n晴日暖风催更急，看看开遍洛阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠蕲簟与潞公二首 其一","author":"范纯仁","text":"双文封卷如筒小，六月铺张满榻寒。\n曾是吐茵狂醉客，敢尘斋閤助清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠蕲簟与潞公二首 其二","author":"范纯仁","text":"凉簟资公逃暑用，东池应伴渌波寒。\n高眠宜享华胥乐，曾致皇家奠枕安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中寄太原韩玉汝","author":"范纯仁","text":"弱柳何由羡老松，衰姿劲节本难同。\n河南羸卧漳滨叟，塞北鹰扬渭上翁。\n多病未能谋早退，壮猷方看策元功。\n幸公再致唐虞化，庶托馀生寿域中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵持国谢送酒","author":"范纯仁","text":"重九思公向洛阳，三秋此日念何长。\n心随白酒聊相寄，头插黄花想共尝。\n盈幅忽惭琼玖报，开尊应伴绮罗香。\n明年花好能来否，元老同期醉寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门秋日上潞公二首 其一","author":"范纯仁","text":"龙门秋色胜春时，新霁登临景更奇。\n二室峰峦侵碧汉，两涯楼殿照清伊。\n鸣泉乱泻香山道，翠柏深藏白傅祠。\n独恨不能陪杖屦，思公空作寄公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门秋日上潞公二首 其二","author":"范纯仁","text":"郊原经雨绝纤尘，短麦蒙茸盖垄新。\n霜叶妆林成锦段，溪风吹水作龙鳞。\n秋山苍翠浓如画，晴日鲜明暖似春。\n遍叩禅关止三宿，犹惭高退自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三弟得告来见省","author":"范纯仁","text":"一门遭遇世应稀，诏许寻兄荷主慈。\n屈指共惊游宦久，差肩却想事亲时。\n惭卿才识加昏耗，嗟季情怀畏别离。\n报国尔曹心尚壮，无能唯我复先衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜弟妹相聚","author":"范纯仁","text":"宦游离索每相望，弟妹俱来喜莫量。\n言笑从容忘世味，盘筵简率任家常。\n清朝幸免鸰原急，白首欣逢雁序长。\n安得身閒归里社，一尊共醉乐时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题潞公翰墨卷后","author":"范纯仁","text":"四朝勋业载旂常，九十精神正寿康。\n燕翼自当传百世，岂徒书法付诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昔帅环庆为部将所讼冯君学士被制鞠狱而获平反今相遇于洛","author":"范纯仁","text":"忠臣守正不谋身，处己虽危道益尊。\n直为冕旒宣圣训，岂唯囹圄被宽恩。\n阴功自可资耆寿，馀庆犹当见子孙。\n徒有爱贤无所达，行将归老愧难论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬持国携具见访之作","author":"范纯仁","text":"两家契义世难伦，老去相逢意愈亲。\n衰暗岂能宣上化，高闲空惜致尧人。\n论交白社逾三纪，接武黄扉近十春。\n终日追陪何所乐，从容言笑尽天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘公舒相访二首 其一","author":"范纯仁","text":"嘉宾嘉景喜相陪，况有良朋冒雪来。\n湖涨碧波三十顷，枝妆玉蓓万千枚。\n白头道旧情难尽，渌酒相期醉几回。\n衰暮若非君顾我，平生怀抱向谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘公舒相访二首 其二","author":"范纯仁","text":"上庠英妙已相陪，随计观光亦并来。\n给札偶容亲砚席，抡才同是中条枚。\n他年阔别常千里，此地过从只两回。\n衰病从来游宴少，为君尊酒喜频开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到汉东和张伯常六首 其一","author":"范纯仁","text":"道义相期久益芳，忘年敦契自南阳。\n荣公三乐今谁似，李白千篇敏异常。\n愿见却须烦枉驾，奉欢先已辟东堂。\n故情新约知无改，松柏从来耐雪霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到汉东和张伯常六首 其二","author":"范纯仁","text":"宠荣踰分自颠跻，珍重高人早拂衣。\n山郡经时无好客，铃斋终日敞閒扉。\n琼瑶获报欣情重，酒醴将诚愧物微。\n道义充盈文笔健，应容残朽再亲依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到汉东和张伯常六首 其三","author":"范纯仁","text":"思君日日上高楼，心逐西南汉水流。\n侧听车音常有待，互酬诗兴未能休。\n高阳簪履成陈迹，西洛衣冠散旧游。\n独有地仙年八十，逍遥林下笑公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到汉东和张伯常六首 其四","author":"范纯仁","text":"浮名驱逐阻音尘，一别伊川十二春。\n顾我衰残如槁木，羡公眉寿若灵椿。\n寒梅乍吐香尤馥，白酒新篘味颇醇。\n对景便思同一醉，都忘衰病在漳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到汉东和张伯常六首 其五","author":"范纯仁","text":"高标早与利名疏，独向先门肯曳裾。\n举眼正无羁客伴，解颜频喜故人书。\n相期消息应端的，久别情怀待展舒。\n闻说山城春色早，安车乘兴莫徐徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到汉东和张伯常六首 其六","author":"范纯仁","text":"诗筒相续到随城，练句挥毫老益精。\n尺素屡兼双鲤赠，一言相诺百金轻。\n酒思佳客忘怀饮，梅吐新香扑鼻清。\n但得安车寻旧约，敢施行马待先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其一","author":"范纯仁","text":"舜孝高千古，尧仁化万方。\n睿文超圣域，神武振皇纲。\n典册辞徽号，山河复旧疆。\n玉舆悲晚驾，陵路柏苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其二","author":"范纯仁","text":"应运千龄契，持盈七闰间。\n当年叨法从，终日奉威颜。\n凤辇知何往，龙髯杳莫攀。\n深恩无路报，恸哭向桥山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其三","author":"范纯仁","text":"紫塞持戎节，青蒲职谏垣。\n囊封矜朴直，牍背辨深冤。\n终赖重瞳顾，难忘再造恩。\n微躯如获殉，黄鸟不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其四","author":"范纯仁","text":"祖祭连驰道，宸仪出殡宫。\n旌幡萦晓露，笳鼓咽悲风。\n雨泣千官送，云奔万国同。\n丹心随笼水，先到裕陵东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈圣光献皇后挽词二首 其一","author":"范纯仁","text":"帝图绵永合无涯，天降真人动鲁沙。\n两奉离明来继业，久膺舜养似重华。\n徽音远过周文母，俭德深惩汉外家。\n仙仗忽遥灵寝闭，悲风空引戟幡斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈圣光献皇后挽词二首 其二","author":"范纯仁","text":"画梁归燕拂轻埃，庆寿宫花亦盛开。\n平日仙踪何处觅，今年春色为谁来。\n寝门永隔慈孙问，陵路俄瞻吉仗回。\n圣主孝思刑四海，千秋万载咏烝哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富相公挽词五首 其一","author":"范纯仁","text":"河岳神灵降，唐虞景运开。\n致君优圣域，跻俗在春台。\n天上台星坼，人间梁木摧。\n霜风咽笳鼓，断续送馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富相公挽词五首 其二","author":"范纯仁","text":"二纪经纶业，三朝翊戴勋。\n忘身裨庶政，忧国见遗文。\n东閤散群彦，北邙归大坟。\n邦人仰旟旐，洒泪向寒云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富相公挽词五首 其三","author":"范纯仁","text":"千龄遭际盛，五福始终全。\n还政周星纪，怀忠入夜泉。\n华夷思旧德，河洛绕新阡。\n空有云亡叹，何由止逝川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富相公挽词五首 其四","author":"范纯仁","text":"皇天不慭遗，圣制极哀荣。\n辽海千年去，明堂一柱倾。\n赤松违素志，白日闭佳城。\n康济无穷事，皆为后世程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富相公挽词五首 其五","author":"范纯仁","text":"北走单车驯猰貐，东徂万室活饥羸。\n谋深先帝承祧日，功在仁皇与子时。\n英气不随钟漏尽，高名长与日星垂。\n登龙孤客怀知遇，恸哭秋原欲诉谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安州张大卿挽词三首 其一","author":"范纯仁","text":"廉良汉循吏，清简晋名臣。\n五福归休日，三朝尽瘁身。\n潜心穷圣典，遗德化乡人。\n燕翼看贤嗣，才名服搢绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安州张大卿挽词三首 其二","author":"范纯仁","text":"瞻风从汉上，托庇在襄城。\n开豁心相照，推扬义不轻。\n俄嗟黄壤隔，莫展素车情。\n空望涓溪月，淋浪涕泗横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安州张大卿挽词三首 其三","author":"范纯仁","text":"寒风咽笳鼓，晓月带旌幡。\n触目伤陈迹，书绅记绪言。\n应山藏石椁，梦泽对松门。\n逝水何由止，清名后世存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张益孺学士挽词二首 其一","author":"范纯仁","text":"儒业高群彦，词场第一流。\n能声喧幕府，稳步到瀛洲。\n昼绣临乡郡，纡朱葬旧丘。\n他年文苑传，应有盛名留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张益孺学士挽词二首 其二","author":"范纯仁","text":"官曹曾共职，友益赖多闻。\n信道甘违俗，同心独有君。\n漳滨俄感疾，泉下忽脩文。\n致主平生志，萧条掩一坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢师厚挽词三首 其一","author":"范纯仁","text":"妙年辞笔已惊人，不谓明时阻致君。\n白首郎中归白水，青衿弟子到青云。\n渊明雅有归田兴，贾傅空留吊屈文。\n千载定应无孔孟，一言谁为诔孤坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢师厚挽词三首 其二","author":"范纯仁","text":"天地钟奇秀，公应为世生。\n何悭一老遗，遽夺万人英。\n千古长赍恨，重泉不掩名。\n缪当幽穸志，深愧色丝铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢师厚挽词三首 其三","author":"范纯仁","text":"侍行游邓学，才喜识荆州。\n一顾蒙青眼，相知到白头。\n坤维同谪后，星纪等閒周。\n不意终天别，交颐涕不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王安之朝议挽词三首 其一","author":"范纯仁","text":"行己无瑕玷，终身乐太平。\n人间五福备，宦亚九卿荣。\n冠盖传风范，乡关忆老成。\n幽窀穷厚地，不掩是清名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王安之朝议挽词三首 其二","author":"范纯仁","text":"族望高全蜀，交游华众贤。\n退身将一纪，遗德满二川。\n雅道何人继，家声有子传。\n为文惭幼妇，谬诺志新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王安之朝议挽词三首 其三","author":"范纯仁","text":"多难求分务，相依得古人。\n道心閒里契，友分老来亲。\n不谓终天别，才离一月新。\n无由瞻几杖，洒泪向秋旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"程明道挽词三首 其一","author":"范纯仁","text":"綵衣方养志，谏省遽翘英。\n短命嗟颜子，长星丧孔明。\n临津失舟楫，支厦阙梁楹。\n名节同伊水，滔滔万古清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"程明道挽词三首 其二","author":"范纯仁","text":"天乎丧吾道，命矣叹斯人。\n后学隳梁木，明时夺国珍。\n孔怀存爱弟，皓首奈慈亲。\n唯有延陵志，斯文久愈新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"程明道挽词三首 其三","author":"范纯仁","text":"素忝金兰契，情由道义亲。\n圣时方际遇，英气忽沈沦。\n琴在无钟子，斤存失郢人。\n遥闻归葬日，清泪满衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马温公挽词三首 其一","author":"范纯仁","text":"精诚皎白日，利泽涨沧溟。\n志苦生灵乐，身劳社稷宁。\n人间失轩鉴，天上坼台星。\n唯有真儒效，长留简册青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马温公挽词三首 其二","author":"范纯仁","text":"竟因劳瘁没，谁翊太平基。\n哀讣惊朝听，严禋罢庆仪。\n梁摧大厦日，舟失济川时。\n千古商岩畔，应陪傅说祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马温公挽词三首 其三","author":"范纯仁","text":"两宫思旧德，异礼贲忠魂。\n翠辇亲临后，蝉冠锡命尊。\n霜风咽笳鼓，寒日惨旌幡。\n不独知心客，徘徊哭寝门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毌清臣中散挽词三首 其一","author":"范纯仁","text":"先府西征日，高贤进谒时。\n骅骝神异骨，丹凤羽毛奇。\n外计留关决，中朝失表仪。\n济时才不展，已有令名垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毌清臣中散挽词三首 其二","author":"范纯仁","text":"奉使频联职，宽条喜共颁。\n蒹葭倚白玉，培塿对高山。\n勇退输先识，荣归得早閒。\n塞垣闻讣日，感旧涕潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毌清臣中散挽词三首 其三","author":"范纯仁","text":"乡里尊耆德，朝廷重老成。\n铜符辞宠命，琳馆遂高情。\n天下三尊盛，人间五福荣。\n岂唯身独享，有子绍家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卢通议挽词三首 其一","author":"范纯仁","text":"耆旧今多少，唯公景德人。\n家邻吴市卒，名重汉廷臣。\n路在犹耕月，门閒似送春。\n空堂馀画像，彷佛旧精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]