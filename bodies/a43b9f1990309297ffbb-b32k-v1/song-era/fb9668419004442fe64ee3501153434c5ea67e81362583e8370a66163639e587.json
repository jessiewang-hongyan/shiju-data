[{"title":"和人乞朱樱十首 其八","author":"廖行之","text":"族派蟠桃谱牒存，三千历岁物难群。\n黠儿尚许三偷摘，可是年年不见分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其七","author":"廖行之","text":"旧闻云梦泽边城，饱饫林间主不嗔。\n薄暮一鞭飞骑迅，归来盈袖熟红匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其六","author":"廖行之","text":"那须得得列杯盘，不念贫儿逐弹丸。\n齿颊犹能识珍味，乞渠细咀辨甘酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其五","author":"廖行之","text":"侯门珍膳诧猩唇，肉食愚哉鄙若人。\n安得赪珠洗荤浊，骊龙方寐讵非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其四","author":"廖行之","text":"浮沉闲却紫玻璃，洗盏丁宁已戒儿。\n会见金盘红万颗，为君痛饮倒酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其三","author":"廖行之","text":"当年上苑得殊观，尔许匀圆讶走盘。\n容易香山白居士，漫同樊素等闲看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其二","author":"廖行之","text":"桃李从渠著斗量，明珠颗颗更含香。\n红颜不老如丹渥，笑诧南翁见未尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其一","author":"廖行之","text":"见说朱樱正及时，眼穿火齐晓云披。\n筠笼走送还能否，好带朝霜摘几枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马茂先净因阁中所题","author":"廖行之","text":"纷纷红紫泄天机，已是山城春半时。\n顾我逢花须泥饮，高情难许俗人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周少晰咏梅韵五首 其五","author":"廖行之","text":"弱植卑丛冻易摧，百花谁伴雪花开。\n如今最识春先处，红紫纷纷亦漫栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周少晰咏梅韵五首 其四","author":"廖行之","text":"天姿不解入时妆，缀佩联琼特地芳。\n几日东风回陇首，却教群卉羡天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周少晰咏梅韵五首 其三","author":"廖行之","text":"银色诸天渺不穷，森罗万象匪磨镕。\n眼明的历南枝好，绝胜瑶台月下逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周少晰咏梅韵五首 其二","author":"廖行之","text":"太息凋年雨木冰，岁寒心事属何人。\n携筇试绕墙边树，喜见琼林第一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周少晰咏梅韵五首 其一","author":"廖行之","text":"孤根应得暖先回，天惜花房遣护开。\n早是冰肌自清绝，却因冠玉更奇瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和咏莺","author":"廖行之","text":"雅正馀音隐小成，咿哇嘈囐彼何荣。\n数声睆彼迁乔语，一洗纷纷百口鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗秀才惠诗七首 其七","author":"廖行之","text":"有道如君方杜门，无能惭我亦乘轩。\n慇勤好在经纶学，早晚亲承雨露恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗秀才惠诗七首 其六","author":"廖行之","text":"藉甚家声杜小冠，公侯衮衮照门阑。\n培风小作湖山隐，九万扶摇正好看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗秀才惠诗七首 其五","author":"廖行之","text":"平生南岳望重湖，烟霭苍茫认有无。\n可是能来访苗俗，祇今风化已唐虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗秀才惠诗七首 其四","author":"廖行之","text":"千户侯封有国权，裁能姜韭当畦千。\n如今谁是凄凉尉，却有新诗可手编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗秀才惠诗七首 其三","author":"廖行之","text":"正学心端不论材，吁嗟媒禄漫梯阶。\n岁寒万木多摧折，凛凛乔松不可埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗秀才惠诗七首 其二","author":"廖行之","text":"吾祖元丰一桂枝，百年门户尚馀辉。\n箕裘敢说韦平事，且学宽饶衣短衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗秀才惠诗七首 其一","author":"廖行之","text":"五世儒冠愧甲门，沧浪何意濯尘缨。\n不嫌山鬼揶揄笑，宁得齐儿舒缓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和松坡刘迂诗二首 其二","author":"廖行之","text":"碌碌随人未足旌，折腰趋走太清生。\n绝怜抗直陈公子，晚欲凭书入帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和松坡刘迂诗二首 其一","author":"廖行之","text":"秋来吾亦爱吾庐，松菊交情未省疏。\n底逐风埃轻去鲁，尚馀客气欠消除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望雪梅五首 其五","author":"廖行之","text":"水精宫阙偏宜汝，铁石心肠肯受欺。\n应笑蜡梅犹族姓，祇堪薪槱荐晨炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望雪梅五首 其四","author":"廖行之","text":"腊残春到无多日，留得清芬伴颂椒。\n却放东风吹冻裂，遣渠堤柳又新条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望雪梅五首 其三","author":"廖行之","text":"刺火艺兰能九畹，白衣访菊亦东篱。\n君诗唤起西湖老，好处何惭幼妇碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望雪梅五首 其二","author":"廖行之","text":"自是阳和生处有，不同凡卉竞时开。\n居然茹雪犹全节，底为藏冰但却灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望雪梅五首 其一","author":"廖行之","text":"雪里最怜梅破萼，花时那负岁寒心。\n不因王子聊乘兴，争得林逋为赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望催梅三首 其三","author":"廖行之","text":"丝丝弱柳犹迎岁，点点飞霙亦饯年。\n可是清高厌纷竞，百花那许著鞭先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望催梅三首 其二","author":"廖行之","text":"准拟花前玉斝飞，那知辜负隔年期。\n枝头未报春来信，閒却西湖处士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望催梅三首 其一","author":"廖行之","text":"长羡南枝笑北枝，东风能早亦能迟。\n而今满树浑无那，管领春光更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和送春四首 其四","author":"廖行之","text":"匆匆春驭去何忙，挽系难凭柳线长。\n好著新晴送行色，莫教风雨漫彷徨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和送春四首 其三","author":"廖行之","text":"晼晚春光作意归，送春谁把酒樽携。\n多情风雨留连处，几看霖霪到日西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和送春四首 其二","author":"廖行之","text":"三月春工倦欲归，花神应约手同携。\n明年早赴东郊迓，未论渠侬南北西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和送春四首 其一","author":"廖行之","text":"潇湘江上送春归，酒榼何人共我携。\n不是吾侬怨春别，明朝车马各东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和食蕨三首 其三","author":"廖行之","text":"不须态掌夸珍膳，安用鸡趺快嗜情。\n富有漫山千臂指，何妨采撷日充盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和食蕨三首 其二","author":"廖行之","text":"根荄蔓衍布山巅，一夕春雷引怒拳。\n足我穷中八珍味，竹萌木耳更求旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和食蕨三首 其一","author":"廖行之","text":"放箸朝来颇不贫，野盘春蕨正宜人。\n玉条缕缕东风软，惭愧山家为荐新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和真珠花二首 其二","author":"廖行之","text":"累累璎珞作新装，万蘤匀开细细香。\n好是花时最清绝，月明珠露夜初长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和真珠花二首 其一","author":"廖行之","text":"琼林玉女职司花，装缀珠玑泣露华。\n妙手有神俄点化，灵根何日下天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和惜香红二首 其二","author":"廖行之","text":"韬藏馥郁保天真，珍重芳姿肯殢人。\n莫道清高便无韵，春来谁是解全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和惜香红二首 其一","author":"廖行之","text":"花神那作世间香，狂蝶游蜂暗断肠。\n不是朱颜向人吝，耻随桃李倚门墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和清明后即事","author":"廖行之","text":"柳阴嫩绿藏莺语，花径馀香著燕泥。\n南亩十分农事好，平畴野水称耕犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和清明前即事三首 其三","author":"廖行之","text":"雨歇花畦径未乾，春衣初试觉轻寒。\n所欣节物能多好，祓禊临流江不澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和清明前即事三首 其二","author":"廖行之","text":"漫山百卉效奇珍，尤喜原头雀舌新。\n不待清明改泉火，撷芳收取最先春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和清明前即事三首 其一","author":"廖行之","text":"乍雨还晴近禁烟，踏青人憩楚江边。\n花枝处处争妍媚，妆点春光二月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜梦得一句云老树拜风窗影乱因伸其语为一绝","author":"廖行之","text":"梦魂栩栩尘缘扫，风拜月窗春树老。\n一枕惊回得句时，清奇未逊池塘草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩易斋 其二","author":"廖行之","text":"作者亦何患，思深义亦深。\n忘言更忘象，默会古人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩易斋 其一","author":"廖行之","text":"三椽函宇宙，一卷肇乾坤。\n深味画前意，宁于纸上论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中惜海棠花四首 其四","author":"廖行之","text":"费尽胭脂画不妍，春心一缕褪唇嫣。\n雨中似是花神意，犹作西来旧蜀天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中惜海棠花四首 其三","author":"廖行之","text":"谁恨花枝苦未妍，故将雨熟醉颜嫣。\n禁寒来把芳丝吐，会向和风放暖天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中惜海棠花四首 其二","author":"廖行之","text":"点缀春容特地妍，艳妆金缕脸霞嫣。\n无端风雨妒颜色，半吐芳心向晚天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中惜海棠花四首 其一","author":"廖行之","text":"东君何事妒花妍，不遣春风一笑嫣。\n邀动芳心愁万缕，盈盈含恨雨中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚雨中","author":"廖行之","text":"绿杨庭院雨如丝，已是梅林欲熟时。\n惭愧春工起归兴，向来节物彼何知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈必强赴宜春理官掾三绝 其二","author":"廖行之","text":"君向春台好宦游，刑清今已狱无囚。\n会闻宽恕求黄霸，肯复公卿惭太丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈必强赴宜春理官掾三绝 其一","author":"廖行之","text":"万顷烟光入客舟，不堪风雨扰离愁。\n慇勤小伫江头话，试问垂杨可系不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈必强赴宜春理官掾三绝 其三","author":"廖行之","text":"三年同此日追游，樽酒相欢几献酬。\n别后临风重凝想，湘云东去是袁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其九","author":"廖行之","text":"见说龙门不可攀，自惊容易得承颜。\n从今洗眼湘江上，看取功成鬓未斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其八","author":"廖行之","text":"稔见银河派里人，眼高馀子似纷纷。\n君今绰有前风烈，愿振家声稔旧闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其七","author":"廖行之","text":"从来唐治数开元，百辟谁知产乱原。\n惟有曲江金鉴在，从昆能不效忠言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其六","author":"廖行之","text":"衮衮诸公竞朵颐，具文天亦厌谩欺。\n啬夫不拜非难事，会有公车访释之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其五","author":"廖行之","text":"扶持根本恃纲维，叹息论功到鼓鼙。\n蠢蠢潢池皆赤子，埋轮何必问狐狸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其四","author":"廖行之","text":"湘俗湘人自戚休，亲民谁复念承流。\n公归若也嫌名迹，论奏何由达冕旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其三","author":"廖行之","text":"江海无忘魏阙思，不妨身佩国安危。\n太平基业须贤辅，政赖君王用及时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其二","author":"廖行之","text":"灼灼声华简帝聪，得君元不藉先容。\n趣装已就朝天路，行有新除下九重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南张仓解官还建昌九首 其一","author":"廖行之","text":"一节三湘两载留，高怀宁羡子公谋。\n由来奇士为时用，未信林泉得久游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九前二日夜雨","author":"廖行之","text":"去去重阳越夕间，潇潇风雨作轻寒。\n心知又负登高兴，篱菊留来过后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读浮休诗有感","author":"廖行之","text":"二十年间儿女諠，糟糠勤苦不堪论。\n如今八载君身后，儿已登科又长孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅","author":"廖行之","text":"江北江南入夏来，云蒸日煦欲黄梅。\n邸居兀坐关山隔，空想微酸到齿隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦","author":"廖行之","text":"家山归梦恍悠然，小阁逢迎尚世缘。\n惊觉邻鸡号月曙，不堪攲枕小窗前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花 其三","author":"廖行之","text":"芳心都付蜜纷披，薄恨狂蜂有底知。\n红雨一番春事罢，绿阴谁把酒杯持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花 其二","author":"廖行之","text":"花枝春老不禁寒，一夕狂风到画栏。\n飞尽繁红委苔径，明朝犹作锦茵看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花 其一","author":"廖行之","text":"春深处处有花妍，已觉春工兴浩然。\n投晓凭栏枝上看，飘零赢得舞容翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溽暑中一雨遂翛然枕上口占喜凉","author":"廖行之","text":"枕簟翛然夜气舒，烦蒸无复到襟裾。\n慇勤多谢天公意，一雨生凉足有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴四首 其四","author":"廖行之","text":"一生俱有分，万事要无心。\n强聒诚行险，危哉安可禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴四首 其三","author":"廖行之","text":"无客共谈道，有谁能赏心。\n人生要自得，穷困吾能禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴四首 其二","author":"廖行之","text":"穷达渠非命，机关不到心。\n新诗聊自遣，高兴若为禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]