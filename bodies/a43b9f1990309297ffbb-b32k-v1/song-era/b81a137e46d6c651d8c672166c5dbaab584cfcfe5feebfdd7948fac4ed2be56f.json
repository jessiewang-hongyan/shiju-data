[{"title":"奉寄子由","author":"黄大临","text":"钟鼎功名淹管库，朝廷翰墨写风烟。\n遥知道院颇岑寂，定是壶中第几天。\n历下笑谈漫一梦，江南消息又馀年。\n动心忍性非无意，吏部如今信大颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题哥罗驿竹枝词","author":"黄大临","text":"尺五攀天天惨颜，盐烟溪瘴锁诸蛮。\n平生梦亦未尝处，闻有鸦飞不到山。\n风黑马嘶驴瘦岭，日黄人度鬼门关。\n黔南此去无多远，想在夕阳猿啸间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别","author":"黄大临","text":"桄榔笋白映玉箸，椰子酒清宜具觞。\n市井衣裘半夷夏，阴晴朝暮变炎凉。\n莫推月色共千里，不寄江南书一行。\n无赖笳声上云汉，晓来偏绕九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"黄大临","text":"南山占相去，方石为谁存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"黄大临","text":"虎子养溪鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"黄大临","text":"急雪鹡鸰相并影，惊风鸿雁不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北窗","author":"黄庭坚","text":"生物趋功日夜流，园林才夏麦先秋。\n绿阴黄鸟北窗簟，付与来禽安石榴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谪居黔南十首 其八","author":"黄庭坚","text":"苦雨初入梅，瘴云稍含毒。\n泥秧水畦稻，灰种畬田粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谪居黔南十首 其十","author":"黄庭坚","text":"病人多梦医，囚人多梦赦。\n如何春来梦，合眼在乡社。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起荆江亭即事十首 其八","author":"黄庭坚","text":"闭门觅句陈无己，对客挥毫秦少游。\n正字不知温饱未，西风吹泪古藤州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和七兄山蓣汤","author":"黄庭坚","text":"厨人清晓献琼糜，正是相如酒渴时。\n能解饥寒胜汤饼，略无风味笑蹲鸱。\n打窗急雨知然鼎，乱眼晴云看上匙。\n已觉尘生双井椀，浊醪从此不须持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杜仲观二绝 其一","author":"黄庭坚","text":"鸟啼花动却春寒，雨压青旗卷画干。\n多事今年废诗酒，烦君传语问平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杜仲观二绝 其二","author":"黄庭坚","text":"重帘复幕和风雨，无奈催沽鸟唤人。\n只是樽前欠狂客，舞娃冰雪酒磷磷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠益阳成之主簿 其二","author":"黄庭坚","text":"人间卿相何足道，胸次诗书要不忘。\n男儿邂逅起屠钓，何如林下日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"黄庭坚","text":"失枕惊先起，人家半梦中。\n闻鸡凭早晏，占斗辨西东。\n辔湿知行露，衣单觉晓风。\n秋阳弄光影，忽吐半林红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"写真自赞五首 其五","author":"黄庭坚","text":"似僧有发，似俗无尘。\n作梦中梦，见身外身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"录梦篇 其二","author":"黄庭坚","text":"乱曰：刍狗万物兮，天地不仁。\n体止而用无穷兮，播生者于迷津。\n有形而致用者之谓器，无形而用道者之谓神。\n背昭昭而起见兮，聚墨墨而生身。\n犯有形而遗大观兮，动细习于游尘。\n彼至人而神凝兮，同予梦而先觉。\n顾天下孰不学兮，乃会归于无学。\n予心之不能忘兮，将波流风靡而奈何，唯镇之以无名之朴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩诘画赞 其二","author":"黄庭坚","text":"不二法门无别路，诸方临水不敢渡。\n鹙子怕沾天女花，花前竹外是谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以香烛团茶琉璃献花碗供布袋和尚颂 其二","author":"黄庭坚","text":"弥勒真弥勒，分身千百亿。\n若问下生时，不打这鼓笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古意","author":"黄庭坚","text":"太华峰头玉井莲，开花十丈藕如船。\n冷比雪霜甘比蜜，一片入口沉痾痊。\n我欲求之不惮远，青壁无路难夤缘。\n安得长梯上摘食，下种七泽根株连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题襄阳米芾祠 其二","author":"黄庭坚","text":"万里莓苔地，不见驱驰踪。\n唯开文字窗，时写日月容。\n竹韵漫萧屑，草花徒织茸。\n披霜入众木，独自识青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题驴瘦岭马铺","author":"黄叔达","text":"老马饥嘶驴瘦岭，病人生入鬼门关。\n病人甘作五溪卧，老马犹思十二闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行次巫山宋懋宗遣骑送折花厨酝","author":"黄叔达","text":"攻许愁城终不开，青州从事斩关来。\n唤得巫山强项令，插花倾酒对阳台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵懋宗送别二首 其一","author":"黄叔达","text":"一百八盘天上路，去年明日送流人。\n小诗话别堪垂泪，却道情亲不得亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵懋宗送别二首 其二","author":"黄叔达","text":"别驾柴门闭一春，艰难颠沛不忘君。\n何时幽谷回天日，教保馀生出瘴云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏答刘文学","author":"黄叔达","text":"人鲊瓮中危万死，鬼门关外更千岑。\n问君底事向前去，要试平生铁石心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"外侄李光祖往见尚垂髫今观寄嗣直小诗已可爱因次韵","author":"黄叔达","text":"昔别长安未裹头，如今诗句可消愁。\n外家未觉风流远，他日相期到益州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上南陵坡","author":"黄叔达","text":"风餐水宿六十里，蛇退猿啼百八盘。\n上得坡来总欢喜，摩围依约见峰峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题小猿叫驿","author":"黄叔达","text":"大猿叫罢小猿啼，箐里行人白昼迷。\n恶藤牵头石齧足，妪牵儿随泪录续，我亦下行莫啼哭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上口号呈建始李令","author":"黄叔达","text":"驿亭新似眼波明，箐路开如掌样平。\n谁与长官歌美政，风摇松竹是欢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次浮塘驿见张施州小诗次其韵","author":"黄叔达","text":"叹息施州成老丑，当年玉雪瑩相照。\n旧时去天一尺五，今日万里听猿叫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将次施州先寄张十九使君三首 其一","author":"黄叔达","text":"书来日日觉情亲，今信施州是故人。\n许我投名重入社，放狂作恼未应嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将次施州先寄张十九使君三首 其二","author":"黄叔达","text":"收拾从来古锦囊，今知老将敌难当。\n囊中尚有毛锥子，花底樽前作战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将次施州先寄张十九使君三首 其三","author":"黄叔达","text":"一别施州向十霜，传闻佳句望风降。\n空弮不易当坚敌，振臂犹思起病创。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张仲谋送别二首 其一","author":"黄叔达","text":"夜郎自古流迁客，圣世初投第一人。\n不是施州肯回首，五溪三峡更谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张仲谋送别二首 其二","author":"黄叔达","text":"五溪三峡漫经春，百病千愁逢故人。\n何处看君岁寒后，欲将儿女更论亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答清江主簿赵彦成","author":"黄叔达","text":"日转溪山几百遭，厌闻虎啸与猿号。\n笙歌忽把二天酒，风雨犹惊三峡涛。\n已作齐民寻要术，安能痛饮读离骚。\n看君自是青田质，清唳犹堪彻九皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答宋懋宗寄夔州五十诗三首 其一","author":"黄叔达","text":"五十清诗是碎金，试教掷地有馀音。\n方今台阁称多士，且傍江山好处吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答宋懋宗寄夔州五十诗三首 其二","author":"黄叔达","text":"五十清诗一段冰，持来恰得慰愁生。\n自张壁间行坐看，更教儿诵醉时听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答宋懋宗寄夔州五十诗三首 其三","author":"黄叔达","text":"碑同岘首千年石，诗到夔州十绝歌。\n他日巴人怀叔子，时时解著手摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"黄叔达","text":"山头日日风和雨，行人归来石应语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题胜业寺","author":"释文政","text":"山鸟无凡音，山云无俗状。\n引得白头僧，时时倚藜杖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武昌阻风","author":"方泽","text":"江上春风留客舟，无穷归思满东流。\n与君尽日闲临水，贪看飞花忘却愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"方泽","text":"大帝仙乡列圣曹，蓬山分命镇波涛。\n瑶台影蘸天心冷，贝阙光浮海面高。\n五色灵霜浮玉籁，九清明月射金鳌。\n东方曼倩曾来此，偷折林中数颗桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斯美堂","author":"方泽","text":"丹雘鲜鲜郡郭西，檐牙高啄翠云齐。\n地形旧压重城峻，天势初围叠嶂低。\n晚市浮烟生万瓦，晓窗寒日度双溪。\n庭前更有青松路，岂似桃源使客迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"张轸","text":"山晓月初上，江鸣潮欲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"张轸","text":"不辨越王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李秉彝","text":"朋也老无能，淡如云水僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李师聃","text":"江边闲舣济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄黄鲁直","author":"释灵源","text":"昔日对面隔千里，如今万里弥相亲。\n寂寥滋味同斋粥，快恬谈谐契主宾。\n室内许谁参化女，眼中休去觅瞳人。\n东西南北难藏处，金色头陀笑转新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏月","author":"释灵源","text":"玉兔步虚碧，冰轮碾太清。\n广寒宫有路，桂子落无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书旅邸壁","author":"王谹","text":"雁外无书为客久，蛩边有梦到家多。\n画堂玉佩萦云响，不及桃源欸乃歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王谹","text":"水清居士涧，景好天王刹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江西泊舟后作","author":"李才","text":"江水冥冥沙石阴，一舸行尽春已深。\n浪花绿蔓曳锦带，短芦刺水抽玉簪。\n饥鱼未沈波面筒，小舫正横溪上风。\n清辉濯尽远山碧，白鸟飞入苍烟丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题雪窦和尚亲书偈卷","author":"徐文","text":"老子休去歇去，遗墨今传古传。\n□见本来面目，不离堂处湛然。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李康年","text":"可笑幽航载归梦，迟明身在武昌城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉笥山","author":"杨琳","text":"亭扁江西太史诗，名垂诗逸几经时。\n聿来芹泮三章古，成此花封一段奇。\n翠琰影磨峰崒嵂，英辞光动水涟漪。\n先生多少凭栏思，寄径蓬山与凤池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"杨琳","text":"涪翁句摘江山胜，赵令亭高星斗寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"杨琳","text":"宦情莫莫云生岫，诗思萧萧月满川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杨琳","text":"万叠远山青未了，一江流水意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"杨琳","text":"夜添风月无尽景，晓起烟云皆助诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"杨琳","text":"水似人清光滴眼，山随天远翠浮眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感时事作","author":"晁载之","text":"森森月里栽丹桂，历历天边种白榆。\n虽未乘槎上霄汉，会须沈网取珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭灵夫人祠","author":"晁载之","text":"杀翁分我一杯羹，龙种由来事杳冥。\n安用生儿作刘季，暮年无骨葬昭灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北郊","author":"吕大临","text":"村北硗田久废耕，试投嘉谷望秋成。\n天时地力难前料，万粒须期一粒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南溪淡真阁閒望","author":"吕大临","text":"栏外溪光溪外峰，重重平远杳连空。\n长将两眼安高处，扰扰都归俯视中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春静","author":"吕大临","text":"花气自来深户里，鸟声长在远林中。\n班班叶影垂新荫，曳曳丝光入素空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探春","author":"吕大临","text":"摇曳风头欲振枯，柳梢垂发不胜梳。\n从来轻薄才先发，谁记秋霜坠叶初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食道中","author":"吕大临","text":"漠漠云浓阴欲坠，迢迢远路马行迟。\n春风境界无边畔，花下游人恐未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓝田","author":"吕大临","text":"背负肩任几百斤，山蹊寸进仅容身。\n先难后获应如是，重愧端居饱食人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效尧夫体寄仲兄","author":"吕大临","text":"治非知务功何有，见必先几义始精。\n饭放不应论齿决，水来安可病渠成。\n高才况自当名世，大业终期至太平。\n可惜良时难再得，东山应不负苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三山阁","author":"许敦仁","text":"蓬莱方丈与瀛洲，东引长江欲尽头。\n几处坛场浑得道，万家楼阁半封侯。\n名□荔子尝三熟，负郭潮田插两收。\n七百年来遗谶事，钓台沙合瑞烟浮。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"范纯粹","text":"惯处贱贫知世态，饱谙迁谪见家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘仙岩和曹辅韵","author":"梁子美","text":"神仙灵异古今传，穷理修真本自然。\n遗址宛存疑谷口，苍崖乔木耸青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县斋 弦歌堂","author":"朱之纯","text":"洋洋百里起呕吟，惠化薰陶谷水阴。\n明月诗函三岛秀，清风曲奏一堂深。\n武城浪说言游道，单父休誇子贱音。\n政敏谁知过齐国，想君真得古人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县斋 三山亭","author":"朱之纯","text":"俗易风移古道还，县斋叠石作三山。\n因怜席上红尘少，赢得壶中白日闲。\n想见六鳌擎水下，坐看双鹤落云间。\n何须更叩黄金阙，只此幽亭是玉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县斋 艮阁","author":"朱之纯","text":"画阁峨然冠翠峦，更占艮地特巑岏。\n晓窗高揖东风暖，夜幕低垂北斗寒。\n突兀状惊青蜃吐，徘徊势若老龙蟠。\n嗟予劲节非徐子，那得陈侯一榻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]