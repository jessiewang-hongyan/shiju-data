[{"title":"感事","author":"陆游","text":"已醉猩猩犹爱屐，入秋燕燕尚争巢。\n老夫看尽人间事，欲向山僧学打包。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事四首 其四","author":"陆游","text":"扪虱当时颇自奇，功名远付十年期。\n酒浇不下胸中恨，吐向青天未必知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事四首 其三","author":"陆游","text":"渭上昼昏吹战尘，横戈慷慨欲忘身。\n东归却作渔村老，自误青春不怨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事四首 其一","author":"陆游","text":"鸡犬相闻三万里，迁都岂不有关中。\n广陵南幸雄图尽，泪眼山河夕照红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔七首 其二","author":"陆游","text":"神女祠前猿夜鸣，相公溪上草初生。\n重游惟有西窗梦，一点灯青梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔五首 其五","author":"陆游","text":"行遍天涯只漫劳，归来登览兴方豪。\n云生神禹千年穴，雪捲灵胥八月涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔七首 其六","author":"陆游","text":"老君洞外小朱扉，云压寒空雪欲飞。\n结阵弓刀边垒去，挂鞍狐兔猎场归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔七首 其四","author":"陆游","text":"小益晨装雨作泥，南沮涉水马长嘶。\n山腰细栈移新路，驿壁流尘暗旧题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔七首 其一","author":"陆游","text":"百丈庚寅上峡时，至今犹健岂前期。\n家人暗换吾何叹，镜里衰翁复是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔五首 其三","author":"陆游","text":"负琴腰剑成三友，出蜀归吴历百城。\n最是客途愁绝处，巫山庙下听猿声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔二首 其一","author":"陆游","text":"常记东园按舞时，春风一架晚蔷薇。\n尊前不展鸳鸯锦，只就残红作地衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔七首 其五","author":"陆游","text":"曾从征西十万师，白头回顾只成悲。\n云深骆谷传烽处，雪密嶓山校猎时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔五首 其二","author":"陆游","text":"马瘦行迟自一奇，溪山佳处看无遗。\n酒垆强挽人同醉，散去何曾识是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔二首 其二","author":"陆游","text":"八阵原头纵猎归，割鲜藉草酒淋漓。\n谁知此夕西窗里，一盏青灯独咏诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔五首 其一","author":"陆游","text":"行年三十忆南游，稳驾沧溟万斛舟。\n常记早秋雷雨霁，柁师指点说流求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔七首 其七","author":"陆游","text":"少时失脚利名间，寸步何曾不险艰。\n造物恐人浑忘却，梦中忧患尚如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感昔五首 其四","author":"陆游","text":"岳阳三伏正炎蒸，爽气凄风见未曾。\n白浪蹴天楼欲动，当时恨不到黄陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感物二首 其一","author":"陆游","text":"物情岂愿岁时遒，一气潜移不自由。\n日出鹁鸪还唤雨，夏初蟋蟀已吟秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感物二首 其二","author":"陆游","text":"小园清晓岸纶巾，物态年光日日新。\n绿叶自生黄自落，不应秋至始愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新作南门","author":"陆游","text":"剪棘移门不费钱，好山无数碧巉然。\n病夫愦愦真堪笑，反衣狐裘三十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新制小冠二首 其一","author":"陆游","text":"浅醉微吟独倚阑，轻云淡月不多寒。\n悠然顾影成清啸，新制栟榈二寸冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新制小冠二首 其二","author":"陆游","text":"栟榈冠子轻宜发，綀布单衣爽辟尘。\n纵不能诗亦堪画，年馀八十水云身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新养白鸡毛羽如玉殊可爱","author":"陆游","text":"赤帻峨峨玉羽明，篱间新织竹笼成。\n老人从此知昏晓，不用元戎报五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其二","author":"陆游","text":"兴来游衍不辞遥，吹帽风轻过画桥。\n猩血未看开露蕊，曲尘先已上烟条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其一","author":"陆游","text":"九陌风和不起尘，平湖冰解欲生鳞。\n往来朝暮纷如蚁，得见新春有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其四","author":"陆游","text":"忆到夔门正月初，竹枝歌舞拥肩舆。\n当时光景应如昨，绿鬓治中八十馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其六","author":"陆游","text":"玻璃江上柳如丝，行乐家家要及时。\n只怪今朝空巷出，使君人日宴蟆颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其八","author":"陆游","text":"乌藤即是碧油幢，百万天魔指顾降。\n酣枕不知霜缟瓦，下床已见日烘窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其三","author":"陆游","text":"一年最好早春天，风日初和未脱绵。\n坎坎圆鼙赛神社，翻翻小伞下湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其七","author":"陆游","text":"梁州陌上女成群，铜绿春衫罨画裙。\n相唤游家园里去，鞦韆高挂欲侵云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春感事八首终篇因以自解 其五","author":"陆游","text":"锦城旧事不堪论，回首繁华欲断魂。\n绣毂金羁三十里，至今犹梦小东门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新泉绝句二首 其一","author":"陆游","text":"扫石荫双松，岸巾穿万竹。\n尔来又一奇，岩泉寒可掬。\n?泉可瀹茗，就泉可洗药。\n楚人曾未知，但谓缨可濯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新津小宴之明日欲游修觉寺以雨不果呈范舍人二首 其二","author":"陆游","text":"新津渡头船欲开，山亭准拟把离杯。\n不如意事十八九，正用此时风雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新津小宴之明日欲游修觉寺以雨不果呈范舍人二首 其一","author":"陆游","text":"风雨长亭话别离，忍看清泪湿燕脂。\n酒光摇荡歌云暖，不似西楼夜宴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋","author":"陆游","text":"短鬓萧萧失旧青，此身已看作邮亭。\n新秋无限凄凉意，尽付风蝉与露萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋以窗里人将老门前树欲秋为韵作小诗十首 其七","author":"陆游","text":"唐虞虽已远，至道岂无传。\n度日一编里，怀人千载前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋以窗里人将老门前树欲秋为韵作小诗十首 其五","author":"陆游","text":"立朝绍兴间，犹及见诸老。\n魂梦不可逢，丘坟闭秋草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dyna