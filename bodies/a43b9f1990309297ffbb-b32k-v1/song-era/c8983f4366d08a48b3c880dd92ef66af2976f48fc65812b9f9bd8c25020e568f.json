[{"title":"望夫山","author":"邓剡","text":"朝望夫，暮望夫，一夕化作山石枯。\n潮水去却回，行人来不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑夕","author":"邓剡","text":"暑夕不能寐，起坐林间亭。\n齧鼠欺黑月，流萤乱飞星。\n星河光淡泊，不辨草树青。\n泥泥凉露下，稍稍残梦醒。\n幽虫故儿女，私语如相应。\n邻钟自何来，迢迢入孤听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简寂观","author":"邓剡","text":"一径两山合，迢迢入空青。\n前横交剑流，后倚叠云屏。\n平生三笑图，此日丹元庭。\n双瀑隐如画，可玩不可听。\n东瀑更飘洒，珠玑落青冥。\n丹井久湮芜，蜕骨何由灵。\n何年老鹤归，松桧语丁宁。\n苦竹不肯笋，知此味甘馨。\n秋深石坛冷，液液枕参横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙山钟","author":"邓剡","text":"丰山背后钟，霜月平原定。\n夜半响鲸音，隐隐天地应。\n山灵鹤梦醒，独听还独咏。\n萧萧蓬蒿中，收入杜陵径。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪","author":"邓剡","text":"行不得也哥哥。\n瘦妻弱子羸牸驮，天长地阔多网罗。\n南音渐少北音多，肉飞不起可奈何。\n行不得也哥哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 寿胡存齐","author":"邓剡","text":"笑钗符、恰正带宜男。\n还将寿花簪。\n早风薰竹醉，松凉鹤健，午坐存庵。\n三十六峰玉立，隔麈听玄谈。\n何似人难老，三十才三。\n闻得天边好语，第一流人物，偏重江南。\n满玻璃春绿，十载爱棠甘。\n青青鬓、尽堪图画，趁紫岩、年纪作枢参。\n却归宴、瑶池未晚，荷日红酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 寿周耐轩府尹","author":"邓剡","text":"步凉飔绿野，□钟鼓、□园林。\n有骑竹更生，扶藜未老，歌舞棠阴。\n金鞭半横玉带，烨神人、风度五云深。\n大耐自应鹤骨，活人总是天心。\n寿蒲香晚尚堪斟。\n梧竹对潇森。\n早问道燕城，衣裁绣衮，台筑黄金。\n天瓢正消几滴，化中原、焦土作甘霖。\n却伴赤松未晚，碧桃花下横琴。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 寿刘须溪","author":"邓剡","text":"桃脸破初寒，笑问刘郎前度。\n为说贞元朝上，缥缈年桥午。\n百年方半日来多，且醉且吟去。\n须信剑南万首，胜侯封千户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步月 其一","author":"邓剡","text":"皓月流华光，微霄暧虚碧。\n空庭四无人，及此美□夕。\n霏微弄香雾，淡荡舒玉色。\n离离花影斜，梢梢兰露滴。\n颓然意忘倦，欲起还自惜。\n春情谅难得，后夜空相忆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步月 其二","author":"邓剡","text":"盈盈当春月，含情隔幽棂。\n好怀不自制，起坐可一庭。\n娟娟吐微云，迢迢映华星。\n不寝步芳阴，裴回惜娉娉。\n百虫未敢怨，卉木正葱青。\n馀光散草露，乃复似秋萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摊破南乡子 寿孟万户","author":"邓剡","text":"睡起怯春寒。\n海棠花、开未开间。\n莫言春色三分二，朱颜绿鬓，栽花种竹，谁似君闲。\n侯印旧家毡。\n早天边、飞诏催还。\n从今岁岁称觞处，人如玉雪，花如锦绣，福寿如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐多令","author":"邓剡","text":"雨过水明霞。\n潮回岸带沙。\n叶声寒、飞透窗纱。\n堪恨西风吹世换，更吹我、落天涯。\n寂寞古豪华。\n乌衣日又斜。\n说兴亡、燕入谁家。\n惟有南来无数雁，和明月、宿芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"邓剡","text":"疏雨洗天晴。\n枕簟凉生。\n井梧一叶做秋声。\n谁念客身轻似叶，千里飘零。\n梦断古台城。\n月淡潮平。\n便须携酒访新亭。\n不见当时王谢宅，烟草青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红 雪楼得次子，行台时治金陵","author":"邓剡","text":"郢雪歌高，天教鹤子参鸣和。\n薰风旌节瑞华□，光动垂弧左。\n早是烟楼撞破。\n更明珠、重添一颗。\n镜容中夜，摩顶欣然，石麟天堕。\n未羡眉山，两峰儿子中峰我。\n推贤世世珥金貂，何况阴功大。\n欲写弄獐书贺。\n愧无功、难消玉果。\n摩挲老眼，曾识英雄，试啼则个。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疏影 笋薄之平江","author":"邓剡","text":"瑶尊蘸翠。\n短长亭送别，风恋晴袂。\n腊树迎春，一路清寒，能消几日羁思。\n霜华不惜阳关柳，悄莫系、行人嘶骑。\n对梅花、一笑分携，胜约别来相寄。\n人物仙蓬妙韵，瑞鸾敛迅翼，聊憩香枳。\n见说使君，好语先传，付与芙蓉清致。\n客来欲问荆州事，但细语、岳阳楼记。\n梦故人、剪烛西窗，已隔洞庭烟水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 寿周耐轩府尹，是岁起义仓","author":"邓剡","text":"问庐陵、米作何价。\n棠阴又绿今夏。\n活人手段依然在，独乐园中司马。\n初度也。\n算几处篝香，手额你多谢。\n风亭月榭。\n尽隐橘观棋，折荷筒酒，花竹秀而野。\n阶庭树，满目鱼鱼雅雅。\n千金难买清暇。\n纷纷征榷尘如梦，谁有似公闲者。\n天怎舍。\n趁绿鬓朱颜，须入凌烟画。\n海天不夜。\n管岁岁安期，采蒲为寿，高宴碧桃下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 杨教之齐安任","author":"邓剡","text":"笑平生、布帆无恙，堂堂稳送君去。\n江声悲壮崖殷血，曾是英雄行处。\n今亦古。\n甚一点东风，天不周郎与。\n城幡夜竖。\n几铜爵春残，战沙秋冷，华发遽如许。\n东坡老，千载风流两赋。\n馀音不绝如缕。\n临皋一笑三生梦，还认岷峨乡语。\n挥玉麈。\n尽不碍灯前，痛饮檐花雨。\n雪堂在否。\n管驾鹤归来，为君细赏，蝴蝶上阶句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其一","author":"邓剡","text":"王母仙桃，亲曾醉、九重春色。\n谁信道、鹿衔花去，浪翻鳌阙。\n眉锁娇娥山宛转，髻梳堕马云敧侧。\n恨风沙、吹透汉宫衣，馀香歇。\n霓裳散，庭花灭。\n昭阳燕，应难说。\n想春深铜雀，梦残啼血。\n空有琵琶传出塞，更无环佩鸣归月。\n又争知、有客夜悲歌，壶敲缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 寿文文溪，时守清江","author":"邓剡","text":"蛮烟塞雪。\n天老梅花骨。\n还著锦衣游戏，清江上、管风月。\n木兰归海北。\n竹梧侵户碧。\n三十六峰苍玉，驾白鹿、友仙客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝命诗","author":"邓得遇","text":"宋室忠臣，邓氏孝子。\n不忍偷生，宁甘溺死。\n彭咸故居，乃吾潭府。\n屈公子平，乃吾伴侣。\n优哉悠哉，吾得其所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赓梅山壁间韵","author":"邓梦杰","text":"愧我身名堕褐冠，无因安得到仙坛。\n子真虽隐名难隐，万古高风凛凛寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千叶石榴 其一","author":"邓深","text":"丹房叠蘤炯双眸，焰焰烧空夜不收。\n莫遣残英颠倒落，一枝开早见钗头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞练","author":"邓深","text":"见说天孙巧一机，银河练就雪争辉。\n长风吹下三千尺，只恐麻姑合得衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"邓深","text":"柱础昼生水，云雷暮出山。\n天时已秋杪，气候尚春间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐口桥即事","author":"邓深","text":"雨馀溪涨急机舂，缘岸人家柳弄风。\n路转源深行步缓，青山映水野桃红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲春即事","author":"邓深","text":"嘲弄春晴禽斗语，揄扬风色柳摇丝。\n麦苗含穗枇杷熟，却似江南四月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏暑","author":"邓深","text":"正觉纤絺便，未容团扇閒。\n儿童昧灾变，赤体更欢颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏留友人把酒","author":"邓深","text":"柳还飞絮春馀几，幸有清樽可共持。\n今我未眠卿莫去，古人皆饮子休辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵绣屏","author":"邓深","text":"定是司花怯晓寒，花枝围处密萦蟠。\n草针柳线藏真巧，莫作寻常倚市看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答陈仲思 其二","author":"邓深","text":"吟君诗罢不成欢，尚阻青灯话岁寒。\n亦欲分尝竹窗碧，少须春后荐春盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答陈仲思 其一","author":"邓深","text":"彤云冻合晚来风，百里溪山雪色同。\n李棨那能说诗兴，嗣宗端复叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江亭","author":"邓深","text":"村舍随山远，沙寮傍岸还。\n轻烟鱼复浦，残雪手巾山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中即事三首 其三","author":"邓深","text":"晒翅鸬鹚映日斜，倒悬群鸭趁鱼虾。\n槿篱石径通门处，茅屋松林卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中即事三首 其二","author":"邓深","text":"腾身赤鲤江心跃，浮鼻乌牛渡口过。\n雨后风清云净尽，一眉新月映寒波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中即事三首 其一","author":"邓深","text":"两岸农家各自耕，相过正欠小舟撑。\n牧童来往如平地，骑得吴牛入水行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观酒库落成 其一","author":"邓深","text":"毕卓夜行因满瓮，嗣宗喜仕为盈厨。\n自怜小户无如我，不断瓶沽断酒沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观酒库落成 其二","author":"邓深","text":"泥沙糟粕不堪传，有酒知盈几百船。\n浪说添杯吹野水，何如真变锡山泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访天宝洞","author":"邓深","text":"远寻仙洞上崔嵬，洞口诸峰翠作堆。\n先把姓名书洞竹，洞门终待玉匙开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别金华朱丞 其一","author":"邓深","text":"客中相识便相知，日日相过不问时。\n除却酒杯浇旅况，若非坐隐即论诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别金华朱丞 其二","author":"邓深","text":"梅信传黄麦正秋，征衣抖擞去难留。\n应从临汝江边过，传语滩头旧钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其五","author":"邓深","text":"昏烟漠漠雨霏霏，四月轻寒浸裌衣。\n叶满筠篮桑径晚，杜鹃声急楝花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其三","author":"邓深","text":"旧年不雪新年雪，今日非春明日春。\n滕六勾芒真劣相，寒温相语作比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其六","author":"邓深","text":"林间无叶供风落，溪上有梅迎雪开。\n斜日未收门巷暖，儿童笑指蹇驴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其一","author":"邓深","text":"卧橹无声百丈斜，牵夫匍匐入芦花。\n寒云过雁愁相顾，踏损寻常落处沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其四","author":"邓深","text":"缬纹斑駮绕山园，青带萦纡落涧泉。\n十月梨花开满树，直疑梅蕊破寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事六绝 其二","author":"邓深","text":"凄风夜雨黄牛峡，爱日寒云白狗岍。\n稳上瞿唐犹几日，关山须看月初圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村童","author":"邓深","text":"侵星裹饭下高山，负石趋城得米还。\n不识往来为几里，只言住处指云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨花","author":"邓深","text":"杨花似雪雪应嗔，散漫轻飞太逼真。\n结习已消那得住，却沾尘土不沾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜春解缆","author":"邓深","text":"江迥晨光独早回，放船东下兴悠哉。\n西风袅袅携将去，细雨冥冥看得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨卧舟中","author":"邓深","text":"不许抬头篷底下，仅容舒膝簟中间。\n听风听雨听滩浪，才得晴时出看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"邓深","text":"毛颖诸孙二十辈，千里相看谁与同。\n有两客卿变名姓，乌有先生亡是公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其二","author":"邓深","text":"桑里相闻路一程，无从款接笑谈清。\n那知邂逅论诗处，秋满潇湘雁送声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悯松","author":"邓深","text":"谁借毛锥千字力，曲留髯叟百年身。\n未能晦迹终难保，樗栎林间是散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷 其一","author":"邓深","text":"田田藕叶绿如裳，拍塞池亭尽是香。\n不受纤尘偏受露，十分清绝倚晨光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷 其二","author":"邓深","text":"莲未开时香在叶，他花纵好叶无香。\n制衣未入骚人手，象鼻何妨吸酒光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶感","author":"邓深","text":"兀兀诗书早岁勤，而今掩卷养天真。\n政须无语参摩诘，底用清谈学晋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨雪渡洑陂","author":"邓深","text":"竹外杨枝学小梅，竹间茅屋白皑皑。\n撑舟独拥蓑衣出，堪画何须待晚来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清旷静坐","author":"邓深","text":"草迷犊角挂林笋，风起茧毛扬树花。\n不见黄莺飞上柳，得知深处暗藏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词二首 其二","author":"邓深","text":"活计平生一钓船，将鱼换酒不论钱。\n夜来醉倒蓬笼底，却在芦花宿雁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词二首 其一","author":"邓深","text":"西风淅淅飐菰蒲，独棹扁舟钓五湖。\n买断水乡真乐处，月明云冷笛声孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野外新秋","author":"邓深","text":"平野宽无际，层云拨不开。\n晓容收雨后，凉意送秋来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野眺即景","author":"邓深","text":"山晚馀红照，林昏集众鸦。\n泥深茭欲笋，水满稻初花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪消","author":"邓深","text":"檐声不断元非雨，山色才开岂是云。\n万象终然仍旧贯，讵须装点巧纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登普济寺慈氏阁","author":"邓深","text":"柔远楼中俯市嚣，万家蚁聚汩尘劳。\n此中更觉楼低小，佛界由来著眼高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答庄权之","author":"邓深","text":"寒窗十载江湖梦，夜月三更风露秋。\n静坐观心香一炷，平生诗病一时瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋欧阳道士舞仙","author":"邓深","text":"博山烟烬夜三更，万籁声沉月一庭。\n拂拭琴床弹古调，松梢鹤睡洒然醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滟滪堆","author":"邓深","text":"水合百源争一关，正须滟滪控奔湍。\n露机象马浑閒事，合作颓波砥柱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起","author":"邓深","text":"案头黄奶温存睡，榻上青奴诱引凉。\n幽梦觉来山月上，一庭树影滴金光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫成","author":"邓深","text":"饮罢浮蛆聊隐几，醒来扪虱谩看书。\n风清襟袖凉无限，云晚溪山画不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠竹人家","author":"邓深","text":"户外江平不肯流，短篱疏竹翠光浮。\n畦蔬绕舍畬田粟，一饱无求百不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题壁平沙落雁","author":"邓深","text":"江寒烟暮水明霞，曲折斜行雁落沙。\n曾是潇湘篷底见，还疑今夜宿芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠钱道人","author":"邓深","text":"善说相传唐世术，不言钱有晋人风。\n非钱可况言真寔，肯与寻常卖相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]