[{"title":"元日","author":"辛弃疾","text":"老病忘时节，空斋晓尚眠。\n儿童唤翁起，今日是新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"止酒","author":"辛弃疾","text":"渊明爱酒得之天，岁晚还吟止酒篇。\n日醉得非促龄具，只今病渴已三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵","author":"辛弃疾","text":"欲把身心入太虚，要须勤著净工夫。\n古人有句须参取，穷到今年锥也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵","author":"辛弃疾","text":"自古蛾眉嫉者多，须防按剑向随和。\n此身更似沧浪水，听取当年孺子歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用儒字韵二首 其二","author":"辛弃疾","text":"是是非非好读书，莫将名实自相诬。\n由来废冢谁为者，诗礼相传大小儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用儒字韵二首 其一","author":"辛弃疾","text":"人才长与世相疏，若谓无才即厚诬。\n方朔长身无饭吃，人间饱死几侏儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同杜叔高祝彦集观天保庵瀑布主人留饮两日且约牡丹之饮 其一","author":"辛弃疾","text":"竹杖芒鞋看瀑回，暮年筋力倦崔嵬。\n桃花落尽无春思，直待牡丹开后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读语孟二首 其二","author":"辛弃疾","text":"屏去佛经与道书，只将语孟味真腴。\n出门俯仰见天地，日月光中行坦途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江山庆云桥 其二","author":"辛弃疾","text":"断崖老树互撑拄，白水绿畦相灌输。\n焉得溪南一丘壑，放船画作归来图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江山庆云桥 其一","author":"辛弃疾","text":"草梢出水已无多，村路瀰漫奈雨何。\n水底有桥桥有月，只今平地怕风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江郎山和韵","author":"辛弃疾","text":"三峰一一青如削，卓立千寻不可干。\n正直相扶无倚傍，撑持天地与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其二","author":"辛弃疾","text":"百忧常与事俱来，莫把胸中荆棘栽。\n但只熙熙闲过日，人间无处不春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其一","author":"辛弃疾","text":"野人日日献花来，只倩渠侬取意栽。\n高下参差无次序，要令不似俗亭台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和任师见寄之韵 其二","author":"辛弃疾","text":"昨梦春风花满枝，是花到眼是新诗。\n如今梦断春无迹，不记题诗付与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和任师见寄之韵 其三","author":"辛弃疾","text":"几年魂梦隔高门，叹息潭间阙异闻。\n剩喜风情筋力在，尚能诗似鲍参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和任师见寄之韵 其一","author":"辛弃疾","text":"老来功业已蹉跎，买得生涯复不多。\n十顷芰荷三径菊，醉乡容我住无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李都统诗","author":"辛弃疾","text":"破屋那堪急雨淋，且欣断港运篙深。\n老农定向中宵望，太岁今年合守心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨民瞻韵","author":"辛弃疾","text":"拄杖闲题祖印来，壁间有句试参怀。\n从来歌舞新罗袜，不识溪山旧草鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周显先韵二首 其二","author":"辛弃疾","text":"怒涛千里破空飞，洗尽青衫辇路泥。\n更惜秋风一帆足，南楼只在远山西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周显先韵二首 其一","author":"辛弃疾","text":"暖日晴风晚蝶忙，平林先著夜来霜。\n寒花毕竟亡聊甚，野菜畦边惨淡黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵茂嘉郎中双头芍药二首 其二","author":"辛弃疾","text":"当年负鼎去干汤，至味须参芍药芳。\n岂是调羹双妙手，故教初发劝持觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵茂嘉郎中双头芍药二首 其一","author":"辛弃疾","text":"昨日梅华同语笑，今朝芍药并芬芳。\n弟兄殿住春风了，却遣花来送一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵晋臣送糟蟹","author":"辛弃疾","text":"人间缓急正须才，郭索能令酒禁开。\n一水一山十五日，从来能事不相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和诸葛元亮韵","author":"辛弃疾","text":"偊泛清溪李郭船，路旁人已羡登仙。\n看君不似南阳卧，只似哦诗孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郭逢道韵 其一","author":"辛弃疾","text":"枣树平生叹子阳，里歌虽短意偏长。\n东家昨夜梅花发，愧我分他一半香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郭逢道韵 其二","author":"辛弃疾","text":"君家富贵有汾阳，只要文章光焰长。\n莫为梅花费诗句，细思丹桂是天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅岩叟梅花二首 其二","author":"辛弃疾","text":"灵均恨不与同时，欲把幽香赠一枝。\n堪入离骚文字不，当年何事未相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅岩叟梅花二首 其一","author":"辛弃疾","text":"月澹黄昏欲雪时，小窗犹欠岁寒枝。\n暗香疏影无人处，唯有西湖处士知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林贵文买牡丹见赠至彭村偶题","author":"辛弃疾","text":"宝刀和雨剪流霞，送到彭村刺史家。\n闻道名园春已过，千金还买暨家花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送剑与傅岩叟","author":"辛弃疾","text":"镆邪三尺照人寒，试与挑灯子细看。\n且挂空斋作琴伴，未须携去斩楼兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋怀隐庵 其二","author":"辛弃疾","text":"空山钟鼓梵王家，小立西风数过鸦。\n秋色无多谁占断，长廊西畔佛桑花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋怀隐庵 其一","author":"辛弃疾","text":"天寒秋色入平林，更著西风月下砧。\n旧日醉吟浑不管，如今节物总关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重午日戏书","author":"辛弃疾","text":"青山吞吐古今月，绿树低昂朝暮风。\n万事有为应有尽，此身无我自无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"辛弃疾","text":"是非得失两茫茫，闲把遗书细较量。\n掩卷古人堪笑处，起来摩腹步长廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读邵尧夫诗","author":"辛弃疾","text":"饮酒已输陶靖节，作诗犹爱邵尧夫。\n若论老子胸中事，除却溪山一事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作","author":"辛弃疾","text":"至性由来禀太和，善人何少恶人多。\n君看泻水著平地，正作方圆有几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题 其二","author":"辛弃疾","text":"人言大道本强名，毕竟名从有处生。\n昭氏鼓瑟谁解听，亦无亏处亦无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"辛弃疾","text":"逢花眼倦开，见酒手频推。\n不恨吾年老，恨他将病来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题 其一","author":"辛弃疾","text":"人生忧患始于名，旦喜无闻过此生。\n却得少年耽酒力，读书学剑两无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿驿 其一","author":"辛弃疾","text":"他乡异县老何堪，短发萧萧不胜簪。\n旋买一樽持自贺，病身安稳到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移竹","author":"辛弃疾","text":"每因种树悲年事，待看成阴是几时。\n眼见子孙孙又子，不如栽竹绕园池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其一","author":"辛弃疾","text":"一水奔流叠嶂开，溪头千步响如雷。\n扁舟费尽篙师力，咫尺平澜上不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其二","author":"辛弃疾","text":"山上风吹笙鹤声，山前人望翠云屏。\n蓬莱枉觅瑶池路，不道人间有幔亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其三","author":"辛弃疾","text":"玉女峰前一棹歌，烟鬟雾髻动清波。\n游人去后枫林夜，月满空山可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其四","author":"辛弃疾","text":"见说仙人此避秦，爱随流水一溪云。\n花开花落无寻处，彷佛吹箫月夜闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其五","author":"辛弃疾","text":"千丈搀天翠壁高，定谁狡狯插遗樵。\n神仙万里乘风去，更度槎枒个样桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其六","author":"辛弃疾","text":"山头有路接无尘，欲觅王孙试问津。\n瞥向苍崖高处见，三三两两看游人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其七","author":"辛弃疾","text":"巨石亭亭缺齧多，悬知千古也消磨。\n人间正觅擎天柱，无奈风吹雨打何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其八","author":"辛弃疾","text":"自有山来几许年，千奇万怪只依然。\n试从精舍先生问，定在包牺八卦前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其九","author":"辛弃疾","text":"山中有客帝王师，日日吟诗坐钓矶。\n费尽烟霞供不足，几时西伯载将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷作棹歌呈晦翁十首 其十","author":"辛弃疾","text":"行尽桑麻九曲天，更寻佳处可留连。\n如今归棹如掤箭，不似来时上水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋葡萄","author":"辛弃疾","text":"高架金茎照水寒，累累小摘便堆盘。\n喜君不酿凉州酒，来救衰翁舌本乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉书其壁 其二","author":"辛弃疾","text":"去年冠盖长安道，客里因循过了梅。\n今岁花开转多事，簿书丛里两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉书其壁 其一","author":"辛弃疾","text":"颇觉参禅近有功，因空成色色成空。\n色空静处如何说，且坐清凉境界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题金相寺净照轩诗","author":"辛弃疾","text":"净是净空空即色，照应照物物非心。\n请看窗外一轮月，正在碧潭千丈深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题鹅湖壁","author":"辛弃疾","text":"昔年留此苦思归，为忆啼门玉雪儿。\n鸾鹄飞残梧竹冷，只今归兴却迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题福州参泉二首 其二","author":"辛弃疾","text":"三泉参错本儿嬉，认作参星转更痴。\n却笑世间真狡狯，古今能有几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题福州参泉二首 其一","author":"辛弃疾","text":"两泉水出更温泉，这里原无一二三。\n欲识当年参字意，行人浴罢试求参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤鸣亭独饮","author":"辛弃疾","text":"小亭独酌兴悠哉，忽有清愁到酒杯。\n四面青山围欲合，不知愁自那边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤鸣亭绝句四首 其四","author":"辛弃疾","text":"清欢那复笑开口，閒事长令闷破头。\n更有不堪萧索处，西风过了菊花秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤鸣亭绝句四首 其三","author":"辛弃疾","text":"旧时秋水醉吟者，且作西山病叟呼。\n可惜黄花逢令节，樽中酒燥笔头枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤鸣亭绝句四首 其二","author":"辛弃疾","text":"安石榴花翠竹枝，婆娑其下更何为。\n溪流自有无声处，鹤舞不如闲立时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤鸣亭绝句四首 其一","author":"辛弃疾","text":"饱饭闲游绕小溪，却将往事细寻思。\n有时思到难思处，拍碎阑干人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠延福端老二绝 其二","author":"黄公度","text":"我来欲问小乘禅，惭愧尘埃未了缘。\n忽忆去年秋夜话，共听风雨不成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠延福端老二绝 其一","author":"黄公度","text":"飘然瓶锡信行藏，偶驻姜峰古道场。\n欲识高人用心处，白云堂下一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆李白","author":"辛弃疾","text":"当年宫殿赋昭阳，岂信人间过夜郎。\n明月入江依旧好，青山埋骨至今香。\n不寻饭颗山头伴，却趁汨罗江上狂。\n定要骑鲸归汗漫，故来濯足戏沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙寅九月二十八日作来年将告老","author":"辛弃疾","text":"渐识空虚不二门，扫除诸幻绝根尘。\n此心自拟终成佛，许事从今只任真。\n有我故应还起灭，无求何自别冤亲。\n西山病叟支离甚，欲向君王乞此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙寅岁山间竞传诸将有下棘寺者","author":"辛弃疾","text":"去年骑鹤上扬州，意气平吞万户侯。\n谁使匈奴来塞上，却从廷尉望山头。\n荣华大抵有时歇，祸福无非自己求。\n记取山西千古恨，李陵门下至今羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙迹岩","author":"辛弃疾","text":"地秘岩藏骨，溪灵膝印痕。\n虚床惟太姥，别席尽曾孙。\n披牒秦朝远，遗坛汉祀存。\n何时幔亭侧，重复见幢幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉真书院经德堂","author":"辛弃疾","text":"平生经德几人知，莫忘当年两字师。\n绝代本无空谷叹，逢人且觅瑱山诗。\n千章古木阴浓处，万卷藏书读尽时。\n却把一杯堂上笑，世间多少啖名儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有以事来请者效康节体作诗以答之","author":"辛弃疾","text":"未能立得自家身，何暇将身更为人。\n借使有求能尽与，也知方笑已生嗔。\n器才满后须招损，镜太明时易受尘。\n终日闭门无客至，近来鱼鸟却相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行吊宋齐邱","author":"辛弃疾","text":"尝笑韩非死说难，先生事业最相关。\n能令父子君臣际，常在干戈揖逊间。\n秋浦山高明月在，丹阳人去晚风闲。\n可怜千古长江水，不与渠侬洗厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事示儿","author":"辛弃疾","text":"扫迹衡门下，终朝抱膝吟。\n贫须依稼穑，老不厌山林。\n有酒无馀愿，因闲得此心。\n西园早行乐，桃李渐成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿朱晦翁","author":"辛弃疾","text":"西风卷尽护霜筠，碧玉壶天月色新。\n凤历半千开诞日，龙山重九逼佳辰。\n先心坐使鬼神伏，一笑能回宇宙春。\n历数唐尧千载下，如公仅有两三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿赵茂嘉郎中二首 其二","author":"辛弃疾","text":"鹅湖山麓湛溪湄，华屋眈眈照绿漪。\n子侄日为真率会，弟兄剩有唱酬诗。\n杨花榆荚浑如许，苦笋樱桃正是时。\n待酌西江援北斗，摩挲金狄与君期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿赵茂嘉郎中二首 其一","author":"辛弃疾","text":"玉色长身白首郎，当年麾节几甘棠。\n力贫活物阴功大，未老垂车逸兴长。\n久矣如今太公望，岿然真是鲁灵光。\n朝廷正尔尊黄发，稳驾蒲轮觐玉皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]