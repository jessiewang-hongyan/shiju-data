_1.csv","pointer":2193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"嘉承天和，黍稷翼翼。\n默相农功，繄神之德。\n俎实牺牲，旧章是式。\n嗣有丰年，我庾维亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 还位用《正安》。","author":"郊庙朝会歌辞","text":"国主太祀，地道聿神。\n稷司百谷，利毓惟均。\n练日新吉，粢盛飶芬。\n神燕娭矣，福此下民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 太社位奠玉币用《嘉安》。秋腊太稷、土正、后稷通用。","author":"郊庙朝会歌辞","text":"赫赫媪神，稼穑是司。\n方是藉敛，报本攸宜。\n嘉坛建祀，玉帛陈仪。\n明灵昭格，以介蕃釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 太社位奠玉币用《嘉安》。春社太稷、土正、后稷通用。","author":"郊庙朝会歌辞","text":"土发而祭，农祥是祈。\n笾豆加篚，典礼有彝。\n惟兹圭币，用告肃祗。\n神灵降鉴，锡我繁釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 升坛用《正安》。","author":"郊庙朝会歌辞","text":"神地之道，粒食有先。\n岁谨祈报，礼严豆笾。\n降登祼荐，罔或不虔。\n以似以续，宜屡丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 盥洗用《正安》。","author":"郊庙朝会歌辞","text":"祭重齐肃，神格专精。\n沃洗于阼，涓洁著诚。\n清明鬯矣，熙事备成。\n以似以续，如坻如京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 其五 迎神用","author":"郊庙朝会歌辞","text":"国主社稷，时祀有常。\n肃若旧典，报本不忘。\n粢盛丰洁，歌吟青黄。\n尊神倏来，百物宾将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 其四 迎神用","author":"郊庙朝会歌辞","text":"谷资土养，民赖谷生。\n功利之博，莫之与京。\n式严祠坛，因物荐诚。\n礼具乐奏，惟神顾歆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 其三 迎神用","author":"郊庙朝会歌辞","text":"是尊是奉，兹率旧章。\n乐音纯绎，荐溢圆方。\n情文备矣，神其迪尝。\n永观锡羡，多穑穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 其二 迎神用","author":"郊庙朝会歌辞","text":"功烈在民，诞受露雨。\n良耜既歌，乃扬帗舞。\n是奉是尊，厚礼斯举。\n相其丰年，多稌多黍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 其一 迎神用","author":"郊庙朝会歌辞","text":"五祀之本，社稷有严。\n芟柞伊始，夫敢不虔。\n吉日惟戊，式荐豆笾。\n神其来格，用介有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀先农摄事七首 其七 送神用《凝安》。","author":"郊庙朝会歌辞","text":"熙事成兮，始终洁齐。\n笾豆彻兮，撙节靡垂。\n灵有嘉兮，降福孔皆。\n票然逝兮，我心孔怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀先农摄事七首 其六 亚、终献用《同安》。","author":"郊庙朝会歌辞","text":"旨具百味，酌备三畴。\n贰觞既毕，礼洽意周。\n庶几嘉飨，格神之幽。\n相我穑事，锡以有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀先农摄事七首 其五 后稷位酌献用《成安》。","author":"郊庙朝会歌辞","text":"有周膺历，实起后稷。\n相时丰功，率由稼穑。\n振古称祀，先农并食。\n阜我昌我，时万时亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀先农摄事七首 其四 神农位酌献用《成安》。","author":"郊庙朝会歌辞","text":"耒耜之教，帝实开先。\n致养垂利，古今民天。\n嘉荐报本，于以祈年。\n诚格和应，神娭福延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀先农摄事七首 其三 奠币用《明安》。","author":"郊庙朝会歌辞","text":"灵斿载临，见先陈贽。\n有严篚实，式将纯意。\n肸蚃既接，礼行有次。\n神兮安留，歆我禋祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀先农摄事七首 其二 初献升殿用《同安》。盥洗同。","author":"郊庙朝会歌辞","text":"率职咸涖，礼容睟然。\n澡身端意，陟降靡愆。\n神心嘉虞，飨兹洁蠲。\n敷锡纯佑，屡登丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer"