ance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十八 北岳位酌献用《成安》。","author":"郊庙朝会歌辞","text":"瞻彼芒芒，曰北之常。\n既高既厚，乃纪乃纲。\n荐鬯伊始，灵示孔将。\n玄服铁驾，览此下方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十七 奠玉币用《明安》。","author":"郊庙朝会歌辞","text":"相予阴威，厥功浩浩。\n一岁之功，何以为报。\n府有圭币，我其敢私。\n肃肃孔怀，于以将之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十六 初献盥洗、升降用《同安》。","author":"郊庙朝会歌辞","text":"寿宫煇煌，聿修时祀。\n缤其临矣，吉蠲以俟。\n居乎昂昂，行乎遂遂。\n敬尔攸司，展采错事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十五 北方迎神用《凝安》。","author":"郊庙朝会歌辞","text":"我土绵绵，孰匪疆理。\n惟时幽都，匪曰隃只。\n涤哉艮月，朔风其同。\n曷阻曷深，其亦来降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十四 送神。曲同迎神。","author":"郊庙朝会歌辞","text":"乃羞既彻，乃奏及阕。\n无馂斯俎，式听致谒。\n不蹇不蹶，不沸不决。\n厉魃其祛，永庇有截。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十三 亚、终献。","author":"郊庙朝会歌辞","text":"肃肃其乂，既旨既溢。\n迨其毕酌，偏兹博硕。\n祀事既遂，不敢谇射。\n神或醉止，我心斯怿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十二 西渎位。","author":"郊庙朝会歌辞","text":"自彼昆虚，于以潜流。\n念兹诞润，岂侯不犹。\n在昔中府，暨海聿脩。\n迄既望止，神保先卣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十一 西海位。","author":"郊庙朝会歌辞","text":"奄浸坤轴，滋殖其濊。\n而典斯稽，有陛有壝。\n弗替时举，元斝斯酹。\n胡先于河，实委之会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三十 西镇位。","author":"郊庙朝会歌辞","text":"维吴崇崇，于汧之西。\n瞻彼有陇，赫赫不迷。\n克裨于岳，我酌俶齐。\n于凡有旅，视公维跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十九 西岳位酌献用《成安》。","author":"郊庙朝会歌辞","text":"屹削厥方，风云斯所。\n阴邑有宫，侐侐俣俣。\n清酤在尊，灵眷在下。\n于俎献兮，则莫我吐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十八 奠玉币用《明安》。","author":"郊庙朝会歌辞","text":"彼林有庪，彼泽有沈。\n猗与西望，弗菲弗淫。\n乃追斯邸，乃㡛斯寻。\n卬礼既卒，是用是歆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十七 初献盥洗、升降用《同安》。","author":"郊庙朝会歌辞","text":"靡实不新，靡陈不濯。\n人之弗蠲，矧敢将酌。\n载晞之帨，载濡之勺。\n洗仪告备，陟降时若。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十六 西方迎神用《凝安》。","author":"郊庙朝会歌辞","text":"有岌斯安，有涵斯洽。\n聿相厥成，允祀是答。\n爰饬乃奏，乃奏既协。\n于昭降止，是遵是接。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十五 送神。曲同迎神。","author":"郊庙朝会歌辞","text":"虞至旦兮，灵亦有喜。\n蹇欲骧兮，象舆已轙。\n粥音送兮，灵聿归矣。\n长无极兮，锡我以祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十四 亚、终献，酌献。","author":"郊庙朝会歌辞","text":"礼乐既成，肃容有常。\n奄留消摇，申毕重觞。\n仰胪所求，降福滂洋。\n师象山则，以况皇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十三 中镇位。","author":"郊庙朝会歌辞","text":"禹画九州，河内曰冀。\n霍山崇崇，作镇积势。\n我祀如何，百末旨味。\n承神燕娭，诸神毕至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十二 中岳位酌献用《成安》。","author":"郊庙朝会歌辞","text":"与天齐极，伊嵩之高。\n显灵效异，神休孔昭。\n饬我祀事，实俎鸾膋。\n以侑旨酒，其馨有椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十一 奠玉币用《明安》。","author":"郊庙朝会歌辞","text":"练日有望，高灵来下。\n何以告诚，心惟物假。\n有篚斯实，有宝斯籍。\n于以奠之，神光烛夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二十 初献盥洗、升降用《同安》。","author":"郊庙朝会歌辞","text":"思来感格，肃雍不忘。\n礼仪既备，济济跄跄。\n洁蠲致敬，往荐其芳。\n交若有承，神兮孔飨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十九 中央迎神用《凝安》。","author":"郊庙朝会歌辞","text":"天作高山，屹然中峙。\n经营厥宇，万亿咸遂。\n火熙土王，爰举时祀。\n绳绳宣延，彷佛来止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十八 送神。曲同迎神。","author":"郊庙朝会歌辞","text":"荐彻豆笾，熙事备成。\n灵兮将归，羽旄纷纭。\n飘其逝矣，浮空籋云。\n怅然顾瞻，有抚怀心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十七 亚、终献，酌献。","author":"郊庙朝会歌辞","text":"神之游兮，洋洋对越。\n澹乎容与，肸蚃斯答。\n乃奏既备，八音攸节。\n重觞申陈，百礼以洽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十六 南渎位。","author":"郊庙朝会歌辞","text":"四渎之利，经营中国。\n南曰大江，险兮天设。\n维尔有神，隃其庙食。\n望秩孔时，我心翼翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十五 南海位。","author":"郊庙朝会歌辞","text":"维水善下，利物曰功。\n逶迤百川，谁欤朝宗。\n荡荡大受，于焉会同。\n膋萧列陈，以答鸿濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十四 南镇位。","author":"郊庙朝会歌辞","text":"维南有山，于彼会稽。\n作镇在昔，神则司之。\n厥有旧典，以祀以时。\n百味维旨，灵其燕娭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十三 南岳位酌献用《成安》。","author":"郊庙朝会歌辞","text":"神曰司天，居南之衡。\n位焉则帝，于以奠方。\n南讹秩事，望礼有常。\n庶几嘉虞，介福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十二 奠玉币用《明安》。","author":"郊庙朝会歌辞","text":"我祀我享，仪物孔周。\n一纯斯举，二精聿修。\n璞兮其温，丝兮其紑。\n是荐洁蠲，神兮安留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十一 初献盥洗、升降用《同安》。","author":"郊庙朝会歌辞","text":"爰熙嘉坛，揭虔毖祀。\n郁人沃盥，赞我祼事。\n于降于登，以作以止。\n莫不肃雍，告灵飨矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其十 南方迎神用《凝安》。","author":"郊庙朝会歌辞","text":"朱明盛长，我祀用饬。\n厥祀伊何，山川咸秩。\n如将见之，绳绳齐栗。\n神哉沛兮，消摇来格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其九 送神用《凝安》。","author":"郊庙朝会歌辞","text":"蹇兮纷纷，神实戾止。\n以饮以食，以享以祀。\n?兮冥冥，神亦归止。\n以醉以饱，以锡尔祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其八 亚、终献，酌献。四位并同。","author":"郊庙朝会歌辞","text":"我祀孔肃，神其安留。\n容与裴回，若止若浮。\n洽此重觞，申以百羞。\n无我斁遗，万邦之休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其七 东渎位。","author":"郊庙朝会歌辞","text":"我祀伊何，于彼长淮。\n导源桐柏，委注蓬莱。\n捍齐护楚，宣威示怀。\n豆笾列陈，亦孔之偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其六 东海位。","author":"郊庙朝会歌辞","text":"澒洞鸿濛，天与无极。\n导纳江汉，节宣南北。\n顺助其功，善下惟德。\n我祀孔时，以介景福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其五 东镇位。","author":"郊庙朝会歌辞","text":"惟山有镇，雄于其方。\n东孰为雄，于沂之疆。\n祀事有时，爰举旧章。\n我望匪遥，庶几燕飨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其四 东岳位酌献用《成安》。","author":"郊庙朝会歌辞","text":"岩岩天齐，自古在昔。\n肤寸之云，四方其泽。\n惟时东作，祀事乃饬。\n惠我无疆，恩沾动植。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其三 奠玉币用《明安》。","author":"郊庙朝会歌辞","text":"司历告时，惟孟之春。\n爰举时祀，旅于有神。\n鼓钟既设，圭帛具陈。\n阜蕃庶物，以福我民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其一 东方迎神用《凝安》。","author":"郊庙朝会歌辞","text":"帝奠九㙻，孰匪我疆。\n繄我东土，山川相望。\n祀事孔时，肃雍不忘。\n嶪峨濛鸿，郁哉洋洋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]