[{"title":"破阵子 其二","author":"晏殊","text":"燕子欲归时节，高楼昨夜西风。\n求得人间成小会，试把金尊傍菊丛。\n歌长粉面红。\n斜日更穿帘幕，微凉渐入梧桐。\n多少襟情言不尽，写向蛮笺曲调中。\n此情千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 其四","author":"晏殊","text":"湖上西风斜日，荷花落尽红英。\n金菊满丛珠颗细，海燕辞巢翅羽轻。\n年年岁岁情。\n美酒一杯新熟，高歌数阕堪听。\n不向尊前同一醉，可奈光阴似水声。\n迢迢去未停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 其一","author":"晏殊","text":"海上蟠桃易熟，人间好月长圆。\n惟有掰钗分钿侣，离别常多会面难。\n此情须问天。\n蜡烛到明垂泪，熏炉尽日生烟。\n一点凄凉愁绝意，谩道秦筝有剩弦。\n何曾为细传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酒泉子 其二","author":"晏殊","text":"春色初来，遍拆红芳千万树，流莺粉蝶斗翻飞。\n恋香枝。\n劝君莫惜缕金衣。\n把酒看花须强饮，明朝后日渐离披。\n惜芳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酒泉子 其一","author":"晏殊","text":"三月暖风，开却好花无限了，当年丛下落纷纷。\n最愁人。\n长安多少利名身。\n若有一杯香桂酒，莫辞花下醉芳茵。\n且留春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望仙门 其三","author":"晏殊","text":"玉池波浪碧如鳞。\n露莲新。\n清歌一曲翠眉嚬。\n舞华茵。\n满酌兰英酒，须知献寿千春。\n太平无事荷君恩。\n荷君恩。\n齐唱望仙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望仙门 其二","author":"晏殊","text":"玉壶清漏起微凉。\n好秋光。\n金杯重叠满琼浆。\n会仙乡。\n新曲调丝管，新声更飐霓裳。\n博山炉暖泛浓香。\n泛浓香。\n为寿百千长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望仙门 其一","author":"晏殊","text":"紫薇枝上露华浓。\n起秋风。\n管弦声细出帘栊。\n象筵中。\n仙酒斟云液，仙歌转绕梁虹。\n此时佳会庆相逢。\n庆相逢。\n欢醉且从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望汉月/忆汉月","author":"晏殊","text":"千缕万条堪结。\n占断好风良月。\n谢娘春晚先多愁，更撩乱、絮飞如雪。\n短亭相送处，长忆得、醉中攀折。\n年年岁岁好时节。\n怎奈尚、有人离别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其五","author":"晏殊","text":"红笺小字，说尽平生意。\n鸿雁在云鱼在水，惆怅此情难寄。\n斜阳独倚西楼，遥山恰对帘钩。\n人面不知何处，绿波依旧东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二","author":"晏殊","text":"秋光向晚。\n小阁初开宴。\n林叶殷红犹未遍。\n雨后青苔满院。\n萧娘劝我金卮。\n殷勤更唱新词。\n暮去朝来即老，人生不饮何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一","author":"晏殊","text":"春花秋草。\n只是催人老。\n总把千山眉黛扫。\n未抵别愁多少。\n劝君绿酒金杯。\n莫嫌丝管声催。\n兔走乌飞不住，人生几度三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其四","author":"晏殊","text":"金风细细，叶叶梧桐坠。\n绿酒初尝人易醉，一枕小窗浓睡。\n紫薇朱槿花残，斜阳却照阑干。\n双燕欲归时节，银屏昨夜微寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三","author":"晏殊","text":"春来秋去。\n往事知何处。\n燕子归飞兰泣露。\n光景千留不住。\n酒阑人散忡忡。\n闲阶独倚梧桐。\n记得去年今日，依前黄叶西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清商怨","author":"晏殊","text":"关河愁思望处满，渐素秋向晚，雁过南云，行人回泪眼。\n双鸾衾裯悔展，夜又永，枕孤人远。\n梦未成归，梅花闻塞管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其四","author":"晏殊","text":"杨柳风前香百步。\n盘心碎点真珠露。\n疑是水仙开洞府。\n妆景趣。\n红幢绿盖朝天路。\n小鸭飞来稠闹处。\n三三两两能言语。\n饮散短亭人欲去。\n留不住。\n黄昏更下萧萧雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其三","author":"晏殊","text":"荷叶初开犹半卷。\n荷花欲拆犹微绽。\n此叶此花真可羡。\n秋水畔。\n青凉伞映红妆面。\n美酒一杯留客宴。\n拈花摘叶情无限。\n争奈世人多聚散。\n频祝愿。\n如花似叶长相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其一","author":"晏殊","text":"画鼓声中昏又晓。\n时光只解催人老。\n求得浅欢风日好。\n齐揭调。\n神仙一曲渔家傲。\n绿水悠悠天杳杳。\n浮生岂得长年少。\n莫惜醉来开口笑。\n须信道。\n人间万事何时了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其五","author":"晏殊","text":"粉笔丹青描未得。\n金针彩线功难敌。\n谁傍暗香轻采摘。\n风淅淅。\n船头触散双鸂鶒。\n夜雨染成天水碧。\n朝阳借出胭脂色。\n欲落又开人共惜。\n秋气逼。\n盘中已见新莲菂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十三","author":"晏殊","text":"楚国细腰元自瘦。\n文君腻脸谁描就。\n日夜声声催箭漏。\n昏复昼。\n红颜岂得长如旧。\n醉折嫩房和蕊嗅。\n天丝不断清香透。\n却傍小阑凝坐久。\n风满袖。\n西池月上人归后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其七","author":"晏殊","text":"罨画溪边停彩舫。\n仙娥绣被呈新样。\n飒飒风声来一饷。\n愁四望。\n残红片片随波浪。\n琼脸丽人青步障。\n风牵一袖低相向。\n应有锦鳞闲倚傍。\n秋水上。\n时时绿柄轻摇扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其二","author":"晏殊","text":"荷叶荷花相间斗。\n红娇绿嫩新妆就。\n昨日小池疏雨后。\n铺锦绣。\n行人过去频回首。\n倚遍朱阑凝望久。\n鸳鸯浴处波文皱。\n谁唤谢娘斟美酒。\n萦舞袖。\n当筵劝我千长寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十四","author":"晏殊","text":"嫩绿堪裁红欲绽。\n蜻蜓点水鱼游畔。\n一霎雨声香四散。\n风飐乱。\n高低掩映千千万。\n总是凋零终有限。\n能无眼下生留恋。\n何似折来妆粉面。\n勤看玩。\n胜如落尽秋江岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其一","author":"晏殊","text":"越女采莲江北岸。\n轻桡短棹随风便。\n人貌与花相斗艳。\n流水慢。\n时时照影看妆面。\n莲叶层层张绿伞。\n莲房个个垂金盏。\n一把藕丝牵不断。\n红日晚。\n回头欲去心撩乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其六","author":"晏殊","text":"叶下鵁鶄眠未稳。\n风翻露飐香成阵。\n仙女出游知远近。\n羞借问。\n饶将绿扇遮红粉。\n一掬蕊黄沾雨润。\n天人乞与金英嫩。\n试折乱条醒酒困。\n应有恨。\n芳心拗尽丝无尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其九","author":"晏殊","text":"脸傅朝霞衣剪翠。\n重重占断秋江水。\n一曲采莲风细细。\n人未醉。\n鸳鸯不合惊飞起。\n欲摘嫩条嫌绿刺。\n闲敲画扇偷金蕊。\n半夜月明珠露坠。\n多少意。\n红腮点点相思泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十一","author":"晏殊","text":"粉面啼红腰束素，当年拾翠曾相遇。\n密意深情谁与诉，空怨慕，西池夜夜风兼露。\n池上夕阳笼碧树，池中短棹惊微雨。\n水泛落英何处去，人不语，东流到了无停住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其八","author":"晏殊","text":"宿蕊斗攒金粉闹。\n青房暗结蜂儿小。\n敛面似啼开似笑。\n天与貌。\n人间不是铅华少。\n叶软香清无限好。\n风头日脚乾催老。\n待得玉京仙子到。\n凭向道。\n红颜只合长年少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其十二","author":"晏殊","text":"幽鹭慢来窥品格，双鱼岂解传消息。\n绿柄嫩香频采摘，心似织，条条不断谁牵役。\n粉泪暗和清露滴，罗衣染尽秋江色。\n对面不言情脉脉，烟水隔，无人说似长相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"晏殊","text":"人人尽道黄葵淡。\n侬家解说黄葵艳。\n可喜万般宜。\n不劳朱粉施。\n摘承金盏酒。\n劝我千长寿。\n擎作女真冠。\n试伊娇面看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"晏殊","text":"高梧叶下秋光晚。\n珍丛化出黄金盏。\n还似去年时。\n傍阑三两枝。\n人情须耐久。\n花面长依旧。\n莫学蜜蜂儿。\n等闲悠扬飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"晏殊","text":"秋花最是黄葵好。\n天然嫩态迎秋早。\n染得道家衣。\n淡妆梳洗时。\n晓来清露滴。\n一一金杯侧。\n插向绿云鬓。\n便随王母仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"晏殊","text":"芳莲九蕊开新艳。\n轻红淡白匀双脸。\n一朵近华堂。\n学人宫样妆。\n看时斟美酒。\n共祝千年寿。\n销得曲中夸。\n世间无此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"晏殊","text":"秋露坠。\n滴尽楚兰红泪。\n往事旧欢何限意。\n思量如梦寐。\n人貌老于前岁。\n风月宛然无异。\n座有嘉宾尊有桂。\n莫辞终夕醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其三","author":"晏殊","text":"花不尽，柳无穷。\n应与我情同。\n觥船一棹百分空。\n何处不相逢。\n朱弦悄。\n知音少。\n天若有情应老。\n劝君看取利名场。\n今古梦茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其二","author":"晏殊","text":"歌敛黛，舞萦风。\n迟日象筵中。\n分行珠翠簇繁红。\n云髻袅珑璁。\n金炉暖。\n龙香远。\n共祝尧龄万万。\n曲终休解画罗衣。\n留伴彩云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其五","author":"晏殊","text":"曙河低，斜月淡。\n帘外早凉天。\n玉楼清唱倚朱弦。\n馀韵入疏烟。\n脸霞轻，眉翠重。\n欲舞钗钿摇动。\n人人如意祝炉香。\n为寿百千长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其四","author":"晏殊","text":"烛飘花，香掩烬。\n中夜酒初醒。\n画楼残点两三声。\n窗外月胧明。\n晓帘垂，惊鹊去。\n好梦不知何处。\n南园春色已归来。\n庭树有寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其一","author":"晏殊","text":"风转蕙，露催莲。\n莺语尚绵蛮。\n尧蓂随月欲团圆。\n真驭降荷兰。\n褰油幕。\n调清乐。\n四海一家同乐。\n千官心在玉炉香。\n圣寿祝天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹧鸪 其一 咏红梅","author":"晏殊","text":"越娥红泪泣朝云。\n越梅从此学妖嚬。\n腊月初头、庾岭繁开后，特染妍华赠世人。\n前溪昨夜深深雪，朱颜不掩天真。\n何时驿使西归，寄与相思客，一枝新。\n报道江南别样春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹧鸪 其二","author":"晏殊","text":"江南残腊欲归时。\n有梅红亚雪中枝。\n一夜前村、间破瑶英拆，端的千花冷未知。\n丹青改样匀朱粉，雕梁欲画犹疑。\n何妨与向冬深，密种秦人路，夹仙溪。\n不待夭桃客自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊踏枝/蝶恋花","author":"晏殊","text":"紫府群仙名籍秘。\n五色斑龙，暂降人间世。\n海变桑田都不记。\n蟠桃一熟三千岁。\n露滴彩旌云绕袂。\n谁信壶中，别有笙歌地。\n门外落花随水逝。\n相看莫惜尊前醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滴滴金","author":"晏殊","text":"梅花漏泄春消息。\n柳丝长，草芽碧。\n不觉星霜鬓边白。\n念时光堪惜。\n兰堂把酒留嘉客。\n对离筵，驻行色。\n千里音尘便疏隔。\n合有人相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睿恩新 其一","author":"晏殊","text":"芙蓉一朵霜秋色。\n迎晓露、依依先拆。\n似佳人、独立倾城，傍朱槛、暗传消息。\n静对西风脉脉。\n金蕊绽、粉红如滴。\n向兰堂、莫厌重深，免清夜、微寒渐逼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睿恩新 其二","author":"晏殊","text":"红丝一曲傍阶砌。\n珠露下、独呈纤丽。\n剪鲛绡、碎作香英，分彩线、簇成娇蕊。\n向晚群花欲悴。\n放朵朵、似延秋意。\n待佳人、插向钗头，更袅袅、低临凤髻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殢人娇 其一","author":"晏殊","text":"二月春风，正是杨花满路。\n那堪更、别离情绪。\n罗巾掩泪，任粉痕沾污。\n争奈向、千留万留不住。\n玉酒频倾，宿眉愁聚。\n空肠断、宝筝弦柱。\n人间后会，又不知何处。\n魂梦里、也须时时飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殢人娇 其三","author":"晏殊","text":"一叶秋高，向夕红兰露坠。\n风月好、乍凉天气。\n长生此日，见人中嘉瑞。\n斟寿酒、重唱妙声珠缀。\n凤管移宫，钿衫回袂。\n帘影动、鹊炉香细。\n南真宝箓，赐玉京千岁。\n良会永、莫惜流霞同醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殢人娇 其二","author":"晏殊","text":"玉树微凉，渐觉银河影转。\n林叶静、疏红欲遍。\n朱帘细雨，尚迟留归燕。\n嘉庆日、多少世人良愿。\n楚竹惊鸾，秦筝起雁。\n萦舞袖、急翻罗荐。\n云回一曲，更轻栊檀板。\n香炷远、同祝寿期无限。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其五","author":"晏殊","text":"梨叶疏红蝉韵歇。\n银汉风高，玉管声凄切。\n枕簟乍凉铜漏咽。\n谁教社燕轻离别。\n草际蛩吟珠露结。\n宿酒醒来，不记归时节。\n多少衷肠犹未说。\n朱帘一夜朦胧月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其六","author":"晏殊","text":"南雁依稀回侧阵。\n雪霁墙阴，偏觉兰芽嫩。\n中夜梦馀消酒困。\n炉香卷穗灯生晕。\n急景流年都一瞬。\n往事前欢，未免萦方寸。\n腊后花期知渐近。\n寒梅已作东风信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"晏殊","text":"一霎秋风惊画扇。\n艳粉娇红，尚拆荷花面。\n草际露垂虫响遍。\n珠帘不下留归燕。\n扫掠亭台开小院。\n四坐清欢，莫放金杯浅。\n龟鹤命长松寿远。\n阳春一曲情千万。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"晏殊","text":"紫菊初生朱槿坠。\n月好风清，渐有中秋意。\n更漏乍长天似水。\n银屏展尽遥山翠。\n绣幕卷波香引穗。\n急管繁弦，共庆人间瑞。\n满酌玉杯萦舞袂。\n南春祝寿千千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"晏殊","text":"玉碗冰寒消暑气。\n碧簟纱厨，向午朦胧睡。\n莺舌惺松如会意。\n无端画扇惊飞起。\n雨后初凉生水际。\n人面荷花，的的遥相似。\n眼看红芳犹抱蕊。\n丛中已结新莲子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"晏殊","text":"槛菊愁烟兰泣露，罗幕轻寒，燕子双飞去。\n明月不谙离恨苦，斜光到晓穿朱户。\n昨夜西风凋碧树，独上高楼，望尽天涯路。\n欲寄彩笺兼尺素，山长水阔知何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其一","author":"晏殊","text":"细草愁烟，幽花怯露，凭栏总是销魂处。\n日高深院静无人，时时海燕双飞去。\n带缓罗衣，香残蕙炷，天长不禁迢迢路。\n垂杨只解惹春风，何曾系得行人住！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其三","author":"晏殊","text":"碧海无波，瑶台有路。\n思量便合双飞去。\n当时轻别意中人，山长水远知何处。\n绮席凝尘，香闺掩雾。\n红笺小字凭谁附。\n高楼目尽欲黄昏，梧桐叶上萧萧雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其五","author":"晏殊","text":"小径红稀，芳郊绿遍，高台树色阴阴见。\n春风不解禁杨花，蒙蒙乱扑行人面。\n翠叶藏莺，朱帘隔燕，炉香静逐游丝转。\n一场愁梦酒醒时，斜阳却照深深院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其四","author":"晏殊","text":"绿树归莺，雕梁别燕。\n春光一去如流电。\n当歌对酒莫沈吟，人生有限情无限。\n弱袂萦春，修蛾写怨。\n秦筝宝柱频移雁。\n尊中绿醑意中人，花朝月夜长相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其二","author":"晏殊","text":"祖席离歌，长亭别宴，香尘已隔犹回面。\n居人匹马映林嘶，行人去棹依波转。\n画阁魂销，高楼目断，斜阳只送平波远。\n无穷无尽是离愁，天涯地角寻思遍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"撼庭秋","author":"晏殊","text":"别来音信千里，怅此情难寄。\n碧纱秋月，梧桐夜雨，几回无寐。\n楼高目断，天遥云黯，只堪憔悴。\n念兰堂红烛，心长焰短，向人垂泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕归梁 其二","author":"晏殊","text":"金鸭香炉起瑞烟。\n呈妙舞开筵。\n阳春一曲动朱弦。\n斟美酒、泛觥船。\n中秋五日，风清露爽，犹是早凉天。\n蟠桃花发一千年。\n祝长寿、比神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕归梁 其一","author":"晏殊","text":"双燕归飞绕画堂。\n似留恋虹梁。\n清风明月好时光。\n更何况、绮筵张。\n云衫侍女，频倾寿酒，加意动笙簧。\n人人心在玉炉香。\n庆佳会、祝延长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四十八","author":"晏殊","text":"蟹螯今在左，欲拍酒船浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十七","author":"晏殊","text":"漫取忠臣比芳草，不知谗口起椒兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]