[{"title":"鹧鸪天 其九","author":"周紫芝","text":"终日看山不厌山。\n寻思百计不如闲。\n何时得到重阳日，醉把茱萸仔细看。\n敧醉帽，倚雕阑。\n偶然携酒却成欢。\n篱边黄菊关心事，触误愁人到酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十三","author":"周紫芝","text":"花褪残红绿满枝。\n嫩寒犹透薄罗衣。\n池塘雨细双鸳睡，杨柳风轻小燕飞。\n人别后，酒醒时。\n午窗残梦子规啼。\n尊前心事人谁问，花底闲愁春又归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十二","author":"周紫芝","text":"彩鹢双飞雪浪翻。\n楚歌声转绿杨湾。\n一川红旆初衔日，两岸朱楼不下帘。\n阑倚处，玉垂纤。\n白团扇底藕丝衫。\n未成密约回秋水，看得羞时隔画檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名 其一 和人春词","author":"周煇","text":"卷帘试约东君，问花信风来第几番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名 其二 和人蜡梅词","author":"周煇","text":"生怕冻损蜂房，胆瓶汤浸，且与温存著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏瑞粟 其一","author":"周遇圣","text":"瑞出双莲与九芝，何如瑞粟见明时。\n一根异彼禾同颖，四穗多于麦两岐。\n纪载简编前未有，献诸郡国事非欺。\n三年宰邑书成绩，悠久难磨颂德碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏瑞粟 其二","author":"周遇圣","text":"淳居万山巅，土瘠稀良田。\n丰歉系饥饱，民命悬于天。\n人忧庚子歉，我见为丰年。\n蚕登百谷熟，箱万仓盈千。\n异哉粟四穗，一干生南阡。\n岂无连理木，亦有双华莲。\n维兹孕瑞粟，庶补民艰鲜。\n嘉生本协气，此事非偶然。\n窃闻野老说，守令仁且贤。\n官清简案牍，刑省空扉圜。\n农耕士力学，工肆商充廛。\n午鸡桑树鸣，夜犬花村眠。\n君不见渔阳歌秀麦，善政青史编。\n又不见中牟书嘉禾，德化今古传。\n猗欤际圣代，奇祥呈八埏。\n愿言叫阊阖，入奏冕旒前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 饮饯元龄诸公席上戏作","author":"周颉","text":"郧城清胜压湖湘。\n人物镇相望。\n秀气谁符楚泽，建安诸子文章。\n东风得意，青云路稳，好去腾骧。\n要识登科次第，待看北斗光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚菊","author":"周嵩","text":"落日西风弄晚晴，东篱曲曲灿金英。\n先生茅舍终年淡，惟有寒芳不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山楼秋夜","author":"周嵩","text":"孤形侣云汉，凉思满山楼。\n高树自吟籁，清樽聊赏幽。\n检书初志动，抚剑壮心留。\n蟋蟀不知事，喧声何不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"讼风","author":"周嵩","text":"西风云战急，杀气横干戈。\n有客怀乡坐，无邻送酒过。\n布袍欣豫暖，冻笔苦新呵。\n默诉玄冥后，天涯征戍多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近闻","author":"周嵩","text":"斜阳淡紫弄晖晖，泽国霜前落木稀。\n远忆东皇沉羽驾，近闻山鬼泣萝衣。\n画溪黑夜双龙吼，霞幕清秋一鹤飞。\n送尽海天千里目，伶仃洋里有谁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次秋山月上人韵","author":"周暕","text":"十指曾弹月下琴，已知太古有遗音。\n三乘四谛无非道，万法千门只此心。\n得句何妨闻鼓□，□机不复有魔侵。\n近来□□□□□，无奈□□三尺深。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次僧韵","author":"周暕","text":"曾对寒炉细画灰，几番回首重徘徊。\n山间已有幽人占，门外宁教俗子来。\n老杜句留修觉寺，东坡诗在妙高台。\n新凉拟办登山屐，莫待黄花逸兴催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归蜀","author":"周暕","text":"诗禅寄杖锡，不问道途难。\n到水浮杯渡，逢山卸笠看。\n悟空诸念寂，传佛一灯寒。\n蜀国又归去，令人忆道安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻平湖僧绍义自岭归又入浙","author":"周暕","text":"曾写当年送别诗，小窗几度梦魂飞。\n句从薝卜林中得，人在梅花岭外归。\n礼罢祖师无有相，遍参老宿悟来机。\n归舟久驻西湖上，闻道新来景又非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄悦上人","author":"周暕","text":"一锡千峰远，闻师住少林。\n云生坐处石，佛见定时心。\n清福人间少，红尘山外深。\n何当重问讯，来借朱堂吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲秃笔","author":"周献甫","text":"中书君己不中书，椎钝无心费指呼。\n别有管城堪任使，从教骂作笔头奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟轩","author":"周献甫","text":"何以号吟轩，疏窗矮屋椽。\n纸抄唐绝句，壁写宋诗篇。\n闲或支颐坐，慵来枕肘眠。\n读他三两意，心下自欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邹震父迁居界步","author":"周献甫","text":"买得林庐在水西，眼前幽事总相宜。\n溪山处分莺看管，梅竹添差鹤护持。\n旋理小园增野趣，先留隙地作楼基。\n却来界步晴岚底，收拾湄湘八景诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羃窗","author":"周献甫","text":"薄纸新糊就，翛然一室清。\n有风寒不到，无月夜能明。\n暂隔前山色，时敲落叶声。\n冻蝇可憎汝，钻扑漫营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋扉","author":"周献甫","text":"暂别斋扉数日馀，重来整顿案头书。\n砚池乾恐蚍蜉入，笔管闲容果裸居。\n叶长密留梅实少，笋生多补竹茎疏。\n匆匆未暇供吟课，莺送清声一起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吕伯祐","author":"周锡","text":"龙门居士隐江滨，老去风流乐事真。\n觞咏又临三月暮，李桃初种一溪春。\n眼中信我无馀子，名下如君有几人。\n淯溪不尽东流水，两字平安托锦鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月五日西郊口占","author":"周端臣","text":"晴日西郊按物华，东风寒峭帽檐斜。\n江梅已办调羹事，交割春光与杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕","author":"周端臣","text":"小院春寒月到迟，闭门閒课上元诗。\n南来父老消磨尽，耳畔无人说旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内人烧香图","author":"周端臣","text":"花底烧香深闭门，宫鸦栖了已黄昏。\n君王未识无人妒，虽不承恩却感恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其三十","author":"周端臣","text":"小雨班班湿画栏，一番重做杏花寒。\n春衫拈起还慵著，却忆天涯客袂单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十九","author":"周端臣","text":"弹罢瑶筝歇雁行，月移花影上回廊。\n离情不奈秋萧索，更著寒螀管夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十八","author":"周端臣","text":"依旧斜阳燕子楼，共谁把酒话閒愁。\n韦娘去后西风老，烂漫黄花满院秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十七","author":"周端臣","text":"楝花筛雪糁苍苔，人未归来燕已来。\n满眼春惊连日老，两眉愁是几时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十六","author":"周端臣","text":"蜂蝶飞飞春事忙，煖风池馆百花香。\n连花折得青梅子，怕触心酸不敢尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十五","author":"周端臣","text":"春娇残醉睡初回，索酒扶头强起来。\n金斗压灰熏笃耨，玉瓶?水养徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十四","author":"周端臣","text":"双蛾颦翠恨天涯，睡起蜂黄沁脸霞。\n燕子日长深院静，东风无力到杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十三","author":"周端臣","text":"压髻慵簪双凤钗，伤心羞觑合欢鞋。\n折花暗卜郎音信，旋系罗裙走下阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古断肠曲三十首 其二十二","author":"周端臣","text":"脩竹生烟晚逗阴，翠罗香袖怯寒侵。\n恨同社燕身为客，怕剥秋莲苦在心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c4