[{"title":"龙华寺傅大士真身像","author":"韩元吉","text":"古寺郊丘侧，钟鱼晓未喧。\n双林有遗骨，瑞萼记名园。\n粒石嗟馀饭，神槌想叩门。\n蚕桑犹有谒，鼓舞动山村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亚之出示其祖岐公墨迹及惠崇小景且和前韵复次答之","author":"韩元吉","text":"壁上春江万顷宽，锦囊遗墨幸重看。\n功名世路真多畏，贫贱交盟敢自寒。\n新有诗声见侯喜，尽摅怀抱得苏端。\n极知鼎食君家旧，未厌堆盘苜蓿餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏日诸君小集沈明远以小疾不预作诗戏之","author":"韩元吉","text":"广文官冷酒钱空，平日清樽一笑同。\n苦忆车公来座上，翻成王老隐墙东。\n定中示病应非病，诗里能穷有底穷。\n凉月满天新雨足，试凭檄语愈头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会稽道中有感","author":"韩元吉","text":"稠红乱紫正芳菲，寒食青门客自归。\n江上酒醒闻燕语，日斜睡足看花飞。\n功名老去真何在，丘壑平生岂愿违。\n尚喜系船探禹穴，稽山云淡雨霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵戏传道","author":"韩元吉","text":"空谷天寒翠袖遮，无人曾见玉钗斜。\n诗成落日千寻竹，歌就残阳万点鸦。\n妆额浅深知内样，舞衣裁剪胜京华。\n自怜已作高唐梦，须信饥肠眼易花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再至凌风亭","author":"韩元吉","text":"目尽西山落照边，危亭风景故依然。\n重来身忝二千石，老去心惊十九年。\n种柳已高丹槛外，栽花犹占绿窗前。\n不堪素发纷垂领，还愧青春令尹贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘子宣侍郎挽词","author":"韩元吉","text":"妙龄嘉誉满江东，晚接甘泉豹尾中。\n烜赫身荣知有道，从容心计不言功。\n威行岘首追羊叔，名在鄱江忆鲁公。\n种木十年归莫遂，涂车千里恨何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘子渊监庙年八十六耳目聪明能饮酒举大白喜赋诗比过之因示长句次其韵","author":"韩元吉","text":"才疏政拙愧能名，黄发犹欣见老成。\n林壤固知聊自乐，门闾要是已堪旌。\n持杯潋滟千眉耸，落笔纵横四坐惊。\n笳鼓过君应一笑，平田两部足蛙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同叶梦锡赵德庄游牛首山","author":"韩元吉","text":"不辞扶病触春寒，及此新晴一日閒。\n云外经年见双阙，马头乘兴数前山。\n清泉细酌巉岩上，佛窟同探紫翠间。\n我亦无心话禅悦，衔花百鸟自飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕伯恭挽词","author":"韩元吉","text":"青云涂路本青毡，圣愿相期四十年。\n台阁久嗟君卧疾，山林空叹我华颠。\n伤心二女同新穴，拭目诸生续旧编。\n斗酒无因相沃酹，朔风东望涕潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有童子市龟七以百金得而放之","author":"韩元吉","text":"百金为换七玄衣，自启筠笼俯钓矶。\n白水真人聊并聘，清江使者遂同归。\n负图可但逢时出，曳尾宁须与世违。\n好去沧波莫回首，馀不亭下柳依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云归兴","author":"韩元吉","text":"湖海周游未卜居，好山时一梦衡庐。\n苦无事业堪调鼎，薄有生涯可负锄。\n玩世阮公方蜡屐，归田陶令亦巾车。\n屋头早晚东西住，愁绝江船夜雨馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云盱眙道中三首 其三","author":"韩元吉","text":"桑间无褐半饥人，斗粟千金不换银。\n末路多惭逭沟壑，长年敢笑走埃尘。\n江声直下黄牛峡，河势遥分白马津。\n回首向来征战地，壮怀俱在只伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云盱眙道中三首 其二","author":"韩元吉","text":"江南淮北市初通，人语忻忻作好风。\n抱耒只思耕陇底，买船谁复渡辽东。\n向来熊耳真投甲，此去天山拟挂弓。\n上策圣君今自治，白头忧国寸心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云盱眙道中三首 其一","author":"韩元吉","text":"海上狼烽不起烟，兵戈犹记旧年前。\n岩居有客能招饮，肉食何人为给鲜。\n但得生涯类盘谷，可无风景似斜川。\n共寻糊口田三亩，仍办遮头屋数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日 其一","author":"韩元吉","text":"林壤欣欣乐有馀，杖藜常及晓莺初。\n春风入户花开落，晴日当窗云卷舒。\n契阔经年千里面，平安满眼数行书。\n弟兄州县真劳尔，畴昔交游半石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日 其二","author":"韩元吉","text":"问舍求田苦未成，定逢丘壑眼先明。\n极知官事无时了，且作青山任意行。\n元亮折腰应自笑，子荆洗耳讵忘情。\n不妨同是催科拙，下考他年更类城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日见怀二首 其二","author":"韩元吉","text":"山寺莺花里，悬知载酒行。\n青春随梦断，白发伴愁生。\n烂醉真吾事，忘机岂世情。\n书来得佳句，双眼暂增明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日见怀二首 其一","author":"韩元吉","text":"每惜春光去，生憎鶗鴂鸣。\n倦游心易赏，多病戍仍更。\n风雨山花过，池塘野水生。\n买牛归问舍，此计会应成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云途中见寄 其一","author":"韩元吉","text":"轻风猎猎转残红，春去荒村暮雨中。\n花影带寒犹黯淡，山光和雾更空濛。\n百年拚却身长醉，五斗由来计日穷。\n惭愧宾朋有胶漆，不堪兄弟苦西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云途中见寄 其二","author":"韩元吉","text":"十年计拙未能伸，四海滔滔总是津。\n但得有山供醉眼，不忧无地著寒身。\n莺花撩乱空三月，风雨凄凉过几旬。\n莫道衡阳无雁信，故应时有北来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王季夷时同宿蒋山","author":"韩元吉","text":"亭亭石塔宝公龛，剩喜僧床得对谈。\n坎壈词场君亦滞，驱驰世路我何堪。\n军书又见纷南北，敌势由来说二三。\n淮岸西风晚更急，似传烽火过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王亚之来过横碧","author":"韩元吉","text":"君到层轩眼为宽，诸峰还得雨中看。\n岚光照座苍翠出，寺影拂波金碧寒。\n诗兴岂妨随望极，秋声不柰起愁端。\n相逢莫怪无樽酒，秀色崔嵬尚可餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵任信儒见过","author":"韩元吉","text":"斗雀嗟穷巷，鸣驺枉故人。\n尘埃生破甑，风雨垫乌巾。\n别久情逾厚，诗来语更新。\n囊空得珠玉，此段不全贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵余寺正瑞香花","author":"韩元吉","text":"香炉峰下异香风，长忆幽芳梦寐通。\n渴雨旋倾茶作椀，护霜新织翠成笼。\n丹青点缀琼瑶上，兰麝飞浮锦绣中。\n花品向来谁第一，似挼玉蕊间鞓红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吴明可与史致道会饮牛渚","author":"韩元吉","text":"月出千山捲暮云，遥知玉节会江滨。\n便应击楫酬今日，不用然犀叹昔人。\n烟外笛声谁送晚，水边花影自迎春。\n风流三百年无此，况有清诗句法新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宋传道夜雨闻捷 其一","author":"韩元吉","text":"松庭竹户野僧家，独坐荒斋到日斜。\n门外江风寒作雨，城头戍鼓夜啼鸦。\n对床更欲论心事，拥褐还惊逼岁华。\n却忆巴山旧时语，梦回窗竹已生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宋传道夜雨闻捷 其二","author":"韩元吉","text":"边地山川自汉家，蜂旗图画拂云斜。\n江干战骑膺如虎，塞上神兵斧似鸦。\n羽檄故应烦号令，星车底用赋皇华。\n军声指日腾三捷，阵势他年本六花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张子仪仓司展翠亭","author":"韩元吉","text":"官事常忙心自閒，故应拄笏为西山。\n举头但觉来风月，著足何妨涉阓阛。\n振廪功成聊共醉，追锋诏下合俱还。\n须知苍翠看无尽，输我岩居昼掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张晋彦书事","author":"韩元吉","text":"颉利何时缚，康居久未灰。\n天威如自震，敌势不难摧。\n日月丹心在，风尘白眼开。\n受降城旋筑，且缓羽书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张晋彦书事","author":"韩元吉","text":"举世诸兄事孔方，平生学易问归藏。\n渐欣过客知吾懒，未怪小儿如我长。\n鹤怨猿惊成底事，乌踆兔蹶自奔忙。\n便须耳热追行乐，更拟心斋得坐忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李子永见庆新居","author":"韩元吉","text":"旋移桐树占高冈，更喜松筠翠作行。\n檐外参差见林影，门前溶漾足溪光。\n天涯留落还相识，地上经营岂太忙。\n好事肯来三径在，已添篱菊待重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沆侄","author":"韩元吉","text":"平生作计本山林，便腹空馀贮古今。\n致主未忘他日志，归耕每动十年心。\n疏翎浪喜烟霄近，弱植多惭雨露深。\n早决儒科犹望汝，蛩然虚谷伫闻音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沈千里玉山道中见寄","author":"韩元吉","text":"霜晴怀玉自生烟，寒色凄凄过雁边。\n路转湘南知几日，山连楚尾又穷年。\n相期鸡黍情欢甚，惜别尘埃意黯然。\n马上哦诗冲暮雪，清风怀我北窗眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沈驹甫观石井","author":"韩元吉","text":"湖里鴐鹅亦洞天，最奇山下石坳泉。\n一泓自觉寒光净，六月都无暑气煎。\n清似锡峰藏雨露，迥如篁岭个风烟。\n壁端旧乏骚人句，从此须君妙墨传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沈驹甫留别","author":"韩元吉","text":"笔下纵横自学林，胸中玉海更清深。\n识君异县见眉宇，过我空山聆足音。\n月近中秋还惜别，雪飞穷腊会重临。\n闲门剥啄谁相问，与客宁论旧与今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈子象谢新火诗","author":"韩元吉","text":"曲水流觞迹易陈，水边那复御厨珍。\n茶烟永日看轻飏，槐火今年又一新。\n邻舍未应烦束缊，官庖犹幸有舆薪。\n须公更试长檠夜，剩照歌台拂镜尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵金元鼎新年七十 其二","author":"韩元吉","text":"论文倾满座，嗜酒见天真。\n旧惬李君驭，今怀王翰邻。\n欢情知老大，诗话倍清新。\n莫作悬车念，滔滔且问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵金元鼎新年七十 其一","author":"韩元吉","text":"七十古稀有，君今还倦游。\n危机直虎口，薄利祇蝇头。\n黄发宜登用，清时忍退休。\n遥知江上宅，聊近水边鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵仲绩久雨夜坐有感二首 其二","author":"韩元吉","text":"十日风斜雨更横，一春能得几新晴。\n便须蜡屐穿花去，莫惜障泥傍水行。\n酒兴未妨随处发，诗狂剩判隔年程。\n醉来乞得西山药，彷佛云间吹凤笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵仲绩久雨夜坐有感二首 其一","author":"韩元吉","text":"春云黯黯未成晴，落尽缃桃见紫荆。\n薄宦驰驱双鬓改，流年荏苒寸心惊。\n幽花映水浅深色，啼鸟穿林高下声。\n几许风光欠行乐，夜寒和雨听残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵任卿至北苑二首 其二","author":"韩元吉","text":"好雨惊连夜，疏钟喜报晨。\n池心春涨绿，花面晓妆匀。\n野渡经年别，官茶几焙新。\n风光为传语，何事曲江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵任卿至北苑二首 其一","author":"韩元吉","text":"行乐须春事，微官日自忙。\n轻云弄天色，细雨出风光。\n筠甲连山破，林髯夹道苍。\n拟寻花岛去，更待茗芽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐应祺小楼","author":"韩元吉","text":"潋潋清波泊路衢，垂垂高柳对扶疏。\n已知百尺楼堪卧，况有三重茅可居。\n我老讵能赓鲍谢，君才端合绍严徐。\n直须座上千钟酒，浇起胸中万卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵梁子张雪中约游湖上不至","author":"韩元吉","text":"东风阁雨酿重云，剩喜天街玉作尘。\n梅已著花还点缀，柳能吹絮便争新。\n湖光照坐偏宜晚，酒力攲栏别是春。\n惭愧相如未能至，却将冰柱语惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄文刚秀才雪中见诒且惠新柑","author":"韩元吉","text":"填空密雪借风威，深闭蓬窗昼掩扉。\n待学仙人乘鹤驾，未容寒士泣牛衣。\n连篇妙语千金重，满合黄柑数寸围。\n细酌清樽酬夜月，更看庭树作花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵曾吉甫题画屏风","author":"韩元吉","text":"何许江山发兴长，浑疑庐阜对彭郎。\n胸中丘壑元萧爽，笔下烟波故渺茫。\n落落疏松长映座，冥冥飞雨欲侵床。\n冷然已作华胥梦，便有群仙到枕旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答沈明远","author":"韩元吉","text":"如君绝足向风尘，顾我宜为途路人。\n阿买八分时自笑，阮瞻三语讵能新。\n狂谈尚欲嘲风伯，妙笔真堪赋洛神。\n得酒相寻那厌数，醉归官长未应嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩子师雪中二首 其二","author":"韩元吉","text":"曲栏高槛倚崔嵬，要是仙京白玉台。\n云色自连鳷鹊动，天颜亦为近臣开。\n光翻午夜浑疑月，花满新春未数梅。\n自笑诗成无好语，但知缟带与银杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩子师雪中二首 其一","author":"韩元吉","text":"九门叠璧耀朝暾，不比千灯作上元。\n天与蕊珠开汉殿，人将冰玉奉尧樽。\n寒威已觉边声静，春意都随诏语温。\n夜入蔡州飞将在，肯容敌骑妄称尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵鲁如晖雪晴","author":"韩元吉","text":"腊近千门雪，风高一夜晴。\n醉馀和被拥，梦破觉窗明。\n鼙鼓三年戍，关河万里情。\n应怜铁甲冷，烽火未须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红梅","author":"韩元吉","text":"不随群艳竞年芳，独自施朱对雪霜。\n越女漫夸天下白，寿阳还作醉时妆。\n半依脩竹馀真态，错认夭桃有暗香。\n月底瑶台清梦到，霓裳新换舞衣长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过芙蓉对镜岭","author":"韩元吉","text":"世事日千变，劳生忧患多。\n谁知度炎热，正尔陟嵯峨。\n峰矗莲初绽，崖枯镜未磨。\n江东兹绝险，叹我两经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过庞祐甫","author":"韩元吉","text":"半亩方园水到门，地偏人静恰如村。\n声名不用卿王衍，文字真能仆屈原。\n举世知君如我少，平生学道欲谁论。\n何时共结柴桑社，篱下秋来菊正繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过松江寄务观五首 其五","author":"韩元吉","text":"并舍尽垂柳，出檐多好花。\n独寻江岸路，静爱野人家。\n水暖分鱼子，沙晴蹙荻芽。\n放歌吾亦醉，渔户即生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过松江寄务观五首 其四","author":"韩元吉","text":"湖岸见亭馆，谁家长锁门。\n主人宁好事，渌水但名园。\n借我安茅屋，容君共酒樽。\n风波正奔走，独立望江村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过松江寄务观五首 其三","author":"韩元吉","text":"一别未十日，举头杨柳黄。\n蜂来知酒美，梅度觉船香。\n岸帻春容好，翻书昼景长。\n无人共谈麈，自酌引壶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过松江寄务观五首 其二","author":"韩元吉","text":"风浪白如屋，垂虹烟霭间。\n清心太湖水，满眼洞庭山。\n放鹤迎人舞，飞鸥伴我閒。\n是中有佳句，诗思未容悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过松江寄务观五首 其一","author":"韩元吉","text":"四海习凿齿，云间陆士龙。\n酒狂须一石，文好自三冬。\n风水客愁远，烟花春事浓。\n还将枕流耳，来听景阳钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过武夷","author":"韩元吉","text":"不到仙山二十年，道人双鬓亦皤然。\n却看翠岭千寻石，又汎清溪九曲船。\n目极已高聊自喜，身轻欲上可无缘。\n只应猿鹤遥相认，笑我归耕未有田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过赵仲缜","author":"韩元吉","text":"山下清溪溪上亭，竹阴芳径眼增明。\n已知数日逢寒食，剩喜今朝作好晴。\n酒美故应容客醉，歌长不自觉诗成。\n春深准拟多行乐，却作花前送我行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至上饶寄子云","author":"韩元吉","text":"险阻艰难客路赊，东西南北问生涯。\n秋声瑟缩生梧叶，野景萧疏上菊花。\n去国已惊身老大，无家空有泪横斜。\n遥知载酒齐山寺，应忆年时醉月华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别范元卿","author":"韩元吉","text":"晴林绿树越江边，聊泊东来倦客船。\n风引花香微近酒，水浮月色澹连天。\n惊心朋旧皆千里，回首光阴又五年。\n莫笑相逢便离别，此生身计已飘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听雨","author":"韩元吉","text":"昨夜灯花暗，今晨雨意深。\n残花惟有叶，新笋已成林。\n未办扶头饮，聊为拥鼻吟。\n兴阑幽梦断，檐际足清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]