[{"title":"送蒋肖韩","author":"薛师石","text":"岳阳有仙迹，君去颇相宜。\n已料官閒日，多吟湘水诗。\n高风琴断裂，白月酒涟漪。\n无意求人荐，惟应我自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋肖韩赴弋阳","author":"薛师石","text":"弋水桥边接长官，水晶山色让清寒。\n共知彫弊今称剧，自倚廉勤道不难。\n吏退早衙花谷静，鹤翔秋戺讼庭宽。\n从来遇事无凝滞，应只忧民劳寸丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谢强学主建德簿","author":"薛师石","text":"少年初试吏，濯印富春亭。\n水可清人骨，山曾隐客星。\n俸廉专母养，政简静公庭。\n守是贤侯子，应看荐墨青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谨师","author":"薛师石","text":"谨师牢绊脚，语别意茫茫。\n入寺春随杖，当禅月满床。\n多因新见解，抛却旧篇章。\n为我金山去，钳锤问一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鲍份父","author":"薛师石","text":"地僻官仍小，兹行古迹多。\n矩罗应失笑，庞媪亦经过。\n宦业知馀事，宗风竟若何。\n□□□□□，满舍是青莎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭周宗彝","author":"薛师石","text":"已叹交情看渐少，闻君怛化重伤神。\n手栽寒竹惟添笋，堂掩空山不见人。\n旧说媾婚今且置，新怀情悃向谁陈。\n独怜头白曾参母，清夜悲号血泪频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋耆卿","author":"薛师石","text":"人如韫玉操如冰，拾芥推梨世岂能。\n案上有琴亡旧响，墓头无火续寒灯。\n一官祗是幽閒过，百行惟须健笔称。\n此曲调高知者少，朗吟唤得九原应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈叔望","author":"薛师石","text":"少年曾是鲁诸生，为立功名别路行。\n尝捉宝刀严汉陛，再持符节领江城。\n绝怜诗律双金在，不见林塘五柳成。\n明日西山归葬处，踏青人散草初平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽林敬之","author":"薛师石","text":"闭门常读易，遁世意如何。\n有酒可消闷，无阶不种莎。\n閒时寻旧友，月夜步新河。\n我亦逃名者，题碑愧尔多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵孺人余中表也","author":"薛师石","text":"幼小同群戏，年加各所之。\n常疑艳花卉，终是易离披。\n夫婿新袍绿，儿男半发垂。\n送归蒿里道，兴我渭阳思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽徐左史","author":"薛师石","text":"左史声名空复存，如今往事不堪论。\n惟应指佞当前陛，已判身归老故园。\n骢马引丧寒有泪，麒麟卧冢寂无言。\n人生遇合萍相似，何处分明怨与恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽徐道晖","author":"薛师石","text":"昌黎铭最好，朋友更情深。\n身没复何憾，家贫自不禁。\n春山无死草，夏木有清阴。\n为鬼诗还别，重来何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽潘母","author":"薛师石","text":"独玩隔厅月，凄凉三十年。\n渺然儒素业，翻以母仪传。\n生计无中有，衰龄病后延。\n谁为市贞石，高刻墓之前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿瞿溪","author":"薛师石","text":"船泊溪西岸，人家见晚舂。\n疏星寒有雁，村寺夜无钟。\n竹径通新店，茅柴煖病容。\n农夫不相识，问我欲何从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄守上人归闽省亲","author":"薛师石","text":"从小服缁素，三衣竟不长。\n心空无物碍，顶重有诗囊。\n去与云相似，来期春未央。\n家山指萱草，微笑奉高堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵叔鲁","author":"薛师石","text":"相知言莫尽，别后意如何。\n命笑春冰薄，愁因夜雨多。\n全家寓京国，无地著吟哦。\n会得穷通理，从余缉薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵紫芝","author":"薛师石","text":"别后访消息，传言一半虚。\n前官已不就，所向定何如。\n苦雨厌羁思，春风欺旧庐。\n怀人闭门夕，专拟寄来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄雁荡诗僧","author":"薛师石","text":"雁荡峰前夜雨晴，空房不住有蝉声。\n一身閒后发难白，五字吟来思极清。\n少见出山多入定，还于夏末起秋程。\n何如更待黄花节，顾我来游计已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蔡任","author":"薛师石","text":"不见三百日，问君消息多。\n身閒诗有味，水净月无波。\n琴里怀孤竹，书中寄永和。\n遥怜一江隔，何计得相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家","author":"薛师石","text":"小舟轻似叶，曾不畏风涛。\n自说磻溪好，翻疑钓濑高。\n晚来鱼换酒，归去子持篙。\n定是逃名者，时闻歌楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜叶谦夫归","author":"薛师石","text":"老思忽萧爽，亲朋得意归。\n菊觞奉亲寿，柳色上儒衣。\n宅旺看山势，门清有钓矶。\n我来聊问字，澹坐月侵扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜徐玑至","author":"薛师石","text":"荣满自南归，曾过秦系庐。\n无心缘见道，会面只如初。\n诗好多人说，官清得荐书。\n柴门劳顾访，未觉四年疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塔山和徐道晖壁间韵","author":"薛师石","text":"寺在一山顶，江分两岸田。\n凭何发诗兴，题字古廊边。\n近地今埋骨，閒人亦助钱。\n昨宵留宿意，不忍上归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上","author":"薛师石","text":"势利绝交初，瞿然卧隐庐。\n无营心淡泊，见客礼生疏。\n游有渔樵伴，看多佛老书。\n春深草易长，忘却倩人锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢陈水云寄惠瓜庐字","author":"薛师石","text":"我向村中住，无人知姓名。\n结庐难得就，种树几时成。\n扁榜龙蛇动，飞檐燕雀惊。\n自怜幽僻地，因此亦敷荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬刘子至","author":"薛师石","text":"寄来书一纸，别后喜安和。\n想见清高极，吟成秋思多。\n山头灵运立，月下谪仙歌。\n共是江湖客，斜阳各晒蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠达西堂","author":"薛师石","text":"却罢住山缘，归来又十年。\n自知身是妄，常道钵休传。\n塔路脩来直，纱灯影处圆。\n与吾相对坐，语嘿尽通禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠葛天民","author":"薛师石","text":"逃禅已得计，易姓岂云非。\n自说身如幻，常人见亦稀。\n亭边看荷叶，楼上挂蓑衣。\n几夜苏堤月，随君瘦影归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠奭山人","author":"薛师石","text":"何人养道得如君，房接高楼半入云。\n山地栽梅寒蕊瘦，瓦炉留火夜香熏。\n看经寻义心逾静，默坐观身耳不闻。\n莫道门前是廛市，须知喧寂此中分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横参楼和老杜韵","author":"薛师石","text":"僻懒便幽处，江湖称隐心。\n地偏欣改观，楼豁喜初临。\n暖日低轻帽，良朋接短襟。\n潮声全有韵，帆影半回阴。\n翠麓添重色，鲈风出浅林。\n屿头烟瘴远，沙觜浪痕深。\n寂静云归壑，瓓珊月近参。\n人家已鼾睡，渔父尚讴吟。\n造化由来久，周回忽见今。\n爱他斜日照，颠倒数山沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下仙胜因寺有怀","author":"薛师石","text":"山中初寄隐，野寺一天星。\n路远有如此，客来应未能。\n蛩催寒妪纬，蝉杂夜僧经。\n忽忆忘形友，微吟自剔灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大龙湫","author":"薛师石","text":"昔闻天下山，衡岳称崇丘。\n又闻天下水，江汉为巨流。\n古有山海经，历历叙九州。\n李唐三百载，诗家无一留。\n及观郦道元，此地亦不收。\n不知诺矩那，何事能穷搜。\n我来玄妙境，万丈悬清湫。\n石壁去无极，百里弥道周。\n云气冒群岫，龙宫深以幽。\n轻舆岩壑底，竟日涉溪游。\n阴晴异瞻瞩，远近难搜搂。\n飘如飞素练，粲若散琳璆。\n风掀一潭雨，佛坐四时秋。\n喧呼势益骤，汹涌声弥吼。\n变化有如此，溥博谁与俦。\n吾谓神龙力，岂翳人鬼谋。\n稽首荷玄遇，久坐劳双眸。\n一杯却岚暑，旋步轰雷稠。\n以吾澹世虑，欻起杞人忧。\n何当骑天狼，满引射斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊子七月十一日","author":"薛师石","text":"贫因几首诗，閒高一著棋。\n瓜田常嘿坐，不愿有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瓜庐至日即事","author":"薛师石","text":"西山起还伏，插入万丈潭。\n渔叟操桂棹，樵歌过草庵。\n年荒酒味薄，天旱井泉甘。\n不愿丘园贲，惟将易自参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦曲","author":"薛师石","text":"夜梦佳人姱且长，星冠霞帔云衣裳。\n双眉浅淡画春色，两耳炫耀垂珠珰。\n细步逡巡倏相近，世道人情不敢问。\n敛容正笑发一言，不识巫山云雨恨。\n自从十五学仙经，今年二十身骨清。\n天上有籍升其名，长声短声歌紫琼。\n紫琼之章词宛转，永与人间风调远。\n馀声未竟钟鼓鸣，雾散烟收人不见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日游湖","author":"薛师石","text":"此心全剥落，今日一阳生。\n自分安身计，难逃素隐名。\n贫中闻道彻，閒里作诗清。\n别有求鱼者，笑余忧思盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学海楼和水心先生韵","author":"薛师石","text":"江口潮生夜语喧，月残唯有数星存。\n更凭高处观空阔，始悟乾坤是易门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金贤良","author":"薛师石","text":"虚号贤良岂疗饥，短衣结袖竟何为。\n空携痛哭能言策，不遇勤求下诏时。\n老去说诗犹有味，寒来索酒莫教迟。\n家贫身死知无计，自有傍人为立碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵叔鲁端行胡象德携酒见顾","author":"薛师石","text":"一贤二公子，枉驾瓜庐丘。\n烹鱼载美酒，竟夕为我留。\n评诗仍和曲，举白不计筹。\n情忘觉欢畅，礼厚愧莫酬。\n今朝风雨横，欲谢出无由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送叶季重之官吴门","author":"薛师石","text":"君继贤人业，试官阊阖门。\n但问要离墓，莫看真娘坟。\n虎丘寺前生野草，一花一叶皆丽好。\n用心冷淡不此嗜，自有诗礼长探讨。\n给旁馀閒庭庑空，小舆应亦上垂虹。\n桥边风驶寄书便，只写平安报乃翁。\n我惭空空易疏斥，时亦抠衣侍函席。\n春膏流滑傥寄将，待写续经藏屋壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵几道赴台州录事","author":"薛师石","text":"厅前绠汲何从来，清流海底通九垓。\n天河地脉㶏旋转，上中下井躔三台。\n满城桃花二仙种，方广金殿三门开。\n一时会上几许人，若匪佛种应仙才。\n于公徒知高其闾，岂识大化非胚胎。\n今兹送言暂相别，诗规笔诲纷崔嵬。\n傅说明星定入梦，方朔迹秽空谐诙。\n不昵不阿予与汝，古交淡淡无嫌猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵端行","author":"薛师石","text":"纷纷帝族贵，钦兹神秀门。\n永嘉分奕叶，甚盛二枝蕃。\n吾友天乐翁，实惟游之孙。\n身虽羁旅尽，诗则骚雅存。\n侄行有科第，作尉期高骞。\n是曰提刑后，令闻方腾喧。\n大心欲图南，小枝不在言。\n十年相聚首，伟论孰敢援。\n交比鲍叔知，志许诸葛论。\n分携乃明发，念我守故园。\n君往夫差国，不遣吴水浑。\n陆静玩蟾彩，江清烹鮈豚。\n邑宰话乡曲，官廨如荒村。\n昂藏信多暇，时忆朋友樽。\n穷达委天命，守道无竞奔。\n会当春风吹，梅实众花繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭刘咏道","author":"薛师石","text":"案上韩文与杜诗，小斋閒澹亦相宜。\n人怜贫病忧无计，自说文章乐未涯。\n礼合古初山友哭，袝从先世夕郎知。\n生平直谅嗟何往，不是哀辞是诔辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽张彦文提举","author":"薛师石","text":"七十童颜在，翛然物外幽。\n组衣藏蠹箧，散服上渔舟。\n此日移松葬，前时为菊留。\n山连象浦馆，谁记孟家游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读刘靖君碑","author":"薛师石","text":"儒生身上事皆成，身外浮华亦甚轻。\n种竹满山门径小，挂冠当路树枝横。\n几于颜子三生寿，分得陶潜一字名。\n何处时令见前辈，只看碑语自心清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄龙虎山道士孔野云","author":"薛师石","text":"上清三十六，院阁皆幽清。\n漱齿泉新汲，晞发日始升。\n自除烧墨灶，昼夕诵黄庭。\n所得异畴昔，出山畏逢迎。\n同当知非年，寄诗聊写情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢黄元信惠茶","author":"薛师石","text":"建溪金铤直几千，余性所嗜一已偏。\n寻常草卉不足进，龙团凤夸如珉坚。\n长须健卒前月到，手提茶器急取煎。\n妻儿攒眉笑苦涩，为言真味兹天然。\n易牙去已久，吾齿若贝编。\n枵肠岂废食，睡省非壮年。\n惜此馀香滞喉颊，巡除吟咏声諓諓。\n诗成寄题建宁郡，主茶官吏俱时贤。\n合同缄印一时毕，进奉飞驰争春妍。\n天子不敢尝，荐以寝庙先。\n定自褒嘉到属郡，趣君密迩玉炉烟。\n一以此味沃天下，邪魔驱扫无留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题赵十四知县听雨堂","author":"薛师石","text":"谁弹石上琴，涓涓流水响。\n主人性清旷，静夜发幽想。\n何心指蓬阆，取近对湫荡。\n应有可人来，烟蓑曳双桨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题赵紫芝墓","author":"薛师石","text":"辛未联诗别，九年成恍惚。\n大星坠地旋无光，君身入土名不没。\n吴越之水相交流，寂寞诗魂何处游。\n不闻孤鹤唤人醒，空见梅花似人影。\n无复东岩招谢客，应住西湖伴和靖。\n世上如今一句无，一灵独存势欲孤。\n我有生刍来未得，只愁宿草易荒芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅雨","author":"薛师石","text":"梅雨润兼旬，暑月不知夏。\n溪流三尺强，舟人惊昨夜。\n余家有瓜田，蘋藻纷揉藉。\n鱼虾失凭依，跳跃至床下。\n卑湿畏暮年，扶策升台榭。\n难愿方丈食，互市物踊价。\n四邻各凄凉，惟有酒可借。\n五月藉新白，咀嚼胜枣炙。\n闭门人事绝，向晚乌巾卸。\n震雷压不住，神龙未遑暇。\n或谓蛟为孽，胡不宁尔舍。\n旱涝政本农，偏惠及閒架。\n皇天无所私，未遽损禾稼。\n一洗天下清，作我圣人化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词 其二","author":"薛师石","text":"邻家船上小姑儿，相问如何是别离。\n双堕髻，一弯眉，爱看红鳞比目鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词 其一","author":"薛师石","text":"十载江湖不上船，捲篷高卧月明天。\n今夜泊，杏花村，只有笭箵当酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词 其七","author":"薛师石","text":"莫论轻重钓竿头，伴得船归即便休。\n酒味薄，胜空瓯，事事何须著意求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词 其四","author":"薛师石","text":"系船兰沚鲙长鲈，白袷方袍忽访吾。\n神甚爽，貌全枯，莫是当年楚大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜翁卷归","author":"薛师石","text":"我老寡俦侣，年荒值冬迫。\n膝下有啼寒，瓶中无储积。\n岂不展转思，自欠经营策。\n儒冠匪谬误，赋性素褊窄。\n渊明疑夙世，荷锄心便适。\n嗟余四友朋，惊见三化魄。\n一翁尚凄凉，六秩困行役。\n家贫病难愈，诗苦发全白。\n昨来叩我门，偶往比邻宅。\n闻语亟倒屣，已去倏无迹。\n知君怀百忧，虽出难久客。\n从今幸安居，况有旧泉石。\n清晨过穷庐，竟夕话畴昔。\n逝者已云远，相期守枯瘠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨柳枝 其四","author":"薛师石","text":"汴水堤边薪可束，永丰巷口绿成堆。\n盛衰到底皆惆怅，何不移根种马嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨柳枝 其二","author":"薛师石","text":"唯有高枝高莫攀，不堪攀处只堪看。\n怪得楼头画眉妇，春朝长自凭阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨柳枝 其一","author":"薛师石","text":"门前杨柳君莫折，长于折处生两枝。\n两枝难作一枝合，一心分作两心时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨柳枝 其三","author":"薛师石","text":"独于高处接阳和，占得春风分外多。\n须信繁华易摧折，不如柔弱拂江河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词 其五","author":"薛师石","text":"春融水暖百花开，独棹扁舟过钓台。\n鸥与鹭，莫相猜，不是逃名不肯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词 其三","author":"薛师石","text":"平明雾霭雨初晴，儿子敲针作钓成。\n香饵小，茧丝轻，钓得鱼儿不识名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词 其六","author":"薛师石","text":"夜来采石渡头眠，月下相逢李谪仙。\n歌一曲，别无言，白鹤飞来雪满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"薛师石","text":"半洞容千佛，诸峰共一云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"薛师石","text":"泉涌龙频跃，山灵鸟不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]