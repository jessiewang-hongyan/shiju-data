[{"title":"中夜","author":"陈舜俞","text":"强寝夜何永，通宵梦不成。\n晓灯寒有晕，跳蚤静闻声。\n宦拙宜身退，家贫长道情。\n自怜前计失，半世慕虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋佳月独游垂虹亭有怀胡完夫苏子瞻钱安道 其二 苏子瞻","author":"陈舜俞","text":"月光清极向中秋，千古松陵此夜游。\n寥泬更无云碍眼，沧浪合是我维舟。\n浮生未有明年约，浅酌聊资到眼留。\n辜负金波三万顷，诗豪草圣在杭州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋佳月独游垂虹亭有怀胡完夫苏子瞻钱安道 其三 钱安道","author":"陈舜俞","text":"玉兔光中系小桅，长虹影里倒樽罍。\n一年此夜清秋半，万里无云霁色开。\n月女婵娟如有旧，波神安稳亦怜才。\n合须豪饮酬佳赏，不共乌台御史来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋佳月独游垂虹亭有怀胡完夫苏子瞻钱安道 其一 胡完夫","author":"陈舜俞","text":"五湖人住觉天宽，有月清秋似广寒。\n玉鉴光中数毛发，长虹背上倚阑干。\n栖鸦误晓啼还住，白露沾衣湿又乾。\n借问姑苏胡别驾，簿书灯火共谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以橘赠湖州李公择","author":"陈舜俞","text":"去著登山屐，梦归清霅门。\n亲尝霜后橘，思侑府中樽。\n为问林间路，曾过水畔村。\n人言封境近，往往被公恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"陈舜俞","text":"凤去台存碧草浓，游人来此问遗踪。\n故巢风月已千载，好景阑干空数重。\n府坐循良黄太守，舆乘仁圣汉高宗。\n竹花生子梧桐老，底事丹山信未逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天池院","author":"陈舜俞","text":"此峰巉绝与霄干，峰顶泓澄旱不乾。\n天下定应添沆瀣，山头信亦有泥洹。\n等閒云出千岩雨，取次龙归六月寒。\n一勺自堪流万古，何须低处羡波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平观","author":"陈舜俞","text":"绕绕峰峦玉案围，重重楼殿紫烟飞。\n青藤素简天门近，绛节霓旌夜半归。\n鹤使每传三岛信，凤书频送九霞衣。\n放臣于世惭无补，金萼楼前拜不祈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开先寺","author":"陈舜俞","text":"山门屹屹横青嶂，岩屋霏霏带紫烟。\n千尺老松当大道，一条飞瀑落中天。\n重来览物应相识，此地寻僧似有缘。\n自谓读书非俗客，谪官犹得近林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水月院","author":"陈舜俞","text":"兴随白鸟汀洲立，步入青林台殿出。\n湖脉来通方士泉，山颜分入幽人室。\n自苦扁舟每访寻，何年空谷无遗逸。\n一夜霜风穿客衣，二十六房皆采橘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东林寺","author":"陈舜俞","text":"白发老僧安住处，青衫司马爱閒来。\n松嫌天近株株短，花待春归款款开。\n堪信壶中藏日月，谁知云外有楼台。\n官卑合是寻山客，不见芳菲意懒回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东庵","author":"陈舜俞","text":"已怜门巷林中出，况复轩窗水畔开。\n冷淡山光明枕簟，动摇波影上樽罍。\n坐看天际孤舟失，惯见桑阴五马来。\n长恨夕阳吟不足，阑干留共月徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"众乐亭","author":"陈舜俞","text":"湖光野色著人衣，众乐开亭此处宜。\n击棹高歌山自响，踏青红影岸相随。\n消除矰缴容鸥鸟，改换风烟入柳丝。\n荇菜藕花应见忆，短篷孤榜独来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"传神悦躬上人","author":"陈舜俞","text":"倦辔曾投林下宿，短篷重见越江边。\n人归河岳仪型在，事隔桑溟物色传。\n弟子共谈庭际柏，公卿多识社中莲。\n高风自出空王侣，驰誉丹青是可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴少卿致政自咏","author":"陈舜俞","text":"挂冠归故里，寻壑具巾车。\n兰蕙庭阶茂，交游世路疏。\n一壶新漏箭，千姓旧囊书。\n寄问从公客，家金有几馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬余彦翔","author":"陈舜俞","text":"我惭希世就穷儒，甚矣谋身子更迂。\n不共枭狐倚城社，合随鱼鸟乐江湖。\n古来只有风猷重，事去情知气味殊。\n髀肉纵消吾舌在，任从儿女暗揶揄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹云洞","author":"陈舜俞","text":"长干龙老长龙孙，竹里阴阴锁昼云。\n莫问何年初入洞，由来一日可无君。\n清围栏槛喧难入，翠滴衣裾静欲闻。\n会得岁寒看苦节，凭谁吟对雪缤纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西林寺","author":"陈舜俞","text":"东林移宿过西林，风霭萧萧结暝阴。\n随处水声喧屐齿，傍人山色上衣襟。\n道于尘土知无用，乐在云泉亦损心。\n拟付离骚与猿鸟，樵苏应怪久登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过下方祇园入上方看经院遇八十老僧","author":"陈舜俞","text":"因过下方院，更指上方登。\n偃盖杉松路，包金橘柚层。\n清湾从古好，孤榜复谁曾。\n八十年前事，凄凉欲问僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过平望驿有怀湖州李使君二首 其二","author":"陈舜俞","text":"凭熊飞隼两溪头，人似冰壶住玉楼。\n事逐欢谣入渔钓，诗随秋思满汀洲。\n茶收顾渚旗犹卷，酒贳乌程蚁半浮。\n去路无多平望驿，客魂秋雨宿扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过平望驿有怀湖州李使君二首 其一","author":"陈舜俞","text":"柳色阴阴平望桥，春流西受霅溪潮。\n玉楼有月清光远，蘋渚生风丽思飘。\n宁使簿书堆几案，已闻歌咏满渔樵。\n酒船欲访乌程去，愁费金龟返画桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵溪观","author":"陈舜俞","text":"灵溪流水碧潺湲，溪上清辉弟子园。\n白叟荷锄春采药，黄冠敲磬夜朝元。\n山中松叶堪为酒，路口桃花似有源。\n自是游人无道骨，长生何必五千言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谷帘泉","author":"陈舜俞","text":"玉帘铺水半天垂，行客寻山到此稀。\n陆羽品题真黼黻，黄州吟咏尽珠玑。\n重来一酌非无分，未挈吾瓶可忍归。\n终欲穷源登绝顶，带云和月弄清晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻风还泊旧浦","author":"陈舜俞","text":"已作淹留计，行舻岂恨迟。\n却投前浦宿，还似始来时。\n寥泬鲈乡远，飘零鹤发悲。\n犹欣有隐者，度景覆残棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和开祖丹阳别子瞻后寄","author":"陈舜俞","text":"仙舟系柳野桥东，会合情多劳谪翁。\n相对一樽浮蚁酒，轻寒二月小桃风。\n羁怀散诞讴歌里，世事纵横醉笑中。\n莫恨明朝又离索，人生何处不匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王介甫寄安丰知县修芍陂","author":"陈舜俞","text":"雩娄陂水旧风烟，可喜斯民得继传。\n万顷稻粱追汉日，五门疏凿似齐年。\n才高欲献营田策，公暇还来泛酒船。\n称与淮南誇好事，耕歌渔唱已相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和知郡王职方韵同前","author":"陈舜俞","text":"邑陂增筑更渊沉，所喜诗筒赏叹深。\n楚国老臣千古意，庐江贤守一家心。\n淮边野史添新事，垄上春犁诵好音。\n兴利劝农真政术，可知为吏得喉襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和章子厚闻子瞻买田阳羡却寄","author":"陈舜俞","text":"罨画春流藻荇长，吴门菰米鳜鲈乡。\n谋田问舍拙者事，寻壑买山君底忙。\n出处两忘同旅寓，浊清一种付沧浪。\n故人诗酒如驱使，别有甘泉绿野堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉慈禅寺","author":"陈舜俞","text":"一宿禅关万虑空，明朝更上十馀峰。\n山依碧落不多远，人在白云无数重。\n木末疏钟惊虎兕，门前潴水穴蛟龙。\n劳生正负林泉约，犹喜官閒此处逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉酬长文舍人出城见示之句","author":"陈舜俞","text":"春分腊雪未全消，凛冽春寒气尚骄。\n摄事初忻迎社燕，寻芳因得过溪桥。\n清浮蚁酒醅初拨，暖入莺簧舌渐调。\n兴味爱君年尚少，莫嫌斋禁暂无憀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承天院","author":"陈舜俞","text":"建昌门外小禅居，竹槛松窗静有馀。\n全近江湖添怅望，乍离城市易清虚。\n人思求友听啼鸟，僧爱忘筌看得鱼。\n不为山南多胜处，便堪从此驻巾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"若耶溪","author":"陈舜俞","text":"十里澄溪溪上山，溪光无际照山颜。\n天嫌俗眼寻常见，地惜群峰左右关。\n蓬岛也应非海外，琼台争合贮人间。\n维舟正欲踟蹰饮，坐见苍烟罩翠湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"陈舜俞","text":"把酒谓山语，行人亦大孤。\n满朝无骨肉，白发厌江湖。\n寒苦谙冰雪，艰难识道途。\n相看幸相似，可惜便风无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青龙江醉眠亭","author":"陈舜俞","text":"酒担长轻六印腰，醉中一枕敌千朝。\n兴亡藐比荣枯柳，聚散看同旦暮潮。\n清兴本应尘外得，香魂徒向水边招。\n已闻佳士过从约，不为东风返画桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其十","author":"陈舜俞","text":"半生名宦是涂颜，菽水当年尚可欢。\n钟鼎未能光祖妣，牛羊虽美愧杯盘。\n五千强诵谁云补，四十无闻得自安。\n不觉寻春上台榭，东风吹泪落阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其九","author":"陈舜俞","text":"泽国生涯有钓舟，此身随分狎群鸥。\n非关利禄成羁絷，为学文章作赘疣。\n病眼看花空溅泪，客颜临镜复包羞。\n江东父老应相忆，燕子来时语不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其八","author":"陈舜俞","text":"故园春物有谁同，地尽天垂杳蔼中。\n杏火柳烟烧白昼，茶枪笋槊战东风。\n桥横酒市青帘出，门对鱼矶小艇通。\n谁信南阳楼上客，翩翩归羽欲飞空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其七","author":"陈舜俞","text":"簿书堆里得天真，谩为浮名役此身。\n门柳偶同陶靖节，君羹空羡颍封人。\n沙鸥旧许为吾侣，巢燕何曾厌我贫。\n已共东风有归约，且从桃李笑今春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其六","author":"陈舜俞","text":"客宦逢春病眼开，紫荆花下也徘徊。\n谩劳人力书千卷，聊寄天真酒一杯。\n明代本期无弃物，孤臣何敢自论才。\n且欣腐鼠同乌喙，不怕丹山有凤猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其五","author":"陈舜俞","text":"壮怀摧折复何言，齿发今年老去年。\n念远片心飞鸟外，感时双泪落花前。\n琴逢遏密生难理，诗拟离骚怨不传。\n家在五湖明月里，梦随春水宿渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其四","author":"陈舜俞","text":"花前惆怅转难平，屈指光阴已半生。\n犹把此身尝患难，不知何日得功名。\n未安去住千丝乱，已去悲欢一梦惊。\n拟入醉乡销此恨，快风无故析春酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其三","author":"陈舜俞","text":"山川随处有芳菲，老大情怀与旧非。\n已恨莺声惊晓梦，岂堪花气著人衣。\n家蔬未省添新斸，宰木应曾长旧围。\n终向畏涂无所得，好风佳月不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其二","author":"陈舜俞","text":"惓怀春晚脱征骖，官况喧卑昔未谙。\n敲扑岂甘忘素业，琴樽犹可助清谈。\n窗灯耿耿书开卷，衙鼓鼕鼕吏放参。\n唯有登楼心不惬，乱云堆雾锁东南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳春日十首 其一","author":"陈舜俞","text":"城头古木未知春，官柳柔条日日新。\n门巷旋开沽酒市，郊原便有踏青人。\n风烟乍入禽初好，网罟犹多雉肯驯。\n拟为芳时对樽斝，愧无心事乐天均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客意五首 其五","author":"陈舜俞","text":"况复淹旅泊，情多秋亦悲。\n寒云欲垂野，疏叶不藏梨。\n断梗逐流水，归禽投好枝。\n徘徊古原上，应有夕阳知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客意五首 其四","author":"陈舜俞","text":"水浊不见面，安能照胆明。\n还因送流梗，所得计归程。\n日落西风急，秋声积潦并。\n清江前约在，赖尔濯吾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客意五首 其三","author":"陈舜俞","text":"高岸耸如陵，秋光著处清。\n遥山照眼碧，黄叶逐人行。\n莫怪新烟火，曾经古战争。\n深林茅屋小，气象亦豪英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客意五首 其二","author":"陈舜俞","text":"行役意匆匆，淹留计已穷。\n梦归无奈晓，病觉不禁风。\n忆橘园垂枳，沉鱼夜听鸿。\n悲秋成白发，赖未作衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客意五首 其一","author":"陈舜俞","text":"客意久不适，揽衣临暮舂。\n烟长藏野阔，云断漏天空。\n酒置千愁里，诗成一望中。\n黄花无限好，底事忆江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至嘉禾先寄诸兄弟","author":"陈舜俞","text":"半年西走若飞蓬，得禄无多计屡穷。\n骥足寒孤甘伏皂，雁群惊迸苦伤弓。\n家贫不易新堂构，天幸犹能遇岁丰。\n且待归来都讲论，一篙烟水趁霜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送可则上人还京师开讲","author":"陈舜俞","text":"善作空王子，能探佛祖心。\n浮云无定住，流水度光阴。\n粝食开盂惯，飞尘坏衲禁。\n国城传法后，倚锡旧山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘吏部得请三茅崇禧观","author":"陈舜俞","text":"老臣连上皂囊封，去访三茅驾鹤翁。\n曾为苍生论敝事，因从紫府得仙风。\n收身物外光阴好，回首人间宠辱空。\n果满丹成家法在，应携鸡犬入云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李户曹官满还江宁","author":"陈舜俞","text":"去程牢落且徘徊，听我高吟侑一杯。\n皦日心胸无愧耻，青衫颜色任尘埃。\n秦淮形胜多人物，晋室风流入草莱。\n归到江山聊洗眼，下僚应不久沉才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送喜长老游四明","author":"陈舜俞","text":"钓竿无竹月空船，事去朱泾不记年。\n一句弗由他物得，此心知与么人传。\n无须王老长垂地，掉臂胡僧仰托天。\n去问玲珑岩上石，□中谁是我师禅。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峰顶院","author":"陈舜俞","text":"自怜随分有仙踪，曾宿金庭第九重。\n谁谓谪官真俗吏，还登庐阜最高峰。\n坐头平揖千岩月，枕底微闻二寺钟。\n归去林泉缘更熟，定应春梦却过从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽刘夫人词二首 其二","author":"陈舜俞","text":"卜邻早效三迁教，负米方休百里劳。\n乐事难留同逝水，孝思无尽入伊蒿。\n万家原上开新冢，旧馆人来奠浊醪。\n况有铭诗传不朽，长城千古白云高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽刘夫人词二首 其一","author":"陈舜俞","text":"籍籍家声起草莱，诜诜子舍奉兰陔。\n翩翻三凤皆英物，蹭蹬双驹亦骏才。\n忆昔綵衣环几舄，于今清血洒棬杯。\n何年盛事联簪组，别有丝纶荐夜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽邵夫人词","author":"陈舜俞","text":"丹阳门第三朝贵，乐寿丝纶五色开。\n有助清郎终盛誉，得怜诸子尽高才。\n兰彫北畹香犹在，水向东溟逝不回。\n原上送车无数目，日西风雨转徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽侍讲先生王夫人诗二首 其二","author":"陈舜俞","text":"师墙童稚被陶钧，穴凤仍同桂籍春。\n岂独慈良尊有道，就论恩分即吾亲。\n生前未许升堂拜，原上空陪执绋人。\n一曲薤歌难写恨，哀荣千古付苍珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽侍讲先生王夫人诗二首 其一","author":"陈舜俞","text":"兰陔堂上此归全，松柏山头有旧阡。\n我得遐龄几九十，人依绛帐昔三千。\n病时太守和汤药，没后诸生侍几筵。\n善化群材同草木，先生恩德重如天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留槎阁","author":"陈舜俞","text":"闻说欧川似沃洲，一溪分作两溪流。\n长桥跨岸虹垂地，高阁淩空蜃吐楼。\n浩荡乾坤供醉眼，凄凉风雨送行舟。\n凭谁为问乘槎客，未必无人犯斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虑狱江州晚出浔阳门","author":"陈舜俞","text":"浅深秋色看红叶，高下人烟入翠微。\n过岭已怜云满?，穿林宁恨露沾衣。\n自惭访道来何晚，便好寻真去不归。\n本迕朝廷无补报，名山犹幸许相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阅日堂僧橘","author":"陈舜俞","text":"阅日堂前橘，山僧手自移。\n为迎林下客，旋拄路边枝。\n结实曾防蚁，盈箱不禁儿。\n他年应记得，蜡屐过门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿灵源院","author":"陈舜俞","text":"山家皆种橘，古寺独栽松。\n林静时栖鹤，泉灵合有龙。\n何年人舍宅，今日我携筇。\n寓所留僧话，未眠闻打钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]