[{"title":"及第","author":"胡则","text":"金榜名传四海知，太平时合称男儿。\n五言似剑裁鳞角，七字如刀斫桂枝。\n御苑得题朝帝日，家乡佩印拜亲时。\n小花桥畔人人爱，一带清风雨露随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奏免衢婺丁钱","author":"胡则","text":"六十年来见弊由，仰蒙龙敕降南州。\n丁钱永免无拘束，苗米常宜有限收。\n青嶂瀑泉呼万岁，碧天星月照千秋。\n臣今未恨生身晚，长喜王民绍见休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬和二章拜呈慈云大师伏惟采览 其二 和种桂","author":"胡则","text":"累累丹桂子，秋落古禅关。\n乍到圆蟾窟，潜依灵鹫山。\n始知尘外有，会向月中攀。\n千载孤峰上，清阴与客閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题紫霄观","author":"胡则","text":"绮霞重叠武陵溪，溪岭相逢路不迷。\n白石洞天人不到，碧桃花下马频嘶。\n深倾玉液琴声细，旋煮胡麻月色低。\n犹恨此身閒未得，好同刘阮灌芝畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别方岩","author":"胡则","text":"寓居峰顶寺，不觉度炎天。\n山叟频为约，林僧每出禅。\n虚怀思往事，宴坐息诸缘。\n照像龛镫暗，通宵磬韵传。\n宴心资寂寞，琢句极幽玄。\n拾菌寒云外，烹茶翠竹前。\n远阴临岳树，清响落岩泉。\n僻道无来客，深秋足乱蝉。\n松风生井浪，溪雨长苔钱。\n自省浮尘世，终难住永年。\n遍游曾宛转，欲别重留连。\n明日东西路，依依独黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬和二章拜呈慈云大师伏惟采览 其一 和桂子","author":"胡则","text":"孤峰耸高桂，千载同一日。\n秋气正飞霜，天风落丹实。\n纷纷宝砌傍，颗颗露珠密。\n始自月中来，又从骊颔出。\n香浮古佛刹，光照高僧室。\n吴越饶珍异，金玉非俦匹。\n尝咏贤人诗，未载史臣笔。\n至矣天竺山，山灵诞奇物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题严子陵祠堂","author":"胡则","text":"占断烟波七里滩，渔蓑轻拂汉衣冠。\n高踪磨出云涯碧，清节照开秋水寒。\n泽国几家供庙食，客星千载落云墩。\n我来亦有沙洲兴，愿借先生旧钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿蒋庵","author":"胡圭","text":"松色耸寒青，云庵夜未扃。\n行吟满林叶，坐听一僧经。\n江獭鸣如鬼，山灯远似星。\n自能消冷漠，不用酒盈瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入山","author":"胡圭","text":"摆落世尘缚，愿结岩栖缘。\n一层复一层，古道多回旋。\n白云随我后，幽鸟鸣我前。\n云禽亦佳侣，一见即忻然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山池","author":"胡圭","text":"凿山成小池，贮兹一泓绿。\n参差散石发，清浅浮碧玉。\n光风时动摇，涟漪细相续。\n我常绕池行，衣无尘可濯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春行南村","author":"胡圭","text":"鸟语知春晨，晨起行阡陌。\n雨晴气已变，崖涧岚犹积。\n杂花林际明，新水田中白。\n时逢耦耕人，问我将何适。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题舒啸馆二首 其二","author":"胡如埙","text":"楼前春水碧弯环，柳外愁心千叠山。\n立尽残阳人不见，东风无赖莫凭阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题舒啸馆二首 其一","author":"胡如埙","text":"堤边草色绿茸茸，堤上桃花落尽红。\n细雨斜风三月暮，一年春事客愁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后答吴尚书","author":"胡如埙","text":"渥洼困盐车，帖耳声复吞。\n驽骀饱栈豆，嘶鸣尚轩轩。\n向来沟中断，青黄即牺樽。\n薰莸既同器，玉石且俱燔。\n物理安可齐，我今欲忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答大年马丞相","author":"胡如埙","text":"人生寄浮云，世味如嚼蜡。\n宁分螬半食，肯逐乌三匝。\n纷纷相彼我，此道方噂沓。\n君看王孙猿，爱恶卒难合。\n吾侪异市道，所贵相知心。\n临分倾意气，泣下时沾襟。\n古来耿介士，不憩恶木阴。\n茫茫天宇间，四顾徒悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答吴尚书","author":"胡如埙","text":"豫让能报国，程婴能保孤。\n虽复千万年，名与日月俱。\n即今天壤间，斯人焉可无。\n临风每遐想，泫然重嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"胡有开","text":"一百八景蟠绕，三十六峰回环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殊圣寺","author":"胡权","text":"不是等闲到，须知会合稀。\n水行清骨发，云卧冷裳衣。\n桐挂秋阴薄，松寒露气肥。\n共吟有佳致，何苦只言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"胡君防","text":"楼台旧地牛羊满，宫殿遗基禾黍平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"胡君防","text":"桄榔雨醉江城夜，橄榄风吟野驿秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"胡君防","text":"岛日斜明僧寺阁，汀云低影客船窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"胡君防","text":"水边闲咏处，云岛月斜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"胡君防","text":"避世一处士，传家三诏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天道吟","author":"胡宏","text":"一气安然不强为，大强先去少强随。\n本来把定真消息，不是迂愚却是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆伯氏三首 其三","author":"胡宏","text":"又见雁南飞，远人音信稀。\n东风吹梦去，一见貌颀颀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆伯氏三首 其二","author":"胡宏","text":"又见雁南飞，行人几岁归。\n朔风吹病体，独对雪霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆伯氏三首 其一","author":"胡宏","text":"又见雁南飞，远行人未归。\n西风吹白发，肌瘦不胜衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日照圃中","author":"胡宏","text":"发白逢春兴更长，等閒花木亦芬芳。\n有时倚杖迎风立，日照川原细草香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月八日示澄照大师","author":"胡宏","text":"今朝浴佛事如何，清净心田也洗么。\n尘垢不知何处得，古来明月照江波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱元晦寄诗刘贡父有风藉溪先生之意词甚妙而意未员因作三绝 其二","author":"胡宏","text":"幽人遍爱青山好，为是青山青不老。\n山中云出雨乾坤，洗过一番山更好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次刘子驹韵 其一","author":"胡宏","text":"忙中不识本来心，一点灵光自在明。\n只向静中寻底事，恐遭颠沛不员成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观书有感 其二","author":"胡宏","text":"今日曾知进步来，彀愚深自克多才。\n些儿不闭公门户，尽着多才打不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张良","author":"胡宏","text":"六国亿万人，谁是报雠者。\n壮哉博浪沙，一击震天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈平","author":"胡宏","text":"陈平相业定何如，应对知君智有馀。\n不佐汉兴三代业，区区心事六奇书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和马大夫辟佛五首 其五","author":"胡宏","text":"贪真不去只谈空，近代禅林盛此风。\n忧世最怜秦地老，指迷端有洽中公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和马大夫辟佛五首 其四","author":"胡宏","text":"天开学海在明伦，中有妙处谁能臻。\n风波浩渺不得度，倾向浮屠去问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和马大夫辟佛五首 其三","author":"胡宏","text":"三纲亡有辨夷华，一处分明万不差。\n可怪弃君逃父客，妄谈心印自雄誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和马大夫辟佛五首 其二","author":"胡宏","text":"诸子随流本既分，西天更有一般僧。\n高谈性命称仁者，支遁悠悠莫可凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和马大夫辟佛五首 其一","author":"胡宏","text":"真谛休谈欲度人，度人先自正其身。\n天伦弃掷如萧梗，反认他亲作己亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘子驹存存室","author":"胡宏","text":"动中涵静是天机，静有工夫动不非。\n会得存存存底事，心明万变一源归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和伯氏","author":"胡宏","text":"风高吹散日边云，绿水初回沙际春。\n逝者如斯长不住，汨罗愁绝笑灵均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和伯氏闻雁","author":"胡宏","text":"随阳群雁逐云低，望断孤鸿万里飞。\n不为江湖稻粱乐，几时大许送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和僧二首 其二","author":"胡宏","text":"自觉生缘遍大千，闭关终日看炉烟。\n有人会得个中意，一语不彰天下传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和僧二首 其一","author":"胡宏","text":"西风吹我对秋光，要挽银河万里长。\n洗尽世人烦恼障，大家无事得清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和僧碧泉三首 其三","author":"胡宏","text":"山根泉发澜生凝，亭上风微浪自平。\n汩汩长年流不住，无言千古意分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和僧碧泉三首 其二","author":"胡宏","text":"人似春花自在开，本无根蒂孰栽培。\n一番零乱一番长，不是前花去又回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和僧碧泉三首 其一","author":"胡宏","text":"清泠空色似秋澄，疑集群仙拥万灵。\n深处有香春不断，波间藻荇四时青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐寄友人兼以自警","author":"胡宏","text":"满抱春愁独拥衾，雨声入夜更沉沉。\n风流欲会东风面，趁取径深绿未深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"实弟以诗来督作会文又因太原侄寄声欲作不速此文人狂客所为非素所望也今以五绝奉寄虽小阻高兴若能从而绎之则有味也 其四","author":"胡宏","text":"岁月叹逾迈，入门事业难。\n战兢曾子意，岂可遂阑珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"实弟以诗来督作会文又因太原侄寄声欲作不速此文人狂客所为非素所望也今以五绝奉寄虽小阻高兴若能从而绎之则有味也 其二","author":"胡宏","text":"苦参道难学，放肆事容易。\n入脚不可深，骎骎成自弃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宠辱","author":"胡宏","text":"宠辱无休变万端，阿谁能向静中看。\n消磨利欲十分尽，免得临机剖判难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念良朋之难得叹俗学之失真因成二绝 其一","author":"胡宏","text":"湘上初见故乡人，万事不论惟论心。\n要识此心真面目，不知君意向沈吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念良朋之难得叹俗学之失真因成二绝 其二","author":"胡宏","text":"章句纷纷似世尘，一番空误一番人。\n读书不贵苟有说，离得语言才是真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春事 其一","author":"胡宏","text":"横翠桥南柳色稀，过桥春事那人知。\n君如就我问消息，新种海棠开两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春事 其二","author":"胡宏","text":"走马寻春西复东，夭桃零落委残红。\n可怜日暮天低处，但有梨花弄晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"项王","author":"胡宏","text":"快战马知霸术疏，乌江亭上独欷歔。\n万人三尺俱无用，可惜当年不读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚕食","author":"胡宏","text":"蚕食人间我厚颜，命成奇数故偷閒。\n不知世上山河大，终日徘徊百水间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读王国风","author":"胡宏","text":"是谁行迈闵宗周，泪洒西风病不瘳。\n幸对南山无尽景，眼看云物手搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书四首 其四","author":"胡宏","text":"衡岳望嵩少，屹然河汉间。\n浮云自来往，谁肯拓关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书四首 其三","author":"胡宏","text":"独坐千峰下，偶马起徘徊。\n有谁相共笑，遥见隔溪梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书四首 其二","author":"胡宏","text":"青山万古色，几人曾赏心。\n萧萧木叶下，我坐复沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书四首 其一","author":"胡宏","text":"道抱阴阳妙，天行日月长。\n花开千种丽，叶下一般黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔子 其一","author":"胡宏","text":"潇湘烟雾隐千重，风月矶纶在在同。\n笑傲飞帆名利客，扣舷都入暝歌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔子 其二","author":"胡宏","text":"小舟游漾占江天，家在芦花一缕烟。\n最是好风明月夜，棹讴相应亦忘筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩信","author":"胡宏","text":"功成全仗汉家兵，真是英雄不藉人。\n禽了项王知退步，定骑箕尾上天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮归鉴湖偶成","author":"胡宏","text":"草香泉细午风轻，桃李春花夹岸明。\n归棹夷犹云水暮，柳阴深处一声莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧泉书院偶书花木所有七首 其七","author":"胡宏","text":"白沙波底石苔青，水草摇摇自在生。\n红日半竿人世闹，倚阑亭上晓风轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧泉书院偶书花木所有七首 其六","author":"胡宏","text":"荼蘼袅袅弄柔条，亦自经冬解不凋。\n更有异香含素蕊，小槽能使客魂消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧泉书院偶书花木所有七首 其五","author":"胡宏","text":"海棠初破红如滴，杨柳新回绿似挼。\n把酒只愁春莫去，望云时问日如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧泉书院偶书花木所有七首 其四","author":"胡宏","text":"青松未结茯苓英，杞菊春风亦已生。\n药物岂能增大数，栽培扶我暮龄行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧泉书院偶书花木所有七首 其三","author":"胡宏","text":"武陵春色片云红，红绽功归暖日烘。\n青帝也应长作主，莫教随水又随风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧泉书院偶书花木所有七首 其二","author":"胡宏","text":"妙手挥斤合杳冥，交加生气便相停。\n栽培自剔根芽蠹，要见山川旧典刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧泉书院偶书花木所有七首 其一","author":"胡宏","text":"自到湘南不见花，传闻金谷旧人家。\n手培数本珍如玉，买得红尖一寸芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题齐云阁","author":"胡宏","text":"道人南山来，万里青云开。\n去念见本性，聚散真悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠人","author":"胡宏","text":"孝弟须知是本根，万般功行且休论。\n圣门事业无多子，守此心为第一门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"靡草","author":"胡宏","text":"阴阳妙合互藏精，万物森然各有神。\n靡草露机坤是复，野龙交战指迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]