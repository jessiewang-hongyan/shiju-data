[{"title":"南园观梅","author":"陆游","text":"幽径疏篱洗世尘，眼明见此数枝新。\n横斜恰受三更月，璀璨先回万物春。\n洛浦凌波矜绝态，缑山骑鹤想前身。\n放翁著句烦君记，画在生绡却未真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南定楼遇急雨","author":"陆游","text":"行遍梁州到益州，今年又作度泸游。\n江山重复争供眼，风雨纵横乱入楼。\n人语朱离逢峒獠，棹歌欸乃下吴舟。\n天涯住稳归心懒，登览茫然却欲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南沮水道中","author":"陆游","text":"硙舍临湍濑，罾船聚小潭。\n山形寒渐瘦，雪意暮方酣。\n久客情怀恶，频来道路谙。\n家山空怅望，无梦到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南省宿直二首 其一","author":"陆游","text":"檐角参差散暮霞，重门锁断市声哗。\n风经绿树鸦栖稳，月入空廊柱影斜。\n藤纸静临新获帖，铜瓶寒浸欲开花。\n谁知今夕幽窗梦，又榜扁舟上若耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其六","author":"陆游","text":"十里城南禾黍村，白头心事与谁论。\n惰偷已坠先人训，迂拙仍辜圣主恩。\n病退时时亲蠹简，兴来往往出柴门。\n斜阳倚杖君知否，收点鸡豚及未昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其五","author":"陆游","text":"奔走当年一念差，归休别觉是生涯。\n茆檐唤客家常饭，竹院随僧自在茶。\n禅欠遍参宁得髓，诗缘独学不名家。\n如今百事无能解，只拟清秋上钓槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其八","author":"陆游","text":"北连大泽惊秋早，东限连林觉晓迟。\n数箸药苗留客话，一炉松火约僧棋。\n人间扫迹虽堪笑，物外论心颇自奇。\n有恨未偿犹绝叹，青城交旧待多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其一","author":"陆游","text":"车马无声昼漏长，野人与世已相忘。\n屏除长物轩楹爽，洗濯尘襟肺腑凉。\n秋近平郊鸣鹳鹤，日斜荒径下牛羊。\n兴来欲唤筇枝去，更尽铜炉一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其七","author":"陆游","text":"年过八十更应稀，又向清秋听捣衣。\n一片雨来书幔黑，数声钟断钓船归。\n酒垆好事能焚券，齑瓮无情未解围。\n剩欲出门寻一笑，故人零落叹畴依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其二","author":"陆游","text":"新凉一夜入郊墟，晨起衣巾爽有馀。\n燕欲委巢雏尽去，扇犹在手意先疏。\n题诗又满牛腰束，采乐常携鸦觜锄。\n湖上从今风月好，不妨随处命篮舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其四","author":"陆游","text":"耄齿东归息故庐，聊持顽健托乡闾。\n未忘麈尾清谈兴，常读蝇头细字书。\n贫甚尚能耕有犊，步轻那叹出无驴。\n南堂又见秋风起，卧看溪云自捲舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂杂兴八首 其三","author":"陆游","text":"蛩声每续蝉声起，桐叶仍兼柳叶凋。\n懒惰心情疏笔砚，久长生计属渔樵。\n鬋茅旋补东厢屋，伐石新成北港桥。\n物外高人来往熟，等闲折简也能招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂纳凉二首 其二","author":"陆游","text":"浴罢闲无事，悠然寄一床。\n水风凉醉颊，松月上虚廊。\n岸久乌纱侧，熏馀细葛香。\n今宵一美睡，何止傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂纳凉二首 其一","author":"陆游","text":"环坐列胡床，儿曹共此凉。\n风生桐叶坠，露下稻花香。\n老幸返初服，穷宜归故乡。\n已无缨可濯，清啸对沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂独坐","author":"陆游","text":"晨坐南堂双眼明，南山山色满柴荆。\n片云忽过失帘影，急雨初来闻竹声。\n鹦鹉螺深生酒兴，蟾蜍滴古助诗情。\n野人频约天台去，几緉青鞋了此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂脊记乃已三十年偶读之怅然有感","author":"陆游","text":"一住三山三十载，交亲渐觉眼前稀。\n长松郁郁偃高盖，新竹森森添旧围。\n沙径雨馀留鸟迹，柴门日落锁烟扉。\n放翁正倚蒲团稳，辽海从渠万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂晨坐","author":"陆游","text":"镜湖清绝似潇湘，晨起焚香坐草堂。\n日暖游丝垂百尺，花残新蜜酿千房。\n绿桑糁箔开蚕食，白水翻车浸稻秧。\n莫道村翁杀风景，也能沽酒答年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南窗","author":"陆游","text":"暄妍一窗日，的皪数枝梅。\n小鼎煎茶熟，幽人作梦回。\n新春又将近，晚景但堪哀。\n用底舒怀抱，残书阖复开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南窗","author":"陆游","text":"流落逢知少，疏慵迕俗多。\n闷拈如意舞，狂叩唾壶歌。\n巴酒禁愁得，金丹奈老何。\n南窗好风月，聊复此婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南窗睡起二首 其二","author":"陆游","text":"昼漏迢迢暑气清，不妨小倦带馀酲。\n梦从陇客声中断，愁向湘屏曲处生。\n风度帘旌红浪飐，窗明香岫碧云横。\n闲情赋罢凭谁寄，怅望壶天白玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南窗睡起二首 其一","author":"陆游","text":"梦中忘却在天涯，一似当年锦里时。\n狂倚宝筝歌白纻，醉移银烛写乌丝。\n酒来郫县香初压，花送彭州露尚滋。\n起坐南窗成绝叹，玉楼乾鹊误归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南?遇大风雨","author":"陆游","text":"叹息谁如造物雄，故将意气压衰翁。\n千群铁马云屯野，百尺金蛇电掣空。\n身羡渔蓑鸣急雨，心怜鸦阵困狂风。\n世间变态谁能测，归路斜阳十里红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南楼","author":"陆游","text":"十年不把武昌酒，此日阑边感慨深。\n舟楫纷纷南复北，山川莽莽古犹今。\n登临壮士兴怀地，忠义孤臣许国心。\n倚杖黯然斜照晚，秦吴万里入长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀郢二首 其一","author":"陆游","text":"远接商周祚最长，北盟齐晋势争强。\n章华歌舞终萧瑟，云梦风烟旧莽苍。\n草合故宫惟雁起，盗穿荒冢有狐藏。\n离骚未尽灵均恨，志士千秋泪满裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀郢二首 其二","author":"陆游","text":"荆州十月早梅春，徂岁真同下阪轮。\n天地何心穷壮士，江湖从古著羁臣。\n淋漓痛饮长亭暮，慷慨悲歌白发新。\n欲吊章华无处问，废城霜露湿荆榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城上二首 其二","author":"陆游","text":"濯锦豪华梦不通，岿然孤叠乱山中。\n行歌满道知人乐，露积连村见岁丰。\n万瓦新霜扫残瘴，一林丹叶换青枫。\n鹅黄名酝何由得，且醉杯中琥珀红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城上二首 其一","author":"陆游","text":"双双黄犊卧斜阳，叶叶丹枫著早霜。\n沙水自鸣如有恨，野花无主为谁芳。\n郫筒味酽愁濡甲，巴曲声悲怯断肠。\n赖有生平管城子，不妨驱使荅风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城东","author":"陆游","text":"出郭溶溶细縠波，平生此地几经过。\n祭馀野庙啼乌乐，酒贱村墟醉叟多。\n亭午疏钟离石佛，敛昏微雨泊曹娥。\n采莲艇子愁衣湿，不为人家惜绿荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城东马上作二首 其二","author":"陆游","text":"割鲜藉草醉春醪，仰看鸣髇百尺高。\n杜老何妨希稷契，孔明本自陋袁曹。\n边头插羽无传檄，箧里盘雕有旧袍。\n寄语长安众年少，妓围不似猎围豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城东马上作二首 其一","author":"陆游","text":"古寺名园处处行，翩然南陌复东城。\n手柔弓燥猎徒喜，耳热酒酣诗兴生。\n月似有情迎马见，莺如相识向人鸣。\n摩挲病眼还三叹，犹拟中原看太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城东逆旅","author":"陆游","text":"店家乞火燎征衣，湿竹生薪不受吹。\n更甚从戎戍边日，正如随计入关时。\n百年扰扰梦相似，万事悠悠心自知。\n赖有床头周易在，不妨清坐忍朝饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城北夜","author":"陆游","text":"端居厌孤寂，偶系北城舟。\n天地凄凉色，江湖汗漫游。\n萤光矜暗夜，虫语报新秋。\n老去功名意，青灯映布裯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城西晚眺","author":"陆游","text":"袅袅城笳咽，荧荧渔火青。\n霜凋两岸柳，水浸一天星。\n静看船归浦，遥闻雁落汀。\n倚阑幽兴极，不敢恨飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城南道中有感","author":"陆游","text":"行李萧然一束书，城南触目更愁予。\n市门乞食僧持钵，关路哦诗客跨驴。\n残发无多真已矣，名山未去独何欤。\n芒鞋可买身犹健，红树青霜十月初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复雨","author":"陆游","text":"催唤儿童扫绿苔，长歌清啸兴悠哉。\n林间子堕知梅熟，水面痕生验雨来。\n往事已成孤枕梦，故人谁共一樽开。\n自怜未负年华在，素扇团团月样裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复窃祠禄示儿子","author":"陆游","text":"得饱不啻足，闭门还读书。\n翁犹羹不糁，儿固食无鱼。\n衮绣曷加我，箪瓢常晏如。\n人生随所遇，勿替此心初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复湖","author":"陆游","text":"世事相寻败与成，湖中畚锸浩纵横。\n共知陂坏行当复，敢恨台高既已倾。\n天镜忽看孤月堕，樵风长送片帆轻。\n下临万顷如云稼，从此年年有颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奏乞奉祠留衢州皇华馆待命","author":"陆游","text":"世念萧然冷欲冰，更堪衰与病相乘。\n从来幸有不材木，此去真为无事僧。\n耐辱岂惟容唾面，寡言端拟学铭膺。\n尚馀一事犹豪举，醉后龙蛇满剡藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客去","author":"陆游","text":"客来拈麈尾，客去拂床眠。\n孤梦归湖上，残书堕枕边。\n幽禽窥户语，落日傍窗妍。\n暂尔名朝士，终然是地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客去追记坐间所言","author":"陆游","text":"征西幕罢几经春，叹息儿音尚带秦。\n每为后生谈旧事，始知老子是陈人。\n建隆乾德开王业，温洛荣河厌虏尘。\n倘得此生重少壮，临危敢爱不赀身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客叩门多不能接往往独坐至晚戏作","author":"陆游","text":"贫舍久疏罗酒浆，客来不复倒衣裳。\n官情已尽诗情在，世味无馀睡味长。\n红练带飞穿柳去，锦熏笼暖扑帘香。\n萧然自笑浑无事，渔唱声中又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客多福院晨起","author":"陆游","text":"万鲸传响彻修廊，唤起衰翁晓梦长。\n万事可怜随日出，一生常是伴人忙。\n驰驱深厌交飞盖，息偃何时静炷香。\n四到锦城身愈老，更堪重入少年场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客有见过者既去喟然有作二首 其二","author":"陆游","text":"永日安耕钓，馀年迫耄期。\n研朱点周易，饮酒和陶诗。\n带箭归飞鹤，支床不瞑龟。\n此生君看取，死是出门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客有见过者既去喟然有作二首 其一","author":"陆游","text":"鬓毛俱白尽，事不补秋毫。\n去死今无几，归耕何足高。\n已如陶止酒，徒劝屈餔糟。\n惟有沧溟去，扬帆观雪涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客自凤州来言岐雍间事怅然有感","author":"陆游","text":"表里山河古帝京，逆胡数尽固当平。\n千门未报甘泉火，万耦方观渭上耕。\n前日已传天狗堕，今年宁许佛狸生。\n会须一洗儒酸态，猎罢南山夜下营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客至","author":"陆游","text":"何处轩车客，能来桑麦村。\n一奴先入市，此老自应门。\n野果尝皆涩，村醅压尚浑。\n残年亦何恨，治世作黎元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客至","author":"陆游","text":"官闲身自得，客至眼殊明。\n静算棋生死，闲分酒浊清。\n悠然剧谈罢，偶尔小诗成。\n但恨桑麻事，无人与共评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客怀","author":"陆游","text":"客怀耿耿向谁语，世事茫茫空自知。\n坚坐懒穷牛渚怪，倦游何恨雁门踦。\n眼前客共一杯酒，身后人传千首诗。\n报与故交当贺我，计归犹及菊花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客怀","author":"陆游","text":"客怀病思两凄凄，瘦马长靴溅雪泥。\n道左忽逢曾宿驿，壁间闲看旧留题。\n村醅酸薄陈山果，旅饭萧条嚼冻齑。\n何处人间非梦境，恍然重到剑关西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客舍对梅","author":"陆游","text":"野迥林寒一水傍，密如疏蕊正商量。\n半霜半雪相仍白，无蝶无蜂自在香。\n月过晓窗移影瘦，风传残角引声长。\n还怜客路龙山下，未折一枝先断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客亭","author":"陆游","text":"荻浦烟汀并海涯，一枝柔橹语咿哑。\n久从野老非生客，惯寓僧庐胜在家。\n乘兴村村俱有酒，逢春处处可寻花。\n朝来雪霁梅初动，又向邮亭阅岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客思二首 其一","author":"陆游","text":"千里关山道路赊，可怜客子费年华。\n杯觞滟滟红烧酒，风露盈盈紫笑花。\n孤月有情来海峤，双鱼无信到天涯。\n此生那得常飘泊，归卧东溪弄钓车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客思二首 其二","author":"陆游","text":"两鬓星星久倦游，凄凉况复寓南州。\n未甘蟋蟀专清夜，已叹梧桐报素秋。\n绮语安能敌生死，热官正欲快恩雠。\n空堂饱作东归梦，梦泊严滩月满舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客思","author":"陆游","text":"裘马平生喜远游，暮年憔悴向南州。\n文书与睡中分日，衰病和愁总怕秋。\n无复雪郊看射虎，但思烟浦听呼牛。\n还家谁道无馀俸，倒橐犹堪买钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客愁","author":"陆游","text":"骑马出门无所诣，端居正尔客愁侵。\n苍颜白发入衰境，黄卷青灯空苦心。\n天下极知须隽杰，书生何恨死山林。\n消磨未尽胸中事，梁甫时时尚一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客意","author":"陆游","text":"山行曳杖水拿舟，走遍茫茫禹画州。\n蝴蝶梦魂常是客，芭蕉身世不禁秋。\n早因食少妨高卧，晚忆茶甘作远游。\n龙焙一尝端可去，无心更为荔枝留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将入闽夜行之云门","author":"陆游","text":"东骛并偏门，篮舆兀睡昏。\n纺灯穿壁罅，吠犬闯篱根。\n久客悲行役，清愁怯梦魂。\n馀生犹几出，回首付乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将之荣州取道青城","author":"陆游","text":"倚天山作海涛倾，看遍人间两赤城。\n自笑年年随宦牒，不如处处得闲行。\n草痕沙际犹馀绿，枫叶霜馀已带赪。\n归去还堪咤儿辈，锦囊三十六峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至京口","author":"陆游","text":"卧听金山古寺钟，三巴昨梦已成空。\n船头坎坎回帆鼓，旗尾舒舒下水风。\n城角危楼晴霭碧，林间双塔夕阳红。\n铜瓶愁汲中?水，不见茶山九十翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至金陵先寄献刘留守","author":"陆游","text":"梁益羁游道阻长，见公便觉意差彊。\n别都王气半空紫，大将牙旗三丈黄。\n江面水军飞海鹘，帐前羽箭射天狼。\n归来要了浯溪颂，莫笑狂生老更狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"屏迹二首 其一","author":"陆游","text":"屏迹乱山中，观身槁木同。\n桑麻安旧业，薪水付村童。\n不散婴儿朴，常存太古风。\n一钱无用处，那复计囊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"屏迹二首 其二","author":"陆游","text":"饭熟起开钵，困来徐倒床。\n无狂安取圣，有短始知长。\n养道褐怀玉，露才锥出囊。\n聊须唤儿稚，细细话耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡州东山","author":"陆游","text":"十年不踏东山路，今日重为放浪行。\n老矣判无黄鹄举，归哉惟有白鸥盟。\n新秧刺水农家乐，修竹环溪客眼明。\n已驾巾车仍小驻，绿萝亭下听莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡州甘泉寺","author":"陆游","text":"江上甘泉寺，登临擅一州。\n山亭喜无恙，老子得重游。\n滩急常疑雨，林深欲借秋。\n归途更清绝，倚杖唤渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽兴","author":"陆游","text":"池水车初满，荆篱补已成。\n身闲诗简淡，心静梦和平。\n雁后寒鸦至，枫先桕叶赪。\n居然足幽兴，未叹岁峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽兴","author":"陆游","text":"兰渚前头湖水清，了无俗事败幽情。\n雨淋茅屋随时补，日射油窗特地明。\n庭树晚莺窥户语，邻园秋笋过篱生。\n芥菘渐美盐醯足，谁共贫家一釜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]