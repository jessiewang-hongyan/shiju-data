[{"title":"和祖道见致政王中允题壁","author":"彭汝砺","text":"里巷参差一水间，水边相失复三年。\n旧题想见风规好，清隐传闻志尚贤。\n道路尚能谈旧事，林泉宁复挂尘缘。\n迟回禄仕予真怯，不独无君郭外田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江口道中","author":"彭汝砺","text":"道路春晴柳叶长，川原水涸草菰黄。\n阴晴天气犹寒食，村郭人家似故乡。\n地旷马牛群放牧，时平儿女自耕桑。\n马蹄即踏江南路，村店相看酒一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和祖道渡江","author":"彭汝砺","text":"归上慈亲酒一觞，吾荣不啻插麾幢。\n雨沾马辔行春野，风满舟樯泛晓航。\n江路好山随步履，人家流水照轩窗。\n梅仙不怪多诗思，莺语纷纷燕子双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓行","author":"彭汝砺","text":"迟明骑马听鸡号，雾露纷纷上鬓毛。\n烟宿平芜疑远水，风鸣高木听飞涛。\n暖回宿草春初见，光动扶桑日欲高。\n横笛一声还出牧，稚儿无不笑吾劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和致远登楼有感","author":"彭汝砺","text":"昔人已劝莫登楼，年少登楼应白头。\n鳷鹊雪残冰尚泮，蓬莱云静月如流。\n灯棚影阔明千里，乐部声长在十洲。\n万物莫如公最乐，诗情应祇为民忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠陈扩秀才","author":"彭汝砺","text":"原宪家无金玉储，生涯惟有一床书。\n众人清论谁知子，终日高谈谢起予。\n叔夜未尝闻喜愠，伟容如不辨亲疏。\n丈夫当重功名计，天子重阍好曳裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子文友","author":"彭汝砺","text":"古人湮没不能见，交道陵夷真可哀。\n与子碧江相别后，到今青眼未曾开。\n几伤尺素无人寄，犹喜新鸿昨夜来。\n怀抱相思长抑郁，燕居还念此心哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读张华传","author":"彭汝砺","text":"堂堂才业世无邻，坐揖荆吴属晋民。\n当日若知诛嬖妾，英魂未必死奸臣。\n尚能博识周群物，谁使无谋卫一身。\n典午基图从此殆，开编令我涕沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"彭汝砺","text":"青春久雨郊原暗，白日新开锦绣明。\n苒苒碧丝垂柳树，匀匀红粉上花英。\n人生最贵逢辰乐，暇日终当载酒行。\n无为草玄成寂寞，便输风景属流莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和千乘先生诗","author":"彭汝砺","text":"蓬荜犹淹济世图，独持经术振群愚。\n困穷自古饶贤者，功业于今属丈夫。\n天下久思安石起，时人争笑孟轲迂。\n何时币聘来莘亩，伫听嘉言上禁途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋环翠轩池鸂鶒","author":"彭汝砺","text":"池轩澄澈岸花薰，吾爱微禽独此存。\n野性尚思江海逸，灵心应识稻粱恩。\n春风鼓舞波涛绿，夜月栖迟藻荇繁。\n沙雁溪凫应羡汝，光辉终日望华轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与程德林","author":"彭汝砺","text":"俊骨风标固逸伦，况闻才术巧安民。\n寻常恨不亲高谊，邂逅相逢即古人。\n议论耻拘时俗态，笑歌惟取性情真。\n从今便作忘形契，安得相从席上珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病居寄程德林","author":"彭汝砺","text":"槿花时态厌羁贫，谁恤天涯卧病身。\n千里有家归未得，一心无赖恨长新。\n形容憔悴真衰汉，意气萧条似老人。\n恨乏酒樽将寂寞，独凭诗句诉酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜忆伯兄兼寄诸友","author":"彭汝砺","text":"炎暑遁逃天已凉，日阴苦短夜初长。\n风声日色尽秋意，海角天涯非故乡。\n莺谷久离愁满眼，鸰原一别泪沾裳。\n客情欲借清吟遣，诗就客情弥惨伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"适婺","author":"彭汝砺","text":"浮俗区区走利名，吾儒何事亦劳生。\n昔骑马作衢江计，今买舟为婺女行。\n南北东西无定日，艰难险阻亦常情。\n日多好景谁同咏，樽有清醪且自倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄桐庐诸友","author":"彭汝砺","text":"整顿衰羸尚未苏，信音都向故人疏。\n须怜犬子常多病，莫笑嵇康懒作书。\n庠序旧规还在否，道涂新况比何如。\n鳞鸿若到江南地，愿寄声音一起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄邹广道 其一","author":"彭汝砺","text":"陋学常嗟趣识迷，羡君先得正途归。\n直从前哲评高下，羞与时人较是非。\n长愤荆蒿埋杞梓，忽惊沙砾得珠玑。\n相从未几又相去，东望门阑心欲飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄邹广道 其二","author":"彭汝砺","text":"夙昔闻君有古风，里闾邂逅一相逢。\n金兰密契虽深结，风月高吟未款从。\n宝玉如能庇嘉谷，微蒿终待倚长松。\n江头若有东归雁，时寄声音慰病容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风便示君时叔宜二弟","author":"彭汝砺","text":"挂帆瞬息绝远水，行李逡巡临故乡。\n雨润棣棠千叶叶，云深鸿雁一行行。\n清吟未惬溪山胜，熟睡不知岐路长。\n邂逅此时同此乐，萱堂卮酒意难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简振道判官","author":"彭汝砺","text":"涉汴浮淮即渡江，一春饱满看沧浪。\n临溪高柳为谁绿，隔浦幽花还自香。\n暖日鱼儿浮密藻，轻风燕子语危樯。\n遥知景物烦酬唱，到日诗成几百章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江流","author":"彭汝砺","text":"江流缭绕转天涯，万幅风帆去若驰。\n红日远山开殿阁，青天高木出旌旗。\n蛟龙回泊鳍鳞动，燕雀飞翻羽翮迟。\n身世百年长扰扰，扁舟多谢捕鱼儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子发南楼饯颖叔适以使事出行因寄拙句","author":"彭汝砺","text":"溪山远远绿如如，坐想南楼纵目初。\n相别无缘看杨柳，赠行不敢爱琼琚。\n浮生稍自尝艰险，远道非关畏简书。\n云去正凝千里目，雁来能寄一行欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送君时东归夜宿城外并桥上 其一","author":"彭汝砺","text":"疏疏星月帖云浮，槐叶风声已转秋。\n欲寄归帆终未得，徒分心逐水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送君时东归夜宿城外并桥上 其二","author":"彭汝砺","text":"虹蜺盘泊宿河阴，气势凌空几百寻。\n月近浑如天上坐，风来不见世间音。\n吾衰祇有临渊惧，尔壮能无题柱心。\n病眼昏昏长似雾，不堪频泪欲分襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君时与董君佐以乡荐相次登甲科有诗送之邀予同赋","author":"彭汝砺","text":"青衫慰子久蹉跎，各喜流年壮未过。\n金玉曹刘初并价，渊源游夏复同科。\n红尘去马侵星月，绿水归艎触芰荷。\n邂逅故乡秋正好，相看忆听鹿鸣歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治平赴肥陵幕侍父兄宿大孤山南今复泊于此","author":"彭汝砺","text":"扁舟曾宿此江堧，当日朱颜尚少年。\n彩笔偶攀天上桂，青衫初泛幕中莲。\n浮生梦幻今衰矣，薄宦风波尚慎旃。\n记得父兄游屣处，泪添溪水欲无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送梁晦之","author":"彭汝砺","text":"行李参差久不齐，飘蓬邂逅暂相依。\n趋驰静笑营生拙，老大今知旧态非。\n车马一朝君北去，江湖何日我南归。\n人间物物浑虚幻，莫为分襟泪辄挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江口","author":"彭汝砺","text":"北风吹荡酒旗斜，渡口寥寥数十家。\n茅屋尺椽贫活计，渔罾一幅旧生涯。\n青云正著杨柳叶，白雪已开芦苇花。\n蓬笠焉知慕轩冕，牛羊岂遂胜鱼虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"粹老召饮滕王阁遂过徐亭泛舟戏呈粹老","author":"彭汝砺","text":"溪山高下绿参差，终日清风慰所思。\n何不并携安石妓，却须一过习家池。\n桐孙转影随朱槛，莲子吹香入酒卮。\n晓色江湖秋更好，微云恰值雨来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游东湖","author":"彭汝砺","text":"草色蒹葭芦苇中，莲花一片万枝红。\n斜阳色妒波心日，细雨香吹水面风。\n泽国地开金色界，桃源人在水晶宫。\n扁舟便好如张翰，好在溪边旧钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗呈季友殿丞因寄正父兄","author":"彭汝砺","text":"寂寂门无车马尘，故人相过觉情亲。\n焉知轩冕金朱贵，不笑齑盐藜苋贫。\n看月纵吟颐阁夜，插花沉醉鉴亭春。\n白头想叹童儿事，浑属溪边自在身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生日提点少卿公谔惠诗因次元韵","author":"彭汝砺","text":"水日金行共一乡，丈人每爱我辰良。\n骅骝未解驰千里，弧矢犹知志四方。\n漫与乾坤同作客，笑看儿女已成行。\n贫家祇似寻常日，金玉何为忽在堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄云居觉老大禅师","author":"彭汝砺","text":"云中楼阁绿沉沉，杖策城头望正深。\n山近想瞻师子坐，风来疑听海潮音。\n三乘漫设牛羊鹿，一路谁分耳目心。\n祇道不增还不减，元来非古亦非今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和莘老元日时改元丰 其一","author":"彭汝砺","text":"天以元丰号太平，新年风物兆康宁。\n农人待种滂沱雨，太史仍占润泽星。\n初日浮阳临夏屋，宿霜澄澈照寒厅。\n玉津池北池南路，还拟同探柳眼青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和莘老元日时改元丰 其二","author":"彭汝砺","text":"衣冠投晓贺元正，草木欣欣共晏宁。\n玉历已开新岁日，璿玑犹数去年星。\n风流岂遂同乌府，香火还来共水厅。\n渐老莫惊头欲白，公名久已在丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨浩然见寄因次其韵","author":"彭汝砺","text":"百年流转笑浮生，忧思随时苦未宁。\n心胆爱君长似水，鬓毛如我欲垂星。\n春风半夜烧灯院，腊雪穷年祭酒厅。\n梦寐旧游如昔日，可怜庭柏自青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和大名掾舍弟君时","author":"彭汝砺","text":"大名书到慰离忧，南北还嗟各宦游。\n任责踰涯吾不乐，食功随分汝何羞。\n客尘汎汎常时味，河水浑浑一片愁。\n綵服欲归今未可，遥将心寄日边州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和莘老城东斋祠 其一","author":"彭汝砺","text":"郁郁葱葱佳气中，晓天春雾湿濛濛。\n山川更洗崇朝雨，草木还催二月风。\n乐国地开金色界，容台人在水晶宫。\n长年饱食知无补，尚有私诚祝屡丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和莘老城东斋祠 其二","author":"彭汝砺","text":"天上春来今几时，园林已自足光辉。\n桃心欲放轻红出，柳眼初分嫩绿归。\n解冻暖风吹浩荡，养花新雨落霏微。\n知君准拟多行乐，佳句何妨及绣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"急雨","author":"彭汝砺","text":"远岫低连野水苍，田溪急似雨淋浪。\n灵坛冉冉云烟净，小径深深花草香。\n落日客帆千点细，秋风渔笛一声长。\n诗成未解酬真赏，追逐须将夙愿偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山堂","author":"彭汝砺","text":"江湖曲曲抱千峰，堂在山光水色中。\n云薄祇疑蓬岛近，湖深遥觉海门通。\n扁舟莼菜知无限，促席榴花定不空。\n独倚栏干西北望，子牟此兴亦无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云台","author":"彭汝砺","text":"欲望都门春正深，高台孤绝更登临。\n空云霭霭生归思，鸣雁雍雍多好音。\n华盖荧煌天半际，瀛洲缥缈海中心。\n江天抱病频搔首，自笑纷纷雪已侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郁孤台","author":"彭汝砺","text":"江城尘土日喧喧，中有苍然一点山。\n日暖蜃楼浮海上，花深蓬岛在人间。\n晴云鹤鹤千峰远，碧瓦鳞鳞万屋环。\n却望钟陵何处所，客心先与水东还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离赣上","author":"彭汝砺","text":"昨夜水生三尺来，匆匆相送若相催。\n大声振地潜鱼跃，白浪粘天高岸摧。\n宿雨未收云霭霭，春鸥无数雪皑皑。\n问奴新酿犹馀否，为我临溪开一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送正夫之郓","author":"彭汝砺","text":"清河如练月如霜，六月舟行亦自凉。\n骢马何为轻去国，锦衣不害数还乡。\n高才落落邦之杰，令问洋洋民所望。\n城上望公公更远，人间今日日何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答赵正夫","author":"彭汝砺","text":"风波久与故人违，临水登山百尔思。\n世事易令人苟简，年华稍恨我衰迟。\n尚迁乔木出幽谷，忍舍灵龟观朵颐。\n鱼雁不应嫌寂寞，时将一字寄天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以去年诗再答正夫","author":"彭汝砺","text":"不愿与公终食违，别离草草不胜思。\n老便静处溪山好，懒见闲中日月迟。\n论易朱云折其角，说诗匡鼎解人颐。\n岁云暮矣来何晚，倚杖相望一水涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮君宜弟所寄缁衣酒继得书因成小诗奉寄","author":"彭汝砺","text":"少年离别似寻常，老大别离多感伤。\n饮酒看云心散漫，开书对雨泪淋浪。\n棣棠密织花成锦，鸿雁斜书字作行。\n未到与人贪富贵，会须同汝老耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄君时学正弟","author":"彭汝砺","text":"亦与儿童酌酒醪，焚香颂祝不胜劳。\n命如千载松难老，德比九疑山更高。\n顶上少时多鹤发，眉间近日有霜毫。\n江湖复见年时雁，倚杖孤城首重搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"敏叔家会仙洞","author":"彭汝砺","text":"大松十里建旌麾，晓日朝霞五色衣。\n幽谷静闻猿一啸，白云时见鹤双飞。\n花开洞府春长在，人会瀛洲夜未归。\n家近武陵时入梦，诗成更忆故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答周考功惠黄丝棕心席玉面界方","author":"彭汝砺","text":"老年离别欲心折，不似旧时年少时。\n人世匆忙疑是梦，鬓毛感慨欲成丝。\n刚严碧玉方无玷，润泽黄丝席有仪。\n观物似公长在眼，祝公千岁比灵龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判章承议 其一","author":"彭汝砺","text":"决胜从容樽俎间，一军争死不知还。\n拔旗往蹈乌丸垒，杖箠横封函谷关。\n画像麒麟天上阁，铭功鸡鹿雪中山。\n我荣不与诸公比，归见慈亲一解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判章承议 其二","author":"彭汝砺","text":"卢商舟淅两岐间，四月军行八月还。\n龟息不妨窥道奥，鼠偷无敢近禅关。\n云迷汉水沧浪水，雨湿蒲山岌嶪山。\n曷日与君同此乐，清言犹可慰衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答毛提举惠新酒鸡头依韵奉寄幸一笑","author":"彭汝砺","text":"齐鹄顺风飞上天，空笼遂至扣犹全。\n滑思琥珀千钟满，软忆珠玑一样圆。\n举白醉攻愁自破，硫黄暖与病相便。\n南归几梦凉堂会，咫尺书来更怆然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张侍读游蜀山","author":"彭汝砺","text":"日光拂拂已破卯，野色依依犹带秋。\n风卷旌旗出城曲，云迎步履过林幽。\n欲扳悬崖访猿鹤，更逐去鸟穷渊丘。\n脱洒尘埃坐清旷，静窥万物都蜉蝣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送熊次道因寄了元","author":"彭汝砺","text":"去入红莲幕，来仪振鹭庭。\n文词元润泽，才力更精灵。\n须作晚成器，拟看新发硎。\n綵衣长暇日，多聚读书萤。\n若见焦山老，相烦为寄声。\n别来头上雪，添得一千茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄周朝议至乐堂 其一","author":"彭汝砺","text":"赏花载酒百花洲，看雪开筵白雪楼。\n不尽山川长在目，忘机鸥鸟自随舟。\n当时一笑有馀味，今日相思翻百忧。\n闻说作堂名至乐，几时还得与公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄周朝议至乐堂 其二","author":"彭汝砺","text":"世味中人醉不醒，公归正似解人酲。\n归云意思闲方见，瘦鹤精神老更清。\n但与尧民时击壤，何须秦女会吹笙。\n渊明已有归来赋，沮溺应容作耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邹汉广见寄","author":"彭汝砺","text":"征旆飞飞度夕阳，画桡隐隐照溪光。\n白云点缀千峰绿，青女摧残万叶黄。\n林外小花留蛱蝶，岸边深藻宿鸳鸯。\n沧浪可爱须沉醉，诗老无疑缓报章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济叔润之兄弟见送出小渡","author":"彭汝砺","text":"欲寄穷通逐水沤，共君歌舞醉新秋。\n诗辞可爱题黄叶，别意难忘寄绿洲。\n雨过微风催去棹，夜凉明月满归舟。\n又随天外一飞鹄，可羡波前双白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚晴","author":"彭汝砺","text":"万里无云雨意醒，江湖满载夕阳明。\n老翁暮钓扁舟去，稚子归樵一笛横。\n溪月悠悠含夜意，林风细细作秋声。\n诗魂散落无羁束，试效樊川赋晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山游","author":"彭汝砺","text":"试拂尘衣访远踪，诗魂独与赏心同。\n低低弱柳啼秋雨，细细寒螀啸晚风。\n岩石溪流相照绿，草花枫叶一般红。\n玉琴写尽逍遥意，疑到蓬瀛岛屿中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过岭上","author":"彭汝砺","text":"山幽渐失尘埃路，势险方知造物功。\n岩溜飞光动天上，樵斤遗响落云中。\n烟迷曲岛千峰细，日转寰区万里空。\n安得谪仙来并此，醉浮风驭过蟾宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]