[{"title":"原上曲","author":"释文珦","text":"新冢嵯峨古冢平，冢头浇酒又清明。\n酒痕不到重泉下，榆柳青青春鸟鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅吟 其二","author":"释文珦","text":"逆旅新寒入，荒林败叶飞。\n乡心空自动，衰病不能归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅吟 其一","author":"释文珦","text":"故居抛水石，客路厌风霜。\n衰鬓从教短，馀生不愿长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓行","author":"释文珦","text":"寒鸡误客行，踯躅犯霜露。\n冰冻不生潮，娥江夜难渡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓钟","author":"释文珦","text":"梦觉风吹雨脚断，庵西斜月透疏松。\n披衣起坐不成寐，细听四山鸣晓钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"爱秋","author":"释文珦","text":"宋玉悲秋我爱秋，清秋行乐胜春游。\n林疏尽见山中石，更有寒泉带石流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起 其一","author":"释文珦","text":"病起山房四壁空，一年春尽雨声中。\n无人知道情怀恶，独倚溪桥看落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起 其二","author":"释文珦","text":"卧病厌厌断闻见，年头未识春风面。\n今朝强起步晴光，伤心满地残梅片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作 其二","author":"释文珦","text":"陵谷今迁变，衣冠半不存。\n闾阎小儿女，尽解北人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄友 其二","author":"释文珦","text":"半生行李各东西，无柰相思亿万重。\n又恐因书增别恨，人行不敢寄缄封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚 其二","author":"释文珦","text":"残阳下西岑，暝色起平坂。\n林下一僧归，钟声烟际远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚归","author":"释文珦","text":"乔林瑟瑟起阴风，夜色归山不辨重。\n唯有隐庐偏易认，石楼灯火最深峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚泊","author":"释文珦","text":"烟生浦欲无，日暮潮初落。\n客帆何处来，又近垂杨泊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春","author":"释文珦","text":"游人只道花时好，老子心偏爱晚春。\n万紫千红都谢了，绿阴时见采桑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦回","author":"释文珦","text":"梦回四壁无人语，高树萧萧似有风。\n独起绕池行数匝，万山擎雪月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦觉","author":"释文珦","text":"岞崿东边旧草堂，久抛日日费思量。\n梦中分晓曾归去，觉后身仍在异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深居","author":"释文珦","text":"千岩万壑幽深地，一钵三衣自在身。\n断定不行朝市路，无因犹识利名人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明","author":"释文珦","text":"客路驱驰足自怜，壮怀消歇在花先。\n暖床寂寞听风雨，孤负清明又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔艇 其二","author":"释文珦","text":"斜枕绿蓑衣，醉眠呼不醒。\n午夜天无云，月满孤篷顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧阜水仙花","author":"释文珦","text":"江妃楚楚大江湄，玉冷金寒醉不归。\n待得天风吹梦醒，露香清透绿云衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪晴","author":"释文珦","text":"日照松头冻雪崩，又闻烘拆小池冰。\n起看门外群峰色，绝顶才分翠一棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄葵花","author":"释文珦","text":"一入长门只淡妆，秋衣犹是旧宫黄。\n到头不信君恩断，日日倾心向太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"攲枕","author":"释文珦","text":"彻底清闲住草堂，更无一事可商量。\n时时攲枕寒窗下，静看西山白鹭行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游衢州乌石山观僧房画山水","author":"释文珦","text":"苔径高低草树寒，云从随处有飞湍。\n山中老宿居来熟，却画他山水石看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖亭","author":"释文珦","text":"一堤杨柳青丝软，百顷芙蕖锦障开。\n中有閒人心似水，坐看沙鸟镜中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落叶","author":"释文珦","text":"落叶重重与砌平，流泉澹澹入池清。\n无人识我无人到，独自吟诗独自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花","author":"释文珦","text":"昨日名园锦万丛，一宵风雨树头空。\n浮华往往皆如此，谁解看花似梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山灵峰寺","author":"释文珦","text":"谢公岭下灵峰寺，诺讵罗曾向此居。\n入洞不知归寺路，乱峰相倚上空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒲萄","author":"释文珦","text":"玉瀣乘旒晚，天浆满珞秋。\n孟佗消不得，压取换凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒲萄画","author":"释文珦","text":"弱蔓引修藤，垂旒泫水晶。\n忆曾江路见，风露熟秋棚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦屏山图","author":"释文珦","text":"锦屏山势舞双鸾，影入嘉陵江水寒。\n人在东南归未得，时时独展画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲蝶","author":"释文珦","text":"耳声眼色总非真，物我同为一窖尘。\n蝴蝶不知身是梦，花间栩栩过青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨菊","author":"释文珦","text":"渊明爱佳色，灵均餐落英。\n墨衣林下去，标致更凄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题画 其三","author":"释文珦","text":"浅水与平沙，烟光尽相接。\n鸟立折茄茎，蟹上枯荷叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题画 其二","author":"释文珦","text":"蒲长荷已折，秋水碧相涵。\n日照沙洲暖，鸳鸯睡正酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题画 其一","author":"释文珦","text":"鸥鹭雪衣明，忘机更閒暇。\n青青芳草间，袅袅垂杨下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樵隐","author":"释文珦","text":"归隐青山岁月多，定知无意出烟萝。\n樵风自是仙家事，更莫看棋烂斧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仙翁","author":"释文珦","text":"九曲溪连万树松，树边云屋住仙翁。\n不曾说著人间事，日暮唯先闭鹤笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠道士褚雪巘","author":"释文珦","text":"身不离珠庭，新笺道德经。\n时来琪树下，閒看鹤梳翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一生","author":"释文珦","text":"一生踪迹任浮沉，两鬓何为雪易侵。\n不可破除唯道义，最难凭托是人心。\n清溪路口閒云合，白版门前落叶深。\n老子衰年懒酬应，若非同伴莫相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一钵","author":"释文珦","text":"一钵一枝藤，清虚度此生。\n不贪为至宝，可贱是浮名。\n闭户閒身乐，登山野步轻。\n溪翁与林叟，是识老夫情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七里滩别友","author":"释文珦","text":"断壁青松古，空江翠霭多。\n行人几回老，渔父祇高歌。\n纵有重逢约，其如此别何。\n明朝重回首，惆怅隔烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日吟","author":"释文珦","text":"又过一番秋，秋应笑白头。\n任教花自笑，其奈我忘忧。\n未死聊游戏，才亡即罢休。\n应知皆是幻，尽底付悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人寿","author":"释文珦","text":"人寿百年三万日，有谁曾满百年来。\n腾腾任运聊堪乐，汩汩劳生尽可哀。\n富贵惟增身外累，酕醄当覆掌中杯。\n到头一等皆归死，未死须教笑口开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万山深处","author":"释文珦","text":"万山深处绝諠哗，野鹤孤猿共此家。\n莫使游尘污泉石，有妨闲客卧烟霞。\n寒衣绿芰千层叶，饥食青松数树花。\n无可破除无可羡，清贫却是好生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三术","author":"释文珦","text":"利禄与名称，拘囚岂易胜。\n由来立仗马，有愧脱鞲鹰。\n达者知求解，贪夫反自矜。\n吾方用三术，止观足堪凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千里","author":"释文珦","text":"千里辞家比塞鸿，飘飘不定又还东。\n波平暂喜扁舟稳，天阔回瞻故垒空。\n别墅烟昏归晚牧，长江雨歇挂晴虹。\n前程行止谁能计，已悟浮生似梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中 其一","author":"释文珦","text":"世独休分渭与泾，鸿飞祇合自冥冥。\n也知鬓发变霜雪，终爱山光来户庭。\n蟆傍花阴窥蛱蝶，蜾归筠管祝螟蛉。\n从今万事都抛弃，尽读香山一藏经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中古墓","author":"释文珦","text":"白石苍苔路，荒凉古墓门。\n看来百岁后，曾有几人存。\n故物馀翁仲，今谁是子孙。\n狐狸穿败穴，残魄不能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中田舍","author":"释文珦","text":"茅檐共翠微，井臼亦相依。\n衣望桑麻熟，粮兼芋栗肥。\n山田秋赋少，村乐醉人归。\n不识封侯事，王城相到稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中老宿","author":"释文珦","text":"云壑居来岁月长，千株松下一间房。\n扫空心地苕花帚，熏彻根尘柏子香。\n施法定应拈麈柄，接人曾不下禅床。\n生缘已自都忘了，唯道西归有故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟","author":"释文珦","text":"山林虽寂寞，亦可息尘劳。\n野食分猿果，寒衣补毳袍。\n云踪常散诞，松貌极孤高。\n赋咏随吾意，无心更拟骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中秋日怀友","author":"释文珦","text":"庭树凉飙入，西山爽气多。\n独行清涧曲，閒咏紫芝歌。\n野馔甘黄独，山衣足薜萝。\n幽人同此好，何事不相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中暑月","author":"释文珦","text":"城市如煁灶，输兹山水乡。\n松深不见日，瀑近自生凉。\n静里疑秋至，吟边喜昼长。\n蕉衣与纨扇，皆弃在空箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中道士居","author":"释文珦","text":"寂寂老仙家，苍山一径斜。\n还丹延日月，洞府足烟霞。\n野鹤千年寿，灵桃几度花。\n岂知人世上，尘事乱如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中僧","author":"释文珦","text":"日落西水净，云归北崦昏。\n老僧方在定，童子不应门。\n伏虎知慈力，灵禽演法言。\n槛前泉数斛，清澈是心源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山寺 其二","author":"释文珦","text":"出城行半日，始得到招提。\n山气随时变，州形入望低。\n地灵多产药，村远不闻鸡。\n诘旦还离此，寻幽过别溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山寺 其一","author":"释文珦","text":"古寺氛埃表，幽程屈曲通。\n高峰常似雨，阴壑易生风。\n架栈为平地，寒钟出半空。\n他年依老宿，挂锡此山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山村","author":"释文珦","text":"山村几家住，茅屋障春泥。\n麦陇微通径，桑林半阁梯。\n过溪孤放犊，隔巷数声鸡。\n全似桃源里，游人到欲迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山夜","author":"释文珦","text":"山气夜沉沉，泉流石涧阴。\n虚廊群动息，寒殿一灯深。\n洁白孤蟾影，清澄野客心。\n兴来歌古调，风动古松林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居冬日","author":"释文珦","text":"白水青山不碍禅，登高临远意翛然。\n老梅卧雪香逾远，瘦柏凌霜骨更坚。\n四海交游多契阔，一生陶写赖诗篇。\n人间万事俱抛弃，自此閒居又几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山房","author":"释文珦","text":"山房孟冬月，独坐对残缸。\n侍者嫌贫去，诗魔以静降。\n霜威寒透衲，月色碎穿窗。\n万法皆非侣，令人忆老庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山林古松","author":"释文珦","text":"古松形甚怪，得性在山林。\n偃盖盘空老，流脂入地深。\n青霜曾换骨，野火误烧心。\n材大诚难用，良工亦漫寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山深 其二","author":"释文珦","text":"山深寒易得，九月已萧然。\n况是衰迟者，非同少壮年。\n玄裘如艾絮，禅榻藉蒲毡。\n童子烧枯叶，先教閟暖烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山巅水涯","author":"释文珦","text":"布袜与青鞋，山巅复水涯。\n閒为真富贵，吟是好情怀。\n既可全吾乐，何惭与世乖。\n自随无畚插，忘死亦忘骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞来峰猿","author":"释文珦","text":"恐山还欲去，着尔慰山灵。\n挂处频分影，吟时不见形。\n鹫峰愁外远，巴峡梦中青。\n月下三声苦，幽人却要听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不出","author":"释文珦","text":"饥寒驱不出，忍死住空山。\n芰制几回补，荆扉终岁关。\n是非尘外远，云月句中閒。\n此意难名道，存诸静默间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中殿功德永寿寺产紫芝","author":"释文珦","text":"厚德孰能名，灵芝自化成。\n人间无此种，天上合分茎。\n紫盖随王母，彤云表帝京。\n仙家多服饵，鸾鹤共长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为言以道赋岩隐","author":"释文珦","text":"隐者心常静，山林迹易安。\n几年灵运屐，九转葛玄丹。\n石圃菁苗在，崖房桂影寒。\n岂知尘世窄，万事杂悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为林隐君赋石田","author":"释文珦","text":"石田所无用，君独爱斯名。\n应为诗书种，免教人世争。\n秋风还自穫，春雨不须耕。\n除是长沮辈，能知高隐情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为商隐赋筼房","author":"释文珦","text":"斯筼非俗本，清韵古今同。\n渭上曾千亩，房边又一丛。\n月生金散乱，风过玉玲珑。\n劲节尤宜晚，青青雨露中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门六寺即唐灵澈师旧隐","author":"释文珦","text":"吟遍唐人句，玄踪不易攀。\n一溪清到郭，诸寺各依山。\n暮雨松花老，秋风药井间。\n唯应千岁后，华表鹤飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云林","author":"释文珦","text":"云林佳处辄迟留，不觉骎骎白尽头。\n率野唯闻多虎兕，到门那得有羊裘。\n老身真个如山静，往事从教逐水流。\n富贵功名是何物，才堪休处便须休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五朵峰","author":"释文珦","text":"莫知小朵飞来日，慧理曾经指异踪。\n香润尽多西竺石，孤高亦有晋朝松。\n断无一干栖凡鸟，别有深泓卧老龙。\n绝顶世人游不到，瑶丛清丽似芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄龙井","author":"释文珦","text":"五井蜿蜒宅，幽深父老言。\n傍溪唯见瀑，度岭始知源。\n夹谷斜晖隐，空林夕电翻。\n屡闻当旱岁，噀雨出松门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日作是岁除夕立春","author":"释文珦","text":"腊穷春自至，四序递相延。\n玄发成华发，添年是减年。\n嶰筒灰已动，象魏法初悬。\n吾独存吾道，凝然不受迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]