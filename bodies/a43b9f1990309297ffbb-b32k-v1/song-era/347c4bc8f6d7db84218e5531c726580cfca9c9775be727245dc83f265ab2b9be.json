[{"title":"和李敷察推即席感旧二首 其二","author":"范纯仁","text":"一榜登科二十年，江城偶得共盘筵。\n郑公雅喜中都职，梅福曾由邑吏仙。\n白首相期情契厚，素风犹待子孙传。\n狂歌醉舞形骸外，吾道从来况坦然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋大卿归淝上","author":"范纯仁","text":"眉寿康宁位九卿，人间五福最难并。\n丹心报国冰霜洁，白首还家里社荣。\n化日尽输高世乐，野云应似出门情。\n淮淝美事传千载，何止孤风激后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孔宗翰郎中见寄","author":"范纯仁","text":"圣人流泽到真贤，直节清名奕世传。\n惠政讴谣腾楚甸，醉吟风月满江天。\n嗟予滥典劭农印，归老几无坐客毡。\n一得新诗清百虑，黄粱未熟且安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和傅钦之见寄","author":"范纯仁","text":"至道潜心信有功，目前超悟忽圆通。\n三身不在诸尘外，万象全归一照中。\n念绝去来随处乐，法无取舍自然空。\n护持雅属当仁力，枉问麻阳懒钝翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余周郎中见寄","author":"范纯仁","text":"宦游从昔各艰难，方寸宁禁百虑干。\n忧患早催颜鬓老，风波回念骨毛寒。\n词场久托平生契，酒席方陪此日欢。\n致主庇民嗟晚矣，只堪相约挂尘冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章伯望郊居","author":"范纯仁","text":"独爱高居远市廛，檐楹轩豁对江天。\n门前一曲平桥水，舍侧千畦附郭田。\n鸥鸟渐能亲几杖，儿童应解爱林泉。\n朝廷方待忠贤急，莫厌京尘扑马鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张掞侍郎见寄","author":"范纯仁","text":"恋德怀贤出禁城，片心长挂若摇旌。\n留侯老弃人间事，白傅诗传海外名。\n潇洒琴尊资上寿，太平风月属高情。\n已知世故无关虑，佳句犹烦训后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵怀古二首 其一","author":"范纯仁","text":"天兵从昔度长桥，四海干戈一战销。\n江叟岂能知帝力，醉凭渔艇亢秋潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵怀古二首 其二","author":"范纯仁","text":"六朝文物今何在，千里江山自宛然。\n英武南征无杀伐，至今樵牧尚能传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和元子发学士见寄","author":"范纯仁","text":"二纪区区困宦游，相逢莫讶鬓先秋。\n清时无补身空老，往事难追涕旋流。\n举世交情怜我少，经旬行色为君留。\n何时归去江湖上，风月同寻范蠡舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王著作见寄","author":"范纯仁","text":"疏慵斋阁昼常扃，忽喜君来病魄醒。\n走访禅山诸洞穴，醉吟词客旧林亭。\n十年多难头俱白，四友相看眼共青。\n别后新诗收满轴，芝兰虽远有馀馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李敷重九席上遣兴","author":"范纯仁","text":"谪居閒僻少朋游，珍重征帆肯暂收。\n多难共惊霜绕鬓，重阳还喜菊盈瓯。\n楼前雨洗千山翠，天际江横万里秋。\n节物相催人渐老，此身何日得归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和谢师厚见寄","author":"范纯仁","text":"地僻官粗俦侣稀，乡关回首隔残晖。\n鬓沾楚雾人空老，水落红沙雁自归。\n往事寻思都似梦，素期乖失谩知非。\n东风送雨长西去，心逐轻云日夜飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋赏月","author":"范纯仁","text":"碧落无云玉鉴飞，净中毫发了能窥。\n光随酒蚁斟银榼，彩瑩歌人发瓠犀。\n露重已从巾角垫，轮倾欲把斗杓携。\n醉狂直好探蟾窟，安得陵空万仞梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耿宪见赠","author":"范纯仁","text":"仕途名迹本幽遐，谏省俄登忝世家。\n恩戴丘山宜尽瘁，言关社稷敢攲邪。\n献芹宁识羔羊美，抱瓮徒为智士嗟。\n君子一言华衮重，此身被服愧无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和徐郎中柏枝甘露","author":"范纯仁","text":"素液浓甘胜醴饴，偏零翠柏瑞明时。\n何如溥作丰年泽，万物涵濡被福釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曹职方至日","author":"范纯仁","text":"宦游将老愧蓬飘，逢节他乡倍寂寥。\n世网萦身难自解，鬓霜凝鉴不重消。\n随阳鸣雁闻初急，向日丹枫惜半凋。\n饱暖全家尽君赐，忍看编户独无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耿宪秘校喜雨","author":"范纯仁","text":"愆阳六月气仍骄，多士身劳思亦焦。\n膏泽俄随恩诏溥，螟蝗半逐野云飘。\n岁时敢望家聊给，赋敛能供政有条。\n凿井耕田忘帝力，何当鼓腹播民谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李子高虞部园四首 其一","author":"范纯仁","text":"今时难得是高人，里社因君俗愈醇。\n松竹渐成风月好，只应终日听韶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李子高虞部园四首 其二","author":"范纯仁","text":"脩鍊工夫合自然，河车潜引玉池泉。\n老君道德人难识，复见云孙达二篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李子高虞部园四首 其三","author":"范纯仁","text":"全家归隐似前贤，碧酒醇醲白蟹鲜。\n心欲生民常富寿，高歌会乐太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李子高虞部园四首 其四","author":"范纯仁","text":"不教外物翳襟怀，明合蓍龟亦信哉。\n驽蹇自惭无骏骨，谩劳伯乐品题来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曹演甫中秋见怀","author":"范纯仁","text":"去年对月忆良朋，今夕谁同塞上情。\n华发苍颜人易老，赏心乐事古难并。\n戍楼笛响千山迥，沙漠霜寒万里明。\n半夜归鸿飞不断，好将幽梦到淮城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和阎灏屯田五十岁元日感怀","author":"范纯仁","text":"君缘直道阻横飞，我愧无才振国威。\n同榜同僚忝契分，使秦使蜀重亲依。\n裹粮衣帛身空老，学易知天志尚违。\n白首相期惟信义，世情徒是亦徒非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴仲举通判见赠","author":"范纯仁","text":"侍行曾见羽书飞，独鹤归辽想令威。\n三纪家声几泯泯，重来民俗尚依依。\n脱身负担诚多幸，屏迹山林愿正违。\n主诺已繄贤者助，第承先业愧才非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞下追忆乌江之会寄李诚之待制","author":"范纯仁","text":"主人忘倦客忘归，长忆江边惜别时。\n日下青山犹促席，风冲画鹢正酬诗。\n盘堆白玉鲈腴美，手擘黄金蟹壳肥。\n今日相思孤戍里，尘沙满眼鬓垂丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和阎灏重阳见赠二首 其一","author":"范纯仁","text":"秋怀多感怯清笳，判向西风醉帽斜。\n塞上星霜人易老，幕中谈笑客偏嘉。\n金英浮酒稠于蚁，丹叶妆林远似花。\n身健几逢佳节在，登临尤更惜年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和阎灏重阳见赠二首 其二","author":"范纯仁","text":"登高宜不负良期，须信时光似隙晖。\n碧穗引炉香满坐，黄金绕席菊成围。\n物华旋逐鸣飙减，客思空随去雁飞。\n莫讶尊前偏醉倒，醉乡才到便忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曹演甫秋日见寄","author":"范纯仁","text":"九日天边倚戍楼，他年江国想陪游。\n鲈腴滑与莼丝荐，菊蕊香随酒蚁浮。\n别后星霜催老态，秋来颜鬓染乡愁。\n怀贤感旧情难尽，待向东西丐一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王圣美太丞奉使西来喜而有赠","author":"范纯仁","text":"贤愚虽间契稠重，科籍同兼甲子同。\n省敛劭农明主意，霁威问俗古人风。\n阳和煦物先春到，膏泽随车大旱中。\n感旧知恩谁最笃，塞垣憔悴一衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣美观骑士翥坡","author":"范纯仁","text":"翩翩飞鞚发云间，壮士旁观亦汗颜。\n势若投丸当峻坂，影如掣电下空山。\n汉兵神速从天落，楚骑飙驰取将还。\n圣主恩深怀犷俗，谩教角逐向安閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣美壁间题","author":"范纯仁","text":"胡慑天威自走藏，腐儒焉用合还乡。\n驽骀恋主心终在，鼯鼠营身技不长。\n晚岁胸襟成濩落，故山林壑谩青苍。\n进趋无术归无计，聊得君诗浣肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣美三岔铺留题","author":"范纯仁","text":"今日天涯同一笑，当年泽畔共长吟。\n还朝未复中台职，报主长存国士心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕃舞","author":"范纯仁","text":"低昂坐作疾如风，羌管夷歌唱和同。\n应为降胡能蹈抃，不妨全活向军中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观疆人翥坡","author":"范纯仁","text":"蚁分突骑向高岑，驰下危涂万丈深。\n犷俗轻生唯斗险，垂堂宁复戒千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣美华池感事","author":"范纯仁","text":"圣主忧勤百职脩，忠臣那复作身谋。\n遐方民力资周度，晚岁人情乐小休。\n郭震能僵乌质胫，陈汤解斩郅支头。\n知贤独恨官疏远，珠璧何时免暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈述古宾客万琏郎中二首 其一","author":"范纯仁","text":"智浅才疏合窜流，生逢尧舜忍空休。\n犹惭世旧垂青眼，未报君恩已白头。\n贵老何由操几杖，爱贤曾是继箕裘。\n新春遥祝增眉寿，阻向宾筵跪一瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈述古宾客万琏郎中二首 其二","author":"范纯仁","text":"欣欣万物占芳春，对景那知放逐身。\n粗守素风谙左宦，拟投白社愧高人。\n汉疏蚤命东门驾，商老方为少海宾。\n空辱忘年微报称，浪酬佳唱恃心亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王定国见寄","author":"范纯仁","text":"危踪俄复挂刑书，得丧情怀久已无。\n忧道不知身窜逐，登山未敌世崎岖。\n恋轩无计惭疲马，向日低飞作晚乌。\n薄禄未抛生事拙，涸鳞徒忆纵江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张伯常见寄","author":"范纯仁","text":"芳信初传喜满胸，开缄气燄若长虹。\n文墙目视曹刘短，诗将坛登李杜雄。\n一别寒暄迷甲子，十年尘土谩西东。\n知君善诱存先契，不欲疏顽坠素风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日寄许州韩持国","author":"范纯仁","text":"湖上春游阻重陪，朱轓红旆想徘徊。\n莺花对席应相觅，不见频携醉客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李康侯屯田见寄韵二首 其一","author":"范纯仁","text":"心为积仁唯岂弟，官因任直少升迁。\n处常自享荣期乐，早退皆输白傅贤。\n官路风波今免矣，善人福寿固宜然。\n谪居未遂归田计，犹欲希风向暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李康侯屯田见寄韵二首 其二","author":"范纯仁","text":"仕途三黜信多难，名迹常忧不自完。\n幸赖圣恩宽罪戾，敢辞閒地尽盘桓。\n孟生坠甑何能顾，贡禹尘冠岂复弹。\n俸入虽贫家世事，釜鱼前世已称丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中池上","author":"范纯仁","text":"碧玉为池白玉堤，千林万木尽花开。\n携宾欲觅开尊处，祇得清香辨野梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和管滂著作见寄韵","author":"范纯仁","text":"生平迂拙畏非彝，苦爱曾颜道甚夷。\n麋鹿岂堪婴组绂，渔樵只合在山陂。\n遭时不叹冯唐老，忍耻空惭鲍叔知。\n盈纸更烦佳句赠，雅情深厚俗难窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和席上见赠","author":"范纯仁","text":"官舍荒凉近古城，园林七月起秋声。\n偶来嘉客从芸省，似对清冰满玉罂。\n谈笑从容诚吏隐，逢迎疏野愧朝英。\n田庐未得长归去，山鸟知人半夜鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和任夔节推见寄","author":"范纯仁","text":"暗拙行身足险艰，青云有路敢思攀。\n学承诗礼难窥奥，仕偶唐虞乐抱关。\n掌谏何能裨衮职，护边无术勒燕山。\n风波忽起人情外，瓜李终由自处间。\n白发报君嗟已晚，清朝谪宦愧多閒。\n夫君年壮才方劭，岂合迂迟与我班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王乐道西湖席上","author":"范纯仁","text":"春湖景物画图中，朱阁偏宜翠柳笼。\n上客纵谈髯奋白，佳人醉舞脸舒红。\n铺张锦绣花边日，堆叠琉璃水面风。\n民俗欢游鱼鸟乐，主人才合代天工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王定国见寄","author":"范纯仁","text":"谪居终日省愆尤，贝锦虽成职我由。\n萍梗屡嗟罹放逐，风波更险信沈浮。\n生还故里诚多幸，坐废明时敢不忧。\n自是无才速官谤，非关有命压人头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起和李康侯屯田见寄","author":"范纯仁","text":"养生不达嵇康论，知止聊遵老氏书。\n左宦行将三岁许，羸痾复卧四旬馀。\n手扶瘦竹形相称，鬓拟新霜色一如。\n独枉故人诗意重，涅磨无改是璠玙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王微之同持国泛舟登楼","author":"范纯仁","text":"故人还喜笑言同，把酒相看似梦中。\n老去卜邻逢晏子，从来解榻赖陈公。\n画船稳泛平溪渌，层观高横落日红。\n莫讶狂歌先尽醉，预愁羁旅向山东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郑通议青州范公泉","author":"范纯仁","text":"胜概因人得久存，此泉疏凿自先君。\n发源不负当时意，清影犹涵昔日云。\n养正迥当深涧下，朝宗应与众流分。\n今逢贤帅光陈迹，名逐新诗海内闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张掞侍郎读书堂","author":"范纯仁","text":"三纪仁皇侍从臣，当时文学动簪绅。\n高明已入儒林传，旧室长存历水滨。\n岘首空留王粲宅，香山犹识白公真。\n他年遗迹应无废，不坠诗书世有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘孝叔吏部见寄","author":"范纯仁","text":"一自淮阳阻见贤，俄惊壮齿变衰年。\n宦游嗟我身名玷，早退输君福寿延。\n别后童颜应不改，何时醉袂复相连。\n白头犹忝山城守，常愧君恩未尽宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和北都王宣徽赠觉海大师","author":"范纯仁","text":"心镜如如绝断常，人天魔怨讵能伤。\n本来面目超诸相，自在威仪遍十方。\n石火电光随事过，龟毛兔角竟谁长。\n真风到处堪行化，何必江西选佛场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄康侯推官二首 其一","author":"范纯仁","text":"得请西台鬓已班，便乘骢马出齐山。\n举头桑梓休怀土，信脚伊嵩胜抱关。\n憔悴精神宜早退，太平官职自多閒。\n三公天下称人杰，名迹何堪比数间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄康侯推官二首 其二","author":"范纯仁","text":"少多狂拙老惭非，富贵功名得已迟。\n六秩筋骸难任事，十年台阁谩逢时。\n圣朝贫贱虽堪耻，吏隐优閒合作知。\n回首螭头严近日，恍如曾梦到龙墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以府会阻赴王安之招集次安之韵二首 其一","author":"范纯仁","text":"西都风物最繁华，真率相延有几家。\n游赏直判连日醉，残春可忍负莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以府会阻赴王安之招集次安之韵二首 其二","author":"范纯仁","text":"洛阳春色古称奇，况复名花世所希。\n偶阻嬉游同一醉，任从旭日丽朝晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和文太师真率会","author":"范纯仁","text":"贤者规模众所遵，屏除外饰贵全真。\n盍簪既屡宜从简，为具虽疏不愧贫。\n免事献酬脩末节，都将诚实奉嘉宾。\n岂唯同志欣相照，清约犹能化后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上文潞公同甲会","author":"范纯仁","text":"四公眉寿复均年，此会前脩未省传。\n筋力轻安同少壮，风标萧洒似神仙。\n分司东洛荣难并，聚德西豪事莫肩。\n今夕天官应有奏，老人星彩近台躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送司马伯康君实归夏县","author":"范纯仁","text":"金昆玉季老相亲，孝弟传家四海闻。\n白首还乡疑广受，清朝得志异机云。\n埙篪迭奏声相应，鸿雁连飞翼不分。\n一夜西风响黄叶，萧骚助我叹离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潞国公生日","author":"范纯仁","text":"一阳将复昴当躔，毓粹储精降巨贤。\n启迪先朝承大统，赞襄仁祖格皇天。\n备膺百顺人谁拟，达有三尊我独全。\n嵩岳穹崇河水远，高名遐寿与之肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安之家庭甘结实三首 其一","author":"范纯仁","text":"温甘移种自君家，香雪年年只吐花。\n结实定非江北枳，新诗先费主人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安之家庭甘结实三首 其二","author":"范纯仁","text":"遮藏霜雪免摧残，绿实初垂未满栏。\n想见主人珍惜意，一回出户一回看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安之家庭甘结实三首 其三","author":"范纯仁","text":"花果从来盛洛都，黄甘结实古来无。\n分金未足均闾里，就赏应须倒百壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]