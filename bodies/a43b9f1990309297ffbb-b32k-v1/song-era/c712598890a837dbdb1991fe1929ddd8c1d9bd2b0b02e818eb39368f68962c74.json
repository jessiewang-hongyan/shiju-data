[{"title":"偈颂一一二首 其一○七","author":"释清远","text":"放得下，好脱洒。\n放不下，牛拽杷。\n堪笑诸方老古锥，打鼓说禅无尾把。\n无尾把，不惊怕。\n不惊怕，可嗟讶。\n解踏毗卢顶上行，不言亦自传天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○八","author":"释清远","text":"归根得旨复何论，洞口秦人半掩门。\n花落已随流水远，空留羃羃野云屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一○九","author":"释清远","text":"玄沙白纸费封题，一听雷音万仞低。\n慰释私怀已无量，那堪更唱逻罗哩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一一○","author":"释清远","text":"一手不独拍，两手鸣掴掴。\n举意超情念，相看同路陌。\n摩云钟阜高，遍界乌轮赫。\n妙机速雷电，神珠不在额。\n珍重人天大导师，衲僧一见丧魂魄，何也谁敢正眼觑著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一一一","author":"释清远","text":"暂下莲峰轻屈指，光阴倏尔又三年。\n虽然不隔丝毫许，争似躬亲到座前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一一二首 其一一二","author":"释清远","text":"一二三，无言童子口喃喃。\n三二一，上下四维无等匹。\n衲僧活计绝丝毫，万古徽猷是今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以偈美世奇首座","author":"释清远","text":"有道只因频退步，谦和元自惯回光。\n不知已在青云上，尤更将身入众藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别僧演","author":"释清远","text":"西别岷峨路五千，幸携瓶锡礼高禅。\n不材虽见频挥斧，钝足难谙再举鞭。\n深咸恩光同日月，未能踪迹上林泉。\n明朝且出山前去，他日重来会有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苍梧即事","author":"谢孚","text":"近岸江声急，孤舟下杳冥。\n峡泉飞暴雨，滩石走群星。\n水有潇湘色，猿同巴蜀听。\n令人思舜德，一望九疑青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋朝请倅邢州","author":"蔡薿","text":"布衣初喜得相从，淡薄情怀老更同。\n春酒杯盘花烂漫，夜堂灯火雪冥濛。\n家传辞藻喧时誉，地近乡枌识土风。\n早晚汉庭褒一鹗，待看霜翮上秋空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"蔡薿","text":"云藏北固山头寺，烟锁南徐水际楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至猪钩沙","author":"蔡莱","text":"江树栖烟暝色浮，波声不动月华流。\n浪花千顷潮平岸，兴入春风万斛舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西宫","author":"蔡莱","text":"云兴霞蔚控千山，势压江南广殿寒。\n风偃万松斜日晚，卧看风雨落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藏云轩","author":"蔡莱","text":"山边畏景欲流金，山下浮埃几度深。\n水宿岩栖得真乐，可无馀事到商林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠孙至丰","author":"黄葆光","text":"劝农因到好溪头，把酒相看忆旧游。\n三十年来如一梦，可怜空负钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题开善精舍","author":"刘韐","text":"琴书收拾去，回首谢禅关。\n紫绍搜裼切，青云咫尺间。\n子牟趋魏阙，文靖起东山。\n共约重游日，春风昼锦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫云岩","author":"刘韐","text":"万叠青山入画图，最高高处著浮屠。\n薄云弄日明还暗，小雨飞空有却无。\n山鸟避人疑俗驾，道人好客点云腴。\n我来一笑忘尘虑，倒载归欤日欲晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦野亭","author":"唐恪","text":"云梦泽南古景陵，登临聚景在幽亭。\n几重湛湛陂湖绿，万叠阴阴桑柘青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠泉州谢事五老","author":"陆藻","text":"五老三百九十七，俱生仁祖承平时。\n名齐庐阜久传世，身异商山深采芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"陆藻","text":"轩前山色依然绿，轩下泉声漱玉寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西岩寺","author":"翁彦国","text":"涧行屈曲似乘槎，流水漂裙乱晓霞。\n紫翠堆中访萧寺，隔溪烟树两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"翁彦国","text":"新经牛渚弃星槎，倒影光中蹙紫霞。\n竹马儿童休借问，君恩还许过吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述怀","author":"陈遘","text":"不觉霜飞上鬓毛，引杯看剑兴犹豪。\n胸开万古天风荡，目拭三山海月高。\n投阁羞称扬子易，啜醨爱读楚人骚。\n媕婀莫遣无生气，支住乾坤在我曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李西杰水竹居","author":"刘章（微之","text":"在昔香山老，水友而竹师。\n心虚是师道，性静友亦宜。\n孰谓物理妙，乃为高贤资。\n佳哉陇西子，结屋溪之湄。\n溪上亦何有，有竹如在淇。\n涓涓峙寒碧，澄澄烛须眉。\n微风一披拂，杂佩声参差。\n俄顷万籁寂，粹然淡馀姿。\n可但子师友，我方师友之。\n未到三叹息，徒劳形梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒲鞋","author":"刘章","text":"吴江浪浸白蒲春，越女初挑一样新。\n才自绣窗离玉指，便随罗袜上轻尘。\n石榴花下从容久，玳瑁筵前整顿频。\n今日高楼鸳瓦上，不知掷果是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释智才","text":"舜日重明四海清，满天和气乐升平。\n延祥柱杖生欢喜，掷地山呼万岁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集众付寺事偈","author":"释智才","text":"戊午中秋之日，出家住持事毕。\n临行自己尚无，有甚虚空可觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一 沩山百年后，向山前檀越家作一头水牯牛去。","author":"释智才","text":"翻手书空字已成，忙忙人向两头争。\n屈原不是寻渔父，千古谁人论独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二 玄沙白纸","author":"释智才","text":"踏翻渔艇成家业，笑出芦华月正圆。\n地阔天长三幅纸，同风千里为重宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己酉岁十一月二十六日避寇至龙潭院十二月十五日作五首 其一","author":"洪炎","text":"径转桥横水，林深寺据山。\n钟鱼告阒寂，松竹媚孱颜。\n避地欣有托，依僧成暂閒。\n东归路不隔，片片陇云还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己酉岁十一月二十六日避寇至龙潭院十二月十五日作五首 其二","author":"洪炎","text":"突兀山椒寺，披榛二百年。\n刹从吾祖卜，席是里僧传。\n溪送无尽水，林供不断烟。\n囊中有馀粒，假息且安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己酉岁十一月二十六日避寇至龙潭院十二月十五日作五首 其三","author":"洪炎","text":"潭黑蛟龙宅，山青虎豹林。\n隐忧何日了，淹泊见冬深。\n薄雪恨还积，疏梅冷不禁。\n平生一樽酒，衰病废孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己酉岁十一月二十六日避寇至龙潭院十二月十五日作五首 其四","author":"洪炎","text":"杀气缠中土，妖徵出泰阶。\n架桥凌禹穴，投策暗秦淮。\n匪兕歌何苦，非熊愿亦乖。\n申胥虽有泪，无地寄余怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己酉岁十一月二十六日避寇至龙潭院十二月十五日作五首 其五","author":"洪炎","text":"宵旰忧虽切，咨谋策靡长。\n筑坛推骑劫，假节得糜芳。\n已矣重江险，哀哉古豫章。\n蓬茅今在否，矫首恨难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郑公实见赠二诗 其一","author":"洪炎","text":"郑侯风概似虞薰，醉饱初疑对苾芬。\n一日君尝南浦水，六年我踏宝峰云。\n诗情赋物已闻命，山色溪光傥见分。\n群盗何曾念王粲，相逢聊喜见斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郑公实见赠二诗 其二","author":"洪炎","text":"百濯生香真宝薰，中泠取水挹清芬。\n素娥影落秋宵月，白鹤翎翻春昼云。\n俗客来依禅客住，林花自与雨花分。\n扶倾不假迂儒力，敢倚笔端能缀文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝峰读驹父壁间诗次其韵二首 其一","author":"洪炎","text":"兔迒通一线，笋舆度千寻。\n隔林见潭影，迎客有铃音。\n梵呗出广殿，飞舞来珍禽。\n履此胜绝境，一清尘虑心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝峰读驹父壁间诗次其韵二首 其二","author":"洪炎","text":"仲氏趣玄远，造诣非尺寻。\n谁云干戈际，获睹金玉音。\n七日南山雾，一鸣幽谷禽。\n依然拂尘壁，愁绝见予心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵公实感遇","author":"洪炎","text":"求田问舍转头空，十口无家寄栗蓬。\n得失自怜婴世网，是非都欲问天公。\n绵绵不解溪边雨，淅淅无情松下风。\n赖有诗人排闷作，且吟佳句任穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵公实喜晴二首 其一","author":"洪炎","text":"冻雨连三日，春膏过一犁。\n寺桥杯渡水，村径橇行泥。\n燠若生旸谷，寒收岂石犀。\n欲穷洪范理，夕室有青藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵公实喜晴二首 其二","author":"洪炎","text":"持璧还投鹊，镕金恨作犁。\n行吟乘晓月，扶杖入春泥。\n愿学怀文豹，终惭秃角犀。\n徒歌无好语，野饭只羹藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冯太冲置酒即事次公实韵","author":"洪炎","text":"故人同客寓，萧寺近清明。\n春事一樽酒，夜阑三尺檠。\n风流孔北海，文字汉西京。\n苦劝加餐饭，年来太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝峰笋用公实韵","author":"洪炎","text":"绕寺千林笋，高低逐涧丘。\n参差舒凤尾，突兀长猫头。\n入鼎资甘脆，残杯且罢休。\n会须堪小艇，裁作海楂浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公实示閒字韵诗怅然有感次韵奉和三首 其一","author":"洪炎","text":"晴晖生燠雨生寒，朱夏阳春季孟间。\n断雁哀猿金马客，落花流水石门山。\n早知蚁穴成何事，欲棹渔舟去不还。\n昭氏有琴无作止，亏成都任一机关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公实示閒字韵诗怅然有感次韵奉和三首 其二","author":"洪炎","text":"辍哭人歌行路难，畏人无地出人间。\n欣逢北海孙宾石，犹是江南庾子山。\n野草离离随意绿，群凫泛泛倦飞还。\n一川烟草松萝外，何处梯云叩九关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公实示閒字韵诗怅然有感次韵奉和三首 其三","author":"洪炎","text":"此国非燕南赵北，我琴无濮上桑间。\n劳生聊作梦中梦，苦语莫酬山复山。\n触石白云数峰起，照人明月一钩还。\n德星已为荀陈聚，紫气休浮函谷关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"载酒邀公实同过西园食枇杷次公实韵","author":"洪炎","text":"有美枇杷子，三珍共一时。\n朱樱梁苑早，卢橘蜀都迟。\n载酒宁辞病，窥园似好奇。\n酬君要佳句，从古未题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公实再赋枇杷次韵二首 其一","author":"洪炎","text":"连云葱茜外，佳树枇杷林。\n味极东南美，恩知雨露深。\n山夫琢栗玉，谷鸟避丸金。\n永日羁栖意，兹焉一慰心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公实再赋枇杷次韵二首 其二","author":"洪炎","text":"醽醁尊中酒，枇杷云外林。\n甘餐千颗尽，软语一杯深。\n老境宜扶杖，交情得断金。\n遗民伐荻去，真处即吾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公实作暴雨诗次其韵","author":"洪炎","text":"民生惟播殖，天意在农深。\n一夜盆倾雨，千家粒食心。\n知时占聚蚁，催种有鸣禽。\n喜是田间语，青青刺水针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵即事二首 其一","author":"洪炎","text":"自愧山林士，来炊萧寺烟。\n怨惊寄猿鹤，飞跃任鱼鸢。\n咄咄空中字，昏昏醉后眠。\n摛文非孟子，何以差狂颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵即事二首 其二","author":"洪炎","text":"寄榻逢僧夏，登场喜麦秋。\n一风将浃日，四月尚重裘。\n去矣吁何及，归欤幸少休。\n雨晴寒自戢，桂魄更添愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵野步","author":"洪炎","text":"意行无远近，山径自横斜。\n烟月生晴岭，风幡接暮霞。\n影归巢幕燕，声散宿林鸦。\n屣履相随处，僧垣即是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游都梁山","author":"洪炎","text":"风吹古渡口，云满都梁山。\n执热厌偪仄，幽寻上孱颜。\n清泉似石乳，滴沥岩窦间。\n乞此一瓢饮，为祛千载烦。\n山灵知我意，殷然下层峦。\n散空作急雨，抉石出甘寒。\n一酌荡齿颊，三咽萦肺肝。\n轻躯变滞骨，尘鞅思灵关。\n来当踏云至，去当御风还。\n再拜谢神休，幸汝不我悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野步","author":"洪炎","text":"散策寻溪偶缓行，羁栖愁眼忽双明。\n非烟羃羃平芜合，倒影层层远翠横。\n鸥鹭低飞映山去，江湖一诺百金轻。\n直知已造洞天内，身在人间却自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石门中夏雨寒","author":"洪炎","text":"五年胡骑秽中原，四月江南尚薄寒。\n入昴谁能移太白，来朝我亦见呼韩。\n灌坛风雨行将戢，陋巷箪瓢且自宽。\n红日再中天地正，泥涂不辱汉衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵即事","author":"洪炎","text":"端居入夏愁更新，不数多愁过一春。\n蹑虚难同若士去，取醉但与索郎亲。\n朝天几日车同轨，击地共唱胡无人。\n自许世才非管乐，聊将心事比雷陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尝白酒用糜韵","author":"洪炎","text":"竹叶榴花久擅场，一尊云液胜椒浆。\n人惟任达常中圣，药自消忧不作狂。\n满泛冰瓷无别色，错斟瓶水有真香。\n祇应剩酝逡巡酒，始耐仙山日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚戌岁六月四日至洪城旧庐无复尺椽怅然伤怀用丙午岁迁居诗韵","author":"洪炎","text":"南州一炬火，我归无所归。\n六月下惊湍，一叶正复敧。\n空城何所有，城阙双阖扉。\n遗氓四五辈，?眙虫鸟栖。\n潭潭大都府，灰灭馀空基。\n委重者谁子，汝实凡且卑。\n蝼蚁轻民命，泥沙捐国赀。\n犬狼肆噬齧，驱逐乃其宜。\n胡为使群吠，如恶草蔓滋。\n哀哉三万室，钟此百六期。\n故居不可识，将是复疑非。\n阶前手种花，自怜托根微。\n露草相对泣，吟风作悲诗。\n人言城门火，鱼祸自靡遗。\n我亦无泪哭，且复一解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病间和公实饮酒诗","author":"洪炎","text":"忧每伤人人亦忧，花蒙两眼雪蒙头。\n干戈满地不可触，蓑笠为家何处浮。\n秋入鸣蝉催暑去，酒如凝露与清谋。\n写成庾信江南赋，更续相如老倦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏和公实感秋对酒","author":"洪炎","text":"青山爱客长青眼，白水知时泛白云。\n少日悲欢才一瞬，中星寒暑又平分。\n稻粱狼藉馀栖亩，雀鼠穿窬自立勋。\n一叶已惊秋意早，映阶黄落更纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵公实七月一日雨感怀二首 其一","author":"洪炎","text":"平生离俗得閒多，素发惊秋奈老何。\n宾从盘飧惟白石，意行供帐有青萝。\n御风独往松三径，踏月空归雪一蓑。\n短布单衣穷至骭，醉吟不作饭牛歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵公实七月一日雨感怀二首 其二","author":"洪炎","text":"日日愁随万绪多，遣愁不去若愁何。\n文书引睡翻黄卷，福地求生访绿萝。\n酒厌银瓶聊注瓦，衣辞锦袄且披蓑。\n五更风雨作金石，助我贯珠商颂歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将去宝峰诵老杜更欲投何处赋五言三首 其一","author":"洪炎","text":"更欲投何处，乾坤老病身。\n穷愁但有骨，栖泊渺无津。\n岩穴探幽薮，人烟隔几秦。\n驱车上九折，回首想伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将去宝峰诵老杜更欲投何处赋五言三首 其二","author":"洪炎","text":"更欲投何处，穷猿不择林。\n低回竹柏语，惨戚钟鱼心。\n邑邑出门泪，行行度岭吟。\n西江如可吸，在处海潮音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将去宝峰诵老杜更欲投何处赋五言三首 其三","author":"洪炎","text":"更欲投何处，仙山不可窥。\n欲寻吴许迹，默与绮园期。\n裹饭随妻子，清秋问路歧。\n神真有汲引，逸驾或容追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弈棋绝句二首 其一","author":"洪炎","text":"新秋遣闷只围棋，病不衔杯亦废诗。\n对局萧然两无语，个中君子有争时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]