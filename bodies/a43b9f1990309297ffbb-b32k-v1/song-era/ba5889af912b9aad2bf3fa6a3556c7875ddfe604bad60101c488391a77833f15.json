[{"title":"次韵送卢汝舟","author":"刘才邵","text":"秋鸿社燕若为情，歧路东西亦可惊。\n入夜朔风摇画角，满空星斗罩高城。\n吴江浪阔兼天涌，楚塞山长尽日横。\n记取别筵看剑处，怕听庭树晓鸡声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送江虞仲","author":"刘才邵","text":"烜赫家声四海闻，材猷超绝出凡伦。\n清规映物无尘隔，实德临民蒙惠均。\n器远自应当要路，政成还合觐严宸。\n禁途虚位须贤俊，伫庆登崇宠渥新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和丁浚明戏萧济夫 其一","author":"刘才邵","text":"生世才如石火光，应怜不早见卢郎。\n碧蟾自合来栖月，黄耳何缘得上床。\n但使知音同卓氏，何妨服猛似梁鸯。\n观音妙相谁能测，暂化身为无厌王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和丁浚明戏萧济夫 其二","author":"刘才邵","text":"庾妇休誇意智强，却因诈魇唤江郎。\n自从呼婢曾开口，不复连宵只对床。\n春晚燕狂捎蛱蝶，汀闲沙暖睡鸳鸯。\n凤栖已协和鸣兆，谁记东家人姓王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵萧元隆见寄二首 其一","author":"刘才邵","text":"国朝制策得群贤，隆栋才高异众椽。\n温诏久颁崇旧典，英辞初喜见新编。\n伫登文陛三层峻，还寄家声万古传。\n圣主忧民收远策，欲令枕奠得安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵萧元隆见寄二首 其二","author":"刘才邵","text":"麟阁岧峣倚碧天，道山宿直烛如椽。\n谁怜老眼今多病，喜读危词屡绝编。\n一鹗奋飞方远举，双鱼缄素肯轻传。\n益思张胆论时事，未敢昏昏只醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王民瞻","author":"刘才邵","text":"野外萧条供给稀，愧烦车马顾柴扉。\n正怜习懒成痴钝，欲使乘时试奋飞。\n高义杉松度冰雪，好诗星斗转璿玑。\n如公亦岂宜深隐，早晚光芒动少微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其一","author":"刘才邵","text":"兰殿光风转，椒涂淑气浓。\n柳烟添晓翠，花露浥春容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其二","author":"刘才邵","text":"紫禁迟迟漏，瑶箱细细风。\n君王问安早，红烛照帘栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其三","author":"刘才邵","text":"宝胜金书小，酥盘花样新。\n六宫呈妙巧，清晓庆佳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其四","author":"刘才邵","text":"瑞气笼春宫殿高，天官仙乐奏云璈。\n欲知圣寿无疆处，王母千回献碧桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其五","author":"刘才邵","text":"君王圣母与天通，预建慈宁广内中。\n果庆回銮功已就，纂修事实示无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其六","author":"刘才邵","text":"春归顿觉日华迟，乐事偏多属圣时。\n万寿声中觞酒满，年年岁岁拥春祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其一","author":"刘才邵","text":"一气回苍陆，千祥集紫宸。\n天心存爱育，施惠发新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其二","author":"刘才邵","text":"行仁隆治道，偃武为生灵。\n恩施周遐迩，熙熙万国宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其三","author":"刘才邵","text":"盛德天垂覆，皇明日照临。\n九重颁汉诏，四海识尧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其四","author":"刘才邵","text":"始和布政同天运，圣泽随春下九霄。\n垂法端闱万人喜，典章尽复祖宗朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其五","author":"刘才邵","text":"海国占风慕圣明，先春入贡竭丹诚。\n梯航万里不辞远，要趁新年贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其六","author":"刘才邵","text":"瑞日舒长呈五色，官仪赫奕会三朝。\n宴开紫殿恩辉重，乐奏彤庭雅韵调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其一","author":"刘才邵","text":"风转万年枝，冰开百子池。\n多男应禖祀，瑞气恰来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其二","author":"刘才邵","text":"琼斝深浮柏，金笺巧颂椒。\n宫嫔随凤辇，万寿本东朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其三","author":"刘才邵","text":"紫庭烟淡祥光满，清禁风微淑气新。\n绮阁靓深无一事，观书临帖过芳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其四","author":"刘才邵","text":"飞霙顷报丰年庆，天瑞由来应克诚。\n喜见农祥已晨正，将持嘉种奉亲耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春内中帖子词 其五","author":"刘才邵","text":"绛阙清都境异常，况当圣世物皆昌。\n风催柘馆桑枝秀，冰满龙池荇带长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午内中帖子词 其一","author":"刘才邵","text":"云篆摹仙印，香菰缠綵丝。\n风回五明扇，日丽万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午内中帖子词 其二","author":"刘才邵","text":"神飙随律至，玉宇倍清凉。\n复古观书处，偏宜昼漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午内中帖子词 其三","author":"刘才邵","text":"两岐呈瑞麦，三秀产灵芝。\n天意方垂佑，宸心愈肃祇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午内中帖子词 其四","author":"刘才邵","text":"巽权默运甄陶外，德泽遐宣指顾中。\n号令一新民气乐，正如解愠得薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午内中帖子词 其五","author":"刘才邵","text":"天申佳节继天中，贺庆年年信始通。\n明诏重颁浮论息，共知至计出天衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午内中帖子词 其六","author":"刘才邵","text":"百昌蕃殖归神化，万宇欢康属圣时。\n形气既和无疾疠，冰台还更觉生迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游西湖天竺书所见成五绝句 其一","author":"刘才邵","text":"秋风萧瑟海天凉，不见红衣十里香。\n惭愧湖边拒霜在，数枝擎露学啼妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游西湖天竺书所见成五绝句 其二","author":"刘才邵","text":"灵风袅袅转幡幢，红蜡光中一缕香。\n万德庄严等尘土，北珠南贝若为妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游西湖天竺书所见成五绝句 其三","author":"刘才邵","text":"寒泉秋菊水仙堂，华竟无人荐晚香。\n赖有新诗伴冰蕊，犯寒欺雪斗宫妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游西湖天竺书所见成五绝句 其四","author":"刘才邵","text":"千顷琉璃湛晓光，纷纷兰菊动秋香。\n疏烟小雨多情思，个是西湖淡薄妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游西湖天竺书所见成五绝句 其五","author":"刘才邵","text":"石井灵泉镜样方，龙宫流出倍甘香。\n可怜溪女低蓬首，斜插山花照晚妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题滴水岩 其一","author":"刘才邵","text":"泠泠清响落岩中，正脉由来触处通。\n一滴也无真戏论，谁知白浪已翻空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题滴水岩 其二","author":"刘才邵","text":"曾酌曹溪一掬甘，笑他梁燕自呢喃。\n根尘却是圆通境，个里何妨舌本参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李彦渊郎中试院三绝句 其一","author":"刘才邵","text":"铨曹注拟待群才，妍丑先分宝鉴开。\n馀力留诗在岩壁，护持神物已应来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李彦渊郎中试院三绝句 其二","author":"刘才邵","text":"春满湖山草木芳，薰晴晓日动微黄。\n遥知从骑归来处，穿破东风十里香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李彦渊郎中试院三绝句 其三","author":"刘才邵","text":"野草幽花似缬斑，僧窗聊寄两旬闲。\n衣冠行赴东都会，官府深严不在山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试黄权笔为作三绝句 其一","author":"刘才邵","text":"名属仙民住武夷，能将巧思利毛锥。\n宣城遗法依然在，一逐人间好尚移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试黄权笔为作三绝句 其二","author":"刘才邵","text":"渴骥精神伤太紧，秋蛇筋骨定非奇。\n要须从此胸中正，方见中书事事宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试黄权笔为作三绝句 其三","author":"刘才邵","text":"八法森严得者稀，管城还伴剡藤悲。\n欲教霜兔魂无恨，须写当时颜段碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松","author":"刘才邵","text":"山中众木自纷纷，移徙孤根独不群。\n更与清风同烈烈，便先八俊继三君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古柏","author":"刘才邵","text":"移根得地对幽轩，香叶苍然已可怜。\n他日定为梁栋具，耽耽大厦倚晴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梧桐","author":"刘才邵","text":"琴材岂必百年期，翠叶萋萋已满枝。\n况是常生易封殖，政平喜见中兴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蟠桃","author":"刘才邵","text":"奇芬不与众芳同，移植应从碧海中。\n结子纵迟人莫怪，灵苗端的有仙风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝天李","author":"刘才邵","text":"玉妃朝谒珠宫惯，暂到人寰别九天。\n恋阙丹心终不变，亭亭素艳吐清妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄杨","author":"刘才邵","text":"不怪天公赋与悭，应怜坚正长偏难。\n三年桤木真容易，谁肯吟哦著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏竹","author":"刘才邵","text":"护惜龙孙意正勤，风漪谁爱织成纹。\n林中莫著山王辈，拟向他时咏五君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以双井茶寄李仲孙","author":"刘才邵","text":"双井真成日铸兄，一杯不觉醉魂醒。\n知君笔法传山谷，啜罢应临戒石铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其一","author":"刘才邵","text":"溪水溶溶影动摇，盈盈仙子近星桥。\n个中著句须清绝，莫道经春雪未消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其二","author":"刘才邵","text":"华清赐浴洗凝脂，一曲霓裳素练衣。\n更有十分相似处，晓霜添就玉肌肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其三","author":"刘才邵","text":"莫恨随风片片飞，微酸暗结已无疑。\n世人欲识和羹效，看取高宗梦觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其四","author":"刘才邵","text":"露白飞香岂入时，幽姿谁遣独先期。\n可怜栏槛花无数，春意潜回犹未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其五","author":"刘才邵","text":"应嫌素质露天真，却把轻黄拂蕊尘。\n休向吟窗动诗兴，多情先自不禁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其六","author":"刘才邵","text":"愁云向晓不胜繁，飞霰纷纷溅兔园。\n竹里数枝偏有意，欲将冷艳慰霜根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其七","author":"刘才邵","text":"远树归鸦欲噪昏，闲云撩乱暗江村。\n冰肤无著凝寒处，耐冷不缘餐日魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其八","author":"刘才邵","text":"水仙似怯难为弟，更著山矾数满三。\n惭愧涪翁继和靖，惊人诗句出东南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其九","author":"刘才邵","text":"风泛寒香方浩荡，月移清影更徘徊。\n不妨绝妙谁同赏，恰有幽人踏雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梅花十绝句 其十","author":"刘才邵","text":"洗尽残妆倚玉楼，世间脂粉且休休。\n芳心未必伤幽独，冷雨疏烟与替愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵伯达梅花三绝句 其一","author":"刘才邵","text":"昭君生长巫山村，独负娇容似玉温。\n恰似此花开腊后，芳心脉脉与谁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵伯达梅花三绝句 其二","author":"刘才邵","text":"莫奏悲笳向日昏，花飞不是减芳春。\n多情更作回风舞，体弱悬知不陷茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵伯达梅花三绝句 其三","author":"刘才邵","text":"丞相家园雪里开，琼枝斗白远高台。\n十年戎马暗京洛，旧赏犹能入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又咏梅花","author":"刘才邵","text":"正与卢生清兴同，冲寒还肯访幽丛。\n窗前忽见偏奇艳，恰在茸茸淡月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"官舍有梅花一株偶赋绝句","author":"刘才邵","text":"已洗方清为有尘，无尘因洗更清新。\n香山谩说工纤艳，错把梨花比太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"映日梅","author":"刘才邵","text":"冰肌耐热本神人，肯与寒光便浅颦。\n应笑海棠无道骨，睡红怯翠不禁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月下梅","author":"刘才邵","text":"月到琼枝夜未央，天将清景荐孤芳。\n疏云似恐嫦娥妒，却与时人隔素光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱新仲席上赋梅花影四首 其一","author":"刘才邵","text":"老禅墨戏信奇哉，山谷称扬意亦瑰。\n未似灯前出寒影，真香不假返魂梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱新仲席上赋梅花影四首 其二","author":"刘才邵","text":"真是瑶台月下仙，徐熙落墨若为传。\n输他巧思红裳女，写出幽姿意宛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱新仲席上赋梅花影四首 其三","author":"刘才邵","text":"清影新诗二妙并，弓良更遇国工檠。\n自惭痴钝无佳思，击缶难参击玉清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱新仲席上赋梅花影四首 其四","author":"刘才邵","text":"万缘合处本无心，明暗相形亦漫成。\n光影都亡复何物，更须试问老师兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏芍药 其一","author":"刘才邵","text":"紫清楼阁不施丹，小样谁传到此间。\n方信游蜂非俗物，窥窗玉女斗妖娴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏芍药 其二","author":"刘才邵","text":"人言花似征鞍色，嫩紫茸茸个样奇。\n不道征鞍似花染，临岐聊欲问何离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题茅山多叶芍药诗","author":"刘才邵","text":"司命霓旌款帝关，司花仙史亦骖鸾。\n谁人黠似东方朔，偷出名花与世看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又间金红芍药诗","author":"刘才邵","text":"诗家赋咏怯挥毫，比象偏难为格高。\n浑似上元朝阿母，流金铃间赤霜袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱新仲白菊三绝句 其一","author":"刘才邵","text":"海甸秋深亦陨霜，不因寒苦减真香。\n冰容本自嫌施彩，青女何劳抹晓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]