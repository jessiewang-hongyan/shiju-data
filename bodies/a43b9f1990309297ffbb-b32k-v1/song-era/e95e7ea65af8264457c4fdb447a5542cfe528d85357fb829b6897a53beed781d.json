:68551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题荐福寺","author":"杨万里","text":"千山底里著楼台，半夜松风万壑哀。\n晓起巡檐看题壁，雨声一片隔林来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵昌父山居八咏 其五 已矣轩","author":"杨万里","text":"蛮触无休日，菟裘有别天。\n抚松非已矣，采菊未悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵昌父山居八咏 其一 竹隐","author":"杨万里","text":"大隐隐于酒，小隐隐于竹。\n何不呼曲生，来同此君宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵昌父山居八咏 其三 苔竹轩","author":"杨万里","text":"青士长得瘦，翠兄工买贫。\n向来素爱者，已赚一诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵昌父山居八咏 其六 倚云亭","author":"杨万里","text":"俗子令眼白，瑞峰令眼青。\n自移听雨榻，且上倚云亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵昌父山居八咏 其二 晏斋","author":"杨万里","text":"五陵槿梢花，千驷草头露。\n富贵人始传，屡空今不数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵昌父山居八咏 其七 霞牖","author":"杨万里","text":"夕借月为烛，晨将霞作帘。\n犹言贫到骨，不悟取伤廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钟家村石崖二首 其二","author":"杨万里","text":"水与高崖有底冤，相逢不得镇相喧。\n若教渔父头无笠，只著蓑衣便是猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钟家村石崖二首 其一","author":"杨万里","text":"莫爱悬崖万丈高，只工险峭作风涛。\n看来一一生窠眼，解与行人著过篙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清远峡峡山寺二首 其二","author":"杨万里","text":"见说岩中雪色猿，啸声时出翠微间。\n不看新月初三夜，却觅当时旧玉环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清远峡峡山寺二首 其一","author":"杨万里","text":"只道真阳天下稀，不知清远亦幽奇。\n攀崖下照龙湫水，细咏东坡老子诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题章贡道院","author":"杨万里","text":"江西道院赋金华，近日当涂共两家。\n更著崆峒三道院，只销卧治醉莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题萧岳英常州草虫轴盖画师之女朱氏之笔二首 其二","author":"杨万里","text":"笔端春草已如生，点缀虫沙更未停。\n浅著鹅黄作蝴蝶，深将猩血染蜻蜓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题萧岳英常州草虫轴盖画师之女朱氏之笔二首 其一","author":"杨万里","text":"常州草虫天下奇，女郎新样不缘师。\n未应好手传轮扁，便恐前身是郭熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾无己所藏高丽疋纸蔡君谟欧公笔迹","author":"杨万里","text":"三韩玉叶展明蠲，诸老银钩卷碧鲜。\n幸自不逢文与可，一竿秋竹扫风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题桄榔树","author":"杨万里","text":"化工到得巧穷时，东补西移也大奇。\n君看桄榔一窠子，竹身杏叶海棕枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题谢昌国金牛烟雨图","author":"杨万里","text":"金牛烟雨最相关，老子方将老是间。\n不分艮斋来貌取，更于句里占江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题韩亭韩木二首 其二","author":"杨万里","text":"笑为先生一问天，身前身后两般看。\n亭前树子关何事，也得天公赐姓韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题韩亭韩木二首 其一","author":"杨万里","text":"老大韩家十八郎，犹将云锦制衣裳。\n至今南斗无精彩，只放文星一点光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题照上人迎翠轩二首 其一","author":"杨万里","text":"寺外秋山触眼明，寺根秋水洗心清。\n晴岚暖翠来未了，不用高人倒屣迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题照上人迎翠轩二首 其二","author":"杨万里","text":"参寥癞可去无还，谁踏诗僧最上关。\n欲具江西句中眼，犹须作礼问云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题榠查红叶","author":"杨万里","text":"榠查将叶学丹枫，戏与攀条撼晚风。\n一片飞来最奇绝，碧罗袖尾滴猩红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赣州重建思贤阁","author":"杨万里","text":"赵公遗爱虎头城，直到张公续此声。\n前赵后张俱可阁，赣民不用羡西京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凝露堂木犀二首 其二","author":"杨万里","text":"梦骑白凤上青空，径度银河入月宫。\n身在广寒香世界，觉来帘外木犀风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凝露堂木犀二首 其一","author":"杨万里","text":"雪花四出剪鹅黄，金屑千麸糁露囊。\n看去看来能几大，如何著得许多香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩分水岭望乡二首 其二","author":"杨万里","text":"岭北泉流分外忙，一声一滴断人肠。\n浪愁出却庐陵界，未入梅山总故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩分水岭望乡二首 其一","author":"杨万里","text":"岭头泉眼一涓流，南入虔州北吉州。\n只隔中间些子地，水声滴作两乡愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩冷水村道傍榴花初开","author":"杨万里","text":"茜罗绉薄剪薰风，已自花明蒂亦同。\n不肯染时轻著色，却将密绿护深红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩楹塘驿二首 其二","author":"杨万里","text":"松鸣竹啸响千崖，为底炎蒸吹不开。\n自是笋舆趋北去，薰风不是不南来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩楹塘驿二首 其一","author":"杨万里","text":"夹路黄茅与树齐，人行茅里似山鸡。\n长松不与遮西日，却送清阴过隔溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"檃括东坡观棋诗引并四言诗二首 其二","author":"杨万里","text":"五老峰前松荫庭，风光清美日华明。\n独游略不逢一士，时有纹枰落子声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"檃括东坡观棋诗引并四言诗二首 其一","author":"杨万里","text":"老坡独往到庐山，白鹤观中俱昼眠。\n只有棋声人不见，寂然流水古松间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕脂楼子","author":"杨万里","text":"楼子燕脂色，灯前艳更鲜。\n看花直到晓，今夕不成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薄晚绝句二首 其二","author":"杨万里","text":"暂出嫌喧可得除，漫游久废未全无。\n路逢盐裹知城近，店有鸡声觉日晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薄晚绝句二首 其一","author":"杨万里","text":"春气吹人不作醒，病身感物底心情。\n斜阳也不藏人老，偏照霜髭一两茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衡山值雨","author":"杨万里","text":"稍喜归涂中半程，犹愁泥潦未知晴。\n雨来也不怜行客，风过何须作许声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写真刘敏叔秀才二首 其二","author":"杨万里","text":"江右传神下笔亲，杉溪集里识刘君。\n君今有子能传业，撞过烟楼更入神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e0