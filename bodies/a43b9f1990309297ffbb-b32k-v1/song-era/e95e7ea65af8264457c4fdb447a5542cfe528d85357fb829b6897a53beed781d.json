erneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赤孤同亭馆","author":"杨万里","text":"数菊能令客眼明，三峰端为此堂横。\n仆夫不敢催侬去，只道长沙尚八程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈叔虎绣梅花扇","author":"杨万里","text":"指下生寒影，针端即化工。\n冰痕将雪点，不受烛光融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题周子中司户乘成台三首 其二","author":"杨万里","text":"只须独立领秋光，何用安排石鼓双。\n平揖青原未为差，更于竹外见长江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题周子中司户乘成台三首 其一","author":"杨万里","text":"不烦营筑便成台，自有青松不用栽。\n只道先生忙更懒，也须一日一回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题周子中司户乘成台三首 其三","author":"杨万里","text":"先生无劓何须补，上到乘成尽放怀。\n松树尚堪驱使在，为公一一捧诗牌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题所寓唐德明书斋","author":"杨万里","text":"凫鹜行中脱病身，竹林深处得幽人。\n只言官满浑无事，也被诗愁搅一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d