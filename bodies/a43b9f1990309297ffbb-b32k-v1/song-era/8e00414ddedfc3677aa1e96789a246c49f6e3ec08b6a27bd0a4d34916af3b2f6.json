[{"title":"洛阳","author":"易士达","text":"季龙方始是童时，视志观声已叹奇。\n啸倚上都门外者，如何夷甫却先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草屦","author":"易士达","text":"崎岖只惯识羁情，足下忙穿子更轻。\n近世宦途如纸薄，当知险处不须行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柴桑山","author":"易士达","text":"千古先生节最高，功名识破等鸿毛。\n如今亦作柴桑隐，只把荷衣当绿袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪","author":"易士达","text":"阿瞒南幸国几危，颠倒皆由豢禄儿。\n休说马嵬当日事，浯溪且细读元碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫愁村","author":"易士达","text":"千古行人说莫愁，荒村依旧石城头。\n不知艇子今何在，汉水滔滔空自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途间观野菊","author":"易士达","text":"林峦露骨草无芽，枯柳吟蝉迹见沙。\n莫道西风全肃杀，行边无处不黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途间偶成","author":"易士达","text":"拂晓挑藤去路忙，倦投野店午炊香。\n闲看昔日题诗处，依旧榴花出短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅","author":"易士达","text":"月上吟窗疏影浮，暗香风动袭衣裘。\n温存留索巡檐笑，遮莫高楼起笛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"易士达","text":"搜诗索笑傍檐梅，冷蕊疏花带雪开。\n莫把枯梢容易折，留看笑影上窗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅碑","author":"易士达","text":"冷蕊谁回笔底春，不教花落更纷纷。\n自从揭在吟窗里，常带催诗一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨花","author":"易士达","text":"满院朝来白雪香，伤心遥想旧阿房。\n故园弟子今何在，春雨溶溶空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄陵庙","author":"易士达","text":"帝辇南游竟不还，二妃望断九疑山。\n森森万古祠前竹，犹带当时粉泪斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景阳井","author":"易士达","text":"白莲阁下小方池，后主曾于此避隋。\n知拥二妃何处去，至今石脉带胭脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"温泉","author":"易士达","text":"当日温泉浴太真，岂知绣袜解尘生。\n更于洗滑凝脂处，尚忆胡儿在锦绷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上","author":"易士达","text":"两岸青帘箫鼓多，闲愁到此总消磨。\n湖光十里平如掌，稳泛轻舟击楫歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琴","author":"易士达","text":"花间横膝兴何深，流水高山几古今。\n一自杏坛声响绝，不知谁解继遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登拟岘台","author":"易士达","text":"叔子声名千古香，几多遗爱在襄阳。\n后来景行瞻先哲，善政丰碑共久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中","author":"易士达","text":"梅雨丝丝未放晴，泥途剩作几程行。\n客怀方此无聊赖，更著啼鹃两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锁江亭","author":"易士达","text":"锁江水下水悠悠，只锁长江不锁愁。\n但存一樽浇旅思，图教沉醉泛扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓬山馆","author":"易士达","text":"庭馆飞翚气象雄，两山峙秀傍苍穹。\n我来检点多奇胜，恍在蓬莱第一宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人草","author":"易士达","text":"霸业将衰汉业兴，佳人玉帐醉难醒。\n可怜血染原头草，直至如今舞不停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滕王阁","author":"易士达","text":"滕王歌舞旧城楼，一度登临一度愁。\n惟有西山南浦景，教人千古说洪州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题邓氏船斋","author":"易士达","text":"平生心乐水云乡，卜得书窗瞰碧塘。\n自有济川勋业在，不劳两柁与风樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石溪伟观","author":"易士达","text":"水共长天不尽头，石溪奇处着危楼。\n我来倚徙阑干看，风撼芦花叶叶秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题先月阁","author":"易士达","text":"新筑亭台分外凉，广寒移下水云乡。\n才当暝色千山合，便有檐前一点光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙智不俗轩","author":"易士达","text":"亭亭修竹两三竿，鼓动天风掠鬓寒。\n一点红尘飞不到，满窗冰雪自相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈巽斋寒窗听雪诗卷","author":"易士达","text":"彤云黯淡酿天寒，却向江头理钓船。\n雪打蓬窗眠不著，声声时送到吟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题秋江烟草诗卷","author":"易士达","text":"万里长江浸碧流，烟笼细草满孤洲。\n吟怀到此难排遣，独立斜阳古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钱翁杨伯传竹浦吟稿","author":"易士达","text":"关西今喜有云仍，冰雪相看一样清。\n最是晚来江上处，饱听叶□助诗声。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠写神吴子可","author":"易士达","text":"不数僧繇只数吴，丹青幻出活形模。\n问君写尽人多少，写得人心一片无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠易数胡一鉴","author":"易士达","text":"学本先天造化中，希夷康节与磨砻。\n光明照破人心事，一片灵台不是铜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"易士达","text":"小园名涉趣，趣不在园花。\n乐水撑孤艇，爱山乘小车。\n浅深随种艺，红紫任交加。\n胸次藩篱剖，八荒同一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居自道","author":"易士达","text":"山林清富贵，何在玉堂居。\n诗积囊中锦，家多几上书。\n碑文堪帐壁，薇蕨当盘蔬。\n安分箪瓢乐，虽贫绰有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花朝燃灯","author":"易士达","text":"唤起园丁葺小园，喜逢社友访林泉。\n莺花世界春方半，灯火楼台月正圆。\n闲不待偷皆乐地，趣随所得到吟边。\n丁宁莫刬庭前翠，留与游人伴醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朋溪探梅韵","author":"易士达","text":"锦囊分付与溪奴，江路寻幽属野夫。\n暖信已传春到未，暗香还动月明无。\n妆因底事偏清雅，态为何人转瘠癯。\n惹起诗魂禁不得，恍然飞越亦忘吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宦叔送往临川","author":"易士达","text":"征衣何惜染尘埃，款段搜诗亦快哉。\n百里亭长与亭短，一天云合复云开。\n倾茅柴酒和馀粕，弹接䍦巾去薄塺。\n不是剡溪清兴尽，声声杜宇劝归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和梅花韵","author":"易士达","text":"生爱梅兄是淡交，每相逢处更吟嘲。\n暗香疏影名千古，冷艳孤光雪几梢。\n东阁诗才犹腹稿，西湖人物尚衡茅。\n风前有恨曾知否，不得随泥上燕巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苔钱","author":"易士达","text":"造化为炉巧冶成，儿童指似五铢轻。\n买春无算空流地，润屋何心望满籯。\n祇恐痴人思宿债，枉教处士负贪声。\n汉皇不吝铜山赐，羞杀申屠恶妒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春闺","author":"易士达","text":"燕语莺啼触拨侬，院深懒傍绣帘栊。\n一年春事半晴雨，万里云帆几夕风。\n柳欠温存牵怨恨，萍无拘束自西东。\n此情莫向桃花说，说与桃花也落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游东湖","author":"易士达","text":"好是东湖近物华，微吟去路亦何赊。\n两堤柳影澹台墓，十里荷香孺子家。\n淡淡烟笼僧寺静，飘飘风飐酒旗斜。\n重来徙倚阑干久，天末残阳噪暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹林伤田家","author":"易士达","text":"阴阴沈沈雨霏霏，农夫把秧妻抱儿。\n前村后村歌相答，上亩下亩泥正肥。\n新谷登场腹不饱，新丝出盎身不丝。\n膏粱纨裤一笑乐，粉白黛绿千金挥。\n农家升苗一寸税，里正打门星火追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李润父资圣寺壁间韵","author":"易士达","text":"古径萦迂碧藓深，瘦藤得得叩丛林。\n雪浮茗枕陪僧话，风度松窗奏法音。\n断壁剔虫伤古画，拂尘挥兔断清吟。\n留衣尚有重来约，一笑何妨载酒寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻杜鹃再韵","author":"易士达","text":"片片桃花下钓矶，声声杜宇暮春时。\n迩来夔峡多游子，正好从头唤取归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花曲 其一","author":"易士达","text":"老树槎芽知几年，结根更在苍崖巅。\n雪深三尺冻不折，春条森森临风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花吟","author":"易士达","text":"孤山和靖真奇士，绕屋种梅清彻底。\n暗香和月透寒窗，压尽几多红与紫。\n挨排花品果为魁，南枝向暖首先开。\n当时疏影横斜句，几度吟从笔底来。\n劝君莫奏城头角，吹得梢头花片落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云石耕夫道院","author":"易士达","text":"片云块石一耕夫，耕得情田数亩馀。\n不用木金为耒耜，祇将纸墨当菑畬。\n塞茅心撤犹芟草，翻水文成若决渠。\n三岁一番供贡籍，平时不用纳王租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"易士达","text":"催趱荼蘼交夏景，安排芍药送春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽故知容州朝请陶公章二首 其二","author":"易中行","text":"顾予生最后，相去又临川。\n欠识先生面，幸亲令子贤。\n典型端有自，衣钵岂无传。\n德似君家好，清修一节坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽故知容州朝请陶公章二首 其一","author":"易中行","text":"平塘古君子，出处一渊明。\n诗句月般好，宦情云样轻。\n从教五马贵，不博几鸥轻。\n满目西山恨，遥途驻降旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹","author":"易元矩","text":"一别虞妃去未还，愁云空锁九疑山。\n世间多少相思泪，洒遍修篁染不斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其一 咏熟水","author":"易少夫人","text":"何处甘泉来席上，嫩黄初汤银瓶。\n月团尝罢有馀清。\n惠山名品在，歌舞暂留停。\n欲赏壑源新气味，不应兼进狶苓。\n此中端有淡交情。\n相如方病酒，一饮骨毛轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其二 咏熟水话别","author":"易少夫人","text":"记得高堂同饮散，一杯汤罢分携。\n绛纱笼影簇行旗。\n更残银漏急，天淡玉绳低。\n只恐曲终人不见，歌声且为迟迟。\n如今车马各东西。\n画堂携手处，疑梦又疑非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓岸","author":"易平湖","text":"扁舟晓泊画桥西，风满蓬窗水拍堤。\n落舟半山人未起，万蛙声里子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阳乐故城","author":"易时敏","text":"典午河山尚有名，兴从阳乐故城生。\n夕阳门巷丘墟久，春草池塘野水平。\n废堞栖乌啼夜月，闲壕留雁叫寒更。\n人民非处桃花在，一度东风一度荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顾王遗址","author":"易时敏","text":"远树芊芊暮霭平，顾王曾此保孤城。\n雷封已并田同井，烟爨犹疑灶满营。\n当代貔貅谁削迹，芳春杜宇自呼名。\n黍离行迈应相似，倍感诗家咏叹情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙虎山","author":"易性中","text":"云气蓬莱近，山阴草树香。\n御风不知远，仙骨已清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄山谷龟壳诗韵二首 其二","author":"易祓","text":"支床纳息三百年，也胜刳赐贮金屋。\n问子多智亦多穷，何如莲叶安巢宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄山谷龟壳诗韵二首 其一","author":"易祓","text":"一枝自足鹪鹩巢，一居犹胜蜗牛屋。\n道人身外本无求，况有龟轩可栖宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄山谷琼芝诗韵","author":"易祓","text":"千岁蟾蜍犹得仙，百年枸杞足延命。\n也须点铁自成金，未信磨砖能作镜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悬钟石","author":"易祓","text":"不今不古不朝昏，只与南山伴白云。\n我既无声亦无臭，众生当以不闻闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题识山楼","author":"易祓","text":"山外如何便识山，白云出岫鸟知还。\n更看面目知端的，却在先生几格閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读唐中兴颂","author":"易祓","text":"唐家基业重于山，宁许胡雏据九关。\n当日人心旋□堵，异时世变却循环。\n壤分旄钺谁能制，政出貂珰不复还。\n千古高崖锁苍藓，空留遗迹蹈元颜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄御史节判陶岑","author":"易祓","text":"我醉欲眠君罢休，谁能倚杖听江流。\n蕉花当户不知午，梧叶满庭疑是秋。\n吾道从来无物累，此心何处不天游。\n鸿边幸有音书至，春在江南云梦洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示从侄茂","author":"易祓","text":"万事皆从忙处错，寂然不动乃能通。\n君看开济规模事，却属南阳高卧翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安灵龙潭","author":"易祓","text":"流水淼无际，其源遍坤舆。\n压之以山麓，壅淤谁与疏。\n神物夜相宅，风雷发欷歔。\n擘开苍玉峡，泻作清泠渠。\n安得探其穴，扁舟武陵渔。\n吾闻覆载閒，不过一身如。\n九窍互开閤，血肤乃张舒。\n其閒或积滞，气郁成痈疽。\n山泽本通气，自然厥中虚。\n明河转地轴，乔岳并郊墟。\n脉络无不寓，地行乃其馀。\n请观千丈瀑，高出康谷庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和太白感秋诗韵","author":"易祓","text":"我无适俗韵，滥剖江成竹。\n惟有南山云，对之若可掬。\n秋堂风露清，岂不念羁独。\n行年四十九，亦复此栖宿。\n二子亦有契，兹期定前卜。\n泛观穹壤间，物剥继以复。\n消息固常然，天地非反覆。\n姑置勿复言，新篘已清熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪中兴颂","author":"易祓","text":"湘江东西直浯溪，上有十丈中兴碑。\n谁凿丰碑镇山曲，溪边美人美如玉。\n想当歌颂大业时，胸蟠星斗光陆离。\n蚕须虿尾更清劲，凛凛襟怀冰雪瑩。\n水部之文鲁公书，两翁寥寥千载馀。\n后来更有黄太史，健笔题诗起翁死。\n一派溪流彻底清，溪边镜石坚而明。\n我思古人不可见，水石犹作琼瑰声。\n朅来名山访遗迹，烟雨凄迷山路湿。\n野叟蒙头看打碑，君其问诸水边石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"易祓","text":"自古清胜地，江带与山篸。\n夸娥擘此石罅，不独岭之南。\n初见仙岩第一，再见砻岩第二，今见淡岩三。\n丘壑皆有分，品第不须谈。\n望前驱，陪后乘，破晴岚。\n出城一舍而近，峭壁与天参。\n不使尘埃涴脚，忽觉烟云对面，鹤驭可同骖。\n杖屦从归去，此乐湘潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 春感","author":"易祓","text":"帝城春昼。\n见杏脸桃腮，胭脂微透。\n一霎儿晴，一霎儿雨，正是催花时候。\n淡烟细柳如画，雅称踏青携手。\n怎知道、那人人，独倚阑干消瘦。\n别后。\n音信断，应是泪珠，滴遍香罗袖。\n记得年时，胆瓶儿畔，曾把牡丹同嗅。\n故乡水遥山远，怎得新欢如旧。\n强消遣，把闲愁推入，花前杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪","author":"朱淑真","text":"纷纷瑞雪压山河，特出新奇和郢歌。\n乐道幽人方闭户，高歌渔父正披蓑。\n自嗟老景光阴速，谁使佳时感怆多。\n更念鳏居憔悴客，映书无寐奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一剪梅","author":"易祓妻","text":"染泪修书寄彦章。\n贪做前廊，忘却回廊。\n功名成就不还乡，铁做心肠，石做心肠。\n红日三竿懒画妆。\n虚度韶光，瘦损容光。\n不知何日得成双，羞对鸳鸯，懒对鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]