[{"title":"腊后二首 其二","author":"杨万里","text":"云暗虚疑暮，江空分外寒。\n如何山雨过，便尔岸沙乾。\n奈此诗愁得，怀哉岁事阑。\n梅残吾更忍，不折一枝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊夜普明寺睡觉二首 其二","author":"杨万里","text":"作腊聊村酒，依人只短檠。\n略无更可数，听到雨无声。\n犬吠知何苦，鸡寒肯更鸣。\n生来眠不足，老去梦难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊夜普明寺睡觉二首 其一","author":"杨万里","text":"旅梦忘为客，檐声忽唤愁。\n亲庭未差远，佛屋不胜秋。\n只么功名是，如今悟解不。\n十年行路饱，谁不遣吾休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜑户","author":"杨万里","text":"天公分付水生涯，从小教它踏浪花。\n煮蟹当粮那识米，缉蕉为布不须纱。\n夜来春涨吞沙觜，急遣儿童斸荻芽。\n自笑平生老行路，银山堆里正浮家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢人送常州草虫扇","author":"杨万里","text":"生怕炎天老又逢，草虫扇子献奇功。\n还将多稼亭前月，卷尽西湖柳上风。\n蚱蜢翅轻涂翡翠，蜻蜓腰细滴猩红。\n旧时绿鬓常州守，今作霜髯一秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢从善挽词","author":"杨万里","text":"一腹储三箧，双钩挽万牛。\n行身平中准，阅世澹于秋。\n紫诰犹新墨，霜髯忽古丘。\n清风未作记，挂剑泪川流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢叶叔羽总领惠双淮白二首 其二","author":"杨万里","text":"情知北味饮中瑰，暖律何缘到死灰。\n去岁海红犹间识，今年淮白不曾来。\n一寒尚有绨袍赠，双鲤仍随尺素回。\n厚禄故人书尽绝，只馀计相解相哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢叶叔羽总领惠双淮白二首 其一","author":"杨万里","text":"宝奁寡贡笑权臣，筠掩分甘荷故人。\n天下众鳞谁出右，淮南双玉忽尝新。\n未知丙穴果何似，只恐子鱼无此珍。\n敢遣腹腴劝年少，一杯端合寿吾亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢永新大夫杨叔裕惠诗","author":"杨万里","text":"今代吾家后子云，新诗也解乞陈人。\n银河波浪痕痕玉，花县风光字字春。\n大胜十年灯火读，更无半点簿书尘。\n鹗章塞得公车破，便合留渠立紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢傅宣州安道郎中送宣城笔","author":"杨万里","text":"忽惊骑吏叩柴荆，厚禄移书访死生。\n今日犹迟傅岩雨，前身端是谢宣城。\n解包兔颖霜盈把，试墨山泉月一泓。\n老里苦吟翻作拙，撚须枉断两三茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢余处恭送七夕酒果蜜食化生儿二首 其二","author":"杨万里","text":"新酿秦淮鸭绿坳，旋熬粔籹蜜蜂巢。\n来禽浓抹日半脸，水藕初凝雪一梢。\n岂有天孙千度嫁，枉同河鼓两相嘲。\n渠侬有巧真堪乞，不倩蛛丝罥果肴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢余处恭送七夕酒果蜜食化生儿二首 其一","author":"杨万里","text":"踉蹡儿孙忽满庭，折荷骑竹臂春莺。\n巧楼后夜邀牛女，留钥今朝送化生。\n节物催人教老去，壶觞拜赐喜先倾。\n醉眠管得银河鹊，天上归来打六更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢张子仪尚书寄天雄附子北果十包","author":"杨万里","text":"今古交情市道同，转头立地马牛风。\n如何听履星辰客，犹念孤舟蓑笠翁。\n馈药双奁芬玉雪，解包百果粲青红。\n看渠即上三能去，大小毗陵说两公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢张功父送近诗集","author":"杨万里","text":"十年不梦软红尘，恼乱闲心得我嗔。\n两夜连翻约斋集，双明再见帝城春。\n莺花世界输公等，泉石膏肓叹病身。\n近代风骚四诗将，非君摩垒更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢李君亮赠陈中正墨","author":"杨万里","text":"麝烟薰透大夫松，胶国吹成赤鲩公。\n龙尾研磨碎苍璧，鼠须飞动出晴虹。\n谁言陈子草玄手，突过蒲家读墨功。\n老我久无椽样笔，为君小楷注鱼虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢岳大用提举郎中寄茶果药物三首 其一 日铸茶","author":"杨万里","text":"瓷瓶蜡纸印丹砂，日铸春风出使家。\n白锦秋鹰微露爪，青瑶晓树未成芽。\n松梢鼓吹汤翻鼎，瓯面云烟乳作花。\n唤醒老夫江海梦，呼儿索镜整乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢岳大用提举郎中寄茶果药物三首 其三 新松实","author":"杨万里","text":"三韩万里半天松，方丈蓬莱东复东。\n珠玉鍊成千岁实，冰霜吹落九秋风。\n酒边腷膊牙车响，座上须臾漆櫑空。\n新果新尝正新暑，绣衣使者念山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢皇太子三月十九日召宴荣观堂颁赐金杯襭罗","author":"杨万里","text":"春草池塘太液旁，水精宫殿牡丹香。\n惭非绮里攀鸿翼，也侍承华宴凤庄。\n玉唾银钩看落笔，绣袍金椀拜盈箱。\n迎门儿女牵衣袖，搜得随侯与夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢赵行之惠霜柿","author":"杨万里","text":"红叶曾题字，乌椑昔擅场。\n冻乾千颗蜜，尚带一林霜。\n核有都无底，吾衰喜细尝。\n惭无琼玖句，报惠不相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢淮东漕虞寿老宝文察院寄诗二首 其二","author":"杨万里","text":"鹓行接翼复分襟，酒病诗愁老不禁。\n十载江湖千里月，一生金石两知心。\n悼亡君有安仁戚，归隐侬为梁父吟。\n早晚故人天上去，未应廊庙忘山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢淮东漕虞寿老宝文察院寄诗二首 其一","author":"杨万里","text":"诗吸三江捲五湖，彫琼为句字为珠。\n前身谢守吟澄练，今代世南行秘书。\n獬豸峨冠久尘醭，星辰听履即须臾。\n夜来飞入东园去，梦里分明觉后虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢福建提举应仲实送新茶","author":"杨万里","text":"词林应玚绣衣新，天上茶仙月外身。\n解赠万钉苍玉胯，分尝一点建溪春。\n三杯大道醺然后，七椀清风爽入神。\n闻道闽山官况好，何时乞得两朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢蜀帅刘仲洪尚书龙学遣骑诒书之惠","author":"杨万里","text":"紫衣军将打门来，云锦书从锦水回。\n个是国西天一柱，早归斗下位三能。\n致身将相黑头在，怜我渔樵青眼开。\n旧日雪山寒刮骨，祇今移取上春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢潭帅余处恭左相遣骑惠书送酒三首 其三","author":"杨万里","text":"相思命驾竟成休，投老寒盟岂自由。\n雪后风涛难访戴，山间生死总依刘。\n烦公赤手回青昊，容我清溪弄白鸥。\n稚子尚堪驱使在，门阑桃李未应秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢潭帅余处恭左相遣骑惠书送酒三首 其二","author":"杨万里","text":"鹊语灯花两太谩，三朝五夜强相驩。\n打门军将还惊枕，破屋山人起著冠。\n知己书从天上落，焚香手把月中看。\n少陵泛爱虚名句，羡杀寒儒眼不寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢潭帅余处恭左相遣骑惠书送酒三首 其一","author":"杨万里","text":"小烦上相领元戎，潭府千年一日雄。\n镜样洞庭那得浪，身为天柱不须峰。\n子房富贵云相似，中立安危国与同。\n帝恐我公招不出，那时虚左到今冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋张功父通判直阁所惠约斋诗乙藁","author":"杨万里","text":"句里勤分似，灯前得细尝。\n孤芳后山种，一瓣放翁香。\n苦处霜争涩，臞来鹤校强。\n不应穷活计，公子也忙忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋陆务观剑南诗藁二首 其二","author":"杨万里","text":"剑外归乘使者车，浙东新得左鱼符。\n可怜霜鬓何人问，焉用诗名绝世无。\n彫得心肝百杂碎，依前涂辙九盘纡。\n少陵生在穷如虱，千载诗人拜蹇驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋陆务观剑南诗藁二首 其一","author":"杨万里","text":"今代诗人后陆云，天将诗本借诗人。\n重寻子美行程旧，尽拾灵均怨句新。\n鬼啸狨啼巴峡雨，花红玉白剑南春。\n锦囊翻罢清风起，吹仄西窗月半轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋姜春坊梅山诗集二首 其二","author":"杨万里","text":"承华寮寀集鸳鸾，不减应徐宴魏园。\n中有钓璜清渭叟，向来授钺少陵坛。\n锦心绣口搴花草，雪椀冰瓯泻肺肝。\n身到梅山得梅魄，老夫更借一枝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋姜春坊梅山诗集二首 其一","author":"杨万里","text":"松风涧水打窗声，玉佩琼琚触眼明。\n当昼如何挂秋月，未春特地转新莺。\n只销一卷梅山集，幻出多般景物情。\n老子平生有诗癖，为君焚却老陶泓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋悟空道人墨迹","author":"杨万里","text":"葱岭书如积，银钩墨尚新。\n前身虞学士，今代卫夫人。\n曲水脩兰禊，明珠采洛神。\n更令添此帖，急就不须珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋萧彦毓梅坡诗集","author":"杨万里","text":"西昌有客学南昌，衣钵真传快阁旁。\n坡底诗人梅底醉，花为句子蕊为章。\n想渠蹋月枝枝瘦，赠我盈编字字香。\n若画江西后宗派，不愁禽贼不禽王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道旁槿篱","author":"杨万里","text":"夹路疏篱锦作堆，朝开暮落复朝开。\n抽心粔籹轻拖糁，近蒂燕支酽抹腮。\n占破半年犹道少，何曾一日不芳来。\n花中却是渠长命，换旧添新底用催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道逢王元龟阁学","author":"杨万里","text":"秋日才升却雾中，先生更去恐群空。\n古谁云远今犹古，公亦安知世重公。\n轩冕何缘关此老，江山所过总清风。\n我行安用相逢得，不得趋隅又北东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁来红","author":"杨万里","text":"开了元无雁，看来不是花。\n若为黄更紫，乃借叶为葩。\n藜苋真何择，鸡冠却较差。\n未应犀菊辈，赤脚也容它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感兴","author":"杨万里","text":"行役忘衰暮，逢春感物华。\n一来梅岭外，三见木绵花。\n山鹿宁游市，江鸥本卧沙。\n红尘无了日，白发未还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感兴","author":"杨万里","text":"去国还家一岁阴，凤山锦水更登临。\n别来蛮触几百战，险尽山川多少心。\n何似闲人无藉在，不妨冷眼看升沉。\n荷花正闹莲蓬嫩，月下松醪且满斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感秋二首 其二","author":"杨万里","text":"南国初凉日，东吴欲尽头。\n露荷幽馥晓，云日澹光秋。\n也爱西风爽，其如半老休。\n蝉声与蛩响，计会两催愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感秋二首 其一","author":"杨万里","text":"今岁五十二，岂为年少人。\n荷凉欣暑退，蝉苦怨秋新。\n澹虑翻成感，彫诗不著尘。\n小儿知得句，频掉小乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新安江水自绩溪发源","author":"杨万里","text":"金陵江水只咸腥，敢望新安江水清。\n皱底玻璃还解动，瑩然酃渌却消酲。\n泉从山骨无泥气，玉漱花汀作佩声。\n水记茶经都未识，谪仙句里万年名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新亭送客","author":"杨万里","text":"六朝岂是乏勋贤，为底京师不晏然。\n柏壁置人天一笑，楚囚对泣后千年。\n钟山唤客长南望，江水留人懒北还。\n强管兴亡谈不尽，枉教吟杀夕阳蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新除广东常平之节感恩书怀","author":"杨万里","text":"已愧双旌古晋陵，更堪一节古羊城。\n偶逢旧治年频熟，忽署新衔手尚生。\n山与君恩谁是重，身如秋叶不胜轻。\n向来百鍊今绕指，一寸丹心白日明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新凉感兴","author":"杨万里","text":"初退生衣进熟衣，新凉只与睡相宜。\n草争人迹微疏处，荷怯秋风欲动时。\n又是一年将过眼，如何两鬓不成丝。\n中元节后新来懒，草册才抄第二诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新栽德安牡丹透根生孙枝皆千叶种也即非接头二月二日瑞云红初开清晓起看喜而赋之","author":"杨万里","text":"日上浑迟在，花乘绝早看。\n精神百倍好，风露七分寒。\n夜宴醒犹醉，晨妆湿未乾。\n子孙更千亿，紫笋绕团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴","author":"杨万里","text":"瑶霜珠露两相鲜，玉宇金钲万里宽。\n欲作一晴多少日，早知祗费数朝寒。\n暴禾场里鸡豚乐，试笔窗前纸墨乾。\n儿女莫餐新淅饭，打头荷甔且输官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴东园晚步二首 其二","author":"杨万里","text":"忙里清流也带尘，闲中底物不长新。\n水将树影挥空帚，枫换秋容作好春。\n自是不归归便得，老来下笔笔如神。\n莺花煎煼无虚日，贱相诚斋一老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴东园晚步二首 其一","author":"杨万里","text":"一月秋阴一日晴，山禽相贺太丁宁。\n不愁白发千茎雪，随喜黄庭一卷经。\n晚雾薄情憎远岭，夕阳死命恋危亭。\n孤吟道是无人觉，松竹喧传菊细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴读樊川诗","author":"杨万里","text":"江妃瑟里芰荷风，净扫痴云展碧穹。\n嫩热便嗔疏小扇，斜阳酷爱弄飞虫。\n九千刻里春长雨，万点红边花又空。\n不是樊川珠玉句，日长淡杀个衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新暑追凉","author":"杨万里","text":"去岁冲炎横大江，今年度暑卧筠阳。\n满园无数好亭子，一夏不知何许凉。\n待等老夫亲勘当，更招幽鸟细商量。\n朝慵午倦谁相伴，猫枕桃笙苦竹床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香花新开五首 其五","author":"杨万里","text":"馨德潜丘壑，春风是往还。\n新从众香国，移种洞庭山。\n孤韵真无对，千花夐莫攀。\n骚经吾欲续，谱入芷蘅间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香花新开五首 其四","author":"杨万里","text":"雪里移苍斛，梢头点翠芒。\n只销三日暖，便坼数花房。\n紫袖染难透，琼肤晒转香。\n小留供鼻观，开去未须忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香花新开五首 其三","author":"杨万里","text":"短短熏笼小，团团锦帕围。\n浮阳烘酒思，沈水著人衣。\n抹利通家远，楠花具体微。\n春愁浑瘦尽，别有瘦中肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香花新开五首 其二","author":"杨万里","text":"老子观书倦，昏然睡思来。\n梦中谁唤醒，窗外瑞香开。\n只道花头细，能追国艳回。\n殷勤伴幽独，渠与一瓶梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香花新开五首 其一","author":"杨万里","text":"外著明霞绮，中裁淡玉纱。\n森森千万笋，旋旋两三花。\n小霁迎风喜，轻寒索幕遮。\n香中真上瑞，兰麝敢名家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡觉","author":"杨万里","text":"小醉如无酒，寒宵似度年。\n觉来因记梦，醒去不成眠。\n万事从心下，三更到眼前。\n清愁政无那，一雁叫霜天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起理发","author":"杨万里","text":"老态随年觉，新凉与睡谋。\n鹊惊茅屋晓，臂冷葛衣秋。\n远岭元无约，开门便见投。\n闲中多事在，一日一梳头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲萄架","author":"杨万里","text":"才喜盘藤捲叶生，又惊压架暗阴成。\n夏褰凉润青油幕，秋摘甘寒黑水精。\n近竹犹争一尺许，抛须先罥两三茎。\n今年乞种西江去，长是茅斋怯晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞丞相挽词三首 其三","author":"杨万里","text":"一老堂堂日，诸贤得得来。\n但令元气壮，患不塞尘开。\n名大天难著，人亡首忍回。\n东风好西去，吹泪到泉台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞丞相挽词三首 其二","author":"杨万里","text":"保奭方为左，希文自请西。\n不劳三尺剑，已办一丸泥。\n已矣归黄壤，伤哉梦白鸡。\n清风谁作诵，何石不天齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞丞相挽词三首 其一","author":"杨万里","text":"负荷偏宜重，经纶别有源。\n雪山真将相，赤壁再乾坤。\n奄忽人千古，凄凉月一痕。\n世无生仲达，好手未须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜀士甘彦和寓张魏公门馆用予见张钦夫诗韵作二诗见赠和以谢之 其一","author":"杨万里","text":"说著岷江士，未逢眉已申。\n殷勤来相府，解逅得诗人。\n不是胸中别，何缘句子新。\n谈今还悼昔，喜罢反悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜀士甘彦和寓张魏公门馆用予见张钦夫诗韵作二诗见赠和以谢之 其二","author":"杨万里","text":"夜把新诗读，灯前阖且开。\n一行私独喜，两脚不虚来。\n天似嫌梅晚，冬初遣雪催。\n与君问花信，能绕百千回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解舟惠州东桥","author":"杨万里","text":"南宦宁差北，西归敢再东。\n猿声云树月，客枕露船风。\n绿发春全白，苍颜酒不红。\n莫憎愁与病，留取伴衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]