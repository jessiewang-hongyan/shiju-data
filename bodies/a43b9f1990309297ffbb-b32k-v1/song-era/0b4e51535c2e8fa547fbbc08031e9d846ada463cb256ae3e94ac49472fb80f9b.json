[{"title":"偈五首 其五","author":"释道行","text":"黄梅雨，麦秋寒。\n恁么会，太无端。\n时节因缘佛性义，大都须是髑髅乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其四","author":"释道行","text":"句亦刬，意亦刬，绝毫绝釐处，如山如岳。\n句亦到，意亦到，如山如岳处，绝毫绝釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其三","author":"释道行","text":"通身是口，说得一半。\n通身是眼，用得一橛。\n用不到处说有馀，说不到处用无尽。\n所以道，当用无说，当说无用。\n用说同时，用说不同时。\n诸人若也拟议，西峰在你脚底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其二","author":"释道行","text":"云笼岳顶，百鸟无声。\n月隐寒潭，龙珠自耀。\n直得石梁忽然大悟，石洞顿尔心休。\n虚空开口作證，溪北石僧点头。\n诸人总在这里瞌睡，笑杀陕府铁牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其一","author":"释道行","text":"会即便会，玉本无暇。\n若言不会，碓觜生花。\n试问九年面壁，何如大会拈华。\n南明恁么商确，也是顺风潵沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞佛眼和尚","author":"释道行","text":"因我得礼你，玄沙出窼臼，龙门与荐灯后。\n咄！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十四","author":"释道行","text":"如何是佛，口是祸门。\n一钱不直，卖与买人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其十","author":"释道行","text":"依经解义，三世佛冤。\n离经一字，即同魔说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其九","author":"释道行","text":"问问不差，答答不错。\n问答去来，龟毛兔角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其二","author":"释道行","text":"车不横推，理无曲断。\n若是此花，佛与帝释。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈","author":"释道行","text":"识则识自本心，见则见自本性。\n识得本心本性，正是宗门大病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞众偈","author":"释道初","text":"昨日离城市，白云空往还。\n松风清耳目，端的胜人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释道初","text":"鸡见便斗，犬见便咬。\n殿上鸱吻，终日相对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十六","author":"释道昌","text":"乱走到家来，到家便乱走。\n捉得玉麒麟，咬断别人手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十六","author":"释道昌","text":"舌头不出口，三三成九九。\n算到香台还，彼此落人后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十四","author":"释道昌","text":"腰金上太行，贼眼尽惊慞。\n不因遭毒手，谁肯夜烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十三","author":"释道昌","text":"把火入牛栏，反身外面看。\n梨花千点白，春雨几声寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其十","author":"释道昌","text":"赤士才将画簸箕，乌鸡何事忽惊飞。\n自从题入新诗后，黄鹤楼前忘却归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四","author":"释道昌","text":"手携花鼓到城根，反著麻鞋过短门。\n笑把柴头书古字，大家来步月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释道昌","text":"千佛居何处，题诗黄鹤楼。\n感恩并积恨，终日在眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释道昌","text":"惯使渡头船，如今不记年。\n爱他风浪恶，方是趁粗钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞","author":"释道昌","text":"丹青写出，剩却一个。\n窦入布衫，著著便破。\n土面灰头那畔行，水墨观音解推磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧","author":"释道昌","text":"扫尽诸方路布禅，到头窼臼落雁边。\n台盘角畔重拈起，万里神光顶后全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其十四","author":"释道昌","text":"大悲许多手眼，如人夜摸枕子。\n遍身通身起来，尽受奴驱婢使。\n君不见认著牛迹里，失却大海水。\n转变未得时，依前有依倚。\n归去来，归去来，拍天洪浪如浮埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十五","author":"释道昌","text":"撞墙撞壁，曲不藏直。\n摘叶拈花，与俭宁奢。\n罗汉有三毒，如来有二语。\n聋人争得闻，依旧吃茶去。\n保福老，保福老，铁眼铜睛还失了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十","author":"释道昌","text":"无位真人，处处献新。\n拦胸扭住，不落主宾。\n乾屎橛，乾屎橛，三人證龟作个鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十一","author":"释道昌","text":"云居道何必，兴化道不必。\n眼若不开，梦中叫屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十七","author":"释道昌","text":"绝消息处捉来，有形影中走却。\n只因懒问儿孙，要把襕衫反著。\n坐久成劳，位次已高。\n起时失却人天相，无限行人认白毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十四","author":"释道昌","text":"恰似初生月，两口无一舌。\n到了曲弯弯，把火入牛栏。\n问他以手便斫额，猴黑谁知有猴白。\n向后失目果然是，要见长人过深水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十三","author":"释道昌","text":"将成之山，不进一篑。\n老倒云门，坐而获利。\n钓鳌钓鲸手段高，惯曾下海涉波涛。\n缓放急收自得便，浮家泛宅何飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十二","author":"释道昌","text":"被里出指，水中露觜。\n屈指眼开，摇觜身起。\n药病不相治，何须尽大地。\n反笑老云门，失却娘生鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十一","author":"释道昌","text":"尽却命根，方可关门。\n一挨一拶，电涌雷奔。\n佛法水中月，耳里眼里说。\n差之毫釐，失之千里，南北东西知几几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十","author":"释道昌","text":"尘尘三昧，钵饭桶水。\n云门眼中，者僧身里。\n捏合起来无处藏，?著磕著埋没你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十九","author":"释道昌","text":"扑落非他，安排不多。\n盖覆自在，隐显包罗。\n抬头失却旧时路，拈篙便上别人渡。\n转易作难，拔贫成富，千人万人恁么去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十八","author":"释道昌","text":"针头削铁，牛背拔毛。\n多将少使，冷作热烧。\n直上法堂便下去，触忤和尚重解注。\n知是般事休便休，茫茫塞壑与填沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十七","author":"释道昌","text":"明头便打，暗里闪过。\n尽底活时，死中要坐。\n门外檐间雨滴声，众生颠倒逐迷情。\n可怜洎不迷己处，出得身来体未明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十六","author":"释道昌","text":"人前惯出手，退三添作九。\n有眼未尝看，无家自能走。\n雪峰之句，羚羊挂角。\n作他弟子没来由，龙蛇阵上看谋略。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十三","author":"释道昌","text":"趁水泛船，随泥作佛。\n船行佛成，水泥不物。\n有拄杖兮与拄杖，船中轻荡桨。\n无拄杖兮夺拄杖，佛面巧出相。\n好手芭蕉眼不开，塞壑填沟何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十二","author":"释道昌","text":"千里万里，不著便处却能回，闭了方丈依前来。\n双收双放，半合半开。\n主宾全体用，石女老黄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其四十","author":"释道昌","text":"迅雷不及掩耳，下桩要在急水。\n水深桩脚若长，耳畔雷声四起。\n拈起拄杖为他中下，上上人来放过不打。\n秦人一入桃花源，子孙千世为神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十九","author":"释道昌","text":"俊鹘冲天，寒鸡晓眠。\n脱略窼窟，迟速不偏。\n截断命根急处放，当头手脚缓时样。\n滴水冰生不认渠，坐筹帏幄江海量。\n君不见透网金鳞活计新，住持事繁笑杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十八","author":"释道昌","text":"巨岳尘飞，蟭螟生儿。\n儿落尘里，如锥锥泥。\n烧火救火，闭门开门。\n抛柴家丑外头见，万象森罗一口吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十七","author":"释道昌","text":"当言不避截舌，当炉不避猛火。\n趁手作得家生，到老自能稳坐。\n水深杓柄长，舀水洗头剃。\n雪峰刀上眼忽开，琉璃殿里无关闭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十五","author":"释道昌","text":"宽鞋著瘦脚，短袖入长臂。\n竿木既随身，逢场还作戏。\n前三三后三三，一时堆在担头担。\n到得家中重点检，目前包裹露毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十三","author":"释道昌","text":"高高山顶立，深深海底行。\n新松趁岭种，芳草绕池生。\n手不攀枝，脚不踏树。\n口里衔得，当头蹉路。\n问著西来对不对，罚钱依旧有人悔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十二","author":"释道昌","text":"法身说法，肉眼看物。\n在智如愚，大辩如讷。\n拈起生簸箕别处舂，推出枕子露眠床，剑刃上事放毫光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十一","author":"释道昌","text":"有本无本，学益学损。\n搬运不时，提起却稳。\n师子一滴迸六斛，驴乳散入别人屋。\n业识茫茫辨出时，乌鸡不在芦花宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三十","author":"释道昌","text":"佛声从他，认我碗鸣。\n粗言归第一义，自要看渠?沸。\n唤作一头驴，正令生光辉。\n趁手打得走无路，咭嘹舌头何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十九","author":"释道昌","text":"说明道白，埋尘混垢。\n变化有由，败露不走。\n谁知暗里骨横抽，要在轰轰霹雳手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十八","author":"释道昌","text":"逆放顺收，将寡敌众。\n隐显同途，得失共用。\n针针相似不外来。\n同行语话要分开。\n自从大地火发后，古庙香炉不著灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十七","author":"释道昌","text":"水到渠成，风行草偃。\n类之不齐，睹之难面。\n谁信崖颓石裂时，黄金白银如粪泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十六","author":"释道昌","text":"南阳师，肌骨好。\n洞山价，也难讨。\n沩山翁，云岩老。\n重注破，成鼓倒。\n分明行官路，不觉入荒草。\n葛藤因此到而今，业识茫茫何日了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十五","author":"释道昌","text":"仰面穿针不见天，低头拾芥不见地。\n天地针芥无处安，堂堂面目眼中翳。\n君不见谛当未彻在，龊人趁大彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十四","author":"释道昌","text":"来机深辨，有舒有卷。\n移却案山，重添针线。\n千年田，八百主，直下承当还莽卤。\n郎当屋舍没人修，片瓦根椽谁去竖。\n君不见甜瓜彻蒂甜，苦瓠连根苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十二","author":"释道昌","text":"高揖释迦，不拜弥勒，吃棒趁出犹费力，滴水冰生知未知，抛砖引玉有人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其二十一","author":"释道昌","text":"出头露角，指点方见。\n见处不留，分定针线。\n下床扭住才拟议，拓开一掌佛法意。\n脊背汗流唤得回，白莲花向半天开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其十七","author":"释道昌","text":"赵州石桥，只见略彴。\n度驴度马，应病与药。\n换步移身，在富全贫。\n当头如认著，东鲁问西秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其十六","author":"释道昌","text":"天雷如鼓，云腾致雨。\n雨霁云收，新月一钩。\n至道无难，惟嫌拣择。\n五年分疏太隔脉，东海鲤鱼多赤梢，南山大虫有白额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其十五","author":"释道昌","text":"至道无难，万水千山。\n唯嫌拣择，鹄黑乌白。\n才有是非还护惜，不会不知全得力。\n明白里头如放行，腰金犹颂青青麦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其十三","author":"释道昌","text":"据款结案，得失过半。\n尽力担当，上船离岸。\n无不指示汝，擎茶行食处。\n圣解凡情不过来。\n轩轩头角起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其十二","author":"释道昌","text":"马前相扑，入交失脚。\n不来外求，当面修削。\n六合彼中身，分明举似人。\n到处世界总成就，脱略窼臼还渗漏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其七","author":"释道昌","text":"得因失有，是在非边。\n根源未断，枝派相连。\n不言言，口何在，转得身来难下载。\n一帆风过洞庭湖，对面须知已违背。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其六","author":"释道昌","text":"是两头语，未出泥水。\n非两头语，依前自死。\n振锡卓然，白日青天。\n风力还他败坏时，漫天大网生光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五","author":"释道昌","text":"活中死眼，无作有用。\n方寸不移，十方独弄。\n巧拙不到处，盐官有出身。\n亲言出亲口，鸡犬闹比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其三","author":"释道昌","text":"水乳不分，菽麦难辨。\n担带病深，改移功浅。\n十二时中不依倚，明见佛性有此理，浆水钱在草鞋里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其一","author":"释道昌","text":"奴儿婢子，十生九死。\n于里不正，被外边使。\n纵饶开口便过头，未免浑身辊泥水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其四","author":"释道昌","text":"惯行私路，乍赴公筵。\n幞头脚短，腰带夸圆。\n不是伴郎来劝酒，误他年少觅青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其三","author":"释道昌","text":"光非照境境非存，光境俱忘复是痕。\n百鸟不来春已老，落华流水绕江村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释道昌","text":"未透祖师关，千难与万难。\n既透祖师关，千难与万难。\n未透时难即且置，既透了因甚么却难。\n放下笊篱虽得价，动他杓柄大无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释道昌","text":"与我相似，共尔无缘。\n打翻药铫，倾出炉烟。\n还丹一粒分明在，流落人间是几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释道昌","text":"道不属知，不属不知。\n知是妄觉，不知是无记。\n若真达不疑之道，碍他铜盘不打老鼠。\n所以抽身入，还从屋里来。\n报教台凳稳，聊且劝三杯。\n兄呼弟唤殷勤处，留得儿孙辨劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十七首 其五十五","author":"释道昌","text":"针头削铁，佛面刮金。\n无处若有，出手便惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]