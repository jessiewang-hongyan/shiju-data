[{"title":"白云端和尚赞","author":"释智愚","text":"接纳少机关，勘验无眼目。\n时时膈气筑，只要煨芦菔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞","author":"释智愚","text":"不开骂人口，难以见其慈。\n不徵衲子病，难以表其师。\n似之则殃门添祸，否之则凤林吒之。\n画工笔熟不识伊，白发毵毵个是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石窗和尚赞","author":"释智愚","text":"秋鹭翘松，寒蟾卧水。\n芝峰老骨虽不在明白里，离娄师旷觅无踪，千古万古祇者是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼石霜千僧冢塔","author":"释智愚","text":"万指恬然一路归，髑髅对对眼如眉。\n须知一色明边外，生死如何搆得伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼石霜慈明大师塔","author":"释智愚","text":"水绕山围狮子窟，赫赫金毛从此出。\n野犴既死狐兔悲，天下丛林闹聒聒。\n我来不敢重步行，森严匝匝清风生。\n三拜无言出门去，烟笛一声牛背横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼宝峰马大师塔","author":"释智愚","text":"舌贯鼻端，牛行虎视。\n祇者形模，转增聋戾。\n万丈寒潭兮泐水无波，千仞宝山兮浮图锁翠，八十四人兮犹居学地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼明教大师塔","author":"释智愚","text":"道树将摧皇祐间，力扶危处几多难。\n因思今日安然者，忍数空庭竹几竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西归赞","author":"释智愚","text":"壁观九年，葫芦按水。\n无计脱身，强分皮髓。\n只履恓恓何处归，月明后夜思熊耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音大士赞","author":"释智愚","text":"宝瓶翠柳常随手，又向青莲叶上行。\n五浊世中无垢染，不须慈眼视众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙源首座请赞","author":"释智愚","text":"道不可传，貌不可绘。\n冷坐深云，虎视百怪。\n源远流长灭正宗，不比瞎驴趁大队。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应庵和尚赞","author":"释智愚","text":"奋劈胸拳，捞摸虚空骨髓。\n开活入眼，瞎却自己顶门。\n从兹海涌峰危，是谓东山正续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵山古云粹法师赞","author":"释智愚","text":"三观互融显其机，十门不二荡其迹。\n如月印水兮光入其微，如春在花兮香袭其裓。\n是谓教庠之英，北峰之嫡。\n描邈将来不如伊，从教大地无人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵隐石鼓夷和尚赞","author":"释智愚","text":"面目严冷，狠气如云。\n撺掇翁木大，颠倒上树。\n品藻果骂天，见地不亲。\n咬牙啮齿，走石飞尘，鹫峰别有劫壶春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药山和尚赞","author":"释智愚","text":"以梵夹，对净瓶。\n一字不挂眼，常转如是经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运庵先师赞","author":"释智愚","text":"行脚祇参松源，早是信卜卖屋。\n更说东山正传，大似老马嚼粟。\n近人情，无面目，引得儿孙阿辘辘。\n报恩尽力赞扬，也是鹭股割肉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝严崇辩讷法师画像赞","author":"释智愚","text":"身槁如柴，眼明如电。\n衡鉴台岭，品藻山外之宗。\n挥呵悟门，不堕文字之相。\n以讷为辩，以戒为碍。\n横拈麈尾雨花倾，万象森罗俱鼎沸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝林远和尚游山像师孙侍行赞","author":"释智愚","text":"德腊俱高，孙枝益茂。\n以勤俭苦节中兴隶业，以老气馀韵平视诸方。\n眉棱垂雪，杖竹凝霜。\n步趋有人兮清风可继，澹常古道兮劫外徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法云首座请赞","author":"释智愚","text":"咿呜咿，那得知。\n寒酸看不上眼，手面移东换西。\n拱良工手，破衲僧疑。\n行到水穷处，坐看云起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘隆和尚赞","author":"释智愚","text":"柔弱丰神，骨器刚大。\n小喜多嗔，贵买贱卖。\n形影师资二十年，所以圆悟目之为睡虎者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贫女咒水过海赞","author":"释智愚","text":"柳枝活，盂水灵。\n一咒毒发，百川俱鸣。\n善财隔海觅不得，无数远山堆乱青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金书大士心经为圆相大悲咒身衣赞","author":"释智愚","text":"以波罗蜜多圆其相，以喝啰怛那蒙其身。\n咒呾从此发，还著于本人。\n不解圆通二十五，吉祥灵草暗藏春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亮座主赞","author":"释智愚","text":"虚空讲得，参天荆棘。\n一唤回头，杳无踪迹。\n夕阳挂树梢，依然隐不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"保宁勇和尚赞","author":"释智愚","text":"性燥衲僧，佒佯座主。\n抹过村草步头，直下挨肩佛祖。\n杨岐其师，白云其侣。\n一鸣凤台，凌跨今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明不庵悟和尚赞","author":"释智愚","text":"飞来峰下，打失护身符子。\n南明山中，骂詈三平祖师。\n阐提薄福，俗眼难窥。\n夫是之谓不庵老古锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拾得指空笑赞","author":"释智愚","text":"木屐竹帚，粘脚缀手。\n古佛家风，泥猪疥狗。\n指天大笑一声，惊得虚空倒走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拾得磨墨过笔赞","author":"释智愚","text":"头戴桦皮冠，脚穿破木履。\n有磨墨过笔之功，无二千酬泻瓶之水。\n捉败了也，国清寺里偷佛饭，元来是你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"政黄牛赞","author":"释智愚","text":"犊角铜瓶挂晓烟，溪山多是往来篇。\n不知底事吟情险，吹落秋风白鸟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"政黄牛赞","author":"释智愚","text":"朝看白云去，暮骑黄犊归。\n山穷桥断处，鹭鸶那得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉大道浴湫图赞","author":"释智愚","text":"拚身跃入深渊，等闲握起龙首。\n腥风怒雷，乌飞兔走，惊得慈明几掣肘。\n乞儿伎俩不多，千古脍炙人口，好将白棒劈脊搂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觉范和尚塔在同安","author":"释智愚","text":"说文字禅笼络虚空，骂古塔主不明要旨。\n褒贬抑扬，流行坎止。\n栖凤岩高插杳冥，落花啼鸟谁相委。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"面壁赞","author":"释智愚","text":"嵌枯石老，黡瘦衣荒。\n死水垂钓，陆地乘航。\n当初好采见梁王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"须菩提赞","author":"释智愚","text":"持贝叶，倚瘦藜。\n解空未尽，说是说非。\n无端引惹憍尸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆悟勤禅师赞","author":"释智愚","text":"尸碧岩，谤乳窦，击高庵，据瓯阜，此皆人所议论不到。\n说甚么减灶法无文印，尽情约下置而勿论。\n或曰毁誉不在乎两端之间，䖃苴翁别有长处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栽松道者赞","author":"释智愚","text":"郁郁冰壑姿，株株手亲植。\n欲知来去踪，双峰耸寒碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十四","author":"释智愚","text":"一日日，一时时。\n逗到腊八夜，眼上错安眉。\n东西不辨，南北狐疑，从教万古业风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其七","author":"释智愚","text":"槿花凝露，梧叶鸣秋。\n遇景触物，随分知羞。\n住住，诸方闻得道，我说老婆禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十","author":"释智愚","text":"好一局棋，黑白已分。\n只是末后一著，无人知得落处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十五","author":"释智愚","text":"圣人无己，靡所不己。\n总尘刹无不是，差之毫釐失千里。\n仙仗飘飖去不还，从教六合清风起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十一","author":"释智愚","text":"古佛过去亦久矣，不知何处应群生。\n紫金光聚人难睹，空里惟闻仙乐鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十","author":"释智愚","text":"杜宇不如归，竹鸡泥滑滑。\n深山岩崖中，谁道无佛法。\n有佛法，衲僧只有三只袜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十一","author":"释智愚","text":"山僧恰似抱璞者，但欠临风涕泣。\n不道举世无人，只是可惜许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十六","author":"释智愚","text":"金以石试，人以言试。\n古人自谓全璧而归，不知身在草里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十七","author":"释智愚","text":"一跳一踯，师子嚬呻。\n一新一旧，和气如春。\n报恩尺不如寸，赢得痴坐，家里有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十八","author":"释智愚","text":"蝇见血，鹘捉鸠。\n拳来踢报，胶漆相投。\n难提掇处转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其四","author":"释智愚","text":"金风吹落叶，玉露滴清秋。\n叵耐寒山子，无言笑点头。\n既能明似镜，何用曲如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其八","author":"释智愚","text":"一年有十二个月，每月一度团圆，其馀尽是缺。\n中间晦明出没，太半有不见者。\n惟有今宵，分外皎洁。\n无物堪比伦，教我如何说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十四","author":"释智愚","text":"古佛只在椎头，每日呼来唤去。\n非惟网令清岩，下下要分缁素。\n兴化当年错用心，月明岂在珊瑚树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其三","author":"释智愚","text":"人间灯，天上月。\n有明有暗，有圆有缺，底事贪观心未歇。\n兴圣室内无油，免得證龟作鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其一","author":"释智愚","text":"迦叶当时性燥，下得一椎。\n莫道文殊三处度夏，直饶黄面老子别有神通，也须脑门著地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十二","author":"释智愚","text":"溪林叶堕，塞雁声寒。\n见成公案，大难大难。\n百杂碎，铁团圞，和风搭在玉阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二","author":"释智愚","text":"秋风淅淅，秋水冷冷。\n千辛万苦，负笈担簦。\n张公堠子李家店，草舍茅庵短作程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其六","author":"释智愚","text":"无义汉，谁识你。\n口吃耳聋，驴拗到底。\n一气转一藏，是非终难洗。\n大法下衰，污人唇齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十三","author":"释智愚","text":"南岳七十二峰，华顶万八千丈。\n瞻之无际，仰之无垠。\n以此无穷数，用祝圣明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其二十四","author":"释智愚","text":"勤俭起家，丛林麟凤。\n入门一见，和气可掬，知心不在频叮嘱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其二十三","author":"释智愚","text":"出山而见，入户而知。\n鸡栖凤巢，邻壁之辉，何必区区点缀伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其二十二","author":"释智愚","text":"日出而作，日入而息。\n熙熙然如登春台，且道承谁恩力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其二十一","author":"释智愚","text":"有意退栏，无心耕牧。\n九重降敕，如万国春回。\n一道恩光，似千日并照。\n法门腾焕，岩壑生秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其二十","author":"释智愚","text":"虎头燕颔，鸟嘴鱼腮。\n尽向者里纳款，且道者里是甚么所在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十九","author":"释智愚","text":"释迦掩室于摩竭，因甚坐在者里。\n炷拜勤渠，齐之以礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十八","author":"释智愚","text":"此山无路，及门者谁。\n会得摆手同归，不然随我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十六","author":"释智愚","text":"春入湖山，先放花明。\n御苑人归上国，南山鹤唳青松。\n壮皇都人杰地灵，窥紫府洞天风月。\n透声透色，绝类离伦。\n不妨垂手入廛，毕竟难逃至化。\n且望阙酬恩，如何祝赞。\n版图远奏尧天阔，万物呈祥乐圣情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十五","author":"释智愚","text":"烟惨淡，石玲珑。\n面面厮觑，千峰万峰，一团和气在其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十四","author":"释智愚","text":"世尊三昧，金口玉音，亲付嘱紫泥芝检。\n九重城里凤衔来，再沾雨露之恩，光阐法门之盛。\n声前妙證，耸动群心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十三","author":"释智愚","text":"外阖不闭，跨天下而无蕲。\n会得许你，升其堂入其室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十二","author":"释智愚","text":"一年又一年，循环数不足。\n本分面上人，犹如隔罗縠。\n惟有南极老人，扣天鼓三下，望北关而祝，愿我王万福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其十","author":"释智愚","text":"时迁物换，革故鼎新。\n土膏未动，商量打春。\n太公有意垂钓，夫子无心获麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其九","author":"释智愚","text":"旧去新来懒送迎，岩间冢下见枯形。\n忍成残腊半宵梦，坐对寒檠两岁灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其八","author":"释智愚","text":"镜容鹰爪，面目可憎。\n掉发南岳，下山教化。\n从臾梼林，对御讲经。\n不守疆界，干犯清平。\n灭得中峰正法眼，破沙盆子话方行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其七","author":"释智愚","text":"朕闻上古，其风朴略。\n王言如丝，谁敢不听。\n忽有人问鄮山，只向他道，风门海口，当风抵浪，也须是个人始得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其六","author":"释智愚","text":"一人要贫贫不得，一人要富富不得。\n要知贫富不相当，且请各归本位立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其五","author":"释智愚","text":"人间无，天上有，往往无人脱窠臼。\n四海娟娟洗玉魂，九野茫茫白兔走。\n寒山子，不关口，也落马驹群队后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其四","author":"释智愚","text":"虎憎鸡嘴，闻者畏之。\n后人衡鉴不高，唤作二俱弄险。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其三","author":"释智愚","text":"鸡足峰前，黄梅渡口，逗到冷泉几掣肘。\n若谓凌霄非正传，毕竟衣法属谁手。\n野犴鸣，狮子吼，虚空昨夜翻筋斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十四首 其二","author":"释智愚","text":"同门出入，未尝谩你。\n诸人苟或粉饰太过，山僧只得掩耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]