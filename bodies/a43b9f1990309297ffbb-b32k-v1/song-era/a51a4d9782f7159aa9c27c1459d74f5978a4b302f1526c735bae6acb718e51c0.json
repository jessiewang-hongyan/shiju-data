[{"title":"山中","author":"王安石","text":"随月出山去，寻云相伴归。\n春晨花上露，芳气著人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山陂","author":"王安石","text":"山陂院落今挼种，城郭楼台已放灯。\n白发逢春唯有睡，睡间啼鸟亦生憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山鸡","author":"王安石","text":"山鸡照渌水，自爱一何愚。\n文采为世用，适足累形躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山前","author":"王安石","text":"山前溪水涨潺潺，山后云埋不见山。\n不趁雨来耕水际，即穿云去卧山间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山樱","author":"王安石","text":"山樱抱石荫松枝，比并馀花发最迟。\n赖有春风嫌寂寞，吹香渡水报人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马毙","author":"王安石","text":"恩宽一老寄松筠，晏卧东窗度几春。\n天厩赐驹龙化去，谩容小蹇载闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中书即事","author":"王安石","text":"投老翻为世网婴，低徊终恐负平生。\n何时白土冈头路，渡水穿云取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中年","author":"王安石","text":"中年许国邯郸梦，晚岁还家圹埌游。\n南望青山知不远，五湖春草入扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中牟","author":"王安石","text":"颓城百雉拥高秋，驱马临风想圣丘。\n此道门人多未悟，尔来千载判悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中茅峰石上徐锴篆字题名","author":"王安石","text":"百年风雨草苔昏，尚有当年墨法存。\n祇恐终随峄碑尽，西风吹烧满秋原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋夕寄平甫诸弟","author":"王安石","text":"浮云吹尽数秋毫，爚爚金波满满醪。\n千里得君诗挑战，夜坛谁敢将风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌石","author":"王安石","text":"乌石冈边缭绕山，柴荆细路水云间。\n吹花嚼蕊长来往，祗有春风似我闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌江亭","author":"王安石","text":"百战疲劳壮士哀，中原一败势难回。\n江东子弟今虽在，肯与君王卷土来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌塘","author":"王安石","text":"乌塘渺渺绿平堤，堤上行人各有携。\n试问春风何处好，辛夷如雪柘冈西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书汜水关寺壁","author":"王安石","text":"汜水鸿沟楚汉间，跳兵走马百重山。\n如何咫尺商于地，便有园公绮季闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书何氏宅壁","author":"王安石","text":"有兴提鱼就公煮，此言虽在已三年。\n皖灊终负幽人约，空对湖山坐惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书陈祈兄弟屋壁","author":"王安石","text":"千里归来倦宦身，欲寻田宅豫求邻。\n能将孝友传家世，乡邑如君更几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书定林院窗","author":"王安石","text":"竹鸡呼我出华胥，起灭篝灯拥燎炉。\n试问道人何所梦，但言浑忘不言无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书堂","author":"王安石","text":"乌石冈头上冢归，柘冈西畔下书帷。\n辛夷花发白如雪，万国春风庆历时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书湖阴先生壁二首 其一","author":"王安石","text":"茆檐长扫静无苔，花木成畦手自栽。\n一水护田将绿绕，两山排闼送青来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书湖阴先生壁二首 其二","author":"王安石","text":"桑条索漠楝花繁，风敛馀香暗度垣。\n黄鸟数声残午梦，尚疑身属半山园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书静照禅师塔","author":"王安石","text":"简老已归黄土陌，渊师今作白头翁。\n百忧三十馀年事，陈迹山林草野中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更","author":"王安石","text":"青灯隔幔映悠悠，小雨含烟凝不流。\n祇听蛩声已无梦，五更桐叶强知秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五柳","author":"王安石","text":"五柳柴桑宅，三杨白下亭。\n往来无一事，长得见青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元丰二年十月政公改路故作此诗","author":"王安石","text":"独龙东路得平冈，始免游人屐齿妨。\n更有主林身半现，与公随转作阴凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"王安石","text":"爆竹声中一岁除，东风送暖入屠苏。\n千门万户曈曈日，争插新桃换旧符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六年","author":"王安石","text":"六年湖海老侵寻，千里归来一寸心。\n西望国门搔短发，九天宫阙五云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午枕","author":"王安石","text":"午枕花前簟欲流，日催红影上帘钩。\n窥人鸟唤悠飏梦，隔水山供宛转愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午睡","author":"王安石","text":"檐日阴阴转，床风细细吹。\n翛然残午梦，何许一黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子偶题","author":"王安石","text":"黄尘投老倦匆匆，故绕盆池种水红。\n落日攲眠何所忆，江湖秋梦橹声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬戌五月与和叔同游齐安 其一","author":"王安石","text":"缲成白雪桑重绿，割尽黄云稻正青。\n它日玉堂挥翰手，芳时同此赋林坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬戌正月晦与仲元自淮上复至齐安","author":"王安石","text":"风暖柴荆处处开，雪乾沙净水洄洄。\n意行却得前年路，看尽梅花看竹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天童山溪上","author":"王安石","text":"溪水清涟树老苍，行穿溪树踏春阳。\n溪深树密无人处，唯有幽花渡水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆金陵三首 其三","author":"王安石","text":"追思陈迹故难忘，翠木苍藤水一方。\n闻说精庐今更好，好随残汴理归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆金陵三首 其二","author":"王安石","text":"烟云渺渺水茫茫，缭绕芜城一带长。\n蒿目黄尘忧世事，追思陈迹故难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆金陵三首 其一","author":"王安石","text":"覆舟山下龙光寺，玄武湖畔五龙堂。\n想见旧时游历处，烟云渺渺水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文成","author":"王安石","text":"文成五利老纷纷，方丈蓬莱但可闻。\n万里出师求宝马，飘然空有意凌云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无锡寄孙正之","author":"王安石","text":"健席高樯送病身，乱山荒陇障归津。\n应须一曲千回首，西去论心更几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日西","author":"王安石","text":"日西阶影转梧桐，帘卷青山簟半空。\n金鸭火销沈水冷，悠悠残梦鸟声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木末","author":"王安石","text":"木末北山烟冉冉，草根南涧水泠泠。\n缲成白雪桑重绿，割尽黄云稻正青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木芙蓉","author":"王安石","text":"水边无数木芙蓉，露染燕脂色未浓。\n正似美人初醉著，强抬青镜欲妆慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王章","author":"王安石","text":"壮士轩昂非自谋，近臣当为国深忧。\n区区女子无高意，追念牛衣暖即休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长干释普济坐化","author":"王安石","text":"投老唯公最故人，相寻长恨隔城闉。\n百年俯仰随薪尽，画手空传净戒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"世上","author":"王安石","text":"范蠡五湖收远迹，管宁沧海寄馀生。\n可怜世上风波恶，最有仁贤不敢行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"世故","author":"王安石","text":"世故纷纷漫白头，欲寻归路更迟留。\n钟山北绕无穷水，散发何时一钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东冈","author":"王安石","text":"东冈岁晚一登临，共望长河映远林。\n万窍怒呺风丧我，千波竞涌水无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东江","author":"王安石","text":"东江木落水分洪，伐尽黄芦洲渚空。\n南涧夕阳烟自起，西山漠漠有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东陂二首 其二","author":"王安石","text":"荷叶初开笋渐抽，东陂南荡正堪游。\n无端垄上翛翛麦，横起寒风占作秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东陂二首 其一","author":"王安石","text":"东陂风雨卧黄云，塍水翻沟隔垄分。\n舂玉取新知不晚，腰镰今日已纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东流顿令罢官阻风示文有按风伯奏天阍之语答以四句","author":"王安石","text":"令尹犀舟失去期，怃然凭几占文移。\n劝君慎莫谗风伯，会有开帆破浪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东皋","author":"王安石","text":"东皋揽结知新岁，西崦攀翻忆去年。\n肘上柳生浑不管，眼前花发即欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代白发答","author":"王安石","text":"从衰得白自天机，未怪长青与愿违。\n看取春条随日长，会须秋叶向人稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代陈景元书于太一宫道院壁","author":"王安石","text":"官身有吏责，触事遇嫌猜。\n野性岂堪此，庐山归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代答","author":"王安石","text":"破车伤马亦天成，所托虽高岂自营。\n四海不无容足地，行人何事此中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出定力院作","author":"王安石","text":"江上悠悠不见人，十年尘垢梦中身。\n慇勤为解丁香结，放出枝间自在春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊","author":"王安石","text":"川原一片绿交加，深树冥冥不见花。\n风日有情无处著，初回光景到桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出金陵","author":"王安石","text":"白石冈头草木深，春风相与散衣襟。\n浮云映郭