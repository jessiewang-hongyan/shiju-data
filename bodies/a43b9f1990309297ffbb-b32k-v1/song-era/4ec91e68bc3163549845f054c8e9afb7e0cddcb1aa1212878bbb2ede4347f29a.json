[{"title":"陈府君挽歌辞","author":"沈遘","text":"吴会多长者，斯人昔所钦。\n高材谁复见，令闻独留今。\n松柏开原势，笳箫送水阴。\n安知此吉卜，有子服朝簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴正肃公挽歌辞三首 其一","author":"沈遘","text":"天下贤良选，当时第一才。\n文章秘群玉，事业照三台。\n暂作东山去，还期宣室来。\n苍生方愿治，梁木何先摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴正肃公挽歌辞三首 其二","author":"沈遘","text":"四海瞻师宰，中朝倚典刑。\n胡然赋全器，独弗与多龄。\n柱石亏宫庙，盐梅辍鼎铏。\n风流不可挹，无愧史臣名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴正肃公挽歌辞三首 其三","author":"沈遘","text":"笳鼓周南地，公尝此保釐。\n都人怀旧德，行路起新悲。\n昔我祈难老，今天莫慭遗。\n呼嗟如可赎，犹愿百身为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏元献公挽歌辞二首 其一","author":"沈遘","text":"英才动先圣，盛业启今王。\n朝庭尊元老，官师仰典常。\n才还宣室对，遽叹哲人亡。\n独有勋名在，书为后世光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏元献公挽歌辞二首 其二","author":"沈遘","text":"四海尚多事，君心属太平。\n天胡不遗慭，邦早夺耆英。\n柱石倾宫构，盐梅废鼎烹。\n斯人无复见，谁意在苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天录研匜歌","author":"沈遘","text":"张君赠我古研滴，四脚爬沙角如戟。\n肉翼络髀老兽姿，世不能名眼未识。\n我知此为天禄儿，口衔一寸黄金匜。\n蟾蜍嚼月两吻坼，天鲸胸穴双泉飞。\n玉声琮琤珠迸落，影射岩石光瀺灂。\n未央书殿立髬髵，曾见扬雄老投阁。\n子孙晚出中平间，渴乌翻车洒平洛。\n宗资墓口卧露霜，头角顿挫仍腾攫。\n尔来拂拭傍几案，眉目睢盱苔藓剥。\n形模不入世俗用，疑付大手传糟粕。\n未能点缀清庙颂，开辟大易摛春秋。\n就令□□□□□，末势犹足为迁彪。\n物无贵贱系所用，千金乞我直暗投。\n图书散落愈□下，晚岁惟有齑盐谋。\n学注虫鱼问老圃，无乃塌飒为匜羞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日独居","author":"王安国","text":"竹苗敷夏阴，萝蔓蔽朝亮。\n感此节物佳，百骸适无恙。\n委蛇投广厦，萧瑟绝遗响。\n稍酬简编馀，俄得冠裾放。\n身虽势利中，心随弦歌尚。\n默然想圣贤，游世无得丧。\n抱关秉翟间，未分弃冗长。\n人生适意难，聊各安所乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平居","author":"王安国","text":"絺绤散薰风，平居触事慵。\n古今饶得失，义命孰违从。\n水鸟迎秋舫，山花映夕舂。\n故乡图画见，生死愧尘容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上春日","author":"王安国","text":"一池春水绿于苔，水上花枝间竹开。\n芳草有时依旧长，文禽无事等閒来。\n年颜近老空多感，风雅含情愧不才。\n独有前人脩禊在，荒亭终日此徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"假寐","author":"王安国","text":"计较平生分闭关，偶然容得近人寰。\n春风池沼鱼儿戏，暮雨楼台燕子閒。\n假寐尘侵黄卷上，行吟花坠绿苔间。\n了无一事撩方寸，自是颓龄令鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦热","author":"王安国","text":"出门无路避飞沙，长夏那堪暑气加。\n永昼火云空烁石，华堂冰水未沉瓜。\n月明葱岭千秋雪，风静天河八月槎。\n终借羽翰乘兴往，烦冤谁此恋生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"缭垣","author":"王安国","text":"缭垣乌鹊近人飞，帘外曈曈日上迟。\n桧作寒声风过夜，梅含春意雪残时。\n古今无物为真乐，出处何心更诡随。\n寄语年华聊一笑，未应长负醉乡期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金明池","author":"王安国","text":"霓旌远远拂楼船，满地春风锦绣筵。\n三岛路深游阆苑，九霞觞满奏钧天。\n仗归金阙浮云外，人望池台落日边。\n最引平生江海趣，波澜一段草如烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠三灵程道人","author":"王安国","text":"三灵山下新安水，潇洒人间画不如。\n收得市朝忙日月，归来田里老樵渔。\n君能知命忘机久，我愧于时触事疏。\n从此卜邻同笑傲，何须强著解嘲书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和魏道辅雨中见示","author":"王安国","text":"移病憛憛久雨中，鸣驺时听六街东。\n忽吟佳客诗消暑，远胜前人檄愈风。\n海运我殊惭斥鴳，陆沉君合伴翔鸿。\n更酬珠玉思谈笑，裹饭何须厌屡空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨意","author":"王安国","text":"柱础沾濡雨意成，翩翩鸟雀隔帘鸣。\n侵寻爽气来攲枕，想像沧波去濯缨。\n已识古今无得丧，祗须彼我不相迎。\n冁然一笑呼归骑，聊更飞毫戏友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄梅花","author":"王安国","text":"庾岭开时媚雪霜，梁园春色占中央。\n未容莺过毛先类，已觉蜂归蜡有香。\n弄月似浮金屑水，飘风如舞曲尘场。\n何人剩著栽培力，太液池边想菊裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李子仪知明州","author":"王安国","text":"儿童剧戏甬东天，小别侵寻二十年。\n海岸楼台青嶂外，人家箫鼓白鸥边。\n哀容愁问州民事，胜槩欣逢太守贤。\n为我剩题潇洒句，遥闻凤诏待诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送乌子山给事赴扬州","author":"王安国","text":"都人供帐国门东，淮海兵符节制中。\n青琐论思虚夜月，朱幡游衍值秋风。\n侯嗟谁在思张仲，民喜重临得次公。\n内外忘怀能自适，何时谈笑一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送德之提刑郎中赴广西","author":"王安国","text":"天扶开宝至熙宁，和气薰蒸瘴疠停。\n五管闾阎如按堵，六朝仁圣喜祥刑。\n欲推恩泽求肤使，果见谋猷简大庭。\n嗟我白头甘抱椠，看君归日上青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送文渊使君郎中赴当涂","author":"王安国","text":"看花金谷屡衔杯，先后归时出处乖。\n朝日衣冠辞魏阙，春风旗鼓过秦淮。\n谈间咸庆连云屋，事外欢娱付水斋。\n回首未成东下计，可无书札写离怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金山同正之吉甫会宿作寄城中二三子","author":"王安国","text":"寺压苍厓势欲倾，欢然西度为谁兴。\n云随草树萦层岫，江浸楼台点万灯。\n坐久不知身寂寞，梦回犹觉气轩腾。\n思君城郭尘埃满，相逐寻閒亦未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中夏","author":"王安国","text":"朝晡广厦坐攲斜，稍觉炎天气象加。\n紫玉箫攒湘竹笋，赤霜袍烂海榴花。\n悠悠物外身无事，扰扰人閒智有涯。\n五鼎一瓢何必问，且凭诗句度年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨馀","author":"王安国","text":"雨馀宫阙映秋旻，漠漠槐花水上新。\n夜有蝭蟧催节物，朝无沆瀣助精神。\n形如槁木聊依世，名若浮烟底徇人。\n莫笑长吟销短景，故园回首隔参辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得雨","author":"王安国","text":"青天赤日水如汤，车马飞尘百尺长。\n望岁人人忧旱魃，舞雩旦旦待商羊。\n清衷凌物回天鉴，膏泽乘时助岁穰。\n自有股肱歌盛德，刍荛谁敢僭揄扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵景文雪中见寄","author":"王安国","text":"未能谈笑破愁城，犹幸都无俗事撄。\n载酒何人过扬子，评诗今日得钟嵘。\n杜门落漠尘埃隔，扫径侵寻霰雪生。\n谁向梁园能授简，看君文格出天成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪意","author":"王安国","text":"雪意悠悠底未成，年华促促尚谁惊。\n浮云稍助春来暗，薄日迟回午后明。\n静见游尘侵藓迹，忽闻落叶扫阶声。\n此时俯偻无酬酢，世谛吾心弃不争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆梅花","author":"王安国","text":"禁街人语绝諠哗，庭下微吟斗柄斜。\n万里云容今霰雪，一阳泉脉动萌芽。\n顿忘人世蓬心累，已任天年葆鬓加。\n早晚翩然青雀舫，满江春色看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"王安国","text":"醉笔题诗紫界墙，梅花零落扑衣裳。\n天香又杂杯中渌，春色还惊鬓上苍。\n涉世何妨为白璧，流年未必抵黄粱。\n一吟起我平生志，今古冥冥出处忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊外","author":"王安国","text":"野旷天寒气象嘉，浮云浓淡日初斜。\n泽中雨涨无鸣鹘，荷下波翻有怒蛙。\n箫鼓残声来帝阙，渔樵归径见人家。\n尘簪羞把黄花插，不耐飞蓬斗鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋匪躬太祝先辈示及刘贡父伯仲三人同年登第之诗因奉一篇","author":"王安国","text":"六朝文物事当奇，阀阅如今举世推。\n射策人争看三虎，荐书吾早识孤罴。\n集英晓日胪传后，琼苑春风宴喜时。\n共羡丝纶归世掌，还看骖隔凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同器之过金山奉寄兼呈潜道","author":"王安国","text":"忆同支遁宿嵚崟，不负平生壮观心。\n北固山随三楚尽，中泠水入九江深。\n纷纷落月摇窗影，杳杳归舟送梵音。\n东去何时来蜡屐，天边爽气梦相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读魏世家","author":"王安国","text":"亹亹谈先王，古今谁有得。\n施为虽绪馀，要在情不匿。\n嗟彼三代后，沦胥入战国。\n翟璜闻一言，惭俛惭李克。\n论材称权衡，轻重无物惑。\n吾心能如此，乃可任人责。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日独居","author":"王安国","text":"晰晰池沼鯈，绿萍随下上。\n黳黳堂庑燕，白昼容俛仰。\n顾我亦晏如，环庐花药长。\n无材助太平，得地幸閒旷。\n稍涉千古书，日觉神明王。\n乘閒盼物情，自适忘外奖。\n涵濡覆载仁，谁废鱼丽唱。\n黄尘洮陇戍，黑雾荆衡饟。\n奔波喝道边，毕命营边障。\n吾此独何为，飞潜乐能飨。\n何时闻解严，慰彼西南望。\n当使少陵翁，得见廉颇将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"堂上有遗膻","author":"王安国","text":"堂上有遗膻，堂下无聚蚁。\n但知嗜欲求，不必风雨至。\n客方笑营营，贪得故无几。\n安知万类中，趋舍忘彼己。\n天乎顾人寰，等是一时戏。\n受形巨细分，阽危后先尔。\n浸淫蚍蜉生，穴柱从此始。\n庄生亦知言，信矣当弃智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题吴长文得兰亭康相墓颜鲁公断碑","author":"王安国","text":"鲁公之忠旷世无，吾爱斯人何必书。\n九原寥寥不可诘，笔法彷佛精神馀。\n况公于艺自天纵，一字宜用千金摹。\n想当挥洒笑谈际，不复靳惜唯所须。\n山砠水险勇镵刻，照耀楚越连秦吴。\n百年兵火变陵谷，万里玉石埋榛芜。\n时平好事搜遗迹，穷极南北缘崎岖。\n耳闻目见略已尽，疑有断裂留樵渔。\n那知数尺翳尘土，洗涤近出都城居。\n松煤到纸觉飞动，气象磊落超钟虞。\n吴卿获此喜惊坐，朝昏把玩过明珠。\n携来赠客客为赋，爽迈远并前贤驱。\n自云感激得妙理，学入胜处繇勤劬。\n余闻书史羸蟠礴，意匠不为形骸拘。\n能将声利瓦砾弃，点画应手成璠玙。\n公遭乱世生死俱，见危授命真丈夫。\n俯仰兵刃犹簪裾，毫端妍丑骨睢盱。\n试怀局缩较精粗，体势岂暇烟云舒。\n区区技巧尚乃尔，欲鸣道德宜何如。\n嗟哉荒烟几日月，豪俊忽徙临庭除。\n由来始弃终见取，鉴裁谁敢欺锱铢。\n物微显晦亦有待，人生通塞无巧愚。\n寄谢纷纷驰骛徒，真伪枉以好恶诬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"王安国","text":"吴兴太守美如何，太守从来恶祝鮀。\n生若不为上柱国，死时犹合作阎罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滕王阁诗","author":"王安国","text":"地势远连徐孺亭，穷南有客两曾经。\n檐前燕雀鸣相斗，潭里蛟龙困未醒。\n乱霭苍茫侵树色，惊涛浩荡失天形。\n当时好景无同赏，对此悲歌孰为听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"王安国","text":"三见齐王不一言，须知自古致君难。\n纷纷齐虏誇迂阔，口舌从来易得官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忘言","author":"王安国","text":"宋国旌孝子，东门毁以毙。\n楚王好细腰，后宫馁而殪。\n物情信可怜，徇外易生死。\n身存宠可誇，亡矣安所恃。\n吾今思彼哉，未足语释利。\n扰扰智惊愚，卑卑学阿世。\n吹嘘出虹蜺，顿挫入尘滓。\n爱憎虽人为，荣辱乃天使。\n恩无斯须怀，怨已塞天地。\n百年呼吸中，毫发谁豫己。\n适者默然窥，阴阳驱意气。\n始终本何有，一息累万世。\n由来适人适，宿昔多如此。\n喟余聊自欲，安得忘言士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送聂剡县兼呈沈越州","author":"王安国","text":"剡溪清泻映檀栾，天姥花飞载酒船。\n忆我少年来蜡屐，羡君今日去鸣弦。\n从容人乐渔樵外，潇洒诗随簿领边。\n太守相逢应见问，为言多病忆林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"王安国","text":"槛外风吹前渡语，江边影落万山灯。\n半空月上方清澈，万里潮来自沸腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王安国","text":"孔明勿问襄阳庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"王安国","text":"因郎憔悴却羞郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"王安国","text":"谁使诗仙来凤沼，俗传贾客过鸡林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"王安国","text":"倾家何计效。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"王安国","text":"风暄翠幕春沽酒，露湿筠笼夜卖花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"王安国","text":"当时徐氏擅笔墨，夜围梦堕空中筛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"王安国","text":"方竹同吾操，端然直物间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十","author":"王安国","text":"江田百顷春风种，山果千株夜雨涵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十一","author":"王安国","text":"半夜楼台浮海口，万家箫鼓递江风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"王安国","text":"平地风烟飞白鸟，半山云木卷苍藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十三","author":"王安国","text":"海鹏未击三千里，天马须归十二闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十四","author":"王安国","text":"宫殿影摇河汉外，江湖梦断鼓钟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十五","author":"王安国","text":"北海知天谕牛马，东方傲俗任龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十六","author":"王安国","text":"九月清霜送陶令，千年白日见滕公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"王安国","text":"山围燕作画图出，水作夜窗风雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十九","author":"王安国","text":"坐啸月华青嶂外，徐吟帆起白云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海棠","author":"李定","text":"青帝行春信自专，精心知向海棠偏。\n不沾工部风骚力，犹占句芒造化权。\n倚槛半开红朵密，绕池初应翠枝连。\n谁人与拔栽琼苑，看与花王斗后先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石扬休海棠","author":"李定","text":"轻红如杏素遮梨，直似佳人照碧池。\n已是化工教艳绝，莫嫌青帝与开迟。\n烟滋绰约明双脸，雨借夭饶入四脂。\n西蜀有名须得地，琼林高压百花奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"垂虹亭","author":"李定","text":"一梦江湖三十年，青山隐隐水漫漫。\n当时把酒谁人在，回首重来独倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琴溪","author":"李定","text":"芳草茸茸衬马蹄，两陪宪节过琴溪。\n东风又属梨花月，膏雨新调燕子泥。\n邮舍亭空苍藓合，钓台人去暮云栖。\n此行不惮驱驰远，千里江山入品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赣州嘉济庙祈雨感应","author":"孔平仲","text":"江东祷雨真灵迹，香火未收檐溜滴。\n城中到此夜五更，渡口归时水三尺。\n高田流满入低田，万耦齐耕破晓烟。\n但愿吾民得饱饭，年年岁岁是丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题壁","author":"孔宗翰","text":"屈指从来十七年，交亲零落一潸然。\n婵娟再见中秋月，依旧清辉照客眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴中复游海云寺","author":"杨希元","text":"三春行乐盛刀州，况是春光欲尽头。\n使节在郊观似堵，香轮争道去如流。\n正逢铃阁多閒日，肯对花时负胜游。\n会得公心惜欢意，欲归犹自尽迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]