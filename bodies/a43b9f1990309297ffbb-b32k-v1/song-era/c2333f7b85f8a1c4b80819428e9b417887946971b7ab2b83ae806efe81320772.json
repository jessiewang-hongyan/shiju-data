[{"title":"次韵陈料院 其三","author":"方岳","text":"书册元非幕府才，江山牵率老夫来。\n略分秋色归吟卷，又误春蓑下钓台。\n有意及时常轗轲，无心于物莫惊猜。\n幽居亦有穷生活，麦陇蔬畦手自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵三四弟","author":"方岳","text":"入手功名不厌迟，政须努力莫伤悲。\n二难宁共姜肱被，一染谁怜墨子丝。\n仕宦金吾吾亦爱，饥寒玉汝汝当知。\n青灯夜寂聊参取，侑坐为铭只此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵乡友","author":"方岳","text":"书生作计已差殊，况复真穷五技鼯。\n空费寸阴酬急羽，还同斗米饱侏儒。\n鸥盟正尔隔千里，鹤梦何曾到九衢。\n茅屋春寒明月夜，梅花曾与寄声无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵山居 其一","author":"方岳","text":"孤亭危受众峰朝，岁晚移床借避嚣。\n梅次第花春漠漠，鹤相随睡夜寥寥。\n诸公安用怒生瘿，老子岂为饥折腰。\n更入乱云深处去，极知与世不同条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵山居 其三","author":"方岳","text":"文如翻海百川朝，不说从前两耳嚣。\n径与此山俱寂寂，未应吾道竟寥寥。\n一生不办雕龙口，十万谁缠骑鹤腰。\n但得草茅休歇去，何如快活有新条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵山居 其四","author":"方岳","text":"閒民亦幸乐清朝，蓑笠过从语不嚣。\n倏忽岂能知混沌，玄冥颇亦识参寥。\n年华鼎鼎分杯面，筋力时时借树腰。\n月冷霜寒惊鹤帐，住山活计太萧条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵才老","author":"方岳","text":"藏拙欲分萝月阴，十年回首愧重临。\n吾徒空倚横天剑，此老长閒布地金。\n案有法华山寂寂，门无俗客竹深深。\n瘦藤莫厌频来往，同社壶觞手自斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方叔","author":"方岳","text":"江楼识面一跫然，语带烟霞似欲仙。\n山雨竟寒清夜约，好风吹落碧云篇。\n相逢客路思归日，几立梅花欲暮天。\n有兴话诗吾傥住，一蓑须办雪溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王兄","author":"方岳","text":"江分晓色洗征衣，吾道非邪傥是欤。\n与世无缘伤骨鲠，归田有日放眉舒。\n虎头食肉亦安用，牛背看山却自如。\n留得荷锄双手在，尽堪老瓦一轩渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王尉天宁晚饭","author":"方岳","text":"借得山房住，清溪带晚林。\n云应随鹤宿，诗亦对僧吟。\n杯滑知能隽，窗深苦易阴。\n剧知归思浩，吾亦识琴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王尉白事幕府","author":"方岳","text":"一痴便了公家事，尽可与诗宽作程。\n书册不嫌官屋冷，香匜相对歙溪晴。\n熟知白鹭难为伴，烦见青山且寄声。\n此别不过旬日耳，又携孤啸上江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王尉贺雨","author":"方岳","text":"老天自不负吾君，谁向灵均三沐熏。\n鹤立待收连夜雨，龙归看带入山云。\n摩挲一饱岂易得，愁叹多年不忍闻。\n亦欲买牛横短笛，华山一半倘容分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王尉致香","author":"方岳","text":"客有知吾癖，能分一雪凉。\n只将诗意思，自与梦商量。\n竹密雨声隽，窗深山意长。\n研朱对周易，老鼎亦英扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王尉赠别 其一","author":"方岳","text":"十载春泥溅客衣，江湖半已入吾诗。\n事今岂得文章力，心亦难求世俗知。\n山意向人如有语，鸥盟于我合归谁。\n月明昨夜欺寒梦，未了西斋竹外棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王尉赠别 其二","author":"方岳","text":"摩挲老砚欲生衣，煞欠梅花别后诗。\n明月夜怜无客共，故人心岂不吾知。\n相看白眼了无忤，除却青山更有谁。\n但得秫田供醉梦，世情付与烂柯棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵卢监","author":"方岳","text":"兰亭人寂几何年，著我糟丘亦冗员。\n寻访雪溪无酒债，主张禊帖有诗权。\n千岩秀处书如堵，五月凉时藕似船。\n只么拍浮真足矣，底须妄想到花边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶兄云崖","author":"方岳","text":"以酒为乡墨作庄，厓寒云亦为诗忙。\n春山药草谁同斸，云径梅花只自香。\n竹不碍山青入户，藓缘谢客绿侵床。\n岂无枫叶吴江句，夜雨何时稻韭黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶宗丞约游括苍","author":"方岳","text":"一诗不了苍州债，曾泊春沙问水程。\n山自强如吾郡好，酒今闻有括滩清。\n文章未得半分力，故旧难忘少日情。\n已斸莓苔新种竹，恐无辞与此君盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵田园居","author":"方岳","text":"带郭林塘尽可居，秫田虽少不如归。\n荒烟五亩竹中半，明月一间山四围。\n草卧夕阳牛犊健，菊留秋色蟹螯肥。\n园翁溪友过从惯，怕有人来莫掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘架阁和予壬寅入局诗","author":"方岳","text":"入开图籍底须钳，谁校蓬山三万签。\n有竹两窗聊下榻，为梅一笑几巡檐。\n虎头食肉亦安用，熊掌与鱼那得兼。\n好事人来勤载酒，纵无奇字不渠厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘簿祷雨西峰 其二","author":"方岳","text":"爱民端与共胞胎，消得黄金为筑台。\n一道香烟随牒去，五更风雨入诗来。\n雪灯字暗心犹在，霜叶衫枯首独回。\n气格老苍能过我，柴门不厌为君开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵牟监簿斋宫","author":"方岳","text":"蛮触追奔竞一豪，市朝酣战万灵鼍。\n斋房只在秋山外，吟卷自随明月多。\n问字人须烦谢绝，敲门僧亦莫谁何。\n竹宫曾见神君否，且乞天瓢为挽河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵红蕉","author":"方岳","text":"霜林蕉叶尚横陈，不易禁寒夜向晨。\n以貌取人通体似，其心如我别般春。\n两年开就花何晚，千里移将句有神。\n待学伊蒲修净供，自烹菡萏当猩唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵红蕉 其一","author":"方岳","text":"篱根宿草已陈陈，谁护蕉红到此晨。\n雪里寸丹长似旧，人间万绿未知春。\n翻经曾识观身法，乞种亲为土地神。\n孤负晚风生酒兴，维摩示疾不沾唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵红蕉 其二","author":"方岳","text":"山花山草杂前陈，谁解芬芳霰雪晨。\n红菡萏肥如欲焰，绿玲珑卷过于春。\n化工有意怜丘壑，老我无诗泣鬼神。\n待唤曲生相暖熟，雨晴禽哢是歌唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵行甫小集平山 其四","author":"方岳","text":"欲将春睡了春閒，谁遣杨花点暮颜。\n世事不如眠白堕，人情何啻抵黄间。\n茫无措手句中句，悔已噬脐山外山。\n蚤晚定编长庆集，并教传写落乌蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵行甫小集平山 其一","author":"方岳","text":"不奈花时两手閒，共携诗砚对孱颜。\n江南江北音书外，春去春来杨柳间。\n骑鹤重寻烟雨句，征鸿欲没夕阳山。\n百年风物一杯酒，叹息人间两触蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵行甫小集平山 其五","author":"方岳","text":"客愁聊以酒防闲，非复春风桃李颜。\n北望未忘诸老在，中兴已是百年间。\n非无烟雨无奇语，自有乾坤有此山。\n杨柳岂知兴废事，夕阳依旧舞腰蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵行甫小集平山 其二","author":"方岳","text":"春风多可几曾閒，又为平山入醉颜。\n流恨不穷江万里，与翁长在月三间。\n半清半浊圣贤酒，似有似无烟雨山。\n试问黄鹂相识否，绿阴深树自绵蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵县圃即事","author":"方岳","text":"凫鸭能閒暇，相依睡浅波。\n海棠经雨过，杨柳受春多。\n未必诗穷在，其如酒病何。\n闭门春草长，吾亦断经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴侍郎同集砚山","author":"方岳","text":"晚寒閒袖挥毫手，曲角栏干倚断云。\n丘壑尽容诗独步，江淮相望月平分。\n艰难鬓葆成霜茁，冷落梅花带雪芬。\n酒不能平诗磊磈，杯行到手已醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴枢密乌衣园旧韵","author":"方岳","text":"旧家门巷绿岧峣，尚忆狨鞯马意骄。\n金凿落浮朱雀浦，玉丁东上紫宸朝。\n燕随往事秋萧瑟，雁带夕阳江泬寥。\n九日黄华晴亦好，底须风雨又潇潇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴殿撰多景楼见寄","author":"方岳","text":"多情王粲怕登楼，谁遣人间汗漫游。\n莼菜梦回千里月，蘋花老却一江秋。\n人如沙燕年年别，骚到湘累字字愁。\n正尔相观衣带水，角声孤起暮云稠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张录携书见过 其一","author":"方岳","text":"家在屏山东复东，高轩肯过白云中。\n石桥自是神仙处，竹屋相传诗律工。\n日暮春江愁李白，山寒秋菊老龟蒙。\n时平莫袖挥毫手，此论于予却未公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张录携书见过 其二","author":"方岳","text":"君家自有神奇在，底用浓熏到马班。\n黄石一编灯火外，紫芒双剑斗牛间。\n谁能莫府初开印，闻有诗人便入山。\n雨过勘厅春草绿，与吾意思政相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李君携示唐告","author":"方岳","text":"唐家甲乙尊门族，谁有流传直到今。\n一代衣冠王子表，三朝雨露圣人心。\n曾经竹巷醉双玉，尽出花绫诺百金。\n湖海半生今见子，摩挲未负老侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汪少卿祷雪有感","author":"方岳","text":"梅梢了未知寒在，剪取清溪作雪飞。\n正草绿章笺玉帝，顿惊碧宙舞瑶妃。\n卖刀我亦耕侯土，歌裤今谁典客衣。\n想得夜窗春满袖，燕彝香煖醉吟归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汪少卿赠别","author":"方岳","text":"一诗传戟外，春亦肯随行。\n老不论圭瓒，寒于嚼水晶。\n梦惊池草合，香泛墨花轻。\n立尽沙头月，鸥清睡不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汪宰见寄 其二","author":"方岳","text":"半世青灯眼欲昏，谁知曾亦望中原。\n雨荒塞草秋如洗，雪拥春蓑夜自温。\n宠辱易生分别想，是非政可鹘崙吞。\n不论茅屋锄犁外，但守平生六二坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汪宰见寄 其一","author":"方岳","text":"行行骢马劾粗豪，叱叱黄牛倦作劳。\n穷则有馀名迹在，言之无作语声高。\n谁求封禅家徒壁，自谓羲皇人似陶。\n见说醉乡天地阔，此生聊向此中逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵閒中","author":"方岳","text":"玲珑压辔系绒鞍，付与诗人洗眼看。\n老子只凭双脚健，梅花相对一溪寒。\n吾生焉往不三黜，此乐未央并四难。\n并与竹间孤鹤语，倦飞底用插脩翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵閒中","author":"方岳","text":"区中何日了尘缘，落草牛须蓦鼻穿。\n乾没一生空岁月，见成三径老风烟。\n山林有味从今我，钟鼎无心付老天。\n田彼南山多种豆，不愁饥火苦相煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈汤卿 其二","author":"方岳","text":"野径渔樵共，霜寒江上村。\n乱山横紫翠，孤笛送黄昏。\n满壁题诗暗，连墙贳酒浑。\n往来今已熟，稚子又应门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈汤卿 其一","author":"方岳","text":"括苍烟雨顶，客木晚巑岏。\n家远书难到，云深梦亦寒。\n僧邀携茗试，客许借诗看。\n琴冷梅花月，何时为一弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈料院 其二","author":"方岳","text":"涉世曾经几折肱，径须归卧北村灯。\n往来屑屑无家燕，去住匆匆旦过僧。\n浦淑舟寒秋婉娩，江湖人老雪鬅鬙。\n草堂便在山深处，无复莼鲈累季鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈料院 其四","author":"方岳","text":"久矣寒窗美曲肱，绝交书到短檠灯。\n向来问舍渔樵侣，肯作归田粥饭僧。\n耕罢夕阳牛觳觫，睡残明月鹤鬅鬙。\n年来老懒略相似，见兔何能便放鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈料院 其一","author":"方岳","text":"红旗破贼本非才，白首为郎更此来。\n群玉府应羞哙伍，碧油幢误筑燕台。\n江行莫等蛟鼍怒，雨歇能令鸥鹭猜。\n三径未荒归路好，秋风篱落菊花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈祭酒直舍木犀","author":"方岳","text":"西雍夜直秋风底，断是龙涎不敢香。\n月府肯分金粟粟，书床相对玉琅琅。\n人间富贵梦不到，世外高寒味尽长。\n亦笑柴桑千载士，同时祇识菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵净照","author":"方岳","text":"一筇一衲出山相，不道斯人故可人。\n我已久闻挥翰手，师宁相对坐禅身。\n山林有味青灯古，天地无情白发新。\n认取本来真面目，瀑泉诗好未知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵所居龙池巷","author":"方岳","text":"从来绝技似屠龙，莫倚神奇阿堵中。\n但得直声如汲黯，尽渠曲学付孙洪。\n草堂自作冥鸿计，药市宁收汗马功。\n古井无波门巷静，再三不用起雷风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林同年见寄","author":"方岳","text":"水驿山城几往来，雪鸥亦怪面生埃。\n径归不为麒麟楦，多病竟孤鹦鹉杯。\n老子地寒馀草径，广文官冷合兰台。\n山居美不堪持赠，云湿堕樵羹芋魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵罗制干投赠","author":"方岳","text":"中秋明日是，雨色半苍厓。\n无月可吾子，有诗倾老怀。\n人间棋局面，身外酒生涯。\n莫及边头事，谁知浊与淮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵话别","author":"方岳","text":"一雨桐江滑，佳哉月一篷。\n归犹惭怨鹤，悔不蚤冥鸿。\n涉世书无用，寻山酒有功。\n诸人如见问，贫耳却非穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑司理时以掌故赘梱幕归未能也","author":"方岳","text":"二月江南柳正花，扶携贫病又天涯。\n愁予夜雨莼鲈梦，老却春山笋蕨芽。\n太白有芒兵未歇，杀青无补事堪嗟。\n书生迂阔多如此，不为吟诗两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其一","author":"方岳","text":"老我菟裘月一间，仰眠黄犊看青山。\n有诗倚竹猿猱径，无梦排云虎豹关。\n城郭是非溪隔断，风烟灭没笔追还。\n底须一局销长日，并不能棋方是閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其六","author":"方岳","text":"白菰紫芰更红蕖，不枉平生水竹居。\n醉眼岂知吾是我，机心亦笑子非鱼。\n无能涉世何妨睡，有道登山只是徐。\n六月好风清樾底，付渠天地一蘧蒢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其八","author":"方岳","text":"诗穷不易办亭材，只恁荒寒处处苔。\n种秫便当终老去，爱花能有几人来。\n生前尽足竹三径，身外无穷水一杯。\n未必诸贤知此意，柴门虽设不曾开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其四","author":"方岳","text":"一枕羲皇失午熇，久知吾道定寥寥。\n客来且拨浮蛆瓮，事过真成覆鹿蕉。\n野性从来便水石，此生自合老渔樵。\n移床更入深云处，厥木惟乔厥草夭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其三","author":"方岳","text":"渔村留得旧蓑衣，鹭侣鸥朋共断矶。\n衰发三千馀丈白，倦游五十二年非。\n清风明月天四壁，老木苍藤草半扉。\n寂寞相从交有道，骊驹未可遽言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其五","author":"方岳","text":"十亩山园赋遂初，左花右竹了无馀。\n择阴老我自麋鹿，甘带何人不蝍蛆。\n佛社独容陶令醉，帝城难作子公书。\n行山且不携诗卷，只许鸱夷载后车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其七","author":"方岳","text":"烟藤云木捲苍虬，更放琅玕出一头。\n山下人家方酷暑，此中棋局自惊秋。\n图书如昨不堪煮，风月无多谁与酬。\n怪得纵横苏季子，岁寒也忆旧貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑佥判 其二","author":"方岳","text":"不论山北与山南，是处移将竹两三。\n亦爱村深工部屋，尚嫌门对相公潭。\n夕阳归鸟占花坞，山雨饭牛规草庵。\n口挂壁从生白醭，是中除酒百无堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑总干 其三","author":"方岳","text":"过从一笑酒瓶空，不是樵翁即钓翁。\n偶种竹成俱崛强，旋移花活尚神通。\n前身已化归辽鹤，醉帖犹传戏海鸿。\n新贵少年吾自老，世间白发几曾公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑总干 其二","author":"方岳","text":"我亦思兮天一涯，樊川诗老此曾家。\n九夫容隔秋风浦，一独速眠春雨蛙。\n竹屋有灯谁与共，秫田可酿不须赊。\n何年又赋高轩过，豆粥犹能办咄嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]