[{"title":"依韵和酬子直重阳送酒","author":"陈襄","text":"君有云泉酒，诗来寄我尝。\n色过金菊淡，味带木兰香。\n北固山城秀，东园水榭凉。\n无因陪落帽，孤酌负重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻沿牒京口忆西湖寒食出游见寄二首 其二","author":"陈襄","text":"春阴漠漠燕飞飞，可惜春光与子违。\n半岭烟霞红旆入，满湖风月画船归。\n缑笙一阕人何在，辽鹤重来事已非。\n犹忆去年题别处，鸟啼花落客沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻沿牒京口忆西湖寒食出游见寄二首 其一","author":"陈襄","text":"乞得湖山养病身，花时曾共忆行春。\n嘤鸣幽鸟还迁木，觱沸清泉复采芹。\n皂盖寻芳丘有李，綵楼观戏巷无人。\n锦袍公子归何晚，独念沟中菜色民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻沿牒京口忆吉祥牡丹见寄","author":"陈襄","text":"新接枝头色倍添，马蹄寻处帽攲檐。\n春工别与铅华丽，佛地偏资好相严。\n红蕊欲开丹未渥，素香堪茹雪非甜。\n诗翁何事辜真赏，不许浮根浪发黏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和公序库部观孔雀因呈东玉少卿","author":"陈襄","text":"修尾峨冠蜀锦裁，飘流应自玉关来。\n閒窥水鉴精神出，静刷金华羽翼开。\n野思未饶鹇洒落，羁栖聊与雁低回。\n不因久在司空馆，平日谁怜五客才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东玉少卿见遗","author":"陈襄","text":"束刍弥月馆行人，白首无殊一面新。\n朔漠持麾惭未达，东方连骑喜相亲。\n卮言坐遣壶中月，物色频惊塞下春。\n使者不知为旅意，佳篇犹拟驻征轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东玉少卿后池群雁","author":"陈襄","text":"生意淹留白水塘，樊笼多事岂吾乡。\n江湖已失秋南望，岁月犹欣塞北凉。\n白日稻粱应饱足，青云岐路莫思量。\n主人怜尔能鸣久，肯放逍遥物外翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东玉少卿谢春卿防禦新茗","author":"陈襄","text":"尝陪星使款高牙，三月欣逢试早茶。\n绿绢封来溪上印，紫瓯浮出社前花。\n休将洁白评双井，自有清甘荐五华。\n帅府诗翁真好事，春团持作夜光誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和正辞职方以浚河留滞","author":"陈襄","text":"万锸如云浚禹沟，荀卿桥畔舣行舟。\n珠躔合照贤人聚，银汉无波海客留。\n且作东山携妓乐，未应南浦送君忧。\n辛夷花发春醅熟，只俟郊原雨少休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和苏子瞻通判在告中闻余出郊以诗见寄","author":"陈襄","text":"郊原绿意动游人，湖上晴波见跃鳞。\n閒逐牙旗千骑远，暗惊梅萼万枝新。\n寻僧每拂题诗壁，邀客仍将滤酒巾。\n寄语文园何所苦，且来相伴一行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和运使兵部秋成","author":"陈襄","text":"重湖收积潦，多稼结盈畴。\n贷息移书减，逋租案籍求。\n民情宽蹙頞，岁计上参谋。\n寄语昆堂老，生初早晚修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和咏鹤","author":"陈襄","text":"耻与笼禽饫稻泉，满怀霜雪独萧然。\n千年华表曾留语，万里青云此息肩。\n养性最宜栖露苑，引吭时得唳晴天。\n神仙骨法人难相，除向瑶台玉简编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其十","author":"陈襄","text":"我爱仙居好，三年理尚宽。\n民虽离网罟，政未息风澜。\n悯物刑多省，劳心席少安。\n祗惭无惠术，求配古人难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其九","author":"陈襄","text":"我爱仙居好，惭无德政馨。\n下车时问疾，治狱日空囹。\n老吏贫归里，苍生馁在庭。\n惟忧泽未至，岂敢渎邦刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其八","author":"陈襄","text":"我爱仙居好，家居十数人。\n民穷惟有疾，俸薄不知贫。\n弟妹閒成癖，妻孥老未淳。\n自馀无所恨，寸禄及偏亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其七","author":"陈襄","text":"我爱仙居好，公馀日在房。\n忧民极反覆，责己未周详。\n法律行随手，诗书坐满箱。\n老来须向学，多病喜平康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其五","author":"陈襄","text":"我爱仙居好，官卑分已盈。\n才非汉循吏，道似鲁狂生。\n击柝心虽乐，观民志未平。\n宁如孟夫子，不食去齐卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其四","author":"陈襄","text":"我爱仙居好，经营尽国工。\n庶民心喜悦，小邑势尊隆。\n万瓦如云合，千题不日砻。\n自非仁惠术，愧子一观风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其三","author":"陈襄","text":"我爱仙居好，园池日退居。\n驯禽来鹤鹤，野水进徐徐。\n草树通樵采，桑麻有老锄。\n犹言民未乐，更待寝刑书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其二","author":"陈襄","text":"我爱仙居好，安民去百奸。\n诚心虽照物，政体昧循环。\n喜有纲条立，惭无教令颁。\n三年忧且病，王事岂能閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑闳中仙居十一首 其一","author":"陈襄","text":"我爱仙居好，临民必以诚。\n簿书无日暇，狱讼积年生。\n百疾求箴补，千钧待准平。\n嗟予不如古，斯道未能宏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和通判九月望日始见菊花二首 其二","author":"陈襄","text":"灼灼秋英缀露华，白衣不见日空斜。\n细看未减重阳泪，更晚犹胜二月花。\n城里好山何处寺，门前多竹甚人家。\n直须载酒频来赏，莫为衰迟便感嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和通判九月望日始见菊花二首 其一","author":"陈襄","text":"月满霜飞菊始华，幽丛冷落带烟斜。\n篱边过却重阳酒，泽畔谁怜野草花。\n湖学先生归解组，安州司户老居家。\n皆因晚节无人用，陨涕临风为尔嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和御制赏花钓鱼","author":"陈襄","text":"仙跸传呼禁苑开，两班迎拜玉舆来。\n花围帝座重张幄，鳞上天钩曲赐杯。\n鸟散香丛声睍睆，人观灵沼乐徘徊。\n君恩更锡回鸾藻，还许儒生给笔陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程大卿游凤池院","author":"陈襄","text":"白云深处一轩开，凤去池空折野梅。\n山接九龙争夭矫，路盘千骑久徘徊。\n烟岚翠入樽前滴，水石深从涧底来。\n谁与忘机此栖息，笑看林鸟下生台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程大卿游升山","author":"陈襄","text":"相逢不及荔枝期，况值千岩雪洒时。\n南国小棠偏去近，北山逋客独来迟。\n云中直有三清路，尘外都如一局棋。\n闻欲引泉添洗药，未应夺我凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程公辟红梅","author":"陈襄","text":"谁把繁英染绛脂，晓妆红淡腊前时。\n栽培上苑无多地，嘱付行人第一枝。\n朔雪有情相掩映，东风何事少嘘吹。\n莫嫌冷落天涯远，他日和羹气味移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程公辟游宿猿洞二首 其二","author":"陈襄","text":"老来归鞅海边村，犹喜诸亲聚里门。\n汉守朱轓临祖帐，韩侯清酒满离樽。\n猿惊出洞时三哭，梅送行人早一番。\n此去蓬莱峰顶月，梦魂应到荔枝园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程公辟游宿猿洞二首 其一","author":"陈襄","text":"几年营此草堂栖，施饰名园百卉齐。\n曾学子真耕谷口，今容摩什老山西。\n龙台日上千峰出，雁塔云生一径迷。\n知有岭猿犹在否，使君高卧莫教啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜意","author":"陈襄","text":"薰炉香烬蕙烟沈，凛冽寒生翡翠衾。\n月国音尘千里绝，仙山楼阁五云深。\n离怀暗耿金壶漏，独梦多惊玉女砧。\n骑省中郎才调逸，拟将文笔赋秋心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"织女","author":"陈襄","text":"明河清浅曙星稀，一夕欢娱一岁违。\n不是盈盈隔流水，也应轧轧废残机。\n人间累鹊经秋会，天上奔龙逐晓归。\n期约黄姑重相见，伯劳东翥燕西飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"经武夷山","author":"陈襄","text":"万叠层峦接远空，瑞云晴霭气溶溶。\n高于太华五千仞，秀出巫阳十二峰。\n蕙帐晓寒飞鹤怨，桃源春尽落花秾。\n鸾凰一啸最深处，仙客楼台有几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"英宗皇帝挽词二首 其二","author":"陈襄","text":"玉几言犹在，云天去莫攀。\n久长期享国，咫尺忽违颜。\n信默归元子，遗留暨百蛮。\n孤臣方仗节，无计哭桥山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"英宗皇帝挽词二首 其一","author":"陈襄","text":"才武真贤主，忧勤出至诚。\n五年膺大统，一旦享英名。\n凤驾乘霞远，龙楼继日明。\n永言配昭考，陵寝卜周京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金华山人","author":"陈襄","text":"幽居倚翠峦，尘事不相干。\n天地醉来小，琴棋静里欢。\n雨苔春径绿，风竹夜窗寒。\n若问长生术，金炉有宝丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽斋","author":"陈襄","text":"幽径绝尘踪，莓苔上粉墉。\n秋声连夜雨，寒色一溪松。\n学有书千卷，欢无酒万钟。\n云屏孤梦断，寂寞掩巫峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故太师中书令曾鲁公挽词二首 其二","author":"陈襄","text":"南台沙合后，元宰应时生。\n两控龙飞驭，三调宝鼎烹。\n筑山裴相乐，赐杖孔家荣。\n无复安舆出，儿孙衣綵迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故太师中书令曾鲁公挽词二首 其一","author":"陈襄","text":"天锡兴王佐，三朝秉化钧。\n平生清俭节，临老退閒身。\n赤舄荣封国，缁衣美世臣。\n永陪英庙享，千载德名新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日书事","author":"陈襄","text":"三城楼阁半沈烟，雨霁春华斗逞妍。\n万叠翠茵芳草地，一番轻雪落梅天。\n南园晓色迷蝴蝶，西蜀风光怨杜鹃。\n谁向武陵归未得，桃花流水路绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日宴林亭","author":"陈襄","text":"把酒春亭览众芳，水精帘箔逗山光。\n孤松冷落千年操，野槿纷华一日香。\n绿圃烟深迷蛱蝶，曲池波暖睡鸳鸯。\n文园莫惜鹴裘费，买取宜城作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚赏牡丹奉呈席上诸君","author":"陈襄","text":"逍遥为吏厌衣冠，花谢还来访牡丹。\n颜色只留春别后，精神宁似日前看。\n雨馀花萼啼残粉，风静奇香喷宝檀。\n祗恐明年开更好，不知谁与并栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇祐四年春重到浦城县南峰寺因怀旧游","author":"陈襄","text":"重到南峰寺，寻思九日游。\n黄花何处去，白雪有谁留。\n薄宦三千里，流光四十秋。\n归来见诸子，林下好相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送太君之建昌","author":"陈襄","text":"闻说庐山对县楼，蒲鱼聊足奉晨羞。\n宽心便是无声乐，省事还同不系舟。\n服药养真须少病，看经遮眼自忘忧。\n所嗟无计随亲膝，日与儿孙衣綵游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送彦祖学士赴兖州","author":"陈襄","text":"暂辞天禄请名藩，养志安贫道可尊。\n南国士歌阳羡政，东州人识翰林孙。\n重兴阙里诸生学，好荐徂徕一子恩。\n平日皂囊应草疏，由来忠谠出家门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钟离郎中知婺州","author":"陈襄","text":"皓首潘郎少似君，一麾新得浙江濆。\n神仙窟宅金华近，吴越封疆宝婺分。\n沈约瘦来题八咏，张颠醉后扫千文。\n才高政美应无事，莫厌双溪卧白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送崔黄臣知庐山县","author":"陈襄","text":"勿叹庐山远，天涯总是民。\n还家安老母，去国慕忠臣。\n斜月秦关晓，秾花锦里春。\n临行无所赠，为邑莫如仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳阁下和同舍","author":"陈襄","text":"君逢佳节忆还家，我亦淹留感岁华。\n清禁雠书惊白发，故园吹帽负黄花。\n谢安行有登山屐，扬子居无载酒车。\n何日得归溪上隐，大收图史作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳席上赋菊花","author":"陈襄","text":"折菊东篱下，携觞为燕遨。\n閒情秋后放，幽艳静中高。\n九月陶公酒，三闾楚客骚。\n及时须采掇，忍使弃蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭倪氏女弟亡儿传孙","author":"陈襄","text":"骨肉天涯别，风尘客子悲。\n孟州新丧妹，夔峡继亡儿。\n烛暗猿啼夜，城空日落时。\n肝肠已无泪，只是脑中脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席上探得随字送曼叔密学赴太原","author":"陈襄","text":"帝念唐风古未衰，便蕃恩宠命中师。\n暂驱太守朱幡去，应有儿童竹马期。\n塞外烟云千里静，帐前貔虎万兵随。\n谁怜白发诗书帅，曾见昭陵坐论时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题天游阁","author":"陈襄","text":"谁榜天游向此轩，欲令幽隐味真篇。\n一心泯绝浑无计，万事撄宁付自然。\n持钵随缘朝乞供，闭门扣寂夜安禅。\n如师早契南华旨，即是逍遥物外仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"监簿杨倜得第南归惠诗因和元韵赠其行","author":"陈襄","text":"楚客多年泽畔吟，文穷尤见用功深。\n尺书屡贡宾王府，斗粟宁酬事道心。\n长铗由来歌旧馆，鸣驺从此别中林。\n寄言乡校青衿子，君去何人更嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷华","author":"陈襄","text":"翠盖田田绿，繁华艳艳红。\n有容欺水国，无力舞秋风。\n缓步迎潘后，纤腰学楚宫。\n涉江人不见，两桨石城东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骊宫悼往","author":"陈襄","text":"凤辇情伤别，骊宫信不还。\n雨铃悲蜀道，金钿杳蓬山。\n玉笛凉州怨，梨园法部閒。\n西厢人未至，楼阁五云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李惟肖","author":"陈襄","text":"峨峨神岳吐灵襟，弱冠飞英翰墨林。\n楚国未登和氏璧，晋人惟重孔家金。\n文高千丈云霞彩，赋敌三都鼓吹音。\n圣代已招岩穴士，傅生他日定为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄远","author":"陈襄","text":"飞鹊翩翩暮欲栖，楚天新月射璇题。\n袖中已灭三年字，心曲惟通一点犀。\n步障影迷金谷路，桃花香隔武陵溪。\n瑶华好折无人寄，肠断江楼百尺梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢三井山祷雨二首 其二","author":"陈襄","text":"何年修庙貌，栋宇已摧残。\n牲币三时少，风泉四月寒。\n野僧多稌穥，古木有杉栾。\n深欲重修葺，蹉跎又解官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题福唐林迥南华洞","author":"陈襄","text":"梅岭峰前习隐亭，拂衣聊此玩真经。\n四时花木锦绣谷，十里江山水墨屏。\n猿鹤只愁空北岳，鹍鹏终待化南溟。\n知君不是荣轩冕，未忍锵锵去帝庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼古","author":"陈襄","text":"碧城楼角重凝眸，迤逦平原接古丘。\n七国战争人不见，六朝兴废水长流。\n远烟芳草年年事，明月清天夜夜愁。\n范蠡功成在何处，五湖波上一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒真祠","author":"陈襄","text":"海宫天路杳无涯，万里星津驻客槎。\n月下旌旗仙女仗，云中楼阁羽人家。\n鸾丝缓引霓裳曲，绮席深倾玉酒霞。\n阿母未归方朔去，碧桃何日重开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食日常州宴春园","author":"陈襄","text":"曲池收雨静无尘，结客留连半月春。\n洞里桃花青叶嫩，墙头杏火绿烟新。\n风光冉冉非前日，物色依依似故人。\n官满又归延阁去，忍将诗酒负佳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游南塔","author":"陈襄","text":"今日游南塔，愁还不自胜。\n年华催鬒发，身计忆岩棱。\n道业惭诸子，根源畏老僧。\n何当论去就，细问得龟朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登雄州南门偶书呈知府张皇城","author":"陈襄","text":"城如银瓮万兵环，怅望孤城野蓼间。\n池面绿阴通易水，楼头青霭见狼山。\n渔舟掩映江南浦，使驿差池古北关。\n雅爱六韬名将在，塞垣无事虎貔閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"慈圣光献太皇后挽词二首 其二","author":"陈襄","text":"庆寿蟠桃晓雾昏，忽闻笳鼓咽都门。\n宫闱有范遗文母，社稷无忧付圣孙。\n四海心丧同祖妣，一封手诏易陵园。\n君王孝感凌穹昊，未尽东朝欲报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"慈圣光献太皇后挽词二首 其一","author":"陈襄","text":"天开华德嗣音徽，尝拥真人御殿闱。\n万国母仪坤积载，两朝圣嗣日光辉。\n羞笾忽弃参差荇，宝匣空馀浣濯衣。\n从此昭陵原上路，又添遗老泣皇妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]