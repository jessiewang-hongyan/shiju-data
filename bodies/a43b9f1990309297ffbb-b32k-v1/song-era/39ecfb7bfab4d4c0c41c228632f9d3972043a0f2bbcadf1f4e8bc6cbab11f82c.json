[{"title":"四十二叔祖母刘氏太孺人挽词","author":"杨万里","text":"夫人自七十，有母尚期颐。\n不遣千山讣，犹应一病迟。\n孝留天下口，身立女中师。\n到得君羹美，翻令颍谷悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月八日尝新荔子","author":"杨万里","text":"一点胭脂染蒂旁，忽然红遍绿衣裳。\n紫琼骨骼丁香瘦，白雪肌肤午暑凉。\n掌上冰丸那忍触，樽前风味独难忘。\n老饕要啖三百颗，却怕甘寒冻断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月十七日侍立集英殿观进士唱名","author":"杨万里","text":"殿上胪传第一声，殿前拭目万人惊。\n名登龙虎黄金榜，人在烟霄白玉京。\n香满乾坤书一卷，风吹鬓发雪千茎。\n旧时脱却银袍处，还望清光侍集英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月五日车驾朝献景灵宫省前迎驾起居口号","author":"杨万里","text":"凤辇云行露未销，鸾旗风动柳相高。\n晴雷出地传清跸，霁日吹红染御袍。\n喜见天颜浮玉藻，归从原庙荐樱桃。\n小臣再得瞻黄伞，两鬓星星不满搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月四日午初出浙东界入信州永丰界","author":"杨万里","text":"外面千峰合，中间一径通。\n日光自摇水，天静本无风。\n村酒渟春绿，林花倦午红。\n莫欺山堠子，知我入江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四更发青阳县西五里柯家店","author":"杨万里","text":"轿中万兀路千萦，死尽村鸡无一鸣。\n落月正明知未晓，暗泉甚远只闻声。\n自缘客子行来早，岂是秋天不肯明。\n午热未来先下店，却将昼睡补宵征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圣上闵雨遍祷未应下诏避殿减膳感叹赋之","author":"杨万里","text":"夏旱焚如复入秋，圣皇避殿减琼羞。\n数峰北峙云垂合，一阵西风雨又休。\n逐日望霓穿却眼，何时倒海作奔流。\n诸贤袖有为霖手，不泻天瓢洗主忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圣恩增秩进职致仕感恩述怀","author":"杨万里","text":"雨露丝纶下玉宸，问天乞得个闲身。\n一生无恨长多感，三请归休恰四春。\n手板抽还大丞相，安车悬示后来人。\n从今万八百场醉，忽自称冤五柳巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁桥小渡","author":"杨万里","text":"桥坏仍泥滑，舟横隔水呼。\n岸头危径窄，轿子莫人扶。\n午漏相将里，秋阳未肯无。\n明知近前店，暗觉展脩途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平贼班师明发潮州","author":"杨万里","text":"不是潢池赤白囊，何缘杖屦到潮阳。\n官军已扫狐兔窟，归路莫孤山水乡。\n便去罗浮参玉局，更登浴日折扶桑。\n还家儿女搜行李，满袖云烟雪月香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归舟大雪中入运河过万家湖","author":"杨万里","text":"雪漫水面淡模糊，酿出羔儿酒一壶。\n已被膻腴翳醽醁，更添牛乳点春酥。\n销金帐下有此否，药玉船中不用酤。\n忽见琼缸清彻底，蒲萄一色万家湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申元日立春题道山堂前梅花","author":"杨万里","text":"今年元日不孤来，带领新春一并回。\n夜雨初添石渠水，东风先入道山梅。\n不妨数朵且微破，未要十分都尽开。\n江路野香元自好，阿谁移取种蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未至安乐坊隔林望见霜铿岭两峰特奇","author":"杨万里","text":"天知老子厌凡山，别放潜瑰伏宝看。\n一行横林遮岭脚，两峰如笋出云端。\n举头瞥见还惊遁，到骨清奇特地寒。\n彼此相遭有缘法，悔将嗔喜触巑岏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未到丹徒二十里间见石翁石婆","author":"杨万里","text":"诏许诗人江海游，丹徒初到晋徐州。\n炉边旸谷日长昼，盏底醉乡天不秋。\n六代兴亡何处问，一生奔走几时休。\n石翁石媪霜前笑，管得南朝陵墓愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十九日五更诣天庆观谢雪闻都下尺雪旬日而毗陵三四微雪而已","author":"杨万里","text":"元宵风物又阑残，闭阁何曾出一看。\n尚觉烛光欺病眼，旋添衣著试春寒。\n中都尺雪逾旬许，此地飞花逐片乾。\n不待珠宫香火了，海风吹上紫金盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉盘盂","author":"杨万里","text":"旁招近侍自江都，两岁何曾见国姝。\n看尽满栏红芍药，只消一朵玉盘盂。\n水精淡白非真色，珠璧空明得似无。\n欲比此花无可比，且云冰骨雪肌肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田路泥行","author":"杨万里","text":"路是新泥作，泥逢积雨滂。\n如缘大鲇脊，更绕九羊肠。\n前店看殊近，行人觉转长。\n商量避五岭，辛苦恰相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白沙买船晚至严州","author":"杨万里","text":"重雾疑朝雨，斜阳竟晚晴。\n万山江外尽，一塔岭尖明。\n舟小宁嫌窄，途长已倦行。\n子陵台下水，未酌意先清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石湾雨作得巩帅采若书约观灯","author":"杨万里","text":"昨暮颠风浪打头，那知今日得安流。\n元宵不为游人好，细雨先供客子愁。\n病骨支离妨酒盏，诗仙招唤试灯毬。\n书生薄命多磨折，乐事良辰判却休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石榴","author":"杨万里","text":"深著红蓝染暑裳，琢成纹玳敌秋霜。\n半含笑里清冰齿，忽绽吟边古锦囊。\n雾縠作房珠作骨，水精为醴玉为浆。\n刘郎不为文园渴，何苦星槎远取将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春后一日和张功父园梅未花之韵","author":"杨万里","text":"前夕三更月落时，东风已动万花知。\n江梅端合先交割，春色如何未探支。\n只欠梁溪冰柱句，追还和靖暗香诗。\n张家剩有葱根指，不把琼酥滴一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春前一夕二首 其一","author":"杨万里","text":"春忽明朝是，冬将半夜非。\n年华只不住，客子未能归。\n微霰疏还密，寒檐滴又稀。\n撚须真浪苦，呵笔更成挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春前一夕二首 其二","author":"杨万里","text":"腊尽春还好，朝暄暮复寒。\n雨晴终日异，衣著一冬难。\n生菜知无分，残梅不用看。\n本凭书遣睡，转更睡相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春新晴","author":"杨万里","text":"宿云送腊晓仍开，日动江光度竹来。\n春到更晴谁不喜，时迁不道老相催。\n山村敢惜身犹远，边地应怜战未回。\n春鸟岂知人意绪，新声只欲劝衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"节日新晴归自天庆","author":"杨万里","text":"初日明雁腹，酸风迎马头。\n如何一雨过，添却满城秋。\n楼观色俱喜，槐榆影独愁。\n节中公事少，吏散得吾休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦中红碧一联","author":"杨万里","text":"喜教儿联句，那知是梦中。\n天窥波底碧，日抹树梢红。\n觉后念何说，意间难强通。\n元来一夜雪，明晓散晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲良见和再和谢焉四首 其四","author":"杨万里","text":"岂不为寮久，兹焉独愈亲。\n卜居如不近，同志竟何因。\n山鸟频招饮，江花解笑人。\n风颠仍雨急，枉却一年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲良见和再和谢焉四首 其三","author":"杨万里","text":"健论开仍阖，清规高更寒。\n抗章胡未报，忧世可能宽。\n收用今宁晚，飞鶱尚会看。\n自怜千虑短，所愿一枝安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲良见和再和谢焉四首 其二","author":"杨万里","text":"谁谓陈三远，髯张下笔亲。\n夫何此意合，恐有宿生因。\n我岂慵开眼，年来寡见人。\n更烦彫好句，割取楚江春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲良见和再和谢焉四首 其一","author":"杨万里","text":"未惜诗脾苦，端令鬼胆寒。\n吾才三鼓竭，君思九江宽。\n作者今犹古，灯前捲又看。\n不辞须撚断，只苦句难安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日","author":"杨万里","text":"休日稀公事，炎天废故书。\n未须搔白首，留取试新梳。\n不是平生懒，何缘作计疏。\n闲携小儿女，桥上看芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再观十里塘捕鱼有叹","author":"杨万里","text":"渔者都星散，那知不是真。\n忽然重举网，何许有逃鳞。\n暗漉泥中玉，光跳日下银。\n江湖无避处，而况野塘滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过常州","author":"杨万里","text":"淮浦回春舫，荆溪又早炊。\n向来迎客处，还似迓侬时。\n父老今馀几，山川别后奇。\n旧游休再至，再至只成悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和","author":"杨万里","text":"三月阴晴顷刻分，晚来非午午非晨。\n闭门细草新蒲雨，过眼飞花落絮春。\n顾我江湖钓竿客，识君台阁步云人。\n柯山不患无人作，便合留中作近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和袁起岩韵","author":"杨万里","text":"一岁驩声沸此宵，游人丽服正飘飘。\n病夫未暇砖引玉，恶语翻成李报瑶。\n天遣素娥提雪月，江涵公子更风标。\n君家道是关门卧，却有新诗来见撩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和谢朱叔止机宜投赠奖及南海集之句","author":"杨万里","text":"重阳风雨不全篇，春草池塘岂满编。\n好句谁言较多少，古人信手斲方圆。\n自惭下下中中语，只合休休莫莫传。\n珍重银钩挥玉唾，竟无瑶报只空然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和错综其韵","author":"杨万里","text":"家书希到恐缘遥，岂有全无雁拂霄。\n屈指大刀违破镜，负渠缩项及长腰。\n何当竹外扁舟去，趁取梅梢未雪消。\n赖有可人同舍客，破愁得句似参寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冲雪送陆子静","author":"杨万里","text":"猛落还中歇，疏飞忽骤繁。\n平欺芦屋脊，偏护竹篱根。\n对面看童子，低头印手痕。\n销魂送行客，行客更销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘公佐亲家奉议挽词二首 其二","author":"杨万里","text":"一命华其老，诸昆半作官。\n相高仍孝悌，不但盛衣冠。\n近别那云诀，临丧独忍看。\n心知公不恨，我自泪难乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘公佐亲家奉议挽词二首 其一","author":"杨万里","text":"已病身犹健，云瘳讣却闻。\n告存非不寿，有子更能文。\n嗟我何多难，丧亲又哭君。\n两家两翁好，作么并丘坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘世臣先生挽诗","author":"杨万里","text":"策第仍为邑，于公未足论。\n眼中无佛国，户外即韩门。\n道大功非细，人亡德则存。\n西风寄双泪，吹到秀峰原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘平甫挽诗二首 其二","author":"杨万里","text":"忠显肩双庙，屏山箓二程。\n岭寒松节苦，坛暖杏花明。\n君也孤传业，天乎独短生。\n子孙无一物，故纸付渠耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘平甫挽诗二首 其一","author":"杨万里","text":"忠孝元家法，经纶岂懒心。\n日边迟信息，霞外且山林。\n风月诗天巧，乾坤酒陆沉。\n一生欠半面，五字寄哀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘季澄投赠新诗次韵为谢","author":"杨万里","text":"君操笔耒启新畬，耕遍西溪万卷馀。\n藜杖芒鞋来得得，柳风花雨政疏疏。\n是家人物孙如祖，惊代诗文我爱渠。\n努力收科无早晚，不须灯下独长嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同三馆饯王恭父监丞分韵予得何字","author":"杨万里","text":"去岁从游泛绿波，西湖今日又新荷。\n生来长是欢悰少，老去更堪离别多。\n客里送君留不住，尊前为我饮无何。\n休休万事付一醉，为报骊驹未要歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同王见可刘子年循南溪度西桥登天柱冈望东山二首 其二","author":"杨万里","text":"偶因闲步散顽麻，倦唤胡床小歇些。\n飞上山头人似鹤，回看溪畔路如蛇。\n云烟极目知何处，松竹为门是我家。\n下得山来饥更渴，也无麦饭也无茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同王见可刘子年循南溪度西桥登天柱冈望东山二首 其一","author":"杨万里","text":"亲交久别忽相从，饭罢相将拄瘦筇。\n深涧小桥聊驻步，胡床羽扇对西风。\n水声流入肝脾里，日影轻遮云气中。\n玉润即看朝玉阙，山居独自卧山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同刘季游登天柱冈四首 其一","author":"杨万里","text":"两只胡床小憩些，一枝筇杖拄倾斜。\n烟云惨淡天将雪，风日荒寒梅未花。\n人去客来酤酒市，鸡鸣犬吠野人家。\n清游不用忙归去，强管行程是暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李簿养直登秋屏","author":"杨万里","text":"大范今无寺，秋屏故有基。\n看山非不好，吊古却成悲。\n行役真何苦，同来也未迟。\n题诗只恶语，差胜不题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后一月再宿城外野店夙兴入城谒益公二首 其二","author":"杨万里","text":"归途未信欲斜阳，只怪行人影转长。\n松寿已高犹绿发，枫年方少更红裳。\n秋光便是天金谷，画本偷归我锦囊。\n只怨冲寒叹行役，青鞋布袜却芬香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后一月再宿城外野店夙兴入城谒益公二首 其一","author":"杨万里","text":"吹灯览镜又匆匆，乌帽新时白鬓空。\n残月忙追晓星上，飞霜先到轿窗中。\n如何五鼓寒十倍，不肯半分饶一翁。\n到得火轮相暖热，山霏特地碧曚昽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后圃杏花","author":"杨万里","text":"小树手初种，当年花便稠。\n拣枝那忍折，绕径祗成愁。\n淡了犹红在，留渠肯住不。\n无端万银竹，判却一春休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后圃秋步","author":"杨万里","text":"夏箑秋新妒，暄窗冷早侵。\n病葵萱未悟，落果草偏深。\n老矣曾荣望，归欤更懒心。\n此冠弹与挂，若个不山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回望黄巢矶之险心悸久之","author":"杨万里","text":"夜云到晓不教收，初日微明又却休。\n雨为岸花新洗面，水撩江草只摇头。\n千篙百棹力都竭，十里九矶船正愁。\n若到峡中应更险，却思峡外是安流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多稼亭前两槛芍药红白对开二百朵","author":"杨万里","text":"红红白白定谁先，袅袅娉娉各自妍。\n最是倚栏娇分外，却缘经雨意醒然。\n晚春早夏浑无伴，暖艳晴香政可怜。\n好为花王作花相，不应只遣侍甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延之寄诗觅道院集遣骑送呈和韵谢之","author":"杨万里","text":"与君鬓发总星星，诗句输君老更成。\n别去多时频梦见，夜来一雨又秋生。\n故人金石情犹在，赠我琼琚雪似清。\n谁把尤杨语同日，不教李杜独齐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题檐间蜘蛛","author":"杨万里","text":"屋角篱尖竹树阴，可怜用尽许机心。\n凝身不动如无物，顿网轻摇试有禽。\n丝贯日华明五色，戏随风舞忽千寻。\n看渠经纬来还去，忘却摧隤立不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早发建安寺过大栎虚","author":"杨万里","text":"睡美那能动，朝凉强作行。\n吾方犯星起，人已趁虚声。\n近路还如许，长途作么生。\n两亲今正老，三釜又须营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行见萤","author":"杨万里","text":"浅草时双起，深丛忽独明。\n情知晓月淡，意欲照人行。\n扇扑高无奈，风斜半欲横。\n书帷吾已懒，不拟著囊盛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早炊高店","author":"杨万里","text":"过雨溪山十倍明，乍晴风日一番清。\n白鸥池沼菰蒲影，红枣村虚鸡犬声。\n肉食坐曹良愧死，囊衣行部亦劳生。\n不堪有七今成九，伧父年来老更伧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早炊童家店","author":"杨万里","text":"长亭深处小亭奇，杂蘤粗蕤亦有姿。\n羊角豆缠松叶架，鸡冠花隔竹枪篱。\n不辞雨卧风餐里，可惜橙黄橘绿时。\n行到前头杨柳径，平分红白两莲池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早起","author":"杨万里","text":"不分老铃下，苦来惊我眠。\n要知甘寝处，最是欲明天。\n未了公家事，难销月俸钱。\n坐曹临讼罢，残烛正荧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早谒景灵宫","author":"杨万里","text":"夜雪犹飘天目峰，晓晴先暖太清宫。\n云翻孔雀金花碧，日射鸳鸯玉瓦红。\n百辟焚香官柳影，一鸦飞立殿檐东。\n仰瞻九圣联龙衮，万岁千秋对昊穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早朝垂拱殿晚出东省","author":"杨万里","text":"请外天难达，留中日不遑。\n乌啼金殿月，鹭集玉阶霜。\n出晚缘堂白，归时报录黄。\n来年六十一，六十鬓苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲江重阳","author":"杨万里","text":"烟描水写老秋容，岭外秋容也自浓。\n如见大宾新露菊，若歌商颂晓风松。\n插花醉照濂溪井，吹发慵登帽子峰。\n莫问明年衰与健，茱萸何处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]