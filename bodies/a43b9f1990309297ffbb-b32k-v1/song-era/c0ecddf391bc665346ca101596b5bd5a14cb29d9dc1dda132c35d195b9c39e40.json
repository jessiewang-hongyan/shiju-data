[{"title":"句 其三","author":"岑硕","text":"极目又芳草，捲帘非故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释祖瑃","text":"道无定乱，法离见知。\n言句相投，都无定义。\n自古龙门无宿客，至今鸟道绝行踪。\n欲会个中端的意，火里蝍蟟吞大虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释祖瑃","text":"雨下阶头湿，晴乾水不流。\n鸟巢沧海底，鱼跃石山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释祖瑃","text":"祗见石磊磊，不见玉落落。\n若见玉落落，方知道宽廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释闻一","text":"拈花微笑虚劳力，立雪齐腰枉用功。\n争似老卢无用处，却传衣钵振真风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释惟爽","text":"今朝六月旦，一年已过半。\n奉报参玄人，识取娘生面。\n娘生面，荐不荐。\n鹭鸶飞入碧波中，抖擞一团银绣线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"念禅师","text":"往复无际，动静一源。\n含有德以还空，越无私而迥出。\n昔日日，今日日，照无两明。\n昔日风，今日风，鼓无两动。\n昔日雨，今日雨，泽无两润。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂三首 其一","author":"念禅师","text":"元正一，古佛家风从此出。\n不劳向上用工夫，历劫何曾异今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂三首 其二","author":"念禅师","text":"元正二，寂寥冷淡无滋味。\n赵州相唤吃茶来，剔起眉毛须瞥地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂三首 其三","author":"念禅师","text":"元正三，上来稽首各和南。\n若问香山山里事，灵源一派碧如蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"什庵主","text":"我有一柄拂子，用处别无调度。\n有时挂在松枝，任他头垂角露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞法如禅师","author":"释圆极","text":"生铁面皮难凑泊，等閒举步动乾坤。\n戏拈十智同真话，不负黄龙嫡骨孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"张戒","text":"天不戴兮地不知，谁言南北与东西。\n身眠大海须弥枕，石笋抽条也大奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西归","author":"晁端中","text":"安得龙山潮，驾回马河水。\n水从楼前来，中有美人泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清芬阁","author":"臧询","text":"旧隐固潇洒，先生偏苦吟。\n俗情随水落，雅趣与山深。\n白日自朝暮，清风无古今。\n远孙簪组盛，终有爱闲心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏三首 其三","author":"米芾","text":"霜雪迷西极，云涛隔阆风。\n平生会心趣，都在净名中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐己巳岁维扬后斋为亳州使君蒋公仲永写二首 其一","author":"米芾","text":"水竹风清一梦苏，涛生月破紫瓯须。\n满堂爱客谈书画，且展宣王扇暍图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"焦山普济禅院碑赞","author":"米芾","text":"古佛留法度大心，种种威摄现胜相。\n大心众生摄威德，求度倾身及众宝。\n冥阳咸会精诚通，正法是归大缘集。\n我今稽首佛陀僧，永奠海山作津筏。\n我今稽首明应公，永护宝车炳威德。\n悉化大心依净住，一世咸如今佛日。\n三光不愆四序调，主圣臣忠载万亿。\n五谷蕃生土地肥，万灵常跻仁寿域。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"露筋之碑赞","author":"米芾","text":"王化焕猗盛江汉，叔运煽猗人伦乱。\n一德彦猗昭世典，情莫转猗天质善。\n楚泽湎猗云木偃，炜斯囝猗日星建。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天衣怀禅师碑赞","author":"米芾","text":"稽首归依无上尊，清净圆满千亿化。\n三身俱现立法祖，一法不立即如来。\n示现有渐缘慈悲，慈悲本不为佛祖。\n佛祖不立无归依，所以三身开后觉。\n寥寥千古古佛远，堂堂此身即古佛。\n众生不昧本来心，此是古佛行住处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟古 其一","author":"米芾","text":"青松劲挺姿，凌霄耻屈盘。\n种种出枝叶，牵连上松端。\n秋花起绛烟，旖旎云锦殷。\n不羞不自立，舒光射丸丸。\n柏见吐子效，鹤疑缩颈还。\n青松本无华，安得保岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟古 其二","author":"米芾","text":"龟鹤年寿齐，羽介所托殊。\n种种是灵物，相得忘形躯。\n鹤有冲霄心，龟厌曳尾居。\n以竹两附口，相将上云衢。\n报汝慎勿语，一语堕泥涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入境寄集贤林舍人","author":"米芾","text":"扬帆载月远相过，佳气葱葱听诵歌。\n路不拾遗知政肃，野多滞穗是时和。\n天分秋暑资吟兴，晴献溪山入醉哦。\n便捉蟾蜍共研墨，綵笺书尽剪江波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九会郡楼","author":"米芾","text":"山清气爽九秋天，黄菊红茱满泛船。\n千里结言宁有后，群贤毕至猥居前。\n杜郎闲客今焉是，谢守风流古所传。\n独把秋英缘底事，老来情味向诗偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和林公岘山之作","author":"米芾","text":"皎皎中天月，团团径千里。\n震泽乃一水，所占已过二。\n娑罗即岘山，谬云形大地。\n地惟东吴偏，山水古佳丽。\n中有皎皎人，琼衣玉为饵。\n位维列仙长，学与千年对。\n幽操人独处，迢迢愿招类。\n金飔带秋威，欻逐云樯至。\n朝隮舆驭飙，暮返光浮袂。\n云盲有风驱，蟾餮有刀利。\n亭亭太阴宫，无乃瞻星气。\n兴深夷险一，理洞轩裳伪。\n纷纷夸俗劳，坦坦忘怀易。\n浩浩将我行，蠢蠢须公起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王涣之彦舟","author":"米芾","text":"集英春殿鸣鞘歇，神武天临光下澈。\n鸿胪初唱第一声，白面王郎年十八。\n神武乐育天下造，不使敲抨使传道。\n衣锦东南第一州，棘璧湖山两清照。\n襄阳野老渔竿客，不爱纷华爱泉石。\n相逢不约约无逆，舆握古书同岸帻。\n淫朋嬖党初相慕，濯发洒心求易虑。\n翩翩辽鹤云中侣，土苴尪鸱那一顾。\n迩来器业何深至，湛湛具区无底沚。\n可怜一点终不易，枉驾殷勤寻漫仕。\n漫仕平生四方走，多与英才并肩肘。\n少有俳辞能骂鬼，老学鸱夷漫存口。\n一官聊具三径资，取舍殊涂莫回首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为政","author":"米芾","text":"美人为政本忘机，服药求仙事不违。\n叶县已泥丹灶毕，瀛洲当伴赤松归。\n先师有诀神将助，大圣无心火自飞。\n九转但能生羽翼，双凫忽去定何依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏成呈司谏台坐","author":"米芾","text":"我思岳麓抱黄阁，飞泉元在天半落。\n石鲸吐出湔一里，赤日雾起阴纷薄。\n我曾坐石浸足眠，肘项抵水洗背肩。\n客时效我病欲死，一夜转筋著艾燃。\n如今病渴拥炉坐，安得缩却三十年。\n呜呼安得缩却三十年，重往坐石浸足眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之苕溪戏作呈诸友 其一","author":"米芾","text":"松竹留因夏，溪山去为秋。\n久赓白雪咏，更度采菱讴。\n缕玉鲈堆案，团金橘满洲。\n水宫无限景，载与谢公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之苕溪戏作呈诸友 其二","author":"米芾","text":"半岁依脩竹，三时看好花。\n懒倾惠泉酒，点尽壑源茶。\n主席多同好，群峰伴不哗。\n朝来还蠹简，便起故巢嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之苕溪戏作呈诸友 其三","author":"米芾","text":"好懒难辞友，知穷岂念通。\n贫非理生拙，病觉养心功。\n小圃能留客，青冥不厌鸿。\n秋帆寻贺老，载酒过江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之苕溪戏作呈诸友 其四","author":"米芾","text":"仕倦成流落，游频惯转蓬。\n热来随意住，凉至逐缘东。\n入境亲疏集，他乡彼此同。\n暖衣兼饱食，但觉愧梁鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之苕溪戏作呈诸友 其五","author":"米芾","text":"旅食缘交住，浮家为兴来。\n句留荆水话，襟抱卞峰开。\n过剡如寻戴，游梁定赋枚。\n渔歌堪画处，又有鲁公陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之苕溪戏作呈诸友 其六","author":"米芾","text":"密友从春拆，红薇过夏荣。\n团枝殊自得，顾我若含情。\n漫有兰随色，宁无石对声。\n却怜皎皎月，依旧满船行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拜中岳命作 其一","author":"米芾","text":"云水心常结，风尘面久卢。\n重寻钓鳌客，初入选仙图。\n鼠雀真官耗，龙蛇与众俱。\n却怀闲禄厚，不敢著潜夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拜中岳命作 其二","author":"米芾","text":"常贫须漫仕，闲禄是身荣。\n不托先生第，终成俗吏名。\n重缄议法口，静洗看山睛。\n夷惠中何有，图书老此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谨以鄙诗送提举通直使江西","author":"米芾","text":"三吴有丈夫，气欲吞海水。\n开口论世事，借箸对天子。\n瑞节高如松，一岁几繁使。\n秋水浮湘月，樽酒屡觏止。\n言别不可攀，寥虚看云驶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋山","author":"米芾","text":"淡墨秋林画远天，暮霞还照紫添烟。\n故人好在重携手，不到平山漫五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"穰侯出关","author":"米芾","text":"穰侯去国缓驱车，蔡泽还来取范雎。\n恶客只应真可厌，怪他汉相馆邱虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋登海岱楼作","author":"米芾","text":"目穷淮海两如银，万道虹光育蚌珍。\n天上若无修月户，桂枝撑损向西轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壮观","author":"米芾","text":"君谟登壮观，要我赋新诗。\n鬓逐年光老，词缘大作奇。\n江山一世断，风雅六朝卑。\n对酒劝不饮，操怀谁与知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵魏见寄","author":"米芾","text":"山椒卜筑瞰江波，千里常怀楚制荷。\n旧怜俊气閒羁马，老厌奴书不玩鹅。\n真逸岂因明主弃，圣时长和野民歌。\n一自扣舷惊夏统，洛川云物至今多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈建州觉民 其一","author":"米芾","text":"七年乌帽抗黄尘，昼锦归来世又新。\n若过武夷山下看，人间不太敝精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈建州觉民 其二","author":"米芾","text":"白头何慕久京华，静洗黄尘眼界花。\n万宝精神在风月，好诗追取不须赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"收张僧繇天王上有薛稷题阎二物乐老处元直取得又收景涣问礼图亦六朝画珊瑚一枝","author":"米芾","text":"三枝朱草出金沙，来自天支节相家。\n当日蒙恩预名表，愧无五色笔头花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一生","author":"米芾","text":"一生吏案发人狂，重入承明马齿长。\n书画不贤仓庾氏，便于赁舍植秋芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张长史今岁仍得见于越上长史遂出此展之可爱成佳物也主者宝之","author":"米芾","text":"吴人善砧理，恶楮化为美。\n其他亦仿此，第未知之耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬山甫","author":"米芾","text":"每登鉴远楼，下视皇天荡。\n思挹落落人，凭栏揽万象。\n忽逢西浦士，谈彩何萧旷。\n养成谷口名，行见青藜杖。\n山色且淡浓，沤鹭翩下上。\n渔舟何者子，伫目看烟浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过姑孰作","author":"米芾","text":"下舆照涧数星星，一世还如隔世经。\n不见山东李十二，青山山色只青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇太后挽辞 其一","author":"米芾","text":"馀庆源真相，求贤佐裕陵。\n知几捲箔早，戡变叱龙升。\n静德群邪震，清心后世矜。\n大恩知欲报，圣孝已踰曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇太后挽辞 其二","author":"米芾","text":"温厚同光献，刚廉法宝慈。\n拥扶乐推圣，照彻托公欺。\n南纪归忠魄，东朝足素规。\n仁明存旧幄，常似补天时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 龟山寺晚钟","author":"米芾","text":"龟峰高耸接云楼，撞月钟声吼铁牛。\n一百八声俱听彻，夜行犹自不知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 五塔寺归云","author":"米芾","text":"塔边云影任高低，閒逐清风自在飞。\n四海望遥人久渴，不成霖雨又空归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 瑞岩庵清眺","author":"米芾","text":"西山月落楚天低，不放红尘点翠微。\n鹤唳一声松露滴，水晶寒湿道人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 清风山闻笛","author":"米芾","text":"铁笛谁吹一曲哀，清风约我上层台。\n悠扬正到堪听处，怕惹閒愁却下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 八仙台招隐","author":"米芾","text":"山径重重锁绿苔，松花曾见几番开。\n群仙费尽招呼力，那得休官一个来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 杏花园春昼","author":"米芾","text":"风轻云淡午天春，花外游人载酒樽。\n不是山屏遮隔断，牧童错指是孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 玻瓈泉浸月","author":"米芾","text":"半山亭下老苔钱，凿破玻瓈引碧泉。\n一片玉蟾留不住，夜深飞入镜中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 会景亭陈迹","author":"米芾","text":"自是韶光不耐秋，水光山色一时休。\n细将瓦砾分明看，片片飞来落叶愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都梁十景诗 宝接山落照","author":"米芾","text":"怪石累累玉作堆，登临晚景更徘徊。\n夕阳无限堪停好，莫到奇山空自回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘露寺","author":"米芾","text":"六代萧萧木叶稀，楼高北固落残晖。\n两州城郭青烟起，千里江山白鹭飞。\n海近云涛惊夜梦，天低月露湿秋衣。\n使君肯负时平乐，长倒金钟尽醉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏","author":"米芾","text":"弦歌兴罢拂衣还，弃米何尝有俸钱。\n恩自大钧能逐物，只应访药是优贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阊门舟中戏作呈伯原志东 其一","author":"米芾","text":"蘋风忽起吹舟悍，雨打图书藏裹乱。\n阊门咫尺不安流，何况盟津与江汉。\n非无轻楫并长槔，逆风流水适相遭。\n须臾风回水流顺，星宿浮槎问月高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阊门舟中戏作呈伯原志东 其二","author":"米芾","text":"吴王故苑古长洲，潮汐池边一伫留。\n秀蕙芳兰无处所，荒莞丛苇满清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音岩","author":"米芾","text":"秦驱禹凿已寥寥，却为高人得姓焦。\n鲍饵有时邀楚钓，海云常觉护山樵。\n岩多阴雾龙藏角，虹絓苍林玉露臕。\n浊气不侵灵贶下，方坛曾驻紫清飙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贞娘墓歌","author":"米芾","text":"何不学仙冢累累，白杨西郭阴风悲。\n虎邱一叩贞娘墓，薜荔援墙委兰露。\n千岁蒙茸几树花，夜飘鬼火晓啼鸦。\n向怜挟瑟弹清月，犹忆吹箫乘彩霞。\n吴阊少年往来道，黛蛾钗燕谁能好。\n酒滴春云梦不消，泉声幽咽钟声老。\n陌上行游缓缓归，昨日红颜今日非。\n东望阖闾穿葬处，玉凫将化湛卢飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不集南山","author":"米芾","text":"山翁茗艼葛彊随，庭下青春鸾雀飞。\n幕府惯为方外客，风前懒易道家衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弈棋图歌","author":"米芾","text":"神仙缥缈何年别，忽此逢迎山石裂。\n前溪练瀑派玉帘，更后云林雾痕缺。\n聚头磕额方外人，担肩抱蟾骨法新。\n棋枰对弈环座看，谁信樵斧忘青春。\n我今发雪三千丈，尚要昆崙撑顶上。\n炉心且养九转丹，拂却铢衣记无恙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙团歌","author":"米芾","text":"瀛帅谢公之所惠，大如车轮轻如纸。\n磨而试之墨过漆，元非本约重违意，寒雀比之立憔悴。\n道宁万一归于彼，不督芙蓉乃恕耳。\n三木模研理固异，耿墨比此天与地。\n开匣付介惊欲坠，惜之不得几下泪。\n君匣■州便可碎，只留承晏使执侍。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]