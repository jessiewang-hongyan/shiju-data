[{"title":"句","author":"陆节","text":"翠琰苔封韩令句，古祠巫降伏波灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书壁","author":"陆圭","text":"昔年曾住海三山，日月宫中数往还。\n无事引他天女笑，谪来为吏向人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤林寺","author":"陆秀夫","text":"岁月未可尽，朝昏屡不眠。\n窗前多古木，床上半残编。\n放犊饮溪水，助僧耕种田。\n寺门久断扫，分食愧农贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陆秀夫","text":"曾闻海上铁斗胆，犹见云中金甲神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方仙翁点易图","author":"陆宗亮","text":"云锁瑶扉童未起，树摇凉露鹤初还。\n曲肱道士清溪水，心在羲皇未画前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁中允宰剡","author":"陆经","text":"尘土官曹几处閒，今君得邑好开颜。\n落帆直向剡溪口，入境先登天姥山。\n鱼鸟半和风俗处，云霞多杂簿书閒。\n雪晴须去寻安道，不作经宵兴尽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"化成岩","author":"陆经","text":"交臂寻幽岁已残，瘦藤枯石重跻攀。\n忽逢晴洞龙开室，冷瞰寒溪玉绕山。\n猿鸟窥人知旧识，藤萝引径入无间。\n游车自向红尘去，日暮老僧催闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泛秀水","author":"陆经","text":"落日进扁舟，沿回碧玉流。\n未能追白鸟，贪共数游鯈。\n翠壁玲珑倒，青天表里浮。\n谁湔世间热，洒出洞庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"震山岩","author":"陆经","text":"稍变春罗色，还追云壑游。\n俯探青玉窟，傍挹翠绡流。\n九夏日车冷，四时龙气浮。\n隐沦今不见，钓叟浪垂钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷潭","author":"陆经","text":"山郭五里馀，气象忽异色。\n蛟龙尝此蟠，潭水至今黑。\n变化验莫穷，白昼起霹雳。\n山形抱江来，怪石莫倾侧。\n有寺出其间，户牖立丹壁。\n微云垂鉴中，彩色画不得。\n小阁才数弓，吐纳半江碧。\n日光涵游鱼，到底如不隔。\n老竹风萧萧，长根擘青石。\n送声寄哀弦，往往动魂魄。\n载酒同遨游，逢奇得搜索。\n形体相与忘，山林信吾适。\n乃知人世间，舍此固怵迫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陆经","text":"薄有田园归去好，苦无官况莫来休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎潭","author":"陆若济","text":"崖悬怯吾顾，潭空沁我心。\n匪斯涉游趣，敬慎识官箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴安乳洞","author":"陆诜","text":"深沈三洞启真都，万乳千葩状绝殊。\n驰驿方朝金阙去，涤尘来饮碧琳腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭看放水","author":"陆垕","text":"泉声飞出闸，委折绿阴间。\n此地原无暑，多时不入山。\n草攲疑石坠，水定见鱼还。\n难得同龟鹤，游吟半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陆彦远","text":"虽贫未肯气如霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盈川旧县","author":"陆律","text":"兹地舟行数，怀人思惘然。\n盈川经此日，流水自唐年。\n废邑丛春草，荒山入暮烟。\n昔贤不可作，开笥读遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盈川渡","author":"陆律","text":"青草湖头合，舟行向晚天。\n疏灯孤枕宿，细雨片帆悬。\n雁下平沙荻，猿啼独树烟。\n风尘随去住，乡思倍凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七岁作","author":"陈轸","text":"昔时家住海三山，日月宫中屡往还。\n无事引来天女笑，谪来为吏在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠真行大师","author":"陈轸","text":"语录传来久，所明机妙深。\n霜天七宝月，禅夕一真心。\n只有道为證，更无尘可侵。\n前溪鸥出没，谁自感浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"陆卿","text":"名山长表冠东南，一柱屹然天与参。\n玉府从来通六六，金扃宁竟锁三三。\n千岩深处标驯虎，万乘当时幸秣骖。\n抚掌酌泉观舞翠，清忠□咏□高谈。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奚宰春风楼即事","author":"陆埈","text":"恍然楹桷架虚空，意象经营九仞功。\n三载笑谈杯酒里，一时人物画图中。\n金兰托契从今始，玉烛迎和与众同。\n却笑楚台雕篆客，强生分别诧雄风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送奚宰二首 其二","author":"陆埈","text":"失学儿俱懒，师资点化开。\n砭针瘳痼疾，膏馥起枯荄。\n授□方知绪，从游奈溯洄。\n武城门下士，应许厕澹台。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送奚宰二首 其一","author":"陆埈","text":"茂宰慈祥意，三年只似初。\n折腰宁而米，掣肘固难书。\n机静波浮鸟，刑疏网漏鱼。\n终然清议在，褒字到公车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑梨","author":"陆埈","text":"灰貌凝清古，霜津溢澹甜。\n面嫌汤后白，心慰邑中黔。\n美实种寒谷，珍尝近御奁。\n彼姝徒冠玉，争得似无盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题厅壁","author":"陆起","text":"驱鸡政府本来无，刚被人呼邑大夫。\n及至五更侵早起，算来却是被鸡驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梅杂兴","author":"陆梦发","text":"人间谁是识梅真，弃实求花后世心。\n何似只如三代日，分甘投老万山深。\n寄来陆凯浑多事，说到林逋亦费吟。\n耿耿知音唯月在，无言相看古犹今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乡校颂 其四","author":"陆淞","text":"其迁者初，其新者中。\n肄业传道，有师有宗，繄李侯之功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乡校颂 其二","author":"陆淞","text":"维校在乡，示民有防。\n入孝出悌，为忠为良，斯邦家之光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乡校颂 其五","author":"陆淞","text":"乐只君子，孰后孰先。\n显有嘉闻，于斯万年，维大夫之贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乡校颂 其一","author":"陆淞","text":"维乡有校，示民有知。\n教始豫逊，迪于训彝，维风化是裨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乡校颂 其三","author":"陆淞","text":"乡校有基，如德弗亏。\n刘侯迁之，魏侯新之，李侯能成之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 和李汉老","author":"陆淞","text":"黄橙紫蟹，映金壶潋滟，新醅浮绿。\n共赏西楼今夜月，极目云无一粟。\n挥麈高谈，倚栏长啸，下视鳞鳞屋。\n轰然何处，瑞龙声喷蕲竹。\n何况露白风清，银河澈汉，仿佛如悬瀑。\n此景古今如有价，岂惜明珠千斛。\n灏气盈襟，冷风入袖，只欲骑鸿鹄。\n广寒宫殿，看人颜似冰玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙","author":"陆淞","text":"脸霞红印枕。\n睡觉来、冠儿还是不整。\n屏间麝煤冷。\n但眉峰压翠，泪珠弹粉。\n堂深昼永。\n燕交飞、风帘露井。\n恨无人，与说相思，近日带围宽尽。\n重省。\n残灯朱幌，淡月纱窗，那时风景。\n阳台路迥。\n云雨梦，便无准。\n待归来，先指花梢教看，却把心期细问。\n问因循、过了青春，怎生意稳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一齿动摇已久然馀皆坚甚戏作","author":"陆游","text":"病齿元知不更全，漂浮杌?已三年。\n一朝正使终辞去，大嚼犹能尽彘肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一壶歌五首 其四","author":"陆游","text":"耻从岳牧立尧庭，况见商周战血腥。\n携得一壶闲处饮，不曾苦醉不曾醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一壶歌五首 其一","author":"陆游","text":"悠悠日月没根株，常在人间醉一壶。\n倾倒欲空还潋滟，不曾教化不曾沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一壶歌五首 其五","author":"陆游","text":"长安市上醉春风，乱插繁花满帽红。\n看尽人间兴废事，不曾富贵不曾穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一壶歌五首 其三","author":"陆游","text":"自从轩昊到隋唐，几见中原作战场。\n三十万年如电掣，不曾记得不曾忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一壶歌五首 其二","author":"陆游","text":"先生醉后即高歌，千古英雄奈我何。\n花底一壶天所破，不曾饮尽不曾多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一钱","author":"陆游","text":"万事纷纷不足论，满庭枯草闭柴门。\n一钱留得终羞涩，持买餦餭引福孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑九月三日晚久雨骤晴西南新月如玉钩重阳以八月置闰菊花粲然满园喜甚作一绝记之","author":"陆游","text":"初三新月见如期，重九黄花又及时。\n俱是人间称心事，典衣一醉更何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑重五二首 其一","author":"陆游","text":"盘中共解青菰粽，衰甚犹簪艾一枝。\n寂寞废诗仍止酒，今年真负此佳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑重五二首 其二","author":"陆游","text":"飞棹中流救屈平，俚歌宁复楚遗声。\n危冠更在门楣上，但觉萧敷与艾荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十一日午睡梦泛江风涛甚壮觉而有赋","author":"陆游","text":"梦中不记适何邦，风饱蒲帆入大江。\n久矣眼中无此快，蹴天雪浪溅船窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十四夜观月","author":"陆游","text":"不复微云滓太清，浩然风露欲三更。\n开帘一寄平生快，万顷空江著月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日试雾中僧所赠茶","author":"陆游","text":"少逢重九事豪华，南陌雕鞍拥钿车。\n今日蜀州生白发，瓦炉独试雾中茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十二日折菊","author":"陆游","text":"黄菊芬芳绝世奇，重阳错把配萸枝。\n开迟愈见凌霜操，堪笑儿童道过时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十四日夜鸡初鸣梦一故人相语曰我为莲华博士盖镜湖新置官也我且去矣君能暂为之乎月得酒千壶亦不恶也既觉惘然作绝句记之","author":"陆游","text":"白首归修汗简书，每因囊粟戏侏儒。\n不知月给千壶酒，得似莲华博士无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月晦日作四首 其四","author":"陆游","text":"炊烟漠漠衡门寂，寒日昏昏倦鸟还。\n数树丹枫映苍桧，天工解作范宽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月晦日作四首 其一","author":"陆游","text":"菊枝倾倒不成丛，桐叶凋零已半空。\n自是老来多感慨，不应萧瑟为秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月晦日作四首 其二","author":"陆游","text":"山路清寒近探梅，振衣高处兴悠哉。\n飞鸿杳杳江天阔，一片愁从万里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月晦日作四首 其三","author":"陆游","text":"锦城谁与寄音尘，望断秋江六六鳞。\n正使倾家供曲蘖，定知不解醉愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二友","author":"陆游","text":"剩储名酒待梅开，净扫虚窗候月来。\n老子幽居得二友，人间万事信悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二日梦中作","author":"陆游","text":"零落蔷薇委道傍，更堪微雨渍残香。\n象床玉尺人何在，肠断新裁锦一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月四日作","author":"陆游","text":"早春风力已轻柔，瓦雪消残玉半沟。\n飞蝶鸣鸠俱得意，东风应笑我闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入城舟中作","author":"陆游","text":"棹边蘸岸挼蓝水，篷外横空破墨山。\n更著滩头一行鹭，此身真在画图间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入城寓榻开元","author":"陆游","text":"羸僮倦马困长堤，借榻禅房日未西。\n熟睡觉来闲隐几，庭楸阴转乳鸦啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月五日夜半起饮酒作草书数纸","author":"陆游","text":"有漏神仙有发僧，碧幮攲枕对秋灯。\n忽然起索三升酒，飒飒蛟龙入剡藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月三日过升仙桥作三首 其一","author":"陆游","text":"早过升仙不暇炊，桥边买饼疗朝饥。\n纷纭满座谁能识，大似新丰独酌时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月三日过升仙桥作三首 其二","author":"陆游","text":"熨手金鞭天马驹，冰河雪谷笑谈无。\n只言燕赵多奇士，岂必书生尽腐儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月三日过升仙桥作三首 其三","author":"陆游","text":"桥边沙水绿蒲老，原上烟芜黄犊闲。\n老子真成兴不浅，凭鞍归梦绕家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月四日风雨大作二首 其二","author":"陆游","text":"僵卧孤村不自哀，尚思为国戍轮台。\n夜阑卧听风吹雨，铁马冰河入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月四日风雨大作二首 其一","author":"陆游","text":"风卷江湖雨闇村，四山声作海涛翻。\n溪柴火软蛮毡暖，我与狸奴不出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月九日枕上作","author":"陆游","text":"卧听百舌语帘栊，已是新春不是冬。\n堪叹老来如许病，正令无病亦无悰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二日夜梦与客并马行黄河上憩于古驿二首 其一","author":"陆游","text":"并辔徐驱百里中，云开太华翠摩空。\n是间合有神灵在，七十馀年堕犬戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二日夜梦与客并马行黄河上憩于古驿二首 其二","author":"陆游","text":"河滨古驿辟重门，雉兔纷纷黍酒浑。\n吾辈岂应徒醉饱，会倾东海洗中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二日夜梦游沈氏园亭二首 其一","author":"陆游","text":"路近城南已怕行，沈家园里更伤情。\n香穿客袖梅花在，绿蘸寺桥春水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二日夜梦游沈氏园亭二首 其二","author":"陆游","text":"城南小陌又逢春，只见梅花不见人。\n玉骨久成泉下土，墨痕犹锁壁间尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十日暮小雪即止二首 其二","author":"陆游","text":"夜来一雪苦匆匆，千里浓云忽扫空。\n换得月明良不恶，未须过计虑蝗虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十日暮小雪即止二首 其一","author":"陆游","text":"夜来急雪打船窗，今夜推窗月满江。\n堪恨无情一枝橹，水禽惊起不成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月三日夜桥上看月","author":"陆游","text":"常时新月有无间，今夕清晖抵半环。\n柳外桥高最堪望，凭阑目送下西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月九日","author":"陆游","text":"酒开瓮面扑人香，菊折霜馀满把黄。\n我是化工君信否，放迟一月作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十八日夜鸡初鸣时梦与数女仙遇其一作诗示予颇哀怨如人间语惟末句稍异予戏之曰若无此句不可为神仙矣其一从傍戒曰汝当勿忘此规作诗者甚有愧色予颇悔之既觉赋两绝句以解嘲 其一","author":"陆游","text":"玉姝眉黛翠连娟，弄翰闲题小碧笺。\n人世愁多无著处，故应分与蕊宫仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]