[{"title":"次韵答任仲微","author":"黄庭坚","text":"伯氏文章足起家，雁行唯我乏芳华。\n不堪黄绶腰铜印，只合清江把钓车。\n缩项鱼肥炊稻饭，扶头酒熟卧芦花。\n吴儿何敢当伦比，或有离骚似景差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答李端叔","author":"黄庭坚","text":"喜接高谈若饮冰，风骚清兴坐来增。\n重寻伐木君何厚，欲赋骊驹我未能。\n山影北来浮汇泽，松行东望际钟陵。\n相期烂醉西楼月，缓带凭栏濯郁蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答柳通叟问舍求田之诗","author":"黄庭坚","text":"少日心期转谬悠，蛾眉见妒且障羞。\n但令有妇如康子，安用生儿似仲谋。\n横笛牛羊归晚径，卷帘瓜芋熟西畴。\n功名可致犹回首，何况功名不可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答蒲元礼病起","author":"黄庭坚","text":"暖律温风何处饶，莫言先上绿杨条。\n梢头红糁杏花发，瓮面浮蛆酒齐销。\n吏事困人如缚虎，君诗入手似闻韶。\n直须扶病营春事，老味难将少壮调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赏梅","author":"黄庭坚","text":"安知宋玉在邻墙，笑立春晴照粉光。\n淡薄似能知我意，幽闲元不为人芳。\n微风拂掠生春思，小雨廉纤洗暗妆。\n只恐浓葩委泥土，谁令解合返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵裴仲谋同年","author":"黄庭坚","text":"交盖春风汝水边，客床相对卧僧毡。\n舞阳去叶才百里，贱子与公皆少年。\n白发齐生如有种，青山好去坐无钱。\n烟沙篁竹江南岸，输与鸬鹚取次眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵德孺惠贶秋字之句","author":"黄庭坚","text":"少日才华接贵游，老来忠义气横秋。\n未应白发如霜草，不见丹砂似箭头。\n顾我今成丧家狗，期君早作济川舟。\n汉家宗庙英灵在，定是寒儒浪自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵德孺感兴二首 其二","author":"黄庭坚","text":"眼前尝废忘，事往更追寻。\n爱酒陶元亮，著书王仲任。\n寒蒲虽有节，枯木已无心。\n客至还须饮，逢欢起自斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵德孺感兴二首 其一","author":"黄庭坚","text":"于此吾忘我，从谁尺直寻。\n事来千万种，人有两三心。\n自守藩篱小，犹能井臼任。\n过时虽不采，吾与菊花斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵德孺新居病起","author":"黄庭坚","text":"潭潭经略府，寂寂闭门居。\n京洛圣贤宅，江湖鱼鳖潴。\n官如一梦觉，话胜十年书。\n稍喜过从近，扶筇不驾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池口风雨留三日","author":"黄庭坚","text":"孤城三日风吹雨，小市人家只菜蔬。\n水远山长双属玉，身閒心苦一舂锄。\n翁从旁舍来收网，我适临渊不羡鱼。\n俛仰之间已陈迹，暮窗归了读残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红蕉洞独宿","author":"黄庭坚","text":"南床高卧读逍遥，真感生来不易销。\n枕落梦魂飞蛱蝶，灯残风雨送芭蕉。\n永怀玉树埋尘土，何异蒙鸠挂苇苕。\n衣笐妆台蛛结网，可怜无以永今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自巴陵略平江临湘入通城无日不雨至黄龙奉谒清禅师继而晚晴邂逅禅客戴道纯款语作长句呈道纯","author":"黄庭坚","text":"山行十日雨沾衣，幕阜峰前对落晖。\n野水自添田水满，晴鸠却唤雨鸠归。\n灵源大士人天眼，双塔老师诸佛机。\n白发苍颜重到此，问君还是昔人非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观王主簿家酴醾","author":"黄庭坚","text":"肌肤冰雪薰沉水，百草千花莫比芳。\n露湿何郎试汤饼，日烘荀令炷炉香。\n风流彻骨成春酒，梦寐宜人入枕囊。\n输与能诗王主簿，瑶台影里据胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句：诗二句","author":"苏轼","text":"叩槛出鱼鼋，诗成一笑粲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"讲武台南有感","author":"黄庭坚","text":"月明犹在搭衣竿，晓踏台南路屈盘。\n驺子雨中先马去，村童烟外倚墙看。\n鸦啼宰木秋风急，鹭立渔船野水乾。\n花似去年堪折赠，插花人去泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过方城寻七叔祖旧题","author":"黄庭坚","text":"壮气南山若可排，今为野马与尘埃。\n清谈落笔一万字，白眼举觞三百杯。\n周鼎不酬康瓠价，豫章元是栋梁材。\n眷然挥涕方城路，冠盖当年向此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过平舆怀李子先时在并州","author":"黄庭坚","text":"前日幽人佐吏曹，我行堤草认青袍。\n心随汝水春波动，兴与并门夜月高。\n世上岂无千里马，人中难得九方皋。\n酒船鱼网归来是，花落故溪深一篙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯氏到济南寄诗颇言太守居有湖山之胜同韵和","author":"黄庭坚","text":"西来黄犬传佳句，知是陆机思陆云。\n历下楼台追把酒，舅家宾客厌论文。\n山椒欲雨好云气，湖面逆风生水纹。\n想得争棋飞鸟上，行人不见只听闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯父祖善耆老好学于所居紫阳溪后小马鞍山为放隐斋远寄诗句意欲庭坚和之幸师友同赋率尔上呈","author":"黄庭坚","text":"樵入千岩静，松含万籁寒。\n儿童给行李，藜蓧对衣冠。\n小槛聊防虎，时来即解鞍。\n阿翁吹笛罢，怀昔泪相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何主簿萧斋郎赠诗思家戏和答之","author":"黄庭坚","text":"善吟闺怨断人肠，二妙风流不可当。\n傅粉未归啼玉箸，吹笙无伴涩银篁。\n睡添乡梦客床冷，瘦尽腰围衣带长。\n天性少情诗亦少，羡他萧史与何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何造诚作浩然堂陈义甚高然颇喜度世飞升之说筑屋饭方士愿乘六气游天地间故作浩然词二章赠之 其二","author":"黄庭坚","text":"万物浮沈共我家，清明心水遍河沙。\n无钩狂象听人语，露地白牛看月斜。\n小雨呼儿蓺桃李，疏帘帏客转琵琶。\n尘尘三昧开门户，不用丹田养素霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何造诚作浩然堂陈义甚高然颇喜度世飞升之说筑屋饭方士愿乘六气游天地间故作浩然词二章赠之 其一","author":"黄庭坚","text":"公欲轻身上紫霞，琼爢玉馔厌豪奢。\n百年世路同朝菌，九钥天关守夜叉。\n霜桧左纽空白鹿，金炉同契漫丹砂。\n要令心地閒如水，万物浮沈共我家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初至叶县","author":"黄庭坚","text":"白鹤去寻王子晋，真龙得慕沈诸梁。\n千年往事如飞鸟，一日倾愁对夕阳。\n遗老能名唐郡邑，断碑犹是晋文章。\n浮云不作苞桑计，只有荒山意绪长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初望淮山","author":"黄庭坚","text":"风裘雪帽别家林，紫燕黄鹂已夏深。\n三釜古人干禄意，一年慈母望归心。\n劳生逆旅何休息，病眼看山力不禁。\n想见夕阳三径里，乱蝉嘶罢柳阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈马粹老范德孺","author":"黄庭坚","text":"颍上相逢杏始青，尔来瓜垄有新耕。\n四时为岁已中半，万物得秋将老成。\n日永清风摇麈尾，夜阑飞雹落棋枰。\n两厅未觉过从数，政以顽疏累友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈王明复陈季张","author":"黄庭坚","text":"倦客西来厌马鞍，为予休辔小长安。\n陈遵投辖情何厚，王粲登楼兴未阑。\n雪压群山晴后白，月临千里夜深寒。\n少留待我同归去，洛下林中斫钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋夫人挽词","author":"黄庭坚","text":"往岁涂宫暗碧纱，倾城出祖路人嗟。\n松楠峰下迁华寝，雪月光中咽晓笳。\n有子今为二千石，同州才数两三家。\n儿孙满地厥衣举，不见归时桃李华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"希仲招饮李都尉北园","author":"黄庭坚","text":"晓踏骅骝傍古墙，北园同系紫游缰。\n主人情厚杯无算，别馆春深日正长。\n杨柳阴斜移坐晚，酴醾花暗染衣香。\n夜深恐触金吾禁，走马天街趁夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张仲谟许送河鲤未至戏督以诗","author":"黄庭坚","text":"浮蛆琰琰动春醅，张仲临津许鲙材。\n盐豉欲催莼菜熟，霜鳞未贯柳条来。\n日晴鱼网应曾晒，风软河冰必暂开。\n莫误晓窗占食指，仍须持取报章回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李濠州挽词二首 其二","author":"黄庭坚","text":"礼数最优徐孺子，风流不减谢宣城。\n那知此别成千古，未信斯言隔九京。\n落日松楸阴隧道，西风箫鼓送铭旌。\n善人报施今如此，陇水长寒呜咽声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李濠州挽词二首 其一","author":"黄庭坚","text":"循吏功名两汉中，平生风义最雍容。\n鱼游濠上方云乐，鵩在承尘忽告凶。\n挂剑自知吾已许，脱骖不为涕无从。\n百年穷达都归尽，淮水空围墓上松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日奉寄君庸主簿","author":"黄庭坚","text":"花发社公雨，阴寒殊未开。\n初闻燕子语，似报玉人来。\n遮眼便书册，挑聋欺酒杯。\n传声习主簿，勤为拨春醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀江亭","author":"黄庭坚","text":"因循不到此江头，匹马黄埃三十秋。\n旧舍只今人共老，清波常与月分流。\n羡君潇洒成佳趣，感我凄凉念旧游。\n沽酒买鱼终不负，何时相与泛扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月访同年李夷伯子真于河上子真以诗谢次韵","author":"黄庭坚","text":"十年不见犹如此，未觉斯人叹滞留。\n白璧明珠多按剑，浊泾清渭要同流。\n日晴花色自深浅，风软鸟声相应酬。\n谈笑一樽非俗物，对公无地可言愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈氏园咏竹","author":"黄庭坚","text":"不问主人来看竹，小溪风物似家林。\n春供馈妇几番笋，夏与行人百亩阴。\n直气虽冲云汉上，高材终恐斧斤寻。\n截竿可举北溟钓，欲赠溪翁谁姓任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈季张有蜀芙蓉长饮客至开辄剪去作诗戏之","author":"黄庭坚","text":"剪花莫学韩中令，投辖惟闻陈孟公。\n客兴不孤春竹叶，年华全属拒霜丛。\n玄子蹙迫三秋尽，青女摧残一夜空。\n著意留连好风景，非君谁作主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈荣绪惠示之字韵诗推奖过实非所敢当辄次高韵三首 其三","author":"黄庭坚","text":"十家有忠信，江夏可无之。\n政苦寄卖友，忽闻衡说诗。\n饥蒙青䭀饭，寒赠紫陀尼。\n酬报矜难巧，深惭陆与皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈荣绪惠示之字韵诗推奖过实非所敢当辄次高韵三首 其二","author":"黄庭坚","text":"太丘胸量阔，一苇莫杭之。\n万事不挂眼，四愁犹有诗。\n状閒聊阘茸，心洁似毗尼。\n早晚同舟去，烟波学子皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈荣绪惠示之字韵诗推奖过实非所敢当辄次高韵三首 其一","author":"黄庭坚","text":"纷纷不可耐，君子有忧之。\n鞅掌诚庄语，贤劳似怨诗。\n颓波阅砥柱，浊水得摩尼。\n知我无枝叶，刳心只有皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈留市隐","author":"黄庭坚","text":"市井怀珠玉，往来人未逢。\n乘肩娇小女，邂逅此生同。\n养性霜刀在，阅人清镜空。\n时时能举酒，弹镊送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮韩三家醉后始知夜雨","author":"黄庭坚","text":"醉卧人家久未曾，偶然樽俎对青灯。\n兵厨欲罄浮蛆瓮，馈妇初供醒酒冰。\n只见眼前人似月，岂知帘外雨如绳。\n浮云不负青春色，未觉新诗减杜陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父钓亭","author":"黄庭坚","text":"槛外溪风拂面凉，四围春草自锄荒。\n陆沈霜发为钩直，柳贯锦鳞缘饵香。\n影落华亭千尺月，梦通岐下六州王。\n麒麟卧笑功名骨，不道山林日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呻吟斋睡起五首呈世弼 其四","author":"黄庭坚","text":"已把社公酒，春寒那得严。\n厌听鸿啄雪，喜有燕穿帘。\n璞玉深藏器，囊锥立见尖。\n儿时爱谈道，今日口如钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呻吟斋睡起五首呈世弼 其一","author":"黄庭坚","text":"棐几坐清昼，博山凝妙香。\n兰芽依客土，柳色过邻墙。\n巷僻过从少，官閒气味长。\n江南一枕梦，高卧听鸣桹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呻吟斋睡起五首呈世弼 其三","author":"黄庭坚","text":"疏食吾犹饱，曲肱哦古今。\n酒倾因好事，弦绝为知音。\n妒檗长春木，争巢喧暮禽。\n长怀阮校尉，北望首阳岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呻吟斋睡起五首呈世弼 其五","author":"黄庭坚","text":"墙下蓬蒿地，儿童课剪除。\n蔓莴随分种，杞菊未须锄。\n河水传烽火，交州报捷书。\n无能落閒处，惭愧饱春蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呻吟斋睡起五首呈世弼 其二","author":"黄庭坚","text":"学省非簿领，卧痾常闭关。\n雨馀楼阁静，风晚鸟乌还。\n赏逐四时改，心安一味閒。\n古人虽已往，不废仰高山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和中玉使君晚秋开天宁节道场","author":"黄庭坚","text":"江南江北尽云沙，车骑东来风旆斜。\n倒影楼台开紫府，得霜篱落剩黄花。\n钓溪筑野收多士，航海梯山共一家。\n想见星坛祝尧寿，步虚声里静无哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和文潜舟中所题","author":"黄庭坚","text":"云横疑有路，天远欲无门。\n信矣江山美，怀哉谴逐魂。\n长波空?记，佳句洗眵昏。\n谁奈离愁得，村醪或可尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王明之雪","author":"黄庭坚","text":"金母紫皇开寿域，炼成天地一炉沙。\n千花乱发春无耐，万井交光月未斜。\n贫巷有人衣不纩，北窗惊我眼飞花。\n歌楼处处催沽酒，谁念寒生泣白华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和外舅夙兴三首 其三","author":"黄庭坚","text":"暑逐池莲尽，寒随塞雁来。\n衣裘虽得暖，狐貉正相哀。\n僧汲辘轳晓，车鸣关锁开。\n不因朝鼓起，来帙乱书堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和外舅夙兴三首 其二","author":"黄庭坚","text":"风烈僧鱼响，霜严郡角悲。\n短童疲洒扫，落叶故纷披。\n水冻食鲑少，瓮寒浮蚁迟。\n朝阳乌鸟乐，安稳托禅枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和外舅夙兴三首 其一","author":"黄庭坚","text":"瓜蔓已除垄，苔痕犹上墙。\n蓬蒿贪雨露，松竹见冰霜。\n卷幔天垂斗，披衣日在房。\n无诗叹不遇，千古一潜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吕秘丞","author":"黄庭坚","text":"北海樽中忘日月，南山雾里晦文章。\n清朝不上九卿列，白发归来三径荒。\n车辙马蹄疏市井，花光竹影照门墙。\n人间荣辱无来路，万顷风烟一草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和师厚郊居示里中诸君","author":"黄庭坚","text":"篱边黄菊关心事，窗外青山不世情。\n江橘千头供岁计，秋蛙一部洗朝酲。\n归鸿往燕竞时节，宿草新坟多友生。\n身后功名空自重，眼前樽酒未宜轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和师厚秋半时复官分司西都","author":"黄庭坚","text":"遥知得谢分西洛，无复肯弹冠上尘。\n园地除瓜犹入市，水田收秫未全贫。\n杜陵白发垂垂老，张翰黄花句句新。\n还与老农争坐席，青林同社赛田神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和师厚栽竹","author":"黄庭坚","text":"大隐在城市，此君真友生。\n根须辰日斸，笋要上番成。\n龙化葛陂去，凤吹阿阁鸣。\n草荒三径断，岁晚见交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张沙河招饮","author":"黄庭坚","text":"张侯耕稼不逢年，过午未炊儿女煎。\n腹里虽盈五车读，囊中能有几钱穿。\n况闻缊素尚黄葛，可怕雪花铺白毡。\n谁料丹徒布衣得，今朝忽有酒如川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李文伯暑时五首 其一 扇","author":"黄庭坚","text":"团扇如明月，动摇微风兴。\n屏去坐上热，袪逐盘中蝇。\n有用何提挈，无心分爱憎。\n炎炎虽可贵，弃置奈寒冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和知命招晁道夫叔侄","author":"黄庭坚","text":"过我诸公子，寂寥非世娱。\n茶须亲碾试，酒可倩行沽。\n日永乌皮几，窗寒竹火炉。\n不来寻翰墨，僮仆解吴歈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和庭诲苦雨不出","author":"黄庭坚","text":"端居广文舍，暑服似纯绵。\n绿竹尘蒙合，红榴日炙蔫。\n披襟风入幌，洒面雨连天。\n莫借角巾垫，勤来坐马鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和庭诲雨后","author":"黄庭坚","text":"小霁卧观书，凉轩夏簟舒。\n天青印鸟迹，云黑卷犀渠。\n新月来高树，清风转广除。\n雨师真解事，一为洗空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高仲本喜相见","author":"黄庭坚","text":"雨昏南浦曾相对，雪满荆州喜再逢。\n有子才如不羁马，知君心是后凋松。\n閒寻书册应多味，老傍人门似更慵。\n何日晴轩观笔砚，一樽相属要从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]