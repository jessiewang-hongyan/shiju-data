[{"title":"泊真州方山下","author":"吴龙翰","text":"烟冷隋宫草木秋，屏山分翠接江流。\n片云不隔长芦寺，夜半钟声敲客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵寓楼居","author":"吴龙翰","text":"楼中有酒客身閒，约住孤云共往还。\n摇落碧桃春欲去，倚阑无语看钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫人斜","author":"吴龙翰","text":"碧石重重锁墓门，兰膏点火照黄昏。\n春风几度生芳草，还似君王旧日恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词","author":"吴龙翰","text":"舞罢霓裳宝髻垂，桃花扇底暖风吹。\n夜深内殿重开宴，手撚灯花画翠眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜林和靖墓","author":"吴龙翰","text":"老鹤高飞入白云，空馀残照管孤坟。\n清风千古镇长在，见著梅花如见君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春山晚望","author":"吴龙翰","text":"模糊数叠屋前山，翠色欺凌诗鬓寒。\n啼鸟一声泥滑滑，晚钟春雨过林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书所见","author":"吴龙翰","text":"寒云漠漠暮天低，社鼓声中日欲西。\n隔岸垂杨遮酒店，风帘移影照寒溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日吴中","author":"吴龙翰","text":"照人芳树迟迟日，吹面垂杨拂拂风。\n客思一筇携不尽，鸟声多在落花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日松阴小憩","author":"吴龙翰","text":"瘦筇扶我过林端，无赖东风掠鬓寒。\n贪数青山不知去，松花吹满石棋盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春兴","author":"吴龙翰","text":"闻说春醪熟，提壶唤客尝。\n乾坤一酿瓮，花气百和香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜隔江望扬州城","author":"吴龙翰","text":"烟树芜城熨不开，夜深灯火照楼台。\n欲披紫绮过江去，月冷沧洲待鹤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊即事","author":"吴龙翰","text":"登临故故检春工，小立苍苔数落红。\n院宇人归春寂寂，秋千閒在月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚留淮上","author":"吴龙翰","text":"淮山历历春云澹，淮水汤汤夜月辉。\n此处杜鹃啼不到，江南行客未成归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚野步","author":"吴龙翰","text":"寻花篱下蝶牵引，酌酒林间鸟劝酬。\n山色不随春态老，笛声自起夕阳愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒","author":"吴龙翰","text":"二月漫漫雪满山，群芳空向雪中看。\n幽亭酌酒且沈醉，要为小园花餪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日绵溪","author":"吴龙翰","text":"万顷寒潭镜面平，数声征雁叫霜晴。\n满林落叶秋风老，山路黄昏人少行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋崖先生以红石见寄","author":"吴龙翰","text":"彤霞铄石玉晶荧，琢出羲之风字形。\n却著寒松苍石下，研烟传写相牛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓发姑孰城","author":"吴龙翰","text":"鹃啼惊梦敧春枕，花落迎风打晓窗。\n携杖搀先出城去，角声吹月堕寒江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓发黄池过宁国","author":"吴龙翰","text":"簇簇人烟两岸分，暂时挂搭此行程。\n一筇风月无拘束，又复挑诗到宛城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栽斑竹","author":"吴龙翰","text":"竹母初分种屋头，斑斑泪点带诗愁。\n他时看取成林玉，遥剪湘江一片愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浙江姚楼观水月","author":"吴龙翰","text":"翠滚玻璃万顷秋，长江又挂水晶毬。\n水光月色梅边客，今夜会盟江上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花四绝 其二 日","author":"吴龙翰","text":"醉脸潮红娇欲眠，玉幢移影盖婵娟。\n一奁晴色开明镜，暖熨金炉起碧烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花四绝 其三 风","author":"吴龙翰","text":"飒飒凉生水国秋，可怜无计解花愁。\n飘然一叶随流水，付与真人驾作舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花四绝 其四 雨","author":"吴龙翰","text":"寒声敲破玉琳琅，绾断鸳鸯双梦长。\n几斛明珠收不起，巧粘翡翠络红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花四绝 其一 露","author":"吴龙翰","text":"一机蜀锦著纱笼，不放纤尘到水宫。\n但觉晓寒金掌重，仙人危立白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读董卓传","author":"吴龙翰","text":"巨妖吐毒气如蒸，谁遣腥膻汉帝陵。\n烟断洛阳残火在，为他吹著点脐灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"婺源道中午憩 其一","author":"吴龙翰","text":"小息吟身古木阴，诗情羞涩锦囊轻。\n风烟不受人收拾，担阁行山半日程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"婺源道中午憩 其二","author":"吴龙翰","text":"满路黄尘人往还，黄尘点污几青山。\n便投山店睡过午，要放诗魂出世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登当涂凌歊台","author":"吴龙翰","text":"高台突兀玉千寻，尚想当年翠辇临。\n坐守夕阳移半塔，我吟未了让蝉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登严子陵钓台","author":"吴龙翰","text":"万乘从君脚底眠，客星便入史官占。\n东都基业随流水，今日斯台尚姓严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登采石望夫石","author":"吴龙翰","text":"良人戍楚竟蹉跎，极目天涯岁月多。\n赖有江流是知己，有声似和扊扅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登金陵钟山绝顶","author":"吴龙翰","text":"万仞钟山著屐登，中原今隔几崚嶒。\n自怜不及天边雁，岁逐春风到八陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其二","author":"吴龙翰","text":"楼间丹壁富藏书，误学相如卖子虚。\n何不买牛勤教子，邵平瓜地要人锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其九","author":"吴龙翰","text":"诸方参遍一枯藤，苦节期传夜半灯。\n弘景登楼持棒喝，不容人上第三层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其三","author":"吴龙翰","text":"觅得楼中一觉眠，将身化蝶入壶天。\n平生睡债何时足，春在梅花纸帐边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其六","author":"吴龙翰","text":"振衣千仞兴悠哉，一日看山十二回。\n胸次谁人有丘壑，便容携酒上楼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其四","author":"吴龙翰","text":"湖海真成万里游，寒风吹破黑貂裘。\n归来卧占楼千尺，梦落沧波明月舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其十","author":"吴龙翰","text":"偃月炉深紫气浮，红铅黑汞六丹头。\n梅翁欲挹浮丘诀，颛为黄山作此楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其七","author":"吴龙翰","text":"四山如画不胜奇，朝暮烟云都是诗。\n楼上吟声穿碧落，天公罚我鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其五","author":"吴龙翰","text":"汗漫相期欲控鲸，龟楼粗可寄閒身。\n天教吴猛亲常健，乞与商山九斛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其一","author":"吴龙翰","text":"茅斋悔著市廛间，长与青山面目悭。\n突兀小楼初结就，竹床石枕卧看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉禾书所见","author":"吴龙翰","text":"翠幕重重护晓寒，窗间金鸭篆烟残。\n芳情不采閒花草，独倚阑干看牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西湖画轴","author":"吴龙翰","text":"丹青谁写满轴莲，濯濯西施一段妍。\n汴水百年尘隔断，可无人作画图传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠诗客梅窗","author":"吴龙翰","text":"骚人行脚遍天涯，何处青山不是家。\n惆怅旧时云外鹤，结巢窗外守梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士","author":"吴龙翰","text":"万里烟霞侵鹤骨，九天风露注蝉尸。\n君看个人作诗苦，梅花细嚼当晨炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谒士","author":"吴龙翰","text":"一掬乡心寒似月，半生行迹过于云。\n春风满担诗千首，是处青山留得君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濯足五溪城","author":"吴龙翰","text":"东风吹水绿粼粼，小漱清寒入齿龈。\n万里流边濯双足，恐行五岭涴晴云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"繁昌道中","author":"吴龙翰","text":"江天日暖竹为舆，猎猎春风载此臞。\n凑入灞桥成一画，杨花吹雪糁吟须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子陵钓台","author":"吴龙翰","text":"峭壁千寻屹晓寒，何年人插钓鱼竿。\n烟霞不受衣冠涴，天地那如蓑笠宽。\n幸有同肩黄屋贵，不妨伸脚白云端。\n能令汉室亦增重，可作巢由一例看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未试监假道于严报谢使君","author":"吴龙翰","text":"秋试贤关掷雉卢，道经邻郡拜真儒。\n棠阴日暖鸟声隽，苔迹月明吏影臞。\n春野一犁今有犊，暮歌五裤昔无襦。\n片帆愿借吹嘘力，一舸清风不用租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内丹","author":"吴龙翰","text":"太极虚空亦有根，打开关捩是何人。\n丹田旋转乾坤橐，碧海循环日月轮。\n久矣我前曾有我，悠哉身外岂无身。\n分明好个通天窍，只要时人认得真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天目道中","author":"吴龙翰","text":"天目峰前小驻骖，长松笑道碧䰐鬖。\n客怀寂寞秋般淡，醉态朦胧午正酣。\n山色俨如严父面，鸟声还胜俗人谈。\n何年来此种芝术，乞与道人云一龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见王广文","author":"吴龙翰","text":"旅食京华不自谋，可堪典尽鹔鹴裘。\n一床风雨孤灯夜，千里江山两鬓秋。\n笑索寒梅吟苦句，醉拈秃笔扫穷愁。\n学人翻笑孙明复，强乞希明一点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见刘后村先生 其三","author":"吴龙翰","text":"雪碗冰瓯淬笔锋，篇篇琢出玉玲珑。\n鹤鸣远岫千林晓，鲸展洪涛万里雄。\n暮雪寒梅吟思外，春风芳草梦魂中。\n诗瓢行脚半天下，多谢先生棒喝功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见刘后村先生 其二","author":"吴龙翰","text":"玻璃万顷海天秋，相国如居天上头。\n锦帐围山丹荔熟，银梭织水子鱼游。\n地灵自古称多士，人物当今列上流。\n二季一翁家学在，湄洲即是蜀眉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见刘后村先生 其四","author":"吴龙翰","text":"骑却青鸾上禁林，岩岩声价重于金。\n花砖日转琼笺暖，莲烛星归玉漏沈。\n翰墨挈来三昧手，丝纶画出九重心。\n春风已筑沙堤路，天上虚皇属意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见刘后村先生 其一","author":"吴龙翰","text":"天禄臞仙后代孙，巍科几世属名门。\n千年绝学追先圣，四海真儒仰后村。\n直向天边扶日月，只从笔底转乾坤。\n年来诸老凋零尽，惟有灵光独自存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古岩寺","author":"吴龙翰","text":"古岩灵迹异，故故兀吟鞍。\n石溜溅棋湿，松风冱笛寒。\n露华僧衲重，曙色佛灯残。\n白社开何日，谈经上石坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"外丹","author":"吴龙翰","text":"手掇乾坤铛里煎，神仙肘后有书传。\n红铅黑汞一斤药，阳火阴符六百篇。\n金鼎自凝三素气，玉炉轻散九霞烟。\n玄霜糁入空虚腹，一息乘风上碧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归途绩溪界喜见十里岩","author":"吴龙翰","text":"策杖前溪去，吾乡此路分。\n雨磨山出色，风约水成文。\n归信凭秋雁，思亲望白云。\n碧岩今日见，快饮带微醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春次俞兄韵 其二","author":"吴龙翰","text":"多谢春风相此行，马蹄千里夕阳明。\n故人杨柳正年少，知己青山旧日情。\n思满天涯芳草远，望穷江际暮云生。\n同来佳客自不俗，相对松阴听瀑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春次俞兄韵 其一","author":"吴龙翰","text":"几日春愁不出行，园林又是了清明。\n春风桃李一场梦，夜月江山千古情。\n吟倚长松伺鹤到，坐临钓石看云生。\n此怀不解自拈出，谩语离骚入笛声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过泾邑水西县尹先伯祖尝为邑簿领耆儒有识者","author":"吴龙翰","text":"客里身无事，乘閒过水西。\n清波明白鹭，绿树带黄鹂。\n酤酒道旁饮，吟诗石上题。\n邑中逢故旧，坐定说环溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严郡谒乌龙庙遇打碑者","author":"吴龙翰","text":"何年故处士，灵魄此为家。\n古壁填苍藓，空庭隘落花。\n山坟穿去鹤，庙祭下饥鸦。\n巫祝打碑卖，神功播海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别厉制使","author":"吴龙翰","text":"何日林间理故书，客中岁月只蘧庐。\n籴粮半给梅花鹤，烧叶馀分雪后驴。\n蝶梦悠扬家国远，雁行零落弟兄疏。\n寒花到了自萧索，不是东风不管渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别吴中三年寄湖上一二知已","author":"吴龙翰","text":"麦秋天气觉清和，老尽春风庭下莎。\n晚月荒山啼蜀帝，夕阳高树咽齐娥。\n三年寒我沧波约，一夜思君白发多。\n世路不堪重著脚，相期何地理渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县尹先伯祖家观遗书","author":"吴龙翰","text":"嗟哉吾伯祖，文响玉珊珊。\n高折蟾宫桂，卑栖花县官。\n琴声流水尽，书卷白云寒。\n尚想伊吾夜，高楼几倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴越归秋晚","author":"吴龙翰","text":"湖海归来晚，园荒菊几丛。\n秋山吟骨瘦，霜叶醉颜红。\n吊影寒溪曲，怀人落月中。\n青灯滋味永，不用哭途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿乡衮讷斋先生 其二","author":"吴龙翰","text":"世态浮云无定形，先生绿野竟留情。\n讵知宝祐老臣在，又见金陵新法行。\n洛邑几时归赤舄，东山再起答苍生。\n不堪局面迟一著，愿祝薇垣星更明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿乡衮讷斋先生 其一","author":"吴龙翰","text":"华衮褒荣御墨鲜，堂堂剑佩在凌烟。\n十三相后功为最，五百年间遗有传。\n落落甘霖施后土，岩岩钜石补青天。\n太平有策安排了，浯水清风崖可镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿乡衮讷斋先生 其三","author":"吴龙翰","text":"当年河岳已储神，理乱分明关一身。\n瑞应麟书知孔子，恩光凤诰见庚申。\n世臣乔木苍苍日，驿使梅花岁岁春。\n笑指紫阳山作寿，会看重庆喜尤新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊富阳","author":"吴龙翰","text":"片帆东去一鸥轻，消得天公十日晴。\n新酒一尊诗几首，故乡千里月初更。\n烟收山翠揩摩净，风软江波熨贴平。\n苦是狂怀费消遣，船头吹笛到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚申冬寿秋崖先生","author":"吴龙翰","text":"瑞宿当年降世间，祁山深处著仙坛。\n梅开冰壑珊瑚瘦，崖耸晴空碧玉寒。\n清气胚成龟鹤相，丹田炼就虎龙蟠。\n待教须鬓浑如雪，恰写耆英与世看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊芜湖县","author":"吴龙翰","text":"古邑苍江曲，鳞鳞华屋横。\n酒楼歌妓集，渔市贩夫行。\n野阔云无势，江流月有声。\n桥边息诗担，谯鼓更分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]