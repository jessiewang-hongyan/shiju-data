[{"title":"次方诗境韵","author":"陈宓","text":"久别何人与砭肓，新诗见寄味偏长。\n求仙已得丹升鼎，凿石仍成玉作堂。\n暖日松筠香北牖，清风书卷散东床。\n静中剩得无穷味，笑看蜂衙早晚忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次仙溪陈侍郎韵寄题刘尚书二首 其二 真止","author":"陈宓","text":"利禄由来酒样醇，伊谁未醉解收身。\n须知泽畔独醒客，不顾墦间饱饫人。\n晋代风流多逸士，陶公名节号忠臣。\n筑堂景慕前贤行，饮水端能哜道真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次刘制干潜夫趣续谱韵","author":"陈宓","text":"浓阴尚想升平日，老干曾经五百年。\n商略正须凭众口，品题谁敢继先贤。\n素团比玉清仍润，繁颗如星艳欲然。\n天予瑰奇资赋咏，况当诗思似流泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次刘学录韵","author":"陈宓","text":"中年早透利名关，坐看孤云际海还。\n昼静架书偏悦目，秋凉庭树倍怡颜。\n不陪长者终朝诲，那得尘踪一日闲。\n我亦小园初种竹，请君来闯出篱斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次安溪赵簿云津阁韵 其一","author":"陈宓","text":"西来一派接天流，谁结危栏占上游。\n树蘸碧波元不暑，沙攒白鹭更宜秋。\n沉酣胜处方知味，濡滞穷山未拙谋。\n欲把君诗镵翠壁，声名长与此溪留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次延平郡文学宴新进士韵","author":"陈宓","text":"文章千丈吐寒芒，更要新登孔氏堂。\n讲学若能膻自至，致君端使凤来翔。\n衍山剑水多奇产，赤箭丹砂讵可当。\n自有名儒常辈出，莫将诗句诧钱郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李弘斋韵送任宰","author":"陈宓","text":"近日延平创小斋，四方佳友为朋来。\n虽为书上究馀味，更要心中绝点埃。\n健德千年期不已，高标万变讵能推。\n直须义利途中办，宁使饥肠屡隐雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次林司户清水岩韵","author":"陈宓","text":"祷雨当年百丈峰，森森夹径耸脩筇。\n甘霖尚想四垂合，清境无因一到重。\n仙伯遗纵参佛迹，王公新咏张军容。\n索诗尚及疏庸令，筳寸何堪击钜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次柯东海于安溪流惠亭","author":"陈宓","text":"少壮成何事，蹉跎鬓欲翁。\n尚馀朱墨日，可欠芰荷风。\n归鹭依山白，新蟾蘸酒红。\n晴空无点翳，秋气遥梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次泉守游郎中 其一","author":"陈宓","text":"七闽遍数刺桐州，自昔贤侯惠爱留。\n洛水桥新浑似昨，梅溪人诵不能休。\n近来善政称三最，相继清名照九秋。\n我别十年思一到，不知何日此心酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次储兄韵","author":"陈宓","text":"茗瓯吹积雪，薰鼎拨寒灰。\n觌面看脩竹，披襟映古槐。\n日长嗟侣少，风动喜朋来。\n共此林泉兴，生涯水一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次楼宗簿祷雨韵 其一","author":"陈宓","text":"君侯忧国念，食顷讵能忘。\n尽变庖厨馔，全销燕寝香。\n连朝成霭霭，中夜忽浪浪。\n坐想溪十曲，恩波似个长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次楼宗簿祷雨韵 其二","author":"陈宓","text":"旱气满南州，深贻旰食忧。\n蟹能升古井，龙敢卧深湫。\n德政真无愧，丰年信可求。\n野人无别慕，鼓腹事西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次潘丈韵与刘学录","author":"陈宓","text":"以彼月中桂，来娱地上仙。\n冲融胸内乐，摆落世间缘。\n人语春风里，秋归夕照边。\n主翁长静坐，不是学安然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江瑶柱","author":"陈宓","text":"江上分来三寸瑶，殷勤海若道寒潮。\n尽将马甲深深锁，好把鸾刀款款挑。\n榼酒怪来星不醉，杯羹元是雪难消。\n若将陈紫同时赏，饮罢身端在泬寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤泉","author":"陈宓","text":"洗垢清尘一派汤，瀹蔬溉稻却甘凉。\n难将人力营为胜，须信天工造化长。\n井小常时供鼎沸，泽多终岁遍山阳。\n我生几度经行此，可笑区区有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约刘学录同潘喻二丈集沧洲","author":"陈宓","text":"一年拟待中秋夕，连日频闻正午雷。\n天若有心开玉匣，月应无恨入金罍。\n素娥与我元无分，秀句凭君试为催。\n取出团圆盈天璧，不教留在白云堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约杨至之潘谦之登清水岩不果和潘韵","author":"陈宓","text":"春入溪山几许深，拟陪杖屦远追寻。\n千章古木都凝绿，百啭黄鹂尚好音。\n君有佳人同笑语，我怀拙患阻登临。\n移时伫立西塘上，有酒盈樽敢自斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西窗芭蕉","author":"陈宓","text":"青罗千丈拶窗排，玉树移从海底栽。\n夜半偏能延月住，暑深长是挹凉来。\n竹君似欠封侯骨，松老难当翰□□。\n□□仁皇群玉宴，诸贤一叶拜金杯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观凤池桥上梁","author":"陈宓","text":"溪自清如镜，官那束似羁。\n不因乘小舫，还得赋新诗。\n邑肇千家聚，梁成万世基。\n令惭无小补，刻石欲何词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过田家","author":"陈宓","text":"足迹抵西邻，耕桑力不贫。\n媪翁双鬓雪，儿女一卮春。\n水碓春残日，松棚香逼人。\n车中名利客，得似自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过黄源岭","author":"陈宓","text":"此是辞家第几程，道由剑岭出峥嵘。\n上穿密霭闻天语，下领浮云作雨行。\n千仞直从人面起，一尘不向马蹄生。\n虽惭仁智粗知乐，憩听疏松夹水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严州道中见月以祷雨不饮","author":"陈宓","text":"赤地三千里，离家四十程。\n岂无瓶可倒，忍对月仍明。\n在处嗟吁气，穷村鼓铎声。\n有神司下土，能不恻垂情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县治登梁和寄居余叔济韵 其一","author":"陈宓","text":"古县公庭二百春，聊因风雨一番新。\n恨无尺寸堪酬主，敢有丝毫更扰民。\n方叹闾阎惊脱水，却惭梁栋欲超尘。\n年丰俗美多馀暇，雁鹜行中看雀驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县治登梁和寄居余叔济韵 其二","author":"陈宓","text":"宾僚满座昔难知，尽是才当汉石渠。\n讼牒已资贤共次，茶瓯聊复话公馀。\n千村早见刀为犊，比屋仍看经荷锄。\n疏拙却便明月夜，小窗松竹谩观书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈江西赵仓及真帅","author":"陈宓","text":"雨雪成泥没膝深，暑风如灼转难禁。\n愿开周道平夷砥，更植甘棠蔽芾阴。\n少借缁黄多暇力，只捐燕飨有馀金。\n当年闽帅留遗迹，来往行人感至今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈章通判","author":"陈宓","text":"蚤岁曾从诸老游，温恭儒雅更风流。\n闽中善政皆堪纪，身外虚名底用求。\n满榼载春行乐处，长途未暑候如秋。\n经年每恨过从少，况是难为两月留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙寂院访梅","author":"陈宓","text":"山寒尽日少人知，调鼎风流却在兹。\n但得此君为益友，不嫌青女妒妍姿。\n应愁我辈来何晚，岂共春风别有私。\n不忍折枝飞减玉，留看小雨弄黄时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿大兄帅参开国","author":"陈宓","text":"黄陂不挠已称贤，况复胸中别有天。\n最好诞朝嘉节后，更斟寿酒菊花前。\n平生不作南金想，晚岁真成白璧全。\n退食琳宫怀补报，壶山早晚祝尧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崇清陈侍郎","author":"陈宓","text":"卫武当年解赋诗，若挥椽笔定应疲。\n先生名德都相似，馀事才能更过之。\n云岫图书供宴坐，沧浪风月足追随。\n久闲精力天教健，更看三为帝者师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿龚国太","author":"陈宓","text":"三朝十国锡封频，八帙华龄岁律新。\n膝下平分千里月，门中浑作一家春。\n已将相业传诸子，更喜闻孙早有人。\n岁挹壶山入壶斝，寿溪衮衮寿杯醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀郑文山","author":"陈宓","text":"早遂山林志，于今一代豪。\n平生唯质实，四海仰孤高。\n久欲问奇字，先令饷浊醪。\n相望廿里近，可笑自尘劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟游曾城阻风","author":"陈宓","text":"奉亲来此别湖山，九日先偷一日闲。\n四面平铺苍玉佩，远峰偏结碧螺鬟。\n一杯且奉慈颜喜，两载真成短鬓斑。\n珍重南风如有意，片帆留滞故相攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纳凉","author":"陈宓","text":"伫立金明候，清宵意豁然。\n暑风犹袭燕，秋意已通蝉。\n竹径不知夏，洼尊别有天。\n吾曹能办此，不愧晋林贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近三衢阻雨 其一","author":"陈宓","text":"行李初逢雨，朝来犹望晴。\n沾濡端及月，惯习自忘情。\n密霭村村暝，流泉处处明。\n更馀三百里，江满看舟行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近三衢阻雨 其二","author":"陈宓","text":"亭午还同晓，馀春祇见寒。\n不因阴雨窘，那识道途难。\n夹路峰峦隐，高田水潦漫。\n凭谁扫浮翳，杲杲出云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈遂乡有墅在枫亭扁曰廛山求诗寄之","author":"陈宓","text":"溪山镇日不离门，一市人家自寂喧。\n居士本非为素隐，小窗端合胜华轩。\n同时桃李惊开蚤，晚岁松篁喜独存。\n我最爱山思觅暇，袖琴来听玉潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮井","author":"陈宓","text":"饮井之清天下少，夷齐比德复如何。\n寒冰入口侵牙颊，甘露沾肠逐病痾。\n十里溉田成旱雨，一泓济渴胜天河。\n活人未遂平生志，酌此深知负愧多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到九座","author":"陈宓","text":"想像精蓝九叠前，青鞋今得踏云烟。\n霜边涧水多成玉，岭上人家半是仙。\n伏蟒千年无动意，老松何日不幽禅。\n可怜倚马思归客，有底区中未了缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到妙寂寺","author":"陈宓","text":"朝辞城市鬨，近寺向昏黄。\n步步贪山色，依依顾水光。\n群鱼犹出戏，归路倦高翔。\n正喜无人见，迎僧欲下堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和天台戴复古韵","author":"陈宓","text":"半生胸次著嵯峨，到得庐山鬓欲皤。\n列岫但蒙排闼入，一壶未许扣舷歌。\n清风六月犹嫌剩，明月三秋不厌多。\n拟向清朝新白鹿，结茅深处傍松坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方丞咏梅","author":"陈宓","text":"从来天道尚栽培，妙手仍能顷刻开。\n万壑千崖收腊去，三花两蕊唤春回。\n松筠早结同心友，桃李真堪后乘陪。\n调鼎工夫在朝夕，如何方向此中栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方机宜 其二","author":"陈宓","text":"绝顶樵翁总是仙，花红草绿自年年。\n琼楼玉宇成虚诞，盘石长松足醉眠。\n小窦偏能施雨泽，深崖常恐出云烟。\n游人合作宿山计，家在孤城返照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方机宜 其一","author":"陈宓","text":"侵晓同穿紫翠寒，轻云随步去仍还。\n谁言滨海无多地，著得擎天有底山。\n空阔望中愁目短，险巇历尽觉心顽。\n石田樵汲真堪絬，岂惜疏茅结一间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方宗教鼓山韵 其一","author":"陈宓","text":"胸次崔嵬绝点埃，山光玉色两佳哉。\n官闲却得身栖宿，岩迥惟闻鹤去来。\n定处华鲸催石磬，眼前茗碗伴炉灰。\n高情一出樊笼外，逸驾飘飘未拟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方宗教鼓山韵 其二","author":"陈宓","text":"盖世功名不染埃，清时尝见赋康哉。\n灵源已作千年观，圣相仍曾一日来。\n补练元功天上石，燮调和气琯中灰。\n崖间尝有数行墨，留与游人抵暮回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方漕孚若游瀑布","author":"陈宓","text":"一派能令玉作山，千年那复更愁乾。\n初疑云阵漏寒月，乍似鸥群趁急湍。\n领客适当晴正好，结亭偏惬暑来看。\n知君欲奉潘舆乐，千乘何如此地安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王丞迈 其二","author":"陈宓","text":"蚤慕登门宠，今欣后乘陪。\n穷山逢岁晚，佳节看阳来。\n地煖犹闻桂，冬深未见梅。\n高斋公事少，暇日足徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王丞迈 其一","author":"陈宓","text":"宰县殊无补，初心复负书。\n极知通一艺，苦恨乏三徐。\n立志期乾健，流年叹月诸。\n已拚双鬓白，未必古人如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东海韵","author":"陈宓","text":"炎空欲暮赤云横，何日秋风可抗衡。\n尽捲疏帘通水气，静听密罟得鱼声。\n山开旷野天全见，人倚平栏夜自明。\n衙鼓三通归路近，歌眠犹念竹阴清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东海题云松岭书堂","author":"陈宓","text":"百尺长松带碧萝，杜溪深锁蒋洋坡。\n一堂来作群山主，四牖分盛好景多。\n书卷不须扃户读，诗翁频许杖藜过。\n一生心事何难足，更与前湾月半蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘制干潜夫","author":"陈宓","text":"制阃宣劳已再期，胸中方寸了无私。\n谁言今日平齐策，不似当年代蔡时。\n马上陈琳能草檄，幕中韩愈更长诗。\n休嫌衡岳官曹冷，文士何尝系职司。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和许月湖上元游东禅","author":"陈宓","text":"寺迥伦无事，山幽剩得春。\n天机元不断，岁律自成新。\n禅定才朝暮，劳生几屈伸。\n诗成人未散，月得染庭筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨秋止酒韵","author":"陈宓","text":"快意诚甘疢，折肱知妙方。\n饭馀书可读，茗过味偏长。\n南浦烟云密，东皋耒耜忙。\n青春深几许，明日又流觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卓省元韵","author":"陈宓","text":"六十堂堂一讲师，平生矻矻鬓成丝。\n紫阳道坦行来熟，洛水源深向上窥。\n身岂匏瓜常不食，味耽昌歜有同谁。\n旁人莫笑饥肠苦，回颊甘香胜似饴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林堂长韵 其一","author":"陈宓","text":"近学陶公小辟窗，境闲地迥壮心降。\n临阶曲水清堪照，隔槛奇峰勇莫扛。\n静对每嗟人尚独，清标长想玉难双。\n新诗忽自龙门坠，纸上波涛更击撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林堂长韵 其二","author":"陈宓","text":"山斋尽日激清湍，未许人间俗客看。\n捣药暇时来舞鹤，诵书声里答鸣鸾。\n千年正统源流远，三圣遗书简牍残。\n顾我何年陪讲席，未应剑水旧盟寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和枢上人韵","author":"陈宓","text":"禅心独理灯无尽，曲论怀私物不齐。\n拱木已严千岁冢，狂澜难决万金堤。\n古今蔽显神功相，天地韬藏裕眼迷。\n会看清风明月夕，云间端有鹤来栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范茂才","author":"陈宓","text":"小小平栏容易攀，栏边杨柳又成班。\n是非荣辱不到地，南北东西都见山。\n但解心宽长有趣，不因境胜始能闲。\n从今与子安心诀，外物由来总不关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范省元","author":"陈宓","text":"太守方将畎亩行，先烦乡彦探春耕。\n人登高岭如梯峻，雨足深川作掌平。\n发廪正须凭义举，蠲租已觉负仁声。\n要知贫富乘除理，施尽囷仓却解盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑自正长官","author":"陈宓","text":"读书尚友古人贤，一日逢君胜一年。\n可叹常时成独学，喜于今日得师传。\n身居吏鞅供尘底，心在风云沂水边。\n虽有溪山供一笑，不容忙里寄诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑潜夫游山韵","author":"陈宓","text":"千仞巑岏本自平，只应苍步欠徐行。\n回崖净拭连城璧，廉石高罗武库兵。\n风易生云常澒洞，泉能作雨转甘清。\n重游须待九秋后，已约猿猱管送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和度支兄咏竹","author":"陈宓","text":"园竹今逾盛，壶山与逊青。\n锦绷千稚子，雷甲万夫丁。\n声入秋风远，凉生午日亭。\n栽培从此力，雨露正沾零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柯东海梅花之什","author":"陈宓","text":"谁将铅粉比清真，天赋殊姿秀色匀。\n祇许谪仙为酒友，应呼卫玠作尘人。\n悬灯不减秋冬雪，入盏先浮隔岁春。\n堪笑古今同一白，诗人吟著总凝神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柯东海潘瓜山游南园韵","author":"陈宓","text":"下帷窥圃事多违，到得南园已夕晖。\n松竹不忙无世态，柳梅相逐见天机。\n仆便萧散朝犹睡，鹤惯羁孤晚自归。\n如此得闲堪自适，底须危处始知几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]