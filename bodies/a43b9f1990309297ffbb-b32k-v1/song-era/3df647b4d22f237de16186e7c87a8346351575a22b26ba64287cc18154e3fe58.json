[{"title":"永遇乐 蔡州移守颖昌，与客会别临芳观席上","author":"苏轼","text":"天末山横。\n半空箫鼓。\n楼观高起。\n指点裁成。\n东风满院。\n总是新桃李。\n纶巾羽扇。\n一尊饮罢。\n目送断鸿千里。\n揽清歌、馀音不断。\n缥缈尚萦流水。\n年来自笑无情。\n何事犹有。\n多情遗思。\n绿鬓朱颜。\n匆匆拚了。\n却记花前醉。\n明年春到。\n重寻幽梦。\n应在乱莺声里。\n拍阑干、斜阳转处。\n有谁共倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江城子","author":"苏轼","text":"银涛无际捲蓬瀛。\n落霞明。\n暮云平。\n曾见青鸾、紫凤下层城。\n二十五弦弹不尽，空感慨，惜离情。\n苍梧烟水断归程。\n捲霓旌。\n为谁迎。\n空有千行。\n流泪寄幽贞。\n舞罢鱼龙云海晚，千古恨，入江声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"苏轼","text":"落花已作风前舞。\n又送黄昏雨。\n晓来庭院半残红。\n惟有游丝千丈、袅晴空。\n殷勤花下重携手。\n更尽杯中酒。\n美人不用敛歌眉。\n我亦多情无奈、酒阑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诉衷情 海棠","author":"苏轼","text":"海棠珠缀一重重。\n清晓近帘栊。\n胭脂谁与匀淡，偏向脸边浓。\n看叶嫩，惜花红。\n意无穷。\n如花似叶，岁岁年年，共占春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 送潘大临","author":"苏轼","text":"别酒劝君君一醉。\n清润潘郎，又是何郎婿。\n记取钗头新利市。\n莫将分付东邻子。\n回首长安佳丽地。\n三十年前，我是风流帅。\n为向青楼寻旧事。\n花枝缺处馀名字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中花慢","author":"苏轼","text":"邃院重帘何处，惹得多情，愁对风光。\n睡起酒阑花谢，蝶乱蜂忙。\n今夜何人，吹笙北岭，待月西厢。\n空怅望处，一株红杏，斜倚低墙。\n羞颜易变，傍人先觉，到处被著猜防。\n谁信道，些儿恩爱，无限凄凉。\n好事若无间阻，幽欢却是寻常。\n一般滋味，就中香美，除是偷尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中花慢","author":"苏轼","text":"嫩脸羞娥因甚。\n化作行云，却返巫阳。\n但有寒灯孤枕，皓月空床。\n长记当初，乍谐云雨，便学鸾凰。\n又岂料、正好三春桃李，一夜风霜。\n丹青如画，无言无笑，看了漫结愁肠。\n襟袖上，犹存残黛，渐减馀香。\n一自醉中忘了，奈何酒后思量。\n算应负你，枕前珠泪，万点千行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三部乐","author":"苏轼","text":"美人如月。\n乍见掩暮云，更增妍绝。\n算应无恨，安用阴晴圆缺。\n娇甚空只成愁，待下床又懒，未语先咽。\n数日不来，落尽一庭红叶。\n今朝置酒强起，问为谁减动，一分香雪。\n何事散花却病，维摩无疾。\n却低眉、惨然不答。\n唱金缕、一声怨切。\n堪折便折。\n且惜取、年少花发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌夜啼","author":"苏轼","text":"莫怪归心速，西湖自有蛾眉。\n若见故人须细说，白发倍当时。\n小郑非常强记，二南依旧能诗。\n更有鲈鱼堪切脍，儿辈莫教知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙","author":"苏轼","text":"昨夜渡江何处宿，望中疑是秦淮。\n月明谁起笛中哀。\n多情王谢女，相逐过江来。\n云雨未成还又散，思量好事难谐。\n凭陵急桨两相催。\n想伊归去后，应似我情怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定风波","author":"苏轼","text":"莫怪鸳鸯绣带长。\n腰轻不胜舞衣裳。\n薄倖只贪游冶去。\n何处。\n垂杨系马恣轻狂。\n花谢絮飞春又尽。\n堪恨。\n断弦尘管伴啼妆。\n不信归来但自看。\n怕见。\n为郎憔悴却羞郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"苏轼","text":"娟娟侵鬓妆痕浅。\n双颦相媚弯如剪。\n一瞬百般宜。\n无论笑与啼。\n酒阑思翠被。\n特故腾腾地。\n生怕促归轮。\n微波先泥人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 咏足","author":"苏轼","text":"涂香莫惜莲承步。\n长愁罗袜凌波去。\n只见舞回风。\n都无行处踪。\n偷穿宫样稳。\n并立双趺困。\n纤妙说应难。\n须从掌上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"苏轼","text":"玉镮坠耳黄金饰。\n轻衫罩体香罗碧，缓步困春醪。\n春融脸上桃。\n花钿从委地。\n谁与郎为意。\n长爱月华清。\n此时憎月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"山色横侵蘸晕霞。\n湘川风静吐寒花。\n远林屋散尚啼鸦。\n梦到故园多少路，酒醒南望隔天涯。\n月明千里照平沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 赠贲大夫歌者，其人尝在大家","author":"苏轼","text":"晚菊花前敛翠蛾。\n挼花传酒缓声歌。\n柳枝团扇别离多。\n拥髻凄凉论旧事。\n曾随织女度银梭。\n当年今夕奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 春情","author":"苏轼","text":"风压轻云贴水飞。\n乍晴池馆燕争泥。\n沈郎多病不胜衣。\n沙上不闻鸿雁信，竹间时听鹧鸪啼。\n此情惟有落花知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子","author":"苏轼","text":"笑怕蔷薇罥，行忧宝瑟僵。\n美人依约在西厢。\n祗恐暗中迷路、认馀香。\n午夜风翻幔，三更月到床。\n簟纹如水玉肌凉。\n何物与侬归去、有残妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江城子","author":"苏轼","text":"墨云拖雨过西楼。\n水东流。\n晚烟收。\n柳外残阳，回照动帘钩。\n今夜巫山真个好，花未落，酒新篘。\n美人微笑转星眸。\n月华羞。\n捧金瓯。\n歌扇萦风，吹散一春愁。\n试问江南诸伴侣，谁似我，醉扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江城子","author":"苏轼","text":"腻红匀脸衬檀唇。\n晚妆新。\n暗伤春。\n手撚花枝，谁会两眉颦。\n连理带头双□□，留待与、个中人。\n淡烟笼月绣帘阴。\n画堂深。\n夜沈沈。\n谁道□□，□系得人心。\n一自绿窗偷见后，便憔悴、到如今。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"苏轼","text":"记得画屏初会遇。\n好梦惊回，望断高唐路。\n燕子双飞来又去。\n纱窗几度春光暮。\n那日绣帘相见处。\n低眼佯行，笑整香云缕。\n敛尽春山羞不语。\n人前深意难轻诉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"苏轼","text":"昨夜秋风来万里。\n月上屏帏，冷透人衣袂。\n有客抱衾愁不寐。\n那堪玉漏长如岁。\n羁舍留连归计未。\n梦断魂销，一枕相思泪。\n衣带渐宽无别意。\n新书报我添憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"苏轼","text":"玉枕冰寒消暑气。\n碧簟沙厨，向午朦胧睡。\n莺舌惺忪如会意。\n无端画扇惊飞起。\n雨后初凉生水际。\n人面桃花，的的遥相似。\n眼看红芳犹抱蕊。\n丛中已结新莲子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"苏轼","text":"雨霰疏疏经泼火。\n巷陌鞦韆，犹未清明过。\n杏子梢头香蕾破。\n淡红褪白胭脂涴。\n苦被多情相折挫。\n病绪厌厌，浑似年时个。\n绕遍回廊还独坐。\n月笼云暗重门锁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"苏轼","text":"蝶懒莺慵春过半。\n花落狂风，小院残红满。\n午醉未醒红日晚。\n黄昏帘幕无人捲。\n云鬓鬅松眉黛浅。\n总是愁媒，欲诉谁消遣。\n未信此情难系绊。\n杨花犹有东风管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行香子","author":"苏轼","text":"三入承明。\n四至九卿。\n问儒生、何辱何荣。\n金张七叶，纨绮貂缨。\n无汗马事，不献赋，不明经。\n成都卜肆，寂寞君平。\n郑子真、岩谷躬耕。\n寒灰炙手，人重人轻。\n除竺乾学，得无念，得无名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 二首 其二","author":"苏轼","text":"红杏飘香，柳含烟翠拖轻缕。\n水边朱户。\n尽捲黄昏雨。\n烛影摇风，一枕伤春绪。\n归不去。\n凤楼何处。\n芳草迷归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇","author":"苏轼","text":"醉漾轻舟，信流引到花深处。\n尘缘相误。\n无计花间住。\n烟水茫茫，千里斜阳暮。\n山无数。\n乱红如雨。\n不记来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇","author":"苏轼","text":"月转乌啼，画堂宫徵生离恨。\n美人愁闷。\n不管罗衣褪。\n清泪斑斑，挥断柔肠寸。\n瞋人问。\n背灯偷揾。\n拭尽残妆粉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"苏轼","text":"冰肌自是生来瘦。\n那更分飞后。\n日长帘幕望黄昏。\n及至黄昏时候、转消魂。\n君还知道相思苦。\n怎忍抛奴去。\n不辞迢递过关山。\n只恐别郎容易、见郎难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"苏轼","text":"深深庭院清明过。\n桃李初红破。\n柳丝搭在玉阑干。\n帘外潇潇微雨、做轻寒。\n晚晴台榭增明媚。\n已拚花前醉。\n更阑人静月侵廊。\n独自行来行去，好思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诉衷情","author":"苏轼","text":"小莲初上琵琶弦。\n弹破碧云天。\n分明绣阁幽恨，都向曲中传。\n肤瑩玉，鬓梳蝉。\n绮窗前，素娥今夜，故故随人，似斗婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"意难忘","author":"苏轼","text":"花拥鸳房。\n记亸肩髻小。\n约鬓眉长。\n轻身翻燕舞。\n低语啭莺簧。\n相见处。\n便难忘。\n肯亲度瑶觞。\n向夜阑。\n歌翻郢曲。\n带换韩香。\n别来音信难将。\n似云收楚峡。\n雨散巫阳。\n相逢情有在。\n不语意难量。\n些个事。\n断人肠。\n怎禁得恓惶。\n待与伊、移根换叶。\n试又何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 回文","author":"苏轼","text":"落花閒院春衫薄。\n薄衫春院閒花落。\n迟日恨依依。\n依依恨日迟。\n梦回莺舌弄。\n弄舌莺回梦。\n邮便问人羞。\n羞人问便邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"苏轼","text":"火云凝汗挥珠颗。\n颗珠挥汗凝云火。\n琼暖碧纱轻。\n轻纱碧暖琼。\n晕腮嫌枕印。\n印枕嫌腮晕。\n閒照晚妆残。\n残妆晚照閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"苏轼","text":"峤南江浅红梅小。\n小梅红浅江南峤。\n窥我向疏篱。\n篱疏向我窥。\n老人行即到。\n到即行人老。\n离别惜残枝。\n枝残惜别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 回文四时闺怨","author":"苏轼","text":"翠鬟斜幔云垂耳。\n耳垂云幔斜鬟翠。\n春晚睡昏昏。\n昏昏睡晚春。\n细花梨雪坠。\n坠雪梨花细。\n颦浅念谁人。\n人谁念浅颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 回文四时闺怨","author":"苏轼","text":"柳庭风静人眠昼。\n昼眠人静风庭柳。\n香汗薄衫凉。\n凉衫薄汗香。\n手红冰碗藕。\n藕碗冰红手。\n郎笑藕丝长。\n长丝藕笑郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 回文四时闺怨","author":"苏轼","text":"井桐双照新妆冷。\n冷妆新照双桐井。\n羞对井花愁。\n愁花井对羞。\n影孤怜夜永。\n永夜怜孤影。\n楼上不宜秋，秋宜不上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 回文四时闺怨","author":"苏轼","text":"雪花飞暖融香颊。\n颊香融暖飞花雪。\n欺雪任单衣。\n衣单任雪欺。\n别时梅子结。\n结子梅时别。\n归不恨开迟。\n迟开恨不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"导引 奉安神宗皇帝御容赴景灵宫","author":"苏轼","text":"帝城父老，三岁望尧心。\n天远玉楼深。\n龙颜髣佛笙箫远，肠断属车音。\n离宫春色琐瑶林。\n云阙海沈沈。\n遗民犹唱当时曲，秋雁起汾阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉安导引歌词","author":"苏轼","text":"经文纬武，十有九年中。\n遗烈震羌戎。\n渭桥夹道千君长，犹是建元功。\n西瞻温洛与神崧。\n莲宇照琼宫。\n人间俯仰成今古，流泽自无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"苏轼","text":"高安更过几重山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"苏轼","text":"过湖摧手屡沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"苏轼","text":"谁教幽梦里，插他花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"苏轼","text":"湿云不动溪桥冷。\n嫩寒初透东风影。\n桥下水声长。\n一枝和月香。\n人怜花似旧。\n花比人应瘦。\n莫凭小栏干。\n夜深花正寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏青游","author":"苏轼","text":"□火初晴，绿遍禁池芳草。\n斗锦绣、火城驰道。\n踏青游，拾翠惜，袜罗弓小。\n莲步袅。\n腰支佩兰经妙。\n行过上林春好。\n今困天涯，何限旧情相恼。\n念摇落、玉京寒早。\n任刘郎、目断蓬山难到。\n仙梦杳。\n良宵又过了。\n楼台万家清晓。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮郎归 茶词","author":"苏轼","text":"歌停檀板舞停鸾。\n高阳饮兴阑。\n兽烟喷尽玉壶乾。\n香分小凤团。\n雪浪浅，露珠圆。\n捧瓯春笋寒。\n绛纱笼下跃金鞍。\n归时人倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 上元词","author":"苏轼","text":"拚沈醉、金荷须满。\n怕年年此际，催归禁籞，待黄柑宴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"苏轼","text":"山秀芙蓉，溪明罨画。\n真游洞穴沧波下。\n临风慨想斩蛟灵。\n长桥千载犹横跨。\n解佩投簪，求田问舍。\n黄鸡白酒渔樵社。\n元龙非复少时豪，耳根洗尽功名话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"苏轼","text":"这个秃奴，修行忒煞。\n云山顶上空持戒。\n一从迷恋玉楼人，鹑衣百结浑无奈。\n毒手伤人，花容粉碎。\n空空色色今何在。\n臂间刺道苦相思，这回还了相思债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"苏轼","text":"寂寂珠帘蛛网满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定风波","author":"苏轼","text":"閒卧藤床观社柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定风波","author":"苏轼","text":"子瞻书困点新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"苏轼","text":"唤起离情，慵推孤枕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"苏轼","text":"山头望，波光泼眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌","author":"苏轼","text":"我歌月徘徊，我舞影凌乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"苏轼","text":"揭起裙儿，一阵油盐酱醋香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 佳人","author":"苏轼","text":"罗带双垂画不成。\n殢人娇态最轻盈。\n酥胸斜抱天边月，玉手轻弹水面冰。\n无限事，许多情。\n四弦丝竹苦丁宁。\n饶君拨尽相思调，待听梧桐叶落声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 佳人","author":"苏轼","text":"碧雾轻笼两凤，寒烟淡拂双鸦。\n为谁流睇不归家。\n错认门前过马。\n有意偷回笑眼，无言强整衣纱。\n刘郎一见武陵花。\n从此春心荡也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"更漏子","author":"苏轼","text":"柳丝长，春雨细。\n花外漏声迢递。\n惊塞雁，起城乌。\n画屏金鹧鸪。\n香雾薄，透帘幕。\n惆怅谢家池阁。\n红烛背，绣帘垂。\n梦长君不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"更漏子","author":"苏轼","text":"春夜阑，更漏促。\n金烬暗挑残烛。\n惊梦断，锦屏深。\n两乡明月心。\n闺草碧，望归客。\n还是不知消息。\n孤负我，悔怜君。\n告天天不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如梦令","author":"苏轼","text":"曾宴桃源深洞。\n一曲舞鸾歌凤。\n长记欲别时，和泪出门相送。\n如梦。\n如梦。\n残月落花烟重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平调引 其一","author":"苏轼","text":"陌上花开蝴蝶飞。\n江山犹是昔人非。\n遗民几度垂垂老，游女长歌缓缓归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平调引 其二","author":"苏轼","text":"陌上山花无数开。\n路人争看翠軿来。\n若为留得堂堂去，且更从教缓缓回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平调引 其三","author":"苏轼","text":"生前富贵草头露，身后风流陌上花。\n已作迟迟君去鲁，犹教缓缓妾回家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩山","author":"刘允","text":"惆怅昌黎去不还，小亭牢落古松间。\n月明夜静神游处，三十二峰江上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]