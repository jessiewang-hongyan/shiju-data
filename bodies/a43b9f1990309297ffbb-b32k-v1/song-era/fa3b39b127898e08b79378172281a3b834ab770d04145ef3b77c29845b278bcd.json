[{"title":"寄林信州","author":"赵蕃","text":"岭近梅花开已多，水南梅事又如何。\n使君假日曾游否，客子临风空屡哦。\n好士何妨勤下榻，丰年那有拙催科。\n倦游我亦怀三径，何况传闻政免苛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄郑伯元","author":"赵蕃","text":"文学崔斯立，才名郑广文。\n传闻定省暇，不废簿书勤。\n流落谁如我，交亲更念君。\n水西佳绝处，诗就想超群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄郑秘校","author":"赵蕃","text":"吾邦豪杰未多闻，义薄云天独数君。\n遇歉登仓真甚惠，当郊置驿信徒勤。\n目前米价未为贵，我自囊空先有云。\n食粥敢言今数月，更忧无粥但羹芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄俞玉汝","author":"赵蕃","text":"晦庵寄我溧阳书，报道今为建业居。\n作客遽经三岁久，赋诗应尽六朝馀。\n莫将明月誇鱼目，自昔盐车羡蹇驴。\n期子归来趁鲜健，老无筋力事犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄南安李使君三章 其三","author":"赵蕃","text":"如闻舍策已蹁跹，神物护持非药痊。\n为州莫漫贪良酝，把节何迟复旧毡。\n但期米许频仍乞，敢望舟同缥缈仙。\n别久未能成一诣，故怜终日泥陈编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄南安李使君三章 其二","author":"赵蕃","text":"臼捣纷纷何所如，碾成更自治家模。\n不尽粉身兼碎骨，为看落雪又霏珠。\n体用同归人力致，粗精孰愈磨工夫。\n旧闻此物独君地，要伴笔床能寄无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄南安李使君三章 其一","author":"赵蕃","text":"频宵为月卧风前，异世风流怀谪仙。\n半年且阔书邮置，六辈肯来从事贤。\n白衣不但觅陶令，春草因之感惠连。\n醉里悠悠更何梦，南池水长叠荷钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄峡州使君郭郎中三首 其三","author":"赵蕃","text":"契自西台叙，亲从昭德论。\n名声盖前辈，牢落愧清门。\n既见未知日，因风聊自存。\n祇愁千里面，识我故尘昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄峡州使君郭郎中三首 其二","author":"赵蕃","text":"何处观文献，如公尚典刑。\n诗先获麟作，字本换鹅经。\n牛斗漫宝气，虚危须德星。\n无为偃薄计，不晚诏除听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄峡州使君郭郎中三首 其一","author":"赵蕃","text":"汉代郭林宗，词场继国风。\n郎官曾赐被，刺史暂凭熊。\n为客留工部，移官滞酒翁。\n淮阳岂为薄，无恨不居中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其六","author":"赵蕃","text":"吾与徐斯远，敬之宁独亲。\n讵须劳咄咄，徒觉叹踆踆。\n共乐名教地，同耕寂寞滨。\n敝裘堪共御，宜尔耐艰辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其十","author":"赵蕃","text":"两载沅湘役，虽劳何所为。\n虾行仍蛭渡，犹豫复狐疑。\n孰念锄犁把，殊胜手板持。\n山南与山北，舍子更从谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其九","author":"赵蕃","text":"求友咏伐木，思兄言陟冈。\n那知符檄累，不了道途忙。\n照水形知瘵，临风发欠长。\n想渠能我忆，如我不渠忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其八","author":"赵蕃","text":"忆我江东弟，书来得暂怡。\n寺居因市近，村舍与贫宜。\n儿辈诗书力，童奴薪水为。\n尤欲护吾竹，及此夏初时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其一","author":"赵蕃","text":"两月巴陵郡，搜诗朝暮间。\n空能饮江水，恨不上君山。\n昔者闻何至，今焉兴尽还。\n才名或遭骂，坎轲分低颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其四","author":"赵蕃","text":"我不识裘父，闻之空有年。\n曾题五字寄，仅以尺书旋。\n诸老没已久，故家谁复贤。\n犹欣得吾子，句法早亲传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其五","author":"赵蕃","text":"西京刘校尉，上疏引春秋。\n圣学期深探，明时可妄投。\n他年王子表，今日古人求。\n幸甚闻无恙，顿能宽远忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其三","author":"赵蕃","text":"霞谷宁终计，龙门已暮年。\n向来嗟独后，今日可忘前。\n既缪青衿学，当思白首传。\n犹须就吾子，相为语蝉连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秋怀 其二","author":"赵蕃","text":"大暑惧死暍，祁寒愁仆僵。\n岁时空卒卒，身世益伥伥。\n问服遗官叹，怀沙去国伤。\n终殊弋何慕，况事色斯翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄胡达孝二首 其二","author":"赵蕃","text":"问讯安丰守，开藩且半年。\n秋收多少麦，春辟几何田。\n但使民能足，端知化已宣。\n誉毋求赫赫，腹肯愧便便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄胡达孝二首 其一","author":"赵蕃","text":"中庸有胡公，千骑乃安丰。\n气自论诗合，情因叙旧通。\n莫窥鸿鹄志，相望马牛风。\n邂逅长安使，丁宁觅置筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵元归并属元默三首 其三","author":"赵蕃","text":"默也未识面，向来曾予书。\n由来几兄弟，绝叹每乖疏。\n见说长沙驿，犹迟古寺车。\n差池今再矣，伫立又何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵元归并属元默三首 其二","author":"赵蕃","text":"抚信元相近，乖离乃尔赊。\n何堪落湖外，动即阻天涯。\n叹我干微禄，期君起故家。\n文科须中早，学力更功加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵元归并属元默三首 其一","author":"赵蕃","text":"忆在袁州见，曾遗满纸诗。\n临川得再面，近作重相贻。\n我老已成退，君才真尔奇。\n纵能连日语，宁慰积年思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵文鼎","author":"赵蕃","text":"殷勤寄谢湖州牧，五马谁能鬓未斑。\n民事虽云急期会，登临要不负溪山。\n如公讵免帝城入，有诏不迟旬岁间。\n人士端能客张贾，声名自不减苏颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵信州一叔二首 其二","author":"赵蕃","text":"官梅亲手种，山阁听僧修。\n授简惭吾事，登高企胜流。\n葭莩元有托，桑梓近临州。\n愧我资身拙，从公但食谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵信州一叔二首 其一","author":"赵蕃","text":"蓬山辞上直，番国唤回舟。\n旧事超千佛，兹行夺万牛。\n未除真学士，且列古诸侯。\n诏旨防敦迫，民言愿借留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵著作","author":"赵蕃","text":"有客东来为我言，诏书传已下修门。\n幡然要识朝廷意，易此方明父子恩。\n物望祇今谁得似，道行宁负夙心存。\n公其大作斯民庇，我亦耕桑安故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵湖州","author":"赵蕃","text":"平生清远地，几首往来诗。\n独负寻山债，长年属梦思。\n故人今五马，薄宦乃南夷。\n要寄登临胜，当来墨妙碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送于去非三首 其三","author":"赵蕃","text":"假馆我多暇，驱车君苦忙。\n近时成契阔，远去益凄凉。\n闻说催归骑，何由把别觞。\n归心擢章贡，远目溯沅湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送于去非三首 其二","author":"赵蕃","text":"草木政怒长，波涛方疾流。\n雄辞杂蛟蚓，健笔走龙虬。\n我句平无取，君才勇莫俦。\n如何晦翁语，折节继前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送于去非三首 其一","author":"赵蕃","text":"三载尉虽卑，诸公竞己知。\n荐书常沓至，宾幕每牢辞。\n玉立风神峻，河倾议论驰。\n他年继质肃，应有后人祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送周子中监丞赴舒州二首 其二","author":"赵蕃","text":"欲问淮南米，皆云岁不登。\n疲羸不难活，摩抚政须能。\n但使荒田辟，无劳铸铁增。\n素书宁敢寄，苦语未宜憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送周子中监丞赴舒州二首 其一","author":"赵蕃","text":"引嫌初补外，怀绶复频年。\n自得山水胜，定由仙佛缘。\n往游成旧矣，有梦尚依然。\n六字今谁嗣，留题乞我传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送府判寺簿先生二首 其二","author":"赵蕃","text":"朱游不肯留东阁，子政犹须校秘书。\n自有大名喧宇宙，岂劳当路借吹嘘。\n舟中加意护寝饭，日下即当来诏除。\n大厦如山要梁栋，不应空赋爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送府判寺簿先生二首 其一","author":"赵蕃","text":"大旆传闻发武昌，归舟复道抵维扬。\n几年风月欠李白，今日河山须子长。\n要为中兴考形势，岂徒馀事著文章。\n翩然欲去无翎翅，自叹不如鸥鹭行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送潘文叔恭叔二首 其二","author":"赵蕃","text":"已道衡州远，而今又广州。\n埙篪君膝下，风雨我蛮陬。\n至矣贫而乐，谁云富可求。\n斯文失张吕，吾道属朱刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送潘文叔恭叔二首 其一","author":"赵蕃","text":"夏潦方为问，秋风又枉书。\n寒温叙安否，学问叩何如。\n斑鬓惊催老，青衿悔负初。\n朝闻夕可死，何敢废居诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄倪好问","author":"赵蕃","text":"问讯永州倪户曹，别来岁月已滔滔。\n贤居幕府定馀暇，舟过浯溪今几遭。\n颂出次山微自显，诗成太史贬无褒。\n因来打寄山中本，并以张秦翰墨豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄唐德舆时决狱辰沅","author":"赵蕃","text":"生平但识古书耽，老至方知世路谙。\n君想归途在巴蜀，我行何日返东南。\n江湖比苦无书疏，风月今怜阻笑谈。\n暇日销忧应有作，簿书仍急亦何堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐季纯于去非兼属梁和仲曾元之吴仲权","author":"赵蕃","text":"西来政尔叹离居，数士英英端起予。\n情话不遗亲且故，高交宁有数能疏。\n诗章许和平反暇，尊酒仍饕簿领馀。\n幕府河南亦名胜，愿交烦为问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐季益四首 其四","author":"赵蕃","text":"我已非青鬓，君今定白须。\n田园稍治否，寝饭比佳无。\n闻道为归计，何当出此涂。\n相期一邂逅，得以话艰虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐季益四首 其三","author":"赵蕃","text":"吕氏多人物，譬之珠玉渊。\n世官渠有命，家学定谁传。\n籍甚群公誉，皆云正字贤。\n掖垣君旧识，聊与话当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐季益四首 其二","author":"赵蕃","text":"君不减徐稚，豫章仍主人。\n结交非势利，此客况清真。\n今日山中友，他年席上珍。\n玉堂如伴直，怨句不须陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐季益四首 其一","author":"赵蕃","text":"不见徐夫子，于今已二年。\n转头疑夙昔，屈指悟推迁。\n书欠洪乔寄，诗烦阿买传。\n相思到极地，把诵一悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄晦庵二首 其二","author":"赵蕃","text":"张胆言何壮，擎天志未摧。\n真成一夔足，何有万牛回。\n感兴能无句，忧时谩举杯。\n江湖嗟屦役，巾屡阻追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄晦庵二首 其一","author":"赵蕃","text":"道大谁能与，才难圣所叹。\n浮云虽暂掩，宝气不终蟠。\n走卒称司马，苍生起谢安。\n纵无临贺送，当有翰林观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄梁从善","author":"赵蕃","text":"旧说舂陵郡，全如石作州。\n胸中饱丘壑，笔下剖琳球。\n遥想窗扉敞，多能磊落收。\n平生有馀嗜，安得致林幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄黄子耕","author":"赵蕃","text":"谁能一枉林间寺，君独屡过湖上村。\n先世文章出遗逸，当家句法有渊源。\n平生所识盖无几，盛意若何如见存。\n元祐兰台妙人物，我今寂寞愧诸孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄喻叔奇","author":"赵蕃","text":"雨雪长安日，羁栖独旅时。\n累觞欣会面，到处益潜悲。\n旧识文章伯，今犹国子师。\n何当一持节，来惠楚人为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄喻叔奇丈二首 其二","author":"赵蕃","text":"饮我长安酒，歌公亦好诗。\n试思犹宿昔，忽念已差池。\n要识园林好，何由杖履随。\n有时观叙梦，亦复叹吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄喻叔奇丈二首 其一","author":"赵蕃","text":"不见喻工部，经今两暮春。\n遥知磬湖上，不减浣花滨。\n佳句能名世，浮云岂绊身。\n为贪烟雨胜，聊复驾朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄彭元思","author":"赵蕃","text":"忆昨寄书今几日，缺然无地接殷勤。\n秋风红叶堪题句，寒夜青灯忆对君。\n三径吾将归问路，一尊何日再论文。\n番湖政与冰溪接，鸡犬虽遥亦共闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄曾运使","author":"赵蕃","text":"携诗十载旧登门，一见长思阙细论。\n岂忆犹蒙记名姓，故情仍许奉罍尊。\n临分更俾传家集，请事于今行嫡孙。\n傥有新闻幸无弃，素书无只报寒温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄曾使君昭","author":"赵蕃","text":"溪山杖策过山林，万竹千梅可慰心。\n已悟濠鱼真得计，未嫌郢曲谢知音。\n飞腾要路终无那，咫尺春风且细寻。\n诗自空青受山谷，到公探讨益精深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄曾季永","author":"赵蕃","text":"水竹悬知属所思，风埃遥想未忘诗。\n万言何有一杯直，三径宁须五斗为。\n安否频来道州札，缄封更得白鹅碑。\n政和父老犹存否，烦与殷勤访逸遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄答曾无己见贻诗卷","author":"赵蕃","text":"吾舅风流名海内，霜清月淡有梅诗。\n君曾一向蒸湘识，句里悬应摸索知。\n邂逅已能成屡见，殷勤还辱问归期。\n谈间并为诸兄谢，从此论交更不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢汤司谏二首 其二","author":"赵蕃","text":"章水清初涨，梅花雪正飞。\n不惟催我去，似亦待公归。\n有弟能频说，高情真见几。\n男儿出处耳，麟阁与渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢汤司谏二首 其一","author":"赵蕃","text":"十往九不报，好辞开几番。\n誇张示朋友，问讯异寒温。\n岂必待倾盖，何时真扫门。\n绝胜东阁下，布粟对公孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢景英丈","author":"赵蕃","text":"先生岂是爱监州，高兴应为雁荡游。\n康乐当年空想望，云孙今日慰淹留。\n幽人衲子应多识，妙偈名章可寄不。\n兜率蓬莱果同异，不妨归步在丹丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄道正阇黎二老师并帖季萧兄","author":"赵蕃","text":"三年光景一篇诗，此世何堪作许离。\n一代声名属韩吕，百年衣钵付严黎。\n风生佛屋朝谈处，月满仙坛夜步时。\n珍重陵阳老孙子，当时酬唱亦同之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩季萧二首 其二","author":"赵蕃","text":"近与李商叟，共谈韩季萧。\n旧毡馀翰墨，幽寺乐箪瓢。\n问友多冥漠，须君慰寂寥。\n云胡又相失，于此亦何聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩季萧二首 其一","author":"赵蕃","text":"怕到看经院，愁登拟岘台。\n人言已仙佛，我意祗悲哀。\n此道谁人付，陵阳有后来。\n款门期一见，投刺只空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄愚卿兄弟兼属伯威","author":"赵蕃","text":"楼上长江江上山，烟云鸥鸟尚班班。\n归来靖节荒三径，已矣卢仝屋数间。\n书肯细行知义立，梦能频见识心关。\n因声重谢穷冈叟，太息刘郎去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题分宜簿舍怀古阁为刘公度赋","author":"赵蕃","text":"虽云闲主簿，曷日顾能闲。\n因榜白云句，遂追千古还。\n功名常慕蔺，事业亦希颜。\n易地能同道，高山俯仰间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题安福士人家赏静轩听雨二首 其二","author":"赵蕃","text":"有听辄有感，所关非所闻。\n小轩渠对雨，远地我看云。\n大被清霜晓，短檠寒夜分。\n朝昏解同趣，南北谢离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题安福士人家赏静轩听雨二首 其一","author":"赵蕃","text":"心远渊明趣，室虚庄叟书。\n宅边种柳树，濠上乐鯈鱼。\n往者不复作，斯人今则疏。\n谁为赏静者，吾欲并门居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]