y","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瞿唐峡 其一","author":"阳枋","text":"曾闻滟滪屹瞿唐，雪浪摧山势独当。\n我至韶融方二月，水平石出映斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瞿唐峡 其二","author":"阳枋","text":"万丈危屏水墨图，江流带窄映云衢。\n莫怪波平澜不倒，回狂滟滪一峰孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑除夕衍少陵韵成七言寄示任儿于珍南","author":"阳枋","text":"边隅守岁莫思家，有酒盈樽即颂花。\n爱尔和鸣同野鹤，起予返哺学林鸦。\n生香不断炉烟袅，绛蜡长明跋晕斜。\n时序推迁休问当，何思何虑乐无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久留黄池待弟侄不至九日独酌","author":"阳枋","text":"将道花黄醉彭泽，又还茱紫酌平湖。\n诗因得意时时赋，酒为无宾浅浅沽。\n蓝色已残千岸柳，霜花催满万汀芦。\n閒行閒坐云和水，不识天工怪我无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋黄池舟中独酌五首 其三","author":"阳枋","text":"赏月东西两地遥，一轮千里共今宵。\n心中至乐成真得，分外閒愁不复摇。\n江寺饶吾观白水，郡亭喜弟看洪潮。\n世间欢赏由人尔，天地何曾有寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋黄池舟中独酌五首 其二","author":"阳枋","text":"画桥杨柳系船儿，蟾魄飞来光满溪。\n有水连云疑地阔，无山碍月觉天低。\n鱼堪寄信应时见，雁欲横霜犹未齐。\n白酒堪沽鸡中割，呼樽独酌画桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋微月和彭水赵文卿韵","author":"阳枋","text":"剩雨顽云乍解围，清光此夜拟依稀。\n天工不许厌厌饮，月姊终悭皎皎辉。\n离合随缘都是乐，阴晴任理两忘机。\n谢君好语无貂续，题拙惭随赵璧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见欧制干 其二","author":"阳枋","text":"寻师万里走东南，性学精微闻两三。\n风月归来深体认，箪瓢自乐细沈涵。\n岩前静索龟图秘，蜀口惊呼蚁战酣。\n欲觅底寮整残断，峡天分借一屏岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙辰病起示儿","author":"阳枋","text":"采薪背夏见书云，世我相遗思转清。\n识个凝阴消又长，喜些真火熄还生。\n百年好梦黄粱短，一片閒心白鹤轻。\n独拥寒衾长不寐，听吹梅角动江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和陈提举喜雨 其一","author":"阳枋","text":"了无和气格清穹，天意难回执热中。\n骤雨起从南海庙，雄风到自楚王宫。\n却愁水府丹瓢注，解使银河赤岸通。\n急趁好晴催刈谷，坻京相庆万家同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和陈提举喜雨 其二","author":"阳枋","text":"十万农租要纳王，望霓虽切雨何方。\n桑林敬体皇心祷，云汉终歌国祚昌。\n坐使里闾消叹息，幻成境界得清凉。\n欲知千里人情共，盈袖新诗已可装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回奉节宰阳季明","author":"阳枋","text":"只缘心地乐宽平，便把青衫付外心。\n健羡春莺娇出谷，自惭宿鸟倦投林。\n光阴有限嗟空度，义理无穷要极深。\n七十老翁闻好语，一回吟咏一回斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江干览镜","author":"阳枋","text":"千重滩浅身曾过，万顷湖深也去来。\n平地雪中萧店宿，掀天浪里片帆开。\n干戈鼎沸舟还失，炎暑甑蒸师正灾。\n小艇随人偷入峡，笑开菱匣亦顽哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池口下小港遇大风 其一","author":"阳枋","text":"万雷豗击一江声，本是风从水上行。\n断港不妨寻住计，修涂未信阻归程。\n閒中已会性天静，忙里依然心地平。\n险阻怪崖行半百，扁舟肯学夜多惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池口下小港遇大风 其三","author":"阳枋","text":"水本无声风作声，何心坎止与流行。\n掀天不碍翻洪浪，到海须知有去程。\n可以东西形暂激，不容轩轾性元平。\n悬知读易如程子，舟压银涛胆不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池口下小港遇大风 其二","author":"阳枋","text":"诗翁下语写心声，说破云涛阻客行。\n得意快吟三两句，放怀休数八千程。\n时因极冻方回暖，水若无风还自平。\n一点阳和消息好，江边柳眼又眠惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过三游洞知遂脱兵火矣喜赋","author":"阳枋","text":"万里扁舟归自东，干戈满地路难通。\n弟兄一榻聊相对，叔侄双头未许同。\n峡入三游千丈险，水连西蜀百忧空。\n家山桃李期堪数，共约花间酌晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别宇文丈","author":"阳枋","text":"满耳声称蓦浣沙，萍根云叶际天涯。\n襟扃喷扑芝兰气，韵味清修诗礼家。\n剩把香编消岁月，点无浮叶靓春华。\n西归人问簪朋得，将作东南第一誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]