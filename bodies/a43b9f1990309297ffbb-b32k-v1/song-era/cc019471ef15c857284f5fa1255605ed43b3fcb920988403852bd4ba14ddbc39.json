asty":"宋"}},{"title":"桑落洲望见庐山立雪一峰和全父弟韵 其二","author":"阳枋","text":"新晴破雨浪犹激，暂卸蒲帆泊短湾。\n桑落洲前凝睇远，尖天白雪是庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公招饮不赴诗谢送酒 其一","author":"阳枋","text":"双桨浮波日夜催，胥涛不到子陵台。\n为怜摘菊空盈把，故遣鸱夷送酒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公招饮不赴诗谢送酒 其二","author":"阳枋","text":"薨薨飞蠓哦空檐，跃马官尘日上船。\n故步明知浑失却，剡溪兴尽不须前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒赵漕 其三","author":"阳枋","text":"文公桃李笋班中，问学心旌日夜东。\n时序催人烟水远，临流愿借一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒赵漕 其二","author":"阳枋","text":"槎星烂照玉堂明，楼雪晴融白帝城。\n鸥狎不知菱荡转，漫随瀼水泛春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒赵漕 其一","author":"阳枋","text":"山头云麦杂烧畬，桃李层层山半家。\n讴轧蛮歌声满峡，春生龙节烂光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涪州北岩书院别王东卿归乐邑","author":"