[{"title":"城上亭二首阙 其二","author":"孔武仲","text":"湘潭之酒今稍薄，粉白水清亦不恶。\n百钱换得一斗归，复此悠然纵杯酌。\n醉中衡华皆秋毫，肯复刺眼事锥刀。\n层林密叶风力豪，钧天震响春台高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城上亭二首阙 其一","author":"孔武仲","text":"更无人迹逐攀跻，庐岳乌藤手自携。\n沧海谁论六月息，茂林今得一枝栖。\n幽芳满径春难老，翠樾连云日易西。\n况有北郊宜旷望，公馀聊此发醯鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣州吴子权送陵阳酒","author":"孔武仲","text":"梦寐陵阳天上山，曾将心约白云閒。\n仙衔已下青冥里，尘骨难留缥缈间。\n三尺溪鱼如可控，千年辽鹤尚应还。\n多情别后能论旧，远寄官醪为解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至巴陵","author":"孔武仲","text":"南行应不叹途穷，水驿连翩遇好风。\n远浪飞来千白鹭，轻帆相逐两冥鸿。\n残云日挂苍茫外，平野天垂旷阔中。\n湘浦旧游思一访，肯因莼脍忆江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思南岳呈运判承议","author":"孔武仲","text":"曾逐篮舆访懒残，楼台萦转在峰峦。\n银灯夜向猊床拜，别殿晨披贝叶看。\n选胜危梯经巀嵲，登高馀思凭栏干。\n归来认是游仙梦，过尽春风料峭寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"施夫人挽诗","author":"孔武仲","text":"有子纡朝服，平居奉典彝。\n蹉跎五鼎养，奄忽百年期。\n故宅萱堂掩，新阡薤露悲。\n遗芳托齑臼，髣髴九泉知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪福寺藤架","author":"孔武仲","text":"生长应毫末，敷腴忽十寻。\n繁花春不歇，密叶昼长阴。\n风过龙蛇动，云开洞府深。\n时来学晏坐，朝市不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸酉腊雪","author":"孔武仲","text":"又见同云合，朝来雪满天。\n寒生梁苑席，兴在越溪船。\n不复风鸣屋，应须泽到泉。\n农家相庆喜，处处亩钟田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕感怀","author":"孔武仲","text":"秋空雨过一掀帘，万象森森夜气严。\n皓露滴人珠满袖，金风吹月鉴开奁。\n荒阶蟋蟀动相感，大海虬龙方退潜。\n物理穷通何足叹，试开阊阖问洪纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日感怀","author":"孔武仲","text":"万山松色锁蝉鸣，日透林阴上下清。\n霜压蒹葭连地白，风吹河汉满天声。\n穹庐夜动阴山虏，玉甲朝屯紫塞兵。\n愿漱单于一杯血，心随雕鹗过长城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草石寺","author":"孔武仲","text":"高士去已久，馀踪犹可知。\n竹阴侵晏坐，山影在平池。\n尘蚀参军墨，苔侵相国碑。\n漫寻潇洒趣，俯仰惬心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"轺车馆","author":"孔武仲","text":"野阔天长入望青，眼中虚豁到鸿冥。\n偶从楚俗来同乐，下视湘江笑独醒。\n风紧水光时蹙练，日斜山影半回屏。\n扁舟过此方年少，老矣重来鬓渐星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送天觉使河东","author":"孔武仲","text":"张郎肥马衣轻裘，俊气轩轩不解愁。\n曾立玉墀联近侍，新持金节领诸侯。\n屠龙伎俩终须用，探虎功名未肯休。\n去矣范滂聊缓辔，太行云路戒摧舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送文潜出守丹阳","author":"孔武仲","text":"山阳惊坐早轩轩，元祐登瀛正少年。\n殿上仍簪侍臣笔，江头新舣使君船。\n吟哦气爽沧溟外，曲步心期白日边。\n守得东南知不负，梦中应作五洲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王颐赴官八桂","author":"孔武仲","text":"欠不忆桂海，因君还起予。\n江光平漫石，山翠上凌虚。\n黄港窥寻旧，青衫黾勉初。\n年丰桴鼓息，清趣在琴书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲至学士使北","author":"孔武仲","text":"圣策招怀万里戎，累年南向不弯弓。\n休论边使千金费，绝胜争城百战功。\n古驿玻瓈晨煖酒，隆山狐貉暮排风。\n归途剩记殊方事，付与麟台逸史中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送傅龙图帅秦","author":"孔武仲","text":"公才卓荦有施为，镇俗安边正及时。\n东壁图书迁秩峻，西州父老叹来迟。\n门开细柳军无匹，剑下楼兰敌未知。\n闻道秦州多胜迹，登高能广少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘明复知凤翔二首 其二","author":"孔武仲","text":"先帝开三省，今皇重老成。\n山林招隐逸，巷陌起公卿。\n自古时难遇，吾侯道正行。\n岐山莫望凤，金阁迟飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘明复知凤翔二首 其一","author":"孔武仲","text":"旧国安黄霸，新邦识细侯。\n皇慈借乡便，舆诵欲公留。\n晓雪骊驹宴，春风画鹢舟。\n皇都朝谒早，天路看鸣驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何司封知寿州","author":"孔武仲","text":"清淮带城郭，形胜压吴天。\n人苦怀襄后，帝求师帅贤。\n郎官已分竹，画鹢似登仙。\n昨夜惊乌坐，星辉共黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送希甫使蜀","author":"孔武仲","text":"汉节西南出，征鞍万里赊。\n清朝早扬历，远使更光华。\n山壮蚕丛国，云深杜宇家。\n暂宣宽大诏，恩信及天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李端叔定州机宜","author":"孔武仲","text":"才高秖合住蓬瀛，步武优游地望清。\n何事尘埃久京国，却冲雨雪向边城。\n军书落笔千毫秃，谈席挥犀四座倾。\n早晓封章来荐鹗，一鸣从此使人惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送芸老通判","author":"孔武仲","text":"御史连章乞此行，制书优遣副专城。\n京都岂乏翱翔处，忠义先期去就明。\n祖帐杯槃留晚色，关山草木动秋声。\n西州莫作经年计，早晚君王召贾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周正儒知梓州","author":"孔武仲","text":"东蜀国巨屏，梓州天一方。\n浯川点城郭，剑阁护池隍。\n镇抚须贤守，吁俞辍省郎。\n不应嗟远别，垂组正誇乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送欧阳仲勉通判渭州","author":"孔武仲","text":"当年笔战共词场，老大联袪振鹭行。\n荐牍北来当玉座，轺车西去拥银章。\n潼关晓色云藏市，渭曲春寒菜有霜。\n公退登临多绝唱，解因风月记江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送范中发知蕲州","author":"孔武仲","text":"汉南行乐不可复，殿中立班时会君。\n华省方看列宿贵，名州歘见左符分。\n飘蓬聚散古难必，塞马去来乌足云。\n出处行藏君素达，吟情聊对祖山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郏公甫通判睦州","author":"孔武仲","text":"又向东南去，都门奈若何。\n尘埃京洛久，山水富春多。\n宴俎誇鱼美，书帷待雁过。\n鹏程休暂息，九万看腾波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑无欲改官知合江县二首 其二","author":"孔武仲","text":"马踏榆阴出汉关，邦人欣见锦衣还。\n东川却指旧游处，北阙犹萦旅梦间。\n神女断云低楚峡，子规啼月惨巴山。\n知君利刃曾磨试，囹圄应从到日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑无欲改官知合江县二首 其一","author":"孔武仲","text":"晓辟未央宫，千袍拥赭红。\n分班百寮底，得邑万山中。\n丽笔元摛锦，新章更绾铜。\n定应随驿召，不久滞巴东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送祠部刘仪文知颖州","author":"孔武仲","text":"厌逐京师车马尘，乞为林下水边人。\n江湖入梦归心壮，道路生辉使节新。\n岂弟宜民推善政，清閒无讼称天真。\n如闻此府多迁擢，剩醉西湖烂漫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送高善时赴官","author":"孔武仲","text":"王国方登俊，清才尚折腰。\n萱堂馀怆在，瘴海此行遥。\n宴语无疏阔，离怀但黯销。\n红尘一羁旅，风驭羡飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送崔伯阳守颍州","author":"孔武仲","text":"听说州除美，州临颍水清。\n风谣带京洛，湖岛似蓬瀛。\n昔泛扁舟下，今闻太守行。\n山川应好在，为道旅人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送望圣监南岳庙","author":"孔武仲","text":"还乡同赴紫宸朝，笑语从容慰寂寥。\n白发侵凌今满鉴，青春羁旅旧连镳。\n易江小隐西园在，湘浦新除道路遥。\n老境不堪论契阔，东风官柳乱堤桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梅子明还吴","author":"孔武仲","text":"姑苏限云水，官舍隐蓬莱。\n出汴青山涌，横江画舸开。\n家园虽渴别，书社早归来。\n新命乡人喜，神仙旧姓梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送传正之官礼部","author":"孔武仲","text":"妙道微言早自知，钧衡何事器君迟。\n连墙并屋相从久，耸壑昂霄此去宜。\n画省含香脩故事，云台呼仗请私仪。\n想君清直家风在，好为朝廷作伯夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送景文之官明州","author":"孔武仲","text":"京尘不可久，得地海潮东。\n市郭沧溟上，庵岩翠嶂中。\n江瑶如切玉，越女不施红。\n官事从容了，时当作醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送游景叔使陜西","author":"孔武仲","text":"谕指严生不惮劳，为君谈笑取临洮。\n轺车复历秦关险，绣扆新瞻汉殿高。\n直使三农归陇亩，勤将尺纸荐英豪。\n峰岚涧水香山路，想见春风动锦袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送韩密学知定州","author":"孔武仲","text":"闻说公家阅古堂，于今出守似还乡。\n营开细柳旌旗动，山假胭脂苜蓿长。\n北府貔貅瞻玉节，南楼风月寄胡床。\n亲朋出祖无惆怅，早晚韩侯对未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送殷父弟知衡州","author":"孔武仲","text":"浮云富贵本无情，出守衡阳地望清。\n陇亩良田多乐岁，江山秀气入重城。\n铃斋宴衎茶樽佚，棠荫优游狱讼平。\n应念区区大梁客，朝衣颠倒趁鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻王师破洮河城获鬼章","author":"孔武仲","text":"盛德包荒与古同，十年关塞古洮戎。\n神兵合沓来天上，猛虎逡巡落槛中。\n蜀境粗偿关羽恨，汉津今奏武皇功。\n城阴却叹周南滞，梦想鹓行紫禁东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻袁思正卒于宿州","author":"孔武仲","text":"画舸西河载酒回，东篱持菊待君来。\n何知顷刻成千古，不及从容共一杯。\n羁旅梦魂难际接，平生交分但悲哀。\n中年万事长心恶，何处愁眉得暂开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顺风发江夏","author":"孔武仲","text":"西江风浪夜喧豗，清晓犹闻万籁哀。\n水驿正随衡雁去，云帆初学海鹏开。\n山横别浦跳丸度，席对长澜阵马来。\n快意须防太豪横，斜阳荒港少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日入馆","author":"孔武仲","text":"青骢晓转绿槐阴，金碧重重魏阙深。\n洞里天花长带露，门前畏日自流金。\n云台朱槛邻星斗，石室牙签照古今。\n宦学从来难两得，君恩优假是书林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐成之园亭三咏 其一 瑞香槛子","author":"孔武仲","text":"异国携来看愈新，移当樽俎会嘉宾。\n虽无绝艳惊流俗，为有清香得近人。\n烛下更宜观态度，酒阑尤觉醒精神。\n湖南莫作淹留叹，已见浔阳二月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅枕","author":"孔武仲","text":"旅枕春风底，翛然一梦惊。\n漏移清禁远，天入小窗明。\n桂玉梁园费，山椒楚客情。\n萧条过百五，犹有卖花声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别真戒讲师","author":"孔武仲","text":"假山砌叠真相似，双竹浇培画不如。\n万屋尘嚣无间断，一轩气象自清虚。\n持斋欲趁龙华会，升座能翻贝叶书。\n官罢亦将辞北阙，携筇先访故人居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题无咎卧陶轩","author":"孔武仲","text":"南陌尘如雾，北窗清有馀。\n虽无彭泽柳，已富邺侯书。\n昼永禽音缓，门閒马迹疏。\n翛然即高枕，嘉兴拟湓庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题毛成叔持月轩","author":"孔武仲","text":"明月来时远，腾腾碧海东。\n云收万里外，人在一轩中。\n光泫池塘路，凉生枕簟风。\n相过喜良夜，莫放酒尊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题徐成之和轩","author":"孔武仲","text":"生人情谊贵和光，俸薄官閒寄楚乡。\n杂遝宾朋四方会，优游风月一轩凉。\n杯倾琥珀催人饮，羹煖驼蹄劝客尝。\n景趣己佳心未惬，更栽花竹满池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读王逢原文奇其才择甚精者录为一编","author":"孔武仲","text":"人喜相知自昔然，况君埋玉未多年。\n雄文一读千行泪，青眼相期万古传。\n已掇条枚收美实，更披沙石贮清泉。\n东斋倒掩无人语，火煖灯明手自编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读经父所作高承制铭因寄之","author":"孔武仲","text":"征路杳无穷，山川掩映中。\n记程知远近，分境识西东。\n倦客似浮梗，轻鞍如去鸿。\n平生惯相遇，转愧坐禅翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥亭独游","author":"孔武仲","text":"城上飞檐出百寻，回环古木自成阴。\n凉生白昼收团扇，影入斜阳剪碎金。\n茂密却遮西望眼，逍遥未有北归心。\n渊明盛说家园趣，谁信吾园趣更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陶子骏佚老堂","author":"孔武仲","text":"不逐渔商不问农，悠然今作鹿皮翁。\n地临白傅荒台畔，人在华胥乐国中。\n一榻远分庐阜月，两轩平揖广寒风。\n杖藜亦欲频还往，肯使清閒并属公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书","author":"孔武仲","text":"夜枕唯便睡，晨窗不展书。\n学文真渐懒，与世况全疏。\n老合耕山涧，恩容寄石渠。\n餐毡亦堪饱，不叹食无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"孔武仲","text":"剪断长翎入网罗，十年光景怨蹉跎。\n欲提长剑为游说，且卧空山学揣摩。\n砧杵夜寒醒醉梦，风霜秋紧役诗魔。\n不须计较当时事，黄卷书中宠辱多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄子由","author":"孔武仲","text":"江上匆匆别，孤舟谁与言。\n尘今生我甑，盗肯过君门。\n水石吴山好，风岚楚泽昏。\n相望欲命驾，何日为东辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄四舍弟","author":"孔武仲","text":"赣水南边北势回，层城中起郁孤台。\n忆初二陆同登此，喜有阿连相继来。\n旧事前游休感叹，清风佳景且徘徊。\n天涯未有从□日，百里区区亦象雷。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄会稽丞赵振道","author":"孔武仲","text":"龟峰琬琰翠成堆，轩槛前当秀色开。\n此地登临比图画，与君谈笑继樽罍。\n传闻佳景无时乏，依旧清江不断来。\n今日关河隔千里，相逢何处少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘贡甫","author":"孔武仲","text":"秀水先生今杰才，崎岖山径滞蓬莱。\n飞笺岳麓吟秋草，把酒襄阳醉臈梅。\n东郡政声无岂弟，南楼风月且徘徊。\n朝廷选用多英俊，早晚刘郎即到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张端父","author":"孔武仲","text":"与君生世共飘蓬，会面荒陂寂寞中。\n芳酒一樽留夜语，旅程千里倦春风。\n追思荐鹗门阑旧，默感跳丸岁月空。\n闻道束书游帝阙，偷閒应肯访衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄林次中","author":"孔武仲","text":"晓踏朱仙月，还思昨日诗。\n尚携漫刺谒，不爽故人期。\n宫阙觚棱失，山河向背移。\n悠悠芳草路，恰似别家时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄范清老","author":"孔武仲","text":"日挂西南有薄辉，棱棱霜气犯寒衣。\n不愁斗柄随春转，秪怕梅花学雪飞。\n湘浦波光频送别，湓城山色屡思归。\n高人只在南坡住，好共留钱买钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题丁子厚二亭 朋来亭","author":"孔武仲","text":"学有青衿聚，亭当绿野开。\n山川二湖曲，宾友四方来。\n乡行求如禹，师门欲望回。\n无轻十室小，长养即高才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题丁子厚二亭 睦亭","author":"孔武仲","text":"抚族无如睦，开亭意可知。\n庭阶尽兰玉，兄弟即埙篪。\n食有分甘乐，歌谐伐木诗。\n欢心己如此，风景况相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题徐季叔桂香亭","author":"孔武仲","text":"淮县筑居好，桂亭牵兴长。\n偶分岩下影，别有月中香。\n潇洒欺松竹，严凝耐雪霜。\n从君酌樽酒，岁晚玩幽芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜竹","author":"孔武仲","text":"老藓墙阴夕照间，何人折我翠琅玕。\n即兹绿叶随尘化，犹有低枝带露残。\n不放云梢侵霰雪，因嗟世故足波澜。\n故园未乏筼筜品，十顷繁阴六月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]