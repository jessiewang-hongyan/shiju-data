[{"title":"思王逢原三首 其三","author":"王安石","text":"百年相望济时功，岁路何知向此穷。\n鹰隼奋飞凰羽短，骐驎埋没马群空。\n中郎旧业无儿付，康子高才有妇同。\n想见江南原上墓，树枝零落纸钱风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思王逢原三首 其二","author":"王安石","text":"蓬蒿今日想纷披，冢上秋风又一吹。\n妙质不为平世得，微言唯有故人知。\n庐山南堕当书案，湓水东来入酒卮。\n陈迹可怜随手尽，欲欢无复似当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思王逢原三首 其一","author":"王安石","text":"布衣阡陌动成群，卓荦高才独见君。\n杞梓豫章蟠绝壑，骐驎騕袅跨浮云。\n行藏已许终身共，生死那知半路分。\n便恐世间无妙质，鼻端从此罢挥斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"王安石","text":"冉冉春行暮，菲菲物竞华。\n莺犹求旧友，雁不背贫家。\n室有贤人酒，门无长者车。\n醉眠聊自适，归梦到天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春风","author":"王安石","text":"一马春风北首燕，却疑身得旧山川。\n阳浮树外沧江水，尘涨原头野火烟。\n日借嫩黄初著柳，雨催新绿稍归田。\n回头不见辛夷发，始觉看花是去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒","author":"王安石","text":"春风满地月如霜，拂晓钟声到景阳。\n花底裌衣朝宿卫，柳边新火起严妆。\n冰残玉甃泉初动，水涩铜壶漏更长。\n从此暄妍知几日，便应鶗鴂损年芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"段约之园亭","author":"王安石","text":"爱公池馆得忘机，初日留连至落晖。\n菱暖紫鳞跳复没，柳阴黄鸟啭还飞。\n径无凡草唯生竹，盘有嘉蔬不采薇。\n胜事阆州虽或有，终非吾土岂如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独饭","author":"王安石","text":"窗明两不借，榻净一籧篨。\n栩栩幽人梦，夭夭老者居。\n安能问香积，谁可告华胥。\n独饭墙阴转，看云坐久如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸卯追感正月十五事","author":"王安石","text":"正月端门夜，金舆缥缈中。\n传觞三鼓罢，纵观万人同。\n警跸声如在，嬉游事已空。\n但令千载后，追咏太平功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神宗皇帝挽辞二首 其一","author":"王安石","text":"将圣由天纵，成能与鬼谋。\n聪明初四达，俊乂尽旁求。\n一变前无古，三登岁有秋。\n讴歌归子启，钦念禹功修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋风","author":"王安石","text":"揫敛一何饕，天机亦自劳。\n墙隈小翻动，屋角盛呼号。\n漠漠惊沙密，纷纷断柳高。\n江湖岂在眼，昨夜梦波涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴和冲卿","author":"王安石","text":"云浮朝惨淡，风起夜飕飗。\n欲作冰霜地，先回草树秋。\n征人倚笛怨，思妇向砧愁。\n为问随阳雁，哀鸣岂有求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜二首 其二","author":"王安石","text":"幔逗长风细，窗留半月斜。\n浮烟暝绿草，泫露冷黄花。\n独曳缘云策，仍寻度水槎。\n归时参夜半，邻犬静中哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜二首 其一","author":"王安石","text":"客卧书颠倒，虫鸣坐寂寥。\n残灯生暗晕，重露集寒条。\n真乐闲尤见，深禅静更超。\n此怀无与晤，拥鼻一长谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狄梁公陶渊明俱为彭泽令至今有庙在焉刁景纯作诗见示继以一篇","author":"王安石","text":"梁公壮节就夔魖，陶令清身托酒徒。\n政在房陵成底事，年称甲子亦何须。\n江山彭泽空遗像，岁月柴桑失故区。\n末俗此风犹不竞，诗翁叹息未应无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋露","author":"王安石","text":"日月凋何急，荒庭露送秋。\n初疑宿雨泫，稍怪晓霜稠。\n旷野将驰猎，华堂已御裘。\n空令半夜鹤，抱此一端愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草堂","author":"王安石","text":"草堂今寂寞，往事翳山椒。\n蕙帐空留鹤，萝衣终换貂。\n生皆堕天秩，隐或寄公朝。\n叠颖何劳怒，东风汝自摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荣上人遽欲归以诗留之","author":"王安石","text":"道人传业自天台，千里翛然赴感来。\n梵行毗沙为外护，法筵灵曜得重开。\n已能为我迂神足，便可随方长圣胎。\n肯顾北山如慧约，与公西崦斸莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贵州虞部使君访及道旧窃有感恻因成小诗","author":"王安石","text":"韶山秀拔江清写，气象还能出搢绅。\n当我垂髫初识字，看君挥翰独惊人。\n邮签忽报旌麾入，斋閤遥瞻组绶新。\n握手更谁知往事，同时诸彦略成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"退朝","author":"王安石","text":"门外鸣驺送响频，披衣强起赴鸡人。\n火城夜闇云藏阙，玉座朝寒雪被宸。\n邂逅欲成双白鬓，萧条难得两朱轮。\n犹怜退食亲朋在，相与吟哦未厌贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王大卿致政归江陵","author":"王安石","text":"九卿初命亚三司，朝吏相瞻得老师。\n南阙便还新印绶，东舟只载旧书诗。\n汉庭饯客无佳句，越水归装有富赀。\n回首千年见疏范，共疑今事胜当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王覃","author":"王安石","text":"分走人间十五年，尘沙吹鬓各苍然。\n山林渺渺长回首，儿女纷纷忽满前。\n知子有才思奋发，嗟余无地与回旋。\n相看一作秦吴别，身世何时两息肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王蒙州","author":"王安石","text":"请郡东南促去程，拍堤江水照红旌。\n仁声已逐春风到，使节犹占夜斗行。\n箭落皂雕毚兔避，句传炎海鳄鱼惊。\n麒麟不是人间物，汉诏先应召贾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王詹叔利州路运判","author":"王安石","text":"王孙旧读五车书，手把山阳太守符。\n未驾朱轓辞辇毂，却分金节佐均输。\n人才自古常难得，时论如君岂久孤。\n去去便看归奏计，莫嗟行路有崎岖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邓监簿南归","author":"王安石","text":"不见骊塘路，茫然四十春。\n长为异乡客，每忆故时人。\n水阅公三世，云浮我一身。\n濠梁送归处，握手但悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘贡父赴秦州清水","author":"王安石","text":"刘郎高论坐嘘枯，幕府调胹用绪馀。\n笔下能当万人敌，腹中尝记五车书。\n闻多望士登天禄，知有名臣荐子虚。\n且复弦歌穷塞上，祇应非晚召相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘和父奉使江西","author":"王安石","text":"刘郎今日拥旌麾，传到江南喜可知。\n上冢还须击羊豕，下车应不问狐狸。\n无人敢效公荣酒，为我聊寻逸少池。\n亦见岭头花烂熳，更将春色寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙子高","author":"王安石","text":"荡漾江南客，融怡席上珍。\n一樽相别酒，千里独归人。\n客路贫堪病，交情远更亲。\n自惭儿女意，失泪滴衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙立之赴广西","author":"王安石","text":"十年一别两相过，前想悲欢慷慨歌。\n穷去始知风俗薄，静来犹厌事机多。\n相期鼻目倾肝胆，谁伴溪山避网罗。\n万里辛勤君旧识，重江应亦畏风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送西京签判王著作","author":"王安石","text":"儿曹曾上洛城头，尚记清波绕驿流。\n却想山川常在梦，可怜颜发已惊秋。\n辟书今日看君去，著籍长年叹我留。\n三十六峰应好在，寄声多谢欲来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何圣从龙图","author":"王安石","text":"射策曾称蜀郡雄，朝廷重得汉司空。\n应留赐席丹涂地，误责飞刍紫塞功。\n三径欲归无旧业，百城先至有清风。\n潞山直与天为党，回首孙高想见公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何正臣主簿","author":"王安石","text":"何郎冰雪照青春，应敌皆言笔有神。\n鲁国儒人何独少，元君画史故应真。\n百年冠盖风云会，万里山川日月新。\n可但诸公能品藻，会须天子擢平津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别韩虞部","author":"王安石","text":"客舍街南初著巾，与君兄弟即相亲。\n当年岂意两家子，今日更为同社人。\n京洛风尘嗟阻阔，江湖杯酒惜逡巡。\n归帆岭北茫茫水，把手何时寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴龙图知江宁","author":"王安石","text":"才高明主眷方深，属郡闻风自革心。\n闾里不须多按治，山川从此数登临。\n茅檐坐隔云千里，柏垄初抽翠一寻。\n东望泫然知有寄，但疑公岂久分襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴叔开南征","author":"王安石","text":"掺袂不胜情，犀舟击汰行。\n倦游无万里，惜别有千名。\n春草凄凄绿，江枫湛湛清。\n金陵多丽景，此去属兰成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张仲容赴杭州孙公辟","author":"王安石","text":"万屋相誇漆与丹，笑歌长在绮纨间。\n綵船春戏城边水，画烛秋寻寺外山。\n忆我屡随游客入，喜君今赴辟书还。\n遥知曼倩威行久，赤笔应从到日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张宣义之官越幕二首 其二","author":"王安石","text":"谁谓贵公子，乃如寒士家。\n真宜举敦朴，已自胜浮华。\n洲荻藏迷子，溪篁拥若耶。\n相望只在眼，音问莫言赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张宣义之官越幕二首 其一","author":"王安石","text":"会稽游宦乡，海物错句章。\n土润箭萌美，水甘茶串香。\n今君诚暂屈，他日恐难忘。\n唯有西兴渡，灵胥或怒张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张卿致仕","author":"王安石","text":"子房筹策汉时功，身退超然慕赤松。\n馀烈尚能开后世，高材今复继前踪。\n执鞭始负平生愿，操几何知此地逢。\n窃食一官惭未艾，绪言方赖赐从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张甥赴青州幕","author":"王安石","text":"人情每期费，之子适予心。\n老饯城东陌，悲分岁暮襟。\n少留班露草，遂往隔云林。\n未觉青丘远，因风嗣好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张颉仲举知奉新","author":"王安石","text":"故人为邑士多称，繇赋宽赊狱讼平。\n老吏闭门无重糈，荒山开陇有新粳。\n方挥玉麈日边坐，又结铜章天外行。\n此去料君归不久，挟材如此即名卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李才元校理知邛州","author":"王安石","text":"朝廷孝治称今日，乡郡荣归及壮时。\n关吏相呼迎印绶，里儿争出望旄麾。\n北堂已足誇三釜，南亩当今识两歧。\n独我尚留真有命，天于人欲本无私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李太保知仪州","author":"王安石","text":"北平上谷当时守，气略人推李广优。\n还见子孙持汉节，欲临关塞抚羌酋。\n云边鼓吹应先喜，日下旌旗更少留。\n五字亦君家世事，一吟何以称来求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李质夫之陕府","author":"王安石","text":"平世求才漫至公，悠悠羁旅士多穷。\n十年见子尚短褐，千里随人今北风。\n户外屦贫虚自满，樽中酒贱亦常空。\n共嫌欲老无机械，心事还能与我同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李秘校南归","author":"王安石","text":"四十青衫更旅人，悠悠饥马傍沙尘。\n久留上国言空富，却走南州食转贫。\n自作诗书能见志，应知时命不关身。\n江湖胜事从今数，肯但悲歌寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李璋","author":"王安石","text":"湖海声名二十年，尚随乡赋已华颠。\n却归甫里无三径，拟傍胥山就一廛。\n朱毂风尘休怅望，青鞋云水且留连。\n故人亦见如相问，为道方寻木雁篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杜十八之广南","author":"王安石","text":"东南炎海外，寻访又输君。\n过岭猿啼暖，贪程马送曛。\n清谈消瘴疠，秀句起烟云。\n及早来乡荐，朝廷尚右文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨骥秀才归鄱阳","author":"王安石","text":"客舍风尘弊綵衣，悲吟重见雁南飞。\n荆山和氏方三献，太学何生且一归。\n旷野已寒谙独宿，长年多难惜分违。\n巾箱所得皆幽懿，亦见乡人为发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈兴宗察院出使湖南","author":"王安石","text":"谏书平日皂囊中，朝路争看一马骢。\n汉节饱曾冲海雾，楚帆聊复借湖风。\n皇华命使今为重，直道酬君远亦同。\n投老承明无补助，得为湘守即随公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈康知常州","author":"王安石","text":"作客兰陵迹已陈，为传谣俗记州民。\n沟塍半废田畴薄，厨传相仍市井贫。\n常恐劳人轻白屋，忽逢佳士得朱轮。\n慇勤话此还惆怅，最忆荆溪两岸春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送灵仙裴太博","author":"王安石","text":"一官留隐太常中，生事萧然信所穷。\n有力尚期当世用，无求今见古人风。\n邅回旧学皆残藁，邂逅相看各老翁。\n他日卜居何处好，溪山还欲与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送纯甫如江南","author":"王安石","text":"青溪看汝始蹁跹，兄弟追随各少年。\n壮尔有行今纳妇，老吾无用亦求田。\n初来淮北心常折，却望江南眼更穿。\n此去还知苦相忆，归时快马亦须鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏屯田广西转运","author":"王安石","text":"置将从来欲善师，百城蹉跌起毫釐。\n驱除久费兵符出，按抚纷烦使节移。\n恩泽易行穷苦后，功名常见急难时。\n孺文此日风流在，直笔他年岂愧辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈舜俞制科东归","author":"王安石","text":"诸贤发策未央宫，独得菑川一老翁。\n曲学暮年终汉相，高谈平日漫周公。\n君今壮岁收科第，我欲它时看事功。\n闻说慨然真有意，赠行聊似古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叔康侍御","author":"王安石","text":"诏取名郎入宪台，此时方急济时才。\n圣聪应已虚心待，奸党宁无侧目猜。\n白笔岂知权可畏，皂囊还请上亲开。\n伫闻谠论能医国，飞报频随驿骑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周仲章使君","author":"王安石","text":"看君东下霅溪船，回首纷纷已五年。\n簪笔少留吾所望，剖符轻去此何缘。\n高麾行路穿秦树，骏马归时著蜀鞭。\n子墨文章应满箧，承明宣室正详延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庞签判","author":"王安石","text":"北都两去不辞勤，仕路论材况出群。\n一相开藩尝负弩，三年通籍更从军。\n清谈犹得当时事，遗爱应从此日闻。\n我忆荆溪山最乐，看君摩翮上青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明州王大卿","author":"王安石","text":"大历才臣有此州，昆云今驾鹿轓游。\n从来所至邦人喜，真复能分圣主忧。\n千里封疆何足治，一时名迹故应留。\n属城旧吏虽疲懒，尚可挥毫敌李舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送河间晁寺丞","author":"王安石","text":"公孙富文墨，名字世多知。\n谈笑取高第，弦歌当此时。\n临河薪石费，近塞茧丝移。\n缓急常愁此，看君有所为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送直讲吴殿丞宰巩县","author":"王安石","text":"青嵩碧洛曾游地，墨绶铜章忽在身。\n拥马尚多畿甸雪，随衣无复禁城尘。\n古来学问须行己，此去风流定慰人。\n更忆少陵诗上语，知君不负巩梅春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送经臣富顺寺丞","author":"王安石","text":"故人为县楚江边，海角犹闻政事传。\n万井已安如赤子，一麾今去上青天。\n应开醉眼酴醾下，莫起归心杜宇前。\n报主代亲俱有地，几人忠孝似君全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郊社朱兄除郎东归","author":"王安石","text":"手持官牒出神皋，迎客遥知贺酒醪。\n照映里门非白屋，欺凌春草有青袍。\n宦游虽晚何妨久，饿显从来不必高。\n孝友父兄家法在，想能清白遗儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送复之屯田赴成都","author":"王安石","text":"槃礴西南江与岷，石犀金马世称神。\n桑麻接畛馀无地，锦绣连城别有春。\n结绶相随通籍久，推车此去辟书新。\n知君不为山川险，便忘吾家叱驭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送契丹使还次韵答净因老","author":"王安石","text":"老欲求吾志，时方摭我华。\n强将愁出塞，空得病还家。\n日转山河暖，风含草木葩。\n胜游思一往，不敢问三车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送彦珍","author":"王安石","text":"挟策穷乡满鬓丝，陂田荒尽岂尝窥。\n未应谷口终身隐，正合菑川举国推。\n握手百忧空往事，还家一笑即芳时。\n柘冈定有辛夷发，亦见东风使我知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]