[{"title":"偈颂一百六十首 其一二九","author":"释宗杲","text":"以字不成八字非，烁迦罗眼不能窥。\n一毛头上重拈出，忿怒那吒失却威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二八","author":"释宗杲","text":"福城东有大长者，居福城东海屿上。\n于不思议尘劫中，承事供养无数佛。\n善哉长者世希有，如优昙华时一现。\n发启广大真实心，创无佛处阿兰若。\n若昔智人建梵刹，折草插地即成就。\n此心坚固等须弥，或赞或毁不摇动。\n魔王军众数甚多，睹兹殊胜自摧伏。\n长者视身如浮云，变灭须臾不长久。\n当生佛国时节来，撒手便行不回顾。\n有子遵义起其家，志愿身心俱及第。\n仁者则寿语不诬，当知今亦未尝死。\n我来居是阿兰若，不见长者生遗恨。\n故说此偈聊发扬，同住如来寂灭海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二七","author":"释宗杲","text":"俊鹞不打篱边兔，猛虎终不食伏肉。\n毛头星现北斗前，把断天关并地轴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二六","author":"释宗杲","text":"夜来兔子赶大虫，天明走入无何有。\n月下珊瑚长数枝，万象森罗齐稽首。\n拄杖子，不唧?，渠侬却善分妍丑。\n李公烂醉绝倒时，元是张公吃村酒。\n报诸人，急回首，切忌痴狂外边走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二五","author":"释宗杲","text":"今夜唤明朝作来年，明朝唤今夜作去岁。\n即称来年今夜合来，既号去岁明朝合去。\n来年今夜不见来，去岁明朝定不去。\n既不来，又不去，业识茫茫无本据。\n大圆镜里绝纤尘，个中岂著闲家具。\n是则是，别又别，烁迦晃破秋天月。\n庞公不昧本来身，大似飞龙成跛鳖。\n尔诸人，瞥不瞥，灵利汉须看时节。\n五九尽处又逢春，衲僧脑后三斤铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二四","author":"释宗杲","text":"三十年来弄马骑，今朝却被驴儿攧。\n就地拾得丽水金，拈起却是新罗铁。\n报诸人，别不别。\n夜来雪压云门，冻得乌龟成鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二三","author":"释宗杲","text":"这僧有头无尾，明招有尾无头。\n若人道得头尾圆全句，云门与尔拄杖子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二二","author":"释宗杲","text":"香严透语渗漏，被语言缚杀。\n石霜透情渗漏，被情识使杀。\n曹山透见渗漏，被用闻觉知惑杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二一","author":"释宗杲","text":"多时不说禅，口边生白醭。\n大众苦相煎，便登曲录木。\n匪论五家宗，不引传灯录。\n才开两片皮，业因招薄福。\n释迦乾屎橛，达磨老臭秃。\n一人曲说直，一人直说曲。\n彼此大丈夫，肯受尔沸?。\n骂佛谤祖师，定入拔舌狱。\n佛祖生冤家，魔生真眷属。\n心地黑漫漫，口里水漉漉，似恁出家儿，定灭瞿昙族。\n腊月三十朝，大笑却成哭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一二○","author":"释宗杲","text":"休誇棒下无生忍，拨置当阳掣电机。\n未屙已前蓦提得，一击自然亡所知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一一八","author":"释宗杲","text":"或是或非人不识，逆行顺行天莫测。\n隔山人唱鹧鸪词，错认胡笳十八拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一一六","author":"释宗杲","text":"洞山万里一条铁，浏阳一击百杂碎。\n云门关字常现前，翠岩眉毛在不在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一一五","author":"释宗杲","text":"细不通风，大通车马。\n突出当阳，孰辨真假。\n虚空有把柄，无手人能把。\n跛驴蹋倒摘茶轮，草庵卸下琉璃瓦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一一三","author":"释宗杲","text":"南泉放倒，云门扶起。\n放倒扶起，有宾有主。\n明眼衲僧商量，切忌别作道理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一一二","author":"释宗杲","text":"有句无句，如藤倚树。\n孟八郎汉，便恁么去。\n机不到，语不副。\n眼里著得百千万亿须弥山，耳里著得无量无边香水海。\n机副语语投机，眼里著沙不得，耳里著水不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一一一","author":"释宗杲","text":"一年一度解，一年一度结。\n只是这个事，何须更多说。\n不多说，蹋著秤锤硬似铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一一○","author":"释宗杲","text":"老胡九年话堕，可惜当时放过。\n致令默照之徒，鬼窟长年打坐。\n这一个，那一个，更一个。\n虽然苦口叮咛，却似树头风过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一○九","author":"释宗杲","text":"一别二十年，蓦地又相见。\n如百炼精金，始终色不变。\n请我转法轮，增长菩提愿。\n直下绝狐疑，便悟本来面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一○八","author":"释宗杲","text":"十方法界至人口，法界所有即其舌。\n只凭此口与舌头，祝吾君寿无间歇。\n亿万斯年注福源，如海滉漾永不竭。\n师子窟内产狻猊，鸑鷟定出丹山穴。\n为瑞为祥遍九垓，草木昆虫尽欢悦。\n稽首不可思议事，喻若众星拱明月。\n故今宣畅妙伽陀，第一义中真实说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十四","author":"释宗杲","text":"今朝十月旦，为君重衍算。\n两个五日文，地来是一贯。\n顶门具眼人，记取这公案。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一○六","author":"释宗杲","text":"扑落非他物，纵横不是尘。\n山河及大地，全露法王身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一○五","author":"释宗杲","text":"乾峰洗面摸著鼻，云门吃饭咬著沙。\n二人蓦地相逢著，元来却是旧雠家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其四十三","author":"释宗杲","text":"秋江清浅时，白露和烟岛。\n良哉观世音，全身入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一○二","author":"释宗杲","text":"一百二十日禁足，三十五日在外走。\n熨斗煎茶铫不同，泥牛解作师子吼。\n今朝法岁已周圆，拈得鼻孔失却口。\n以大圆觉为伽蓝，七七依前四十九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一○一","author":"释宗杲","text":"今朝又是六月半，记得一则旧公案。\n拄杖子吞却法身，露柱在傍偷眼看。\n看不看，拈起秦时?轹钻。\n万别与千差，吾道一以贯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一○○","author":"释宗杲","text":"今朝又是五月五，大鬼拍手小鬼舞。\n蓦然撞著桃符神，两手椎胸叫冤苦。\n艾人云：休叫苦，只有一处堪回互。\n回互不回互，回而更相涉，不尔依位住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其九十七","author":"释宗杲","text":"一二三四五，五四三二一。\n返覆数千回，总不出今日。\n霜风刮地来，法身赤骨?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其九十五","author":"释宗杲","text":"人有心看月，月无心照人。\n有无成一片，方始得惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其九十四","author":"释宗杲","text":"万里无寸草，出门便是草，各自有公据。\n有公据，何拘束，清风月下守株人，凉兔渐遥春草绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其九十三","author":"释宗杲","text":"正说知见时，知见即是心。\n当心即知见，知见即如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其九十二","author":"释宗杲","text":"文远在驴粪中过夏，面赤不如语直。\n赵州贪他小利，赢得个糊饼。\n检点将来，也是普州人送贼。\n鹅王择乳，素非鸭类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其九十一","author":"释宗杲","text":"佛子住此地，则是佛受用。\n常在于其中，经行及坐卧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其八十九","author":"释宗杲","text":"善法堂前瑞气新，天书来自九重城。\n唯凭一句无私语，上祝吾皇亿万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其八十七","author":"释宗杲","text":"妙喜与师兄，俱是圜悟子。\n妙喜移住径山，师兄迁来在此。\n虽与师兄同条生，不与师兄同条死。\n八两与半斤，青红对碧紫。\n师兄解唱泥牛吼，师弟宁忘木马嘶。\n豁开顶上活人眼，鄮山山下是真归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其八十六","author":"释宗杲","text":"昨朝残腊尽，今日贺新年。\n虎逐牛方急，东君令已行。\n瑞雪已铺银世界，大家携手普贤门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其八十五","author":"释宗杲","text":"赵州东院西，密室烂如泥。\n窦八布衫穿，赤土画簸箕。\n檐头雨滴滴，鸡向五更啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其八十四","author":"释宗杲","text":"皎洁一轮，寒光万里。\n灵利者叶落知秋，傝?者忠言逆耳。\n休不休，已不已，小释迦有陷虎之机，老大虫却无牙齿。\n当时一蹋岂造次，蓦然倒地非偶尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其八十二","author":"释宗杲","text":"今朝七月五，打鼓普请看。\n万里无片云，犹欠一大半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其八十一","author":"释宗杲","text":"已著槽厂，将错就错。\n骑却圣僧，不妨快乐。\n龙象蹴蹋，非驴所作。\n堪笑诸方，妄生穿凿。\n休穿凿，祥麟只有一只角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七十九","author":"释宗杲","text":"今朝五月五，天降沛然雨。\n艾人与门神，聚头相耳语。\n雪窦禅师来，一口吞佛祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七十八","author":"释宗杲","text":"如人持尺量虚空，复有随行计其数。\n虚空边际不可得，吾君寿量亦如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七十六","author":"释宗杲","text":"今朝二月二十，又是清明寒食。\n灵云不见桃华，争信曲中有直。\n是曲耶，是直耶，多虚不如少实。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七十四","author":"释宗杲","text":"平常无生句，妙玄无私句，体明无尽句。\n一镞破三关，他家有本据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七十二","author":"释宗杲","text":"一年三百六十日，今朝又是从头起。\n人人有个主人公，水牛衔却老鼠尾。\n深沙欢，那吒喜。\n佛殿走出门去，僧堂撞入厨库里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七十一","author":"释宗杲","text":"丹霞烧木佛，院主眉须落。\n乌飞毛坠，鱼行水浊。\n要识真麒麟，只有一只角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七十","author":"释宗杲","text":"相逢不拈出，举意便知有。\n巍巍不动尊，脚不离地走。\n依稀似曲才堪听，又被风吹别调中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其六十九","author":"释宗杲","text":"高在绝顶，富在福严。\n乐在天堂，苦在地狱。\n谁知席帽下，元是昔愁容的。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其六十七","author":"释宗杲","text":"今朝又是端千节，文殊善财忙不彻。\n杀人活人药不灵，自添脑后三斤铁。\n观音妙智力，能救世间苦。\n是甚么，铁蛇钻入土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其六十六","author":"释宗杲","text":"文殊三处安居，志公不是闲和尚。\n迦叶欲行正令，未免眼前见鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其六十五","author":"释宗杲","text":"芭蕉无耳闻雷开，葵华无眼随日转。\n释迦老子亦无生，每岁今朝浴一遍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其六十三","author":"释宗杲","text":"镇州萝卜从来大，青州布衫斤两明。\n衲子聚头求的旨，却似蚊虻咬铁钉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其六十一","author":"释宗杲","text":"百二十日夏，日日无空缺。\n露柱逞神通，灯笼呈丑拙。\n彻不彻，却来棒头为汝决。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十九","author":"释宗杲","text":"摩竭提国犹在半途，少室峰前全无巴鼻。\n谈玄说妙好肉剜疮，举古明今抛沙撒土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十七","author":"释宗杲","text":"山前一片闲田地，元来记得在。\n叉手叮咛问祖翁，只为契券不分明。\n几度卖来还自买，难为牙保人，为怜松竹引清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十六","author":"释宗杲","text":"二尊宿，一人粗似丘山，一人细如米末。\n虽然粗细不同，称来轻重恰好。\n径山今日内实告报，汝等诸人切忌钻龟打瓦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十五","author":"释宗杲","text":"棒打石人头，曝曝论实事。\n不用作禅会，不用作道会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十三","author":"释宗杲","text":"大家泼一杓恶水，洗涤如来净边垢。\n垢尽众生烦恼除，狐狸便作师子吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十二","author":"释宗杲","text":"观音妙智力，能救世间苦。\n百华开烂熳，觑见没可睹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十一","author":"释宗杲","text":"驱耕夫之牛，夺饥人之食。\n趯翻大海水，拳倒须弥卢。\n生擒虎兕，活捉狞龙，犹未是衲僧本分事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其五十","author":"释宗杲","text":"无边刹境，自他不隔于毫端。\n十世古今，始终不离于当念。\n丈夫自有冲天志，休向如来行处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其四十八","author":"释宗杲","text":"今朝正月半，有则旧公案。\n点起数碗灯，打鼓普请看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其四十七","author":"释宗杲","text":"新岁击新鼓，普施新法雨。\n万物尽从新，一一就规矩。\n普贤大士欣欢，乘时打开门户。\n放出白象王，遍地无寻处。\n唯有这个，不属故新。\n等闲开口，吞却法身。\n千年桃核里，元是旧时仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其四十五","author":"释宗杲","text":"三个与四个，七个与八个。\n数目甚分明，无人数得过。\n既是数目分明，为甚么无人数得过。\n道士著白襕，且非真措大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其四十二","author":"释宗杲","text":"拆去东篱，补起西壁。\n径山门下，全无准的。\n有店的，谁委悉。\n僧堂觑破香积厨，鸱吻咬杀佛殿脊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其四十一","author":"释宗杲","text":"四月十五这公案，七月十五方结绝。\n即今这里许多人，人人有理难分雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其三十八","author":"释宗杲","text":"生是死之生，死是生之死。\n两路坦然平，无彼复无此。\n既无生死，又无彼此。\n明明百草头，明明祖师意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其三十七","author":"释宗杲","text":"何似生，莫妄想。\n直饶透出古今，也是猢狲伎俩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其三十六","author":"释宗杲","text":"四月二十五，久晴忽尔雨。\n竺士大仙心，东西密相付。\n这个犹是时节因缘，未是衲僧门下消息。\n北山老大虫，咬杀南山虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]