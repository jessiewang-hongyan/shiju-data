[{"title":"泊楚州锁外六首 其五","author":"张耒","text":"水榭疏帘秋夜凉，清歌一曲釂瑶觞。\n明朝回首高城处，只有西风却断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊楚州锁外六首 其四","author":"张耒","text":"流落相逢二十年，羞将白发对婵娟。\n如何见我都依旧，添得尊前一惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊楚州锁外六首 其三","author":"张耒","text":"襄王席上旧行云，二十年间生死分。\n可惜风流一抔土，年年春草断人魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊楚州锁外六首 其二","author":"张耒","text":"便风吹舫去无情，漫遣槎牙铁锁横。\n未叹客行鸥鸟远，五更吹角是高城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊楚州锁外六首 其一","author":"张耒","text":"满眼荒寒春未知，芳菲欲到野梅枝。\n东南近腊风烟好，美酒千钟鱼蟹肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绀碧","author":"张耒","text":"绀碧遥空秋意生，深檐当午暑风清。\n老翁睡起支颐坐，初听新蝉第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍圣甲戌侍立集英殿临轩试举人作此两绝 其一","author":"张耒","text":"春来小殿雪初残，晓日曈眬未破寒。\n黄伞当轩公事退，君王缓步侍臣阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍圣甲戌侍立集英殿临轩试举人作此两绝 其二","author":"张耒","text":"弱岁干名翰墨场，春寒摇笔试西厢。\n茫然二十年间事，还著春衣侍玉皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范增","author":"张耒","text":"君王不解据南阳，亚父徒誇计策长。\n毕竟亡秦安用楚，区区犹劝立怀王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试笔","author":"张耒","text":"学馆齑盐惊岁晚，寒窗书史伴身閒。\n年来轗轲甘言命，老去追随厌强颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试墨","author":"张耒","text":"金案冰窗净绝尘，砚寒龙尾縠生纹。\n澄江清浅汀洲静，忽有苍螭下吐云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贫病投劾乞补外官亲友问者以诗答之","author":"张耒","text":"卑如扬子官执戟，贫似玉川居洛阳。\n不敢弯弓轻妄射，争如覆被逐山郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采石阻雨寄宣城故人二首 其二","author":"张耒","text":"閒云浓淡作朝阴，柳色江头春已深。\n谁为宣城故人说，依依祇似去年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采石阻雨寄宣城故人二首 其一","author":"张耒","text":"风雨江头思故人，东南烟水湿青春。\n宛溪东岸垂杨树，想见烟眉亦解颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中题壁","author":"张耒","text":"去年此日泊瓜州，衰柳萧萧系客舟。\n白发天涯叹流落，今年对雨古宣州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后游朱园","author":"张耒","text":"绿叶阴阴护翠枝，晚花虽小亦应稀。\n东风不惜残桃李，吹作春愁处处飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨歇二首 其二","author":"张耒","text":"家童取酒冲泥至，酒满山瓶重莫携。\n老子欣然一笑起，开尝洗盏对山妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨歇二首 其一","author":"张耒","text":"雨歇山园竹引芽，老禅睡起日初斜。\n今朝却忆香严老，解点沩山一椀茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青桐道中值雨凡数里舟行久之颇有江湖之思二首 其二","author":"张耒","text":"冥冥烟外鸟飞归，野老得鱼收网回。\n隔浦断霞沉欲尽，半弯新月出云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青桐道中值雨凡数里舟行久之颇有江湖之思二首 其一","author":"张耒","text":"系马操舟问楫师，却疑淮口挂帆时。\n人间迁改何须问，便作江湖未可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鱼虾","author":"张耒","text":"一尺盆池数种荷，鱼虾亦解起风波。\n尔来未识天池乐，更有鲸鹏奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鱼虾相望","author":"张耒","text":"悲欢回首两茫然，忆别龙门又半年。\n应是旧时歌舞处，和风开冻一层天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临淮道中","author":"张耒","text":"凛凛春寒犯客裘，轻阴残雪放孤舟。\n无端惟有堤边柳，作态东风恼客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复答迎郭侯犊车之句","author":"张耒","text":"玉壶春酒射朝霞，只看纤腰不看花。\n但遣舟迎桃叶女，仍须恩赐短辕车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫人斜","author":"张耒","text":"青蛾皓齿作埃尘，玉匣珠衾地下身。\n一曲坏墙门不锁，林花开落墓前春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词效王建五首 其五","author":"张耒","text":"莲烛千枝夜宴迟，君王索笔写新诗。\n宫人和得争先进，偏爱宋家兄弟词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词效王建五首 其四","author":"张耒","text":"玉墀夜色昼昏昏，催放朝班散侍臣。\n随驾上楼同看雪，万重宫殿一时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词效王建五首 其三","author":"张耒","text":"昨夜新霜满玉阶，初冬处处火炉开。\n中官逐院传宣赐，南国诸侯进橘来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词效王建五首 其二","author":"张耒","text":"帘外微明烛下妆，殿门放钥待君王。\n玉阶地冷罗鞋薄，众里偷身倚御床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词效王建五首 其一","author":"张耒","text":"夜来霜重著栏干，玉殿无尘玉甃寒。\n日日君王罢朝早，禁廷无事一冬閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将之天长题新亭壁二首 其二","author":"张耒","text":"云捲山光到眼前，满川摇落早秋天。\n客来系马成何事，风雨寒窗一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将之天长题新亭壁二首 其一","author":"张耒","text":"新亭登眺解征鞍，飞鸟悠扬云意閒。\n谁谓尘埃无野兴，故乘风雨看秋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挂剑台","author":"张耒","text":"上国归来岁月深，悲嗟脱剑挂高林。\n欲知不负徐君意，便是当年让国心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春","author":"张耒","text":"磔牛门外色初分，共喜钗头彩胜新。\n花萼怯寒犹积雪，鸟声催报已知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事","author":"张耒","text":"禅宫门寂寂，庭草无行迹。\n东风自扫阶，疑是开帘客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事","author":"张耒","text":"虫飞丝堕两悠飏，人意迟迟日共长。\n春草满庭门寂寂，数棂窗日挂空堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀临汝园","author":"张耒","text":"西江逆上通清汝，凭仗双鱼致我词。\n若向池边见鸿雁，为言春至苦相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀淮阳六首 其六","author":"张耒","text":"城中万枝木芍药，姚黄一萼得春多。\n日日踏春浑坐此，人间无醉奈渠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀淮阳六首 其五","author":"张耒","text":"莽莽郊原带古丘，渐渐陇麦散羊牛。\n杏花杨柳春浓处，一片青帘慰客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀淮阳六首 其四","author":"张耒","text":"黄巢寨南琵琶沟，古原芳草静春流。\n大艑舸?何处客，樯竿西北是神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀淮阳六首 其三","author":"张耒","text":"最爱南城汲井园，春来蔬甲不胜繁。\n人家断处无鸡犬，迟日东风似古原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀淮阳六首 其二","author":"张耒","text":"灵通禅刹古丛林，永日惟闻钟梵音。\n阅世兴亡千室佛，百年风雨古墙金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀淮阳六首 其一","author":"张耒","text":"西城门外古壕清，太昊祠前春草生。\n早晚粗酬身计了，长为閒客此间行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日偶题四首 其四","author":"张耒","text":"白首伤春一老翁，预愁寒食过春中。\n下帘数点黄昏雨，一霎轻寒青杏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日偶题四首 其三","author":"张耒","text":"舍北小桃才及肩，可怜枝弱苦花繁。\n黄昏雨急东风恶，惜尔不禁春夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日偶题四首 其二","author":"张耒","text":"隔屋桃花暖斗妆，好风时有过墙香。\n满园芳草无人种，何事春来特地长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日偶题四首 其一","author":"张耒","text":"漫漫东风百草长，夭桃如笑柳如妆。\n惟凭酒作青春敌，收拾风光入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴","author":"张耒","text":"惊鸿瞥过不容攀，病眼淮边楚望寒。\n独卧孤舟对杨柳，春风终日在樯竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词二首 其二","author":"张耒","text":"霭霭芳园谁氏家，朱门横锁夕阳斜。\n鸠鸣鹊噪閒庭馆，尽日春风吹百花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词二首 其一","author":"张耒","text":"残红新绿间鞦韆，寒食园林人意阑。\n一阵春寒花上起，画廊连夜雨珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨中偶成四首 其四","author":"张耒","text":"春阴只与睡相宜，卧听鸣禽语复飞。\n一缕断香浮不散，何人深院昼熏衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨中偶成四首 其三","author":"张耒","text":"天低芳草接浮云，万柳含烟翠不分。\n燕子归时花遍落，暮云和雨入黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨中偶成四首 其二","author":"张耒","text":"槐叶青青染不如，护巢鸦语有新雏。\n萧萧晚雨窗鸣急，卧稳藜床玉枕书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨中偶成四首 其一","author":"张耒","text":"廉纤小雨作春愁，吹湿长云漫不收。\n架上酴醾浑著叶，眼明新见小花头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春宫","author":"张耒","text":"团金袍袖群长靴，寒食宸游乐事奢。\n风摆珠帘红幕润，满宫春雨落梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春蔬","author":"张耒","text":"新春书剑滞江城，又见南蔬入旅羹。\n关心太昊祠前路，小甲连畦带雪晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼卧口占二首 其二","author":"张耒","text":"扰扰终何得，萧萧亦自如。\n将求解牛道，要解斲轮书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼卧口占二首 其一","author":"张耒","text":"人事日益远，秋居何飒然。\n苔随墙半雨，叶放树中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼卧口占三首 其三","author":"张耒","text":"学道穷年要有得，强颜干世欲何求。\n病栽薏苡无劳谤，湿要鞠藭不待搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼卧口占三首 其二","author":"张耒","text":"甘风远集闻朝嘒，怨月深栖有夜鸣。\n凉牖疏明稀老翠，雨畦幽独立新清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼卧口占三首 其一","author":"张耒","text":"康济朝饥进汤饼，谁何午睡属新茶。\n读书隐几聊复尔，谢客扃门岂不佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山杂诗四首 其四","author":"张耒","text":"九月江城霜气清，旅人寒事略经营。\n隔窗便是山前树，永夜叶声如雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山杂诗四首 其三","author":"张耒","text":"断涧横桥卧古槎，晚鸡鸣处有人家。\n山头月出疏钟断，江上风高落雁斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山杂诗四首 其二","author":"张耒","text":"萧萧茅屋土山前，翁媪关门去穫田。\n朝日满檐鸡犬静，荻篱深处有炊烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山杂诗四首 其一","author":"张耒","text":"幽人睡足戴纶巾，策杖开门卯酒醺。\n黄叶满山乌鹊嗓，江城秋日少行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山春望","author":"张耒","text":"先教一雨净江山，便放千林春意还。\n何事东风吹客雁，便教无意恋汀湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残春三绝 其一","author":"张耒","text":"低檐送雨晚霏微，湿透梅房白渐肥。\n半捲画帘屏扇掩，朦胧春睡拥春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洛岸春行二首 其二","author":"张耒","text":"南山晴翠入波光，一派溪声绕郭长。\n最爱早春沙岸暖，衮风轻浪拍鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洛岸春行二首 其一","author":"张耒","text":"溪上映人杨柳黄，满溪流水碧泱泱。\n凭君莫向溪南望，春草春风能断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看花","author":"张耒","text":"风暖日高花气动，鸣鸠乳燕自求群。\n经营美景还诗匠，倾扫顽愁赖酒军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日二首 其一","author":"张耒","text":"一庭秋色清如水，篱落萧条日脚残。\n忽忆淮阳旧庭院，出邻高叶翠梧寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日二首 其二","author":"张耒","text":"黄帘朱户狭洞房，何事易知独难忘。\n相思故人云间月，凉夜皎皎出东厢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊南井口期任遵圣长官，到晚不及见，复来","author":"苏轼","text":"江上有微径，深榛烟雨埋。\n崎岖欲取别，不见又重来。\n下马未及语，固已慰长怀。\n江湖涉浩渺，安得与之偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事三首 其三","author":"张耒","text":"萧萧衰草傍墙生，中有寒虫白日鸣。\n秋物荒凉禾稼熟，悠悠驱马水边行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事三首 其二","author":"张耒","text":"萧条岁晚搔双鬓，流落天涯念旧游。\n惟有醉来心暂展，无钱沽酒合长愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事三首 其一","author":"张耒","text":"支离卧病不知秋，暑退初惊大火流。\n蟋蟀知时鸣近壁，银河照夜直当楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋末圭窦斋前菊盛开赋得绝句时秬出未归","author":"张耒","text":"幽斋谁与破穷愁，蜀锦当轩烂不收。\n白帝属车千万乘，玉轮金毂照清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜","author":"张耒","text":"微云淡月夜朦胧，幽草虫鸣树影中。\n不待南城吹鼓角，桐声长报五更风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜寄远","author":"张耒","text":"秋晚萧条风露清，星河耿耿漏丁丁。\n祇应新月频相见，长向玉楼东畔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]