[{"title":"对酒","author":"陆游","text":"社醅又借醉颜酡，手挽邻翁作浩歌。\n江月偏能照蓬户，京尘终不污渔蓑。\n苦吟且复攲吾帽，对弈真当烂汝柯。\n回首纷纷俱梦耳，人间何处有天魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒二首 其一","author":"陆游","text":"素月度银汉，红螺斟玉醪。\n染丹梨半颊，斫雪蟹双螯。\n诗就吟逾苦，杯残兴尚豪。\n闲愁剪不断，剩欲借并刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒二首 其二","author":"陆游","text":"密污持苫屋，寒芦用织帘。\n彘肩柴熟罨，莼菜豉初添。\n黄甲如盘大，红丁似蜜甜。\n街头桑叶落，相唤指青帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒示坐中","author":"陆游","text":"绿橙丹柿斗时新，一笑聊誇老健身。\n大度乾坤容纵酒，多情风月伴垂纶。\n初生京洛逢时泰，幼度江淮避虏尘。\n八十年间穷不死，犹能涧底束荆薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒戏作","author":"陆游","text":"去日奔轮不啻过，凌烟勋业已蹉跎。\n只言一寸丹心在，无奈千茎白发何。\n色比鹅雏京口酒，声如珠贯渭城歌。\n身闲取醉真当勉，莫学痴人梦蚁窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒作","author":"陆游","text":"凭阁风吹帽，穿林雨垫巾。\n相呼十日饮，不负百年身。\n陌上金羁马，坟前石琢麟。\n于吾竟何有，笑杀武陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒作","author":"陆游","text":"饮酒豪如卷白波，遣愁难似塞黄河。\n多闻只解为身累，后死空令见事多。\n未试神仙餐玉法，且赓壮士入关歌。\n此心不道无人识，雪鬓萧萧奈老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对镜","author":"陆游","text":"岁月虽遄迈，形容未苦癯。\n发如新沐润，颜似半酣朱。\n书读常终卷，山行亦却扶。\n悠悠随日过，不复叹头颅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"市饮","author":"陆游","text":"学道无多事，消阴服众魔。\n春雷惊蛰户，海日浴鲸波。\n大勇收全胜，灵襟袭太和。\n何妨会稽市，取酒独酣歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"布金院","author":"陆游","text":"万里西来了宿缘，凭鞭攲帽过年年。\n山寒院落开炉月，霜重郊原斸芋天。\n浅碧鳞鳞人度彴，长空杳杳鸟冲烟。\n夜投萧寺清无寐，楼角三更月满川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平云亭","author":"陆游","text":"满榼芳醪何处倾，金鳌背上得同行。\n天垂绿野三边尽，云与朱阑一样平。\n烟树微茫疑误墨，风松萧瑟有新声。\n黄花未吐无多恨，也胜湘累拾落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平水小憩","author":"陆游","text":"蓐食草庵中，肩舆小市东。\n雾收山淡碧，云漏日微红。\n酒旆村场近，罾船浦溆通。\n平生喜行路，小住莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平水道中","author":"陆游","text":"处处陂水满，家家巢燕忙。\n叶舒桑渐闇，穗重麦初昂。\n高下山花发，青红粉饵香。\n亦知时节好，老大自悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平生","author":"陆游","text":"平生涉世似虚舟，不著胸中一点愁。\n已用浮云看富贵，肯缘华屋叹山丘。\n戴溪寒酿千峰雪，严濑声酣七里秋。\n好景人间随处有，未埋白骨且闲游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平昔","author":"陆游","text":"平昔飘然林下僧，更堪衰与病相乘。\n残年已任身生死，一念犹关道废兴。\n皎皎初心质天地，兢兢晚节蹈渊冰。\n子孙勿厌藜羹薄，此是吾家无尽灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归三山入秋益凉欣然有赋","author":"陆游","text":"药物扶持美食眠，镜湖仍遇素秋天。\n一年强起归犹健，百口相看喜欲颠。\n碧瓦朱甍无杰屋，乌篷画楫有新船。\n道山顶上虽清绝，万顷烟波始是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归云门","author":"陆游","text":"万里归来值岁丰，解装乡墅乐无穷。\n甑炊饱雨湖菱紫，篾络迎霜野柿红。\n坏壁尘埃寻醉墨，孤灯饼饵对邻翁。\n微官行矣闽山去，又寄千岩梦想中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归兴二首 其二","author":"陆游","text":"古道迢迢人迹稀，羸骖攲帽远村归。\n正看日暮羊牛下，又见月明乌鹊飞。\n僧院疏钟出林岫，渔家微火耿窗扉。\n闲游要是幽人事，草露从教湿短衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归兴二首 其一","author":"陆游","text":"轻雷轣辘断梅初，残箨纵横过笋馀。\n饱有期程新买犊，睡无厌足久捐书。\n白蘋满渚闲挥榜，绿树连村独跨驴。\n夏日尽长归亦暮，水边灯火已疏疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归次汉中境上","author":"陆游","text":"云栈屏山阅月游，马蹄初喜蹋梁州。\n地连秦雍川原壮，水下荆杨日夜流。\n遗虏孱孱宁远略，孤臣耿耿独私忧。\n良时恐作他年恨，大散关头又一秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归次樊江","author":"陆游","text":"芳草东西路，绿杨长短亭。\n人生岂匏系，吾志本鸿冥。\n征袖朝沾雨，归帆夜戴星。\n长鱼幸能买，且复倒残瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归老","author":"陆游","text":"归老何妨驾鹿车，平生风雪惯骑驴。\n鬓毛白尽犹耽酒，目力衰来转爱书。\n止足极知于道近，痴顽更喜与人疏。\n著身莫怪无闲处，地肺天台尽有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归耕","author":"陆游","text":"随牒人间鬓欲疏，归耕且复补东隅。\n甑炊地碓新舂米，衣拆天吴旧绣图。\n有圃免烦官送菜，叩门翻喜吏徵租。\n不愁问字无来客，惟欠扬雄宅一区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊午元日读书至夜分有感二首 其二","author":"陆游","text":"强戴罗幡怯岁增，光阴堪叹捷飞腾。\n檐间点滴新春雨，窗下青荧半夜灯。\n傍架讨寻书散乱，倚屏吟啸发鬅鬙。\n极知老境惟当佚，绝学端居恨未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊午元日读书至夜分有感二首 其一","author":"陆游","text":"七十年来又四年，雨声灯影故依然。\n未收浮世风沤梦，尚了前生蠹简缘。\n老学辛勤那有补，旧闻零落恐无传。\n先师钵袋终当付，叹息谁能共著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊午重九","author":"陆游","text":"朋旧相望天一涯，登高结伴只邻家。\n秋风自欲吹纱帽，衰鬓何曾泥菊花。\n药市神仙思益部，糕盘节物记京华。\n自怜病后欢悰薄，小醉归来日未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊申元日","author":"陆游","text":"白头身世叹羁孤，一念儿时泪已濡。\n尚记争先书郁垒，岂知落后举屠苏。\n杯盘草草思邻舍，车马纷纷厌九衢。\n六十年非心自了，挂冠犹足补东隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊辰立春日二首 其二","author":"陆游","text":"卧听城门出土牛，罗幡应笑雪蒙头。\n但须晨起一卮酒，聊洗人间千种愁。\n处处楼台多侠客，家家船舫待春游。\n梅花未遍枝南北，定为馀寒得小留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊辰立春日二首 其一","author":"陆游","text":"昨夜风摇斗柄回，典衣也复一传杯。\n故人久作天涯别，新句空从枕上来。\n清镜岂堪看鬓色，小园剩欲觅桃栽。\n颓然却恨贪春睡，不尽城头画角哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧在成都初春无事日访昭觉保福正法诸刹甚可乐也追怀慨然因赋长句","author":"陆游","text":"忆在西川集宝坊，幅巾萧散日初长。\n伊蒲塞馔分香积，优钵罗花散道场。\n客路逢春增感慨，旧游回首已微凉。\n新晴强作寻幽计，有底文书作许忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧识姜邦杰于亡友韩无咎许近屡寄诗来且以无咎平日倡和见示读之怅然作此诗附卷末","author":"陆游","text":"故人玉骨已生苔，邂逅逢君亦乐哉。\n湖寺系舟无梦去，京尘驰骑有诗来。\n醉中不敢教儿诵，看处常须浴手开。\n久矣世间无健笔，相期力干万钧回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"末题二首 其一","author":"陆游","text":"平日尤闲老更闲，一毫世事岂相关。\n孤云不散来归岫，细水无声自出山。\n支径过僧才百步，小楼藏药可三间。\n客来不肯通名姓，熟视吾庐为破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"术家言予今岁畏四孟月而秋尤甚自初秋小疾屡作戏题长句","author":"陆游","text":"一生强半卧穷阎，粝饭藜羹似蜜甜。\n耄齿觉衰嗟已晚，孟秋属疾信如占。\n危途本自难安步，恶石何妨更痛砭。\n坚忍莫为秋雨叹，牵萝犹足补茅苫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月二十八日大雪过若耶溪至云门山中","author":"陆游","text":"山中看雪醉骑驴，清赏真成十载无。\n高压孤峰增峭绝，斜倾丛竹失枝梧。\n松肪火暖眠僧榻，芋糁羹香拥地炉。\n病骨虽癯犹健在，未应遽作卧游图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月二十日晨起弄笔","author":"陆游","text":"深院窗扉晓色迟，新愁宿醉两参差。\n雨声欲与梦相入，春意不随人共衰。\n零落残梅临小彴，纵横野水赴清池。\n物华撩我缘何事，似恐新年渐废诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月二日晨出大东门是日府公宴移忠院","author":"陆游","text":"成都春事早，开岁已暄妍。\n爁尾传杯后，遨头出郭前。\n争门金騕袅，满野绣辎軿。\n白发花边醉，何妨似少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十六日园中偶赋","author":"陆游","text":"又向柴荆过上元，豪华前事不须论。\n偶逢花发闲持酒，不得人扶懒出门。\n薄技号山曾献玉，荣途染指亦尝鼋。\n年来洗尽东陵梦，瓜垄萧萧老故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十六日送子虡至梅市归舟示子遹","author":"陆游","text":"策府还山白尽头，一廛随分葺菟裘。\n看灯虽幸新春健，无食犹怀卒岁忧。\n稚子与翁俱袯襫，大儿出塞习兜鍪。\n它时别作谋生计，卖药惟当学伯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十五日出郊至金石台二首 其一","author":"陆游","text":"渐老惜时节，思游那可忘。\n雪晴天浅碧，春动柳轻黄。\n笑语宽衰疾，登临到夕阳。\n未须催野渡，聊欲据胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十五日出郊至金石台二首 其二","author":"陆游","text":"开岁多休暇，官身亦暂闲。\n楼台先昼永，花柳向春悭。\n啼鸟随游辔，和风惬醉颜。\n更怜归路好，破墨数峰山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月五日出游","author":"陆游","text":"久作闲人不惯愁，新春天气更清柔。\n未为辽海千年别，且继斜川五日游。\n细柳拂头穿野径，落梅黏袖上渔舟。\n此身定去神仙近，倚遍江南卖酒楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正旦后一日","author":"陆游","text":"七十今年是，连朝乐未休。\n比邻更颂祷，亲党共迟留。\n羊映红缠酒，花簪绛帕头。\n从今日有喜，农事起西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉笈斋书事二首 其二","author":"陆游","text":"雪霁茆堂钟磬清，晨斋枸杞一杯羹。\n隐书不厌千回读，大药何时九转成。\n孤坐月魂寒彻骨，安眠龟息浩无声。\n剩分松屑为山信，明日青城有使行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉笈斋书事二首 其一","author":"陆游","text":"莫笑新霜点鬓须，老来却得少工夫。\n晨占上古连山易，夜对西真五岳图。\n叔夜曾闻高士啸，孔宾岂待异人呼。\n眉间喜色谁知得，今日新添火四铢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉牒所迎驾望见周洪道舍人","author":"陆游","text":"自卜河桥宅，清谈喜屡陪。\n今年见腾踔，不恨老氛埃。\n晓放宫门钥，霜彫辇路槐。\n班回独小立，为待绣鞍来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生日子聿作五字诗十首为寿追怀先亲泫然有作","author":"陆游","text":"我生尚及宣和末，颁历频惊岁月移。\n负米养亲无复日，蓼莪废讲岂胜悲。\n渡江百口今谁在，抱恨终身祇自知。\n文字虚名何足道，樽前愧汝十章诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生涯四首 其二","author":"陆游","text":"身世茫如梦，门庭冷似冰。\n逢迎卖药叟，辞谢乞钱僧。\n羸疾时时剧，衰颜日日增。\n人扶亦可出，要是藉乌藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生涯四首 其三","author":"陆游","text":"旧业桑麻在，颓龄耄耋过。\n虞卿著书晚，伏叟授经讹。\n井上磨樵斫，村东买钓蓑。\n倾身营一饱，自笑又蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生涯","author":"陆游","text":"久矣冥行堕崄巇，乐哉偶得谢招麾。\n放怀身世相忘地，夙驾山林独往时。\n纵老岂容妨痛饮，更慵亦未废新诗。\n超然自喜生涯别，始叹龟堂见事迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生涯四首 其四","author":"陆游","text":"残年端有几，寂寞寄沧洲。\n鸟宿千林暮，虫鸣四壁秋。\n风廊动砧杵，月垄把锄耰。\n衣食随宜具，何心复浪求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生涯四首 其一","author":"陆游","text":"生涯数畦菜，心事一溪云。\n樵担斜阳下，渔歌静夜闻。\n门无俗驾到，厨有远泉分。\n但了曲糵事，功名乌足云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用短","author":"陆游","text":"用短定非痴，爱闲真复奇。\n饭香贫始觉，睡味老偏知。\n畦地闲栽药，留僧静对棋。\n馀年犹有几，舍此欲何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子立春前二日作","author":"陆游","text":"头风初愈喜身轻，书卷时开觉眼明。\n养熟犬鸡随坐起，性灵乌鹊报阴晴。\n韭菘饤饾春盘好，芝朮筛和腊药成。\n自笑衰残杀风景，灯时不拟入重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子岁十月二十四日夜半梦遇故人于山水间饮酒赋诗既觉仅能记一二乃追补之二首 其二","author":"陆游","text":"小山缘曲涧，路断得藤阴。\n忽遇平生友，重论一片心。\n兴阑棋局散，意豁酒杯深。\n鸡唱俄惊觉，凄然泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子岁十月二十四日夜半梦遇故人于山水间饮酒赋诗既觉仅能记一二乃追补之二首 其一","author":"陆游","text":"拂衣金马门，税驾石帆村。\n唤起华山梦，招回湘水魂。\n心亲频握手，目击欲忘言。\n最喜藤阴下，翛然共一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子岁元日","author":"陆游","text":"饮罢屠苏酒，真为八十翁。\n本忧缘直死，却喜坐诗穷。\n米贱知无盗，云阴又主丰。\n一箪那复虑，嬉笑伴儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲午十一月十三夜梦右臂踊出一小剑长八九寸有光既觉犹微痛也","author":"陆游","text":"少年学剑白猿翁，曾破浮生十岁功。\n玉具拄颐谁复许，蒯缑弹铗老犹穷。\n床头忽觉蛟龙吼，天上方惊牛斗空。\n此梦怪奇君记取，佩刀犹得世三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲辰中秋无月十七夜独皦然达旦","author":"陆游","text":"老觉人间无一欣，穷阎扫轨谢纷纷。\n已凭白露洗明月，更遣清风收乱云。\n栖鹊拣枝寒未稳，断鸿呼伴远犹闻。\n病羸慵踏梧桐影，倚柱长吟夜向分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曳策","author":"陆游","text":"慈竹萧森拱废台，醉归曳策一徘徊。\n纷纷落日牛羊下，黯黯长空霰雪来。\n三峡猿催清泪落，两京梅傍战尘开。\n客怀已是凄凉甚，更听城头画角哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发","author":"陆游","text":"白发千茎绿鬓稀，卧看鹓鹭刺天飞。\n平生窃鄙贡公喜，故里但思陶令归。\n清坐了无书可读，残年赖有佛堪依。\n君看世事皆虚幻，屏酒长斋岂必非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发","author":"陆游","text":"萧萧白发濯沧浪，剡曲西南一草堂。\n饮水读书贫亦乐，杜门养病老何伤。\n已成五亩扶犁叟，谁记三朝执戟郎。\n正似篱边数枝菊，岁残犹复耐冰霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发","author":"陆游","text":"白发今年一倍增，闭门养此老无能。\n牛羊被野霜天晚，禾稼连云岁事登。\n未午舂炊馀脱粟，乍寒包裹有粗缯。\n自怜未废诗书业，父子蓬窗共一灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白帝泊舟","author":"陆游","text":"客路闲无事，津亭爽有馀。\n峡江春涨减，瀼岸夜灯疏。\n老矣孤舟里，依然十载初。\n倦游思税驾，更觉爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白首","author":"陆游","text":"白首称祠吏，清时作幸民。\n招呼林下客，游戏梦中身。\n山路乌骡稳，烟波画楫新。\n村村有花柳，无事即寻春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白首","author":"陆游","text":"白首归来老故园，索居情味更堪论。\n关河悠邈梦魂到，亲旧凋零书札存。\n身病自怜诗思退，家贫客笑酒醅浑。\n昏昏只欲投床睡，儿劝孙扶强出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]