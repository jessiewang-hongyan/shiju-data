[{"title":"雁山总题此山本朝方显 其二","author":"戴复古","text":"几山兼几水，更有几烟霞。\n不立仙人宅，都为释氏家。\n宾秋多少雁，报晓一双鸦。\n有此山林胜，如何在海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩张亭","author":"戴复古","text":"此地曾栖双凤凰，登高怀古北风凉。\n忠规万乘龙颜粲，谪遇千山鸟道荒。\n百里邻居天作合，两贤名与日争光。\n几人缄口贪官职，身在朝廷志已忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感寓三首 其三","author":"戴复古","text":"自觉心无愧，何须座右铭。\n人将金作坞，吾以石为屏。\n年老医难疗，天寒酒易醒。\n菊花香到死，不肯就飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感寓三首 其二","author":"戴复古","text":"谊利不同道，盛衰何用疑。\n布衣甘寂寞，纨裤自矜持。\n勿谓人为巧，待观天定时。\n铜山或饿死，富贵五羊皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感寓三首 其一","author":"戴复古","text":"古今通一理，趋向自多门。\n贤士玉成美，贪夫金注昏。\n谁知身是患，人以道为尊。\n前辈□□死，姓名千载存。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈云避暑","author":"戴复古","text":"相邀避暑到慈云，细听诸君讲见闻。\n六月美宣歌北伐，五弦思舜奏南薰。\n不忧冷澹无欢伯，自致清凉有此君。\n想像当时河朔饮，樽前不用著红裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新安寒食","author":"戴复古","text":"不拟今年到歙州，要知行止岂人谋。\n一百五日客怀恶，三十六峰春雨愁。\n老矣此身犹道路，凄其归梦绕松楸。\n花瓢仙子无由见，千里江山负远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新岁书怀四首 其四","author":"戴复古","text":"正月复二月，百年如一年。\n世间人易老，天下事难全。\n生计麦十斛，传家诗几篇。\n眼前虽不足，心地自超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新岁书怀四首 其三","author":"戴复古","text":"老病从人笑，儿童识我谁。\n穷愁无地著，心事有天知。\n鹊噪缘何喜，蛙鸣岂为私。\n如何得怀抱，长似醉眠时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新岁书怀四首 其二","author":"戴复古","text":"七十九岁叟，时吟感寓诗。\n年高胡不死，身健欲何为。\n细柳绿垂地，小桃红满枝。\n春风不到处，枯蔓挂疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新岁书怀四首 其一","author":"戴复古","text":"衰年百病身，淳祐五年春。\n尘世自多事，风光又一新。\n乡人方拜相，野客自垂纶。\n说与烟波侣，海滨非渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新年多雨一日晴色可喜","author":"戴复古","text":"一晴良可喜，始觉好新年。\n绿涨春前水，青开雨后天。\n看花吾老矣，把酒兴悠然。\n病脚妨行乐，三杯归醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新年自唱自和 其三","author":"戴复古","text":"江山一夜雨，花柳九州春。\n过节喜无事，谋欢要及辰。\n年年仍岁岁，故故复新新。\n把酒有馀恨，无从见古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新年自唱自和 其一","author":"戴复古","text":"圣朝开宝历，淳祐四年春。\n生自前丁亥，今逢两甲辰。\n黄粱一梦觉，青镜二毛新。\n七十八岁叟，乾坤有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新年自唱自和 其二","author":"戴复古","text":"死灰无复暖，槁木不逢春。\n近日愁多病，今年岁在辰。\n处喧如处寂，求旧不求新。\n笑问长河水，谁为不老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新喻县苏晋叔相会","author":"戴复古","text":"偶作榆溪客，还逢橘井仙。\n多才出人上，笑我老吟边。\n买锦囊诗卷，典衣供酒钱。\n竹林青眼叔，常说仲容贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新朝士多故人愁吟寄之","author":"戴复古","text":"野鹿自由性，孤鸿不就群。\n飘零生白发，故旧半青云。\n忧国家何有，愁吟天不闻。\n北风吹汉水，胡骑政纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简陈叔方问病","author":"戴复古","text":"闻君卧病知何病，医者难从脉上寻。\n自是读书多损气，或缘忧国重惊心。\n饱参妙理床头易，细写幽怀膝上琴。\n蛇影无疑自无恙，此方何止直千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简曾才叔","author":"戴复古","text":"虚庭贮明月，酒醒独登楼。\n偶逐一笑乐，遂成三夕留。\n乌鸦工报晓，蟋蟀早吟秋。\n欲赴东溪约，烦君具小舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罪言","author":"戴复古","text":"盗贼干戈后，安知有太平。\n众人皆竞利，百姓不聊生。\n国用何能足，官曹未易清。\n汉家政虚耗，第一莫言兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"裘司直见访留款","author":"戴复古","text":"清风为我拂尘襟，坐听先生说古今。\n道谊欲灰伤世变，利名如海溺人深。\n一言可重轻双璧，片善相资直万金。\n闻道门墙不多远，明朝修敬到山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解后乐清主簿姜昌龄一见如平生欢同宿能仁","author":"戴复古","text":"雁去荡犹在，龙居山亦灵。\n高峰穿碧落，虚谷吸沧溟。\n愁见僧头白，喜逢君眼青。\n灯前闻妙语，字字摘天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉熙己亥大旱荒庚子夏麦熟 其四","author":"戴复古","text":"琐琐饥年事，骎骎谷价高。\n人将委沟壑，谁肯发仓廒。\n涸沼鱼枯死，荒村犬饿号。\n与人同一饱，安得米千艘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉熙己亥大旱荒庚子夏麦熟 其一","author":"戴复古","text":"四野萧条甚，百年无此荒。\n早禾遭夏旱，晚稻被虫伤。\n富室无储粟，农家已绝粮。\n逢人相告语，生理尚茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉熙己亥大旱荒庚子夏麦熟 其二","author":"戴复古","text":"旱潦并为虐，三农哭岁饥。\n当秋谷价贵，出广米船稀。\n救死知吾拙，谋生恐计非。\n固穷君子事，办采北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉熙己亥大旱荒庚子夏麦熟 其五","author":"戴复古","text":"濒海数十里，饥民及万家。\n雨多忧坏麦，春好忍看花。\n凿浅疏田水，占晴视晚霞。\n老农如鬼瘦，不住作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉熙己亥大旱荒庚子夏麦熟 其三","author":"戴复古","text":"饿喙偏生事，空言不疗饥。\n谁知岁丰歉，实系国安危。\n世变到极处，人心无藉时。\n客来谈盗贼，相对各愁眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉熙己亥大旱荒庚子夏麦熟 其六","author":"戴复古","text":"积雨喜新霁，山禽亦好音。\n白云开旷野，红日照高林。\n歉岁地惜宝，惠民天用心。\n君看大麦熟，颗颗是黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静斋张敏则舍人赠诗因用其韵为酬","author":"戴复古","text":"胸次诗书一派清，学如耕稼到秋成。\n十年闭户存吾道，万事无心逐世情。\n叶落花开关气数，山长水远是功名。\n摩挲老眼看新贵，九鼎鸿毛孰重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静寄孟运管招客皆藏春侍郎故人因与花翁孙季蕃话旧有感","author":"戴复古","text":"来访藏春宅，因登静寄堂。\n异香薰宝鼎，清乐送瑶觞。\n穿竹过花所，寻梅见海棠。\n白头思往事，无语立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樱桃","author":"戴复古","text":"绿树带朱实，驱禽费弹丸。\n独先诸果熟，堪奉五侯餐。\n猩肉和琼液，蠙珠走玉盘。\n同时得同赏，芍药满雕栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滕王阁次韵刘允叔","author":"戴复古","text":"消遣客怀寻胜事，酒杯诗卷得同携。\n当年杰阁栖龙子，今日空梁落燕泥。\n斜照浴红秋水上，好山横碧画栏西。\n几人登览皆磨灭，唯有前峰压不低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滕审言相遇话旧","author":"戴复古","text":"忆昨同君访月林，几年相别到于今。\n江山花草生诗梦，风雨忧愁长道心。\n久矣无波观古井，悠然得趣听鸣琴。\n一生奔走成何事，尘满征衫雪满簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕲州上官节推同到浮光","author":"戴复古","text":"马蹄相逐到浮光，客里相宽对举觞。\n夜暖试铺新枕簟，晓寒仍索旧衣裳。\n樱桃著雨便成腐，柳絮随风如许狂。\n连岁经行淮上路，忧时嬴得鬓毛苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕲州厉使君七夕祈雨","author":"戴复古","text":"樽俎忘佳节，衣冠肃广庭。\n为民祈一雨，何暇赏双星。\n五马无惭德，三龙合效灵。\n前山好云气，早已动雷霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕲春李丈解后游江上园劝游人不可折花木禁渔弋者不捕禽鱼酒边谈论可听乃中洲先生之后叶水心尝与往来","author":"戴复古","text":"坐断此江干，池亭百亩宽。\n禽鱼全性命，花竹报平安。\n有道行其志，非时做甚官。\n丰神更閒雅，野服竹皮冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章巨浸呈陈幼度提干","author":"戴复古","text":"乞得新晴赋晚霞，出门无路欲乘槎。\n忧风忧雨动经月，足食足衣能几家。\n一饭共君烹瓠叶，三杯无处看荷花。\n自成鼓吹喧朝夕，输与东湖两部蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章东湖宋谦甫黄存之酌别","author":"戴复古","text":"湖边长记昔年游，生怕清波照白头。\n杨柳萧疏多困雨，芰荷憔悴早惊秋。\n无功及物谈何益，有酒开怀醉即休。\n江上买舟犹未定，明朝尚可为君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章东湖感旧","author":"戴复古","text":"忆见堤边种柳初，重来高树满东湖。\n交游太半入鬼录，歌醉一时逢酒徒。\n夜雨总成流水去，春风能免落花无。\n经行孺子亭边路，犹有沙鸥识老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章东湖避暑 其二","author":"戴复古","text":"遍访诸亭馆，苍苔掩旧踪。\n十年如昨日，万象又秋容。\n阅世存乔木，沿堤倚瘦筇。\n何人杀风景，斫尽木芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"豫章东湖避暑 其一","author":"戴复古","text":"行坐自徜徉，吟声绕屋梁。\n晓烟滋柳色，晨露发荷香。\n以我一心静，参他六月凉。\n渊明知此意，高卧到羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉吟","author":"戴复古","text":"一狂兼一懒，穷到白头年。\n客路偏耽酒，诗囊不贮钱。\n吟边忘世故，醉里乐吾天。\n不答诸公问，何如孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉眠梦中得夏闰得秋早雨多宜岁丰一联起来西风悲人且闻边事","author":"戴复古","text":"夏闰得秋早，雨多宜岁丰。\n今朝上东阁，昨夜已西风。\n田野一饱外，乾坤万感中。\n传闻招战士，人尚说和戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"镇江别总领吴道夫侍郎时愚子琦来迎侍朝夕催归甚切","author":"戴复古","text":"落魄江湖四十年，白头方办买山钱。\n老妻悬望占乌鹊，愚子催归若杜鹃。\n济世功名付豪杰，野人事业在林泉。\n难禁别后相思意，或有封书寄雁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题亡室真像","author":"戴复古","text":"求名求利两茫茫，千里归来赋悼亡。\n梦井诗成增怅恨，鼓盆歌罢转凄凉。\n情钟我辈那容忍，乳臭诸儿最可伤。\n拂拭丹青呼不醒，世间谁有返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题分宜县呈石子和知县","author":"戴复古","text":"古镇更为县，封疆半是山。\n赋繁官吏窘，土瘠稻粱悭。\n流水心何急，高山意自闲。\n春风细吹拂，桃李满民间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王制机池上千岩奇观","author":"戴复古","text":"华堂掩映一池清，著此崔巍若化成。\n胸次玲珑具丘壑，世间髣髴见蓬瀛。\n碧云堆上千峰立，绿水光中万象生。\n欲去河阳种桃李，回头又觉宦情轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王制机新楼","author":"戴复古","text":"绿云图上新轮奂，弹压江山气势豪。\n手拍危栏拂星斗，目穷沧海见波涛。\n人间何处望不到，天下有楼无此高。\n俯视河阳桃李巷，清风吹断市尘嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题处士黄公山居","author":"戴复古","text":"行尽松坡与竹坡，沿溪窈窕上岩阿。\n山深每恨客来少，寺近莫教僧到多。\n但觉洞中人不老，不知云外事如何。\n边头又报真消息，靼使来朝乞讲和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题永州思范堂","author":"戴复古","text":"太守能延客，兹堂为我开。\n清池照窗户，列嶂带楼台。\n剔藓观题字，披榛欲访梅。\n城根数株石，曾识范公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题何季涌江亭","author":"戴复古","text":"胜概何妨近市廛，红尘疏处著三椽。\n数重青嶂横天末，一道澄江在眼前。\n海浪浴红朝出日，树林堆碧晚生烟。\n请君分付堤边石，莫使渔翁来系船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宋安抚月中香","author":"戴复古","text":"移根广寒殿，栽近读书堂。\n良夜月中影，秋风天上香。\n此花真异种，万木莫同芳。\n他日五枝秀，何惭窦十郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张签判园林","author":"戴复古","text":"园圃屋东西，从君一杖藜。\n雨寒花蕊瘦，春重柳丝低。\n亭馆常留客，轩窗总傍溪。\n摩挲雪色壁，安得好诗题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题邵武熙春台呈王子文使君","author":"戴复古","text":"步到风烟上上头，恍如造物与同游。\n千山表里重围过，一水中间自在流。\n近郭楼台隔云见，邻峰钟磬出林幽。\n风流太守诗无敌，有暇登临共唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题邹震甫江山伟观","author":"戴复古","text":"八境横陈淦水滨，异乡谁识倚楼人。\n江山不越乾坤大，烟雨翻成风月新。\n十载经营梅屋趣，三间突兀草堂邻。\n题诗未得惊人句，从此登临莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题侄孙岂潜家平远图","author":"戴复古","text":"好山横远碧，平野带林塘。\n四望耕桑地，几年云水乡。\n海天龙上下，秋日鹤翱翔。\n睹物忽有感，无心住草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题姚显叔南屿书院","author":"戴复古","text":"朝夕置身书卷间，纷华满眼几曾看。\n山林不受尘埃涴，屋宇无多气象宽。\n立脚怕随流俗转，留心学到古人难。\n漫山桃李争春色，输与寒梅一点酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题春山李基道小园","author":"戴复古","text":"潇洒数椽屋，旋营花竹坡。\n心宽忘地窄，亭小得山多。\n共赏春晴好，其如客醉何。\n栖鸾将远举，宁久盼庭柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题泉州王梅溪先生祠堂徐竹隐直院谓梅溪古之遗直渡江以来一人而已","author":"戴复古","text":"堂堂大节在朝廷，名重当时太华轻。\n乾道君臣千载遇，先生议论九重惊。\n人歌黄霸思遗爱，我颂朱云有直声。\n一瓣清香拜图像，英风凛凛尚如生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题胡立方思斋","author":"戴复古","text":"每事再思过，参之以古今。\n唯求合天理，毋妄用吾心。\n和气生琴室，清风动竹林。\n所居虽近市，不许市尘侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵庶可山台 其二","author":"戴复古","text":"天造此一景，趋然阛阓间。\n坐分台上石，看尽越中山。\n松月照今古，樵风送往还。\n只愁轩冕出，闲却白云关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵庶可山台 其一","author":"戴复古","text":"层台高几许，此即会稽图。\n一目空秦望，千峰压镜湖。\n云烟分境界，城郭限廉隅。\n他日传佳话，兰亭与此俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题徐子英小园","author":"戴复古","text":"奉亲营小圃，僻在水之湄。\n霜露蔡公赋，假山慈竹诗。\n人皆称寿母，我独喜佳儿。\n八行家风在，三迁忆旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题徐京伯通判北征诗卷","author":"戴复古","text":"一襟忠谊气，数首北征诗。\n不许公卿见，徒为箧笥奇。\n衔枚冲雪夜，击楫誓江时。\n此志无人共，愁吟两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清江台","author":"戴复古","text":"秋色无边际，酬之以醉颜。\n亭高俯城郭，木阙见江山。\n胜践园林古，好诗天地悭。\n范碑生羽翼，飞上画屏间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萍乡何叔万云山","author":"戴复古","text":"拄杖穿云去，一坡仍一坡。\n地高山不峻，花少竹还多。\n家近登临便，人贤气味和。\n能诗老姚合，朝夕共吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]