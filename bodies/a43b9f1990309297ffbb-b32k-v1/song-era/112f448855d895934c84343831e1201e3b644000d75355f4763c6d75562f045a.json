[{"title":"夏夜怀赵灵秀","author":"徐玑","text":"古郡草为城，怀贤隔此扃。\n水风凉远树，河影动疏星。\n江国晴犹润，烟林暮转青。\n荷锄曾有约，独喜带骚经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翁知县归自湖湘","author":"徐玑","text":"渺渺秋江带碧鸦，君来应是吊湘涯。\n怀人也似居无竹，忧世长如饭有砂。\n一袖清风诗思远，满汀芳草夕阳赊。\n还归殊未□颜瘦，已种湖边绕处花。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翁通判挽词 其一","author":"徐玑","text":"处己先能俭，为官易得清。\n长卿诗最好，叔度德难名。\n归旐郴江远，新坟秀岭平。\n松楸本相望，惆怅不堪情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翁通判挽词 其二","author":"徐玑","text":"昔年楼上饮，分韵正秋深。\n冷貌长如在，高风不可寻。\n独遗杨子厚，谁寄惠连音。\n莫向山庐宿，松声似夜吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿寺","author":"徐玑","text":"古木山边寺，深松径底风。\n独吟侵夜半，清坐杂禅中。\n殿静灯光小，经残磬韵空。\n不知清梦远，啼鸟在林东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈西老","author":"徐玑","text":"长日无吟伴，闲庭伫物华。\n竹枝斜带雨，草色净侵沙。\n风度平生友，邻居几十家。\n前曾乘小醉，访尔一瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄舍弟","author":"徐玑","text":"寄问安仁弟，弦歌又一年。\n流来溪水远，清到县门前。\n故里人情乐，新居物色鲜。\n宦归言话款，正及早梅边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"徐玑","text":"晨起风吹面，朝晴野雾收。\n高峰多远见，浅水少平流。\n世事非难了，尘劳独未休。\n今年看鬓发，已变一茎秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其二","author":"徐玑","text":"是谁曾种白玻璃，夐绝寒荒一点奇。\n不厌垄头千百树，最怜窗下两三枝。\n幽深真似离骚句，枯健犹如贾岛诗。\n吟到月斜浑未已，萧萧鬓影有风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其一","author":"徐玑","text":"疏芳点点是春冰，应笑浮华去不停。\n石畔长来枝易老，竹间瘦得萼全青。\n孤高自爱香无色，寂寞浑教影问形。\n莫遣丰□种宫苑，野桥流水最清泠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅夫人挽词","author":"徐玑","text":"执馈供汤药，辛勤四十年。\n谁知飞蝶梦，翻落鼓盆先。\n丹旐秋城外，寒云野寺边。\n送车来阖境，陶侃信能贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅坡","author":"徐玑","text":"浅水低坡几树苔，冷光摇动玉尘埃。\n横斜直似安排得，古怪多应折损来。\n洁白要须侵夜看，飘零却是被春催。\n閒来立断清风影，一片飞香落酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渌波亭寄泊晨起有感","author":"徐玑","text":"尘埃几泯寸心清，晨起孤吟在水亭。\n晴景淡红烟景白，近山浓绿远山青。\n初因薄宦成羁旅，忽伴轻鸥落渚汀。\n安得数年居此地，待须长日补骚经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄碧","author":"徐玑","text":"黄碧平沙岸，陂塘柳色春。\n水清知酒美，山瘦识民贫。\n鸡犬田家静，桑麻岁事新。\n相逢行路客，半是永嘉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨","author":"徐玑","text":"自入春来旱，祈求到夏中。\n数朝人尽恐，今夜雨须通。\n云气昏犹散，雷声隐渐隆。\n池鱼先得活，欢喜与予同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜奭上人至","author":"徐玑","text":"住与佛居近，僧閒稍问诗。\n湖山明月夜，风露菊花时。\n达意言常省，微吟步自迟。\n老来朋旧少，爱尔得相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘中","author":"徐玑","text":"旧说湘中事，身来又可寻。\n庙存虞帝迹，江照楚臣心。\n为客人俱远，题名刻自深。\n春回洲渚绿，遥望正沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登信州灵山阁跨鹤台","author":"徐玑","text":"清游吾有分，浑似昔曾来。\n野屋凭高住，青山到水回。\n欲看灵岫远，须待晓云开。\n渐渐生愁思，乡心上古台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登横碧轩继赵昌甫作","author":"徐玑","text":"步陟高高寺，徐行不用扶。\n青天晴又雨，山色有还无。\n句向闲中觅，茶因醉后呼。\n所怀论未足，何乃又征途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登滕王阁","author":"徐玑","text":"重重楼阁倚江干，岸草汀烟远近间。\n春水生时都是水，西山青外别无山。\n云归长若真人在，风过犹疑帝子还。\n自古舟船城下泊，几人来此望乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊日同朱学谕登翠麓亭","author":"徐玑","text":"缓行循翠麓，凝睇俯清湾。\n舟楫芦花外，江山夕照间。\n天寒虽日短，岁晚亦身闲。\n高树梅初发，与君相共攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊日骊山渡逢故人","author":"徐玑","text":"天寒多木叶，愁思满溪滨。\n惆怅往来渡，经行多少人。\n时情犹重腊，岁事每占春。\n与尔他乡旅，谁当怀抱新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢刘明远华亭惠书","author":"徐玑","text":"别远心常记，书归亦到吾。\n离家非失计，有子已为儒。\n海浅编鱼扈，人清养鹤雏。\n礼优宾馆暇，赋咏几欢娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢步石鼓山","author":"徐玑","text":"谢公曾步处，石鼓尚依然。\n地狭川多涨，山高浦欲旋。\n不因诗句说，更复有谁传。\n怀望徘徊久，寒郊起暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁山","author":"徐玑","text":"雁山深又僻，无数石岩奇。\n皆是僧分住，最先谁得知。\n逐时多异景，前辈少题诗。\n南渡名方著，唐人不到兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春书事","author":"徐玑","text":"出门閒步草萋萋，桑柘阴中亦有蹊。\n几树晴烟莺啭早，一塘春水燕飞低。\n空如陶亮官为令，难学严陵住近溪。\n圣世幸时沾薄禄，不能辛苦又攀跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潘德久挽词","author":"徐玑","text":"祇为吟成癖，官闲乐有馀。\n病惟亲笔墨，贫亦买琴书。\n别奠临西野，春风入故庐。\n悠悠想精魄，如赋钓台初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方上人房古梅","author":"徐玑","text":"曾听道公语，先师爱此梅。\n但知传说老，不记若年栽。\n半树枯仍发，疏花晚自开。\n方兄头又白，常喜故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东山道院","author":"徐玑","text":"古院嵚?石作层，绿苔芳草近郊坰。\n溪流偶到门前合，山色偏来竹里青。\n静与黄蜂通户牖，閒将白鸟共沙汀。\n道人亦有能琴者，一曲清徽最可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石门洞","author":"徐玑","text":"瀑水东南冠，庐山未足论。\n飞来长似雨，流处不知源。\n洞里龙为宅，溪边石作门。\n修行谢康乐，庵有故基存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李氏山亭","author":"徐玑","text":"斗建魁星地，城隅李氏亭。\n竹高随路有，山静隔江青。\n人在云间语，潮生户外汀。\n凭高一长望，疑欲入沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李商叟半村堂","author":"徐玑","text":"住屋半依村，先生气貌尊。\n若非迎好客，长是掩柴门。\n觅句行山影，披蓑钓月痕。\n固贫年八十，惟得令名存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈待制湖庄","author":"徐玑","text":"园无三亩地，四面水连天。\n行向楼高处，却如身在船。\n野花春渚外，山色海云边。\n一任人来往，兹怀亦浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题养拙轩","author":"徐玑","text":"混沌分来便至今，纷纷巧事日成林。\n月明未免虾蟆食，秋至依然蟋蟀吟。\n自叹一身全是幻，谁能万事不容心。\n到君斋舍清如水，应使凡机尽弗侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题薛景石瓜庐","author":"徐玑","text":"近舍新为圃，浇锄及晚凉。\n因看瓜蔓吐，识得道心长。\n隔沼嘉蔬洁，侵畦异草香。\n小舟应买在，门外是渔乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠九华李丹士","author":"徐照","text":"长记零陵郡，共看江上峰。\n平生轻世事，几度认仙踪。\n转式驱雷电，封泥伏虎龙。\n三千三百里，今日又相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠东庵约老","author":"徐玑","text":"一阁手自建，一庵居在东。\n既然头欲白，不用剃令空。\n门掩春山绿，檐依晓日红。\n玄微知有旨，混在话言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠芗林后人","author":"徐玑","text":"南北门相对，传来岁月深。\n但添新意趣，不改旧园林。\n花日移朝坐，松风伴夕吟。\n自然忘宦达，非是少知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠李丹士","author":"徐玑","text":"曾学轻腾术，长怀万里心。\n江湖云似水，巴广石如林。\n好饮身常乐，无言道更深。\n丹砂能愈疾，不用化黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵师秀","author":"徐玑","text":"游宦归来隔几春，清羸还是旧时身。\n养成心性方能静，化得妻儿不说贫。\n竹长新阴深似洞，梅添怪相老于人。\n亦知曾见高人了，近作文章气力匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠徐照","author":"徐玑","text":"近参圆觉境如何，月冷高空影在波。\n身健却缘餐饭少，诗清都为饮茶多。\n城居亦似山中静，夜梦俱无世虑魔。\n昨日曾知到门外，因随鹤步踏青莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜","author":"徐玑","text":"诗鬓晓星星，霜天似水清。\n风当窗眼入，冰向砚池生。\n已瘦梅枝影，犹乾竹叶声。\n夜来天地洁，惟是月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"记述二十韵为赵沂公作","author":"徐玑","text":"日月交辉际，乾坤欲整时。\n谋谟无远近，顾盼有安危。\n国倚宗臣重，人惟正统推。\n将军兼问古，中尉不言私。\n美德开初祀，清风起四维。\n山河春蔼蔼，雨露夜垂垂。\n川浩鼋鼍穴，田丰鼠兔窥。\n险辞萋莫已，深网障无遗。\n流谤看金策，纯诚表竹枝。\n丹心元未改，只影去奚疑。\n能胜归天道，云亡忽事宜。\n蜀关几犬豕，淮岸迩旌旗。\n将相通新好，朝廷说旧规。\n渠奸甘授首，盛代巩丕基。\n褒叙还宗祏，光昭在鼎彝。\n凄凉馀谥法，慷慨付诸儿。\n汨水芬芳地，三闾绝好词。\n子兰真已矣，靳尚亦奚为。\n乐事云悲事，新知匪故知。\n续骚何日了，千古泪如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张尚书出镇建宁","author":"徐玑","text":"焚罢南坡藁，星华接履声。\n艰时曾倚重，钩党赖持平。\n仲甫思全衮，元戎正本兵。\n丰仪麟阁贵，威重犬戎惊。\n圣主忧遐远，朝端择老成。\n迩臣宣惠化，七岭动欢情。\n风俗移刀剑，田闾遂凿耕。\n试茶龙井碧，开砚凤潭清。\n秋日江沙渺，晴天鼓角鸣。\n稻香随使驿，桂影伴仙程。\n美玉非藏韫，黄金笑满籯。\n宽和无白发，卑逊有高名。\n登用唐三世，枢机汉九卿。\n鼎司虚正席，丹扆待忠诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵状元赴湖州幕","author":"徐玑","text":"玉陛传胪晓，身居第一功。\n绝班知礼异，专局信儒崇。\n贤俊科名上，邦家事业中。\n规模垂广远，鼎鼐蓄含洪。\n更化方今务，经时志已通。\n莅人惟简直，修己在谦冲。\n日旦清风发，江晴野雾空。\n奉亲游宦喜，初向水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钱省元赴太平州教授","author":"徐玑","text":"王国重熙洽，邦基百世安。\n深源混清浊，直道阐平宽。\n学术知同贵，师儒颇异观。\n脩名袖兰省，旧格到蝉冠。\n十载田庐隐，三年客授官。\n括溪方水涨，江左尚春寒。\n论议何时一，行藏此日难。\n宿酲江柳绿，风物强加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蔡侍郎镇建宁","author":"徐玑","text":"熙洽壬辰际，刚明十载初。\n祥风开宇宙，粹质产琼琚。\n年齿终童右，文章两汉馀。\n体将时格变，名向榜头书。\n多病侵丝鬓，清颜侍玉除。\n温恭扶国是，端直屏奸渠。\n良月春先暖，丰年日自舒。\n潜藩来骑鼎，故里去程徐。\n北虏盟方缔，蛮陬孽已锄。\n愿言归补衮，敷泽遍坤舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭朱严伯","author":"徐玑","text":"脩麓长髯客，风仪野老边。\n夕阳乌袖薄，细雨葛巾偏。\n握手相从日，寒云未雪天。\n酽醅篘不尽，鲊醢罄无捐。\n共舸浮江北，联吟就几篇。\n梅花知老矣，流水尚依然。\n倚杖临皋别，东风白发前。\n官途三载远，世事古人先。\n疋布心曾许，交情后莫传。\n萧萧瓜井暮，瑟瑟故庐烟。\n衰病身如木，怀思泪欲泉。\n磨诗终未稳，空向月婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄上泉州许参政福州薛端明谪居","author":"徐玑","text":"性懒修书苦，题诗寄海滨。\n闽中今乐地，迁客旧名臣。\n乍嚼槟榔涩，初餐荔颗珍。\n园林春易老，乡岸雨难匀。\n世虑千峰静，时贤一聘新。\n闲居寻钓石，朝晚待归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漳州送王益统制谪归时方收峒寇","author":"徐玑","text":"京口丘都督，江淮第一人。\n竭心安宋代，决策斩苏嚚。\n猛将亲经选，高材近莫伦。\n六钧来有力，一骑去无尘。\n塞静良弓隐，时明枉事伸。\n迁车行地远，归诏及春新。\n恃险猺奴蠢，招亡鼠技贫。\n众情欢杀贼，国本在安民。\n功过今方使，忠诚正可陈。\n能言学李固，兹日愿亡身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月初四日分韵得然字","author":"徐玑","text":"去载羁旅身，千里望群贤。\n今夕良燕会，况乃佳节前。\n凉风日已多，岁序日已迁。\n春时种丛菊，秋花满篱边。\n采之不盈把，泛彼清清泉。\n行乐不易得，贫贱焉可捐。\n惟当从尔游，吟哦思陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上叶侍郎十二韵","author":"徐玑","text":"侍从西湖宅，安闲近水心。\n门开春郭静，桥度野池深。\n山翠连龙起，云楼学虎临。\n芙蓉通远渚，槐柳步回阴。\n盛业归宗匠，斯文并古今。\n典谟存大雅，金石振馀音。\n畴昔留藩管，江淮拥带襟。\n雍容平宇宙，潇洒在园林。\n玉富渊难测，仙癯鹤可寻。\n步趋垂杂组，言笑响鸣琴。\n补衮心无替，弹冠迹未沉。\n于今幽兴极，正可辨清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水仙花篇","author":"徐玑","text":"成阵风作车，宓妃波为茵。\n良夕忽会遇，明月寒铺银。\n环佩凌秋空，笙箫亦具陈。\n何以慰寥廓，乐此相知新。\n采珠拾翠羽，言笑生华春。\n赠以金琅玕，捧以白玉人。\n酌醴动芳气，妙与兰茝纫。\n欢娱有聚散，美宝无贱珍。\n至今寒花种，清彻瑩心神。\n霜皑众蘖藁，孤媚良舒伸。\n杜鹃望帝魂，啼血何嚚嚚。\n妃子眠海棠，荒湎焉足邻。\n姮女手栽桂，光彩相依因。\n故知蓬瀛姿，不染纤点尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见杨诚斋","author":"徐玑","text":"名高身又贵，自住小村深。\n清得门如水，贫惟带有金。\n养生非药铒，常语尽规箴。\n四海为儒者，相逢问信音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古郡","author":"徐玑","text":"古郡依蛮楚，身来作冷官。\n老怜兄弟远，贫喜妇儿安。\n分菊乘春雨，移梅待岁寒。\n又传家信至，入夜著灯看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永春路","author":"徐玑","text":"路行僻处山山好，春到晴时物物佳。\n秀色连云原上麦，清香夹道刺桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"传胡报二十韵","author":"徐玑","text":"胡虏无仁义，兴衰匪百年。\n如何凭气力，久欲靖中边。\n异类依天角，黄头住海?。\n愚堪呼鹿豕，健每学鹰鹯。\n猰狄时方惫，燕云耗颇传。\n奸臣贪拓境，黠计落空拳。\n毡毳分伊水，旌旗湿汴川。\n莺花春自老，风雨夜相连。\n文物东南盛，舟车蜀广联。\n规模垂翼翼，鼎石赖乾乾。\n五福祥光近，千龄厚泽绵。\n雨晴均化日，丰穰庆秋田。\n禽兽闻相噬，干戈斗欲缠。\n瓜分争块壤，鼎沸逐埃涓。\n亡北惟堪伺，良图盍自坚。\n藩篱兼谨守，阃外勿轻捐。\n晋赵非殊异，山河本浑全。\n人心方激切，天道有回旋。\n王佐存诸葛，中兴仰孝宣。\n何当渭桥下，拱揖看骈阗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访梅","author":"徐玑","text":"访梅行近郊，寒气初淅沥。\n欲开未开时，三点两点白。\n清枝何萧疏，幽香况岑寂。\n颇知天姿殊，绝似人有德。\n逢君天一方，欢然旧相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿权漕大卿 其一","author":"徐玑","text":"青阳初动小春华，尽道葱茏晓气佳。\n卿月早随良月诞，绣衣元属衮衣家。\n仙方养就双瞳碧，和气分成两脸霞。\n看取调羹消息好，年年长带早梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿汤侍郎","author":"徐玑","text":"东括神仙府，三岩福地通。\n异人多接迹，相种况同风。\n质有璠玙粹，姿全鼎鼐隆。\n文章亲视草，丰度早乘骢。\n紫橐潜藩贵，金题秘殿崇。\n宽卑时自理，诚恪岁乃丰。\n身在凝香处，人居和气中。\n莺声春蔼蔼，花影日融融。\n剑佩沙堤近，讴歌建水同。\n愿瞻崧岳表，长与转洪濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]