[{"title":"元旦望阙叩头而作","author":"史弥忠","text":"青帝初传令，山河万象新。\n圣恩宽似海，世态乐同春。\n拜阙难辞老，居官岂为贫。\n京华望不远，感激切微臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送安抚使袁彦淳之任","author":"史弥忠","text":"雄心中夜岂难平，一队旌旗万里行。\n为国许身增慷慨，逢人说剑转分明。\n尊前白发怀南浦，马上青山过楚城。\n从此海邦多治略，好听歌诵快舆情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏鹤","author":"史弥逊","text":"缟衣湖上月明天，雪影飘飘意欲仙。\n世网从来禁不得，高飞冲破晚秋烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤鸣洞","author":"史昌卿","text":"何年雷斧凿山裂，六月苍崖细飞雪。\n孤凤一去声不闻，海水桑田几兴灭。\n我知仙去仙尚存，时见真形生岩穴。\n青天半夜玉箫寒，唤起幽人舞明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祈雨有感","author":"史俊卿","text":"亢旱田禾槁，心香祷列仙。\n沛来三寸雨，感动九重天。\n却扇清无暑，挥锄庆有年。\n神功归大造，志喜在吟篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤鸣洞","author":"史唐卿","text":"何年雷斧凿山裂，千尺苍崖泻飞雪。\n孤凤一去声不闻，海水桑田几兴灭。\n我知仙去仙当存，时见真形坐岩穴。\n青天半夜玉箫寒，唤醒幽人弄明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹村居","author":"陈居仁","text":"霜筠万个绕龙孙，中有茅檐据小村。\n疏处只容猿鹤过，喜无俗客敢登门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下水庵晓望偶题","author":"史浩","text":"疏树梢头露晓星，薄寒侵榻睡初醒。\n沙鸥何处惊飞起，点破遥山一抹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈春卿眇云轩 其一","author":"史浩","text":"脩竹丛中屋半楹，坐来天际数峰青。\n定知俗物不挂眼，只许飞云过短棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈春卿眇云轩 其二","author":"史浩","text":"油然肤寸起岩峦，萦抱山腰玉带宽。\n会作旱天三日雨，莫将空阔等閒看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵范干闻画眉鸟声","author":"史浩","text":"春风著意舞长杨，中有珍禽口尚黄。\n曾闻章台看眉妩，故应学得汉家妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阿育王山有松万株乞亭名于真隐居士榜曰松风陆务观作诗因次韵","author":"史浩","text":"飕飕万峰顶，宇宙尽闻声。\n会得真消息，知予是强名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬释法平 其一","author":"史浩","text":"团团璧月印寒潭，时有清风扫碧岚。\n照见山人方隐几，洒然无物自沈酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬释法平 其二","author":"史浩","text":"白鹭栖烟一点明，皎然压倒语全清。\n莫言后代无人继，仗锡行将擅此名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相魏大观文挽辞","author":"史浩","text":"姚江得尉是公先，凤沼居惭我在前。\n退处对栽三径柳，追欢时共五湖船。\n尚嗟邻好无多日，何遽归程隔九泉。\n苒苒衰迟易伤感，送违陡觉泪潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵冯圆中郎中游甘露寺","author":"史浩","text":"试凭古刹俯江城，追思孙权共孔明。\n三国有人成底事，六朝何代不交兵。\n中原天子今恹复，北塞胡儿始削平。\n附翼攀鳞真际会，小臣亦解说功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈察平望有作","author":"史浩","text":"白旄黄钺拟亲麾，胜气俄周天四围。\n犬豕闻风先兽骇，狼狐见月已星稀。\n郁葱非雾中原在，岌嶪神京大驾归。\n谠议更须频启沃，间无容发是投机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵贲长老","author":"史浩","text":"露地当年说白牛，反令后学莫能由。\n足行香陌无穷辙，家在清江欲尽头。\n挂碍顿除犹是病，因缘未了且乘流。\n此山日夕浮佳气，见则何烦蜡屐游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵恩平郡王丹桂","author":"史浩","text":"银潢滚滚碧流长，洗出清秋百种芳。\n著蕊半殷生桂子，离群独立有天香。\n仙人剥啄遥相过，野老婆娑日在傍。\n正喜奇姿媚霜露，不随时世学新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵恩平郡王游山登寺中小阁","author":"史浩","text":"天边倚萧寺，小阁翠微中。\n烟霭三峰秀，松杉一径通。\n潮音从耳悟，尘虑转头空。\n堪笑林间弋，犹思落塞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨兴怀寺中用前韵","author":"史浩","text":"薛公言慷慨，端可讽驯犀。\n器广蜃江小，名高雁岭低。\n宸居清琐闼，禁路紫骝蹄。\n揆德宜长处，何因梦白鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵范经干昆季昌国杂咏 酴醾花","author":"史浩","text":"满架犹烦雪作英，年年向此眼偏明。\n春迟故欲牡丹伴，韵胜还驰雅客名。\n缥缈碧裳留夜月，娉婷玉面起朝酲。\n却嫌梅蕊无才思，零落苍苔为笛声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵恩平郡王","author":"史浩","text":"彤庭秋晚宴，和气与春同。\n寿酒千钟绿，宫花万叠红。\n金羁鸾仗底，赤舄玉阶中。\n归路闻人语，关雎诵国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程泰之尚书","author":"史浩","text":"程王二夫子，听履上甘泉。\n咳唾妙一世，万斛明珠圆。\n官居季孟间，风义帝相先。\n每当持论许，闻者殆欲仙。\n蛟龙纵巨壑，鹰隼横寥天。\n坐令脍炙馀，枵腹犹便便。\n程方秋欲半，金波照觥船。\n追想昔年日，高会有由缘。\n亲故持吉语，置酒家东偏。\n今年玉堂直，对此宜无眠。\n夜色凉如水，冰轮吐层颠。\n顾影还自慰，身冠六卿联。\n巍巍太平基，圣主乐得贤。\n作句纪兹夕，所喜期不愆。\n藏之在巾笥，未肯露其全。\n王于退食际，髣髴知云然。\n求之既愈力，璀璨出长编。\n荆潭伫唱酬，凡目一洗湔。\n我生亦何幸，披味如击鲜。\n明朝问纸价，都下已争传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵慈奥寂照院僧石岩花","author":"史浩","text":"溪山朔雪销篱落，始闻花信惊梅萼。\n韶华一瞬掉头去，满眼园林成翠幄。\n谁知幽谷犹藏春，万蒂千跗意态新。\n霞光分彩气欲热，露浥燕脂色未匀。\n墨工绘句谩称好，不见此花空到老。\n子美羞看黄四蹊，退之不数红云岛。\n天下健步吾能用，拟擘云头骑綵凤。\n叫阍乞与生香归，只许牡丹名并飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵鲍以道天童育王道中吴体","author":"史浩","text":"逆云佛塔金千寻，傍耸滴翠玲珑岑。\n春供万象富远目，响答两地纷啼禽。\n风摇野帻去复去，露浥乳窦深尤深。\n奇声俊逸鲍夫子，蓬社不挂渊明心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵冯圆中木犀六言","author":"史浩","text":"碧玉闹妆金粟，香随烟雾横斜。\n更欲移筇问讯，前山几度云遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七娘子 重阳","author":"史浩","text":"东篱寿菊金犹浅。\n对南山、把酒开新宴。\n绛阙丛霄，玉书丹篆。\n坐间俱是神仙伴。\n童颜绿发何曾变。\n喜婴儿姹女交相恋。\n寄语诗翁，茱萸重看。\n明年此会人人健。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人月圆 其一 元宵","author":"史浩","text":"夕阳影里东风软，骄马趁香车。\n看花妆镜，藏春绣幕，百万人家。\n夜阑归去，星繁绛蜡，珠翠鲜华。\n笙歌不散，疏钟隐隐，月在梅丫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人月圆 其二 咏圆子","author":"史浩","text":"骄云不向天边聚，密雪自飞空。\n佳人纤手，霎时造化，珠走盘中。\n六街灯市，争圆斗小，玉碗频供。\n香浮兰麝，寒消齿颊，粉脸生红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 端午","author":"史浩","text":"符箓玉搔头，艾虎青丝鬓。\n一曲清歌倒酒莲，尚有香蒲晕。\n角簟碧纱厨，挥扇消烦闷。\n唯有先生心地凉，不怕炎曦近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁 戴丈夫妇庆八十","author":"史浩","text":"吾乡我里。\n偕老真无比。\n宴席展，欢声起。\n蕊宫仙子绕，玉砌莱衣戏。\n称贺处，眉心竞指朱书字。\n忆昔西周吕。\n年纪虽相似。\n独自个，谁为侣。\n如今双凤老，堪引同螺醉。\n彭祖寿，十分方一从头纪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太清舞 其二","author":"史浩","text":"须臾却有人相顾。\n把肴桨来聚。\n礼数既雍容，更衣冠淳古。\n渔人方问此何乡，众颦眉、皆能深诉。\n元是避嬴秦，共携家来住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太清舞 其四","author":"史浩","text":"渔舟之子来何所。\n尽相猜相语。\n夜宿玉堂空，见火轮飞舞。\n凡心有虑尚依然，复归指、维舟沙浦。\n回首已茫茫，叹愚迷不悟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太清舞 其六","author":"史浩","text":"云軿羽幰仙风举。\n指丹霄烟雾。\n行作玉京朝，趁两班鹓鹭。\n玲珑环佩拥霓裳，却自有、箫韶随步。\n含笑嘱芳筵，后会须来赴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太清舞 其三","author":"史浩","text":"当时脱得长城苦。\n但熙熙朝暮。\n上帝锡长生，任跳丸乌兔。\n种桃千万已成阴，望家乡、杳然何处。\n从此与凡人，隔云霄烟雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太清舞 其一","author":"史浩","text":"武陵自古神仙府。\n有渔人迷路。\n洞户迸寒泉，泛桃花容与。\n寻花逶逦见灵光，舍扁舟、飘然入去。\n注目渺红霞，有人家无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太清舞 其七","author":"史浩","text":"干戈偃息岁丰穰。\n三万里农桑。\n归去告穹苍。\n锡圣寿无疆。\n游尘世、到仙乡。\n喜君王。\n跻治虞唐。\n文德格遐荒。\n四裔尽来王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太清舞 其五","author":"史浩","text":"我今来访烟霞侣。\n沸华堂箫鼓。\n疑是奏钧天，宴瑶池金母。\n却将桃种散阶除，俾华实、须看三度。\n方记古人言，信有缘相遇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 有序知明州王侍郎生日","author":"史浩","text":"喜阳和应律，启佳气、满寰瀛。\n正雪洗疏梅，云浮淡月，昨夜生明。\n熊罴信占梦好，当年相阀再蟠英。\n收拾仙风道韵，萃兹一点台星。\n功名。\n壮岁逢真。\n主紫橐、耀西清。\n向玉笋光中，瑶林宴里，来拥双旌。\n青毡家旧物，看长参、鼎鼐乐升平。\n春醑休辞介寿，鹤书已播彤廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其二 湖山胜概金沙酴醾同架","author":"史浩","text":"平湖渺渺烟波，是中只许神仙住。\n人间空爱，夭桃繁李，雪飞红雨。\n谁信壶天，靓妆玉貌，春光容与。\n似佳人才子，青冥步稳，同携手、成欢聚。\n老子时来宴赏，拥笙歌、留连尊俎。\n乌纱压倒，香云簪遍，知他几度。\n多谢东君，肯教满架，长情相处。\n更须拚痛饮，年年此际，作芳菲主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 次韵弥大梅词","author":"史浩","text":"雪中蓓蕾嫣然，美人莫恨春容少。\n化工消息，只须些子，阳和便了。\n文杏徒繁，牡丹虽贵，敢夸妍妙。\n看冰肌玉骨，诗家漫道，银蟾莹、白驹皎。\n楼上角声催晓。\n是东皇、丝纶新草。\n青旗苍辂，欲临东阙，遣伊先到。\n排斥风霜，扫除氛雾，直教闻早。\n算功高调鼎，不如竹外，一枝斜好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其一 洞天","author":"史浩","text":"翠空缥缈虚无，算唯海上蓬瀛好。\n琼瑶宫阙，蕊珠台榭，玲珑缭绕。\n弱水沈冥，瑞云遮隔，几人曾到。\n四明中，自有神仙洞府，烟霞里、知多少。\n堪笑当年狂客，爱休官、何须入道。\n婆娑绿发垂肩，著甚黄冠乌帽。\n花底金船，月边玉局，尽能迟老。\n待丹成九转，飘然驾鹤，却游三岛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扑胡蝶/扑蝴蝶 劝酒","author":"史浩","text":"光阴转指。\n百岁知能几。\n儿时童稚，老来将耄矣。\n就中些子强壮，又被浮名牵系。\n良辰尽成轻弃。\n此何理。\n若有惺惺活底，必解自为计。\n清尊在手，且须拚烂醉。\n醉乡不涉风波地。\n睡到花阴正午，笙歌又还催起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永遇乐 夏至","author":"史浩","text":"日永绣工，减却一线，节临短至。\n幸有杯盘，随分快乐，□得醺醺醉。\n寻思尘世，寒来暑往，冻极又还热炽。\n恰如个、脾家疟疾，比著略长些子。\n人生百岁，一年一发，且是不通医治。\n两鬓青丝，皆伊染就，今已星星地。\n除非炉内，龙盘虎绕，养得大丹神水。\n却从他、阴阳自变，卦分泰否。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永遇乐","author":"史浩","text":"桃李繁华，芰荷清净，景物相继。\n霜后橙黄，雪中梅绽，迤逦春还至。\n寻思天气，寒暄凉燠，各有一时乐地。\n如何被、浮名牵役，此欢遂成抛弃。\n如今醒也，扁舟短棹，更有篮舆胡倚。\n到处为家，山肴社酒，野老为宾侣。\n三杯之后，吴歌楚舞，忘却曳金穿履。\n虽逢个、清朝贵客，也须共来一醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永遇乐 洞天","author":"史浩","text":"鄞有壶天，景传图画，声著海县。\n四面攒峰，皆七十二，各在窗中见。\n祥云拥蔽，飞泉缭绕，咫尺似天涯远。\n如今向、仙家觅得，挈来十洲东畔。\n虚无缥缈，蓬莱方丈，所喜只居隔岸。\n羽幰垂珠，琼车织翠，长是陪嘉宴。\n豺狼远迹，风波不作，日月御轮须缓。\n且衔杯、称贤乐圣，度兹岁晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 即席次韵陆务观","author":"史浩","text":"双蛟画鼓催，一水银蟾满。\n见夺锦标回，却倚花枝看。\n已擘冷金笺，更酹玻璃碗。\n归去诧乡关，不负平生眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白苎 次韵真书记梅花","author":"史浩","text":"腊天寒，晓风劲，幽香频吐。\n精神绰约，谁羡姑射居处。\n江南探春独步。\n恨无侣。\n微语。\n又谁管、雪势霜威埋妒。\n且图少陵东阁作诗苦。\n拟烦玉纤轻拗、宁相许。\n惜取。\n栏干遍倚，月淡黄昏，水边清浅，不放红尘染污。\n似名画手丹青，罢施缃素。\n不随艳卉，强媚韶光一瞬，飘荡无据。\n只恐金门，宝鼎方调，时时来觑。\n便把枝头，豆颗朝天去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 其一 梅花","author":"史浩","text":"敧枕不成眠，得句十分清绝。\n一夜酸风阁花，酝江天飞雪。\n晓来的皪看枝头，老蚌剖明月。\n帝所待调金鼎，莫教人轻折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 其二 次韵弥大梅花","author":"史浩","text":"对竹擘吟笺，正是赏梅时节。\n便把这些清致，作东湖三绝。\n帝家金鼎待调羹，何似且休折。\n却爱玉楼清弄，褪霏霏香雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 酴醾金沙同架","author":"史浩","text":"小院春风不老。\n鹊碧霓裳缥缈。\n雪脸间朱颜，各自一般轻妙。\n忒掉。\n忒掉。\n真个一双两好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其六","author":"史浩","text":"一笑尊前相语。\n莫遣良辰虚度。\n饮兴正浓时，兔碗聊分春露。\n留住。\n留住。\n催办后筵歌舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其三","author":"史浩","text":"红杏白梨肌理。\n时样新妆淡伫。\n真个是观音，少个杨枝净水。\n欢喜。\n欢喜。\n尽此一钟醇美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其一 饮妇人酒","author":"史浩","text":"摘索衣裳宫样。\n生得脸儿福相。\n容止忒精神，一似观音形像。\n归向。\n归向。\n见者擎拳合掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其四","author":"史浩","text":"罗袜半钩新月。\n更把凤鞋珠结。\n步步著金莲，行得轻轻瞥瞥。\n难说。\n难说。\n真是世间奇绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其二","author":"史浩","text":"粉脸霞生一缕。\n掩映绿云秋水。\n言语更雍容，具足十分娇美。\n无比。\n无比。\n要比除非镜里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其五","author":"史浩","text":"试把珠帘低卷。\n宛见梅妆粉面。\n绿绕更红围，齐捧瑶卮来劝。\n堪羡。\n堪羡。\n此是神仙阆苑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆清朝 梅花","author":"史浩","text":"翠竹茎疏，碧溪流浅，绮窗为尔时开。\n依稀远岸，才见一点寒梅。\n冷定半疑是雪，因风还度暗香来。\n醉清兴，瘦策过桥，黄帽青鞋。\n繁枝正微雨后，似怨人知晚，泪浥冰腮。\n殷勤百绕，留连踏遍莓苔。\n报道玉人睡觉，菱花初试晓妆台。\n携归去，粉额殢人，比并轻抬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子","author":"史浩","text":"片帆初落甬勾东。\n碧湖空。\n满汀风。\n回首一川，银浪飐孤篷。\n且驾两椽烟雨里，凭曲槛，浥空濛。\n闲移拄杖上晴峰。\n莫匆匆。\n伴冥鸿。\n笑指家山，蘋叶藕花中。\n脚力倦时呼小艇，归棹稳，月朦胧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 即席答官伎得我字","author":"史浩","text":"红蓼千堤挺蕊，苍梧一叶辞柯。\n夜阑清露泻银河。\n洗出芙蓉半朵。\n解带初开粉面，绕梁还听珠歌。\n心期端的在秋波。\n想得今宵只我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]