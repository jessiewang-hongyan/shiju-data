[{"title":"河满子 其一","author":"晏几道","text":"对镜偷匀玉箸，背人学写银钩。\n系谁红豆罗带角，心情正着春游。\n那日杨花陌上，多时杏子墙头。\n眼底关山无奈，梦中云雨空休。\n问看几许怜才意，两蛾藏尽离愁。\n难拚此回肠断，终须锁定红楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河满子 其二","author":"晏几道","text":"绿绮琴中心事，齐纨扇上时光。\n五陵年少浑薄倖，轻如曲水飘香。\n夜夜魂消梦峡，年年泪尽啼湘。\n归雁行边远字，惊鸾舞处离肠。\n蕙楼多少铅华在，从来错倚红妆。\n可羡邻姬十五，金钗早嫁王昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十六","author":"晏几道","text":"双螺未学同心绾，已占歌名。\n月白风清，长倚昭华笛里声。\n知音敲尽朱颜改，寂寞时情。\n一曲离亭，借与青楼忍泪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十七","author":"晏几道","text":"西楼月下当时见，泪粉偷匀。\n歌罢还颦，恨隔炉烟看未真。\n别来楼外垂杨缕，几换青春。\n倦客红尘，长记楼中粉泪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二十四","author":"晏几道","text":"金风玉露初凉夜，秋草窗前。\n浅醉闲眠，一枕江风梦不圆。\n长情短恨难凭寄，枉费红笺。\n试拂幺弦，却恐琴心可暗传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其五","author":"晏几道","text":"征人去日殷勤嘱，莫负心期。\n寒雁来时，第一传书慰别离。\n轻春织就机中素，泪墨题诗。\n欲寄相思，日日高楼看雁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十三","author":"晏几道","text":"前欢几处笙歌地，长负登临。\n月幌风襟，犹忆西楼着意深。\n莺花见尽当时事，应笑如今。\n一寸愁心，日日寒蝉夜夜砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其八","author":"晏几道","text":"秋来更觉消魂苦，小字还稀。\n坐想行思，怎得相看似旧时。\n南楼把手凭肩处，风月应知。\n别后除非，梦里时时得见伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子","author":"晏几道","text":"花前独占春风早，长爱江梅。\n秀艳清杯，芳意先愁凤管催。\n寻香已落闲人后，此恨难裁。\n更晚须来，却恐初开胜未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十五","author":"晏几道","text":"年年此夕东城见，欢意匆匆。\n明日还重，却在楼台缥缈中。\n垂螺拂黛清歌女，曾唱相逢。\n秋月春风，醉枕香衾一岁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其四","author":"晏几道","text":"日高庭院杨花转，闲淡春风。\n昨夜匆匆，颦入遥山翠黛中。\n金盆水冷菱花净，满面残红。\n欲洗犹慵，弦上啼乌此夜同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十九","author":"晏几道","text":"当时月下分飞处，依旧凄凉。\n也会思量，不道孤眠夜更长。\n泪痕揾遍鸳鸯枕，重绕回廊。\n月上东窗，长到如今欲断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十四","author":"晏几道","text":"无端恼破桃源梦，明日青楼。\n玉腻花柔，不学行云易去留。\n应嫌衫袖前香冷，重傍金虬。\n歌扇风流，遮尽归时翠黛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其三","author":"晏几道","text":"芦鞭坠遍杨花陌，晚见珍珍。\n疑是朝云，来作高唐梦里人。\n应怜醉落楼中帽，长带歌尘。\n试拂香茵，留解金鞍睡过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二","author":"晏几道","text":"湘妃浦口莲开尽，昨夜红稀。\n懒过前溪，闲舣扁舟看雁飞。\n去年谢女池边醉，晚雨霏微。\n记得归时，旋折新荷盖舞衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其一","author":"晏几道","text":"宜春苑外楼堪倚，雪意方浓。\n雁影冥濛，正共银屏小景同。\n可无人解相思处，昨夜东风。\n梅蕊应红，知在谁家锦字中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子","author":"晏几道","text":"昭华凤管知名久，长闭帘栊。\n闻道春慵，方倚庭花晕脸红。\n可怜金谷无人后，此会相逢。\n三弄临风，送得当筵玉盏空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子","author":"晏几道","text":"秋千散后朦胧月，满院人闲。\n几处雕阑。\n一夜风吹杏粉残。\n昭阳殿里春衣就，金缕初乾。\n莫信朝寒。\n明日花前试舞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二十一","author":"晏几道","text":"别来长记西楼事，结遍兰襟。\n遗恨重寻，弦断相如绿绮琴。\n何时一枕逍遥夜，细话初心。\n若问如今，也似当时着意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二十二","author":"晏几道","text":"红窗碧玉新名旧，犹绾双螺。\n一寸秋波，千斛明珠觉未多。\n小来竹马同游客，惯听清歌。\n今日蹉跎，恼乱工夫晕翠蛾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二十五","author":"晏几道","text":"心期昨夜寻思遍，犹负殷勤。\n齐斗堆金，难买丹诚一寸真。\n须知枕上尊前意，占得长春。\n寄语东邻，似此相看有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十二","author":"晏几道","text":"高吟烂醉淮西月，诗酒相留。\n明日归舟，碧藕花中醉过秋。\n文姬赠别双团扇，自写银钩。\n散尽离愁，携得清风出画楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其七","author":"晏几道","text":"春风不负年年信，长趁花期。\n小锦堂西，红杏初开第一枝。\n碧箫度曲留人醉，昨夜归迟。\n短恨凭谁，莺语殷勤月落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其六","author":"晏几道","text":"花时恼得琼枝瘦，半被残香。\n睡损梅妆，红泪今春第一行。\n风流笑伴相逢处，白马游缰。\n共折垂杨，手捻芳条说夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十一","author":"晏几道","text":"白莲池上当时月，今夜重圆。\n曲水兰船，忆伴飞琼看月眠。\n黄花绿酒分携后，泪湿吟笺。\n旧事年年，时节南湖又采莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十八","author":"晏几道","text":"非花非雾前时见，满眼娇春。\n浅笑微颦，恨隔垂帘看未真。\n殷勤借问家何处，不在红尘。\n若是朝云，宜作今宵梦里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其九","author":"晏几道","text":"谁将一点凄凉意，送入低眉。\n画箔闲垂，多是今宵得睡迟。\n夜痕记尽窗间月，曾误心期。\n准拟相思，还是窗间记月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其四","author":"晏几道","text":"浅浅馀寒春半，雪消蕙草初长。\n烟迷柳岸旧池塘。\n风吹梅蕊闹，雨细杏花香。\n月堕枝头欢意，从前虚梦高唐。\n觉来何处放思量。\n如今不是梦，真个到伊行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其五","author":"晏几道","text":"长爱碧栏干影，芙蓉秋水开时。\n脸红凝露学娇啼。\n霞觞熏冷艳，云髻袅纤枝。\n烟雨依前时候，霜丛如旧芳菲。\n与谁同醉采香归。\n去年花下客，今似蝶分飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其八","author":"晏几道","text":"东野亡来无丽句，于君去后少交亲。\n追思往事好沾巾。\n白头王建在，犹见咏诗人。\n学道深山空自老，留名千载不干身。\n酒筵歌席莫辞频。\n争如南陌上，占取一年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其二","author":"晏几道","text":"身外闲愁空满，眼中欢事常稀。\n明年应赋送君诗。\n细从今夜数，相会几多时。\n浅酒欲邀谁劝，深情惟有君知。\n东溪春近好同归。\n柳垂江上影，梅谢雪中枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其七","author":"晏几道","text":"梦后楼台高锁，酒醒帘幕低垂。\n去年春恨却来时，落花人独立，微雨燕双飞。\n记得小蘋初见，两重心字罗衣。\n琵琶弦上说相思，当时明月在，曾照彩云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其一","author":"晏几道","text":"斗草阶前初见，穿针楼上曾逢。\n罗裙香露玉钗风。\n靓妆眉沁绿，羞脸粉生红。\n流水便随春远，行云终与谁同。\n酒醒长恨锦屏空。\n相寻梦里路，飞雨落花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其三","author":"晏几道","text":"淡水三年欢意，危弦几夜离情。\n晓霜红叶舞归程。\n客情今古道，秋梦短长亭。\n渌酒尊前清泪，阳关叠里离声。\n少陵诗思旧才名。\n云鸿相约处，烟雾九重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其六","author":"晏几道","text":"旖旎仙花解语，轻盈春柳能眠。\n玉楼深处绮窗前。\n梦回芳草夜，歌罢落梅天。\n沉水浓熏绣被，流霞浅酌金船。\n绿娇红小正堪怜。\n莫如云易散，须似月频圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其三","author":"晏几道","text":"花落未须悲，红蕊明年又满枝。\n惟有花间人别后，无期。\n水阔山长雁字迟。\n今日最相思，记得攀条话别离。\n共说春来春去事，多时。\n一点愁心入翠眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其六","author":"晏几道","text":"眼约也应虚，昨夜归来凤枕孤。\n且据如今情分里，相于。\n只恐多时不似初。\n深意托双鱼，小剪蛮笺细字书。\n更把此情重问得，何如。\n共结因缘久远无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其四","author":"晏几道","text":"何处别时难，玉指偷将粉泪弹。\n记得来时楼上烛，初残。\n待得清霜满画阑。\n不惯独眠寒，自解罗衣衬枕檀。\n百媚也应愁不睡，更阑。\n恼乱心情半被闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其一","author":"晏几道","text":"渌水带青潮。\n水上朱阑小渡桥。\n桥上女儿双笑靥，妖娆。\n倚著阑干弄柳条。\n月夜落花朝。\n减字偷声按玉箫。\n柳外行人回首处，迢迢。\n若比银河路更遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其七","author":"晏几道","text":"新月又如眉，长笛谁教月下吹。\n楼倚暮云初见雁，南飞。\n漫道行人雁后归。\n意欲梦佳期，梦里关山路不知。\n却待短书来破恨，应迟。\n还是凉生玉枕时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其五","author":"晏几道","text":"画鸭懒熏香，绣茵犹展旧鸳鸯。\n不似同衾愁易晓，空床。\n细剔银灯怨漏长。\n几夜月波凉，梦魂随月到兰房。\n残睡觉来人又远，难忘。\n便是无情也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其二","author":"晏几道","text":"小蕊受春风。\n日日宫花花树中。\n恰向柳绵撩乱处，相逢。\n笑靥旁边心字浓。\n归路草茸茸。\n家在秦楼更近东。\n醒去醉来无限事，谁同。\n说著西池满面红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思远人","author":"晏几道","text":"红叶黄花秋意晚，千里念行客。\n飞云过尽，归鸿无信，何处寄书得。\n泪弹不尽临窗滴，就砚旋研墨。\n渐写到别来，此情深处，红笺为无色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌","author":"晏几道","text":"春残雨过，绿暗东池道。\n玉艳藏羞媚赪笑。\n记当时、已恨飞镜欢疏，那至此，仍苦题花信少。\n连环情未已，物是人非，月下疏梅似伊好。\n澹秀色，黯寒香，粲若春容，何心愿、闲花凡草。\n但莫使、情随岁华迁，便杳隔秦源，也须能到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其五","author":"晏几道","text":"湖上西风，露花啼处秋香老。\n谢家春草，唱得清商好。\n笑倚兰舟，转尽新声了。\n烟波渺，暮云稀少，一点凉蟾小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其二","author":"晏几道","text":"明日征鞭，又将南陌垂杨折。\n自怜轻别，拚得音尘绝。\n杏子枝边，倚处阑干月。\n依前缺，去年时节，旧事无人说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其四","author":"晏几道","text":"妆席相逢，旋匀红泪歌金缕。\n意中曾许，欲共吹花去。\n长爱荷香，柳色殷桥路。\n留人住，淡烟微雨，好个双栖处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其三","author":"晏几道","text":"碧水东流，漫题凉叶津头寄。\n谢娘春意。\n临水颦双翠。\n日日骊歌，空费行人泪。\n成何计。\n未如浓醉。\n闲掩红楼睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一","author":"晏几道","text":"花信来时，恨无人似花依旧。\n又成春瘦，折断门前柳。\n天与多情，不与长相守。\n分飞后，泪痕和酒，占了双罗袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋蕊香 其二","author":"晏几道","text":"歌彻郎君秋草，别恨远山眉小。\n无情莫把多情恼，第一归来须早。\n红尘自古长安道，故人少。\n相思不比相逢好，此别朱颜应老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋蕊香 其一","author":"晏几道","text":"池苑清阴欲就，还傍送春时候。\n眼中人去难欢偶，谁共一杯芳酒。\n朱阑碧砌皆如旧，记携手。\n有情不管别离久，情在相逢终有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡捣练","author":"晏几道","text":"小亭初报一枝梅，惹起江南归兴。\n遥想玉溪风景，水漾横斜影。\n异香直到醉乡中，醉后还因香醒。\n好是玉容相并，人与花争莹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"晏几道","text":"午醉西桥夕未醒，雨花凄断不堪听。\n归时应减鬓边青。\n衣化客尘今古道，柳含春意短长亭。\n凤楼争见路旁情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"晏几道","text":"二月和风到碧城，万条千缕绿相迎。\n舞烟眠雨过清明。\n妆镜巧眉偷叶样，歌楼妍曲借枝名。\n晚秋霜霰莫无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"晏几道","text":"床上银屏几点山，鸭炉香过琐窗寒。\n小云双枕恨春闲。\n惜别漫成良夜醉，解愁时有翠笺还。\n那回分袂月初残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十二","author":"晏几道","text":"已拆秋千不奈闲。\n却随胡蝶到花间。\n旋寻双叶插云鬟。\n几摺湘裙烟缕细，一钩罗袜素蟾弯。\n绿窗红豆忆前欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十一","author":"晏几道","text":"一样宫妆簇彩舟。\n碧罗团扇自障羞。\n水仙人在镜中游。\n腰自细来多态度，脸因红处转风流。\n年年相遇绿江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十三","author":"晏几道","text":"闲弄筝弦懒系裙，铅华消尽见天真。\n眼波低处事还新。\n怅恨不逢如意酒，寻思难值有情人。\n可怜虚度琐窗春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十九","author":"晏几道","text":"浦口莲香夜不收，水边风里欲生秋。\n棹歌声细不惊鸥。\n凉月送归思往事，落英飘去起新愁。\n可堪题叶寄东楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二十一","author":"晏几道","text":"楼上灯深欲闭门，梦云归去不留痕。\n几年芳草忆王孙。\n向日阑干依旧绿，试将前事倚黄昏。\n记曾来处易消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其六","author":"晏几道","text":"绿柳藏乌静掩关。\n鸭炉香细琐窗闲。\n那回分袂月初残。\n惜别漫成良夜醉，解愁时有翠笺还。\n欲寻双叶寄情难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十四","author":"晏几道","text":"团扇初随碧簟收，画檐归燕尚迟留。\n靥朱眉翠喜清秋。\n风意未应迷狭路，灯痕犹自记高楼。\n露花烟叶与人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"晏几道","text":"二月春花厌落梅，仙源归路碧桃催。\n渭城丝雨劝离杯。\n欢意似云真薄倖，客鞭摇柳正多才。\n凤楼人待锦书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"晏几道","text":"莫问逢春能几回，能歌能笑是多才。\n露花犹有好枝开。\n绿鬓旧人皆老大，红梁新燕又归来。\n尽须珍重掌中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"晏几道","text":"白纻春衫杨柳鞭，碧蹄骄马杏花鞯。\n落英飞絮冶游天。\n南陌暖风吹舞榭，东城凉月照歌筵。\n赏心多是酒中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其九","author":"晏几道","text":"飞鹊台前晕翠蛾，千金新换绛仙螺。\n最难加意为颦多。\n几处睡痕留醉袖，一春愁思近横波。\n远山低尽不成歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其七","author":"晏几道","text":"家近旗亭酒易酤，花时长得醉工夫。\n伴人歌笑懒妆梳。\n户外绿杨春系马，床前红烛夜呼卢。\n相逢还解有情无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]