[{"title":"解蹀躞 吕倩倩吹笛","author":"杨无咎","text":"金谷楼中人在，两点眉颦绿。\n叫云穿月，横吹楚山竹。\n怨断忧忆因谁，坐中有客，犹记住、平阳宿。\n泪盈目。\n百转千声相续。\n停杯听难足。\n谩夸天海风涛旧时曲。\n夜深烟惨云愁，倩君沈醉，明日看、梅梢玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锯解令","author":"杨无咎","text":"送人归后酒醒时，睡不稳、衾翻翠缕。\n应将别泪洒西风，尽化作、断肠夜雨。\n卸帆浦溆。\n一种恓惶两处。\n寻思却是我无情，便不解、寄将梦去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙","author":"杨无咎","text":"云容掩帐，星辉排烛，待得鹊成桥后。\n匆匆相见夜将阑，更应副、家家乞巧。\n经年怨别，霎时欢会，心事如何可了。\n朝朝暮暮是佳期，乍可在、人间先老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滴滴金 其二","author":"杨无咎","text":"相逢未尽论心素。\n早容易、背人去。\n忆得歌翻断肠句。\n更惺惺言语。\n萋萋芳草迷南浦。\n正风吹、打船雨。\n静听愁声夜无眠，到水村何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滴滴金 其一 李宜人生辰","author":"杨无咎","text":"当初本合蟾宫里。\n谩容易、到尘世。\n表里冰清谁与比。\n占无双两地。\n诜诜已是多孙子。\n看将来、总荣贵。\n岁岁今朝捧瑶觞，劝南园桃李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"殢人娇 其一 李莹","author":"杨无咎","text":"恼乱东君，满目千花百卉。\n偏怜处、爱他秾李。\n莹然风骨，占十分春意。\n休漫说、唐昌观中玉蕊。\n妒雪凝霜，凌红掩翠。\n看不足、可人情味。\n会须移种，向曲栏幽砌。\n愁绿叶成阴，道傍人指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"杨无咎","text":"万里无云秋色静。\n上下天光，共水交辉映。\n坐对冰轮心目莹。\n此身不在尘寰境。\n扑漉文禽飞不定。\n勾引离人，分外添归兴。\n来往悠悠重记省。\n夜阑人散花移影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三","author":"杨无咎","text":"昔在仁皇当极治。\n南极星宫，曾降为嘉瑞。\n犹有画图传好事。\n身材只恐君今是。\n对酒不妨同看戏。\n他日功名，晏子堪为比。\n更愿远孙逢九世。\n安排君在鸡窠里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一 曾韵鞋词","author":"杨无咎","text":"端正纤柔如玉削。\n窄袜宫鞋，暖衬吴绫薄。\n掌上细看才半搦。\n巧偷强夺尝春酌。\n稳称身材轻绰约。\n微步盈盈，未怕香尘觉。\n试问更谁如样脚。\n除非借与嫦娥著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二 牛楚","author":"杨无咎","text":"春睡腾腾长过午。\n楚梦云收，雨歇香风度。\n起傍妆台低笑语。\n画檐双鹊尤偷顾。\n笑指遥山微敛处。\n问我清癯，莫是因诗苦。\n不道别来愁几许。\n相逢更忍从头诉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行","author":"杨无咎","text":"灯月交光，笙簧递响。\n繁华依旧升平样。\n心期休卜紫姑神，文章曾照青藜杖。\n歌落梁尘，酒摇鳞浪。\n暂还南国同邀赏。\n明年侍辇向端门，却瞻日表青霄上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其二","author":"杨无咎","text":"捧杯不管馀酲恶。\n玉腕宽金约。\n宛转一声清，戛玉敲冰，浑胜鸣弦索。\n朱唇浅破桃花萼。\n重注鸬鹚杓。\n夜永醉归来，细想罗襟，犹有梁尘落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其一","author":"杨无咎","text":"满城风雨无端恶。\n孤负登高约。\n佳节若为酬，盛与歌呼，胜却秋萧索。\n菊花旋摘揉青萼。\n满满浮杯杓。\n老鬓未侵霜，醉里乌纱，不怕风吹落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其四 鸳鸯菊","author":"杨无咎","text":"金铃玉屑嫌非巧。\n生作文鸳小。\n西帝也多情，偷取佳名，分付闲花草。\n渊明手把谁携酒。\n羞把簪乌帽。\n寄与绮窗人，百种妖娆，不似酴醾好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其三","author":"杨无咎","text":"楚乡易得天时恶。\n风雨长如约。\n不道有幽人，衣带秋深，犹自悬鹑索。\n招呼朋侣如花萼。\n有酒须同酌。\n世态任凋疏，却爱黄花，不似群花落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其五","author":"杨无咎","text":"淋漓尽日黄梅雨。\n断送春光暮。\n目断向高楼，持酒停歌，无计留春住。\n扑人飞絮浑无数。\n总是添愁绪。\n回首问春风，争得春愁，也解随春去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 龙涎香","author":"杨无咎","text":"双心小萼。\n瑞炉慢炷轻烟初著。\n清香已透红绡幄。\n底事多情，玉笋更轻掠。\n鬓云侧畔□眉角。\n妆成曾印铅华薄。\n几回殢酒襟怀恶。\n莺舌偷传，低语教人嚼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 其二","author":"杨无咎","text":"正才过七夕，又近中元，素秋时候。\n月皎风高，渐凉生襟袖。\n灏气澄凝，是谁清白，应此□□秀。\n味洗膏粱，才侔沈谢，三朝勋旧。\n好是新来，日临连帅，化格黔黎，政归仁厚。\n早祷群祠，有雨随车骤。\n愿与寰区，共资膏泽，岁岁称眉寿。\n孝感灵泉，涓涓不绝，斟为醇酎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 其一","author":"杨无咎","text":"见恩荣故里。\n□著贤关，特然超诣。\n满腹诗书，洗膏粱馀味。\n羞挽乌号，换将蓝绶，向广庭亲试。\n磊落胸襟，雍容人物，于今谁比。\n争许才猷，合跻严禁，行看横飞，少将清议。\n喜对生朝，且陶陶欢醉。\n太华莲开，海山桃熟，况是当佳致。\n满引瑶觞，相期眉寿，君家重耳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 其三","author":"杨无咎","text":"见禾山凝秀，禾水澄清，地灵境胜。\n天与珍奇，产凌霄峰顶。\n嫩叶森枪，轻尘飞雪，冠中州双井。\n绝品家藏，武陵有客，清奇相称。\n坐列群贤，手呈三昧，云逐瓯圆，乳随汤迸。\n珍重殷勤，念文园多病。\n毛孔生香，舌根回味，助苦吟幽兴。\n两腋风生，从教飞到，蓬莱仙境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"杨无咎","text":"不学真空不学仙。\n不居廛市不居山。\n时沽鲁酒供诗兴，莫管吴霜点鬓斑。\n只么去，几时还。\n岂知魂梦□□间。\n凭君休作千年调，到处惟□一味闲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其四","author":"杨无咎","text":"蕙性柔情忒可怜。\n盈盈真是女中仙。\n披图一见春风面，携手疑同玳瑁筵。\n挥象管，擘蛮笺。\n等闲写就碧云篇。\n风流意态犹难画，潇洒襟怀怎许传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"杨无咎","text":"湖上风光直万金。\n芙蓉并蒂照清深。\n须知花意如人意，好在双心同一心。\n词共唱，酒俱斟。\n夜阑扶醉小亭阴。\n当时比翼连枝愿，未必风流得似今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"杨无咎","text":"休倩傍人为正冠。\n披襟散发最宜闲。\n水云况得平生趣，富贵何曾著眼看。\n低拍棹，称鸣銮。\n一尊长向枕边安。\n夜深贪钓波间月，睡起知他日几竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永别","author":"杨氏","text":"春尽花随尽，其如自是花。\n从来说花意，不过此容华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 题樟镇清江桥和无闻翁","author":"杨氏","text":"便归去，懒东涂西抹，学少年婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 题樟镇清江桥和无闻翁","author":"杨氏","text":"错应谁铸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送夫从军","author":"杨氏妇","text":"海坛门外浪滔天，妾上城楼君上船。\n回首西风深巷底，梅花霜月夜如年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小飞来亭二首 其二","author":"杨长孺","text":"拔地齐天可上不，倚岩危栈半空浮。\n偶然忆得垂堂戒，前猛还成新懦休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小飞来亭二首 其一","author":"杨长孺","text":"阴森古木石心栽，清澈寒溪镜面开。\n斗起孤峰三百尺，从今唤作小飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代民输租","author":"杨长孺","text":"两年枉了鬓霜华，照管南人没一些。\n七百万钱都不要，脂膏留放小民家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别石门","author":"杨长孺","text":"石门得得泊归舟，江水依依别故侯。\n拟把片香投赠汝，这回欲带忘来休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季昭窜象郡二首 其二","author":"杨长孺","text":"世事昏昏酒正酣，苦言难药盗言甘。\n李庭男子真奇绝，便是吾乡小澹庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季昭窜象郡二首 其一","author":"杨长孺","text":"新来消息使人疑，一网如何尽去之。\n元祐祇今为绍圣，姬周嫠妇谩深悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋大人论配享书稿","author":"杨长孺","text":"覆羹真得皂囊书，锦水元来胜石渠。\n但宝银钩并铁画，何须玉带与金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题两翁相见图","author":"杨长孺","text":"侍讲朱颜映白发，尚书野服接通衢。\n德星聚处人争看，画作两翁相见图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一滴泉","author":"杨长孺","text":"法眼三泓井，曹溪一滴泉。\n经秋杜宇血，遗老径山禅。\n衲子非常释，丛林别是天。\n诸方多少泪，分洒汝江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王蕊花","author":"杨长孺","text":"才入平园便有声，唐昌观里久知名。\n已堆玉盏分金粟，更插银花小翠罂。\n萝蔓春风藤薜长，山矾香气晋齐盟。\n世间百卉应无恨，不遇王公枉一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茨菰花","author":"杨长孺","text":"折来趁得未晨光，清露晞风带月凉。\n长叶剪刀廉不割，小花茉莉淡无香。\n稀疏略糁瑶台雪，升降常涵翠管浆。\n恰恨山中穷到骨，茨菰也遣入诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梨","author":"杨长孺","text":"想像含消与接枝，英华集里脆香诗。\n外披翠羽中怀玉，嚼出清泉上满池。\n溢齿应餐多正好，堆盘尽饤老将宜。\n炎蒸时节还能洗，不是梨侯更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋兰亭考","author":"杨长孺","text":"石更青白故兼新，字看由中总是真。\n毕子一生三百纸，楼公四句几千春。\n从来考古难题处，直到名流下笔亲。\n奄有山阴多宝藏，草庵外面更无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题匡山瑞木图二首 其二","author":"杨长孺","text":"仙李从来别有源，手提造化发生权。\n冰霜不到云间树，风日偏和雨外阡。\n四海几人传盛事，一家双美两臞仙。\n同生同死仍同纪，花萼犹应照九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题匡山瑞木图二首 其一","author":"杨长孺","text":"孤根初作两枝荣，五朵终连独干明。\n看取松楸天瑞好，如何草木世人轻。\n春花秋叶垂千载，雁字鸰原了一生。\n孝友编中图画底，子孙忽自占清名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题湖州画像","author":"杨长孺","text":"面有忧民色，天知报国心。\n三年风月少，两鬓雪霜深。\n更莫留形迹，何曾废古今。\n不如随我去，相伴老山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐思叔题贫乐图","author":"杨长孺","text":"三间破屋一床书，锦心绣口冰肌肤。\n自纫枯叶作裤襦，此君便是长须奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾无疑","author":"杨长孺","text":"雪舟不肯半涂回，直到荒林意盛哉。\n篱菊苞时披宿雾，木犀香里绝纤埃。\n锦心绣口垂金薤，月露天浆贮玉杯。\n八十仙翁能许健，片云得得出巢来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贻罗竹谷","author":"杨长孺","text":"与世长多忤，持身转觉孤。\n夤缘新齿舌，收拾老头颅。\n我已诃泷吏，君谁诵子虚。\n同归灯火读，家里石渠书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"杨长孺","text":"地老天荒元子宅，烟霏雾结鲁公碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"杨长孺","text":"不浓不淡匀脂粉，半醉半醒媚雨风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"杨长孺","text":"过眼一春春又夏，开残芍药更无花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"杨长孺","text":"一封无己帖，两首乐天诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"杨长孺","text":"浅著燕支调淡粉，细将玛瑙碎铺茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"杨长孺","text":"灵均九畹应无此，福地三茅浪自誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"杨长孺","text":"清如玉壶冰，澹若朱弦瑟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐七年丁未十一月朔蔡久轩自江东提刑归抵家时三馆诸公以风霜随气节河汉下文章分韵赋诗送别得章字","author":"杨世奕","text":"富贵宁如节义香，也教青史播馀芳。\n四年谏省归何暮，七十新参老欲彊。\n孺子早闻辞爵位，君谟今又去班行。\n轺车玉节江东路，清梦时应绕建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春集东园诗","author":"杨仪","text":"芳节未晼晚，名园好澄霁。\n停车没径苔，移席傍丛筀。\n蝶粉留红房，蜂须抱香蒂。\n微波生酒杯，轻吹拂衣袂。\n何当名教乐，况复昌时世。\n归鞍惜馀欢，阳鸟不可系。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游青城山","author":"杨可弼","text":"我笑羊叔子，岘首矜一生。\n又怪谢阿客，伐山觅峥嵘。\n岂如铜梁守，出门便赤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"作风伯新庙","author":"杨四太尉","text":"周官大宗伯，槱燎祀风师。\n祀典既已载，有庙非淫祠。\n吾乡风伯庙，不知始何时。\n庙当浮玉屿，乡人同祭之。\n会席有烦言，社保成分离。\n爰来作新庙，奕奕东河涯。\n柱石若虎踞，檐桷如翚飞。\n香火既已分，牲牷交祝釐。\n神保降嘉福，四境风雨时。\n百谷总成熟，报祀千万期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅","author":"杨平洲","text":"谁将醉里春风面，换却平生玉雪身。\n赖得月明留瘦影，芳心香骨见天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"杨平洲","text":"支颐半睡月明中，仿佛仙人薄雾笼。\n唤起梦魂帘幕悄，天香自到不因风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙潭祷雨记事","author":"杨幼舆","text":"戴星蹑履谒灵祠，俯瞰龙宫映绿漪。\n镜样清潭三百尺，峰峦环绕耸苍碧。\n道旁野老忽长嘘，昔也原为安民居。\n嫂笑小姑借梳掠，插梳横耳走送却。\n姑嗔大嫂方作喧，迅雷陷宅变深潭。\n是时水底犹存屋，入夜人闻尚舂粟。\n历年既久已无形，神龙守护称安灵。\n呼吸风雷作云雨，爰与人间茂禾黍。\n大观邦人因祷祈，沛然甘澍满郊圻。\n人皆怀惠颂灵迹，侯爵初封助欢怿。\n近时响应达朝廷，屡颁显号莫与京。\n我来假守三逢夏，每遇乾枯叩祠下。\n灵湫一滴涨塞天，冲倒天河频有年。\n终始恩波如一日，躬趋端拜感何极。\n肃容亲炷一瓣香，稽首皈依谢休祥。\n潭心水面跳双鲤，已觉威灵示人喜。\n南游行矣归故乡，更愿神兮长久与民作丰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游老君洞","author":"杨幼舆","text":"阴阳无端更去流，世间盛福难全收。\n古人一麾耻外郡，今我半刺来边州。\n到官未久出按县，满眼猺獞森戈矛。\n谁知造化默相补，玉融山水何清幽。\n苍崖翠壁老君洞，健非巧宦能兼游。\n万岁乳成滴白柱，一卷溪畔眠青牛。\n真仙遗迹览不尽，散发坐石临清流。\n洒然形质已自失，欲酿溟滓觞浮邱。\n襟怀浩浩隘八极，身外何物非轻沤。\n数声长笑下山去，几点白云天际头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华清宫","author":"杨正伦","text":"休罪明皇与贵妃，大都衰盛两相随。\n惟怜一派温泉水，不逐人心冷暖移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永州","author":"杨永节","text":"柳侯好倔奇，颇类元道州。\n遂令舂陵行，至今犹风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊王忠肃","author":"杨由义","text":"太原城下屹行宫，云树笼葱掩碧空。\n铁马无声汾水急，满天风雨泣英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四登科诗","author":"杨申","text":"荣第时皆有，通家得者稀。\n德星一门聚，昼锦四人归。\n苦学酬身世，佳名播帝畿。\n效官修政术，此去展才徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]