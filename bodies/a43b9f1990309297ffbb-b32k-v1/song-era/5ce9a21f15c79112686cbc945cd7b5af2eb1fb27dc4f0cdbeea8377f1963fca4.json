[{"title":"初入洞霄 其二","author":"闻九成","text":"胎仙舞处叠琴心，坛月高时闻佩音。\n九锁山扉元不闭，对闲诗句为谁吟。\n长生可学凡成圣，陈迹休令后视今。\n欲饵流膏种松子，参天会见一千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初入洞霄 其一","author":"闻九成","text":"拟借寒泉洗此心，幽亭曾屡谒清音。\n会须枕石伴龙睡，不尔吹箫学凤吟。\n蛰地金丹闻往昔，插天琳宇盛当今。\n灵芝仙草宁无分，为我山中试访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨先高题漱玉轩","author":"闻九成","text":"二龙触斗一不支，化为怪石檐之垂。\n神泉内溢石齿迸，漱激犹作琼瑶飞。\n琴高赤鳝或在迩，借我一跨邀安期。\n远来相就盥灵液，六腑共浥清凉滋。\n玉泉细度玉楼去，不碍丹元中守威。\n黄金堤边审依护，视之则微听则希。\n俯窥溟渤正澄澹，海若仰望朱灵旗。\n彼妄人子誇饮玉，死诳愚妇何所稽。\n何如随我饮此水，辨玉别石俱忘机。\n真忘乃是大奇事，身可如木心可灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄山隐斋","author":"闻九成","text":"馀杭之西天柱峰，下有石洞蟠苍龙。\n斋居无尘山四合，仙人宴坐空翠中。\n夜扪北斗罡气接，晨吸东日精光通。\n醉凌高风驾白鹤，笑视黄庭驱玉童。\n人间自有赤松子，方外或友洪崖公。\n丹泉吹阴晓雾碧，野果变色秋山红。\n献酬且尽琉璃钟，谈笑便是蓬莱宫。\n肯如金粟衰病翁，散花丈室谈虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄纪游","author":"闻鉴","text":"从来此山中，不记几游历。\n每缘困杯酌，未暇赋篇什。\n屡恐为山羞，欲吟嗟思涩。\n今晨始杖屦，醒眼看泉石。\n草木呈幽姿，烟云舒秀色。\n扪萝扣栖真，束燎穿大涤。\n神工跨石梁，天巧镂岩壁。\n仙人不可逢，灵箬无从得。\n回观翠蛟舞，俯视云根屹。\n何如出山去，飞腾霈甘泽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉严将军庙","author":"闻肇瑝","text":"汉史标名氏，宕梁存慕丘。\n非惟能抗节，更独抱先忧。\n全蜀悲衔璧，孤身欲断头。\n湍奔砥柱屹，果硕剥阳留。\n片语消威猛，三军尽辑柔。\n词严偏蔼若，气正一何遒。\n庙貌旒垂冕，祀将春复秋。\n我来虔展拜，匪敢谓遨游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海盐鹿苑寺","author":"闻人宇","text":"郡邑相望路半停，屹然香刹耸林坰。\n罢参释子忘情久，应供胡僧入梦灵。\n东去无情波缭绕，西来有意柏葱青。\n定知俗驾经过少，月上松扉不用扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题招提院静照堂","author":"闻人安寿","text":"名蓝小隐惬高情，雅构堂深豁眼明。\n万虑平时身可外，一轩安处道初生。\n花萦宝砌当春盛，香满金炉入座清。\n复有高人乘兴至，为题佳句遍雕甍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墨梅","author":"闻人武子","text":"陇首人归信息稀，愁看冰楮破寒枝。\n瑶姬驻立缘何事，直到霜飞月堕时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁角暮春","author":"闻人武子","text":"绿叶成阴春已归，茅檐相对两斜晖。\n残花且插春事急，别酒欲酌歌声微。\n黄鸟匆匆隔林语，杨花款款沾人衣。\n人间一别春常好，过我渔舟果是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"闻人武子","text":"晴风吹暖枝头雪。\n露华香沁庭中月。\n屏上小江南。\n雨昏天际帆。\n翠钗香雾湿。\n侧鬓云松立。\n灯背欲眠时。\n晓莺还又啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净因院建炎兵火独存纪事","author":"闻人偲","text":"湖海浮家二十年，重来春色尚依然。\n杏花篱落喷红雾，杨柳林塘护绿烟。\n草暖村人出游地，鸠鸣刺史劝农天。\n觉场独在三灾外，试问支郎第几禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清习阁","author":"闻人符","text":"清晓捲书坐，开帘揖远峰。\n腻云留宿润，膏雨沐春容。\n世味生来薄，诗愁晚更浓。\n溪山看未足，还听暮楼钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋游灵岩","author":"闻人滋","text":"凭栏山翠湿濛濛，佛阁依然水殿风。\n欲采莲花何处所，年年金井落梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句","author":"闽清野人","text":"偶与云水会，不与云水同。\n云散水流去，杳然天地空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措","author":"闾丘次杲","text":"横江一抹是平沙。\n沙上几千家。\n得到人家尽处，依然水接天涯。\n危栏送目，翩翩去鹢，点点归鸦。\n渔唱不知何处，多应只在芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次袁说友巫山十二峰二十五韵","author":"闾丘泳","text":"舟行观山无定姿，篷底兀坐真儿痴。\n层崖复岭正杂遝，平冈横阜俄逶迟。\n晴岚参天固竞秀，深崖挺石尤多奇。\n遥岑浮眉绿点点，飞瀑悬剑锋差差。\n饱闻巫山妙天下，今诵公诗如见之。\n蓬仙来应人间世，妙龄便有声名随。\n日谈经术辅主圣，久领国计嗤驽疲。\n共推经邦济川楫，暂建分陕元戎旗。\n百城听命仰赐履，三边制胜如筹帷。\n长江高唐神女峡，万里昆崙分一枝。\n峰峦森立入霄汉，塔庙选胜居高低。\n响山猿啼声若啸，迎棹鸦舞来如嬉。\n金母分畀神灵职，孰云朝暮阳台为。\n琅函蕊笈发天秘，赞禹治水唐虞时。\n英辞一洗千载陋，写之琬琰宜在兹。\n人思传本快先睹，蔡邕石经车马驰。\n北畅威名被沙漠，西奠夷落连黔施。\n帝遣云軿镇南极，祠宫姑寓江之湄。\n湘君时过鼓瑶瑟，宓妃岂复扬蛾眉。\n金关已侔坐少广，丹经孰授踰期颐。\n野人尘容粗知学，素守亦复涅不缁。\n朅来乘轺职飞挽，两见祈谷歌噫嘻。\n疲氓崎岖上转粟，旧业荒落南窥嶷。\n劳生屡已度剑栈，清游颇念登峨嵋。\n从今嵩高雅颂手，那数韩子南山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷清生活与赋拙何异围棋酌酒其乐无涯再得一律","author":"项大受","text":"□带无遗赏，寻盟乳洞仙。\n万山如玉立，三穴自珠联。\n局外棋尤审，杯馀酒更传。\n回头笑牛女，虹气直冲天。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝祐甲寅巧夕陪赵帘溪游乳洞时秋意已□俗尘顿洗西畴项大受谩赋一诗以纪岁月","author":"项大受","text":"三洞相连等贯珠，高秋登览兴何如。\n安得□借世人□，仙境宁嫌释氏居。\n□甚□宜深避□，□然剩喜共逃虚。\n重游未必欢□□，石上聊得岁月书。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书邓先生石几","author":"项传","text":"昔闻河上公，今见濠上翁。\n姓名氏时易，道德经解同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十日被檄考试出门 其一","author":"项安世","text":"阿婆少也不如人，更说秋来白发新。\n欲按新声忘旧谱，画鸾歌扇久生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十一弟寿二首 其二","author":"项安世","text":"叹兄龌龊身全老，喜弟生狞脸正童。\n色要如童长不改，学须似老始多功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十一弟寿二首 其一","author":"项安世","text":"肇开元圣千年学，曾是吾家七岁童。\n门户只今须自力，诗书排日看新功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十九日过小将军大将军岭","author":"项安世","text":"复岭参差意出群，行人遥指两将军。\n黥彭只么空山老，不向中原早策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十二日山行","author":"项安世","text":"秋日更山行，朝朝入画屏。\n雨看如水墨，晴唤似丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十三日阻雨鸭陂驿因写道中诗寄罗郢州","author":"项安世","text":"横吹逆洒断人行，破驿孤眠又一程。\n写得吴笺寄长寿，无情风雨却多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十五日岳市路口居人皆鬻栉具及风药","author":"项安世","text":"家家药榜丸朱墨，处处丝绳罥比梳。\n我有沉疴并宿垢，亦思从此日祛除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十六日慈竹二首 其二","author":"项安世","text":"郁郁带春阴，依依绕故林。\n何人化南裔，草木有仁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十六日慈竹二首 其一","author":"项安世","text":"慈竹村村种，鞭行不出林。\n吾亲在何许，回首白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十四日看山","author":"项安世","text":"日日凭舆看远山，不知行处是峰峦。\n他山亦有痴人看，却向侬家行处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入江西界","author":"项安世","text":"行过中村五里头，湖南地尽到袁州。\n荆南更在湖南外，一片白云天际浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入普州","author":"项安世","text":"过尽昌州无数山，山开地辟见平田。\n田中有麦元无米，比自昌州却可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入湖北界","author":"项安世","text":"丹楹白扁照人开，湖北封疆直面来。\n入得界头欢喜倒，恰如身已到荆台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月旦日上冢过渚宫避雨二首 其二","author":"项安世","text":"一机寒水小吴绫，数幅荒林老画屏。\n却恐秋光太憔悴，照天宫锦拒霜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月旦日上冢过渚宫避雨二首 其一","author":"项安世","text":"萦纡白道转城腰，寂寞垂杨倚画桡。\n独自练光亭上坐，净慈烟雨看长桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又赠刘正将","author":"项安世","text":"义山仙去飞卿死，今代刘郎以字行。\n吟到江都燕台曲，一生深处许谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三十七岁初见白发诗","author":"项安世","text":"亲朋相见忽相惊，绿发朝来白两茎。\n若比商州王副使，预先搀得一年生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上鄂州黄鹤矶","author":"项安世","text":"黄鹤矶头水似油，赵陀埽上石如钩。\n舟人上得休誇客，曾过人间百仞流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大旱小雨 其一","author":"项安世","text":"白水连天九泽浑，平田五月献龟纹。\n北人未识黄梅雨，千里争占赤土云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大旱小雨 其二","author":"项安世","text":"稍觉丝丝来万弩，如闻隐隐动千军。\n夜窗一霎聊堪睡，未救田家卒岁勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨怀张升之","author":"项安世","text":"夜窗疏雨不堪听，独坐寒斋万感生。\n今夜故人江上宿，如何禁得打篷声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月","author":"项安世","text":"青天碧海路悠悠，兔老蟾饥亦倦游。\n锁定玉楼云不卷，两街灯火作中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋阻风二首 其二","author":"项安世","text":"四无边岸贴天流，八极光中一钓舟。\n不是南风解留客，世间无此好中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋阻风二首 其一","author":"项安世","text":"二月当官八月来，先生官意本衰颓。\n乾坤老大知心久，日日南风滞去桅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月八日离金陵","author":"项安世","text":"舟移石头岸，路转马鞍矶。\n惟有长干塔，相看未忍违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕二首 其一","author":"项安世","text":"腊雪初消御路乾，暖风吹面不成寒。\n月华满地春如酒，不是烧灯也合看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"项安世","text":"凤凰何处不归来，衰草斜阳只废台。\n欲唤谪仙歌一曲，长安今日更堪哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天申节锡宴戴花","author":"项安世","text":"泥金撚铁缀花枝，浅白深红映酒卮。\n回首琼林真一梦，插花还似去年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天阴欲雪","author":"项安世","text":"仰天再拜乞冬晴，十县租人要入城。\n些子中间私意处，此身方在客中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴河","author":"项安世","text":"纷纷剑客走淮濆，破虏红袍海内闻。\n行到巴河打叉处，居人犹识旧将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆田间事","author":"项安世","text":"小盖行障日，枯筇立倚风。\n入田催种稻，行圃看浇葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方太君生朝四首 其四","author":"项安世","text":"天边历草记年华，一日东风一荚花。\n春到平分争一荚，庭萱吹出碧云芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方太君生朝四首 其三","author":"项安世","text":"不须蟾桂十分圆，自有春花万种妍。\n岁岁年年长寿酒，海棠开后牡丹前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方太君生朝四首 其二","author":"项安世","text":"月姊飞来二月天，万花香里十分圆。\n谁教婺女星知道，一夜搀先照画筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方太君生朝四首 其一","author":"项安世","text":"夹钟琯里听春声，天上箜篌次第鸣。\n数到一弦弦足处，孟家机畔庆长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水仙二首 其二","author":"项安世","text":"小窗寒夜见冰花，骨冷魂清梦不邪。\n薝卜花头萱草树，只应常在野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水仙二首 其一","author":"项安世","text":"川后冰幢下碧湍，玉妃前导驾青鸾。\n素罗襦下青罗带，碧玉簪头白玉丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水宿","author":"项安世","text":"水纳乾坤净，窗通左右凉。\n船门如引索，直面看波光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长亭解","author":"项安世","text":"行人处处论亭邮，总为长亭怕永州。\n不道长亭更长去，也应行到日西休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东斋","author":"项安世","text":"桃花不解言前事，菊蕊还须记旧人。\n惟有轩前旧移竹，向人憔悴似相嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"主台州崇道观","author":"项安世","text":"蓬莱别后六经春，新赐丹邱作羽人。\n恰似昔人东望处，蓬莱径隔几由旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰溪道中二首 其二","author":"项安世","text":"一夜清霜逗晓晴，桑林脱叶似滩声。\n云边恰有惊鸿过，直作滩头细橹鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰溪道中二首 其一","author":"项安世","text":"征人颊热共占霜，忽报冬温是雨祥。\n正向愁边闻吉语，三霜两假是寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出江陵北门便有诗思","author":"项安世","text":"反闭柴门谢绝诗，二年强饭慰肝脾。\n朝来威远门前路，已被渠侬圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月五日解维成都连日行浅滩中或迟或速如在东中游湖甚以为乐初九日过龙爪滩两江合流江始深舟人至此歌呼鸣橹作发船离岸之声余始怆然觉身是行客颇有离索之念","author":"项安世","text":"青林浅濑密萦洄，唤作兰亭载酒来。\n忽听江深发鸣橹，始知身是罢官回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题","author":"项安世","text":"梦回似觉前身误，蜕罢便寻芳草吟。\n吟到夕阳人不恨，满怀风露本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玄蝶","author":"项安世","text":"腰肢可爱红娘子，面目无情黑老婆。\n世上但知怜少艾，双双飞舞奈渠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵寄四川总领陈郎中 其二","author":"项安世","text":"笔稀秋老墨花春，散作烟云段段新。\n闻有清诗心便渴，径烦珍字写西宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵寄四川总领陈郎中 其一","author":"项安世","text":"天上归来睡九春，一封黄牒拜除新。\n赤城洞府今为主，抚掌群仙总是宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田间观雨忆叶正则旧话","author":"项安世","text":"风中晚稻离离长，雨后高田聒聒流。\n此乐世间谁共赏，淮西使者正防秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]