[{"title":"王母队祝圣致语口号","author":"洪适","text":"想像编星拱紫微，龙蛇日暖动旌旗。\n恭维虹瑞生虞帝，远以鸾骖会宓妃。\n云气先飞三足使，风纹不皱六铢衣。\n君王若问蟠桃木，溜雨霜皮几万围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对厅致语口号","author":"洪适","text":"心倾葵藿斗南边，秩秩簪绅再就筵。\n方伯举杯均舜酒，外台连璧颂尧年。\n望云鳌鳌跃三百，指日鹓行官九迁。\n秘殿此时同广宴，宫花深处拜传宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广东水教致语口号","author":"洪适","text":"水战横江一百舟，海山楼里坐元侯。\n偷儿已罢三年伎，猛士聊因五月秋。\n不用辟兵酬令节，从今行客但安流。\n将军尽列长安第，留取楼船震海头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归路致语口号","author":"洪适","text":"州民争看使君归，千骑阗阗此一时。\n鼠子已知焚大棹，马人又是建丰碑。\n但将海阁严军政，不比湖亭习水嬉。\n赤壁功成八十万，小桥应奏舞腰支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会江正字乐语口号","author":"洪适","text":"一鸣曾使万人惊，亘地驰声若建瓴。\n此日东州披宿雾，几年南斗避魁星。\n共看骐骥腾夷路，便接夔龙侍楚廷。\n千里寻盟须举白，海珍无谢五侯鲭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广东秋教致语口号","author":"洪适","text":"八月师田不失时，武蜂赳赳震雕题。\n耳批秋竹图骐骥，锋瑩朝霜拭鸊鹈。\n连率名高方叔后，外台志与范滂齐。\n向来佩犊潢池子，一一腰镰走稻畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归路致语口号","author":"洪适","text":"旌旄照海塞通逵，共说元戎校武归。\n三岁麟符宽远顾，一方鼠子詟英威。\n征袍剑立严师律，舞袖弓弯有妓围。\n顷刻连营俱解甲，室中宁复叹蛜蝛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹿鸣宴致语口号","author":"洪适","text":"采芹东鲁浪歌僖，领海儒风异昔时。\n学有渊源能贯道，文如藻绣总紬奇。\n轩然西笑腾三级，对此南烹举一卮。\n勋业权舆自今日，广寒折取最高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会肇庆章守致语口号","author":"洪适","text":"风翼翔嬉云路轻，合班玉笋直承明。\n鳄溪已作思棠雅，龙邸先驰拔薤声。\n皂盖朱轓仍敛惠，青帘白舫岂争程。\n元戎政欲倾家酿，唤取佳人进曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"福州会权府赵提刑致语口号","author":"洪适","text":"三山分鼎肖蓬瀛，仰首云逵上使星。\n绶带一年聊叠组，破觚八郡久虚囹。\n元戎自喜联高躅，胜日何妨醉渌醽。\n雅望不应长揽辔，便须笔橐侍天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会交代赵知郡致语口号","author":"洪适","text":"雪意商量未肯忙，使君归骑已腾骧。\n二年治行留襦裤，万户生涯足稻粱。\n便去峨冠登要路，谁能截镫款行装。\n胸中久矣吞云梦，一举琼彝有别肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"适两日小疾谒告闻知府郎中丈有东湖之游而不果陪遂蒙佳句宠问辄趁韵以谢","author":"洪适","text":"佳时行乐阻追陪，喜得诗筒手自开。\n云岫送凉随皂盖，风漪献状属金罍。\n也知萍底鱼相得，更有荷閒蝶鼎来。\n不识重游在何日，便须扶病走舆台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"腊雪应祈因成鄙语呈使君","author":"洪适","text":"黄云仰首聚还飞，腊雪今年故作迟。\n涓日朱轓方有请，因风缟带即如期。\n寒梅正尔惭五出，茂麦悬知颂两歧。\n千室一辞欣响答，直须书事付歌诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开岁五日使君见约同宫使尚书诸丈观山宫梅花因成拙诗","author":"洪适","text":"天知风月主人贤，况是江梅望著鞭。\n已报兵厨招客醉，故教晴日作春妍。\n一年行乐能多少，十骑联飞相后先。\n好向山宫记名氏，它时嘉话踵斜川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至宁海县有怀曾守","author":"洪适","text":"郊行十日天宇清，回首静镇薰炉凝。\n寄声已为谢亭长，去甚复且容聋丞。\n万牛策勋场可涤，一犬彻警门无应。\n呼农来前问所自，归之刺史南丰曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次酬曾守分绣阁","author":"洪适","text":"城隅乔木可怡颜，小阁初成尺五閒。\n好客飞觞同啸傲，新诗衔袖莫追攀。\n片时凉雨洗疏竹，向晚轻云留远山。\n坐想清香凝燕寝，也思一笑十眉弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中岩寺","author":"洪适","text":"览胜寻幽性所耽，不教驺哄滓筠杉。\n霞城散绮留仙袂，露磴凝珠拂客衫。\n曾有金龙潜邃洞，却因赤蚁远崇岩。\n来游无复从容计，自笑羸骖束辔衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠崇教寺颜上人","author":"洪适","text":"禅窟夸金碧，经行失旧踪。\n钟声穿茂竹，辙迹荫长松。\n远到水常瑩，前陈山更重。\n勤勤紫藤杖，一览为从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题清芬阁","author":"洪适","text":"先生此地旧眠云，乔木森然数百春。\n海内多传诗弟子，壁间曾记药君臣。\n仙庐隐濑迹皆古，柏寺蓬山代有人。\n今日耳孙尤烜赫，庆源须信渺无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿秦太师 其一","author":"洪适","text":"北斗回春半浃辰，秦淮衮衮滟精神。\n六朝旧郁兴王业，千载犹钟命世人。\n便与斯文生羽翼，悬知上圣倚经纶。\n形容盛德非常事，再拜寒儒请具陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿秦太师 其二","author":"洪适","text":"竹帛班班社稷臣，陈编窥读已成尘。\n圣朝置相超三代，舆议推公第一人。\n夹日豫章蟠厚地，回天大冶转洪钧。\n后皇当宁年盈万，长向璇霄侍玉宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿秦太师 其三","author":"洪适","text":"彬彬文物悉□张，大厦扶持有栋梁。\n今日典刑新汉阁，旧时耆老拜虞庠。\n夙临坛陛皇仪究，载祚城闉常藉荒。\n公有裨天五色石，指挥馀事亦晶光。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿秦太师 其四","author":"洪适","text":"恨无官职可酬公，□□寰区宠数隆。\n甲第益高丞相府，多仪新出大明宫。\n九重礼绝恩三顾，一德名尊报两崇。\n安得奇才来学赋，试令给札命扬雄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿秦太师 其五","author":"洪适","text":"十载操持将相权，亲提四海入陶甄。\n周公礼乐未坠地，伊尹勤劳真格天。\n青海不传南下箭，黄河长渡北归船。\n济时毫发无遗力，数尽名臣孰与肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿秦太师 其六","author":"洪适","text":"圣皇问孝日东朝，报德流恩冠百僚。\n九命衮衣蝉插首，万钉宝带玉围腰。\n渠渠广厦开黄道，圉圉鸣珂下紫霄。\n宇宙人间荣至此，榆枋无地著扶摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿秦太师 其七","author":"洪适","text":"左弧垂庆记南州，日转天旋岁一周。\n风入江梅香暗度，霜满翠柏景深留。\n定知与国同箕翼，不用占星问斗牛。\n却使松乔羡眉寿，大椿何啻八千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其一","author":"洪适","text":"四海十年无武功，边人岁下还耕农。\n向来纷纭战争地，方今不见旌旗红。\n东穷沧溟西尽蜀，道路行歌镇相续。\n奇祥异瑞□莫论，但道年丰万家足。\n固知至治天相之，朝廷清明本无为。\n问谁始终主张是，一德享天维太师。\n太师勋业青冥上，丹青已揭蓬山象。\n大鸿力牧空耳闻，未似身逢真圣相。\n九重日侍慈祥宫，鸡鸣问寝声融融。\n人间快乐直馀事，都在指挥谈笑中。\n太师少保各开府，玉带金鱼行按武。\n同时两相父子间，此事古今谁得数。\n今年腊尾春全回，江梅正为生朝开。\n化工暗与人意合，更送雪花浮玉杯。\n内中数出黄封酒，紫衣飞鞚无停手。\n跪奉传觞再拜频，天子劝公千万寿。\n贱生鲁钝何足程，六年眼系文昌星。\n冷官无路报恩地，孤负翘林画姓名。\n恶诗寄将千里远，引领南州望英衮。\n青芝赤箭傥可庸，此身许人良未晚。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其二","author":"洪适","text":"自从麟阁云台后，直到凌烟不乏人。\n唐突汉唐今日是，元勋唯有一师臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其三","author":"洪适","text":"向来群议几纷纭，决策和戎断若神。\n谈笑之间了天下，诚方前古有何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其四","author":"洪适","text":"淮北淮南应战场，只今春草饱牛羊。\n时平不假金汤固，淮水汤汤一苇航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其五","author":"洪适","text":"圣皇日日侍庭闱，七十春秋自古稀。\n不是相公平国后，谁令六騩得南归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其六","author":"洪适","text":"晋公貌状谁能画，曹霸丹青与世殊。\n头上进贤何足道，至尊书赞古来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其七","author":"洪适","text":"六龙斋洁疑圆坛，百辟奔趋列后先。\n华发都人惊未见，一门两使并貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其八","author":"洪适","text":"庆源衮衮益光华，闻道诸孙总称家。\n活却生灵千百万，阴功天报的无差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其九","author":"洪适","text":"不论南北与西东，道路歌谣触处同。\n要识太平真面目，丰年长入颂声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其十","author":"洪适","text":"年年腊尾庆生申，共祝槐庭过万春。\n天使长生辅真主，人间不用说庄椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿太师益公 其十一","author":"洪适","text":"残生无似辱甄收，正作儒官已过优。\n只有望云朝夕念，恩波傥得下炎洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿张侍郎 其一","author":"洪适","text":"少日声名满学宫，中年遭遇冠群公。\n一言坐决兴邦策，学世谁知料敌功。\n上见严安方恨晚，人推汲黯盍居中。\n由来大用须详试，出处之间本自同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿张侍郎 其二","author":"洪适","text":"三吴政化捷如神，八桂威名逐日新。\n此地只今烦督护，一方何足费经纶。\n清心省事真无讼，约己丰财祇为民。\n闻道潢池总安堵，新来不见弄兵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿孙提刑","author":"洪适","text":"溪山擢秀称阳羡，族望推高独富春。\n漱石风流宜有后，掷金词翰不无人。\n声名已觉寰区满，事业方看日夜新。\n今代太平难藻绘，须公提笔侍枫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿王饶州 其一","author":"洪适","text":"淮水汤汤自古传，王家衮衮更多贤。\n人门秀出乌衣右，时论谁居凤阁先。\n已有声名腾众口，故应勋业在长年。\n安知今代文章伯，定是前身李谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿王饶州 其二","author":"洪适","text":"忆曾簪笔侍明光，细细熏香拱御床。\n正掌丝纶开画省，忽严兵卫坐黄堂。\n一时童子能骑竹，三郡词人总咏棠。\n汉世公卿尽良吏，趣归须著紫荷囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿王饶州 其三","author":"洪适","text":"南风一夜入虞弦，帝遣文星下斗边。\n冠盖鼎来诗殷箧，儿孙罗立酒明船。\n扫除霜发三千□，笑傲铜人五百年。\n再拜愿公如许寿，几看沧海变桑田。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿施徽州 其一","author":"洪适","text":"苕溪出天日，青云相鲜新。\n春风舞绿净，镜滑无埃尘。\n江山有英姿，生此第一人。\n公贵当自致，名声谁与邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿施徽州 其二","author":"洪适","text":"文章妙机杼，作吏非雪清。\n召见天叹晚，豸冠振台评。\n骅骝丁汉苑，万里方长鸣。\n翻成一麾去，何用慰苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿施徽州 其三","author":"洪适","text":"新安谁云小，领县数过五。\n异时庙堂人，剖竹来接武。\n斯民亦何幸，父母□召杜。\n大惠先一州，要知非久处。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿施徽州 其四","author":"洪适","text":"儿童拥道边，父老拜车下。\n使君为我至，欢喜不胜写。\n寿公生朝重，满酌白玉斝。\n明年更好在，玺诏来金马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿施徽州 其五","author":"洪适","text":"铜人五百年，大椿八千岁。\n寓言了无实，木石何足贵。\n公身有仙骨，坐阅此尘世。\n汗漫真可期，高揖浮丘袂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"藻侄比课五言诗已有意趣老怀甚喜因吟病中十二首示之可率昆季赓和胜终日饱閒也 其一","author":"范成大","text":"旧岁连新岁，凉床又煖床。\n山川屏里画，时刻篆中香。\n畏垒吾安土，支离饱太仓。\n若教身更健，鹤背入维扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵中甫兄九日同集张园","author":"韩元吉","text":"湖山秋尽作幽期，未觉浮舟菡萏衰。\n怯酒自怜多病后，强歌还忆少年时。\n平芜半绿烟犹接，好菊微黄雨更宜。\n单父层台在何许，一樽怀古少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵公直题米元晖画轴","author":"韩元吉","text":"天际归云挟雨，江干乱木藏山。\n耳冷似听萧瑟，眼明惊见孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆西湖","author":"洪遵","text":"忆昔西湖上，芳醪手自斟。\n龟游低芰乱，鱼闯小萍沉。\n意远山犹迥，心清水共深。\n三秋未许见，聊向梦中寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追和邵祭酒柬吕太学","author":"谢谔","text":"艰难方见救时在，一介儒生为国哀。\n六豕奸雄千古恨，二龙奔驭几时回。\n道州自分填沟壑，天诏何须贲草莱。\n我识先生心似铁，宸章莫更苦相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十首 其八","author":"释德光","text":"灵隐全提向上机，不知谁是丈夫儿。\n岭梅漏泄春消息，雪里横开三四枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坐上呈叶守","author":"李流谦","text":"暝紫朝青千万层，使君衙退剩登临。\n东华明日软红里，欲看此山无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀川馆联句","author":"许子绍","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀川馆联句","author":"黄介","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉后苦热狂吟","author":"姜特立","text":"休说唐装与晋装，一丝不挂谩风狂。\n登枝解衵不快意，脱帽露顶犹寻常。\n我生惮暑老益甚，束缚冠屦如以桎梏置我旁。\n安得天风吹上雪山顶，凭陵大叫呼彼苍。\n下臣尘世热欲死，愿借三冬塞空之白雪，十月陨物之繁霜。\n阴崖已冻裂复裂，草木禽兽颠且僵。\n此时天上天下无暑气，姜子夜半独立方清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁稔","author":"姜特立","text":"今岁稔熟收田禾，笼鸡担谷主人家。\n农人时节一醉饱，揶?起舞相喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云岑","author":"姜特立","text":"云岑抱秋阴，水木起夜色。\n原野渐萧条，田禾捲阡陌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"释法平","text":"梦魂不入人閒世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"刘应时","text":"世事不复问，旧书时一看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听莺阁","author":"尤袤","text":"春催金谷晓，一望百花齐。\n不作辽西梦，从渠著意啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赐赵士忠二首 其一","author":"赵慎","text":"职事烦填委，文墨分消散。\n驰翰未暇食，日昃不知晏。\n沈迷簿书领，回回自昏乱。\n释此出西城，登高且游观。\n方塘含白水，中有凫与雁。\n安得肃肃羽，从尔游波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江怀古","author":"胡元质","text":"子胥今日委东流，吴国明朝亦古丘。\n大笑夫差诸将相，更无人解守苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"失鹤","author":"李远","text":"秋风吹却九皋禽，一片閒云万里心。\n碧落有情应怅望，青天无路可追寻。\n来时白雪翎犹短，去日丹砂顶渐深。\n华表柱头留语后，不知消息到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠贾司教","author":"柯岳","text":"春风桃李绛帐，朝日苜蓿空盘。\n王公不志温饱，郑老岂为饥寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]