[{"title":"五月二十一日徙寓智门二首 其二","author":"赵蕃","text":"欲去未能去，暂留还此留。\n参差乔木合，映带野塘幽。\n父老记旧筑，孙曾非昔游。\n惟馀补陀像，香火得勤修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月二十一日徙寓智门二首 其一","author":"赵蕃","text":"来归迨一载，借屋已三迁。\n易觉林间寺，难求郭外田。\n瓶储朝乏粟，市籴日增钱。\n屡起瞻云汉，今年甚去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仆自乙酉至今凡四冬至皆在羁旅感慨成诗","author":"赵蕃","text":"至日长为客，天涯空浩叹。\n贫知学道力，晚悟作诗难。\n故旧劳相问，功名梦已残。\n书生例难蹇，未可厌寒酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以山药傅担团茶送向伯原用旧韵","author":"赵蕃","text":"江郊重数少陵堂，草木依人亦宠光。\n柏藉扶持难雨溜，竹逃剪伐易云长。\n鸡苏莺粟类熟灸，山茗溪茶同摘苍。\n我愿糜琼更加璧，助其问字有过扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以旧诗寄投谢昌国三首 其三","author":"赵蕃","text":"活法公家论，东莱盖有承。\n先生真伯仲，小子愧云仍。\n昧昧鼠为璞，纷纷虫语冰。\n今朝方见佛，平日谩依僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以旧诗寄投谢昌国三首 其二","author":"赵蕃","text":"我有江西役，清江公所乡。\n放舟频下上，欲见苦参商。\n扁榜书皆到，流传句必香。\n何当仍大嚼，鼎味也先尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以旧诗寄投谢昌国三首 其一","author":"赵蕃","text":"昔在方斋老，南游为我言。\n庐陵得佳士，康乐有贤孙。\n许可渠不易，殷勤相与论。\n元宾虽已矣，所与见如存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以近诗寄尤运使","author":"赵蕃","text":"求识尤太史，泛舟维豫章。\n秋天值摇落，行色况苍茫。\n竟乏惊人句，莫升君子堂。\n学诗虽老矣，犹拟遍诸方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以近诗寄丘运使","author":"赵蕃","text":"古货自难买，良工徒苦心。\n谁能明致力，于此是知音。\n门第成乖隔，江湖阻滞淫。\n寄书因有使，还得附微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以孟夏唱酬陈子高诗寄季承并借穷愁志及其兄兴化集四首 其四","author":"赵蕃","text":"著论端能拟过秦，苦吟长学跨驴人。\n十年不调非求异，三径为资本作贫。\n回首浮梁屡还往，断魂宿草几陈新。\n藏家有集曾三复，借我流传莫谩珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以孟夏唱酬陈子高诗寄季承并借穷愁志及其兄兴化集四首 其三","author":"赵蕃","text":"故家不复见中州，插架闻君似邺侯。\n往事谁能论牛李，旧书聊欲借穷愁。\n薰莸政自难同器，泾渭悬知卒异流。\n何事古今朋党祸，力争终以杀身酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以孟夏唱酬陈子高诗寄季承并借穷愁志及其兄兴化集四首 其二","author":"赵蕃","text":"东湖共款竹多竿，妙果同登塔几盘。\n冲雨冲风总幽事，一谈一笑尽诗端。\n随人似我空为计，出语如君当不刊。\n派后江西有惊坐，封题并与略评看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以孟夏唱酬陈子高诗寄季承并借穷愁志及其兄兴化集四首 其一","author":"赵蕃","text":"莫嗔不寄一行书，半百光阴伏枕馀。\n寂寞瓶储同靖节，荒凉壁立类相如。\n君今为况复何似，秋尽想应成定居。\n穫稻谗终还墐户，有诗何日定遗予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元之去非来邢园折牡丹酴醾碧桃以去","author":"赵蕃","text":"花取三英粲，时高两玉人。\n毋嫌应接费，要悟色香真。\n诗定一题纸，酒应多入唇。\n病夫方坐稳，幽独恐伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日病中","author":"赵蕃","text":"故国归无路，深居懒问津。\n莫嗟今岁病，还守去年贫。\n禦冷休嫌絮，开怀但饮醇。\n东风到梅柳，枯木自逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元衡过邢园同广声终日坐于习堂梅树之下得长句","author":"赵蕃","text":"一间茅屋数株梅，三径频成为我开。\n剩有游蜂能掠蕊，寂无饥雀下行苔。\n长吟共惜频惊落，久坐何妨晚始回。\n为语清风莫轻扫，明朝更欲杖藜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公择过门告别口占送之","author":"赵蕃","text":"平生几作送行诗，展卷常增别后思。\n我分无堪祇贫贱，君才未免尚驱驰。\n江山此去虽多识，桃李何心亦念离。\n邂逅有人频寄字，要知安否慰孤羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六日早途中见耕者","author":"赵蕃","text":"夜雨未收脚，宿耕初起头。\n聊兹一日力，慰此半年愁。\n长路厌策蹇，还家思借牛。\n未须论旨蓄，端尔待来牟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六日复饭于审知家作长句并呈彦博","author":"赵蕃","text":"门径萧萧乔木风，问君胡乐此安穷。\n五言寓兴杂今古，一饭留人随俭丰。\n白雨已催兰楫浪，绿樽尚拟菊花丛。\n可人更约王郎子，共上山亭送远鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月一日始热二首 其二","author":"赵蕃","text":"落日看篱脚，晚风占树头。\n庭荒虽若咫，步绕亦频周。\n我老自投网，民愚还坐囚。\n相哀莫相释，点点更悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月一日始热二首 其一","author":"赵蕃","text":"雨后疑无暑，晴来乃若焚。\n污渠工聚蚋，闇室剩飞蚊。\n愦愦妨书看，岑岑似酒醺。\n不知三伏久，何以度朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十一夜简孙子肃子仪","author":"赵蕃","text":"暑气侵人百不堪，晚吹微喜鬓毵毵。\n手持白羽不胜倦，醉漱清泉欣尔甘。\n定夜数钟随谷应，临流几木与天参。\n况当风月佳如引，祇欠两公相对谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十七夜出寺门骤有所闻疑水与风即而观之雨也对面而横骛焉已而倾注中夕复作明日犹未已赋诗三首与钦止斯远同之 其一","author":"赵蕃","text":"骤得疑倾峡，徐行若泛潮。\n胡为隔田亩，而不度林椒。\n爽气虽能及，馀波不可招。\n不眠如有待，冲口漫成谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十七夜出寺门骤有所闻疑水与风即而观之雨也对面而横骛焉已而倾注中夕复作明日犹未已赋诗三首与钦止斯远同之 其三","author":"赵蕃","text":"中宵还浏浏，乞晓更萧萧。\n亟作溪头看，犹沾树杪飘。\n田家比屋喜，沴气十分消。\n我得扁舟去，江湖兴久摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十七夜出寺门骤有所闻疑水与风即而观之雨也对面而横骛焉已而倾注中夕复作明日犹未已赋诗三首与钦止斯远同之 其二","author":"赵蕃","text":"昨日真聊尔，今宵颇快哉。\n无嫌雨脚短，故喜旱头开。\n一饱归天赐，群凶勿幸灾。\n谁驱霹雳驾，更起阿香雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十五日时闵雨甚矣三首 其一","author":"赵蕃","text":"一雨向何落，众蝉空此鸣。\n乍欣凉吹入，已复断霞横。\n尚拟通宵听，何妨碍月明。\n丰凶终有数，忧苦自相并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十五日时闵雨甚矣三首 其三","author":"赵蕃","text":"去此林篁蔽，出兹溪谷深。\n倍能明病眼，顿觉洗尘襟。\n问隐平生志，依僧夙昔心。\n危亭已无迹，断刻尚堪临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十五日时闵雨甚矣三首 其二","author":"赵蕃","text":"万室望霓愿，千村车水歌。\n民劳已至此，天意定如何。\n朝听闻争米，宵传说借禾。\n始焉因食饭，终矣事干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月五夜斯远会宿西轩为赋七言四韵","author":"赵蕃","text":"雨馀信宿尚留凉，况是僧房对竹床。\n异日江湖成远隔，祇今林壑可相忘。\n囊空未易苏贫极，酒薄聊能衍话长。\n竹树并檐虽尔密，不妨新月吐华光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月初九日晚大雨简文显子畅","author":"赵蕃","text":"千里归来病作劳，偶因好雨试挥毫。\n凉声何止到草木，秋意直将侵鬓毛。\n坐念司功狂欲叫，更怀元亮卧方高。\n何当过我茅檐底，不独谭诗亦具醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分宜示沈弟","author":"赵蕃","text":"水后虽颓圮，江边不寂寥。\n嚣声收市井，落景见渔樵。\n喜我扁舟泊，劳君半道要。\n他乡惟表弟，兹语验今宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分界铺爱直驿张安国因杉制名而驿之前有老梅一株不知安国何为舍彼而取此也","author":"赵蕃","text":"杉自谁人种，梅从何代栽。\n腹空雷有击，根古土无培。\n要是百年物，曾经几客来。\n直哉虽见录，清矣可遗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午风大作已雨甚微","author":"赵蕃","text":"老屋支风惧压焉，若为吹雨但疏然。\n池蛙閤閤自得意，圃蝶飞飞人故怜。\n玩物不妨寻物理，得闲聊尔赋闲篇。\n枕书几欲成幽睡，又怕饥鼯搅夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午饭资福寺","author":"赵蕃","text":"病骨怯秋凛，羸骖疲路长。\n人烟少行店，楼阁见僧房。\n憩息今成暂，从游旧不忘。\n却尘看姓字，淮楚路茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午寝而起怀子仪公择","author":"赵蕃","text":"梦里槐安底处宫，梦回依旧向来空。\n竹阴可藉日已薄，柿叶堪书霜未红。\n酌酒谁知幽子独，纵谈那得两君同。\n诗拈信手初无味，閒向西窗运秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬寅元日","author":"赵蕃","text":"壮岁频羁宦，王春又履端。\n东占风料峭，北验斗阑干。\n历数尧年永，条章汉诏宽。\n残生侣麋鹿，何路接鹓鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴丘驿晚题二首 其二","author":"赵蕃","text":"战伐求三国，羁縻自五溪。\n归飞慕鸿雁，沿戏狎凫鹥。\n酒以忘忧酌，诗因访古题。\n是身真老矣，南北更东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴丘驿晚题二首 其一","author":"赵蕃","text":"水驿聊容借，官曹少逭劳。\n关门对风雨，策杖看波涛。\n浩浩心疑壮，悠悠首遽搔。\n忽来双白鹭，伫立久江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文叔见饯于郊外且有所论复赋此","author":"赵蕃","text":"已辱临岐送，还能唤酒来。\n欲行虽倥偬，数刻为裴回。\n出处岂漫尔，古今宁异哉。\n滔滔勿渠叹，落落自余哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文叔转送畏知初到长沙寄诸弟及示同志二诗次韵寄畏知二首 其二","author":"赵蕃","text":"闻道湖南幕，人无第二流。\n文书有馀暇，风月可销忧。\n梦远宁能续，诗成谩益愁。\n幽庭步春草，鸡撼屋山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文叔转送畏知初到长沙寄诸弟及示同志二诗次韵寄畏知二首 其一","author":"赵蕃","text":"山林容我病，道路忆君长。\n忽枉潇湘句，中含屈宋香。\n细参同晤语，深卷胜书行。\n归棹知非远，胡为苦念乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文显兄弟见过","author":"赵蕃","text":"东郭有二士，闭门甘一箪。\n贫非原宪病，诗岂孟郊寒。\n俗子往不顾，斯人交亦难。\n若为能步屧，相与转林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无尽藏境界","author":"赵蕃","text":"窈窕矶头路，参差木末檐。\n朝岚变明晦，晚照出浓纤。\n旧日诗故好，新来才更添。\n嗟余已衰薄，弹压不渠厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月方上雨忽作","author":"赵蕃","text":"作底浮云合，从何细雨零。\n庭中方照影，叶上已传听。\n耿耿深翻鹊，飘飘暗堕萤。\n倦身抛曲几，高枕对疏棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜","author":"赵蕃","text":"振厉山风作，咆哮涧水喧。\n不堪蛙取闹，更奈鸭能言。\n月色虽云好，云浮竟自繁。\n白头清不寐，止酒罢芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜怀成父","author":"赵蕃","text":"尚缺佳已许，既圆明若何。\n一年增我老，千里念渠多。\n柳乱谁屡舞，虫喧空作歌。\n要为终夕看，四体奈烦痾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"比与成父别谓先行矣及再至溧阳则犹未也留数日与之同归用雪中怀家之韵","author":"赵蕃","text":"分携决意归先我，邂逅尚留翻挽渠。\n已是常饥思稚子，更逾三月欠家书。\n岁云莫矣嗟何及，归去来兮计莫如。\n壮志渡江思击楫，老怀寻壑愿巾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"比因和首座诗有故欲撩公懒是真之句名其室曰懒真知客一窗对青山尤可爱名其轩曰遥碧属王君进之书榜为之赋诗二首 其二","author":"赵蕃","text":"窗户洁仍间，峰峦列以攒。\n旧因行脚见，今得坐禅看。\n明晦阴晴变，青黄草木观。\n本来元不动，是可学心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"比因和首座诗有故欲撩公懒是真之句名其室曰懒真知客一窗对青山尤可爱名其轩曰遥碧属王君进之书榜为之赋诗二首 其一","author":"赵蕃","text":"少日经禅暇，犹馀文字嬉。\n老来无复事，日用亦奚为。\n衲被忘宵度，团蒲失昼移。\n谓公真是懒，如我不其痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水仙","author":"赵蕃","text":"楚辞香草费磨研，何独无言到水仙。\n荐菊要令和靖配，思鲈更儗步兵贤。\n未应玉树能回死，宁与梅花作导前。\n多坐未能空结习，故遭天女散诸天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王亢宗自玉山寄二诗次韵报之 其二","author":"赵蕃","text":"一官偶落大江西，名姓摧藏肯愿知。\n取友但论诗好恶，逢人不说位高卑。\n殷勤愧子能相觅，邂逅起予还有诗。\n是物解穷无苦嗜，恐教盛业枉明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王亢宗自玉山寄二诗次韵报之 其一","author":"赵蕃","text":"孰计还家底许居，政犹秋雨堕芙蕖。\n只今敢谓岁不与，自省从来术故疏。\n刍秣可怜哀病颡，江湖宁得欠舂锄。\n小舟已向山阴去，但遣和诗慵报书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王岩 其一","author":"赵蕃","text":"夜入王岩观，真同久客回。\n望松知窈窕，次背识崔嵬。\n有客成幽屏，谈诗记昔来。\n暂游还契阔，欲去重徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王岩 其二","author":"赵蕃","text":"洒落松摇雨，飞流谷坠泉。\n画图难写貌，诗语易流传。\n射虎石谁没，说猿童谩颠。\n徐岩盖可买，羞涩欠囊钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王彦博徐审知频来问疾口占示之","author":"赵蕃","text":"秋来疟鬼不销亡，令我兼旬病在床。\n治药频成问良苦，易衣终日屡炎凉。\n但添物色增悲壮，那有功名忆慨慷。\n多谢故人来问疾，几回宵度石为梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王原庆有诗寄谢丈签判子畅尉曹具以见及次韵酬之","author":"赵蕃","text":"相望千里旧闻风，何意论交邂逅中。\n别去伤心念风雨，诗来满眼眩青红。\n通家契好君能记，末路飘零我亦同。\n江左名流数王谢，一时况有小安丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王璠伯玉携诗见过二首 其二","author":"赵蕃","text":"故国闻江左，名家数建隆。\n南游新识内，东里旧乡中。\n有句君真癖，无诗我浪穷。\n更期风月夕，相与课新功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王璠伯玉携诗见过二首 其一","author":"赵蕃","text":"大热有如此，凉风安在哉。\n书凭长日度，客欠好怀开。\n豹立妨看竹，蟾飞为扫槐。\n欣然王氏子，枉步袖诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见榴花寄周丈","author":"赵蕃","text":"安石榴花照眼明，去年四月在都城。\n曾于古锦窥书帖，更以香醪酌兕觥。\n照耀屡嗟红最盛，宠光今想绿增荣。\n定王旧国重看处，门第违离岁已更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓师契县尉以沅陵韵作诗见贻次韵","author":"赵蕃","text":"叹息师门久不传，苇间几欲听延缘。\n多君有意工文字，老我空能历岁年。\n鹏鴳故知难一辨，夔蚿空复妄相怜。\n虽然亦可凄凉慰，祇恐赓篇别是篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长田道中梅花","author":"赵蕃","text":"腊前已赋忆梅诗，年后才能见好枝。\n我亦嗟渠苦孤瘦，渠应怪我底清羸。\n虽然故有临风趣，政尔难忘觅句痴。\n回首江东在何许，故人相远费相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韦南雄惠酒六尊以诗谢之","author":"赵蕃","text":"叩门何处远行人，撩乱鸡飞犬吠邻。\n信有青州六从事，讵多驿使一枝春。\n经秋未愈文园病，晚岁更馀扬子贫。\n愧是无诗堪每诵，意中殊觉丈人真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东庵上方","author":"赵蕃","text":"地瘠不宜竹，山寒多种松。\n路穷千折险，庵在最高峰。\n石溜通泉乳，晴檐喧蜜蜂。\n客来僧不语，日暮自鸣钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐南金秀才求其先处士君挽诗追作","author":"赵蕃","text":"此邦来已晚，人物欠冰清。\n要摭平生实，聊徵月旦评。\n有儿真不朽，求志得知名。\n更欲求吾语，吾言曷重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]