[{"title":"菩萨蛮令/菩萨蛮 其二 金陵怀古","author":"康与之","text":"龙蟠虎踞金陵郡。\n古来六代豪华盛。\n缥凤不来游。\n台空江自流。\n下临全楚地。\n包举中原势。\n可惜草连天。\n晴郊狐兔眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 暮春","author":"康与之","text":"春又晚。\n风劲落红如剪。\n睡起绣床飞絮满。\n日长门半掩。\n不管离肠欲断。\n听尽梁间双燕。\n试上小楼还不见。\n楼前芳草远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其一 丞相生日","author":"康与之","text":"腊残春早。\n正帘幕护寒，楼台清晓。\n宝运当千，佳辰馀五，嵩岳诞生元老。\n帝遣阜安宗社，人仰雍容廊庙。\n尽总道，是文章孔孟，勋庸周召。\n师表。\n方眷遇，鱼水君臣，须信从来少。\n玉带金鱼，朱颜绿鬓，占断世间荣耀。\n篆刻鼎彝将遍，整顿乾坤都了。\n愿岁岁，见柳梢青浅，梅英红小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其二 秋夜闻雁","author":"康与之","text":"秋寒初劲。\n看云路雁来，碧天如镜。\n湘浦烟深，衡阳沙远，风外几行斜阵。\n回首塞门何处，故国关河重省。\n汉使老，认上林欲下，徘徊清影。\n江南烟水暝。\n声过小楼，烛暗金猊冷。\n送目鸣琴，裁诗挑锦，此恨此情无尽。\n梦想洞庭飞下，散入云涛千顷。\n过尽也，奈杜陵人远，玉关无信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感皇恩 幽居","author":"康与之","text":"一雨一番凉，江南秋兴。\n门掩苍苔锁寒径。\n红尘不到，尽日鸟啼人静。\n绿荷风已过，摇香柄。\n澹阴未解，园林清润。\n一片花飞堕红影。\n残书读尽，袖手高吟清咏。\n任从车马客，劳方寸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 杜鹃","author":"康与之","text":"恼杀行人，东风里、为谁啼血。\n正青春未老，流莺方歇。\n蝴蝶枕前颠倒梦，杏花枝上朦胧月。\n问天涯、何事苦关情，思离别。\n声一唤，肠千结。\n闽岭外，江南陌。\n正长堤杨柳，翠条堪折。\n镇日叮咛千百遍，只将一句频频说。\n道不如归去不如归，伤情切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 寒夜","author":"康与之","text":"霜幕风帘，闲斋小户，素蟾初上雕笼。\n玉杯醽醁，还与可人同。\n古鼎沈烟篆细，玉笋破、橙橘香浓。\n梳妆懒，脂轻粉薄，约略淡眉峰。\n清新，歌几许，低随慢唱，语笑相供。\n道文书针线，今夜休攻。\n莫厌兰膏更继，明朝又、纷冗匆匆。\n酩酊也，冠儿未卸，先把被儿烘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 其一 上元应制","author":"康与之","text":"瑞烟浮禁苑。\n正绛阙春回，新正方半。\n冰轮桂华满。\n溢花衢歌市，芙蓉开遍。\n龙楼两观。\n见银烛、星球有烂。\n卷珠帘、尽日笙歌，盛集宝钗金钏。\n堪羡。\n绮罗丛里，兰麝香中，正宜游玩。\n风柔夜暖。\n花影乱，笑声喧。\n闹蛾儿满路，成团打块，簇著冠儿斗转。\n喜皇都、旧日风光，太平再见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 其二 别恨","author":"康与之","text":"薄寒罗袖怯。\n教小玉添香，被翻宫襭。\n兰缸半明灭。\n听几声归雁，一帘微月。\n情波恨叶。\n索新词、犹自怨别。\n梦回时、雪暖酥凝，掠鬓宝鸳钗折。\n凄切。\n纹窗描绣，旧谱寻棋，变成虚设。\n同心对结。\n重来是，甚时节。\n怅姑苏台上，征帆何许，隐隐遥山万叠。\n袖红绡、独立无言，偷弹泪血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舞杨花","author":"康与之","text":"牡丹半坼初经雨，雕槛翠幕朝阳。\n娇困倚东风，羞谢了群芳。\n洗烟凝露向清晓，步瑶台、月底霓裳。\n轻笑淡拂宫黄。\n浅拟飞燕新妆。\n杨柳啼鸦昼永，正秋千庭馆，风絮池塘。\n三十六宫，簪艳粉浓香。\n慈宁玉殿庆清赏，占东君、谁比花王。\n良夜万烛荧煌。\n影里留住年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"康与之","text":"解将天上千年艳，换得人间九日黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕东莱 其二","author":"康文虎","text":"国尚有人悲此老，天其丧我泣吾曹。\n平生心事知谁与，怅望今人论太高。\n便欲卑心随故步，岂期中路丧连鳌。\n先生已死吾何望，举眼犹知有凤毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕东莱 其一","author":"康文虎","text":"中兴以后谁堪数，名满东南震昔贤。\n旧论当时存喘息，微波今日塞天渊。\n承平格力回全盛，人物风流继往年。\n太息何人知所自，此心时复一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆真妃/相见欢","author":"康仲伯","text":"匆匆一望关河。\n听离歌。\n艇子急催双桨、下清波。\n淋浪醉。\n阑干泪。\n奈情何。\n明日画桥西畔、暮云多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗二首 其二","author":"康执权","text":"公居临海亦经年，每恨淹留阻执鞭。\n异县忽闻登帅阃，此身那得侍宾筵。\n古今谁似功名老，出入荣持将相权。\n从此凤池归路駃，未容雁荡奉周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗二首 其一","author":"康执权","text":"退老堂成席未温，天书夜到领侯藩。\n周袖申伯保南土，唐起裴公护北门。\n猿鹤岂应愁旧隐，虎貔方看拥华轩。\n公家报政由来速，伫入延英觐帝尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏为妓山氏作","author":"康执权","text":"昔日缇萦亦如许，尽道生男不如女。\n河阳满县皆春风，忍使梨花偏带雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游","author":"康孝基","text":"行春喜入虎邱山，按辔风和草色闲。\n寺内翠微松桧里，空中绀宇水云间。\n桃花时作翻翻落，苔藓晴留点点斑。\n不为白公为太守，霓裳一曲暮回还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题神山县玉兔寺","author":"康孝基","text":"国朝梵刹多新额，玉兔名存四百年。\n曾为皇唐称瑞应，得于炎宋保流传。\n荆山温润尝凝化，月窟精神主缺圆。\n寺记废兴书异事，丰碑采摭尽雕镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎邱","author":"康孝基","text":"虎邱天下名，胜概状难成。\n入寺登山险，开门见路平。\n云连松色翠，风度磬声清。\n好便称居士，安闲过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿昌禅寺","author":"康惇","text":"不怕石头滑，来为雁荡行。\n平生梦不到，今日眼逾明。\n未历千岩秀，先逢一段清。\n遍观从此始，着脚历峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题九仙阁","author":"康鼎成","text":"久学秦人避，空闻汉主求。\n丹炉无凤髓，石室有龙湫。\n谷挟千峰雨，湖生六月秋。\n尘踪应自息，长啸下溪鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云锦园","author":"庾卜礼","text":"我观大瀛海，山与水相伴。\n维兹山水丽，邈在西南畔。\n公如出岫云，顷刻固已漫。\n倏尔转晴空，化为五色斓。\n三径他山缉，万里归心断。\n要从父老归，不作儿女观。\n苏公金石心，坐阅岁时换。\n来赴林泉期，更觉云锦焕。\n五采弄珠玑，八章诵云汉。\n向来古使星，久未视龟篆。\n心贪汗漫游，行无麋鹿乱。\n快哉天下乐，岂以寸心玩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谕民","author":"戚纶","text":"文契多欺岁月深，便将疆界渐相侵。\n官中验出虚兼实，枷锁鞭笞痛不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张无梦归天台山","author":"戚纶","text":"应悔名高藏不得，朝天翻喜放身归。\n知时多顺时人话，混俗犹披俗士衣。\n有伴指期玄鹤老，无心高羡白云飞。\n赤城此去全忘虑，笑我尘劳未息机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何水部蒙出牧袁州","author":"戚纶","text":"连翩作牧蔼嘉声，重叠光华是此行。\n画隼前驱男子贵，锦衣当昼故乡荣。\n虎溪驻目曾游熟，采石维舟旧吏迎。\n来暮讴谣应载路，迟留桑梓肯忘情。\n郡楼拥翠峰峦合，井邑交光竹树明。\n醇酎岂知千日醉，温泉常见四时清。\n下车不问山河改，布政先期狱讼平。\n何日紫宸偏顾瞩，圣君留意在编氓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"戚明瑞","text":"蓝田战秦将，子婴竖降帻。\n至今柏树精，疑是卧龙魄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"戚明瑞","text":"鸺鹠欢喜舞南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"戚明瑞","text":"望帝花飞春尚寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"戚明瑞","text":"才听黄鹂便断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"戚明瑞","text":"老槐阴下吹箜篌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"戚明瑞","text":"旧梦不堪游蚁国，生涯只合在渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何水部蒙出牧袁州","author":"戚维","text":"又领亲民任，星车别紫微。\n隼旟新命重，鹤发故人稀。\n云树看如画，风帆去似飞。\n乡中诸父老，荣羡锦衣归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐庐员外出勋德之门以儒素为业泊来仪于京阙久飞誉于缙绅今则膺凤诏于朝端奏牛刀于江表会承旨尚书赋琼章于丹地饯兰棹于清流愚虽不才敢继其作","author":"扈蒙","text":"王谢高门江鲍才，东游何用更裴回。\n弦歌好就吴乡拜，簪组初从魏阙来。\n清酒一尊携潋滟，旧诗千首贮琼瑰。\n健帆轻棹须行乐，莫效当时庾信哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"扈蒙","text":"五凤齐飞入翰林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪","author":"曹一龙","text":"行乐乘阴好，谁能困墨朱。\n重阳邀数客，尽日款三吾。\n烟惨江山古，风清竹木癯。\n漫郎如可作，分酒酹茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"曹子方","text":"面前山好无人识，定是飞来小鹫峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和太师平章贾魏公咸淳庚午冬大雪遗安抚潜侍郎","author":"曹元发","text":"乾坤满眼尽琪林，擎玉诗传魏国心。\n写琰已增天府重，掌冰匪愧地官任。\n三千界内清无际，数十年来瑞独今。\n喜雪未几还喜雨，老农歌舞爱春阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅仙山丹井","author":"曹文姬","text":"鹤驭云骈去不还，乱云深处旧仙坛。\n凿开天外长生地，鍊出人间不死丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"曹文姬","text":"仙家无夏亦无秋，红日清风满翠楼。\n况有碧霄归路稳，可能同驾五云游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梅坛","author":"曹仙家","text":"汉代梅君此鍊丹，古坛翠駮藓花斑。\n目穷鸟道青天远，榻转松阴白日闲。\n烟隔楼台分象外，风吹钟磬落人间。\n不知乘诏冲升后，几度飞鸾到旧山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠邹葆光道士","author":"曹仙家","text":"罗浮道士真仙子，跃出樊笼求不死。\n冰壶皎洁水鉴清，洞然表里无尘滓。\n叱咤雷霆发指端，馘邪役鬼篆飞丹。\n朝吞露气松窗暖，夜礼星辰玉简寒。\n琴心和雅胎仙舞，屏绝淫哇追太古。\n幽韵萧深海岛风，馀音缭绕江天雨。\n真居僻在海南边，溪上帘栊洞里天。\n灵凤九苞飞槛外，珍禽五色舞花前。\n金丝岛露紫河车，青霓跨岭铁桥斜。\n罗浮自古神仙宅，万里来寻况是家。\n我昔闺中方幼稚，当年曾览罗浮记。\n形质虽拘一室间，精魂已出千山外。\n如今亲见罗浮人，疑是朱明降上真。\n剑气袖携三尺水，霞浆杖挂一壶春。\n松姿鹤步何萧散，风调飘飘惊俗眼。\n吾师出处任高情，止则止兮行则行。\n富有溪山宁愿利，贵怀道义不干名。\n我今寄迹都城里，门外喧喧那入耳。\n上床布被日高眠，不为公来不能起。\n问公去速来何迟，得接高谈几许时。\n白云偶向帝乡过，去住无踪安可期。\n我亦韶华断羁绁，何异飘蓬与翻叶。\n相逢邂逅即开颜，礼乐何曾为吾设。\n志同笙磬合宫商，道乖肝胆成胡越。\n相近未必常往还，相遥未必长离别。\n翩然孤鹤又南征，寄语石楼好风月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"震山岩","author":"曹训","text":"岩静尘埃了不侵，公闲出郭喜登临。\n云山兀兀自朝暮，江水茫茫无古今。\n鸥鹭翩翩明远目，渔樵歌唱动归心。\n绿杨红杏春风里，谁与幽人共赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉柱峰","author":"曹安","text":"青山有石柱，直插浮云杪。\n月明鹤飞来，浑疑旧华表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜贵墓","author":"曹安","text":"东出共城门，古墓何累累。\n就中如夏屋，下马读铭碑。\n始知太尉名，富擅政和时。\n讵知邑境中，仓皇来赤眉。\n敢勇率子弟，肆杀力弗支。\n编氓赖保全，迄今令名垂。\n潺潺百泉流，日夕声犹悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再寄","author":"曹汝弼","text":"江城从别后，闻说在松间。\n度日长扃户，终年不下山。\n静为诗所役，闲免事相关。\n应喜云边客，冥搜鬓未斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀寄披云峰诚上人","author":"曹汝弼","text":"院高穷木盛，野极静无言。\n险路通岩顶，香泉出石根。\n微风飘磬韵，幽鸟啄苔痕。\n常记相留夜，秋堂共听猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜友人过隐居","author":"曹汝弼","text":"忽向新春里，闲过隐士家。\n旋收松上雪，来煮雨前茶。\n禽换新歌曲，梅妆隔岁花。\n应惭非遁者，难久在烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠披云峰岳长老","author":"曹汝弼","text":"禅外掩松扃，闲眠度岁阴。\n雨侵香篆湿，苔长屐痕深。\n水在铜瓶冷，云归玉磬沈。\n前山有灵药，时策杖藜寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠僧","author":"曹汝弼","text":"一从叨命服，乘兴入天台。\n院接石桥住，门临瀑布开。\n松閒应独坐，雪里更谁来。\n时复携藜杖，看云上古台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞霞洞","author":"曹观","text":"岩前春草萋萋色，岩上春风淡淡阴。\n数百年来无谢客，□□依旧到如今。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵州","author":"陈遘","text":"冬来行部驾轺车，一日之间气候殊。\n朝衣驼裘暮挥扇，未应岚瘴得全无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新月","author":"曹希蕴","text":"禁鼓初闻第一敲，乍看新月出林梢。\n谁家宝鉴新磨出，匣小参差盖不交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠乾明寺绣尼集句","author":"曹希蕴","text":"睡起杨花满绣床，为他人作嫁衣裳。\n因过竹院逢僧话，始觉空门气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 灯花","author":"曹希蕴","text":"零落不因春雨，吹嘘何假东风。\n纱窗一点自然红。\n费尽工夫怎种。\n有艳难寻腻粉，无香不惹游蜂。\n更阑人静画堂中。\n相伴玉人春梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 灯花","author":"曹希蕴","text":"解遣愁人，能添喜气。\n些儿好事先施力。\n画堂深处伴妖娆，绛纱笼里丹砂赤。\n有艳难留，无根怎觅。\n几回不忍轻轻别。\n玉人曾向耳边言，花有信、人无的。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"曹希蕴","text":"记得小轩岑寂夜，月移疏影上东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自齐山借舟泛湖还家","author":"曹纬","text":"十里平湖漫不流，晚风吹浪打行舟。\n定知归得侵灯火，家在菰蒲最尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客有遗予画梅花者淡墨晕成因命之曰梅影","author":"曹纬","text":"忆昔神游姑射山，梦中栩栩片时还。\n冰肤不许寻常见，故隐轻云薄雾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"曹纬","text":"日出过山头，日入宿山下。\n我行山亦行，隐隐似奔马。\n朝昏山送迎，山意自倾写。\n借问征途间，谁如此山者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曹好谦负春","author":"曹纬","text":"作计寻芳不属贫，可怜风物自良辰。\n飞花有意能留客，啼鸟多情解唤人。\n涉世乍惊翻手薄，论交多语白头新。\n十年异县伤流落，来往山州枉过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日忆西湖简家弟元宠","author":"曹纬","text":"天涯孤客意堪哀，病眼逢春只强开。\n闭户不知花老去，捲帘方觉燕归来。\n风休潩水光如拭，雨霁箕山翠作堆。\n遥想西湖图画里，几多车马踏青回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清溪亭","author":"曹纬","text":"波平渺渺草萋萋，远目非昏望欲迷。\n敢以安閒侵白鸟，聊将衰病照清溪。\n百年无事双蓬鬓，万里归心独杖藜。\n徙倚无人见牢落，水流东去夕阳西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋孤雁","author":"洪适","text":"云飞水宿过炎凉，回想来时道路长。\n夜月照惊唯吊影，朔风吹断不成行。\n人间无处逃矰缴，岁晚何曾饱稻粱。\n傥以能鸣免烹杀，系书犹可到衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]