[{"title":"送张明府知黄岗","author":"释元肇","text":"去作黄岗县，风寒护上流。\n近时登要路，皆用试边头。\n赤壁应无恙，雪堂还在不。\n多将民疾苦，归日奏宸旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送潘提干","author":"释元肇","text":"圣代重伦魁，难教佐外台。\n天文动星象，云气上蓬莱。\n道士携琴送，吟船载鹤回。\n中兴紫岩老，今日又重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王右曹知南剑","author":"释元肇","text":"列宿守延平，旌旗过浙迎。\n地传龙化剑，州傍水为城。\n劲气民情直，澄波政样清。\n公庭应事简，所得是诗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送山阴僧还西山","author":"释元肇","text":"香城高处住，瀑布挂檐间。\n莫雨滕王阁，白云秦望山。\n到家如客寄，直语对人悭。\n却忆来时路，松门夜不关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠缝人","author":"释元肇","text":"传来家法远，妙在自通方。\n到处逢僧说，前年离帝乡。\n腰围怜我瘦，舞袖为谁长。\n不用悬牌额，兰深路有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云谷日者","author":"释元肇","text":"卖卜不论钱，开囊乞赠篇。\n先生虽有术，野客不知年。\n披雪穿吴市，占星落楚天。\n茫茫寰海内，为觅隐神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈省元归通川","author":"释元肇","text":"买宅船桥住，情深得共论。\n儿能学吴语，老念出齐门。\n绿树阴行色，清江涨别痕。\n邻人相过处，欢乐胜羌村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚过上竺礼天目","author":"释元肇","text":"幽怀日成趣，与世不相闻。\n瘦似梅花树，闲如竺岭云。\n叶间新句法，石上旧苔纹。\n送我溪桥路，松梢又夕曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和天目送行","author":"释元肇","text":"握手下层翠，秋声动泬寥。\n叶寒山径响，雨积水程遥。\n古甸分烟树，孤城带晚潮。\n怀人在空谷，谊不就旌招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访天目梁渚","author":"释元肇","text":"烟渚落渔篷，行行访隐踪。\n野禽冲断径，樵子指前峰。\n云閟安禅石，霜清得句钟。\n长淮一千里，九日却重逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢焕书记画","author":"释元肇","text":"住寺近郊台，禅林扣遍回。\n门从斋后闭，客自雨中来。\n静胜方知妙，吟成不敢催。\n相思渺何许，时展画图开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送江西益禅人","author":"释元肇","text":"世路今方隘，情亲别更难。\n孤篷和雨宿，十月渡江寒。\n诗到愁时涩，书来约岁阑。\n青青狼伍寺，何日共阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送深禅人归衡岳隐山","author":"释元肇","text":"江浙参寻遍，仍思故隐山。\n不知人住处，惟见雁飞还。\n说法龙来听，长年云闭关。\n莫将残菜叶，流落在溪间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送同游归里","author":"释元肇","text":"俱有萱庭念，相依岁月深。\n平时行乐地，此夜别离心。\n晓渡吴云湿，秋生楚岫阴。\n独怜乌鹊喜，不到我家林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄远","author":"释元肇","text":"拄策穷西望，闲云去复生。\n乱鸦栖落日，孤雁叫寒更。\n坐久灯生晕，衣单梦不成。\n遥知今夜月，还向故人明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送珂书记游金陵","author":"释元肇","text":"两度扣幽扃，知君无俗情。\n远抛孤屿碧，久住冷泉清。\n吟骨瘦欲出，行囊贫得轻。\n天寒犹未返，贪看石头城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"更深亭","author":"释元肇","text":"幽趣上林梢，添高一把茅。\n乾坤常在定，日月自相交。\n云怕人知处，门开僧不敲。\n丛台歌舞散，空有燕来巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀人","author":"释元肇","text":"自觉怀人远，閒房独掩扃。\n去时梅著子，归晚竹添丁。\n海岸无山碧，天涯有草青。\n春潮知信候，日日过夷亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧东归","author":"释元肇","text":"欲作庐山去，幡然兴已收。\n故乡一夜梦，明月两中秋。\n落叶堆寒色，孤帆挂远愁。\n不知从此后，谁上仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沅清溪游江西","author":"释元肇","text":"桐庐山下水，彻底照人清。\n流向西江去，吟高旧日声。\n洪崖千丈雪，黄鹤一楼晴。\n知是何时到，随缘不算程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"写照王肖岩","author":"释元肇","text":"王君善写真，当世独超伦。\n才见皆能识，方知妙入神。\n鸳行传国士，麟阁貌功臣。\n安有工夫到，寒岩枯木身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄冷泉康书状","author":"释元肇","text":"康庐有隐君，久爱北山文。\n涧底弄清泚，岭头吟白云。\n月随行处影，猿向定中闻。\n寄得书来说，怜余在鹭群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡越","author":"释元肇","text":"半月金陵路，今朝渡浙河。\n回头吴岫在，到耳越音多。\n贺监湖边柳，右军池上鹅。\n宛然风物在，人事几消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡中","author":"释元肇","text":"雨宿剡中寺，晓行犹未晴。\n诸峰云不定，叠涧水争鸣。\n野店穿心过，村樵当面横。\n寻思戴安道，千古一溪清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新昌石像","author":"释元肇","text":"愿力坚如石，三生凿得开。\n始知真实相，元不假胚胎。\n宝阁层层见，香云冉冉回。\n尽诚皈敬者，莫待下生来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天姥","author":"释元肇","text":"自登天姥岭，飞雪满千峰。\n采药难寻径，啼猿不见踪。\n赤城应改色，白道定相逢。\n渐觉吾庐近，微闻日暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石桥","author":"释元肇","text":"绝景隔凡尘，探幽雪未分。\n飞来双涧瀑，摊作一桥云。\n圣迹常时现，人间到处闻。\n煎茶亭上立，花乳自纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送照晦岩赴下竺","author":"释元肇","text":"法道日堪嗟，邪师似稻麻。\n灵山承付嘱，佛陇正传家。\n曲水慈云石，芗风御苑花。\n昙猷桥畔别，烟树思无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐柏观","author":"释元肇","text":"仙者曾居地，峰峦特异常。\n泉飘箫乐响，松暗洞门藏。\n玉井通三岛，琼台接上苍。\n有时闻鹤下，醮罢月侵廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬赵菊庄","author":"释元肇","text":"读来诗百首，清绝少如君。\n碧水有明月，青天无片云。\n台山才一见，衡岳又相分。\n此处多回雁，新题到里枌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华顶峰","author":"释元肇","text":"台岭碧重重，中高华顶峰。\n尽头沧海出，半被白云封。\n屋冷僧抛去，仙来井有踪。\n绝无猿鸟路，争得世人逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗汉树","author":"释元肇","text":"岭上罗汉树，魁梧迥不群。\n死心虽灭火，直气尚凌云。\n空得浑无物，中能著数君。\n非同木居士，题号涉功勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿广闰寺庾岭方丈","author":"释元肇","text":"两程行始到，寺与海波邻。\n插草燉煌士，传衣庾岭人。\n话长缘久别，月澹欲侵晨。\n忆在凌霄日，相同是夙因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄南叔凯","author":"释元肇","text":"苦思南叔凯，相别已多年。\n生与慈云近，灯从智者传。\n怜渠如我癖，忤俗是诗篇。\n桥畔青松老，期来看瀑泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中","author":"释元肇","text":"篮舆走白沙，风雪正交加。\n片石皆成玉，茎茅尽著花。\n禽危巢欲堕，樵失路应差。\n归晚堪寻处，清溪一线斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒岩","author":"释元肇","text":"信宿到寒岩，灵踪出晓岚。\n悬崖嵌似凿，著屋巧如龛。\n石月观心处，霜钟是对谭。\n遍寻双隐句，风叶已䰐鬖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明岩","author":"释元肇","text":"不与众峰同，才容寸步通。\n跨门岩响屧，县度水行空。\n僧住知无厌，人来看莫穷。\n相传幽洞透，寒拾往还中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天封","author":"释元肇","text":"神指灵墟地，峰从华顶分。\n东封时未至，西域教先闻。\n丈室高皇字，重修笠泽文。\n幽寻三十里，穿破石桥云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赤城","author":"释元肇","text":"秀气融台岳，虚玄第玉京。\n飞霞染丹石，危堞露层城。\n华雨无时歇，松风夹道鸣。\n昙猷洗肠处，泉井至今赪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莲华峰","author":"释元肇","text":"绝顶高峰上，如何下手栽。\n崔嵬出云际，菡萏向天开。\n大寂身千劫，浮图雪一桅。\n横担楖栗去，曾有几人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"台城道中","author":"释元肇","text":"枝暗花成子，风飘絮作萍。\n雨侵溪涨白，山脱晚云青。\n又过仙人渡，还登酌水亭。\n往来人自老，双鹭立烟汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄吴荆溪大监","author":"释元肇","text":"水心铭未立，属望在荆溪。\n一字如山重，何人落笔题。\n昌黎悬斗柄，皇甫接天梯。\n草木无情者，垂垂露泣低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"碧沼","author":"释元肇","text":"潋滟一池莲，禅房住半边。\n北通关市路，西透马塍泉。\n碧色冷摇日，香风近扑天。\n远公虽不作，清社有人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬上官右史","author":"释元肇","text":"住山今几年，归兴只飘然。\n野水无边际，浮云自变迁。\n螭坳曾侍立，渔火对愁眠。\n二老成来往，三生定有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊然","author":"释元肇","text":"真个无营者，方能向此居。\n花间谁是蝶，池上不知鱼。\n竹户清阴碎，苔阶翠点疏。\n东西几片壁，只贴坐忘书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台道中","author":"释元肇","text":"麦垄桑麻接，行行百里赊。\n一番飞谷雨，满地落桐花。\n水曲成三渡，山坳忽数家。\n归来襟袖上，犹带赤城霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怡云","author":"释元肇","text":"云是无心物，悠悠天地间。\n长年抱幽石，何处觅深山。\n白日看舒卷，清风任往还。\n有时随雨去，不似老僧闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"施东洲苍云","author":"释元肇","text":"东洲一片云，凝住石湖滨。\n群岫堆苍玉，万松生翠鳞。\n相看碑上字，不死墓中人。\n曾笔中兴事，伤时在泣麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔父","author":"释元肇","text":"身外即江山，流行坎止间。\n烟波垂钓直，天地一舟闲。\n到岸卖鱼去，无钱得酒还。\n不知尘世换，几度月弯弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水竹园","author":"释元肇","text":"开园多傍水，种竹近临皋。\n试问诸君子，何须快剪刀。\n清风招六逸，碧浪识三高。\n却笑任公子，持竿欲钓鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张书监","author":"释元肇","text":"张公深隐处，花墅竹间篱。\n不作明时用，能令薄俗移。\n高风喧地籁，清节照天池。\n月下常来往，幽禽野鹿知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琴川图","author":"释元肇","text":"胜处著幽亭，烟林四望平。\n高山千古意，流水七弦情。\n偃室犹堪仰，虞风旧有名。\n丹青难下手，松竹自传声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上官右史庆幸堂","author":"释元肇","text":"先生何庆幸，年老乐安闲。\n得地无多亩，营堂不数间。\n种花皆结子，移石便成山。\n只有双双鹤，相随日往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹石","author":"释元肇","text":"脩篁拥翠幢，魁石坐端方。\n劲节经寒在，新梢入夏长。\n云从根上起，玉向实中藏。\n为雨从龙后，清风满菊堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"润云","author":"释元肇","text":"高结据空虚，吴中大隐居。\n碧云生暮景，清气浥楼书。\n座上通玄客，门前长者车。\n东隅贯休阁，相望复何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宜静","author":"释元肇","text":"日月忙推毂，乾坤著草亭。\n一波才底定，万化自消停。\n幽极风敲竹，微闻鹤振翎。\n白云虽自在，争似远山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅月","author":"释元肇","text":"堂上传风雅，高标一段奇。\n韵清梅蘸水，生白月来时。\n有影皆成画，无声总是诗。\n屋头春信早，催发向南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过郑文昌庵","author":"释元肇","text":"腊天三四日，曾到锦峰来。\n世上无知己，松根坐古苔。\n茶烟凝户晓，风雪打船回。\n却忆星辰履，如今安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和洪提举送平斋集","author":"释元肇","text":"平斋大全集，千古播幽芳。\n骚雅杜陵老，雄深马子长。\n天能留稷契，世可致虞唐。\n乐府尤清丽，难回铁石肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得坐","author":"释元肇","text":"一室坐春空，寥寥万境容。\n月移旁砌竹，风借别楼钟。\n暗处元非滞，明边亦是逢。\n五更侵早起，清露滴长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落花","author":"释元肇","text":"万紫及千红，枝头一饷空。\n多因伤夜雨，曾不怨春风。\n片片随流去，纷纷夕照中。\n自开还自落，只与去年同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日庵居","author":"释元肇","text":"开门一径通，花木四时同。\n阴密松成盖，香多桂作丛。\n凿池要皓月，移竹种清风。\n未息尘机者，应难到此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日","author":"释元肇","text":"今逢重九名，居野见幽清。\n地静黄花早，天空落叶声。\n耕人齐上垄，荒日半沈城。\n除却陶彭泽，同谁话此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"火閤","author":"释元肇","text":"装折围炉地，方方七尺强。\n易容元亮膝，难著净名床。\n省炭功虽小，烧香味较长。\n晏然宜袖手，免去暴朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乖目相者","author":"释元肇","text":"一双乖角眼，阅世妙无伦。\n白日常穿市，青云少见人。\n未尝眠锁店，午后听钟邻。\n盍向边头看，谁为阁上麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"披云庵","author":"释元肇","text":"绝顶住居安，千峰翠作攒。\n风吹云影破，天漏月光寒。\n野水无行路，孤松半倚看。\n有时吟到晓，清韵激飞湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马宋英画松","author":"释元肇","text":"元气淋漓湿，画师今几人。\n宋英传古色，韦偃是前身。\n森竦髯如猬，粼皴铁作鳞。\n蟠根岩壑底，多幸不遭秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题赵山台莲华方丈","author":"释元肇","text":"十尺方围地，一枰云锦衣。\n禅心不著水，天女暗投机。\n莫道荣枯异，谁云语默非。\n荷间休结屋，趣入道山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"啸岩","author":"释元肇","text":"丘石虎西蹲，月明烟水村。\n扣舷穿蠡口，长啸彻苏门。\n要得却胡骑，应须梦至尊。\n苦吟天地窄，万物本同根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送印宝章知温州","author":"释元肇","text":"东嘉山水郡，灵运后知名。\n孤屿云簪笔，清江玉带城。\n伏波思雁远，春草梦诗成。\n五马人生贵，二难时共荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒙斋","author":"释元肇","text":"蒙居养正斋，清景湛灵台。\n叠石移山至，开池待月来。\n是谁游象外，求我放心回。\n庭际风敲竹，分阴满绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]