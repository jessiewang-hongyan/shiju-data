[{"title":"翠微山居诗 其一","author":"释冲邈","text":"山水煎茶拗柳枝，禅衣百结任风吹。\n看经只在明窗下，得失荣枯总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其二","author":"释冲邈","text":"任运腾腾作老颠，何须论道复论禅。\n莫将闲事来相扰，妨我长伸两脚眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其三","author":"释冲邈","text":"闲来石上卧长松，百衲袈裟破又缝。\n今日不愁明日饭，生涯只在钵盂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其六","author":"释冲邈","text":"老来欲觅人间物，须向红尘问世人。\n莫怪山僧无扫帚，都缘行处不生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居八首 其四","author":"赵彦端","text":"幼入空门绝是非，老来学道转精微。\n钵中贫富千家饭，身上寒暄一衲衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其八","author":"释冲邈","text":"莫向人间定是非，是非定得有何为。\n而今休去便休去，若欲了时无了时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其九","author":"释冲邈","text":"朝见花开满树红，暮观落叶又还空。\n若将花比人间事，花与人间事一同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十","author":"释冲邈","text":"百计千般只为身，不知身是冢中尘。\n莫欺白发无言语，此是黄泉寄信人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十一","author":"释冲邈","text":"早灰百念卧灵山，世路无心绝往还。\n僧相祇宜林下看，不堪行到画堂前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十二","author":"释冲邈","text":"一池荷叶衣无尽，数树松花食有馀。\n却被世人知去处，更移茅舍作深居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十三","author":"释冲邈","text":"高山远望石碐碐，叠嶂回峦数十层。\n时人只识云生处，不见松萝岩下僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十四","author":"释冲邈","text":"辞君莫怪归山早，为忆松萝对月宫。\n台殿不将金锁闭，来时自有白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十五","author":"释冲邈","text":"独摇金锡出樊笼，便踏孤云上碧峰。\n莫怪脚穿脱尘履，且图行处不留踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十六","author":"释冲邈","text":"三界无家谁最亲，十方惟有一空身。\n但随云水伴明月，到处名山是主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十七","author":"释冲邈","text":"茅檐静对千山月，竹户闲楼一片云。\n莫送往来名利客，阶前踏破绿苔纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十八","author":"释冲邈","text":"踏石窗山一老僧，白云为伴水为朋。\n通宵只在洞中宿，月上青山便是灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其十九","author":"释冲邈","text":"人生在世急如风，昨夜今朝事不同。\n不信但看桃李树，花开能得几时红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其二十","author":"释冲邈","text":"僧家无事最幽闲，近对青松远对山。\n诗句不曾题落叶，恐随流水到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其二十一","author":"释冲邈","text":"霜飞峭壁夜猿惊，手把松枝叫月明。\n知有石龛僧入定，朝来不作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其二十二","author":"释冲邈","text":"任性随缘一比丘，一生无喜亦无忧。\n白云纵听飞来去，但得青山在即休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居八首 其七","author":"赵彦端","text":"炉中无火已多时，早起惟将一衲披。\n莫怪山僧常冷淡，夜深无处拾松枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微山居诗 其二十五","author":"释冲邈","text":"高高峰顶恣情田，买断清闲不用钱。\n堪笑白云无定止，被他风送出山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"王逸民","text":"我生不背佛，而自外道取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为蚊所扰得一绝句","author":"徐端崇","text":"空堂夜合势如云，沟壑宁知过去身。\n满腹经营尽膏血，那知通夕不眠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"徐端崇","text":"鲁邦司寇陈义高，三闾大夫心徒劳。\n相逢一笑无言说，去宿芦花又明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"王绹","text":"我欲挂冠去，君当衣锦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"胡世将","text":"云水郊深退老堂，公来野服换龙章。\n四朝尽瘁身犹健，一德同寅福未央。\n小隐聊堪供放浪，神州终倚致平康。\n功成他日归休地，海表家风有故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"胡世将","text":"卜宅他乡得偃休，忘怀遇坎复乘流。\n功高天地云龙会，心寄丘园水石幽。\n墨客骚人多赋咏，金堂玉室纵追游。\n公念问舍真无负，自是豪英百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸丑三月十日自涌泉寺过吴文叟山居临溪观鱼辄题二诗 其一","author":"胡世将","text":"云物起争岩石秀，水拉行带野花香。\n一山应接知无暇，赖有青春白日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸丑三月十日自涌泉寺过吴文叟山居临溪观鱼辄题二诗 其二","author":"胡世将","text":"偶寻胜赏到山扉，溪影涵晖动翠微。\n正欲临流看鱼乐，扁舟宁待夜潮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏子翼送黄精酒","author":"朱弁","text":"仙经何物堪却老，较功无如太阳草。\n龙衔鸡衔名虽异，菟公羊公事可考。\n苏君真是神仙裔，橘井阴功贯穹昊。\n云笈书成数万言，银关珠宫用心早。\n独知此物有奇效，福地名山为储宝。\n不惮林泉新斸掘，斥去杵臼谢饰捣。\n况从高士论麴糜，更课公田收秫稻。\n一朝灵液浮瓮盎，三冬浩气生襟抱。\n且欣软饱得浇肠，漫说逆流工补脑。\n眼碧那忧散黑花，发白故应还翠葆。\n贾傅只嫌松醥陋，刘堕敢誇桑落好。\n直须五斗论解酲，宁待三柸乃通道。\n谁知万里落旄人，亦许匏尊自倾倒。\n为君唤回雪窖春，八载羁愁供一扫。\n曼倩宜分此日桃，安期莫诧他年枣。\n何烦更采石斛花，巳觉容颜不枯槁。\n根连石室喜入梦，句拟桐溪愧摛藻。\n平生我亦爱书扎，朱髓绿肠勤探讨。\n幸君汲引成此志，鹤驾骎骎望仙岛。\n吞腥啄腐非夙心，岁晚兹言良可保。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初春以蔓菁作齑因忆往年避难大隗山采蘋涧中为齑齑成汁为粉红色而香美特异乃信郑人所言为不诬矣今食新齑因成长韵","author":"朱弁","text":"藏蔬饱三冬，媚盘无靃靡。\n陈齑解束缚，冰雹散刀几。\n春畦芜菁苗，入眼渐可喜。\n青黄含风露，采摘从此始。\n持归作新齑，一饱竞鲜美。\n芬香溢肺肝，甘脆响牙齿。\n扪腹幽窗下，刍豢讵能比。\n忆昔避难初，窜身重嵓里。\n云烟昏具茨，老稚且栖止。\n燕兵大搜索，焚荡石牛底。\n脱命擉虎山，野哭纷四起。\n暮投山前店，茅栋例烧毁。\n潜伏窟室中，衣敝不盖体。\n妻孥坐相对，生意薄于纸。\n晨朝行涧中，采芹涧边洗。\n郑人誇此齑，他菜非所拟。\n氤氲投瓦盎，触鼻似兰芷。\n一杯红粉羹，析酲胜仙醴。\n乃知野人献，凉薄未宜鄙。\n今来滞殊乡，白首家万里。\n犹能对荤膻，咀嚼出宫徵。\n回思十年梦，争夺殊未已。\n饱食但谋身，吾颡良有泚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北人以松皮为菜予初不知味虞侍郎分饷一小把因饭素授厨人与园蔬杂进珍美可喜因作一诗","author":"朱弁","text":"吾老似出家，晚悟愧根钝。\n滋旨却膻荤，禅蜕要亲近。\n伟哉十八公，兹道亦精进。\n舍身奉刀几，割体绝嗔恨。\n鳞皴老龙皮，鸣齿溢芳润。\n流膏为伏龟，千岁未须问。\n便堪奴笋蕨，讵肯友芝菌。\n跏趺得一饱，万事皆可摈。\n侍郎文懿后，落落众推俊。\n澹然世味薄，内典得所信。\n香厨留净供，频食不言顿。\n晏然默不语，草木雷音震。\n得法于此公，骨髓传心印。\n应怜持节人，饷此为问讯。\n欲将无上味，为我洗尘坌。\n食之不敢馀，感激在方寸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予以年事渐高气海不能熟生煖冷旅中又无药物遂用火攻之策灼艾凡二百壮吟呻之际得诗二十韵","author":"朱弁","text":"不作漳滨卧，年侵血气衰。\n据鞍思少壮，揽镜叹清羸。\n有病方求艾，无营莫问蓍。\n心知出下策，理胜遇中医。\n阳燧神逾速，铜仙术尽施。\n论功鄙炮制，取穴辨毫釐。\n火帝恩光异，炎官绩用奇。\n书萤比差似，珠蚁迫方知。\n忖物嗟炮鳖，观形笑灼龟。\n烟微初炙手，气烈渐钻皮。\n闭目书徒展，支头枕屡移。\n发狂还自哂，贾勇仅能支。\n宋鹢追风日，吴牛喘月时。\n忠言劳缓颊，善谑为开眉。\n服气工夫远，烧丹岁月迟。\n卫生防后患，伐性释前疑。\n展转那成梦，呻吟且当诗。\n因心念民瘼，出位叹身卑。\n欲巳七年病，当从百世师。\n保身将保国，未可废箴规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕有感","author":"朱弁","text":"朔雪馀千里，东风遍九州。\n关河中土异，灯火上元愁。\n绿蚁尝新酿，青貂恋故裘。\n紫姑无用卜，世事正悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆钟离浚","author":"朱弁","text":"浚都同聚读书萤，楚岸春风忆送行。\n三十年前初识面，四千里外更关情。\n出疆我亦徒劳尔，入仕君今何似生。\n旅雁相逢须一问，要从邮上得新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"炕寝三十韵","author":"朱弁","text":"风土南北殊，习尚非一躅。\n出疆虽仗节，入国暂同俗。\n淹留岁再残，朔雪满崖谷。\n禦冬貂裘弊，一炕且跧伏。\n西山石为薪，黝色惊射目。\n方炽绝可迩，将尽还自续。\n飞飞涌玄云，焰焰积红玉。\n稍疑雷出地，又似风薄木。\n谁容鼠栖冰，信是龙衔烛。\n阳曦助喘息，未害摇空腹。\n惠气生裤襦，仍工展拳足。\n岂惟脱肤鳞，兼复平体粟。\n负暄那用诧，执热定思沃。\n收功在岁寒，较德比时燠。\n虽馀炙手焰，宁有烂额酷。\n矧当凝泫辰，炎帝独回毂。\n玄冥真退听，祝融端可录。\n嗟予亦何者，万里歌黄鹄。\n偃仰对窗扉，妍煖谢衾褥。\n壮怀羞灶媚，晚悟笑突曲。\n因思堕指人，暴露苦皲瘃。\n频年未解甲，蹈此锋刃毒。\n遥知革辂中，旰食安豆粥。\n陪臣将命来，意恳诚亦笃。\n有奇不能吐，何术止南牧。\n君心想更切，臣罪何由赎。\n此身虽自温，此志转烦促。\n论武贵止戈，天必从人欲。\n安得四海春，永作苍生福。\n聊拟少陵翁，秋风赋茅屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋泉次韵","author":"朱弁","text":"新醅滃滃溢瓶盆，漱石秋泉带雨浑。\n翡翠杯深云液凝，鸬鹚杓满月波翻。\n照人光入樽罍瑩，流齿香随语笑喷。\n巳拚扶头日三丈，朝酲未解任昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨枕上","author":"朱弁","text":"淅淅风声止，凄凄雨气凉。\n愁工萦客思，梦故绕江乡。\n书疏亲朋少，干戈岁月长。\n平城弭节地，可复见秋霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客怀","author":"朱弁","text":"兵气常时见，客怀何日开。\n形骸病自瘦，鬓发老相催。\n巳负秦庭哭，终期汉节回。\n风雷识意我，一雨洗氛埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁序","author":"朱弁","text":"岁序忽将晏，节旄嗟未还。\n低云惨众木，寒雨失群山。\n丧乱关诗思，讴谣发病颜。\n梦魂识旧隐，时到碧溪湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白发","author":"朱弁","text":"白发使车前，烟波思渺然。\n霜清穫稻日，风急授衣天。\n客馆但愁坐，钓舟谁醉眠。\n乘槎会有便，真到斗牛边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有感","author":"朱弁","text":"容貌与年改，鬓毛随意斑。\n雁边云度塞，鸟外日衔山。\n仗节功奚在，捐躯志未闲。\n不知垂老眼，何日睹龙颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘善长出示李伯时画马图","author":"朱弁","text":"俯首举尾拳一蹄，掣缰欲嗅骄不嘶。\n奚官耸肩两足垂，意皃自与造父齐。\n鸡目麟鬐凤皇臆，玉山禾远未容食。\n籋云追雹有馀地，置之画图人岂识。\n精神权奇孰可班，当在白兔青龙閒。\n君知此马从何来，龙眠胸中十二闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢崔致君饷天花","author":"朱弁","text":"三年北馔饱膻荤，佳蔬颇忆南州味。\n地菜方为九夏珍，天花忽从五台至。\n崔侯胸中散千卷，金瓯名相传云裔。\n爱山亦如谢康乐，得此携归岂容易。\n应怜使馆久寂寥，分饷明明见深意。\n堆槃初见瑶草瘦，鸣齿稍觉琼枝脆。\n树鸡湿烂惭扣门，桑蛾青黄谩趋市。\n赤城菌子立万钉，今日因君不知贵。\n乖龙耳仅兔一割，沙门业巳通三世。\n偃戈息民未有术，虽复加餐秖增愧。\n云山去此纵不远，口腹何容更相累。\n报君此诗永为好，捧腹一笑万事置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"战伐","author":"朱弁","text":"战伐何年定，悲愁是处同。\n黄云萦晚塞，白露下秋空。\n鱼跃深波月，乌啼落叶风。\n谁知渡江梦，一夜绕行宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙福寺煮东坡羹戏作","author":"朱弁","text":"山寺解尘鞅，溪边有微行。\n手摘诸葛菜，自煮东坡羹。\n虽无锦绣肠，亦饱风露清。\n钩帘坐扪腹，落日千峰明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙申中秋不见月","author":"朱弁","text":"中秋万里月，何处驾冰轮。\n底事隔年会，不怜今夕人。\n兔疑停杵臼，蟾岂避风尘。\n默识常娥意，氶平赏更新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十七夜对月","author":"朱弁","text":"病骨怯风露，愁怀厌甲兵。\n人居绝域久，月向此宵明。\n轮仄初经汉，光分半隐城。\n迟迟不肯下，应识异乡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡轩为赵光道作","author":"朱弁","text":"深炷炉香睡息匀，萧然一觉得天真。\n生涯聊示人閒世，缘境都忘药裹身。\n窥牖屡来从汝唤，叩门空去任渠嗔。\n更须满壁图云水，卧想江湖渺莽春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南斋即事","author":"朱弁","text":"频年行役梦庭闱，陟岵常嗟脚力疲。\n每诉酒巡嫌客恶，力营官事笑儿痴。\n云山幸不持钱买，花竹何妨带雨移。\n此味责人元未识，恐缘诗好被渠知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯和父之并州","author":"朱弁","text":"有北何堪说，如南未是归。\n并门子径往，汉节我方鞿。\n笔砚论心久，干戈会面稀。\n新程相忆处，路入岭云微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"独坐","author":"朱弁","text":"草冻慵抽碧，桃痴懒晕红。\n黄云犹汉野，紫塞漫春风。\n使节空留滞，侯圭未会同。\n阶除雪不扫，独立数归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食","author":"朱弁","text":"绝域年华久，衰颜泪点新。\n每逢寒食节，频梦故乡春。\n草绿唯供恨，花红只笑人。\n南辕定何日，无地不风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上巳","author":"朱弁","text":"行行春向暮，犹未见花枝。\n晦朔中原隔，风烟上巳疑。\n常令汉节在，莫作楚囚悲。\n早晚鸾旗发，吾归敢恨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天问绝句","author":"朱弁","text":"穴边酣战君臣蚁，波上群嬉婢妾鱼。\n苦乐不同同一宇，问天此理竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客夜","author":"朱弁","text":"城月四更上，窗风一室幽。\n纤云萦雁塞，重雾逼貂裘。\n兵革何年息，乾坤此夜愁。\n殊乡两行泪，骚屑洒清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"摅抱","author":"朱弁","text":"客滞殊方久，山围绝塞深。\n秋风入撗笛，夜月傍沾襟。\n造膝他时语，捐躯此日心。\n飞霜满明镜，发短不胜簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重九","author":"朱弁","text":"九日今何地，寒深紫塞霜。\n敢嫌芦酒浊，且对菊花尝。\n岁月双蓬鬓，乾坤百战场。\n赐萸知未举，梦自识鸳行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘太师苦吟之什","author":"朱弁","text":"长城五字屹逶迤，可笑偏师敢出奇。\n句补推敲未安处，韵更瘀絮益难时。\n痴迷竟作禽填海，辛苦真成蚁度丝。\n却羡弥明攻具速，刘侯漫说也能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"善长命作岁除日立春","author":"朱弁","text":"土牛巳着劝农鞭，苇索仍专捕鬼权。\n且喜春盘兼守岁，莫嗟腊酒易经年。\n东风渐入江梅梦，朔雪犹迷塞柳天。\n元会明朝定何处，羁臣挥泪节旄前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子文秋兴","author":"朱弁","text":"逸兴常时有，逢秋一倍多。\n山长含楚雨，天远接吴波。\n寻壑同元亮，浮家伴志和。\n钓竿行入手，还着向来蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬雨","author":"朱弁","text":"冬雨不成雪，北风寒未深。\n山藏千垒秀，云结四垂阴。\n迥洒凌朝阁，残声入夜衾。\n端能洗兵甲，足慰此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]