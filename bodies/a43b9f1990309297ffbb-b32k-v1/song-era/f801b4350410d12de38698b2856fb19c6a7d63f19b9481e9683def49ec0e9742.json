[{"title":"六和 其一","author":"刘克庄","text":"对策南宫耻诡随，聊摅腹愤发胸奇。\n并驱何异牛同骥，独步方知虎畏罴。\n罚汝业儒磨铁砚，输它拥妓写乌丝。\n区区梦里争蕉鹿，笑杀傍人与士师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六和二首 其二","author":"刘克庄","text":"生怕将军手涴靴，安能柔软舞灵和。\n艰虞夷甫方谋窟，老懒尧夫少出窝。\n时事累棋如许急，春愁抽茧未为多。\n终南一径非常捷，自是吾徒问路蹉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六和二首 其一","author":"刘克庄","text":"那复熏衣事早朝，杖藜时赴野人招。\n谋身不善交韩吕，度世犹堪访贺乔。\n杖有百钱寻酒盏，家无一物止诗瓢。\n君看莘渭三王佐，何似夷齐万世标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六和谢其见访","author":"刘克庄","text":"薄有鸡豚趁墟市，寂无鸟雀下阶除。\n疾驰轻骑衔枚至，兴尽扁舟激箭如。\n我老幻身聊据槁，君豪诗骨可专车。\n吾闻海上鲸堪脍，沮洳何缘有大鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内翰洪公舜俞哀诗二首 其二","author":"刘克庄","text":"回首扬州一梦馀，故交已直玉堂庐。\n寒暄未省通君实，穷薄空烦诵子虚。\n甚愧丈人于甫厚，孰云夫子不回如。\n残年无复陪精论，开阖平生几幅书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内翰洪公舜俞哀诗二首 其一","author":"刘克庄","text":"忆昔端平典册新，三麻九制笔如神。\n内庭唤作真学士，晚辈推为老舍人。\n垂死遗言尤苦口，平生谏疏最婴鳞。\n建功不作于潜死，谁为君王说厚伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤孙余第六孙也早慧忽夭追悼一首","author":"刘克庄","text":"竟失鹓雏种，难求扁鹊医。\n两行樗叟泪，一本杏殇书。\n抱去常回顾，呼来尚挽髭。\n案头庄列子，哀至掩还披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台晚眺","author":"刘克庄","text":"经月疏行台上路，秣陵城郭忽秋风。\n马嘶卫霍空营里，萤起齐梁废苑中。\n野寺旧曾开玉帐，翠华久不幸离宫。\n小儒记得隆兴事，闲对山僧说魏公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"匹马","author":"刘克庄","text":"匹马曾经小店炊，一株玉雪映疏篱。\n无言谁识含情处，有韵全看背面时。\n乍见心方惊绝艳，重来人已折繁枝。\n断烟残照山村路，消得刘郎一首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人李先辈丑父尝以夷成诗二帙示余莫知为何人所作心甚爱之过延平客有袖诗一章见访始知夷成者盖叶君之别号也须发皓然矣诗与人皆可重因用其韵为谢","author":"刘克庄","text":"筋力都非少壮时，不烦揽镜觉吾衰。\n展禽出仕曾三已，表圣归休有四宜。\n饱阅交情悲世道，差强人意赖君诗。\n此生到死惭三士，本自难招况易麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人病疮","author":"刘克庄","text":"自检方书坐一床，教寻蒿白采蒲黄。\n画眉连日疏妆閤，鍊气通宵住道房。\n倦听瀑声令睡醒，闷拈诗卷遣心凉。\n犹胜华发从军客，归卧茅檐养战疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人病痁","author":"刘克庄","text":"昔闻诗可驱痁疾，今日诗人疾自婴。\n势似边兵鏖未解，根同野草刬还生。\n能蠲热障惟山色，解洗烦襟只涧声。\n溪友祝君如虎健，督僧栽种课奴耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子九日与群从子侄登乌石山用樊川韵","author":"刘克庄","text":"垂髫登巘捷于飞，岁晚重来脚力微。\n壹死壹生群从少，某丘某水几人归。\n即今秉烛游清夜，自古无绳系夕晖。\n莫忆宫门谢时服，海图尚可补寒衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰春上冢五首 其四 中?","author":"刘克庄","text":"忆昨隆乾致太平，诸贤耸听凤先鸣。\n奏篇不愧登瀛选，拂袖难留出昼行。\n当日伯夷兄弟瘦，至今杨震子孙清。\n定知千载蟆陵路，尚有行人酹董生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰春上冢五首 其二 西楼","author":"刘克庄","text":"溪草林花争碧红，伤心黄壤閟芳容。\n短松明月易陈迹，断雨残云难觅踪。\n伊昔老盆常共酌，即今败絮倩谁缝。\n臼间一斗仓陈粟，薄暮归来独自舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰春上冢五首 其一 城南","author":"刘克庄","text":"一闭幽堂十九年，万松手种已参天。\n懒随人乞郭东祭，自与母耕绵上田。\n试问拂云施鹤表，何如藉地荐豚肩。\n此身只合安闾里，长为先君扫墓阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰春上冢五首 其三 郭西","author":"刘克庄","text":"自古佳城属吉人，郭书王谶岂能神。\n扫松稍喜衣冠众，荐芰何妨俎豆贫。\n委巷起家基世德，分山葬友等天伦。\n侧傍即是黄香冢，冥漠之中尚卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天台杨景清以所进春秋发微示余辄题小诗其后","author":"刘克庄","text":"奏篇久矣彻凝旒，谁信栖栖负笈游。\n新义书之于简策，微辞知我者春秋。\n即今未劝迩英讲，他日应烦掌故求。\n历数先儒多晚达，前孙明复后康侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天基节口占二首 其二","author":"刘克庄","text":"赫风隐隐听宫县，曾立红云一朵边。\n天语下询颜不远，帝歌自作墨犹鲜。\n台郎谁是玄都旧，舆尉安知绛老年。\n散吏宫花能几许，诸孙争怕落人先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天基节口占二首 其一","author":"刘克庄","text":"报道东方欲辨晨，强扶衰惫起冠绅。\n差贤眇者与跛者，窃比封人祝圣人。\n野老岂知蒙帝力，农夫稍有告余春。\n不须景慕斜川叟，且作田间击壤民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守宋监丞新三先生祠刊二刘遗文以二诗纪实 其二","author":"刘克庄","text":"俱事重华著直声，百年藏藁未流行。\n世评谏疏如刘向，公读遗书感乐生。\n里有襄阳耆旧传，史无齐鲁大臣名。\n孤孙白首荒家学，甘作滕民负耒耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守宋监丞新三先生祠刊二刘遗文以二诗纪实 其一","author":"刘克庄","text":"两翁仕不至丞郎，名节能流百世芳。\n穷巷号为通德里，旧书藏在善和坊。\n古楹日敝加丹刻，老柏年深益黛苍。\n太守怀贤崇教化，乡先生盍祭于乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守林太博赠瑞香花 其七","author":"刘克庄","text":"短笺小草墨痕斜，句法来从和靖家。\n吟赏岂无神助笔，护持疑有物司花。\n莫因山鸟啼榕树，便忆河豚饱荻芽。\n多少邦人沾剩馥，愿碑遗爱永传誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守林太博赠瑞香花 其六","author":"刘克庄","text":"拙笔芜辞字半斜，情知见笑大方家。\n放教吉甫独哦句，除却微之谁别花。\n勾引亲朋需果核，堤防风日损根芽。\n玉津应制须公等，林下樵歌敢自誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守林太博赠瑞香花 其三","author":"刘克庄","text":"吏散庭空戟影斜，吟笺飞到野人家。\n隋珠和璧难酬价，禅榻茶瓯忒负花。\n谱欠名人为品藻，诗因尤物始萌芽。\n近公匹似熏班马，荀令风流未足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守林太博赠瑞香花 其五","author":"刘克庄","text":"几点朝来小雨斜，未应造物妒山家。\n陡惊春报千林信，拟问天留数日花。\n写物祇今须老笔，染根何处有灵芽。\n彩云过眼真如梦，著意追摹岂好誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守林太博赠瑞香花 其二","author":"刘克庄","text":"坏径泥深古槛斜，居然幻作贵游家。\n小亭自课僮锄草，空室俄惊女散花。\n便觉麝囊无远韵，频挑蚁蠹有新芽。\n紫薇红药催公去，独许诗留野老誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守林太博赠瑞香花 其一","author":"刘克庄","text":"一树婆娑整复斜，使君辍赠到田家。\n自惭瓮牖绳枢子，不称香囊锦伞花。\n小借煖风为破萼，旋浇新水待抽芽。\n丁宁童子勤封植，留与甘棠一样誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太守林太博赠瑞香花 其四","author":"刘克庄","text":"吟讽攀翻到月斜，众惊奇宝聚贫家。\n高才盍视宫中草，退士聊看屋角花。\n未必园丁谙树性，更愁墨客笑姜芽。\n画堂金鼎熏兰麝，岂有天然韵可誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆毛易甫薛子舒","author":"刘克庄","text":"昔在江东会集时，二君独许话心期。\n春风萧寺同登塔，落日荒台共读碑。\n百吏染毫供草檄，万花围席看题诗。\n那知数尺无情土，别后双埋玉树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆昔","author":"刘克庄","text":"晚遇先皇诏起家，负金莲炬紫薇花。\n犯颜屡抗涂归疏，断腕难操起复麻。\n愚不入时逃北谷，老难待漏守东华。\n人生惟有村田乐，未觉封侯胜种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆昔","author":"刘克庄","text":"忆昔春郊共踏青，十人中已九凋零。\n溘先未遣随朝露，殿后姑留作曙星。\n老眼蝇书犹可读，微聋蚁闹不须听。\n申公岁晚殊多事，白首番番诣汉廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆昔二首 其二","author":"刘克庄","text":"武皇好赋网群英，犹记龙颜赏墨卿。\n白玉牒中曾有草，碧纱笼里本无名。\n唐诗卒使张穷瞎，国语能令左失明。\n老子一生嗜章句，故应天罚遣偏盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆昔二首 其二","author":"刘克庄","text":"犹记颛蒙昔未开，自鞭宁待父师哉。\n残编常到鸡声彻，警枕频惊蝶梦回。\n且可遍参学童子，未应一跳至如来。\n丛林个个谈宗旨，谁是禅家大辩才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆昔二首 其一","author":"刘克庄","text":"忆惜金鞭观玉台，当年并驾尽龙騋。\n恰逢居易投诗去，又报奇章袖贽来。\n病谢交游空感旧，老无气力尚怜才。\n孟阳残锦都能几，莫为诸君更剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆昔二首 其一","author":"刘克庄","text":"过去生中一念差，强扶衰朽践清华。\n出灵芝殿浑忘却，入大槐宫岂梦耶。\n不记省中红芍药，曾看天上碧桃花。\n而今送老荒村里，且向溪边间麦麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆真州梅园","author":"刘克庄","text":"当年飞盖此追随，惨澹淮天月上时。\n树密径铺毡共饮，花寒常怕笛先吹。\n心怜玉雪空存梦，尘暗关山阻寄诗。\n纵使京东兵暂过，可无一二斫残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆强甫","author":"刘克庄","text":"临歧约共屠苏酒，及饮屠苏汝未归。\n纵使举头瞻日近，可堪返顾见云飞。\n索长安米难淹久，回剡溪船果是非。\n别后安书如束笋，眼穿新岁雁来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆藕","author":"刘克庄","text":"昔过临平召伯时，小舟就买藕尤奇。\n如拈玉麈凉双手，似泻金茎咽上池。\n好事染红无意绪，痴人蒸熟减风姿。\n炎州地狭陂塘少，渴死相如欠药医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方氏侄女哀诗","author":"刘克庄","text":"少也矜华整，俄而扫艳秾。\n吾常才道韫，汝竟妻南容。\n薄味宁蔬素，流芳欠管彤。\n伯兄与邱嫂，净土必相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方寺丞?子初成","author":"刘克庄","text":"船成莫厌野人过，久欲从公具钓蓑。\n积雨晴来湖面阔，残花落尽树阴多。\n新营小店皆依柳，旧有危亭尚隔荷。\n所恨前峰含暝色，不然和月宿烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方寺丞招宿瀑上不果","author":"刘克庄","text":"久与瀑泉疏，劳公下檄书。\n极知居陋巷，不似宿精庐。\n奴客辞看犊，邻人畏借驴。\n何时儿子壮，聊为举篮舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方寺丞除云台观","author":"刘克庄","text":"河岳腥膻愤未忘，羡公遥领旧灵光。\n草荒太白骑驴迹，云冷希夷委蜕裳。\n定有遗民来献土，可无散吏去焚香。\n吾闻同华多奇观，不比炎州寂寞乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方寺丞新第二首 其二","author":"刘克庄","text":"一生不蓄买田钱，华屋何心亦偶然。\n客至多逢僧在坐，钓归惟许鹤随船。\n按行花木皆僚友，主掌湖山即事权。\n京洛贵人金谷里，安知世上有林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方汝一下第饯诗盈轴余亦继作","author":"刘克庄","text":"纷纷肉马上青天，骥耳双垂亦可怜。\n郊岂因穷吟遂辍，蕡虽不第策犹传。\n会须有集鸣当世，肯为无媒怨盛年。\n斗气烛君文卷里，更于何处觅龙泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方具免牍走笔次竹溪中书韵","author":"刘克庄","text":"不知捷径在终南，应是癯儒骨相凡。\n马负遥瞻隔河洛，牛车蚤已出殽函。\n自怜鬓雪今垂领，岂料条冰晚入衔。\n望见蓬莱吾足矣，逆风不虑更吹帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方岩尹主课渔溪","author":"刘克庄","text":"君于场屋素称雄，非止原夫一技工。\n贯虱心推白社族，执牛耳属紫薇公。\n乌衣子弟如康乐，绛帐先生得马融。\n看得龙飞第一榜，联翩奏赋冠南宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方甥饷酒酸甚","author":"刘克庄","text":"方奉手笺贻绿醑，忽通鼻观类黄齑。\n自怜徐邈时中酒，多谢微生更乞醯。\n未敢啐空杯面蚁，却愁舞杀瓮中鸡。\n相君五斗安能吸，但嗅新醅醉似泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方蒙仲秘书哀诗三首 其三","author":"刘克庄","text":"平生最受鲁公知，手简才翁语极悲。\n海内奇才都有几，世间瑞物不多时。\n君归上界骑麟去，客过新陵下马谁。\n笔秃无花衰久矣，可堪拂拭作铭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方蒙仲秘书哀诗三首 其二","author":"刘克庄","text":"方喜燃藜向石渠，岂知仅拥两轮朱。\n非为郡失好太守，便恐世无行秘书。\n酒渍双鸡惭薄薄，表论一鹗谩区区。\n即今交道尤难恃，试问原头几素车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方蒙仲秘书哀诗三首 其一","author":"刘克庄","text":"万驽骀里一龙媒，朝发瑶池暮玉台。\n介甫尤称原妙质，资深亦叹轼奇才。\n席前宣室思渠久，帆近蓬莱作么回。\n此去不应重谪堕，海山笙鹤待君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题一首","author":"刘克庄","text":"毫挥万字思如泉，曾映金莲读奏篇。\n藜杖方燃芸阁上，叶舟忽傍钓台边。\n诗成渭北空相忆，谋寝淮南恐未然。\n君去吾当从此逝，未知握手定何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下听孙季蕃吹笛","author":"刘克庄","text":"孙郎痛饮横长笛，玉雪胸襟铁石颜。\n解喷清霜飞座上，能呼凉月出云间。\n病创冻马嘶荒塞，失侣穷猿叫乱山。\n可惜调高无听者，紫髯白尽鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花","author":"刘克庄","text":"岁华摇落物萧然，一种清芬绝可怜。\n不许淤泥侵皓素，全凭风露发幽妍。\n骚魂洒落沉湘客，玉色依稀捉月仙。\n却笑涪翁太脂粉，误将高雅匹婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓦送","author":"刘克庄","text":"瓦送绣行均一去，如公之去独贤哉。\n国侨存校如迂阔，涑水辞枢冀挽回。\n聊为先师主精舍，不烦残客到翘材。\n半山未是忘情者，重拜头厅便出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见新历有感","author":"刘克庄","text":"小时玉雪二尊怜，两字眉间点缀鲜。\n尚记嬉游佩觿日，安知荏苒钓璜年。\n渡辽难以偏师从，归鲁犹将旧学传。\n自古乡先祭于社，不须辛苦上凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长溪陈梦雷携表弟赵君玉书相访","author":"刘克庄","text":"□□外弟寄双鱼，细读银钩卷复舒。\n愧我挂冠方草奏，误君载盾过茆庐。\n罢祠久绝支离粟，失势谁看闲杂书。\n老畏春寒缩如鳖，坐妨沽酒摘园蔬。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风雨凉甚一首","author":"刘克庄","text":"淅淅吹庭树，铮铮溅瓦沟。\n乍除秦酷吏，重见晋清流。\n山有月行脚，溪无风打头。\n不知楚台客，何以说悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙辰元日","author":"刘克庄","text":"免骑朝马趁南衙，五见空村换岁华。\n旋遣厨人挑荠菜，虚劳座客颂椒花。\n不施郁垒钧编户，虽饮屠苏殿一家。\n二十宦游今七十，于身何损复何加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙寅记颜","author":"刘克庄","text":"颜发今如此，光阴更几何。\n不堪上麟阁，只合入鸡窠。\n足弱追花懒，瞳昏认字讹。\n一般差自慰，卷里警联多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东涧为余序后稿余以国帖唐碑古壶润笔反成□桃抛引小诗谢之","author":"刘克庄","text":"玄晏欣然托序行，缊袍被衮岂非荣。\n家徒四壁穷难讳，字答三缣礼尚轻。\n金薤银钩俱妙绝，石泉香饼太清生。\n如何更费公搜索，缄送松煤与水晶。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乍晴","author":"刘克庄","text":"天更商量雨，人都领略晴。\n晚山青妥贴，野水白纵横。\n鹭立沙头影，蜂喧树底声。\n笋舆扶病出，邂逅亦诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乍暑一首","author":"刘克庄","text":"南州四月气如蒸，却忆吴中始卖冰。\n绿浦游船常载妓，画廊浴鼓或随僧。\n梦过水榭闻凉笛，身在山房伴晓灯。\n怊怅乌丝栏上笔，蓬窗学写字如蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]