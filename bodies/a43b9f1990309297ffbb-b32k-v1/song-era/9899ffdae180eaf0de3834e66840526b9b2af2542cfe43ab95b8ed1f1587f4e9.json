[{"title":"书南山六和寺","author":"释契嵩","text":"青葱玉树接溪岑，台阁凌虚地布金。\n行到白云重叠处，水声松韵淡人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食日雨中","author":"释契嵩","text":"漠漠行云晴复阴，野花垂湿晚沉沉。\n游人莫怨天多雨，况在东皋春已深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早起","author":"释契嵩","text":"天窗月过星疏渺，檐际冥分云窈窕。\n山家深处勿鸡啼，时有寒鸦来报晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对喜鹊","author":"释契嵩","text":"静卧时惊鹊喜多，须臾果有故人过。\n山中明度还无事，问尔绵蛮更语么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄晤冲晦","author":"释契嵩","text":"年老相看眼倍青，念君诗思苦劳形。\n人间更有无穷感，好把禅关护性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洗笔","author":"释契嵩","text":"古人信文字，字字从此出。\n天下心不欺，尔亦有阴骘。\n濯之遗孺子，念兹未应失。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游大慈山书昼上人壁","author":"释契嵩","text":"谷里侵云寺，寻幽到深处。\n春过寒花开，人来啼鸟去。\n岂期草庵客，日暮此相遇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清溪","author":"释契嵩","text":"勿谓清溪清，长如镜初洗。\n须防苟容物，污尔清到底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮值雪山斋焚香独坐命童取雪烹茗因思柳絮随风起之句遂取谢道蕴传读之见其神情散朗故有林下风气益发幽兴乃为诗兼简居士公济彼上人冲晦","author":"释契嵩","text":"檐外惊风幽鸟归，窗间独坐事还稀。\n初看历日新年近，喜见山林骤雪飞。\n但忆故人能有咏，宁怀久客此无衣。\n鲍昭汤老能乘兴，城郭何如大翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"襄阳习子不贪官，欲友幽人拟道安。\n冒雪履霜临岁杪，攀萝挽翠到云端。\n初论浮世惭年老，久对清规苦夜寒。\n空感知音何以报，但誇山水富君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"岁晚阴沈天宇昏，宗雷访我更携君。\n相期石屋宜投宿，独憩山茨学卧云。\n雪映窗棂人已静，风吟灯影夜初分。\n自怜惠永多闲散，强接清言愧不文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"诗豪何逊宿岩扃，品格高卑彻晓评。\n未省窗前无月到，唯惊席上有风生。\n郤超年少偏高隐，庄子才雄不近名。\n明日君归入落去，莫将平叔拟虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉公济冲晦见访","author":"释契嵩","text":"数曲青溪山数重，山深日暮已鸣钟。\n忽闻行客门前语，来觅幽人林下踪。\n初接风流殊历落，更张灯火倍迎逢。\n不须便去疑无待，已有黄粮在宿舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"暮云将雨苦纷纷，看雨携君倚寺门。\n飞鸟惊雷归后坞，落梅流水出前村。\n名山当尔何须去，胜事而今更好论。\n况有禅翁通妙理，徘徊重款扣真源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同公济冲晦宿灵隐夜晴","author":"释契嵩","text":"不睡还烹北苑茶，寒灯落尽适未花。\n夜深雨过山形出，天静云空月色佳。\n且喜僧窗晴似昼，莫论人世事如麻。\n况陪支许皆能赋，岂厌留诗在碧纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"涧北夜依禅舍宿，峰南今访讲师堂。\n初行松路爱清晓，及过石桥闻异香。\n日色煖烘诸壑净，晴岚翠泼几峰光。\n道标尚客何高趣，更饮吾曹柏叶汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南涧傍游戏呈公济冲晦","author":"释契嵩","text":"相引朝来碧涧傍，山林雪尽水流长。\n未应惊鸟下苔岸，先共观鱼跨石梁。\n日淡沙寒鸥自聚，岁阑春入草含芳。\n鲍昭汤老须同咏，何必人间万事忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"共访迢遥深坞寺，仍随野老卖樵还。\n鸟栖已定人方到，暮色虽浓门未关。\n今宿岩房休问法，来朝蜡屐重登山。\n平生胜友殊难会，莫厌相携寂寞间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同公济冲晦游天竺兼简呈伯周禅老","author":"释契嵩","text":"爱此萧然松坞深，诗流邀我此相寻。\n苍茫寒日才开雾，叆叇浓云又结阴。\n安石放怀还剧赏，皎然乘兴合清吟。\n主人勤驻禅扉宿，况值梅香正满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉和","author":"释契嵩","text":"沈侯才隽冠儒林，诗语惊人金玉音。\n学海平生惭我浅，词源今日羡君深。\n强睎老格须张胆，喜听清言更洗心。\n赓唱苟能容累句，漫陪梁甫续高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同公济宿天竺寺赋闻泉","author":"释契嵩","text":"几晏林间宿，初闻况夜晴。\n漱寒醒客梦，飞响应山鸣。\n深涧松风静，幽人石室清。\n谁人能为我，写此入琴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送公济冲晦出山兼简驻泊李思文","author":"释契嵩","text":"几日山游霰雪稀，相随野老亦忘机。\n始怜洞里云堪卧，又忆人间岁杪归。\n夜落梅花应满路，风含春色自吹衣。\n凭君为语王孙道，音信终须寄鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"严维灵彻出山时，避雨曾闻碍木枝。\n几杪霜寒何足畏，管中春色已堪吹。\n风含钟韵凝还散，水结溪声咽又悲。\n斗草野游君莫笑，初平元是牧羊儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉酬","author":"释契嵩","text":"君事逍遥入乱云，与君蹑屐遍溪邻。\n林间听鸟闻偏好，烟际观山见匪真。\n涧水只能忙送客，岩花不解久留人。\n乐天更有龙门约，胜会应须趁早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"连得公济出山道中见示二篇鄙思枯涸奉和不暇且乞罢唱","author":"释契嵩","text":"诗篇留落野人窗，又得虞卿璧一双。\n怪似蛟龙出古水，清如日月浸秋江。\n赓吟何止夸山泽，变雅终须系国邦。\n为报诗家骁将道，雪阑休唱已心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释契嵩","text":"忽忆山中人白头，岁阑来看雪初收。\n诗篇见赏皆高兴，谢客相随匪俗流。\n漫有嵓云供夜卧，况无土食备晨羞。\n爱君吟咏殊堪听，金玉声音胜楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公济冲晦出山次日奉寄","author":"释契嵩","text":"孙绰曾陪支遁游，千年人谓两风流。\n羡君慕此乘双屐，结侣还来共一丘。\n衣冷雪霜犹未去，兴高云月肯甘收。\n耽诗重道皆无比，应敌当时万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉和","author":"释契嵩","text":"乐天已与广宣游，更出风尘外俗流。\n酒圣尽能非毕卓，诗仙皆欲接浮丘。\n篇章逸处江山动，笔砚閒时云雨收。\n况有声名俱籍甚，并飞南北动王侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮还西坞寄公济无?","author":"释契嵩","text":"乘兴溪边去，仍从林下归。\n梅香带春信，日色暖人衣。\n白发思还远，清流遇更稀。\n野禽宁会意，相顾向柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉酬","author":"释契嵩","text":"翛然林下隐，吾道异夫君。\n习忍如幽草，观身类片云。\n人情无意染，鹤唳有时闻。\n谢客诗怀寄，怜君此兴勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉酬","author":"释契嵩","text":"暝色阴森雪和云，故人当此动吟魂。\n烟凝火冷万家静，水色山光竟夜昏。\n兴发晋贤前古远，诗传萧寺迩今存。\n春归嵓壑多芳树，漫欲邀君同听猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新岁连雨不止因寄公济兼简贤令强公","author":"释契嵩","text":"寒郊才喜岁华新，景物阴阴又一旬。\n云带天低垂压野，雨藏春昼暗迷人。\n宁愁灯火妨明月，却叹诗家惜令辰。\n陶令而今卧江国，倚楼吟望更谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵奉寄强令","author":"释契嵩","text":"冉冉流年年历新，仲春春日未盈旬。\n何为万里青云士，来问双峰白发人。\n诗思雅惊含老格，风神清爽惜芳辰。\n况闻傲令陶元亮，蜡屐须来与我亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱湖草堂次仲灵韵","author":"释惟晤","text":"雪满西山春未归，泉声冻咽鸟声稀。\n静观眼境人间渺，驱逐诗魔天外飞。\n一饱每将松作饭，大寒重换纸为衣。\n我怜诗是君家事，更约论心极细微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将访永安东山禅师先寄","author":"释惟晤","text":"庵在千株松桂下，更无尘事到夫君。\n高踪罕过呼猿涧，静思唯看抱石云。\n日暮坐间禽影集，雪晴岸畔路形分。\n扬雄约我须投宿，月里禅馀怯论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉和","author":"释惟晤","text":"道安独继襄阳踵，诗好慵窥霅昼评。\n竹屋数间经几载，草衣三事傲平生。\n纵陪林下收孤迹，难学人间走大名。\n灯火已残谭未倦，晓风斜雨打窗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"白云苍海一重重，傍舍遥闻隔坞钟。\n月上更无人语闹，雪深空认虎行踪。\n诗书共喜灯前论，茗果翻疑梦里逢。\n脱屣高谭无限乐，煴炉寒拥日高舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"雨洗群山秀色分，一筇双屐到松门。\n天边云散争归洞，岛外樵还各占村。\n久著青袍心已厌，相看白首事休论。\n请君细问黄梅老，当信禅河别有源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"战退睡魔重酌茗，再披文卷眩生花。\n喜逢长夜身虽健，勉和新诗兴未佳。\n风细猿声清似梵，月明杉影密如麻。\n腊寒灯炷飞蛾灭，何必殷勤护薄纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"晓过翻经台下寺，与君同谒祖师堂。\n庭前紫桂叶频脱，石上红梅花正香。\n出洞阴云分远影，挂松寒日漏清光。\n谢公劝饭须无让，不许非时荐茗汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"拨云过得南陇去，流水激溅一涧长。\n盘石谁堆补缺岸，老松自倒成危梁。\n沙禽呼雌频叫噪，山药吐色常芬芳。\n腊去春归山愈好，喜君共无尘事忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"天寒雨细日将暮，泥滑谁禁策马还。\n砂穴吐泉鸣决决，竹丛归鸟语关关。\n聊睎谢客须穿屐，莫羡支公独买山。\n方外论交情未浅，愿陪投老白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"平昔诗禅友契深，更来人外事幽寻。\n雨馀涧壑流寒响，岁晏柽杉老翠阴。\n袒跣不妨陶令醉，风流多效洛生吟。\n山翁解榻延清赏，未放前贤胜竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"灯火青荧云坞寺，清猿叫断有馀音。\n槛梅雪白春风近，山雨盆倾涧水深。\n背世迹怜高鸟迹，结交心契老松心。\n酬君秀句无新语，徒搅诗肠彻曙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同","author":"释惟晤","text":"涧泉吾所好，山舍寂无喧。\n春脉生云底，夜声来枕前。\n风休不动竹，月上未啼猿。\n石上鸣逾急，泠然清梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"扫携绿野村边去，累日青山旷世机。\n惜向永安兰若别，还经灵隐渡头归。\n云峰积雪迷樵径，石罅新泉溅客衣。\n诗会未由陪帝戚，心随云鸟入城飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"兴高未肯辍清诗，舍轿重扶栉栗枝。\n松柏青肥春雨洗，烟云轻健涧风吹。\n樵归后坞连声唱，鹿过前溪失队悲。\n莫道还家甘寂默，陶潜自有五男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山至中涂寄永安禅师","author":"释惟晤","text":"松行未尽却回头，寒雨霶沱已渐收。\n望海阁边云缭绕，行春桥下水奔流。\n山庵骤别高谭远，城寺将归满面羞。\n须效著书同护法，悠悠人事漫拘囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬","author":"释惟晤","text":"今日追怀昨日游，二君乘兴似奔流。\n远寻幽壑行拖屐，累到深云卧枕邱。\n崖竹萧疏晴影乱，坞梅零落晚香收。\n会须重访藤州老，更约高才沈隐侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉和","author":"释惟晤","text":"白发东山老，青林西坞归。\n听猿时驻锡，厉水自褰衣。\n高论才难敌，孤踪行亦稀。\n惭君寄樵采，佳句出岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉酬","author":"释惟晤","text":"杜门谁复念吾曹，老畏春寒拥毳袍。\n懒慢从来徒自笑，唱酬今更怯君高。\n曾无道誉喧喧播，厌把肝脾苦苦劳。\n佳句忽来催野句，譬将凡果偪仙桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉酬仲灵岁暮还西坞见寄","author":"释?元","text":"野步溪流静，源深兴未归。\n晚禽栖雪竹，残霰洒禅衣。\n放意天涯远，狂吟人迹稀。\n诗成寄我侣，清气动禅扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过水北","author":"欧阳修","text":"寒川消积雪，冻浦渐通流。\n日暮人归尽，沙禽上钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答和阁老刘舍人雨中见寄","author":"欧阳修","text":"花间鸟语愁泥滑，屋上鸠鸣厌雨多。\n坐见残春一如此，可怜吾意已蹉跎。\n萧条两鬓霜后草，潋滟十分金卷荷。\n此物犹能慰衰老，稍晴相约屡相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝灵驾以引挽歌辞 其二","author":"欧阳修","text":"文景孜孜俭与恭，慨然思就太平功。\n兴隆学校皇家盛，放斥嫔嫱永巷空。\n威慑黠羌方问罪，丹成仙鼎忽遗弓。\n霜清日薄箫笳咽，万国悲号惨澹中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝灵驾以引挽歌辞 其三","author":"欧阳修","text":"千龄应运叶天人，四海方欣政日新。\n忽见九门陈羽卫，犹疑五载欲时巡。\n觚棱月暗翔金凤，辇道霜清卧石麟。\n白首旧臣瞻画翣，秋风泪洒属车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴照邻都官还江南","author":"欧阳修","text":"霜前江水磨碧铜，岸背菱叶翘青虫。\n吴郎鬓丝生几缕，不羞月上扶桑东。\n羞见清波照人影，去时黑发吹春风。\n五年归来妇应喜，从此不问西飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人三桥 其二","author":"欧阳修","text":"北临白云涧，南望清风阁。\n出树见人行，隔溪闻鱼跃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人三桥 其三","author":"欧阳修","text":"断虹跨曲岸，倒影涵清波。\n为爱斜阳好，回舟特特过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"来燕堂与赵叔平王禹玉王原叔韩子华联句","author":"欧阳修","text":"贤侯谢郡归，从游乐吾党。\n林泉富馀地，卜筑疏陈莽。\n是时春正中，来燕音下上。\n若贺大厦成，喜留众宾赏。\n得名因谈笑，挥墨粲题榜。\n所夸贤豪盛，岂止池榭广。\n人心乐且闲，鸟意颉而颃。\n吟樽敞花轩，醉枕酣风幌。\n轻云薄藻栋，初日丽珠网。\n红袂生暗香，清弦泛馀响。\n林深隐飞盖，岸曲迟去桨。\n波光栏槛明，竹气衣巾爽。\n虚容凉樾入，影与文涟荡。\n晨飙转绿蕙，夕雨滋膏壤。\n嘉辰喜盍朋，命驾期屡往。\n觞咏陶淑真，世俗岂吾仿。\n得以为胜游，萧然散烦想。\n公子固好士，世德复可象。\n今此大基构，不图专奉养。\n美哉风流存，来叶足师仰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与谢三学士唱和八首 送学士三丈","author":"欧阳修","text":"供帐洛城边，征辕去莫攀。\n人醒风外酒，马度雪中关。\n故府谁同在，新年独未还。\n遥应行路者，偏识綵衣斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔答原甫提刑学士","author":"欧阳修","text":"岁暮山城喜少留，西亭尚欲挽行辀。\n一樽莫惜临岐别，十载相逢各白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏刘原甫 其二","author":"欧阳修","text":"仙家千载一何长，浮世空惊日月忙。\n洞里新花莫相笑，刘郎今是老刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午帖子 夫人閤五首 其三","author":"欧阳修","text":"光风细细飘香转，绿叶阴阴覆槛凉。\n云物鲜明时节丽，水精宫殿侍君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午帖子 夫人閤五首 其四","author":"欧阳修","text":"蓬莱仙阙彩云中，端日欣逢岁岁同。\n皎洁霜纨空咏扇，深沉玉宇自生风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"欧阳修","text":"一句坐中得，片心天外来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]