[{"title":"孤云","author":"王令","text":"一片孤云逐吹飞，东西终日竟何依。\n旁人莫道能为雨，惟恨青山未得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武侯","author":"王令","text":"三顾虽然志意深，出非由道此何心。\n平时胸腹能多少，且与群儿梁父吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山","author":"王令","text":"马蹄行尽九州闲，无处欢娱得破颜。\n只有此中宜旷望，谁令天作海门山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春怨","author":"王令","text":"扫地待花落，惜花轻着尘。\n游人空眷恋，踏去却寻春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二首 其二","author":"王令","text":"三月残花落更开，小檐日日燕飞来。\n子规夜半犹啼血，不信东风唤不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二首 其一","author":"王令","text":"春来还自有游人，常是春归独念春。\n落后见花尤更惜，不知谁忍扫和尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春梦","author":"王令","text":"湘水茫茫春意关，岑郎一睡片时间。\n谁知行尽江南路，枕上离家枕上还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游","author":"王令","text":"春城儿女纵春游，醉倚层台笑上楼。\n满眼落花多少意，若何无个解春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春愁","author":"王令","text":"只闻来客说春游，不逐花前笑自留。\n浪说春期计春尽，留春无术只春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周器之归润再索","author":"王令","text":"何须别子始沾衣，久有江南去梦飞。\n为语青山幸相望，壮夫终不白头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻促织","author":"王令","text":"衰草风来响不知，破窗灯灭月藏辉。\n白头老妇无机织，卧听邻儿懒捣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效退之青青水中蒲 其四","author":"王令","text":"双双水中凫，常在水中居。\n还有笼中鹜，腾轩仰不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效退之青青水中蒲 其二","author":"王令","text":"双双水中凫，来疾去闲暇。\n江湖风晚波，泛泛自高下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泰伯庙","author":"王令","text":"古庙郁崔嵬，朱门傃道开。\n今人不为让，间或乞灵来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读东汉","author":"王令","text":"汉鼎重炎逆血熬，当时天子亦勤劳。\n不能乘作唐虞计，未会严陵所谓高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读西汉","author":"王令","text":"汉得孤秦万弊时，当年丞相要无为。\n洛阳年少空流涕，谁谓书生果有知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读商君传","author":"王令","text":"利害从来识所存，固难轻重与人论。\n赵良不自身为客，刚欲都君使灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶占","author":"王令","text":"卒卒往来舟，翻翻逐利谋。\n中流谁自溺，方去不回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"王令","text":"种花红不实，俗客醉仍喧。\n拔去树嘉谷，日无人过门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"袭袭","author":"王令","text":"袭袭前修与后生，要言高爵是身荣。\n却将猎较诬师圣，不见三年学有成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渰渰","author":"王令","text":"渰渰轻云弄落晖，坏檐巢满燕来归。\n小园桃李东风后，却看杨花自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴二首 其二","author":"王令","text":"不独区区操缦间，要期追逐古风还。\n吾民有愠何当解，学得南风不敢弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴二首 其一","author":"王令","text":"古风寥落欲何寻，常记南风素意深。\n闻说五弦弦不断，欲于何处借人琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答许勤之","author":"王令","text":"不作明堂柱石臣，要当归去老江滨。\n不知何处田堪买，抛却浮生一片尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落叶","author":"王令","text":"暮秋木落剥霜红，俄觉平林一夜空。\n茂遂本凭枝干力，却辞枝干逐西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩吏部","author":"王令","text":"宣尼夹谷叱强齐，吏部深州破贼围。\n始信真儒能见用，可为邦国大皇威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼上望湖","author":"王安石","text":"楼上人肠渴欲枯，楼前终日望平湖。\n无舟得入沧浪去，为问渔人得意无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪上","author":"王令","text":"溪上清涟树老苍，行穿溪树踏青阳。\n溪深树密无人处，祗有幽花度水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜣螂","author":"王令","text":"扰扰蜣螂不足评，区区只逐粪丸行。\n若乘饮露嘶风便，又作人间第一清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慵","author":"王令","text":"衣冠慵整鬓慵梳，万事从来静有馀。\n却笑嵇康慵未得，区区犹作绝交书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔬兰","author":"王令","text":"晓折寒蔬野圃间，荒林深处有芳兰。\n世无贤士纫为佩，犹有幽人日取餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题天长县苏太尉庙","author":"王令","text":"唐室无臣覆手移，坐看悍媪制庸儿。\n思量可惜当年死，却是西来问鼎师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题假山","author":"王令","text":"扰扰人心巧谓何，我肠愚只爱无它。\n目前好且留平地，浪爱山高险自多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕答","author":"王令","text":"春日楼台暖气低，东风无主自东西。\n寻常帘幕有多少，何处画梁无燕泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"露筋贞女庙","author":"王令","text":"待夫以死如知命，信己轻生可谓贞。\n指尔为愚今尚众，莫言吾志不难行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹳","author":"王令","text":"毛羽人将鹤品流，斜阳高处自迟留。\n人言杀尔三年旱，应是巢成更不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日寄满子权","author":"王令","text":"懒将衰病照清流，为有归心欲白头。\n幸自好花开便笑，不甘为客见成愁。\n长歌欲强秋风醉，高处先输俗子游。\n我在无聊元亮死，当年今日共悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大松","author":"王令","text":"十寻瘦干三冬绿，一亩浓阴六月清。\n莫谓世材难见用，须知天意不徒生。\n长蛟老蜃空中影，骤雨惊雷半夜声。\n却笑五株乔岳下，肯将直节事秦嬴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小酌","author":"王令","text":"平生从事漫徒劳，时以休闲近酒醪。\n东海可从谁自重，南山如与客争高。\n老将日月来双鬓，生委乾坤寄一毛。\n更展韦编探万绝，懒从人世问滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不雨","author":"王令","text":"去岁秋霖若决川，今春不雨旱良田。\n道边老幼饥将死，云外蛟龙懒自眠。\n赤日有威空射地，清江无际漫连天。\n谁将民瘼笺双阙，四海皇恩一漏泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从光师求花","author":"王令","text":"我有归心不可宽，忆君花好旧常欢。\n若令醉眼异乡见，定作故人相笑看。\n知有灵根分客易，却忧平地得春难。\n只应胡蝶还相识，飞过东风又可叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王荆公忆江阴","author":"朱明之","text":"江上城隍古镜中，城边山色翠屏风。\n鱼虾接海随时足，稻米连湖逐岁丰。\n太伯人民堪教育，春申沟港可疏通。\n朱轮天使从君欲，异日能忘笑语同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆润州葛使君","author":"王令","text":"六朝游观委蒿蓬，想像当时事已空。\n半夜楼台横海日，万家箫鼓过江风。\n金山寺近尘埃绝，铁瓮城深气象雄。\n欲放船随明月去，应留闲暇待诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日益无聊赖偶成呈子长","author":"王令","text":"一夕西风叶下柯，羁人憔悴发沉疴。\n穷来无子知难得，命薄于人可奈何。\n困卧牛衣空有泪，剧弹铁剑不成歌。\n陶家壁冷尘埃满，何日云雷起铁梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人送常州张卿挂冠","author":"王令","text":"清优四皓官，潇洒二疏颜。\n直道空华发，明时独买山。\n如闻元老议，尚恐软轮还。\n谁是尘埃者，清风合自攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人送常州致仕张待制","author":"王令","text":"心贪进退适全宜，上印飞书剧去翚。\n荐口不加张柬老，明朝竟放孔戣归。\n黄堂合有遗思在，青史还留后世稀。\n此去江湖见鸥鸟，为言今合信无机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去草","author":"王令","text":"毵毵出土初如直，袅袅随风竞自斜。\n漫借人锄劳刬拔，只消夜雨又萌芽。\n良田力尽农夫叹，直道春荒志士嗟。\n满目青青尽芜蔓，更于何处问蓬麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古鉴","author":"王令","text":"一片灵光合有神，不知镕铸更何人。\n春耕破冢衣冠尽，鬼手摩天日月新。\n鉴面祗知西子姣，照心难见比干真。\n主人深有收藏意，当待清明不受尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平山堂","author":"王令","text":"豁豁虚堂巧架成，地平相与远山平。\n横岩积翠檐边出，度陇浮苍瓦上生。\n春入壶觞分蜀井，风回谈笑落芜城。\n谢公已去人怀想，向此还留召伯名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平山堂寄欧阳公","author":"王令","text":"废苑繁华未可寻，孤城西北路嵚崟。\n檐边月过峰峦顶，柱下云回草树阴。\n宾客日随千骑乐，管弦风入万家深。\n知公白玉堂中梦，未负当时壮观心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次元韵答几道","author":"王令","text":"尘嚣摆落到鸿冥，始见当时遁世英。\n丛棘敢思丹凤至，寸筳惭叩巨钟鸣。\n须知奔竞浮荣路，未若喧传不朽声。\n此道固为流俗笑，苟非夫子欲谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮呈王介甫平甫","author":"朱明之","text":"岁暮远为客，一身归计深。\n尘沙日翳翳，雨雪夜阴阴。\n喜色开南信，悲怀动北琴。\n感时须寂寞，何独少陵心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮言怀呈诸友","author":"王令","text":"万事无成只一吁，穷年况复叹穷途。\n功名未立头先白，贫病相仍气尚粗。\n富贵早知皆有命，穷通料是不由吾。\n会须开口随时笑，一曲长歌醉倒壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵满子权见寄","author":"王令","text":"当世雄图不可怀，退居蒿艾自沉埋。\n门无来足荆生道，病不能锄草上阶。\n自是直方违世易，况将疏懒合人乖。\n无由与子同樵种，回首平林浪可柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子权京口夜宿见寄","author":"王令","text":"寒江漠漠客帆稀，独泊扁舟望翠微。\n巳泻绿醽聊自适，更邀白鸟共忘机。\n水闲海月寒初上，树尽秋城碧自围。\n嗟我相思邈千里，不来同此两忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵介甫怀舒州山水见示之什","author":"朱明之","text":"皖上相逢昔少留，登楼隐几听鸣鸠。\n山峰游处今何在，溪水流来此有不。\n就食四方甘不系，为生一世信长浮。\n共知局促京沙里，回首当时始觉羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵立之红叶","author":"王令","text":"雨露三春少，风霜一夜多。\n从来有根本，不怕下枝柯。\n楚岸枫相属，吴山橘与和。\n秋居好相慰，醉色伴吾酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱昌叔见赠","author":"王令","text":"虽无才学可人群，偶有诚心与古亲。\n兹世几人能永富，此身何恤不终贫。\n生无簪绶身宁屈，死有诗书志尚伸。\n自匪与君尝素计，斯言何敢易谋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和人古松","author":"王令","text":"直枝难立鸟徘徊，地瘦根孤碍石回。\n山野不逢终更老，闾阎无用始为材。\n更无匠伯身尝过，祗有幽人眼暂开。\n谁与东风记霜雪，争令平地肯栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"王令","text":"浩渺烟波不可名，我来闲自濯尘缨。\n久思沧海收身去，安得长舟破浪行。\n天阔水云连黯淡，日间鸥鹭自飞鸣。\n屈平死后渔人尽，后世凭谁论浊清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"王令","text":"羃羃江城没远烟，暮云归族忽相连。\n春江流水出天外，晚渡归舟下日边。\n杏萼春深翻浅缬，柳花风远曳晴绵。\n无钱买得江头树，输与渔人系钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次","author":"王令","text":"梢梢修竹夹溪斜，树系孤篷白浅沙。\n风力引云行玉马，水光流月动金蛇。\n村酤客聚还成市，晚钓舟横便当家。\n山野生涯本闲暇，谁令客子自劳嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观水","author":"王令","text":"细如虾蚓足留连，大可蛟鲸出自然。\n当使川流应到海，只今坎止亦成渊。\n民忧不见尧咨日，地碍何由禹凿穿。\n可惜卧龙无意思，不随云去雨春田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过伍子胥庙","author":"王令","text":"西风骚客倦游吴，吊古心怀此暂舒。\n鬼箓久应除佞嚭，民思今果庙神胥。\n虽然邪正皆归死，奈有忠谗各异书。\n回首旧江江水在，怒涛犹是不平初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"驯鹿","author":"王令","text":"日日野心新，笼栏外强驯。\n祗消指马相，便有逐原人。\n昔起歌宾兴，今无伏囿仁。\n豺狼好牙爪，应笑角如麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其十","author":"王令","text":"何处难忘酒，亡君复旧游。\n黍离经故国，麦秀悼前羞。\n远目何胜尽，行车逆自留。\n此时无一盏，何以谢悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其九","author":"王令","text":"何处难忘酒，穷才世不知。\n出门无直道，开口碍当时。\n白发无端速，青山不忍期。\n此时无一盏，何以慰忧思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其八","author":"王令","text":"何处难忘酒，欃枪世不平。\n孤儿未胜甲，孀母送为兵。\n气绝心肝裂，号穷血泪横。\n此时无一盏，何以活馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其七","author":"王令","text":"何处难忘酒，穷边壮士歌。\n寒弓弯未试，秋剑拔新磨。\n月落阴山暗，沙昏伏甲多。\n此时无一盏，何以陷前戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其六","author":"王令","text":"何处难忘酒，王臣立荩方。\n群邪终自直，万死不摧刚。\n社鼠旁难塞，龙鳞逆易伤。\n此时无一盏，何以洗忧肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其五","author":"王令","text":"何处难忘酒，君王宴豫年。\n群谋安一统，无口议将然。\n闲暇开元后，优游大业前。\n此时无一盏，何以慰遗贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其四","author":"王令","text":"何处难忘酒，王朝四海中。\n鱼鸢上下乐，羌狄朔南通。\n万玉丛丹陛，千簪合辟廱。\n此时无一盏，何以乐成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒十首 其三","author":"王令","text":"何处难忘酒，登贤入用初。\n一身兼禹稷，四海再唐虞。\n去圣千年恨，明时一日舒。\n此时无一盏，何以酹亨衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]