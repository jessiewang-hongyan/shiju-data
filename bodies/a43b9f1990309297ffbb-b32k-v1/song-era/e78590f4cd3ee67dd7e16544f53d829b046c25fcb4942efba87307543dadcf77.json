[{"title":"颂古十二首 其三","author":"释法泰","text":"无量秤子两头平，拈起应须见得明。\n若向个中争分两，知渠错认定盘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其一","author":"释法泰","text":"朝三暮四一何少，暮四朝三何太多。\n多少未能知数量，有无从此见殽讹。\n不殽讹，唵苏嚧，㗭哩萨婆诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三","author":"释法泰","text":"不是风兮不是幡，一重山后一重山。\n青春雨过无馀因，独倚危楼望刹竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二","author":"释法泰","text":"重城晓入冒轻烟，闹市相逢岂偶然。\n一句等闲相借问，平田忽尔浪滔天。\n月上女，实堪怜，云髻高梳何处去，借婆裙子拜婆年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十三","author":"释法泰","text":"鸡寒上树，鸭寒下水。\n三百馀会不能宣，九年面壁徒瞌睡。\n休瞌睡，上是天兮下是地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十二","author":"释法泰","text":"银椀里盛雪，冰壶含宝月。\n纵具四韦陀，到此虚摇舌。\n西天令严，此土还别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十","author":"释法泰","text":"三人證龟成鳖，井底泥牛气噎。\n直饶辩泻悬河，有理亦难分雪。\n耿耿孤光常皎洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十九","author":"释法泰","text":"汝水向东流，楚水从南至。\n皆归大海中，咸淡同一味。\n顶门具眼底衲僧，试向其中辨浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十六","author":"释法泰","text":"对一说，五教三乘尽该摄。\n龙宫海藏任纵横，水底泥牛吞却月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十五","author":"释法泰","text":"河目海口，钉觜镜舌。\n鸡宿凤巢，素非其鸭。\n直饶啐啄同时，未免当头一劄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十三","author":"释法泰","text":"格外谈，惊人句，懵懂禅和徒指注。\n灼然好个佛无光，言下迷宗空自忙。\n赖有知音招庆在，譊讹一夏为雌黄。\n雌黄出，暗写愁肠寄知识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十一","author":"释法泰","text":"蓦刃开时飞铁骑，电光闪处掷金槌。\n一城瞎却浑闲事，直至而今成是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十六","author":"释法泰","text":"雪峰古涧泉深，赵州石桥水苦。\n若知异水同源，饮者不妨疑悟。\n不从鼻孔入，白浪高三级。\n从此不答话，岂免酬高价。\n金刚圈子栗棘蓬，解透横行四天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十五","author":"释法泰","text":"吞却易，吐还难，须弥顶上无风寒。\n昨夜三更白如昼，不知谁共倚阑观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十四","author":"释法泰","text":"无须锁子两头摇，无瑕璧玉三回献。\n反遭刖足太无端，谁料正言还似反。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十二","author":"释法泰","text":"无寒暑处为君通，枯木生花又一重。\n堪笑刻舟求剑者，至今犹在冷灰中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十","author":"释法泰","text":"臭烟蓬㶿中，迸出铁蒺藜。\n当如如未委，丧却目前机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十五","author":"释法泰","text":"赵州三度吃茶，禾山打鼓难比。\n休于句下寻求，识取口中滋味。\n若识得，观音院里有弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十三","author":"释法泰","text":"堂堂妙相真难比，历历梵音犹更奇。\n可怜逐句寻言者，嗟过长沙觌面机。\n知不知，黄鹤楼崔颢题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十一","author":"释法泰","text":"行婆能击涂毒鼓，远近闻之皆胆怖。\n唯有南泉与赵州，同死同生殊不顾。\n阿呵呵，伎死禅和不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十","author":"释法泰","text":"胶投漆，水和乳，一卷一舒，全宾全主。\n谁言不落青黄，就中要人道取。\n谁道取，分付镬汤，熟蒸烂煮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其九","author":"释法泰","text":"相见不虚图，分明付与渠。\n汝醉我扶起，我倒汝相扶。\n交互为宾主，相将入帝都。\n高歌大笑九衢里，天上人间我唯尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其八","author":"释法泰","text":"百丈开田说大义，理事圆融无不备。\n梵音清彻十方闻，草树锄锹皆耸起。\n末后双拳再展开，拖泥带水为痴呆。\n船流到岸五千里，刻舟求剑徒悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其七","author":"释法泰","text":"三界无法，何处求心。\n山容雨过，松韵风吟。\n横眠倒卧无馀事，一任莓苔满地侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其五","author":"释法泰","text":"张公养得三个儿，长大不知谁立志。\n呼来月下同踪由，眼睛个个皆相似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其七","author":"释法泰","text":"忆昔游方日，获得二种物。\n一是金刚锤，一是千圣骨。\n持行宇宙中，气岸高突兀。\n如是三十年，用之为准则。\n而今年老矣，一物知何物。\n掷下金刚锤，击碎千圣骨。\n抛向四衢道，不能更惜得。\n任意过浮生，指南将作北。\n呼龟以为鳖，唤豆以为粟。\n从他明眼人，笑我无绳墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其五","author":"释法泰","text":"德山棒下金沙异，临济喝中宾主分。\n到此若无真正眼，可怜辜负本来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其四","author":"释法泰","text":"南山起云，北山下雨。\n老僧更为震雷声，助发威光令远布。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其三","author":"释法泰","text":"火云烧田苗，泉源绝流注。\n婆竭大龙王，不知在何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其二","author":"释法泰","text":"渺渺邈邈，十方该括。\n坦坦荡荡，绝形绝相。\n目欲视而睛枯，口欲谈而词丧。\n文殊普贤，全无伎俩。\n临济德山，不妨提唱，龟吞陕府铁牛，蛇咬嘉州大像。\n嚇得东海鲤鱼，直至如今肚胀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其一","author":"释法泰","text":"今朝正月已半，是处灯火缭乱。\n满城罗骑骈阗，交互往来游玩。\n文殊走入闹篮中，普贤端坐高楼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其十三","author":"释法泰","text":"勿思惟，休造作，展手开拳咄咄咄。\n随意说，任天真，镇州萝卜重三所。\n堪笑老胡不知有，九年面壁太劳神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其十二","author":"释法泰","text":"有佛处不增，无佛处不减。\n人人一段光明，历劫何曾欠少。\n咄，释迦谩自化西乾，达磨无端来此土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其十","author":"释法泰","text":"久雨不晴，有理难伸。\n云雾长埋大野，檐声不断前旬。\n阿喇喇，闻不闻。\n补陀岩上客，应笑未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其九","author":"释法泰","text":"咄咄，何似生，穿云俊鹘摩青天。\n抬眸一顾十万里，林间钝羽空忙然。\n求解会，著言诠，还同日午打三更。\n争如一句声前荐，独向毗卢顶上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其八","author":"释法泰","text":"推真真无有相，穷妄妄无有形。\n真妄两无所有，廓然露出眼睛。\n眼睛既露，见个什么。\n晓日烁开岩畔雪，朔风吹绽腊梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其七","author":"释法泰","text":"开口有时非，开口有时是。\n粗言及细语，皆归第一义。\n释迦老子碗鸣声，达磨西来屎臭气。\n惟有山前水牯牛，身放毫光照天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其六","author":"释法泰","text":"三角牯牛独脚舞，两轮石磨绕空飞。\n新生孩子擎铁棒，直上须弥打一槌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其五","author":"释法泰","text":"一雁度长空，影落寒江水。\n水无沉影心，雁无遗踪意。\n踪影两相忘，凭何为的旨。\n篱边金菊黄，江上芙蓉翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其四","author":"释法泰","text":"一叶落，天下秋，看看空际火云收。\n万里长江净如练，谢家人不在渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其三","author":"释法泰","text":"开口错，合口丧，明眼衲僧无伎俩。\n春风吹落桃李花，淡烟疏雨笼青嶂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其一","author":"释法泰","text":"客从远方来，遗我一张琴。\n中含太古意，举世无知音。\n子期徒侧耳，师旷谩追寻。\n今朝呈似君，试请弹一曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其六","author":"释法泰","text":"得人一牛，还人一马。\n有往有来，可知礼也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其一","author":"释法泰","text":"生无所生，死无所死。\n风动尘飞，波澄浪止。\n和合离散，随处发现。\n满月弯弓，双雕一箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其二","author":"释法泰","text":"达得人空法空，未称祖师家风。\n体得全用全照，亦非衲僧要妙。\n直须打破牢关，识取向上一窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释法淳","text":"半夜逾城景象虚，雪山深处觜卢都。\n直饶一见明星悟，已是当时不丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释法智","text":"明月高悬未照前，雪眉人凭玉栏干。\n夜深雨过风雷息，客散云楼酒碗乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其六","author":"释法智","text":"幽鸟语如篁，柳垂金线长。\n云收山谷静，风送杏花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其三","author":"释法智","text":"深夜虚堂露气佳，冰霜著月没痕瑕。\n木人打破琉璃碗，走过新罗始到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释法智","text":"三界无法，何处求心。\n惊蛇入草，飞鸟出林。\n雨过山堂秋夜静，市声终不到孤岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其五","author":"释法智","text":"动时常寂寂，静处活鱍鱍。\n动静两俱忘，佛祖何处著。\n蓦地梦回头，长天飞一鹗。\n春风有时好，春风有时恶。\n不得春风花不开，花开又被风吹落。\n错错错，蒸饼元来是面作。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其四","author":"释法智","text":"一不成，二不是，火云堆里秋风起。\n堪笑耘田车水翁，手脚忙乱同儿戏。\n同儿戏，有巴鼻。\n但得丰年贺太平，四海五湖皇化里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其二","author":"释法智","text":"辨不辨，昏不昏，打破盆子只论盆。\n千里远山烟树，数家沙鸟渔村。\n夜深月与湖光浑，天水茫茫绝点痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其一","author":"释法智","text":"真空不空，寥寥无影树头月。\n真色非色，隐隐不萌枝上花。\n威音路外芬芳，凤无依倚。\n空劫已前照耀，鹤不停机。\n更须一色功圆，便得同中有异。\n同中异，直下承当休拟议。\n夜来明月照芦花，鹤鹭并头踏雪睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞天童觉和尚","author":"释法智","text":"乌顶雪眉，云踪鹤态。\n貌出正偏，见非向背。\n芙蓉月照兮太白峰高，丹凤翔空兮琼林玉碎。\n觌面分明，两彩一赛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宪师壁","author":"释法辉","text":"远浸溪光碧，寒生松桧阴。\n渔舟惊暮雨，高吹入秋林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴山人","author":"释法辉","text":"夜召山翁酌，花间聊抚琴。\n酒香来竹外，古意入云深。\n月色临诸水，溪光射远岑。\n拟教尘土客，对此涤烦襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终颂","author":"释法慈","text":"无始劫来不曾生，今日当场又随灭。\n又随灭，万里炎天觅点雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"表忠观","author":"释法照","text":"钱王古庙锁莓苔，华表秋深鹤不来。\n昨夜石坛风露重，凌霄花落凤仙开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洞霄","author":"释法照","text":"天柱华心结蕊宫，翠蛟飞玉滚溪风。\n岩生洞穴非人世，不到那知造化功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"垂虹晚望","author":"释法照","text":"老眼青青望洞庭，虹垂断岸月初生。\n滔滔桥下无情水，不为吴王洗甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞世偈","author":"释法照","text":"佛寿八十，我多九年。\n虚空掇转，大用现前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答僧问心要作偈","author":"释法骞","text":"昨日相逢叙起居，今朝相见事还如。\n如何却觅呈心要，心要如何特地疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"举俱胝竖指因缘颂","author":"释法演","text":"佳人睡起懒梳头，把得金钗插便休。\n大抵还他肌骨好，不涂红粉也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释法聪","text":"幽室寒灯不假挑，虚空明月彻云霄。\n要知日用常无间，烈焰光中发异苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一化士取血和墨写藏经乞颂","author":"释法薰","text":"欲书火后旧时经，剔血和煤字字真。\n未举笔前全藏了，闻弦应有赏音人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上张及庵乞米","author":"释法薰","text":"南山近日饭篱空，衲子难教口欱风。\n引臂上方香积界，须劳金粟展神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化砌灶","author":"释法薰","text":"镬已铸成无渗漏，灶犹未砌正经营。\n嵩山杖子休拈出，我要粥香闻五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化柴","author":"释法薰","text":"祖翁元是卖柴汉，今日无柴却可怜。\n去谒檀门好收拾，归来要接午炊烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙人望月濯足","author":"释法薰","text":"夜静山空月半弯，挽衣垂足涤潺湲。\n无人领此深深意，别向壶中更觅天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示众","author":"释法薰","text":"剑刃翻身犹是钝，屋头问路太无端。\n楚鸡不是丹山凤，何必临风刷羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自颂石田","author":"释法薰","text":"石上栽田世所稀，老农闻说也攒眉。\n有人下得泥犁种，别甑炊香供养伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初祖赞","author":"释法薰","text":"航海越漠来，几度药不杀。\n坏我震旦人，至今厮淈?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴道夫乞语","author":"释法薰","text":"走得波波两履穿，担头书卷未能捐。\n待君患过维摩病，却好重来见石田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]