[{"title":"雪后 其一","author":"许月卿","text":"青山露出本来面，白雪消融清净身。\n松树也知修养法，白头翁作少年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄菊","author":"许月卿","text":"黄菊飘零满地金，诗人枉用一生心。\n木犀满地金英落，消得诗人晓夕吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答云甫程文 其二","author":"许月卿","text":"风将杨柳绿铺地，月画蒲萄架在池。\n却扇清风嫩凉夜，携筇明月共归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋东坡墨迹","author":"许月卿","text":"海外归来衰鬓皤，浩然之气笔嵯峨。\n富贵不淫贫贱乐，万年千载一东坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新安道中","author":"许月卿","text":"白水黄山天一青，雪梨金柳眼双明。\n要知来日清明日，请听鹃鸣第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"槐影","author":"许月卿","text":"槐影本来惟戴日，蝉声固自未知秋。\n斜阳薄雨羊归径，冷月横星人倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"箫鼓","author":"许月卿","text":"箫鼓元宵气象豪，拗晴天意亦风骚。\n怕渠窗外梅花落，永夜吟声不敢高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写梅僧处能","author":"许月卿","text":"月明窗上老梅癯，我有天然水墨图。\n笑杀无文痴老子，冰绡影里觅林逋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠朱野拙","author":"许月卿","text":"官样何如野，谋生拙最宜。\n君门标野拙，篆刻大精奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠竹溪","author":"许月卿","text":"子厚有溪浑未竹，徽之有竹不能溪。\n试问竹溪何所似，风流六逸共标题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张相士","author":"许月卿","text":"我生丙子自盘空，爱主忧时水注东。\n愿子相人无软语，莫教人唤密翁翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠梅隐术士张尉","author":"许月卿","text":"梅仙亦向市门隐，君去市门翻隐梅。\n贵贱穷通春梦觉，孤山依旧水边开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠碧鉴相士蒲田林行可","author":"许月卿","text":"君如碧鉴照英雄，我镜清寒印太空。\n请向文昌桥上看，碧天提出碧流中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云护","author":"许月卿","text":"云护轻阴桃柳初，太平无象酒边垆。\n上元晴景楼台晓，一树梅花并雪予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"车中","author":"许月卿","text":"路平正好坐车中，时有禽声山翠浓。\n凭轼斜眸看法帖，开帘正面受春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风起","author":"许月卿","text":"风起成文天气好，水清如镜地如钟。\n师门名节千千载，直与湖山共不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡梅泷 其一","author":"许月卿","text":"对梅花每恨匆匆，竟日望断胡梅泷。\n欲往从之秋水隔，参横月落梦渠侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡梅泷 其二","author":"许月卿","text":"梦渠处处晓星残，秋水盈盈隔晓山。\n山外梅泷应秋水，一泓秋月夜将阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观吴廷玉五云歌书其后而归之","author":"许月卿","text":"钧天九奏玉皇归，阁皂神驰重叹吁。\n劝子痴人前莫说，怕渠来讨费分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"许月卿","text":"桑柘行行秋又夕，芭蕉叶叶雨和风。\n古今陵谷休回首，洗眼师门桂影浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"星学","author":"许月卿","text":"星学精微蒋逸堂，濂溪一赋见行藏。\n楼高照眼银溪水，万籁无声月印窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐君何","author":"许月卿","text":"英雄捧诏出樊笼，抖擞征衣趁晓风。\n一笑相逢仪舌在，明朝秋意满芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朗湖道中因见二事信笔二首 其二","author":"许月卿","text":"乌雀逢鹯皆忆凤，鸬鹚遇獭等求鱼。\n秋风雪散天无极，清晓冥冥鸿影孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途问伍","author":"许月卿","text":"乍雨乍晴寒食候，半花半蕊山矾香。\n老农甚喜天意好，日暖今年不冻秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后 其三","author":"许月卿","text":"雪浏浏时逢晓日，水粼粼处识春风。\n天公留取峰头雪，与作人间别样春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后 其二","author":"许月卿","text":"万木未春先玉蕊，千峰非浪亦银山。\n雪融毕竟无踪迹，依旧梅花耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答云甫程文 其一","author":"许月卿","text":"一川风月有馀地，万顷烟波无尽天。\n蝶梦笑渠飞绿树，鸥盟了我钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘后村所跋杨朴移居图","author":"许月卿","text":"曾对君王已放还，何须当道把渔竿。\n使轺将宿人将避，拗折渔竿赶入山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题婺源斋厅","author":"许月卿","text":"浓淡烟云山展画，浅深篙橹水挼蓝。\n扁舟我欲春风里，鱼鸟依然旧所谙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"默斋壁间竹鹤","author":"许月卿","text":"琅玕壁上林稍接，彷佛胎仙舞雪翎。\n欲识主人斋扁意，此君相对不容声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白雪","author":"许月卿","text":"白雪家家拆蚕箔，清风行行入秧苗。\n半开犹蕊花情远，久雨初晴禽语骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上郑毅夫","author":"许氏","text":"明时乐事输诗酒，帝里风光剩占春。\n况是白衣重得侣，不堪青旆自招人。\n早知玉漏催三鼓，肯把金貂换百巡。\n大抵仁人怜气类，不教孤客作囚身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读晁错传","author":"许氏","text":"匣剑未磨晁错血，已闻刺客杀袁丝。\n到头昧却人心处，便是欺他天道时。\n痛矣一言偷害正，戮之万段始为宜。\n邓公坟墓知何处，空对斯文有泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堆婆石","author":"许仕叔","text":"撑空叠石何嵯峨，世传其名曰堆婆。\n乃在浙岭之巅，吴山之阿。\n我来于此少憩息，借问父老元如何。\n父老为言五代时，有婆姓方氏结茅岭巅两鬓皤。\n为念往来渴，均施汤水无偏颇。\n行人以此尽感激，婆言吾亦期无他。\n早晚吾骨只堆此，愿将一石堆吾坡。\n尔来迄今四百载，行人堆石不少差。\n我亦拾石堆其冢，既行且叹复逶迤。\n今冢之高过百尺，堆石亦已岂虚过。\n乃知一饮一滴水，恩至久远不可磨。\n古人一饮在必报，如此传说夫岂讹。\n吁嗟俗世人，乃道无恩波。\n反恩以为雠，此语愚已多。\n我适来此秋向晚，满屦霜叶仍吟哦。\n因笔记此堆婆石，慷慨为赋堆婆歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其一","author":"许左之","text":"谁知花有主。\n误入花深处。\n放直下、酒杯乾、便归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其二","author":"许左之","text":"忆你当初，惜我不去。\n伤我如今，留你不住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祥符寺得句","author":"许必胜","text":"安蔬自足慰平生，峰静松闲涧水平。\n山意悟时僧不语，落花声间梵音清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画","author":"许必胜","text":"傍岸参差筑小亭，山深树暗水泠泠。\n此间应有神仙语，先向图中试一听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闺怨","author":"许必胜","text":"房栊微雨过，虫思草根深。\n门外青苔色，无人闲到今。\n换衫依暮冷，开镜倚秋心。\n别意犹能在，应来梦里寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄山中老稚","author":"许必胜","text":"客久归无计，家书懒再看。\n寄声花郑重，为报竹平安。\n诗酒吾能老，饥寒汝自宽。\n今年新酿熟，收拾钓鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新月","author":"许必胜","text":"偶向树中见，知从水际生。\n叶翻寒不定，云去意无成。\n乱石流泉影，空山落子声。\n当年眉黛在，定见可怜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠友山二侄","author":"许必胜","text":"闻道春来解问经，整衣矩步学趋庭。\n雨馀应惜阶前蚁，月落休轻案上萤。\n自笑颠毛容我白，且留衰眼为伊青。\n熟精文选吾家事，早向秋空试凤翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂咏 其二","author":"许必胜","text":"月至林木异，心空来远声。\n草根幽响奏，小叶孤萤明。\n静念既有在，久之无可名。\n轻云自闲暇，坐久山风鸣。\n微雨偶然过，清心相向生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂咏 其四","author":"许必胜","text":"灼灼山半花，闲闲水中藻。\n苟无松柏心，飘零向谁道。\n蜉蝣炫衣裳，楚楚苦不保。\n野老惜春色，间篱薙青草。\n青草忽已繁，兰蕙日已老。\n兰蕙日已老，我心当奈何。\n人生贵适意，所乐岂在多。\n卓然负书翁，悠悠谢山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂咏 其一","author":"许必胜","text":"久病鲜尘事，溪山遂相安。\n欲知生息意，自树庭中兰。\n静睹花叶荣，春风吹亦难。\n新禽弄佳吹，小水生微澜。\n同在天地中，安能测其端。\n夜澄众境寂，月小松声寒。\n言念御风人，感兹清露漙。\n悲来心自微，凄然竟长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中杂咏 其三","author":"许必胜","text":"鸟乱南山云，日照南山绿。\n东风语流莺，相吹还断续。\n抚彼石上泉，平生自云足。\n浮荣不常御，回薄无停瞩。\n苟非女萝枝，焉能事屈曲。\n峨峨高山松，漾漾深溪渌。\n持此云外心，一谢西飞鹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行","author":"许必胜","text":"雨脚天东来，惊鸟烟中起。\n须臾四山合，万象空濛里。\n孤行念远村，见树联自喜。\n浪游岂无因，遇山则知止。\n棱棱云外峰，与我心终始。\n日暮宿田家，田歌正清美。\n何以途路心，历乱如流水。\n始疑车马上，未必见君子。\n行当弄轻舟，随风问兰芷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨","author":"许必胜","text":"积忧遂成阴，昏色遍苍莽。\n我醉忧已忘，天地当开朗。\n何以酒醒后，犹然在檐上。\n云是方春时，暗助草木长。\n凝阴而无阳，亦非善培养。\n岂因世道非，寰宇盈魍魉。\n日月不照临，星辰羞布象。\n每睹万类心，俱称上天广。\n移转亦何难，梦梦如抱怏。\n地底周雷声，骄乌绝心想。\n四望如无馀，举意同罗网。\n安得最高峰，云外独来往。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日作","author":"许必胜","text":"雨过验庭树，始知春气还。\n造化不相限，随意成斑斓。\n蒙蒙一寸枝，新故伤其间。\n四时递相见，花叶了不閒。\n安能待头白，然后凋朱颜。\n阳春久断绝，梦想见弓弯。\n醉后发高唱，狂句请莫删。\n不贵文字奇，贵使耳目顽。\n从来贤智出，不与庸俗关。\n性情通草木，羞辨魑魅奸。\n周道满荆棘，歧路盈海寰。\n举足何所蹈，归去天台山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕","author":"许必胜","text":"多病成懒疏，日月忽驱逐。\n家人厌陈迹，洒扫新我目。\n争此须臾间，扰扰竞多福。\n习气变性情，不复生惭恧。\n幸有一樽酒，可以寄清穆。\n夜静天四垂，星光就檐屋。\n灯烛忽空旷，琴书转幽独。\n休心薇蕨内，庶免营旨蓄。\n凤凰鸣高冈，贻笑于鸡鹜。\n得终岁寒心，尚愧庭前竹。\n去去天台山，幽兰会当馥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起","author":"许必胜","text":"睡起日满窗，苍蝇黄蜂如沸江。\n莫言闲人得睡足，梦到封侯亦劳碌。\n隔壁棋客时落子，功名事业此中已。\n巫山洛水香成阵，天上晓云为翠鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆旧游 其一","author":"许必胜","text":"欢游成逝波，盛华落残照。\n每忆清池游，幽魂夜相吊。\n与君携手时，云林正清妙。\n天空露光动，襟衫见高调。\n及来愁病侵，瘦骨冰棱峭。\n君如镜中花，独向春光笑。\n荒村酒味薄，沉忧何时疗。\n日色不入梦，高星冻青耀。\n空枝吟霜风，永夜兴悲啸。\n嵯峨金张第，忽成野田烧。\n安得明月中，长见君年少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"许彦国","text":"白鸟有情惊不去，青山无约望还来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如归亭 其三","author":"许申","text":"馆娃宫在西山下，游鹿台居西岭头。\n倒翠尽倾菱镜里，夕阳平照满川流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如归亭 其一","author":"许申","text":"幅圆千里浸清流，蘋叶微风为客收。\n画作一图何处设，煮茶闲看建溪头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如归亭 其二","author":"许申","text":"日脚青山晚半藏，水遥天远岸无厢。\n云边一叶来何处，认是宣州出浦航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如归亭 其四","author":"许申","text":"寻常高讽散人歌，傲睨天随奈尔何。\n即问松江旧庐舍，羽真来往洞庭波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张相公祠","author":"许申","text":"铁胎重整英仪峻，燕厦新成暑气凉。\n韶石遍图辉壁落，荔枝分植映房廊。\n开元旧事丰碑在，家笥犹传故笏囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤栖寺","author":"许仲礼","text":"回环叠嶂倚长空，丹凤曾栖晻霭中。\n殿阁至今无燕雀，溪山随处有梧桐。\n竹荣秀实笼晴景，瀑泻寒泉漱应风。\n伫看来仪新乐府，吾皇勋德与虞同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清洛喜英公大师相访","author":"许仲宣","text":"方袍紫染出彤庭，久在林泉养性灵。\n无事挠心长见醉，有名传世不曾醒。\n多年别我头先白，此日逢师眼倍青。\n记得上都相会否，夜飞杯篆老君经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴叔廉山村","author":"许存我","text":"田绕青山好住家，短篱疏圃接丘麻。\n烟村远近栖鸦乱，竹岸高低飞鹭斜。\n泉喷石间岩涌雪，雾浮堤外柳吹花。\n连云碧色秋光冷，眠犊黄昏草长芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏史","author":"许安世","text":"天下有诛赏，固非君所私。\n太宗泣君集，意恐劳臣疑。\n至公一以废，智术相维持。\n哀哉功名士，汲汲尚趋时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清化山","author":"许安世","text":"霜钟清彻隔村闻，南渡横塘晓色分。\n浅浅溪流涵白石，微微山路入青云。\n劳生已负林泉约，薄宦空增世俗纷。\n见说定香无受想，为祛尘惑借馀熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蓬莱阁赏雪赋诗","author":"许安世","text":"南国收藏晚，黅天凛烈兴。\n日行黄道市，神御坎宫乘。\n元化初施种，穷阴乍丧朋。\n气随钧外转，云自泽中腾。\n集霰纷馀凛，号风助峻棱。\n紫霄零杂佩，玄野碎增冰。\n缟色坳窊遍，寒光上下凝。\n候严知节应，空旷觉神澄。\n透隙还同舞，因方不待绳。\n雁飞朝愈急，鸡误夕相应。\n吟絮飘吴苑，禋茅秀楚塍。\n阶庭迷鹤鹜，林麓蔽薪蒸。\n瑶水三千里，昆崙九万层。\n槛前窥化国，波际失西陵。\n舟兴怀安道，鲈思鄙季鹰。\n胜游方罕值，高会喜相仍。\n涨海雄藩屏，东侯实股肱。\n蕊珠辞密侍，阿阁贲华称。\n将幕开樽俎，宾筵集俊能。\n醴杯亲劝酢，龙坂尽隮登。\n郢唱人谁继，皋谟世共矜。\n击辕知乱雅，附骥偶同蝇。\n绾席尘空满，婴衣体讵胜。\n仰瞻云汉丽，嘉惠岂虚膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游天章寺","author":"许安世","text":"常时俯仰尚为陈，千载重来感一深。\n曲水已伤迷故迹，崇山依旧对游人。\n萦纡雪路联珠骑，萧爽风亭岸角巾。\n秖恐瑶池归扈宴，不能脩禊见深春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄洞山聪禅师","author":"许式","text":"语言全不滞，高蹑祖师踪。\n夜坐连云石，春栽带雨松。\n鉴分金殿烛，山答月楼钟。\n有问西来意，虚堂对远峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桃溪","author":"许当","text":"桃溪一何清，想像武陵水。\n所爱春风时，灼灼花数里。\n渔艇日来去，无人识归止。\n安知历幽源，不遇神仙子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小湖","author":"许当","text":"水德润于物，此湖无谓卑。\n溪壑有通源，风涛无险期。\n泽广均田浍，功高济旱时。\n好看雷雨会，腾踏起蛟螭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]