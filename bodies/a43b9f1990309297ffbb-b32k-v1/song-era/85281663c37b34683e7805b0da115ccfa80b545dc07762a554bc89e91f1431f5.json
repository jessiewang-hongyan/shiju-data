[{"title":"天上月","author":"刘翰","text":"春冰一片净无瑕，万里清光遍海涯。\n欲与常娥移桂树，月中先合种梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石头城","author":"刘翰","text":"离离芳草满吴宫，绿到台城旧苑东。\n一夜空江烟水冷，石头明月雁声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋日","author":"刘翰","text":"乱鸦啼散玉屏空，一枕新凉一扇风。\n睡起秋声无觅处，满阶梧叶月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀友人","author":"刘翰","text":"案成歌舞小春娇，何事君随草木彫。\n从此巴江江上月，有人和泪独吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客去","author":"刘翰","text":"送客归来月满檐，梅花微笑隔疏帘。\n酒醒今夜银屏冷，沉水薰炉旋旋添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种梅","author":"刘翰","text":"凄凉池馆欲栖鸦，采笔无心赋落霞。\n惆怅后庭风味薄，自锄明月种梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻笛","author":"刘翰","text":"谁将玉笛按凉州，吹彻春风不下楼。\n若道声声都是恨，不知消得几多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"刘翰","text":"轻舟一叶一轻篷，上有萧萧鹤发翁。\n昨夜不知何处宿，月明都在笛声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题飞云阁","author":"刘翰","text":"一笑归来春尚寒，小梅飘尽雪初残。\n迟迟更待梨花月，醉倚飞云十二栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"刘翰","text":"沉沉芳酌动金波，笑引疏梅泛玉荷。\n几度天寒归雁少，一番风雨落花多。\n功名好在知心懒，富贵重来奈老何。\n乌鹊数声传喜语，梁间燕子亦能歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚呈范石湖","author":"刘翰","text":"风日萧萧两鬓华，倦寻银笔赋馀霞。\n五更枕上无情雨，三月风前薄命花。\n春困有时因病酒，客怀何日不思家。\n年来事事心情懒，惟有归耕策最嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉斗歌","author":"刘翰","text":"汉兵咸阳未休舍，楚王长歌到戏下。\n项伯夜入张良营，沛公仓皇出城谢。\n自言戮力共攻秦，不意入关成此勋。\n闭关籍民备他盗，尽封府库待将军。\n项庄拔剑项伯起，汉楚兴亡在今尔。\n鸿门壮士斩关来，慷慨一卮谁惧死。\n君不见秦亡鹿走骊山倾，四方尽起诸侯兵。\n龙颜隆准泗上长，天之所授谁能争。\n英雄肯落他人手，独遣谋臣谈辩口。\n君王间道却归来，满地秋声鸣玉斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南曲","author":"刘翰","text":"我家江南同野老，自纺落毛采蘋藻。\n清风满袖读离骚，半亩幽畦种香草。\n门前流水鸣溅溅，日暮归来自刺船。\n遥山数叠作媚妩，落日断霞明晚川。\n雨馀汀草涨新绿，红衣湿尽鸳鸯浴。\n采莲女儿何处来，唱我春风湖上曲。\n瓮头酒熟方新篘，白鱼如银初上钩。\n呼儿洗杓醉明月，酒酣更作商声讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红窗怨","author":"刘翰","text":"啼莺唤起纱窗梦，红日满帘花影弄。\n翠屏香字冷薰炉，罗衣叠损金泥凤。\n去年君去燕归时，今日燕来君未归。\n欲把相思挑锦字，夜寒懒上鸳鸯机。\n起来翠袖香罗薄，东风满地桃花落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余久客都城秋风思归作楚语和吴郎采菱叩舷之音","author":"刘翰","text":"秋风兮凄凄，山中兮桂枝。\n弹余冠兮尘堕，芳草绿兮未归。\n家遥遥兮辞楚荆，伤去国兮重登临。\n扶长剑兮增慨，复鸣铗兮成音。\n采中洲兮兰芷，望美人兮千里。\n我所思兮天一方，共明月兮隔秋水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴门行","author":"刘翰","text":"吴歌婉婉清如水，西风晓自阊门起。\n双桡艇子采菱来，翠荇绿滨香十里。\n芙蓉影落已知秋，溅湿罗衣眉黛愁。\n回声荡桨入门去，明月家家秋水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸿门宴","author":"刘翰","text":"江东遥遥八千骑，大战小战七十二。\n刘郎晓鞭天马来，踧踏长安开帝里。\n子婴已降隆准公，君王置酒鸿门东。\n张良已去玉斗碎，三月火照咸阳红。\n绣衣归来日将夜，可惜雄心天不借。\n当时已失范增谋，尚引长戈到垓下。\n刁斗乍急营垒惊，夜深旗尾秋风横。\n玉帐佳人不成梦，月明四面闻歌声。\n拔剑相看泪如雨，我作楚歌君楚舞。\n明朝宝马一声嘶，江北江东皆汉土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠屏曲","author":"刘翰","text":"小亭帘幕垂阴阴，梅香入枕春生屏。\n西窗月落翠被冷，鸟声残梦东风醒。\n三年不唤清溪渡，梦里瀼西春水路。\n江头女儿双翠眉，能唱刘郎芳草句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近","author":"刘翰","text":"花底一声莺，花上半钩斜月。\n月落乌啼何处，点飞英如雪。\n东风吹尽去年愁，解放丁香结。\n惊动小亭红雨，舞双双金蝶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂殿秋 其二 同上","author":"刘翰","text":"双玉节，到神京。\n碧杯仙露冷如冰。\n一声金磬千花发，洞口天风吹酒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂殿秋 其一 寿于湖先生","author":"刘翰","text":"青帝子，碧莲宫。\n不驾云车骑白龙。\n瑶池路远羽衣湿，玉佩泠泠明月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二","author":"刘翰","text":"鸳鸯翡翠。\n小小池塘水。\n落絮游丝花满地。\n度日阑干独倚。\n金刀裁就春衫。\n起来初试轻寒。\n满把相思清恨，题诗欲寄江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一","author":"刘翰","text":"萋萋芳草。\n怨得王孙老。\n瘦损腰围罗带小。\n长是锦书来少。\n玉箫吹落梅花。\n晓寒犹透轻纱。\n惊起半屏幽梦，小窗淡月啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"刘翰","text":"去时满地花阴月。\n归来落尽梧桐叶。\n帘外小梅残。\n绿窗幽梦寒。\n明朝提玉勒。\n又作江南客。\n芳草遍长亭。\n东风吹恨生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花","author":"刘翰","text":"团扇题诗春又晚。\n小梦惊残，碧草池塘满。\n一曲银钩帘半卷。\n绿窗睡足莺声软。\n瘦损衣围罗带减。\n前度风流，陡觉心情懒。\n谁品新腔拈翠管。\n画楼吹彻江南怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"刘翰","text":"吹入征鸿数字秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"刘翰","text":"青山经雨菊花尽，白鸟下滩芦叶尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏陈后主","author":"刘镗","text":"晋王前殿贺平陈，从此江南雨露均。\n四百年间重混一，谁知江令是忠臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观傩","author":"刘镗","text":"寒云岑岑天四阴，画堂烛影红帘深。\n鼓声渊渊管声脆，鬼神变化供剧戏。\n金洼玉注始淙潺，眼前倏已非人间。\n夜叉蓬头铁骨朵，赭衣蓝面眼迸火。\n魆蜮罔象初偋伶，跪羊立豕相嚘嘤。\n红裳姹女掩蕉扇，绿绶髯翁握蒲剑。\n翻筋踢斗臂膊宽，张颐吐舌唇吻乾。\n摇头四顾百距跃，敛身千态万斝索。\n青衫舞蹈忽屏营，采云揭帐森麾旌。\n紫衣金章独据案，马䰎牛权两披判。\n能言祸福不由天，躬履率越分愚贤。\n蒺藜奋威小甶服，䰐縿扬声大髽哭。\n白面使者竹筱鎗，自誇搜捕无遗藏。\n牛冠钳卷试阅检，虎冒肩戟光睒闪。\n五方点队乱纷纭，何物老妪绷獶熏。\n终南进士破鞮绔，嗜酒不悟鬼看觑。\n奋髯瞠目起婆娑，众邪一正将那何。\n披发将毕飞一吷，风捲云收鼓箫歇。\n夜阑四坐惨不怡，主人送客客尽悲。\n归来桃茢坐深蕳，翠鸮黄狐犹在眼。\n自歌楚些大小招，坐久魂魄游逍遥。\n会稽山中禹非死，铸鼎息壤乃若此。\n又闻鬼奸多冯人，人奸冯鬼奸入神。\n明日冠裳好妆束，白昼通都人面目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"刘镗","text":"尊前能是几时客，山下已成千古坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"刘镗","text":"草隥水流襜佩响，松梢月冷露珠圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"刘镗","text":"村桥日落市声散，山路月明人语归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"刘镗","text":"柳条风慢天初暖，花影晴光地亦香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"刘镗","text":"版桥雨过秋苔滑，村碓寒吹暴稻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"刘镗","text":"月下有闻思望帝，山中无曲舞胎仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"刘镗","text":"故人皆死谁为佛，老我犹生即是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"刘镗","text":"孔曾有道官天下，韩柳无文世子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"刘镗","text":"几番雨过山仍在，独望人间鹤未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山寺听雨","author":"刘翼","text":"问道论诗也一宗，烧柴煨芋佛家风。\n要知真乐人间少，听雨空山破寺中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏和刘雪巢题壁韵","author":"刘翼","text":"吟怀祗怕俗尘迷，若慕唐人也自痴。\n要识性情根极处，请观三百五篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送二子从子宜读书","author":"刘翼","text":"三代读书无寸功，又将此法教儿童。\n旁人笑我背时好，不背旁人背乐翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽敖仪仲 其四","author":"刘翼","text":"书中有种复何愁，酒兴诗狂卒未休。\n莫唱横塘断肠句，不堪斜日独登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽敖仪仲 其三","author":"刘翼","text":"昼倚篮舆饯一杯，殷勤别语到帘帏。\n那知此夜成长往，书屋无人月掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶见官舍梅花作","author":"刘翼","text":"天然标格自潇疏，底用松篁水月俱。\n但是梅花皆可爱，何关东阁与西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽敖仪仲 其二","author":"刘翼","text":"对坐茶瓯日两回，胸怀真率向人开。\n茶瓯对客如前度，不见先生杖屦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦呈乐轩先生既觉不失一字录呈竹溪玉堂","author":"刘翼","text":"不见仙翁四十春，幸然丘陇在比邻。\n当年四海从游者，报佛深恩有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题东皋诗卷","author":"刘翼","text":"雪竹霜松不老身，尽教后进笑陈人。\n相逢亦有吟诗客，谁似先生语意真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书情","author":"刘翼","text":"萧疏远市嚣，山窟杂耕樵。\n穷鬼乘吾拙，钱神挟汝骄。\n世途自巇崄，真性本逍遥。\n尚想荣期乐，纶巾傲汉貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"心游楼即事","author":"刘翼","text":"禅坐宁离此，意行何所如。\n稻粱诗七月，果木赋闲居。\n活水尝新茗，颠风落旧书。\n无才甘用拙，不是隐樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸卯十月同林子宜拜扫先师乐轩墓因和南谷寺壁间韵","author":"刘翼","text":"秋风飒飒已华颠，男女犹赊嫁娶钱。\n问道西轩空有梦，翻经南谷恐无缘。\n登坟荐酒徒为尔，对佛拈花亦偶然。\n回首白云无叫处，青山长在泪痕边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题心游楼","author":"刘翼","text":"一自浮光抵玉融，东林山曲世为农。\n前场岁计禾麻麦，后圃年深竹荔松。\n博我多闻千载史，唤人深省五更钟。\n不消更会楞严语，面面披云挹晓峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题简上人西亭诗文后","author":"刘翼","text":"真如非字义，绮语道之疵。\n未见西亭作，长为北涧欺。\n晚因僧媚远，初实客从㬢。\n多少才名士，沉沦世不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯言见和拙作以汉隶书之谢以七韵","author":"刘翼","text":"李潮善八分，求歌杜陵叟。\n有人和我诗，半纸馀科斗。\n风云生其怀，剑戟出其手。\n石经中郎蔡，新样元和柳。\n元常文不传，退之书何有。\n待我农隙时，载笔随君后。\n袖手眼亦明，聊与之饮酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答林昌宗诗筌韵","author":"刘翼","text":"经锄小暇弄诗筌，老去仍知默是禅。\n沧海移舟尽琴趣，虽然终不似无弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题平远轩呈竹溪玉堂","author":"刘翼","text":"溪堂辟小轩，此景绝可爱。\n蔡松道东边，千载典刑在。\n高低万顷田，面势溪向背。\n生绡一幅宽，晴雨不尽态。\n中有谪仙人，来寻莘野耒。\n畎亩虽不忘，知进不如退。\n乾坤入醉眼，风月出吟喙。\n我非人境游，亭在人境内。\n心平水不波，见远山无碍。\n时携琰石游，间以刘白辈。\n仆忝老诸生，来扣佛三昧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘翼","text":"富贵功名堪擘画，最难擘画子孙贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西楼","author":"刘翼之","text":"西楼何似古东楼，但觉今州胜旧州。\n山色不藏兴废迹，江声空战古今愁。\n楼上词人誇丽藻，分明说与江山好。\n江山千古有精神，祇为曾经诗客到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六夜月","author":"刘黻","text":"何处吹来笛一声，长空如水浸江城。\n中秋有月云偏妒，底事今宵放得明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五穷吟","author":"刘黻","text":"智学文交与命穷，瘴江风雨值衰翁。\n昌黎送别劳三揖，何似檀栾一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"讥刘秘监献佞固宠","author":"刘黻","text":"白玉堂中翰墨师，忍令奏牍玷涂碑。\n向时刚道梅花累，今累梅花自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对月","author":"刘黻","text":"三千里外无家客，四十年间苦学人。\n山隔不知云近远，祗将明月作乡亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 友梅","author":"刘黻","text":"玉骨冰肌练帨轻，纵教雪压色逾明。\n太清不入尘人眼，完得平生淡性情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 见梅","author":"刘黻","text":"水边林表几徘徊，索笑清尊不惮开。\n祗恐对花无好句，却成辜负一年来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 访梅","author":"刘黻","text":"山寒木落峭孤台，南北常分冷暖开。\n自笑三生如结习，每来月下立苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 拟梅","author":"刘黻","text":"花事俱空叶乱飞，孤标强项发枯枝。\n溪山的皪无人问，铁石心肠雪冻时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 咏梅","author":"刘黻","text":"草木班中有此花，暗香浮动影横斜。\n古今陶写閒情性，惟说西湖处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 爱梅","author":"刘黻","text":"被酒閒凭茗主和，恼人风动不消多。\n月高片影横窗上，夜半无眠客奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 探梅","author":"刘黻","text":"只办茶杯与酒尊，山中寒日易黄昏。\n今年闰月迟消息，枉费清宵几梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 遇梅","author":"刘黻","text":"冷淡生涯合晚开，老天故遣雪频催。\n相逢唤醒平生梦，不误山翁特地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 愬梅","author":"刘黻","text":"清入肝脾冷入肌，天机忽露两三枝。\n为渠瘦得身如鹤，诗病除非诗可医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用坡仙梅花十韵 赞梅","author":"刘黻","text":"万卉千葩总一家，木心才蠹脉皆邪。\n山窗玉立如风宪，人指为花不是花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]