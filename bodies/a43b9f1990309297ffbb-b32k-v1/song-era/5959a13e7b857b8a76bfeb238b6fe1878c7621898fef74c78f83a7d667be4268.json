[{"title":"徐介卿赴召经筵二诗送之 其二","author":"李曾伯","text":"袂判平山十五年，喜迎召节下楼船。\n交情一见岁寒在，世事几番春梦然。\n我亦将归谋佚老，公今此去类登仙。\n一杯且酌长沙酒，莫忆灯棋话汉边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐介卿赴召经筵二诗送之 其一","author":"李曾伯","text":"天赋经纶满壮怀，饱于扬历老其才。\n江东见谓无卿比，今世谁能舍我哉。\n岭表分弓宽上顾，淮头弄印待公来。\n玉阶宜罄忠言告，闻说天边有诏催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽大资节使史国公 其三","author":"李曾伯","text":"昔缀都曹后，升堂拜父师。\n达尊廑异盼，国士沐深知。\n鹤发人何在，蝇头字尚遗。\n遣车无路送，挥泪望丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽大资节使史国公 其二","author":"李曾伯","text":"早袖经纶手，传之柱石材。\n无心到孤棘，有德付三槐。\n五鼎方身飨，两楹俄梦回。\n百年流泽远，衮衮几公台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽大资节使史国公 其一","author":"李曾伯","text":"德齿明时冠，诗书正派深。\n修名在原隰，雅志已山林。\n眼历四朝事，神交千圣心。\n老成天不憖，大雅有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽尤端明 其四","author":"李曾伯","text":"忆昨趋湘水，公归问锡山。\n惜时为俗累，欠往拜师颜。\n不复亲温厉，畴其念险艰。\n莫持鸡炙去，老泪不胜潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽尤端明 其三","author":"李曾伯","text":"自入乌公府，受知三十秋。\n水鱼承雅眷，风鹤记良筹。\n一意人才进，平居国事忧。\n丝桐宜束阁，谁似子期不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽尤端明 其二","author":"李曾伯","text":"渡江无故老，文武少全材。\n金玉其相者，朝廷有几哉。\n銮坡资润色，虎帐壮规恢。\n盍展经纶蕴，登调鼎鼐梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽尤端明 其一","author":"李曾伯","text":"身际乾淳盛，家传祖笏棠。\n典型周大雅，人物鲁灵光。\n厚德千钧重，明时一鉴亡。\n哲人今已矣，梦卜负岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽史鲁公 其一","author":"李曾伯","text":"经济由身致，安危主意深。\n威名振华夏，岁月付山林。\n世望一老在，天胡二竖侵。\n盖棺公论定，不泯是人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽史鲁公 其二","author":"李曾伯","text":"自出权衡下，当从履屐间。\n旧游今历落，往事几危艰。\n纪德哀辞痛，酬知老泪潸。\n哲人今已矣，魂梦绕鄞山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽观使郑尚书 其二","author":"李曾伯","text":"秉钺岷峨去，分弓淮海游。\n安危勤阃略，得失假家谋。\n不易猗兰操，何伤薏苡羞。\n盖棺公论定，知罪付春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽观使郑尚书 其一","author":"李曾伯","text":"许史推华阅，欧韩策隽名。\n风流接南渡，步武到西清。\n玉帐劳筹笔，彤墀识履声。\n壮怀驰万里，谁坏国金城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽观使郑尚书 其三","author":"李曾伯","text":"忆昨从游日，乌奴桃李春。\n通家联雅好，入幕厕佳宾。\n绿野归心切，丹山旧迹陈。\n九原多感怆，掩袂重伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何司令 其二","author":"李曾伯","text":"忆昨初倾盖，同登巴岳楼。\n江淮重邂逅，幕府屡绸缪。\n梦绝秋城柝，人随夜壑舟。\n潜山归路杳，草木亦凄愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何司令 其一","author":"李曾伯","text":"太学何蕃誉，当时蔼帝乡。\n五联棣华萼，三折桂枝香。\n司社腾声望，题舆迓宠光。\n奇才今已矣，流庆在虹梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽别大参 其二","author":"李曾伯","text":"早年公已阿戎知，几与征西履屐随。\n百六椽间无足纪，二三子侧每相思。\n重来荆渚平生若，宁复苕溪一见之。\n哀此哲人今已矣，诗兮岂但哭吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽别大参 其一","author":"李曾伯","text":"几历藩垣一节勤，归来两地会风云。\n调知白雪阳春别，香到黄花晚节闻。\n夷狄犹知问中立，朝廷惜竟老希文。\n台躔夜折空追叹，留得甘棠满楚郧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴文昌母夫人 其二","author":"李曾伯","text":"庆事一门盛，修龄七帙强。\n纶封四大国，綵侍两文昌。\n梦幻存真觉，勋庸看显扬。\n家山空睇望，惜此令仪亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴文昌母夫人 其一","author":"李曾伯","text":"懿范儒家出，灵台佛地平。\n活人裨惠爱，教子以忠清。\n康肃母无愧，中郎女有声。\n老天昭德报，兰桂满庭荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴总干 其二","author":"李曾伯","text":"夙托弥甥列，常怀范叔寒。\n门阑多厚盼，樽俎有馀驩。\n衣笥袍犹恋，书邮墨未乾。\n官身羁执绋，清泪为公弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴总干 其一","author":"李曾伯","text":"庆积家声远，材优官业长。\n胡然啬诸用，竟尔老于乡。\n德与年何憾，人期后必昌。\n秦原空睇望，惜此典刑亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴准斋 其二","author":"李曾伯","text":"昨缀都人士，尝薰一瓣香。\n苍茫问淮浦，缱绻饯河梁。\n闻道机缘浅，予人风谊长。\n斯文其已矣，草木亦凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴准斋 其一","author":"李曾伯","text":"持此四海准，得之前圣心。\n箪瓢富台阁，朝市等山林。\n说破先天易，流传正始音。\n太原千载后，思者甚于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴鹤林尚书 其三","author":"李曾伯","text":"宝屏倾盖早，公壮我丁年。\n入幕笑谈旧，升朝礼乐先。\n寄书榆柳外，觅句竹梅边。\n俯仰成畴昔，空馀涕泗涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴鹤林尚书 其二","author":"李曾伯","text":"一代儒臣表，三州吏治良。\n遗言了生死，新志尽行藏。\n昔梦崖何异，今知坡可方。\n百僚山下路，千载尚名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴鹤林尚书 其一","author":"李曾伯","text":"凤翥鹤林邑，来仪鸳鹭群。\n陈谟倾帝听，摛翰媲皇坟。\n位且践台斗，心惟寄岫云。\n诏纶方夜下，天曷丧斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李楼山观文 其三","author":"李曾伯","text":"相从剑南幕，公壮我丁年。\n寘彼诸生后，荐之明主前。\n承颜台衮近，托迹午桥边。\n壤厦千秋隔，潸然老泪涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李楼山观文 其二","author":"李曾伯","text":"两登枢辅地，一武宰衡班。\n利泽才膺寸，良方缩肘间。\n重为千载惜，竟老十年闲。\n回首西州梦，吴中第几山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李楼山观文 其一","author":"李曾伯","text":"展也岷峨秀，钟为柱石臣。\n直声留谏纸，硕望压朝绅。\n群议王师锐，孤忠主听陈。\n天其昌我宋，尧舜致君民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈勉斋文昌 其二","author":"李曾伯","text":"忆昨从军辱己知，不图二纪踵前规。\n人非城是黄粱梦，地老天荒白发悲。\n堕泪忍看羊祜传，伤心徒作魏公诗。\n勉旃衣钵芝兰事，传取清风百世师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈勉斋文昌 其一","author":"李曾伯","text":"几年间气一全才，天以经纶属勉斋。\n勋盛十年词两制，寿开九帙位三阶。\n公于南国恩尤在，人惜东山望莫偕。\n岁晚倏闻梁木坏，君王应亦为伤怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵无垢 其二","author":"李曾伯","text":"公未通闺日，相从入幕游。\n瞠乎惭后乘，藉甚伟前筹。\n原隰曾并辔，江涛几共舟。\n柯山回首处，老泪为横流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵无垢 其一","author":"李曾伯","text":"早奏玉垣绩，才登金掌班。\n众皆期两地，谁谓老三山。\n江夏勋劳上，东平礼义间。\n壮猷惭弗克，孰与济时艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽龚致政 其二","author":"李曾伯","text":"绣节荣分使，斑衣喜拜亲。\n方将昌厥后，岂必在其身。\n真馆仙游远，佳城瑞气新。\n九原看厚报，衮衮耀丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c0685