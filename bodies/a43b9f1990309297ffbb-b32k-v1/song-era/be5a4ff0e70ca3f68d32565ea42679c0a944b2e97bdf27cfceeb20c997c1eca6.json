[{"title":"雪中六解 其五","author":"姜夔","text":"万壑千岩一样寒，城中别有玉龙蟠。\n旧人乘兴扁舟处，今日诗仙戴笠看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中六解 其六","author":"姜夔","text":"沈香火里笙箫合，煖玉鞍边雉兔空。\n办得煎茶有骄色，先生只合作诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"越中士女春游","author":"姜夔","text":"秦山越树两依依，閒倚阑干看落晖。\n杨柳梢头春又暗，玉箫声里夜游归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范仲讷往合肥三首 其一","author":"姜夔","text":"壮志只便鞍马上，客梦长在江淮间。\n谁能辛苦运河里，夜与商人争往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范仲讷往合肥三首 其二","author":"姜夔","text":"我家曾住赤阑桥，邻里相过不寂寥。\n君若到时秋已半，西风门巷柳萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范仲讷往合肥三首 其三","author":"姜夔","text":"小帘灯火屡题诗，回首青山失后期。\n未老刘郎定重到，烦君说与故人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下菰城","author":"姜夔","text":"人家多在竹篱中，杨柳疏疏尚带风。\n记得下菰城下路，白云依旧两三峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平甫放三十六鸥於吴松余不及与盟","author":"姜夔","text":"桥下松陵绿浪横，来迟不与白鸥盟。\n知君久对青山立，飞尽梨花好句成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧山","author":"姜夔","text":"归心已逐晚云轻，又见越中长短亭。\n十里水边山下路，桃花无数麦青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊午春帖子","author":"姜夔","text":"晴窗日日拟雕虫，惆怅明时不易逢。\n二十五弦人不识，淡黄杨柳舞春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"姜夔","text":"阿八宫中酒未醒，天风吹发夜泠泠。\n归来只怕扶桑晚，赤脚横骑太乙鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈日华侍儿读书","author":"姜夔","text":"绎句寻章久未休，花房日晏不梳头。\n谁教郎主能多事，乞与冥冥千古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"女郎山","author":"姜夔","text":"不见郢中能赋客，可怜负此女郎山。\n冰魂寂寞无归处，独宿鸳鸯沙水寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓雪亭","author":"姜夔","text":"阑干风冷雪漫漫，惆怅无人把钓竿。\n时有官船桥畔过，白鸥飞去落前滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿萼梅","author":"姜夔","text":"黄云承袜知何处，招得冰魂付北枝。\n金谷楼高愁欲堕，断肠谁把玉龙吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵武伯","author":"姜夔","text":"杨柳风微约暮寒，野禽容与只波间。\n道人心性如天马，可爱青丝十二闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其一","author":"姜夔","text":"世间形象尽成灯，烘火旋纱巧思生。\n列肆又多看不遍，游人一一把灯行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其二","author":"姜夔","text":"市楼歌吹太喧哗，灯若连珠照万家。\n太守令严君莫舞，游人空带玉梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其三","author":"姜夔","text":"游人总戴孟家蝉，争托星毬万眼圆。\n闹里传呼大官过，后车多少尽婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其四","author":"姜夔","text":"花帽笼头几岁儿，女儿学著内人衣。\n灯前月下无归路，不到天明亦不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其五","author":"姜夔","text":"好灯须买不论钱，别有琉璃价百千。\n都下贵人多预赏，买时长在一阳前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其六","author":"姜夔","text":"珠络琉璃到地垂，凤头衔带玉交枝。\n君王不赏无人进，天竺堂深夜雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其七","author":"姜夔","text":"纷纷铁马小回旋，幻出曹公大战年。\n若使英雄知□事，不教儿女戏灯前。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其八","author":"姜夔","text":"贵客钩帘看御街，市中珍品一时来。\n帘前花架无行路，不得金钱不肯回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其九","author":"姜夔","text":"修内司人编戏鼓，辇宫营里独烧灯。\n春风到处皆君赐，金柳丝丝满凤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观灯口号十首 其十","author":"姜夔","text":"正好嬉游天作魔，翠裙无奈雨沾何。\n御街暗里无灯火，处处但闻楼上歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪张平甫游禹庙","author":"姜夔","text":"镜里山林绿到天，春风只在禹祠前。\n一声何处提壶鸟，猛省红尘二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄俞子二首 其一","author":"姜夔","text":"此郎都无子弟气，夜对黄妳笼青灯。\n君今落脚堕鸢外，欲往从之叹未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄俞子二首 其二","author":"姜夔","text":"郎罢才名今白发，佐州亦复坐穷边。\n甚欲出手相料理，东南风高难寄笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯词四首 其一","author":"姜夔","text":"南陌东城尽舞儿，画金刺绣满罗衣。\n也知爱惜春游夜，舞落银蟾不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯词四首 其二","author":"姜夔","text":"灯已阑珊月气寒，舞儿往往夜深还。\n只因不尽婆娑意，更向阶心弄影看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯词四首 其三","author":"姜夔","text":"沙河云合无行处，惆怅来游路已迷。\n却入静坊灯火空，门门相似列蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯词四首 其四","author":"姜夔","text":"游人归后天街静，坊陌人家未闭门。\n帘里垂灯照尊俎，坐中嬉笑觉春温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春词二首 其一","author":"姜夔","text":"六军文武浩如云，花簇头冠样样新。\n惟有至尊浑不戴，尽将春色赐群臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春词二首 其二","author":"姜夔","text":"万数簪花满御街，圣人先自景灵回。\n不知后面花多少，但见红云冉冉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同朴翁过净林广福院","author":"姜夔","text":"四人松下共盘桓，笔砚花壶石上安。\n今日兴怀同此味，老仙留字在孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙井","author":"姜夔","text":"年时六月海扬尘，遥见青山起白云。\n闻有高僧来诵咒，岩前抛珓问龙君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自题画像","author":"姜夔","text":"鹤氅如烟羽扇风，寄情芳草绿阴中。\n黑头办了人间事，来看凌霜数点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉泰壬戌上元日访全老於净林广福院观沈傅师碑隆茂宗画赠诗二首 其一","author":"姜夔","text":"深衣跨羸骖，杳杳春山路。\n入寺君未知，閒看移桂树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉泰壬戌上元日访全老於净林广福院观沈傅师碑隆茂宗画赠诗二首 其二","author":"姜夔","text":"沈碑含秀润，隆画出神奇。\n道人那得此，老子乃耽之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"姜夔","text":"小山不能云，大山半为天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"姜夔","text":"屋角红梅树，花前白石生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一萼红","author":"姜夔","text":"古城阴。\n有官梅几许，红萼未宜簪。\n池面冰胶，墙腰雪老，云意还又沈沈。\n翠藤共、闲穿径竹，渐笑语、惊起卧沙禽。\n野老林泉，故王台榭，呼唤登临。\n南去北来何事，荡湘云楚水，目极伤心。\n朱户黏鸡，金盘簇燕，空叹时序侵寻。\n记曾共，西楼雅集，想垂杨、还袅万丝金。\n待得归鞍到时，只怕春深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八归 湘中送胡德华","author":"姜夔","text":"芳莲坠粉，疏桐吹绿，庭院暗雨乍歇。\n无端抱影销魂处，还见筱墙萤暗，藓阶蛩切。\n送客重寻西去路，问水面琵琶谁拨。\n最可惜一片江山，总付与啼鴂。\n长恨相从未款，而今何事，又对西风离别。\n渚寒烟淡，棹移人远，缥缈行舟如叶。\n想文君望久，倚竹愁生步罗袜。\n归来后，翠尊双饮，下了珠帘，玲珑闲看月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其三","author":"姜夔","text":"藓干石斜妨，玉蕊松低覆。\n日暮冥冥一见来，略比年时瘦。\n凉观酒初醒，竹阁吟才就。\n犹恨幽香作许悭，小迟春心透。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其二","author":"姜夔","text":"月上海云沈，鸥去吴波迥。\n行过西泠有一枝，竹暗人家静。\n又见水沈亭，举目悲风景。\n花下铺毡把一杯，缓饮春风影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其七","author":"姜夔","text":"象笔带香题，龙笛吟春咽。\n杨柳娇痴未觉愁，花管人离别。\n路出古昌源，石瘦冰霜洁。\n折得青须碧藓花，持向人间说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其四","author":"姜夔","text":"家在马城西，今赋梅屏雪。\n梅雪相兼不见花，月影玲珑彻。\n前度带愁看，一饷和愁折。\n若使逋仙及见之，定自成愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其八","author":"姜夔","text":"御苑接湖波，松下春风细。\n云绿峨峨玉万枝，别有仙风味。\n长信昨来看，忆共东皇醉。\n此树婆娑一惘然，苔藓生春意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其五","author":"姜夔","text":"摘蕊暝禽飞，倚树悬冰落。\n下竺桥边浅立时，香已漂流却。\n空径晚烟平，古寺春寒恶。\n老子寻花第一番，常恐吴儿觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 吏部梅花八咏，夔次韵 其一","author":"姜夔","text":"江左咏梅人，梦绕青青路。\n因向凌风台下看，心事还将与。\n忆别庾郎时，又过林逋处。\n万古西湖寂寞春，惆怅谁能赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其六","author":"姜夔","text":"绿萼更横枝，多少梅花样。\n惆怅西村一坞春，开遍无人赏。\n细草藉金舆，岁岁长吟想。\n枝上么禽一两声，犹似宫娥唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山令/小重山","author":"姜夔","text":"寒食飞红满帝城。\n慈乌相对立，柳青青。\n玉阶端笏细陈情。\n天恩许，春尽可还京。\n鹊报倚门人。\n安舆扶上了，更亲擎。\n看花携乐缓行程。\n争迎处，堂下拜公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山令/小重山 潭州红梅","author":"姜夔","text":"人绕湘皋月坠时。\n斜横花树小，浸愁漪。\n一春幽事有谁知。\n东风冷、香远茜裙归。\n鸥去昔游非。\n遥怜花可可，梦依依。\n九疑云杳断魂啼。\n相思血，都沁绿筠枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年游 戏平甫","author":"姜夔","text":"双螺未合，双蛾先敛，家在碧云西。\n别母情怀，随郎滋味，桃叶渡江时。\n扁舟载了，匆匆归去，今夜泊前溪。\n杨柳津头，梨花墙外，心事两人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆王孙 番阳彭氏小楼作","author":"姜夔","text":"冷红叶叶下塘秋。\n长与行云共一舟。\n零落江南不自由。\n两绸缪。\n料得吟鸾夜夜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月上海棠 夹钟商赋题","author":"姜夔","text":"红妆艳色，照浣花溪影，绝代姝丽。\n弄轻风、摇荡满林罗绮。\n自然富贵天姿，都不比、等闲桃李。\n帘栊静悄，月上正贪春睡。\n长记初开日，逞妖丽、如与人面争媚。\n过韶光一瞬，便成流水。\n对此日叹浮华，惜芳菲、易成憔悴。\n留无计。\n惟有花边尽醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下笛","author":"姜夔","text":"与客携壶，梅花过了，夜来风雨。\n幽禽自语。\n啄香心，度墙去。\n春衣都是柔荑剪，尚沾惹、残茸半缕。\n怅玉钿似扫，朱门深闭，再见无路。\n凝伫，曾游处。\n但系马垂杨，认郎鹦鹉。\n扬州梦觉，彩云飞过何许？\n多情须倩梁间燕，问吟袖弓腰在否？\n怎知道、误了人，年少自恁虚度！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 黄庆长夜泛鉴湖，有怀归之曲，课予和之","author":"姜夔","text":"夜深客子移舟处，两两沙禽惊起。\n红衣入桨，青灯摇浪，微凉意思。\n把酒临风，不思归去，有如此水。\n况茂林游倦，长干望久，芳心事、箫声里。\n屈指归期尚未。\n鹊南飞、有人应喜。\n画栏桂子，留香小待，提携影底。\n我已情多，十年幽梦，略曾如此。\n甚谢郎、也恨飘零，解道月明千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 富览亭永嘉作","author":"姜夔","text":"日落爱山紫，沙涨省潮回。\n平生梦犹不到，一叶眇西来。\n欲讯桑田成海，人世了无知者，鱼鸟两相推。\n天外玉笙杳，子晋只空台。\n倚阑干，二三子，总仙才。\n尔歌远游章句，云气入吾杯。\n不问王郎五马，颇忆谢生双屐，处处长青苔。\n东望赤城近，吾兴亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长亭怨慢","author":"姜夔","text":"渐吹尽、枝头香絮。\n是处人家，绿深门户。\n远浦萦回，暮帆零乱向何许。\n阅人多矣，谁得似、长亭树。\n树若有情时，不会得、青青如此。\n日暮。\n望高城不见，只见乱山无数。\n韦郎去也，怎忘得、玉环分付。\n第一是、早早归来，怕红萼、无人为主。\n算空有并刀，难剪离愁千缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永遇乐 次韵辛克清先生","author":"姜夔","text":"我与先生，夙期已久，人间无此。\n不学杨郎，南山种豆，十一徵微利。\n云霄直上，诸公衮衮，乃作道边苦李。\n五千言，老来受用，肯教造物儿戏。\n东冈记得，同来胥宇，岁月几何难计。\n柳老悲桓，松高对阮。\n未办为邻地。\n长干白下，青楼朱阁，往往梦中槐蚁。\n却不如、洼尊放满，老夫未醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永遇乐 次稼轩北固楼词韵","author":"姜夔","text":"云隔迷楼，苔封很石，人向何处？\n数骑秋烟，一篙寒汐，千古空来去。\n使君心在，苍崖绿嶂，苦被北门留住。\n有尊中酒差可饮，大旗尽绣熊虎。\n前身诸葛，来游此地，数语便酬三顾。\n楼外冥冥，江皋隐隐，认得征西路。\n中原生聚，神州耆老，南望长淮金鼓。\n问当时依依种柳，至今在否？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 其一 次韵稼轩","author":"姜夔","text":"云曰归欤。\n纵垂天曳曳，终反衡庐。\n扬州十年一梦，俯仰差殊。\n秦碑越殿，悔旧游、作计全疏。\n分付与、高怀老尹，管弦丝竹宁无。\n知公爱山入剡，若南寻李白，问讯何如。\n年年雁飞波上，愁亦关予。\n临皋领客，向月边、携酒携鲈。\n今但借、秋风一榻，公歌我亦能书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 其二 次韵稼轩蓬莱阁","author":"姜夔","text":"一顾倾吴。\n苎萝人不见，烟杳重湖。\n当时事如对弈，此亦天乎。\n大夫仙去，笑人间、千古须臾。\n有倦客、扁舟夜泛，犹疑水鸟相呼。\n秦山对楼自绿，怕越王故垒，时下樵苏。\n只今倚阑一笑，然则非欤。\n小丛解唱，倩松风、为我吹竽。\n更坐待、千岩月落，城头眇眇啼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉梅令","author":"姜夔","text":"疏疏雪片，散入溪南苑。\n春寒锁、旧家亭馆。\n有玉梅几树，背立怨东风，高花未吐，暗香已远。\n公来领略，梅花能劝，花长好、愿公更健。\n便揉春为酒，剪雪作新诗，拚一日、绕花千转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石湖仙 越调寿石湖居士","author":"姜夔","text":"松江烟浦。\n是千古三高，游衍佳处。\n须信石湖仙，似鸱夷、翩然引去。\n浮云安在，我自爱、绿香红舞。\n容与。\n看世间、几度今古。\n卢沟旧曾驻马，为黄花、闲吟秀句。\n见说胡儿，也学纶巾敧雨。\n玉友金蕉，玉人金缕。\n缓移筝柱。\n闻好语。\n明年定在槐府。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 赋茉莉","author":"姜夔","text":"凉夜摘花钿，苒苒动摇云绿。\n金络一团香露，正纱厨人独。\n朝来碧缕放长穿，钗头挂层玉。\n记得如今时候，正荔枝初熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]