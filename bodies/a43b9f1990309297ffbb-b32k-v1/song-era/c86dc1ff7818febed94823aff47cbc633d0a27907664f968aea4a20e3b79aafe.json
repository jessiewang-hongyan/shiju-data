[{"title":"过真阳峡六首 其二","author":"杨万里","text":"莫道无人径亦穷，尚馀碧筱伴青枫。\n白云不是从天降，坐看生从翠崦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过真阳峡六首 其一","author":"杨万里","text":"玉削双崖一水通，一重一掩更重重。\n平生山水看多少，最爱真阳第二峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过秦淮","author":"杨万里","text":"晓过新桥启轿窗，要看春水弄春光。\n东风作意惊诗眼，搅乱垂杨两岸黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过莺斗湖三首 其三","author":"杨万里","text":"春来已自两旬馀，欲借春看未见渠。\n烟树隔湖三十里，寒梢依旧向人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过莺斗湖三首 其二","author":"杨万里","text":"忽闻江上四驩呼，知近吴江莺斗湖。\n火炬灯笼不须办，使家行住按程涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过莺斗湖三首 其一","author":"杨万里","text":"画舫如山水上奔，小船似鸭避河滨。\n红旗青盖鸣钲处，都是迎来送往人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过望亭六首 其六","author":"杨万里","text":"晴河不似雨中看，晴里波纹只簟斑。\n却是雨河新样巧，簟间织出小金镮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过望亭六首 其五","author":"杨万里","text":"朝朝暮暮见长河，见了长河只厌它。\n却爱画师能画水，不看死浪与生波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过望亭六首 其四","author":"杨万里","text":"两岸山林总解行，一层送了一层迎。\n天公收却春风面，拈出酸寒水墨屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过望亭六首 其三","author":"杨万里","text":"暮鸿作阵猛相追，风有何忙也急吹。\n恼杀诗人真枉却，云窗雾阁不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过望亭六首 其二","author":"杨万里","text":"窗间雨打泪新斑，破处风来叫得酸。\n若是诗人都富贵，遣谁忍饿遣谁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过望亭六首 其一","author":"杨万里","text":"望亭昔岁过归船，柳为蹁跹杏为妍。\n今日溪山浑似旧，雪芦风荻两萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过阊门溪","author":"杨万里","text":"黟祁二邑水分源，到此同流怒政奔。\n忽值两山盘作峡，更峨双石插为门。\n中通翠浪才容线，仰看青天细似盆。\n滟滪瞿唐姑未问，祗经此险已销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过黄巢矶","author":"杨万里","text":"黄巢矶与白沙滩，只是闻名已胆寒。\n自笑南来三换岁，一年一度犯惊湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过景星山山顶一石孤立又名突星山","author":"杨万里","text":"山头孤立玉竛?，天上何年堕景星。\n四面万峰非不峻，如何只是一峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过新开湖五首 其五","author":"杨万里","text":"远远人烟点树梢，船门一望一魂消。\n几行野鸭数声雁，来为湖天破寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过新开湖五首 其四","author":"杨万里","text":"一鸥得得隔湖来，瞥见鱼儿眼顿开。\n只为水深难立脚，翩然飞下却飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过新开湖五首 其三","author":"杨万里","text":"白苇黄芦尚带秋，长风远水几时休。\n愁人对著君休问，不是愁人也作愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过新开湖五首 其二","author":"杨万里","text":"渔郎艇子入重湖，老眼殷勤看著渠。\n看去看来成怪事，化为独雁立横芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过新开湖五首 其一","author":"杨万里","text":"奇哉万顷水精盆，一线青罗缘却唇。\n只有向南接天去，更和一线也无痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过鼓鸣林小雨二首 其二","author":"杨万里","text":"下泷小舫戴尖篷，未论千峰与万峰。\n只是舟人头上笠，也堪收入画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过鼓鸣林小雨二首 其一","author":"杨万里","text":"淅淅船篷雨点声，疏疏江面縠纹生。\n石峰斗起三千丈，身在假山园里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过翥山渡","author":"杨万里","text":"千重溪水万重山，半月深行井底天。\n井外还来天大在，江心一眼四无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过蕉坑","author":"杨万里","text":"枫叶乾馀尚小红，苕花飞尽不留茸。\n经旬欲雪还无雪，只作清寒恼杀侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过霸东石桥桐花尽落","author":"杨万里","text":"老去能逢几个春，今年春事不关人。\n红千紫百何曾梦，压尾桐花也作尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问月二首 其二","author":"杨万里","text":"月入云中去，呼他不出来。\n明宵教老子，何面更相陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问月二首 其一","author":"杨万里","text":"月色幸自好，元无半点云。\n移床来一看，云月两昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问春二首 其二","author":"杨万里","text":"元日春回不道迟，匆匆未遣万花知。\n道山堂下红梅树，速借晴光染一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问春二首 其一","author":"杨万里","text":"今岁春归不小心，合将消息报园林。\n苏公堤上千株柳，二月犹悭半缕金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馀干溯流至安仁","author":"杨万里","text":"半篙新涨满帆风，两岸千山一抹中。\n惭愧棹郎能袖手，若非袖手更无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冻蝇","author":"杨万里","text":"隔窗偶见负暄蝇，双脚挼挲弄晓晴。\n日影欲移先会得，忽然飞落别窗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初九夜月二首 其二","author":"杨万里","text":"也知月姊是天姝，天上人间绝世无。\n雾刷云撩何不可，却须插一水精梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初九夜月二首 其一","author":"杨万里","text":"珍重姮娥住广寒，不餐火食不餐烟。\n秋空拾得一团饼，随手如何失半边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入淮河四绝句 其二","author":"杨万里","text":"刘岳张韩宣国威，赵张二相筑皇基。\n长淮咫尺分南北，泪湿秋风欲怨谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入淮河四绝句 其四","author":"杨万里","text":"中原父老莫空谈，逢著王人诉不堪。\n却是归鸿不能语，一年一度到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入淮河四绝句 其一","author":"杨万里","text":"船离洪泽岸头沙，入到淮河意不佳。\n何必桑乾方是远，中流以北即天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入淮河四绝句 其三","author":"杨万里","text":"两岸舟船各背驰，波痕交涉亦难为。\n只馀鸥鹭无拘管，北去南来自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入筠州界高冈铺","author":"杨万里","text":"千尺霜松夹道周，国初凉伞至今留。\n筠州旧是朝天路，六十年来行信州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初四日晨炊横翠亭","author":"杨万里","text":"近看三峰失一峰，其馀都与昨来同。\n多情横翠亭前玉，伴我同行两日中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其八","author":"杨万里","text":"自暴群书旧间新，净揩白醭拂黄尘。\n莫羞空腹无丁字，且免秋阳晒杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其七","author":"杨万里","text":"七月初头六月阑，老夫日醉早禾酸。\n莫将煮吃只生吃，更泄天机向达官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其六","author":"杨万里","text":"甑头云子喜尝新，红嚼桃花白嚼银。\n笑杀官人浪驩喜，村人残底到官人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其二","author":"杨万里","text":"蚤起翻成坐睡昏，鹊声唤我步前轩。\n竹扉日隙针来大，射壁千千弹子痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其九","author":"杨万里","text":"独对秋筠倒晚壶，喜无吏舍四歌呼。\n柳梢一壳兹缁滓，屋角双斑谷古孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其一","author":"杨万里","text":"暑入秋来午更强，风排雨遣晓差凉。\n如何绕砌千枝蕙，只是开门一阵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其三","author":"杨万里","text":"暑后花枝输了春，杂英小巧亦忺人。\n素馨解点粉描笔，金凤爱垂鸡下唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其十一","author":"杨万里","text":"卓午从它火伞张，先生别有睡为乡。\n竹床移遍两头冷，瓦枕翻来四面凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋戏作山居杂兴俳体十二解 其四","author":"杨万里","text":"风骚开国胙寒岩，劳绩批书课翠岚。\n梨子要肥千取百，菊苗每摘一生三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋行圃四首 其四","author":"杨万里","text":"落日无情最有情，遍催万树暮蝉鸣。\n听来咫尺无寻处，寻到旁边却不声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋行圃四首 其三","author":"杨万里","text":"花梢飞下两鸣鸠，欲住还行行复留。\n拾得来禽吞不得，啄来啄去竟成休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋行圃四首 其二","author":"杨万里","text":"小小园亭亦自佳，晚云过雨却成霞。\n烂开栀子浑如雪，已熟来禽尚带花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋行圃四首 其一","author":"杨万里","text":"今年六月不胜凉，七月炎蒸不可当。\n一阵秋风初过雨，个般天气好烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋暮雨","author":"杨万里","text":"禾穟轻黄尚浅青，村舂已报隔林声。\n忽惊暮色翻成晓，仰见双虹雨外明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其四","author":"杨万里","text":"从教节序暗相催，历日尘生懒看来。\n却是石榴知立夏，年年此日一花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其九","author":"杨万里","text":"更无一个子规啼，寂寂空山花自飞。\n啼得春归它便去，元来不是劝人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其二","author":"杨万里","text":"瑞香端合谱离骚，有子传芳韵亦高。\n失却薰笼红锦被，化为矮树紫樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其六","author":"杨万里","text":"密有花红绿刺长，似来作伴石榴芳。\n金樱身子玫瑰脸，更吃饧枝蜜果香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其十一","author":"杨万里","text":"狭斜只解赏春红，秋菊冬梅不负公。\n我道四时俱富贵，一杯催唤藕花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其十二","author":"杨万里","text":"王家麈柄绿琼香，萱草偷来柄更长。\n藏却柿红缨拂子，菖蒲节里放风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其一","author":"杨万里","text":"莲叶头巾道样裁，仙桃扇子午时回。\n扑蝇堕地犹能旋，闭阁生尘底处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事十二解 其三","author":"杨万里","text":"百日田乾田父愁，只销一雨百无忧。\n更无人惜田中水，放下清溪恣意流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏病起晓步东园二首 其二","author":"杨万里","text":"病起乌藤强自扶，三三径里晓晴初。\n莺声只在花梢近，行去行来不见渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏病起晓步东园二首 其一","author":"杨万里","text":"低枝碧李压人头，过雨黄梅满道周。\n红日漏云初试暑，绿阴酣露已偷秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居初夏午睡起二绝句 其一","author":"杨万里","text":"梅子留酸软齿牙，芭蕉分绿与窗纱。\n日长睡起无情思，闲看儿童捉柳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初离常州夜宿小井清晓放船三首 其三","author":"杨万里","text":"春旱愁人是去年，如今说著尚心酸。\n篙师莫遣船迟著，见说苏州好牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初离常州夜宿小井清晓放船三首 其二","author":"杨万里","text":"晨炊只煮野蔬汤，更拣鲜鱼买一双。\n病眼未能禁晓日，西窗莫闭闭东窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初离常州夜宿小井清晓放船三首 其一","author":"杨万里","text":"拦街父老不教行，出得东门已一更。\n一事新来偏可意，梦中闻打放船钲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初寒","author":"杨万里","text":"欲雨还晴又作阴，添衣已减却重寻。\n绝知不晚新寒到，更用先来破客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"含笑","author":"杨万里","text":"大笑何如小笑香，紫花不似白花妆。\n不知自笑还相笑，笑杀人来断杀肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨","author":"杨万里","text":"归舟昔岁宿严陵，雨打疏篷听到明。\n昨夜茅檐疏雨作，梦中唤作打篷声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其七","author":"杨万里","text":"望帝啼春夜更多，不知蝉意却如何。\n还来入夜便无语，明日将诗理会它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其三","author":"杨万里","text":"渠与斜阳有底雠，千冤万恨诉清秋。\n更从谁子做头抵，只放斜阳不落休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其八","author":"杨万里","text":"罪过渠侬商略秋，从朝至暮不曾休。\n莫嫌入夜还休去，自有寒蛩替说愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其五","author":"杨万里","text":"说露谈风有典章，咏秋吟夏入宫商。\n蝉声无一些烦恼，自是愁人枉断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其一","author":"杨万里","text":"披襟散发晚风清，细细孤斟缓缓行。\n道是江东官事冗，绿杨阴里听蝉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其四","author":"杨万里","text":"一壳空空纸样轻，风前却有许多声。\n叫来叫去浑无事，叫到诗人白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其六","author":"杨万里","text":"乍来忽去为谁忙，短气抽教强作长。\n道是渠侬声不歇，一吟一续万低昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听蝉八绝句 其二","author":"杨万里","text":"一只初来报早秋，又添一只说新愁。\n两蝉对语双垂柳，知斗先休斗后休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]