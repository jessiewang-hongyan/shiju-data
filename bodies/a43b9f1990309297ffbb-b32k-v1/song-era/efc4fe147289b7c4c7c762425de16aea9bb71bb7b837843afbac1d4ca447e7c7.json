[{"title":"晚春有感答才夫上巳之作二首 其一","author":"李流谦","text":"牡丹犹欲扳春住，开到荼蘼春遂去。\n黄蜂白蝶太痴生，抵死嗔风复嗔雨。\n少年世味如蜜甜，迩来唯觉食无盐。\n只应馀习扫未尽，一春病酒常厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其一","author":"李流谦","text":"昨夜临溪一树开，人言应与雁俱回。\n霜葩只在寒梢上，却是春风自去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其三","author":"李流谦","text":"照影月斜寒濑浅，吹香风细夜帘疏。\n萼绿华来谁得见，借君云佩与霞裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其四","author":"李流谦","text":"似嫌洁白太清寒，故著微红略破颜。\n俯仰聊同閒草木，不妨游戏住人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其五","author":"李流谦","text":"道人一味著幽禅，谁遣天花到眼边。\n乱插铜瓶看尽日，向人终是好因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其二","author":"李流谦","text":"殷勤蝶障与蜂遮，一点幽香不许赊。\n岁岁相逢只如此，问花羞我我羞花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富池罗汉院有钱希白中大科赴信州别驾时所题诗有陈朝柏二绝句 其一","author":"李流谦","text":"圣世能收晁董策，孤舟来唱鄂君歌。\n一看献纳元台表，可特脩名在异科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富池罗汉院有钱希白中大科赴信州别驾时所题诗有陈朝柏二绝句 其二","author":"李流谦","text":"皮肤脱落馀真实，须鬣苍浪阅岁华。\n突兀一根丛棘里，不知几见后庭花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富池祠 其一","author":"李流谦","text":"卷雪楼高首重回，江东那得许人材。\n只应汉鼎三分后，便有英雄一聚来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富池祠 其二","author":"李流谦","text":"萧何识信在逡巡，此事从来妙若神。\n不是将军难著眼，正应黄祖是凡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登宝公塔 其二","author":"李流谦","text":"三尺杖头閒一把，兴亡随分百馀年。\n我来但爱松风好，觅得僧窗一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登宝公塔 其一","author":"李流谦","text":"树老巢翻鹰亦化，锡飞近地鹤犹惊。\n太平寺主今安在，潮打山围建业城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新滩三首 其三","author":"李流谦","text":"蜀船南来去未休，吴船西上到沙头。\n人生能著几两屐，三峡风烟替往愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新滩三首 其二","author":"李流谦","text":"渔父长歌招屈子，女儿高髻学昭君。\n虽存九辨欲谁继，便有琵琶那忍闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新滩三首 其一","author":"李流谦","text":"丛祠风俗尊淫祀，滩户生涯利客船。\n倏忽未兴酬德意，不知曾有此山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谯令以视堰绝句见示次其韵 其一","author":"李流谦","text":"疲氓糠覈自能肥，一个何曾吏扣扉。\n凤指翠梧求友集，蝗无绿野蔽天飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲步四绝句 其一","author":"李流谦","text":"去岁南乘下峡舟，西归仍此听巴讴。\n题桥亦浅丈夫事，未赎当年犊鼻羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲步四绝句 其二","author":"李流谦","text":"数峰遥指峡中山，渐喜岷峨气象还。\n万里虎头华发将，只求生入玉门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲步四绝句 其三","author":"李流谦","text":"一樽相属慰蹉跎，酒债街头苦不多。\n饶舌小僧休口藐，年来何事不消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲步四绝句 其四","author":"李流谦","text":"烧纸船头祭水神，杯盘灯火夜青荧。\n老巫得珓舟人喜，想象灵君醉未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题富池罗汉院","author":"李流谦","text":"竹深树老小禅关，关对江淮千古山。\n万舶堆中江上乐，时时箫鼓寺前还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薛公肃访山中偶出不值公肃留诗次其韵 其一","author":"李流谦","text":"一舸初从帝所还，綵衣照日眩斓斑。\n今君已出云天近，我尚无钱可买山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薛公肃访山中偶出不值公肃留诗次其韵 其二","author":"李流谦","text":"紫极朝归谢往还，新篇落笔烂彪斑。\n乌藤拈起都閒事，且看西湖处处山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕马逸已而获之","author":"李流谦","text":"门外喧呼惊失马，天边未暇问牵牛。\n报恩不作雀衔玉，快意遂为鹰脱韝。\n他日盖帷吾已许，暮年绳勒汝应羞。\n故知多忆横门道，定厌青丝久络头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七曲祠","author":"李流谦","text":"天生绝代英，梦想见仪形。\n桂殿风凝绿，苔宫雨护青。\n云雷通翕忽，洞穴閟阴灵。\n只有丹心苦，聊将托杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日同诸公自马溪登道宿无为","author":"李流谦","text":"尘埃眯目浸填胸，日日青山在梦中。\n改岁人家无一事，并游文社有诸公。\n招提夜语惊山鬼，野店春沽醉病翁。\n绿坞红村谁境界，自凭好句占东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入峡闻滩声","author":"李流谦","text":"山稠知峡近，今夜听滩声。\n灯映舟人语，江空宿鸟惊。\n不眠共展转，独语记平生。\n自觉无多愧，微堪答父兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十五日失舟","author":"李流谦","text":"船头饱饭看扬舲，忽作翻浆不反瓶。\n万死一生真是幸，九江三峡未尝经。\n尚收弃物乾坤大，薄恃阴功祖考灵。\n忧患偶来须理遣，可能为汝更星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月十五日同黄大博出城","author":"李流谦","text":"休沐来寻九里松，故因晴日觉春容。\n寒馀浅水红衣尽，淡抹轻烟紫翠重。\n倦向山僧谈白叶，归从逋客醉黄封。\n尘埃眯目成深省，何处招提鸣晓钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次大人韵","author":"李流谦","text":"卜筑城南几岁华，满川烟雨富桑麻。\n武陵未用逃秦俗，盘谷从来属李家。\n横拓小溪通画楫，剩栽疏竹间梅花。\n更饶一斗诗千首，不信閒居乐可涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵彦博游无为寺二首 其二","author":"李流谦","text":"东风力弱未扬埃，密泛丛兰有意哉。\n可是伸眉须酒满，只应弹指又花开。\n吹毛句妙无人领，击钵诗工著底催。\n照水只愁羞冕绂，勋名盖世亦时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵彦博游无为寺二首 其一","author":"李流谦","text":"灵蜕岿然谢垢埃，焚香却立叹奇哉。\n自从新岁门常掩，不见青山眼懒开。\n飞观千楹孤鸟堕，斋盂万指晓鲸催。\n亦知空劫已前事，浪说十生曾去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上牛头山","author":"李流谦","text":"马首多经历，牛头到未尝。\n平川成岌嶪，诸刹寄微茫。\n像设尊千古，香灯走四方。\n来陪僧粥饭，此愿几时偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下岩","author":"李流谦","text":"扫云跻绝磴，倚竹破苍苔。\n冻涩冰帘捲，尘侵佛阁摧。\n僧残无给侍，墨妙杂舆台。\n就使匆匆去，犹胜不一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久留芜湖待巨卿仲甄不至","author":"李流谦","text":"吴波晴浸夕阳红，一语丁宁北去鸿。\n颇觉淹留添发白，不妨羞涩剩囊空。\n枕头靠睡禁长日，舸背占旗惜便风。\n想得家山俱在梦，亦应烦闷略相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小息","author":"李流谦","text":"倦征当日午，小息散腰顽。\n索酒初随意，题诗自破颜。\n不须通姓字，聊欲赏江山。\n放荡郊园乐，于兹稍稍还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中遣兴五首 其五","author":"李流谦","text":"嗣圣承尧禹，图书未见之。\n兵威轻破竹，天意决占龟。\n燕雀甘藜莠，蛟龙或沼池。\n但令无战伐，贫贱亦何辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中遣兴五首 其四","author":"李流谦","text":"日薄愔愔热，江浑漫漫流。\n蝉为合尖响，燕作掺裾愁。\n枣熟成群打，禾登扫地收。\n展眉欣一饱，八月又防秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中遣兴五首 其三","author":"李流谦","text":"游宦初聊尔，归来亦畅然。\n低回簿领缚，惭愧斗升牵。\n元亮八十日，哥奴十九年。\n人生重名节，富贵疾云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中遣兴五首 其二","author":"李流谦","text":"烂饮无贤圣，高歌有鬼神。\n梵书浑味著，药裹自心亲。\n朋友居山少，知闻到市新。\n孤舟怯风浪，不出又经旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中遣兴五首 其一","author":"李流谦","text":"数月携家住，幽栖引兴长。\n客中容懒散，梦里过炎凉。\n收网觉鱼贱，酌泉知酒香。\n主人真好事，诗债数能偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰都驿呈任子厚诗二首 其二","author":"李流谦","text":"书坏无全牍，衣濡有裂缯。\n倦梳晨起发，祗曲昼眠肱。\n客路行将了，家山唤得应。\n焚香谢仙佛，宵梦已先凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰都驿呈任子厚诗二首 其一","author":"李流谦","text":"三家笑荒陋，十日寄萧条。\n破户无人掩，寒炉折竹烧。\n青灯不废卷，白酒未空瓢。\n伴我能于此，他年定久要。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀 其二","author":"李流谦","text":"衫似荷枯嫌绊缚，屋如斗大费支撑。\n寒蔬日日同僧饭，拄杖时时伴鹤行。\n聊托莼鲈非厚味，漫言松菊本真情。\n山中亦有閒田地，可惜离家久不耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事 其三","author":"李流谦","text":"能閒无健羡，可饱即珍烹。\n成我耕桑计，欣儿课诵声。\n横戈真不武，敛袂亦难平。\n苦欲劳工宰，此生无我生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事 其二","author":"李流谦","text":"唯有江郊好，能消畏日长。\n晚杯荷露重，午枕竹风凉。\n溪鹭閒无敌，庭萱恨易忘。\n翩翩孤蝶意，只是托幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事 其四","author":"李流谦","text":"塞色旌旗薄，边声鼓角喧。\n三军正悲愤，中国固雄尊。\n障戍争襟险，朝廷护本根。\n古来挟策者，谈笑整乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"李流谦","text":"五十光阴两岁过，头颅閒处自摩挲。\n隔篱山影谁招去，满树梅花独占多。\n物色年华同我老，蜂情蝶思柰渠何。\n少时一剑明秋水，放在尘中久不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事 其一","author":"李流谦","text":"饱饭将何适，携筇登翠微。\n江长仍曲折，树远欲依稀。\n煮井未休汲，田家初掩扉。\n惊心崖路险，隔岸唤船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五百罗汉洞","author":"李流谦","text":"五百云霞侣，同胞生佛家。\n不贪三昧酒，共驾一乘车。\n猿馈霜馀果，僧烹粥后茶。\n我来无供养，唯读妙莲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"井上即事","author":"李流谦","text":"九陌黄尘涴客裾，随人亦恐到茅庐。\n朝朝山色供凭槛，夜夜溪声伴读书。\n可要功名惊宇宙，分知骨相合樵渔。\n晚来小艇冲烟出，江上有人争卖鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆尽半月之力仅得五诗而和仲落笔成十章俊哉予所甚畏也勉作二章答和仲三章述怀庶满其数云 其二","author":"李流谦","text":"慷慨挥毫际，仓黄展卷初。\n少宽诛寇檄，已草纳降书。\n恃胜防君失，输筹笑我疏。\n班龙落谁手，芝草费人锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆尽半月之力仅得五诗而和仲落笔成十章俊哉予所甚畏也勉作二章答和仲三章述怀庶满其数云 其一","author":"李流谦","text":"向来得秘藏，著意国风初。\n一字呕心出，十篇随手书。\n天成新句熟，月煅古人疏。\n长铩非君敌，区区恃棘锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以双笔赠照老用前韵","author":"李流谦","text":"三窟驱除后，千毫束缚初。\n得封才五等，进位合中书。\n炯炯银钩粲，翩翩薤叶疏。\n恶诗同遣赠，荒类要君锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元质苦留过重阳且约泛舟观泉二首 其二","author":"李流谦","text":"久客相看好，思归得去不。\n深惭楚醴设，更作贾胡留。\n岁闰菊花早，霜清竹叶秋。\n尊前闻见在，不拟说閒愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元质苦留过重阳且约泛舟观泉二首 其一","author":"李流谦","text":"舟行十里远，山出一泉清。\n为景寻几遍，将诗赌欲赢。\n江清浑玩著，酒好易支撑。\n半世无功业，狂歌任性情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元质携客渡江饮于村店","author":"李流谦","text":"一篙寒碧碎鳞鳞，数尺孤舟仅著身。\n江水煮鱼还地脉，瓦盆盛酒见天真。\n颇容老子赊閒日，聊与青山作主人。\n不用樽前罗粉黛，远峰元解作眉颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午饭高桥院","author":"李流谦","text":"招提下马憩逡巡，野饭亲烹涧底芹。\n二月韶华听啼鸟，百年心事信行云。\n不禁烈日花光薄，更抹微烟草色薰。\n老衲未知风木恨，向人犹说故将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太平宫","author":"李流谦","text":"一马腾腾上翠微，松风瑟瑟解吹衣。\n故宫乱后仍华壮，使者年来果是非。\n何日身能床蕊笈，只今心自托金徽。\n两林不到犹遗恨，落照衔山劝客归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜江上作","author":"李流谦","text":"月与清湍一样流，不妨夜色尚淹留。\n已将船作青天坐，安得江为大白浮。\n恐有幽人钓寒渚，正须横吹起危楼。\n年来身世无拘管，便是波间一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水后过淮安金堂皆非旧路","author":"李流谦","text":"向来茅屋半惊湍，叹息流亡久未还。\n已觉重行非故道，只应无恙是青山。\n旋蓝偃岳元常事，深谷为陵亦等閒。\n衲被蒙头都莫问，未当居士一分顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王正卿何道夫和嘉字韵诗至数十道夫赠予数篇晋卿亦赠一篇因次其韵凡六首 其六","author":"李流谦","text":"洗甲倾河渐可涯，北征犹记宋元嘉。\n石刘姓字非图箓，轩喾乾坤自我家。\n原上鼓旗寒朔吹，日边诏令掞春华。\n舞干元是吾皇事，不必将军号虎牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王正卿何道夫和嘉字韵诗至数十道夫赠予数篇晋卿亦赠一篇因次其韵凡六首 其五","author":"李流谦","text":"越王飞观插天涯，小异何人识孟嘉。\n别后文章尤造理，向来学术自成家。\n诸生荐士皆时论，此道逢辰固国华。\n行脱羁衔谢拘迫，云窗归理万签牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王正卿何道夫和嘉字韵诗至数十道夫赠予数篇晋卿亦赠一篇因次其韵凡六首 其四","author":"李流谦","text":"戏论无涯与有涯，委心冲漠固清嘉。\n衣裳草木元非织，窟宅云霞岂是家。\n瞪视恐同高长史，神交宜伴老南华。\n只应一念超尘劫，安用神浆夜绕牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王正卿何道夫和嘉字韵诗至数十道夫赠予数篇晋卿亦赠一篇因次其韵凡六首 其三","author":"李流谦","text":"清言元论极边涯，南渡风流继永嘉。\n中散一生慵作吏，渊明无日不思家。\n悠悠官路降胸臆，苒苒年光侮鬓华。\n人说乱蛙胜鼓吹，欲将藜杖比高牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王正卿何道夫和嘉字韵诗至数十道夫赠予数篇晋卿亦赠一篇因次其韵凡六首 其二","author":"李流谦","text":"放浪山颠与水涯，藜羹有味荐珍嘉。\n根尘要识元非我，言语悬知未到家。\n霜渚澄波空涨潦，风林脱木净浮华。\n公明领取休论价，处事何须更作牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王正卿何道夫和嘉字韵诗至数十道夫赠予数篇晋卿亦赠一篇因次其韵凡六首 其一","author":"李流谦","text":"从君未省涉津涯，白璧明珠屡拜嘉。\n一吸湖江真大国，仅除风雨亦寒家。\n簿书笑我忙官事，笔砚饶君管物华。\n世味可能争腊毒，馁蛟馋兕漫摇牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长芦次德茂韵","author":"李流谦","text":"捲雪奇观千丈澜，诗情撩动未应悭。\n却收浙右三年梦，仍对淮南数尺山。\n靴板随人元自漫，田园觅去正须閒。\n风樯独立看飞燕，家在孤云落照间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]