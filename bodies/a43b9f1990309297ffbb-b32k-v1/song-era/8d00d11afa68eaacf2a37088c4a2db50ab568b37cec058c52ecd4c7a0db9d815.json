[{"title":"宋传道挽词二首 其二","author":"韩元吉","text":"留落东州彦，相期幸卜邻。\n筒诗馀唱永，樽酒记情亲。\n旧国归无日，诸乡见有人。\n佳城千载恨，雪涕楚江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋传道挽词二首 其一","author":"韩元吉","text":"德履无遗恨，弦歌有去思。\n养亲三釜乐，作郡十年迟。\n壮志沈黄壤，英游闭赤墀。\n丰碑颂遗爱，谁为继罗池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李子永惠道中诗卷","author":"韩元吉","text":"踏雪冲寒遍几州，岂妨乘兴作清游。\n风横白鹭歌琼树，月满青山问钓舟。\n梦绕征途浑历历，老谙世事总悠悠。\n尘埃鞅掌君休恨，自有诗轻万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李寿翁侍郎挽词","author":"韩元吉","text":"同解铨衡并把麾，五年相望楚江湄。\n邻墙会面尝谈易，吏选偷閒更说诗。\n北客遭逢人共叹，南州流转事难知。\n投簪自有江湖志，云白天青泪满颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李彭元携曾吉甫诗卷数帖见过","author":"韩元吉","text":"十年松竹暗茶山，君有诗声旧将坛。\n食荠谁如东野苦，无毡不奈广文寒。\n闭门久咏高轩过，弹铗今嗟行路难。\n我亦凋零旧宾客，遗编聊共拂尘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨待制挽词","author":"韩元吉","text":"妙龄著足道家山，壮岁升华玉笋班。\n千里麾符才假手，几年香火竟投閒。\n诗书坐使家声大，簪绂谁令寿历悭。\n太傅功名有遗恨，鹓雏凋落泪频潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒居遣兴","author":"韩元吉","text":"著雨柔桑暗，吹风小麦齐。\n江深涵日净，野阔并云低。\n车马能相问，琴书故可携。\n村村花自好，不奈子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆子逸惠桃花戏赠","author":"韩元吉","text":"故人招我千山里，也有仙葩巧送春。\n麝馥染衣金缕重，酒红生粉玉肌匀。\n洛城景物知谁纪，寒食风光触处新。\n莫把天香调行客，晓妆留与绿窗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆务观赴阙经从留饮","author":"韩元吉","text":"溪岸风高霜作棱，杯盘草草对青灯。\n已甘盐菜待梁柳，况有酒浆延杜陵。\n岁晚鬓毛纷似雪，天寒门巷冷于冰。\n春风稳送金闺步，看蹑鳌山最上层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和御制秋晚曲宴诗","author":"韩元吉","text":"巍巍舜治浃嘉生，宴俎丰年万宝成。\n禁幄云深开晓色，上林风迥起秋声。\n威加鼍鼓雷霆转，喜动龙旂日月明。\n应手神珠看电击，旄头消尽铁山平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周元特詹事挽词二首 其二","author":"韩元吉","text":"黄发趋严诏，青宫启太微。\n园公方入侍，疏傅已言归。\n奏牍三千在，流年七十稀。\n无从奠鸡酒，老疾只沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周元特詹事挽词二首 其一","author":"韩元吉","text":"道学尊闾里，衣冠见伟人。\n鸡群真野鹤，麇角目祥麟。\n谠论追前辈，清时识诤臣。\n他年激贪懦，风动霅溪滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周济美挽词","author":"韩元吉","text":"乃翁持橐旧知名，两郡分符见典型。\n禁闼方应驰俊步，中台俄忽随修翎。\n故人零落风前叶，北客漂流雨后萍。\n白马素车三巷路，泪兼腊雪洒林坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和同僚贺雪应祈","author":"韩元吉","text":"腊近春临雪意迟，褰衣敢惮走灵祠。\n夜听小雨犹倾耳，晓看群山顿展眉。\n好句悬知得冰柱，香醪试为压羔儿。\n便应风月台中客，不减梁园赋就时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐有感寄子云","author":"韩元吉","text":"风景新亭旧往还，谁能举目较河山。\n宦情老去秋多感，官事忙时夜始閒。\n窗外槁梧风瑟缩，竹间乱石雨淙潺。\n青灯已作江湖梦，同约归期早晚间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐闻窗下水声","author":"韩元吉","text":"书史悬知伴此生，敢求身外百年名。\n青灯又暗吹窗雨，流水长闻入夜声。\n玩世久忘荣辱累，定交谙尽死生情。\n翛然隐几焚香坐，不独心清境亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宿斜溪闻杜鹃","author":"韩元吉","text":"船窗初日弄晖晖，起坐胡床自揽衣。\n无数青山随岸改，几声幽鸟唤人归。\n鸥盟好在重游戏，蝶梦惊回果是非。\n便拟走书闻稚子，归来同买钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"季元衡寄示三池戏藁","author":"韩元吉","text":"文彩风流冠一时，三池聊作凤凰池。\n新诗到处传桐叶，丽唱他年满竹枝。\n归梦故应怀古括，清谈还喜对峨眉。\n玉堂待草山东诏，解缆春江莫放迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝林院次韩廷玉韵","author":"韩元吉","text":"山绕孤城水拍空，惜无残月照疏桐。\n江干云断夜来雨，木末凉生秋到风。\n六代兴亡知寺古，老禅神异载碑丰。\n诗成极目苍茫里，惜别情怀醉梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"易安斋","author":"韩元吉","text":"紫陌犹千里，禅房自一家。\n翠深穿小径，红湿动迷花。\n络石寒梢乱，攲岩碧干斜。\n春江夜来雨，如为洗烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松江别范至能朱伯阳 其二","author":"韩元吉","text":"吴歈湾月韵江船，屈指同行二十年。\n胜日五湖看老矣，倦游双鬓各苍然。\n拟寻诗酒平生社，未了尘埃薄宦缘。\n后夜西风相忆梦，琵琶亭下水笼烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松江别范至能朱伯阳 其一","author":"韩元吉","text":"弹铗功名易白头，归欤未办五湖舟。\n送君与我皆为守，到处逢山且纵游。\n薄日连云千幛晓，斜风吹雨一江秋。\n买鱼斫鲙垂虹上，更为今年好景留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范泉州挽词二首 其二","author":"韩元吉","text":"玉节江南道，铜符海上州。\n登车人自化，截镫士争留。\n不作田园计，长怀世事忧。\n秋风闭黄壤，谁为子孙谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范泉州挽词二首 其一","author":"韩元吉","text":"淡墨标名早，飞腾仅石渠。\n学传外家蕴，论合古人馀。\n议本枫宸疏，评和相第书。\n忠言与危行，青史未应虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采箬亭","author":"韩元吉","text":"山缭重城水拍堤，雨晴秋浦静相宜。\n新篁弄日千竿玉，纹簟披风八尺漪。\n坐对芳洲端自乐，兴来小艇亦频移。\n他年稳侍蓬莱殿，聊记高亭一笑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中同邹德饭白云庵 其一","author":"韩元吉","text":"小雨不成雪，冻云犹没山。\n若无官事缚，聊傍野僧閒。\n浊酒间何阔，清游阻且艰。\n相看成冷淡，得句不空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中同邹德饭白云庵 其二","author":"韩元吉","text":"懒惰已成癖，幽寻湖上台。\n应知千里近，动作半年来。\n一径草仍碧，两山梅未开。\n犹怜冲雨湿，路入乱云堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中望灵山呈明远","author":"韩元吉","text":"骑曹公事日纷纷，荀令香炉欲罢薰。\n冷雨定知还作雪，好山无奈只藏云。\n看花便觉名何用，劝酒谁能耳不闻。\n岁晚官仓尘满眼，只应清坐独输君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后睡起有怀","author":"韩元吉","text":"菊枝萱草乱庭隅，旋卷疏帘卧看书。\n枕簟凉生秋雨后，轩窗睡足晚风初。\n官閒自爱门无辙，计拙犹惭食有鱼。\n莫遣功名心易老，只应湖海气难除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南剑道中","author":"韩元吉","text":"唤渡春潭侧，堤弯踏晓晴。\n回舟动山影，映日见鱼行。\n墅远孤烟出，江深白鹭明。\n尘劳消底计，对此觉身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故太师和王挽诗三首 其三","author":"韩元吉","text":"甲第神京冠，王封异姓优。\n风云开杰阁，水月转芳洲。\n种玉阶庭盛，挥金族绪周。\n诸郎自持橐，衮衮尚公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故太师和王挽诗三首 其二","author":"韩元吉","text":"淮右偏师出，江津督府开。\n橐皋贼阵蹙，瓜步敌锋摧。\n宝剑畴能举，神旗怅莫回。\n悲风苕水路，千载有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故太师和王挽诗三首 其一","author":"韩元吉","text":"宿卫登环尹，荣恩四十春。\n威名传瀚海，功烈上麒麟。\n却敌凝山岳，临机妙鬼神。\n中兴奉朝请，劳旧总无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故资政殿大学士枢密洪公挽词二首 其二","author":"韩元吉","text":"甲第湖山美，人知小隐名。\n天方开乐土，地忽起佳城。\n秘殿疏殊渥，珍台锡异荣。\n勋劳才右府，曾未陟魁衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故资政殿大学士枢密洪公挽词二首 其一","author":"韩元吉","text":"世学推东楚，文名冠异科。\n弟兄联玉笋，父子擅金坡。\n筹幄渊谋在，陪京惠爱多。\n无因奠鸡酒，清泪洒江波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故运使直阁少卿刘公挽词","author":"韩元吉","text":"清时得路每投閒，垂上甘泉玉笋班。\n借箸几看趋魏阙，请缨常欲度天山。\n放怀侠气千夫上，抵掌高谈一梦间。\n使节尘生人共惜，朔风吹泪太湖湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故宫使参政观文钱公挽词二首 其二","author":"韩元吉","text":"甲第依香火，栖心不离禅。\n颐神虽绿野，纪绩自凌烟。\n荣观丹丘外，真游弱水边。\n佳城近刘阮，觉路有飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故宫使参政观文钱公挽词二首 其一","author":"韩元吉","text":"忠孝全家法，清修极道腴。\n雍容调庶政，谈笑靖边隅。\n许国心犹壮，安时貌不枯。\n脩龄才七十，谁为隔黄垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故宫使待制侍郎陈公挽词二首 其二","author":"韩元吉","text":"结绶同郎省，幽居愿卜邻。\n撄宁良自适，坎壈遂无伸。\n壮志嗟犹在，交情晚更亲。\n秋风敬亭路，西望一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故宫使待制侍郎陈公挽词二首 其一","author":"韩元吉","text":"政誉京江口，威名岘首山。\n折冲章贡外，制胜汉淮间。\n零落金闺彦，凄凉玉笋班。\n文章与功业，未老竟长閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故秦国太夫人邓氏挽词","author":"韩元吉","text":"诸父联丞弼，元夫总化钧。\n光华人莫并，恭俭古无伦。\n沐国三茅土，仪家五凤麟。\n涂车闾里恸，矧此故园亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故致政参政大资张公挽词三首 其三","author":"韩元吉","text":"忆荷公车荐，多惭识面求。\n惊心异生死，倒指十春秋。\n国士怀青眼，门生慨白头。\n束刍催老泪，东与大江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故致政参政大资张公挽词三首 其二","author":"韩元吉","text":"益部烦分陕，金陵起御戎。\n逢时身已病，忧国志弥忠。\n廊庙吁谟外，丘园梦寐中。\n弹冠与归老，盛节有初终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故致政参政大资张公挽词三首 其一","author":"韩元吉","text":"海内推耆德，朝端蔼直声。\n金辉馀烈火，玉价自连城。\n正色消群枉，高风耸后生。\n君王问黄发，犹仅陟台衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故致政提刑少卿方公挽词","author":"韩元吉","text":"筹策沾荣誉最贤，青云回步接英躔。\n请缨莫遂终军志，投绂方期卫武年。\n原隰观风频玉节，省台联秩近甘泉。\n一舟五鹤符佳梦，陂水成湖问葛仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故端明尚书汪公挽词二首 其二","author":"韩元吉","text":"献纳高门地，君王识履声。\n闽山歌惠政，蜀道憺威名。\n逝矣嗟天命，谁欤总国成。\n弟兄无六十，殄瘁亦堪惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故端明尚书汪公挽词二首 其一","author":"韩元吉","text":"未冠登华选，高文动汉廷。\n持身严矩席，虑世炳丹青。\n庶府咨沿革，诸儒见典型。\n空嗟廊庙略，不上鼎彝铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故赠太师丞相文恭陈公挽词三首 其三","author":"韩元吉","text":"凛凛循良吏，休休一介臣。\n投艰推宇量，禦侮赖精神。\n给侍恩虽渥，怀归志莫伸。\n平泉开甲第，花木未经春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故赠太师丞相文恭陈公挽词三首 其二","author":"韩元吉","text":"扶疾祗严诏，邦基整屡危。\n紫宸朝奏事，黄阁暮兴悲。\n德望仪千载，恩荣冠一时。\n石龟山下路，谁为记丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故赠太师丞相文恭陈公挽词三首 其一","author":"韩元吉","text":"拱揖消狂寇，从容奉两宫。\n临危几谢傅，忍事实娄公。\n陶冶无偏党，经纶尽朴忠。\n再来金鼎地，高卧亦成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"韩元吉","text":"霏霏小雨映烟光，睡起文书正满床。\n芍药倚阶才弄色，酴醾堆架渐吹香。\n林端好鸟犹相应，叶底残花欲自藏。\n便觉春风如我老，须君驻世有奇方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山中","author":"韩元吉","text":"杜陵爱饮觅南邻，我亦颠狂不奈贫。\n渐有好花宜过雨，应须美酒细酬春。\n十年乡国无穷思，千里江湖未老身。\n莫向空中厌愁寂，杏梢桃叶一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼寒亭","author":"韩元吉","text":"月里琼宫不禁寒，谁令白昼堕人间。\n阴风淅淅来深谷，晴雪霏霏溅两山。\n静爱飞流聊洗耳，坐看绝磴可怡颜。\n红尘热客那知此，赤脚青松意自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂咏六首 其六","author":"韩元吉","text":"绝壁跨城楼，连天海气浮。\n长空去鸟尽，落日断云留。\n鼓角深秋壮，山河薄暮愁。\n劳生知底所，倚杖寄沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂咏六首 其五","author":"韩元吉","text":"怪底西风别，秋香一夜繁。\n攒金差可拟，揉蜡巧能抟。\n买地宜多种，移床且细看。\n江南篱菊晚，赖尔慰愁端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂咏六首 其四","author":"韩元吉","text":"古郡青山合，乘高眼倍宽。\n风惊梧叶阵，雨暗菊花团。\n凉色宜攲枕，秋光怯凭栏。\n向来疏懒意，景物暂相欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂咏六首 其三","author":"韩元吉","text":"醉著山堂梦，初凉枕簟清。\n秋声迷夜雨，月色误天明。\n为客心长惯，思亲意未平。\n岁华容易晚，寂寞壮心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂咏六首 其二","author":"韩元吉","text":"草草重阳节，黄花惜未开。\n故人犹有酒，行客且衔杯。\n日落蛩声苦，云低雁影来。\n南山足佳气，独立意徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂咏六首 其一","author":"韩元吉","text":"客少无尘语，官閒省吏文。\n醉眠千嶂日，危坐一窗云。\n酒户时通籍，诗坛渐策勋。\n平生不龟手，郢客浑挥斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋雨新霁过赵慎中留饮","author":"韩元吉","text":"门外黄尘有底忙，主人高卧兴何长。\n春风竹树箫笙转，雨足轩窗笑语凉。\n耳热漫思官里事，眼明犹识醉时妆。\n紫云莫厌频来客，未抵当年御史狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴信幕寄子云叔■及同寺 其二","author":"韩元吉","text":"谢三船上醉同归，黄四花边手屡携。\n巷里何曾异南北，屋头还复记东西。\n一杯相属情犹在，千里分飞意自迷。\n堂下秋来足萱草，定倾家酿饫黄鸡。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子云五首 其五","author":"韩元吉","text":"水阔湖南道，春深可当游。\n鸟声喧绿树，花影趁行舟。\n短袖那容舞，良畴不易谋。\n有亲垂白发，敛板未应羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子云五首 其四","author":"韩元吉","text":"别意能凄楚，骊驹且缓听。\n百年三过一，万事醉还醒。\n策马身犹健，看山眼倍青。\n东风有底憾，吹柳暗长亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子云五首 其三","author":"韩元吉","text":"楚国富山水，衡湘千里馀。\n人皆思太傅，我独念三闾。\n贫贱真劳矣，功名果命欤。\n官閒道林寺，洗眼卧看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子云五首 其二","author":"韩元吉","text":"薄宦何堪远，兄今奉板舆。\n猫头供美笋，玉板荐嘉鱼。\n川陆徐行李，暄寒慎起居。\n会因回雁足，时一问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子云五首 其一","author":"韩元吉","text":"四海双兄弟，南来几别离。\n未成春草梦，先动白云思。\n涕泪三年隔，风尘数月期。\n生涯奔走里，卜筑定何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]