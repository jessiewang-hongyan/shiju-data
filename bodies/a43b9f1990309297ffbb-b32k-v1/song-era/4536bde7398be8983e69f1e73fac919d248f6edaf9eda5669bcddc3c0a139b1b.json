[{"title":"烟林晓望二首 其二","author":"杨万里","text":"也没炊烟也没云，日光烘起楚山氛。\n却将重碧施轻素，不见天工一笔痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烟林晓望二首 其一","author":"杨万里","text":"一叠青松一叠烟，横铺平野有无间。\n真成万丈鹅溪绢，画出江西秋晓山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烧香","author":"杨万里","text":"小阁疏棂春昼长，沉烟半穗弄轻黄。\n老铃略不知人意，故故搴帘放出香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中红白二莲五首 其五","author":"杨万里","text":"折得荷花伴我幽，更搴荷叶伴花愁。\n孤芳欲落偏多思，一片先垂半不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中红白二莲五首 其四","author":"杨万里","text":"白莲半莟未开时，看作红莲更不疑。\n到得欲开浑别了，玉肤洗退淡胭脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中红白二莲五首 其三","author":"杨万里","text":"晚花特地敛新妆，莫道无情总不妨。\n中有黄金莲子盏，被人瞥见即深藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中红白二莲五首 其二","author":"杨万里","text":"拣得新开便折将，忽然到晚敛花房。\n只愁花敛香还减，来早重开别是香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中红白二莲五首 其一","author":"杨万里","text":"红白莲花共玉瓶，红莲韵绝白莲清。\n空斋不是无秋暑，暑被花销断不生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中淮阳红牡丹落尽有叹三首 其三","author":"杨万里","text":"又是明年看牡丹，未开芍药怯春寒。\n落英满地不须扫，一片蔫红也足观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中淮阳红牡丹落尽有叹三首 其二","author":"杨万里","text":"眼中姚魏过匆匆，只有淮阳打底红。\n杜宇一声花睡醒，却教老子怨东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶中淮阳红牡丹落尽有叹三首 其一","author":"杨万里","text":"只愁风雨妒花枝，剪入瓷瓶养却伊。\n更下重帘深闭阁，忽然花落又关谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中止酒二首 其二","author":"杨万里","text":"江草江花怨阿谁，山风山雨总成悲。\n春愁万斛无安顿，旋旋分张乞小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中止酒二首 其一","author":"杨万里","text":"葛衣著了却生寒，风势颠时正上滩。\n客里无聊已无奈，更教止酒过春残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病疟无聊","author":"杨万里","text":"病身兀兀意昏昏，急挂东窗避夕曛。\n坐看云生还有雨，忽然雨止并无云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积雨小霁","author":"杨万里","text":"雨足山云半欲开，新秧犹待小暄催。\n一双百舌花梢语，四顾无人忽下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积雨小霁暮立捲书亭前二首 其二","author":"杨万里","text":"淡紫斜阳嫩碧天，一春今夕始开颜。\n看山偶忘归来却，月到西廊第二间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积雨小霁暮立捲书亭前二首 其一","author":"杨万里","text":"报晴底用暮寒为，薄薄春衫横见欺。\n似有如无风细甚，柳丝无赖恰先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积雨新晴二月八日东园小步二首 其二","author":"杨万里","text":"去岁春时政病身，对花不饮被花嗔。\n如今急报千花道，还我前来未足春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积雨新晴二月八日东园小步二首 其一","author":"杨万里","text":"醉来忽堕锦网窝，无奈桃围李绕何。\n八角小亭无处坐，见花多处背花多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷池","author":"杨万里","text":"小池岁晚石泉寒，荷叶低垂绿柄乾。\n一似渔人暮归后，败蓑破笠挂鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷池小立","author":"杨万里","text":"点铁成金未是灵，若教无铁也难成。\n阿谁得似青荷叶，解化清泉作水精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷池小立","author":"杨万里","text":"池小泉多强欲留，留它不住恣它流。\n荷盘不放荷尖出，穿破盘来却又休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷桥","author":"杨万里","text":"桥压荷梢过，花围桥外饶。\n荆溪无胜处，胜处是荷桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷桥暮坐三首 其三","author":"杨万里","text":"水到荷花蒂，风生菰叶梢。\n鸥凫晚声散，天水夕光交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷桥暮坐三首 其二","author":"杨万里","text":"池似平铺绿锦横，荷花为纬藻为经。\n无端织出诗人像，独立飞桥摘斗星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷桥暮坐三首 其一","author":"杨万里","text":"桥剪荷花两段开，荷花留我不容回。\n不胜好处荷桥坐，政是凉时蚊子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读子房传","author":"杨万里","text":"笑赌乾坤看两龙，淮阴目动即雌雄。\n兴王大计无寻处，却在先生一蹑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读元白长庆二集诗","author":"杨万里","text":"读遍元诗与白诗，一生少傅重微之。\n再三不晓渠何意，半是交情半是私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读贞观政要","author":"杨万里","text":"拔士新丰逆旅中，怀贤鸭绿水波东。\n酒倾一斗鸢肩客，醋设三杯羊鼻公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读汉书二首 其二","author":"杨万里","text":"乃祖宽仍豁，曾孙察作明。\n不将囊底智，分减及元成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读汉书二首 其一","author":"杨万里","text":"猿臂生何晚，彫虫死较迟。\n晚生妨底事，迟死独堪悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读严子陵传","author":"杨万里","text":"客星何补汉中兴，空有清风冷似冰。\n早遣阿瞒移汉鼎，人间何处有严陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读张文潜诗二首 其二","author":"杨万里","text":"山谷前头敢说诗，绝称漱井扫花词。\n后来全集教渠见，别有天珍渠得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读张文潜诗二首 其一","author":"杨万里","text":"晚爱肥仙诗自然，何曾绣绘更雕镌。\n春花秋月冬冰雪，不听陈玄只听天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读陈蕃传","author":"杨万里","text":"仲举高谈亦壮哉，白头狼狈只堪哀。\n枉教一室尘如积，天下何曾扫得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读武惠妃传","author":"杨万里","text":"桂折秋风露折兰，千花无朵可天颜。\n寿王不忍金宫冷，独献君王一玉环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读退之李花诗","author":"杨万里","text":"近红暮看失燕支，远白宵明雪色奇。\n花不见桃惟见李，一生不晓退之诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读梁武帝事","author":"杨万里","text":"眼见台城作劫灰，一声荷荷可怜哉。\n梵王岂是无甘露，不为君王致蜜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读笠泽丛书三首 其三","author":"杨万里","text":"拈著唐诗废晚餐，傍人笑我病诗癫。\n世间尤物言西子，西子何曾直一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读笠泽丛书三首 其二","author":"杨万里","text":"松江县尹送图经，中有唐诗喜不胜。\n看到灯青仍火冷，双眸如割脚如冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读笠泽丛书三首 其一","author":"杨万里","text":"笠泽诗名千载香，一回一读断人肠。\n晚唐异味同谁赏，近日诗人轻晚唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"轿中风翻书卷","author":"杨万里","text":"挟册登车强出山，展来未读眼先昏。\n无端又被春风妒，叶叶吹开更揭翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"轿中绝句","author":"杨万里","text":"雪洗林花颊，金挼陇麦髯。\n捲帘双眼远，隔树一峰尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"轿中望泛仙山","author":"杨万里","text":"上却篮舆卷却帘，晓寒旋索熟衣添。\n孤松已自三千丈，更在仙山第一尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都下无忧馆小楼春尽旅怀二首 其二","author":"杨万里","text":"不关老去愿春迟，只恨春归我未归。\n最是杨花欺客子，向人一一作西飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都下无忧馆小楼春尽旅怀二首 其一","author":"杨万里","text":"病眼逢书不敢开，春泥谢客亦无来。\n更无短计销长日，且绕栏干一百回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酌惠山泉瀹茶","author":"杨万里","text":"锡作诸峰玉一涓，曲生堪酿茗堪煎。\n诗人浪语元无据，却道人间第二泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒蛤蜊","author":"杨万里","text":"饮者怜渠有典刑，见渠借箸眼偏青。\n平生闭口不论事，晚岁搜肠求独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高邮野望二首 其二","author":"杨万里","text":"江南十里九青山，江北无山只野田。\n更遣野田无远树，郭熙尽巧若为传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高邮野望二首 其一","author":"杨万里","text":"望中四野掌般平，远树成行一带横。\n树外天容仍淡白，不愁树影不分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堑荷池水","author":"杨万里","text":"雨中来看堑池塘，自与畦丁细校量。\n更放水痕高几许，浮荷犹剩若干长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿万安铺","author":"杨万里","text":"来朝还入鳄鱼乡，未到潮阳到揭阳。\n休说春风归路远，只今去路不胜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿三里店溪声聒睡终夕","author":"杨万里","text":"破驿荒村山路边，斜风细雨客灯前。\n子规一夜啼到晓，更待溪声始不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿小沙溪 其二","author":"杨万里","text":"诸峰知我厌泥行，捲尽痴云放嫩晴。\n不分竹梢含宿雨，时将残点滴寒声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿小沙溪 其一","author":"杨万里","text":"树捧山烟补缺云，风揉花雨作香尘。\n绿杨尽道无情著，何苦垂条拂路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿小粉村","author":"杨万里","text":"暮宿溪边小粉村，一峰如笔正当门。\n看来山色元无粉，拂杀浓蓝浅黛痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿孔镇观雨中蛛丝五首 其五","author":"杨万里","text":"网罗最密是蛛丝，却被秋蚊圣得知。\n粘著便飞来不再，蛛丝也解有疏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿孔镇观雨中蛛丝五首 其四","author":"杨万里","text":"走得团团织得窠，群飞来往不逃它。\n网罗外面逃多少，枉了辛勤设网罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿孔镇观雨中蛛丝五首 其三","author":"杨万里","text":"空中仰面却飞身，寂似毗耶不动尊。\n忽有一蚊来触网，手忙脚乱便星奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿孔镇观雨中蛛丝五首 其二","author":"杨万里","text":"雨罢蜘蛛却出檐，网丝小减再新添。\n莫言辛苦无功业，便有飞虫密处粘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿孔镇观雨中蛛丝五首 其一","author":"杨万里","text":"雨打蛛丝不打蛛，雨来蛛入画檐隅。\n网罗满腹输渠巧，也只蝇蚊命属渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿长安闸","author":"杨万里","text":"野次何销追水程，昏时即住晓时行。\n惊眠幸自无更点，犹有船头击柝声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿长林","author":"杨万里","text":"雾月撩人白，风灯恼客青。\n倦多资美睡，酒薄免迟醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿张家店壁间有赵民则一绝句云舍策投床睡便浓觉来凉叶动西风惊秋念远无穷意客里知谁此夜同因次其韵","author":"杨万里","text":"督邮不敌客愁浓，那更秋宵一笛风。\n公子何曾知许事，旷怀也解与人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿灵鹫禅寺二首 其二","author":"杨万里","text":"初疑夜雨忽朝晴，乃是山泉终夜鸣。\n流到前溪无半语，在山做得许多声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿灵鹫禅寺二首 其一","author":"杨万里","text":"暑中带汗入山中，霜满风篁雪满松。\n只是山寒清到骨，也无霜雪也无风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿枫平","author":"杨万里","text":"休说江西西路行，东来骨瘦却诗清。\n恐缘桂玉疏云子，敢对溪山唤曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿青山市四首 其四","author":"杨万里","text":"市心酒店客来尝，且酹仙家十二郎。\n鹦鹉鸬鹚何处觅，只将老瓦当瑶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿青山市四首 其三","author":"杨万里","text":"近看青山却朗然，更无半点雾和烟。\n一峰是石高多少，到得峰头即到天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿青山市四首 其二","author":"杨万里","text":"云涂雾抹澹葱昽，万匹霜绡罩玉龙。\n中有双峰不争长，诸峰情愿长双峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿青山市四首 其一","author":"杨万里","text":"青山业主是玄晖，太白无钱典得伊。\n总是诗仙休更讼，两蓑分钓一鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿南岭驿二首 其一","author":"杨万里","text":"蕨手犹拳已箸长，菊苗初甲可羹尝。\n山村富贵无人享，一路春风野菜香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿南岭驿二首 其二","author":"杨万里","text":"茅花似雪复如茸，一望平原浅草中。\n尽日向人挥玉麈，知将何事语春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿城外张氏庄早起入城三首 其三","author":"杨万里","text":"眠云跂石十馀年，回首抛官一瞬间。\n送旧迎新也辛苦，一番辛苦两年闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿城外张氏庄早起入城三首 其二","author":"杨万里","text":"破店无鸡报五更，只将梦觉当鸡鸣。\n匆匆上却篮舆了，隔壁人家政睡声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿城外张氏庄早起入城三首 其一","author":"杨万里","text":"灯火频挑只管残，雨声终夜恼空山。\n幸蒙晓月多情白，又遣东风抵死寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿峨桥化城寺二首 其一","author":"杨万里","text":"一溪秋水一横桥，近路人家却作遥。\n柳绕溪桥荷绕屋，何须更著酒旗招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿峨桥化城寺二首 其二","author":"杨万里","text":"忽从平地上高城，乃是圩塘堤上行。\n厚赛柳神销底物，长腰云子阔腰菱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]