[{"title":"晨起","author":"周文璞","text":"闭门不与俗人交，玄晏春秋日日抄。\n清晓偶然随鹤出，野风吹折白樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望云亭","author":"周文璞","text":"淑气槃槃接九原，须臾鳞合更瀰漫。\n自从蒿里无颜色，来到钟山有泪痕。\n往者英雄俱雨绝，后来哀痛欲河翻。\n夜深月照长松下，谁见孤飞出墓门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅梁歌","author":"周文璞","text":"文命殿角东北左，上有梅梁铁交锁。\n传闻旧时枝叶生，木质鳞身无不可。\n有时匹练离朱栱，归带湿萍光欲动。\n低头下吸菲岭泉，奋髯直入阳明洞。\n旁观但怪香火浓，顷刻即令风雨送。\n尔不见饥乌啄鼓来馈食，走入嵩高化为石。\n禨祥祸福傥或是，阴阳幻变谁能测。\n玉笥观挂白玉梁，含元追下流血柱。\n异事苟逢博物问，后来那得详其故。\n卷丹云，凝素雾，玉箫九成奠雕俎。\n登歌升降只仰俯，呜呼梅梁匆飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明日书事","author":"周文璞","text":"苍弁一如楚执圭，思想越吟身自低。\n涧水又如古智士，纵横流转多滑稽。\n杂花半开已倏落，如怨旷女离深闺。\n幽禽自呼复相命，如谴逐魄伤穷栖。\n而我自是不羁者，行行踏破青萋萋。\n今回荡桨苕霅溪，与野老辈相扶携。\n园池亭墅游历遍，自对蜀锦倾偏提。\n兴阑径走归弟舍，同沃浮蚁烹村鸡。\n百五之后最寥阒，独过赵湾西更西。\n野夫不知时节换，但要熟醉如春泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野蔷薇","author":"周文璞","text":"娟娟篱头花，白白间绿叶。\n明光裁贩裤，不掩游子屧。\n馀春背人去，乞与弄芳蝶。\n感我万古心，离离不相接。\n我行田野间，落魄何所挟。\n犹能自撑拄，使气学汉侠。\n悠然芳草畔，见此衣逐妾。\n罗帷未生梦，粉面反成怯。\n幽香薰倒人，山麝火初熁。\n长亭或相思，如见玉蹀躞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铜雀研","author":"周文璞","text":"君王有遗令，婢子守空台。\n遥望西陵下，漆灯照鸩杯。\n玉颜阙钗泽，松柏生悲哀。\n低吟短歌行，想像奸雄才。\n清泉沈金彩，古烟凝紫灰。\n零落故瓦在，雕镌若陶坯。\n为人作书研，词章出诙谐。\n上下千载间，流转何悠哉。\n那知墟中人，天命不复来。\n齐昏亦披猖，增三筑崔嵬。\n年年漳河头，野棠如雪开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄龙洞","author":"周文璞","text":"一从负图与负舟，天公閟之居灵湫。\n重瞳胼手久不作，苍苔古木两漠漠。\n朝来石磴鳞鳞湿，如觉蜿蜒为人出。\n甘霖未苏焦卷多，相候吴云莫相失。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食曲","author":"周文璞","text":"今年寒食好天色，游人踏青行不极。\n寻山不惮千里远，往往啼号湿松柏。\n一杯才酹坟上土，祗就坟前便歌舞。\n故乡自有懊恼声，插腰羊皮小番鼓。\n吁嗟悲欢一饷间，但恨死人不能语。\n君不见北客纷纷俱落南，先冢尽被胡尘漫。\n影堂逢节具饮食，魂魄夜行溪谷山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"周文璞","text":"天柱青峨峨，石笋危不堕。\n晃晃银云收，谁子开玉锁。\n崩腾放闸水，煜爚入洞火。\n神境偕灵休，乃欲搜碎琐。\n愧彼朽浊颜，一得在无我。\n致彼老铸凝，披褐迎路左。\n愿留护银铛，被叶盘礴裸。\n玉?付九虎，游宴升嶪峨。\n为言子速去，勤苦悔坎轲。\n反朴招太和，当免运劫祸。\n恸哭出青松，残龄其或可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游栖霞四首 其四","author":"周文璞","text":"府帖昨夕下，许奉半月急。\n遂作兹山游，惘恍忧思失。\n古迹堕榛莽，久久失修葺。\n南唐石塔好，岿然对人立。\n高碣缠蛟龙，奇画耐风日。\n明旦丹阳路，万感当毕集。\n说似石翁婆，皆须为余泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游栖霞四首 其三","author":"周文璞","text":"优尼制铜觉，欲住女主龄。\n主称金轮王，录在华严经。\n而舍觉富贵，爱慕涂椒馨。\n月黯回心院，妖魂啼窈冥。\n僧人弗知此，独受一峰青。\n分减傥及我，终岁栖林坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游栖霞四首 其二","author":"周文璞","text":"吾与空门友，相扶历芳甸。\n天机久深妙，梵本亦贯穿。\n徐驰得幽欣，济胜惬孤愿。\n宿芽发轻苞，寒卉抱短艳。\n鹿走风生林，僧归云入殿。\n寺从齐梁来，诸彦题品遍。\n安知千岁后，未叹陵谷变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游栖霞四首 其一","author":"周文璞","text":"破晓逗苦雾，客鼻何酸辛。\n山中气候异，初日如烛银。\n田间石兽多，知是肉角麟。\n古苔半皴腹，化作苍龟鳞。\n两柱既岌嶪，众碑亦嶙峋。\n幽涂得奇观，未敢辞埃尘。\n连年抱离忧，百嗟亡一呻。\n花委鬓毛晚，草夺袍色春。\n愁中书椟失，梦里歌钟陈。\n穷愁著文字，屡被同行嗔。\n同行不相知，而况悠悠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢颐师见过","author":"周文璞","text":"云卷道者方昼睡，有僧奚为入桑杞。\n惠然相过穷壑底，共谈儒流佛宗旨。\n二家之风亦颓靡，吹而飏之谁为起。\n寒灰煨芋香透纸，呼童就邻一赊米。\n作糜煮菜相料理，吾穷于世无比拟。\n殷勤相觅有吾子，谩书七字聊送似，往供天嫔泣山鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中望茅山有感","author":"周文璞","text":"危亭对名岳，毕景扶钩栏。\n白鹭伺察过，低昂若弓弯。\n去岁负笈游，最住元符间。\n栎林带脩竹，清派流珊珊。\n离留叫昼静，洞天生春寒。\n伟哉老宗师，作屋云雨端。\n竟为杀虫蚁，不活升龙鸾。\n遗体但解蜕，故宫亦烧残。\n今创已半旧，万柱扶玄坛。\n遂以两不借，一筇履巑岏。\n入宅问玉斧，采芝投金环。\n墨沼篆结字，丹台气成盘。\n将谓便隐遁，遽尔罹间关。\n夷甫麈尾堕，荀令香炉闲。\n再获望奇秀，恍然神观还。\n如见大仙伯，被发绿映山。\n两君控鹄从，俱著汉小冠。\n俗累当复驰，煮药鼎欲翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新柳","author":"周文璞","text":"长条导幽情，净色穿户牖。\n酸风酽如醋，少待浓似酒。\n飐飐金丝垂，满眼遮老丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠蛟亭","author":"周文璞","text":"禹驱龙蛇不驱蛟，依然跧此山之坳。\n有时渊停忽奔放，如负山走如玉跑。\n昔时莘渭正如此，咨尔来者无空嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辘轳体","author":"周文璞","text":"野人无事时，常诵极玄诗。\n写遍千山寺，吟行九曲溪。\n谁为补天手，同是决云儿。\n欲去无人问，今霄醉似泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题卢申之骡纲图","author":"周文璞","text":"昔日三郎骑尔祖，庙食太山可辛苦。\n后来崎岖蜀栈间，弃置龙媒复亲汝。\n深山古木雪漫漫，险途十步九步艰。\n纲头咒嘱勿损折，要尔助军身补官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题胡女骑","author":"周文璞","text":"燕山雪花一尺飞，胡人胡女夜打围。\n海东青过流沙西，黄头郎主独自归。\n创残狐兔悬毡车，疲惫鹰犬闻笳悲。\n君不见自从石晋纳书款，白沟河漘作边面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曹武帝削瓜图","author":"周文璞","text":"阿瞒瓜分姿，见之垂髫中。\n此心既弗乂，此道安可洪。\n汉祚既坠地，馀子方困穷。\n仁义傥自唱，历数岂不同。\n挟令及宫阃，杀士延奴童。\n至今吊古徒，哀痛殊未终。\n实以己偪仄，遂令彼长雄。\n画图出后世，略见经营工。\n想其鼎峙势，亦天诱其衷。\n此章弗徒歌，聊以裨国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题喻玉泉家亦可乐亭","author":"周文璞","text":"先生亭非伯夷筑，亭柱亦用秋山竹。\n但令家有满架书，何虑妻儿少饘粥。\n朝来相对亭上宾，洙泗尺度羲皇人。\n先生已死名不泯，常与此亭作标准。\n后来邻触阏伯怒，仆夫预起池鱼虑。\n拆亭拆亭先拆柱，有孙抱柱出烟去。\n三十年馀复改观，有孙如此不待赞。\n似鲁灵光偶不全，令人见此空三叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蔡武伯所藏荆公砚","author":"周文璞","text":"兽面鼎足奔回互，中有润泽比雨露。\n当年曾出富国疏，老子平生用心处。\n帝谟商颂周六典，刻画声形劳解诂。\n至今文字与风骚，一一相辉炫缃素。\n如闻四海失枝梧，可憾诸公欠调护。\n谁令天乎遽如许，可是石也能无预。\n陈玄同归蒋山路，亦使高人野僧觑。\n若为持入定林中，应有明云入天柱。\n吾乡风流蔡夫子，匣而藏之美无度。\n君不见公乡后进陆象山，作祠堂记馀千言，直欲百世俟圣贤。\n惜哉不得铭此砚，使我失意心惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濑上怀古","author":"周文璞","text":"古寺閟岑郁，空梁悬斋鱼。\n神坐既攲仄，德容亦饥虚。\n先生贫有命，山僧乐无馀。\n长安满市花，匹马吟九衢。\n寥寥北邙山，而谁噫荒墟。\n岂有先生者，不如山僧欤。\n盲风振苕华，重露落芙蕖。\n何当醉尉归，方坐钓水隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠苏召叟","author":"周文璞","text":"句容县古寺，壁有道玄笔。\n晃晃缨络躯，渺渺烟雾质。\n一堵最光怪，朱泥久堙郁。\n泥去墨亦尽，惨淡意都失。\n恨不还其人，加巾急鞭抶。\n毁弃加弗敬，请论如汉律。\n罗汉院塔影，颠倒难致诘。\n稗书志海翻，此理殊未必。\n今君所归路，正向此中出。\n况有吊古才，仰天痛呼屈。\n勿称荒唐言，析理资按述。\n其馀传播咏，淋漓满箱帙。\n栖霞者悲壮，茅洞者清逸。\n珍题倘相命，当第为甲乙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相士丁日宣","author":"周文璞","text":"张公谓余可神仙，薛颠谓余可英杰。\n丁生谓二皆无成，世间安有此奇绝。\n麒麟阁上冠貂蝉，龙虎鼎内治大丹。\n兴来一笑扫燕□，回首已自升云端。\n何如只向松江渡，杨柳影边茅屋住。\n卧看苍虬挟白云，卷取秋涛过江去。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵子野歌","author":"周文璞","text":"与君虽为外兄弟，语话寻常见肝肺。\n自从不见半年馀，每望吴云辄流涕。\n蘋溪松江同一波，半年不见当奈何。\n长安市上相就处，弟能起舞兄能歌。\n兄今赐第南薰殿，满戴宫花上林宴。\n弟归便著堕游冠，他时山中傥相见。\n吴王台畔杨柳黄，吴姬对坐调丝簧。\n阿兄自对吴云坐，呼弟不来应断肠。\n书来不应寄他物，只要秋林一双笛。\n当使蛮奴月下吹，此时此夜须相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪","author":"周文璞","text":"夜闻春雨来，浓绿净于洗。\n有禽自南翥，自呼不能已。\n岂非湘川下，或自江左起。\n黄陵见哀妃，白下感游子。\n仍多忧其兄，宛转深树里。\n汝兄今何在，荆棘日靡靡。\n岂非囚空山，或已投逝水。\n年深桎梏化，波冷皮肉死。\n鹧鸪谨勿痛，此系造物理。\n吾若破析言，汝恨入骨髓。\n风吹慈竹林，苔晕上深紫。\n吾亦念故乡，日夜梦邻里。\n不如各归休，阙月照西鄙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瞿塘神君歌","author":"周文璞","text":"黄衫纱帽佳少年，炯然饿虎穷山渊。\n不居秦鹿祖龙畔，却走碧鸡金马边。\n左手斜执巨灵凿，右手敬抱禹贡篇。\n离堆顺流已受命，一下不打天吴鞭。\n有时挟弹暮云表，有时蹴游春风前。\n有时却自著绛帕，走入药市寻神仙。\n为人定似李太白，学道定似葛稚川。\n孙翁走避乖崖叟，遣仆送画不取钱。\n神君庙食与画像，千古万古当流传。\n我昔梦上神君殿，偶值蓬莱众真宴。\n洛阳开尽姚黄花，铜驼陌上难相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬思堂四言","author":"周文璞","text":"有亭央央，高丘之傍。\n父兮母兮，坚深埋藏。\n厦屋凄凉，宰木成行。\n春秋蒸尝，酒浆牛羊。\n身体俯伛，虽劳弗彰。\n心志瞀乱，虽烦弗扬。\n欲求幽阴，茫茫洋洋。\n两间四方，实系我肠。\n何以照之，明神后皇。\n凡今之人，谁同慨伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望茅山六言三首 其三","author":"周文璞","text":"蒋家兄弟清古，著书互相推宗。\n抟土划沙戏剧，穿岗度岭从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望茅山六言三首 其二","author":"周文璞","text":"昔年唱采芝歌，已老头颅柰何。\n不见飙轮碾处，白云出没常多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望茅山六言三首 其一","author":"周文璞","text":"羽衣药叟欢迎，手执兰花共行。\n从此十年不调，可能久视长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一剪梅","author":"周文璞","text":"风韵萧疏玉一团。\n更著梅花，轻袅云鬟。\n这回不是恋江南。\n只是温柔，天上人间。\n赋罢闲情共倚阑。\n江月庭芜，总是销魂。\n流苏斜掩烛花寒。\n一样眉尖，两处关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼","author":"周文璞","text":"何人弹阮咸，故故轻手摘。\n弹作乌夜啼，此意我所恻。\n南朝有帝子，作牧号侯伯。\n著身疑嫌间，生意日偪仄。\n爱妾闻啼声，改镇颁竹册。\n或云长安吏，性命在顷刻。\n小妇闻啼声，赦令敷大泽。\n身虽不肖甚，幼小著苍帻。\n再转作县佐，欲塞父祖责。\n濡墨决疑讼，行朱慰冤魄。\n群凶见之怒，极意便刳磔。\n首沮隶阳桥，公议亦已格。\n痛掠及库胥，指作盗钱贼。\n胥既窘椎凿，手堕面愈黑。\n书款自诬伏，身竟遭刻画。\n酷毒一如斯，谁谓彼无策。\n谤书入外台，遂坐使者劾。\n牵连入冶城，五载穷惨礉。\n陈词叫穹旻，哀恸人叵测。\n若无磊落者，谁肯为昭白。\n翻思受祸时，何但铩羽翮。\n愁冤传里巷，泣涕到臧获。\n嫠母偕妻孥，惘惘望秋色。\n岂料今日下，置酒设豚拍。\n听此哀丝鸣，但呼说不得。\n月明客已去，庭宇鸣哑哑。\n世人见慈乌，唾笑满阡陌。\n谁知事乘除，祸去反为福。\n苍苍上林枝，当去作谢客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令","author":"周文璞","text":"还了酒家钱。\n便好安眠。\n大槐宫里著貂蝉。\n行到江南知是梦，雪压渔船。\n盘礴古梅边。\n也信前缘。\n鹅黄雪白又醒然。\n一事最奇君听取。\n明日新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"周文璞","text":"本是离骚国里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"周文璞","text":"春梅避石开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"周文璞","text":"淡烟疏雨又青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"周文璞","text":"更无花上月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"周文璞","text":"西陵西又西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"周文璞","text":"凄凉一似观堂僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"周文璞","text":"戏赓和靖句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"周文璞","text":"衣篝不用绿沉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"工夫颂","author":"周无所住","text":"百刻工夫一刻推，一刻还同十二时。\n十二时中归一念，念中无念始真奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"火候颂","author":"周无所住","text":"真火本无候，时人休强猜。\n要知端的意，无去亦无来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玄关一窍颂","author":"周无所住","text":"一窍才通万窍通，丝毫不动露真空。\n个中便是真宗祖，认著依前又不中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阳晶颂","author":"周无所住","text":"全清绝点号阳晶，才有纤瑕便属阴。\n多少神仙皆不说，谁人肯向此留心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沐浴颂","author":"周无所住","text":"沐浴无他术，休寻卯酉中。\n困眠饥吃饭，无日不春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"抽添颂 其一","author":"周无所住","text":"若问抽添法，纵擒怕觉迟。\n调停无损益，方始證无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"抽添颂 其二","author":"周无所住","text":"识得真心无不遍，自己不明被物转。\n可怜无限守株人，退铅进汞错方便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真土颂","author":"周无所住","text":"真土从来名强立，学人不晓谩傍求。\n若知真土为中道，何必骑牛更觅牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"温养颂","author":"周无所住","text":"恬淡无思虑，虚无任自然。\n胎圆神自化，我命不由天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斤两颂","author":"周无所住","text":"不圆不缺行中道，著意忘怀便落偏。\n更言二八一斤数，开眼明明被孰瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"口诀颂","author":"周无所住","text":"意到心诚，湛然若凝。\n昼夜无间，效验自应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玄牝颂","author":"周无所住","text":"万物芸芸，各归其根。\n识得根源，玄牝虚传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙虎颂","author":"周无所住","text":"龙虎猖狂，心念炎烈。\n慧剑才挥，二兽俱灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"法度颂","author":"周无所住","text":"清净药材，密意为丸。\n十二时中，无念火煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真炉鼎颂","author":"周无所住","text":"头上顶天，脚下踏地。\n中有一物，煅成宝器。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铅汞颂","author":"周无所住","text":"欲识铅汞，情性二物。\n二物和合，还丹了毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题净明寺","author":"周日明","text":"幽幽古寺中，石径受苔封。\n白日无一事，青山只四峰。\n野蔬为佛供，涧水替人舂。\n僧因煎新茗，林间拾坠松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]