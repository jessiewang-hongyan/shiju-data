[{"title":"水仙花","author":"许开","text":"定州红花瓷，块石艺灵苗。\n方苞茁水仙，厥名为玉霄。\n适从闽越来，绿绶拥翠条。\n十花冒其颠，一一振鹭翘。\n粉蕤间黄白，清香从风飘。\n回首天台山，更识胆瓶蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茉莉花","author":"许开","text":"火令行南国，彤云间丹霞。\n之子方热中，濯濯冰雪花。\n植根却月盘，趣驾七香车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄宫","author":"许开","text":"珠宫梁柱太平年，福地从知接洞天。\n曲槛一峰飞怪石，幽亭三峡迸流泉。\n骊龙睡重时方旱，白鹤归来客欲仙。\n殿上红云西日映，此身如在玉皇前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城阳山","author":"许文蔚","text":"我祖有遗迹，振屐访南岭。\n凭高一以眺，万壑皆云烟。\n谷鸟犹嘤嘤，辽鹤无时旋。\n一饮丹池水，心中尘虑捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入邑问炊中云招王希圣起龙三首 其三","author":"许月卿","text":"箪瓢不改乃真豪，之子胸中志自高。\n本自无官彭泽柳，不知何世武陵桃。\n窗前草色勤钻仰，堂上萱丛敬抑搔。\n好向中庸看未发，养成和气盎春醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入邑问炊中云招王希圣起龙三首 其二","author":"许月卿","text":"移文招子气添豪，毕竟牢关计未高。\n留得商霖活秋稼，未应禹浪怨春桃。\n半窗明月诗谁和，一剑空灯手自搔。\n来此共君思昨梦，秋风江上几投醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入邑问炊中云招王希圣起龙三首 其一","author":"许月卿","text":"希圣平生诗酒豪，居然闭户学孤高。\n不知昨夜秋风柳，得似当时春日桃。\n别去半年犹旦暮，胸中百痒欠爬搔。\n虎溪破戒君须解，已办清诗与浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽词五首 其五","author":"许月卿","text":"此日营陵处，当年毓圣乡。\n幅员哀踽踽，羽卫道煌煌。\n有彗忧天坠，重轮丽日光。\n讴歌吾君子，千载圣情伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽词五首 其四","author":"许月卿","text":"从谏如尧禹，闻言若舜文。\n五臣跻□□，三诰斥□君。\n圣度天同广，忠谋日有闻。\n甲辰亲策处，赣论玉颜欣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽词五首 其三","author":"许月卿","text":"紫阳儒者侣，恨不与同时。\n指示四书要，躬亲百世师。\n钦崇道兢业，怀保诰宽慈。\n玉殿凄凉处，瑶题尚启敷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽词五首 其二","author":"许月卿","text":"享国昭陵似，龙飞四十春。\n哀荣皆甲子，创守又庚申。\n刑措成康治，风移尧舜仁。\n瑶编再仁祖，万叶道如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大行皇帝挽词五首 其一","author":"许月卿","text":"创始昌陵汉，中兴高庙尧。\n登遐皆十月，扬烈擅三朝。\n再造煌煌业，参侔浩浩霄。\n中兴兼创始，二帝侑逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"川原","author":"许月卿","text":"川原红紫一时新，暮雨朝云更可人。\n灿若中兴红药相，嫣然何虑海棠嗔。\n天将好景烦吟笔，我自清时作幸民。\n书册埋头无了日，不如抛却去寻春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋谢施婺源爰","author":"许月卿","text":"高情古意满溪楼，静拍栏干尽两眸。\n月不露圭天有道，风能□谷水无愁。\n从吾所好万青壑，舍我其谁双白鸥。\n别样主人情重处，不将红妓涴中秋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云边","author":"许月卿","text":"云边人种麦，天际我归舟。\n月色轻寒夜，笛声何处楼。\n久晴人渴雨，倦仕我思休。\n高士传闲看，东篱花正幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"允杰侄以诗来卒章和予生孙次韵一百首今存四 其四","author":"许月卿","text":"孙枝遥喜道韦经，老手摩头咳唾名。\n豚犬吾儿夷□侄，虎龙孙祖退之情。\n洗儿汤饼吾方拙，教子盐梅汝更荣。\n许氏一门忠孝盛，夔皋熊虎□延评。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"允杰侄以诗来卒章和予生孙次韵一百首今存四 其一","author":"许月卿","text":"陈陈史传勘玄幽，一笑谁能问慎由。\n往往东南旗运盛，亭亭西北盖云浮。\n琼楼玉宇无身翼，弱水蓬莱有艾舟。\n圣主攘夷修政事，可能吊伐至枋头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"允杰侄以诗来卒章和予生孙次韵一百首今存四 其二","author":"许月卿","text":"玉川破屋抱遗经，生子添丁意命名。\n门暗碧云忧国志，窗明红日爱君情。\n柳绿学徒勤左塾，花红主妇馔前荣。\n他年谁注徵君传，好把吟篇著眼评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其十一","author":"许月卿","text":"今岁无时不禦寇，每年此际去防秋。\n琴散广陵今叔夜，笳声出室古刘畴。\n启沃欣承霖雨楫，流离安乐雁鸿洲。\n我自清时幸民着，茅柴薄晚妇能篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其十","author":"许月卿","text":"一月春风洛水幽，凛然惟有壑专秋。\n十室九空鸿雁渚，千村万落杞荆畴。\n乌鸟有情瞻岵屺，黄龙无底羽渊洲。\n思昔朝廷天广大，何时醢赐伴醪篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其九","author":"许月卿","text":"彭城夜雨悲翁季，手植堂前双桂秋。\n竹马吾何计东阁，巾车何自乐田畴。\n棣华颇失椿萱树，雁影平沉橘柚洲。\n更忆北山移植处，钓鱼竿底玉醪篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其八","author":"许月卿","text":"行晴坐雨荷天休，天地中间独享秋。\n淡日凉风满衣屦，甘霖薄暮悦田畴。\n晴天历历供峰屿，烟雨濛濛护岛洲。\n蹙蹙四方瞻靡骋，愁心如醉懒新篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其七","author":"许月卿","text":"双星今夜话绸缪，颇语人间一夜秋。\n万事悠悠何预我，四方蹙蹙属之畴。\n万家旁置伤心地，四水宗朝极目洲。\n坐看白云栖断处，支郎酒老腊前篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其六","author":"许月卿","text":"五更殊觉洗空忧，一雨端能接引秋。\n陋室了知饶鹤料，高田无复拆龟畴。\n蒲葵扇老堪藏箧，杨柳梢存不见洲。\n混混浊流聊濯足，玉泉金井酒宜篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其五","author":"许月卿","text":"都忘甲子不知老，三十六峰无限秋。\n江水清兮鳞百丈，庐山高处稻盈畴。\n尧时丙子寿星数，坡句许家仙岛洲。\n自分吾生老耕钓，花瓢趁取日先篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其四","author":"许月卿","text":"雨馀目极乾坤月，雪外天连䆉稏秋。\n舜殿风薰殊未玉，尧天雨施自君畴。\n层波渝我蒹葭渚，列宿嗤人杜若洲。\n珍重菊庄来顾我，床头为子出春篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月雨十一首 其一","author":"许月卿","text":"麟笔大书六月雨，蝉声静扫一天秋。\n天河倒挽甲兵洗，地宝咸归粳稻畴。\n雨馀攲枕轩窗月，天际归帆蘋蓼洲。\n一饱了知天赐履，漉巾洗盏办新篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天贶","author":"许月卿","text":"天贶逢佳节，地灵钟异人。\n今朝书上考，同日是生辰。\n部使星留次，临川月半轮。\n明年当此日，五马列朝绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆胡同年","author":"许月卿","text":"同年情谊弟兄侔，姓不同兮马范俦。\n吾榜得人今古盛，使君与我腹心投。\n斜阳遮断离愁路，野渡撑开别恨舟。\n水调声中多少事，暮烟林壑月明楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月色","author":"许月卿","text":"明月亦清哉，清风绝点埃。\n村童催睡去，野叟问禅来。\n乐事赏心夜，清风明月梅。\n夜深群籁静，猿鹤莫相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀","author":"许月卿","text":"桂犀明辨不雷同，长忆先师品藻公。\n风到如开香积国，月明疑在广寒宫。\n含香结佩风宜月，累印怀香月称风。\n酒里典刑幸犹在，先师酝藉孔林丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代仍六弟吊程贡元","author":"许月卿","text":"少从诸父与君游，到眼铭章泪莫收。\n水阔骑鲸霜叶落，波寒跃鲤雪蘋秋。\n当时折桂浮云梦，今日丛萱暮霭愁。\n惆怅人洪暗烟月，淡凝碑字湿松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代仍六弟吊程贡元 其三","author":"许月卿","text":"松下草不殖，豪家多不仁。\n惟君淡于水，与物静为春。\n多为流涕者，应无切齿人。\n墓前有梧槚，那复见荆榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代仍六弟吊程贡元 其二","author":"许月卿","text":"嚚讼渐成俗，如君今岂多。\n仲尼仁者静，下惠圣之和。\n夜月数声笛，春风一再歌。\n纷纷当泚颡，视此石嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代仍六弟吊程贡元 其一","author":"许月卿","text":"仁者竟不寿，世事空悠悠。\n霜满人洪墓，月寒尊美楼。\n慈乌千载恨，荐鹗一生休。\n画史成何事，青山烱照眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代弟二首 其二","author":"许月卿","text":"渭阳梦断几经年，幸甚东床再有缘。\n跃鲤庭中看铸鼎，乘龙门外待扬鞭。\n墓碑不载韩翱字，文集应传李汉编。\n愁满重慈鬓边雪，夜来风雨暗前川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代弟二首 其一","author":"许月卿","text":"少年卜式谩输边，毕竟乡人合荐贤。\n纯□□□忘寝食，浮名过眼谢腾骞。\n圣恩雨露荣亲日，春酒光风介寿天。\n世事到头都是梦，青衫赢得画图传。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵自述","author":"许月卿","text":"菊花开处即重阳，月桂中秋夜夜香。\n紫绶象环如鲁叟，纶巾羽扇亦周郎。\n不忧鸿雁稻粱少，但恐鹤猿松菊荒。\n宰相山中书几考，清风明月老平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵简如晦","author":"许月卿","text":"龙溪毓秀自平阳，千载诗葩分外香。\n锦里笃生天下士，玉堂曾看甲科郎。\n龙溪季子代无乏，鹗荐明年定破荒。\n桂树黄堂秋色里，何妨演习鹿鸣章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲春初五日报谒","author":"许月卿","text":"玉磬蒲团出定音，谒酬与世费浮沉。\n径松参汉周官肃，坞竹藏云商易深。\n暮色溪山皆有道，春风花草本无心。\n年来年去头成白，斗酒楼前明月斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和题黄免耕吟藁 其一","author":"许月卿","text":"免耕遗藁九京幽，宿诺吾方负仲由。\n宿诺斜阳悲宿草，沉思一旦落沉浮。\n池生春草虚堂梦，枫落吴江何处舟。\n有子九京如不死，一轮明月墓山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和题黄免耕吟藁 其二","author":"许月卿","text":"优游一辟难赞经，仲舒师友尽时名。\n已登乡国一经荐，未究天人三策情。\n文定浚源虽瑩彻，牧堂奕叶必敷荣。\n紫阳风水深留意，磨石佳城后世评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"献岁","author":"许月卿","text":"献岁欢声沸，清晨寒气侵。\n四时春是首，三日雨为霖。\n绿展垂杨眼，青呈芳草心。\n日晴仍夜雨，击壤费讴吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"许月卿","text":"一饮地黄酒，冤哉入九泉。\n云孤无葬地，雪霁有苍天。\n今岁难张咏，他年高董宣。\n视吾匣中剑，光射斗牛边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次允杰五首 其五","author":"许月卿","text":"瓣香曾侍鹤山俦，蜀有鹤林殊匪优。\n蜕作婴儿生我室，化为道士掠予舟。\n相同龟寿□鹏鴳，自混鸡群狎鹭鸥。\n仙子已骑黄鹤去，此地空馀黄鹤楼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次允杰五首 其四","author":"许月卿","text":"老鹤吾惭莺谷俦，扬州草檄类俳优。\n千年橘井雉城字，万斛桃花鹤料舟。\n为文待漏书丹凤，如此有盟寒白鸥。\n歌吹竹西惊昨梦，眼中骑鹤有高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次允杰五首 其三","author":"许月卿","text":"相鹤先经古罕俦，一诗檃括尔才优。\n云天杳杳仙骐骥，蓬海茫茫我楫舟。\n赴陇光荣空似凤，乘轩浩荡不如鸥。\n渊材多事添烦恼，一夜胎仙频倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次允杰五首 其二","author":"许月卿","text":"斯人非与更谁俦，咸以无心感最优。\n上下天光万顷碧，乾坤中处一虚舟。\n相从相语何妨鹤，才有机心不下鸥。\n平地人间无限阔，元龙何必卧危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次允杰五首 其一","author":"许月卿","text":"魏公间气孰能俦，纤若登梯量自优。\n父母床无烹子刃，相公腹有济川舟。\n江山之外云端鹤，天地中间海上鸥。\n学进识明涵受阔，连天远水月明楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其八","author":"许月卿","text":"平原平等视青州，不佛不仙仍不侯。\n满树丝萝天富贵，半窗水墨月风流。\n皆云临济具双眼，且放东坡出一头。\n劈画尚能千百岁，须臾一笑跨商周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其七","author":"许月卿","text":"诗律无寒□邺州，家风洗耳□□侯。\n□传以酒为真印，万法惟梅不共流。\n幸免五经嘲笥腹，可无百尺进竿头。\n从来此道飘零甚，戎索惟凭疆以周。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其六","author":"许月卿","text":"后山着意送荆州，相伴儿童饯细侯。\n风月夜深独先觉，乾坤秋老不同流。\n江闽凯悌地联脉，关陕规恢天尽头。\n闻说齐■妇唾手，世如用孔作东周。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其五","author":"许月卿","text":"老气轩昂盖四州，文场真将属条侯。\n君扶黄道青如许，我住花屏翠欲流。\n禁路促归一夔足，词场飞跨六鳌头。\n隐箕山上泉瓢许，歌大江东羽扇周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其四","author":"许月卿","text":"曾共芙蓉下视州，旧冲仍是醉乡侯。\n半山相俟归投老，若水公兮急退流。\n世事每观强努力，人生何似大刀头。\n摛文尽自染燕许，闲梦何妨我蝶周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其三","author":"许月卿","text":"公与梅溪生共州，一编默受似留侯。\n冰霜岁晚仝清节，泾渭胸中肯混流。\n皎日当空峨豸角，支天一柱属龙头。\n时清尽可巢由我，身健犹看师宰周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其二","author":"许月卿","text":"温州今似古青州，温饱能轻百户侯。\n沃力泉源那择地，岁寒砥柱屹中流。\n要知蝉□三公府，便是黄扉四状头。\n万事世间唐土尔，办将勋业到伊周。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次周尚书八首 其一","author":"许月卿","text":"卜隐偏宜大好州，浮云梦不到王侯。\n细评月露苍山峙，静止花阑绿水流。\n泉□□□□□□，□蓑无雨可淋头。\n西江宾幕相须久，赢得闲吟谒道周。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次胡伯凯韵","author":"许月卿","text":"日日常三绝，时时酒一杯。\n西铭炉上雪，太极地中雷。\n屏破青山出，池成绿水来。\n饭馀三两步，一树木犀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次绩溪赵簿孟英见投韵","author":"许月卿","text":"碧涧仙人亦爱楼，星溪楼上豁双眸。\n吟边兴落千峰外，醉里眉攒万国愁。\n传舍官途轻似燕，禅心世事狎于鸥。\n诗人将半南唐帝，碧涧云烟六月秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵云岩","author":"许月卿","text":"权舆于我屋渠渠，久敬如君世莫如。\n明月清风诗满案，好天良夜酒连车。\n樽前远韵轻盈菊，醉后分题烂慢书。\n凡此坐中人十九，钩枢玉带客金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶司户","author":"许月卿","text":"舟自摇摇钓濑滨，睦州司户得诗人。\n对床夜雨如苏子，满座春风似伯淳。\n文武略窥瑶殿射，婺衢争耀锦乡春。\n金华叶相垂青史，青出于蓝局局新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲成叔贺双桂桥","author":"许月卿","text":"展墓归来春水浮，桥头望月正如钩。\n桥成未用问谁住，意远应同逐水流。\n天外雁凫何足许，人间鹿豕可仝游。\n须知□□□□□，莫说存耕知有秋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱塘三首 其三","author":"许月卿","text":"谩着新亭俯碧漪，高低草树任差池。\n须知亭扁须时彦，不是溪斋不勇为。\n水静山深悉天趣，风光月霁足吾师。\n未妨赋诵铭颜乐，正学于戏无已时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱塘三首 其二","author":"许月卿","text":"游子从来悲故乡，归来襟袖芷兰芳。\n梦魂飞去云涛远，杖策闲行秋水光。\n可是梦中曾到此，安知身后却馀香。\n紫阳弟子有贤子，卜筑新亭真肯堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]