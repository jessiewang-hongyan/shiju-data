[{"title":"浣溪沙 其十九 赋微之提刑绣扇","author":"张孝祥","text":"只说闽山锦绣帏。\n忽从团扇得生枝。\n绉红衫子映丰肌。\n春线应怜壶漏永，夜针频见烛花摧。\n尘飞一骑忆来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"张孝祥","text":"妙手何人为写真。\n只难传处是精神。\n一枝占断洛城春。\n暮雨不堪巫峡梦，西风莫障庾公尘。\n扁舟湖海要诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十七 坐上十八客","author":"张孝祥","text":"同是瀛州册府仙。\n只今聊结社中莲。\n胡笳按拍酒如川。\n唤起封姨清晚景，更将荔子荐新圆。\n从今三夜看婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十二 母氏生辰，老者同在舟中","author":"张孝祥","text":"稳泛仙舟上锦帆。\n桃花春浪舞清湾。\n寿星相伴到人间。\n黄石公传三百字，西王母授九霞丹。\n银潢有路接三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 过临川席上赋此词","author":"张孝祥","text":"康乐亭前种此君。\n重来风月苦留人。\n儿童竹马笑谈新。\n今代孟士仍好客，政成归去眷方新。\n十眉环坐晚妆匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其八","author":"张孝祥","text":"已是人闲不系舟。\n此心元自不惊鸥。\n卧看骇浪与天浮。\n对月只应频举酒，临风何必更搔头。\n暝烟多处是神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十七 侑刘恭父别酒","author":"张孝祥","text":"射策金门记昔年。\n又交藩翰入陶甄。\n不妨衣钵再三传。\n粉泪但能添楚竹，罗巾谁解系吴船。\n捧杯犹愿小留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十五 再用韵","author":"张孝祥","text":"宫柳垂垂碧照空。\n九门深处五云红。\n朱衣只在殿当中。\n细捻丝梢龙尾北，缓携纶旨凤池东。\n阿婆三五笑春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"张孝祥","text":"湓浦从君已十年。\n京江仍许借归船。\n相逢此地有因缘。\n十万貔貅环武帐，三千珠翠入歌筵。\n功成去作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五 瑞香","author":"张孝祥","text":"腊后春前别一般。\n梅花枯淡水仙寒。\n翠云裘著紫霞冠。\n仙品只今推第一，清香元不是人间。\n为君更试小龙团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 过临川席上赋此词","author":"张孝祥","text":"我是临川旧史君。\n而今欲作岭南人。\n重来辽鹤事犹新。\n去路政长仍酷暑，主公交契更情亲。\n横秋阁上晚风匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"张孝祥","text":"玉节珠幢出翰林。\n诗书谋帅眷方深。\n威声虎啸复龙吟。\n我是先生门下士，相逢有酒且教斟。\n高山流水遇知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其九","author":"张孝祥","text":"冉冉幽香解钿囊。\n兰桡烟雨暗春江。\n十分清瘦为萧郎。\n遥忆牙樯收楚缆，应将玉箸点吴妆。\n有人萦断九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十一","author":"张孝祥","text":"晚雨潇潇急做秋。\n西风掠鬓已飕飕。\n烛花明夜酒花浮。\n醉眼定知非妙赏，□词端为□□留。\n想君泾渭不同流。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十四","author":"张孝祥","text":"鳷鹊楼高晚雪融。\n鸳鸯池暖暗潮通。\n郁金黄染柳丝风。\n油壁不来春草绿，栏干倚遍夕阳红。\n江南山色有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"张孝祥","text":"楼下西流水拍堤。\n楼头日日望春归。\n雪晴风静燕来迟。\n留得梅花供半额，要将杨叶画新眉。\n莫教辜负早春时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十三 梦山未释然，再作","author":"张孝祥","text":"一片西飞一片东。\n高情已逐落花空。\n旧欢休问几时重。\n结习正如刀舔蜜，扫除须著絮因风。\n请君持此问庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十八 用沈约之韵","author":"张孝祥","text":"细仗春风簇翠筵。\n烂银袍拂禁炉烟。\n旃书名字压宫垣。\n太学诸生推独步，玉堂学士合登仙。\n乃翁种德满心田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其七 亲旧蕲口相访","author":"张孝祥","text":"六客西来共一舟。\n吴儿踏浪剪轻鸥。\n水光山色翠相浮。\n我欲吹箫明月下，略须停棹晚风头。\n从前五度到蕲州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十六","author":"张孝祥","text":"日暖帘帏春昼长。\n纤纤玉指动抨床。\n低头佯不顾檀郎。\n豆蔻枝头双蛱蝶，芙蓉花下两鸳鸯。\n壁间闻得唾茸香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十二 次韵戏马梦山与妓作别","author":"张孝祥","text":"罗袜生尘洛浦东。\n美人春梦琐窗空。\n眉山蹙恨几千重。\n海上蟠桃留结子，渥洼天马去追风。\n不须多怨主人公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十四","author":"张孝祥","text":"霜日明霄水蘸空。\n鸣鞘声里绣旗红。\n澹烟衰草有无中。\n万里中原烽火北，一尊浊酒戍楼东。\n酒阑挥泪向悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其六 饯郑宪","author":"张孝祥","text":"宝蜡烧春夜影红。\n梅花枝傍锦薰笼。\n曲琼低卷瑞香风。\n万里江山供燕几，一时宾主看谈锋。\n问君归计莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 烟水亭蔡定夫置酒","author":"张孝祥","text":"滟滟湖光绿一围。\n修林断处白鸥飞。\n天机云锦蘸空飞。\n乞我百弓真可老，为公一饮醉忘归。\n扁舟日日弄晴晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十五","author":"张孝祥","text":"妒妇滩头十八姨。\n颠狂无赖占佳期。\n唤它滕六把春欺。\n僝僽莺莺并燕燕，恓惶柳柳与梅梅。\n东君独自落便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 刘恭父席上","author":"张孝祥","text":"卷旗直入蔡州城。\n只倚精忠不要兵。\n贼营半夜落妖星。\n万旅云屯看整暇，十眉环坐却娉婷。\n白麻早晚下天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十三 以贡茶、沈水为扬齐伯寿","author":"张孝祥","text":"北苑春风小凤团。\n炎州沈水胜龙涎。\n殷勤送与绣衣仙。\n玉食乡来思苦口，芳名久合上凌烟。\n天教富贵出长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十一 去荆州","author":"张孝祥","text":"方船载酒下江东。\n箫鼓喧天浪拍空。\n万山紫翠映云重。\n拟看岳阳楼上月，不禁石首岸头风。\n作笺我欲问龙公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"张孝祥","text":"绝代佳人淑且真。\n雪为肌骨月为神。\n烛前花底不胜春。\n倚竹袖长寒卷翠，凌波袜小暗生尘。\n十分京洛旧家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十六 洞庭","author":"张孝祥","text":"行尽潇湘到洞庭。\n楚天阔处数峰青。\n旗梢不动晚波平。\n红蓼一湾纹缬乱，白鱼双尾玉刀明。\n夜凉船影浸疏星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"张孝祥","text":"溪练写寒林。\n云重烟深。\n楼高风恶酒难禁。\n徙倚阑干谁共语，江上愁心。\n清兴满山阴。\n鸿断鱼沈。\n一书何啻值千金。\n独抚瑶徽弦欲断，凭寄知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其一","author":"张孝祥","text":"琪树间瑶林。\n春意深深。\n梅花还被晓寒禁。\n竹里一枝斜向我，欲诉芳心。\n楼外卷重阴。\n玉界沈沈。\n何人低唱醉泥金。\n掠水飞来双翠碧，应寄归音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其九","author":"张孝祥","text":"人间奇绝。\n只有梅花枝上雪。\n有个人人。\n梅样风标雪样新。\n芳心不展。\n嫩绿阴阴愁冉冉。\n一笑相看。\n试荐冰磐一点酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"张孝祥","text":"爱而不见。\n立马章台空便面。\n想像娉婷。\n只恐丹青画不成。\n诗人老去。\n恰要莺莺相伴住。\n试与平章。\n岁晚教人枉断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"张孝祥","text":"一尊留夜。\n宾蜡烘帘光激射。\n冻合铜壶。\n细听冰檐夜剪酥。\n清愁冉冉。\n酒唤红潮登玉脸。\n明日重看。\n玉界琼楼特地寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其五 琵琶亭林守、王食倅送别","author":"张孝祥","text":"江头送客。\n枫叶荻花秋索索。\n弦索休弹。\n清泪无多怕湿衫。\n故人相遇。\n不醉如何归得去。\n我醉忘归。\n烟满空江月满堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"张孝祥","text":"阿谁曾见。\n马上墙阴通半面。\n玉立娉婷。\n一点灵犀寄目成。\n明朝重去。\n人在横溪溪畔住。\n乔木千章。\n摇落霜风只断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"张孝祥","text":"枷花搦柳。\n知道东君留意久。\n惨绿愁红。\n憔悴都因一夜风。\n轻狂蝴蝶。\n拟欲扶持心又怯。\n要免离披。\n不告东君更告谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其七 黄坚叟母夫人","author":"张孝祥","text":"慈闱生日。\n见说今年年九十。\n戏彩盈门。\n大底孩儿七个孙。\n人间喜事。\n只这一般难得似。\n愿我双亲。\n都似君家太淑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其六 二十六日立春","author":"张孝祥","text":"春如有意。\n未接年华春已至。\n春事还新。\n多得年时五日春。\n春郊便绿。\n只向腊前春已足。\n屈指元宵。\n正是新春二十朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其八 赠尼师，旧角奴也","author":"张孝祥","text":"吹箫泛月。\n往事悠悠休更说。\n拍碎琉璃。\n始觉从前万事非。\n清斋净戒。\n休作断肠垂泪债。\n识破嚣尘。\n作个逍遥物外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一 江阴州治漾花池","author":"张孝祥","text":"佳人绝妙。\n不惜千金频买笑。\n燕姹莺娇。\n始遣清歌透碧霄。\n主人好事。\n更倒一尊留客醉。\n我醉思家。\n月满南池欲漾花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 其一 赠谈献可","author":"张孝祥","text":"谈子醉，独立睨东风。\n未试玉堂挥翰手，只今楚泽钓鱼翁。\n万事举杯空。\n谋一笑，一笑与君同。\n身老南山看射虎，眼高四海送飞鸿。\n赤岸晚潮通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其二 南岳铨德观作","author":"张孝祥","text":"朝元去，深殿扣瑶钟。\n天近月明黄道冷，参回斗转碧霄空。\n身在九光中。\n风露下，环佩响丁东。\n玉案烧香萦翠凤，松坛移影动苍龙。\n归路海霞红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其三 梅","author":"张孝祥","text":"吹香嚼蕊。\n独立东风里。\n玉冻云娇天似水。\n羞杀夭桃秾李。\n如今见说阑干。\n不禁月冷霜寒。\n垄上驿程人远，楼头戍角声乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一 殿庐有作","author":"张孝祥","text":"光尘扑扑。\n宫柳低迷绿。\n斗鸭阑干春诘曲。\n帘额微风绣蹙。\n碧云青翼无凭。\n困来小倚银屏。\n楚梦未禁春晚，黄鹂犹自声声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其四 寿叔父","author":"张孝祥","text":"英姿慷慨。\n独立风尘外。\n湖海平生豪气在。\n行矣云龙际会。\n充庭兰玉森森。\n一觞共祝修龄。\n此地去天尺五，明年持橐西清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二 杨侯书院闻酒所奏乐","author":"张孝祥","text":"油幢画戟。\n玉铉调春色。\n勋阀诸郎俱第一。\n风流前辈敌。\n玉人双鞚华□。\n翠云深处消摇。\n有客留君东阁，时闻风下笙箫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其五","author":"张孝祥","text":"向来省户。\n谋国参伊吕。\n暂借良筹非再举。\n谈笑肃清三楚。\n良辰上客徜徉。\n奏篇犹记传香。\n此日一尊相属，它时同在岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 红白莲不可并栽，用酒盆种之，遂皆有花，呈周倅","author":"张孝祥","text":"红白莲房生一处。\n雪肌霞艳难为喻。\n当是神仙来紫府。\n双禀赋。\n人间相见犹相妒。\n清雨轻烟凝态度。\n风标公子来幽鹭。\n欲遣微波传尺素。\n歌曲误。\n醉中自有周郎顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"张孝祥","text":"晓来江上荻花秋。\n做弄个离愁。\n半竿残日，两行珠泪，一叶扁舟。\n须知此去应难遇，直待醉方休。\n如今眼底，明朝心上，后日眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其十三 舣舟采石","author":"张孝祥","text":"十年长作江头客。\n樯竿又挂西风席。\n白鸟去边明。\n楚山无数青。\n倒冠仍落佩。\n我醉君须醉。\n试问识君不。\n青山与白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其五 赠筝妓","author":"张孝祥","text":"琢成红玉纤纤指。\n十三弦上调新水。\n一弄入云声。\n月明天更青。\n匆匆莺语啭。\n待寓昭君怨。\n寄语莫重弹。\n有人愁倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 立春","author":"张孝祥","text":"丝金缕翠幡儿小。\n裁罗捻线花枝袅。\n明日是新春。\n春风生鬓云。\n吴霜看点点。\n愁里春来浅。\n只愿此花枝。\n年年长带伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其十五","author":"张孝祥","text":"胭脂浅染双珠树。\n东风到处娇无数。\n不语恨厌厌。\n何人思故园。\n故园花烂熳。\n笑我归来晚。\n我老只思归。\n故园花雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其十二","author":"张孝祥","text":"蘼芜白芷愁烟渚。\n曲琼细卷江南雨。\n心事怯衣单。\n楼高生晚寒。\n云鬟香雾湿。\n翠袖凄馀泣。\n春去有来时，春从沙际归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其十一","author":"张孝祥","text":"缥缈飞来双彩凤。\n雨疏云淡撩清梦。\n兰薄未禁秋。\n月华如水流。\n采香溪上路。\n愁满参差树。\n独倚晚楼风。\n断霞萦素空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 回文","author":"张孝祥","text":"落霞残照横西阁。\n阁西横照残霞落。\n波浅戏鱼多。\n多鱼戏浅波。\n手携行客酒。\n酒客行携手。\n肠断九歌长。\n长歌九断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"张孝祥","text":"玉龙细点三更月。\n庭花影下馀残雪。\n寒色到书帏。\n有人清梦迷。\n墙西歌吹好。\n烛暖香闺小。\n多病怯杯觞。\n不禁冬夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其八","author":"张孝祥","text":"雪消墙角收灯后。\n野梅官柳春全透。\n池阁又东风。\n烛花烧夜红。\n一尊留好客。\n敧尽阑干月。\n已醉不须归。\n试听乌夜啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其十四 和州守胡明秀席上","author":"张孝祥","text":"乳羝属国归来早。\n知君胆大身犹小。\n一节不须论。\n功名看致君。\n镇西楼上酒。\n父老为公寿。\n更祝太夫人。\n年年封诏新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其十七","author":"张孝祥","text":"冥濛秋夕漙清露。\n玉绳耿耿银潢注。\n永夜滴铜壶。\n月华楼影孤。\n佳人纡绝唱。\n翠幕丛霄上。\n休劝玉东西。\n乌鸦枝上啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"张孝祥","text":"东风约略吹罗幕。\n一檐细雨春阴薄。\n试把杏花看。\n湿红娇暮寒。\n佳人双玉枕。\n烘醉鸳鸯锦。\n折得最繁枝。\n暖香生翠帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三 回文","author":"张孝祥","text":"晚花残雨风帘卷。\n卷帘风雨残花晚。\n双燕语虚窗。\n窗虚语燕双。\n睡醒风惬意。\n意惬风醒睡。\n谁与话情诗。\n诗情话与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 林柳州生朝","author":"张孝祥","text":"史君家枕吴波碧。\n朱门铺手摇双戟。\n也到岭边州。\n真成汗漫游。\n归期应不远。\n趁得东江暖。\n翁媪雪垂肩。\n双双平地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四 回文","author":"张孝祥","text":"白头人笑花间客。\n客间花笑人头白。\n年去似流川。\n川流似去年。\n老羞何事好。\n好事何羞老。\n红袖舞香风。\n风香舞袖红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]