[{"title":"庾楼","author":"洪咨夔","text":"湓城陶庾共功名，庙食楼居孰重轻。\n衮衮长江流不尽，淮山青处夕阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚食","author":"洪咨夔","text":"从来此腹负将军，淡饭投齑现报身。\n三月不曾知笋蕨，梦魂敢到水晶鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚凉","author":"洪咨夔","text":"樛枝阴合翠熏笼，曲曲斜斜石径通。\n窈眇蝉声缲独茧，为渠立尽晚来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其二","author":"洪咨夔","text":"繁芳玉立夹胡床，勾引春韶午梦长。\n有眼尽迷空里色，无心方识定中香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其三","author":"洪咨夔","text":"竹屋茅檐一树斜，冰霜意气盖韶华。\n有馀不尽如知道，半已青青半尚花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其四","author":"洪咨夔","text":"桃花红艳照银床，黄入金明柳线长。\n欲与晚梅相辈行，同时到底不同香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其一","author":"洪咨夔","text":"寒瓶虚插一枝斜，留待春风放霁华。\n已信不冰方着水，可怜欲槁更开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其二","author":"洪咨夔","text":"苍枝老去藓痕乾，唤起东风点暮寒。\n会得生生无尽意，雪花零乱月栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其一","author":"洪咨夔","text":"风霜摇落都卢尽，一点春回造化家。\n万物成终又成始，须将艮体看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其一","author":"洪咨夔","text":"玉佩琼裾萼绿华，铜瓶清浸广寒家。\n客怀无着春风处，醉向梢头嚼尽花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其二","author":"洪咨夔","text":"寒根不与物俱陈，髁髁梢头寂寂春。\n却月凌风谁会得，不沾一叶是真身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明 其二","author":"洪咨夔","text":"风将好梦到兰亭，惊觉虚檐九子铃。\n老眼醒来无着处，倚楼检校树头青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明 其一","author":"洪咨夔","text":"梨花匼匝不见叶，柳穟玲珑初欲绵。\n寒食清明等闲过，日长翻覆压书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清凉院僧房致斋","author":"洪咨夔","text":"花片墙阴晚，禽声屋角晴。\n东风犹峭在，煨芋坐深明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续梦","author":"洪咨夔","text":"琉璃庭扣水晶栏，宝树婆娑玉斧闲。\n只恐姮娥嫌冷落，却随飞月下人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铨闱董试上巳二绝 其一","author":"洪咨夔","text":"天气年年只么新，官忙不似旧闲身。\n油车画舫西湖闹，可惜埋头典却春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪叹 其一","author":"洪咨夔","text":"唐时三月十八雪，况复今年多一旬。\n万紫千红浑过尽，荼蘼满架与争春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪叹 其二","author":"洪咨夔","text":"桑颖骚骚麦又萎，雪花如椀雨如丝。\n老天只解苦黔首，快活贵人那得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨一绝简赵丞","author":"洪咨夔","text":"龙公有眼识英材，好雨随声唤得来。\n酒面添如田水满，眉头放与稻花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒暄不齐 其二","author":"洪咨夔","text":"次第新烟欲试茶，铮铮飞霰响檐牙。\n惜春苦欲春长在，且得轻寒约住花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒暄不齐 其一","author":"洪咨夔","text":"社后归来燕两三，门前细柳绿掺掺。\n乞将蝴蝶蜻蜓扇，与试鹅黄水碧衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敞云楼 其一","author":"洪咨夔","text":"江天云作黑山颓，上到楼头手决开。\n水墨枕屏三百里，斜阳属玉一双来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敞云楼 其二","author":"洪咨夔","text":"草树成行整复斜，江头白处定芦花。\n夜深更着无边月，好个楼居处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"普照僧生云轩云闲阁 其一","author":"洪咨夔","text":"岩芳敛空华，谷响答虚牝。\n坐看白云生，会得无生忍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑坐","author":"洪咨夔","text":"隔帘草树隔溪山，密密深深洞启关。\n水色山光无障碍，南风送入乱书间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝南以诗送巴石研屏香几用韵 其二 研屏","author":"洪咨夔","text":"首鼠年来困两端，石屏空照鬓丝斑。\n归舟莫道全无物，分得蓬婆小雪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝南以诗送巴石研屏香几用韵 其二 香几","author":"洪咨夔","text":"竹风吹酒未全醒，梦入香炉五老云。\n好句得君青玉案，起来盥手炷清熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝南以诗送巴石研屏香几用韵 其一 香几","author":"洪咨夔","text":"玉版横陈醉眼边，尚馀金鸭水沉烟。\n客窗寂寂那消得，祗有南丰一瓣缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"温泉院 其二","author":"洪咨夔","text":"神虎护泉寒翠壁，灵虬吐沫暖冰壶。\n玉环不碎征尘里，更引三郎到古渝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"温泉院 其一","author":"洪咨夔","text":"老火欺人客路长，舣舟取次浴温汤。\n犬鸣三峡夜逾静，月上四更天始凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答子有","author":"洪咨夔","text":"裹饭无人过子桑，拒霜一径雨昏黄。\n花根记缚西湖缆，红浅红深醉夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答吴叔永叔长 其一","author":"洪咨夔","text":"刮霜面目澹无华，落落孤山处士家。\n若使世间蜂蝶觉，光风纵好不成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答吴叔永叔长 其二","author":"洪咨夔","text":"瓶笙吹彻砚蜍乾，独有梅花伴夜寒。\n万境空明香一点，世尘元自不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答家朝南 其二","author":"洪咨夔","text":"角声悽惋笛声乾，独立黄昏不柰寒。\n未省半山梅在否，东风归路忆长干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答家朝南 其一","author":"洪咨夔","text":"竹光水色近宣华，彷佛江南万里家。\n可是老谙春寂寞，夜深无梦到梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答高才卿 其一","author":"洪咨夔","text":"烟波只艇着吾徒，莼鲙秋风早忆吴。\n左蟹右杯东计决，醉来万事付含糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答高才卿 其二","author":"洪咨夔","text":"脆胜芎苗软胜脂，雅宜碧椀贮流离。\n渠渠地主恩何在，骨里黄金祗自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答程教见和梅诗 其二","author":"洪咨夔","text":"春阴欲雪冻云乾，索笑疏枝共一寒。\n静里闻香祗自觉，怕人饶舌似丰干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答程教见和梅诗 其一","author":"洪咨夔","text":"一段清冰浸月华，短篱疏竹是谁家。\n春光元不分吴蜀，惊见江南半树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答程嘉定 其二","author":"洪咨夔","text":"铃索闲闲静冶堂，槐阴匼匝柳丝长。\n东君五日如京兆，早及残红醉艳阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答程嘉定 其一","author":"洪咨夔","text":"练袂蒿簪不下堂，肯随时世画眉长。\n旁人莫解东风意，只道花梢合向阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"臈中步月 其二","author":"洪咨夔","text":"卖妻鬻子年饥后，索母求爷贼乱馀。\n对月椎胸几家哭，更堪萧索岁将除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"臈中步月 其一","author":"洪咨夔","text":"平山堂下解围去，天水堡前经战来。\n天地无情一般月，照人霜骨白皑皑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幕官相约观芳草于法曹之亭黄宰病不至以诗来因次韵","author":"洪咨夔","text":"似无细雨还应有，欲落馀花更复留。\n草际水边青未了，可禁杯酒为扶头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新月","author":"洪咨夔","text":"天面如人面，昏昏镇是愁。\n晚来云色解，新月放眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚城靖节祠","author":"洪咨夔","text":"雨引莓苔上短垣，流泉无恙自涓涓。\n不如归去来兮好，百世闻风只杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楞伽山房 其一","author":"洪咨夔","text":"八万猊床方丈室，九千书卷半边窗。\n儋翁句子无人问，流水泠泠度石矼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其二","author":"洪咨夔","text":"是非不验道应坏，祸福无凭天也荒。\n便使曹瞒生卖履，已赊王衍死排墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其六","author":"洪咨夔","text":"避风台上深情宠，偃月堂中尽意谋。\n争柰天公无面目，满林黄叶一番秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其五","author":"洪咨夔","text":"两仪亦有盈亏数，万物难逃出入机。\n一把牙筹空自苦，盖棺着得几通衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其一","author":"洪咨夔","text":"平泉草木须臾梦，金谷莺花一撮尘。\n富贵若生根到底，两家占断别无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其八","author":"洪咨夔","text":"元子扫空桓氏业，窟郎荡尽李家风。\n前人留得儿孙立，何患鸾枝不长桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其三","author":"洪咨夔","text":"何人地下管天条，不是皋陶即是萧。\n金埒谩誇钱过斗，铁围宁问玉垂腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其十","author":"洪咨夔","text":"命有穷通分虎鼠，事无得失尽鸡虫。\n东篱独有黄花在，挹取寒香寿阿翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其九","author":"洪咨夔","text":"方穷蔡泽问唐举，未遇邺侯逢懒残。\n触石起云能沛雨，不应长作旱雷看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人初冬寓笔十绝 其四","author":"洪咨夔","text":"当场弄出百般奇，傀儡棚中老偃师。\n满眼机关无着处，到头线索有收时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人莲桂 其一","author":"洪咨夔","text":"点破秋光数叶荷，水清时见小鱼过。\n渟涵风露三更足，收拾江湖万顷多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨和老人莲桂 其二","author":"洪咨夔","text":"捣成一百八丸黄，入手能令热恼凉。\n金粟如来身已化，蕊珠仙子骨犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"路逢徽州送牡丹入都","author":"洪咨夔","text":"飞絮游丝弄霁华，出门芳草渺天涯。\n太平莫道全无象，脱绣鸣铃传送花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉陵江舟中 其二","author":"洪咨夔","text":"辛夷零落水生漪，睡暖沙凫荫酒旗。\n不是归帆相料理，春光如许底能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉陵江舟中 其一","author":"洪咨夔","text":"柳色黄黄草色微，一川新渌两红衣。\n老天也信还家好，淡日柔风送客归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉陵江舟中 其三","author":"洪咨夔","text":"东风吹老地棠花，燕子归来认得家。\n茅屋石田浑好在，白头何苦尚天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其五 皇帝閤","author":"洪咨夔","text":"登进英才追庆历，开延正论踵咸平。\n朝廷有道长如此，拜赐宫衣信是荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其三 皇帝閤","author":"洪咨夔","text":"明进离方午，柔生遇已阴。\n妙参三圣易，细测两仪心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其四 皇帝閤","author":"洪咨夔","text":"缉熙虚敞薰飔细，清燕深明昼晷长。\n大学中庸翻咏久，金猊几度手添香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其二 皇帝閤","author":"洪咨夔","text":"雨足秧分圳，风清麦弄岐。\n圣心涵水镜，即是太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其六 皇帝閤","author":"洪咨夔","text":"王师一举下河东，好定规摹继伐功。\n入眼宫槐宜夏日，转头关柳易秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其一 皇帝閤","author":"洪咨夔","text":"更化开皇极，中兴兆赤符。\n节摽千岁历，气协五时图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其五 贵妃閤","author":"洪咨夔","text":"穿莲漏永金铺邃，雪藕衣轻玉殿凉。\n好把无邪毋不敬，细挑綵字寿君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其二 贵妃閤","author":"洪咨夔","text":"萱长宜男草，榴开结子花。\n欢声喧令节，庆事属天家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其四 贵妃閤","author":"洪咨夔","text":"裁成宝月翻宫扇，织就祥云制御衣。\n朝贺归来无点暑，坐看燕子引雏飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其一 贵妃閤","author":"洪咨夔","text":"佩袭芳兰碧，钗明宝篆红。\n深宫三十六，同被二南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平二年端午帖子词 其三 贵妃閤","author":"洪咨夔","text":"绮疏浸影槐龙转，绣户浮香艾虎垂。\n砚冷玉蜍金井水，手抄警戒爱君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其一 皇后閤","author":"洪咨夔","text":"太液轻澌泮，温明霁日融。\n菜流芳荇碧，花颂瑞椒红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其五 皇后閤","author":"洪咨夔","text":"殷雷金钥千门邃，斜月璇题六寝深。\n禁柳护寒鸦未起，求衣已献晚朝箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其二 皇后閤","author":"洪咨夔","text":"甲观韶光集，禖坛好语传。\n思齐男庆百，假乐子宜千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其四 皇后閤","author":"洪咨夔","text":"关雎风化冠周南，次第桃夭及葛覃。\n农事未兴先献种，女红方起又亲蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其三 皇后閤","author":"洪咨夔","text":"涂山阴赞夏王化，妫汭密裨虞帝仁。\n保合大和无间断，际天蟠地一般春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]