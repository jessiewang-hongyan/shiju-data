[{"title":"甲子初春即事六首 其五","author":"杨万里","text":"骤暖如初夏，通身退裌衣。\n只言寒已去，却等五更归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初春即事六首 其四","author":"杨万里","text":"只有观书乐，其如病眼何。\n但令吾意适，不必卷头多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初春即事六首 其三","author":"杨万里","text":"径李浑秾白，山桃半淡红。\n杏花红又白，非淡亦非秾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初春即事六首 其二","author":"杨万里","text":"腊去寒犹在，春来花未开。\n东风忽然到，放尽一园梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初春即事六首 其一","author":"杨万里","text":"老子烧香罢，蜂儿作队来。\n徘徊绕襟袖，将谓是花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲午出知漳州晚发船龙山暮宿桐庐二首 其二","author":"杨万里","text":"道涂奔走不曾安，却羡山家住得闲。\n记取还山安住日，更忘奔走道涂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲午出知漳州晚发船龙山暮宿桐庐二首 其一","author":"杨万里","text":"一席清风万壑云，送将华发得归身。\n海潮也怯桐江净，不遣涛头过富春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲申上元前闻家君不快西归见梅有感二首 其二","author":"杨万里","text":"千里来为五斗谋，老亲望望且归休。\n春光尽好关侬事，细雨梅花只做愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲申上元前闻家君不快西归见梅有感二首 其一","author":"杨万里","text":"官路桐江西复西，野梅千树压疏篱。\n昨来都下筠篮底，三百青钱买一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅二月十八日牡丹初发","author":"杨万里","text":"排日上牙牌，记花先后开。\n看花不子细，过了却重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白头吟二首 其二","author":"杨万里","text":"除却共姜是女师，柏舟便到白头辞。\n劝渠莫怨终难劝，不道前夫怨阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白头吟二首 其一","author":"杨万里","text":"文君自制白头吟，怨思来时海未深。\n怨杀相如偿底事，初头苦信一张琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白含笑","author":"杨万里","text":"薰风晓破碧莲莟，花意犹低白玉颜。\n一粲不曾容易发，清香何自遍人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鱼羹戏题","author":"杨万里","text":"秋水寒鱼白锦鳞，姜花枨实献芳辛。\n东坡玉糁真穷相，得似先生此味珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白莲","author":"杨万里","text":"井花新插白芙蕖，坐看纷纷脱雪肤。\n自拾落英浮水面，玉舟撩乱满江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白莲","author":"杨万里","text":"花头素片剪成冰，叶背青琼刻作棱。\n珍重儿童轻手折，绿针刺手却渠憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白菊二首 其二","author":"杨万里","text":"霜后黄花顿不中，独馀白菊斗霜浓。\n与霜更斗晴天日，斗得霜融菊不融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白菊二首 其一","author":"杨万里","text":"白菊初开也自黄，开来开去白如霜。\n小蜂劣得针来大，不怕清寒嗅冷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日","author":"杨万里","text":"何处新春好，深山处士家。\n风光先著柳，日色款催花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日有怀二首 其一","author":"杨万里","text":"飘蓬敢恨一年迟，客里春光也自宜。\n白玉青丝那得说，一杯咽下少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日有怀二首 其二","author":"杨万里","text":"玉堂著句转春风，诸老从前亦寓忠。\n谁为君王供帖子，丁宁绮语不须工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋日闻蝉","author":"杨万里","text":"老火薰人欲破头，唤秋不到得人愁。\n夜来一雨将秋至，今晚蝉声始报秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋后一日雨天欲暮小立问月亭","author":"杨万里","text":"雨后林中别样凉，意行幽径不知长。\n风蝉幸自无星事，强为闲人报夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记丘宗卿咽冰语","author":"杨万里","text":"醉咽冰丸不作难，不须碎嚼不须餐。\n听渠历历胸中过，一寸诗肠一寸寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦三首 其三","author":"杨万里","text":"雾外知何寺，钟声只隔山。\n望来无里许，还在九霄间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦三首 其二","author":"杨万里","text":"水动花梢动，花摇水影摇。\n不知各无意，为复两相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦三首 其一","author":"杨万里","text":"云袖危相复，霜钟韵政迟。\n忽然数声急，却是住撞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙山送客二首 其二","author":"杨万里","text":"无奈乡愁只强忘，龙山唤起再思乡。\n故乡依旧千山外，却被龙山断杀肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙山送客二首 其一","author":"杨万里","text":"念念还乡未得还，偶因送客到龙山。\n分明认得西归路，只是回车却入关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亦山亭前梅子","author":"杨万里","text":"道傍小树复低枝，摘尽青梅肯更遗。\n偶尔叶间留一个，且看漏眼几多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲冬诏追造朝供尚书郎职舟行阻风青泥三首 其二","author":"杨万里","text":"破篱外面即江流，枯树梢头总客愁。\n隔水远山浓复淡，殷勤点缀一川秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日城上三首 其三","author":"杨万里","text":"望中远树各依行，春后新晴未断霜。\n池面得风呈绉碧，梅须经雨褪危黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日城上三首 其二","author":"杨万里","text":"休日呼儿上古城，胡床何处不随行。\n莫嫌一阵东风恶，分外教他数日晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日城上三首 其一","author":"杨万里","text":"到得荆溪鬓尽斑，二年心力不曾闲。\n如今归去无馀恋，只有梅花惨别颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日晚步二绝句 其一","author":"杨万里","text":"未须急访社中狂，且到西园探海棠。\n今岁行春虽较晚，也胜雨里度春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日晚步二绝句 其二","author":"杨万里","text":"晚云欲雨又欲晴，天借吾人作此行。\n莫道行春无去处，山矾香里听溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日登城","author":"杨万里","text":"爱他休日更新晴，忍却春寒上古城。\n废垒荒芦无一好，春来微径总堪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓登万花川谷看海棠二首 其二","author":"杨万里","text":"准拟今春乐事浓，依前枉却一东风。\n年年不带看花福，不是愁中即病中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再病书怀呈仲良四首 其一","author":"杨万里","text":"病身谁伴亦谁怜，赢得昏昏几觉眠。\n睡起不知身是病，踞床看尽水沉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再病书怀呈仲良四首 其二","author":"杨万里","text":"病中嫌雨又嫌晴，自是情怀未苦平。\n两日雨多端不恶，市声洗尽只檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再病书怀呈仲良四首 其四","author":"杨万里","text":"方外诗豪张仲良，义风今日更谁双。\n绝怜病客无半眼，粥饭随宜到小窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再病书怀呈仲良四首 其三","author":"杨万里","text":"功名销尽向来心，诗酒从今也不禁。\n夜雨遣人归思动，不知湘水几篙深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再登垂虹亭三首 其三","author":"杨万里","text":"长年三老不须催，且据胡床未拟回。\n白昼惊人星满地，日光碎处万波来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再登垂虹亭三首 其二","author":"杨万里","text":"宿酲作恼未惺松，一对湖光酒病空。\n身到吴中无好处，三年两度上垂虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再登垂虹亭三首 其一","author":"杨万里","text":"红尘不解送诗来，身在烟波句自佳。\n银汉光中有诗客，玉虹背上曳芒鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"农家叹","author":"杨万里","text":"两月春霖三日晴，久寒初暖稍秧青。\n春工只要花迟著，愁损农家管得星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘村渡二首 其二","author":"杨万里","text":"旷野风从脚底生，远峰顶与额般平。\n何人知道诚斋叟，独著驼裘破雨行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘村渡二首 其一","author":"杨万里","text":"隔岸轻舟不可呼，小桥独木有如无。\n落松满地金钗瘦，远树黏天菌子孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同子文材翁子直萧巨济中元夜东园望月二首 其二","author":"杨万里","text":"月到东园分外光，行行坐坐间传觞。\n生愁踏碎千花影，回顾千花总不妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同子文材翁子直萧巨济中元夜东园望月二首 其一","author":"杨万里","text":"杂碎轻云白锦鳞，十分圆月湿银盆。\n锦鳞散尽银盆在，依旧青天无点痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同才翁弟游东园","author":"杨万里","text":"东园花径半莓苔，老子多时不到来。\n一巷江梅都落尽，祇今开底是红梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同尤延之京仲远玉壶饯客二首 其二","author":"杨万里","text":"金杯玉酒沈寒冰，青李来禽尚带生。\n不是此间无暑气，湖风吹取过临平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同尤延之京仲远玉壶饯客二首 其一","author":"杨万里","text":"南漪亭上据胡床，不负西湖五月凉。\n十里水风已无价，水风底里更荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同刘季游登天柱冈四首 其四","author":"杨万里","text":"偶然乘兴上孱颜，若待偷闲何日闲。\n脚力到时皆我有，不须更问是谁山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同次公观细陂小坐行店","author":"杨万里","text":"店歇疑为旅，溪行当出郊。\n莓苔依断蓼，翡翠上寒梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同君俞季永步至普济寺晚泛西湖以归得四绝句 其四","author":"杨万里","text":"曲曲都城缭翠微，鳞鳞湖浪动斜晖。\n天寒日暮游人少，两岸轻舟星散归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同君俞季永步至普济寺晚泛西湖以归得四绝句 其一","author":"杨万里","text":"阁日微阴不碍晴，杖藜小倦且须行。\n湖山有意留侬款，约束疏钟未要声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同君俞季永步至普济寺晚泛西湖以归得四绝句 其三","author":"杨万里","text":"西湖虽老为人容，不必花时十里红。\n卷取郭熙真水墨，枯荷折苇小霜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同君俞季永步至普济寺晚泛西湖以归得四绝句 其二","author":"杨万里","text":"烟艇横斜柳港湾，云山出没柳行间。\n登山得似游湖好，却是湖心看尽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日 其三","author":"杨万里","text":"冰壶底里步金沙，真到林逋处士家。\n未办寒泉荐秋菊，且将瘦句了梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日 其二","author":"杨万里","text":"紫陌微乾未放尘，青鞋不惜涴泥痕。\n春风已入寒蒲节，残雪犹依古柳根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日 其一","author":"杨万里","text":"湖暖开冰已借春，山晴留雪要娱人。\n昨游未当清奇在，踏冻重来眼却新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日 其四","author":"杨万里","text":"道堂高绝俯空明，上下跻攀取意行。\n净阁虚廊人寂寂，鹤声断处忽琴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回望峡山二首 其二","author":"杨万里","text":"浪喜出峡来，峡亦何曾出。\n两岸只无山，依旧江刻屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回望峡山二首 其一","author":"杨万里","text":"英州挽不来，峡山推不去。\n行了一日船，依旧朝来处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩丁词十解 其五","author":"杨万里","text":"两岸沿堤有水门，万波随吐复随吞。\n君看红蓼花边脚，补去脩来无水痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩丁词十解 其一","author":"杨万里","text":"圩田元是一平湖，凭仗儿郎筑作圩。\n万雉长城倩谁守，两堤杨柳当防夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩丁词十解 其三","author":"杨万里","text":"上通建德下当涂，千里江湖缭一圩。\n本是阳侯水精国，天公敕赐上农夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩丁词十解 其八","author":"杨万里","text":"岸头石板紫纵横，不是修圩是筑城。\n传语赫连莫蒸土，霸图未必赛春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩丁词十解 其六","author":"杨万里","text":"年年圩长集圩丁，不要招呼自要行。\n万杵一鸣千畚土，大呼高唱总齐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩丁词十解 其七","author":"杨万里","text":"儿郎辛苦莫呼天，一日修圩一岁眠。\n六七月头无点雨，试登高处望圩田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩田二首 其二","author":"杨万里","text":"古来圩岸护堤防，岸岸行行种绿杨。\n岁久树根无寸土，绿杨走入水中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圩田二首 其一","author":"杨万里","text":"周遭圩岸缭金城，一眼圩田翠不分。\n行到秋苗初熟处，翠茸锦上织黄云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夙兴待旦二绝 其二","author":"杨万里","text":"村里无铜漏，金鸡管杀更。\n百声犹未晓，却等第三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夙兴待旦二绝 其一","author":"杨万里","text":"觉后难重睡，醉馀还独醒。\n东窗不肯白，挑尽一灯青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多稼亭上望三山中峰独秀而低","author":"杨万里","text":"三山道是远连天，亭上看来只近檐。\n可惜当初低少许，三山幸有一峰尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多稼亭日色甚暖忽有雪数片自晴空而下已而复无","author":"杨万里","text":"霁日何曾惹寸云，忽飞些子雪如尘。\n不知底处天花落，风里吹来数点春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]