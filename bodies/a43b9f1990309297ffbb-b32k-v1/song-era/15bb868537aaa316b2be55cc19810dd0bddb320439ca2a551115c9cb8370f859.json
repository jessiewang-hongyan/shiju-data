[{"title":"采石怀古","author":"梅尧臣","text":"青峰来合沓，势压大江雄。\n舟渡神兵后，城荒王气空。\n山根鱼浪白，岩壁石萝红。\n弄月人何在，孤坟细草中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金山寺","author":"梅尧臣","text":"吴客独来后，楚桡归夕曛。\n山形无地接，寺界与波分。\n巢鹘宁窥物，驯鸥自作群。\n老僧忘岁月，石上看江云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵三首 其三","author":"梅尧臣","text":"每入秦淮口，风波更不忧。\n重看后庭树，还起旧时愁。\n故老都无有，遗踪莫可求。\n何人能识意，白鹭在寒洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵三首 其二","author":"梅尧臣","text":"金陵逢晓雪，撩乱逗云来。\n已失乌衣巷，还成白玉台。\n山盘犹隐见，江转似昭回。\n一听高楼笛，依稀认落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵三首 其一","author":"梅尧臣","text":"恃险不能久，六朝今已亡。\n山形象龙虎，宫地牧牛羊。\n江上鸥无数，城中草自长。\n临流邀月饮，莫挂一毫芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金霞阁","author":"梅尧臣","text":"登临无尽兴，清燕日徘徊。\n霞影缘觚落，岚光入牖来。\n离宫分碧瓦，太液俯青槐。\n好待邀明月，瑶琴为一开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"梅尧臣","text":"春云易成雨，一日几回阴。\n燕湿飞犹快，花寒色更深。\n邀车愁客远，盘马畏泥侵。\n向晚晴光吐，西窗绿影临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯彭城公赴随州龙门道上作","author":"梅尧臣","text":"零雨送车轮，初清远陌尘。\n归藩汉东国，遮道洛阳人。\n伊水照虹旆，楚山怀玉麟。\n征轩不可恋，梗泪返城闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鱼","author":"梅尧臣","text":"洛水美赪鲤，入河西去时。\n三春登玉浪，一日到天池。\n垂钓岂容羡，小鳞应莫随。\n腹中无匕首，已不助吴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"前此诸韩来饮独仲连以小儿病不至明日仲连有夜坐见怀之什因成答章","author":"梅尧臣","text":"夜与贤豪饮，方闻默坐时。\n我斟相乐酒，君咏寄来诗。\n莫恨殊喧寂，真缘笃爱慈。\n何当因雪兴，过此未应迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳谢紫微挽词三首 其三","author":"梅尧臣","text":"自古岂无死，贤哉独可悲。\n家贫留旅榇，门庆有诸儿。\n里社当存祀，邦人定立碑。\n还同羊叔子，罢市见遗思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳谢紫微挽词三首 其二","author":"梅尧臣","text":"平昔闻严助，承明厌直庐。\n请章来未久，捐馆遽何如。\n无复淮南谕，曾成太史书。\n苍苍不可问，挥涕望輀车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南阳谢紫微挽词三首 其一","author":"梅尧臣","text":"忽惊南郊信，半夜雪中来。\n遂哭寝门外，始嗟梁木摧。\n文章千古盛，风韵故人哀。\n忆昨临湍水，宁知隔夜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客郑遇昙颖自洛中东归","author":"梅尧臣","text":"禅衣本坏色，不化洛阳尘。\n独有烟霞染，况将山水亲。\n西风入关戍，宿雨过城闉。\n谁羡飘然迹，吾车亦已巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其二十","author":"梅尧臣","text":"宛水过城下，滔滔北去斜。\n远船来橘蔗，深步上鱼虾。\n鹅美冒椒叶，蜜香闻稻花。\n岁时风俗美，笑杀异乡槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十九","author":"梅尧臣","text":"传道零陵守，兹亭暂解装。\n分群同雁鹜，几日到潇湘。\n班竹思虞舜，赪萍忆楚王。\n殷勤吏部句，今亦诵无忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十八","author":"梅尧臣","text":"斫漆高崖畔，千筒不一盈。\n野粮收橡子，山屋点松明。\n只见树堪种，曾无田可耕。\n儿孙何所乐，向此是平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十七","author":"梅尧臣","text":"五月黄梅肥，终朝密雨微。\n绿苔侵竹阁，润气裛人衣。\n背陇沾牛去，衔虫湿燕归。\n高山发瀑水，夜涨入吾扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十六","author":"梅尧臣","text":"北客多怀北，庖羊举玉卮。\n吾乡虽处远，佳味颇相宜。\n沙水马蹄鳖，雪天牛尾狸。\n寄言京国下，能有几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十五","author":"梅尧臣","text":"高斋谢公殁，此地即危楼。\n不改窗中岫，无停川上舟。\n壁阴缘薜荔，城暝笑鸺鹠。\n万井晓烟合，素霓横树头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十四","author":"梅尧臣","text":"鸟命若杨叶，夜栖鸡翼间。\n情知羽毛薄，自禦雪霜难。\n相托为温燠，终非学附攀。\n犹胜居鹘握，忧惧得生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十三","author":"梅尧臣","text":"高林似吴鸭，满树蹼铺铺。\n结子繁黄李，炮仁瑩翠珠。\n神农本草阙，夏禹贡书无。\n遂压葡萄贵，秋来遍上都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十二","author":"梅尧臣","text":"竿头注腐鼠，水次野蜂知。\n每视衔飞翅，因薰斸取陴。\n绛囊千里道，乾蛹百钧驰。\n尽入公侯第，雕盘助酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十一","author":"梅尧臣","text":"大实木瓜熟，压枝常畏风。\n帖花先漏日，喷露渐成红。\n青箬包山舍，驰心奉汉宫。\n谁将橐驼载，辛苦向骄戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其十","author":"梅尧臣","text":"诸葛久精妙，已能闻国都。\n紫毫搜老兔，苍鼠拔长须。\n露筦何明净，烟丸事染濡。\n班超投此去，死作玉关夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其九","author":"梅尧臣","text":"古有琴高者，骑鱼上碧天。\n小鳞随水至，三月满江边。\n少妇自捞摝，远人无弃捐。\n凭书不道薄，卖取青铜钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其八","author":"梅尧臣","text":"细雨春冈滑，无因驻马蹄。\n裘单怀后侣，风急过前溪。\n近寺闻鱼鼓，穿林听竹鸡。\n田家舂正急，炊饭待锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其七","author":"梅尧臣","text":"项籍路由此，力豪闻拔山。\n八千提楚卒，百二破秦关。\n陔下围歌合，江头匹马还。\n却思诸父老，相见亦何颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其六","author":"梅尧臣","text":"信谗多见逐，伐国岂无仁。\n屈子行江畔，昭王问水滨。\n包茅曾责贡，香草自持纫。\n莽苍山川在，渔歌属野人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其五","author":"梅尧臣","text":"每见昭亭壁，高璩笔墨存。\n丹青虚格里，云雾碧纱痕。\n鸟屎常愁污，虫丝几为扪。\n贵来曾改观，世故有谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其四","author":"梅尧臣","text":"伍员奔吴日，苍皇及水滨。\n弯弓射楚使，解剑与渔人。\n抉目观亡国，鞭尸失旧臣。\n犹为夜涛怒，来往百川频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其三","author":"梅尧臣","text":"一过响山畔，常思路中丞。\n开亭宴貔虎，制贼象冰蝇。\n旧刻多磨灭，今人少诵称。\n茸茸春草长，时有牧牛登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其二","author":"梅尧臣","text":"三洲滩口急，两水渡头来。\n下过桓彝宅，上通严子台。\n潺湲泻寒月，滉漾照春梅。\n白鹭惊起处，鱼多见底回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣州杂诗二十首 其一","author":"梅尧臣","text":"昭亭万仞山，古庙半山间。\n赛雨使君去，钓潭渔父闲。\n蕨肥岩向日，竹暗垄连关。\n北望高楼上，南飞鸟自还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣麻","author":"梅尧臣","text":"彬美下一国，曾无相印酬。\n莫惊除拜峻，自是战功优。\n壮士颇知勇，诸儒方贵谋。\n淮西封亦薄，裴度死生羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将次项城阻风舟不能进","author":"梅尧臣","text":"逆水寒风急，轻舟晚不前。\n因来泊古渡，聊且上平田。\n草软行方稳，鹑惊去瞥然。\n却寻孤岸远，吹帻乱华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将赴表臣会呈杜挺之","author":"梅尧臣","text":"莫怪去迟迟，予心君亦知。\n膝前娇小女，眼底宁馨儿。\n学语渠渠问，牵裳步步随。\n出门虽不远，情爱未能移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尝茶和公仪","author":"梅尧臣","text":"都蓝携具向都堂，碾破云团北焙香。\n汤嫩水轻花不散，口甘神爽味偏长。\n莫夸李白仙人掌，且作卢仝走笔章。\n亦欲清风生两腋，从教吹去月轮傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挑灯杖","author":"梅尧臣","text":"油灯方照夜，此物用能行。\n焦首终无悔，横身为发明。\n尽心常欲晓，委地始知轻。\n若比飘飘梗，何邀世上名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故原有战卒死而复苏来说当时事","author":"梅尧臣","text":"纵横尸暴积，万殒少全生。\n饮雨活胡地，脱身归汉城。\n野獾穿废灶，妖鵩啸空营。\n侵骨剑疮在，无人为不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故原战","author":"梅尧臣","text":"落日探兵至，黄尘钞骑多。\n邀勋轻赴敌，转战背长河。\n大将中流矢，残兵空负戈。\n散亡归不得，掩抑泣山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"施判官赴饶州","author":"梅尧臣","text":"昔日里中旧，今为幕下英。\n烟波归楚国，风月满都城。\n食有江鱼美，时无羽檄惊。\n他年傥行县，肯使折腰迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"施君挽歌","author":"梅尧臣","text":"哀铎悽悽里，铭旌杳杳中。\n涧云销穗帐，山雨入蒿宫。\n世路行来久，泉途去莫穷。\n素吟应共葬，饮韵在松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"施景仁邀咏泗州普照王寺古桧","author":"梅尧臣","text":"来寻淮上寺，老桧莫知年。\n劫火已镕像，樛枝宁改烟。\n根拿怪石入，节駮苍苔坚。\n欲问浮波箭，空嗟此独传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日东斋","author":"梅尧臣","text":"剥剥禽敲竹，薰薰日照花。\n耳中无俗听，眼底有闲誇。\n迸笋过幽草，吹香到别家。\n吾怀方自得，切莫问生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日舟中对雪寄刁经臣","author":"梅尧臣","text":"谁道江南暖，新春见雪飞。\n鸥来亲客艇，花乱上人衣。\n古郡地偏寂，野窗寒入微。\n戴家人不远，欲去未能归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日游龙门山寺","author":"梅尧臣","text":"还邀二三子，共到凿龙游。\n阴壑泉初动，春岩气欲浮。\n竹藏深崦寺，人渡晚川舟。\n始觉山风急，归鞍不自留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"梅尧臣","text":"浓淡云无定，凄微气宇寒。\n鸠鸣桑叶吐，村暗杏花残。\n客子行裘薄，春塘野水宽。\n轻雷欣已发，谬作采茶官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"梅尧臣","text":"云压花房冷，风开柳絮迟。\n幽人宿酲在，静馆昼眠时。\n欲雨天无雨，将丝鬓未丝。\n孔融过五十，岁月已堪悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜闻雨","author":"梅尧臣","text":"风味正不寝，骤来寒气增。\n檐斜滴野箨，窗缺摇春灯。\n孺子睡中语，归人行未能。\n前溪波暗长，定已没滩棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨呈主文","author":"梅尧臣","text":"蛟龙上汉鱼潜动，梁栋生云燕未知。\n风点稍闻寒瓦急，玉条初向画檐垂。\n何郎夜听应逢句，谢朓朝观必有诗。\n老大莫将文字困，为公牵强不胜疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒","author":"梅尧臣","text":"春昼自阴阴，云容薄更深。\n蝶寒方敛翅，花冷不开心。\n亚树青帘动，依山片雨临。\n未尝辜景物，多病不能寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴对月","author":"梅尧臣","text":"云扫鱼鳞静，天开桂魄清。\n梨花鉴中色，杜宇昼时声。\n寥落将寒食，羁离念故京。\n都无惜春意，樽酒为谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭亭潭上别","author":"梅尧臣","text":"行舟晚解去，亲戚各还家。\n泪落正湿衣，肠翻如转车。\n借是昭亭水，相随亦有涯。\n予今游宦意，曾不学匏瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭亭潭上别弟","author":"梅尧臣","text":"从来潭上别，先赛故山祠。\n却入舟中饮，无令盏尽迟。\n须拚一日醉，便作数年期。\n落日马嘶急，岸傍人散时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭信淮上","author":"梅尧臣","text":"清淮渺然去，白浪势如奔。\n同发已先远，独行将向昏。\n洲长宁辨路，夜泊偶依村。\n灯火稍觉乱，应闻人语喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼寝","author":"梅尧臣","text":"尝闻晋高士，时偃北窗风。\n及尔寂无虑，始知机尽空。\n便便嘲已解，栩栩梦何穷。\n一寤复一寐，百年消此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洛阳牡丹","author":"梅尧臣","text":"古来多贵色，殁去定何归。\n清魄不应散，艳花还所依。\n红栖金谷妓，黄值洛川妃。\n朱紫亦皆附，可言人世稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独酌偶作","author":"梅尧臣","text":"东路归梁懒，黄流下汴深。\n眼穿南去翼，耳冷北来音。\n风雨昏斜日，乾坤入醉吟。\n不忧贫且老，自有伯鸾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝熙载赴任东阳","author":"梅尧臣","text":"东阳美山水，之子本风流。\n稍去何平叔，还追沈隐侯。\n清江飞晚雨，斜日半沧洲。\n县道行无愧，烟萝有胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日咏蝉","author":"梅尧臣","text":"群虫喜炎热，此独爱高阴。\n薄蜕聊依叶，清声已出林。\n人闲感衰节，风急杂遥砧。\n虚腹曾何竟，常忧螗斧侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日家居","author":"梅尧臣","text":"移榻爱晴晖，翛然世虑微。\n悬虫低复上，斗雀堕还飞。\n相趁入寒竹，自收当晚闱。\n无人知静景，苔色照人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日属疾","author":"梅尧臣","text":"体羸易生疾，况乃凌秋阴。\n微寒薄肤腠，饮药增衣衾。\n一日失所治，百骸将不任。\n当从华氏学，聊欲为戏禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴","author":"梅尧臣","text":"已过萧萧雨，犹成黯黯阴。\n登临潘岳思，憀慄楚臣心。\n远吹鸣高树，低云冒晚岑。\n久为关外客，不忍听疏砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胧月","author":"梅尧臣","text":"夜晴初见月，云薄未分明。\n高树尚无影，远鸿时有声。\n下阶嫌履湿，闭户认苔生。\n寂寂墙阴暝，更长已渐倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶磨二首 其一","author":"梅尧臣","text":"楚匠斲山骨，折檀为转脐。\n乾坤人力内，日月蚁行迷。\n吐雪誇春茗，堆云忆旧溪。\n北归唯此急，药臼不须挤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荇","author":"梅尧臣","text":"荇叶光于水，钩牵入远汀。\n浅黄双蛱蝶，五色小蜻蜓。\n老死怀江女，飘浮笑楚萍。\n西风莫苦急，孤蕊有馀馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴霅任君有诗相送仍怀旧赏因次其韵","author":"梅尧臣","text":"湖山饶邃处，曾省牧之游。\n雁落葑田阔，船过菱渚秋。\n野烟昏古寺，波影动危楼。\n到日寻题墨，犹应旧壁留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人入都下","author":"梅尧臣","text":"梁虽千里近，楚隔九江深。\n卑湿嗟犹剧，炎蒸老不禁。\n高怀云出没，寄信鸟浮沉。\n君去逢亲旧，微吟亦见心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刁安丰","author":"梅尧臣","text":"尝游芍陂上，颇见楚人为。\n水有鸟鱼美，土多姜芋宜。\n宁无董生孝，将奉叔敖祠。\n旧令乃吾友，寄声于此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]