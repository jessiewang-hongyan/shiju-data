[{"title":"次韵公显赋蜡梅诗二首 其二","author":"张纲","text":"愁里危肠日九回，今朝愁眼为花开。\n一枝斜倚向人笑，应报上林春信来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从丁世叔觅花栽","author":"张纲","text":"老去看花能几回，旋移花树着行栽。\n君家封植满烟露，分我一枝春色来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庚午三月十日游茅山","author":"张纲","text":"雨馀沙径净无泥，策杖何妨过竹溪。\n迎客野花随处发，劝沽幽鸟向人啼。\n峰峦路转攀萝倦，楼观烟深望眼迷。\n疑是武陵仙地隔，坐来遐想旧桃蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王伯寿见复用前韵奉答","author":"张纲","text":"瓶空何必醉如泥，送客谁能过虎溪。\n一枕闭门追蝶梦，两行森木听莺啼。\n新诗未读心先伏，细字徐看眼欲迷。\n笔底春风有生意，他年桃李会成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯寿述怀","author":"张纲","text":"仲蔚蓬蒿满径荒，主人曾是汉中郎。\n干时不利初无术，医国那知别有方。\n老去与谁同臭味，秋来多病独悲凉。\n倚天长剑君休问，腐肉当前亦敛铓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邀韦汝昭同宿上馆","author":"张纲","text":"打窗风雨夜萧萧，客里谁堪伴寂寥。\n五字苏州有苗裔，高吟何必更闻韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题华阳南窗","author":"张纲","text":"扰扰何年断俗缘，从今便合老山间。\n会将碧涧洗心净，坐看白云终日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"衰病辞禄蒙恩赐可时小子坚方尘末第陈德昭袁仲诚惠诗褒借褒借甚宠次韵奉答二首 其一","author":"张纲","text":"萧萧两鬓雪毛新，忝窃清朝旧荐绅。\n陈力心知难就列，引年恩许致为臣。\n卧家正恐贻官谤，增秩俄惊捧帝纶。\n温饱一门生意足，捐躯无路报涓尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"衰病辞禄蒙恩赐可时小子坚方尘末第陈德昭袁仲诚惠诗褒借褒借甚宠次韵奉答二首 其二","author":"张纲","text":"月窟当年裛桂香，衰兰那敢望重芳。\n姓名忽见偕千佛，骨相端知误九方。\n老树逢春欣有蘖，新雏出谷敢争翔。\n琢磨赖有交朋在，高义无专数范张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵再简二首 其一","author":"张纲","text":"三复长篇句法新，兰言纫佩更书绅。\n才高奚啻千人敌，誉过空惭一介臣。\n莫讶笔端能品藻，定由胸次有经纶。\n波澜万顷分馀滴，洗尽昏花满眼尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵再简二首 其二","author":"张纲","text":"二妙争开古锦囊，烂然佳句压群芳。\n奉高遗德归临汝，文范流风在季方。\n顾我挂冠宁复振，生儿附翼岂能翔。\n愿公勉力跻云路，视草斯文要主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴喜雪御筵归作","author":"张纲","text":"喜雪排筵晓漏催，玉人传诏下天来。\n香随日转蓬莱近，花带春回锦绣开。\n一线新阴留鼓吹，三登和气入樽罍。\n叨沾惠渥思归美，授简梁园愧乏才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"进呈皇太后回銮事实","author":"张纲","text":"奕世占来宝运昌，母仪垂庆肇生商。\n銮回长乐神人喜，书就蓬山日月光。\n北阙导迎三卫仗，东朝欢奉万年觞。\n太平盛事人相语，孝德回天赖我皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太庙灵芝产于仁宗皇帝英宗皇帝两室前楹芝上有文成王字臣叨陪政府得预荣观谨课成律诗二首 其一","author":"张纲","text":"吾皇圣德绍先猷，清庙华芝屡降休。\n道盛百王神画验，祥开两室化功侔。\n牺尊影照彤云聚，藻棁光连瑞气浮。\n愿诏乐章歌伟迹，更从来岁荐郊丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太庙灵芝产于仁宗皇帝英宗皇帝两室前楹芝上有文成王字臣叨陪政府得预荣观谨课成律诗二首 其二","author":"张纲","text":"升平和气格天渊，瑞物嘉生太室前。\n根托丹楹朝丽日，叶敷华盖护非烟。\n燕胎为祝多男庆，天母人符万岁篇。\n圣意每勤宗庙事，屡蒙休应答精虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁前三日立春值雪会同僚饮","author":"张纲","text":"三日残冬趁臈回，飞霙满眼送春来。\n香浮綵胜随宜带，花着瑶林是处开。\n已卜屡丰歌井邑，何妨乘兴倒樽罍。\n东阳莫讶休文瘦，老病仍添一岁催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元","author":"张纲","text":"上元春色压轻寒，故事宾僚集晚筵。\n合坐香浮花袅娜，捲帘风定月婵娟。\n闾阎尽道宜新岁，灯火何妨减去年。\n堪笑樽前穷太守，只愁老病欲归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"休官","author":"张纲","text":"乞得清朝一病身，杖藜归去老山村。\n室庐旋筑新椽就，松菊犹寻旧径存。\n渐喜有缘穷野兴，只惭无路报君恩。\n百年来日知馀几，且把生涯付一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弟侄三人同日受官实为吾家盛事老怀不胜忭喜作四小诗见区区之意 其一","author":"张纲","text":"恩光初自九天来，玉树三枝一日开。\n造物无私人共庆，那知阴德旧栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弟侄三人同日受官实为吾家盛事老怀不胜忭喜作四小诗见区区之意 其二","author":"张纲","text":"三世追荣荷圣恩，诸孙仍见捧丝纶。\n当年孝友家声在，流庆增光属后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弟侄三人同日受官实为吾家盛事老怀不胜忭喜作四小诗见区区之意 其三","author":"张纲","text":"恩袍新绿照新秋，文雅乡评早见收。\n王谢故应人物胜，芝兰生处自风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弟侄三人同日受官实为吾家盛事老怀不胜忭喜作四小诗见区区之意 其四","author":"张纲","text":"清时得谢老山村，弟侄相过庆一门。\n结绶满庭青若若，莫辞勤苦报君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊祀庆成用坚韵","author":"张纲","text":"圆丘迎日至，大驾肃天临。\n乐奏来灵享，嵩呼动德音。\n均恩寰宇庆，望阙老臣心。\n基命歌周雅，何劳五字吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"作亭池上日游其间颇觉自适","author":"张纲","text":"岁晚穿池结小亭，地偏聊欲寄幽情。\n虚檐风度披襟爽，曲岸波平照眼明。\n过我宾朋无厌数，傍人鸥鹭不须惊。\n圣朝乞得身闲散，便觉渊明是隔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题喜归亭","author":"张纲","text":"君恩赐我老菟裘，旋筑池亭野趣幽。\n地势曲连青嶂绕，波光环匝翠烟浮。\n兴来樽酒随时办，客散琴书尽日留。\n为问标题意何在，一生心足是归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵袁仲诚见赠","author":"张纲","text":"解组清朝返旧乡，依然门巷接回塘。\n閒身乍觉鸟声乐，缓步重寻花径香。\n多谢故人停桂棹，何妨清夜醉霞觞。\n新诗赠我光蓬屋，什袭应同夏后璜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用喜归亭韵","author":"张纲","text":"晏子区区惜敝裘，吾衰亦恋故山幽。\n得归更喜诗盈轴，任达宁须酒拍浮。\n已纵虚名身外去，肯将俗物眼边留。\n只惭老负君恩重，结草他年报未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张辅卿省试","author":"张纲","text":"明诏搜贤动四陲，西来一鹗冠群飞。\n擅场笔势惊华省，发策才名上紫微。\n无负题桥平日志，要看怀绶故乡归。\n相逢肯惜倾家酿，已约莺花慎勿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简袁仲诚觅芍药花","author":"张纲","text":"老来百计不相关，诗句雕镌兴亦阑。\n只有好花堪照眼，从君聊借一枝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲诚和诗四首又叠送花再用韵答","author":"张纲","text":"笔阵横飞屡叩关，严兵夜点迫更阑。\n好花多谢频分我，怯敌魂惊未暇看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避寇舟中风雨大作","author":"张纲","text":"扁舟避寇舣山隈，问捷江城信未回。\n犯夜号风惊梦破，催寒飞雪送愁来。\n三军挟纩烦温诏，百战搴旗赖隽材。\n已办磨崖颂功烈，伫还生意发春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王伯寿示佳作备述穷苦次韵奉呈","author":"张纲","text":"吟残翻水笔生春，秀句惊人字字新。\n赋料扬雄谁可敌，才高太白善无邻。\n清心鸣镝增豪气，刮膜神篦净俗尘。\n唯有诉穷疑太过，文章从古忌悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪作","author":"张纲","text":"朔风吹雪应嘉时，蔌蔌空庭静夜知。\n岁稔不须占瑞谍，家贫尤喜映书帷。\n花虽无艳难争巧，舞不成行也自奇。\n病起老翁迷眼界，寒窗呵笔强裁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招亲旧赏花","author":"张纲","text":"名花朵朵向人开，家酿沈沈旋拨醅。\n咫尺晴川风更便，追欢何惜片帆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安人生日","author":"张纲","text":"闻道防秋吉语来，生朝宴席为君开。\n黄花也似知人意，争挽欢声入寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻大帅勇决直趋北界喜而作此","author":"张纲","text":"牙旗动处拥貔貅，直渡黄河塞草秋。\n百万强兵阵前死，肯教卫霍独封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王周伯和应文诗","author":"张纲","text":"先生诗兴浩难收，苦思俄惊两鬓秋。\n变格竞传吴富体，怀沙拟续畔牢愁。\n会令后学轻焚稿，消得诗名号倚楼。\n我老恨无青玉案，锦囊分示若为酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"应文监视刈穫有诗辄和一篇恐以一饱废学因而勉之","author":"张纲","text":"杖藜何日下西畴，想见欣逢岁有秋。\n可但聚粮供腹饱，还应酿秫散眉愁。\n决科伫看标金榜，得路终期侍玉楼。\n莫把光阴等闲弃，一朝清问要人酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日用前韵","author":"张纲","text":"闲里光阴逐水流，重阳忽复故园秋。\n休言白发从教老，试插黄花也解愁。\n感旧有时曾落帽，凭高无力更登楼。\n昏昏病懒惟堪睡，诗债休催未暇酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"走笔戏呈世叔伯达二亲友","author":"张纲","text":"老来无计了残年，只有欢情寄酒边。\n歌舞借看真达士，忍将朱户锁婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周伯见赠","author":"张纲","text":"幼子童孙乏寸长，迁官同日被荣光。\n芝兰瑞色来空翠，雨露恩言满诏黄。\n莫讶飞腾循九品，会看毫末耸千章。\n即今天子收群策，廊庙吁谟要主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵","author":"张纲","text":"百岁休誇日月长，十分逾八叹流光。\n精忠许国心犹赤，老病催人发已黄。\n扶杖每闻宣凤诏，望云无路仰龙章。\n恢图幸有皋夔在，坐看朝纲万目张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵方守送进士","author":"张纲","text":"下诏徵多士，弹冠动四溟。\n三场遵旧典，八韵见明经。\n劝驾勤州牧，吟笺诧地灵。\n春风归路近，衫色照山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周伯谢绵袄长篇","author":"张纲","text":"最宜为诰唐仲舒，上林子虚汉相如。\n喜君万事懒着眼，独向文章情未疏。\n家贫肯恋儋石储，船漏则已那复袽。\n素志蹉跎雪侵鬓，青衫匍匐尘满裾。\n可怜虞翻屯骨相，相逢呼我丈人行。\n夜闻抵掌论开边，怒发冲冠亦何壮。\n鹴裘典尽终讳寒，忍寒悲歌行路难。\n绨袍恐贻范叔怒，长篇忽拜乌丝阑。\n辞章典要古所尚，馀子碌碌何足仰。\n愿君回笔颂皇猷，偃武修文答灵贶。\n天子亟欲闻尽言，前席还应虚黈纩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老夫辞荣里居行年八十酒间漫成拙句二首述意而已不以示外也 其一","author":"张纲","text":"莫笑樽前白发翁，曾骑竹马戏元丰。\n年弥八帙痴顽在，身荷三朝宠眷隆。\n绿野敢将前哲比，香山幸有老人同。\n兴来尚欲寻幽去，收拾残春杖屦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老夫辞荣里居行年八十酒间漫成拙句二首述意而已不以示外也 其二","author":"张纲","text":"老病辞荣日月边，归来拟作地行仙。\n飞霜满鬓三千丈，止水观心八十年。\n松菊尚存堪寄傲，干戈未定敢安眠。\n君王宵旰图恢复，洗眼神兵策万全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亲旧以老夫年及中寿既辱临况又多以诗词相庆祝顾衰谢何以得之辄成鄙句叙述感悰","author":"张纲","text":"老来光景去骎骎，亲旧应多惜老心。\n倾盖义高双白璧，开函诗敌万黄金。\n催年生怕玲珑唱，醉夜宁辞凿落深。\n多谢慇勤祝强健，寄言衰病莫相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老病","author":"张纲","text":"萧然华发映苍颜，九帙开来第一年。\n鍊尽交游难讳老，养成衰病却安禅。\n新春已负登山屐，旧赏空惭载酒船。\n张绪风流那复少，坐看飞雪弄晴烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送釜孙省试","author":"张纲","text":"英髦云集几千人，群试争看艺绝伦。\n一鼓搴旗先作气，三场下笔要如神。\n决科无失青毡旧，拜赐重添绿绶新。\n秀发孙枝吾欲见，梦魂已到上林春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪总领题花信亭得江楼二首 其一","author":"张纲","text":"谁为传花信，新亭破睡风。\n春回芳意早，客到赏心同。\n酒盏摇江绿，诗笺照坐红。\n无由接欢宴，危坐正书空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪总领题花信亭得江楼二首 其二","author":"张纲","text":"地胜宜楼观，临江势屹然。\n横波吞翠壁，倒影插雕椽。\n老子难收兴，云安未足怜。\n由来词翰手，五凤独居前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见华阳旧题刻石有感","author":"张纲","text":"旧句入贞珉，新题亦已陈。\n光阴如许速，谁是百年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某上章辞免召命蒙恩矜许仍赐羊酒存问自念衰残辱此异数不胜感天荷圣之情谨课成拙诗一首","author":"张纲","text":"昧死飞章上九天，恳辞严召卒馀年。\n纶言宠念桑榆迫，台馈恩垂雨露偏。\n异数一时真创见，穷乡万口遍誇传。\n吾衰忝冒知难报，结草他年敢避先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵","author":"张纲","text":"召节煌煌下帝关，君王图旧起高年。\n露章恳避回天速，拜命欢呼压地偏。\n锡馔宰官侵夜到，问安州牧置邮传。\n辞荣有耀人皆说，谁解清时独占先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"考妣赠官一时荣耀老怀易感辄敬书长句","author":"张纲","text":"丝纶五色锦为囊，宠赠双亲庙室光。\n位列三孤升极品，名加大国启新疆。\n劬劳仰荷湛恩报，精爽应知积庆长。\n燕及子孙宜勉力，忠勤他日继遗芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彦礼弟赴歙尉四首 其一","author":"张纲","text":"莫辞官小路间关，趁取春风稳着鞭。\n无限清时推毂手，冲天何必待三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彦礼弟赴歙尉四首 其二","author":"张纲","text":"池塘春草促君诗，阿绪风流絮欲飞。\n满眼吾家好风景，正须相赏忽相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彦礼弟赴歙尉四首 其三","author":"张纲","text":"高才自是古梅仙，綵棒何须向壁悬。\n晋盗奔秦无一事，炉薰深炷好安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彦礼弟赴歙尉四首 其四","author":"张纲","text":"空诗羞涩送君行，老病难堪叙别情。\n天假吾年未填壑，它时犹及问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"旧所乘马老且瘠见之感怀","author":"张纲","text":"人衰马亦老，不踏长安道。\n筋力渐疲羸，鞍鞯谩华好。\n见我勿嘶鸣，为尔动怀抱。\n无复矍铄时，去去饱丰草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜思出处因作戏言","author":"张纲","text":"仕路定风波，人生能几何。\n时来聊试手，为瑞不宜多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老来交朋沦谢虽婢仆亦无在者感旧忽觉凄然","author":"张纲","text":"故交沦没水东流，岁晚无人话昔游。\n飞絮落花何足道，忽经风雨亦添愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"显仁皇后挽词三首 其一","author":"张纲","text":"辅汉阴功大，生商宝运开。\n俸从汤邑省，恩向外家裁。\n奄忽乘仙驭，劬劳动圣哀。\n园陵奉遗诰，终不费邦财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"显仁皇后挽词三首 其二","author":"张纲","text":"长乐坤仪肃，思齐母道全。\n九州供大养，八帙茂遐年。\n仗簇江山外，哀缠日月边。\n遗芳归史笔，万古照青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"显仁皇后挽词三首 其三","author":"张纲","text":"仗去慈宁殿，神归永祐宫。\n问安迷辇道，洒泣恸宸衷。\n水逝长江月，天号宰木风。\n平生尚慈俭，流泽到无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]