[{"title":"和久中春风","author":"韦骧","text":"二月东风势渺漫，侵陵和景作清寒。\n发扬造化非无力，鼓动芳菲自有端。\n斗草戏儿忧手瘃，怀边思妇忍眉攒。\n祗输便腹忘机者，不废书帷昼寝安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈君佐","author":"韦骧","text":"山阳判袂几三纪，铁柱题名过十年。\n聚散信如萍逐水，光阴奚翅筈离弦。\n高材未用君犹健，弱羽无心我自全。\n凫鹤短长何足算，相逢樽酒且留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴子友贡院作","author":"韦骧","text":"晓跃骅骝紫禁开，诏音不许少淹回。\n斜鞭忽过天街柳，曳履还侵佛閤苔。\n昼幕四垂如近汉，夜灯相比似占台。\n会将精识抡荆璞，当有孚尹应手来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和中裕古鉴","author":"韦骧","text":"君有青铜独可怜，规模奇古众疑年。\n寒光不减虽人致，真鉴无期本自然。\n秋水未堪方洞照，霜蟾应是恨长圆。\n主人较艺还如尔，坐别嫫施丑与妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京居","author":"韦骧","text":"冷官仍白发，陋巷足青苔。\n弥月不书刺，经时长覆杯。\n未能依涧壑，空欲远尘埃。\n聊作支离况，诗成祗自咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送冯材叔宰蕲春","author":"韦骧","text":"海角分携仅十年，钜创钧是偶生全。\n相逢未暇聊持酒，就别还惊欲放船。\n顾我滞踪徒衮衮，羡君归翅自翩翩。\n蕲春岂足劳馀刃，应有佳声慰慊然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩敏之学士贰少府往拜凡三而未觏因致以诗","author":"韦骧","text":"一枝栖息又逢春，何幸高贤晚获亲。\n顾我画墁惭所食，荷公倾盖异于新。\n绪馀衮衮心尤慕，盘辟区区礼未伸。\n三望膺门漫刺字，且持累句愬因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邃明生日","author":"韦骧","text":"昴宿储精岳降神，乾坤钟异钜贤身。\n间生庆候年弥永，辅世休声日又新。\n台鼎梅调方夏实，凤池风好正南薰。\n因时愿祝松椿寿，长赞熙朝秉化钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政孙大夫挽词","author":"韦骧","text":"荣养如公世所稀，薤歌今日勿深悲。\n生封郎位腰金贵，老向仙乡拥节随。\n积德已酬高闬志，遗踪何愧北山移。\n义方有子声华重，千古灵丘起后思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同文馆试上舍和同事孔彦常学士即事","author":"韦骧","text":"笔阵收锋考战文，喧喧车马隔重门。\n心矜力学求之密，目到雄辞气不昏。\n美宝辨来三献惬，雕虫屏尽六经尊。\n囊封奏号须明发，吉梦应先彻九阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和","author":"韦骧","text":"强继高吟岂足论，聊持布鼓过雷门。\n解颐传咏知辞妙，落笔酬言怯思昏。\n霜叶舞风鸣碧瓦，寒云漏月射清尊。\n好传秀句频惊座，索马行将戒守阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵呈彦常明叔","author":"韦骧","text":"软语霏霏过夜分，程文都已辨专门。\n香焚龙脑神还健，书检蝇头眼易昏。\n驺从传呼金阙晓，星辰环拱紫垣尊。\n拆封御史何时到，曳组相将谒禁阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"较试将毕呈彦衡察院上官","author":"韦骧","text":"当年京口望清尘，德论于今想记频。\n何幸上庠参较艺，又依高鉴免遗珍。\n下帷昼寂霜威敛，挥麈宵寒月色新。\n早晚奏名归驶迅，九衢多少避骢人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和彦常试院即事 其一","author":"韦骧","text":"城壖候馆势弘开，捧诏彤庭薄暮来。\n庠序旁延优上舍，行能参考见高才。\n糊名独得珠无胫，摭实更忻山有莱。\n贤杰闻风争入彀，箪瓢何足乐颜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和彦常试院即事 其二","author":"韦骧","text":"天寒帘幕气萧骚，终日披文不厌劳。\n但有诚心禆藻鉴，敢矜明目察秋毫。\n玙璠启袭光难掩，雕鹗凌虚势自高。\n号奏身閒无一事，唱酬尤喜得诗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和彦常试院即事 其三","author":"韦骧","text":"辨骏由来尽马群，裁声今已得龙孙。\n不容一字虚褒贬，可见诸生究本源。\n衡鉴有凭宜自信，毫釐无益懒轻论。\n分携莫惜频交语，且尽樽前蜡泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈郭奉议明叔","author":"韦骧","text":"峤北分携一纪逾，浮梁唯奉数行书。\n如何邂逅同萦绊，遂得从容接绪馀。\n道旧良多动嚬笑，忘形不觉度居诸。\n出门幸且时相顾，更望新篇数起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食蛤蜊二首 其一","author":"韦骧","text":"适口珍鲜品格高，泥深海近不能逃。\n若教毕卓曾知味，岂肯甘心把蟹螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食蛤蜊二首 其二","author":"韦骧","text":"自卫区区亦甚勤，刳肠剔柱奈何人。\n若知射影能相惧，应学含沙得保身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢钟离中散公序惠草书","author":"韦骧","text":"留心不减汉张芝，体意俱完世学稀。\n下笔欲为来者法，临池时见古人非。\n篇篇骇目神如电，字字凌虚势若飞。\n多谢公馀怜所好，璨然累幅遗珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈户部李尚书二首 其一","author":"韦骧","text":"八座辉光道德隆，陋儒何幸奉从容。\n听言迥出群贤表，顾己荣于万户封。\n密启更惭先荐鹗，高门况是晚登龙。\n荷公恩意知难报，劲节当先比涧松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈户部李尚书二首 其二","author":"韦骧","text":"三纪光阴疾若驰，一身孤宦亦逶迤。\n人疑碌碌非奇节，谁信嚣嚣足有为。\n白发精神怜晚景，青云志气慊卑枝。\n门阑此日蒙优遇，可是囊中颖脱时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈南邻司门盛诲之同年","author":"韦骧","text":"昔咏相过人不知，于今想见少陵诗。\n邻居何幸偏依德，交语乘閒祗隔篱。\n攀桂当年联步武，近兰此日慰瞻思。\n冷官罢局方无赖，但向清风且乐饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过二里山","author":"韦骧","text":"夜宿陈仓驿，朝行三里山。\n千峰排郁郁，万石激潺潺。\n征驭来何亟，幽禽语自閒。\n尘劳亦知幸，胜景得跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御爱山","author":"韦骧","text":"五峰列翠俨如屏，御爱知非浪得名。\n行客勿轻加诮咏，播迁岂是不关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤翔刘明复龙图刊李茂正德政碑勒移维摩塑像文求诗因寄","author":"韦骧","text":"龟趺螭首势嵬然，轻重由来在所镌。\n名削奸臣磨伪说，像迁居士记真诠。\n精文本自精诚出，妙手幡因妙相传。\n以善辟邪殊可敬，为公嗟叹作诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和遂州太守李安上年兄见贻","author":"韦骧","text":"拥麾遥想陟崔嵬，骤喜清谈复屡陪。\n攀桂当年追远趾，偃藩今日仰高才。\n如公闳博难淹外，顾我迂疏任傥来。\n相遇且宜忘倍道，暂同持酒赋层台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄提刑岑岩起","author":"韦骧","text":"两世同年世亦稀，同官同路复同词。\n登途先后无多日，聚论参差已过时。\n剑外石梯方息鞅，山南珍翰忽伸眉。\n情知邂逅当非晚，聊寓长言写所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过朝天岭","author":"韦骧","text":"崔嵬陟尽复凌兢，暂舍银鞍杖策行。\n栈阁架空霄路近，栏干护险晓云平。\n仰看翠壁层城峻，下瞰长江一带萦。\n自惜仙才难蜀道，始知难此不虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三盘阁","author":"韦骧","text":"江山千里势雄豪，终日缘崖未是劳。\n欲识寒心骑马处，三盘阁上看惊涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉枕驿","author":"韦骧","text":"嵬然峭壁入青云，玉枕光辉绝世尘。\n岂是群仙露奇迹，故将珍玩感途人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过故平","author":"韦骧","text":"间关危栈过岧峣，忽见平原旅恨销。\n却被飞涛送乡思，悠悠想见浙江潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回宿故县驿","author":"韦骧","text":"回首边城暮霭轻，乱山深处宿归程。\n流泉绕榻鸣寒夜，别是劳生一段清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文剑道中","author":"韦骧","text":"剑阁文台相去遥，朝行山顶暮行腰。\n双眸视险睛常眩，两髀乘鞍肉半消。\n空有辛勤驰远道，愧无毫末补清朝。\n何时解组归乡国，十里西湖弄短桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登科 其一","author":"韦骧","text":"先世曾誇尺五天，后来苗裔独萧然。\n可怜三十三年内，科第唯吾父子传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登科 其二","author":"韦骧","text":"青云意气已参差，白发精神祇自嗤。\n喜汝登科年尚少，好摅事业趁明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄石榴花","author":"韦骧","text":"六月群芳歇，榴花拆浅黄。\n色方金菊淡，体异玉簪长。\n触日犹能媚，迎风不在香。\n无劳问朱实，秀发占中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝挽辞二首 其一","author":"韦骧","text":"圣文摅道妙，神武拓边封。\n治迹超三代，焦心厌九重。\n方仪韶乐凤，忽驾鼎湖龙。\n遗烈传千世，鸿基固祖宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝挽辞二首 其二","author":"韦骧","text":"检玉将封岱，遗弓已上仙。\n新陵崇永裕，旧节罢同天。\n哀仗愁云外，悲笳惨月边。\n攀髯臣子恨，万泪欲成川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再咏黄石榴花二首 其一","author":"韦骧","text":"花似新鹅色泽均，萼如柘茧乱纷纷。\n更临返照遥凝目，翠幄无端惹瑞云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再咏黄石榴花二首 其二","author":"韦骧","text":"佳人最爱石榴红，染作轻裙步履同。\n唯有此花难入意，任教荣悴逐薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自剑还道中寄同事苏进之","author":"韦骧","text":"君寓姑苏吾舍杭，惯从云水乐仙乡。\n相逢邂逅趋端礼，同职间关到益昌。\n疲俗未肥心所病，故园何在梦偏长。\n新阳欲动林泉好，觞咏随时且自强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿上亭驿","author":"韦骧","text":"按部嵚崎向梓潼，上亭孤驿倚寒空。\n淋铃尽想当时雨，吼地愁闻竟夕风。\n冲冒狂飙忧病体，驱除宿翳懒神功。\n翼朝揽辔逢清霁，致敬宜将樵意同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒梓潼庙","author":"韦骧","text":"英威凛凛愯西州，血食潼江度几秋。\n曾运阴兵摧贼垒，每均甘泽惠农畴。\n翠帏半捲香烟动，金榜高题日影浮。\n暂止轺车聊一奠，肯将曲祷累神休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题岑岩起剑门诗刻后","author":"韦骧","text":"扑面尘埃二十年，纱笼石刻顿光鲜。\n廋辞不用题黄绢，自有惊人秀句传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岩起观旧诗有感","author":"韦骧","text":"弃繻东去有遗篇，杖节西还今几年。\n莫向长岐悲齿发，似君行学可怡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和十二月二十九日思封道中","author":"韦骧","text":"巴山险阻备尝之，笑读豪篇似抵巇。\n况是岁华垂尽日，却为贤者独劳时。\n寒多未放泉声活，春近先从柳眼知。\n早晚星轺趣回辔，东园共醉小枝枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和资守许泽翁见寄","author":"韦骧","text":"十年为别只逡巡，喜见来篇墨色新。\n且解征鞍同一醉，异乡难遇故乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长柳馆","author":"韦骧","text":"地名长柳柳初长，下马临泉却坐床。\n客舸傍沙收百丈，野禽窥水竞双翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"算钱铺","author":"韦骧","text":"里名胜母曾车止，邑号朝歌墨驭还。\n我领漕权来此坐，不惟自哂且赪颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见性堂","author":"韦骧","text":"由来迷悟尽真如，见性名堂亦谩书。\n万变纷纷任交战，一心了了即安居。\n槛花夭秀乌能浼，庭柏孤高自有馀。\n多谢前人为留意，使予聊得寓清虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都竹道中","author":"韦骧","text":"阴平才过万山重，路指江油栈阁通。\n峰顶云收馀夕雪，马蹄尘少带春风。\n一溪水色琉璃碧，几坞梅花锦绣红。\n莫谓奔驰足劳苦，目前佳趣亦无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过赤崖潭","author":"韦骧","text":"轻轺晓过赤崖潭，莫讶凝眸涉再三。\n百丈澄澜连底见，千寻翠壁与天参。\n钓丝森蔚迷芳岸，鹅管参差滴秀岩。\n胜概心藏俟能画，肯教凡笔谩镌镵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过雪峰亭","author":"韦骧","text":"二月春将半，山高雪未消。\n危亭在屏障，万水缀琼瑶。\n似与尘寰隔，安知云路遥。\n区区澄按外，暂得驻轻轺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经望星山","author":"韦骧","text":"缘崖陟磴势凌兢，偏坐银鞍傍险行。\n更向望星山上过，扪参方信不虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"螗啼岭","author":"韦骧","text":"臲卼肩舆半侧身，嵚岖石磴但无尘。\n山行从隶难成列，路转前驱却向人。\n更瞰江潭尤觉险，独怜桃李解妆春。\n他时跃马康庄稳，莫忘攲危蹙頞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亭溪道晓行","author":"韦骧","text":"白云起处山樱发，绿柳垂边水蚁鸣。\n唯有晓寒殊未减，重裘还似冒霜行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至白水驿辍趋文还益昌","author":"韦骧","text":"辍程趋疾且归来，莫讶回船在不期。\n恐失东园桃李色，一年深悔欲何追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和许冲元内翰易元日登塔之游为再登","author":"韦骧","text":"浮屠屹屹势参天，旌骑朝临又改年。\n一日再登清兴足，旧游新变异时传。\n嘉篇却寄踰千里，遗爱相仍沸两川。\n尘淟剽闻肝胆醒，况陪胜览即芳筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又借前韵为攀别之作","author":"韦骧","text":"紫诏催还二月天，清台颁历涉三年。\n高文昔冠群儒首，异政今为两蜀传。\n此日旌旄度危栈，何时舟楫济长川。\n笳铙渐远劳瞻望，犹想飞花傍祖筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岑岩起见寄三绝 其一","author":"韦骧","text":"别来凡历几重山，又报兼途策马还。\n而我病躯方觉健，喜时觞酒助谈间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岑岩起见寄三绝 其二","author":"韦骧","text":"分携斜日在青山，不意黎明我遽还。\n却向益昌迎马首，由来无定是人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岑岩起见寄三绝 其三","author":"韦骧","text":"百丈江流万仞山，一车方往一车还。\n若教说著邯郸梦，都在胡卢掩口间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢岩起寄凤团茶","author":"韦骧","text":"北苑先春云凤团，封题分寄墨初乾。\n未甘金碾消磨了，且作琼枝爱惜看。\n水异康王烹莫称，才非卢子咏应难。\n强抽鄙句惭瑶报，佳惠轻酬岂自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至西县走呈岩起","author":"韦骧","text":"所部虽同邂逅稀，今年差比去年迟。\n蓼图犹忆当时玩，菊酒还陪此日持。\n衰鬓已斑乌足叹，壮心徒在竟何施。\n相逢且尽从容兴，况是终更欲及期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和岩起以诗答谢惠团茶之句","author":"韦骧","text":"灵芽不减密云团，十袭清香翠若乾。\n芜句聊纾情内动，明珠更得掌中看。\n轻投雅贶公为易，并获殊珍我自难。\n报德酬言古人重，斐章不再岂遑安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城固道中先寄 其一","author":"韦骧","text":"暌违旬浃似朝晡，劳想清冰映玉壶。\n谩寄小诗驰鄙意，更能还贶雅篇无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城固道中先寄 其二","author":"韦骧","text":"税鞅行邮日欲晡，汉皋重得造仙壶。\n不知挥麈交谈外，还许拢弦入听无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌晨马上得惠诗再次元韵 其一","author":"韦骧","text":"诗筒方讶惠音稀，击钵来篇果不迟。\n定欲擅场专独胜，岂容遗帼久相持。\n招邀近想融樽满，往返多惭孺榻施。\n况得鸾弦声出幌，肯教马足自稽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]