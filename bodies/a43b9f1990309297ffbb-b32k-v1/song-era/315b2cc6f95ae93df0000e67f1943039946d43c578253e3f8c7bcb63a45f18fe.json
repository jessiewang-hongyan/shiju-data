[{"title":"送淳尉海陵并寄示潚 其一","author":"楼钥","text":"二子俱从宦，重亲足自怡。\n汝能行幼学，吾岂恨轻离。\n平日自知己，真心更与谁。\n临文有遗忘，此是忆儿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曾南仲寺丞守永嘉","author":"楼钥","text":"六和久坐趣归鞭，却送旌麾水竹边。\n无说可裨新令尹，有诗重送老同年。\n城隅绿竹今安否，庭下朱栾定俨然。\n回首东州真梦境，羡君此去若登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"适斋挂冠次韵 其一","author":"楼钥","text":"致仕吾非不待年，礼经自合许求田。\n祇图径取衣冠挂，不愿更寻香火缘。\n富贵鼎来先瞥地，是非衮处独翩然。\n鄮峰相对两真隐，共仰元台与大天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"适斋挂冠次韵 其二","author":"楼钥","text":"世事相牵无了期，平生待足是何时。\n抛官不作九阍梦，纳禄尚馀三径资。\n紫绶金章宁复恋，黄冠野服自相宜。\n耳根赢得长清净，理乱从今不用知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳","author":"楼钥","text":"佳处逢佳节，宁辞望眼劳。\n有楼皆眺远，无日不登高。\n野栗炊新秫，寒萸泛浊醪。\n黄花何太晚，篱落上萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳寄雪窗从叔","author":"楼钥","text":"秋意未教篱菊知，不妨乌帽著风吹。\n绝怜对酒君归矣，更欲登高谁共之。\n风雨满城千里梦，茱萸缀席一年期。\n君非俗物败意者，莫为催租便不诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳淳生日时年四十九矣","author":"楼钥","text":"汝生四十九年春，犹记双亲喜得孙。\n当慕知非过能寡，敢言学易道弥尊。\n喜吾父子为知己，赖尔诗书遂满门。\n但得团栾长似此，年年萸菊醉清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倅厅云水亭","author":"楼钥","text":"山绕澄江江绕城，水云径接海冥冥。\n万家曲折在吾目，一郡登临属此亭。\n今日诗题随处有，几番醉眼望中醒。\n风流郑老知何在，回首苍茫岛屿青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐舍人挽词 其二","author":"楼钥","text":"夷路方驰辔，甘泉喜问津。\n庙廊平日志，露电百年身。\n搯掌虽多恨，为箕自有人。\n发棠阴德在，阳报质苍旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唤仙阁 其三","author":"楼钥","text":"犯暑来登览，松风为洒然。\n龙泉澄古井，虹影卧中川。\n万簇寒林秀，四山秋色鲜。\n诗翁不可见，况敢唤飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐少卿挽词 其一","author":"楼钥","text":"圣主一言寤，长淮千耦耕。\n山川皆在目，草木尚知名。\n盍被腰金宠，徒为揽辔行。\n诸郎袭馀庆，定自不惭卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐少卿挽词 其二","author":"楼钥","text":"所至多遗爱，丹丘最有声。\n奉常千载久，攀恋一城倾。\n已恨数离别，宁知隔死生。\n湖边旧门巷，一到一心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐季节挽词","author":"楼钥","text":"公府推徐稚，山阳荐仲车。\n盛时遗此老，没世竟穷庐。\n行道嗟无命，传家幸有书。\n鲁山终不识，抚卷倍欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐府君挽词","author":"楼钥","text":"孺子人如玉，功名不在身。\n死生齐物外，孝友笃天伦。\n已有传家子，曾充观国宾。\n他年芳五桂，伤不见灵椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭人胡氏挽词","author":"楼钥","text":"懿行表闺房，情亲共衋伤。\n绣衣来宅相，彤管著铭章。\n蘋涧谁供祀，藁砧空悼亡。\n芝兰俱秀发，所恨失元方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭人强氏挽词","author":"楼钥","text":"祠部源流远，来嫔曲阜孙。\n事夫终妇道，训子大吾门。\n颁诰恩光渥，升堂笑语温。\n相期送丹旐，马鬣近周原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭人董氏挽词","author":"楼钥","text":"敬馌尊夫子，升堂乳阿姑。\n乡评推至行，家庆展新图。\n半世悲鸾舞，高年乐凤雏。\n蜜章应未艾，卿月映阶符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挈从子涤归乌戍外家","author":"楼钥","text":"五年不泛浙西船，今日重来倍黯然。\n苇席不重寒刺被，菱歌孤唱月摇川。\n咿哑回橹凫鸥狎，来往轻帆风雨便。\n点检湖山固无恙，鸰原遗恨到黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂花方开约客次韵","author":"楼钥","text":"久疑岩桂尽迟开，留待生朝伴举杯。\n老去欲寻千日醉，客来同引百花醅。\n况临高阁枝枝秀，好判闲身日日陪。\n家酿尽倾君不惜，莫教瓶罄耻为罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海潮图","author":"楼钥","text":"钱塘佳月照青霄，壮观仍看半夜潮。\n每恨形容无健笔，谁知收拾在生绡。\n荡摇直恐三山没，咫尺真成万里遥。\n金阙岧峣天尺五，海王自合日来朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病目初愈张子家有诗次韵","author":"楼钥","text":"年来视物隔褷䙰，祇有昏花似退之。\n强起归鸿聊自放，妙穿悬虱恐难为。\n相亲黄奶交亲绝，见代青姑事寖危。\n写照苦添云蔽日，不应更诮虎头痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病足戏效乐天体","author":"楼钥","text":"课得退连茹，药逢新太医。\n居闲幸馀暇，养病任多时。\n步屧虽非便，调琴足自怡。\n晓来风雨急，高卧到晨炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真率会次韵","author":"楼钥","text":"喜奉潘舆得退身，乌衣相会总情亲。\n樽前正好醉千日，林下何妨见两人。\n闲暇止应开口笑，谈谐尤称掇皮真。\n夜归更作惊人语，舅氏从来笔有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绣川道中","author":"楼钥","text":"伏波莫作贾胡留，雨意垂垂未肯休。\n不惮征衫有微湿，只愁平地又横流。\n行人自厌冲泥苦，野老方当得意秋。\n倦仆如何致千里，登天徒笑传鸣鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翁府君挽词","author":"楼钥","text":"肮脏翁夫子，高才噤不施。\n床头痴叔易，梦里阿连诗。\n德丧嗟何及，天胡弗慭遗。\n清风终未泯，吹拆谢庭芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莫子执挽词","author":"楼钥","text":"乐有父兄贤，谈经绛帐前。\n桂林孤素志，芹泮老遗编。\n小阮情何切，童乌业未传。\n槔閒最崇笃，口口话齐年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莫将仕挽词","author":"楼钥","text":"自叹清才久陆沉，晚从内典用工深。\n谛观烱烱死生际，宁复纷纷利禄心。\n载酒今谁问奇字，遗经古亦胜黄金。\n十年契阔遽如许，老泪临风自不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莫铜陵挽词","author":"楼钥","text":"经学高馀子，躬行慕古人。\n儒风三叶秀，和气一门春。\n台岭渐摩久，铜官抚字均。\n庠东亡二老，凝望倍沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁府君挽词 其二","author":"楼钥","text":"坦坦幽人履，恂恂长者言。\n忧时见颜色，乐道竟丘园。\n隐行推同气，高贤萃一门。\n四明耆旧传，他日数诸袁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁府君挽词 其一","author":"楼钥","text":"家学传三世，几间无二书。\n力行真勇猛，进取故舒徐。\n前辈多遗墨，先人祇故庐。\n后来窥瓮牖，志士为欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁通判挽词 其二","author":"楼钥","text":"盛德不容赞，多言可柰何。\n大圭元不琢，古井竟无波。\n前辈苦凋谢，后生谁琢磨。\n同庚适斋老，托体共山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁通判挽词 其三","author":"楼钥","text":"仅有一区宅，曾无二顷田。\n相过惟载酒，至老不言钱。\n几得拜床下，何堪哭道边。\n门人多著籍，下马向新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诸瑩拜扫晚归长汀","author":"楼钥","text":"雨意早垂垂，寒云晚更低。\n空中时散点，道上不成泥。\n绿柳桃相映，黄花麦与齐。\n迂回馀百里，喜见旧松堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资圣寺","author":"楼钥","text":"野溪清浅度危桥，径策枯筇上紫霄。\n晓雾暗蒸山寺雨，松风深隐海门潮。\n浮杯水涨人何在，洗钵池清意已消。\n又上乐亭基上望，云山万里更逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱江阴挽词 其二","author":"楼钥","text":"客授向东欧，君为郡督邮。\n岂惟寮契笃，更喜吏才优。\n每叹频年别，俄惊一梦休。\n虞山渺何许，泪落不能收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱江阴挽词 其一","author":"楼钥","text":"庾岭梅花暖，贤侯惠爱深。\n精神虽满腹，抚字亦劳心。\n九转竟难遇，二毛何遽侵。\n伤哉东逝水，无复大江阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱殿撰挽词 其一","author":"楼钥","text":"隽誉蜚庠校，孤忠动冕旒。\n救荒心欲折，忧国鬓先秋。\n惠满长江水，风清八咏楼。\n禁途交一臂，人物等闲休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱殿撰挽词 其二","author":"楼钥","text":"枌社归来晚，翛然得故吾。\n哦诗频刻烛，点易细研朱。\n有泪悲连璧，无阶奠束刍。\n名门馀庆远，丹穴看奇雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顾养直挽词 其一","author":"楼钥","text":"万顷东湖下，曾门起大家。\n子孙昌世业，文字作生涯。\n堂后萱犹树，庭中桂欲华。\n惜哉时不待，谁忍送悲笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顾养直挽词 其二","author":"楼钥","text":"旧向君家去，宜斋屡举觞。\n人哀诵诸顾，里不见他杨。\n身世惊春暮，湖山怆夕阳。\n园林未成趣，鸥鹭亦凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"商侍郎挽词 其一","author":"楼钥","text":"矫矫真御史，风生白笔端。\n出持肤使节，始著侍臣冠。\n给饟鬓先雪，筹边心为寒。\n天乎惊玉折，不及上金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"商侍郎挽词 其二","author":"楼钥","text":"所至仁声著，甘棠几去思。\n敬姜嗟哭子，伯道痛无儿。\n郎省伤连璧，文闱见刻辞。\n边民纷堕泪，忍读岘山碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿育王山涵秋","author":"楼钥","text":"清秋来此宿涵秋，雨后山泉自在流。\n夜暗寒声锵玉佩，灯明清影粲珠旒。\n枕流正自怜孙楚，洗耳何须效许由。\n我亦暂来专一壑，倚栏耽玩不知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿登山","author":"楼钥","text":"竹舆来访小梅山，山在空濛紫翠间。\n岚雾满林朝漠漠，溪声和雨夜潺潺。\n峰头丹井随潮信，松下禅房旧祖关。\n谁是无生谁不死，晨钟未响梦先还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄叔韶弟","author":"楼钥","text":"阿连试邑有成规，谁谓云间不可为。\n能使镬汤偏衮处，直如官府太平时。\n容容非欲后多福，赫赫何如去见思。\n子路当年曾请益，更须无倦以终之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄管叔仪通判并同官","author":"楼钥","text":"执别僧房日未斜，别离愁绪满天涯。\n清宵已落柔桑叶，小雨顿开荞麦花。\n醉里不知身是客，酒阑无奈客思家。\n凭谁寄语三夫子，归路还须好句誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题正卿通判可高亭","author":"楼钥","text":"樟坡直上可高亭，未见高亭祇见名。\n想像岂能胜一览，登高安得快双明。\n大龙湫下听雷吼，白石岩头看日生。\n咫尺好山随杖屦，自应老笔擅诗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题延平范氏六桂堂","author":"楼钥","text":"高门儒效许谁同，秀气于今照演峰。\n家学一椿连五桂，地灵两剑化双龙。\n三人衣钵清名接，累世簪缨庆事重。\n彼茁孙枝更林立，不须万户羡侯封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题江西刘氏勤有斋","author":"楼钥","text":"朴斲敷菑皆用勤，况吾儒者务多闻。\n万书插架非关我，一卷入心方属君。\n为学从来无止法，立身宁祇富多文。\n自怜习气今犹在，尚欲焚膏到夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题吴绍古县尉经德堂","author":"楼钥","text":"问舍玉真下，读书经德中。\n心期知共远，臭味许谁同。\n吹笛夜凉月，舞雩春暮风。\n直须涵泳熟，毋负象山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题汪端明坟庵真如轩 其二","author":"楼钥","text":"万个筼筜一草庐，伤心埋璧十年馀。\n革声谁听尚书履，金榜空悬少保书。\n无复遗音追正始，尚传新作过黄初。\n真成一代风流尽，欢息浮生信六如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题蜀李氏义概堂","author":"楼钥","text":"养气非为侠，轻财弗市恩。\n仁声高月旦，义概彻天阍。\n称美推贤嗣，扬名有顺孙。\n活人几百万，何止驷容门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旌表门闾安人陈氏挽词 其二","author":"楼钥","text":"族姓朱陈盛，夫人事愈明。\n老姑俱上寿，难弟各清名。\n节行辉彤管，门闾照赤城。\n宝邻方有托，何忍送铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旌表门闾安人陈氏挽词 其一","author":"楼钥","text":"妇德高千古，乡评彻九重。\n柏舟终自誓，石窌启新封。\n孙子传清白，闺门慕肃雍。\n死生无憾处，了不愧三从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚自拟滁亭转烟雨楼听角","author":"楼钥","text":"两寺疏钟夹岸闻，荒烟无数乱前村。\n山衔落日云生彩，溪溜孤舟水不痕。\n虫羽凄凄鸣绿暗，星晖隐隐照黄昏。\n欲归重到层楼上，更为梅花一断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹工部挽词 其二","author":"楼钥","text":"宦达推公早，丁年备皂衣。\n几为铜虎去，终向石桥归。\n齐国世臣少，贞元朝士稀。\n松风谈笑地，回首倍歔欷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹工部挽词 其一","author":"楼钥","text":"箕颍文章士，仪同社稷功。\n惟公承庆裔，有意振家风。\n祠禄真崇道，郎潜叹老冯。\n伤心循吏手，赍志九原中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁仲苍挽词 其一","author":"楼钥","text":"延赏高三让，殊科擅一鸣。\n元宾文未极，长吉记先成。\n妙语遗膏馥，玄谈悟死生。\n行人痛埋璧，父子若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁仲苍挽词 其二","author":"楼钥","text":"人物如君少，相期上石渠。\n博文该四部，笃学富三馀。\n泪尽知无及，交深未觉疏。\n何时酹坟草，细读茂陵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁运使挽词","author":"楼钥","text":"风月诗千首，烟霞宅一区。\n三年著朝迹，一节偾亨途。\n南海瞻遗堞，西门破老巫。\n才高不尽用，无地寄长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁审计挽词 其二","author":"楼钥","text":"寿夭固难问，吁嗟不忍言。\n婴啼摧玉树，衰泪洒芳萱。\n事契深群从，英才怆九原。\n悲吟惭楚些，无地与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁审计挽词 其一","author":"楼钥","text":"壮岁崭头角，夷涂试著鞭。\n群公争倒屣，诸老亦忘年。\n论议倾朝誉，功名短世缘。\n神伤贤伯仲，风雨夜无眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淳发漕荐喜而成诗并勉杓","author":"楼钥","text":"戊辰贡举忝余知，曾碍孙儿到省闱。\n欣汝今秋重预荐，喜吾即日可言归。\n门阑有庆人争贺，父子同登世所希。\n痴望十人俱上第，坐令昼锦倍光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淳谒告归省复还海陵","author":"楼钥","text":"吾子远归省，重闱俱粲然。\n难留毛义檄，又送子真仙。\n西笑仍千里，东归约二年。\n词场期自力，收取旧青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清高阁观雪次韵","author":"楼钥","text":"冲雪上层阁，真成清且高。\n主人风节峻，坐客笑谈豪。\n泛剡访安道，赋梅思水曹。\n好因窗映夜，痛饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盛夫人挽词","author":"楼钥","text":"婉昵闺中秀，清高林下风。\n相夫能尽礼，教子使移忠。\n边郡官无旷，都城养得终。\n壸彝今具在，流庆复何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"硕人居氏挽词","author":"楼钥","text":"顷侍尚书坐，曾闻阃助贤。\n晤言成勇退，里谒戒私专。\n梦断松江路，神伤薤露篇。\n悼亡千里泪，叠嶂想新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐潭","author":"楼钥","text":"灵潭深入白云堆，带雨春云为我开。\n乳石半空浑欲堕，瀑泉千尺正中来。\n两军酣战鼓鼙急，一雨生寒霹雳催。\n中有卧龙君勿狎，有时平地起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]