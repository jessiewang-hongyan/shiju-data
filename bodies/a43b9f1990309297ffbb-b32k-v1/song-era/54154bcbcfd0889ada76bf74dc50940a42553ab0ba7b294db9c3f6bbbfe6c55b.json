[{"title":"二月望游齐山呈仓使二首 其二","author":"钱时","text":"春到花朝花未多，小梅才作玉婆娑。\n东君不是恩光薄，无柰霜欺雪压何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月望游齐山呈仓使二首 其一","author":"钱时","text":"生平忠胆上摩天，两鬓如丝山水缘。\n欲向翠微穷望眼，淮山无数锁春烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上冢","author":"钱时","text":"春到人家齐上冢，纸钱蒿里白皑皑。\n獭鱼豺兽难磨灭，岂是师门学得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上清得酴醾用超然韵","author":"钱时","text":"林腰路转忽欣然，玉佩垂萝古殿边。\n客里对花如旧友，夜深清坐玉壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与客步月坐涧中石上","author":"钱时","text":"林遍山深一罅天，临流趺坐月娟娟。\n此时妙音谁能领，绕石琅琅走涧泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乡城长至怀双溪湖诸友","author":"钱时","text":"去年客梦水云乡，六里桥东过一阳。\n此日山城怀旧友，暮江风起雁声长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千顷廨院小憩老僧旧爇左臂干缘宝叔塔一绝悯之","author":"钱时","text":"见说当年老比丘，茶毗一臂作重修。\n山头宝叔成新塔，泉下应贻父母忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟三首 其三","author":"钱时","text":"说是说非无了时，到头谁免堕危机。\n满林春鸟高低语，终日不闻人是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟三首 其二","author":"钱时","text":"一毫头许便争衡，蛮触寻兵决死生。\n山隐等闲收至宝，却无人共老夫争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟三首 其一","author":"钱时","text":"百不如人此老身，老身何必要如人。\n等闲花草随宜种，多在山中住几春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山翁亭","author":"钱时","text":"蜀阜山头老钝顽，白云深处小凭栏。\n头头总是侬家事，可笑游人作景看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山隐见梅","author":"钱时","text":"万竹林端满树春，略无一点世间尘。\n年年相见年年好，转觉梅花是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山隐竣事海棠正花二首 其二","author":"钱时","text":"天机云锦拂檐牙，多少工夫到此花。\n恰莫匆匆等闲看，无边春色是吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山隐竣事海棠正花二首 其一","author":"钱时","text":"春风亭馆久生埃，不见花开知几回。\n日日登山君莫笑，山翁不为海棠来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山隐暮归呈诸兄弟二首 其二","author":"钱时","text":"羊肠世路尽聱牙，不碍庭前满树花。\n回首野棠思鄂韡，未妨时一到山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山隐暮归呈诸兄弟二首 其一","author":"钱时","text":"东风捲地起氛埃，山隐看花日几回。\n草草杯盘携社酒，今朝兄弟肯同来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞花二首 其二","author":"钱时","text":"看花恰莫厌离披，花到离披亦自奇。\n不是老夫无拣择，春风无日不花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞花二首 其一","author":"钱时","text":"尧夫花看半开时，花半开时春正肥。\n此日老夫无拣择，慇勤直到看花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仓台准朝旨牒县礼请讲行荒政以疾弗果出","author":"钱时","text":"溪山闲袖经纶手，畎亩能忘康济心。\n霈泽自天难出位，空惭有问到云林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月六日侄孙辈同食大麦二首 其二","author":"钱时","text":"冬春饿骨委寒波，宿麦离离柰尔何。\n此日一餐虽志喜，愧无膏泽汗颜多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月六日侄孙辈同食大麦二首 其一","author":"钱时","text":"大麦新炊苜蓿盘，一壶春酒小团栾。\n金丹九死生灵命，莫作寻常粝饭看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月望","author":"钱时","text":"一窗虚白贮婵娟，木叶无风自飒然。\n谁道家山孤负月，从初看到十分圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双溪","author":"钱时","text":"奔来衮雪夹中洲，声撼危栏趾欲浮。\n冷眼青山青不断，狂澜千古自争流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文峰讲行昏礼和起潜韵","author":"钱时","text":"自是无人别是非，何曾此外更精微。\n一门济济今成俗，政要回头悟指归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文峰夜饮三首 其三","author":"钱时","text":"可怜绳墨窘韩非，说着神仙到紫微。\n办得一双无事眼，玉梅枝上看春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689"