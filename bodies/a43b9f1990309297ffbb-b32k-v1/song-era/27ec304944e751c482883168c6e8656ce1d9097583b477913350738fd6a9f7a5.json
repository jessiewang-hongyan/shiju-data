[{"title":"送杭州道士钱自然","author":"赵抃","text":"帅王归觐息兵鋋，吴越蒙恩过百年。\n世赏至今轩冕盛，真孙宜作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观潮因寄五弟拊生日","author":"赵抃","text":"祝弟生辰不惮遥，元丰六稔庆三朝。\n源源祺寿来无尽，一似钱江两信潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张彭赴会稽丞","author":"赵抃","text":"扁舟行渡浙江滨，湖上风光已漏春。\n为报稽山民吏道，邑丞今是悟空人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用蓬莱法酿酒成以四壶寄越州程给事三首 其一","author":"赵抃","text":"功臣堂号与山堂，已斗醇醨又斗香。\n今酿蓬莱法差胜，乘壶携寄愿公尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用蓬莱法酿酒成以四壶寄越州程给事三首 其二","author":"赵抃","text":"武林新酝效蓬莱，莫把梨花较绿醅。\n安得逢春命高会，大家同入醉乡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用蓬莱法酿酒成以四壶寄越州程给事三首 其三","author":"赵抃","text":"一日湖头两信通，往来惟只递诗筒。\n何时得把金罍倒，观取诗翁作醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清思堂偶成","author":"赵抃","text":"垂老将休俗累轻，旧乡来守越王城。\n吾怀自信无污染，何必升堂思始清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送二十三侄岯还衢赴举","author":"赵抃","text":"行美文精即擅场，不论京国与江乡。\n乡人若问吾归计，已叩天阍第九章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送禅师广教赴衢南禅","author":"赵抃","text":"到日参徒耳目新，桃花一笑已中春。\n吾今告老还家近，亦作柯峰自在人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致仕后立春偶成","author":"赵抃","text":"四纪荣涂愧滥巾，圣恩从请幸全身。\n高斋静有无穷乐，又报元丰第四春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"监神泉监五弟拊生日寄法酝为寿","author":"赵抃","text":"岁首月三逢诞日，寿樽遥寄助童颜。\n黄庭内景非虚语，百二十年犹可还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送五弟得替赴阙","author":"赵抃","text":"三载神泉绩大成，交章使者荐能名。\n朝廷方且求人切，未可图閒学老兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛酉岁旦偶成","author":"赵抃","text":"一夕寅隅斗转魁，三阳和气入春台。\n鉴中华发浑霜雪，七十四从头上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送讲师惟爽归杭州","author":"赵抃","text":"旧隐重寻远世机，呼童把帚扫禅扉。\n疏帘捲尽南轩阁，引得湖光一片归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏竹为六弟抗司户生日","author":"赵抃","text":"万竿终日弄清风，溽暑消除尔有功。\n老去年时转潇洒，此君真是竹林翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题袁教授思轩","author":"赵抃","text":"补过尽忠随进退，潜心高与古贤期。\n吾儒造次必于是，何用凭轩始再思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬致政赵少师五首 其一","author":"赵抃","text":"夙荷公知独久要，政堂平日幸为僚。\n新篇屡拜金琼赐，千里同风不为遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬致政赵少师五首 其二","author":"赵抃","text":"明月惊人为暗投，珍函开发晓光浮。\n五章丽句真高唱，所得过于万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬致政赵少师五首 其三","author":"赵抃","text":"云涛朝暮湖山胜，曾伴仙翁烂漫游。\n别后瞻思閒屈指，岁华如箭已三秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬致政赵少师五首 其四","author":"赵抃","text":"短书临发意徘徊，寒夜霜晴上月台。\n濉水瀫江天共远，举头惟见雁南来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬致政赵少师五首 其五","author":"赵抃","text":"天台雁荡去寻真，往复秋冬过七旬。\n不是君恩山岳重，肯教归作自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周古尉武康","author":"赵抃","text":"少时来访武夷峰，学业优殊志气雄。\n今我老归公始仕，神仙宫在水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王九皋道人游杭州","author":"赵抃","text":"暂分仙袂下罗浮，又作钱塘佛国游。\n欲识先生踪迹否，江胡无碍一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己未岁除言怀示诸弟侄子孙二首 其一","author":"赵抃","text":"得请归田弛负儋，满头霜雪鬓䰐鬖。\n高斋屈指呵呵笑，明日新春七十三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己未岁除言怀示诸弟侄子孙二首 其二","author":"赵抃","text":"三岁尝叨贰国钧，两经吴蜀拥车轮。\n寻思政府归休日，八百科中止一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858