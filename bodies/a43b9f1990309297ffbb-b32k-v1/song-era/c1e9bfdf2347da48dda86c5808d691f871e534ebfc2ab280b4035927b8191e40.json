[{"title":"送陆务观编修监镇江郡归会稽待阙 其二","author":"范成大","text":"见说云门好，全家住翠微。\n京尘成岁晚，江雨送人归。\n边锁风雷动，军书日夜飞。\n功名袖中手，世事巧相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵正之同年客中 其二","author":"范成大","text":"毡车席帽各青春，花下骅骝一鬨尘。\n离合飘零十霜露，咸阳客舍有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵正之同年客中 其三","author":"范成大","text":"可怜山县五斤手，不识王孙八斗才。\n君自扶摇有霄汉，从渠蜩鴳舞蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太师陈文恭公挽词 其二","author":"范成大","text":"候火朝连夕，筹帷决纵擒。\n一江遮虏障，千古杀胡林。\n皦日黄河誓，浮云绿野心。\n身名两无憾，天壤独清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太师陈文恭公挽词 其三","author":"范成大","text":"圣父咨当璧，元臣预断金。\n玉衡宾舜日，黄屋遂尧心。\n国定功无迹，身闲病已深。\n旌忠有谟训，碑榜照来今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太师陈文恭公挽词 其四","author":"范成大","text":"趣召单车至，惊传两鬓凋。\n倾城迎国老，即日走天骄。\n梦已商人奠，身犹汉相朝。\n古来贤达意，生灭两消摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太宜人程氏挽词 其二","author":"范成大","text":"捧檄三牲养，称觞百岁期。\n身犹孺子泣，世已隙驹驰。\n吉梦青衣卜，丰碑黄绢辞。\n佳城有奇事，应足洗馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太傅杨和王挽歌词二首 其一","author":"范成大","text":"先庙垂忠烈，孤童侈旧勋。\n风云天策府，心膂殿前军。\n汴猘渐台蹙，胡骄罽幕焚。\n人亡汗青在，足以诏无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太傅杨和王挽歌词二首 其二","author":"范成大","text":"岁与灵光晚，名登甲令芳。\n剖符山若砺，交戟鬓如霜。\n半世三槐位，千秋异姓王。\n哀荣公不憾，人自惜堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少卿直阁郑公挽歌词 其二","author":"范成大","text":"忆昨登门日，驩传考室诗。\n谓公安且吉，何意哭于斯。\n遗老典刑尽，此邦名教悲。\n谁能传耆旧，他日慰吴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提刑察院王丈挽词 其二","author":"范成大","text":"日者悲离索，公今又眇冥。\n门人办韩集，子舍得韦经。\n此去念筑室，空来闻过庭。\n平生无路见，终古泣松铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长文再作复次韵","author":"范成大","text":"渚蒲汀蓼得霜残，归客思家不计寒。\n喜鹊门前人一笑，绝胜风色候长干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐子礼提举莺花亭 其二","author":"范成大","text":"愁边逢酒却成憎，衣带宽来不自胜。\n烟水苍茫外沙路，东风何处拄枯藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐子礼提举莺花亭 其三","author":"范成大","text":"垆下三年世路穷，蚁封盘马竟难工。\n千山虽隔日边梦，犹到平阳池馆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐子礼提举莺花亭 其四","author":"范成大","text":"文章光焰照金闺，岂是遭逢乏圣时。\n纵有百身那可赎，琳琅空有万篇垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐子礼提举莺花亭 其五","author":"范成大","text":"山碧丛丛四打围，烦将旧恨访黄鹂。\n缬林霜后黄鹂少，须是愁红万点时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐子礼提举莺花亭 其六","author":"范成大","text":"古藤阴下醉中休，谁与低眉唱此愁。\n团扇他年书好句，平生知已识儋州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬辰天申节赴平江锡燕因怀去年以侍臣摄事捧御杯殿上赋二小诗 其二","author":"范成大","text":"天中伞动玉舆来，万岁三声彻九街。\n想见牙床当殿过，舜裳云委拜尧阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾道己丑守括被召再过钓台自和十年前小诗刻之柱间后五年自西掖帅桂林癸巳元日雪晴复过之再用旧韵三绝 其二","author":"范成大","text":"拙疏何计补涓埃，惭愧双旌去复来。\n三过溪门今老矣，病无脚力更登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾道己丑守括被召再过钓台自和十年前小诗刻之柱间后五年自西掖帅桂林癸巳元日雪晴复过之再用旧韵三绝 其三","author":"范成大","text":"界天山雪净黄埃，溪上扁舟夜汎来。\n匝地东风劝椒酒，山头今日是春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄罴岭","author":"范成大","text":"薄游每违己，兹行遂登危。\n峻阪荡胸立，恍若对镜窥。\n传呼半空响，濛濛上烟霏。\n木末见前驱，可望不可追。\n跻攀百千盘，有顷身及之。\n白云叵揽撷，但觉沾人衣。\n高木傲烧痕，葱茏茁新荑。\n春禽断不到，惟有蜀魄啼。\n谓非人所寰，居然见锄犁。\n山农如木客，上下翾以飞。\n宁知有康庄，生死安崄巇。\n室屋了无处，恐尚橧巢栖。\n安得拔汝出，王路方清夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衡永之间山路艰涩薄晚吏卒鬨云渐近祁阳路已平夷皆有津津之色","author":"范成大","text":"朝登赤土岭，暮入黄泥谷。\n春江弄花月，归梦恍在目。\n觉来行路难，杜宇叫高木。\n凹中泥没踝，凸处石齧足。\n坐舆我尚病，想见肩舆仆。\n衡阳复祁阳，可暂不可宿。\n晚来出前冈，路坦亭堠促。\n将士走相贺，喜色如膏沐。\n人生本无闷，逆境要先熟。\n不从忧患来，安识平为福。\n夷涂不常遇，历险始知足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书浯溪中兴碑后","author":"范成大","text":"三颂遗音和者希，丰容宁有刺讥辞。\n绝怜元子春秋法，都寓唐家清庙诗。\n歌咏当谐琴搏拊，策书自管璧瑕疵。\n纷纷健笔刚题破，从此磨崖不是碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愚溪在零陵城对岸渡江即至溪甚狭一石涧耳盖众山之水流出湘中","author":"范成大","text":"一水弯环罗带阔，千古零陵擅风月。\n取名如许安得愚，因病成妍却奇绝。\n至今镜净不可唾，犹恐先生遗翰墨。\n泽及溪流不庇身，付与后来商巧拙。\n我欲扁舟穷石涧，春涨未生寒濑咽。\n纷红骇绿四山空，惟有风篁韵骚屑。\n清溪东去客西征，钴鉧潭边聊驻节。\n何时随汝下潇湘，归路三千橹伊轧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿清湘城外田家","author":"范成大","text":"驱马力犹彊，奏床身始疲。\n浮浮云拂帐，潏潏水鸣篱。\n未熟灯前梦，闲寻道上诗。\n湘中多夜雨，客枕最先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿深溪驿去广右界只一程","author":"范成大","text":"北户书频到，南云雁不飞。\n试评骑马路，何似钓鱼矶。\n击柝黄茅店，篝灯白竹扉。\n故园桑柘暖，亦有稻粱肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊长沙楚秀亭 其二","author":"范成大","text":"舟行风打头，陆行泥没鞍。\n且登裴公台，半日心眼宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钻天三里","author":"范成大","text":"非冈非岭复非坡，黄鹄不度吾经过。\n妻孥下行啼且笑，联手相携如踏歌。\n风吹汗乾人力尽，屐齿与石方相磨。\n钻天三里似千里，四十八盘将奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夔州竹枝歌九首 其六","author":"范成大","text":"百衲畬山青间红，粟茎成穗豆成丛。\n东屯平田粳米软，不到贫人饭甑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初四日东郊观麦苗","author":"范成大","text":"去岁秋霖麦下迟，腊残一雪润无泥。\n相将饱吃滹沱饭，来听林间快活啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋月夜","author":"范成大","text":"已放新凉入簟纹，更驱馀溽避炉薰。\n穿云竹月时时见，咽露莎蛩院院闻。\n稍喜雪山无斥堠，但虞烟驿有移文。\n行藏且付蘧蘧梦，明发还亲雁鹜群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起初见宾僚时上疏丐祠未报","author":"范成大","text":"浪将冠服衣猿狙，因病偷闲稍自如。\n时有好怀誇得句，略无情语怕回书。\n边城晏闭稀传箭，村巷春游未荷锄。\n迨此良辰公事少，天恩傥许赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆务观云春初多雨近方晴碧鸡坊海棠全未及去年 其二","author":"范成大","text":"报事碧鸡坊里来，今年花少似前回。\n笙簧冷落遨头病，不著梁州打不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最高峰望雪山","author":"范成大","text":"大面峰头六月寒，神灯收罢晓云班。\n浮空忽涌三银阙，云是西天雪岭山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至吴中亲旧多来相迓感怀有作","author":"范成大","text":"望见家山意欲飞，古来燕晋一沾衣。\n回思客路岂非梦，乍听乡音真是归。\n新事略从年少问，故人差觉坐中稀。\n不须更说桑榆晚，霜后鲈鱼也自肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自阊门骑马入越城 其二","author":"范成大","text":"断桥隤岸数家村，雨少晴多减涨痕。\n雪白鹅儿绿杨柳，日高犹自掩柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与至先兄游诸园看牡丹三日行遍 其二","author":"范成大","text":"蜂蝶萧骚草露漫，小家篱落闭荒寒。\n欲知国色天香句，须是倚阑烧烛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵同年杨使君回自毗陵同泛石湖舟中见赠 其二","author":"范成大","text":"曲误不须顾，客狂当好看。\n日斜双桨急，风驶夹衣寒。\n剩说归田乐，休歌行路难。\n石湖三万顷，何处觅忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵同年杨使君回自毗陵同泛石湖舟中见赠 其三","author":"范成大","text":"北渚乘风渡，西山带雾看。\n袖单嫌翠薄，杯浅怯金寒。\n宿雨收全易，春酲解却难。\n且留行色住，重肯过苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋后二日泛舟越来溪三绝 其二","author":"范成大","text":"一川新涨熨秋光，挂起篷窗受晚凉。\n杨柳无穷蝉不断，好风将梦过横塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋后二日泛舟越来溪三绝 其三","author":"范成大","text":"饭后茶前困思生，水宽风稳信篙撑。\n不知浪打船头响，听作凌波解佩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采菱户","author":"范成大","text":"采菱辛苦似天刑，刺手朱殷鬼质青。\n休问扬荷涉江曲，只堪聊诵楚词听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至晚起枕上有怀晋陵杨使君 其二","author":"范成大","text":"多稼亭边有所思，冬来撚却几行髭。\n也应坐拥黄紬被，断角孤鸿总要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵章秀才北城新圃 其二","author":"范成大","text":"西城如西塞，桃花古来多。\n钓艇鳜鱼肥，前身张志和。\n烟霏几白鹭，风雨一绿蓑。\n清江韵新引，清绝胜阳阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观禊帖有感三绝 其三","author":"范成大","text":"三日天气新，禊饮传自古。\n今人不好事，佳节弃如土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题鹿伯可见一堂 其三","author":"范成大","text":"雪溪兴尽船当回，却拟登陆游天台。\n经行见一堂前路，转入湖山寻误来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐啸斋书怀","author":"范成大","text":"老来穷苦事相违，兀坐铃斋竟日痴。\n眼目昏缘多押字，胸襟俗为少吟诗。\n月侵灯影吏方去，春遍梅梢官未知。\n直待食新方绶带，明朝骑马过陵陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二偈呈似寿老 其二","author":"范成大","text":"孟说所过者化，庄云相代乎前。\n何处安身立命，饥餐渴饮困眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰人日病中吟六言六首以自嘲 其二","author":"范成大","text":"目慌慌蚁旋磨，头岑岑鳌负山。\n笔床久已均伏，药鼎何时丐閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓枕三首 其二","author":"范成大","text":"卧闻赤脚鼾息，乐哉栩栩蘧蘧。\n病夫心口相语，何日佳眠似渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"园丁折花七品各赋一绝 其二 水精毬","author":"范成大","text":"缥缈醉魂梦物，娇饶轻素轻红。\n若非风细日薄，直恐云消雪融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子文见和云亦有小鬟能度曲复用韵戏赠","author":"范成大","text":"三年屏杯酌，甚矣吾衰矣。\n眼中有淄渑，犹解商略此。\n花酒俱来事更奇，不妨禅心絮沾泥。\n翠眉何时真度曲，细意烦君画蛾绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中六首 其一","author":"陈师道","text":"旧岁连新岁，凉床又暖床。\n山川屏里画，时刻篆中香。\n畏垒安吾土，支离饱太仓。\n若教身再健，鹤背入维扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题筠州钱有文明府新昌小道院 其二","author":"范成大","text":"勿云私淑小邑，可以匹休大邦。\n健笔谁能后赋，向来江夏无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴歈一首送丘宗卿自平江移会稽","author":"范成大","text":"吴儿与君缘不薄，再骑竹马迎南郭。\n吴儿与君缘复浅，坐席才温旗脚转。\n东人赋重越吟悲，趣了兹段随朝鸡。\n胸奇百鍊当活国，君岂独私吴与越。\n鹤鸣樟桥猿夜啼，匈奴未灭家何为。\n功成他年归结屋，好在山花休斩竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东宫寿诗 其二","author":"范成大","text":"并世勋华照古今，朱明綵服侍尊临。\n邦家大庆重亲养，社稷元良万国心。\n菊露壶觞秋色正，桂风殿阁月香深。\n欲知天序无疆处，铜律声中治世音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送闻人伯卿赴铜陵","author":"范成大","text":"雪压关山昼掩扃，故人何事短长亭。\n折腰直为瓶无粟，便腹犹怜笥有经。\n牒诉尘埃头更白，简编灯火眼终青。\n可怜东壁辉光外，寥落江湖处士星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李子永赴溧水过吴访别戏书送之 其二","author":"范成大","text":"犯寒书剑出春萝，风雪桥边得句多。\n牒诉缤纷似烟海，梅花时节奈君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"或劝病中不宜数亲文墨医亦归咎题四绝以自戒末篇又以解嘲 其二","author":"范成大","text":"意马场中汗血，隙驹影里心灰。\n吉蠲笔墨安用，付与蛛丝壁煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"或劝病中不宜数亲文墨医亦归咎题四绝以自戒末篇又以解嘲 其三","author":"范成大","text":"诗成徒能泣鬼，博塞未必亡羊。\n刚将妄言绮语，认作锦心绣肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"或劝病中不宜数亲文墨医亦归咎题四绝以自戒末篇又以解嘲 其四","author":"范成大","text":"师熸尚合馀烬，羹热休吹冷齑。\n解酲纵无五斗，且复月攘一鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送遂宁何道士自潭湘归蜀 其二","author":"范成大","text":"书剑飘然席未温，火云扑地暑烟昏。\n山黄水浊湖南路，竹月荷风忆范村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苏秀才归永嘉 其二","author":"范成大","text":"大道凝神术养形，形神俱炼始功成。\n劝君观妙还观徼，先作顽仙地上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵虞子建见咍赎带作醮 其二","author":"范成大","text":"儿女传观省见稀，病身聊复借光辉。\n莫嫌憔悴沈腰瘦，且喜间关秦璧归。\n不是典来还酒债，亦非将去换蓑衣。\n尘鱼甑釜时相阨，微汝谁能为解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿妙庭观次东坡旧韵 其二","author":"范成大","text":"升降三田自有丹，浪寻盘鼎斫仙坛。\n扣门倦客惟思睡，容膝庵中一枕安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊月村田乐府十首 其六 烧火盆行","author":"范成大","text":"春前五日初更后，排门然火如晴昼。\n大家薪乾胜豆䕸，小家带叶烧生柴。\n青烟满城天半白，栖鸟惊啼飞格磔。\n儿孙围坐犬鸡忙，邻曲欢笑遥相望。\n黄宫气应才两月，岁阴犹骄风栗烈。\n将迎阳艳作好春，政要火盆生煖热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊月村田乐府十首 其八 分岁词","author":"范成大","text":"质明奉祠今古同，吴侬用昏盖土风。\n礼成废彻夜未艾，饮福之馀即分岁。\n地炉火软苍朮香，饤盘果饵如蜂房。\n就中脆饧专节物，四座齿颊锵冰霜。\n小儿但喜新年至，头角长成添意气。\n老翁把杯心茫然，增年翻是减吾年。\n荆钗劝酒仍祝愿，但愿尊前且强健。\n君看今岁旧交亲，大有人无此杯分。\n老翁饮罢笑撚须，明朝重来醉屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]