[{"title":"晚风二首 其一","author":"杨万里","text":"晚日暄温稍霁威，晚风豪横大相欺。\n做寒做冷何须怒，来早一霜谁不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚风寒林二首 其二","author":"杨万里","text":"树无一叶万梢枯，活底秋江水墨图。\n幸自寒林俱淡笔，却将浓墨点栖乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚风寒林二首 其一","author":"杨万里","text":"已是霜林叶烂红，那禁动地晚来风。\n寒鸦可是矜渠黠，踏折枯梢不堕空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚兴","author":"杨万里","text":"双井茶芽醒骨甜，蓬莱香烬倦人添。\n蜘蛛政苦空庭阔，风为将丝度别檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚过黄洲铺二绝 其一","author":"杨万里","text":"数峰残日紫将销，一片新秧绿未交。\n道是今年春水小，涨痕也到岸花梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步","author":"杨万里","text":"半疋轻烟束翠山，一梳寒月印青天。\n生憎野烧无端甚，直上高林杳霭边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步","author":"杨万里","text":"晚暑无凉可得寻，小风一点慰人心。\n斜阳碎入高榕叶，翻作青瑶覆作金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步","author":"杨万里","text":"清水芙蓉未肯开，暑天花草底差排。\n鹿葱金凤何为者，也得园亭护两阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步追凉二首 其二","author":"杨万里","text":"风不须多只是凉，穿花度柳到人傍。\n细吹病耳飕飕响，徐弄轻衫拂拂长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步追凉二首 其一","author":"杨万里","text":"老眼偏明远岫孤，夕阳故遣树阴疏。\n蝉鸣叶底无寻处，随意闲行偶见渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春即事二绝 其二","author":"杨万里","text":"树头吹得叶冥冥，三日颠风不小停。\n只是向来枯树子，知他那得许多青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归再度西桥四首 其四","author":"杨万里","text":"朝过溪头听水鸣，似哀如怨百般声。\n归来依旧鸣未了，知向何人诉不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归再度西桥四首 其三","author":"杨万里","text":"尽日山行意未销，归来再与坐溪桥。\n山童抛石落溪水，唤作鱼儿波面跳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归再度西桥四首 其二","author":"杨万里","text":"水落沙滩倍有情，漩来漩去不成行。\n暗丛飞下小瀑布，拦住溪声独作声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归再度西桥四首 其一","author":"杨万里","text":"归近溪桥东复东，蓼花迎路舞西风。\n草深一鸟忽飞起，侬不觉它它觉侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚凉散策二首 其二","author":"杨万里","text":"半点轻风泛柳丝，忽吹荷叶一时欹。\n芙蕖好处无人会，最是将开半落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚凉散策二首 其一","author":"杨万里","text":"饭馀浴罢趁凉行，偶憩池头最小亭。\n醉倚胡床便成睡，梦闻荷气忽然醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚宿小罗田四首 其四","author":"杨万里","text":"白酒聊三盏，青灯欲二更。\n倦来乘急睡，过了睡难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚宿小罗田四首 其三","author":"杨万里","text":"萧洒低低屋，虚明小小窗。\n客间那得许，窗外更寒江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚宿小罗田四首 其一","author":"杨万里","text":"青林化作万黄金，落日光寒色却深。\n仰看松梢数松子，不妨更与数松针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚望二首 其二","author":"杨万里","text":"万松不掩一枫丹，烟怕山狂约住山。\n却被沙鸥恼人损，作行飞去略无还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚望二首 其一","author":"杨万里","text":"月是小春春未生，节名大雪雪何曾。\n夕阳不管西山暗，只照东山八九棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺","author":"杨万里","text":"晚暖好登临，吾衰也不禁。\n雪残千嶂玉，日落万梢金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚寒题水仙花并湖山三首 其三","author":"杨万里","text":"鍊句炉槌岂可无，句成未必尽缘渠。\n老夫不是寻诗句，诗句自来寻老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚寒题水仙花并湖山三首 其二","author":"杨万里","text":"水面无风也自寒，船门已幕更深关。\n莫将若下三杯酒，博与湖边几点山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚寒题水仙花并湖山三首 其一","author":"杨万里","text":"水仙怯暖爱清寒，两日微暄懒欲眠。\n料峭晚风人不会，留花且住伴诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴二首 其二","author":"杨万里","text":"先生老态似枯禅，解后东风也欲颠。\n才雨便晴寒便暖，四时佳处是春天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴二首 其一","author":"杨万里","text":"风收点滴晓檐声，云放朦胧晚日明。\n杨柳染丝才喜雨，梅花泣玉却祈晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴独酌二首 其二","author":"杨万里","text":"霜熟寒轻际晚时，帘间过影一鸦归。\n夕阳端与谁为地，只照游尘絮样飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴独酌二首 其一","author":"杨万里","text":"冷落杯盘下箸稀，今年淮白较来迟。\n异乡黄雀真无价，稍暖琼酥不得时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登连天观望越台山","author":"杨万里","text":"暮山如淡复如浓，烟拂山前一两重。\n山背更将霞万疋，生红锦障裹青峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登净远亭二首 其二","author":"杨万里","text":"簿书才了晚衙催，且上高亭眼暂开。\n野鸭成群忽惊起，定知城背有船来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登净远亭二首 其一","author":"杨万里","text":"重阳才过便新寒，去岁如今暑尚残。\n云外雁来元不觉，一声唤我举头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚衙野望","author":"杨万里","text":"上却城来忘却归，迎它来雁送它飞。\n可怜乌臼能缁素，却被清霜染作绯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚憩富阳二首 其二","author":"杨万里","text":"春馀客里政无聊，忽报潮头雪样高。\n急唤清空竹陵酒，旋尝梅子与樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚憩富阳二首 其一","author":"杨万里","text":"苕溪到得富春滩，度绿穿青半日间。\n未出浙西心已喜，眼中初见浙东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊玉田闻莺观鹭二首 其二","author":"杨万里","text":"清溪欲下影先翻，只鹭还将双鹭看。\n绿玉胫长聊试浅，素琼裳冷不禁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊玉田闻莺观鹭二首 其一","author":"杨万里","text":"晓寒顾影惜金衣，著意听时不肯啼。\n飞入柳阴多去处，数声只许落花知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊江山县驿","author":"杨万里","text":"闻道常山水壮哉，问途何惜小纡回。\n平生不到江山县，临老须教作一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊玩鞭亭二首 其二","author":"杨万里","text":"问著无声是阿兄，坐看家贼只吞声。\n戮尸大放经纶手，长柄判将锡茂弘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊玩鞭亭二首 其一","author":"杨万里","text":"老贼平欺晋鼎轻，一轮五色梦中惊。\n宝鞭脱急非无策，何似休将日绕营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊黄冈望海","author":"杨万里","text":"望中雪岭界天横，雪外青瑶甃地平。\n白底是沙青是海，捲帘看了却心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊黄宙铺饭后山行","author":"杨万里","text":"山行行得软如绵，急上篮舆睡霎间。\n梦里只闻人喝道，不知过尽数重山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨炊熊家庄","author":"杨万里","text":"朝饥一眼望炊烟，绕尽长溪过尽山。\n承露丝囊世无样，蜘蛛偷得挂篱间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望见灵山","author":"杨万里","text":"旱后催科恼杀侬，且随尺一解而东。\n灵山忽近西山远，回首新吴一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望清远峡","author":"杨万里","text":"刺船又入峡山间，江水初平失恶滩。\n道是峡山天下险，老夫今作坦涂看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望谢家青山太白墓二首 其二","author":"杨万里","text":"玄晖旧宅略无存，太白来游爱是间。\n占作醉眠床一只，谢家山是李家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望谢家青山太白墓二首 其一","author":"杨万里","text":"阿朓青山自一村，州民岁岁与招魂。\n六朝陵墓今安在，只有诗仙月下坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望横山塔","author":"杨万里","text":"水面生风分外严，竹根剩雪更新添。\n六年不见横山塔，茅屋东边忽半尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"杨万里","text":"花早春何力，香寒晓尽吹。\n月摇横水影，雪带入瓶枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花二首 其二","author":"杨万里","text":"带雪虽奇祗粉妆，酣晴别是好风光。\n却缘白日青天里，照得花明暖得香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花二首 其一","author":"杨万里","text":"东风微破野梅心，著骨清香已不禁。\n绿刺一尖双莟子，错书小字带悬针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花落尽有感","author":"杨万里","text":"五树梅花一树迟，花迟花早总离披。\n春风只解吹梅落，不为愁人染鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅残","author":"杨万里","text":"雪已都消去，梅能小住无。\n雀争飞落片，蜂猎未蔫须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅菊同插砚滴","author":"杨万里","text":"两枝残菊两枝梅，同入银罂酿玉醅。\n待得陶泓真个渴，二花酒熟与三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅熟小雨","author":"杨万里","text":"风从独树忽然来，雨去前山远却回。\n留许枝间慰愁眼，儿童抵死打黄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅露堂燕客夜归","author":"杨万里","text":"药玉船中酒似空，水沉烟上雪都融。\n梅堂客散人初静，椽烛烧残一尺红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦作碾试馆中所送建茶绝句","author":"杨万里","text":"天上蓬山新水芽，群仙远寄野人家。\n坐看宝带黄金銙，吹作春风白雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梳头有感二首 其二","author":"杨万里","text":"同郡同年总八人，七人零落一人存。\n如何独立薰风里，犹怨霜花点鬓根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梳头有感二首 其一","author":"杨万里","text":"身在荷香水影中，晓凉不与夜来同。\n且抛书册梳蓬鬓，移转胡床受小风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梳头看可正平诗有寄养直时未祝发等篇戏题七字二首 其二","author":"杨万里","text":"老子平生汤饼肠，客间汤饼亦何尝。\n怪来今晚加餐饭，一味卢山笋蕨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梳头看可正平诗有寄养直时未祝发等篇戏题七字二首 其一","author":"杨万里","text":"却因理发得披文，看尽庐山笔底春。\n寄语可师休祝发，癞边犹有去年痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮河中流肃使客","author":"杨万里","text":"淮水中流各一波，南船小住北船过。\n生憎两岸旌旗脚，引得霜风分外多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"添盆中石菖蒲水仙花水","author":"杨万里","text":"旧诗一读一番新，读罢昏然一欠伸。\n无数盆花争诉渴，老夫却要作闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日雨雪来早晴霁二首 其二","author":"杨万里","text":"清明一雪怪生寒，逗晓新晴雪未残。\n要见海棠还傅粉，捲帘不彻急来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日雨雪来早晴霁二首 其一","author":"杨万里","text":"清明一雨坏花时，梅杏樱桃总脱枝。\n挽住落英供细舞，东风犹自妒游丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日欲宿石门未到而风雨大作泊灵星小海六首 其六","author":"杨万里","text":"石门未到未为迟，小泊灵星也自奇。\n此去五羊三十里，明朝还有到城时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日欲宿石门未到而风雨大作泊灵星小海六首 其五","author":"杨万里","text":"波涛端不为君休，风雨何曾管客愁。\n自古诗人磨不倒，一樽大笑谢阳侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日欲宿石门未到而风雨大作泊灵星小海六首 其四","author":"杨万里","text":"一生行路竟如何，乐事还稀苦事多。\n知是风波欺客子，不知客子犯风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日欲宿石门未到而风雨大作泊灵星小海六首 其三","author":"杨万里","text":"石门欲到更无疑，隔海风涛未可期。\n到得石门非不好，只愁未到石门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日欲宿石门未到而风雨大作泊灵星小海六首 其二","author":"杨万里","text":"峡山前夕石间行，泊得船时破胆惊。\n惊到今宵已无胆，听风听浪到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日欲宿石门未到而风雨大作泊灵星小海六首 其一","author":"杨万里","text":"风雨来从海外天，灵星海里泊楼船。\n坐吟苦句斟愁酒，也是清明过一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明雨寒八首 其八","author":"杨万里","text":"风欹众柳自成妍，雨泣残花不忍看。\n急唤曲生尝杏子，及渠小苦未生酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明雨寒八首 其七","author":"杨万里","text":"闭户何缘得句来，开窗更倩雨相催。\n只言春色都归去，小树桃花政晚开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明雨寒八首 其六","author":"杨万里","text":"莫嫌细雨苦飘萧，政要寒声伴寂寥。\n杏叶犹疏不成响，且将纸瓦当芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明雨寒八首 其五","author":"杨万里","text":"苔阶滴雨翠方浓，须把寒珠溅鹿葱。\n梅子犹粘雪前蕊，海棠生恨夜来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明雨寒八首 其四","author":"杨万里","text":"桃李一空春已归，不须更待絮飞时。\n闭门独琢春寒句，只有轻风细雨知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明雨寒八首 其三","author":"杨万里","text":"今年寒食与清明，各自阴晴作么生。\n细雨千丝不成点，如何也解滴檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]