[{"title":"客居余明远来访","author":"董嗣杲","text":"风浪而今自忍闻，尚甘客隐大江濆。\n酒家债负将偿足，诗境情怀任醉分。\n爱睡有魔销椀茗，遣闲无事对炉熏。\n梧桐井畔敲门处，问字何人访子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客寓无眠信口赋秋感","author":"董嗣杲","text":"赤枫又积灌城头，如此江山不掩愁。\n青眼无人同乐岁，白头有句独悲秋。\n词章全拙知谁信，身世多虞谩自谋。\n篱角黄花消正色，北风更急莫登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客寓即事","author":"董嗣杲","text":"树头梅豆小，水际荻茅鲜。\n老客携名酒，顽胥纳俸钱。\n喜寻临晚兴，恨入惜春联。\n不似西湖乐，东风荡画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客寓邻家有园尝欲过之不可得","author":"董嗣杲","text":"形容淹白昼，意向落清樽。\n客榻犹移雨，邻园自掩门。\n秋高江一色，风起月多痕。\n忽忽孤生感，真难薄俗论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客滞","author":"董嗣杲","text":"粹容成槁木，浮迹类流萍。\n天地春明净，江山晚晦冥。\n花芒环野茜，柳桁接檐青。\n淹滞知何事，思归梦短亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将军教场墓","author":"董嗣杲","text":"阅武场开傍古松，忽惊尘起废墙东。\n黑蜂飞毒归锄下，白骨通灵入梦中。\n花草地宽千骑勇，鼓鼙声撼一坏空。\n若钱若马讹传久，难觅埋铭證异同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归","author":"董嗣杲","text":"秋老江城起戍尘，山收西日掩云津。\n留连光景多无酒，俛仰风埃独有身。\n旷野雁填遗阵阔，虚沙船发落痕新。\n故园松菊犹三径，梦过烟霞水石邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思隐二首 其二","author":"董嗣杲","text":"梦落家村野屋矶，欲治生事与心违。\n偃禾雨久溪声改，采菊人归鬓色非。\n灌圃肯差陈仲子，登山莫逊谢元晖。\n从今举步防轻蹈，更演潜书急掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思隐二首 其一","author":"董嗣杲","text":"岌嶪愁城不可攻，三年心事入秋空。\n虚名已出诸公右，往事都归一笑中。\n植杖耘田思北墅，补炉煮药老西风。\n临归自照凉池影，不与初来面目同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春近","author":"董嗣杲","text":"泻月江当户，编茅屋背崖。\n久贫难养气，独酌且开怀。\n雪水喧淮土，天风破楚霾。\n鞭春明日早，环佩想尧阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春游 其二","author":"董嗣杲","text":"登城最凄黯，绝殢脂粉醉。\n万里烟尘濛，掩此战争地。\n江风荡渔歌，便觉春光异。\n嗟我道不行，颇动乘桴志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳花","author":"董嗣杲","text":"翠丝窣地裹晴绵，三月春空灞岸烟。\n四下叶蕃如吐雪，一随风起欲漫天。\n池心直作浮萍化，墄胔多将缺藓填。\n恨落夕阳亭树晚，趁蜂趁蝶扑鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栀子花","author":"董嗣杲","text":"玉瓣凉丛拥翠烟，南薰池阁灿云仙。\n芳林园里谁曾赏，薝卜坊中自可禅。\n明艳倚娇攒六出，净香乘烈袅孤妍。\n风霜成实秋原晚，付与华灯作样传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浔阳馆晚步","author":"董嗣杲","text":"独下閒阶信杖行，虚空万籁挟秋声。\n天连淮树千章暗，月照庐峰九叠明。\n旧信传讹寒雁过，短生催老晓鸡鸣。\n可忧何止心头事，戍接荆流尚甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鍊丹井","author":"董嗣杲","text":"稚川曾此倒灵瓢，阑上银床压甃腰。\n丹气腾空知几转，神光射屋起中宵。\n有茶可品春煎细，何疾能治晓汲遥。\n万古仙踪应不泯，辘轳声落病僧寮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牵牛花","author":"董嗣杲","text":"篱笆雨过晚阳红，碧衬秋空点染工。\n河鼓星高钟异卉，铢衣烟靓袅西风。\n香挼茜彩涂姜色，蔓引凉姿入豆丛。\n为药尚犹分黑白，此花岂与易羊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独客二首 其二","author":"董嗣杲","text":"官治寄栖冷，僧楼凝望遥。\n江山延客眼，风雨聚秋宵。\n荐酒蒸淮枣，烹鱼糁汉椒。\n莫能谙食味，心迹转寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独客二首 其一","author":"董嗣杲","text":"独客梦中过，千愁醉里生。\n秋酲谁可解，晚卧自难成。\n破屋无人气，幽泉有雨声。\n南窗多不掩，想像竹房清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜对雨","author":"董嗣杲","text":"对月飞觞往事休，胡床寂寞庾公楼。\n西风解使蛩专夜，长日能无酒送愁。\n新雁阵分离塞徼，残萤火死落汀流。\n醉来独卧梧窗下，静听胡琴拨怨秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋岩入城后寄","author":"董嗣杲","text":"心知沈迹堕，耳熟旧诗誇。\n返照僧归寺，西风客忆家。\n微寒侵病骨，新梦惜年华。\n独坐无聊赖，沿篱看菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋岩自山中见约","author":"董嗣杲","text":"九江驿里见春风，几度怀清隔晓钟。\n思白有人伤柳色，依刘无地感萍踪。\n半生力学羞长剑，两载心期信短筇。\n九叠屏高有标致，远公相约则吾从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋凉怀归三首 其三","author":"董嗣杲","text":"元龙减尽旧时豪，尚落湓江枕怒涛。\n月下听歌情浩荡，灯前支病发萧骚。\n少年偶负投机愧，今日徒工煮字劳。\n归兴已浓秋思壮，垂虹亭上问三高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋凉怀归三首 其二","author":"董嗣杲","text":"风凉赢得四肢清，泛寄谁知去就轻。\n临水有亭秋更净，对花无酒月空明。\n雁行愁落荒汀远，梧叶寒填露井平。\n独绕曲廊心汗漫，附书千里述羁情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋凉怀归三首 其一","author":"董嗣杲","text":"清幽自足倚绳床，雨过浮云敛八荒。\n雄郭西风鸣夜籁，太虚凉夜泻秋光。\n槐花缀粉粘苔砌，桂子飘香入草堂。\n倦卧不知身是客，残灯欲灭泣寒螀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胜景园","author":"董嗣杲","text":"名花袅袅草纤纤，台榭随幽逐胜添。\n十样结亭环水树，一碑述记卧风檐。\n梅关桥落停?钥，射圃楼空失垛帘。\n向日相传谁学吠，村庄毕竟出沽帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶花","author":"董嗣杲","text":"花埋叶底寓春先，便想烹云煮活泉。\n玉脸含羞匀晚艳，翠裾高曳掩秋妍。\n灵随雷雨争抽瑞，尖吐枪旗趱摘鲜。\n带雪莫知开又落，采须谁厌老蜂颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荠花","author":"董嗣杲","text":"挑根扫叶古墙阴，雨后青腴有客寻。\n又见开花如雪处，不知遍野已春深。\n山殽难入膏粱味，冰室偏钟采撷心。\n荼苦回甘谁识取，周诗历历播微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送史制机之鄂州","author":"董嗣杲","text":"宿戍供王事，膏车趱客程。\n折荣湓浦柳，行色武昌城。\n借印科边饷，巡江点骑兵。\n忧时心更切，满望邑尘清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘汉老过芜湖","author":"董嗣杲","text":"歌传制锦久，乐得袖琴过。\n浙客量盐少，淮商贩药多。\n随灯游晚市，沽酒隔昏河。\n才见江豚起，东风又碧波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘统辖自黄冈归光州","author":"董嗣杲","text":"偃武身还老，还家计未非。\n贫依山寨住，喜访竹楼归。\n度陇书鸿少，翻场战马肥。\n月明羞北望，谁撷故园薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张子秀入京","author":"董嗣杲","text":"玉立当归香案傍，平时高论凛秋霜。\n锦囊自富惊人语，宝剑犹埋断佞光。\n雨外雷声随地起，江头虹气接天长。\n有谟入告需时用，未忍将身学子房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陆明府归嘉禾","author":"董嗣杲","text":"尘杂莫湔游宦非，端忧何暇寓琴徽。\n孝先便腹尚嘲懒，元亮折腰须问归。\n所惧弃官乡曲笑，不思献策庙堂稀。\n义和市尾渔舟聚，独乐披裘坐钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送矩上人","author":"董嗣杲","text":"单悬淮楚寺，裓染岁时尘。\n踏雪归何处，看云悟此身。\n三乘新见性，一钵晚随人。\n江北萧条甚，还期莫待春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送徐性初归隆兴","author":"董嗣杲","text":"岁华须鬓里，行色水云中。\n南径寒花在，西山落叶空。\n别怜今夜酒，歌续古人风。\n归隐东湖上，忘机狎钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送越人姚日章游淮","author":"董嗣杲","text":"气宇凌虹驾海长，薄游感慨旧封疆。\n家邻贺老千秋观，袖有曾公一瓣香。\n遍走江湖谙客况，快吟风雪过淮乡。\n井蛙我且安愚分，未卜何时共酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重入东林寺","author":"董嗣杲","text":"雁门市里梵坊通，整理重登兴未穷。\n双剑风高云气压，五杉阁峻水声空。\n欲抛世网离尘境，要扣禅机演祖风。\n况有昔贤遗迹处，白家池上白莲中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重叹","author":"董嗣杲","text":"心知天地厌羁留，痴坐忘言不点头。\n活脱世间泥塑样，痴贻江表陆沉羞。\n思仙廨竹招苍凤，学老溪梅缚翠虬。\n岁晚说归何所待，厚颜安足耻时流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重过清虚庵","author":"董嗣杲","text":"绝境惟闻天籁音，山游重缀壁龛吟。\n春生仙瓮新篘酒，尘锁书床旧调琴。\n丹井月空梧积满，瑶台雨渍藓埋深。\n明朝襆被归城市，万叠苍峦有梦寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重泊杨港","author":"董嗣杲","text":"交石夹头栖落鸿，卸桅强饭伤飘篷。\n隔洲渔屋披乱草，入港客舟维古枫。\n际晚望断风帘矗，才晴洗得雪林空。\n旧侨野寺重寻懒，回眺炊烟摇苇丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重荣桧","author":"董嗣杲","text":"一株苍桧卧龙身，受得隋朝雨露深。\n地下仙根将换骨，人间劫火不烧心。\n死条节节蕃春信，生意枝枝蓊翠阴。\n此木岂知魂可返，争传咒水出丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游东林","author":"董嗣杲","text":"溪水涵天影，山云趁屐声。\n信缘重一到，流梦入三生。\n瀑势翻空远，林阴障雨平。\n炉峰闲览胜，思附远公名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游能仁寺","author":"董嗣杲","text":"古寺踞城为甲刹，巍峨殿阁矗江云。\n香烟昏壁沿廊黑，砖塔喧铃彻郡闻。\n白日僧归春更静，清明鬼哭夜初分。\n住持羞接闲人话，要访时官杜广文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香林洞","author":"俞桂","text":"月月岩头古翠埋，绵云深隔洞门开。\n苍藤随石无根活，灵杞何年有种栽。\n气凝野烟疑麝过，暖熏山雨误蜂来。\n空庭谁领幽芳坐，雪鹤同行损绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌霄花","author":"董嗣杲","text":"根苗着土干柔纤，依附青松度岁年。\n彤蕊有时承雨露，苍藤无赖拂云烟。\n艳攲偷醉斜阳里，体弱愁缠立石颠。\n翠飐红英高百尺，藏春坞上忆坡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壶中日月与葛秋岩纳凉","author":"董嗣杲","text":"身离匡庐紫翠重，壶中且寄水云踪。\n故人远梦迷千里，浊酒高怀渺万钟。\n台上苦吟无别事，枕前间籁有孤松。\n不知忧乐随时意，但虑荒芜钝笔锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家书不至自嘲","author":"董嗣杲","text":"客愁难遏鬓华添，昼寝醒来饱黑甜。\n春雨褪花粘藓屐，晚风吹燕入芦帘。\n自知阙下家书断，不过城南卜肆占。\n萧散形骸天分定，江城惟有醉厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅次感怀","author":"董嗣杲","text":"乱眼悲人事，追程老客颜。\n鼍鸣风鼓浪，雁断日衔山。\n此际尘劳混，吾生赋予悭。\n吟联朝晚积，负得贺囊还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂花","author":"董嗣杲","text":"月地云丛花意妍，清芬曾向窦家传。\n登山不愧自招隐，斫树莫名谁学仙。\n香换西风埋麝腹，种分南海蕴龙涎。\n玉杯甘露何从得，欲折蟾枝是几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花","author":"董嗣杲","text":"占取韶光二月时，妒红深浅漫成蹊。\n暗销春恨含烟薄，靓落晨妆受雨低。\n忆树自伤前度种，见花谁想去年题。\n武陵源上风光异，引得渔翁过此溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐花","author":"董嗣杲","text":"清明疏雨洗芳天，烂积霞英涨晓暄。\n香蔼路阴埋古井，枝缠瓦影接颓垣。\n琴村鼓舜无遗调，圭叶封唐岂戏言。\n此本自云花自委，丛生树子堕秋原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海棠花","author":"董嗣杲","text":"鹦柔猩艳胜西川，有色无香意态妍。\n吟令美招名友聚，眠春羞并醉妃传。\n锦城红濯垂丝雨，绣幄青笼秉烛烟。\n莫待胭脂成粉去，月明便好泛金船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涌金池","author":"董嗣杲","text":"一道香沟压郭西，粉墙低护石阶危。\n短碑数尺镌何字，清泰三年凿此池。\n桥市浣衣无空处，庙门卖卜有灵时。\n碧桃自趁东流水，暗老春光水不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涌泉","author":"董嗣杲","text":"山腰溜脉出遥峰，隔断西湖翠几重。\n叠甃漫依僧刹久，煎茶曾入翰林供。\n亭心覆雨涂丹凤，石口嘘云喷玉龙。\n何日星驰天使绝，不知谁利涅槃宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烟霞洞","author":"董嗣杲","text":"万色无如叠翠何，何僧镌像屹嵯峨。\n山屏晴掩牌门杳，风钥阴封梵屋多。\n象落鼻形悬洞右，佛垂手迹寄岩阿。\n灯辉金碧琉璃椀，暗掩僧房络薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瓶蕉花","author":"董嗣杲","text":"鹅项窑壶插翠干，就中琼卉袅清寒。\n暑天流影澄方沼，尘眼迷丛倚曲栏。\n几叶但知静尾掉，数蕤易觉粉香残。\n西风枝上无多雨，留傍花台当画看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留兴国宫怀城中友人","author":"董嗣杲","text":"拜章坛下桂花清，客子看山眼更醒。\n万竹梳风凉透碧，乱峰收雨晓争青。\n城中佳客还相忆，月下幽泉政好听。\n谁肯结茅邻远社，白家犹有旧池亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留江城","author":"董嗣杲","text":"灌城眠食叹羁身，凭晓偏惊索镜心。\n南纪山川秋望远，西湖风月夜怀深。\n功名鬼妒投机罕，诗酒天嗔绝侣寻。\n陈迹自应迟料事，断鸿信杳况云阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留江城将还富池","author":"董嗣杲","text":"吟断悲秋字，愁归饯腊筵。\n天荒鹏路绝，水落雁汀悬。\n白羽沈邮箭，沧江负钓船。\n投閒须有日，处顺且添年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真珠泉","author":"董嗣杲","text":"泉光四散骇猿猱，迸起平池点滴高。\n谁欲斗量徒积梦，人将瓶汲肯辞劳。\n声随夜雨穿疏箔，名逐春风入小槽。\n别有雷峰峰下圃，一泓埋没在蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离江城遇雪","author":"董嗣杲","text":"头上同云密布饶，湓江门外揖华镳。\n舟穿苦竹黄芦去，帽任回风急雪飘。\n踪迹几年怀玉石，江山一夜变琼瑶。\n旁人莫讶吟穷返，慷慨殊胜过灞桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"素馨花","author":"董嗣杲","text":"负得刘王侍女称，何年钟作冢魂英。\n月娥暗吐温柔态，海国元标悉茗名。\n翠髻云鬟争点缀，风香露屑斗轻盈。\n分明削就梅花雪，谁在瑶台醉月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胭脂菊花","author":"董嗣杲","text":"绿蒂黄心簇绛英，何时负取旱莲名。\n预知荒径非全盛，先吐芳葩破独清。\n篱落赪填空有艳，风霜黄槁却无情。\n红嫣香绝谁伤旱，难结蟂桑处士盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花","author":"董嗣杲","text":"天机雪锦织鲛绡，艳朵亭亭倚画桥。\n无垢自全君子洁，有姿谁想六郎娇。\n翠房分菂莲须褪，玉藕抽丝暑叶摇。\n花里不妨呼净友，采香须棹月明桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莲花塘","author":"董嗣杲","text":"啼烟禽鸟役羁魂，又泊寒崖近水村。\n暗谷霭深迷树迹，败塘水涸见莲根。\n自收堕叶投官店，谁缚枯藤锁庙门。\n浊酒不浇寒极恨，几程陡入醉乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢林舜举","author":"董嗣杲","text":"命逢元造厄，时使壮心违。\n淮海三年客，山林一布衣。\n有家惟母在，无犬寄书归。\n明日重阳醉，休辞上翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱清观禾","author":"董嗣杲","text":"落叶清江路，秋行适古心。\n井由秦法变，河海禹功深。\n鸥浴蒹葭影，牛眠桑柘阴。\n谁怜浪游客，独倚断蓬吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]