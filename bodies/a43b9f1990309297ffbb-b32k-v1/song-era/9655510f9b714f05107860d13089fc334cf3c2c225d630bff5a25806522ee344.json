[{"title":"赠笔工周永年 其二","author":"曾丰","text":"初心聊欲以文鸣，开国何曾梦管城。\n借不中书非所歉，秋毫元重泰山轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠笔工周永年 其一","author":"曾丰","text":"岂无毫忽补于时，用尽初心卒见遗。\n不拔一毛徒自利，杨朱作计未为痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一春不得家书因省归计","author":"曾丰","text":"飞絮白相飐，落花红自纷。\n鲤鱼何处去，杨鸟岂堪闻。\n妇老难教馌，儿骄不解耘。\n归耕诚所愿，耕责望谁分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑十一月十一日决狱次日迎帅舟中赋二诗首呈吴司理 其一","author":"曾丰","text":"滞舟推若泥，逆水去如还。\n已历三辰次，才行十里间。\n千斯吾命薄，独尔破天悭。\n所赖圣贤事，其初不厌艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑十一月十一日决狱次日迎帅舟中赋二诗首呈吴司理 其二","author":"曾丰","text":"年老未归老，旬休那得休。\n将迎金屋客，方便石门游。\n白浪海之怒，玄云天也愁。\n诗情不关性，正尔自夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未上元后二日得老儿稚子平安三日得三从四十伯五十九叔讣 其二","author":"曾丰","text":"姑无忘冢妇，祖未识头孙。\n路远徒惆怅，书来得慰存。\n冬无馀谷粟，春可养鸡豚。\n切勿废生事，看人饱更温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未上元后二日得老儿稚子平安三日得三从四十伯五十九叔讣 其一","author":"曾丰","text":"夜窗灯黯郁，春枕梦交加。\n二父随朝露，馀生任岁华。\n倚庐晨复夕，占鹊验还差。\n为报儿曹道，先收待客茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未仲春思乡味会之乐简寄董伯虎","author":"曾丰","text":"天下清明节，江南笋蕨天。\n乱生无事种，争卖不论钱。\n带醋香醒鼻，和糟味滑咽。\n季鹰莼菜念，徒更杂鱼鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未端月南倅率诸同幕游景秦还至滴水岩南倅诸君赋两诗为倡随例次韵 其二","author":"曾丰","text":"拄到烟萝最上头，试询达磨问浮丘。\n仙人安往佛安在，木叶自沉云自浮。\n胸次不堪全汩没，公馀无废小嬉游。\n杯盘各称家丰俭，有即莫悭无莫求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未端月南倅率诸同幕游景秦还至滴水岩南倅诸君赋两诗为倡随例次韵 其一","author":"曾丰","text":"海边城北最高峰，岭外浮图第一宫。\n落叶扫空春乍至，浮云捲尽日方中。\n登高已幸容邹湛，向暖那应笑郝隆。\n收拾物华壮归色，囊中不是去年穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十五日为广州蒲涧节巩帅相招坐上默营两诗 其二","author":"曾丰","text":"石激幽泉响，风排古木号。\n离城未多远，去地不胜高。\n出处向来误，是非何处逃。\n安期相领略，回首付儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十五日为广州蒲涧节巩帅相招坐上默营两诗 其一","author":"曾丰","text":"侵寻逾七夕，次第到中秋。\n蒲涧广南节，熊车城外游。\n杯盘收复出，宾主劝还酬。\n痛为江山饮，离骚不读休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月晦日夜坐","author":"曾丰","text":"孟秋俄及晦，甲夜偶成晴。\n露坐发毛冷，风餐颐颊清。\n洗湔凡眼豁，抖擞肉身轻。\n宋玉知何故，悲来不禁情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十年前与曾恭仲为忘年之交岁辛亥值便赋长韵寄似","author":"曾丰","text":"孔欲华颠祢妙龄，忘年不足更忘形。\n弟兄偏是子眉白，朋友独于吾眼青。\n心若互驰常鉴寐，迹如相避各云萍。\n十年功已到千古，何日酣看又饫听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月三日至芗山寺刘薰卿在焉","author":"曾丰","text":"置身松下莫忘尘，况在松之上置身。\n荒垒中盘平卧斗，澄江外抱曲拖绅。\n春熙天色如初醉，烟肃山容若半颦。\n晋郡犹馀晋时事，幽人疑是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入广至赣雪霁天朗聊舒耳目","author":"曾丰","text":"数自离家今几程，半风半雨半阴晴。\n白云故作关愁色，乌鹊争为报喜声。\n来耗得梅偷传送，去途惟柳管将迎。\n囊中少带江西雪，见说五羊烟瘴轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入德庆舟中看雨","author":"曾丰","text":"云合苍天怒，风生老木号。\n雨跳珠点急，浪涌雪花高。\n作爽轻头目，俄寒竖发毛。\n顽躯金气盛，敢与瘴相鏖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月六日雨至次月一日始霁","author":"曾丰","text":"数自初旬至末旬，雨犹末了雪相寻。\n千山草木收元气，万里乾坤入太阴。\n城郭谯楼吹冻角，郊原驿舍捣寒砧。\n静听年少心须折，幸我已无年少心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六日立春舟中晚眺","author":"曾丰","text":"风住帆维软，人齐橹响匀。\n津桥横汲具，岸树挂酤巾。\n乱石知何处，孤篷任此身。\n三叹谢陈岁，一笑接新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山寺戏堂头僧 其二","author":"曾丰","text":"昼热催三伏，宵凉报五更。\n钟鸣尘外响，犬吠世间声。\n强聒蛙鸣雨，诪张鸟噪晴。\n黎明重睡熟，栩栩梦魂清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山寺戏堂头僧 其一","author":"曾丰","text":"竹不容尘入，山宁与俗交。\n开门悬梵偈，置榻解僧包。\n不见肘生柳，未闻头戴巢。\n葛藤非我事，笑语浪相嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上时相","author":"曾丰","text":"阊阖初开黄道乾，貂蝉屹立侍中冠。\n天高莫共星辰贵，地厚虽遥动植安。\n万物有归元气足，一毛无外太虚宽。\n相期浅浅非相爱，稷契皋陶头上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上魏太守寿","author":"曾丰","text":"腊雪纷纷天散花，馀清不但茁梅芽。\n更添西汉贤良种，聊振中兴宰相家。\n双手幸犹堪活国，百年元不在餐霞。\n寿随名勒南山石，石可磨砻寿莫涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与邓继高望沙山同赋","author":"曾丰","text":"先喜见沙山，俄藏叆叇间。\n云非夺吾好，天固与人悭。\n未遽清风起，何当旧观还。\n峥嵘终莫掩，兹且听潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久与广西帅年丈左史张舍人别自琼罢归过静江相见 其二","author":"曾丰","text":"直钩追古道，方凿背时风。\n得不坐三黜，曾何衔五穷。\n物情难复获，天理窒斯通。\n李绛鹗书里，能无孟李同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久与广西帅年丈左史张舍人别自琼罢归过静江相见 其一","author":"曾丰","text":"离年稠似发，契义重于山。\n不计命穷达，犹移书往还。\n匽藩新位貌，闻燕旧辞颜。\n勘破诗文处，吾其得订顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大庾北崖梅晚发","author":"曾丰","text":"中州梅较晚，大庾合先之。\n已似得南气，不应留北枝。\n天工新坐懒，春事故教迟。\n蜂蝶若知道，恬然不怨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广州 其二","author":"曾丰","text":"绕处无非湿，终年不识寒。\n家饶安乐睡，市卖喜欢团。\n倡女青芒屦，渔儿白布冠。\n北人落南者，久亦自相安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广州 其一","author":"曾丰","text":"室女环垂额，蕃儿布缠头。\n阓门罗姥妇，游艇售娼优。\n曲巷公渝滥，通衢乱溺溲。\n羊山来辄去，地恶不堪留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广州登盖海楼","author":"曾丰","text":"他求无可洗尘劳，盖海楼馀百尺高。\n十万人烟城缭绕，三千世界水周遭。\n偏于物外有双眼，正以胸中无一毫。\n非与海鸥强相入，海鸥元自是吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞蓬自解","author":"曾丰","text":"有底重安土，若为轻徇流。\n羞随草木腐，乐与汗漫游。\n凡是性如水，固然生若浮。\n勿嗤吾潦倒，天地海之沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中元日登越王台望海南 其二","author":"曾丰","text":"乙巳中元日，乾坤半月秋。\n危台掀突兀，老头搅飕飗。\n北客眼生处，南方天尽头。\n海槎乘兴去，咫尺是瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中元日登越王台望海南 其一","author":"曾丰","text":"仅从乾道岁，重创越王台。\n粉榜犹馀墨，丹楹已上煤。\n旧游人欲厌，今日我方来。\n老范碑无恙，从头读一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋途中","author":"曾丰","text":"携孥犹胜旅，在道不如家。\n素已中秋月，徒然九日花。\n厚颜今事左，短气始谋差。\n酒戒难为破，浇胸且瀹茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中都值东广便驰寄管漕","author":"曾丰","text":"落在京华九陌尘，镜中无日不眉颦。\n未论妻子其如母，不奈秋冬况复春。\n馁食且将蔬作肉，寒炊宁免桂为薪。\n馀无可献逐贫赋，寄与知音旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中都邂逅新崇德宰范纯之为同馆著语赠别","author":"曾丰","text":"文正三槐宅，延平六桂家。\n芝兰含露秀，雕鹗著风斜。\n螭首终簪笔，河阳且种花。\n乘时长得意，毋忘夜分茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为广东解嘲","author":"曾丰","text":"曲江而下水多石，大庾以南山半茅。\n相国犹馀心里印，祖师更剩杖头包。\n依稀舜乐宜人听，零落韩文任客抄。\n气候太偏风土恶，今诗聊解古人嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书张必达诗词卷首","author":"曾丰","text":"诗写水云真，词传花柳神。\n溜脂松濯濯，凝粉竹津津。\n色者空中幻，声其寂里尘。\n愿言收视听，其细入无伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月一日薄暮至三水倚樯攲枕","author":"曾丰","text":"皓月三江口，青蘋四岸边。\n风头横立海，水面上浮天。\n阴气犹能杂，阳威不敢燃。\n夏行秋月令，造物相吾眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五羊同官真率","author":"曾丰","text":"小醵无妨职，嬉游不离城。\n盘随丰俭出，杯听浅深倾。\n附耳俱情话，巡檐各意行。\n归犹有馀兴，后会莫寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五羊城南野行书所见","author":"曾丰","text":"棘篱围败圃，石桷盖倾墙。\n人缉蕉为布，家储蔗作粮。\n断桥铺以竹，全木听成航。\n要作南中记，曾须到海乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五羊遣书问董仲脩 其二","author":"曾丰","text":"风雨犹关梦，江山不隔心。\n宁无疑信意，未得吉凶音。\n岁月催人候，春秋得趣深。\n明年天子诏，沙里得淘金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五羊遣书问董仲脩 其一","author":"曾丰","text":"八面海风乱，四时天气均。\n常馐皆药物，熟客只医人。\n笔研为谋左，烟岚与死濒。\n仅从危得饱，姑以健偿贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五羊七月闲赋","author":"曾丰","text":"二十年前到已曾，今虽重到眼犹生。\n海无弃水归斯受，山不留云用则行。\n去雁来鸿如互避，稚金老火若交争。\n天机养至相忘处，物意天心两太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从北流入郁林望月岩","author":"曾丰","text":"青山罅外见青天，翡翠屏间一镜悬。\n表里集虚生至白，初终持满得长圆。\n光明照处人心足，混沌开时物理全。\n它义多悭兹独否，天无偏意有时偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日海南试笔","author":"曾丰","text":"南荒春较早，上朔日常暄。\n陡地风声恶，连天海气昏。\n夭桃与其媚，旨酒即之温。\n摸索吾胸次，熙熙自一元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公馀出晋康亭小憩","author":"曾丰","text":"客来非与景相期，万象殷勤自四围。\n山以出云为显设，江于朝海得依归。\n沙岚昏垫雨湔祓，烟水汩陈风发挥。\n公退云胡不私省，潜鱼幽鸟也知机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太白山西隐寺木犀","author":"曾丰","text":"族出于仙住傍僧，羞为春事与时争。\n长专太白山涵润，独淹中秋月渗清。\n色染真空如自失，香熏正觉若相成。\n灵云有幸相遭遇，不要桃花作證明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方罹残热忽值新凉喜而赋反悲秋","author":"曾丰","text":"晴宵如浸昼如蒸，变气知从激处生。\n风不相饶乘木败，火犹自负与金争。\n纤阿洗月为纯白，少皞澄天作太清。\n宋玉所悲吾所喜，长哦聊复发秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月岩","author":"曾丰","text":"岩腹刳为半月形，全功天且不能成。\n勿嗟圆处便生缺，犹幸晦中堪养明。\n更朔还多终有望，受亏已久得无盈。\n愿言鍊石补教足，使我众生眼界平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月明复翳","author":"曾丰","text":"大镜为谁圆，非昭莫破昏。\n澡身翻渤澥，耀德掠昆崙。\n有狗疑相食，何虫欲见吞。\n光明法眼藏，点涴不成痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"比以形字韵诗递送张功甫直阁未报复于本韵中思之别得一篇并写呈","author":"曾丰","text":"桂隐心虽欲谢名，其如德与桂俱馨。\n研穷诗学杜为史，勘破赋家骚是经。\n豹变不容藏炳蔚，鸿飞何遽入青冥。\n渊明门下无车马，竹杖芒鞋敢扣扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王俊臣尝从予游己未访别于庐陵群庠","author":"曾丰","text":"师席我虚设，道机君饱参。\n玄初疑若白，青卒过于蓝。\n蚁战何伤北，鹏图不日南。\n江皋离合思，烟与水相涵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午中元留罗子琳小酌","author":"曾丰","text":"送客独留髡，慇勤共一尊。\n星辰冥碧落，灯火耿黄昏。\n笑语浑无间，谈谐杂不根。\n遣诗邀月出，相与答中元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙辰十月风日积煖浙间花卉俱开","author":"曾丰","text":"广东冬气作春蒸，浙土如之得我惊。\n桃李猖狂争窃发，昆虫龌龊学微行。\n向南柳可为先进，投北梅犹是后生。\n物理乘除自相补，速成未必似迟成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东广西漕厅久废马少卿葺为签厅","author":"曾丰","text":"前厅长贮马，后阁久盛薪。\n岂料废台沼，犹留延幕宾。\n壁虫悲往事，巢燕笑来人。\n便过十年后，如今迹又陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代人挽王待制","author":"曾丰","text":"盘盘胸次五车书，凛凛朝端烈丈夫。\n诡道至前无肯可，危言及上有都俞。\n熊罴声撼据关虎，鹰隼气吞凭社狐。\n遗直莫容遗爱在，王公名字与湖俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬行买酒炭自随","author":"曾丰","text":"大寒已过腊来时，万物那逃出入机。\n木叶随风无顾藉，溪流落石有依归。\n炎官后殿排霜气，玉友前驱挫雪威。\n寄与来鸿不须怨，离乡作客未为非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜官舍围炉传酒","author":"曾丰","text":"放散衙曹小退安，闭门开架检书看。\n檐前月色生寥寂，屋外风声长隙寒。\n灰火拨愁头屡点，烬灯挑喜指频弹。\n家人知我饮机动，大白梨花送夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬旅怀归","author":"曾丰","text":"周正曾未了，秦腊又相寻。\n风日留馀暖，乾坤失众阴。\n乌翻南至影，雁堕北来音。\n黄落归根叶，前陈示意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬景感怀","author":"曾丰","text":"草曾为底恶，霜乃得能嗔。\n罢曳木无守，虔刘风不仁。\n枫衰山反本，石出水藏神。\n浩叹吾其老，犹为逆旅人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬晴酿霜雪不成","author":"曾丰","text":"一晴初已涉秋残，晴到深冬兴未阑。\n不雨临空聊尔湿，无霜元是盛哉寒。\n出乘气末群阴乱，归抱精风万物安。\n深省莫如坚坐是，还家毋更负蒲团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出会昌峡","author":"曾丰","text":"石峡侵寻过，江流次第平。\n篙人轻去住，船势任纵横。\n稳不妨危坐，忙犹得意行。\n明朝从起晚，但要到州城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出郊","author":"曾丰","text":"晓欲晴还雨，春疑早又迟。\n勾萌麻俟命，颖拔麦乘时。\n水有浮天意，山非入俗姿。\n野人逢野景，相爱似相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出清远峡","author":"曾丰","text":"水石三过峡，江流四望平。\n鸟经波面疾，云泊树头轻。\n晃朗天光合，溟濛海气生。\n且停篙与桨，迟速信船行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北归见摄徐闻邑大夫乃旧同官邵雩都之子予诗叙契","author":"曾丰","text":"赣邑交游十大夫，忘情诗酒邵雩都。\n籋云矫矫新龙友，栖竹亭亭旧凤雏。\n燕马北归休晚念，海鹏南运壮初图。\n云来后好今分付，车笠重盟幸勿渝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]