[{"title":"故里","author":"罗公升","text":"生长太平日，不识悲欢殊。\n今晨入故里，万感忽启予。\n人去鸟鼠乐，草长牛羊肥。\n土花幸无恙，犹作颓垣娱。\n平生怀古笔，拟赋东西都。\n岂知桑梓地，今即咸阳墟。\n欲知当日事，试问墙上乌。\n安得超世网，片帆渺江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日皇帝阁 其一","author":"罗公升","text":"蓬莱宫阙五云端，太液冰澌不敢寒。\n须信帝家春事早，勾芒昨夜引春班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨","author":"罗公升","text":"三更饱甘雨，翛然凉意秋。\n惊霆驾风至，气欲掀我楼。\n溟濛划轩豁，稻陇如泼油。\n兵凶岁相仍，糟糠甚珍羞。\n天公一反手，少缓带犊谋。\n诸贤自蒿目，百亩真吾忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓道中","author":"罗公升","text":"笳鸣雨声歇，据鞍迎晓风。\n桃花逞颜色，窈窕一川红。\n经年用越地，杀气浮太空。\n颇宜化工手，不到荆棘丛。\n莺声忽起予，梦落柳影中。\n缅怀习池赏，不减燕然功。\n横槊岂无人，赋诗定谁工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞岩","author":"罗公升","text":"但见佳山便合登，不须凭幻说超升。\n峥嵘神禹疏河势，镗鞳轩皇奏乐声。\n已有道人称吏隐，应无处士乐岩耕。\n近来太守君知否，只记西园是玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪扇馈松野叔","author":"罗公升","text":"霜筠析丝豪，雪楮剪圭琬。\n凉飔生其间，怀袖觉清婉。\n贱子西北来，持此献大阮。\n亦知秋气深，为表别怀远。\n洪钧转二气，暑极寒必返。\n君看千古日，未可异衰盾。\n霜雪虽云夺，箧笥亦何损。\n倘有解愠功，来岁出未晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕","author":"罗公升","text":"客散烛亦尽，明月共寂寥。\n三生东华梦，岁晚依僧寮。\n秋宵岂不凉，客心自如烧。\n循檐耿无寐，顾影自萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"罗公升","text":"归舆穿翠微，夜久树益苍。\n海蟾浴清波，吐此林表光。\n今宵衣上露，明日履下霜。\n儿童不知此，且喜今夕凉。\n风林忽响答，似识予心肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"罗公升","text":"明月从东来，幽窗光炯炯。\n疏窗一尺许，写我肩与顶。\n可怜窗下心，愧此窗上影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜有怀 其二","author":"罗公升","text":"稍稍暝色添，悠悠远山缩。\n秋声何方起，馀韵入修竹。\n兴来不知痴，桥外一筇独。\n灯光小市闹，人语深院肃。\n惟应无归云，背向檐下宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜有怀 其一","author":"罗公升","text":"今夕凉已透，开阳月初生。\n忽思会心友，谈锋隔江城。\n是非天意高，宠辱人事惊。\n众宾亦笑语，我独难为情。\n回风避老树，中宵有馀声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜观书","author":"罗公升","text":"秋夜不可奈，孤灯耿残书。\n书中何所陈，兴亡鉴贤愚。\n心兵忽森起，掩卷长嗟吁。\n童子问我言，自古夫何如。\n小人计目前，君子思远图。\n双髀骨已满，揽镜犹故吾。\n局蹐蚁封里，负此六尺躯。\n投桃勿复道，候虫吊风梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋望","author":"罗公升","text":"远树岚烟合，孤村落照横。\n江从前日浊，山似去年青。\n暝色鸦分去，羁愁蛩说成。\n乾坤久萧瑟，消息听鸿声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种药","author":"罗公升","text":"治生吾未能，学圃岂不恶。\n秋风雨如酥，畦土树灵药。\n荒茨出神奇，高下粲花萼。\n将期清百虑，岂独健双脚。\n平生林下心，五鼎视藜藿。\n常疑种玉诞，亦笑带经错。\n黄金污吾锄，矧肯白昼攫。\n归还劳卮酒，辛苦同为乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘玉田通判归山","author":"罗公升","text":"诗工穷鬼妒，貌古俗人讥。\n达士何荣辱，閒官更是非。\n面无三已愠，身带一癯归。\n已试囊中法，春田玉正肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食新稻","author":"罗公升","text":"野人何所赠，金粟眩双目。\n吾庐幸徒壁，恐受贾祸速。\n熟视心始平，中有稻一斛。\n开囊带风露，入釜间黄绿。\n云碓明珠跳，瓷椀幽兰馥。\n已分先农馀，不假惠伯卜。\n侑以手种松，领此一岁熟。\n大笑老杜陵，橡栗款空腹。\n天不怜万民，何以生百谷。\n所惧风雨疾，翻使风雨覆。\n倘无飘泊忧，田舍有馀福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓起","author":"罗公升","text":"危柯早得秋，羁鹤易知晓。\n幽人带星起，古木叫孤鸟。\n帘影一丈高，曙色万里杳。\n人稀苍茫内，树立浩荡表。\n安知南征云，不自厌纷扰。\n秋光接岩气，终觉风味少。\n红矜木蓉丽，白惜渚莲夭。\n观妄眼已空，触物思还悄。\n贺公岂真狂，有激或成矫。\n归登神圣台，一笑万缘了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中","author":"罗公升","text":"十日两示疾，修途若为情。\n闭蓬风涛中，益觉遗死生。\n顽石无枯株，千年亦何成。\n平生一大事，时至不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其四","author":"罗公升","text":"德光起龙沙，忽拔汴水帜。\n赭袍拜千官，始识皇帝贵。\n饮冰一何愚，剖腹有馀秽。\n可怜无知石，犹纪会同岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其二","author":"罗公升","text":"季龙紾兄臂，晚以兵自强。\n笑看华林花，谓与天地长。\n岂知肘腋间，豚犬皆豺狼。\n多须既滥死，朽骨污清漳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其二","author":"罗公升","text":"太初结绳制自好，庖牺仓颉计益疏。\n拓跋小羌行国字，钟山丞相著新书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其三","author":"罗公升","text":"隋文伟姿相，谈笑取周鼎。\n俘陈朝突厥，四海绝纤警。\n奈何枭獍祸，老不保腰领。\n不如临春人，到此醉不醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其一","author":"罗公升","text":"祖龙吞八荒，功名再开辟。\n方贪蓬山金，肯信滈池璧。\n平生焚椒兰，死得鲍鱼力。\n长城空巍巍，千古表汉域。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其一","author":"罗公升","text":"燕丹馀风被朔野，男女无别身益荣。\n谁云乃祖驺虞化，却自鹊巢行露生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶赋 其二","author":"罗公升","text":"巢由善择富，四海不易牛。\n古人耻苟得，一粟怀十忧。\n谁云黄屋荣，可掩赪面羞。\n那知井里蛙，锱铢重山丘。\n肝肠果何罪，日夕森戈矛。\n头曼岂不天，哀哉国为仇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶赋 其一","author":"罗公升","text":"定力了万花，正眼空须弥。\n俯仰天地间，此身亦如遗。\n平生空洞腹，不受俗子窥。\n奈何区区者，妄欲求吾嗤。\n掀须对南山，但见云度迟。\n却后百五岁，举似尔辈知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"脱身军府暂憩先月亭前挹湖光左右花木交映壁间题字亦有可观惜未及见月也","author":"罗公升","text":"四年尘沙中，奔走日不给。\n空歌下泉诗，颇愧夔子集。\n今晨出军府，心与归鸟急。\n花迎晓日笑，树沐清露湿。\n清漪舞游鳞，照影孤小立。\n重来期秋风，领略蟾影入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散慵","author":"罗公升","text":"散慵陟岚岭，恰与落日平。\n天秋万宇淡，尽见山水情。\n遥烟破众寂，危花疑月明。\n川原自潇洒，衣袂皆风声。\n鉴空识本性，凭高失平生。\n苍然暮色合，兴尽心复惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏渠","author":"罗公升","text":"疏渠行活水，水鸣空院幽。\n堂坳地母小，中有万里流。\n向来手拮据，华屋俄荒丘。\n犹馀愚沟迹，洗我中山羞。\n九河且平陆，起灭况一沤。\n相娱亦聊耳，南涧何多忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽言 日中乌","author":"罗公升","text":"日中有痴乌，食日疗饥腹。\n不省日无光，此身难驻足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽言 枭","author":"罗公升","text":"人谁独无母，汝母良可悲。\n汝饱讵几乎，亦有生子时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答戴用斋教谕","author":"罗公升","text":"学书早无成，学剑老可怕。\n不如反初服，一锸始学稼。\n虽烦远公招，实恐惠子嚇。\n纶言若春风，枯朽歘变化。\n平生河汾策，肯出叔夜下。\n飞潜各努力，兰菊异开谢。\n他年卖药来，石鼎赋雪夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢松野叔赠诗用首句惊舟出瞿塘还有平流安十字为韵 其二","author":"罗公升","text":"君字若修竹，潇洒风雨秋。\n君诗若轻帆，沧海万斛舟。\n快读意自醒，痼疾一剂瘳。\n细读殊味益，汲井百丈忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢松野叔赠诗用首句惊舟出瞿塘还有平流安十字为韵 其一","author":"罗公升","text":"庭中鸟鹊噪，门外鸡犬惊。\n知有锦绣章，来作金石声。\n松因屈子耻，菊为渊明清。\n今我独何者，照几新诗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道逢新婚者","author":"罗公升","text":"时危家如寄，生离恨终天。\n称家毕婚姻，岂必齐宋贤。\n白首未可期，乐此桃李年。\n畸人感雉飞，七载操断弦。\n三年扬州梦，化作空中烟。\n大义古有制，私情岂云牵。\n命也我所安，抚事增怅然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道傍古樟有竹附焉可发一叹","author":"罗公升","text":"古樟蟠山间，垂荫翳我里。\n岁久或反常，村童祭为鬼。\n大穴藏精灵，小隙窜蛇虺。\n尝闻有惊霆，搜抉破根柢。\n竹我君子徒，冰霜凛在齿。\n胡为事钻刺，蟠屈嵚岩里。\n乾坤亦广大，朽木何足恃。\n托身一失所，万水难复洗。\n松梅各相吊，为我二友耻。\n去去非吾徒，偷生不如死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感旧","author":"罗公升","text":"逝水日已远，愈觉别恨重。\n岁月不可留，又已闻鸣蛩。\n故衣馀手泽，见肘未忍缝。\n遥知春去后，飞花散无纵。\n游魂定何依，马蹄隔千峰。\n谁与持麦饭，一洒冢上松。\n凭高酹觞酒，聊以写我胸。\n彭殇同所归，百岁还相逢。\n但留一寸心，不愧三尺封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题邹安斋诗卷","author":"罗公升","text":"兵馀十八载，乃忽见此诗。\n乾坤发危涕，未论言语奇。\n古音乃泗磬，丽色藻鲛丝。\n想见堵墙人，倾倒落笔时。\n奈何清平调，变入寒笳吹。\n苍茫同谷意，天遣放厥词。\n墓槚忽可材，所患访何迟。\n空馀两家子，把卷惊合离。\n九原不可起，可起更可悲。\n祝君藏名山，小作千岁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"儗过钱塘约诸客同赋","author":"罗公升","text":"去者勿戚戚，来者勿赫赫。\n天地犹乘除，万古晨有夕。\n讵知今时今，不作异时昔。\n吴山越山青，旧日钱王宅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其十二","author":"罗公升","text":"锱郎璀贼世台家，卖主知作他邦臣。\n当年只算孙供奉，犹胜纷纷误国人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其六","author":"罗公升","text":"千秋一言致宰相，匈奴已谓朝廷轻。\n那知汉家有故事，倒取屠贩居公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其四","author":"罗公升","text":"秦王手创万世业，四海不足充侈心。\n孝文田家眼孔小，露台欲作悭百金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其八","author":"罗公升","text":"晋武深鉴前代失，诸王竞握兵马雄。\n何须更待东门啸，始叹铜驼荆棘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其二","author":"罗公升","text":"敖仓转粟走天下，山积云委如蒿蓬。\n子孙粒粟不到日，留与楚汉争英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其十一","author":"罗公升","text":"德宗急治相鬼质，间架算尽琼林开。\n鲁宣强聒亦徒耳，直到山南未觉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其十四","author":"罗公升","text":"李生平生嘻佛法，厕筹拭面邦计空。\n那知铁马浮江日，却是神僧建塔功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其七","author":"罗公升","text":"申屠蹶张一健卒，欲斩嬖幸尊朝廷。\n如何董贤小竖子，迨退宰辅如优伶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其三","author":"罗公升","text":"始皇渡江项籍笑，魏朝失政高欢讥。\n奸雄觇国自有在，岂必儒者能知几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其十三","author":"罗公升","text":"亚子十指得天下，尽取国用供至尊。\n一朝颠沛罂子谷，费尽软语谁知恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其五","author":"罗公升","text":"辽佐遣戍函谷举，平怀构兵江都亡。\n秦隋失道自速死，可是东海真不祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕城读史 其十","author":"罗公升","text":"隋唐晋汉本胡种，自入中国皆衣冠。\n不知耶律称皇帝，何似文皇号可汗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别詹厚斋","author":"罗公升","text":"闭门秋气深，霜虫伴书帷。\n高轩御风至，我屋还有奇。\n十年几离合，往梦不可思。\n岂期丘壑间，谈此五日诗。\n肝肠洗旧染，刀圭得新医。\n人间公等在，不必吾道衰。\n如何更轻别，莫计重逢时。\n霜馀出硕果，持用慰渴饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相字曾木讷","author":"罗公升","text":"仓公造文字，千古疲蠹简。\n尔来记草青，颇觉浮伪损。\n老曾相心画，乃复凿混沌。\n毫端窥灵台，口角出华衮。\n讷虽未成论，木亦不离本。\n西游观青原，佳士竞推挽。\n的应誇幼妇，不用愁御饭。\n道人衡气机，笔墨付一莞。\n聊持无形字，示子非俗眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠游仁翁","author":"罗公升","text":"南山有好鸟，来集鸿鹄行。\n鸣声日已都，六翮岁以长。\n虽云气类集，习久迹已忘。\n所期逍遥游，一息视八荒。\n三年稻粱少，去与鹰鹯翔。\n好音变饥啸，鸷声嗔馋肠。\n重来见鸿鹄，反噬气益张。\n鸿鹄不汝尤，矰缴防汝伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗太?","text":"素丝不改衣冠旧，黄道从教日月新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀","author":"罗太瘦","text":"淮海归来二十年，结庐仍向旧山川。\n既无酒债贫休恨，浪得文名老尚传。\n晓日轮蹄思柳外，春风羯鼓在花前。\n如今静听瓶笙韵，犹似当年咽管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题鹤林宫","author":"罗太瘦","text":"暑往寒来迭世间，有谁十载驻朱颜。\n骑鲸客去天连水，跨鹤人归月在山。\n炉火顿消情欲境，剑金须断利名关。\n烟莎随分岩前绿，猿马不惊春意閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"地藏塔","author":"罗少微","text":"还岭峰头霁色清，知微曾此学无生。\n鸟从青壁屏边过，人在白云天际行。\n一片晴霞迎晓日，万年松桧起秋声。\n个中仙景真奇绝，宝塔玲珑最得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗丙","text":"老媪独遗落，全家都挈携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴江圣寿寺","author":"罗处约","text":"渔翁沙鸟傍回塘，携杖闲吟绕寺廊。\n远岫不离青草渡，片帆时过绿苔墙。\n风狂林木生清籁，日暖涟漪动画梁。\n张翰思乡应有意，几多屏障水为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁县界虸蚄虫生","author":"罗处约","text":"方喜云油布，俄闻叶螣生。\n田神何纵虐，稼政自非明。\n颍凤那充食，吴牛已绝耕。\n黄堂厌粱肉，对尔自心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"罗处约","text":"无风烟焰直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"罗处约","text":"日移竹影侵棋局。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太湖","author":"罗处约","text":"三万六千顷，湖侵海内田。\n逢山方得地，见月始知天。\n南国吞将尽，东溟势欲连。\n何当洒为雨，无处不丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌衣巷","author":"罗必元","text":"乌衣池馆一时新，晋宋齐梁旧主人。\n无处可寻王谢宅，落花啼鸟秣陵春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卞壸墓","author":"罗必元","text":"节义之风古所褒，清谈于晋视如毛。\n百年王谢丘墟了，惟卞将军墓最高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长干里","author":"罗必元","text":"山垄中间号曰干，此干长里盛衣冠。\n想应王谢朝回后，日日行人看绣鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]