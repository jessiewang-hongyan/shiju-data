[{"title":"长至","author":"李纲","text":"黄钟之宫萌一阳，万汇滋发犹潜藏。\n书云讵复别祥异，揆景渐可知舒长。\n闭关不行著易象，客子倦游悲故乡。\n周南太史长太息，禋祀无因陪祼将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡浙江","author":"李纲","text":"理棹适桐江，随潮过鱼浦。\n山寒雪犹积，江迥月初吐。\n御气凌烟霄，乘槎渡星渚。\n空濛老龙吟，髣髴翠蛟舞。\n境清人自愁，夜静气尤古。\n独坐不成眠，霜晴听津鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐江行赠江致一少府","author":"李纲","text":"放浪江湖乃吾乐，羁束轩冕非所荣。\n谪官去为剑浦吏，鼓柁遂作桐江行。\n舣舟浙岸候潮至，百越微茫烟水外。\n波横天际海倒流，喷雪惊雷声震地。\n须臾风软潮已平，片帆去逐飞鸿轻。\n棹讴四起日西落，暮天杳杳惟参横。\n江山苍苍负残雪，江水茫茫浸寒月。\n谁云逐客苦悽凉，今我斯游最奇绝。\n清晨弭棹桐君庐，溪光山色世所无。\n故人见我一笑粲，杀鸡为黍聊相娱。\n嗟予仕宦等游戏，断梗飘蓬本无蒂。\n但令景物供吟哦，出处穷通何足计。\n此行幽讨殊未阑，满目叠叠皆云山。\n鹭飞鱼跃石齿齿，今夜且宿严陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉度寺","author":"李纲","text":"夕发富春渚，朝次桐君庐。\n桐君采药地，今作僧家居。\n石磴上窈窕，林芿下扶疏。\n山根二江合，清波见游鱼。\n霜晴响钟磬，日落归樵渔。\n客从何方来，弭棹聊踟蹰。\n清景难久驻，怅然还问途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严陵滩下作二首 其一","author":"李纲","text":"世祖龙飞万国朝，故人依旧隐蓬蒿。\n羊裘肯换貂冠贵，钓石终齐凤阙高。\n共宿客星亲帝座，贻书直气压时豪。\n东京臣子多名节，皆自先生铸此曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严陵滩下作二首 其二","author":"李纲","text":"帝座高悬汉客星，樵渔今亦想英声。\n钓台直下三千尺，谁谓先生只钓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兰溪访吴圣与不遇","author":"李纲","text":"夕次兰溪县，溪山照眼明。\n云端双塔耸，烟际一桥横。\n久旅易悽感，旧游如隔生。\n故人寻不值，飘泊若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆行","author":"李纲","text":"水落石出溪难行，舍舟束装趋路程。\n徒御諠呶乌雀噪，衣冠瑰伟儿童惊。\n天寒野迥怯霜露，日暮途远伤蓬萍。\n我生胡为浪自苦，浊酒且向灯前倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水硙","author":"李纲","text":"凿木为机运不休，溪边叠石駃溪流。\n但知随水能旋转，肯道舂粮不自由。\n轮辐讵为君子器，机关端与小人谋。\n方知抱瓮汉阴老，混沌何须是假脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏为吴语","author":"李纲","text":"莫问侬家作底愁，细思今古事悠悠。\n只因读得数行字，便觉分为一世忧。\n问舍求田须更以，济时泽物且能休。\n梁溪幸有閒泉石，正好归来作故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句","author":"李纲","text":"殷侯左降惟书字，陆相南迁不著书。\n今我新诗三百首，坐令二子觉区区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次退之蓝关韵","author":"李纲","text":"奏疏螭坳上九天，谪官剑浦路三千。\n披陈肝胆成微志，跋涉山川赖壮年。\n缅邈寄书黄犬后，凄凉陟岵白云前。\n君恩欲报知无所，清梦时时到日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三衢道中","author":"李纲","text":"行色虚无里，人声烟霭间。\n浪纹来縠水，地势逼柯山。\n浅濑通舟涩，飞桥跨石弯。\n风高云冉冉，滩急水潺潺。\n野迥松篁秀，境幽鸡犬閒。\n轻装因路险，隐耳觉言蛮。\n村酿酤来薄，溪鳞买得悭。\n浦晴鸣雁浴，林暝舞鸦还。\n寺僻殿阁古，堂虚苔藓斑。\n僧房清夜宿，幽梦到乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴三首 其一","author":"李纲","text":"日出霜晴鸟雀呼，束装还复戒征途。\n黄牛傍岸将孤犊，花鸭浮溪引众雏。\n桥断水寒寻野艇，路迷山曲问田夫。\n远游看尽溪山景，待向龙津书作图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴三首 其二","author":"李纲","text":"岁晚南迁殊未央，晓寒霜霰湿征裳。\n烟笼山彩远增翠，风皱溪澜细漾光。\n岭雪未销宫頞粉，野梅初发御炉香。\n谁怜飘泊螭坳史，曾向钧天侍紫皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴三首 其三","author":"李纲","text":"尽日篮舆山水中，每逢佳处慰飘蓬。\n拂云古木阴阴日，夹岸脩篁细细风。\n远岫长溪千里碧，断霞残照半天红。\n殊方景物随时好，却恨登临无与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏成绝句三首 其一","author":"李纲","text":"山色黛眉远，溪声玉佩珊。\n溪山怜逐客，故为结清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏成绝句三首 其二","author":"李纲","text":"粼粼溪底石，五色粲坚圆。\n安得女娲手，鍊之将补天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏成绝句三首 其三","author":"李纲","text":"小艇渡行旅，往来终日操。\n但令人利涉，宁复计劬劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"李纲","text":"日照溪光碧起鳞，溪头雁鹜自成群。\n可怜独鹤归何处，万里相随一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉山道中五首 其一","author":"李纲","text":"悠悠征骑渡溪岩，跋涉艰难分所甘。\n泉石几时归水北，风烟今夕过江南。\n日轮杳杳衔青嶂，天影茫茫浸碧潭。\n猿鸟不知迁客恨，云间啼叫满松楠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉山道中五首 其二","author":"李纲","text":"石路凝霜白，山村落月纤。\n溪头一桥小，烟外数峰尖。\n高亩层成级，寒沙软胜盐。\n江南风景好，无那旅愁添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉山道中五首 其三","author":"李纲","text":"乍入江南境，登临慰所怀。\n山林自平远，水石巧萦回。\n风暖鸟声媚，日斜云影开。\n故人千里别，欲寄一枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉山道中五首 其四","author":"李纲","text":"石藓红依日，岩松翠耐霜。\n入溪看岫色，和月认梅香。\n岁暮旅情恶，夜寒灯影光。\n劳生真一梦，回首意茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉山道中五首 其五","author":"李纲","text":"行李远瀫水，禅扉依玉山。\n烟岚数峰秀，云水一溪弯。\n小市晚犹合，疏钟寒自还。\n旧游如昨日，屈指十年间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望龟峰","author":"李纲","text":"何日清江使，来为碧落趺。\n凝眸望霄汉，曳尾谢泥涂。\n霜晓疑曝甲，云横如负图。\n前知傥可仗，吾欲问玄夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"述怀","author":"李纲","text":"早游文翰圃，误齿缙绅涂。\n兰省为郎久，霜台奋舌孤。\n荷知诚特达，励志敢踌躇。\n屡赐枫宸对，亲蒙御笔除。\n月卿论钜礼，柱史进寒儒。\n黼座当阳日，螭坳载笔初。\n明堂颁政事，路寝集簪裾。\n绣案横雕槛，天香夹御炉。\n翠华来宝辇，清跸警嵩呼。\n法驾临真馆，芳尘从属车。\n重瞳瞻日月，粹色仰琼瑜。\n侍立亲龙衮，书言粲帝谟。\n视朝崇政罢，劝讲迩英馀。\n丽日明金殿，轻风响佩琚。\n漏声寒淅沥，槐影绿扶疏。\n紫橐陪时彦，黄扉寓直庐。\n仙游疑阆苑，清梦岂华胥。\n遇事肯怀禄，衔恩宁惜躯。\n惟惭涉道浅，岂恨与时迂。\n犬马知爱主，龟蛇思报珠。\n未终青史志，一奏皂囊书。\n谁谓爰丝直，端同汲黯愚。\n谪官来剑浦，襆被出神都。\n感激心独苦，飘零岁已徂。\n悽悽念终养，冉冉叹征途。\n四海尽蒙泽，孤臣方向隅。\n愿回天上照，一起辙中枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短歌","author":"李纲","text":"周家柱史本吾祖，唐室谪仙尤所许。\n垂世空馀道德经，傲时且以诗酒名。\n我今去作龙津客，学道吟诗真自适。\n也胜骑马听朝鸡，晴压尘埃雨压泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴 其一","author":"李纲","text":"游戏清都不记年，谪来犹作地行仙。\n龙墀叩额真率尔，石马系门非偶然。\n野寺山庄随意宿，溪鱼村酿不论钱。\n男儿本有四方志，出处安时休问天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴 其二","author":"李纲","text":"冲涉脩途仆已疲，今宵聊复宿沙溪。\n心怀浙右家无耗，身在江南路欲迷。\n孤鹜断霞晴杳杳，暝烟荒草晚悽悽。\n登临谁会悠然意，寒日无言又向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴 其三","author":"李纲","text":"风景正高洁，岁律忽峥嵘。\n岸竹森如束，山田漫已耕。\n溪寒幽石出，岫远暮云横。\n试问螭头吏，谁令向此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南六咏 其一","author":"李纲","text":"江南山，秀色晴光杳霭间。\n一带平凝愁翠黛，数峰孤绝耸烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南六咏 其二","author":"李纲","text":"江南云，片片飞来湘水滨。\n愁绝苍梧鼓瑟女，怅望阳台行雨神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南六咏 其三","author":"李纲","text":"江南月，依然照我伤离别。\n故人千里共清光，玉臂云鬟香未歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南六咏 其四","author":"李纲","text":"江南竹，霜霰岁寒依旧绿。\n谁向溪边养箨龙，滴露摇风一林玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南六咏 其五","author":"李纲","text":"江南梅，昨夜溪头玉雪开。\n赠远欲传千里恨，和烟为折一枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南六咏 其六","author":"李纲","text":"江南客，鬓发苍浪不堪摘。\n明时迁逐念前非，一夜愁吟霜月白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿信州景德寺禅月堂","author":"李纲","text":"野寺虚堂倚翠微，云山极目望中疑。\n溪寒连舰栏干直，日暮高楼鼓角悲。\n倒景星河光破碎，乱萤灯火影参差。\n贯休髣髴英灵在，应笑登临强赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岩石村店有石泉梅橘幽雅可爱","author":"李纲","text":"岩下鸣泉淅沥飞，谁知山店亦幽奇。\n已过野橘分金日，未见寒梅喷雪时。\n旋洗云粳炊白玉，自挑霜菔缕青丝。\n慇勤赋咏留岩石，他日重来觅旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶道中杂咏三首 其一","author":"李纲","text":"半世区区何所求，南来岂为稻粱谋。\n烟岚远近浓还淡，石濑萦回咽更流。\n云外钩辀听处好，溪头略彴渡时幽。\n何须更论他年事，且把风光慰旅愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶道中杂咏三首 其二","author":"李纲","text":"鬓毛萧飒寸馀冠，蒙犯风霜却岁寒。\n但使孤忠能感激，岂辞远谪备艰难。\n苍苍云木留深景，渺渺深溪泻暮湍。\n独坐苦吟山寺冷，照人孤月正团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶道中杂咏三首 其三","author":"李纲","text":"漠漠烟村一笛风，溪山都在夕阳中。\n遥看天色暮云碧，渐见山头野烧红。\n闽岭风烟知已近，浙江书问恨难通。\n暝投山寺凭虚阁，隐耳犹听响暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过鹅湖留赠昌长老二首 其一","author":"李纲","text":"云山深处到鹅湖，万木森森一径纡。\n日落风高钟倍响，烟寒林暝鸟相呼。\n宗风振起人能继，祖道流传德不孤。\n须信山林真隐地，纷纷朝市更何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过鹅湖留赠昌长老二首 其二","author":"李纲","text":"谪宦去为剑浦吏，税驾且作鹅湖游。\n沈沈梵宇殿阁古，寂寂胜地林泉幽。\n祖师道场谁继嗣，妙峰德云真比丘。\n夜寒灯下接软语，却恨行客难淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌老询予来历以诗答之","author":"李纲","text":"休问西来意，吾行日向南。\n悽悽达磨忏，历历善财参。\n旧事已不忆，新交宁易谈。\n维摩本无语，非是学三缄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石井慈济泉二首 其一","author":"李纲","text":"谁将石洞当泉池，馀溜溅溅落水陂。\n山骨凿开苍玛瑙，云腴凝贮碧琉璃。\n龟浮水面寒光动，竹舞岩端翠影垂。\n泉石幽奇天下少，秘藏休使北人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石井慈济泉二首 其二","author":"李纲","text":"岩石嵌空湛碧泉，酌甘鉴静意萧然。\n幽深端有神龙穴，虚迥疑藏古洞天。\n云影漾波光璀璀，石渠飞溜响涓涓。\n会须掬取岩中水，洒作膏霖遍八埏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山道中","author":"李纲","text":"行李踰江峤，风烟接武夷。\n地灵嘉木秀，天阔暝云垂。\n泉石日相乐，雪霜寒自迟。\n寄声山下士，扫壁待题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小溪","author":"李纲","text":"脉脉寒溪彻底明，临流聊复濯吾缨。\n风微静爱琉璃色，竹密遥闻环佩声。\n漾月下摇金潋滟，涵虚不动镜澄泓。\n自怜逐客难淹泊，不为溪山景太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过紫溪值雪","author":"李纲","text":"明时报国敢怀安，远谪方知行路难。\n云隔江乡来雁寂，雪飞闽岭敝貂寒。\n韩诗解道蓝关恨，贾赋聊凭鵩鸟宽。\n谁念紫皇香案吏，飘零已觉鬓毛乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中过分水岭六首 其一","author":"李纲","text":"寒云漠漠雪霏霏，正是行人度岭时。\n密洒峰峦开玉府，乱妆林木发琼枝。\n步高渐入烟霄路，望远都迷涧壑姿。\n回首江乡何处是，断蓬飘梗不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中过分水岭六首 其二","author":"李纲","text":"闽山高处却无风，密雪飞云堕晓空。\n去路似从银色界，此身疑到广寒宫。\n落梅飘絮来琼树，涌浪崩云叠玉峰。\n景色幽奇无似雪，平生观雪此为雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中过分水岭六首 其三","author":"李纲","text":"蔼蔼层阴送雪来，乱山深处白皑皑。\n积岩错认蓝田玉，著树全疑庾岭梅。\n光射九霄来夜月，冷凝千嶂蛰春雷。\n武夷路近须晴霁，为卷风云一饷开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中过分水岭六首 其四","author":"李纲","text":"一夜同云凝不开，晓寒整辔马虺尵。\n千岩万壑萦纡处，密雪回风散漫来。\n愁里溪声琴的历，望中山色玉崔嵬。\n溪山得雪尤奇绝，模写无工恨不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中过分水岭六首 其五","author":"李纲","text":"瑶妃游戏水晶房，故剪冰花试晓妆。\n坐见初平岩畔石，化为元放陇头羊。\n培堆积玉寒光瑩，顷刻开梅冷艳香。\n好是碧天云散后，野蟾来助一轮光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中过分水岭六首 其六","author":"李纲","text":"玉龙耕种素芝田，误入飞琼小洞天。\n璧月珠星争璀璨，瑶环瑜珥斗婵娟。\n水晶宫阙云腴滑，白玉楼台雾彩鲜。\n骨冷魂清难久驻，恍然昆阆梦游仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次大安驿雪霁","author":"李纲","text":"雪霁烟村风满林，暮天垂影碧沉沉。\n一轮明月光相射，千里白云寒更深。\n寂寞樽盈陶令酒，飘零泪满仲宣襟。\n灯残夜永不成寐，庄舄悽然自越吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山家","author":"李纲","text":"青山掩映野人家，翠竹苍松一径斜。\n夜对月钩沉浅浦，晓看鸟篆印平沙。\n溪头驯畜多宜鹜，园里灵苗可种茶。\n占尽溪山幽胜处，自将风物向人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将次武夷","author":"李纲","text":"行行路近武夷山，秀气蜿蜒百里间。\n苍石插天云缥缈，碧溪通壑水弯环。\n神仙恍惚谁能识，洞府深沉自不关。\n我向湖中如得路，便应脱屣谢尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇安宰见示武夷山图记","author":"李纲","text":"征轩欲作武夷游，先借图经次第求。\n须信神仙真窟宅，故令峰岫巧雕锼。\n四时花木千岩秀，一水波澜九曲流。\n明日泛舟山下去，按图细细问踪由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自入闽境值雪默祷武夷君游山日雪霁有感","author":"李纲","text":"鄙陋安能到古人，寸心潜格武夷君。\n誓辞叱散蛮溪雾，诗句驱开衡岳云。\n忠谠自应惭吏部，精诚何敢并将军。\n氛霾卷尽留残雪，妆点峰峦意更勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"趋真亭","author":"李纲","text":"烟霞深处一亭閒，石磴萦纡紫翠间。\n但觉峰峦劳顾揖，不知身到武夷山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游仙溪","author":"李纲","text":"一溪九曲贯群峰，演漾轻舠浅碧中。\n杳如误入武陵去，落花流水山重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武夷山","author":"李纲","text":"百里云山碧玉林，雕锼融结见天心。\n幔亭会散笙箫远，天柱风高烟雾深。\n画鹤独留青嶂表，林花常发紫岩阴。\n梦魂清切先曾到，故使飘零特特临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幔亭峰","author":"李纲","text":"燕罢虹桥绝世氛，曾孙谁见武夷君。\n更无裀幕空中举，时有笙竽静处闻。\n猿鸟夜啼千嶂月，松篁寒锁一溪云。\n洞天杳杳知何处，翠石苍崖日欲曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]