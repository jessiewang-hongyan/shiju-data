[{"title":"隐直感秋思南游予欲北还未得","author":"刘敞","text":"枥马常嘶北，边鸿却愿南。\n一时秋气感，两地物情谙。\n俗怪玄尚白，自疑青出蓝。\n何当鹿门隐，数就德公谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"始闻雁","author":"刘敞","text":"长风送羽翼，千里逐阳和。\n朔漠应飞雪，江湖始见波。\n识时机不浅，愁旅叫空多。\n勿以稻梁故，早飞乘网罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"府公说牡丹盛开是日逼晚意不及观","author":"刘敞","text":"落日含明艳，轻风袭煖香。\n传闻乱人意，相见弄春光。\n醉里岁空晏，愁中夜未央。\n异时惊丽绝，秉烛正难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与杨十二廷评同登城东门","author":"刘敞","text":"绿树浮萍合，青山画障开。\n登临共今古，壮观杂欢哀。\n长日消棋局，微风引酒杯。\n浮云满西北，容易雨飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春暮闻莺","author":"刘敞","text":"醉里春空尽，江边客未归。\n可怜鸣晛皖，似欲诉芳菲。\n珍树移时语，残花入眼稀。\n离居亦幽独，求友莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除日雪","author":"刘敞","text":"迎年椒献颂，驻腊雪留寒。\n偏坐春华早，微增暮景宽。\n琼瑶九城阙，玉帛万衣冠。\n欲书甘泉会，他时盛暑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋莺","author":"刘敞","text":"高举慕求友，翩然辞谷中。\n那知改春序，又复到秋风。\n节物感归燕，异声嗟远鸿。\n归非今正好，霜露脱梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉夜露卧","author":"刘敞","text":"风露清相袭，银河湛不流。\n澄辉亦终夕，爽气特先秋。\n高卧自微尚，冥烦嗟倦游。\n不眠计万事，出处竟悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空钓得鱼","author":"刘敞","text":"持钩非有钓，吾犹臧丈人。\n何知引纤茧，忽复得潜鳞。\n独乐意逾适，傥来情亦真。\n君看渭旁叟，八十老垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋月","author":"刘敞","text":"蟾光瑩碧墀，天色冻琉璃。\n市响新晴后，风和欲暖时。\n杉松冷岑寂，楼殿黑参差。\n静者非无趣，长吹遗所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜二首 其一","author":"刘敞","text":"月出浮云尽，风生中夜清。\n星辰竞摇动，河汉湛虚明。\n老树稀疏影，惊禽断续声。\n秋怀先已乱，蟋蟀更宵征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜二首 其二","author":"刘敞","text":"凉月含秋色，江天复雨晴。\n风雪异明灭，河汉亦凄清。\n惊鹊时翻树，悲笳远过城。\n不眠看列宿，磊落背人倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送同年王殿丞知鄞县","author":"刘敞","text":"同日大梁客，共登青云梯。\n逢时方跃马，从政暂驱鸡。\n万水会东海，千岩开郯溪。\n远游观益壮，肯为簿书迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨","author":"刘敞","text":"园林自有主，风雨苦无情。\n密叶枝枝绿，飞花片片轻。\n眼看春不住，醉任酒频倾。\n何处莺求友，时闻啭一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汝南张秘校及第后之官","author":"刘敞","text":"从我陈蔡者，怜君不及门。\n青云期自致，鸣鹤果孤鶱。\n仕道半纶重，及亲三釜尊。\n因声谢汝士，为喜月告存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏呈府公","author":"刘敞","text":"残春亦无几，短夜不须眠。\n翠幕深灯烛，清风引管弦。\n诙谐玩兹世，醉倒忘吾年。\n不作方外趣，安知濠上贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"度支苏员外才翁挽歌二首 其一","author":"刘敞","text":"湖海青云士，元龙如古人。\n草书到圣地，词学洎天伦。\n零落风流尽，平生意气亲。\n空存华屋处，寂寞已埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"度支苏员外才翁挽歌二首 其二","author":"刘敞","text":"爱客每倾盖，传家能象贤。\n犹多嫌白眼，自不废青毡。\n吏隐如他日，郎潜遂几年。\n人琴俱已矣，情至一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋道中词","author":"刘敞","text":"交游日零落，之子复云亡。\n常恨神锋隽，端成中道伤。\n文章不用世，词赐仅为郎。\n名士如君辈，风流岂易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴侍郎挽词二首 其一","author":"刘敞","text":"高第贤良策，朝廷擢季功。\n固疑多直谏，不得久居中。\n长啸临边月，孤飞避远鸿。\n盘桓周召际，重见二南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴侍郎挽词二首 其二","author":"刘敞","text":"临汝休车骑，治中愧后门。\n平生一倾盖，谈笑极忘言。\n契阔声尘远，差池岁月奔。\n匣中宝刀赠，知辱故交恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与黄寺丞卜邻","author":"刘敞","text":"卜居先卜邻，相望成相亲。\n无复羁旅恨，况逢性情真。\n食薇亦自足，倾盖不为新。\n杖屦通阡陌，谁能倦角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻徙关中兵备河东","author":"刘敞","text":"胡兵绝当路，戍卒下河源。\n烽火飞狐口，旌旗积雁门。\n和亲固下策，薄伐本中原。\n谁断匈奴臂，非无国士恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立冬后风雨","author":"刘敞","text":"冷雨欲成雪，高风催过云。\n流光随衮衮，吹萚共纷纷。\n此去天地闭，向来金石焚。\n敝貂宁独恨，四序欲平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别西掖手种小梧桐赠三阁老","author":"刘敞","text":"亭亭高未足，玩玩意空深。\n颇似少陵叟，能留一院阴。\n幸今长勿剪，无用晚知音。\n莫作吴侬态，翻从爨下寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西风","author":"刘敞","text":"西风木叶下，远想洞庭秋。\n物色摧年老，天时助客愁。\n李衡千树橘，张翰一渔舟。\n亦自人间乐，功名安足谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盗贼","author":"刘敞","text":"村落枹鼓起，城楼刁斗频。\n畏涂深虎豹，行路入荆榛。\n故老人人怨，烽烟处处新。\n桃源容客棹，属意武陵春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨","author":"刘敞","text":"春光从此半，无复强淹留。\n风雨仍何急，莺花各自愁。\n登临非故土，摇落自清秋。\n物物惊人眼，应须与醉谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黛陀石马蹄砚","author":"刘敞","text":"一片苍山石，遥怜巧匠心。\n能存辟雍法，宛是袅啼金。\n气夺秋云湿，光含墨海深。\n鱼龙随醉笔，变化出幽岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离鄂州至汉阳","author":"刘敞","text":"小郡缘山腹，孤城闇夕枫。\n蛟龙戏雾雨，鼓角乱西东。\n江汉浮南纪，秋冬拟绪风。\n离骚楚人恨，过半夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初冬","author":"刘敞","text":"阳光转南极，渐喜入吾庐。\n物色经霜后，云容欲雪初。\n严风动枯槁，凛气益萧疏。\n何日阳春筦，潜兴冰下鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月九日过正衙","author":"刘敞","text":"去事驹过隙，此身江载萍。\n赤墀容再谒，清涕忽双零。\n海鸟眩韶舞，天潢愁客星。\n平生鸿鹄志，独有去冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中辱圣从龙图侍郎见访闻便赴西州不及款曲偶成五言奉呈","author":"刘敞","text":"衰病淹岁晚，分飞愁远行。\n能回长者辙，因见故人情。\n后会知何地，相看疑此生。\n不为习凿齿，应作左丘明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君章见过","author":"刘敞","text":"衡门入秋草，幽独得栖迟。\n车马来何屡，樵苏不自期。\n书成玄尚白，衣敝素为缁。\n予亦贫非病，君应信所为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邻几君章见过","author":"刘敞","text":"两君共羁旅，三径肯淹留。\n秀色映凉月，清风生早秋。\n樵苏亦不爨，樽酒自相酬。\n欢然夜遂永，河汉西南流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新燕","author":"刘敞","text":"无奈春还老，秪看燕复来。\n凌风舞轻健，尽日语徘徊。\n久客宜相识，重帘为尔开。\n畏人俱混俗，出处免沈猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驯燕","author":"刘敞","text":"非无鹰隼虑，自识主人归。\n立语移窗日，翻飞试羽衣。\n江湖万里阔，天地一身微。\n不作惊鸥别，何须强察机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中出城行汝水上","author":"刘敞","text":"东野宜独往，此中如旧溪。\n好风凉送雨，流水碧循堤。\n树密扶行盖，沙平印马啼。\n城楼隔云雾，归路欲全迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉和邻几汎汝水作","author":"刘敞","text":"少濯沧浪水，成君真隐高。\n虚舟姿上下，樽酒寄游遨。\n静境惬外奖，缓歌忘我劳。\n兴馀可径返，落日丽平皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西浦阻雨","author":"刘敞","text":"黑云连海面，急雨涨淮潮。\n稍稍州渚没，昏昏城郭遥。\n畏涂仗忠信，高举幸扶摇。\n不作图南兴，谁当慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黑云","author":"刘敞","text":"屯云望如墨，万里横空浮。\n白日变玄夜，朱明成素秋。\n疾风动屋瓦，急雨落河流。\n俯仰骇神化，精微难与谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤梅公异二首 其一","author":"刘敞","text":"已矣梅公异，乡庠漫贡生。\n竟无杨得意，终失马相如。\n道德生何负，心怀死不摅。\n新坟帝城外，赠泪独沾裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤梅公异二首 其二","author":"刘敞","text":"刻苦身常病，忧愁寿易侵。\n空令武子死，谁听伯牙琴。\n寥落书盈箧，肃条风满林。\n惟应都下士，能记洛生吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤胡二湘","author":"刘敞","text":"知心不易得，此别定终天。\n自古皆有死，夫君独少年。\n论文真已矣，挥涕默潸然。\n会有清琴在，祗应永绝弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闵雨","author":"刘敞","text":"肤寸无时合，昭回此夜逢。\n春秋还闵雨，郡国共忧农。\n词欲谗风伯，书将诘乱龙。\n关西兵税急，惧失万馀钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄江东弟兄二首 其一","author":"刘敞","text":"分手如昨日，清秋独异乡。\n长年悲落木，短发怯初凉。\n归燕自有适，幽兰谁为芳。\n裁书寄鸿雁，相与访沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄江东弟兄二首 其二","author":"刘敞","text":"却埽与人绝，悲秋惊岁徂。\n山川举俗异，宇宙此身孤。\n吊影临清月，书空向瞑乌。\n怀归属吾党，浮海待乘桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荐福寺竹亭","author":"刘敞","text":"兹亭四时好，秀色映长松。\n静境非千亩，幽人如素封。\n吹声偏洗耳，暑昼亦成冬。\n暂到还忘返，心知叔夜慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观陜西图二首 其一","author":"刘敞","text":"险固非天意，承平怪主忧。\n三年劳将帅，万里问旃裘。\n尚记安西道，空悲定远侯。\n大河知所向，日夜正东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观陜西图二首 其二","author":"刘敞","text":"忆昨传消息，羌来渭水旁。\n信知秦地险，未觉汉兵强。\n青海通西域，长城起朔方。\n分明见地里，怅望隔要荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张六","author":"刘敞","text":"将漕烦明府，东游慰越吟。\n斲冰虽楚水，乘兴即山阴。\n去去陶嘉月，悠悠见子衿。\n因君倚城阙，送目乱愁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨慥","author":"刘敞","text":"著书非白首，待诏已公车。\n试吏何用喜，慰亲聊自如。\n还从近关出，稍与京尘疏。\n岂谓三年久，君方就子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范贯之","author":"刘敞","text":"范叔贫如此，谁当与敝袍。\n哀歌困牛角，异味笑乡豪。\n相得空长铗，徒归欲二毛。\n多惭访夷节，无以慰滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送隐直","author":"刘敞","text":"久客意无赖，送归私自怜。\n悠悠想行路，苒苒背流年。\n雪过兔园少，春归楚泽偏。\n君应解冠冕，笑傲辟人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卫州贾云卿","author":"刘敞","text":"淇奥文雅地，相门英妙才。\n春风万人喜，都城千骑来。\n啸激鸾凤响，歌传松柏哀。\n怀贤复访古，处处为徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送史馆齐学士知荆南唐相映之孙有权文公行修国史制书在","author":"刘敞","text":"间代唐丞相，当时太史公。\n白麻存旧物，青简见遗风。\n鸣玉蓬丘峻，专城楚泽雄。\n由来稽古力，肯效一经穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近无西事消息","author":"刘敞","text":"此心除国雠，安得借前筹。\n未报将军捷，空增壮士忧。\n谁能占太白，试为上高楼。\n自恐匣中剑，精光犯斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"细雨","author":"刘敞","text":"细雨春城暗，空郊草色微。\n峡云朝复暮，沙燕语还飞。\n柳带柔堪结，梅香冷渐稀。\n旅游时畏失，数醉得忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小雨四首 其一","author":"刘敞","text":"微风载云起，好雨与风俱。\n暝色经时合，凉声入夜疏。\n炎蒸暂洒埽，天事有驱除。\n倦客倚危枕，明灯照旧书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小雨四首 其二","author":"刘敞","text":"泱漭轻云湿，飘潇昼雨来。\n稍沾飞絮重，竞逼柳花开。\n江面春阴阔，天涯暮色催。\n郢中词客意，最识楚王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小雨四首 其三","author":"刘敞","text":"漠漠云蒸柱，萧萧雨过城。\n不时变炎景，竟日度秋声。\n洒濯林光净，归飞燕羽轻。\n野夫学为圃，因欲事躬耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小雨四首 其四","author":"刘敞","text":"春城频过雨，一望一增新。\n欲晓云成锦，初晴草似茵。\n和声散喧鸟，芳意属游人。\n向晚车马息，东风吹暗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜从兄自京回","author":"刘敞","text":"曾作东都赋，无人与共论。\n欣逢京辇客，仍是鹡鸰原。\n耳接天韶盛，尘栖素袂昏。\n秋风江海上，归梦入夷门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晴西楼","author":"刘敞","text":"清风卷氛翳，广野露秋毫。\n木落山觉瘦，雨晴天似高。\n开窗置樽酒，看月涌江涛。\n高卧淹湖海，非关气独豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日楼上二首 其一","author":"刘敞","text":"春流抱城郭，暖色媚楼台。\n麦秀闻雉雊，鹳鸣知雨来。\n浮烟著垂柳，晴雪落新梅。\n此地春愁阔，无人共一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日楼上二首 其二","author":"刘敞","text":"跃鱼依暖景，归雁逐轻风。\n隔水麦苗绿，入檐花萼红。\n郊原共郁郁，云日故融融。\n醉眼伤千里，非关江上风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉后","author":"刘敞","text":"举眼醉向晚，甘心醒似狂。\n形骸随酩酊，谈笑助轩昂。\n舞袖翻宜窄，歌声不厌长。\n高城涌明月，风景正虚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"树阴偶坐","author":"刘敞","text":"朝阳送微暖，晴霭入寒空。\n负暄春盎盎，探策乐融融。\n松下坐忘返，树端遥见红。\n喟然感时节，举酒属邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴","author":"刘敞","text":"江上浮云聚，城中暮景兼。\n东风酒味溢，小雨客愁添。\n寒色端侵牖，斜阳不满帘。\n滞留成楚老，卑湿意无嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后小亭","author":"刘敞","text":"疏雨才能润，微风未肯凉。\n低松无限碧，白芷可怜香。\n埽榻从高卧，归禽不乱行。\n悠悠对老圃，几与尔俱忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同伯镇寄赠北都定雅禅师","author":"刘敞","text":"逍遥方外禅，宴坐不知年。\n合抱平生柏，成区社长莲。\n公卿尽随喜，语默两忘筌。\n闻有诗三百，无由一一弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]