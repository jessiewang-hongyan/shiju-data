[{"title":"普照庵小憩","author":"李洪","text":"昔日牧童聚沙戏，若个阿师来卓庵。\n千圣路头都把断，不须辛苦误同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"智仲可化盗图","author":"李洪","text":"有德由来必有邻，得齐潜德感人深。\n不劳渠听甘棠讼，解使偷儿自革心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝拜罗源天庆即洞宫福地也","author":"李洪","text":"徐仙何代此飞升，洞府空留福地名。\n我到朝真效三祝，步虚声杳俗缘轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游武夷二绝 其一","author":"李洪","text":"平湖高柳绿千堆，莫为寻芳取次回。\n欲访同参德云老，别峰霁色夕阳开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登潇洒亭","author":"李洪","text":"文正风流尚典刑，桐江画戟见诗人。\n丹青难写真潇洒，圆峤方壶此逼真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中闻啼鸟","author":"李洪","text":"翠阴丛竹转山腰，忽听一声婆饼焦。\n想见故园春社近，杏花消息雨连朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题华亭尉厅梅馆 其二","author":"李洪","text":"扫径开窗事事新，主人解组似行人。\n浮香弄影无因得，试促花神作小春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题华亭尉厅梅馆 其一","author":"李洪","text":"古梅瘦竹助萧疏，剪薙蒿蓬亦甚都。\n报政未容须五月，却寻疏影向西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题安头陀石室","author":"李洪","text":"头陀灵迹閟岩隈，寻胜何人肯暂来。\n野鸟衔花无觅处，绿苔封径看空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题罗源驿用马驹甫韵 其一","author":"李洪","text":"今年小稔遍山村，白叟黄童笑倚门。\n老瓦为樽赛田祖，石田多稼庆曾孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题崇福院壁","author":"李洪","text":"十邑驱驰阅四旬，尽空囹圄报吾君。\n僧窗渐觉猿吟远，城市嚣尘自此分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朝阳亭","author":"李洪","text":"新亭危冠别峰西，万壑千岩势总低。\n要使登临高著眼，梧桐应有凤凰栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题雁荡图寄二兄","author":"李洪","text":"谁知归雁亭中客，鼓翼来游雁荡山。\n更寄雁图凭雁足，秋风孤雁苦思还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题谪仙回舟卧披锦袍图","author":"李洪","text":"太白狂歌一酒船，锦袍夜醉楚江边。\n此时应向剡中宿，逼耳清猿月满川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题潘岳掷果图","author":"李洪","text":"锦绣文才貌甚都，冶容乱掷果盈车。\n披图宜鉴登徒子，折齿犹胜谢幼舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"窾木诗","author":"李洪","text":"窾木饕风耐岁寒，轮囷入用固知难。\n不才果得全樗散，且伴幽人涧谷盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日与客登凤凰山酌涌金泉泛舟西归","author":"李洪","text":"西山爽气压城闉，携客登高日未晡。\n稚子已谙撑舴艋，老夫羞更插茱萸。\n文章不进空黄妳，生计无多问木奴。\n贫病偏愁秋欲雨，异乡白尽遂良须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日咏怀简仁实","author":"李洪","text":"登临胜践负幽期，山色溪光日益奇。\n那得赐茱来北阙，漫从采菊向东篱。\n升虚楚望犹能赋，振履商讴祇自悲。\n可是閒居爱重九，尉仙落笔有新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日奉怀子济兄","author":"李洪","text":"霜天寥落雁行孤，九日还能行乐无。\n料想山风吹醉帽，也应溪女解携壶。\n赏心乐事今难偶，弟劝兄酬叹莫俱。\n篱下黄花应笑我，独哦短韵看茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日","author":"李洪","text":"开岁逢人日，今朝又复阴。\n昏霾疑是瘴，淫雨欲成霖。\n客里年华改，愁边疾病侵。\n遣怀诗与酒，小醉且长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十八夜月有怀伯封","author":"李洪","text":"秋半青要未降霜，溪边独对露华凉。\n风清月白兴不浅，斗转参横夜未央。\n每望庾尘频障扇，莫逢伊笛据胡床。\n扬晖千里谁同赏，心折刀头快理航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月十九日瑞雪应时百寮入贺仆以病告翌日从驾朝德寿宫马上口占","author":"李洪","text":"拂晓开阊阖，来朝万玉妃。\n遥知花六出，争瑞日重晖。\n入贺鹓鸿缀，迎銮锦绣围。\n巩梅春最早，香透赭黄衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十七夜玩月","author":"李洪","text":"宿昔妖蟆磔，仍圆顾兔灵。\n桂华滋白露，轮玉碾青冥。\n倦翼翻乌鹊，愁肠念鹡鸰。\n独谣成短韵，酸楚不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六夜待月海上","author":"李洪","text":"月到中秋已壮观，更看飞出海边滩。\n光连贝阙鲸鲵骇，冷射蓬壶屃赑寒。\n万顷银涛俱皎洁，一轮金魄尚团栾。\n当年太白曾观此，宁肯呼为白玉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六夜待月溪滨风露浩然宵中不寐","author":"李洪","text":"昨夜中秋月，高唐妒素娥。\n凭谁脩玉户，未觉减金波。\n练净前溪水，银侵左界河。\n浩然风露爽，通夕祗长哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万寿观重萼梅","author":"李洪","text":"天街倦踏软红尘，喜见宫梅漏泄春。\n千叶剪琼多态度，九英照日倍精神。\n香清暗馥维摩榻，韵胜全疑姑射人。\n好是孤山临水看，广平能与赋清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子都兄寄子济兄诗借韵奉寄","author":"李洪","text":"缄题千里候寒暄，怅恨郊荆独我班。\n目断樯乌五两远，书凭河鲤一双还。\n金陵风月供吟啸，钟阜烟萝想纵攀。\n尽把锦囊新咏句，小胥抄寄勿令悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子都录示近作成白体一首奉寄","author":"李洪","text":"别日江梅半透春，梨花开后独愁人。\n欲将芳草萋萋恨，寄向沧江六六鳞。\n两处吟当看雪夜，数篇抄值落花晨。\n未输谢客池塘梦，千里赓酬句要新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子清弟冒暑见过","author":"李洪","text":"瓢饮今希陋巷颜，忽闻佳客款柴关。\n风生荷芰青蘋末，诗寄烟波叠翠间。\n伏枥常怀千里志，在原相望几人閒。\n新篘红友明朝熟，肯放扁舟取次还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞霞洞谢公岩呈元量","author":"李洪","text":"谢公遗躅閟苍苔，乘兴飞霞得得来。\n洞锁暮云松偃蹇，江涵白月影徘徊。\n吾曹趣了痴儿计，萝径难留俗驾回。\n安得麻姑能送酒，他时藉草共传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中春二十七日车驾躬请太上皇帝出郊获观盛事次大监叔韵","author":"李洪","text":"禁籞芳菲岁又新，两宫行乐及良辰。\n双瞻黄伞天回笑，并御花骢雨洒尘。\n汉殿捧卮称万寿，葛天张乐和千人。\n欢声试采康衢咏，帝力熙熙物自春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕书怀","author":"李洪","text":"好在东君管物华，倦游归思渺天涯。\n春冰夜市心空壮，听镜探官事更赊。\n尚怯馀寒破桃萼，坐看细雨落檐花。\n家僮应照田蚕?，频晒渔蓑理钓车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"李洪","text":"元日欢情客里稀，追陪人事强开眉。\n不知爆竹催年去，但怪屠苏到我迟。\n梅蕊欲撩东阁兴，宦情终愧北山移。\n未甘直道犹萧索，詹尹何辞为拂龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元宵雨十六日晴二首 其二","author":"李洪","text":"衢路人骈叠，春来乐未曾。\n初圆新岁月，竞赏上元灯。\n秉烛游还懒，敲门唤不应。\n沃愁须底物，况有酒如渑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元宵雨十六日晴二首 其一","author":"李洪","text":"每恨元宵雨，收灯遽喜晴。\n喧阗虽倦逐，勃窣漫徒行。\n入夜寒无赖，随人月有情。\n旅怀忘晤赏，拥鼻有诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六龙驻跸温州先公职列西掖扈从至此手泽具载一时之事三十三年嗣子洪守官于此因成感事诗","author":"李洪","text":"从龙浴日仰光辉，万里鲸涛扈六飞。\n晋国曾闻四蛇宇，周家亲睹一戎衣。\n东巡王气随天仗，西狩麟经在紫微。\n江海孤臣孝忠志，大恩未报重歔欷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午日寓圆果院苦河鱼以诗纪节","author":"李洪","text":"老来百事与心违，节物殊非少壮时。\n细葛宫中曾被赐，杨梅粽里未容窥。\n浪求医国三年艾，空吊沉湘五色丝。\n萧寺更同摩诘病，玉堂帖子要新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"比至武原省侍叔父二兄因成二诗 其一","author":"李洪","text":"并海风烟古，重来岁月侵。\n竹林追胜具，棠棣接清阴。\n酒圣连宵醉，诗魔镇日吟。\n凤雏欣竞爽，家学岂籯金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"比至武原省侍叔父二兄因成二诗 其二","author":"李洪","text":"越角倦游客，贫婆行脚僧。\n畏寒便白氎，寻壑倚乌藤。\n是处记游钓，老来无友朋。\n求田兼问舍，岂复愧陈登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙寅元日","author":"李洪","text":"年年元日雨，常是一春愁。\n客子诗多感，梅花信已休。\n春风吹柳眼，海雾暗沙头。\n聊举椒觞酒，萱苏岂释忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至前","author":"李洪","text":"隐居慵出人嫌癖，乐静安閒祇自怜。\n窗眼白驹催短晷，案头黄卷遣长年。\n南枝春信应先透，北陆寒凝势更坚。\n地下一阳何日复，千林枯木已欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵简日华","author":"李洪","text":"迟迟欲去恋双溪，独乐箪瓢不糁藜。\n岂称昔贤为半刺，只堪老宿话全提。\n家贫未办千头橘，世习犹堪两颗梨。\n速丐雄篇重行橐，三山佳境易为题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春前一日再雪因用韵","author":"李洪","text":"重雪催诗夜映窗，杉枯竹折恣撑摐。\n交飞梅径妆才半，舞对鸾台影自双。\n面壁谁参少陵室，羊裘试问富春江。\n丰穰可卜卯年瑞，展拓边城筑受降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲躬示侍郎丈筒字韵咏雪次韵","author":"李洪","text":"溪汀渺渺跃凫翁，织浪雕云讶许同。\n散漫六霙疑剪水，连娟万舞趁回风。\n瞻山遐想昆邱胜，宴坐方观色界空。\n绣斧谢庭联内集，刑清宁用缿为筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会稽偶作二首 其二","author":"李洪","text":"西陵渡口望吴山，独策羸骖兴惘然。\n竹树幽深皆可老，江山信美祇随缘。\n知章得请千秋观，太白狂歌一酒船。\n更拟迟留探禹穴，梅梁风雨暗云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会稽偶作二首 其一","author":"李洪","text":"去年行遍浙东山，越绝重来岂偶然。\n秦望云深萦客恨，镜湖月白结诗缘。\n鹧鸪处处啼篁竹，舴艋家家泛钓船。\n行役自应多感慨，故山如许好风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"共乐台","author":"李洪","text":"鳞差万瓦拱层台，暇日登临亦乐哉。\n桃李成蹊春未到，江山如画国多才。\n倦游难效登楼赋，胜槩常遭俗驾回。\n好是清宵携客醉，云间两两近三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵","author":"李洪","text":"风罥游丝百尺长，蜂房酿蜜露微黄。\n翠榕一半委陈叶，紫柰十分留暗香。\n卢橘带酸归老圃，侧生未熟去闽乡。\n浮云出岫初无恋，静看卷舒何太忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋简李尉","author":"李洪","text":"满院秋英独傲霜，恨无醇酒变春江。\n门前催取麻姑榼，席上惊倾道士缸。\n学蹈丘轲难合俗，诗如曹郐不成邦。\n埋藏自比丰城剑，射斗难占紫气双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘子履见怀小桥竹篱屡入梦寐因寄","author":"李洪","text":"寂寞荒郊野水滨，竹篱茅舍旧比邻。\n谁知绣斧文章伯，尚念渔蓑潦倒人。\n采菊佩萸思共赏，落霞孤鹜兴尤新。\n关中小试酂侯绩，却掌丝纶侍帝宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁除","author":"李洪","text":"客里光阴又一年，人情真复似怜蚿。\n家贫尚有春名酒，才拙安能雪命篇。\n弱柳经霜半凋落，修篁沐雨更便娟。\n亲交岁晚无书劄，常闭柴扉稳昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱叔赐来自都城云梅已放因思每岁饮赏之乐","author":"李洪","text":"曾酌孤山园里梅，至今魂梦忆花开。\n纤腰冷逼江烟瘦，素脸全疑晓雪催。\n南国相逢心恅愺，西湖遥想月徘徊。\n惜无妙语酬佳丽，赖有诗仙凤阙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次王仲信食粥","author":"李洪","text":"太白狂歌力士铛，未如食粥鲁公清。\n从教过午饥肠转，政坐哦诗青眼横。\n奇怪争观出月胁，诙谐犹足助言鲭。\n卧听古寺华鲸吼，饭颗谁怜太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子永雨中排闷","author":"李洪","text":"社燕巳成乳，吴蚕一再眠。\n哦诗聊度日，无客倦谈天。\n夜雨短檠梦，春愁锦瑟弦。\n萧然似僧榻，香雾散沉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子咏弟见寄","author":"李洪","text":"春残逆旅赋归欤，桂玉囊空欲趁虚。\n懒效梁鸿五噫曲，未逢黄石一编书。\n刺漫屡簉门行马，志拙宁堪鼎拄车。\n数?荒田临霅水，好披龙具去携锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子都兄见寄 其二","author":"李洪","text":"五色徒誇补衮工，百年痴作蠹书虫。\n尘缨黧貌惭衰相，窾木号风逼岁穷。\n酌酒漫为蛇画足，覆蕉今悟鹿成空。\n江村且索梅花笑，独有幽人影伴红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子都兄见寄 其一","author":"李洪","text":"栖栖异县叹飘蓬，暂释牢愁颂酒功。\n失马忽悲居塞上，卧龙有待起隆中。\n匪躬直道宁忧辱，巧舌如簧固易穷。\n况有知音居鼎铉，岂随笠泽著书丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子都兄寄伯封论书","author":"李洪","text":"绝艺当如郢匠斤，家鸡野鹜漫分群。\n山阴妙法羲传献，江左名声薄继欣。\n竞作墨猪无健骨，谁知笔髓贵丰筋。\n斯言举似秦溪后，三折君须子细分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子都兄鲍庵芍药 其一","author":"李洪","text":"春归莺老禁无音，天为红芳著意深。\n姝色自应倾一国，多情向惜费千金。\n如迎如舞缘风拆，不淡不深愁雨侵。\n宜与花王为辅佐，欲传彩笔继高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子都兄鲍庵芍药 其二","author":"李洪","text":"国香沦落在天涯，常畏人知使护遮。\n雅韵曾翻西掖砌，佳名宜亚子亭花。\n野僧好事勤栽植，北客思乡倍叹嗟。\n安得花前还醉倒，可怜不属五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子都寄示和大监叔西湖早春","author":"李洪","text":"白莲寻净社，紫气觇幽关。\n吏隐无公事，鸥盟俯碧湾。\n泉声杂鸟哢，云卧爱僧閒。\n更欲支筇去，过溪多好山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵马驹父大阅","author":"李洪","text":"谭笑诗成马槊横，偏师何敢犯长城。\n纵观儒帅临戎幕，想像天山破敌营。\n麾帜精明严武备，山川弹压飏威声。\n老来壮志浑消尽，射虎南山愧北平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵元量春游","author":"李洪","text":"恰恰莺簧百啭齐，提壶仍劝醉芳蹊。\n曲尘弄日腰肢弱，翠黛凝颦眉妩低。\n泉石似寻天竺寺，渔舟引入武陵溪。\n少年簇马观游女，勒住金衔不放嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王龟龄贡院","author":"李洪","text":"浩渺春波暖白蘋，溪头广厦旅楹新。\n佩衿无复歌游阙，糟粕空惭老斲轮。\n门外缊袍人立鹄，榜间淡墨笔如神。\n使君道德魁天下，膏馥分沾尽澡身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲信雨中见简","author":"李洪","text":"蛙黾几争席，霪霖苦未乾。\n烟花三月暮，风柳万丝寒。\n缸面醅初拨，床头易懒看。\n客愁无处著，何地觅心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲信留别","author":"李洪","text":"倦游再闰入都门，喜见隆兴诏令新。\n功业讵堪铭日观，龙钟空叹倚天津。\n题诗竹阁逢寒食，修禊兰亭及暮春。\n我欲扁舟成泛宅，五湖烟月伴渔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲信雪中见简","author":"李洪","text":"夜窗初映月如霜，凌晓瑶霙势渺茫。\n清室乍欣文解祟，浅斟应惬醉为乡。\n幽兰俪曲三豪集，黄竹兴谣八骏骧。\n闻道子猷思泛剡，两溪绝境较优长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]