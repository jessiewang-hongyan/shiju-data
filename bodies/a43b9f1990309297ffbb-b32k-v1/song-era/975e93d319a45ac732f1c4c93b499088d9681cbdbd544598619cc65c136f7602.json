[{"title":"依韵和双头芍药十六首 其十三","author":"陆佃","text":"神仙流品信难群，绝似人间两丽人。\n暂得借观犹占久，便教偷戴也分均。\n祇邀竹叶相为伴，更对菱花自写真。\n开向夏天缘底事，算来多是不宜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和双头芍药十六首 其十四","author":"陆佃","text":"桃茢无堪谩祓除，芭蕉何事倒抽书。\n凤凰骑罢犹轻举，乌鹊桥成得燕居。\n抵死劝持雕玉盏，象生描在镂金梳。\n当时若使阏氏见，未怕平城刻得如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和双头芍药十六首 其十五","author":"陆佃","text":"晚菘早韭谩连群，过眼终无爱惜人。\n照日舞鸾情款曲，趁风飞燕势停均。\n名归本草千方秘，职在司花一命真。\n回首凤凰城阙下，倩谁移与后园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和双头芍药十六首 其十六","author":"陆佃","text":"曾伴长杨草诏除，信知长合在中书。\n暂违紫袖双瞻立，聊伴红裙一饷居。\n小子正狂心已醉，老奴犹爱发方梳。\n故应此战今须解，兵法曾教避不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和门下吕相公从驾视学","author":"陆佃","text":"纁帛升龙日月章，平明鸾辂幸胶庠。\n侍臣独恨身千里，邸报空看字数行。\n故事一遵皇考庙，馀波仍及武成王。\n谁知玉尺横经处，犹是当时旧讲堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和赵令畤三首 其一","author":"陆佃","text":"百步厅边放两衙，夜深灯火见人家。\n提壶劝我教沽酒，鸲鹆逢君要点茶。\n舞得六幺除是柳，啼消红粉奈何花。\n使君被尔牵诗思，可是无心忆浣纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和赵令畤三首 其二","author":"陆佃","text":"鸟排行阵树排衙，且喜西湖属当家。\n扬子已无骑鹤事，会稽惟有卧龙茶。\n未妨春帝常为帝，须信名花始是花。\n更住一年方五十，不应情味薄于纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和赵令畤三首 其三","author":"陆佃","text":"方朔无端溺殿衙，得州仍是地仙家。\n海红谩与陪尊酒，淮白犹堪当分茶。\n夜静青天十分月，春深平地尺馀花。\n谁将园里新蜂蝶，织就佳人护项纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和赵令畤","author":"陆佃","text":"争标才气两相高，不独诗豪酒亦豪。\n战得蚁酣成后殿，探知龙睡遇先逃。\n曾于宝月求斤斧，欲以春风代剪刀。\n他日若称诗宰相，定应先后秉钧陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和田虎通判兼呈品防签判四首 其一","author":"陆佃","text":"楚尾秦头俗久移，丰穰仍值太平时。\n渚花尽日临书幌，潭菊如今在酒卮。\n十里麝香行驿近，三竿红日坐厅迟。\n爱君古锦囊中句，不负文忠国士知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和田虎通判兼呈品防签判四首 其二","author":"陆佃","text":"冉冉年光逐闰移，厅閒宾客坐多时。\n主恩未报空持橐，军政无妨数举卮。\n潘鬓雪霜何太早，傅岩霖雨不应迟。\n颔珠竟被君探得，正值骊龙睡不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和田虎通判兼呈品防签判四首 其三","author":"陆佃","text":"剧谈终日少文移，幕府新开盛一时。\n羊酪未妨留灌顶，蟹螯何苦负操卮。\n诗成醉里遗忘易，思发花前属和迟。\n更许此生刚节在，祇应惟有岁寒知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和田虎通判兼呈品防签判四首 其四","author":"陆佃","text":"春花秋叶两推移，未有涓尘补圣时。\n新识豹胎休负鼎，旧成蛇足谩持卮。\n山如水墨屏间见，日向棋盘子上迟。\n便使北归应念此，白鸥黄鸟尽相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用田倅韵答孙勉教授二首 其一","author":"陆佃","text":"浅红深紫旋教移，直待开无空阙时。\n花十八中看蹋鞠，玉东西外听扬卮。\n笙歌船舫天围合，灯火楼台月上迟。\n顾我若非乡曲远，定应长占此州知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用田倅韵答孙勉教授二首 其二","author":"陆佃","text":"造化从他密密移，聪明非复似前时。\n暂披金甲为儒将，曾燕珠宫对玉卮。\n一日看回花恨疾，三年生就叶嫌迟。\n慇勤为访春消息，赖有羹梅探得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵答谢推官","author":"陆佃","text":"小立桑阴尚未移，便如相识已多时。\n锯沙我就玉界尺，点砾君成金屈卮。\n灵运自应为佛早，退之今恨学仙迟。\n当年江左堂前燕，却又飞来未可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和赵令畤","author":"陆佃","text":"无事何妨数命宾，一湖清境是西邻。\n栽花要与春为主，对酒瞋将目借人。\n诗就彩笺斜卷玉，舞馀花碗倒垂银。\n由来景物常无价，谩道钱多会有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱升朝奉","author":"陆佃","text":"湖上寻常日一临，年华无用苦相侵。\n梦随蝴蝶悠悠觉，日待蟾蜍款款沈。\n醉里笙歌传盏疾，壶中天地著花深。\n回瞻象阙恩难报，愿尽平生一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张朝奉四首 其一","author":"陆佃","text":"赤松居处近州衙，况复诗情是作家。\n收得夕阳归老境，破除春睡有新茶。\n年华一任随流水，世事多应似落花。\n却笑宦游閒不得，尘埃昏尽幞头纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张朝奉四首 其二","author":"陆佃","text":"谁将两制比三衙，千骑犹如布素家。\n何日龙巾容吐酒，而今纱帽自煎茶。\n十年胶柱空调瑟，三月羹梅始见花。\n醉里不知身在此，梦魂犹傍御袍纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张朝奉四首 其三","author":"陆佃","text":"押了文书坐了衙，寻常行过祇如家。\n苦无公事妨携酒，赖有诗情得试茶。\n便到五更犹有月，算来一日可无花。\n垂纶更作轻鸥伴，坐看寒汀学绉纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张朝奉四首 其四","author":"陆佃","text":"门锁寻常付守衙，穿湖曾不碍民家。\n惯看妙舞资豪饮，生怕清歌送好茶。\n山盍飞来围著水，春休归去带将花。\n从教魏紫姚黄下，也合翚衣里素纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和孙勉教授菊花","author":"陆佃","text":"芳丛宜密不宜疏，何事琼花祇一株。\n苦劝白衣成酩酊，尽饶红粉插茱萸。\n定应青帝稀曾见，端的黄金似得无。\n便拟栽培伴桃李，尽移春色入洪炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和李元中兼寄伯时二首 其一","author":"陆佃","text":"龙眠三李晦声尘，长望淮壖与海滨。\n自古市朝成底事，即今猿鹤伴他人。\n细思南陌东阡月，大胜千门万户春。\n可惜欲归归未得，不知家酿为谁醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和李元中兼寄伯时二首 其二","author":"陆佃","text":"五丈河边避俗尘，闭门情味似漳滨。\n抛离鹊渚今三岁，成就华严祇两人。\n贫里有时求得玉，老来无可奈何春。\n平生共学王丞相，更觉荀扬未尽醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和毅夫即事五首 其一","author":"陆佃","text":"昨日红裳伴燕游，渚花争好草争柔。\n依稀黄鸟浑相识，期刻青山卒未休。\n风似去年搴翠幕，雨分明日与芳洲。\n即今太守无佳句，空愧当时宋采侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和毅夫即事五首 其二","author":"陆佃","text":"却笑元宵是夜游，金针穿石綵丝柔。\n萱堂帐幄閒仍出，幕府文书了即休。\n顾我宝珠连合浦，爱君仙果满瀛洲。\n谁知并辔聊同俗，拜后如今有鲁侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和毅夫即事五首 其三","author":"陆佃","text":"平明一雨阻重游，风绉前溪绿谩柔。\n况已上元连夜出，不如寒食看春休。\n弄珠滩涨平侵岸，摸石江深抹尽洲。\n自是苦阴无意思，莫将潮信枉阳侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和毅夫即事五首 其四","author":"陆佃","text":"十年京洛从宸游，得郡终难绕指柔。\n庐舍昔希三肯顾，亭台今负四宜休。\n何人正在芙蓉岛，有客空吟杜若洲。\n为问西街孔君子，设监那得似诸侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和毅夫即事五首 其五","author":"陆佃","text":"谢安携妓是清游，玉瑩金尊十指柔。\n桃自三千年结子，鳌于六万岁更休。\n猿啼谩想黄牛峡，凤去空传白鹭洲。\n我若他年封万户，祇来穰下作穰侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和毅夫百花洲新桥","author":"陆佃","text":"省中何必就尚书，且向新桥一振裾。\n娇女顷嫌撑小艇，偏亲今喜度安舆。\n假饶跨鲤终难学，除却垂虹尽不如。\n从此使衙乌亦好，岂无遗爱在胥馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答毅夫遗橘株之什三首 其一","author":"陆佃","text":"平生希慕范莱芜，耻把耕耘一问奴。\n碑较智愚能几里，树争贫富没多株。\n报之琼玖如投李，遗以珩璜恍弋凫。\n传语小城休负固，元侯今后不言无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答毅夫遗橘株之什三首 其二","author":"陆佃","text":"亭榭新修道不芜，丰年焉用橘千奴。\n请教青帝留三月，拟就嫦娥乞一株。\n种玉水田飞白鹭，泳珠风槛对沈凫。\n便难图画犹争看，定是京西一路无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答毅夫遗橘株之什三首 其三","author":"陆佃","text":"曾因书史剪繁芜，更与花王置木奴。\n蓝旧出师青万顷，竹新齐母绿千株。\n睡馀枕簟屏开凤，饮尽尊罍勺用凫。\n一种梧桐亦遭遇，剪封终愧内虚无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毅夫倒用无字韵春诗四首 其一","author":"陆佃","text":"皇家宝历万年馀，礼貌群臣自古无。\n龙马已陪阿阁凤，鼎湖犹想裕陵凫。\n刘郎莫恨桃千树，匠伯应怜栎一株。\n犹喜后来门户在，小儿能赋昆崙奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毅夫倒用无字韵春诗四首 其二","author":"陆佃","text":"一别勾芒仅岁馀，不知今度老颜无。\n管人忧喜何如鹊，与世浮沈可奈凫。\n拟看笏头花四朵，更栽槐面树三株。\n若教上番成新竹，须戒人家婢与奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毅夫倒用无字韵春诗四首 其三","author":"陆佃","text":"附庸新又进于馀，欲共南邻斗有无。\n横列溪山埋积雪，卧开桃李映新凫。\n拟舂玉臼丹千杵，更种金锤麦一株。\n从此有人殽亦有，不烦公帑与官奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毅夫倒用无字韵春诗四首 其四","author":"陆佃","text":"公钱虽少俸钱馀，明日如今作会无。\n况有鳖裙胜脍鲤，岂无鹅掌代蒸凫。\n庆归子舍芝三秀，官入卿曹棘九株。\n闻说丽人推不去，爱才何止十年奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毅夫病目三首 其一","author":"陆佃","text":"使君诗思谩雕肝，安得头风与阿瞒。\n然艾为谁甘受痛，看花缘此负追欢。\n通天犀带应怜瘦，云母屏风尚畏寒。\n何日长安同一醉，拟教歌舞衒华丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毅夫病目三首 其二","author":"陆佃","text":"诗战空怀壮士肝，未容旃旆累祁瞒。\n并游曾许花含笑，孤愤今惭树合欢。\n五朵谩将春色寄，二篇还伴夜光寒。\n凭君休造斑猫毒，且向三田养就丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毅夫病目三首 其三","author":"陆佃","text":"报君平日愿输肝，常笑飞蝗累李瞒。\n一雨固宜知上德，是花犹可尽君欢。\n孤根自识恩波煖，老健谁争气候寒。\n从此忧民免髭白，却疑甘泽是金丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和毅夫儿病","author":"陆佃","text":"二毛萧索未应羞，谩说初怀弄瓦忧。\n珠母光芒今吐月，豹驹才气已窥牛。\n自知阴德仙能学，谁有灵符鬼可囚。\n早晚病除闻药喜，与君诗酒共清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"易守建业毅夫有诗赠别次韵五首 其一","author":"陆佃","text":"太守无堪久借留，君王恩礼与升州。\n亲舆自可时来往，渔唱犹能数献酬。\n风色得经扬子渡，月明知在海棠洲。\n北山楷木今成列，独傍师门想见丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"易守建业毅夫有诗赠别次韵五首 其二","author":"陆佃","text":"凌晨寒日弄辉辉，我旆东来子旆西。\n对此销魂两无语，恨初相遇一何稽。\n梅花可惜空随驿，鸥鸟多应不下溪。\n犹有往来鱼与雁，好将诗什当书题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"易守建业毅夫有诗赠别次韵五首 其三","author":"陆佃","text":"紫案焚香拜敕黄，无因久借盖公堂。\n不堪落日离魂断，赖有薰风引梦长。\n吹律渐知寒谷暖，卖浆曾值暑天凉。\n他年果若成功去，乞取南阳作邓王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"易守建业毅夫有诗赠别次韵五首 其四","author":"陆佃","text":"春渚秋潭不可寻，回头城郭碍高林。\n但知自白三分鬓，更与谁论一寸心。\n红粉泪痕消片玉，故人情分重千金。\n临岐不忍醒时别，一任玻瓈酒盏深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"易守建业毅夫有诗赠别次韵五首 其五","author":"陆佃","text":"谁信金陵刺史肠，曾怀珠玉夜光芒。\n一尘侍从才虽短，双奉君亲日更长。\n得郡免营三釜粟，过都容捧万年觞。\n遥知南北相望处，风在檀栾月在棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其一","author":"陆佃","text":"借山楼小已新奇，更近东边得凤池。\n一日未尝无客过，百年今始有人知。\n舞馀裙带双垂绿，诗就珊瑚半露枝。\n为问鹓雏归得未，虚来阿阁已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其二","author":"陆佃","text":"使君年老强搜奇，来傍吟窗拥被池。\n明月清风初未觉，白鸥黄鸟旧相知。\n水通河汉无多地，凤在梧桐第几枝。\n好是与民同此乐，丰穰仍值太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其三","author":"陆佃","text":"池就台成竟大奇，画堂新燕亦差池。\n人非杨柳看来瘦，春有梅花探得知。\n华发渐惊强半白，素娥曾与第三枝。\n海邦莫道无宾客，冠盖如今盛一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其四","author":"陆佃","text":"东君著力信神奇，桃李中间水满池。\n定是祇教淮甸有，若为长得泰州知。\n行藏正倚楼千尺，勋业初横草一枝。\n投老尚堪驱使在，问春何似少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其五","author":"陆佃","text":"公事稀疏已自奇，那堪园更胜舒池。\n诱将醉尹来无数，禁得诗人瘦不知。\n蝶梦几随蝴蝶远，凤雏仍在凤凰枝。\n赏心乐事知多少，雪月风花是四时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其六","author":"陆佃","text":"平生仕宦不求奇，谁怕他人夺我池。\n地胜更无尘可到，天阴惟有病先知。\n从教宝塔来当面，消得云楼为折枝。\n看取鶠堂何似好，夜深歌管月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其七","author":"陆佃","text":"老懒由来怕立奇，偶然寻得旧家池。\n一州祇此为无及，累政因何尽不知。\n歌吹彻云城百尺，楼台侵夜火千枝。\n凭谁为报莺花道，一日须来十二时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其八","author":"陆佃","text":"彷佛华胥一梦奇，斩新楼阁旧城池。\n夜深犹有人家看，昼寝惟应燕子知。\n疏雨有时三两点，好花何啻万馀枝。\n诸公若肯相追逐，趁取春风烂漫时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫凤凰池九首 其九","author":"陆佃","text":"恰似蒲萄水亦奇，游人多似后园池。\n壶中日在归前落，醉里诗成醒后知。\n芳径绰开杨柳树，小墙阑出杏花枝。\n老拳毒手浑相若，望立降旗是几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝散","author":"陆佃","text":"使君竟亦不能奇，赖有诗翁壮观池。\n二百年来无此作，两三人外有谁知。\n鱼应变化垂天翼，鹊不经营堕地枝。\n况复凤毛如得凤，古来遭遇或同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和张椿","author":"陆佃","text":"一年三十有馀旬，最爱韶华是令辰。\n坐久落花深一尺，睡馀浅粉看重匀。\n况当诸县无公事，且与云楼作主人。\n今日与君俱白发，看花情味尚青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查朝散赠新恩先辈","author":"陆佃","text":"收得宫花上带春，绿袍仍共草争新。\n发扬杜老诗无敌，盖覆吴侯政不神。\n平地彩云看接武，一天明月负垂纶。\n怪来濒海多儒士，龙阁从来是里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和徐大夫","author":"陆佃","text":"朱丝同直水同清，红袖何妨当使令。\n可惜去年他处看，不知今夜几州明。\n年华老去知无补，眉妩初閒似有情。\n且向云楼拌共醉，尽他灯火暮禽惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋微阴","author":"陆佃","text":"年年月色是中秋，莫为今宵海上楼。\n要得长圆真妄意，放教微暗亦良筹。\n步金砖上颜仍好，颓玉山前德尽柔。\n生怪嫦娥苦羞涩，都缘瞋不强公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋用别韵答张椿兼呈徐瓘","author":"陆佃","text":"偶被微云掩素娥，昏昏如似隔轻罗。\n祇应梦里朦胧惯，可是秋来淡薄多。\n舍此岂无珠可玩，学渠犹有扇能歌。\n会须明夜分明在，况有诗人为琢磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]