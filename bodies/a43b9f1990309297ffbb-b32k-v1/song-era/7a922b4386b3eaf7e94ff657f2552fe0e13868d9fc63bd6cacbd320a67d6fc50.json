[{"title":"初夏","author":"侯延庆","text":"猥山狭路蔚桑麻，篱落春归尚有花。\n雨涨小溪蒲剑短，风回横陇麦旗斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"倪允文","text":"巢父滩头甫着鞭，名山入眼驿程边。\n迂回仅费商于地，领袖宁烦一介先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其一","author":"倪允文","text":"九关深处锁仙家，缥缈清都定不遐。\n草木曾留高庙跸，香灯常带紫宸麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其三","author":"倪允文","text":"笋舆轻捷绕坡陀，石窦抽关喷决河。\n幸许羊肠成坦履，不应狭路响风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其四","author":"倪允文","text":"洞里群仙总未逢，天风吹快去匆匆。\n儒仙元自留官府，傥借刀圭得圣功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王鲁斋大安古道","author":"倪公武","text":"著脚争些子，公私只两歧。\n正途元自稳，捷径不胜巇。\n见透行须透，心移境亦移。\n前人须指点，进步莫迟疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"倪文一","text":"编篱已种渊明菊，凿沼还栽茂叔莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫怨","author":"倪龙辅","text":"翠袖无香镜有尘，一枝花瘦不藏春。\n十年不识君王面，始信婵娟解误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登楼有感","author":"倪龙辅","text":"好趁西风理钓舟，半生书剑两悠悠。\n凭高有恨无人识，空负关河万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔷薇","author":"倪龙辅","text":"洛本空藏画牡丹，海棠出蜀近应难。\n莫嫌村巷蔷薇野，春晚犹堪取次看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六经","author":"倪龙辅","text":"四十馀万字，字字寓经纶。\n其用通天下，何尝语世人。\n壁藏终有汉，灰冷亦无秦。\n永永扶三极，难穷此道神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱谦斋新居","author":"倪龙辅","text":"携琴载鹤又如京，隐处如村却近城。\n吴越山从楼外起，江湖水到宅前清。\n草将春色归新句，梅著寒香暖旧盟。\n最喜出门天咫尺，摩挲老眼看升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬答","author":"倪龙辅","text":"人生乐处是家山，归即须归说便难。\n吾道何尝拘出处，丈夫例不怕饥寒。\n一天明月随诗笠，万古清风在钓竿。\n浮利浮名尽如许，笑他开眼梦邯郸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"藏一山房","author":"倪龙辅","text":"屋小书千古，身闲心五湖。\n从人笑迂阔，于道转清孤。\n涯涘观诗砚，阳春借酒壶。\n江边折黄菊，共感老头颅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剡溪","author":"倪光兰","text":"东山山下海潮通，一片江流出镜中。\n度岭拾薪歌稚子，和烟牧犊走村翁。\n千年桥锁高人迹，百丈岩垂烈女风。\n此去天台知几许，桃花深处失西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜行船","author":"倪君奭","text":"年少疏狂今已老。\n筵席散、杂剧打了。\n生向空来，死从空去，有何喜、有何烦恼。\n说与无常二鬼道。\n福亦不作，祸亦不造。\n地狱阎王，天堂玉帝，看你去、那里押到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古扬州","author":"倪应渊","text":"雉堞平来堑拥沙，绿芜阙处见人家。\n山河旧影藏秋月，关塞新声起暮笳。\n玉蕊已为亭下草，蒺藜不是眼中花。\n当年凤舸经行地，枯柳无枝寄宿鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼","author":"倪应渊","text":"狠石苍顽岁月遥，几人触境想英标。\n欲知三国兴亡事，但看一江来去潮。\n南土尘飞通岭海，中流砥立独金焦。\n云山绕槛期深隐，不受刘安作赋招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金山寺","author":"倪应渊","text":"金锡飞来日，灵鳌负地形。\n涛翻四面白，寺裹一山青。\n海月窥檐箔，天风语塔铃。\n倦怀思煮茗，谁与汲中?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷塘","author":"倪应渊","text":"天留遗迹鉴兴亡，出郭伤心见此塘。\n废苑无萤秋寂寂，坏陵有树月苍苍。\n绿悽霜重摧荷盖，紫怯波寒褪芰裳。\n唤醒锦帆当日梦，一声水调隔云长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤皇台","author":"倪垕","text":"凤皇凤皇几千载，凤皇已去台空在。\n应多燕雀语画梁，瞥见蛟龙起沧海。\n二十年前曾来游，野田白鹭涵清秋。\n今夕何夕领宾客，饭盂有饭思貔貅。\n六朝故国金陵道，柳外闲愁仗谁扫。\n掀髯一笑问西风，未必江山知我老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平港滩","author":"倪思","text":"长几赣石三百里，险过瞿塘十八滩。\n幸有溪旁平稳路，何须欲速冒惊湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南剑道中桂","author":"倪思","text":"道傍岩桂老成行，翠叶经冬不著霜。\n想见秋清风月里，缀金粟颗剩输香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游黄檗山三首 其三","author":"倪思","text":"中洲绝品旧闻名，瀹以寒泉雪色轻。\n怪得道人常不睡，一瓯唤醒梦魂清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游黄檗山三首 其二","author":"倪思","text":"云鹫峰头一万杉，覆盂山下木参天。\n当年曾识祖师面，溜雨鸣风三百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游黄檗山三首 其一","author":"倪思","text":"历险扪高无路寻，乱山穷处是禅林。\n谁知学道须辞世，真要入山如许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"慈感寺东轩","author":"倪思","text":"水花风叶暮萧然，霭霭云山带暝烟。\n伫立东轩未能去，更看明月涌晴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初入洞霄","author":"倪思","text":"踏雪来游大涤宫，缘崖一一访仙踪。\n回环九锁银为阙，峭拔千山玉作峰。\n冰柱高垂泉带石，珠幢整立桧兼松。\n清寒入骨非人境，知在云霄第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽词二首 其二","author":"倪思","text":"黼翣方徐转，龙輴望已遥。\n胥涛平似掌，禹穴俨如朝。\n丧考群心痛，号旻圣孝昭。\n稽经崇庙号，万世永尊尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽词二首 其一","author":"倪思","text":"稽古神文焕，中兴武烈光。\n挈图亲授子，体道妙为皇。\n万乘隆尊养，千龄甫寿康。\n龙湖俄趣驾，遽返白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题椿桂堂","author":"倪思","text":"早从孟母受诗书，晚见飞腾五丈夫。\n桂籍联名看衮衮，兰陔戏綵极愉愉。\n已酬钟釜当年志，合入衣冠盛事图。\n教子荣亲谁不羡，堂成燕雀亦欢呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五峰瀑布","author":"倪思","text":"行行穷尽深林外，碧瓦鳞差依翠麓。\n峰峦左右相回环，万叶霜丹间晴绿。\n忽闻雷霆脚底声，声撼乾关隐坤轴。\n双龙跃出两崖间，倒泻银河作飞瀑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过东林山","author":"倪思","text":"世道荆榛似弈棋，奋身千仞复何辞。\n九霄地冷衣襟薄，五月山寒杖履迟。\n云外晚风驰铁马，日边香雾琐金螭。\n直须历遍丹梯险，方问嫦娥索桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"空烟亭","author":"倪思","text":"延福寺前亭下水，浅不容舠深没底。\n青林磅礴上云气，宛如翔鸾开羽翅，又如翠屏临水峙。\n山鸡照影空自媚，白鹭窥鱼惊不起。\n长官时时来隐几，殆似闻韶喜忘味。\n阆州城南胡可比，惜哉子美未见耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"倪思","text":"玉历初颁第一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题太山","author":"倪适","text":"下列群山谷万道，霞瑞重重绝顶高。\n独判天涯第一□，洞天深影无人□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其一","author":"倪称","text":"昨夜狂雷怒，鞭起卞山龙。\n怪见朝来急雨，万木偃颠风。\n试看潭头落涧，一片练波飞出，河汉与天通。\n向晚馀霏落，巾已垫林宗。\n向高岩，凭曲槛，抚孤松。\n为雕好句，快倾桑落玉壶空。\n借问庐山三峡，与此飞流溅沫，今日定谁雄。\n乞与丹青手，写入紫微宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其二","author":"倪称","text":"风卷暮云尽，镜净一天秋。\n试把鹅黄新酒，细酌散闲愁。\n西望群山千叠，眇眇飞鸿没处，爽气与俱浮。\n且尽尊中绿，不用叹淹留。\n对西风，歌妙曲，意绸缪。\n万顷烟云奇变，所得过封侯。\n何事苦萦名利，便合绿蓑青笠，投绂早归休。\n他日君寻我，小艇钓寒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"倪称","text":"四面烟鬟绕翠，一川鸭绿摇光。\n危亭缥缈短松冈。\n把酒与君西望。\n万事尽皆前定，人生底用乾忙。\n只应醉里是家乡。\n且尽玉壶新酿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其四","author":"倪称","text":"木落西风秋已半，正当璧月圆时。\n为登绝岭赋新诗。\n酒摇金凿落，波净碧琉璃。\n细看冰轮还有意，要君把盏休辞。\n看看两鬓欲成丝。\n明年当此夜，千里共相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其六","author":"倪称","text":"湖上青山千万叠，倏如阵马交驰。\n平湖百顷却逶迟。\n晴光相荡激，倒影落沦漪。\n何日漾舟深碧处，细听羌笛高吹。\n多君起我以新诗。\n未能同寓目，聊复一伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其七","author":"倪称","text":"鸟语朝来新雨霁，杖藜呼我闲行。\n天晴腰脚上山轻。\n清风收积润，斜日弄新晴。\n最爱飞泉鸣野涧，清如万壑松声。\n回风溅沫湿冠缨。\n归来魂梦冷，幽响杂瑶琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其三","author":"倪称","text":"竹里轩窗真可爱，况当暑退新凉。\n檐前岩桂向人芳。\n清阴团翠盖，金粟淡微黄。\n坐到夜深明月出，好风时度幽香。\n莫辞沈醉倒霞觞。\n一枝聊赠子，早冠绿衣郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其五","author":"倪称","text":"茅屋三间临木杪，门前流水潺潺。\n林泉得趣喜身闲。\n开窗延翠竹，剪树纳青山。\n行乐政须筋力健，莫令白发衰颜。\n与君藜杖极跻攀。\n岭头舒望眼，天末数烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其二","author":"倪称","text":"万里凉风收积雨，一天晴碧新开。\n暮云归尽绝纤埃。\n金波明静夜，玉露湿苍苔。\n坐有霜髯诗酒客，平生见月衔杯。\n传闻丹诏日边来。\n莫辞通夕醉，对景且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其一","author":"倪称","text":"结束征鞍临驿路，长林积雪消初。\n天回春色到平芜。\n不禁杯酒罢，便与故人疏。\n一曲阳关歌未彻，仆夫催驾修途。\n非君思我更谁欤。\n西风吹过雁，应有寄来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其五","author":"倪称","text":"嫩竹呈新绿，幽花露浅红。\n一檐苍翠落杯中。\n更有飞泉鸣佩、响丁东。\n乐事知难并，良辰得暂逢。\n晚风林下一尊同。\n便觉飘然身在、广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其四","author":"倪称","text":"露下衣微湿，杯深意甚欢。\n西风吹暑十分阑。\n月满中秋、仍共故人看。\n酒好鹅黄嫩，茶珍小凤盘。\n醉吟不觉曙钟残。\n犹记归来扑面、井花寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其三","author":"倪称","text":"对月中秋夜，传觞一笑欢。\n飘然逸兴未应阑。\n步向望湖桥上、倚阑看。\n松径风萧瑟，山腰路屈盘。\n南飞惊鹊五更残。\n小立水云光里、葛衣寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其一","author":"倪称","text":"佳月当今夕，清尊尽客欢。\n参横斗转夜将阑。\n试泛小溪深处、与重看。\n野水从磨激，群山势郁盘。\n殷勤照我一杯残。\n更有谪仙奇句、斗清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其二","author":"倪称","text":"置酒临清夜，狂歌尽一欢。\n主人幽兴未渠阑。\n不负一天明月、卷帘看。\n影动黄金阙，光摇承露盘。\n君今双鬓未凋残。\n明岁玉堂兹夕、赏高寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其六","author":"倪称","text":"积水凝深碧，斜阳散满红。\n扁舟轻漾白蘋风。\n曲港孤村萦绕、路相通。\n野色浮尊净，荷香入座浓。\n胜游聊复五人同。\n恰似辋川当日、画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"倪称","text":"超然远览。\n是我辈人方具眼。\n默想江湖。\n何处山川略得如。\n凉秋最胜。\n万顷芙蕖盖明镜。\n更乞清诗。\n要见胸中一吐奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"倪称","text":"岭头独览。\n诗料森然纷满眼。\n倒影摇湖。\n西子新妆定不如。\n溪南更胜。\n一片寒光明泻镜。\n赖有新诗。\n不负西山万叠奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一 和文伯兄咏新亭","author":"倪称","text":"凭高一览。\n紫翠相围光照眼。\n下瞰平湖。\n鹭立鸥飞意自如。\n天清境胜。\n云澹烟横鱼动镜。\n不是公诗。\n谁写新亭一段奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其五","author":"倪称","text":"新诗细览。\n满纸骊珠光眩眼。\n高论倾湖。\n倒峡词源世不如。\n园池日胜。\n只恨孤鸾犹舞镜。\n陶写须诗。\n怪得连篇字字奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"倪称","text":"新晴眺览。\n空翠相磨明老眼。\n水满溪湖。\n来往风帆得自如。\n天公济胜。\n明月当空开宝镜。\n咏谪仙诗。\n醉里骑鲸也大奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其六","author":"倪称","text":"雨馀还览。\n隐隐遥岑花病眼。\n嫩绿浮湖。\n百顷蒲萄染不如。\n晨光绝胜。\n不许纤尘微点镜。\n满目皆诗。\n莫怪骚人语益奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措","author":"倪称","text":"森然修竹满晴窗。\n山色净明妆。\n无限凄凉古意，白蘋红蓼斜阳。\n松风一枕借僧床。\n馥馥桂花香。\n暂远世尘萦染，坐令心地清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其五","author":"倪称","text":"茅屋三间临水路。\n棐几明窗，待把虫鱼注。\n我已忘机狎鸥鹭。\n溪山买得幽深处。\n小雨招君连夜语。\n野服纶巾，胜日寻君去。\n借问良田千万亩。\n何如乐取林泉趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其三","author":"倪称","text":"我爱西湖湖上路。\n万顷沧波，河汉连天注。\n一片寒光明白鹭。\n依稀似我登临处。\n报答溪山须好语。\n痛饮高歌，何必骑鲸去。\n环舍清阴消几亩。\n无人肯办归来趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"倪称","text":"绿叶阴阴亭下路。\n修竹乔松，中有飞泉注。\n水满寒溪清照鹭。\n个中不住归何处。\n枝上幽禽相对语。\n细听声声，道不如归去。\n只待小园成数亩。\n归来占尽山中趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 肖韩见和，复次韵酬之，四首 其二","author":"倪称","text":"紫翠空濛庵畔路。\n满室松声，错认潺湲注。\n潇洒苹汀清立鹭。\n溪山真我归休处。\n老子平生无妄语。\n梅竹阴成，肯舍斯亭去。\n种秫会须盈百亩。\n非君谁识渊明趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"倪称","text":"长羡东林山下路。\n万叠云山，流水从倾注。\n两两三三飞白鹭。\n不须更觅神仙处。\n夜久望湖桥上语。\n欸乃渔歌，深入荷花去。\n修竹满山梅十亩。\n烦君为我成幽趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"倪称","text":"拟看今宵璧月秋。\n浮云却妒素光流。\n天公肯放冰轮出，我辈宁辞大白浮。\n穿翠密，极遨游。\n人间那得此深幽。\n金波若到清尊里，下笔联篇未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 中秋赏月和宋卿","author":"倪称","text":"萧瑟西风万里秋。\n暮云收尽月华流。\n偶然北海清尊满，况是西山爽气浮。\n登翠岭，更溪游。\n素光何处不清幽。\n悬知明岁君思我，今夕欢娱可罢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 九日怀文伯","author":"倪称","text":"去岁登高感叹长。\n今年九日倍幽凉。\n怀人独下西州泪，对菊谁空北海觞。\n夸酒量，斗新狂。\n尚馀醉墨在巾箱。\n眼前风物都非旧，祗有青山带夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]