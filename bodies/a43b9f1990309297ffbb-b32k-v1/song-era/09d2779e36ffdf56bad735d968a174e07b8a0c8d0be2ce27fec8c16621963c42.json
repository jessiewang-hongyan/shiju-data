[{"title":"和仁仲舟中三绝 其三","author":"胡寅","text":"湘君谁识是皇英，占得君山冷淡青。\n月满湖平相照处，姮娥应得见娉婷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲舟中三绝 其二","author":"胡寅","text":"支川千百欲归东，不得江湖不会同。\n可但中流能击楫，也知高浪要乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲舟中三绝 其一","author":"胡寅","text":"异代纷争战伐多，楼船赢负倚苍波。\n如今天险如平地，雠虏深谋只用和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其三","author":"胡寅","text":"雨细云轻隐隐雷，东君行乐正徘徊。\n欲教游客留连醉，须放名花次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其四","author":"胡寅","text":"莫笑游人冷落时，风光流转不须疑。\n去年草色空成恨，今岁花光又满枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其七","author":"胡寅","text":"年年绿水送残红，不怨东君只怨风。\n芳草连云愁更远，劝君当醉万花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其六","author":"胡寅","text":"行春对酒满壶频，乐此春风自在身。\n须信壶中春不老，何人作计强留春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其十","author":"胡寅","text":"陋巷当年只屡空，于今还咏舞雩风。\n已推宝瑟铿然后，莫认青春醉眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其一","author":"胡寅","text":"雪后云收万里天，春从何处著山川。\n红边绿外无穷思，莫道今年似去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其八","author":"胡寅","text":"万卉千葩自不同，吹开只是一般风。\n对花不见花开处，却恐嬉游兴易穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其二","author":"胡寅","text":"气浃高深物物苏，问言还有欠春无。\n桃红李白犹閒事，麟凤应来瑞此都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其九","author":"胡寅","text":"洛阳风俗事栽花，流水园林眇一涯。\n移得旧根春不老，错疑蜂蝶过邻家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲春日十绝 其五","author":"胡寅","text":"燕舞方酣莺又啼，草堂春睡日平西。\n枝头有酒寻花去，小雨冥冥渐作泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王维三首 其三","author":"胡寅","text":"蓬门相直是南山，傍著丹梯尚可攀。\n野兴旧同流水远，道心今共白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王维三首 其二","author":"胡寅","text":"素不能诗复戒吟，辱君笙鹤堕清音。\n何须风月三千首，已洗尘埃一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王维三首 其一","author":"胡寅","text":"老矣鸡栖爱一廛，生涯随分不求全。\n一杯那复思身后，三爵聊将补食前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其三","author":"胡寅","text":"宁须较短复论长，拖白施朱亦两忘。\n有羡广平能草赋，病来无绪不成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其一","author":"胡寅","text":"的皪轻临宋玉墙，世间颜色尽凡妆。\n病夫欲作天花观，无奈时时得暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其六","author":"胡寅","text":"半开何惜恣追游，最怕风飘万点愁。\n倘是仙山有真籍，待凭方士更迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其十","author":"胡寅","text":"漫说琼花淮海阳，要知兰蕙不能香。\n人间草木如相对，宁遣诗仙引兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其九","author":"胡寅","text":"寒梅应不是甘棠，我辈为诗岂面墙。\n便对雪霜矜节操，未妨云雨下巫阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其十一","author":"胡寅","text":"醉把天葩嚼蕊香，笔端翻水趁诗狂。\n结成却荐和羹鼎，妙手先从锜釜湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其十二","author":"胡寅","text":"公子曾游翰墨场，诗成寒律带春光。\n杯中竹叶悠悠梦，句里梅花字字芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其五","author":"胡寅","text":"绿萼全胜红萼好，新枝争亚旧枝长。\n赏心未减春风蝶，傍蕊穿花栩栩狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其四","author":"胡寅","text":"雪消天气一番新，水际逢春淑且真。\n未信长安多丽者，定知空谷有佳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其八","author":"胡寅","text":"玉管吹残满地霜，去年遗恨不能忘。\n还来月下呈疏影，先向风前试晚妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其十三","author":"胡寅","text":"指数春回驱岁寒，催令花落鼻先酸。\n要须晴昊开芳草，乱插繁华足意看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和用明梅十三绝 其七","author":"胡寅","text":"要写横斜临水枝，应从淡墨见依稀。\n画师未必传天巧，争似西厢月影微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其十一","author":"胡寅","text":"正眼如君了了明，未尝沉醉本来醒。\n自将周易规儿辈，白马空传一藏经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其二","author":"胡寅","text":"有兴相寻即扣门，不须招致简书繁。\n试从大雅歌莺谷，未羡词人侈兔园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其十二","author":"胡寅","text":"似闻寂寂带经锄，老圃何知莫问渠。\n况是汉阴机事息，岂忧芳草翳嘉蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其三","author":"胡寅","text":"欲驻长春学道家，如何白雪是黄芽。\n聊凭高士五株柳，为问仙人三朵花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其一","author":"胡寅","text":"临流负巘百年居，手植松楠合抱株。\n传写春光入诗句，味之如对辋川图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其十","author":"胡寅","text":"栽培君子要添丁，护惜龙儿出锦绷。\n莫学当年馋太守，直须脱粟伴藜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其六","author":"胡寅","text":"春半曾无决定晴，今朝初上九天明。\n槛花莞尔窥人意，林鸟嘤然求友声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其九","author":"胡寅","text":"箨龙本是飞天物，养鳖宜充照席珍。\n一饭午窗春睡起，羲皇而上更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其七","author":"胡寅","text":"陶公春日事西畴，不是同群沮溺流。\n君亦荷锄贪雨足，谁知幽意在沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其五","author":"胡寅","text":"西园闻道径封苔，落落髯仙去不回。\n安石中年离索意，吾徒笑口且频开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其八","author":"胡寅","text":"仙居何异武陵溪，泛出残红春水肥。\n拟欲溯流兼载酒，应容艇子傍苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固春日村居即事十二绝 其四","author":"胡寅","text":"旧花一一斩新春，慰荐经行自在身。\n且使缓开常照眼，莫教轻堕恐伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余汝霖雪七绝 其六","author":"胡寅","text":"低唱谁家有女伶，映窗那用读书声。\n何当翠被同君猎，得兽雄夸得句清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余汝霖雪七绝 其四","author":"胡寅","text":"周宣辟国号中宗，六月兴师洒汗同。\n莫为苦寒辞出塞，采薇归戍亦论功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余汝霖雪七绝 其一","author":"胡寅","text":"无数天花斗舞风，迷离玉色映寒空。\n共誇破腊逾三白，更喜新诗报屡丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余汝霖雪七绝 其五","author":"胡寅","text":"燕山大雪暗胡云，将士何人欲赐勋。\n闻道玉宸温诏出，绝胜纯纩被三军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余汝霖雪七绝 其七","author":"胡寅","text":"朱老能诗更谨虔，叶公好学亦穷年。\n饥寒共保凌霜操，未羡重裘食万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余汝霖雪七绝 其二","author":"胡寅","text":"虽无谐谑去相携，且乏舆梁济涉溪。\n之子惠然须痛饮，醉眠应梦镇帏犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余汝霖雪七绝 其三","author":"胡寅","text":"日日东园探早梅，那知一夕万林开。\n君诗还似扬州句，扫尽因风柳絮才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令九日二绝 其一","author":"胡寅","text":"爽气深秋彻九霄，凭高眼界迥寥寥。\n凄风但可开黄菊，零露行应到蓼萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令九日二绝 其二","author":"胡寅","text":"行乐从来贵及辰，况逢节物一番新。\n病夫久矣捐杯酌，怅望临风落帽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令简园梨花四绝 其三","author":"胡寅","text":"共传嘉树锁山阴，冰彩瑶光自一林。\n未必甘滋追大谷，照人风韵故能深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令简园梨花四绝 其四","author":"胡寅","text":"清游当日兴怡融，无奈如丝雨映空。\n闻道只今方烂漫，莫教飞趁楝花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令简园梨花四绝 其二","author":"胡寅","text":"野老山园未省开，今朝何事客俱来。\n炎荒有此清凉地，剪水装林绝点埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令简园梨花四绝 其一","author":"胡寅","text":"梅花如梦李成尘，却伴酴醾过晚春。\n未要烘晴千树白，且看带雨一枝新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其八","author":"胡寅","text":"谑浪澜翻间诋诃，绝胜歌贯舞婆娑。\n解颐为听谈诗妙，脱腕空传草檄多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其十","author":"胡寅","text":"重按东皋岂自归，曾闻归思勇如飞。\n只因昨夜沉香帐，虮虱夤缘金缕衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其二","author":"胡寅","text":"久闻人境寄陶庐，深约同游驾小车。\n文举旧传樽有酒，冯驩宁叹食无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其七","author":"胡寅","text":"种竹何时匝两垠，只今疏翠已情亲。\n会看染合全溪影，照映来游碧落身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其九","author":"胡寅","text":"莫笑田翁不任真，好贤留客意殊亲。\n海棠半拆山丹重，京洛何曾远客身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其六","author":"胡寅","text":"跨溪临岸各清真，上客来临景更新。\n幽树好花脩竹色，相鲜浮动镜中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其五","author":"胡寅","text":"不惜冲泥步步前，为闻幽处有明川。\n峰回路转酬劳客，一派琉璃春正妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其一","author":"胡寅","text":"醉骑生马却扶舆，雪洒春衫二月初。\n行乐偶从山寺始，他年重到未成虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏十绝一宿云峰寺二到韩公庄三饭草衣岩四泊东禅刹五六七八游碧玉泉九访杨秀才十叔夏思归 其四","author":"胡寅","text":"马饥人困日西昏，无限归鸦已著村。\n记取东禅风雨夕，卧无床荐阖无门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其二","author":"胡寅","text":"梅后宁知花便无，不从香草寄相如。\n为君表出风流冠，只有春兰仅比渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其七","author":"胡寅","text":"萱草盈阶是绿衣，玉簪陪槛敢同时。\n更馀溅水无聊赖，都向仙姿共一帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其四","author":"胡寅","text":"洒然仙意指虚无，罗袜凌波定不如。\n织女未忘银汉会，空烦浊水映清渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其一","author":"胡寅","text":"玉质檀心翠羽衣，寒梅开后独当时。\n一枝折得将谁赠，想见花容出雾帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其六","author":"胡寅","text":"海岸仙人绝代无，清扬白日坐如如。\n若从妙色光香觅，须信先生未识渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其五","author":"胡寅","text":"荪桡兰楫芰荷衣，袅娜愁予二八时。\n嫁与湘君捐袂褋，玉搔头映白罗帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其八","author":"胡寅","text":"为花求偶岂全无，梅与山矾姊弟如。\n我已冥心芗泽观，何须江水对轩渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏水仙时见于宣卿坐上叔夏折一枝以归八绝 其三","author":"胡寅","text":"叶是青霞剪作衣，花如静女不争时。\n岂应更浥蔷薇露，撩得窥园不下帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏田舍三绝 其一","author":"胡寅","text":"尚恨山前尘土侵，去耕山后白云深。\n下泉不使苞稂秀，夫子宁忘济物心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏田舍三绝 其三","author":"胡寅","text":"日望云霓手揠苗，何时能和快哉谣。\n不如且种陶公柳，赢得长饥舞细腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父竹斋小池及游春五绝 其四","author":"胡寅","text":"春事已惊飞柳絮，香醪何日酿松脂。\n要平万点风前恨，莫遣千钟醒后知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父竹斋小池及游春五绝 其一","author":"胡寅","text":"虚斋要使暑天寒，移得扶疏惬静观。\n不但好风生殿角，已应春笋斗春阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]