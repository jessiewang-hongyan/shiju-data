[{"title":"孔子庙震","author":"梅尧臣","text":"霹雳下虚殿，破楹非梦凶。\n昔尝瞻画衮，今实见升龙。\n隐隐雷声散，疏疏雾气从。\n予知仲尼庙，不是蓄乖慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"梅尧臣","text":"斗觉琼枝瘦，慵开宝鉴妆。\n临风恐仙去，倚扇怯歌长。\n绿桂薰轻服，灵符佩缥囊。\n西邻空自赋，不解到君傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水苔","author":"梅尧臣","text":"深苔何所若，苦咏费毫尖。\n绕绕水仙发，茸茸蛟客髯。\n绿萦秋石净，嫩值翠篙黏。\n尚芼参差荇，薄言无此嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水荭","author":"梅尧臣","text":"灼灼有芳艳，本生江汉滨。\n临风轻笑久，隔浦淡妆新。\n白鹭烟中客，红蕖水上邻。\n无香结珠穗，秋露浥罗巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牛背双鸲鹆","author":"梅尧臣","text":"牛背双鸲鹆，烟陂共入时。\n草枯行解美，日晚趁群迟。\n閒载宁辞远，相鸣不间雌。\n初惊牧人去，飞上野桑枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"犬","author":"梅尧臣","text":"常随轻骑猎，不独朱门守。\n鹰前任指踪，雪下还狂走。\n人思上蔡迟，书寄华亭后。\n莫将呼作龙，粱肉才经口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王公慥东归","author":"梅尧臣","text":"行色上东陌，秋槐叶乱飞。\n囊无一钱用，箧有古书归。\n羸驷嘶寒草，荒城背落晖。\n莫嫌牛马隔，走别八行稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王氏昆仲归宁","author":"梅尧臣","text":"昨夜雪霏霏，梁山吟未归。\n关河谁道远，鸿雁自相依。\n落日人烟少，寒云驿路微。\n共将彭泽酒，称寿向庭闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王侍讲原叔挽词三首 其三","author":"梅尧臣","text":"丹旐秋风急，清笳晓月寒。\n明衣裛草露，素士挽桐棺。\n行哭宾徒盛，观仪里巷殚。\n空馀旧编在，千载莫能刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王侍讲原叔挽词三首 其二","author":"梅尧臣","text":"稽古逢尧舜，锵金侍冕旒。\n生员尊郑学，子舍预夔谋。\n翰苑事犹著，岱宗魂已游。\n无情是天地，玉树掩蒿丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王侍讲原叔挽词三首 其一","author":"梅尧臣","text":"衣冠今盛族，兰玉旧家声。\n博古无遗误，遭时有重名。\n魂舆临水发，灵马向郊鸣。\n归葬商丘外，森森柏已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王知章尉河内","author":"梅尧臣","text":"古县太行下，老槐三四株。\n以言新作吏，不似旧为儒。\n黄绶心犹壮，青云志岂无。\n汉朝吾远祖，不道此官粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王道损赠永兴冰蜜梨四颗","author":"梅尧臣","text":"名果出西州，霜前竞以收。\n老嫌冰熨齿，渴爱蜜过喉。\n色向瑶盘发，甘应蚁酒投。\n仙桃无此比，不畏小儿偷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长芦江口","author":"梅尧臣","text":"风驾晚潮急，浪头相趁过。\n水归瓜步小，船下秣陵多。\n鸥舞不停翅，燕飞轻帖波。\n今来学楚客，薄暮爱渔歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风瑟联句","author":"梅尧臣","text":"窍竹漏天风，张弦拟峄桐。\n佳名从此得，妙响未曾穷。\n夜静危台上，人闲皎月中。\n依依听不足，秋露满兰丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丘家渡早发","author":"梅尧臣","text":"曲颍若秋蛇，屈盘鳞甲活。\n问戍得耕人，拾鱼逢祭獭。\n草窠残野烧，树挂经流沫。\n百里相对看，频行愧迂阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东溪","author":"梅尧臣","text":"行到东溪看水时，坐临孤屿发船迟。\n野凫眠岸有闲意，老树著花无丑枝。\n短短蒲茸齐似剪，平平沙石净于筛。\n情虽不厌住不得，薄暮归来车马疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄王道粹学士","author":"梅尧臣","text":"已具扁舟访使君，忽逢春雨起淮濆。\n花寒蛱蝶犹相守，水冷鸳鸯不暂分。\n况约他时来寄迹，何须今日去论文。\n解装无复山阴兴，且对荆钗与布裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至日得师厚宋次道中道书","author":"梅尧臣","text":"水国欲为雪，野冰将合河。\n人同一阳至，泪向八行多。\n朋意今犹在，年华怅似过。\n看看四十九，应笑此蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出省有日书事和永叔","author":"梅尧臣","text":"辞家綵胜人为日，归路梨花雨合晴。\n庭下鞦韆应未拆，笼中鹦鹉即闻声。\n千门走马将看榜，广市吹箫尚卖饧。\n已是琼林芳卉晚，不须游处避门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发匀陵","author":"梅尧臣","text":"秋雨密无迹，濛濛在一川。\n孤村望渐远，去鸟飞已先。\n向晚云漏日，微光人倚船。\n安知偶自适，落岸逢沙泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古剑篇送蔡君谟自谏省出守福唐","author":"梅尧臣","text":"生铜夜夜鸣，剉铁未尝缺。\n主人久提携，何事赠离别。\n借问岂酬恩，请看镡上血。\n休惭补履功，出处异施设。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古冢","author":"梅尧臣","text":"南阳古原上，荒冢若鱼鳞。\n剑佩不为土，衣冠应化尘。\n枯骸托魑魅，细草没麒麟。\n何必问名氏，汉家多近亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古鉴","author":"梅尧臣","text":"古鉴得荒冢，土花全未磨。\n背菱尖尚在，鼻兽角微讹。\n月暗虾䗫蚀，尘昏魍魉过。\n但令光彩发，表里是山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史供奉群鹤","author":"梅尧臣","text":"出珥银貂侍太清，回看双鹤舞中庭。\n翩翩曾是仙人骥，两两尚仪君子形。\n静夜欲还缑岭月，终朝思啑太湖萍。\n莫将树上鸡相并，会待归飞向杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶大卿挽词 其三","author":"梅尧臣","text":"终始为全德，生荣没亦荣。\n里人悲画翣，郡吏拜铭旌。\n石马天麟肖，松枝国栋成。\n更看追孝意，捧土作新茔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶大卿挽词 其二","author":"梅尧臣","text":"自古贤才少，滔滔岂足云。\n善人安得见，清誉久来闻。\n器陨龙文鼎，魂归马鬣坟。\n丰碑几当立，籍甚著遗芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶大卿挽词 其一","author":"梅尧臣","text":"位列名卿重，年跻赐几尊。\n臧孙宜有后，定国已高门。\n旧族声华远，名藩治行存。\n秋风箫吹咽，陇隧起云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司马君实遗甘草杖","author":"梅尧臣","text":"美草将为杖，孤生马岭危。\n难从荷筱叟，宁入化龙陂。\n去与秦人采，来扶楚客衰。\n药中称国老，我懒岂能医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司徒陈公挽词二首 其二","author":"梅尧臣","text":"公在中书日，朝廷百事崇。\n王官多不喜，天子以为忠。\n富贵人间少，恩荣殁更隆。\n若非笳鼓咽，寂寞奈秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司徒陈公挽词二首 其一","author":"梅尧臣","text":"位至三公有，恩加赐谥无。\n再调金铉鼎，屡剖玉麟符。\n已叹鸾同穴，还嗟凤欠雏。\n拥途看卤部，谁为毕三虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月十三日唐店寄钱推官","author":"梅尧臣","text":"昨夜月如水，君能携酒来。\n破除愁闷去，洗荡肺肠开。\n露气林间落，河声地底回。\n相知不须早，语合自无猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"外兄施伯侃下第赴并门叔父招","author":"梅尧臣","text":"共是干时者，同为失意人。\n言趋太原召，如慰宛陵亲。\n笳鼓听临塞，琴书未离身。\n别君无斗酒，当识士安贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巧妇","author":"梅尧臣","text":"巧妇口流血，辛勤非一朝。\n莠荼时补紩，风雨畏漂摇。\n所托树枝弱，而嗟巢室翘。\n周公诚自感，聊复赋鸱鸮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永叔内翰见访","author":"梅尧臣","text":"内相能来顾，为郎乐有馀。\n儿童争拂榻，门巷劣容车。\n掩扇知秋意，窥墙省旧书。\n经年三枉驾，未与故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓜洲对雪欲再游金山寺家人以风波相止","author":"梅尧臣","text":"腊月海风急，雪吹岩下窗。\n轻舟不畏浪，昨日过寒江。\n渡口复夕兴，区中无与双。\n忽牵儿女恋，空听远钟撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘棠","author":"梅尧臣","text":"更衣入侍宫中贵，韡韡芸黄殿后花。\n斗色长宜日光近，生辉尤喜盖阴斜。\n依稀鞠服开风袂，约略仙盟裹露华。\n不与艳桃偷结子，漫天飞去作朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘露寺","author":"梅尧臣","text":"曾非远城郭，寂尔隔嚣氛。\n尚有南朝树，能留北固云。\n川涛观海若，霜磬入江濆。\n卫国丹青在，孤堂绿桂薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田人夜归","author":"梅尧臣","text":"田收野更迥，墟里隔烟陂。\n荒径已风急，独行唯犬随。\n荆扉候不掩，稚子望先知。\n自是一生乐，何须闾井为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家","author":"梅尧臣","text":"高树荫柴扉，青苔照落晖。\n荷锄山月上，寻径野烟微。\n老叟扶童望，羸牛带犊归。\n灯前饭何有，白薤露中肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家 其二","author":"梅尧臣","text":"草木绕篱盛，田园向郭斜。\n去锄南山豆，归灌东园瓜。\n白水照茅屋，清风生稻花。\n前陂日已晚，聒聒竞鸣蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家 其三","author":"梅尧臣","text":"荒村人自乐，颇足平生心。\n朝饭露葵熟，夜舂云谷深。\n采山持野斧，射鸟入烟林。\n谁见秋成事，愁蝉复怨砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白鹇","author":"梅尧臣","text":"乔木暗青山，晴川下白鹇。\n春云生岭上，积雪在嚣间。\n绿草张新翳，柔冠总翠鬟。\n时哉养文素，不是杂斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春在元日","author":"梅尧臣","text":"新春与新岁，时候不相先。\n未肯欺残腊，何曾占旧年。\n缀条花剪綵，插户柳生烟。\n独坐空山里，唯惊节物迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"任廷平归京","author":"梅尧臣","text":"言之少室西，定陟轘辕险。\n归心不避危，夕枕屡成魇。\n秋声故苑空，野气荒陵掩。\n独念京洛尘，曾将客衣染。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"任适尉乌程","author":"梅尧臣","text":"俛作程乡尉，折腰还自甘。\n卞峰晴照黛，霅水晓澄蓝。\n葑上春田辟，芦中走吏参。\n到时蘋叶长，柳恽在江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伐桑","author":"梅尧臣","text":"二月起蚕事，伐桑人阻饥。\n已伤持斧缺，不作负薪非。\n聊给终朝食，宁虞卒岁衣。\n月光无隔碍，直照破荆扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤桑","author":"梅尧臣","text":"柔条初变绿，春野忽飞霜。\n田妇搔蓬首，冰蚕绝茧肠。\n名翚依麦雊，戴胜绕枝翔。\n不见罗敷骑，金钩自挂墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再至洛中寒食","author":"梅尧臣","text":"西洛逢寒食，依依似昔年。\n千门方禁火，九野自生烟。\n飘泊梨花雨，追随杏叶鞯。\n游人莫惜醉，风景满伊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和","author":"梅尧臣","text":"廉纤小雨破花寒，野雀争巢斗作团。\n手卷白云光引素，舌飞明月响倾盘。\n群公锦绣为肠胃，独我尘埃满肺肝。\n强应小诗无气味，犹惭白发厕郎官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再送蒙寺丞赴郢州","author":"梅尧臣","text":"弯弓落飞鸟，少也向幽州。\n来作汉官属，耻为戎国留。\n身轻抛马辔，地暖厌狐裘。\n惯见颜如玉，江边问莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再寄歙州潘伯恭","author":"梅尧臣","text":"青山截天去，古路蔽云中。\n不有行人至，安知与郡通。\n高楼虽窈窕，古树已溟濛。\n今日劳君问，衡门一老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘元忠遗金橘","author":"梅尧臣","text":"南方生美果，具体橘包微。\n韩弹有轻薄，楚萍知是非。\n甘香奉华俎，咀嚼破明玑。\n欲换齑盐腹，盈奁忽我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘成伯遗建州小片的乳茶十枚因以为答","author":"梅尧臣","text":"玉斧裁云片，形如阿井胶。\n春溪斗新色，寒箨见重包。\n价劣万金敌，名将紫笋抛。\n桓公不知味，空问楚人茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閤门水","author":"梅尧臣","text":"宫井固非一，独传甘与清。\n酿成光禄酒，调作太宫羹。\n上舍鋹瓶贮，斋庐玉茗烹。\n相如方病渴，空听辘轳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"合流值雨与曹光道饮","author":"梅尧臣","text":"秋风嚎衰林，秋雨阻归客。\n赖有故时交，举杯聊岸帻。\n谈兵与论文，曾不涉陈迹。\n必竟无所施，醉去思泉石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊仲源","author":"梅尧臣","text":"世家吴季子，皇籍汉诸孙。\n嘒管行车失，虚堂隐几存。\n枝摧从玉树，星殒自天垣。\n宁复下贫贱，停骖来里门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊矿坑惠灯上人","author":"梅尧臣","text":"生栖云际巘，没葬寺傍村。\n破案残经卷，新坟出树根。\n松悲隔溪路，月照旧山门。\n自昔多诗句，而今几许存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊唐俞","author":"梅尧臣","text":"通闺年最少，才俊罕能双。\n鵩去尘栖室，魂归雾起窗。\n慈亲留汉水，爱妾返荆江。\n一稚才能语，茕然寄远邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊瑞新和尚","author":"梅尧臣","text":"示化何悲戚，俱焚只衲衣。\n已随原火尽，空见野云飞。\n写影谁方丈，栽松旧翠微。\n当年渡江钵，弟子独将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同尹子渐王几道访郭生别墅不遇","author":"梅尧臣","text":"秋野已澄旷，偶来幽兴多。\n茨居隔寒水，柴户荫乔柯。\n看竹曾留凤，携朋不为鹅。\n人归碧苔径，应识履痕过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同朱表臣及诸君游樊氏园","author":"梅尧臣","text":"五年前上去，乃从许公过。\n旧物此君在，后生新笋多。\n朱樱繁且熟，黄鸟啄仍歌。\n一一如当日，乘高奈兴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同希深马上口占送九舅入京成亲联句","author":"梅尧臣","text":"之子洛中来，芳樽喜暂开。\n人誇阿连少，吾愧士衡才。\n丹阙凤皇去，清川鸿雁回。\n都门春色美，相送思悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同诸韩及孙曼叔晚游西湖三首 其二","author":"梅尧臣","text":"烁电未成雨，凉风先入衣。\n青天忽开影，红日尚馀晖。\n蛱蝶作团起，蜻蜓相戴飞。\n嘲谑不觉夕，跨马月中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同诸韩及孙曼叔晚游西湖三首 其一","author":"梅尧臣","text":"晚日城头落，轻鞍果下凉。\n野蜂衔水沫，舟子剥菱黄。\n木老识秋气，径幽闻草香。\n幅巾聊去检，不作楚人狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吕缙叔云永嘉僧希用隐居能谈史汉书讲说邀余寄之","author":"梅尧臣","text":"奈苑谈经者，兰台著作称。\n吾儒不兼习，尔学若多能。\n每爱前峰好，闲穿弊屐登。\n定将修史笔，添传入高僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夹道冈","author":"梅尧臣","text":"舟脱鹅㿉浅，兵牵雁脚齐。\n兼沙水黄浊，穿垄岸高低。\n瘦土黄姜石，枯株长树鸡。\n薄言归向晚，路入赤云西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"并日得朱表臣酪及樱桃","author":"梅尧臣","text":"昨日酪将熟，今朝樱可餐。\n紫莼休定价，黄鸟未衔残。\n甘滑已相美，齿牙仍尚完。\n应知消客热，远赠盎盈盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"并游","author":"梅尧臣","text":"并出惭羸驾，康衢懒著鞭。\n蹇驴能胜马，擘道去如烟。\n何用嗟迟疾，从来有后先。\n所期皆一至，我到尔应还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]