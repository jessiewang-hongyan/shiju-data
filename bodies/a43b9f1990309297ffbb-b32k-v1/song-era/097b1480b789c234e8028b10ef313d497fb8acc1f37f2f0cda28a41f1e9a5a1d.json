[{"title":"送戚弼甫解官盐场二首 其二","author":"曾几","text":"访旧今无几，惟君昔有连。\n笑谈倾一坐，笔札富诸贤。\n作恶又数日，从游经二年。\n勉旃绳祖武，穷达自关天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送戚弼甫解官盐场二首 其一","author":"曾几","text":"听说君中外，堂堂世上名。\n文华张右史，正素老先生。\n已上三年课，相期万里程。\n赠行无好句，聊用一杯倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送逮子赴秋试江西漕司","author":"曾几","text":"有诏词场猎俊英，西风匹马豫章城。\n欲追诸父雁行上，肯逐群儿鱼队行。\n金是莫邪当自必，璞非死鼠会相明。\n笔端妙处还知否，万里秋天壮气横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾宏甫守天台","author":"曾几","text":"莫作阳关堕泪声，丹丘胜事要君听。\n兴公赋里云霞赤，子美诗中岛屿青。\n天近岂无宣室召，地偏犹有草堂灵。\n銮坡飞上勤回首，记取来游旧客星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾宏甫守天台","author":"曾几","text":"此地多朋好，惟君似弟兄。\n不堪轻作别，那得易为情。\n秋日行漓水，春风上赤城。\n莫言无过雁，略不寄佳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾宏甫赴光山守","author":"曾几","text":"千里光山去拊循，长淮练静属城闉。\n开门自少公家事，领客宁无我辈人。\n网户得鱼肌切玉，兵厨有酒色镕银。\n老翁生死谁相访，札翰时时到水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送路应求赴郢守","author":"曾几","text":"一雨全清去路尘，石城风物话临分。\n了无狱讼劳官长，剩有江山奉使君。\n楼上今谁能和曲，鼻端那复可挥斤。\n吾人莫道知音少，千里欢谣入听闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"适越留别朱新仲","author":"曾几","text":"扁舟绿涨漕渠时，解释离怀政用诗。\n管鲍交朋无变态，朱陈嫁娶有佳期。\n长洲茂苑著身久，秦望镜湖行脚宜。\n二浙中间才一水，短书莫使寄来迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逮子以今岁正月十六日之毗陵而以十二月十五日还舍铨试第二且得新雏以诗示之","author":"曾几","text":"不见吾儿久，今朝慰眼前。\n分襟灯火夜，回棹雪霜天。\n中鹄令人喜，将雏得我怜。\n一杯欢笑后，急急理尘编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡中迎怀玉山应真请雨得之未沾足","author":"曾几","text":"悯雨连三月，为霖抵万金。\n小垂开士手，足慰老农心。\n果欲千仓积，犹须一尺深。\n病夫浑不寝，危坐听佳音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋偶成","author":"曾几","text":"卧病江东久，饥驱强作官。\n年丰双雪鬓，心事一蒲团。\n帘影垂昼寂，竹阴生夏寒。\n无人知老子，于此有馀欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳","author":"曾几","text":"老去长争一寸阴，良辰物色负幽襟。\n中秋素月偏离毕，九日黄花未散金。\n蓓蕾不妨供小摘，茱萸聊复伴孤斟。\n重阳何必今朝是，从此篱边日访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻李泰发参政得旨自便将归以诗迓之","author":"曾几","text":"苦遭前政堕危机，二十馀年咏式微。\n天上谪仙皆欲杀，海滨大老竟来归。\n故园松菊犹存否，旧日人民果是非。\n最小郎君今弱冠，别时闻道不胜衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻降湖北提盐","author":"曾几","text":"一为散吏寄郊坰，三见南山木叶零。\n病著不能朝帝所，老来只合奉祠庭。\n绣衣玉节官仍作，流水桃花路再经。\n洞口故人应问我，淹留何处发星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻寇退欲还柳州寄柳守常子正","author":"曾几","text":"旧隐龙城在，书传喜可知。\n还来避地客，已去弄兵儿。\n瘴色休看镜，行期不问龟。\n中秋一杯酒，定与故人持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻寇至初去柳州","author":"曾几","text":"剥啄谁敲户，仓皇客抱衾。\n只看人似蚁，共道贼如林。\n两岸论千里，扁舟抵万金。\n病夫桑下恋，万一有佳音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻禽声有感","author":"曾几","text":"寂寂禅房闭，阴阴夏木繁。\n坐闻幽鸟语，胜与俗人言。\n脱裤高低树，提壶远近村。\n汝曹知底事，独与子规论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食笋","author":"曾几","text":"花事阑珊竹事初，一番风味殿春蔬。\n龙蛇戢戢风雷后，虎豹斑斑雾雨馀。\n但使此君常有子，不忧每食叹无鱼。\n丁宁下番须留取，障日遮风却要渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悯雨","author":"曾几","text":"梅子黄初遍，秧针绿未抽。\n若无三日雨，那复一年秋。\n薄晚看天意，今宵破客愁。\n不眠听竹树，还有好音不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王元渤舍人二首 其二","author":"曾几","text":"觞咏陪真率，言谈见坦夷。\n凄凉今日事，牢落暮年悲。\n有泪看诗卷，无情对酒卮。\n哀哉王子敬，吾党一何衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王元渤舍人二首 其一","author":"曾几","text":"早得文章誉，仍高政事科。\n珠玑随咳唾，襦裤起讴歌。\n老去贫逾甚，归来病更多。\n善人今已矣，施报果如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽石参议","author":"曾几","text":"人物千岩秀，家风万石馀。\n刘侯深爱画，杜氏富藏书。\n卿寺曾亲擢，藩方有诏除。\n遽随丹旐去，老泪溅衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽向伯恭侍郎三首 其三","author":"曾几","text":"昔在儿童岁，曾陪竹马游。\n芗林叨共席，泛宅幸同舟。\n忽忽三年别，堂堂万事休。\n孤风亭下梦，犹记曩时不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽向伯恭侍郎三首 其二","author":"曾几","text":"用舍行藏事，如公世所难。\n谁能奉香火，直作挂衣冠。\n国论言犹在，宸毫墨未乾。\n一生无限好，留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽向伯恭侍郎三首 其一","author":"曾几","text":"忠义云霄逼，声名日月悬。\n剧谈风满坐，杰作气无前。\n诗酒今彭泽，山林昔辋川。\n不随秋露尽，家集灿成编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕惇智直阁二首 其二","author":"曾几","text":"历数交游内，公家雅有连。\n舍人先即世，驾部复沈泉。\n远讣闻今夏，高谈记昔年。\n离穷一片影，大似老夫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕惇智直阁二首 其一","author":"曾几","text":"吕卿豪杰士，家世两申公。\n小试为郎日，深知有祖风。\n名高中兴后，病著半生中。\n遂作青山去，呜呼万事空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李泰发参政三首 其三","author":"曾几","text":"道义曾无间，因依遂有连。\n旋闻新雨露，亟返旧林泉。\n父老门庭下，儿孙几杖前。\n不令成此段，泣涕问苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李泰发参政三首 其二","author":"曾几","text":"汉室推元礼，唐家得卫公。\n龙门倾后辈，鲸海伏孤忠。\n守护多神物，旋归一老翁。\n如何九江路，万事并成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李泰发参政三首 其一","author":"曾几","text":"公昔遭前政，忠精不少衰。\n立谈廷争地，上疏里居时。\n意气南山在，名声北斗垂。\n心知不亡者，送往得无悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈丞相","author":"曾几","text":"身已栖岩壑，公初冠庙堂。\n奉祠方德庇，次对复恩光。\n政尔为舟楫，如何坏栋梁。\n绋讴争点笔，衰谢独难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈丞相","author":"曾几","text":"中兴论相得耆英，进退能为国重轻。\n有望临人山泰华，无私待物器权衡。\n两朝礼貌缘同德，多士凭依为至诚。\n自古元臣薨位少，一时生死极哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽郑禹功","author":"曾几","text":"山海淮壖利，吾徒职骏奔。\n长官惟我在，同事只公存。\n句法深深见，心宗细细论。\n清风今已矣，微月耿黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽郑禹功","author":"曾几","text":"郑公高义绝陈雷，别我姑胥首重回。\n书迹横斜良足喜，讣音曲折可胜哀。\n定知泡影垂垂尽，故傍江湖得得来。\n俗眼看公终未是，无生灭处咏归哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽晁恭道侍郎二首 其二","author":"曾几","text":"往日趋金马，中年剖玉麟。\n论思贰卿事，歌咏别都民。\n久矣穷诸妄，归欤契一真。\n东园尊俎地，俯仰迹成陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽晁恭道侍郎二首 其一","author":"曾几","text":"家令西京杰，文元圣世贤。\n大参名更重，学士集争传。\n此道长回首，惟公早比肩。\n呜呼百年半，赍志遂沈泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽梁元功","author":"曾几","text":"朋俦大半白头新，臭味同流少似君。\n交契虽深淡如水，宦情何翅薄于云。\n安知暮景莺声谷，遽作高原马鬣坟。\n忍向西风歌薤露，略无好语颂清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽梁元功谏议","author":"曾几","text":"岂弟更三郡，题评冠一乡。\n绳愆御史疏，补阙谏臣章。\n直叹牙弦绝，明嗟魏鉴亡。\n皇情应震悼，追贲盛龙光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽焦适道寺丞二首 其二","author":"曾几","text":"岂意初秋事，俄闻远日期。\n在公无可憾，有客不胜悲。\n宅兆溪山好，郊原草木衰。\n给孤园上路，无复往还时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽焦适道寺丞二首 其一","author":"曾几","text":"气质推浑厚，言谈见切磋。\n过从方里巷，挽送忽山阿。\n吉士今如此，高穹定若何。\n交游虽不乏，耆旧已无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽程伯禹尚书三首 其三","author":"曾几","text":"昔在宣和日，雍容接俊游。\n横经临璧沼，提椠上瀛洲。\n去德俄千里，依仁复两州。\n岂知垂老别，华屋落山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽程伯禹尚书三首 其二","author":"曾几","text":"璧水三千士，文闱第一人。\n煌煌持紫橐，亹亹逼鸿钧。\n得郡还辞剧，居家更乞身。\n期颐如可料，愁绝上元春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽程伯禹尚书三首 其一","author":"曾几","text":"诚明犹博学，直谅更多闻。\n休父中兴杰，宣王上圣君。\n精忠自金石，感会合风云。\n不谓生刍奠，今来下马坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽韩子苍待制","author":"曾几","text":"佩声曾到凤凰池，不尽胸中五色丝。\n三黜本因元祐学，一飞合在中兴时。\n忽惊地下修文去，太息门边问字谁。\n犹想泉台有新作，郊原小雨欲催诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"效诸生作雪中探梅","author":"曾几","text":"野梅消息近，踏冷访林端。\n东阁尊空满，南枝雪半残。\n疏条未禁笑，真态欲欺寒。\n后夜花应好，仍勤束火看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晁园","author":"曾几","text":"晁氏芳菲圃，因依渌水浔。\n峰峦春著色，桃李昼成阴。\n可惜花狼籍，仍遭雨滞淫。\n饶阳供客眼，只有此园林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别三侄","author":"曾几","text":"僧窗又与汝周旋，百感相随到酒边。\n无复吹篪如异日，空惊枕块已三年。\n一门叔父吾衰矣，东阁郎君但勉旃。\n不为怀金纡紫事，澡身玉雪是空传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别荣茂实侍郎","author":"曾几","text":"老为吴会客，耆旧不相忘。\n政以牛马走，曾陪鹓鹭行。\n千年书穴在，六月镜湖凉。\n从此登临地，回头忆侍郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中闻莺啼","author":"曾几","text":"独园森古木，其下客幽栖。\n尽日绿阴合，有时黄鸟啼。\n一声添昼寂，百啭使人迷。\n赖汝生佳听，身今气惨悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起赠曾宏甫","author":"曾几","text":"同病仍同起，无聊独至今。\n酒杯君入手，药裹我关心。\n极暑方无奈，新凉又不禁。\n呼儿锄径草，万一故人临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秘省避暑抵暮乃出","author":"曾几","text":"蜗庐何以度袢延，竟日蓬山一洗湔。\n阴翳树林无六月，风凉殿阁是诸天。\n政须深隐似玄豹，不用怀归如杜鹃。\n咄咄逼人牛马走，夜窗妨我枕书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕","author":"曾几","text":"妻孥挽我奉真祠，老子婆娑正坐谁。\n受禄功无一毫末，休官事有十年迟。\n尚容款曲悬车地，绝胜仓皇易箦时。\n请祝圣人千万寿，小臣何敢望期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸人见和返魂梅再次韵","author":"曾几","text":"蜡炬高花半欲摧，斑斑小雨学黄梅。\n有时燕寝香中坐，如梦前村雪里开。\n披拂故令携袖满，横斜便欲映窗来。\n重帘幽户深深闭，亦恐风飘不得回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"曾几","text":"散帙有佳趣，俗人那得知。\n醉乡非为酒，坐隐不关棋。\n几净幽怀惬，窗明老眼宜。\n一生无用处，又把教群儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱仲修饷新蟹","author":"曾几","text":"开奁破壳喜新黄，此物移来所未尝。\n一手正宜深把酒，二螯已是饱经霜。\n横行足使班寅惧，乾死能令疟鬼亡。\n毕竟爬沙能底事，祇应大嚼慰枯肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高邮无梅花求之于扬帅邓直阁","author":"曾几","text":"送腊腊垂尽，迎春春欲回。\n如何万家县，不见一枝梅。\n有客幽寻去，无人远寄来。\n扬州何逊在，政用小诗催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄许子礼","author":"曾几","text":"草堂竹坞闭门中，吏部持身有古风。\n老去一麾还作病，归来四壁又成空。\n今朝札翰如无恙，旧日诗书却未穷。\n拭目看君进明德，乃兄事业付天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄何晋之直阁","author":"曾几","text":"别来不寄一行书，贝叶琅函想自娱。\n喜得直庐新内阁，梦成同舍旧东都。\n绝知笔底鶱腾在，未省体中安隐无。\n见说闽山小儿子，夤缘即罢数趋隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄信守徐稚山侍郎","author":"曾几","text":"归去来兮莫问津，有船即买系江滨。\n自应一学陶元亮，不用更呼祁孔宾。\n已卜春前春后日，重寻水北水南人。\n使君为我新茅栋，数有书来意甚真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄泉南守赵表之","author":"曾几","text":"天遣高人下别峰，谅无官事汩胸中。\n香来海外沈烟碧，果熟林间荔子红。\n曹植诗篇疏入社，裴休参问远同风。\n萧然丈室维摩诘，何日文殊对此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄浙东参议郑禹功","author":"曾几","text":"忆昨分携自日边，星辰忽忽几回天。\n故人老作诸侯客，今我初无二顷田。\n安得诗书同保社，敢烦札翰访林泉。\n万山不隔襟期处，赖有渠侬一味禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄浙漕韩公圭琎","author":"曾几","text":"故人官达更相求，不但寒温札翰投。\n深贮炉薰来岭海，远包书帙到林丘。\n未知挽粟飞刍外，尚及哦诗把酒不。\n千里往还殊不隔，梦魂常绕日边州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄提舶王季羔","author":"曾几","text":"外台隐吏极风流，记得衰翁旧日不。\n三岛十洲曾接武，千岩万壑更从游。\n官曹闲似云间鹤，贾舶纷如海上鸥。\n幸有西湖应著我，时操艇子过明州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得瑞香于四明","author":"曾几","text":"锦树团栾海角州，移春槛里见风流。\n两三翠盖张前面，千百香囊缀上头。\n绝代红梅相对好，妒人山麝莫来休。\n衰翁若被儿童问，入眼还曾有此不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼云泉勤庵主","author":"曾几","text":"正坐长斋早得衰，中年一病莫医治。\n悬知水复山重地，难度风饕雪虐时。\n乘兴前村曾有约，寄声绝顶可无诗。\n禅房手自栽花木，付主林神好护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萤火","author":"曾几","text":"浑忘生朽质，直拟慕光辉。\n解烛书帷静，能添列宿稀。\n当风方自表，带雨忽成微。\n变灭多无理，荣枯会一归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒径山佛日杲禅师于虎丘","author":"曾几","text":"此老云相似，何天不往还。\n打包龙井寺，持钵虎丘山。\n一别经年事，相逢半日间。\n向来参底语，不堕有无间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]