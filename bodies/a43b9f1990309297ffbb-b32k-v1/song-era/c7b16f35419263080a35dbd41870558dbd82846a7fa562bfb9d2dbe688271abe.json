[{"title":"题川无竭寄傲窗二首 其二","author":"何梦桂","text":"南山有路滑如苔，多少人从半岭回。\n不是老僧空傲世，世人自不上山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王樵隐阻雨二首 其一","author":"何梦桂","text":"春水连天雨载涂，春江无处认平芜。\n茫茫世路风波恶，留得湘潭橘渚无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王樵隐阻雨二首 其二","author":"何梦桂","text":"偶出山来得半閒，桃花落尽水潺潺。\n早知人世多风雨，只好当初莫下山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠谈命月斋","author":"何梦桂","text":"万古缘空一镜磨，移来一室影婆娑。\n垂光照尽人间事，只恐年来风雨多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桔槔","author":"何梦桂","text":"片片龙鳞蜕老苍，有时伊轧卷沧浪。\n真机动处何容力，自是旁人脚手忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晨起","author":"何梦桂","text":"晨起窗前日未晞，玉梅霜后半开时。\n梅花与我两无语，寒雀相喧堕树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送儒医童达可","author":"何梦桂","text":"乾坤四塞五行淫，利欲颠狂蛊入心。\n黄帝不生岐伯死，祇今谁下顶门针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠童笔生","author":"何梦桂","text":"毛生归去罢中书，谁肯相从问字奇。\n近日长鎗多东阁，策勋依旧逊毛锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石室和尚作航亭名江湖稳处闻梅境有作因寄题","author":"何梦桂","text":"当年舟子吃拳时，失脚波涛万丈危。\n归去好寻休歇处，莫教再被八风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王德甫索归一诗留之","author":"何梦桂","text":"一叶扁舟雪夜来，尚期东阁共吟梅。\n长亭柳色不堪折，怕杀阳关叠叠催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠姜益斋","author":"何梦桂","text":"种得莲花入宝池，曾参惠远得锋机。\n东林无酒渊明老，故出山来访白衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠谈命月鉴","author":"何梦桂","text":"高悬一镜倚天边，要与人间照丑妍。\n天怕万形无遁处，故教多缺少团圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题桥亭","author":"何梦桂","text":"翠巘千重水一湾，小桥数板屋三间。\n此中竟日无车马，时听樵歌落半山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李尹","author":"何梦桂","text":"朅来老我差嫫母，忽听佳人赋莫愁。\n欲折芳馨聊寄似，只忧疏绮隔层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠章生","author":"何梦桂","text":"廷圭老死客卿亡，楮国丘墟笔冢荒。\n双脊龙文埋不得，百年犹自出玄光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和山房寺簿见寄韵","author":"何梦桂","text":"巨蝮磨牙血万家，天边有鼓许民挝。\n雷公手执腾云斧，不到移文宥毒蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王德甫樵隐堂","author":"何梦桂","text":"自入山来不记时，棋边痴坐老年衣。\n劝君柯烂休归去，归到人间世事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠古歙汪恕斋","author":"何梦桂","text":"自笑家鸡学未精，枕中书法岂能真。\n劝君珍重临池诀，莫遣儿童太逼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠毛道人","author":"何梦桂","text":"人言诸佛在真经，我向经中无处寻。\n说偈不曾留四句，教心那去觅三心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠地理张松溪","author":"何梦桂","text":"赤松当日秘青囊，圯上谁知授子房。\n千古遗编无觅处，君家独得壁中藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题武强陈公灵宝会序","author":"何梦桂","text":"金轮持世业风多，渺渺萧台正郁罗。\n昨夜宝珠平地现，浮黎碧落听空歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄平江灵岩寺至道和尚二首 其一","author":"何梦桂","text":"睦州山下几重山，片板千金一担担。\n好着蒲鞋牢系脚，上肩容易下肩难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄平江灵岩寺至道和尚二首 其二","author":"何梦桂","text":"说法灵岩席未寒，重来拈出祖师禅。\n入门一喝真奇特，不似回头面壁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和乔尹四绝 其一","author":"何梦桂","text":"兰枻藤桡桂作舟，锦江江上泛春流。\n自怜野燕翅翎短，空望江头鹳雀楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和乔尹四绝 其二","author":"何梦桂","text":"谁驾沧浪万斛舟，风涛未济正中流。\n同舟不用妨吟笑，自有舟师把舵楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和乔尹四绝 其三","author":"何梦桂","text":"千古兴亡夜壑舟，悠悠世事水东流。\n閒花落尽无人管，飞过垂杨十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和乔尹四绝 其四","author":"何梦桂","text":"剩得閒身野渡舟，风霜两鬓岁华流。\n人间万事邯郸梦，休记行藏去倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠桐江于处士","author":"何梦桂","text":"吮墨含丹各衒奇，解衣盘礴有谁知。\n须臾信笔出天巧，自此人间无画师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠东山诗僧信老","author":"何梦桂","text":"曾透西来最上机，尚馀习气学诗痴。\n寻常好句从何得，翠竹黄花总是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈桂山二首 其一","author":"何梦桂","text":"曾为将军试控弦，马陵坡下死庞涓。\n如今老大心犹壮，时射星标夺锦缠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈桂山二首 其二","author":"何梦桂","text":"曾抉青囊指玉幖，嘱君一语记须牢。\n他年若卜嫖姚冢，筑取祁连一样高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠何相士","author":"何梦桂","text":"逆旅鸢肩终遇主，将军猿臂不封侯。\n相逢一笑休閒语，老去无心觅虎头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尝令陈生作木苍龙头甚肖似因求赠言","author":"何梦桂","text":"谁试鸾刀作老龙，浑疑沟断出神工。\n明朝雷雨急飞去，莫遣天龙骇叶公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠云屋王相士","author":"何梦桂","text":"满榻尘埃不下山，白云堆里老陈抟。\n山中若见种明逸，休说樵夫是达官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠虚谷倪医士","author":"何梦桂","text":"采药山中不记秋，朅来卖药驾青牛。\n劝君莫入长安市，恐被旁人识伯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠巅峰术士","author":"何梦桂","text":"孱颜突出万峰间，禹穴龙门蚁垤环。\n夜半扪参穷绝处，半山风雨隔人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠玉峰方画士","author":"何梦桂","text":"妙画今无顾虎头，休论韩马戴嵩牛。\n玉峰住近山中寺，好画维摩施比丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠梅友胡丈","author":"何梦桂","text":"开遍南枝雪未乾，阿谁吹玉并栏干。\n相看不为和羹事，要把贞心伴岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠枯崖郑高士三绝 其一","author":"何梦桂","text":"孤撑突出万山高，几度曾经劫火烧。\n天遣五丁移不去，须知立处脚跟牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠枯崖郑高士三绝 其二","author":"何梦桂","text":"历尽冰霜几践更，皮毛剥落骨峥嵘。\n从前野烧閒花草，莫遣春风吹复生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠枯崖郑高士三绝 其三","author":"何梦桂","text":"人于崖下送君还，回首人间梦觉关。\n谁识巅崖隔风雨，一重山外一重山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答文公索玉楼赋二绝 其一","author":"何梦桂","text":"闻说当年白玉楼，有人秉笔侍宸游。\n如今世上无长吉，谁敢乘云驾赤虬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答文公索玉楼赋二绝 其二","author":"何梦桂","text":"鼎中铅汞未成丹，血肉那能化羽翰。\n待得千年玄鹤去，上皇方御玉阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠南谷倪高士","author":"何梦桂","text":"试向山中觅许玄，朅来采药已千年。\n相逢不乞神楼散，问我丹台第几仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题栖岩","author":"何梦桂","text":"青嶂千重水一湾，白云半坞屋三间。\n王孙归去休招隐，免被移文笑北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅边","author":"何梦桂","text":"江南何处美人家，认似梅花尚恐差。\n近向梅边得春信，始知人好似梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潘汝勉三绝 其一","author":"何梦桂","text":"招隐今无古小山，晨风倦翼暮飞还。\n青山白发人如昨，千古仙风愧莫攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潘汝勉三绝 其二","author":"何梦桂","text":"几度桃源青草生，相逢犹自说秦嬴。\n山中不识兴亡事，千载咸阳未息兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潘汝勉三绝 其三","author":"何梦桂","text":"潮去钱塘王气收，西风黄叶故山秋。\n杀身报国男儿志，皓首偷生妾妇羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳帅降笔命作画屏四景诗 其一 寒山拾得","author":"何梦桂","text":"形模丑陋发鬅鬙，留得生来面目真。\n拍手问谁能笑我，祇今笑杀世间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳帅降笔命作画屏四景诗 其二 钟吕二仙","author":"何梦桂","text":"葫芦有药剑通灵，南北东西物外身。\n相对不知谈底事，到头半语不传人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳帅降笔命作画屏四景诗 其三 工部游春","author":"何梦桂","text":"饭山吟得两肩癯，破帽东风白发微。\n好是春衣都典却，醉来骑得蹇驴归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳帅降笔命作画屏四景诗 其四 西湖","author":"何梦桂","text":"柳堤花港落红尘，独鹤归来日半曛。\n惟有五云山下路，至今人说岳王坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答文山谢诗序","author":"何梦桂","text":"岣嵝神奇字已漫，昌黎去后孰跻攀。\n平生有道碑无愧，幸托先生翰墨间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"记梦","author":"何梦桂","text":"万木萧疏老翠高，此身惭愧独坚牢。\n编书未了留侯事，何处仙源可种桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠云庵董道人","author":"何梦桂","text":"一坞寒云暝不开，茅檐低压半苍苔。\n近来云出不成雨，莫遣无心出岫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见本路赵府判二绝 其一","author":"何梦桂","text":"君来种竹两楼前，风月平分入坐边。\n尽日千峰吹不尽，官清惟饮钓台泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见本路赵府判二绝 其二","author":"何梦桂","text":"半生白发老南州，一见屏星万户侯。\n归去山中诧猿鹤，浪歌白石饭黄牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠紫岩周相士","author":"何梦桂","text":"梦觉邯郸事谬悠，祇今瘦绝饭山头。\n鸢肩莫问三公相，老去青门是故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠秋谷杨相士","author":"何梦桂","text":"负郭穷居陈户牖，牧奴困死卫长平。\n公侯骨相皆如此，谁具神仙碧眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠月波相士","author":"何梦桂","text":"人心如面万参差，觌面相逢未易知。\n惟有天边一轮月，千江长与月相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠宋道人无心","author":"何梦桂","text":"赤水珠光犹在海，丰城剑气已冲天。\n世人畜眼那知宝，吏掾元来有隐仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠林龙岩二首 其一","author":"何梦桂","text":"坐挹岚光翠入帘，出门俯槛弄清泉。\n夜深滴露点周易，辽鹤归时骨已仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠林龙岩二首 其二","author":"何梦桂","text":"昔时曾共探玄玄，一落红尘十二年。\n君隐好听西涧雨，我归亦歃北山泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"度查木岭","author":"何梦桂","text":"一径羊肠蹑岭腰，鸟飞灭没叫猿猱。\n回头下界人如蚁，尚觉山随脚步高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重到森溪桥二首 其一","author":"何梦桂","text":"往事惊心白发翁，重来雪迹印飞鸿。\n勋名未了将军老，空负鞬囊二石弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重到森溪桥二首 其二","author":"何梦桂","text":"武陵深处隔黄埃，怪杀渔郎误入来。\n早识落花流水去，当初好莫把桃栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感兴","author":"何梦桂","text":"芳草长亭春寂寂，白鸥沧海梦悠悠。\n百年空负乾坤责，应被青山笑白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和管雪堂劝农之什 其一","author":"何梦桂","text":"五马将春出劝农，春风散入万山中。\n山人未识君侯面，每向村田问老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和管雪堂劝农之什 其二","author":"何梦桂","text":"公堂无事化羲农，閒揖青山入坐中。\n人羡君侯得诗好，元来杜陆是诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和管雪堂劝农之什 其三","author":"何梦桂","text":"学剑无成去学农，学农更落惰农中。\n邦侯慈惠征徭简，喜课儿耕替阿翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和管雪堂劝农之什 其四","author":"何梦桂","text":"凝香坐啸有弘农，更得冰壶照幕中。\n人道千峰多好事，好宾尤好主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和管雪堂劝农之什 其五","author":"何梦桂","text":"山北山南听老农，裤襦歌已满城中。\n邦人愿得三年住，翻恐朝廷识弱翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达摩乘芦图","author":"何梦桂","text":"杨子江涛百丈深，黄芦一叶是梁津。\n嵩山壁观浑闲事，恐有山前立雪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毛女","author":"何梦桂","text":"自出阿房鬌绿云，耻将歌舞乐他人。\n华阴梦断咸阳远，隔世逢人莫问秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芙蓉","author":"何梦桂","text":"柳老荷枯菊蕊乾，写生红粉尚孤妍。\n马嵬坡下芙蓉面，犹觊君王轴上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辋川图","author":"何梦桂","text":"休官归去问田园，华子冈前竹里村。\n麦饭葵羹春酿熟，辛夷亭下弄儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题集画卷尾","author":"何梦桂","text":"门外黄埃没马头，山中花木自春秋。\n尘忙恐被禽猿笑，尽日看图不下楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]