[{"title":"奚知县挽诗","author":"洪咨夔","text":"敏锐霹雳手，宽平云梦胸。\n雄台高幕画，剧邑富民庸。\n帆挂风方駃，戈挥日又舂。\n炊粱剪春韭，无复奉从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和御制赐吴叔告已下闻喜宴诗","author":"洪咨夔","text":"致主唐虞泽兆民，贤才端是国精神。\n作人欲返皇风古，拔士先随圣化新。\n收敛文章归献替，安排事业到弥纶。\n宸章属望丁宁甚，上答天恩莫爱身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽万登仕","author":"洪咨夔","text":"种德谏议窦，处心承事黄。\n池园花竹老，庭户简编香。\n四世环叠綵，百年酣累觞。\n紫微身不到，丹墨付诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽中书俞侍郎 其二","author":"洪咨夔","text":"铨省承新渥，词垣访旧阴。\n颓波回万折，断岸立千寻。\n祇谓人犹己，那思昔异今。\n时清犹愤死，天地是知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽中书俞侍郎 其一","author":"洪咨夔","text":"器重千钧鼎，胸涵万斛舟。\n文章欧六一，政事富青州。\n偃月知谁在，灵光独我留。\n貂蝉虽未着，不作汗青羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽元寂王道士","author":"洪咨夔","text":"盘隐早具眼，栗斋仍点头。\n丰碑俱好在，烂醉更何求。\n院静桃开落，林深鹤去留。\n翛然风露表，无处觅青牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽礼上人","author":"洪咨夔","text":"盘屈虹蜺气，空山老白云。\n酒因陶令买，芋为邺侯分。\n甘露门知味，毗耶藏著勋。\n南轩无复见，岩卉自清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽孙谦伯 其二","author":"洪咨夔","text":"日月无多子，乡邦失两贤。\n直为吾党恸，不作世情怜。\n握手春风醉，论心夜雨眠。\n耳言犹历历，何忍表君阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽孙谦伯 其一","author":"洪咨夔","text":"文妙生花笔，名成映雪书。\n处家贫似富，应物密如疏。\n荐墨交黄绶，荣光照板舆。\n出门车折轴，天理竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽阮开之","author":"洪咨夔","text":"穷达皆归命，亏成不挂心。\n醉馀便腹睡，棋罢掉头吟。\n孔雀门阑旧，骊驹院落深。\n可堪重剥啄，寂寂杏花阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽阮宣义","author":"洪咨夔","text":"夜气精神饱，春风笑语酣。\n脩篁森道北，丛桂郁城南。\n雨露荣三釜，烟云老一龛。\n泷冈阡上路，秋思薄晴岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽阮倅","author":"洪咨夔","text":"胶庠推博洽，州县著廉平。\n人物万夫特，山川千古英。\n虬髯横意气，猿臂郁功名。\n一掬同年泪，西风浩荡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽伯父 其一","author":"洪咨夔","text":"白发儿随母，苍颜弟对兄。\n四休元易足，一笑更何营。\n论事丝弦直，存心镜面平。\n德人今已矣，谁与嗣乡评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李丞","author":"洪咨夔","text":"笃敬古君子，公平贤大夫。\n笔端知已有，券外得心无。\n落日摇墙竹，凄风堕井梧。\n蓄深施不尽，留与读书符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李贯之郎中 其二","author":"洪咨夔","text":"天定何能待，西风杳去槎。\n斯人嗟已矣，吾道信非耶。\n石泐名犹在，江空恨更赊。\n濂溪应配食，杯水荐寒花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李贯之郎中 其一","author":"洪咨夔","text":"刚大平生气，诚明问学功。\n不为官所饵，宁以道而穷。\n论事冯唐力，忧时贾谊忠。\n朝阳无此凤，何止哭江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李漕 其二","author":"洪咨夔","text":"百折溪山里，佳哉有此翁。\n名方随政起，命已坐文穷。\n满眼棠阴在，回头橘隐空。\n诗髯无复磔，万象自春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李漕 其一","author":"洪咨夔","text":"翰墨多推毂，功名早着鞭。\n风行青草外，春到白盐边。\n老去心犹壮，归来意正便。\n如何天不慭，烟雨閟新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽俞致政","author":"洪咨夔","text":"涉世万缘薄，爱书双眼明。\n身从平处立，道向拙中生。\n啖蔗何妨晚，栽槐恰待荣。\n偈成投笔去，天阔暮云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽俞景梁","author":"洪咨夔","text":"亿计桥门士，输君第一筹。\n文为天下样，行与古人谋。\n磨铁素心在，注金苍鬓休。\n梅边清绝梦，谁更酒扶头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽钟孺人","author":"洪咨夔","text":"夫没姑嫜老，年芳鉴珥新。\n孤峰晴后雪，硕果剥中春。\n命义生无愧，言容死未陈。\n西风吹拱木，双剑合龙津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽章冠叟","author":"洪咨夔","text":"卷却青云靶，书来意转平。\n于斯观所养，知不失其亨。\n梧竹自师友，梅矾皆弟兄。\n悲风吹梦远，不朽是乡评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽铜里叶提点","author":"洪咨夔","text":"养性居士白，用心承事黄。\n春风花竹墅，秋雨鲙莼乡。\n简淡趋真谛，廉平絜义方。\n志幽无长语，手墨粲琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽叠山先生","author":"洪光基","text":"千古精忠日月光，恨无麟笔写堂堂。\n迁家耻作梁江总，辟谷谁知韩子房。\n后死十年应有待，轻生万里故非狂。\n有儿可拾江边骨，须信人亡道不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂子次韵赠阮甥","author":"洪咨夔","text":"一树青青桂子荣，广寒宫殿玉为楹。\n不知天上何年堕，故使人间有种生。\n风影碎摇签帙爽，露华倒洗笔头清。\n寸田更与加培埴，收取天香染姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮溪周居士挽诗","author":"洪咨夔","text":"野水岗头屋，春风竹里厨。\n所安仁者静，其乐道之腴。\n遗逸盍徵诏，耆英空画图。\n诗书根气远，丛桂蔚相扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烛下次海棠","author":"洪咨夔","text":"红深翠浅浣花春，投老相逢过所欣。\n有许精神宜半睡，无多酝藉莫全醺。\n涵渟芳露须饶月，笼护晴晖不碍云。\n成就化工真富贵，天香更与牡丹分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病目","author":"洪咨夔","text":"日过学不力，年催名未芳。\n心期虽皦皦，目视已茫茫。\n灯叠青红晕，书纷黑白行。\n蒲团深瞑坐，禅味觉偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"被檄出城","author":"洪咨夔","text":"引却东风觱栗声，竹舆如斗作春行。\n山中祗怪天能窄，栈外方知地本平。\n黔袂炼?斜屋小，黄缨淘矿乱砂明。\n终年一饱难如许，愧尔炉熏管送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书楼 其二","author":"洪咨夔","text":"引却蜂衙一事无，求师尚友圣贤俱。\n激昂意气中兴颂，收敛身心太极图。\n畬火明边饥虎过，渡船声外老鸧呼。\n江南云水宽多少，万里深山着此臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书楼 其一","author":"洪咨夔","text":"流水青山一榻深，铜柯石干半窗阴。\n公馀点校七分易，老去服行三字箴。\n消长乘除观物理，存亡操舍验人心。\n日长大得官闲力，乳燕鸣鸠尽好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书蠖室","author":"洪咨夔","text":"扁为孜禅作，侵寻二十年。\n屈伸聊复尔，俛仰故依然。\n直榻无馀地，横窗不欠天。\n焚香长诵罢，风雨响山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读汉事","author":"洪咨夔","text":"病禹逢沈骜，酣参事懦盈。\n阴阳眠燮理，天地醉财成。\n河岳瞢腾立，羲娥蹩躠行。\n无人能唤醒，作意造升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱德成山水窟","author":"洪咨夔","text":"亦有黄金埒，非无瑞锦窠。\n养蒙知趣早，观复用功多。\n嘉客贲场谷，硕人槃涧阿。\n时平风日好，花竹几行窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高壶隐挽诗","author":"洪咨夔","text":"种德黄芽鼎，陶心碧玉壶。\n多交天下士，几唤竹间厨。\n秋雨凉催读，春风醉索扶。\n忽成观化去，冷落辋川图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高斋","author":"洪咨夔","text":"江浒行厨转，关头细路过。\n手摩如象石，目送卧龙坡。\n肮脏云端柏，鬅鬙雨后莎。\n晚来晴更好，舟发乱山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"婆饼焦","author":"洪咨夔","text":"万斛精神一握身，清吭宛转欲飞尘。\n鸡才唱后便知晓，燕未来前先得春。\n惊觉海棠休苦睡，提醒杨柳莫空颦。\n最怜吉语能相报，麦熟同为鼓腹人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿柁头次及甫入沌韵","author":"洪咨夔","text":"手遮西日望褒斜，百折舟行尚玉沙。\n风趁港回帆落柱，草迷路断牵收车。\n长烟漠漠非吾土，老树离离似我家。\n今夜宿头应更好，月明四面尽芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄崔帅卿","author":"洪咨夔","text":"归鸿只影宿汀洲，梦绕芦花不柰愁。\n颍谷杯羹无日遗，翳桑橐饭有时酬。\n功名旷世来斯受，议论惊人合则留。\n此事大关天下望，殷勤为报古扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题永嘉林氏真意堂","author":"洪咨夔","text":"萱草径庭寂，橘花窗户明。\n我惟天地性，物自古今情。\n玄酒无穷味，朱弦不尽声。\n道从涵泳得，宽作读书程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题辛氏尘外楼","author":"洪咨夔","text":"罗浮三十里，楼对玉崔嵬。\n风卷软红去，云扶飞翠来。\n会心须尽帙，适性莫多杯。\n除得翳根尽，灵光生镜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题真相寺遥月堂仍简礼上人","author":"洪咨夔","text":"四特递盈阙，八还齐闇明。\n须从心观觅，莫认指摽生。\n地僻人声远，山空夜气清。\n何时煨芋火，相与听瓶笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崔绵谷共赋亭次韵","author":"洪咨夔","text":"风度崔秋浦，声名郑子真。\n为便官事少，不厌客来频。\n竹里觥筹密，花边屐齿新。\n拍栏谁得句，唤起主林神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"族叔畴甫老死于场屋人共惜之其子得瑞梅于园实三而花一花十二瓣碧色其遗文发祥欤老人为赋诗敬用韵","author":"洪咨夔","text":"乃翁抱璞售无媒，去作修文地下魁。\n换骨法从青子得，返魂香自绿阴来。\n诗书根气春无尽，清白源流庆有开。\n十二循环花瓣异，信知天理有时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚莲","author":"洪咨夔","text":"飒然秋入井梧嘶，窗下红蕖始脱泥。\n但有意开何论晚，纵无力上不嫌低。\n鱼贪芳影机还熟，蝶怕深香路自迷。\n更把闲情坚耐着，明年花与屋檐齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"洪咨夔","text":"入夜风收雨，迟明暖酿霜。\n人穷髭易白，地瘦叶先黄。\n绣眼语丛竹，画眉啼断岗。\n炊烟犹未动，吾亦起歌商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"棕榈","author":"洪咨夔","text":"旧脱败蓑乱，新添华节高。\n肃容春尚静，侠气夏方豪。\n黄孕子鱼腹，青披孔雀尻。\n丰撞知可制，雷动景钟号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渚宫","author":"洪咨夔","text":"孤城铜斗匝，枉渚玉环连。\n柳老虫穿蚀，花残蝶扑缘。\n功名棋腹角，势利蜜中边。\n落日兴亡里，谁同药玉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移居西郭重楼","author":"洪咨夔","text":"欲归未办买山资，东寄西存漫一枝。\n楼上起楼渠自巧，客中作客我何痴。\n崎岖溪步通虚市，郁屈山蹊护短篱。\n不用子猷亲种竹，屋头元有绿猗猗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"章升伯妻孺人挽诗","author":"洪咨夔","text":"婉娈从君子，青云远大谋。\n乐羊灯火夜，李侃鼓鼙秋。\n露舄凫迎喜，星机鹊送愁。\n诰花纷五色，光动九原头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪留董景扬","author":"洪咨夔","text":"一色凝云合大和，定知宜瑞不宜多。\n饥餐乌昧世皆是，饱进羊羔人几何。\n抢地折腰纷岸筱，撑天强项独庭柯。\n留君待放晴光出，同步春风十二窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"帽子檐水宿","author":"洪咨夔","text":"聚石桩长缆，依沙插短舻。\n日昏山虎下，风急水鸧呼。\n道岂随时变，人须出力扶。\n仲由儿女见，谓欲果乘桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬次老人即事","author":"洪咨夔","text":"韶华九十恰平分，过化中存一点神。\n草脱烧痕非故色，梅收花事又新人。\n正襟危坐三灵会，拥鼻长谣万象宾。\n酬答风光惟办此，可能春梦到天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬和老人石菖蒲","author":"洪咨夔","text":"西风摆脱络头丝，荪壁为家不问蓍。\n分得九华烟雨壑，种将五老水云芝。\n戟髯洒洒精神健，剑脊棱棱气骨奇。\n窗外几多凡草木，为谁张王为谁衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬和老人青梅","author":"洪咨夔","text":"雪水迎风细作鳞，青青又是故园春。\n只知和鼎非凡子，岂料升盘有苦人。\n还我核来机转熟，寄渠花去意犹新。\n侧生底事摇车颊，空作渔阳一点颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬和老人盆池","author":"洪咨夔","text":"埋盆作沼野人家，数斛山泉拍两涯。\n人立晚风凉似水，荷浮香气胜于花。\n蛙声恰恰宜飞雨，鹜影依依欠落霞。\n齐物逍遥无大小，不须烦恼发生丫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬和老人览镜","author":"洪咨夔","text":"西谷柴车手自巾，风吹不到庾郎尘。\n回光返照千江月，复命归根一点春。\n永昼同窗陶处士，凉宵专席竹夫人。\n徐公好丑浑休问，认取青铜镜里真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬和老人荷花","author":"洪咨夔","text":"红红白白两般栽，浅浅深深一气催。\n但爱透从清水出，不辞脱自淤泥来。\n随花着盖相依立，聚菂为房忍擘开。\n妙洁色香无间断，床头更拨洗儿醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬和老人寓舍","author":"洪咨夔","text":"邹不辞三徙，滕何爱一廛。\n典衣宽酒债，乞米续炊烟。\n胜败供飞雹，亏成付响泉。\n东山时撰屦，花底弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑夕","author":"洪咨夔","text":"楼高收晚照，野迥送宵阴。\n鹭下汀沙静，萤行岸竹深。\n撄宁和顺气，缘督正平心。\n转物天机妙，昭文不在琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"畴甫叔挽诗 其二","author":"洪咨夔","text":"撰屦西山路，寻春得重陪。\n那知分手去，不作转头来。\n寂寂双溪雪，依依半树梅。\n经行陈迹在，横涕湿苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"畴甫叔挽诗 其一","author":"洪咨夔","text":"南渡几年里，深山谁力书。\n独君酣百战，许我丐三馀。\n参斗明灯烬，湖江渴砚蜍。\n斯人犹不第，天理竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答及甫见和 其二","author":"洪咨夔","text":"我爱湖南客，从横正复奇。\n短裳甘制芰，破釜懒燃萁。\n愤世惟堪饮，忧边不到诗。\n最怜孤寂甚，欲为唤罗龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答及甫见和 其一","author":"洪咨夔","text":"唤晴山鸟滑，辟暑水花明。\n蜀隶绵犹重，吴侬葛自轻。\n交情潘接魏，师法尹从程。\n鹅鸭堪供客，多烦拗项烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答子有","author":"洪咨夔","text":"高吟梁甫卧隆中，眼底驽骀不足空。\n清白自将千古月，温凉不定六时风。\n交梨火枣根苗长，翠竹黄花信息通。\n楼外秋莺强饶舌，笑人迟却黑头公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答王仲钧 其二","author":"洪咨夔","text":"老镜风霜饱，离觞岁月悠。\n曲多传郢水，诗亦到苏州。\n拽转撩天鼻，抽将闹市头。\n投林毋用急，时至会封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答骆肖秦","author":"洪咨夔","text":"过我葵榴巷，留君笋薤厨。\n襟怀新雨快，面目故山癯。\n自笑孤飞鹤，谁怜返哺乌。\n未应埋没得，囊有万骊珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答隆庆李守","author":"洪咨夔","text":"万里一天碧，百怀双鬓秋。\n凄其占后会，展也企前脩。\n风露昂藏鹤，烟波浩荡鸥。\n书来如觌面，香满藕花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]