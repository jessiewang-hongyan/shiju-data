[{"title":"依韵和王宣徽奉安中太乙神像","author":"王圭","text":"太乙真庭结宝坛，中涵元象本无言。\n三山波涌楼台近，北极星环剑佩尊。\n岁入飞宫初在丑，神移列驭直从坤。\n妖氛自逐灵旂捲，瑞谷常登御廪蕃。\n晓日破红浮斗栱，夕云凝紫护周垣。\n龙随御笔栖碑首，鹤带仙书语洞门。\n天马应歌来仗卫，岳祗联职听朝昏。\n传闻词客新吟苦，玉案才承上帝恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵恭和圣制俯同太师文彦博玉津园赐宴席上述怀","author":"王圭","text":"上苑张瑶席，春风万象新。\n谁知挂冠客，曾是钓璜人。\n感遇归真主，勋劳念老臣。\n曲成双凤舞，酒入百花醇。\n日月恩华满，朝廷喜气均。\n天章照黄发，异数极君仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊祀庆成诗 其一","author":"王圭","text":"国重天之报，神歆德所存。\n孝须三后配，礼莫一郊尊。\n翠羽来千仗，鸣铙下九阍。\n服维周冕盛，乐自舜韶温。\n未酌群灵降，先祠万玉奔。\n黄流凝夕祼，紫焰亘霄燔。\n星拱低宸幄，云回护帝辕。\n祥辉新日月，佳气浃乾坤。\n绍古归鸿铄，含生濯至恩。\n钦惟斋格至，仰福在元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采藻为旒","author":"王圭","text":"端扆垂君治，颙昂十二旒。\n藻文兼组烂，玉气若虹浮。\n体重宸居邃，仁深帝视收。\n珠光延外烛，星采会中稠。\n法服虽周盛，岩廊自舜游。\n无为格天下，涵德永孚休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题瑞芝图","author":"王圭","text":"乐国芝呈瑞，贤侯贰郡时。\n甘棠方蔽芾，仙草亦葳蕤。\n异种传三秀，灵华粲九枝。\n幽阴吐光怪，朽腐化神奇。\n美政邦人颂，嘉祥圣主知。\n特书辉史策，宠锡下天墀。\n治行能如此，公台到匪迟。\n谁为燕许手，洒笔播声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又上监察御史","author":"王圭","text":"一札兴贤圣化新，观光上国已彬彬。\n右文幸际休明世，奉诏犹须牧守臣。\n鹈鴂不为芳草计，鹪鹩似畏罻罗人。\n轺车到处天恩遍，祗有儒林欠得春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又依韵和吴枢密上史馆王相公西府偶成","author":"王圭","text":"潭潭相对府中居，见说论交二纪馀。\n喜赐御花新燕后，忆乘天马并游初。\n公期异日还伊水，我合穷年老石渠。\n早晚相从挂双绂，午桥春雨看园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长兴馆绝句","author":"王圭","text":"风霜守冢不知年，犬类那思母爱偏。\n却谢汉恩颁五饵，载令梳洗向山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东楼","author":"王圭","text":"汉家宫省青槐下，信断鳌峰日易斜。\n应为能言锁鹦鹉，翻愁无思学杨花。\n风波滚滚惊人事，文字孳孳老岁华。\n偶向东楼望春色，归心不觉到天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿春花 其二","author":"王圭","text":"初见迎春识春新，欲插迎春惊春半。\n朱门深锁不知春，苒苒年光暗中换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹭亭","author":"王圭","text":"白鹭敞西轩，栋宇穷爽垲。\n千峰若联环，翠色不可解。\n是时天宇旷，六幕无纤霭。\n金斗熨秋江，素练横衣带。\n乾坤清且敛，气象朝昏改。\n芦花作雪风，飞舞来沧海。\n九霄汀鹤起，万里樯乌快。\n月上三山头，鸟没横塘外。\n苍茫洲渚寒，银错星斗大。\n开樽屏丝竹，披襟向箫籁。\n余生本江湖，偃蹇欣作会。\n清兴虽自发，苦嗜亦吾累。\n鱼龙凭夜涛，四面忽滂湃。\n安得犀灯然，煌煌发水怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏呈唐卿","author":"王圭","text":"行到鹿儿山更峭，八千归路可胜劳。\n长安日远思亲发，紫汉星回促使轺。\n晓磴云浓藏去驿，阴崖冰折断前桥。\n羁怀一夕犹难遣，况是辞家九十朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次胡则大赋雪韵","author":"王圭","text":"冻雀无声风叶乾，坐来飞霰洒窗寒。\n梅花岁岁如相待，琼树朝朝不厌看。\n邑犬仓皇惊越俗，崖松偃亚老秦官。\n衰颜不作安仁样，一任斜吹上鬓端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟试置章御座二首 其一","author":"王圭","text":"睿听来嘉论，忧勤政事昌。\n颙颙瞻帝座，谔谔置臣章。\n语切青规上，文留黼扆傍。\n受言初拜禹，罪己忽兴汤。\n进牍须盈几，垂衣岂下堂。\n只应千载治，危谏属忠良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和吴相公史院开局","author":"王圭","text":"晓下金门路，君筵听召馀。\n簪缨三寿客，笔削两朝书。\n身老谁逢此，恩深尽醉欤。\n传闻访遗事，应走史臣车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和张文裕龙图贺执政入东西府诗","author":"王圭","text":"微生巾褐本蒿莱，叨遇优贤府第开。\n云绕连甍依象阙，玉调清管下钧台。\n几年忆共鹓鸿侣，今日惭非柱石材。\n莫讶门庭光采盛，金舆亲屈帝尊来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和圣俞莫登楼","author":"王圭","text":"莫登楼，楼外华灯人竞游。\n翠枝威威六素虬，鸣梢一声从天头。\n金炉烟开雉尾收，正见月射双琼钩。\n半峰飞泉落惊沤，嘘呵紫雾鱼龙浮。\n弦清管高脆欲流，霜寒雏凤丹山愁。\n台上美人春风柔，舞腰回急宝钗投。\n禁街特敕香车留，帘疏的皪排星眸。\n画省宵閒空翠帱，束如穷兔离新罘。\n况惊白发心悠悠，安复繁华事轻裘。\n寄言侠少谁为俦，烂醉玉楼歌始休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和永叔思白兔戏答公仪忆鹤杂言","author":"王圭","text":"兔自明月窟中出，鹤从群玉峰头下。\n人间俗眼未尝窥，已为两家藏以诧。\n玉堂词人本仙材，光芒偶落银河罅。\n谪向埃尘五十春，所趣无一不潇洒。\n为爱霜蹄特皎洁，贮以雕笼绿棂亚。\n有时惊踯歘若奔，丹眸眩转双珠射。\n灵昌太守新归来，惜将清唳寄京舍。\n玉绳低阙春露寒，常恐阴林恶声嚇。\n传宣忽出右银台，诏急许驰天厩马。\n却辞丹陛锁南宫，兔鹤欲携俱不暇。\n是时雪后帘幕明，灯火冷落入清夜。\n两翁相顾悦有思，便索粉笺挥笔写。\n有客月底吟影动，猝继新章亦奇雅。\n大都吟苦不无牵，遂约东家看娅姹。\n醉翁良愤诋高怀，却挥醉墨几欲骂。\n我闻此语初未平，随手欲和思殊寡。\n玉山沧海莫放翻然归，纤腰绿鬓何妨为君倒金斝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林乔年学士普净院避暑","author":"王圭","text":"汩汩红尘倦往还，偶来偷得似僧閒。\n一心自别清凉处，万事如经梦寐间。\n尽日禅房挥玉麈，几时仙岭对冰颜。\n知君有术消烦暑，旋琢琼瑶出道山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅圣俞感李花","author":"王圭","text":"朝摘桃花红破萼，暮摘李花繁满枝。\n客心浩荡东风急，把酒看春能几时。\n舞衣未放哀弦阕，鷤䳏欲鸣花影绝。\n将军白首不功名，霸陵千古流青血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和敬叔弟七月十二夜胡伯恭园池对月即事之作","author":"王圭","text":"小庭追凉月生衣，红蕖静对丹桂枝。\n凌波亭亭仙佩冷，弄香袅袅香风吹。\n百忧身世得一笑，二妙风流此一时。\n阑干独夜发深省，凭诗寄与心相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景彝诮扶出者","author":"王圭","text":"天子重论秀，待之以公卿。\n志士抱奇节，犹或场屋轻。\n学能苦自琢，诗书腹纵横。\n胡为怀袖间，挟册角群生。\n诃卒窥其旁，执衣来叩楹。\n狂狙就新缚，跳突哀且鸣。\n岂不念寒孤，顾有素令明。\n利禄非可苟，辱甚舍弗烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊祀庆成诗 其二","author":"王圭","text":"有宋乘炎运，于今迈百年。\n祖功虽不易，子圣自能传。\n宝历迎长至，神丘放大圜。\n灵宫千福降，清庙一诚专。\n翠仗钩陈下，青城斗极边。\n侧班回众弁，虚次待高烟。\n晦雾初宵断，晴云未晓鲜。\n天形何磊落，帝步亦周旋。\n丽泽沾鱼鸟，休歌被筦弦。\n欢声兼岳动，和气与春连。\n在昔开鸿业，斯民入化甄。\n监危常栗栗，受祉更乾乾。\n此日膺神筴，孤臣老禁筵。\n愿将成命颂，独奏迩英前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"信字卷子","author":"王圭","text":"春闱只恐有遗材，据案重将信字开。\n白石谩应歌宁角，黄金枉是起燕台。\n侵更竞看仓惶笔，薄晚谁衔毷氉杯。\n文字须从勤苦得，莫沾双泪向尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南海馆中","author":"王圭","text":"岭外经年逐断蓬，孤吟废馆几宵中。\n灯回秋壁耿乡梦，雨送夜潮飘海风。\n靖节久抛三径乐，子云坐汉十金空。\n何时征棹一归去，江有鲈莼岸有风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十八","author":"王圭","text":"禁庭漏促斜沉月，殿烛光寒未捲帘。\n御仗催班元会集，牙牌先入奏中严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十三","author":"王圭","text":"昨日龙舆幸宝文，宸毫金轴展风云。\n前朝御印从头拆，重整牙签甲乙分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十","author":"王圭","text":"銮舆昨夜宿郊坛，月淡风低綵内寒。\n密写销金红榜字，宫中日日报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十三","author":"王圭","text":"花香著蕊藏蜂翅，柳影拖金入琐窗。\n舞鉴晓鸾无奈只，认归梁燕却成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其一○一","author":"王圭","text":"小雨霏微润绿苔，石栏红杏傍池开。\n一枝插向银瓶里，捧进君王玉殿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三","author":"王圭","text":"一片桃花一片春，夜来风雨落纷纷。\n多情更逐东流水，还作高唐梦里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十五","author":"王圭","text":"十三垂髻碧螺松，学舞经年后苑中。\n近日昭仪抄姓字，一时宣拨入东宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡则大学士满秩趋京赋诗为赠","author":"王圭","text":"一室萧然数卷书，三年冷掾出无驴。\n每因芳草忧鹈鴂，苦咏场苗羡白驹。\n俗吏何尝知大体，清朝方急用真儒。\n燕台从去流声实，见说诸公诵子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草","author":"王圭","text":"袅如垂线软如茵，古渡蒙茸映烧痕。\n解憾有情迷雾雨，恣生闲地杂兰荪。\n绿铺春色围荒寺，远衬斜阳接钓村。\n波翻别浦情无尽，日下重楼望欲迷。\n独鸟自飞烟漠漠，行人不驻雨凄凄。\n王孙何事征鞍晚，兰泽空闻杜宇啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送山人程惟象东归","author":"王圭","text":"君来客京洛，奇术世所闻。\n人事固倚伏，物情徒纠纷。\n衣沾九门雨，梦绕故山云。\n饮罢忽东去，浩歌秋日曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧惠思归钱塘","author":"王圭","text":"城邑喧喧非所依，忽生秋思满岩扉。\n晨跌未雨千花落，晚渡临风一锡飞。\n定有鱼龙窥供钵，应无尘土上禅衣。\n宝文圣偈谁为解，只恐林泉亦暂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽钱公起","author":"王圭","text":"家学三馀足，词场一眼空。\n摘髭连荐鹗，点额不成龙。\n酒上新坟土，香销旧桂丛。\n绝怜扬执戟，临老悔雕虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷叶","author":"王圭","text":"柄密藏溪路，香清荡客襟。\n碧筒聊助饮，紫橐自供吟。\n鱼戏凉波动，龟巢夕雾深。\n横塘双桨急，菱唱有馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资善堂御筵送太子少保致仕李柬之归西京","author":"王圭","text":"紫阁飞章谢宠名，离筵特地敞宫楹。\n杯深御酒先成醉，衣拂京尘顿觉清。\n少室旧游窥玉霤，甘盘馀训薄金籯。\n谁言疏傅东归盛，不得君王一饯行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资善堂御筵送尚书刑部侍郎致仕李受归庐山","author":"王圭","text":"都门车马动行尘，诏集华堂宠退臣。\n延阁带经为旧老，商山携杖作归人。\n燕回天上还侵晚，梦入江南已见春。\n曾抱遗弓泣陵土，此生无复犯龙鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"王圭","text":"急景易如流水去，浮名终与白云空。\n何如几曲秋溪上，醉泛一舟烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜定号","author":"王圭","text":"忆昨怀君诏，章台听暮钟。\n人从太微下，书自道山共。\n彩凤看飞笔，长虹见吐胸。\n冤家成行对，侧理入腰封。\n海阔珠难采，山辉玉易攻。\n别吟平乐赋，高第唱西廱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琼林苑御筵送致政太师潞国文公归西洛","author":"王圭","text":"祖燕催移玉殿班，都人齐向苑傍看。\n古来少有三师退，天下曾将大器安。\n绿野春深花更好，石楼夜午月应寒。\n尘埃抖擞无馀事，却忆磻溪旧钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集英殿皇子降生大燕教坊乐语口号","author":"王圭","text":"忽觉祥烟绕禁门，宝慈宫里见皇孙。\n便令三洞张钧乐，直许千官醉御樽。\n未晓清风生殿阁，经旬赤气射乾坤。\n须知此会非常有，遥看天颜一倍温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼上述怀","author":"王圭","text":"空楼百尺江之浒，醉上凭轩怀故土。\n数鸿秋入衡阳云，一帆暮过潇湘雨。\n庾客伤心欲断弦，文通别泪空横柱。\n旧山几亩林泉乡，安得归兮事农圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其五 夫人阁","author":"王圭","text":"日长珠箔漏声稀，团扇新裁越女机。\n进罢采丝三殿晚，万年枝上乱莺飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题道录陈景元中太乙宫种玉轩","author":"王圭","text":"一住仙祠绝世尘，庭前种玉已嶙峋。\n朝昏龙虎常听法，左右琼瑶自逼人。\n翠凤有时翻瑞影，银蟾通夕堕清津。\n黄金络马何年醉，得去同游几洞春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠礼部侍郎宋次道挽词","author":"王圭","text":"平日朝廷重老儒，何人奕叶在青途。\n吟笺夜月惊皴兔，谈麈春风落宝珠。\n金石谁新三代乐，丹青空上两京图。\n可怜东观书垂就，不得君前万岁呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁中朝会三首 其一 皇帝初举酒用《庆云》。","author":"郊庙朝会歌辞","text":"乾坤顺夷，皇有嘉德。\n爰施庆云，承日五色。\n轮囷下乘，万物皆饰。\n惟天祚休，长彼无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝会 其二","author":"郊庙朝会歌辞","text":"太平之符，昭发众瑞。\n爰有嘉禾，异垄合穗。\n大田如云，既穫既刈。\n野人愉愉，不亦有岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"导引 其一","author":"王圭","text":"玉宸朝晚，忽掩赭黄衣。\n愁雾锁金扉。\n蓬莱待得仙丹至，人世已成非。\n龙轩天仗转西畿。\n旌旆入云飞。\n望陵宫女垂红泪，不见翠舆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"导引 其二","author":"王圭","text":"上林春晚，曾是奉宸游。\n水殿戏龙舟。\n玉箫吹断催仙驭，一去隔千秋。\n游人重到曲江头。\n事往涕难收。\n空馀御幄传觞处，依旧水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉安真宗皇帝御容于寿 星观永崇殿导引歌词","author":"王圭","text":"忆玉清景，繁盛极当时。\n千古事难追。\n汉家别庙秋风起，空出奉宸衣。\n三山浮海日晖晖。\n羽盖共云飞。\n灵宫旧是栖真处，还望玉舆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"王圭","text":"柯同庭橘劲，色近御衣深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"王圭","text":"摇摇墙头花，脉脉含幽姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王圭","text":"泽国旅艎冲雨黑，都门祖庙照堤红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王圭","text":"未晓清风生殿阁，经旬赤气照乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一落索 送王伯绍帅庆","author":"王安中","text":"塞柳未传春信。\n霜花侵鬓。\n送君西去指秦关，看日近、长安近。\n玉帐同时英俊。\n合离无定。\n路逢新雁北来归，寄一字、燕山问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一落索 其二","author":"王安中","text":"欲访瑶台蓬岛。\n烟云缥缈。\n清游却到凤皇池，听檀板、新声妙。\n天上除书催早。\n人瞻元老。\n东风烟柳罩河堤，更何处、深春好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一落索 其一","author":"王安中","text":"梦破池塘杳杳。\n情随春草。\n尊前风味不胜清，赋白雪、幽兰调。\n秀句银钩争妙。\n殷勤东道。\n蛮笺传与翠鬟歌，便买断、千金笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 柳州作","author":"王安中","text":"燕尾道冠儿，蝉翼生衫子。\n敧枕看书卧北窗，簟展潇湘水。\n团扇弄薰风，皓质添凉意。\n谁与文君作粉真，只此莲花是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 往道山道中作","author":"王安中","text":"客舍两三花，并脸开清晓。\n一朵涓涓韵已高，一朵纤纤袅。\n谁与插斜红，拥髻争春好。\n此意遥知梦已传，月落前村悄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山 其一 汤","author":"王安中","text":"重举金猊多炷香。\n仙方调绛雪，坐初尝。\n醉鬟娇捧不成行。\n颜如玉，玉碗共争光。\n飞盖莫催忙。\n歌檀临阅处，缓何妨。\n远山横翠为谁长。\n人归去，馀梦绕高唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]