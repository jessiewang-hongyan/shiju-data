[{"title":"早谒禹庙","author":"张伯玉","text":"晓出五云扃，皎日丽初宿雾敛严祠款灵秘。\n拂衽天风散，不听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晓","author":"蔡襄","text":"曈曈初日注窗明，窗外雏莺乳燕声。\n东风气味浓于酒，晓梦魔人似宿酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"度南涧","author":"蔡襄","text":"隐隐飞桥隔野烟，石矶西畔问渔船。\n桃花尽日随流水，洞在清溪何处边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入天竺山留客","author":"蔡襄","text":"山光物态弄春晖，莫为轻阴便拟归。\n纵使晴明无雨过，入云深处亦沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陈峤","text":"彭祖尚闻年八百，陈郎犹是小孩儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈峤","text":"小桥风月年年事，争奈潘安老去何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"邵迎","text":"盐鼓调羹金液腻，橙齑荐鲙玉丝肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"徐仲谋","text":"安寝有时延皓月，闭门无处不清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕翁祠","author":"陈孚","text":"山形天矫苍精剑，日气曈曚紫磨丹。\n度尽世人人不识，青烟起处是邯郸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辰州 其二","author":"陶弼","text":"槃溪何代有兰丛，暇日移根郡阁东。\n此后辰沅图籍上，栽培新法自山公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"陶弼","text":"水归交广尽，天入斗牛初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四十八","author":"陶弼","text":"鹿饮沙浑水，猿饥果落云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释法宝","text":"千般言，万种喻，祇要教君早回去。\n夜来一片黑云生，莫教错却山前路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿天竺寺赋闻泉呈二老","author":"杨蟠","text":"我有泉中兴，平生爱水经。\n山空时决决，夜静转泠泠。\n暗脉来湍急，清声出混冥。\n月寒风不响，高枕与君听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"众乐园","author":"杨蟠","text":"昨日折花者，又随蜂蝶来。\n思量妨底事，红蕊续还开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杨蟠","text":"许国莫疑勋业大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题惠州罗浮山","author":"周敦颐","text":"红尘白日无閒人，况有鱼绯系此身。\n关上罗浮閒送目，浩然心意复吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽菊燕贡士 其二","author":"陈襄","text":"有幽斯菊，烨烨其华。\n烝尔髦士，惟其施兮，有显于家。\n往，予无以将兮，惟古之歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观海","author":"陈襄","text":"天柱支南极，蓬山压巨鳌。\n云崩石道险，潮落海门高。\n客馆闻鼍鼓，秋风忆蟹螯。\n倚栏望乡墅，千里楚江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣俞食笋","author":"韩维","text":"犀皮包玉束作斤，有馈为子盘中珍。\n爱之不欲食客众，夜密置酒呼其邻。\n作诗盈纸颇瑰怪，胄出恐是龙之真。\n流涎溢吻极称诧，两都无芹吴无莼。\n念我故园事栽插，独于此物尤勤勤。\n春芽怒迸地皮裂，采掇入撰无虚晨。\n独留晚出补林罅，几日不见长过人。\n新梢秀叶动清景，荫藉往往铺吾茵。\n而今安得复致此，腹饱藜苋身埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐中呈宁极","author":"韩维","text":"归马系庭柏，张灯开酒樽。\n留连遥夜饮，款曲故人言。\n清笑非无适，长歌未觉喧。\n它时相望意，雪屋倚云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵答钦之学士草堂见寄","author":"韩维","text":"白首徘徊玷善藩，惭君先解左鱼还。\n未同一笑清樽侧，独想高眠翠竹间。\n素节消馀宁复壮，妄情休尽只馀闲。\n田园雨足官无事，趣驾何妨慰病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐道示长句辄次韵","author":"韩维","text":"光阴不觉成陈迹，事变何尝有定期。\n身外闲愁无自入，饮中欢兴未全衰。\n编排暑后新投酒，检点秋来合唱辞。\n更欲邀君浮画舫，藕花菱蔓满西池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张念七得科见寄","author":"韩维","text":"少年初见一经横，籍籍文场蔼俊名。\n抗志直思追二祖，得官今乃后诸生。\n赐袍便欲欺芳草，贺酒犹能及落英。\n我亦林泉有归兴，待君吟啸乐升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花承露红","author":"韩维","text":"蕣英憔悴藕花零，篱下红芳特地荣。\n妍丽顿添秋气象，欢娱潜动老心情。\n武陵溪上分颜色，洛水园中得号名。\n为此径须判一醉，缓调丝管促飞觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招致仕诸君饮","author":"韩维","text":"闲里高官物外身，追欢高会及良辰。\n菊含晓露精神健，酒入凉天气味醇。\n双管龙吟清彻汉，四弦莺语巧回春。\n樽前不用存形迹，同是乡闾白发人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和厚卿值风阻游范园","author":"韩维","text":"光禄名园惨淡中，十年樽酒与谁同。\n有秋方毕随轩雨，未节俄惊落帽风。\n坐想池塘生碧草，独行阶砌惜芳丛。\n阳春绝唱知难和，白首空搔两鬓蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾通直","author":"韩维","text":"误落尘中四十年，乞归骸骨喜安全。\n庙廊论道徒虚耳，彝鼎铭勋愧缺然。\n一视荣枯真若梦，两忘喧寂始知禅。\n金仙秘典容传玩，似与君家有旧缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依前韵和朱朝奉 其一","author":"韩维","text":"起坐终朝在一堂，兴来宾至更衔觞。\n逢春预展新花槛，扶老时翻旧药囊。\n心虑已能安止止，声名何用渐章章。\n少游有志今方遂，坐守松楸不去乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依前韵和朱朝奉 其二","author":"韩维","text":"揽辔宿心终不效，坠车馀骨老犹全。\n居仁由义吾之素，处顺安时理则然。\n名教地中真有乐，色声头上岂非禅。\n樽前醉客应相笑，一曲悲歌几处缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雪呈安观文谢惠酒","author":"韩维","text":"雪花盈尺覆春田，太守勤民庆有年。\n介任袁安从放卧，寒矜枚叟不加延。\n桃根度曲今何在，柳絮裁诗久未传。\n内集岂宜虚旧贶，为公举白抹朱弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自欢","author":"韩维","text":"逢春何事有咨嗟，短发昏瞳对好花。\n欢□到来惟止暂，酒分加处更论些。\n一箪□□惭颜氏，百指笙歌类白家。\n送老忘形乐吾分，为谋岂不是良邪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和厚卿饮西湖时小侄同赴","author":"韩维","text":"劳生从宦意多违，常恨交亲会合稀。\n父子相随今不间，主宾交错暮忘归。\n微波稳送兰船度，迟景徐看玉斝飞。\n尽日清欢犹有憾，无人为唱缕金衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侍讲侄告满还京师以诗送之","author":"韩维","text":"身随群动各东西，别日常多见面稀。\n老去心情如水淡，暂同樽酒惜花飞。\n仲容任达常知退，公子成名莫忘归。\n共说无生闲过日，也胜尘土弊朝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雪偶成","author":"韩维","text":"狂风吹虐雪，势欲夺春华。\n委地摧珠贯，依林聚玉沙。\n炉添新炽火，瓶插未残花。\n一尽忘忧酒，胡为浪戚嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西堂前双海棠花","author":"韩维","text":"群芳敛色避妖妍，细叶柔条尽可怜。\n明艳浓常因日暖，清香秘不许风传。\n丽于宫锦如新濯，红甚山樱恐坠燃。\n若使退之堂下有，不应长被五楸牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三哥登太行山","author":"韩维","text":"三朝恩渥重丘山，论报输忠岂易殚。\n移疾暂休丞相笔，坐谩犹著侍臣冠。\n清樽一笑聊相乐，白首分飞益自叹。\n闾里从游应有日，凝然性海绝波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李阁使出守冀州","author":"韩维","text":"天子仁恩抚四陲，边兵坐饱太平时。\n只知使者持金絮，不识将军有鼓鼙。\n君去守藩忧就重，古来忘战志当危。\n祖门事业如南仲，无使家声愧鼎彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华兄清洛阻风","author":"韩维","text":"将相身荣大耋年，高怀先到碧嵩前。\n牙兵不用驱双节，神物应须护两舷。\n锦段已传佳句丽，丝头无复世情牵。\n华颠学士聆风喜，归思如今已浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元夜","author":"韩维","text":"结綵山为对斗魁，和风清月共徘徊。\n喧阗乐曲銮舆近，烜赫袍光雉扇开。\n午夜明缸回照景，晴天华毂发春雷。\n太平时节身无补，惭愧年年游骑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯朱□郎席上作","author":"韩维","text":"狂风冻雨□无时，坐惜良辰乐事违。\n娱老便甘千日面，减春何啻一花飞。\n池塘新涨鱼纹乱，台榭馀寒燕语稀。\n莫唱乡关动离思，为君勤抹醉中归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送安厚卿","author":"韩维","text":"庙廊接武窥风范，藩翰交符识典刑。\n即听攀辕倾里巷，少回征辔燕家亭。\n池边密叶听莺语，庭下残花坠鹤翎。\n不必阳关动离思，西湖柳色正青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪尧夫兄弟一饭清话","author":"韩维","text":"相别相逢似转轮，迹虽辽远意常亲。\n美羹旧手钦元老，盐菜诚心待故人。\n密竹环波宁受暑，残花映叶尚留春。\n逍遥竟日闻嘉话，时节方知自有因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄亳州范待制","author":"韩维","text":"知公道韵厌轩裳，得郡今犹占厉乡。\n馆御列仙兰终馥，迭唱篇章玉竞温。\n开卷不知双泪坠，同时惟止一身存。\n尚欣儒雅风流在，今见吾交二叶亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观灯","author":"韩维","text":"稻收禾熟廪囷盈，民俗熙熙鼓腹行。\n万点华灯虽不夜，十分芳酒是无明。\n齐人有本先循法，爱己何心欲更生。\n更有一机当妙悟，寥寥空外管弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄范侍郎","author":"韩维","text":"行年八十幸安强，半在空门半醉乡。\n能保其身归我里，闵劳以事荷吾皇。\n题诗远寄幽栖地，开卷犹闻燕寝香。\n待得公来花未落，出游方驾酒同觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬刘郎安孺庆八十","author":"韩维","text":"桂起安居濯了缨，结茅凭几坐忘情。\n行年及老渐仁德，终日为欢尽孝诚。\n垂白退休承世范，纡朱列侍愧朝荣。\n近来捉得文章婿，陡觉吾门喜气生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答欧阳通直以予年八十见寄","author":"韩维","text":"人生七十古云稀，况复行年又十期。\n奕世未尝欺暗室，全身又喜遇明时。\n消磨旧业凭黄卷，断送馀光近玉卮。\n佳句祝延诚厚意，不忘交戒是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽歌三首 其一","author":"韩维","text":"远俗长归塞，中原不见兵。\n礼文兴废绝，刑典蹈宽平。\n惨动三危色，哀缠万国情。\n新宫表仁号，尧德恐难名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽歌三首 其二","author":"韩维","text":"玉几宵登寝，灵衣昼入宫。\n追□□□□，□□□儿童。\n松柏三川路，旌旗十月风。\n龙髯攀才得，法泣抱遗弓。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽歌三首 其三","author":"韩维","text":"丹扆中天坐，犹思玉色临。\n威神随日远，德泽在人深。\n谥定圜丘意，功传清庙音。\n谁将良史笔，难状志仁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾太皇太后挽歌二首 其一","author":"韩维","text":"不宰功参帝，无疆道合坤。\n帘帷保明辟，社稷付神孙。\n身蹈姜任德，心通黄老言。\n褒扬存手诏，奚仗史毫论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾太皇太后挽歌二首 其二","author":"韩维","text":"庆绪钟王国，柔仪俪帝家。\n仁深天与性，教盛月增华。\n海上黄金阙，人间素柰花。\n臣民怀慕意，犹冀返云车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽歌三首 其一","author":"韩维","text":"立政追王体，修文迈古风。\n汉仪遵别庙，堂典备新宫。\n却号追前美，更元记屡丰。\n龙髯攀不得，号绝抱遗弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽歌三首 其二","author":"韩维","text":"庠序尊儒术，梯航走德辉。\n玉龙何地驻，金雁不时飞。\n圣治归帘幄，欢讴奉衮衣。\n未嗟轩御远，犹仰百年威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽歌三首 其三","author":"韩维","text":"奥并商宗学，雄趋汉武才。\n难回九清驾，空湛万年杯。\n旂旐翻风远，箫韶度阪来。\n臣民仰遗像，血书有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太皇太后挽歌二首 其一","author":"韩维","text":"沙麓开祥兆，河洲迈德风。\n壮猷咨故老，柔道息诸戎。\n在己仪常损，于民惠少丰。\n谁持太史笔，善述九年功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太皇太后挽歌二首 其二","author":"韩维","text":"云路回仙仗，帘帷閟玉音。\n诒孙为后法，复辟是初心。\n教被宫庭肃，恩沾海宇深。\n常叨侍文陛，白首泪盈襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏元献公挽辞三首 其一","author":"韩维","text":"大策安宗社，高文著庙堂。\n从容造辟议，感激荐贤章。\n貂冕崇廞服，銮舆俯奠觞。\n哀荣岂无有，公德倍辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏元献公挽辞三首 其二","author":"韩维","text":"先帝文章老，东朝羽翼臣。\n风流至公尽，哀愤与时均。\n箫鼓悲将曙，烟云惨不春。\n灵輀归旧治，遗爱泣州民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏元献公挽辞三首 其三","author":"韩维","text":"直道初终见，高情出处同。\n光华两朝内，文字一生中。\n爱酒怜陶散，言诗许赐通。\n平生知己类，洒尽九原风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司徒杜正献公挽辞二首 其一","author":"韩维","text":"旧相论全德，当朝独盛明。\n一身清比玉，万务倚如衡。\n正色排群枉，温辞接后生。\n暂持礼官笔，无以大休声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司徒杜正献公挽辞二首 其二","author":"韩维","text":"谠议开帷幄，仁风逐旆旟。\n生灵瞻用舍，贤俊入吹嘘。\n去位犹忧国，终身不废书。\n传家无异物，惟挂旧安车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太傅李康靖公挽歌三首 其一","author":"韩维","text":"秉哲归元老，宣忠辅至平。\n四蕃流惠爱，三事赖谟明。\n国予哀荣备，人推寿宠并。\n纪言惇史在，犹足庇苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太傅李康靖公挽歌三首 其二","author":"韩维","text":"知止冠早挂，娱闲金屡挥。\n绪言犹在听，英魄遽何归。\n去国箫笳远，迎风旌旐飞。\n邦人慰怀慕，馀庆在缁衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太傅李康靖公挽歌三首 其三","author":"韩维","text":"烜赫三台责，优游二品终。\n干时身有尽，报国意无穷。\n事业传青史，英灵峻紫嵩。\n輀车隔攀恸，悲泪洒秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书令程文简公挽辞二首 其一","author":"韩维","text":"谋猷国称老，政事吏为师。\n始卒君臣分，哀荣将相仪。\n行人看笳鼓，旧部泣旌旗。\n千载伊嵩路，萧萧陇树悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书令程文简公挽辞二首 其二","author":"韩维","text":"政罢机衡后，功成屏翰间。\n未闻持节召，俄见挽丧还。\n画戟空留第，丹旌独出关。\n忠劳不须问，宸篆揭碑颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋元献公挽辞三首 其一","author":"韩维","text":"先帝英雄彀，司空第一人。\n文章通日域，声价重天伦。\n典策归鸿笔，谋猷转大均。\n欲知全盛美，华衮就安轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]