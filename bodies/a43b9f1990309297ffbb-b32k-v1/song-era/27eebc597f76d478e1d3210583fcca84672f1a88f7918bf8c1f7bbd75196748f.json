[{"title":"和陈择之春日四绝 其三","author":"张栻","text":"泗上当时鼓瑟人，风雩岂是乐闲身。\n言外默传千圣旨，胸中长有四时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈择之春日四绝 其四","author":"张栻","text":"日长渐有简编乐，春半已将樱笋来。\n无数青山相慰藉，有时明月共裴徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈择之春日四绝 其二","author":"张栻","text":"年华冉冉春将半，花事匆匆雨满城。\n想复东郊变新绿，未妨携酒趁初晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈择之春日四绝 其一","author":"张栻","text":"花落花开总可怜，峤南亦复好风烟。\n雨馀起我故园梦，漠漠浮鸥水拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和择之赋枯木","author":"张栻","text":"阴崖虎豹露须牙，元是枯槎著藓花。\n不向明堂支万祀，玄冬苦节未须誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和择之赋泉声","author":"张栻","text":"试问今宵涧底声，何如三叹有馀音。\n堂中衲子还知否，月白风清底处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和择之赋霜月","author":"张栻","text":"月华明洁好霜天，遥指层城几暮烟。\n妙意此时谁与寄，美人湘水隔娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和择之福岩回望岳市","author":"张栻","text":"回首尘寰去渺然，山中别是一风烟。\n好乘晴色上高顶，要看清霜明月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和择之韵","author":"张栻","text":"山中好景年年在，人事多端日日新。\n不向青山生恋著，祇缘身世总非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答郑宪分赠米帖","author":"张栻","text":"字中有笔米博士，片纸人间什袭藏。\n好帖袖归终日看，从渠车马闹康庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜得岳后庵僧家园新茶甚不多辄分数椀奉伯承","author":"张栻","text":"小园茶树数十许，走寄萌芽初得尝。\n虽无山顶烟岚润，亦有灵泉一派香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定叟弟频寄黄檗仰山新芽尝口占小诗适灾患亡聊久不得遣寄今日方能写此 其一","author":"张栻","text":"瘴雨昏昏梅子黄，午窗归梦一绳床。\n江南云腴忽到眼，中有吾家棠棣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定叟弟频寄黄檗仰山新芽尝口占小诗适灾患亡聊久不得遣寄今日方能写此 其二","author":"张栻","text":"集云峰顶风霜饱，黄檗洲前水石清。\n不入贡包供玉食，祇应山泽擅高名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岭南荔枝不可寄远龙眼新熟辄以五百颗奉晦叔或可与伯逢共一酌也 其一","author":"张栻","text":"荔子如今尚典刑，秋林圆实著嘉名。\n虽无赪玉南风面，却耐筠笼千里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岭南荔枝不可寄远龙眼新熟辄以五百颗奉晦叔或可与伯逢共一酌也 其二","author":"张栻","text":"手自封题寄故人，聊将风味赴诗唇。\n千年尚忆唐羌疏，不污华清驿骑尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳后步月","author":"张栻","text":"衡岳山边霜夜月，青松影里看婵娟。\n正须我辈为领略，寒入衣襟未得眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所思亭海棠初开折赠两使者将以小诗 其二","author":"张栻","text":"东风著物本无私，红入花梢特地奇。\n想得霜台春思满，一枝聊遣博新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所思亭海棠初开折赠两使者将以小诗 其一","author":"张栻","text":"未须比拟红深浅，更莫平章香有无。\n过雨夕阳楼上看，千花容有此肤腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前日从赵漕饮因得遍观所藏书帖之富既归戏成三绝简之 其二","author":"张栻","text":"旧藏自是承平物，新轴收从古道旁。\n人间好事戒多得，防有雷霆下取将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前日从赵漕饮因得遍观所藏书帖之富既归戏成三绝简之 其三","author":"张栻","text":"今古驱驰翰墨场，何人下笔到颜杨。\n君侯知我有书癖，乞与西台字几行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前日从赵漕饮因得遍观所藏书帖之富既归戏成三绝简之 其一","author":"张栻","text":"乌云夭矫天欲雨，虚堂美荫共徜徉。\n开奁百轴惊传玩，更觉人间六月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南轩木犀","author":"张栻","text":"不随秋月閟天香，冰雪丛中见缕黄。\n却得清寒惜花地，少须梅影慰孤芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南岳庵僧寄上封新茶风味甚高薄暮分送韩廷玉李嵩老","author":"张栻","text":"浮瓯雪色喜初尝，中有祝融风露香。\n径欲与君同晤赏，短檠清夜正相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南杂咏二十首 山斋","author":"张栻","text":"叠石小峥嵘，修篁高下生。\n地偏人迹罕，古井辘轳鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳堤 月榭","author":"张栻","text":"危阑明倒影，面面涌金波。\n何处无佳月，惟应此地多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南杂咏二十首 东渚","author":"张栻","text":"团团凌风桂，宛在水之东。\n月色穿林影，却下碧波中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南杂咏二十首 兰涧","author":"张栻","text":"艺兰北涧侧，涧曲风纡馀。\n愿言植根固，芬芳长慰予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南杂咏二十首 石濑","author":"张栻","text":"流泉自清写，触石短长鸣。\n穷年竹根底，和我读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南杂咏二十首 纳湖","author":"张栻","text":"原原锡潭水，汇此南城阴。\n岸花有开落，水盈无浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南杂咏二十首 卷云亭","author":"张栻","text":"云生山气佳，云卷山色静。\n隐几亦何心，此意相与永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳堤 琮琤谷","author":"张栻","text":"幽谷竹成阴，悬流著石清。\n不妨风月夕，来此听琮琤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南杂咏二十首 蒙轩","author":"张栻","text":"开轩仅寻丈，水竹亦萧疏。\n客来须起敬，题榜了翁书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳堤 濯清亭","author":"张栻","text":"芙蓉岂不好，濯濯清涟漪。\n采之不盈把，怊怅暮忘饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南即事 其五","author":"张栻","text":"茅亭水溜四周遭，花木经春一一高。\n却望西山隔江水，径思一叶泛云涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南即事 其三","author":"张栻","text":"东风吹得绿成阴，积雨初收柳絮轻。\n记取湘中最佳处，橘花开时香满城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南即事 其六","author":"张栻","text":"枕边风雨过今春，起步园林已绿阴。\n更向坡头望湘浦，水云无际绕遥岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南即事 其四","author":"张栻","text":"月榭当湖景最奇，故人千里寄新题。\n背栏看字成相忆，何日能来步柳堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日西兴道中 其四","author":"张栻","text":"一川晓色鹭分去，两岸烟花莺带来。\n径欲卜居从钓叟，绿杨缺处竹门开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日西兴道中 其一","author":"张栻","text":"短短菰蒲绿未齐，河洲水暖雁行低。\n归时须趁春光浅，待得春深意却迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昨过漕台庭前荼蘼盛开已而詹体仁海棠和章及此因用前韵赋两章 其二","author":"张栻","text":"纷纷花片逐风飞，绿幄藏春自一奇。\n不入时人红紫眼，却须我辈与题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昨过漕台庭前荼蘼盛开已而詹体仁海棠和章及此因用前韵赋两章 其一","author":"张栻","text":"玉立春深雪不如，生香透骨雪应无。\n莫遣飘零杂尘土，芬芳留入碧琳腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"是日二使者出游晚凉有作","author":"张栻","text":"疏风细雨随华节，西浦东山总胜游。\n拙守亦忻凉意好，挑灯清坐读春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某敬采民言成六韵为安抚阁老尚书寿伏幸过目 其三","author":"张栻","text":"清坐铃斋公事稀，春来风日更迟迟。\n胸中水镜渠自避，却笑缿筒徒尔为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某敬采民言成六韵为安抚阁老尚书寿伏幸过目 其二","author":"张栻","text":"前时劝君出东郊，父老欢呼望羽旄。\n甘雨便随车马到，眼看沾足遍蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某敬采民言成六韵为安抚阁老尚书寿伏幸过目 其一","author":"张栻","text":"里胥不踏桑麻路，桴鼓长闲花柳村。\n都在邦君和气里，卖刀买犊长儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某敬采民言成六韵为安抚阁老尚书寿伏幸过目 其六","author":"张栻","text":"湘民清晓寿邦君，下客惭无句语新。\n敢述老农歌诵意，一觞持上太夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某敬采民言成六韵为安抚阁老尚书寿伏幸过目 其五","author":"张栻","text":"公今卧护足从容，岂有扁舟欲便东。\n少待政成归帝所，此邦还在化钧中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某敬采民言成六韵为安抚阁老尚书寿伏幸过目 其四","author":"张栻","text":"蜀江东下接襄江，总是当年蔽芾棠。\n此地回旋莫嫌窄，且教春色满三湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送林择之","author":"张栻","text":"遗篇寂寞论心少，一见吾人意已倾。\n冰雪持身金石志，它年事业更光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑宪酒","author":"张栻","text":"晴日南山几杕俱，跻高选胜不须扶。\n也知坐上多佳客，可著青州从事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻方广长老化去有作","author":"张栻","text":"夜入精蓝意自真，上方一笑政清新。\n山僧忽复随流水，可惜平生未了身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益阳南境松杉夹道郁然父老相传忠定张公为邑时所植也其间亦有既剪而复生者作诗属来者护持之","author":"张栻","text":"夹道松杉半老苍，前贤馀泽未应忘。\n君看直干连云起，岂但当年蔽芾棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"张栻","text":"公庭过午无馀事，退食归来默坐时。\n晴日半窗香一缕，阳来消息只心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作","author":"张栻","text":"世情易变如云叶，官事无穷类海潮。\n退食北窗凉意满，卧听急雨打芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崖边积雪取食清甚赋此","author":"张栻","text":"阴崖积雪射寒光，入齿清甘得味尝。\n应是山神知客意，故将琼液沃诗肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚过吴伯承留饮","author":"张栻","text":"推门野路竹毵毵，落日天寒相对谈。\n可是主人风韵别，自斟白酒擘黄柑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"张栻","text":"捲地狂风殿晚春，落花盖水欲成云。\n向人不改旧时面，只有苍官无此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴","author":"张栻","text":"昨日阴云满太空，眼前不见祝融峰。\n晚来风卷都无迹，突兀还为紫翠重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望庐山","author":"张栻","text":"却望庐山倚柁楼，半空宿霭未全收。\n苍然五老独献状，似欲劝人求一游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦乘大舸卧泛江湖波涛甚壮醒乃悟其为雨因成小诗","author":"张栻","text":"平生得意白鸥外，岁晚归心鸿雁俱。\n蕉叶雨声喧晓枕，梦成风楫泛江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨呈安国 其一","author":"张栻","text":"悬知雨意未渠已，一夜檐声到枕间。\n晓上高楼望云气，蛰龙千丈起西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨呈安国 其二","author":"张栻","text":"早秧出陇蚕已丝，眼中一雨正垂垂。\n农家辛苦渠能识，请诵周公七月诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渡兴乐江望祝融","author":"张栻","text":"日上宁容晓雾遮，须臾碧玉贯明霞。\n人谋天意适相值，寄语韩公不用誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游岳寻梅不获和元晦韵","author":"张栻","text":"眼看飞雪洒千林，更著寒溪水浅深。\n应有梅花连夜发，却烦诗句写愁襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登山有作","author":"张栻","text":"上头壁立起千寻，下列群峰次第深。\n兀兀篮舆自吟咏，白云流水此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楚野亭见张舍人题字","author":"张栻","text":"英豪自昔多遗恨，人物于今正渺然。\n来访舍人题字处，淡烟莎草满平川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼","author":"张栻","text":"风雨经旬只闭门，朝来倚槛已春深。\n不知花片飞多少，但觉江城满绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二十二日渡湘登道乡台夜归得五绝 其四","author":"张栻","text":"人来人去空千古，花落花开任四时。\n白鹤泉头茶味永，山僧元自不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二十二日渡湘登道乡台夜归得五绝 其一","author":"张栻","text":"三年不作山中客，才踏船舷眼便明。\n曳杖直登千尺磴，尚欣脚力慰生平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二十二日渡湘登道乡台夜归得五绝 其二","author":"张栻","text":"旧日书堂倚翠屏，只今栋宇尚高明。\n门前恍若闻弦诵，㶁㶁绕墙流水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二日携家城东观梅夜归 其一","author":"张栻","text":"前日看花正薄阴，重来晴日更精神。\n莫教容易飞花片，且放千林自在春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二日携家城东观梅夜归 其三","author":"张栻","text":"晴日东山饱看花，归来野路已昏鸦。\n坡头认得疏篱处，薝卜林中李老家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月二日携家城东观梅夜归 其二","author":"张栻","text":"元自阳春无间断，何人能识化工心。\n梅边把酒日近午，鸟语风微花气深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢邢少连送葡萄豆蔻栽 其一","author":"张栻","text":"君家小圃占春光，眼看龙须百尺长。\n移向楼边并寒井，明年垂实更阴凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢邢少连送葡萄豆蔻栽 其二","author":"张栻","text":"留取园中数亩赊，拟栽灵药谢纷华。\n儿童今日知翁喜，移得君家豆蔻花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢侯彦明惠白莲栽 其二","author":"张栻","text":"青鞋不踏远公社，偶共濂溪嗜好同。\n少待薰风开玉镜，与君来赋月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢侯彦明惠白莲栽 其一","author":"张栻","text":"添得湖光百亩馀，湖边早已成菰蒲。\n更移玉井峰头种，还有花开十丈无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]