[{"title":"山居十首 其六","author":"方岳","text":"我爱山居好，跻攀缭暝烟。\n偃松低可坐，横石劣容眠。\n菊径重阳酒，梅花雪后天。\n一筇吾事足，与世自无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居十首 其四","author":"方岳","text":"我爱山居好，林霏晓未开。\n龙蛇松薜荔，虎兕石莓苔。\n太古云犹在，常时雨亦来。\n暝岩眠处冷，不记到蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居十首 其三","author":"方岳","text":"我爱山居好，閒吟树倚身。\n田园无事日，天地自由人。\n野竹穷三径，山苗草八珍。\n醉归浑不记，黄犊自知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居十首 其二","author":"方岳","text":"我爱山居好，红稠处处花。\n云粘居士屩，藤覆野人家。\n入馔春烧笋，分灯夜作茶。\n无人共襟抱，烟雨话桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居十首 其一","author":"方岳","text":"我爱山居好，林梢一片晴。\n野烟禽谇语，春水柳閒情。\n藓石随行枕，藤花醒酒羹。\n吾诗不堪煮，亦足了吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居十首 其五","author":"方岳","text":"我爱山居好，堆豗忽坐忘。\n草塘银泼剌，庵户铁琅珰。\n只道云藏坞，那知市隔墙。\n人嫌吾寂寞，吾亦笑人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山墅 其三","author":"方岳","text":"且莫嫌穷僻，山居尽自奇。\n候樵分玉蕈，熏穴得香狸。\n杯隽明冰片，崖寒孕雪芝。\n不遗吾一美，惭尔野人为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山墅 其二","author":"方岳","text":"山冱雪云低，荒芜略有蹊。\n逢人多说虎，隔坞忽闻鸡。\n寒剖蜂房户，晴分麦町畦。\n迩来神亦健，薄饭厌羹藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山墅 其四","author":"方岳","text":"近况居然野，称呼只墅民。\n有诗供课最，无债恼比邻。\n性亦无嫌懒，人多不解贫。\n每过田父宿，吾自认吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐 其二","author":"方岳","text":"不寐何为者，閒人最号忙。\n酿方传得法，诗未足成章。\n药草霜多损，寒蔬雨半荒。\n幸无天下责，夔卨在岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋","author":"方岳","text":"晓入云堂已起单，病留法喜太无端。\n当涂月拟中秋见，建邺水仍江上寒。\n与世不供三笑别，暮年转觉四并难。\n鸬鹚杓有铜花绿，最负今宵白玉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌衣园","author":"方岳","text":"吴宫晋苑半桑麻，路入长干野草花。\n秋晚夕阳空巷陌，蓄时燕子几人家。\n不携妓与东山醉，曾赌棋输别墅哗。\n已近重阳风雨少，菊花篱落酒旗斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书戴式之诗卷","author":"方岳","text":"七十行年戴石屏，同时诸老各凋零。\n扁舟归去自渔舍，冷骨秋来更鹤形。\n天地无情头尽白，江山有分眼终青。\n剡溪定有人乘兴，月下柴门不用扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月初四大水","author":"方岳","text":"山云一夜雨，溪涨疾于飞。\n小市通为壑，幽居半及扉。\n木披龙有迹，墙断鹤无归。\n书帙方狼籍，谁看旧钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以梅送王尉 其二","author":"方岳","text":"才有骚情例合癯，只销清供老伊蒲。\n孔方兄自非吾党，木上座堪寻酒徒。\n寄子梅花逢驿使，败人诗兴苦催逋。\n夜寒梦到西窗竹，明月一床冰一壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以梅送王尉 其一","author":"方岳","text":"雪涧偶逢山泽癯，相携茅屋对团蒲。\n古心不为世情改，老气了非流俗徒。\n三读离骚多楚怨，一生知己只林逋。\n诗成不值渠为伴，持醉主人双玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕","author":"方岳","text":"茅屋相看冷似冰，蒲团孤坐澹于僧。\n数行老墨閒居赋，一炷寒灯耐久朋。\n时异不供三太息，吾衰何啻百无能。\n后山亦有梅花月，不复年时兴可乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕雪用韵","author":"方岳","text":"山蹊一色轻明玉，遮尽青青印屐苔。\n元夕不知今日是，春愁政用此时来。\n年华鼎鼎双蓬鬓，身世悠悠一酒杯。\n好事断无人问字，竹门隔坞不须开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"方岳","text":"坎止流行一任他，年华其奈老夫何。\n贫知醉有回天日，早得閒为却日戈。\n野烧青归烟髣髴，溪痕晴涨雪坡陀。\n屠苏只对梅花饮，茅屋竹篱春意多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"方岳","text":"钓寂耕閒老病身，何堪附翼与攀鳞。\n山中是处有诗思，天上自来无故人。\n岁事共知双鬓雪，梅花又过一年春。\n晴妍已有溪村兴，牛下柴车或可巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日雨 其一","author":"方岳","text":"那得工夫作往还，一犁取日破荒湾。\n春今又绿山中草，酒不能朱镜里颜。\n六十只馀三岁在，百年亦是霎时间。\n村村雨色冥濛外，已觉天公露一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日雨 其二","author":"方岳","text":"云泥隔断拜年人，天自怜予老病身。\n荠菜共挑元日雨，梅花未放去年春。\n风烟不尽惟吾老，造化无他只此仁。\n小试园林栽接手，山中亦是一洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内翰程端明挽诗 其二","author":"方岳","text":"旋踵之间政事堂，挂冠神武一何忙。\n松风醉卧山前后，梅障留题春在亡。\n八十磻溪才事业，百年落水自平章。\n老天肯使斯文坠，剑履已空笙鹤翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内翰程端明挽诗 其一","author":"方岳","text":"倒泻银河洗肺肝，初传冰句落人间。\n吾州谁继龙溪老，内相宁论豹尾斑。\n汲冢以来书尽读，商盘而上笔追还。\n岂无名字藏金匮，只与君王丐一閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台","author":"方岳","text":"白发久孤鹦鹉杯，碧梧自老凤凰台。\n管夷吾亦仅知许，李谪仙今安在哉。\n城郭是非秋雨外，江山形胜暮潮来。\n小留只等中秋月，且放青冥万里开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝耕 其一","author":"方岳","text":"郡如斗大亦何堪，耕雨锄烟亦饱谙。\n共话桑麻真有味，久抛蓑笠得无惭。\n野田春水自深浅，晴日鸟声时两三。\n安得一牛横短笛，南山之北北山南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天基锡宴致语口号","author":"方岳","text":"春绿晴融太液池，好风都在万年枝。\n宫墙璆玉韶音远，合殿珠环晓漏迟。\n天近六龙扶翠辇，云深五凤挟瑶池。\n镐京长启需云宴，先奏端平第一诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太庙斋宿","author":"方岳","text":"正尔梅蒸苦翳霾，翛然清庙得心斋。\n云连魏阙天尤近，树暗吴山雨亦佳。\n黄道正中垂日月，赤囊犹遽接江淮。\n思皇列考神灵在，傥许孤臣借玉阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月岩","author":"方岳","text":"怪石堆云矗大空，女娲鍊出广寒宫。\n一轮常满阴晴见，万古无亏昼夜同。\n捣药声繁驱白兔，漏天孔正透清风。\n光明自照如来境，肯学姮娥西复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀 其一","author":"方岳","text":"香到人间香更幽，月明风露正飕飕。\n天开金粟如来藏，人立广寒宫殿秋。\n几许多清冰脑片，一些来大雪花头。\n此生若并凡红紫，安得奇芬死不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀 其三","author":"方岳","text":"羽觞和月嚼冰黄，自笑诗肠老更刚。\n四出雪花些小大，五千书传一齐香。\n君从底处移仙籍，日饮无何作醉乡。\n风露清寒付谁可，携归天禄校偏旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀 其二","author":"方岳","text":"叶叶寒清粟粟黄，何年月斧落吴刚。\n秋风误到人间世，幽壑难藏天上香。\n渺立尘氛群玉府，独餐沆瀣碧云乡。\n生来不并凡红紫，合在蟾蜍砚滴旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水月园送王侍郎","author":"方岳","text":"送别孤山步绕湖，阑干尽处倚菰蒲。\n翁之乐者山林也，客亦知夫水月乎。\n万事不如归自好，百年聊与醉为徒。\n藕花初醒莼丝老，唤住罾船鲙腹腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牛庵后古松五株","author":"方岳","text":"山中老子一间屋，屋后秦人五大夫。\n丘壑得专閒日月，衣冠甚伟古眉须。\n计今当是百年物，著我添成六老图。\n已有茯苓巢可俯，待烹石鼎疗诗癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牛庵睡起","author":"方岳","text":"自束生刍起饭牛，隔林扣角更深幽。\n半分不得诗书力，一饭常存?亩忧。\n老去有肠堪贮酒，生来无骨可封侯。\n开荒厓下田无几，种秫宁须与妇谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王母望阙致语口号","author":"方岳","text":"晓跸初催上寿班，东风连夜致人间。\n九重春醉金鸾殿，万岁声幽碧玉环。\n大地山河年谷熟，太平日月羽书闲。\n明朝第一番花吉，并与琼幡下虎关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风作","author":"方岳","text":"年光何啻蛇赴壑，仕宦略如鱼上竿。\n畴昔本无温饱志，归来只作等閒看。\n人间万事风涛急，雨外一蓑天地宽。\n潮落海门烟树绿，举头已不见长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰溪晚泊","author":"方岳","text":"岸岸芦花白，空江多月明。\n一帘秋色老，千里暮云平。\n寒入霜前韭，香传雨后橙。\n烦诗题品看，此酒旧知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出关","author":"方岳","text":"江雨正冥冥，江鸥聚晚汀。\n云深城阙丽，潮落海门青。\n宇宙双蓬鬓，江湖几驿亭。\n不须关卒逻，吾亦厌铜腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古岩","author":"方岳","text":"廿年前此借僧单，留得松声入梦寒。\n岁月可惊吾辈老，风烟仍作故人看。\n山泉与佛结茶供，石屋无人蚀藓瘢。\n亭角雨晴秋更碧，断云片片泊栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶秘书致白龙涎","author":"方岳","text":"闭门老去著幽禅，趺坐时参柏子烟。\n书册懒随黄犊角，岩霏宁识白龙涎。\n蓬莱山复在何处，杞菊赋今谁与传。\n不道宝书天尺五，肯分风月到林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四用韵答才老","author":"方岳","text":"江山带郭数家村，穷僻谁敲月下门。\n谢绝往来缘事尽，争论胜负为棋喧。\n爱閒宁有万金产，投老当誇两足尊。\n不惜梅花三寸雪，并令回施给孤园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归来馆成再用韵","author":"方岳","text":"后门穿过荷葭坞，春草池塘一径苔。\n尽废秫田妨醉去，旋苫山馆号归来。\n知无骨相取金印，莫与春秋著玉杯。\n自有梅花可人意，南枝开了北枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧传有客谒一士夫题其刺云琴棋诗酒客因与谈笑戏成此诗","author":"方岳","text":"痴书到底成何事，只有穷愁上鬓丝。\n铸错空糜六州铁，补鞋不似两钱锥。\n谁欤莫逆溪山我，幸甚无能诗酒棋。\n依旧挂书牛角去，笑渠到底是书痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月尽山间梅花犹有未放者","author":"方岳","text":"南枝寒尽著花迟，入我新年第一诗。\n明月向人应有语，老天于物本无私。\n自逋之后谁相得，未雪以前春不知。\n尽让世间凡草木，再三守此岁寒姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜洲晚渡","author":"方岳","text":"天地中间一叶舟，与鸥等是此生浮。\n江淮千里水天碧，南北六朝烟树愁。\n浪挟禹功吞巨海，寺骑娲石碍中流。\n渔蓑不涉兴亡事，自醉自醒今白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用赵尉韵寄题约山楼","author":"方岳","text":"可人期不至，楼外有佳山。\n几点寒林画，一帘秋水环。\n只烦诗五字，相与月三间。\n贵贱交情薄，何妨自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用程兄韵奉诸公题跋还人","author":"方岳","text":"老砚生苔尔许时，谁怜官事落儿痴。\n江湖十载春无据，天地一舟归有期。\n客有相从蜗壳语，诗来云受鹤山知。\n皮毛剥落惟真实，那用诸公绝妙辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵简赵尉无牡丹","author":"方岳","text":"乱山深处有谁来，诗砚荒寒一寸埃。\n特未可知天下事，断无相负掌中杯。\n人传梅隐近入幕，我但糟丘高筑台。\n竹友松朋真耐久，可曾将口问花魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹭亭","author":"方岳","text":"荻花芦叶老风烟，独上秋城思渺然。\n白鹭不知如许事，赤乌又复几何年。\n六朝往事秦淮水，一笛晚风江浦船。\n我辈人今竟谁是，只堪渔艇夕阳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石孙受命","author":"方岳","text":"圣泽如春雨露宽，弃遗犹不绝衣冠。\n万钉宝带翁无分，一幅花绫孙有官。\n得免白丁何啻足，亲曾黄甲不堪看。\n九经幸自澜翻熟，但守青灯雪屋寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石孙试童子郡广文赠之诗代赓为谢 其二","author":"方岳","text":"命穷久已付之天，草木閒兮月一川。\n无地可容携锸处，有孙犹在佩觿年。\n老夫耄矣耕方熟，小子识之攻益坚。\n万岁石场今尔耳，当家衣钵底须传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石孙试童子郡广文赠之诗代赓为谢 其一","author":"方岳","text":"不缘青紫不明经，科目多惭旧两生。\n三豕鲁鱼曾未学，一蜗蛮触已争名。\n栋梁材欲丘山重，沧海珠遗星斗明。\n未必童乌能辨此，乃翁先已荷陶成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"曹勋","text":"初信东风入綵幡，自挑雪荠饤春盘。\n土牛又送一年老，野鹤不知三径寒。\n筋力尚堪耕绿野，鬓毛并欲挂黄冠。\n无人共跨南山犊，更作寻花问柳看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"方岳","text":"诗傥穷人莫送穷，但穷诗亦不须工。\n银幡雪柳人何似，翠缕琼丝菜则同。\n百事到头惟早白，一年弹指又春红。\n渔溪亦喜溪冰泮，新绿生肥撼钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"方岳","text":"花柳胚胎午夜风，一尊聊与破红封。\n醉馀安用淄渑口，妙处元无泾渭胸。\n纸帐不知寒浩荡，银幡自爱雪髼松。\n小楼认得春来处，晴霭苍茫南北峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春前一日雪 其一","author":"方岳","text":"入冬妍暖几兼旬，明日银幡岁又新。\n绝意六花无复腊，等閒一尺不胜春。\n老天咳唾何难事，瘦地耕锄亦幸民。\n径就梅梢嚼清冷，相如渴肺久生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春前一日雪 其二","author":"方岳","text":"历眼看看剩浃旬，山河大地一齐新。\n不成过腊都无雪，只隔明朝便是春。\n夜半有谁过剡曲，年丰无处不尧民。\n草亭只在梅花外，知与人间隔几尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买菊栽","author":"方岳","text":"新绿丛丛手自培，东篱准拟白衣来。\n荷锄政欠半畦雨，抱瓮空遗满径苔。\n说与园丁重九近，毋烦老子再三催。\n径须寻觅谁家有，带土移将一两栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用汪少卿韵","author":"方岳","text":"毕竟春晴好，杨花也送行。\n驿程寒冉冉，江树晓晶晶。\n水长船能驶，诗多担转轻。\n江湖吾倦矣，茅屋几时成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵","author":"方岳","text":"终须西塞老渔村，抵用南昌隐市门。\n时序略如飞鸟过，世终何啻聚蚊喧。\n竹其安否六太息，梅自癯然三可尊。\n贫味却愁儿辈觉，未妨壁立病文园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕宗卿以病谢客明日约饭则予行矣诗以代简","author":"方岳","text":"长松落落雪霜姿，欲往从之我所思。\n剥啄始知摩诘病，推敲谁话贾僧诗。\n可羞吾事蚊䖟等，坐失先生鸡黍期。\n细雨断云秋晚路，此情犹有菊花知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"方岳","text":"桃花红雨柳花绵，风物愁予重惘然。\n满目江山分楚越，旧游池馆锁尘烟。\n朝云漠漠今安在，夜月荒荒空自圆。\n只有雪衣孤鹤在，竹间曾共耸吟肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有蟹无酒","author":"方岳","text":"左手持螯欠酒杯，枉烹郭索亦冤哉。\n老饕借尔为诗地，多病凭谁作睡媒。\n归钓兴随春浩荡，独醒人与月徘徊。\n渊明未必穷于我，薄有公田办秫材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次严陵","author":"方岳","text":"二月寒如此，杨花不受春。\n路生寻店早，家近梦归频。\n白鸟无尘事，青山自故人。\n几时茅屋下，卜与尔为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次梁倅录囚上饶","author":"方岳","text":"此老清如许，宁求使节知。\n檄分风宪重，山到月岩奇。\n秋色深宜雨，寒花并入诗。\n圣朝本仁厚，鼠辈亦吾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]