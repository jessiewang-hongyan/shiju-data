[{"title":"菩萨蛮 其十五 次莹中元归韵","author":"舒亶","text":"白蘋洲渚垂杨岸。\n藕花未放青蒲短。\n斜日画船归。\n背人双鹭飞。\n醉眠金马客。\n不道风尘隔。\n红影上窗纱。\n小庭空落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"舒亶","text":"三年江上风吹泪。\n夭桃艳杏无春意。\n今日欲开眉。\n那堪更别离。\n莫折长亭柳。\n折尽愁依旧。\n只有醉如狂。\n人生空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十四","author":"舒亶","text":"流年又见风沙送。\n钧天回首清都梦。\n塞雁几时归。\n镜中双鬓非。\n绿袍同冷暖。\n谁道交情短。\n愁斛若为量。\n还随一线长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十一","author":"舒亶","text":"绮栊深闭桃园曲。\n刘郎老向花间宿。\n笑脸抹流霞。\n心知是小琶。\n纤纤垂素玉。\n掠鬓春云绿。\n弹了醉思仙。\n小窗红日偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"舒亶","text":"画檐细雨偏红烛。\n疏星冷落排寒玉。\n赌得碧云篇。\n金波更涉船。\n樽前当日客。\n行色垂杨陌。\n天阔水悠悠。\n含情独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十七 别意","author":"舒亶","text":"江梅未放枝头结。\n江楼已见山头雪。\n待得此花开。\n知君来不来。\n风帆双画鹢。\n小雨随行色。\n空得郁金裙。\n酒痕和泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"舒亶","text":"杜鹃啼破江南月。\n香风扑面吹红雪。\n赋就缕金笺。\n黄昏醉上船。\n年华双短鬓。\n事往情何尽。\n明日各天涯。\n来春空好花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十二 次张秉道韵","author":"舒亶","text":"真珠酒滴琵琶送。\n行云旧识巫山梦。\n空得醉中归。\n老来心事非。\n江梅含日暖。\n照水花枝短。\n密叶似商量。\n向人春意长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"舒亶","text":"楼前流水西江道。\n江头水落芙蓉老。\n画鼓叠凉波。\n凭栏颦翠娥。\n当年金马客。\n青鬓芦花色。\n把酒感秋蓬。\n骊歌半醉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"舒亶","text":"柳桥花坞南城陌。\n朱颜绿发长安客。\n雨后小池台。\n寻常载酒来。\n马头今日路。\n却望城西去。\n斜日下汀洲。\n断云和泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"舒亶","text":"画船槌鼓催君去。\n高楼把酒留君住。\n去住若为情。\n西江潮欲平。\n江潮容易得。\n只是人南北。\n今日此尊空。\n知君何日同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其八 送奉化知县秦奉议","author":"舒亶","text":"一回别后一回老。\n别离易得相逢少。\n莫问故园花。\n长安君是家。\n短亭秋日晚。\n草色随人远。\n欲醉又还醒。\n江楼暮角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其九","author":"舒亶","text":"樽前休话人生事。\n人生只合樽前醉。\n金盏大如船。\n江城风雪天。\n绮窗灯自语。\n一夜芭蕉雨。\n玉漏为谁长。\n枕衾残酒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十六 湖心寺席上赋茶词","author":"舒亶","text":"金船满引人微醉。\n红绡笼烛催归骑。\n香泛雪盈杯。\n云龙疑梦回。\n不辞风满腋。\n旧是仙家客。\n坐得夜无眠。\n南窗衾枕寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其六 次刘郎中赏花韵","author":"舒亶","text":"朱帘乍卷层烟起。\n露华深浅初疑洗。\n困倚玉阑风。\n绮罗知几重。\n向人如有意。\n不醉何时醉。\n便得一枝红。\n犹胜两鬓空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其七 席上送寅亮通直","author":"舒亶","text":"小池山额垂螺碧。\n绿红香里眠鸂鶒。\n波面翠云开。\n仙槎天上来。\n吹将红日落。\n懊恼严城角。\n风月此时情。\n知君华发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十八 次韵","author":"舒亶","text":"香波绿暖浮鹦鹉。\n黄金捍拨么弦语。\n小雨落梧桐。\n帘栊残烛红。\n人生闲亦好。\n双鬓催人老。\n莫惜醉中归。\n醒来思醉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"散天花 次师能韵","author":"舒亶","text":"云断长空叶落秋。\n寒江烟浪静，月随舟。\n西风偏解送离愁。\n声声南去雁，下汀洲。\n无奈多情去复留。\n骊歌齐唱罢，泪争流。\n悠悠别恨几时休。\n不堪残酒醒，凭危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 其一 重阳前席上次元直韵","author":"舒亶","text":"寒日穿帘，澄江凭槛，练光浮动馀霞。\n蓼汀芦岸，黄叶衬孤花。\n天外征帆隐隐，残云共、流水无涯。\n登临处，琼枝潋滟，风帽醉敧斜。\n丰年，时节好，玉香田舍，酒满渔家。\n算浮世劳生，事事输他。\n便恁从今酩酊，休更问、白雪笼纱。\n还须仗，神仙妙手，传向画图夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 其二 后一日再置酒次冯通直韵","author":"舒亶","text":"红叶飘零，寒烟疏淡，楼台半在云间。\n望中风景，图画也应难。\n又是重阳过了，东篱下、黄菊阑珊。\n陶潜病，风流载酒，秋意与人闲。\n霞冠。\n敧倒处，瑶台唱罢，如梦中还。\n但醉里赢得，满眼青山。\n华发看看满也，留不住、当日朱颜。\n平生事，从头话了，独自却凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 其三 送权府苏台道宗朝奉","author":"舒亶","text":"阊阖天门，芙蓉春殿，几年目断鸡翘。\n短蓬秋鬓，端幸倚琼瑶。\n南圃花边小院，西湖畔、云底双桥。\n归时节，红香露冷，月影上芭蕉。\n明朝。\n那可望，旗亭烟草，柳渡寒潮。\n但万户千门，恨客歌樵。\n戏彩光浮衮绣，听鸣珂、响逼云霄。\n应回首，绮裘醉客，还是独吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其三 蒋园醉归","author":"舒亶","text":"重帘小阁香云暖。\n黛拂梳妆浅。\n玉箫一曲杜韦娘。\n谁是苏州刺史、断人肠。\n醉归旋拨红炉火。\n却倚屏山坐。\n银缸明灭月横斜。\n还是画楼角送、小梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其二 周园欲雪","author":"舒亶","text":"酒边陡觉罗衣暖。\n独倚黄昏看。\n寒鸦两两下楼东。\n著处暗云垂地、一重重。\n红炉欢坐谁能醉。\n多少看花意。\n谢娘也拟殢春风。\n便道无端柳絮、逼帘栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其一 寄公度","author":"舒亶","text":"芙蓉落尽天涵水。\n日暮沧波起。\n背飞双燕贴云寒。\n独向小楼东畔、倚阑看。\n浮生只合尊前老。\n雪满长安道。\n故人早晚上高台。\n赠我江南春色、一枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙 吕使君饯会","author":"舒亶","text":"教来歌舞，接成桃李。\n尽是使君指似。\n如今装就满城春，忍便拥、双旌归去。\n莺心巧啭，花心争吐。\n无计可留君住。\n两堤芳草一江云，早晚是、西楼望处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"舒亶","text":"深炷熏炉扃小院。\n手捻黄花，尚觉金犹浅。\n回首画堂双语燕。\n无情渐渐看人远。\n相见争如初不见。\n短鬓潘郎，斗觉年华换。\n最是西风吹不断。\n心头往事歌中怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其一 置酒别公度座间探题得梅","author":"舒亶","text":"雪后江城红日晚。\n暖入香梢，渐觉玲珑满。\n仿佛临风妆半面。\n冰帘斜卷谁庭院。\n折向樽前君细看。\n便是江南，寄我人还远。\n手把此枝多少怨。\n小楼横笛吹肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉花阴 其二 越州席上官妓献梅花","author":"舒亶","text":"月幌风帘香一阵。\n正千山雪尽。\n冷对酒尊傍，无语含情，别是江南信。\n寿阳妆罢人微困。\n更玉钗斜衬。\n拟插一枝归，只恐风流，羞上潘郎鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉花阴 其一 试茶","author":"舒亶","text":"露芽初破云腴细。\n玉纤纤亲试。\n香雪透金瓶，无限仙风，月下人微醉。\n相如消渴无佳思。\n了知君此意。\n不信老卢郎，花底春寒，赢得空无睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山寺","author":"舒璘","text":"山谷幽深锁梵宫，千章灌木郁茏葱。\n香浮古篆半檐雾，茶漱清泉两腋风。\n鹤伴老僧归夕照，山留行客驻霜枫。\n前朝阁阁浑秋草，眺望悽然碧岭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 送鄞令李易初","author":"舒亶","text":"折柳门前鹦鹉绿，河梁小驻归船。\n不堪华发对离筵。\n孤村啼鴂日，深院落花天。\n文采弟兄真叠玉，赤霄去路谁先。\n明朝便恐各风烟。\n江山如有恨，桃李自无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"舜禅师","text":"寻求就理两俱愆，不涉二途病亦然。\n孰谓个中端的处，椎胸贫子一分钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"舜禅师","text":"无端被谮枉遭迍，卷载有馀作俗人。\n今日再归三峡寺，几多道好几多嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"葛公绰","text":"为是山堂似草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丈亭馆","author":"葛天民","text":"青山历历映江流，半是明州半越州。\n亭下寒潮亭上客，不知来往几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小舟","author":"葛天民","text":"万顷波中独钓身，短仓低屋旧丝纶。\n自怜清夜歌明月，谁共沧洲采白蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕","author":"葛天民","text":"元宵有月便无愁，已是新年第一筹。\n说与素娥从此去，只须依样做中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕西陵桥观月","author":"葛天民","text":"年头半月雪漫漫，养就姮娥玉一团。\n老子今宵奇绝处，西陵桥上独凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月二十七雨中过苏堤","author":"葛天民","text":"一堤杨柳占春风，柳外群山细雨中。\n人苦未晴浑不到，只宜老眼看空濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月二日","author":"葛天民","text":"小巷春阴独掩扉，峭寒著尽过冬衣。\n老来情绪无多子，禁得梅花似雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井","author":"葛天民","text":"龙护深潭草木昏，断碑元祐典刑存。\n蜀仙已去吴僧少，岭上松篁亦断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春初二绝 其二","author":"葛天民","text":"初交二月草蒙茸，邻里纷纷去折蓬。\n柳下闭门非懒出，苦无筋力趁儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春初二绝 其一","author":"葛天民","text":"落梅如雪雨如麻，最怕春寒是杏花。\n病后不能涓滴饮，可怜芳信到贫家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江山","author":"葛天民","text":"连天芳草雨漫漫，赢得鸥边野水宽。\n花欲尽时风扑起，柳绵无力护春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨渡芦像","author":"葛天民","text":"一言已出驷难追，赖得君王放过伊。\n杨子江心杭折苇，浪头何似问头危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事用天竺韵","author":"葛天民","text":"寒食少逢天气佳，十朝九日雨如麻。\n新巢唯有燕生子，小巷已无人卖花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竺涧梅","author":"葛天民","text":"龙脊桥边鹤膝幽，一枝斜亚水横流。\n自从识破胡笳曲，吹彻黄昏不解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中郊外","author":"葛天民","text":"暖气先回宿草根，青青行可藉芳尊。\n未须著意催花柳，且为乾坤补烧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尝北梨","author":"葛天民","text":"每到年头感物华，新尝梨到野人家。\n甘酸尚带中原味，肠断春风不见花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看山","author":"葛天民","text":"我本田夫作比丘，也知骑马胜骑牛。\n如今马上看山色，不似骑牛得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘僧善行","author":"葛天民","text":"西望群山碧入吴，故人一笠片云俱。\n东风不断村村柳，展尽阳关送客图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望越怀亲","author":"葛天民","text":"高帝陵边我故庐，白云惨淡带苍梧。\n归心政与江流动，更著青山隔岸呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日访白石不值","author":"葛天民","text":"花荠悬灯柳插檐，老怀那得似饧甜。\n画船已载先生去，燕子无人自入帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"船子钧滩","author":"葛天民","text":"泽国茫茫水接天，孰云无法与人传。\n见成风月难回避，尽在华亭一钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上观柳偶记龙泉先生勾春柳一丝之句感而有述","author":"葛天民","text":"断槎无叶又无枝，得似勾春柳一丝。\n不是画船栖泊处，白鸥飞下立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上新秋","author":"葛天民","text":"十里荷风盖尽倾，城中忆杀水边清。\n催诗末用西湖雨，且送新凉入帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡少","author":"葛天民","text":"睡少秋难晓，吟多食愈贫。\n南柯无近阙，差尽梦中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠眇目道人说相","author":"葛天民","text":"道人只具一只眼，觌面全提格外机。\n尘里神仙谁做得，归来试举问麻衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳呈严叟","author":"葛天民","text":"时俗常谈已断霜，雨寒翻著絮衣裳。\n花枝照眼堂堂去，茗椀关心故故香。\n杨柳稍传莺割据，茅茨敢望燕商量。\n旧游莫诵兰亭语，自觉中年易感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小亭","author":"葛天民","text":"小亭终日对幽丛，兀坐无言似定中。\n苍藓静连湘竹紫，绿阴深映蜀葵红。\n猫来戏捉穿花蝶，雀下偷衔卷叶虫。\n斜照尚多高柳少，明年更欲种梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小峰行乐却望北山","author":"葛天民","text":"霜高群木落，湖上数峰秋。\n野笛归牛径，烟蓑宿鹭洲。\n望中多隐约，佳处小迟留。\n百岁无虚日，能堪几度游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小隐自题","author":"葛天民","text":"水拍荒篱外，山攒落照边。\n鸦鸦乘犊去，鸭鸭伴鸥眠。\n思淡秋云薄，情高陇月圆。\n武陵知避世，初不为求仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中题古墓","author":"葛天民","text":"冢荒无树亦无碑，土面砖痕似灼龟。\n坏道尚存翁仲守，传家知是子孙谁。\n又成东海终难料，欲锢南山最可悲。\n要寄此情浮世去，临流说与落花知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开井","author":"葛天民","text":"小圃新穿土，中藏一丈空。\n山腰泉脉透，井口树阴蒙。\n浇药先资用，煎茶已见功。\n甘凉羞自荐，汲许四邻同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙","author":"葛天民","text":"玉涧金寒窈窕身，翩翩翠袖挽青春。\n水晶宫里成仙女，香醉山中得道人。\n朔雪几回埋不死，南洲一出净无尘。\n朴翁老矣谁同调，相对无言意转亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月十二日夜姚江","author":"葛天民","text":"断岸春风峭，江空夜雨清。\n萧疏蓬上点，彷佛叶间声。\n今古双眸冷，乾坤一棹轻。\n鬓从湖海白，谁识谢郎情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次紫芝韵","author":"葛天民","text":"钦羡私居好，楼深夏必凉。\n小窗通远岫，古木蔽斜阳。\n露槛安花斛，尘编满竹床。\n如君清到骨，只合静焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹","author":"葛天民","text":"此君别后稍添丁，留得清风镇户庭。\n老鬓不禁霜点缀，旧邻多似树凋零。\n一竿带雪寒垂钓，数亩连苔昼掩扃。\n此话有谁堪委似，几回无语向青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖泛舟入灵隐山","author":"葛天民","text":"晴岚漠漠水溶溶，落叶遮船翠盖重。\n秋色尽为渔者占，山光多向道人浓。\n云连合抱前村树，涧绕飞来小朵峰。\n送罢夕阳迎素月，楼台高下自鸣钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]