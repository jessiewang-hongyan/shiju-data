[{"title":"送杜密学赴并州","author":"苏舜钦","text":"维帝私明哲，遥遥世可论。\n风流擅南国，文采续高门。\n才美趋贤路，名雄出帝阍。\n雍容初入幕，烜赫已开藩。\n黠吏腹心溃，疲民襦裤温。\n谳刑曾揽辔，按俗亦飞轩。\n倚注宸襟切，淹回物论喧。\n朔区官益峻，宪府望弥尊。\n除弊朝之急，于时孰肯言。\n议高心不挠，补外众为冤。\n西雍新恩重，中台故事存。\n政行殊有体，化洽密无痕。\n尺诏来丹扆，双符换太原。\n具装明晚野，大旆卷朝暾。\n惠爱留关辅，风威入塞垣。\n安车行急召，想望慰元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送家静及第后赴官清水","author":"苏舜钦","text":"几年尘土客京华，一日春乘犯斗槎。\n梦好夜归全蜀道，眼明朝宴上林花。\n白头佐邑非为晚，蓝绶还乡亦可誇。\n况有雄图看悟主，莫伤孤宦向天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"串夷","author":"苏舜钦","text":"区区黠虏敢狂呼，遣使峨冠谒上都。\n辄出封章辞国命，妄传声势困军须。\n闭之塞漠为良策，啖以民膏是失图。\n淳俗易摇无自挠，每闻流议一长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静胜堂夏日呈王尉","author":"苏舜钦","text":"虚堂吏事稀，吟卧欲忘机。\n窗静蜂迷出，帘轻燕误飞。\n烦心倾晚簟，倦体快风衣。\n更想霜云外，同君看翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黎生下第还乡","author":"苏舜钦","text":"人云之子贤，文采出巴川。\n失意声名在，还爱岁月迁。\n离怀春色里，归路夕阳边。\n无废青箱学，穷愁古亦然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日晚晴","author":"苏舜钦","text":"人言春雨好，更好晚来晴。\n树色通帘翠，烟姿著物明。\n得泥初燕喜，避弋去鸿轻。\n谁见危栏外，斜阳尽眼平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上申公祝寿","author":"苏舜钦","text":"维神祚炎历，发蕴复含灵。\n嶷尔为人瑞，居然出相庭。\n舜门登夙望，韦氏继先经。\n积学方开隩，当官已发硎。\n纯诚贯白日，阔步上青冥。\n才力回元气，胸怀纳四溟。\n八荒归富寿，万象染丹青。\n恳牍辞魁柄，开藩密帝扃。\n碧旌油重润，苍佩玉明荧。\n舆望知难转，王心几不宁。\n西羌动妖孽，秦塞困膻腥。\n羽奏飞关路，兜烽照浊泾。\n裴公辞激烈，袁相涕飘零。\n天为移文象，人思奉典型。\n欢谣塞归路，召节下宸廷。\n胜算剧破竹，威声如走霆。\n折冲千里定，指画众心醒。\n大议虚怀纳，吁谟前席听。\n玉关收旧地，庙鼎续新铭。\n复耸岩岩石，增辉两两星。\n川源流盛美，岳镇敌长龄。\n有客惭才薄，区区咏德馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有客","author":"苏舜钦","text":"有客论时事，相看各惨然。\n蛮夷杀郡将，蝗蝻食民田。\n萧瑟心空远，徘徊志自怜。\n何人同国耻，馀愤落樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游南内九龙宫","author":"苏舜钦","text":"昔帝龙骧后，因池大此宫。\n萧笳叠终日，旌仗展无穷。\n绘塑神灵集，飞潜爪角雄。\n阴轩常隐雾，暗堵亦含风。\n巨盗来移国，天王遽避戎。\n苍黄狩巴蜀，倏忽陷河潼。\n阁殿回看远，尘氛久见蒙。\n归来故基在，不与往时同。\n叠瓦烟间碧，新蕖露下红。\n波春荡初月，沙晚发悲鸿。\n世变今无复，人愁杳莫终。\n树穿瑶甃裂，碑碎玉楼空。\n九曲皆遗石，诸王祗断蓬。\n兴亡何足问，一一夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈进士游江南","author":"苏舜钦","text":"昔也衣裾已化尘，驱车今去涉惊津。\n淮天苍茫背残腊，江路逶迤逢旧春。\n时有飘梅应得句，苦无蒸酒可沾巾。\n归来莫恋溪山胜，枫鬼揶揄解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马承之古庙","author":"苏舜钦","text":"庙貌空山里，垣颓入径斜。\n尚应名竹素，不复祭牲豭。\n木暗鸮呼鬼，庭荒雀啅蛇。\n有灵从寂寞，慎勿学凶邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和解生中秋月","author":"苏舜钦","text":"不为人间意，居然节物清。\n银堂通夜白，金饼隔林明。\n醉客尊前倒，栖乌露下惊。\n悲欢今古事，寂寂堕荒城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿太平宫","author":"苏舜钦","text":"驱车长道久尘劳，一宿清宫醒骨毛。\n古桧有风天自籁，石坛多露鹤争嗥。\n星河耿耿秋还迥，栖观澄澄夜更高。\n吟对疏钟俗机尽，已疑身世属仙曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独游辋川","author":"苏舜钦","text":"行穿翠霭中，绝涧落疏钟。\n数里踏乱石，一川环碧峰。\n暗林麋养角，当路虎留踪。\n隐逸何曾见，孤吟对古松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过下马陵","author":"苏舜钦","text":"下马陵头草色春，我一怀古一沾巾。\n陵边又有累累冢，应是当年取酒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览含元殿基因想昔时朝会之盛且感其兴废之故","author":"苏舜钦","text":"在昔朝元日，千门动地来。\n方隅正无事，辅相复多才。\n仗下簪缨肃，天中伞扇开。\n皇威瞻斗极，曙色辨崔嵬。\n赤案波光卷，鸣梢殿尾回。\n熊罴驱禁卫，雨露覆兰台。\n横赐倾中帑，穷奢役九垓。\n只知营国用，不畏屈民财。\n翠辇还移幸，旻天未悔灾。\n群心争困兽，回首变寒灰。\n曾以安无虑，翻令世所哀。\n行人看碧瓦，独鸟下苍苔。\n虽念陵为谷，遥知祸有胎。\n青编遗迹在，此地亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望秦陵","author":"苏舜钦","text":"雄心虽盖世，竟亦弃群臣。\n役重倾天下，时危启圣人。\n石麟空举首，银海罢流春。\n陇阙今无复，应深行路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题樊川李长官庄","author":"苏舜钦","text":"社曲东边风物幽，我来系马独淹留。\n门前翠影山无数，竹下寒声水乱流。\n酒压新尘常得醉，花开番次不知秋。\n主公堆案萦官事，早晚归来今白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿终南山下百塔院","author":"苏舜钦","text":"驱马山前访古踪，僧居萧洒隔尘笼。\n绕庭石鳖谷间水，入户鸣鸱堆上风。\n无限老松秋色里，数声疏铎月明中。\n村鸡坐听三号彻，去去前朝气味同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿华严寺与友生会话","author":"苏舜钦","text":"危构岧峣出太虚，坐看斜日堕平芜。\n白烟覆地澄江阔，皎月当天尺璧孤。\n疏磬悲吟来竹阁，青灯寂寞照吟躯。\n老僧怪我何为者，说尽兴亡涕泪俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王杨庭著作宰巫山","author":"苏舜钦","text":"兰台旧漫郎，为邑上瞿唐。\n地僻风烟古，公馀日景长。\n江声通白帝，山势入青羌。\n落笔多佳句，时应满锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚意","author":"苏舜钦","text":"晚色微茫至，前山次第昏。\n羸牛归径远，宿鸟傍檐翻。\n盘喜黄粱熟，杯馀白酒浑。\n田家虽澹薄，犹得离尘喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春暮初晴自御宿川之华严寺","author":"苏舜钦","text":"春暮曾无属物心，野行聊得据鞍吟。\n路经废苑情通古，水绕苍山意共深。\n残日花间浮暖艳，断云楼外卷轻阴。\n骚人自昔伤鶗鴂，休苦风前送好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和师黯寄王耿端公","author":"苏舜钦","text":"嫉恶曾收柱后冠，淹沦今未复荣班。\n青云失路初心远，白雪盈簪壮志闲。\n厩马尚嘶骢奋迅，箧衣犹曝绣斓斑。\n风流县尹多才思，时寄篇章与解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻京尹范希文谪鄱阳尹十二师鲁以党人贬郢中欧阳九永叔移书责谏官不论救而谪夷陵令因成此诗以寄且慰其远迈也","author":"苏舜钦","text":"朝野蔚多士，衮然良可羞。\n伊人秉直节，许国有深谋。\n大议摇岩石，危言犯采旒。\n苍黄出京府，憔悴谪南州。\n引党俄嗟尹，移书遽窜欧。\n安惭言得罪，要避曲如钩。\n郢路几束马，荆川还溯舟。\n伤心众山集，举目大江流。\n远动家公念，深贻寿母忧。\n横身罹祸难，当路积仇雠。\n卫上宁无术，亢宗非所优。\n吾君思正士，莫赋畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑景","author":"苏舜钦","text":"溽暑倦幽斋，纵横书乱堆。\n风多应秀麦，雨密不黄梅。\n乳燕并头语，红葵向背开。\n吟馀晴月上，凉思入尊罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏中","author":"苏舜钦","text":"院僻帘深昼景虚，轻风时见动竿乌。\n池中绿满鱼留子，庭下阴多燕引雏。\n雨后看儿争坠果，天晴同客曝残书。\n幽栖未免牵尘事，身世相忘在酒壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先公之爱马以病寄他厩今死矣","author":"苏舜钦","text":"先君所乘马，其色白于银。\n磊落龙之种，权奇世共珍。\n独嘶如想望，久步见精神。\n方目照代夜，拳毛刷渭津。\n鬣寒如拥浪，蹄駃不惊尘。\n潦倒已伏枥，苍黄仍借人。\n俄传弊帷信，无复锦蒙亲。\n倚棹思神骏，萧然泪洒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重过句章郡","author":"苏舜钦","text":"曾随使旆此东归，日日登临到落晖。\n畴昔侍行犹总角，如今重过合沾衣。\n窥鱼翠碧忘形坐，趁伴蜻蜓照影飞。\n风物依然皆自得，岁华飘忽赏心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚出润州东门","author":"苏舜钦","text":"京口古雄处，昔年尝此过。\n风流看石兽，人事共江波。\n河转路疑尽，日斜山更多。\n城楼郁天半，回首恣吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无锡惠山寺","author":"苏舜钦","text":"寺古名传唐相诗，三伏奔迸予何之。\n云山相照翠会合，殿阁对走凉参差。\n清泉绝无一尘染，长松自是拔俗姿。\n二边羌胡日斗格，释子宴坐殊不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴江亭","author":"苏舜钦","text":"气象清雄天与邻，世间不合有埃尘。\n拟将累句酬佳景，只恐江山解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀州通越门外八九里临水多佳木茂树以便风不得停舟一赏怆然为诗","author":"苏舜钦","text":"密树重萝覆水光，珍禽无数语琅琅。\n惊帆瞥过如飞鸟，回首风烟空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀州城外九里有竹树小桥予十八年前与友人解晦叔饮别于此今过之景物依然而解生已亡悲叹不足复成小诗","author":"苏舜钦","text":"当年共醉此桥边，道旧狂歌至暮天。\n得句旋题新竹上，移舟还傍乱花前。\n君埋尘土骨应化，我逐风波心欲燃。\n落日长号感人事，沙头寂寞上渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天章道中","author":"苏舜钦","text":"画鹢低飞湖水平，高低楼阁满稽城。\n人游镜里山相照，鱼戏空中日共明。\n尽是荷风香不断，忽逢溪雨气尤清。\n篮舆却上兰亭步，猿鸟云萝伴此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大禹寺","author":"苏舜钦","text":"鉴湖尽处众峰前，寺古萧疏水石间。\n殿阁北垂连禹庙，松筠东去入稽山。\n坐中岩鸟自上下，吟久溪云时往还。\n我厌区区走名宦，未能来此一生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州巽亭","author":"苏舜钦","text":"公自登临辟草莱，赫然危构压崔嵬。\n凉翻帘幌潮声过，清入琴尊雨气来。\n畴昔江山何处好，生平怀抱此中开。\n东南地本多幽胜，此向东南特壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿钱塘安济亭观潮","author":"苏舜钦","text":"支肘听潮声，喧豗久未停。\n随风过渔浦，伴月出沧溟。\n鳅穴浚时满，胥神果有灵。\n连天卷云雾，彻晓下雷霆。\n舍楫游心倦，凭阑醉魄醒。\n谁穷造物意，拟访郦元经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使风","author":"苏舜钦","text":"长风天外来，十幅健帆开。\n仰首飞云合，牵心翠竹回。\n闲观水知性，静与睡为媒。\n始觉扬舲快，疲驽亦可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新开湖晚霁","author":"苏舜钦","text":"霁霞飞尽失西东，水入天光浩气中。\n籍籍轻帆一游鸟，似乘风力上虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日汴中","author":"苏舜钦","text":"旅棹出江湖，漂然迹更孤。\n风波数破胆，时事一长吁。\n闻说西羌使，犹稽北阙诛。\n俗言无上策，且复醉茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩忠宪公挽词二首 其一","author":"苏舜钦","text":"才发经纶地，心开忠义源。\n朝端遗盛业，泉下閟英魂。\n储禁追封美，仪曹集谥尊。\n他年还驷马，馀德在高门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩忠宪公挽词二首 其二","author":"苏舜钦","text":"中台典故明，二府弼谐成。\n车挂身方佚，舟移世共惊。\n霜风吹缟帐，野月照丹旌。\n寂寞都门路，伤哉如昔行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诏狱中怀蓝田高先生","author":"苏舜钦","text":"自嗟疏野性，不晓世涂艰。\n仰首羡飞鸟，冥心思故山。\n刚来投密网，谁复为颦颜。\n寄语高安素，今思日往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湘公院冬夕有怀","author":"苏舜钦","text":"去年急雪洒窗夜，独对残灯观阵图。\n今夕悲风撼轩竹，又来开卷拥寒炉。\n禅房潇洒皆依旧，世路崎岖有万殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离京后作","author":"苏舜钦","text":"春风奈别何，一棹逐惊波。\n去国丹心折，流年白发多。\n脱身离网罟，含笑入烟萝。\n穷达皆常事，难忘对酒歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答和叔春日舟行","author":"苏舜钦","text":"幽人漂泊兴无穷，弄水寻花处处同。\n春入水光成嫩碧，日匀花色变鲜红。\n静中物象知谁见，闲极情怀觉道充。\n寄语悠悠莫疑我，五湖今作狎鸥翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答子履","author":"苏舜钦","text":"塌翼下层云，飘然江汉濆。\n苍蝇休聚谤，白鸟已为群。\n银鲫晨烹美，松醪夜酌醺。\n生平同得失，此日又逢君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟行有感","author":"苏舜钦","text":"忽忽赏节物，区区何所归。\n天阴鸟自语，水落岸生衣。\n客况知谁念，人生与愿违。\n东风百花发，独采北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮亭小饮","author":"苏舜钦","text":"山气复清淮，亭临乱石开。\n旅愁无处避，春色为谁来。\n酒赖啼莺送，歌随去雁哀。\n相携聊一醉，休使壮心摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮中风浪","author":"苏舜钦","text":"春风如怒虎，掀浪沃斜晖。\n天阔云相乱，汀遥鹭共飞。\n冥冥走阴气，凛凛挫阳威。\n难息人间险，临流涕一挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿阳閒望有感","author":"苏舜钦","text":"维舟亭下偶登临，下蔡风流古至今。\n远岭抱淮随曲折，乱云行野乍晴阴。\n幽人憔悴搔白首，啼鸟哀鸣思故林。\n触处涂穷何足恸，直回天地入悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阻风野步有感呈子履","author":"苏舜钦","text":"轻舟留滞已春残，携手栖栖田野间。\n尽日东风吹百草，有时双鹭下前湾。\n古为少见如君困，世上应无似我闲。\n抖擞尘襟莫回首，谤书终不到溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过泗水","author":"苏舜钦","text":"五年六经此，仰首叹劳生。\n山是往时色，人皆今日情。\n机心去国少，尘眼向淮明。\n物理吾俱晓，漂流安足惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和丹阳公素学士晚望见怀","author":"苏舜钦","text":"古郡登临足胜游，使君才调更风流。\n过云送雨海山暗，斜日催蝉江树秋。\n屡辱嘉招嗟放弃，又传新咏慰淹留。\n霜天乘兴当西谒，共醉城尖四望楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子履","author":"苏舜钦","text":"一舸风前五两飞，南迁今去别慈闱。\n人生多难古如此，吾道能全世所稀。\n幸有江山聊助思，莫随鱼鸟便忘归。\n君亲恩大须营报，学取三春寸草微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春睡","author":"苏舜钦","text":"别院帘昏掩竹扉，朝酲未解接春晖。\n身如蝉蜕一榻上，梦似杨花千里飞。\n嗒尔暂能离世网，陶然直欲见天机。\n此中有德堪为颂，绝胜人间较是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览照","author":"苏舜钦","text":"铁面苍髯目有棱，世间儿女见须惊。\n心曾许国终平虏，命未逢时合退耕。\n不称好文亲翰墨，自嗟多病足风情。\n一生肝胆如星斗，嗟尔顽铜岂见明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起","author":"苏舜钦","text":"吴天摇落奈愁何，病起风前白发多。\n争得松江变醇酒，拍浮终日恣酣歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀","author":"苏舜钦","text":"年华冉冉催人老，风物萧萧又变秋。\n家在凤皇城阙下，江山何事苦相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晓闻鹤唳一声","author":"苏舜钦","text":"落月衔栖露乍零，竹间孤唳入青冥。\n未知蟋蟀缘何事，床下微吟不暂停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中得杜丞相见寄诗感而有作","author":"苏舜钦","text":"易毁唯迁客，难谐是俗情。\n愁多怯秋夜，病久厌人生。\n委顺闻之旧，衰羸见者惊。\n新诗如接侍，吟罢涕淋缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和彦猷晚宴明月楼二首 其一","author":"苏舜钦","text":"溪声来从一气外，楼阁插在苍霞中。\n艳歌横飞送落日，哀筝自响吹霜风。\n低昂黛色四山黯，凌乱缬纹疏树红。\n凭阑挥手问世俗，何人得到蟾蜍宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]