37352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月二十七日夜大风雨顿凉偶作","author":"孙应时","text":"五更风雨洗骄阳，满耳秋声撼我床。\n梦里忽知身化羽，觉来新免汗翻浆。\n可怜团扇辞人去，便有寒虫语夜长。\n老大幸谙时节惯，可能随世作炎凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十五日同赵景孟胡晋远游四明山","author":"孙应时","text":"乍晴天宇瑩无尘，短策轻衫发兴新。\n过鸟一声如劝客，青山万叠总迎人。\n回头便与氛埃隔，入眼真于水石亲。\n尽意登临休计日，此行端不负芳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入栈","author":"孙应时","text":"栈险名天下，吾行信所闻。\n落虹横绝壁，匹马上浮云。\n咫尺南北断，毫釐生死分。\n谁令钟邓辈，十万度秦军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八阵碛","author":"孙应时","text":"江近瞿唐急，沙从鱼腹横。\n千秋应有恨，八阵竟难平。\n望断青烟晚，愁边白鸟明。\n身微定何补，且复老躬耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月二十六日南至天色佳甚","author":"孙应时","text":"天心应喜一阳来，万里寒阴晓自开。\n消息早传从嶰竹，发生先合到江梅。\n遥瞻双阙呈云瑞，正想三宫舞寿杯。\n草木微情共时节，思亲南望独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十七夜如山庵","author":"孙应时","text":"一雨秋能好，连宵月迥明。\n百年今夕话，万里去年情。\n水满天相荡，山空人独行。\n蝉声发奇思，携酒未须倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄潼川漕仲房 其一","author":"孙应时","text":"巴蜀劳肤使，溪山隔岁华。\n一身知许国，万里岂忘家。\n腊雪装归辔，春风阅禁花。\n君王定前席，不必赋长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄潼川漕仲房 其二","author":"孙应时","text":"郡县仍荒政，朝廷念远方。\n向来传诏札，不独戒戎羌。\n帝德乾坤大，天聪日月光。\n边防须至计，社稷倚安疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又谒武侯祠","author":"孙应时","text":"城南风景故堪怜，胜日经行意洒然。\n江上竹寒偏却暑，庙前柏老尚参天。\n堂堂不朽能千古，鼎鼎何能漫百年。\n醉里狂歌心浩荡，为君一吸倒觥船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又答韵","author":"孙应时","text":"连阴漠漠锁春寒，閒检新年历日看。\n节里人言太幽独，床头书喜报平安。\n山林决计应宜早，藜苋谋生未苦难。\n归对妻孥真大笑，鲇鱼元不解缘竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万景楼三首用韵 其二","author":"孙应时","text":"德润连城璧，文工五凤楼。\n不愁来蜀徼，政喜识荆州。\n世久欺儒素，人当问品流。\n平生郭有道，得共李公舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万景楼三首用韵 其一","author":"孙应时","text":"皛皛三江水，岧岧百尺楼。\n云山接南诏，风景冠西州。\n徙倚乾坤大，徘徊岁月流。\n明朝怅回首，湖海一归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万景楼三首用韵 其三","author":"孙应时","text":"阮籍少青眼，元龙思卧楼。\n与君非俗士，为我望神州。\n明月不可问，长江空自流。\n悠悠复何道，行止一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三用沙字韵简叔刚","author":"孙应时","text":"雄心八骏骋流沙，猛气千人废咄嗟。\n总有画图堪叹息，应无大药驻容华。\n田园终胜为形役，餐饭聊须努力加。\n此语非君谁举似，夜阑清坐落灯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三游洞之外俯瞰峡江酷似钓台","author":"孙应时","text":"木落天清岚翠开，缓将脚力试崔嵬。\n千年洞府烟霞外，一壑水声风雨来。\n客路山川生白发，古人名字剥苍苔。\n平生感慨忘言地，俯见沧江忆钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上史魏公寿三首 其三","author":"孙应时","text":"中书考已敌汾阳，神气清明骨更强。\n客倒壶觞弄风月，酒阑灯火事文章。\n传家正有书千卷，积庆真成笏一床。\n看取西湖共长久，年年菊会答秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上史魏公寿三首 其二","author":"孙应时","text":"中兴大业要规模，公有初言久未孚。\n已喜乾坤深佑德，况逢岁月正悬弧。\n明时礼数尊三事，大老精神压万夫。\n军国平章天下望，鹰扬年德正相符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上史魏公寿三首 其一","author":"孙应时","text":"清都绛阙拱慈皇，鹤驾鸡鸣起未央。\n父子至情如一日，国家庆事冠前王。\n公功实作风云旧，帝学于今日月光。\n天寿两宫千万岁，端留元老赞明昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]