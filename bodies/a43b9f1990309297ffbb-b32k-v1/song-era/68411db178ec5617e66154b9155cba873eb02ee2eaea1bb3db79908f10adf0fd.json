[{"title":"同吴家兄弟游东山约仲诚不至","author":"释德洪","text":"东山重到读题名，胜践清游此合并。\n雾雨开晴秋满眼，暮云欲合句先成。\n走禅璧月寒林静，来客兰丛玉树清。\n我老吐词如朽木，蒸成芝菌报升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"器之示巽中见怀次韵","author":"释德洪","text":"折脚铛寻稳处安，对君此夕久盟寒。\n狐裘不合须羊袖，药簏何妨缺夜干。\n秋垄此时驱健犊，道山何日跨归鸾。\n仙炉只隔数邱耳，上水船方厄濑湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书鉴上人香严堂","author":"释德洪","text":"堂前丛玉知谁种，丛下高人自扫除。\n未论击声回顾眄，先欣秀色上眉须。\n随宜万偈风宣说，顿现千身月写摹。\n就地对谁曾画饼，当年馋水救饥无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冷然斋","author":"释德洪","text":"以身为舌毗尼藏，俨此空斋镜面清。\n蝉蜕尘埃轩盖集，蝶成魂梦篆烟轻。\n芦图世界分遗境，玉麈天花委落英。\n钵在道山归去好，摩挲风驭笑平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢性之惠茶","author":"释德洪","text":"午窗石碾哀怨语，活火银瓶暗浪翻。\n射眼色随云脚乱，上眉甘作乳花繁。\n味香已觉臣双井，声价从来友壑源。\n却忆高人不同试，暮山空翠共无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访友人二首 其一","author":"释德洪","text":"海棠雨过尚娇春，袖手来寻林下人。\n未话柳条堪结纽，且欣梅子可尝新。\n孤踪衮衮风中絮，万事纷纷梦里尘。\n他日别山重会面，定知谈笑绝鲜陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访友人二首 其二","author":"释德洪","text":"日暮荒城倚瘦藤，江南春思倍添增。\n那知淮水黄尘路，忽见庐山绿发僧。\n乞食久辞烟际寺，连床今对夜深灯。\n明年我亦寻君去，同陟天池最上层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石台夜坐二首 其一","author":"释德洪","text":"故乡乃有此丛林，下板何妨著寂音。\n永与世遗他日志，尚嫌山浅暮年心。\n冻云未放僧窗晓，折竹方知夜雪深。\n琢句自应清似玉，更宜坡字硬黄临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石台夜坐二首 其二","author":"释德洪","text":"岁晚山深过客稀，一灯清坐夜同谁。\n滴阶寒响雪消后，通火活红灰陷时。\n敛目旧游真可数，盖棺前事尚难知。\n古今不隔诸缘净，画出岩中道者诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡卿才时思亭","author":"释德洪","text":"祇今冢木上云雨，想见音容无恙时。\n竟作怀归恋云舍，空馀泪眼看风枝。\n功名未洗终天恨，岁月难忘罔极悲。\n已觉夜林无触鹿，但看几砚出灵芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题此君轩","author":"释德洪","text":"解知无竹令人俗，日报平安候起居。\n所以此君揖冰雪，长吟馀翠满衣裾。\n瘦行清坐搜诗处，雨叶风枝解箨初。\n试作小轩聊寄傲，爱君生计未为疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜文首座至","author":"释德洪","text":"机锋不减矮师叔，闻说丛林最饱参。\n无暇对人收冷涕，却能为我出寒岩。\n春江柔橹何时听，夜雨山房且对谈。\n掣电一欢端可贵，此生俱是再眠蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"超然自见轩","author":"释德洪","text":"丛林争致致不得，茧足径来寻俨师。\n幽境自能情外见，高怀独出世间痴。\n清晨倚槛临黄卷，五月乱山闻子规。\n夙习尚嗟消未尽，壁间时录和陶诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清大师还姑苏塔其师骨石吊之兼简其弟","author":"释德洪","text":"闻说高怀照雪霜，道容一见自清凉。\n今随生死晦心月，空使湖山蔼德香。\n故纸不堪看竹笼，凝尘那忍拂绳床。\n安门弟子真持远，独为斯人未始亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闽僧不食已四十年赠之","author":"释德洪","text":"银发齐眉衲半肩，相逢古寺独欣然。\n自云出岭三千里，人见空馀四十年。\n拟欲就君求此术，预忧临食必流涎。\n何如万事随缘过，饥即须餐困即眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐五年秋尝宿独木为诗以自遣今复过此追旧感叹用韵示超然二首 其一","author":"释德洪","text":"独木江头缆客船，暮江秋色两依然。\n落霞片段红绷水，危岫参差碧挂天。\n名利到头成底事，田园归得是何年。\n峥嵘壮志消磨尽，满目西风只自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐五年秋尝宿独木为诗以自遣今复过此追旧感叹用韵示超然二首 其二","author":"释德洪","text":"踪迹漂流不系船，旧游曾到意茫然。\n玉笙哀怨初凉夜，秋月婵娟落木天。\n往事已嗟如昨梦，壮怀无复似当年。\n炉峰当眼空相向，因念区区想见怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与客啜茶戏成","author":"释德洪","text":"道人要我煮温山，似识相如病里颜。\n金鼎浪翻螃蟹眼，玉瓯绞刷鹧鸪斑。\n津津白乳冲眉上，拂拂清风产腋间。\n唤起晴窗春书梦，绝怜佳味少人攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿香城寺","author":"释德洪","text":"夜晴风细月华清，绕寺霜筠雪竹声。\n锡响僧归帝青宝，梦香人宿水沉城。\n古今不隔尘都尽，心境俱忘镜对明。\n枕臂晓猿三叫绝，小窗灯暗读残经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自张平道入瑶溪","author":"释德洪","text":"冲虎曾经落照村，千峰盘尽始登门。\n惯闻跛脚阿师法，喜见横行道者孙。\n爱客精神清入画，游方踪迹夜重论。\n杖藜又入层云去，知有安公旧隐存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九峰夜坐","author":"释德洪","text":"千峰万峰自云雨，一宿两宿心颓然。\n不知人间岁云暮，但觉涧风吹夜泉。\n地炉火燄水正泣，篝灯委昏僧未眠。\n古人去我不甚远，何必想像临遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同世承世英世隆三伯仲蔡定国刘达道登滕王阁","author":"释德洪","text":"承英连璧光照坐，更著阿隆如鼎安。\n老兵先驰启关钥，西山奔走登栏干。\n刘郎端默自凝远，蔡侯奋髯牙齿寒。\n但馀衰老百无用，搜句倚栏方细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李大卿","author":"释德洪","text":"瓶盂又复寄西州，弥勒同龛古寺幽。\n睡起忽残三月夏，朝来拾得一帘秋。\n浮云世事慵料理，断梗闲踪任去留。\n投老山林多胜槩，杖藜何日复同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余居百丈天觉方注楞严以书见邀作此寄之二首 其一","author":"释德洪","text":"风定晴云欲堕崩，林梢楼阁旋添增。\n一生高世清闲侣，千尺当门紫翠层。\n对客不妨拴坏衲，倦禅时作靠枯藤。\n暮年古格丛林在，重拨尘龛大智灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余居百丈天觉方注楞严以书见邀作此寄之二首 其二","author":"释德洪","text":"三世如来尊顶法，覆藏深密碧螺寒。\n通身是眼自不见，擘面出头窥更难。\n四义仅能分肉髻，八还终恐隔花冠。\n争如劈佛丹霞手，揭露从教觌体看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄龙安照禅师","author":"释德洪","text":"随分丛林古格存，龙安真是泐潭孙。\n独持一节无求世，勘破诸方不出门。\n石虎已忘蹲草见，木蛇久灭住山痕。\n遥知百事俱衰落，尚有工夫虱自扪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻龙安往夏口迎张左丞遂溯流至鄂渚相别还山作此寄之","author":"释德洪","text":"无尽龙安两勍敌，大梅庞老是同参。\n近闻赤壁同登赏，想见清风助笑谈。\n已作汎舟游夏口，又成横锡过江南。\n归来万壑松声在，依旧闲云没草庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别龙安","author":"释德洪","text":"朅来幕阜峰前寺，弥勒同龛两见秋。\n今日他山生远念，何年此地复重游。\n主人有道忘欣厌，闲客无求任去留。\n索纸题诗聊赠别，更哦江海一沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵无代送僧归吴","author":"释德洪","text":"春掠湓江绿染眸，多情还解向东流。\n故应夜梦清苍胜，欲趁春光烂熳游。\n饱学尚嗟心未死，痛吟已觉鬓先秋。\n何当一棹华亭上，闲唱波寒月满舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀友人","author":"释德洪","text":"寻常轻别尚消魂，何况交情过弟昆。\n孰谓此身闲日月，自惭疏迹信乾坤。\n泠泠小雨江边路，薄薄浮烟竹外村。\n回首旧游方契阔，孤舟何处宿黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪履道家观古书","author":"释德洪","text":"风流前辈已成尘，笔迹犹为世所珍。\n促膝猛观惊盛事，临风长想见斯人。\n气生伟逸龙蛇动，秀发精神点画新。\n破箧尚能多此物，且欣汪子未全贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼性上人","author":"释德洪","text":"三年三过龙安寺，亹亹清谈解逼人。\n顾我偷闲久无侣，与君数面自成亲。\n转头忽作幽冥隔，弹指空惊梦寐新。\n病眼看秋欲凄眩，攀翻投老一伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日还庐山故人书因以为寄","author":"释德洪","text":"风叶鸣廊夜色晴，隔云微月稍分明。\n下帘徒怯衣裳薄，拂榻空惊枕簟清。\n病眼得秋还少睡，壮心于世尚多情。\n何时却作庐山去，渡水穿云取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诚上人求诗","author":"释德洪","text":"我昔车轮翠里行，只今怀想似前生。\n那知古寺僧窗下，偶见高人眼倍明。\n秋月半钩留客意，冻云千顷欲归情。\n杖藜笑出千峰去，添得苍崖响答声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪夜读涪翁所作爱之因怀其人和韵奉寄超然","author":"释德洪","text":"溪雨初收岸草微，柳丝堪入绿罗机。\n望中情远恨烟树，何处暖多嫌衲衣。\n却信真人还有梦，岂关禅子未忘机。\n春风痛与传消息，教忆旧山新翠归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公亮超然见和因寄复答之","author":"释德洪","text":"高人秀句入幽微，濯出秦川锦一机。\n剪制未为春步幛，暗投先作夜行衣。\n语尊九鼎真难荷，意的千钧善发机。\n早晚杖藜松下见，应疑刘远谷中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞香花","author":"释德洪","text":"灵根闻是花中瑞，可怜亦肯乘春开。\n色深卷肉浅巴锦，香浓入骨生秦梅。\n也知秀丽不群品，最宜阴洁幽庭栽。\n落英红叶不忍扫，从教狼藉蒙苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别灵源禅师","author":"释德洪","text":"平生风骨秀琳琅，水镜胸怀未易量。\n声利光中忙趣少，烟霞影里淡心长。\n云泉隐德无情动，猿鸟侵身不乱行。\n他日定归当卜筑，青藜紫蕨壮诗肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠许秀才","author":"释德洪","text":"虬髭铁面鹤精神，水鉴心胸不受尘。\n吹耳松风靠藜杖，敞衣山月岸纶巾。\n虎头猿臂成何事，道骨方瞳亦可人。\n他日西湖如过我，饮君一味武林春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送轸上人之匡山","author":"释德洪","text":"何处高人云路迷，相逢忽荐目前机。\n偶逢菜叶随流水，知有茅茨在翠微。\n琐碎夜谈皆可听，烟霏秋岭欲同归。\n翛然又向诸方去，无数山供玉麈挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与晦叔至奉新","author":"释德洪","text":"欲去未成还执手，西风疏雨晚丝丝。\n暗惊岁月行飘忽，那更人生苦别离。\n君已到心工笔语，我今归计老茆茨。\n冷斋后夜谁同宿，莫向灯前读此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送敏上人","author":"释德洪","text":"密林病叶强翻红，已觉清秋夜气浓。\n懒复小窗邀独秀，却应归梦挂双峰。\n水分淮甸当悬席，路绕匡山可振筇。\n若见虎溪溪上月，为言相忆作衰容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过孜莫翁","author":"释德洪","text":"禹穴朝来散晚参，一程随便达云岩。\n南山任把浮云蔽，西岭犹将落日衔。\n幽径野花开旧菊，石床楸子下高杉。\n投宵夜永寒无寐，良忆真僧衣不蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵二僧题永安壁上","author":"释德洪","text":"二休书壁诗争妙，促席吟时愧不同。\n豪句大鲸秋驾浪，俊才细马晓追风。\n支筇放荡千峰里，万事收藏一笑中。\n约我清溪老莲社，茅茨相映小桥东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王司法","author":"释德洪","text":"轻帆已有渡江期，高会清游惜此时。\n水阁飏烟晴试茗，雪窗剪烛夜论诗。\n冲寒远雁来横浦，弄色新梅半糁枝。\n林下自知无一事，亦应风月动关思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和许乐天","author":"释德洪","text":"沧溟曾见化微尘，花发桃源几度春。\n俗眼莫轻狂道士，此身应是谪仙人。\n清弹一曲悲风远，绝唱千章白雪新。\n异日三茅成卜筑，却因瓶锡得为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师复作水饼供出五诗送别谢之","author":"释德洪","text":"草堂野饭蜀江滨，妥贴寒光刻削人。\n忽展五篇争疾读，便惊四座暖生春。\n已欣莲社风流在，更觉溪山气味新。\n放箸翛然庐岳去，门栏他日梦应频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠鉴上人","author":"释德洪","text":"毗尼藏出清净宝，精进林生功德香。\n但得身心常寂静，自然毛孔发灵光。\n苍苔不厌芒鞋弊，空翠偏宜坏衲荒。\n好在虎溪长不出，阿持何意尚游方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠静上人","author":"释德洪","text":"雪摧枯虑默如瘖，秋压寒松老不禁。\n一室闭门稀识面，半窗斜照自拴针。\n重城此日留诗别，叠巘何年结伴寻。\n衰退宁堪久尘土，相看满眼是归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"表上人久事云庵过余石门","author":"释德洪","text":"冻折枯杉已死灰，岂宜安著在尘埃。\n偎衰不入今人眼，精进曾亲古佛来。\n爱子渠渠念绨惠，为余得得出岩隈。\n苍颜华首供衰暮，未死重逢更几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵超然","author":"释德洪","text":"翠寒空觉此生浮，岁月催人鬓易秋。\n忽忆倚天庐岳去，更寻清境武林游。\n情亲愧与高人别，兴发徒烦夜月留。\n他日西湖远相忆，为君一笑散沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄楷禅师","author":"释德洪","text":"龙蛇头角混埃尘，临死方知老净因。\n三度傲辞天子敕，一生甘作净名身。\n虎皮羊质成何事，牛马襟裾亦谩陈。\n须信屈原千载后，空门犹有独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"璲首座出示巽中诗","author":"释德洪","text":"左手不仁右手明，怀情亦复弃藜床。\n不知门外山花发，但觉君来笑语香。\n颀绍神情扫秋晚，瘦权诗句挟风霜。\n两翁杖屦相追逐，此夕因依夜话长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李秀才","author":"释德洪","text":"门掩青山相并居，爱君家法不萧疏。\n锦囊举子能佳句，瑞鸟隐公多谏书。\n学士八塼声价在，谪仙千首笑谈馀。\n清朝第一他年事，且看归来著翠裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠修上人","author":"释德洪","text":"我爱修公亦自贤，未忻城郭爱林泉。\n醉骑鲸背诗遗落，闲把牛毛字细编。\n还我青山当夏晚，乞君佳句著床前。\n雨馀独凭烟云上，目送孤鸿落照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵超然竹阴秋夕","author":"释德洪","text":"月胁云行夜未深，满庭风露叶辞林。\n知谁墙外千竿竹，分我窗西一亩阴。\n山好已无归国梦，老闲犹有读书心。\n剩题诗句酬幽隐，岁月翩翩接趐禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山寄都下邦基德祖诸故人","author":"释德洪","text":"势占江南三百里，烟霏相映出层楼。\n芒鞋竹杖山兼水，坐看行吟春复秋。\n浮世万途成底事，吾生一饱更何求。\n故人京洛风埃地，能信山中此乐不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宗上人归南泉","author":"释德洪","text":"灯外佳眠试冷斋，欲成归梦暗惊回。\n一轩秋色侵衣重，半夜波声拍枕来。\n江国潮平人独令，海山家在意徘徊。\n倚藤明日秦淮上，看子风帆十幅开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚坐藏胜桥望石门","author":"释德洪","text":"好山千叶青莲晓，斫额令人意已消。\n微出楼台知有寺，倦行云树忽逢桥。\n此生未觉丛林负，肯处真教日劫超。\n閒拾堕薪成浅立，细泉幽涧响寒蜩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至圆通僧觅诗","author":"释德洪","text":"漱雾跳珠响涧泉，千峰秀出雨馀天。\n共惊绣帽铜腮老，重到香垆石耳边。\n清境荒凉归叹息，故人迎笑尚依然。\n明年过此还相见，应及春风社燕前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧游南岳","author":"释德洪","text":"古寺閒关聊作招，夏秋归思谩迢迢。\n枕中柔橹惊乡梦，门外秦淮涨夜潮。\n想见旧房生薜荔，不堪疏雨在芭蕉。\n何时却理缘云策，峰顶同谁看石桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送隆上人","author":"释德洪","text":"人生聚散等儿戏，梦境纷然此一时。\n老去渐知为客味，秋来长作送人诗。\n感君义色分心曲，慰我年华两鬓丝。\n想见故乡霜菊后，屋头千树橘累垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谅上人南轩避暑","author":"释德洪","text":"人间酷暑推不去，爱此南轩一榻空。\n眼倦抛书成午睡，梦悠谁复羡王公。\n岂知尘土随肥马，但觉熏风掠坏桐。\n起步西园閒倚杖，石榴花出数枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]