[{"title":"三月四日","author":"韩淲","text":"三年寒食在山中，柳自青青花自红。\n寓意本期诗得策，推愁殊觉酒无功。\n消磨故态全然别，冷落新交转不同。\n原上子推将隐矣，且呼饧粥对春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初八日","author":"韩淲","text":"转觉春风满鬓华，冷烟寒食动梨花。\n年年纵有心情在，处处宁无语笑哗。\n涧水细翻晴浪急，园林微转午阴斜。\n数声紫燕芹泥湿，又入前村八九家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八日","author":"韩淲","text":"一年难得是芳时，花柳暄明易满枝。\n人处其间无不有，事思以往总何宜。\n清和天气雨频敛，冷澹风光日缓移。\n交道从前要申固，惜春固可共寻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一日","author":"韩淲","text":"八年山涧送春归，流转风光欲告谁。\n草野其间无别种，芳华之外有残枝。\n燕莺蜂蝶偏他好，鸡犬牛羊不自持。\n溪北溪南交旧在，轻雷吹动雨成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月旦","author":"韩淲","text":"才鼓南薰又得秋，中林清雨洗还幽。\n旧交到了终馀味，新话从来不奈愁。\n末利洁香花未减，芙蕖酣艳叶方浮。\n棋盘酒斝从容地，风物满轩能会不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚来 其一","author":"韩淲","text":"晚来无处不西风，散入千岩万壑中。\n丛桂香边烟羃䍥，疏桐影里月朦朣。\n等閒散步情何限，随分微吟苦未工。\n秋色秋声已如许，更凭高处目飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚来 其二","author":"韩淲","text":"天乃揫敛作深秋，断港回溪水亦收。\n明月已圆云淡薄，西风初老雨霏浮。\n青鞋布袜随宜过，白酒黄鸡有底愁。\n北客登临多话旧，只今楚尾是吴头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十九日","author":"韩淲","text":"中秋过了重阳近，不是骚人爱楚词。\n钟鼎山林元自若，精神心术复谁知。\n长江湛湛吹枫叶，三径皇皇把菊枝。\n宋玉谩悲陶令醉，我何杯酒啸歌时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰九月旦","author":"韩淲","text":"春山无伴怨伤神，故作幽期一两人。\n花外水田看白鹭，松根高冢问麒麟。\n初非此叟其游淡，终是诸贤所趣真。\n雨气忽生归去晚，新诗改罢满壶春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十二月六日","author":"韩淲","text":"小园梅树已吹花，山映疏林水映沙。\n风信不禁时动荡，雨丝维见日交加。\n虽无清影为吟笔，犹有繁香在物华。\n我老一杯随意饮，数声归雁落天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十六日","author":"韩淲","text":"雪飞三日暗烟雾，雪住三日埋冰霜。\n尽道春来须解冻，不疑腊尽未回阳。\n楼台瞩望犹如积，城市驱驰殆欲僵。\n辛苦农家应击壤，遗蝗入地麦青长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日暖甚","author":"韩淲","text":"日暖既愁添疾病，霜寒将恐坏收成。\n石田未必仓箱足，人境还须气体平。\n薄晚闭窗危膝坐，崇朝开户放身行。\n一冬饥饱浑閒事，安得淮南草木生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晴景","author":"韩淲","text":"晓烟初净雨晴时，腻日偎风不自持。\n温厚便饶多著蕊，轻肥全藉略开枝。\n其间小院桃遮户，此外孤村柳隔篱。\n香扑酒旗吟莫尽，艳明歌管醉方知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日竹居玩月","author":"韩淲","text":"柳垂田水浸篱桥，月上苍茫影动摇。\n秋不为他人事改，时间徒自客魂销。\n歌声感耳如何夕，酒力熏心匪一朝。\n推枕觉来风四起，凉侵双鬓发萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同郑一过方斋又往山堂初夜微风雨作步至城外","author":"韩淲","text":"得雨逢秋一醉同，老身随处为从容。\n笑花斋外言谈久，桂树门边步武通。\n漫挟两儿常兀兀，既来三友莫匆匆。\n夜凉共踏朦胧月，赢取归桥满袖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"经月少雨无雷连日方闻之","author":"韩淲","text":"雨阴经月未闻雷，风驾浓云电倏开。\n天尽荧荧横屋去，地高殷殷下檐来。\n浪明潮海琼瑶碎，声撼山林翠碧堆。\n暑气便回梅气润，老农无复虑田莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨呈三衢苏大使君 其一","author":"韩淲","text":"震雷飞电起云霓，想见铃斋闵雨时。\n十里颂声传道路，万家和气舞童儿。\n眷隆芝检闻归诏，恩浃棠阴有去思。\n行客为公停桂棹，坐看丰稔喜成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨呈三衢苏大使君 其二","author":"韩淲","text":"黄门事业到公传，待月轩中世有贤。\n剖竹少劳麾戟外，持荷今在冕旒前。\n文华自足穷三古，政力谁知即九迁。\n颍上通家今几许，唤回旧观属苏仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦雨","author":"韩淲","text":"阴阴天气恰如秋，雨密还稀不断头。\n积土纵横聚蚯蚓，败墙零落上蜗牛。\n支颐习静犹成趣，搔首寻思只伴愁。\n安得雄风埽雌霓，满湖晴日弄扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留连三宿将出山社雨甚至二十一日","author":"韩淲","text":"社瓮同倾酒易深，留连风雨为沈吟。\n兴言大抵多怀旧，何事如斯直至今。\n下榻新窗还抵掌，扶舆旧隐只关心。\n归寻来路村村柳，馀霭春空日半阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十六日终夜雨","author":"韩淲","text":"雨檐经月不通流，一夜垂垂得满沟。\n尘敛小园应菜甲，地苏长亩见禾头。\n暑消未足添吾咏，岁熟当能解国忧。\n少待甘霖遍江海，老夫亦欲具扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初十夜雨十一日大雨呈赵守","author":"韩淲","text":"醮事初严雨已倾，神车西上百川盈。\n坐令田里三农喜，身见邦侯一念诚。\n欢动追锋归禁近，福回眉寿奉亲荣。\n郁攸洗净馀氛后，开士画传禅月清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐雨声","author":"韩淲","text":"山静萧萧吹雨声，叶炉无火有灯檠。\n潜神试数出入息，专气不闻长短更。\n坐定布衾疑地煖，起迟纸帐失天明。\n年来白发身为老，齐物篇成亦强名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜半闻雨声清甚","author":"韩淲","text":"雨声催我梦华胥，清气于人便有馀。\n惟适之安非素隐，不容何病是閒居。\n茶烟未了归真觉，香雾初横切太虚。\n却忆华山陈处士，惘然推枕听阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨思","author":"韩淲","text":"寂寂无人倍觉秋，雨声风色骤还收。\n高林背日孤城脚，细草堆烟古渡头。\n中夜荒鸡刘石舞，上林飞雁子卿愁。\n相看篱菊岩花后，华发清尊可罢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰月八日雨","author":"韩淲","text":"一雨山林方始秋，世间休待我回头。\n心虽未老何须壮，身自长贫不用愁。\n满地烟云终淡淡，数家鸡犬也悠悠。\n木犀开后菊花发，随分杖藜寻酒篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十七日雨意如秋","author":"韩淲","text":"一雨山林又近秋，乱鸦鸣处已飂飂。\n声连檐溜更初滴，气扑庭阴晓未收。\n烁石炎威真可畏，著人凉意却生愁。\n西畴想见芃芃矣，且问今年早熟不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋后一日闻雨","author":"韩淲","text":"秋来便觉雨萧萧，凉入西风百虑销。\n夜静竹窗声自起，昼閒松院影长摇。\n苦无车马能来往，却有樵渔破寂寥。\n涧水已添流渐远，市尘浑不过浮桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日大雨秋已如许","author":"韩淲","text":"连朝秋雨起秋风，梦觉吴山第一峰。\n离合乱云思过雁，去来斜月听吟蛩。\n寂寥髣髴天容澹，摇落相看野色浓。\n寄语骚人模写取，登临佳处更从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十六夜大雨达旦","author":"韩淲","text":"熟睡俄惊簟未收，披衣侧坐且搔头。\n飕飂隔屋听吹瓦，滂沛连床定满沟。\n晓起见山全带雾，午晴沿涧尚周流。\n新凉粳稻农歌处，共喜开禧第一秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八日小暑大雨","author":"韩淲","text":"申祷山川便作霖，耘苗时候想田深。\n且欣小暑能如此，更愿新秋得似今。\n早稻欲花将就实，晚禾成叶未抽心。\n天应不忍焦劳意，直自初栽已望阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦旱 其一","author":"韩淲","text":"望云渴雨验朝霞，不但田家更国家。\n兵食固难资宝货，民饥岂为用泥沙。\n一邱一壑自栖遁，百巧百穷谁富奢。\n水旱是天祈是我，山川灵响本无差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦旱 其二","author":"韩淲","text":"林热江浑其奈何，冷菰寒玉漫诗歌。\n南游禹穴古能几，北望神州兵又多。\n畎亩乏财愁折帛，仓场储粟仰秋禾。\n幽泉坎井徒争汲，尽日骄阳过碧萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦旱 其三","author":"韩淲","text":"孤坐焦心气不苏，炎风畏景逼头颅。\n涧流已断无萍实，园圃俱荒失芋区。\n絺绤纵施衣复汗，简编虽近墨难濡。\n人嘲褦襶交游绝，头白昏昏发懒梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦旱 其四","author":"韩淲","text":"岁晚霜天雪夜时，地炉无火亦频吹。\n如今旱杀热难过，以昔穷忙寒不知。\n岁月只随时变换，乾坤徒使气推移。\n冯生众庶真何谓，翻手为云雨亦奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦旱 其五","author":"韩淲","text":"去年水溢愁无地，今岁旱乾唯告天。\n润泽且为南亩计，清凉终作北窗眠。\n师兴而雨春秋传，星有好风洪范篇。\n上郭桥头看竞祷，大霞宫顶记曾迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十日雪","author":"韩淲","text":"雪花飞我读书林，松叶梅梢自赏音。\n莫问侵寻春事近，肯教容易岁寒骎。\n拥裘鹤帐眠方熟，抱膝鸡窗兴愈深。\n更启柴门唤邻曲，伴题冰柱共清斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪气","author":"韩淲","text":"连山烟雾起层阴，混混沄沄雪气深。\n直面楼台开远寺，惊心人物话平林。\n花街车马何曾少，茅屋尘埃转不侵。\n吠怪从渠走群犬，鸿冥初不碍遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探雪","author":"韩淲","text":"芟削蒿莱见绿苔，扶疏竹影待梅开。\n风生野色苍苍合，日转寒光冉冉来。\n高步芒鞋时踯躅，横拖藜杖且徘徊。\n断鸿飞过霜禽下，清绝山根与涧隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和仲达雪诗","author":"韩淲","text":"屋上未融寒尚力，山头微积冻难开。\n照窗浑似月侵夜，落酒只疑酥满杯。\n蔌蔌剡溪粘短棹，重重庾岭压疏梅。\n新诗韵度慰岑寂，仰叹吾人殊有才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"下帘兀坐咏雪","author":"韩淲","text":"纸帘垂下竹炉深，火白灯青窗气侵。\n但可吟哦经我手，不须斟酌问它心。\n天寒频岁无飞雪，地煖连朝有积阴。\n万径千山踪迹外，踌躇足力咏投簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"韩淲","text":"常时小至多无雪，今岁才先七日飞。\n不待祷祠知帝力，要为丰稔发天机。\n包罗草树孤城近，弹压溪山小市稀。\n本自倦吟仍止酒，渔樵何事破寒归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪作次邱簿韵","author":"韩淲","text":"万里江天雪意浓，舣篷觅句愧诸公。\n相逢不数山阴夜，酬唱难追正始风。\n一饭已形云子白，举杯更泻真珠红。\n片帆西上君须记，兴在远村丹树枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲至雪","author":"韩淲","text":"寒力嘘云积渐生，倚梅偎柳大多情。\n望迷鳷鹊光先起，戏就狻猊势亦狞。\n字字添酥惊怕晚，丝丝弄粉恶差明。\n谪仙檐下人谁画，更著飞花舞落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪天","author":"韩淲","text":"云意昏明欲雪天，冷风吹叶满流泉。\n短檐半影荒荒日，曲径微笼冉冉烟。\n山色不嫌灵运屐，溪光先上子猷船。\n林边喜有春消息，梅点长梢已粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雪上丁使君","author":"韩淲","text":"腊前三白数年无，田里欢呼听我徒。\n顾叹閒身何用矣，瞻言老手盍知乎。\n茅柴纵热慵杯煖，铅椠虽荒忍砚枯。\n袁巷灞桥空广譬，只宜煎水对茶炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵教授喜雪 其一","author":"韩淲","text":"腊前郊后丰年瑞，和气祥风帝所祈。\n吹作六花殊未已，酿成三白更何思。\n列城黎庶穷无告，幽谷畸人饱可期。\n眼底玉溪真乐土，坐销愁叹合吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵教授喜雪 其二","author":"韩淲","text":"在昔君家信不痴，剡中高兴尚何之。\n一时雪月宁须我，万古溪山更属谁。\n欢动梁园虽共乐，困安袁巷本相宜。\n冲寒应见前村笑，冷蕊疏梅又几枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪消","author":"韩淲","text":"雪晴如雨滴茅檐，近溅横飞远复沾。\n风定渐和归几研，日斜微透入书签。\n也知坐久须还起，便觉炉深不用添。\n麦陇高低应更润，青青整整动纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日雪","author":"韩淲","text":"闭门忍作袁安卧，一笑山阴访戴行。\n溪汎小舟吾亦懒，履穿东郭孰忘情。\n饭炊因酒瞢腾去，睡觉思诗宛转成。\n莫道农田喜三白，皑皑何地不争明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪晴可喜","author":"韩淲","text":"雪后春生日气晴，梅根兰叶喜骎骎。\n亟图剩赏那无兴，转觉倦游非有心。\n高卧袁安嗟往事，生擒元济报佳音。\n明年脱绶乘潮去，舟过钓台尤要吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"径山","author":"韩淲","text":"明月池头国一禅，残僧依旧占三椽。\n薰风正绿门前树，积水都清涧下川。\n坐断千峰因底事，身轻百劫本何缘。\n箯舆有客登临久，斋罢茗盂香散烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"平山","author":"韩淲","text":"章泉粥罢上松关，野径田塍直复弯。\n迫晚诗翁来款曲，同时坐客亦跻攀。\n谁云身外无穷事，自是人间有许闲。\n梦兀箯舆忘远近，午风晴日已平山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山静","author":"韩淲","text":"山静不嫌鸡犬声，閒身随意了阴晴。\n柴扉终日其谁问，梅径有时还自行。\n一曲涧流虽浅澹，数株花蕊甚分明。\n床头周易初无恙，酒困茶醒底用情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山林","author":"韩淲","text":"山林终日掩柴门，近听风声远对云。\n粗有稻粱供伏腊，尚凭鸡犬报朝曛。\n气非身外无存想，书在眼前多见闻。\n客至不劳闲酒食，一瓯茶炷一炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛洪川","author":"韩淲","text":"葛洪川畔试寻诗，圆泽精魂世孰知。\n但见野僧相指点，独怜游子转伤悲。\n湍流涧水侵苔藓，磊落山岩拂树枝。\n我亦赏吟风月尔，人间今古信如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十八日宋家泉头","author":"韩淲","text":"每逢泉石必从容，閒过吾庐绝涧东。\n簸弄泓澄看硌确，盘旋窈窕喜蒙笼。\n近村欲雨无斜日，远岫归云有阵风。\n白酒酿成谁酌我，濯缨洗耳不须同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春泉","author":"韩淲","text":"幽伴无人话采樵，老身何处可逍遥。\n閒当晓径谁争席，间或春泉自一瓢。\n煖霭欲销迟日在，轻风徐起乱云飘。\n才情今古能多少，未必巢由不见尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山行","author":"韩淲","text":"家住疏疏短短篱，并山支径自登跻。\n寒云四垂天惨惨，老木环锁风凄凄。\n身从荒园叩古寺，眼暗孤城带清溪。\n寻僧与客少谈胜，兴罢归来乌夜啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初八日登前山独坐久之","author":"韩淲","text":"阴阴秋与白云浮，山近林深上上头。\n千里才成万家邑，百川分绕一方州。\n其间鸡犬微茫处，此外鹍鹏莽旷游。\n明日黄花是重九，更寻桥月看溪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜同处晦霞山","author":"韩淲","text":"春来不道梅花好，古观荒林并晚晴。\n一一枝间见生意，重重影外落寒声。\n酒因人胜舒徐饮，诗待客吟萧散成。\n扶尽墟烟横野水，暗涵深绿起疏明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵晁仲二同仓使游灵岩","author":"韩淲","text":"使华春入梵王宫，仿佛工颦在眼中。\n邂逅五湖应自适，纵横七国漫争雄。\n一时宾从欢无极，千古兴亡恨莫穷。\n空锁灵岩旧踪迹，画船赢得满篙风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同昌甫游瑞应峰一宿次韵","author":"韩淲","text":"十载尝同望此山，雅怀幽意颇相关。\n岂期苔竹随公去，应笑钱塘见我还。\n洗梦唐人诗句里，惊霄前哲石碑间。\n秋风古寺一杯酒，老觉心情只欲閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过南豅","author":"韩淲","text":"舣舟溪岸入山居，步稳秋原木影疏。\n尽日极知无市井，此身终是乐樵渔。\n鸟声自占庭前树，岚气时侵案上书。\n尊酒故人情味别，留连应喜到门初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]