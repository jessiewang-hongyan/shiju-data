[{"title":"第九十七投子月圆颂","author":"释义青","text":"圆缺曾伸问老翁，石龟衔子引清风。\n昨朝木马潭中过，踏出金乌半夜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十八芭蕉拄杖颂","author":"释义青","text":"有无今古两重关，正眼禅人过者难。\n欲通大道长安路，莫听昆崙叙往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十九浮山绣毬颂","author":"释义青","text":"月里无根草，山前枯木花。\n雁回沙塞后，砧杵落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第一百浮山骨堆颂","author":"释义青","text":"嫩草疏斜径，山泉带碧流。\n文曾要渭水，列士耻庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其一","author":"释义青","text":"正中偏，星河横转月明前。\n彩气夜变天未晓，隐隐俱彰暗里圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其二","author":"释义青","text":"偏中正，夜半天明羞自影。\n朦朦雾色辨何分，混然不落秦时镜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其三","author":"释义青","text":"正中来，火里金鸡坐凤台。\n玄路倚空通脉上，披云乌道出尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其四","author":"释义青","text":"兼中至，雪刃笼身不回避。\n天然猛将两不伤，暗里全施善周备。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其五","author":"释义青","text":"兼中到，解走之人不触道。\n一般拈掇与君殊，不落是非方始妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游鄠山诗十二首 白云道中","author":"程颢","text":"吏身拘绊同疏属，俗眼尘昏甚瞽矇。\n辜负终南好泉石，一年一度到山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游鄠山诗十二首 马上偶成","author":"程颢","text":"身劳无补公家事，心冗空令学业衰。\n世路崄巇功业远，未能归去不男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游鄠山诗十二首 游紫阁山","author":"程颢","text":"仙掌远相招，萦纡渡石桥。\n瞑云生涧底，寒雨下山腰。\n树色千层乱，天形一罅遥。\n吏纷难久驻，回首羡渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游鄠山诗十二首 猕猴","author":"程颢","text":"闻说猕猴性颇灵，相车来便满山迎。\n鞭羸到此何曾见，始觉毛虫更世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高观谷","author":"程颢","text":"轰雷叠鼓响前峰，来自彤云翠蔼中。\n洞壑积阴成气象，鬼神凭暗弄威风。\n喷崖雨露千寻湿，落石珠玑万颗红。\n纵有虬龙难驻足，还应不是旱时功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂","author":"程颢","text":"参差台殿绿云中，四面筼筜一径通。\n曾读华阳真诰上，神仙居在碧琳宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂 长啸岩中得冰以石敲餐甚佳","author":"程颢","text":"车倦人烦渴思长，岩中冰片玉成方。\n老仙笑我尘劳久，乞与云膏洗俗肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂 游重云","author":"程颢","text":"久厌尘笼万虑昏，喜寻泉石暂清神。\n目劳足倦深山里，犹胜低眉对俗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂 长啸洞北回望大顶如列屏幛比到山前却不见盖为仙掌所蔽","author":"程颢","text":"行尽重云几曲山，回头方见碧峰寒。\n天将仙掌都遮断，元恐尘中俗眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂 凌霄三峰","author":"程颢","text":"长啸岩东古寺前，三峰相倚势相连。\n偶逢云静得见日，若有路通须近天。\n阴吹响雷生谷底，老松如箸见崖颠。\n结根不得居平地，犹与莲花远比肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂 云际山","author":"程颢","text":"南药东边白阁西，登临身共白云齐。\n上方顶上朝来望，陡觉群峰四面低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂 下山偶成","author":"程颢","text":"襟裾三日绝尘埃，欲上篮舆首重回。\n不是吾儒本经济，等闲争肯出山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"是游也得小松黄杨各四本植于公署之西窗戏作五绝呈邑令张寺丞 其一","author":"程颢","text":"中春时节百花明，何必繁弦列管声。\n借问近郊行乐地，潢溪山水照人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"是游也得小松黄杨各四本植于公署之西窗戏作五绝呈邑令张寺丞 其二","author":"程颢","text":"心闲不为管弦乐，道胜岂因名利荣。\n莫谓冗官难自适，暇时还得肆游行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"是游也得小松黄杨各四本植于公署之西窗戏作五绝呈邑令张寺丞 其三","author":"程颢","text":"功名不是关心事，富贵由来自有天。\n任是榷酤亏课利，不过抽得俸中钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"是游也得小松黄杨各四本植于公署之西窗戏作五绝呈邑令张寺丞 其四","author":"程颢","text":"有生得遇唐虞圣，为政仍逢守令贤。\n纵得无能闲主簿，嬉游不负艳阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"是游也得小松黄杨各四本植于公署之西窗戏作五绝呈邑令张寺丞 其五","author":"程颢","text":"狱讼已闻冤滞雪，田农还喜土膏匀。\n只应野叟犹相笑，不与溪山作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雪","author":"程颢","text":"二月将临尾，群阴久退潜。\n只知桃李艳，何复雪霜嫌。\n密霰仍先集，飘霙忽散沾。\n带风成料峭，和雨作廉纤。\n江汉初弥望，珠玑亦间兼。\n片痕才著瓦，斜势渐穿帘。\n鸟化辽城鹤，途铺越女缣。\n落英时斗舞，飞絮或同黏。\n直把琼瑶比，谁疑鹄鹭挦。\n透肌锥共利，洒面刃争铦。\n寒怯开闱赏，光凝伴月觇。\n价增樵市炭，兴入酒家帘。\n驻足银妆履，昂头玉裹髯。\n如何欺煦律，重复困穷阎。\n薪乏经朝备，衣因恃暖拈。\n撷芳游女恨，忧岁老农占。\n惜竹频敲叶，愁花旋覆苫。\n失权悲太皞，助虐有飞廉。\n骤降初疑勇，旋消亦讶谦。\n朔云虽借便，水后可无厌。\n纵任阴灵巧，难令木气歼。\n寒威徒自奋，春气亦时添。\n积势方平垄，澌流已坠檐。\n暗空犹沓沓，近地即佔佔。\n远水难遮面，高峰不裹尖。\n著墙聊画粉，盖地岂成盐。\n纨扇惊尘曀，昆岗认火炎。\n端来荐融释，空复助洳渐。\n积润终滋嫩，惊雷亦震淹。\n东君莫惆怅，杲日待重瞻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春","author":"程颢","text":"人生百年永，光景我逾半。\n中间几悲欢，况复多聚散。\n青阳变晚春，弱条成老干。\n不为时节惊，把酒欲谁劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花菊","author":"程颢","text":"仙人绀发粉红腮，近自武陵源上来。\n不比常花羞晚发，故将春色待秋开。\n存留金蕊天偏与，漏泄春香众始猜。\n兼得佳名共坚节，晓霜还独对楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早寒","author":"程颢","text":"一夜威霜特地严，朝来寒气入书帘。\n乍须火暖亲炉兽，初觉冰澌结砚蟾。\n败叶卷风轻蔌蔌，远峰经晓静尖尖。\n出门未要貂狐燠，且著轻裘次第添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新晴野步 其一","author":"程颢","text":"青帝方成万物春，如何淫雨害芳晨。\n乞求共指云间日，悔恨轻嫌陌上尘。\n消尽风威犹料峭，放开山色已嶙峋。\n燕游莫道王孙乐，亦有羲皇更上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新晴野步 其二","author":"程颢","text":"阴曀消除六幕宽，嬉游何事我心闲。\n鸟声人意融和候，草色花芳杳蔼间。\n水底断霞光出岸，云头斜日影衔山。\n缘情若论诗家兴，却恐骚人合厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖","author":"程颢","text":"潩水桥边鸭子陂，楼台只在郡城西。\n烟波乍见心先快，岛屿将寻路欲迷。\n尽日无风横舴艋，有时经雨饮虹霓。\n如何咫尺尘埃地，能使游人意不齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"环翠亭","author":"程颢","text":"城居不见万山重，因起高亭破远空。\n虚旷直疑天宇外，周旋如在画屏中。\n凝岚散蔼层层出，削玉排青面面同。\n暂得登临已忘去，四时佳致属贤公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月","author":"程颢","text":"云静好风吹，清光溢四垂。\n金行方盛日，阴魄正中时。\n彷佛窥瑶阙，分明露桂枝。\n遴英同醉赏，谁复叹官羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"象戏","author":"程颢","text":"大都博奕皆戏剧，象戏翻能学用兵。\n车马尚存周战法，偏裨兼备汉官名。\n中权八面将军重，河外尖斜步卒轻。\n却凭纹楸聊自笑，雄如刘项亦闲争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日访张子直承出看花戏书学舍五首 其一","author":"程颢","text":"平日邀相见，过门又不逢。\n贪随看花伴，应笑我龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日访张子直承出看花戏书学舍五首 其二","author":"程颢","text":"须知春色醲于酒，醉得游人意自狂。\n直使华颠老公子，看花争入少年场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日访张子直承出看花戏书学舍五首 其三","author":"程颢","text":"贪花自是少年事，沉酒定嫌醒者非。\n顾我疏慵老山野，却骑归马背斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日访张子直承出看花戏书学舍五首 其四","author":"程颢","text":"下马问老仆，言公赏花去。\n只在近园中，业深不知处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日访张子直承出看花戏书学舍五首 其五","author":"程颢","text":"桃李飘零杏子青，满城车马响春霆。\n就中得意张公子，十日花前醉不醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王求甫铁如意","author":"程颢","text":"妖言莫信传张恶，虚气休将碎唾壶。\n借问闲窗静狐背，何如争胜击珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕晦叔赴河阳","author":"程颢","text":"晓日都门飐旆旌，晚风铙吹入三城。\n知公再为苍生起，不是寻常刺史行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠司马君实","author":"程颢","text":"二龙闲卧洛波清，今日都门独饯行。\n愿得贤人均出处，始知深意在苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪陆子履游白石万固","author":"程颢","text":"条山苍苍河流黄，中蒲形势天下彊。\n帝得贤侯殿一方，四年不更慰民望。\n元丰戊午季春月，上心闵雨愁黎苍。\n使车四出走群望，我亦奉命来侯疆。\n情诚感格天意顺，诏书才下雨已霶。\n病麦还青禾出土，野农鼓舞歌君王。\n故人相见不道旧，为雨欢喜殊未央。\n圣主宽忧小臣乐，自可放荡舒胸肠。\n白石万固皆胜地，主人为我携壶觞。\n况逢佳日俗所尚，车马未晓填康庄。\n扶提十里杂老幼，迤逦千骑明戈枪。\n初听鸣铙入青霭，渐见朱旆辉朝阳。\n遨头自是谢康乐，后乘独惭元漫郎。\n侯来虽知有宾客，众喜更为将丰穰。\n临溪坐石遍岩谷，幽处往往闻丝簧。\n山光似迎好客动，日景定为游人长。\n乘高望远兴不尽，恋恋不知歧路忙。\n人生汨没苦百态，得此乐事真难常。\n我辞佳境已惆怅，侯亦那得久此乡。\n他时会合重相语，辜负泉石何能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题","author":"程颢","text":"曾是去年赏春日，春光过了又逡巡。\n却是去年春自去，我心依旧去年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和家君早寒之什","author":"程颢","text":"满地清霜结晓寒，平明飞霰洒柴关。\n乍凭酒力温肌骨，陡觉风威著面颜。\n闾里相呼泥北户，牛羊收牧下前山。\n急须趁日藏薪炭，冻后高枝不易攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和咏草","author":"程颢","text":"渐觉东皇意思匀，陈根初动夜来新。\n忽惊平地有轻绿，已盖六街无旧尘。\n莫为枯荣吟野草，且怜愁醉柅香轮。\n诗人空怨王孙远，极目萋萋又一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邵尧夫打乖吟二首 其一","author":"程颢","text":"打乖非是要安身，道大方能混世尘。\n陋巷一生颜氏乐，清风千古伯夷贫。\n客求墨妙多携卷，天为诗豪剩借春。\n尽把笑谈亲俗子，德容犹足慰乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邵尧夫打乖吟二首 其二","author":"程颢","text":"圣贤事业本经纶，肯为巢由继后尘。\n三币未回伊尹志，万钟难换子舆贫。\n且因经世藏千古，已占西轩度十春。\n时止时行皆有命，先生不是打乖人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和尧夫首尾吟","author":"程颢","text":"先生非是爱吟诗，为要形容至乐时。\n醉里乾坤都寓物，闲来风月更输谁。\n死生有命人何与，消长随时我不悲。\n直到希夷无事处，先生非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和尧夫西街之什二首 其一","author":"程颢","text":"先生相与赏西街，小子亲携几杖来。\n行次每容参剧论，坐隅还许侍馀杯。\n槛前流水心同乐，林外青山眼重开。\n时泰身闲难两得，直须乘兴数追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和尧夫西街之什二首 其二","author":"程颢","text":"先生高蹈隐西街，风月犹牵赋咏才。\n暂到邻家赏池馆，便将佳句写琼瑰。\n壮图已让心先快，剧韵仍降字占挼。\n只有一条誇大甚，水边曾未两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游月陂","author":"程颢","text":"月陂堤上四徘徊，北有中天百尺台。\n万物已随秋气改，一樽聊为晚凉开。\n水心云影闲相照，林下泉声静自来。\n世事无端何足计，但逢佳日约重陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日偶成二首 其一","author":"程颢","text":"寥寥天气已高秋，更倚凌虚百尺楼。\n世上利名群蠛蠓，古来兴废几浮沤。\n退居陋巷颜回乐，不见长安李白愁。\n两事到头须有得，我心处处自优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代少卿和王宣徽游崇福宫","author":"程颢","text":"睿祖开真宇，祥光下紫微。\n威容凝粹穆，仙仗俨周围。\n嗣圣严追奉，神游遂此归。\n冕旒临秘殿，天日照西畿。\n朱凤衔星盖，清童护玉衣。\n鹤笙鸣远吹，珠蕊弄晴晖。\n瑶草春常在，琼霜晓未晞。\n木文灵像出，太一醴泉飞。\n醮夕思飙驭，香晨望绛闱。\n衰迟愧宫职，萧洒自忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王安之五首 小园","author":"程颢","text":"閒坊西曲奉常家，景物天然占一窊。\n恰似庾园基址小，全胜浥涧路途赊。\n知君陋巷心犹乐，比我侨居事已誇。\n且喜杖藜相过易，隔墙无用少游车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王安之五首 野轩","author":"程颢","text":"谁怜大第多奇景，自爱贫家有古风。\n会向红尘生野思，始知泉石在胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王安之五首 污亭","author":"程颢","text":"强洁犹来真有为，好高安得是无心。\n污亭妙旨君须会，物我何争事莫侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王安之五首 药轩","author":"程颢","text":"囊中数味应千种，砌下栽苗过百名。\n好是微风入庭户，清香交送满檐楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚晖亭","author":"程颢","text":"亭下花光春正好，亭头山色晚尤佳。\n欲知剩占清风处，思顺街东第一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和花庵","author":"程颢","text":"得意即为适，种花非贵多。\n一区才丈席，满目自云萝。\n静听禽声乐，闲招月色过。\n期公在康济，终奈此情何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子直示以新诗一轴偶为四韵奉谢","author":"程颢","text":"治剧君能佚，居闲我更慵。\n自惟降藻丽，不解断舂容。\n寡和知高唱，深情见古风。\n静吟梁甫意，真似卧隆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和诸公梅台","author":"程颢","text":"急须乘兴赏春英，莫待空枝谩寄声。\n淑景暖风前日事，淡云微雨此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后一日再和","author":"程颢","text":"常劝嬉游须及辰，莫辞巾屦染埃尘。\n秪应风雨梅台上，已减前时一半春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日江上","author":"程颢","text":"新蒲嫩柳满汀洲，春入渔舟一棹浮。\n云幕倒遮天外日，风帘轻飏竹间楼。\n望穷远岫微茫见，兴逐归槎汗漫游。\n不畏蛟螭起波浪，却怜清泚向东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下白径岭先寄孔周翰郎中","author":"程颢","text":"骤经微雨过芳郊，转觉长河气象豪。\n归骑已登吴坂峻，飞云犹认华山高。\n门前岐路通西国，城上楼台压巨涛。\n欲问甘棠旧风化，主人邀客醉香醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]