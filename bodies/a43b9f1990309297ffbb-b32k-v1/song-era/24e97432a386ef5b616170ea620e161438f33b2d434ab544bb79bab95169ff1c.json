[{"title":"凤池山","author":"元绛","text":"州人未识凤池山，朱毂时来此往还。\n四坐杯盘在天上，满轩云雨落人间。\n千围老木排旌盖，百尺飞泉响佩环。\n谁为霜绡图景象，翠微高处一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊戌清明在吴去春阅武于河朔今被召参贰大农悦然有感","author":"元绛","text":"前载赏花乡国中，三行粉面绮罗红。\n去看持斧边城下，十万军声鼓吹雄。\n每岁春辉长忽忽，此时朝骑又匆匆。\n却将半暗尘沙眼，去看东都御柳风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石伞峰书堂","author":"元绛","text":"奇峰如伞见遥青，玉笥山头地有灵。\n三径荒凉丞相隐，一篇清绝放夫铭。\n孤标竦处天门近，直影圆时日御停。\n谁蹑岩梯访遗迹，远孙高谢在鸿冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和君贶会赵叔平少师","author":"元绛","text":"黄发逍遥并旧臣，燕閒加意占先春。\n成龙天外惟三友，积雪筵中止数人。\n昔日荐才闻最课，当年诵赋得魁伦。\n会须共作游河侣，五老星飞事更新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过牛光禄故居","author":"元绛","text":"白头重到故人家，境是人非起叹嗟。\n三径未荒陶令菊，四时长放庾郎花。\n林风光动藏莺叶，溪涨痕生宿鹭沙。\n肯构有材移病久，会凭诗酒傲烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诏修两朝国史开局日赐筵史院和首相吴公席上韵","author":"元绛","text":"殿帷昕对罢，省户雨阴馀。\n诏赐尧尊酒，人探禹穴书。\n夔龙方客右，班马盖徒欤。\n径醉俄归弁，云西见日车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和圣徒洛中九老会","author":"元绛","text":"五日佳辰郡政闲，延宾谈笑豁幽关。\n阊门歌舞尊罍上，林屋烟霞指顾间。\n德应华星临颍尾，年拘皓发下商颜。\n名花美酒疏钟永，坐见斜晖隐半山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅龙图游西湖见寄","author":"元绛","text":"湖上喜明霁，寻春偶啸俦。\n花多红夹马，山远翠藏楼。\n水气烟中合，风光草际流。\n都人待千骑，快作谢公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"元绛","text":"闽山过尽见吴山，三载天涯五马还。\n旧列未归青琐闼，馀生方入玉门关。\n林峦迤逦平无数，星斗阑干近可攀。\n回首冶城何处所，只应烟雨渺茫间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将去郡席上呈同僚","author":"元绛","text":"在官七百二十日，只为台州不为身。\n民事勤劳心力尽，世涂忧畏鬓华新。\n离筵欲醉樽前月，美景难留洞口春。\n他日相逢应更好，诸君皆是眼中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵潜叔殉节诗","author":"元绛","text":"转战谯门日再晡，空拳犹自冒戈殳。\n身垂虎口方安坐，命弃鸿毛更疾呼。\n柱下杲卿存断节，裤间杵臼得遗孤。\n可怜三尺英雄气，不愧西山士大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赠太常少卿封川曹使君觐","author":"元绛","text":"仓卒蛮鼙上水滨，使君忠愤独亡身。\n平明戈剑摧城阖，俄顷衣冠落路尘。\n志士一门能许国，老夫当日亦知人。\n朝廷赠襚哀荣极，青骨千金合有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐晚景","author":"元绛","text":"向晚西风急，扁舟下濑轻。\n帆樯挂山影，鼓吹压潮声。\n白鸟烟中没，斜阳雨外明。\n油然五湖意，浑欲薄功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鼓山元公亭","author":"元绛","text":"谁书吾姓揭亭颜，栋宇飞腾气象完。\n谷口秋风吹鬓发，海东朝日上阑干。\n地高顿觉群山小，天近须知六合宽。\n三到岩扉殊不厌，异时长向画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因览状元节推和诗再和一首","author":"元绛","text":"缇籥惊年杪，铃斋戒夙兴。\n连空集霙霰，撇席命宾朋。\n菌阁盘虚出，箯舆选胜登。\n山川方晻蔼，缟素竞飞腾。\n密著珠帘重，低沈粉水澄。\n迷藏秦洞穴，刻镂禹沟塍。\n蓬岛三番抃，瑶峰四彻绳。\n风传天外籁，湖写鉴中冰。\n银色三千界，琳台十二层。\n折梅思陆凯，咏絮对王凝。\n妒舞轻飘燕，临书细字蝇。\n光凌射的鹤，气压沃洲鹰。\n棹月溪翁共，歌兰楚客能。\n琼辀走油壁，练马顿钩膺。\n泽渗阳膏动，和薰气烛蒸。\n冬权时已正，尺瑞岁将应。\n鄙也同民乐，油然弗自胜。\n平时陪法从，长忆奉昭陵。\n拂旦开金殿，鸣鞘下玉乘。\n六花朝服满，万岁寿觞称。\n就望尧云日，赓歌舜股肱。\n冰醪沾饫赐，竹唱听哀矜。\n尔后孤踪远，频年老病仍。\n两朝还观魏，何日见觚棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"元绛","text":"四十年来出处同，交情偏见岁寒中。\n相先各上青云路，斗在俱为白发翁。\n万里厌劳方稍稍，一麾乘兴又匆匆。\n清风冠剑辞仙殿，流水旌旗下越宫。\n山半楼台迎日动，帐前铙鼓入秋雄。\n因君更忆蓬莱雪，不觉吟魂过剡东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚勔《奉陪蓬莱阁赏雪赋诗谨成二十四韵呈知府龙图侍郎》","author":"元绛","text":"晼晚年垂尽，阴沈气始凝。\n云霄方一色，霰雪忽相仍。\n何处兹辰好，吾州自古称。\n稽山呈刻画，鉴水弄鲜澄。\n佛土横银界，天文露玉绳。\n缏珠压帘翠，砻璧累台层。\n昆露朝垂木，郇盐夕满塍。\n浓梅明庾岭，乱蝶闹青陵。\n舞缓来还转，惊多下忽腾。\n藏崖未见睍，著霤即垂冰。\n密处情何极，狂时力不胜。\n夺鲜迷野鹤，污白绝藩蝇。\n孙幌方开卷，焦庐正曲肱。\n悲鸣跧老骥，怒击下豪鹰。\n顾我虽迟暮，当欢亦彊能。\n醉怀思日富，病眼喜晨兴。\n贺帐催休吏，宾筵幸得朋。\n周诗诵昌满，邺酌对刘应。\n赏为良辰乐，高宜善赋登。\n鹴裘欣未至，青简使先蒸。\n富岁还相庆，阳春各自矜。\n?颜均玉气，泚墨出圭棱。\n句待呼胡续，舟期访戴乘。\n长谣辱君赠，珍感服吾膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和上巳西湖胜游","author":"元绛","text":"清明风日战方酣，朱毂雍容拥旆鬖。\n火令正严绵上俗，禊游仍胜会稽岩。\n马盘金埒连乾湿，人映毡车帽角搀。\n湖水绿烟浮醉席，杏花红雨拂春衫。\n公如庾老情非浅，客似渊君调不凡。\n只恐颍川飞召节，便随五凤降绨函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢京师故人","author":"元绛","text":"丹荔黄甘北苑茶，劳君诱我向天涯。\n争如太液楼边看，池北池南总是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题秀野亭","author":"元绛","text":"亭占青山口，郊原四望平。\n遥林连崦黑，白水隔田明。\n翠麦波涛动，飞泉剑佩轻。\n长年便野趣，拟欲解尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"映山红慢","author":"元绛","text":"谷雨风前，占淑景、名花独秀。\n露国色仙姿，品流第一，春工成就。\n罗帏护日金泥皱。\n映霞腮动檀痕溜。\n长记得天上，瑶池阆苑曾有。\n千匝绕、红玉阑干，愁只恐、朝云难久。\n须款折、绣囊剩戴，细把蜂须频嗅。\n佳人再拜抬娇面，敛红巾、捧金杯酒。\n献千千寿。\n愿长恁、天香满袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"元绛","text":"绿杨阴下。\n短帽轻衫行信马。\n过尽春风。\n踏尽青青打尽红。\n舞鸾歌凤。\n人面湖光红影动。\n醉眼归时。\n人在朱楼曲角西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"元绛","text":"九重侍从三明主，四纪乾坤一老臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"元绛","text":"过庐都失眼前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"元绛","text":"笙歌车马东方晓，风月山川北固凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"元绛","text":"使君麾盖傲烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十五","author":"元绛","text":"五蓂开端荚，百草斗香苕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"元绛","text":"何人更得通天带，谋合君心只晋公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十六","author":"元绛","text":"五日看花怜并叶，今朝斗草得宜男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十八","author":"元绛","text":"丝竹渐高桡鼓急，瑶津亭下竞凫车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"元绛","text":"仙骥籋云穿仗下，佛花吹雨匝天流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"元绛","text":"英翰五五出南闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"元绛","text":"玉露精神山合沓，溪成文字水横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"元绛","text":"花阴转午清风细，玉燕钗头艾虎轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"元绛","text":"陈前舆服同桓傅，拜后金珠有鲁公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"元绛","text":"可惜闽州风物好，一生魂梦到三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"元绛","text":"黄阁势连东凤阙，紫枢光直右银台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"元绛","text":"联名适似三株树，传玩惊看五朵云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十七","author":"元绛","text":"菖酒朝觞满，兰汤晓浴温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"元绛","text":"神石溪头好明月，夜来谁此凭兰桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题胶山寺壁","author":"元掔","text":"岗头鹁鸠鸣，定欲唤晴雨。\n驱车指东山，山下寺亦古。\n道人双眼青，雪齿起柔语。\n松回万壑风，落絮趁轻舞。\n日薄咏归欤，扁舟在烟渚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁后书怀","author":"元溥","text":"他乡故乡老若此，新岁旧岁穷依然。\n烹茶但有二升水，沽酒初无三百钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄公择还故山","author":"元溥","text":"惜解鸥边缆，愁分柳下襟。\n柴荆方永昼，草树复连阴。\n煮茗泉须沽，烧香火放深。\n是中真富贵，莫受二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敬礼瓦屋和尚塔偈","author":"勾令玄","text":"大空无尽劫成尘，玄步孤高物外人。\n日本国来寻彼岸，洞山林下过迷津。\n流流法乳谁无分，了了教知我最亲。\n一百六十三岁后，方于此塔葬全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延庆宫","author":"勾台符","text":"一簇楼台地，嵯峨四面函。\n路盘七折岭，坐对六时岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿上清宫","author":"勾台符","text":"寄宿翠微颠，身疑入半天。\n晓钟鸣物外，残月落岩前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"勾台符","text":"胚浑凿开元精结，三十六峰排截嶭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"勾台符","text":"无叶滋春色，有花开晚红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"勾台符","text":"料得桓温登剑阁，便抛李势入岷山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"勾台符","text":"松门开碧嶂，五甃锁清泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"勾台符","text":"酷爱青城好山色，终年不出白云门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"勾台符","text":"右执范贤袂，左拍薛昌肩。\n举头傲白日，长啸揭青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙太冲守怀安","author":"勾龙如渊","text":"金沙春三月，桃李照城郭。\n石峡赪鲤鱼，时时醉宾幕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"化州","author":"化州郡守","text":"罗川带郭古南州，陵水环城小庾楼。\n云淡青林无过雁，雨涵丹荔集鸣鸠。\n叨荣铜竹三经夏，劝课农桑屡有秋。\n好趁湍流下吴会，章台无柳系归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"化禅师","text":"翠竹黄花非外境，白云明月露全真。\n头头尽是吾家物，信手拈来不是尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与客西湖上感事","author":"区仕衡","text":"湖头双桨藕花新，五嫂鱼羹曲院春。\n只道西陵松柏下，繁台宾客更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长林馆","author":"区仕衡","text":"司空修史王官谷，贞白藏书句曲山。\n我愧汗青无日就，深林空自掩柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竹花","author":"区仕衡","text":"风摇衡浦岸边凉，露结江皋叶上霜。\n小玉移来窗槛里，不胜愁思满潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岭南大雪","author":"区仕衡","text":"海冻珊瑚万里沙，炎方六出尽成花。\n洛阳纵有行春令，谁问袁安处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻张山翁入黄鹄山","author":"区仕衡","text":"采薇黄鹄岭，投迹去无踪。\n我亦从今逝，浮云四百峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻徐右史暴亡","author":"区仕衡","text":"议论风生神采端，一身不保更论官。\n泉台此恨谁能诉，雪涕空山白日寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读景炎福州诏书","author":"区仕衡","text":"多难兴邦海舰移，忽逢祀夏配天时。\n小臣不死留双眼，东向行都望六师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧叶二子夜过","author":"区仕衡","text":"褐衣曾替衮衣愁，肉食谁知藿食忧。\n斩马尚方无可借，夜深灯下看吴钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬吕监簿叔朝垂示试草","author":"区仕衡","text":"礼乐三千不可闻，彤墀诸草似刘蕡。\n莫嗟起部官犹左，尺疏公田赖有君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠稠长老","author":"区仕衡","text":"双树林间结草庵，拈花一笑拜瞿昙。\n玄风橡栗餐亭午，堂下门徒且放参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"区仕衡","text":"南渡衣冠废蒯缑，中原尽载向湖游。\n胡尘不谓飞滇海，鬼火何因暗鄂州。\n竟使兵家劳策画，到今国是计恩仇。\n草茅死未忘哀愤，岂但燕云恨白沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五十","author":"区仕衡","text":"早衰方五十，短发已成翁。\n客向閒居谢，诗因老病工。\n残更啼络纬，细雨落梧桐。\n明日晴当出，看山兴未穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金坛遇刘宰","author":"区仕衡","text":"故人逢傲吏，问驿下西关。\n制锦谁能似，鸣琴尔自闲。\n京江三国地，斗野五州山。\n去矣繁霜鬓，烟波照白纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还家","author":"区仕衡","text":"刍荛计已非，戆直得全稀。\n久病畏风露，深居思蕨薇。\n豹藏宁是隐，鸟倦早知归。\n但有黔娄妇，犹堪老布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建昌憩李尚书山房","author":"区仕衡","text":"旧里鸣珂一下车，蓬山西观更谁如。\n木天清梦何人到，花雨空林有客居。\n楼迥更堪看蠡泽，云深犹自护匡庐。\n高斋曲馆新增色，读尽尚书万卷馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柴门","author":"区仕衡","text":"岂少安危事，柴门独倚楼。\n溪才通舴艋，林已叫钩辀。\n归鬓霜俱落，冥心水不流。\n荆轲何用咏，剑术转堪羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭酒慈溪公以月令劝讲兼示诸生感事有作","author":"区仕衡","text":"按月明堂令，斋居古自稽。\n四时曾不忒，七政已能齐。\n礼向经帷奏，笺来学省题。\n元龟何用卜，伯起在关西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]