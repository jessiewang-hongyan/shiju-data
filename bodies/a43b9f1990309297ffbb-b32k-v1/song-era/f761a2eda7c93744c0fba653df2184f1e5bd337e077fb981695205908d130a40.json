[{"title":"题持约画轴","author":"陈与义","text":"日落川更阔，烟生山欲浮。\n舟中有闲地，载我得同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵少隐青白堂三首 其三","author":"陈与义","text":"雪里芭蕉摩诘画，炎天梅蕊简斋诗。\n它时相见非生客，看倚琅玕一段奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵少隐青白堂三首 其二","author":"陈与义","text":"使君堂上无俗客，白白青青两胜流。\n添得吟诗老居士，千年一笑泽南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵少隐青白堂三首 其一","author":"陈与义","text":"小谢为州不废诗，庭中草木有光辉。\n一林风露非人世，更著梅花相发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题继祖蟠室三首 其三","author":"陈与义","text":"中兴天子要人才，当使生擒颉利来。\n正待吾曹红抹额，不须辛苦学颜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题继祖蟠室三首 其二","author":"陈与义","text":"万卷吾今一字无，打包随处野僧如。\n短檠未尽残年债，欲问班生试借书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题继祖蟠室三首 其一","author":"陈与义","text":"云起炉山久未移，功名不恨十年迟。\n日斜疏竹可窗影，正是幽人睡足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题崇兰图二首 其二","author":"陈与义","text":"奕奕天风吹角巾，松声水色一时新。\n山林从此不牢落，照影溪头共六人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题崇兰图二首 其一","author":"陈与义","text":"两公得我色敷腴，藜杖相将入画图。\n我已梦中都识路，秋风举袂不踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡岳道中 其二","author":"陈与义","text":"客子山行不觉风，龙吟虎啸满山松。\n纶巾一幅无人识，胜业门前听午钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡岳道中 其四","author":"陈与义","text":"危亭见上方，林壑带残阳。\n今日岂无恨，重游却味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"襄邑道中","author":"陈与义","text":"飞花两岸照船红，百里榆堤半日风。\n卧看满天云不动，不知云与我俱东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日家中","author":"陈与义","text":"风雨吴江冷，云天故国赊。\n扶头呼白酒，揩眼认黄花。\n客梦蛩声歇，边心雁字斜。\n明年又何处，高树莫啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月","author":"陈与义","text":"十月北风催岁阑，九衢黄土污儒冠。\n归鸦落日天机熟，老雁长云行路难。\n欲诣热官忧冷语，且求浊酒寄清欢。\n孤吟坐到三更月，枯木无枝不受寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又用韵春雪","author":"陈与义","text":"急雪催诗兴未阑，东风肯奈鸟乌寒。\n最怜度牖勤勤意，更接飞花细细看。\n连夜抛回三白瑞，及时惊动五辛盘。\n袁安久绝千人望，春破还思绮一端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和岁除感怀用前韵","author":"陈与义","text":"宦情吾与岁俱阑，只有诗盟偶未寒。\n鬓色定从今夜改，梅花已判隔年看。\n高门召客车稠叠，下里烧香篆屈盘。\n我亦三杯聊复尔，梦回鹓鹭出朝端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万玉亭","author":"陈与义","text":"万玉中间作此亭，规模虽小意高深。\n稚篁畏日生檐下，老树禁风长绿阴。\n不道官中尽汤火，谁知闹里有山林。\n公馀独在斜阳外，百岁顽身万古心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十日闻德音寄李德升席大光新有召命皆寓永州","author":"陈与义","text":"尘隔斗牛三月馀，德音再与万方初。\n又蒙天地宽今岁，且扫轩窗读我书。\n自古安危关政事，随时忧喜到樵渔。\n零陵并起扶颠手，九庙无归计莫疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与大光同登封州小阁","author":"陈与义","text":"去程欲数莽难知，三日封州更作迟。\n青嶂足稽天下士，锦囊今有峤南诗。\n共登小阁春风里，回望中原夕霭时。\n万本梅花为我寿，一杯相属未全痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小阁","author":"陈与义","text":"栏干横岁暮，徙倚度阴晴。\n木落太湖近，梅开南纪明。\n病馀仍爱酒，身后更须名。\n鹳鹤忽双起，吾诗还欲成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"陈与义","text":"当复入州宽作期，人间踏地有安危。\n风流丘壑真吾事，筹策庙堂非所知。\n白水春陂天澹澹，苍峰晴雪锦离离。\n恰逢居士身轻日，正是山中多景时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山斋 其一","author":"陈与义","text":"夏郊绿已遍，山斋昼自迟。\n云物忽分散，馀碧暮逶迤。\n寒暑送万古，荣枯各一时。\n世纷幸莫及，我麈得常持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山斋 其二","author":"陈与义","text":"虽愧荷锄叟，朝来亦不闲。\n自剪墙角树，尽纳溪西山。\n经行天下半，送老此窗间。\n日暮烟生岭，离离飞鸟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以事走郊外示友","author":"陈与义","text":"二十九年知已非，今年依旧壮心违。\n黄尘满面人犹去，红叶无言秋又归。\n万里天寒鸿雁瘦，千村岁暮鸟乌微。\n往来屑屑君应笑，要就南池照客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元方用韵见寄次韵奉谢兼呈元东 其二","author":"陈与义","text":"一欢玄发水东流，两脚黄尘阅几州。\n王湛时须看周易，虞卿未敢著春秋。\n不辞彭泽腰常折，却得邯郸梦少留。\n有句惊人虽可喜，无钱使鬼故宜休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元方用韵见寄次韵奉谢兼呈元东 其一","author":"陈与义","text":"大难词源三峡流，小难诗不数苏州。\n了无徐生齐气累，正值宁子商歌秋。\n鹄飞千里从此始，骥绝九衢谁得留。\n岁晚烦君起我病，两篇三叹不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元方用韵寄若拙弟邀同赋元方将托若拙觅颜渊之五十亩故诗中见意","author":"陈与义","text":"梦中与世极周流，错认三刀是得州。\n拟学耕田给公上，要为同社燕春秋。\n囊间已办青芒屦，桑间想闻黄栗留。\n傥有幽人咨出处，为言无况莫来休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"陈与义","text":"五年元日只流离，楚俗今年事事非。\n后饮屠苏惊已老，长乘舴艋竟安归。\n携家作客真无策，学道刳心却自违。\n汀草岸花知节序，一身千恨独沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月六日夜","author":"陈与义","text":"蕴隆岂不坏，凉气亦徐还。\n独立清夜半，疏星苍桧间。\n晦明莽相代，天地本长闲。\n四顾何寥落，微风时动关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"友人惠石两峰巉然取杜子美玉山高并两峰寒之句名曰小玉山","author":"陈与义","text":"旧喜看书今不看，且留双眼向孱颜。\n从来作梦大槐国，此去藏身小玉山。\n暮霭朝曦一生了，高天厚地两峰闲。\n九华诗句喧寰宇，细比真形伯仲间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"心老久许为作画未果以诗督之","author":"陈与义","text":"布衲王摩诘，禅馀寄笔端。\n试将能事迫，肯作画工难。\n秋入无声句，山连欲雨寒。\n平生梦想处，奉乞小巑岏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"陈与义","text":"六经在天如日月，万事随时更故新。\n江南丞相浮云坏，洛下先生宰木春。\n孟喜何妨改师法，京房底处有门人。\n旧喜读书今懒读，焚香阅世了闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"火后问舍至城南有感","author":"陈与义","text":"魂伤瓦砾旧曾游，尚想奔烟万马遒。\n遂替胡儿作正月，绝知回禄相巴丘。\n书生性命惊频试，客子茅茨费屡谋。\n唯有君山故窈窕，一眉晴绿向人浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨","author":"陈与义","text":"风雨破秋夕，梧叶窗前惊。\n不愁黄落近，满意作秋声。\n客子无定力，梦中波撼城。\n觉来俱不见，微月照残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发商水道中","author":"陈与义","text":"商水西门语，东风动柳枝。\n年华入危涕，世事本前期。\n草草檀公策，茫茫杜老诗。\n山川马前阔，不敢计归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒","author":"陈与义","text":"新诗满眼不能裁，鸟度云移落酒杯。\n官里簿书无日了，楼头风雨见秋来。\n是非衮衮书生老，岁月匆匆燕子回。\n笑抚江南竹根枕，一樽呼起鼻中雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对酒","author":"陈与义","text":"陈留春色撩诗思，一日搜肠一百回。\n燕子初归风不定，桃花欲动雨频来。\n人间多待须微禄，梦里相逢记此杯。\n白竹扉前容醉舞，烟村渺渺欠高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用大成四桂坊韵赋诗赠令狐昆仲","author":"陈与义","text":"乡人洗眼看银黄，得桂连枝手尚香。\n盛事固应传雁塔，新诗不减住鸡坊。\n醍酥乳酪元同味，羯末封胡更合堂。\n从此葛恢门下客，知名可但一杨方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日雨","author":"陈与义","text":"衡山县下春日雨，远映青山丝样斜。\n容易江边欺客袂，分明沙际湿年华。\n竹林路隔生新水，古渡船空集乱鸦。\n未暇独忧巾一角，西溪当有续开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙门","author":"陈与义","text":"不到龙门十载强，断崖依旧挂斜阳。\n金银佛寺浮佳气，花木禅房接上方。\n羸马暂来还径去，流莺多处最难忘。\n老僧不作留人意，看水看山白发长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤春","author":"陈与义","text":"庙堂无策可平戎，坐使甘泉照夕烽。\n初怪上都闻战马，岂知穷海看飞龙。\n孤臣霜发三千丈，每岁烟花一万重。\n稍喜长沙向延阁，疲兵敢犯犬羊锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用景纯韵咏怀二首 其二","author":"陈与义","text":"木枕蒲团病更宜，从教恶少事鞍鞿。\n元无王老又何怨，不有曲生谁与归。\n六日取蟾乖世用，三年刻楮费天机。\n只应杖屦从公处，未觉平生与愿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用景纯韵咏怀二首 其一","author":"陈与义","text":"路断赤墀青琐贤，士龙同此屋三间。\n愁边潘令鬓先白，梦里老莱衣更班。\n欲学大招那有赋，试谋小隐可无山。\n一钱留得真堪笑，未到囊空犹是悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再别","author":"陈与义","text":"多难还分手，江边白发新。\n公为九州督，我是半途人。\n政尔倾全节，终然却要身。\n平生第温峤，未必下张巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再蒙宠示佳什殆无遗巧勉成二章一以报佳贶一以自贻 其一","author":"陈与义","text":"睆睆休嫌笏与绅，如公本是九包人。\n读书只用三冬足，学道从来一色醇。\n太尉谈辞仍玉麈，侍中风韵更纱巾。\n谁言上界多官府，亦许散仙追后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再蒙宠示佳什殆无遗巧勉成二章一以报佳贶一以自贻 其二","author":"陈与义","text":"诸公衮衮坐垂绅，谁信北风欺得人。\n遮眼读书何用解，发颜要酒可须醇。\n十年白社空看镜，万里青天一岸巾。\n少待奇章到三日，试将冠盖拂埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘大资挽词二首 其二","author":"陈与义","text":"一死公馀事，由来虏亦人。\n使知临难日，犹有不欺臣。\n河洛倾遗愤，英雄叹后尘。\n煌煌中兴业，公合冠麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘大资挽词二首 其一","author":"陈与义","text":"天柱攲倾日，堂堂堕虏围。\n遂闻王蠋死，不见华元归。\n一代名超古，千年泪染衣。\n当时如有继，犹足变危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后三日再赋","author":"陈与义","text":"天生瘿木不须栽，说与儿童是酒杯。\n落日留霞知我醉，长风吹月送诗来。\n一官扰扰身增病，万事悠悠首独回。\n不奈长安小车得，睡乡深处作奔雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寺居","author":"陈与义","text":"招提远占一牛鸣，阻绝干戈得暂经。\n梦境了知非有实，醉乡不入自常醒。\n楼台近水涵明鉴，草树连空写素屏。\n物象自堪供客眼，未须觅句户长扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年华","author":"陈与义","text":"去国频更岁，为官不救饥。\n春生残雪外，酒尽落梅时。\n白日山川映，青天草木宜。\n年华不负客，一一入吾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵尹潜感怀","author":"陈与义","text":"胡儿又看绕淮春，叹息犹为国有人。\n可使翠华周宇县，谁持白羽静风尘。\n五年天地无穷事，万里江湖见在身。\n共说金陵龙虎气，放臣迷路感烟津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵乐文卿北园","author":"陈与义","text":"故园归计堕虚空，啼鸟惊心处处同。\n四壁一身长客梦，百忧双鬓更春风。\n梅花不是人间白，日色争如酒面红。\n且复高吟置馀事，此生能费几诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵光化宋唐年主簿见寄二首 其二","author":"陈与义","text":"高人主簿固非宜，天马何妨略受鞿。\n会有梅花堪寄远，可因莼菜便怀归。\n相如未免家徒壁，季子行看嫂下机。\n且复哦诗置此事，江山相助莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵光化宋唐年主簿见寄二首 其一","author":"陈与义","text":"茂林当日映群贤，也唤畸人到席间。\n弃我便惊车辙远，怀君端合鬓毛班。\n梦中犹得攀珠树，别后能忘倒玉山。\n遥想诗成记来日，笔端风雨发天悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邢九思","author":"陈与义","text":"百年鼎鼎杂悲欢，老去初依六祖坛。\n玄晏不堪长抱病，子真那复更为官。\n山林未必容身得，颜面何宜与世看。\n白帝高寻最奇事，共君盟了不应寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邢子友","author":"陈与义","text":"壮士如今烂莫收，尚思抽矢射旄头。\n不堪苦雾侵衰鬓，稍喜和烟入戍楼。\n万里中原空费梦，三春胜日偶成游。\n青松远岭偏惊眼，薄晚阑干更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋主簿诗","author":"陈与义","text":"九折湾中万斛舟，怪公随处得心休。\n未应菊径关心急，聊为鱼槎尽意留。\n陆子旧踪馀马顶，羊公遗碣见龟头。\n遥知太白无多事，醉里诗成不待搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张迪功春日","author":"陈与义","text":"年年春日寒欺客，今日春无一半寒。\n不觉转头逢岁换，便须揩目待花看。\n争新游女幡垂鬓，依旧先生日照盘。\n从此不忧风雪厄，杖藜时可过苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周教授秋怀","author":"陈与义","text":"一官不办作生涯，几见秋风捲岸沙。\n宋玉有文悲落木，陶潜无酒对黄花。\n天机衮衮山新瘦，世事悠悠日自斜。\n误矣载书三十乘，东门何地不宜瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵家弟所赋","author":"陈与义","text":"曹刘方驾信优为，不废东郊坐保釐。\n投蚓问公逢老手，联珠及我愧连枝。\n定知来者倾三叹，共了流年费几诗。\n瘀絮车斜敢将去，乐天那畏一微之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵家弟碧线泉","author":"陈与义","text":"七孔穿针可得过，冰蚕映日吐寒波。\n练飞空咏徐凝水，带断疑分汉帝河。\n川后不愁微步袜，鲛人暗动卷绡梭。\n才高下视玄虚赋，对此区区转患多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵家叔","author":"陈与义","text":"衮衮诸公车马尘，先生孤唱发阳春。\n黄花不负秋风意，白发空随世事新。\n闭户读书真得计，载肴从学岂无人。\n只应又被支郎笑，从者依前困在陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答张迪功坐上见贻张将赴南都任 其二","author":"陈与义","text":"千首能轻万户侯，诵君佳句解人忧。\n梦阑尘里功名晚，笑罢尊前岁月流。\n世事无穷悲客子，梅花欲动忆吾州。\n明朝又作河梁别，莫负平生马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答张迪功坐上见贻张将赴南都任 其一","author":"陈与义","text":"足钱便可不须侯，免对妻儿赋百忧。\n一笑相逢亦奇事，平生所得是清流。\n谈天安用如邹子，扫地还应学赵州。\n南北东西底非梦，心闲随处有真游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢心老以缘事至鲁山","author":"陈与义","text":"禅师瓶贮几多空，欲问以书无去鸿。\n鲁县人迎波若杖，天宁树起吉祥风。\n荒山春色篇章里，快士交情笔砚中。\n一日尘沙双碧眼，归时应与去时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]