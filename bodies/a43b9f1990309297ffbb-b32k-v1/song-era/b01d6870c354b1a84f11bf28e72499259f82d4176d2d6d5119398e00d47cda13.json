[{"title":"偈颂一百三十三首 其八十四","author":"释法薰","text":"四月十五同结，此土西天不别。\n杀尽安居，只得一橛，杨花不是天边雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其八十二","author":"释法薰","text":"不著佛求，不著法求，不著僧求。\n春花烂熳，春事绸缪。\n若将春意会，特地惹春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其八十一","author":"释法薰","text":"一生空拽露布，末后又把不住。\n灭度不灭度，总非吾弟子，破布囊尽底翻出。\n苍天中更添冤苦，可惜黄金成粪土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其八十","author":"释法薰","text":"至道无难，惟嫌拣择。\n山河大地，日月星辰。\n草木丛林，鸟兽人畜。\n不是龙门客，切忌遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十九","author":"释法薰","text":"明如日，黑如漆。\n通天大路，万重铁壁。\n南山口似血盆，争敢妄通消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十八","author":"释法薰","text":"尽大地不是自己，参天荆棘。\n尽大地总是自己，满目尘埃。\n横三竖四，捏聚放开。\n要与南山相见，还我第一筹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十七","author":"释法薰","text":"古今日月，依旧山河。\n新年佛法，特地干戈。\n水到沧溟不是波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十六","author":"释法薰","text":"万古长空，一朝风月。\n有祖以来，话作两橛。\n石田好是明明说，八十翁翁嚼生铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十五","author":"释法薰","text":"寸丝不挂，赤肉犹存。\n黄头碧眼，叫屈无门。\n我行荒草里，汝又入深村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十四","author":"释法薰","text":"赤肉团上，壁立万仞。\n临济德山，因邪打正。\n罗纹结角，百匝千重。\n等闲抛一钓，惊起碧潭龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十三","author":"释法薰","text":"风萧萧，雨萧萧，丝毫不动，平步丹霄。\n便恁么去，南山门下，土亦难消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十二","author":"释法薰","text":"独能岗上，慧日峰前。\n云月是同，溪山各异。\n正法眼，破沙盆。\n劝君更尽一杯酒，西出阳关无故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十一","author":"释法薰","text":"至人变化，体妙难名。\n去来不以象，动静不以形。\n通途自寥邈，何处不称尊。\n更无一法可当情，直踏毗卢顶上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十四","author":"释法薰","text":"一不成一，二不成二。\n喝水成水，敲骨出髓。\n眼有瞳人，色斯举矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十三","author":"释法薰","text":"不是世间法，亦非西祖意。\n晷运推移，日南长至。\n幽州江口石人，不道光阴虚弃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十二","author":"释法薰","text":"达磨不会禅，夫子不识字。\n第一莫将来，将来不相似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十一","author":"释法薰","text":"坦老勾贼破家，罗山就窠打劫。\n勘證将来，未免髑髅敲磕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十","author":"释法薰","text":"触目不会道，运足焉知步。\n倒腹倾肠，翻成露布。\n石田顶戴诸人，争敢丝毫错误。\n却忆王老师，不打这破鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十九","author":"释法薰","text":"秋风高，秋叶脱。\n乱走衲僧，天涯海角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十八","author":"释法薰","text":"出一丛林，入一丛林。\n不具参方眼，难透祖师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十五","author":"释法薰","text":"识得心，山岳沉。\n握金成土，握土成金。\n脚后脚前，见成行货。\n少室峰前，交点不过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十四","author":"释法薰","text":"云月是同，溪山各异。\n拽新罗与占波斗额，跛脚阿师犹落第二。\n东西南北，甚处得来。\n好是明明说，从教鸭听雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十三","author":"释法薰","text":"去却一，拈得七。\n通天大路，万重铁壁。\n枫桥心肝五脏，一时剖出。\n臭骨头，信彩掷。\n百千万种神通，只消道个不必。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十二","author":"释法薰","text":"乳源言中藏剑戟，这僧奸里放痴憨。\n西来的的意，斫额望扶桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十一","author":"释法薰","text":"棒喝齐施，雷奔电掣。\n本参事中，总没交涉。\n没交涉，有来由，昨夜三更失却牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其十九","author":"释法薰","text":"东去亦是上座，西去亦是上座。\n提水放火，看风使舵。\n七出八没，儒雅风流。\n几度黑风翻大海，何曾覆却钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其十六","author":"释法薰","text":"佛祖真机，曾无准的。\n钩锁连环，刀挑不出。\n石田有个道处，未必诸人委悉。\n摩诃般若波罗蜜，甚深般若波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其十二","author":"释法薰","text":"一日日，一时时，口如鼻，眼似眉。\n左搓芒绳缚鬼子，倒将蒿箭射须弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其十一","author":"释法薰","text":"八月秋，何处热。\n杜衲僧，犹未瞥。\n三更半夜眼闻，天上如何拣月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七","author":"释法薰","text":"善财采，文殊用。\n杀人活人，临机变弄。\n直须亲看海龙宫，莫看目前波浪涌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六","author":"释法薰","text":"一径直，二周遮。\n衲僧会得，万别千差。\n庭前闲放目，春尽尚馀花，老胡不合过流沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其五","author":"释法薰","text":"晷运推移，日南长至。\n佛法世法，因行掉臂。\n高峰更嘱诸人，第一莫眠冷地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其十五","author":"释法薰","text":"九夏安居，眉毛厮结。\n一人发真归源，十方虚空迸裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四","author":"释法薰","text":"有大圣人，出现世间。\n不言而化，无为而治。\n节逢瑞庆，万国欢声。\n金轮永御三千界，玉叶长敷亿万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十三","author":"释法薰","text":"法尔不尔，如何指南。\n古佛露柱，昼夜交参。\n蒋山虽恁么道，西天有人不甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一","author":"释法薰","text":"云门一棒，高峰三拜。\n一家不知一家，各自保守疆界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十九","author":"释法薰","text":"千五百人善知识，不念吾宗正岑寂。\n五峰趯倒浪翻空，大地山河俱失色。\n金风体露，叶落归根，只堪惆怅不堪陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十八","author":"释法薰","text":"石田乍到，人事纷纷。\n拈得鼻孔，失却眼睛。\n佛法二字，不怕烂却，且听诸方行棒喝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十七","author":"释法薰","text":"众流成海，众毛成毬。\n一棚俊鹘，儒雅风流。\n石田无一事，坐地看扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十六","author":"释法薰","text":"向上一路，千圣不然。\n目前无异草，脚下有青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十五","author":"释法薰","text":"九重降旨，阖国咸知。\n一句当头，诸人未委。\n只如新长老，宁可截舌，不犯国讳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十四","author":"释法薰","text":"一径直，二周遮。\n擒虎兕，辨龙蛇。\n白玉无瑕却有瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十二","author":"释法薰","text":"江南成橘，江北成枳。\n还有优劣也无，具眼者辨取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十一","author":"释法薰","text":"平如镜，烂如泥。\n迷则迷于悟，悟则悟于迷。\n禹力不到处，河声流向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其六十","author":"释法薰","text":"未过蒋山关，须过蒋山关。\n过得蒋山关，呼唤不回，牢笼不住。\n平地鼓洪波，青天撒白雨。\n石田笑嘻嘻，未敢轻相许。\n射虎不真，徒劳没羽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其五十九","author":"释法薰","text":"有祖以来，无人奈何。\n德山临济，特地干戈。\n水到沧溟不是波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其五十七","author":"释法薰","text":"明如日，黑如漆。\n一犬吠虚，千猱啀宝。\n山僧有口，多时挂壁。\n却烦拄杖子，与诸人通个消息。\n东土衲子心粗，西天蜡人泪滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其五十六","author":"释法薰","text":"以大圆觉，无绳自缚。\n为我伽蓝，凡圣交参。\n身心安居，换水养鱼。\n平等性智，落在第二。\n莫教辜负两茎眉，九十日从今日始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其五十五","author":"释法薰","text":"言诠不及处，文彩未生时。\n电光石火，犹尚迟迟。\n直下横身担荷得，藕丝牵动五须弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其五十四","author":"释法薰","text":"两日晴，三日雨。\n衲僧皮草，无㬠㫰处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其五十","author":"释法薰","text":"见闻觉知，行住坐卧。\n眨上眉毛，早已蹉过。\n赤脚唱山歌，路上无人和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十九","author":"释法薰","text":"焦砖打著连底冻，赤眼撞著火柴头。\n将军但得嘉声在，何必荣封万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十八","author":"释法薰","text":"长沙见处虽亲用处粗，仰山口里相呼肚里狡。\n灼然好个大虫，可惜已伤牙爪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十七","author":"释法薰","text":"田地稳密，关窍玲珑。\n识得无寒暑处，任他寒暑相攻，个里同途辙不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十六","author":"释法薰","text":"深山岩崖中，迥绝无人处。\n个事分明，十成显露。\n拟著便乖张，不拟成差互。\n赵州亲见南泉，百丈曾参马祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十五","author":"释法薰","text":"今朝五月五，石田无剩语。\n打破鬼门关，三更日卓午，明眼衲僧迷却路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十四","author":"释法薰","text":"四月十五结，虚空遭火爇。\n此土与西天，同途不同辙，镇州萝卜并州铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十二","author":"释法薰","text":"石中有玉，沙里无油。\n德山临济，未出常流。\n却忆寒山子，时临古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其四十","author":"释法薰","text":"钟山乍住，百事随宜。\n无可不可，左之右之。\n些子不通方处，料想诸人未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十九","author":"释法薰","text":"透过牢关，纵横独步。\n脚头到处生涯，谁道此山无路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十八","author":"释法薰","text":"院无大小，众无多寡。\n有个折脚铛儿，要人提上挈下。\n不堕功勋，不触风化，千里追风看良马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十七","author":"释法薰","text":"大地人人具眼，明星夜夜流辉。\n瞿昙不著便，失却一双眉。\n后代儿孙那得知，一年一度乱针锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十五","author":"释法薰","text":"解用不须双刃剑，延龄何必九还丹。\n尉迟□不在家死，狮子那能食兔钱。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十","author":"释法薰","text":"赵老应机，如风吹水。\n第一座香烟起，驴年梦见汗臭气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其九","author":"释法薰","text":"洞山前施妙略，这僧暗透重关。\n若不得后著，前话也难圆。\n将军但有嘉声在，不得封侯也是关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其八","author":"释法薰","text":"保福借水献花，这僧白日迷路。\n南山门下，总是粗心底。\n只是不敢说著，小慈妨大慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其六","author":"释法薰","text":"乌兔东西疾，一年时序毕。\n窦八布衫穿，乌龟眼睛赤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其四","author":"释法薰","text":"飞来峰高攀不上，冷泉水深饮不竭。\n衲僧到此拟奚为，尽力神疲好休歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其二","author":"释法薰","text":"床窄先卧，粥稀后坐。\n耳聩要声高，眼昏宜字大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其一","author":"释法薰","text":"莫行心处路，不挂本来衣。\n何须更恁么，切忌未生时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十五","author":"释法薰","text":"秋声满林壑，秋雨滴梧桐。\n门外未归客，飘泊在途中。\n归也，归也，通身白汗，下载清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五十三","author":"释法薰","text":"目前无法，意在目前。\n从上若佛若祖，天下老和尚罪过弥天。\n天，天，昨夜山僧针线囊中，打失一文古老钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十八","author":"释法薰","text":"采药与用药，相逢一会家。\n杀人活人不眨眼，白玉无瑕却有瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十六","author":"释法薰","text":"赵州禅，口皮边。\n墙外底，透长安。\n?著磕著，言端语端。\n不是钓鳌手，徒劳把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]