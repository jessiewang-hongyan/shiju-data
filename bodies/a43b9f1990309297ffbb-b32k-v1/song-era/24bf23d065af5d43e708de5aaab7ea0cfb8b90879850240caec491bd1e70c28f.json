[{"title":"看花回 其一 张守生日","author":"赵彦端","text":"注目。\n正江湖浩荡，烟云离属。\n美人衣兰佩玉。\n澹秋水凝神，阳春翻曲。\n烹鲜坐啸，清净五千言自足。\n横剑气、南斗光中，浩然一醉引双鹿。\n回雁到、归书未续。\n梦草处、旧芳重绿。\n谁忆潇湘岁晚，为唤起长风，吹飞黄鹄。\n功名异时，圯上家传谢荣辱。\n待封留，拜公堂下，授我长生箓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看花回","author":"赵彦端","text":"端有恨，留春无计，花飞何速。\n槛外青青翠竹。\n镇高节凌云，清阴常足。\n春寒风袂，带雨穿窗如利镞。\n催处处、燕巧莺慵，几声钩辀叫云木。\n看波面、垂杨蘸绿。\n最好是、风梳烟沐。\n阴重熏帘未卷，正泛乳新芽，香飘清馥。\n新诗惠我，开卷醒然欣再读。\n叹词章、过人华丽，掷地胜如金玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝英台/祝英台近","author":"赵彦端","text":"兽金寒，帘玉润，梅雪印苔絮。\n春意如人，易散苦难聚。\n几多丝竹深情，池塘幽梦，犹倚赖、与君同住。\n旧游处。\n谁唤别浦仙帆，风前问征路。\n烟雨连江，吹恨正无数。\n莫教紫燕归来，红云开后，空怅望、主人轻去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绛都春 别张子仪","author":"赵彦端","text":"平生相遇。\n算未有、笑语闽山佳处。\n旧日文章，如今风味浑如许。\n眼前都是蓬莱路。\n但莫道、有人曾住。\n异时天上，种种风流，待君如故。\n此自君家旧物，看九万清风，为君掀举。\n举上青云，却忆梅花如旧否。\n故人衰病今无绪。\n只种得、梅花盈圃。\n待君一过山家，共斟露醑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶瓶儿 上元","author":"赵彦端","text":"澹月华灯春夜。\n送东风、柳烟梅麝。\n宝钗宫髻连娇马。\n似记得、帝乡游冶。\n悦亲戚之情话。\n况溪山、坐中如画。\n凌波微步人归也。\n看酒醒、凤鸾谁跨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝","author":"赵彦端","text":"河阳桃李开无数。\n待乘春归去。\n小园几片忽惊飞，恨主人难驻。\n雏莺乳燕愁相语。\n道留君不住。\n愿君随处作东风，与群花为主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝","author":"赵彦端","text":"一江风月同君住。\n了不知秋去。\n赏心亭下，过帆如马，堕枫如雨。\n相将莫问，兴亡旧事，举离觞谁诉。\n垂杨指点，但归来、有温柔佳处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源忆故人","author":"赵彦端","text":"修檐堕玉欺窗竹。\n独坐冷云堆屋。\n此味与谁同宿。\n几寸东斋烛。\n烟鬟雾鬓春山曲。\n好梦浅愁相续。\n那慰沈腰如束。\n歌意灯前足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 张宜兴生日","author":"赵彦端","text":"花县双凫缥缈仙。\n家庭椿树正苍然。\n斑衣举酒大人前。\n袅袅凉风供扇枕，悠悠飞露湿丛萱。\n醉扶黄发弄曾玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵彦端","text":"水到桐江镜样清。\n有人还似水清明。\n尊前无语更盈盈。\n翠袖舞衫何日了，白头归去几时成。\n老来犹有惜花情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 题扇","author":"赵彦端","text":"冰练新裁月见羞。\n墨花飞作淡云浮。\n宜歌宜笑不妨秋。\n约腕半笼衫草碧，洗妆初失黛蛾愁。\n嫩凉轻暑奈风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其六 辛卯会黄运属席上作","author":"赵彦端","text":"人意歌声欲度春。\n春容温暖胜于人。\n劝君一醉酒如渑。\n梅子枝头应有恨，柳花风底不堪嚬。\n盖公堂下净无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵彦端","text":"过雨园林绿渐浓。\n晚霞明处暮云重。\n小桥东畔再相逢。\n睡起未添双鬓绿，汗融微退小妆红。\n几多心事不言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"赵彦端","text":"菊已开时梅未通。\n似寒如暖意融融。\n情亲语妙一杯中。\n歌舞欲来须更理，林泉有乐政须同。\n好诗多味酒无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四 为五叔寿，三月二十六日","author":"赵彦端","text":"渺渺东风泛酒船。\n月华为地玉为川。\n春于红药更留连。\n云路功名方步步，草庐松竹自年年。\n他时人说二疏贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"赵彦端","text":"花下凭肩月下迎。\n避人私语脸霞生。\n画堂红烛意盈盈。\n病酒一春愁与睡，倚阑终日雨还晴。\n强移心绪作清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其二","author":"赵彦端","text":"梅缀雪。\n雪缀梅花肌肤惬。\n肌肤惬。\n丰姿浓态，莹如玉色。\n岁寒期约无相缺。\n祥花不减晴空月。\n晴空月。\n依前消瘦，还共清绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其一 咏睡香","author":"赵彦端","text":"香蔌蔌。\n小山丛桂烘温玉。\n烘温玉。\n酒愁花暗，沈腰如束。\n烦君剩与阳春曲。\n为君细拂衾罗馥。\n衾罗馥。\n一春幽梦，与君相续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其六","author":"赵彦端","text":"乱云萦浦。\n做雪不成还是雨。\n知我为何。\n一笑仍添一恨多。\n不须归去。\n琥珀杯深能几许。\n草色如袍。\n记取从今舞处娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"赵彦端","text":"一年歌舞。\n还是花黄尊绿处。\n雨横风多。\n比似年时恨若何。\n帘深酒暖。\n细雨斜风浑不管。\n只有黄花。\n欲近佳人鬓畔鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"赵彦端","text":"送人南浦。\n日日客亭风又雨。\n相见如何。\n梅子枝头春已多。\n真成别去。\n酒病明朝知几许。\n淋损宫袍。\n都是人人醉后娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一 赠摘阮者","author":"赵彦端","text":"四弦续续。\n山水依然关塞足。\n天上新声。\n谪堕人间得自名。\n清歌宛转。\n弹向指间依旧见。\n满眼春风。\n不觉黄梅细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其五","author":"赵彦端","text":"屈亭湘浦。\n怨尽朝云还暮雨。\n知是谁何。\n赋得清愁尔许多。\n爱来慵去。\n此意平生成浪许。\n著尽茸袍。\n想像江梅雪后娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"赵彦端","text":"绿阴红雨。\n黯淡衣裳花下舞。\n花月佳时。\n舞破东风第几枝。\n一杯相属。\n从灺尊前三四烛。\n酒尽花阑。\n京洛风流仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜分飞 送江鸣玉归乌墩","author":"赵彦端","text":"相与十年亲且旧。\n一笑天涯携手。\n霜际寒云逗。\n去年情味君思否。\n远水无情冰不就。\n好在尊前眉岫。\n肠断东南秀。\n淡烟疏月梅时候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 席上赠人","author":"赵彦端","text":"桃根桃叶。\n一树芳相接。\n春到江南三二月。\n迷损东家蝴蝶。\n殷勤踏取青阳。\n风前花正低昂。\n与我同心栀子，报君百结丁香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 建安泛舟作","author":"赵彦端","text":"新寒一段。\n变尽人间暖。\n说与群花花不管。\n只有江梅情乱。\n江梅也似山人。\n山人到老梅亲。\n斗薮衣冠气象，百般归去精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 雪","author":"赵彦端","text":"悠悠漾漾。\n做尽轻模样。\n昨夜潇潇窗外响。\n多在梅梢柳上。\n画楼拂晓帘开。\n六花一片飞来。\n却被金炉香雾，腾腾扶上琼钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 建安作","author":"赵彦端","text":"侬家风物似山家。\n梅老鬓丝华。\n几回记得，攀翻琪树，醉帽敧斜。\n冷香不断春千里，归路本非赊。\n有人却道，使君犹健，看遍馀花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 王漕赴介庵赏梅","author":"赵彦端","text":"黄昏小宴史君家。\n梅粉试春华。\n暗香素蕊，横枝疏影，月淡风斜。\n更饶红烛枝头挂，粉蜡斗香奢。\n元宵近也，小园先试，火树银花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"赵彦端","text":"绣罗裙上双鸳带。\n年年长系春心在。\n梅子别时青。\n如今浑已成。\n美人书幅幅。\n中有连环玉。\n不是只催归。\n要情无断时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"赵彦端","text":"佩环解处妆初了。\n翠娥玉面金钿小。\n萼绿本仙家。\n天香谁似他。\n芳心真耐久。\n度月长相守。\n岁晚未能忘。\n相期云水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一 同饮晁伯如家，席上和韩无咎韵","author":"赵彦端","text":"雪中梅艳风前竹。\n诗缘渐与情缘熟。\n醉眼眩成花。\n恼人生脸霞。\n巫云将楚雨。\n只恐翩然去。\n我有合欢杯。\n为君聊挽回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"赵彦端","text":"雨声不断垂檐竹。\n清歌唤起清眠熟。\n洞户有馀花。\n同倾细细霞。\n酒行如过雨。\n雨尽风吹去。\n吹去复盈杯。\n一春能几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"赵彦端","text":"倚阑闲捻生绡扇。\n新凉庭户微风转。\n疏雨断檐声。\n淡云开晚晴。\n蔗浆寒浸齿。\n枕簟清如水。\n相忆不胜愁。\n月来帘上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五 集句","author":"赵彦端","text":"青春背我堂堂去。\n桃花乱落如红雨。\n是妾断肠时。\n芳心空自持。\n相思君助取。\n脉脉如牛女。\n天远暮江迟。\n今宵归不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其一 题扇","author":"赵彦端","text":"朱槛曲。\n妆浅鬓云吹绿。\n半尺鹅溪凉意足。\n手香沾柄玉。\n午梦已惊难续。\n说与翠梧修竹。\n蓬海路遥天六六。\n乘鸾何处逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其七","author":"赵彦端","text":"朱户密。\n镇锁一庭春日。\n画幕黄帘芳草碧。\n游蜂初未识。\n脆管么弦无力。\n青子绿阴如织。\n花满深宫无路入。\n旧游浑记得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其三","author":"赵彦端","text":"休相忆。\n明夜远如今日。\n楼外绿烟村羃羃。\n花飞如许急。\n柳岸晚来船集。\n波底斜阳红湿。\n送尽去云成独立。\n酒醒愁又入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其五","author":"赵彦端","text":"春不尽。\n处处与情相趁。\n谁道刘郎家恁近。\n一年花不问。\n双剪画罗春胜。\n今夜月圆如镜。\n怎得酒阑心易定。\n试将金液镇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其八","author":"赵彦端","text":"春意密。\n不受人间风日。\n一曲清歌云暮碧。\n尊前今夜识。\n醉客倦吟无力。\n滞梦停愁相织。\n只道桃源难再入。\n有人还问得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其六","author":"赵彦端","text":"春似绣。\n不是别离时候。\n滴尽黄昏残刻漏。\n月高花影昼。\n好在画屏金兽。\n深琐粉窗兰牖。\n溪水南来堪问否。\n几时离渡口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其二","author":"赵彦端","text":"劳顾曲。\n燕贡雅羞衣绿。\n鲁酒不能春味足。\n小杯空荐玉。\n只愿此欢常续。\n莫序水边丝竹。\n明日朝参同趁六。\n犹期归骑逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其三 乘风亭初成","author":"赵彦端","text":"长松擎月与天通。\n霜叶乱惊鸿。\n露炯乍疑杯滟，云生似觉衣重。\n江南胜处，青环楚嶂，红半溪枫。\n倦客会应归去，一亭长枕寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其五 路彦丰生日","author":"赵彦端","text":"新凉溪阁暮山重。\n水月共空濛。\n九转不须尘外，三峰只在壶中。\n他年盛业，云间可望，林下难逢。\n记取芗林岩洞，何如于越秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其二","author":"赵彦端","text":"烧灯已过禁烟前。\n春信递相传。\n柳暗乍迷津路，花暄欲照江天。\n天涯宾主，相逢老矣，一笑欢然。\n晚岁许同庐社，西风不买吴船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其一","author":"赵彦端","text":"山矾风味更梨花。\n清白竞春华。\n试问西园清夜，何如山崦人家。\n楚东千嶂，吴江一棹，云路非赊。\n惟有相思两地，可怜淡月朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其六","author":"赵彦端","text":"西城烟雾一重重。\n潇洒便秋风。\n巧妒玉人装髻，无如禁钥难通。\n新声窈眇，怨传楚些，娇并吴宫。\n夜久三星为粲，皓娥宁为君容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措 其四","author":"赵彦端","text":"几枝筇竹半烟云。\n钟鼓醉中闻。\n千点好山馀思，一湾流水能分。\n多情皓月，轮栖夜午，光动风文。\n看取清闲宾主，犹胜富贵封君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隔浦莲/隔浦莲近拍","author":"赵彦端","text":"西风吹断梦草。\n来度芙蓉老。\n座上人谁在，晨参疏影相照。\n幽馆寒意早。\n檐声小。\n醉语秋屏晓。\n记年少。\n相携胜处，黄花香满乌帽。\n如今将见，璧月琼枝空好。\n准拟新歌待见了。\n不道。\n些儿心事还恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新荷叶 其三","author":"赵彦端","text":"玉井冰壶，人间有此清秋。\n笑语雍雍，从今庭户初修。\n迎风待月，香凝处、四卷帘钩。\n月波奇观，未饶当日南楼。\n闻说三吴，江湖胜、从古风流。\n况有双轓，旧谙黄阁青油。\n金瓯屡启，应难解、久为人留。\n天池波滟，可怜苹满汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新荷叶 其一","author":"赵彦端","text":"欲暑还凉，如春有意重归。\n春若归来，任他莺老花飞。\n轻雷澹雨，似晚风、欺得单衣。\n檐声惊醉，起来新绿成围。\n回首分携。\n光风冉冉菲菲。\n曾几何时，故山疑梦还非。\n鸣琴再抚，将清恨、都入金徽。\n永怀桥下，系船溪柳依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新荷叶 其二","author":"赵彦端","text":"雨细梅黄，去年双燕还归。\n多少繁红，尽随蝶舞蜂飞。\n阴浓绿暗，正麦秋、犹衣罗衣。\n香凝沈水，雅宜帘幕重围。\n绣扇仍携。\n花枝尘染芳菲。\n遥想当时，故交往往人非。\n天涯再见，悦情话、景仰清徽。\n可人怀抱，晚期莲社相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其二 饯前政卢光祖赴鼎州幕席上作","author":"赵彦端","text":"津鼓冬冬，三老醉、知谁留得。\n都不记、琵琶洲畔，草青江碧。\n桃李春风吹不断，烟霞秋兴清无极。\n怅樽前、桂子有馀香，曾相识。\n残雨昼，初凉夕。\n高烛烂，新醅白。\n长歌断，欢意不如愁色。\n父老能寻循吏传，关河暂枉诸侯客。\n待日边、一纸诏黄飞，胜相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其三 汪秘监席上作","author":"赵彦端","text":"赐被薰炉，曾同见、官槐重绿。\n时归看、绮疏叠嶂，楚腰翻曲。\n君过蓬山轻岁月，我怀庐阜分符竹。\n道别离、待得再归来，人应俗。\n春欲动，醅初熟。\n追一笑，森三玉。\n且相对青眼，共裁红烛。\n小语人家闲意态，浅寒都下新装束。\n念平生、和雨醉东风，从今足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其一 荼","author":"赵彦端","text":"千种繁春，春已去、翩然无迹。\n谁信道、荼枝上，静中留得。\n晓镜洗妆非粉白，晚衣弄舞馀衫碧。\n粲宝钿、珠珥不胜持，浓阴夕。\n金剪度，还堪惜。\n霜蝶睡，无从觅。\n知多少、好词清梦，酿成冰骨。\n天女散花无酒圣，仙人种玉惭香德。\n怅攀条、记得鬓丝青，东风客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 道中忆钱塘旧游","author":"赵彦端","text":"云暖萍漪，雨香兰径，西湖二月初时。\n两山十里，锦绣照金羁。\n柳外阑干相望，弄东风、倚遍斜晖。\n朋游好，乱红堆里，一饮百篇诗。\n三年，江上梦，青衫风日，白纻尘泥。\n听几声黄鸟，粤树闽溪。\n长是春朝多病，今年更、添得相思。\n须归去，倦游滋味，犹有个人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 其一 为寿","author":"赵彦端","text":"记河梁折柳。\n问画堂乐事，燕鸿难偶。\n十年谩回首。\n但亭亭紫盖，差差南斗。\n传闻小有。\n种桃花、亲烦素手。\n怪归来、道骨仙风缥缈，迥然非旧。\n清昼。\n江南如画，紫菊冬前，翠橙霜后。\n扁舟渡口。\n佳客至，奉名酒。\n唤青鸾起舞，云窗月槛，一曲山明水秀。\n笑相看、玉海别来，浅如故否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙","author":"赵彦端","text":"气佳哉寿域。\n正晓松呈翠，早梅施白。\n良辰值良月。\n看景星朝睹，洗空霜洁。\n珍图瑞牒。\n仰天心、钟在俊杰。\n向人间，化作如膏甘雨，莫放春歇。\n堪忆。\n三吴乐事，画戟凝香，舞衣回雪。\n风流胜绝。\n尊中酒，坐中客。\n问今年何事，骑鲸南去，久矣湘枫下叶。\n早归来，应取千龄，凤池旧列。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 其二 饯交代沈公雅台山寺作，继作朝中措","author":"赵彦端","text":"揽垂杨细折。\n有别情遗爱，与君都说。\n文茵带雕轭。\n是行春来处，去年阡陌。\n柔桑半叶。\n转光风、轻扬秀麦。\n正人家共约，耕相借牛，社相留客。\n清绝。\n溪山犹记，脱帽吟风，倚楼招月。\n东君何事，将春至，放春歇。\n道从今江上，一花一柳，皆想油幢瑞节。\n纵离愁、瘦减腰围，带金正晔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹧鸪","author":"赵彦端","text":"榴花五月眼边明。\n角簟流冰午梦清。\n江上扁舟停画桨，云间一笑濯尘缨。\n主人杯酒留连意，倦客关河去住情。\n都付驿亭今日水，伴人东去到江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]