[{"title":"老叟","author":"赵希迈","text":"鬓发如霜心未灰，尚营活计待将来。\n岭头尽日敲松子，犹向山园空处栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西风","author":"赵希迈","text":"西风溪上雨初收，数叶新红点树头。\n白鹭作成秋景致，背人飞过蓼花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨妃井","author":"赵希迈","text":"妃子当年井尚存，谁栽石塔向云根。\n春泉不洗开元恨，空与黥儿洗字痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涌金汤","author":"赵希迈","text":"官与民间一样贫，空流江水净如银。\n谁将山里閒田地，唤作黄金误世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真娘墓","author":"赵希迈","text":"松林际晚鹤飞回，一片荒碑卧草莱。\n颜色不随尘土化，涧边犹有野棠开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得","author":"赵希迈","text":"旧日看山古渡头，村深无马但骑牛。\n如今身被微官缚，欲要骑牛不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"路转","author":"赵希迈","text":"路转枫林积叶深，秋塘涨水绿沉沉。\n沙鸥却似曾相识，独立莎汀伴醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万顷田","author":"赵希迈","text":"万顷平田一望中，独乘瘦马当吟筇。\n天连浊雾无非海，地少严寒不类冬。\n刺竹满林生似猬，古榕临水卧如龙。\n村家米贱新醅熟，犹及停鞭问老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小泊毗陵西郊即事","author":"赵希迈","text":"腊尽客萧萧，系船当远郊。\n冻苔龟曝日，古树鹊营巢。\n野老扫寒屋，骚人寄午庖。\n不知何所见，能索近诗抄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小桃源","author":"赵希迈","text":"乱崖悬怪木，地胜绝纤尘。\n曾有升仙者，宁无避世人。\n湍流因过雨，啼鸟但如春。\n谁种桃千树，荒碑记不真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五斗","author":"赵希迈","text":"五斗驱将五岭来，萧萧老屋枕岩隈。\n风高松子和钗落，地暖梅花带叶开。\n短鬓吟边从似雪，壮心客里渐成灰。\n官身纵使多尘事，亦许偷闲踏径苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汀畔","author":"赵希迈","text":"墅梅汀畔客帆过，岁晚天南气候和。\n江合湘漓流水急，山藏洞壑吐云多。\n村家酿酒连醅浊，小吏抄诗觉字讹。\n几点白鸥清似画，对人飞下泊寒莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白鹤关","author":"赵端行","text":"危亭石作关，假道一跻攀。\n白鹤何年去，青松尽日闲。\n坐时闻远水，望处小他山。\n衲子云衣厚，寒犹宿此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次昭城","author":"赵希迈","text":"郡小人烟密，来游契所闻。\n城因山势筑，江向庙头分。\n冻苇声如雨，春泉气似云。\n梅公堂上酒，客里易成醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴中中秋怀瓜庐诸友","author":"赵希迈","text":"凉分一半秋，此夜客吴州。\n无侣共明月，唤僧同倚楼。\n天虚云气尽，风静桂香浮。\n遥忆前年醉，狂吟沧海头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芜","author":"赵希迈","text":"数间吟屋就，谢尔肯相依。\n巢稳迎人语，身轻掠水飞。\n漂流皆是客，来去两忘机。\n何事抛珠箔，欣然恋竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到贵州","author":"赵希迈","text":"涉历长亭复短亭，兼旬方抵贵州城。\n江从白鹭飞边转，云在青山缺处生。\n家务每因官事废，诗篇多向客途成。\n耕桑尽自无荣辱，却悔当年事短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜分","author":"赵希迈","text":"夜分天籁寂，谁与共襟期。\n童子醉眠处，老夫吟苦时。\n云黏苍藓石，月挂老松枝。\n一鹤来何处，相从立水湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昆湖夜归","author":"赵希迈","text":"渡湖归古县，一望水程赊。\n月正帆无影，风横浪有花。\n寒更知戍屋，野火是渔家。\n拟待春洲暖，重来采荻芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南台徐灵晖徐灵渊皆有作","author":"赵希迈","text":"山峭石台平，天低可摘星。\n岸回分水势，城缺见州形。\n晓树来孤鹤，春吟忆二灵。\n客行贪访古，柳下一舟停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得","author":"赵希迈","text":"村邑萧条廨屋低，茆墙缺处补荆篱。\n市添人语当墟日，田捲车筒漫种时。\n公事偶无封印早，小胥习懒赴衙迟。\n闲行摸索街头石，寻得前朝一片碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿溪村书斋","author":"赵希迈","text":"故人能下榻，为喜客相过。\n不住夜泉滴，常疑春雨多。\n风来琴自响，冰合砚难磨。\n明日还分袂，羁吟谁共哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚立池上","author":"赵希迈","text":"身与沙鸥一样闲，每来池上独凭阑。\n药苗得雨侵苔绿，楮实逢秋似荔丹。\n酒欠好怀狂饮少，诗因多病苦思难。\n虚廊日晚人稀到，风约蜻蜓泊钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深村","author":"赵希迈","text":"道傍无驿舍，投宿向深村。\n閒唤邻翁语，翛然古意存。\n半篱花隔水，数亩竹当门。\n传说冈头树，时留虎爪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔人","author":"赵希迈","text":"问利问名总不知，生涯付与一轮丝。\n四时风月俱还我，万顷烟波说向谁。\n霁后短蓑和笠晒，醉来长笛倚篷吹。\n此怀惟有诗人识，除却诗人只楚词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄姚滩","author":"赵希迈","text":"数客同吟棹，羁怀得少宽。\n山晴平眺远，滩涩溯流难。\n饥鹊窥茶鼎，游鱼识钓竿。\n天南风土别，晚岁未全寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琴川精舍寄城中友人","author":"赵希迈","text":"客来僧已去，古屋静萧萧。\n敲石引松火，对花悬酒瓢。\n窗棂寒背日，柱础润通潮。\n君肯过幽寂，水程才隔宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛙","author":"赵希迈","text":"閒池草色青，蝌蚪自滋生。\n尚觉窥天小，何因妒月明。\n通宵成乐部，过雨杂棋声。\n静者心无役，从君取意鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"携家","author":"赵希迈","text":"携家经月尚羁程，随处风光似有情。\n一石峭从平地起，数禽飞入半天鸣。\n春生草树洲添绿，船载诗人水倍清。\n晚泊别无消遣处，自酤村酒对花倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新夏","author":"赵希迈","text":"四月寒犹在，日高常掩扉。\n纵收风外絮，难暖客中衣。\n新竹笋多瘦，残梢花最肥。\n有情双燕子，能认旧巢归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬陈校书见寄","author":"赵希迈","text":"日长松院静，孤坐对残编。\n雨久波平岸，山高烧接天。\n春酲茶可解，诗病药难痊。\n独喜君清政，南中客共传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潇湘寺","author":"赵希迈","text":"古刹枕潇湘，闲吟步墅廊。\n藓封岩石老，松落井泉香。\n采蜜蜂归晚，赴斋雀亦忙。\n主僧同里社，十岁已离乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"慧力寺","author":"赵希迈","text":"出郭无多路，萦回入翠微。\n水边寒艇泊，松下老僧归。\n藏古神抄供，亭幽客掩扉。\n自来还自咏，不觉到斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘隐居","author":"赵希迈","text":"幽居杂岭云，清过晋时人。\n学苦常如病，家和不见贫。\n雪消崖溜急，春近烧痕新。\n寒烛半明灭，通宵语意真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠沈兢","author":"赵希迈","text":"僦居初不恶，门巷接溪湾。\n有谱曾评菊，无钱可买山。\n吟驱生计拙，愁积鬓毛斑。\n远示诸名作，閒题驲寄还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王生山水歌","author":"赵希迈","text":"范宽山头李成树，百年二老皆仙去。\n如今尺素留人间，纵有千金无博处。\n后人笔底工一家，声价随可喧中华。\n王君二妙聚一手，参以吟思游天涯。\n万里江山才数幅，东抹西涂意先足。\n苍梢癞石相参差，风雨烟云在羁束。\n近时目贱耳反真，画图重旧不重新。\n名家翰墨未必贵，尘渍赝本翻为珍。\n君提健笔来海外，山若玉簪江为带。\n朝昏变态焉可穷，笔未铺张心已会。\n岭南游者多诗人，见君作画应怜君。\n求我新诗写君画，终使李范声名分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁杪","author":"赵希迈","text":"岁杪携家客桂林，乡山万里楚云深。\n瓮留腊水供春酿，梅著寒花伴晚吟。\n自笑老来贫不减，谁怜鬓底雪相侵。\n俸钱用处清无敌，半打崖碑半买琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋风","author":"赵希迈","text":"纵使秋风满道间，炎州且任客衣单。\n马行峻岭如云度，鹭立枯楂似画看。\n问尽地名犹跋涉，忽收家信喜平安。\n渡头沽得茅柴酒，尽可吟边作醉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梧梅渡","author":"赵希迈","text":"郁郁栖凤枝，青青止渴林。\n两树交江濆，敷为十亩阴。\n朱光灿万宇，唤渡人烦襟。\n一憩爽乌匼，方知树德心。\n嘉哉建安子，繁衍徵在今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜吟竹屋因约友人明日登楚台","author":"赵希迈","text":"只许吟踪向此来，径无吟屐损苍苔。\n雪明霜树清于月，人涤茶瓯瘦似梅。\n古瓦旋磨成砚璞，腐桐新琢作琴材。\n晓晴不管寒侵骨，儗看湘山上楚台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八声甘州 竹西怀古","author":"赵希迈","text":"寒云飞万里，一番秋、一番搅离怀。\n向隋堤跃马，前时柳色，今度蒿莱。\n锦缆残香在否，枉被白鸥猜。\n千古扬州梦，一觉庭槐。\n歌吹竹西难问，拚菊边醉著，吟寄天涯。\n任红楼踪迹，茅屋染苍苔。\n几伤心、桥东片月，趁夜潮、流恨入秦淮。\n潮回处，引西风恨，又渡江来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 寿处州吴雨岩","author":"赵希汰","text":"持节浙东，六十年前，紫阳老师。\n看粟移七郡，功深到处，棠阴一道，民尚思之。\n心印亲传，雨岩来括，寅岁幸无庚子饥。\n仁同视，更备存先具，仓积千斯。\n青州阴德天知。\n只此事堪为崧岳祈。\n与太夫人寿，相看华发，转中书令，长著斑衣。\n岁岁梅花，樽前索笑，霜月先圆两夜规。\n称觞了，报春风千里，班觐龙墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角","author":"赵希明","text":"空山木落。\n月淡阑干角。\n相与羊裘披上，方知道、宦情薄。\n老来须自觉。\n酒尊行处乐。\n疑到碧湾无路，滩声小、橹声薄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行二绝 其二","author":"赵希玣","text":"柴门寂寂傍林泉，古木阴森不染烟。\n阵阵落花铺满径，呼童漫扫夕阳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行二绝 其一","author":"赵希玣","text":"侵晨命仆起随行，滴滴流泉聒耳鸣。\n遥望君家何处是，白云溪上小桥横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句","author":"赵希?","text":"手执黄庭上石台，竹阴扫月遍苍苔。\n欲从此处即仙去，玉立清风待鹤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游瑞象寺和杜梦麟韵","author":"赵希?","text":"招提深僻好山重，湿翠阴森一径松。\n夜静鹤归清梦绕，日高僧起碧云封。\n晴分贝叶翻馀照，雨送钟声度远峰。\n竹舍因逢三昧语，鸟啼花满万缘空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝命偈","author":"赵希?","text":"六十二年皮袋，放下了无挂碍。\n青天明月一轮，万古逍遥自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"赵希囿","text":"天宇泬寥山气肃，云寒树立无声。\n读书岩下石纵横。\n红尘飞不到，溪水自澄清。\n疏影暗香沙路古，何妨曳杖闲行。\n巢林冻雀不曾惊。\n晚钟穿翠霭，来共话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄潮州于公九流","author":"陈尧佐","text":"扁舟如叶路东西，一片滩声下恶溪。\n当日亭台旧时客，相逢莫惜醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日怀友","author":"赵希㯝","text":"江蟹初肥天欲霜，莫云红树写秋光。\n西风携手登临地，今日黄花两处香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过临平","author":"赵希㯝","text":"市井萧条景物非，居人犹号永和堤。\n春山十里斜阳树，漠漠残红杜宇啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴道士钓云","author":"赵希㯝","text":"澹溪溪上一竿丝，牵动闲云片片飞。\n折尽柳条穿不得，荷衣裹向碧山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓者","author":"赵希㯝","text":"河豚荻笋春风老，鲈鲙莼丝秋水寒。\n多少侯门天样阔，算来何似钓船宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游 其二","author":"赵希㯝","text":"蝶懒莺喑欲莫春，更兼风雨别愁新。\n天涯草色深如此，忆得淮南有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游 其一","author":"赵希㯝","text":"梦冷繁华金谷园，春深葵麦暗朱门。\n东风日日吹花急，红雨苍苔泪几痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕 其一","author":"赵希㯝","text":"西风梳发冷飕飕，半醉微吟独倚楼。\n一片旧时南浦月，清光犹印别离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕 其二","author":"赵希㯝","text":"半枕小窗幽梦蝶，数声何处寄书鸿。\n关山千里人归晚，肠断烟林一笛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涌月僧楼","author":"赵希㯝","text":"百尺阑干右栎林，乱山如浪翠痕深。\n冰轮飞上光犹湿，照破西来一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋墨雁图分得宿雁","author":"赵希㯝","text":"漠漠秋汀起晚烟，半攲寒影立风前。\n月明应有芦花梦，飞遍江湖万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋","author":"赵希㯝","text":"白露漙空万叶飞，生香浑在桂花枝。\n一千里月正圆夜，九十日秋才半时。\n湓浦风流元亮兴，鄜州牢落少陵诗。\n不妨吟尽蟾蜍影，此别分明隔岁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江湖伟观","author":"赵希㯝","text":"华屋岿然占上方，一尊同此寄相羊。\n江潮翻海莫天阔，湖水拍堤春草长。\n莽莽越山凝紫翠，摇摇苏柳间青黄。\n归鸿影里阑干晚，回首中州入渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹阁","author":"赵希㯝","text":"古寺因人重，清风尚可寻。\n斜阳明晚阁，老竹暗秋林。\n兜率西归久，香山北望深。\n登临成感慨，烟月独知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春莫","author":"赵希㯝","text":"薄薄寒侵酒面和，可怜春事委流波。\n两堤杨柳东风老，一曲池塘夜雨多。\n花落莺声还在否，桑空蚕事又如何。\n壮心不逐流年去，倚剑青天发浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雪","author":"赵希㯝","text":"飞下瑶天整复斜，一番馀冻损芳华。\n荒荒月晓三千界，漠漠烟寒十万家。\n柳外直疑先著絮，梅边浑似后开花。\n东风吹作巴江水，浩荡龙涛赴海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕","author":"赵希㯝","text":"霄虚白露漙，木叶下危阑。\n月澹钟声晓，灯青剑影寒。\n人心山莽莽，世事海漫漫。\n何日平胡虏，西风望眼宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀次韵","author":"赵希㯝","text":"雨歇空阶净绿苔，西风凉气满楼台。\n鸿飞远渚知初到，燕别明年约早来。\n秋色祇今同世态，时文何意误人才。\n停云影里频搔首，闲把新吟取次裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送自牧黄监镇之官四安","author":"赵希㯝","text":"桃花春浪急，催上霅溪船。\n湖海称佳士，功名负壮年。\n政平民易感，诗好客争传。\n别后加餐饭，因风寄一笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李鹤田东游后还乡","author":"赵希㯝","text":"剑倚梅花鹤梦醒，东游吟骨带秋清。\n台山路杳神仙迹，楚国书来母子情。\n半榻烟霞应有约，一筇风雪且兼程。\n丁宁及早催行李，莫待西湖草色平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送诗僧隆瘦岩","author":"赵希㯝","text":"五载京华客，山中坐得牢。\n禅心天竺石，吟思浙江涛。\n入派名随重，游方步转高。\n秋风飞锡远，相忆读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]