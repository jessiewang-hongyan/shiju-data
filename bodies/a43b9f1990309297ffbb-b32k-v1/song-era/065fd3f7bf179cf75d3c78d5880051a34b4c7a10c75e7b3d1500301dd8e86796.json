[{"title":"丑奴儿/采桑子","author":"王灼","text":"东风已有归来信，先返梅魂。\n雪斗纷纷。\n更引蟾光过璧门。\n绿衣小凤枝头语，我有嘉宾。\n急泛清尊。\n莫待江南烂漫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"王灼","text":"长江飞鸟外，明月众星中。\n今来古往如此，人事几秋风。\n又对团团红树，独跨蹇驴归去，山水澹丰容。\n远色动愁思，不见两诗翁。\n酒如渑，谈如绮，气如虹。\n当时痛饮狂醉，只许赏心同。\n响绝光沈休问，俯仰之间陈迹，我亦老飘蓬。\n望久碧云晚，一雁度寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思","author":"王灼","text":"来匆匆。\n去匆匆。\n短梦无凭春又空。\n难随郎马踪。\n山重重。\n水重重。\n飞絮流云西复东。\n音书何处通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近","author":"王灼","text":"小砑碧霞笺，不见近来消息。\n玉骨瘦无一把，又不成空忆。\n炉熏歇尽烛花残，佳梦了难得。\n二十五声秋点，最知人端的。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画堂春 春思","author":"王灼","text":"暖风和雨暗楼台。\n馀寒巧作愁媒。\n半春怀抱向谁开。\n忍泪千回。\n断梦已随烟篆，醉魂空殢琼杯。\n小窗瞥见一枝梅。\n疑误君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 早春感怀","author":"王灼","text":"命啸无人啸，含娇何处娇。\n江南烟水太迢迢。\n璧月琼枝空想、夜和朝。\n目断肠随断，魂销骨更销。\n琐窗风雨不相饶。\n犹似西湖一枕、听寒潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨来迟","author":"王灼","text":"柳暗汀洲，最春深处，小宴初开。\n似泛宅浮家，水平风软，咫尺蓬莱。\n更劝君、吸尽紫霞杯。\n醉看鸾凤徘徊。\n正洞里桃花，盈盈一笑，依旧怜才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春光好","author":"王灼","text":"和醉梦，上峥嵘。\n忆娉婷。\n回首锦江烟一色，不分明。\n翻为离别牵情。\n娇啼外、没句丁宁。\n紫陌绿窗多少恨，两难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 赋登楼","author":"王灼","text":"休惜馀春，试来把酒留春住。\n问春无语。\n帘卷西山雨。\n一掬愁心，强欲登高赋。\n山无数。\n烟波无数。\n不放春归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"王灼","text":"一样婵娟别样清。\n眼明初识董双成。\n香风随步过帘旌。\n笑捧玉觞频劝客，浣溪沙里转新声。\n花间侧听有流莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒泉子 送诣夫成都作。重九","author":"王灼","text":"锦水花林，前度刘郎行乐处，当时桃李卧莓苔。\n又重来。\n今年菊蕊为君开。\n赖有诗情浑似旧，西风斜日上高台。\n醉千回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 政和癸丑","author":"王灼","text":"飞霞半缕。\n收尽一天风和雨。\n可惜黄昏。\n残角疏钟要断魂。\n双鱼传信。\n只道横塘消息近。\n心事悠悠。\n同向春风各自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一 填太白应制词","author":"王灼","text":"东风归早。\n已绿瀛洲草。\n紫殿红楼春正好。\n杨柳半和烟袅。\n玉舆遍绕花行。\n初闻百啭新莺。\n历历因风传去，千门万户春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二 妓诉状立厅下","author":"王灼","text":"坠红飘絮。\n收拾春归去。\n长恨春归无觅处。\n心事顾谁分付。\n卢家小苑回塘。\n于飞多少鸳鸯。\n纵使东墙隔断，莫愁应念王昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 次韵赠戴时行","author":"王灼","text":"漠漠郊原荒宿草。\n黄花趁得秋风早。\n万里岷峨归梦到。\n东篱好。\n未应花似行人老。\n古往今来成一笑。\n为君醉里销沈了。\n不用登临敧短帽。\n愁绝□。\n吴霜点鬓教谁扫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 和令狐公子","author":"王灼","text":"风柔日薄江村路。\n一鞭又逐春光去。\n胡蝶作团飞。\n竹间桃李枝。\n醉魂招不得。\n一半随春色。\n桃李□无多。\n其如风日何。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其一","author":"王灼","text":"别来杨柳团轻絮。\n摆撼春风去。\n小园桃李却依依。\n犹自留花不发、待郎归。\n枝头便觉层层好。\n信是花相恼。\n觥船一棹百分空。\n拚了如今醉倒、闹香中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其二","author":"王灼","text":"姚黄真是花中主。\n个个寻芳去。\n春光能有几多时。\n莫遣无花空折、断肠枝。\n蜂媒蝶使争撩乱。\n应妒传觞缓。\n问花端的为谁开。\n拟作移春小槛、载归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 送夏立夫","author":"王灼","text":"平生五色江淹笔。\n合占金闺籍。\n桃李满城春，恨□屏□，只作三年客。\n画船暂系河桥侧。\n一醉分南北。\n惆怅酒醒时，雨笠风蓑，似旧无人识。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王灼","text":"柳暗大堤曲，梅藏解佩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"启至大寨闻擒鬼章捷书上奏喜而为诗","author":"王纯臣","text":"黄城匹马捷音来，且喜洮东破虏回。\n纵使淮西功第一，未闻生缚七渠魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗赠富乐山海公长老","author":"王纲","text":"心地如今不动尘，大千境界百年身。\n掩关明月上峰顶，满座清风生玉津。\n雪岭松筠为节操，石楼钟磬度昏晨。\n已同七老图岩壁，便是龙华会里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦邮晚泊","author":"王纶","text":"水宿风餐第几程，落帆刚趁晚霞明。\n村醪小饮不成醉，明月推篷初欲生。\n自愧菲才膺閒命，谁能高卧闭柴荆。\n茫茫家国偏多感，静听渔榔断续声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"王纶","text":"华林幽胜地，胡氏旧门闾。\n四远来名士，一家常义居。\n素风殊不坠，儒业未曾虚。\n何日谐寻访，琴棋万卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百万湖 其一","author":"王?","text":"台下瀰漫百万湖，丛生萑苇伴菰蒲。\n自从围作民田后，每遇凶年一物无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百万湖 其二","author":"王?","text":"农人今岁不施功，浸撒田中谷自丰。\n极目黄云无际限，只将晴色望天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令","author":"王苍","text":"补成团扇绣残工。\n并蒂瑞芙蓉。\n花心欲就针折，赪玉唾残茸。\n寻断绪，怨西风。\n寂寥中。\n两般时候，旧月新霜，晓角昏钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 观星","author":"王识","text":"一雨洗空阁，象纬迫人清。\n披襟台上，坐看北斗正旋衡。\n知是南宫列宿，初出极星未远，龙角正分明。\n河汉馀千里，风露已三更。\n坐未久，书帙散，酒壶倾。\n凉生殿阁，冷然邀我御风行。\n拟欲乘槎一问，但得天孙领略，安用访君平。\n莫笑儒生事，造化掌中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日田园杂兴二首 其二","author":"王进之","text":"东君私我此闲身，脱却青衫野服更。\n桑可以丝麻可绩，麦宜续食韭宜羹。\n分甘垄上耕云隐，梦不湖边拾翠行。\n物意岂知沧海变，晓风依旧语流莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日田园杂兴二首 其一","author":"王进之","text":"桑田沧海几兴亡，岁岁东风自扇扬。\n细麦新秧随意长，闲花幽草为谁芳。\n午桥萧散名千古，金谷繁华梦一场。\n满眼春愁禁不得，数声啼鸟在斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王邻臣","text":"仲舒窥圃三年废，东野看花一日多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"查林对月","author":"王侃","text":"一天风月近中秋，凝望家山不阻修。\n漫浪疏林人已倦，心期犹与素光谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画扁 其二","author":"王侃","text":"深林拥苍翠，绝巘顷陂陀。\n便欲褰裳去，乘风逸兴多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹰爪花","author":"王侃","text":"宿蔓盘根悉剪夷，只留庭下雪霜枝。\n史君第一憎贪攫，岂是苍鹰露爪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴 其一","author":"王侃","text":"庭际幽兰手自种，托根不与春花共。\n冉冉同风数茎竹，襟期元作幽人供。\n如何江湖浪征逐，芳信却因冯翼送。\n多惭独处岁将晚，尚想清标形晓梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日杂兴 其二","author":"王侃","text":"泽国风饕霜力紧，黄落凋残碧成锦。\n最怜柿叶与枫林，平园物色正潇凛。\n造化不翕何所张，独怪廷朝漏融景。\n天理真机默玩心，悟取灵根发深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过分水岭即事次韵","author":"王侃","text":"积阴颇愁寂，一笑晚风生。\n豪爽传诗韵，清真破俗酲。\n层峦思就隐，大壑戒趋程。\n芳草无人种，连天只么青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过冯岭感旧","author":"王侃","text":"危陟山椒下碧湾，篮舆竟日剧千盘。\n伤心四起经行旧，那复当年綵袖班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜对梅花示彦恭侄 其二","author":"王侃","text":"羁旅阅世纷，坐念百忧集。\n共子时剧谈，满怀冰雪洁。\n仪型谁有常，梅花静玉立。\n何用对忘忧，岁寒端有益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜对梅花示彦恭侄 其一","author":"王侃","text":"羁旅不自怡，坐阅芳岁晚。\n江湖有莫逆，梅花还到眼。\n平生相慰藉，风期无近远。\n今夕共短檠，与子兴不浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄玉涧","author":"王侃","text":"山中之乐属高人，风月无边取次吟。\n但使胸中饱丘壑，莫将片点著埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画扁 其一","author":"王侃","text":"野桥人迹少，林静谷风闲。\n谁识孤峰顶，悠然宇宙宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乡饮酒倡和诗","author":"王侑","text":"旴江文物盛江西，有底醇风欠转移。\n端藉乡贤扶世道，共修礼饮迪民彝。\n厖眉华发四朝老，方领圜冠三代仪。\n天理人心非外有，信乎王道不难知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乡饮酒诗","author":"王侑","text":"圣主方求治，偏城敢后儒。\n采芹严祀事，序齿集生徒。\n黄发居宾右，青衿隘坐隅。\n远侔鲁泮饮，下陋汉庭酺。\n席正群心肃，杯行美化敷。\n君恩何以报，忠孝是良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺侍郎 其一","author":"王其","text":"宽碧高楼上倚天，等闲蚁垤视凌烟。\n归飞华表三千岁，砥柱中流五百年。\n摆脱浮云闲富贵，逍遥长日散神仙。\n天公已定乘除计，八十春秋到八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺侍郎 其二","author":"王其","text":"悬车高蹈姓名香，化得东阳似洛阳。\n节亚芗林仍峻洁，貌如笠泽更精强。\n丰标留作耆英样，寿命应同国祚长。\n岁岁梅花开腊五，来陪青鹿奉霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"王叔安","text":"坐看飞溜落檐牙，吟里风吹鬓脚斜。\n洛下牡丹无处处，一枝空插杜鹃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李伯时飞骑习射图","author":"王叔简","text":"飞毬饮羽柳如截，马气横生人更杰。\n不作游观御宝津，骑战还应一当百。\n天家行乐少人知，龙眠属从天上归。\n意象惨淡研精微，曹霸以来无此奇。\n壮夫披图双泪垂，时危那得生致之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘公亭","author":"王和中","text":"槛外长江江外山，江光山色远相连。\n人耕桑柘无穷地，鸟渡烟云不尽天。\n寒日竹笼沽酒市，晚风笛起钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余襄公祠","author":"王称","text":"寂寞孤城野水滨，乱馀犹见几家存。\n女墙落日埋秋草，官树啼乌集暮云。\n百战徒闻存国步，孤忠谁复吊英魂。\n夜来遗庙荒庭月，长?悲笳不忍闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"通天岩","author":"王奇","text":"松罗石室中，清雅胜支公。\n地静无尘到，天高有穴通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"续县令题雁诗","author":"王奇","text":"只只含芦背晓霜，尽随鸳鹭立寒塘。\n晚来渔棹惊飞去，书破遥天字一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿荫亭","author":"王奇","text":"创得幽亭近岭梅，绿阴名好称仙才。\n四围山色檐头出，一带泉声竹里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅中有感","author":"王奇","text":"泽国来游岂厌重，羁孤怀感自无穷。\n雁声不到歌楼上，秋色偏欺客路中。\n宿寺梦回莲叶雨，渡江衣冷荻花风。\n谁怜未得青云志，琴剑年年西复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题修仁县群峰驿","author":"王奇","text":"槛前流水面前山，幽鸟孤云自往还。\n农父不知佳景好，使车才得片时闲。\n桄榔树暗寒溪上，踯躅花红暮雨间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王奇","text":"不拜春官为座主，亲逢天子作门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢刘本玉先生惠簟","author":"王学","text":"南朝笛竹蕲为良，织成文簟琉璃黄。\n旧物正尔冷如铁，此君无奈寒如霜。\n山斋溽暑正六月，野人清梦迷三湘。\n卷舒随分且藏节，作诗为报刘中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 送汪水云之湘","author":"王学文","text":"记当年、舞衫零乱，霖铃忍按新阕。\n杜鹃枝上东风晚，点点泪痕凝血。\n芳信歇。\n念初试琵琶，曾识关山月。\n悲弦易绝。\n奈笑罢颦生，曲终愁在，谁解寸肠结。\n浮云事，又作南柯梦彻。\n一簪聊寄华发。\n乾坤桑海无穷事，才历昆明初劫。\n谁共说。\n都付与焦桐，写入梅花叠。\n黄花送客。\n休更问湘魂，独醒何在，沈醉浩歌发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石梁和韵","author":"王学可","text":"天巧何年路，千峰乱入云。\n瀑飞双涧合，崖断一桥分。\n树色春犹冻，猿声夜或闻。\n灵踪如可见，煮茗共炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄宫 其一","author":"王学可","text":"天柱峰高万壑分，故留九锁限尘棼。\n泉飞窗牖长为雨，日上冈峦半是云。\n洞擘阴崖通远岫，石生暗晕作奇纹。\n圣朝每为民祈福，绝笈求仙汉代君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄宫 其二","author":"王学可","text":"历遍江湖几万重，岂期方到洞霄中。\n山翻九锁天分出，洞彻三茅地透东。\n夭矫龙蛇幢节影，晶荧日月御香风。\n茫茫世上寻云汉，何必仙宫胜此宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山道中","author":"王宗贤","text":"山萦九锁路幽深，古木高森积翠阴。\n自是仙家风景异，欣欣杖策步云林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山路口","author":"王宗贤","text":"九锁山深隐洞天，一峰柱耸现云巅。\n从兹可达栖真境，透入青霄会众仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤山","author":"王宗贤","text":"穹崇千尺压群峦，终日登临兴未阑。\n佳趣清幽尘自涤，升天犹有许君坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞","author":"王宗贤","text":"符札深投进玉函，琅琅震响穴难探。\n隔凡不许游人到，一窦中藏万丈潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天柱山","author":"王宗贤","text":"擎天一柱出群峰，时见真仙隐化中。\n瑞应中都成福地，伯元主宰有神功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙蜕洞","author":"王宗贤","text":"羽人游洞获龙骸，知是鳞潜蜕骨来。\n岩穴嵌巉深数丈，惊人蛇虺隔凡才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙迹岩题诗二十三首 其十八 茶岭","author":"无名氏","text":"秀钟天柱产灵芝，造就仙芽发嫩旗。\n采向先春烟露里，喊山凤尾岂为奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舫斋","author":"王宗贤","text":"满船载月归时趣，泛宅浮家避世狂。\n趺坐舫斋能静嘿，神驰游宴无何乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]