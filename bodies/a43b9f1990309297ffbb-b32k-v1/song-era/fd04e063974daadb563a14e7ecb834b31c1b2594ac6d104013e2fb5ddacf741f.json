[{"title":"蝶恋花","author":"杨道居","text":"气禀五行天与秀。\n瑞见枢延，况是黄钟奏。\n日影量来添午昼。\n柳梅消息年时候。\n红粉吹香帘幕透。\n深院笙歌，劝饮金钟酒。\n乐事赏心千岁有。\n黑头人做三公有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉山","author":"杨雯","text":"霞衣玉佩去飘飘，控鹤仙人不可招。\n难信岭头顽石畔，分明有路入青霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春","author":"杨雯","text":"不知何处碧云乡，冉冉平生可断肠。\n怪底乾坤惟梦短，老来岁月更心长。\n城头急鼓千家怨，江上残梅一水香。\n自作醉侯开醉国，笑人奔走为谁忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿峡市","author":"杨雯","text":"人烟正摇落，楼笛颇清圆。\n老树依山驿，东风上峡船。\n江湖万里外，灯火十年前。\n世路能令老，吾生且醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北客","author":"杨雯","text":"北客相催发，一日举千帆。\n遥怜庾开府，岁晚望江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋武帝庙","author":"杨雯","text":"溪声答松风，巨石出老拳。\n古树不知名，岌岌蛟龙缠。\n夕阴互出没，秋华带芳鲜。\n葱葱帝王气，栋宇垂千年。\n虎贲秉霜戟，惨淡生云烟。\n宫人翠龙驾，手持玉连蜷。\n昌明坐恍惚，精神雷在天。\n大呼司雍间，旬月无秦燕。\n昔为万夫特，今受众目怜。\n石马亦埋没，岁时草芊芊。\n小臣异代士，见之泪迸泉。\n齐人思爽鸠，蜀人哀杜鹃。\n江东旧正朔，礼奉敢不虔。\n但愿君王心，不忘载荻船。\n下山又再拜，白日当空悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迢迢空同山","author":"杨雯","text":"迢迢空同山，乃在西极巅。\n玉泉荫灵芝，上有千岁仙。\n安得凌风翼，相从白云间。\n神仙本冥漠，天运乃推迁。\n不如酌我酒，或得成自然。\n田父要我语，饮者亦非贤。\n愿君长独醒，加餐足高年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游观山","author":"杨雯","text":"古寺隐山腹，苍苔行地衣。\n岑寂少人迹，路才一线微。\n问谁促公行，一句山谷诗。\n閒来就汤沐，聊叩幽人扉。\n相投一杯水，气味如曹溪。\n兴尽即云返，重到还无期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐柏崇道观","author":"杨愈","text":"深入黄庭景，徒思五滴泉。\n青牛眠药坞，白鹿卧芝田。\n浮世人空老，长生事宛然。\n三尸飞不去，皆是自留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青城山","author":"杨摅","text":"薄宦驱人太不情，好怀谁是与山亲。\n胡为又作折腰去，三十六峰应笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隆庆","author":"杨椿","text":"坤地厚鳌背，艮山比犬牙。\n云根生夜雨，石刃凑朝霞。\n蜀国关防壮，巴山道路斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杨献民","text":"县官伐木入烟萝，匠石须材尽日磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题水弄山","author":"杨筠","text":"曲曲溪流叠叠山，稻塍高下路回环。\n晓暾初射林霏落，一道炊烟紫翠间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题石藤二夫人庙","author":"杨筠","text":"古藤阴锁石粼粼，死骨犹香庙像新。\n世上男儿轻失节，何颜祠下拜夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年冬后圃蔬茎连理篱杨殊木同枝又蓏生连实东园橘亦并蒂一年四瑞","author":"杨简","text":"兄弟和气与天通，连理蔬茎瑞郁葱。\n造化神机非远近，不当言异又言同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴机宜","author":"杨简","text":"十里松湖乘雁归，酒乡近处一惊飞。\n颇闻水月中泉石，笑我年来杖履稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妙庭观","author":"杨简","text":"古人所弃今人慕，不谓苏公亦世情。\n此话若教天上听，定须笑倒董双成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其五","author":"杨简","text":"我吟诗处莺啼处，我起行时蝶舞时。\n踏著此机何所似，陶然如醉又如痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其二","author":"杨简","text":"谁省吾心即是仁，荷他先哲为人深。\n分明说了犹疑在，更问如何是本心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其三","author":"杨简","text":"若问如何是此心，能思能索又能寻。\n汝心底用他人说，只是寻常用底心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其一","author":"杨简","text":"此道元来即是心，人人抛却去求深。\n不知求却翻成外，若是吾心底用寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其十三","author":"杨简","text":"夫子文章不可为，从心到口没参差。\n咄哉韩子休污我，却道诗葩与易奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其十二","author":"杨简","text":"曩疑先圣啬于言，何不明明细细传。\n今醒从前都错认，更加详后即纷然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其六","author":"杨简","text":"心里虚明著太空，乾坤日月总包笼。\n从来个片閒田地，难定西南与北东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其十六","author":"杨简","text":"诗痴正自不烦攻，只为英才辄堕中。\n今日已成风俗后，后生个个入樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其十","author":"杨简","text":"回心三月不违仁，已后元曾小失真。\n一片雪花轻著水，冥冥不复省漓醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其七","author":"杨简","text":"莫将爱敬复雕镌，一片真纯幸自全。\n待得将心去钩索，旋栽荆棘向芝田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉泰昭阳大渊献筑室董孝君祠之西下有湖焉某曰溪以董君慈孝而得名县又以是名则是湖宜亦以慈名作诗曰 其一","author":"杨简","text":"惜也天然一段奇，如何万古罕人知。\n只今烟水平轩槛，触目无非是孝慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠野牛","author":"杨简","text":"曾将大手挽恒河，引得龙来地起波。\n何待砚池藏滴水，工夫元不费揩磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑咏春偶成 其二","author":"杨简","text":"天造慈湖迥出尘，无冬无夏只长春。\n四山桃李围新锦，一邑风光让绝伦。\n涧水檐傍谈妙理，山禽柳外说天真。\n杏坛无限难传意，付与凭栏寓目人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑偶书 其二","author":"杨简","text":"物物皆吾体，心心是我思。\n四时非代谢，万说不支离。\n涧水谈颜乐，松风咏晰词。\n仲尼亲许可，实语断非欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丹桂","author":"杨简","text":"世眼纷纷丹与黄，广寒宫里亦如常。\n目前不作两般见，笔下方腾万丈光。\n且莫锱铢深浅色，也休斤两淡浓香。\n灵根已入诗人手，不许姮娥擅此芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙子夏偶书 其一","author":"杨简","text":"风从槐市过来凉，丝竹金英尚在堂。\n惟有慈湖亲听得，近来吾党亦专芳。\n如何钻仰徒劳苦，要说精粗与短长。\n神气风霆俱是教，四时代谢尽彰彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石鱼楼 其一","author":"杨简","text":"多谢天工意已勤，四时换样示吾人。\n碧桃丹杏分明了，绿艾红榴次第陈。\n秋雁声中休卤莽，雪梅枝上莫因循。\n机关踏著元非彼，正是吾家固有身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石鱼楼 其二","author":"杨简","text":"个里包坤更括乾，精神微动便纷然。\n桃红柳绿春无迹，鱼跃鸢飞妙不传。\n菱浪岂缘风衮衮，荷珠不为露涓涓。\n分明是了何言否，此事难容郑氏笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示叶元吉","author":"杨简","text":"元吉三更非鼓声，慈湖一夜听鹅鸣。\n是同是异难声说，何虑何思自混成。\n炉炭几番来暖热，天窗一点吐圆明。\n起来又睹无穷景，水槛澄光万里清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴天机","author":"杨简","text":"洪范论时常，心官职雨旸。\n分龙何效竭，负扆久忧伤。\n禾稿几于白，苗苏尚可苍。\n焦劳殊未已，诏旨欲盈箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿赵泉使 其二","author":"杨简","text":"来迎父老喜相扶，才大能令惠爱孚。\n十道山川新约束，三楼风月旧规模。\n岩岩气貌踰嵩华，坦坦胸襟有典谟。\n仰止光华申善颂，何当敛版向庭趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿赵泉使 其一","author":"杨简","text":"孕秀钟鼎庆源长，属近亲依日月光。\n弧矢影侵槐阴绿，熊罴梦入藕花香。\n诗书博雅今平献，政事精明古赵张。\n九府本根关大体，故分华节到鄱阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿倅生晨 其二","author":"杨简","text":"方饮屠苏庆岁元，五开历草又生贤。\n沈檀斗品来樽底，梅竹交光闯水边。\n好把绯鱼追旧事，肯同螃蟹话当年。\n圣贤德业归方寸，稳取崇名上泼天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿倅生辰 其一","author":"杨简","text":"州家和气蔼新春，得所亲贤蔚豹文。\n天遣星辰为二屏，我将风月作三分。\n碧梧翠竹来华胄，岳凤溟鲲驾庆云。\n敬为同寅香一瓣，愿言臭味等炉薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍象山先生游西湖舟中胥必先周元忠弈 其二","author":"杨简","text":"浅红深翠绿高低，各出精神不肯齐。\n山色好时新雨沐，湖光远处淡烟迷。\n不知醉后无言句，逼近前来乞品题。\n我亦未能勤领略，只烦莺啭与乌啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍象山先生游西湖舟中胥必先周元忠弈 其一","author":"杨简","text":"百里平湖十里堤，新芜苒苒绿齐齐。\n水晶宫里光风静，碧玉壶中远近迷。\n局外有棋输与我，口边得句岂须题。\n流莺却会幽人意，故向人间一两啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净土院","author":"杨简","text":"此意分明有底深，蒲团斜倚满铺阴。\n岂容俗子閒抬眼，只许清风得入林。\n我对此君无一事，自言幽处直千金。\n古人今已成陈迹，犹向当年击处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈大著追九日之集","author":"杨简","text":"起兴家山翠作围，紫宸垂旨未容归。\n千峰来献无穷妙，万影相从不敢违。\n碧玉壶中丹叶舞，水晶宫里白云飞。\n凭栏相与谋荒政，第一言无罪岁饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜蚊","author":"杨简","text":"夜蚊告教一何奇，妙语都捐是与非。\n偏向耳旁呈雅奏，直来面上发深机。\n惜哉顽固终难入，多是聋迷听者希。\n费尽谆谆无领略，更烦明月到窗扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉檄往哭象山复会葬及归自金溪留宿本县仙乐观归而作是诗 其一","author":"杨简","text":"膏露奚为降，传闻不偶然。\n两晨呈瑞处，万叶绕炉前。\n尝审如饴味，谁操动物权。\n天权非远近，不可向人宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝莲官舍偶作","author":"杨简","text":"云海湖山有主人，宝莲峰顶露精神。\n有时领客登高去，亲手挑窗对景新。\n万里苍茫融妙意，三杯虚白浴天真。\n出门更有慇勤在，为奏松风又绝伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明融 其二","author":"杨简","text":"妙绝虚明万里光，融融静静渺茫茫。\n其间变化无踪迹，却有方圆与短长。\n仰首看空閒顾盻，聚头窃语足商量。\n竹稍忽作潇然韵，正是云门第一章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临安张帅生辰诗 其一","author":"杨简","text":"山野书生百不知，同官元有诞辰诗。\n怪他衙报来何晚，笑我词源发处迟。\n坐想鼎来门下士，争雄尽吐腹中奇。\n如何独有关西后，只解揄扬抚恤辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临安张帅生辰诗 其二","author":"杨简","text":"为恐他人未必知，故推善意入歌诗。\n非誇辇毂先弹压，肯把宽仁作钝迟。\n不但舆情都喜惬，亦闻天语有褒奇。\n铺张才美终难了，只此今朝祝颂辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺傅宪生辰 其二","author":"杨简","text":"鄱阳江上是瀛洲，中有神仙暂此游。\n明月襟怀民善颂，浮云喜怒我无留。\n蟠桃一熟三千岁，玉陛重瞻十二旒。\n谙尽民情并世道，从容借箸属君侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺傅宪生辰 其一","author":"杨简","text":"奚必生申向岳求，卧龙山水瑞光浮。\n御风天上骑箕尾，持节人间占斗牛。\n岩下光芒惊走电，笔端河汉泻新秋。\n精神已致鸣山雨，更愿为霖遍九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺朱倅","author":"杨简","text":"举杯话别几时逢，此事分明鉴象中。\n到处风光无远近，毋言易道有西东。\n轻轻衣湿梅坡雨，款款舟行柳岸风。\n忽忆从游谈笑处，苏公堤上跃花骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章大著出守衡阳","author":"杨简","text":"济济众贤俱，徐徐五马驱。\n中司亲雁序，南岳佩鱼符。\n吴楚从今异，参辰幸小殊。\n他时群玉聚，相与话踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"杨简","text":"风云雨雪自何来，我有乾元大矣哉。\n万景出奇供杖履，群峰环翠拱楼台。\n兴来吟咏谁裁剪，饭罢游行岂去回。\n信口道来俱妙妙，教人寻访几枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富春龙门","author":"杨简","text":"桑麻迤逦入高原，级级差差水落田。\n树色自分深浅绿，山光都在淡浓烟。\n竹舆渐近钟鸣处，诗句来从鸟语边。\n又是一番新样致，如何写得十分全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湍水岩祷雨诗 其二","author":"杨简","text":"精祷何须到处临，只祈湍水沛甘霖。\n驱除旱魃无馀事，感召灵神在寸忱。\n庭砌已酣行蚁战，山川能动老龙吟。\n当知一饱皆公赐，雷地何人无喜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙检讨封送所与诸同朝倡酬盛作某老拙愧后砾某祗拜以呈","author":"杨简","text":"原庙陪祠晓色开，从容复指缀衣来。\n花填辇路惊何早，春向皇都特亟回。\n声赞俯躬千冠带，香浮夹道万楼台。\n传闻归燕隆亲睦，天上云韶拱玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉定改元久旱得雨诗呈张令君 其一","author":"杨简","text":"底事焦劳偃室中，耕农皋月未施工。\n两龙会合千山暗，数日霖零百里同。\n举手尽称知县雨，何心领略大王风。\n再生天造奚为报，海有穷时此不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉定改元久旱得雨诗呈张令君 其二","author":"杨简","text":"两日长忧积满中，感深令祷格天工。\n欣欣处处人人喜，渺渺茫茫亩亩同。\n不至伤如无极雅，行当改赋黍离风。\n邑民颂德千和万，毫楮如何可以穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题华盖仙山院默斋","author":"杨简","text":"渐渐疏钟动，幽深一径开。\n炎光隔林麓，清兴绕崔嵬。\n拟作临流赋，应须倩雨催。\n小窗宜挂起，且放竹风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题将作军器二监","author":"杨简","text":"出入云从二监中，新来盘薄翠玲珑。\n饱观大景金星洞，唤作慈湖鬓雪翁。\n石怪山奇谁造化，鸢飞鱼跃我家风。\n只今笑语难闻见，灼与人心万古同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂礼成诗","author":"杨简","text":"去腊陈三劄，兹秋奉九筵。\n群英俱有赋，孤迹敢无篇。\n宗祀新隆礼，宸衷上格天。\n虚明融寂寞，大化合敷宣。\n近骇边烽急，前惊内寇连。\n鬼神虽默佑，刑政谨将然。\n咸谓公私杂，希聆宰辅贤。\n积深千万弊，任止二三年。\n苟且姑循旧，嗟咨亦屡传。\n旱蝗难熟视，殍殣惨相联。\n寒后裘方索，薪间火已然。\n冕旒几咫尺，轩陛隔天渊。\n善颂无谀语，愚衷有至虔。\n愿兢兢业业，安止出刚乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑咏春偶成 其一","author":"杨简","text":"叶叶枝枝都教女，红红白白尽呈人。\n如何自古知音少，方到而今得句新。\n既遣鸟啼频嘱付，又令鹤舞出精神。\n便将天作一张纸，难画慈湖二月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁丑偶书 其一","author":"杨简","text":"新年七十七，是虚不是实。\n我心包太空，有无混然一。\n比日腑脏作，示病而无疾。\n凭栏拱翠峰，可咏不可诘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]