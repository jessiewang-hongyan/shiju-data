[{"title":"题剑江姚叔宏吟卷三首 其三","author":"萧立之","text":"薄饭不羹春荠老，枉君远道辔玲珑。\n金膏冰碧须沧海，万里扬帆东更东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题剑江甘元英诗号溪山画谱","author":"萧立之","text":"一幅亭前溪与山，画无好手记苍寒。\n如今有问名亭意，只就君家画谱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 妖烛","author":"萧立之","text":"烛似无情还有情，酒边故故弄昏明。\n宴酣尽道谁能觉，□□□□玉笛声。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 灯婢","author":"萧立之","text":"风流看尽当时事，夜夜擎灯绣帐前。\n野草荒田自他日，断无外传与伶玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 冰山","author":"萧立之","text":"冰山难倚子能知，如此嵩山只合归。\n莫恨有头抬不得，得抬头处更危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 玉有太平字","author":"萧立之","text":"瑞玉天开此日奇，分明中有篆文题。\n翠华不作西南幸，肯信渔阳有鼓鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 美人呵笔","author":"萧立之","text":"冻笔能回雪殿春，君恩珍重遣宫嫔。\n金花笺上清平乐，倚得词工却误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 射团","author":"萧立之","text":"四海升平征战息，宫中行乐外间无。\n粉团滑腻犹□□，愁杀胡儿忆塞酥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 风流阵","author":"萧立之","text":"两阵雌雄禁掖间，纷纷攻击寸心寒。\n风流天子贪行乐，不作伊川被发看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 失题","author":"萧立之","text":"腻粉匀成玉箸垂，春风面面晓妆迟。\n妆成图得君王顾，却为君王谶别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 游仙枕","author":"萧立之","text":"一枕仙游足自娱，萧然清思离尘区。\n十洲三岛经行处，知有岷峨剑阁无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 失题","author":"萧立之","text":"六军难解驿门围，此日回头事事非。\n千炬摇红成底用，腥魂夜逐月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 金函","author":"萧立之","text":"山水有图无逸换，锦坊兴废变初终。\n咸阳父老能言语，不在金函谏疏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 移春槛","author":"萧立之","text":"东来西去木为轮，异草名花易地春。\n未必乾坤关气数，世间何事不由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 辟寒犀","author":"萧立之","text":"迢迢交趾到长安，黄色如金眼不看。\n阖殿春回人未觉，外间何处不风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 有脚阳春","author":"萧立之","text":"有脚□□□□□，开元人物晓天星。\n满颐雪刺归何处，坐看秋风入禁庭。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 红冰","author":"萧立之","text":"当年召入即承恩，何事登车却断魂。\n只道红冰生别泪，不知杀气满乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 失题","author":"萧立之","text":"六宫粉黛谩三千，妃子椒房宠自专。\n应恨长门锁秋鬓，君恩也赐洗儿钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 长汤十六所","author":"萧立之","text":"赐浴华清总有名，长汤十六更泠泠。\n可怜洗□□□□，□洗胡尘一点腥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开元天宝杂咏 失题","author":"萧立之","text":"蛛丝卜巧对西风，岁岁佳期此夕同。\n谁道禁宫天共远，他时言语出临邛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠邓景宪","author":"萧立之","text":"两山不隔一层云，金鲫池边夜打门。\n袖有新诗期短鬓，室无奇字枉芳樽。\n客程怀抱仍春潦，人事间关可梦魂。\n离合悠悠自生理，别情吟恨不堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次李玉峰见寄","author":"萧立之","text":"四方上下忽相从，君信西来我信东。\n剡雪不乘清夜兴，军山依旧梦魂中。\n合离有数机如发，岁月无情鬓欲翁。\n斜照一林云百树，吟筒翻作递愁筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴官舟中","author":"萧立之","text":"蛰龙初动雨峥嵘，黄浊连宵与树平。\n路入峡头天一握，梦回蓬背月三更。\n江村无复鱼盐市，客饭初尝菌蕨羹。\n小泊桥南沽斗酒，一街灯火灌婴城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬邵中立","author":"萧立之","text":"金鲫池边伤晚风，莲花峰下倚长松。\n水程半月孤蓬雨，客饭浑家野寺钟。\n心事岁寒诗眷属，鬓根秋色老形容。\n片云影里湖湘隔，莫爱新吟寄短封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游苏仙山","author":"萧立之","text":"坛下松声江上潮，坛前天近北风高。\n山腰洞黑藏丹灶，云顶秋深落石桃。\n逆理偷生虽世论，离群独立亦人豪。\n仙家尽有青精饭，不与吟翁绿鬓毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至日次韵","author":"萧立之","text":"混辟无穷运以刚，积阴打底有微阳。\n驱驰道路年光晚，收拾身心意味长。\n三日南风天不雨，一编周易鬓微霜。\n乾坤只在梅花上，梅不能言心自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次府教一览亭韵","author":"萧立之","text":"秋膺重叠有谁编，客意难凭燕子传。\n欲送寒衣仍冷雨，稍疑飞雾近南天。\n杨花舞歇春无力，湖水空明晚自烟。\n日日诗筒星火急，吟窗秃尽笔锋尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兴宁界上","author":"萧立之","text":"压脑文书坐得牢，偶然散诞此江皋。\n一春冷雨莺花老，十日新晴麻麦高。\n鸟迹窎留仓颉字，草香撷出屈平骚。\n不知何许缫车动，又送新丝入鬓毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县圃白莲","author":"萧立之","text":"四柱茅亭秋一间，砻冰琢玉照乾坤。\n香分韩寿春衫味，花带苌弘冷袖痕。\n奔月蜕馀仙去骨，凌波招得别来魂。\n今宵睡足敲窗雨，家在西湖水满门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁巳除夕","author":"萧立之","text":"攽春过了雪犹勍，枝北枝南开未曾。\n风雨闭门人守岁，江淮断道士椎冰。\n说三生梦溪桥酒，抄一年诗纸帐灯。\n世事正长双鬓短，客床无寐曲寒肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人","author":"萧立之","text":"湘野源头筇一枝，黄云黑雾雨淋漓。\n天公有眼能青白，世路无情谩崄巇。\n场屋秋风三岛梦，江湖夜雨四愁诗。\n苍苔翠竹檐声里，重瀹茶瓯当酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过衡山","author":"萧立之","text":"此是湘南第几程，楚天空旷入深溟。\n九千丈月照衡岳，八百里程归洞庭。\n恨入江蓠骚骨冷，梦回湘竹泪花青。\n客中总为贪程熟，落枣风高我自醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次丁宣尉韵","author":"萧立之","text":"城郭秋深鹊树空，练衣不抵夜来风。\n雁何去处有书下，蟹几时来无酒中。\n生事比梅仍向北，归心如水只流东。\n苍崖翠竹云根屋，擘画残年饭韭菘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题云心适楚吟稿","author":"萧立之","text":"■翠重阴一握天，旧来此地著吟仙。\n自题淮海短长句，又□郴江二百年。\n夜雨滋兰深屈畹，春风种橘长苏泉。\n监州文采推南阮，夔后留看适楚编。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"报恩荷池纳凉呈云心","author":"萧立之","text":"重入僧窗听雨眠，藕花只在客床前。\n囊空不欠苏秦舌，口渴频呼陆羽泉。\n十里湖光天半席，一阑秋影月初弦。\n新凉风物无人共，坐听微钟祇自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月十五夜云心邀泛北湖","author":"萧立之","text":"凉透秋衣不忍眠，更何处觅蕊珠仙。\n水光夜气无三伏，人影花阴共一船。\n菱藻有香风四合，地天无际月双圆。\n碧筒剩对青山吸，此乐人间几百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再韵呈云心","author":"萧立之","text":"西风日日枕书眠，自笑仙城著懒仙。\n溧水已无东野俸，剡溪空趁子猷船。\n诗名入社平生欠，乡梦惊秋昨夜圆。\n念我衰颓君万里，可怜怀抱更中年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次赵东林韵","author":"萧立之","text":"锦袍公子三生梦，又堕歌罗古驿中。\n天上无情覆手雨，人间有恨打头风。\n晚花留日明深树，枯泽回潮起蛰龙。\n草草官称今发白，年时悔不事猿公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄曾翠屏","author":"萧立之","text":"天亦何曾忘此翁，颊红留待醉春风。\n剩吟诗在何妨老，只欠官称未是穷。\n五夜月痕云一角，十年风物鬓双蓬。\n□□□□□□□，倘有江船吾亦东。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅","author":"萧立之","text":"不受世间尘土涴，山之南北水之涯。\n识中庸里有素隐，怪小雅中无白华。\n半点精神春滴淅，一寒风骨雪槎牙。\n淡妆人去罗浮远，肠断东风璧月斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再为梅赋","author":"萧立之","text":"谁遣巫阳招尔魂，春从九地到孤根。\n灵均清节离骚囷，司马深衣独乐园。\n吟客谩能工水月，先儒曾此识乾坤。\n雁行却以山矾进，未许涪翁谓至言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"萧立之","text":"吹万不同无数风，人间遂有水晶宫。\n玉龙夜战三更月，铁马秋行万里空。\n老尽蓬心松柏独，起来蒿目地天通。\n兰亭尽足方金谷，只诧粗人论未公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽彭复雅二首 其一","author":"萧立之","text":"已哭芸兄又哭君，眼中何得更沾巾。\n死无家货营砖甓，生有诗名动缙绅。\n岂亦雕锼伤你寿，不然溟漠妒斯人。\n不忘有子今传业，依旧寒林一气春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽彭复雅二首 其二","author":"萧立之","text":"隔月日前犹得书，说贫说病两劬媮。\n祗言未晚休文瘦，不料竟成长吉殂。\n空有泪花愁宿草，可无哀些折生刍。\n平生交旧铭幽笔，今代萧台有大苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吕秘书中归清凉二首 其一","author":"萧立之","text":"曾剔寒灯读奏篇，先生有胆大如天。\n忠言流落古无此，佳士行藏今偶然。\n诸老与公扶一世，十图为世作千年。\n向来魂梦江闽隔，信有三生问字缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吕秘书中归清凉二首 其二","author":"萧立之","text":"苍玉亭边借屋居，春风忽许赋归欤。\n邻翁争挈葫芦酒，息女催擎箬笼书。\n百世不磨公论在，一城相语笑颜舒。\n兹行奇绝君恩重，压落梅花照笋舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次龚象湖韵二首 其一","author":"萧立之","text":"一盂野饭落闽州，篁竹烟莎屋压头。\n学问无穷吾辈老，乾坤能大此身浮。\n客窗书传青灯雨，故国溪山黄叶秋。\n羡子清吟如玉雪，枯肠尘土不堪搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次龚象湖韵二首 其二","author":"萧立之","text":"剩水残山欲尽头，肯披蓬藋访深幽。\n买盐沽酒三家市，劈箭惊雷一水秋。\n袖里我无区册序，脚跟君有子长游。\n是间尚有堪吟处，莫向西风怨滞留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送易斋何倅官满归括苍","author":"萧立之","text":"壁立屏星照古鄞，两年霹雳快嚬呻。\n圆珠山下月初晓，苍玉洞前梅自春。\n冰雪要教醒醉眼，乾坤何可少斯人。\n葛强旧是樽前客，欲化为龙奈此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归自城外","author":"萧立之","text":"山围不断似勾阑，路入苍云八百盘。\n塔顶受风铃语急，楼高有日鹊巢寒。\n簿书衮衮蚁旋磨，岁月匆匆船下滩。\n两度梅花犹是客，梦随飞翼度巑岏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次使长劝农喜晴韵","author":"萧立之","text":"日日巡檐听雨声，春郊忽为使车晴。\n醉翁之意不在酒，造物于人亦有情。\n天日开明吾道泰，诗书谈笑孽囚惊。\n吟成自对春风笑，却恐高琼意未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山下","author":"萧立之","text":"山下人门白板扉，畦蔬绕屋水田肥。\n五更花信雷初动，一月春晴燕未归。\n官满不储囊粟俸，儿寒犹补海图衣。\n山禽不语如相好，听我劳歌赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次使长苍玉亭","author":"萧立之","text":"诗律峥嵘压岛郊，险如百二据秦殽。\n邹枚一座风流集，陈郭千年道义交。\n公笔欲倾河汉倒，我才如种石田硗。\n山城斗大春风足，阿阁终须著凤巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"使长初约客观文殊寺牡丹忽有走数种自小洛阳来者觞于东山堂席上赋","author":"萧立之","text":"野寺留花待使君，山堂忽放洛阳春。\n数根绿护封枝藓，一骑红飞置驿尘。\n金带巧传天上信，玉酥终作鼎中珍。\n预愁几日都飞去，定□梁公是正人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"使长遣和再韵","author":"萧立之","text":"胡床少住许诸君，綵服移来有脚春。\n浓露洗空妆带酒，暖风吹动袜生尘。\n圣贤清浊杯中物，宾主东南席上珍。\n品格只从根拨见，先生端是识花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张倅韵","author":"萧立之","text":"微官元不疗寒饥，忧乐相从赖有诗。\n万里功名看末路，百年事业有残碑。\n文嫌累气伤雕组，语要惊人欠崛奇。\n湖海平生有今日，白头何处觅新知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起","author":"萧立之","text":"薄酒匆匆与睡谋，夜长无寝怯更筹。\n要嗔早起还多事，浩笑春来失自由。\n雪禁好花偏耐晚，雨肥枯涧已堪舟。\n自怜跬步元婴阁，未有新诗续旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和孙竹云道士先坟种松韵","author":"萧立之","text":"秦岭苍髯铁色仙，却将翁仲作忘年。\n移将根去亲陪土，化作杨公种玉田。\n客子有怀悲故垄，清明无酒哭苍天。\n感君此计能千载，独立斜阳咏此篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孺子亭","author":"萧立之","text":"湖上花藤络树身，傍湖鸥鸟识游人。\n两京寂寞有前哲，一榻风流无后尘。\n史牒不名为隐逸，公心岂自少经纶。\n卷藏独向兹丘老，岁岁祠前荷芰春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送实堂吴帅归天台二首 其一","author":"萧立之","text":"归鞯忽报出山城，笳鼓旌旗送若迎。\n满担图书仍语录，全家风雨又山程。\n行须有用藏非损，来本无心去亦轻。\n家里湖山元不恶，知公久矣忆莼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送实堂吴帅归天台二首 其二","author":"萧立之","text":"天台一万八千丈，玉立人间第一流。\n士要著书归亦乐，道堪传世外何求。\n能令不作三公耳，且共相看一笑休。\n渺渺层云双目短，几时归雁落沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次黄园漕幕韵","author":"萧立之","text":"花如堕珥草遗簪，次第东风转作南。\n巢鷇欲飞看八八，径香不断胜三三。\n著亭屈折谁心计，隔竹推敲客手谈。\n安得身闲携斗酒，趁他姚魏战红酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏云卿","author":"萧立之","text":"洪崖仙人旧隐处，绕舍畦蔬藤一枝。\n君房自致台鼎位，伯也差为儿女知。\n鸿飞千里避弋缴，鱼潜九渊惊钓丝。\n歆宁优劣金在地，世上只赏桐江祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和晏司法吴城山道中韵三首 其一","author":"萧立之","text":"椎鼓发船催出城，平安街子报归程。\n红阑碧水旗招醉，绿树黄鹂画写生。\n为有诗情浑不恶，便无官事也堪行。\n一樽细共灯前说，此夕星河烂熳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和晏司法吴城山道中韵三首 其二","author":"萧立之","text":"十幅风帆十丈桅，空明双眼洗尘开。\n压枝梅大宜羹鼎，贯柳鱼肥更酒杯。\n樯燕可能留客住，沙鸥只道为诗来。\n剡舟不作兴尽返，见说龙公也自猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和晏司法吴城山道中韵三首 其三","author":"萧立之","text":"蹴天浪入白云层，四野都无一寸青。\n挟万斛行风有力，著千人聚地成形。\n庐峰映日开天绘，石砮沉渊记庙灵。\n欲洗吏尘何日得，摩挲坡句傍危亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]