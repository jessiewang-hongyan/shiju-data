[{"title":"再韵谢张持甫过访二首 其二","author":"刘宰","text":"道自周衰说异同，眼明伊洛振遗风。\n过人高行非难事，入圣微言本大公。\n道在鬼神常共在，术穷天地本无穷。\n三才并处君知否，不尔何裨造化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再韵谢张持甫过访二首 其一","author":"刘宰","text":"瓮牖篝灯一笑同，地炉烧火愧家风。\n论财以义轻浮俗，论道归儒识至公。\n行异于时方易沮，理趋于数要深穷。\n老来狂斐君无诮，他石犹堪付玉工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同叶恭叔郑节卿饮于赵子野官舍","author":"刘宰","text":"相望各千里，相逢酒一壶。\n交情贯金石，诗思渺江湖。\n夜雨滋园菊，秋风落井梧。\n归欤吾有日，聚散一长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次姜君玉韵且贺北固新居 其一","author":"刘宰","text":"车来流水马如龙，北上精蓝西复东。\n雅意只贪山在近，高标谁与子相同。\n门开正好来三益，文就何妨送五穷。\n拟向岩前分半席，可能辟地著邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次姜君玉韵且贺北固新居 其二","author":"刘宰","text":"门外青山跨伏龙，山头未晓日生东。\n竹林已喜王戎近，莲社还堪惠远同。\n盛事正应符地胜，清才岂必坐诗穷。\n欲成善颂陪张老，自笑尊前一秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过兰亭","author":"刘宰","text":"茂林修竹翠参天，一水西为尚折旋。\n欲泛羽觞追往事，怅无嘉客继前贤。\n短章回寄二三友，胜践堪寻八百年。\n笑拂苍崖题姓字，为言曾此掬流泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事有怀二首 其二","author":"刘宰","text":"济世无长策，观诗叹小明。\n悠悠忘夜永，淅淅听秋声。\n困踬盐车骥，飞腾腐草萤。\n乖逢偶然尔，造物两何情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事有怀二首 其一","author":"刘宰","text":"千山收宿霭，一气蔼金行。\n爽吹舒澄碧，晴晖丽太清。\n徘徊望前岭，徙倚步南荣。\n为问莼鲈客，何须身后名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀林维国二首 其二","author":"刘宰","text":"尚记升堂拜母时，满前儿女竞牵衣。\n凤雏想见今成立，雁序遥闻已奋飞。\n身后声名终不朽，家传诗礼足相辉。\n伤心白下金陵道，无复班荆话昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀林维国二首 其一","author":"刘宰","text":"四海论交二十年，知心一见似前缘。\n情亲尚记通宵语，忠告难忘送别篇。\n梦入蓬壶重会面，座看书史尚堆前。\n应怜废学从农圃，要使留心在简编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀徐表兄","author":"刘宰","text":"一笑相逢句曲天，别来十五换流年。\n忍思渭上琼瑰咏，无复通泉宝剑篇。\n北渚春回芳树合，西山日暮碧云连。\n雁来数寄平安信，无限相思若个边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"社日僧舍风雨","author":"刘宰","text":"借蔬香积共晨炊，客里良辰总不知。\n孺子从渠均胙肉，南翁无处听巴词。\n神鸦得志饱终日，巢燕有心来及时。\n风雨聒人聋转甚，半钟浊酒可能治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周侯古祠","author":"刘宰","text":"庙宇巍峨对古坟，将军英气宛如存。\n当时改行除民害，历代封功沐宠恩。\n虎穴云埋山寂寞，蛟溪波冷月黄昏。\n我来吊古追行乐，驻马花前酹一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尤伯华广德使君怡亭对雨 其二","author":"刘宰","text":"轩亭闿爽喜新营，燕雀应来贺厦成。\n樽酒两忘贤与圣，韦编相对弟和兄。\n诗如绣段从头好，人似冰壶彻底清。\n寄语金昆同石友，道逢何日许班荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尤伯华广德使君怡亭对雨 其一","author":"刘宰","text":"之子胸中不外营，轩亭水到自渠成。\n词章妙处窥骚雅，师友平生祇弟兄。\n元凯一门兼众美，夷齐千古擅双清。\n新诗有赠不知报，衰拙如余盍负荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞谢惠河鲀韵二首 其二","author":"刘宰","text":"鼎来佳句仰谦亨，春入池塘草正生。\n清夜拟陪檐雨酌，暮天应对碧云横。\n逍遥庄叟一枝稳，富贵齐人五鼎烹。\n戟卫肃迎挥手去，苏州应愧此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞谢惠河鲀韵二首 其一","author":"刘宰","text":"先生盛德信光亨，微物将诚愧晚生。\n春岸正当馀雨过，寒江尚想小舟横。\n一奁走送惭迟暮，两舍相望欠割烹。\n未必甘芹解知味，王公当谅野人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邑大夫劝驾韵","author":"刘宰","text":"自笑当年跃冶金，老来文物见彬彬。\n登名已喜多三邑，擢秀悬知敌万人。\n晴日琴堂开宴好，春风琼苑拜恩新。\n惟馀卧病江湖客，坐看联翩对玉宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗权丞尊经阁元旦观雪","author":"刘宰","text":"亿万饥民久吁天，天开上瑞岂徒然。\n深潭龟拆寒莎底，浅土蝗遗宿麦边。\n厉气已消除日后，祥霙飞堕晓风前。\n醉吟楼上瀛洲客，为记三登第一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前韵呈李果州","author":"刘宰","text":"行乐非吾事，朋从慰此生。\n剧谈忘夜永，起立缓杯行。\n黄独幽人供，朱弦太古声。\n他年盛山集，不假退之评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵龙图鹿鸣宴韵二首 其二","author":"刘宰","text":"预宴当年记夙兴，笙歌堂上正和鸣。\n别来几送龙门客，去后空题雁塔名。\n麋鹿群中便野性，蜩鸠飞处笑云程。\n羞肴也到茅檐下，磊块堆盘里社荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵龙图鹿鸣宴韵二首 其一","author":"刘宰","text":"劝驾丁宁自汉兴，礼行郡国玉锵鸣。\n使君珍重新开宴，多士连翩喜策名。\n月窟一枝传好信，风帆千里送脩程。\n主宾后会君知否，紫橐青袍对宠荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵章泉见寄二首 其二","author":"刘宰","text":"平生暗里识曹刘，眼底谁为第一流。\n锦里正应推老杜，鲁人亦解说东丘。\n骑驴颇忘推敲否，上马还能矍铄不。\n此去相思君会取，菊黄梅蕊上枝头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵章泉见寄二首 其一","author":"刘宰","text":"先生人物眇应刘，千载诗亡独溯流。\n五字还堪荐郊庙，一官何事老林丘。\n章泉乐处知何似，南涧良朋亦健不。\n欲拜庞公何日是，梦随飞鹤过山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郡倅陈校书祈雨韵","author":"刘宰","text":"麦陇收黄槁，秧田欠绿滋。\n三时犹好在，一雨未为迟。\n精意能先物，神明敢后期。\n邦人孚至意，可但不能欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和柴监","author":"刘宰","text":"之子通才不受拘，妙年文史足三馀。\n司征关市方共二，宴启华堂正乐胥。\n锦帐笙歌香雾绕，禅房风月夜窗虚。\n后生取舍能如此，问信宁非远器欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和真州太守营屋新成之韵三首 其三","author":"刘宰","text":"经始南风咏有虞，落成候筦报秋初。\n连甍尽撤编茅旧，万灶重新列屋居。\n千里只今成保障，一廛谁复等蘧庐。\n何人袖出如椽笔，为写丰功揭里闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和真州太守营屋新成之韵三首 其二","author":"刘宰","text":"东南列将谨防虞，尚记熙宁变法初。\n一自胡雏饮江水，遂令卒伍杂民居。\n炊烟不断云横垒，清夜无哗月满庐。\n妙用独推贤太守，征徭元不到乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和真州太守营屋新成之韵三首 其一","author":"刘宰","text":"长淮清晏久无虞，官舍人烟已复初。\n共喜舆图方日辟，讵应卒伍尚星居。\n四营分创因遗址，百堵周围列聚庐。\n武备既严军气壮，岂专捍禦奠州闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和淮漕八月十四夜月诗二首 其二","author":"刘宰","text":"长淮百谷庆西成，万里何妨共此晴。\n霖雨尚关天下望，月华犹幸晚来明。\n要看玉宇清光满，闻道银河此去平。\n邂逅西风轻借力，夜深桂影更敷荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和淮漕八月十四夜月诗二首 其一","author":"刘宰","text":"清凉景界限尘纷，玉宇从容静夜分。\n欲满尚悭今夜月，乍舒还敛北山云。\n孤光翻动枝头鹊，馀晕潜驱草际蚊。\n好处欲言人不解，湛然天宇印心君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬友人登多景楼见怀","author":"刘宰","text":"云横不断古神州，缥缈河山总戍楼。\n此地几经人北顾，长江不住水东流。\n犬羊万里知离穴，稻蟹三吴正得秋。\n人事天时多错忤，一杯聊复润吟喉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学门肇开为诸兄贺","author":"刘宰","text":"几年黉宇傍城隈，礼乐文章蔽草莱。\n逵道一朝随地辟，宫墙数仞倚天开。\n举头日月清光近，入眼湖山秀气来。\n寄语乡邦头角士，龙门此去会风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉张兄立民作诗","author":"刘宰","text":"翛然风骨一臞仙，误走红尘逐世缘。\n亦欲名同天壤寿，且须句与日星悬。\n后湖废沼生春草，南郭遗墟起暮烟。\n闻道锦囊时有得，故山花鸟亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"毗陵邂逅京口同舍汤叔厚","author":"刘宰","text":"鸡犬相闻里社同，琴书曾共客儒宫。\n南楼夜醉三更月，北固秋吟万里风。\n去鲁羡君勤采藻，游吴愧我尚飘蓬。\n相逢便与论心曲，莫笑依然旧阿蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋闱后勉子侄","author":"刘宰","text":"我生场屋惯周旋，得失从知岂偶然。\n天理先须尽人事，时文端的本尘编。\n日烘瓮牖朝先起，雪压茅斋夜不眠。\n万里夷涂从此去，著鞭宁怕祖生先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈子扬致仕追赠父母二首 其二","author":"刘宰","text":"一笑相逢意自亲，别来庭树几枯荣。\n流传郢客阳春句，想见鸱夷万里情。\n贾傅才能通国体，柳州文字占时名。\n何如一棹洮湖去，独泛沧波弄月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈子扬致仕追赠父母二首 其一","author":"刘宰","text":"一念平生在报亲，九原今日喜追荣。\n鼎来天上维新渥，足慰人间罔极情。\n康乐弟兄传绝唱，胡威父子擅清名。\n君家盛事人难及，倦客闻风亦眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺赵居父登第","author":"刘宰","text":"词场闻夺锦标归，好是斑衣映绿衣。\n永日湖山供赏咏，好风宫殿正清微。\n堂新六桂光宸翰，庭秀双芝焕彩闱。\n肯向长安誇得意，妙年伯玉已知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送卫汝积归句曲","author":"刘宰","text":"楼冈亭谷万山西，缥缈炊烟出翠微。\n归路正当清昼永，离怀莫怅白云飞。\n学医要使人无费，问道须知昨已非。\n好向庭闱商略此，短章中或有玄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人","author":"刘宰","text":"年来去客半西东，须信劳生等转蓬。\n万里相望成别恨，一声何处递冥鸿。\n人情对景分忧乐，月色于今岂异同。\n莫把壮怀成索寞，举杯聊与吸清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人入京","author":"刘宰","text":"郭内无田负郭居，酒中有趣酒尊疏。\n波间屡听濯缨曲，架上时翻种树书。\n万里长风摧岸柳，一天清露属园蔬。\n故人欲问平安信，为说年来颇晏如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人赴省试","author":"刘宰","text":"月满千门夜未央，忆陪多士凑文场。\n露将寒透银袍冷，兴与秋来笔力刚。\n十载转头成昨梦，一身为客尚他乡。\n为言桂苑联镳客，要折高枝压众芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王去非入饷幕","author":"刘宰","text":"春归花药尚红酣，送子脂车马在骖。\n幕画向来多实用，事机今可付常谈。\n学方用力须千百，事或当仁勿二三。\n别后欲知渔钓处，五湖天水共澄涵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送平江赵法曹","author":"刘宰","text":"金科天上耿星辰，丹笔年来有屈伸。\n子去平反供母笑，民知宽大颂君仁。\n祇今茂苑题舆客，曾是琼林合席人。\n若问残生烦寄语，扁舟长占五湖春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张晋望倅湖州","author":"刘宰","text":"风月平分古治中，挂帆直指水晶宫。\n祇今第宅多亲贵，自昔闾阎有阨穷。\n勿用弥缝乖直道，毋烦歌舞竞新功。\n举头见日长安近，诏入元非藉子公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张端袤主含山簿","author":"刘宰","text":"计利无非利，辞难枉作难。\n驱车平路去，高枕此心安。\n县小勾稽易，时危赋敛殚。\n好裨千虑失，可使百忧宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张端袤赴潘葑","author":"刘宰","text":"汲取人间第二泉，酿成天上酌神仙。\n渠侬得此良佳矣，我辈为之或未然。\n职守近来成漫浪，湖山佳处且回旋。\n向阳花木逢春易，会取声名动日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张端袤摄簿建平","author":"刘宰","text":"吏道贵更事，君行非为贫。\n勾稽戾初意，疾痛系斯民。\n一日居须葺，他年政若神。\n放船秋水阔，著眼看修鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张端衡尉句容二首 其二","author":"刘宰","text":"去乡喜见似乡人，君去家山祇比邻。\n令长垂髫同里社，交承握手记城闉。\n弦歌堂上宁忘旧，樽俎筵中必告新。\n若也从容问无恙，为言鱼鸟已情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张端衡尉句容二首 其一","author":"刘宰","text":"梅仙西上古仙乡，梅蕊先春特地香。\n自是邾人闻鲁柝，悬知晋盗避秦疆。\n名山久合清芜秽，穷巷犹闻缺盖藏。\n惠政由来要全美，须君努力佐琴堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邵监酒兼柬仪真赵法曹呈潘使君二首 其二","author":"刘宰","text":"十万流离仰二天，淮民只说使君贤。\n向来积贮知无有，此去规模要有传。\n幼学可能传榷酤，远猷无惜助筹边。\n公馀更向髯参问，今赋梅花第几篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邵监酒兼柬仪真赵法曹呈潘使君二首 其一","author":"刘宰","text":"仪真来往几经秋，风物淮南第一州。\n山势北来开壮观，大江东下峙危楼。\n沙头缥缈千家市，舻尾连翩万斛舟。\n去去烦君问耆老，几人犹得守林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送姜君玉赴省试","author":"刘宰","text":"樽酒论文弱冠前，交情老去只依然。\n久荒三径无来客，细拨青灯话昔年。\n少日功名谁汗简，旧游江海半华颠。\n君行试问都门柳，几送银袍上九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送彦与孙兄赴廷对","author":"刘宰","text":"捷书夜到古朱方，之子登名甲乙行。\n伟行向来高月旦，遗经端合破天荒。\n公孙对策风云会，董子留名日月光。\n趋向一分燕越异，赠言惟有用心刚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钟元达赴馀杭","author":"刘宰","text":"知音十九在岩廊，姓字高悬日月旁。\n视草祇今虚省署，种花聊复向河阳。\n困穷已甚情当察，富贵徐来味更长。\n梵宇仙宫最佳处，诗成数寄水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_