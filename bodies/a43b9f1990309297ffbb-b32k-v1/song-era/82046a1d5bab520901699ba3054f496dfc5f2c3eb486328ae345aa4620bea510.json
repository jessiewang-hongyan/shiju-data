[{"title":"咏史二首 其一","author":"周弼","text":"一曲呼凰下九霄，石台春静海山遥。\n周秦战血纵横尽，犹卧白云吹洞箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜深","author":"周弼","text":"虚堂人静不闻更，独坐书灰对夜灯。\n门外不知春雪霁，半峰残月一溪冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青阳驿","author":"周弼","text":"悄悄如秋麦气凉，山风吹透湿衣裳。\n小炉深幌枯松火，一夜寒香绕客床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客楼","author":"周弼","text":"水国秋清潮半生，越王台殿锁荒城。\n西楼一夜思归客，斜倚朱栏独听笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归 其三","author":"周弼","text":"尽日凭栏客兴浓，山虽西绕水还东。\n便乘春暮家园去，犹及棠梨满径风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归 其一","author":"周弼","text":"闹里看山不识真，偶来轩槛振衣尘。\n诸峰便觉移相就，分付春风欲去人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归 其二","author":"周弼","text":"点点杨花飞满洲，只应催促送行舟。\n非关向晚伤心事，自怯春寒不肯留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归 其四","author":"周弼","text":"自觉才疏久愿归，敢将山色便相依。\n汉家事业虽全盛，亦放梁鸿一个飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春怨","author":"周弼","text":"极浦蘋花白，空壕兰萼红。\n伤心城上燕，飞入馆娃宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"显应观桃花","author":"周弼","text":"白云随鹤乘将去，深碧桃花满故宫。\n三十六簧明月夜，不知何处吸春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日马上","author":"周弼","text":"本无谋略强谈兵，每愧临边病未能。\n筋力岂知犹可喜，一鞍千里到江陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"周弼","text":"山门半掩浮云阙，古道人稀芳草歇。\n夜深零露滴秋香，幽人独步青萝月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胥门","author":"周弼","text":"芦苇萧萧生晚潮，伍员何地更吹箫。\n夕阳自逐寒鸦去，万片宫花共寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之汉上","author":"周弼","text":"旧来边塞自多尘，瘦草寒花强作春。\n见说连年更悽怆，乱萤随趁鬼迷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人还姑苏","author":"周弼","text":"别十三年返故居，可怜世业半空虚。\n布囊惟有焦琴在，乞与秋风葬阖闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游西山 其一","author":"周弼","text":"昔人深夜看星斗，镇压灵坛尚有符。\n偷写只应苍鼠惯，几行丹篆绕春芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游西山 其三","author":"周弼","text":"抽铅点汞旧台荒，何处搜寻旧草堂。\n谁见洪崖最深处，一坑泥护石中黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游西山 其二","author":"周弼","text":"锁断寒蛟亦有神，冷波寒水病残身。\n谁收匙钥权相借，略放天池洗白鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客","author":"周弼","text":"欲知行远近，细数杜鹃声。\n暗入苍山去，千闻是一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻友人过吴","author":"周弼","text":"诗囊挂在船篷上，吟过江枫落叶中。\n为恐吴笺题不尽，秋风先燥数堆红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟中梅","author":"周弼","text":"冷花疏蕊竹间横，浅薄笼烟淡作晴。\n怊怅野桥春水断，几回相见不分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真娘墓","author":"周弼","text":"青鸟传书渡海迟，乱山衰草葬蛾眉。\n锦囊消歇馀香在，狼藉春风豆蔻枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逢僧文礼 其一","author":"周弼","text":"空山落日又逢僧，雨杂尘灰满帽纹。\n但忆来时门不掩，麝香偷卧石床云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄云泉僧永颐 其二","author":"周弼","text":"颂罢南华谁得闻，两川寒玉一禅身。\n松边弹舌低声念，莫引龙来变作人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄云泉僧永颐 其一","author":"周弼","text":"书来只说住高峰，不记松林第几重。\n欲拣青峦问茅舍，秋山一样白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彩云桥","author":"周弼","text":"断桥流水两无期，残日轻云处处疑。\n乞与行人自沽酒，满旗风雨豆花篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望太湖 其二","author":"周弼","text":"眼力难穷远即昏，纵晴惟只两三分。\n今朝林屋人皆见，不似峰峦只似云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望太湖 其一","author":"周弼","text":"独立瀰漫灏气中，倍饶云雾杳重重。\n直西一道孤光起，指点人看是白龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧山县下遇雨二首 其二","author":"周弼","text":"悠悠心厌出江沙，过得丘亭转落斜。\n村店自知行客倦，劝尝新酒卖甜瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧山县下遇雨二首 其一","author":"周弼","text":"年来沙涨卒难消，更觉西兴渡口遥。\n冷坐看他骑骒马，半鞍泥水踏春潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野庙","author":"周弼","text":"野庙荒芜倒掩扉，寂寥香火客来稀。\n年年归燕相看觑，空滴春泥损画衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溧阳桃花","author":"周弼","text":"见说谪仙曾到此，东风千树锁雕墙。\n游人偏向花间酹，雨湿春泥喷酒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅","author":"周弼","text":"爱花偏倩猎人寻，残雪偷春上棘林。\n山岸有谁先得见，冷香疏亚辟寒金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题僧子温画水墨蒲萄","author":"周弼","text":"袅袅多应半熟时，落斜高挂冷攒枝。\n分明记得山窗下，一架寒藤带雨垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别水云翁","author":"周弼","text":"离离双鬓似秋蓬，惯逐沙鸥与断鸿。\n漂母矶头春水阔，扁舟何处系东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠野逸 其一","author":"周弼","text":"时康难售贾生医，谏鼓无声对落晖。\n又报一年花信了，满山鶗鴂送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠野逸 其二","author":"周弼","text":"悠悠行路雪侵头，拟出重关洗弊裘。\n堤上忽逢憔悴客，背花停酒说通州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七里濑","author":"周弼","text":"瞬息沿流七里遥，感时回缆木兰桡。\n高台未变陵兼谷，故国频更市与朝。\n风散乱云通去驿，雨消残雪助归潮。\n渔翁近亦无前辈，一个青铜不肯饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久客思归感兴","author":"周弼","text":"久客空江上，閒吟对石门。\n青山非远近，流水自朝昏。\n夜月添乡梦，春风入烧痕。\n翻思南郭路，迢递隔烟村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千金寺","author":"周弼","text":"十载他乡别，春归逐浪层。\n晚晴沙市鼓，夜雨石桥灯。\n帆仄摧乾苇，衣寒脆薄缯。\n旧时来往寺，惆怅不逢僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"周弼","text":"尽日群山里，知行第几重。\n竹深春寺磬，滩急午溪舂。\n残旭犹双塔，晴云只半峰。\n岂无仙隐者，恨不少从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居春晚","author":"周弼","text":"索居牢落动关心，但觉匆匆岁月侵。\n无梦不因怜昼静，有怀多是惜春深。\n草香稚蝶销胡粉，花落蛮莺变楚金。\n最是不禁芳树色，能消几日又成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马要寺","author":"周弼","text":"水国何年寺，萧条野渡边。\n僧驱田雀倦，神抱海犀眠。\n细网垂秋屋，残灯泊暝船。\n数家枯柳下，犹有旧人烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中和节","author":"周弼","text":"时节匆忙过隙驹，可堪岑寂就船居。\n不禁衰病慵耽酒，无益闲交懒报书。\n风暖暮田归海燕，雨甜春水上潮鱼。\n客中自是光阴速，才见新正又月初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为僧昙芳赋草堂","author":"周弼","text":"把诗从我者，多是剡中僧。\n结屋何山坞，当门几树藤。\n地寒常带雪，溪峻不留冰。\n赠尔新吟去，归题木叶层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌衣巷","author":"周弼","text":"日落凭栏感慨频，长干桥畔冷残春。\n桑田芜没徒多事，兰玉丛生更几人。\n风暖影翻花外燕，雨多痕蚀草间麟。\n堪嗟群从成功后，不及钟山一尉神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"周弼","text":"一径逶迤草自芳，何为不复更翱翔。\n应须旧国还宣武，别有高台在建章。\n白鹭背花寻塔路，赤乌冲柳集宫墙。\n中兴不比偏安事，且对梧桐荐羽觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双林寺","author":"周弼","text":"杳杳双林路，林深不易登。\n寺幽怜宿鸟，地僻喜闲僧。\n静彻垂梁板，寒销背壁灯。\n水边人忽笑，猿落过溪藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚栏","author":"李龏","text":"袅袅朱栏倚细波，绿云相对閟嵯峨。\n中天车驾曾擒寇，何日楼船定入河。\n霁柳午阴随岸远，露桃春色过墙多。\n黄旗适应东南运，已办箫铙几曲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天章寺前小楼","author":"周弼","text":"客怀依古寺，曲水茂林边。\n俯听涧鸣石，静看山出烟。\n傍花清晚漱，对竹冷春眠。\n深羡溪僧乐，幽居动岁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲申岁解官归故居有以书相问者","author":"周弼","text":"近凭筇竹杖，处处作生涯。\n独采傍溪药，自看临水花。\n爱云因北望，对日任西斜。\n惟有双蝴蝶，相随直到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白羊","author":"周弼","text":"路隔一重溪，山深客易危。\n驿亭惟有额，官堠尽无碑。\n竹挂黄身虺，林香白面狸。\n得船争欲渡，先奔槿花篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石头城","author":"周弼","text":"点点凝烟望未收，六朝遗迹遍荒丘。\n自从绛阙雄江面，谁把朱泥染石头。\n岗断晓榛双阜虎，岸长春草一滩鸥。\n诸公多少新亭恨，不是知心莫上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石塘","author":"周弼","text":"水陆尽经过，地暄晴更和。\n鸟声临水近，人影向桥多。\n细雪倾残橘，轻冰脆立荷。\n少为盐米计，听彻竹枝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会稽山","author":"周弼","text":"衣冠从昔化文身，峻岳当天自有神。\n秦帝刻碑三十载，越王栖甲五千人。\n江连云气分南纪，海接星河近北辰。\n必竟兴亡谁可料，但闻陵谷变飞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冰清堂偶成","author":"周弼","text":"数杯恬淡酒，相就等闲倾。\n得失徒多感，行藏任独清。\n昼闲风有味，春尽雨无声。\n但惜新栽柳，相呼欠一莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同李雪林饮山村","author":"周弼","text":"本来无饮兴，偶此到溪滩。\n屋角悬双瓠，船头系一竿。\n塔高风便响，桥峻雨随乾。\n莫怕城门闭，行归亦不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙伯符墓下","author":"周弼","text":"梧叶萧萧墓草长，梦魂曾断九回肠。\n空闻绛帕离章水，谁见黄旗入洛阳。\n鸦噪暮园江阪迥，龙盘春戍石城荒。\n赤乌不识桑田变，犹自悽悽守白杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙季蕃故居","author":"周弼","text":"笑语失诙谐，人谁不怆怀。\n梦残秋雨寺，魂散夕阳街。\n缺灶粘煎药，乾炉积燎柴。\n风流何必葬，便拥菊花埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱潭","author":"周弼","text":"消散羁愁益坦然，况当初暖欲晴天。\n清溪苔滑重抄纸，浅屋柴香正煮绵。\n隔水杀鸡祠社土，过桥嘶马入人烟。\n今朝似觉难忘酒，应更无人笑谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江皋送别","author":"周弼","text":"把酒对汀洲，相看发去舟。\n迎风一分手，惊浪几翻头。\n烛暗花消泪，枫寒叶弄愁。\n恐犹回首望，终夕凭高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行吟","author":"周弼","text":"独行沙岸不相携，准拟沿溪更渡溪。\n药蔓交加虫上下，柳花撩乱蝶高低。\n杖头晓伴春云石，屐齿晴翻夜雨泥。\n诗就随山为人写，等闲抽尽锦中题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖竹阁寺","author":"周弼","text":"精舍萧疏近水凉，分明一径绿沉枪。\n就移山近湖皆隐，放出楼高寺倒藏。\n春透露梢齐曲槛，晓翻风箨过脩墙。\n长堤花尽人稀少，来听蝉声伴夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访别","author":"周弼","text":"圣代吟家众，无君众体诗。\n数奇官职见，心苦道途知。\n积梦难相寄，流年自各悲。\n金闺催制锦，又复向黄陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐安早眺 其二","author":"周弼","text":"阴阴城垒静，极望不飞尘。\n草色横江暮，莺声出塞春。\n清时应洗甲，来岁又逢辛。\n惆怅经过处，都非往昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐安早眺 其一","author":"周弼","text":"昔日干戈地，凄凉古塞情。\n军同民杂戍，州与县分城。\n野旷孤鸿绝，沙寒一骑行。\n十年生息后，人尚怯论兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵钓台","author":"周弼","text":"晴江万里绿波来，惆怅君房去不回。\n秦苑河山归故国，越乡云雨庇荒台。\n春风一道江蓠绿，落日千峰杜宇哀。\n欲访钓船无处所，野花如雪满汀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴山仁王寺","author":"周弼","text":"山寺凭高夕未昏，上皇曾此定乾坤。\n瓯闽散驿缘江岛，龛赭收潮入海门。\n细雨乱花唐辇道，淡烟疏柳汉营屯。\n何时汴水东流畔，君返宸居臣故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应潭","author":"周弼","text":"村崦递相遮，分居两岸沙。\n地征兼橘柚，土物半桑麻。\n水白来如虹，山黄去若蛇。\n往年曾泊此，丛竹数人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村市","author":"周弼","text":"细簇人家住，中分破石崖。\n竹门开店屋，草市夹桥街。\n水别东流汉，山横北过淮。\n并船频借问，同买出江柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵竺寺","author":"周弼","text":"不因纯孝者，古寺若为安。\n壁彩蜗游遍，炉香鼠踏残。\n钟声嘶破梃，幡影飐危竿。\n尚恐冬生笋，时来竹外看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甫里观","author":"周弼","text":"天随清调何人继，幸有荒村故宅存。\n橘上蠹虫应屡变，草间眠鸭尚能言。\n池亭暮雪兼风起，篱落春潮带雨浑。\n人啖菊苗终竟别，屠沽犹自不登门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀野","author":"周弼","text":"小作幽园傍宅开，只须数亩占楼台。\n石移林屋秋云至，水带松江暮雨来。\n径草散香迎过屐，砌花分影荫流杯。\n人家园圃应无数，不似君能日几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连珠","author":"周弼","text":"远望披裘日几回，可堪江上暮寒催。\n云飞旷野迎风断，雪洒长滩夹雨来。\n马踏野桥嘶破板，鸟迷村路立高桅。\n暂须移向疏篱泊，迁就惊春一树梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]