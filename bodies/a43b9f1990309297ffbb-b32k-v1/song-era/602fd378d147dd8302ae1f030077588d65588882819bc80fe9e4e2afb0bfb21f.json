[{"title":"燕","author":"赵时韶","text":"穷檐稳稳好巢成，莫向朱门附丽人。\n青杏屋梁虽好看，笙歌未必可安身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古杭道中","author":"赵时韶","text":"离家才是两三程，便觉征衣缀软尘。\n湖海相逢迂阔好，江山不厌往来频。\n溪鱼有孕羹偏美，村酒无灰味却真。\n纡辔小儿莫相笑，柴桑终不负头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居书怀","author":"赵时韶","text":"檐溜垂垂箸未收，一年乐事负春游。\n新添华发羞开镜，贪看青山懒下楼。\n天地至今多罔象，功名到底总蚍蜉。\n祇因知得清闲好，事大如山付醉休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居感怀和屏山韵","author":"赵时韶","text":"还我山林且买邻，荆榛不碍自由身。\n梅兄竹弟相依旧，李婢桃奴一任新。\n湖海到今无剑客，江山如作老诗人。\n不知尚父缘何事，白首投竿起渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮山用平叔韵","author":"赵时韶","text":"抖擞襟尘访梵宫，入门物色补陀踪。\n松虽未老曾留鹤，山不在高堪卧龙。\n案上楞岩寻旧跋，枕边纸被认新缝。\n客题不要纱笼壁，遮莫轻敲饭后钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贽管竹楼 其一","author":"赵时韶","text":"天生贤佐福闽州，衮舄荧煌尚黑头。\n司马公留民可活，管夷吾在世何忧。\n东南人物几华屋，今古乾坤一竹楼。\n三万卷书三尺剑，男儿事业要伊周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"縠波","author":"赵时韶","text":"鲛人机轴巧，织出水晶宫。\n浣濯有新雨，卷舒无定风。\n晴岚轻染绿，斜日半浇红。\n渔父无端甚，轻舠截个中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其七","author":"赵时韶","text":"精神淡伫霜犹薄，肤貌参差雪未温。\n试向南枝看春色，夜来才着两三分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其二","author":"赵时韶","text":"为有清癯骨相寒，月明时候正相关。\n本来面貌无尘俗，更向冰池自照看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不须檀板与金樽","author":"赵时韶","text":"醒来拍手倚雕栏，啜茗哦诗子细看。\n纵有浅斟低唱者，个中清意不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文中子","author":"赵时韶","text":"一脉斯文系大儒，干戈满地独诗书。\n南风有操无人识，身在汾亭心在虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木鱼用韵","author":"赵时韶","text":"香积厨边想像中，俨然摇鬣出吴松。\n不随红蓼滩头钓，常逐阇梨饭后钟。\n尘土几年成涸鲋，风波平地欲成龙。\n若教占作维祥梦，忧国书生亦愿丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永阳道中","author":"赵时韶","text":"十年前此地，书剑记曾来。\n士说红鹰爪，农誇白芋魁。\n溪浑鱼放子，林动雉惊媒。\n评品全人少，山坡独有梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扫苔有感","author":"赵时韶","text":"阶前叠叠碧成团，微雨新来洗几番。\n猛省呼童都扫却，怕人地上作钱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹夫人","author":"赵时韶","text":"玉骨冰肌夏月凉，更无人妒得专房。\n醉翁爱作身边伴，只恐西风又隔床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问梅","author":"赵时韶","text":"溪南千树雪纷纷，桥北才开一两分。\n汝是山林高洁者，如何到此也寒温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余出留远曾先生门墙因侍留耕先生座间出示有怀楼居仓使救荒之诗僭越用韵","author":"赵时韶","text":"乾坤秀气孕三奇，勋叶人间有口碑。\n台近棠阴遗泽在，楼辉秋萼起人思。\n后先玉季金昆政，多少丹山碧水诗。\n世事荡来尚胶轕，赖君一手理纷丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贽管竹楼 其二","author":"赵时韶","text":"我公自是活神明，皦日当空鬼魅惊。\n参辈虽多萧相少，蹠徒自浊伯夷清。\n吴儿久借乾坤造，闽囝重逢父母生。\n剩说谦尊能下士，青门还念种瓜平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祈雨感应琴斋檐溜忽得双鱼","author":"赵时韶","text":"檐流非沼亦非池，跃出双鱼亦自奇。\n不是悬于庭上落，便因生出釜中来。\n听琴莫笑音非古，叶梦须知稔可期。\n谩说佩金佳谶在，陶腰似觉未消伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜂","author":"赵时韶","text":"蜜成只解供樽俎，蜡就徒能照绮罗。\n堪叹汝生无受用，钻钻刺刺欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜禽欲下先偷眼","author":"赵时韶","text":"翠羽啁嘈逐晓风，海仙时遣探芳丛。\n徘徊睥睨知何意，怕干时人挟弹弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻梅","author":"赵时韶","text":"春在溪桥第几家，槎牙老树竹篱遮。\n再三辨认枝头雪，万一无香恐未花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落梅","author":"赵时韶","text":"鹿胎点点上轻裘，脑片飘飘入宝篝。\n更向佳人妆额看，梅花到底也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西禅饯董溪翁","author":"赵时儋","text":"西浦风寒水自流，迢迢行李又归休。\n今宵古寺吟边酒，明日长江客里舟。\n溪路梅花催雪兴，旗亭竹色伴云愁。\n还家更为明时出，莫向渔矶老钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵纲立","text":"水际疑逢陆文学，草间恐有斗于菟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"赵良玉","text":"红杏香中，绿杨影里，画桥春水泠泠。\n深沉院满，风送卖花声。\n又是清明近也，粉墙畔，时有迁莺。\n当此际，人传天上，特降玉麒麟。\n风云。\n今会遇，名邦坐抚，入侍严宸。\n更儿孙兰玉，都是宁馨。\n脆管繁弦竞奏，蕙炉袅，沉水烟轻。\n华筵罢，江城回首，一点寿星明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松风亭","author":"赵良生","text":"七树怀郑薰，千尺羡晋峤。\n弘景招不来，俯仰但长啸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙法庵二首 其一","author":"赵良佐","text":"乘兴来游古道场，远村落日卧牛羊。\n暂能摆脱尘埃念，瓦鼎烟消柏子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙法庵二首 其二","author":"赵良佐","text":"蔓藤扶我过东冈，与客同登妙法堂。\n小院回廊春已暮，茂林修竹夏初长。\n归欤未办买山计，健甚无庸却老方。\n都市山林总无累，此生此世底须忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏杨司业观菊图","author":"赵良坡","text":"寄傲南窗罢草玄，寥寥三径菊花前。\n春风自足繁桃李，为爱秋香到晚妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑山亭","author":"赵良坡","text":"茂林深处散清凉，石罅泉声引兴长。\n高挂角巾舒啸傲，炎飙那得到山庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐居","author":"赵良坡","text":"习静深山里，幽栖趣偪真。\n青楼何足契，白雪故相亲。\n守道无妨困，藏书不圣贫。\n昔人嘉遁汉，我亦爱逃秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过叔祖崇栲翁别业","author":"赵良坡","text":"别业开东野，萧然足卧云。\n涛声晴射雨，庭影夏呈秋。\n返照霞初幕，遥峰翠欲流。\n以斯清乐境，不信有瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪水庵咏雪二十韵","author":"赵良坡","text":"玄冥司号令，屏翳驱云车。\n巧舞穿幽隙，轻扬下曲洼。\n初疑蚕食叶，犹恐蟹行沙。\n铅汞三千界，璚瑶百万家。\n楼台银作砌，城阙玉为衙。\n压竹枝翻重，封梅色更佳。\n文光偏得月，点缀易为花。\n万瓦鱼鳞矗，千山鸟迹遐。\n凝檐珠错落，布地粉交加。\n恍若水晶溜，犹然宝鉴华。\n馀晖翻鹤羽，皓彩扑乌纱。\n镂刻非因巧，陶镕未有瑕。\n冰奁缘沼合，缟带逐车斜。\n圜石银盘叠，尖峰玉笋芽。\n豪家争玩赏，洞府亦諠哗。\n锦帐传卮酒，竹炉沸鼎茶。\n丰年先有兆，清气浩无涯。\n飞絮那能拟，凭虚最可誇。\n不须东郭履，自是剡溪艖。\n恭喜瞻三白，停杯看六葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠友之闽","author":"赵良坡","text":"世人作离别，惟别酒一觞。\n今我与君别，稍稍鄙玕琅。\n闽海古名地，幕职不可量。\n圣明广延揽，计日下褒章。\n愿将此言赠，用以代琼浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狱中附家二首 其二","author":"赵良坦","text":"一著南冠二载馀，安危不必问何如。\n精金百鍊钢还锐，劲竹三冬节不枯。\n对月欲同鹃带血，临风会有雁传书。\n瓦杯冷落孤灯里，几度吞声祇自吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狱中附家二首 其一","author":"赵良坦","text":"不才离别已多时，脉脉关河入梦思。\n万种閒情诗易遣，一腔愁绪酒难移。\n风迥过雁乡书断，月满圜扉夜漏迟。\n臣子立身忠与孝，此心期不愧丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与永嘉僚友饯别","author":"赵良坦","text":"霏霏细雨湿溪桥，雨霁溪清野趣饶。\n把臂忽惊分袂早，登程不惮去途遥。\n马嘶烟树和愁惨，帆挂仙舟类羽飘。\n不尽尊间贤圣酒，何时重对此酕醄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在北题壁","author":"赵佶","text":"彻夜西风撼破扉，萧条孤馆一灯微。\n家山回首三千里，目断天南无雁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴山亭 北行见杏花","author":"赵佶","text":"裁剪冰绡，轻叠数重，淡着燕脂匀注。\n新样靓妆，艳溢香融，羞杀蕊珠宫女。\n易得凋零，更多少、无情风雨。\n愁苦，问院落凄凉，几番春暮？\n凭寄离恨重重，者双燕何曾，会人言语？\n天遥地远，万水千山，知他故宫何处？\n怎不思量？\n除梦里有时曾去。\n无据，和梦也新来不做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山","author":"赵佶","text":"罗绮生香娇上春。\n金莲开陆海，艳都城。\n宝舆回望翠峰青。\n东风鼓，吹下半天星。\n万井贺升平。\n行歌花满路，月随人。\n龙楼一点玉灯明。\n箫韶远，高宴在蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月上海棠","author":"赵佶","text":"孟婆且与我、做些方便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"赵佶","text":"卷起珠帘。\n看是谁家妃子，收拾金奁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"声声慢 其一 春","author":"赵佶","text":"宫梅粉淡，岸柳金匀，皇州乍庆春回。\n凤阙端门，棚山彩建蓬莱。\n沈沈洞天向晚，宝舆还、花满钧台。\n轻烟里，算谁将金莲，陆地齐开。\n触处声歌鼎沸，香鞯趁，雕轮隐隐轻雷。\n万家帘幕，千步锦绣相挨。\n银蟾皓月如昼，共乘欢、争忍归来。\n疏钟断，听行歌、犹在禁街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"声声慢 其二 梅","author":"赵佶","text":"欺寒冲暖，占早争春，江梅已破南枝。\n向晚阴凝，偏宜映月临池。\n天然莹肌秀骨，笑等闲、桃李芳菲。\n劳梦想，似玉人羞懒，弄粉妆迟。\n长记行歌声断，犹堪恨，无情塞管频吹。\n寄远丁宁，折赠陇首相思。\n前村夜来雪里，殢东君、须索饶伊。\n烂漫也，算百花、犹自未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 御制","author":"赵佶","text":"雅怀素态，向闲中、天与风流标格。\n绿锁窗前湘簟展，终日风清人寂。\n玉子声乾，纹楸色净，星点连还直。\n跳丸日月，算应局上销得。\n全似落浦斜晖，寒鸦游鹭，乱点沙汀碛。\n妙算神机，须信道，国手都无勍敌。\n玳席欢馀，芸堂香暖，赢取专良夕。\n桃源归路，烂柯应笑凡客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金莲绕凤楼","author":"赵佶","text":"绛烛朱笼相随映。\n驰绣毂、尘清香衬。\n万金光射龙轩莹。\n绕端门、瑞雷轻振。\n元宵为开圣景。\n严敷坐、观灯锡庆。\n帝家华英乘春兴。\n搴珠帘、望尧瞻舜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 宣和乙巳冬幸亳州途次","author":"赵佶","text":"过水穿山前去也，吟诗约句千馀。\n淮波寒重雨疏疏。\n烟笼滩上鹭，人买就船鱼。\n古寺幽房权且住，夜深宿在僧居。\n梦魂惊起转嗟吁。\n愁牵心上虑，和泪写回书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令","author":"赵佶","text":"帘旌微动，峭寒天气，龙池冰泮。\n杏花笑吐香犹浅。\n又还是、春将半。\n清歌妙舞从头按。\n等芳时开宴。\n记去年、对著东风，曾许不负莺花愿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚","author":"赵佶","text":"玉京曾忆旧繁华。\n万里帝王家。\n琼林玉殿，朝喧弦管，暮列笙琶。\n花城人去今萧索，春梦绕胡沙。\n家山何处，忍听羌笛，吹彻梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"聒龙谣","author":"赵佶","text":"紫阙苕峣，绀宇邃深，望极绛河清浅。\n霜月流天，锁穹隆光满。\n水精宫、金锁龙盘，玳瑁帘、玉钩云卷。\n动深思，秋籁萧萧，比人世、倍清燕。\n瑶阶迥。\n玉签鸣，渐秘省引水，辘轳声转。\n鸡人唱晓，促铜壶银箭。\n拂晨光、宫柳烟微，荡瑞色、御炉香散。\n从宸游，前后争趋，向金銮殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"赵佶","text":"寰宇清夷，元宵游豫，为开临御端门。\n暖风摇曳，香气霭轻氛。\n十万钩陈灿锦，钧台外、罗绮缤纷。\n欢声里，烛龙衔耀，黼藻太平春。\n灵鳌，擎采岫，冰轮远驾，初上祥云。\n照万宇嬉游，一视同仁。\n更起维垣大第，通宵宴、调燮良臣。\n从兹庆，都俞赓载，千岁乐昌辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄 预赏景龙门追悼明节皇后","author":"赵佶","text":"无言哽噎。\n看灯记得年时节。\n行行指月行行说。\n愿月常圆，休要暂时缺。\n今年华市灯罗列。\n好灯争奈人心别。\n人前不敢分明说。\n不忍抬头，羞见旧时月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九里松马上作","author":"赵孟坚","text":"九里松株不断青，松风上发下泉声。\n耳边为爱闻天籁，故约游缰缓缓行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天平方丈梅下见持要旧题","author":"赵孟坚","text":"枯梅一树半斜攲，绕匝行行欲咏诗。\n忽觌季难遗墨在，西风吹泪满髯丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"买砚碑 其二","author":"赵孟坚","text":"恰在贳金醉砚直，又逢古洛蔡公碑。\n摩挲不忍教他去，笑杀典衣偿直时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"买砚碑 其一","author":"赵孟坚","text":"凤城凉雨新秋后，几处朱楼试管弦。\n有客贳金收古歙，短檠竟夕自摩研。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问梅寄贾秋壑先生","author":"赵孟坚","text":"生成欲见化工功，不在漫山桃李中。\n为向梅梢问消长，地寒先却得春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折枝","author":"赵孟坚","text":"奚囊金勒逗春行，醉咏归来陇月生。\n折得生香浑懒向，断簪零珥任纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"经过","author":"赵孟坚","text":"二十年前漫浪游，海天霜气夜深浮。\n竹窗梦断闻鸡处，常忆溪湾坞聚头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安客中","author":"赵孟坚","text":"小楼面面著疏棂，静有蟾光绝市声。\n读罢离骚临晋帖，菊花香里数寒更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南林张园","author":"赵孟坚","text":"凄凄寒菊委霜丛，下有微吟腐叶蛩。\n倚著栏干听不了，自来我辈最情钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中思家 其三","author":"赵孟坚","text":"柳絮悠悠拂面轻，随风到处若为情。\n西池应也无人到，一面青青萍自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中思家 其二","author":"赵孟坚","text":"楚楚轻衫剪薄纱，而今忆得在山家。\n萧娘为是亲蚕事，嗔带含香紫笑花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中思家 其一","author":"赵孟坚","text":"微风过处有清香，知是荼蘼隔短墙。\n相得故园成索寞，诗盟谁复为平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种石菖蒲","author":"赵孟坚","text":"少年眼力健观书，卷里千言一览无。\n官事簿书昏惘惘，效尤石上种菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客","author":"赵孟坚","text":"素娥懒驾水晶轮，此夕飞来夜欲分。\n送客出门还独立，一天清露湛无云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高渭南席上烛照牡丹 其一","author":"赵孟坚","text":"高烧烛照御黄衣，疑是沈香夜宴归。\n固是不教花睡著，只愁惊起露蝉飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]