[{"title":"感兴二首 其二","author":"陆游","text":"高帝王蜀汉，天下岂易图。\n幡然用其锋，项羽不支梧。\n嗟余昔从戎，久戍南郑墟。\n登高望夕烽，只尺咸阳都。\n群胡本无政，剽夺常自如。\n民穷诉苍天，日夜思来苏。\n连年况枯旱，关辅尤空虚。\n安得节制帅，弓刀肃驰驱。\n父老上牛酒，善意不可孤。\n诸将能办此，机会无时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼坐","author":"陆游","text":"早春风雨暗江干，羔酒狐裘不敌寒。\n输与蒲龛深袖手，一炉真火养金丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼卧闻百舌","author":"陆游","text":"雨后郊原已遍犁，阴阴帘幕燕分泥。\n闲眠不作华胥计，说与春乌自在啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼卧闻碾茶","author":"陆游","text":"小醉初消日未晡，幽窗催破紫云腴。\n玉川七盌何须尔，铜碾声中睡已无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼眠","author":"陆游","text":"困睫瞢腾老孝先，粗毡布被早霜天。\n珥貂碧落应无分，且向人间作睡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼寝二首 其二","author":"陆游","text":"困睫芒羊一欠伸，颓然忽已堕纱巾。\n鼻端雷动君无怪，路熟华胥不问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼寝二首 其一","author":"陆游","text":"倦腕擎书忽堕前，心清无梦腹便便。\n丹成未要排云去，且住人间作睡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼寝梦一客相过若有旧者夷粹可爱既觉作绝句记之","author":"陆游","text":"梦中何许得嘉宾，对影胡床岸幅巾。\n石鼎烹茶火煨栗，主人坦率客情真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枯菊二首 其一","author":"陆游","text":"翠羽金钱梦已阑，空馀残蕊抱枝乾。\n纷纷轻薄随流水，黄与姚花一样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枯菊","author":"陆游","text":"龙山落帽未多时，陈迹依然使我悲。\n粲粲菊花何似好，阶前惟见束枯枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枯菊二首 其二","author":"陆游","text":"积雪严霜转眼空，春回无处不春风。\n欲知造物无穷妙，但看萱根与菊丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柯桥客亭二首 其一","author":"陆游","text":"小市初晴已过春，朱樱青杏一番新。\n灞陵老子无人识，暂借邮亭整角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柯桥客亭二首 其二","author":"陆游","text":"梅子生仁燕护雏，绕檐新叶绿扶疏。\n朝来酒兴不可耐，买得钓船双鳜鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨柳枝二首 其一","author":"陆游","text":"杨柳春风绿万条，凭鞍一望已魂消。\n当年凤集城边路，曾爱纤纤拂画桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨柳枝二首 其二","author":"陆游","text":"西园雨打杏花稀，便面章台事已非。\n只恐无情堤上柳，又将风絮送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳","author":"陆游","text":"春来无处不春风，偏在湖桥柳色中。\n看得浅黄成嫩绿，始知造物有全功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳桥","author":"陆游","text":"村路初晴雪作泥，经旬不到小桥西。\n出门顿觉春来早，柳染轻黄已蘸溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳桥秋夜","author":"陆游","text":"帝青万里月轮孤，扫尽浮云一点无。\n正是吾庐秋好夜，上桥浑不要人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳桥晚眺","author":"陆游","text":"小浦闻鱼跃，横林待鹤归。\n闲云不成雨，故傍碧山飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残雨","author":"陆游","text":"五更残雨滴檐头，探借天公一月秋。\n只道风吹云散尽，数声桑下又鸣鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残梦","author":"陆游","text":"少时铁马蹴河冰，老去摧藏百不能。\n风雨满山窗未晓，只将残梦伴残灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残菊","author":"陆游","text":"残菊一枝香未残，夜窗拈起百回看。\n过时只恐难相笑，我是三朝旧史官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐闲咏二首 其二","author":"陆游","text":"深掩柴荆谢世纷，南山时看起孤云。\n残年所幸身犹健，闲事惟求耳不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐闲咏二首 其一","author":"陆游","text":"书生亦有功名愿，与世无缘每背驰。\n一寸丹心空许国，满头白发却缘诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐视老奴灌园","author":"陆游","text":"东窗日晚独愁予，眼闇年来颇废书。\n赖有吾家老阿对，相从引水灌园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5