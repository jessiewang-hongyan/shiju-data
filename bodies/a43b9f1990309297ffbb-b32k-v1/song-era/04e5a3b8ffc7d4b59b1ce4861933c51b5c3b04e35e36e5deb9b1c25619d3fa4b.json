[{"title":"雪中与长文景仁会西阁","author":"刘敞","text":"梁山风与雪，岁暮自峥嵘。\n误逐沧浪叟，飞来白玉京。\n屯云紫微阁，叠壁九重城。\n更挹浮丘袂，端令俗眼惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅","author":"刘敞","text":"泽国春还早，山梅腊竞花。\n缤纷迷雪意，浩荡逼年华。\n驿使红尘远，江风短日斜。\n芳菲恐易失，愁思乱悲笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春日雪中游蒙谷","author":"刘敞","text":"冰解泉应动，云寒雪更飞。\n谷中知律变，林下觉春归。\n风物如游蜀，衣冠似浴沂。\n瑶林与碧树，处处竞芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨竹","author":"刘敞","text":"羁游念此君，子墨慰幽人。\n洒落不经思，苍筤如出尘。\n交加月下影，浓澹雾中筠。\n试作吴山想，萧萧意亦真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夕阳","author":"刘敞","text":"过雨风景好，斜阳林下明。\n倦游宜几杖，却埽称柴荆。\n宿蝶依花静，归禽触叶惊。\n逍遥共兹世，聊复得吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题歙州流杯池","author":"刘敞","text":"公子爱客意，高山流水间。\n清波无断续，翠斝自回还。\n野兴四时得，棠阴终日间。\n何当竹林赏，醉耳听潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张给事途中微雪见寄四韵","author":"刘敞","text":"空行万里塞，不见六花飞。\n今日传清唱，端来点客衣。\n度关迷马色，拂树散春晖。\n不减山阴兴，从军中夜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后","author":"刘敞","text":"飞尘暂消冻，春意亦冲融。\n野水涓涓绿，林梢靡靡红。\n跃鱼轻泮冻，鸣鹤舞和风。\n出处惊时节，悠悠看岁穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古北口对月","author":"刘敞","text":"万古关山月，遥怜此夜看。\n蛾眉空自妩，丛桂不胜寒。\n他日刀头问，何时客寝安。\n因之千里梦，共下白云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新月","author":"刘敞","text":"花外惊新月，春残复满弓。\n馀香轻坠露，疏影细寒风。\n火禁通方俗，年华思老翁。\n清光堪半夜，稍醉玉壶空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后病愈至射堂作","author":"刘敞","text":"病失千峰雪，晴开万影新。\n雁飞天欲暖，风起野无尘。\n弱柳悲羌笛，辛夷思楚人。\n攀条复顾影，颇似去年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"目疾呈深甫","author":"刘敞","text":"久思废耳目，乃复困观瞻。\n默坐但凭几，幽居长下帘。\n玄黄迷宇宙，明晦错乌蟾。\n万事形骸外，人将不汝嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新晴二首 其一","author":"刘敞","text":"雨馀春更好，日出望还新。\n暄鸟啼惊客，林花笑向人。\n年华如过雁，世事剧飞尘。\n置酒陶嘉月，滔滔醉任真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新晴二首 其二","author":"刘敞","text":"薄云开早景，宿润减飞尘。\n好在松筠色，依然鸟雀驯。\n避人深却埽，炙背暖生春。\n未得献天子，潜书报近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦淮对月","author":"刘敞","text":"旧熟秦淮水，今浮万里船。\n泬寥明月夜，淡泊始秋天。\n静境他时绝，清光度晓圆。\n无人漫咏史，回首忆先贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚泊对月","author":"刘敞","text":"川光晚都白，岸色远全青。\n明月随孤剑，浮槎送客星。\n南飞鹊扰扰，北向雁冥冥。\n谁谓悲歌短，能吟酒易醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲雪寄贡甫","author":"刘敞","text":"欲雪天地闭，积云江海昏。\n著书成寂寞，玩岁觉崩奔。\n鸿雁自啸侣，鹡鸰常在原。\n离忧纷满眼，浪作种庭萱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初雪","author":"刘敞","text":"三日风振海，中宵雪覆城。\n已看秋落漠，更逼岁峥嵘。\n原隰龙沙碛，楼台白玉京。\n知谁错吹律，物物骤堪惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残雪","author":"刘敞","text":"积素不可卷，潜阳方未苏。\n劲风吹强起，明月照全无。\n封蛰龙蛇病，伤根竹柏枯。\n谁能开白日，后土正泥涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望雪山","author":"刘敞","text":"朔风何处雪，径度江南山。\n半出青天外，犹临庭户间。\n崔嵬海潮涌，泱漭暮云还。\n壮观感人意，长谣如可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏贺段生","author":"刘敞","text":"骠骑门下士，蹉跎已白头。\n知人家监误，弹剑起吹愁。\n忽逐侏儒饱，遥闻禄仕优。\n还乡问耆旧，当忆负薪讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政叶郎中","author":"刘敞","text":"老挂朝冠息故园，国人同叹仲翁贤。\n心惭白首恋三署，意与赤松均大年。\n玉树承风荣紫闼，史臣书美耀青编。\n他时就问朝廷策，还见公卿语邓先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和寄","author":"刘敞","text":"讲业儒林璧水开，望亲云下想徘徊。\n平原日暖歌鸰在，横陇风高听雁来。\n隐几郡斋閒主诺，荐羞家府乐循陔。\n何时乞得归宁告，对袭班衣捧庆杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送晏公留守南都","author":"刘敞","text":"苍龙大火明堂分，原庙离宫万乘居。\n五帝遗声在名颂，三公出使用安车。\n去思尚想多耆老，条教祇烦读旧书。\n复道平台弥百里，邹阳何处曳长裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯父挽词","author":"刘敞","text":"四十宾兴七十归，清风远与古人稀。\n未如彭祖犹为夭，颇似桐乡得所依。\n何路可能奔远日，此生无复待乌衣。\n故寻庭树丁宁诲，东望吴门涕自挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城下种竹今春极有佳笋","author":"刘敞","text":"环城密筱旧檀栾，春笋新成几万竿。\n池上龙蛇惊蛰起，军中矛戟绕营看。\n乌啼窈窈千重碧，风过萧萧五月寒。\n缓带轻裘容自暇，屦綦多向此林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月见梅花作","author":"刘敞","text":"腊前芳树暑前开，笑忆周南摽有梅。\n玉色还如雪中见，天香不减岭头来。\n黄莺未识休频顾，粉蝶初逢亦自猜。\n应与灵芝竞三秀，碧城瑶圃隔尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庆州子华侍读谏议","author":"刘敞","text":"禁中颇牧去临戎，属国归来敌垒空。\n闻道诗书今绝幕，复看天马亦从东。\n醉倾床酒留边月，歌倚鹍弦舞朔风。\n犹忆平生欢一笑，莫忘书札寄宾鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姚家寨道中逢李谏议","author":"刘敞","text":"萧萧归骑历崔嵬，一见尘中耳目开。\n授玉同为万里使，望云先识二星回。\n北荒鹏跃南溟去，西极马循东道来。\n世上应无此别远，留连彊尽手中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢范景仁李审言二谏议","author":"刘敞","text":"怪来原隰满光华，不意相逢天一涯。\n久别班荆情未易，少留倾盖日空斜。\n山连木叶千峰雪，地逼龙城万里沙。\n深愧壮心轻远适，自嫌憔悴听悲笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬宋次道忆馆阁曝书七言","author":"刘敞","text":"长廊复阁接天居，炎日清风蠹宝书。\n乍到似迷群玉近，餍观疑及羽陵馀。\n俊游真与尘埃隔，逸赏空惊应接疏。\n石室会须归史笔，周南宁复滞君车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日龙华阁寄永叔","author":"刘敞","text":"黄花欲落晓霜浓，极目秦川一望中。\n节物还如去年好，欢游不与故人同。\n接䍦自恣风前落，羽檄宁妨席上通。\n还畏简书归未得，寄诗黄阁付征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题友生水阁","author":"刘敞","text":"曲岸重重植浅莎，雨馀初觉长微波。\n水纹满屋浮清簟，风力冲阶折芰荷。\n境静自宜诗兴远，夜空应见月明多。\n从来著述希扬子，为羡幽人载酒过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢永叔","author":"刘敞","text":"绝域逢君水暂留，举杯相属问刀头。\n久持汉节旄空尽，独拜穹庐死可羞。\n醉里岁华惊易老，愁边沟水怆分流。\n玉关生入知无恨，不愿张骞博望侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔景灵朝谒从驾还宫","author":"刘敞","text":"汉帝迎年十二楼，明廷朝计万诸侯。\n真仙降集钧天乐，云旆回翔驷玉虬。\n物色遥占紫气入，香烟不隔曙光浮。\n秘祠非为神君语，自饬衣冠渭北游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泥雨早朝","author":"刘敞","text":"云气卷舒东复西，月华明晦晓兼迷。\n正怜盛服坐假寐，何处苍蝇来误鸡。\n高卧山林劳梦想，出门冠带混涂泥。\n人间气味故易厌，岂若从容归治畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵得午日酒","author":"刘敞","text":"午日风光复晏阴，轩昂未许岁华侵。\n楚魂招后宜皆醉，春酝来时且献斟。\n高枕洞庭看鸟度，卷帘衡岳听猿吟。\n郢中寡和由来事，应喜新诗有嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月十六日","author":"刘敞","text":"水国冰销天欲春，山城日出景还新。\n可怜物色曾非土，亦复穷愁不放人。\n碌碌流年转车毂，悠悠生意厌风尘。\n草茅不必开三径，杖履何尝及四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙侍郎访及仍携示近诗","author":"刘敞","text":"泌水衡门野老居，彤幨丹毂使君舆。\n固惊北海犹知备，曾谓西河尚起予。\n高卧穷愁述岁晚，立谈襟抱为公摅。\n浪传方伯中和颂，讵有虚仪讲德书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢吕侍郎","author":"刘敞","text":"北雁南凫不自期，异乡交臂复分飞。\n壮心巳折霜侵鬓，徂岁相看泪满衣。\n绝幕阴多逢日少，滞林行苦见人稀。\n子牟意绪君谙识，况乃登临远送归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄西台吴侍郎","author":"刘敞","text":"淮阳高卧彊逾时，洛水嵩峰入梦思。\n霖雨徒深旱岁望，白云自与帝乡期。\n功名摆落人间世，出处优游万乘师。\n坐视天民应未可，似公当就太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同济川题王金吾园亭","author":"刘敞","text":"王侯功业等山河，谢傅风流倦燮和。\n治第由来处穷僻，赏心曾是极酣歌。\n岁寒松竹孙枝在，诗罢池塘宿草多。\n闻道将军亦爱客，春游不问主人过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢晏公莲实","author":"刘敞","text":"落蕊漂香思碧莲，嫩芳成实澹晴烟。\n玉杯侧露参差重，麟趾模金约略圆。\n撷秀乍闻回急桨，荐新还许备加笾。\n涉江不限刍荛往，志服深希百疾蠲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答许待制依韵","author":"刘敞","text":"水衡钱朽太仓陈，均逸于藩布上仁。\n期月政声归卧理，旧邦风物变车邻。\n怀章昔别江湖永，辞剧由来意气真。\n召伯甘棠大山赋，去思留得与邦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹秀之待制罢福建还朝刘君玉待制自长沙移邓俱会郡下作七言叙别","author":"刘敞","text":"华阁昭回云汉间，侍臣高选奉清閒。\n曹刘共许同时贵，楚粤初看报政还。\n邂逅相逢惊远别，从君一笑发愁颜。\n莫教铙鼓催行色，更益春风雨鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将去上清题梧桐树","author":"刘敞","text":"小砌圆阴覆暝霞，曲轩疏牖称相遮。\n已成嘉实诚无用，未遇知音勿遽嗟。\n得地岂须矜露井，随流方共笑枯槎。\n明年冠者成春服，重看纷纷满树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤凰山笙竹","author":"刘敞","text":"仙山不记凤鸣时，碧筱空含玉润姿。\n海外虽传有嶰谷，人间似未悟孙枚。\n道家正贵知音少，野处还于静节宜。\n千岁重寻乐毅传，悠悠更觉使心悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳日玉津园赐宴是日杂端为主人","author":"刘敞","text":"御苑初晴暖景微，侍臣还许宴春辉。\n鸣禽试羽交交啭，落叶迎风冉冉飞。\n执法在前容款曲，大官先置尽膏肥。\n和平自是欢娱日，未醉春醪未可归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和忆幽谷二首 其一","author":"刘敞","text":"早闻幽谷未曾窥，翠壁清泉入梦思。\n到眼惜无名手画，醒心欣得醉翁诗。\n种花旧比甘棠树，刻石今成岘首碑。\n使我一麾从此逝，胜游当不减君时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和忆幽谷二首 其二","author":"刘敞","text":"深居忽忽春空过，积雨潇潇夏欲交。\n近砌梧桐新有荫，衔泥燕子总成巢。\n此邦卑湿酒长醉，随事文章亦解嘲。\n心远地偏人迹绝，漫劳三径数诛茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京尹仲议侍读自成都赴阙将过长安先寄","author":"刘敞","text":"都城一别远相望，楚水秦山各异方。\n每颂中和传四子，重闻京兆得三王。\n执经误接金华袐，卧阁惊看鬓色苍。\n逃暑肯为千日饮，能无歌舞荐清觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初雪朝退与诸公至西阁","author":"刘敞","text":"朝光初上九门开，贝阙珠宫白玉台。\n真有烛龙浮渤澥，却占云气认蓬莱。\n斗回暖景开鸣鹤，稍借新芳入早梅。\n更觉年华无限赏，履綦重叠绕苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答河中梅龙图","author":"刘敞","text":"龙池柳色锁春烟，故国风光此地偏。\n高下楼台浑浸水，往来车马自随船。\n举杯醉舞时相属，倚瑟悲歌忽怆然。\n安敢为文敌金谷，误烦求友赋新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离陈州先寄颍上龙图","author":"刘敞","text":"蓬蒿一亩亦蘧庐，终岁纷纷三徙居。\n客耳欣沾颍川水，儿谣积厌武昌鱼。\n宁知代舍悲长铗，忽幸侯门埽敝裾。\n虽信师金讥数昧，未甘莱子勤捐书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄襄阳舅氏龙图","author":"刘敞","text":"虎符龙节镇方州，天禄先生尚黑头。\n南纪山川殊壮丽，高阳宾客故风流。\n沈碑几处书遗爱，非土他时恨倚楼。\n想咏五君夸屡荐，为凭三鸟寄绸缪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送司马倩赴权官平凉尉","author":"刘敞","text":"将女随郎过渭城，正如前曰武陵行。\n当时底事伤离别，今日安知隔死生。\n渺渺平波侵汉苑，累累高冢厌秦京。\n登临感慨寻常事，何况衰年父子情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春乡答韩殿丞","author":"刘敞","text":"暂辞金鼎拥朱幡，注意虽殊体貌存。\n摆落功名如脱屣，招携宾客许游藩。\n东人愁咏鸿遵渚，北海欣看酒满樽。\n无以公归君幸识，凤池深隔九重阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复雨","author":"刘敞","text":"闭门高枕避春霖，眼见群芳稍见侵。\n独醒不如终日醉，暂晴那似断年阴。\n老惊岁月都无用，兴在江湖特更深。\n正想青枫千里外，草长波阔乱愁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中醉归","author":"刘敞","text":"楚山终日雨霏霏，寥落村花入眼稀。\n可惜东风变酒味，无端宿霭破春晖。\n屈原渔父谁清浊，御叔臧孙交是非。\n倒著接䍦惊道路，悠悠判与世相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永叔附寄滁州庶子泉李监题十二字","author":"刘敞","text":"琅琊山侧白云溪，石壁何年李监题。\n翰墨一时称妙绝，尘埃数字尚端倪。\n惊看龙虎潜光彩，恨使莓苔损角圭。\n大叫发狂心未足，竹林幽赏负招携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临昆亭","author":"刘敞","text":"孤城西北起高楼，天半昆崙入寸眸。\n碧树参差见平圃，屯云重叠辨轩丘。\n百年礼乐逢休运，千里江山极胜游。\n那似鲍昭空写恨，不为王粲独销忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔李太尉饮席闻筝","author":"刘敞","text":"红颜翠发夺春辉，繁手哀弦逐羽卮。\n正使千觞无复醉，谁令中曲不胜悲。\n留连起舞惊残夜，仿写遗音入怨诗。\n我识东山安石意，沾襟应自属桓伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斋宿集禧观戏酬永叔见寄时永叔在后庙摄事","author":"刘敞","text":"尚平故有五山期，独许迎年太液池。\n贝阙碧城相绚烂，石林琪树共参差。\n玉杯醽好经时醉，冰簟风多尽日棋。\n正想火龙劳陟降，更烦佳句寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和致政庞相公上巳约游集禧观不至","author":"刘敞","text":"琳馆经春瑞气浮，当时曾约相车游。\n仙花又向庭中落，宫水还萦苑外流。\n云路空思攀去鹤，沙堤犹忆问行牛。\n明年三月芳菲在，须把兰亭禊事脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上南风变晴","author":"刘敞","text":"繁阴欲闭凯风来，一埽穷荒万里开。\n日色葱昽浮渤澥，云容舒卷映蓬莱。\n旅情更觉光华远，暖意何妨节物催。\n醉眼却思山雪好，腊前容可当新梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新种杂花树","author":"刘敞","text":"江边腊破东风起，舍侧栽花绕四邻。\n要似桃源堪避世，会令桂树默留人。\n即看红叶娟娟秀，豫想喧蜂处处新。\n庾宅荒凉宋亭古，应须大占郢中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]