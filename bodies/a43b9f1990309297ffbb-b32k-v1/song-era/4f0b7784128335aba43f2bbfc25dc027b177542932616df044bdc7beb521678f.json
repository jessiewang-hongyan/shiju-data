[{"title":"杂诗 其九","author":"李正民","text":"岁晏多风雨，寒云晓更浓。\n晚菘长乍剪，香稻细新舂。\n路远思行客，年荒叹老农。\n秖园人不到，惟听饭时钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗 其十","author":"李正民","text":"汲汲谋三径，区区卜一廛。\n艰难归旧隐，荏苒叹流年。\n欲设维摩榻，重寻子敬毡。\n飘零来海角，华发已盈颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗 其十一","author":"李正民","text":"久雨浑无节，重云凝不收。\n朔风吹瓮牖，寒色透貂裘。\n幸不妨农务，何堪助客愁。\n拥炉消短晷，闭户但商讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪次韵 其一","author":"李正民","text":"寒风初淅沥，密雪遽霏微。\n冷敌鹅黄酒，轻沾驼褐衣。\n未教新柳展，且伴落梅飞。\n惟有翟廷尉，门前鸟雀稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪次韵 其二","author":"李正民","text":"花犹吹六出，气已应三微。\n路破公车履，祥呈光禄衣。\n乍疑鹇失素，稍怪鹭于飞。\n盘瓠空惊走，南方此瑞稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次春雪韵 其一","author":"李正民","text":"旬浃寒弥急，阳春暖尚微。\n西华愁葛帔，渔父点蓑衣。\n京洛残堪望，龙山度正飞。\n麟经书大雪，此瑞古今稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次春雪韵 其二","author":"李正民","text":"万壑铺平练，千岩锁翠微。\n车能翻缟带，尘不化缁衣。\n撼树桄榔满，张图蛱蝶飞。\n敲门传诗卷，此曲郢中稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘刑部 其一","author":"李正民","text":"西汉于张手，传家旧得名。\n金科惟尚恕，棘寺每持平。\n丹笔流馀庆，朱轓蔼政声。\n他年门下客，接武位秋卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘刑部 其二","author":"李正民","text":"避地辞高密，侨居寓武原。\n放怀乐棋酒，馀力治田园。\n方茂三松寿，俄成万日墦。\n九原箫鼓咽，难驻已招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽曾公衮宝文 其一","author":"李正民","text":"靖国开皇极，先公秉化钧。\n谢庭知有子，孙閤遂延宾。\n烜赫萧周上，苍黄屈贾邻。\n欲明当日事，正论墨犹新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽曾公衮宝文 其二","author":"李正民","text":"际会光华旦，传家各有人。\n荣名今已矣，陈迹重悲辛。\n曷报生刍礼，难留玉树春。\n隼旟空望断，清泪落衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽沈伯华","author":"李正民","text":"望出东阳裔，蝉联济美材。\n海邦歌政化，泽国早归来。\n甲第朱门掩，佳城白日开。\n松风九原陌，薤露有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘朝请 其一","author":"李正民","text":"世德流芳远，身兼五福全。\n华堂优几杖，蜡屐访林泉。\n白发光阴永，青云嗣子贤。\n佳城开吉兆，松柏已苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘朝请 其二","author":"李正民","text":"眉寿人生贵，题舆善政闻。\n中心如止水，外物等浮云。\n方乐千钟养，俄成万日坟。\n欲知流庆远，霅水自沄沄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽广川先生","author":"李正民","text":"万卷胸中富，千年笔下新。\n广川扬素业，延阁想芳尘。\n晚陟螭坳峻，俄留凤沼津。\n遗书应满箧，不愧泣麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽钟处士","author":"李正民","text":"日昊身犹健，居闲道更优。\n庭栽兰九畹，户种橘千头。\n惠施曾无倦，阴功祗自修。\n荀裴门户壮，他日振馀休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽綦内翰 其一","author":"李正民","text":"扈跸来江表，同时掌掖垣。\n鲸波连画鹢，鹿野对清樽。\n涉世行藏异，论交道义敦。\n遽成生死隔，回首泪潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽綦内翰 其二","author":"李正民","text":"鳌禁凝严地，雍容侍北扉。\n花砖朝直晚，莲烛夜分归。\n玉节恩虽异，金瓯事已非。\n飘零旧僚友，华发老渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽綦内翰 其三","author":"李正民","text":"东土游观乐，西亭风景悲。\n漫馀曾蹑屐，空覆旧传卮。\n高密山川隔，丹邱草木滋。\n凄凉谢道蕴，泣对白纱帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽鲁奉议 其一","author":"李正民","text":"华胄流芳远，平湖世载昌。\n鲤庭遵善教，龟组贲恩章。\n劳佚身兼适，悲欢念两忘。\n平生修净业，归路指西方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽鲁奉议 其二","author":"李正民","text":"盛大身攸致，勤劳力克堪。\n仁心兼五福，庆泽在诸男。\n经罢翻灵运，人知吊老聃。\n百年嗟已矣，终始自无惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽胡茂老枢密 其一","author":"李正民","text":"盛际符千载，中朝第一人。\n凤池鸣委佩，朱邸奉重轮。\n右府谋猷密，殊邻意气伸。\n佐时遗事业，谁为勒苍珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽胡茂老枢密 其二","author":"李正民","text":"人物熙朝盛，琼林夐出群。\n高名题雁塔，平步上青云。\n未应三壬兆，先修万日坟。\n丹台应有籍，脱屐谢尘氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽胡茂老枢密 其三","author":"李正民","text":"昔日蓬山会，平居笑语亲。\n薄材陪贾马，高义继雷陈。\n南国居方卜，东山道益振。\n遽嗟埋玉恨，清泪洒衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽董舍人","author":"李正民","text":"华发年方永，祠廷力未愆。\n谁云牖下死，疑是醉中仙。\n骥子持门户，鱼轩泣几筵。\n浮生真瞬息，谁与问青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽齐安郡夫人","author":"李正民","text":"懿范闺房秀，齐姜素望优。\n广川名益盛，内壸德弥修。\n寿量方难老，生涯遽若浮。\n延平双剑逝，遗恨在营丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日示邦求","author":"李正民","text":"济时材术本无庸，长大犹存伯业功。\n骐骥已消千里志，鶢鶋聊避广川风。\n论都正恐讥伧父，置酒深惭及寓公。\n早晚共谋归去计，烟波䆉稏五湖东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示艾若讷","author":"李正民","text":"文章自昔为难事，词赋于今岂易工。\n入室升堂方尽善，取青配白漫称雄。\n师资未省逢勍敌，衡鉴应宜探古风。\n顾我平生章句学，强谈文律愧空空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄汪彦章内翰","author":"李正民","text":"文华风采压时流，惠政春温著六州。\n才向卞山归旧隐，忽寻湘水泛扁舟。\n愚溪胜践今亲见，清境西偏几客游。\n皋壤山林皆可乐，不须重作畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄彦章内翰","author":"李正民","text":"翰林名德冠銮坡，暂解尘缨逸兴多。\n敢谓交游同阮谢，不妨诗句敌阴何。\n耳根到处闻犍斗，心地闲来契羯磨。\n此去苕溪三百里，扁舟终拟泛烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访祝舜俞新居","author":"李正民","text":"平湖渺渺浸城阴，窈窕垂杨一径深。\n千万买邻真得计，六年种竹已成林。\n棋枰胜负消长日，琴韵清幽见古心。\n萍泛蓬飞本无系，新亭何必苦沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送尹叔倅濠梁","author":"李正民","text":"淮邦井邑苦萧条，尚可观鱼访古濠。\n志士揽衣辞旧隐，馀民拭目看垂櫜。\n清传阖境持杯水，器赏名贤解佩刀。\n无复高阳旧闾里，为寻故宅薙蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠刘无虞侍郎","author":"李正民","text":"粉户为郎赞冢卿，十年先后典铨衡。\n要津讵可驰高足，大器于今见晚成。\n相对樽前叹华发，宁于纸上校虚名。\n万钉宝带知非称，欲买良田待退耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻吕丞相还朝 其一","author":"李正民","text":"粉户为郎两见春，当时曾识济川人。\n留侯再践功名地，白也今为放逐臣。\n自笑凫鸿飞渤澥，却惭冠剑拂埃尘。\n数奇自是平生事，终始须期入大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻吕丞相还朝 其二","author":"李正民","text":"赤子潢池久弄兵，暂辞台席抗蜺旌。\n屏风隔坐方调燮，棨戟前驱遽远征。\n淮蔡巳瞻裴相节，秦川犹列武侯营。\n策勋未用膺光宠，待复中原致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送尹叔之行朝","author":"李正民","text":"三年制锦在江吴，游刃恢恢地有馀。\n贾谊已膺前席问，嵇康新有绝交书。\n田间雨过禾收早，庭下风来叶落初。\n此去青云前路稳，未应搔首赋归与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题海月亭","author":"李正民","text":"新亭注目极无边，脱屣尘寰思杳然。\n万顷秋涛翻浩渺，一轮夜月对虚圆。\n光连银汉疑无地，望断蓬莱别有天。\n赤水枣花君莫问，新诗赓唱似朱弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章季万送示其祖内制次元叔韵诗","author":"李正民","text":"运际熙丰政日新，近臣摛藻掞天门。\n当年翰墨文章妙，晚岁经纶德业尊。\n纪事丰碑推大手，忧民温诏尽嘉言。\n大门接武登鳌禁，犹喜交游到子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简刘卿任待制","author":"李正民","text":"暑雨霖霪朱夏寒，登门暂著鵔鸃冠。\n管弦岂解陪张禹，葱菜真宜待井丹。\n五技已穷甘退处，一钱不直叹衰残。\n明朝鼓枻辞公去，却向沧浪把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书事","author":"李正民","text":"懒拙山林合退藏，客情岁晚倍凄凉。\n梅飘苔藓香初歇，雪积檐沟色尚妆。\n旧历细看能几日，新诗屡和断来章。\n何如认取安心法，坐对炉熏一穗长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示侄淇","author":"李正民","text":"分符江左力难支，窃食琳宫得禄迟。\n淮上故园生杞棘，江边大将列旌旗。\n未知疏傅挥金日，正是公孙脱粟时。\n为报阿咸休怅望，十年穷巷困朝饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘子材四明幕官","author":"李正民","text":"雉堞连云左海傍，曾攀鲸背到扶桑。\n蒙冲声教通韩国，梵刹光明记育王。\n地接天台仙圣宅，山藏奎画妙圆章。\n时清幕府多馀暇，薄采江珧荐豆觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐元美甲第新修同诸公赋诗","author":"李正民","text":"大厦沈沈结绮栊，诛茅新就化人宫。\n春台乱落桃花雨，北牖遥披柳叶风。\n遁迹娱游同梓泽，卜居穷僻似萧公。\n人生适意方为乐，何必箪瓢叹屡空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋戏元美","author":"李正民","text":"绵绵千载亢华宗，大栋高甍辟广宫。\n柳径乍穿迷去路，桃蹊初过面春风。\n闲居不羡潘常侍，投辖当如陈孟公。\n竹外梅花犹可折，莫教碧玉髻鬟空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀士诗","author":"李正民","text":"一叶扁舟一席风，梦回已听景阳钟。\n夺袍有意趋文阵，鼓箧无言拙笔锋。\n好把犁锄傍东郭，难陪衿佩集西雍。\n只缘未富三冬学，饮墨何须见愠容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"退老堂","author":"李正民","text":"将相勋名纪太常，旌旄聊驻水云乡。\n栽培草木平泉里，放浪琴书绿野堂。\n身健未应亲几杖，公归正欲望轩裳。\n东山谢傅风流在，盛事齐称左海傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野步","author":"李正民","text":"步屧寻春日正暄，杖藜徐步小桥边。\n身如柳惠人皆识，名比韩康世漫传。\n雪压寒梅枝袅袅，烟笼脩竹翠娟娟。\n途穷兴尽空回首，却见招提独岿然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蛤蜊","author":"李正民","text":"泊水沈沙族类丰，外缄顽壳力难攻。\n虽云眉目亏天巧，谁使琼瑶美内充。\n海畔屡曾逢野士，坐间那复识王融。\n一樽风味思倾倒，赖有芳鲜可荐公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵邦求少监 其一","author":"李正民","text":"投老穷途乃叫阍，再栖琳馆奉高真。\n自怜奇蹇生华发，岂有声名继昔人。\n梨枣栽培功未半，林泉卜筑兴方新。\n看公稳步星辰去，何必乘槎更问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵邦求少监 其二","author":"李正民","text":"历落嵚崎寓海滨，放怀林壑任吾真。\n恩垂雨露沾枯蘖，义重金兰有故人。\n玉笋班联年尚少，筠筒诗律意尤新。\n三阳交泰逢亨运，策足须登要路津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和元叔冬至大风","author":"李正民","text":"风掀篱落尽攲倾，夜半铜壶冻已生。\n塞雁冲寒云路杳，林乌啼晓梦魂惊。\n贫探龙颔嗟无策，愁望鸰原祗搅情。\n拟学高斋枯淡叟，不妨姓字且双行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海邑少交游相见者以为言故作此诗","author":"李正民","text":"结友观光少壮年，一时英俊与周旋。\n曳裾璧水三千士，接武瀛洲十八贤。\n夜对短檠愁不寐，朝餐苜蓿叹无钱。\n如今只欲藏形影，槁木寒灰学坐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄霅上故人","author":"李正民","text":"交流苕霅转城闉，尚想汀洲咏白蘋。\n择胜已居莲社界，归耕恰及杏花春。\n彫胡映盌抄云子，鲙缕堆盘破玉鳞。\n鲑菜腥咸何足道，未应回首海之滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽陈志行寺正","author":"李正民","text":"昔日陵阳接俊游，松萝崇好重绸缪。\n青衿共处披黄卷，黑发相看到白头。\n苕水卜邻方有志，青山埋玉竟难留。\n飘零更觉亲朋少，东望新阡涕泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简邦求宗博","author":"李正民","text":"荆州清德畏人知，况值中原战鼓鼙。\n公自南来无薏苡，我从东渡乏朱提。\n珍台鹤禄惭非称，别乘瓜期奈久稽。\n明日重阳菊花好，且拚痛饮醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄艾若讷","author":"李正民","text":"宅相凋零久不振，喜君文采日清新。\n弹琴密令能官业，献颂王褒迈等伦。\n岂有青松蟠涧谷，待看騄骥绝风尘。\n诸儒方讲升平事，策足须登要路津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄闻人茂德 其一","author":"李正民","text":"诗人比兴隐而彰，三百馀篇妙义藏。\n已识鸱鸮为巧妇，仍知杕杜是甘棠。\n书生未省离城阙，物理何从见否臧。\n闭户先生学不厌，更同许郭辨毫芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄闻人茂德 其二","author":"李正民","text":"未捐辛苦读书灯，老矣犹怀伯业能。\n齐国吹竽吾独否，荆山泣玉恨难胜。\n满籯自足传儿子，堆案何劳谢友朋。\n已注虫鱼穷窈眇，却游溟海看鹍鹏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄元叔","author":"李正民","text":"涉世崎岖三十年，栖迟琳馆祝尧天。\n桔槔不用身谋拙，梨枣先栽气守全。\n何幸童乌新忝命，应容老鹤渐归田。\n囊金未足营三径，搔首东风一慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄李成德舍人","author":"李正民","text":"蓬瀛当日接英游，俛仰星霜十见秋。\n红药青苔叨并命，西山南浦动离愁。\n宁论圆观情犹在，且喜维摩病少休。\n欲就书堂访高隐，便疑猿鹤不相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"买舟之苕溪","author":"李正民","text":"二年宴坐縠溪滨，廷尉门前鸟雀驯。\n问舍求田将欲老，畜鸡种黍孰为邻。\n曾遭太仆兴谗口，粗胜漳江抱病身。\n暂泛扁舟苕霅去，鳜鲈聊醉五湖春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自苕溪回棹","author":"李正民","text":"扁舟东下霅溪滨，拟伴渔翁整钓缗。\n黄纸红旗惭许国，落花流水送残春。\n拿舟处处争行乐，脩禊年年要及辰。\n怅望故园桃李月，东风吹泪漫沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颐庆堂为徐氏赋","author":"李正民","text":"朱方玉几邈千龄，落落云孙尚典刑。\n跂翼翚飞新栋宇，笔精墨妙旧丹青。\n十旬酿酒宜为颂，七水煎茶必有经。\n积善故知颐庆远，诜诜兰玉长阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭友人诗 其一","author":"李正民","text":"流落生涯集百忧，十年抱病甬东州。\n忽惊白璧埋黄壤，漫说朱衣驾赤虬。\n高论难投众人耳，壮心空逐逝川流。\n死生暌隔伤千里，泪洒丛兰泣素秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭友人诗 其二","author":"李正民","text":"王谢门中鸾凤翔，少年奇志已昂藏。\n空馀诗律知谁敌，欲继家声失所望。\n作赋曾惊祢衡俊，行歌不见接舆狂。\n临终一念归空寂，讵肯修文学卜商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追忆大观丁亥年自新安侍下入宣城学路中作","author":"李正民","text":"朝云黯黯结秋阴，叠叠层峦雾霭深。\n农叟尽愁苗欲稿，行人翻恐雨成霖。\n四方奔走男儿事，千里凄凉倦客心。\n稍喜西风破残暑，又携书剑度遥岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]