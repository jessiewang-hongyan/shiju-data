[{"title":"书景德寺刑法试官题名后","author":"郭祥正","text":"刑场讫事欲分携，犹有残花恋故枝。\n更绕庭阴行数匝，九人重到定难期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君仪惠莆田陈紫荔乾即蔡君谟谓之老杨妃者二首 其一","author":"郭祥正","text":"莆田乾荔老杨妃，谁在开元得见之。\n却忆沉香亭北畔，轻红曾照赭黄衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君仪惠莆田陈紫荔乾即蔡君谟谓之老杨妃者二首 其二","author":"郭祥正","text":"红绡皮皱核丁香，日曝风凝玉露浆。\n不向海边为逐客，长安无此荔枝尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇因老禅诠公携诗见访","author":"郭祥正","text":"禅定安详元契佛，年华八十尚能诗。\n何人断臂来求法，庭柏萧萧度岁时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安止同登王园葆光阁二首 其一","author":"郭祥正","text":"清风吹坐冷萧萧，更有南溪透海潮。\n白酒一樽须酩酊，荔枝红映碧芽蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安止同登王园葆光阁二首 其二","author":"郭祥正","text":"海潮溪鹭绝纤尘，酒浪灯花自在春。\n醒眼莫嫌长醉客，回头俱是幻泡身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访林居士","author":"郭祥正","text":"门无车马绿生苔，今日轩窗为我开。\n邂逅同为方外客，得携筇杖等閒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安止登山","author":"郭祥正","text":"鬓发鬖鬖一幅巾，可将身世等浮云。\n人间祸患无如我，物外逍遥只有君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白莲日师北轩","author":"郭祥正","text":"家风清白世相传，自小能吟晚好禅。\n潇洒一轩无长物，荔枝茶品写遗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐公长老卧云轩二首 其一","author":"郭祥正","text":"云本无心师亦閒，閒身聊卧白云间。\n白云不灭身长在，时往香台请供还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐公长老卧云轩二首 其二","author":"郭祥正","text":"安详禅定悟尘劳，放去收来没一毫。\n门掩白云聊昼卧，世间言说付儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀公见喜饭僧二首 其一","author":"郭祥正","text":"百年光景逐飞萤，会脱尘劳只有僧。\n一饭聊为清净乐，福田求报我何能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀公见喜饭僧二首 其二","author":"郭祥正","text":"审观六入本来空，觉海迷波理亦同。\n满钵香粳聊共饱，此缘不落有为中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国清院","author":"郭祥正","text":"深深楼殿妙峰攒，竹露松风夏亦寒。\n莫道西湖近乾浅，此中曾有老龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李伯华","author":"郭祥正","text":"患难相亲似子稀，倏然分手重伤悲。\n官闲肯忆西湖上，淡月寒梅只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴山人二首 其一","author":"郭祥正","text":"邂逅相逢瘴海头，白云黄菊漫迟留。\n他年江浙能寻我，多在芦花拟钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴山人二首 其二","author":"郭祥正","text":"生死波中止一沤，离家失子已忘忧。\n只思北苑春芽熟，安得骑鲸逐俊游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其一","author":"郭祥正","text":"群山高下漫湖漘，暝霭朝霞物物新。\n驿道更穿东北去，青铜影里看行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其二","author":"郭祥正","text":"东湖水似鉴湖明，红白荷花自在生。\n只有香风吹客座，更无烦暑到檐楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其三","author":"郭祥正","text":"轩窗得地向湖开，要客登临共一杯。\n白鸟探鱼长不去，清风吹水等閒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其四","author":"郭祥正","text":"一轩正在碧湖傍，莲子枯时荇菜香。\n最爱夜深鸥鹭散，钓船明月似潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其五","author":"郭祥正","text":"湖外青山案几横，卷帘幽坐少逢迎。\n一钩香饵看鱼上，万顷金波待月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其六","author":"郭祥正","text":"一湖绿水当窗净，百里青山卷箔开。\n只恐夕阳催客去，不嫌幽鸟趁人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其七","author":"郭祥正","text":"一炷沈烟一案书，怜君重葺紫霞居。\n溪山朝暮能新美，世虑尘缘并扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其八","author":"郭祥正","text":"锄去蒿莱地势平，开轩潇洒瞰东城。\n湖山变尽朝昏景，只欠青猿一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其九","author":"郭祥正","text":"谁知城郭有山林，选胜营居遣壮心。\n一片远烟添暮色，数声归鸟变春音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮师旦希圣彻垣开轩而东湖仙亭射的诸山如在掌上予为之名曰新轩盖取景物变态新新无穷之义赋十绝句 其十","author":"郭祥正","text":"仙庭射的斗崔嵬，紫翠飘飘落酒杯。\n更待春阴须一往，要看雷雨过湖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其一","author":"郭祥正","text":"寻春行过古城东，春气先从海角通。\n池草怯霜拳嫩绿，山桃迎日展新红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其二","author":"郭祥正","text":"池塘新水碧泱泱，杨柳牵风绿线长。\n已信形骸随野马，不思功业到岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其三","author":"郭祥正","text":"一听春声只自悲，山山相应鹧鸪啼。\n却寻花岛看花处，水上红云数片低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其四","author":"郭祥正","text":"一杯浊酒览春光，人世纷纷任短长。\n细草自匀新岁绿，落梅犹散去年香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其五","author":"郭祥正","text":"云影暮时莺语低，花枝深处蝶魂迷。\n青楼不远要佳客，锦缆牵船更向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其六","author":"郭祥正","text":"草色葱苍遍冢丘，花枝红白倚城头。\n凭谁唤取王摩诘，画出伤春一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其七","author":"郭祥正","text":"茸茸绿芷香先吐，点点绯桃萼半敷。\n却忆江南江水满，一条晴练接天铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其八","author":"郭祥正","text":"数行徙倚迎风柳，几树参差照水花。\n最惜去年梁上燕，会随春色到贫家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其九","author":"郭祥正","text":"青春又送一年来，不道春霜两鬓催。\n春浅春深春自老，且将怀抱向春开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵安止春词十首 其十","author":"郭祥正","text":"花开游女斗明妆，马上谁怜白首郎。\n社叟从今歌击壤，诗人不用叹繁霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其一","author":"郭祥正","text":"关关禽语弄轻风，决决田流上下通。\n行过小桥穿竹坞，山花时见一枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其二","author":"郭祥正","text":"无数幽花覆水香，一条轻素引烟长。\n客情春恨都谙尽，把笔题诗独绕廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其三","author":"郭祥正","text":"新莺求友出林飞，谷谷催耕着处啼。\n野渡无人芳草碧，前山欲雨暮云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其四","author":"郭祥正","text":"斜日会扶岚气暖，好风能送笛声长。\n倦投芳草人人醉，流出残花涧涧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其五","author":"郭祥正","text":"花枝自倚青春笑，客恨须凭浊酒迷。\n望断夕阳无问处，只今应照故园西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其六","author":"郭祥正","text":"春事须臾不可留，花枝争上少年头。\n欲乘舴艋凌波去，何处佳人似莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其七","author":"郭祥正","text":"花笑莺啼酒可沽，山光水影淡烟敷。\n垂杨欲碍春归路，更放轻绵匝地铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其八","author":"郭祥正","text":"营巢新燕惊垂幕，采蕊娇蜂避落花。\n着处风光浓似酒，行人何事苦思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其九","author":"郭祥正","text":"寻春眷眷惜春回，四序相新一气催。\n桃李无言贪结子，野棠閒淡为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和 其十","author":"郭祥正","text":"盈筐斗草红裙女，亸袖香毬白面郎。\n归去不嫌清夜冷，李花枝上月凝霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苏紫霞选仙集后二首 其一","author":"郭祥正","text":"六博成书意在仙，每要佳客造玄天。\n不由功行浑由彩，一局升沉亦偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苏紫霞选仙集后二首 其二","author":"郭祥正","text":"知君本是紫霞仙，梦入瑶池泛酒船。\n功行已成真驭远，却嗟尘世阅遗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢陈昌国惠酒二首 其一","author":"郭祥正","text":"平生爱酒养天真，醉眼聊为混俗人。\n玉斗贮来红浪溢，感君添我海中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢陈昌国惠酒二首 其二","author":"郭祥正","text":"欲泻琼浆洗我忧，玉壶分送不知休。\n醉来一觉还乡梦，看尽江南二十州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"半漳亭","author":"郭祥正","text":"飞檐赤白压层丘，见尽漳南一半州。\n倦步且来消午暑，穿云此去彻鳌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城东延福禅院避暑五首 其一","author":"郭祥正","text":"榕阴缺处见西山，步遍墙阴落照间。\n谁信史君无一事，只知终日与僧閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城东延福禅院避暑五首 其二","author":"郭祥正","text":"暑雨霏微湿翠岚，共投萧寺解尘骖。\n黄粱初熟鲟羹美，恰称嵇家七不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城东延福禅院避暑五首 其三","author":"郭祥正","text":"急手轻调北苑茶，未收云雾乳成花。\n灵襟习习清风起，归梦遥知不到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城东延福禅院避暑五首 其五","author":"郭祥正","text":"隔涧人家通小桥，家家沽酒可相邀。\n深沈榕叶遮烦日，浩荡风头驾晚潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荔枝二首 其一","author":"郭祥正","text":"枝条相轧碧云浓，衬出骊珠落照中。\n未说甘香消酷热，且看纤手擘轻红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荔枝二首 其二","author":"郭祥正","text":"暑馆风沈睡眼醒，荔枝新熟暗香生。\n玉纤为剥红绡颗，甘露初凝湿水晶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄资深承事行营二首 其一","author":"郭祥正","text":"纵横才略领千兵，雕鹗群飞战舰轻。\n海浪掀天须破贼，始知名将是儒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄资深承事行营二首 其二","author":"郭祥正","text":"黄梅欲落雨霏霏，想过重冈湿战衣。\n破贼有期先可喜，裂云箫鼓待君归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净惠寺清轩二首 其一","author":"郭祥正","text":"枯筇坏衲老清时，万事纷纷久不知。\n隔屋荷香消午暑，红薇花影在深池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净惠寺清轩二首 其二","author":"郭祥正","text":"一轩潇洒静无尘，万柄荷花别是春。\n莫道南州无北客，壁间犹对洛阳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕不饮","author":"郭祥正","text":"明河初月静涓涓，楼阁帘开斗管弦。\n不饮一樽当此夕，我心于巧久无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子中修撰石盆题壁二首 其一","author":"郭祥正","text":"沉沉石室乱云间，万事都忘只有閒。\n暂辍玉堂挥翰手，一时吟遍谢家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子中修撰石盆题壁二首 其二","author":"郭祥正","text":"青山重复路逶迤，虽近州城俗客稀。\n只有史君频得句，时时吟袖带云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子中忘归轩","author":"郭祥正","text":"忘归归去尽强名，山鸟山花任送迎。\n未信史君长恋此，马头将逐诏书行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子中修撰石盆转轮藏","author":"郭祥正","text":"栖函藏轴一轮中，种种难名宝网丛。\n莫道石盆无大地，只今成就圣王宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吊圣俞坟","author":"郭祥正","text":"平生怀抱只君知，想见音容涕泗垂。\n宅舍已荒儿女散，孤坟秋草自离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平天庆观题壁五首 其一","author":"郭祥正","text":"缥缈朱楼浮绛烟，瀰漫碧酒汎金船。\n琼花满树春长在，知是人间换几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平天庆观题壁五首 其二","author":"郭祥正","text":"琳宫缓步独移时，世事纷纷不复知。\n且看满庭松上雨，碧瑶幢节覆青丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平天庆观题壁五首 其三","author":"郭祥正","text":"一枰棋散复持杯，却绕长廊步懒回。\n且看满庭松下月，断金斜玉间苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平天庆观题壁五首 其四","author":"郭祥正","text":"风吹云雨霁，入门松桧香。\n何处有烦暑，心官自清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平天庆观题壁五首 其五","author":"郭祥正","text":"听君弹别鹤，别鹤怨离索。\n何以动乾坤，六月秋霜落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月蓬莱亭周彦达节推酌发","author":"郭祥正","text":"万里行人辞故乡，登高回首更重阳。\n黄花折尽碧云晓，未听离歌未断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永安荣仲谋秘校访别三首 其一","author":"郭祥正","text":"感君随月跨征鞍，来访熙宁旧长官。\n莫讶髭须浑雪白，哭儿清泪不曾乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]