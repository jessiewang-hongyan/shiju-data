[{"title":"次韵 其五","author":"韩淲","text":"太湖渺渺浸苏台，云白天青万里开。\n莫道吴中非乐土，南人多是北人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲至腊梅水仙","author":"韩淲","text":"吾家同出郓州梁，冷落江南各一房。\n梅下水仙京洛种，吟成应话故园香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵绍之","author":"韩淲","text":"风送潮回沙地乾，船头山色自相看。\n凤城回首三年梦，一笑新秋转薄寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦章三首 其一","author":"韩淲","text":"三篇怀友赋新诗，浑是经书有德辞。\n须信胸中本泾渭，交游不为俗推移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦章三首 其二","author":"韩淲","text":"展转寻思读此诗，情文俱尽见于辞。\n为公行坐沈吟久，不觉床间日影移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦章三首 其三","author":"韩淲","text":"恨无佳句答情诗，搔首如何措一辞。\n知道春风动归思，篮舆山路想频移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其一","author":"韩淲","text":"休论玉蕊发唐昌，入眼何能易比量。\n晓露未收寒露下，无风亦自有幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其二","author":"韩淲","text":"风前月底尽幽通，影落香濡杖履中。\n几度吟来吟不尽，但知老树更穹窿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其三","author":"韩淲","text":"未开宜雨落宜烟，只占山岩已自贤。\n白石中间写泉水，何须物外觅花仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其四","author":"韩淲","text":"能与幽芳作主人，西风吹净世间尘。\n接䍦攲倒寻诗处，应在章泉泉水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其五","author":"韩淲","text":"城中有客占林园，应据枯桐入梦魂。\n秋日肯忘东里赵，年时曾醉永嘉潘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其六","author":"韩淲","text":"彫零四海几人存，一一皆为我所尊。\n物色依然赋丛桂，谁知潘鬓老儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其七","author":"韩淲","text":"山回溪净气尤清，落水声中反独荣。\n日照月移俱可玩，株株根畔古苔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其八","author":"韩淲","text":"去岁西林湖寺中，野僧曾与咏晴风。\n一时潘盖姜同饮，今日相望我秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其九","author":"韩淲","text":"吟尽清诗花自开，中秋宜共月徘徊。\n京尘抖擞岚生润，忘却年光过眼催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父十首 其十","author":"韩淲","text":"待以繁英荐夕餐，分明书室是芝兰。\n从来正色黄尤羡，俗眼从他强爱丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯皋 其一","author":"韩淲","text":"流转风光恨不迟，伤风病酒只花知。\n海棠红外梨稍白，人倚栏干忆旧期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯皋 其二","author":"韩淲","text":"著意酬春得句迟，閒愁未必故人知。\n五更满院吹风雨，急起成章与子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵成季 其一","author":"韩淲","text":"夜如荒远吠何频，不觉京华旅食贫。\n试拥残书对灯火，门前应有往来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵成季 其二","author":"韩淲","text":"短桥平水树清深，树外云生漠漠阴。\n衣带冠緌半尘土，少凭书几到诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀斯远及施仲益次章丘韵","author":"韩淲","text":"其后凄然忍寄诗，寄之谁复读于斯。\n章丘木落风月冷，手泽应须留与儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵二首 其一","author":"韩淲","text":"从前常怪复然灰，入手清诗且剪裁。\n拟待高楼同问月，一关新禁莫能来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵二首 其二","author":"韩淲","text":"有怀佳伴每忻然，岁晚相看不待言。\n应笑老身山涧曲，年年炙背只晴暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫","author":"韩淲","text":"未成雪片渔蓑句，空对梅花铁石肠。\n穷巷萧条人独卧，暮云零落雁分行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十五日昌甫斋中徐倅送酒因次韵共答 其一","author":"韩淲","text":"山中正苦风雨夕，送酒白衣何处来。\n洗盏开尝醒复醉，翠微堂上若人哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十五日昌甫斋中徐倅送酒因次韵共答 其二","author":"韩淲","text":"东游西汎秋凉后，深密正寻苔竹家。\n一段风流谁远饷，诗清应为煮芽茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵 其一","author":"韩淲","text":"指点苍茫句欲成，山中滋味水边情。\n须臾数点黄昏雨，更看弄云微月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵 其二","author":"韩淲","text":"晴霭分明是画成，淡容轻态最关情。\n鸟声不尽蝉声起，花影才收竹影生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵 其三","author":"韩淲","text":"雨熟西畴万宝成，新凉歌吹见人情。\n田家老瓦盆应在，打谷归来酒兴生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵 其四","author":"韩淲","text":"青入灵山玉削成，群峰罗列有心情。\n眼明忽卷孤城雨，风定白云浓淡生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵 其五","author":"韩淲","text":"桂树团团翠簇成，凉天佳月九秋情。\n根濡宿雨枝头润，细蕊传芳分外生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十八日云林用旧韵","author":"韩淲","text":"竹枝梅蕊映松林，不是年年著意深。\n君有清尊可无醉，春晴赢得看花阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵醮筵所书","author":"韩淲","text":"造物于人大有功，昭昭在上是玄穹。\n洞章定奏长生箓，勿药诚从一念通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐和卿小楼","author":"韩淲","text":"满窗风叶送新凉，人在红尘巷里藏。\n午坐岸巾初睡足，更呼茶椀净烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫论菊之结盘者无真意 其一","author":"韩淲","text":"丛生闲得把檀栾，岂待修治结束看。\n笑倒街头誇卖者，陶家真意已摧残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫论菊之结盘者无真意 其二","author":"韩淲","text":"秋来何物伴吾真，药菊甘香最可珍。\n见说缭潭人不老，肯随杂色斗时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题丁使君浮香亭尝招饮继有三绝次韵谢之 其一","author":"韩淲","text":"报政冰溪岁晚时，清心馀韵忽横枝。\n仙坛观上陵阳子，化鹤千年华表词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题丁使君浮香亭尝招饮继有三绝次韵谢之 其二","author":"韩淲","text":"雪后园林春已来，亭前花为醉翁开。\n暗香一阵知多少，徐步凌风索笑杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题丁使君浮香亭尝招饮继有三绝次韵谢之 其三","author":"韩淲","text":"名高二相虽陈迹，犹是官梅玉雪风。\n吟到金华侍臣语，不妨包括锦囊中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王寺簿所和昌甫句 其一","author":"韩淲","text":"常恨春浓不赋诗，诗成却怪得春迟。\n春风漫蹑登山屐，兴入青春若素期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王寺簿所和昌甫句 其二","author":"韩淲","text":"君侯锦绣作肝肠，句到江梅韵更芳。\n自要逢花试陶写，从教弄影与吹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王寺簿所和昌甫句 其三","author":"韩淲","text":"雅志东山事事宜，爱閒幽讨过桥时。\n世间儿女那能识，一段风流总是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宋倅所和 其一","author":"韩淲","text":"经年来往诵公诗，眼底虚名莫问迟。\n既见梅开且哦句，岁寒风度与心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宋倅所和 其二","author":"韩淲","text":"清愁花恼苦无觞，涧谷空吟野树芳。\n不分水流烟湿处，腊前年后扑人香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宋倅所和 其三","author":"韩淲","text":"雨收风外起晴丝，满地飘零积雪时。\n知道传呼有旌旆，行春无处著清诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蕙斛赠赵倅次韵谢其所赋 其一","author":"韩淲","text":"层华旖旎正关春，正苦无诗与写真。\n持送平分风月手，果题香草属幽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蕙斛赠赵倅次韵谢其所赋 其二","author":"韩淲","text":"光风转处影摇春，寂寂茅檐自养真。\n痛饮读骚纕且纫，应言憔悴昔何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵倅又和一绝许予过当再以前韵呈之","author":"韩淲","text":"健笔幽葩总是春，非公高韵孰全真。\n要知草野多凡卉，不过桐门无此人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李倅","author":"韩淲","text":"菊花虽已过重阳，犹有馀英可荐觞。\n黄白浅深知几种，要闻高论试平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将到章泉水赵成甫寄三绝来 其一","author":"韩淲","text":"共宿施村一夜霜，晓扶舆去路犹长。\n如今又到章泉水，准拟诗家旧债偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将到章泉水赵成甫寄三绝来 其二","author":"韩淲","text":"襄阳耆旧今谁记，祇有庞公在鹿门。\n白发江南两兄弟，瑞峰山翠锁深村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将到章泉水赵成甫寄三绝来 其三","author":"韩淲","text":"新居曾写碑千字，更觉閒情入老严。\n珍重主人留食炙，摩挲贞石我何廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏柬德久","author":"韩淲","text":"天与诗人月一轮，楼高偏照镜中尘。\n夜凉翠袖翩翩处，应问行藏独倚身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余伯皋过南剑兼寄郑伯明 其一","author":"韩淲","text":"南剑溪头黯淡滩，山城五月水声寒。\n凝香应更解悬榻，席上郑虔同此欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余伯皋过南剑兼寄郑伯明 其二","author":"韩淲","text":"往来涂路武夷边，无复人寻九曲船。\n我老君回向何许，故情前梦只依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"器远寄近诗季章兄弟唱和蟆颐江梅术皆其所也因题二绝寄答盖曹李同榜 其一","author":"韩淲","text":"蟆颐江水小罗浮，梅术花时踏雪游。\n五字七吟天一角，东南何处是皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"器远寄近诗季章兄弟唱和蟆颐江梅术皆其所也因题二绝寄答盖曹李同榜 其二","author":"韩淲","text":"三人唱第记曾看，往事流云话亦难。\n蜀道有诗犹寄我，才情何不溺儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用昌甫寄晁于潜诗韵寄之 其一","author":"韩淲","text":"相望于潜信宿中，为吟赵句忆坡翁。\n如今文物依然在，剩欲褰裳一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用昌甫寄晁于潜诗韵寄之 其二","author":"韩淲","text":"麈尾缘尘已一年，北关门外夜行船。\n萧萧秃发深秋影，心往形留只慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用昌甫寄晁于潜诗韵寄之 其三","author":"韩淲","text":"新凉吹到数行书，香入岩花麝不如。\n知我京华老无力，满壶清酒载勤渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄文叔 其一","author":"韩淲","text":"繁阴清影下黄鹂，想见虚堂昼寂时。\n试拨吏文危膝坐，篆香无与细风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄文叔 其二","author":"韩淲","text":"新辟书帏定自如，眼前纷列不关渠。\n陶公楮大从容处，酒薄囊悭还饭蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄文叔 其三","author":"韩淲","text":"雨散风生涧水鸣，倦扶藜杖看山行。\n故人正在乾封邑，何日唤之来耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十二日东阜寄南团闻待两夕而回 其一","author":"韩淲","text":"南团知道过乾封，得得村来语笑同。\n急雨颠风惭宿约，能留两夕见清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十二日东阜寄南团闻待两夕而回 其二","author":"韩淲","text":"相望春时又两年，深居山舍想幽便。\n故人生死惊零落，排遣寻歌付酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄吴子似","author":"韩淲","text":"云锦溪头玉石村，白蘋风起浪花痕。\n何时载酒寻诗去，醉弄扁舟倚树根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书寄牛孙","author":"韩淲","text":"含笑花开寄一枝，要来山里伴清诗。\n儿曹识取香浓处，全似人家酒熟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄抱朴君 其一","author":"韩淲","text":"曾约西林看木犀，望穷云外只空归。\n十年又见秋风好，未觉幽芳一梦非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄抱朴君 其二","author":"韩淲","text":"姜盖潘同看木犀，故交零落竟何之。\n如何花满西林树，犹有无怀可寄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄抱朴君 其三","author":"韩淲","text":"历历西林旧木犀，何如萍际素秋时。\n小楼曲角瓶簪处，花恼香魂只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圭山主送兰笋寻十年前旧诗韵用以寄之 其一","author":"韩淲","text":"幽兰新笋为谁来，想见山居一一栽。\n春日迟迟风淡淡，几番成竹几枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圭山主送兰笋寻十年前旧诗韵用以寄之 其二","author":"韩淲","text":"十年作别信多时，失喜寻思得旧诗。\n和韵且寻人寄与，不同香味两相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月十七日寄朴翁 其一","author":"韩淲","text":"葛岭人家抱朴翁，莺啼燕语正东风。\n帝城只在湖边畔，都付伤春病酒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月十七日寄朴翁 其二","author":"韩淲","text":"南屏山下小园东，便做迁居也不同。\n昨日晴和今日雨，幽怀何地不春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"走笔答上饶","author":"韩淲","text":"閒花羞对去年丛，君正青春我秃翁。\n夜来一阵催花雨，二十四番花信风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答赋赵路分","author":"韩淲","text":"麦气初生露气清，晚风吹得杜鹃声。\n山深尽自可萧散，道是无情如有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫梦中有句和韵答寄 其一","author":"韩淲","text":"灵府清寒梦境开，浑涵万状入诗来。\n章泉此老閒拈出，忽到窗前疑是梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]