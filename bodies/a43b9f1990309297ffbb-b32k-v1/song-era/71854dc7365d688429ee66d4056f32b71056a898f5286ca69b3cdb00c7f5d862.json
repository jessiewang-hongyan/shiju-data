llection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后登南禅茅亭简张仲谋二首 其二","author":"黄庭坚","text":"风入村墟摇酒旆，云埋行径罢樵苏。\n狐裘年少宜追猎，正有饥鹰待一呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后登南禅茅亭简张仲谋二首 其一","author":"黄庭坚","text":"雪后凭高望洛都，万峰遮眼白模糊。\n相将阆苑楼台上，展尽山阴水墨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸿沟","author":"黄庭坚","text":"英雄并世不相容，割据山川计亦穷。\n沟水已东全入汉，淮阴谁复议元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄几复自海上寄惠金液三十两且曰唯有德之士宜享将以排荡阴邪守卫真火幸不以凡物畜之戏答","author":"黄庭坚","text":"皱面黄须已一翁，樽前犹发少年红。\n金丹乞与烦真友，只恐无名帝籍中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄雀","author":"黄庭坚","text":"牛大垂天且割烹，细微黄雀莫贪生。\n头颅虽复行万里，犹和盐梅傅说羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"短韵奉乞腊梅","author":"黄庭坚","text":"卧云庄上残花笑，香似早梅开不迟。\n浅色春衫弄风日，遣来当为作新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禅句二首 其二","author":"黄庭坚","text":"予自钓鱼船上客，偶除须鬓著袈裟。\n佛祖位中留不住，夜来依旧宿芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禅句二首 其一","author":"黄庭坚","text":"牵驴饮江水，鼻吹波浪起。\n岸上蹄踏蹄，水中嘴对嘴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禅颂","author":"黄庭坚","text":"自古多如此，君今独奈何。\n可来白云里，教汝紫芝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗日","author":"黄庭坚","text":"叹息西窗过隙驹，微阳初至日光舒。\n□□□长宫中线，添得思堂一卷书。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答余洪范二首 其二","author":"黄庭坚","text":"悬磬斋厨数米炊，贫中气味更相思。\n可无昨日黄花酒，又是春风柳絮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答李任道谢分豆粥","author":"黄庭坚","text":"豆粥能驱晚瘴寒，与公同味更同餐。\n安知天上养贤鼎，且作山中煮菜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答雍熙光老颂","author":"黄庭坚","text":"独弄参军无鼓笛，右军池里泛渔舟。\n岂知剑外雍熙老，收得黄巢折剑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答檀君送含笑花颂","author":"黄庭坚","text":"檀郎惠我花含笑，借问凝情笑阿谁。\n一世茫茫走声利，阎公捉定始应知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人惠茶","author":"黄庭坚","text":"一规苍玉琢蜿蜒，藉有佳人锦段鲜。\n莫笑持归淮海去，为君重试大明泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人惠猫头笋","author":"黄庭坚","text":"长沙一月煨鞭笋，鹦鹉洲前人未知。\n走送烦公助汤饼，猫头突兀想穿篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢五开府番罗袄","author":"黄庭坚","text":"叠送香罗浅色衣，著来春色入书帷。\n到家慈母惊相问，为说王孙脱赠时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢公择舅分赐茶三首 其三","author":"黄庭坚","text":"细题叶字包青箬，割取丘郎春信来。\n拚洗一春汤饼睡，亦知清夜有蚊雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢公择舅分赐茶三首 其二","author":"黄庭坚","text":"文书满案惟生睡，梦里鸣鸠唤雨来。\n乞与降魔大圆镜，真成破柱作惊雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢公择舅分赐茶三首 其一","author":"黄庭坚","text":"外家新赐苍龙璧，北焙风烟天上来。\n明日蓬山破寒月，先甘和梦听春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢王子予送橄榄","author":"黄庭坚","text":"方怀味谏轩中果，忽见金盘橄榄来。\n想共馀甘有瓜葛，苦中真味晚方回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢王舍人剪送状元红","author":"黄庭坚","text":"清香拂袖剪来红，似绕名园晓露丛。\n欲作短章凭阿素，缓歌誇与落花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢应之","author":"黄庭坚","text":"昨夜风雷震海隅，天心急拟活焦枯。\n去年席上蛟龙语，未委先生记得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢张仲谋端午送巧作","author":"黄庭坚","text":"君家玉女从小见，闻道如今画不成。\n剪裁似借天女手，萱草石榴偏眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢杨景山送酒器","author":"黄庭坚","text":"杨君喜我梨花盏，却念初无注酒魁。\n矲矮金壶肯持送，挼莎残菊更传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢杨履道送银茄四首 其四","author":"黄庭坚","text":"畦丁收尽垂露实，叶底犹藏十二三。\n待得银包已成谷，更当乞种过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢杨履道送银茄四首 其三","author":"黄庭坚","text":"白金作颗非椎成，中有万粟嚼轻冰。\n戎州夏畦少蔬供，感君来饭在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢杨履道送银茄四首 其二","author":"黄庭坚","text":"君家水茄白银色，殊胜埧里紫彭亨。\n蜀人生疏不下箸，吾与北人俱眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢杨履道送银茄四首 其一","author":"黄庭坚","text":"藜藿盘中生精神，珍蔬长蒂色胜银。\n朝来盐醯饱滋味，已觉瓜瓠漫轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢陈正字送荔支三首 其三","author":"黄庭坚","text":"橄榄湾南远归客，烦将嘉果送蓬门。\n红衣襞积蛮烟润，白晒丁香之子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢陈正字送荔支三首 其二","author":"黄庭坚","text":"斋馀睡思生汤饼，红颗分甘惬下茶。\n如梦泊船甘柘雨，芭蕉林里有人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢陈正字送荔支三首 其一","author":"黄庭坚","text":"十年梨枣雪中看，想见江城荔子丹。\n赠我甘酸三百颗，稍知身作近南官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢周文之送猫儿","author":"黄庭坚","text":"养得狸奴立战功，将军细柳有家风。\n一箪未厌鱼餐薄，四壁当令鼠穴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢郑闳中惠高丽画扇二首 其二","author":"黄庭坚","text":"蘋汀游女能骑马，传道蛾眉画不如。\n宝扇真成集陈隼，史臣今得杀青书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢郑闳中惠高丽画扇二首 其一","author":"黄庭坚","text":"会稽内史三韩扇，分送黄门画省中。\n海外人烟来眼界，全胜博物注鱼虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢荣绪割獐见贻二首 其二","author":"黄庭坚","text":"二十馀年枯淡过，病来箸下剧甘肥。\n果然口腹为灾怪，梦去呼鹰雪打围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢荣绪割獐见贻二首 其一","author":"黄庭坚","text":"何处惊麇触祸机，烦君遣骑割鲜肥。\n秋来多病新开肉，粝饭寒菹得解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢荣绪惠贶鲜鲫","author":"黄庭坚","text":"偶思暖老庖玄鲫，公遣霜鳞贯柳来。\n齑臼方看金作屑，鲙盘已见雪成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢赵令载酒","author":"黄庭坚","text":"邂逅相将倒一壶，看朱成碧倩人扶。\n欲眠甚急须公去，能略陶潜醉后无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]