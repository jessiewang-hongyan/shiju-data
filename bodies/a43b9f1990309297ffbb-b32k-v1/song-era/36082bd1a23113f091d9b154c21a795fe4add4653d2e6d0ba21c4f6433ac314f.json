[{"title":"杂题六首 其二","author":"陆游","text":"莫笑花前白发新，宣和人醉庆元春。\n何时道路平如砥，却就清伊整幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题六首 其一","author":"陆游","text":"少谈王霸谋身拙，晚好诗骚学道疏。\n赖有一筹差自慰，闭门不作子公书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题四首 其三","author":"陆游","text":"野花红碧自争春，村酒酸甜也醉人。\n解放船头便千里，不愁无处著闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题六首 其三","author":"陆游","text":"羊裘老人只念归，安用星辰动紫微。\n洛阳城中市儿眼，情知不识钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题四首 其二","author":"陆游","text":"半饱半饥穷境界，知晴知雨病形骸。\n轩昂似鹤那求料，枯槁如僧不赴斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂题六首 其五","author":"陆游","text":"钓鱼吹笛本闲身，正坐微官白发新。\n著屐此生犹几緉，可令复踏九衢尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次朱元晦韵题严居厚溪庄图","author":"陆游","text":"鹤俸元知不疗穷，叶舟还入乱云中。\n溪庄直下秋千顷，赢