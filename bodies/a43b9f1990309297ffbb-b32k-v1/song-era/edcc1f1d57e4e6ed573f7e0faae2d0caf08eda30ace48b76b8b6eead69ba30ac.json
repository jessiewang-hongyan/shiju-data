[{"title":"醉蓬莱","author":"霍安人","text":"正朱明时候，院宇清和，庆逢佳节。\n梦应熊罴，尧蓂翻三叶，罗绮如云，寿杯争劝，竞起歌新阕。\n瑞气氤氲，祥云缭绕，玉炉频爇。\n溪室封功，几多勋业，首冠今朝，一时英杰。\n得配侯门，岂不惭疏拙。\n彩凤和鸣，早膺荣擢。\n增盛斑衣列。\n福禄无穷，年过卫武，辉光阀阅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题景吕堂","author":"霍权","text":"佞人巧求售，富贵一息顷。\n千古名不磨，寸心犹耿耿。\n伟哉正惠孙，疾恶何勇猛。\n平生历宦途，南台与东省。\n初著獬豸冠，排击首权倖。\n奸雄始萌檗，忠愤已骨鲠。\n一片忠义心，皦皦从簿领。\n涵养老益壮，大节兼晚景。\n若人久云亡，冰魂嗟已冷。\n羡慕徒驰神，反身盍三省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁饥太守春游呈以绝句","author":"霍洞","text":"朝来五马去寻春，谁信家家甑有尘。\n枕藉道傍宜细问，恐非芳草醉眠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿田舍","author":"霍洞","text":"北风吹晴屋满霜，翁儿赤体悲无裳。\n闺中幼妇饥欲泣，忍饥取麻灯下缉。\n一身勿暇私自怜，鸣机轧轧明窗前。\n织成五丈如霜布，翁作旋襕儿作裤。\n明朝官中租赋急，依然赤体当风立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"戴之邵","text":"愁绝江梅开岭岸，不知失脚到南塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 风前断笛","author":"戴山隐","text":"醉倚江楼，长空外、行云遥驻。\n甚凄凉孤吹，含商引羽。\n薄夜冷侵沙浦雁，老龙吟彻寒潭雨。\n蓦凉飙、一阵卷潮来，惊飞去。\n重欲听，知何处。\n谁为我，胡床据。\n谩寻寻觅觅，凝情如许。\n旧日山阳空有恨，杏花明月今谁赋。\n恐凭阑、人有爱梅心，空愁伫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓杭次族人催归诗韵","author":"戴飞","text":"休把诗来只管催，也曾对菊赋归来。\n闲云自笑出山去，未雨如何便得回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"戴仁杰","text":"水云应世地行仙，手抱琴书直到燕。\n万里沧江鸥浩荡，千年城郭鹤翩跹。\n履霜中野元无怨，齧雪阴山只自怜。\n今日相逢又相别，新诗满橐不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺杜清献入相 其一","author":"戴木","text":"玉陛传呼宰相来，欢腾海内翕如雷。\n律身清介祁公操，佐主谋谟如晦才。\n梦弼已知符众望，生贤益信应三台。\n从容宰席调天纪，协气从头遍九垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺杜清献入相 其二","author":"戴木","text":"相公出处系安危，当务何先谅熟思。\n守令近民须选择，憸壬蠹国亟芟夷。\n精蒐边面三军帅，早建皇储万世基。\n纳诲进贤尤素志，伫看经济大猷为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日田园杂兴三首 其三","author":"戴东老","text":"野花村酝赏清明，挑菜踏青鱼队行。\n禊水戏浮觞白羽，厨烟不禁饭黄精。\n田功宜早秧勤插，桑价方高茧告成。\n莫道犁锄忘学问，读书声间织机声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日田园杂兴三首 其二","author":"戴东老","text":"昨夜西郊雷隐鸣，金穰检历兆秋成。\n枪旗味向茶畦蓄，饼饵香从麦陇生。\n拂去梁尘招燕乳，拨开檐网看蜂营。\n谁家子女群喧笑，竞学卖花吟叫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答友人二首 其二","author":"戴仔","text":"说经蠡测海，且欲付家藏。\n难为越言雪，徒令鬓似霜。\n荷君心见许，顾我道非长。\n若肯嫔王内，当为时世装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答友人二首 其一","author":"戴仔","text":"著书非为进，岁久漫成编。\n道遇言非赘，身幽志自坚。\n种瓜新学圃，艺稻晚知田。\n吾事未多阙，衣裾莫浪褰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"戴仔","text":"尚想夷与齐，求仁无怨啧。\n谁传采薇音，荒哉太史笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送留云上人住翠屏澄照寺","author":"戴成祖","text":"云出于山复恋山，至今留住翠屏间。\n片云既被山留住，云自留山我自还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"戴孚中","text":"唐室未应嫌季晚，相为不朽有元颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海月岩","author":"戴应魁","text":"谁把巉岩巧凿开，分明幻出小蓬莱。\n风迎蜃气楼台起，浪涌蟾光宫阙来。\n海阔鱼龙自吞吐，云深鸾鹤共徘徊。\n禅师九座经游处，一访遗踪为拂埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌源阁","author":"戴应魁","text":"天风吹铃语不烦，菩提树杪碧阑干。\n恒河月满三千界，大树云栖五百尊。\n辟支脑现赤蛇死，玉局手泽苍苔乾。\n老僧出定蟠龙吼，唤醒诸寮佛子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐观星","author":"戴良齐","text":"中夜不能旦，浩荡思无期。\n茫茫宇宙间，俯仰伊何时。\n起坐凭前栏，粲粲天南垂。\n寒芒烛辰尾，岁德何所司。\n耿耿独无寐，坐观枢轮移。\n更筹忽五唱，空中闻子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄立斋二首 其二","author":"戴良齐","text":"蜚鸿时以南，蜚鸿时以北。\n翻翻堂上燕，来往逝安适。\n秋声来九天，星汉浩无极。\n岩岩北有斗，可望不可即。\n极望劳我心，梦想三太息。\n下有纵壑鳞，上有飞云翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄立斋二首 其一","author":"戴良齐","text":"玄云太山阿，倏忽起天际。\n悠哉复何心，适与飘风会。\n云间翔虬螭，蜿蟺炫五彩。\n万生方颙颙，岂但千里内。\n吾乡作者几，俯仰既千载。\n愿言慰斯人，名实施四海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次石屏翁韵","author":"戴龟朋","text":"走遍江湖早得名，归来哦句伺帏屏。\n故人今雨时相过，好酒新春肯独醒。\n未用阮生三语掾，但遵迂叟四言铭。\n高明已悟闲居福，当见于门发旧馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵侯之任","author":"戴雨耕","text":"送君远作羊荆州，送君西上黄鹤楼。\n汉晋诸公旧游处，断矶黄叶风雨秋。\n只今麾纛□南斗，整暇坐列皆公侯。\n江湖浩荡青天流，清风千古吹棹讴。\n专城分符得召杜，见此文彩珊瑚钩。\n请因谏议思岳阳，遂歌羽人仍丹丘。\n杜蘅吹香结衣佩，思与老子同遨游。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"戴复古","text":"醉来风帽半欹斜，几度他乡对菊花。\n最苦酒徒星散后，见人儿女倍思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入闽道中","author":"戴复古","text":"山中寂寞去程赊，莫惜频频到酒家。\n行李萧然还不倍，担头颠倒插梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中见梅","author":"戴复古","text":"踏破溪边一径苔，好山好竹少人来。\n有梅花处惜无酒，三嗅清香当一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山村 其二","author":"戴复古","text":"万竹稍头云气生，四风吹雨又吹晴。\n题诗未了下山去，一路吟声杂水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山村 其一","author":"戴复古","text":"山崦谁家绿树中，短墙半露石榴红。\n萧然门巷无人到，三两孙随白发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山村","author":"戴复古","text":"雨过山村六月凉，田田流水稻花香。\n松边一石平如榻，坐听风蝉送夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巾子山翠微阁","author":"戴复古","text":"双峰直上与天参，僧共白云栖一庵。\n今古诗人吟不尽，好山无数在江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋李漕冰壶燕集","author":"戴复古","text":"把酒冰壶接胜游，今年喜不负中秋。\n故人心似中秋月，肯为狂夫照白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事","author":"戴复古","text":"打鼓行船未有期，恰如江上阻风时。\n诗中一段闲公事，幸不妨人吃荔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"戴复古","text":"忆闻春燕语雕梁，又听秋鸿叫断肠。\n一缕沉烟飞不过，两楼相对立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见山居可喜","author":"戴复古","text":"一溪盘曲到阶除，四面青山画不如。\n脩竹罩门梅夹路，诗人居处野人居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东池","author":"戴复古","text":"来寻吾祖隐居处，袅袅春风吹酒旗。\n手把梅花寄愁绝，东池只是旧东池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至","author":"戴复古","text":"时光流转寻常事，世故惊心感慨多。\n一岁休祥在云气，今朝云气果如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁乡道上遇张伯声","author":"戴复古","text":"山禽调舌待春哢，江雨收声开晓晴。\n偶遇故人同杖履，梅花树下一诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汀州道上","author":"戴复古","text":"宇内何牢落，客行双鬓华。\n千山万山底，老眼付梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"买归舟篙子请占牌戏成口号","author":"戴复古","text":"诈称官职不如休，白板无题又可羞。\n只写江湖散人号，不然书作醉乡侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘子及赠瑞桂","author":"戴复古","text":"秋光点点明人眼，不比寻常岩桂花。\n天与刘郎作嘉瑞，枝枝金粟间丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同蕲州上官节推登光州增胜楼","author":"戴复古","text":"增胜楼中共倚栏，平原渺渺接青山。\n夕阳明处人烟少，胡马曾来闯五关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题诗藁","author":"戴复古","text":"冷澹篇章遇赏难，杜陵清瘦孟郊寒。\n黄金作纸珠排字，未必时人不喜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扬州端午呈赵帅","author":"戴复古","text":"榴花角黍斗时新，今日谁家不酒樽。\n堪笑江湖阻风客，却随蒿艾上朱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵卢申之正字野兴","author":"戴复古","text":"芋圃蔬畦接井湄，茅檐四面槿篱围。\n门前尽日无人过，牛渡横塘野鸭飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李伯高","author":"戴复古","text":"莲幕高吟冰雪篇，天才秀发思华年。\n千金买得惊人句，落在鸡林渡海船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谷口郑东子见寄 其四","author":"戴复古","text":"一生飘泊客途中，扶技从人类百工。\n白首归来入诗社，犹思渭北与江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谷口郑东子见寄 其五","author":"戴复古","text":"吾乡自昔诗人少，委羽先生后有翁。\n坐客无毡君莫笑，云台有集继家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谷口郑东子见寄 其三","author":"戴复古","text":"相看俱作白头翁，出处规模自不同。\n我走江湖作狂梦，君能面壁课成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谷口郑东子见寄 其二","author":"戴复古","text":"不管家居四壁空，琢成佳句有神工。\n谪仙会有金銮召，莫道诗人命不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谷口郑东子见寄 其六","author":"戴复古","text":"自笑诗人多好酒，君能不饮任樽空。\n劝君莫倚醒醒眼，却笑傍人醉面红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谷口郑东子见寄 其一","author":"戴复古","text":"闭门觅句饭牛翁，囊有新诗不怕穷。\n十里梅花生眼底，九峰山色满胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郭子秀晓行","author":"戴复古","text":"脱叶园林带晓鸦，马蹄步步踏霜华。\n山边水际频凝顾，怕有寒梅昨夜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江阴浮远堂","author":"戴复古","text":"横冈下瞰大江流，浮远堂前万里愁。\n最苦无山遮望眼，淮南极目尽神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江村晚眺二首 其二","author":"戴复古","text":"江头落日照平沙，潮退渔舠阁岸斜。\n白鸟一双临水立，见人惊起入芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江村晚眺二首 其一","author":"戴复古","text":"数点归鸦过别村，隔滩渔笛远相闻。\n菰蒲断岸潮痕湿，日落空江生白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观捕黄雀","author":"戴复古","text":"披绵争啄晚禾秋，决起森然网扼喉。\n一饱等闲输性命，知机万不及沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访友人家即事","author":"戴复古","text":"烂茅遮屋竹为床，口诵时文鬓已霜。\n妻病无钱供药物，自寻野草试单方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访旧","author":"戴复古","text":"欲寻西舍问东邻，两巷都非旧住人。\n唯有桑边石池在，依然春水碧粼粼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"严仪卿约李友山高与权酌别","author":"戴复古","text":"江天惨澹日凄凉，木未经霜叶未黄。\n今日楼头一杯酒，明朝行客在谁乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏","author":"戴复古","text":"等闲过了一年春，雨后风光夏景新。\n试把樱桃荐杯酒，欲将芍药赠何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏","author":"戴复古","text":"红紫光阴不久长，一声啼鴂静年芳。\n阴阴绿树黄鹂语，将与人间作夏凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别许季如","author":"戴复古","text":"久不相逢喜合簪，相从未久又分襟。\n扁舟自逐便风去，却恨无情江水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山马上","author":"戴复古","text":"青松路径白云关，有客来寻半日閒。\n十载灞桥驴子上，争如骑马看庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀家三首 其三","author":"戴复古","text":"三年寄百书，几书到我屋。\n昨夜梦中归，及见老妻哭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀家三首 其二","author":"戴复古","text":"强言不思家，对人作意气。\n惟有布被头，见我思家泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀家三首 其一","author":"戴复古","text":"白发出门来，三见梅花谢。\n客路有岁年，归心无昼夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李友山索诗卷汀州急递到昭武","author":"戴复古","text":"清时无事更年丰，两地风光诗咏中。\n可是山前无警报，旗铃千里递诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李敷文酌别席上口占","author":"戴复古","text":"客子明朝早问程，樽前今夜苦为情。\n使君亦恐伤离别，不使佳人唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村景","author":"戴复古","text":"箫鼓迎神赛社筵，藤枝摇曳打鞦韆。\n坐中翁妪鬓如雪，也把山花插满颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到南昌呈宋愿父伯仲黄子鲁诸丈 其一","author":"戴复古","text":"一秋无便寄平安，新雁声声报早寒。\n昨夜检衣开故箧，去年家信把来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到南昌呈宋愿父伯仲黄子鲁诸丈 其二","author":"戴复古","text":"扁舟几度到南昌，东望家山道路长。\n醉里不知身是客，故人多处亦吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周子益年八十赴殿 其一","author":"戴复古","text":"七尺渔竿八十翁，钓丝轻袅荻花风。\n功名未遂英雄老，人道磻溪即个中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]