[{"title":"西峰院","author":"陈轩","text":"扪萝百尺上孤峰，红藓斑斑杖屦踪。\n惟有潮声生绝顶，晚风吹动半岩松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙春堂","author":"陈轩","text":"楼上斜阳遇似飞，楼前秋景透人衣。\n横碧烟岚浓可扫，半红霜木冷相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汀州旧州城","author":"陈轩","text":"五百年前兴废事，至今人号旧州城。\n草铺昔日笙歌地，云满当年剑戟营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞僧宗佑真","author":"陈轩","text":"不是十二面，虚堂空寂寂。\n不是一千年，丛林声呖呖。\n奇哉丹青者，具增减不得。\n珍重四方闻，一介善知识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题蓬莱观","author":"陈轩","text":"蓬莱观下瑞烟飘，刘氏曾经此地超。\n桃圃昔谐王母约，烟霄自赴玉皇朝。\n白鹅乘去人何在，青鸟飞来信已遥。\n若使何郎有仙骨，也须吹引凤凰箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上竺寺记赞","author":"陈轩","text":"白衣仙人无住著，补陀落伽渺云海。\n为大导师安乐国，歙然遍应河沙刹。\n世界热恼或有闻，曾不旋踵垂覆护。\n众生心念非一种，皇皇不足尝有求。\n如饥须食渴须水，顾亦何从满其愿。\n我观圣心等大虚，其视万物犹一物，细视一物如一身。\n是身四大犹不有，万物何能作留碍。\n殊功妙用济十方，欲求功用不可得。\n群生梦幻可两忘，尔固无馀我无欠。\n尝观瑞像见宝光，如净明珠时白赤。\n琉璃琥珀杂苍玉，荧煌璀璨照眉宇。\n山顶或见初日升，匹素曳空烟缥缈。\n凡人颠倒作思惟，须臾变灭无复初。\n非空非色非有馀，菩萨应身亦如是。\n堂堂秘殿表东南，山君海王尽回向。\n观音智功不思议，佛子当作何等观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题志添禅师","author":"陈轩","text":"车轮马足走尘烟，竞看成都万炬然。\n独我踏开亭下雪，伴师同坐一庵禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陈轩","text":"插尽黄花君上路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈轩","text":"门阚泉川南海浦，地雄都府左龙岗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"陈轩","text":"山连庾岭为南徼，水与潮阳作上流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"陈轩","text":"巨为三县镇，雄据众山尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"陈轩","text":"寒树似添新喜色，野猿犹听旧吟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"陈轩","text":"十万人家溪两岸，绿杨烟锁济川桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"陈轩","text":"渡溪缘石磴，问寺转松岗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"陈轩","text":"奇哉江南郭夫子，一顾能令泉价美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"陈轩","text":"溪云影乱杉松暝，檐铎声流殿阎寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十","author":"陈轩","text":"清风猿鸟自吟叹，白日轮蹄谁往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十一","author":"陈轩","text":"云边借榻开僧阎，松下听泉洗客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"陈轩","text":"涨水尽头飞雁骛，行云缺处见亭台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十三","author":"陈轩","text":"尘埃不到溪山好，风雨初晴燕雀多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十四","author":"陈轩","text":"南安岩近南斗傍，乾坤缔结雷电守。\n云寒木老洞穴古，巨鳖露脊鲸牙口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十五","author":"陈轩","text":"相看竺国两高士，对立剑潭双老龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十六","author":"陈轩","text":"南极星边人望阙，北山楼上客思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十七","author":"陈轩","text":"水暖池塘闲睡鸭，烟深村落自鸣鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"陈轩","text":"对面心千里，藏机势万般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢王介甫见寄","author":"周衮","text":"萧萧秋鬓衰，谁复到荒郊。\n海内文章伯，平生道义交。\n学须明体用，诗许定推敲。\n但共馀年醉，何妨作解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早发湖口宿道傍山寺","author":"周衮","text":"寂寂山中寺，萧萧月下庭。\n烟云晴自散，松桧老还青。\n地僻堪藏拙，僧闲不诵经。\n我来非有意，乘兴寄疏棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"簪屣","author":"周邠","text":"堂上歌声想遏云，玉人休整碧纱裙。\n妆残粉落胭脂晕，饮剧杯深琥珀纹。\n簪屣定知高楚客，笑谈应好却秦军。\n莫辞上马玉山倒，已是迟留至夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窃闻子瞻学士昨日飘然单乘独出南屏旋至北山穷幽览胜真得物外自适之趣邠尝从欧阳公诗云使君厌骑从车马留山前行歌招野叟共步青林间然明公今日之乐正得于此因成诗一章上寄","author":"周邠","text":"放归绉骑独寻山，直入青萝翠蔼间。\n谢客藜杖方自适，阮公蜡屐许谁攀。\n何愁白发能添老，须信黄金不买闲。\n应向林泉真得趣，徜徉终日未经还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋","author":"周邠","text":"月华圆满正秋中，天上人间此夕同。\n桂魄十分澄浪海，冰轮千里碾霜空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月","author":"周邠","text":"落照西山夜色浮，弯弯寒挂碧云头。\n宝奁新样横眉黛，珠箔斜悬半额钩。\n丹桂一枝初浅露，金波千里未圆流。\n婵娟三五才成魄，散满清光四百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访慧山钱道人不遇","author":"周邠","text":"登山穿破乱云堆，不见高人眼倦开。\n门掩水声闲白日，路无车迹长苍苔。\n墙头五柳空摇曳，池上双凫自往来。\n却棹扁舟自回去，过江思上子陵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"羞墓诗","author":"周邠","text":"当年一弃会稽侯，大墓烟芜锁别愁。\n惆怅不逢郎衣锦，至今粉骨尚含羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"箫台山","author":"周邠","text":"簇簇峰峦遍四围，神仙旧隐叹今非。\n溪中不见金沙出，山外空惊白鹤飞。\n石上瀑泉清照眼，竹间岚气冷侵衣。\n王箫声断人何处，千古烟云锁翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白石山 其一","author":"周邠","text":"赏遍他山到此山，始知仙境异人寰。\n岩前羽客寻黄鹤，涧下樵人放白鹇。\n路入洞门纡五锁，云盘石径叠三关。\n窑间犹有仙翁灶，忆昔丹成炼九还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白石山 其二","author":"周邠","text":"登山踏遍万千峰，直到青云第一重。\n路僻频惊来瑞鹿，洞深还见挂苍龙。\n偶穿白石寻黄石，却倚青松慕赤松。\n日脚西垂促归兴，巾车无复更从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云岩禅寺","author":"周邠","text":"石城岭下白莲宫，天柱峰前碧玉丛。\n误入蓬瀛知有路，回看图画恨无功。\n平霞列嶂堆苍黛，飞瀑寒岩挂断虹。\n眼底更无尘一点，霅川休说水帘宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净名院 其一","author":"周邠","text":"水帘谷口瀑泉飞，金鼎峰前玉骨奇。\n入院未登居士榻，升堂先谒赞皇祠。\n庵开明月长圆满，路插重云半崄巇。\n杖屦偶来聊宴坐，徘徊不厌出山迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净名院 其二","author":"周邠","text":"净名庵畔水帘谷，万仞苍崖漱寒玉。\n布衣如帘窣地垂，更有莺声如度曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集真观","author":"周邠","text":"珍重开山李道人，林峦奇秀甲诸邻。\n夺将狐兔千年穴，化作寒泉一境春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白石洞天","author":"周邠","text":"此境曾闻父老传，顷无凡迹到岩颠。\n青霄咫尺不多地，碧洞深沉第几天。\n千古烟霞真胜境，一方水石最清渊。\n我行聊慰登临兴，着意来游已四年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"周邠","text":"小杜池边暂舣舟，老齐山下共寻幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"周邠","text":"泗水西来一带长，望中烟浪似吾乡。\n云收雁塔初晴影，月照龟山午夜光。\n沿汴晓穿榆荚影，过淮时嗅稻苗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"周邠","text":"候得南枝腊后芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江亭","author":"周邠","text":"沧波水上巅崔嵬，中有幽亭向水开。\n草色直连天色远，风声长送浪声来。\n云收山脚鸡园见，潮满航头钓艇回。\n咫尺市廛尘不到，槛前鸥鸟自毰毸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"周邠","text":"怪石参差蹲虎兕，乱峰重叠走龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花诗问答 其一","author":"杨处厚","text":"问篱菊，谁遗金英秋始缛。\n花枝依旧去年黄，人发不如当日绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花诗问答 其二","author":"杨处厚","text":"篱菊答，清香数日还飘飒。\n纵使人生鬓易华，犹见黄花开几匝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"杨处厚","text":"回望乡关在何处，更闻杜宇转凝魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨霁剡溪","author":"颜复","text":"剡溪风雨霁，航苇重行行。\n到处杨柳色，几家荷叶声。\n噪蝉金鼎沸，游水玉壶清。\n最喜鱼梁伴，归帆的的轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄云门运禅师","author":"颜复","text":"句溪曲曲剡山重，谁访桑门物外踪。\n超世有言皆实际，示人无意在机锋。\n平生怀抱佳高遁，壮岁衣冠锁俗容。\n每想清蝉心暂寂，秋声萧瑟夜庵松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再寄云门运禅师","author":"颜复","text":"云门山巅樱叶青，云门山脚阴溪鸣。\n山翁毁服惧世荣，大心圆静无能名。\n松间一饭养槁形，石壁几见秋苔生，爱山不免搜其情。\n缀拾短阕成长行，施子传来奇可惊。\n爽阔空谷天外声，高风摆荡疑茎英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调王辟之","author":"黄廉","text":"高唐不是那高唐，风物由来各异乡。\n若向此中求梦雨，只应愁杀楚襄王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝学","author":"黄廉","text":"河东人物气劲豪，泽州学者如牛毛。\n大家子弟弄文墨，其次亦复誇弓刀。\n去年校射九百人，五十八人同赐袍。\n今年两科取进士，十子钓海顿灵鳌。\n迩来习俗益迁善，家家门户争相高。\n驱儿市上买书读，宁使田间禾不薅。\n我因行县饱闻见，访问终日忘勤劳。\n太平父老知此否，语汝圣世今难遭。\n欲令王民尽知教，先自乡里蒸群髦。\n古云将相本无种，从今著意鞭儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题洪庆观","author":"黄廉","text":"隔岸山如戏狮子，背看松林闲掉尾。\n天际苍茫落数峰，青虬下饮黄河水。\n洪涛日夜洗崖脚，容易沙洲忽生嘴。\n浮岚积霭增气象，因抱汤城来迤逦。\n圣世封疆属乡县，令宰衙门对山起。\n朝看片云浮檐栋，暮雨逡巡周百里。\n可怜居民老苍翠，未省劳生有尘滓。\n乘轺亦复愧斯人，特地邮亭解行李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过灵泉寺 其一","author":"黄廉","text":"乌噪僧眠春昼迟，松阴楼殿日高时。\n入门未脱征裘立，拂壁先看学士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过灵泉寺 其二","author":"黄廉","text":"六年道路三经此，山色泉声似故人。\n惭愧老僧相慰问，官郎何事过门频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过灵泉寺 其三","author":"黄廉","text":"瘦马行行不著鞭，一逢泉石便留连。\n每来无可相求索，只是松窗借榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过灵泉寺 其四","author":"黄廉","text":"揽胜寻幽本为闲，可能忙里去游山。\n权宜且辍公家事，看遍林泉夜始还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石潭院次蟾禅师韵","author":"黄廉","text":"一钵谁知去住空，前朝遗事寄禅宫。\n孤吟盘礴数行墨，古韵萧条四壁风。\n游客落帆频上下，荒庭疏树几青红。\n有人会得诗中趣，日月由来亦转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"黄廉","text":"眉间见喜气，行人有归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓舍人读之罘碑二十韵","author":"韦骧","text":"之罘之碑何所刻，昔者秦人纪秦德。\n风锼日铄断璞昏，雨暴冰残老龟坼。\n微芒遗字三四行，容易历年千五百。\n文词事实可考求，赖有子长修简策。\n始皇末年气益矜，轻视天下夸功名。\n玉墀金户厌宫殿，不远万里为游行。\n鼓钟帷帐不移徙，所至毫发皆如情。\n温寒凊暑回造化，绝深度险安经营。\n徐市卢生巧窥测，浪语神仙致君惑。\n东巡亟欲见三山，从此海壖来辙迹。\n神仙杳邈不可攀，六龙回首沧波碧。\n从臣无以慰踌躇，请陈勋业刊诸石。\n高文大句如形容，将以荣耀传无穷。\n银钩玉箸勒未久，变故恍惚如飘风。\n人心恚望鬼神怒，滈池神怪俄符同。\n祸秦非胡日在国，长城未毕咸阳空。\n空遗此石苍崖里，万古悠悠辨终始。\n虽然篆刻半缺讹，至今不得藏虚美。\n世人往往爱瑰奇，蜡泽松烟印之纸。\n览观莫不哀所为，岂独玩焉而已矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送皮献臣郎中赴河朔","author":"韦骧","text":"明公器业真无敌，术学精深贯今昔。\n胸中应变勇所为，韬养许谁窥畛域。\n立朝壮齿名已高，君相都俞采风迹。\n擢从畿邑超等伦，寘之计府凭宣力。\n古来才盛多见排，议论波涛起寻尺。\n剖符江表虽左迁，愤恤何尝动颜色。\n惟思补报诚益勤，奚翅循墙惊宠锡。\n锄奸整敝皆得要，百事详求不容隙。\n宜阳编户十万馀，疲瘵弥年逢药石。\n旄倪爱戴忧公去，口颂心祈继朝夕。\n除书忽尔天上来，借寇无缘徒怅惜。\n汝曹固恨夺慈父，上意其如念河北。\n河北近罹灾变深，垫溺之馀病艰食。\n经营调度难其任，正是庙堂精选择。\n此时委寄非平时，贤者岂辞当远适。\n长川六月风云爽，苒苒双旌标画鹢。\n送行拥岸车马稠，恋德尤多泪沾臆。\n袁民慎勿挽公舟，蚤看公归广膏泽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观劈石","author":"韦骧","text":"篮舆远冒西山色，宛转羊肠踏寒碧。\n岩涯深处屡腾声，何事晴云多霹雳。\n寻声迤逦过枯林，始见群工劈山石。\n斧斤锋刃奚足云，铁楔纵横乃为力。\n随文察理以段致，大或寻常小盈尺。\n心冥手应出自然，不啻庖丁操騞砉。\n问其勤苦将胡为，驱车运致希酬直。\n牛山濯濯罹采伐，萌蘖悄如无夜息。\n此山遭值甚牛山，攻击何年可终极。\n石顽人智其奈何，智巧反为天地贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和残腊幽谷西游适","author":"韦骧","text":"晴光泛泛山之阿，谷禽朝飞声已和。\n溪面冰消玉沙活，临溪逆想春风过。\n忽来忽往祇随兴，驺从屏寘殊无多。\n略挽梅梢数纤蕊，后日重来添几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋金橘得曲字","author":"韦骧","text":"结根长江左，移植清流曲。\n朝晖敛夜霜，香苞间寒绿。\n落落黄金丸，堆盘照明玉。\n远想洞庭姿，宜惭风韵俗。\n咀嚼聊一评，嗜甘毋见辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即席","author":"韦骧","text":"金炉兽燄回春律，碧盏蚁花资野逸。\n腊枝剪断玉莲光，歌扇舞茵争秀出。\n主人醉宾宾醉德，倾兀不惭冠武侧。\n一时陈迹去莫追，此段清欢宁易得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复用前韵谢和鄙篇以送行县","author":"韦骧","text":"耐冲晓雾狐裘密，乱踏寒霜马蹄逸。\n遍行属邑敢惮劳，乐岁偿逋民易出。\n云间想恋双旌色，跋辔长坡首频侧。\n更怀珍句重见酬，一颗骊珠探颔得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]