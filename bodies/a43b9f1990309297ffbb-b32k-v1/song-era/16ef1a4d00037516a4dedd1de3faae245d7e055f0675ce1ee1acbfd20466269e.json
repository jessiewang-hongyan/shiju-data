[{"title":"句 其一","author":"王安中","text":"凤鞋微露绣帮相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"王安中","text":"后人谁促渔阳战，旧守犹迁象郡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"王安中","text":"不见牛医黄叔度，即寻马磨许文休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"王安中","text":"浮云事有千端异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"王安中","text":"不论与汝小一月，政自容君数百人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"王安中","text":"桃花春有信，结子遍昭阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其七","author":"王安中","text":"来踏三湘雪，归迎八桂秋。\n未过盘石寺，先憩訾家洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其八","author":"王安中","text":"疏星残月漾中流，黄鹤楼前鹦鹉洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其九","author":"王安中","text":"云山连楚塞，夏木暗随城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十","author":"王安中","text":"汉东老人家壁立，随行只有渊明集。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十一","author":"王安中","text":"忘情汉东客，行脚水南禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十二","author":"王安中","text":"随州九十九重山，安得乡人住此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十三","author":"王安中","text":"随岗百欠一，陆产万不一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十四","author":"王安中","text":"谁料此行逾溠水，吾能未到说随州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十五","author":"王安中","text":"八桂西南天一握，重江今古水双流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十六","author":"王安中","text":"来踏三湘雪，归回八桂秋。\n人忘五岭热，山似九华尤。\n日月通南极，星河带北流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十七","author":"王安中","text":"山川为公来，先已流瘴疠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十八","author":"王安中","text":"江山似慰天涯客，花卉先回岭北春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十九","author":"王安中","text":"宦游梅岭外，讼诉榕庭空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"赵煦","text":"周绍裕陵尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宴延和楼即事","author":"赵良嗣","text":"建国旧碑朝日暗，兴王故地野风乾。\n回头笑谓王公子，骑马随军过五銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻王师入燕","author":"赵良嗣","text":"朔风吹雪下鸡山，烛暗穹庐夜色寒。\n闻道燕山好消息，晓来驿骑报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同舍弟泛舟西湖登昼锦堂步至紫翠亭望懒堂景物怀故龙舒先生","author":"王庭秀","text":"城中十顷湖，云水相演漾。\n春风破冰谷，拍岸新流涨。\n平铺鸭头绿，澹沲葡萄酿。\n朱甍媚孤屿，梵宇丽相向。\n万瓦生清晖，千花联锦帐。\n晨曦照炯炯，芳气浮泱泱。\n日暮姿态妍，烟霞渺空旷。\n谁将水仙镜，聊借诗人仗。\n卧护五羊城，追怀老诗将。\n微吟示清野，鏖战得闲放。\n变化无端倪，虚无落名状。\n坐令湖上景，胜绝神宇王。\n当时经行地，藻丽随屦杖。\n斯人今则亡，物色亦摧丧。\n它年牛马走，曾拜丈人行。\n尘埃久漂泊，岁月成漫浪。\n问讯懒堂居，","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五峰寺","author":"王庭秀","text":"度崦得幽胜，遵溪步横斜。\n哀湍泻曲折，虬枝老蟠拿。\n危然五峰高，突兀凌晨霞。\n若有神物护，遗此瞿昙家。\n何年老苾刍，巾钵寄枯槎。\n乳麀馈朝供，野禽或衔花。\n尔来三百年，拓址夷谽谺。\n缔架俯层巘，栋宇日就奢。\n古殿仪像设，栖云拥栏牙。\n董修奉檀施，钟鼓惊麇䴥。\n中有无尽灯，赓续岁踰赊。\n大千破幽暗，照了无等差。\n逢禅颇修洁，悃愊初无华。\n十年坐空谷，日月绝纤瑕。\n运水及搬柴，为罪作生涯。\n前山逢老妇，试问赵家茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自誓","author":"魏行可","text":"万里心驰怀故国，千行泪洒望行宫。\n孤臣不死忠诚在，为报无忘此犬戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"章之邵","text":"云山犬吠声相答，野水禽飞影自随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈佛眼","author":"释法顺","text":"顶有异峰云冉冉，源无别派水泠泠。\n游山未到山穷处，终被青山碍眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈五首 其一","author":"释法顺","text":"好事堆堆叠叠来，不须造作与安排。\n落林黄叶水推去，横谷白云风卷回。\n寒雁一声情念断，霜钟才动我山摧。\n白杨更有过人处，尽夜寒炉拨死灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈五首 其二","author":"释法顺","text":"我手何似佛手，天上南星北斗。\n我脚何似驴脚，往事都来忘却。\n人人尽有生缘，个个足方顶圆。\n大愚滩头立处，孤月影射深湾。\n会不得，见还难，一曲渔歌过远滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈五首 其三","author":"释法顺","text":"鸡啼晓月，狗吠枯椿。\n只可默会，难入思量。\n看不见处，动地放光。\n说不到处，天地玄黄。\n抚城尺六状纸，元来出在清江。\n分明话出人难见，昨夜三更月到窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈五首 其四","author":"释法顺","text":"风吹茆茨屋脊漏，雨打阇黎眼睛湿。\n凭么分明却不知，却来这里低头立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈五首 其五","author":"释法顺","text":"久病未尝推木枕，人来多是问如何。\n山僧据问随缘对，窗外黄鹂口更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仆雪中偈","author":"释法顺","text":"垂老住山寺，参官走道途。\n前村雪岭上，颠倒没人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释世奇","text":"梦中闻版响，觉后虾蟆啼。\n虾蟆与版响，山岳一时齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临终偈","author":"释世奇","text":"诸法空故我心空，我心空故诸法同。\n诸法我心无别体，只在而今一念中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋米芾海岳庵","author":"翟汝文","text":"楚米仙人好楼居，植桐崇冈结精庐。\n下瞰赤县宾蟾乌，东西跳丸天驰驱。\n腹藏万卷胸垂胡，论古如河决九渠。\n掀髯送目转八区，欲叫虞舜起苍梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北固山","author":"翟汝文","text":"山形郁长虬，掉尾趋平川。\n回峰耸赑屃，广殿凌云巅。\n登临望八极，天盖垂空元。\n鸿濛一气乱，鬼物半涂颠。\n天风河汉响，户牖斗柄悬。\n黄图昔散漫，赤伏竟沮迁。\n凄凉霸气歇，徙倚平台骞。\n山川宛如昔，独为骚人妍。\n江声战九地，幽愤为谁湔。\n晴雷殷列缺，电火搜蜿蜒。\n矞皇故代物，猛炽随飞烟。\n僧繇六花佛，生面行差肩。\n铢衣类帝网，肉髻浮青莲。\n巍峨开元帝，玉座犹高悬。\n奋迅陆子画，青■戏芝田。\n萧梁遗巨镬，仿佛像奸镌。\n赞皇艺两柏，郁屈蛟龙缠。\n空焚荡灰劫，涕视悲人天。\n铿铿斧斤初，千柱欻修椽。\n苍头封草树，佳气封云泉。\n孤标危塔涌，迥佛层阴坚。\n溟翻塔影倒，天转磨蚁旋。\n咨嗟一弹指，悲悟三生缘。\n有生甚脆弱，膏火消烦煎。\n喟彼昔夸夺，修罗搆戈鋋。\n吾将声洪钟，须弥叫金仙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"翟汝文","text":"青女霜如失，黄人日故迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"吕拭","text":"松竹初栽未靓深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题清心堂","author":"赵资道","text":"燕坐都忘俗虑萦，小桥横截跨幽亭。\n涟漪池面银开鉴，筱荡庭心玉展屏。\n桃李并蹊春竞丽，桧松分径岁长青。\n我来每觉尘心豁，客至还同醉眼醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题劲节堂","author":"赵资道","text":"为爱青青竹一林，旋开庭宇占清阴。\n风前萧瑟声敲五，月下玲珑影碎金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪阳洞","author":"柳交","text":"洞口春归草木长，洞中流水薜萝香。\n真仙鹤驭今何处，应共白云朝帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"江炜","text":"斗草事空犹昨日，惜花心在又明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"朱升","text":"半坞烟霞金世界，一堂风月玉壶秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资州 其一","author":"宋京","text":"江山不负人，入眼四时新。\n古寺岩为屋，危峰竹是邻。\n从来潇洒地，今日自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资州 其二","author":"宋京","text":"箫鼓旌旗簇锦鞯，路人遥指翠微闲。\n使君乘兴同民乐，猿鹤无心不碍闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武担","author":"宋京","text":"君不见蜀王妃子墓突兀，成都城中若山积。\n墓头寒镜涩无光，妒月欺烟化为石。\n鸿荒无根凭野史，直谓山妖化妃子。\n临终未免怀首丘，运土山中葬于此。\n山名武担锦江边，用是得名千万年。\n如今佛阁倚空翠，老木盘郁摩苍天。\n晴云入穴西山出，捲帘坐见岚光滴。\n拨得文如汲冢书，免使后人疑往昔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟化","author":"宋京","text":"君不见秦时张仪筑少城，土恶易败还颠倾。\n力疲智竭筑未就，神龟为尔开其灵。\n龟行所至城不圮，板筑之功以此已。\n功成隐去智且贤，城下于今祗流水。\n殷勤高谢余且网，不梦元君宁自放。\n仪兮仪兮奈尔何，口舌纵横饰欺妄。\n天使神龟笼尔术，不言而行功自毕。\n安得人灵若尔灵，照见百为心遐逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼殿","author":"宋京","text":"君不见汉人制作礼殿存，法度严广分卑尊。\n祇今年数不可考，列画古帝丹青昏。\n晋人遗书刻柱边，字划刓决骨气全。\n衣冠真不异阙里，事业直笑铭燕然。\n锵锵似有环佩声，七十二子罗簪缨。\n闭藏浊世如有待，开眼今日观文明。\n陈仓石鼓归辟雍，大成门阀何穹崇。\n安得貌取礼殿制，太学西有宣尼宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石室","author":"宋京","text":"君不见西汉文翁为蜀守，蜀学不居齐鲁后。\n诸生竞欲保翁名，石室镌磨贵难朽。\n东汉高公又几时，为作石室还如兹。\n至今二室坚且久，文公高公名不衰。\n世间可传唯铁石，石终可泐铁终蚀。\n古人好事留其名，石室存亡竟何益。\n汉水沉碑知在不，叔子名存空岘首。\n安得眼看石室销，要知二子名终有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉局","author":"宋京","text":"君不见青阳老人飞下天，口宣至道朝群仙。\n地中神人捧玉局，异事秘怪于今传。\n龟城坤隅地有穴，俗说西与岷山连。\n嵯峨古观森伟像，老柏惨澹含风烟。\n令威已去城郭在，人物自改名依然。\n亳州宫庭焕星斗，真皇行幸祥符年。\n所托得地近京邑，此独隐晦遐方偏。\n安得老人洗此心，还我澹泊同古先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严真","author":"宋京","text":"君不得庄遵卖卜成都市，市中仙隐无人值。\n百钱度日复何求，犹有沉真见文字。\n不因问着牛女星，下士安能知姓名。\n云中鸡犬拔家去，旧宅寂寞秋芜平。\n榰机石在年年长，药鼎空留闭黄壤。\n前时发掘篆籀新，明水神丹光滉瀁。\n金雁桥边台观存，神仙遗事渺难论。\n安从师先生为我卜，俗骨庶可遗天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琴台","author":"宋京","text":"君不见成都郭西有琴台，长卿遗迹埋黄埃。\n千年乃为狐兔窟，化作佛庙空崔嵬。\n黄须老人犹记得，昔时荒破樵苏入。\n锄犁畏浅牛脚匀，古瓮耕开数逾十。\n乃知昔人用意深，瓮下取声元为琴。\n人琴不见瓮已掘，唯有鸟雀来悲吟。\n一朝风流随手尽，况复千年何所讯。\n安得雄辞吊汝魂，寂寞秋芜耿寒燐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"墨池","author":"宋京","text":"君不见子云草玄西郭门，一径秋草间朝昏。\n何须笔冢高百尺，池墨黯黯今犹存。\n童乌侯巴竟零落，玄学无人终寂寞。\n汉家执戟知几年，垂老身没天禄阁。\n俗儿纷纷重刘向，思苦言艰动嘲谤。\n汉已中天雄亦亡，不较空文从覆酱。\n如今却作给孤园，吐凤亭前池水寒。\n安得斯人尚可作，会有奇字令君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书台","author":"宋京","text":"君不见孔明书台遗庙旁，古书不见台荒凉。\n卧龙未起蜀天远，茅庐日日空南阳。\n赤符光寒白水涸，秣陵王气犹能作。\n璋若婴儿操虎狼，脱去荆州殊不恶。\n十倍奇才安用书，此台昔时知有无。\n蜀人思君识古处，未若江水存兵图。\n黄冠所居门第改，祇有坊名今尚在。\n安得台边见古人，秋草重生类书带。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草堂","author":"宋京","text":"君不见少陵草堂背西郭，浣花溪水流堂脚。\n竹寒沙白自凄凉，莫问四松霜草薄。\n入门好在乌皮几，公去不归换邻里。\n西岭千秋雪书消，舍北泥融飞燕子。\n祇今桤木平桥路，笼竹和烟杂江雾。\n野僧作屋号草堂，不是柴门旧时处。\n诗坛今古谁能将，艳艳文章光万丈。\n安得英才擅品量，当使公居摩诘上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题周文王庙 其一","author":"宋京","text":"征西将帅念君王，刻石巴山事渺茫。\n□载衣冠付冥寞，路人无语奠椒浆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题周文王庙 其二","author":"宋京","text":"典章文物一朝完，有子何忧霸业难。\n□使阿坚生肉角，至今遗恨碧峰寒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登尚清阁二首 其一","author":"宋京","text":"望断秦原日月宽，西来泾渭侧依山。\n凭谁唤取王摩诘，写到孤鸿灭没间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登尚清阁二首 其二","author":"宋京","text":"辇路名存迹已陈，斜阳今作几家村。\n缭墙月转华清梦，来破高陵渡口昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"京请郡得豳取道渭上观为命□诗刻次韵奉呈□□奉议公 其一","author":"宋京","text":"金节逶迤去不还，罗胸星斗焕秦天。\n白云拱木今何在，岁月声名相与延。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"京请郡得豳取道渭上观为命□诗刻次韵奉呈□□奉议公 其二","author":"宋京","text":"乞守初来到渭滨，玻瓈亲为拂诗尘。\n□江集里新添得，留取钟评付后人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大观庚寅冬游资州北岩","author":"宋京","text":"资州城郭云山里，北岩正在云山底。\n翠壁嵌空抱日明，飞阁横斜矗天起。\n游人祇解爱城郭，不知山底幽人乐。\n六月全无暑气生，三冬亦有林花落。\n苍楠卧月影如轮，乳泉溅瀑波生鳞。\n利名付与百忙者，早晚自由无事身。\n红莲幕下青城客，五斗留人归未得。\n衙回不用展山图，直到岩边看秋色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"宋京","text":"云生毡帽山头雨，日落琵琶峡口风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"宋京","text":"野性乐闲适，我州富佳山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"宋京","text":"日约绣绷长一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏刘伶","author":"龚况","text":"逃名以酒转名高，醉里张髯骂二豪。\n日月已为吾户牖，何妨东海作醇醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日 其一","author":"龚况","text":"家家高会锦模糊，谁信贫家菊也无。\n多谢东邻送醅至，旋于篱畔觅茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日 其二","author":"龚况","text":"自古谁无九日诗，诗成须道菊花枝。\n直饶无菊何妨醉，野蓼村葵总是题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]