[{"title":"偶题三首 其一","author":"蔡沈","text":"暮年无杂虑，何事更关情。\n入市非求利，居山岂为名。\n诚存心自逸，足健步常轻。\n却是行游处，春风日日生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢人惠诗","author":"蔡沈","text":"岁事已无几，相过常少宾。\n扣门来剥啄，握手见情亲。\n月窟文章客，花岩老病身。\n从兹襟义合，有约待新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅","author":"蔡沈","text":"造物无穷巧，寒芳品更殊。\n花腴真类假，枝瘦懒犹枯。\n帝子明黄表，宫人隐绛襦。\n若论风韵别，桃李亦为奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题范伯诗顾斋","author":"蔡沈","text":"时人欲作圣贤归，反己由来自不欺。\n谈话每虞无十步，持循长恐有虚辞。\n硁硁固不为兹必，踽踽宁求可善斯。\n吃紧此心常自在，一诚之外靡馀师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠武夷熊圣功隐士","author":"蔡沈","text":"里闬皆华族，云山独草庐。\n非求龙虎鼎，爰傍圣贤居。\n石耸千寻直，溪涵万顷虚。\n文公精爽在，风月夜何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠抚琴刘伯华","author":"苏元老","text":"公子方年少，丝桐长有名。\n曲虽仍旧谱，指要发新声。\n涧落泉初响，风清月正明。\n起予千古意，恻怅不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中","author":"蔡沈","text":"才既非时用，性本爱岑寂。\n决策西山游，幽隐遂成癖。\n春风百花红，秋月千嶂碧。\n烟霞结绸缪，猿鸟自畴昔。\n乘间抚深旷，喷薄轰铁笛。\n笑挹天柱峰，高寒几千尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古意二首 其二","author":"蔡沈","text":"种木必培根，清流必澄源。\n根源得其理，流末乃可言。\n圣贤本始务，条达盖自然。\n时俗枝委求，持操空尔烦。\n存存此成性，道义斯其门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古意二首 其一","author":"蔡沈","text":"古人不可见，末习徒纷然。\n精微固难知，论议胡尔偏。\n郢曲听者谁，巴唱和乃千。\n世道既若兹，淳风何当还。\n矫矫且自强，天运终来旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉堂真丈索毋自欺斋诗","author":"蔡沈","text":"人心具天德，气禀有昏明。\n学以致其知，善恶义乃陈。\n恶既在必去，善即在持循。\n知之虽曰至，行之贵乎诚。\n念虑或未实，覆护寻亦生。\n遂令负初心，怛焉愧于人。\n君子必谨独，暗室十目瞋。\n毫釐不苟徇，隐微常战兢。\n好恶慊于己，择言无在身。\n由中以达外，万善皆精纯。\n大书毋自欺，高斋扁新名。\n居常目在是，以况汤盘铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘子野携诸名公诗轴见过为书其后","author":"蔡沈","text":"畏暑懒出户，息心聊罢诗。\n诸公旧有作，其意已无遗。\n岭表经行处，贤阙扣见时。\n悠然皆往事，勉务日新期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早梅寄周纯臣","author":"蔡沈","text":"秋风日日吹芳草，山北山南迹如扫。\n江梅一夜暗将春，疏影横斜水边道。\n道逢驿使江南归，袖中袖出天香老。\n英姿独步霜雪中，清癯只为风流早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯氏怀人韵","author":"蔡沈","text":"怀人复怀人，怀忧不能写。\n沧浪有舟楫，便欲从东下。\n春寒雨淋淋，舟楫不可寻。\n临流一惆怅，直下万里深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴伯纶早梅","author":"蔡沈","text":"篱落当岁暮，春至无人知。\n鸾鹤倏尔集，蜂蝶还先期。\n月落步疏影，空明见幽姿。\n香气谁与达，赖有清风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西山","author":"蔡沈","text":"紫荆相依倚，绿筱自蒙密。\n秋兰涧中花，山果路边实。\n沿岗引霜藤，临流坐寒石。\n日暮阴崖开，云收远山出。\n疏篱尚存菊，荒庭旧垂橘。\n丝桐想虚堂，简策居静室。\n俯仰今几时，漫然已陈迹。\n摩挲苍苔痕，屐齿不可识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜读苏州诗","author":"蔡沈","text":"夜读苏州诗，襟怀尽冰雪。\n飘飘关塞云，微微河汉月。\n秋兰南窗前，清香静中发。\n怀我千载心，岁晚更幽绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷山中四首 其四","author":"蔡沈","text":"余昔隐屏北，飘然度岩侧。\n谁知神仙居，自与尘世隔。\n瑶草霜更青，琪花雪仍白。\n横玉叫寒云，万里天一色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷山中四首 其三","author":"蔡沈","text":"余昔隐屏南，春风驻征骖。\n开门傍水面，结屋依山岚。\n千崖互纡郁，万象中浑涵。\n居然岁月深，寒花露毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷山中四首 其二","author":"蔡沈","text":"余昔隐屏西，乘闲卧幽栖。\n岩花雪端发，野鸟林际啼。\n仙掌神所刓，石崖天与齐。\n月华结清梦，啁哳闻金鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷山中四首 其一","author":"蔡沈","text":"余昔隐屏东，扁舟夹双龙。\n浩歌碧云间，万壑生清风。\n群仙幔亭宴，玉女双鬓蓬。\n夕景落寒岩，照耀金芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷自咏","author":"蔡沈","text":"武夷群岫高崔嵬，隐屏直耸天中开。\n千寻拔地出圭壁，屼屼万古封苍苔。\n烟霞舒卷朝夕异，日月昼夜东西回。\n寒流诘曲抱岩足，水清沙碧直蓬莱。\n紫京真人玉为杯，琼浆初发葡萄醅。\n醉来披云卧松月，松花点点飘香雪。\n哀猿绝壁声更长，惆怅怀人逮明发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南昌城","author":"蔡沈","text":"巍城十八里，雄壮称洪都。\n北郭势迤逦，南浦形萦纡。\n连亘控西江，囊括尽东湖。\n灌侯遗故址，李相规旧模。\n改筑龙沙堤，三方第如初。\n得非彫残后，民力不足欤。\n得非府库竭，费用不给欤。\n当时庙堂上，不主公议欤。\n我来客城闉，感慨成欷吁。\n今古如一辙，有才能远图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王禹玉游西岩","author":"蔡沈","text":"幽人欲往西岩巅，临风送目心悠然。\n芒鞋竹杖风月冷，千山万壑开晴烟。\n人生适意多掣肘，穷欲入山山不受。\n严光终老钓台春，李白谩醉长安酒。\n殷勤为我语山灵，白头管取相看守。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送江端伯之隆兴","author":"蔡沈","text":"人生辛苦惟别离，况复心相知。\n辛酸话别语不出，相看执手徒依依。\n问君西游何归期，长途巉岩不可思。\n春霜日暮山谷里，寒风凛凛吹人衣。\n中林哑哑乌欲栖，猿猱虎豹夹路啼。\n路傍古屋掩柴扉，空房独宿生新悲。\n家山昨夜春始至，桃花初破梅花飞。\n自非丈夫刚自许，谁不去住生狐疑。\n惟君与我同此志，西湘东越频驱驰。\n番阳浩荡六百里，南昌风物雄江西。\n西山中峙高崔嵬，滕王杰阁横江开。\n五更东望红浴日，鱼龙蛟蜃惊相积。\n阳门青松青可挹，剑池清水清可吸。\n真人鹤岭遗金丹，中峰苍莽风常寒。\n游人西游止此地，眼明足健应忘还。\n闽山岂足展羽翮，湖光望极天地宽。\n鲲鹏变化知有托，归来长铗宁须弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送连惟馨之小湖兼简程节推","author":"蔡沈","text":"本有瓜葛旧，况乃桑梓情。\n浮云无定姿，飘泊湖溪滨。\n春晴百花发，忍对江头别。\n垂杨弄柔丝，含愁不能折。\n湖溪故人心，寒潭照秋月。\n一别经十年，俯仰伤契阔。\n为言山中友，青阳半华发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读王莽传寄廖判府","author":"蔡沈","text":"噫吁嚱，噫嚱一曲难为听，桑麻垄亩今荆榛。\n子规夜诉仓庚鸣，时至气化能无声。\n高皇神武百世业，安汉小子为凭陵。\n九十六万目可掩，奈何从臾皆群臣。\n臣乎臣乎胡乃尔，富汝贵汝庸何生。\n炎精白昼欲晦蚀，日角眉目尤精神。\n古来权柄不早去，止为鱼肉涂生灵。\n生灵涂炭自兹始，古往今来祇如此。\n重华一去何时还，志士幽人泪如雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读江西诗呈游光化料院","author":"蔡沈","text":"江西多秀士，卓跞相后先。\n其中最翘楚，无出黄陈前。\n森然插天干，琢削草舍椽。\n羌童扣金石，越女调管弦。\n非无要妙音，难与韶濩传。\n王风惜云远，屈宋美独专。\n沉浓玄晖诗，典雅渊明篇。\n少陵备众体，太白真谪仙。\n微情寄风月，肺腑皆天然。\n自从句中眼，一字千金钱。\n于今百馀载，诵说如河悬。\n人惟屋下屋，何以千万间。\n正声日微茫，寂感空无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题","author":"蔡沈","text":"作书与蜀客，止为求知音。\n不料缘素丝，却与多黄金。\n今情既已异，古意何由寻。\n一笑陶靖节，雅趣无弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠江宁刘明府","author":"蔡沈","text":"南陆昼日永，北窗风气清。\n端居玩时物，园林绿阴成。\n新竹梢已繁，脩梧叶初荣。\n翩翩有幽禽，睍睆发清声。\n岂无樽酒欢，抚景难自倾。\n亲朋天一端，别我岁倏更。\n衷丹寄秋毫，香煤染霜藤。\n耿耿叹离群，拳拳怀友生。\n珍重万金抵，契阔千恨平。\n欲题尺书报，恻怆若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵岩分韵得从字","author":"蔡沈","text":"我来灵岩游，坐石披蒙茸。\n翛然忘世纷，便欲脱屣从。\n外峻悬绝磴，中宽峙高峰。\n精庐三数间，岁久苍苔封。\n寒藤结暝色，秋花敛愁容。\n哀猿发清声，月影山重重。\n扁舟暮江下，疏林闻夜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠棋士兼相","author":"苏元老","text":"嵯峨远游冠，过我田里居。\n手谈达要妙，心计有卷舒。\n把握杀活机，操持开阖枢。\n总总如乱兵，纷纷若奔车。\n观者皆怵惕，敌人更揶揄。\n一著起疲废，万口惊喧呼。\n巧思自神授，智慧非常拘。\n又闻风鉴精，许与且不渝。\n群公赠诗文，称述良非虚。\n自昔少兼能，今挟二术俱。\n奕秋与许负，异世同一躯。\n惜哉惟艺名，问学当何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠琴士翁明远","author":"蔡沈","text":"胶漆本无意，丝桐非有情。\n因缘醉翁指，发此无穷声。\n萧萧秋风引，落叶渭水清。\n喧喧阳春歌，花明锦江城。\n离鸾月徘徊，别鹤云杳冥。\n清泠洒毛发，震荡惊雷霆。\n曲度神莫测，调高妙难名。\n时方多艰虞，掩耳谁为听。\n无为恩怨儿女语，疆场勇士轩昂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三十五","author":"晏殊","text":"静寻啄木藏身处，闲看游丝到地时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"蔡沈","text":"游鱼顾影惊寒月，宿鹭迷群下夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"蔡京","text":"八十一年住世，四千里外无家。\n如今流落向天涯。\n梦到瑶池阙下。\n玉殿五回命相，彤庭几度宣麻。\n止因贪此恋荣华。\n便有如今事也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自题画像","author":"蔡枢","text":"平生陋质写难真，画史挥毫妙入神。\n瘦似休文宁复健，寒如东野故应贫。\n尘埃自笑双蓬鬓，泡影俄惊两幻身。\n从此山林皆独往，定无勋业上麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麻源灵丰祠","author":"蔡若水","text":"偶因乞雨到麻源，碧涧萦纡乱石间。\n未省谢公吟赏后，更谁乘月弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄文丞相","author":"蔡郁","text":"嗟哉此纲常，一朝已散失。\n臣岂无贤良，君岂有惭德。\n君臣义未明，大道致闭塞。\n谁实笃忠贞，矢志不可屈。\n先生真英豪，提戈呼叱咤。\n一心收桑榆，戎行瞻黼黻。\n间关五岭南，誓师存百粤。\n有仍田一成，足以张征伐。\n南阳戴真人，足以兴汉室。\n天道岂无知，为此冠裳恻。\n昨闻战城南，王师奋鈇钺。\n万马似群羊，斗败鼓声竭。\n百年养士恩，报之在朝夕。\n多惭迟暮身，涕泪望乡国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕堂诗","author":"蔡兹","text":"世情日浅道情深，悔不林泉早脱簪。\n一世简编贻后叶，百年香火奉先心。\n诗缘好句须亲录，酒到浓时辄倩斟。\n于此更无关意事，时携诸幼步花阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门寺","author":"蔡冠卿","text":"忆昔云门月正明，烦襟消尽觉神清。\n林泉自濯尘埃事，松桧静含风雨声。\n山鬼听经藏户牖，野猿偷果堕檐楹。\n几年京洛缁尘满，何日临流一濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送灵岩道光大师","author":"蔡冠卿","text":"僧读儒书举世稀，惟师精学出尘机。\n上都香火安禅久，东国林泉徇众归。\n道在莫从形相索，身閒都觉利名非。\n灵岩到日秋应晚，还写新诗遍翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南京种山药法 其二","author":"蔡挺","text":"润还御水冰霜结，荫近尧云雨露偏。\n自裹自题还自愧，揠苗应笑宋人然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南京种山药法 其一","author":"蔡挺","text":"青青正是中分天，区种何妨试玉延。\n即见引须缘夏木，定知如蹠荐冬筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇子生献诗","author":"蔡挺","text":"昨夜薰风入舜韶，君王未御正衙朝。\n阳晖已得前星助，阴沴潜随夜雨消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜迁莺","author":"蔡挺","text":"霜天清晓。\n望紫塞古垒，寒云衰草。\n汗马嘶风，边鸿翻月，垄上铁衣寒早。\n剑歌骑曲悲壮，尽道君恩难报。\n塞垣乐，尽双鞬锦带，山西年少。\n谈笑。\n刁斗静。\n烽火一把，常送平安耗。\n圣主忧边，威灵遐布，骄虏且宽天讨。\n岁华向晚愁思，谁念玉关人老。\n太平也，且欢娱，不惜金尊频倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友贤堂","author":"蔡洸","text":"筑堂傍西庑，非悦轮奂美。\n公馀竟何之，行行辄至止。\n纷纭屏玩好，周遭罗经史。\n晤对今伟人，尚论古君子。\n择善固毋倦，胜良自自喜。\n卫公骨虽朽，妙语犹在耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浯溪碑","author":"蔡说","text":"生非耀□欲争雄，发见英华□自中。\n□秉湘东千古笔，已思河北一时躬。\n忠肝义胆平□□，铁画银钩大纪功。\n尊主□□□子事，晞颜志节亦颜同。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游大涤山","author":"蔡准","text":"大涤洞沉沉，天柱峰嶪嶪。\n人世悲落花，观松无易叶。\n朝夕樵风生，云鹤閒情惬。\n何当采玉芝，真踪从此蹑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望洞阳","author":"蔡宰","text":"岁事今无几，清霜苦见侵。\n寒深落雁渚，风急捣衣砧。\n翠縠纹秋水，斑绡缬雾林。\n洞阳栖隐地，楼观白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终口占","author":"蔡振","text":"生也非赘，死兮何缺。\n与时俱行，别是一般风月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其十三","author":"蔡格","text":"何思何虑只寂然，由来习静类修禅。\n一去无多路□□，直启玄关叩洞天。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其十二","author":"蔡格","text":"野花幽草满庭除，生意绵绵接太虚。\n独坐空斋无一事，呼童三径乐教锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其十一","author":"蔡格","text":"此身终老太平年，何事修真颠倒颠。\n但得开颜随日赏，醉眠花下也神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其十","author":"蔡格","text":"老年随分做工夫，黄卷静披世味无。\n倦整池边春睡足，凭栏遥看鸟相呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其九","author":"蔡格","text":"逆境须同顺境宽，熟仁坚志这中观。\n英雄何限经坷坎，一片精光本自完。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其八","author":"蔡格","text":"天下无如闻道乐，人间惟有养心高。\n烟花过眼须臾灭，明德馨香万古牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其七","author":"蔡格","text":"寤寐前修相感深，一巾衣钵此传心。\n叮咛莫问如来界，本体工夫在此寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其六","author":"蔡格","text":"硬着脊梁休放肩，肩挑重负路漫延。\n生前气力无停歇，一息奄奄尚向前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其五","author":"蔡格","text":"大禹圣人惜寸阴，嗟我悠悠老已侵。\n七年病蓄三年艾，犹胜龙钟转陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其四","author":"蔡格","text":"心远不妨车马过，地偏渐听月风来。\n参差竹木皆清景，唯有梅枝手自栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其三","author":"蔡格","text":"观云听雨逐番新，清昼绿荫更可人。\n满眼个中无限趣，当窗憩久乐天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其二","author":"蔡格","text":"刊删理障觅天根，心体昭昭会一原。\n岁暮更宜深燕养，莫埋书册动风幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其一","author":"蔡格","text":"一雨秋凉爽气新，秋声栗栗转伤神。\n根株半载培多少，倏忽流光不待人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林居","author":"蔡元定","text":"富贵良非愿，林泉毕此生。\n酒因随量饮，诗或偶然成。\n秋水和烟钓，春田带雨耕。\n顽然无缝塔，且不费经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]