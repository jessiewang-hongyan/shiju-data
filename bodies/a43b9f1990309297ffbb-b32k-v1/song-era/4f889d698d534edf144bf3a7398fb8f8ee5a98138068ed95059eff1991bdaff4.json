[{"title":"宁宗郊祀二十九首 诣饮福位用《乾安》。","author":"郊庙朝会歌辞","text":"所飨惟清，所钦惟馨。\n灵喜留俞，天景窈冥。\n福禄来成，福禄来宁。\n皇用时敛，寿我慈庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 出小次用《乾安》。","author":"郊庙朝会歌辞","text":"孝奏展成，熙仪毕荐。\n光流桂俎，祥衍椒奠。\n风管晨凝，云容天转。\n拜贶于郊，右序诒燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 终献用《正安》。","author":"郊庙朝会歌辞","text":"敬事天地，升侑祖宗。\n陈盥于三，介觞之重。\n秉德翼翼，有来雍雍。\n相予祀事，福嘏日溶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 亚献用《正安》。","author":"郊庙朝会歌辞","text":"帝临中坛，神从八陛。\n华玉展瑞，明馨荐醴。\n亦有嘉德，克相盛礼。\n献兹重觞，降福瀰瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"羽籥陈容，干戚按节。\n德闲而泰，功劳而决。\n虞我神祇，扬我谟烈。\n尽美尽善，福流有截。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 入小次用《乾安》。","author":"郊庙朝会歌辞","text":"听惟飨德，监惟棐忱。\n顾諟思明，灵承思钦。\n永言端莅，肃对下临。\n上帝是皇，毋贰尔心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 还位用《乾安》。","author":"郊庙朝会歌辞","text":"甘露流英，卿云舒采。\n灵俞有喜，神光晻暧。\n穆穆来莅，洋洋如在。\n帝用居歆，泽及四海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 降坛用《乾安》。","author":"郊庙朝会歌辞","text":"天容澄谧，景气晏和。\n瓒斝荐醇，鋗璆叶歌。\n帝降庭止，夜其如何。\n神助之休，宜尔众多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 再升坛。","author":"郊庙朝会歌辞","text":"紫坛岳立，神光夜烛。\n有俨旒采，有鸾佩玉。\n霄垠顾佑，祖宗熙穆。\n对越不忘，俾尔戬谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 再诣盥洗。","author":"郊庙朝会歌辞","text":"帝登初觞，礼严再盥。\n精明显昭，齐颙洞贯。\n灵娭留俞，神光炳焕。\n我宋受福，永寿于万。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 尚书奉俎。","author":"郊庙朝会歌辞","text":"列俎孔陈，嘉笾维实。\n鼎煁阳燧，玉流星液。\n我牲既硕，我荐既苾。\n神监下昭，安坐翔吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 还位。","author":"郊庙朝会歌辞","text":"肃肃礼度，鋗鋗宫奏。\n天行徐谧，皇仪昭懋。\n光连重璧，物备簋豆。\n于皇以飨，无声无臭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 降坛。","author":"郊庙朝会歌辞","text":"帝飨于郊，一精二纯。\n紫觚陟降，嘉玉妥陈。\n神方留娭，瑞贶纷纶。\n申锡无疆，螽斯振振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 升坛用《乾安》。","author":"郊庙朝会歌辞","text":"崇台穹窿，高灵下堕。\n庆阴彷佛，从坐嶪峨。\n宵升于丘，时通权火。\n维天之命，百禄是荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 皇帝盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"皇帝俭勤，盥用陶瓦。\n礼神颂祗，奠币献斝。\n月鉴阴肃，醴液融冶。\n挹彼注兹，礼无违者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 其四 降神用《景安》。","author":"郊庙朝会歌辞","text":"金石宣昭，羽旄纷纶。\n洁火夕照，明水夜陈。\n娭哉惟灵，娭哉惟神。\n风马招摇，惟德之亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 其三 降神用《景安》。","author":"郊庙朝会歌辞","text":"泰尊媪釐，祖功宗德。\n辰躔陪营，岳渎受职。\n神哉来下，神哉来格。\n飨德惟馨，留虞嘉席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 其二 降神用《景安》。","author":"郊庙朝会歌辞","text":"华盖既动，紫微洞开。\n星枢周旋，日车徘徊。\n灵兮顾佑，灵兮沛来。\n载燕载娭，式时坛垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首 其一 降神用《景安》。","author":"郊庙朝会歌辞","text":"天门荡荡，云车阴阴。\n百神咸秩，三灵顾歆。\n神哉来娭，神哉溥临。\n飨时宋德，翼翼小心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊祀二十九首","author":"郊庙朝会歌辞","text":"合祀丘泽，登侑祖宗。\n顾諟惟精，灵承惟恭。\n有严皇仪，有庄帝容。\n监于克诚，肃肃雍雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"泰元尊临，富媪繁祉。\n于皇祖宗，既昭格止。\n奏舞象功，灵其有喜。\n永言孝思，尽善尽美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 降坛用《乾安》。","author":"郊庙朝会歌辞","text":"躬展盛仪，天步逡巡。\n乐备礼交，嘉玉既陈。\n神方安坐，荐祉纷纶。\n陟降有容，皇心载勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 送神用《景安》。","author":"郊庙朝会歌辞","text":"九霄眇邈，神不可求。\n何以降之，监德之修。\n三献备成，神不可留。\n何以送之，保天之休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 太宗皇帝位奠玉币用《化安》。御制。","author":"郊庙朝会歌辞","text":"赫赫巍巍，及时纯熙。\n昊天成命，后则受之。\n登迈邃古，光被声诗。\n有币陟配，孙谋所贻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 还位用《乾安》。","author":"郊庙朝会歌辞","text":"帝出于震，孝奏上仪。\n燔燎膻芗，神徕燕娭。\n肃若旧典，罔或不祗。\n既右飨之，翕受蕃釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 昊天上帝位奠玉币用《嘉安》。御制。","author":"郊庙朝会歌辞","text":"上穹昊天，日星垂曜。\n照临下土，王国是保。\n维玉与帛，寅恭昭报。\n永左右之，钦若至道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 望燎用《乾安》。","author":"郊庙朝会歌辞","text":"谓天盖高，阳嘘而生。\n日月列宿，皆天之神。\n肆求厥类，与阳俱升。\n视燎于坛，以终其勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 还内用《采茨》。","author":"郊庙朝会歌辞","text":"五辂鸣銮，八神警跸。\n天官景从，莫不祗栗。\n祲威盛容，昭哉祖述。\n祚我无疆，叶气充溢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 饮福用《禧安》。","author":"郊庙朝会歌辞","text":"八音克谐，降神出祇。\n风马云车，陟降在兹。\n锡我纯嘏，我应受之。\n一人有庆，燕及群黎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 太祖皇帝位奠币用《广安》。御制。","author":"郊庙朝会歌辞","text":"明明翼祖，并侑泰坛。\n肇造绵宇，王业孔艰。\n表正封略，上际下蟠。\n躬以大报，亦止于燔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 亚献用《正安》。","author":"郊庙朝会歌辞","text":"阳丘其高，神祇并位。\n既奠厥玉，既奉厥醴。\n亦有嘉德，克相毖祀。\n旨酒载爵，以成熙事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 升坛用《乾安》。","author":"郊庙朝会歌辞","text":"帝临崇坛，媪神其从。\n稽古合祛，并侑神宗。\n升阶奠玉，诚意感通。\n贶施鼎来，受福无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 望瘗用《乾安》。","author":"郊庙朝会歌辞","text":"谓地盖厚，阴翕而成。\n社稷群望，皆地之灵。\n肆求厥类，与阴俱凝。\n视瘗于坎，以终其勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 彻豆用《熙安》。","author":"郊庙朝会歌辞","text":"燎芗既升，焫膋以洁。\n于豆于登，焄蒿有飶。\n紫幄熉黄，神其安悦。\n将以庆成，薄言盍彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 诣饮福位用《乾安》。","author":"郊庙朝会歌辞","text":"帝临崇坛，媪神其从。\n祖宗并歆，福禄攸同。\n兵寝刑措，时和岁丰。\n其膺受之，将施无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"至大惟天，云何称德。\n展诚致荐，牲用博硕。\n诚以牲寓，帝由诚格。\n居歆降祥，时万时亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 还位用《乾安》。","author":"郊庙朝会歌辞","text":"克昭王业，命成昊天。\n泰畤禋燎，八陛惟圆。\n肃然威仪，登降周旋。\n是谓精享，神监吉蠲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 入小次用《乾安》。","author":"郊庙朝会歌辞","text":"恭展美报，聿修上仪。\n礼乐和节，登降适宜。\n德焉斯亲，神靡不娭。\n海内承福，式固邦基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 皇地祇位酌献用《光安》。御制。","author":"郊庙朝会歌辞","text":"厚德光大，承元之明。\n兹潜莩吹，升于昭清。\n冰天桂海，咸资化成。\n恭酌彝醪，报本惟精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 昊天上帝位酌献用《禧安》。御制。","author":"郊庙朝会歌辞","text":"谒款坛陛，祗祀泰禋。\n丘圜自然，可格至神。\n桂尊登酌，嘉荐芳新。\n靡福菲眇，敷佑下民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 还位用《乾安》。","author":"郊庙朝会歌辞","text":"肆类上帝，怀柔百神。\n槁秸既设，圭币既陈。\n精诚潜交，已事而竣。\n佑我亿载，基图日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 再诣盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"帝出于震，巽惟洁齐。\n神明其德，乃称禋柴。\n惟兹吉蠲，昭事聿怀。\n重盥而祀，敷锡孔皆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 皇地祇位奠玉币用《嘉安》。御制。","author":"郊庙朝会歌辞","text":"至哉坤厚，隤然止静。\n柔载动植，资始成性。\n玉光币色，璨若其映。\n式恭禋祀，有邦之庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 降神用《景安》。","author":"郊庙朝会歌辞","text":"阳动黄宫，日旋南极。\n天门荡荡，百神受职。\n爰熙紫坛，熉黄殊色。\n神哉沛来，盖亲有德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 太祖皇帝位酌献用《彰安》。","author":"郊庙朝会歌辞","text":"于赫皇祖，创业立极。\n肃肃灵命，荡荡休德。\n嘉觞精洁，雅奏金石。\n丕显神谟，惟后之则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 还大次用《乾安》。","author":"郊庙朝会歌辞","text":"舞具八佾，乐备六成。\n大矣孝熙，厉意专精。\n已事而竣，回轸还衡。\n我应受之，以莫不增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十八年祀圜丘 出小次位用《乾安》。","author":"郊庙朝会歌辞","text":"爰熙紫坛，天地并贶。\n来燕来宁，毕陈郁鬯。\n承神至尊，精意所乡。\n告灵飨矣，祉福其畅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滕王阁","author":"宗必经","text":"高阁连城十二栏，西风领客共跻攀。\n半帘烟雨长江外，千里湖山咫尺间。\n雁带秋声归别浦，莺分春色过巴山。\n当年蛱蝶知谁画，一梦庄周去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孺子亭","author":"宗必经","text":"连天大厦莫容身，小向湖边一问津。\n心事说知林下郭，姓名误入府中陈。\n半篙绿水三间屋，一榻清风百世人。\n只有青青堤上柳，至今犹是汉时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南浦","author":"宗必经","text":"江到南关古渡头，旁分一曲入溪流。\n垂杨夹道三千户，绕郭连樯数万舟。\n春水绿波芳草渡，秋风明月白蘋洲。\n滔滔出舍红尘派，一棹中流万顷秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"宗必经","text":"睡晨方知前是梦，落花难上旧来枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"宗必经","text":"不觉授书冬再易，我思暴霸欲消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千手眼大悲偈","author":"宗泽","text":"千手一手用，千眼一眼观。\n用观无差殊，何必许多般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上口占","author":"宗泽","text":"龙兴虎视诧周秦，王气东游作汴京。\n阴祝巨灵移此险，大河为堑岳为城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华下","author":"宗泽","text":"千岩层出乱云飞，失我平生洞府期。\n夜据征鞍不交睫，举头弹指睡希夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华阴道中三首 其三","author":"宗泽","text":"宁王画作金盆鸽，韩愈诗誇玉井莲。\n瓦缶泥泓村落小，乱茅群雀不堪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华阴道中三首 其二","author":"宗泽","text":"菅茆作屋细家居，云碓风帘路不纡。\n坡侧杏花溪畔柳，分明摩诘辋川图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华阴道中三首 其一","author":"宗泽","text":"烟遮晃白初疑雪，日映斓斑却是花。\n马渡急流行小崦，柳丝如织映人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早发","author":"宗泽","text":"伞幄垂垂马踏沙，水长山远路多花。\n眼中形势胸中策，缓步徐行静不哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至洛","author":"宗泽","text":"都人士女各纷华，列肆飞楼事事嘉。\n政恐皇都无此致，万家流水一城花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"佛说偈","author":"宗泽","text":"后学要说禅，教人学团谜。\n佛祖意分明，但为传衣偈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览镜偈","author":"宗泽","text":"览镜影还在，掩镜影还去。\n试问镜中人，却归什么处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓渡","author":"宗泽","text":"小雨疏风转薄寒，驼裘貂帽过秦关。\n道逢一涧兵徒涉，赤胫相扶独厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盘豆铺南李翁园","author":"宗泽","text":"李翁卧亭午，春深掩柴荆。\n忽闻风雨响，疑是勤王兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葬妻京岘山结庐龙目湖上","author":"宗泽","text":"一对龙湖青眼开，乾坤倚剑独徘徊。\n白云是处堪埋骨，京岘山头梦未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题珣师休牧轩 其三","author":"宗泽","text":"空馀短笠与轻蓑，道著休时事早多。\n更向中间问消息，夜深无奈月明何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题珣师休牧轩 其二","author":"宗泽","text":"一乘休去已忘机，恰似当初未牧时。\n云起云消本无迹，有为全体是无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题珣师休牧轩 其一","author":"宗泽","text":"青居曾露一丝头，谩示人能解牧牛。\n究竟本来无一物，未知能使阿谁休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩全节铺爱其称为驻马久之","author":"宗泽","text":"回车胜母避柏人，不饮贪泉恶其名。\n道逢一铺榜全节，系马呼奖臣子情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又赋一律","author":"宗泽","text":"罢兵洵上策，试问可诚然。\n竟弃三军力，空抛半壁天。\n上林无旅雁，绝域有啼鹃。\n羞见龙泉剑，飞光牛斗前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过潼关","author":"宗泽","text":"一雨崤函底，风沙放我过。\n岳神犹假借，官吏莫谁何。\n堑断思航渡，城坚戒石摩。\n一夫工墨守，宁怯万夫多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]