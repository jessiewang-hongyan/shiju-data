[{"title":"和皇太子梅诗二首 其一","author":"杨万里","text":"清赏堂前隔俗尘，南枝得雪晓争新。\n独将却月凌风影，搀献储皇第一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和皇太子瑞雪二首 其二","author":"杨万里","text":"揉云挼雾碎成尘，落不曾休酉达辰。\n鹤禁镂冰成七字，野人拜赐敢辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和皇太子瑞雪二首 其一","author":"杨万里","text":"白玉花开碧玉天，萦楼绕殿舞翩然。\n储皇善颂天皇德，瑞应金穰万万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和唐德明问病二首 其二","author":"杨万里","text":"俟命循天更不疑，朵颐那可换灵龟。\n逍遥岂在榆枋外，问著扶摇总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和唐德明问病二首 其一","author":"杨万里","text":"罢却微官且客居，庭闱不近信全疏。\n更无竹下子唐子，谁与过逢说异书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和彭仲庄对牡丹止酒二首 其二","author":"杨万里","text":"老里心情客里怀，逢花不饮若为开。\n虚名身后真何用，更判生前酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和彭仲庄对牡丹止酒二首 其一","author":"杨万里","text":"病身无伴卧空山，石友相从慰眼寒。\n呼酒撚花谈旧事，牡丹匹似梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谢昌国送韦俊臣相访","author":"杨万里","text":"芒屩为车不必巾，天穷未害子能文。\n谢家有句元无继，枉却催诗头上云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谢昌国送管相士韵","author":"杨万里","text":"半世缘痴自作劳，万人争处我方逃。\n怜渠识尽公卿得，一马归来骨转高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏荷花中小莲蓬","author":"杨万里","text":"山蜂愁雨损蜂儿，叶底安巢更倒垂。\n只有荷蜂不愁雨，蜡房仰卧万花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏酥","author":"杨万里","text":"似腻还成爽，才凝又欲飘。\n玉来盘底碎，雪到口边销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂丝海棠二首 其二","author":"杨万里","text":"不关残醉未醒松，不为春愁懒散中。\n自是新晴生睡思，起来无力对东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂丝海棠二首 其一","author":"杨万里","text":"无波可照底须窥，与柳争娇也学垂。\n破晓骤晴天有意，生红新晒一絇丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂丝海棠半落","author":"杨万里","text":"雨后精神退九分，病香愁态不胜春。\n落阶一寸轻红雪，卷地风来政恼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭观打鱼斫鲙四首 其四","author":"杨万里","text":"鲈鱼小底最为佳，一白双腮是当家。\n旋看冰盘堆白雪，急风吹去片银花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭观打鱼斫鲙四首 其三","author":"杨万里","text":"渔郎妙手绝多机，一网收鱼未足奇。\n刚向人前撰勋绩，不教速得只教迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭观打鱼斫鲙四首 其二","author":"杨万里","text":"六只轻舠搅四旁，两船不动水中央。\n网丝一撒还空举，笑得倚栏人断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭观打鱼斫鲙四首 其一","author":"杨万里","text":"桥柱疏疏四寂然，亭前突出八鱼船。\n一声磔磔鸣榔起，惊出银刀跃玉泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜同文远祷雨老冈祠","author":"杨万里","text":"秋热常年无此例，今宵有月不能凉。\n槁苗似妒诗人懒，作意催成祷雨章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜观庭中梅花","author":"杨万里","text":"雾质云为屋，琼肤玉作裳。\n花明不是月，夜静偶闻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜过杨州二首 其二","author":"杨万里","text":"新晴残冻未全销，月恋冰河雪恋桥。\n两岸红灯成白昼，杨州腊月看元宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜过杨州二首 其一","author":"杨万里","text":"祗今何许问迷楼，更有垂杨记御沟。\n除却琼花与红药，杨州不是古杨州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐二首 其二","author":"杨万里","text":"寒宵老眼只长醒，蝴蝶频催梦不成。\n不是三更三四点，如何一睡到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐二首 其一","author":"杨万里","text":"绣帘无力护东风，烛影何曾正当红。\n兽炭貂裘犹道冷，梅花不易玉霜中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜饮周同年权府家","author":"杨万里","text":"老趁渔船泊馆娃，月明夜饮故人家。\n春风吹酒不肯醒，嚼尽酴醾一架花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊平望二首 其二","author":"杨万里","text":"一色河边卖酒家，于中酒客一家多。\n青帘不饮能样醉，弄杀霜风舞杀它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊平望二首 其一","author":"杨万里","text":"夜来微雪晓还晴，平望维舟嫩月生。\n道是烛花总无恨，为谁须暗为谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊平望终夕不寐三首 其三","author":"杨万里","text":"一生行路便多愁，落得星星两鬓秋。\n数尽归程到家了，此身犹未出苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊平望终夕不寐三首 其二","author":"杨万里","text":"樱桃湖里月如霜，偏照征人寸断肠。\n醉里不知家尚远，梦回忽觉路初长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊平望终夕不寐三首 其一","author":"杨万里","text":"船中新热睡难成，听尽渔舟掠水声。\n不分两窗窗外月，如何不为别人明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊曲湾","author":"杨万里","text":"顺流一日快舟行，薄暮风涛特地生。\n不是江神惊客子，劝人早泊莫追程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊钓台小酌","author":"杨万里","text":"牛狸送我止严陵，黄雀随人或帝城。\n海错未来乡味尽，一杯今夕笑先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊鸦矶","author":"杨万里","text":"峡中尽日没人烟，船泊鸦矶也有村。\n已被子规酸骨死，今宵第一莫啼猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜闻萧伯和与子上弟读书","author":"杨万里","text":"少日耽书病得臞，何曾灯火稍相疏。\n如今老懒那能许，卧听邻斋夜读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐小集","author":"杨万里","text":"霜馀雪后夜无风，人在灯前梅影中。\n玉作寒蔬冰作酒，诗人犹自怨天穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜离零陵以避同僚追送之劳留二绝简诸友 其二","author":"杨万里","text":"思归日日只空言，一棹今真水月间。\n半夜犹闻郡楼鼓，明朝应失永州山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜离零陵以避同僚追送之劳留二绝简诸友 其一","author":"杨万里","text":"已坐诗臞病更羸，诸公刚欲饯湘湄。\n夜浮一叶逃盟去，已被沙鸥圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜窗二首 其二","author":"杨万里","text":"诗人心绪几时休，逢著三春似九秋。\n数到五更仍五点，明朝还更有新愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜窗二首 其一","author":"杨万里","text":"口角哦诗细有声，不妨半醉不妨行。\n青灯一点才如黍，解作书窗彻夜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官道古松","author":"杨万里","text":"翠旌绿纛夹车轮，龙作长身铁作鳞。\n莫笑道傍数松树，古来老却几官人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏三绝句 其三","author":"杨万里","text":"竹间露重午方乾，松里云深夏亦寒。\n只道一溪无十里，为谁百屈更千盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏三绝句 其一","author":"杨万里","text":"麦黄秧碧百家衣，已热犹寒四月时。\n雨后觅春无一寸，野蔷薇发酽燕脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏三绝句 其二","author":"杨万里","text":"手种琅玕劣十年，今年新笋不胜繁。\n不知明早添多少，日暮闲来数一番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岸沙","author":"杨万里","text":"水嫌岸窄要冲开，细荡沙痕似剪裁。\n荡去荡来元不觉，忽然一片岸沙摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岸树二首 其二","author":"杨万里","text":"岸树枝枝秃影中，雪风一半半春风。\n楝梢落尽黄金弹，犹有纷纷缀弹茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岸树二首 其一","author":"杨万里","text":"岸头树子直如筠，谁遣相招住水滨。\n不合镜中贪照影，照来照去总斜身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚子正月五日晓过大皋渡二首 其二","author":"杨万里","text":"危沙崩岸欲侵墙，直下清江百尺强。\n过了笋舆元未觉，忽然回首冷思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚子正月五日晓过大皋渡二首 其一","author":"杨万里","text":"雾外江山看不真，只凭鸡犬认前村。\n渡船满板霜如雪，印我青鞋第一痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚申东园花发二首 其二","author":"杨万里","text":"桃蹊李径旧分栽，红白教它各自开。\n可是桃花逞颜色，一枝穿过李花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚申东园花发二首 其一","author":"杨万里","text":"晓风细细复鲜鲜，也不鸣条也不喧。\n却被花枝勾引著，掀桃舞柳恣它颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其十","author":"杨万里","text":"闸住清泉似镜平，闸开奔浪作潮声。\n放开一板还收去，依旧穿沙绕石行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其九","author":"杨万里","text":"树生石上土全无，只见青葱不见枯。\n好在冷泉亭下水，为渠凭槛数游鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其八","author":"杨万里","text":"家家砌下过清泉，寺寺云边占碧山。\n走马来看已心醒，更教选胜住中间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其七","author":"杨万里","text":"上竺诸峰深复深，一重一掩翠云衿。\n只言人迹无来路，动地钟声与梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其六","author":"杨万里","text":"补种杉松径已成，泥乾尘净正堪行。\n草芽并作伤心碧，只欠先生屐子声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其五","author":"杨万里","text":"下竺泉从上竺来，前波后浪紧相催。\n泉声似说西湖好，流到西湖不要回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其四","author":"杨万里","text":"南北高峰巧避人，旋生云雾半腰横。\n纵然遮得青苍面，玉塔双尖分外明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其三","author":"杨万里","text":"黄金榜揭集芳园，只隔墙头便是天。\n西母云车寒未降，莺花作意办新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其二","author":"杨万里","text":"春光欲动意犹迟，未许游人浪见伊。\n只有梅花藏不得，隔篱穿竹出横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌正月三日约同舍游西湖十首 其一","author":"杨万里","text":"不到西湖又两年，西湖风物故依然。\n道旁松桧俱无恙，笑我重来雪满颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往安福宿代度寺","author":"杨万里","text":"春前腊后暖还寒，陌上泥中湿更乾。\n野寺鸣钟招我宿，远峰留雪待谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"披仙阁上观酴醾二首 其二","author":"杨万里","text":"酴醾约我早来看，及至来看花已残。\n动地寒风君莫怯，乱吹香雪洒栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"披仙阁上观酴醾二首 其一","author":"杨万里","text":"仰架遥看时见些，登楼下瞰脱然佳。\n酴醾蝴蝶浑无辨，飞去方知不是花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首 其七","author":"杨万里","text":"梅香不是不寒清，参遍横枝酒未醒。\n梦入西湖疏影里，觉来失却冷泉亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首 其六","author":"杨万里","text":"雪冻霜封稍欲残，殷勤折向坐中看。\n绮疏深闭珠帘密，不遣花愁半点寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首 其五","author":"杨万里","text":"衣染龙涎与麝脐，裁云剪月作冰肌。\n小瓶雪水无多子，只篸横斜一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首 其四","author":"杨万里","text":"寒尽春生夜未央，酒狂狂似醒时狂。\n吾人何用餐烟火，揉碎梅花和蜜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首 其三","author":"杨万里","text":"酒兵半已卧长瓶，更看梅兄巧尽情。\n醉插寒花望松雪，人间曾有个般清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首 其二","author":"杨万里","text":"胆样银瓶玉样梅，北枝折得未全开。\n为怜落莫空山里，唤入诗人几案来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首 其一","author":"杨万里","text":"销冰作水旋成家，犹似江头竹外斜。\n试问坐中还几客，九人而已更梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发三衢三首 其三","author":"杨万里","text":"云欲开时又不开，问天觅阵好风催。\n雨无多落泥偏滑，溪不胜深岸故颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发三衢三首 其二","author":"杨万里","text":"冲风破雨正愁人，愁得心情没半分。\n风处吹来好消息，诸峰放散夜来云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发三衢三首 其一","author":"杨万里","text":"拔尽新秧插尽田，出城一眼翠无边。\n不关雨水愁行客，政是年年雨水天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发龙川二首 其二","author":"杨万里","text":"优入蛮溪受瘴烟，一生谁料到龙川。\n早书实历远山考，便是中书九闰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发龙川二首 其一","author":"杨万里","text":"山有浓岚水有氛，非烟非雾亦非云。\n北人不识南中瘴，只到龙川指似君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发曲坑二首 其二","author":"杨万里","text":"露草欣逢晓日新，各将珠琲斗呈珍。\n红光影里如何拣，颗颗圜明颗颗匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发曲坑二首 其一","author":"杨万里","text":"云横平野近人低，似縠如纱只隔溪。\n行到溪东元不见，回头却复在溪西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]