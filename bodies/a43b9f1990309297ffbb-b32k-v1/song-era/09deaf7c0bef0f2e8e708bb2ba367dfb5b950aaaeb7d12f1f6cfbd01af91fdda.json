[{"title":"宋武帝庙","author":"王十朋","text":"规模仍旧晋乾坤，遗恨于今失所尊。\n庙食铁山精爽在，铸兵思欲定中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿武昌县","author":"王十朋","text":"行尽江西路，初乘湖北舟。\n荒城叹权皓，贤令惜韩欧。\n漫浪无元叟，峥嵘有故洲。\n神仙雪堂客，几度绝江游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游西山寺","author":"王十朋","text":"好山遗恨恐他年，冒雨登临兴浩然。\n避暑离宫闵吴主，横舟巨浪壮苏仙。\n秋声萧瑟松风阁，岩乳清泠菩萨泉。\n山半有亭名可易，漫郎尤恶曲并圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遇雨两宿县驿","author":"王十朋","text":"绝巘笙箫断，邻州鼓角闻。\n江淮两岸雨，吴楚一天云。\n有驿聊堪憩，无尊亦自欣。\n西山逢老宿，往事说三分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴大帝庙","author":"王十朋","text":"樊山八字形长在，汉鼎三分国尽墟。\n安乐故宫犹庙食，遗民时荐武昌鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望黄州","author":"王十朋","text":"肩舆万松岭，鼓楫芦花洲。\n忽见江上山，人言是黄州。\n怀人望雪堂，读记思竹楼。\n二豪不复见，大江自东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过樊口","author":"王十朋","text":"短棹经樊口，高人忆漫郎。\n杯湖谁复泛，退谷自深藏。\n鄂渚风烟接，吴宫草树荒。\n遗音闻八曲，大小两回傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿华容寺","author":"王十朋","text":"古刹何年有，传闻贞观初。\n药痊明主疾，鼠福梵王庐。\n帝赐褒嘉礼，神留吉利书。\n残僧三四辈，朝莫自钟鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝离华容莫宿孟桥小店甚陋得莫漕子蒙书以八百料船见借遂可鼓楫而西矣","author":"王十朋","text":"晓发华容寺，云开鄂渚天。\n秋深馀晚稻，地旷辟管田。\n草市鱼多骨，荒村店有烟。\n计台书报我，已具济川船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至鄂渚泊报恩寺","author":"王十朋","text":"跋涉经江夏，悲凉忽莫秋。\n雨登罗汉阁，醉上庾公楼。\n风急将吹帽，江寒更泛舟。\n川涂元不隔，归梦到东瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题一览亭","author":"王十朋","text":"危亭顶鄂渚，欲上初不敢。\n肩舆蹑峥嵘，眼界惊坎窞。\n青山缭江湖，烟雨抹浓淡。\n千帆破沧浪，万室昭菡萏。\n大泽匈可吞，秀色手宜揽。\n形势控上游，天险卦侔坎。\n登临迫吹帽，秋声在葭菼。\n衔杯情有欣，怀古意多感。\n两雄孙与刘，壮志鲸鹏啖。\n赤壁走阿瞒，功业炳铅椠。\n黄鹤去何之，灵竹色犹惨。\n楼馀庾公兴，洲遗正平憾。\n北望旧中原，激裂壮士胆。\n何由登太山，一快天下览。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莫漕以莼羹荐杯","author":"王十朋","text":"萧瑟秋风送雁回，梦魂终夜绕箫台。\n年家知我乡心切，斫鲙羹莼荐酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日怀故乡","author":"王十朋","text":"天涯行客倍伤悲，鄂渚登高帽欲吹。\n遥想弟兄行处乐，几人同把菊花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登压云亭赠赵都统","author":"王十朋","text":"早将忠义立殊勋，鄂渚登临气压云。\n异日云台观画像，要须压尽汉将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日陪诸公登高","author":"王十朋","text":"鄂渚逢重九，登高客魂黯。\n白菊泛壶觞，青山满栏槛。\n诗随眼界添，酒逐年华减。\n回头望楚东，半雨花思范。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十日解舟晚泊江口望鄂渚汉阳","author":"王十朋","text":"系缆长江口，斜阳照两州。\n山遥瞻大别，渚远认南楼。\n渔艇家烟浦，江神庙柳洲。\n文通送别处，春恨可如秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"解缆南浦初溯长江江流出鄂渚汉阳两山之间云霭横之如一山然","author":"王十朋","text":"解缆长江口，回头思黯然。\n封疆一川隔，烟霭两州连。\n水鸟飞沿渚，江豚跃傍船。\n好风知几苇，送我上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过金口市江中有渚名鲤鱼甲渚上有芦花连日遇逆风舟以寸进挽舟者行芦中成四绝 其一","author":"王十朋","text":"江山满眼似相迎，一鬨人烟问地名。\n舟过已经金口市，水流应到石头城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过金口市江中有渚名鲤鱼甲渚上有芦花连日遇逆风舟以寸进挽舟者行芦中成四绝 其二","author":"王十朋","text":"鲤鱼甲露江中渚，芦荻花浮渚上霜。\n樯影落江疑是钓，巨鳞惊跃鹭飞忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过金口市江中有渚名鲤鱼甲渚上有芦花连日遇逆风舟以寸进挽舟者行芦中成四绝 其三","author":"王十朋","text":"长江十里渺连空，逆水那堪更逆风。\n定是江神怜远去，欲吹船转浙江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过金口市江中有渚名鲤鱼甲渚上有芦花连日遇逆风舟以寸进挽舟者行芦中成四绝 其四","author":"王十朋","text":"江神不借一帆风，急水难收寸进功。\n攲枕高眠真有愧，挽舟人在荻花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食虾","author":"王十朋","text":"江上秋风起，鲈莼正忆家。\n舟行良不恶，日啖小鱼虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿通济口","author":"王十朋","text":"千里长江险，舟行梦亦惊。\n转矶忧浪急，入沌喜波平。\n秋老天犹燠，宵长月自明。\n洋洋通济水，何日得归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芦花 其一","author":"王十朋","text":"悲秋已过黄花节，照眼浑疑白帝城。\n更类吾家子猷棹，飘然乘兴雪中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芦花 其二","author":"王十朋","text":"芦花两岸风萧瑟，渺渺烟波浸秋日。\n鸥鹭家深不见人，小舟忽自花中出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿思湖口系缆芦苇间夜半闻丛中有声舟人惊起终夕为之不寐","author":"王十朋","text":"老境残秋路入荆，眼中何物不关情。\n芦花间蓼红依白，江水归湖浊带清。\n狐兔丛深应自贺，鱼龙穴浅已相惊。\n扁舟夜宿无人境，展转无眠到五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中作","author":"王十朋","text":"竟日舟行无一家，无边眼界只芦花。\n花中知有雁多少，为我传书到永嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉水","author":"王十朋","text":"方城以为城，汉水以为池。\n横行江汉间，楚子灭诸姬。\n问鼎轻周室，争盟会淮夷。\n子孙世有国，地大先王时。\n封疆六千里，俛首为秦雌。\n虎狼不可亲，前后几见欺。\n始堕张仪计，卒至王剪师。\n西风吹黄芦，疑是骚人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿夏郡口","author":"王十朋","text":"夜宿古夏口，时维季秋半。\n江湖犹未落，烟水渺无岸。\n左公昔屯兵，仲谋方斫案。\n助成赤壁胜，坐使老贼窜。\n壮志宁下人，借地聊取乱。\n蛟龙得云雨，鼎足王蜀汉。\n英雄不复见，江水空汗漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十五夜","author":"王十朋","text":"九月十五夜，前年居故乡。\n鸡黍修故事，兄弟自范张。\n岂知今年秋，扁舟葭苇傍。\n三日无人烟，雨细风悲凉。\n浇愁一杯酒，苦语生悲肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿高牙","author":"王十朋","text":"牢落楚天涯，夔门路尚赊。\n落帆惊宿鹭，弭榜傍栖鸦。\n风伯声喧枕，渔人水浸家。\n江神阻行色，非是恋高牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亡姊之葬在九月而不得其日十五日读坡诗至英公燎须事不觉悲涕是日辛酉得非葬日邪诗以寓哀","author":"王十朋","text":"先人六儿女，姊长孝且慈。\n德淑命不淑，哀哉止于斯。\n莫年失爱子，哭泣鬓成丝。\n年才五十七，一病不可医。\n姊死我在傍，姊葬吾不知。\n初闻卜九月，不得日与时。\n丐祠既不遂，临穴竟无期。\n日月为我昏，风雨为我悲。\n宦游何所得，抱恨渺无涯。\n尚馀英公须，未作子厚碑。\n便当回雁荡，那忍过秭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"买鱼行","author":"王十朋","text":"风伯一怒声如雷，排空浊浪山崔嵬。\n江湖千里人影绝，一叶小舟何处来。\n芦荻花中有渔者，蓑笠为衣楫为马。\n止将烟水作生涯，红曲盐鱼荷裹鲊。\n舟人争买不论钱，我亦聊将荐杯斝。\n烹庖入坐气微腥，饤饾登盘色如赭。\n但能得趣酒杯中，也胜弹铗人门下。\n君不见仲尼鱼馁则不食，陈蔡面犹含菜色。\n又不见退之欲饱东海鲸，焉知家有啼饥声。\n我居江乡厌海味，今日鱼虾八珍贵。\n朱门日兴费万钱，未必一生常适意。\n尔曹异日宦西东，一饭安得如今同。\n寄鲊不须劳孟宗，但愿清白传家风。\n我将归结鸡豚社，不用击鲜如陆贾。\n但愿年丰鱼米贱，欣然醉饱同天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过八叠有小舟卖虾是日风便但江岸萦迂疾徐相半","author":"王十朋","text":"舟经八叠疾还徐，帆便风高水自迂。\n要与曲生谈妙理，试呼渔父买长须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过三叉","author":"王十朋","text":"派别从金口，江行过玉沙。\n风湾迂八叠，烟渚会三叉。\n柳老馀春色，尊空负月华。\n端如退之语，江远共蒹葭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泛泛江汉水","author":"王十朋","text":"鄂渚上荆州，泛泛江汉水。\n萦迂知几曲，萧瑟非一苇。\n乡心秋色中，旅思诗篇里。\n云安在何处，落日天边是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿网步时已入夜犹行舟忽闻犬声知有人家孤灯一点盖渔舍也是夕有月不饮","author":"王十朋","text":"网步知何处，维舟日已昏。\n孤灯耿渔舍，一犬吠江村。\n问境欣名复，归心几到温。\n遥天有明月，惜不照金尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过毕家池有姓陈者送香橙八颗云有子在太学名景初有佛舍额曰永固院临水而门闭有神祠云江南吴王庙必孙氏也 其一","author":"王十朋","text":"瓮间吏部姓名池，僧舍人家傍水涯。\n黍熟稻香俱可饭，橙黄橘绿最宜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过毕家池有姓陈者送香橙八颗云有子在太学名景初有佛舍额曰永固院临水而门闭有神祠云江南吴王庙必孙氏也 其二","author":"王十朋","text":"江上人知我姓名，枝头手自摘香橙。\n一盘来致殷勤意，侬有儿为太学生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过毕家池有姓陈者送香橙八颗云有子在太学名景初有佛舍额曰永固院临水而门闭有神祠云江南吴王庙必孙氏也 其三","author":"王十朋","text":"江东英杰旧孙郎，遗烈于今尚未忘。\n犹有神祠枕流水，一间茅屋似昭王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚过沙滩有渔举网得鳊鱼二百馀头橙橘正青黄以百钱买橘得十六颗比乡里小差而味酸 其一","author":"王十朋","text":"渔人生计占沙洲，一网鳊鱼二百头。\n鱼未到家人买尽，明朝一网更盈舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚过沙滩有渔举网得鳊鱼二百馀头橙橘正青黄以百钱买橘得十六颗比乡里小差而味酸 其二","author":"王十朋","text":"地近荆州见木奴，青黄照眼两三株。\n百钱买得霜前颗，味带儒酸似老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚过沙滩有渔举网得鳊鱼二百馀头橙橘正青黄以百钱买橘得十六颗比乡里小差而味酸 其三","author":"王十朋","text":"晚来诸卒竞欢呼，籴得香粳一斗馀。\n拾荻为薪煮江水，就船沽酒吃鳊鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀鄱阳赵倅及诸同官用九日登高韵","author":"王十朋","text":"君如别驾宠，我愧淮阳黯。\n鄱水偶同僚，江楼屡凭槛。\n感秋悲思多，惜别刚肠减。\n夔门啸与诺，安得对岑范。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿紫微","author":"王十朋","text":"高柳何人舍，孤灯此夜舟。\n遥从白帝去，少为紫微留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十一日至福田院留建圣节 其一","author":"王十朋","text":"魏阙回头远，夔门去路长。\n万年天子寿，一瓣福田香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十一日至福田院留建圣节 其二","author":"王十朋","text":"小院藏脩竹，柴门傍曲江。\n系舟杨柳岸，诗句落僧窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿金鸡渡","author":"王十朋","text":"晓起鸡未鸣，晚宿鸡鸣渡。\n鸡鸣又还起，扁舟触烟雾。\n不作田文奔，不效刘琨舞。\n孜孜慕舜徒，去去官夔府。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿王家村 其一","author":"王十朋","text":"舟行湖北路千里，家在浙东天一涯。\n宿处问名同住处，梅花不见见芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿王家村 其二","author":"王十朋","text":"扁舟何日到夔州，已泛荆湖半月船。\n误喜地名同故里，欲寻邻舍竟茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿王家村 其三","author":"王十朋","text":"王家又向此名村，只欠青山似左原。\n满眼黄茅仍白苇，荒芜疑是我田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读楚东倡酬集寄洪景卢王嘉叟","author":"王十朋","text":"预恐吾侪有别离，急忙刊得倡酬诗。\n江东渭北何曾隔，开卷无非见面时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题鄱阳一江亭","author":"王十朋","text":"一江明月夜归迟，萧洒斋中小范诗。\n亭自我名犹未赏，梦游江静月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早至鲁家洑复入大江见石首山","author":"王十朋","text":"入由通济口，出自鲁家洑。\n半月良已劳，大江离又复。\n濛濛烟雨中，两岸渔人屋。\n遥山瞻石首，乡味思海族。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中记所见","author":"王十朋","text":"不向三苗境上过，此身端怯洞庭波。\n浪翁未免敖牙戏，渔父时为欸乃歌。\n虫喜年丰频捣米，鸟忧沙涨自淘河。\n可无好处如乡里，橘绿橙黄恨不多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十五日先妣远忌祭于舟中","author":"王十朋","text":"有遗嗟无母，舟中遇忌辰。\n鱼蔬当血食，橙橘荐时新。\n家比去年远，囊如旧日贫。\n白岩山下冢，归扫拟新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿下沙步有小浦藏舟于口惧有风也是夜浪忽作声如潮舟为之撼如是者三舟人惊惧初谓有风起视则天籁不号星月皎然篙工云江中畏炮炙邻舟有煎油者岸圮而浪生晓视之果有圮处或云鼋鼍之属因记之","author":"王十朋","text":"疑向钱塘宿，潮头夜半声。\n油煎江岸圮，舟撼梦魂惊。\n浪自鼋鼍吐，风从芦苇生。\n江神不迁怒，顷刻为吾平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天晴风顺舟行过石首县宿刘郎洑","author":"王十朋","text":"残月照荆江，晨曦浴旸谷。\n云收瘦山腰，风顺饱帆腹。\n微茫见石首，俄顷过吾目。\n方兹惊汹涌，何敢求迅速。\n快意固可喜，迟钝或为福。\n风乎亦难矣，去顺来者讟。\n江神岂世情，吾亦不私祝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予自鄂渚登舟近两旬得顺风才二日耳高牙遇风雨留两日既而得顺风过八叠江流迂曲疾徐相半二十六日风驶甚方快之谓公安可一日到也明日如故江与风背浪汹涌停舟不行复用前韵","author":"王十朋","text":"我欲效元子，漫浪居退谷。\n不效楚大夫，醒清葬鱼腹。\n前非恋高牙，今岂嗜湖目。\n两旬非不迟，一日靡容速。\n直为退之规，宁觊塞翁福。\n未易论乘除，不须生怨讟。\n江水照吾心，宜将正辞祝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再读楚东集用前韵寄景卢嘉叟","author":"王十朋","text":"二子聪明旷与离，一尊容我与论诗。\n待将后集从前刻，直到鄱阳送别时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寇莱公祠","author":"王十朋","text":"油水江头寇相祠，凛然如坐庙堂时。\n精忠一点不负国，枯竹知公人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿黄坛","author":"王十朋","text":"江口维舟问地名，黯然撩我故乡情。\n平时尚怯黄坛岭，谁遣遥临白帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读于公堂记寄孙录聪伯","author":"王十朋","text":"于公治狱多阴德，温靖居朝止肉刑。\n鄱水同僚温靖后，于公堂记有芬馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月四日宿于沙市舟中捲帘忽见新月天色如水乡思凄然得诗一联云诗成天作纸帘捲月为钩连夕烛有花至六日家书来自临安足成一篇寄二弟","author":"王十朋","text":"今夕果何夕，章华台畔舟。\n诗成天作纸，帘捲月为钩。\n蜡炬知何喜，乡心未免忧。\n家书随雁足，两月到荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初九日离南用夔州船","author":"王十朋","text":"扁舟经月溯江流，又向江陵换蜀舟。\n肠断一声离岸橹，不堪回首仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过虎牙","author":"王十朋","text":"天遣西来亦大奇，眼中浑是少陵诗。\n虎牙铜柱为我好，却胜先生出峡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]