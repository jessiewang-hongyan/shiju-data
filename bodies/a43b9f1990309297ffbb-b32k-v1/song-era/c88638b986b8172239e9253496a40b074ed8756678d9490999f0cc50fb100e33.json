[{"title":"偈颂一百零一首 其八十六","author":"释慧性","text":"八还正眼顶门开，悟得门门有善财。\n要识九旬行道处，薰风依旧自南来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其一","author":"释慧性","text":"万叠峰峦秀，清虚杳霭间。\n跨门一句子，拟议隔重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十五","author":"释慧性","text":"指天指地独称尊，搅动乾坤海岳昏。\n自从赚杀人无数，直至而今无脑门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十","author":"释慧性","text":"息庵去世肉犹暖，五逆还它五逆儿。\n海涌峰头行正令，白拈谁敢觅便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十","author":"释慧性","text":"秋色连天净，秋花满地香。\n圆通门大启，切忌错商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五","author":"释慧性","text":"要入牯牛队，还披水牯皮。\n全身行异类，拽杷又牵犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六","author":"释慧性","text":"行尽迢迢路，无山不是家。\n跨门一句子，拟议隔天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十四","author":"释慧性","text":"深藏古寺老垂垂，冷暖相谙只自知。\n不谓使符相苦逼，依然拽杷又牵犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十","author":"释慧性","text":"一人道有一人无，正令全提肘后符。\n昨夜虚空开口笑，石人吞却洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十","author":"释慧性","text":"瀑布悬崖落半空，等闲平步广寒宫。\n乘时坐断孤峰顶，千圣从教立下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄颜一斋閤内寂室方氏","author":"释慧性","text":"即心即佛没誵讹，不动舌头意气多。\n打破虚空行活路，夫妻抚掌笑呵呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其二","author":"释慧性","text":"横按吹毛，全提正令。\n毁佛谤法，因邪打正。\n有时裂转面皮，天下衲僧乞命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其一","author":"释慧性","text":"紫霄峰下，以毒攻毒。\n撒土抛沙，拗直作曲。\n撼动四大神州，拳踢掀翻地轴。\n性禅没兴遭逢，切忌望空呵嘱。\n坐断千峰顶?头，一任虚声听杓卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其六","author":"释慧性","text":"沩山养子没来由，叉手人前不识羞。\n更把琵琶半遮面，不令人见转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其四","author":"释慧性","text":"只许老胡知，不许老胡会。\n白云尽处是青山，行人更在青山外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其三","author":"释慧性","text":"明修栈道，暗度陈仓。\n刻舟犹觅剑，夜雨过潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其二","author":"释慧性","text":"外道怀藏宝镜时，世尊良久为高提。\n浑如良马窥鞭影，不觉全身陷铁围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十五","author":"释慧性","text":"秋风清，秋月白。\n雁过长空，蝉噪庭柏。\n踢出铁昆崙，大机要顿发。\n好肉剜疮，觑著即瞎。\n隔山人唱太平歌，元是胡笳十八拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七","author":"释慧性","text":"有语中无语，达磨九年空面壁。\n无语中有语，空生岩畔花狼藉。\n南斗八，北斗七。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十四","author":"释慧性","text":"向上一路滑，壁立万仞崄。\n石火电光钝，定乾坤句错。\n水牯牛常甘水草，麒麟只有一只角，千手大悲难摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十八","author":"释慧性","text":"草离离，烟漠漠，雨如膏，云如鹤。\n说了也，错错错。\n五老峰高彻骨寒，野猿啼断山月落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十二","author":"释慧性","text":"作家炉鞴，本分钳锤。\n不用埋兵施陷虎，白拈手里觅便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十","author":"释慧性","text":"去圣时遥，人多懈怠。\n逆则生嗔，顺则生爱。\n不嗔不爱，东海剪刀，西番布袋。\n解脱门头紧著关，休誇铺席无人买。\n脑后见腮，和赃捉败。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十五","author":"释慧性","text":"开门待知识，知识不来过。\n开口不在舌头上，伫看平地起风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十七","author":"释慧性","text":"才开口又成剩语，不开口又成增语，发机须是千钧弩。\n草店家风别，翻云又覆雨。\n若是陶渊明，攒眉便归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十三","author":"释慧性","text":"心月孤圆，清光皎洁。\n吞尽十方空，银椀里盛雪。\n本光瑞如此，笑倒灯明佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十二","author":"释慧性","text":"无语中有语，名曰死句。\n有语中无语，名曰活句。\n可谓剜肉作疮，皮穿骨露。\n举不顾，即差牙，闪电光中走乌兔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十三","author":"释慧性","text":"往来无间，动静一源。\n瞥然而往，瞥然而还。\n大方无内无外，管甚新年旧年。\n归来偃卧青松下，只这些儿妙不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十八","author":"释慧性","text":"万壑千岩，云霞锁雾。\n洞然明白，觌面分付。\n雁影落寒潭，孤舟横野渡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十四","author":"释慧性","text":"今朝四月初一，万像难逃影质。\n马祖升堂，百丈捲席。\n秘魔擎叉，鲁祖面壁。\n唤驴作马，虾跳不出。\n麒麟一角尖，乌龟三眼赤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十八","author":"释慧性","text":"十五日已前，一冬二冬，叉手当胸。\n十五日已后，背手抽金镞，翻身控角弓。\n正当十五日，风从虎兮云从龙，抬眸鹞子过辽东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十五","author":"释慧性","text":"主中宾，宾中主，南山大虫元是虎。\n踢起眉毛著眼看，闪电光中急荐取，发机须是千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十一","author":"释慧性","text":"新梅雪里依稀拆，爱日窗前迤逦长。\n漏泄东君好消息，分明遍界不能藏。\n但得到家田地稳，更无佛法可商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十六","author":"释慧性","text":"爽气生襟袂，清飙袭四维。\n白云抱幽石，冷淡更清奇。\n玲珑八面自回合，峭峻一方谁敢窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十四","author":"释慧性","text":"方挹新春，又迎朱夏。\n山不为高，水不为下。\n梅雨连绵，虚空贴卦。\n浸烂石乌龟，黄梅添话把。\n乌牙峰顶浪滔天，犀牛扇子增高价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十二","author":"释慧性","text":"乌牙绝顶，结制安居。\n包罗万有，吞却十虚。\n切忌从它觅，迢迢与我疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十九","author":"释慧性","text":"相见不扬眉，雷轰闪电迟。\n知音才侧耳，拟议落便宜。\n威行阃外，瞥转机轮，大千捏聚一微尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十六","author":"释慧性","text":"知有底人，眼中著屑。\n尽底掀翻，只得一橛。\n堪笑巴陵老古锥，解道银椀里盛雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十九","author":"释慧性","text":"天得一，地得一，王得一兮无等匹。\n一得一，又何必，闪电光中加霹雳。\n朝来细雨洒危层，八面风清照红日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十三","author":"释慧性","text":"句中句，绝露布。\n闪电里，分缁素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十八","author":"释慧性","text":"观音菩萨将钱买糊饼，放下元来是个馒头。\n相席打令，看楼打楼，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十二","author":"释慧性","text":"法社栋梁，丛林纲纪。\n全杀全活，建立宗旨。\n双放双收，总在这里。\n虎啸风生，龙吟雾起。\n大家扶起破砂盆，无限清风来未已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十八","author":"释慧性","text":"松萝影里，积翠堆中。\n白云为盖，流泉作琴。\n只影独标岩上月，不知那个是知音。\n耳卓朔，头蓬松，抬眸鹞子过辽东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十九","author":"释慧性","text":"言语动用没交涉，非言语动用亦没交涉。\n倾肠倒腹，为楔出楔。\n哑却我口秃却舌，明明万里一条铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十一","author":"释慧性","text":"一番秋雨一番凉，道路无尘野菊香。\n翻笑昔年陶令尹，攒眉归去错商量。\n恁么不恁么，破镜不重光。\n若把拈花微笑是，切忌将奴唤作郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十一","author":"释慧性","text":"掀翻四大海，踢倒须弥卢。\n心粗胆大，少实多虚。\n夜见明星曾落节，儿孙随后受涂糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十七","author":"释慧性","text":"不与万法为侣，咬定牙关错举。\n西江吸尽铁船浮，活提狞龙和角煮。\n倒骑佛殿出三门，翻手为云覆手雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十五","author":"释慧性","text":"一真含法界，大用等虚空。\n千祥如雾集，万善若云臻。\n用祝吾皇无量寿，天高无极地无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十四","author":"释慧性","text":"天寒人寒，大家在这里。\n洗面摸著鼻，吃茶湿却觜。\n向上还有事也无，韩信临朝底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十一","author":"释慧性","text":"丹霞烧木佛，院主眉须落。\n两个无孔铁锤，彼此将错就错。\n焦砖打著连底冻，笑它普化摇铃铎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十七","author":"释慧性","text":"归宗见成行货，别无单传心要。\n二时展钵开单，逐日痾屎送尿。\n饥餐渴饮一般，露柱灯笼大笑。\n毗婆尸佛早留心，直至而今不得妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十九","author":"释慧性","text":"春行万国春无迹，腊雪消残始见功。\n头头应现，处处流通。\n木马泥牛吼，花柳撼春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十二","author":"释慧性","text":"木落高秋玉露垂，慎终追远又思惟。\n无端一世灭胡种，累及儿孙说向谁。\n哑却口，落尽眉。\n牵犁拽杷，带水拖泥。\n顺捋虎须拈蝎尾，白拈手里觅便宜。\n家肥生孝子，谁是五逆儿。\n呜咿，呜咿。\n秋露春风消息在，不知谁荐上头机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十九","author":"释慧性","text":"一叶落，天下秋。\n一尘起，大地收。\n明明祖师意，明明百草头。\n相头买帽，看楼打楼，更嫌何处不风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十九","author":"释慧性","text":"燕语莺吟，俱谈实相。\n春风吹动桃李花，淡烟疏雨笼青嶂。\n切忌起模画样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十一","author":"释慧性","text":"金刚圈，栗棘蓬。\n拈来便用，耀古腾今。\n格外知音才领略，四方八面起清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十","author":"释慧性","text":"春山青，春水绿。\n草茸茸，花簇簇。\n若能丧尽目前机，便见庐山真面目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十九","author":"释慧性","text":"穹窿山里老于菟，一点圆明烁太虚。\n八角磨盘空里转，寥落林泉意自殊。\n超物象，绝名模，将为胡须赤，更有赤须胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十二","author":"释慧性","text":"鼓没弦琴，吹无孔笛。\n共乐尧年同舜日，达磨九年空面壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其一○○","author":"释慧性","text":"归宗事理绝，日轮正当午。\n布袋放憨痴，猫儿捉老鼠。\n若人会得，超佛越祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十三","author":"释慧性","text":"十五日已前，风吹不入。\n十五日已后，水洒不著。\n正当十五日，月中仙桂和根拔，海底泥牛把角牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十二","author":"释慧性","text":"雪覆千山，孤峰不白。\n突出难辨，觑著则瞎。\n铁树花开，冰河焰发。\n不萌枝上月三更，切忌龙门遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十三","author":"释慧性","text":"喝散白云，穿开碧落。\n一步阔一步，一著高一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十四","author":"释慧性","text":"秋风离离，秋色依依。\n秋云淡伫，秋月分辉。\n篆不彫之心印，状似铁牛之机。\n阿呵呵，力咄希，再三捞摝始应知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十七","author":"释慧性","text":"岁尽年穷，无可不可。\n烹露地牛，烧榾柮火。\n野菜只添一箸油，满钵和罗唯一饱。\n笑傲烟霞，白云风拂。\n韶阳一曲自高歌，困来一觉和衣倒。\n浅种深耕得自由，珊瑚枝头日杲杲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十九","author":"释慧性","text":"毗卢师，法身主，纵夺临机些子许。\n目前分付与阿谁，踢起眉毛急荐取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十四","author":"释慧性","text":"未举先知孰与论，掀腾海岳动乾坤。\n崄崖句里翻身转，盘走珠兮珠走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十六","author":"释慧性","text":"佛祖大机，目前密布。\n主中宾，宾中主。\n云从龙，风从虎，发机须是千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十一","author":"释慧性","text":"离四句，绝百非。\n一言已出，驷马难追。\n一任金乌东出，徒教玉兔沈西。\n千钧之弩，不为鼷鼠而发机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十五","author":"释慧性","text":"月挂长空，孤峰独宿。\n幽鸟数声清，白云断处续。\n佛眼难窥，拗直作曲。\n羚羊挂角绝踪由，无限清风生八极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十七","author":"释慧性","text":"二月春过半，园林一样新。\n傍花看蝶舞，近柳听莺吟。\n远客来相访，还曾悟此心。\n林郑珍，井底种林檎。\n今年桃李贵，一颗直千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十二","author":"释慧性","text":"春雨如膏，春云如鹤。\n客从天外来，正是魔王脚。\n阃外威权，麒麟一角。\n转身一拶验来端，外道天魔俱胆落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]