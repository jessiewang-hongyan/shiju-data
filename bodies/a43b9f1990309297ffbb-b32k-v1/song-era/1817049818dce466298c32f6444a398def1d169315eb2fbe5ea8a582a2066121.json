[{"title":"襄阳行","author":"鲍輗","text":"今日何日春气柔，东城骑马花绸缪。\n为君停马一呼酒，花前倒披紫绮裘。\n玉脂汎滥鱼鸟饫，歌舞倦矣蛾眉愁。\n千金万寿好宾主，今我不乐岁如流。\n岂比世上狂驰子，一语不合行掉头。\n呜呼天伦古所定，非有大故宁相尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仰止亭","author":"鲍壄","text":"昔年曾此恋青山，几度秋风入梦寒。\n想得玉岑回合处，夕阳依旧满朱阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏閒居","author":"鲍壄","text":"杜门初入夏，贫不厌身閒。\n白日静于水，绿阴浓似山。\n野蔬留客饭，小艇送僧还。\n却忆西庵夜，泉声石壁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周子静分教桂阳","author":"鲍壄","text":"当时身不顾，义激自诸生。\n一日魁南省，无人不识名。\n官寻流水住，路趁落花登。\n遥想凭高处，岳云千万层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠遇上人","author":"鲍壄","text":"一衲一空身，凝然意不分。\n爱閒全似我，我累已输君。\n野寺同听水，春山独看云。\n有疑仍了取，此外不须闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"僧儿","text":"团菊苞金，丛兰减翠，画成秋暮风烟。\n使君归去，千里倍潸然。\n两度朱幡雁水，全胜得、陶侃当年。\n如何见，一时盛事，都在送行篇。\n愁烦。\n梳洗懒，寻思陪宴，把月湖边。\n有多少、风流往事萦牵。\n闻道霓旌羽驾，看看是、玉局神仙。\n应相许，冲云破雾，一到洞中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"僧义翔","text":"时人号我作郭郎，盖缘为事没著量。\n傀儡弄罢收归笼，自有傍人说短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞主万寿寺偈","author":"僧大","text":"相君提我上天梯，上得千层总是迷。\n争似虎丘安稳坐，清风明月与心齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"释志南","text":"古木阴中系短篷，杖藜扶我过桥东。\n沾衣欲湿杏花雨，吹面不寒杨柳风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以偈问文准禅师","author":"僧某","text":"寒食因悲郭外春，墅田无处不伤神。\n林间垒垒添新冢，半是去年来哭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"问怀秀禅师","author":"僧某","text":"昔日沩山水牯牛，自从放去绝踪由。\n今朝幸遇师登座，未审时人何处求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解夏小参问无准禅师","author":"僧某","text":"选佛场开日，丛林气象新。\n心空及第者，毕竟是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其二","author":"僧某","text":"弥勒真弥勒，分身千百亿。\n时时示世人，世人俱不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其一","author":"僧某","text":"荏苒光阴岁月寒，禅家赢得共盘桓。\n个中消息无人会，愿闻提唱祖师关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 夕景","author":"廖世美","text":"落日水熔金，天淡暮烟凝碧。\n楼上谁家红袖，靠阑干无力。\n鸳鸯相对浴红衣，短棹弄长笛。\n惊起一双飞去，听波声拍拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烛影摇红 题安陆浮云楼","author":"廖世美","text":"霭霭春空，画楼森耸凌云渚。\n紫薇登览最关情，绝妙夸能赋。\n惆怅相思迟暮。\n记当日、朱阑共语。\n塞鸿难问，岸柳何穷，别愁纷絮。\n催促年光，旧来流水知何处。\n断肠何必更残阳，极目伤平楚。\n晚霁波声带雨。\n悄无人、舟横野渡。\n数峰江上，芳草天涯，参差烟树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青龙岩","author":"廖则逢","text":"有泉瑩洁深谼豅，奫潫湀㶄声如钟。\n??使我毛发竖，中有高卧虬髯翁。\n砯崖瀑布泻明月，惊溜触石调焦桐。\n蠲烦析酲竟造此，稽首匍拜玄冥宫。\n蜿蜒莫向此中处，天下苍生待霖雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮郎归","author":"廖刚","text":"月桥风槛水边居。\n画楼三鼓初。\n草堂收拾读闲书。\n起看清夜徂。\n闲想像，尽踌躇。\n玉牌金字铺。\n梦魂纵有也成虚。\n那堪和梦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南二首 其一 送黄冕仲知福唐","author":"廖刚","text":"无诸好，方面镇全闽。\n千骑泛云归洞府，三山明玉外风尘。\n依约是蓬瀛。\n贤刺史，龙虎檀香名。\n金花已传当日梦，锦衣聊慰故乡情。\n和气万家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南二首 其一 贺毛检讨生辰","author":"廖刚","text":"柯山瑞，云路玉桥横。\n六月天香琼蕊秀，千年人瑞昴星明。\n风露湿麒麟。\n廊庙器，冰雪照精神。\n妙世文章凌贾马，致君事业富姬衡。\n松桧倚青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南/忆江南 其二 又","author":"廖刚","text":"蓬山晓，龟鹤倚芝庭。\n云覆宝熏迷舞凤，玉扶琼液荐文星。\n棠荫署风清。\n人尽道，天遣瑞升平。\n九万鹏程才振翼，八千椿寿恰逢春。\n貂衮瞩公荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满路花/促拍满路花 和敏叔中秋词癸巳，周守约敏叔来作中秋","author":"廖刚","text":"雨霁烟波阔，雁度陇云愁。\n西风庭院不胜秋。\n桂华光满，偏照最高楼。\n东山携妓约，故人千里，夜来为舣仙舟。\n明眸皓齿，歌舞总名流。\n恼人情态物中尤。\n阳春一曲，谁把万金酬。\n便好拚沈醉，此夕姮娥，共须著意攀留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪 次韵知点","author":"廖刚","text":"论长校短，总是非闲誉。\n光景百年中，似难留、长江东去。\n随缘游戏，触□寄高情，西楼月，北窗风，鸲鹆尊前舞。\n故人襟韵，千里心相许。\n飞骑趁花时，正名园、揉风洗雨。\n玻璃潋滟，聊共醉红裙，阳春曲，碧云词，慷慨怀千古。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其十","author":"廖行之","text":"劲气由来不可摧，年年偏向腊前开。\n清芬肯为冰霜减，好在含章檐下栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其九","author":"廖行之","text":"如今总总斗新妆，天与风姿压众芳。\n自是百年中第一，不因兰菊返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其八","author":"廖行之","text":"痴绝儿童不耐穷，搓酥缀蜡竞销镕。\n如何见得真风度，须索天工岁一逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其七","author":"廖行之","text":"嫩蕊含芳恰褪冰，此时偏恼少陵人。\n颠狂觅酒寻诗去，赏遍西湖几树春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其六","author":"廖行之","text":"新诗笔力可天回，万里东风扫冻开。\n照眼玉英清彻骨，花神报子亦琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其五","author":"廖行之","text":"客舍袁安雪壅扉，清标廪廪讵容欺。\n如今冻解梅无恙，还似高眠甑不炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其四","author":"廖行之","text":"结实收功鼎鼐调，不论江路与山椒。\n可怜杨柳空牵妩，飞尽狂绵祇绿条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其三","author":"廖行之","text":"曲槛雕栏诧护持，宽閒何用著藩篱。\n林间立马多真赏，须信行人口是碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其二","author":"廖行之","text":"贪看繁红锦被堆，有人青眼为君开。\n西湖千古林和靖，还悟牺尊木质灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵十首 其一","author":"廖行之","text":"梅君消得为高吟，素艳曾无媚世心。\n粲粲墙隈自潇洒，江南到处有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其十","author":"廖行之","text":"曾上云端款祝融，更临涛海揖清风。\n于今又见张夫子，眼底纷纷一洗空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其九","author":"廖行之","text":"榷酤谁云一切功，军储百万若为丰。\n能令利入皆公上，从此深根得裕农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其八","author":"廖行之","text":"稔恶偷儿喜探丸，迩来通夕寝何安。\n铸顽自有金丹诀，何事区区柱后冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其七","author":"廖行之","text":"御吏何忧束湿难，如今门内已相安。\n羔羊正使闲风化，他日翁归尚可观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其六","author":"廖行之","text":"朱履长裙客几千，双凫乘雁一天渊。\n交情可笑书门老，不省从来有失贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其五","author":"廖行之","text":"荐士今谁有古风，不论疏戚与穷通。\n怜渠报国河南尹，愧我无私第五公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其四","author":"廖行之","text":"条教初颁洽里闾，米盐靡密见纡馀。\n而今坐啸铃斋肃，雁鹜行空无簿书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其三","author":"廖行之","text":"天邑由来归浩穰，正凭威信执豪彊。\n次公不到圆机处，须索神医肘后方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其二","author":"廖行之","text":"大学无传久晦冥，英英伯氏独推明。\n隐斋会得名中意，明道伊川真弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上浙西张帅十首 其一","author":"廖行之","text":"先世精忠百世尊，重扶日月正乾坤。\n岁寒最见乔松节，凛凛清规在子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰城道中闻莺书于故县","author":"廖行之","text":"底事离群今暮春，故人怀想渴生尘。\n阳关声断空回首，惭愧迁乔鸟语新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书田俊卿北征纪行诗","author":"廖行之","text":"南北东西一个天，区区二偶漫相怜。\n而今若说悲游子，不似当时王仲宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书湘阴驿壁","author":"廖行之","text":"舍舟湖头烟水昏，假榻邮传犹柴门。\n可能浊酒浇客吻，莫厌明月撩诗魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"午睡","author":"廖行之","text":"暑日薰蒸睡思浓，黑甜真处世情空。\n那知一枕窗前梦，无限尘缘在眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜不寐 其二","author":"廖行之","text":"寒著衾裯思不禁，月娥于我似钟情。\n更添眷眷窥檐入，容与横窗一带明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜不寐 其一","author":"廖行之","text":"月薄西山夜气清，就床攲枕不胜情。\n姮娥似欲相钩引，特地窥窗巧献明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春二首 其二","author":"廖行之","text":"随意幡花剪缀新，杯盘草草簇芳辛。\n还欣好景平生事，赢得旬馀分外春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春二首 其一","author":"廖行之","text":"晓雪才过天气清，喧阗钲鼓喜迎春。\n世间多少虚名事，綵仗驱牛又一新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次武公望雪梅韵五首 其五","author":"廖行之","text":"休论青琐与黄扉，祇有西湖不受欺。\n每向冰霜见全操，笑渠长夏受蒸炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次武公望雪梅韵五首 其四","author":"廖行之","text":"自有天香轧魏姚，何须裂麝与涂椒。\n蜡梅卑俗红梅媚，漫与增添本草条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次武公望雪梅韵五首 其三","author":"廖行之","text":"梅边好与酒杯持，寂寂牙檐短短篱。\n但有诗人出佳句，绝胜謏墓得金碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次武公望雪梅韵五首 其二","author":"廖行之","text":"从来陋巷祇颜回，子悦胡为羡漆开。\n端向岁寒观雅操，须知冰凌不为灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次武公望雪梅韵五首 其一","author":"廖行之","text":"每忆西湖处士吟，暗香浮处最关心。\n而今也有冰霜操，祇要人知韶濩音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上舟中","author":"廖行之","text":"京尘无奈染征衣，况是南宫逐客归。\n后夜子陵台下去，祇应惭愧钓鱼机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中风便","author":"廖行之","text":"一席清风游子归，扁舟轻逐浪痕西。\n浊醪满饮诗情快，尽揽江山入醉题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿五一弟四首 其四","author":"廖行之","text":"哲命天年本自贻，若为五福具期颐。\n义方端是长生药，安用金丹与玉芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿五一弟四首 其三","author":"廖行之","text":"奉养烝尝子职共，盍迎尔相重承宗。\n人生正始严昏娶，嬖御虽贤礼不容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿五一弟四首 其二","author":"廖行之","text":"等观性空两居士，世谛宁忘儿与孙。\n慇勤须若兴门户，力去骄淫是法门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿五一弟四首 其一","author":"廖行之","text":"年年六月二十一，举酒华堂祝诞辰。\n此意肯为身快乐，须知所喜寿慈亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其十","author":"廖行之","text":"三年弱羽自清阴，行借高风入上林。\n犹向齐庭一伸喙，此鸣端亦为知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其九","author":"廖行之","text":"紫枢勋业旧青毡，更上中台秉化权。\n它日鸿钧陶寿域，赤松相与不论年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其八","author":"廖行之","text":"赋政频年合简求，民情滋欲得公留。\n虽然湖外私膏泽，须索樊侯入佐周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其七","author":"廖行之","text":"饥腹那堪疠鬼欺，万金良药起沈羸。\n致和自可消群沴，小试犹烦活国医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其六","author":"廖行之","text":"百万喁喁日苦饥，左餐右粥转欢嬉。\n也知振廪非私惠，端为皇家爱本基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其五","author":"廖行之","text":"六月湖田槁欲?，岳云俄起雨如川。\n不凭公意回天意，争得饥年变有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其四","author":"廖行之","text":"不用籯金累世资，名家人物照清时。\n碧梧翠竹今何羡，森立庭前丹桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其三","author":"廖行之","text":"万卷诗书即肯堂，儒宗气习洗膏粱。\n天资问学俱前辈，须信源深流正长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其二","author":"廖行之","text":"见说奎文得岁时，杓携天北启天机。\n黄陂嗣有公侯气，牛斗扬光曜紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿湖南汪仓十首 其一","author":"廖行之","text":"西府风流载世长，玉龙鳞甲更储祥。\n庆源衮衮多英杰，可但韦平一再芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其十","author":"廖行之","text":"恼乱诗情庾子山，馋涎浑似未朝餐。\n张颐一饱非难办，争得君家伏火丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人乞朱樱十首 其九","author":"廖行之","text":"连朝急雨相狂风，愁绝枝头入望中。\n不比来禽与青李，端能炯炯照颜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]