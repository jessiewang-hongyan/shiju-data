[{"title":"九锁山十咏 其十 云根石","author":"吕同老","text":"吾闻泰山云，触石无不至。\n如何兹山中，有石象云气。\n仙人事狡狯，幻化翻手易。\n鳞鳞作荟蔚，冉冉涌苍翠。\n清分涧水流，幽映林木邃。\n已逃苍狗变，长见玉芝瑞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其六 仙迹岩","author":"吕同老","text":"嬴秦乱天纲，猛志凌海水。\n长驱万山石，鞭策无远迩。\n馀威及兹地，夜半走百鬼。\n仙人惜灵宫，一怒俱披靡。\n巉然断崖上，遗迹俯清泚。\n溪声助叱咤，野藓避冠履。\n兹事三千年，孰决非与是。\n摩挲苍玉纹，俛仰求至理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其九 石壁","author":"吕同老","text":"清飙吹衣裳，缥缈淩层巅。\n玲珑峭壁下，杖策穷回旋。\n名图谢模写，大巧无雕镌。\n窅如晴云影，霭霭行青天。\n飘如水风会，微澜起平川。\n石崖前蔽亏，胜事惜未全。\n吾将运真宰，疏凿成坦然。\n结茅此山阿，长吟伴飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其五 来贤岩","author":"吕同老","text":"昔贤所游地，道路行逶迤。\n中分山腰半，倒插石脚危。\n公生元祐时，名与日月垂。\n至今草木间，英气光离离。\n我行得遗迹，酾酒兴遐思。\n天风豁然至，吹落琼琚辞。\n不惜古人远，但嗟我生迟。\n安得五云表，一假黄鹤骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其三 鸣凤洞","author":"吕同老","text":"连峰路塸堮，幽洞摩苍穹。\n石门松萝隘，伛偻趋儿童。\n泠泠太古泉，环佩声丁东。\n相传吴越年，威凤翔其中。\n后来山中人，盛事誇无穷。\n我疑王者瑞，岂预霸业雄。\n元化有沦忽，世道多污隆。\n何时鸣朝阳，遥问山上桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其二 栖真洞","author":"吕同老","text":"殊庭天柱西，微径罗荆榛。\n驱车谷口亭，清气已迫人。\n元锁为我开，灵关岂无津。\n棋枰俨遗局，乳盖垂空轮。\n侧闻千载前，住此多隐沦。\n冥翳不可识，抱朴终成真。\n仙凡自有分，喧寂难并陈。\n叹息取归路，吾犹湿嚣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其四 蜕龙洞","author":"吕同老","text":"苍山下孱颜，中有神龙栖。\n神龙眇何许，一水涵清溪。\n深藏岩壑古，迥破风烟低。\n当其未蜕时，幽隐漫尘泥。\n既蜕头角成，霄汉参云霓。\n回顾昔所蟠，陈迹亦已迷。\n况我后来人，危磴重攀跻。\n四顾但绝壁，丛筱风凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九锁山十咏 其七 翠蛟亭","author":"吕同老","text":"洄洑古涧深，蜿蜒层湍壮。\n长年蓄飞泉，一决起豪宕。\n高有百尺松，蓊郁蔽青障。\n下有荇与萍，翠色映空旷。\n恍如千丈虬，穷壑潜异状。\n忽乘风云会，奋迅九天上。\n尚想玉堂仙，妙思发雄放。\n醉持白芙蕖，乘流动清唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙泉寺纳凉","author":"吕同老","text":"靡靡市廛尽，杳杳泉石闲。\n灌木蔽榛莽，爽籁弥空山。\n飞甍纳馀辉，丹雘粲以繁。\n巍然青莲宫，俯此碧玉阑。\n化人淡无为，趺坐观尘寰。\n支郎杳不逢，玄蝉噪其间。\n昔贤憩游地，眢井潜龙蟠。\n咏歌之所传，百世犹不刊。\n我生悦超旷，危磴重跻攀。\n归隐谅未能，溯风发长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题高房山夜山图","author":"吕同老","text":"我昔绝江看吴山，朝光正落山水间。\n金波远自海门入，翠岚高插扶桑殷。\n安知璚楼有夜景，明月苍茫堕清影。\n李侯胜赏高侯笔，展卷一时如梦醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天香 宛委山房拟赋龙涎香","author":"吕同老","text":"冰片熔肌，水沈换骨，蜿蜒梦断瑶岛。\n剪碎腥云，杵匀枯沫，妙手制成翻巧。\n金篝候火，无似有、微薰初好。\n帘影垂风不动，屏深护春宜小。\n残梅舞红褪了。\n佩珠寒、满怀清峭。\n几度酒馀重省，旧愁多少。\n荀令风流未减，怎奈向飘零赋情老。\n待寄相思，仙山路杳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 浮翠山房拟赋白莲","author":"吕同老","text":"素肌不污天真，晓来玉立瑶池里。\n亭亭翠盖，盈盈素靥，时妆净洗。\n太液波翻，霓裳舞罢，断魂流水。\n甚依然、旧日浓香淡粉，花不似，人憔悴。\n欲唤凌波仙子。\n泛扁舟、浩波千里。\n只愁回首，冰帘半掩，明珰乱坠。\n月影凄迷，露华零落，小阑谁倚。\n共芳盟，犹有双栖雪鹭，夜寒惊起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 余闲书院拟赋蝉","author":"吕同老","text":"绿阴初蔽林塘路，凄凄乍流清韵。\n倦咽高槐，惊嘶别柳，还忆当时曾听。\n西窗梦醒。\n叹弦绝重调，珥空难整。\n绰约冰绡，夜深谁念露华冷。\n不知身世易老，一声声断续，频报秋信。\n坠叶山明，疏枝月小，惆怅齐姬薄幸。\n馀音未尽。\n早枯翼飞仙，暗嗟残景。\n见洗冰奁，怕翻双翠鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂枝香 天柱山房拟赋蟹","author":"吕同老","text":"松江岸侧。\n正乱叶坠红，残浪收碧。\n犹记灯寒暗聚，簖疏轻入。\n休嫌郭索尊前笑，且开颜、共倾芳液。\n翠橙丝雾，玉葱浣雪，嫩黄初擘。\n自那日、新诗换得。\n又几度相逢，落潮秋色。\n常是篱边早菊，慰渠岑寂。\n如今谩有江山兴，更谁怜、草泥踪迹。\n但将身世，浮沈醉乡，旧游休忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天花寺","author":"吕夷简","text":"贺家湖上天花寺，一一轩窗向水开。\n不用闭门防俗客，爱闲能有几人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"吕夷简","text":"老读文书兴易阑，须知养病不如闲。\n竹床瓦枕虚堂上，卧见江南雨后山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西溪看牡丹","author":"吕夷简","text":"异香秾艳厌群葩，何事栽培近海涯。\n开向东风应有恨，凭谁移入五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过灵岩寺","author":"吕夷简","text":"净名庵下灵岩路，峻壁层崖倚半空。\n我爱老僧年八十，一生长住翠微中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏天宁院","author":"吕夷简","text":"飘然吟魄到鳌山，好句空疏水石间。\n眼界清虚心不息，浮生能有几人闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑州浮波亭","author":"吕夷简","text":"清波环绕地无尘，榜署嘉名得意新。\n若问经纶康济术，亭中兼有钓璜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南立春","author":"吕夷简","text":"灰律何时应，江春昨夜来。\n细风先动柳，残雪不藏梅。\n馀冷迷清管，微和发冻醅。\n闭门无客到，樽俎为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"吕夷简","text":"赤城千仞耸霞标，闻说精蓝近石桥。\n久向天厨分净供，忽游人落赴嘉招。\n逾年华馆留禅榻，几宿轻航兀夜潮。\n深愧山阴许都讲，肯随支遁出尘嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游雁山","author":"吕夷简","text":"往年游海峤，上彻最高层。\n云外疑无路，山中忽见僧。\n虎蹲临涧石，猿挂半岩藤。\n何日抛龟纽，孤峰上再登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆越州 其一","author":"吕夷简","text":"贺监湖边山斗高，水轩水坞频抽毫。\n吟馀清兴杳无际，揭蓬听雨登渔舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吕夷简","text":"梅无驿使飘零尽，草怨王孙取次生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"吕夷简","text":"人为子推初禁火，花愁青女再飞霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吕夷简","text":"人归北阙知何日，菊映东篱似去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"吕夷简","text":"江涵帝子翚飞阁，山际真君鹤驭天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吕夷简","text":"自恨卷帘人已老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宝应湖","author":"吕存中","text":"半升浊酒试莼羹，贱买鱼虾已厌烹。\n浅水衣蒲有船过，淡烟笼月更人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吕延嗣","text":"拟向苍梧叫虞舜，更于橘井访苏仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二绝 其一","author":"吕江","text":"春来脚不踏青青，梦里还家梦又醒。\n一树垂杨楼外绿，莺声不似故园听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二绝 其二","author":"吕江","text":"年华冉冉暗中移，倦客伤春只自知。\n雨后桃花红未减，人情早自向荼蘼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠实际英上人","author":"吕江","text":"实际即为诚，中庸说著形。\n晓来雷雨过，七十二峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36581,"sha256":"18413bf73