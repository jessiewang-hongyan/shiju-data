cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘右司淳于送牡丹病中赋","author":"吕行中","text":"天姿国艳灿芳柯，相亚红黄诧绮罗。\n高拟营邱名冠绝，未饶伊洛品繁多。\n敢邀使座开青眼，为叹英华坠绿莎。\n亭馆主人芹意重，数枝折贡庆清和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"吕声之","text":"山花雨后红，野草风前绿。\n浩歌归去来，不辱在知足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丹丘道中","author":"吕声之","text":"夜宿溪头十里村，数星渔火照篱门。\n雁山峭绝经行处，犹带烟霞入梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云锦","author":"吕声之","text":"拥盖难遮万脸红，烂然云锦直连空。\n更看雨过新妆洗，百媚都含一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先春","author":"吕声之","text":"不把春光较后先，清香自是压群妍。\n微酸一点功成日，桃李从他逞少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芙蓉","author":"吕声之","text":"枫叶飘林竹隔墙，偏于冷淡逞浓妆。\n天教不趁繁华月，要是秋来独耐霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"括苍山行","author":"吕声之","text":"微风吹雨湿栏干，薄雾笼晴带浅寒。\n一树红梅墙外发，谁家美丽倩人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊","author":"吕声之","text":"胜日游郊外，岚光入眼新。\n桃花开万树，又是一年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫霄亭 其二","author":"吕声之","text":"未把浮沤阅世间，蓬莱一水隔三山。\n试穷千里登临目，望断青山白鸟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫霄亭 其一","author":"吕声之","text":"半空烟雨有无间，碧玉屏开四面山。\n我欲紫霄亭上望，吹笙人去几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缙云道中","author":"吕声之","text":"缙云通道入皇都，花满京城水满湖。\n借问今来丞相府，后园人有醉歌无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登资福山呈胡宣教","author":"吕声之","text":"飞屐来登最上峰，千山拥翠景无穷。\n遥看云影参差外，静听泉声断续中。\n今日黄花重九约，何时青眼一尊同。\n好天风月閒相寄，早晚南来有过鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与丁抚干","author":"吕声之","text":"两年肥水喜相逢，托契门墙今已重。\n士有祢衡心肯荐，侯如雍齿首先封。\n更看谋略称筹幄，会见精神坐折冲。\n败走苻坚兵百万，围棋别墅意从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次新邑钱宰黄丞韵","author":"吕声之","text":"一邑何期获二贤，花开满县总翩翩。\n赋诗各出新机锦，裕国还饶内府钱。\n槐竹两行公事办，丝桐三弄政声传。\n作成和气农家好，多稼如云咏大田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过七里濑怀古","author":"吕声之","text":"七里滩头访子陵，水光山色见生平。\n欲为臣子定出处，知与君王分重轻。\n一介草茅真自负，三公轩冕未为荣。\n我来想像高风在，钓石岩前烟浪生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过杜潭题曾祖庆源庵","author":"吕声之","text":"横江灏气欲欺裘，木落千林水露洲。\n偶为搜荒投陇亩，因而展省到松楸。\n神驹已应当年兆，祥笋还为后裔留。\n寄与老僧勤洒扫，庭前橘绿桂香浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王子宽韵","author":"吕声之","text":"绿荫千重竹，清流一带溪。\n子真耕谷口，杨震讲关西。\n手摘星辰近，名登泰华齐。\n古来公相业，谁不起锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张主簿喜雪","author":"吕声之","text":"夜读书窗未觉贫，朝看万瓦没鱼鳞。\n飘来灞岸春风絮，泻下瀛洲玉斛尘。\n笑我冗怀多俗事，羡君清思独凝神。\n遥怜夜月山阴道，还有扁舟乘兴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄教授山堂招饮","author":"吕声之","text":"鼎彝事业未渠休，鸥鹭寻盟暂与俦。\n路入芝岩真绝地，客延蓬岛尽名流。\n不辞一洗陶巾醉，更拟双飞谢屐游。\n谁赏洪都高阁句，落霞孤鹜唱渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺太常黄少卿","author":"吕声之","text":"自从朝奏一封还，便整归装问故山。\n剩得清名千载重，何妨晚节十年閒。\n惯寻夜雪逵溪路，却谢春风汉殿班。\n国史旧编加简讨，春秋直笔任诗删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺叶司业兼中书舍人","author":"吕声之","text":"英妙才华四十年，山林朝市姓名传。\n何妨万斛横江上，不碍千帆过目前。\n我肯尾书干木纸，人饶首著祖生鞭。\n金銮何日商风雅，伴直能呼孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳桐城道中","author":"吕声之","text":"万古长淮一带流，从来战地不容休。\n间关千里军前饷，牢落重阳客里秋。\n怅望白衣来送酒，了无黄菊与簪头。\n何人早断楼兰首，试解君王宵旰忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄太湖黄县尉","author":"吕声之","text":"立顷谈馀袂辄分，乖离数数异朋群。\n君如天揭行空日，我亦风吹过岭云。\n不许范张同饭黍，空惭李杜共论文。\n睽违动涉经年里，棋垒诗坛要策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼止斋陈先生","author":"吕声之","text":"万里长江发自岷，作兴一代有斯人。\n六经疑难言前解，千古兴亡笔下陈。\n爱向田间看耜耒，肯留天上掌丝纶。\n如公到处镌佳句，今日池塘草自春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石佛寺","author":"吕声之","text":"金吾不必问行由，此去逍遥物外游。\n半坞白云藏宿雾，一声横笛下归牛。\n喜瞻杰阁三生像，藐视丛林四海州。\n为写濯缨疏拙句，谁言墨迹至今留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舒城道中","author":"吕声之","text":"还辕天作十分晴，泻出秋光一派清。\n走笔欲题人到迹，扬鞭不住马嘶声。\n顷禾晚熟黄云色，篱菊朝含白露英。\n得似渊明便归去，候门童稚出欢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢石主簿和章","author":"吕声之","text":"多君养就大椿年，便腹诗书昼欲眠。\n绛阙当年名藉甚，白云他日迹飘然。\n千军笔扫人谁敌，九转丹成世莫传。\n倦眼功名旁袖手，剩看月露出新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]