[{"title":"用强甫蒙仲韵十首 其八","author":"刘克庄","text":"幼磨铁砚翁同学，晚捧铜槃客鲜从。\n十二相宁分虎鼠，两家子各判猪龙。\n有时扪虱灯前话，亦或骑鲸海上逢。\n自是老人眠睡少，梦回原不为晨钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其七","author":"刘克庄","text":"玉堂岂必胜茅斋，误得虚名与谤偕。\n法吏淬磨真出角，先生度量莫窥涯。\n谤书堪丑毋庸辨，闷赋虽工未易排。\n已设葛幮安菊枕，投床不觉到无怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其六","author":"刘克庄","text":"久矣设罗无客至，居然执简尚予从。\n微辞幸不遭阳虎，几谏谁能谅触龙。\n窃曼倩桃无复味，闻安期枣有谁逢。\n残年饮啄随缘过，能费支离粟几钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其五","author":"刘克庄","text":"老病难持绣佛斋，田翁泥欲与之偕。\n凤凰渺渺翔千仞，牛马区区辨两涯。\n骥尾传休劳附见，蛾眉班不待推排。\n得君小住为佳耳，姑置闲谈叙别怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其四","author":"刘克庄","text":"俊物终当腾踏去，钝桹犹欲溯洄从。\n邻家东岂无□子，小屋西堪住士龙。\n掷笔不求佳传作，署门怕与恶宾逢。\n山歌亦自谐音节，莫管人嘲似哑钟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其三","author":"刘克庄","text":"不数浮溪与止斋，网罗欲与巽岩偕。\n极知浩博窥辕固，未肯轻浮学祐涯。\n愧我孤根难树立，误君初草未编排。\n藏山行世俱闲事，莫把穷通累雅怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其二","author":"刘克庄","text":"绝无上足担簦至，仅有长须荷锸从。\n乍可沙边狎虫鸟，谁能池上送夔龙。\n入耆英社老能几，举力田科今不逢。\n翠管檀槽方迭奏，未应考击到编钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其一","author":"刘克庄","text":"病著经旬卧小斋，一窗萤雪与谁偕。\n季宣易尚资到溉，茂叔书曾取寿涯。\n志苦白头宁退惰，论孤黄吻竞攻排。\n兔园册子俱拈起，且放芙蓉月照怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵题卓刑部乐山楼","author":"刘克庄","text":"城里惟楼尽见山，使君小筑可三间。\n弓旌招莫返长往，炉灶坏方求大还。\n及菊未荒归栗里，有芝堪茹老商颜。\n鹤书曾赚幽人出，只恐先生又予环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍一首","author":"刘克庄","text":"贫汉殉财夸死权，世间廉退者差贤。\n高门炙手今罗雀，废冢枯髅昔珥蝉。\n薄糁藜羹诳雷腹，旋蒙絮帽暖霜颠。\n时人莫笑侬寒俭，自古臞儒近列仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍二首 其一","author":"刘克庄","text":"雨逗馀寒晓露浓，絮衣著破索重缝。\n清狂昔作戴花监，衰病今为卖菜佣。\n负耒耦耕沮桀溺，操盂三祝弃句龙。\n暮年饱识西畴事，不问家丘问老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍二首 其二","author":"刘克庄","text":"白布衫宽乌角巾，谁知曾扈属车尘。\n行婆内翰共邻曲，田父拾遗相主宾。\n设苜蓿盘殊菲薄，沽茅柴酒半漓淳。\n直令爵齿如荀爽，晚节依然愧逸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其九","author":"刘克庄","text":"比屋篝车满，深林鼓笛喧。\n簇花迎妇担，抛果浴儿盆。\n古礼曾求野，先民或灌园。\n子孙记吾语，切勿羡华轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其八","author":"刘克庄","text":"浅圳须穿浚，荒畦要粪除。\n何尝舍耒出，亦或带经锄。\n古有神农学，今传泛胜书。\n野儒曾涉猎，未可议空疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其十","author":"刘克庄","text":"凋邑租符紧，荒祠木偶新。\n吏谈长官健，巫托社公嗔。\n烹犬看承客，吹螺降送神。\n二豪怀肉返，去诳别村人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其三","author":"刘克庄","text":"此日田舍汉，当年省禁臣。\n丝纶隔世事，蓑笠暮年身。\n龙弃真初祖，羊求在近邻。\n南朝足名士，吾独爱吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其一","author":"刘克庄","text":"闽土资生少，农家作苦多。\n尚能盖牛屋，未肯入鸡窠。\n社里戴花舞，原头拾穗歌。\n设令生汉代，堪冠力田科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其六","author":"刘克庄","text":"畴昔元疏懒，如今转耄荒。\n都忘高士传，仅记庶人章。\n栖亩牛羊饱，开囷雀鼠忙。\n老农识惭愧，先议道官仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其七","author":"刘克庄","text":"小榭无丹雘，低墙略塈茨。\n辛勤趋穑事，快活过花时。\n懒献嘉禾颂，闲赓滞穗诗。\n幸生太平世，不乐复何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其五","author":"刘克庄","text":"小筑三家聚，新篘万户春。\n昔豪几腐胁，今病罕沾唇。\n太古华胥氏，丰年畏垒人。\n超然市朝外，未易葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰书事二首 其二","author":"刘克庄","text":"往昔曼卿曾夺敕，后来同甫竟成名。\n草茅匹士谋身拙，槐棘诸公议法平。\n囚服若为探禹穴，明时定不血秦坑。\n何当拜舞鸡竿了，沽酒刲羊与压惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰书事二首 其一","author":"刘克庄","text":"捷书犹湿谤书随，太息斯人得祸奇。\n文举旧曾称一鹗，退之亦自喜孤罴。\n彼谗罔极身罗织，吾意怜才力发丝。\n老去眼中神骏少，诸君莫怪道林师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰春日二首 其二","author":"刘克庄","text":"学问过时已悍坚，文章垂老未精专。\n薰琴何患无赓载，秋扇明知有弃捐。\n旧读温寻浑不记，新吟锻鍊久方圆。\n此生幸不当词翰，免被人嘲上水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰春日二首 其一","author":"刘克庄","text":"买牛搜粟向蛮烟，衰病安知璧偶全。\n使者召归曾四辈，臣之得罪又三年。\n柳刘漏语谁云尔，绛灌怜才定不然。\n纵使有泉堪洗耳，先生此愧若为湔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅元月二首 其二","author":"刘克庄","text":"七帙骎骎病鲜欢，君恩犹许备祠官。\n婢传稚子屠苏酒，奴笑先生苜蓿槃。\n自叹管君今老秃，更悲庞嫂不团栾。\n新年辜负如筛饼，炮附煨姜胃尚寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅元月二首 其一","author":"刘克庄","text":"少小逢场老罢休，衰残更阅几春秋。\n瓜牛庐有亲情贺，罗雀门无谒刺留。\n梦断玉皇香案畔，诗成田舍火垆头。\n赐驹牵与萧京兆，归去姑乘款段游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲寅岁除","author":"刘克庄","text":"老戴黄冠备扫除，空餐忽忽岁云徂。\n系衔每愧监临旷，书考犹欣过犯无。\n地主多情馈椒酒，阍人失职废桃符。\n绝怜榾柮通红火，不与吾儿共地炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹿寺","author":"刘克庄","text":"岁晚霜林落叶稠，携家来作鹿门游。\n偈言恍似前生说，诗稿犹烦侍者收。\n身上征衫抛未得，山中灵药采无由。\n十年不独行人老，入定高僧白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹤故居","author":"刘克庄","text":"天稔中原祸，朝分党部争。\n当年谁宰相，此地著先生。\n故国难归去，新巢甫落成。\n如何鲸浸外，更遣打包行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"目疾一首","author":"刘克庄","text":"疾起自肝家，眵昏认物差。\n昔如虹贯日，今隔雾看花。\n暝鹊惊飞匝，凉蟾瞥露些。\n庙堂见章奏，应笑字攲斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"目眚","author":"刘克庄","text":"一秋窗下少书声，目眚缠绵久未平。\n大德三麻如昨日，善和千卷付来生。\n聃兮虽视如无见，藉也于心固不盲。\n吹却残灯抛蠹简，拥衾危坐待天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石鼓","author":"刘克庄","text":"石鼓名天下，州庠画不如。\n古祠犹汉旧，石刻半唐馀。\n翠巘供凭几，寒江照读书。\n恨余非楚产，来借一房居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示儿","author":"刘克庄","text":"瓜芋村边一亩宫，闭门不复问穷通。\n生羞奏技伶人里，死怕标名狎客中。\n讲学有谁明太极，吟诗无路和薰风。\n身今老矣空追悔，但祝吾儿勿似翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示同志","author":"刘克庄","text":"旋入洛中新保社，稍增汾曲旧田庐。\n市朝幸免髡钳我，尸祝何烦俎豆予。\n静看芭蕉身不实，健忘椰子腹无书。\n故人远致郫筒饷，待约邻翁共破除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示同志一首","author":"刘克庄","text":"满身秋月满襟风，敢叹栖迟一壑中。\n除目解令丹灶坏，诏书能使草堂空。\n岂无高士招难出，曾有先贤隐不终。\n说与同袍二三子，下山未可太匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示观老","author":"刘克庄","text":"住山仍黑瘦，瓶锡极萧然。\n顶发千茎雪，跏趺一缕烟。\n禅堪拈出众，诗亦长于前。\n烧尽西窗烛，相看各不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示沂孙","author":"刘克庄","text":"过去光阴电莫追，镜中非复旧须眉。\n已拚眸子难重朗，犹幸心官可苦思。\n太极旋闿无极义，极玄更有又玄诗。\n此篇若问何人作，向道山中老古锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示画者","author":"刘克庄","text":"眉宇巑岏鬓秃残，愧君模写向冰纨。\n削瓜古有形相肖，掷果今无众聚观。\n且可夷犹狎鸥鹭，不消夭矫比龙鸾。\n去为将相开生面，莫貌山翁骨相寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示强甫","author":"刘克庄","text":"昔受浮丘伯密传，骎骎辕固伏生年。\n试横牧笛花间饮，胜著朝冠柏下眠。\n天上锦袍曾夺得，山中石砚又磨穿。\n生来羞舐淮南鼎，且戏尘寰作地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"穴蚁一首","author":"刘克庄","text":"穴蚁能防患，常于未雨移。\n聚如营洛日，散似去邠时。\n断续缘高壁，周遭避浅池。\n谁为谋国者，见事反伤迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"刘克庄","text":"綵胜矜时节，其如两鬓皤。\n所欣解馀冻，已觉扇微和。\n牧竖眠吹笛，渔翁起晒蓑。\n土牛蹄角赤，休咎果如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春一首","author":"刘克庄","text":"又见城门出土牛，鸡肤龟手稍和柔。\n懒陪内史吟人日，不记灵均降孟陬。\n病与风光犹未隔，老逢节序只添愁。\n可怜满镜星星发，欲戴春幡却自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春二首 其一","author":"刘克庄","text":"恰归旧隐再逢春，村巷荒凉草没人。\n犬坏园中门作窦，盗规坟上树为薪。\n官如巫祝难羞贱，家似樵渔敢讳贫。\n闻说邻醅低价卖，病夫一滴未沾唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春二首 其二","author":"刘克庄","text":"今岁春盘始住家，也胜羁旅走天涯。\n圃晴菜拆经霜甲，林暖梅飞遍地花。\n闲有工夫忧世事，老无勋业惜年华。\n近来死尽吟诗者，得句聊从野叟誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"训蒙二首 其二","author":"刘克庄","text":"少喜浮名谬激昂，晚温故读稍精详。\n易全何患乾坤毁，骚在堪争日月光。\n漆简字更经学误，玉台体出选诗亡。\n残年欲尚鞭吾后，谁道先生已耄荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"训蒙二首 其一","author":"刘克庄","text":"汉魏以前犹古雅，宋齐而下稍淫哇。\n剪裁贫女机中素，扑卖都人担上花。\n括帖不离初学记，管蠡乌睹大方家。\n世间跛鳖难鞭策，安得龙媒出渥洼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记医语","author":"刘克庄","text":"身如桐半死，天尚罚枯株。\n昔作红颜子，今为碧眼胡。\n迷蒙银海眩，攲侧玉山扶。\n惜尚名书画，缄縢可谓愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记事","author":"刘克庄","text":"辇路香风吹软尘，拥途士女看朱轮。\n朝为赫赫大京兆，暮作栖栖逆旅人。\n姬院肉屏俄顷散，帝城眉样一番新。\n惟应唤醒茅檐叟，长驾柴车戴幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记将李事","author":"刘克庄","text":"藐予小子衰残迫，惜我先人老寿稀。\n厚币能牵四皓出，画图幸送二疏归。\n子玄亘古芬芳史，伯始终身粪上讥。\n颖叔资深俱已矣，岂无来者判聃非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦","author":"刘克庄","text":"昔梦趋旃厦，巍冠预讲论。\n孤忠鄙张禹，薄命类虞翻。\n稍觉刍言戆，徐瞻玉色温。\n放臣绝朝谒，无路可酬恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记颜二首 其二","author":"刘克庄","text":"恰才犹两髧，倏忽已双皤。\n昔似卫洗马，今成郭橐驼。\n窝中老康节，龛里活弥陀。\n纵使加冠剑，其如丑怪何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记颜二首 其一","author":"刘克庄","text":"不冻肩山耸，方暄鬓雪浓。\n或云寿者相，敢道德人容。\n补助无灵药，扶持赖瘦筇。\n傍观莫相笑，年事合龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邛杖","author":"刘克庄","text":"珍重邛山鹤膝枝，十年南北惯携持。\n扶登石壁宁嫌峻，拄过溪桥肯避危。\n昔涉畏途麾不去，今行平地弃如遗。\n主人尚要防衰老，会有重拈入手时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相信庵赵公哀诗五首 其五","author":"刘克庄","text":"丙午遭逢瑟改调，先皇记忆忝弓招。\n明扬虽曰由师锡，密启端因侍燕朝。\n早识武侯比龙凤，晚为公旦序鸱鸮。\n吾贫岂是无鸡酒，恨不携将柏下浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相信庵赵公哀诗五首 其四","author":"刘克庄","text":"自是乾坤间气生，吾犹识此万人英。\n博求骏骨千金致，忽割牛心四座惊。\n古有诗人悼房琯，今无壮士哭田横。\n遥知岳市新华表，过者徘徊下马行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相信庵赵公哀诗五首 其三","author":"刘克庄","text":"出为董统今韩范，入告忠嘉古卨夔。\n白刃在前裹疮战，黄麻拜右掉头辞。\n去犹耿耿心存阙，老尚堂堂表出师。\n盖世英豪嗟已矣，八哀吟罢有馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相信庵赵公哀诗五首 其二","author":"刘克庄","text":"忆昔东淮羽檄驰，非公受钺国几危。\n春潮全藉孤舟渡，厦屋曾将一木支。\n著白接䍦麾猛将，坑红衲袄等婴儿。\n扬州遗老闻新讣，犹说平山奏凯时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相信庵赵公哀诗五首 其一","author":"刘克庄","text":"粤从宣靖至炎兴，粉饰湖山苑圃增。\n列圣久无师入洛，三京初有使朝陵。\n摧锋指日酋传首，返旆终身气拂膺。\n逸少兴公虚论胜，百年机会更谁乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲晦昆仲求近稿戏答二首 其二","author":"刘克庄","text":"辛苦搜肠更撚须，适资谈者指瑕瑜。\n中郎碑好犹名愧，吏部铭高未免谀。\n馀忿燕泥能道否，遗言鹤唳可闻乎。\n从今一字休思索，千古文人一律愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲晦昆仲求近稿戏答二首 其一","author":"刘克庄","text":"过去生平一念差，偶因薄技忝清华。\n宁吟韩子将归操，不草韦郎起复麻。\n绮语预愁无间狱，纶言见笑当行家。\n而今老矣全瘖了，匹似枯株不著花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲晦监簿和放翁七十三吟三篇华予初度走笔□韵答之 其一","author":"刘克庄","text":"镜中雪鬓数茎新，归作田间负耒民。\n仕五十年难讳老，封三百户敢嫌贫。\n诸无物实师庞蕴，万苦非真试子春。\n到得邢杨遭勘辨，始知铁汉是全人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲晦监簿和放翁七十三吟三篇华予初度走笔□韵答之 其二","author":"刘克庄","text":"诸公衮衮几番新，留得淳熙一老民。\n就枕惊回鸡搅睡，委巢飞去燕欺贫。\n贪生尚惜桑榆景，排闷全凭曲米春。\n赖有平生金石友，年年岁岁记陈人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲晦监簿和放翁七十三吟三篇华予初度走笔□韵答之 其三","author":"刘克庄","text":"□□下饰墨尤新，以史名官不治民。\n后死漫为诸老殿，粗完深愧两翁贫。\n譬牛山木全高寿，让马塍花斗早春。\n兀坐空斋形对影，载醪裹饭更无人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先儒","author":"刘克庄","text":"先儒绪业有师承，非谓闻风便服膺。\n康节易传于隐者，濂溪学得自高僧。\n众宗虚誉相贤圣，独守遗编当友朋。\n门掩荒村人扫迹，空钞小字对孤灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"全州","author":"刘克庄","text":"寂寞全州路，家家荻竹扉。\n异僧留塔在，过客入城稀。\n传舍临清泚，官亭占翠微。\n沙头泊船者，多自岭南归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]