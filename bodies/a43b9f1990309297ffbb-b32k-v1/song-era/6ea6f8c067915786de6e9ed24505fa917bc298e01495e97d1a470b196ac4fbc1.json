[{"title":"题赚兰亭图","author":"刘克庄","text":"山阴茧纸见者希，辨才传之于永师。\n行年八十手不释，栖之梁上鬼莫窥。\n虬须天子欲得之，威以祸福僧诡辞。\n智勇至此无所施，相国房公乃设奇。\n东台御史奉诏驰，易服变姓谒老缁。\n止客置醴因联诗，评书订画犹埙篪。\n稍稍益狎不见疑，卷而怀之若拾遗。\n须臾□都得台移，都督传诏来龙墀。\n僧绝复苏成白痴，始悟学究即绣衣。\n文皇如尧房如夔，磊磊落落两曜垂。\n谲取一帖安肯为，帖归天上神护持。\n拓本之价犹不赀，他日昭陵以自随。\n温韬掘者果是非，世人空宝定武碑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"橘花","author":"刘克庄","text":"一种灵根有异芬，初开尤胜结丹蕡。\n白于薝卜林中见，清似旃檀国里闻。\n淡月珠胎明璀粲，微风玉屑撼缤纷。\n平生荀令熏衣癖，露坐花间至夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠无庵于道人六言一首","author":"刘克庄","text":"□无尽空诸有，孤立何须同参。\n道人不置产业，寄迹孟家废庵。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠东塔玙老","author":"刘克庄","text":"南寺上人禅学苦，东冈老子法筵开。\n遥知大设伊蒲供，送汝挑包去捞斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠四明余天与","author":"刘克庄","text":"七聚惟莆最僻穷，四明狂客此飘蓬。\n圣门性命言犹罕，俚俗支干说未通。\n子术纵高于季主，吾年已老似申公。\n贫家无处撰车马，草草搜诗亦欠工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张南金二绝 其二","author":"刘克庄","text":"韩慥林开妙不传，请君自算小行年。\n公卿谁是挥金者，大半将诗准卦钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠郭相士俊夫","author":"刘克庄","text":"东郭无全履，南辕似转蓬。\n自惭老中垒，莫误小林宗。\n若见同胞子，为言秃鬓翁。\n衰年不堪玩，一病一龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠菊庵李道人","author":"刘克庄","text":"万言万当眼睛毒，一裘一盂口体足。\n不共孤竹子争薇，却与柴桑翁争菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"颠危","author":"刘克庄","text":"老梢虑航危，隆栋忧厦颠。\n危欠维楫尔，颠将覆压焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戴秀岩","author":"刘克庄","text":"兹岩视诸峰，厥状尤峥嵘。\n旧为碧藓封，新有朱栈横。\n縻腰尚恐坠，束炬劣可行。\n外狭中乃宽，始闇俄忽明。\n仰视神魄悸，俯顾形壳轻。\n遂览丹炉基，微闻玉鼓声。\n源深足力尽，路黑云气生。\n不辨昼夜分，恍疑世代更。\n尝闻学神仙，所得由专精。\n岂吾诸名士，羡彼一老兵。\n欣然约同志，嗣此将寻盟。\n安知无白鹿，绝顶来相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"警斋吴侍郎再和余送行及居厚弟诗各次韵 其一","author":"刘克庄","text":"朝阳凤咮更谁同，回首啾啾笑候虫。\n洛下二龙闲马吕，建中两豸数邹龚。\n呼来伯雅聊排闷，叱去奴星莫送穷。\n华发未交衰飒甚，敢鸣破釜答编钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"警斋吴侍郎再和余送行及居厚弟诗各次韵 其三","author":"刘克庄","text":"曾听仙韶宴玉津，岂知金弹忽危身。\n谁为高树凤凰语，无奈雕笼鹦鹉嗔。\n拙射元非落雕手，村眉难比扫蛾人。\n新裁白纻衣如雪，一点休教染洛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"警斋侍郎舟和放翁五言过奖衰朽且示雄文二编次韵一首","author":"刘克庄","text":"熟读公诗文，高出骚选前。\n蹇余相追逐，严句入杜编。\n里鼓闻咸池，山歌混葛天。\n刀圭靳付授，分寸难扳缘。\n偶逢浮丘伯，月下吹箫眠。\n凤咮不可和，蚓窍殊自怜。\n披我云锦裳，易去短褐穿。\n啖我玉井藕，洒然渴肺痊。\n回澜使东之，斡天令左旋。\n斯文恃砥柱，诸老随游川。\n交游愧忝窃，薰摘劳结悁。\n当论先后觉，宁较大小年。\n已得渥洼骏，共登昆崙颠。\n指点归宿处，目览非耳传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"警斋侍郎和放翁与茶山五言寄余次韵一首","author":"刘克庄","text":"髫龀参诸老，辱置书册前。\n上起马本纪，下迄李续编。\n积勤迫榆景，扶病登木天。\n貌丑况古妆，臂短非善缘。\n时人讪晚谬，弟子嘲昼眠。\n堕甑懒回顾，弃扇羞乞怜。\n众皆惊曲径，余惟泥方穿。\n平生忧世病，华佗不能痊。\n仰即丹凤鶱，俯视磨蚁旋。\n居常哂触蛮，安肯分济川。\n舐鼎堪骨蜕，载质从心悁。\n何当坐一月，大胜读十年。\n惜哉已耄及，晨镜雪满颠。\n仙家能返童，肘后傥能传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□□□□ 其一","author":"刘克庄","text":"□□□□□□□，□□□□□□□。\n□□□□□□味，一旦鸣阳警众聋。\n绝塞择栖托羁旅，行台设网揽英雄。\n朝家记忆超宗父，便可吹嘘入禁中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□□□□","author":"刘克庄","text":"□□□□□□□，□□□□□□□。\n□□□□□□室，殿耆英社独灵光。\n锦袍争看前供奉，白发谁怜老遂良。\n丛稿如山千载后，尚堪拈出补诗亡。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□□□□□□□卷后","author":"刘克庄","text":"□□□□□□□，□□□梁一点尘。\n绕树都忘寒彻□，□□□□□□□。\n□□客至徘徊月，不怕天嗔漏□□。\n□□□□□□□，咏梅合属姓林人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"䂬陈贡士挽诗","author":"刘克庄","text":"早佩廉丞训，中偕计吏行。\n那知身啬报，仅见子成名。\n表里高阳氏，铭阡辅嗣孙。\n他年燎黄诰，亦足慰幽明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题真仁夫画卷","author":"刘克庄","text":"草木黄落，水云莽苍。\n孤舟卸帆，冻雁失行。\n昔余远游，沿漓溯湘。\n堠长店疏，仆痡马僵。\n行李萧然，有诗满囊。\n今其老矣，宁志四方。\n抚卷追思，历历不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其十","author":"刘克庄","text":"泛爱亲疏平等，任吟古律不拘。\n武公耄犹戏谑，白公老尚嗫嚅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其九","author":"刘克庄","text":"慕赤松子辟谷，学黄冠师餐霞。\n更无半空鸾鹤，何异深山龟蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其八","author":"刘克庄","text":"心炎宠辱交战，骨朽是非乃公。\n物议粪土伯始，史笔芳馨两龚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其七","author":"刘克庄","text":"红绿各萌春意，朱紫争叙年劳。\n钟馗七老八大，无人与换蓝袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其六","author":"刘克庄","text":"竹林下沈酣者，洛社中起舞人。\n与籍糟汉通谱，是灌花翁后身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其五","author":"刘克庄","text":"早退似见几者，晚缪可追悔哉。\n已戴华阳巾去，肯扶灵寿杖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其四","author":"刘克庄","text":"傍人贺我过省，此老矍然失惊。\n不曾西山纳卷，如何南宫奏名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其三","author":"刘克庄","text":"新贵九迁三接，故交百不一存。\n老子进爵曰子，小孙娶妇生孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其二","author":"刘克庄","text":"年八十官三品，酒一斗诗百篇。\n羽化尸解等耳，宫锦渔蓑偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十八咏六言十首 其一","author":"刘克庄","text":"大绛县人五岁，小鲁申公二年。\n楞严已难笔受，尚书尚可口传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又六言二首 其一","author":"刘克庄","text":"韶颜譬槿花尔，枵腹仅椰子如。\n不知作千年调，谁教盛万卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又六言二首 其一","author":"刘克庄","text":"昏主非姬不饱，内嬖废嫡可悲。\n骊女逐金玦子，玉环养锦绷儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又六言二首 其二","author":"刘克庄","text":"有载书盟三友，无文章送五穷。\n怯懦宁出胯下，清狂羞入裈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又六言二首 其一","author":"刘克庄","text":"群雄走野逐鹿，一士入海骑鲸。\n不听安期画策，便知子羽无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又六言二首 其二","author":"刘克庄","text":"寡女画眉通好，邻姬捧心效颦。\n况有黄金买赋，不羡碧玉嫁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又六言二首 其二","author":"刘克庄","text":"贵栾大佩六印，赋侏儒俸一囊。\n曼倩面有饥色，蟠桃三度偷尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其九","author":"刘克庄","text":"忧患长我意智，苦乐随渠业缘。\n贵人银烛按乐，书生纸裹见钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其八","author":"刘克庄","text":"浮云月之障碍，蒙气日之翳膜。\n已把太玄覆瓿，更将三传束阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其七","author":"刘克庄","text":"自遣病魔病竖，不干药上药王。\n洗眼菊泉旧本，照怀蓉月新凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其六","author":"刘克庄","text":"入槐见蚁群聚，赋芧觉狙怒喜。\n脱离黑暗狱中，透入光明境里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其五","author":"刘克庄","text":"竹简定隶古字，黑屏刻月蚀诗。\n嗜学心无止法，读书眼有还时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其四","author":"刘克庄","text":"康术鹰眼不化，处仲蜂目亦露。\n我自有观人诀，汝勿为相祖误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其三","author":"刘克庄","text":"寒儒赖有雪映，贫女那无绩光。\n千眼今依佛阁，重瞳昔侍舜廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其二","author":"刘克庄","text":"学仙烧汞成灰，学书埋笔为冢。\n羡关尹喜见聃，爱希氏子瞻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和后九首 其一","author":"刘克庄","text":"觉性灵明自若，本心利欲食之。\n大观如梦如幻，小视坐忘坐驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨六言四首 其四","author":"刘克庄","text":"平陆莽为巨浸，晴空变作漏天。\n明朝是小暑节，重霉必大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨六言四首 其三","author":"刘克庄","text":"初疑瓠子堤决，又恐娲皇石穿。\n已是吹翻茅屋，那堪流了葑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨六言四首 其二","author":"刘克庄","text":"汗体方遥团扇，粟肤俄索裌衣。\n束缊尽驱蚊去，捲帘莫碍燕归。","collection":"宋","n