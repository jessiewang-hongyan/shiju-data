f84d192fe5294295f79689","path":"宋_1.csv","pointer":33330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言二首赠月蓬道人 其一","author":"刘克庄","text":"我与蒙倛相类，君似季咸而非。\n老子曾传口诀，道人勿泄天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言二首赠月蓬道人 其二","author":"刘克庄","text":"希夷所见良是，麻衣之说未然。\n几人能急流退，这汉即平地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言三首 其一","author":"刘克庄","text":"表贺赤乌白兔，韦布披襟巨题。\n定价堪提鳌岭，逢辰不让龙溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言三首 其三","author":"刘克庄","text":"南塘登极数袁，平围册后尾联。\n已矣诸老绝笔，勉哉吾子著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言三首 其二","author":"刘克庄","text":"锦机组织尤巧，纸田收获甚微。\n即今束阁藏起，多时扫阁载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言三首 其一","author":"刘克庄","text":"不识平康坊里，多在村学堂中。\n安得金钱买笑，只堪夏楚训蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33336,"sha256":"18413bf73