[{"title":"人日即事","author":"陈允平","text":"春寒犹拨地炉灰，门巷萧条客不来。\n特有落梅三四点，晚风吹上石棋台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小楼","author":"陈允平","text":"寒空漠漠起愁云，玉笛吹残正断魂。\n寂寞小楼帘半捲，雁烟蛩雨又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其三","author":"陈允平","text":"日出华山阳，月出庐山岗。\n巫山云漠漠，雁山烟苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中吟 其七","author":"陈允平","text":"西风凉萧萧，雁过秋空高。\n时有岩桂发，落叶飞长皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"陈大用","text":"闲拈红叶欲题诗，待得诗成又懒题。\n心事不随流水去，月明人在赤桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题 其二","author":"陈允平","text":"千树琅玕碧玉梢，秋声半夜浙江潮。\n小庭寂寞无人到，谁与同吹月下箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题 其一","author":"陈允平","text":"鲛绡帘捲锦屏开，弱柳丝丝拂吹台。\n闲品琵琶不成调，落花飞趁晓风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长门曲","author":"陈允平","text":"紫凤双飞晓镜台，玉楼春冷燕空来。\n蛾眉不及宫前柳，一度春风一度开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台上","author":"陈允平","text":"客舍新移近鲁台，翛然一榻少尘埃。\n丁宁黄耳休惊吠，不是闲人定不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失鹤","author":"陈允平","text":"顶上新成九转丹，衔花日日到诗坛。\n夜深飞上云霄去，华表月明风露寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归燕","author":"陈允平","text":"王谢堂前柳树苍，玉京坟上藓花黄。\n无情又逐东风去，落日朱帘几断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伍炼士松隐居","author":"陈允平","text":"树顶危巢堕鹤翎，凌霄花白女萝青。\n无朝无暮云烟起，时有人来采茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先天李姆庙","author":"陈允平","text":"毓圣功成宴太清，曾遗双履下清冥。\n隧碑重纪先天德，犹是祥符御制铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后土庙","author":"陈允平","text":"尘拥妆台翡翠翘，琼花开尽玉魂销。\n昆崙山上天风落，二十四桥吹洞箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戍妇","author":"陈允平","text":"梧桐叶落雁来时，见说沙场未解围。\n夜夜灯前做针线，倩谁边上寄寒衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"陈允平","text":"软红尘里度韶华，杨柳桥边旧酒家。\n燕子不归春渐老，东风开尽刺桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江南谣","author":"陈允平","text":"柳絮飞时话别离，梅花开后待郎归。\n梅花开后无消息，更待明年柳絮飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观猿","author":"陈允平","text":"挂石攀云日半斜，乱山深处饱烟霞。\n香林月满僧归去，啼落春风几树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陈允平","text":"重重帘幕燕翩翩，尘锁朱楼十四弦。\n榆火渐催寒食节，海棠花畔缚秋千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴山雪霁","author":"陈允平","text":"九天宫阙春风满，陆地楼台夜月寒。\n铁笛一声吹雁落，片云不到玉阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茅苇","author":"陈允平","text":"白苇黄茅几断魂，数家鸡犬不相闻。\n江南多少朱门闭，桑柘春深绿似云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词","author":"陈允平","text":"三十六宫春漏长，隔帘时送御楼香。\n倚笼尽日教鹦鹉，为我君前说断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故宫","author":"陈允平","text":"琼台玉馆照青红，梦断思陵桧柏风。\n三十二门金锁合，年年春雨扫梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春词","author":"陈允平","text":"杨柳春风三月三，画桥芳草碧纤纤。\n一双燕子归来后，十二红楼捲绣帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春闺","author":"陈允平","text":"寂寞梨花院落闲，远山愁入两眉弯。\n黄金络索珊瑚坠，独立春风教白鹇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓","author":"陈允平","text":"晓风猎猎捲芭蕉，帘幕深深燕子巢。\n十二画栏都倚遍，一双蝴蝶上花梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春塘","author":"陈允平","text":"春塘雨歇曙莺啼，坊院深闲竹树西。\n静倚绿窗看漏水，野花开到白棠梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺情","author":"陈允平","text":"闲拈花片贴纱窗，绣幕斜飞燕子双。\n细数归期相次近，倚楼日日望春江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚楼","author":"陈允平","text":"金虬熏尽鹧鸪班，独上层楼倚画栏。\n满院梨花香寂寞，隔帘风雨正春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿鹭","author":"陈允平","text":"西风历历起寒莎，皆立林宵雪一窠。\n三十六陂烟水阔，夜深无奈月明多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王尊师","author":"陈允平","text":"彩云缭绕七香车，洞里神仙炼紫霞。\n华表鹤归春寂寂，东风吹尽碧桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵庆御","author":"陈允平","text":"十年一别双溪路，君自江南我浙东。\n彼此有书无雁寄，祇应清梦与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨花","author":"陈允平","text":"流莺偷入未央宫，望断昭阳信不通。\n寂寞雨声寒食夜，一枝香泪泣东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盘陀","author":"陈允平","text":"盘陀石上看松眠，薜荔凌霄结紫烟。\n何处鹤声惊梦醒，一双飞起茯苓仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿琐","author":"陈允平","text":"绿琐银台烛焰红，月痕斜过井梧东。\n背人约住黄金钏，轻札香罗护守宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪窦","author":"陈允平","text":"千年松树冻欲死，夜半老僧眠树根。\n一片海云吹不散，白龙拖雪上昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"堤上柳","author":"陈允平","text":"暗黄摇曳六桥云，万户千门一日春。\n休把柔条都折尽，明朝多少出城人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登西楼怀汤损之","author":"刘学箕","text":"杨柳飘飘春思长，绿桥流水绕宫墙。\n碧云望断空回首，一半栏干无夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春","author":"陈允平","text":"柳外宫莺啭晓寒，万花开尽正春残。\n沉香亭北栏干曲，独抱琵琶看牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠律师","author":"陈允平","text":"传来二十五条衣，昼夜修行昼夜持。\n老去任教零落尽，猕猴偷□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下第怀楼寿朋","author":"陈允平","text":"百尺丹梯拟共登，共登天上最高层。\n南山有雾空藏豹，北海无云可化鹏。\n勋业十年尘里镜，诗书万卷雨前灯。\n桃花开尽不归去，又逐春风过武陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山房","author":"陈允平","text":"轩窗四面开，风送海云来。\n一阵催花雨，数声惊蛰雷。\n蜗涎明石凳，蚁阵绕山台。\n此际衣偏湿，熏笼著麝煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己酉秋留鹤江有感","author":"陈允平","text":"宾鸿几过淀山湖，夜夜西风转辘轳。\n苜蓿草衰江馆静，枇杷叶老石泉枯。\n曲终明月闲歌扇，病去寒灰满药炉。\n客梦不堪千里远，故园篱菊正荒芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马塍道上","author":"陈允平","text":"闲拖瘦竹筇，独步马塍东。\n鸟影青山外，春愁碧树中。\n麦潮风化蝶，樱熟雨生虫。\n莫过溪头去，溪头多落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰乐楼初成","author":"陈允平","text":"红尘飞不到阑干，十二朱帘捲暮寒。\n上苑莺啼花木暗，六桥人散水云宽。\n春风玉佩骖黄鹤，夜月琼箫驻紫鸾。\n檐外青青杨柳色，几回曾向画船看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云间洞天","author":"陈允平","text":"门掩青松间绿槐，一奁图画自天开。\n朝霞炼药黄金井，夜月吹笙白玉台。\n树老有枝皆薜荔，地闲无处不莓苔。\n数声野鹤惊残梦，疑是神仙出洞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆诸侄","author":"陈允平","text":"万里经年别，临分手重携。\n地寒冬气早，家远暮云低。\n有信秋凭雁，无眠夜听鸡。\n满怀霜露感，不隔故山西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四明洞天","author":"陈允平","text":"四壁玲珑耸石楼，四窗云气拥仙游。\n半空星斗浮天井，一洞烟霞透沃洲。\n蜥蜴现时曾咒雨，猕猴啼处客悲秋。\n他年定作山中隐，肯向红尘白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对烛","author":"陈允平","text":"忽忆巴山夜，西窗风雨寒。\n自怜清影独，谁识寸心丹。\n草长花犹在，香销泪不乾。\n海棠贪睡去，惆怅五更残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲冬南楼野望","author":"陈允平","text":"绣幕香温生暮寒，淡烟漠漠水漫漫。\n吟残庾岭梅千树，梦绕湘江竹万竿。\n风捲乱鸦栖古塔，雪迷孤雁落前滩。\n一声玉笛人何所，更上南楼独倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼","author":"陈允平","text":"怀古心情独倚楼，荻花枫叶满江秋。\n地雄吴楚东南会，水接荆扬上下流。\n铁瓮百年春雨梦，铜驼万里夕阳愁。\n西风历历吹征雁，又带边声过石头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江村","author":"陈允平","text":"草舍蔬畦绕，柴门竹径通。\n断云遮落日，细雨湿斜风。\n野艾抽花碧，山茄带叶红。\n烟深南浦远，难认楚江枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江馆野望","author":"陈允平","text":"江边雁过秋，江上暮云愁。\n岭曲山横转，潮回水逆流。\n乱莎行石蟹，残荻卧沙鸥。\n黯淡三更月，何人独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江阔","author":"陈允平","text":"江阔雁声遥，何人共寂寥。\n青天不可问，明月若为邀。\n侠士誇骑鹤，蛮奴学射雕。\n平生堂下柳，聊复伴秋宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芝山","author":"陈允平","text":"春风几树石楠开，谁采灵芝去不回。\n彭蠡水分双港落，匡庐云度五峰来。\n钟沉古寺僧初定，月堕长松鸟自哀。\n堪叹昔人携酒地，断碑无主卧苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西兴","author":"陈允平","text":"西兴潮半落，渔浦日初昏。\n岳面云收脚，沙头浪积痕。\n楼钟鸣野寺，船鼓入江村。\n回首长安路，归心几断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖暮春","author":"陈允平","text":"云山叠叠树重重，浙水迢遥客梦中。\n啼鴂数声春去日，落花满地夜来风。\n松关鹤立吟坛静，竹院僧眠丈室空。\n明日马蹄何处所，夕阳芳草画桥东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观弈象棋","author":"陈允平","text":"阵势频分合，机锋互应酬。\n马飞关塞月，炮落汉天秋。\n不问知心友，翻成敌面仇。\n谁能劳胜负，独立大江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许宣平祠","author":"陈允平","text":"开元遗逸士，终老紫阳樵。\n市上人犹说，山中隐可招。\n乾坤双草履，日月一花瓢。\n堪笑骑鲸者，相逢弱水遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过田家","author":"陈允平","text":"村南啼布谷，村北响缫车。\n隔浦卖鱼市，傍桥沽酒家。\n野花朝日暖，溪柳背风斜。\n又过东邻去，东邻采菊芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过钓台作","author":"陈允平","text":"双台屹屹几春秋，千古高风一钓钩。\n越岭有云山北障，桐江无浪水东流。\n雪深黄叶埋寒虎，烟暖青莎卧白鸥。\n汉业已随宫树老，月明长到客星楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过姚秋江钓矶","author":"陈允平","text":"莎草离离碧树闲，祇疑曾是子陵滩。\n槿花篱落虫声碎，芦叶汀洲雁阵寒。\n江上浪平潮正熟，渡头人去月初残。\n夜深不管蛟龙睡，独对西风把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵郡舍","author":"陈允平","text":"花飞石上班，水落白云湾。\n帘捲千重树，窗开四面山。\n鼓声鱼市近，旗影讼庭闲。\n满目皆吟思，残阳缥缈间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别何橘潭","author":"陈允平","text":"驻马赤栏桥，馀寒著柳条。\n舟车富阳路，风雨浙江潮。\n惜别津亭暮，思归故国遥。\n临行莫惆怅，回日定花朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴江道上","author":"陈允平","text":"夜半扁舟出洞庭，客帆初挂早潮平。\n社风才起海鹰至，岚雾未收江鹄鸣。\n吴岫乱云擎古塔，楚皋寒叶拥荒城。\n垂虹桥外天连水，无限别离生杜蘅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀潘鄮屋","author":"陈允平","text":"洛阳才解佩，过眼忽秋分。\n四海一明月，千山共白云。\n雁烟迷晓树，虫露湿香芹。\n满纸相思字，临风欲寄君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"补陀山","author":"陈允平","text":"茫茫东海东，古洞石玲珑。\n蓬岛三山近，华夷一水通。\n鱼龙多变化，日月自虚空。\n此境元非幻，人心隐显中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侍赵开府夜宴","author":"陈允平","text":"剩陪华佩醉蟠桃，杨柳飘飘拂午桥。\n夜月楼台行锦障，春风帘幕捲红绡。\n歌传杏苑黄金缕，乐奏梨园紫玉箫。\n银漏滴残珠履散，踏花归去路迢遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侍赵别驾宴寿乐堂","author":"陈允平","text":"别驾移樽宴草堂，四轩帘幕捲斜阳。\n芰荷香满鸳鸯宿，杨柳阴浓翡翠藏。\n风过水亭秋尚热，月侵山阁夜偏凉。\n更阑酒尽不知去，坐看晓星飞玉潢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侍谢立斋小酌湖楼","author":"陈允平","text":"风捲珠帘客佩清，杜鹃啼老送春声。\n水浮亭馆花间出，船载笙歌柳外行。\n千里夕阳归梦远，六桥飞絮马蹄轻。\n栏干倚遍暮天阔，烟树一钩新月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泊","author":"陈允平","text":"停舟野渡头，客路恨悠悠。\n叶落风千树，钟残月半楼。\n芦花双过雁，莎草独眠鸥。\n山鬼烧青火，飞来照髑髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姑苏台","author":"陈允平","text":"高楼三百尺，落日几登临。\n越国一尝胆，吴娃频捧心。\n野猿窥燐火，宫燕语秋霖。\n坐久忽闻笛，五湖烟水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姑苏馆","author":"陈允平","text":"楚岫高低接太行，吴江渺漠下沧浪。\n秋城霜满苇花白，夜馆月寒莎草黄。\n芳苑鹿台初解佩，故宫鸾阁尚鸣珰。\n五湖一叶扁舟去，十二西楼几夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明皇按乐图","author":"陈允平","text":"日日霓裳宴綵楼，三千歌粉侍宸旒。\n月明宫殿双龙伏，云拥箫韶九凤游。\n翠袖半笼金约臂，宝钗斜坠玉搔头。\n不知舞到弓弯处，一拍春风一拍愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]