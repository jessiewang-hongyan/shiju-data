[{"title":"答陈述古二首 其二","author":"苏轼","text":"小桃破萼未胜春，罗绮丛中第一人。\n闻道使君归去后，舞衫歌扇总成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张安道乐全堂","author":"苏轼","text":"列子御风殊不恶，犹被庄生讥数数。\n步兵饮酒中散琴，于此得全非至乐。\n乐全居士全于天，维摩丈室空翛然。\n平生痛饮今不饮，无琴不独琴无弦。\n我公天与英雄表，龙章凤姿照鱼鸟。\n但令端委坐庙堂，北狄西戎谈笑了。\n如今老去苦思归，小字亲书寄我诗。\n试问乐全全底事，无全何处更相亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张文裕挽词","author":"苏轼","text":"高才本出朝廷右，能事方推德业馀。\n每见便闻曹植句，至今传宝魏华书。\n济南名士新彫丧，剑外生祠已洁除。\n欲寄西风两行泪，依然乔木郑公庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀西湖寄晁美叔同年","author":"苏轼","text":"西湖天下景，游者无愚贤。\n浅深随所得，谁能识其全。\n嗟我本狂直，早为世所捐。\n独专山水乐，付与宁非天。\n三百六十寺，幽寻遂穷年。\n所至得其妙，心知口难传。\n至今清夜梦，耳目馀芳鲜。\n君持使者节，风采烁云烟。\n清流与碧巘，安肯为君妍。\n胡不屏骑从，暂借僧榻眠。\n读我壁间诗，清凉洗烦煎。\n策杖无道路，直造意所便。\n应逢古渔父，苇间自延缘。\n问道若有得，买鱼勿论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘贡父李公择见寄二首 其一","author":"苏轼","text":"白发相望两故人，眼看时事几番新。\n曲无和者应思郢，论少卑之且借秦。\n岁恶诗人无好语，夜长鳏守向谁亲。\n少思多睡无如我，鼻息雷鸣撼四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘贡父李公择见寄二首 其二","author":"苏轼","text":"何人劝我此间来，弦管生衣甑有埃。\n绿蚁沾唇无百斛，蝗虫扑面已三回。\n磨刀入谷追穷寇，洒涕循城拾弃孩。\n为郡鲜欢君莫叹，犹胜尘土走章台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭常山回小猎","author":"苏轼","text":"青盖前头点皂旗，黄茅冈下出长围。\n弄风骄马跑空立，趁兔苍鹰掠地飞。\n回望白云生翠巘，归来红叶满征衣。\n圣明若用西凉簿，白羽犹能效一挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅户曹会猎铁沟","author":"苏轼","text":"山西从古说三明，谁信儒冠也捍城。\n竿上鲸鲵犹未掩，草中狐兔不须惊。\n东州赵叟饮无敌，南国梅仙诗有声。\n向不如皋闲射雉，归来何以得卿卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘贡父见余歌词数首，以诗见戏，聊次其韵","author":"苏轼","text":"十载飘然未可期，那堪重作看花诗。\n门前恶语谁传去，醉后狂歌自不知。\n刺舌君今犹未戒，灸眉吾亦更何辞。\n相从痛饮无馀事，正是春容最好时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章七出守湖州二首 其一","author":"苏轼","text":"方丈仙人出淼茫，高情犹爱水云乡。\n功名谁使连三捷，身世何缘得两忘。\n早岁归休心共在，他年相见话偏长。\n只因未报君恩重，清梦时时到玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章七出守湖州二首 其二","author":"苏轼","text":"绛阙云台总有名，应须极贵又长生。\n鼎中龙虎黄金贱，松下龟蛇绿骨轻。\n霅水未浑缨可濯，弁峰初见眼应明。\n两卮春酒真堪羡，独占人间分外荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张子野见寄三绝句 其一 过旧游","author":"苏轼","text":"前生我已到杭州，到处长如到旧游。\n更欲洞霄为隐吏，一庵闲地且相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张子野见寄三绝句 其二 见题壁","author":"苏轼","text":"狂吟跌宕无风雅，醉墨淋漓不整齐。\n应为诗人一回顾，山僧未忍扫黄泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张子野见寄三绝句 其三 竹阁见忆","author":"苏轼","text":"柏堂南畔竹如云，此阁何人是主人。\n但遣先生披鹤氅，不须更画乐天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵寺丞寄陈海州","author":"苏轼","text":"景疏楼上唤蛾眉，君到应先诵此诗。\n若见孟公投辖饮，莫忘冲雪送君时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋夔寄茶","author":"苏轼","text":"我生百事常随缘，四方水陆无不便。\n扁舟渡江适吴越，三年饮食穷芳鲜。\n金韭玉脍饭炊雪，海螯江柱初脱泉。\n临风饱食甘寝罢，一瓯花乳浮轻圆。\n自从舍舟入东武，沃野便到桑麻川。\n剪毛胡羊大如马，谁记鹿角腥盘筵。\n厨中蒸粟堆饭瓮，大杓更取酸生涎。\n柘罗铜碾弃不用，脂麻白土须盆研。\n故人犹作旧眼看，谓我好尚如当年。\n沙溪、北苑强分别，水脚一线争谁先。\n清诗两幅寄千里，紫金百饼费万钱。\n吟哦烹噍两奇绝，只恐偷乞烦封缠。\n老妻稚子不知爱，一半已入姜盐煎。\n人生所遇无不可，南北嗜好知谁贤。\n死生祸福久不择，更论甘苦争蚩妍。\n知君穷旅不自释，因诗寄谢聊相镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄庵二首 其一","author":"苏轼","text":"文章恨不见文园，礼乐方将访石泉。\n何事庵中著光禄，枉教闲处笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄庵二首 其二","author":"苏轼","text":"城中太守的何人，林下先生非我身。\n若向庵中觅光禄，雪中履迹镜中真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日，病中邀安国，仍请率禹功同来。仆虽不能饮，当请成伯主会，某当杖策倚几于其间，观诸公醉笑，以拨滞闷也。二首 其一","author":"苏轼","text":"孤灯照影夜漫漫，拈得花枝不忍看。\n白发攲簪羞彩胜，黄耆煮粥荐春盘。\n东方烹狗阳初动，南陌争牛卧作团。\n老子从来兴不浅，向隅谁有满堂欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日，病中邀安国，仍请率禹功同来。仆虽不能饮，当请成伯主会，某当杖策倚几于其间，观诸公醉笑，以拨滞闷也。二首 其二","author":"苏轼","text":"斋居卧病禁烟前，辜负名花已一年。\n此日使君不强喜，早春风物为谁妍。\n青衫公子家千里，白发先生杖百钱。\n曷不相将来问病，已教呼取散花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答李邦直","author":"苏轼","text":"美人如春风，著物物未知。\n羁愁似冰雪，见子先流澌。\n子从徐方来，吏民举熙熙。\n扶病出见之，惊我一何衰。\n知我久慵倦，起我以新诗。\n诗词如醇酒，盎然熏四支。\n径饮不觉醉，欲和先昏疲。\n西斋有蛮帐，风雨夜纷披。\n放怀语不择，抚掌笑脱颐。\n别来今几何，春物已含姿。\n柳色日夜暗，子来竟何时。\n徐方虽云乐，东山禁游嬉。\n又无狂太守，何以解忧思。\n闻子有贤妇，华堂咏《螽斯》。\n曷不倒囊橐，卖剑买蛾眉。\n不用教丝竹，唱我新歌词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其一 湖桥","author":"苏轼","text":"朱栏画柱照湖明，白葛乌纱曳履行。\n桥下龟鱼晚无数，识君拄杖过桥声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二 横湖","author":"苏轼","text":"贪看翠盖拥红妆，不觉湖边一夜霜。\n卷却天机云锦段，从教匹练写秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其三 书轩","author":"苏轼","text":"雨昏石砚寒云色，风动牙签乱叶声。\n庭下已生书带草，使君疑是郑康成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其四 冰池","author":"苏轼","text":"不嫌冰雪绕池看，谁似诗人巧耐寒。\n记取羲之洗砚处，碧琉璃下黑蛟蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其五 竹坞","author":"苏轼","text":"晚节先生道转孤，岁寒惟有竹相娱。\n粗才杜牧真堪笑，唤作军中十万夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其六 荻蒲","author":"苏轼","text":"雨折霜乾不耐秋，白花黄叶使人愁。\n月明小艇湖边宿，便是江南鹦鹉洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其七 蓼屿","author":"苏轼","text":"秋归南浦蟪蛄鸣，霜落横湖沙水清。\n卧雨幽花无限思，抱丛寒蝶不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其八 望云楼","author":"苏轼","text":"阴晴朝暮几回新，已向虚空付此身。\n出本无心归亦好，白云还似望云人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其九 天汉台","author":"苏轼","text":"漾水东流旧见经，银潢左界上通灵。\n此台试向天文觅，阁道中间第几星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十 待月台","author":"苏轼","text":"月与高人本有期，挂檐低户映蛾眉。\n只从昨夜十分满，渐觉冰轮出海迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十一 二乐榭","author":"苏轼","text":"此间真趣岂容谈，二乐并君已是三。\n仁智更烦诃妄见，坐令鲁叟作瞿昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十二 灙泉亭","author":"苏轼","text":"闻道池亭胜两川，应须烂醉答云烟。\n劝君多拣长腰米，消破亭中万斛泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十三 吏隐亭","author":"苏轼","text":"纵横忧患满人间，颇怪先生日日闲。\n昨夜清风眠北牖，朝来爽气在西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十四 霜筠亭","author":"苏轼","text":"解箨新篁不自持，婵娟已有岁寒姿。\n要看凛凛霜前意，须待秋风粉落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十五 无言亭","author":"苏轼","text":"殷勤稽首维摩诘，敢问如何是法门。\n弹指未终千偈了，向人还道本无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十六 露香亭","author":"苏轼","text":"亭下佳人锦绣衣，满身璎珞缀明玑。\n晚香消歇无寻处，花已飘零露已晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十七 涵虚亭","author":"苏轼","text":"水轩花榭两争妍，秋月春风各自偏。\n惟有此亭无一物，坐观万景得天全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十八 溪光亭","author":"苏轼","text":"决去湖波尚有情，却随初日动檐楹。\n溪光自古无人画，凭仗新诗与写成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其十九 过溪亭","author":"苏轼","text":"身轻步稳去忘归，四柱亭前野彴微。\n忽悟过溪还一笑，水禽惊落翠毛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十 披锦亭","author":"苏轼","text":"烟红露绿晓风香，燕舞莺啼春日长。\n谁道使君贫且老，绣屏锦帐咽笙簧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十一 禊亭","author":"苏轼","text":"曲池流水细鳞鳞，高会传觞似洛滨。\n红粉翠蛾应不要，画船来往胜于人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十二 菡萏亭","author":"苏轼","text":"日日移床趁下风，清香不断思何穷。\n若为化作龟千岁，巢向田田乱叶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十三 荼䕷洞","author":"苏轼","text":"长忆故山寒食夜，野荼䕷发暗香来。\n分无素手簪罗髻，且折霜蕤浸玉醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十四 筼筜谷","author":"苏轼","text":"汉川修竹贱如蓬，斤斧何曾赦箨龙。\n料得清贫馋太守，渭滨千亩在胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十五 寒芦港","author":"苏轼","text":"溶溶晴港漾春晖，芦笋生时柳絮飞。\n还有江南风物否？\n桃花流水鲚鱼肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十六 野人庐","author":"苏轼","text":"少年辛苦事犁锄，刚厌青山绕故居。\n老觉华堂无意味，却须时到野人庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十七 此君庵","author":"苏轼","text":"寄语庵前抱节君，与君到处合相亲。\n写真虽是文夫子，我亦真堂作记人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十八 金橙径","author":"苏轼","text":"金橙纵复里人知，不见鲈鱼价自低。\n须是松江烟雨里，小船烧薤捣香齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其二十九 南园","author":"苏轼","text":"不种夭桃与绿杨，使君应欲候农桑。\n春畦雨过罗纨腻，夏垄风来饼饵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文与可洋川园池三十首 其三十 北园","author":"苏轼","text":"汉水巴山乐有馀，一麾从此首归途。\n北园草木凭君问，许我他年作主无？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题刁景纯藏春坞","author":"苏轼","text":"自首归来种万松，待看千尺舞霜风。\n年抛造物陶甄外，春在先生杖屦中。\n杨柳长齐低户暗，樱桃烂熟滴阶红。\n何时却与徐元直，共访襄阳庞德公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉盘盂，并引 其一","author":"苏轼","text":"杂花狼藉占春馀，芍药开时扫地无。\n两寺妆成宝璎珞，一枝争看玉盘盂。\n佳名会作新翻曲，绝品难逢旧画图。\n从此定知年谷熟，姑山亲见雪肌肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉盘盂，并引 其二","author":"苏轼","text":"花不能言意可知，令君痛饮更无疑。\n但持白酒劝嘉客，直待琼舟覆玉彝。\n负郭相君初择地，看羊属国首吟诗。\n吾家岂与花相厚，更问残芳有几枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和潞公超然台次韵","author":"苏轼","text":"我公厌富贵，常苦勋业寻。\n相期赤松子，永望白云岑。\n清风出谈笑，万窍为号吟。\n吟成超然诗，洗我蓬之心。\n嗟我本何人，麋鹿强冠襟。\n身微空志大，交浅屡言深。\n嘱公如得谢，呼我幸寄音。\n但恐酒钱尽，烦公挥橐金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻乔太博换左藏知钦州，以诗招饮","author":"苏轼","text":"今年果起故将军，幽梦清诗信有神。\n马革裹尸真细事，虎头食肉更何人。\n阵云冷压黄茅瘴，羽扇斜挥白葛巾。\n痛饮从今有几日，西轩月色夜来新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乔将行，烹鹅鹿出刀剑以饮客，以诗戏之","author":"苏轼","text":"破匣哀鸣出素虬，倦看鹢鹢听呦呦。\n明朝只恐兼烹鹤，此去还须却佩牛。\n便可先呼报恩子，不妨仍带醉乡侯。\n他年万骑归应好，奈有移文在故丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和成伯兼戏禹功","author":"苏轼","text":"金钱石竹道傍秋，翠黛红裙马上讴。\n无限小儿齐拍手，山公又作习池游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄黎眉州","author":"苏轼","text":"胶西高处望西川，应在孤云落照边。\n瓦屋寒堆春后雪，峨眉翠扫雨馀天。\n治经方笑《春秋》学，好士今无六一贤。\n且待渊明赋归去，共将诗酒趁流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵郎中捕蝗见寄次韵","author":"苏轼","text":"麦穗人许长，谷苗牛可没。\n天公独何意，忍使蝗虫发。\n驱攘著令典，农事安可忽。\n我仆既胼胝，我马亦款矻。\n飞腾渐云少，筋力亦已竭。\n苟无百篇诗，何以醒睡兀。\n初如疏畎浍，渐若决澥渤。\n往来供十吏，腕脱不容歇。\n平生轻妄庸，熟视笑魏勃。\n爱君有逸气，诗坛专斩伐。\n民病何时休，吏职不可越。\n慎毋及世事，向空书咄咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登常山绝顶广丽亭","author":"苏轼","text":"西望穆陵关，东望琅邪台。\n南望九仙山，北望空飞埃。\n相将叫虞舜，遂欲归蓬莱。\n嗟我二三子，狂饮亦荒哉。\n红裙欲仙去，长笛有馀哀。\n清歌入云霄，妙舞纤腰回。\n自从有此山，白石封苍苔。\n何尝有此乐，将去复徘徊。\n人生如朝露，白发日夜催。\n弃置当何言，万劫终飞灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薄薄酒二首，并引 其一","author":"苏轼","text":"薄薄酒，胜茶汤。\n粗粗布，胜无裳。\n丑妻恶妾胜空房。\n五更待漏靴满霜，不如三伏日高睡足北窗凉。\n珠襦玉柙万人祖送归北邙，不如悬鹑百结独坐负朝阳。\n生前富贵，死后文章，百年瞬息万世忙。\n夷齐、盗蹠俱亡羊，不如眼前一醉是非忧乐两都忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薄薄酒二首，并引 其二","author":"苏轼","text":"薄薄酒，饮两钟。\n粗粗布，著两重。\n美恶虽异醉暖同，丑妻恶妾寿乃公。\n隐居求志义之从，本不计较东华尘土北窗风。\n百年虽长要有终，富死未必输生穷。\n但恐珠玉留君容，千载不朽遭樊崇。\n文章自足欺盲聋，谁使一朝富贵面发红。\n达人自达酒何功，世间是非忧乐本来空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年王中甫挽词","author":"苏轼","text":"先帝亲收十五人，四方争看击鹏鹍。\n如君事业真堪用，顾我衰迟不足论。\n出处升沉十年后，死生契阔几人存。\n他时京口寻遗迹，宿草犹应有泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]