[{"title":"能仁翼长老写师像求赞","author":"释正觉","text":"行脚句亲，住山迹陈。\n默有馀味，言还失真。\n金发响而出碍，玉雕文以丧纯。\n胸中器宇，眉底精神。\n虎生三日食牛气，海阔万里吞舟鳞。\n性得全提鼻，心传不挂唇。\n白雪家庭兮独立腰齐之士，红蕉棋局兮尝观柯烂之人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资圣庵欲过圆通","author":"释正觉","text":"我初浮舟济九江，幽寻兰若山苍厖。\n王摩诘画倚栏槛，谢灵运诗开绮窗。\n艾禅高谈肖琢玉，法身雅论非枯桩。\n梦回便是圆通路，月冷上方钟一撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱郎中写真求赞","author":"释正觉","text":"胜净明心，混融古今。\n河汉之气清秋阔，牛斗之光寒夜深。\n机历历兮锦梭吐绪，道绵绵兮玉线联针。\n月漾珊瑚海，春回薝卜林。\n法法变通手段，尘尘出碍胸襟。\n明镜谁嫌差别像，空山自答合同音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其六十七","author":"释正觉","text":"天盖地载，成团成块。\n周法界而无边，折邻虚而无内。\n及尽玄微，谁分向背。\n佛祖来偿口业债，问取南泉王老师，人人只吃一茎菜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十八","author":"释正觉","text":"沧海沥乾，太虚充满。\n衲僧鼻孔长，古佛舌头短。\n珠丝度九曲，玉机才一转。\n直下相逢谁识渠，始信斯人不合伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十","author":"释正觉","text":"切瑳琢磨，变态肴讹。\n葛陂化龙之杖，陶家居蛰之梭。\n同条生兮有数，同条死兮无多。\n末后句，只这是，风舟载月浮秋水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十一","author":"释正觉","text":"夜壑藏舟，澄源著棹。\n龙鱼未知水为命，折箸不妨聊一搅。\n玄沙师，小塘老，函盖箭锋，探竿影草。\n潜缩也老龟巢莲，游戏也华鳞弄藻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二十二","author":"释正觉","text":"挫来机，总权柄。\n事有必行之威，国有不犯之令。\n宾尚奉而主骄，君忌谏而臣佞。\n底意岩头问德山，一抬一搦看心行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三十一","author":"释正觉","text":"一道神光，初不覆藏。\n超见缘也是而无是，出情量也当而无当。\n岩花之粉兮蜂房成蜜，野草之滋兮麝脐作香。\n随类三尺一丈六，明明触处露堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十二","author":"释正觉","text":"宗说般般尽强为，流传耳口便支离。\n种田博饭家常事，不是饱参人不知。\n参饱明知无所求，子房终不贵封侯。\n忘机归去同鱼鸟，濯足沧浪烟水秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四","author":"释正觉","text":"百草头上无边春，信手拈来用得亲。\n丈六金身功德聚，等闲携手入红尘。\n尘中能作主，化外自来宾。\n触处生涯随分足，未嫌伎俩不如人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十四","author":"释正觉","text":"丝纶降，号令分，寰中天子，塞外将军。\n不待雷惊出蛰，那知风遏行云。\n机底联绵兮，自有金针玉线。\n印前恢廓兮，元无鸟篆虫文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十三","author":"释正觉","text":"清白门庭四绝邻，长年关扫不容尘。\n光明转处倾残月，爻象分时却建寅。\n新满孝，便逢春，醉步狂歌任堕巾。\n散发夷犹谁管系，太平无事酒颠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十六","author":"释正觉","text":"抗力霜雪，平步云霄。\n下惠黜国，相如过桥。\n萧曹谋略能成汉，巢许身心欲避尧。\n宠辱若惊深自信，真情参迹混渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十二","author":"释正觉","text":"驴觑井，井觑驴。\n智容无外，净涵有馀。\n肘后谁分印，家中不蓄书。\n机丝不挂梭头事，文彩纵横意自殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十七","author":"释正觉","text":"岸眉横雪，河目含秋。\n海口鼓浪，航舌驾流。\n拨乱之手，太平之筹。\n老赵州，老赵州，搅搅丛林卒未休。\n徒费工夫也造车合辙，本无伎俩也塞壑填沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二十五","author":"释正觉","text":"扇子破，索犀牛，棬挛中字有来由。\n谁知桂毂千年魄，妙作通明一点秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其六十六","author":"释正觉","text":"规圆矩方，用行舍藏。\n钝置栖芦之鸟，进退触藩之羊。\n吃人家饭，卧自家床。\n云腾致雨，露结为霜。\n玉线相投透针鼻，锦丝不断吐梭肠。\n石女机停兮夜色向午，木人路转兮月影移央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十一","author":"释正觉","text":"作贼心，过人胆，历历纵横对机感。\n保福云门也垂鼻欺唇，翠岩长庆也脩眉映眼。\n杜禅和，有何限，刚道意句一齐刬。\n埋没自己也饮气吞声，带累先宗也面墙檐版。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十九","author":"释正觉","text":"玉人梦破一声鸡，转盼生涯色色齐。\n有信风雷催出蛰，无言桃李自成蹊。\n及时节，力耕犁，谁怕春畴没胫泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十","author":"释正觉","text":"蒲团禅版对龙牙，何事当机不作家。\n未意成褫明目下，恐将流落在天涯。\n虚空那挂剑，星汉却浮槎。\n不萌草解藏香象，无底篮能著活蛇。\n今日江湖何障碍，通方津渡有船车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二十四","author":"释正觉","text":"玄沙太刚，长庆少勇，南山鳖鼻死无用。\n风云际会头角生，果见韶阳下手弄。\n下手弄，激电光中看变动。\n在我也能遣能呼，于彼也有擒有纵。\n底事如今付阿谁，冷口伤人不知痛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九","author":"释正觉","text":"两堂云水尽分拿，王老师能验正邪。\n利刀斩断具亡像，千古令人爱作家。\n此道未丧，知音可嘉。\n凿山透海兮唯尊大禹，鍊石补天兮独贤女娲。\n赵州老，有生涯，草鞋头戴较些些。\n异中来也还明鉴，只个真金不混沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十六","author":"释正觉","text":"佛祖髑髅穿一串，宫漏沈沈密传箭。\n人天机要发千钧，云阵煇煇急飞电。\n个中人，看转变，遇贱则贵贵则贱。\n得珠罔象兮至道绵绵，游刃亡牛兮赤心片片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十九","author":"释正觉","text":"不入世，未循缘，劫壶空处有家传。\n白蘋风细秋江暮，古岸船归一带烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十八","author":"释正觉","text":"曼殊问疾老毗耶，不二门开看作家。\n珉表粹中谁赏鉴，忘前失后莫咨嗟。\n区区抱璞兮楚庭膑士，璨璨报珠兮隋城断蛇。\n休点破，绝疵瑕，俗气浑无却较些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十六","author":"释正觉","text":"石霜一宗，亲传九峰。\n香烟脱去，正脉难通。\n月巢鹤作千年梦，雪屋人迷一色功。\n坐断十方犹点额，密移一步看飞龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十七","author":"释正觉","text":"道环之虚靡盈，空印之字未形。\n妙运天轮地轴，密罗武纬文经。\n放开捏聚，独立周行。\n机发玄枢兮青天激电，眼含紫光兮白日见星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其六","author":"释正觉","text":"药之作病，鉴乎前圣。\n病之作医，必也其谁。\n白头黑头兮克家之子，有句无句兮截流之机。\n堂堂坐断舌头路，应笑毗耶老古锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二","author":"释正觉","text":"廓然无圣，来机径挺。\n得非犯鼻而挥斤，失不回头而堕甑。\n寥寥冷坐少林，默默全提正令。\n秋清月转霜轮，河淡斗垂夜柄。\n绳绳衣钵付儿孙，从此人天成药病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三十三","author":"释正觉","text":"浪汲初升，云雷相送，腾跃棱棱看大用。\n烧尾分明度禹门，华鳞未肯淹齑瓮。\n老成人，不惊众，惯临大敌初无恐。\n泛泛端如五两轻，堆堆何翅千钧重。\n高名四海复谁同，介立八风吹不动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十五","author":"释正觉","text":"末后句，会也无，德山父子太含胡。\n座中亦有江南客，莫向人前唱鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十","author":"释正觉","text":"弦筈相衔，网珠相对。\n发百中而箭箭不虚，摄众景而光光无碍。\n得言句之总，持住游戏之三昧。\n妙其间也宛转偏圆，必如是也纵横自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十九","author":"释正觉","text":"三老暗转舵，孤舟夜回头。\n芦花两岸雪，烟水一江秋。\n风力扶帆行不棹，笛声唤月下沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十九","author":"释正觉","text":"争解恁么道，五更鸡唱家林晓。\n争肯恁么道，千年鹤与云松老。\n宝鉴澄明验正偏，玉机转侧看兼到。\n门风大振兮规步绵绵，父子变通兮声光浩浩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十五","author":"释正觉","text":"临际全机格调高，棒头有眼辨秋毫。\n扫除狐兔家风峻，变化鱼龙雷火烧。\n活人剑，杀人刀，倚天照雪利吹毛。\n一等令行滋味别，十分痛处是谁遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其六十九","author":"释正觉","text":"跛跛挈挈，㲯㲯毵毵。\n百不可取，一无所堪。\n默默自知田地稳，腾腾谁谓肚皮憨。\n普周法界浑成饭，鼻孔累垂信饱参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十六","author":"释正觉","text":"是与不是，好看棬。\n似抑似扬，难兄难弟。\n纵也彼既临时，夺也我何特地。\n金锡一振太孤标，绳床三绕闲游戏。\n丛林扰扰是非生，想像触髅前见鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十三","author":"释正觉","text":"斫断老葛藤，打破狐窠窟。\n豹披雾而变文，龙乘雷而换骨。\n咄，起灭纷纷是何物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三十","author":"释正觉","text":"坏不坏，随他去也。\n大千界句里了无钩锁机，脚头多被葛藤碍。\n会不会分明，底事丁宁杀。\n知心拈出勿商量，还我当行相买卖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十四","author":"释正觉","text":"俱胝老子指头禅，三十年来用不残。\n信有道人方外术，了无俗物眼前看。\n所得甚简，施设弥宽，大千刹海饮毛端。\n鳞龙无限落谁手，珍重任公把钓竿。\n师复竖起一指云，看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三","author":"释正觉","text":"云犀玩月璨含辉，木马游春骏不羁。\n眉底一双寒碧眼，看经那到透牛皮。\n明白心超旷劫，英雄力破重围。\n妙圆枢口转灵机，寒山忘却来时路，拾得相将携手归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三十八","author":"释正觉","text":"迷悟相返，妙传而简。\n春拆百花兮一吹，力回九牛兮一挽。\n无奈泥沙拨不开，分明塞断甘泉眼。\n忽然突出肆横流，险。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十五","author":"释正觉","text":"孤迥迥，圆陀陀，眼力尽处高峨峨。\n月落潭空夜色重，云收山瘦秋容多。\n八封位正，五行气和，身先在里见来么。\n南阳父子兮却似知有，西竺佛祖兮无如奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十八","author":"释正觉","text":"狗子佛性有，狗子佛性无，直钩元求负命鱼。\n逐气寻香云水客，嘈嘈杂杂作分疏。\n平展演，大铺舒，莫怪侬家不慎初。\n指点瑕疵还夺璧，秦王不识蔺相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十五","author":"释正觉","text":"圆珠不穴，大璞不琢，道人所贵无棱角。\n拈却肯路根尘空，脱体无依活卓卓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二十七","author":"释正觉","text":"松直棘曲，鹤长凫短。\n羲皇世人，俱忘治乱。\n其安也潜鳞在渊，其逸也翔鸟脱绊。\n无何祖祢西来，里许得失相半。\n蓬随风而转空，船截流而到岸。\n个中灵利衲僧，看取清凉手段。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八十三","author":"释正觉","text":"妙药何曾过口，神医莫能投手。\n若存也渠本非无，至虚也渠本非有。\n不灭而生，不亡而寿。\n全超威音之前，独步劫空之后。\n成平也天盖地擎，运转也乌飞兔走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其三十二","author":"释正觉","text":"无外而容，无碍而冲。\n门墙岸岸，关锁重重。\n酒常酣而卧客，饭虽饱而颓农。\n突出虚空兮凤抟妙翅，踏翻沧海兮雷送游龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其七十四","author":"释正觉","text":"没踪迹，断消息。\n白云无根，清风何色。\n散乾盖而非心，持坤舆而有力。\n洞千古之渊源，造万像之模则。\n刹尘道会也处处普贤，楼阁门开也头头弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其八","author":"释正觉","text":"一尺水，一丈波，五百生前不奈何。\n不落不昧商量也，依前撞入葛藤窠。\n阿呵呵，会也么。\n若是你洒洒落落，不妨我哆哆和和。\n神歌社舞自成曲，拍手其间唱哩啰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十三","author":"释正觉","text":"言衣半夜付卢能，搅搅黄梅七百僧。\n临际一枝正法眼，瞎驴灭却得人憎。\n心心相印，祖祖传灯。\n夷平海岳，变化鲲鹏。\n只个名言难比拟，大都手段解翻腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十四","author":"释正觉","text":"卸却臭皮袋，拈转赤肉团。\n当头鼻孔正，直下髑髅乾。\n老医不见从来癖，少子相看向近难。\n野水瘦时秋潦退，白云断处旧山寒。\n须剿绝，莫颟顸。\n转尽无功伊就位，孤标不与汝同盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二十六","author":"释正觉","text":"一倒一起，雪庭师子。\n慎于犯而怀仁，勇于为而见义。\n清光照眼似迷家，明白转身还堕位。\n衲僧家，了无寄，同死同生，何此何彼。\n暖信破梅兮春到寒枝，凉飙脱叶兮秋澄潦水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十七","author":"释正觉","text":"秤头蝇坐便攲倾，万世权衡照不平。\n斤两锱铢见端的，终归输我定盘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其一○一","author":"释正觉","text":"见有不有，翻手覆手。\n琅琊山里人，不落瞿昙后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十","author":"释正觉","text":"梦中拥衲参耆旧，列圣森森坐其右。\n当仁不让犍稚鸣，说法无畏师子吼。\n心安如海，胆量如斗。\n鲛目泪流，蚌肠珠剖。\n谵语谁知泄我机，厖眉应笑扬家丑。\n离四句，绝百非，马师父子病休医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十三","author":"释正觉","text":"岐分丝染太唠唠，果缀花联败祖曹。\n妙握司南造化柄，水云器具在甄陶。\n屏割繁碎，剪除氄毛。\n星衡藻鉴，玉尺金刀。\n黄檗老，察秋毫，坐断春风不放高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五十四","author":"释正觉","text":"一窍虚通，八面玲珑。\n无象无私春入律，不留不碍月行空。\n清净宝目功德臂，遍身何似通身是。\n现前手眼显全机，大用纵横何讳忌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十五","author":"释正觉","text":"巍巍堂堂，磊磊落落。\n闹处刺头，稳处下脚。\n脚下线断我自由，鼻端泥尽君休斲。\n莫动著，千年故纸中合药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其九十七","author":"释正觉","text":"君王底意语知音，天下倾诚葵藿心。\n掇出中原无价宝，不同赵璧与燕金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十六","author":"释正觉","text":"收把断襟喉，风磨云拭，水冷天秋。\n锦鳞莫谓无滋味，钓尽沧浪月一钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其十","author":"释正觉","text":"年老成精不谬传，赵州古佛嗣南泉。\n枯龟丧命因图象，良马追风累缠牵。\n勘破了老婆禅，说向人前不直钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其二十三","author":"释正觉","text":"淡中有味，妙超情谓。\n绵绵若存兮象先，兀兀如愚兮道贵。\n玉雕文以丧淳，珠在渊而自媚。\n十分爽气兮清磨暑秋，一片闲云兮远分天水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]