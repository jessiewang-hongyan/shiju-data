18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曲棹歌 其二 一曲","author":"白玉蟾","text":"幔亭峰下泛仙船，洞口琼花锁翠烟。\n一自魏王归绛阙，至今哀怨岭头猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曲棹歌 其一 武夷","author":"白玉蟾","text":"三十六峰真绝奇，一溪九曲碧涟漪。\n白云遮眼不知处，谁道神仙在武夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曲杂咏 九曲新村市","author":"白玉蟾","text":"落日移舟上碧滩，桃花林外见青山。\n耳边忽尔闻鸡犬，不遇刘郎不肯还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曲杂咏 八曲鼓楼岩","author":"白玉蟾","text":"万丈高岩耸石楼，云翚烟桷瞰寒流。\n幔亭昔聚曾孙宴，石鼓拿归古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜居","author":"白玉蟾","text":"路似羊肠绕，溪如燕尾分。\n青山相领略，许我一丘云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曲杂咏 三曲仙机岩","author":"白玉蟾","text":"织就霓裳御泠风，玉梭随手化成龙。\n天孙归去星河畔，满洞白云机杼空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元玩灯 其二","author":"白玉蟾","text":"上界天官此按行，五云深处有箫笙。\n一轮宝月明如昼，万斛金莲开满城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元玩灯 其一","author":"白玉蟾","text":"碧玉融成万里天，满城罗绮竞春妍。\n柳梢挂月黄昏后，夜市张灯白昼然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上清宫方丈后亭","author":"白玉蟾","text":"三四声猿叫落月，六七竿竹呼起风。\n夜静无人知此味，还他方丈拙庵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与永兴观主梅 其二","author":"白玉蟾","text":"玉艳冰英绝可怜，即之时复一嫣然。\n姑苏日暮逢西子，采石江明见谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与永兴观主梅 其一","author":"白玉蟾","text":"破袖悬鹑鬓㖀苍，山前山后乐相羊。\n三更月影如酥白，一树梅花似雪香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与赵寺丞","author":"白玉蟾","text":"汞铅不在身中取，龙虎当于意外求。\n会得这些真造化，何愁不晓炼丹头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与赵将军 其三","author":"白玉蟾","text":"芒鞋布袜与青藜，朝市迷心忽几时。\n料得山中猿鹤冷，多应相怨不相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与赵将军 其二","author":"白玉蟾","text":"醉头一月不曾梳，共整扁舟又太湖。\n昔日舞雩多一唯，他人陋巷只如愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与赵将军 其一","author":"白玉蟾","text":"见君除授千牛贵，过眼光荣一蠓微。\n人爵未如天爵美，脂韦只道布韦非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕眺风泉亭 其三","author":"白玉蟾","text":"西风黄叶夕阳村，山水苍寒雾霭昏。\n手撚菊花都是泪，枯松骨立绿毛鬈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕眺风泉亭 其二","author":"白玉蟾","text":"拄杖相寻访夕阳，诗肩独耸到昏黄。\n白蘋洲上西风起，黄叶声中秋意长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕眺风泉亭 其一","author":"白玉蟾","text":"苒苒斜阳恋竹边，秋阴惨昧响寒泉。\n如何今夜成无月，却遣西风一问天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中偶成 其二","author":"白玉蟾","text":"长日扃门坐小亭，松阴竹影自清清。\n山翁莫问吾名姓，天上星辰地下行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中偶成 其一","author":"白玉蟾","text":"酒恶频频嗅素馨，满天风雨晚凉生。\n岩花乱落无一点，谷鸟时闻啼数声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"白玉蟾","text":"月落鸡吹角，夜长鹅报更。\n山中无历日，日出即天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其五","author":"白玉蟾","text":"天静无尘夜半时，鹊乌啼罢众星稀。\n数峰明月光无尽，一洞闲云淡不飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其四","author":"白玉蟾","text":"竹风瑟瑟野猿号，月下酣眠不脱蓑。\n恐致丹炉伤白蚁，懒烧松烛惜飞蛾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其三","author":"白玉蟾","text":"一片幽心卧紫霞，松梢凝翠夕阳斜。\n尚无心绪听啼鸟，那有工夫扫落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其二","author":"白玉蟾","text":"楮衾滴破松梢露，草屦淘穿石缝泉。\n猿在岭头声未断，道人月下伴云眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其一","author":"白玉蟾","text":"松竹成林云气深，洞门风冷绿苔阴。\n落花飞尽青山在，幽鸟声中野客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山前行散","author":"白玉蟾","text":"人在莺花里，春归杖屦中。\n风迎何处鹤，宿我洞门松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山前散策","author":"白玉蟾","text":"月影黄昏后，诗天眼界宽。\n野香寻得见，石背一枝兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]