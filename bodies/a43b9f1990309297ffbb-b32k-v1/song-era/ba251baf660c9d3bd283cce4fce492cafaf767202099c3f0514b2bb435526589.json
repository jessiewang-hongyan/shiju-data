[{"title":"夏夜纳凉","author":"陆游","text":"河汉微茫月渐低，风声正在草堂西。\n莎根唧唧虫相吊，木末翻翻鹊未栖。\n屯甲近闻如积水，守关不假用丸泥。\n孤臣报国嗟无地，只有东皋更饱犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜读书自嘲","author":"陆游","text":"事业无成去日遒，只今身世付沧洲。\n风烟惨惨菰蒲老，星斗离离河汉流。\n寂寞书生学奇字，穷愁客子著春秋。\n白头自苦君无笑，骨朽成尘志未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜起坐南亭达晓不复寐","author":"陆游","text":"风露青冥近九秋，脱巾扶杖冷飕飗。\n曲阑影外巴山月，画角声中楚塞愁。\n巢燕并栖高栋稳，潜鱼时跃小池幽。\n悠然坐待江城晓，红日将升碧雾浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏雨","author":"陆游","text":"忽闻疏雨滴林梢，起看油云满四郊。\n行蚁君臣初徙穴，鸣鸠夫妇正争巢。\n筑陂处处移新稻，乘屋家家补破茆。\n堪笑此翁惟美睡，孝先便腹任讥嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏雨初霁题斋壁","author":"陆游","text":"楸花楝花照眼明，幽人浴罢葛衣轻。\n燕低去地不盈尺，鹊喜傍檐时数声。\n对弈轩窗消永昼，晒丝院落喜新晴。\n忽惊重五无多日，采缕缠筒吊屈平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏秋之交久不雨方以旱为忧忽得甘澍喜而有作","author":"陆游","text":"乱点洒庭芜，凉声集井梧。\n绿荷倾作汞，翠蔓缀成珠。\n卧听病良已，行吟愁欲无。\n天公终老手，谈笑活焦枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"娥江市","author":"陆游","text":"小聚依江近，支流入浦分。\n荒寒孤店雨，零乱野祠云。\n薄饷炊畬粟，珍烹采涧芹。\n年来去健羡，摩腹自欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴西楼","author":"陆游","text":"西楼遗迹尚豪雄，锦绣笙箫在半空。\n万里因循成久客，一年容易又秋风。\n烛光低映珠帘丽，酒晕徐添玉颊红。\n归路迎凉更堪爱，摩诃池上月方中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐二首 其二","author":"陆游","text":"周流惟一气，天地与人同。\n天道故不息，人为斯有穷。\n蛟龙上云雨，鱼鸟困池笼。\n宴坐观兹理，吾其若发蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐","author":"陆游","text":"身寄穷山里，心安一事无。\n新传小止观，渐解半跏趺。\n急雪鸣窗纸，孤灯耿地炉。\n老来元少睡，且复兀枯株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐二首 其一","author":"陆游","text":"气住即存神，心安自保身。\n谁欤二竖子，卓尔一真人。\n气溯如潮上，津流若酒醇。\n幽居幸无事，莫玩物华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐自午至暮","author":"陆游","text":"身外寥寥扫怨恩，胸中浩浩纳乾坤。\n饱经世事常高枕，惯见人情不署门。\n孤日夜分生海底，百川秋涨溯河源。\n珥貂碧落从来事，东访蓬莱不足言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家风","author":"陆游","text":"春耕秋钓旧家风，门巷荒寒屋壁空。\n四海交情残梦里，一生心事断编中。\n买鱼日待携篮女，裹药时从挟簏翁。\n便废闲吟亦未可，吾徒岂独坐诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家有两瓢分贮酒药出则使一童子负之戏赋五字句","author":"陆游","text":"长物消磨尽，犹存两大瓢。\n药能扶困惫，酒可沃枯焦。\n童负来山店，人看度野桥。\n画工殊好事，传写入生绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园小酌二首 其二","author":"陆游","text":"满林春笋生无数，竟日鸬鹚来百回。\n衣上尘埃真一洗，酒边怀抱得频开。\n池鱼往者忧奇祸，社栎终然幸散材。\n世事纷纷心本懒，闭门岂独畏嫌猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园小酌二首 其一","author":"陆游","text":"旋作园庐指顾成，柳阴已复著啼莺。\n百年更把几杯酒，一月元无三日晴。\n鸥鹭向人殊耐久，山林与世本无营。\n小诗漫付儿曹诵，不用韩公说有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家居三首 其二","author":"陆游","text":"老眊诗名减，登临笑口开。\n酿泉为酒熟，倩鹤附书回。\n纱帽方簪菊，筇枝又探梅。\n清狂君勿笑，曾是薄蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家居三首 其三","author":"陆游","text":"蒲苇村深地，风霜岁晚天。\n溪柴胜炽炭，黎布敌纯绵。\n有客问奇字，无人嘲昼眠。\n谁言此翁老，怀抱尚超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家居三首 其一","author":"陆游","text":"清世念遗民，常情重老人。\n馈浆烦郡府，分胙愧乡邻。\n穫稻黄云卷，舂粳玉粒新。\n膨脝自摩腹，一笑欲忘贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家酿颇劲戏作","author":"陆游","text":"千古英雄骨作尘，不如一醉却关身。\n鼎来虽恨王陵戆，熟味方知孟子醇。\n试问浩歌遗世事，何如酣枕养天真。\n竹林嵇阮虽名胜，要是渊明最可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"射的山观梅二首 其一","author":"陆游","text":"射的山前雨垫巾，篱边初见一枝新。\n照溪尽洗骄春意，倚竹真成绝代人。\n餐玉元知非火食，化衣应笑走京尘。\n即今画史无名手，试把清诗当写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"射的山观梅二首 其二","author":"陆游","text":"凌厉冰霜节愈坚，人间乃有此癯仙。\n坐收国士无双价，独立东皇太一前。\n此去幽寻应尽日，向来别恨动经年。\n花中竟是谁流辈，欲许芳兰恐未然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席上作","author":"陆游","text":"绿波画桨浣花船，清簟疏帘角黍筵。\n一幅葛巾林下客，百壶春酒饮中仙。\n散怀丝管繁华地，寄傲江湖浩荡天。\n浮世升沉何足计，丹成碧落珥貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐稚山给事庆八十乐语口号","author":"陆游","text":"欲知主圣本臣忠，倾尽嘉谟沃舜聪。\n同载方如周吕尚，安车不数汉申公。\n日烘盎盎花光暖，烛映鳞鳞酒浪红。\n白首同朝各强健，莫辞烂醉答春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恩封渭南伯唐诗人赵嘏为渭南尉当时谓之赵渭南后来将以予为陆渭南乎戏作长句","author":"陆游","text":"老向人间久倦游，君恩乞与渭川秋。\n虚名定作陈惊坐，好句真惭赵倚楼。\n栈豆十年沾病马，烟波万里著浮鸥。\n就封他日轻裘去，应过三峰处处留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恩除秘书监","author":"陆游","text":"群仙鹤驾去难追，白首重来不自知。\n才艺荒唐痴独绝，功名蹭蹬老如期。\n海边郑叟穷耽酒，吴下韦郎晚学诗。\n扶上木天君莫笑，衰残不似壮游时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扇子峡山腹有草阁小亭极幽邃意其非俗人居也","author":"陆游","text":"绝境慰人心，谁家住玉岑。\n乱云生翠窦，密雪洒青林。\n高阁临空豁，孤亭隐邃深。\n定知非俗士，橹急不容寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中杂兴二首 其二","author":"陆游","text":"倒掩衡门手自关，老身著在乱书间。\n有诗尚作清宵祟，无事能妨白日闲。\n薄暮上楼聊试步，经旬止酒自酡颜。\n儿曹莫笑衰翁懒，拟遍淮南大小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中杂兴二首 其一","author":"陆游","text":"八十颓龄安所归，萧然终日掩柴扉。\n清心始信幽栖乐，穷理方知俗学非。\n山果满筐猿食足，石泉通笕药苗肥。\n衰翁莫道浑无事，扫叶归来又落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中弄笔偶书示子聿","author":"陆游","text":"左右琴樽静不哗，放翁新作老生涯。\n焚香细读斜川集，候火亲烹顾渚茶。\n书为半酣差近古，诗虽苦思未名家。\n一窗残日呼愁起，袅袅江城咽暮笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中闲咏","author":"陆游","text":"风号万物作涛声，云截千峰似几平。\n多病支离仍老境，暮秋萧瑟更山城。\n燕觞久罢尘痕积，庭讼全稀藓晕生。\n莫道斋中日无事，焚香扫地又诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中夜赋","author":"陆游","text":"高居终日掩斋扉，幽事常多俗事稀。\n露重丛篁时自泻，风高脱叶有先飞。\n秋衣渐制闻砧杵，社肉初分谢蕨薇。\n却笑老身闲不得，一灯明灭乱书围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中读书罢有感","author":"陆游","text":"少时学问苦匆匆，弦诵光阴转手空。\n圣域渊源虽自力，故交零落与谁同。\n荒村莫恨身垂老，后世元知论自公。\n但掩斋扉凭曲几，忘忧正在寂寥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋居书事","author":"陆游","text":"慵养金丹换鬓须，微霜正要称清癯。\n平生风露充蝉腹，到处云山寄鹤躯。\n道室焚香勤守白，虚窗点易静研朱。\n自知世事难谐偶，不待幽人夜见呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋前独坐戏作","author":"陆游","text":"闭户学僧坐，颓然遗世情。\n虚窗鸽飞影，枯叶犬行声。\n雪拥杉灰暖，云垂纸帐明。\n清馋不可耐，一笑听华鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅次有赠","author":"陆游","text":"黄鹤楼前逢剑客，青衣江口见诗人。\n天涯莫起漂零感，物外终为自在身。\n卖马求船虽少日，阻风中酒动兼旬。\n中原早晚胡尘静，缑月嵩云要卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅舍","author":"陆游","text":"寺钟吹动四山昏，系缆来投江上村。\n木落不妨生意足，水归犹有涨痕存。\n炉红手暖书差健，鼎沸汤深酒易温。\n勿为无年忧寇窃，狺狺小犬护篱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅舍偶题","author":"陆游","text":"野店山桥策蹇驴，浩然聊喜遂吾初。\n童颜几岁已辞镜，胎发今朝还入梳。\n小瓮漫营秋社酒，断编闲理小年书。\n白云可笑犹多事，常向人间耐卷舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅思","author":"陆游","text":"支遁山前看月明，葛洪井上听松声。\n废亭草满青骡健，野店灯残宝剑鸣。\n万事竟当归定论，寸心那得愧平生。\n悠然酌罢无人语，寄意孤桐一再行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅思","author":"陆游","text":"百病集残骸，闲游且散怀。\n旅装如远役，蔬食似长斋。\n买药停山步，求医过县街。\n春寒殊未已，闭户夜燃䕸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅食","author":"陆游","text":"霜馀汉水浅，野迥朔风寒。\n炊黍香浮甑，烹蔬绿映盘。\n心安失粗粝，味美出艰难。\n惟恨虚捐日，无书得纵观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出东城","author":"陆游","text":"听彻清笳听晓钟，据鞍漏鼓尚鼕鼕。\n西楼落月径三尺，北岭乱云生半峰。\n苍磴幽寻过古寺，绿畴小驻劳春农。\n烟村已远犹回首，恐有鹓雏与伏龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出东城马上作","author":"陆游","text":"晓出东城数帜红，蒙茸狐貉拥衰翁。\n郊墟歉岁萧条后，风雪穷冬惨淡中。\n耐辱已惭非士节，端忧未办济民穷。\n诞欺成俗真当惧，谁挽天河一洗空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出至湖桑埭","author":"陆游","text":"残年孤寂不堪言，时唤平头驾短辕。\n老气犹能作罴卧，壮怀谁复记鸿轩。\n棹歌缥渺城西路，烟树参差埭北村。\n堪笑怪奇消未尽，夜来还梦属櫜鞬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出南山","author":"陆游","text":"久向人间触骇机，敛收孤迹早宜归。\n亡羊未恨补牢晚，搏虎深知攘臂非。\n明月长庚天欲晓，新桐清露暑犹微。\n扁舟蓑笠平生事，莫羡黄金带十围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出城东","author":"陆游","text":"渺渺长江下估船，亭亭孤塔隐苍烟。\n不堪异县萧条地，更遇初寒惨澹天。\n巾褐已成归有约，箪瓢未足去无缘。\n包羞强索侏儒米，豪举何人记少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出湖边摘野蔬","author":"陆游","text":"浩歌振履出茅堂，翠蔓丹芽采撷忙。\n且胜堆盘供苜蓿，未言满斛进槟榔。\n行迎风露衣巾爽，净洗膻荤匕箸香。\n著句誇张君勿笑，故人方厌太官羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓出遇猎徒有作","author":"陆游","text":"出门万瓦粲晨霜，忽忆行军起裹创。\n卖剑买牛身已老，搴旗斩将梦犹狂。\n奇才古有潜屠肆，豪气今谁寓猎场。\n狐兔草间何足问，合留长箭射天狼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓发金牛","author":"陆游","text":"客枕何时稳，匆匆又束装。\n快晴生马影，新暖坼花房。\n沮水春流绿，嶓山晓色苍。\n阿瞒狼狈地，千古有遗伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓过万里桥","author":"陆游","text":"晓出锦江边，长桥柳带烟。\n豪华行乐地，芳润养花天。\n拥路看攲帽，窥门笑坠鞭。\n京华归未得，聊此送流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓坐","author":"陆游","text":"低枕孤衾夜气存，披衣起坐默忘言。\n瓶花力尽无风堕，炉火灰深到晓温。\n空橐时时闻鼠齧，小窗一一送鸦翻。\n悠然忽记幽居日，下榻先开水际门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓枕","author":"陆游","text":"残漏鼕鼕急，明星磊磊高。\n一从安枕卧，无复揽衣劳。\n熨斗生晨火，熏笼覆缊袍。\n一杯山药酒，红日满亭皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓思","author":"陆游","text":"昏昏断梦带馀酲，散发披衣坐待明。\n城角吹残河渐隐，海氛消尽日初生。\n老农自得当年乐，痴子方争后世名。\n莫怪闭门常懒出，即今车盖为谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓寒","author":"陆游","text":"悠悠残梦伴残更，万木风号晓气清。\n鸡唱欲阑闻井汲，月痕渐浅觉窗明。\n突烟腾碧炊初动，衣焙堆红火已生。\n小閤翻书裘褐暖，早朝霜滑愧公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓寒","author":"陆游","text":"落月衔山口，浓霜倒菊丛。\n青毡压衾暖，软火满炉红。\n起晚书亏课，愁多酒策功。\n杜陵如昔否，谁与问征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓晴肩舆至湖上","author":"陆游","text":"多稼如云穫并空，牛阑樵担画图中。\n梧桐已逐晨霜尽，乌臼犹争夕照红。\n脱网噞喁奔远浦，避鹰扑握保深丛。\n旗亭人语灯初上，一醉何妨野老同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓赋","author":"陆游","text":"八月江湖风露秋，时闻脱叶下梧楸。\n离离斗柄西南指，烂烂天河今古流。\n人语正欢过古埭，角声三弄下谯楼。\n百城已共丰年乐，一老犹怀卒岁忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓赋","author":"陆游","text":"鸡晨非一唱，鸦旦每三鸣。\n万物各有役，吾生何所营。\n书编犹未掩，窗纸已微明。\n稚子勇过我，琅琅诵易声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柴门","author":"陆游","text":"寂寞柴门不彻扃，槐花细细糁空庭。\n晚梅摘得盐供饤，浊酒沽来草塞瓶。\n病已废耕抛袯襫，闲犹持钓爱笭箵。\n经旬莫恨无来客，交旧疏如欲旦星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源","author":"陆游","text":"木缺桥横一径微，断烟残霭晚霏霏。\n十年勌客明双眼，五月游人换夹衣。\n翠峡束成寒练静，苍崖溅落素鲛飞。\n尔来自笑痴顽甚，著处吟哦不记归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐庐县泛舟东归","author":"陆游","text":"桐江艇子去乘月，笠泽老翁归放慵。\n一尺轮囷霜蟹美，十分潋滟社醅浓。\n宦游何啻路九折，归卧恨无山万重。\n醉里试吹苍玉笛，为君中夜舞鱼龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桥南纳凉","author":"陆游","text":"曳杖来追柳外凉，画桥南畔倚胡床。\n月明船笛参差起，风定池莲自在香。\n半落星河知夜久，无穷草树觉城荒。\n碧筒莫惜颓然醉，人事还随日出忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流年","author":"陆游","text":"冉冉流年迫耄期，心情渐减旧儿嬉。\n唾壶麈尾已从省，茶灶笔床犹自随。\n昨日客招东浦钓，今朝僧约北轩棋。\n敢将轻健誇邻里，一笑元知要及时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流年","author":"陆游","text":"流年及耄敢前期，浮世如沤只自知。\n多贮闲愁持抵酒，剩游好景拟供诗。\n海东药到宽衰疾，岷下书稀怆别离。\n约束春盘莫草草，又当梅发两京时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣花赏梅","author":"陆游","text":"老子人间自在身，插梅不惜损乌巾。\n春回积雪层冰里，香动荒山野水滨。\n带月一枝低弄影，背风千片远随人。\n石家楼上贪吹笛，肯放朝朝玉树新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪迹","author":"陆游","text":"浪迹人间四十年，镜中不觉已华颠。\n山川惨澹秋多感，灯火青荧夜少眠。\n壮志已忘榆塞外，高情正在酒垆边。\n扁舟不恨无人识，且复长歌入暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]