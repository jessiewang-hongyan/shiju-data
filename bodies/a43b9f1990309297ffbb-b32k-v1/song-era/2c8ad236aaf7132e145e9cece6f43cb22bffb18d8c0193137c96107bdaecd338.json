[{"title":"所闻","author":"戴复古","text":"今虏既亡后，中间消息稀。\n山河谁是主，豪杰故乘机。\n喜报三京复，旋闻二赵归。\n此行关大义，天意忍相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"所闻二首 其二","author":"戴复古","text":"右席须贤久，丹书几度催。\n贼惊中使转，人望相公来。\n问政曲江宅，调羹庾岭梅。\n莫因多病后，虚出应三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"所闻二首 其一","author":"戴复古","text":"屡遣和戎使，三边未解兵。\n武夫权渐重，□□望何轻。\n天下思豪杰，君王用老成。\n时无渭滨叟，白首致功名。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法曹罗立之酒边举数首皆仆故人为我寄声","author":"戴复古","text":"佳士欣相识，吟边问姓名。\n官为三语掾，诗到五言城。\n野客可怜我，故人烦寄声。\n白头归故隐，秋后会群英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉寺","author":"戴复古","text":"半空紫翠隔微茫，隐隐钟声落下方。\n名胜直同天地老，青山不管古今忙。\n散分瀑布烟霞润，点检苍松岁月长。\n绝顶好云如恋客，尽教怡阅到斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贤女祠","author":"戴复古","text":"士有败风节，惭魂埋九京。\n幽闺持大谊，千载著嘉名。\n父不重然诺，女能轻死生。\n寒潭堕秋月，心迹两清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贤良一和五篇不可及","author":"戴复古","text":"世路从他险，输君酒盏深。\n立谈双白璧，一诺百黄金。\n志大不少屈，诗工非苦吟。\n相随万里去，老鹤岂无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贫作负恩人为何宏甫作","author":"戴复古","text":"九陌尘中事，三生石上身。\n狂为好诗客，贫作负恩人。\n十载江村别，扁舟淦水滨。\n音书久不至，得梦往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑南夫云林隐居","author":"戴复古","text":"一来陪胜践，再到惜蹉跎。\n记得山中景，行寻竹外坡。\n天寒梅信早，海近雁声多。\n烟渚蒲洲外，时闻欸乃歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金山","author":"戴复古","text":"水涌孤峰出，波深日夜闻。\n重岩戍铁屋，双塔碍行云。\n天地八窗迥，江淮两岸分。\n登临多感慨，北雁又成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵游览用刘子明韵","author":"戴复古","text":"英雄割据已焉哉，逝水滔滔去不回。\n里巷难寻王谢宅，江山空对凤凰台。\n登临无伴诗为侣，兴废不知梅自开。\n同是游人不同乐，青楼歌舞待君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台","author":"戴复古","text":"赤符新领旧乾坤，多谢君王问故人。\n暂作客星侵帝座，终为渔父老江滨。\n层台不啻几千仞，直钓何曾挂一鳞。\n莫道羊裘欠图画，丹青难写子陵真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后有感","author":"戴复古","text":"逐日愁闻雨，今朝喜遇晴。\n云开山献状，月出海生明。\n天地有常理，古今无限情。\n静中观世变，安得见河清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江小泊","author":"戴复古","text":"舣舟杨柳下，一笑上茶楼。\n适与胡僧遇，非因越女留。\n云行山自在，沙合水分流。\n独酌临清泚，知心是白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江军新岁呈王幼学监簿","author":"戴复古","text":"梦说去年事，诗从昨夜吟。\n三杯新岁酒，千里故乡心。\n人共梅花老，愁连江水深。\n家书忽在眼，一纸直千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南丰县南台包敏道赵伯成同游","author":"戴复古","text":"笑傲南台上，东风吹鬓丝。\n眼明花在处，春好雨晴时。\n楼阁多临水，溪山可赋诗。\n留连无尽意，故遣酒行迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南台寺长老乃福州士人陈其姓语及光拙庵遭际寺乃石头和尚道场","author":"戴复古","text":"元龙湖海士，参得石头禅。\n卓笔翻千偈，住山今十年。\n安心一丘壑，过眼几云烟。\n莫笑拙庵拙，声名动九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南安王使君领客湛泉流觞曲水","author":"戴复古","text":"横浦堂前举一卮，古榕阴下坐多时。\n连朝好雨千山润，昨夜新秋一叶知。\n梅岭乡来逢行者，兰亭今日又羲之。\n家声不坠风流在，如见初寮说好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南剑溪上","author":"戴复古","text":"长舟不用柂，沙上木为篙。\n溪路湾环转，滩声日夜号。\n居人不觉险，行客始知劳。\n四望无平地，山田级级高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南康六老堂","author":"戴复古","text":"庐山脚下开亭馆，柰此千峰百嶂何。\n逸少大书池上墨，少陵狂作醉时歌。\n碧荷秋老香犹在，好月夜深明更多。\n五老揖君天上笑，把杯相对酌金波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南康县用东坡留题韵","author":"戴复古","text":"镜中双鬓已非鸦，身在江湖心在家。\n道路飘零如柳絮，山川迤逦近梅花。\n客行有债频沽酒，老怕无眠戒饮茶。\n昨夜梦归沧海上，钓竿横插雁边沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南康县刘隐居","author":"戴复古","text":"秋风送纨扇，终日御瑶琴。\n祇可自为乐，不求人赏音。\n无心问轩冕，此地即山林。\n堪笑红尘客，飘零雪满簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中岁晚呈何宏甫","author":"戴复古","text":"岁事费料理，三杯意适然。\n与其愁度日，曷若醉忘年。\n桑落冬前酒，梅花雪后天。\n不知身是客，多谢主人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客自邵武来言王野使君平寇 其二","author":"戴复古","text":"太守自监军，片胆大如身。\n立马斩数贼，犒军捐万缗。\n威行千里外，手活一城民。\n孰谓书生怯，书生中有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客自邵武来言王野使君平寇 其一","author":"戴复古","text":"闻说贼来日，君能判死生。\n扁舟载母去，倚剑到天明。\n百姓各逃命，四旁无援兵。\n王尊岂非勇，独自守孤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客游","author":"戴复古","text":"不能郁郁窟中藏，大笑出门游四方。\n与世周旋持酒盏，观人胜败坐棋坊。\n倒餐甘蔗入佳境，昼著锦衣归故乡。\n此志十年犹未遂，倚楼心事楚天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中寄家书并简季道侄","author":"戴复古","text":"东隐三年别，西风一纸书。\n逢人相问讯，念我独勤渠。\n游子司吾土，先人有弊庐。\n欲归归未得，妻子定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏上怀黄伯高兄弟","author":"戴复古","text":"扁舟到溪上，移杖即行吟。\n问麦雨多少，探梅春浅深。\n古屏今日景，脩竹旧时阴。\n畴昔同游者，遗踪何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"峡山二首 其二","author":"戴复古","text":"欲访飞来殿，维舟上峡山。\n有溪流屋下，无路入云间。\n犀解捐金索，猿能记玉环。\n无从旌往事，有地足跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"峡山二首 其一","author":"戴复古","text":"山近江如束，林深路欲迷。\n平沙印虎迹，绝壁听猿啼。\n绿水人谁钓，黄茅地可畦。\n幽居堪避世，何必武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"度淮","author":"戴复古","text":"一雨足秋意，孤吟写客怀。\n人情容易变，身事苦难谐。\n每日思归浙，今朝却度淮。\n此生烦造物，略略为安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归 其二","author":"戴复古","text":"躬耕海上奈无田，乍可经营买钓船。\n未有人供令狐米，欲从鬼借尉迟钱。\n回头归路三千里，藉手还乡五百篇。\n幸遇太平时节好，白云深处了残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归 其一","author":"戴复古","text":"地上皇皇虮虱臣，著衣吃饭亦君恩。\n不能待诏金銮殿，尝欲献诗光范门。\n身在草茅忧社稷，恨无毫发补乾坤。\n才疏命薄成何事，白首归耕东海村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归二首 其二","author":"戴复古","text":"老矣归欤东海村，长裾不复上王门。\n肉糜岂胜鱼羹饭，纨裤何如犊鼻裈。\n是处江山如送客，故园桐竹已生孙。\n分无功业书青史，或有诗名身后存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归二首 其一","author":"戴复古","text":"吟诗不换校书郎，但欲封侯管醉乡。\n疏懒无成嵇叔夜，清狂似达贺知章。\n安贫不怕黄金尽，既老从教白发长。\n百计不如归去好，子孙相对说农桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思家","author":"戴复古","text":"湖海三年客，妻孥四壁居。\n饥寒应不免，疾病又何如。\n日夜思归切，平生作计疏。\n愁来仍酒醒，不忍读家书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"括苍石门瀑布","author":"戴复古","text":"少泊石门观瀑布，明知是水却疑非。\n乱抛雪玉从天下，散作云烟到地飞。\n夜听萧萧洗尘梦，风吹细细湿人衣。\n谢公蜡屐经行处，闻有留题在翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故人陈秘书家有感 其一","author":"戴复古","text":"晚春风雨后，花絮落无声。\n绿泛新荷出，青铺细草生。\n私蛙为谁噪，老犬伴人行。\n旧日狂宾客，樽前笑不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故人陈秘书家有感 其二","author":"戴复古","text":"林塘劫火后，更作两家分。\n笋拆头抢地，松高气拂云。\n老夫来访旧，稚子解谈文。\n自是麒麟种，那随雁鹜群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"戴复古","text":"淫滞江湖久，蹉跎岁月新。\n客愁茅店雨，诗思柳桥春。\n秣马寻归路，骑鲸问故人。\n山林与朝市，何处著吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日二首呈黄子迈大卿 其一","author":"戴复古","text":"野人何得以诗鸣，落魄骑驴走帝京。\n白发半头惊岁月，虚名一日动公卿。\n颇思湖上春风约，不柰楼头夜雨声。\n柳外断云筛日影，试听幽鸟话新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日二首呈黄子迈大卿 其二","author":"戴复古","text":"帝里风光二月新，西湖几队踏青人。\n杏花时节偏饶雨，杨柳门墙易得春。\n或是或非尘里事，无穷无达醉中身。\n五陵年少誇豪举，寂寞诗家戴叔伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日风雨中","author":"戴复古","text":"潇潇风雨闭柴门，年纪衰颓病著身。\n大似梁鸿居海曲，略如公干卧漳滨。\n三春晴暖无多日，一世安闲有几人。\n闻道明朝新酝熟，不妨祭灶请比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日怀家","author":"戴复古","text":"细数平生事，何堪挂齿牙。\n客游儿废学，身拙妇持家。\n开瓮尝春酒，租山摘早茶。\n关心此时节，归兴满天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春尽日","author":"戴复古","text":"撚指过三月，又当春夏交。\n花残蜂课蜜，林茂鸟安巢。\n芳草生青霭，新篁展绿稍。\n风骚将断绝，谁有续弦胶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭武刘圻甫以㟳篁隐居图求诗","author":"戴复古","text":"相对两山碧，春风摇绿篁。\n一巢云建造，三涧水宫商。\n谷口躬耕稼，盘中歌寿昌。\n桃花认行路，他日访刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉州紫极宫寿星殿古桧诸葛机宜同赋","author":"戴复古","text":"浪说陈朝八桧碑，何如此桧古而奇。\n灵根据地高千尺，黛色浮空阅四时。\n入欲栋梁劳想像，树存陵谷有迁移。\n寿星赐汝长生诀，化作苍龙守殿墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉南","author":"戴复古","text":"南地无冰雪，常疑暖作灾。\n昼昏山雾合，寒变海风来。\n垄麦衔芒早，梅花带叶开。\n客中归未得，岁事渐相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞霄宫","author":"戴复古","text":"天柱峰头一振衣，云开岩路雨晴时。\n登临欲访神仙事，纪述都无汉晋碑。\n拍手数声龙井跃，篝灯一览洞天奇。\n林间安得栖身处，欲炼金丹饵玉芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪子中大卿同登远碧楼归来有诗","author":"戴复古","text":"角巾华屋下，丘壑在其旁。\n寄兴青山远，忧时白发长。\n无心当世用，袖手看人忙。\n善自为身计，须传活国方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸巳端午呈李伯高","author":"戴复古","text":"客里几逢端午节，看成雪鬓与霜髯。\n救人采得三年艾，背世翻成六日蟾。\n老境可怜归未得，羁怀长是病相兼。\n猛思一醉酬风月，笑撚菖花揭酒帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸卯岁旦","author":"戴复古","text":"淳祐第三载，正朝把一杯。\n老夫真是病，贺客不须来。\n择日脩茅屋，当春觅柳栽。\n新年莫多事，且放好怀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日","author":"戴复古","text":"秋风梧叶雨，衮衮送秋凉。\n一气四时转，几人双鬓苍。\n旧游如说梦，久客乍还乡。\n欲作安居计，生涯尚渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日早行","author":"戴复古","text":"雁叫秋容老，乌飞曙色分。\n晨炊何草草，宿酒尚醺醺。\n野旷连沧海，山长带白云。\n马行沙上路，惊起白鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日病馀","author":"戴复古","text":"桂子吹香风露深，老夫吟了听蝉吟。\n秋来剩有行山兴，病后全无涉世心。\n诗苦积成双白发，酒豪轻用万黄金。\n平生意气今如许，独抱传家一破琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋兴有感","author":"戴复古","text":"客游江海上，几度见秋风。\n远浦芦花白，疏林秋实红。\n人情朝暮变，景物古今同。\n老眼犹明在，从教两耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀","author":"戴复古","text":"红叶无人扫，黄花独自妍。\n听谈天下事，愁到酒樽前。\n水阔终非海，楼高不到天。\n昔人已怀古，况复后千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜旅中","author":"戴复古","text":"旅食思乡味，砧声起客愁。\n夜凉风动竹，人静月当楼。\n浮世百年梦，他乡几度秋。\n店翁新酒熟，一醉更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡倅送羊烹以会客","author":"戴复古","text":"烹膻会宾客，花酒一时来。\n愁逐歌声散，心随笑口开。\n饮疑金盏漏，醉到玉山颓。\n借问欢娱地，相逢能几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舣棹清江","author":"戴复古","text":"舣棹江滨访旧游，十年重到戏渔洲。\n不知芳树在何许，但见落花从此流。\n我醉欲眠因假榻，客行未定且登楼。\n有钱剩买张家酒，准备明朝话别愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觉慈寺","author":"戴复古","text":"踏破白云登上方，自嫌尘土涴禅床。\n千山月色令人醉，半夜梅花入梦香。\n深谷不妨春到早，老僧殊为客来忙。\n山童懒惯劳呼唤，自拗枯松煮朮汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵升卿有官不肯为里居有贤声访之于深巷中","author":"戴复古","text":"深居陋巷不妨幽，翠竹当门水满沟。\n每遇事来先觉懒，欲为官去又还休。\n田园自乐陶元亮，乡里多称马少游。\n除却读书无所好，有时闲作北岩游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵用甫提举梦中得片云不隔梅花月之句时被命入朝雪中送别用其一句补以成章","author":"戴复古","text":"一时议论动诸公，有诏西来玉节东。\n又见清朝更大化，好趋丹陛奏孤忠。\n片云不隔梅花月，一雪翻成柳絮风。\n把酒莫辞今夕醉，明朝车马去匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵丞话旧","author":"戴复古","text":"忆作齐安别，相逢直到今。\n寒温片时话，故旧百年心。\n折柳送行客，栽松遇赏音。\n尊前强歌笑，两鬓雪霜深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵克勤曾橐卿景寿同登黄南恩南楼 其一","author":"戴复古","text":"欲从高处赏新秋，上尽层坡更上楼。\n天地无穷吾辈老，江山有恨古人休。\n宁随狡兔营三窟，且跨飞鸿阅九州。\n忆著当年杜陵老，一生飘泊也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵克勤曾橐卿景寿同登黄南恩南楼 其二","author":"戴复古","text":"鄂州南楼不可到，到此南楼眼亦青。\n乾坤日月与高致，城郭江山无遁形。\n把酒纵谈心耿耿，倚栏遐眺鬓星星。\n世间万事关愁思，莫使秋风吹酒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵叔垕山堂安下其家适有丧事","author":"戴复古","text":"一径沿溪入，数椽松竹间。\n岂知人事变，自觉客身闲。\n采菊出寻酒，移床卧看山。\n苍头无可作，把钓过西湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]