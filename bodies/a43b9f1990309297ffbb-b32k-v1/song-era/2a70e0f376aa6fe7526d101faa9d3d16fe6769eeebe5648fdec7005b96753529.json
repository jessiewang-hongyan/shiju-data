[{"title":"题陆宣公堂","author":"许棐","text":"一编奏议从头读，句句冰联玉缀成。\n不是德宗嫌切直，自缘唐室未升平。\n谄魂尽逐残星灭，义魄长随霁月明。\n我亦爱君忧国者，岁时来一拜先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵兰坡","author":"许棐","text":"弟判嘉兴蔼政声，兰坡兄又出专城。\n如将天上一蟾影，分作人间两郡明。\n江冷雪随帆幅去，路晴梅夹轿窗行。\n开藩便拜归班诏，也与玉山添重名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赵恕可山台","author":"许棐","text":"绕宅无非罨画山，吟台更对好峰峦。\n锦囊低挂花梢上，玉子轻敲竹荫间。\n小砚买来猿解捧，异书编就鹤同看。\n主人出赴功名会，涧水自清云自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小蓑道人","author":"许棐","text":"满面疮痍瘢，胸中一泓雪。\n醒吟鹤背风，醉卧鸥边月。\n不卖嚇鬼符，不试?金诀。\n笑问旧蓑衣，秋来添几结。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题丘竹坡新第","author":"许棐","text":"长安富贵海，十客九倦还。\n君去不著意，君归无愧颜。\n旧圃一二亩，新居十数间。\n花寻直树种，竹简斜枝删。\n诗句满壁写，书编到处安。\n冬檐日春煖，夏户风昼寒。\n不是时令舛，自缘心地宽。\n天下政多事，未须牢闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题雪林画卷","author":"许棐","text":"乱洒春霙著纸寒，玉成天地片时间。\n有人谙尽江湖冷，却爱寻常罨画山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兰花","author":"许棐","text":"竹底松根惯寂寥，肯随桃李媚儿曹。\n高名压尽离骚卷，不入离骚更自高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭南湖见访却适有出一绝为谢","author":"许棐","text":"一篷风雨偶归迟，见说君来扣我扉。\n童子困眠梅树下，不曾放得鹤双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枯树","author":"许棐","text":"几年柴立荒塍下，春雨秋风总不知。\n一点阳和到桃李，红红白白便盈枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱谦斋新居","author":"许棐","text":"住破吴松江上屋，杭州城外结新庐。\n未寻陆羽烹茶具，先借渊明种菊锄。\n山入楼中成好句，月来窗下伴残书。\n御街车马无行处，谁肯抽身觅退居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上赵克家太守","author":"许棐","text":"说著嘉兴太守贤，野梅官柳亦欢然。\n贫民不识重租苦，老吏难将一事瞒。\n但有诗书堆几上，更无歌舞到樽前。\n凡为郡者皆如此，天下何由不治安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵宰琼花图","author":"许棐","text":"祠下灵根无别种，凡花谁敢斗荣枯。\n被君分种鹅溪上，从此人间有两株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄然镜潭","author":"许棐","text":"镜潭炯炯秋无底，著一纤云也是多。\n禅外当无些子事，如何犹有作诗魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茉莉","author":"许棐","text":"荔枝乡里玲珑雪，来助长安一夏凉。\n情味于人最浓处，梦回犹觉鬓边香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题猗绿堂","author":"许棐","text":"萧萧万竿玉，深护读书堂。\n梦趁秋声薄，诗搀夜色凉。\n敲茶风递响，滴砚露涵香。\n不杂有花树，花红不久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵山台寄诗集","author":"许棐","text":"海雁叫将秋色去，山台钞寄好诗来。\n菊花过了梅花未，自有花从笔底开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题东津","author":"许棐","text":"东津占得江山胜，安顿亭台到处宜。\n夜夜中秋明月影，朝朝寒食好花枝。\n长笺短轴真行字，旧轴新编倡和诗。\n只隔一潮飞不去，怅怀惟有白鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄友","author":"许棐","text":"已奏春班名字了，不妨闲作几时游。\n家僮未要装诗担，见说三高索倡酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"红梅","author":"许棐","text":"不堪冷照黄昏月，强倚春风作杏妆。\n虽得容颜暂时好，欠他肌骨旧来香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"迓张宰","author":"许棐","text":"倦骨畏寒如畏虎，可曾一步出柴扉。\n因迎令尹西郊外，折得梅花满把归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢施云溪寄诗","author":"许棐","text":"折得桂花三数枝，云溪又寄几篇诗。\n诗香入在花香里，韵似龙涎火暖时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯梅","author":"许棐","text":"十日九风雪，差见今春寒。\n梅花办归计，一点心欲酸。\n所秉太孤洁，有此末路难。\n来年复相见，一笑贺平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"筑城曲","author":"许棐","text":"日将西，杵声急，一声声自死肠出。\n城高不特土累成，半是铺填怨夫骨。\n儒坑战地骨更多，十二金人随鬼泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌夜啼","author":"许棐","text":"丈人屋侵云，乌爱丈人屋。\n涂人亦爱乌，乌声喜相续。\n屋底间蛾眉，环坐理丝竹。\n丝竹无新腔，写汝声为曲。\n丈人一赏音，瓦砾弃珠玉。\n移噪邻翁家，闻者皆唾逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马塍种花翁","author":"许棐","text":"东塍白发翁，勤朴种花户。\n盆卖有根花，价重无人顾。\n西塍年少郎，荒嬉度朝暮。\n盆卖无根花，价廉争夺去。\n年少传语翁，同业勿相妒。\n卖假不卖真，何独是花树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"染丝上春机 其一","author":"许棐","text":"染丝上春机，春浓丝色浅。\n妾心随梭飞，郎心如轴转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"染丝上春机 其二","author":"许棐","text":"染丝上春机，锦成贵无价。\n不忍裁成衣，怕剪鸳鸯破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长门怨 其一","author":"许棐","text":"妾身如莲根，沉埋淤泥底。\n虽有白玉姿，无人为拈洗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长门怨 其二","author":"许棐","text":"妾身如乱丝，卷藏箱箧底。\n愿上鸳鸯机，无人为分理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋风辞 其一","author":"许棐","text":"飒飒秋风来，一叶两叶坠。\n燕子动归心，薄情知也未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋风辞 其二","author":"许棐","text":"飒飒秋风来，衣衾愁未整。\n莫作闺中寒，且作天涯冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡蝶飞","author":"许棐","text":"胡蝶飞，胡蝶飞，红边迷了紫边迷，粉老香乾何处归。\n不学蜜蜂做家计，勤苦之中有甘味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破琴","author":"许棐","text":"幸逃煮鹤烟，枯羸卧乌几。\n向来千万音，今在何人耳。\n旧谱传不真，零落几张纸。\n瓦缶空雷鸣，牙夔唤不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破砚","author":"许棐","text":"碌碌砻硙间，得此一隽石。\n磨我三十年，貌黧双鬓白。\n渠亦苦我磨，眼穿流泪墨。\n老蟾在傍笑，两穷自相厄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对镜词","author":"许棐","text":"烟护杏腮寒，日衬桃腮暖。\n惟有镜中花，东风都不管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"织锦词","author":"许棐","text":"綵丝愁绪杂春机，咿?声中日又西。\n织到花枝连理处，玉骢门外一娇嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"母忌","author":"许棐","text":"一别音容岁几更，纸灰飞尽泪犹倾。\n最怜春雨相将足，绵上有田谁共耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春思","author":"许棐","text":"朝来一阵无情雨，敲得庭花半欲残。\n燕子不知人冷落，飞来帘底避春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雨","author":"许棐","text":"老来慵把种花锄，片紫纤红一任无。\n不忍今春孤负雨，自收檐水浸菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"燕","author":"许棐","text":"处处亭台宴好春，唱花歌柳调争新。\n梁间不用多言语，回耳听君有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石菖蒲","author":"许棐","text":"一碧生涯水石滨，缕风丝雨瘦精神。\n前身恐是巢由辈，怕著人间半点尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草 其一","author":"许棐","text":"生长冷阶閒砌畔，一春知见几花飞。\n虽沾雨露无多子，却到秋来绿转肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草 其二","author":"许棐","text":"不是东风有爱憎，为怜微细颇加情。\n胚红孕紫宁交晚，且放青青寸草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池鱼","author":"许棐","text":"深浅生涯足，浮沉世念轻。\n莫贪钩上饵，去作鼎中羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳","author":"许棐","text":"青青得意春三月，撩弄东风舞腰活。\n莫道长条舞得多，长条先被行人折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小盆花","author":"许棐","text":"小小盆中花，春风随分足。\n花肥无剩红，叶瘦无欠绿。\n心倾几点香，也饱游蜂腹。\n太盛必易衰，荒烟锁金谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花愿","author":"许棐","text":"未到无生无灭地，聊为春风露红紫。\n不愿随风趁蝶飞，愿就枝头抱香死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谕柳","author":"许棐","text":"不须娇逞舞腰支，不须巧画宫妆眉。\n只把千丝万丝结，结住行人无别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"选官图","author":"许棐","text":"排衔累职甚分明，除罢皆由彩色行。\n纵有黄金无好采，也难平白到公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"猗绿惠烛","author":"许棐","text":"剪剪春生万卷堂，一花知胜几萤光。\n痴儿不识半行字，只解高烧照海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落花","author":"许棐","text":"落花传语五更风，能旁亭台几日红。\n把似匆匆又飞去，不销裁染费春工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落梅","author":"许棐","text":"红杏枝枝娇似染，绿杨处处密成围。\n苦无颜色相追逐，自趁东风作雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠寿医师","author":"许棐","text":"轩窗开处总湖光，诵罢难经纳晚凉。\n雨溅荷香沾古衲，月移松影罩禅床。\n燃灯就取烧丹火，煮药先留瀹茗汤。\n二竖三彭都见佛，人间无病亦无方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈宗之叠寄书籍小诗为谢","author":"许棐","text":"江海归来二十春，闭门为学转辛勤。\n自怜两鬓空成白，犹喜双眸未肯昏。\n君有新刊须寄我，我逢佳处必思君。\n城南昨夜闻秋雨，又拜新凉到骨恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵竹潭","author":"许棐","text":"已彊诗仙一夜留，任教侵早放船休。\n恨身不似梅花片，飞入寒篷伴远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠僧","author":"许棐","text":"僧趁雪前到，梅花犹恨迟。\n略谭残岁梦，便和早春诗。\n僵雁依船宿，寒猿捧砚随。\n吟单未须捲，重见是何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琏市废宅","author":"许棐","text":"双槐枝叶似飘蓬，奕世荣华一旦空。\n燕绕故基寻画栋，鸟栖荒树忆金笼。\n书分几处青灯下，剑入谁家宝匣中。\n遥睇钱塘三尺墓，离离枯草泣低风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿张倅","author":"许棐","text":"明日方重九，先期菊已花。\n固知天有意，欲祝寿无涯。\n玉斝浮金蕊，冰姿映脸霞。\n长生此真术，不用紫河车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"径山冬日","author":"释元肇","text":"东西两径幽，岁晚得周游。\n壑雪阴犹在，溪云冻不浮。\n鸟惊樵斧重，猿挂树枝柔。\n怕有梅花发，因行到水头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞霄宫","author":"释元肇","text":"夹道列苍官，回回水屈盘。\n一峰天柱杪，九锁洞云寒。\n涧草受春绿，山茶落晓丹。\n霜髯雪眉叟，倚杖听惊湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎丘","author":"释元肇","text":"沧海何年涌，秦传虎踞丘。\n池空剑光冷，坟缺鬼吟愁。\n石碍楼台侧，烟深草木浮。\n吴人贪胜槩，春尽亦来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枫桥","author":"释元肇","text":"出郭初逢寺，长洲茂苑西。\n塔风喧梵语，石雨暗唐题。\n日莫山如染，春深草欲迷。\n门前有流水，旧号越来溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐云楼","author":"释元肇","text":"高压子城闉，檐牙半入云。\n人烟极目尽，天语举头闻。\n齐鲁犹堪望，江淮渺莫分。\n平生湖海气，独倚到斜曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姑苏台","author":"释元肇","text":"古今兴废事，天地不能齐。\n水阔连湖外，山多在郭西。\n登临烟雨后，怅望夕阳低。\n若问乌栖曲，城头夜夜啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞庭翠峰","author":"释元肇","text":"峰点浮螺翠，遥波界玉田。\n云中听鸡犬，路入趁渔船。\n浓淡霜天晓，青黄橘户烟。\n寺因明觉住，清响有人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道场山","author":"释元肇","text":"水国山为重，僧居占上头。\n钟声冠别寺，塔杪入他州。\n岩响寒泉雨，风欺老树秋。\n定回缘爱月，增起殿前楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"径山天开图画","author":"释元肇","text":"幽涧泻泠泠，千峰叠障屏。\n晓云开混沌，远水接沧溟。\n松影摇禅榻，苔衣上净瓶。\n尘中梦不到，争欲买丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石头城","author":"释元肇","text":"西风动古情，更上石头城。\n一片斜阳外，几番曾力争。\n天青云破碎，草碧鹭分明。\n寂寞潮回处，如今亦耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨华台","author":"释元肇","text":"高立讲经台，浮云四面开。\n地中遗石子，天上雨华来。\n塔老香灯冷，夜深神鬼哀。\n回看六朝事，只有冢成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌衣园","author":"释元肇","text":"乌衣园里过，不觉立多时。\n旧事人能说，春风燕得知。\n倒垂池上柳，斜插酒边旗。\n来往城南路，年年长别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山","author":"释元肇","text":"长江界楚吴，屹立两浮屠。\n潮觉山高下，云知树有无。\n狂澜中砥柱，静夜浑仪图。\n僧应何方供，飘飘踏一芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海门古城","author":"释元肇","text":"昔闻天祚际，城此镇东州。\n坏堑寻馀镞，荒祠立故侯。\n荆榛无茂日，禾黍几番秋。\n江上寒潮水，依然到石头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"狼山","author":"释元肇","text":"寺因先幻有，仙迹本虞君。\n渡口几点屋，山腰一抹云。\n长江浮地轴，孤塔焕天文。\n欲问秦皇事，高崖迥不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破山兴福寺","author":"释元肇","text":"此山名最重，常建昔题来。\n大士讲经处，老龙拿石开。\n庭前缨络树，池内白莲台。\n几载惟闻说，何当到一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霅城","author":"释元肇","text":"苕霅频年梦，今秋始一过。\n水霾寒气早，山出晚晴多。\n巷陌喧菱市，楼台接棹歌。\n一般清绝处，城里见渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]