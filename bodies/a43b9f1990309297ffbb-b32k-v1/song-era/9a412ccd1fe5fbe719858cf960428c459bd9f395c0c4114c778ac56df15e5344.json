[{"title":"还憩湖光亭复次江元寿韵","author":"沈与求","text":"羊酪莼羹本异区，江湖随俗语娵隅。\n紫鳞拨刺冲文荇，翠羽翩翾过绿蒲。\n舴艋兴饶青络马，笭箵自当紫微壶。\n丛书校罢频搔首，天末孤帆去欲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱德初九日旅怀三绝 其一","author":"沈与求","text":"西风江面荻花秋，鲙玉频年念昔游。\n客帽只今无地落，黄花满眼漫供愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱德初九日旅怀三绝 其二","author":"沈与求","text":"登高虚欲夸能赋，乐事何曾副赏心。\n斜日孤云两愁绝，一觞聊为盍朋簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱德初九日旅怀三绝 其三","author":"沈与求","text":"浊醪自称和山药，小令新能坼水花。\n况有阿戎供细雨，岂知秋思满天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过嘉禾野塘","author":"沈与求","text":"木末孤烟起夕炊，茅檐直下钓鱼矶。\n苍茫远水连天碧，一叶短篷何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仆夫自燕山来云有次律兄书被盗失去","author":"沈与求","text":"投晓平安使，仓皇扣倚庐。\n修涂幸及此，细语问何如。\n云自三关道，曾持一纸书。\n崎岖经寇难，只影到乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜季习游恒山谒府帅刘公辄次刘彦常韵作二诗送之 其一","author":"沈与求","text":"勇往都忘去路难，胸吞螭虎气桓桓。\n吴头楚尾三年梦，塞北江南五月寒。\n瘦马系门留我别，明珠携袖许谁看。\n书生自有西江量，何止能濡舌本乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜季习游恒山谒府帅刘公辄次刘彦常韵作二诗送之 其二","author":"沈与求","text":"上相平胡不作难，已开亭障彻乌桓。\n公朝问罪知谁敌，穷虏要盟故自寒。\n烽燧报安千徼肃，羽书飞捷万人看。\n书生梦想从军乐，隽语铭功墨未乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董深大有诗纪吴江豁然阁旧游索仆继和","author":"沈与求","text":"湖阴旧雨记重来，小阁深明傍水开。\n螮蝀横空桥倒影，琉璃拍岸浪成堆。\n胜游君复羹鱼婢，幽屏予方饭芋魁。\n遥想经行断堤曲，野花漂尽雪玫瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵河阳张先父秀才","author":"沈与求","text":"云疏日薄九秋深，故国悬知咏稿砧。\n试拂青萍怜气在，更携绿绮觉尘侵。\n浮家泛宅三年梦，临水登山万里心。\n小骑羡君盘谷去，肯如思越费清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"托长兴吴宰僦居","author":"沈与求","text":"一区无地可经营，宦牒东西寄此行。\n问舍它时聊尔耳，浮家今日太劳生。\n肯将口腹累安邑，正欲弦歌闻武城。\n为我三间卜茅屋，夜深来听读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄次律兄学士柯田山新居","author":"沈与求","text":"柯田一曲抱清湾，两角孤云拥髻鬟。\n猿鹤惊心招旧隐，桑麻掠眼接通阛。\n似闻小筑终年就，应是幽扉尽日关。\n为报添丁护鸦觜，夜寒归梦绕家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈景修宗博示试院书事二章次其韵 其一","author":"沈与求","text":"岩谷何人叹久幽，纻袍一一赴兼收。\n衔枚尽欲成坚敌，怀璧浑疑忌暗投。\n独讶终篇惜鸡肋，更须添烛校蝇头。\n文章到此无殊律，共赋菁莪汎汎舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈景修宗博示试院书事二章次其韵 其二","author":"沈与求","text":"探帘山鸟一声幽，斗觉晴光烂不收。\n好梦已寻江上去，清篇更许坐中投。\n欣逢阮籍开青眼，肯学虞卿赋白头。\n闻道月波春色满，好携行客住行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵院中四绝句 其一","author":"沈与求","text":"行尽江山不记村，却随花信到重门。\n也知春色娇无赖，取次先来绿草根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵院中四绝句 其二","author":"沈与求","text":"一尊相属语黄昏，密雪飘零正满门。\n记得江桥回马处，冷香应断玉梅魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵院中四绝句 其三","author":"沈与求","text":"要知春色到池塘，深院无人午梦长。\n已觉此身便静乐，自温檀火炷炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵院中四绝句 其四","author":"沈与求","text":"豆蔻梢头春意浓，轻狂无奈赚花风。\n今年拚却寻芳晚，准拟残枝占晚红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石壁寺山房即事 其一","author":"沈与求","text":"云根斸翠接山椒，小筑初营一束茅。\n未放野泉萦曲涧，旋移寒绿引春梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石壁寺","author":"沈与求","text":"山萦细路走修蛇，峭壁连云只藓花。\n木末忽看幡影乱，马头初见殿阴斜。\n回廊迤迤穿危峤，侧涧娟娟露浅沙。\n秀色可餐吾事办，粥鱼茶板莫相誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无言颁政以诗寄行简辄次韵 其一","author":"沈与求","text":"镌磨文律似攻驹，十载相从亦数予。\n卷白欲倾东海酒，闭门贪钞北堂书。\n风烟入眼山围座，鸥鹭惊心水满渠。\n此乐定非公所有，为闻鳌禁席频虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无言颁政以诗寄行简辄次韵 其二","author":"沈与求","text":"平生狗曲视骊驹，妙语琅琅独起予。\n酒面那能伴从事，笔头翻欲戏中书。\n官曹似是惊莲幕，问讯何如念石渠。\n只恐浮名不论数，要须人识士非虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行简用前韵见贻复和酬之","author":"沈与求","text":"岁月如驰斗隙驹，星星著鬓故欺予。\n身宜丘壑长经梦，语到轩裳辄废书。\n扃步共嗟妨远趾，清沟自觉映污渠。\n黄麻白简公心事，此去声名定不虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过卞山次韵朱仰止涧亭绝句 其一","author":"沈与求","text":"曲涧潺潺隐石堤，玉虬双引戏晴漪。\n相思后夜添清绝，木落山空月半规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过卞山次韵朱仰止涧亭绝句 其二","author":"沈与求","text":"环佩琮琤落断崖，水清石瘦没平沙。\n幽人散策经过地，草阁柴扉趁水斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昔年","author":"沈与求","text":"昔年寻贺老，同泛越溪航。\n雨发千岩秀，风供五月凉。\n目因秦望断，心为禹祠伤。\n闻道东湖地，新来足稻粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"沈与求","text":"庭柯脱翳叶，归翼断经过。\n水槛清渔罟，风棂响药罗。\n傲霜荷柄少，团露橘丛多。\n秋色遂如此，愁成今几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"沈与求","text":"林梢吐寒月，清绝不胜任。\n蛮榼凭谁共，胡笳秖自吟。\n探帘风似剪，切户斗如斟。\n何处行舟动，澄波自委金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"沈与求","text":"卯酒剩浇胸礧磈，晨梳聊理发鬅鬙。\n方床自岸乌巾坐，欲校黄庭懒未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日闲居","author":"沈与求","text":"茅屋秋风斗破除，萧骚浑似浣溪居。\n青山侍坐从吾好，黄帽笼头与俗疏。\n赖有园官能送菜，可无溪友解留鱼。\n从今辄莫惭枵腹，一饱须烦插架书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送卢左司赴阙舟中口占","author":"沈与求","text":"胸中渺渺九梦泽，笔底滔滔三峡流。\n自合勋盟真易与，漫回诗律付冥搜。\n平生所慕李君御，今日聊登郭泰舟。\n去矣相望重搔首，百年心事小迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野外罕人事","author":"沈与求","text":"野外罕人事，虽贫心自宽。\n霜蔬供绿节，社酒泛黄团。\n日落归牛近，风微宿鸟安。\n展书遮老眼，灯火砌儒酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过竹西","author":"沈与求","text":"百折清湾抱野田，竹西风物故依然。\n归牛更背斜阳去，牧笛一声吹暮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠老禅","author":"沈与求","text":"霜根刺刺猬圆颅，犹倚禅床听木鱼。\n底事世缘能老我，到头尘事不关渠。\n磨砖几日能成鉴，闭户何人欲造车。\n若有小参重问讯，试寻消息向真如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"成士瑴校登真诀垂就为作此诗问讯","author":"沈与求","text":"硬黄亲校大还书，岩石相看已甚臞。\n会遣五丁供给使，聊烦六甲奉庖厨。\n仙风自昔人何有，灵气于今子岂无。\n知得茅卿近消息，应骖白鹄到清都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢葛鲁卿雪中遣介送酒","author":"沈与求","text":"雪舞白衣朝扣门，一车送酒借春温。\n寒威任减东阳带，和气全归北海尊。\n应为半生怜曲糵，更留它日燕鸡豚。\n是中可饮公须记，报字如鸦醉眼昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十四夜观灯南寺子虚有诗次其韵兼呈骏发次颜","author":"沈与求","text":"娟娟佳月挂南楼，萧寺真成秉烛游。\n火树忽惊新节物，春衫不趁旧风流。\n公方高卧追三已，我亦狂歌发四愁。\n为报襟期得名胜，何妨著处一开眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用子虚韵和呈骏发次颜 其一","author":"沈与求","text":"灯市烧春接郡楼，岁丰人乐事遨游。\n繁弦急管方连夕，痛饮高谈自一流。\n短帽纵堪陪胜赏，长檠那解照牢愁。\n归来卧对西窗月，独想清光烛电眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用子虚韵和呈骏发次颜 其二","author":"沈与求","text":"十里笙箫沸市楼，已占风物两优游。\n人从月窟开青嶂，灯挟星河映碧流。\n曲席深杯成径醉，长廊古寺溢清愁。\n暗中我亦知公在，彊对兰膏为举眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子虚复有诗再次其韵","author":"沈与求","text":"谁能延月倚危楼，细履相将偶当游。\n倦听山歌怀旧俗，闲看水戏溅寒流。\n灯光竞作千门晓，酒力微宽一掬愁。\n明日八分疲阿买，诗馋元只在清眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次夕雨作用子虚韵奉怀次颜知鱼轩小集","author":"沈与求","text":"夹道缯山耸蜃楼，小轩终忆数条游。\n月将人意十分满，雨入溪光一派流。\n静听屐声喧夜市，旋挑灯灺酝春愁。\n闭关不问阴晴事，时怪玄花掠病眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别群从","author":"沈与求","text":"十年劳远梦，今日又征鞍。\n雨入花梢困，风生麦浪寒。\n飘零逢酒怯，老大别家难。\n去矣功名事，终须把镜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瓜步","author":"沈与求","text":"呼声渐逐潮头远，帆影低随日脚斜。\n已喜扁舟近瓜步，江鸥无数立寒沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将达行在所","author":"沈与求","text":"潮落江城暮，帆开一苇轻。\n云屯六龙驻，天近五星明。\n率土朝方岳，何年洗甲兵。\n君王似光武，折箠看升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈子尚博士休官还京口作此诗饯之 其一","author":"沈与求","text":"勇退曾无屋数椽，挂冠神武便飘然。\n陶潜去家一百里，张翰收名四十年。\n平世深知还有几，少时健决已无前。\n侏儒饱食堪羞死，莫浪狂言为著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈子尚博士休官还京口作此诗饯之 其二","author":"沈与求","text":"西风江上荻花秋，鲙玉频年念昔游。\n世事真成一可恸，身名那问二宜休。\n公卿礼饯何为者，僮仆欢迎有此不。\n鬓影毵毵纷翠葆，晚来钟漏亦怀羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得家书","author":"沈与求","text":"国步犹艰棘，不堪频问家。\n霜毛失翠葆，蒿目乱玄花。\n孤客知时节，殊方度岁华。\n干戈就休息，归理邵平瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观琼花","author":"沈与求","text":"千里随河走浊流，樯乌东下指迷楼。\n春风帘幕今何在，只有琼花伴客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事和卓彦翼","author":"沈与求","text":"曈昽晓日上帘旌，帘外幽禽作意鸣。\n呼断故乡千里梦，起来搔首问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"沈与求","text":"造物劳人亦懵哉，又驱疲马上崔嵬。\n经从野店初尝笋，行尽江村始见梅。\n千里短书先梦寐，半生多难足风埃。\n桔槔俯仰成何事，已念渔蓑归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次桐庐 其一","author":"沈与求","text":"决决溪流不满滩，独怜舟子上风湾。\n日斜指点西村渡，竹户茅墙趁碧山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次桐庐 其二","author":"沈与求","text":"吏鞅萦人未许闲，当游聊复到春山。\n倡条冶叶无风味，赖有寒梅醒病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"于潜道中","author":"沈与求","text":"首路潜溪驿，鸡声欲曙天。\n篮舆冲宿雾，栈阁寄层巅。\n高下林端屋，横斜石罅田。\n野泉随处有，草木尽苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新城道中","author":"沈与求","text":"马蹄随意到，回首隔南岗。\n日落鸟犹语，春归花自香。\n长红媚幽谷，新绿涨回塘。\n假榻知何地，昏钟出上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿叶璋桥庵舍","author":"沈与求","text":"渡涧穿林夕未休，野人篝火引前驺。\n惊从略彴滩声急，喜见廜㢝草盖修。\n云卧自惊魂梦冷，星驰先恼肺肝愁。\n乞身老我双溪上，记取端能赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水阁小憩","author":"沈与求","text":"云气昏昏雨脚垂，客行终日倦奔驰。\n竹间小阁临清濑，俯槛观鱼立许时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祁门道中遇雨","author":"沈与求","text":"了事痴人有底忙，箯舆勃窣到南冈。\n樵风槭槭群狙喜，山雨萧萧万木僵。\n谷底暗分冰涧落，舍旁时度野梅香。\n殊方岁晚多悲感，归老丘园此计长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东西二林寺 其一","author":"沈与求","text":"湓浦维舟访梵宫，香炉峰下暂从容。\n重来不为二林景，永远禅师有旧踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东西二林寺 其二","author":"沈与求","text":"在昔得名齐，连墙亦共蹊。\n修篁同碧嶂，寒溜合清溪。\n阁影高低并，钟声左右迷。\n游人俄省悟，东即是林西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东西二林寺 其三","author":"沈与求","text":"游人多入东林寺，将谓西林景不如。\n我策短筇行半日，水声松韵更清虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"千秋岭 其一","author":"沈与求","text":"山河四塞限中原，篱落而今不复存。\n豺虎昼行何日息，但馀征戍满荒村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"千秋岭 其二","author":"沈与求","text":"吴越江南绝壁间，可怜争国似蜗蛮。\n百年父老陶王化，尚记流传一醉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑维心腊月十六日有作 其一","author":"沈与求","text":"国难更频岁，边尘动四溟。\n豺狼饱吞噬，天地失清宁。\n黄屋无安所，霜笳不忍听。\n使臣归路阻，恸绝鬓星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑维心腊月十六日有作 其二","author":"沈与求","text":"朝廷归叛将，关塞失签军。\n铜马犹逋命，沙虫亦占群。\n上心存庙略，兵气乱天文。\n谁挽斜河水，通宵洗赤氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑维心腊月十六日有作 其三","author":"沈与求","text":"血战遮东道，今谁庙食双。\n无人捍彊敌，纵马饮长江。\n寇掠元干纪，兵临反诱降。\n将军自不武，惭色上旌幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵避寇二首 其一","author":"沈与求","text":"穷途厌迁次，岁晚惜分携。\n茅舍荒村北，柴门曲港西。\n鸡豚暂同社，桃李旧成蹊。\n那得干戈定，浮家著两溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵避寇二首 其二","author":"沈与求","text":"宦游成屡却，戎垒怅频遭。\n闻诏趋吴会，经途事董逃。\n心期纾国难，力欲挽人豪。\n漂泊多危涕，真成失木猱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游城山夜归泛舟南溪","author":"沈与求","text":"杖藜寻胜款禅扃，归去扁舟伴月明。\n卧树低摧山脚转，跳鱼拨刺橹牙惊。\n烟埋桥影双霓断，风熨溪光一镜平。\n聚落半空无市井，在亡灯火短长更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]