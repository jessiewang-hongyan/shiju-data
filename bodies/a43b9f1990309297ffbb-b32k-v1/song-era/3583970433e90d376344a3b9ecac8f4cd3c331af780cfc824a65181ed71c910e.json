[{"title":"山居二首 其一","author":"陈与义","text":"点检行年书阀阅，山中共赋几篇诗。\n如今未有惊人句，更待秋风生桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中牟道中二首 其二","author":"陈与义","text":"杨柳招人不待媒，蜻蜓近马忽相猜。\n如何得与凉风约，不共尘沙一并来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中牟道中二首 其一","author":"陈与义","text":"雨意欲成还未成，归云却作伴人行。\n依然壤郭中牟县，千尺浮屠管送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为陈介然题持约画","author":"陈与义","text":"层层水落白滩生，万里征鸿小作程。\n日暮微风过荷叶，陂南陂北听秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月二日避贵寇入洞庭湖绝句","author":"陈与义","text":"鼓发嘉鱼千面雷，乱帆和雨向湖开。\n何妨南北东西客，一听湘妃瑶瑟来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水车","author":"陈与义","text":"江边终日水车鸣，我自平生爱此声。\n风月一时都属客，杖藜聊复寄诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"火后借居君子亭书事四绝呈粹翁 其一","author":"陈与义","text":"天公恶剧逐番新，赖是今年有主人。\n君子亭中眠白昼，燕公楼上眺青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"火后借居君子亭书事四绝呈粹翁 其二","author":"陈与义","text":"祝融回禄意佳哉，挽我梅花树下来。\n一夜东风不知惜，月明满树十分开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"火后借居君子亭书事四绝呈粹翁 其三","author":"陈与义","text":"斫竹和梢编作篱，微风如在竹林时。\n无人来访庞居士，晚日疏阴光陆离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"火后借居君子亭书事四绝呈粹翁 其四","author":"陈与义","text":"入山从此不须深，君子亭中人不寻。\n青竹短篱围昼静，梅花两树照春阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王孙岭","author":"陈与义","text":"已过长溪岭更危，伏龙莽莽向川垂。\n斜阳照见林中石，记得南山隐去时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其九","author":"陈与义","text":"范公深忧天下日，仁祖爱民全盛年。\n遗庙只今香火冷，时时风叶一骚然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其八","author":"陈与义","text":"诏书忧民十六事，父老祝君一万年。\n白发书生喜无寐，从今不仕可归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其七","author":"陈与义","text":"不须夜夜看太白，天地景气今如斯。\n始行夷狄相攻策，可惜中原见事迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其六","author":"陈与义","text":"杨刘相倾建中乱，不待白首今同归。\n只今将相须廉蔺，五月并门未解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其五","author":"陈与义","text":"皇家卜年过周历，变故未必非天仁。\n东南鬼火成何事，终待胡锋作争臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其四","author":"陈与义","text":"莫嫌啖蔗佳境远，橄榄甜苦亦相并。\n都将壮节供辛苦，准拟残年看太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其三","author":"陈与义","text":"瓦屋三间宽有馀，可怜小陆不同居。\n易求苏子六国印，难觅河桥一字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其二","author":"陈与义","text":"千里空携一影来，白头更著乱蝉催。\n书生身世今如此，倚遍周家十二槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其一","author":"陈与义","text":"小儒避贼南征日，皇帝行天第一春。\n走到邓州无脚力，桃花初动雨留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓州西轩书事十首 其十","author":"陈与义","text":"诸葛经行有夕风，千秋天地几英雄。\n吊古不须多感慨，人生半梦半醒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙寺桂花重开","author":"陈与义","text":"天遣幽花两度开，黄昏梵放此徘徊。\n不教居士卧禅榻，唤出西厢共看来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出山二首 其二","author":"陈与义","text":"山空樵斧响，隔岭有人家。\n日落潭照树，川明风动花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出山二首 其一","author":"陈与义","text":"阴岩不知晴，路转见朝日。\n独行修竹尽，石崖千丈碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶楠惠花","author":"陈与义","text":"无住庵中老居士，逢春入定不衔杯。\n文殊罔明俱拱手，今日花枝唤得回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十六日夜二绝 其二","author":"陈与义","text":"二更风薄竹，悲吟连夜分。\n村西递馀韵，应胜此间闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉堂儤直","author":"陈与义","text":"庭叶珑珑晓更青，断云吐日照寒厅。\n只应未上归田奏，贪诵楞伽四卷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘棠道中","author":"陈与义","text":"笋舆碍石一悠然，正月微风意已便。\n桃花向来浑不数，山中时见绝堪怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石限病起","author":"陈与义","text":"幽人病起山深处，小院鸦鸣日午时。\n六尺屏风遮宴坐，一帘细雨独题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋 其一","author":"陈与义","text":"西园芳气雨馀新，唤起亭中入定人。\n为报使君多酿酒，梅花落尽不关春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋 其二","author":"陈与义","text":"扬州云气郁佳哉，百虑方横吉语来。\n却看诗书安隐在，竹篱阴里得时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋 其三","author":"陈与义","text":"危楼只隔一重篱，谁见扶筇独上时。\n如许江山懒搜句，燕公应笑我支篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋 其四","author":"陈与义","text":"欲识道人门径深，水仙多处试来寻。\n青裳素面天应惜，乞与西园十日阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋二首呈奇父 其二","author":"陈与义","text":"香遍东园花一枝，寻花觅路忽成迷。\n先生莫道心如铁，喜气朝来横角犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋二首呈奇父 其一","author":"陈与义","text":"国香薰坐先生醉，秋叶藏花客子迷。\n驱使晚风同胜地，东轩不用镇帷犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同家弟赋蜡梅诗得四绝句 其四","author":"陈与义","text":"一花香十里，更值满枝开。\n承恩不在貌，谁敢斗香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同家弟赋蜡梅诗得四绝句 其一","author":"陈与义","text":"朱朱与白白，著意待春开。\n那知洞房里，已傍额黄来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同家弟赋蜡梅诗得四绝句 其二","author":"陈与义","text":"韵胜谁能舍，色庄那得亲。\n朝阳一映树，到骨不留尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同家弟赋蜡梅诗得四绝句 其三","author":"陈与义","text":"黄罗作广袂，绛帐作中单。\n人间谁敢著，留得护春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同继祖民瞻游赋诗亭二首 其二","author":"陈与义","text":"浩浩白云溪一色，冥冥青竹鸟三呼。\n只今那得王摩诘，画我凭栏觅句图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同继祖民瞻游赋诗亭二首 其一","author":"陈与义","text":"邂逅今朝一段奇，从来华屋不关诗。\n诸君且作留连意，正是微风到竹时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻诗两绝句 其二","author":"陈与义","text":"爱把山瓢莫笑侬，愁时引睡有奇功。\n醒来推户寻诗去，乔木峥嵘明月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻诗两绝句 其一","author":"陈与义","text":"楚酒困人三日醉，园花经雨百般红。\n无人画出陈居士，亭角寻诗满袖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏大光送酒","author":"陈与义","text":"折得岭头如玉梅，对花