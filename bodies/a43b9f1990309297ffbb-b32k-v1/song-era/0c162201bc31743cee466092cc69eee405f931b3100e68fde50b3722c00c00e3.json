[{"title":"沁园春 寿楚阳赵宰四月初二","author":"周申","text":"瑞应柯山，昴宿储祥，嵩岳降神。\n羡堂堂玉莹，汪汪陂量，一襟风月，满腹经纶。\n试问丹砂，聊乘凫舄，来种锦江桃李春。\n弦歌地，看吏能绰著，荐墨争新。\n从兹大振家声。\n待京国来归专秉钧。\n想宸恩初拜，北门学士，都能尽道，东阁郎君。\n雨细丝轻，梅花金重，两荚宝阶呈瑞蓂。\n称觞庆，愿莱衣衮衮，长照庄椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壶中天/念奴娇 寿妇人又良人登科七月初二","author":"周申","text":"秋来两日，因个甚、乌鹊侵晨传喜。\n却是常娥亲姊妹，降作人间佳丽。\n黛柳长青，官梅稳衬，镜里春明媚。\n花颜难老，寿杯频劝浮蚁。\n闻道潇洒才郎，天庭试罢，名挂登科记。\n昨夜凉风新过雁，还有音书来寄。\n千万楼台，三千粉黛，今在谁家醉。\n归来欢笑，一床真个双美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月泉","author":"周仲卿","text":"石罅玉为髓，月梭金作棱。\n苍苔谁凿破，白雪自坚凝。\n穿岂太山霤，清于万壑冰。\n此中无六月，门外气如蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送枢密相公楼仲晖归田","author":"周因","text":"云水茫茫惨别情，悲风吹树作离声。\n酒倾银斝临江浒，潮落沙汀带月明。\n千里绿烟芳草合，一天□雨落花轻。\n老予对景成三叹，不觉潸然泪雨倾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"周因","text":"一网多收泮水英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡冠花","author":"周师成","text":"爪距深藏独露冠，紫茸簇出弄清寒。\n五更月下朦胧看，只欠一声惊夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周处台 其一","author":"周师成","text":"孝侯远矣使人怀，安得从之上此台。\n几回一舸荆溪上，苦被风帆浪桨催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周处台 其二","author":"周师成","text":"克己功夫鲜矣能，孔堂今继仲由登。\n试从台上看台下，狂圣中间隔几层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下水门税亭","author":"周师成","text":"建业尘中吏，秦淮水上亭。\n浴晴凫弄日，饮晓马吞星。\n地迥来芳草，潮回出断汀。\n有僧时到此，相对两浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"周师成","text":"元嘉王子宅，李白重登临。\n鸣凤元非昔，蟠龙直到今。\n凄凉微子事，寂寞茂弘心。\n望断长安日，悬知属意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭","author":"周师成","text":"昔日新亭今则旧，百年名义只如新。\n高谈坐上无安石，洒泪尊前有伯仁。\n对面飞来帆影少，传音吹过羽书频。\n青天重唤当时月，放下清光照坐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古诗 其一","author":"周师成","text":"昔怀今未归，悄悄与谁语。\n超超何所为，空斋听春雨。\n锵然金玉声，幽窗相尔汝。\n政以平在中，万物皆媚妩。\n暗想四城外，花草不可数。\n浮云日夜征，东皋怅何许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古诗 其二","author":"周师成","text":"德人天机深，凡子人心多。\n懔余思寡过，月计愧盈科。\n勿谓玉无玼，当知石可磨。\n四十尚无闻，素心恐蹉跎。\n汲我檐下井，浇我盘中花。\n清香未似之，懒惰欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵","author":"周师成","text":"故国已云久，地馀风流情。\n山花不断市，江鸥长入城。\n青溪泓玉水，红楼调春声。\n斟酌飞仙过，枉辔一来行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅","author":"周师成","text":"采采芳梅枝，琐碎白云姿。\n在山千花怨，出山百鸟啼。\n操持思所寄，转趾述所思。\n清披太始风，寒应太虚月。\n一日拂人衣，三岁香不歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬张韩伯","author":"周师成","text":"楚人逢楚节，仍赋楚情诗。\n滴酒长江远，思乡白日迟。\n遥怜壮士腕，也系儿女丝。\n若有盈妾艾，榴花勿并持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"周师成","text":"黄芦花白月无赖，乌桕叶红秋可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"周师成","text":"花缩添新紫，香消减旧黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"周式","text":"花前嫫母丑，雪里屈原醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"周式","text":"珠帘绣户迟迟日，柳絮梨花寂寂春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百门泉","author":"周百禄","text":"光摇暗日动珠盘，汎汎轻风漾碧澜。\n俯槛恍然惊醉眼，云天却向镜中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居","author":"周自中","text":"又是閒中一日过，明朝活计看如何。\n拾薪童子归来晚，报说南山野菜多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠西山磊泉庵僧","author":"周自中","text":"门掩古崖碧，霜欺苔径斑。\n去城无一里，此地若深山。\n留客吟松下，驱泉过竹间。\n羡师无外事，相伴白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琴","author":"周芝田","text":"膝上横陈玉一枝，此音唯独此心知。\n夜深断送鹤先睡，弹到空山月落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"周芝田","text":"淋漓满腹藏春雨，突兀半拳生晓云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈彦育游钟山韵","author":"周邦","text":"雄压吴头控楚腰，千峰环拱冶城桥。\n黄旗紫盖旋归汉，古刹凄凉尚号萧。\n北岳经行匪滥巾，相陪来现隐沦身。\n春萝秋桂还吾辈，白浪红尘付若人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十四日至越州置酒泛湖欲往诸刹风作不能前","author":"周邦彦","text":"青山定厌俗人游，萝帐云屏到即收。\n更欲凌波访幽刹，疾风已戒早回舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"周邦彦","text":"危台飘尽碧梧花，胜地凄凉属梵家。\n凤入紫云招不得，木鱼堂殿下饥鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"周邦彦","text":"耕人扶耒语林丘，花外时时落一鸥。\n欲验春来多少雨，野塘漫水可回舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春帖子","author":"周邦彦","text":"鸾辂青旂殿阁宽，祠官奠璧下春坛。\n晓开鱼钥朝衣集，綵胜飘扬百辟冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"周邦彦","text":"窗风猎猎举绡衣，睡美唯应枕簟知。\n忽有黄鹂深树语，宛如春尽绿阴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩书 其三","author":"周邦彦","text":"丽日烘帘幔影斜，酒馀春思托韶华。\n高楼不隔东南望，苦雾游云莫谩遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩成 其二","author":"周邦彦","text":"河声连底卷黄沙，回首方惊去国赊。\n唯有客情无尽处，暗随春水涨桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕","author":"周邦彦","text":"翠华临阙巷无人，曼衍鱼龙触眼新。\n羽蝶低昂万人醉，木山綵错九城春。\n闲坊厌听粻䊗鼓，晓漏犹飞轣辘尘。\n谁解招邀狂处士，掺挝惊倒坐中宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿宋守","author":"周邦彦","text":"珥笔曾趋殿两间，冰姿清彻照朝班。\n民讴在处思廉范，谏疏何人忆贾山。\n竹简翻经秋闭阁，玉棋欢客夜留关。\n直须剩饮邦人寿，天上如今欲赐环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿陈运干","author":"周邦彦","text":"节过中和日有三，台星一点下江南。\n因仍睿算疏恩宠，多少春风在笑谈。\n颂祝椒花随以柏，恩袍欺草绿于蓝。\n儿孙更祝无穷寿，齐指庄椿愿与参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩书 其二","author":"周邦彦","text":"旧识回文谱，新谐远调讴。\n望归朝对镜，合饮夜藏钩。\n融蜡粘花蒂，烧檀暖麝油。\n双眉谁与画，张敞自风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩书 其一","author":"周邦彦","text":"窗影蝇飞见，帘花日照成。\n汗馀胡粉薄，香度越罗轻。\n书叶蚕头密，调笙凤咮鸣。\n情来愁不语，极目雁南征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下帷斋","author":"周邦彦","text":"官事如拔毛，小稀还复稠。\n一鼠未易尽，况欲秃九牛。\n唯应理签轴，偷暇寻孔周。\n维南有颓构，畴昔宾射侯。\n扶倾与丹雘，外好中实不。\n弦歌废决拾，休王良有由。\n书生本不武，谁言负薪忧。\n古云不执弓，防患术已媮。\n诗书主六艺，中有捍敌谋。\n至胜不刃血，吾将执其柔。\n当有中的士，为辨劣与优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天启惠酥 其一","author":"周邦彦","text":"金城良牸不当车，特为人间作好酥。\n馀湩尚供肥犊子，小奁先入太官厨。\n邺中鹿尾空名目，吴地莼羹谩僻迂。\n欲比君家好兄弟，不知谁可作醍醐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天启惠酥 其二","author":"周邦彦","text":"浅黄拂拂小鹅雏，色好从来说雍酥。\n花草偏宜女儿手，缄封枉入野人厨。\n细涂麦饼珍无敌，杂炼猪肪术最迂。\n脔肉便知全鼎味，它时不用识醍醐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天启惠酥 其三","author":"周邦彦","text":"南朝珍馔一时无，尚见休文谢北酥。\n陶瓮解汤香出屋，铜铛掠面乳供厨。\n中都价重无钱买，京兆书迟怪路迂。\n闻道加餐最肥泽，异时烦与致醍醐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天启惠酥 其四","author":"周邦彦","text":"高阳太守有遗书，亲教齐民炼玉酥。\n欲出浮膏先卧酪，为防馋鼠更薰厨。\n绝知意重分馀弃，渐见诗多入怪迂。\n犹恐伧人笑风土，预从贝叶检醍醐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天赐白","author":"周邦彦","text":"君不见书生镌羌勒兵入，羌来薄城束缚急。\n蜡丸飞出辞大家，帐下健儿纷雨泣。\n凿沙到石终无水，扰扰万人如渴蚁。\n挽縆窃出两将军，敌箭随来风掠耳。\n道傍神马白雪毛，噤口不嘶深夜逃。\n忽闻汉语米脂下，黑雾压城风怒号。\n脱身归来对刀笔，短衣射虎朝朝出。\n自椎杂宝涂箭创，心折骨惊如昨日。\n谷城鲁公天下雄，阴陵一跌兵力穷。\n舣舟不渡谢亭长，有何面目归江东。\n将军偶生名已弱，铁花暗涩龙文锷。\n缟帐肥刍酬马恩，閒望旄头向西落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开元夜游图","author":"周邦彦","text":"潞州别驾年十八，弯弓射鹿无虚发。\n真龙绝水鱼鳖散，参军后骑凫鸥没。\n咸原瑞气映壶关，城南书生知阿瞒。\n解鞍下马日向夕，炙驴行酒天为欢。\n坐上何人识天意，擪帽破靴朝邑尉。\n旄头夜转紫垣开，太白光芒黄钺利。\n万骑齐呼左右分，将军夜披玄武门。\n鏖兵三窟尽妖党，问寝五门朝至尊。\n羽林萧萧参旗折，太极瑶光净烟雪。\n杀身志在攀龙鳞，唾手成功探虎穴。\n麾下且侯李与王，轻形玉带持箙房。\n晋文赏功从悉录，汉光道旧情无忘。\n与宴宫中张秘戏，复道晴楼过李骑。\n连催羯鼓汝阳来，一抹鲲弦薛王醉。\n玉阶凄凄微有霜，天鸡唤仗参差光。\n宜春列炬散行马，长乐疏钟严晓妆。\n清丝急管欢未毕，瑶池八马西南出。\n扪参历井行道难，失水回风永相失。\n君不见当时韦杜间，呼鹰走狗去不还。\n坐间年少莫大语，临淄郡王天子父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"周邦彦","text":"石濑光洄洄，沙步平侹侹。\n枫林名一社，舂汲共寒影。\n藩篱曲相通，窈窕花竹静。\n兹焉自足乐，未觉丘园迥。\n令尹虽无恩，黠吏幸先屏。\n唯当谨时候，田庐日三省。\n骄儿休马足，高廪付牛领。\n无人横催租，烹鲜会同井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙杏山","author":"周邦彦","text":"仙人药光明夜烛，种杏碧山如种玉。\n春风裂石凤收花，赤颊离离照山谷。\n卿云承日作阴润，猛虎守山防采斸。\n高真筐篚入时贡，拜望通明荐新熟。\n珠旒颔首一破颜，气压蟠桃羞若木。\n自从移植近星榆，山水无光灵鬼哭。\n长松枯倒流液尽，棹赖牵藤多朴樕。\n我思百年访灵异，羽褐虽存言语俗。\n本非民土宰官身，欲断人间烟火谷。\n行寻幽洞觅丹砂，傥见臞仙骑白鹿。\n便应执帚洗仙坛，不用纤纤扫尘竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夙兴","author":"周邦彦","text":"曈曈海底日，赤辉射东方。\n先驱敛群翳，微露不成霜。\n早寤厌床笫，起步东西厢。\n引手视掌纹，黯黯未可祥。\n念此阅人传，三年得跧藏。\n弛担曾几时，兹焉忽腾装。\n问今何所之，意行本无乡。\n晨钟神惨悲，夜鼓思飞扬。\n与俗同一科，何异犬与羊。\n平明催放钥，利害纷相攘。\n颠倒走群愚，岂但渠可伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周朝宗六月十日泛湖 其一","author":"周邦彦","text":"霖潦合支流，洲浦迷片段。\n两桨入菰蒲，凫鸥欻惊散。\n疏林直炊烟，落日斜酒幔。\n王事得淹留，公私各相半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周朝宗六月十日泛湖 其四","author":"周邦彦","text":"维舟瞰层波，未忍分练段。\n人间好风味，鱼鸟同聚散。\n儒生长窘束，书灯守幽幔。\n逐乐嗟已迟，蚤还犹及半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周朝宗六月十日泛湖 其二","author":"周邦彦","text":"风舟挽犹迟，兀若乘款段。\n深行蛟龙国，飐荡光炯散。\n洲凉扇荷箑，山晚垂云幔。\n眷言江海期，百年行欲半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周朝宗六月十日泛湖 其三","author":"周邦彦","text":"沟塍绕湖干，琐细分顷段。\n湖洄晚渔集，山静村樵散。\n冲风偃萑菼，猎猎如捲幔。\n何当饮清光，乘月行夜半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周朝宗六月十日泛湖 其五","author":"周邦彦","text":"君才切玉刀，一举成两段。\n我如抟沙砾，放手辄星散。\n传闻紫贝阙，薜荔充帷幔。\n楚吟尚多亡，君诗补其半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹城","author":"周邦彦","text":"竹城何檀栾，属翠分雉堞。\n王封尽四堑，同有岁寒节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芝朮歌","author":"周邦彦","text":"华阳之天诸洞府，阿穴便门迷处所。\n三君谒帝不知还，帐冷祠空遗鹤羽。\n玉津宝气久成腴，灵朮神芝时出土。\n日精潜烛山自明，人力穷搜神不与。\n前年栋挠作新宫，坎坎空岩响斤斧。\n君来胎禽舞海雪，君去山云杂川雨。\n是生朱草示尘寰，故遣樵青入林莽。\n檗膏紫漆自坚栗，下附天苏蟠石坞。\n肉人但恐奇祸作，药笼复忧神物取。\n庐陵太守蕴仙风，健骨清姿欲飞举。\n阴功除瘼民已悦，灵药引年天亦许。\n愿因服饵断膏粱，未让南华养生主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过左伯桃羊角哀墓","author":"周邦彦","text":"古交久沦丧，末世尤反覆。\n谷风歌焚轮，黄鸟譬伐木。\n永怀羊与左，重义踰血属。\n客行干楚王，冬雪无斗粟。\n倾粮活一士，誓不俱死辱。\n风云为惨变，鸟兽同踯躅。\n角哀哭前途，伯桃槁空谷。\n终乘大夫车，千骑下棺椟。\n子长何所疑，旧史刊不录。\n独行贵苟难，义侠轻杀戮。\n虽云匪中制，要可兴薄俗。\n荒坟邻万鬼，溘死皆碌碌。\n何事荆将军，操戈相窘逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀隐堂","author":"周邦彦","text":"昔贤抱奇识，阅世犹鼠肝。\n深颦畏轩冕，自谓山林宽。\n至今仰高躅，凛若冰雪寒。\n我侯坐少孤，久著聚鹖冠。\n辛勤取微鴳，屡费黄金丸。\n归来长太息，依旧一瓢箪。\n偶逢隐者谷，爱此高巑岏。\n结庐面绝壁，所幸一枝安。\n侯今未全老，每据伏波鞍。\n曷不持长缨，取虏报县官。\n功名事不磨，未可乐丘墦。\n嗟我如鹪鹩，尽室寄苇萑。\n谋居转幽邃，欲把严陵竿。\n归乏环堵室，始觉生理难。\n因侯有华构，弥起百忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投子山","author":"周邦彦","text":"缅怀鲁将军，兵败携部曲。\n来投衲子衣，解甲饭戎菽。\n谁令名此山，异代有馀辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远游","author":"周邦彦","text":"淮西渡两桨，江左随一鸥。\n苦嗟波涛窄，所至胶吾舟。\n借问舟中人，流转何时休。\n帆高风色利，欲止不自由。\n传闻弱水外，鼎立三神丘。\n鼓枻未可到，载行有潜虬。\n扶桑睹浴日，阳精热东流。\n万族呈秘怪，九土皆飘浮。\n送者安在哉，吾往不可求。\n岂比鸱夷子，并湖名远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿灵仙观","author":"周邦彦","text":"灵宫耽耽虎守谷，羽褐出山邀客宿。\n稽首中茅司命君，四叶秉符调玉烛。\n鸣金击石天相闻，游飙倒影声磷磷。\n戏上云崖撼琼树，脱叶出溪惊世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚憩杜桥馆","author":"周邦彦","text":"寒茅愔愔鸡啄场，儿啼索衣天陨霜。\n密林渐放山色入，枫枯振槁声琅琅。\n清浆白羽弃已久，黄菊紫萸看欲香。\n岁行及此去愈疾，若决积水难堤防。\n嗟予齿发非故物，念此内热如涫汤。\n愿见唐朝吕墨客，膝行问道求神方。\n斋心千日百事毕，消我颔雪还韶光。\n岂饶蒿目忧世事，黄金绾腰埋土囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]