[{"title":"赠逸人","author":"黄希旦","text":"白云处士入云中，三尺焦琴百尺松。\n长啸一声寒涧远，千崖万壑起清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠宝幢修山主","author":"黄希旦","text":"瑶幢真胜概，晦迹一禅翁。\n语默呈心印，纵横振祖风。\n昼闲人事外，夜静月华中。\n若问春来意，松青百卉红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日登楼","author":"黄希旦","text":"高阁倚斜阳，登临觉倍凉。\n残蝉空自咽，归燕为谁忙。\n蔽日云头猛，沿山雨脚长。\n竹村溪上影，彷佛似潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀中孚","author":"黄希旦","text":"暌违虽未久，南走梦魂多。\n客路随飘梗，年光叹掷梭。\n叶凋隋苑树，风走洞庭波。\n旧约龙山会，归来赴若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚眺","author":"黄希旦","text":"晚凉思远眺，策杖出松林。\n车马自来往，路岐横古今。\n商飙未落叶，永巷已鸣砧。\n自笑眠云客，因时感激深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄友人","author":"黄希旦","text":"性僻少知已，惟君日往还。\n听琴怜寂静，赊酒笑艰难。\n俗眼从他白，吾侪且任闲。\n生涯人莫问，到处有云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简袭庆斋主人","author":"黄希旦","text":"雨过浮山好，无如袭庆斋。\n主人操大雅，楼阁俯苍崖。\n槛碧摇新柳，庭黄发嫩槐。\n登临诗酒兴，此际与谁偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远游","author":"黄希旦","text":"自在远游去，闲门谁见过。\n援琴空转轸，对酒不成歌。\n秋景生新桂，凉风撼败荷。\n天涯谁是侣，岁暮莫蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋半","author":"黄希旦","text":"晚吹生丛竹，凄凉又半秋。\n年华惊倏忽，人事觉淹留。\n林噪残蝉急，山光暮雨收。\n登临将眺望，烟雾闭层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古意","author":"黄希旦","text":"大道长闲闲，人心自草草。\n天地固无私，贤愚同一老。\n谁信丹丘人，颜色常美好。\n我亦斯人徒，相从须及早。\n君看东流波，日夜长浩浩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄益老侍官南康","author":"黄希旦","text":"匡山胜概昔贤钦，今日多君复访寻。\n李白书堂萤自照，乐天掸室月空临。\n涧松岩桧当年色，雾鹤霜猿此际音。\n莫对他山忘故里，武夷秋晚洞云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹洞","author":"黄希旦","text":"竹洞新开碧玉林，径幽疑入五华深。\n夜筛明月一天静，昼拥青云四座阴。\n剪杖伫看雷雨化，迎风时听凤凰吟。\n烟霞不用重关闭，尘俗谁能此访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯夕和韵","author":"黄希旦","text":"年年此夕鬨闾阎，岂料闲居兴自恬。\n竞逐艳阳游冶去，宁知华发等闲添。\n火连夜市曾无禁，灯混星文不可占。\n闻道玉楼欢宴处，夜阑犹未卷珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读禅月集","author":"黄希旦","text":"唐末高僧号贯休，篇章激切近诗流。\n烟华雪月何妨咏，水竹云林不碍游。\n蜀国至今名籍甚，兰溪当日迹淹留。\n此心弹指虽云妙，争奈阇黎未点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居","author":"黄希旦","text":"草堂啸傲动经年，已把生涯付自然。\n谩费工夫披古籍，懒通名字谒时贤。\n炉中闲养阴阳火，身外谁求子母钱。\n寄语王褒如著论，不同呼吸学神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李尊师","author":"黄希旦","text":"底事悠悠信莫闻，还疑深入武陵源。\n几年江上秋风夜，故国闽中暮雨村。\n尘世功名宁自笑，蓬壶旨趣有谁论。\n路岐无尽人空老，白发慈亲奈倚门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢人惠星冠","author":"黄希旦","text":"学道多年尚屈蟠，岂胜仙伯赠峨冠。\n晓簪乍觉星攒顶，夜戴偏宜月满坛。\n对鉴宁烦朋友正，避时羞为利名弹。\n豫思他日云林下，轻罩纱巾鹤发寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幔亭","author":"黄希旦","text":"曾孙尝会幔亭中，脯擘麒麟酒满钟。\n宴罢不知消息处，至今乡老望孤峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读方干诗","author":"黄希旦","text":"数篇骚雅名虽远，三拜逢迎礼过差。\n补得唇来身巳老，灌园何苦更咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贾鸿举移竹","author":"黄希旦","text":"琳房珠馆何虚寂，宝砌无尘苔藓碧。\n仙翁倚槛静吟哦，却忆筼筜拂岩石。\n劲节虚心守岁寒，未尝暂变风霜色。\n移来迢递不辞劳，深根讶向瑶台植。\n渐承春意叶青青，时惹天香烟幂幂。\n月笼翠影尚萧疏，露被繁枝谗滴沥。\n迎风闲夜拟龙吟，结实他年期凤食。\n非才终约老烟霞，此际谬当亲采择。\n寄言红紫莫相猜，彼此无情蒙化力。\n逢时剪拂任他人，沈去葛陂都咫尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感时行","author":"黄希旦","text":"劝君莫种木槿花，朝荣暮落堪咨嗟。\n劝君种取亭亭竹，霜繁风劲依然绿。\n谁不见陈余张耳辈，当面论交旋踵背。\n又不见管鲍光武与严光，贫贱富贵难相忘。\n英声独与天地长，令人万古遥相望，不可得见空徬徨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观申公山水","author":"黄希旦","text":"申公山水老更狂，耽耽巨耳双瞳方。\n生涯秃笔数千管，欲与造化争毫芒。\n长烟三素挂四壁，经营指点何安详。\n凝神净虑偶得意，一洒混沌开玄黄。\n须臾三才及万类，迤逦笔下分低昂。\n水寒石瘦老木怪，蒹葭岸占天苍苍。\n伊馀本是山间叟，对此直欲乘风翔。\n咫尺杳然数万里，直疑跳入壶中藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄友人","author":"黄希旦","text":"昔游西太乙，今日返成都。\n若问去来事，云藏月影孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试心石","author":"黄希旦","text":"屏列郡南隅，子真常此憩。\n雨欲泽人间，云霞先掩蔽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西庵寺","author":"黄希旦","text":"胜刹幽深枕县西，我来正值孟冬时。\n虽无慧远门堪叩，幸有陶潜驾可随。\n世态阶前朝槿色，岁寒云外老松枝。\n繄余本是林泉客，到此宁惭漫赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九龙观","author":"黄希旦","text":"峨峨古仙宫，楼殿荫松柏。\n昔在贞观年，天皇御区域。\n九龙出池中，遗下灵踪迹。\n嘉祐辛丑岁，郡侯得召伯。\n是时夏六月，云日红翕赩。\n殿北古龙堂，窗户久不辟。\n俄然灵蛇见，宛转真像侧。\n鳞甲锦绣文，灿烂辉五色。\n视之颇驯扰，狎之不惊惕。\n邯侯率群僚，朋来拥旌戟。\n迟留夜未午，风雨满天黑。\n迅电瞥四起，狂雷随一击。\n须臾风雨收，形影谁能觅。\n斯盖龙之灵，变化固难测。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"黄希旦","text":"地水火风，强名四大。\n迷荡真源，种种憎爱。\n咄哉憨痴，会即便会。\n云散月明，朗同沙界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越王台","author":"黄希旦","text":"荒台枕古邱，伊昔越王游。\n辇路今何在，凄凉草树秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其一 竹径","author":"俞充","text":"入谷修竹密，苍翠连前山。\n车马迹不到，鸡犬音亦闲。\n蔽日清影合，迎风碎声寒。\n渐近居士庐，溪水流潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其二 贻溪","author":"俞充","text":"濯缨溪流上，清心共澄澈。\n人存鱼自跃，人亡鱼亦竭。\n此意虽冥冥，可与仁者说。\n遣音竞谁继，十里闲风月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其三 休休亭","author":"俞充","text":"洗耳谢市朝，构亭得馀址。\n三径草长深，一毫尘不起。\n支肘看青山，引鹤听流水。\n独有爱君心，时时拟纶旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其四 表圣影堂","author":"俞充","text":"事去惟山存，遣祠临水曲。\n峻节凌雪霜，英颜瑩冰玉。\n至今崖壁间，尚耐尘埃辱。\n清风满林泉，千戴仰高躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其五 天柱峰","author":"俞充","text":"擎天有八柱，是峰居其一。\n根蟠地轴壮，群山俯为硕。\n共工触不折，万古耸崒嵂。\n幽人步绝顶，引手攀星日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其六 瑩心亭","author":"俞充","text":"野老传此水，源与洪河透。\n潺潺浩难穷，雨雹洒晴昼。\n岩头白龙挂，滩前寒玉漱。\n不见瑩心人，客衣冷如沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其七 双人石","author":"俞充","text":"屹立高峰东，峭直如昔贤。\n夷齐耻周食，巢由傲尧天。\n不畏风霜侵，所依松柏坚。\n五老静相对，森森莫知年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其八 司空氏旧居","author":"俞充","text":"孤鹤去不还，云间犬空吠。\n犹闻溪鸟衙，尚有里人爱。\n岩花无开落，世事几兴废。\n我乘幽兴来，静邀秋月对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其九 石砚","author":"俞充","text":"尝读表圣诗，云是秦王成。\n悯时著密史，对此潜经营。\n新雨净如洗，乱苔生复平。\n应误山中客，浪近翰墨名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王官谷十咏 其十 机硙","author":"俞充","text":"谁凿浑沌死，智者争出力。\n悠悠蚁在磨，双轮转何极。\n机心连机械，随流还不息。\n莫笑抱瓮翁，终日亦饱食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其一 濯缨亭","author":"俞充","text":"皎皎居士缨，岂有尘可濯。\n爱兹沧浪清，偶以斯名记。\n转谷群鸽归，衢岸游鱼跃。\n檐头碧梧枝，秋来垂影薄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其二 览照亭","author":"俞充","text":"杖藜高山头，历览众景会。\n泰摹屹若屏，黄河泻如带。\n幽怀逐冥鸿，万事寄天籁。\n不见玉京春，荒烟起萧艾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其三 三诏堂","author":"俞充","text":"猛虎正横行，孤猿发长啸。\n名高世人间，三枉鹤书诏。\n借笏趋朝参，天意独难料。\n咫尺首阳山，清光静相照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其四 瑩心亭","author":"俞充","text":"妖氛满世间，瑩心兹得地。\n瀑布岩前飞，势猛鸥乌避。\n洗涤无纤尘，澄虚全浩气。\n清风林表来，千载有馀意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其五 九籥室","author":"俞充","text":"仙术秘丹经，昔人藏九籥。\n幽栖白云根，保此一炉药。\n吟残深雨来，梦断岩花落。\n万虑正坐忘，未能看舞鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其六 修史亭","author":"俞充","text":"吁哉土德衰，群奸恣蟊贼。\n欲加萧斧诛，修史乃其职。\n谁知深山中，法若春秋直。\n俄惊济阴变，绝笔幽岩侧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其七 拟纶亭","author":"俞充","text":"大厦不可扶，诰命已云绝。\n老臣坐深林，有泪化为血。\n拟成丝纶言，救世心独切。\n溪流今尚清，夜夜澄孤月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其八 挂鹤台","author":"俞充","text":"污俗正朋亡，归来卧空谷。\n养鹤不成双，相从守幽独。\n素羽信非群，孤唳杳无续。\n高台委荒榛，追想人如玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其九 一鸣窗","author":"俞充","text":"天寒松柏青，厩闲骥骥老。\n潇洒竹窗前，超然鸣以道。\n惟有岩上月，时来伴幽讨。\n兹意不可忘，还将拾残稿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻溪怀古十篇 其十 东渠亭","author":"俞充","text":"二渠日夜流，利厚争所起。\n先生坐东亭，立法书在纸。\n老农到今守，后来谁敢毁。\n斯人不可见，空听竹间水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送灵岩法师","author":"俞充","text":"战士长戈赴荔原，谋臣献策庙堂间。\n吾师倜傥浮屠隐，不事王侯事经论。\n两街推许住灵岩，百鸟衔花待师□。\n清风一振海潮音，旷劫曾蒙祖师印。\n穷秋别我欲何言，珍重详师指一弹。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岊仲次韵其兄穆父见寄","author":"刘季孙","text":"会稽山上月如轮，鸿雁相将江水春。\n幕府英豪虽可数，樽前谁是急难人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有美堂燕集","author":"刘季孙","text":"云间猎猎立旌旗，公在胥山把酒时。\n笑语几番留湛辈，风流千载与吴儿。\n湖山日落丹青焕，楼阁风收雨露滋。\n谁使管萧江上住，胸中事业九门知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登介亭","author":"刘季孙","text":"使君中和堂，六月无炎溽。\n随呼众宾集，一笑清风足。\n复为曲水饮，石面涌寒渌。\n持杯襟袂凉，酒出金鲸腹。\n旌旗登凤皇，羽翼在林麓。\n半空老崖断，千载灵药伏。\n松杉各雄枝，螭蜃傍奔逐。\n古韵岂尘世，遐瞻有天目。\n霸国荒故坛，墠社移新屋。\n霞标起山近，潮势卷江速。\n物外得长凉，樽前寻往躅。\n有客告将行，迟留待珠玉。\n欣然点鼠须，万象归一幅。\n终篇灿灿动，满座琅琅读。\n此时天乐奏，到夜山鬼哭。\n和之惭岂敢，来者信难续。\n粉壁鉴相射，香媒尘不触。\n醉归扫双堵，字字照岩谷。\n星辰众所仰，富贵公岂欲。\n一言换凡骨，芝朮谁能服。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱蒙仲赴举 其一","author":"刘季孙","text":"膝下五车就业，殿前三月亨途。\n日出唤君名姓，春风吹过江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱蒙仲赴举 其二","author":"刘季孙","text":"文价从今第一，家风经古无伦。\n不假湘灵十字，知君才倍前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱蒙仲赴举 其三","author":"刘季孙","text":"俊气将探虎穴，清才早践龙门。\n故比隔江白鹭，万人回首王孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西园和韵绝句","author":"刘季孙","text":"雨过西园物物佳，柳风竹日映葵花。\n更无人迹宜清睡，奈此池头一部蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其一","author":"刘季孙","text":"谁怀二子千里，公赋五篇六言。\n月底飞云西去，山头归雁双骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其二","author":"刘季孙","text":"小艇辞公晚发，高斋记客初来。\n耿耿不忘归路，阻修万折千回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其三","author":"刘季孙","text":"府下莫非群隽，坐中不见三明。\n远意关河马首，静吟笔砚泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其四","author":"刘季孙","text":"虽列蜀都有日，却逢谢傅何年。\n历历林溪胜处，想君把酒依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其五","author":"刘季孙","text":"乐事莫如饮酒，休官自是高人。\n红带鳌头寄与，是翁矍铄寻春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广武山怀古","author":"刘季孙","text":"楚汉兵相接，乾坤昼亦暝。\n虎争千里震，龙战四郊腥。\n故垒从谁问，严祠自昔灵。\n北风吹败木，落叶任飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄苏内翰","author":"刘季孙","text":"倦压鳌头请左符，笑寻颖尾为西湖。\n二三贤守去非远，六一清风今不孤。\n四海共知霜鬓满，重阳曾插菊花无。\n聚星堂上谁先到，欲傍金樽倒玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"守关","author":"刘季孙","text":"晨鸡三叫末开关，留滞行人更解鞍。\n却上月明高处立，晓风吹面作清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云台山","author":"刘季孙","text":"阆州富名山，冠者云台化。\n幽深压岷峨，孤峭抵嵩华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送达师游天台次参寥韵","author":"刘季孙","text":"正诵兴公赋，报师来别予。\n兴长寻瀑布，语罢振行裾。\n胜事云霞异，清吟岩谷虚。\n石桥镌岁月，知不假人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵马中玉提刑见寄","author":"刘季孙","text":"知公不奈二毛何，寻访天台所得多。\n宿处仙人千载宅，悟时禅友一声歌。\n道心夷旷忘名势，句法清新为琢磨。\n每到西湖怀使节，春风红紫照清波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]