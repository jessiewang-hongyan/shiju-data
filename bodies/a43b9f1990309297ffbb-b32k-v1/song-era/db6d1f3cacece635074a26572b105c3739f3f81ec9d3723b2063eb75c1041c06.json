[{"title":"樟镇夜泊","author":"艾可叔","text":"醉却长年懒著篙，聊依山市泊江皋。\n船收蒲席风初定，人卧芦花月正高。\n时有沙禽惊客梦，厌听枥马龁空槽。\n晓来细雨秋烟湿，意思三分是楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"整裘袍","author":"艾可叔","text":"袍剪新蓝衬淡黄，官宣粲粲照巾箱。\n倩人细熨波涛皱，为我重缝云雾香。\n入手虽轻荣赐重，此身差短感恩长。\n微忱称报惭无路，空把山龙补舜裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日止诸少登高","author":"艾可翁","text":"尘埃漠漠一千里，风雨潇潇十四陵。\n立得身高愁转甚，龙山从此不须登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子规","author":"艾可翁","text":"举目山河恼客怀，百年前事总尘埃。\n如何爱劝人归去，倒引南人入汴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"传闻","author":"艾可翁","text":"力战奚忧曳落河，可怜重阃亦投戈。\n后来未可轻东晋，虽是清谈死节多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山寺前泛舟西下","author":"艾可翁","text":"机舂坎坎水潺潺，曲折舟行乱石间。\n无数水禽飞不起，杜鹃花满夕阳山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其二","author":"艾可翁","text":"云台历历纪功臣，底事中间有子陵。\n未必故人同卧处，了无一语及中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其一","author":"艾可翁","text":"归去江头伸脚眠，不烦太史验星躔。\n一丝千古经纶在，不为东都二百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜","author":"艾可翁","text":"雨浥梨花粉泪香，一痕淡月照修廊。\n春来只是寻常夜，惟有杜鹃添觉长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居杂兴 其二","author":"艾可翁","text":"青山意自足，扰扰复何之。\n见客从衣破，哦诗任饭迟。\n蔬畦耕犊草，匏架落蝉枝。\n逆境偷贫乐，休兵未可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居杂兴 其一","author":"艾可翁","text":"老夫晨沐罢，还卧看云行。\n发短便巾小，衰容怯镜明。\n空林存竹意，破屋带泉声。\n自喜诗棋外，无营梦亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居杂兴 其三","author":"艾可翁","text":"村落兵戈后，江湖几杖前。\n索居兼屏燕，幽梦反宜蝉。\n茅舍分炊火，苔砖出酿泉。\n家贫思辟谷，非是博长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书罗公碑阴","author":"艾可翁","text":"人家落落堕荒丘，碑带苔痕独字留。\n博陆脊梁扶日月，中郎名笔法春秋。\n一抔谁下寻坟马，片石今供砺角牛。\n惟有斜阳闲照管，肯随鸦影上螭头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元宵","author":"艾可翁","text":"偶然散策无寻访，何限伤心强笑歌。\n世味正如春酒淡，市灯不及月华多。\n人生只合且如此，国势遂成无奈何。\n年少尚装胡旋舞，不知舞破几山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉阳城","author":"艾可翁","text":"汉阳城上望，天色欲苍黄。\n云去仍清野，人稀半战场。\n江分青草断，山接白云长。\n一掬中原泪，凄凉对夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐君载见寄","author":"艾可翁","text":"不必相逢啸语春，本然心迹自相亲。\n青山我已卧三载，白社君今与一人。\n乱后事非京国旧，雨馀秋共客愁新。\n躬耕谷口云应满，何处堪寻郑子真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵臞山顺处斋","author":"艾可翁","text":"丧乱踰三载，孤高配九秋。\n日方行北陆，江不改东流。\n诗入中年老，官逢世变休。\n仲将头雪白，摇落更多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"艾可翁","text":"水月长依梦，江天半入诗。\n断崖云欲落，危岸树多攲。\n天晓雁先起，舟行客未知。\n雪霜篷隔断，何得上吟髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兵火后野望 其一","author":"艾可翁","text":"干戈连万国，丘壑卧三年。\n虎啸黄茅地，鸦屯白骨田。\n渴虹疑竭海，腥雾欲沈天。\n摇落前朝老，长怀鲁仲连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兵火后野望 其二","author":"艾可翁","text":"江村兵火后，月色似长淮。\n鼓角连秋思，风尘带客怀。\n诸公朝漠北，一老哭天涯。\n犹幸舂陵夜，葱葱气尚佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家兄有和再用韵 其二","author":"艾可翁","text":"故人在何处，清梦或逢之。\n老树秋声早，深窗曙色迟。\n湿萤粘露草，惊鸟徙风枝。\n琴破才支卧，知无钟子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家兄有和再用韵 其三","author":"艾可翁","text":"乱离生世晚，衰白在人前。\n云水飞饥鹤，山林付乱蝉。\n日今行黑道，人有隔黄泉。\n晷渐秋来短，愁长亦敌年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家兄有和再用韵 其一","author":"艾可翁","text":"隔林看日落，出户对天行。\n久乱人情变，长贫心事明。\n虹拖城郭势，河泻甲兵声。\n谁似秋来水，能于浊世清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淡圃兄生辰有诗次韵 其一","author":"艾可翁","text":"来寿吾兄玉局仙，郎君亦自醉颓然。\n乱离难得团圞日，清健何须少壮年。\n投老宦情云在壑，忧时心事日行天。\n遐龄此去应如鹤，蕙帐月寒相对眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淡圃兄生辰有诗次韵 其二","author":"艾可翁","text":"时危安乐是神仙，默有扶持岂偶然。\n林下且须坚晚节，尊前未用说明年。\n穷通莫计惟期寿，兴废难言赖有天。\n恨杀飘蓬白头弟，十年风雨别州眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屡庸军马后相过","author":"艾可翁","text":"相疏怜各病，相见贺更生。\n久乱诗书废，长贫门户清。\n晨炊才脱粟，夜卧亦班荆。\n祇有悲秋卷，多于未受兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"番阳道中","author":"艾可翁","text":"督府春移檄，江城昼撤花。\n好书如隔世，久客似无家。\n畏路多言虎，荒村半是鸦。\n道逢西北客，挥泪问京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题渊明像 其一","author":"艾可翁","text":"漉酒不孤头上巾，醉来万事等浮尘。\n谁家三径无松竹，肯说昨非能几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君马黄","author":"艾可翁","text":"君马黄，我马骊。\n白玉为勒络青丝，与君并辔河水湄。\n河上扑扑杨花飞，杨花飞飞送客人。\n生别离，良可惜。\n愿君鞭影去迟迟，莫学杨花各南北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白土寺","author":"艾申","text":"正尔炎官火伞张，幅巾来此坐僧房。\n个中岂是全无暑，毕竟心清身自凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疏山","author":"艾申","text":"夹道苍松六月寒，尘埃只隔白云閒。\n重游恰是十年后，往事空惊一梦间。\n杰阁漫誇新卜筑，危亭不似旧跻攀。\n凭谁说与矮师叔，投老求分一半山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登抱螺峰呈同游","author":"艾性夫","text":"莫放龙山旧醉豪，西风辇路暗蓬蒿。\n目穷千里应惆怅，赖得螺峰不甚高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十四夜梦到何许植物多瑞香觉而赋此","author":"艾性夫","text":"春风吹我游仙梦，梦到庐山顶上来。\n不记花多与花少，恍然如步紫云回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大佛头","author":"艾性夫","text":"锦帆翠楫照吴川，系缆犹存石岿然。\n刻佛未灵山鬼过，西风吹动鲍鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山宇","author":"艾性夫","text":"一方湘竹卧春阴，数卷唐诗醒老心。\n俗客不来山宇静，新莺啼入杏花深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山矾代山谷改评","author":"艾性夫","text":"刻玉珑松万万葩，暖香薰透小窗纱。\n水仙未可呼为弟，此是春风第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书无闷寮 其一","author":"艾性夫","text":"硎谷冬瓜幸未生，尚堪松下抱遗经。\n春秋断烂无人读，一点寒灯老眼青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书无闷寮 其二","author":"艾性夫","text":"风雪萧萧席作门，奴星急把柳车焚。\n脐中红炷两三日，坞里黄金十万斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书无闷寮 其四","author":"艾性夫","text":"对客清谈妙入神，舌乾时与供先春。\n东州米价北门雁，一语不须来溷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书无闷寮 其三","author":"艾性夫","text":"喧啾百鬼瞰高明，寂历朱门野草生。\n斗大山中茅屋好，日长攲枕听松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书琵琶行后","author":"艾性夫","text":"儿女情怀易得怜，悲伤容或涕涟涟。\n独疑迁客方沦落，犹著朝衣夜入船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从和山聪上人觅竹","author":"艾性夫","text":"龙光长老有大竹，肯为东坡斫两竿。\n可是孟郊家具少，请师分我碧琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元旦","author":"艾性夫","text":"不管髼松雪满颠，笔床茶灶度年年。\n穷愁博得长清健，多折梅花供老天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六和塔浙江亭庙山皆宰执待罪之所并作一绝","author":"艾性夫","text":"国门西出小徘徊，中使传宣遽勒回。\n南渡山河天一角，不知待罪合谁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月岩","author":"艾性夫","text":"不容天上妖蟆食，却许山中狡兔眠。\n两日见岩成二绝，丫头不老月长圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木芙蓉","author":"艾性夫","text":"露冷红酥不带愁，湘兰楚菊共清修。\n灵均死去无人问，閒却沧江一片秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"世言梅见外于离骚海棠不取于子美未有为解嘲者因作二绝 其一","author":"艾性夫","text":"不受春风半点尘，骨寒花冷雪为群。\n桂椒不敢攀同传，正是骚人独敬君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"世言梅见外于离骚海棠不取于子美未有为解嘲者因作二绝 其二","author":"艾性夫","text":"态浓意远骨肌匀，睡起精神萃太真。\n不用分明更题品，诗翁已自为传神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古驿","author":"艾性夫","text":"旧时邻曲各东西，野蔓荒藤压树低。\n过尽路牌无客影，一冈秋雨鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意 其二","author":"艾性夫","text":"采莲莫采花，采花损空房。\n留房结青子，种作明年香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"术有号莘野钓滨者求诗各与一绝 其一","author":"艾性夫","text":"撷青日日饭疲牛，识字耕夫已白头。\n束帛不来山鬼笑，有人马上觅封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"术有号莘野钓滨者求诗各与一绝 其二","author":"艾性夫","text":"意钓秋江不为鱼，六韬尚拟载徵车。\n东南腥血方涂地，何用人间有此书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石溪二梅佳甚玩索晚归","author":"艾性夫","text":"山根短日堕寒影，溪上乱风吹结衣。\n自怜野性老尚癖，逢著梅花便不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守分","author":"艾性夫","text":"穿窬暴富竟饿死，博塞得官终族诛。\n不惊宠辱老瓦砚，粗了暑寒粗布襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"年踰古希须发并白惟眉玄如初","author":"艾性夫","text":"种种闲愁先上眉，愁应白早不应迟。\n定知白了愁谁管，直到无愁是白时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老圃送瓜因为邵平具案 其一","author":"艾性夫","text":"筠篮满贮绿离离，白发村翁手自提。\n能学园人怜杜老，也分蒲鸽到花溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老圃送瓜因为邵平具案 其二","author":"艾性夫","text":"食叨千户窃侯封，不仕为高仕死忠。\n临难归来图苟活，种瓜何及种桃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观棋","author":"艾性夫","text":"搀先岐路不容差，形定心忙寂不哗。\n仙客莫嫌春昼短，东风落尽海棠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别离词 其一","author":"艾性夫","text":"郎从江上买行舟，妾对江枫生晚愁。\n雁云不断楚天碧，望郎怕上水边楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张宛丘寄衣曲 其一","author":"艾性夫","text":"衷甲葱河不记春，何须更比小郎身。\n只消狭剪征衫去，塞雪边风最瘦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张宛丘寄衣曲 其二","author":"艾性夫","text":"要识关雎乐不淫，勿疑汉上有题衿。\n思无邪是观诗法，一笑先生欠古心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨柳骚","author":"艾性夫","text":"缕缕柔条不奈春，为谁憔悴把眉颦。\n年来江上多离别，不信垂杨管得人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"补破为杜诗下转语赠老妇","author":"艾性夫","text":"一寒谁复解绨袍，百结重缝叹汝劳。\n莫遣海图归短褐，此身正自困风涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和靖祠与故宅皆无梅","author":"艾性夫","text":"得见梅花即见逋，我来竟日觅梅无。\n却于无处分明见，月满孤山水满湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定气","author":"艾性夫","text":"朝三亦可不必怒，角左几何乌用争。\n不多不少饭一龠，无败无成棋半枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳武穆葬西湖故宅为学宫 其二","author":"艾性夫","text":"故园今日馆英游，大耻俱忘总可羞。\n料得精魂长扼腕，无人讲学到春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳武穆葬西湖故宅为学宫 其一","author":"艾性夫","text":"老秦举□媚□金，枉死如公恨最深。\n地下红旗应北指，西湖埋骨不埋心。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武阳渡","author":"艾性夫","text":"空濛水气湿溪烟，闪烁沙星照客船。\n一片西风吹酒醒，秋容多在雁云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经语诗戏效唐子西 其二","author":"艾性夫","text":"源泉混混出虚岩，桑者閒閒人已蚕。\n剪韭不妨千取百，种瓜且喜二生三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经语诗戏效唐子西 其一","author":"艾性夫","text":"山径之蹊去去赊，筚门圭窦是谁家。\n其生色也草交翠，彼美人兮莲正花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其二","author":"艾性夫","text":"自有诸公作帝师，故人相与竟何辞。\n可能密密同床话，不及周南第一诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其一","author":"艾性夫","text":"不随龙去只鱼汀，绝喜先生世累轻。\n却把客星侵帝座，岂因忘世未忘名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣和御笔二扇面 其一","author":"艾性夫","text":"纨扇轻盈宝月轮，莺花点染玉园春。\n凭谁为障西风起，万里黄尘竟污人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣和御笔二扇面 其二","author":"艾性夫","text":"黄芦白雁小汀洲，奎藻香罗一片秋。\n胜似纥干山下雀，冻飞不去使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚","author":"艾性夫","text":"花风摆脱老红去，谷雨将迎稚绿来。\n我类文园病消渴，晓窗和露咀青梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]