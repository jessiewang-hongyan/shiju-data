[{"title":"次韵晁子与 其二","author":"王灼","text":"长贫我欲为巴叟，高咏君能继洛生。\n自许一丘成小隐，仰瞻千载立脩名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晁子与 其四","author":"王灼","text":"韩门今日有真传，兴起斯文四百年。\n可惜飞龙卧荒枥，闲看翠翮落虚弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晁子与 其一","author":"王灼","text":"清溪西岸作鹑居，敢怨投闲百不如。\n喜得君家好兄弟，相逢如对古人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晁子与 其三","author":"王灼","text":"大晁富丽比南金，令弟清新敌楚琳。\n死却庐陵老居士，二苏那得有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晁子与 其五","author":"王灼","text":"新诗字字救朝饥，仁义之言反类痴。\n谁办千金收骏骨，大胜列屋养蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到西湖 其二","author":"王灼","text":"古来三百六十寺，春入颓基草木荒。\n解作高人无尽供，只馀山色与湖光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到西湖 其一","author":"王灼","text":"西湖声价甲天下，梦想平生初识之。\n十里垂鞭几多恨，不及见渠全盛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和荣安中二绝 其一","author":"王灼","text":"射洪春酒旧知名，更得新诗意已倾。\n独与刘伶敦契好，山王不敢岂人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和荣安中二绝 其二","author":"王灼","text":"醉来不入少年场，只欲问涂何有乡。\n耽酒玉川贫彻骨，空将鼻观到糟床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵泉次性老韵","author":"王灼","text":"盏里浊醪无宿酿，瓶中脱粟有孤炊。\n忍贫不彻来投佛，坐听松风无限时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答戴时行 其一","author":"王灼","text":"如今四十已知非，誓学宗门第一机。\n养就纯乾犹细事，直须空劫问音威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答戴时行 其二","author":"王灼","text":"佛祖由来命脉通，大千世界一光中。\n药王菩萨知君是，乞取刀圭救病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题十二溪女图","author":"王灼","text":"霞佩缀仙班，春风拥髻鬟。\n应无世间梦，怅望碧溪湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题云月图 其一","author":"王灼","text":"万里峨眉夜夜月，千秋巫峡朝朝云。\n诗句丹青共摹写，笔端三昧要平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王逸竹溪钓艇图二绝 其一","author":"王灼","text":"断岸竹如云，翠色落寒濑。\n艇子何处归，应转烟林外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题政黄牛出山图 其一","author":"王灼","text":"眼明双白鹭，身稳一黄牛。\n玉辔章台陌，可怜供百忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题满公所作月林散清影","author":"王灼","text":"暝色兼荒远，初分浦淑烟。\n应知汉江佩，月竹斗娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和 其一","author":"王灼","text":"性癖耽杯酒，家贫废臼科。\n江山聊作助，崔蔡不须多。\n早岁撑吴榜，春风试越罗。\n只今中夜梦，突怒见潮波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和 其二","author":"王灼","text":"风来云度屋，雨过水盈科。\n懒觉诗篇少，闲看景趣多。\n垣间生薜荔，床下长娑罗。\n空法销诸漏，端如迦叶波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和谢娱亲堂扁 其三","author":"王灼","text":"荣华梦事付朱门，茗碗炉熏所性存。\n对月朗吟将进酒，逢春细和乐游园。\n坐中投辖时留客，膝上含饴日弄孙。\n四美难并公奄有，何曾一夕不开樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和谢娱亲堂扁 其二","author":"王灼","text":"烂然铁画间钩银，越薄苏膏挥洒频。\n谁与钟王传妙诀，我知颜柳是前身。\n大书燕喜娱亲扁，俯念乌慈反哺仁。\n因甚衡茅光彻夜，烛围十丈许分邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长孺幼安作西湖之游不以告某与元受明日二公有诗元受率次韵","author":"王灼","text":"满城扑面战黄尘，蜡屐故寻湖上春。\n千顷烟波初弄日，四年鱼鸟恰知人。\n有时览胜缘搜句，无术驱愁但饮醇。\n可笑山王今不数，敝裘索寞走天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代公庆上郭帅 其二","author":"王灼","text":"昔年先庙谒汾阳，提笔从公写短墙。\n再别巴江油戟下，七逢天竺桂枝香。\n宦途自许安仁拙，浮俗谁怜处士狂。\n客舍无烟饥欲死，尚惭知己问行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代公庆上郭帅 其一","author":"王灼","text":"唐家尚父几重孙，宿将齐推第一门。\n新拥锋车还北阙，暂辞戎律控西藩。\n柳营平日鏖轻敌，龙衮今年识至尊。\n好在枢庭展韬略，试看馀力整乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其一","author":"王灼","text":"幼妇传来旧受辛，知君满腹贮阳春。\n寿星台宿应同邑，草圣诗仙合一人。\n紫橐禁中留赋咏，白莲社里鍊丰神。\n谁言林下长闲得，左席犹虚待秉钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其二","author":"王灼","text":"湘东三管竹金银，名胜均蒙品藻频。\n里巷自怜为下士，门墙亦许托微身。\n吹嘘短翮扶摇力，沾溉寒根造化仁。\n堂扁特书烦大手，少偿孟母教迁邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其三","author":"王灼","text":"早厌奔趋权贵门，中流勇退古风存。\n唱酬绿野今裴白，偃仰商山旧绮园。\n成熟坐看桃结子，平安几报竹生孙。\n雨馀晴玉春无价，天遣清香入酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次尹俊卿见访有诗次韵","author":"王灼","text":"联骖来二妙，契好属儿孙。\n夜半星河转，谈深几席温。\n能诗饭颗瘦，使酒濮阳髡。\n万事醉吟里，那须倚市门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次尹彦回复来偶予他出用前韵招彦回","author":"王灼","text":"往时倾盖友，前代涌泉孙。\n肯念三年别，能来一语温。\n岁华欺老大，功业付鲸髡。\n直为诗篇好，扶藜日候门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子应同游灵泉","author":"王灼","text":"香火寻幽寺，麾幢度广川。\n坞深斜透日，溪涸细流泉。\n玉粒新炊饭，金花侧布田。\n归涂动诗兴，健笔写江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子应游鹤鸣","author":"王灼","text":"夕雨方开霁，晨鸡亦罢鸣。\n四郊知按堵，千骑得徐行。\n再阅天章丽，还同佛日明。\n抽毫出佳句，压倒谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵冯舜陟见赠","author":"王灼","text":"梁山回首几悲辛，来对江城拂塞尘。\n枕曲漱醪真下策，推书扑笔更痴人。\n如君自是声华旧，及我相逢笑语新。\n便倒诗筒费褒饰，坐知摇落变青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕阆州锦屏之集","author":"王灼","text":"飞檐依绝巘，朱槛俯清流。\n剑外谁堪似，城南独占优。\n浓春牵酒兴，胜践与诗谋。\n日落江烟起，旌麾更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵米太初","author":"王灼","text":"元知文采冠多邦，床下如今拜老庞。\n短刃何能排贾垒，轻舠敢问绝潘江。\n初闻毛颖只供笑，退诵溪堂但乞降。\n谁拟一台称二妙，如公才气本无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵许唐臣丈","author":"王灼","text":"目断扬州泪似江，龙舆半夜狩南邦。\n徒闻四野方多垒，可惜黄旗漫绕杠。\n浊酒有神磨岁月，愁山无赖入轩窗。\n青萍三尺将生锈，愤气峥嵘只自降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵何子应游金壁池 其一","author":"王灼","text":"柳树浓垂岸，荷花满覆塘。\n日供无限影，风递自然香。\n酒艳浮瑶席，歌声绕杏梁。\n空惭长卿病，不作次公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李士举丈除夕 其三","author":"王灼","text":"暗灯延鼠辈，残漏付鸡人。\n柏酒浮三酌，蔬盘荐五辛。\n冻吟多累句，孤坐绝来宾。\n镜里丝丝发，平明六十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李士举丈除夕 其二","author":"王灼","text":"儿孙思故国，诗酒送穷年。\n禄近禾三百，人惭员半千。\n壮心非曩昔，尊足幸轻便。\n投晓椒觞尽，春风共醉颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李士举丈除夕 其一","author":"王灼","text":"藜杖初防老，桃符又换新。\n惊回潼水梦，喜见义城春。\n浪走何为者，流光岂贷人。\n翻思大傩氏，阔步过天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李知几","author":"王灼","text":"密雨连三日，青天未肯开。\n庭除舞蚯蚓，几席上莓苔。\n又说边声急，浑无乡信来。\n愁心似流水，空费宝刀裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵当可","author":"王灼","text":"元礼门墙岂敢疏，拟题刺字拂尘裾。\n颓颜此去歌无奈，闻道从来恨不如。\n食蛤未妨期汗漫，椎芦或可作蘧蒢。\n西园飞盖成何事，要见枕中鸿宝书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵诸公赠将官鹿浩然","author":"王灼","text":"休把长缨便请行，如今正属泰阶平。\n醉看夜月清樽倒，卧对秋风白发生。\n羞向热官称命薄，喜随寒士以诗鸣。\n他年采药鹿门去，不许人间知姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵顾次凤","author":"王灼","text":"笔端文字照千春，仙籍班联透几尘。\n黄卷肯交同长物，白袍未信裹闲身。\n至言落落常难合，俗眼悠悠少识真。\n谁似江东顾夫子，月台对影只三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答张乃直","author":"王灼","text":"才如北海岂云疏，局促从来笑腐儒。\n只作文章希屈马，不将门户敌崔卢。\n公车奏议三千牍，京洛风尘十二衢。\n回首知君几多恨，肯甘华发老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈陈崇青求娱亲堂三大字 其一","author":"王灼","text":"椒柏浮觥盘列辛，今年春晚去年春。\n五侯门下正多事，九老图中只一人。\n健笔横飞鸾体态，童颜长鍊鹤精神。\n会看天上丝纶下，卫武还朝秉国钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈陈崇青求娱亲堂三大字 其二","author":"王灼","text":"宵人有母鬓如银，夜半丸熊诲子频。\n幸窃斗升为侍养，敢言科第止荣身。\n小堂欲作娱亲扁，纯孝谁推锡类仁。\n乞取先生三大字，要崇风教厉乡邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈陈崇青求娱亲堂三大字 其三","author":"王灼","text":"自挂衣冠神武门，依然恋阙赤心存。\n清高寄兴太湖石，盘礴行吟独乐园。\n胜日过从无杂客，清宵侍坐有来孙。\n风神筋力新逾健，山色长青对寿樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投秦太师 其三","author":"王灼","text":"相府潭潭接斗魁，门披戟带绝纤埃。\n小山丛桂何由识，东阁长裾许暂陪。\n绕木惊乌栖未定，恋轩疲马望重来。\n酬恩有胆大如斗，造化炉中肯铸回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投秦太师 其四","author":"王灼","text":"三径荒芜钓艇闲，中兴冠盖拟跻攀。\n有文数过金闺彦，无籍堪联玉笋班。\n断遣乡愁归鲁酒，安排客服上吴山。\n相门宾帟多珠履，自笑风埃蹭蹬间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投秦太师 其二","author":"王灼","text":"今代堂堂有魏公，十方三际指挥中。\n勋名已恨古人隘，歌咏端知寸笔穷。\n还第文饶槐蔽日，赌棋安石马嘶风。\n此时谁作登门客，看吐经纶气似虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投秦太师 其一","author":"王灼","text":"双龙阙下五云新，喜见天元第一春。\n邻使来输朝会玉，儒宫望拜属车尘。\n囊空赤白闲边将，雨足公私快野人。\n浑是升平好时节，谁将盛事勒苍珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净明长老睡庵","author":"王灼","text":"阿师睡三昧，有如饱叶蚕。\n以睡作佛事，复名所住庵。\n梦觉本何择，月行影在潭。\n勿笑胁尊者，二子正同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和唐山叟所赠三诗 其三","author":"王灼","text":"遍从江海濯清流，归老岷峨占上游。\n心远欲联高士传，地偏仍似贾胡留。\n何时竹杖闲支壁，终日绳床懒命俦。\n碧嶂红尘两相望，劳生笑我不知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和唐山叟所赠三诗 其二","author":"王灼","text":"蓑衣芒屦日相逢，仙者谁人识吕钟。\n已受丹书存夜气，定除白发变春容。\n情田旧习虽锄秽，笔阵馀威尚折冲。\n闻说山间赋招隐，试披云雾几多重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和唐山叟所赠三诗 其一","author":"王灼","text":"人品相悬定几分，十年高卧赤城云。\n神仙窟宅古多见，泉石膏肓今亦云。\n羽驾拟陪天上乐，麟毫犹写世间文。\n吴江枫落摇归棹，更喜新诗惬所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拾诸公馀韵赠辉禅师兼奉答勾龙伯秋谒广利辉禅师 其一","author":"王灼","text":"引泉浇药圃，编竹护花科。\n顿喜高风在，仍闻密义多。\n四山围翠黛，一水缭青罗。\n谁谓幽师死，来看窣堵波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拾诸公馀韵赠辉禅师兼奉答勾龙伯秋谒广利辉禅师 其二","author":"王灼","text":"旧饰莲花座，新翻贝叶科。\n朝餐荤味少，夜诵篆烟多。\n不执铁如意，肯偷金叵罗。\n犹堪试绵力，法海激颓波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵成甫招饭次默夫韵","author":"王灼","text":"鸟声呼客急，花影过帘迟。\n酒滟东西玉，枰残白黑棋。\n稍惊风弄袖，真恐雨催诗。\n一笑留归骑，斜阳无限时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵和之自鹤鸣泛舟归城次韵","author":"王灼","text":"斜日撩归兴，飘然李郭舟。\n旄麾明两岸，管吹落沧洲。\n要与民行乐，那须酒换愁。\n遥知陶靖节，临赋喜清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答伯秋 其一","author":"王灼","text":"足为春游茧，头因午醉科。\n神交尝恨少，诗债敢嫌多。\n几日登庐阜，他年梦苧罗。\n故应三峡外，渔艇老烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答伯秋 其二","author":"王灼","text":"刍荛传吉语，诏旨缓追科。\n疲俗今当复，诸公众所多。\n谁能齐卓茂，我亦怖阎罗。\n种德无馀事，流光付逝波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答伯秋 其三","author":"王灼","text":"半生沉俗学，中路堕严科。\n白眼遭非类，黄泉愧阿多。\n无勋封柱国，有志捽何罗。\n慎勿相料理，因风又起波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中走笔次赵彦和韵","author":"王灼","text":"三年相尔汝，一语敢谁何。\n有学窥黄老，无心战外魔。\n牛心应易啖，螭首故难磨。\n不识王孙贵，朱门亦许过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵大受登正法塔见刘王二陵","author":"王灼","text":"试纵浮图目，闲纾客子情。\n轩腾超世界，指点识乡程。\n天大云攲野，江蒸气抱城。\n长风饶振薄，落日倒光晶。\n古色千年在，悲歌百虑盈。\n战争初自苦，成败几堪惊。\n狐兔穿蓬颗，珠玑入里氓。\n剑关犹北向，巫峡只东倾。\n往意增三叹，馀踪付一瞠。\n誓言逃俗网，碧海跨飞鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何熙载之官邻山因简虞并父","author":"王灼","text":"力学收名第，指作青云梯。\n向来杏园伴，盛者直金闺。\n天工亦善戏，淹速乃不齐。\n三年得一尉，初挈孥与妻。\n邑居大山底，积翠蟠东西。\n瘦马当缓驱，石磴裂马蹄。\n寄谢循良守，桃李想成蹊。\n行春有馀暇，书尺到耕犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日同韶美谊夫登妙明分韵得光字","author":"王灼","text":"野迥半留日，云薄初护霜。\n一倾萸菊酒，三肃翰墨场。\n诸君党友贤，独我鬓毛苍。\n满引虽云乐，分携亦自伤。\n平生子刘子，趣归谒建章。\n勋业定指取，富贵肯相忘。\n古人重佳节，酬酢无馀觞。\n龙山丹叶飞，骑台白草荒。\n但使修名立，岂识离绪长。\n明年未可料，共饮西湖光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和 其三","author":"王灼","text":"可惜通三语，相期中六科。\n南司章奏好，北阙缙绅多。\n想见趋宣室，真成上郁罗。\n行装宜速具，未用叹奔波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三和谢娱亲堂扁 其一","author":"王灼","text":"盛年曾效引裾辛，勇退归休四十春。\n闲却圣朝医国手，来为诗社作家人。\n尖新句子堪呈佛，峭拔毫端似有神。\n仆辈岂应陪唱和，却缘鼷鼠发千钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]