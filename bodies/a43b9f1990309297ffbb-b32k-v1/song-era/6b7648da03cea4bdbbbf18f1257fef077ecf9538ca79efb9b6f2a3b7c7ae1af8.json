[{"title":"即事三首 其一","author":"唐庚","text":"归心急似陇头水，华发多于岭上梅。\n正是尧朝犹落此，当时湘浦亦宜哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事三首 其二","author":"唐庚","text":"还家久近书难写，破屋阴晴榻屡移。\n吾道非耶来旷野，人生乐尔复何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事三首 其三","author":"唐庚","text":"案头行扫尘随起，窗眼才封雨又梢。\n更力穷空沽白饼，莫将疲苶斗黄茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"唐庚","text":"僧寺借经便大字，邻墙唤酒及新篘。\n三年于此得其理，一饱已还非所求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"唐庚","text":"酒经自得非多学，诗律伤严近寡恩。\n田里歌呼无籍在，朝廷议论有司存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送舍弟干事广州","author":"唐庚","text":"欲罢愧决策，拟行愁索居。\n人心旱魃后，旅色飓风馀。\n击柝秋江夜，开帆晓雾初。\n他乡仗神理，沥胆奠扶胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日谪居书事","author":"唐庚","text":"四十缁成素，清明绿胜红。\n形容千虑后，门馆一贫中。\n白日时时别，青芜处处同。\n此生唇舌里，啼鸟暮春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观四年春吾与友人任景初舍弟端孺自蜀来京师至长安时方寒食吾三人相与戎服游九龙池饮酒赋诗乐甚是岁吾迁岭表明年景初亦谪江左忽忽数岁皆未得去寒食无几念念悽然作诗寄任因命舍弟同赋","author":"唐庚","text":"居今行古任定祖，底事迁延亦未归。\n我坐力田伤地脉，君缘搜句漏天机。\n故都回首三寒食，新岁经心两湿衣。\n学道一生凡几化，不因到此始知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙未正月丁丒与舍弟棹小舟穷西溪至愁绝处度不可进乃归溪侧有两榕甚奇清阴可庇数十榻水东老人尝饮酒其下云","author":"唐庚","text":"杨梅溪上柳初黄，荆竹冈头日正长。\n独木小舟轻似纸，一尊促席稳于床。\n树从坡去无人识，水出山来带药香。\n应有居民解秦语，为言昭代好还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感示舍弟端孺外甥郭圣俞","author":"唐庚","text":"一出湟关五见梅，愚忠几欲伴黄埃。\n弟兄手足穷孤竹，母子肝肠泣老莱。\n好语忽从天上落，行人直向海边回。\n此生报国无他事，力穑供输莫待催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游广州悟性寺寺有赵王台盖尉佗时所筑有井甘甚号达摩井云","author":"唐庚","text":"崎岖走上方，浩荡取秋光。\n台上经樛女，江天入夜郎。\n华夷凭槛远，兴废引杯长。\n泉脉来何处，中含定慧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舜祠","author":"唐庚","text":"讴歌率土性之也，号泣旻天孝矣乎。\n何惜扁舟系韶石，忆曾万里叫苍梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊岭戏书","author":"唐庚","text":"上世有鞭能走石，今人无铎可驱山。\n一回凭膝一移足，老尽行人未老颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长沙竹笋闻于天下大者可十斤重食之甚甘而不冰脾昔渡湘欲作诗未暇也今复过之酬以此篇","author":"唐庚","text":"地入长沙莫叹卑，竹萌径尺旧相知。\n九重才复金门籍，万里先参玉版师。\n契阔累年真负口，裴徊弥月未妨脾。\n渭川风味那能对，中有离骚九辨辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其一","author":"唐庚","text":"屏迹舍人巷，灌园居士桥。\n花开不旋踵，草薙复齐腰。\n蛤哭明朝雨，鸡鸣闇夜朝。\n未能全独乐，邻里去招邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其二","author":"唐庚","text":"已绝经年笔，仍关尽日门。\n身谋嗟翠羽，人事叹榕根。\n蔬食风掀市，楼居水破村。\n岭南霜自薄，何得鬓边繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其三","author":"唐庚","text":"便归良不恶，未去亦随缘。\n户口知无瘴，讴歌觉有年。\n藤笺得句后，桂酒抱愁边。\n经术吾衰矣，犹堪学力田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其四","author":"唐庚","text":"不死良难学，全生或可几。\n茶随东客到，药附广船归。\n棋倦收成败，书慵卷是非。\n关心无杂虑，魂梦入精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其五","author":"唐庚","text":"兀坐且如此，出门安所之。\n手香柑熟后，发脱草枯时。\n精力看书觉，情怀举盏知。\n炎州无过雁，二子在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其六","author":"唐庚","text":"饱食为茶地，深耕觅酒材。\n翻泥逢暗笋，汲井得飞梅。\n湖尽船头转，山穷屐齿回。\n田间良自苦，清兴亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其七","author":"唐庚","text":"壮岁日千里，晚途天一方。\n花缦聊傲世，白袷亦随乡。\n团扇侵时令，方书遣昼长。\n此间吾所乐，便拟卜林塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其八","author":"唐庚","text":"白日消诸妄，青山对屡空。\n著书防恶客，学圃问邻翁。\n织贝流肌滑，仁频入颊红。\n丹砂落吾手，秋至任飘蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其九","author":"唐庚","text":"多事定何补，寡言聊自温。\n蟹黄嗔止酒，车白劝加餐。\n濯足楼船岸，高歌抱朴村。\n愧无魑可禦，只益负君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十","author":"唐庚","text":"闹窄良难入，閒宽足见容。\n竹根收白叠，木杪得黄封。\n问学兼儒释，交游半士农。\n行歌村落晚，落日满携筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十一","author":"唐庚","text":"为农沙子步，附保水西乡。\n隐几江天远，开门佛土香。\n时情荒径草，野色淡渔梁。\n欲纵高秋目，东偏短作墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十二","author":"唐庚","text":"旧物杯中酒，新衔海上翁。\n百非无一是，显过岂微功。\n引水江分碧，烹丹井为红。\n幽居亦多事，度日不全空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十三","author":"唐庚","text":"小市江分破，连?水捲翻。\n到今佛迹在，千古鹤峰尊。\n浮峤来何处，丰湖入数村。\n登临有何好，秋至数消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十四","author":"唐庚","text":"已分诗驱使，宁辞酒过差。\n南烹人钓蛤，北信客占鸦。\n年事侵肤理，忧端宿肺家。\n向来功业兴，到晚咏馀霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十五","author":"唐庚","text":"覆载宜然等，寒暄乃尔殊。\n雪曾前岁有，地过此邦无。\n煮海鲸鲵动，烹山虎豹呼。\n南来何所得，诗语带娵隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十六","author":"唐庚","text":"夜语不觉久，晨兴良独难。\n加之得卯酒，晚矣恰朝餐。\n笋蕨春生箸，鱼虾海入盘。\n南方禁太饱，茗盌直须宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十七","author":"唐庚","text":"海气东南上，野烟申酉间。\n草平连别洞，雨转入佗山。\n道路鱼盐去，樵苏竹木还。\n西江并北客，相对各苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十八","author":"唐庚","text":"水过鱼村湿，沙宽牧地平。\n片云明外暗，斜日雨边晴。\n山转秋光曲，川长暝色横。\n瘴乡人自乐，耕钓各浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其十九","author":"唐庚","text":"浪迹苍梧外，放怀黄木东。\n人情双鬓雪，天色屡头风。\n国计中宵切，家书隔岁通。\n为儒得愁思，一笑赖儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗二十首 其二十","author":"唐庚","text":"万里非吾土，三年失我常。\n只愁鸢跕跕，敢作鹤昂昂。\n白竹连闽越，黄云入夜郎。\n何时返栖息，谁为问桃娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒居二首 其一","author":"唐庚","text":"未许幽人晓梦长，朝朝亲炷佛前香。\n有诗为爱袁家渴，无病缘抄陆氏方。\n身杂蜑中谁是我，食除蜿外总随乡。\n白沙翠竹门前路，疑出西郊向草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒居二首 其二","author":"唐庚","text":"细细敲门细细应，老翁方曲昼眠肱。\n鱼陂旧种千头鲙，桑径新窠十亩缯。\n菜足尚堪分地主，米馀翻欲供邻僧。\n平生雅有乘桴兴，咫尺沧溟去未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻勾景山补盩厔丞仍闻学道有得以诗调之发万里一笑","author":"唐庚","text":"人言盩厔似江湖，莫对丞哉叹负余。\n别后耳根无正始，向来纸尾得黄初。\n可怜鬼谷纵横口，今读神溪缥白书。\n臣朔许长钱许少，何当天子念公车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"唐庚","text":"南来不觉两秋砧，览照惊呼雪满簪。\n平日不堪文馆冷，暮年更赋武溪深。\n敢缘三已有愠色，自笑一生能苦心。\n安得袁丝随里闬，斗鸡走狗任浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"唐庚","text":"八千岐路愁何补，四十光阴老亦宜。\n此去只堪犀首饮，向来都是虎头痴。\n逢时有道其如命，得意无言所恨迟。\n诗债即今浑倚阁，新篇惟有莫相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲午元日","author":"唐庚","text":"非贤幸脱龙蛇岁，上圣应怜虮虱臣。\n忆与政和同度岭，朝来已点四年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日五言二首 其一","author":"唐庚","text":"啼禽通梦寐，芳草过比邻。\n暖逼花期促，愁牵酒量伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日五言二首 其二","author":"唐庚","text":"去就惭云雁，浮沉羡海鸥。\n妄心花片落，豪气柳枝柔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日七言二首 其一","author":"唐庚","text":"更与何人共寂寥，竹君时引到溪桥。\n是家大似东郭子，能使人之意也消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日七言二首 其二","author":"唐庚","text":"尚有小桃凌奼女，岂无大杓饮衰翁。\n老来不复谈坚白，醉去犹能爱浅红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑太玉送子鱼","author":"唐庚","text":"便当权阁太常斋，药灶于傍手自煨。\n须信子鱼藏妙理，坐令母蟹愧几才。\n刀头定向何时得，剑脊频将好意来。\n老去少陵虽病肺，尚堪持此荐寒醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"儿曹送穷以诗留之","author":"唐庚","text":"世中贫富两浮云，已著居陶比在陈。\n就使真能去穷鬼，自量无以致钱神。\n柳车作别非吾意，竹马论交只汝亲。\n前此半痴今五十，欲将知命付何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑二锁试五羊久而不还问之广人云已失解从海道归潮矣闻之惘然唁以此诗","author":"唐庚","text":"望君挹取裒然首，为我迂回长者车。\n璧玉已闻归间道，足音那复念逃虚。\n卑微官职缘亲屈，眊氉情怀赖酒除。\n政使登名似韩子，十年曾不补遗馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"骤雨","author":"唐庚","text":"黑云惊小市，白雨沸秋江。\n声入家家树，凉传处处窗。\n乱流鸣决决，叠鼓闹庞庞。\n蘋末清风起，斜阳觑海邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江涨","author":"唐庚","text":"秋来雨似浇，雨罢水如潮。\n市改依高岸，津喧救断桥。\n云阴哭鸠妇，池溢走鱼苗。\n天意良难测，前时旱欲焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书寄郑二","author":"唐庚","text":"别后定何似，此中难具陈。\n倦憎秋气湿，老怯晓烟辛。\n沸议今方尔，归期觉愈伸。\n须烦三绝手，时复饷清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十五夜月","author":"唐庚","text":"应缘人望望，故作出迟迟。\n几岁一相见，浮云宁别时。\n吟拚鸡腷膞，玩觉兔迷离。\n此夕登楼兴，非关有所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜久睡觉不复能寐凄然有感","author":"唐庚","text":"无复更残暑，夜深清欲饥。\n叶飞魂梦数，露重语音知。\n月色到秋苦，更声临晓迟。\n平生憎墨翟，老去亦悲丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立冬后作","author":"唐庚","text":"啖蔗入佳境，冬来幽兴长。\n瘴乡得好语，昨夜有飞霜。\n篱下重阳在，醅中小至香。\n西邻蕉向熟，时致一梳黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端孺籴米龙川得粳糯数十斛以归作诗调之","author":"唐庚","text":"倒拔孤舟入瘴烟，归来百斛泻丰年。\n炊香未数神江白，酿滑偏宜佛迹泉。\n饱去定知频梦与，醉中何至便妨禅。\n凭君为比长安米，看直公车牍几千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东邻二首 其一","author":"唐庚","text":"即今乐事属墙东，岁晚何曾酒盏空。\n白蜜已输仍节近，红藤未动况年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东邻二首 其二","author":"唐庚","text":"肯听寒梅缓缓消，笛声夜夜到溪桥。\n怪生不似关山月，新向城中得徵招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谩成","author":"唐庚","text":"云暗便窗破，山寒赖屋低。\n往还天外少，早晏雨中迷。\n书册开仍阖，履声东复西。\n何尝有所赋，得句旋安题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻郑二对吏五羊","author":"唐庚","text":"旧友年来略散亡，新收郑子亦遑遑。\n岁云暮矣无双雁，我所思兮在五羊。\n狱吏事权先自贵，书生踪迹况能狂。\n风流人物今馀几，可忍群儿复谤伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东麓","author":"唐庚","text":"经旬不见小匡庐，忽尔相逢喜欲呼。\n自入秋来更韶润，却从瘦里带敷腴。\n人间信有伤心碧，坐上那无满眼沽。\n可是清晖解娱客，能令肠断到愚儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西溪","author":"唐庚","text":"西溪霜后更沉涵，溪上愁人雪半簪。\n市散争归桥纳纳，橹摇不进水潭潭。\n利倾小海鱼盐集，味入他村酒茗甘。\n百里源流千里势，惠州城下有江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野望","author":"唐庚","text":"赖有澄江在，专供倚杖清。\n水裁偏岸直，云截乱山平。\n鞞鼓知农隙，鸡豚觉岁成。\n却缘摇落后，木杪得孤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独游","author":"唐庚","text":"是日游于独，乃情知者谁。\n时光新旧岁，节物浅深枝。\n鸦攫春祠敏，鸢窥野烧痴。\n田园有妙理，吾悔得之迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故游茂先大夫元祐初为唐安守豪逸喜宾客能剧饮谈笑盖陈孟公之流今唐安弦索之盛甲于两蜀自游使君始后累迁至秦凤宪以卒既二十馀载而其子振旅游峤南相过于惠州作此诗赠之","author":"唐庚","text":"唐安千指录琵琶，故事犹闻蜀叟誇。\n樽酒何人陪北海，练裙今日见西华。\n子归未得频芳草，我老无成学种瓜。\n万里相逢俱白首，班荆长语夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悯雨","author":"唐庚","text":"老楚能令畏垒丰，此身翻累越人穷。\n至今无奈曾孙稼，几度虚占少女风。\n兹事会须星有好，他时曾厌雨其濛。\n山中赖有茱粮足，不向诸侯托寓公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张天觉见赠韵","author":"唐庚","text":"别公归去养天和，见说清朝士已多。\n裙舍登门何处曳，顶缘受记昔曾摩。\n几时傅说重调鼎，去岁成汤已解罗。\n会引鉴湖为故事，要从英主乞三峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳后一日从无尽泛舟游处士台故诗人秦龟从所居","author":"唐庚","text":"皂河经雨水微沙，船帖台根日未斜。\n三径就荒悲白土，一樽相属对黄花。\n已将远眺收平楚，更遣清言到永嘉。\n要见仙翁头似漆，请看醉后落乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江陵逢故人宋德粹自播守罢归南阳以诗见贻依韵和酬","author":"唐庚","text":"昔别方初节，相逢各素秋。\n君归卧龙国，我脱堕鸢州。\n霜鬓含多事，尘容带倦游。\n行藏端可见，岁晚莫登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走城西别处厚居正两宗兄会居正出独与处厚笑语终日颇有卜邻之兴因属买田江陵作此诗","author":"唐庚","text":"旧交零落半存亡，晚岁荆州得两唐。\n临别眼中无小谢，再来天外有他杨。\n预行后日诛茅地，要近先生避世墙。\n会与幽人数晨夕，何能结客少年场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]