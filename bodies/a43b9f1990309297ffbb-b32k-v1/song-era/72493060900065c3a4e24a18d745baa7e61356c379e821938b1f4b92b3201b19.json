[{"title":"次李元泰见赠韵","author":"黄公度","text":"未遣枯桐逐灶煤，君今收拾到微才。\n东山谢傅为时起，前度刘郎何处来。\n自喜馀年瞻日表，恐无奇策上云台。\n尊前不用悲流落，怀抱相逢且好开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵余子侯游石泉","author":"黄公度","text":"竹杖棕鞋意自便，藓墙莎径色相鲜。\n平畴涨麦云连海，绝壁蟠松盖倚天。\n竟日虎岩延眺瞩，何时蟹井费攀缘。\n归来幽独不成寝，山月侵廊钟韵圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄白发","author":"黄公度","text":"银鬓讵如许，金丹奈若何。\n休垂髀肉涕，莫击唾壶歌。\n世事奕棋局，人材在沚莪。\n未须相料理，大器晚成多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄伤时二首 其二","author":"黄公度","text":"目断吴天远，魂飞楚塞低。\n六龙巡漠北，万骑绕淮西。\n寒月笼烟燧，霜风递晓鼙。\n征夫蝴蝶梦，休傍故园栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄伤时二首 其一","author":"黄公度","text":"举目江河异，伤心汉阙低。\n未闻胡折北，谁复将征西。\n志苦甘尝胆，身先愿执鼙。\n时惟王事急，六月尚栖栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄感旧五首 其五","author":"黄公度","text":"三分春色二分空，莫待春归怨晓钟。\n诗句逼人何太甚，酒徒知己信难逢。\n百年夜永昼愁短，千树红疏绿渐浓。\n尊俎班荆元不恶，试张云幕席苕邛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄感旧五首 其四","author":"黄公度","text":"待价君方藏尺璧，知音谁解听号钟。\n渥洼天上非无种，伯乐人间那易逢。\n墨绶解来三岁改，白云飞处寸心浓。\n鸱翔鸾伏古如此，直道不容非孔邛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄感旧五首 其三","author":"黄公度","text":"龆龀谈经动圣聪，山川英气向来钟。\n中书落笔万人绕，天陛赐袍千载逢。\n利锁名缰身半老，酒徒诗社意偏浓。\n莫欺犬子倦游久，得志犹能通笮邛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄感旧五首 其二","author":"黄公度","text":"何用咄咄愁书空，何用鼎食鸣金钟。\n流行坎止随所值，穮蓘不忧年不逢。\n金钗困懒海棠睡，玉斝淋漓琥珀浓。\n安能辛勤鍊石髓，苦学成周人姓邛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宋永兄感旧五首 其一","author":"黄公度","text":"犹忆当年歌画空，乘欢直欲举千钟。\n韶光半老不相识，乐事一生能几逢。\n戏蝶狂蜂随意好，闲花蔓草向人浓。\n当垆春色今何在，病酒相如卧蜀邛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵弟师白至日及弄璋之什二首 其一","author":"黄公度","text":"时序乡心破，烟波眼力催。\n城头乌信喜，海上雁书来。\n一别壶山月，三看庾岭梅。\n天涯椒桂酒，泪堕伯仁杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈宜中携诗见访","author":"黄公度","text":"朝来乾鹊啅檐牙，昨夜灯开送喜花。\n好事宁期贵公子，携诗肯访野人家。\n客愁到此逢寒食，薄宦羁人屡岁华。\n载酒他年问奇字，故园归去老桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林梅卿尚书新塘之什","author":"黄公度","text":"翚翼东西势欲翔，高怀卜筑白云乡。\n虾须半捲山排闼，属玉双飞水拍塘。\n天上功名身未老，年来丘壑意何长。\n万间广厦须公办，政恐徵书下建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自法石早归","author":"黄公度","text":"避暑寓祇园，黎明度远村。\n桑麻迷杜曲，鸡犬散桃源。\n径草细将合，溪流深不喧。\n幽怀未能惬，城郭已朝暾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日题江山驿","author":"黄公度","text":"客里萍蓬愧此身，天涯风俗对兹辰。\n云容山意商量雪，梅蕾葭灰漏泄春。\n岁晚旅怀元自恶，夜长归梦为谁频。\n遥怜儿女团栾处，应念江山飘泊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西园二首 其二","author":"黄公度","text":"意得壶觞外，心清杖屦间。\n簿书休吏早，花鸟向人闲。\n旧隐在何许，倦游殊未还。\n天涯赖有此，退食一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西园二首 其一","author":"黄公度","text":"清樾才十亩，炎陬别一天。\n华堂依怪石，老木插飞烟。\n长夏绝无暑，乘风几欲仙。\n心閒境自胜，底处觅林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西园招陈彦招同饮","author":"黄公度","text":"稻粱未饱且纷纷，鸿鹄低徊鸡鹜群。\n万里归心闽峤月，十年旅梦瘴溪云。\n邻谙好事频赊酒，家不全贫肯卖文。\n未用天涯叹离索，一尊满意说桑枌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西郊步武地春将老矣不能一往朝吉侄今日为遨头涩雨大作非惟人心难并止或尼之枕上得小诗资宋永兄一噱因呈昔游兄弟速寻旧盟勿为天公所玩","author":"黄公度","text":"无复西郊访绮罗，任教佳景去如梭。\n残杯冷炙何曾梦，乱絮飞花积渐多。\n举世尽从忙里过，几人能共醉时歌。\n不辞作意营春事，急雨狂风可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖会同年和巫子先韵","author":"黄公度","text":"一鹯独立鸟群空，寂寞谁怜汉阁雄。\n雁塔他年曾接武，乌台今日自生风。\n平湖入座摇寒碧，返照催人堕晚红。\n目断禁城骢马客，何时谭笑一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过白衣庄","author":"黄公度","text":"草树天边碧，溪流雨外浑。\n仆夫经燕岫，筋力尽龙门。\n斜日当幽径，轻风度晚村。\n筑场茅屋底，约略似东屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过使华亭悼七友","author":"黄公度","text":"恶石乱峥嵘，胡为君此行。\n功名成底事，舟楫误平生。\n天远宁容问，滩流本自鸣。\n林猿如会意，故作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"体南先生戒途有日惠诗为别三复黯然和韵奉送言不逮情 其一","author":"黄公度","text":"可但儿曹学未成，鄙心蔓草要锄耕。\n劳君穷海坐宾馆，为我文坛作主盟。\n苜蓿阑干朝饭薄，图书跌荡夜谭清。\n便携琴剑东归得，信有人间桑梓情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"体南先生戒途有日惠诗为别三复黯然和韵奉送言不逮情 其二","author":"黄公度","text":"抟沙聚散苦匆匆，岁晚山寒吾道东。\n万木飘萧催客老，一官去住任天公。\n情知今夕芳尊倒，魂断长亭返照红。\n却喜到家春正好，蛮烟洗尽见华风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋夜坐","author":"黄公度","text":"纳凉北窗下，景象有馀清。\n林暝惟萤影，庭幽但竹声。\n语阑惊坐久，露重觉衣轻。\n不寐饶诗思，徘徊参斗横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别方良翰","author":"黄公度","text":"海上曾闻属国归，归来依旧壮心违。\n风尘万里长为客，管库三年不救饥。\n尊酒欲谋良夜醉，庭花故就别时飞。\n看君好刷冲天翼，莫遣江城过雁稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别吕守三首 其三","author":"黄公度","text":"涉猎愧醇儒，南州入幕初。\n力疲三尺法，尘满一床书。\n不有刘宽恕，何堪阮籍疏。\n才微甘冗长，感激辱吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别吕守三首 其二","author":"黄公度","text":"自此调元去，人今卧辙同。\n棠阴闽岭外，星传浙江东。\n四月黄梅雨，千山荔子风。\n离亭独归处，回首意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别吕守三首 其一","author":"黄公度","text":"家世唐萧瑀，风流晋谢安。\n胸中畜丘壑，笔下富波澜。\n耆旧讴歌惜，宾僚礼数宽。\n龚黄初报政，飞诏忽江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别陈景明二首 其二","author":"黄公度","text":"冕旒目送出延英，鼓吹江喧引去程。\n三夏日迟心自急，百年恩重命还轻。\n贾胡久矣传诗句，蛮长依然识姓名。\n丹鼎刀圭应有在，愿随鸡犬上蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别陈景明二首 其一","author":"黄公度","text":"董晁大策无今古，曾据龙头拜未央。\n天府带颁腰觉重，露门茗赐齿馀香。\n麻词一扫千言就，玉节三持万里强。\n自是中朝人第一，更将威信憺要荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋永兄见和春怀再赋仍约秉彝兄寻春西郊","author":"黄公度","text":"朱毂常怀蹉跌忧，荜门长苦斗升谋。\n此生幸不贫到骨，未死何妨酒入喉。\n北里人随春渐老，西郊地与兴俱幽。\n凭君更语广文叟，饭足还须醉始休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓杨守宿九峰","author":"黄公度","text":"木落闽山暮，云深野寺秋。\n寒花空照眼，浊酒不禁愁。\n宦拙羞奔走，时危且滞留。\n迥廊供徙倚，万虑寄冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓泉守晚宿囊山","author":"黄公度","text":"山木转斜晖，秋风动客衣。\n露华侵坐冷，星宿傍檐稀。\n楼迥钟声隐，更长烛影微。\n年来倦奔走，早觉利名非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"返照","author":"黄公度","text":"返照隐西山，烟村一水间。\n路长人自急，林暮鸟知还。\n枫巷秋常扫，蓬门夜不关。\n风尘犹剧盗，岁月但催颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邵监携诗相访用集中閒居韵为谢","author":"黄公度","text":"知君琢句用功深，屹立长城不受侵。\n纸上云烟惊老眼，笔端风雨起予心。\n万里初逢谈衮衮，一尊相对树阴阴。\n斯文入手岂易得，况复逃空喜足音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居","author":"黄公度","text":"一水远能白，群山阴更青。\n静怜风细细，閒任雨冥冥。\n春色供多病，时情畏独醒。\n平生忧国意，客至问朝廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈晋江以壬戌四月上浣宴同僚于二公亭","author":"黄公度","text":"百年遗址俯郊坰，十里苍波带古亭。\n隔岸楼台春去远，满湖烟雨酒微醒。\n苔碑缺落庭松老，野鸟去来汀草青。\n风物不殊天竺路，扁舟髣髴旧曾经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和方次云至日作","author":"黄公度","text":"至日空相忆，何时复此来。\n素书烦蜡炬，往事付寒杯。\n梦破风惊竹，诗成雨绽梅。\n江城低婺女，回首亦劳哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余子美即事二首 其二","author":"黄公度","text":"黉堂归去葛衣轻，怪底形容太瘦生。\n抖擞悭囊偿酒债，安排崄韵主诗盟。\n妖韶梅老自馀态，滋味韩休薄大羹。\n强策驽骀追逸驾，不堪才力但平平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余子美即事二首 其一","author":"黄公度","text":"昏昏午汗浃桃笙，醒眼清诗仗友生。\n俘馘遥传泮水捷，琴书初解杏坛盟。\n开尊赖有论文酒，舍肉应无遗母羹。\n好种桑麻归杜曲，行藏休更问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和余子美春日缓步","author":"黄公度","text":"道屈时危且茹藜，不妨去鲁尽迟迟。\n一轩容膝分蓝宇，十里携筇闯麦岐。\n杜老皓头真可惜，陶潜知命更奚疑。\n干戈淮上无消息，愁绝南山独步时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋去华爱日楼之什","author":"黄公度","text":"百里平畴一望间，绿芜尽处见青山。\n孤云自在开仍合，白鸟群飞去复还。\n竟日茶瓜留客坐，满床图史伴君閒。\n携醪许我问奇字，剥啄何妨屡扣关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄咏荔支用东坡刑字韵四首 其四","author":"黄公度","text":"一时红紫逐飘萍，风雨残枝尚缀星。\n西国葡萄甘仆隶，白家踯躅强仪刑。\n谁移仙种从丹府，不使灵荄遍八溟。\n大业豪华今寂寞，佳名空著海山经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄咏荔支用东坡刑字韵四首 其三","author":"黄公度","text":"脩竹繁阴覆绿萍，压墙朱实斗星星。\n明珠落掌骊龙睡，丹壳归盘白马刑。\n曾指画图誇北客，至今渍蜜动南溟。\n可怜伧父流涎久，何日乌山始一经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄咏荔支用东坡刑字韵四首 其二","author":"黄公度","text":"蜜甜谁数楚江萍，枉道偷桃是岁星。\n长夏日烘怜国色，去年霜薄赦秋刑。\n侯堂旧许祠南海，使驿曾劳走北溟。\n名种尚堪重品第，未甘陆羽著茶经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄咏荔支用东坡刑字韵四首 其一","author":"黄公度","text":"枝头血色万年萍，错落横天粲彗星。\n昔日杨姬劳走驿，一时王姥欲俱刑。\n浪传石蜜来他域，巧似珊瑚出涨溟。\n仙种世传工益寿，饱尝端胜卫生经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄春日閒居","author":"黄公度","text":"负郭浓春事，高斋辟晓关。\n晴云浮越峤，芳草接荆蛮。\n禄薄难长饱，才微分久閒。\n年华兵甲里，吁骇镜中颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄爱日楼见寄八首 其八","author":"黄公度","text":"山林往不返，朝市去无回。\n能乐穷通者，真知出处哉。\n次山称漫仕，彭泽赋归来。\n堪笑胁肩子，相从不待媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄爱日楼见寄八首 其七","author":"黄公度","text":"秋心惊杵急，远目见潮回。\n衰日可爱也，楚风真快哉。\n卷开前圣对，竹动故人来。\n去鲁迟休怪，谋身耻自媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄爱日楼见寄八首 其五","author":"黄公度","text":"轩组挽人力，万中无一回。\n急流能退者，舍我有谁哉。\n此意何时遂，相携归去来。\n东皋春雨足，荷锸听鸠媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄爱日楼见寄八首 其四","author":"黄公度","text":"医手无三折，愁肠漫九回。\n宦情聊复尔，世事转艰哉。\n狂态未能免，新诗特地来。\n从今罢歌舞，焦尾听无媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄爱日楼见寄八首 其三","author":"黄公度","text":"野意楼前满，秋声树杪回。\n岁华行老矣，午梦思悠哉。\n碌碌甘捐弃，时时幸往来。\n不才诗有债，多病酒为媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永兄爱日楼见寄八首 其六","author":"黄公度","text":"龆龀携书册，成名天上回。\n如公希世者，自古几人哉。\n山薮讵宜去，功名看鼎来。\n人间无伯乐，相马失龙媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋永四兄集句","author":"黄公度","text":"时事干戈里，年光卷帙中。\n有怀忧社稷，无力靖华戎。\n世路日多梗，斋扉昼掩蓬。\n悲歌抚长铗，爽飒气摩空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和苏伯承题恂恂轩","author":"黄公度","text":"可但温恭九族敦，平生乡党更恂恂。\n山林得趣身长健，门馆无私物自春。\n一室琴尊对咸籍，百年胶漆付雷陈。\n共传宅相工题品，未数东坡德有邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈应求春日见寄","author":"黄公度","text":"满目繁春事，题诗寄所思。\n轻寒欺酒力，宿雨褪花姿。\n经世知无术，追欢要及时。\n郊原剩晴景，莫负去年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈应求韵兼呈方次云","author":"黄公度","text":"策蹇冲泥到野扉，故人相对破愁眉。\n话因别久卒难尽，情逐杯深那更辞。\n十里云山乖素约，一番桃李负幽期。\n萧萧半夜空阶雨，乱滴枯肠百斛诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和使君劭农之什","author":"黄公度","text":"交情自许胶投漆，宾主相辉璧与琨。\n卖剑早书循吏传，种瓜时问故侯园。\n百年耆旧须亲访，千里耕桑戴上恩。\n一郡风流古来少，笔端珠玉富归轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和咏陈贤良华表","author":"黄公度","text":"千年鹤表映溪滨，一代鸿文动至尊。\n仕路低徊唐老杜，才名合沓汉公孙。\n家风不减太丘令，盛事何如通德门。\n肯把浮荣衒流俗，欲遗典则到仍昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南安余宰题翠阴亭致爽轩二首 其二","author":"黄公度","text":"面势揖孤峙，交柯藏伯劳。\n日临公馆寂，人与此轩高。\n对酒屡中圣，题诗应仆骚。\n乔林思旧隐，咫尺听风号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南安余宰题翠阴亭致爽轩二首 其一","author":"黄公度","text":"溪光山色两幽深，更结新亭倚翠林。\n老木参天烟漠漠，虚檐挂日影沉沉。\n三年此地留乔舄，六月凉风飒楚襟。\n趁取公馀急行乐，人生容易二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐子由题昼寂轩","author":"黄公度","text":"木落孤城迥，苔封古寺深。\n结庐依近地，隐几惬幽心。\n细草秋仍绿，脩篁晚更阴。\n红尘门外路，六辔漫如琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和龚实之闻虏人败盟","author":"黄公度","text":"请缨未系单于颈，置火须然董卓脐。\n列郡奔驰喧羽檄，圣朝哀痛下芝泥。\n盟寒关陇无来使，春晚江淮有战鼙。\n十载枕边忧国泪，不堪幽梦破晨鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢单推宋卿惠诗","author":"黄公度","text":"逃空每喜足音闻，之子相逢真可人。\n知友无非大父行，求君须向古人伦。\n蛮烟倾盖情如故，蜀茧题诗墨尚新。\n文采风流百不俗，更馀笔力挽千钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]