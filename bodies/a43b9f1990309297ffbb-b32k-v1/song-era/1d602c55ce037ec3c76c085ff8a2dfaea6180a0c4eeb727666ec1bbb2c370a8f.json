[{"title":"次韵居甫六绝句 其五","author":"许及之","text":"夕阳绽处动归舟，照眼明边是白鸥。\n只听前湖歌欸乃，不知风雨转船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵居甫六绝句 其六","author":"许及之","text":"西湖弭棹曲廊腰，休忆长桥复断桥。\n随意吾乡度寒食，登临不费酒旗招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次谏长韵赠严处士","author":"许及之","text":"鸢在青天鱼在川，马牛谁络更谁穿。\n过求敢问君平卜，只问皇家一统年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其一","author":"许及之","text":"宇宙声名宇宙容，岂无湖海著元龙。\n黄州诗兴椎轮耳，诗到儋州兴更浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其二","author":"许及之","text":"贤者行藏只委天，山川却自以人传。\n几年茨棘东坡地，不祇人贤地亦贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其三","author":"许及之","text":"护持风物感波神，翁去如今隔几尘。\n海上跨龙时一到，雪堂烱烱见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其四","author":"许及之","text":"明月清风转柁楼，武昌樊口直黄州。\n天公不借苏仙便，两赋那成赤壁游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其五","author":"许及之","text":"海棠一树立山村，桃李场中合断魂。\n从我东坡三子在，休悲六客更谁存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其六","author":"许及之","text":"故人相戒莫吟诗，那免斑斑露一奇。\n无奈西湖频入梦，果然吴饷却来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其七","author":"许及之","text":"男儿何苦自拘囚，六合无非汗漫游。\n唤取东轩同抱耒，潇潇风雨正筠州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其八","author":"许及之","text":"见惯沙鸥已不飞，旁人相见莫相疑。\n无端却为鱼蛮子，又著危言感圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其九","author":"许及之","text":"海内倾心雨露词，种松争忍十年期。\n临皋五见分新火，只比先生睡觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其十","author":"许及之","text":"归来宣室恰新年，笔下生成又补天。\n唤作玉堂堂唤雪，不知若佞若为贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻工部追和王詹事游东坡十一绝亦次韵 其十一","author":"许及之","text":"腐儒珍重百年身，眼见白头无数新。\n晚岁江山纵摇落，平生出处长精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀德久仍调爽约 其一","author":"许及之","text":"南北峰高金突兀，短长桥远碧琉璃。\n转庵好借鱼庄住，处士仙来剩欠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀德久仍调爽约 其二","author":"许及之","text":"葵萼已倾朝霁日，榴花犹染晚归云。\n不知荷盖添多少，定自湖光减几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀德久仍调爽约 其三","author":"许及之","text":"得句宁如餐玉秘，食言可似雨梅肥。\n暑中纵爱持竿手，夜后何如载月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘲少年","author":"许及之","text":"守舍看家老者便，少年争逐艳阳天。\n新花日买添新水，肯信翁心尚少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"外舅嫁遣二侍儿有诗次韵","author":"许及之","text":"诗翁学力有长城，笑语丛中漫鼓行。\n出水芙蓉宁受污，铅华洗尽见真情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江西刘谋卿秀才以火焚其居谏长序其事以告袁吉故因题其后","author":"许及之","text":"祝融回禄爱君深，却以无家到武林。\n谏议一篇如见面，故人争不动仁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读王文公诗","author":"许及之","text":"文章与世为师范，经术于时起世仇。\n少读公诗头已白，只因无奈句风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再读雪溪志诗 其一","author":"许及之","text":"谁无胸次著林丘，脚底黄尘到白头。\n不羡雪溪成卜筑，羡他卜筑备归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再读雪溪志诗 其二","author":"许及之","text":"才吟盘谷还思隐，试说柴桑便忆归。\n何处山人高索价，老腰犹要万钉围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再读雪溪志诗 其三","author":"许及之","text":"万古功名米一稊，此身只合把锄犁。\n可怜岁晚鄱江畔，再读前贤志雪溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净慈致斋侍者求三教赞","author":"许及之","text":"休问船来与陆来，桃源到处即天台。\n双林做底须知会，认著形骸亦苦哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题所藏二修禊帖后","author":"许及之","text":"昭陵脱手已非真，石本流传喜似人。\n澹墨似肥浓似瘦，骊黄不见见精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"契师欲予隶书为此以赠","author":"许及之","text":"契师画得梅中趣，急水溪头印月时。\n昨夜卧披今起看，自宜重坼向南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵薛奉常以诗送瑞荷花并图而花与图俱不至 其一","author":"许及之","text":"并目莲房并根藕，流传乐府已稀奇。\n平分叶叶红兼白，绝忆公家瑞绿漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵薛奉常以诗送瑞荷花并图而花与图俱不至 其二","author":"许及之","text":"昨梦前尘假合来，刻舟求剑记莲栽。\n花图诗卷闻乌有，犹望荷花旧处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 其一","author":"许及之","text":"平坡软草细芊芊，碧树遥枝绿荫圆。\n羊豕自如知饱后，牧儿箕坐得安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 其二","author":"许及之","text":"岩壑林坰景趣幽，等閒鸥鹭亦夷犹。\n承平人物佳公子，游戏丹青翰墨侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 其三","author":"许及之","text":"著莫池塘浩荡秋，露荷风荻冷飕飂。\n双凫乘雁自寻伴，孤鹭无尘不解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 其四","author":"许及之","text":"弄色阶前各一家，宾秋饯暑度年华。\n道人落墨聊游戏，认得真为金凤花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 其五","author":"许及之","text":"擎水端如治大兵，儿曹何事解关情。\n等閒戏剧休成恶，两个俱双莫挠清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 其六","author":"许及之","text":"钧有婴儿伉俪情，山川其奈险难平。\n如何一得戎夷俗，长使中原不用兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谏长之门人曾君三异作招隐图并赋二诗以招谏长之归亦赋二首 其一","author":"许及之","text":"谢公雅志在东山，其奈苍生债未还。\n寄语故人专一壑，不妨清梦落沧湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谏长之门人曾君三异作招隐图并赋二诗以招谏长之归亦赋二首 其二","author":"许及之","text":"能画能诗已可人，迷途前畔更知津。\n眼看益友如君少，我亦归心动白蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王晦叔惠听雨图次蔡韵奉寄 其一","author":"许及之","text":"拂拭沧波远接天，摩挲乔木老生烟。\n题诗作画人何在，万古蓬窗一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王晦叔惠听雨图次蔡韵奉寄 其二","author":"许及之","text":"常日京华薮泽思，六年身悟画中诗。\n须知妙处无今古，得画还如听雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张野夫所藏颜持约大招图","author":"许及之","text":"颜君思似龙眠苦，贾赋伤于宋玉悲。\n万古忠魂元不没，令人惆怅大招词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪子恂所画盘洲图三首 其一","author":"许及之","text":"昔见园成今创始，今为图就有闻孙。\n长松钜竹知无恙，直节清标想故存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪子恂所画盘洲图三首 其二","author":"许及之","text":"摩挲指点经行处，尽和诗篇二百馀。\n已是步趋瞠若后，或看晚节在归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪子恂所画盘洲图三首 其三","author":"许及之","text":"有笔堪耕须苦志，无田可种莫忧贫。\n细推方寸遗宽地，有此孙枝亦可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题浯溪图","author":"许及之","text":"山川自昔因人胜，岂爱浯溪爱漫郎。\n不得中兴摅老笔，两章秋月漫争光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题晓莲图","author":"许及之","text":"生绡未展已生凉，白白红红映两厢。\n赖得转庵先著语，几成虚送许文昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"窥蓬图","author":"许及之","text":"杨子长条玉作葩，花光冻棘眩冰花。\n短蓬几见空相似，捕影图成试吃茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游鯈图","author":"许及之","text":"碧草差差泛绿猗，未施鱼影乐先知。\n遥怜般礴明窗下，便是濠梁得意时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题瑞宁草虫","author":"许及之","text":"候虫微细欲何为，却与鹏抟共一机。\n须信人心关造化，蜻蜓能点蝶能飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题潘德久所藏杨补之竹梅","author":"许及之","text":"竹弟梅兄已可人，老杨笔力更精神。\n转庵不用持相恼，买得梅坡入梦频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明日欲对通夕不成寐枕上赋墨梅诗还契师宿逋 其一","author":"许及之","text":"师住一庵几何年，山深更过灵隐前。\n遗我江南几张纸，中有寒枝真契禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明日欲对通夕不成寐枕上赋墨梅诗还契师宿逋 其二","author":"许及之","text":"胸中扫除烟火食，笔端洗涤苍苔痕。\n立雪家风真第一，我欲著句今忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明日欲对通夕不成寐枕上赋墨梅诗还契师宿逋 其三","author":"许及之","text":"苍颜幸没黄尘里，清梦忽堕孤山涯。\n处士桥边卷蓬相，痴儿莫讶得香迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明日欲对通夕不成寐枕上赋墨梅诗还契师宿逋 其四","author":"许及之","text":"昔看滩头印明月，今观海底拾玄珠。\n自从迦叶天机浅，不但花无笔亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明日欲对通夕不成寐枕上赋墨梅诗还契师宿逋 其五","author":"许及之","text":"春风不逐花光老，心印自传圜契师。\n师能写出梦中梦，我却吟成诗外诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听湘西许老弹琴","author":"许及之","text":"颜里常春鬓已秋，抱琴时与破牢愁。\n自言旧曲都忘却，弹未终时且罢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听德久弹秋思","author":"许及之","text":"潘郎胸次有经纶，指下声如笔下真。\n已是不禁秋意思，更弹秋思苦撩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四弦","author":"许及之","text":"马上征人湿拥毡，犹将愁思曲中传。\n向来有句真成谶，小雨斜风十四弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵才叔闻笛试灯二绝 其一","author":"许及之","text":"叠石为山漫崛奇，玉峰欣对似相知。\n梅梢顶上吹霜笛，却惜流香过别池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵才叔闻笛试灯二绝 其二","author":"许及之","text":"相逢一笑即衔杯，梅与诗怀得共开。\n但有灯光并月色，不须元夕始重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马上口占咏席帽","author":"许及之","text":"本是田间荷笠身，不堪重戴压乌巾。\n苦无谏语遮羞得，其奈旁观冷笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送越笺与才叔次韵","author":"许及之","text":"剡藤分送意何如，击钵聊供腕脱书。\n飞动要观廉蔺气，此笺断不与曹蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铜雀台瓦砚","author":"许及之","text":"千年铜雀荫歌尘，张老澄泥解逼真。\n我有古端钧玉德，中涵雨露炳星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人惠诗并素馨油 其一","author":"许及之","text":"万桂丛中不记年，行藏极处只由天。\n朝回若问南湖叟，依旧山边复水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人惠诗并素馨油 其二","author":"许及之","text":"晴窗一缕海南云，彻骨风流自可人。\n由作桂油膏面样，不妨粉念混天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘知监端午前一日以诗送甜苦笋末章有谢绝香蒲与酒壶之句以五绝句送酒 其一","author":"许及之","text":"感君亲与爱相兼，世味谙来已属厌。\n惠我西湖甜苦笋，为言无苦只知甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘知监端午前一日以诗送甜苦笋末章有谢绝香蒲与酒壶之句以五绝句送酒 其二","author":"许及之","text":"经月梅林扫迹晴，照人湖水拍堤平。\n软红尘里偷閒客，处士桥边取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘知监端午前一日以诗送甜苦笋末章有谢绝香蒲与酒壶之句以五绝句送酒 其三","author":"许及之","text":"新来怀抱少人知，自入修门未有诗。\n鸠自呼晴蛙唤雨，羡君湖上看西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘知监端午前一日以诗送甜苦笋末章有谢绝香蒲与酒壶之句以五绝句送酒 其四","author":"许及之","text":"一沐未还旬日谒，片言敢折累年囚。\n杜门莫羡过僧夏，多雨方愁损麦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘知监端午前一日以诗送甜苦笋末章有谢绝香蒲与酒壶之句以五绝句送酒 其五","author":"许及之","text":"湖光可吸太清孤，渔父鸣鞭少得无。\n幸自有诗酬午节，不应无酒住西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中山酒","author":"许及之","text":"中山一醉百经旬，鲁酒千杯不醉人。\n莫怪近来风味薄，中山久已杂边尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵才叔屠苏绝句","author":"许及之","text":"底须却鬼写台符，一盏侵晨不可无。\n老觉东坡翻倒置，奚为后我酌屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望商山","author":"许及之","text":"符离东望即商山，画出江南见一斑。\n社稷未能还汉旧，岂容四老老其间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入泗州","author":"许及之","text":"越境张旃入泗州，隔帘翁媪拜含愁。\n可怜万折朝宗意，误尔尸臣死亦羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵壁坝","author":"许及之","text":"入泗行来汴似梁，坝成灵壁水全枯。\n汴流可遏从渠遏，思汉人心遏得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临淮望龟山塔","author":"许及之","text":"几共浮图管送迎，今朝喜见不胜情。\n如何抖得红尘去，且挽清淮濯我缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]