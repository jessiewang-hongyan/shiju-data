[{"title":"使辽作十四首 其六","author":"刘跂","text":"神水坚冰合，沙场寸草无。\n长疑泪是血，误喜唾成珠。\n昼出惊貂鼠，宵鸣厌训狐。\n悲歌人不应，自觉寸心孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其七","author":"刘跂","text":"北岭能扪斗，南冈欲摘星。\n旧闻空耳满，异域得身经。\n好筑嫖姚冢，仍刊车骑铭。\n莫言天作限，关路有松亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其八","author":"刘跂","text":"鼓角霜初晓，箫笳日欲曛。\n莫为天外意，只作梦中闻。\n问道无人迹，嘶风有马群。\n山高飞鸟急，决眦入层云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其九","author":"刘跂","text":"一作重山去，频看破镜飞。\n长悲青冢怨，莫忘白登围。\n礼觉周旋异，心知笑语非。\n南飞何处鸟，安得与俱归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其十","author":"刘跂","text":"喜斗人皆勇，诛求俗故贪。\n为谋不耐暑，嗜味独便盐。\n已怪今生到，宁能一夕淹。\n长安远如日，北斗望为南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其十一","author":"刘跂","text":"今日朝元仗，千官两掖门。\n从容鱼藻宴，供奉柏梁尊。\n厌服貂裘敝，愁看桂酒温。\n谁知广文淀，水面箔为藩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其十二","author":"刘跂","text":"置酒穹庐晓，僧山合管弦。\n应缘地褊小，难遣舞回旋。\n风急皮毛重，霜清湩酪膻。\n君看东向坐，贵重尽童颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其十三","author":"刘跂","text":"王春今日是，虏历自相忘。\n厌食乾羊味，如闻生菜香。\n陇梅浑破腊，燕雁正随阳。\n时节催归兴，凭陵天际翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽作十四首 其十四","author":"刘跂","text":"日觉筋骸耗，中宵惨未宁。\n厌看山濯濯，快见柏青青。\n记里无官堠，更衣有短亭。\n心惊此何地，生死一流萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中","author":"刘跂","text":"病如漳浦卧，一腹果然浮。\n不著三升饭，能容万斛愁。\n水声回别浦，山影到中流。\n遣兴须凭酒，殷勤为汝留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹纮陷交阯十七年与其母逃归得官汶上求诗","author":"刘跂","text":"曹侯将家子，异域久飘飖。\n人独忧羝乳，天方借海桥。\n亡弓终在楚，去鹤会归辽。\n凛凛今如许，风霜看后凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答景亮二首 其一","author":"刘跂","text":"门无车马迹，卧榻两閒人。\n野服风前薄，园蔬雨后新。\n丝桐叔夜操，香火净名真。\n斜日穿檐入，悠悠对隙尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答景亮二首 其二","author":"刘跂","text":"吾庐亦自爱，况属仲春中。\n宾榻疏帘隔，邻园小径通。\n何妨书帙乱，未遽酒尊空。\n更约高人过，当轩看偃松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"刘跂","text":"夜永风露下，庭空帘幕秋。\n杯盘延素魄，针缕动双眸。\n天上秖今夕，人间宁少留。\n如何一水际，岁岁此相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠","author":"刘跂","text":"绝世丹青业，中台雨露辰。\n师门推上第，王室见名臣。\n磊落儒林丈，风流画省宾。\n燕朝分锦仗，儤值近枫宸。\n鸣凤丹山穴，占星颍水滨。\n殿庐俄厌直，藩社此班春。\n山节还铜虎，京符换玉麟。\n威行三辅地，歌浃两川民。\n已喜徵黄霸，无劳借寇恂。\n即应公简上，会见俗还淳。\n叹昔时难偶，逢今势莫均。\n楚材难入晋，汉法近沿秦。\n稽古皆前列，希风绝后尘。\n斯文如汩没，吾道久湮沦。\n海岳功归圣，熊罴钓有人。\n蓝田仍产玉，郢匠早挥斤。\n周历方开永，萧规欲尽循。\n天时知会遇，人力漫纷纶。\n夙有掺弦便，今逢敛板亲。\n猥惭牛下走，敢玷席中珍。\n迹远龙门峻，心怀燕厦仁。\n绪言闻已旧，从此更书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答资道","author":"刘跂","text":"都尉声名后，篇章不乏才。\n谈高正始际，诗自建安来。\n险怪探龙颔，甘珍味豹胎。\n阴何长有思，郊岛漫相猜。\n白雪凭谁听，黄花入众咍。\n楚醒搴水薜，蜀兴动官梅。\n晚艇翩翩鸟，秋涛隐隐雷。\n水兼天浩荡，山为日崔嵬。\n丽藻烦三复，愁肠殆九回。\n自惭无世用，庄语笑迂骀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕戏效西昆体","author":"刘跂","text":"终年情脉脉，此夕夜迟迟。\n玉宇秋来阔，珠帘夜后宜。\n仙娥月为姊，海实树生儿。\n露共云车下，风将鹊扇移。\n鲛盘空有泪，椽笔未成诗。\n借取挥戈便，金釭更百枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄叶勤次其韵","author":"刘跂","text":"五斗折腰俱为贫，诗书律令若为分。\n西山今朝有爽气，北阙无时飞白云。\n一纸绸缪三岁字，七言憀慄九章文。\n故人好在长相忆，怅望江皋麋鹿群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵侯思恭","author":"刘跂","text":"西城冠盖日初曛，南浦笙歌夜向晨。\n何许烟波千顷隔，尔来霜月一钩新。\n名花只许平泉有，开宴谁如北海频。\n我亦尊前旧时客，独将衰白卧漳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用公允韵送介叔东归","author":"刘跂","text":"曾曳长裾何处门，楚声悲壮不堪闻。\n侵陵急景东都雪，触忤新愁南浦云。\n未信书生歌岳岳，要令天子禅云云。\n少年持许今安在，拭目翱翔鸳鹭群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次王彦昭寄苏景谟青社园亭韵二首 其一","author":"刘跂","text":"丞掾分曹付旧规，翩翩文彩妙当时。\n何人误读雌霓赋，他日真成幼妇碑。\n曲水流觞如故事，平山行乐有新诗。\n春来想见棠阴盛，可但诗人别后思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次王彦昭寄苏景谟青社园亭韵二首 其二","author":"刘跂","text":"谁道前贤迹已尘，园林气象迩来新。\n高山流水有深意，翠竹黄花如故人。\n小队郊坰时访客，后堂歌吹独留宾。\n汶阳寂寞无佳赏，卧阁萧然过一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涵辉阁次韵","author":"刘跂","text":"光风冉冉动平湖，花草幽香满坐隅。\n薰暖颇如欢伯在，萧閒宜与此君俱。\n可无剡水乘舟兴，端是郊居作赋图。\n借与禅翁有幽事，一支筇竹倚圆蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行次长风沙次韵","author":"刘跂","text":"清晨喜气动江流，两见新篇到小舟。\n石裂崖颓非快意，风声鹤唳亦消忧。\n已令双鲤随梅使，更不飞乌倚柁楼。\n兴味从今得嘉境，著书应不号穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游白云山次韵二首 其一","author":"刘跂","text":"不到山中宁久如，两日阙然或阔疏。\n每怜身留只意往，何事子行令我居。\n莫向山僧疑入定，但从溪友试观渔。\n朝来新作几两屐，更待西原春雨馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游白云山次韵二首 其二","author":"刘跂","text":"数子读书浑欲狂，深山纵汝共徜徉。\n千钧脚力有底健，万丈心情如许长。\n对景吟哦亦有意，逢人笑傲若无旁。\n幽花细草何足赏，岁岁天边仙桂芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次孙君汝弼晚步韵","author":"刘跂","text":"寂寥谁过仲宣楼，邂逅斯人肯小留。\n多病儿童便食粥，忘机鸥鸟共临流。\n赋成拟学张平子，志大空惭马少游。\n载酒从今相煖热，著书应不号穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张大年览文与可墨竹及先人所题与可挽诗见惠长句因次其韵","author":"刘跂","text":"墨妙苍筤双玉枝，赏音悲壮七哀诗。\n多惭寂寞青毡地，又得风流黄绢词。\n往事白杨无数拱，馀生衰鬓不堪垂。\n声沈影绝何人识，赖有柯亭可见思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次介叔韵","author":"刘跂","text":"酒船定向江东去，知有风流贺季真。\n北岭南冈元自熟，短杨高柳迩来新。\n老吾官职浑无味，壮子文章最有神。\n知欲弦歌且三径，徵君莫自傍风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次胡伸道韵并简公允弟","author":"刘跂","text":"几年书不到江东，知我忘形事事慵。\n南阮最贫方远宦，阿连同调且相从。\n狂生肯信原非病，妄校须惭广未封。\n安得论文如定力，不眠长听五更钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次大人二月三日过吴德仁韵二首 其一","author":"刘跂","text":"溪上高人称福吴，一尊深喜共为娱。\n步行可是困公子，日晏不应骄灌夫。\n纵履全胜驱下泽，缓歌长欲听提壶。\n行年八十心如水，正觉公非嵇阮徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次大人二月三日过吴德仁韵二首 其二","author":"刘跂","text":"一一郊原春事催，客愁今日为君开。\n柳枝鸲鹆未成舞，溪面葡萄初泼醅。\n曲水便应诗句满，稽山那复酒船回。\n海棠径里纹楸石，为尔从今得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次窦子野韵","author":"刘跂","text":"不辞身热野田风，水引膏环入眼中。\n曲米顾公多乐事，锄犁怜我有深功。\n博闻可但百间屋，爱客未嫌三斗葱。\n天麦毒人安敢献，莫令堂上一尊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次黄完仲韵","author":"刘跂","text":"几年流落喜东归，笑语相欢此一时。\n轣辘小车真快意，伶俜短杖且扶危。\n新诗遣兴几成癖，浊酒忘怀定不痴。\n政恐为官抛我去，除书闻已下京师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题僧道诚应缘庵用李端叔韵","author":"刘跂","text":"历历孤寒不可群，应缘聊寄梦中身。\n无弦琴里本来曲，枯木岩前元自春。\n诗句已多犹恐少，禅机虽旧不妨新。\n乡山更好莫归去，且伴蒲团夜坐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠山寺","author":"刘跂","text":"从来未到山头寺，应在武陵深处藏。\n汉水文人生自拙，香山居士兴何长。\n四旁岛屿娟娟绿，万顷菰蒲靡靡香。\n且醉尊中眼前物，瀛洲蓬岛两微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙山寺","author":"刘跂","text":"晓色翩翩乌帽轻，道人瞥去不关情。\n高山流水为谁说，翠竹黄花空自生。\n急雨欲来先暑气，凉风已过却秋声。\n后期好取归时月，照我深岩处处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪","author":"刘跂","text":"春晚西溪入胜游，白杨花乱绿波浮。\n欲延笑语迟行酒，要尽溪山缓放舟。\n滩上时看鱼拨剌，林间静听鸟钩辀。\n年来偷活干戈际，强把閒吟写我忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题半隐堂","author":"刘跂","text":"一堂图籍自陶冶，三径萧兰俱岁华。\n定非平恩许侯宅，会是仲长公理家。\n端居雅不烦摒挡，佳设颇尝成咄嗟。\n惟我身閒数来往，徽弦一泛即生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和长历赋纸阁用王介甫韵","author":"刘跂","text":"顶还平直得中方，肯作僧庵半夜床。\n脱帽不忧风栗烈，炽炉仍助日苍凉。\n赏音正自鸣琴便，宴坐何辞问疾妨。\n我有陟釐三百幅，禦冬真欲倒归囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石友","author":"刘跂","text":"卜居无赖款郊扉，忽忽春还乐事微。\n莫道身贫非是病，由来人瘦不知肥。\n欢呼岂肯觞三爵，落魄谁如带十围。\n富贵功名更谁是，且来同醉莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾存之约游北园","author":"刘跂","text":"主家韦曲小桃溪，客有诗名杜拾遗。\n煮酒未成逃暑饮，夹衣犹及惜花时。\n樾间日下潭潭盖，蘋末风生寸寸漪。\n一醉百篇供草圣，主人?取墨为池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王景亮席上","author":"刘跂","text":"儿曹付汝莫相关，来伴诗翁作醉颜。\n花似有情怜客老，竹应无意惜春还。\n已凭玉麈消炉篆，不怕金轮照屋山。\n尊俎重开定何日，北溪流水正回环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东南秀罗亦佳山而近用前韵约游","author":"刘跂","text":"邂逅飞蓬身事轻，异乡风物不胜情。\n出无舆马自怜许，食有蛙鱼空瘦生。\n失路漫漫迷日影，并溪沥沥灌田声。\n似闻更有佳山在，试卜东南十里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答尹弥尔","author":"刘跂","text":"门巷相看经几时，重来新事如弈棋。\n从今碌碌自我拙，尔后铮铮非子谁。\n每惊咳唾尽珠玉，定有锦绣生肝脾。\n人生盖棺事乃已，一笑一嚬安足悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答刘槩石豫","author":"刘跂","text":"春来深觉境翛然，幽鸟檐头接翅眠。\n落寞久知身是梦，安閒更喜日如年。\n江山南国楼台外，桃李东风锦绣边。\n野兴暂成沂水浴，故人盍驾越溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠秦帅吴子中","author":"刘跂","text":"河岳根源禀植坚，金行鼎鼎应弧悬。\n执圭阿阁三阶上，建隼元戎十乘前。\n都护已高延寿最，中朝深记弱翁贤。\n从今看似张丞相，富贵康强一百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重葺前堂榜曰学易景亮六丈宠惠新诗谨赋二诗上谢 其一","author":"刘跂","text":"并舍荒芜三四寻，稍营轩槛便幽深。\n已将种木待休影，未暇摊书聊洗心。\n投老篇章愁脉脉，随缘香火静愔愔。\n从今扫洒供鸡黍，知有高人肯见临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重葺前堂榜曰学易景亮六丈宠惠新诗谨赋二诗上谢 其二","author":"刘跂","text":"草堂门径迩来通，好事何人肯过雄。\n故与图书为伴侣，可无风月到帘栊。\n生平适意丝桐内，老去忘怀曲米中。\n感激新诗百金重，贫装从此不忧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍弟寄茶","author":"刘跂","text":"吾弟饷人真不恶，建芽来自禁烟前。\n一杯未易阳侯厄，四两应为蒙顶仙。\n病子头风如得药，酒家中圣殆忘眠。\n平头奴子堪瓶椀，可带樵青竹叶煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀","author":"刘跂","text":"此身为客几东西，万物须于一马齐。\n山色不随春草绿，边声长伴夜乌啼。\n宦游碌碌凭谁记，簿领纷纷为底迷。\n犹喜官轻无局事，不妨酣寝过晨鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐进庵戏作 其一","author":"刘跂","text":"自吾营此庵，迁徙屡有无。\n壁间故人文，今独与我俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐进庵戏作 其二","author":"刘跂","text":"结以不根茅，阖之无钥锁。\n坚密乌有身，非坐常宴坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐进庵戏作 其三","author":"刘跂","text":"圆蒲与方竹，伴我守幽閒。\n夜阑得禅趣，明月窥窗间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其一","author":"刘跂","text":"端居得韵语，不作凉秋悲。\n快若弹丸转，知是王家诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其二","author":"刘跂","text":"之人娴辞令，病起犹越声。\n不量苍苍鬓，属和愁仅成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其三","author":"刘跂","text":"客来问玄解，付与尊中友。\n我口不能言，此间甚多有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其四","author":"刘跂","text":"欲逃苏晋禅，苦乏阳城俸。\n邻家称子贫，杯酌与君共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其五","author":"刘跂","text":"忆昨艘楫间，月白云水暮。\n妙语同赏心，请君来重赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其六","author":"刘跂","text":"且无遽典衣，素书堪下酒。\n旋斸金铃黄，栽轩媚重九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其七","author":"刘跂","text":"念当岁峥嵘，少别友中玉。\n梦寐大刀头，安得卢橘熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其八","author":"刘跂","text":"霜蟹丰两螯，磊落登盘盂。\n亹亹倦咀嚼，繄我愁独无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其九","author":"刘跂","text":"庭阶脱叶静，岌岌高井梧。\n雁声排云去，历历心不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王升之绝句以诗成有共赋酒熟无孤斟为韵因次其韵 其十","author":"刘跂","text":"夜寒惨不寐，起坐弹鸣琴。\n之人邈云汉，空杯难独斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅径","author":"刘跂","text":"幸蒙托根地，历历令著行。\n莫遣桃李妖，压我玉雪香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葵轩","author":"刘跂","text":"朝暾媚花木，户牖延荣光。\n新沐晞我发，悠然成坐忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]