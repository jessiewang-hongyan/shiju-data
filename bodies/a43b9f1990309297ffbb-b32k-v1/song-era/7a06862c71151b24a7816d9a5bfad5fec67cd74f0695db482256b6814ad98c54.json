[{"title":"临江仙 其二","author":"刘过","text":"数叠小山亭馆静，落花红雨园林。\n画楼风月想重临。\n琵琶金凤语，长笛水龙吟。\n青眼已伤前遇少，白头孤负知音。\n苔墙藓井夜沈沈。\n无聊成独坐，有恨即沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其四 茶词","author":"刘过","text":"红袖扶来聊促膝，龙团共破春温。\n高标终是绝尘氛。\n两箱留烛影，一水试云痕。\n饮罢清风生两腋，馀香齿颊犹存。\n离情凄咽更休论。\n银鞍和月载，金碾为谁分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"刘过","text":"行道桥南无酒卖，老天犹困英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 送卢梅坡","author":"刘过","text":"泛菊杯深，吹梅角远，同在京城。\n聚散匆匆，云边孤雁，水上浮萍。\n教人怎不伤情。\n觉几度、魂飞梦惊。\n后夜相思，尘随马去，月逐舟行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近 同妓游帅司东园","author":"刘过","text":"窄轻衫，联宝辔，花里控金勒。\n有底风光，都在画阑侧。\n日迟春暖融融，杏红深处，为花醉，一鞭春色。\n对娇质。\n为我歌捧瑶觞，欢歌动阡陌。\n□似多情，飞上鬓云碧。\n晚来约住青骢，蹋花归去，乱红碎、一庭风月。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近","author":"刘过","text":"笑天涯，还倦客。\n欲起病无力。\n风雨春归，一日近一日。\n看人结束征衫，前呵骑马，腰剑上、陇西平贼。\n鬓分白。\n只可归去家山，无田种瓜得。\n空抱遗书，憔悴小楼侧。\n杜鹃不管人愁，月明枝上，直啼到、枕边相觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎","author":"刘过","text":"水浴芙蓉净。\n护浓香、迟开半敛，靓妆临镜。\n长忆耶溪薰风里，年少红颜照映。\n夜露冷、酒随香醒。\n回首当时同舟侣，为相思、怕折琼瑶柄。\n千万缕，意难罄。\n玻璃三万六千顷。\n洗精神、尘埃尽绝，夐然端整。\n浪蕊年来都慵问，爱此浓情淡性。\n待移种、灵根玉井。\n太一真人今何在，取高花、十丈供烟艇。\n来伴我，泛清影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其二 春思","author":"刘过","text":"院宇重重掩。\n醉沈沈、亭阴转午，绣帘高卷。\n金鸭香浓喷宝篆，惊起雕梁语燕。\n正一架、酴醾开遍。\n嫩萼梢头舒素脸。\n似月娥、初试宫妆浅。\n风力嫩，异香软。\n佳人无意拈针线。\n绕朱阑、六曲徘徊，为他留恋。\n试把花心轻轻数，暗卜归期近远。\n奈数了、依然重怨。\n把酒问春春不管。\n枉教人、只恁空肠断。\n肠断处，怎消遣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其六 赠邻人朱唐卿","author":"刘过","text":"多病刘郎瘦。\n最伤心、天寒岁晚，客他乡久。\n大舸翩翩何许至，元是高阳旧友。\n便一笑、相欢携手。\n为问武昌城下月，定何如、扬子江头柳。\n追往事，两眉皱。\n烛花细剪明于昼。\n唤青娥、小红楼上，殷勤劝酒。\n昵昵琵琶恩怨语，春笋轻笼翠袖。\n看舞彻、金钗微溜。\n若见故乡吾父老，道长安、市上狂如旧。\n重会面，几时又。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其五 赠张彦功","author":"刘过","text":"晓印霜花步。\n梦半醒、扶上雕鞍，马嘶人去。\n岚湿青丝双辔冷，缓鞚野梅江路。\n听画角，吹残更鼓。\n悲壮寒声撩客恨，甚貂裘、重拥愁无数。\n霜月白，照离绪。\n青楼回首家何处。\n早山遥、水阔天低，断肠烟树。\n谁念天涯牢落况，轻负暖烟浓雨。\n记酒醒、香销时语。\n客里归鞯须早发，怕天寒、风急相思苦。\n应为我，翠眉聚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其四 游西湖","author":"刘过","text":"睡觉莺啼晓。\n醉西湖、两峰日日，买花簪帽。\n去尽酒徒无人问，唯有玉山自倒。\n任拍手、儿童争笑。\n一舸乘风翩然去，避鱼龙、不见波声悄。\n歌韵歇，唤苏小。\n神仙路远蓬莱岛。\n紫云深、参差禁树，有烟花绕。\n人世红尘西障日，百计不如归好。\n付乐事、与他年少。\n费尽柳金梨雪句，问沈香亭北何时召。\n心未惬，鬓先老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其七","author":"刘过","text":"弹铗西来路。\n记匆匆、经行十日，几番风雨。\n梦里寻秋秋不见，秋在平芜远树。\n雁信落、家山何处。\n万里西风吹客鬓，把菱花、自笑人如许。\n留不住，少年去。\n男儿事业无凭据。\n记当年、悲歌击楫，酒酣箕踞。\n腰下光芒三尺剑，时解挑灯夜语。\n谁更识、此时情绪。\n唤起杜陵风月手，写江东渭北相思句。\n歌此恨，慰羁旅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其一 平原纳宠姬，能奏方响，席上有作","author":"刘过","text":"倦舞轮袍后。\n正鸾慵凤困，依然怨新怀旧。\n别有艳妆来执乐，春笋微揎罗袖。\n试一曲、琅璈初奏。\n莫放珠帘容易卷，怕人知、世有梨园手。\n钗玉冷，钏金瘦。\n烛花对剪明于昼。\n画堂深、屏山掩翠，炭红围兽。\n错认佩环犹未是，依约雏莺啭柳。\n任箭滴、铜壶银漏。\n一片雄心天外去，为声清、响彻云霄透。\n人醉也，尚呼酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其三","author":"刘过","text":"老去相如倦。\n向文君说似，而今怎生消遣。\n衣袂京尘曾染处，空有香红尚软。\n料彼此、魂销肠断。\n一枕新凉眠客舍，听梧桐、疏雨秋声颤。\n灯晕冷，记初见。\n楼低不放珠帘卷。\n晚妆残、翠钿狼藉，泪痕凝面。\n人道愁来须殢酒，无奈愁深酒浅。\n但寄兴、焦琴纨扇。\n莫鼓琵琶江上曲，怕荻花、枫叶俱凄怨。\n云万叠，寸心远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐多令","author":"刘过","text":"芦叶满汀洲，寒沙带浅流。\n二十年重过南楼。\n柳下系船犹未稳，能几日，又中秋。\n黄鹤断矶头，故人曾到否？\n旧江山浑是新愁。\n欲买桂花同载酒，终不似，少年游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 春晚书情","author":"刘过","text":"墙外濛濛雨湿烟。\n参差小树绿阴圆。\n残春中酒落花前。\n海燕成巢终是客，鳏鱼入夜几曾眠。\n人间一段恶因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 赠妓徐楚楚","author":"刘过","text":"黄鹤楼前识楚卿。\n彩云重叠拥娉婷。\n席间谈笑觉风生。\n标格胜如张好好，情怀浓似薛琼琼。\n半帘花月听弹筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"刘过","text":"谁把幽香透骨薰。\n韵高全似玉楼人。\n几时劝酒不深颦。\n竹里绝怜闲体态，月边无限好精神。\n一枝斜插坐生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三 留别","author":"刘过","text":"著意寻芳已自迟。\n可堪容易送春归。\n酒阑无奈思依依。\n杨柳小桥人远别，梨花深巷月斜辉，此情惟我与君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"刘过","text":"雾鬓云鬟已懒梳。\n君休乔木妾归欤。\n且来卖酒伴相如。\n骨细肌丰周昉画，肉多韵胜子瞻书。\n琵琶弦索尚能无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 赠妓","author":"刘过","text":"忔憎憎地。\n一捻儿年纪。\n待道瘦来肥不是。\n宜著淡黄衫子。\n唇边一点樱多。\n见人频敛双蛾。\n我自金陵怀古，唱时休唱西河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"刘过","text":"新来塞北。\n传到真消息。\n赤地居民无一粒。\n更五单于争立。\n维师尚父鹰扬。\n熊罴百万堂堂。\n看取黄金假钺，归来异姓真王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其二","author":"刘过","text":"秋兴恶。\n愁怯罗衾风弱。\n雨线垂垂晴又落。\n轻烟笼翠箔。\n休道旅怀萧索。\n生怕香浓灰薄。\n桂子莫教孤酒约。\n诗情浑落魄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其三 寿","author":"刘过","text":"霜树啼鸦，梅欲放、小春清晓。\n庆初度、佩环风外，笑声云表。\n一柱独擎梁栋重，十年整顿乾坤了。\n种春风、桃李满人间，知多少。\n功甚大，心常小。\n居廊庙，思耕钓。\n奈华夷休戚，系王颦笑。\n盟府山河书带砺，成周师何须周召。\n看貂蝉、绿鬓本天人，真难老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其二 高帅席上","author":"刘过","text":"敌面风轻，一两点、海棠微雨。\n春总在、英雄元帅，晓来游处。\n楼阁万家帘幕卷，江郊十里旌旗驻。\n有黄鹂、百舌啭新声，垂杨舞。\n寒食近，喧箫鼓。\n车马闹，铜鞮路。\n尽不妨沈醉，与花为主。\n风韵可将图画比，笑谈尽是惊人语。\n问何如、邹湛岘山头，陪羊祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"刘过","text":"宝鉴年来微有晕。\n懒照容华，人远天涯近。\n昨夜灯花还失信。\n无心更唱江城引。\n行过短墙回首认。\n醉撼花梢，红雨飞成阵。\n拌了为郎憔悴损。\n庞儿恰似江梅韵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一 赠张守宠姬","author":"刘过","text":"帘幕闻声歌已妙。\n一曲尊前，真个梅花早。\n眉黛两山谁为扫。\n风流京兆江南调。\n醉得白须人易老。\n老去侯鲭，旧也曾年少。\n后夜短篷霜月晓。\n梦魂依约云山绕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辘轳金井/四犯剪梅花 席上赠马佥判舞姬","author":"刘过","text":"翠眉重扫。\n后房深、自唤小蛮娇小。\n绣带罗垂，报浓妆才了。\n堂虚夜悄。\n但依约、鼓箫声闹。\n一曲梅花，尊前舞彻，梨园新调。\n高阳醉、玉山未倒。\n看鞋飞凤翼，钗梁微袅。\n秋满东湖，更西风凉早。\n桃源路杳。\n记流水、泛舟曾到。\n桂子香浓，梧桐影转，月寒天晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"糖多令/唐多令","author":"刘过","text":"解缆蓼花湾。\n好风吹去帆。\n二十年、重过新滩。\n洛浦凌波人去后，空梦绕、翠屏间。\n飞雾湿征衫。\n苍苍烟树寒。\n望星河、低处长安。\n绮陌红楼应笑我，为梅事、过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"糖多令/唐多令","author":"刘过","text":"芦叶满汀洲。\n塞沙带浅流。\n二十年、重过南楼。\n柳下系舟犹未稳，能几日、又中秋。\n黄鹤断矶头。\n故人今不在。\n旧江山，浑是新愁。\n欲买桂花同载酒，终不是、少年游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"刘过","text":"楼外云山千万重。\n画眉人隔小帘栊。\n风垂舞柳春犹浅，雪点酥胸暖未融。\n携手处，又相逢。\n夜阑心事与郎同。\n一杯自劝羔儿酒，十幅销金暖帐笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角","author":"刘过","text":"霜天晓角。\n梦回滋味恶。\n酒醒不禁寒力，纱窗外、月华薄。\n拥衾思旧约。\n无情风透幕。\n惟有梅花相伴，不成是、也吹落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祈雨泄潭","author":"刘佖","text":"未跃天衢卧寂寥，碧潭流溢海山腰。\n埋藏头角虽多日，鼓动风雷在一朝。\n既若有心成变化，岂能无意泽枯焦。\n神踪许为苍生起，愿击香车上九霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其十","author":"刘克庄","text":"作庆历诗赓石介，读开元报喜孙樵。\n自节蒉桴谐律吕，岂无木铎采风谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其九","author":"刘克庄","text":"圣主出矣千载遇，王言大哉万口夸。\n闻道朝廷却苞篚，更无方镇进鞭靴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其八","author":"刘克庄","text":"新擢咸淳两台端，可继庆历四谏官。\n安知千载无南董，异日求君谏草看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其七","author":"刘克庄","text":"遵新天子法永阜，为先皇帝服通丧。\n初元年素幄视草，千万世青史有光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其六","author":"刘克庄","text":"无春一点到田庐，有雪千茎上鬓须。\n昧爽小孙唤翁起，劝簪柏叶饮屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其五","author":"刘克庄","text":"伴壮丁骑秧马出，看儿童放纸鸢嬉。\n老无忧责庸非福，身是神仙不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其四","author":"刘克庄","text":"方坐皋比开讲肆，忽看傀儡至优场。\n此翁奇奇又怪怪，若非伪学即阳狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其三","author":"刘克庄","text":"痴呆已肖木鸡状，行走不减竹马时。\n太平期恰当今日，嬉戏翁浑如小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其二","author":"刘克庄","text":"俗情讳老难藏老，暮景添年是减年。\n举力田科虽殿后，序乡饮酒却居前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑元日口号十首 其一","author":"刘克庄","text":"三白吴中梅花雪，一穟海南沉水烟。\n劝汝杯酒令汝寿，著婆衫子拜婆年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其九","author":"刘克庄","text":"韩庙坡为记，罗池愈制碑。\n老农不识字，自唱送神诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其七","author":"刘克庄","text":"客屦自来去，山翁病不知。\n座无曲道士，门有艾天师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其六","author":"刘克庄","text":"时服颁周府，薰弦奏舜廊。\n未知新帖子，几首似欧阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其五","author":"刘克庄","text":"不喜追风骠，尤憎竞渡船。\n宁为之反殿，怕著祖生先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其四","author":"刘克庄","text":"唤起龙泉老，侬今把钓缗。\n还公旗与鼓，别付夺标人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其一","author":"刘克庄","text":"不曾窥户外，偶出至溪边。\n欲访斩蛟庙，聊呼放鸭船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其三","author":"刘克庄","text":"餐菊饮朝露，平生不歠醨。\n与龙争角黍，无乃谤湘累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其八","author":"刘克庄","text":"儿女需京缬，经时买未归。\n似嫌无艾虎，不肯换生衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其十","author":"刘克庄","text":"朝朝责太平，日日御延英。\n欲识太平处，鼕鼕社鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯端午十绝 其二","author":"刘克庄","text":"桃李已成尘，葵榴各斗新。\n红颜年少子，白发背时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁巳启建二首 其二","author":"刘克庄","text":"有意祝灵椿，无堪献野芹。\n玉杯真缪巧，金镜最忠勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁巳启建二首 其一","author":"刘克庄","text":"一息营升斗，留翁寂寞滨。\n白头携暮子，来作祝尧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其十","author":"刘克庄","text":"□□戴白苍头丑，笔秃无花藻思枯。\n惟有春风不知老，年年傅粉又施朱。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其九","author":"刘克庄","text":"昔日寒檠曾万卷，暮年晓镜有千丝。\n人言晚节高初节，自喜新诗胜旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其八","author":"刘克庄","text":"物贵皆缘自币轻，丝身谷腹费经营。\n公卿文学方矛盾，黔首何时见太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其七","author":"刘克庄","text":"别墅棋边勍敌破，上流帐下捷书飞。\n几年二虎争雄长，一剖为羓一遁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其六","author":"刘克庄","text":"礼成虽曰非常庆，圣敬居然不已纯。\n玉女宓妃犹屏欲，先开梅厦访儒臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其五","author":"刘克庄","text":"帝服尧丧礼制终，南衙万玉贺廷中。\n遥知祝了三宫寿，相率回班贺相公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其四","author":"刘克庄","text":"北关南荡霁华开，辇御端门肆眚回。\n野老相逢谈圣德，散斋蔬素到燔柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其三","author":"刘克庄","text":"五畤初行禋类礼，万金难买岁朝晴。\n老臣纵有甘棠颂，未必朝廷记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其二","author":"刘克庄","text":"瞎翁九起茅檐下，失喜繁星满树梢。\n想泰元尊衰景贶，知新天子讲初郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁卯元日十首 其一","author":"刘克庄","text":"真率会居同社长，屠苏酒让一家先。\n垂髫孙各欣新岁，华发翁偏惜旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]