[{"title":"诗呈同院诸公 其三","author":"张耒","text":"我愧言诗赐，公真好学回。\n雠书芝阁上，藏史楚山隈。\n把酒论交里，连房校艺来。\n知君怀水镜，依赖免遗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日同文馆诗 其二","author":"张耒","text":"声鸣皆出谷，觜距各争场。\n铁网收明月，霜铓倒豫章。\n湛恩终锡宴，优礼合焚香。\n最苦雠书客，消愁赖杜康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日同文馆诗 其三","author":"张耒","text":"六街分夜鼓，邻屋报朝鸡。\n寒引秋初老，天将斗转西。\n滞留聊饮酒，谈笑亦分题。\n须信家居乐，休嫌穷巷泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春独酌有感 其二","author":"张耒","text":"谁谓我无友，萧然山谷间。\n修竹乃佳客，清风如妙言。\n撷彼林间笋，致酒方池边。\n惟时春服成，花叶犹斑斑。\n月出我已醉，扶归不知眠。\n洒然中夜醒，起听西涧泉。\n世累乍去念，放歌心浩然。\n功名付长啸，持用乐目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵苏内相好头赤","author":"张耒","text":"世无将军飞食肉，宛马不来鞭费竹。\n赤驽当御亦偶然，冀北此曹量计谷。\n惭愧蒲梢汗流赤，翻鬣胡风嘶汉日。\n麒麟不合地上行，谁道风云未经历。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同晁郎及秬秸步游乾明晚逾柯山归","author":"张耒","text":"野水菰蒲秀，荒陂荠麦长。\n卑田留积雨，荒寺掩斜阳。\n远树连云梦，群山近武昌。\n言归日已夕，村径度牛羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效白体赠晁无咎 其二","author":"张耒","text":"江南岁晚水风寒，铃阁无人昼掩关。\n过雨楼台宛溪市，新霜松竹敬亭山。\n不悲仕宦从来拙，所喜形骸绝得闲。\n山妓村醪君莫笑，亦胜苜蓿满朝盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效白体赠晁无咎 其三","author":"张耒","text":"关河战国东秦地，风月南朝小谢城。\n妓乐比君拈不出，溪山许我赌来赢。\n真珠金线真无比，叠岭双溪亦有声。\n一事与君霄壤别，板舆时从老人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡香花","author":"张耒","text":"曾向庐山睡里闻，香风占断世间春。\n窃花莫扑枝头蝶，惊觉南窗半梦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"张耒","text":"清霜夜漠漠，佳食晓累累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十七","author":"张耒","text":"亭亭古柏不知年，天宝以前耆旧传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"张耒","text":"饥鸢跕跕下林隈，猜意鹓雏夺鼠来。\n瞥映斜阳上茅栋，块如眠草坐毰毸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"薛昂","text":"逢时可谓真千载，拜赐应须更万回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪","author":"刘延世","text":"冥冥花朵隔遥山，脉脉风烟暗百蛮。\n曾向黄陵嘲竹里，羽毛犹带泪痕斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"陈瓘","text":"看花出约几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上联句","author":"苏京","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈九首 其八","author":"释惟清","text":"三世诸佛，不知有恩无重报。\n狸奴白牯，却知有功不浪施。\n明大用，晓全机。\n绝踪迹，不思议。\n归去好，无人知。\n冲开碧落松千尺，截断红尘水一溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翛然元规夜坐酌余德儒所惠酒因成联句","author":"石元规","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言再咏","author":"石元规","text":"诗见张继先三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同游栖真联句","author":"石元规","text":"诗见张继先三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祷雨应时喜而联句","author":"石元规","text":"诗见张继先三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浑沦庵成翛然子亲庆因以何字为韵共酌联句","author":"石元规","text":"诗见张继先三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樱桃","author":"赵企","text":"王母阶前种几株，水晶帘外看如无。\n只应汉武金盘上，泻得珊珊白露珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈恬","text":"雪里消磨一半春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东津夜饮送岑穰彦休赴阙 其二","author":"李廌","text":"风林舞危叶，霜畦杀青蕡。\n车马如上州，朝天逐高云。\n行迈岂不劳，欲书竹帛勋。\n岁晏重感慨，我独念离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同诸公饯望元因宿谷隐以何当风雨夜复此对床眠为韵分得对此二字 其二","author":"李廌","text":"秋江冒后土，馀潦满沟浍。\n行人泥没辀，腐黍乱荒荟。\n结客山中游，风雨在颠沛。\n峥嵘栋宇下，磊落宜我辈。\n还同竹溪逸，笑傲盼庭桧。\n繁阴阻杖屦，曀曀几弦晦。\n谁能决顽云，共此明月对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同仲宝风雨中过德麟留宿以夜未央为韵分得未字并和二公夜央字韵 其二","author":"李廌","text":"秋徂风雨多，欲作雪霜迓。\n况乃地气偏，寒暑或相借。\n温凉久未定，裘葛易无暇。\n惭愧平原君，客至列盏斝。\n日为文字饮，短昼继清夜。\n嗟予寡世偶，痴甚已如霸。\n有田未归耕，无策敢求射。\n耽诗近知味，疑从果裸化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同仲宝风雨中过德麟留宿以夜未央为韵分得未字并和二公夜央字韵 其三","author":"李廌","text":"敢友天下士，辙环之四方。\n适愿得所向，偶如钟应霜。\n交态久未定，市道良可伤。\n君看江汉水，安流日泱泱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同张公硕梅耕道访董畸老郊居 其二","author":"李廌","text":"㶏水官桥路，将军甲第新。\n绿沉閒结锈，棐几净无尘。\n下榻喜宾至，问田怜我贫。\n相逢便倾倒，晚岁定情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同张公硕梅耕道访董畸老郊居 其三","author":"李廌","text":"青云两高士，肯伴老夫游。\n方驾相追逐，通宵复献酬。\n诗书嗟失计，农圃话良谋。\n日后耦耕伴，悬知总白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨日之日","author":"晁说之","text":"昨日之日梦可追，今日之日愁能迟。\n日之授谢亦何有，但莫令吾忠信亏。\n但莫令吾忠信亏，家山北斗身海湄。\n脍鲸斮蛟既不得，虾虫腥咸安用之。\n难将短发留长恨，山中好在鸡黍期。\n有船载书复归去，高谊解释幽林思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子初伏前一夕大雨","author":"晁说之","text":"雨来夜早晚，梦断惊所向。\n鼓鼙声后先，龙蛇势下上。\n奈此老屋何，诗书果何当。\n幸矣托皇州，高枕得无恙。\n瑞物日纷纭，岂我独飘荡。\n兴言反山楹，羸思辄以张。\n疏泉到云根，松竹青益放。\n胡不返柴车，于焉事郁怏。\n平生知顾行，短发增惆怅。\n明朝入初伏，金火两无恙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和江子我卧病谢予相过之作","author":"晁说之","text":"弃妇不言贫，孤儿不知病。\n美疹亦何有，衰莲披绿净。\n大易疾无妄，要且观情性。\n我来自山中，非征亦非聘。\n但恨清风薄，安识皇都盛。\n况闻药艾攻，之子骇观听。\n策羸七里湾，忧醉岂易醒。\n今兹早尝馔，高人能自胜。\n不废五字吟，久与金石称。\n我老言亦衰，同鸣不相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以李约交游晚岁重为韵作五绝句别韩二十七 其五","author":"晁说之","text":"少贵别离轻，老贱别离重。\n后日君亦老，我发亦种种。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓬莱仙","author":"晁说之","text":"我是蓬莱山上客，暂到人间管春色。\n谢家池馆纵吟魂，卓氏酒炉迷醉魄。\n人间春色将奈何，潋潋滟滟浓如波。\n归来说与秦王女，麻姑偷去唱为歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屈原石板上见圆机题诗因和之","author":"晁说之","text":"门掩自閒閒，樽空宁薄薄。\n妙语知杜美，刚肠识雷恶。\n饶花人岂贫，多竹地不薄。\n最道长官难，只愁里胥恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和二十二弟不相遇之作","author":"晁说之","text":"秋云欲遘雨，恼此山河凉。\n柴门试一出，矫目叹林光。\n孔鸾势自远，鸿雁意亦长。\n先后日云间，俗眼安得常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"说之方忧韩公表大夫疾遽致仕乃蒙传视送陈州王枢密诗十首意典辞丽忻喜辄次韵和呈以公若登台辅临危莫爱身为韵 其三","author":"晁说之","text":"颍川美凤凰，淮阳盛股肱。\n皇恩既布濩，清羸亦作兴。\n自知同泾渭，孰觉异鴳鹏。\n巍巍君子堂，而我得先登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴鄜州京郑间途中作","author":"晁说之","text":"园林叶落丹丘远，坂路霜寒白发侵。\n不是关西将家子，也无诗思著秦音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过汉武望仙宫在鄜寺之西三绝句 其三","author":"晁说之","text":"黄金无限不须成，欲塞河流要负薪。\n谁识望仙宫里事，只因荡漾阿娇春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵任伯途中见寄 其二","author":"晁说之","text":"白头青简负三馀，得丧穷通不问渠。\n但恐风霜侵尔稼，敢期盗贼避吾闾。\n秋蝉冬蝶空离恨，渭水秦山政索居。\n何日离合南北史，倩君成就一家书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事谢子之二绝句 其一","author":"晁说之","text":"何妨少日不能容，讵玷山公启事中。\n庭下秋风收不得，欲彫琼树未听从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事谢子之二绝句 其二","author":"晁说之","text":"悦己曾增巧笑容，舞鸾归歇鉴花中。\n人间遇乐便作乐，何用行军问所从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"揽古","author":"晁说之","text":"揽古茫茫涕泪频，谁教末路尚沈沦。\n青山会有为尘日，紫陌曾无不死人。\n王莽历期馀数在，董贤恩幸几番新。\n只应不武空憔悴，自有长歌薇蕨春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高二承宣以长句饷新茶辄次韵为谢 其二","author":"晁说之","text":"信美江山非我家，兴亡忍问后庭花。\n明时不见来求女，俭德唯闻罢贡茶。\n鹢首千重能破浪，马蹄万里正便沙。\n烦君识取人才尽，白首飘零漫海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"合江亭 其二","author":"周焘","text":"却暑追随水上亭，东郊乘晓戴残星。\n馀歌咽筦来幽浦，薄雾疏烟入画舲。\n兴发江湖驰象魏，情钟原隰咏飞令。\n故溪何日垂纶去，天末遥岑寸寸青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送头陀赴庐山寺","author":"郑常","text":"僧家无住著，早晚出东林。\n得道非真相，头陀是苦心。\n持斋山果熟，倚锡野云深。\n溪寺谁相待，香花与梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙兴仁王佛舍纳凉联句十六韵","author":"潘仲宝","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙兴仁王佛舍纳凉联句十六韵","author":"谢公定","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十五","author":"释子淳","text":"金佛不度炉，妙相圆明会也无。\n泥佛不度水，落落圆音美复美。\n木佛不度火，萧萧古殿无关锁。\n是须撒手直归家，莫向半途空懡㦬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽十六叔父朝散 其二","author":"晁冲之","text":"翰墨传名教，公深有世风。\n斯文今乃丧，吾道亦何穷。\n埋玉嗟何及，挥金乐未终。\n子孙知心盛，断狱有阴功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"晁贯之","text":"草堂不见杜陵老，折得青松度水归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"刘旦","text":"膺门昔忝登龙客，董墓今悲下马人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋蝇","author":"邹浩","text":"秋风快如刀，着木木欲折。\n蕃鲜转凄凄，入眼无一悦。\n青蝇独何为，飞鸣犹未灭。\n造化本无私，尔生亦偶窃。\n念方三伏中，日车午停辙。\n下照人世间，何异红炉热。\n劲鸟倦戢翼，狞兽喘吐舌。\n惟人于此时，体懈剧疲薾。\n虚堂幸可逃，枕簟随意设。\n好睡边韶同，素懒稽康埒。\n更此值清凉，酣寝谓须决。\n双睫才欲交，汗肤遭尔齧。\n营营不绝声，宛类谗口呐。\n使我寝不安，欲息还复挈。\n况如一箪贫，未能万钱歠。\n园蔬荐脱粟，杯盘殊灭裂。\n双箸才欲拈，咀嚼遭尔餮。\n适从何处来，食饮污修洁。\n使我味不甘，欲咽还复噎。\n驱除付疲兵，祗足增跛蹩。\n宜哉孙权弹，为尔情激切。\n期望秋风回，一扫无馀孽。\n偶此延朝昏，勿谓风不烈。\n气候侵凝凛，龙蛇且藏穴。\n尔形大豆然，岂能坚如铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李光道承事罢高邮酒官","author":"邹浩","text":"豫章拂青冥，密荫覆百亩。\n初由拱把微，封植岁月久。\n大厦搜栋梁，匠者终见偶。\n甘井如车轮，千寻彻坤厚。\n畚锸非一朝，致力自培塿。\n河流涸生尘，源源独清浏。\n李子素绮纨，操约世莫诱。\n字画尤劲奇，往往过虞柳。\n当其求帖时，彷佛昔人呕。\n吾惟蜩翼知，岂暇恤众口。\n愿言举斯心，夙昔仁义薮。\n甘井与豫章，勿使擅所有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送楼谦中赴江州德化主簿","author":"邹浩","text":"忆昨随侍游鄞川，穷探欲上苍崖颠。\n峥嵘古寺忽邂逅，眸子顾我惊瞭然。\n子时苫块惨无意，挥麈岂暇论幽玄。\n星离雨散已五载，谁谓此地方周旋。\n胸中突兀富经史，欬唾落纸珠玑圆。\n明明君王正侧席，何事版籍从拘挛。\n匡庐胜槩半境内，足以寄傲追前贤。\n穿云漱涧遍所历，妙句流落人间传。\n却来隐几北窗下，博山深炷沉香烟。\n细观身世究竟处，何者当好何当捐。\n纷纷万事付一笑，聊复尔耳姑随缘。\n吁嗟二轮挽莫住，愿子于此同勉旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠茅山范道人","author":"邹浩","text":"道人本是红尘客，曾把锥刀闹胸臆。\n一朝矫首看冥鸿，弃子捐妻人莫测。\n三茅峰北华阳南，凌乱烟霞閟殊特。\n筑庵寄傲知几年，但见日月忙如织。\n饥餐落英饮沆瀣，策杖溪云随降陟。\n蟾辉倒射松风寒，长啸一声山欲辟。\n飘然行止信自由，或到人间蹑人迹。\n朱门瓮牖初不分，遇酒辄倾论斗石。\n有时巧发惊四筵，季主犹惭多失策。\n纷纷流俗争称奇，岂识道人真所适。\n茅君仙去空遗踪，高行三千当自积。\n琴閒棋罢幸相过，却恐鸾飞无处觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋司理赴吏部","author":"邹浩","text":"古木暗长堤，清涟涨轻縠。\n南风聒乌樯，动子归兴速。\n今日共一樽，明朝各川陆。\n我心久已灰，惨怆辄眉蹙。\n鲍叔实我知，嵇康亦子熟。\n少年挺奇姿，绮丽诱莫逐。\n抑首掾雄藩，哀矜见推鞫。\n季文每三思，石庆惧谴戮。\n多事如不胜，投刀斯中族。\n重华虽前旒，疏逖无隐伏。\n杂遝登俊良，能官真棫朴。\n行看万里涂，追电恣腾蹴。\n赫赫继家声，勿忘勤圣读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登召伯斗野亭用孙莘老韵寄秀老参寥","author":"邹浩","text":"广陵最佳处，堂与南山平。\n慨然寄远瞩，溷浊为冰清。\n冷官从无徒，犹阻窥朱甍。\n矧兹斗野构，名实久已倾。\n距我逾一舍，何由偕友生。\n王事有邂逅，川途假新城。\n登亭若为慰，饥渴甘大烹。\n莲花袭襟裾，双鹤唳且行。\n一笑发深省，坐见星斗明。\n回首莫逆交，物外正采荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄楼谦中","author":"邹浩","text":"三年客扬州，鄙吝谁与晤。\n美人海上来，青眼独余顾。\n荒凉吊遗踪，每每参杖屦。\n败意无俗物，欣快平生遇。\n陶丘今杜门，习懒殆成痼。\n麈尾挂壁间，琴书自朝暮。\n匡山正倚天，枕漱实幽趣。\n清壮增茟力，重规谪仙句。\n相望越千里，款段不获驱。\n何当继畴昔，把手论情素。\n惟有月下桐，秋声已如故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效十二属体","author":"邹浩","text":"区区鼯鼠技不优，鼓刀要使无全牛。\n力探虎穴必有获，纵如兔窟焉能谋。\n好龙既久乃龙至，画蛇添足岂蛇侔。\n骢马御史风烈在，瘦羊博士声名流。\n棘端犹作刻猴用，宝鼎忽患烹鸡求。\n相狗他年会见赏，牧豕海上非吾忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感年","author":"邹浩","text":"一世三十年，我今二十九。\n昔人当此时，事业已不朽。\n颜渊语心斋，瞠若夫子后。\n著录盈三千，独居四科首。\n荀彧王佐才，智略子房偶。\n脱身作谋主，谈笑解纷纠。\n元宾与习之，二李相左右。\n复命索玄微，词章配韩柳。\n夙成更超伦，初不愧黄耇。\n项橐实可师，仲尼安敢友。\n孔融登龙门，元礼接弥厚。\n叔度千顷波，能使荀淑忸。\n陈蕃置一室，誓涤天下垢。\n贾谊入朝廷，号咷动明后。\n陆机文赋成，见者咸敛手。\n祢衡孰比俊，帝室宜见受。\n李贺锦囊中，佳句敌琼玖。\n相望编简上，灼灼列星斗。\n而我独何人，拟之一无有。\n追维故时事，浃背汗如浏。\n穷年坐井底，曾不辨齑臼。\n多岐既亡羊，画虎欲类狗。\n狂澜傥不回，何以刷兹丑。\n吁嗟岁律逝，易于屈伸肘。\n分阴所当惜，来者勿复苟。\n譬彼力田子，耘锄肯卤莽。\n所期嘉苗成，不使乱于莠。\n血气况方刚，龙钟未为叟。\n高名非我心，没齿庶无咎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]