[{"title":"与成父自信同舟到饶分路而别以诗送之三首 其二","author":"赵蕃","text":"我自飘零更汝忧，贱贫骨肉不相收。\n马家堤上休停骑，愁有居民说故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与成父自信同舟到饶分路而别以诗送之三首 其一","author":"赵蕃","text":"川行历览不知劳，我有新诗听汝抄。\n今日语离还索句，况堪风雨满江郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李衢州峄四首 其四","author":"赵蕃","text":"洪井登龙记昔年，祇今太末又行缠。\n馀波所及盖多矣，一夜水高溪有船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李衢州峄四首 其三","author":"赵蕃","text":"黄尘扑扑倦征途，忽雨能来快洗苏。\n旱接夏秋才得此，一身宁敢叹沾濡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李衢州峄四首 其二","author":"赵蕃","text":"跨驴冲晚背常山，急雨飞来瞬息间。\n问讯元从禹迹洞，我家虽近却愁悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李衢州峄四首 其一","author":"赵蕃","text":"忽逢旗鼓去翩翩，道上行人喜欲颠。\n为说吾州新得雨，使君惠政实关天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与欧阳伯威同饮遇卿江楼","author":"赵蕃","text":"不上江楼又两春，人间到处略知津。\n劳君置酒仍呼客，快语端能洗劫尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与硕父沈弟伯仲晚行河堤硕父欲作小亭于其上且云西南得山最多即其语作绝句","author":"赵蕃","text":"断水桥横独木过，西南尽处得山多。\n自嗟不及儿童乐，横笛骑牛稳下坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"口占简去非","author":"赵蕃","text":"春风春雨急仍颠，闻道远劳从事贤。\n软脚不应惟命酒，池塘生草要新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夕庵观吴寿宁画","author":"赵蕃","text":"樛木蟠崖错节深，拍天风浪捲江心。\n有人来问夕庵境，万里孤云无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大风二首 其二","author":"赵蕃","text":"颇爱峡江江上山，几回陶冶付毫端。\n眼中谁为善图貌，貌与桐江相并看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大风二首 其一","author":"赵蕃","text":"杯水得风犹渺然，况兹章贡远连天。\n一穷坐我靡他问，下水宁闻劳挽牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中四绝句 其二","author":"赵蕃","text":"去年徂暑桃源过，今岁秋高到武夷。\n不遇名山一来访，箧中宁有此山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中四绝句 其四","author":"赵蕃","text":"欲访武夷毛洞竹，路穷九曲更山深。\n道人知我衰无力，乞与一枝酬素心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中四绝句 其一","author":"赵蕃","text":"桃源政自人间世，山故苍苍水故流。\n不是幔亭张席地，卒然风雨卷山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中四绝句 其三","author":"赵蕃","text":"武夷仙伯定能诗，解赏仙人张湛词。\n更诵人间可哀曲，飘飘亦复动人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行见野樱桃花","author":"赵蕃","text":"徐行历历转深豅，人意何如鸟语同。\n山路梅花浑扫迹，春风尽属野樱红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己亥十月送成父弟絜两户幼累归玉山五首 其五","author":"赵蕃","text":"十月江行多北风，打头不用怨天公。\n清音堂下换船处，想见挂帆滩已空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己亥十月送成父弟絜两户幼累归玉山五首 其四","author":"赵蕃","text":"误身何必叹儒冠，粗粝须甘苜蓿盘。\n瓜地可耕归独负，未应真坐缚微官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己亥十月送成父弟絜两户幼累归玉山五首 其三","author":"赵蕃","text":"造物知君时欲进，江山佳处遣频回。\n霜风日夜摧摇落，面目端须见本来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己亥十月送成父弟絜两户幼累归玉山五首 其二","author":"赵蕃","text":"去岁归营丘嫂葬，今年那复以家行。\n挽须无用祇嗔喝，念我只儿同短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己亥十月送成父弟絜两户幼累归玉山五首 其一","author":"赵蕃","text":"已办知津送去舟，重临快阁亦悠悠。\n黄知橘柚江行好，此去况经龙雾洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋寄上饶赴试亲友池阳当涂三沈弟","author":"赵蕃","text":"中秋佳月去年同，卧病还应记此翁。\n不但婵娟千里共，客游俱在大江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为龙泉令赵舜徒题","author":"赵蕃","text":"诚能得初心，何必返初服。\n有以固中扃，不须防外逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书双径铺","author":"赵蕃","text":"昔者曾看紫柞花，今焉梅谢柳生芽。\n无穷甲子随车毂，有限光阴属鬓华。","collection":"宋","notice":"","provenance":{"repo":