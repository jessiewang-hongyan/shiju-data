[{"title":"送刘元圭","author":"李流谦","text":"犯寒过我喜仍惊，节物峥嵘更远程。\n剧饮投车轻十日，细谈剪烛易三更。\n故人高义千钧重，久客归心一夜生。\n为语溪翁好相念，时将蓑笠晒春晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙宾老守三池二首 其二","author":"李流谦","text":"百万貔貅尚枕戈，将军未复旧山河。\n非干使者徵求急，正柰穷边饷挽何。\n颇愿有言先牧养，不妨自署拙催科。\n公馀傥暇寻遗事，尘锁荒祠望刮摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙宾老守三池二首 其一","author":"李流谦","text":"自艺心田岁自收，天翁两眼月临秋。\n近臣荐鹗方成表，吉梦逢刀遂得州。\n吏术无多非问马，机心已尽不惊鸥。\n三溪便是桃源路，更欲武陵何处求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送牟孔锡之官叙南二首 其二","author":"李流谦","text":"得朋宦游乐，不觉在山中。\n惯住家乡似，频过骨肉同。\n凭栏但烟树，振袂忽霜风。\n远别无穷意，君归我已东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送牟孔锡之官叙南二首 其一","author":"李流谦","text":"凌云高鹄峙，掷地响金浑。\n蟾窟声名早，鳌峰气象尊。\n十年才一试，万里正孤骞。\n勿说居夷陋，吾师有格言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何子闻使君之行在","author":"李流谦","text":"系舟邻近渚，索酒共清斟。\n契阔十年事，飘零万里心。\n大门元赫赫，要路正骎骎。\n去国吾何恨，看君上禁林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张子勤九陇尉","author":"李流谦","text":"老凤高栖雏凤飞，山林钟鼎各相宜。\n出门马首亭亭去，敛板胸中落落奇。\n颇忆浊醪过我夜，正愁碧草送君时。\n如何数日中年味，恰是今朝闻子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张仲山守唐安二首 其二","author":"李流谦","text":"南浦波轻草色微，蹇驴遥路独依依。\n暖风旌旆春随去，细雨犁锄麦正肥。\n驿骑蚤闻催迅召，边屯犹未解重围。\n谢家父子名江左，折屐行看破贼归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张仲山守唐安二首 其一","author":"李流谦","text":"六十专城发未斑，更于何地觅三山。\n不妨谈笑催科里，正赖清凉热恼间。\n到日红梅留腊在，公馀翠杓酌春悭。\n胡床有月堪乘兴，客到南楼不下关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李仁甫运判赴召三首 其三","author":"李流谦","text":"瞿塘六月浪，如马亦安流。\n舟楫鱼龙喜，藜蒿虎豹忧。\n低回嗟薄宦，慷慨动商讴。\n门户今如线，非为粱稻谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李仁甫运判赴召三首 其二","author":"李流谦","text":"累岁徵贤诏，于今始一来。\n已令人意满，更著驿书催。\n白璧有成价，蛾眉无巧媒。\n经纶夙昔事，吾驾不须回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李仁甫运判赴召三首 其一","author":"李流谦","text":"嵩岱国之镇，凤麟天所生。\n有人占宝气，无耳著修名。\n斯道自神圣，尔曹聊重轻。\n晋书定一付，一代听权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李阆州二首 其二","author":"李流谦","text":"少陵曾赋阆州诗，苦说城南天下稀。\n铃閤讼閒帘半卷，胡床客好麈频挥。\n著鞭尚及春耕劝，促诏应随晓仗归。\n他日遗簪犹在念，端容杖策扣黄扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李阆州二首 其一","author":"李流谦","text":"耳熟才名四十年，忧民忧国两华颠。\n不妨铜竹仍三剖，要是金门竟九迁。\n连岁炉锤专造化，诸生岐路托飞骞。\n馀丹乞与閒鸡犬，亦许身随绛阙仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨道父二首 其二","author":"李流谦","text":"遂决乘桴计，初无判袂愁。\n清樽聊把手，弱缆已开头。\n懿戚今元老，乡邦子俊流。\n等閒垂一臂，谈笑上瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨道父二首 其一","author":"李流谦","text":"骨清殊矫矫，气老自沉沉。\n门户托君重，江湖入梦深。\n功名须少壮，岁月惜侵寻。\n万里相随去，庭闱一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送查总卿三首 其三","author":"李流谦","text":"腊雪千江浪，春风万里船。\n相依身健在，远送意茫然。\n公近此三接，吾惊失一天。\n相君如辱问，愿报已归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送查总卿三首 其二","author":"李流谦","text":"御炉薰隔夜，清跸响凌晨。\n对罢天颜喜，朝回赐服新。\n自期宜栋干，小却尚丝纶。\n此论由来久，周行万搢绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送查总卿三首 其一","author":"李流谦","text":"事业参亭毒，人才兆废兴。\n百年争凤睹，一遇慨河澄。\n手到无盘错，旁观有级层。\n夜来春梦好，先已上觚棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送家连父解绵竹丞","author":"李流谦","text":"猿臂将军数自奇，白头州县竟何为。\n斲墁未尽成风巧，测管才窥泽雾姿。\n流水绕除空日日，西山拄笏谩时时。\n一杯相送贫无力，剩有新诗说去思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱太虚同年","author":"李流谦","text":"不隔同年面，真情本弟兄。\n人能纯白备，交自始终成。\n测管才窥豹，倾江试吸鲸。\n吾言蓍蔡验，决矣看飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送崔子渊秘丞出守小益二首 其二","author":"李流谦","text":"晋公幕府总豪英，末至非才愧长卿。\n已去化炉金尚跃，更分客袂涕空横。\n早催剑栈迎千骑，更借湖山劝一觥。\n水自嘉陵流到海，尺书应有故人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送崔子渊秘丞出守小益二首 其一","author":"李流谦","text":"宝峰山下识君初，岂但声华在石渠。\n海上三山元咫尺，人生五马少踌躇。\n鼎钟事业那能免，丘壑情怀自觉疏。\n安得一帆相逐去，故园春雨长新蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄仲秉侍郎出守镇江 其一","author":"李流谦","text":"十年朝露厌鸣珂，华发萧萧奈倦何。\n鸾翮九霄穿日月，龙骧万斛饱风波。\n古人不见吾犹梦，直道能行恨亦多。\n驷马锦衣儿辈事，只须持此答岷峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程叔虞监税","author":"李流谦","text":"吾来真漫尔，识面喜周旋。\n两月连墙住，孤帆别袂牵。\n人生同宇宙，官学各风烟。\n把酒知何日，临流一惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢天奇赴淮上之招","author":"李流谦","text":"今日论形胜，全淮正上流。\n老成资毕召，俊异集枚邹。\n共说从军乐，休歌出塞愁。\n乡邦饶杞梓，君已拔其尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏德源守普慈二首 其二","author":"李流谦","text":"东梓名州最普州，蟆颐相望气横秋。\n青衿胄子迎高朕，竹马儿童识细侯。\n只有爱民心尚在，可能忧国泪空流。\n摩挲疲瘵无多事，绿野家家剑换牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏德源守普慈二首 其一","author":"李流谦","text":"一毫不露见全身，德觇徵符捷若神。\n嵩岱自高元地势，球琳非琢本天真。\n出山聊作无心润，著物应名有脚春。\n唤作使君犹未解，岂知游戏两朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏德源倅永康","author":"李流谦","text":"晚岁从谁觅赏音，浪将孤兴托瑶琴。\n聊为风月平分客，莫起山林独往心。\n碧草但能供别恨，黄花却解劝清斟。\n我犹未制思亲泪，更听离歌定不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳前一日仲明见过留之以州会辞作此示之","author":"李流谦","text":"黄菊金钱小，红萸锦纽香。\n滞留成久客，邂逅作重阳。\n胜友几相值，清尊聊共尝。\n吾宗惯城府，幽兴负沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳偶成","author":"李流谦","text":"百尺危楼倚瘦藤，轻阴小令正秋深。\n山云洗刷供晴眺，杯酒飘浮笑浅斟。\n漠北烽烟空抵掌，水南松竹每经心。\n红萸紫菊誇强健，醉帽无人独自簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射洪道中二首 其二","author":"李流谦","text":"远墟行蔼蔼，滞绪豁欣欣。\n挟翠山能润，矜晴草自薰。\n堕鸢那及叹，飞鹭可堪群。\n欲共江流说，滔滔故不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射洪道中二首 其一","author":"李流谦","text":"晓色仍过雨，残钩不挂天。\n空霏漫野迥，净绿浸江鲜。\n何自有灵鹊，谁言无杜鹃。\n倚风搔首意，窈窕若为传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张主簿 其二","author":"李流谦","text":"楚楚桐孙秀，愿交惭不量。\n新诗吾退舍，前辈子登堂。\n刮目鲸掀海，经年骥伏箱。\n斯言傥不验，我欲罪穹苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张雅州 其二","author":"李流谦","text":"三年流落塞垣春，雪屋冰庐乐藻芹。\n司业颇知怜郑老，薛宣能不吏朱云。\n鹗笺重剡新如昨，蚁壤高眠唤不闻。\n一掬垄头知己泪，霜风吹堕白杨坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张雅州 其一","author":"李流谦","text":"酣饱风烟德有芽，从来三戟是张家。\n翩翩群从同时贵，落落高门一世华。\n人自不欺宁用忍，身如可赎但空嗟。\n路人泣指飞丹旐，犹忆双旌卷暝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽杨彦序","author":"李流谦","text":"长忆君家得隽多，庭前桂树想婆娑。\n岱云触石才肤寸，溟浸稽天但一波。\n颇欲弛韝观纵击，可堪伏枥起悲歌。\n人生泡焰都难据，惟有丰碑屹不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽费检正 其三","author":"李流谦","text":"忆作荆州客，多惭鲍叔知。\n苍黄悬榻地，恸绝盖棺时。\n映睫馀残泪，亲肤有近期。\n空山那得去，倚杖鬓如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽费检正 其二","author":"李流谦","text":"瑶墀邻近侍，华戟老方州。\n闭閤人无讼，凝香岁自秋。\n凶衰乘鵩集，涕泪感麟休。\n古佛知公恨，涪江不尽流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽费检正 其一","author":"李流谦","text":"钩深三古学，遇合百年机。\n垂上青云去，仍完白璧归。\n功名身易老，豪杰意多违。\n鼎脔留馀啖，蒸青有发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽秦国夫人 其二","author":"李流谦","text":"赉说端由帝，生申未许崧。\n神功资鍊石，吉梦托占熊。\n赫赫扶天业，堂堂浴日忠。\n芝麟昭圣瑞，何力赞元工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽秦国夫人 其四","author":"李流谦","text":"伴涣方兴日，忧危未决前。\n伪书知莽诈，新历断周延。\n冰作群疑泮，风从一语传。\n龟灵无此识，上智炳机先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽秦国夫人 其五","author":"李流谦","text":"露莲秋沼瑩，霜月晓潭空。\n褕翟翻经外，尘泡隐几中。\n禅心安瘴峤，结习谢云栊。\n五颂分明说，痴人耳自聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽秦国夫人 其六","author":"李流谦","text":"久矣鸿飞渚，翩然雁字峰。\n九重疏异渥，万里合幽封。\n引柩乌衔壤，驯阡鹿护松。\n他时人下马，有子是夔龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽秦国夫人 其三","author":"李流谦","text":"华笄谐淑配，绿发负平生。\n桃李春如寄，鸥鹇梦不惊。\n周婺惭绝识，蜀寡让孤情。\n口授天人学，寒窗伴短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽秦国夫人 其一","author":"李流谦","text":"鸾衿荣翠栝，璇魄媚方流。\n庆袭高华出，贤供窈窕求。\n灵光分婺照，静质肖坤柔。\n闺闼关何事，风人美造周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郭敦复","author":"李流谦","text":"太少城中敛板初，识公鸾鹄自清癯。\n持心要是忠厚者，遇事决非章句儒。\n豺豹欲前终落爪，参辰无地可弯弧。\n他年白鹤同归否，犹有髯龙老未枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花","author":"李流谦","text":"自然秾脸与深唇，一味繁红也绝伦。\n沧海浪传千岁种，武陵应有四时春。\n去年崔护诗仍在，前度刘郎意独亲。\n亦要清樽相料理，可能但倚笔如神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益昌道中次兄长韵二首 其二","author":"李流谦","text":"木杪著邮亭，山行未饱经。\n已成身挈挈，恐失鬓青青。\n老树霞烘幄，阴崖雪糁屏。\n冰霜先训在，敢负旧趋庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益昌道中次兄长韵二首 其一","author":"李流谦","text":"聚头閒日月，逐日信东西。\n夜泊惊逢虎，晨餐倦乞醯。\n灯青千嶂梦，月白五更鸡。\n耐老前山路，长年送马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离合州驿晚宿茆城驿","author":"李流谦","text":"稍喜川原豁，遥看草树明。\n恶滩犹梦怖，平地始身轻。\n场圃收遗秉，沟塍劝早耕。\n得归万事好，漂泊岂人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭及之佥判招饮雅安同僚也","author":"李流谦","text":"江来从此合，我上尔东行。\n节物惊心地，主人留客情。\n雾花摇老眼，霜烛滟深觥。\n醉恐清歌断，应须更数声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱氏隐居三首 其三","author":"李流谦","text":"远树高低见，清溪曲折流。\n草眠耕后犊，波泛狎馀鸥。\n醒醉无人管，登临各自愁。\n扁舟大如叶，烂漫作春游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶失一丹瓢戏书","author":"李流谦","text":"谁取一瓢去，虚劳九转功。\n徵杯惊羽化，开画叹幮空。\n已堕宁论甑，虽亡未失弓。\n人间閒得丧，尽付绿樽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其三","author":"李流谦","text":"离家记得腊前时，吹尽飞花了不知。\n傍枕厌听连晓雨，援毫愁赋送春诗。\n百年直好平章看，万事仍须烂熟思。\n臣朔不堪当世用，唯应索米救朝饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其一","author":"李流谦","text":"早年种竹作渔竿，笠泽烟波梦未阑。\n已向尘根消缚脱，犹将文字校甘酸。\n风松自有閒宫徵，溪鹭初无俗肺肝。\n最爱少游平日语，堕鸢跕跕遣心寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿高桥怀仲明","author":"李流谦","text":"阑干投晚俯烟霏，全不支梧酒力微。\n沙鸟犯寒犹独立，林乌趁暝已先归。\n缭愁亦笑溪为带，障远端疑树合围。\n岁晏客天无好梦，最怜清露渍人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿船家小舟中凡三日夜作此","author":"李流谦","text":"自昔说离乱，经时足叹吁。\n何为来旷野，端是辱泥涂。\n相国跛男子，封侯裸丈夫。\n未须多感慨，事业出艰虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿魏城驿用罗江东韵怀李仲明","author":"李流谦","text":"昔年漂泊记曾游，碧树蝉声又带秋。\n滑滑泥行青嶂路，翩翩风倚夕阳楼。\n人誇驯雉碑犹在，书托文鳞水漫流。\n天遣此来相近傍，伴君牢落向边州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘德父","author":"李流谦","text":"解携仍是一年馀，本自情亲听迹疏。\n子去合登青琐闼，人言方驾短辕车。\n向来花月空馀梦，近日诗文定起予。\n塞雁若知怀远意，寄书聊为问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张珍甫殿院 其五","author":"李流谦","text":"定胜端相属，飞骞已后时。\n阅人盘谷老，具眼石麟儿。\n连茹才非匹，弹冠想自痴。\n读书头半白，万一故人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张珍甫殿院 其四","author":"李流谦","text":"只有肝尝露，初无舌悔扪。\n法行功罪竦，令重阙庭尊。\n尽变媮谀俗，仍关佞倖门。\n书生在蓬荜，此事付能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张珍甫殿院 其三","author":"李流谦","text":"已赡经时策，仍轻许国身。\n攘戎先政事，强本即精神。\n禹贡山川阔，尧天日月新。\n至诚驯暴逆，玉笏动严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张珍甫殿院 其二","author":"李流谦","text":"江湖淹远使，昆阆侣飞仙。\n豸首承恩渥，龙墀接迩联。\n豺狼莫当道，雕鹗不空拳。\n黯惷犹冠见，骄王易缩肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张珍甫殿院 其一","author":"李流谦","text":"自是清华选，尝怀宿昔期。\n高名推不去，异产买无赀。\n一日风云遇，千年简牍随。\n岷峨添岌嶪，袖里著安危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李仲明","author":"李流谦","text":"夜床风雨忆相过，节物惊人奈老何。\n只有孤鸿知我意，每因明月为君歌。\n千山梦去无由到，一字书来已觉多。\n馀耳向来真义合，不知底处便容戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄彦博二首 其二","author":"李流谦","text":"世途今若此，吾道竟何如。\n学古疑无用，谋身忌太疏。\n引杯空慷慨，看镜独踌躇。\n千万胸中语，因人略寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]