[{"title":"浣溪沙 其十八","author":"晏几道","text":"铜虎分符领外台，五云深处彩旌来。\n春随红旆过长淮。\n千里裤襦添旧暖，万家桃李间新栽。\n使星回首是三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十七","author":"晏几道","text":"小杏春声学浪仙，疏梅清唱替哀弦。\n似花如雪绕琼筵。\n腮粉月痕妆罢后，脸红莲艳酒醒前。\n今年水调得人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十五","author":"晏几道","text":"翠阁朱阑倚处危。\n夜凉闲捻彩箫吹。\n曲中双凤已分飞。\n绿酒细倾消别恨，红笺小写问归期。\n月华风意似当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其十六","author":"晏几道","text":"唱得红梅字字香，柳枝桃叶尽深藏。\n遏云声里送雕觞。\n才听便拚衣袖湿，欲歌先倚黛眉长。\n曲终敲损燕钗梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其八","author":"晏几道","text":"日日双眉斗画长，行云飞絮共轻狂。\n不将心嫁冶游郎。\n溅酒滴残歌扇字，弄花熏得舞衣香。\n一春弹泪说凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"晏几道","text":"卧鸭池头小苑开，暄风吹尽北枝梅。\n柳长莎软路萦回。\n静避绿阴莺有意，漫随游骑絮多才。\n去年今日忆同来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其三","author":"晏几道","text":"丽曲醉思仙，十二哀弦。\n秾蛾叠柳脸红莲。\n多少雨条烟叶恨，红泪离筵。\n行子惜流年，鶗鴂枝边。\n吴堤春水舣兰船。\n南去北来今渐老，难负尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其四","author":"晏几道","text":"翠幕绮筵张，淑景难忘。\n阳关声巧绕雕梁。\n美酒十分谁与共，玉指持觞。\n晓枕梦高唐，略话衷肠。\n小山池院竹风凉。\n明夜月圆帘四卷，今夜思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其一","author":"晏几道","text":"高阁对横塘，新燕年光。\n柳花残梦隔潇湘。\n绿浦归帆看不见，还是斜阳。\n一笑解愁肠，人会娥妆。\n藕丝衫袖郁金香。\n曳雪牵云留客醉，且伴春狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"晏几道","text":"小绿间长红，露蕊烟丛。\n花开花落昔年同。\n惟恨花前携手处，往事成空。\n山远水重重，一笑难逢。\n已拼长在别离中。\n霜鬓知他从此去，几度春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留春令 其二","author":"晏几道","text":"采莲舟上，夜来陡觉，十分秋意。\n懊恼寒花暂时香，与情浅、人相似。\n玉蕊歌清招晚醉，恋小桥风细。\n水湿红裙酒初消，又记得、南溪事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留春令 其一","author":"晏几道","text":"画屏天畔，梦回依约，十洲云水。\n手捻红笺寄人书，写无限、伤春事。\n别浦高楼曾漫倚，对江南千里。\n楼下分流水声中，有当日、凭高泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留春令 其三","author":"晏几道","text":"海棠风横，醉中吹落，香红强半。\n小粉多情怨花飞，仔细把、残香看。\n一抹浓檀秋水畔，缕金衣新换。\n鹦鹉杯深艳歌迟，更莫放、人肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子","author":"晏几道","text":"柳下笙歌庭院，花间姊妹秋千。\n记得春楼当日事，写向红窗夜月前。\n凭谁寄小莲。\n绛蜡等闲陪泪，吴蚕到了缠绵。\n绿鬓能供多少恨，未肯无情比断弦。\n今年老去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"晏几道","text":"长亭晚送，都似绿窗前日梦。\n小字还家，恰应红灯昨夜花。\n良时易过，半镜流年春欲破。\n往事难忘，一枕高楼到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"晏几道","text":"留春不住，恰似年光无味处。\n满眼飞英，弹指东风太浅情。\n筝弦未稳，学得新声难破恨。\n转枕花前，且占香红一夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"晏几道","text":"长杨辇路，绿满当年携手处。\n试逐春风，重到宫花花树中。\n芳菲绕遍，今日不如前日健。\n酒罢凄凉，新恨犹添旧恨长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望仙楼","author":"晏几道","text":"小春花信日边来，未上江楼先坼。\n今岁东君消息，还自南枝得。\n素衣染尽天香，玉酒添成国色。\n一自故溪疏隔，肠断长相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁州令","author":"晏几道","text":"莫唱阳关曲。\n泪湿当年金缕。\n离歌自古最消魂，闻歌更在魂消处。\n南楼杨柳多情绪。\n不系行人住。\n人情却似飞絮。\n悠扬便逐春风去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十六","author":"晏几道","text":"沈思暗记。\n几许无凭事。\n菊靥开残秋少味。\n闲却画阑风意。\n梦云归处难寻。\n微凉暗入香襟。\n犹恨那回庭院，依前月浅灯深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十八","author":"晏几道","text":"心期休问，只有尊前分。\n勾引行人添别恨，因是语低香近。\n劝人满酌金钟，清歌唱彻还重。\n莫道后期无定，梦魂犹有相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十五","author":"晏几道","text":"莲开欲遍，一夜秋声转。\n残绿断红香片片，长是西风堪怨。\n莫愁家住溪边，采莲心事年年。\n谁管水流花谢，月明昨夜兰船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其七","author":"晏几道","text":"波纹碧皱，曲水清明后。\n折得疏梅香满袖，暗喜春红依旧。\n归来紫陌东头，金钗换酒消愁。\n柳影深深细路，花梢小小层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其四","author":"晏几道","text":"可怜娇小，掌上承恩早。\n把镜不知人易老，欲占朱颜长好。\n画堂秋月佳期，藏钩赌酒归迟。\n红烛泪前低语，绿笺花里新词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其九","author":"晏几道","text":"蕙心堪怨，也逐春风转。\n丹杏墙东当日见，幽会绿窗题遍。\n眼中前事分明，可怜如梦难凭。\n都把旧时薄倖，只消今日无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一","author":"晏几道","text":"留人不住，醉解兰舟去。\n一棹碧涛春水路，过尽晓莺啼处。\n渡头杨柳青青，枝枝叶叶离情。\n此后锦书休寄，画楼云雨无凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十四","author":"晏几道","text":"寒催酒醒，晓陌飞霜定。\n背照画帘残烛影，斜月光中人静。\n锦衣才子西征，万重云水初程。\n翠黛倚门相送，鸾肠断处离声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一","author":"晏几道","text":"幺弦写意，意密弦声碎。\n书得凤笺无限事，犹恨春心难寄。\n卧听疏雨梧桐，雨馀淡月朦胧。\n一夜梦魂何处，那回杨叶楼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二","author":"晏几道","text":"千花百草，送得春归了。\n拾蕊人稀红渐少，叶底杏青梅小。\n小琼闲抱琵琶，雪香微透轻纱。\n正好一枝娇艳，当筵独占韶华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十七","author":"晏几道","text":"莺来燕去，宋玉墙东路。\n草草幽欢能几度，便有系人心处。\n碧天秋月无端，别来长照关山。\n一点恹恹谁会，依前凭暖阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其五","author":"晏几道","text":"红英落尽，未有相逢信。\n可恨流年凋绿鬓，睡得春酲欲醒。\n钿筝曾醉西楼，朱弦玉指梁州。\n曲罢翠帘高卷，几回新月如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三","author":"晏几道","text":"烟轻雨小，紫陌香尘少。\n谢客池塘生绿草，一夜红梅先老。\n旋题罗带新诗，重寻杨柳佳期。\n强半春寒去后，几番花信来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其六","author":"晏几道","text":"春云绿处。\n又见归鸿去。\n侧帽风前花满路。\n冶叶倡条情绪。\n红楼桂酒新开。\n曾携翠袖同来。\n醉弄影娥池水，短箫吹落残梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十一","author":"晏几道","text":"笙歌宛转，台上吴王宴。\n宫女如花倚春殿，舞绽缕金衣线。\n酒阑画烛低迷，彩鸳惊起双栖。\n月底三千绣户，云间十二琼梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十二","author":"晏几道","text":"暂来还去，轻似风头絮。\n纵得相逢留不住，何况相逢无处。\n去时约略黄昏，月华却到朱门。\n别后几番明月，素娥应是消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其八","author":"晏几道","text":"西池烟草，恨不寻芳早。\n满路落花红不扫，春色渐随人老。\n远山眉黛娇长，清歌细逐霞觞。\n正在十洲残梦，水心宫殿斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其十三","author":"晏几道","text":"双纹彩袖，笑捧金船酒。\n娇妙如花轻似柳，劝客千春长寿。\n艳歌更倚疏弦，有情须醉尊前。\n恰是可怜时候，玉娇今夜初圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清商怨","author":"晏几道","text":"庭花香信尚浅，最玉楼先暖。\n梦觉春衾，江南依旧远。\n回纹锦字暗剪，漫寄与、也应归晚。\n要问相思，天涯犹自短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"晏几道","text":"个人轻似低飞燕，春来绮陌时相见。\n堪恨两横波，恼人情绪多。\n长留青鬓住，莫放红颜去。\n占取艳阳天，且教伊少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其七","author":"晏几道","text":"哀筝一弄湘江曲，声声写尽湘波绿。\n纤指十三弦，细将幽恨传。\n当筵秋水慢，玉柱斜飞雁。\n弹到断肠时，春山眉黛低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"晏几道","text":"鸾啼似作留春语，花飞斗学回风舞。\n红日又平西，画帘遮燕泥。\n烟光还自老，绿镜人空好。\n香在去年衣，鱼笺音信稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其九","author":"晏几道","text":"相逢欲话相思苦，浅情肯信相思否。\n还恐漫相思，浅情人不知。\n忆曾携手处，月满窗前路。\n长到月来时，不眠犹待伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"晏几道","text":"春风未放花心吐，尊前不拟分明语。\n酒色上来迟，绿须红杏枝。\n今朝眉黛浅，暗恨归时远。\n前夜月当楼，相逢南陌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"晏几道","text":"香莲烛下匀丹雪，妆成笑弄金阶月。\n娇面胜芙蓉，脸边天与红。\n玳筵双揭鼓，唤上花茵舞。\n春浅未禁寒，暗嫌罗袖宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"晏几道","text":"来时杨柳东桥路，曲中暗有相期处。\n明月好因缘，欲圆还未圆。\n却寻芳草去，画扇遮微雨。\n飞絮莫无情，闲花应笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"晏几道","text":"娇香淡染胭脂雪，愁春细画弯弯月。\n花月镜边情，浅妆匀未成。\n佳期应有在，试倚秋千待。\n满地落英红，万条杨柳风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其八","author":"晏几道","text":"江南未雪梅花白，忆梅人是江南客。\n犹记旧相逢，淡烟微月中。\n玉容长有信，一笑归来近。\n怀远上楼时，晚云和雁低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"晏几道","text":"溪声急，无数落花漂出。\n燕子分泥蜂酿蜜，迟迟艳风日。\n须信芳菲随失，况复佳期难必。\n拟把此情书万一，愁多翻阁笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜团圆","author":"晏几道","text":"危楼静锁，窗中远岫，门外垂杨。\n珠帘不禁春风度，解偷送馀香。\n眠思梦想，不如双燕，得到兰房。\n别来只是，凭高泪眼，感旧离肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御街行 其一","author":"晏几道","text":"年光正似花梢露。\n弹指春还暮。\n翠眉仙子望归来，倚遍玉城珠树。\n岂知别后，好风良月，往事无寻处。\n狂情错向红尘住。\n忘了瑶台路。\n碧桃花蕊已应开，欲伴彩云飞去。\n回思十载，朱颜青鬓，枉被浮名误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御街行 其二","author":"晏几道","text":"街南绿树春饶絮。\n雪满游春路。\n树头花艳杂娇云，树底人家朱户。\n北楼闲上，疏帘高卷，直见街南树。\n阑干倚尽犹慵去。\n几度黄昏雨。\n晚春盘马踏青苔，曾傍绿阴深驻。\n落花犹在，香屏空掩，人面知何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁倚阑令","author":"晏几道","text":"凭江阁，看烟鸿，恨春浓。\n还有当年闻笛泪，洒东风。\n时候草绿花红，斜阳外、远水溶溶。\n浑似阿莲双枕畔，画屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁倚阑令 其一","author":"晏几道","text":"花阴月，柳梢莺，近清明。\n长恨去年今夜雨，洒离亭。\n枕上怀远诗成，红笺纸、小砑吴绫。\n寄与征人教念远，莫无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁倚阑令 其二","author":"晏几道","text":"春罗薄，酒醒寒，梦初残。\n欹枕片时云雨事，已关山。\n楼上斜日阑干，楼前路、曾试雕鞍。\n拚却一襟怀远泪，倚阑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"晏几道","text":"南苑吹花，西楼题叶，故园欢事重重。\n凭阑秋思，闲记旧相逢。\n几处歌云梦雨，可怜便、流水西东。\n别来久，浅情未有，锦字系征鸿。\n年光还少味，开残槛菊，落尽溪桐。\n漫留得，尊前淡月西风。\n此恨谁堪共说，清愁付、绿酒杯中。\n佳期在，归时待把，香袖看啼红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其七","author":"晏几道","text":"小梅枝上东君信，雪后花期近。\n南枝开尽北枝开，长被陇头游子、寄春来。\n年年衣袖年年泪，总为今朝意。\n问谁同是忆花人。\n赚得小鸿眉黛、也低颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其四","author":"晏几道","text":"疏梅月下歌金缕，忆共文君语。\n更谁情浅似春风，一夜满枝新绿、替残红。\n蘋香已有莲开信，两桨佳期近。\n采莲时节定来无，醉后满身花影、倩人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其八","author":"晏几道","text":"湿红笺纸回纹字，多少柔肠事。\n去年双燕欲归时，还是碧云千里、锦书迟。\n南楼风月长依旧，别恨无端有。\n倩谁横笛倚危阑，今夜落梅声里、怨关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其六","author":"晏几道","text":"秋风不似春风好，一夜金英老。\n更谁来凭曲阑干，惟有雁边斜月、照关山。\n双星旧约年年在，笑尽人情改。\n有期无定是无期，说与小云新恨、也低眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其五","author":"晏几道","text":"玉箫吹遍烟花路，小谢经年去。\n更教谁画远山眉，又是陌头风细、恼人时。\n时光不解年年好，叶上秋声早。\n可怜蝴蝶易分飞，只有杏梁双燕、每来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其二","author":"晏几道","text":"飞花自有牵情处，不向枝边坠。\n随风飘荡已堪愁，更伴东流流水、过秦楼。\n楼中翠黛含春怨，闲倚阑干见。\n远弹双泪惜香红，暗恨玉颜光景、与花同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其九","author":"晏几道","text":"一弦弹尽仙韶乐，曾破千金学。\n玉楼银烛夜深深，愁见曲中双泪、落香襟。\n从来不奈离声怨，几度朱弦断。\n未知谁解赏新音，长是好风明月、暗知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其三","author":"晏几道","text":"曲阑干外天如水，昨夜还曾倚。\n初将明月比佳期，长向月圆时候、望人归。\n罗衣着破前香在，旧意谁教改。\n一春离恨懒调弦，犹有两行闲泪、宝筝前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其一","author":"晏几道","text":"闲敲玉镫隋堤路，一笑开朱户。\n素云凝澹月婵娟，门外鸭头春水、木兰船。\n吹花拾蕊嬉游惯，天与相逢晚。\n一声长笛倚楼时，应恨不题红叶、寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解佩令","author":"晏几道","text":"玉阶秋感，年华暗去。\n掩深宫、团扇无绪。\n记得当时，自剪下、机中轻素。\n点丹青、画成秦女。\n凉襟犹在，朱弦未改，忍霜纨、飘零何处。\n自古悲凉，是情事、轻如云雨。\n倚幺弦、恨长难诉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧牡丹","author":"晏几道","text":"翠袖疏纨扇。\n凉叶催归燕。\n一夜西风，几处伤高怀远。\n细菊枝头，开嫩香还遍。\n月痕依旧庭院。\n事何限。\n怅望秋意晚。\n离人鬓华将换。\n静忆天涯，路比此情犹短。\n试约鸾笺，传素期良愿。\n南云应有新雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]