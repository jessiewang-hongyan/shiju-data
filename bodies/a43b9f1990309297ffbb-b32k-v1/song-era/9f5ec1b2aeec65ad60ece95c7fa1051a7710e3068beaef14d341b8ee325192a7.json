[{"title":"木兰花/玉楼春 其一","author":"李石","text":"辘轳轭轭门前井。\n不道隔窗人睡醒。\n柔弦无力玉琴寒，残麝彻心金鸭冷。\n一莺啼破帘栊静。\n红日渐高槐转影。\n起来情绪寄游丝，飞绊翠翘风不定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其二 重午","author":"李石","text":"红藕丝。\n白藕丝。\n艾虎衫裁金缕衣。\n钗头双荔枝。\n鬓符儿，背符儿。\n鬼在心头符怎知。\n相思十二时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其一 暮春","author":"李石","text":"花飞飞。\n絮飞飞。\n三月江南烟雨时。\n楼台春树迷。\n双莺儿。\n双燕儿。\n桥北桥南相对啼。\n行人犹未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长相思 其三 佳人","author":"李石","text":"花深红。\n花浅红。\n桃杏浅深花不同。\n年年吹暖风。\n莺语中。\n燕语中。\n唤起碧窗春睡浓。\n日高花影重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出塞/谒金门 夜梦一女子引扇求字，为书小阕","author":"李石","text":"花树树。\n吹碎胭脂红雨。\n将谓郎来推绣户。\n暖风摇竹坞。\n睡起栏干凝伫。\n漠漠红楼飞絮。\n划踏袜儿垂手处。\n隔溪莺对语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 其一 春情","author":"李石","text":"小桃小杏红，和雨和烟瘦。\n不是点燕脂，素面偏宜酒。\n也是惯伤春，可惜闲时候。\n正要画眉人，与作双蛾斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 其三","author":"李石","text":"今年花发时，燕子双双语。\n谁与卷珠帘，人在花间住。\n明年花发时，燕语人何处。\n且与寄书来，人往江南去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 其四","author":"李石","text":"荷花人面红，月影波心见。\n扇子倒拈来，敲落红香片。\n窗下剪灯花，今日眉深浅。\n留得镜中看，蹙破春山远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 其二","author":"李石","text":"新花上苑枝，枝上娇莺语。\n日日抱花心，啄破燕脂雨。\n莺飞莺去时，谁与花为主。\n守等却飞来，再见花开处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其二 忆别","author":"李石","text":"忆被金尊劝倒。\n灯下红香围绕。\n别后有谁怜，一任春残莺老。\n烦恼。\n烦恼。\n肠断绿杨芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其一","author":"李石","text":"桥上水光浮雪。\n桥下柳阴遮月。\n梦里去寻香，露冷五更时节。\n胡蝶。\n胡蝶。\n飞过闲红千叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 渔父","author":"李石","text":"一脉分溪浅绿，数枝约岸欹红。\n小船横系碧芦丛。\n似我江湖春梦。\n晒网渔归别浦，举头雁度晴空。\n短蓑独宿月明中。\n醉笛一声风弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中花慢 次宇文吏部赠黄如圭韵","author":"李石","text":"潋滟云霞，空濛雾雨，长堤柳色如茵。\n问西湖何似，粉面初匀。\n尽道软红香土，东华风月俱新。\n旧游如梦，尘缘未断，几度逢春。\n蓬莱阁上，风流二老，相携把酒论文。\n最好是、四娘桃李，约近东邻。\n别后使君须鬓，十分白了三分。\n是人笑道，醉中文字，更要红裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其三","author":"李石","text":"有宅一区家四壁，年年花柳深村。\n父兄随处宴鸡豚。\n折腰归去，何苦傍侯门。\n拟射九乌留白日，假饶立到黄昏。\n卧龙老矣及三分。\n不如把手，堂上宴芳尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二 醉饮","author":"李石","text":"八曲阑干垂手处，烛光花影疏疏。\n一尊共饮记当初。\n彩毫浓点，双带要人书。\n日暮不来朱户隔，碧云高挂蟾蜍。\n琴心密约总成虚。\n醉中言语，醒后忆人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其四 老母太恭人三月二十一日生，是日仍遇己卯本命，作千岁会祝寿，子孙三十八人","author":"李石","text":"九九之年逢降庆，生年生日同时。\n金花紫诰鬓银丝。\n乞身香火地，日戏老莱衣。\n浑舍集成千岁会，子孙三世庭闱。\n共将春酒祝金卮。\n蟠桃三月暮，莫怪看花迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一 佳人","author":"李石","text":"烟柳疏疏人悄悄，画楼风外吹笙。\n倚阑闻唤小红声。\n熏香临欲睡，玉漏已三更。\n坐待不来来又去，一方明月中庭。\n粉墙东畔小桥横。\n起来花影下，扇子扑飞萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其二 醉饮","author":"李石","text":"裹帽捻吟须。\n我是蓬莱旧酒徒。\n除了茅君谁是伴，麻姑。\n洞里仙浆不用沽。\n弱水渺江湖。\n醉里笙歌醉里扶。\n纵饮菊潭餐菊蕊，茱萸。\n医得人间瘦也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其一 十月海棠","author":"李石","text":"十月小春天。\n红叶红花半雨烟。\n点滴红酥真耐冷，争先。\n夺取梅魂斗雪妍。\n坐待晓莺迁。\n织女机头蜀锦川。\n枝上绿毛幺凤子，飞仙。\n乞与双双作被眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子 其一","author":"李石","text":"心自小，玉钗头。\n月娥飞下白蘋洲。\n水中仙，月下游。\n江汉佩，洞庭舟。\n香名薄幸寄青楼。\n问何如，打泊浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子 其一 送别","author":"李石","text":"斟别酒，问东君。\n一年一度一回新。\n看百花，飘舞茵。\n斟别酒，问行人。\n莫将别泪裛罗巾。\n早归来，依旧春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子","author":"李石","text":"腰束素，鬓垂鸦。\n无情笑面醉犹遮。\n扇儿扇，瞥见些。\n双凤小，玉钗斜。\n芙蓉衫子藕花纱。\n戴一枝，薝卜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子","author":"李石","text":"红粉里，绛金裳。\n一卮仙酒艳晨妆。\n醉温柔，别有乡。\n清暑殿，藕风凉。\n鸡头擘破误君王。\n泣梨花，春梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 赠鼎湖官妓","author":"李石","text":"西去征鸿东去水。\n几重别恨千山里。\n梦绕绿窗书半纸。\n何处是。\n桃花溪畔人千里。\n瘦玉倚香愁黛翠。\n劝人须要人先醉。\n问道明朝行也未。\n犹自记。\n灯前背立偷弹泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其二 赠赵牧仲歌姬","author":"李石","text":"绿杨庭院觉深沈。\n曾听一莺吟。\n今夜却成容易，双莲步步摇金。\n歌声暂驻，颦眉又去，无计重寻。\n应恨玉郎殢酒，教人守到更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其三 赠别","author":"李石","text":"凌波庭院藕香残。\n银烛夜生寒。\n两点眉尖新恨，别来谁画遥山。\n南楼皓月，一般瘦影，两处凭阑。\n莫似桃花溪畔，乱随流水人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其一 闻莺","author":"李石","text":"飘飘仙袂缕黄金。\n相对弄清音。\n几度教人误听，当窗绿暗红深。\n一声梦破，槐阴转午，别院深沈。\n试问绿杨南陌，何如紫椹西林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢池春","author":"李石","text":"烟雨池塘，绿野乍添春涨。\n凤楼高、珠帘卷上。\n金柔玉困，舞腰肢相向。\n似玉人、瘦时模样。\n离亭别后，试问阳关谁唱。\n对青春、翻成怅望。\n重门静院，度香风屏障。\n吐飞花、伴人来往。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 送别","author":"李石","text":"江草抽心，江云弄碧，江波依旧东流。\n别筵初散，行客上兰舟。\n休唱阳关旧曲，青青柳、无限轻柔。\n应争记，三年乐事，珠翠拥鳌头。\n离愁。\n知几许，花梢著雨，红泪难收。\n看烟火吴天，万里悠悠。\n一望珠宫绛阙，蓬莱路、应在皇州。\n仍回首，蜀山万点，明月满南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 春云","author":"李石","text":"天低日暮。\n清商一曲行人住。\n著人意态如飞絮。\n才泊春衫，却被风吹去。\n朝期暮约浑无据。\n同心结尽千千缕。\n今宵魂梦知何处。\n翠竹芭蕉，又下黄昏雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱","author":"李石","text":"望长江东去，逐客西来，几逢秋杪。\n江草不花，约鬓丝俱老。\n朝士红萸，佳人雪藕，别后忍孤欢笑。\n楚水楼台，巫山宫殿，五湖烟渺。\n又是征帆，万里行去，旧恨鲈鱼，昔盟鸥鸟。\n九日江南，上蓬莱仙岛。\n三度刘郎，黄花醉里，问我几时来到。\n寄语西风，饶他老子，莫欺乌帽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李石","text":"留船买鱼作寒节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李石","text":"便令巴水浓如酒，巴邑巴村醉花柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一箩金/蝶恋花","author":"李石才","text":"武陵春色浓如酒。\n游冶才郎，初试花间手。\n绛蜡烛残人静后。\n眉峰便作伤春皱。\n一霎风狂和雨骤。\n柳嫩花柔，浑不禁僝僽。\n明日馀香知否。\n粉罗犹有残红透。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李艾","text":"江声捲出风雷去，山色携将图画来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九英梅","author":"李龙高","text":"才子随班下玉墀，精光九出射晴曦。\n看来不是文章瑞，似是梅花恨杀伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月梅","author":"李龙高","text":"明知身是雪霜姿，瘦骨棱棱不入时。\n但得春风盈宇宙，老翁也要逐儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八出梅","author":"李龙高","text":"宣城妙品世无双，不肯随时一样妆。\n党锢诸贤销铄尽，至今千载骨犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月梅","author":"李龙高","text":"风撼千林木叶摧，冰霜国里早春回。\n一枝参透乾坤缊，生意都从小雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小梅","author":"李龙高","text":"小杜文章小李歌，诗名还有小东坡。\n莫欺一点丰姿瘦，著得清香尽自多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌梅","author":"李龙高","text":"妇舌安能困董宣，曹郎那解污张翰。\n任君百计相熏炙，本性依然带点酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆梅","author":"李龙高","text":"飘蓬万里隔风沙，梦到江南未到家。\n料得夜深霜月苦，几人挥泪说梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月梅","author":"李龙高","text":"仙姝拥佩出云堆，光射瑶林万蚌胎。\n只可范家村里照，不须移影过苏台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓦瓶","author":"李龙高","text":"虚窗净几坐劬书，姑射仙人伴我癯。\n谁笑月明家四壁，案头犹自有珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风梅","author":"李龙高","text":"一番摇曳一番空，香在山蹊野径中。\n不是老枝藏处密，如何禁得许霜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半开梅","author":"李龙高","text":"雪弄新晴月带霜，风窗暗送几分香。\n翠禽飞过偷相语，不是徐妃也半妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半落梅","author":"李龙高","text":"飘零大半委山坡，雨雪无情尚折磨。\n纵有风流前辈在，贞元朝士想无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉堂","author":"李龙高","text":"斗柄参旗插屋头，巡檐绕树尽风流。\n谁知终带山林味，不涴些儿富贵羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买梅","author":"李龙高","text":"担头挑得几枝斜，过我西湖处士家。\n莫向侯门高索价，贵人多爱牡丹花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仰山祠","author":"李龙高","text":"补之声价塞江湖，似此村梅笔甚都。\n近代残缣零落尽，山灵犹解宝藏无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都","author":"李龙高","text":"峡江西去锦官城，闻说梅龙绝可人。\n不识年来无恙否，武侯祠柏已成薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬州","author":"李龙高","text":"水曹江左一诗家，几度哦梅到月斜。\n二十四桥春色里，相逢只是说琼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早梅","author":"李龙高","text":"贾少难逃赋鵩灾，终童不载使缨回。\n祇须浪作争春态，留取孤芳殿后开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江梅","author":"李龙高","text":"素衣缟袂影蹁跹，不是天仙是水仙。\n老杜吟魂香禾歇，至今犹绕耒阳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹梅","author":"李龙高","text":"落落丰标霁月怀，棱棱寒碧隔风埃。\n耿恭也有孤高节，岂但苏郎齧雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红罗亭","author":"李龙高","text":"红云绛雪镂繁华，侍宴流连彻暮鸦。\n车马不来歌吹断，春风一半属谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老梅","author":"李龙高","text":"雪里孤根久屈蟠，岩前古貌太高寒。\n老来想不为胡广，免被人将粪土看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"艮岳","author":"李龙高","text":"鹿衔花去綵云气，万岁山前梦已迷。\n萼绿仙人何许觅，断崖枯树夜乌啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吟梅","author":"李龙高","text":"耸尽肩楼鹤样癯，断桥横路撚冰须。\n梅花却笑君何事，锻得诗来瘦似吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"折梅","author":"李龙高","text":"诗老流离蜀剑关，放臣憔悴楚江干。\n争如留取微酸味，莫逐浮花一笑残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏梅","author":"李龙高","text":"淡把猩猩血染成，涴他玉雪一生身。\n相形倘在骊黄外，未必张良似妇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村梅","author":"李龙高","text":"不入时妆辈行羞，一生槁淡乏风流。\n任君约遍宫黄额，莫管村姑守白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏词","author":"李龙高","text":"翩翩綵笔赋梅花，只忆朝云不忆家。\n为说坡仙休怅恨，昭君犹自弄琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卧梅","author":"李龙高","text":"月横鹤膝影阑干，枕石眠云几岁寒。\n宇宙一身今老矣，潇潇风雪拥袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和任比部忆梅","author":"邵雍","text":"痛忆梅开易得残，既残憔悴不堪看。\n年年长被清香误，争似闲栽竹数竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岭梅","author":"李龙高","text":"雪立孤标不受霾，世间浪蕊等浮埃。\n清高已是无俦伍，更向群山顶上开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松梅","author":"李龙高","text":"梅誇清节忒高寒，松受微封合骏弹。\n毕竟两君俱强项，大夫未必爱秦官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮","author":"李龙高","text":"谩说师雄醉月边，稚川曾隐此山巅。\n料伊不是丹砂力，只服梅花换得仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茅舍","author":"李龙高","text":"深村古木路三叉，路外溪流溪外沙。\n背水短篱花似雪，遥知不是四娘家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"驿梅","author":"李龙高","text":"亭边老树影?毵，阅尽犀珠压去骖。\n岁晚行人风雪里，也须障面过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"品梅","author":"李龙高","text":"疏花鼎立睨霜风，二季居然侍一翁。\n生愿素丝无点污，黑衣人自作三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫梅","author":"李龙高","text":"冰肤绰约活神仙，天上吹香几许年。\n见说额妆人去后，低头无语懒春妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枯梅","author":"李龙高","text":"肠刳馀得龟皮在，意懒羞将粉面开。\n莫笑老身柴立骨，年时几费抹涂来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]