[{"title":"秋光","author":"陆游","text":"年年最爱秋光好，病起逢秋合赋诗。\n丛菊渐黄人醉后，孤灯初暗雨来时。\n旧书细读犹多味，老态相寻似有期。\n早信为农胜觅禄，一生虚作虎头痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其二","author":"陆游","text":"孤城寂寞近江干，处处疏砧送早寒。\n水落才馀半篙绿，霜高初染一林丹。\n民租屡减追胥少，吏责全轻法令宽。\n偶有一樽聊独醉，强挼黄菊助清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"陆游","text":"无处逢秋不黯然，驿前斜日渡头烟。\n吟肩雅与寒驴称，归梦频争社燕先。\n百岁犹穿几两屐，千诗不及一囊钱。\n故应身世如团扇，已向人间耐弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴四首 其四","author":"陆游","text":"世事何曾挂齿牙，只将放浪作生涯。\n有时掬米引驯鹿，到处入林求野花。\n邻父筑场收早稼，溪姑负笼卖秋茶。\n等闲一日还过却，又倚柴扉数暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴三首 其三","author":"陆游","text":"老子虽贫未易量，风流犹在小茆堂。\n葡萄锦覆桐孙古，鹦鹉螺斟玉瀣香。\n千点荷声先报雨，一林竹影剩分凉。\n秋来便有欣然处，新种莼丝已满塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"陆游","text":"扶衰又见素秋过，未死其如造物何。\n破屋颓垣那敢议，浊醪粗饭已为多。\n佩刀但可偿黄犊，作字安能博白鹅。\n龟紫拜恩如梦寐，残年其实一渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其一","author":"陆游","text":"满簪白发不胜繁，窃禄偷安愧主恩。\n东馆烟波秋渐瘦，北山雾雨昼多昏。\n功名蹭蹬身长弃，筹策澜翻舌幸存。\n堪笑此生虚过尽，一秋闭閤听啼猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"陆游","text":"秋风又满会稽城，有客飘然万事轻。\n久向林间得佳趣，不知身外有浮名。\n葡萄雨足初全紫，乌桕霜前已半赪。\n欲把一杯终觉懒，老来怀抱为谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"陆游","text":"巢燕无情不更回，门庭日日落楸槐。\n新凉渐喜偿碑债，多病还忧欠药材。\n社近家方篘浊酒，客来身自扫苍苔。\n道心已熟机心尽，寄语鸬鹚莫苦猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴四首 其三","author":"陆游","text":"五十年来住镜湖，白头仍是一臞儒。\n朝眠每恨妨书课，秋穫先令入酒逋。\n江路伶俜形吊影，草庵寂默我忘吾。\n雨窗忽有高谈兴，筮叟医翁亦可呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴四首 其二","author":"陆游","text":"敛尽残云见夕阳，门前䆉稏渐登场。\n经年都得几回醉，一雨顿惊如许凉。\n耐事尚能心似铁，放歌仍忘发成霜。\n颐生底用从人问，此是山翁肘后方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其二","author":"陆游","text":"世事元看等一毫，纷纷宠辱陋儿曹。\n雁行横野月初上，桐叶满庭霜未高。\n细考虫鱼笺尔雅，广收草木续离骚。\n更馀一事君知否，卧听床头滴小槽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其二","author":"陆游","text":"八十仍当过二时，加餐安寝岂前知。\n晨梳脱发虽无数，社瓮新醅已有期。\n偶为买花经废圃，时因蹋藕下清池。\n尚馀一事终关念，安得儿孙少别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其一","author":"陆游","text":"白发萧萧欲满头，归来三见故山秋。\n醉凭高阁乾坤大，病入中年日月遒。\n百战铁衣空许国，五更画角只生愁。\n明朝烟雨桐江岸，且占丹枫系钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"陆游","text":"秋眠怯簟冷，晨饭喜蔬香。\n宁使衣百结，肯储钱一囊。\n杜门虽局促，负气尚轩昂。\n死去真无憾，曾孙似我长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其一","author":"陆游","text":"修蔓丛篁步步迷，山村东下近鱼陂。\n钓归恰值秋风起，棋罢常惊日景移。\n病叶辞枝应有恨，候虫吟壁故知时。\n残年我亦悲摇落，薄暮空囊又有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴四首 其一","author":"陆游","text":"谁敢轻他万户侯，一生赋分在沧洲。\n屋穿况值雨骑月，路恶更堪风打头。\n此世极知同逆旅，吾身亦自是悬疣。\n乞钱买取青芒屦，烂醉三条二华秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其一","author":"陆游","text":"流光冉冉迫崦嵫，常抱秋风宋玉悲。\n才尽已无枫落句，身存又见雁来时。\n自怜闭户庞眉叟，初对还家大耳儿。\n一盏青灯照寒影，不妨细举别来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴三首 其二","author":"陆游","text":"蓬蒿门巷绝经过，清夜何人与晤歌。\n蟋蟀独知秋令早，芭蕉正得雨声多。\n传家产业遗书富，玩世神通醉脸酡。\n如许痴顽君会否，一毫不遣损天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴三首 其一","author":"陆游","text":"天遣幽人尽放狂，醉眠无复客为妨。\n墨蛟飞下剡藤滑，苍璧碾成官焙香。\n老境虽深身更健，清秋欲半日犹长。\n闭门莫道都无事，又了移花一段忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴","author":"陆游","text":"樵风溪上弄扁舟，濯锦江边忆旧游。\n豪竹哀丝真昨梦，爽砧繁杵又惊秋。\n坠枝橘熟初堪剪，浮瓮醅香恰受篘。\n莫道身闲总无事，孤灯夜夜写清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋后一日风雨","author":"陆游","text":"炎歊数日剧，荡涤及秋初。\n病叶风吹尽，鸣蝉雨打疏。\n趁凉谋社酒，乘润理园蔬。\n分喜宁无处，蒲中鱍鱍鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋尽自遣二首 其一","author":"陆游","text":"息驾江湖上，推移岁又残。\n雨添苔晕紫，霜染桕林丹。\n贫叹耕畴薄，狂依禁网宽。\n游山携一钵，到寺即开单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋尽自遣二首 其二","author":"陆游","text":"老健非颐摄，羁穷为折除。\n人情看已惯，身在不论馀。\n席下钱虽尽，瓶中粟有储。\n行歌混樵牧，吾计未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋色","author":"陆游","text":"一段凄凉傍酒杯，中年剩作楚囚哀。\n迢迢似伴明河出，惨惨如随落照来。\n客路半生常泪眼，乡关万里更危台。\n蓼汀荻浦江南岸，自入秋来梦几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴","author":"陆游","text":"淡日披朝雾，轻云结暮阴。\n菰蒲溪路暗，松竹草堂深。\n妙墨双钩帖，奇声百衲琴。\n古人端未远，一笑会吾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴","author":"陆游","text":"陂泽秋容淡，郊原晓气清。\n雨来鸠有语，社近燕无情。\n拄杖扶腰痛，渔舟照眼明。\n苦吟缘病辍，随意或诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴出游","author":"陆游","text":"遮日云生忽复收，黄鸦鸣唤伴林鸠。\n也知雨意逢秋作，未害山翁竟日游。\n陌上驿亭双只堠，烟中渔钓两三舟。\n归迟不是寻诗料，秣蹇民家偶小留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴至近村","author":"陆游","text":"村店闲寻酒，筇枝瘦倚肩。\n云齐龙卷雨，野旷鹤盘天。\n露井飘桐后，清觞泛菊前。\n欲归还小立，搔首意悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋声","author":"陆游","text":"萧骚拂树过中庭，何处人间有此声。\n涨水雨馀晨放闸，骑兵战罢夜还营。\n闲凭曲几听虽久，彊抚哀弦写不成。\n暑退凉生君勿喜，一年光景又峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其二","author":"陆游","text":"苦雨无时止，幽人空复情。\n少眠知夜永，久病喜秋清。\n萤傍疏帘度，蛩依坏甃鸣。\n流年那可挽，又见晓窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其四","author":"陆游","text":"寓世久成赘，忘家生若浮。\n安能三太息，惟有四宜休。\n屋坏无全堵，船轻每信流。\n鸱夷幸无恙，赖尔可消忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其一","author":"陆游","text":"火食非初志，衣尘每自哀。\n危途触滟滪，归兴薄蓬莱。\n逋客传琴调，高僧乞药栽。\n人间岂不好，病眼自慵开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"陆游","text":"形骸岁岁就枯朽，意气时时犹激昂。\n水远浮鸥方浩荡，霜高残菊更芬芳。\n人皆有舌是非在，劫未成灰时世长。\n三百里湖行自复，子孙努力事耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其三","author":"陆游","text":"独立离人境，幽居察物情。\n蚁知军阵法，虫作纬车声。\n身老惟贪睡，儿痴亦惰耕。\n腾腾复兀兀，何以报时平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来苦贫戏作","author":"陆游","text":"闭门高卧养吾真，说著生涯笑倒人。\n奴闵囊空辞雇直，婢愁爨冷拾炊薪。\n羹能有糁犹为泰，地到无锥始是贫。\n一饭不妨支一日，读书常愧聒比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其七","author":"陆游","text":"穷阨非由命，从来作计疏。\n妄营资鬼笑，多爱夺狐书。\n何事能陶写，惟当尽破除。\n霜晴宜著屐，不敢笑无驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其八","author":"陆游","text":"寓世年虽往，安心疾已平。\n每思丹灶冷，宜觉世缘轻。\n布被鸡催晓，蓬窗鹊噪晴。\n呼儿净洗砚，书帖寄青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其二","author":"陆游","text":"何许是吾庐，南临古镜湖。\n园林垂橘柚，门巷落楸梧。\n床稳龟无息，巢新鹤有雏。\n邻翁殊耐久，有酒即相呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其九","author":"陆游","text":"万古无穷梦，馀年欲散云。\n身虽迫衰谢，学未废锄耘。\n开卷多新得，逢人有旧闻。\n伏生虽九十，犹冀与斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其三","author":"陆游","text":"原野无闲土，乡闾有老人。\n疾平行已健，秋晚醉差频。\n啄黍黄鸡嫩，迎霜紫蟹新。\n百年元任运，一笑却关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其五","author":"陆游","text":"轻装两衣笈，假寝一胡床。\n唤渡江楼下，逢僧县驿傍。\n横林生夕霭，孤蝶弄秋光。\n老惯人间事，无诗寄断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其六","author":"陆游","text":"渡水得鱼舍，乞浆敲竹扉。\n地偏花带恨，林暖鸟忘归。\n独往非违世，幽居自息机。\n晚来清兴极，更喜雨霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其十","author":"陆游","text":"斯世本无事，古人谁与归。\n屏除闲麈尾，收拾旧蓑衣。\n浩浩观空劫，拳拳讼昨非。\n云开天万里，辽鹤正孤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其四","author":"陆游","text":"藿食筋骸惫，林庐岁月侵。\n道穷思故友，力尽悔初心。\n浩浩天知我，悠悠后视今。\n飘零君勿叹，古瑟有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来益觉顽健时一出游意中甚适杂赋五字十首 其一","author":"陆游","text":"旬日雨频作，一年秋又残。\n光阴不少贷，怀抱若为宽。\n小瓮聊寻醉，疏砧已戒寒。\n定知清夜梦，又过石阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来瘦甚而益健戏作","author":"陆游","text":"莫笑形羸不自支，清虚正与老人宜。\n矛头淅米谁能食，甑里生尘却自奇。\n独钓又逢秋晚后，安眠常到日高时。\n迩来久雨墙垣坏，砟竹东冈自作篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋社二首 其二","author":"陆游","text":"浦溆渔歌远，茆茨绩火明。\n新凉迎病起，乐事及秋成。\n社肉分初至，官壶买旋倾。\n残年得家食，何以报时清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋社","author":"陆游","text":"雨馀残日照庭槐，社鼓鼕鼕赛庙回。\n又见神盘分肉至，不堪沙雁带寒来。\n书因忌作闲终日，酒为治聋醉一杯。\n记取镜湖无限景，蘋花零落蓼花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋社二首 其一","author":"陆游","text":"明朝逢社日，邻曲乐年丰。\n稻蟹雨中尽，海氛秋后空。\n不须谀土偶，正可倚天公。\n酒满银杯绿，相呼一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋近","author":"陆游","text":"石榴萱草并成空，又见墙阴苋叶红。\n茶酽颇妨千里梦，簟凉初怯五更风。\n新瓜落刃冰盘里，晚燕添巢画阁中。\n身健流年俱可乐，故人自欠一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋近颇有凉意","author":"陆游","text":"平旦面数箸，晡时饭一杯。\n枝梧长日过，怅望早秋来。\n团扇寻诗写，缁巾借样裁。\n惟应水边坐，待得市船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"高屐枯筇一老翁，灯前自笑发如蓬。\n泠泠月浸荒庭竹，淅淅风凋古井桐。\n病思未苏秋尚浅，醉魂初醒夜方中。\n故人万里无消息，便拟江头问断鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"秋气侵帷梦不成，一灯西壁翳还明。\n风高露井无桐叶，雨急烟村有雁声。\n击筑谁同燕市饮，赁舂方作会稽行。\n从来自许知何等，堪叹江湖白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"老病睡眠少，如斯秋夜何。\n长庚未配月，织女已斜河。\n莎径虫吟苦，柴门叶落多。\n谁知穷宁戚，不作饭牛歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"老病龙钟不入城，浊醪粗饭饯馀生。\n未霜村舍秋先冷，无月江天夜自明。\n出塞虽惭平贼手，下帷聊喜读书声。\n山童睡熟青灯暗，自拨残炉候药铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"湖海秋初到，房栊夜转幽。\n露浓惊鹤梦，月冷伴蛩愁。\n生计依微禄，年光堕远游。\n严滩已在眼，早晚放孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"药饵扶衰疾，琴书返故园。\n陶公方止酒，乐令且清言。\n烟鸟宿沙际，露萤明草根。\n尘嚣不到处，此意与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"老觉人间岁月遒，愔愔窗户一灯幽。\n读书已废虚长夜，护塞无期负盛秋。\n病齿何堪食粱肉，残躯惟念制衣裘。\n重阳卧看登高侣，满地茱萸只自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"倦叟投床早，昏灯落烬频。\n鹊翻惊缺月，犬吠逐行人。\n未丧诗书业，犹存老病身。\n菊花行可醉，作意插乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"清夜不成寐，出门还浩歌。\n断云微翳月，薄露不倾荷。\n络纬知时早，梧桐奈汝何。\n非关老怀恶，秋物感人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"局促人间每鲜欢，秋来病骨愈酸寒。\n夹衣尚典雁声过，断简未收鸡唱残。\n退士鬓毛纷似雪，老臣心事炳如丹。\n灯前握臂无交旧，聊唤清尊少自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜二首 其一","author":"陆游","text":"秋色满江干，江枫已半丹。\n身闲诗简淡，道胜梦轻安。\n偃蹇怜腰折，清癯鄙面团。\n何妨杵衣夜，又见岁将残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"大枕空床梦不成，草堂悄悄四无声。\n月明渐见天窗白，风起忽闻檐佩鸣。\n客子未忘悲故里，老人无念到浮名。\n江村岁岁先凉冷，且复寻盟向短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜书怀","author":"陆游","text":"断香漠漠绕藤床，新月娟娟转画廊。\n乡远每劳千里梦，雨悭未放九秋凉。\n衰迟分作骥伏枥，敛退敢求锥出囊。\n剩喜今年有奇事，严遵滩下系归航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜五鼓初起坐堂上至旦","author":"陆游","text":"蒸郁不可过，开门星满天。\n身还倚藤杖，手自酌岩泉。\n鸡唱犹相续，鸦飞忽已翩。\n事随朝日出，佳思复茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜出门观月","author":"陆游","text":"六十衰翁适得闲，一秋无事掩柴关。\n雁来惨淡沙场外，月出苍茫云海间。\n饮酒已衰犹爱客，著书初毕可藏山。\n此生终羡渔家乐，小艇常冲夕霭还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]