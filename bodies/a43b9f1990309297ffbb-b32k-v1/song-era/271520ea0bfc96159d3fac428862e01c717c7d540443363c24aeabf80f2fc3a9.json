[{"title":"华亭百咏 其十五 金山城","author":"许尚","text":"治盛周康世，东游岂信然。\n城闉亦隳废，门堞漫相传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其三十七 俞塘","author":"许尚","text":"延袤三乡外，东流与海通。\n河神屡加惠，帆借往来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其十六 前京城","author":"许尚","text":"庐落皆无有，依稀古堞存。\n登临认遗迹，林莽暮烟昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其七十九 南庵","author":"许尚","text":"施水功成后，眈眈梵宇深。\n升堂瞻貌象，默会祖师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其四十九 姚将军庙","author":"许尚","text":"阴功周邑境，南面固宜然。\n毋复论民事，神今惮改迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其八十 姜庵","author":"许尚","text":"阴曀楸梧里，鸟鸣落日中。\n九原人不作，明赞亦何功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其四十三 思齐堂","author":"许尚","text":"伊昔弦歌治，能声著海隅。\n升堂想遗迹，励志欲齐驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其七十三 显忠庙","author":"许尚","text":"俯拜祠堂下，遥思弼汉功。\n吁嗟孝宣帝，忘德太匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其十一 柘湖","author":"许尚","text":"展武沈沦后，波澄一鉴明。\n桑田复更变，触目总柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其七十七 柳园","author":"许尚","text":"芳草池塘暖，东风桃杏繁。\n春归人亦散，寂寞锁园门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其六十二 毗卢庵","author":"许尚","text":"扪萝通一径，修竹蔽中篱。\n只有奎章在，龙神暗护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其三十四 鬼书","author":"许尚","text":"壮士为儒耻，捐躯志所甘。\n无名豫青史，幽愤亦何堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其八十五 圆珠庵","author":"许尚","text":"定回人寂静，绕鼻碧莲香。\n却认循檐月，摩尼发夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其十二 秦女祠","author":"许尚","text":"狼秦崇苛政，有女亦蒙冤。\n欲吊兴亡事，神应耻重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其二十 秦皇驰道","author":"许尚","text":"叹昔秦皇帝，何年此逸游。\n迢迢大冈路，千古为嗟羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其三十三 莲巢","author":"许尚","text":"记得荷香里，蛾眉唱采莲。\n千年龟欲总，不见叶田田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其三十六 袁崧宅","author":"许尚","text":"疆场功成后，归来卜一邱。\n当时应种德，名字播千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其一 顾亭林","author":"许尚","text":"旦暮潮流急，东西径路斜。\n无从质疑字，共属野王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其十三 唳鹤湖","author":"许尚","text":"洸荡云閒路，奫沦一水深。\n月光涵露重，遥听九皋音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其六十七 唳鹤滩","author":"许尚","text":"养鹤人何在，湖边水尚清。\n唤回中夜梦，滩上戛然声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其五十一 望云桥","author":"许尚","text":"忆昨登临日，卿云正四翔。\n重来穷目力，天末起祥光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其八十一 望仙桥","author":"许尚","text":"鹤驾乘风去，千年竟不归。\n石梁凭望处，空复白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其三十一 淀山","author":"许尚","text":"殿阁辉金碧，遐观足画图。\n维舟一登览，误涉小方壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其六 寒穴泉","author":"许尚","text":"濆涌悬崖下，泠泠注不穷。\n将期挹甘冷，弱水渐难通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其四十 御史泾","author":"许尚","text":"疏凿人何在，流功几世馀。\n农氓诵名氏，不数郑公渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其五十三 普照寺","author":"许尚","text":"高门收画戟，即此建精蓝。\n施予恩虽在，缁流绝不谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其七十 湖光亭","author":"许尚","text":"日暮虾须卷，亭中雅燕开。\n微风起蘋末，波影动樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其六十六 湖桥","author":"许尚","text":"潋滟湖光好，荷风六月凉。\n倚栏吟不倦，鱼鸟亦相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其七十一 道院","author":"许尚","text":"净观今何在，唯馀柏色新。\n栖栖抱瓮者，不是鍊丹人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其二十五 集贤里","author":"许尚","text":"冠盖游从日，欣然萃一乡。\n田原总如昨，谁复嗣馀芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其五十八 福顺庙","author":"许尚","text":"门垣虽蠹坏，古屋尚深沈。\n鸟雀犹知避，斯民盍致钦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其四十七 震桥","author":"许尚","text":"瓦木明丹垩，初期镇此方。\n石梁今欲圮，尤益富蛮商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其三十八 鹤坡","author":"许尚","text":"索寞东郊远，仙禽尽此藏。\n梦回明月夜，林杪响圆吭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其四十五 濯缨亭","author":"许尚","text":"舆梁斜倚处，檐影坠清流。\n往往抽簪者，常为孺子羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其二十八 秀道者塔","author":"许尚","text":"辛勤成雁塔，俄赴积薪焚。\n静夜眈眈影，疑来护刻文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其五十七 云閒馆","author":"许尚","text":"邮亭临爽垲，杗廇架修虹。\n我亦轮蹄客，心期访士龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其四十四 月榭","author":"许尚","text":"檐角衔墙固，明疏护翠罗。\n公馀秉谈麈，竟夕对金波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其五十二 石幢","author":"许尚","text":"矻立应千载，传因海眼成。\n蓬莱水清浅，曾不见敧倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其八十三 净居院","author":"许尚","text":"明眼知何在，山门久寂然。\n宗风未沦替，还喜一镫传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其五十 赵店","author":"许尚","text":"日日黄尘路，喧豗涨市声。\n神灵自安此，不欲变名称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其七十六 栖真庵","author":"许尚","text":"仙路多官府，真人未上升。\n松窗霜月白，相对诵黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华亭百咏 其二 顾府君宅","author":"许尚","text":"萧萧兰若地，知是府君居。\n祠事今谁奉，吾来一叹吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"许庚","text":"砚润浮残墨，琴乾响断弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"许庚","text":"顿超捷进脱，故习肩前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"许庚","text":"思苦无一字，意来成数篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"许庚","text":"值雨花无怨，留春鸟自谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"许庚","text":"壮岁期加进，新吟未敢编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"许庚","text":"花尽辜啼鸟，麻深没过人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晋桧行","author":"许弥安","text":"紫极宫中晋朝桧，故老语我今千年。\n盘根厚地龙蛇走，干薄霄汉星斗悬。\n玄冬飞雪断人迹，贞姿不改平时妍。\n虬枝香叶翠如幄，一子不落含苍烟。\n胡为广厦构梁栋，如此大材乃弃捐。\n伊昔晋朝纷乱日，衣冠南渡依江堧。\n风流王谢各幻化，肝胆铁石还依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南庄","author":"许昌龄","text":"南庄相对北庄居，更入深山十里馀。\n幽路每寻樵径上，真心还与世情疏。\n云中犬吠流星过，天外鸡鸣晓日初。\n昨日有人相问讯，旋将落叶写回书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麻姑山","author":"许抗","text":"数里岧峣落日西，更高高处种灵芝。\n危峰受雪春归晚，怪石留云雨到迟。\n仙鹿避人眠浅径，野禽窥果啄残枝。\n待应俗格消磨尽，重建瑶台旧路岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉宫春夜","author":"许玠","text":"虚轮绚采千门外，窗眼渗光金箔碎。\n渴龙滴水续铜壶，檐马呼风摇玉佩。\n宫车声远翠幌幽，珠帘闲却珊瑚钩。\n眉山两点亦何有，中锁万斛相思愁。\n蜀罗蜜炬光明灭，红泪难溅守宫血。\n遥夜春寒听晓钟，角声满地梨花雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"染丝上春机","author":"许玠","text":"锦江之水来蜀西，女红染丝上春机。\n可怜欲织未织时，思君意绪如乱丝。\n乱丝尚可理，妾愁渺无际。\n寒窗轧轧千万梭，断魂随梭暗来去。\n荡子醉花月，妾辜鸾镜妆。\n寒蛩只解趣机杼，争奈情如刀剑伤。\n织成回纹诗，寄与白玉郎。\n愿郎勿弃置，上有双鸳鸯。\n?著双鸳鸯，忍教孤妾守空房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"美人对镜歌","author":"许玠","text":"天上雄鸡啼一声，人间万鸡相应鸣。\n美人红酣尚未醒，锁掣金匙鹦鹉惊。\n鹦鹉从来巧言语，声聒锦帏残梦起。\n猛揎罗袖窝绿云，步逼妆台趁梳洗。\n玉奁脱覆光烁人，洞房环曲惊晓春。\n不是清空月飞入，如何中有姮娥身。\n轩辕百鍊今湮灭，扬州青铜却奇绝。\n人非照镜镜照人，镜亦分明为人说。\n媸妍一镜固两般，狐妇怀奸心胆寒。\n闺中少女色庄丽，眉颊不妨终日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"许玠","text":"西风又转芦花雪。\n故人犹隔关山月。\n金雁一声悲。\n玉腮双泪垂。\n绣衾寒不暖。\n愁远天无岸。\n夜夜卜灯花。\n几时郎到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏项籍庙二首 其二","author":"许彦国","text":"千古兴亡莫浪愁，汉家功业亦荒丘。\n空馀原上虞姬草，舞尽春风未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵金氏墓","author":"许复道","text":"埋骨青山足古今，北邙深锁暮云平。\n夜台长寄千秋烈，子燕何须吊王京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涵碧亭 其一","author":"许复道","text":"飞泉当面玉虹垂，收拾惊涛贮小池。\n□□倚岩山骨秀，激湍成雨涧毛滋。\n壁閒遗墨凄尘□，眼底新篇□色丝。\n却忆谢公山更好，梦中时不负心期。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涵碧亭 其二","author":"许复道","text":"绕竹沿崖一径垂，穿山飞玉落芳池。\n林深坐觉尘埃远，岩润长含雨露滋。\n双鲤对浮波面石，一纶难掷掌中丝。\n月明归路烟霞外，更与山公再订期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涵碧亭 其三","author":"许复道","text":"沿途听潺湲，蒙茸冒沙石。\n谁知此山下，千里在咫尺。\n潭潭光明宫，皎皎心印宅。\n石细泉自香，水净林逾碧。\n太清无潜鳞，至弱而能力。\n玉龙出苍峡，威勇壮莫敌。\n风雨填空来，万夫助推激。\n座中起波涛，足下殷霹雳。\n我来纵雄观，神意了莫逆。\n心镜净表里，坐久万籁息。\n悠然到平淡，涣若春冰释。\n栖迟罗书记，想像刘宾客。\n胜缘在山閒，每至忽有得。\n何以谢山灵，作诗慰岑寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题樊汉炳墓","author":"许奕","text":"高志峥嵘局九州，直从人里著仙筹。\n青囊书在鬼神泣，黄绢词高冰雪羞。\n槐里但知曾折角，兰台无复问长头。\n玉棺夜入青云去，山是人非白鹤愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 茅庵","author":"许将","text":"茅茨以为庵，环顾萧然虚。\n内乐苟自足，容人即有馀。\n旁依修竹密，上翳青松株。\n勿言此中陋，中有君子居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题徐真君祠堂东西二室","author":"许将","text":"上得山来过石门，谒灵特地乞真言。\n再三许我前程事，敢不留诗荷圣恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东山碧岩亭","author":"许将","text":"旧室曾留古岸边，新亭同赏碧岩前。\n日生狮子峰头树，烟伴榴花洞口泉。\n黄叶入秋山出地，白云临晓海乘天。\n飘然踪迹今何定，别去江湖又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 玉溪堂","author":"许将","text":"朱堂俯玉溪，玉溪清且幽。\n从公暂偃息，抚景空夷犹。\n浮云冠圆岛，白日回方流。\n抵此有光碧，何必昆崙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题积善院","author":"许将","text":"为爱山居乐，居山又忆家。\n菊黄来日蕊，梅白去时花。\n水阔离情远，霜晴别恨赊。\n前程回首望，空指暮天霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游东山和程大卿师孟","author":"许将","text":"东山十里复溪流，远客时时骋望愁。\n泉近榴花深洞口，亭开狮子旧峰头。\n一州旂色天边出，三馆芸香海上留。\n南北共歌公所憩，独嗟无计共英游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 小亭","author":"许将","text":"翩然沟上亭，左右相映带。\n修楠列翠幄，长松偃高盖。\n地褊景逾宽，处约志弥泰。\n谁知坐啸间，心游万物外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 月台","author":"许将","text":"蜀地山四维，益州平如掌。\n累台郁临风，坐看月宵上。\n稍出丛木末，始发众籁爽。\n兹焉暂游目，一览天地广。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 水阁","author":"许将","text":"飞阁出方池，修竹见空莽。\n低临花坞近，平觉春波长。\n返景澄馀晖，夕阴带浮爽。\n从容观鱼乐，不减游濠上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 西园","author":"许将","text":"高牙负北郭，芳园路西转。\n鸟鸣恋故木，兰茁归新畹。\n坐延花景深，行倚筇枝软。\n翳然思林木，会心不在远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 海棠轩","author":"许将","text":"海棠冠蜀花，此轩花尤冠。\n红云簇蕊细，渌水照叶嫩。\n倚妆宫粉聚，叠绮霞光散。\n雨泪点春风，应怀上林怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 雪峰楼","author":"许将","text":"重楼起城阴，乘高望四极。\n列峰横青天，飞雪千里积。\n疑是空素山，冬夏海中白。\n莫怪频东向，上有思归客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都运司西园亭诗 翠锦亭","author":"许将","text":"阑干窦溜长，䆗窱空埃静。\n修林密总翠，尽得锦城景。\n云舒青青色，风散骚骚影。\n未为夜行人，共此昼夜永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]