[{"title":"次韵兄长见示二首 其一","author":"许景衡","text":"拜命辞南国，携孥客上京。\n尘沙惊老眼，江海梦归程。\n酾酒谁思我，看云赖有兄。\n遥知倚栏啸，天阔暮潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵兄长见示二首 其二","author":"许景衡","text":"此境本无尘，端居更可人。\n林园稍成趣，风月转相亲。\n暇日已卜筑，他年待乞身。\n绝胜贪梦好，临老种松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翁老过邑","author":"许景衡","text":"百里弦歌地，别来俄至今。\n江山已陈迹，桃李漫馀阴。\n白发心犹壮，清歌酒屡斟。\n何妨镇还往，眷眷吏民心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬卢行之","author":"许景衡","text":"绿分冰片碎，金拂柳丝长。\n腊雪犹含冻，春风何太忙。\n会看莺出谷，不羡雁随阳。\n谁忆江梅发，风流八米郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次陈留","author":"许景衡","text":"裋褐驱羸马，依然寒气侵。\n春风官柳细，红日雪泥深。\n蔼蔼多佳气，飞飞亦好音。\n宁辞去家远，魏阙旧驰心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"款某大理坟","author":"许景衡","text":"丹笔持平久，清时属望深。\n谁怜一抔土，长负百年心。\n旧友多高谊，诸郎亦好音。\n独惭门下客，流落但悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姨母薛夫人挽词","author":"许景衡","text":"不独相君子，仍闻教子功。\n安舆四方外，色养百年中。\n陇亩唯先树，江湖独转蓬。\n凋零惊母党，涕泪落秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵表侄出先德彦章诗卷","author":"许景衡","text":"晚路嗟流落，长时任郁陶。\n故人今地下，新句出儿曹。\n野润春风早，霜清夜月高。\n杯盘旧行乐，江水日滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈泽民见寄","author":"许景衡","text":"涉世真堪笑，论交愧未忘。\n先生已高遁，贱子尚他乡。\n簿领三年梦，尘沙两鬓霜。\n扁舟归未得，春水满横塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逗晓","author":"许景衡","text":"逗晓复篮舆，平田细路迂。\n村墟元阒寂，篱落更萧疏。\n吠犬行随客，痴童唤觑渠。\n从来喜淳朴，况复野人居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海上","author":"许景衡","text":"江阔浑无际，潮平更不流。\n鱼龙方鼓跃，凫鸭共沉浮。\n别岸多云树，斜阳一钓舟。\n蓬莱如可到，当与子同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和左经臣移居","author":"许景衡","text":"暑往衣仍葛，秋来甑尚尘。\n北宫尤养勇，东郭故安贫。\n去国经时久，临江卜筑新。\n未能供禄米，愧尔少陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王义夫召饭鳌山亭诗","author":"许景衡","text":"海上闻三岛，人间占几州。\n孤城临鸟道，雄构压鳌头。\n缥缈层轩外，萦纡一径幽。\n鸣琴常有暇，飞盖许同游。\n平野连天阔，洪河绕塞流。\n清风驱酷暑，畏日得新秋。\n麦破银丝净，茶烹玉蕊浮。\n官联惭蹇浅，恩纪独绸缪。\n牢落登高赋，驱驰为食谋。\n从公时晤语，不复叹淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘元礼","author":"许景衡","text":"东郡趋锋召，西廱振羽仪。\n微言元自得，夫子更谁师。\n文物今为盛，贤能众不遗。\n秋风看雕鹗，碧海尽蛟螭。\n妙选追前辈，高标照一时。\n綵衣供戏乐，绛帐欲归迟。\n念昔群居盛，论文非我私。\n艰难良自信，出处不无疑。\n骐骥方千里，鹪鹩但一枝。\n田园日牢落，浩荡故山期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平沙阁呈陈古田","author":"许景衡","text":"画栋朱栏压水涯，稍看剑石欲平沙。\n虹梁突兀几千尺，云屋崚嶒一万家。\n衮衮公侯应日起，纷纷桃李竞春华。\n双凫自合朝天去，饶与银河八月槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送董公权入洛","author":"许景衡","text":"蹉过名园百五期，眼前谷雨未为迟。\n好麾席上铁如意，拚醉花前金屈卮。\n尘土毋辞久行役，簿书何计得追随。\n河南耆旧俱冥寞，试问如今更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"献王祠","author":"许景衡","text":"列国提封倚乐亭，九河分处见孤城。\n池台钓罢人何在，邱垄春来草自生。\n遗像丹青皆旧物，斯民箫鼓漫新声。\n谁能特表平生事，祝史从官得币牲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄新茶王圣时蒙示五诗","author":"许景衡","text":"建溪初采雪芽香，病客分来敢独尝。\n一盌聊为金粟供，五篇不学玉川狂。\n风雷有信犹嫌晚，草木无情也著忙。\n谁似山中老松柏，不知人世有炎凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠夏倅","author":"许景衡","text":"九华直上参云汉，秀气由来出缙绅。\n闻道贤良归盛族，故应文彩继前尘。\n春风醴酒年年好，月色灯花处处新。\n他日传柑向双阙，还思曾醉慎江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和左与言","author":"许景衡","text":"贫病年来谢还往，交亲书问可相闻。\n如何旧好怀天末，犹及新诗寄海濆。\n吾子叔孙尽咸籍，主人兄弟亦机云。\n群居犹有游从乐，官况凄凉独广文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬张敏叔","author":"许景衡","text":"东嘉匕箸琢红玉，北苑蘖芽模紫金。\n野人何知敢持饷，诗老发兴为高吟。\n松江莼鲈有家世，吴宫风月无古今。\n饭稻煮茗穷胜览，纷纷市朝尘土深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和张敏叔","author":"许景衡","text":"留连五斗未投閒，独坐穷愁有万般。\n多谢题诗相慰藉，应怜涉世最艰难。\n载闻诗老推工部，何止神童说长官。\n我亦半生收好句，夜光偏照箧中寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和敏叔二首 其一","author":"许景衡","text":"弱冠曾攀桂一枝，半生为国理棼丝。\n高吟直到古人处，勇退宜为世俗师。\n杖屦访僧长过晚，茶瓜留客固应迟。\n黄山游旧今能几，诗社犹忻小子随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和敏叔二首 其二","author":"许景衡","text":"固知岛可是诗奴，何况区区杜与吴。\n举世徒能循覆辙，先生今为剪蘩芜。\n渊明松菊还堪赋，白傅园池亦有图。\n莫把五湖都占了，也须留与故人俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和董适道","author":"许景衡","text":"十载江湖早得名，未饶淮海独孙登。\n挥毫落纸才无敌，倾盖论交喜不胜。\n休问喧哗多燕雀，须知变化有鲲鹏。\n青云步步前头去，却莫低飞似我能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张子寿二首 其一","author":"许景衡","text":"红紫纷纷尽斗妍，游蜂舞蝶亦翩翩。\n一年纯是愁閒事，三月过来几醉眠。\n生怕杨花飞似雪，忽惊荷叶大如钱。\n诗人只解寻佳句，分付春愁与少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张子寿二首 其二","author":"许景衡","text":"风雨朝来不甚颠，残花赢得更留连。\n帘栊寂寂莺方乳，桑柘阴阴蚕欲眠。\n老杜只将诗作伴，孝先偏与睡相便。\n江湖潋滟皆春水，好在横塘旧钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改葬西山延仲主簿特赐庆什次韵","author":"许景衡","text":"改卜西山痛更深，新瑩松柏未成林。\n三牲不待平时养，再命何胜永慕心。\n泉壤多应增喜气，陇云还为结愁阴。\n褒称重辱新诗句，拜德浑如旱岁霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月十九日同亨仲按乐大晟","author":"许景衡","text":"闻道莺花满上林，寻芳谁更畏霖霪。\n鸣鸠乳燕春欲晚，去马来牛泥自深。\n出火星坛方肇祀，联镳乐府按新音。\n溶溶九陌皆流水，撩动平生江海心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夕别仲焕","author":"许景衡","text":"并辔不嫌车马尘，肯教节物恼行人。\n残年气候消磨尽，来日风光陡觉新。\n我已襄阳访耆旧，君方郢国和阳春。\n虽然不作多时别，怀古知谁意气亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐知府宗博 其一","author":"许景衡","text":"学省当年假佩绅，谁知家世有功臣。\n朝班长忆倾鹓鹭，海角俱欣识凤麟。\n坐抚斯民虽有道，细看此境本无尘。\n自怜老马犹迷路，邂逅何妨一问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐知府宗博 其二","author":"许景衡","text":"了无声价继三豪，敢叹崎岖世路劳。\n纶阁文书惭润色，琳宫香火想焄蒿。\n鲲鹏变化谁能料，燕雀飞翻自不高。\n松竹虽无三径在，长歌归去也如陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵 其一","author":"许景衡","text":"得贤一语可书绅，妙选由来属世臣。\n千里方能辨驽骥，四灵安可后龟麟。\n共看再造恢王业，肯使中原杂战尘。\n闻有皇都近消息，眉间喜气已津津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵 其二","author":"许景衡","text":"异礼多应得隽豪，病夫深愧馆人劳。\n初欣秩秩陪宾席，却忆呦呦赋野蒿。\n春草池塘还得句，霜天雕鹗定飞高。\n也知野客多閒散，丹灶松风独访陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄家兄","author":"许景衡","text":"斗禄驱驰惊岁晚，世涂龃龉奈时何。\n也知犬马犹能养，自恨田园苦不多。\n儿女近来浑长浪，弟兄何事尚奔波。\n横塘卜筑今应好，试为频频理钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会馀庆","author":"许景衡","text":"山城动是三年别，古寺今陪半日閒。\n簿领嗟余多眊氉，道涂怜子亦间关。\n并游天上皆英俊，几个江边肯往还。\n莫惜一尊相伴醉，已将毛发等丘山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"休师惠诗次韵","author":"许景衡","text":"也知寸木可高岑，肯负平生学古心。\n王事曾无丝粟补，鬓毛已觉雪霜侵。\n寓留古寺聊登览，喜有高僧与对吟。\n更忆仙山最深处，岩前小雨弄晴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仁上人","author":"许景衡","text":"饱听长芦江水声，归看苕霅更分明。\n故人应叹遽如许，慈母翻愁太瘦生。\n邂逅舣舟同一笑，登临怀古亦多情。\n髯张好句新拈得，恰好而今送子行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿灵峰赠总持大师","author":"许景衡","text":"记得曾为凤林客，高僧住处最深幽。\n几千里外重携手，三十年间一转头。\n霜叶乍惊风槭槭，云堂相对夜悠悠。\n去留聚散元无著，自笑多情更刻舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄康师","author":"许景衡","text":"好在仙岩康上人，从来心事许谁亲。\n品题泉石诗无敌，吞吐烟霞笔有神。\n闻道弟兄皆妙质，要当谈笑继前尘。\n个中况有东溪老，行处何妨更问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄仙岩元上人","author":"许景衡","text":"龙穴梅潭抱岭斜，忆曾同试雨前茶。\n稍须林壑开云叶，便倩儿童汲井花。\n一别仙山空梦寐，五年边塞走尘沙。\n会须觅片閒田地，邻舍如侬有几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送持后过越","author":"许景衡","text":"永嘉竹阁谈空相，自是僧中第一流。\n尽放衲僧来听讲，也容禅子不相谋。\n二林三峡曾经耳，万壑千岩试举头。\n提取净瓶涓滴许，有时散作五湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"聪师邀入山","author":"许景衡","text":"学道无成亦可怜，纷纷膏火自熬煎。\n似闻沽酒邀元亮，故敢移书问大颠。\n州县徒劳输此日，云山高卧或他年。\n须知二老风流在，赏遍西枝月更圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞仲访僧正见招以诗属亟归不及往依韵和报兼简康休二上人","author":"许景衡","text":"东溪自是老林师，千偈澜翻独此时。\n尽判百家无好句，故教二子亦能诗。\n逢迎蜡屐应班草，奔走芒鞋愧采芝。\n多谢相招故人意，更惭妙韵继前思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题舒氏览秀楼诗","author":"许景衡","text":"绕屋青山罗髻鬟，小楼幽胜可跻攀。\n不论空翠烟霏处，尽在轩窗几研间。\n眼净更无黄土眯，身轻仍伴白云閒。\n他年定作还乡计，傥与亲朋一扣关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戴夫人挽词","author":"许景衡","text":"诗书历历教乡邻，甘旨熙熙八十春。\n尽道先生真孝子，故知贤行属夫人。\n穗帷一诀三年后，柏垄孤坟数尺新。\n剪綵种萱今已矣，多应处处有遗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"傅夫人陈氏挽词","author":"许景衡","text":"婉娩名家早结缡，伯鸾初怪嫁时衣。\n半生已觉人间梦，九死犹知俗习非。\n日永春风漾蘋藻，夜寒霜月落庭闱。\n稽山会葬人归后，千古苍官守翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柯运判修试院","author":"许景衡","text":"当年龙阁帅闽中，辟馆兴贤特地雄。\n还见芝兰修世职，固知斧藻有家风。\n堂堂剑佩瞻遗像，衮衮簪绅出泮宫。\n劝学一门真盛事，西州何独美文翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台守刘袭明都讲二首 其一","author":"许景衡","text":"江入章安波浪寒，仙山缥缈在江干。\n二千石是谁为守，三十年前好长官。\n闻道渔樵安里社，从教风月落杯盘。\n新诗别后知多少，更借邻翁洗眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台守刘袭明都讲二首 其二","author":"许景衡","text":"薰然和气破春寒，见说专城冠越干。\n讼牒不劳挥翰手，欢谣好付采诗官。\n独惭圣世人三黜，谁怕仙山路九盘。\n但得白头长健在，莫辞青眼重相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送连子友守淮安二首 其一","author":"许景衡","text":"古来江汉最风流，何况分符得显州。\n落日淮源香泛泛，含春沁水绿悠悠。\n两岐定有丰年瑞，五裤行闻载路讴。\n大观督邮谁见忆，萧萧华发对沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送连子友守淮安二首 其二","author":"许景衡","text":"忆昨银袍试广庭，桂科同日拜恩荣。\n几千里外相逢处，三十年间一梦惊。\n隼旆光华仍远别，豸冠流落独含情。\n清淮东下饶双鲤，江海何妨数寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送何亨老出守泰州","author":"许景衡","text":"海陵人说毗陵好，太守当年迥不群。\n新命而今分竹去，欢谣何似隔江闻。\n簿书幕下人谁任，尊俎楼头客自醺。\n千骑固应知体国，古来畎亩不忘君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张敏叔守梓州","author":"许景衡","text":"风月关心自不闲，诗家本领更多般。\n千篇要继杜陵后，万里宁辞蜀道难。\n今日赤帷新刺史，几年锦帐旧郎官。\n莫嫌白首功名晚，松柏从来耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国寺诗 其一","author":"许景衡","text":"未暇远寻庐阜游，只消护国也深幽。\n种莲惠远谁还往，得酒渊明自献酬。\n恶句多惭居唱首，高吟长许作遨头。\n请看十八人同社，尽是人间第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国寺诗 其二","author":"许景衡","text":"小诗聊记凤山游，髣髴东林水石幽。\n已愧高僧与摹刻，更烦诸老数赓酬。\n簿书底事长遮眼，林壑何人肯转头。\n会待从公白莲社，杖藜来往亦风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵冯吉老","author":"许景衡","text":"马蹄长厌软红尘，欲去虚名意亦欣。\n壮士宁为东阁客，故人休诵北山文。\n到家留语应如鹤，出岫无心恐似云。\n我亦有田江海曲，年来舍已为谁耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵卢彦升","author":"许景衡","text":"同场名辈敢争锋，想见当年赋咏工。\n苒苒星霜今欲老，拳拳畎亩独怀忠。\n羊肠已失千重险，鹏翼方看万里风。\n应笑长安徒索米，不知鼯鼠技将穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈季修","author":"许景衡","text":"綵衣初寄水边村，学子纷纷已满门。\n闻道诗书多旨趣，固知师友有渊源。\n声名在子那能掩，志业如余岂足论。\n应笑倦飞归已晚，结庐开径近云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵经臣见赠","author":"许景衡","text":"犬羊无故事喧争，惆怅中原失太平。\n天上风霜方鼓动，人间草木已欣荣。\n共怀前日千龄遇，谁使蒙尘万里行。\n泪眼时时望沧海，百川渺渺向东倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过敏叔次韵","author":"许景衡","text":"花县曾联令宰裾，神都今喜没阶趋。\n青云羽翼看一鹗，秋水精神识二雏。\n历览何如少陵集，新诗便是梓州图。\n狂吟大胆谁知我，敢向龙门捋虎须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵承之春日","author":"许景衡","text":"土牛唤起打春人，休向东郊更探春。\n未说风光十分好，且看节物一番新。\n田园自省非无意，簿领谁知尚为贫。\n关塞尘沙长满眼，横塘冰破碧鳞鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄内","author":"许景衡","text":"离家不道多时别，在路俄惊两月阑。\n漫有传筒将委曲，祇容书历报平安。\n文园虽得相从乐，明月长思一处看。\n早晚征鞍过天姥，寄声草草具杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横山阁","author":"许景衡","text":"一笑楼头属晚晴，我曹此乐最难名。\n玉樽浮蚁一样白，青眼与山相对横。\n个里风流终古在，世间荣利过云轻。\n未应暮色催归思，天外娟娟新月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]