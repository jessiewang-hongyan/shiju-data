[{"title":"浣溪沙 木犀","author":"刘学箕","text":"天上仙人萼绿华。\n何年分种小山家。\n九秋风露溢窗纱。\n密密翠罗攒玉叶，团团黄粟刻金花。\n一枝归插鬓云斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜分飞 柳絮","author":"刘学箕","text":"池上楼台堤上路。\n尽日悠扬飞舞。\n欲下还重举。\n又随胡蝶墙东去。\n糁径飘空无定处。\n来往绿窗朱户。\n却被春风妒。\n送将蛛网留连住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 白湖观捕鱼","author":"刘学箕","text":"汉水悠悠还漾漾。\n渔翁出没穿风浪。\n千尺丝纶垂两桨。\n收又放。\n月明长在烟波上。\n钓得活鳞鳊缩项。\n篘成玉液香浮盎。\n醉倒自歌歌自唱。\n轻袅缆。\n碧芦红蓼清滩傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"刘学箕","text":"十年不见柳腰肢。\n契阔几何时。\n天遥地远，秋悲春恨，只在双眉。\n雁声今夜楼西畔，情愫渺难期。\n杏花风景，梧桐夜月，都是相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"刘学箕","text":"鸦儿学画犹嫌丑。\n佯羞步步随娘后。\n春浅瘦花枝。\n凝愁为阿谁。\n那回筵畔见。\n有意相留恋。\n只恐后期愆。\n章台飞柳绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 杏花","author":"刘学箕","text":"昨日杏花春满树。\n今晨雨过香填路。\n零落软胭脂。\n湿红无力飞。\n转头春易去。\n春色归何处。\n待密与春期。\n春归人也归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"刘学箕","text":"暮涛掀浪溪流急。\n单衣未试春寒力。\n是处绿阴浓。\n春深杨柳风。\n人依溪岸住。\n酒美忘归去。\n巢燕堕芹泥。\n幽禽花外啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 鄂渚岸下","author":"刘学箕","text":"烟汀一抹蒹葭渚。\n风亭两下荷花浦。\n月色漾波浮。\n波流月自留。\n若耶溪上女。\n两两三三去。\n眉黛敛羞蛾。\n采菱随棹歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 避暑","author":"刘学箕","text":"午转槐阴，正炎暑、侵肌似醉。\n问何处、披襟散发，解衣扬袂。\n傍沼茅亭杨柳绿，倚崖草阁梧桐翠。\n唤玉人、纤手掬清泉，生凉意。\n开枕簟，浮瓜芰。\n琼液浅，歌喉细。\n对文禽雪鹭，助成幽致。\n十顷碧莲潇洒国，万竿修竹清凉世。\n算此时、情绪有谁同，吾侬自。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 双头莲","author":"刘学箕","text":"一柄双花，低翠盖、呈祥现美。\n人正在、薰风亭上，满襟如水。\n二陆比方夸俊少，两乔相并修容止。\n雨初晴、午永斗红酣，真奇耳。\n双白鹭，双赪鲤。\n飞与泳，俱来此。\n绾双鬟天上，侍香童子。\n双剑丰城双孕秀，双凫叶县双趋起。\n谩空谈、国士本无双，今双矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"刘学箕","text":"寒来暑往何时了。\n世故催人老。\n一人口插几张匙。\n何用波波劫劫、没休时。\n饥来吃饭困来睡。\n莫把身为累。\n谁能较短与量长。\n落叶西风一梦、熟黄粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 北津夜雪","author":"刘学箕","text":"灯火已收正月半。\n一夜东风，吹得寒威转。\n怪得美人贪睡暖。\n飞瑛积玉千林变。\n道是柳绵春尚浅。\n比著梅花，花已都零乱。\n漠漠一天迷望眼。\n多情更把征衣点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄 用范石湖韵","author":"刘学箕","text":"江头离席。\n晚潮双橹催行色。\n往来属玉双飞白。\n笑我多情，犹作未归客。\n红尘奔走何时息。\n归心还似投林翼。\n角巾醉里从敧侧。\n独立东风，天际露岑碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"糖多令/唐多令 登多景楼","author":"刘学箕","text":"何处浣离忧。\n消除许大愁。\n望长江、衮衮东流。\n一去乡关能几日，才屈指、又中秋。\n芦叶满汀洲。\n沙矶小艇收。\n醉归来、明月江楼。\n欲把情怀输写尽，终不似、少年游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 赋雪","author":"刘学箕","text":"楼外银屏入望赊。\n楼前鸥鹭舞交加。\n穿林淅沥飞琼屑，度嶂缤纷过柳花。\n歌白雪，醉流霞。\n晚寒寒似夜来些。\n明朝酒醒掀帘幕，帘幕依然卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"刘学箕","text":"梦绕天涯去意浓。\n客愁春恨两匆匆。\n绿波初涨桃花浪，画鹢轻随柳絮风。\n无笔力，判虚空。\n关山千里两心同。\n鱼书雁字都休问，只看啼痕翠袖红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"刘学箕","text":"山色都如归兴浓。\n春融融处客匆匆。\n岸花影里莺吟雾，江阁阴中燕受风。\n凭画楯，睇层空。\n情衷待说几时同。\n不如且尽樽中绿，图得醄醄醉脸红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 发舟安康，朋游见留，往复三用韵","author":"刘学箕","text":"芳草萋萋入眼浓。\n一年花事又匆匆。\n吐舒桃脸今朝雨，零落梅妆昨夜风。\n云接野，水连空。\n画栏十二倚谁同。\n两眉新恨无分付，独立苍苔数落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 寿刘耕斋","author":"刘学颜","text":"红冈小塔枫林路，曾见承平歌舞。\n舞罢人归，月斜影转，重见郎官星度。\n乡关境土，又二十馀年，桑麻深露。\n说与闾巷，少年知得当时否。\n如今苍颜白发，问耕聊尔耳，依稀农圃。\n父老吾伊，深山鸡黍，谁念乱离父母。\n村南昼午。\n谩对客烹茶，笑谈今古。\n千岁迢迢，竹风时扫户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾公岩","author":"刘宗杰","text":"谢公高兴在东山，寻得仙岩郡邑边。\n万朵连峰凝碧乳，一溪鸣玉逗寒泉。\n由来物外无尘景，须信壶中有洞天。\n岭服已安褒诏近，莫将归梦更留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题涪州石鱼","author":"刘忠顺","text":"七十二鳞波底镌，一衔蓂草一衔莲。\n出来非共贪芳饵，奏去因同报稔年。\n方客远书徒自得，牧人嘉梦合相先。\n前知上瑞宜频见，帝念民饥刺史贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题资圣寺宗己嘉遁居","author":"刘忠顺","text":"院幽庵更小，嘉遁称名尊。\n展榻殊无地，看山别有门。\n潮来供菜圃，云过隔城村。\n了毕如来藏，任他风动摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱","author":"刘性初","text":"喜首夏清和，槐绿成阴，榴红正朵。\n仙鹤翩跹，来致千秋贺。\n南极长明，后天不老，瑞霭浮青琐。\n满树蟠桃，瑶池捧献，一年一颗。\n好敞亭台，胜添花柳，时醉时歌，时行时坐。\n受用黄庭，宝熟丹田火。\n晓对青山，日吟白发，尽功名江左。\n戏彩亭边，陶陶自得，有何不可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘承弼","text":"境静人亦寂，觞至壶自倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后池上","author":"刘攽","text":"一雨池塘水面平，澹磨明镜照檐楹。\n东风忽起垂杨舞，更作荷心万点声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴 其一","author":"刘攽","text":"青苔满地初晴后，绿树无人昼梦馀。\n唯有南风旧相熟，径开门户又翻书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南田家","author":"刘攽","text":"种田江南岸，六月才树秧。\n借问一何晏，再为霖雨伤。\n官家不爱农，农贫弥自忙。\n尽力泥水间，肤甲皆疥疮。\n未知秋成期，尚足输太仓。\n不如逐商贾，游閒事车航。\n朝廷虽多贤，正许赀为郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南行","author":"刘攽","text":"八月江湖秋水高，大堤夜坼声嘈嘈。\n前村农家失几户，近郭扁舟屯百艘。\n蛟龙蜿蜒水禽白，渡头老翁须雇直。\n城南百姓多为鱼，买鱼欲烹辄悽恻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潭州","author":"刘昉","text":"上天甲子庆升平，春到潇湘倍有情。\n白璧当天千里共，红莲照夜万枝明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘昉","text":"隋物尚馀双鼎在，唐人犹有八诗传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上吕相公","author":"刘昌言","text":"重名清望遍华夷，恐是神仙不可知。\n一举首登龙虎榜，十年身到凤凰池。\n庙堂只是无言者，门馆长如未贵时。\n除却洛京居守外，圣朝贤相复书谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其二","author":"刘昌言","text":"不会持竿意，由来善一身。\n何如事天子，就削汉功臣。\n乱木凋云际，幽禽散水滨。\n空馀台下月，千载属渔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其一","author":"刘昌言","text":"汉业中微炎祚衰，四海奸豪窃神器。\n南阳龙虎方斗争，赤伏真人正天位。\n先生高隐来富春，耕耒青山自如意。\n一竿渔钓乐幽深，七里溪光弄苍翠。\n朝中天子思故人，物色寰中引其类。\n先生独步衣羊裘，咳唾浮云轻富贵。\n足加帝腹傍无人，星动天文失躔次。\n卓哉光武真圣君，终使狂奴毕高志。\n云台千尺尽功臣，谁肯回顾钓台地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘昌言","text":"惟有夜来蝴蝶梦，翩翩飞入刺桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大阳成汤殿内芝草诗","author":"刘泳","text":"新构汤祠映碧成，梁间瑞草表虔诚。\n也同□□寒光润，气禀元精素质清。\n神爵五茎难比□，建□三本未为荣。\n烝民共喜嘉祥异，和气时臻□□平。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏初临 夏景","author":"刘泾","text":"泛水新荷，舞风轻燕，园林夏日初长。\n庭树阴浓，雏莺学弄新簧。\n小桥飞入横塘。\n跨青苹、绿藻幽香。\n朱阑斜倚，霜纨未摇，衣袂先凉。\n歌欢稀遇，怨别多同，路遥水远，烟淡梅黄。\n轻衫短帽，相携洞府流觞。\n况有红妆。\n醉归来、宝蜡成行。\n拂牙床。\n纱厨半开，月在回廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"讽州守","author":"刘炎","text":"未到桃源来，长忆出家景。\n及到桃源了，还是鉴中影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上陈招使","author":"刘炜叔","text":"天戈一指迅雷轰，涌雪公应记洗兵。\n伊洛风烟想如旧，江淮草木转知名。\n争先识面今裴度，孰与论心昔孔明。\n文水万家惟击壤，得无军饷尽归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵经略吴及石门洞","author":"刘牧","text":"谏纸空箱后，高牙拂断霓。\n还符翠洲梦，来见石门题。\n架竹生新径，诛茅得旧蹊。\n阴崖走别洞，阳岭带回溪。\n吟桂人非隐，逢花客自迷。\n虚中存纳受，绝壁阻攀跻。\n地远饶征戍，君来息鼓鼙。\n吏闲眠麂鹿，民乐戏凫鹥。\n胜事时相遇，芳樽手屡携。\n清风与诗句，留与昔贤齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"储福宫","author":"刘知仁","text":"所忧目力尽，未问两足酸。\n云峰三十六，一一皆可观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"刘知过","text":"浓起香尘十里晴，晚来烟雨忽斜横。\n花开花落清明候，山北山南杜宇声。\n追念旧游浑是梦，退思良计不如耕。\n人中喜有弥天释，时吐清文慰此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题国清寺","author":"刘知过","text":"野人游遍天台寺，究竟招提此最奇。\n十里远排清荫入，五峰如按画图窥。\n隋初便有高僧传，火后都亡过客诗。\n重到定知非远约，岸巾高处立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘若冲","text":"闽川景物清宜画，萧寺楼台丽欲浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重刻孙谢二公诗","author":"刘述","text":"汉兴文艺推儒首，谏议才能□□师。\n更向谢岩镌丽句，清风千古照江湄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五泄山","author":"刘述","text":"翠屏千叠水潺潺，一簇青鸳杳霭间。\n惜是晚年逢此境，悔将前眼看他山。\n瀑飞萝磴终难画，龙蛰岩云秪暂闲。\n薄宦劳人无计住，可嗟归去又尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涵碧亭","author":"刘述","text":"两山嵚处一泉飞，飞到亭前聚作池。\n砌下蛟龙盘未起，席间环佩响无时。\n翩翻翠羽青霞色，偃亚芳丛碧玉姿。\n却羡老僧饶岁腊，不知天上有炎曦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曲水阁","author":"刘述","text":"面势俯岩隈，雕轩映水开。\n云从栋间出，人自鉴中来。\n棹楫歌声度，渐裳禊事回。\n东山如未起，好住小蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题竹阁","author":"刘述","text":"竹阁寒相倚，云窗晚共开。\n閒身方外去，幽意静中来。\n声响风随箨，阴移石上苔。\n迟留更清夜，待月露盈杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题洞岩","author":"刘述","text":"英英洞口云，触石才一缕。\n须臾遍空山，霈然作灵雨。\n万物一以泽，孤踪无处所。\n我心良所珍，作诗以自矩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家山好","author":"刘述","text":"挂冠归去旧烟萝。\n闲身健，养天和。\n功名富贵非由我，莫贪他。\n这歧路、足风波。\n水晶宫里家山好，物外胜游多。\n晴溪短棹，时时醉唱里棱罗。\n天公奈我何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖","author":"刘信夫","text":"长乐钟声下九天，万家春色柳摇烟。\n山迎山送利名客，潮落潮生来去船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 春晚","author":"刘南翁","text":"没计断春归路。\n借问春归何处。\n莺燕也含愁，总对落花无语。\n春去。\n春去。\n门掩一庭疏雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉树谣","author":"赵汝淳","text":"临春阁下花蒙茸，雕阑玉树沉香风。\n君王酣醉眠未起，满床明月鲛绡红。\n罗襦学士文章女，碧叶黄鹂呈好语。\n可怜日暮秋雨来，惊散一庭金翠羽。\n朱门流水自徘徊，井桐花落无人知。\n江南梦断雁不飞，空城夜夜乌鸦啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 其二 和人春雪词","author":"刘将孙","text":"看东风、天上放梅开，经岁又新成。\n笑柳眼迷青，桃腮改白，蝶舞尘惊。\n任是万红千紫，无力与春争。\n想建章鳷鹊，犹是残霙。\n不比腊前憔悴，拨寒炉榾柮，茶薄烟清。\n快玉龙战罢，四野迥收兵。\n望红花、扶桑国里，玉玲珑、□□海天平。\n晴窗下，疏疏花雨，滴滴春声。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 其三 送春","author":"刘将孙","text":"又江南、三月更明朝，便已是南风。\n拟强驻韶光，狂追柳絮，卧占残红。\n早向尊前沈醉，莫听五更钟。\n赢得春工笑，恼杀渠侬。\n只道春风不改，□年来岁去，柳密花浓。\n但沈腰潘鬓，无复旧时容。\n春还是、多情多恨，便不教、绿满洛阳宫。\n只消得，无情风雨，断送匆匆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 其一 九日登高","author":"刘将孙","text":"不看萸、把酒对名山，无帽厌西风。\n渺四海故人，一尊今雨，万里长空。\n宇宙此山此日，今夕几人同。\n举世谁不醉，独属陶公。\n当日白衣几许，漫凄其寄兴，落日篱东。\n抚停云六合，借醉托孤踪。\n□吊古、不须多感，□古人、那得共杯中。\n拚酩酊，明年此会，谁此从容。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六州歌头 元夕和宜可","author":"刘将孙","text":"天涯倦客，如梦说今宵。\n承平事，车尘涨，马鸣萧。\n火城朝。\n狂歌闲嬉笑，平康客，五陵侠，闲相待，沙河路，灞陵桥。\n万眼琉璃，目眩去闲买，一剪梅烧。\n数金蛾彩蝶，簇带那人娇。\n说著魂销。\n掩鲛绡。\n波翻海，尘换世，铜仙泪，铁心娆。\n渺何地，跢朱履，解金貂。\n步宫腰。\n瑶池惊燕罢，瓶落井，箭离弨。\n灯楼倒，吴儿老，绛都迢。\n点点梅梢残雪，似东风、吹恨难消。\n悄山村渔火，风鬓立春宵。\n绕寒潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆旧游 前题分得论字","author":"刘将孙","text":"正落花时节，憔悴东风，绿满愁痕。\n悄客梦惊呼伴侣，断鸿有约，回泊归云。\n江空共道惆怅，夜雨隔篷闻。\n尽世外纵横，人间恩怨，细酌重论。\n叹他乡异县，渺旧雨新知，历落情真。\n匆匆那忍别，料当君思我，我亦思君。\n人生自非麋鹿，无计久同群。\n此去重销魂，黄昏细雨人闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 败荷","author":"刘将孙","text":"摇风犹似旆，倾雨不成盘。\n西风未禁十日，早作背时看。\n寂寞六郎秋扇，牵补灵均破屋，风露半襟寒。\n坐感青年晚，不但翠云残。\n叹此君，深隐映，早阑珊。\n人间受尽炎热，暑夕几凭阑。\n待得良宵灏气，正是好天良月，红到绿垂乾。\n摇落从此始，感慨不能闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 和子昂题水仙花卷","author":"刘将孙","text":"云涛白凤贺瑶池。\n仗葳蕤。\n路芳菲。\n十月温汤，赐浴卸罗衣。\n半点檀心天一笑，琼奴弱，玉环肥。\n风流谁合婿金闺。\n露将晞。\n雪争晖。\n贝阙珠宫，环佩月中归。\n误杀洛滨狂子建，情脉脉，恨依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城梅花引 登高","author":"刘将孙","text":"明霞回雨霁秋空。\n笑难逢。\n步城东。\n直上翠微，客有可人同。\n回首向来轻节序，筋力异，心犹在，愧鬓蓬。\n悲年冉冉江滚滚。\n骑台平，蒋陵冷。\n天高年晚，山河险，烟雾冥濛。\n一幅乌纱，闲著傲西风。\n古往今来只如此，便潦倒，渺乾坤，醉眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]