[{"title":"挽赵子固左司 其三","author":"孙应时","text":"每叹公知我，垂恩及父兄。\n逢人说名姓，会面写平生。\n近别无双鲤，伤怀忽九京。\n翟公门下客，誓不负交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵子固左司 其一","author":"孙应时","text":"只道功名晚，居然宠数蕃。\n偏令淮楚地，屡睹钺旄尊。\n身隔公卿议，民私父母恩。\n东关往来处，肠断不堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵泰州母刘夫人","author":"孙应时","text":"玉叶宜家旧，金花锡命稠。\n修龄开九秩，荣养指三州。\n足矣真无恋，翛然去不留。\n板舆行乐地，萧瑟桂花秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵泰州善忱","author":"孙应时","text":"唾拾儒科早，阶升命秩尊。\n斑衣娱寿斝，绮席称名园。\n五马催三驾，千秋闭九原。\n春风破山路，松柏惨何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐季节先生 其一","author":"孙应时","text":"语言平谈骨清癯，谁似黄山一老徐。\n眼底不知人富贵，腹中惟有古诗书。\n平生义薄云天上，日暮家无儋石储。\n试问台人君识否，此翁元不事名誉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐季节先生 其二","author":"孙应时","text":"年过八十更精神，佚我房中自在身。\n检点欺心无一发，薰涵和气似三春。\n莫疑见识惊流俗，自是渊源到古人。\n前辈彫零公又往，哀哀令我涕沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐居厚寺簿 其二","author":"孙应时","text":"始见偏何晚，新知不太深。\n书来浑一束，情厚有兼金。\n悄悄中宵别，哀哀万古心。\n有怀终挂剑，雪涕独难禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽莫子晋丈 其二","author":"孙应时","text":"少日从诸老，丁年重一乡。\n埙篪鸣正乐，兰玉秀成行。\n坐客多匡鼎，途人说郑庄。\n哀哀晚何事，衰病讫凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽莫子晋丈 其三","author":"孙应时","text":"吾父古君子，公家贤主人。\n一门常旅拜，三世极情亲。\n遗事今谁问，知心莫重陈。\n上林烟草绿，千里倍伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽诸葛寿之 其一","author":"孙应时","text":"幼学蒙题品，童心托弟兄。\n过从十年足，悃款一家情。\n无力宽贫病，传书隔死生。\n西风吹客泪，万里寸心明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽诸葛寿之 其二","author":"孙应时","text":"人物殊高朗，交游见直温。\n蝇头深故帙，麈尾富名言。\n慭不仪多士，犹令重一门。\n若耶溪上月，空复闭山村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽诸葛寿之 其三","author":"孙应时","text":"命矣三年病，天乎百岁期。\n尸饔犹有母，传业更无儿。\n便作平生尽，空多国士知。\n增光在金友，人得记埙篪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽钱仲耕运使 其三","author":"孙应时","text":"族廪规模大，乡评德义尊。\n家传忠孝旧，国赖典刑存。\n曷不登三寿，嗟谁起九原。\n晚生长自恨，早失拜龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽钱仲耕运使 其一","author":"孙应时","text":"乐易无畦畛，宽平不细苛。\n人才随世狭，时望独公多。\n献纳开丹禁，风神照紫荷。\n谁令终远外，百岁转蓬科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曾仲躬侍郎之室秦国太夫人冯氏","author":"孙应时","text":"数近期颐寿，尊封大国秦。\n三从皆鼎食，九族尽朝绅。\n神剑须重合，蟠桃不再春。\n只令彤史载，备福更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曾原伯大卿 其四","author":"孙应时","text":"夙昔吾何幸，龙门获御公。\n青灯鸣夜雨，白发对春风。\n契阔今安访，蹉跎愧所蒙。\n源流千古意，铅椠若为功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曾原伯大卿 其二","author":"孙应时","text":"群献馀端绪，中原故典刑。\n风霜催短日，河汉独晨星。\n悽恻丹心在，萧条世路丁。\n天高那可问，挥泪湿青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曾原伯大卿 其一","author":"孙应时","text":"世岂无全德，今犹见古人。\n大圭非刻画，天醴自清醇。\n未说功名地，犹令宇宙春。\n苍茫何处觅，丹素岂精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曾原伯大卿 其三","author":"孙应时","text":"天下张廷尉，君王付老成。\n不辞劳日夜，初岂为恩荣。\n竹隐今年志，萱堂晚岁情。\n全归虽不恨，此段渺难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼文昌母安康太夫人汪氏 其一","author":"孙应时","text":"中外三孤贵，康宁百岁期。\n荣于列女传，美矣二南诗。\n蝉蜕无馀恋，龙渊有合时。\n十经汤沐赐，风木更须悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼文昌母安康太夫人汪氏 其二","author":"孙应时","text":"积庆源流远，娠贤社稷光。\n斯文今北斗，举代一文昌。\n象服山河寿，斑衣日月长。\n生刍此时事，四海为悲凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼严州 其一","author":"孙应时","text":"天与才难似，家传学更优。\n著鞭心汗马，游刃目无牛。\n奏语闻三叹，论功仅一州。\n人才苦牢落，那不使公留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽楼严州 其二","author":"孙应时","text":"昨岁桐江去，群公盛祖筵。\n安舆皆鹤发，綵服正蝉联。\n回首那为此，伤心可问天。\n萱堂留仲博，犹足慰黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽潘德夫左司 其五","author":"孙应时","text":"湖海归来近，山林兴故长。\n勇辞黄阁掾，却上白云乡。\n缥缈书楼壮，凄凉笔冢荒。\n家声传二妙，公死未应亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽潘德夫左司 其三","author":"孙应时","text":"爱士风流古，翻书气味长。\n诗家入陶谢，书法到颜杨。\n竹石故无恙，人琴今则亡。\n二龙天下秀，一一看增光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽潘德夫左司 其二","author":"孙应时","text":"综理何精密，胸中故坦然。\n爱民真为国，事世不欺天。\n霜气星台表，春风竹马前。\n湘江尽南海，遗绩尚千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽潘德夫左司 其六","author":"孙应时","text":"忆侍吾兄侧，初瞻父友尊。\n尔来亲燕几，长复痛鸰原。\n山立仪刑重，春回笑语温。\n古今真共尽，泪下欲何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽潘德夫左司 其一","author":"孙应时","text":"家声高内史，国望凛冰翁。\n生长圣门学，周旋前辈风。\n人才须用旧，士论雅期公。\n不见朝宣室，秋山閟一宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴 其三","author":"孙应时","text":"短发日夜白，年华令我愁。\n平生几蜡屐，旧隐一渔舟。\n漫有诗陶写，应须酒拍浮。\n相过慰情素，数肯抱琴不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴 其一","author":"孙应时","text":"碧海明初日，青山破宿烟。\n寒阴都辟易，芳景正澄鲜。\n屋角禽声姹，池塘蝶影翩。\n春光吾负汝，今日一欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴 其二","author":"孙应时","text":"君行定何许，舍棹越林丘。\n社瓮不容挽，溪毛聊可羞。\n禅床应濯足，衲被径蒙头。\n静境有真趣，乐哉何所忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海陵岁暮 其二","author":"孙应时","text":"猎骑呼鹰地，胡笳落雁边。\n梅花非故里，草色近新年。\n莫苦登楼望，聊须殢酒眠。\n江南多贵将，歌舞怅垂毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海陵岁暮 其一","author":"孙应时","text":"地气长江北，云容古戍边。\n层冰明薄日，积雪了穷年。\n乡远劳羁梦，官閒足晏眠。\n客来相劳苦，不责坐无毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海陵岁暮 其三","author":"孙应时","text":"城郭依荒草，风云带极边。\n犹多故时老，共说太平年。\n岁聘皇华去，秋防戍鼓眠。\n谁知明主意，拊髀忆青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留妻兄张伯高 其二","author":"孙应时","text":"叹息青云器，功名指掌中。\n星星今一老，衮衮看诸公。\n饮剧休辞醉，文高不送穷。\n丈夫心事在，未许俗人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留妻兄张伯高 其一","author":"孙应时","text":"千里三年别，轮肠日万周。\n交亲谁得似，声气早相求。\n把手儿能笑，开樽妇可谋。\n天寒须且住，未放剡溪舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益昌夜泊","author":"孙应时","text":"孤舟了不梦邯郸，起凭阑干烟水閒。\n五夜清风鸣鼓角，一天佳月悄江山。\n客身憔悴衣尘黑，世路崎岖鬓发斑。\n未决乘流便东下，明朝且复剑门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益昌僧寺静境轩","author":"孙应时","text":"落照久未夕，断云低不飞。\n孤舟上水急，归鸟度山微。\n萧飒天涯鬓，淋浪醉后衣。\n凭栏一笑去，客梦转头非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读程子易傅","author":"孙应时","text":"事业潜三圣，文章似六经。\n微言归易简，精意极丁宁。\n道在非畴昔，人亡故典刑。\n斋心对薰几，秋月梦初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪章荆州九日登高宴示坐中呈二帅","author":"孙应时","text":"龙山东畔细腰宫，荆蜀元戎一笑同。\n正复楼台看戏马，何妨丝管送飞鸿。\n红萸黄菊年华里，落木长江晚思中。\n下客无才敌嘲弄，聊须整帽向西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高南仲自云间归退轩盖明府以四诗送之末章专以见及南仲索和遂次其韵 其四","author":"孙应时","text":"少日诸公后，流年两鬓斑。\n世情春冰泮，行路太行艰。\n何计分珠履，空怀对玉山。\n风期知不浅，逸驾恐难攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高南仲自云间归退轩盖明府以四诗送之末章专以见及南仲索和遂次其韵 其一","author":"孙应时","text":"丽泽存相益，和羹忌苟同。\n别怀长耿耿，见日苦匆匆。\n经派惩燕说，词源味国风。\n平生子陈子，一瓣记南丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高南仲自云间归退轩盖明府以四诗送之末章专以见及南仲索和遂次其韵 其二","author":"孙应时","text":"鹏鴳逍遥意，鸠鹰变化时。\n物生良自足，天命本无私。\n戚戚真何事，平平亦大奇。\n相逢一笑粲，无语自心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"孙应时","text":"小斋随分有琴书，此外萧然一物无。\n地僻最饶閒意味，日长还得睡工夫。\n四时风月吾心友，千里云山古画图。\n天赐綵衣娱鹤发，箪瓢足矣更何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题","author":"孙应时","text":"困虽有舌吾安用，贫到无锥乐更深。\n百岁难逃少壮老，多思何益去来今。\n弈秋岂必长先手，画史谁知独苦心。\n一枕春宵方化蝶，三竿朝日又鸣禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿上方院祷晴","author":"孙应时","text":"鹊为晚晴喜，山如秋夜凉。\n蝉声起竽瑟，云影散牛羊。\n神理应难昧，民忧得自康。\n平生蔬笋腹，不厌宿僧房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿宝墟庵","author":"孙应时","text":"水静回风度，天晴落日酣。\n因随渔子艇，得憩野僧庵。\n独饮不成醉，高怀无与谈。\n微吟夜寥阒，一睡极清甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄马塘范叔刚","author":"孙应时","text":"海风吹月动苍茫，欲往从君道路长。\n羁羽沈鳞徒影响，秋鸿社燕各炎凉。\n纷纷忍逐尘埃尽，落落犹期日月光。\n想得清吟散愁独，书来金薤剪琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王明叔提干 其一","author":"孙应时","text":"万里锦官城，经年托友生。\n笑谈元不数，心迹故难并。\n别酒梅花粲，追途江月明。\n书来犹缱绻，三叹故人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王明叔提干 其二","author":"孙应时","text":"我去日以远，君留谁与居。\n难忘畴昔意，故有圣贤书。\n窗几深潇洒，尘埃痛扫除。\n入官纷万事，濠上有游鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄史同叔开叔","author":"孙应时","text":"千顷东湖风月中，去年厌看藕花红。\n可惊云水将身远，不得琴书与子同。\n四海人才尊一老，百年门户到三公。\n传家报国诸君事，心地勤收汗马功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄孙正字","author":"孙应时","text":"万里来还去，能忘问启居。\n休寻吊湘赋，早就过江书。\n身健何妨晚，名高勿苦疏。\n房湖风雨榻，独夜意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄江阴使君叔木叔","author":"孙应时","text":"一麾遥驻水云间，闻说铃斋尽日閒。\n蝗似九江那敢近，珠于合浦定先还。\n天人影响从千古，贤哲功名正一斑。\n且续醉翁丰乐记，莫将风月负君山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李允蹈","author":"孙应时","text":"相遇吴陵日，如登单父台。\n了知心尚在，不忍首重回。\n明月人千里，春风酒一杯。\n缄诗凭驿使，持当岭头梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄咏东屯","author":"孙应时","text":"闻说东屯胜，诗仙有旧游。\n茅斋深翠竹，石径俯寒流。\n几杖千山月，锄犁百顷秋。\n归途客酹酒，句法傥堪求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄通州徐居厚使君 其二","author":"孙应时","text":"久已安时论，狂因叹史才。\n及知前辈少，谁说过江来。\n日月閒难得，星霜老易催。\n阳秋百年事，作意莫迟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄通州徐居厚使君 其一","author":"孙应时","text":"珍重通州守，凝香足燕清。\n海风喧夜永，江日荡春明。\n未废青灯读，应添白发生。\n长沙休赋鵩，归作汉公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄高司户","author":"孙应时","text":"一官何用落边州，索漠风烟两见秋。\n犹喜逢君结诗社，如何别我向糟丘。\n高怀谁与论醒醉，杰句能无忆唱酬。\n万里云开对明月，相思清兴满南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尉黄岩任满家大人先归作诗以示恭次元韵","author":"孙应时","text":"瓜熟青门好去官，此身如系欲行难。\n望随鸿雁春风北，梦绕庭闱夜月寒。\n即是抱琴归栗里，未能骑马向长安。\n萧条甘旨应无计，好在藜羹日厌餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼毕进士","author":"孙应时","text":"磨励灯前志，澜翻笔底春。\n果题新进士，归悦太夫人。\n更值千金产，悬需五鼎珍。\n茫茫竟何往，一念忍忘亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼周尧夫 其一","author":"孙应时","text":"勇义千钧力，虚怀万物容。\n材名称远大，俊杰霭游从。\n许可皆诸老，升闻到九重。\n惜哉言与位，大厦折乔松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼赵提干 其二","author":"孙应时","text":"一第规模胜，双楼气象高。\n生涯轻阿堵，来往属吾曹。\n落落心非浅，冥冥数莫逃。\n含悽想平昔，不忍过江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼赵提干 其一","author":"孙应时","text":"伟岸佳公子，功名早自强。\n力臻门户立，学务本源长。\n命服空遗像，斑衣负北堂。\n增辉赖金友，笔墨妙揄扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望建康诸山","author":"孙应时","text":"白沙城上望金陵，满眼风烟草树青。\n山色千年围故国，江流万里赴沧溟。\n惊心采石瓜洲渡，搔首长干白下亭。\n一笑书生强多事，萧萧飞雁落寒汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"孙应时","text":"眼明那得许精神，为问凡花隔几尘。\n雪月故为三益友，乾坤又付一番春。\n诗情消得吟成瘦，画手终应苦未真。\n于我心期独何事，小窗清夜绝相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦蜀中一山寺曰龙塘有龙祠余似尝屡游也题诗别之未足两句而寤因足成之","author":"孙应时","text":"客游几度到龙塘，沙路萦纡草木香。\n雪后江山馀壮观，秋来楼阁记新凉。\n百年此役何时再，万里东归托兴长。\n风景留人重回首，犹须好句与平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清凉寺","author":"孙应时","text":"胜绝清凉寺，低迷德庆堂。\n崇阿纳遐景，遗迹想前王。\n豪杰兵戈后，风流翰墨场。\n凭栏意何极，归鸟度斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章荆州再招宴渚宫重湖","author":"孙应时","text":"平生绛帐马荆州，肯念天涯万里舟。\n百丈便从沙岸发，联镳还作渚宫游。\n芙蓉满意留连客，橙橘随时断送秋。\n不惜重湖重一醉，明朝巴峡暮猿愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]