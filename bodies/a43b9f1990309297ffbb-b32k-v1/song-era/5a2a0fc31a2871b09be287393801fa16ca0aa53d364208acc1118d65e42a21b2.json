[{"title":"和普公赋东园十题 其五 虚白堂","author":"梅尧臣","text":"空堂绝纤尘，虚静自生白。\n长风吹月东，窗户如不隔。\n漆园兹趣深，赤水珠难索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和普公赋东园十题 其六 假山","author":"梅尧臣","text":"太山不可历，石齿齧人足。\n聊集怪与奇，苍苍都在目。\n何须引寒流，平地作溪谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和普公赋东园十题 其四 待月亭","author":"梅尧臣","text":"明月过三五，飞出沧海迟。\n佳人望清夜，隔树光离离。\n不须磔虾蟆，寒魄自有亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和景彝西阁独直","author":"梅尧臣","text":"池头凤皇寒，井上梧桐老。\n凤寒浴已晚，桐老脱亦早。\n是时有词臣，独直正视藁。\n严严代王言，落落奋清藻。\n演成五色丝，世作非常宝。\n贬如市朝挞，褒若华衮好。\n四方号令施，万耳昏聋扫。\n此职唯其才，用居宁草草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答韩子华饷子鱼","author":"梅尧臣","text":"南方海物难具名，子鱼珍美无与并。\n完鳞全乙异臭腥，素盐渍曝生花轻。\n其头戢戢筠箧盈，出自通印时所评。\n远涉川陆来都城，亲宾交遗已见情。\n食指尝动吾窃惊，果获异味亦足明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答韩奉礼饷荔枝","author":"梅尧臣","text":"韩盛人所希，四海馈名物。\n韩复未疏予，分珍曾不一。\n莆阳荔子乾，皱壳红钉密。\n存甘尚可嘉，本味固已失。\n遥思海树繁，带露摘初日。\n安得穆王骏，能置万里疾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢公仪学士正月十七日雨后复雪","author":"梅尧臣","text":"本祈春雨成春雪，应误小桃先次开。\n西汉枚生谁复召，南朝何逊自多才。\n泼除灯火上元去，挫却勾萌六出来。\n前此解衣争贳酒，不知为瑞与为灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢仲弓廷评新理北园","author":"梅尧臣","text":"园吏乘冬和，荷锄去宿莽。\n主人因其勤，筑土截荒壤。\n移枯复窊缺，刬径就平广。\n东北倚高城，巇险不可上。\n爱彼林木深，便为丘壑想。\n更待春风归，日探花卉长。\n但愿多置酒，应得时一往。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢舍人荐震","author":"梅尧臣","text":"盛夏万物当长养，骄阳不雨谁为忧。\n天无纤云野赪色，草木焦卷如经秋。\n南阳太守自引咎，不以天时为怨尤。\n斋精洁虑祠望内，僚属奔从无停辀。\n谩取诗言占离毕，徒依风俗验鸣鸠。\n忽闻郡北直百里，岑岑岐笠藏灵湫。\n持牲遣吏诣其下，俎豆未彻升阴虬。\n电光划划绕岩壁，雷声隐隐生山陬。\n拥云驰雨自东上，西风斗猛云还收。\n神龙蓄志未发泄，明日更与顽阳雠。\n黤霭阴黑若卷海，联绵霹雳能破仇。\n沃然原隰洗妖气，浩尔沟渎扬平流。\n九谷有登百姓喜，蜿蜒歆祀神何羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢舍人新秋","author":"梅尧臣","text":"西风一夕狂，古屋吹可恐。\n微变蜻蛚吟，斗摧蚊蚋勇。\n朝惊露坠梧，远爱云飞陇。\n还忆旧溪游，水清渔箔壅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和道损欲雪与家人小儿辈饮","author":"梅尧臣","text":"阴云浓压野，风猎树高鸣。\n寒禽并枝立，颇以见物情。\n目前两稚子，为慰岂异卿。\n欲置一壶酒，且独对妇倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韩子华桂花","author":"梅尧臣","text":"莫以天下桂，皆为月中物。\n犹言月有兔，野岂无狡窟。\n空山桂花多，艳色粲然发。\n樵客不知贵，奈何薪爨屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韩子华寄东华市玉版鲊","author":"梅尧臣","text":"客从都下来，远遗东华鲊。\n荷香开新包，玉脔识旧把。\n色絜已可珍，味佳宁独舍。\n莫问鱼与龙，予非博物者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韩五持国乞分道损山药之什","author":"梅尧臣","text":"不种东陵瓜，不利千畦韭。\n山药数十本，带土移野叟。\n故叶萎未醒，伤根亦何咎。\n既为君子好，岂与骚人负。\n骚人比画工，丹青出其口。\n欲分栏下苗，驰奴仍置篓。\n主人可无吝，所尚非独有。\n从兹各勤灌，肯在园蔬后。\n今虽胜曝蓄，毕意资玉臼。\n人事固已然，秘方看系肘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韩仲文西斋閒夜有怀道损舅及予","author":"梅尧臣","text":"冬日每苦短，方爱夜漏永。\n积云寒拥斋，徘徊延月影。\n独能怀亲友，出门见参井。\n是时发清咏，笔若天骥骋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和楚屯田同曾子固陆子履观予堂前石榴花","author":"梅尧臣","text":"堂下一匹郑虔马，栏边两株安石榴。\n但能有酒邀佳客，亦任狂花落素瓯。\n侍女红裙无好色，主人白发自侵头。\n欲歌翠树芳条曲，已去洛阳三十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其一 铁瓮城","author":"梅尧臣","text":"堑江以为池，增山以为壁。\n铁瓮喻其坚，金城非所敌。\n前朝经丧乱，曾是轻锋镝。\n览古一徜徉，空听渔浦笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其七 鹤林寺","author":"梅尧臣","text":"松竹暗山门，飕飗给青吹。\n传闻宋高祖，旧宅为兹寺。\n地以黑龙升，经因白马至。\n何必问兴亡，山川应可记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其九 甘露寺","author":"梅尧臣","text":"山头百亩宫，庭下千年树。\n在昔甘露霏，尝疑神物护。\n阴连殿阁寒，声撼雷霆怒。\n瞻影卫公堂，英魂想来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其二 北固山","author":"梅尧臣","text":"山势自北来，高城倚为固。\n当时偶登临，迩者遂沦误。\n微云思作雨，古树尝沾露。\n今非恃险艰，草木藏狐兔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其八 夫子篆","author":"梅尧臣","text":"季札墓傍碑，古称尼父篆。\n始沿春秋义，十字固莫浅。\n磨敲任牧童，侵剥因野藓。\n嗟尔后之人，万言书不显。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其十 范公桥","author":"梅尧臣","text":"谓公天下才，非专一方惠。\n及此作舆梁，力行无钜细。\n既异国侨为，将同傅岩济。\n砻石亘长川，宁须伐山桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其五 望海楼","author":"梅尧臣","text":"尝闻观蹄涔，讵识海水大。\n浩浩与天同，滔滔众流会。\n平吞江作练，远泻河如带。\n终日郡楼间，欲取长鲸鲙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颖上人南徐十咏 其四 金山寺","author":"梅尧臣","text":"山与众山殊，寺非诸寺拟。\n无面不当江，有林皆照水。\n南泠隔吴会，北渡通扬子。\n还看上下帆，日日何常已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其一 幽谷泉","author":"梅尧臣","text":"幽谷有飞泉，入溪知几里。\n跳珠溅木叶，激雨霏岩趾。\n但无箕颍人，曾不吝洗耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其七 天外峰","author":"梅尧臣","text":"天外一尺峰，国中千仞岳。\n重云不掩蔽，万里见头角。\n世人看远碧，谁识产美璞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其九 渔舟火","author":"梅尧臣","text":"芦洲一点明，知有渔人泊。\n江溟杳不分，谁方在高阁。\n是时孤雁去，应认光中落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其二 古木阴","author":"梅尧臣","text":"古木少直枝，其下多曲影。\n岂不爱高阴，奈此性所秉。\n千重叶荟翳，谁愿憩日永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其八 秋原菊","author":"梅尧臣","text":"不为潭上英，不助篱边醉。\n独占兰杞邻，原头自荣悴。\n陶令与太凿，逢人岂无意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其十 春溪水","author":"梅尧臣","text":"春水冰欲开，傍岸已微释。\n鱼寒未动鳞，兽渡时有迹。\n篙师畏割舟，敲拉碎圭璧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其三 寒溪石","author":"梅尧臣","text":"翠耸寒溪上，半隐寒松下。\n水鸟立棱角，渊鱼游穴罅。\n寻常置庭槛，琐细不知价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其五 云际钟","author":"梅尧臣","text":"烟昏青栎道，风急隔溪钟。\n征马未及息，猛虎前有踪。\n寻声欲投宿，僮仆畏所逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其六 垂崖鞭","author":"梅尧臣","text":"崖竹出石壁，根瘦悬青蛇。\n磔髯露老节，斫骨点寒花。\n少年莫剪去，骑杀白鼻騧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和端式上人十咏 其四 孤汀蘋","author":"梅尧臣","text":"潇湘归去人，正值江南春。\n始愿逢拾羽，今乃见采蘋。\n寄语柳使君，莫恨日已曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蔡仲谋苦热","author":"梅尧臣","text":"大热曝万物，万物不可逃。\n燥者欲出火，液者欲流膏。\n飞鸟厌其羽，走兽厌其毛。\n人亦畏絺绤，况乃服冠袍。\n广厦虽云托，呼风不动毫。\n未知林泉间，何以异我曹。\n蝇蚊更昼夜，肤体困爬搔。\n四序苟迭代，会有秋气高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和滕公游穿山洞","author":"梅尧臣","text":"洞口水石浅，潺潺泻绿蒲。\n缘源进岩窦，阴黑人境殊。\n中言有物怪，蟠蛰春未苏。\n霖雨虽有意，风雷莫肯扶。\n风雷自鼓荡，不久当何如。\n幸欣禅林近，钟梵来有无。\n回策履幽径，衣香草露濡。\n老僧长松下，麋鹿与之俱。\n溪云时见起，山鸟自相呼。\n羡尔得兹乐，何用劳形躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘叔治早春游何山","author":"梅尧臣","text":"泛泛寒溪流，萦纡向山去。\n浅石长蒲茸，朝烟暖岩树。\n舍舟当禅扉，踏藓污野屦。\n谁爱鲍参军，登临多秀句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘叔治题刘道士房画薛稷六鹤图六首 其一 啄食","author":"梅尧臣","text":"穷年见俛啄，但有饥乏意。\n虽存玉山禾，不入丹青喙。\n因思方朔嘲，此岂优谐类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘叔治题刘道士房画薛稷六鹤图六首 其二 顾步","author":"梅尧臣","text":"举足徒有势，行沙遂无踪。\n回颈诚已久，未知竟何从。\n安能见俦侣，顾望自颙颙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘叔治题刘道士房画薛稷六鹤图六首 其三 唳天","author":"梅尧臣","text":"引吭向层霄，声闻期在耳。\n鼓吻意岂疏，知音何已矣。\n安得九皋同，流响入万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘叔治题刘道士房画薛稷六鹤图六首 其五 警露","author":"梅尧臣","text":"孤标近仙坛，依约闻坠露。\n俨如举止扬，稍见神爽悟。\n晓月坐清轩，寒添壁间素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘叔治题刘道士房画薛稷六鹤图六首 其六 理毛","author":"梅尧臣","text":"六鹤皆不同，初生薛公笔。\n况兹刷羽者，奋迅如天质。\n墨客怀赏心，题诗仍我率。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘叔治题刘道士房画薛稷六鹤图六首 其四 舞风","author":"梅尧臣","text":"如逢仙圃风，飘飖奋双翅。\n拊节余欲助，和歌谁尔类。\n但看矫然姿，固于流雪异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和瘿杯","author":"梅尧臣","text":"物以美好称，或以丑恶用。\n美恶固无然，逢时乃亦共。\n弃则为所轻，用则为所重。\n道闻瘿木器，爱赏互歌颂。\n定应初得之，买不论官俸。\n靧面生光辉，贮饮发狂纵。\n坐欲置于傍，行欲挈以从。\n其形何险怪，曾不因蓺种。\n凹凸本自然，出缩非斗缝。\n薄才难究穷，诋诃兹实恐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏王右丞所画阮步兵醉图","author":"梅尧臣","text":"右丞笔通妙，阮籍思玄虚。\n独画来东平，倒冠醉乘驴。\n力顽不肯进，俛首耳前驱。\n一人牵且顾，一士旁挟扶。\n捉鞍举双足，闭目忘穷途。\n想像得风度，纤悉古衣裾。\n玉骨化为土，丹青终不渝。\n而今几百岁，乃有胡公疏。\n买石遂留刻，渍墨许传模。\n白黑就髣髴，毫芒辨精粗。\n千古畜深意，终朝悬座隅。\n谁谓盈尺纸，不惭云雾图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏刘仲更泽州园中丑石","author":"梅尧臣","text":"君家太湖石，何从太湖得。\n太湖天东南，太行天西北。\n相去三千里，虽有何致力。\n古人烦舟车，顽质无羽翼。\n窍引木莲根，木莲依以植。\n秋蛇出其中，舌吐虹霓色。\n君尝夸于我，怪怪亦特特。\n以丑世为恶，兹以丑为德。\n事固无丑好，丑好贵不惑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏严子陵","author":"梅尧臣","text":"不顾万乘主，不屈千户侯。\n手澄百金鱼，身被一羊裘。\n借问此何耳，心远忘九州。\n青山束寒滩，溅浪惊素鸥。\n以之为朋亲，安慕乘华辀。\n老氏轻璧马，庄生恶牺牛。\n终为蕴石玉，夐古辉岩陬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏宋中道宅棕榈","author":"梅尧臣","text":"青青棕榈树，散叶如车轮。\n拥萚交紫髯，岁剥岂非仁。\n用以覆雕舆，何惮尅厥身。\n今植公侯第，爱惜知几春。\n完之固不长，只与荠本均。\n幸当敕园吏，披割见日新。\n是能去窘束，始得物理亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏怀 其二","author":"梅尧臣","text":"东方有野父，禳田一豚蹄。\n复操一盂酒，祝谷满吾栖。\n百金请救兵，所欲奢所赍。\n彼何滑稽生，仰天独笑齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏怀 其四","author":"梅尧臣","text":"风驱暴雨来，雷声出云背。\n若决千仞溪，追奔下天铠。\n堂堂亚夫军，吴楚不足碎。\n旱气沃原田，烦蒸洗阛阓。\n深料生注射，聚沫犹壅碍。\n青葱草树鲜，断殁虹霓在。\n向晚留霁晖，天容染新黛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏怀 其一","author":"梅尧臣","text":"一身头面间，所用盖有长。\n两耳主于聪，两目主于光。\n维鼻主于嗅，维舌主于尝。\n以耳辨黑白，以目分宫商。\n以鼻识酸咸，以舌闻嗅香。\n各各反尔用，安得无悲伤。\n此能而兼彼，自劳由不量。\n寄言世上人，欣欣蹈其常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏怀","author":"梅尧臣","text":"西方有鸟鼠，生死同穴居。\n物理固不测，孰言飞走殊。\n雄雌岂相匹，饮啄岂相须。\n一为枝上鸣，一为莽下趋。\n苟合而异向，世道当何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏怀 其三","author":"梅尧臣","text":"自余居田里，未免病与贫。\n常把神农书，每以药物亲。\n处方犹持法，义比君使臣。\n但恨无馀资，岂及疗我邻。\n笔头不中书，聊可备急人。\n昨日除吏来，吾邦为长民。\n欲溺复燃灰，败笔前已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏苏子美庭中千叶菊树子","author":"梅尧臣","text":"生与众草生，不与众草荣。\n彼皆春争葩，兹独秋吐英。\n千叶共一萼，百蒂共一茎。\n幽亭耸扶疏，独本非支撑。\n吾友苏子美，有酒对自倾。\n香随青陵蝶，色映黄金莺。\n昨日偶来过，颇兴陶令情。\n岂敢复言诗，君家有子卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏欧阳永叔文石砚屏二首 其二","author":"梅尧臣","text":"凿山侵古云，破石见寒树。\n分明秋月影，向此石上布。\n中又隐孤壁，紫锦藉圆素。\n山祇与地灵，暗巧不欲露。\n乃值人所获，裁为文室具。\n独立笔砚间，莫使浮埃度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏欧阳永叔文石砚屏二首 其一","author":"梅尧臣","text":"虢州紫石如紫泥，中有瑩白象明月。\n黑文天画不可穷，桂树婆娑生意发。\n其形方广盈尺间，造化施工常不没。\n虢州得之自山窟，持作名卿砚傍物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏扇","author":"梅尧臣","text":"剪纨成薄质，谁将拟月轮。\n闵竭夏后德，同我天王仁。\n及至为时用，岂必画美人。\n何忧秋风来，退保藏其真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏秤","author":"梅尧臣","text":"圣人防争心，权衡为之设。\n后世失其平，有星徒尔列。\n物物尚可欺，铢铢不须别。\n将淳天下民，安得必毁折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏象韩子华邀赋","author":"梅尧臣","text":"躯大力无用，远物赏驯柔。\n食刍与饮水，百倍于马牛。\n犹能络金羁，不可伏车辀。\n苍舒曾智秤，千钧空压舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏蜘蛛","author":"梅尧臣","text":"日结一尺网，知吐几尺丝。\n百虫为尔食，九腹常苦饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垂涧藤","author":"梅尧臣","text":"寒松偃涧滨，弱蔓垂缨绿。\n波萦翠带长，水溅低花馥。\n终日采蘋人，攀条映岩曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜","author":"梅尧臣","text":"日从东溟转，夜向西海沉。\n群物各已息，众星灿然森。\n虾蟆将食月，魑魅争出阴。\n阮籍独不寐，徘徊起弹琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜与邻几持国归","author":"梅尧臣","text":"红尘夜不息，横衢若烟雾。\n朝见车马来，暮见车马去。\n车中目炯炯，马上情遽遽。\n交相知是谁，飞先无觅处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]