[{"title":"再赠","author":"吕本中","text":"婺女胜京口，公来岁已秋。\n闲云出山寺，好月挂星楼。\n往事付情话，故人多倦游。\n十年浪奔走，今日为公留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠友","author":"吕本中","text":"子来已冬深，仅得数夕款。\n寒窗听谈道，未厌白日短。\n从来不饮酒，万事付茗盌。\n别去今几日，荒阶月犹满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁暮","author":"吕本中","text":"岁暮少欢愉，况复婴病苦。\n闭门每厌客，幸此连日雨。\n寒炉火复焰，乃若相媚妩。\n披衣坐壁角，妙处时一暏。\n风声耿初夜，有句或未吐。\n还书问故人，可复一笑许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏成二绝句 其一","author":"吕本中","text":"老读文书懒不前，亦无馀地可逃禅。\n闭门省事群嚣远，惟有狸奴附日眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏成二绝句 其二","author":"吕本中","text":"病犬虺隤惟附日，懒猫藏缩可逃寒。\n宁知两马霜风下，更有长途不道难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久病二首 其一","author":"吕本中","text":"久病畏人事，长闲增道心。\n宁贪风日好，不避雪霜侵。\n局蹐身犹在，高低手自斟。\n酒杯休厌满，茗盌向来深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久病二首 其二","author":"吕本中","text":"未愈俱生疾，空怀宿昔忧。\n时因发孤兴，尚足慰穷愁。\n月落初无念，花开不自由。\n如何雁南向，不共水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶作二绝 其一","author":"吕本中","text":"不嫌羸病守绳床，世念纷纷久已降。\n一夜月明如白日，骤闻急雨打天窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶作二绝 其二","author":"吕本中","text":"膏火从来只自焚，何曾野鹤驻鸡群。\n如何死亦无公论，地下犹存卫府勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢滕尉送梅","author":"吕本中","text":"破帷冷落不禁风，疾病深藏称懒慵。\n忽有梅花来陋巷，喜闻春信出初冬。\n未须趁雪争先睹，尚恐冲寒不满容。\n会约君家好兄弟，他年尊酒便相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游山","author":"吕本中","text":"世味日可厌，兹游那得忘。\n稻田疏宿雨，木叶犯新霜。\n潦倒交游在，追随气味长。\n僧窗有静供，茗盌侑炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李丞相挽诗三首 其一","author":"吕本中","text":"旧学邈难继，相期从少年。\n初看骥伏枥，遽作鹤冲天。\n烈所平生志，高名万代传。\n如何事未济，此老下黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李丞相挽诗三首 其二","author":"吕本中","text":"兄弟俱英妙，声名萃一门。\n论才无不可，于道独为尊。\n未定千年策，终嫌万丈浑。\n天乎乃如此，不使拯乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李丞相挽诗三首 其三","author":"吕本中","text":"事业怀萧相，胸襟识谢安。\n流风有馀烈，志士只长叹。\n淮海他年竭，冰霜此夜寒。\n向来交友泪，南望不曾乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以一缣寄范四弟","author":"吕本中","text":"中原厌胡马，所至是贼窟。\n念君空悬罄，何以备仓卒。\n穷冬霜雪繁，欲救乃无术。\n儿号君莫厌，婢怨君莫恤。\n平生师颜子，于此见仿佛。\n此缣君所知，自我机杼出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江梅","author":"吕本中","text":"江梅消息未真传，微露芳心几杖前。\n不信冰霜能作恶，要令桃李便争先。\n斜枝似带千峰雪，冷艳偷回二月天。\n准拟从君出城去，竹舆仍胜百花鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鼓山颂法眼语在里即求出云大家合眼跳黄河戏成四韵奉答","author":"吕本中","text":"合眼跳黄河，未有过得者。\n岂惟不得过，身亦须判舍。\n告君过河妙，止要具船筏。\n乘时等风去，过此无别法。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜深归家闻邻家小儿读书可喜有作","author":"吕本中","text":"还家更寒三鼓馀，邻家小儿犹读书。\n王侯将相乃无种，纨裤绮襦宁似渠。\n北风飕飕霜被草，听汝读书声转好。\n莫言翁媪惜膏油，有儿如此可无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花","author":"吕本中","text":"野水依城竹映沙，江梅开处又人家。\n天晴径欲花前醉，只恐衰颜不称花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题二首 其一","author":"吕本中","text":"德盛不狎侮，玄谈多作俳。\n居然少庄语，无乃近齐谐。\n恨此达者趣，犹乖壮士怀。\n故当先复礼，方得尽梯阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题二首 其二","author":"吕本中","text":"圣学邈难继，斯文当望谁。\n还能养志气，且务摄威仪。\n曾子但三省，子长徒爱奇。\n从来要功处，本不在多知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠李元亮之子李子","author":"吕本中","text":"往时诸李在江都，文采风流一代无。\n每得清诗如小谢，已闻前辈许封胡。\n好松久已埋深涧，老马今犹忆旧途。\n令子相逢初未识，尚容衰晚见规模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月七日与群从游陈氏园 其一","author":"吕本中","text":"平居羸病每相妨，今日寻春有底忙。\n何以至人常不出，看人冲雨度浮航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月七日与群从游陈氏园 其二","author":"吕本中","text":"桥北桥南花乱开，小园和雨扫莓苔。\n不嫌拄杖冲泥入，更许乘闲著屐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀许子礼","author":"吕本中","text":"寒松厌庭院，老马倦维絷。\n翛然出尘去，粗免朝夕急。\n我友隔湖岭，尚作一日葺。\n平生学道心，择善有固执。\n岂不在行路，自远霜露湿。\n百川灌河来，砥柱乃中立。\n何时一尊酒，更与交旧集。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪 其一","author":"吕本中","text":"穷巷无人对雪，小诗自可逃禅。\n看取一年三白，喜欢共入新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪 其二","author":"吕本中","text":"坚坐正宜养病，开门便当幽寻。\n一夜雪深一尺，与谁取酒同斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"报晖庵","author":"吕本中","text":"寸草仰生活，春晖常照临。\n不知欲报德，何以见此心。\n江汉有时竭，此心无浅深。\n魏氏有令德，传家非独今。\n结庵在山阿，日瞻松柏林。\n仁风被远迹，猛兽不敢侵。\n令子守直道，意往无崎嵚。\n遂令此乡人，得闻金玉音。\n我行时序晚，回望西山岑。\n延领长太息，聊为纯孝吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠庄季路","author":"吕本中","text":"老矣庄夫子，居闲肯厌贫。\n盛时更读易，忧道不无人。\n记往诗犹在，相逢意倍亲。\n尚期香火社，文字约遗民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李尚书挽词","author":"吕本中","text":"李氏三吴秀，尚书一代英。\n立朝惟直道，守已但纯诚。\n报国心虽在，忧时病已成。\n人推四兄弟，气压百公卿。\n未就养生术，独取强谏名。\n伤心旧游地，城郭漫溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李器之履斋","author":"吕本中","text":"人履履险巇，君履履平地。\n平地信可履，行稳居亦易。\n责己不责人，为道不为利。\n熟视履险者，岂不心有愧。\n君家天台守，固学有馀味。\n微言化子侄，自足警一世。\n初无举足劳，宁有半涂滞。\n君能识其然，我亦从子逝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野寺","author":"吕本中","text":"晓窗日未融，野寺雨欲作。\n经旬少客到，静坐差可乐。\n平生遭病扰，今更不如昨。\n囊空畏高医，何以致良药。\n所幸秋已至，所在身可著。\n洗耳听凉风，不待一叶落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辛酉立春","author":"吕本中","text":"中原扰扰尚胡尘，坚坐江南懒问津。\n漫读旧诗如昨梦，却疑往事是前身。\n子桑自了经时病，原宪长甘一味贫。\n刺忍雪寒君莫病，土牛花胜已迎春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪夜","author":"吕本中","text":"破屋除灯雪自明，案头无用读书檠。\n老慵已惯跏趺坐，昏梦尤便松竹吟。\n知有故人来问道，久无佳兴与寻盟。\n明年更有闽山兴，但办行缠莫计程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢方倅惠炭","author":"吕本中","text":"寒压新春雪不融，布衾如铁坐衰翁。\n烦君又送南山炭，更放残炉一夜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事四绝 其一","author":"吕本中","text":"老来于世转无求，事业声名种种休。\n伴得邻僧忍饥惯，闭门无饭读春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事四绝 其二","author":"吕本中","text":"匆匆和梦别星楼，扰扰随缘住信州。\n尚笑长江少方便，只教溪水暂西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事四绝 其三","author":"吕本中","text":"问柳寻花懒不知，登山临水病难为。\n日长客去松阴静，强课儿曹学和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事四绝 其四","author":"吕本中","text":"经旬却怕酒杯深，野寺虽闲病至今。\n莫谓闲居厌医药，未妨随證检千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人","author":"吕本中","text":"中表多离隔，情亲子独贤。\n心游众目外，气出万夫前。\n米贱犹堪饱，官闲不记年。\n春风上严濑，为我略回船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辛酉之冬周提宫埅惠行隔","author":"吕本中","text":"深冬坐穷阎，未厌风日恶。\n今晨起浓阴，正恐雨雪作。\n故人怜我寒，垂意到丘壑。\n虚堂排竹牖，已觉暖胜昨。\n初无穷窒劳，渐有闲适乐。\n我生甚易足，所至况旅泊。\n不为御冬计，敢复备陨箨。\n偶蒙仁者念，僻处未萧索。\n从今作新年，对酒且斟酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张仲宗","author":"吕本中","text":"闻道张夫子，今年已定居。\n偶缘荔子债，遂绝故人书。\n岁月足可惜，溪山莫负渠。\n他年得相近，不必问庖厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周仲固尚论斋","author":"吕本中","text":"周侯不出何所为，闭门读书心自知。\n箪瓢陋巷君不厌，读书万卷能忘饥。\n上参羲皇下秦汉，采取英华几脱腕。\n是非荣辱姑置之，忽若乘船到彼岸。\n古人之学有传授，君生寂寞千载后。\n问君何以识古人，袖手无言坐清昼。\n以此读书为尚友，是事渺茫人信否。\n人信不信君不问，松柏固难生培塿。\n朝来落叶乱荒城，青山照人溪水横。\n往来车马作尘土，想君深夜读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吉州段秀才粟庵","author":"吕本中","text":"大千非有馀，一粟岂不足。\n须弥纳芥子，岂复论盈缩。\n今君住世网，何以得此独。\n始知陋巷居，已悟不远复。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自如斋","author":"吕本中","text":"朝为事所夺，莫为饥所驱。\n不知六合间，何人能自如。\n永新段夫子，屋小心有馀。\n教之有家法，逃禅犹作书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉经堂","author":"吕本中","text":"纷纷入醉梦，一语令渠醒。\n段子闭门居，云何犹醉经。\n其醉盖非醉，初无能解酲。\n问经何所说，明善故能诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题焦寺丞诗册三绝 其一","author":"吕本中","text":"一世奔波在别离，君家孝友独天知。\n已令好梦传消息，更有宾鸿效羽仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题焦寺丞诗册三绝 其二","author":"吕本中","text":"路旁来报定何人，物理潜通自有神。\n想得三衢相见地，至今草木亦长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题焦寺丞诗册三绝 其三","author":"吕本中","text":"河朔家人堕渺茫，江南风日正舒长。\n已知原上鹡鸰处，更入云间鸿雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暴物","author":"吕本中","text":"暴物看日景，顷刻未尝停。\n随景移暴物，日示令心惊。\n寓此不停景，乃复望长生。\n匆匆驹过隙，悠悠池汛萍。\n况兹兵火中，而每疾病撄。\n野寺过毒暑，旱气浮高城。\n出门君莫厌，宿昔已秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次叶守喜雨","author":"吕本中","text":"群嚣寂寞已收声，预怯秋房独夜情。\n忽听僧檐鸣宿雨，定知田舍舞安氓。\n尽消积暑经时早，不厌新凉数日晴。\n更喜此邦贤太守，乐为诗颂教诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无题","author":"吕本中","text":"学诗渐老转销声，末路蒙山此日情。\n尚有文章能起疾，岂惟田里解蚩氓。\n近郊粳稻成秋熟，绕郭溪山入晚晴。\n剩绕长廊和新句，不知庭下薄寒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵曾宏甫木犀","author":"吕本中","text":"风吹旱暑未成秋，辜负江村事事幽。\n岩桂敢烦先折送，好诗仍不待邀求。\n自怜疾病常高枕，坐想风流换此州。\n他日出门寻旧约，未嫌疏懒作人不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠郑侍郎二首 其一","author":"吕本中","text":"便欲深居过一寒，破窗重觅旧蒲团。\n莫年生活如何做，子细烦公指示看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠郑侍郎二首 其二","author":"吕本中","text":"几时不过西禅寺，直自初秋到晚秋。\n闻道主人怜我病，天寒酒未送新篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次曾宏甫九日韵","author":"吕本中","text":"僧园晓色散栖鸦，强起新诗整复斜。\n正想故人披宿雾，忽蒙佳句洗昏花。\n旧游往往违心事，老病昏昏漫岁华。\n辜负重阳一尊酒，且来占雨又朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日赠曾宏甫二绝 其一","author":"吕本中","text":"茶花过雨十分香，山后山前已带霜。\n何事东篱数株菊，已将青蕊趁重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日赠曾宏甫二绝 其二","author":"吕本中","text":"渐退中原胡马尘，溪山未厌往来频。\n虽无名酒酬佳节，尚有新诗答故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐止秀才归小叶","author":"吕本中","text":"后生少规模，子学有根源。\n纷然众室中，独识孔氏尊。\n古人虽不作，此理固常存。\n沧海无津涯，宁有众水分。\n鉴明不受垢，垢尽亦无痕。\n子还访师友，当自得其门。\n躬行见日用，馀事不论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次叶守韵","author":"吕本中","text":"新正无所为，出户亦乘兴。\n欲寻林泉幽，不避风雪迸。\n搜肠乞佳话，分外若赘瘿。\n故知藜藿盘，不受珍果饤。\n清诗洗病目，鄙陋知不称。\n披雪见新月，乃悟本来性。\n溪山况潇洒，复有松竹映。\n何须待醇酒，然后有酩酊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾宏甫知黄州四绝 其一","author":"吕本中","text":"雨馀天气欲尝橙，栗可煨炮芋可羹。\n正是一年秋好处，忍令无酒送君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾宏甫知黄州四绝 其二","author":"吕本中","text":"口唇白醭未尝开，正始馀音挽复回。\n他日炉香为谁起，公曾亲见了翁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾宏甫知黄州四绝 其三","author":"吕本中","text":"君到江头不问津，雪堂草木几番新。\n一生未得文章力，要扫中原胡马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾宏甫知黄州四绝 其四","author":"吕本中","text":"骐骥徐行不离群，却行江北访斯文。\n潘何子弟能传业，当奉遗书与使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题范才元画轴后","author":"吕本中","text":"昔年曾过岭南州，争看湘江万里流。\n妙手可传诗外意，乱云寒木更孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送尹少稷贤良还怀玉山","author":"吕本中","text":"青松在庭槛，乃受众目怜。\n念彼岁寒枝，肯争桃李妍。\n不如卧涧壑，岁久霜雪前。\n尹侯东州英，炯若珠在渊。\n避地走南荒，因循留瘴烟。\n归来怀玉山，草草屋数椽。\n深居绝万虑，读书欲忘年。\n偶出到城市，颇厌尘嚣煎。\n搜肠出妙语，赠我以长篇。\n行潦被注挹，朽木烦彫镌。\n纷纷车马间，孰能知子贤。\n别归值短晷，肯复更留连。\n我老百事废，钝马难加鞭。\n清霜粲屋瓦，白云常在天。\n怅望子所居，欲去无夤缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题曾黄州重修睡足斋","author":"吕本中","text":"云涛际天江北路，郡古人稀春欲暮。\n平生想像睡足庵，颇见王杜安身处。\n十年兵火庵已坏，草莽连岗穴狐兔。\n使君初来席未暖，重就新斋立窗户。\n疏疏脩竹带泉石，历历幽光点烟雾。\n竹楼月波不寂寞，雪堂东坡复共住。\n昔者同遭盗贼扰，今者定蒙神物护。\n使君忘言坐搔首，抖擞衣襟脱巾履。\n下帘高枕百吏散，一任江头风断渡。\n会思王杜与新诗，梦里相逢得奇句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]