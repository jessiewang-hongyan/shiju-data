[{"title":"再用元韵呈熊伯通","author":"孔平仲","text":"一望膺门眼已明，欣然倒屣辱公迎。\n林泉真作仙人宅，杖屦容参长者行。\n道论风生挥玉麈，渴心尘积饮金茎。\n匆匆短棹依城去，连日西斋梦寐清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄熊伯通","author":"孔平仲","text":"南山九叠势千霄，中有长松荫寸苗。\n好景常闻太平观，谪仙更住上清桥。\n风吹石径秋声早，泉落云根暑气消。\n方外相期蒙雅眷，只应心隐不须招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用霄字韵","author":"孔平仲","text":"豁然披雾睹青霄，沛若为霖洒旱苗。\n身逐归云朝傃洞，心随流水暮萦桥。\n人情不用相轻重，物理从来互长消。\n器业如公合廊庙，伫闻尺一有嘉招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初伏夜坐","author":"孔平仲","text":"露坐已侵夜，炎威犹未收。\n何言百虫噪，无故一星流。\n苦渴须浆解，微凉以扇求。\n颁冰是今日，堆玉想神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上作","author":"孔平仲","text":"寂历人初定，逍遥物已齐。\n夜凉天似水，月在小桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"午眠","author":"孔平仲","text":"雨荡炎天气，风生乔木阴。\n清凉一枕睡，胜得万黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早秋","author":"孔平仲","text":"一雨洗烦熇，凉风开早秋。\n散行身觉快，甘寝梦相求。\n已作黄花意，谁为堕叶愁。\n南山青似染，准拟更登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"孔平仲","text":"高列瓜华结綵楼，半空灯烛照清秋。\n祇应用尽人间巧，更欲远从天上求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送马朝请使广西","author":"孔平仲","text":"海水扬波今合清，秋风千里使华行。\n言皆有道非徒发，事若无心更不生。\n谈笑从容怀远俗，琴书潇洒寄高情。\n伫闻静胜诸蛮服，何必楼船十万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十六日玩月","author":"孔平仲","text":"团团冰镜吐清辉，今夜何如昨夜时。\n只恐月光无好恶，自怜人意有盈亏。\n风摩露洗非常洁，地阔天高是处宜。\n百尺曹亭吾独有，更教玉?倚栏吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭明叔任分宁","author":"孔平仲","text":"西安潇洒我常游，去自脩川泛小舟。\n民本丰饶矜气节，士多儒雅出公侯。\n梅山晚翠屏当户，茶井春芽雪满瓯。\n预想弦歌富閒暇，白云深倚凤凰楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送提举太平观熊舍人 其一","author":"孔平仲","text":"未归西掖掌丝纶，且面南谯作守臣。\n三已何尝观愠色，一鸣从此却惊人。\n朱轓暂去求民瘼，黄闼行当秉国钧。\n记取庐山公旧隐，几多草木待青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送提举太平观熊舍人 其二","author":"孔平仲","text":"江州几日到滁州，风送征帆暮不收。\n幽谷水声先入梦，炉峰山色远随舟。\n素无公事多閒暇，当有新诗自唱酬。\n寂寞旧居谁复顾，桂花深锁一堂秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送提举太平观熊舍人 其三","author":"孔平仲","text":"高才喻蜀策巂羌，凛凛威名动四方。\n裁正稷宫新法度，发挥词掖好文章。\n暂还紫府烟霞冷，却上青霄道路长。\n寄语吏民休浪喜，使君宁久在滁阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熊伯通阻风未发拿舟就谒留饮数杯","author":"孔平仲","text":"清晨已送君南浦，薄暮未行天北风。\n此别谩言千里远，笑谈还此一樽同。\n铁山重叠云垂地，玉马腾骧浪驾空。\n涉险临危须自戒，且维舟楫莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈行奉议赴辟陕西","author":"孔平仲","text":"除诏移关陕，征途半斗牛。\n落帆江蒲月，跃马戍垣秋。\n葱岭霜吹剑，龙堆雪点裘。\n兵家破竹势，幕府涌泉谋。\n且作从军乐，安知出塞愁。\n观公颇丰下，努力取封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉兹住凤山 其一","author":"孔平仲","text":"十年虎溪老，却上羌山岑。\n今回江西去，与人传法音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉兹住凤山 其二","author":"孔平仲","text":"谷虚聊应物，云出本无心。\n猿鹤空相怨，旧庵松桧深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十八日作","author":"孔平仲","text":"秋来常苦热，今日令方行。\n浩浩风吹木，冥冥雨压城。\n薄寒如解愠，残序亦关情。\n晓镜须惊老，催人白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏子由寄题小庵诗用元韵和","author":"孔平仲","text":"官身粗应三钱府，吏隐聊开一草庵。\n拥砌幽篁如月映，覆檐乔木与天参。\n畏人自比藏头雉，老世今同作蛹蚕。\n岂独忘言兼闭息，舌津晨漱不胜甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陶寺丞挽诗","author":"孔平仲","text":"清德如彭泽，高名继隐居。\n弦歌非我志，泉石爱吾庐。\n世事冥心外，门风积庆馀。\n鱼轩偕鹤发，归葬引双车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄道士求诗戏为口号赠之","author":"孔平仲","text":"黄君有术吾将面，不似寻常问进身。\n二顷良田数间屋，几时得作一閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬昼作","author":"孔平仲","text":"霜阴收欲尽，斑驳意初晴。\n渐喜山将出，只愁云更生。\n鸟窥晡后屋，鸡唱午间城。\n灰拆红炉火，微煎傍耳鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十一月","author":"孔平仲","text":"欲雪还成雨，垂霜却变阴。\n封疆五岭近，甲子二冬深。\n密叶犹低户，微风尚快襟。\n松筠杂萧艾，都有岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬晓","author":"孔平仲","text":"城上犹吹角，官厅已罢更。\n粗疏知我性，懒惰亦人情。\n入被严霜冷，横窗半月明。\n翻身更甘寝，鸡唱第三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月三日唐林夫舟中醉题","author":"孔平仲","text":"屡伏青蒲地，尝登群玉山。\n家贫甘远适，道直得生还。\n瘴疠讴吟外，风波笑傲间。\n今朝一樽酒，万事付酡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四日郡集于景德寺","author":"孔平仲","text":"冷铎残香僧舍开，斜风细雨坐中来。\n使君岂是憎歌舞，自出胡琴送酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上口占","author":"孔平仲","text":"涧底泉初动，山头雪尚深。\n冻条桑破眼，烧地草抽心。\n摇落殊非昔，芳菲想自今。\n浮云多意思，已解作春阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"守倅自开元观食起欲往紫极宫道过余之家园乃屈同游太守自以为能知地形余故议卜居之处也以诗谢焉","author":"孔平仲","text":"东已窥丹井，西将造嘿轩。\n半途留使骑，枉道至家园。\n败叶深埋砌，清阴密拥门。\n生涯为废宅，景物似荒村。\n经始惭谋拙，临轩肯屈尊。\n竹间烦伫立，高谊见公存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"据案小睡","author":"孔平仲","text":"春气已回人困顿，雨声不断夜潺湲。\n四支退食昏如醉，两眼看书涩有烟。\n散帙横经那肯读，埋头曲肘即成眠。\n只愁稚子窥吾懒，岂畏诸公诮腹便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南轩","author":"孔平仲","text":"细雨纷纷不见山，卷帘烟景画图间。\n一池春水风吹皱，戏鸭鸣鸥作队閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏为难韵同官和之","author":"孔平仲","text":"稚柳将成线，残梅尚有柎。\n破春寒料峭，送晚角喑呜。\n地僻閒宾榻，泥深隔酒垆。\n此时愁寂寞，幽闷寄操觚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾谊","author":"孔平仲","text":"措置由来有后先，运行无迹盍观天。\n色黄数五疑非急，此事知君正少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子瞻子由各有寄题小庵诗却用元韵和呈","author":"孔平仲","text":"二公俊轨皆千里，两首新诗寄一庵。\n大隐市朝希柱史，好奇兄弟有岑参。\n雪天冻坐痴于雀，雨夕春眠困若蚕。\n不是本来忘世味，便投閒寂亦难甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨不止二月半以敕醮庐山真君殿入夜星月皎然","author":"孔平仲","text":"连朝苦阴雨，入夜月华新。\n清醮今当夕，真君信有神。\n灯光想如昼，香气自生春。\n水旱多为害，当思今为民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题萧丈止亭","author":"孔平仲","text":"削迹忘当世，开亭枕近郊。\n情非恶冕绂，乐不似衡茅。\n静看云归岫，閒知鹳在巢。\n春风动幽兴，植杖数花苞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春夜","author":"孔平仲","text":"酒醒残月在西厢，悄悄重城春夜长。\n何物与人清意思，瑞香花发一亭香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和经父寄张绩","author":"孔平仲","text":"萧萧木落洞庭湖，一叶扁舟尽室居。\n吾道已衰投直笔，人情难合卷长裾。\n重轻自系朝廷势，褒贬犹存史策书。\n所遇于天皆有分，未将鲵鲋羡鲸鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阻风呈经父","author":"孔平仲","text":"风响翻空若疾雷，舟行值此颇淹回。\n坐看鸥鹜浮波去，近见蛟龙带雨来。\n春色未还江上柳，雪香谁寄岭头梅。\n欲收美景陪清唱，恨乏当时子建才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏橹","author":"孔平仲","text":"以小能行大，天机寄物形。\n沿流最有助，深壑屡尝经。\n迅速功无比，讴鸦韵可听。\n江空插羽翼，水府散雷霆。\n驾浪来湘浦，摇风过洞庭。\n侵凌秋岛雾，破碎暮湾星。\n雁鹜惊群起，蛟龙睡一醒。\n浩然乘此兴，东去绝沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏柁","author":"孔平仲","text":"厥初谁创物，似此亦难求。\n摆合千寻浪，回旋万斛舟。\n行如一卧扇，力敌九氂牛。\n出没居相半，东西势自由。\n高风当绝倚，浅濑亦徐收。\n轧轧微鸣晓，峨峨迥浸秋。\n随湾掉转尾，避石掣开头。\n自有施功地，何尝厌下流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日阻风饮于转运行衙呈经父","author":"孔平仲","text":"枉渚停风棹，华堂置酒壶。\n云低岳阳市，雪满洞庭湖。\n醉眼看梅蕊，欢心合棣柎。\n去年今夕梦，江国面京都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和经父登黄鹤楼","author":"孔平仲","text":"复霭重沙望不穷，坐收千里一樽中。\n天边江汉波涛阔，地下神仙窟宅通。\n窗影偷来湓浦白，檐光飞入沔城红。\n豁然已尽登临兴，云阁章亭谩在东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏冰","author":"孔平仲","text":"厚薄因风结，方圆随器成。\n黄河白马渡，大泽老狐行。\n暖曲流云液，隅甃晃水精。\n皎然心一寸，愿比玉壶清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏网","author":"孔平仲","text":"已向晴漪下，还于晚架张。\n鳞馀银皎皎，目带泪浪浪。\n细入诗人咏，轻随钓叟装。\n结绳相效久，遗象本归藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞香花","author":"孔平仲","text":"去年荆楚赏芳菲，今岁江淮水渺瀰。\n绿发方当少壮日，清樽不负艳阳时。\n风波此去犹千里，桃杏何缘见一枝。\n独有瑞香花两槛，远将春色自相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李白祠堂 其一","author":"孔平仲","text":"洒落风标真谪仙，精神犹恐笔难传。\n文章若出斯人手，壮浪雄豪一自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李白祠堂 其二","author":"孔平仲","text":"太白之精出李白，诗中元帅酒家豪。\n轩然眉目已如此，况著当年宫锦袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双头牡丹","author":"孔平仲","text":"牡丹意态已无穷，况是连房斗浅红。\n晓色竞开双萼上，春光分占一枝中。\n娥英窈窕临湘浦，姊妹轻盈倚汉宫。\n只为多娇便相妒，芳心相隔不相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄经父","author":"孔平仲","text":"借问东来常太晚，富春亭下舣扁舟。\n阴天漠漠行梅雨，寒色萧萧报麦秋。\n曲渚浪平犹未渡，隔江风紧不胜愁。\n此中望断相思眼，家在蓬莱更倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"选官图口号","author":"孔平仲","text":"环合官图展，观呼象子圆。\n飞腾随八赤，摧折在双玄。\n已贵翻投裔，将薨却上天。\n须臾文换武，俄顷后驰先。\n错杂贤愚品，偏颇造化权。\n望移情欲脱，患失胆俱悬。\n愠色观三已，豪心待九迁。\n宁知即罢局，荣辱两茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁四年中秋","author":"孔平仲","text":"月满光尤好，秋殷气更清。\n频年苦阴雨，此夜独清明。\n后阁罗甥妹，前堂合弟兄。\n团圆最相称，尽饮至深更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和舍弟送行至密州","author":"孔平仲","text":"一览凤凰句，况当鸿雁秋。\n云山回倦首，烟雨上扁舟。\n土俗京东陋，官居学舍幽。\n蓬莱醉中梦，寻我海边州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和堂父发越州","author":"孔平仲","text":"北堂相送出城西，忍见临分独自归。\n日暮荒村一回首，秋风吹涕各沾衣。\n水通鉴曲行将尽，山似稽阴认却非。\n薄宦牵挛不得已，此心何以报春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渡浙江未得","author":"孔平仲","text":"辞家已四日，三日雨兼风。\n海水飞天上，江云入坐中。\n愁肠寒更结，归梦湿难通。\n未有淹留恨，封圻尚浙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西兴","author":"孔平仲","text":"舟行颇濡滞，累日驿前溪。\n大雨翻盆盎，狂风作鼓鼙。\n两潮空朝晚，一水限东西。\n忆昔游湖棹，新晴傍会稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀越","author":"孔平仲","text":"城隍压高峻，楼观抱青苍。\n东磴迎风细，西池引步长。\n蓬莱山刻画，清白水甘香。\n海内行几半，兹游最不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和常父渡江寄经父","author":"孔平仲","text":"江风初息浪花低，轧轧扁舟犯晓鸡。\n想得蓬莱秋睡觉，暖寒方索玉东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新开湖","author":"孔平仲","text":"湖应与海接，岁暮水犹多。\n净色平苍野，馀香积败荷。\n舟行依累石，凫起散圆波。\n谁似渔翁乐，鸣榔作楚歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清斯堂","author":"孔平仲","text":"河流与淮接，于此一堂成。\n水色已可爱，主人心更清。\n鱼潜晚日静，柳落秋空明。\n本自无尘土，何须歌濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发山阳","author":"孔平仲","text":"黄昏饮官酒，半夜解扁舟。\n钩帘得清景，风月满淮流。\n天垂与波接，野静更烟浮。\n深有乘槎兴，银河或可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送登州太守出城马上作","author":"孔平仲","text":"匆匆送客出城闉，霜意方高日渐醺。\n青嶂倚空先有雪，黄沙匝地半和云。\n旌旗明灭随车远，鼓角悲凉隔水闻。\n正是无憀一回首，两行白马映红裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈梦锡节推林思永察推","author":"孔平仲","text":"崎岖寒苦远腾装，喜得高才共此方。\n当以清谈销日月，更将和气敌冰霜。\n堂前绛帐惭容迹，幕下红莲幸借香。\n閒夕肯来相伴否，小窗残烛厌更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"适值刘从道供奉往信阳镇用前韵送之","author":"孔平仲","text":"君马匆匆赴信阳，虽云同郡似它方。\n村沙卷尽黄昏日，海水吹成半夜霜。\n别恨不须青草色，归期当及小桃香。\n閒官冷局遥相望，两觉迢迢岁月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦锡同游贺园题诗云谁知清淡者冬月亦登临","author":"孔平仲","text":"寒景峥嵘岁已深，谁知清淡亦登临。\n雨吹废馆苔添晕，霜落空城树减阴。\n向晓旋留题叶句，隔年先有探花心。\n相期红药浓开日，一醉东风费万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新作书室梦锡示诗羡其清坐","author":"孔平仲","text":"新辟西垣小室成，开编静得古人情。\n峥嵘老柏寒尤健，窈窕幽窗雪更明。\n我愧滥巾居此地，君能倾盖似平生。\n篇诗何必深相羡，渌水芙蓉岂不清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈幕客","author":"孔平仲","text":"夜雨晓未歇，清寒侵客颜。\n云昏天带海，风阔地无山。\n莲幕君筹画，茅斋我闭关。\n新书正多事，何幸拥炉閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄从道","author":"孔平仲","text":"相逢苦不早，相别又匆匆。\n祖席侵华烛，征车傍北风。\n车斜酬唱阙，尔汝笑谈空。\n遥想支颐处，孤村海雾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]