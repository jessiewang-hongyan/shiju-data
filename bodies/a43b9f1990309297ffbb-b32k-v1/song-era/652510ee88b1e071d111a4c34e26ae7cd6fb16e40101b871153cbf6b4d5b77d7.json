[{"title":"偈颂一百六十九首 其一五○","author":"释智朋","text":"火就燥，水流湿。\n问十答百，问一答十。\n达磨是甚老臊胡，临济未是白拈贼。\n今日为汝一划划断，且道既是冬瓜，为什么夏里吃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四九","author":"释智朋","text":"归源性无二，方便有多门。\n棒如雨点，喝似雷奔。\n衲僧门下，无著这破草鞋处，经律论又向什么科中收。\n移高就下，有个商量。\n白昼长，松风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四八","author":"释智朋","text":"如何望岱岳，仁心普周被。\n难与衲僧角，换却鬼眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四六","author":"释智朋","text":"不知月之大小，不管岁之馀闰。\n黑牛卧死水，癞马系枯桩。\n三年一闰，五年载闰。\n衲僧须经得与么时节过，方可成自己岁功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一一","author":"释智朋","text":"毗蓝园里，活中觅死不可得。\n双林树下，死中觅活不可得。\n脑后一锥，是活是死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一○","author":"释智朋","text":"伶俐衲僧，讨甚巴鼻。\n著脚处寸草不生，著眼时佛祖扫地。\n且道以何为据，不爱南山爱鳖鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○九","author":"释智朋","text":"爰从耳门，圆照三昧。\n缘心自在，东倒西擂。\n异中现同，小中现大。\n只如不涉眼色耳声，甚处与他相见，婺机罗，川纸会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○八","author":"释智朋","text":"无用之用，其用甚大。\n无功之功，其功甚博。\n自然如龙得水，似虎靠山，壶中春色异人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○七","author":"释智朋","text":"看楼打楼，东涌西没。\n入水入泥，穿皮透骨，十字街头石敢当。\n忽会转身句，便笑辽天鹘，达磨大师眼睛突。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○六","author":"释智朋","text":"真灵无功，功超造化。\n真圣无相，相包虚空。\n从权摄化，正按旁提。\n风行草偃，玉转珠回。\n使人人向这里饱食味法味，惭愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○四","author":"释智朋","text":"三转法轮于大千，其轮本来常清净。\n平江出灯道地，诸人尽知灯明。\n如来在诸人眼里耳里，转如是轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○三","author":"释智朋","text":"田库儿，甚奇怪。\n一下锄头，打破土块。\n尽大地老和尚，髑髅粉碎，坐一走七，圆融内外。\n青松下，明窗内，玉殿琼楼未为最。\n分毫定斤两。\n涓滴见沧海，拄杖子话在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○二","author":"释智朋","text":"天地发祥，圣人诞降。\n恩沾四海，德被万邦。\n林下道人，坐则禅板蒲团，用则拄杖拂子，无非仰答圣恩。\n今日赞祝一句，又作么生，此心心外更无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○一","author":"释智朋","text":"人人自有光明在，看时不见暗昏昏。\n这个岂不是光明，一一闻见分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○○","author":"释智朋","text":"迦叶三昧，阿难不知。\n闻名见面，剑去久矣。\n拽杷拖犁较后先，杨岐鼻孔没半边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十九","author":"释智朋","text":"木落千岩，秋空如洗。\n向这里转得身去，可以移星换斗，转位回机。\n百尺竿头，纤尘不立。\n向这里进得一步，杀活纵擒，纵横自在。\n须弥无顶，沧海无底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十八","author":"释智朋","text":"寒则普天寒，热则普天热。\n透出寒暑关，何曾离窠窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十六","author":"释智朋","text":"自古及今，灯灯相续。\n匝地普天，灯灯无间。\n助发实相义，今朝正月半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十四","author":"释智朋","text":"岁之元，月之元，日之元。\n元正启祚，万汇发生。\n达磨西来，直指人心，见性成佛。\n一花开五叶，结果自然成。\n两段不同，收归上科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十二","author":"释智朋","text":"旃檀林，狮子窟。\n蹲坐不得处，正好翻身，片片烟消时，方堪拈出。\n不是心，不是佛，明眼衲僧莫轻忽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十一","author":"释智朋","text":"悬崖撒手，藉草眠云，四方八面，移南作北。\n佛祖不历处，古今不到处，如何行履。\n三九二十七，篱头吹觱栗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十","author":"释智朋","text":"兴化打克宾，种谷不生豆。\n虽然费栽培，也要人知有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十九","author":"释智朋","text":"雪窦头上锥，脚下劄。\n拍拍是令，成就一切世界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十八","author":"释智朋","text":"坐断毗卢顶，不禀释迦文，且在下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十七","author":"释智朋","text":"前峨嵋峰，后碧玉盘。\n一字字，一句句，且非草本相瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十六","author":"释智朋","text":"金刚圈，栗棘蓬。\n识得衲僧公验，便是造化炉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十五","author":"释智朋","text":"千圣顶?打开，三涂地底把住。\n是汝诸人鼻孔，总在山僧手里，一时穿却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十四","author":"释智朋","text":"收则大地全收，展则大千俱覆。\n黄面瞿昙，隐身无路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十三","author":"释智朋","text":"入无穷，出无尽。\n把定要津，头正尾正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十二","author":"释智朋","text":"碌碌复碌碌，良马白日足。\n咬定牙关，掀翻地轴。\n神不敢呵，鬼不敢哭。\n世尊入地狱，调达出地狱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八十","author":"释智朋","text":"杓柄人人入手来，莫随颠倒自沉埋。\n普天匝地无回互，黄面瞿昙出母胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七十八","author":"释智朋","text":"透脱言诠，铁山横卧。\n截断言诠，通涂荒草。\n自小持斋今已老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七十六","author":"释智朋","text":"金圈栗蓬，炉鞴镕镕。\n吞得透得，钝铁顽铜，百丈徒誇三日聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七十三","author":"释智朋","text":"是药非药，信手拈来。\n杀人活人，风生八极。\n任是文殊维摩，也少这一服不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七十二","author":"释智朋","text":"一切声是佛声，一切色是佛色。\n三分光阴二早过，普天匝地逐春忙。\n辜负春光，肠断春光。\n杏园啼百舌，谁醉在花傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七十一","author":"释智朋","text":"寂然不动，感而遂通，癞马系枯桩。\n寂而常动，不感而通，四方八面绝罗笼。\n不下禅床，一喝耳聋，不妨游戏人事海中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七十","author":"释智朋","text":"一冬晴暖，梅花尽开。\n林下道人，折得一蓓两蓓。\n但见清香可爱，不知结调羹子未得，犹有雪在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十九","author":"释智朋","text":"正旦令晨，物物咸新。\n衲僧应时纳祐，不是和光同尘。\n柏树子，麻三斤，死柴头上放阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十七","author":"释智朋","text":"大海一沤，未发已前。\n坤六段，乾三连。\n拟欲眨眼，驴年驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十六","author":"释智朋","text":"一处通，千处万处绝罗笼。\n青山常在，知识难逢。\n威音王已前，犹是坐家致仕。\n衲僧气宇如王，沩山笠子，志公拄杖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十五","author":"释智朋","text":"三界无安，犹如火宅。\n良医之门，愈多病人。\n傅大士打失鼻孔眼睛，至今寻讨不见。\n胡相公偏要向高高峰顶起殿，不管盐贵米贱。\n春风一阵来，花开三五片。\n达磨大师挨拶不入，忽携只履返西天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十四","author":"释智朋","text":"寒时寒杀，热时热杀。\n诸方普请寒暄。\n双林寒时热杀，热时寒杀。\n且非别换条贯，大士从来头戴冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十三","author":"释智朋","text":"天上星，夜夜现。\n眼豁开，方始见。\n黄面瞿昙，脑后拔箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十二","author":"释智朋","text":"灵龟未兆之际，黑豆未芽已前，道得一句，盖地盖天，犹未是无师句自然句。\n秋风高，秋空阔，雪峰何曾桶底脱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十一","author":"释智朋","text":"老木成乔林，秋空见明月。\n芥子之中入正定，须弥山中从定出。\n过去佛，现在佛，未来佛，无物堪比伦，教我如何说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六十","author":"释智朋","text":"圣制安居处，凡夫路不同。\n过去不可得，现在不可得，未来不可得。\n掀翻毗卢楼阁，只在顷刻。\n天上无弥勒，地下无弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十九","author":"释智朋","text":"天得中，星辰罗。\n地得中，阴阳和。\n衲僧得中，罢却干戈。\n随寒逐暑，徒自波波。\n一夏九十日，今日是中夏，诸人未举先和。\n因甚问著如何是汝心，却又不会，拄杖子到此，也不得无过。\n是汝诸人，还知痛痒么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十八","author":"释智朋","text":"半夜三更，天昏地黑。\n赤肉团边，捉得个贼。\n正好朝打三千，暮打八百。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十七","author":"释智朋","text":"悲愿海，四生海。\n出没卷舒，圆融自在。\n善慧大士来也，石火电光，且过一边。\n拟欲抬眸，龙华会里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十六","author":"释智朋","text":"握骊颔明珠，秉金刚宝剑，日日禁足安居，个个心空及第，犹是衲僧寻常行履。\n双林乍入院来，不敢背俗违时，下座且与诸人普同作礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十五","author":"释智朋","text":"一不得向，二不得讨，廊下闲行，堂中打坐。\n眼里耳里，观世音，胡达磨，过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十四","author":"释智朋","text":"武帝高悬圣鉴，要见缁素分明。\n大士觌面当机，且非索盐奉马。\n检点将来，只知卖贵，不知卖贱，可惜武帝当时放过，随后好与一拶。\n非僧非道非俗，管取口乾舌大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十三","author":"释智朋","text":"雪窦与么说话，要瞒诸人则易，埋没诸人则难。\n出门见山水，入门见佛殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十二","author":"释智朋","text":"七佛前引，维摩后随。\n但知逐队随邪，脚跟何曾点地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十","author":"释智朋","text":"雪山六载自欺瞒，耿耿明星碧汉间。\n开眼更无回避处，普天匝地黑漫漫。\n古今日月，古今星辰。\n若教频下泪，沧海也须乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十九","author":"释智朋","text":"老僧轩前黄菊花，不可胜数如恒沙。\n谁在画楼沽酒处，相邀来吃赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十八","author":"释智朋","text":"礼自己佛，烧自己香。\n容颜甚奇妙，光明照十方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十七","author":"释智朋","text":"东开西闭，滞在门庭，左出右入，重添途辙。\n新香山有条活路，与诸人共行去也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十六","author":"释智朋","text":"履践平实道路，倚门傍户。\n敲磕崄峻门庭，接响承虚。\n无师智，自然智。\n推倒大梅峰，一举九万里。\n保福缓缓向道，伏惟安置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十五","author":"释智朋","text":"分明见彻，开口犹难，蓦过重关，转身无路。\n只这拙处，作么生去。\n不得有语，不得无语，发机须是千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十四","author":"释智朋","text":"尘劫至今，堂堂丈夫。\n无毫发许，盖覆得渠。\n觅之转失，亲之转疏。\n不论圣凡，说甚贤愚。\n直饶放下屠刀，衲僧门下未敢相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十三","author":"释智朋","text":"大无外，细无内。\n斗换星移，明珠绝颣。\n权实不到处，宾主历然时，佛祖无门著眼窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十二","author":"释智朋","text":"尘劫事，只如今。\n向这里瓦解冰销，如水入水，似金博金。\n未知年穷岁尽在，三年一闰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十一","author":"释智朋","text":"向上机，活人句。\n石火电光，葛藤露布。\n灵踪更在猿啼处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四十","author":"释智朋","text":"冻云垂野，掠地冲风。\n乾坤把定，凡圣潜踪。\n堪笑神光曾断臂，至今埋在雪堆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十九","author":"释智朋","text":"天寒人，寒彻骨，迥无依倚。\n拳到踢到当机，贵得峥嵘。\n眼里无筋，韩獹逐块，皮下有血，杓卜虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十八","author":"释智朋","text":"错步入雪山，茫茫谩寻讨。\n鬼眼忽撑开，草窠里蹲坐。\n见底是明星，悟底是什么。\n瞿昙瞿昙，未敢相保。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十七","author":"释智朋","text":"一国之中，圣主最尊。\n四民之中，君恩最重。\n衲僧居四民之外，正当今日如何报恩。\n万年松顶拂云高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十六","author":"释智朋","text":"多言丧道，多歧亡羊。\n浑无颗粒，别甑炊香。\n惊起暮天沙上雁，海门斜去两三行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十五","author":"释智朋","text":"行路难，有何难。\n不见陶渊明，采菊东篱下，悠然见南山。\n彼此丈夫，莫受人瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]