[{"title":"和王应夫见贻六首 其四","author":"曹勋","text":"大方今始识无隅，明月珊瑚袖手摅。\n愧甚许提圯上履，喜于亲授活人书。\n风神峙玉藏纯白，议论昂霄到古初。\n内顾斐然知不称，祇宜归隐自扶锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王应夫见贻六首 其三","author":"曹勋","text":"联事当年在海隅，再遵南尾笑言摅。\n尚怀拥鼻胡床语，每寄论心尺素书。\n松籁舞风鹰隼后，蒲团附火雪霜初。\n应怜别久愈无味，茅塞如今拟荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王应夫见贻六首 其二","author":"曹勋","text":"平生政不悟三隅，渐老涂穷志莫摅。\n行路又迎新历日，寓怀赖有旧图书。\n逢时意可情犹在，多病心阑事昧初。\n流落此生何处是，欲从老圃学犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王应夫见贻六首 其一","author":"曹勋","text":"冥心艰苦走南隅，每读清言意已摅。\n竹简固尝窥远业，山阴何止识遗书。\n云间未省三年别，海上今欣一笑初。\n乘兴此来传句法，颇容求益董梧锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和台州卫倅","author":"曹勋","text":"昔日连墙事可嘉，固应屡见雪中花。\n稍收帢帻山房景，欲学孤山处士家。\n把酒要陪高士醉，临风未觉此心遐。\n销闲只与山为伴，坐数比邻再及瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叶徵君见寄二首 其二","author":"曹勋","text":"庵扉深向白云隈，尘外朋游首重回。\n三叠琴心融内景，一窗宴坐蕴真胎。\n雨催芝朮依微绿，花发菖蒲积渐开。\n寄语道人端有待，莫留水榭与风台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叶徵君见寄二首 其一","author":"曹勋","text":"诚心接物定吾曹，蔼蔼风期意甚高。\n每谓交梨同火枣，何殊兔角与龟毛。\n道真不契君宜问，来日无多我岂逃。\n但喜夔龙今迅召，东风连日雨如膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石及甫惠蔓菁子","author":"曹勋","text":"初疑坚固出毫端，渐认芳香实满盘。\n功已充盈过膏沐，撷应璀璨掬寒酸。\n烦君玉粒炊圆碧，助我神庭并渥丹。\n复似婴儿当有渐，为增杞菊副朝餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同官问耳疾六首 其六","author":"曹勋","text":"中原困戎马，久欲谒明时。\n文轨虽非昔，英雄似未知。\n寰中无好汉，帐下得猪儿。\n慨念燕然勒，终还吉甫诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同官问耳疾六首 其五","author":"曹勋","text":"袁宏方咏史，江总得随时。\n归兴连天去，文盟落笔知。\n雨多移蚁垤，花过静蜂儿。\n赖有西斋友，薰风正入诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同官问耳疾六首 其四","author":"曹勋","text":"愠心虽悄悄，药物亦时时。\n半耳念非病，全身聩始知。\n三湘怀楚些，一棹忆吴儿。\n会见相陪处，应多古锦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同官问耳疾六首 其三","author":"曹勋","text":"牛斗当年事，何当复此时。\n謷乎虽有象，默尔类无知。\n不作多闻士，难尤造物儿。\n傥能三耳出，更诵五言诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同官问耳疾六首 其二","author":"曹勋","text":"钟鼓嗟无与，衰残亦任时。\n岁华髭鬓上，心事水云知。\n尚若泠然善，何能养就儿。\n数篇存雅道，三复愧新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同官问耳疾六首 其一","author":"曹勋","text":"行年七十化，聩景亦乘时。\n日近尤为祟，雷轰尚弗知。\n顾多居士病，赖有宁馨儿。\n若得都无听，唯哦见赠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其八","author":"曹勋","text":"韵语初疑掷夜光，顿驱热恼作清凉。\n紫髯英槩云仍著，藏室文华锦绣香。\n客况讵能论酒恶，高怀当不较龟长。\n与公避地均休戚，天使诗人识漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其七","author":"曹勋","text":"海色天容浸冷光，秋回山谷进风凉。\n不须悟性三关语，自有澄心一炷香。\n倦客栖迟归意远，暮林摇落晚山长。\n从来习气闻风悦，惭愧如今陛楯郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其六","author":"曹勋","text":"遽颁翰墨发幽光，内顾鲰生德甚凉。\n已幸贰车临海国，因知汗简发天香。\n花梢擢绿蜂初静，梅实桃青昼已长。\n会见紫泥传诏札，中兴事业属清郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其五","author":"曹勋","text":"强栽松竹养烟光，官舍公馀喜晚凉。\n习静关情惟挟策，爱闲修供只焚香。\n自怜怯事如欣泰，止合抠衣扣子长。\n断断此生今已矣，拟寻艇子学渔郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其四","author":"曹勋","text":"世道艰虞太白光，风栖雨食铁衣凉。\n谁歌汉月空相识，漫有山花先自香。\n塞上许时兵未息，水边它日话尤长。\n想当清夜圆蟾白，曾欲题诗问庾郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其三","author":"曹勋","text":"爝火宁知日月光，遽闻骑火犯伊凉。\n周宣懋建中兴政，上帝潜符至治香。\n天欲卦爻重彖象，民知瓜瓞本绵长。\n商孙驾驭方经武，行见蒙冲系夜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其二","author":"曹勋","text":"春光过似不春光，自念曾无作法凉。\n鞍马固先均臭味，薰莸安得更芬香。\n画脂敢谓名堪惜，食榄今知味更长。\n珍重好辞皆发药，颇惭宫徵顾周郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙倅见贻八首 其一","author":"曹勋","text":"十篇妙唱贲幽光，秀韵凌虚桂影凉。\n玉牒秩宗徽誉著，银钩挥翰麝煤香。\n风兼远水痕成理，月入霜筠影自长。\n铜雀春深知有以，典刑终合问孙郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和次子积雨损红木犀","author":"曹勋","text":"应向西瑶立赤墀，鲜云仍带绿烟宜。\n要先篱菊三秋艳，不放蟾华一点窥。\n颇讶夙宵凉雨疾，顿思晨发晓光披。\n骚人豪举经年意，绝叹丰姿积渐吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和次子耜久雨韵三首 其三","author":"曹勋","text":"连朝阴未断，仰食虑尤深。\n檐溜无穷响，村灯几处砧。\n吾儿诗有债，老我韵劳心。\n屏翳安能借，吹天扫积阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和次子耜久雨韵三首 其二","author":"曹勋","text":"眩瞀知阴久，茶瓯不厌浓。\n第忧沉稼穑，宁问浸芙蓉。\n天阔翻盆雨，云昏淡墨峰。\n长安鼎烹者，列坐正撞钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和次子耜久雨韵三首 其一","author":"曹勋","text":"绿涨东篱菊，桐凋古井栏。\n雨频伤早谷，烟冷作新寒。\n有木皆生耳，何颜得渥丹。\n平章济农事，清坐且团团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张才甫野望轩","author":"曹勋","text":"闻辟新轩槛，高明岂鞠穷。\n八荒供望眼，万事付冥鸿。\n聊味青龙钞，行趋白虎通。\n大千兼内外，拈出便无同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张正仲朝散","author":"曹勋","text":"万里关河雪正霜，自怜跣履苦奔忙。\n宦情久欲休言责，世态何能学坐忘。\n赖有新诗排困踬，未忘浊酒发清狂。\n得公韵语袪烦甚，亟揖筠风续报章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张直讲","author":"曹勋","text":"老境从远事事慵，却寻幽刹寄年丰。\n本无虚舍能回暑，赖有疏篁可致风。\n臭腐固尝忘物化，箪瓢宁复较天穷。\n向来习气端如故，经醉犹能间一中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张凝神见贻","author":"曹勋","text":"奉引归来春晚时，扁舟便欲访天随。\n都忘旧学尘埃满，顿觉新年气宇衰。\n遽有恩荣腾紫诏，了无功业立彤墀。\n先生妙句烦褒借，一夕光涵月不亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李判院宿松隐见贻","author":"曹勋","text":"未论琢句比玄晖，馀事犹思学退之。\n数亩园荒松菊在，一生心有水云知。\n时平岂暇寻三窟，事际何能出六奇。\n幸有松篁隐幽筑，所欣鹤驭到时时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨季廓解元","author":"曹勋","text":"下帷闻说尽英奇，赋就三都墨未醨。\n分比楚兰同讲学，文踰荆玉不遐遗。\n豹藏烟雾聊相与，蚌剖珠玑要及时。\n龙虎他年题淡墨，绿衣皂盖看风姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和苏养直见贻二首 其二","author":"曹勋","text":"罗浮真隐下珠宫，一粒丹砂魏武同。\n岂但脩龄还稚齿，因知韵语尽仙风。\n潜真已信人非远，拔宅悬知理可穷。\n分我刀圭他日事，红尘先拜紫髯翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和苏养直见贻二首 其一","author":"曹勋","text":"投闲久去大明宫，钟鼎山林兴已同。\n但得眠云仍钓水，不妨抹月与批风。\n颇能植杖闲为圃，尚欲临文学送穷。\n烦子远来忘趼足，问言今作白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈御带见贻","author":"曹勋","text":"汉室文章远业成，斗南英气为时生。\n新兼带插严天仗，夙展韬钤卫帝营。\n四塞羌戎知号令，五军貔虎畏威名。\n中兴方倚军容振，功业行看衮绣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈朝议见寄二首 其二","author":"曹勋","text":"老我驱驰未得归，山中空挂薜萝衣。\n三台胜地松连菊，五亩幽居竹映扉。\n黄卷青灯真我事，鲈鱼白酒亦天机。\n骚人往往秋多感，莫向登临叹落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈朝议见寄二首 其一","author":"曹勋","text":"念公事业未能归，莫厌京尘化客衣。\n游子固闻怀楚玉，垂堂应每倚荆扉。\n仲舒正尔宜投策，丘嫂从渠不下机。\n他日秋风雕鹗便，雍容车骑更光晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和国器因以奉勉","author":"曹勋","text":"宿云浓澹弄空明，桃李吹香雨屡经。\n燕识旧巢犹颉颃，枝骈新绿尚芳馨。\n力田须待年多黍，知病好寻参与苓。\n莫为无家动乡思，且筹杰论献明廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和国器喜以事业为怀二首 其二","author":"曹勋","text":"久无轩冕意，出处亦何心。\n世味思三沐，花风快一襟。\n喜君方砺志，顾我岂知音。\n医手非吾事，深惭不可箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和国器喜以事业为怀二首 其一","author":"曹勋","text":"郑氏传家学，诗书不愧心。\n佩刀知素业，左序况同襟。\n但喜知难字，何能识至音。\n小轩多暇日，为赋九州箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和绍兴次子所寄诗","author":"曹勋","text":"连旬零雨暑犹强，未信人间八月凉。\n瓮里曲生初泛蚁，壶中桂子并寻芳。\n斑衣未遂兰玉集，吾子少留云水乡。\n门户喜犹家法在，诗情辄莫似王阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和英上人见寄","author":"曹勋","text":"华鲸吼雨晓声长，诗罢萧闲百步廊。\n倚暖花梢清有思，傲霜菊蕊冷犹香。\n好闲懒瓒聊煨芋，不病维摩尚倚床。\n满眼云山应自足，笑渠门外马蹄忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和英书记二首 其二","author":"曹勋","text":"向来衰病倦年华，坐卧颓然静不哗。\n只拟闲时忘往事，了无好语继馀霞。\n屡哦物表云笺句，一扫空中睡眼花。\n每到思丰如奉诲，结茅喜近梵王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和英书记二首 其一","author":"曹勋","text":"本期雅奉水云心，况有伽陀冠二林。\n海蚌得来珠莫剖，荆山凿处玉难寻。\n翛翛真隐渐方丈，曳曳闲云渺故岑。\n回首瑞峰空在望，只容俯首听挐音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和茅山张达道二首 其二","author":"曹勋","text":"好笑曹功显，山林过几春。\n世缘犹积压，尘网复因循。\n踵息绵如在，颠毛雪更新。\n岁华行八十，泉石正驰神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和茅山张达道二首 其一","author":"曹勋","text":"茅岫藏清隐，诗仙秀格春。\n道真渊有妙，素守峻能循。\n鹤举秋声远，诗成句法新。\n遥知游咏乐，下笔更如神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑国器来自江州道中之什","author":"曹勋","text":"闻道山炉一炷香，三馀常得寸心降。\n直须了取诗千首，始可闲期璧一双。\n梅润未能排絮帽，日阳只拟上云窗。\n伫公纳锡充前列，毋使迟迟出九江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑康道二首 其二","author":"曹勋","text":"耕隐春江水尽头，一廛已自鄙通侯。\n好辞遽作春半别，归意欲兼天际流。\n我尚未栽三径竹，君能先泛五湖舟。\n要来便作乘风客，莫使烟光有许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑康道二首 其一","author":"曹勋","text":"绝叹当年故作痴，水边林下欲清非。\n未应阮籍涂穷惯，自是王通世念微。\n仗节旧闻英槩伟，挂冠惜与壮心违。\n起予径办从公物，一䩫芒鞋一衲衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和泉伯幽思韵二首 其二","author":"曹勋","text":"每惜年华易，风灯与凿光。\n心情成老大，世态只炎凉。\n冷入芭蕉雨，烟轻薜荔墙。\n故人愁更远，夜夜渡清湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和泉伯幽思韵二首 其一","author":"曹勋","text":"萧萧云日静，细细竹风侵。\n窗影方虚白，炉烟一没沉。\n帝乡怜久客，归梦亦何心。\n洞户褰珠网，应烦问藁砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贺参政与应宣教诗应居与坟庐相近","author":"曹勋","text":"庵外山高水不穷，庵中道德与时隆。\n岂图宝所千峰静，得奉清言一笑同。\n幽筑禅扉俱不远，水光萝月冷相通。\n它年更约稽山老，共棹西溪十里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和都运龙图二首 其二","author":"曹勋","text":"老去心情故倦游，直诚自许赋休休。\n清流固已久绝望，白发只今空满头。\n软语每思挥玉麈，寻源便欲过瓜洲。\n他年一棹烟江雨，有愧轻轻不下鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和都运龙图二首 其一","author":"曹勋","text":"一时耆旧尽英游，玉节迎銮暂少休。\n不以秦人视越瘠，载驰楚尾与吴头。\n两淮浓被钟离政，一水聊萦杜若洲。\n行见锋车还禁橐，已看仁化浃鱼鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钱处和野堂 其二","author":"曹勋","text":"堂隐云将隔，名高客已知。\n半岩施匠石，一室见操为。\n钟鼎功方著，山林兴未迟。\n兰台风致在，更喜读新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钱处和野堂 其一","author":"曹勋","text":"日净岚光上，山藏野意添。\n海潮来隐几，越岫巧当帘。\n绝俗宜招隐，论诗未属厌。\n居虽朝市近，事事见安恬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高路分见赠二首 其二","author":"曹勋","text":"照世名流玉与清，公家勋业有繁缨。\n格言追古如陶令，妙句锵金谢子卿。\n卜筑靓深均里闬，山林佳绝得天成。\n两篇奇语难修报，褒借飘飘愧此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高路分见赠二首 其一","author":"曹勋","text":"行年以礼古犹今，况已华颠雪满簪。\n五子政须俱治产，两疏宁复较挥金。\n稍摅云水安闲计，得展江湖漫浪心。\n一笑相逢慰岑寂，更烦击节发清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚中见赠二首 其二","author":"曹勋","text":"销沈壮气已无馀，尚有床头数卷书。\n再命岂宜居旧物，三乘只合乐真如。\n脩门喜见平生友，穷巷何堪长者车。\n顾我久寻方外侣，按摩颇欲献呵嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚中见赠二首 其一","author":"曹勋","text":"珊瑚明月堕微茫，春入灯花暖夜缸。\n但阅玙璠来棐几，颇惭心迹倦芸窗。\n云间旧是贤者隐，江夏久无清誉双。\n拭目须君上霄汉，且将韵语伴澄江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虚中所惠佳什","author":"曹勋","text":"君家妙誉自无双，每肯区区问礼忙。\n颔下老髯仍不白，颜间喜气已微黄。\n力扶雅道新章句，蔼有雄文古战场。\n一夕诗来增浩叹，更和秋雨听浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄南嘉相贺","author":"曹勋","text":"贼马凭凌势怒号，铁衣夜挂映征袍。\n谨严甲士方超距，森索妖星绝绎骚。\n横槊赋诗虽昔事，枕戈待旦敢徒劳。\n公诗一洗烟尘气，愧甚横行不鼓刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄虚中韵二首 其二","author":"曹勋","text":"喜见丰姿眼倍明，从来事事胜公荣。\n相望震泽三江水，便隔秦关万里情。\n连茹搢绅游北阙，如公文采似东京。\n举觞喜共留春住，为读新诗一座倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄虚中韵二首 其一","author":"曹勋","text":"昔时意气控云霄，老矣方能造治朝。\n一日暂违文石陛，十年空采越山樵。\n歌传楚些聊供醉，鬓点吴霜未肯销。\n三叹公诗话京洛，起予乡思欲扶摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和曾守东郊赏梅兼送范子芬","author":"曹勋","text":"溪曲山横动晓光，天开玉雪照崇冈。\n不妨花陌依微雨，为洗春风澹薄妆。\n送别休歌河满子，相思留待返魂香。\n坐中客已无肠断，何况离声更抑扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]