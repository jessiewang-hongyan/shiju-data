[{"title":"吊黥卒","author":"周文璞","text":"吾作穷奇白下囚，汝披短褐从吾游。\n蒋侯庙畔沽春酒，周处台边送客舟。\n械欲破时应日惨，命将绝处亦天愁。\n江陵柳大如知此，对著官军辄泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自笑","author":"周文璞","text":"自笑萧条甚，微吟坐到昏。\n江风来扫地，山鸟见开门。\n茶面龙头缩，花梢犊鼻温。\n一从杯酒少，不复过深村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过凤山有感二首 其二","author":"周文璞","text":"秋芜阙是草堂基，惟有南邻尽得知。\n辛苦置家将守冢，告求广地要穿池。\n净莲已付乡僧掘，慈竹从教墓客移。\n虽向龙湾作耆旧，此生宁没暂来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过凤山有感二首 其一","author":"周文璞","text":"当年准拟作家林，溪墅楼居意已深。\n隐者自应寻别业，凤兮何肯负初心。\n参差一段囊中玉，激烈三更月下吟。\n若不速来相就饮，定应从此失知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初营凤山","author":"周文璞","text":"香草参差种，幽花逐旋移。\n既添醒酒石，须著放生池。\n春在年年好，山来处处奇。\n吹箫吾不解，长啸却相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴中秋日","author":"周文璞","text":"郊原落叶已离离，尚有孤花闯短篱。\n小醉不成怜病后，苦吟未了说愁时。\n斗鸡走狗爰丝喜，临水登山宋玉悲。\n豆角已收无别事，待同野老赴襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀何月湖","author":"周文璞","text":"星星鬓发卧林丘，诏使东川作郡侯。\n髯叟望公来海峤，瘿兵迎守去夔州。\n珍图想挂茅斋壁，巧石应随竹钉舟。\n教得巴童歌舞好，侍郎千万却归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨孟博挽词","author":"周文璞","text":"向来洛下老书生，今见诸孙更老成。\n不复秀才趋试院，已题文学上铭旌。\n泛观今古人亡恨，只有英雄命莫争。\n来吊乍闻妻子哭，依然认作读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岸帻","author":"周文璞","text":"岸帻坐亭皋，休嗟命不遭。\n通幽文似咒，招隐句如骚。\n日下桃花热，风低鹤背高。\n真游穷不尽，只是酌芳醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"周文璞","text":"雨意遽如许，云容亦可怜。\n声声总断续，滴滴更匀圆。\n道院烧香地，山房焙画天。\n故园无恙否，润色到瓜田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨宿山中","author":"周文璞","text":"留连如有情，蕙帐极空明。\n晚粥知泉味，昏钟度雨声。\n稍容林叟睡，莫放晓猿惊。\n剩欲剜苔藓，应当写姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"既离洞霄遇雨却寄道友","author":"周文璞","text":"凡骨何堪得再行，渴心犹要谒通明。\n惊闻竹树连山雨，疑有风雷㩧地声。\n鹿啖黄精知岁久，人逢青箬便神清。\n重来只要斋盂饭，副以常堂枸杞羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春怀","author":"周文璞","text":"棠梨未落柳丝长，料望幽人作断肠。\n已自不堪田父饮，更能重入少年场。\n山连莽莽荒陂白，门掩萧萧野日黄。\n想得故园疏雨外，樽前催拍杜韦娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日孤山道院","author":"周文璞","text":"孤山有何好，脩竹隐楼居。\n人在秋云杪，香凝午醮馀。\n芳林多落果，灵沼少惊鱼。\n归棹闻歌咏，犹如学步虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晦有怀南仲正字","author":"周文璞","text":"怀人几日恶，况复值秋阴。\n天亦容清调，人难识素心。\n他乡谁馈肉，永夜只听琴。\n高咏龙泉碣，相从发至音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之官严陵","author":"周文璞","text":"如君风貌又精神，自合拖绅近紫宸。\n平地有心开洞穴，十年无俸著闲身。\n已看青舫垂垂去，须忆绯桃滟滟春。\n若向玄英台下过，为言亦是学诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人入浙","author":"周文璞","text":"小县登楼上，依稀是去年。\n更阑吹短笛，饮散觅归鞯。\n丹叶标寒渡，黄花羃野田。\n重来吊古地，为拊石羊肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送逸人归茅洞","author":"周文璞","text":"三君乘白鹄，各在一山椒。\n子去穿茅洞，人方采药苗。\n花连云气近，松转水程遥。\n想得寻幽侣，空歌散午朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送道友归","author":"周文璞","text":"浮云起足下，是子欲归家。\n藏室收芸蠹，丹房扫箭砂。\n时闻捣药鸟，啼向款冬花。\n莫使山童去，惊飞逐乱鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送髯高谒方岩","author":"周文璞","text":"客舍窘积雨，出门今始晴。\n药苗随野饭，燕子看山行。\n大道白日晚，闲汀绿芷生。\n方岩相见了，为谢草堂兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送薛子舒","author":"周文璞","text":"龙泉饯语馀，便使借船居。\n津吏方抽木，官人但载书。\n潮通白碇石，身近碧京鱼。\n一卷新文就，皋禽亦自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽正字南仲四首 其四","author":"周文璞","text":"一自初闻报，哀号向草堂。\n相随只儿子，远和有山獐。\n土沃幽宫掩，灰凝奠酒香。\n孤身挥泣尽，松柏便萎黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽正字南仲四首 其三","author":"周文璞","text":"珠璧方辉耀，菁华未寂寥。\n极知身作祟，何用食为妖。\n牺象收儒庙，箫笳咽市桥。\n伤心纱帽冷，三径雨潇潇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽正字南仲四首 其二","author":"周文璞","text":"卷舌空沉彩，芸香亦蠹贤。\n几时噫凤沼，一旦感龙泉。\n远播雕题外，高垂若木边。\n煎胶嗟不及，遗碣暝台悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽正字南仲四首 其一","author":"周文璞","text":"千古应无恨，诸公竟不能。\n要令参溟涬，端合罢飞腾。\n白草伤麟野，苍山下马陵。\n有儿持手泽，泪落照书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂","author":"周文璞","text":"偶向花边立，悬知病已瘳。\n小山今夜月，团树满庭秋。\n清露沾丛底，斜河在上头。\n须臾香更好，还与碧云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涧上小饮","author":"周文璞","text":"方坐爱蠲洁，俯窥为回萦。\n汲汲雨露泽，悠悠江海情。\n引之灌蔬圃，亦足发光晶。\n陶然未须去，于焉潜我名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后","author":"周文璞","text":"风灯露水两茫然，莫为欢华少壮年。\n无病更须求药物，爱闲犹要觅缗钱。\n此生身世揶揄里，末路光阴泣涕前。\n快出囊中餐玉法，白云深处日高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄友人","author":"周文璞","text":"流落他乡铩羽翰，半年宁复记悲欢。\n夜传楼鼓思城角，朝见江船念客鞍。\n不恨形骸老闾里，遂令唇舌满长安。\n寄声好在文章友，目送春云自倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食有感三首 其三","author":"周文璞","text":"亭午步江皋，谁云命不遭。\n爱风吹蛱蝶，怕雨烂樱桃。\n钻火烹新乳，槌门觅小槽。\n今年奇事少，尘满旧征袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食有感三首 其二","author":"周文璞","text":"清明好时节，傲吏小诗家。\n失意因流水，伤心为落花。\n人归知市静，日落见山斜。\n明日三叉路，村醪亦自佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食有感三首 其一","author":"周文璞","text":"生平参道术，师事大茅翁。\n持钥开金匮，焚香立玉童。\n黄麟来地上，朱鲤出江中。\n今在桁杨畔，依依睡晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩涧泉","author":"周文璞","text":"穷冬孤陋只书痴，肯为凶荒强忍饥。\n师友渊源似公者，舆台贫贱亦安之。\n人来山县犹须债，雨映茅檐但要诗。\n欲诣楼居无逸步，要从老手化神奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题馆娃即灵岩寺","author":"周文璞","text":"突兀僧蓝是馆娃，屧廊犹自隐晴霞。\n清明但长离宫草，精魄应栖野寺花。\n白苧黄蕉迷鹤市，紫兰绿芷属渔家。\n思量种蠡成何事，空使君王式怒蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅谷","author":"周文璞","text":"香焰云头玉雪身，缓行微咏岸乌巾。\n始从谷里看脩竹，却向水滨逢丽人。\n客子去时方得月，岭猿啼后便无春。\n凤凰欲下箫声紧，狼籍瀛洲万斛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊月八夜雨","author":"周文璞","text":"愁云欲雪未成雪，忽闻寒雨夜淋浪。\n但知岁月堕寂寞，不悟乾坤发艳阳。\n天黑鬼车声更大，夜阑客枕梦初长。\n明朝起视篱砌下，草芽浥浥又回黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴七言三首 其三","author":"周文璞","text":"夜夜推敲学苦吟，一如锻鍊假黄金。\n石间真隐何时出，地下狂魂无处寻。\n独鹤尚知长袖舞，哀猿空作断肠音。\n故墟杞菊今何似，桂落小山春水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴七言三首 其二","author":"周文璞","text":"在家莫羡出家僧，扰扰营营竟未曾。\n相国舟中龙夺剑，山人琴畔鬼吹灯。\n从来不肯寻真诀，更自无心学大乘。\n汉室诸公鸣玉佩，也须还我一枝藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴七言三首 其一","author":"周文璞","text":"寥寥古意少人传，莫为薰琴只五弦。\n夫子纵心方学易，我曹何意便谈玄。\n神驰洙泗身将老，望断沅湘眼欲穿。\n月白风清如此夜，阿郎不肯上钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简正字南仲","author":"周文璞","text":"白发梁鸿随暮猿，不辞引领望兄门。\n久无清梦相追逐，今喜遗经为讨论。\n数叶赤枫鸣客路，一畦黄薤忆家园。\n著书不就身何用，每见飞尘恨满轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"周文璞","text":"望见山樱媚短岑，翻然便悔出家林。\n坏车杀马空嗟晚，裂芰焚荷直到今。\n笋蕨久为归去计，云烟无复旧来心。\n平生最爱花浓淡，看了斜阳看暝阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"周文璞","text":"山中雨更愁，不是弃吾州。\n怀母未能去，诉邻谁肯留。\n茶人穷似虱，药户狭于舟。\n一涧多深碧，嘲吟尚自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题天童全老","author":"周文璞","text":"天童宝楼阁，铜钉敞朱扉。\n一老烧香后，诸禅乞食归。\n天听涂毒鼓，神捧苾刍衣。\n说了村夫偈，依然入翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题尧章新成山堂","author":"周文璞","text":"早将心事付渔樵，若被幽人苦见招。\n多种竹将挑笋吃，旋栽松待斫柴烧。\n壁间古画身都碎，架上枯琴尾半焦。\n犹有住山穷活计，仙经盈卷一村瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题洞霄宫","author":"周文璞","text":"久知灵境无缘到，今被春风引得来。\n上帝殿头闻雨过，仙人石面欠花开。\n便烧沈水礼三拜，快引流霞釂一杯。\n落日断霞催去紧，掉巾祇等白鸦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤庙","author":"周文璞","text":"樱桃花覆地，古庙自青春。\n帐里还丹使，山中采药人。\n风林嗥黑虎，云路列斑麟。\n欲见神君面，连朝礼北辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈宗之","author":"周文璞","text":"伊吾声里过年年，收拾旁行亦可怜。\n频嗅芸香心欲醉，为寻脉望眼应穿。\n哦诗苦似悲秋客，收价清于卖卜钱。\n吴下异书浑未就，每逢佳处辄留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠虎丘僧道辉游天台二首 其二","author":"周文璞","text":"少小即精勤，参禅复著文。\n香薰沪渎像，茶酹武丘坟。\n入定山猿见，吟诗海鹤闻。\n幽情正迢递，又拜石桥云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠虎丘僧道辉游天台二首 其一","author":"周文璞","text":"世赞碑文换，穹龟上绿苔。\n琵琶不可听，楼阁更堪哀。\n竹动禅僧入，梅香冻雀回。\n开函翻内典，日晚未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隐者","author":"周文璞","text":"袁三柳大刘廿八，长到先生卜肆边。\n便拜逸妻为嫂氏，更沽村酒作家筵。\n山公马在何须尔，林屋丹成亦偶然。\n独此老身无藉赖，为他人掷卦爻钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月过凤山舟回入项王祠用前韵","author":"周文璞","text":"坠叶浓于染，孤花净似霜。\n溪山如有待，朱粉玄施妆。\n胜境如天上，雄鸣自帝旁。\n工陈白玉琯，人坐紫金床。\n古兕称春酒，灵虬换夕香。\n风筝犹有韵，星弁忽分行。\n念此锄榛垄，频来渡苇航。\n欲挥终极泪，只废苦吟章。\n慨慷辞欢伯，英雄忆愤王。\n逝骓嗟弗及，撞斗恨难量。\n起舞何劳短，行歌未要狂。\n断云将落日，千古助哀凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昔","author":"周文璞","text":"忆昔在童初，身轻俗累无。\n云霞明道服，日月缀仙都。\n屑玉三危露，泥金一丈符。\n遨游即阊阖，佩带或昆吾。\n学语窥真诰，谈玄校易图。\n竹间时搏拊，松下亦樗蒲。\n谪堕归岩壑，庸凡近仆奴。\n极知方匿景，何敢遽抟扶。\n请命书盈纸，祈真泪迸珠。\n但能觇帝座，不恨守天厨。\n谴巨知难逭，心安敢自诬。\n相随有芒屦，还欲化双凫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊辰感事二首 其二","author":"周文璞","text":"幕府才方盛，军师意最高。\n何年燕巢木，几处马腾槽。\n驰骋心方壮，指麾身更劳。\n周诗歌劳徕，费誓说逋逃。\n行阙占风角，穹庐拜羽旄。\n飞腾真有种，淡泊正相遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊辰感事二首 其一","author":"周文璞","text":"久要和平福，须宽次第刑。\n诸公善调壹，熙祚必清宁。\n夹道焚香拜，今知病酒醒。\n谩劳双鬓白，何止故山青。\n妖纬朝沉彩，非烟夜透扃。\n愿同臧获列，齐寿八千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过葛天民新居","author":"周文璞","text":"为忆空山雨，因嗟短鬓霜。\n幅巾终日仄，侍女古时妆。\n乌臼残林外，丹砂旧井旁。\n不留禅月画，只踞净名床。\n湖镜秋容淡，云庄晓露香。\n汲泉须透脉，种果便成行。\n使鹤过村店，携孥上野航。\n极知秦外叟，全似贺知章。\n对佛称居士，翻经悟法王。\n自将诗检校，犹与竹商量。\n嗟我浑无赖，非公不作狂。\n莫移松下石，老子要乘凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居日有幽事戏作","author":"周文璞","text":"竹暗僧窥户，莎寒鹤上厅。\n壁悬陈处士，屏贴少微星。\n垒甓为蔬圃，埋盆学蓼汀。\n自知痴得计，常用醉为醒。\n野客兼称仆，幽禽代作伶。\n浴凫翻落涧，斗雀堕空庭。\n算数推三甲，防身召一丁。\n案头松叶响，墙角柚花馨。\n梵庋堆书笈，醪罂隐粟瓶。\n茅茨隐烟雨，鸡犬也忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上冢","author":"周文璞","text":"蒸鱼燔肉当好羞，北面百拜如有求。\n愿身长健儿孙好，岁岁此日烧松楸。\n纸钱灰尽泪不尽，孤也虽在犹拘幽。\n沄沄金盖山下水，相送直过龙湾头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞","author":"周文璞","text":"嵌空才入泉潏潏，隔凡倒悬若锥立。\n道士云是闾丘公，入向华阳便门出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小寒食","author":"周文璞","text":"从来寒食多风雨，不料穷乡亦管弦。\n壮岁心情悲昨梦，异乡时序感流年。\n偶随游子来溪上，因与棠梨立路边。\n从此堪悲转憔悴，随群同上钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山乐官","author":"周文璞","text":"山乐官，尔谁魂，逃河入海俱奔奔，伶伦梨园何可论。\n山乐官，予欲尔兮无言。\n如有言，为余歌云门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不欺斋","author":"周文璞","text":"陈兄榜名不欺斋，不欺本自诚中来。\n晚周洙泗汉伊雒，中间此道寒如灰。\n不欺斋中一尊酒，兄乎此意差耐久。\n真情往往到僮仆，何况亲知与朋友。\n君不见汤脱胡桃一语失，此是迂翁年少日，陈兄再拜吾事毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋日游能仁北寺两刹","author":"周文璞","text":"轻云漠漠烟漫漫，杖藜扶行不作难。\n无量寿佛像最古，未曾有经碑亦残。\n秋花泫露颜色好，客子著雨衣裳单。\n题诗写寄莓苔壁，勿使俗人相对看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸟媒","author":"周文璞","text":"一自弋者篡，冥飞亦云多。\n庖牺网未收，同类如予何。\n已噤伐斧篇，去去依女萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云根","author":"周文璞","text":"云从会稽生，旦旦见伯禹。\n听读山海经，成龙不成虎。\n禹命云归欤，可向蕺山去。\n昂昂王内史，眉宇照今古。\n常在此盘旋，深藏无处所。\n王孙江海人，云根自栖翥。\n招邀玉叶来，以石为伴侣。\n既从衣上浮，只就茶里煮。\n不入晋家池，肯作秦望雨。\n两儒一支郎，不学世间语。\n吴伧哦五字，坎壈酸涩苦。\n并送山中人，约束云下取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]