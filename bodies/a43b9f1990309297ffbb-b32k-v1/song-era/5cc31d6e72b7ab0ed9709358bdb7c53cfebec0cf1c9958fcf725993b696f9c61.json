[{"title":"取凉 其二","author":"洪咨夔","text":"平湖水则减三分，尚欠红蕖一段云。\n万斛波光自吞吐，月明亦足张吾军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子有感时","author":"洪咨夔","text":"八州都督新推毂，两纪中书旧覆瓯。\n郿坞然脐如有策，聊城飞笴便无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和俞成大八月梅花","author":"洪咨夔","text":"秋光深处送春来，青叶扶疏数点梅。\n料是知君新酿熟，搀先九月菊花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人送墨","author":"杨炎正","text":"黑月黳云脱太清，海风吹上笔头轻。\n琐窗冷透芙蕖碧，定有新铭到九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和续古蜜朮","author":"洪咨夔","text":"参桂齐名骨自香，百花酿醑助甘凉。\n含金咀玉风标别，消得肩吾为发扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄几叔墨梅 其二","author":"洪咨夔","text":"六月夜窗留取看，霜风萧飒堕林端。\n问渠底事青青晚，耻上寻常桃李盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄几叔墨梅 其一","author":"洪咨夔","text":"月暗云迷竹外枝，寒香未动便能奇。\n面如坡老南归后，骨似温公独乐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄宰招饮","author":"洪咨夔","text":"大都春色三分耳，能得眉头几度开。\n见说东家酒初熟，不论今雨也须来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和楼前梅 其一","author":"洪咨夔","text":"飞香涨艳拍檐牙，暖热楼居鄂陆家。\n宝髻盘鸦冰柱晓，倚阑平折北梢花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和楼前梅 其二","author":"洪咨夔","text":"楼高夜静月华陈，冷浸含章一段春。\n人影花光相上下，定知梅亦解分身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚寅元日甲子晴","author":"洪咨夔","text":"圣君元命是元正，三素云开甲子晴。\n不识姓名农圃老，相逢便与贺升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弥牟观土八阵寄程嘉定","author":"洪咨夔","text":"房公堂是盖公堂，漏下无声日正长。\n应念常山蛇阵处，有人搔首立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"抹利","author":"洪咨夔","text":"翡翠帘帷雪透肌，纤风不动闹香吹。\n裴回顾影精神发，省得京华识面时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林氏著存亭","author":"洪咨夔","text":"有铭于鼎未为著，无忝所生方是存。\n筱下若人元不死，春风吹雨着寒根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林同年被檄来体访民租寓僧舍有诗因次韵 其二","author":"洪咨夔","text":"我虽不饱尚二簋，人则何辜无一襦。\n官侬早下减租笔，天下可肥身宁臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自天封登华顶将自桐柏以归土人谓之望海尖","author":"韩元吉","text":"连天松影转崔嵬，夹道桃花迤逦开。\n便觉胸中有东海，不知脚底是三台。\n閒云自作千峰雨，流水真成万壑雷。\n唤起吹笙王子晋，夜深乘月上琼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直玉堂和李参政绝句","author":"洪咨夔","text":"曲折宫墙日影方，堂深人静似山梁。\n斲榈叶底梅花老，次第风光到海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院口占 其一","author":"洪咨夔","text":"燕随社去雁初来，黄蜀葵花隔岸开。\n万里江湖秋思动，捣橙和蟹荐新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院口占 其二","author":"洪咨夔","text":"追怀三五少年时，岁月堂堂两鬓丝。\n茅屋秋风归未决，障泥能费几熊皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中次韵 其一","author":"洪咨夔","text":"积多云鹤岩前雨，种遍长松墓上田。\n丰歉相乘天有数，今年管取斗三钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉峡","author":"洪咨夔","text":"水绕江南阿李家，满空飞雪响雷车。\n流将采石矶头去，坐看浮梁压浪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青草梦诗后两句早作足之","author":"洪咨夔","text":"乾马坤牛放手骑，纵横上下尽通逵。\n杖头挑起东风海，挂向东边若木枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青渠追和宋金部壁间韵 其二","author":"洪咨夔","text":"汗青孰与老黄间，能为君王把蜀山。\n懊恼秋风吹客鬓，一年三过剑门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青渠追和宋金部壁间韵 其一","author":"洪咨夔","text":"短亭放脚小轩渠，从险趋平本一涂。\n掌上烟川三百里，蜀都风物似吴都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"促织 其一","author":"洪咨夔","text":"一点光分草际萤，缲车未了纬车鸣。\n催科知要先期办，风露饥肠织到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"促织 其二","author":"洪咨夔","text":"水碧衫裙透骨鲜，飘摇机杼夜凉边。\n隔林恐有人闻得，报县来拘土产钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞成大送新芋","author":"洪咨夔","text":"谢三郎女败蓑衣，褴缕中藏玉雪肌。\n柱下莫愁无乳媪，秋风得此可忘饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奖菊 其一","author":"洪咨夔","text":"木犀满送第三香，交割秋光与后行。\n细雨斜风篱下菊，安排青蕊做重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奖菊 其二","author":"洪咨夔","text":"菰叶离披藕叶攲，精神得似未秋时。\n西风坐断群芳路，不属黄花更属谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡中","author":"洪咨夔","text":"清猿遗响落三巴，树老霜迟叶未霞。\n大抵近南春易早，梅花开尽又桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽芳晚凉倚窗观稼 其一","author":"洪咨夔","text":"晚风不动稻苗平，叶叶头边沆瀣明。\n井养不穷功用在，谁将易象细推评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日山行 其二","author":"洪咨夔","text":"两点眼光牛背上，一窝春色落花边。\n世缘不到山深处，只恐深山起世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日山行 其一","author":"洪咨夔","text":"一晴一雨柳添碧，半落半开梅著酸。\n不被东风相鼓弄，春山只有老苍官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春行","author":"洪咨夔","text":"野荼蘼发牡丹开，蔌蔌杨花堕酒杯。\n过尽韶华才一出，祗应唤作探春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春思 其一","author":"洪咨夔","text":"柳汁何能染鬓根，柳丝只解绊愁魂。\n年光有底催人急，水牡丹花又上盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春思 其二","author":"洪咨夔","text":"细草荒烟古墓田，知经寒食几年天。\n雪条花下翩翩纸，疑是曾分白打钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春思 其三","author":"洪咨夔","text":"蝴蝶深深浅浅黄，被春恼得一般狂。\n打团飞入菜花去，自信世间无别香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳絮 其一","author":"洪咨夔","text":"造化勿忘还勿助，精神非色亦非空。\n残云初雪雍容甚，高下东风点乱红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳絮 其二","author":"洪咨夔","text":"风标清白难谐俗，气候中和易得朋。\n招不肯来麾不去，若无才思渠应能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独夜","author":"洪咨夔","text":"两窗明月一庭霜，佛屋风铃语夜长。\n孤酌不多人易醒，九回肠付篆盘香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋半闻莺","author":"洪咨夔","text":"木叶青黄几栗留，尽情啼破两山幽。\n怕人冷落生秋思，故作春声为遣愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"洪咨夔","text":"一曲玉连琐，十分金屈卮。\n故新相代谢，底用为秋悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆州江浮水灯作佛事","author":"洪咨夔","text":"谁把银河彻底倾，倒翻星斗著行明。\n又疑笼道红栀子，隐隐鸣鞘出五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草堂","author":"洪咨夔","text":"严武能诗甫亦诗，诗名相轧便相疑。\n思量世上交游事，大似诗名更可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范漕赴召 其三","author":"洪咨夔","text":"急符唤出雅州丁，刀染红巾血雨腥。\n定蜀论功谁第一，茗山合着后溪铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范漕赴召 其八","author":"洪咨夔","text":"红丝步障海棠开，底似西湖半树梅。\n要试平生调鼎手，安排青子待公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范漕赴召 其二","author":"洪咨夔","text":"淮头蜀口几虺隤，百战山川入眼来。\n行伍姓名浑历历，定知水镜不遗材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范漕赴召 其四","author":"洪咨夔","text":"走卒儿童口是碑，百年几见好监司。\n浣花镜月经行处，草木江山亦去思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范漕赴召 其六","author":"洪咨夔","text":"匹马西征岁月多，苍头引鹤共婆娑。\n传闻虚伫如清献，益漕归来径上坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范漕赴召 其七","author":"洪咨夔","text":"天道频年说好还，到今胡?没天山。\n延英为奏平戎策，只在人心国势间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送商总郎 其三","author":"洪咨夔","text":"百寻浮玉三更月，万里长江一色秋。\n照映此心须此水，不妨小泊读书舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送商总郎 其二","author":"洪咨夔","text":"霜迟断陇荞花白，水足平田稻子红。\n剩把丰年供祖帐，送将玉节过江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送商总郎 其一","author":"洪咨夔","text":"鹤唳风声淝水捷，马腾士饱蔡州平。\n笑谈定取中兴策，莫道司存只饷兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首夏一绝示徐锦囊","author":"洪咨夔","text":"金丸未熟樱桃过，锦幄俱空芍药来。\n共坐晚凉观物化，床头有酒为君开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凉月 其二","author":"洪咨夔","text":"金粟安排雨后黄，定知花亦爱新凉。\n夜深月透玲珑影，花自光明月自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凉月 其一","author":"洪咨夔","text":"莲房折尽只留荷，露盖班班一丈过。\n高下横斜无定影，聚凉着得月明多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏至过东市 其一","author":"洪咨夔","text":"插遍秧畴雨恰晴，牧儿顶踵是升平。\n秃穿犊鼻迎风去，横坐牛腰趁草行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏至过东市 其二","author":"洪咨夔","text":"涨落平溪水见沙，绿阴两岸市人家。\n晚风来去吹香远，蔌蔌冬青几树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起独步","author":"洪咨夔","text":"病将春到眼慵开，只为梅花猛一来。\n何处琵琶推却手，举头啄木起林隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌次费伯矩赠行韵 其五","author":"洪咨夔","text":"快须涤砚入承明，烂熳飞章拂太清。\n富贵功名元素定，莫随人后颂升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌次费伯矩赠行韵 其四","author":"洪咨夔","text":"幕下精神清似水，门前责望重于山。\n君家文伟规摹在，事业全归静定间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌次费伯矩赠行韵 其三","author":"洪咨夔","text":"朝气风生暮气归，将材零落事功微。\n酸风斜谷祁山路，眼底何人插羽飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌次费伯矩赠行韵 其二","author":"洪咨夔","text":"掎角中原二百州，熟知彼己是良筹。\n时贤所及都能几，清渭黄河祗自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌次费伯矩赠行韵 其一","author":"洪咨夔","text":"浯水欲磨元结颂，聊城未下鲁连书。\n静中好与高抬眼，恐有英豪在草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"笋蕨","author":"洪咨夔","text":"小儿握固骨何弱，稚子着绷肌尚寒。\n岂不爱渠风味好，只应催我鬓毛残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绣观音酬郢州王知录丹青美人之赠两绝 其二","author":"洪咨夔","text":"十相端严具足身，一团杨柳净瓶春。\n石城莫与蛾眉看，羞不如人却妒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绣观音酬郢州王知录丹青美人之赠两绝 其一","author":"洪咨夔","text":"楚人不识女须面，只画昭君并莫愁。\n赢得江南穷相眼，自嗟空白一生头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其一","author":"洪咨夔","text":"泗水飞沉周宝鼎，霸城遏住汉铜人。\n人心不似无情物，多少英豪入魏秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其三","author":"洪咨夔","text":"黄门常侍祷明堂，窦武陈蕃横被殃。\n料得天公方睡着，不应受嘱变官方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史 其二","author":"洪咨夔","text":"晋将屈乘饵来虞，越送西施买断吴。\n马齿虽高人未老，五湖风月䄠陶朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读楞严","author":"洪咨夔","text":"人人有路證无还，一念才差隔万山。\n识得吾儒无妄卦，筏城长语尽须删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪郡侯出郊劝农 其二","author":"洪咨夔","text":"山青未了晓光开，鸠唤鸠应雨又催。\n消得犊车泥滑滑，此行不为杏花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪郡侯出郊劝农 其五","author":"洪咨夔","text":"炼丹人去屋萧萧，脚底群山走翠蛟。\n长啸一声空响答，砉然只鹤起松梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪郡侯出郊劝农 其一","author":"洪咨夔","text":"劝农冠盖出江干，马上东风觱栗寒。\n珍重春衫唾花碧，画眉狼籍道傍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪郡侯出郊劝农 其四","author":"洪咨夔","text":"争问官侬子谓谁，看来似不是农师。\n向人羞道闲陪涉，说与豳风七月诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪郡侯出郊劝农 其三","author":"洪咨夔","text":"茅屋人家蓐食烟，相呼趁雨好翻田。\n去年下麦泥如铁，一寸春膏直几钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪郡侯出郊劝农 其六","author":"洪咨夔","text":"半落梅花雪透明，不妨把酒当春行。\n光风有意相料理，杨柳青边约略晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题成都张宰压云楼 其一","author":"洪咨夔","text":"清霜戒晓日将出，急雨报晴云乍开。\n庭下簿书浑引却，独揩双眼上楼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题成都张宰压云楼 其二","author":"洪咨夔","text":"气如轲也生于义，道似参乎任以仁。\n乾盖坤舆犹塞破，何难压倒玉嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]