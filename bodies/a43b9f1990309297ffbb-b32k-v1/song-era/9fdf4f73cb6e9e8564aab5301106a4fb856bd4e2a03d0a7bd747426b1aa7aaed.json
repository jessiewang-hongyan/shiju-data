[{"title":"追和紫霞翁记梦二首 其一","author":"郭祥正","text":"乘云亲到紫皇家，不是人间旧物华。\n四座散香春结盖，一墀栽玉晓生花。\n入盘仙李皆含露，出鼎騠金尚带砂。\n偶对吟笺追昔事，犹疑鸾凤数行斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追和紫霞翁记梦二首 其二","author":"郭祥正","text":"笑上蓬莱第一山，葱苍半落有无间。\n金云璧月夜何永，玉殿珠楼人斗閒。\n五岳已能超险路，九天从此造玄关。\n回头为问桃源客，底事鸡鸣便欲还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆见寄二首 其一","author":"郭祥正","text":"不得陪公九日行，想提椽笔瞰西城。\n风流自可追王粲，憔悴犹能忆祢生。\n万里还家唯有梦，一身投狱岂忘情。\n何时共掷沧溟钓，醉倚三山欲鲙鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆见寄二首 其二","author":"郭祥正","text":"霜雪萧然满鬓须，平生忧患更无如。\n强倾浊酒消尘事，每见荒榛忆旧居。\n倦鸟久摧千里翼，故人频枉数行书。\n城头高阁何时到，多在三春细雨馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬蔡温老秀才见寄","author":"郭祥正","text":"一庵聊寄碧岩阴，忽得新诗慰我心。\n俊逸自追天马健，崩腾还与海涛深。\n门前俗子无行迹，物外松风有好音。\n病起可能携杖屦，共寻明月到溪浔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬崇福长老见寄","author":"郭祥正","text":"寄榻西湖不掩关，残年犹得伴僧閒。\n身投罗网归无路，目送烟云幸有山。\n新句忽传文字外，旧游重想笑谈间。\n故人风义如师少，慰我忧愁两鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵寄省上人","author":"郭祥正","text":"四壁萧然我亦空，更无归梦到江东。\n楼台不碍尘尘现，钟鼓相闻法法通。\n玉麈挥谈真契合，莲华分座夙缘同。\n回头重浊堪怜悯，妙性如何自瞽聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安止怀予北归怅然有作三首 其一","author":"郭祥正","text":"濛濛春气扑晴霄，游水登山望泬寥。\n旧学已荒三岁懒，故乡何处一身遥。\n沈沟断木思班匠，吹沫纤鳞待晚潮。\n君有高才当自奋，不应先我问耕樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安止怀予北归怅然有作三首 其二","author":"郭祥正","text":"雨馀风物一番新，得句惭非画手亲。\n柳眼含烟如恨客，花心凝露欲啼春。\n黄鹂出谷方求友，紫燕营巢不避人。\n独我未沾青帝力，僧窗聊寄幻泡身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安止怀予北归怅然有作三首 其三","author":"郭祥正","text":"一读诗翁寄我篇，却思乡国醉瑶泉。\n数声玉树秦淮月，万里春江采石船。\n轩冕浮沈真外物，冤亲平等委前缘。\n杜陵子美知何意，更欲吹嘘送上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑","author":"郭祥正","text":"不得公孙一舞看，空嗟尘渍血痕乾。\n铸成星斗生光焰，化作龙蛇会屈盘。\n金匣藏时天地静，玉池磨处雪霜寒。\n谁为将相扶明主，此物能令社稷安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠裴泰辰先生","author":"郭祥正","text":"匣剑光铓射斗牛，提携天下洗人仇。\n英雄心胆老犹在，道路风尘行未休。\n名重更须完小节，义高何足论閒愁。\n濛濛细雨陵阳市，折取红梅上酒楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵俞资深承事二首 其一","author":"郭祥正","text":"联车同入得仙山，下瞰重城指掌间。\n不愤青春添我老，且倾白酒伴君閒。\n三年共佐闽中郡，一檄谁招海上蛮。\n闻说天门新奏乐，帝枢佳气紫回环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵俞资深承事二首 其二","author":"郭祥正","text":"春归漳岸扑晴岚，紫燕黄鹂若纵谈。\n自愧不才甘薄禄，喜逢佳客解羸骖。\n仙山有路终难继，海品论珍昔未谙。\n地胜人醇真可乐，梦魂无复忆江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖","author":"郭祥正","text":"东湖北溆水相通，十里荷花半白红。\n冷艳已能消酷暑，暗香时复散清风。\n欲眠别浦无鱼艇，且倚疏栏学钓翁。\n云起仙庭飞晚雨，洒然身世出尘笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆山谢雨二首 其一","author":"郭祥正","text":"牲牷报祀入圆山，赫赫神功指顾间。\n水满大田甘雨足，龙归深涧宿云閒。\n乐声自和松声奏，玉色遥瞻酒色殷。\n安得梦魂陪逸驾，更传仙句落人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆山谢雨二首 其二","author":"郭祥正","text":"自挈壶浆款庙门，黄蕉丹荔荐清芬。\n沈烟未过盘中篆，电影已翻江上云。\n霈泽不惟滋稼穑，凉飙仍为扫岚氛。\n圆山信作漳南镇，想恋枇杷玉色醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和留秀才秋日田舍","author":"郭祥正","text":"物幻非真只自知，却寻田舍度衰迟。\n漫为陶令柴桑乐，不学荆轲易水悲。\n午睡最能消永日，一巢长欲寄深枝。\n闻君亦有逍遥趣，可濯沧浪共赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宣守林子中修撰列岫亭","author":"郭祥正","text":"苏州方称白公才，又见宣城谢守来。\n两处溪山重秀发，一亭风月助徘徊。\n水光飐滟龙鳞活，岫影参差雁序开。\n不用红裙唱金缕，只题佳句殷春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"列岫后题","author":"郭祥正","text":"谢公遗句惜湮沈，更作新亭一百寻。\n宿霭拥山眉敛翠，夕阳浮水带横金。\n黄鹂唤友鸣声软，白鸟窥鱼意思深。\n看尽物情俱是幻，要须携酒数登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠子中修撰","author":"郭祥正","text":"承明厌直下天来，聊继昭亭小谢才。\n珠迸玉盘诗得句，月腾金浪酒盈杯。\n江城未许民心借，京国颙瞻召节回。\n试问行年俱乙亥，固应怜我困蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子中修撰叠嶂楼致酒","author":"郭祥正","text":"重山复水碧相连，胜地欣逢太守贤。\n欲倒樽罍秋色里，故邀宾客画图边。\n丹青迥压王摩诘，骚雅仍兼白乐天。\n莫恋宣城风物美，玉堂提取笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子中修撰宠赠之什","author":"郭祥正","text":"声名入洛弟兄传，出拥旌旗老集仙。\n挹月珠玑光射海，凌秋雕鹗气横天。\n文章落笔元无敌，器宇藏春岂有边。\n一见音容聊莞尔，却携樽酒共颓然。\n金门曾奏相如赋，水阁重吟杜牧篇。\n强驾蹇驴追逸骥，已知霄壤不相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子中修撰塔院题竹","author":"郭祥正","text":"不是集仙来咏竹，更谁能继紫微吟。\n看随霜雪终吾老，寄语锄犁勿见侵。\n欲把一竿垂直钓，更须十亩广清阴。\n萧郎妙笔堪图写，添入蓬莱第几岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子中修撰示书有不得同游水晶宫之叹作唐格四韵寄别","author":"郭祥正","text":"西庵吟醉忆君同，忽得新诗思愈工。\n下笔捷才如阵马，接人和气似春风。\n敬亭姑孰犹为远，庾岭端山更几重。\n自叹鹪鹩无健翼，追飞不到水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄凤凰山张居士","author":"郭祥正","text":"闻君深隐凤凰山，池水相通竹石间。\n一念报亲长不断，六经传子胜空閒。\n青猿摘果啼兼啸，白鸟穿云去复还。\n自愧尘埃行老矣，何时载酒伴酡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永安戴公纯秀才","author":"郭祥正","text":"鬖鬖鬓发一衰翁，又泊仓头阻逆风。\n推去未应如谢令，重来终是愧司农。\n熙宁父老知谁在，元祐田园喜再丰。\n置酒高台要我醉，却寻陈迹喜君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈思道见送之什","author":"郭祥正","text":"谁听袁宏夜半吟，一时倾盖便知心。\n疲驽自信难追骥，秀木从来忌出林。\n巧匠旁观应缩手，明珠所得已盈衿。\n岭头孤唱思君和，着月梅花似缕金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至万安寄吉守李献父大夫","author":"郭祥正","text":"江水成文地最奇，风流太守更能诗。\n送将腊尽梅花怨，唤得春回燕子知。\n一饷功勋真梦寐，千年名字付伤悲。\n盛携樽酒频赓唱，幕下高才似牧之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至五羊先寄颖叔修撰","author":"郭祥正","text":"句水分携二十年，却临南海望青天。\n元戎为解陈公榻，下客惭非孺子贤。\n冷艳一枝梅照眼，清光五斗酒盈船。\n朝廷近日无新事，只恐西戎尚扰边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南雄望远亭本朝章郇公所作公尝为郡太守种荔子二株今方茂实而后人所种皆不成东美要予致酒亭上为赋四韵","author":"郭祥正","text":"城角危亭面面开，尘侵丞相旧诗牌。\n凌江欲转鲸鱼活，荔子成阴玉树埋。\n庾岭乍过无瘴雾，长安不见奈愁怀。\n且倾浊酒承高论，秋水何由辨渚涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌江立春日呈黎东美太守","author":"郭祥正","text":"斗杓东指斡春回，乐奏升平助殷雷。\n鱼跃原无溪面冻，雪光散作岭头梅。\n主人和气均千里，北客归怀寄一杯。\n色满皇州三殿喜，琼林先放桂花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖南华寺","author":"郭祥正","text":"水转山来曲曲梯，参差楼殿占清辉。\n龙章凤袭藏天篆，玉索金钩贲祖衣。\n春去不知庭柏老，月明谁棹钓船归。\n曹溪有路人人到，踏断玄关古亦稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖大涌泉","author":"郭祥正","text":"金镮一卓透曹溪，禅祖心传上上机。\n流出山腰苍兕吼，涌开池面碧绡飞。\n应同霖雨能苏旱，莫比沧浪只濯衣。\n不愿夕阳催我去，要随幽鸟带云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武溪亭劝顾归圣朝奉酒","author":"郭祥正","text":"邂逅穷荒遇俊才，故将怀抱向君开。\n功名未得金横带，老大空惊雪满腮。\n岭北嘉蔬无此笋，江南相识尚逢梅。\n夜阑莫作思乡梦，且听清歌更一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"补到难篇终别作八句寄吴圣与长官","author":"郭祥正","text":"结客元和六载春，探深碧落迹如新。\n寸量秋色三千丈，名写岚光十四人。\n文格迥欺韩愈老，字书尤逼小王真。\n近来好事谁能及，我续遗音君可嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广庆寺","author":"郭祥正","text":"寺当南北二禺间，合翠全清总见山。\n一石尚存垂钓处，五羊时载老仙还。\n金流月影真盘谷，黛涨岚光小剑关。\n安得鹊桥横绝顶，下临河汉泻潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵彭教授送别","author":"郭祥正","text":"平生爱着五云裘，不爱身为万户侯。\n白石清泉随步到，断霞残月满怀收。\n故园已恨荒三径，皓首何堪困一州。\n邂逅逢君沧海上，涸鳞终欲借洪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵湛判官送别","author":"郭祥正","text":"一朝倾盖若忘年，更把新诗物外传。\n侧望风流还入幕，应怜憔悴未成仙。\n离樽谩托春风里，短棹行依瘴海边。\n十斛明珠君不惜，珊珊投掷满巴笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵广幕黄承事见寄二首 其一","author":"郭祥正","text":"不记西亭醉别时，别来佳句愈瑰奇。\n心随云影沈天角，梦逐滩声到海湄。\n满目青山谁共乐，何年黄卷得同披。\n遥怜严武能为帅，幕下争传杜老诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵广幕黄承事见寄二首 其二","author":"郭祥正","text":"孤城寂寞瘴岚州，虎竹分符强少留。\n老钝不知今世巧，行藏犹愧古人修。\n暗天理钓船千丈，纱帽笼头茗一瓯。\n无奈北归忘未得，非君求友更谁求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石室后游","author":"郭祥正","text":"七星山色碧离离，山下空岩世所稀。\n不独雾深知豹隐，有时水长见龙归。\n方床瑩洁仙人座，文石纵横织女机。\n旋剔苍苔辨陈迹，李邕词翰亦依稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄惠守苏元之","author":"郭祥正","text":"挥金爱士气尤雄，暂拥旌旗碧海东。\n十八素娥倾皓月，三千佳客倚春风。\n高才可惜经纶晚，把酒何时笑语同。\n霜落草枯应射虎，短衣匹马欲随公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题李封州宅生堂","author":"郭祥正","text":"鳞鳞鸳瓦构新堂，意在黔乌惠泽长。\n岘首去思闻堕泪，召南遗爱有甘棠。\n水光送月浮珍席，山势和云插画梁。\n安得才如张相国，为君重赋宅生章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题贺州甑山亭","author":"郭祥正","text":"贺州城西丹甑山，一亭遥插紫云间。\n龙墀让策名犹在，鹤驭凌风去不还。\n善政再应来瑞物，胜游安得伴酡颜。\n元戎词翰镌金玉，千古长如碧涧潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宜掾徐子美见寄","author":"郭祥正","text":"去年与子别当涂，彼此形骸若梦馀。\n怅望欲穷千里目，相思不寄一行书。\n青山归去容身好，白眼从来处世疏。\n桂水东流须入海，新诗时复委双鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故人李端夫赴廉州从事石室致酒留别二首 其一","author":"郭祥正","text":"注地银潢两峡开，云林冰净不浮灰。\n新诗欲与何人论，旧友今从上国来。\n薄酒谩为仙室饮，归鞍无奈夕阳催。\n君怀自有骊珠富，合浦休将一颗回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故人李端夫赴廉州从事石室致酒留别二首 其二","author":"郭祥正","text":"才如吾子尚区区，羽檄从军万里馀。\n白发可怜归计晚，青衫只似拜恩初。\n一樽邀客非无酒，千卷随车幸有书。\n已把穷通推定分，故人达宦任情疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留汤主簿小饮","author":"郭祥正","text":"穷荒得见故人稀，话旧还惊岁月飞。\n君有儿孙能力学，我无金谷可言归。\n灵仙观里黄柑熟，采石江头白蟹肥。\n北望何时同此乐，暂留行棹莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘光道赴桂幕","author":"郭祥正","text":"气吐虹蜺发未皤，逢人辄莫叹蹉跎。\n边隅锋镝从今少，幕下篇章所得多。\n雨洗山光浮碧玉，春回江色熨青罗。\n元戎早晚归金阙，荐祢应先著述科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日登北楼示客","author":"郭祥正","text":"九日登高可强欢，听歌莫放玉杯乾。\n黄花烂漫宜新酒，白发稀疏落小冠。\n桂水波光趋海急，峡山岚翠带云寒。\n故乡万里知何处，更凭朱栏向北看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宜掾徐子美见寄","author":"郭祥正","text":"忽逢便翼寄新章，不惜明珠满斛量。\n姑孰万家花映竹，丹湖千顷月和霜。\n结庐已许陪吟社，衣锦应须返故乡。\n底事却言归未得，梦魂犹欲泛沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈文思见寄","author":"郭祥正","text":"星湾高会岂能忘，万丈离愁寸寸量。\n东阁赋梅摅锦绣，南山射虎凛冰霜。\n功名未得封千户，耕凿何由共一乡。\n春蕨秋鲈味偏美，时听社鼓醉淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题罗池庙","author":"郭祥正","text":"种柳江边不得归，殁将灵魄寓罗池。\n名参韩子犹为幸，党入王生最可悲。\n帘卷瘴云灯断续，门荒秋雨菊离披。\n旱穰请祷年年事，瓦鼓巫歌奠一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送颖叔待制拜六路都运之命","author":"郭祥正","text":"朝闻紫诏下龙楼，夕卷红旌别海陬。\n六路理财烦侍从，一门传节继风流。\n诗如老杜犹为达，策似刘蕡稍见收。\n廊庙乏材终大用，愿均和气及岩幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵林辨之长官送别之什","author":"郭祥正","text":"十年相识迹非疏，今日江亭叹别车。\n牢落名声谗谤后，支离形影瘴氛馀。\n重来仕路谁为援，却返家园欲自如。\n烟浪一舟无长物，罢官只似到官初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢洪府黄安中尚书惠双泉二首 其一","author":"郭祥正","text":"北风遮莫阻归舟，公有双泉慰客愁。\n玉斗贮来云尚冻，金蕉倾处蚁争浮。\n黄花遥想东篱畔，白浪正翻南浦头。\n醉魄忽成蝴蝶梦，却寻春色到皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢洪府黄安中尚书惠双泉二首 其二","author":"郭祥正","text":"北风变冷水归?，南浦扁舟未得行。\n孤雁叫云诗胆碎，怒涛舂岸客魂惊。\n谁陪高论应悬榻，想有雄词欲鲙鲸。\n病骨支离难强起，尚蒙樽酒慰馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黎东美江上偶作","author":"郭祥正","text":"帝庭江国屡相逢，不觉霜毛岁月空。\n君奏课书双阙下，我携纶钓五湖东。\n论归学海方无迹，吟到诗坛始有功。\n一任北风翻地起，且图樽酒暂时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吉州仙都观览前守李献父留题","author":"郭祥正","text":"乍出锋铓赣石来，仙都忽见五云开。\n霓幡闪闪排真驭，珠网重重覆绛台。\n照水碧莲犹未变，绕坛红杏亦新栽。\n刘郎去后谁行乐，壁上龙蛇半紫苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贵池寺照远轩","author":"郭祥正","text":"碧瓦周遭映佛幢，更穷眼界敞轩窗。\n山光半拥初生日，天影宽围不尽江。\n诗思未容秋色乱，酒醺能使客愁降。\n陶潜肯忆东篱菊，且倚栏干倒一缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追和梅侍读题贵池寺元韵","author":"郭祥正","text":"寺插孤峰压贵池，幽轩占胜敞双扉。\n阴生广野千山失，影落空江一雁归。\n安得有缘陪社客，更寻何处息尘机。\n南来北去无时尽，谁念沧浪可濯衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]