[{"title":"洒扫无碍室","author":"虞俦","text":"太息仙翁了俗缘，竹轩初日似当年。\n不禁路冻新霜滑，一诵遗诗一黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台 其一","author":"虞俦","text":"横足论交万乘轻，富春山水足平生。\n从教太史占星变，自是难忘故旧情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台 其二","author":"虞俦","text":"故人昔有刘文叔，此地今馀严子陵。\n行客漫怀千古意，相逢林下一何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台 其三","author":"虞俦","text":"四海斯文一范公，云山江水两争雄。\n旧碑可惜随烟烬，新刻摩挲恐未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过永城","author":"虞俦","text":"河南名县固多矣，有底永城天下闻。\n大抵地因人后重，固知千载有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟病起","author":"虞俦","text":"床头读易编常绝，纸背题诗字半斜。\n示病维摩元不病，不妨丈室散天花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十六日舟中送何同叔","author":"虞俦","text":"乍抛玉节去朝天，分袂江头却黯然。\n只恐垂虹亭上月，今宵不忍十分圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得集贤回字","author":"虞俦","text":"奔走年来已厌频，那堪万里抗边尘。\n集贤说道虚传耳，惭愧中朝第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广东漕王侨卿寄蔷薇露因用韵 其一","author":"虞俦","text":"薰炉斗帐自温温，露挹蔷薇岭外村。\n气韵更如沉水润，风流不带海岚昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广东漕王侨卿寄蔷薇露因用韵 其二","author":"虞俦","text":"美人晓镜玉妆台，仙掌承来傅粉腮。\n瑩彻琉璃瓶外影，闻香不待蜡封开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家叹 其一","author":"虞俦","text":"麦已化蛾犹未打，蚕虽作茧不堪缲。\n一年活计今如许，只望西成我廪高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家叹 其二","author":"虞俦","text":"山前雨脚如麻下，田里水头犹屋高。\n祇恐无秧可重插，农夫相视敢辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春暮","author":"虞俦","text":"红紫摧残春又归，独怜杨柳绿依依。\n无端乱絮因风起，漠漠晴天有雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二子往赴漕试意颇念之二首 其一","author":"虞俦","text":"应为槐黄蚤著鞭，拟随雕鹗上秋天。\n老怀已觉功名误，只欲儿曹慰眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二子往赴漕试意颇念之二首 其二","author":"虞俦","text":"三年大比抟鹏志，五日修途舐犊心。\n齐夺锦标非分外，龟泉从昔庆源深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"往鸡山视曹甥营母坟夜归","author":"虞俦","text":"轧轧篮舆出暝途，铸钱坞里验青乌。\n忽然月在千松顶，影落琼瑶满地铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲本寄示诗轴中有腊前观雪见怀之章具感真情也继韵以谢","author":"虞俦","text":"谁战玉龙看逐北，尚驱盐虎欲征西。\n有人独立城头望，一派寒光在乳溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭后过南坡观雪二绝 其一","author":"虞俦","text":"晨观已落园翁后，饭已来时计一疏。\n太息若曹谁领会，更教能赋总输渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭后过南坡观雪二绝 其二","author":"虞俦","text":"扶筇行雪又寻梅，花下冲寒要一杯。\n好事有谁能问字，可须能载曲生来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"微雪","author":"虞俦","text":"霏微小雨洒通宵，惨淡寒云覆丽谯。\n盈尺未成平地积，六花应在半空销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月三日到镇江欲过金山始登舟暴风雷雨忽大作泊抵寺岸则少霁矣回舟晚晴却遇便风","author":"虞俦","text":"忽然天外片云飞，风雨连江浪溅衣。\n一笑江神真戏剧，晚晴依旧送将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日雪复作 其一","author":"虞俦","text":"行令玄冥不敢温，一天雪重压江村。\n我惭白雪翻巴曲，天为黄茆洗瘴昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四日雪复作 其二","author":"虞俦","text":"宁是因风摇柳絮，又还扶雨著梅腮。\n先生拥褐方高卧，恶客敲门勿与开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日将行泥涂风雪因作二诗一以自嘲一以自解 其一","author":"虞俦","text":"薄宦才堪鸡肋比，泥涂风雪不偿劳。\n折腰始悟青衫左，到底山林一著高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日将行泥涂风雪因作二诗一以自嘲一以自解 其二","author":"虞俦","text":"天公怜我太徒劳，为散冰花洗郁陶。\n翻觉篮舆清兴动，风流不减剡溪高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十日南坡再赏菊","author":"虞俦","text":"扶杖坡头日几回，半醒半醉为花来。\n只愁秋老风吹尽，更向风前把一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"移官舍菊种归园中","author":"虞俦","text":"殷勤分去几枝菊，官满聊为三径资。\n不是园葵何用拔，且无薏苡莫相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡丹桂五株齐开","author":"虞俦","text":"秋风丹桂共徘徊，应是姮娥著意来。\n端为五人俱赴试，五株更遣一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡丹桂六株一时放花真佳兆也中秋节当率诸生同赏","author":"虞俦","text":"六株丹桂一时华，此去蟾宫路不赊。\n莫惜中秋同一赏，明年好事总吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊少花","author":"虞俦","text":"菊不能言意自嗟，渊明底事不还家。\n东篱不负他时约，看取樽前剩著花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和吴升之岩桂","author":"虞俦","text":"一笑姮娥不问金，诗人未见已披襟。\n秋来想动蟾宫兴，敢向风前彻夜吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜梦有人惠丝鞋一双次日报除左史","author":"虞俦","text":"官职元来莫浪求，丝絇梦里有谁投。\n帝庭入侍应须此，果应恩除在仲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦中作齑鲙","author":"虞俦","text":"香齑捣就有馀辛，细缕初飞白玉鳞。\n莫遣佳人频下箸，翠娥深处要人颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏古 其一","author":"虞俦","text":"柳子脂韦不佩弦，痴心附丽老羁缠。\n廉商浪说能为市，吏贾由来却悟鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏古 其二","author":"虞俦","text":"杜曲诗翁霜鬓须，谁怜三十载骑驴。\n五陵车马输年少，枉读平生万卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏古 其三","author":"虞俦","text":"韩子其人崛强欤，群儿头角久相疏。\n也知自是屠龙手，温水难教恋小鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏古 其四","author":"虞俦","text":"斗酒金銮笔下春，脱靴力士几曾嗔。\n后生不谓寻常事，惊怪先生胆是身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前和拒霜诗似亦少贬再以一绝慰之","author":"虞俦","text":"岩桂搀先还寂寞，菊花殿后尚斓斑。\n却应独占西风好，乞与佳名秋牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜总管相送至扫溪三十里夜雪中留别 其一","author":"虞俦","text":"相得诗人我与公，浙江从此隔西东。\n年来已是难为别，更在山中风雪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜总管相送至扫溪三十里夜雪中留别 其二","author":"虞俦","text":"杯酒淋漓意气倾，离筵唱彻短歌行。\n翻然解缆人归后，独自篷窗听雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜总管相送至扫溪三十里夜雪中留别 其三","author":"虞俦","text":"一麾又指浙西州，千骑东方且上头。\n已约好山供望眼，更烦飞雪送行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"文籍遭水","author":"虞俦","text":"巍冠广厦诵虞唐，冷笑诸儒屋壁藏。\n卷轴随车虽土苴，末流清润尚堤防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"槿花 其一","author":"虞俦","text":"西殿凉风合断魂，玉奴终不负东昏。\n纵然荣落才朝暮，也是曾承雨露恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"槿花 其二","author":"虞俦","text":"翠袖红裳细锦袍，纷纷儿女斗妖娆。\n千枝万朵遮人眼，谁觉荣枯在一朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"槿花 其三","author":"虞俦","text":"光阴占取入秋来，料想西风费剪裁。\n朝暮相催君莫问，一边零落一边开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"槿花 其四","author":"虞俦","text":"草中漫说千年润，花里休誇百日红。\n毕竟有生俱有尽，大椿朝菌得无同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭有沙二绝 其一","author":"虞俦","text":"东西断渡欲浮槎，朝来绝市无鱼虾。\n我仓湿谷舂不得，客米炊来饭有沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭有沙二绝 其二","author":"虞俦","text":"厨人淘米不淘沙，岂为先生惜齿牙。\n烘谷旋舂供晚爨，瓶储未可笑陶家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中重午绝句","author":"虞俦","text":"筠筒角黍楚人悲，节物惊心此一时。\n不作板舆迎侍计，被谗真欲吊湘累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久不到南坡","author":"虞俦","text":"何许瀛洲更望登，田园日涉与吾曾。\n怪来松菊荒三径，底事归兮却未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂诗 其一 夹径植梅","author":"虞俦","text":"三径应缘二仲开，定交笑指岁寒梅。\n却嫌桃李无区别，下有成蹊俗客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂诗 其二 涧下移松","author":"虞俦","text":"涧下初惊郁郁时，十年春雨旧相知。\n君看稚齿昂藏处，已有苍髯老大姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂诗 其三 补篱护笋","author":"虞俦","text":"先生垄上带经锄，一雨朝来土脉苏。\n盈尺槿篱须补缀，邻翁殊未识龙雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂诗 其四 凿池种莲","author":"虞俦","text":"太华峰头开玉井，若耶溪上识红妆。\n要遣秋风开菡萏，急须春雨涨池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂诗 其五 亭前栽柳","author":"虞俦","text":"靖节门前尽日垂，清风千载意谁知。\n折腰五斗非吾事，惭愧轻儇一小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂兴 其一","author":"虞俦","text":"咫尺南坡早得春，杖藜朝夕往来频。\n迨今著意栽桃李，准拟他年作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂兴 其二","author":"虞俦","text":"东风已放二分春，小小犁锄手自亲。\n多少软红尘里客，岂知林下有閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道院周围果实皆先居士手植因长老今摘送不胜追感再成山偈","author":"虞俦","text":"仙翁久矣骑鲸去，华表终朝化鹤来。\n更待蟠桃千岁熟，慈颜应认手亲培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林正甫碾茶 其一","author":"虞俦","text":"森严风味变腴甘，未必能袪睡思酣。\n姑为先生宽水厄，却容归梦到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林正甫碾茶 其二","author":"虞俦","text":"肝胆由来自一家，人间何许是真茶。\n不妨更著姜盐伴，可但丘中咏有麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以莲心茶送江倅报以剥虾佳句","author":"虞俦","text":"十指纤纤笋透芽，满盘红玉剥须虾。\n慇勤念我须分饷，更问邻家酒得赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"佳句妙酝鼎至再和以谢 其一","author":"虞俦","text":"不为河鲀赋荻芽，一壶且复荐枯虾。\n灯花也似知人喜，来报归期的不赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"佳句妙酝鼎至再和以谢 其二","author":"虞俦","text":"荷叶浮钱蒲茁芽，镜潭宁是照鱼虾。\n只今风月平分了，便趁鹏程万里赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别后寄林子长","author":"虞俦","text":"幸然头角未相疏，交道从来笑耳馀。\n短棹忽来还又去，得非蝴碟梦周欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安奉观音","author":"虞俦","text":"优钵昙花果有花，不缘诗酒到君家。\n闻思大士应嫌汝，枉费精神咏绮霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和耘老弟喜衢得第三男","author":"虞俦","text":"天教英物照阶除，又胜徐卿第二雏。\n会见五男并二女，宛如合璧与连珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"览镜有白发 其一","author":"虞俦","text":"拂拭青铜照病颜，勋名正堕渺茫间。\n缘愁白发三千丈，蚤已朝来见一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"览镜有白发 其二","author":"虞俦","text":"割鸡何惜用牛刀，老大无心赋畔牢。\n多少少年腾上速，几人曾得见霜毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长惠黄芥 其一","author":"虞俦","text":"小摘情亲自履畦，负霜含露末秋时。\n绿葵白薤何须说，潘岳当时恐未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长惠黄芥 其二","author":"虞俦","text":"自锄稀甲细分畦，忆在西山独往时。\n便把须弥藏芥子，个中境界有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒先祖墓","author":"虞俦","text":"欲知吾祖庆源深，山下龟泉色更澄。\n况有西枢铭志在，吾诗正好刻碑阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"耕绿台","author":"虞俦","text":"花村犬吠可能无，但使三农力有馀。\n千亩秋成云漠漠，一犁春事雨疏疏。\n登台想见同民乐，上考何妨亦自书。\n祇恐双凫便飞起，爱身宁许伴春锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羡监簿先出院","author":"虞俦","text":"青荧灯火小窗前，自笑醯鸡舞瓮天。\n涉笔谩随斯立尾，著鞭蚤觉祖生先。\n一觞独进何由醉，四鼓相将底未眠。\n珍重梅枝为老伴，摩挲病眼向渠怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王诚之元夕即席之作","author":"虞俦","text":"葭琯飞灰趁早朝，便看梅柳占春娇。\n金花綵胜方连昼，璧月华灯又彻宵。\n罗绮丛中森画戟，旌旗影里间星轺。\n满城游妓归时节，犹认云间紫玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"虞汉","text":"明年桃李月，春入马蹄轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"黄仲本","text":"丁宁莫被催科扰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"黄仲本","text":"好把丹衷为上倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺雨","author":"傅大询","text":"狮子关前半篆烟，二龙飞下卓篙泉。\n银河掣电连宵雨，绿野翻云四月天。\n便觉春生花一县，会看秋熟米三钱。\n何时卓鲁登黄阁，都与寰区作有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]