[{"title":"冬晴与子坦子聿游湖上六首 其四","author":"陆游","text":"海山山下百馀家，垣屋参差一带斜。\n我欲往寻疑路断，试沿流水觅桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬晴与子坦子聿游湖上六首 其五","author":"陆游","text":"老僧八十无童子，礼佛看经总不能。\n双手丫叉出迎客，自称六十六年僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬晴与子坦子聿游湖上六首 其二","author":"陆游","text":"村南村北纺车鸣，打豆家家趁快晴。\n过尽水边牛迹路，岭头猿鸟伴闲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬晴与子坦子聿游湖上六首 其一","author":"陆游","text":"湖边细霭弄霏微，柳下人家昼掩扉。\n乘暖冬耕无远近，小舟日晚载犁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬晴与子坦子聿游湖上六首 其六","author":"陆游","text":"一榼无时可醉吟，一藤随处得幽寻。\n先须挽取银河水，净洗人间尘雾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬晴与子坦子聿游湖上六首 其三","author":"陆游","text":"道边白水如牛湩，知是山泉一脉来。\n会挈风炉并石鼎，桃枝竹里试茶杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出山","author":"陆游","text":"出山似与高人别，回首时时一怅然。\n它日再来缘要熟，遍题名姓绿岩边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出门与邻人笑谈久之戏作四首 其二","author":"陆游","text":"暮霭昏昏半掩扉，偶逢邻叟荷锄归。\n且令闲说乡村事，莫问渠言是与非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出门与邻人笑谈久之戏作四首 其三","author":"陆游","text":"菽水欣欣每尽欢，仁贤不必袭衣冠。\n出门邂逅移时语，未害龟堂取友端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出门与邻人笑谈久之戏作四首 其四","author":"陆游","text":"屋角时闻黄犊鸣，相逢但可说春耕。\n一言误及城中事，议罚应须便酌觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出门与邻人笑谈久之戏作四首 其一","author":"陆游","text":"少时已叹少欢娱，衰病经旬一笑无。\n今日出门逢父老，欣然随众强卢胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出涌金门","author":"陆游","text":"出涌金门一黯然，初来犹是绍兴前。\n都人百万今谁在，惟有西湖似昔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游二首 其二","author":"陆游","text":"朝行蹑屩穿幽谷，暮返褰裳涉乱流。\n提起短筇成一笑，每烦上座为分忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游二首 其一","author":"陆游","text":"采药今朝偶出游，溪边小立唤渔舟。\n未须著句悲摇落，嫩日和风不似秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游不果","author":"陆游","text":"天柱峰前水乱流，石棋渡口叶飞秋。\n青鞋已是前身事，纵有篮舆亦懒游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其一","author":"陆游","text":"江天缺月西南落，村路寒鸡一再鸣。\n自笑此身羁旅惯，野桥孤店每关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其四","author":"陆游","text":"壮岁经春在醉乡，老来数酌不禁当。\n正须独倚蒲团坐，领略明窗半篆香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其六","author":"陆游","text":"久读仙经学养形，未容便应少微星。\n一枝新锻金雅觜，更向名山斸茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其五","author":"陆游","text":"儿扶行饭出柴扉，伛偻方嗟气力微。\n道侧偶逢耘麦叟，倚锄闲话两忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其八","author":"陆游","text":"晚交数子多才杰，谁肯频来寂寞乡。\n但寄好诗三四幅，绝胜共笑亿千场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其三","author":"陆游","text":"眼明未了观山债，力在犹能涉水行。\n莫笑轩然誇老健，身存终胜得浮名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其七","author":"陆游","text":"荠花如雪满中庭，乍出芭蕉一寸青。\n老子掩关常谢客，短蓑锄菜伴园丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游归卧得杂诗八首 其二","author":"陆游","text":"江村何处小茅茨，红杏青蒲雨过时。\n半幅生绡大年画，一联新句少游诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游至僧舍及逆旅戏赠绝句二首 其一","author":"陆游","text":"山僧邂逅即情亲，野叟留连语更真。\n淡淡论交端有味，一弹指顷百年身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游至僧舍及逆旅戏赠绝句二首 其二","author":"陆游","text":"饭炊适熟如延客，犬喜来迎似到家。\n雨滴茅檐草烟湿，不妨笑语暂喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游遇雨而返二首 其二","author":"陆游","text":"荒山前头野水边，东行西行不自怜。\n天公岂亦哀老子，风雨留教终日眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出游遇雨而返二首 其一","author":"陆游","text":"柴门方出雨霏霏，未到湖边促驾归。\n深炷炉香掩屏卧，谁知不为湿春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其十","author":"陆游","text":"暮年身似一虚舟，付与沧波自在流。\n垂地雪云吹不散，且倾桑落脍槎头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其一","author":"陆游","text":"西村林外起炊烟，南浦桥边系钓船。\n乐岁家家俱自得，桃源未必是神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其八","author":"陆游","text":"岁残已似早春天，隔水横林一抹烟。\n闻道埭西梅半吐，携儿闲上钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其三","author":"陆游","text":"小桥密接西冈路，支径深通北崦村。\n老子意行无远近，月中时打野人门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其五","author":"陆游","text":"锄麦家家趁晚晴，筑陂处处待春耕。\n小槽酒熟豚蹄美，剩与儿童乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其七","author":"陆游","text":"短筇行乐出柴荆，雪意阑珊却变晴。\n林际已看春雉起，屋头还听岁猪鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其二","author":"陆游","text":"舍北桥东幽事多，老夫饭饱得婆娑。\n茅檐日落闻舂相，荻浦烟深有棹歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其九","author":"陆游","text":"白发萧萧病满身，冻云野渡正愁人。\n扬鞭大散关头日，曾看中原万里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园杂咏十首 其六","author":"陆游","text":"闲伴邻翁去荷锄，林疏历历见村墟。\n怪生白鹭飞无数，水落滩生易取鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北坡梅开已久一株独不著花立春日忽放一枝戏作","author":"陆游","text":"日日来寻坡上梅，枯槎忽见一枝开。\n广寒宫里长生药，医得冰魂雪魄回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4644,"sha256":"803c6a90ea341892bf1b9f1a8127705