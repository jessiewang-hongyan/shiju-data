[{"title":"虞察院生日 其九","author":"姜特立","text":"天诏飞传速置邮，双溪门外促行舟。\n橙黄橘绿风光好，并看西湖十里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其七","author":"姜特立","text":"锄颣除荒政若神，俗安民靖绝纷纭。\n清宵不见犬吠盗，绿野更无羊败群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其六","author":"姜特立","text":"使君决遣烈秋霜，不许乌衣立坐傍。\n一吏持毫供点染，向来雁鹜不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其八","author":"姜特立","text":"下车好语敬书绅，诚意区区只为民。\n今岁年丰米狼戾，更须通变惠斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其五","author":"姜特立","text":"今年旱火欲烧空，尽是忱诚默祷功。\n尊酒豚蹄亦何用，使君心自与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其十","author":"姜特立","text":"文章近古追前辈，政事方今绝后尘。\n聊佩左符犹未称，好归黄阁试经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其二","author":"姜特立","text":"自辍清班素望崇，凛然争仰柏台风。\n大奸钜猾宜深屏，且避当年御史骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其三","author":"姜特立","text":"向来施设局苕川，荒政方劳问计然。\n今日雄藩得长袖，请君著眼看回旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其一","author":"姜特立","text":"新开弦管召天和，喜气悠扬际海涯。\n向晓金焦称寿处，欢声更满使君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞察院生日 其四","author":"姜特立","text":"雨旸时若赖君侯，万室欢呼庆有秋。\n不论高原并下隰，民间稌黍一时收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩兴","author":"姜特立","text":"乌藤黄葛一山癯，万事从人笑阔迂。\n作计尚馀诗气习，遣閒须著睡工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跳珠轩","author":"姜特立","text":"激溜跳珠尽日间，却疑造物不曾閒。\n何如收取连云笕，水自水流山自山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉泰二年得京祠","author":"姜特立","text":"八十衰翁灰冷时，君恩忽许奉京祠。\n夜行不已非吾事，归日磻溪理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉泰壬戌归省坟墓感仲叔旧所惠诗及延庆堂梦二首 其二","author":"姜特立","text":"延庆堂中梦，人言积善家。\n翠娥环绕句，今日定如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉泰壬戌归省坟墓感仲叔旧所惠诗及延庆堂梦二首 其一","author":"姜特立","text":"吾叔非凡士，从来眼目长。\n相期在今日，此意最难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝉","author":"姜特立","text":"自下高升木杪间，风为呼吸露为餐。\n虽云强聒人憎恶，也胜低头推粪丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题共閒亭五首 其五","author":"姜特立","text":"竞前正作蚁旋磨，逐物方知鹊失真。\n安得此身随杖屦，却来堂上作閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题共閒亭五首 其四","author":"姜特立","text":"花光摇曳犹多事，鸟语軥辀徒自喧。\n谁是如今爱閒者，请来此地说风幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题共閒亭五首 其三","author":"姜特立","text":"杨叶屡穿非是妙，庖刀未缺更须藏。\n何人识得閒三昧，袖手急流滋味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题共閒亭五首 其二","author":"姜特立","text":"太行日暮车盘处，滟滪波翻舟下时。\n惟有亭中无一事，坐看忙杀利名儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题共閒亭五首 其一","author":"姜特立","text":"几年玉殿领仙班，霜满乌靴尘满冠。\n寄语山花与溪鸟，今回莫作故吾看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题许尚书石刻二首 其二","author":"姜特立","text":"先生自是吾所敬，况复曾蒙点化馀。\n笔妙共推三昧手，尚书安得不中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题许尚书石刻二首 其一","author":"姜特立","text":"乌丝玉轴陀尼表，斗草搴花锦不如。\n不是向来元祐脚，唐人文字晋人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈朝干山亭二首 其二 绿野","author":"姜特立","text":"丰草茂林皆绿野，不论韦弁与貂蝉。\n但能真得个中趣，何必功名如昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈朝干山亭二首 其一 翠微","author":"姜特立","text":"高蹈烟霞远世尘，翠微深处一纶巾。\n若非严濑垂竿客，即是桃源避世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠方叔","author":"姜特立","text":"世间旷士如君少，天下閒人似我稀。\n一旷一閒无一事，只应鸥鸟共忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠汤仲辉郊居","author":"姜特立","text":"木桥横野水，竹径踏晴沙。\n桑苧交阴处，中藏隐士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜后菊","author":"姜特立","text":"嫩黄酽白媚秋晖，正坐清霜一夜飞。\n似怯晓来天气冷，一时都换紫罗衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曩备员宫属令旨画箑觅诗字以金书","author":"姜特立","text":"时颁便面觅新诗，巧画花枝作好题。\n多谢东皇不嫌弃，亲将仙手写金泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一年佳节惟立春元夕并在一日亦盛事也灯火笙簧处处有之斗城且尔况京都乎追想旧游成一诗聊摅郁郁 其二","author":"姜特立","text":"公堂宴处万灯明，灶鼓鼕鼕脆管清。\n莫厌青裙分作队，那无艳粉笑倾城。\n甘心挝鼓投荒裔，敢望传柑近上京。\n咫尺宾朋若胡越，语音嘈杂隐雷声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一年佳节惟立春元夕并在一日亦盛事也灯火笙簧处处有之斗城且尔况京都乎追想旧游成一诗聊摅郁郁 其一","author":"姜特立","text":"揭地东风作晓晴，峭寒别是一般清。\n五更綵燕归铃阁，一夜金莲撒斗城。\n岁稔歌谣欣越俗，酒阑魂梦绕神京。\n几多携手天街月，行听帘帏笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一年佳节惟立春元夕并在一日亦盛事也灯火笙簧处处有之斗城且尔况京都乎追想旧游成一诗聊摅郁郁 其三","author":"姜特立","text":"试听楼头报几更，暗尘渐歇夜方清。\n但知贪赏千家月，不问滞留三里城。\n延得簪缨还洞府，移将星斗下瑶京。\n道心与俗元无碍，感耳何嫌下俚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯中秋月色彻晓喜而有赋呈诸亲旧","author":"姜特立","text":"客来暮霭尚周遮，客坐乾坤见物华。\n万里更无云吐叶，一天唯有桂开花。\n肃霜青女令先布，专夜嫦娥意太誇。\n便欲从兹凌汗漫，不知何处上仙槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯元宵多雨 其一","author":"姜特立","text":"腊前雨势已翻盆，腊后淋漓到上元。\n灯火不张蟾彩暗，笙箫有禁霤声喧。\n麦田闻道水盈尺，里巷想应泥没门。\n闷坐孤吟无好况，三杯冷落对黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯元宵多雨 其二","author":"姜特立","text":"连年旱气民愁食，及至春来又雨霖。\n湿麦卧泥难辨草，寒蔬入市贵如金。\n灯辉不到愁人眼，节物空惊老者心。\n且喜今朝日光出，更须风力扫重阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日寄杨方叔","author":"姜特立","text":"安稳杨夫子，秋来阙寄音。\n遥怜好兄弟，相伴老山林。\n菊是故园色，人无旧赏心。\n云萍两漂泊，西望一长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月赴郡燕旄节适至","author":"姜特立","text":"贤侯佳节初开燕，谁是风流晋孟嘉。\n已判百年唯白发，不羞九日对黄花。\n拥旄遥佩藩臣印，把盏重来刺史家。\n希事此邦应未有，一时千里借光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八咏楼","author":"姜特立","text":"隐侯故事许谁传，领略江山付谪仙。\n虹抱子城增面势，翚飞杰栋跨风烟。\n旧题压倒三千首，壮观追还七百年。\n我老登临无好语，倚栏终日愧前贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又赋如山","author":"姜特立","text":"如山堂上好登临，罗列堂前紫翠岑。\n万古烟霞供坐啸，四时风月伴閒吟。\n海鸥心性沧洲远，野鹿精神草树深。\n却笑井蛙并辙鲋，只知缺甃与蹄涔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"之官婺州","author":"姜特立","text":"一夕霜风扫翠微，宦情何似客情悲。\n留连祖帐临分日，徙倚家园欲去时。\n三载奉祠心似水，一番挈累鬓成丝。\n高飞深泳惭鱼鸟，临水看云有所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亡妇小祥将至","author":"姜特立","text":"老来遽有闺中戚，岁月飞腾奈尔何。\n八十耄龄能有几，九三大耋可无歌。\n祥琴合御吾非激，期乐如听玷可磨。\n春到有花须痛饮，莫伤岁暮更蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大雷雨","author":"姜特立","text":"驱逐风雷撼海潮，迢迢已觉度山椒。\n金蛇照夜三千尺，银竹倾云百万条。\n起舞不辞巾角垫，捲廊从听药囊漂。\n吾家虽乏千仓积，一饭何妨共祝尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子美","author":"姜特立","text":"仓卒朝行在，间关到蜀都。\n维舟锦江上，卜宅少城隅。\n药市桥春过，江村酒夜沽。\n风骚天不靳，故遣走荆吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小孙纳妇","author":"姜特立","text":"庆事集朋亲，孙枝喜气新。\n歌云停碧落，舞雪眩青春。\n暖日花君子，清樽酒圣人。\n一春行乐地，不负牡丹辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山堂巩先生挽诗三首 其三","author":"姜特立","text":"绾章南北异，转首死生分。\n手泽空遗墨，书签冷旧芸。\n行须潘岳诔，碑已蔡邕文。\n身后无儋石，玄成似子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山堂巩先生挽诗三首 其二","author":"姜特立","text":"风采儒林虎，波澜学海鲸。\n公家五进士，此地半诸生。\n勾漏丹俄就，中牟政亦成。\n如何贾太傅，位不至公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山堂巩先生挽诗三首 其一","author":"姜特立","text":"源流简公出，名字鲁山宗。\n避地江之左，惊人易以东。\n机云千载里，歆向一门中。\n敬止山堂老，才名是至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"门前柳","author":"姜特立","text":"一桁门前柳，亭亭翠插空。\n悲秋宋玉宅，学舞楚王宫。\n夜映楼台月，朝牵菱荇风。\n多情二三月，乱絮扑房栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋寓直东宫是夕当月蚀云兴不见","author":"姜特立","text":"中秋令节每多阴，况复清居鹤禁深。\n幸免虾蟆矜毒吻，不妨蟋蟀伴孤吟。\n连旬病腹难容酒，独夜清眠不愧衾。\n二八孤光应未阙，小楼犹得共登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为通州守赋绿漪亭二首 其二","author":"姜特立","text":"景物天开四面宽，如披百幅画图看。\n有时鸥鹭下苍霭，无数菰蒲生碧澜。\n独立晚凉秋思动，醉呼小艇水云寒。\n他年虎节重来访，唯有恩波不解乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五日不出户","author":"姜特立","text":"五日不出户，门前枫叶丹。\n清芬馀橘柚，老色半林峦。\n社燕知时去，昏鸦取势盘。\n秋深多物色，应接未能安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木犀","author":"姜特立","text":"木芙蓉蕊未经霜，篱畔黄花尚敛房。\n正冷落中才吐艳，不思量处猛闻香。\n酿成云壑澄清气，涤尽炎乡热恼肠。\n便欲架巢枝上宿，学他徐老爱花狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王大卿挽诗","author":"姜特立","text":"少年登雁塔，晚岁列鹓行。\n贾傅心忧汉，宣公疏奏唐。\n细毡亲沃日，白简旧凝霜。\n才大施犹狭，清名玉雪扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王元聘惠石菖蒲","author":"姜特立","text":"静坐对珍丛，人疑道气充。\n轩裳路益远，岩壑意潜通。\n石自锼镌巧，苗因灌溉功。\n暮年无嗜好，所向略相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王君玉挽章其子迁其母同穴 其一","author":"姜特立","text":"昔与先夫子，亲如老弟兄。\n君能敬父执，我亦感交情。\n放意杯中物，无心世上名。\n佳城今夜月，应伴酒旗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王君玉挽章其子迁其母同穴 其二","author":"姜特立","text":"伉俪存亡隔，孤坟一驿西。\n忽惊双剑合，无复只鸾栖。\n路接先茔近，云藏塔岫低。\n归乎了无憾，送骑满山蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈公实上通守王刚父四首 其四","author":"姜特立","text":"洗甲通盟后，同庚缓带秋。\n边声寒卧鼓，海色静明楼。\n冉冉岁云莫，栖栖诗者流。\n不才同社栎，一饱愧身谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈公实上通守王刚父四首 其二","author":"姜特立","text":"戍解淮山月，波平瀚海秋。\n主忧销北顾，宾宴接南楼。\n自愧成村叟，无因接胜流。\n铃斋听客雁，应念稻粱谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出使过嘉禾城外","author":"姜特立","text":"江南清绝处，此地数经过。\n疏柳依秋浦，归船乱晚波。\n王侯几蚁穴，天地一渔蓑。\n安得玄真子，同编唱和歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶仲脩令其子携所作求诗","author":"姜特立","text":"雅道去已久，挽回良独难。\n须求正知见，莫学小波澜。\n父子专诗律，风骚逼将坛。\n如今寄佳句，那复阿蒙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶叔佐妻挽诗","author":"姜特立","text":"元是毗耶女，来嫔居士家。\n一门函佛界，三子摘天葩。\n积累千金富，追迎百两车。\n合书贤妇传，遗像俨笄珈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失骏子","author":"姜特立","text":"舐犊情何限，亡羊意易迷。\n聊为暮景玩，遽与小年齐。\n涨乳空宵哺，深闺失晓啼。\n已知真幻泡，感至一悲悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归山间舟中寄黄正言","author":"姜特立","text":"黑风吹雨乱云奔，一舸浮家过别村。\n便有新凉生竹树，更添清兴集槃樽。\n打篷点点催诗思，著面萧萧冷醉魂。\n来日小溪山水活，一波尽是使君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归故园述怀呈唐伯宪 其一","author":"姜特立","text":"度柳依桥瞰渌波，缓寻花径上松坡。\n莫嫌去国谋身拙，却是归田得计多。\n举世眩名甘汩没，几人闻健得婆娑。\n便须和取归来曲，收拾馀年老薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊申除夕","author":"姜特立","text":"禁宿遇除夕，孤怀还自怜。\n浮生俱畏老，造物暗凋年。\n性斧何劳伐，心灰自不然。\n好将閒日月，送老白鸥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春作时七十八","author":"姜特立","text":"老觉冬衣重，慵便春服轻。\n衰翁脚力弱，拄杖乃能行。\n八秩今时少，何人福寿并。\n仰惟文与吕，盛德两耆英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仰和令制腊中三白","author":"姜特立","text":"六花纷委地，随物赋圆方。\n未戒土牛候，先呈玉马祥。\n月孤难耀彩，句妙与争光。\n不独誇三白，深宜熟五粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和","author":"姜特立","text":"合居琐闼荫庭槐，底事康衢走俗埃。\n莫买渔舟便归去，好提鸿笔记方来。\n湖山剩有诗神助，事业宁须官鬼催。\n知道经纶未施用，出屯行矣扫云雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再悼邦节弟","author":"姜特立","text":"满腹书何用，谋身事竟非。\n中堂亲尚在，私室子畴依。\n人去惊沤没，秋来愁雁飞。\n它时风雨夕，相忆泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘元亨挽章","author":"姜特立","text":"举世无非逐臭夫，卜邻幸喜得文儒。\n堵居原宪贫而乐，瓢饮颜回退若愚。\n粗有田园供菽水，更无酒肉混庖厨。\n古来隐士无过此，叹息吾今德已孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]