[{"title":"用文之岁暮言怀韵","author":"张扩","text":"岁事潜占雪，风光暗著梅。\n有书招隐去，无地避愁来。\n厮役联裘马，英豪困草莱。\n谁能知许事，得酒鼾如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"文之暇日作诗戏用其韵","author":"张扩","text":"古事费寻检，近诗关谤伤。\n掉头无好语，结舌自良方。\n风露挟秋意，帘帏生晚凉。\n传闻市南米，渐可补饥疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"射亭诗","author":"张扩","text":"采鹄面危亭，鍧然中的声。\n将军三箭勇，男子四方名。\n刁斗中原静，车书远塞平。\n雕弓今罢赐，何日报功成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋向伯恭侍郎芗林","author":"张扩","text":"矫矫子平裔，声名晚益高。\n归休卜仙隐，题品妙宸豪。\n小径荒松菊，空庭长艾蒿。\n闭门便午枕，馀事九牛毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"焦复州适道于艰危中与其兄遇于三衢自云尝有异梦神明之感叙其事属予赋诗","author":"张扩","text":"南渡不忍说，流离簪与裾。\n苍黄一臂失，辛苦万金书。\n孝友剧调护，神明关起居。\n不须春草句，好梦自蘧蘧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题荷亭诗","author":"张扩","text":"风漾绿漪连，新荷照水圆。\n清香来洞府，真色现神仙。\n鹭影明如雪，龟巢小似钱。\n夜凉乘月看，人在玉壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞华堂秋晚","author":"张扩","text":"山石乱崔嵬，虚堂面石开。\n幽香催槛菊，疏影转庭槐。\n羽扇惊秋老，衣砧破梦回。\n坐看云四合，奔电数声雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿温州江心寺诗","author":"张扩","text":"出城何所诣，孤屿海云中。\n寺影一拳石，潮声四面风。\n断烟迷过鸟，密叶坠丹枫。\n咄咄劳生梦，真成一洗空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵临江军向侍郎见寄","author":"张扩","text":"江头一区宅，宴坐老扬雄。\n久阔书不到，相忘心自通。\n谁令知勇退，我愧未参同。\n定自有见处，不关幡与风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵徐端明师川清明见访小集","author":"张扩","text":"撩人春色浩无边，多病清羸挽不前。\n书舍忽陪金殿客，花时犹记汉宫烟。\n翰林剧饮赋千首，焦遂高谈惊四筵。\n更著新声定场屋，元轻白俗浪争先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子公舍人侄纸阁用荆公韵二首 其一","author":"张扩","text":"清修是药别无方，纸閤新糊暂著床。\n定自中扃元洁白，直教平地亦清凉。\n布裘衲被总相称，暮雪晓风浑不妨。\n似要经营淡生活，忽惊锋颖露锥囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子公舍人侄纸阁用荆公韵二首 其二","author":"张扩","text":"老楮声名浃四方，帡幪隐陋到藜床。\n境空生白道所集，气煖如熏德未凉。\n眼底咄嗟贫亦办，世间淫巧行终妨。\n只愁费尽螭头藁，却向危时但括囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和戏子公 其一","author":"张扩","text":"棋局画行新触手，帐文龟壳净围床。\n閤材近取复何好，法意防贪未可凉。\n自此铅华须痛遣，疑于缟素或相妨。\n夜阑天女来求法，君看如何是革囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和戏子公 其二","author":"张扩","text":"背人阿堵未中方，纸閤文书不碍床。\n正似复裈羞北阮，绝胜斗酒换西凉。\n来诗肯办十分赏，去辙犹关一水妨。\n对面更看枯淡在，应无儿辈紫罗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子公复和亦次韵 其一","author":"张扩","text":"我惭问舍未知方，君亦依然卧上床。\n有纸遮风良不恶，无人炙手自生凉。\n应怜佛屋钟鱼近，不自官居屏障妨。\n相去九龄今几代，风流未减笏为囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子公复和亦次韵 其二","author":"张扩","text":"昨日规摹屋一方，今晨诗卷已填床。\n安知事似猬毛起，自觉心如水月凉。\n故纸有缘殊未了，红尘无路略相妨。\n客来煖热浪自喜，断却来章真智囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻伯寓被召","author":"张扩","text":"朝廷下诏费搜寻，梦想人豪置赤心。\n谠论故应遗藁在，片言可却四裔侵。\n不应岩野调羹手，犹作田庐抱膝吟。\n自古忠臣由孝子，海隅倾耳听车音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李去病驾部成都府路转运判官","author":"张扩","text":"昔年雁塔看先登，我亦行间托姓名。\n半世纷纭惊似梦，一官潦倒信平生。\n含香暂借郎闱宠，仗节俄分昼锦荣。\n见说馈粮如火急，扬鞭马上试经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送杨元老屯田潼川等路转运判官","author":"张扩","text":"酱瓿遗文过五经，有孙千载振彫零。\n宁闻淡墨魁春榜，会看中台应列星。\n日下忽颁天语好，眼中先著蜀山青。\n归涂更挟两诗客，舐笔磨铅那得停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景蕃暂如无锡不暇相寻于云间诗来问讯甚殷勤会予续至江上遂及邂逅走笔奉呈","author":"张扩","text":"故人行李剧匆匆，犹向重湖遣信通。\n七字论怀如对面，片帆先我渡垂虹。\n家田收秫连云外，野蟹供螯入手中。\n犹及访君江上去，夜窗灯火耿秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别后一日予独游惠山寺酌泉烹茶而去时景蕃补葺旧隐将自德兴奉亲而归以诗追寄之","author":"张扩","text":"瓶罂络绎送醍醐，总是僧家饮啜馀。\n向上谁高康谷品，流传恐误古人书。\n暂来刮眼惊尤物，深羡诛茅葺旧居。\n却恐文饶渐多事，他年乘传定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄顾景蕃","author":"张扩","text":"别时犹记鼻辛酸，升合妨人未得还。\n衲被生春经岁换，羽书奔电痛时艰。\n闻君尚富珠千斛，许我时窥豹一斑。\n莫厌侨居坐穷僻，绝胜戎马闹乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顾景蕃以诗乞西汉书于子公子公以奏议唐鉴遗之戏次其韵","author":"张扩","text":"腹中图史自纷纶，况有新文似过秦。\n犹访汲书真好事，谬怜野鹜定痴人。\n补亡疑是君过计，就读未妨吾卜邻。\n他日两家俱外府，断编遗简得终身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵顾子美陪方仲兄游允仲花园后篇简允仲 其一","author":"张扩","text":"君看树头桃李开，化工浑在百花栽。\n日迟未觉堂堂去，路稳何妨得得来。\n定是拨忙聊慰眼，仍须痛饮莫论杯。\n明朝风雨便狼藉，孤负客愁肠九回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵顾子美陪方仲兄游允仲花园后篇简允仲 其二","author":"张扩","text":"怪底主人襟抱开，小园千本定深栽。\n不须羯鼓催花发，却要提壶唤酒来。\n可但拨忙聊慰眼，会应痛饮莫论杯。\n诗人有戒君知否，渐老逢春能几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过淀山湖","author":"张扩","text":"昨日过湖风打头，苇蒲深处泊官舟。\n近人乌鸟语声碎，濒海风烟日夜浮。\n午饭腥咸半鲑菜，客床颠倒一皮裘。\n平生浪说在家好，晚向波涛未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵汝阴姜丞见示","author":"张扩","text":"场屋声名二十年，老犹学易诵韦编。\n作官聊复下簿尉，得酒或时中圣贤。\n每愧青衫同拜起，间从广坐得周旋。\n来诗强欲相推挽，短绠无堪浪汲泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别汪彦章符宝","author":"张扩","text":"蚤岁相亲翰墨场，不堪迟暮屡参商。\n无钱可办一日醉，有目漫同千里光。\n闻道新诗多格律，宁从尊酒细斟量。\n江南旧隐邻鸡犬，何日青灯更对床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听宣麻","author":"张扩","text":"十年中国暗征尘，终挽天河净楚氛。\n谩说星辰犹孛彗，不妨豪杰会风云。\n江头露布传俘馘，殿下丝纶看策勋。\n从此削平真细事，只忧无地录将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得海陵掾吕居仁书","author":"张扩","text":"故人温饱竟何如，忽寄邮筒满纸书。\n颇愧中年犹吏隐，相望千里未情疏。\n官曹清简庭无讼，淮海丰穰食有鱼。\n见说参禅新了了，几时为我痛爬梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻余元隆被命白衣校正逸书","author":"张扩","text":"余郎风姿旧臞儒，酒钱不足诗有馀。\n江湖垂老漫居士，馆殿忽诏行秘书。\n从来摸索识沈谢，安用科举轻严徐。\n须君更平脱靴气，步稳即到承明庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招王大初教授饭","author":"张扩","text":"闻名早愧昧平生，迟暮相看眼更明。\n满室氛埃不关意，百年文字要寻盟。\n关河晚阙平安报，风露日催摇落声。\n樽酒从予会倾倒，莫同儿辈但平平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春舟中怀顾景蕃诸友会心堂折花几至纷纭因以问之","author":"张扩","text":"流光急急卷春归，宽我都无十日期。\n短楫轻舟馀客梦，斜风横雨半花时。\n坐怀同社二三子，剩有一番酬唱诗。\n谁向海棠花下去，不妨重看挽残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹南官舍怀诸兄弟","author":"张扩","text":"舍南舍北百花春，不奈扬雄四壁贫。\n与世周旋宁作我，罢官休去亦由人。\n有家那办录伧鬼，无用犹堪托社神。\n准拟他年风雨夜，论诗酌酒话酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵晁待制喜富季申迁校书","author":"张扩","text":"郑公勋阀似汾阳，人物君看同舍郎。\n坐废衣冠谁论荐，中兴文字亦生光。\n未妨俗子轻薰沐，元得诗翁妙主张。\n闻说平戎遗策在，何时目击阵堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华亭秋日","author":"张扩","text":"阴云薄薄漏秋辉，晓露含光湿翠微。\n旁舍击牛尝社酒，荒城捣练给征衣。\n净如扫迹蚊无几，多不论钱蟹正肥。\n定是水乡差可乐，不应潦倒未成归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江舟中","author":"张扩","text":"数峰雨后蔚蓝青，一水秋来镜面平。\n大舶鱼盐通远近，居人菱芡足经营。\n云头阙月为谁好，蘋末凉风时自生。\n老矣宦游无少味，欲寻张翰问莼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书雁荡山灵岩寺壁","author":"张扩","text":"画里儿时见一斑，朅来老病倦跻攀。\n诸峰拔地上云雨，万壑出泉鸣佩环。\n图牒未闻从古有，鬼神定自破天悭。\n道人笑我杀风景，不办淹留半日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵徐师川谢送温柑","author":"张扩","text":"剥啄谁人昼款扉，开缄词翰见精微。\n不应更觅二王帖，但要亲传六祖衣。\n陋我分柑悭百颗，烦君托意赠当归。\n吏曹政急簿书缚，忽奉新诗得解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吕居仁主簿过韩存中侍郎所居","author":"张扩","text":"文章典雅似班固，人物风流如谢安。\n老去谩馀公论在，退休浑觉壮心阑。\n松窗有月和书照，云屋无毡禦客寒。\n冷淡且寻诗作活，要看雷电敕仙官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李元叔正字书怀崇字韵奉还所借诗卷","author":"张扩","text":"杜陵句法今谁到，君自门墙数仞崇。\n未许前人得高处，间于五字见新功。\n淹留书馆残灯火，孤负淮山旧桂丛。\n眼看封侯谈笑觅，绝胜潦倒坐诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归来轩二首 其一","author":"张扩","text":"当年鞍马践文场，客舍齑盐话故乡。\n不谓休休归亦早，未应栩栩梦犹狂。\n辋川花木岁时好，莲社交游气味长。\n便合从君就閒去，藜羹麦饭自充肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归来轩二首 其二","author":"张扩","text":"不爱虚名式擅场，却收馀燄入寒乡。\n于鱼得计绝人事，翻手为云小子狂。\n阅世已除三宿恋，论诗兼倍百家长。\n西风举扇谁多事，君自无尘点肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵括苍太守黄侍御种竹 其一","author":"张扩","text":"先生铁面石为肝，不著繁华眼底看。\n近学仙翁誇种玉，未多楚客解纫兰。\n穿窗月影蛟蛇乱，掠枕秋声风雨寒。\n谁信孤根会埋没，赋诗新有老方干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵括苍太守黄侍御种竹 其二","author":"张扩","text":"世上风花暂斗妍，转头谁作一钱看。\n此君抱节真如玉，有客同心臭似兰。\n密叶自怜秋日薄，孙枝已挟晓霜寒。\n蔓柔草恶宜诛屏，恐向班行犯比干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送喻迪孺郎中知遂宁府","author":"张广","text":"平时场屋漫声名，晚下瞿唐信此生。\n万里不应频去国，一麾聊复为专城。\n送春杯酒侵行色，上峡家山慰客情。\n坐遣官曹顿牢落，说诗谁复似康衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌时寺丞侄避暑","author":"张扩","text":"眼看平地欲流金，暂借僧园数亩阴。\n束带市朝谁刺促，闭门松桧自幽深。\n客来棋局时招隐，饭罢茶瓯快洗心。\n便静乞閒吾有味，墙东诗老许同襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴已未七月六日被旨祷雨风水洞七日清晨诣祠下是晚大雨通夕留宿慈严寺中八日始还城","author":"张扩","text":"晚谒丛祠意已通，妙香来自禁城中。\n老龙聊办一泓费，阖境自歌终岁功。\n暑溽不应留枕簟，秋声忽已到梧桐。\n明朝上马五十里，更乞灵君吹面风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程伯寓司业见寄道旧","author":"张扩","text":"鸡黍新盟竟未寻，杯盘旧话更关心。\n时危閒喜尺书到，老去惟忧多病侵。\n闾巷小儿俱富贵，山林处士独呻吟。\n君今雅意在流水，谁是子期知此音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘲鹊","author":"张扩","text":"抵玉谁家解汝嗔，定应饶舌诳痴人。\n平生作室自拘忌，晚岁填河良苦辛。\n风急未妨翎翮健，日长无奈语音频。\n君看屋上乌元好，何用开门延窦申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼余彦敷府判","author":"张扩","text":"圭璧温然席上珍，广朝通籍照簪绅。\n论文巳许诗无敌，试吏还惊笔有神。\n少日功名聊措意，暮年州县漫劳人。\n武林旧话终成梦，旅榇空归泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼叔玠兄","author":"张扩","text":"独抱荆珍价莫酬，眼看闾巷觅封侯。\n时开黄卷都忘老，晚著青衫已倦游。\n不说向空书咄咄，但闻作记戒休休。\n故应手泽未埋没，合付六丁雷电收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼余元夫朝请","author":"张扩","text":"广席谈经旧长雄，豁然襟韵古人风。\n弓刀晚试百僚底，部曲默驯三尺中。\n幕府未闻收剧孟，佳城俄已怆滕公。\n不堪离乱死英杰，所在纷纭真发蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼子平侄","author":"张扩","text":"白帢宁从细柳君，欲提尺箠净烟尘。\n声名便自当敌国，露布复谁推傔人。\n夜半忧时长抱膝，生平急义几倾囷。\n追伤万事盖棺了，木笏青衫负此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵秦秘监山中观梅二首 其一","author":"张扩","text":"天上新骖宝辂回，看花仍趁雪英开。\n折归忍负金蕉叶，笑插谁临玉镜台。\n女堞未须翻角调，锦囊先喜助诗材。\n少蓬自是调羹手，叶底应寻旧雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵秦秘监山中观梅二首 其二","author":"张扩","text":"莫遣寒林一片飞，要看缟练粲仙衣。\n故烦诗伯来传令，为勒风师少霁威。\n水部五言谁举似，孤山一径久湮微。\n总输桃杏快涂抹，占定春光不放归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵春雪","author":"张扩","text":"春雪欺人转更豪，力如彊弩射吴潮。\n郢人有恨翻新曲，蜀客无襦忆旧谣。\n户外莫誇盈尺好，沙头已作浅痕消。\n诗成忍冻话年少，愁杀衰翁不自聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送贺子忱吏部福建漕","author":"张扩","text":"矫矫中年勇退身，寻盟省户定缘贫。\n风流未用老三径，谈笑犹堪漕七闽。\n丹荔压枝收白晒，乳芽登焙荐青春。\n不应例作粗官看，下语须防笔有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送许子礼吏部湖南漕","author":"张扩","text":"家传康济妙才猷，祗合怀铅近冕旒。\n漫有姓名连省户，不妨旌节案南州。\n兵储自古难为策，民瘼于今岂待求。\n小试书生肥国手，未多地上见钱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欲出京寄稚子","author":"张扩","text":"去时短袖怯风寒，春以为期秋未还。\n苦语经年浑不记，穷愁到处漫相关。\n路从驿底一双堠，家在江南第一山。\n人事不应频错迕，速寻樽酒为开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题虎丘宜上人枝巢轩诗","author":"张扩","text":"久闻戒净若冰渊，坏衲团蒲不记年。\n身外一枝聊尔耳，眼中三界自超然。\n可藏妙喜化城国，何异壶公谪处天。\n相见绕床狮子座，未妨居士病谈禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题黟县舒先生十柳轩诗二首 其一","author":"张扩","text":"当年宫殿记风流，濯濯青春破客愁。\n晚觉世间全少味，自从柳下觅归休。\n嵇康嗜锻太多事，陶令醉眠终自由。\n想见夕阳风软处，乱蝉无数咽新秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题黟县舒先生十柳轩诗二首 其二","author":"张扩","text":"十柳五柳复何为，今人古人心要知。\n百年实录先生传，五字格言彭泽诗。\n近闻收秫颇狼藉，谁与结社相娱嬉。\n我亦江湖漫浪者，尚堪束带向群儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]