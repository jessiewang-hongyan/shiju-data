[{"title":"三月五日病中对雨作","author":"强至","text":"何术可留枝上锦，谁人能换鬓边丝。\n不堪有限馀春日，更值无聊足病时。\n久判浮名唯念酒，肯因閒事辄忘诗。\n雨频未拂金明柳，空听蓬莱唱旧辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳饮许公亭通判钱郎中以诗献因依韵和呈","author":"强至","text":"丞相开筵御水头，席间别乘擅诗流。\n特誇元巳从公饮，不比常年结客游。\n淡色云阴笼日薄，暖香花气傍人浮。\n篇章唱绝虽容和，酒盏恩深岂敢酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上何太宰生辰诗二首 其二","author":"韩驹","text":"皇穹符宝运，嵩岳降真贤。\n明月中秋后，黄花九日前。\n潭潭新紫府，叠叠旧青毡。\n遐想云椿庆，春秋合几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上何太宰生辰诗二首 其一","author":"韩驹","text":"斗杓西揭柄，南吕已飞灰。\n芝室占熊梦，蓬山挺梓材。\n世欣金鷟见，人庆玉麟来。\n天意非难料，行看位上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上高明府孙世则寄书及诗依韵和酬","author":"强至","text":"客颜憔悴过三闾，犹喜良朋记拙疏。\n忽隔重江论旧契，更言终日困新书。\n宦情共减中年后，乐事难同二月初。\n好在江山一樽酒，他时怀抱为君舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与王仲密诸君泛湖","author":"强至","text":"十月清霜后，孤舟颢气间。\n酒边颓白日，棹底倒青山。\n境胜欢忧泯，吟频物象悭。\n吾侪一笑后，鱼鸟伴谁閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨见月","author":"强至","text":"千门却灯烛，久雨爱冰轮。\n愁眼开今夕，清光对故人。\n更长频侧帽，望极反沾巾。\n几为浮云掩，行藏类此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨初霁对酒偶作","author":"强至","text":"弥月穷山雨，昏昏气蔽天。\n南荣初见日，万瓦已生烟。\n节物惊残腊，欢期减去年。\n愁来搔短发，对酒且陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大风","author":"强至","text":"正月明朝尽，东风半夜狂。\n乾坤摇盖轴，草树拔毫芒。\n乱瓦飘无数，寒沙走更忙。\n圣时谗口绝，天令莫乖常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小阁西山落日","author":"强至","text":"天地垂垂暮，残阳似有情。\n未催全岭暗，犹放半山明。\n远树微茫见，孤烟惨澹生。\n流年从此老，对酒急须倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中雨后","author":"强至","text":"雨足前村云未回，逡巡屏面数峰开。\n相呼野鸟逢人住，自戏山蜂趁马来。\n野色通明林叶净，溪声奔迸岸沙颓。\n田翁见我应偷笑，底事行吟废酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中遇雨","author":"强至","text":"马上凉秋雨，随愁入乱山。\n垂垂衣袖重，点点鬓毛斑。\n猿鸟寒声外，渔樵古画间。\n片时全岭暗，急趁暮钟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上口占","author":"强至","text":"出郭尘埃少，驱车节物便。\n归心忘泽国，病眼豁霜天。\n鸟雀飞荒圃，牛羊卧晚田。\n吟边摇落意，疏木起孤烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上口占呈记注李才元学士","author":"强至","text":"一时闻望绝朝裾，几岁文章动直庐。\n凤尾新批天子诏，螭头看载史臣书。\n故关即路严霜后，晓殿初班瑞雪初。\n蜀道归时须六印，不应驷马擅相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上见华山","author":"强至","text":"身寄秦川紫翠间，举头行坐对南山。\n忽来烟际逢仙掌，更觉天边慰客颜。\n霖雨不知何日作，片云犹向此时闲。\n三峰信美那能恋，自有家林未得还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马公节挽辞","author":"强至","text":"惨淡南宫铩羽翰，空归座席甫能安。\n魂收长夜棺寻闭，泪洒残春袖未乾。\n老母始甘无禄釜，世人今转薄儒冠。\n土中犹动难平恨，月照孤魂桂影丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋对月有感","author":"强至","text":"西风入夜扫微云，皓魄来无一点尘。\n楼阁通宵双玉户，水天随处两冰轮。\n光摇樽酒清宜客，影落关河思煞人。\n我向乾坤违乐事，孤蟾照泪滴衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋京师对月","author":"强至","text":"今夜皇州月，秋光共几分。\n未全成皓魄，犹胜隔浮云。\n白发愁偏照，清樽喜独醺。\n遥怜江国弟，北望首殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书吴江垂虹亭诗","author":"强至","text":"千尺危桥跨浪雄，压桥虚阁势凌空。\n直疑有路通银汉，又讶横天卧玉虹。\n尽挹江山归醉目，独开怀抱向清风。\n却嗟景出天随后，不得当年一咏工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书香严屋壁呈寺主隆师","author":"强至","text":"庄严模净域，金碧照晴霓。\n土木有时竭，楼台无日低。\n林泉藏好处，巾屦得安栖。\n我愧陶彭泽，烦师数过溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予在病告君玉见过翌日成短篇奉招","author":"强至","text":"官居冷落人稀到，病枕攲移日几回。\n薄宦淹留无处说，平生怀抱为君开。\n盘中饤饾延粗饭，瓮面澄凝泛好醅。\n更有无穷欲言事，可能重跨蹇驴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予官将满婢子始植小柏于堂下因感而书","author":"强至","text":"孤根初掘出岩隈，赤脚殷勤手自栽。\n翠叶未成官秩满，清阴别待主人来。\n阶墀好养今朝操，梁栋须归异日材。\n犹胜夭桃情意薄，刘郎去后始花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予累日卧病适张文通惠教亦云服药漫成小诗呈之","author":"强至","text":"功名心寸折，岁月鬓双蓬。\n病畏酒杯绿，愁怜花蕊红。\n杖藜成暇日，行乐步春风。\n唯有张公子，翛然此意同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予解邑过杭遇介之学士谒告南归","author":"强至","text":"同时两郡冠乡书，屈指俄经一纪馀。\n顾我冗涂移蹇足，羡君荣路驾奔车。\n方从解绂辞岩邑，已见飞章厌石渠。\n自古盖棺人事定，未应今日较龙猪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五路岭","author":"强至","text":"一径高盘十里馀，人心马足厌崎岖。\n只凭顽石专为险，不识青云自有衢。\n地气难通树多瘦，阳晖应近草先枯。\n我行方欲奋遐蹠，顾尔安能碍坦途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁宗皇帝挽歌辞四首 其四","author":"强至","text":"圣运一千载，君临四十春。\n宝图先与子，妙断独如神。\n瑞表虚南极，哀声动北辰。\n天钟尧舜性，庙号讫称仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁宗皇帝挽歌辞四首 其三","author":"强至","text":"轻徭宽日力，横费惜秋毫。\n临谏天容睟，尊贤圣体劳。\n乾坤收化育，弓剑入悲号。\n十月西陵仗，愁云隔赭袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁宗皇帝挽歌辞四首 其二","author":"强至","text":"飞帚飘宸翰，赓歌纵睿才。\n歌欢三閤燕，声转两宫哀。\n人世金縢秘，天门玉锁开。\n年年初夏月，寂寞寿山杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁宗皇帝挽歌辞四首 其一","author":"强至","text":"未乾宫砚墨，犹暖御炉烟。\n鸡唱空催晓，龙飞忽上天。\n攀髯三月暮，洒泪五云边。\n盛德无容报，尘埃万寿篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以诗还府推杨学士无为编辱佳篇见答谨次元韵和酬","author":"强至","text":"贪讽高吟日几回，辞珍转觉意逾瑰。\n子云天禄惭馀地，工部花溪掩旧才。\n渴肺喜因秋水疗，病眸惊对夜光开。\n今朝那独誇荣贶，更贮私囊耀后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕观驾御端门诗","author":"强至","text":"仙韶楼底弄春和，帘额随风捲绣波。\n午夜九霄开宝扇，一声万寿彻明河。\n灯缠月影祥光动，酒入天颜喜气多。\n侍从有班无籍去，花边空听太平歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元卿舟次丹阳读予与诸君前年送别联句因作以道南还愆期之意远垂寄示辄依元韵和答","author":"强至","text":"归舟南过练塘时，重阅前年送别诗。\n人世阖棺方始定，客程流梗固难期。\n君还里闬寻三雅，我尚山城守一枝。\n涵碧春来应倍好，何缘吟对举清卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"升之元真观读书","author":"强至","text":"白日无停运，青云要早图。\n寓居邻上士，述作笑潜夫。\n案冗书签满，窗明树影孤。\n徘徊拂尘壁，一半旧题无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬子六月庚申夜陪魏公诣龙坛","author":"强至","text":"上公小队俯郊关，读祝焚香拜夜坛。\n旱魃此时尤肆虐，应龙何处辄图安。\n咒辞如律喷孤剑，刲血须明验一盘。\n盛夏连年陪席位，自惭不是牧民官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文懿大师院假山","author":"强至","text":"绕郭非无海上山，更收紫翠入禅关。\n竺峰飞过传闻后，蓬岛移来想像间。\n草树细含生意足，云烟轻带野情还。\n主人高卧嵩衡畔，应放幽寻杖履閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方殿省示惠远祖先生诗集","author":"强至","text":"先生名不死，三百几年间。\n白首吟唐世，清风起越山。\n遗编流自久，异代许谁删。\n远裔传能事，斯文气欲还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜与陈行父杨公济吴常甫出诣蔡子难","author":"强至","text":"月色无云喜共看，葛衣藜杖到君边。\n宦游易作浮云散，人事难同好月圆。\n菊露凄清吟可老，竹风幽洒坐疑仙。\n明年席上天南北，合破高斋此夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月卿大师以书抵予言到自永嘉今将还杭因索诗送行聊书短章塞来请之勤","author":"强至","text":"京洛多年作意游，撇然归思满林丘。\n尘衣才洗吴中水，吟锡还寻海畔州。\n独夜挥弦泣山鬼，几旬谈妙动藩侯。\n孤云高迹真无定，又理轻装买客舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王子直挽词二首 其二","author":"强至","text":"王氏仍淮水，贤人减颍川。\n风流今尽矣，天理旧茫然。\n亲涕沾封箧，交情动绝弦。\n公卿谁不到，偏夭贾生年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王子直挽词二首 其一","author":"强至","text":"流水身飘忽，青云意阔疏。\n儒林看作传，使者合求书。\n野月随丹旐，山烟湿素车。\n寝门今日泪，一洒为无馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王广渊郎中挽词","author":"强至","text":"一门新茹痛，八座近云亡。\n祸故近贤者，风流失望郎。\n葬帷笼淡月，挽铎诉清霜。\n祖烈系谁绍，三槐老北堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王广渊郎中挽诗","author":"强至","text":"暮归紫陌尚鸣珂，夜哭逡巡接浩歌。\n渐老为郎逾蕴藉，平生从仕亦蹉跎。\n笙沉缑岭空乘鹤，书绝山阴欲换鹅。\n日落九原车马散，悲风更向白杨多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓦亭偶书","author":"强至","text":"城中尘土眯人眼，堤上风烟醒客心。\n沙拥河声时断续，云含野色屡晴阴。\n平芜点白鹭双起，细柳弄青蝉一吟。\n魏北古来车马地，此亭偶尔得幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安九日","author":"强至","text":"雁落霜清对此辰，蚁浮酒浊唤何人。\n二年不见江南弟，九日空怜渭北身。\n白发转多羞插帽，黄花漫好拟沾巾。\n功名又逐秋风晚，惟有登高诗句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安上巳日对雨忆杭州","author":"强至","text":"三月吾乡三日盛，一春盛事一时传。\n山花迎笑探芳骑，水鸟惊飞张乐船。\n今对清樽看细雨，更搔短发数流年。\n曲江芜没不堪觑，那复丽人来水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安春日","author":"强至","text":"白入双吟鬓，衰侵一病身。\n年光不贷老，春色似欺人。\n鸟破日边雾，花飘风外尘。\n还将感时泪，对酒洒咸秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安春日感怀","author":"强至","text":"谁道关中节候迟，晴川二月并参差。\n有期去燕寻归栋，不改新花发旧枝。\n宦路飘飖无定所，客颜憔悴异当时。\n林花巢燕休相笑，揽照怀乡已自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长老凤师新作四照亭以其环顾洞彻无纤翳碍目故名云从予乞诗因即其说以寄题","author":"强至","text":"大士安禅外，孤亭旷望中。\n物无形可遁，心与境俱通。\n日月光应倍，江山气更雄。\n宁须面壁坐，到此即观空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午岁与府中诸君重游张氏园慨然成诗","author":"强至","text":"醉书曾记并游人，今日重游墨尚新。\n对酒年来惊白发，惜花时复数青春。\n四方散落几交臂，万事参差一病身。\n傍水园林自萧洒，不须出郭远风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东阳九日寄浦江同寮","author":"强至","text":"重阳独步上层岩，目断吾疆尚载瞻。\n人世只能愁杜牧，菊花岂解忆陶潜。\n吟无旧友辞多感，饮为佳辰量倍添。\n旅宦七回逢此节，旋销壮岁似磨镰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东阳吴氏昆仲并荐诣阙","author":"强至","text":"予昔尝推二子能，试篇每出辄嗟惊。\n文章即日开鹏运，兄弟同时醉鹿鸣。\n乐善自怜心不负，知人独喜眼偏明。\n来春早附登科录，甲乙应联旧姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代上余太宰生辰","author":"强至","text":"瑞挺真儒翊圣时，沩山秀气育丰规。\n庆符昌运千龄会，前应中秋十日期。\n天上光连奎昴宿，人间身占凤凰池。\n枌榆暂领旬宣寄，荣诞衣冠祝寿眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬末郡学感怀和韵","author":"强至","text":"我向荣涂倒足行，折腰尚可代深耕。\n嗟君二纪差高第，犹尔三冬伴后生。\n壮志几多成坠鹄，明年四十趁啼莺。\n金章衮衮从韦布，穷达何时不递更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬尽日睢阳感事","author":"强至","text":"天边愁绪细如毛，眼底诗情付浊醪。\n张许忠魂空日月，邹枚乐事委蓬蒿。\n积成乡思心频折，送尽年华首重搔。\n杜子南宾犹此日，主人恩意觉徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出大名府北郭","author":"强至","text":"驱车出近郭，野色感年华。\n河静水犹冻，地寒林未花。\n细风吹断柳，残雪隐虚沙。\n乡思东南阔，归飞羡暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北都春日","author":"强至","text":"日出车马道，风来城市尘。\n关河应自昔，花草不知春。\n云静鸟翻翼，冰消鱼动鳞。\n太平无一事，把酒劝耕民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北都春日漫书","author":"强至","text":"蓬鬓双侵京国尘，花枝五别故园春。\n晓莺莫漫惊游宦，夜鹤多应怨主人。\n日月名迟愁揽镜，江湖兴在忆垂纶。\n天边涕泪怀吾弟，却恨衣冠系此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古剑","author":"强至","text":"只因耕战地，得此古龙泉。\n磨拭自今日，埋藏曾几年。\n无将试蛟窟，宜待静狼烟。\n寄语奸邪辈，当锋莫向前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雨寄杨公济","author":"强至","text":"江海岁云晏，雨冥风自凄。\n叶光群木洗，翅湿几禽低。\n静榻攲寒枕，孤城隐暮鼙。\n少陵车马客，催踏草堂泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪六首 其六","author":"强至","text":"朔风吹不尽，颢气入无间。\n市井人喧息，江湖鸟翼顽。\n酒边惊晚岁，吟外失群山。\n温室便高卧，明朝任塞关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪六首 其五","author":"强至","text":"色浮千里白，气逼万家寒。\n独鸟饥犹啄，痴儿喜自团。\n向风初舞急，入夜转声乾。\n此味同谁冷，吟窗映素冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪六首 其四","author":"强至","text":"影乱侵书幌，花轻辍酒杯。\n襟怀同落寞，气象亦崔嵬。\n屡折参云竹，偏凌照水梅。\n红炉方尔附，未可论寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪六首 其三","author":"强至","text":"飘洒三冬暮，苍茫一气凝。\n寒威斗自壮，空色晓逾澄。\n狂走寻冈兔，饥呼失树鹰。\n年来交态浅，有兴即谁乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪六首 其二","author":"强至","text":"草树惊全失，山河望转非。\n片时藏地险，底处极天围。\n楼半轻相逐，檐前急自飞。\n乘风还有意，故去点人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪六首 其一","author":"强至","text":"几尺江东雪，同时户北风。\n全家愁坐外，寄命苦吟中。\n已分书帷冷，偏憎酒盏空。\n漫将丰岁兆，去问白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归鸟","author":"强至","text":"日落群山静，天寒独鸟归。\n声悲故巢远，影入片云微。\n踪迹怜吾滞，青冥羡汝飞。\n莫为双翼误，须避暗中机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]