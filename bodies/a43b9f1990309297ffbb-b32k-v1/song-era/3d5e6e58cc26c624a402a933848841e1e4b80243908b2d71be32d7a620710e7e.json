[{"title":"和柳子玉官舍十首 其九 蜜蜂","author":"黄庶","text":"秋成想见香租人，菊露枫胶蜜几脾。\n日日山僮扫红叶，蜂衙知是主人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和题竹轩","author":"黄庶","text":"小轩移得清风枝，知君公退来忘机。\n山禽自识主人惯，客到有时惊不飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看春榜偶成","author":"黄庶","text":"每看春榜独嗟咨，蹭蹬尘埃已十期。\n韩老有知应笑我，归时无计只痴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栽竹","author":"黄庶","text":"小槛栽培得此君，绿阴疏韵似相亲。\n从来风月为三友，吟社新添客一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"黄庶","text":"此心为地把书耕，若问生涯指六经。\n欲语世人真富贵，胸中珠玉又无形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄子蒙授常宁令","author":"黄庶","text":"疏率君堪爱，无心宦又高。\n身思眠白屋，人勉著青袍。\n号隐疑名福，贪归似姓陶。\n常宁邑虽小，应合得牛刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春","author":"黄庶","text":"雪里犹能醉落梅，好营杯具待春来。\n东风便试新刀尺，万叶千花一手裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望春偶书","author":"黄庶","text":"信马寻春上古原，天工一幅绣平川。\n花应笑我将诗句，便当游人费万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家长安前诗","author":"黄庶","text":"插屋数竿网，穿篱几尺船。\n水乡菱芡足，不著免租钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐真斋庭多怪石小诗求数株","author":"黄庶","text":"曾经禹贡清泉骨，今是莓苔几世孙。\n知君突兀满庭下，乞我雨中云数根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登郓州溪堂","author":"黄庶","text":"仁智模来物状亲，登临宜入古图身。\n惯看韩老诗中景，树色泉声似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋得退之画像","author":"黄庶","text":"功名已写后世耳，身入人间图画看。\n叹息浮图满天下，犹疑怒发尚冲冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题公美庭前芦","author":"黄庶","text":"长安只说谁花好，君把青芦砌下栽。\n鸣雁也知人好事，几时衔得入关来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东寺柱","author":"黄庶","text":"竹风松月牢于锁，关闭人心物外情。\n燕雀闻经俱已惯，归来不怕读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八日探菊","author":"黄庶","text":"行绕墙边菊，踌蹰赏物心。\n秋风应有意，明日是知音。\n酒惜浮花醉，诗留把叶吟。\n儿童欣佳节，撚蕊试黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"市得笛竹簟因成诗","author":"黄庶","text":"八尺枯冰簟一筒，小轩拂拭趣谁同。\n樽前声负千杯月，窗下光赢一枕风。\n易向曲肱增旧意，诗因仰看有新功。\n蠹书围绕高眠处，梦与尘埃路不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"黄庶","text":"此日春方到，春心亚舜尧。\n勾芒如稷契，大蔟似咸韶。\n衡柄三阳把，陶镕万物翘。\n家家助和气，剪綵作花飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子仪初夏偶作","author":"黄庶","text":"醉红方寂寞，吟绿又装成。\n急雨荷宜听，清风簟可迎。\n燕忙谙物态，花尽见时情。\n独有无言意，不知枯与荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和言怀","author":"黄庶","text":"五常为种耕情性，天意宁分有与无。\n史解戮人惟戮古，地能埋死只埋愚。\n青云易把诗书买，白发难停日月驱。\n顾我无才背时俗，浮名早晚见归途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和真长新春偶书","author":"黄庶","text":"东风寂寞掩柴关，时苦删文笔冻乾。\n只把诗情磨世态，更凭酒力禦春寒。\n尘埃不必频弹铗，岩石终期共挂冠。\n叹息焚和名利者，乾坤未似斗筲宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和雪霁游西湖","author":"黄庶","text":"雪会游人意，元朝变物华。\n醉乡银作界，诗客玉为家。\n鱼影纹冰縠，禽踪篆霰沙。\n馀英恐销尽，目断夕阳霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵居正暮春感事","author":"黄庶","text":"物报春光去已深，残红满地绿成阴。\n晚花便好吟诗惜，馀景应须载酒寻。\n欢意莫教时节挫，穷愁自倚岁寒禁。\n亭园况是登临胜，何必流年动素心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答王甫判官","author":"黄庶","text":"尘埃蹭蹬落粗官，赖有诗书可自安。\n人到圣贤由感激，国施钟鼎为艰难。\n须期燕骨千金价，莫动黄陂万顷澜。\n穷达功名无早晚，好山宜且醉吟看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观雪","author":"黄庶","text":"疑是天公戏，都倾海作盐。\n松筠知不变，丘壑见无厌。\n清为诗家极，寒因酒户添。\n冬温成俗疫，得此胜针砭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庐山道中遇黄介夫因寄四十字","author":"黄庶","text":"冷日苍山下，相逢笑又颦。\n文章已脍炙，名位尚埃尘。\n昔见缨尝请，今言雉欲驯。\n腥膻满南郡，忍醉解池春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和舞阳杨令九日羊川乡同小饮之作","author":"黄庶","text":"青帘白屋得新醅，坐待村童买果回。\n旋撚野花为泛菊，更寻山路作登台。\n世途已把灰心死，樽酒聊同笑口开。\n多谢晚禽知客意，歌吟来往劝馀杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子玉病起游书斋","author":"黄庶","text":"萧斋久不往，筋力试筇初。\n窗户蜗涎锁，尘埃鼠迹书。\n病魔虽已去，诗癖竟难除。\n苔地欣重扫，徘徊意有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和公美季点书事","author":"黄庶","text":"知君行县乐，经见饱朝昏。\n禾黍富年户，牛羊落日村。\n趁云看华没，冲雨渡泾浑。\n颇得诗家助，聊应慰旅魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陪丞相听蜀僧琴","author":"黄庶","text":"百年生计一张琴，敝轸枯弦抵万金。\n世上几人曾入耳，樽前此日是知音。\n清风明月虚无境，白雪阳春寂寞心。\n莫讶南薰沉听久，致君基业用功深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和题云台观","author":"黄庶","text":"太华疑挨毕昴回，欲观形胜上云台。\n雪中地把银屏立，雨后天将画轴开。\n景好更宜和月看，客忙常是爱山来。\n我知游者登临意，常恨西轩落日催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日闲居","author":"黄庶","text":"缰锁身闲似未名，方愚情性被春轻。\n酒教笔砚因花废，路为亭台与草争。\n野客笋邀煨短茁，邻僧茶约煮新萌。\n无时杖屦穿林去，真是寻芳户一丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送石都官赴阙","author":"黄庶","text":"为郎四十者，堂有二亲稀。\n止仰官为养，行应泪在衣。\n白云偏伫立，黄犬好频归。\n去有山公启，天心正似饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送真长书记知舞阳","author":"黄庶","text":"尘土淹沉客，诗书梦寐身。\n又辞千里幕，去布一同春。\n路想多归户，庭应绝涝民。\n青衫莫嗟叹，知已在陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭水丘随州","author":"黄庶","text":"卧理随民欲问安，讣邮俄至废朝餐。\n秦川旧会欢如在，汉水新书墨未乾。\n丹旐已归人寂寞，素车徒有泪汍澜。\n时情冷暖尤无味，一臂相知在肺肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席上送韦中舍归襄阳","author":"黄庶","text":"如君七十少，梨栗有坚牙。\n琴杖新行李，云泉旧世家。\n讲求栽树法，拂拭钓鱼车。\n独美今归去，青衫脱有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政吴侍郎挽歌词 其一","author":"黄庶","text":"千里资甘旨，凄凉一日遗。\n为臣如广受，生子似皋夔。\n笔砚诸孙哭，讴歌几郡思。\n秦人失太守，翻有怨天辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政吴侍郎挽歌词 其二","author":"黄庶","text":"荆棘二疏路，几人同敝衣。\n仕涂师白发，国老欲彤帏。\n遗稿诗书满，行旌雨雪飞。\n陕民应泪落，不见板舆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读赦书","author":"黄庶","text":"诏书一尺洗寰瀛，舒卷雷霆万物惊。\n天祇无私均雨露，地缘强半是榛荆。\n人间疾苦言堪疗，塞外豺狼腹未盈。\n不是朝廷用桑孔，丁宁浑只念苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都厅诵书偶成","author":"黄庶","text":"主人调鼎手，千里刃迎虚。\n暗使民如堵，能容吏似樗。\n莓苔眠杻械，燕雀听诗书。\n刀笔惭无补，身为白蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"教绳权学书偶成","author":"黄庶","text":"文字有缘曾弄墨，见来官小免咨嗟。\n喜将笔砚传生计，不失诗书作世家。\n字识姓名能指点，写因梨栗不倾斜。\n著鞭莫落时人后，三十尘埃监汝爷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登郑氏阁","author":"黄庶","text":"林泉无价自由身，缰锁登临趣未真。\n望处好山俱得力，夜应明月不孤人。\n任从心外烦于蚁，长对樽中别有春。\n当日若知风物胜，定移鸡犬过江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢赵太傅遗聚米图经珣所作","author":"黄庶","text":"文武生贤子，羌图帝所多。\n始欣知马援，终叹失廉颇。\n苍鼠巢遗稿，黄埃锁旧戈。\n远人犹偃蹇，掩帙泪滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋八月竹","author":"黄庶","text":"我养一轩竹，秋来成绿阴。\n万物有衰意，独怀霜雪心。\n西风嵇叔醉，明月白公吟。\n回首看桃李，何尝费百金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"署中新栽竹","author":"黄庶","text":"移作亭园主，栽培霜雪姿。\n不辞桃李笑，只待凤凰知。\n少已留风住，疏宜待月筛。\n相看时一醉，谁道小官卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀","author":"黄庶","text":"六载红莲客，差池又一年。\n无人和白雪，有意补青天。\n肝胆论兴废，诗书谒圣贤。\n尊中古日月，穷达付陶甄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠山寺僧","author":"黄庶","text":"慵饱浮图世共憎，蓬蒿师独养牛耕。\n田驱白石年常过，林印青薪岁旋生。\n竹似子孙怜笋茁，树添松柏补风声。\n眉头怪得春来喜，雨起蔬苗粒粒成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下棋","author":"黄庶","text":"古人欲写得丧形，万事画在方罫内。\n黑白胜负无已时，目送孤鸿出云外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大孤山","author":"黄庶","text":"彭蠡百里南国襟，万顷苍烟插孤岑。\n不知天星何时落，春秋不书不可寻。\n石怪木老鬼所附，兹乃与水同浮沉。\n鸣鸱大藤树下庙，祭血不乾年世深。\n轴舻千里不敢越，割牲酾酒来献斟。\n我行不忍随人后，许国肝胆神所歆。\n落帆夜宿白鸟岸，睥睨百绕寒藤阴。\n银山大浪独夫险，比干一片崔嵬心。\n宦游远去父母国，心病若有山水淫。\n江南画工今谁在，拂拭东绢倾千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居独酌","author":"黄庶","text":"山寒未放春消息，独把单醪慰寂寥。\n书对圣贤为客主，竹兼风雨似咸韶。\n醉乡城郭灯前到，愁贼戈矛盏底销。\n野菜溪鱼随分有，不堪回首叫箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元伯示清水泊之什因和酬","author":"黄庶","text":"十年不踏故溪上，有时梦去千里游。\n每思鱼行鉴中见，青衫手板如仇雠。\n秋风鲈肥美无价，莫怪张翰不可留。\n前日诵君清水吟，胸中突起百尺愁。\n儿牵女婴走尘土，百年一半如弃投。\n清风明月无界畔，白首愿作山中侯。\n君诗写出渔者意，老景一片在目眸。\n清泉钓舟未入手，聊可观诵忘吾忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆竹亭","author":"黄庶","text":"蓬莱楚山底，傍舍竹四围。\n狂鞭入门户，乱笋争墙篱。\n与竹事还往，相对一束书。\n壮长走世路，驽骀强鞭笞。\n尘埃客灞浐，远梦夜夜归。\n小亭久不理，漏栋生白芝。\n偶放簿书笔，杖屦改旧诗。\n呼童诛蒿莱，扫洒莓苔基。\n谁庭无花卉，憎有儿女姿。\n独移苍烟本，慰我千里思。\n坐生山林趣，亭园有光辉。\n免使清风来，留在桃李枝。\n月明绕竹步，撚挽颐颔髭。\n相向若知己，动摇影参差。\n人间欠药石，稚乳骄羌夷。\n青杉污污垢，寸尺莫可裨。\n忍作仓廪盗，宁老诗书饥。\n养笋为钓竿，早晚耕蒿藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安贺晏相公生辰","author":"黄庶","text":"衙鼓簪绅动，灵椿荐寿醪。\n吾君合尧舜，此日降伊皋。\n盘诰文章老，丹青事业牢。\n乃朝尊柱石，千里辍钧陶。\n民即讴歌借，霖应梦寐劳。\n秦人下车乐，远迩赋崧高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对花","author":"黄庶","text":"诗昔甫白在，造化困刀尺。\n我生几年后，浪自镌顽石。\n对花虽把笔，好句恨莫得。\n耒阳与采石，孤坟没荆棘。\n几欲肉白骨，再插风雅翼。\n海为一杯酒，地为一领席。\n醉坐吟万物，语出埋霹雳。\n乾坤髓可掬，鬼神泪可滴。\n人生贵适意，身是天地客。\n糟床不可乾，吟纸须强擘。\n花落若解医，有金费千镒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和子仪闻蝉","author":"黄庶","text":"落日挂树间，长我庭下阴。\n园林动秋意，高蝉忽微吟。\n清风转馀声，杳若下远岑。\n微物感时节，铿鍧吐商金。\n古乐久破碎，兹虫抱全音。\n荒忽尚偃蹇，激起壮士心。\n愿为秋蝉操，被之朱丝琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和中伏坐夜","author":"黄庶","text":"万兵昏雨过，暑斗插云倾。\n老佞溪蛙静，真交海月生。\n游氛褰幕帟，远籁起茎英。\n清洗尘埃虑，幽通造化情。\n酸咸时味薄，寂寞古途亨。\n去象筌真意，无形写天声。\n诗疑窥杜子，文欲造盘庚。\n身在清风国，神游白玉城。\n希夷乘浩气，沆瀣饮元精。\n坐久忘昏寐，回头有启明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和元伯南楼避暑遇雨之作","author":"黄庶","text":"城头归乌喘拓翼，夕阳栏干手可炙。\n长虹如篆报雨来，云脚插下千里赤。\n南山端正太古屏，飞廉扫云为拨墨。\n安得老笔描写住，白头许生死堪忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和刘卿材见寄之什","author":"黄庶","text":"风波一相失，倒指岁月耗。\n交情见千里，文字每教告。\n胸中饱耘锄，勉我穫以道。\n踟蹰竹帛间，相期古人到。\n十年走尘土，心不勇于躁。\n乃知镌磨益，不必砚席好。\n君屈百里官，卓趋而鲁蹈。\n不使鞭朴教，人情自倾倒。\n讼稀禾黍登，醺若饮醇醪。\n使者席未暖，姓名达圭瑁。\n麒麟踊跃起，志远无近报。\n粪土龊龊者，锱铢较称号。\n青冥脚可插，泥途迹将扫。\n宁知西山民，归车恐君膏。\n我行省版舆，假途期问劳。\n理声如壁邻，叹息不可造。\n遥知诗书宰，优游漆园傲。\n极目西飞云，徒使瞳子眊。\n敢期枉佳作，绸缪肺襟奥。\n大句驱老意，木古风雨暴。\n惊味无厌已，败者豆笾犒。\n我辄牵勉和，徒手大阿冒。\n酌酒持君诗，吟哦舌根燥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和松径","author":"黄庶","text":"行人旱亢日，共荫苍烟姿。\n岂识雪霜心，但轻蝼蚁皮。\n中为栋梁用，莫叹斧斤迟。\n樗柳尽牺象，后凋终不衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和真长幕中偶书","author":"黄庶","text":"人情岁时登，乡县自无讼。\n公庭破莓苔，日苦黥徒送。\n幕府隐诗书，黄堂卧梁栋。\n几字署纸尾，朝夕宁倥偬。\n尘土安止足，性情适吟讽。\n收心观无始，静卧悯群动。\n劳生懵出处，欲把清风鞚。\n青山自无价，夜夜有归梦。\n但知陶潜卑，宁识贾生恸。\n夜雨诵君诗，一杯齐费用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和象之夏夜作","author":"黄庶","text":"大暑暴虐如恶酒，意思颓困不可醒。\n日官我疑借炎热，昊轮出火星荧荧。\n霈然一雨翳晚景，庭树洗出蜩螗声。\n微云扫洒供夜坐，造化似解通人情。\n清风明月作三友，趣君可买轻连城。\n恍然身在冲泊域，目空万状遗骸形。\n此特象之入诗国，句句锻鍊炉锤精。\n穷微心到混沌侧，高处意气扪日星。\n诘朝携诗示我读，饥肠馋口逢珍烹。\n义幽语险索究解，如手捕虎不敢停。\n归来牵勉拾馀思，鱼目愧傍蟾蜍明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和酬真长对雪之作","author":"黄庶","text":"西湖主人久未至，雪云我为开吟天。\n偷闲把酒罗脍鲤，鱼冻难趁烦鸣舷。\n旋求野果向山市，僮仆觅路占平川。\n恍然白玉为饮国，寒威醉思相翩翾。\n顾盼万景来笔端，濡染欲写毫已坚。\n初疑万国会盟散，断圭破璧盈枯田。\n禽巢一一鹤上下，冰殿扫洒迎群仙。\n又疑水官爱雪柳，故把众庶为飞绵。\n我思江淮有流民，往往匍匐僵道边。\n朱门意气与寒竞，上马酒面红欲燃。\n天将景与富贵买，不知一费几万钱。\n诗家把笔争造化，对此自恨才悭偏。\n徘徊嗅嚼醉还醒，来往但见鞋履穿。\n归来庭树玉花落，稚子狂走皆华颠。\n拥炉搔首有馀意，喜与麰麦为丰年。\n夜阑更欲和月看，坐久讽诵琼瑶篇。\n调高白雪古难和，思短强被诗魔牵。\n卒章我欲涕泪下，连茹固已知君贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]