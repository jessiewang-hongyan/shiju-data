[{"title":"小院","author":"释绍嵩","text":"小院无人夜，楼高月迥明。\n偈吟诸祖意，茶试老僧铛。\n门掩园林僻，窗虚笔砚轻。\n慇勤供一笑，一笑可怜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小憩东岳行宫戏题","author":"释绍嵩","text":"树色遥藏店，春风入鼓鼙。\n行宫花漠漠，孤屿草萋萋。\n白鸟飞还立，黄莺歇又啼。\n诗成那用好，到处好诗题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十九","author":"释绍嵩","text":"雨后江山绿，蝉声若唤人。\n岩花随处发，官柳著行新。\n风月充三益，林泉是四邻。\n杖藜林下去，且作自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其三","author":"释绍嵩","text":"气味闲中好，居疑与世分。\n销愁何用酒，娱意莫如文。\n穴暝云初上，山高日易曛。\n近来心更静，清绝洗妖氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其五","author":"释绍嵩","text":"老去慵仍甚，幽欢良自如。\n性将时共背，身与世俱疏。\n水色含群动，秋容淡夕虚。\n惬心皆乐事，真作野人居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其九","author":"释绍嵩","text":"病目书淫歇，熏炉炷麝煤。\n山将落日去，风带旧寒来。\n微霰疏还密，虚堂闭复开。\n无人语心事，永日坐徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其二十","author":"释绍嵩","text":"衰落暗成病，如何不白头。\n百年长扰扰，万事祇悠悠。\n耕凿资馀力，行藏独倚楼。\n却因虚淡极，忽觉此生浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其一","author":"释绍嵩","text":"何处成吾道，深居绝送迎。\n竹扉常昼掩，野径得闲行。\n万壑树声满，千岩暑气清。\n相看两不厌，天际一山横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十八","author":"释绍嵩","text":"古屋茆茨小，寒林春自芳。\n坞深人不到，花落树犹香。\n事去青山在，闲知白日长。\n禅心真已静，笑失昔时狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其八","author":"释绍嵩","text":"径转危峰逼，遍令两眼明。\n凉风吹咏思，幽竹送寒声。\n砧响家家急，溪阴寸寸生。\n含情不得语，拂石记闲名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十一","author":"释绍嵩","text":"独立柴荆外，孤吟四望频。\n晴山云罨画，深谷鸟声春。\n老觉文章退，闲知气味真。\n穷居那敢恨，虚白自为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十三","author":"释绍嵩","text":"此地真奇绝，何须屋万间。\n穿林邻虎穴，隔水是尘寰。\n保甲元无籍，讹邪自不关。\n安闲有深味，未敢负云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十七","author":"释绍嵩","text":"静境绝过从，昼门开更慵。\n荒林失轻雾，寒日下危峰。\n曳履寻花圃，搜诗到暮钟。\n谁言淹泊意，无酒为浇胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十二","author":"释绍嵩","text":"永日翛然坐，春风苦唤行。\n笋舆穿树色，竹坞度钟声。\n雨恶天光淡，山穷地势倾。\n苔矶清境里，花湿转分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十五","author":"释绍嵩","text":"碧树高岩底，柴门引径斜。\n采茶寻远涧，护药插新笆。\n澄水含斜汉，寒空散晚霞。\n寂寥无与晤，聊欲玩烟花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其七","author":"释绍嵩","text":"掩户闲攲枕，身心俱寂然。\n蹉跎已甘分，游息或谈玄。\n独得万古意，何劳百响煎。\n功名与世事，欲问即攀缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十六","author":"释绍嵩","text":"物色催年老，谁令眼界幽。\n不忧缘不动，无意亦无求。\n寂寞了闲事，迂疏却自由。\n功名今晚矣，萍梗任飘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十四","author":"释绍嵩","text":"早晚无尘事，清心白日长。\n水烟通径草，冰玉入诗肠。\n远峤收残雨，空林挂夕阳。\n此时何限兴，幽鸟语如簧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其四","author":"释绍嵩","text":"独坐空山里，闲寻物理幽。\n人情正苦暑，诗兴得高秋。\n衰谢多扶病，功名安足谋。\n自嗟疏野性，肯伴白云休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其十","author":"释绍嵩","text":"老罢休无赖，吟诗报答闲。\n圆扉长寂寂，腾口任㘖㘖。\n护塔云偏重，栖林鸟自还。\n荣枯不经意，何用密防奸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其二","author":"释绍嵩","text":"山色堆蓝重，风烟野外嘉。\n与闲为活计，祗者是生涯。\n虽有明时约，端无外物华。\n人生贵知足，此兴未应赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居即事 其六","author":"释绍嵩","text":"拂石玩林壑，凛然天欲秋。\n竹风连野色，舍影漾江流。\n碧嶂云初合，遥峰雨半收。\n山居自清绝，不梦世间游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居遣兴","author":"释绍嵩","text":"百衲老空林，疏慵倦九箴。\n浮沉千古事，去住两乡心。\n绝顶无禅侣，忘言有匣琴。\n感多聊自遣，时复一闲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事","author":"释绍嵩","text":"松盖环清韵，秋风倚杖前。\n栖毫思确论，击竹自忻然。\n高鸟翔云外，孤亭恰水边。\n幽居经宿雨，无处不潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤口寺","author":"释绍嵩","text":"古柏间松篁，山光接水光。\n园林春婉娩，云水日相佯。\n苒苒花明岸，稍稍竹过墙。\n冥搜得诗窟，台馆晓苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤山西亭戏书","author":"释绍嵩","text":"日日西亭上，凭栏取次看。\n绕崖云惨惨，浥屦露团团。\n昼景委红叶，松香掩白檀。\n平生勋业意，开镜影相欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤山即事","author":"释绍嵩","text":"久欠游山债，因寻溪上村。\n风沙轻漠漠，烟树远昏昏。\n土甑封茶叶，石泉通竹根。\n榰筇聊小立，老子笑无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺戏书","author":"释绍嵩","text":"出郭西湖近，贪看立又行。\n园林青气动，日夕白云生。\n映竹犬初吠，缘溪鹤自鸣。\n慇勤下天竺，泉石惬幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天章道中","author":"释绍嵩","text":"十里寻幽寺，江山几路分。\n逢人问息耗，指路上高云。\n极浦明残雨，寒流叠细纹。\n野鸦无意绪，嘹唳傍溪濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆游天衣","author":"释绍嵩","text":"寺忆新游处，江村日暮时。\n溪长石磊磊，天远草离离。\n塔院关松雪，山泉满路歧。\n那知岩下树，一一入吾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山精舍戏书","author":"释绍嵩","text":"迥碛沙衔日，荒溪众树分。\n行人随旅雁，寻寺入幽云。\n远岫林间见，啼莺梦里闻。\n湖山虽不语，心绪已纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代次登城之什","author":"释绍嵩","text":"上得孤城向晚春，其如衰病只伤神。\n鼠肝虫臂窥前辈，虹旆星车委后尘。\n两鬓已霜难讳老，一机何处定非真。\n愁来只有贤从事，千里相逢如故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代和韵","author":"释绍嵩","text":"石路无尘竹径开，幽园寻胜独登台。\n桥边野水通渔路，城上秋山入酒杯。\n紫闼青云俱未遂，红颜白发递相催。\n悠悠兰渚动归思，归思临高不易裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代颜圣闻次韵即事","author":"释绍嵩","text":"渡口水流急，凭栏凝睇劳。\n远山枫外淡，矮竹苣边高。\n古木丛青霭，鳊鱼噀白涛。\n幽闲无个事，痛饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰亭书事","author":"释绍嵩","text":"苍岸古木霭烟萝，风俗犹闻晋永和。\n绿树碧檐相掩映，青鞋黄帽饱经过。\n还缘世遇兵戈闹，颇觉闲消日月多。\n盘礴幽窗觅诗处，月明天色白连河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"写怀","author":"释绍嵩","text":"养拙甘沉默，萧条古寺间。\n中心无所愧，在世有馀闲。\n梦钓鸥边雪，钟鸣枕上山。\n徘徊幽兴熟，何处不开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"写怀寄湛上人 其一","author":"释绍嵩","text":"吾事只如此，奔忙自作痴。\n买山犹未得，吊古却成悲。\n老去慵趋世，愁来独赋诗。\n浮生同是客，谁复问栖迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"写怀寄湛上人 其二","author":"释绍嵩","text":"寂寂相思际，遥焚一炷香。\n雁飞云杳杳，笛引泪浪浪。\n明代谁招隐，穷游我自忙。\n他时解颜笑，宁免鬓毛苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发长沙","author":"释绍嵩","text":"秋入长沙县，无人画得成。\n晚风轻浪叠，落日乱蛩鸣。\n一雨洗烦暑，千山指去程。\n回期谁可定，行乐且吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叹命","author":"释绍嵩","text":"叹命无知己，吾徒却自宽。\n艰难为客惯，幽僻置身安。\n竟日霏微雨，空园浩荡寒。\n江山多胜境，到处得吟看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再代和通字韵","author":"释绍嵩","text":"驿路穿林断复通，客程蛇绕乱山中。\n三杯软饱千林暝，万事从来一笑空。\n珍重故人相问意，自怜羁客尚飘蓬。\n江湖易有淹留兴，已许沧浪伴钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同粲湛二上人游北山","author":"释绍嵩","text":"二子依公子，南山度北山。\n兴随流水远，心逐片云闲。\n日月浮生外，牛羊落照间。\n慇勤华表鹤，飞去复飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安吉道中","author":"释绍嵩","text":"六尺枯藤了此生，青春作伴日同行。\n墙头花吐旧枝出，原上人侵落照耕。\n芳草似袍连径合，乱山如画带溪平。\n杜鹃知我归心急，啼了千声更万声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寻访广福","author":"释绍嵩","text":"旧邑浮航外，青山千万重。\n访僧舟北渡，归寺海西峰。\n薄薄云收日，微微雨洒松。\n可堪添客恨，闻打暮天钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆元道中","author":"释绍嵩","text":"临溪柳带正依依，落絮因风特地飞。\n岛上断云垂极浦，城头初角送残晖。\n闲过绮陌寻高寺，谩绕清流欲浣衣。\n重到张公泊船处，家家扶得醉人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏笔","author":"释绍嵩","text":"地僻人稀到，东郊自养蒙。\n山遥天接树，夜静竹藏风。\n岸柳含烟翠，江花脱晚红。\n诗应是游戏，吟啸不须工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曲江解舟","author":"释绍嵩","text":"动静非常态，此行风正秋。\n巉巉孤棹起，渺渺大江流。\n蝉噪日将落，烟生山欲浮。\n无心与时竞，吟凭钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀","author":"释绍嵩","text":"月淡犹明树，岩幽钟磬微。\n露滋三径草，寒入五更衣。\n栖托情何限，峥嵘岁且归。\n漱流今已矣，无限故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感","author":"释绍嵩","text":"志业不得力，寂寥常掩关。\n交疏贫病里，老疾去留间。\n涉世心犹壮，经秋鬓自斑。\n平生怀古意，欲语泪先潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王东之郊行","author":"释绍嵩","text":"杖屦寻春事，偷分暇日工。\n幽花攲照水，独树迥含风。\n路极阴溪里，桃开晓色中。\n一年春好处，分付少陵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朋上人东湖精舍即事","author":"释绍嵩","text":"开径东湖上，千岩镜里看。\n与君频邂逅，此地久盘桓。\n柳影含云幕，桃花生暮寒。\n婆娑弄翰墨，清兴寄毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵林仲山","author":"释绍嵩","text":"午梦蛮花湿，吟看不忍休。\n白翻荞处雪，红压驿边楼。\n砌冷虫喧座，江澄水浴秋。\n看君有知己，铃阁想迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵梓上人 其一","author":"释绍嵩","text":"一身无定处，谁见寂寥心。\n始为江山静，徒云寒暑侵。\n少孤心易感，漂泊病难任。\n未遂长栖此，孤怀自不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵梓上人 其二","author":"释绍嵩","text":"江湖同避地，老眼不供愁。\n阅世临观美，出门聊散忧。\n渔盐桥上市，河汉岛前秋。\n奔走何时了，如今悟解不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵曾俊臣即事","author":"释绍嵩","text":"柳暗人家水拍堤，人家随处有柴扉。\n草中白道穿村去，门外黄尘扑面飞。\n返照未沉僧独往，暮山时见鸟双归。\n风从北户来披拂，暗递花香入客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上","author":"释绍嵩","text":"弱柳垂江翠，惊湍拍岸浮。\n烟生山欲尽，春半水争流。\n棹倚袁宏渚，云凝庾信愁。\n艰难念时事，衰谢不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上对月","author":"释绍嵩","text":"北渚牵吟兴，何妨语夜阑。\n天宽云出谷，春至草生滩。\n练练长江静，骎骎半臂寒。\n老翁扶杖立，空对烂银盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上晚立","author":"释绍嵩","text":"沙晚低风蝶，汀烟入夜舟。\n日依平野没，月涌大江流。\n书懒聊遮眼，诗成自点头。\n此时临水叹，一倍不禁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江亭小憩","author":"释绍嵩","text":"不到兹亭久，轩窗眼界开。\n江流翻白浪，树影扫青苔。\n有鸟衔花出，无人送酒来。\n快然心自适，此地亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自笑","author":"释绍嵩","text":"自笑从来癖，平生断在诗。\n凫鹥共容与，魂梦亦清奇。\n古调俗不乐，衰容镜每知。\n机心吾岂有，休把运行推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至保福精舍","author":"释绍嵩","text":"山水寻吴越，搜奇事转新。\n松风知近寺，樯燕语留人。\n雨过闲田地，云饶落日春。\n登临独无语，泉石自相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至钱君瑞壶天因题云","author":"释绍嵩","text":"林下中餐后，登临思渺然。\n扪萝循鸟道，著屐到壶天。\n要地无闲日，新晴有乱蝉。\n主人贪贵达，灯火照青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至禅居","author":"释绍嵩","text":"得路到深寺，溪流镜样清。\n微芳缘岸落，荒竹过墙生。\n烘日浅深色，寒鸦断续声。\n我来无旧识，素抱与谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中口号","author":"释绍嵩","text":"閤皂风烟外，残蝉送客愁。\n云连平地起，水带断槎流。\n树隐重重竹，江呈岸岸秋。\n晚来供望眼，微径杂归牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中值雨","author":"释绍嵩","text":"客路雨连日，吾生良可嗟。\n萧萧打蓬急，脉脉受风斜。\n野望迷青草，江声走白沙。\n今宵何处宿，攲枕听鸣蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟发清江","author":"释绍嵩","text":"稳泛一船东，生涯真转蓬。\n烟浮平野碧，波软夕阳红。\n浦树家家异，风光处处同。\n回看苍木杪，眼界入云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖晚步偶成呈曾君举司户","author":"释绍嵩","text":"山引千岩翠作堆，钟鸣楼阁晚云开。\n鱼吹鉴面晕痕蹙，人过桥心倒影来。\n要听剧谈飞木屑，便期携手上春台。\n世间刚有东流水，一洗从前猿鹤哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"释绍嵩","text":"残日住孤馆，虚廊绕几回。\n沙鸥背人去，江雨带潮来。\n古驿怪藤合，霜花错节开。\n时因念衰疾，独与暮猿哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即笔","author":"释绍嵩","text":"小阁称幽隐，群峰竞秀尖。\n村舂雨外急，秋色望中添。\n世事已黄发，忘情付黑甜。\n从渠造物巧，未怪老夫潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投宿宝觉精舍","author":"释绍嵩","text":"驿路向山郭，江蓠满意馨。\n远云收海雨，独树隐沙汀。\n桑椹累累紫，杉栽处处青。\n夜投宝觉寺，重上竹西亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]