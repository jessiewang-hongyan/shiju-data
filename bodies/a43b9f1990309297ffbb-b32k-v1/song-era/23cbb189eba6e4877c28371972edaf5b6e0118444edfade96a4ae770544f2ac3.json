[{"title":"雨后晨出荥泽道中寄嘉仲明府","author":"周行己","text":"宿雨郊原润，新晴禾黍香。\n天高晨气静，地阔野风凉。\n忽忽忧群盗，悁悁怀故乡。\n摄官聊免死，何敢论行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢嘉仲相招寄居荥泽","author":"周行己","text":"已解陈蕃榻，仍留杜甫亭。\n饱闻期月政，愿受一廛氓。\n万事尊中酒，馀年水上萍。\n依投知有地，流转任浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李子兴新第归宁","author":"周行己","text":"新恩好骥子，门户有辉光。\n昏宦通三世，山川共一方。\n拜亲今绿绶，传业自青缃。\n买宅如来此，相从及早凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题江南李氏四照亭","author":"周行己","text":"闻道新亭好，开轩四望虚。\n葱葱佳气合，衮衮众山趋。\n野鸟来还去，浮云卷却舒。\n登临富幽兴，应不羡陶朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中有感","author":"周行己","text":"皛皛平川静，晖晖寒食曛。\n连山荒白草，属地乱黄云。\n岁晚关心事，天边为客身。\n扁舟终不恶，奔走失吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次渠仅老韵四首 其一","author":"周行己","text":"痴拙时无用，归来老罢休。\n夜寒为客梦，岁晚异乡愁。\n鸟有南枝宿，川皆东海流。\n凭高望归路，云重失沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次渠仅老韵四首 其二","author":"周行己","text":"世事人情了，年华鬓发侵。\n平生忧国泪，老去恋乡心。\n四壁家千里，三秋书万金。\n号寒小儿子，念汝故情深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次渠仅老韵四首 其三","author":"周行己","text":"鸟暮已归宿，吾今行亦休。\n百年能几许，万事不胜愁。\n贫贱须行乐，功名可枕流。\n鲈鱼秋兴远，风起白蘋洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次渠仅老韵四首 其四","author":"周行己","text":"忧患功名晚，尘劳岁月侵。\n愁来无与语，老去独伤心。\n不复周公梦，宁须季子金。\n题诗凭遣兴，情极恐言深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次李荥泽韵","author":"周行己","text":"已罢仍侨寓，虽贫强客羞。\n閒居非素隐，高卧得清秋。\n故国今何在，他乡未免忧。\n为儒生用拙，老去更宜休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿大足寺","author":"周行己","text":"尘埃得古寺，突兀乱山中。\n叠径僧居僻，悬崖鸟道通。\n塞云常雨雪，山木自多风。\n万事浮生外，心花发暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送左与言赴杭司录","author":"周行己","text":"艰难惟义重，去住各愁深。\n乔木迷归梦，孤帆伴客吟。\n相看忧国泪，独立望乡心。\n到日如无事，来书速寄音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨至石碣院时丧女殡此院二首 其一","author":"周行己","text":"萧寺来人少，祇林过雨清。\n日光微破影，云色未全晴。\n久客嗟殊俗，中年哭后生。\n庭前空柏子，此意复谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨至石碣院时丧女殡此院二首 其二","author":"周行己","text":"晓色初明野，云容尚隐林。\n蒿莱三径拙，鸟雀一枝深。\n忧患他乡泪，淹留故国心。\n平生丘壑趣，衰谢愧同襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王天粹登第归","author":"周行己","text":"王氏青箱学，名家千里驹。\n朝廷求士急，吾子应时须。\n上第人皆有，高才世久虚。\n别君谁暖眼，书信莫令疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和林惠叔 其一","author":"周行己","text":"摄邑聊观政，无才可及人。\n案书捐吏役，檐日遂吾真。\n听说桑麻好，欢言雨露新。\n贫居愿时熟，聊试甑中尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和林惠叔 其二","author":"周行己","text":"世间同大宅，何处是安居。\n卧地有知足，栖巢亦晏如。\n松楸怀旧隐，城市远先庐。\n衰病难堪责，交游喜渐疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书王仲元都巡城上小亭","author":"周行己","text":"王子吹箫处，孤城城上台。\n回回众山入，隐隐一川来。\n花草三春合，轩窗四面开。\n得官兼吏隐，端复谢尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"原武丧女有感 其一","author":"周行己","text":"人世刹那顷，汝身能几秋。\n一生如梦了，万事盖棺休。\n年老不禁哭，夜长都是愁。\n弃置复弃置，千古共山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"原武丧女有感 其二","author":"周行己","text":"飘零同逆旅，生死异前途。\n恩爱此生断，声容昨梦馀。\n幻身今堕甑，戏事已陈刍。\n寂灭真为乐，劳劳得尔如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋霁分韵得中字","author":"周行己","text":"清晚搔头望，晴天已不同。\n霁烟才冉冉，雨意却濛濛。\n为客艰难里，思亲涕泪中。\n独凭心事在，倚杖看秋鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊行","author":"周行己","text":"野步春郊净，佳游病眼开。\n风流可怜柳，零落不堪梅。\n水接仙舟泛，山纡俗驾回。\n归欤月已没，馀兴更登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻官军捷报呈彦升时仲","author":"周行己","text":"滞雨春惟冷，端忧夜更长。\n曲肱思已乱，如面世难防。\n捷报闻平寇，安书喜到乡。\n鹿门心未遂，谁与论行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿郡守","author":"周行己","text":"仙系苏门远，英流富绪长。\n胚胎潜间气，庭玉焕祥光。\n永日辉南陆，融风丽北堂。\n綵馀长命缕，香剩浴兰汤。\n丹穴皆威凤，荆山必豫章。\n精神森秀发，器质俨温良。\n懿学传经济，嘉猷合赞襄。\n庆流多显赫，筮仕早腾骧。\n游刃无间剧，提衡绝否臧。\n高情薰爱日，劲节肃清霜。\n暂借朱轓出，行看皂纛扬。\n颂声喧道路，舆望属岩廊。\n时遇生申旦，官临指李乡。\n众真金阙奏，满郡玉炉香。\n强仕春秋富，昌朝事业芳。\n臣千君万寿，赓载济时芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"原武祈雨有应呈诸同僚","author":"周行己","text":"嗷嗷忧旱魃，恳恳叩神祠。\n自疏官多旷，无辜岁莫饥。\n奇峰俄变黑，甘液遽如筛。\n雷电宁无物，风云自有师。\n荒郊回沃壤，荣穗发萎枝。\n摄邑乖为政，同僚实副时。\n民心惟礼义，邦本系安危。\n食足无他事，恩馀及我私。\n白看云子粒，滑想杜陵匙。\n拂拭莱芜甑，香炊定可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿沈守","author":"周行己","text":"三甲三壬五福俱，胸中落落贮琼琚。\n池塘芳草诗情远，富贵浮云世事疏。\n一郡寿炉薰爱日，层霄仙籍寄真书。\n君王万亿臣千亿，永作天官拱帝居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿时相三首 其一","author":"周行己","text":"皇天祐德必生贤，尊主功高五帝前。\n岳骨昴精来间气，彭龄聃寿与遐年。\n远无忧患身先退，近有湖山乐更全。\n祇恐苍生须谢傅，每闻人诵衮衣篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿时相三首 其二","author":"周行己","text":"每闻人诵衮衣篇，又值君臣庆会年。\n腊雪已先调鼎实，春风还是作霖天。\n经纶道自心源出，损益时随世变迁。\n当宁旰宵怀旧德，非公谁与济商川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿时相三首 其三","author":"周行己","text":"非公谁与济商川，年德俱隆文武全。\n省事省官民自定，足兵足食务当先。\n烹鲜取治惟无扰，置器期安在不偏。\n公寿且千君且万，四方永永乐尧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次僧昙隐谢见临韵二首 其一","author":"周行己","text":"倦云小息五公山，来往扁舟胜据鞍。\n强饭未能追马革，寄餐端恐识猪肝。\n山泉周匝流清泚，古木森罗照屈蟠。\n独卧北窗怀太古，元无一物到门阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次僧昙隐谢见临韵二首 其二","author":"周行己","text":"隐迹僧居无所为，蒲团曲几面清池。\n一身有累须三径，万物无私各四时。\n心与溪山相宛转，事随尘世漫纷披。\n山中不用诗招隐，已约施岩采紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"几山出示阳桥唱和诸什窃慨英才之沈寂光景之流迈因两次其韵皆以少日为篇首一以赠监镇孙和仲一以赠知丞苗几山云 其一","author":"周行己","text":"少日称豪弓马场，时平不复戍渔阳。\n引杯看剑夜云黑，横槊赋诗寒日黄。\n霜落草枯閒战骑，位卑禄薄困征商。\n白头未试吴王妓，杨柳萧萧古道傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"几山出示阳桥唱和诸什窃慨英才之沈寂光景之流迈因两次其韵皆以少日为篇首一以赠监镇孙和仲一以赠知丞苗几山云 其二","author":"周行己","text":"少日称豪笔砚场，一官家近住河阳。\n人情易变春云薄，世故饱谙秋鬓黄。\n寒日苍凉临迥野，浩歌悲壮激哀商。\n时平民乐官无事，醉倒题诗舞袖傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子固嘉夫相过观几山唱和","author":"周行己","text":"万事都将笑一场，不如载酒访高阳。\n冻消地面可怜绿，日暖杨枝无奈黄。\n尚德久从君子鲁，言诗仍有起予商。\n太平无事閒居乐，且醉高楼大道傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子固","author":"周行己","text":"老年不入少年场，不似当时在洛阳。\n福善坡头回曳练，石家寺里看姚黄。\n春风杨柳东西陌，古道楼台南北商。\n流落如今归未得，白头憔悴卷城傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉夫再有冰玉交辉佳句复和酬报","author":"周行己","text":"烂烂双瞳掣电光，照人皮里有秋阳。\n谁将鼠腊同苍璧，枉把盐车服乘黄。\n合有猷谋陈稷契，即看灏噩继周商。\n近来佳句惊人甚，敢并蒹葭玉树傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李文叔见招","author":"周行己","text":"杜曲林泉可寄年，功名富贵有危颠。\n囊中佳句浑轻与，海内名方莫浪传。\n赤脚拿舟能楚些，明眸度曲解回旋。\n且过叔度留终日，未问他年骑锦鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和文叔","author":"周行己","text":"事业功名看百年，千杯醉墨谩张颠。\n关西夫子时方弃，稷下诸儒谁与传。\n契阔十年才道旧，间关千里又言旋。\n飘萍断梗无根柢，愁唤羸童理破鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中思归呈千之十七兄","author":"周行己","text":"白首遑遑谩世忧，我今问米下扬州。\n支离病骨难堪暑，浩荡归心不待秋。\n兵火彫零馀故里，功名衰谢独扁舟。\n腐儒老死终无用，收拾纶竿好去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵趣归","author":"周行己","text":"故乡何处海东头，地尽东南最胜州。\n水陆归程几百驿，风尘回首恰三秋。\n无才北使能降敌，决意东归已办舟。\n去国不缘明主弃，只缘多病更宜休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙德平病秋思归","author":"周行己","text":"春雨秋风无尽期，鸢飞鱼跃各天机。\n年光逝水催前浪，世事浮云换白衣。\n草木变衰知节改，田园芜没要吾归。\n人生万事惟心可，真处何妨世俗讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和知丞苗几山","author":"周行己","text":"陆沈僚底惘骙瞿，玩世滑稽常自如。\n鞍马犹堪供矍铄，功名谁复念居诸。\n胸怀金玉天知我，仕宦风波丞负予。\n尊酒夜阑听软语，清谈笑谑极群书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和使君闵雨","author":"周行己","text":"布谷催耕候已深，骄阳未肯化为霖。\n一年铃阁传斋禁，三月花时负赏心。\n空谷灵湫能奋响，丛祠古木已成阴。\n侏儒饱死浑无计，属耳颓墙听雨音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次胡志衡韵","author":"周行己","text":"城北城南春渺然，幅巾藜杖望晴天。\n何须多事途穷哭，莫倚高才瓮下眠。\n渭水来从鸟鼠穴，陇山真接首阳巅。\n登临未尽牛羊下，安得羲和叱驭旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蔡八十约同归","author":"周行己","text":"十年尘土送春衣，每见春风忆翠微。\n射策决科知已误，求田问舍早须归。\n人生岂料长身健，行李还应与愿违。\n遥望故山心独往，杖藜三叹暮云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和蔡八十约归","author":"周行己","text":"闻说寻山意已清，况逢佳客作山行。\n百年心事同杯酒，万里春风出帝城。\n秋燕欲归栖集稳，春鸥无事往来轻。\n风流定是输陶谢，应笑痴人似步兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰溪驿","author":"周行己","text":"小雨滋春态，馀花落晚香。\n扁舟还独往，谁与论行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姑射仙人","author":"周行己","text":"易简乾坤理，和平兆庶情。\n谁知为帝力，万国自生成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲁直帖","author":"周行己","text":"秀润瞻眉宇，清真接话言。\n端能愈吾疾，已觉意超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李端叔帖","author":"周行己","text":"铁面黄犀骨，霜髭灿猬毛。\n晚年聊混俗，犹不废称豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"米元章帖","author":"周行己","text":"戏事刍陈子，浮生甑堕休。\n遗音馀翰墨，人尚想风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和丁忠节三首 其一","author":"周行己","text":"绝庐高隐白云间，德行人知是闵颜。\n侧席求贤新诏黑，肯教夫子久居山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和丁忠节三首 其二","author":"周行己","text":"七十稀年几许閒，星星鬓发半衰颜。\n寸心灰尽周公梦，不恋朝衣只恋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和丁忠节三首 其三","author":"周行己","text":"大儒出处自无心，调燮功高利物深。\n用舍行藏皆是道，不分朝市与山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送禅照大师四首 其一","author":"周行己","text":"海雁年年自往来，迢迢此去几时回。\n春风满路真消息，应是桃花处处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送禅照大师四首 其二","author":"周行己","text":"千峰如画不安排，的的天然更莫猜。\n草碧花红春鸟叫，此中何处问如来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送禅照大师四首 其三","author":"周行己","text":"行行识取灵岩路，多少游人只么回。\n门前有个擎天柱，千万归时带取来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送禅照大师四首 其四","author":"周行己","text":"脱却多年破草鞋，脚根步步踏如来。\n昔人根钝真堪笑，直待血流方始回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知赵鼎臣赠吕令二首 其一","author":"周行己","text":"幕下胸中水镜寒，否臧定不失毫端。\n要知四海皆兄弟，莫作前人青白看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知赵鼎臣赠吕令二首 其二","author":"周行己","text":"坐衙官似坐禅僧，万物风行自饮冰。\n纵解他心无所得，不知何处计才能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书楷老帖后","author":"周行己","text":"楷公不见十三年，何处高谈洞下禅。\n禅里相思无是处，不相思处有谁传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日五首 其一","author":"周行己","text":"送春小雨作轻凉，碧瓦鳞鳞动霁光。\n紫燕衔泥归旧屋，黄蜂采蜜度斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日五首 其二","author":"周行己","text":"小窗午枕梦初醒，特特来寻春径行。\n晴日暖风无俗客，岸巾柳底听新莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日五首 其三","author":"周行己","text":"蛱蝶寻花经竹过，蜘蛛结网趁丝行。\n檐前翻翼频来燕，叶底窥人欲去莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日五首 其四","author":"周行己","text":"深院回廊春日长，晴丝冉冉暖浮光。\n五株恰似陶彭泽，满县愧尔潘河阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日五首 其五","author":"周行己","text":"无赖春物恼人愁，百年心事信沈浮。\n何时买得会稽宅，蜡屐自作乌衣游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日同麻万纪王振叔行南寺五首 其一","author":"周行己","text":"正月一日思悠哉，水边尽日意迟回。\n岂无俗人一杯酒，不作区区城里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日同麻万纪王振叔行南寺五首 其二","author":"周行己","text":"岸头欣欣木向荣，岸下涓涓春水生。\n晴日暖风无俗客，故寻野径逐溪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]