[{"title":"滴翠峰","author":"陈岩","text":"春气薰空草木浮，绿云冉冉起山头。\n岚光浥翠浓于染，润入衣襟冷欲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漂溪","author":"陈岩","text":"摇摇曳曳水西流，风定波凝不起沤。\n傍岸人家星散住，尘埃终莫污沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漱玉滩","author":"陈岩","text":"水石相逢骤作声，铿然律吕自天成。\n山中纵乏知音听，亦有流鱼傍岸行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧云峰","author":"陈岩","text":"瘦藤引我上崚嶒，苍壁如梯石作层。\n袖得碧云无用处，却将分赠住山僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧云庵","author":"陈岩","text":"常日双扉多不开，客须投分始相陪。\n庭前蓦地失松影，试问碧云何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧玉泉","author":"陈岩","text":"蕴玉含晖一水间，碧光炯炯照人寒。\n却疑洗出荆山璞，若有瑕疵试指看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧桃岩","author":"陈岩","text":"自要贪閒非避秦，洞门隔断世间尘。\n山中不置四时历，开到碧桃知是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧霄亭","author":"陈岩","text":"秋风吹上碧霄亭，足蹑灵河袖拂星。\n云影四垂天接地，恍疑有路到仙扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠光亭","author":"陈岩","text":"呷呷波间锦羽明，地无尘处可幽亭。\n唤回天上张公子，来与山家注水经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠羽池","author":"陈岩","text":"锦鸡花鸭烂成文，连雁双凫雪羽纷。\n同免王孙金弹子，飞来飞去一群群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠屏峰","author":"陈岩","text":"削玉横陈开翠屏，东西有路总堪登。\n向来同识春山面，犹有苍苍九节藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠峰庵","author":"陈岩","text":"缚屋山中数十年，薙茅诛棘旋开田。\n何须折柳溪边去，枯木寒林总是禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠盖峰","author":"陈岩","text":"烟际亭亭出古崖，几层翠盖倚天开。\n铿然风向林梢过，知有神仙玉佩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微峰","author":"陈岩","text":"岚气阴阴浅色山，更分黛墨染松关。\n喷云泄雾空濛外，湿翠冷沾襟袖间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠瀑亭","author":"陈岩","text":"湿翠抛来觉染衣，倚阑兀兀坐移时。\n偶因过雨添流水，增重棼丝曳练诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静观亭","author":"陈岩","text":"打围行蚁时时战，触纸痴蝇日日钻。\n有客云山深处卧，静中回向此心观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滕子京书堂","author":"陈岩","text":"云外峰前结旧庐，胸中经济眼中书。\n兵间一范同鞍马，不记深山蕙帐虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澌澌水","author":"陈岩","text":"危柱抨抨曳素丝，水声还解发天机。\n风来未定风还住，恍讶山中鼓瑟希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澜溪","author":"陈岩","text":"小溪亦有怒涛翻，可但沧溟始足观。\n世事会心无广狭，请君来此试观澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"璎珞泉","author":"陈岩","text":"花花结结净无尘，却笑庄严未是真。\n五色明珠光照水，湛然清净本来身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"激清亭","author":"陈岩","text":"灯影昏昏枕半攲，此清原自少人知。\n水声到夜浑如雨，睡思过于听雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濯缨潭","author":"陈岩","text":"山深地僻人稀到，安得沧浪孺子歌。\n缨上本无尘可濯，莫将止水强扬波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"螺髻峰","author":"陈岩","text":"山无重数总蟠青，直北孤峰最有情。\n天巧绾成螺髻样，梳云沐雨百娇生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邃谷岩","author":"陈岩","text":"千古尝留一窖冰，女萝簳竹锁寒阴。\n仙人肯为游人出，试问中间若许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"覆瓯峰","author":"陈岩","text":"生铁团团铸翠峦，一瓯倒覆白云端。\n瓯中姓氏无人识，应被山灵静揭看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醮坛","author":"陈岩","text":"粲粲无尘一石平，向来此地步虚声。\n薜萝今绕空山里，千古清风窦子明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忘归亭","author":"陈岩","text":"两袖飘飘恍欲仙，半醒半醉酒明船。\n太虚一室都无碍，皎月凉风石上眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀华亭","author":"陈岩","text":"瘦田糁糁豆花明，冷径毵毵柏叶清。\n何处路通云际寺，山人指我秀华亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲花峰","author":"陈岩","text":"风动云开净客颜，三千丈石锦烂斑。\n淤泥不是花开处，擢出天河绿水间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清漪潭","author":"陈岩","text":"水出双溪似镜平，萦回遇石自成文。\n眼明波上谁相对，只有飞来白鹭群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"稻积峰","author":"陈岩","text":"探得松苓足养身，仙家留稻满仓囷。\n岂知山下人辛苦，五月青苗已粜新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洗竹","author":"陈岩肖","text":"直干解新箨，低枝蔽旧丛。\n芟繁留嫩绿，引月更添风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题巾子山广轩","author":"陈岩肖","text":"屹立双峰入云表，登临聊为小迟留。\n四围山色搀天碧，一曲波光抱郭流。\n身世欲违尘俗态，生涯宜与水云谋。\n何当占断层峦顶，一室烟霞百虑休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘露","author":"陈岩肖","text":"负土筑新阡，松楸手亲艺。\n结庐居墓傍，猿鹤为垂涕。\n屈指几星霜，精诚动天帝。\n三宵神泽零，霏霏洒松盖。\n晓看岁寒枝，厌浥满苍翠。\n初含红日光，颗颗金珠缀。\n味分饴蜜甘，香夺芝兰气。\n亭午若凝脂，青丝系千穗。\n赤城千里传，冠盖日相继。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓 其三","author":"陈庚","text":"取友惭何益，论昏不厌贫。\n亦公自为德，而我竟奚因。\n事巧缘何浅，言深死已濒。\n枕边呼别意，生死见情真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓 其二","author":"陈庚","text":"客至支筇出，俱云步履强。\n礼犹尚筋力，病忍谓膏肓。\n此别终千古，相陪苦一霜。\n萧萧亭畔柳，回首重凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢友人惠犀皮胡瓶","author":"陈庚","text":"灵犀鳞甲鸱夷腹，块土能奇诧善埏。\n器似虞陶知不窳，规同庄埴巧成圆。\n雕镌尚喜兼文质，空洞祇堪容圣贤。\n于一器中求不器，愿珍嘉惠比韦弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓 其一","author":"陈庚","text":"泮水题名记，灵光独此翁。\n袖衣隽曼倩，折角郭林宗。\n湖海襟期别，风涛患难同。\n斯人宁复得，些罢涕无从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺家湖","author":"陈庚生","text":"风流谁似贺知章，乞得平湖任草荒。\n今日藕花三百亩，折来依旧属君庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"超然馆弹琴夜话","author":"陈庚生","text":"玉琴弹罢一灯青，仙鼠飞飞到客庭。\n道士却能谈肇论，夜深倾听有山灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒陶隐居祠呈郎中张声华","author":"陈庚生","text":"炼就灵丹岁月赊，药炉丹灶旋成洼。\n庭空响落山松子，路远香迷野草花。\n旧事谁能问□水，神仙今已在东华。\n田翁犹酹先生酒，乱纸飞钱噪暮鸦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濯缨亭","author":"陈庚生","text":"谁引沧洲客，行歌到此亭。\n萦回一水碧，巉绝两峰青。\n小雨吹行舰，疏梅度远汀。\n我无缨可濯，华发任星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康提刑过端州","author":"陈怿","text":"旧历江山眼重开，平成摇辔赏嵩台。\n晋康假道昔为守，按部今持使节来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康提刑过康州","author":"陈怿","text":"民居城栅尽非元，唯有江山似昔年。\n听讼棠阴遗旧址，按行台旆照晴川。\n重来自喜恩威洽，别后常嗟岁月迁。\n道侧老人曾卧辙，拜迎相顾倍怡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春波亭","author":"陈旼","text":"翼然溪浒一亭新，潋滟波光巧样春。\n一舸月明鱼射宿，数帆风饱客知津。\n沙侵鹜碛犹含润，花点鱼叉不受尘。\n莫听阳关始拚醉，好将酩酊付芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋新繁周表权如诏亭","author":"陈昂","text":"封典宠岩穴，褒言华日星。\n其谁尽如诏，何暇更名亭。\n公昔善教子，家传惟治经。\n当年云榜揭，今日玺书形。\n籍已贵同省，坐应尝隔屏。\n公馀褫簪綍，綵服戏家庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词","author":"陈昉","text":"桂影婆娑玉殿凉，风传花漏夜声长。\n内人亦有思仙者，月下吹箫引凤皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食湖上","author":"陈昉","text":"花瘦水肥三月天，画桡双动木兰船。\n人家尽换新榆火，唯有垂杨带旧烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"全州","author":"陈昉","text":"湘中惟此郡，地接五溪蛮。\n楚水波长碧，尧时竹尚斑。\n昔曾行乐处，今在梦魂间。\n桥是先公建，休言我涕潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花","author":"陈昉","text":"兰麝香消委废宫，纷纷漠漠夕阳中。\n长门梦断金闺月，南国歌残玉树风。\n流水池塘春色去，绿阴庭院綵云空。\n西园半醉休回首，烟草凄凄雨正红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"陈昉","text":"二十馀年作吏人，后园花木也成林。\n尽是笔头那撚得，枝枝叶叶有冤声。\n刑重惟恐囚人怨，情轻又怕本官嗔。\n不知无事早归去，免得生魂对死魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太真图","author":"陈昌时","text":"绣帕香鞯玉履麟，侍儿扶上不胜春。\n如何揽辔宫阶日，却把中原踏作尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平宴","author":"陈昌时","text":"朝阳鸣凤马图河，雷动官僚宴泰和。\n万国春风酣组绶，九天明月照笙歌。\n红云瑞拥山呼寿，沧海恩深酒作波。\n元朔丹崖声教远，愿昭鸿业刻嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆西湖","author":"陈昌时","text":"游梦春成昨，东风感旧题。\n江流如汴水，柳色似隋堤。\n地重天王塔，山寒处士栖。\n最怜三月暮，愁眼为花迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陈昌时","text":"石室无来客，閒云伴晚眠。\n梦添身外事，发减镜中年。\n小雨溪平路，牛衣业在田。\n剑星横照胆，归意未应全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周公辅别业","author":"陈昌时","text":"同余栖隐地，只在白云根。\n野草行无路，孤舟入有门。\n已存栽竹地，不买种桃园。\n眼底饶苍翠，南山带北村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓程","author":"陈昌时","text":"男儿腰下带芙蓉，羞睹秦官老径松。\n羊胛日生寒戍鼓，马蹄风起夜楼钟。\n菊花憔悴三分雨，枫叶青红一半冬。\n只为新诗吟太早，满衣风露湿重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湛江归自浙西","author":"陈昌时","text":"尚忆沧洲旧钓舲，一瓢收尽浙江灵。\n鬓欺北斗怜归鹤，眼暗西风悔聚萤。\n蚌浦有光秋孕月，剑床留怪夜眠星。\n不堪雨外重回首，塔压吴山□□青。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留湖心寺","author":"陈昌时","text":"出城五里凄无宿，清境光辉日遍曝。\n水仙飞结空中楼，佛香吹化莲花国。\n老僧坐久忘身心，夜凉恍住蛟人屋。\n何当使我出世愁，苔径幽窗弄艺竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄金台","author":"陈昌时","text":"峨峨燕中台，悠悠易上水。\n怀哉燕昭王，招彼天下士。\n士贵相知深，岂为多黄金。\n筑台置黄金，自是君王心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邺都","author":"陈昌言","text":"山势崔嵬望太行，星轺迢递过临漳。\n华林园废花争发，铜雀台空草自芳。\n何必三分誇霸业，独怜千古擅文章。\n生逢乱世终非幸，疑冢累累挂夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"陈松龙","text":"移根千里入名园，酒晕红娇气欲昏。\n待得太真春睡醒，风光已不似开元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾","author":"陈松龙","text":"布叶敷条翠作围，自生芒刺护裳衣。\n莫嫌野兴难拘束，只伴春风亦见几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠庵僧","author":"陈松龙","text":"独羡为僧者，尘缘不到门。\n采薪松落子，移径竹生孙。\n古井汲云气，寒山招月魂。\n犹怜生死海，应□出前村。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"陈松龙","text":"荐菊明诗眼，看梅长道心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈松龙","text":"梨花春二月，杜宇夜三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陈松龙","text":"庭暗梨花疑有月，堤晴杨柳自生烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽薛艮斋 其二","author":"陈枢才","text":"晁董科名累，向雄利禄儒。\n惟公传洛学，处世类齐竽。\n湖外严兵戍，神畿析使符。\n恍然成昨梦，一吊束徐刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽薛艮斋 其一","author":"陈枢才","text":"耆旧襄阳传，风流月旦评。\n此翁尤间出，当代总销声。\n遇事皆迎刃，游谈可伐兵。\n孰知死诸葛，英气凛如生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喷玉矶","author":"陈武","text":"朝借仙岩游，暮借仙岩宿。\n一洐流不穷，长年看不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"陈泷","text":"老尽梧桐凤不来，虚名犹占旧层台。\n朝阳照破兴亡梦，一径花阴自绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自赋小隐","author":"陈泷","text":"环堵萧然一破庐，市尘不到足安居。\n知心惟有梅梢月，来照寒窗夜读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀高履常","author":"陈泷","text":"苍头背锦囊，别我渡淮乡。\n一去又无信，相思几断肠。\n柳桥初过雨，瓜步正斜阳。\n知己同行乐，应忘归路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题苏子美沧浪亭","author":"陈泷","text":"整履上飞虹，风高退酒容。\n叶黄翻乱蝶，树老卧苍龙。\n古径秋霜滑，空山暮霭浓。\n沧浪棋石在，题笔暗尘封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈泽","text":"泉石曾经六一评，到今草木亦知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出乡","author":"陈炎","text":"笋舆摇兀去程赊，岭路羊肠狭且斜。\n祇见万山迷眼界，正无多地看人家。\n当庭锄土栽桑柘，成级开田种麦麻。\n可喜此邦皆务实，学儒学稼是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]