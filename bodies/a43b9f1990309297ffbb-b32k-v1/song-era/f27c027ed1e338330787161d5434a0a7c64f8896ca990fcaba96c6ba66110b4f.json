ice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周南夫寺簿 其一","author":"孙应时","text":"越绝佳岩壑，由来说剡中。\n风流应未远，人物正推公。\n遽作辰龙梦，真疑冀马空。\n庆源端有属，列戟看西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周南夫寺簿 其四","author":"孙应时","text":"狱寺平反助，仪曹簿正明。\n嘉猷新入告，天语重恩荣。\n起滞方如此，论功百未成。\n茫茫天理昧，叹惜恨难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽杨子美侍郎 其二","author":"孙应时","text":"荣禄连三纪，贤劳匝四方。\n风烟鬓苍白，道路马玄黄。\n不是论思晚，终然疾病妨。\n谁书循吏传，处处有甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽杨子美侍郎 其一","author":"孙应时","text":"游刃刀无缺，韬光玉自温。\n世途犹砥柱，士论亦龙门。\n仁者宜三寿，天乎遽九原。\n老成周雅叹，此事更谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽杨子美侍郎 其三","author":"孙应时","text":"万里鹏才息，千年鹤近归。\n光荣人所羡，閒乐意终违。\n碧海沉佳气，空山送落晖。\n翟公生死冢，雨泪独沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南安钱知军佖 其二","author":"孙应时","text":"别我南江去，风帆半夜开。\n苦无为郡乐，已复盖棺回。\n契阔空三叹，凋零并一哀。\n遥知泣遗爱，愁杀岭头梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南康冷知军 其二","author":"孙应时","text":"近托龙门御，钦闻月旦评。\n感公非辈行，见我若平生。\n杖屦已陈迹，山川空复情。\n阶庭森玉树，端不负留耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南康冷知军 其一","author":"孙应时","text":"礼乐三千字，声名五十秋。\n士元才展骥，李广不封侯。\n香火犹彊健，笙歌足燕休。\n如何早仙去，寒日惨山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡子瑞 其一","author":"孙应时","text":"耆旧长庚月，斯人马少游。\n平生自绳尺，方寸不戈矛。\n细细巾箱字，琅琅灯火秋。\n子孙森满眼，赍志可无酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡子瑞 其二","author":"孙应时","text":"三十年间事，论交踵父兄。\n叩门时下榻，话旧各伤情。\n我亦华双鬓，君仍隔九京。\n滞留违一恸，肠断暮云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]