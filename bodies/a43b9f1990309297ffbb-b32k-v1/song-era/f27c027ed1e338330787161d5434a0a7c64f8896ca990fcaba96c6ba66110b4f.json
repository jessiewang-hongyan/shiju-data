[{"title":"送赵仲礼入朝为大理寺簿 其一","author":"孙应时","text":"决科遄入幕，更秩遂登朝。\n龙化无重浪，鹏抟即九霄。\n仙凡端有命，天壤一何辽。\n愿踵门庭盛，勋庸日月昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵仲礼入朝为大理寺簿 其二","author":"孙应时","text":"綵服慈颜喜，纶音宠渥新。\n教忠当事主，顾养苦思亲。\n杭苇东西近，邮筒早晚频。\n宗公天下镇，眉寿保千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵舜臣知温州","author":"孙应时","text":"闽岭淮堧忆细侯，更烦东作谢公州。\n清规已出百城上，仁气便销千里愁。\n好去綵衣娱寿斝，归来紫橐奉宸旒。\n马前雁荡风烟里，几许新诗答素秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送袁和叔赴淮阴尉","author":"孙应时","text":"底事书生用一官，彊随时样著衣冠。\n千年蠹简人情冷，百折羊肠世路难。\n未必功名欺老大，且凭书信报平安。\n秋风我亦淮东去，留取江山对眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送高南仲之华亭","author":"孙应时","text":"子向云间去，吾空泽畔吟。\n长因句中眼，不忘别时心。\n梁木蟠根大，渊泉汲绠深。\n丈夫千载事，莫待鬓霜侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送高南伯入太学","author":"孙应时","text":"我昔桥门客，于今喜送君。\n天资自金玉，风味更兰薰。\n各为亲年重，难忘别意勤。\n功名何必问，怒翼正垂云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送虞仲房赴潼川漕 其三","author":"孙应时","text":"小隐横溪胜，青山照眼高。\n芝兰春满座，风雨醉挥毫。\n苦恨登门晚，深惭倒屣劳。\n公归佩荷橐，肯问及蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送虞仲房赴潼川漕 其一","author":"孙应时","text":"夙昔青云上，谁令鬓发苍。\n家声唐秘监，墨妙汉中郎。\n牢落山林久，间关道路长。\n西风足清啸，几日上瞿唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送虞仲房赴潼川漕 其二","author":"孙应时","text":"保障平时计，遐民力未宽。\n梓潼将漕险，廊庙择才难。\n江水东流急，秦山北顾寒。\n平沙八阵在，倚剑夕阳看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送德安王休司户","author":"孙应时","text":"相逢何必早，倾盖已知心。\n璞玉浑金质，高山流水音。\n眼中江汉阔，别后雪云深。\n莫作穷途叹，功名始自今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻南轩张先生下世感惋有作 其二","author":"孙应时","text":"中原天意定何如，岂谓人才不素储。\n前辈老成今殄瘁，丁年豪隽重萧疏。\n武侯岁晚出师表，贾谊平生流涕书。\n社稷无疆恩泽厚，小臣何敢议盈虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闽宪克庄以故旧托文公五世孙明仲远徵鄙文老退遗弃散逸荷伯宗用昭止善浩渊子勖至善及余表侄孙陈谊予兄子丰仲弟之婿贾熙用昭之从子大年等十馀人寒冬连旬日夜录之得五十卷亦已劳矣赋此为谢","author":"孙应时","text":"老去斯文付寂寥，寒枝枯甲一遗蜩。\n虚言自叹真何补，好友相求不惮遥。\n败箧尘埃烦数子，破窗风雨每连宵。\n诗成明日寻梅去，共看春风转斗杓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭亡友胡达材 其一","author":"孙应时","text":"少日徐卿子，他年董相孙。\n敛藏神气重，进止德容尊。\n人物当今叹，风流雅望存。\n拊棺疑不死，谁与赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭亡友胡达材 其四","author":"孙应时","text":"嗟我论交重，相知照胆明。\n十年离合地，今日死生情。\n惊定心犹碎，悲来泪独倾。\n绝怜江上梦，一一话生平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭亡友胡达材 其三","author":"孙应时","text":"匹马劳山县，风霜度十旬。\n能令万人活，不计百年身。\n事业秋毫尽，声华白日沦。\n之人才筦库，谁独上麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭东莱吕先生 其四","author":"孙应时","text":"蟠际函三极，精微破一毫。\n百川沧海受，五岳众山高。\n退托初何有，声名肯自豪。\n谁人伤日月，用力尔徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭东莱吕先生 其六","author":"孙应时","text":"镜曲重携杖，京都再及门。\n诗书窥梗槩，耳目竟烦昏。\n怊怅身何极，蹉跎意独存。\n长途风雨晦，十驾謇追奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭东莱吕先生 其二","author":"孙应时","text":"往岁风云接，重霄日月开。\n奏篇闻叹息，造膝谂图回。\n延阁初优病，锋车又趣来。\n恭惟天子圣，殄瘁岂无哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭东莱吕先生 其三","author":"孙应时","text":"文献承家大，规模与世公。\n典刑身任重，权度我时中。\n六合清淳气，诸儒辅翼功。\n生贤竟何意，霜雹陨春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭东莱吕先生 其五","author":"孙应时","text":"昨岁荆州讣，江流恨未平。\n天乎令后学，今又哭先生。\n剥落真如此，扶持岂易成。\n河汾遗礼乐，谁慰九原情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭东莱吕先生 其一","author":"孙应时","text":"恸哭斯文祸，苍茫可问天。\n百年曾未半，千载忍无传。\n梁木谁扶厦，狂澜莫障川。\n吞声言不忍，有泪彻重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭沈叔晦墓","author":"孙应时","text":"宿草遂如许，吾谁作九原。\n堂堂那有此，凛凛尚能存。\n日落松风迥，天清霜气暄。\n百年知己泪，洒泪欲何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别袁和叔","author":"孙应时","text":"风帆晓影动行装，月淡芙蕖浦溆香。\n正想双亲开色笑，不须千里叹凄凉。\n随行书卷生涯在，省事官曹气味长。\n便为君山问今古，一樽清啸满江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭次家大人初抵海陵官舍元韵 其一","author":"孙应时","text":"扁舟祖饯出西陵，千里经行小作程。\n樽俎笑谈多雅故，江湖霜日久晴明。\n只今斗室寒厅夜，任听回风急雪声。\n天报双亲占后福，绝交何畏孔方兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭次家大人初抵海陵官舍元韵 其三","author":"孙应时","text":"风饕雪虐苦侵陵，已免寒舟问水程。\n苇屋虚檐交夜气，边城疏鼓逗天明。\n囊空尚可充饥色，官冷何妨远市声。\n且办新篘供一笑，竹君清绝对梅兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和家大人鬻田训子诗韵","author":"孙应时","text":"凶年满目灶无烟，籴贵家贫且鬻田。\n虽暂忧饥茅屋下，终期射策玉墀前。\n文辞华实宜撑腹，际运穷通一任天。\n有志会须能卒事，岂令久困握空拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽松阳杨秉修处士","author":"孙应时","text":"饱说杨居士，沉浮楚越间。\n高怀渺云海，健句压江山。\n岁晚还家乐，生平满意閒。\n合存耆旧传，百世表乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方躬明运使 其一","author":"孙应时","text":"少学真山立，中年久陆沉。\n斗牛光淡荡，湖海气雄深。\n晚节储边策，平生许国心。\n呜呼死诸葛，松柏坐萧森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王季海丞相 其三","author":"孙应时","text":"旧托通家子，容干相国尊。\n身犹安燕幕，心每系龙门。\n赤舄三年去，清朝百度存。\n灊峰天柱折，一恸岂私恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王季海丞相 其一","author":"孙应时","text":"圣世持盈计，慈皇阅士多。\n十年深注倚，一德妙中和。\n日月长循轨，边疆竟息戈。\n到今清净化，彷佛汉民歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王知复书监 其一","author":"孙应时","text":"五世衣冠盛，吾乡识故家。\n渥洼驹有种，和氏璧无瑕。\n了县真谈笑，还朝看咄嗟。\n天乎那可料，丹旐出京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王知复书监 其二","author":"孙应时","text":"飞桥壮吾邑，虹影丽高深。\n义不烦千室，功无措万金。\n美哉承考意，伟矣济时心。\n此段无穷尽，江声共古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王知复书监 其三","author":"孙应时","text":"公子三槐族，贫交五柳门。\n乡闾虽不数，书劄屡相温。\n前辈风流远，时情势利尊。\n哀哀埋玉树，此意复谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叶无咎 其一","author":"孙应时","text":"诗酒平生事，风流六十翁。\n词人寻郑老，坐客爱车公。\n已惜漳滨卧，那堪冀北空。\n交情不论晚，为子泣西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叶无咎 其二","author":"孙应时","text":"偃室多宾