46,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴给事芾 其一","author":"孙应时","text":"人物中兴后，猗公一世雄。\n虹蜺辉霁景，山岳镇颓风。\n用舍关轻重，声名擅始终。\n堂堂今日尽，海宇尽哀恫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽应宣义","author":"孙应时","text":"书史平生好，山林岁晚心。\n逸才逢世偶，清誉服人深。\n有子能攀桂，传家匪遗金。\n佳城合双剑，松柏旧萧森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李中甫使君 其二","author":"孙应时","text":"圭玉身无玷，春风物自熙。\n学非随俗尚，心故有天知。\n里社成邹鲁，交游不惠夷。\n思君兼众美，凋落使人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李中甫使君 其一","author":"孙应时","text":"赫赫中兴佐，英风想大门。\n得交人物懿，喜见典刑存。\n拱立严诸父，躬行表后昆。\n世家今万石，一代合推尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽沈云夫","author":"孙应时","text":"我昔垂髫日，君来学雪斋。\n宁知重骨肉，借作老生涯。\n喜剧相过密，惊吁一病乖。\n平生此长别，雨泪独伤怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽沈叔晦国录 其三","author":"孙应时","text":"请益从公久，忘年爱我深。\n龙阿星斗气，梅竹雪霜心。\n回首南湖侣，伤怀流水音。\n九原那可作，千里坐悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e