[{"title":"化成岩","author":"李观","text":"交臂寻幽岁已残，瘦藤枯石重跻攀。\n忽逢阴洞龙开室，下瞰寒溪玉绕山。\n猿鸟窥帘如旧识，藤萝引径入蹊閒。\n游人自向红尘去，日莫老僧催闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李观","text":"养拙藏愚春复春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"覆验馀姚道中","author":"王存","text":"一夫死非命，涤验更两吏。\n一囚坐法诛，三覆与众弃。\n去年交阯败，杀戮无贱贵。\n江淮屡岁眚，积殍沟壑秽。\n圣人于赤子，爱重若彼至。\n谨小以遗大，谁其原帝意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"王存","text":"集仙词职琐闱郎，曾领共工使出疆。\n万里初还辽海节，一麾俄绾会稽章。\n金环赐带饶新贵，熊轼褰帷过故乡。\n政事有馀诗笔健，卧龙山直鉴湖光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子陵钓台","author":"王存","text":"严公英魄去何之，江上空馀旧钓矶。\n古木苍烟鸲鹆噪，清波白石鹭鸶飞。\n山中秋色香粳熟，垄下朝寒赤鲤肥。\n何事夷齐耻周粟，一生憔悴首阳薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史院席上奉和首相吴公原韵","author":"王存","text":"上圣思论著，前言摭绪馀。\n琼筵初赐醴，石室载紬书。\n徽范贻来者，成功念昔欤。\n欲知开局盛，门拥相君车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刁景纯归京口","author":"王存","text":"因公东还辄悲咤，重厚士风须长者。\n少年流辈轻老人，去矣唐山旧林下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登北固山","author":"王存","text":"晚登北固顶，俛视南徐城。\n废垒何茫茫，山川迥纵横。\n千载竞谁有，六朝空战争。\n豪气不可问，古坟人正耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游焦山","author":"王存","text":"连山拥沧江，峭绝视兹鲜。\n由来一气结，殊不丽众巘。\n林深鸟声悦，境静人自远。\n方吾抱幽介，对此万虑遣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静照堂","author":"王存","text":"曾过槜李古禅关，十五年来梦想閒。\n闻说新堂增胜概，又怜游客变衰颜。\n香檀印篆销晨暮，题墨笼纱记往还。\n能了一心随处静，何须辛苦远人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过丹阳旧居","author":"王存","text":"漂泊经故园，系舟款柴扉。\n破屋他人居，昔邻今或非。\n父老迎我饮，祝我昼锦衣。\n我谢父老言，朴拙非所祈。\n一官走尘土，实迫寒与饥。\n去乡未几载，颇觉侣俦稀。\n人事已可嗟，况当白首归。\n泚泚练塘水，绿杨荫渔矶。\n有田尚可耕，誓将父老依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归京口","author":"王存","text":"倦宦归来故国春，北楼千尺绝飞尘。\n江山雄伟增人气，城壁萧条类此身。\n眼底交游随物老，樽前歌舞逐时新。\n十年旧事无人问，目送斜阳下广津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"却客致假山石","author":"王存","text":"乞得林官就道閒，诛茅结宇即成湾。\n闭门自有林峦秀，不用辛勤作假山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"王存","text":"病鸾方振翼，饥隼乍离韝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王存","text":"珠鞯锡御恩犹在，玉辇亲扶事已空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"王存","text":"二载京岘居，过从不获屡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"王存","text":"族居自买百閒屋，月赐官糜六万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踞湖山六题 其一 踞湖山","author":"马云","text":"山临太湖上，寺隐青萝间。\n五坞洞壑邃，众峰屏障环。\n浓岚面光彩，惊波背潺湲。\n云归定僧寂，月伴樵夫还。\n林墅掩蒙密，级磴容跻攀。\n钱氏建圭社，此地为家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踞湖山六题 其二 芳桂坞","author":"马云","text":"森森芳桂树，团团削青玉。\n春花飞涧户，秋实坠岩曲。\n霜条封翠紫，风叶摇香绿。\n下有幽栖人，结芳避世俗。\n学仙读丹经，好道探药箓。\n植根满群峰，不使樵夫触。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踞湖山六题 其三 飞泉坞","author":"马云","text":"高崖落飞泉，深源味冷冽。\n云津留玉乳，石髓澄金屑。\n淙淙危磴响，滴滴苍藓缺。\n溅沫洒明珠，满涧融寒雪。\n岩夫就漱饮，姬子临浣洁。\n不独愈痼疾，自可清内热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踞湖山六题 其四 修竹坞","author":"马云","text":"檀栾遍岩川，幽谷气象鲜。\n风玉自宫徵，秋籁成管弦。\n夕霭起碧雾，晨曦生绿烟。\n花繁紫凤饱，质劲苍虬挛。\n藤萝交密荫，仰不见云天。\n欲访桃源路，坞坞疑相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踞湖山六题 其五 丹霞坞","author":"马云","text":"东涧岩谷秀，粲然金碧丽。\n亘野丹气明，向曙霏烟霁。\n磴泻红玉泉，林纡赤凤髻。\n日出诸峰上，月皎半天际。\n幽谷纾绛缯，层崖荣锦罽。\n羡此山居人，萧然远尘世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踞湖山六题 其六 白云坞","author":"马云","text":"君寻白云坞，最近林涧西。\n永日抱幽石，因风度清溪。\n炎随夏景变，凉高秋气凄。\n素霭生巘崿，练光带虹霓。\n润泽施天下，还返故山栖。\n深惟贤士志，出处可与齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访踞湖山人仇君隐居","author":"马云","text":"鸡犬眠云白日空，暮春花木满川红。\n茶瓯香沸松林火，药杵声清石涧风。\n玉帛未闻招处士，神仙今喜识台翁。\n夕阳半局残棋在，醉倚岩边紫桂丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重建羊侯祠和王原叔句","author":"马云","text":"汉水舒舒山崇崇，岧然岘首称清雄。\n南方强吴恃割据，选命儒将登元戎。\n太康以来千馀载，荆州遗爱思羊公。\n江山襟带号形胜，藉此因成辅晋功。\n公谓高贤事迹异，视之闲暇无匆匆。\n测知当日登临意，景物亦与今朝同。\n新就峰巅作亭舍，面势豁若凌烟虹。\n苍苍云木望不尽，浩荡古意深何穷。\n盘回小径至钓石，俯视凝碧相连通。\n丛篁森束林蓊郁，又从其下兴祠宫。\n迅湍急濑鸣湱湱，浓岚翠霭霏濛濛。\n晦晴气象随变易，朝昏万状殊初终。\n阁老分符二千石，旟竿刻隼车画熊。\n管内民租绝逋负，里社歌鼓欢年丰。\n府门昼扃官事退，时引宾佐嬉其中。\n崖条岭蔓杂丹白，涧花满眼罗青红。\n磴道迤逦陟萦屈，飘若巾屦腾秋空。\n岂独游观乐闲燕，图树佳政希前风。\n经由粗得究本末，强颜模写惭非工。\n音辞鄙俚虽一唱，下词寒苦无怡融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登仙奕山","author":"卢侗","text":"畏对青山老一秋，逢春又向碧岩游。\n凭空为问蓬莱客，何物能消万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西龙潭","author":"方子容","text":"风云未借且潜藏，峰上谁欤起道场。\n禅子坐听金竺语，老人拜献玉函方。\n法轮广大乾坤转，岩洞幽深日月长。\n千古不愁为佛护，夜潭勤礼玉毫光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕循守周彦质过苏东坡白鹤新居和东坡韵","author":"方子容","text":"豹隐南山鹤在阴，浮罗一望白云深。\n巧工且缩居旁手，烈士谁知负壮心。\n嗟我抗尘仍走路，羡君叩寂且求音。\n如何东岭神仙境，肯约衰翁数访临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再访东坡用前韵","author":"方子容","text":"东岭新成桃李阴，春光日日向人深。\n遥瞻广厦惊凡目，自是中台巧运心。\n轮奂欲形张老颂，调歌先听伯牙音。\n料公不负南堂约，应许衰翁领客临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其一","author":"吴处厚","text":"慎言浑不畏，言出患常随。\n须信机枢发，难容驷马追。\n三缄事可见，两舌业当知。\n口是起羞本，愿君且再思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其二","author":"吴处厚","text":"忍事有何妨，勿令心火扬。\n火扬犹可灭，心忿固多伤。\n堪叹波罗蜜，可怜歌利王。\n从心更从刃，字意好端详。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其三","author":"吴处厚","text":"国法须遵守，金科尽诏条。\n一毫如有犯，三尺不相饶。\n岂肯容奸黠，何须恃贵骄。\n自然逢吉庆，神理亦昭昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其四","author":"吴处厚","text":"人非莫举扬，万事且包荒。\n殿上便犹掩，车中吐不妨。\n在他诚所短，于己有何长。\n须是常规检，回头自忖量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其五","author":"吴处厚","text":"无私仍克己，克己又无私。\n一事兼修饰，终身在省思。\n公清多敛怨，高亢易招危。\n更切循卑退，方应履坦夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其六","author":"吴处厚","text":"直道更和光，双修誉乃彰。\n直须和辅助，和赖直交相。\n恃直终多讦，偏和又少刚。\n能和又能直，行己自芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其七","author":"吴处厚","text":"此个如端的，除非六句修。\n永为几杖诫，更遗子孙谋。\n本立方生道，农勤乃有秋。\n兹诗虽浅近，至理可推求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏警戒 其八","author":"吴处厚","text":"天应降吉祥，天理本茫茫。\n舒惨虽无定，荣枯却有常。\n益谦尤效验，福善更昭彰。\n笼络无疏漏，恢恢网四张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏王安国","author":"吴处厚","text":"飞卿昔号温钟夔，思道通俛还魁肥。\n江淹善啖笔五色，庾信能文腰十围。\n只知外貌乏粉泽，谁料满腹填珠玑。\n相逢把酒洛阳社，不管淋漓身上衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈一首","author":"吴处厚","text":"是身如泡幻，尽非真实相。\n况兹纸上影，妄外更生妄。\n到岸不须船，无风休起浪。\n唯当清静观，妙法了无象。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游沃洲山真封院","author":"吴处厚","text":"幼年曾读乐天碑，及壮亦览高僧传。\n闻有沃洲风景佳，脚未能到心空羡。\n近至新昌披县图，此山乃在吾厩圈。\n想像时时挂梦魂，欲一游之念无便。\n夜来人报天姥雪，今日趁晴初出县。\n酸风瞥瞥吹我须，寒气棱棱刮人面。\n半膝短衫翻以轻，独脚小轿快而健。\n不知路入幽涧长，但觉山随白云转。\n靠昏投宿梅林村，侵卯便过真封院。\n新霜滑澾行李难，一步一拄一回眩。\n养马坡前秋草黄，骏骨已埋无复见。\n放鹤峰头树影孤，鹤不来归云漫漫。\n入门触物皆荒凉，尘几蠹经三五卷。\n饿鸦叫噪绕生台，野雀毰毸集寒殿。\n老杉千尺惟空腔，犹有枯藤半萦缠。\n忆昔江左全盛时，十有八人皆俊彦。\n或吟或啸或遨嬉，不觉回头垂缨弁。\n林泉耽味久成癖，鱼鸟留连老忘倦。\n前有道猷后法潜，锡杖卓泉坚志愿。\n晚则道林经构之，左右前后遂完缮。\n烟霞一窟直几钱，买醭商量价何贱。\n聚徒数百日高谈，供有香花斋有面。\n岁时浸久山浸荒，种粟烧畬耕掘遍。\n茂林髡?无几存，莽荡周回空一片。\n惟馀溪水清汪湾，百匹秋光泻寒练。\n古今兴废尽如斯，欲去使人还恋恋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游五泄山","author":"吴处厚","text":"烟霞一坞两山源，石壁寒垂瀑布泉。\n人事是非空缭绕，水声今古自潺湲。\n月留吟客眠寒榻，风送樵翁下翠巅。\n檀篆未消炉火燠，夜长人静好谈禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题云门山雍熙院","author":"吴处厚","text":"三寺峙若鼎，四山合如环。\n偷携野人杖，默叩禅翁关。\n草树冬不老，云烟秋更闲。\n飘飘物外兴，又逐归禽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王正叔㶏景亭","author":"吴处厚","text":"乱莺啼处柳飞花，拍拍春流涨晓沙。\n正是江南梅子熟，年年离恨寄天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉京洞","author":"吴处厚","text":"秉烛携筇步步前，玉京迢递访神仙。\n四时自有壶中景，一罅都迷物外天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郎官湖","author":"吴处厚","text":"郎官湖上郎官游，只教闲客生闲愁。\n烟波荡漾四五顷，风月凄凉三百秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋兴亭怀古","author":"吴处厚","text":"汉沔当年控上游，孙权曾此困曹刘。\n三分霸业千张纸，万古斜阳一钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"吴处厚","text":"会景亭高石作层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"吴处厚","text":"江汉滔滔一向东，暮江澄湛夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"吴处厚","text":"云共去时天杳杳，雁连来处水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游峨杂咏 其一","author":"白约","text":"祥光非实相，灵异只虚誇。\n岩静长留雪，山寒故放花。\n云川千万里，灯火两三家。\n荷筱人何处，悠悠步落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游峨杂咏 其二","author":"白约","text":"树倒因成路，林开忽见村。\n鸟音传木杪，梵语出云根。\n雪色连春夏，风声接晓昏。\n徘徊幽兴极，回首谢烦喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游峨杂咏 其三","author":"白约","text":"文公太华游，惆怅无与共。\n翁从二三子，泉石恣披弄。\n草木被芳鲜，山岩落飞动。\n朝市足纷华，不入幽人梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏虎山房","author":"白约","text":"入眼林峦皆可意，不惮间关千里至。\n白云随步入危梯，前时想像今真是。\n千岩万壑诚瑰杰，小草微花亦精致。\n更随虎迹访幽深，恐有秦人来避地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘","author":"蒲宗孟","text":"长松绕步水湾环，寺据吴王冢墓间。\n瘦石千层开碧玉，疏围十里裹青山。\n壁从地上崭岩起，云出门前自在閒。\n零落生公讲台下，无人说法但空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎丘因书钱塘旧游","author":"蒲宗孟","text":"失却湖山恨去舟，新年无意作春游。\n东风昨夜思龙井，晓雨全家入虎丘。\n望见远峰疑石巷，误寻归路认花楼。\n明朝一出阊门去，清梦遥知在两州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦屏山","author":"蒲宗孟","text":"碧江寒浸锦屏山，寺古山灵树石閒。\n水色照人清见胆，岚光著雾翠成斑。\n自从旧句曾关念，纵有新诗总厚颜。\n今日断弦应再续，一时传诵在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其一","author":"蒲宗孟","text":"岁除三十日，收得武昌书。\n一纸方远寄，数篇来起予。\n潇湘流水阔，巫峡暮云疏。\n不得相从去，春风正月初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其二","author":"蒲宗孟","text":"想到零陵日，高歌足解颜。\n乡闾接营道，风物近庐山。\n万石今兴废，三亭谁往还。\n不知零与永，二郡孰安閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其三","author":"蒲宗孟","text":"三月春才过，君当始到官。\n朱袍烂红日，白发未盈冠。\n喜静心长在，耽诗性最欢。\n应从下车始，便起作题端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其四","author":"蒲宗孟","text":"始彼南康责，谁知睿泽宽。\n还为半刺史，不失古虞官。\n别乘今谁厚，朱轓旧最欢。\n遥怜春色好，并盖纵游鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其五","author":"蒲宗孟","text":"地与江淮近，乡人慰久暌。\n重看斑竹泪，还听鹧鸪啼。\n湘水晴波远，苍梧霁色低。\n不知春日静，何似在濂溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其六","author":"蒲宗孟","text":"二子君家宝，知渠神骨清。\n初生俱嶷嶷，学语便铿铿。\n凤老雏方秀，珠圆蚌转明。\n吾甥真宅相，可得不翘英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其七","author":"蒲宗孟","text":"山水平生好，尝来说退居。\n无家归绂冕，有子侍篮舆。\n湓浦方营业，濂溪旋结庐。\n零陵官俸剩，应得更添书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳岁除日收周茂叔虞曹武昌惠书知已赴官零陵丙午正月内成十诗奉寄 其八","author":"蒲宗孟","text":"八郡湖南使，棱棱尽有名。\n刑台本乡旧，漕府忝门生。\n吾戚饶风力，伊人最直清。\n预知相见日，倾盖便投城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]