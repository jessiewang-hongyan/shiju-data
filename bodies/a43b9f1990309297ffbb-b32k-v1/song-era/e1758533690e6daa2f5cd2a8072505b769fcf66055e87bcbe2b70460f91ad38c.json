[{"title":"食莲子三首 其三","author":"杨万里","text":"戢戢蜂儿出露房，未生翅股及锋芒。\n丁宁莫遣它人剥，要染侬家十指香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食莲子三首 其二","author":"杨万里","text":"城中莲子买将归，未问尝新早与迟。\n偶忆涌金门外晓，画船带露摘来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食莲子三首 其一","author":"杨万里","text":"白玉蜂儿绿玉房，蜂房未绽已闻香。\n蜂儿解醒诗人醉，一嚼清冰一咽霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食蛎房","author":"杨万里","text":"蓬山侧畔屹蚝山，怀玉深藏万壑间。\n也被酒徒勾引著，荐它尊俎解它颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸦","author":"杨万里","text":"稚子相看只笑渠，老夫亦复小卢胡。\n一鸦飞立钩栏角，子细看来还有须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日绝句","author":"杨万里","text":"不但春妍夏亦佳，随缘花草是生涯。\n鹿葱解插纤长柄，金凤仍开最小花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏月频雨","author":"杨万里","text":"一番暑雨一番凉，真个令人爱日长。\n隔水风来知有意，为吹十里稻花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏至后初暑登连天观","author":"杨万里","text":"登台长早下台迟，移遍胡床无处移。\n不是清凉罢挥扇，自缘手倦歇些时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏至雨霁与陈履常暮行溪上二首 其二","author":"杨万里","text":"夕凉恰恰好溪行，暮色催人底急生。\n半路蛙声迎步止，一荧松火隔篱明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏至雨霁与陈履常暮行溪上二首 其一","author":"杨万里","text":"西山已暗隔金钲，犹照东山一抹明。\n片子时间弄山色，乍黄乍紫忽全青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜追凉","author":"杨万里","text":"夜热依然午热同，开门小立月明中。\n竹深树密虫鸣处，时有微凉不是风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悯农","author":"杨万里","text":"稻云不雨不多黄，荞麦空花早著霜。\n已分忍饥度残岁，更堪岁里闰添长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"料理小荷池","author":"杨万里","text":"侧塞浮荷更泛苔，为芟数路水痕开。\n鱼儿便喜新开港，绕去绕来千百回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓入秘书省过三桥","author":"杨万里","text":"船底吴侬尚晏眠，一船炊饭数船烟。\n行人各自东西岸，抵死回头看两边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上看山","author":"苏轼","text":"船上看山如走马，倏忽过去数百群。\n前山槎牙忽变态，后岭杂沓如惊奔。\n仰看微径斜缭绕，上有行人高缥缈。\n舟中举手欲与言，孤帆南去如飞鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓出净慈送林子方二首 其一","author":"杨万里","text":"出得西湖月尚残，荷花荡里柳行间。\n红香世界清凉国，行了南山却北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓出兜率寺送许耀卿二首 其二","author":"杨万里","text":"兜率山深露气清，柳阴暗处藕花明。\n无端拾得闲烦恼，背却西湖又入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓出兜率寺送许耀卿二首 其一","author":"杨万里","text":"天竺兴云线许长，须臾遮尽众苍苍。\n何如洒作千峰雨，乞与都城六月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓发黄巢矶芭蕉林中","author":"杨万里","text":"清远山前烟雨濛，黄巢矶畔水连空。\n旋芟芦荻炊朝饭，更斫芭蕉补漏篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓行闻竹鸡二首 其二","author":"杨万里","text":"一番行路一番愁，还自儿时到白头。\n路不唤君君自去，为谁著急不归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓行闻竹鸡二首 其一","author":"杨万里","text":"山行三日厌泥行，幸自今晨得一晴。\n又听数声泥滑滑，情知浪语也心惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓行道旁杜鹃花","author":"杨万里","text":"泣露啼红作么生，开时偏值杜鹃声。\n杜鹃口血能多少，不是征人泪滴成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过丹阳县五首 其五","author":"杨万里","text":"水从常润路都迷，曲曲长河曲曲堤。\n不是两窗供日脚，更无南北与东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过丹阳县五首 其四","author":"杨万里","text":"鸡犬渔翁共一船，生涯都在箬篷间。\n小儿不耐初长日，自织筠篮胜打闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过丹阳县五首 其三","author":"杨万里","text":"朱檐碧瓦照青澜，洁馆佳亭使往还。\n船上高桥三十尺，市人倚折石栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过丹阳县五首 其二","author":"杨万里","text":"风从船里出船前，涨起帘帏紫拂天。\n点检风来无处觅，破窗一隙小于钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过丹阳县五首 其一","author":"杨万里","text":"朝来稍敢出船门，霜熟依然冷逼人。\n刮地风来何处避，可怜岸筱猛回身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过石门回望净慧塔","author":"杨万里","text":"昨晚匆匆解画船，石门未到已黄昏。\n殷勤净慧烟中塔，送我今朝过石门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过花桥入宣州界四首 其四","author":"杨万里","text":"不是青山是画图，南山瘦削北敷腴。\n两山名姓君知么，一字玄晖一圣俞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过花桥入宣州界四首 其三","author":"杨万里","text":"近山浅绿远深青，两样风姿一样清。\n似怨朝阳卷云雾，被侬看著太分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过花桥入宣州界四首 其二","author":"杨万里","text":"敬亭宛水故依然，叠嶂双溪阿那边。\n谢守不生梅老死，倩谁海内掌风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过花桥入宣州界四首 其一","author":"杨万里","text":"路入宣城山便奇，苍虬活走绿鸾飞。\n诗人眼毒已先见，却旋褰云作翠帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓坐","author":"杨万里","text":"拂晓文书已罢休，却披诗卷散闲愁。\n只惊两眼生光彩，日到东窗半角头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓坐多稼亭","author":"杨万里","text":"日光烘碎一天云，散作濛濛雾满村。\n我亦知渠别无事，不教远岫翠当门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓坐卧治斋","author":"杨万里","text":"夜风甚细不胜酸，霜落无声只是寒。\n日上东窗无个事，送将梅影索人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓坐荷桥四首 其四","author":"杨万里","text":"帘影窥池到藕根，水光为我弄朝暾。\n鱼儿解作晴天雨，波面吹成落点痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓坐荷桥四首 其二","author":"杨万里","text":"四叶青蘋点绿池，千重翠盖护红衣。\n蜻蜓空里元无见，只见波间仰面飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓坐荷桥四首 其三","author":"杨万里","text":"碧玉山边白鸟鸣，绿杨风里翠荷声。\n草花踏碎教人惜，为勒芒鞋款款行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓坐荷桥四首 其一","author":"杨万里","text":"雨后晨前绝爽时，胡床四面是荷池。\n荷珠细走惟愁落，为报薰风莫急吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓炊黄竹庄三首 其三","author":"杨万里","text":"城中殊未有梅看，莫是冬暄欠浅寒。\n行到深山最寒处，两株香雪照冰滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓炊黄竹庄三首 其二","author":"杨万里","text":"琯灰蔌蔌欲飞声，日到牵牛第几星。\n地底阳生人不觉，烧痕未冷已青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓炊黄竹庄三首 其一","author":"杨万里","text":"染练江山宿雨馀，枝枝叶叶润如酥。\n丝窠璎珞消多少，破费天公百斛珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓起探梅四首 其四","author":"杨万里","text":"江梅小树打头开，便有红梅趁脚来。\n趱得杏红开火急，春风已落第三回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓起探梅四首 其三","author":"杨万里","text":"一祖南枝派五房，红黄萼绿蜡鸳鸯。\n杏红千叶元无种，谁子翻腾个样妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓起探梅四首 其二","author":"杨万里","text":"打并人间名利心，万山佳处一溪深。\n仙家忍饿禅家苦，老子梅边政醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓起探梅四首 其一","author":"杨万里","text":"一生劫劫只长涂，投老山林始定居。\n梦破灯青窗欲白，犹疑雪店听鸡初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓穿芙蓉径二首 其二","author":"杨万里","text":"芙蓉佳处不胜佳，花不中藏祗外斜。\n恰似曲江闻喜宴，绿衣半醉戴宫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓穿芙蓉径二首 其一","author":"杨万里","text":"晚妆懒困晓妆新，火急来看趁绝晨。\n夹径花枝欺我老，竞将红露洒乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓寒二首 其二","author":"杨万里","text":"春光唤入百花丛，寒力平欺两鬓蓬。\n吹乱众红还复整，海棠却不怕东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓寒二首 其一","author":"杨万里","text":"黯黯轻寒淡淡阴，游人便觉减行春。\n春风也解嫌萧索，自送鞦韆不要人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴发芜湖县吴波亭二首 其二","author":"杨万里","text":"雨来初做养禾天，雨久还成害稼年。\n今日一晴无准在，金鸦飞出卯牌前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴发芜湖县吴波亭二首 其一","author":"杨万里","text":"八日川涂九雨风，船中出得入泥中。\n老夫强项谁能那，雨止风休伎自穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓登多稼亭三首 其三","author":"杨万里","text":"尚无池水泛荷香，幸有园英照竹窗。\n雪白葵花持玉节，柿红萱草立金幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓登多稼亭三首 其二","author":"杨万里","text":"雨前田亩不胜荒，雨后农家特地忙。\n一眼平畴三十里，际天白水立青秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓登多稼亭三首 其一","author":"杨万里","text":"过雨梅无半个黄，冬青枝上雪花香。\n不须更要风吹面，看著青林意自凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓雾","author":"杨万里","text":"不知香务湿人须，日照须端细有珠。\n政是春山眉样翠，被渠淡粉作糊涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓霜过宝应县三首 其三","author":"杨万里","text":"落木枯林一夜苏，枝枝节节糁琼酥。\n看来忘却腊前景，一色李花三月初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓霜过宝应县三首 其二","author":"杨万里","text":"看来不信是霜华，白日青天散晓霞。\n只怪野田生玉树，更于腊月发琼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓霜过宝应县三首 其一","author":"杨万里","text":"江南霜重莫嫌渠，草上还多树上无。\n淮甸晓来霜似雪，琼田千里玉平铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栟楮江滨芙蓉一株发红白二色二首 其二","author":"杨万里","text":"司花手法我能知，说破当知未大奇。\n乱剪素罗装一树，略将数朵蘸燕支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栟楮江滨芙蓉一株发红白二色二首 其一","author":"杨万里","text":"芙蓉照水弄娇斜，白白红红各一家。\n近日司花出新巧，一枝能著两般花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂源铺","author":"杨万里","text":"万山不许一溪奔，拦得溪声日夜喧。\n到得前头山脚尽，堂堂溪水出前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐道中","author":"杨万里","text":"肩舆坐睡茶力短，野堠无文山路长。\n鸦鹊声欢人不会，枇杷一树十分黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其八","author":"杨万里","text":"山根一径抱溪斜，片地才宽便数家。\n漫插漫成堤上柳，半开半落路旁花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其七","author":"杨万里","text":"晴明风日雨乾时，草满花堤水满溪。\n童子柳阴眠正著，一牛吃过柳阴西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其六","author":"杨万里","text":"蚕麰今岁十分强，催得农家日夜忙。\n已缚桁竿等新麦，更将丫木撑欹桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其五","author":"杨万里","text":"秧畴夹岸隔深溪，东水何缘到得西。\n溪面祗销横一枧，水从空里过如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其四","author":"杨万里","text":"下山入屋上山锄，图得生涯总近居。\n桑眼未开先著椹，麦胎才茁便生须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其三","author":"杨万里","text":"沙鸥数个点山腰，一足如钩一足翘。\n乃是山农垦斜崦，倚锄无力政无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其二","author":"杨万里","text":"田塍莫笑细于椽，便是桑园与菜园。\n岭脚置锥留结屋，尽驱柿栗上山颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑茶坑道中八首 其一","author":"杨万里","text":"两边山束一溪风，尽日行程在井中。\n犹喜天围能里许，井中那得个宽通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑畴","author":"杨万里","text":"夹岸濒河种稚桑，春风吹出万条长。\n船行老眼浑多忘，唤作西湖插拒霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桧径晓步二首 其一","author":"杨万里","text":"老桧阴阴夹古城，露丛迎贯日华明。\n晓凉无个人分却，一径深长独自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桧径晓步二首 其二","author":"杨万里","text":"雨歇林间凉自生，风穿径里晓逾清。\n意行偶到无人处，惊起山禽我亦惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海岸七里沙二首 其二","author":"杨万里","text":"行人莫近岸边行，便恐波头打倒人。\n若道岸高波不到，玉沙犹湿万痕新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海岸七里沙二首 其一","author":"杨万里","text":"大风吹起翠瑶山，近岸还成白雪团。\n一浪搀先千浪怒，打崖裂石与君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛下梅花二首 其二","author":"杨万里","text":"窗外雪犹冻，瓶中梅不开。\n烛花将暖气，催得早春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛下梅花二首 其一","author":"杨万里","text":"烛下一枝梅，欲开犹未开。\n浑如玉冠子，戴月上琼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]