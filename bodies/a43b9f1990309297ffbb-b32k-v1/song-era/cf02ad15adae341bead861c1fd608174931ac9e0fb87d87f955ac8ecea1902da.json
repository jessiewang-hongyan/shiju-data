[{"title":"赠李公","author":"吕端","text":"忆昔僦居明德坊，官资俱是校书郎。\n青衫共直昭文馆，白首同登政事堂。\n佐国庙谟君已展，避贤荣路我犹妨。\n主恩至重何时报，老眼相看泪两行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吕端","text":"愚臣钩直难堪用，宜用濠梁结网人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠蛟 其一","author":"吕奫","text":"远岫参横滃白云，一声雷震出天门。\n恍然身在龙头上，笑引庄生五石樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠蛟 其二","author":"吕奫","text":"我读坡诗醉眼开，翠蛟骑取借风雷。\n直教大地沾霖雨，变作清凉不快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题 其一","author":"吕奫","text":"泠然风御远光尘，轩豁嵯峨插碧云。\n空洞元来无一物，惟留飞鼠自成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吕辨","text":"仰看宫殿浮天半，想见笙箫在月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"威惠庙","author":"吕璹","text":"当年平贼立殊勋，时不旌贤事忍闻。\n唐史无人修列传，漳江有庙祀将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题武夷","author":"孙士廉","text":"翠岩九曲老仙家，玉女峰头炼紫霞。\n幻海无人来跨鹤，天河有路可乘槎。\n春云细酿幔亭酒，夜雨初煎石鼎茶。\n久矣樵渔怀此志，吹箫闲看碧桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊吴江寄僧","author":"孙大雅","text":"松陵桥畔太湖前，斜日青枫系客船。\n引颈数看花鸭乱，含情深愧白鸥贤。\n千镫庾岭传无尽，一宿曹溪觉有缘。\n稍待月明风细细，卧吹箫管学坡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴皮题壁 其二","author":"孙子光","text":"天地之间犹有碍，江山酌酒尚无馀。\n长裘短褐经行处，惟见龙蛇壁上书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴皮题壁 其一","author":"孙子光","text":"黄鹤楼中吹笛罢，洞庭湖畔醉吟馀。\n剑光如宝无人识，却记榴皮几字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春游东山石洞","author":"孙子秀","text":"穹石丹崖出，攒峰万壑回。\n古苔阴洞寂，新雨绿波开。\n渡绝移丛筱，飞春泛落梅。\n东山有夙尚，且尽手中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游丹山","author":"孙子秀","text":"四明洞天居第九，巨灵擘石开窗牖。\n扪萝陟巘不惮劳，同行况遇忘年友。\n老苔护石苍虎闲，飞瀑悬岩玉龙吼。\n豁然人与境俱胜，醉歌拍缶忘升斗。\n固知壶中别有天，未必醉翁真在酒。\n徘徊步月澹忘归，世事浮云竟何有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"孙子进","text":"酒禄嗟予薄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"孙子肃","text":"揖仙亭上观秋涨，坐我吴江云水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑州","author":"无名氏","text":"南北更无三座寺，东西只有一条街。\n四时八节无筵席，半夜三更有界牌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"孙山","text":"分开秋水国，映断夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"无名氏","text":"土洞里头行十日，山棚上面住三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"孙山","text":"幸赖圣恩收拾了，这回含笑入黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"无名氏","text":"鸡足斜分三道水，蛇腰慢转一条街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"孙山","text":"解名尽处是孙山，君名更在孙山外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"孙山","text":"结宇孤峰上，安禅巨浪间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"无名氏","text":"沙堆套里三条路，石炭烟中两座城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"无名氏","text":"宪州浑如枉死市，岢岚彷佛似阳间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"孙山","text":"盘古榜中同进士，伏羲手里探花郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新秋","author":"孙仅","text":"火云犹未敛奇峰，攲枕初惊一叶风。\n几处园林萧瑟里，谁家砧杵寂寥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙泉","author":"孙仅","text":"孤城深锁乱云间，城上云开面面山。\n负郭惠泉谁共访，卫公诗碣绿苔班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步虚台","author":"孙仅","text":"抱怀宁独固难穷，自与山林逸兴同。\n白马岂能分辨客，青牛还会识仙翁。\n凝神宅古河声里，望气台荒野色中。\n试上高原长一啸，断蓬衰草掩秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"孙仅","text":"閒如云鹤散如仙，逸士声名处处传。\n诗自会来轻物象，道从高后小林泉。\n谋身只置煎茶鼎，积货惟收卖药钱。\n见说新居更幽僻，为忧徵诏到门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勘书","author":"孙仅","text":"儒家无外事，招客勘青编。\n笔墨东西置，朱黄次第研。\n频忧伤点窜，细恐误流传。\n改易文辞正，增加字数全。\n目因繁处倦，心向注中专。\n端坐穷今古，披襟见圣贤。\n疲劳时举白，游息或谈玄。\n得兴忘昏旭，题名记岁年。\n栖毫思确论，废卷恨忘篇。\n鱼鲁皆刊定，谁人敢间然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠种徵君放","author":"孙仅","text":"雄文英概比君难，二十高名满世间。\n飞诏几回来北阙，草玄终不出南山。\n诗篇落处风雷动，笔力停时造化闲。\n仙术每将丹诀解，史才曾把逸书删。\n家僮只有猿随从，坐客唯闻鹤往还。\n两制词臣求识面，九重天子望祇颜。\n处士星孤轻世俗，大夫松好贱官班。\n棋残夜石秦云断，琴彻秋岩蜀月弯。\n朝议蒲轮看再降，肯教从此老柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题潜山","author":"孙仅","text":"势参吴楚分，作镇向同安。\n地胜尘寰隔，天深洞府宽。\n位将衡岳敌，根与霍山盘。\n尘见千年白，霞生万仞丹。\n崖秋争峭拔，峰霁间巑岏。\n日转香炉煖，风生玉照寒。\n石栖平郡堞，天柱倚云端。\n绝顶人游少，高空鸟度难。\n风雷生别壑，星斗绕层峦。\n寒暑岩间异，方隅岭际观。\n为霖同海内，倒影压平阡。\n砂印猿踪迹，池飘鹤羽翰。\n烟萝交密荫，瀑布落飞湍。\n磴道莓苔滑，松根霹雳乾。\n石奇疑虎伏，湫险认龙蟠。\n胜好当春赏，幽宜带雪看。\n气蒸茶蕊嫩，香老菊花残。\n青擢凌霄干，红垂受露兰。\n禅邻祖师塔，仙接左慈坛。\n几客歌维岳，何人咏考槃。\n元宗曾立庙，武帝亦鸣鸾。\n圣代从何极，灵祠辑未阑。\n青词驰长吏，法服降中官。\n千古图经里，高名定不刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"孙仅","text":"朱衣吏引上骊山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"孙仅","text":"僧寺聚观刊石处，人家传写挂牌时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"孙仅","text":"刑人一旦起幽深，功业煌煌照古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"孙仅","text":"江路北来通汉水，土风南去接荆蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"孙仅","text":"转战风骚如甲胄，平分才学过权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"孙仅","text":"庭梧影薄晨霜落，篱菊香寒晚吹生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"孙仅","text":"汾水冷光摇画戟，蒙山秋色锁层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"孙仅","text":"巴陵山水冠南中，送陈生归岳州诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"孙仅","text":"秦帝墓成陈胜起，明皇宫就禄山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙戊戌在家聚徒期以秋冬随子赴任作诗二绝示诸生 其一","author":"孙介","text":"为学须当及少年，莫言愚智尽由天。\n青春若不勤耕种，秋熟徒嗟有废田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙戊戌在家聚徒期以秋冬随子赴任作诗二绝示诸生 其二","author":"孙介","text":"此去相从有半年，分携恐在暮秋天。\n若能早夜思精进，他日生涯胜买田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙巳冬十月随幼男赴海陵丞中途遇交代有开正视事之请既抵官舍有作","author":"孙介","text":"整棹姚江到海陵，稽徊四十日行程。\n相逢既诺交承约，少待何妨信义明。\n戚戚已无终岁虑，琅琅先有诵书声。\n夫妻白首皆天幸，三乐无惭好弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁未仲夏赏月","author":"孙介","text":"诗成二十年，今夜月重圆。\n两姓包三乐，同寮庆十全。\n笑谈谐素愿，宾主谢高天。\n莫逆无劳约，俱祈得永延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬寅正月幼子黄岩尉任将满予与家众先归幼子独留官舍三月作诗八句寄之","author":"孙介","text":"三年随汝作初官，父子同知涉世难。\n饕禄粗欣便老懒，还家仍虑厄饥寒。\n生来赋分皆前定，天下何时得举安。\n慈孝睽离怀问膳，试凭双鲤祝加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用儿子应时宿龙泉寺遇雪诗韵","author":"孙介","text":"扁舟趋郡去，携手复同归。\n款话僧宜访，登山志欲飞。\n诗能歌白雪，心合念黄扉。\n莫作儿童语，丰凶有政机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲子生日","author":"孙介","text":"寻常得子要佳晨，何幸生朝在仲春。\n乐事赏心随处处，仁风和气似亲亲。\n天恩有庇容团聚，家训无须旋卜邻。\n杯酒献酬更祝颂，不须黄老拱星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县作鹿鸣会屈致冷副端席半出诗侑一献次其韵","author":"孙介","text":"早叹朝阳一凤鸣，几多风奏动延英。\n只今故里誇閒适，得使诸生拜老成。\n妙句独先歌白雪，欢颜亲自酌乌程。\n鹿鸣故事虽荣观，此段邦人分外荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐偶成","author":"孙介","text":"堕甑谁能顾，虚舟进所如。\n无涯身世事，有味圣贤书。\n发短犹禁栉，园荒可废锄。\n莱衣幸无恙，何必问其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱叔仪使君之南安","author":"孙介","text":"使君心事玉无瑕，游戏功名发未华。\n要省文书翻贝叶，故从江岭访梅花。\n春风早趁人千里，胜日相思天一涯。\n唤取名郎著兰省，不须留及两年瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乾道乙酉鬻田训子有作","author":"孙介","text":"颜回犹自给糜饘，苏子初无二顷田。\n知慕圣师瞠若后，岂令恭嫂倨如前。\n笔耕得利宁分地，学禄中居总藉天。\n卜相既云隳祖业，请令同力奋双拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偕同人登虞山乾元宫","author":"孙介","text":"尘嚣咫尺愧山林，胜日追凉得共临。\n千里江湖堪送目，一轩松竹更论心。\n清风便自生秋意，小酌何妨到夕阴。\n归路蝉声满溪谷，为君倚盖一微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁未孟秋夜月明如中秋因思范公守南阳赏月及坡公赤壁之游皆七月望也作短歌记之","author":"孙介","text":"先生赤壁舟中赋，老子百花洲上歌。\n古人不负此明月，今我当如此月何。\n连宵风雨暑欲尽，碧玉万里谁新磨。\n冰盘无声出海底，荡漾六合生金波。\n早秋便得许奇绝，探借八月清光多。\n天公赐我美无价，樽酒不设羞嫦娥。\n人生看月几时足，百年寒暑如飞梭。\n两公却与月长在，声名万古流江河。\n梦生羽翼不可逐，想象风景空吟哦。\n洞箫长笛亦何有，拂衣起舞聊婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"孙介","text":"滩头鸣榔去，偃仰醉霜月。\n意倦早归来，风波渺愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欣欣篇","author":"孙介","text":"欣欣雪斋叟，年少本孤寒。\n愁怀厄羁寓，兀坐起长叹。\n慷慨念前世，圣门真可观。\n邹人息邪说，吏部回狂澜。\n钝金须砥砺，曲木待绳弹。\n幸哉得三男，父子聊自欢。\n烂舌不令闭，濡毫无使乾。\n高天揭悬象，绝嶂飞流湍。\n取舍徇三益，行藏推四端。\n莺友新择木，鹓雏初放官。\n言辞凛冰雪，节操森琅玕。\n神祇傥终祐，骞翥亦何难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后","author":"孙介","text":"落日矫乌云，疾风豗白浪。\n雨声西南来，势剧万马壮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后","author":"孙介","text":"呼童捲帘收架书，檐溜忽断云萧疏。\n山光水影净如拭，一川秋意生芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨凉夜坐口占","author":"孙介","text":"雨阵四五合，回风扫千军。\n举头映微月，满空行白云。\n烦歊一洗尽，危坐清夜分。\n读书意未已，悠然有馀欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答僧道隆惠老融水墨一纸","author":"孙介","text":"破林霜后月，烟景夜微茫。\n妙寄笔墨外，静涵山水光。\n古融韵可想，老隆意所将。\n惭我无琼琚，报以永不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张元鼎风雨斋","author":"孙介","text":"张侯好兄弟，韡韡棠棣芳。\n筑室听风雨，书史堆满床。\n床前竹千挺，竹外花两行。\n举头见青山，秀色临我傍。\n客来具鸡黍，亦复陈壶觞。\n坐与尘土隔，淡然风味长。\n我久倦行役，万里归故乡。\n相过饭三日，笑语成清狂。\n百年几别离，两鬓各已苍。\n此会苦难复，此欢不可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"孙介","text":"哭愿吾皇不共天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何水部蒙出牧袁州","author":"孙元方","text":"圣君再命拥朱轮，合是南方受赐频。\n双鬓任从添白发，六条谁许继清尘。\n风牵泽国秋帆远，路入丰州昼锦新。\n莫为故乡延去棹，宜春人望待行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题舫斋","author":"孙元卿","text":"满船载月华亭子，泛宅浮家张志和。\n何似舫斋趺坐稳，莫教平地起风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与钱孝先游洞霄","author":"孙元卿","text":"玄冥相我作山行，捲却重阴放晓晴。\n但见峰峦互扃锁，不知宫阙隐峥嵘。\n云根洞穴篝灯入，井底波澜抚掌生。\n唤客入山还送客，淙琤犹记石泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"索刘述之新酿","author":"孙升","text":"稍觉香熏鼻，还思酒入唇。\n盈缸止三斗，可拨瓮头春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑待制闳中归闽","author":"孙升","text":"清晓都门祖帐开，路人相与叹贤哉。\n流尘几翳看山眼，落日休停别酒杯。\n何待诸生留北阙，自存遗直在东台。\n连江四老嗟谁在，白首今朝只独来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"孙升","text":"更约与君三十载，北陵原上望残霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"孙升","text":"梁台歌吹馀衰草，湓浦琵琶怅晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"孙升","text":"睡须山鸟唤，酒听竹枝斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"孙升","text":"穷搜诗句熟，老练世情通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"孙升","text":"若与蛟龙争角黍，应同渔父啜糟醨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"孙升","text":"漏残馀一榻，曾不为黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]