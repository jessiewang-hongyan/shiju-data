[{"title":"晚晴闻角有感","author":"陆游","text":"暑雨初收白帝城，小荷新竹夕阳明。\n十年尘土青衫色，万里江山画角声。\n零落亲朋劳远梦，凄凉乡社负归耕。\n议郎博士多新奏，谁致当时鲁二生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚游","author":"陆游","text":"垣屋参差出，沟溪曲折通。\n乱鸦空际黑，落日竹间红。\n轧轧舆竿语，摇摇幡脚风。\n吾行本无定，随意入空濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚游东园","author":"陆游","text":"药瓢藜杖合施行，独往山林已歃盟。\n傍水断云含暮色，拂檐高竹借秋声。\n痴人自作浮生梦，腐骨那须后世名。\n莫笑吟哦无阙日，老来未尽独诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登千峰榭","author":"陆游","text":"只道文书无了日，也能摆拨上层台。\n窗明山雪暮方作，露白野梅寒未开。\n老病真惭天下士，穷愁强覆掌中杯。\n儿曹莫怪凭阑久，得句何妨秉烛回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登望云二首 其一","author":"陆游","text":"一出修门又十年，辈流多已珥金蝉。\n衰如蠹叶秋先觉，愁似鳏鱼夜不眠。\n辇路疏槐迎驾处，苑城残日泛湖天。\n君恩未报身今老，徙倚危楼一泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登望云二首 其二","author":"陆游","text":"晚来烟雨暗江干，烽火遥传画角残。\n看镜功名空自许，上楼怀抱若为宽。\n青枫摇落新秋令，白发凄凉旧史官。\n饱见少年轻宿士，可怜随处强追欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登横溪阁二首 其一","author":"陆游","text":"楼鼓声中日又斜，凭高愈觉在天涯。\n空桑客土生秋草，野渡虚舟集晚鸦。\n瘴雾不开连六诏，俚歌相荅带三巴。\n故乡可望应添泪，莫恨云山万叠遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚霁二首 其一","author":"陆游","text":"雨断檐馀滴，云疏日漏明。\n人其如积潦，天自活疲氓。\n溪碓舂香稻，霜丛剪绿橙。\n书生久愁卧，作意赋新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚霁二首 其二","author":"陆游","text":"涨水返旧壑，浮云归故山。\n园丁艺蔬去，邻妇赁舂还。\n乔木苍烟外，孤村落照间。\n莫嫌樽酒薄，且用破愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晦日西窗怀故山","author":"陆游","text":"今朝休日仍无客，茶罢西窗卧解衣。\n白发已侵残梦境，绿苔应满旧渔矶。\n桃源鸡犬尘凡隔，杜曲桑麻梦想归。\n赖有小山聊慰眼，幽篁丛桂雨霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晦前二日夜欲晓自湖上归对残月独酌","author":"陆游","text":"小阁对寒蟾，山尊尽更添。\n方看一轮满，又叹两头纤。\n脉脉离云峤，娟娟傍画檐。\n五更清露下，不恨客衣沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨出","author":"陆游","text":"昧爽睡餍足，起扶藜杖行。\n关山开晓色，草木度秋声。\n市晚船初发，奴勤地已耕。\n道边多野菜，小摘助晨烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨兴","author":"陆游","text":"倦枕厌寒夜，起寻残火温。\n喈喈众鸡动，耿耿一灯昏。\n野气增霜力，窗光淡月痕。\n早朝非老事，且复灌吾园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨兴","author":"陆游","text":"小雨过郊墟，晨兴一事无。\n残榴重结蕊，新燕续生雏。\n书细犹能读，行迟渐要扶。\n蔬畦恐芜没，且复课僮奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨至湖上二首 其一","author":"陆游","text":"剑南无剧暑，长夏更宜人。\n啼鸟常终日，幽花不减春。\n荷香浮绿酒，藤露落乌巾。\n莫作天涯想，翛然梦里身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨至湖上二首 其二","author":"陆游","text":"园古逢秋好，身闲与懒宜。\n空堂赏疏豁，重阁望参差。\n竹粉有新意，松风含古姿。\n低回惭禄米，官事少于诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨过天庆","author":"陆游","text":"萝月挂团璧，松风号急滩。\n孤灯经院晓，残雪醮坛寒。\n剩欲闲扶杖，何妨醉堕冠。\n诗成兴不尽，万里跨青鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨坐道室有感","author":"陆游","text":"一钵青精便有馀，世间万事总成疏。\n手挥弦上乌栖曲，口诵岩间鸟迹书。\n丹气初升勤沐浴，芝房未熟饱耘锄。\n碧霄腾举人人事，莫恋污渠与臭帑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨雨","author":"陆游","text":"挥汗驱蚊废夜眠，清晨一雨便翛然。\n凉生池阁衣巾爽，润入园林草木鲜。\n青蒻云腴开斗茗，翠罂玉液取寒泉。\n饭馀一枕华胥梦，不怪门生笑腹便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨雨","author":"陆游","text":"过云生谷暗，既雨却窗明。\n低燕争泥语，浮鱼逆水行。\n山川增秀色，草木有奇声。\n处处青秧满，长歌乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"勋业文章谢不能，生涯分付一枝藤。\n身同湘浦孤舟客，心羡庐山下版僧。\n倦枕厌闻窗外雨，残膏犹在壁间灯。\n草芝要及清晨服，深愧蛮童为扣冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"初听高枝鹎鵊鸣，旋闻深井辘轳声。\n烟笼小阁犹疑雨，日射东窗顿作晴。\n古洗注汤供颒濯，春畦摘菜助炰烹。\n老人颓惰虽堪笑，终胜胸中怀不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"老尚贪书课，黎明即下床。\n不惊天乍冷，更觉意差强。\n蟾滴初添水，螭炉旋炷香。\n浮生又一日，开卷就窗光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"小雨湿清晓，新莺啼早春。\n年光惊病眼，节物属闲身。\n巴硖东连楚，嶓山北控秦。\n远游端可继，敢恨素衣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"倦枕廉纤雨，幽窗料峭寒。\n溪柴旋篝火，野蔌斗登槃。\n年老衣冠古，身闲宇宙宽。\n儿孙生我笑，趋揖已儒酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"晓枕初兴白发翁，弊裘百衲葑炉红。\n独居漫受书狐媚，滞思难矜笔阵雄。\n旧学虫鱼笺尔雅，晚知稼穑讲豳风。\n一身自喜无馀事，且度残年风雪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"晨起梳头懒，披衣立草堂。\n雾昏全隐树，气暖不成霜。\n滩急回鱼队，天低衬雁行。\n新春犹一月，已觉日微长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"终夜厌姑恶，经春无秭归。\n溪云生惨惨，林日澹晖晖。\n物外孤怀胜，人间百虑非。\n邻翁剡中去，为我买渔衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"晨起梳头拂面丝，行年七十岂前期。\n此生犹著几两屐，长日惟消一局棋。\n空釜生鱼忍贫惯，闲门罗雀与秋宜。\n区区名义真当勉，正是先师戒得时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"衣润熏笼暖，灯残漏箭长。\n鸣鸡带窗月，立马怯庭霜。\n病骨阴晴觉，官身早夜忙。\n火城那复梦，愁绝软尘香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"晨起梳头雪满膺，可怜衰与病相乘。\n浮名何足欺横目，真乐聊须付曲肱。\n仕有俸钱渠亦好，退无耕垄我何凭。\n具牛力尽殊堪闵，买犊东村恨未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"小疾蠲除尽，闲愁垦辟空。\n时光鸡唱里，生计碓声中。\n戒婢储猿果，看奴织鹤笼。\n老人新得道，处处见神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"天公择地养衰残，著向桑村麦野间。\n晓色入帘初滉漾，幽禽窥户已间关。\n酒徒散去稀中圣，诗思衰来愧小山。\n一炷沉烟北窗底，曲肱卧看不胜闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"客枕畏霜气，晓窗收月痕。\n芸芸万物作，皎皎一心存。\n老已忘开卷，贫犹力灌园。\n儿孙能继此，亦足报君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"老境真无事，深居每畏人。\n喔咿鸡失旦，娅姹鸟鸣春。\n过担餦餭白，擎盘粔籹新。\n出门还可喜，一笑语比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"日高霜渐释，睡起发犹蓬。\n小圃经行外，新蔬检校中。\n水开闻跃鲤，天远看飞鸿。\n粥熟还归舍，吾生亦未穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"月澹知将晓，风清喜近秋。\n狂吟词跌宕，新沐发飕飗。\n桐叶危先堕，蝉声断更遒。\n达生随处乐，自笑替人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起","author":"陆游","text":"一官又寄汝江头，落魄文园故倦游。\n榻上铎声悲破梦，檐边桐叶冷生秋。\n暮年作吏宁长策，薄禄縻人尚小留。\n晨起凭栏叹衰甚，接䍦纱薄发飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起出南堂","author":"陆游","text":"晓枕华胥谁唤回，下堂拽杖一悠哉。\n啼鸦已逐晨光起，飞鹭初冲宿霭来。\n石路少行生蔓草，柴扉多闭长莓苔。\n身闲亦未全无事，检校幽花几树开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起自山园归书室","author":"陆游","text":"世事苦纷纷，村墟寂不闻。\n穿林拾蝉蜕，隔浦数鸥群。\n摇落初飘叶，高舂未散云。\n归来书满眼，犹足肆吾勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起至参倚斋示子聿","author":"陆游","text":"似仙犹火食，比古未巢居。\n老子粗全节，小儿能著书。\n下帘留乳燕，投饭出潜鱼。\n幸好隆中客，无为起草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起行园中","author":"陆游","text":"老病厌嚣烦，晨兴步小园。\n草深移旧路，竹茂失颓垣。\n未暇从鱼乐，惟思与石言。\n人家寻每得，拄杖印苔痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起坐南堂书触目","author":"陆游","text":"林塘天与占深幽，一把茆轻万户侯。\n漠漠断云开复合，纤纤微雨落还收。\n奇峰角立千螺晓，远水平铺疋练秋。\n诗料满前吾老矣，笔端无力固宜休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起独行绿阴间","author":"陆游","text":"楸槐阴里漏朝晖，芳草离离露渐稀。\n不恨过时尝煮酒，且欣平旦著生衣。\n病逢针药如差减，贫比箪瓢尚庶几。\n惟是未能忘习气，乱书随日又成围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起偶得五字戏题稿后","author":"陆游","text":"推枕悠然起，吾诗忽欲成。\n虽云无义语，犹异不平鸣。\n有得忌轻出，微瑕须细评。\n平生五字句，垂老愧长城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起偶题","author":"陆游","text":"城远不闻长短更，上方钟鼓自分明。\n幽居不负秋来睡，末路偏谙世上情。\n大事岂堪重破坏，穷人难与共功名。\n风炉歙钵生涯在，且试新寒芋糁羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨起颇寒饮少酒作草数幅","author":"陆游","text":"衣食无多悉自营，今年真个是归耕。\n屏居大泽群嚣息，乍得清寒百体轻。\n桥北潦收波浅碧，埭西霜近叶微赪。\n一杯弄笔元无法，自爱龙蛇入卷声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望云楼晚兴","author":"陆游","text":"小阁东南独咏诗，此生终与世差池。\n夕阳明处苍烟合，栖燕归时画角悲。\n人与江山均是梦，心非风月尚谁知。\n旧交几岁音尘隔，三抚阑干有所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望永阜陵","author":"陆游","text":"圣主乘乾临斧扆，小臣承诏上丹墀。\n宁知齿豁头童后，更遇天崩地陷时。\n泣至眼枯无血续，梦随魂断独心知。\n白头才尽空濡笔，宁继生民下武诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望永阜陵","author":"陆游","text":"龙飞回首尚如新，忽阅人间四十春。\n圣主已严天上驾，孤臣归作道傍民。\n倾河尚恨难供泪，卫社何由得致身。\n独立秋风吹白发，感恩肝胆漫轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望永思陵","author":"陆游","text":"高帝中兴万物春，青衫曾忝缀廷绅。\n仕为将相却常事，年及耄期能几人。\n早幸执殳观北伐，晚叨秉笔记东巡。\n归耕况复苍梧近，郁郁葱葱佳气新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江道中","author":"陆游","text":"吾道非邪来旷野，江涛如此去何之。\n起随乌鹊初翻后，宿及牛羊欲下时。\n风力渐添帆力健，橹声常杂雁声悲。\n晚来又入淮南路，红树青山合有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅天","author":"陆游","text":"稻陇移初遍，梅天涩未晴。\n轻阴昏茗色，馀润咽琴声。\n时傍菱塘立，还寻沙径行。\n杜门终此世，更誓未来生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅仙坞小隐","author":"陆游","text":"绿树阴阴小岭西，一翁二子自扶携。\n雨前芳嫩初浮盌，腊脚清醇旋拆泥。\n本欲省缘行买饼，未能去杀尚烹鸡。\n弄桡莫便寻归路，湖静无风日未低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅仙坞花泾观桃李","author":"陆游","text":"妖妍天遣占年华，叹息人间有许花。\n十里织成无罅锦，半天留得未残霞。\n欲题直恐无才称，不见何由信客誇。\n醉后又惊春事晚，湖堤烟柳已藏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅市","author":"陆游","text":"梅市柯山小系船，开篷惊起醉中眠。\n桥横风柳荒寒外，月堕烟钟缥渺边。\n客思况经孤驿路，诗情又入早秋天。\n如今老病知何恨，判断江山六十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅市","author":"陆游","text":"小雨长堤古寺西，不容羸马惜障泥。\n时平道路铃声少，岁乐坊场酒价低。\n烟树浅深山驿近，野歌断续客魂迷。\n残躯不料重来此，一首清诗手自题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅市","author":"陆游","text":"沙际人家半掩扉，借炊小住不相违。\n水生溪面大鱼跃，风定草头双蝶飞。\n竹院游僧闻鼓集，烟畦老圃荷锄归。\n浩然物外真堪乐，回首浮生万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅市道中二首 其一","author":"陆游","text":"去去浮官浦，悠悠数客樯。\n蓼花低蘸水，枫树老经霜。\n箫鼓迎神闹，锄耰下麦忙。\n城西小市散，归艇满斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅市道中二首 其二","author":"陆游","text":"雨暗山陂路，人喧古渡头。\n庙垣新画马，村笛远呼牛。\n买饭谙争席，迎潮竞解舟。\n平生苦吟处，又送一年秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅市暮归三山","author":"陆游","text":"日日蛮童佩一壶，壶乾时亦复村酤。\n横林露塔远犹见，暮霭笼山淡欲无。\n绿浦例凭菰作界，画桡常遣鹭前驱。\n此身元是沧浪客，敢学高人乞镜湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅村野人家小憩","author":"陆游","text":"正遣清诗觅菊栽，穿云涉水又寻梅。\n万牛不挽新愁去，一鸟还惊午梦回。\n老愧逢人说幽愤，穷能随事学低摧。\n江边漂母何为者，无食王孙未易哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"陆游","text":"我与梅花有旧盟，即今白发未忘情。\n不愁索笑无多子，惟恨相思太瘦生。\n身世何曾怨空谷，风流正自合倾城。\n增冰积雪行人少，试倩羁鸿为寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花四首 其四","author":"陆游","text":"折得名花伴此翁，诗情恰在醉魂中。\n高标不合尘凡有，尤物真穷造化功。\n雾雨更知仙骨别，铅丹那悟色尘空。\n前身姑射疑君是，问道端须顺下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"陆游","text":"家是江南友是兰，水边月底怯新寒。\n画图省识惊春早，玉笛孤吹怨夜残。\n冷淡合教闲处著，清臞难遣俗人看。\n相逢剩作樽前恨，索笑情怀老渐阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花四首 其二","author":"陆游","text":"月地云阶暗断肠，知心谁解赏孤芳。\n相逢只怪影亦好，归去始惊身染香。\n渡口耐寒窥净绿，桥边凝怨立昏黄。\n与卿俱是江南客，剩欲尊前说故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花四首 其三","author":"陆游","text":"玄冥行令肃冰霜，墙角疏梅特地芳。\n屑玉定烦修月户，堆金难买破天荒。\n了知一气环无尽，坐笑千林冻欲僵。\n力量世间谁得似，挽回岁律放春阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]