[{"title":"句","author":"张登","text":"孤高齐帝右，潇洒晋亭峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其三","author":"张登辰","text":"羁贯分灯读，论交若弟兄。\n羡君先得隽，嗟我老无成。\n几载同忧患，终年隔死生。\n梦中犹历历，笑语若生平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其二","author":"张登辰","text":"自古名而寿，宗臣罕有之。\n尝陵终落魄，贺白不期颐。\n天涸璇源派，霜摧玉树枝。\n游魂归故国，忍见黍离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓 其一","author":"张登辰","text":"儒风凋落尽，生意仅如丝。\n一自先生死，深为吾道悲。\n颓波谁砥柱，善类孰纲维。\n有子森如玉，斯文想未衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赭衣舂","author":"张登辰","text":"赭衣舂永巷，酸风起暮杵。\n声声碎妾心，妾儿痛隔三千里。\n灞水欢迎骨肉恩，子母再见无由缘。\n谁将鸩羽饮龙子，晨猎上林如意死。\n妾耳纵能闻，妾目那能视。\n妾口纵能言，妾足安能履。\n白日改色天容愁，未央宫中桐叶秋。\n堂堂丰沛龙准公，三尺造汉烹英雄。\n击布归来尚无恙，预置股肱如指掌。\n明知戆勃可安刘，何为存妾子母无良谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"张舜民","text":"一见黄花只自羞，萧然短发不禁秋。\n谁人为整乌纱帽，独倚西风满眼愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下滩二绝句 其一","author":"张舜民","text":"下得寒滩水漫流，山平水远更清幽。\n几何舟楫随风去，唯有渔人得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下滩二绝句 其二","author":"张舜民","text":"江风淅淅似相催，绿竹丹枫去又来。\n任使云帆能破浪，不知归客已心灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书陈副省卷","author":"张舜民","text":"乃翁能继辋川吟，零落传家得至今。\n贫贱莫量陈孺子，与人千古作知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆射陂","author":"张舜民","text":"陂头下马问渔者，欲买鲜鳞充晚庖。\n昨夜北风水面合，不禁杨柳已成苞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕端居感事四绝句 其二","author":"张舜民","text":"十二门开如沸羹，灯光月色逐人行。\n春城无处无歌舞，一曲未终天又明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕端居感事四绝句 其一","author":"张舜民","text":"凤楼南畔綵为山，百戏年年奉帝筵。\n不独侍臣偏赐酒，当时一国梦钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕端居感事四绝句 其三","author":"张舜民","text":"珠帘当面见玲珑，白鹤仙人上下通。\n夜半蕊珠重命宴，鸣鞘声落九霄中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕端居感事四绝句 其四","author":"张舜民","text":"何事今宵动所思，此欢常与少年期。\n莫疑杜甫吟兼哭，为忆开元最盛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元丰癸亥秋季赴官郴岭舣舟樊口与潘彦明范亨父以小艇过吉阳寺是日大风雨雪","author":"张舜民","text":"江上秋风九日寒，故人樽酒暂相欢。\n如何塞北无穷雪，却坐樊山竹万竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月台","author":"张舜民","text":"明月光常满，使君樽屡开。\n何须待月上，日暮便登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木瓜 其二","author":"张舜民","text":"古言疾疠由卑湿，木实能医见药书。\n有力与人销患难，无心望尔报琼琚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木香花 其二","author":"张舜民","text":"广寒宫阙月楼台，露里移根月里栽。\n品格虽同香气俗，如何却共牡丹开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木香花 其一","author":"张舜民","text":"庭前一架已离披，莫折长枝折短枝。\n要待明年春尽后，临风三嗅寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长干寺同刘宫苑浴 其二","author":"张舜民","text":"未知何处是吾庐，南北悠悠意所如。\n不爱渭川千亩竹，与君江上卜新居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长干寺同刘宫苑浴 其一","author":"张舜民","text":"人看浴出如枯木，我自无心类死灰。\n在处秋风吹鬓发，不堪更上雨花台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖晚眺","author":"张舜民","text":"白鹭双飞过女墙，两行高柳正斜阳。\n荷花满眼都无主，闇里风飘入袖香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北归再过洞庭","author":"张舜民","text":"我家本住长安陌，泾渭交流出坐隅。\n须信宦游皆有地，十年四过洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石楠","author":"张舜民","text":"六代乔楠二百龄，分柯中有异枝生。\n孤根自合藏幽处，瑞子何期应太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次长芦","author":"张舜民","text":"炎荒往返正三年，重过长芦古寺前。\n万里风波行欲尽，停挠南望