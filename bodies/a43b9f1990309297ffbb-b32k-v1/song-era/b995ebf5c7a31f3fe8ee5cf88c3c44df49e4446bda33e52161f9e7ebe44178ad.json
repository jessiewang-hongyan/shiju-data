[{"title":"挽贡南漪三首 其一","author":"王圭","text":"齿德人皆仰，诗书老更耽。\n福兼鸿范五，瑞集凤雏三。\n岁月供陶写，江湖入笑谈。\n流芳钟四叶，兰玉俨相参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽贡南漪三首 其二","author":"王圭","text":"燕居宣圣像，侑坐祖黎公。\n矜佩一朝集，弦歌九族同。\n夜窗书案雪，春服舞雩风。\n长使南湖学，千秋纪此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡信芳上舍二首 其二","author":"王圭","text":"清弋江村外，工山右县边。\n追游曾结社，许与更忘年。\n郢斲无为质，牙琴有绝弦。\n巾箱遗墨在，披阅一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡信芳上舍二首 其一","author":"王圭","text":"濠上初相得，竹林曾共游。\n清文三峡水，爽气九华秋。\n世已从新学，人谁与此流。\n遗芳端不朽，未信盖棺休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽董澜溪二首 其二","author":"王圭","text":"嗜学尝忘味，说诗堪解颐。\n竹林虽晚会，濠上独深知。\n兰畹无留馥，凤巢空旧枝。\n停云正愁望，横笛未休吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽董澜溪二首 其一","author":"王圭","text":"六馆知名久，双溪避地来。\n交新如旧识，世短惜长才。\n怅望中年别，飞腾暮景催。\n蟆陵他日泪，不独故人哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽董儒仲二首 其二","author":"王圭","text":"复忆同游处，经春在武林。\n湖光浮鹢净，山木坐猿深。\n事往唯诗在，悲来托梦寻。\n朋知零落尽，投老若为心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽董儒仲二首 其一","author":"王圭","text":"战艺升环水，论诗得异闻。\n窥园仍旧隐，下马忽新坟。\n白社真投分，青灯忆离群。\n有书无子读，此事最怜君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽潘昌朝","author":"王圭","text":"道德诸儒表，文章大雅人。\n杏园三月暮，花县一回春。\n脱屣官情薄，转头时事新。\n猗兰芳未没，世业不沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽霸州文安县主簿苏明允","author":"王圭","text":"岷峨地僻少人行，一日西来誉满京。\n白首只知闻道胜，青衫不及到家荣。\n元猿夜哭铭旌过，紫燕朝飞挽铎迎。\n天禄校书多分薄，子云那得葬乡城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题吴仲庶省副北轩画壁兼呈杨乐道谏院龙图三首 其三","author":"王圭","text":"闻道北窗开绘境，偶来归思满沧洲。\n卷帘宿鸟惊初旭，隔浦疏林似旧秋。\n梦忆清溪知几曲，醉寻危磴欲三休。\n何时又赐通中枕，与对云山尽日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题吴仲庶省副北轩画壁兼呈杨乐道谏院龙图三首 其二","author":"王圭","text":"谁将画手分平远，几度曾窥雁鹜洲。\n六月炎风方病暑，五湖烟景已迎秋。\n班趋规地来常晚，诗入笼纱思未休。\n为惜主人林下意，暮钟沉阁尚应留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题吴仲庶省副北轩画壁兼呈杨乐道谏院龙图三首 其一","author":"王圭","text":"文书满眼纷纷里，忽觉沧波起荻洲。\n红日不知华省暮，扁舟如下洞庭秋。\n林泉傲物非无约，轩冕拘人此未休。\n与拂素尘寻绝景，羡君潇洒特迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莫京甫知事有台掾之辟赋诗识别二首 其一","author":"王圭","text":"烈士思酬国士知，云霄羽翼政相期。\n人言雅望台中妙，我识壮怀天下奇。\n自是英才为世用，由来了事笑儿痴。\n回头说向虞罗辈，鹄举鸾鶱可得羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莫京甫知事有台掾之辟赋诗识别二首 其二","author":"王圭","text":"兰生空谷混荆榛，不碍幽香到处闻。\n幕府才流推谢掾，宣州宾客忆崔群。\n清怀叠阵三秋月，行橐双溪一片云。\n白发书生何以报，惭君出力卫斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被诏考制科呈胡武平内翰三首 其二","author":"王圭","text":"清晓华芝度景阳，凝严又许对西厢。\n通宵客梦闻钧吹，几日朝衣带御香。\n东观图书经屡读，旧溪桃李见新芳。\n三千文字皆奇册，饱死侏儒讵足量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被诏考制科呈胡武平内翰三首 其三","author":"王圭","text":"忝班清禁接严徐，诏侍延英访对初。\n沧海烟霞连太液，丹霄日月近雕舆。\n明廷已奏安危策，紫府谁将姓字书。\n从此青云知有路，致君材业不应疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被诏考制科呈胡武平内翰三首 其一","author":"王圭","text":"奉诏金门草圣题，平明趋过殿西墀。\n宫床赐笔宣名早，赭案焚香上策时。\n朝论只应收畯杰，皇心非不监安危。\n玉堂词客承恩久，几度曾来醉御卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"较艺书事","author":"王圭","text":"日薄寒云下结鳞，忽驰诏骑绝飞尘。\n麻衣半犯秦关雪，鱼钥横催汉署春。\n黄纸贴名书案密，堂梨雕字赋题新。\n高材顷刻闻天下，谁是墙东冠榜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"较艺书事再呈永叔并同院诸公","author":"王圭","text":"小雨班班拂晓除，新禽格磔静相呼。\n眼窥夜卷千花碧，肺渴春盘几露珠。\n只见楼头飘落絮，不知门外长青芜。\n玉阶未放金书榜，谁识秦关旧弃繻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"较艺将毕呈诸公","author":"王圭","text":"文昌宫里柳依依，谁折长条赠我归。\n雨润紫泥昏诏墨，风吹红蕊上朝衣。\n玉堂燕子应先入，朱阁杨花已半飞。\n寒食未过春景熟，好同天陌去騑騑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄公辟","author":"王圭","text":"念昔都门手一携，春禽争向苧萝啼。\n梦回金殿风光别，吟到银河月影低。\n舞急锦腰迎十八，酒酣玉盏照东西。\n何时得遂扁舟去，雪棹同君访剡溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望京馆","author":"王圭","text":"一从绝漠返朱轮，便有东风逐去尘。\n和气旋成燕谷暖，使华重照苏门新。\n山川如避中原执，天地应酣上国春。\n二月塞亭行欲尽，初花犹未识归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"王圭","text":"冷香疑到骨，琼艳几堪餐。\n半醉临风折，清吟拂晓观。\n赠春无限意，和雪不胜寒。\n桃李有惭色，枯枝试并栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涿州","author":"王圭","text":"涿州亭下柳依依，谁折长条送客归。\n晓月未消燕戍酒，春云初拂汉台衣。\n玉堂社燕宜先入，沙碛晴鸿己半飞。\n回首青山欲千里，行人犹自马騑騑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴","author":"王圭","text":"溟渤荡无垠，东嵎挂日轮。\n风云始回雨，天地不飞尘。\n气动千峰翠，光浮万瓦鳞。\n南亭一驻马，十里望青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪","author":"王圭","text":"大野重阴合，危楼远望迷。\n风兼万籁响，天与四溟低。\n病树先春发，惊乌未晓啼。\n好同伊水客，香阜访灵栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富谷馆","author":"王圭","text":"万雀噪山馆，重来一叩扉。\n去年寒梦在，今日远书违。\n残雪留春橐，疏星挂晓衣。\n帝乡不可望，心与白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"就日馆","author":"王圭","text":"高原春霁荡妖氛，使驲重来路始分。\n虽远长安初见日，渐亲冀北已瞻云。\n东风未破胡天冻，芳草应连紫陌薰。\n早晚旅魂还旧干，晨钟一到玉关闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普净院避暑呈陆子履学士","author":"王圭","text":"九衢车马嚣嚣地，偶过禅房得暂閒。\n畏景未移天正午，凉风己到殿中间。\n瓜馀玉箸蠲烦肺，冰满银壶照病颜。\n向晚斗城趟禁直，恍疑身不在尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山寺","author":"王圭","text":"寒日征骖懒复回，经宵仍喜驻岩隈。\n径盘幽迹遥知鹿，林逗清香定有梅。\n晓影瘦猿窥涧溜，夜声肥栗托炉灰。\n我心非动我非静，白足禅僧无妄猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游赏心亭","author":"王圭","text":"六朝遗迹此空存，城压沧波到海门。\n万里江山来醉眼，九秋天地入吟魂。\n于今玉树悲歌起，当日黄旗王气昏。\n人事不同风物在，怅然犹得对芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登海州楼","author":"王圭","text":"城外沧溟日夜流，城南山直对城楼。\n溪田雨足禾先熟，海树风高叶易秋。\n疏傅里闾寻故老，秦皇车甲想东游。\n客心不待伤千里，槛外风烟尽是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登悬瓠城感吴李事","author":"张耒","text":"将军戈甲从天下，丞相旌旗匝地来。\n堪笑怒螳犹强臂，不知蛰户欲惊雷。\n咄嗟武相深冤洗，指顾山东逆境开。\n吏部声名千古在，段碑何处卧苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集英殿秋燕教坊乐语口号","author":"王圭","text":"秋光紫翠动南山，天上传呼御燕颁。\n一部梨园吹凤曲，九重丹阙对龙颜。\n日华初驻金舆仗，霞彩犹浮玉笋班。\n欲识君臣同乐处，万箱登岁五兵闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集英殿乾元节大燕教坊乐语口号","author":"王圭","text":"清跸传音紫集来，逡巡万玉拥钧台。\n南山镇地符辰算，北斗倾霞入宴杯。\n镐饮篇中鱼演漾，虞韶声里凤徘徊。\n年年赤帝乘离月，长见云龙帐殿开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新亭","author":"王圭","text":"独上新亭怨不胜，荒城摇落暮烟凝。\n翠筠无限悲湘水，玉碗空闻泣茂陵。\n秋馆树寒风战叶，夜楼人散雨飘灯。\n紫台路远关山隔，回首阴云几万层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新城寄瓦桥郭太傅","author":"王圭","text":"冰天行绝驾归轺，十里清烟望界桥。\n此夕离音留使节，一心上苑看晴霄。\n燕云逐马逢春断，朔雪沾衣入塞销。\n寄语当时四并客，东风应已遍柔条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新馆","author":"王圭","text":"偏箱岭恶莫摧轮，游子思亲泪满巾。\n万里有尘遮白日，一行无树识新春。\n幽禽才啭已催客，狂石欲奔如避人。\n虏酒相邀绝峰饮，却因高处望天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼上会友述怀","author":"王圭","text":"烟城疏雨隔斜阳，一上危楼睇大荒。\n原宪自贫非苦病，次公未饮已多狂。\n江帆来往年光度，驿堠东西客意长。\n最爱南朝风物好，醉魂常梦水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雷塘晚归","author":"王圭","text":"塘梢黯黯夕云低，苍莽荒原望四迷。\n海日光寒衔岛树，江潮声暴压城鼙。\n乔林风劲横雕眼，浅草霜乾快马蹄。\n战血未收边戍苦，玉龙谁为一提携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"靴淀除夕之会呈王原叔给事燕唐卿谏议","author":"王圭","text":"岁华相逐走燕尘，此夕羁怀暂一申。\n把手岂辞三处酒，别家看作二年人。\n因逢塞雁惊来信，却忆江梅赠去春。\n莫向天涯忧白发，东风犹与到关新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滕学士移河朔","author":"王圭","text":"五鼓声沈晓色回，北驰马首望燕台。\n旧趋武帐清光近，新会仙山秘典开。\n人惜憩棠馀爱远，帝忻借箸密谋来。\n边城消尽还兵喜，谁敌阳关决胜才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招提院静照堂","author":"王圭","text":"身虽居城邑，趣不落人间。\n门外尘埃满，庭中日月閒。\n潮随朝梵响，雨入定衣斑。\n几欲携筇去，松阴一叩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冀馆春夕见月","author":"王圭","text":"甚宠无如使牡行，曾同万里听秋声。\n黄金台下嘶宛马，木叶山前度汉旌。\n才到关南逢雁尽，重来海上见波平。\n故人临月应相望，一夕寒光特为明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太子太傅李康靖公挽词二首 其二","author":"王圭","text":"陪幄方图政，安车遂告年。\n帝求惇史善，人叹大夫贤。\n故馆西州路，佳城京兆阡。\n惟应旧游客，堕泪向碑前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太子太傅李康靖公挽词二首 其一","author":"王圭","text":"议政西清贵，辞荣北第开。\n鲁冈天与寿，荀里世多才。\n象告中台坼，峰惊半岳摧。\n秋风嵩少路，箫鼓有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太子少师元章简公挽词","author":"王圭","text":"天子思贤共政涂，中台前日得真儒。\n正看浴凤来虽晚，不觉冥鸿去已孤。\n晓月犹临千里梓，春风又卷五云图。\n谁过南荡青山下，只恐高名自古无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太师中书令鲁国曾宣靖公挽词二首 其二","author":"王圭","text":"璧宫人去水潺潺，帝辇空临泪一潸。\n白玉荐樽陪庙食，黄金洒翰落碑颜。\n星辰掩霭移天上，桃李芬芳满世间。\n门外沙堤何日尽，只应阴施在银山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太师中书令鲁国曾宣靖公挽词二首 其一","author":"王圭","text":"熠熠台符切太微，满朝文物尽光辉。\n曾扶圣日攀云上，便向春风解组归。\n一代衣冠矜阀阅，同时父子筦枢机。\n人生富贵谁难致，八十如公自古稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太尉郑文肃公挽词二首 其二","author":"王圭","text":"星坠将军府，边山万木腓。\n谁言夜舟固，那复玉关归。\n旌旆低寒色，箫笳惨夕霏。\n所嗟恩馆泪，不到九泉挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe529429