[{"title":"真州次韵酬丁梦符见赠","author":"廖刚","text":"平生不许说功名，可但人嫌薄命人。\n松柏有心私自信，芝兰无臭自相亲。\n只今我亦乘轩鹤，何事公犹入幕宾。\n会看飞英霄汉上，方知满腹是精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵向伯恭发句同游西宫见寄","author":"廖刚","text":"久客倦尘鞅，薄游怜宝宫。\n论文欣得甫，载酒愧非雄。\n远岫入青眼，长江来好风。\n诗成故超绝，千里看花骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发仪真投宿山寺壁间见向伯恭留题因和其韵","author":"廖刚","text":"百年功利要深思，力屈才殚悔恐迟。\n万斛行船今足矣，千寻凿石古无之。\n谋疑箕子陈洪范，放□周公岂我欺。\n安得使轺虚采纳，免将无益害三时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬崔尚德检讨见寄","author":"廖刚","text":"规营端欲老渔樵，尚着青衫底百僚。\n长占广文眠雪夜，分无金谷度花朝。\n多惭软语怜根钝，纵与香名奈实聊。\n四海如公今有几，交情不逐岁寒凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬王元衷郎中兼简夷仲学士","author":"廖刚","text":"万里端尘鞅，栖息宁重论。\n相逢一笑乐，妙语如春温。\n谓我鬓颜好，包巾已霜根。\n问我田舍何，抱瓮犹欠园。\n跳丸转光景，岁月逝水奔。\n岂无究竟法，汗漫要穷源。\n柴桑公阙里，此意今故存。\n谁云王谢家，流风但清言。\n并游芸閤英，词辨江涛翻。\n久不一见之，清思濯襟烦。\n青冥双凤举，愧欲欺山樊。\n勉哉适其时，云尽天无痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋夜宿光州陈寨驿","author":"廖刚","text":"南来无侣路三千，八月荒村看月圆。\n独酌不成眠未得，静随寒影落天边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题蔡州柳庄铺","author":"廖刚","text":"云垂旷野路漫漫，策策秋声作莫寒。\n已分故园天样远，不知何处是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题鄢陵县驿","author":"廖刚","text":"区区望京国，京国何为哉。\n林泉佳处不肯住，尘埃窟里甘重来。\n此生何日遂所乐，扰扰随俗真堪哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郑觉先冬夜围炉示同舍","author":"廖刚","text":"碧瓦初寒夜，红炉拥邃亭。\n啸吟元俗调，商榷见全经。\n共拟蛾成螠，谁怜草化萤。\n疚心男子事，灯底看青萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别城西有感简元显","author":"廖刚","text":"前年出城西，祖饯长者辙。\n绿鬓豪伟郎，还镳共炎热。\n蜀道非天涯，暂离非永诀。\n况乃赴官期，留者思奋决。\n人情殊易堪，信未恶时节。\n今晨西城出，景物旧森列。\n金莲认高楼，感叹成哽咽。\n不见昔年人，还为昔年别。\n此别异昔年，骨月心欲折。\n此行异昔年，衰蹇方折阅。\n聊为稻粱谋，途窘计所拙。\n人生足忧患，乐事多歇灭。\n连年琼芘卷，荒寂人迹绝。\n况我薄命人，悲辛复何说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李全甫惠荼蘼五首 其一","author":"廖刚","text":"零落残红莺语歇，荼蘼正是花时节。\n金盘带露剪琼英，恐逐杨花舞飞雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李全甫惠荼蘼五首 其二","author":"廖刚","text":"春意不随桃李歇，香浓飘到薰风节。\n为君镇日守闲窗，绝胜当年映寒雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李全甫惠荼蘼五首 其三","author":"廖刚","text":"寂寞王孙游骑歇，香风何许追嘉节。\n故应金谷拥笙箫，独倚竛竮架头雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李全甫惠荼蘼五首 其四","author":"廖刚","text":"吹尽柳绵香不歇，仙姿那把春为节。\n枝头疏蝶解寻芳，忆得仙腰舞回雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李全甫惠荼蘼五首 其五","author":"廖刚","text":"脩竹弄风新雨歇，瑶英玉蕊攀高节。\n折来解恼北窗吟，只合闲拈映胸雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九书怀","author":"廖刚","text":"几年重几曾为客，今日黄花特地愁。\n北阙欢娱云杳蔼，南州消息雁沉浮。\n惊人节物应无奈，浪迹生平可但休。\n倚剑长吟楼阁暮，淡烟寒月不胜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和魏奉议九日夜饮县楼","author":"廖刚","text":"年登千室富桑麻，谁似弦歌度岁华。\n紫府剩延天上客，黄金同醉月中花。\n龙山胜集成追感，巴岭新篇许拜嘉。\n倚徙更怜灯火市，笙箫无数酒旗斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送崔浩然主簿","author":"廖刚","text":"平生才业笑时髦，唾手功名晚未遭。\n吏隐若为酬宝剑，仙游端欲探蟠桃。\n八龙不断声华籍，三戟应留气象豪。\n尽道此行归藻鉴，会看云翮背天高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺魏议生日","author":"廖刚","text":"闽山家处锁烟霞，喜气潜随律报葭。\n陆井效祥清骨相，梅丹呈瑞富才华。\n牛刀异绩聊千室，棣萼英声又一家。\n行看摩云上霄汉，定知仙种寿仍遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周材雪诗","author":"廖刚","text":"腊雪缘何喜，春工属此兴。\n宿苗沾润足，盭气涤除仍。\n乱舞随空远，轻黏彻体凝。\n漫天纷糁玉，极目皎铺缯。\n带雨声初急，抟风势转增。\n危檐飘邃幕，疏屋洒寒灯。\n瑟缩鸦栖怯，跳梁犬力胜。\n须臾平坎窞，顷刻没畦塍。\n梅李看山木，琼瑶数塔层。\n寝眠宁有道，赋咏愧非能。\n郭履愁离席，孙窗但枕肱。\n冻从金井水，清挹玉壶冰。\n银阙何劳问，云台取次登。\n渔蓑真好画，柳絮足多称。\n栗冽惊残岁，凄其忆旧明。\n戴君聊欲访，郢唱忽难应。\n绮席交银烛，清河映玉绳。\n诗成凌鲍谢，酒饮竭淄渑。\n天朗醒孤鹤，风高激怒鹏。\n齐宫初入梦，晓鼓数声鼟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"廖刚","text":"闻说长安少，祈求废寝兴。\n精禋俄感格，飘舞遽萦仍。\n剪水瑶花怯，摇风柳絮凝。\n共忻田有麦，谁念客无缯。\n洒迥春恩阔，侵窗晓色增。\n路漫三径草，光掩九华灯。\n栖鸟浑无托，渔舠渐弗胜。\n冈峦徒见陇，阡陌不留塍。\n庭玉堆盈尺，台云叠几层。\n困袁那有意，饱武亦何能。\n斗帐愁孤椀，围炉忆并肱。\n携瓶闲煮茗，坎地学藏冰。\n周雅何妨咏，燕山讵可登。\n齐宫当日景，谢句异时称。\n抱膝愁无侣，传笺喜得朋。\n郢歌元独妙，楚曲更相应。\n跛足惭追骥，凡材强就绳。\n汗颜从夺锦，痛饮欲临渑。\n喻问悬荀鹤，虞弦动沈鹏。\n故应聊遣兴，布鼓岂鼟鼟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙逸道供奉除夜作","author":"廖刚","text":"流光如转毂，诘旦又新年。\n律换铜壶漏，春回斗柄天。\n守灯须彻曙，分酒莫论钱。\n雪分琼瑶化，花看锦绣鲜。\n暗惊双鬓改，傍羡九官迁。\n俗礼还慵讲，从朝好昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和逸道春雪","author":"廖刚","text":"春雪未发春工浅，春雪濛溶翳日华。\n晓户玉楼迷旧燕，晓村琼树点寒鸦。\n笼金不碍莺穿柳，覆锦犹妨蝶恋花。\n凭仗东风吹更暖，桃源端欲访仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和焦器之春雪","author":"廖刚","text":"晓色初凝带月华，雰飞还见受风斜。\n红芳未遍人间景，白玉先开天上花。\n迤逦郊园迷别坞，蒙笼春水绕谁家。\n会须选胜乘新霁，倒载千秋小样车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张曼伯少府归长垣","author":"廖刚","text":"薄宦虚名岂所誇，千金归去旧生涯。\n百龄慈氏颜犹渥，三任仙郎鬓未华。\n雁信巳传芳字锦，鹊声应傍小窗纱。\n后园春色浓如酒，明日输君即到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题白马寺西轩","author":"廖刚","text":"幽窗残梦午声鸡，犬吠人家草舍微。\n惆怅十年无限事，又听啼鸟送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张必志秋怀三绝 其一","author":"廖刚","text":"夜雨阴风剑自声，几嗟牢落向江城。\n冷猿秋雁犹堪听，一寸古心谁与明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张必志秋怀三绝 其二","author":"廖刚","text":"芙蕖池馆酒杯残，策策秋声入夜寒。\n月照蓬窗耿无寐，起看星斗一长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张必志秋怀三绝 其三","author":"廖刚","text":"千古文章水一杯，功名谁是百无灾。\n悬知不改钩如曲，与子云山归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆陈氏旧寓","author":"廖刚","text":"数间茅屋冷如冰，久住与人亦有情。\n最忆蟠轩新种竹，夜深谁与听秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知点寄示入荆州学四绝句次其韵 其一","author":"廖刚","text":"吾属生涯事事迟，规营端与世间违。\n等闲庠序消寒暑，准拟三年看一飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知点寄示入荆州学四绝句次其韵 其二","author":"廖刚","text":"泮宫风化自岩廊，青佩雏莺学语忙。\n惭愧薄游聊有偈，不全无力赞垂裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知点寄示入荆州学四绝句次其韵 其三","author":"廖刚","text":"寒离北阙三冬雪，暖破南州二月风。\n欲访故人增感慨，霜蹄犹立马群中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知点寄示入荆州学四绝句次其韵 其四","author":"廖刚","text":"月照星河织女机，春风花草弄晴晖。\n楚宫台榭堪寻访，□见容斋数日归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答张德夫二首 其一","author":"廖刚","text":"十年归梦绕庭闱，薄分都缘触事迟。\n玩水看山宁所乐，此心犹赖有君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答张德夫二首 其二","author":"廖刚","text":"敢为骄骢惜障泥，烦将接淅问迟迟。\n直须日夜驰三百，惭愧吾人过月知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明应仲同游湘西诸寺有作次其韵","author":"廖刚","text":"几年京洛厌尘沙，青嶂长怀沈子胯。\n一苇渡江游客意，半岩营室梵王家。\n高轩满目罗诗匠，宝塔盈函贮佛牙。\n不觉下山红日晚，可堪重到杳无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵萧昭甫同游江东四绝句 其一 宝云寺","author":"廖刚","text":"山下烟光碧玉溪，竹间禅寂白云扉。\n高僧久住清凉国，应笑风尘满客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵萧昭甫同游江东四绝句 其二 马祖岩","author":"廖刚","text":"龙游龙归已绝尘，空馀顽石隐归云。\n当时一昔犹嫌久，岂谓虚名万古存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵萧昭甫同游江东四绝句 其三 尘外亭","author":"廖刚","text":"高出云端谢世喧，碧天秋静镜无痕。\n尘缘不向尘中见，聊与游人洗眼根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵萧昭甫同游江东四绝句 其四 天竺寺","author":"廖刚","text":"野塘风细度香莲，碧涧云深响玉泉。\n从此西湖不须到，淡烟寒月一家天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 宝云寺","author":"廖刚","text":"偶随鸥鸟度寒溪，寂寂禅关半掩扉。\n翠玉万竿迎晓履，欲凭风露濯尘衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 马祖岩","author":"廖刚","text":"去来踪迹等游尘，谁向蘧庐觅道根。\n岩穴故应无别异，镌题空有姓名存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 尘外亭","author":"廖刚","text":"林远浑无鸟雀喧，山青那觅烧霆痕。\n三千眼界云霄上，十万人家草树根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 天竺寺","author":"廖刚","text":"好山堆翠拥金莲，花屋笼云傍石泉。\n秋沼英蕖半开谢，直须饶占一壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抚州试院次韵王元衷上元作","author":"廖刚","text":"帘垂永日小亭幽，时节惊人特地愁。\n万井笙箫怀帝阙，一檐风雨寄他州。\n青藜定遣相辉映，绿蚁何妨共拍浮。\n不料篷窗今夜月，一时分付与高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张敏叔生辰","author":"廖刚","text":"渥洼从古产名驹，想见当年梦吉符。\n候协月轮周四极，史占昴宿降三吴。\n文章直使惊天听，志业端期列圣徒。\n七叶珥貂馀后庆，千秋遗庆足嘉谟。\n星轺暂驾恩弥渥，霜节才临政已孚。\n岂但平反无滥狱，会看调燮有真儒。\n南州喜气光千里，东阁清芬荐百壶。\n珍重公归庙堂后，老人长照帝王都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王守生辰七月十四日","author":"廖刚","text":"月华浑似十分圆，玉露金风处暑天。\n虎节端光凌碧汉，龙台佳气满晴川。\n扬鞭省闼声名籍，拥旆侯籓福禄骈。\n会看黑头丹衮贵，伊周勋业老彭年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵敏叔郁孤台作","author":"廖刚","text":"一目江天万里开，世间那有更高台。\n烟云缥缈千山迥，岛屿萦回二水来。\n爽气直疑侵斗汉，仙风应觉到樽罍。\n南州已见澄清日，大笔聊从赋早梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵望阙台作","author":"廖刚","text":"妙龄声价压群英，谁似青云早致身。\n帝阙日边迷远目，使星天上拱居辰。\n牟心肯向江湖老，衍律聊回涧谷春。\n万里夕红归去后，可能开府但清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉酬黄承务见寄","author":"廖刚","text":"孤标邂逅揖仙翁，白发青衫道不穷。\n敛板薄尝清世禄，拂衣早慕古人风。\n芝兰一室纷嚣外，冰玉诸郎顾盻中。\n何幸新诗先枉教，真游应许叩鸿蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招康朝小饮不至以诗来谢次韵戏答","author":"廖刚","text":"谁遣声名速置邮，不才如我自休休。\n知君只惯红裙饮，可是官身不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦授访及偶昏寝不见继以诗来次韵答之","author":"廖刚","text":"山城春色雨兼风，谁访扬雄寂寞中。\n知是高轩应倒屣，妙谈全胜梦周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱熙载会于洪井先解舟宿石头渚以二诗见寄一约同行一贺得子次韵答之 其一","author":"廖刚","text":"璧水相逢似梦中，天涯踪迹偶然同。\n为君鼓棹吹长笛，谁似乘流更御风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱熙载会于洪井先解舟宿石头渚以二诗见寄一约同行一贺得子次韵答之 其二","author":"廖刚","text":"主祀传家已倍迟，便须真是桂林枝。\n他年不愧琼瑶赠，应被人言跳灶儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭荆奴","author":"廖刚","text":"平生惟一女，宝惜岂珠玉。\n夫妻递襁抱，犊软舐未足。\n上天胡忍予，谴罚不容赎。\n沉痾遽汝萦，微息竟莫续。\n痛哉伤我神，恍若失飞鹄。\n追惟百牵肠，展转损心曲。\n忆昨将汝归，万里自荆蜀。\n篮舆共先后，百步能我瞩。\n汝母惜可知，拥坐甘蹐局。\n长途亦云劳，不觉度炎酷。\n今后当远行，□门述蹢躅。\n相看怀抱空，将领但妾仆。\n心折疑巳碎，泪甚冲风烛。\n念汝生少啼，起卧洁絣褥。\n谓当非凡孩，岂料两岁促。\n意余积不厘，汝故弗为属。\n长江漂玉尘，兹事未免俗。\n遗踪仅何有，肠断发毬绿。\n情知东门达，敢取西河辱。\n要识父母心，吾诗尚堪录。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抚州次韵李成德桃李花诗","author":"廖刚","text":"韶光端许见分明，白雪缃云意态轻。\n天艳静中迎客笑，静妆闲里照人清。\n不教乱落从风恶，聊看交加待月生。\n却忆后园应更好，幽闺春夜若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵知府中奉登郁孤诗","author":"廖刚","text":"隼旆飞扬百仞台，满城佳气静氛埃。\n烟云渺渺江流去，花木欣欣春思回。\n妙舞人传天上曲，暗香风度岭头梅。\n金莲影散蓬壸夜，馀兴应留继日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同前和书事","author":"廖刚","text":"闻说幽栖久凤台，白云巾履谢风埃。\n三刀不是尘缘在，五裤争教暖律回。\n金谷分无人载酒，玉京应有使传梅。\n今看一举登黄闼，绝胜河东谩去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上提刑中散生日","author":"廖刚","text":"豆蔻梢头春欲妍，历山高下覆祥烟。\n祗今骐骥腾千里，当日麒麟下九天。\n中渭早芬廷尉誉，集贤行峻曲江迁。\n貂蝉奕世真馀事，愿比灵椿赋大年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬纯通判","author":"廖刚","text":"灵椿长幸荫衡门，阶草何妨晚见春。\n骏种也知惭冀北，病怀聊为释漳滨。\n名家正恐非兰玉，瑞世宁当是凤麟。\n谁道添丁无足庆，竞传佳句一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠万花翁","author":"廖刚","text":"武陵溪上万花翁，花落花开醉脸红。\n应笑误游尘世客，却随风水去匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏谢万花翁","author":"廖刚","text":"风流那复有斯翁，端为论文访蜀雄。\n凤髓欲追千古调，锦囊弃著一生功。\n看花想见频挥玉，骑马何曾羡着红。\n闻道碧桃春更晚，归鞭底事苦匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题归安寺","author":"廖刚","text":"马足车轮恋日闱，几人高遁蹈家肥。\n少陵秪为趋朝懒，万里云山取次归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]