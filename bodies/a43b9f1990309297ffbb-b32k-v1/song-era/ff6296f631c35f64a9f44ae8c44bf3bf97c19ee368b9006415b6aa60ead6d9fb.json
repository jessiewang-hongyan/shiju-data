[{"title":"蝶恋花 其三","author":"晏几道","text":"庭院碧苔红叶遍，金菊开时，已近重阳宴。\n日日露荷凋绿扇，粉塘烟水澄如练。\n试倚凉风醒酒面，雁字来时，恰向层楼见。\n几点护霜云影转，谁家芦管吹秋怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其八","author":"晏几道","text":"欲减罗衣寒未去，不卷珠帘，人在深深处。\n残杏枝头花几许，啼红正恨清明雨。\n尽日沉香烟一缕，宿酒醒迟，恼破春情绪。\n远信还因归燕误，小屏风上西江路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其十四","author":"晏几道","text":"梦入江南烟水路。\n行尽江南，不与离人遇。\n睡里消魂无说处。\n觉来惆怅消魂误。\n欲尽此情书尺素。\n浮雁沈鱼，终了无凭据。\n却倚缓弦歌别绪。\n断肠移破秦筝柱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其十二","author":"晏几道","text":"碧落秋风吹玉树，翠节红旌，晚过银河路。\n休笑星机停弄杼，凤帏已在云深处。\n楼上金针穿绣缕，谁管天边，隔岁分飞苦。\n试等夜阑寻别绪，泪痕千点罗衣露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"晏几道","text":"喜鹊桥成催凤驾，天为欢迟，乞与初凉夜。\n乞巧双蛾加意画，玉钩斜傍西南挂。\n分钿擘钗凉叶下，香袖凭肩，谁记当时话。\n路隔银河犹可借，世间离恨何年罢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其九","author":"晏几道","text":"千叶早梅夸百媚，笑面凌寒，内样妆先试。\n月脸冰肌香细腻，风流新称东君意。\n一捻年光春有味，江北江南，更有谁相比。\n横玉声中吹满地，好枝长恨无人寄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"晏几道","text":"卷絮风头寒欲尽，坠粉飘红，日日成香阵。\n新酒又添残酒困，今春不减前春恨。\n蝶去莺飞无处问，隔水高楼，望断双鱼信。\n恼乱层波横一寸，斜阳只与黄昏近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"晏几道","text":"初捻霜纨生怅望，隔叶莺声，似学秦娥唱。\n午睡醒来慵一晌，双纹翠簟铺寒浪。\n雨罢蘋风吹碧涨，脉脉荷花，泪脸红相向。\n斜贴绿云新月上，弯环正是愁眉样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其十一","author":"晏几道","text":"笑艳秋莲生绿浦，红脸青腰，旧识凌波女。\n照影弄妆娇欲语，西风岂是繁花主。\n可恨良辰天不与，才过斜阳，又是黄昏雨。\n朝落暮开空自许，竟无人解知心苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其七","author":"晏几道","text":"醉别西楼醒不记，春梦秋云，聚散真容易。\n斜月半窗还少睡，画屏闲展吴山翠。\n衣上酒痕诗里字，点点行行，总是凄凉意。\n红烛自怜无好计，夜寒空替人垂泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"晏几道","text":"金剪刀头芳意动，彩蕊开时，不怕朝寒重。\n晴雪半消花□□，晓妆呵尽香酥冻。\n十二楼中双翠凤，缥缈歌声，记得江南弄。\n醉舞春风谁可共，秦云已有鸳屏梦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其十五","author":"晏几道","text":"黄菊开时伤聚散。\n曾记花前，共说深深愿。\n重见金英人未见。\n相思一夜天涯远。\n罗带同心闲结遍。\n带易成双，人恨成双晚。\n欲写彩笺书别怨。\n泪痕早已先书满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其五","author":"晏几道","text":"碧草池塘春又晚，小叶风娇，尚学娥妆浅。\n双燕来时还念远，珠帘绣户杨花满。\n绿柱频移弦易断，细看秦筝，正似人情短。\n一曲啼乌心绪乱，红颜暗与流年换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其六","author":"晏几道","text":"碾玉钗头双凤小。\n倒晕工夫，画得宫眉巧。\n嫩曲罗裙胜碧草。\n鸳鸯绣字春衫好。\n三月露桃芳意早。\n细看花枝，人面争多少。\n水调声长歌未了。\n掌中杯尽东池晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其十三","author":"晏几道","text":"碧玉高楼临水住，红杏开时，花底曾相遇。\n一曲阳春春已暮，晓莺声断朝云去。\n远水来从楼下路，过尽流波，未得鱼中素。\n月细风尖垂柳渡，梦魂长在分襟处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其一","author":"晏几道","text":"柳上烟归，池南雪尽，东风渐有繁华信。\n花开花谢蝶应知，春来春去莺能问。\n梦意犹疑，心期欲近，云笺字字萦方寸。\n宿妆曾比杏腮红，忆人细把香英认。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其二","author":"晏几道","text":"宿雨收尘，朝霞破暝，风光暗许花期定。\n玉人呵手试妆时，粉香帘幕阴阴静。\n斜雁朱弦，孤鸾绿镜，伤春误了寻芳兴。\n去年今日杏墙西，啼莺唤得闲愁醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其三","author":"晏几道","text":"绿径穿花，红楼压水，寻芳误到蓬莱地。\n玉颜人是蕊珠仙，相逢展尽双蛾翠。\n梦草闲眠，流觞浅醉，一春总见瀛洲事。\n别来双燕又西飞，无端不寄相思字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其四","author":"晏几道","text":"雪尽寒轻，月斜烟重，清欢犹记前时共。\n迎风朱户背灯开，拂檐花影侵帘动。\n绣枕双鸳，香苞翠凤，从来往事都如梦。\n伤心最是醉归时，眼前少个人人送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄 其二","author":"晏几道","text":"鸾孤月缺，两春惆怅音尘绝。\n如今若负当时节，信道欢缘，狂向衣襟结。\n若问相思何处歇，相逢便是相思彻。\n尽饶别后留心别，也待相逢，细把相思说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄 其一","author":"晏几道","text":"满街斜月，垂鞭自唱阳关彻。\n断尽柔肠思归切，都为人人，不许多时别。\n南桥昨夜风吹雪，短长亭下征尘歇。\n归时定有梅堪折。\n欲把离愁，细捻花枝说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其四","author":"晏几道","text":"休休莫莫。\n离多还是因缘恶。\n有情无奈思量著。\n月夜佳期，近写青笺约。\n心心口口长恨昨。\n分飞容易当时错。\n后期休似前欢薄。\n买断青楼，莫放春闲却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其三","author":"晏几道","text":"天教命薄。\n青楼占得声名恶。\n对酒当歌寻思著。\n月户星窗，多少旧期约。\n相逢细语初心错。\n两行红泪尊前落。\n霞觞且共深深酌。\n恼乱春宵，翠被都闲却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺","author":"晏几道","text":"莲叶雨，蓼花风，秋恨几枝红。\n远烟收尽水溶溶，飞雁碧云中。\n衷肠事，鱼笺字，情绪年年相似。\n凭高双袖晚寒浓，人在月桥东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其七","author":"晏几道","text":"题破香笺小砑红，诗篇多寄旧相逢。\n西楼酒面垂垂雪，南苑春衫细细风。\n花不尽，柳无穷。\n别来欢事少人同。\n凭谁问取归云信，今在巫山第几峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"晏几道","text":"小令尊前见玉箫，银灯一曲太妖娆。\n歌中醉倒谁能恨，唱罢归来酒未消。\n春悄悄，夜迢迢，碧云天共楚宫遥。\n梦魂惯得无拘检，又踏杨花过谢桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十五","author":"晏几道","text":"小玉楼中月上时，夜来惟许月华知。\n重帘有意藏私语，双烛无端恼暗期。\n伤别易，恨欢迟，归来何处验相思。\n沈郎春雪愁消臂，谢女香膏懒画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十七","author":"晏几道","text":"九日悲秋不到心，凤城歌管有新音。\n风凋碧柳愁眉淡，露染黄花笑靥深。\n初见雁，已闻砧，绮罗丛里胜登临。\n须教月户纤纤玉，细捧霞觞滟滟金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十三","author":"晏几道","text":"陌上濛濛残絮飞，杜鹃花里杜鹃啼。\n年年底事不归去，怨月愁烟长为谁。\n梅雨细，晓风微，倚楼人听欲沾衣。\n故园三度群花谢，曼倩天涯犹未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十二","author":"晏几道","text":"十里楼台倚翠微，百花深处杜鹃啼。\n殷勤自与行人语，不似流莺取次飞。\n惊梦觉，弄晴时，声声只道不如归。\n天涯岂是无归意，争奈归期未可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六","author":"晏几道","text":"当日佳期鹊误传，至今犹作断肠仙。\n桥成汉渚星波外，人在鸾歌凤舞前。\n欢尽夜，别经年，别多欢少奈何天。\n情知此会无长计，咫尺凉蟾亦未圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"晏几道","text":"一醉醒来春又残，野棠梨雨泪阑干。\n玉笙声里鸾空怨，罗幕香中燕未还。\n终易散，且长闲，莫教离恨损朱颜。\n谁堪共展鸳鸯锦，同过西楼此夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四","author":"晏几道","text":"守得莲开结伴游，约开萍叶上兰舟。\n来时浦口云随棹，采罢江边月满楼。\n花不语，水空流，年年拚得为花愁。\n明朝万一西风动，争向朱颜不耐秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十六","author":"晏几道","text":"手捻香笺忆小莲，欲将遗恨倩谁传。\n归来独卧逍遥夜，梦里相逢酩酊天。\n花易落，月难圆，只应花月似欢缘。\n秦筝算有心情在，试写离声入旧弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十一","author":"晏几道","text":"楚女腰肢越女腮，粉圆双蕊髻中开。\n朱弦曲怨愁春尽，渌酒杯寒记夜来。\n新掷果，旧分钗，冶游音信隔章台。\n花间锦字空频寄，月底金鞍竟未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十八","author":"晏几道","text":"碧藕花开水殿凉，万年枝外转红阳。\n升平歌管随天仗，祥瑞封章满御床。\n金掌露，玉炉香，岁华方共圣恩长。\n皇州又奏圜扉静，十样宫眉捧寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十九","author":"晏几道","text":"绿橘梢头几点春，似留香蕊送行人。\n明朝紫凤朝天路，十二重城五碧云。\n歌渐咽，酒初醺，尽将红泪湿湘裙。\n赣江西畔从今日，明月清风忆使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"晏几道","text":"彩袖殷勤捧玉钟，当年拚却醉颜红。\n舞低杨柳楼心月，歌尽桃花扇底风。\n从别后，忆相逢，几回魂梦与君同。\n今宵剩把银釭照，犹恐相逢是梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其八","author":"晏几道","text":"清颍尊前酒满衣，十年风月旧相知。\n凭谁细话当时事，肠断山长水远时。\n金凤阙，玉龙墀，看君来换锦袍时。\n姮娥已有殷勤约，留着蟾宫第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十四","author":"晏几道","text":"晓日迎长岁岁同，太平箫鼓间歌钟。\n云高未有前村雪，梅小初开昨夜风。\n罗幕翠，锦筵红，钗头罗胜写宜冬。\n从今屈指春期近，莫使金尊对月空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其九","author":"晏几道","text":"醉拍春衫惜旧香，天将离恨恼疏狂。\n年年陌上生秋草，日日楼中到夕阳。\n云渺渺，水茫茫，征人归路许多长。\n相思本是无凭语，莫向花笺费泪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"晏几道","text":"梅蕊新妆桂叶眉，小莲风韵出瑶池。\n云随绿水歌声转，雪绕红绡舞袖垂。\n伤别易，恨欢迟，惜无红锦为裁诗。\n行人莫便消魂去，汉渚星桥尚有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五","author":"晏几道","text":"斗鸭池南夜不归，酒阑纨扇有新诗。\n云随碧玉歌声转，雪绕红琼舞袖回。\n今感旧，欲沾衣，可怜人似水东西。\n回头满眼凄凉事，秋月春风岂得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程给事知越州","author":"晏知止","text":"遍历侯藩治绩高，瀛州琐闼奉思褒。\n麟符又入千岩境，鹢舰还乘八月涛。\n田赖鉴湖常岁美，客游梅市有人豪。\n从来梦锦耽佳句，应接江山岂惮劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁卯上元灯夕 其一","author":"晏殊","text":"九衢风静烛无烟，宝马香车往复还。\n三十二天应降瑞，尽移星斗照人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁卯上元灯夕 其二","author":"晏殊","text":"百万人家户不扃，管弦灯烛沸重城。\n游车正满章台陌，为报天鸡莫浪鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"晏几道","text":"云幕无波斗柄移，鹊慵乌慢得桥迟。\n若教精卫填河汉，一水还应有尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月八日游涡","author":"晏殊","text":"黄花夹径疑无路，红叶临流巧胜春。\n前去重阳犹一日，不辞倾尽蚁醪醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳琼林苑宴二府同游池上即事口占 其一","author":"晏殊","text":"殿后花枝白间红，楼前当道绿杨风。\n横飞綵槛波光外，倒写朱阑水影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳琼林苑宴二府同游池上即事口占 其二","author":"晏殊","text":"曲榭回廊手伎喧，綵楼朱舫鼓声繁。\n游人已著浓春去，不待歌长舞袖翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳琼林苑宴二府同游池上即事口占 其三","author":"晏殊","text":"春留融冶日添长，万品无涯入醉乡。\n谁道人间泛仙境，水心楼殿半斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳赐宴琼林与二府诸公游水心憩于西轩 其二","author":"晏殊","text":"咽云箫鼓传声沸，临水楼台倒影多。\n吟绕曲栏无限思，绪风迟日满烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳赐宴琼林与二府诸公游水心憩于西轩 其一","author":"晏殊","text":"三月杨花飞似雪，内园桂树绿成阴。\n何妨写尽凭高意，十步虹桥彻水心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元","author":"晏殊","text":"金翠光中宝焰繁，山楼高下鼓声喧。\n两军伎女轻如鹘，百尺竿头电线翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元日诣昭应宫分献凝命殿以宪职不预班独归书事","author":"晏殊","text":"别殿香三炷，斜廊酒一杯。\n官闲非侍从，骑马却归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中书即事","author":"晏殊","text":"惨惨高槐落，凄凄馀菊寒。\n粉墙多记墨，聊为拂尘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋月 其一","author":"晏殊","text":"一轮霜影转庭梧，此夕羁人独向隅。\n未必素娥无怅恨，玉蟾清冷桂华孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕","author":"晏殊","text":"星粲宝灯连九市，水流香毂渡千门。\n姮娥似有随人意，柳际花前月半昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其一 内廷","author":"晏殊","text":"玉殿初晨淑气和，璧池冰解水生波。\n龟台圣母增年历，万寿无疆积庆多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其一 东宫阁","author":"晏殊","text":"铜龙楼下早春归，三朔元辰在此时。\n椒柏暖风浮玉斝，两宫称庆奉皇慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其一 御阁","author":"晏殊","text":"莺谷春风柳上归，禁闱芳树渐依依。\n尧年亿万如天远，万国欢心拱太微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其二 内廷","author":"晏殊","text":"献寿椒花泛渌醪，迎祥朱户怙仙桃。\n彤庭玉殿炉烟起，霭霭卿云瑞日高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其二 东宫阁","author":"晏殊","text":"条风发动协初辰，玄圃瑶山景象新。\n千载百灵资介福，沧溟重润月重轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其二 御阁","author":"晏殊","text":"屠苏醴酒盈金斝，郁垒神符卫紫关。\n三境上真垂介福，绵绵洪算等南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其三 内廷","author":"晏殊","text":"池冰初解雪初消，十二重城晓日高。\n飒飒和风绕珠树，千年春色在蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其三 御阁","author":"晏殊","text":"南国雕胡奉紫庭，九重楼阁瑞云生。\n丹毫玉策延洪算，八表欢娱四海清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日词 其四 内廷","author":"晏殊","text":"三百六旬初一日，四时嘉序太平年。\n霓衣绛节修真箓，步武祥云奉九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]