[{"title":"偈颂一百零四首 其七十五","author":"释绍昙","text":"铁团栾，无缝罅。\n上下三指，彼此七马。\n德山临济，眼见如盲，云门赵州，口说如哑。\n拄杖子，忍俊不禁，等闲捉败。\n休休，尽法恐无民，且放天寒赦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十三","author":"释绍昙","text":"春山青，春水绿，鸟弄笙簧，梅飘香玉。\n具足清白梵行之相，声色纯真岂容攒簇。\n听不足，观不足，一会灵山俨未分，断弦须是鸾胶续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十九","author":"释绍昙","text":"幕挂春烟，簟铺秋水。\n高枕横眠，鼻雷聒耳。\n烁石流金总不知，何须殿阁薰风至。\n又谁管九十日种粟烧畬，说甚么十三番悟明自己。\n灼然是个无烦恼，阎家倒退三千里。\n其或未然，莫道瓮中常有米。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十三","author":"释绍昙","text":"未有清规，人能弘道。\n才涉典章，翻成机巧。\n华屋春风锦绣围，草庐不见人高卧。\n哑，刻粪为香，是谁之过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十二","author":"释绍昙","text":"道教灰飞，佛灯花灿。\n大地欢悰，笙歌赏玩。\n拄杖子，按下云头，得失是非，浑然不管。\n一点光明耀十虚，古今阅几平人眼。\n因甚如此，司空见惯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十二","author":"释绍昙","text":"秋气肃金，秋旸鏖战。\n林间秋叶片片凋零，砌下秋虫声声凄怨。\n满眼听不闻，满耳觑不见。\n听得闻，觑得见，声前句后新罗箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其一○三","author":"释绍昙","text":"有一物，全机用。\n尘劳之俦，如来之种。\n轻若鸿毛轻，重若丘山重。\n乳峰信手拈来，点破劳生尘梦。\n刚被秋虫落叶知，清声戛玉寒，翠色黄金弄。\n虽然不直分文，掷地金声，令人惊悚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十九","author":"释绍昙","text":"闻道金轮出母胎，尽河沙界扫氛埃。\n想应新整乾坤手，多带尧风舜日来。\n普天率土，寿域宏开。\n林下野人何祝献，一茎草上玉楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十九","author":"释绍昙","text":"凿透耳聋，板夹背伛。\n只要医行，不管人苦。\n拄杖子，不别时宜，强行直路。\n大地羊肠绕棘林。\n何处去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七","author":"释绍昙","text":"雕梁燕语，乔木莺吟。\n秋田水足，麦岭云深。\n声色纯真浑声色，无端花擘祖师心。\n耳无轮，眼无筋。\n优游子圣外，阆荡拾花针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九","author":"释绍昙","text":"乳窦翠峰，何分彼此。\n遂府糖霜，口甜心苦。\n灭却云门一字宗，断崖飞瀑冤难诉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三","author":"释绍昙","text":"大觉无心，九峰饶舌。\n较短量长，家私漏泄。\n引惹平人入祸门，金刚脑后抽生铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十三","author":"释绍昙","text":"目前机，真实相。\n张都料轮材底轮材，李作头?磉底?磉。\n动静奚分两处看，太平基业初无象。\n迥出常情，与谁共赏。\n佳客欢呼自往来，瑞岩拍掌仙岩唱。\n潦倒庞公，精神迭宕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十二","author":"释绍昙","text":"布关雎化袭宫闱，万国人趋奉母仪。\n寿结蟠桃千载实，年年天仗宴瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十四","author":"释绍昙","text":"飘蓬四十馀年，梦绕晶然山路。\n才见广安军人，便忆破庵师祖。\n摵破碎沙盆，打动虾蟆鼓。\n惊落蛟龙虎兕威，知音不在频频举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十七","author":"释绍昙","text":"合水和泥，打成一片。\n脱却胚腪，重加煅炼。\n渗漏全无盖覆人，平地升高乘快便。\n若非众手出力扶持，心印蒙尘，光难发现。\n美则美矣，只如古人道，明堂瓦插檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十八","author":"释绍昙","text":"道无可成，法无可说。\n黄面瞿昙，重重败缺。\n家丑岂容外泄，刚被儿孙告讦。\n图形画影与人看，乳窦门风添暖热。\n彷彷佛佛，一似阆州城南锦屏山，子细看来，却是鹿苑衔花，竺峰积雪。\n添得时人眼中屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十六","author":"释绍昙","text":"天高地厚，水阔山遥。\n古今常理，何用忉忉。\n衲僧家，脚跟下一段光明，十日并照，明察秋毫。\n不拣侯门射策，何须华顶降魔。\n孤迥迥，冷萧萧，无端翻黑月，魑魅哭连宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十六","author":"释绍昙","text":"大慈苕帚生，倒拈风飒飒。\n扫尽大地尘，赵州惊吐舌。\n蓦劄相逢玉乳峰，殷勤为扫寒岩雪。\n拄杖子，爱客情深，把火助热。\n卓破苔钱画断云，放出寒梅南枝北枝，一花两花三四花。\n疏影横溪，暗香浮月，无端尽把春容泄。\n清不彻恼碎心，广平似铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八","author":"释绍昙","text":"宿雨初晴，岚光翠滴。\n瀑泻悬崖，云笼怪石。\n无位真人，面门出入。\n净地上不许狼籍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十六","author":"释绍昙","text":"隰州佛放光，远射千峰顶。\n锦镜冷交辉，瀑花寒斗影。\n非虚非实，非色非空。\n举世无人描邈得，只凭这个为流通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十七","author":"释绍昙","text":"道至无难，惟嫌拣择。\n混俗通真，骑声盖色。\n近在口皮边，远过河沙国。\n慈明揭示，借鬼画桃符。\n雪窦标题，去猊悬白泽。\n一见便见，迅雷陶壁奋飞梭。\n拟议寻思，逆浪禹门遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十六","author":"释绍昙","text":"一湖横陈，七峰环绕。\n妙转玄枢，死生关破。\n去何有偈，流水渡百滩，来本无言，疾风号万窍。\n更问如何与若何，珍重便行。\n髑髅前失照，断猿哭月千林晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其一○一","author":"释绍昙","text":"三界炎炎如火聚，搅扰劳生困蒸煮。\n邪见稠林蔽祖庭，孰为临济阴凉树。\n拄杖子，回避无门，全身荷负。\n特立独行，危分险布。\n扫除枝叶不留踪，普覆大地人，彻骨清凉去。\n虽然如是，赵婆酤醋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十五","author":"释绍昙","text":"光明幢，如来藏。\n八面玲珑，十方通畅。\n拭佛祖大病之疮疣，见鬼神幽愁之情状。\n抬你爷，抬你娘，抬上方丈，洞山宁免无根谤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十三","author":"释绍昙","text":"三度拂蒿枝，秦时?轹钻。\n拶得火星飞，结得弓弦断。\n用尽自己心，瞎却他人眼。\n千里玄枢错踏翻，神驹十影无羁绊。\n业风吹上乳窦峰前，点一杯茶向伊道，且缓缓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十二","author":"释绍昙","text":"灵山话月，曹溪指月。\n玉乳峰前，相呼看月。\n纵饶光透十虚，未免成第二月。\n诸人要见真月么，非暗非明，非圆非缺。\n无物堪比伦，教我如何说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十一","author":"释绍昙","text":"金轮王宅，恶业无多。\n不知何事，生此妖魔。\n打与狗噇顽不杀，好将恶水劈头浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十九","author":"释绍昙","text":"大众问讯，侍者烧香。\n曲录棚上，说黑道黄。\n七世冤憎同劫会，泥犁拔舌自担当。\n麟凤出时山总秀，芝阑生处草俱芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十八","author":"释绍昙","text":"无忧树下风如箭，九龙吐出水含毒。\n涓滴沾身痛入心。\n霎时吹面刀剜肉。\n不知悉达为何因，才出母胎罹此酷。\n后代儿孙忍见渠，一年一度香汤浴。\n我今灌沐诸如来，净智庄严功德聚，只恐不是玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十七","author":"释绍昙","text":"鉴在机先，妙在转处。\n碧眼胡儿，全无肯路，行一步是一步。\n信脚错踏翻，大地无寸土。\n业风吹上乳窦山，来点一杯茶，徐徐向伊道，提鞋去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十一","author":"释绍昙","text":"黄河清，圣人生。\n体天行健，浚哲文明。\n率土更新尧舜化，八荒无地著欢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其一","author":"释绍昙","text":"殿成不必拆，佛生何用打。\n烧炷兜楼香，共说家私话。\n以力假人者霸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十八","author":"释绍昙","text":"翳眼药，文武火。\n用得亲，煨得过。\n翠岩落尽眉毛眼愈明，乳窦烂却皮肤骨将槁。\n家丑分明说向谁，握手松根忘汝我。\n冷地思量，訚訚而笑。\n曾陷迷魂八阵图，梦中惊入夔门道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十五","author":"释绍昙","text":"活衲僧，生铁铸。\n吐出铁心肝，挂起铁面具。\n蚊子上铁牛，无你啖啄处。\n素纨摇月，碧帐含烟。\n或放或收皆在我，长伸两脚放憨眠。\n灼然如是，天地相悬。\n开眼不知天大晓，阎家催索水浆钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十七","author":"释绍昙","text":"薄福住山，百无所取。\n何以表勤，惟诚为主。\n祈晴便得晴，祈雨便得雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十二","author":"释绍昙","text":"锦镜浓妆十样花，练拖寒瀑挂苍崖。\n无宾主句全机露，见得分明眼著砂。\n依亡妙尽，犹隔天涯。\n夺取黄梅无底钵，且教卢老去担柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十","author":"释绍昙","text":"松顶雪簪花，山头云裹帽。\n呼唤贺元正，粲发溪声笑。\n一不成单，二无两个。\n漏泄元元化母机，春风未必能包裹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其一○五","author":"释绍昙","text":"地上翻瓢，眉间挂剑。\n古道虽微，恶声难掩。\n穷则通，通则变。\n倒跨杨岐三脚驴，踏破山前祖父田园，一片两片，四五六七片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十八","author":"释绍昙","text":"五十三年行脚，走遍天涯海角。\n早知唐丧光阴，悔不闭门独活。\n古松下苔石憨眠，野溪边筇枝倒卓。\n幽鸟啼春水奏流，凑成一曲村田乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十七","author":"释绍昙","text":"瑞岩唤醒主人翁，把手经行禁网中。\n踏断纲宗开活眼，笑听山鸟话家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十五","author":"释绍昙","text":"十万同聚会，个个学无为。\n此是选佛场，心空及第归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十三","author":"释绍昙","text":"松下扫除青草径，涧边开辟绿阴亭。\n饭馀握手闲行坐，唱曲山歌贺太平。\n遏云古调，流水新声。\n眼里无筋听不足，临风击碎圣凡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十二","author":"释绍昙","text":"瑞岩频唤主人翁，彻底惺惺不若聋。\n裂尽见闻行活路，乡关犹隔海千重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十一","author":"释绍昙","text":"大地踏翻无寸土，昆虫介甲绝行踪。\n护生禁足元勋在，圆觉伽蓝一扫空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十","author":"释绍昙","text":"腊月三十日，腊月二十九。\n等是岁华终，无事穷相守。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其三","author":"释绍昙","text":"万里无寸草，出门便是草。\n支筇寂寞中，望断无人到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼芳洲忏首 其二","author":"释绍昙","text":"烟渚春融岸碧绡，采兰人竞唱离骚。\n曲终翻作无生调，听著愁魂似雪消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅窗","author":"释绍昙","text":"溢目湖山看不足，引清吟有此云房。\n檐牙挂月横疏影，隙眼通风度暗香。\n夜掩只疑和靖宅，晓开争看寿阳妆。\n兰兄矾弟休相怜，斗室难为纳众芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪矶","author":"释绍昙","text":"访戴归来就系舟，冻云凝锁玉花浮。\n渔蓑钓罢寻盟去，近岸不知飞白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪崖 其一","author":"释绍昙","text":"壁立千寻度玉风，绝扪摩处有行踪。\n草鞋踏出毗卢印，见得分明隔万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山题诗赞","author":"释绍昙","text":"国清窃得残羹饭，也学人前弄竹篙。\n欲写断崖无活句，心如秋月待如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惺惺石","author":"释绍昙","text":"主人翁已强安名，何待区区唤一声。\n坐得石头穿透底，依然打个不惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智者大师迁葬图赞","author":"释绍昙","text":"当年杜撰讲天台，活被平人掘窖埋。\n若是黄金铸灵骨，臭尸不到鬼扛抬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳穿破衲赞","author":"释绍昙","text":"死铁针，无鼻窍。\n眼昏花，穿不过。\n穿得过，云拥禅衣，风生木杪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳赞 其一","author":"释绍昙","text":"破襕衫，闲抖擞。\n穴鼻针，穿不透。\n穿得透，日出扶桑，朝朝如旧。\n无丝线，拽不断。\n尽力提撕，日势稍晚，驴年成片段。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳赞 其二","author":"释绍昙","text":"拶得当阳线路通，大千捏聚一针锋。\n不堪提掇堪提掇，破绽全无始见功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游九峰 其一","author":"释绍昙","text":"攀石扪萝入杳冥，凌虚潜觉胆魂惊。\n阴崖撷瀑瑶花碎，枯叶翻霜锦树荣。\n汲水僧归龙洞去，采薇人踏虎踪行。\n风流二老遗音在，度曲松涛万壑清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山塔 其一","author":"释绍昙","text":"衲僧毛病没星星，刚被傍人授记成。\n万壑松涛撼明月，隔溪误认倒屙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"缘侍者之浙右","author":"释绍昙","text":"一本潼川花瑞菜，全蜀知名谁不爱。\n夜雨丛凝色染蓝，春风花噀香如麝。\n不知何处得灵根，栽遍牛头山后前。\n古佛低头看不厌，声闻鼻孔被渠穿。\n上人携种游江浙，味与首阳薇不别。\n伏虎岩前清客尝，老饕嚼断娘生舌。\n馀香分饷老芝峰，彷佛家园小摘同。\n此去零星休卖弄，珍藏大作苏陀供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舜兄南山为僧后归东林","author":"释绍昙","text":"新生白额眼光摇，肯向南山恋旧巢。\n背踏西风行一转，人惊不过虎溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舜侍者以拙自处请语为警","author":"释绍昙","text":"大地人求巧，子独全其拙。\n吃饭倒把匙，刺眼翻著袜。\n只知困守株，不愁飞辩月。\n天真未解分，混沌一团铁。\n抱璞寻炉锤，巧手难施设。\n朅来就拙玲珑阴，毡拍板合无弦琴。\n摘杨黄花嗑然笑，樵童牧竖皆知音。\n岂不见棱道者，破七蒲团无缝罅。\n鬼窟翻身呼大差，卷起帘来见天下。\n又不见隆藏主，此是吾家睡虎子。\n气肃西风牙爪露，千林扫迹无狐兔。\n须知巧自拙中出，巧拙到头无处觅。\n无寻觅处知端的，急来与汝粗拳吃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋梅","author":"释绍昙","text":"雪边春信到衡茅，谁遣梅兄慰寂寥。\n秀气一枝抽嫩玉，寒英五叶剪生绡。\n月移疏影窗前挂，风递清香竹外飘。\n几许吟魂招不返，急催兰弟读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋永明惟心诀","author":"释绍昙","text":"心已强名，诀从何来。\n永明剜肉作疮，何山隔壁猜谜。\n急急将来付丙丁，大丈夫儿休拟议。\n如拟议，三级浪高鱼化龙，痴人犹戽夜塘水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋禅会图","author":"释绍昙","text":"禅既强名，会亦妄立。\n一火无知，打棚杂剧。\n百样乔妆诳世人，千般怪语瞒天日。\n若是本色行家，不打这般鼓笛。\n画影图形转弗堪，丛林千古成狼籍。\n不狼籍，留与仁禅遮破壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]