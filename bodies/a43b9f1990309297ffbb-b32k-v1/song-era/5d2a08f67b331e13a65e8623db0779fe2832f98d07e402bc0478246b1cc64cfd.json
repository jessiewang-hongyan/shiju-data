rovenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃","author":"丁谓","text":"未展蓁蓁叶，先开灼灼华。\n武陵迷境域，御宿接烟霞。\n投我畴为报，偷儿孰是家。\n春风南北起，别有洛阳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐","author":"丁谓","text":"托质朝阳地，含芳改火时。\n锡圭裁细叶，栖凤养深枝。\n双树怜银井，孤生称檿丝。\n龙门高百尺，梓漆让华滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桥","author":"丁谓","text":"鞭石滔滔远，填乌岁岁新。\n七星横巨浸，半月映长津。\n永固骞崩势，终无揭厉因。\n时逢题柱客，不见脱辀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海","author":"丁谓","text":"积润容零露，无涯任酌蠡。\n浮空长浴日，表圣不扬波。\n江汉源流众，蕃夷岛屿多。\n客槎如可泛，咫尺是星河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛","author":"丁谓","text":"影抱铜芝直，光摇铸凤圆。\n丛花生木蓼，凝蜜堕金莲。\n积货徒供爨，当官竟不燃。\n曾窥司烜氏，明燧奉高天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狼","author":"丁谓","text":"出必彰明盛，来当表庆隆。\n野心知楚子，疐尾见周公。\n仲德牵衣惠，乌孙饲乳功。\n金行钟粹白，冬献莫雷同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"珠","author":"丁谓","text":"宝气媚长浔，明光法大阴。\n探龙殊九品，剖蚌尽千金。\n汉女飞升迹，鲛人感泣心。\n任轻从弹雀，鱼目莫相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笏","author":"丁谓","text":"诎直明怀让，球鱼示有章。\n对扬资指画，受命助心藏。\n慎重传三世，荣华置满床。\n贤哉段太尉，为国击豺狼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笔","author":"丁谓","text":"霜距金犀利，烟毫枳棘铦。\n绿沉裁镂管，翠羽饰雕奁。\n几格朱黄杂，台床竹素兼。\n古今资日用，错综尽洪纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲","author":"丁谓","text":"鱼戏烟茎细，龟巢粉蕊新。\n缝裳怜远客，开幕想嘉宾。\n千叶松风畔，双花柳渚濒。\n翠芳天宴得，谁假涉江人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"豹","author":"丁谓","text":"炳蔚西方美，群居即谷阴。\n人文穷燮妙，将略取名深。\n饰用千金直，韬藏七日心。\n会当窥落落，莫向管中寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途中盛暑","author":"丁谓","text":"山木无阴驿路长，海风吹热透蕉裳。\n渴思西汉金茎露，困忆南朝石步廊。\n江上竹竿输散诞，林间冠褐负清凉。\n下程欲选披襟处，满眼赭桐兼佛桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒","author":"丁谓","text":"渌蚁含柔旨，清醇泛烈芳。\n帝樽甘露醴，天宴碧霞浆。\n千酿富难敌，万钱酬亦当。\n宜遵三爵礼，莫羡百壶章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"丁谓","text":"琼叶宫闱饰，瑶华乐府词。\n和羹资倚相，止渴济全师。\n七实连三实，南枝对北枝。\n同心将紫蒂，长恐失芳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梨","author":"丁谓","text":"真定如拳大，灵关爽口清。\n甘香朱蜜冷，脆破玉霜鸣。\n工苑司官属，交枝播颂声。\n谁知洛阳树，海内佔先名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笛","author":"丁谓","text":"衡阳裁翠簳，梦泽剪霜柯。\n妙制非丘仲，知音赏列和。\n赋因怀旧得，曲为写情多。\n三弄青溪侧，风流奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"船","author":"丁谓","text":"积羽贻深戒，为梁藉众材。\n采菱浮苑囿，鸣鹤泛池台。\n云映孤篷去，潮随两桨回。\n南风鸲鹆艗，知是故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊","author":"丁谓","text":"陶令重时芳，钟繇帝赍霶。\n清香宜桂酒，冷艳压萸房。\n羽客长生助，骚人夕落伤。\n郊原多似是，甘苦冀情详。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萤","author":"丁谓","text":"兰畹炎飙息，莎阶霁景凉。\n宵征循屋漏，昼伏避阳光。\n具体微雨显，馀辉有若亡。\n惟怜资学者，熠耀满纱囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛇","author":"丁谓","text":"起蛰良时在，鸣风异禀存。\n大能吞巨象，长可绕昆崙。\n出笥彰嘉庆，衔珠报厚恩。\n由来禀龙质，灵化出山门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"象","author":"丁谓","text":"教战诚无敌，充庭实可嘉。\n指踪知拜处，服习认葩花。\n远视惭刚鬣，深藏惜素牙。\n十牛虽此夭，可奈可巴蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雀","author":"丁谓","text":"饮啄绕藩篱，无声乏羽仪。\n衔环诚可念，穿屋奈终卑。\n鸿鹄非予忖，鸾皇不汝欺。\n莫轻蝉饮露，挟弹镇相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿","author":"丁谓","text":"赋命斯千载，登仙托五云。\n发祥呈玉质，标异冠星文。\n食荐时鸣野，游林或命群。\n白环何日至，真祖有前闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"棋","author":"丁谓","text":"不假分曹进，非同博塞游。\n谢安方料敌，祖纳正忘忧。\n窥豹仙枰昼，迷风石海秋。\n金门谁国手，一局赌宣州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]