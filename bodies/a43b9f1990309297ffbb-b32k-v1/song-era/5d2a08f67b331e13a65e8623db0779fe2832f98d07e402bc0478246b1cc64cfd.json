[{"title":"江上雨","author":"丁谓","text":"雨惊鱼食钓翁归，手把丝纶下藓矶。\n家在渡头冲湿去，碎声繁点逐蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阴狱","author":"丁谓","text":"黑水溪旁聊驻马，奈何岸上试回头。\n高崖昏处是阴狱，须信人生到此休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏泉州刺桐","author":"丁谓","text":"闻得乡人说刺桐，叶先花发始年丰。\n我今到此忧民切，只爱青青不爱红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭","author":"丁谓","text":"悠悠风物四时新，苒苒山屏万古春。\n多少江山人不看，却来江上看行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清真香歌","author":"丁谓","text":"四两玄参三两松，麝香半分蜜和同。\n丸如弹子金炉爇，还似花心喷晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刀","author":"丁谓","text":"庖刀多馀地，铅铦信可嗟。\n割鸡讥邑政，买犊励田家。\n鞞䩬穷华妙，龙熊辨等差。\n学操言可复，吕赠意无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"丁谓","text":"峒口清香彻海滨，四时芬馥四时春。\n山多绿桂怜同气，谷有幽兰让后尘。\n草解忘忧忧底事，花能含笑笑何人。\n争如彼美钦天圹，长荐芳香奉百神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌","author":"丁谓","text":"仁里徊翔久，层巢返哺频。\n九雏依百峙，三足托重轮。\n声为空营乐，心因止屋驯。\n夜啼休度曲，丹白瑞无伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书","author":"丁谓","text":"始向龟图妙，爰从鸟迹成。\n偃波如制妙，例薤更难精。\n蔡表崩云重，曹章缀露轻。\n忆曾思刻玉，琼简镂金英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公舍春日","author":"丁谓","text":"绿杨垂线草铺茵，触处烟光举眼新。\n一品也须妨白发，千金莫惜买青春。\n莺声圆滑堪清耳，花艳鲜明欲照身。\n独向此时为俗吏，风流知是不如人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤","author":"丁谓","text":"舞穴标祥异，巢阿表盛明。\n灵音谐律本，綵羽应阳精。\n去必翔千仞，来皆叶九成。\n上林堪饮啄，竹密醴泉清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牛","author":"丁谓","text":"服箱讥睆彼，其耳动来思。\n不负葭刍惠，终成稼穑资。\n瑩蹄知爱矣，骍角肯忘之。\n好放桃林野，销兵是此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代意","author":"丁谓","text":"玦带珊瑚佩解琼，楚云无定好伤情。\n临邛已误通琴意，金谷难寻辩玉声。\n微警单栖盘露重，密含幽思畹兰平。\n明珠百琲将何当，怅望轻躯病欲成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰","author":"丁谓","text":"彼羡南陔子，其谁粉署郎。\n渥丹承露彩，绀绿泛风光。\n屡结骚人佩，时飘郑国香。\n何须寻九畹，十步即芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"印","author":"丁谓","text":"示信流千古，颁荣遍万方。\n帝缄金缕细，天印玉文长。\n雀马严君政，龟蛇辨国章。\n何当携枣篆，回首谢银黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"台","author":"丁谓","text":"不效燕昭置，终贻子罕羞。\n吴都矜四达，楚国炫三休。\n好卜登春乐，无增累卵忧。\n玄都有琼构，何日从真游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉","author":"丁谓","text":"谁负连城美，须思韫椟藏。\n辉山知禀异，被褐喻韬光。\n吕钓时终至，虞求祸是防。\n宁为田父弃，莫作楚人伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜","author":"丁谓","text":"绵瓞怜同蒂，锄耰莫误芸。\n浮泉滋绀质，巾绤透清芬。\n积石三年熟，瑶池五色文。\n静思空洞美，宁问邵平君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙","author":"丁谓","text":"不操千金宝，思观九色虬。\n负图钟上圣，衔烛照穷幽。\n但仰飞天大，宁闻战野忧。\n沃焦须霈泽，莫道我无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"地","author":"丁谓","text":"著象本沉潜，成形莫我厌。\n秉阴彰至信，厚载示流谦。\n右转群生遂，东顷万壑兼。\n寰区今底定，不用八龙占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江","author":"丁谓","text":"楚望为南纪，岷源始滥觞。\n双流沿蜀道，九派出浔阳。\n桃叶行歌远，芙蓉摘采长。\n冲风休破浪，静练正交光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹","author":"丁谓","text":"自保猗猗绿，谁怜冉冉根。\n紫花含凤实，绣箨抱龙孙。\n扫月仙坛静，摇风雪雾昏。\n彤竿思化杖，绀叶想开樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"羊","author":"丁谓","text":"千足比侯封，矜矜莫可穷。\n触藩难进退，荷箠易西东。\n郑伯牵降辱，初平叱化功。\n律和当荐瑞，愿牧上林中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过武陵甘泉寺留题","author":"丁谓","text":"翠影人疏度，波光瑟瑟凝。\n帝家金掌露，仙署玉壶冰。\n晓井侵星汲，宵厨向月澄。\n岂惟蠲肺渴，灌顶助三乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李","author":"丁谓","text":"桃径共无言，整冠防未然。\n折枝如荠苦，沉水若朱研。\n东苑琼芳细，南居玉质坚。\n高穹指为姓，合冠百嘉先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纸","author":"丁谓","text":"妙制剡溪人，多名锦水春。\n卷疑方絮重，开觉露桃新。\n左氏三都贵，张芝径寸珍。\n谢公如就乞，九万一纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡","author":"丁谓","text":"戒旦知霄漏，栖埘识晚阳。\n花冠诚可爱，芥羽亦难防。\n祝祝时求友，咬咬独擅场。\n自当陈玉质，宁止化陈仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佩","author":"丁谓","text":"山玄水苍重，进揖退扬清。\n静有如圭德，行无变玉声。\n韦弦非中度，兰蕙欠锵鸣。\n几忆陪朝会，交相间九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兔","author":"丁谓","text":"三窟同蜫蛰，平冈若电驱。\n爰爰依枳棘，肃肃避罝罦。\n已得思烹犬，其亡尚守株。\n何当华桂畔，宿月玩云衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏席","author":"丁谓","text":"著位时专绝，铺筵罄恪恭。\n鲁堂曾子避，汉殿戴凭重。\n黼绣矜华靡，莞茅助礼容。\n轩皇膺帝锡，瑶彩映昂颙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松","author":"丁谓","text":"君子怜无改，诗人赋有乔。\n轻舟随桧楫，深涧映山苗。\n偃盖秦官远，凌霜夏社遥。\n鹤栖知得地，柏悦见干霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枣","author":"丁谓","text":"好植蓬莱树，无凝枳棘姿。\n鸡心藏密叶，羊角出高枝。\n外炳丹朱彩，中含石蜜滋。\n何当如尹令，见食玉文时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"河","author":"丁谓","text":"擘华凿龙倾，长源接杳冥。\n润应逾九里，清必契千龄。\n箭浪奔霆电，荣光焰日星。\n圣皇图奥事，真祖有祥经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狐","author":"丁谓","text":"安问谢张纲，依凭恃堞长。\n获三当战狩，用一胜千羊。\n冰渡忧濡尾，风嗥乐在梁。\n莫言无粹白，九尾荐佳祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎","author":"丁谓","text":"雄文彰炳变，麟史载于菟。\n莫负编须勇，须怀履尾虞。\n耻将豺共弃，忍与兕为徒。\n啸谷非威怒，风从慑万夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘","author":"丁谓","text":"久尘黄阁侍威颜，忽拥高牙出帝关。\n玉佩乍辞文石陛，锦衣重到虎丘山。\n仙飙时傍潺湲起，珍羽多从杳霭还。\n官大宠深难得暇，林泉怀旧是偷闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金","author":"丁谓","text":"莫羡双南美，休贪九牧珍。\n入怀宁让粟，攫市不防人。\n越冶模良弼，燕台礼上宾。\n徒誇满堂富，永胜一经贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鱼 其一","author":"丁谓","text":"戏叶复依蒲，登龙是去途。\n何烦垂翡翠，未肯畏鹈鹕。\n已负吞舟大，终无涸辙虞。\n濠梁宁足乐，相忘在江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冠","author":"丁谓","text":"盛礼尊元服，嘉名重进贤。\n穷奢讥鵔鹊，极品贵貂蝉。\n就列峨章甫，瞻颜仰邃延。\n谁知远游制，宠锡自高天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剑","author":"丁谓","text":"汉室千金重，耶溪百鍊精。\n干星彰利器，出水示神兵。\n斩佞朱云志，留亡季札情。\n何须麾晋郑，自有倚天名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳 其二","author":"丁谓","text":"客舍青青乱，名园郁郁斜。\n旧栽彭泽署，新植武昌家。\n翠幄隋堤密，金丝蜀道赊。\n狂夫少樊圃，有菀兴无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸酉仲夏自□道□华严山主正师上人□□相遇今忽至止且云□□□□□□携酒□□□□□□□□□□□□□□","author":"丁谓","text":"坏衲相过羽服迎，可怜□静□营营。\n我思江上忘身计，师出山中乞寺名。\n振锡回还心未住，布金圆□意方平。\n零陵泉石三湘最，莫踏□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f8