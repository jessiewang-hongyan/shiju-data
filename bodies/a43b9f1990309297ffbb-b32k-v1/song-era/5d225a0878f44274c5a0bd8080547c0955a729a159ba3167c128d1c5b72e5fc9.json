[{"title":"次韵七首 其五","author":"苏泂","text":"香醪如蜜甜，村酒渐多添。\n弄水閒移棹，看山自捲帘。\n深心非木石，痴腹惯齑盐。\n莫作渊明解，逃鱼本欲潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵七首 其四","author":"苏泂","text":"山色对疏棂，之人一似清。\n水边同妇饮，花下趁儿行。\n养鸭期充膳，骑牛学治生。\n时因把锄暇，毋废读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵七首 其三","author":"苏泂","text":"昵爱经过数，尊荣记忆疏。\n赖收颜氏帖，谁奉子公书。\n西夏方徵甲，东州且定居。\n虽无南过雁，幸有北来鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵七首 其二","author":"苏泂","text":"步蹇堪扶杖，头童欲罢簪。\n渚云秋澹泊，庭树晚萧森。\n秀颖垂千亩，遥青出寸岑。\n本来关个事，而独可人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵七首 其一","author":"苏泂","text":"隐几看鱼乐，洋洋圉圉然。\n一身随见定，万事任从前。\n卖剑更农服，操觚耨纸田。\n岂能无俭岁，固自有丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵马季思禁体雪二首 其二","author":"苏泂","text":"庭树晓毵毵，行空马脱骖。\n瑞臻平地尺，白见一年三。\n照眼花犹散，齐腰话可参。\n岑楼寻胜赏，溪泛此何惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵马季思禁体雪二首 其一","author":"苏泂","text":"涤尽妖氛气，妆成富贵冬。\n梅花香处觉，人意火边浓。\n未暖那飞絮，非寒底见松。\n绝怜阶下竹，腰折为谁恭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父秋怀 其五","author":"苏泂","text":"士有修身者，娟如女在房。\n刈兰供作佩，采菊当为粮。\n春树翻疑雨，秋花却耐霜。\n从来舆涉意，晚棹转微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父秋怀 其三","author":"苏泂","text":"太史龟堂上，重来不忍看。\n更无时往复，徒有竹平安。\n世事翻仍覆，人情燠易寒。\n何时一樽酒，同访小方干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父秋怀 其四","author":"苏泂","text":"逢人惟婞直，过事懒依阿。\n菊引陶彭泽，鸢惊马伏波。\n衰年如意少，行路得诗多。\n彼其皆车服，嗟嗟如命何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父秋怀 其六","author":"苏泂","text":"四十才如此，将来事可吁。\n长斋甘短褐，旧债压新租。\n已觉身何有，行当梦亦无。\n茅檐负朝日，黄卷足相娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父秋怀 其二","author":"苏泂","text":"幸免名为累，应无口启羞。\n竺书时挂眼，衲被久蒙头。\n未仕胡三已，论才宜四休。\n商宗如见梦，依旧济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父秋怀 其一","author":"苏泂","text":"发短日益白，眼昏时见花。\n无人知若士，有句可雄誇。\n篱菊风前蕊，山梅雨后葩。\n平生苏季子，犹足送年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵古梅","author":"苏泂","text":"独立枝南万事非，岁寒引去合知几。\n伯夷自信西山饿，公望何须东海归。\n笛外数声空入梦，江头一树忽斜晖。\n相看有愧垂垂老，莫遣无端片片飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仲归喜雨有肯顾之意","author":"苏泂","text":"愿试黄昏上古汤，社中今得沈东阳。\n素衣肯为缁尘染，秀句殊增灌顶凉。\n不惜联翩过旧隐，也欣滂沛洗炎光。\n预知定得惊人语，约略眉间喜气黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵知县三兄","author":"苏泂","text":"杨柳依依万缕丝，梅花无计与扶衰。\n十分酒满闷如昨，一半春休雨未知。\n安得诗书成保社，略容岩壑有心期。\n扁舟短策寻常事，肥马轻裘我不为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵知县兄","author":"苏泂","text":"秋声物物类歌豳，旋转天机属大钧。\n一雨荐凉全却暑，两湖添绿不生尘。\n黄花又近重阳酒，白发长思五柳人。\n急唤西风与湔洗，恨无好句逐时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高似之秘书谢薛书记七月二十七日早桂","author":"苏泂","text":"翠蕤低映郁金裳，昨夜千门万户凉。\n蟾小未禁仙掌露，犀寒先透玉墀霜。\n唤回临水登山意，恼乱薰天扑地香。\n岁岁为花愁不彻，雅歌欲和底成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高秘书谒陆待制二首 其二","author":"苏泂","text":"海上三神宅，人间陆放翁。\n谈谐诗雅咏，任己易屯蒙。\n松竹当姬侍，鸥禽是仆童。\n后来那可计，应有不如公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高秘书谒陆待制二首 其一","author":"苏泂","text":"人物推前辈，声名重泰山。\n斯文无毁誉，吾道有间关。\n袖短方妍舞，弓强愧力弯。\n风舟虽屡引，中路忍追还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵望海亭","author":"苏泂","text":"城里偏高处，分明见海潮。\n鹳巢多碧树，人语半丹霄。\n州宅楼台近，居民市井遥。\n芳时一来此，因得离纷嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵曾文清公复热句","author":"苏泂","text":"百顷沧波望似空，凿冰吾欲浸其中。\n何言雷电不为雨，须信梧桐自有风。\n子晋台头笙远近，西真池面玉丁东。\n行笺章奏求清冷，乞取玄冥换祝融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵葛天民","author":"苏泂","text":"心火调停久不烧，诗书聊以永今朝。\n拟寻筇杖游还懒，望见梅花意已消。\n原宪既贫应瓮牖，颜回所乐是箪瓢。\n岁寒交友今馀几，留取人间作后凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵葛天民","author":"苏泂","text":"捣柏为香炷，煎茶当酒杯。\n鬓因儿女雪，心向利名灰。\n茅屋湖边住，柴扉柳下开。\n残年未归去，排日为公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍小弟秋日","author":"苏泂","text":"游鳞羁羽任浮沉，老大凄然感岁阴。\n风底波纹生别浦，雨馀山影出疏林。\n残年不足偿多病，万事宁须付有心。\n满眼黄花一杯酒，怆怀元弗为听砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍叟弟送行","author":"苏泂","text":"间道驱车逐帅旗，别情惟有弟兄知。\n百年同好少张仲，举世谁人似子期。\n竹叶尚堪中酒圣，梅花真是断肠枝。\n苍崖缚屋归来好，此计输君我后时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵虞叟九兄七月一日作","author":"苏泂","text":"日月跳丸逝不留，吟蛩得意蜕蝉忧。\n终更末伏应无暑，望见中元便有秋。\n风爽气先青草动，雨凉心共白莲幽。\n谁能跨鹤乘西颢，三十三天取次游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵虞叟兄","author":"苏泂","text":"百嘉萌动春来意，两颊参差少日红。\n有底心情桃叶渡，不堪时世柳花风。\n先朝诸老知谁健，短历今年又已穷。\n忙事尽归趺坐里，侯封从付立谈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百家泊","author":"苏泂","text":"舟子更相语，泥深不可行。\n拥裘听水响，无寐到天明。\n篷背潇湘雨，溪南欸乃声。\n在家那汝觉，数舍许离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老蚌","author":"苏泂","text":"老蚌吸秋月，饥鹰号朔风。\n人生根蒂少，物理短长同。\n难学累累印，休书咄咄空。\n馀年见儿态，若个白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老鬓诗","author":"苏泂","text":"老鬓惊霜觉，春容带雪来。\n散愁诗数首，觅醉酒三杯。\n行店人归少，荒林鸟去回。\n高情无与共，自摘涧边梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自述","author":"苏泂","text":"交友凋零似晓星，生涯依旧短长亭。\n前身房琯仍名永，今代苏耽不姓丁。\n儿女成行头自白，湖山相对眼终青。\n还乡曲调如何唱，枯树无言最可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西陵道中","author":"苏泂","text":"冻缆牵鸥浦，炊烟饭驿亭。\n吴云怀践白，越树怨闾青。\n年数那无老，巢居会有宁。\n长歌和渔者，愁绝未堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过天章","author":"苏泂","text":"菜把充诗腹，篮舆兀病身。\n山烟孤起晚，官柳探生春。\n岁月渠催我，妻孥尔累人。\n谁言行路好，得似在家贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问水诗","author":"苏泂","text":"顷别知何处，重来喜奈何。\n望洋誇海谷，倒箧注天河。\n变化龟文坼，沦漪鸭顶波。\n白鸥没浩荡，清兴满吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馀姚江上夜看残雪","author":"苏泂","text":"星斗夜迢迢，江空一棹摇。\n乱山诗态活，残雪醉魂消。\n已作无怀氏，长思有道朝。\n周公梦不见，篷底听鸱鸮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别湖桥","author":"苏泂","text":"步转湖桥晚，家园隔断陂。\n回看犹万里，别去不多时。\n犊子迎风立，童儿以杖随。\n笋舆方坐睡，到此忽成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其一","author":"苏泂","text":"窗外梧桐树，霜风特地吹。\n莫轻初下叶，长别所生枝。\n便有青葱见，应无岁月追。\n先人移得汝，吾鬓复如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其三","author":"苏泂","text":"群鸡纷啄粟，收敛逼深秋。\n巷内黄叶落，门前清水流。\n年饥人菜色，家弊仆蓬头。\n兼善平生志，凄凉出谬悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"苏泂","text":"新笋看成竹，春风去不知。\n麦天蚕上早，槐日燕飞迟。\n褐短偏怜妇，家贫更惜儿。\n十年霜鬓白，未必总因诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席呈赵大资","author":"苏泂","text":"裴公非绿野，白傅喜青山。\n富贵何如老，功名不似閒。\n半生知己地，每见立谈间。\n岁岁须来省，从教载雪还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨诗","author":"苏泂","text":"三分春事二分休，造化明明百草头。\n一夜雨声清似玉，半窗梅影淡于秋。\n家贫只与诗为伍，客去从教睡作俦。\n败衲依然湖海阔，老来无喜亦无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴淞","author":"苏泂","text":"把蟹风前醉，吟诗水面歌。\n馀年听造物，所嗜独烟波。\n兰棹凭双稚，菱花笑一皤。\n稽山今又昔，贺老苦无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陆放翁三首 其三","author":"苏泂","text":"花间乳鹿笑相迎，拄杖穿花导鹿行。\n六子子孙俱宦达，三山山水亦聪明。\n论诗何止高南渡，草檄相看了北征。\n带得门人也仙骨，年年来此贺长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陆放翁三首 其二","author":"苏泂","text":"边松坐石日从容，故国灵光只我公。\n岂有文章高海内，独将身世老山中。\n丹头跃笋分明异，梅萼含椒即渐红。\n千岁斯人要宗主，不妨留眼送归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陆放翁三首 其一","author":"苏泂","text":"年事依稀鬓复青，看书细字眼犹明。\n池边自种桃初熟，篱下曾枯竹再生。\n已觉貂蝉除世念，未妨龟鹤伴诗情。\n日供薪水门人职，准拟金丹点铁成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿颍季","author":"苏泂","text":"有屋须生子，为家要及时。\n云山千态度，弓冶几书诗。\n寿日能佳事，秋风况捷期。\n长年一杯酒，吾与菊花知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿暹侄","author":"苏泂","text":"行年过二十，不可恃青春。\n再此为中宿，三之即老人。\n诗书先足己，寿禄后荣亲。\n当日痴顽叔，从师霅水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张平父逝后寄尧章","author":"苏泂","text":"入门回首事如麻，岂意铭旌落主家。\n有梦合寻苕水路，何心更种马塍花。\n十年知遇分生死，八口饥寒足叹嗟。\n我亦此公门下客，只今垂泪过京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古","author":"苏泂","text":"故宫何在绿离离，逆顺兴亡世所知。\n草木尚怀勾践德，山川仍识夏王悲。\n行人月下谁吹笛，游客街前自买碑。\n欲倚阑干问陈迹，苍烟白露两迟疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀亲堂","author":"苏泂","text":"升堂知孝子，即事每思亲。\n根本由先世，栽培得后人。\n一林香自好，四序感如新。\n勿作商颜恋，家传汉幄臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔次韵黄观复学士二首 其二","author":"苏泂","text":"自叹冯唐老，那堪李广奇。\n岁寒斯可矣，吾道竟何为。\n丽日明桃叶，清风近竹枝。\n天机乃人事，到底孰成亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔次韵黄观复学士二首 其一","author":"苏泂","text":"未见心先识，相逢意辄同。\n半生才得此，叔世若为容。\n力学君方壮，缘愁我已翁。\n泥涂断还往，信矣命之穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔谢高秘书送示诗文","author":"苏泂","text":"郊居近郭非寂寞，蟠竹结茅依野塘。\n白屋老人谈黍稷，青云学士送文章。\n藕花开后满船月，枫叶落时缘路霜。\n年过三纪不称意，随分江湖作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"足姜句","author":"苏泂","text":"那知身百岁，未办屋三间。\n见客慵开口，逢僧托买山。\n喜无他志愿，幸不碍清閒。\n社燕秋鸿里，人生各有还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"足疾数日简颍弟","author":"苏泂","text":"病脚冬逾甚，羁怀老自惊。\n生前终有役，隐去更须名。\n褐短愁纫妇，文疏愧属兄。\n何时了婚嫁，一意学躬耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远怀 其二","author":"苏泂","text":"去国三千里，书来一再行。\n过从应夙数，契阔更殊乡。\n沙草留徐步，溪鸥傍晚凉。\n人间无限事，独自有难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远怀 其一","author":"苏泂","text":"缥缈龙泉伯，人间第一流。\n胡然天下宝，只顿海东头。\n斯道谁兴废，浮云任去留。\n绝知他日少，预作百年忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居复遇重九悠然兴怀颇谓此节特宜于贫盖富贵者不知若是之清美也因赋唐律呈同社","author":"苏泂","text":"风凄日薄鬓毛新，岁岁年年乐此辰。\n多少昔贤留赋咏，大都九日称清贫。\n瓮头无酒心仍醉，篱下看山意愈真。\n自采黄花供陶谢，迩来嘉兴属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈杰荆州之役伯文实约予闻其没官怆甚不寐遂成诗","author":"苏泂","text":"细雨归帆暮，西风远笛哀。\n江空人永已，兴尽首重回。\n嗣祖焉非福，王生本不来。\n从今长谢客，稳卧北山隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乳爵","author":"苏泂","text":"乳爵机心浅，逢人自不飞。\n阔疏罗网事，爱惜羽毛稀。\n一物知天理，他年任布衣。\n相忘容苟免，吾与汝无违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和十二弟韵","author":"苏泂","text":"三伏回头梦欲醒，五更风露月逾清。\n病馀似鹤精神爽，老去如僧念虑轻。\n边面只今多勇战，人间从昔少闲行。\n何当封事天皇殿，乞借秋霖洗甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陆判院怀祖","author":"苏泂","text":"柴门临水对山开，日日思君君不来。\n与世相忘书万卷，于人无忤酒三杯。\n参乎毕竟曾师孔，赐也如何敢望回。\n况是升沉方自此，丹阳闻道好官催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和岩壑兄九日","author":"苏泂","text":"华颠可笑插茱萸，儿女欢然竞挽须。\n故国黄花元自好，荒台青草孰为娱。\n举觞感慨悲歌有，落帽风流蕴藉无。\n粘起半生铁如意，今愚何似古之愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏月 其二","author":"苏泂","text":"既雨中秋望，纤毫桂影分。\n魄高疑压雾，香动欲冲云。\n稍窘痴蟾窟，全惊睡鹊群。\n孤清若个畔，玉笛片时闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏月 其一","author":"苏泂","text":"入夜金盆上，终宵玉镜悬。\n气凉征戍骨，肠断别离缘。\n皎洁宁伤性，虚明欲竟天。\n平生看不足，兹夕更悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜读老杜星月诗二十首","author":"苏泂","text":"肺胃清如洗，翛然二十诗。\n月星连北斗，冰雪绕南枝。\n煮壑充茶椀，烹龙送酒卮。\n杜陵天上语，举世几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和高秘书雪中杂兴","author":"苏泂","text":"平湖添细碧，绕郭看新晴。\n幸作当年瑞，那无一日情。\n睡魂依酒浊，诗味益茶清。\n寒事今如许，重扪反舌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]