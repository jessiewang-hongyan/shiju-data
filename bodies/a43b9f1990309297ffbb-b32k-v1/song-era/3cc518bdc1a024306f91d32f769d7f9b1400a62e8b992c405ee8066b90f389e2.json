[{"title":"代吴景年次韵净慈寺主僧頔上人二首 其一","author":"陈著","text":"乌驱兔迫一衰翁，始信浮生总是空。\n拈掇琴书终日事，依栖梅竹百年丛。\n无官不用忧三黜，安分何劳送五穷。\n咫尺上方钟鼓地，从师学佛便须躬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代京尹吴山云益雪应贺庙堂二首 其二","author":"陈著","text":"非才承乏尹瑶京，何幸亲逢造化成。\n凝固地腴丰岁事，均调天气寿民生。\n春归休念采薇戍，夜捷已闻垂瓠城。\n方信太平元有象，九街箫鼓合欢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代京尹吴山云益雪应贺庙堂二首 其一","author":"陈著","text":"安排寒事做年华，老手薇垣第一家。\n神女先驰行雨旆，冯夷随剪舞风花。\n万尘并纳真平等，一色横陈绝点瑕。\n养乐堂前清赏处，贺班方退紫宸衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代前人次韵赵县尉即席诗","author":"陈著","text":"旧来曾此摄雷封，勉策驽鞭愧罔功。\n自分依莲游绿水，岂期沿檄又秋风。\n今来视昔还多事，我亦无他祇一中。\n此去未知能淑后，时知石药赖明公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代浦城权县赵节推鹿鸣宴诗","author":"陈著","text":"潜藩岁贡素多才，捷报欢声沸似雷。\n南浦士流新姓字，西山夫子旧胚胎。\n登荣仙籍香浮桂，得意春魁信在梅。\n此去天衢齐纵靶，代庖祗饯幸重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兄弟醵饮访雪航次弟观韵二首 其一","author":"陈著","text":"天女多年为散花，晚年来此寄年华。\n贫因好客甘如荠，诗解醒人苦似茶。\n入室漫为云作主，开窗惟许月通家。\n有时得句忙题处，满壁淋漓字湿鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兄弟醵饮访雪航次弟观韵二首 其二","author":"陈著","text":"梦断天边飞佩霞，短筇松路趁溪斜。\n归鸦山外烟如画，过雁云閒雪欲花。\n跌岩琴书谁我辈，承平钟鼓自僧家。\n从今载酒须同醉，兄已头童弟发华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出门寄弟睹子得","author":"陈著","text":"半年腿卧近方仁，一出门来拂濯身。\n交十月天村景好，连三日雨晚晴新。\n青山无语自知我，黄叶是愁还可人。\n谁信幽居便忘世，渔樵亦自有经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出剡北门道中","author":"陈著","text":"晴日烘冬扫宿阴，篮舆伊轧出山深。\n田夫忍冻妆旗帐，学子忘劳走佩衿。\n三载一馀多少过，万人相送独何心。\n新官便好观风俗，莫道无人识古琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢竹溪得处士号邑尹有诗卢以其唱及其自和来求余次韵","author":"陈著","text":"梦破邯郸百念齐，长汀西畔半分溪。\n护符清出黄冠品，承命有加紫诏泥。\n径捷更谁疑晚节，山居有客侈新题。\n老吾亦是三峰裔，何幸相逢有子兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月八日携子侄到上乘偶成","author":"陈著","text":"白首犹堪数里行，相过一笑见山堂。\n残僧门径静于夜，新夏林塘暖自凉。\n且借吟床娱半日，何妨归笠戴斜阳。\n我来岂敢辞筋力，先陇松楸倚寺旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月三日与家人小酌转官毬花因成八句略为花吐气也","author":"陈著","text":"红芳销歇后，天质最分明。\n剪衬青云薄，团成白雪轻。\n官途荣进取，时样妄推评。\n本色相看处，幽窗不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月五日后圃酴醾芍药侍郎三花盛开醉中成三咏 其一","author":"陈著","text":"酴醾忽尽花，春与夏交加。\n顷刻当千日，风流能几家。\n香丛迷粉蝶，曲蔓走青蛇。\n火急要清赏，可人归未邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月五日后圃酴醾芍药侍郎三花盛开醉中成三咏 其二","author":"陈著","text":"芍药又将开，那堪夜雨催。\n密铺萱草衬，巧傍牡丹栽。\n省砌休思著，扬州曾看来。\n芳菲概如许，俯仰亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月朔日乡饮于邑董氏之依绿亭口占","author":"陈著","text":"道义为乡自不同，肯随流俗唾衰翁。\n高谈惊散洗红雨，清饮唤回依绿风。\n直欲鸢鱼相上下，那知乌兔有西东。\n得閒不乐真堪笑，金谷平泉总是空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四次寄意","author":"陈著","text":"正大从来不径由，穷崖今却伴猿愁。\n栖栖宇内知师孔，吃吃人閒爱说侯。\n昨夜撞钟搜句到，他年笼壁把名留。\n崆峒麦熟关时事，此意还曾入咏不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"外甥黄阿相生日","author":"陈著","text":"湖山聚秀系斯文，汝更峥嵘瑞户门。\n嵩里是人誇宅相，慈溪之后有曾孙。\n书声自可怡重庆，家学何妨涨一源。\n远大相期吾耄矣，莫将苦语等閒言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊寅三月十一日为桑麦说苦","author":"陈著","text":"一年景象在春光，底事今年春反常。\n四十日来无点雨，二三月里却多霜。\n麦苗病燥饭亏料，桑叶死寒蚕绝粮。\n天下苍生不堪命，但看人事即阴阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旦起诵邵尧夫诗","author":"陈著","text":"二十年前尘路忙，如今都住寂寥乡。\n梅花时节溪山好，菜粥人家门户香。\n否往泰来天外事，早眠晏起枕中方。\n案头只有尧夫集，参得透时滋味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月二十四日到梅山二首 其二","author":"陈著","text":"梅花草屋边，好景得天然。\n梦境閒为上，归途倦莫前。\n无情推醉石，有分是流年。\n已约重来日，白云留醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月二十四日到梅山二首 其一","author":"陈著","text":"困来禁不住，一动亦悠然。\n家事青山外，春心白发前。\n逢人相问岁，为客又开年。\n得醉梅花下，何妨就石眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月五日访王韦轩知府东坞真诏道中","author":"陈著","text":"晴光欲雪做新元，访旧西来第一番。\n十五里行千曲路，两三处见数家村。\n山培浮土为田肉，涧束湍流有石痕。\n安稳不知危世事，更从何处觅桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月四日到张车偶成","author":"陈著","text":"晴行半日到张车，石路崎岖趁水斜。\n一窟山中成草市，数株松下见梅花。\n居民尽老他无事，就土为生自有涯。\n谁料如今同沸鼎，不时飞马涨尘沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月晦日与弟观对酌","author":"陈著","text":"聚散等风沙，相知要当家。\n弟兄窗下酒，世俗眼前花。\n隐去方为福，贫驱未有涯。\n明朝吉凶事，分付与昏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用长儿韵谢黄长孺酒","author":"陈著","text":"薄俗方沈溺，亲情自酌斟。\n雨声书屋冷，春意酒杯深。\n危世不多话，醉中时一吟。\n明年如老健，此会得重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用长孺七夕韵","author":"陈著","text":"炳炳双星从古然，滔滔多话到今传。\n渺茫河上曾无事，醉梦人閒自并缘。\n妄不易祛姑立我，巧如可乞岂为天。\n痴儿甘受三年诈，独有崔生此话贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用帅初韵谢其寿我之意","author":"陈著","text":"锦云忽把老瞳遮，寿语何为及我家。\n怕说庚寅赋湘芷，漫书甲子谱陶花。\n长途交骛鼠为虎，孤迹偷生蛇放蟆。\n人世到今何足问，桑榆况已日西斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用弟观韵二首 其二","author":"陈著","text":"粉儿乳子等蓬麻，书种精神见始哑。\n自分閒居培玉树，无心劳役谶金沙。\n如龙当有腾高日，何恙能侵积庆家。\n乳哺薄乖随勿药，番成点浪□涂鸦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用弟观韵二首 其一","author":"陈著","text":"住世光阴晓日霜，浮生谁弱又谁强。\n干戈时节贫差稳，诗礼人家话亦香。\n何用移文来北陇，可能把酒博西凉。\n妻无愠见儿堪教，门外从他沸一铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵记梦中所感","author":"陈著","text":"风引归舟远翠蓬，转头三见柳花风。\n伤心殆尽王摩诘，痛哭真成贾太中。\n尚有鬼神知夜问，谁知兄弟坐天穷。\n此时此意无人会，放读离骚太乙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵似龄叟","author":"陈著","text":"早岁雄心撼不周，晚年归契老禅游。\n肯除酒戒容元亮，欲答梅诗愧子由。\n隐几云山长在眼，出门风雪又回头。\n元宵有约慈云阁，镫火能无感旧愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵自述","author":"陈著","text":"忆昔微官玷瞽宗，归来十载坐山穷。\n有家却似髡头释，无齿真成吮乳翁。\n□□□清秦吉了，饿犹未死信天公。\n馀生趯趯只如此，看取东坡赋二虫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵呈晓村","author":"陈著","text":"溪山两相望，只隔五长亭。\n一见坐联日，高谈气拂星。\n好宾知络秀，兼仆困樵青。\n此会受多益，归途杖可铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵送酒与约斋","author":"陈著","text":"人生以类合，圆木不投方。\n家话太平旧，山盟晚节香。\n百罹心易足，一醉味何长。\n但得静中乐，村村皆洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵答龄叟见寄","author":"陈著","text":"草堂存老我，茅屋著而翁。\n门户两家异，溪山一趣同。\n夜炉榾柮火，春阁杏花风。\n何惜盟吟社，浮尘付过鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用梅山别诸贤韵","author":"陈著","text":"世变事难必，天伦爱自深。\n醉醒皆外物，甘苦共初心。\n倦翼山招返，寒林风为吟。\n何当长聚首，衰境况侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用戴帅初韵寄孙常州","author":"陈著","text":"溪绕山围杨柳遮，战蜗国里退閒家。\n儿孙满眼堂万卷，宾客多贤馆五花。\n立脚东皋看倦鸟，回头温水笑跳蟆。\n相知惟有诗相寄，便羽一封三印斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲戌考类试院呈同官","author":"陈著","text":"天风吹散扑衣尘，奎壁光中预□文。\n老眼可能私李豸，公朝正欲第刘蕡。\n平生泾渭岂无见，暗室雷霆如有闻。\n一雨快晴秋意好，预占太史奏祥云。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白珽寄诗次韵见意","author":"陈著","text":"江干风雨别，君住我来回。\n两地梦相觅，十年书一来。\n字参老未到，诗放晚唐开。\n直要吟成史，扫清尘世埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示内","author":"陈著","text":"婚娶不在早，在此两相宜。\n岂得人无妇，能如子者谁。\n科名图我取，家务以身支。\n要见看承处，颓然白发时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示王侑翁二首 其二","author":"陈著","text":"硕果生机在，从他剥五阴。\n南山四时面，残屋百年心。\n家薄有书种，客多成笑林。\n要閒元自老，不在卜居深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示王侑翁二首 其一","author":"陈著","text":"垂髫已解吟，髣髴学何阴。\n暗动梅窗喜，遥传桂种心。\n染声毋市井，近拙要山林。\n耄矣不成句，中閒意自深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示都儿学书","author":"陈著","text":"都子方知砚石亲，字虽小技盍留神。\n鲁公米帖犹存古，王氏兰亭已失真。\n莫事锋铓多巧锐，要令骨肉两停匀。\n中心端正手圆活，此外无方可教人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示梅山弟八句","author":"陈著","text":"浮世蘧庐付一呀，诗书馀沥子孙家。\n两池分受高低水，四岸量栽次第花。\n笑傲溪山如故旧，招邀云月共生涯。\n相逢数酌春风酒，不信人间有战蜗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张子华见寄","author":"陈著","text":"老矣息林邱，平生不径由。\n知心时一见，安分别无求。\n寒卧死中活，荣华乐处忧。\n世閒何限事，曾看过云不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵戴帅初除夕并寄弟观二首 其二","author":"陈著","text":"兄弟相依友在邻，又添一岁话情真。\n梅花素入两年眼，椒酒难医百病身。\n敝帚自珍从众笑，破皮非怪亦多嗔。\n柴门一任风开闭，静看争春车马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵戴帅初除夕并寄弟观二首 其一","author":"陈著","text":"天如旋磨又今春，留得非才未死身。\n浮世生来真逆旅，危时老去少同人。\n俗情一夜分寒煖，道眼百年无旧新。\n但恐明朝官事动，叫嚣隳突满乡邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似仁泽宗芑","author":"陈著","text":"来访寄窗师，新田雨茗期。\n凉生开酒量，香妙醒诗脾。\n半日旧来话，古心他更谁。\n要知梦非梦，试问两相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似史和甫传清","author":"陈著","text":"翩翩鹤往还，高眼看尘寰。\n家世崔卢上，风流晋宋閒。\n开门种桃李，落笔动江山。\n勋业时来做，青春赢得閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似永固主僧惠福","author":"陈著","text":"偶来乘暇隙，又过古禅林。\n白日钟鱼外，清风竹树阴。\n无言自有趣，得句亦何心。\n相见不相问，老僧知我深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似告成寺主僧蟾秋海","author":"陈著","text":"出宫墙外步冬暄，转憩黄花翠竹边。\n一笑偈言非本色，相留清供亦前缘。\n土酥饤洁昏眵醒，汤乳包香老齿便。\n祇恐醉陶终爱酒，难陪惠远共修莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似李德昌州判","author":"陈著","text":"借重东南官府新，与秋高洁更春温。\n公心知寄黄堂印，信令如开綵棒门。\n纯用诗书中古味，乐闻名利外陈言。\n耄夫也为乡民贺，硬忍须臾一出村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似法椿长老","author":"陈著","text":"山林有福足慈云，一耐中閒百废新。\n诗榻话香来雅伴，斋钟声好撼禅邻。\n红颜药力如平日，青眼梅花又小春。\n欲赞法身安稳处，年年松竹长精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似法椿龄叟","author":"陈著","text":"人生契合处，信是宿因缘。\n坐到无言外，参成有佛前。\n好山非昨日，啼鸟又今年。\n带得醉归去，醒时风满天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似范景山","author":"陈著","text":"我辈岂池蛟，飞腾此一交。\n天门惊路梗，冰港笑舟胶。\n甘甚新薇蕨，依然故草茅。\n从今门外事，洗耳学由巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似郑宗平","author":"陈著","text":"幕府新开紫气临，红莲绿水照初心。\n宦游受用家庭训，公退寻盟湖海吟。\n傍塔山居真吏隐，酌碑潭饮当官箴。\n自矜出谷儿嬉老，一面春风得最深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似星同知","author":"陈著","text":"通守鱼符委任隆，规模新处见新功。\n来从北斗光躔下，坐治南山紫翠中。\n载路政声如药石，契天心画在屏风。\n深深到底清相映，一派碑潭水最公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵谢吴竹修","author":"陈著","text":"秃髡归阳羡，仙髯卧古藤。\n前贤成昨梦，后辈嗣谁镫。\n倾盖欣如故，吟坛得共登。\n春风吹相聚，聊此寄韦冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊单方庵墓","author":"陈著","text":"方庵居士死，归骨白云根。\n霜暑三年别，风流万古存。\n月梁空夜梦，宿草长春痕。\n松底幽兰发，清香是梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同范景山到城西墺游鹿苑寺","author":"陈著","text":"片帆带月趁潮行，晓及三江作住程。\n上冢偶随庞老去，过溪忽见远公迎。\n山疑无路亦多路，鸟独有声时一声。\n幸自醉乡风唤醒，斜阳烟草旧花城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同赵景文到梅山弟家","author":"陈著","text":"脚力犹支一里閒，得闲便不记艰难。\n可人本色山林屋，避世珍羞芋栗盘。\n来往任教诗眼热，笑谈能化老身寒。\n感怀棠棣诗章在，试把丝桐檃括弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同离孙童蒙游净慈","author":"陈著","text":"三月第三日，又来游梵林。\n醉言惊俗耳，贫趣契僧心。\n犬吠落红外，鸟啼空翠阴。\n一年最佳处，分付老龄吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同袁通判游越中三首 其一 禹庙","author":"陈著","text":"舟行可十里，上岸即山林。\n曲径抱深意，怪松传古音。\n平生能几到，好处欲穷寻。\n春鸟一声处，乡关又上心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同袁通判游越中三首 其三 赵节使稽山门外花园","author":"陈著","text":"前贤眼力到，占得此名区。\n荒径百年树，虚堂三面湖。\n檐阴来钓艇，花外起晴凫。\n借问园中叟，主人曾到无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同袁通判游越中三首 其二 鸿禧观","author":"陈著","text":"停舟过桥去，两岸绿垂杨。\n绕屋水为界，入门花满廊。\n如今为道观，闻昔是书堂。\n此意与谁说，春风湖渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]