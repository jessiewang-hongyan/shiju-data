[{"title":"扈隩牧笛","author":"徐似道","text":"濛濛香雾湿未乾，烟光匝地春风寒。\n牧童三五唤归切，鞭牛为马蓑为鞍。\n一声芦管振林木，口畔呜呜相戏逐。\n梅花乱落自潇洒，绝胜豪门调新曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"硐岭樵歌","author":"徐似道","text":"黄山东南数十里，芙蓉削翠连云起。\n萧萧褐褐三五群，生薪半肩歌不止。\n石径迢迢云外行，烟雾满地穿林坰。\n圣世不须紫芝曲，息担击壤歌太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游庐山得蟹","author":"徐似道","text":"不到庐山辜负目，不食螃蟹辜负腹。\n亦知二者古难并，到得九江吾事足。\n庐山偃蹇坐吾前，螃蟹郭索来酒边。\n持螯把酒与山对，世无此乐三百年。\n时人爱画陶靖节，菊绕东篱手亲折。\n何如更画我持螯，共对庐山作三绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"装太和米纲","author":"徐似道","text":"一鞭加尔肤，万刃划吾腹。\n就令猛于虎，何忍食子肉。\n世无冷镬汤，邑尽活地狱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒲","author":"徐似道","text":"圆蒲相将结僧厦，荷叶蒲茸绿相亚。\n浮花浪叶自飘零，小院回廊正潇洒。\n叶如青幄花成茵，细腰起舞来送春。\n纸光如银墨如漆，落笔四座惊有神。\n轻衫短帽付馀子，花前醉倒输闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题雪巢","author":"徐似道","text":"巢馀太古雪，人有正始风。\n头如雪絮白，面作春桃红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过月岩","author":"徐似道","text":"桥虹跨水千尺，岩月倚空半规。\n岁晚相看如昨，夕阳伫立移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一剪梅","author":"徐似道","text":"道学从来不则声。\n行也东铭，坐也西铭。\n爷娘死后更伶丁，也不看经，也不斋僧。\n却言渊子太狂生。\n行也轻轻，坐也轻轻。\n他年青史总无名，你也能亨，我也能亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"徐似道","text":"问竹平安，点花番次。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"徐似道","text":"茶寮山上一头陀。\n新来学者么。\n蝤蛑螃蟹与乌螺。\n知他放几多。\n有一物，是蜂窝。\n姓牙名老婆。\n虽然无奈得它何。\n如何放得它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 夜泊庐山","author":"徐似道","text":"风紧浪淘生。\n蛟吼鼍鸣。\n家人睡著怕人惊。\n只有一翁扪虱坐，依约三更。\n雪又打残灯。\n欲暗还明。\n有谁知我此时情。\n独对梅花倾一盏，还又诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙令/临江仙","author":"徐似道","text":"西子湖边春正好，输他公子王孙。\n落花香趁马蹄温。\n暖烟桃叶渡，晴日柳枝门。\n中有能诗狂处士，闲将一鹤随轩。\n百钱买只下湖船。\n就他弦管里，醉过杏花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"徐似道","text":"牧童出捲乌盐角，越女归簪谢豹花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"徐似道","text":"晓风洛浦凌波际，夜月江皋解佩时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"徐似道","text":"那堪富有千头橘，便可称为四老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十六","author":"徐似道","text":"天寒不知翠袖薄，日煖但觉玉烟生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"徐似道","text":"见说周颙誇早韭，斲烟锄雨幸时分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十一","author":"徐似道","text":"北风万籁自宫徵，南日一轩真裤襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"徐似道","text":"煖分煨芋火，明借绩麻灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十二","author":"徐似道","text":"晓梵鱼出听，夜禅石点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十九","author":"徐似道","text":"驹入隙来元不碍，蝇钻纸出定何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十","author":"徐似道","text":"化成银地佛应喜，移下玉楼天不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"徐似道","text":"叶从秋后变，色向晚来红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"卢襄","text":"红芭蕉映黑牵牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"徐似道","text":"后茁碧含藓，厥包黄带沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十八","author":"徐似道","text":"索醉宁倾问字酒，忍饥不取作碑钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十五","author":"徐似道","text":"肩成山耸因寻句，眼作花昏为勘碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十三","author":"徐似道","text":"胸中著云梦，皮里有阳秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"徐似道","text":"一带拒霜三十里，又催箫鼓作秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十二","author":"徐似道","text":"但欲有衣存妓妾，不愁无帐列生徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十三","author":"徐似道","text":"刘显贵为天子友，退之穷作相君书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十四","author":"徐似道","text":"自作先生传，谁为故吏碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨时可雪中三绝句 其二","author":"赵鼎臣","text":"见睍消流似发蒙，宿云归尽不禁风。\n小桃洗面添光泽，未点胭脂已自红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十七","author":"徐似道","text":"黄四娘花空朵朵，谢三郎鬓已苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"徐似道","text":"胡椒尚杀元丞相，薏苡犹疑马伏波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清音亭 其三","author":"徐冲渊","text":"泉声饱听玉琮琤，世路羊肠我倦行。\n但得一觞仍一咏，不妨高枕寄浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清音亭 其二","author":"徐冲渊","text":"人间丝竹竞哇淫，只有清流解洗心。\n试论此山泉石看，茂林修竹胜山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清音亭 其一","author":"徐冲渊","text":"新池碧甃玉回环，一水来从天柱山。\n试作流觞拟修禊，兰亭风景坐追还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋夕设醮洞霄宫","author":"徐冲渊","text":"老桂吹香古殿秋，琼钟敲处月当楼。\n星坛露下斗光冷，天宇云空灏气浮。\n羽客朝元锵玉佩，宝熏凝雾霭金虬。\n步虚政在千岩上，咫尺高灵想下游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冲虚斋池荷","author":"徐冲渊","text":"道人埋瓮作新塘，胸次五湖波渺茫。\n太华移根聊戏剧，洄池分种不寻常。\n冰壶夜浸绿荷露，玉鉴晚吹红藕香。\n可待秋风莲子熟，会乘一叶汎沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制秋怀诗二首 其二","author":"徐冲渊","text":"天末虹蜺晚未收，龙池新雨涨清流。\n鸥缘适意频依渚，鱼不贪香懒上钩。\n剩喜三边无警报，况当万宝得成秋。\n啸歌高蹈羲皇上，不复深贻海内忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制秋怀诗二首 其一","author":"徐冲渊","text":"东壁星辰烂不收，夜凉河汉截天流。\n芙蓉院静琴三叠，翡翠帘开月一钩。\n黄屋非心辞大宝，碧云有意思高秋。\n金声玉振掩前作，汉祖空怀猛士忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通明馆洒扫二首 其二","author":"徐冲渊","text":"逋客还山一笑咍，故人怜我不嫌猜。\n晓猿夜鹤总欢喜，蕙帐草堂相与开。\n可为雨芽烟蕨住，直缘流水古松来。\n枝巢若许鹪鹩借，投老此生真快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通明馆洒扫二首 其一","author":"徐冲渊","text":"圣恩宽大放还乡，便著草鞋挑钵囊。\n中路忽逢天柱诏，一行今侍玉皇香。\n浮舟载月苕溪上，倚杖瞻云魏阙旁。\n身到通明上头馆，好山惊见暮苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冰壶","author":"徐冲渊","text":"一泓虽浅清，长时自甘冷。\n可怜病渴人，临深垂短绠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清音亭憩暑","author":"徐冲渊","text":"水落石涧鸣，中含太古音。\n安得微妙人，写入朱弦琴。\n六月天不雨，赤日云无阴。\n道人憩其侧，脱巾卧青林。\n好风松上来，聊复披吾襟。\n朱炎拆厚地，晴岚冒高岑。\n愿分一勺泉，为民作甘霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清隐斋饮酒","author":"徐冲渊","text":"暖风薄雨轻烟散，晴日游丝飞絮乱。\n竹窗午梦啼鸟惊，松轩晚饮幽人唤。\n一壶碧酒如春浓，万斛羁愁若冰泮。\n兴来索笔谩题诗，碧桃花下纶巾岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 怀山中","author":"徐冲渊","text":"穷达付天命，生死见交情。\n人今老矣，□□狗苟与蝇营。\n赢得一头霜雪。\n闲却五湖风月。\n鸥鸟负前盟。\n颜厚已如甲，太息误平生。\n想箕山，怀颍水，挹馀清。\n只今归去，沧浪深处濯吾缨。\n笑抚山中泉石。\n细说人间荆棘。\n有道苦难行。\n好补青萝屋，且占白云耕。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"徐存","text":"清真羽士旧仙官，日奉琳宫紫翠间。\n五洞烟霞龙窟宅，一壶天地道家山。\n涤泉盘转冰涵沼，隐石屏开玉敞关。\n可笑濯缨来览胜，输他高卧白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其二 晦庵席上作","author":"徐安国","text":"争献交酬，消受取、真山真水。\n供不尽、杯螺浮碧，髻鬟拥翠。\n莫便等闲嗟去国，固因特地经仙里。\n奉周旋、惟有老先生，门堪倚。\n追往驾，烟霄里。\n终旧学，今无计。\n叹白头犹记，壮年标致。\n一乐堂深文益著，风雩亭在词难继。\n问有谁、熟识晦庵心，南轩意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 其一 约斋同席用马庄父韵","author":"徐安国","text":"挥手华堂，重整顿、选花场屋。\n撩鼻观、飞浮杂沓，异香芬馥。\n金缕尚馀闲态度，冰姿早作新妆束。\n恨尊前、缺典费思量，无松竹。\n蜂蝶恨，何时足。\n桃李怨，成粗俗。\n为情深、拼了一生愁独。\n菊信谩劳频探问，兰心未许相随逐。\n想从今、无暇斸蔷薇，锄罂粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 早梅","author":"徐安国","text":"青梅骨瘦，已有生春意。\n椒萼露微花，便觉香魂旖旎。\n惜花公子，可是赋情深，携瘦竹，绕疏篱，终日成孤倚。\n赏心乐事，又也何曾废。\n烟露湿铅华，误啼妆、三年客里。\n江南芳信，政自不愆期，吴山远，越山长，梦寐添憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 席上赋","author":"徐安国","text":"翠幕围香夜正迟。\n红麟生焰烛交辉。\n纤腰趁拍轻于柳，娇面添妆韵似梅。\n凝远恨，惜芳期。\n十年幽梦彩云飞。\n多情不管霜髯满，犹欲杯翻似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登楼望黄山","author":"徐师","text":"黄山楼上望黄山，水石云霞未得攀。\n三十六峰应笑我，纷纷尘事几时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登瑞岩山","author":"徐师仁","text":"携筇登绝巘，朝爽薄危栏。\n乘胜移杯爵，凭高忆羽翰。\n泉声穿石响，树色入秋寒。\n对酒频长望，心同渤澥宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九仙山","author":"徐师仁","text":"晨逾九仙山，暮访九鲤湖。\n何氏兄弟跨鲤鱼，同时轻举排天衢。\n山头云气故恍惚，三十六鳞今有无。\n琼浆白日醉天酒，何时华表归来乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"极目亭","author":"徐次铎","text":"几点归舟破暮烟，数行雁字落霞边。\n世间安得王摩诘，为写琴川作辋川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日上怀古堂","author":"徐玑","text":"山前事迹古来多，风雨尘埃竟若何。\n惟有白衣秦处士，数篇佳句不曾磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹青阁","author":"徐玑","text":"翠霭空霏忽有无，笔端谁著此工夫。\n溪山本被人图画，却道溪山是画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书同安旧酒家壁","author":"徐玑","text":"榕阴绿满驿程边，驻马难寻旧圣贤。\n只有好山横迥野，不论朝暮带轻烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五里牌边","author":"徐玑","text":"路绕山根石磴斜，小桥流水树交加。\n柴门半掩无人到，五里牌边三四家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古陵桥","author":"徐玑","text":"西桥西岸柳成丝，春去春来岁岁同。\n偶被东风吹落絮，又随流水过桥东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟过水口作","author":"徐玑","text":"舟行遥指福城关，天宇开时地势宽。\n二百里溪平似掌，一帆风色到怀安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过九岭","author":"徐玑","text":"断崖横路水潺潺，行到山根又上山。\n眼看别峰云雾起，不知身也在云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀峰寺","author":"徐玑","text":"篮舆晚泊近岩隈，精舍门临古道开。\n僧子相逢便相识，十年三过秀峰来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连江官湖","author":"徐玑","text":"众山围绕渌团圆，官木参差古道边。\n行尽浓阴全不了，一湖飞雨带轻烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建剑道中","author":"徐玑","text":"云麓烟峦知几层，一湾溪转一湾清。\n行人只在清湾里，尽日松声杂水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨 其一","author":"徐玑","text":"断桥横落浅沙边，沙岸疏梅卧晓烟。\n新雨涨溪三尺水，渔翁来觅渡船钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨 其二","author":"徐玑","text":"柳著轻黄欲染衣，汀沙漠漠草菲菲。\n晓风吹断寒烟碧，无数鸳鸯溪上飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"徐玑","text":"午风庭院绿成衣，春色方浓又欲归。\n蝌蚪散边荷叶出，酴醾香里柳绵飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋行二首 其二","author":"徐玑","text":"红叶枯梨一两株，翛然秋思满山居。\n诗怀自叹多尘土，不似秋来木叶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋行二首 其一","author":"徐玑","text":"戛戛秋蝉响似筝，听蝉閒傍柳边行。\n小溪清水平如镜，一叶飞来细浪生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日閒坐","author":"徐玑","text":"无数山蝉噪夕阳，高峰影里坐阴凉。\n石边偶看清泉滴，风过微闻松叶香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦成","author":"徐玑","text":"向晚菱歌起，风平水不流。\n鸳鸯两相逐，飞过采莲舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移官南浦作","author":"徐玑","text":"簿领初为建水栖，移官南浦又沈迷。\n溪山转处人烟隔，惟有黄鹂一样啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]