[{"title":"陪留宰游灌溪回饮县圃六绝 其一","author":"王炎","text":"泥融紫燕欲营垒，日暖黄蜂争取花。\n试向静中观物化，蒲团相对坐僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪留宰游灌溪回饮县圃六绝 其六","author":"王炎","text":"东风桃李可招客，吏事尘埃能困人。\n蘸甲一杯留我醉，知公胸次有阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶行后圃成三绝 其三","author":"王炎","text":"园蔬入市不论钱，忍口休参玉版禅。\n留得新梢过旧干，清风六月亦萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶行后圃成三绝 其二","author":"王炎","text":"琅玕十丈箨龙孙，已向梢头散绿阴。\n他日雪霜颜色好，正缘外直内虚心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶行后圃成三绝 其一","author":"王炎","text":"繁红飞尽绿成阴，更有忘忧草色新。\n吏隐何心来对景，化工随意自留春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿野人家","author":"王炎","text":"破篱犬吠月将落，曲沼蛙号天欲晴。\n日出东方尘满眼，不如攲枕梦魂清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄潘维节","author":"王炎","text":"黑貂裘敝君穷甚，黄犬书来我慨然。\n肯到越中同住否，秋深即上歙溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚浴溪上","author":"王炎","text":"山脚草深樵径没，溪头水落石梁高。\n一川风露无人占，古柳玄蝉处处号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚憩田家二绝 其一","author":"王炎","text":"家书未到鹊先喜，春事无多莺又啼。\n偶对好山留客坐，绿阴遮屋日将西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚憩田家二绝 其二","author":"王炎","text":"山间一径牛羊迹，林下数家鸡犬声。\n底事居人苦争畔，閒田官正募民耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其二","author":"王炎","text":"欲向花边把一杯，喜逢腊尽又春回。\n直饶百岁为期限，能见梅花几度开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其一","author":"王炎","text":"园林都未觉春风，蓓蕾枝头茁小红。\n要识十分清绝处，暗香疏影月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梵老以小诗为寿和韵答之","author":"王炎","text":"不问鸾骖鹤驾仙，且游无色界中天。\n更烦办取诗千首，一岁从公索一联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野凫","author":"王炎","text":"白水满塘蒲荇青，野凫相对浴春晴。\n背人飞去犹回顾，我已忘机莫浪惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴 其二","author":"王炎","text":"雨过儿童饱饭牛，趁晴耕垦种来牟。\n田家作苦无储蓄，待哺全须麦有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴 其一","author":"王炎","text":"雨过千畦䆉稏黄，趁晴刈穫可登场。\n田家子妇开眉语，白粲新炊满屋香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴","author":"王炎","text":"云上山椒鸣竹鸡，愁行客路踏青泥。\n穷人也得天调护，乞与新晴可杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游岳麓三绝 其二","author":"王炎","text":"百级苍珉到佛宫，汲泉煮茗听松风。\n不须骑鹤摩云去，只要心游碧落中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游岳麓三绝 其一","author":"王炎","text":"湘山湘水极清远，特地来登百尺台。\n不尽胸中丘壑意，又从沙尾唤舟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游岳麓三绝 其三","author":"王炎","text":"山椒却立小迟留，欲傍江山洗客愁。\n不觉凭高来远念，此心潜与水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中杂咏十绝 其六","author":"王炎","text":"江天云暝雨垂垂，日暮移舟口岸时。\n拈笔欲题还袖手，细搜摩诘画中诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中杂咏十绝 其一","author":"王炎","text":"朝阳岩下莫云冷，冉水矶边秋树深。\n欲吊元和柳司马，溪山无力挽归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中杂咏十绝 其十","author":"王炎","text":"舴艋轻轻载短蓑，蘋花风急起沧波。\n凭谁唤取玄真子，更作湘中渔父歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中杂咏十绝 其二","author":"王炎","text":"江树疏疏兼密密，云根怪怪复奇奇。\n风光冷落无人问，付与渔翁理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中杂咏十绝 其九","author":"王炎","text":"江头昨夜雨何似，新涨平添一丈强。\n倚柂稳如天上坐，顺流明日到衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15845,"sha256":"18413bf73b9d