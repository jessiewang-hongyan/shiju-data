:"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪休上人少年读书以多病出家居泐潭为马祖修塔以三绝句来谒答一首","author":"苏辙","text":"早除郎将少年狂，祖塔结缘归故乡。\n习气未消馀业在，逢人依旧琢诗章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逊自淮康酒官归觐逾旬而归送行二绝句 其二","author":"苏辙","text":"乘田委吏责无多，旧学年来竟若何。\n开卷新诗可人意，到官无复废吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逊自淮康酒官归觐逾旬而归送行二绝句 其一","author":"苏辙","text":"官期未满许宁亲，平日宦游无此恩。\n雨遍公田及私亩，学书兼得问筠孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐相二绝 其二","author":"苏辙","text":"朝中寂寂少名卿，晚岁雄猜气益横。\n心怕无须少年士，可怜未识玉奴兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐相二绝 其一","author":"苏辙","text":"杨王灭后少英雄，犹自澄思却月中。\n已得惠妃欢喜见，方头笑杀曲江公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题石经院三首 其三","author":"苏辙","text":"孤绝山南寺，僧居无限清。\n不知行道处，空听暮钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题石经院三首 其二","author":"苏辙","text":"盘曲山前路，流年向此消。\n兴亡须一吊，范叟卧山腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题石经院三首 其一","author":"苏辙","text":"岧峣山上寺，近在古城中。\n苦恨河流远，长教眼力穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦虢夫人走马图二绝 其二","author":"苏辙","text":"朱幩玉勒控飞龙，笑语喧哗步骤同。\n驰入九重人不见，金钿翠羽落泥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读乐天集戏作五绝 其五","author":"苏辙","text":"乐天种竹自成园，我亦墙阴数百竿。\n不共伊家斗多少，也能不畏雪霜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读乐天集戏作五绝 其一","author":"苏辙","text":"乐天梦得老相从，洛下诗流得二雄。\n自笑索居朋友绝，偶然得句与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读乐天集戏作五绝 其三","author":"苏辙","text":"乐天投老刺杭苏，溪石胎禽载舳舻。\n我昔不为二千石，四方异物固应无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{