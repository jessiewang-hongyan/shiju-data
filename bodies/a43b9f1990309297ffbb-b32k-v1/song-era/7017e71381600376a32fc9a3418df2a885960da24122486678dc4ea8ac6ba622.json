[{"title":"奉和御制读五代晋史 其一","author":"夏竦","text":"子文怀妙识，奥学洞天常。\n恬淡游莲幕，谦虚践玉堂。\n至仁周仆御，大雅变词章。\n慎默诚无怠，危机可尽防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代晋史 其二","author":"夏竦","text":"大雅怀忠孝，当年效战征。\n询谋无败事，临敌有奇兵。\n安陆祅狂殄，宗城寇难平。\n察廉能恻下，何患政难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代梁史 其一","author":"夏竦","text":"李唐危汉祚，巢寇盛黄巾。\n嘉士逢多难，忠言变逆伦。\n决疑归大顺，定策戮奸臣。\n宜享崇高赠，千年道更新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读五代梁史 其二","author":"夏竦","text":"赞贞怀武鸷，转斗历炎凉。\n诚感泉源异，兵严士庶康。\n临危见忠愤，对敌擅威强。\n终始心无改，遗言更可伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读北齐书 其二","author":"夏竦","text":"咸阳诚赳赳，倚任极维师。\n贵势隆门绪，忠诚翼帝基。\n享年常戒满，避宠或兴咨。\n不学良无愧，嘉名已自垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读北齐书 其一","author":"夏竦","text":"段氏推忠武，论兵特造微。\n历朝功并建，诸将令咸依。\n重位无矜色，高门有德辉。\n当时勋贵族，孰不仰家肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读史记诗 其一","author":"夏竦","text":"陶唐明历象，茂气与天通。\n举正分星度，归馀定岁功。\n孟陬名不殄，南正道弥隆。\n自此垂三代，循环协大中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读史记诗 其二","author":"夏竦","text":"昭昭齐鲁事，千载著良箴。\n欲辨为邦体，先观布政心。\n变民非远略，从简是徽音。\n北面无馀意，诚因惠物深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读史记诗 其三","author":"夏竦","text":"汉武将从禅，须如亟释兵。\n甘泉诚毖祀，乔岳纪尊名。\n加礼崇休祉，修封盖号荣。\n岂同承帝箓，肆觐正权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后汉书诗 其三","author":"夏竦","text":"昭公详汉律，求比礼三千。\n刻敝深文息，宽平治德全。\n芳猷宣辅弼，馀庆茂忠贤。\n方验来嘉瑞，仁矜理最先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后汉书诗 其二","author":"夏竦","text":"独行惩浇俗，嘉名动远荒。\n至诚祈夏雨，严意励冬霜。\n果行推陵险，丰规叹履方。\n孤高惟大逊，寿考茂祺祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后汉书诗 其一","author":"夏竦","text":"明帝章朝物，三雍复旧常。\n籯金赏西域，雅乐奏南阳。\n拜老鸿徽茂，祈农盛典彰。\n珍符昭美应，献寿表隆昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后周书 其二","author":"夏竦","text":"南荆推德厚，千里远从师。\n奥识通三教，清声冠一时。\n就招虽暂至，恋本固难移。\n故老称前事，儒宗道益滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后周书 其一","author":"夏竦","text":"思道怀廉慎，童年类老成。\n郡豪尝詟服，边寇亦清平。\n临难输忠节，辞荣保令名。\n贤哉蹈仁义，举世可为程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后周书 其三","author":"夏竦","text":"迁哲承华绪，深谋事战征。\n艰危思大节，慷慨得群情。\n惠爱均戎旅，威名震敌城。\n江陵摧寇势，宵遁赖奇兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后魏书 其一","author":"夏竦","text":"伟哉登国世，灵武定戎兵。\n拓土能图大，求才实励精。\n公侯新爵重，台省旧风清。\n自匪谟长世，鸿图岂易成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读后魏书 其三","author":"夏竦","text":"真君昭密命，纪号表兴隆。\n瑞著洪河外，文成翠石中。\n帝名传祖祢，历数感王公。\n三五方兴运，明符事亦同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读宋书 其二","author":"夏竦","text":"镇恶才明举，英雄想冠时。\n推锋平内侮，直指定西陲。\n向使鸿勋就，宁忧霸业衰。\n如何丧方召，遗烈漫伤咨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读宋书 其一","author":"夏竦","text":"汉宗开圣绪，得岁与周同。\n金石终移律，山河始誓功。\n飞名传秘记，嘉谶起游童。\n能使奸豪詟，诚为一世雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读陈书 其一","author":"夏竦","text":"猛奴多勇槩，大槊事戎征。\n新蔡凶围陷，鱼梁寇垒倾。\n溯风轻古法，间道贵奇兵。\n懋赏宜开府，番禺已尽平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读陈书 其二","author":"夏竦","text":"灵洗虽骁勇，忠规讵可轻。\n石城尝力战，黟歙本连盟。\n京口殊勋茂，临川叛寇惊。\n既能明号令，何惜务宽平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读前汉书 其二","author":"夏竦","text":"子房天授汉，不战道尤尊。\n秘法盈编受，危机借箸论。\n避封昭止足，辟谷厌尘喧。\n莫讶萧规茂，从容有绪言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读前汉书 其三","author":"夏竦","text":"高祖宽仁主，淮阴变诈才。\n设坛诚有礼，推食本无猜。\n怀惠初颙若，夸功抑殆哉。\n何如中正者，千载仰高裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读前汉书 其一","author":"夏竦","text":"酂侯依日月，天汉叙隆昌。\n迈德居三杰，观时定九章。\n过因王尉辩，功赖鄂君扬。\n终以同心美，清宁赞后王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读唐书 其一","author":"夏竦","text":"天祚文皇德，元成雅道施。\n纳忠裨阙政，偃革致昌期。\n宴喜刀方解，人亡鉴遽隳。\n数行遗奏在，犹可动神祗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读唐书 其二","author":"夏竦","text":"哲辅延清问，元和致治平。\n从人成庶务，求瘼济群氓。\n务远能无怠，求材可倚成。\n乃知虞舜德，恭已固难名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读唐书 其三","author":"夏竦","text":"贤哉段忠烈，振迹自邠宁。\n动必怀刚毅，何尝废典刑。\n英规方贯古，乐石谅难铭。\n密议初如用，艰危岂易形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读晋书 其三","author":"夏竦","text":"士行勤武力，机鉴信良哉。\n国赖桓文业，人推葛陆才。\n殊祥双鹤至，吉梦八门开。\n终始全高节，诚因左翼推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读晋书 其一","author":"夏竦","text":"安石陵霞致，清言振玉音。\n鸿勋济世久，厚德感人深。\n朱组虽然袭，虚舟岂易沉。\n东山高志在，潇洒谢尘襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读晋书 其二","author":"夏竦","text":"李重推清雅，初传友爱名。\n嘉言为时发，大谊傅经明。\n崇德诚堪慕，修身岂易倾。\n留心众才举，千载仰铨衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制读隋书 其一","author":"夏竦","text":"里仁怀远度，大雅擅嘉名。\n制礼通时变，求书赞治平。\n推心清选举，从俭化黎氓。\n终始承恩遇，芳猷冠老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制清心殿水清木再连理","author":"夏竦","text":"禁中迟日照南荣，瑞木联祥耀国经。\n合干旧临宫槛密，交柯重接帝梧青。\n华平对植行侵陛，若木相辉影满亭。\n况是斋心延贶地，愈昭天意答惟馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制喜春雨","author":"夏竦","text":"太液冰销春水生，华林气暖暮烟横。\n忽闻甘澍中宵降，共庆丰年上瑞呈。\n拂地如丝笼北阙，映花疑雾霭南荣。\n原田脉起承甘润，自此嘉生永顺成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制景灵宫迎牌","author":"夏竦","text":"紫馆成功属盛时，道迎金榜耀文思。\n沉沉殿翼弥增丽，矗矗圭棱尽中规。\n祗荐宝香清吹袅，下观飙御彩云随。\n群心仰止兴谣诵，永见千龄播缉熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘僧舍闲望","author":"夏竦","text":"胜地访灵踪，层楼四槛风。\n远阴生旷野，午影转疏桐。\n涧水霞凝紫，溪烟日衬红。\n可怜秋思晚，相倚馆娃宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"话道","author":"夏竦","text":"清净无营即自由，神仙何必待人求。\n秦皇多诈死犹讳，汉武穷兵老未休。\n巨费漫悲徐市药，怪书空验少翁牛。\n须知方寸真元意，不在层城十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵","author":"夏竦","text":"虎踞龙盘委薜萝，台城春雨长寒莎。\n梁家不觉市朝改，萧寺只闻钟磬多。\n云树暮堤攒剑戟，风篁虚谷转笙歌。\n须知王气随明主，不据金陵又若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词","author":"夏竦","text":"柳带分阴接殿基，笙歌还拥翠华归。\n前宫晓赭匀妆脸，别馆春红晒舞衣。\n槐影对笼苔点细，桐花西倚夕阳稀。\n夜来梦上檀香阁，犹映珠帘避贵妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日寄陈舍人","author":"夏竦","text":"浓淡晴霞泛夕阳，重重烟蔼护流芳。\n花残远渡晓风急，路入层云春梦长。\n结蕙翠光留蝶舞，含桃红实驻莺尝。\n可怜得意文章客，扈跸西园月桂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游","author":"夏竦","text":"艳艳春风雨半收，少年疏诞称春游。\n将军雪散桥边市，骑省花开县外楼。\n草嫩玉堤藏堕珥，酒浓金盏滑歌喉。\n谁能借取瑶池马，乱踏红尘四百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洛中春旱祷龙门无畏塔得雨","author":"夏竦","text":"露盘金索出危岑，风卷惊尘扑翠林。\n五夜清场严佛事，一犁甘澍慰民心。\n圣君旰食忧应减，守吏斋诚祷更深。\n泛滟洛川皆帝力，好浮青鲤瑞烟寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日江馆喜弹琴羽人至","author":"夏竦","text":"水馆凄清天一涯，喜逢仙盖驻灵芝。\n烟霞初散海中会，风雨忽来江上期。\n琴轸玉寒弹宿露，酒卮金暖对朝曦。\n圯桥书在如相授，不独留侯是帝师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日村路","author":"夏竦","text":"落照明残菊，村亭路欲分。\n酒旗降远客，雁阵战秋云。\n断陇拳鳌足，轻波起鹤纹。\n田家逢乐岁，歌舞贺时君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日送人西上","author":"夏竦","text":"旅程看驿道，西去兴何如。\n南国秋霖后，斜阳树影疏。\n野光飞翠羽，溪艳照红蕖。\n好去朝端客，人争草荐书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日送人南游","author":"夏竦","text":"几驿苏台路，轻装转塞蓬。\n夜船千棹月，寒酒一旗风。\n水闇菰蒲老，山明橘柚红。\n算君回首处，晓色五湖东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晓","author":"夏竦","text":"半庭残月在，江郡鼓声初。\n秋气满南国，晓云高太虚。\n负霜鸿翼健，含雾橘花疏。\n此景无人共，朝阳入敝庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人","author":"夏竦","text":"野色兼行色，长亭一送君。\n束书登古路，重茧踏寒云。\n山过天台小，溪临婺女分。\n流光须强学，当宁正崇文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人入越","author":"夏竦","text":"广陵江口柳疏疏，自领笙歌上舳舻。\n一片晓山迎越绝，数程春水背姑苏。\n莲供晚果蜂房细，鲙市朝餐线缕粗。\n他日功成待相访，谢家烟月借人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之淮西","author":"夏竦","text":"五里亭前一送君，碧油红旆驻清尘。\n半轩晚日淮西路，数拍离歌江上春。\n杜宇有情移别树，野花无主傍行人。\n男儿多少酬恩地，不欲东风泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人出牧","author":"夏竦","text":"圣主念元元，良臣选掖垣。\n紫墀分使节，红旆出都门。\n雪浅斜阳路，云深晚烧村。\n期年如报政，应许贺新恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游关右","author":"夏竦","text":"朝曦轻抺柳梢长，歌彻邮亭饬去装。\n鹑首右瞻秦分野，虎牢西入汉关防。\n温泉雨霁离宫碧，麟畤沙惊塞日黄。\n如访平戎最长策，不徒鞭马为诗忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送太傅相公居留洛宅","author":"夏竦","text":"梓泽芝田尊帝里，玉符金钥委台司。\n家传旧节居连帅，史作新书赞父师。\n留府櫜鞬分骑引，都门圭组斗班辞。\n共惊河洛初开奥，一日龙光四海知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王端公充荆湖北路转运","author":"夏竦","text":"锦衣骢马好还家，大别山边汉水斜。\n霜简位高增意气，金章恩重有光华。\n几程蛮徼云藏驿，一棹荆江月照沙。\n多少朝簪鬓成雪，愿君休访楚山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江宁相公","author":"夏竦","text":"六朝台榭好山川，丞相遥分造化权。\n两府规模遵故事，二南风什听新篇。\n平反庶狱棠庐外，约束诸侯玉帐前。\n莫讶依依恋行色，寿藩书命最多年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张学士赴阙","author":"夏竦","text":"东观尝联袂，南州各退飞。\n同倾就日恋，先喜赐环归。\n旧业怀铅笔，晨装振綵衣。\n离弦有馀思，凄切寄南徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李殿院知防州","author":"夏竦","text":"屈草联芳映法冠，亭亭风度耸朝端。\n一麾出守秦城近，千里班春汉诏宽。\n引道画旗迎马重，褰帷霜简照人寒。\n都门回首多离绪，宝瑟凄风别酒阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送苏台守受代归朝","author":"夏竦","text":"香案当衙拜凤书，使君旌节下姑苏。\n宾朋唱和诗千首，耆幼扶携酒百壶。\n野树遮藏过建业，乱山迎送出江都。\n西风不得同归去，红藕花边望舳舻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送修撰杨学士留守南京","author":"夏竦","text":"画船椎鼓忽东浮，留幕宾从候舳舻。\n宫里铜鱼勘门钥，府中银兔合军符。\n鸣驺苑路人千骑，送客河桥酒百壶。\n莫为文章还自苦，骛池龙岫且游娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送济南杜郎中","author":"夏竦","text":"秋树参差堕叶红，剖符还过故乡东。\n星分北陆龟蛇内，位应哀乌太紫中。\n亭传宛如行部日，冠缨犹带触邪风。\n寒泉岂是无人塞，应待君侯立事功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送益州同理张殿丞","author":"夏竦","text":"远指三川路，初辞六尚班。\n占星度危栈，叱驭下灵关。\n职亚铜符重，兵销玉帐闲。\n汉台谁视草，应待长卿还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送新恩善济处士归玉笥","author":"夏竦","text":"蠲疴妙剂分黄阁，驻景仙山奉紫闱。\n太秀山川须长价，少微星宿已增辉。\n幅巾不被尘缨缚，别笈唯封赐药归。\n唳鹤鸣猿好相候，利名无染世还稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐柏观","author":"夏竦","text":"鸟道寒藤结，洞门苍藓深。\n楼台在山畔，松桧出云心。\n土暖春长在，峰高月易沉。\n羽衣祠太乙，香冷石坛阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狼山渡口有作","author":"夏竦","text":"渡口人疏黯翠烟，登临犹喜夕阳天。\n残云右倚江都树，远水南回建业船。\n山引乱猿嘷古寺，电驱甘雨过闲田。\n季鹰死后无归客，江上鲈鱼不直钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题友人郊居 其二","author":"夏竦","text":"卜筑远朝市，著书成岁功。\n长云覆孤木，古道满清风。\n地胜花房异，山灵雨气通。\n纶巾不可恋，鹤版下关东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题友人郊居 其一","author":"夏竦","text":"群书架寒壁，庶事得从容。\n花木移诸寺，云泉借数峰。\n积阴春作雨，瘦竹老成筇。\n应笑南阳士，明朝久卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张相公","author":"夏竦","text":"台司金印护诸侯，冲气均和耐素秋。\n户牖旧谋方倚重，莬裘前计合迟留。\n岂同少傅轻辞汉，况有维师永佐周。\n秉烛家园且行乐，即应重起济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇胜寺","author":"夏竦","text":"山当庐阜五峰边，地占侯溪好习禅。\n杳蔼峰峦云蔽日，参差楼殿瓦生烟。\n僧房宿鸟栖帘外，客馆鸣泉过枕前。\n但可登临闲访古，西来无法与人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚望","author":"夏竦","text":"雨霁吴城晚，溪泉四散流。\n禽归半峰树，人在夕阳楼。\n国望分江海，星躔次斗牛。\n堪嗟兴废地，千载有闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]