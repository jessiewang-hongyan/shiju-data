[{"title":"送夤上人归道场山","author":"释智圆","text":"行行携锡别，幽景到山分。\n残雪经春在，疏钟度水闻。\n松深生晚吹，潭静照闲云。\n岩阁重开讲，清香入夜焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻蝉","author":"释智圆","text":"江天凉雨霁，嘒嘒出疏林。\n清极残阳里，愁生远客心。\n离亭秋草碧，荒堑暮烟深。\n不忍多时听，吟髭雪暗侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭辩端上人","author":"释智圆","text":"平昔于诗苦，精搜省未闲。\n坏房空鸟外，清句满人间。\n瘦影悬邻壁，孤坟接旧山。\n吊回高树下，寒水自潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日寄谅律师","author":"释智圆","text":"澄江杳杳映千峰，坐夏岩房一望中。\n昼讲疏钟清度越，夜吟残月冷垂空。\n扫轩静避阶棱藓，销暑闲当竹罅风。\n顾我相怀未能去，水边斜日照梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日薰风亭作","author":"释智圆","text":"四野炎炎暑气隆，危亭孤坐与谁同。\n湖光淡荡涵残照，鸟影参差没远空。\n消息浮生凭至理，破除烦暑赖清风。\n明时不敢言招隐，自乐林泉慕远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扇","author":"释智圆","text":"霜缣裁制赖金刀，冷淡还宜画海涛。\n盛夏有功风自远，凉秋无用架偏高。\n谭筵几谢驱烦热，征路长蒙解郁陶。\n未得袁宏手中握，扬仁何处可施劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅中别赵璞","author":"释智圆","text":"策马将登路，星河曙色分。\n残灯照离席，来雁咽寒云。\n乡远书难到，吟狂酒易醺。\n堪嗟经济术，未得致明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅中即事寄友生","author":"释智圆","text":"攲枕不成梦，寒虫叫壁阴。\n高梧深夜雨，远客故乡心。\n分与浮名背，年将白发侵。\n终须约宗炳，结社向东林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浙江晚望","author":"释智圆","text":"景象依依满目前，倚筇闲望思凄然。\n隔云清磬山傍寺，照水孤灯渡口船。\n荡漭落潮平古岸，参差归雁没遥天。\n钱王霸业今何在，牢落荒城积野烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题因师院石楠花","author":"释智圆","text":"阳和资万木，独此异群花。\n映草惊残烧，临窗认晓霞。\n色虽因雨减，势不逐风斜。\n幸赖栽培力，繁枝斗日华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题闻氏林亭小山","author":"释智圆","text":"檐前状奇险，咫尺见清幽。\n鸟下疑灵鹫，僧过认沃洲。\n危遮虚槛月，冷夺远峰秋。\n始信红尘里，豪家有胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中雨夜怀同志","author":"释智圆","text":"杉竹竞霪霪，天时正积阴。\n背窗秋烛暗，攲枕夜堂深。\n月被重云蔽，萤依湿气沉。\n无憀不成寐，况复想知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起","author":"释智圆","text":"秋尽积雨歇，幽忧病渐安。\n眼疼嫌字小，身瘦觉衣宽。\n倚杖防苔滑，开炉怯夜寒。\n浮生能几日，长作水沤观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起二首 其二","author":"释智圆","text":"湖天淡荡雁参差，行乐支筇绕所居。\n古壁苔荒鸣蟋蟀，水轩风冷谢芙蕖。\n看云默诵空王偈，拂榻闲开孔圣书。\n闭户无人慰寥索，草堂深夜照蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起二首 其一","author":"释智圆","text":"衡门牢落雨苔斑，病起深秋气象闲。\n照水未能嗟白发，倚栏重得见青山。\n风高砌木蝉犹噪，社近茆堂燕已还。\n孤坐孤吟又终日，有谁来此问衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读杜牧集","author":"释智圆","text":"谗佞当面唾，轻生不得殳。\n去邪空有志，嫉恶奈无徒。\n后世名垂远，当时道亦孤。\n荒斋独怀感，残日照庭芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读清塞集","author":"释智圆","text":"立意造平淡，冥搜出常情。\n何人知所得，后世谩传名。\n云树饥猿断，冰潭片月倾。\n如无子期听，绿绮为谁鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读楞严经","author":"释智圆","text":"案上楞严典，时看浣病愁。\n阶闲移短影，窗冷值高秋。\n眼病花无果，心狂照失头。\n指空期识月，认指更悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"释智圆","text":"世态如轮转，劳生岂定期。\n否终还受泰，乐极又生悲。\n商代尊伊尹，秦庭戮李斯。\n未能知幻化，安得證无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿山院","author":"释智圆","text":"一宿无尘境，相留静话长。\n秋声归古木，月色满空廊。\n岚气侵衣润，溪泉漱齿凉。\n终期整瓶锡，来此掩闲房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿仲系上人房","author":"释智圆","text":"偶从支遁约，深夜宿闲房。\n窗静灯遗烬，庭寒树有霜。\n禅心论的的，尘事省茫茫。\n又说天台去，林间扫石床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄仁侄","author":"释智圆","text":"庭木西风动，闲轩落叶稠。\n梦回霜月晓，信断海山秋。\n道性归无念，孤吟已绝愁。\n况疏林下约，烟水路悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄天台守能上人","author":"释智圆","text":"台岭林泉胜十洲，忘机长往更无愁。\n考槃高趣何人识，招隐新题几处留。\n深夜定回华顶月，经年书断海门秋。\n谁知抱疾西湖上，南望云山想胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄文照大师","author":"释智圆","text":"两制音书数往来，城中栖隐远尘埃。\n吟斋夜静开明月，讲石秋深扫绿苔。\n出俗旧题留雪苑，卧云幽兴梦天台。\n林间抱疾怀高趣，翻笑汤休漫有才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石城行光长老","author":"释智圆","text":"幽栖尘想绝，岩阁倚杉松。\n吟思禅中尽，霜髭病后浓。\n溪闲澄夜月，山静答秋钟。\n寂寞怀高趣，残阳独倚筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄华亭虚己师","author":"释智圆","text":"懒答公卿信，高眠野兴浓。\n虚堂开夜月，孤枕度秋钟。\n临水成新作，看云忆旧峰。\n林间仍抱疾，早晚遂相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄同志","author":"释智圆","text":"静院无来客，相怀日又曛。\n数峰寒有雪，一榻静眠云。\n几叹淳风丧，宁容俗态群。\n终期一相访，对坐议新文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄江上僧","author":"释智圆","text":"江寺期终老，清香讲次焚。\n月怜秋后见，潮爱夜深闻。\n古木青阴合，残云静片分。\n相怀未能去，来雁又成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄西山智道人","author":"释智圆","text":"净业修持久，攀缘念已摧。\n冰潭残月在，古岸夜禅回。\n像烛微留燄，炉香冷变灰。\n时逢旧参侣，闲坐话黄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄余秀才","author":"释智圆","text":"去秋曾访我，一别又经年。\n落日无来信，西风满耳蝉。\n头应添素发，诗合有新编。\n未可轻丹桂，蹉跎老海边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴黔山人","author":"释智圆","text":"鸟外自长往，人间过几年。\n狂吟轻岁月，高趣狎神仙。\n醉卧云蒸榻，渔归雪满船。\n想思未相识，终夜梦林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄远","author":"释智圆","text":"车声日日碾红埃，何事良人独未回。\n苔锁洞房书久绝，月明深夜雁空来。\n寒侵竹叶难成醉，尘暗菱花更懒开。\n杳杳云山不知处，夕阳频上最高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄定海许少府","author":"释智圆","text":"见说梅仙邑，波涛接杳冥。\n讼庭秋藓合，吟阁海云醒。\n爱月宵留客，寻僧昼掩扃。\n公馀幽兴在，时梦故山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄若讷上人","author":"释智圆","text":"江滨方话别，倏忽十年馀。\n感旧空阙梦，闲眠懒寄书。\n砌凉鸣蟋蟀，潭冷照蟾蜍。\n北望沧波阔，无由访所居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄咸润上人","author":"释智圆","text":"流俗不知处，深栖趣转幽。\n闲房扃翠岳，远信司沧洲。\n定起花残砌，诗成雪满楼。\n相怀未能去，南北路悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄省悟师","author":"释智圆","text":"平湖波渺渺，踪迹杳难寻。\n城里无时到，云边闭户深。\n寒灯明古像，晚磬出疏林。\n寂寞怀高趣，西轩日易沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵璞","author":"释智圆","text":"故乡勾践国，解印挂帆归。\n吟苦容虽瘦，官情道自肥。\n堂幽山屐在，厨冷甑尘飞。\n莫向云门下，高歌便采薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄圆长老","author":"释智圆","text":"澹虑栖幽境，闲将水石邻。\n信衣传往祖，禅语示来人。\n晚屋茶烟细，晴轩岳翠匀。\n相怀独南望，林木又经春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄栖白师","author":"释智圆","text":"深隐空林下，清幽绝外缘。\n雨窗封岳信，苔井滤秋泉。\n门静来沙鸟，庭闲噪晚蝉。\n凭栏独相忆，残日下遥天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄海慧大师","author":"释智圆","text":"云门卜深隐，谁复继高踪。\n旧寺抛双阙，新题咏十峰。\n禅开杉径月，讲候雪楼钟。\n莫怪相寻晚，嵇康性本慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄润侄法师","author":"释智圆","text":"庭木凝秋色，依依废苦吟。\n来书江上绝，幽梦雨中深。\n水鸟闲窥砚，窗灯冷照琴。\n谁知此时兴，华发暗相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄梵天上方政侄","author":"释智圆","text":"一讲更无事，翛然自不群。\n闲情江上月，孤迹槛前云。\n径冷秋苔合，杉寒宿鸟分。\n涛声旦暮近，应向出禅闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄隐者","author":"释智圆","text":"散发空林下，人间事不知。\n风高蕙帐冷，天远鹤书迟。\n瓶尽花朝酒，扃残寒夜棋。\n无由访幽趣，踪迹阻江湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄湖西逸人","author":"释智圆","text":"门掩翠层层，闲眠枕曲肱。\n破篱冲晚浪，古屋漏秋灯。\n月上招邻叟，诗成寄岳僧。\n满朝簪组客，谁识醉腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄湛上人","author":"释智圆","text":"几年辞辇寺，拥衲住云林。\n上国归心绝，千峰去梦深。\n残经看雪卷，好句听秋吟。\n曾有寻高迹，禅房古木阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄葛溪爽上人","author":"释智圆","text":"削尽浮华念，闲居道已成。\n梦幽关水石，门冷掩杉柽。\n百衲禅中弊，苍髭病后生。\n何人问真理，笑指葛溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄辇下译经正觉大师","author":"释智圆","text":"水国无归梦，年来帝泽深。\n梵书翻宋语，道论变吴音。\n静室清香凝，闲庭古树阴。\n玉华前事在，高迹许谁寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄道士","author":"释智圆","text":"长闻披鹤氅，城市往来频。\n得道人难测，和光迹易亲。\n堂闲秋捣药，坛冷夜朝真。\n几忆蓬壶顶，蟠桃斓漫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蜀川王道士","author":"释智圆","text":"鹤驾几迟留，岷峨水石幽。\n御风同列子，梦蝶拟庄周。\n醉卧空林月，狂歌古观秋。\n何时归阆苑，闲共老仙游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄德聪师","author":"释智圆","text":"古院稽山下，幽栖厌客寻。\n机心禅外尽，诗思病来深。\n瓶水寒澌结，杉风晚磬沉。\n他时若招隐，香火继东林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄慧云大师","author":"释智圆","text":"繁华辞帝辇，岑寂峦山林。\n志向浮名淡，房扃古寺深。\n诗窗来皓月，斋磬下幽禽。\n终约逢新雪，闲过话静心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题虎丘山","author":"释智圆","text":"崛起孤峰号虎丘，奇踪宁与众山俦。\n月涵秦始剑池冷，藓駮生公讲石幽。\n招隐未能居绝顶，卧云空欲学前修。\n披图尽日身难到，杳杳烟波茂苑秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题聪上人房庭竹","author":"释智圆","text":"结根依静砌，萧洒映禅房。\n高节欺群木，青阴过短墙。\n夜声喧梦枕，秋露滴琴床。\n遥想添吟思，闲观到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠子正律师","author":"释智圆","text":"威仪闲淡许谁同，苔径依然绝履踪。\n霜井滤泉侵晓色，雪房攲枕梦诸峰。\n寒生静榻吟中月，冷答平湖讲次钟。\n尽日冥心忆高趣，三生行止道生松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曦照上人","author":"释智圆","text":"尘外禅房掩渺瀰，高情终与俗流违。\n苦吟几度成华发，默坐连宵忆翠微。\n风带荷香飘静榻，雨滋苔色污闲扉。\n炎天几阻相寻兴，空倚危楼对落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼广钧师","author":"释智圆","text":"北僧传示灭，高迹更难寻。\n故国房空在，新坟草已深。\n云泉违旧约，风月罢论心。\n默坐看遗偈，西窗月又沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梵天寺二首 其二","author":"释智圆","text":"梵宇清虚远俗喧，登临时得爽吟魂。\n卷帘高雪明稽岭，上阁秋涛出海门。\n群木冷阴连古塔，疏钟寒韵彻江村。\n城中泉石诗中景，闲对文公尽日论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梵天寺二首 其一","author":"释智圆","text":"路上中峰势屈盘，尘埃踪迹到终难。\n秋杉影射经窗冷，夜浪声摇睡榻寒。\n云过闲轩香篆润，日移幽砌藓痕乾。\n吟馀静立凭栏久，极目长江水渺漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梵天寺闲居书事","author":"释智圆","text":"松杉围静室，踪迹远人群。\n抱疾添华发，看山羡白云。\n苔痕经雨长，蝉韵带风闻。\n独坐无来客，西轩日又曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深居","author":"释智圆","text":"牢落谁知趣，深居野兴饶。\n固穷期道在，寡合鄙时浇。\n径静苔长绿，山寒雪未消。\n残阳荷轻策，闲望傍村桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"释智圆","text":"鹤发闲梳小棹轻，芦花深处最怡情。\n自怜身外唯烟月，肯信人间有利名。\n闲脱绿蓑春雨霁，醉眠深浦夕阳明。\n陶陶终岁无人识，应笑三闾话独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游开化寺","author":"释智圆","text":"地绝纤尘万籁清，当门幽致画难成。\n黛妆峰岫高低影，练卷波涛旦暮声。\n侵竹古廊秋藓合，倚云禅阁夜灯明。\n上方别有幽栖处，树石参差称野情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游风水洞僧院","author":"释智圆","text":"风水分双洞，幽奇类沃洲。\n猿吟清彻夜，山色冷宜秋。\n云拥阶前石，钟残竹畔楼。\n贤哉白太守，五马旧曾游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石壁寺","author":"释智圆","text":"寺幽称绝境，荷策自登临。\n翠岳千峰险，寒松一径阴。\n清香秋殿冷，疏磬古廊深。\n静立忘归兴，残阳鸟忽吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵隐山","author":"释智圆","text":"峭壁侵霄极，灵踪不厌寻。\n闲思曾有梦，归隐岂无心。\n绝壁烟霞丽，幽岩洞穴深。\n那堪思慧理，残日白猿吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上晚望寄友人","author":"释智圆","text":"不得天涯信，相思对景浓。\n惊飙吹落叶，残日在遥峰。\n照水鱼村火，沈烟野寺钟。\n幽怀向谁说，静立自支筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖居即事寄仁侄","author":"释智圆","text":"讲退临流独倚筇，尘埃无处寄闲踪。\n青山归去心长在，白发生来事转慵。\n门径草深梅雨歇，像龛灯暗水烟浓。\n相知唯有摇松客，时辱音书慰病容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登武林高峰","author":"释智圆","text":"千寻堆冷碧，极顶绝尘踪。\n雨霁闻清籁，云开见别峰。\n落泉喷怪石，惊鸟入深松。\n吟罢凭栏久，遥天起暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼怀遵易","author":"释智圆","text":"闲景杳无极，凭栏思若何。\n鸟行沈远岳，秋色满沧波。\n来信经年绝，新愁向晚多。\n依依自吟望，旧约负烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]