[{"title":"送刘伯瑞通判还吴兴","author":"程洵","text":"土牛方著劝农鞭，画鹢俄闻叠鼓喧。\n别驾但知催理楫，邦人政自欲攀辕。\n黄堆荒径重寻菊，绿拥高堂更树谖。\n只恐清朝方急士，未容一室老陈蕃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王驹父袖诗见过次韵赠之","author":"程洵","text":"平生志业在经纶，老去未充观国宾。\n□道心□□地镜，固应文□挂夫绅。\n大儿从昔轻馀子，丞相何时荐此君。\n莫为穷通移晚节，岁寒方始见天真。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宋郎中刘寺簿刘监庙燕集王大夫山林","author":"程洵","text":"飞旆翩翩乱晚霞，欣闻胜集俯云沙。\n新诗宛似风行水，和气想如春在花。\n大隐勿嫌朝市闹，朱幡方映绣衣华。\n尘埃短簿今仓氏，怅望清游转觉赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季章命赋周益公府双头莲盖太守所送者","author":"程洵","text":"桃根桃叶竞妍华，清远谁知别有花。\n天为苍生娱一老，地从绿水涌双葩。\n流传已入骚人句，走送曾烦刺史家。\n却笑昌黎求玉井，路迷青壁重咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"益公得牡丹状如双鱼者以花嫔目之且赋诗俾予属和","author":"程洵","text":"妆镜台前酒一卮，风流从古说杨妃。\n谁令山鬼欺红粉，却与花王司御衣。\n比儗莫嫌鱼共贯，轻狂犹胜燕争飞。\n老生无分陪清赏，空想邹枚他夜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赠欧阳伯威","author":"程洵","text":"窗閒花影夜摇春，窗外谁呼祁孔宾。\n不信名山谢逋客，至今陋巷卧遗民。\n日高谩戛生鱼釜，门掩应无没马尘。\n遥想撚须时得句，又书尺纸报平津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别","author":"程洵","text":"搔头日日数归程，谁信先生少宦情。\n趣驾不知千里远，振衣始觉一身轻。\n霜林竹柏元同劲，世路风波底用惊。\n独我临分苦悽恻，从今怀抱向谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王守仁竹斋 其一","author":"程洵","text":"黄尘车马去如流，名利劳人死不休。\n心远地偏何处是，小斋丛竹媚深幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王守仁竹斋 其二","author":"程洵","text":"月度寒光影瘦疏，风传清籁韵虚徐。\n幽人宴坐蒲团稳，读罢儒书读佛书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨日新用所赋月壶韵作诗见寄依韵复之 其一","author":"程洵","text":"霜凋群木雁横空，宴坐茅茨促膝容。\n忽有新诗来眼底，巉临绝岸倚孤峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨日新用所赋月壶韵作诗见寄依韵复之 其二","author":"程洵","text":"观心要与月同明，觅句应须水样清。\n老去不妨文豹隐，郎君已见角犀盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨用山谷韵呈薛使君","author":"程洵","text":"畏日炎风是处同，使君闵闵甚三农。\n新诗仰看奔牛堰，好雨忽迷回雁峰。\n千里祇今被膏泽，一堂行见会云龙。\n由来肤寸沾天下，衡岳英灵等岱宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"赵祖德","text":"终当计勇决，湖山足徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠相士徐鬼眼","author":"蔡元定","text":"挟术满天下，谁人解识真。\n不因眼是鬼，那得口如神。\n坚白三寸舌，雌黄一世人。\n操修果无愧，方可问人伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘忠肃二首 其一","author":"蔡元定","text":"今代中兴佐，如公有几人。\n秉心先许国，临事辄忘身。\n才略优中外，清忠表缙绅。\n天乎何不淑，遽夺我元臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘忠肃二首 其二","author":"蔡元定","text":"大节人谁识，孤忠我独知。\n文章亦馀事，轩冕竟何为。\n国耻生期报，臣心死未衰。\n凄凉遗奏稿，千载有馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谪舂陵别诸友","author":"蔡元定","text":"天道固溟漠，世路尤险巇。\n吾生本自浮，与物多瑕疵。\n此去知何事，生死不可期。\n执手笑相别，无为儿女悲。\n轻醉壮行色，扶摇动征衣。\n断不负所学，此心天所知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其一 岱山夕照","author":"蔡元定","text":"望断高峰眼不花，个中仿佛认人家。\n情知一样青山色，才有斜阳景更佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其二 烟村春雨","author":"蔡元定","text":"堆螺叠翠耸奇峰，花柳村村绿间红。\n不有翠微翁说破，谁知春在雨烟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其三 云岩山色","author":"蔡元定","text":"山染烟光弄晚岚，几多碧色映寒潭。\n篆烟销尽金炉冷，云满岩前月满庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其四 祇园溪声","author":"蔡元定","text":"桥枕东流路透西，桥边梵刹亦幽奇。\n人来问道不须问，抵听溪声悟佛机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其五 松冈夜涛","author":"蔡元定","text":"万顷云涛轰怒雷，更深好梦遽惊回。\n老松本是无声物，恰值风从天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其六 莲湖晚风","author":"蔡元定","text":"湖面花开映绿波，当年曾听采莲歌。\n垂杨拂地云临水，举目令人感慨多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其七 武陵桥月","author":"蔡元定","text":"长虹倒景蘸清溪，掩映银蟾景绝奇。\n题柱惜无人继志，览今思古强吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麻沙八景诗 其八 象岩晴雪","author":"蔡元定","text":"风捲寒云收晓晴，岩岩白石自天生。\n远看似雪还非雪，有物元来是混成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自咏","author":"蔡元定","text":"独抱韦编过客稀，箪瓢不厌屡空时。\n幽然自与庖羲近，春去人间总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西斋自咏","author":"蔡元定","text":"数椽茅屋环流水，布被藜羹饱煖馀。\n不向利中生计较，肯于名上著工夫。\n窗前野马闲来往，天霁浮云自卷舒。\n穷达始知皆有命，不妨随分老樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"推衍后世休咎","author":"蔡元定","text":"显庆堂将后世推，子孙绍复承吾书。\n四传学业家还在，五世因贪人铲除。\n续缵流风六七代，继兴遗迹八九渠。\n数终轮奂犹有待，御史尹仁为吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次晦翁韵","author":"蔡元定","text":"屈指抠衣十七年，自怜须鬓已皤然。\n久知轩冕真无分，但觉溪山若有缘。\n下学工夫惭未到，先天事业敢轻传。\n祇今已饱烟霞痼，更乞清溪理钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠蔡季通","author":"蔡元定乡人","text":"掘尽人家好丘陇，冤魂欲诉更无由。\n先生若有尧夫术，何不先言去道州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽蔡西山先生","author":"黄瑞节","text":"直所遭之惨兮天意奚屈，忽讣音遽闻兮哀痛不淑。\n痛哲人云亡兮邦国殄瘁，感死生永诀兮莫睹其悲。\n伤吾道终穷兮何心于世，相长号以酬兮阴辅吾志。\n惟下观而化兮风声远被，想神之有灵兮馨此铭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝阳洞","author":"朱晞颜","text":"湖上初惊八月秋，岭头又见桂香浮。\n巾车几忆陶彭泽，竹马多惭郭细侯。\n未遣灵泉还旧隐，且同岩壑访真游。\n一枰胜负人何在，试问樵柯已烂否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游壶天观泛舟过龙隐洞小酌至月上而归","author":"朱晞颜","text":"浪道湘南是瘴乡，玉壶银阙四时凉。\n卧龙不逐葭灰动，爱日空惊绣缕长。\n浮蚁且同佳节醉，探梅不作少年狂。\n暮归惭愧山头月，照我骎骎两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏波岩","author":"朱晞颜","text":"天斲神剜不记年，洞中风景异尘寰。\n江波荡漾青罗带，崖石虚明碧玉环。\n地接三山真迹在，天连合浦宝珠还。\n重来恍似乘槎到，惭愧云门夜不关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弹丸山","author":"朱晞颜","text":"伤弓枉木漫猜嫌，岩石棱棱弹样圆。\n雕鹗横空秋凛凛，凫鸥渡水晚翩翩。\n私心灰冷慵思缴，蹇步尘劳不受鞭。\n挟弹张弓付年少，归欤趁取菊花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞底石间得枯木一株花叶咸无而枝干峭拔扣之铿然有声因成鄙句刻之岩石间","author":"朱晞颜","text":"天教海若效珍祥，不与千林春竞芳。\n掷地遗音清戛玉，凌云直干凛凝霜。\n谁浮鲸海星槎到，犹带蟾宫月桂香。\n冶叶浮花埽除尽，坚高直欲共天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"假日过龙隐山有以千叶白梅献者辄成鄙句","author":"朱晞颜","text":"素艳重重叠雪轻，先春不怕雪霜凝。\n人言五岭地皆热，谁折一枝寒欲冰。\n似笑疏花太孤瘦，故教密叶拥千层。\n湘南别有新春样，拚醉花前唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元改元寒食日陪都运寺丞游白龙洞时牡丹盛开小酌岩下夕阳西度并辔而归","author":"朱晞颜","text":"小溪漱碧响潺潺，路入龙宫杳霭间。\n佳节漫添新白发，故人赖有旧青山。\n花朝几共湘南醉，萍迹何年岭北还。\n归路连镳红日晚，多惭龙卧白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙隐岩","author":"朱晞颜","text":"圣主龙飞已在天，洞中犹有老龙眠。\n便须吸尽西江水，霈作商霖大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韶音洞","author":"朱晞颜","text":"曾按薰弦天一方，埽除民愠变清凉。\n遗音凛凛犹闻耳，不独当年味可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石柏","author":"朱晞颜","text":"海物难穷造化奇，后凋惟有岁寒知。\n谁将修月黄金斧，斲就凌云紫玉枝。\n直干岂容尘点涴，灵根偏与石相宜。\n天然不假栽培力，肯逐春风盛与衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题大安壁","author":"朱晞颜","text":"万里同为客，秋悲未易禁。\n萍蓬乡国梦，松竹岁寒心。\n霜叶青红乱，云山紫翠深。\n何时锦屏下，樽酒话尘襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烟波阁","author":"朱晞颜","text":"小立烟波上，江湖兴未忘。\n败梧风舞叶，寒菊露滋香。\n目逐去云断，愁随流水长。\n莼鲈秋正好，飞棹访沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白岳寄怀","author":"朱晞颜","text":"林间留我住多时，似与烟霞夙有期。\n野老烹茶来献客，岩猿偷果去呼儿。\n静思世上千年事，不值山中一局棋。\n欲说行藏舒卷意，洞天惟有白云知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙隐洞石壁玉立□门虚明目□江流□贯其中上□□□□如印泥然亦异矣暇日携家泛舟来游","author":"朱晞颜","text":"翠壁峥嵘百仞雄，玉龙飞下水晶宫。\n禹门激浪纵三级，□□□云仅一弓。\n银阙交辉天不夜，全鳞倒影水浮空。\n卷怀霖雨沈潜久，会有惊雷□岁丰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致爽斋","author":"杨王休","text":"翛然一宅一编书，举世何人得似渠。\n三十六峰峰下路，清溪绿竹绕楼居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凿温岭","author":"杨王休","text":"黄山形势南如窝，四十馀里趋丹河。\n年年七月八月雨，稻田瀰涨漫风波。\n异时都水使者至，东开铁场分水势。\n地绵力短功未成，尺一催归卒吞志。\n旧画茫茫如弃井，百年遗恨如灰冷。\n我来吊古更穷源，并水沿流至温岭。\n岭之首尾少低昂，如衡称物锱铢强。\n外即大海枕平麓，相去往往寻丈长。\n天造地设巧乃尔，胡为弃此而取彼。\n兴废成否抑有时，不独今非古皆是。\n此来经营烦令君，便有异议争云云。\n常情自古惮谋始，岂料疲秦终利秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"计偕中途寄家大人","author":"戴机","text":"戚戚复戚戚，辞亲远行游。\n江湖浩无际，山峦郁相稠。\n浮云奋南征，所历非故丘。\n离禽鲜好音，羁旅多远忧。\n古人一日养，不以三牲酬。\n胡为功名意，盼断倚门眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劝农石头城赋诗","author":"余端礼","text":"去年出郊春欲半，钟阜林峦青未遍。\n今年此日蛰初惊，动地春光满石城。\n柳如蹙金梅碾玉，川原高下麦苗绿。\n一声布谷已催人，吴侬莫问春迟速。\n苍颜老守政无奇，只要我民不苦饥。\n奉诏偕行两赤令，职在劝耕无扰之。\n鲐背厖眉数十叟，听取吾言醉此酒。\n但遣儿郎力南亩，不患三钱无米斗。\n米斗三钱大江东，从今更祝八方同。\n同见三登太平日，老守不愿万户封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浮远堂 其一","author":"丘崇","text":"西来江水浮天远，卧看飞鸿入杳冥。\n云过有山皆点点，潮回无地不青青。\n风光浩荡连淮海，气象高寒近日星。\n醉里不禁频极目，敔峰如黛涕先零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浮远堂 其二","author":"丘崇","text":"已作垂垂雨，相为澹澹阴。\n吾徒一笑粲，造物用功深。\n跬步西山胜，终年梁甫吟。\n年来赏心处，徒得与君临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张孝伯雪窗诗韵","author":"丘崇","text":"洞门阴阴无俗客，楼观清雄使君宅。\n晴窗妙墨灿银钩，要比粉闱冬夏白。\n秀将嵩少只檐间，恍如积霰观商颜。\n蓝田塞关底足异，城阳郡楼那可攀。\n窗中四时同一念，不作寒温颠倒见。\n试看炎蒸定有无，始知此景无迁变。\n都城畏日腾朝光，趑趄奔竞车马行。\n腼面内热者谁子，来此为卿心骨凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其一 精舍","author":"丘崇","text":"我读精舍篇，梦作山中客。\n从公夜不眠，寒灯歌白石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其二 仁智堂","author":"丘崇","text":"静如颜心斋，动若禹行水。\n迷邦谢阳子，谋国付樗里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其三 隐求堂","author":"丘崇","text":"抱膝小窗深，读书空谷响。\n一笑有会心，纷纷自雄长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其四 观善斋","author":"丘崇","text":"言发矢无乡，机深舍争席。\n圣处倘策勋，珍重相与力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其五 寒栖馆","author":"丘崇","text":"风急窗自鸣，霜严酒无力。\n岁律方峥嵘，幽人坐坚壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其六 晚对亭","author":"丘崇","text":"苍山开秋屏，屹立俨无对。\n下有岸帻人，意气压苍翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其七 铁笛亭","author":"丘崇","text":"横笛人何在，山空花自开。\n不妨听晚弄，声与壮心来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其八 钓矶","author":"丘崇","text":"清溪转回环，石矶俯深碧。\n公来坐忘归，此意白云识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其九 茶灶","author":"丘崇","text":"烹茶人外世，遗灶水中央。\n千载公仍至，茶成水亦香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱子武夷杂咏十首 其十 渔艇","author":"丘崇","text":"世路风波恶，扁舟去住轻。\n中流发清唱，千古有遗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"世途","author":"赵公豫","text":"世途若戈矛，达人自宜淑。\n春日玩春桃，秋时赏秋菊。\n閒来与客谈，兴至取书读。\n渴饮溪头水，饥餐瓶中粥。\n即此可忘忧，世人奚碌碌。\n黄农不复生，谁为大化育。\n此身当自珍，毋为世所辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"教授祖守中逢清以秋菊佳咏见贻次韵奉答","author":"赵公豫","text":"重九寓淮阴，尘嚣忘境寂。\n金风遍原野，芳华未销歇。\n结友步林坳，秋容正纷发。\n疏篱隐士居，丛菊堪怡悦。\n淡远异凡葩，清香恋游蝶。\n皎如冰作盘，长才无放逸。\n广文祖先生，鸡群之鹤立。\n挥泪赋新言，群贤皆侍侧。\n一编惠远人，捧诵几晨夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严先生钓台同范茂明浚赋","author":"赵公豫","text":"汉帝中兴握赤符，先生恬澹隐名区。\n羊裘自是林泉物，龙德原非将相徒。\n不学淮阴遭戮辱，岂同尚父预匡扶。\n高踪卓绝横今古，瞻拜桐江感叹俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈元矩昭度纳姬戏赠 其一","author":"赵公豫","text":"半载幽居太寂寥，春风送暖此良宵。\n深情不必旁留恋，好布罗帷笼阿娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈元矩昭度纳姬戏赠 其二","author":"赵公豫","text":"赚得姬人下镜台，锦衾角枕手亲裁。\n鱼鱼水水成佳会，懒向书堂事酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]