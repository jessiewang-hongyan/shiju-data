[{"title":"偈颂一百零三首 其四十七","author":"释月涧","text":"道在屎溺，道在稊稗，道在瓦砾。\n荡荡一条官驿路，何须特地栽荆棘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十八","author":"释月涧","text":"赵州禅在口皮边，云门禅若九转透瓶丹，总是欺胡瞒汉。\n道难即易，道易即难，金乌一吸沧溟乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十九","author":"释月涧","text":"天下名山到因脚，六州之铁难铸错。\n而今老大却惺惺，倒握茶瓢当木杓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十","author":"释月涧","text":"憨弥勒，胡达磨。\n蓦劄相逢，围炉打坐。\n或说当来下生，或说开花结果。\n者匙火箸笑呵呵，总是认橘皮作火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十一","author":"释月涧","text":"难难，虚空捏聚不成团。\n易易，无手牧童穿穴鼻。\n也不难也不易，断头䑦子加篙枻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十二","author":"释月涧","text":"识得一，万事毕，毕竟一作么生识。\n不用天涯海角寻，日用当机明历历。\n诸人若更迟疑，分明为汝指出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十三","author":"释月涧","text":"道无蹊径，饶州东出永平门。\n法无定相，木岁又除壬午历。\n冥运潜舒，玄机尚戢。\n过去已过去，未来犹未来。\n直得天凝地闭，雪老冰枯，蛰户未开，龙无龙句。\n正当此时，诸人性命，落在甚处。\n一声鸣爆竹，天地悉皆春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十四","author":"释月涧","text":"赵州下牒求鸽，直得四棱踏地。\n这僧蔗咬甜头，不觉随他圈缋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十六","author":"释月涧","text":"腊月火烧山，将军度铁关。\n阵云千里远，独奏凯歌还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十七","author":"释月涧","text":"蛟不识剑剑下死，虎不识阱阱中死。\n从上诸老，各设机关，甚于剑阱。\n汝等诸人，闻如不闻，见如不见，方有少分相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十八","author":"释月涧","text":"新年头佛法，镜清道有，智门道无。\n行尽江南江北路，家家门首钉桃符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五十九","author":"释月涧","text":"渔舟一个两个欸乃歌声，杨柳三株四株低垂金线。\n佛祖玄机，十分成现。\n鲁公亭上来来往往，多少衲僧阿谁亲见。\n见沙禽已在浮洲岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十","author":"释月涧","text":"佛病祖病，正在膏肓。\n文殊是药采将来都用不著，杜顺灸猪左膊上亦错商量。\n东湖水点菖蒲茶，个是单传海上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十一","author":"释月涧","text":"有纵迹，没缝罅。\n善财七日寻觅不得，赵州五年分疏不下。\n汝等诸人，那边经冬，者边过夏。\n因甚问著，如聋似哑。\n水银无假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十二","author":"释月涧","text":"天台山万叠，信手轻拨转。\n六种皆震动，玲珑人人面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十三","author":"释月涧","text":"周家有国圣明朝，甘蔗无端产异苗。\n后代儿孙非五逆，百千鸩毒一瓢浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十四","author":"释月涧","text":"太白峰顶云，太湖波心月。\n黑夜散清光，炎洲飞皓雪。\n不是古佛玄机，亦非诸祖妙诀。\n别别，万像森罗惊吐舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十五","author":"释月涧","text":"真正法要，玄极秘密。\n言语道断，心行处灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十六","author":"释月涧","text":"东村王老夜烧钱，掇转须弥作案山。\n途路纷纷未归客，抬眸错认白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十七","author":"释月涧","text":"八十樵翁无赖查，芭鞋踏破乱山霞。\n那知一迹不到处，别有葛洪仙处家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十八","author":"释月涧","text":"大庾岭头，高安滩头。\n下尽手脚，结尽冤雠。\n个事何曾得彻头，祸在源头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六十九","author":"释月涧","text":"大道平平无壅塞，无端特地设深坑。\n衲僧若具丈夫志，解向机先掉臂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十","author":"释月涧","text":"正觉山中夜气清，瞿昙特地不惺惺。\n却将旷劫无明种，认作浮云缺处星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十一","author":"释月涧","text":"黄檗山头三顿棒，集云峰下四藤条。\n行不著，用得乔。\n堪笑大禅佛，小厮儿，错将一滴，认作全潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十二","author":"释月涧","text":"击梧桐，惊老凤。\n戽九渊，缚狞龙。\n同不同，别有灵犀一点通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十三","author":"释月涧","text":"寂历梁峰岁月深，春风浩荡入枯林。\n要开万世无穷业，只在坚持一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十四","author":"释月涧","text":"瞿昙错认者星儿，动地惊天谁阿谁。\n奉劝诸人今夜里，只消熟睡到鸡啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十五","author":"释月涧","text":"雪后园林春正浓，玉容公子玉花骢。\n彫弓闲试黄金弹，打落天边一个鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十六","author":"释月涧","text":"江山处处东风软，桃李纷纷春意酣。\n是灭度耶不灭度，当机识取老瞿昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十七","author":"释月涧","text":"普请摘茶，仰山撼树。\n则川提篮，捡点将来落二三。\n入草一回亲见得，枝枝叶叶是瞿昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十八","author":"释月涧","text":"云门向广寒宫里呈月，圆悟向龙王宫里呈珠。\n荐福虽臂长袖短，亦有一个道处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七十九","author":"释月涧","text":"铁面将军骑铁马，喑呜杀气暗乾坤。\n纵饶勇锐如韩百，千里应须破胆魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十","author":"释月涧","text":"昨日雨，今日雨。\n渔父讴歌，老农欢舞。\n堪笑蒲许林中，邓师伯把不定，却向豆子山前打瓦鼓。\n熟不熟，但看五月廿六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十一","author":"释月涧","text":"谁驾烛龙，赫日当空。\n山河大地通身汗出，草木昆虫无处潜踪。\n昨夜三更，拄杖子蓦然?跳。\n触著帝释鼻孔，雨似盆倾。\n是汝诸人半醒半困，犹在梦中，喜喜欢欢是老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十二","author":"释月涧","text":"将军矍铄笑盈眉，铁马冲关舞战旗。\n指点阵云千万里，碧油幢里醉金卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十三","author":"释月涧","text":"水盈万壑，叶落三秋。\n渔板一声飞野鸭，长空极目思悠悠。\n堪笑当年马大师，无端杻著百丈鼻，直至如今痛不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十四","author":"释月涧","text":"达磨西来，传个策子。\n少至万言，多无一字。\n贱如金璧，贵如泥土。\n第一句为君举，听著即聋，觑著即瞽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十五","author":"释月涧","text":"参得到，悟得彻，自谓龙门上客。\n荐福有棒，亦未到伊吃。\n行百里者半九十。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十六","author":"释月涧","text":"当年竺国此时节，净饭王宫生悉达。\n老倒云门棒头短，千古万古为妖孽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十七","author":"释月涧","text":"总总林林，厥疾弥深。\n文殊既无灵验之药，卢扁难下膏肓之针。\n山僧有个秘传诀，扫除万病是无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十八","author":"释月涧","text":"东湖东湖见，西湖西湖见。\n八月十五夜，皎皎如镜面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八十九","author":"释月涧","text":"衲僧家不著僧求，不著法求，不著佛求。\n绿杨堤上芰荷香里，三三两两数沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十","author":"释月涧","text":"投子欲挂羚羊之角，争奈臭肉来蝇。\n荣禅客猎犬无灵性，徒恋枯桩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十一","author":"释月涧","text":"名不得，状不得，不可得中亲搆得。\n绝瑕翳，明皎洁，大似中秋夜明月。\n别别，广寒宫殿烂银阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十二","author":"释月涧","text":"金莲万朵烂荧□，照彻银霄第几层。\n无量劫来明历历，须知元本是心灯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十三","author":"释月涧","text":"今古事茫茫，阴阳割昏晓。\n碧露缀小桃，绿线垂堤柳。\n燕语雕梁，蛙鸣芳草。\n钟声杂报声，大底大，小底小。\n山僧见了，直得培增慎恼，一片涅柈心，狼藉知多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十四","author":"释月涧","text":"不是而上事，亦非格外机。\n蚯蚓抹过东海，蝍蟟吞却须弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十五","author":"释月涧","text":"波斯手里捻生铁，把作希奇无价珍。\n识破分文元不直，寒光笑衮浪花新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十六","author":"释月涧","text":"鱼行水浊，鸟飞毛落。\n若起一毫佛见法见，尽六州之铁难铸错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十七","author":"释月涧","text":"破砂盆，无贵贱。\n等闲拈向昌江上，尽大地人同一见。\n彷佛宣州木瓜，依稀景镇宝变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十八","author":"释月涧","text":"指临济，见黄檗，陷虎机深。\n接云门，嗣雪峰，送赋过界。\n荐福聻云晴，楚天春欲雨，三草二木皆萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九十九","author":"释月涧","text":"东湖一棹过侯溪，两两相看眼似眉。\n若问陈年闲佛法，杜鹃声在最高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其一○○","author":"释月涧","text":"夺贼鎗兮便杀贼，山河大地血淋漓。\n今朝冷地翻交转，万垒西风铁马嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其一○一","author":"释月涧","text":"凤脱千丝之网，鱼离百搳之钩。\n没拘束，鱼悠悠，明月清风天地秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其一○二","author":"释月涧","text":"厖眉雪顶采樵翁，误入天台第几重。\n回首不知尘世隔，月明知乐响瑶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其一○三","author":"释月涧","text":"地钓东湖二十年，眼头老却几风烟。\n等闲笑捲丝纶去，秋满江山月满天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"普说三转语颂出示众 其一","author":"释月涧","text":"拶到途穷路绝处，灼然命若一丝危。\n当机烧尾奔当火，那个鱼腾碧汉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"普说三转语颂出示众 其二","author":"释月涧","text":"太华峰头有一物，怪如猛虎踞林丘。\n抬眸子细认得著，充畟陈年个石头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"普说三转语颂出示众 其三","author":"释月涧","text":"等闲拈起一机看，顿觉重重海岳昏。\n划尔一声轰霹雳，木人闻后更谁闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂四首 其一","author":"释月涧","text":"瑞岩惺惺，荐福莫莫。\n瞒顸佛性，束之高阁。\n月涧别用的当一著，易觑捕，难执捉。\n无意求时却宛然，有心月处还应错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂四首 其二","author":"释月涧","text":"彩云影里仙人现，手把红罗扇遮面。\n急须著眼看仙人，莫看仙人手中扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂四首 其三","author":"释月涧","text":"一轮明月，两度中秋。\n不知今夜里，谁复再登楼。\n云开万里桂香浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂四首 其四","author":"释月涧","text":"庭前桂绽金粟黄，满地散清香。\n鲁直当年参晦堂，吾无隐乎尔。\n当下错承当，累及丛林，千古更错商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东岩寿仪赞","author":"释月涧","text":"以幻智灯，无幽不烛。\n舌头较善，手头较毒。\n中兴东圆，晚据天育。\n尽东南界内，数来恶业，无这尊宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题丹霞烧木佛图","author":"释月涧","text":"丹霞烧木佛，义出丰年。\n院主眉须堕，彩奔龊家。\n法海浪平春昼永，戏将老手拔鲸牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送钦禅人游岳","author":"释月涧","text":"雪峰不登岳，辛苦事参访。\n虚空开笑口，猿鹤增悲怅。\n我昔乘天风，绝顶倚藤杖。\n群山如子来，万境供一望。\n至今清夜梦，吟啸烟云上。\n道人胆气粗，一叶吞湘浪。\n欲识活祖师，告君语非妄。\n绿苔裹断砖，便是南岳让。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仁侄入浙","author":"释月涧","text":"古来行脚有样子，莫只游山并玩水。\n江南两浙多禅林，带眼直须先带耳。\n数十年来已寂寥，况复乱离生死里。\n一言非理不可道，一武非地不可履。\n善友师教不可舍，庸鄙强饕不可拟。\n彼所非者诚可监，我所长者不可恃。\n一切妄想生死因，参须实参明自己。\n他日归来如所嘱，痛棒依前分付你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彦侍者","author":"释月涧","text":"瑞阳俊彦彦侍者，貌山泽癯语洒洒。\n访我东湖竹边寺，为言来自远公社。\n殷勤载觅赠行语，有语非语笔难写。\n浑崙一句持赠君，不可取兮亦非舍。\n归见溪边老烟菟，当机有掌休便打。\n免教臭口向人开，道汝又捋虎须也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"借雪窦韵送淳维那","author":"释月涧","text":"吴山碧，楚江碧，天地茫茫渺何极。\n出门无是无不是，著眼当机须辨的。\n诸方门户泼天开，真底奚真伪奚伪。\n灯笼露柱尽知识，庭前柏树西来意。\n春风意，春风急。\n千里万里谁能及，湖水蹙天波欲立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送妙达往浙","author":"释月涧","text":"逸汝短句意不尽，送汝长句无可写。\n不长不短赋一篇，适值今朝忙不暇。\n临别草草笑与言，真个参禅忘昼夜。\n一回参到无参处，犹是上宿道傍舍。\n吴越青山千万重，拣个钵囊何处挂。\n娘生两眼蓦然开，方信山僧真可骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送印空书记","author":"释月涧","text":"一印印空来点窄，三贤十圣那可测。\n匡庐万叠云锦乡，鄱湖万顷水精国。\n篆文见得甚分明，元是一字不著画。\n拍来号令人与天，顿教古道长颜色。\n我应隔江，合十声啧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]