[{"title":"捲帘","author":"舒邦佐","text":"隔帘见竹早清幽，卷起疏帘满眼秋。\n一搭夕阳收不得，被人都送上帘钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遗术士","author":"舒邦佐","text":"欲寿莫誇尧丙子，欲贵莫疑雌甲辰。\n学取燕山人姓窦，自然五桂一灵椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"舒邦佐","text":"睡起挼挲两眼眵，卷帘惟见水平池。\n小窗幽寂无人到，自拨炉薰试一旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起二首 其二","author":"舒邦佐","text":"蝶梦惊回思尚迷，起煎蟹眼试新旗。\n桃花贴地杨花起，正是江南二月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起二首 其一","author":"舒邦佐","text":"双双燕语落檐牙，惊破春屏梦到家。\n睡起拈书无意绪，开窗隐几看桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谩题","author":"舒邦佐","text":"世网角雄雌，官途争是非。\n人方酣蚁战，吾自送鸿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慕容簿送题宝峰石刻并中秋词以诗谢之 其一","author":"舒邦佐","text":"步屧寻僧到日西，乱山深处见新碑。\n却惊天上披风手，亦卷波澜入小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慕容簿送题宝峰石刻并中秋词以诗谢之 其二","author":"舒邦佐","text":"月入中秋色满林，摹将好景寄清音。\n自从句夺天工巧，景物无聊直至今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题三石屏 其一","author":"舒邦佐","text":"烟雾冥濛雨意垂，远山隐隐抹修眉。\n急催行李投前店，似我当年在道时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠太素脉王道人为端夫病起解嘲","author":"舒邦佐","text":"按指如医细切肤，对人便肯说荣枯。\n我今跳出荣枯外，试问先生脉得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戴氏楼名折桂来觅诗赋二十八字","author":"舒邦佐","text":"秋入高楼风露凉，疑从月里送清香。\n五枝高折非难事，问取燕山窦十郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁巳正月五日","author":"舒邦佐","text":"春滞犹为腊，年移已换正。\n节从忙里过，愁向病边生。\n小雨止还作，虚窗暗又明。\n时光与心事，无一可娱情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨望晴十月六日夜雷雨大作","author":"舒邦佐","text":"十月天犹暖，浑如二月晴。\n雷声兼雨势，春令已冬行。\n稻穟多生耳，田家有叹声。\n官仓须玉粒，早为挂铜钲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"于尉灯夜招饮酒酣援笔成诗继韵","author":"舒邦佐","text":"低唱虽无金步莲，公来处处已闻弦。\n满街灯火作元夕，此段风光胜去年。\n纸上飞云惊落笔，盘中走弹喜诗圆。\n便宜归侍传柑宴，满泛钱塘药玉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"于尉惠诗有流落之叹次韵招饮","author":"舒邦佐","text":"一纸西风书客愁，愁来如泻满汀洲。\n从他梦鹿还争鹿，休问封侯与不侯。\n百岁光阴草头露，一年好景菊花秋。\n人生能著几緉屐，且为重阳一醉不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小巷","author":"舒邦佐","text":"萧条一径微，来往觉人稀。\n忽听邻家闹，欢寻稚子归。\n卷书真是懒，添火且相依。\n强起扶行处，斜阳正满扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小院","author":"舒邦佐","text":"小院无人到，徐徐影转花。\n池平初斗蛤，柳老半藏鸦。\n矛戟犹封笋，枪旗欲试茶。\n一丘并一壑，只此是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏枕","author":"舒邦佐","text":"索索叶多雨，梦惊窗月明。\n一念堕世网，百虑战心兵。\n天上麒麟阁，沙边鸥鹭盟。\n展转复展转，孤鸿三两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪秀野之景","author":"舒邦佐","text":"秀野吾曾到，名新景亦嘉。\n雨移新到竹，晴接旧来花。\n矗矗山围立，团团树绕家。\n病中心漫往，无计聚抟沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏二首 其二","author":"舒邦佐","text":"卢橘金珠似，杨梅火齐如。\n燕衔春去后，蝉噪夏阴初。\n药访三年艾，心凝一束书。\n老身仍著病，节物最关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏二首 其一","author":"舒邦佐","text":"稍久梅黄雨，新晴麦熟天。\n寸怀煎百虑，一病费三年。\n方册强遮眼，短窗时送眠。\n三生偿业尽，四体合安便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张推上巳出郊寻花送至诗轴次韵","author":"舒邦佐","text":"重三投晓出郊坰，跃马归来趁晚晴。\n笔卷云烟归赋咏，轴联珠玉斗晶明。\n我从多病三春里，转觉浮生万事轻。\n夜半惟歌盘谷序，肯如仲叔请繁缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张推水亭赏莲惠诗次韵","author":"舒邦佐","text":"玉环妖血不飞天，化作芙蕖满眼前。\n恰有六郎来比似，便哦七字斗清妍。\n晓妆洗露汉宫女，晚步凌波水府仙。\n得待蜜房成玉蛹，送烦纤手剥新莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和许宰于尉间字韵诗后一首送其子赴太学 其二","author":"舒邦佐","text":"籋云追电笑谈间，争看骅骝出帝闲。\n暂借短檠赊眼力，莫因远别梦眉山。\n诗闻庭下频趋鲤，易在床头久铸颜。\n趁取双亲皆未老，绿衣归换綵衣斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和许宰于尉间字韵诗后一首送其子赴太学 其一","author":"舒邦佐","text":"连珠叠璧照窗间，得句须知出等閒。\n有似弟兄花萼集，更如大小淮南山。\n言诗自愧知来赐，闻十如何敢望颜。\n一夜不眠追险韵，起来疏发有诗斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和林帅喜汤王二魁将还","author":"舒邦佐","text":"烂醉春风玉不颓，自封喜信入湘来。\n同乡多少同年士，两榜何如两夺魁。\n琼苑宴开应共醉，西湖赏罢更同回。\n早归多谢文翁力，莫待平安家信催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春半即事","author":"舒邦佐","text":"春来晴景少，昼夜已平分。\n寒锁花藏莟，风微水皱纹。\n端成空识字，谁可共论文。\n惟有铜炉在，时拈柏子焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春暮","author":"舒邦佐","text":"日月一箭过，春光又别人。\n竹孙才解箨，梅子已生仁。\n阅世真旋磨，看诗老斲轮。\n壮怀因病落，孤负百年身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残腊书怀","author":"舒邦佐","text":"冰池照日暖初融，准拟迎春更饯冬。\n杯酒乍疏情少绪，尺缄稽报病多慵。\n残年断送风和雪，晚节相依竹与松。\n回首思量十年事，倦投孤枕听鸣钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送冯勉仲赴省","author":"舒邦佐","text":"客饯旗亭酒半酣，抟风九万送鹏南。\n薄劳汗马功收一，肯怨长途玉献三。\n去去梅花催驿骑，看看柳色斗恩蓝。\n长篇好上刘蕡策，莫作书生无用谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送致远赴耒阳酒官","author":"舒邦佐","text":"云冻长空昼亦昏，谁欤剥啄扣柴门。\n故人言向潇湘去，此别应须岁月论。\n衡岳五峰瞻胜槩，耒江千载吊诗魂。\n旧游倘有人相问，为说扶犁教子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南潘帅赴召","author":"舒邦佐","text":"道传伊洛政龚黄，肯为人间富贵忙。\n爱满棠阴踰五岭，种成荔子又三湘。\n贪贤急召恩虽渥，因病求閒策本长。\n闻说晦翁天下士，更将出处细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送履正赴省","author":"舒邦佐","text":"万里云衢著脚初，临行尚肯过吾庐。\n风云得助子方快，冰玉相依我不如。\n驿路响铃看报捷，殿门放钥待传胪。\n逾科又见龙飞榜，此度传衣应不虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻野有饥殍感叹","author":"舒邦佐","text":"豌豆斩新绿，樱桃烂熟红。\n一年春色过，大半雨声中。\n仆野伤饥殍，祈天愿岁丰。\n有谁捐白粲，相伴减青铜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽左相京太师四首 其四","author":"舒邦佐","text":"自际朱弦赏，逢人说项斯。\n蜚章先剡上，荐墨更交驰。\n遽卧漳滨疾，如轰荐福碑。\n空流一襟泪，无路送灵輀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽左相京太师四首 其三","author":"舒邦佐","text":"尧考闻忧日，公身病瘁时。\n哀情知痛极，疾势转增危。\n梁坏将安放，天胡不慭遗。\n此为天下恸，未敢哭其私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽左相京太师四首 其二","author":"舒邦佐","text":"圣代多名相，谁如德量宽。\n平心消党与，著力援孤寒。\n礼极三宫养，天开二圣欢。\n尽忠扶孝治，烽火自平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽左相京太师四首 其一","author":"舒邦佐","text":"皇华方北返，植纛指西风。\n蜀谓今清献，戎言昔富公。\n民夷两心服，勋业百年同。\n赠与齐温国，功高报亦隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽余倅二首 其二","author":"舒邦佐","text":"仕接湖南北，逢人问起居。\n蚤曾师砚席，非但托乡闾。\n梦里诗春草，毫端赋子虚。\n诸郎图不朽，当共葺遗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽余倅二首 其一","author":"舒邦佐","text":"自踏功名地，斯心每淡如。\n东南虽数任，来往祇单车。\n上相逢知己，清时草辟书。\n才宽天命窄，轓左换灵舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中口占","author":"舒邦佐","text":"拂枕投床鼻息鸣，邻鸡报午梦还惊。\n一春已过半春了，十日曾无五日晴。\n唤客难同藉草饮，隔墙虚认卖花声。\n十年前忆西湖上，柳荫苏堤取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚出","author":"舒邦佐","text":"晚径收霜滑，青鞋踏浅沙。\n看云閒活计，临水淡生涯。\n篱菊犹存叶，江梅欲破花。\n枫林凋落尽，露出两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"舒邦佐","text":"晚来颇忆林塘幽，又拄乌藤款款游。\n细雨斜风三日后，落花啼鸟半春休。\n不知何处数声笛，唤起幽人一点愁。\n赖有青蛙知客恨，笙歌一部起池头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"舒邦佐","text":"千林气脉未全归，一点清香已著枝。\n每爱月窗横瘦影，敢将水墨污冰姿。\n淡妆出屋新相见，索笑巡檐旧有诗。\n不见化工先著力，雪中风韵最相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦觉","author":"舒邦佐","text":"梦觉还寻梦，胚胎一想中。\n失身邯郸枕，得意大槐宫。\n周在蝶何在，蕉空鹿亦空。\n自怜心未静，起坐究幡风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐几","author":"舒邦佐","text":"隐几香一炷，时于静里求。\n心源须得得，世路任悠悠。\n佛国菩提树，庄园不系舟。\n忘机吾自信，何必验沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雪二首 其二","author":"舒邦佐","text":"未问街头酒价添，迎光先捲读书帘。\n送寒作片频窥户，著暖先融半溜檐。\n莫作桧花添项强，且随梅点闹眉尖。\n叮咛勿压南枝折，商鼎调羹待作盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雪二首 其一","author":"舒邦佐","text":"光入疏棂晓色添，开门犹认蝶飞帘。\n千山陡失青丝障，万户横拖白玉檐。\n压竹重时疑绿折，著花轻处露红尖。\n自惭对景无佳句，空笑当时絮与盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲燕子","author":"舒邦佐","text":"去岁相过日，朱帘正上钩。\n双双如旧识，一一话离愁。\n留为荷花夏，归因梧叶秋。\n今年头转白，还识主人不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"于尉以书室新成惠诗次韵","author":"舒邦佐","text":"无数云山簇眼前，又听风叶响琤然。\n近于此处开三径，准拟归来受一廛。\n终日看山忘坐卧，有时扃户锁风烟。\n寻花问柳如乘兴，且莫轻回访戴船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以鲁直露湿何郎试汤饼为韵赋酴醾七首 其七","author":"舒邦佐","text":"爱花莫看花，如饥贪画饼。\n一笑大江横，此句须参请。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以鲁直露湿何郎试汤饼为韵赋酴醾七首 其六","author":"舒邦佐","text":"昨日落酒杯，引我卧醉乡。\n对午犹未醒，支颐听煮汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以鲁直露湿何郎试汤饼为韵赋酴醾七首 其五","author":"舒邦佐","text":"何面与荀香，美丈夫可试。\n不学海棠花，只如妃子睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以鲁直露湿何郎试汤饼为韵赋酴醾七首 其四","author":"舒邦佐","text":"倚窗春睡觉，折玉满手香。\n篸云疑未稳，指点问檀郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以鲁直露湿何郎试汤饼为韵赋酴醾七首 其三","author":"舒邦佐","text":"金沙与同架，并蒂更连柯。\n红白虽相宜，品藻当如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天寒偶成","author":"舒邦佐","text":"云冻长空铺水墨，风鸣破屋响琅玕。\n忆梅探梅春已露，欲雪不雪天正寒。\n呵笔岂能诗句好，拥炉偏怕酒瓶乾。\n太平宰相非吾望，煨芋何须问懒残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仿古","author":"舒邦佐","text":"雪花点破潘郎鬓，始得荷衣上钓蓑。\n蚕经一眠再眠后，船历顺风逆风多。\n云烟过眼竟何有，星斗在天终不磨。\n著鞭古人乃吾事，长檠莫换短檠歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自叹二首 其一","author":"舒邦佐","text":"莫莫更莫莫，休休复休休。\n平生都是错，一病尽堪羞。\n龟为灵钻壳，膏因明出油。\n细思根本悴，端的是招忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至后有感","author":"舒邦佐","text":"穷冬万木脱，风叶无停计。\n老树露槎牙，四旁谁拥蔽。\n泛视林莽间，一一献憔悴。\n昨夜新阳复，根荄抱生意。\n天将九转丹，一粒回元气。\n三阳即为泰，原野争明媚。\n老树亦逢春，绿阴看垂地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余本不能棋因病又止酒","author":"舒邦佐","text":"围棋赌别墅，斗酒博凉州。\n驱之夺名利，谁信可销愁。\n不如陶靖节，客至空持瓯。\n不如苏东坡，胜败两忘忧。\n此心无外累，云净一天秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王令尹游园之作","author":"舒邦佐","text":"官事何时了，偷忙得饷閒。\n清风寒食里，飞絮落花间。\n灵运池生草，渊明鞠见山。\n诗来令细读，玉佩响珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和洪龟父岁暮韵","author":"舒邦佐","text":"两鬓点秋霜，黑白交相互。\n倒指数行年，如日斜岁暮。\n始污千佛经，颇叹儒冠误。\n夜声喧爆竹，晓炬惊鸦树。\n又是一年新，三百六十度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和懒窝严上人纸被诗","author":"舒邦佐","text":"身清不受人间辱，只倩溪翁捣冰縠。\n素涛照眼绝针痕，暖玉遮头无脸粟。\n参寥已似絮沾泥，天女虽来暖非肉。\n华鲸吼吼不成眠，蝴蝶蘧蘧犹未足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后","author":"舒邦佐","text":"积雨洗残暑，翛然窗户凉。\n蝇蚊不须驱，时至自退藏。\n琤然一叶下，梧桐陨秋黄。\n仰视天宇阔，宾鸿初南翔。\n儿时亲灯火，二尺便宜光。\n咀嚼复吟哦，惟恐更漏忙。\n老来病如缚，空对书满箱。\n短檠置床头，犹渴不能浆。\n人生舍此乐，百年谩风狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后书怀","author":"舒邦佐","text":"策策西风两鬓秋，瘦藤独倚思悠悠。\n送凉小雨勾牵睡，泼面新醅断送愁。\n涉世已经三折臂，浮生空白一分头。\n流行坎止随天意，且著烟蓑上钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后即事","author":"舒邦佐","text":"昨日雨不歇，薄晚云未收。\n更阑望天宇，云净月如钩。\n晓开读书窗，日光泼双眸。\n蔬饭羹一盂，起傍吾庐游。\n一洗尘土昏，水竹清更幽。\n问花无恙否，低面含娇羞。\n验笋长几何，突角凌羊牛。\n前日移新荷，常恐水盖头。\n池边报平安，小叶三四浮。\n竹林叫钩辀，柳阴鸣栗留。\n趁晴欲双飞，更著唤妇鸠。\n物适吾亦适，投筇思悠悠。\n却归堂上坐，苍头献茶瓯。\n儿声清且美，读书如泻油。\n静里无声乐，閒中不系舟。\n不知腰金公，曾识此乐不。\n我生微官缚，有如冠沐猴。\n长恐舍此去，永愧池上鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]