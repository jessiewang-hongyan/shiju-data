[{"title":"拟寒山寺 其七十一","author":"释怀深","text":"老翁死却儿，昼夜搥胸哭。\n痛心彻骨髓，叫云我孤独。\n何不返思量，恣啖猪羊肉。\n羊岂不思儿，猪亦有眷属。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十二","author":"释怀深","text":"恶人骂善人，善人总不对。\n善人若还骂，彼此一智慧。\n不对心清凉，骂者口热沸。\n正如人唾天，迁从己身坠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十三","author":"释怀深","text":"莫忧家未富，家富鬼神恶。\n莫忧官未穹，官穹朝市妒。\n多求灾祸根，知足安乐处。\n君看权势家，昼夜如骑虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十四","author":"释怀深","text":"一日日知衰，一年年觉老。\n唯有贪爱心，顽然如壮少。\n临行念子孙，垂死顾财宝。\n世间此等人，可哀不可吊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十五","author":"释怀深","text":"众生方寸间，贪量如海阔。\n保持一个身，拟作千年活。\n金玉已满堂，更欲相攘夺。\n至死少一官，令人冷笑发。\n小人妒君子，百计求全毁。\n自己丑恶声，不知满人耳。\n譬如蜣螂虫，辊臭为香美。\n却笑鸾与凤，不与己为类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十六","author":"释怀深","text":"人身如假借，其势岂能久。\n镜中儿时面，转眄成老丑。\n安得闲日月，与人斗棋酒。\n不能求放心，处处随物走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十七","author":"释怀深","text":"人身有一疾，呻吟彻眠梦。\n买药与呼医，告佛仍设供。\n诸佛虽不语，悯汝颠倒重。\n杀羊食其心，何不念他痛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十八","author":"释怀深","text":"世人无慈悲，恣情为杀害。\n吃肉如大虫，唯誇牙齿快。\n不念众生苦，畅我个皮袋。\n皮袋暂时肥，须臾却败坏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十九","author":"释怀深","text":"世事多不平，平者唯有死。\n死若更不平，贫汉何时已。\n朱楼高插云，金带光照地。\n无常一日来，阎王谁管你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十","author":"释怀深","text":"若以诤止诤，其诤转不已。\n唯忍能止诤，是法中尊贵。\n不见老瞿昙，妙相三十二。\n魔军刀剑来，只以无心对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十一","author":"释怀深","text":"富甚足忧烦，贫甚多饥饿。\n要于贫富间，知足随缘过。\n人生不知足，贪财是贪祸。\n黑暗功德天，寻常一处坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十二","author":"释怀深","text":"嗔火焚和气，令人相貌恶。\n修罗才现前，菩萨都走却。\n养就三毒躯，恣为五欲乐。\n智者善思惟，早服慈悲药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十三","author":"释怀深","text":"心王不自明，便被六贼扰。\n见色已昏迷，闻香即颠倒。\n功德与法财，尽底遭劫了。\n只因无慧力，贫穷三恶道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十四","author":"释怀深","text":"世人皮底黠，肚里没头痴。\n只取眼前乐，不忧身后非。\n眼前乐不久，身后苦多时。\n愿君早为计，后悔恐难追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十五","author":"释怀深","text":"求名趋于朝，求利入于市。\n古今朝市间，相争如鼎沸。\n不如归山林，揩磨自心地。\n心地若分明，名利如唾涕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十六","author":"释怀深","text":"人身苟无业，生死何足疑。\n生也不须恋，一亦不须悲。\n一身真逆旅，万事皆儿嬉。\n请来绿岩畔，与君歌紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十七","author":"释怀深","text":"因果如影响，毫发无差错。\n啖炙僧肠穿，指熊樵臂落。\n兽面心有仁，人面心有恶。\n天地终不容，立见身消烁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十八","author":"释怀深","text":"静看营巢燕，衔泥日千转。\n一栖贫家梁，一宿王者殿。\n寄托暂时间，何暇分贵贱。\n人生达此理，没齿无欣怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八十九","author":"释怀深","text":"贵人何所忧，所忧唯是老。\n既老何所忧，忧见无常到。\n逢人问方术，闭门弄丹灶。\n此心若不歇，至死亦颠倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十","author":"释怀深","text":"可畏是轮回，念念无停住。\n才见出头来，又见翻然去。\n换面与改头，为男或作女。\n不识主人翁，来去多辛苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十一","author":"释怀深","text":"蚕忙贪作茧，蜂忙贪候蜜。\n茧成自己寒，蜜就别人食。\n世上忧家翁，辛苦无暂息。\n也似二虫痴，于身无所得。\n三四小孩儿，争拈百草嬉。\n怀中有梨栗，衣上污尘泥。\n也似年高者，贪迷声色时。\n世间无老少，总是一般痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十二","author":"释怀深","text":"贪嗔汝镬汤，愚痴汝地狱。\n剑树及刀山，汝心皆具足。\n要以智慧水，洗此无明毒。\n凡圣路无多，正如手翻覆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十三","author":"释怀深","text":"譬如临明镜，面目各相对。\n好者默自欣，丑者默自愧。\n唯镜两无情，光明常一体。\n若人心似镜，成佛在弹指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十四","author":"释怀深","text":"厚葬非孝心，死者必遭辱。\n君看离乱时，何墓不伐斸。\n黄金众贼分，白日孤鬼哭。\n最爱老庄周，天地为棺木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十五","author":"释怀深","text":"屋可蔽风雨，何苦斗华丽。\n尧舜乃圣君，光宅天下被。\n茅茨未尝剪，土阶亦不砌。\n不知尔何人，鳞鳞居大第。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十六","author":"释怀深","text":"出家要省缘，省缘易入道。\n如何无事人，搂揽闲烦恼。\n奔走富贵门，庄严房舍好。\n不知被物使，区区真到老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十七","author":"释怀深","text":"伤嗟富贵家，杀害无虚日。\n食羊割奶膀，烙鳖呼卒律。\n物有千般痛，汝无一念恤。\n福力忽然终，黄连犹是蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十八","author":"释怀深","text":"浮生七十岁，二万五千日。\n睡眠与疾病，光阴强半失。\n火急便回头，寸阴诚可惜。\n嗟吁世人人，班白犹放逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九十九","author":"释怀深","text":"世上贪饕汉，因财日夜煎。\n天公借与汝，看守七十年。\n譬如良田谷，春种秋方圆。\n不见张车子，生来便有钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○○","author":"释怀深","text":"有福莫享尽，福尽身贫穷。\n有势莫使尽，势尽冤相逢。\n福兮常自惜，势兮常自恭。\n人生骄与侈，有始多无终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○一","author":"释怀深","text":"自料七十岁，可期不可期。\n况今五六十，形骸日渐衰。\n正如春暮后，青多红少时。\n去住呼吸间，佛言真不欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○二","author":"释怀深","text":"我者被人骂，佯聋不分说。\n譬如火烧空，不救自然灭。\n嗔火亦如是，有物遭他爇。\n我心等虚空，听你翻唇舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○三","author":"释怀深","text":"四大是假合，何况四大外。\n假者是色身，外者是财贿。\n可怜世上人，说与终不会。\n相争一文钱，费却多少气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○四","author":"释怀深","text":"人生被爱使，奔走如奴仆。\n爱官被官牵，爱财被财畜。\n昼夜不曾闲，身心一暂足。\n佛云恩爱奴，斯言真可录。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○五","author":"释怀深","text":"世人多放逸，极力事侈靡。\n乐极悲哀来，福尽贫穷至。\n天福尚有尽，世福岂一已。\n人多议论乖，享得是我底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○六","author":"释怀深","text":"世人贪积财，受尽种种苦。\n求时多辛勤，守时足忧怖。\n散时哭不休，死时恋不去。\n轮回六趣中，只因为物误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○七","author":"释怀深","text":"有恩念念报，报则合天道。\n有冤念念解，解则无烦恼。\n一身类浮云，百年同过鸟。\n若以冤报冤，万劫无由了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○八","author":"释怀深","text":"名汤并利火，古今烧杀人。\n只贪炙手热，应笑甑生尘。\n虎口都忘险，龙鳞不怕嗔。\n利名心未足，衰老已及身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一○九","author":"释怀深","text":"可怜一等人，不善又不恶。\n一边说参禅，一边取娱乐。\n贵得生死间，都不受寂寞。\n此云痴种子，要觅扬州鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一○","author":"释怀深","text":"人如食檗虫，通身总是苦。\n吃苦尚不休，抵死钻头做。\n古人知此味，念念求退步。\n乐道山林间，荣枯谁管汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一一","author":"释怀深","text":"有求皆是苦，众生须要求。\n因名忘性命，为利起戈矛。\n不足无时足，知休真下休。\n死生呼吸至，无人替汝愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一二","author":"释怀深","text":"世上聪明公，痴心自蔽蒙。\n步步常行有，口口只说空。\n既空无嗜欲，既空无穷通。\n因何临财色，身心如转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一三","author":"释怀深","text":"众生黠是痴，积恶望无过。\n譬如颠倒人，寻觅无热火。\n火则决定热，恶则必招祸。\n劝君慎所积，有花终结果。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一四","author":"释怀深","text":"一念染心生，撞入胞胎去。\n父精与母血，妄认为住处。\n种子既不净，臭气相薰污。\n业风吹出来，万苦从头做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一五","author":"释怀深","text":"出家要清闲，却被人使唤。\n门徒数百家，追陪日忙乱。\n施利得十千，人情费七贯。\n彼此没便宜，他年难打算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一六","author":"释怀深","text":"更有一般僧，因果殊不顾。\n心里似屠沽，口中呵佛祖。\n心口不相应，佛祖岂容侮。\n投子与赵州，肯踏名利路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一七","author":"释怀深","text":"池中一土墩，鱼日绕墩转。\n人观咫尺间，鱼谓千里远。\n正如躁进人，分寸变眉面。\n要在张三前，还落李四便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一八","author":"释怀深","text":"劝君莫嗜酒，嗜酒多过咎。\n不唯损汝福，亦乃夭汝寿。\n独饮醉一夫，共饭饱十口。\n人生福几何，饥贫恐在后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一一九","author":"释怀深","text":"世间一等汉，做尽百家冤。\n锥刀急利禄，尺寸竞田园。\n世上若无死，尘中应更喧。\n劝君衣带上，分明书此言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二○","author":"释怀深","text":"僧家乃野人，何苦事迎迓。\n佛法变人情，真实成虚假。\n不见老赵州，禅床犹懒下。\n但愿大王知，谁管都衙骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二一","author":"释怀深","text":"区区求富贵，求得一何用。\n前遮并后拥，假合成戏弄。\n正如梦南柯，妄认位貌重。\n忽然睡眼醒，始笑乾培奉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二二","author":"释怀深","text":"劝汝谛观身，此身真可恶。\n上下九个孔，臭秽常流注。\n内外四条蛇，轻躁不停住。\n智者善思惟，莫被皮囊误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二三","author":"释怀深","text":"女色多瞒人，人惑总不见。\n龙麝暗薰衣，脂粉厚涂面。\n人呼为牡丹，佛说是花箭。\n射人入骨髓，死而不知怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二四","author":"释怀深","text":"人生如下棋，机巧未尝已。\n劫劫只图生，忙忙惟怕死。\n路头既错了，心眼亦虚弃。\n不荐这一着，对面若千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二五","author":"释怀深","text":"白日闹喧喧，夜间静悄悄。\n夜间与白日，且道谁欠少。\n饥时觅饭噇，困便寻床倒。\n不省这个意，区区直到老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二六","author":"释怀深","text":"往事莫追寻，未来莫希望。\n见在休执着，自然心坦荡。\n有心终不堪，无念以为上。\n君看太虚空，何尝有遮障。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二七","author":"释怀深","text":"莫嫌门户少，转富转心劳。\n夜怕奸偷至，时防风火烧。\n名高招谤重，财积致谗饶。\n外物多为累，令人思许巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二八","author":"释怀深","text":"麝为香而死，龟以灵故焦。\n既为世所用，忧患无门逃。\n名高谤之本，财聚祸之苗。\n三怨粗能免，世无孙叔敖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一二九","author":"释怀深","text":"日暮片云愁，边廷战未休。\n万人齐拚命，一将独封侯。\n孙武子兵法，田将军火牛。\n算来成底事，总是百冤头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三○","author":"释怀深","text":"合嗔不须嗔，合喜不须喜。\n喜时风自吹，嗔时火自炽。\n风火非外来，皆从自心起。\n不见四禅天，三灾都不至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三一","author":"释怀深","text":"不栽一株桑，不种一粒粟。\n口体每轻肥，仓库常满足。\n蓬门漏不蔽，你居大华屋。\n常怀知愧心，少恣无明欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三二","author":"释怀深","text":"一鼠变蝙蝠，群鼠相庆贺。\n飞鸣觉身轻，自喜脱猫祸。\n日中不见物，夜里长忍饿。\n不如做鼠时，窟里饱眠卧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三三","author":"释怀深","text":"贫穷难作福，富贵易造罪。\n有力无道心，有心无财贿。\n有福有道心，百中无一二。\n不见老瞿昙，福慧二严美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三四","author":"释怀深","text":"佛为大医王，留经治众病。\n众生虽读经，展转不相应。\n病是贪嗔痴，扫除爱净尽。\n贪嗔痴不除，无缘了真性。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三五","author":"释怀深","text":"贪夫如扑满，不虑满时祸。\n未盈犹可存，已满终归破。\n君看石齐奴，不义蓄财货。\n吃剑为绿珠，至死不知过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三六","author":"释怀深","text":"奸汉瞒淳汉，淳汉总不知。\n奸汉作驴子，却被淳汉骑。\n当时誇好手，今日落便宜。\n图他些子利，披却畜生皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三七","author":"释怀深","text":"君看转轮王，七宝光中坐。\n一朝福力尽，头上花冠破。\n正如箭射空，势尽还退堕。\n升沉无数劫，只因迷者个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三八","author":"释怀深","text":"不必扬人恶，切忌伐己善。\n行人口似碑，好丑悉皆见。\n禄厚恐祸生，言深虑交浅。\n不如省事休，彼此无欣怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其一三九","author":"释怀深","text":"君看草头露，日出还消去。\n也似世间人，阎浮暂时住。\n愚人尚不知，纷争求贵富。\n只应明眼人，未能笑得汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]