[{"title":"挽庄懿皇太后词 其一","author":"胡宿","text":"仙李含芳远，菖华席庆殊。\n伣天周作合，梦日汉为符。\n宫祲生长信，山光卜鲋鰅。\n宝台泉底路，千古凝金凫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽庄懿皇太后词 其二","author":"胡宿","text":"悯册追荣极，攒宫改卜良。\n玉衣秋自冷，银海夜偏长。\n浪隔三山药，香空九子堂。\n云陵西望远，嵩树郁苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝词 其一","author":"胡宿","text":"上主乘炎历，真人握宝符。\n垂衣临太极，脱屣厌中区。\n议上尊仁号，传归大圣图。\n陵宫葬冠剑，万国共号呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝词 其二","author":"胡宿","text":"帝者因山葬，天王下度悲。\n寿原三圣接，神驾万灵驰。\n怨入笳箫曲，威陈剑舄仪。\n空留人马迹，不复到瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝词 其三","author":"胡宿","text":"七月朝同轨，千龄讫此辰。\n霜华清禁仗，云气护灵輴。\n凤篆惊遗札，龙颜感旧真。\n更思群玉宴，血泪洒孤臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝词 其四","author":"胡宿","text":"渊默无为化，聪文上睿才。\n休兵藏武库，跻俗集春台。\n忽叹祇宫没，真成杞国哀。\n徒传方士说，奇药在蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁宗皇帝词 其五","author":"胡宿","text":"曾是陪华幄，居常奉景舆。\n迩英参访道，阿阁待观书。\n圣学知风自，神毫拂雾馀。\n那知柏梁宴，便到哭宫车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽英宗皇帝词 其一","author":"胡宿","text":"神器传归重，时龙来久乘。\n告成遗玉检，请代爽金縢。\n同轨遵周制，因山卜汉陵。\n临朝常愿治，天意邈难凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽英宗皇帝词 其二","author":"胡宿","text":"顺斗临天下，乘云厌世间。\n异香消甲帐，奇药隔仙山。\n神策良难问，訾黄不可攀。\n西流终古恨，伊洛共潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽温成皇后词 其一","author":"胡宿","text":"彤管留遗范，霓旌逼上仙。\n地伤瑶水后，人哭乐池边。\n采翟行将驾，斑龙局未前。\n真軿不可问，知在几重天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽温成皇后词 其二","author":"胡宿","text":"氛祲生层掖，神华返上清。\n礼成金玺重，仙去玉衣轻。\n楚挽悲芳甸，凝笳怨碧城。\n宸心怀辅佐，仪典极哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽庄惠皇太后词 其一","author":"胡宿","text":"早护珠庭质，曾参玉几遗。\n宝琮荣册号，华榜盛宫仪。\n天上霓轩去，人间黼帐移。\n圣情同舜慕，寒日惨云旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽庄惠皇太后词 其二","author":"胡宿","text":"晓引禁城西，凝笳怨不归。\n月消三让魄，劫尽六铢衣。\n巩树寒无色，嵩云惨欲霏。\n濯龙门外路，车马更依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄会稽张待制","author":"胡宿","text":"长安厩吏跃花骢，竹马遥分浙水东。\n远势早推贤相子，任诚真有古人风。\n稽山一镇居封内，阿阁三休耸禁中。\n不及临沧陪置酒，忆君千里寄书筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与周元明游南园","author":"胡宿","text":"一遍芳菲欲满林，回塘过雨晓来深。\n红妆珠佩交花影，白马春衫度柳阴。\n向老追攀多强意，随时风物但惊心。\n眼前百事输年少，犹解因君放浪吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀峰寺","author":"胡宿","text":"宿枕依乡馆，天机斗觉清。\n一闻山鸟语，瞥起野麋情。\n峭木摇霜气，疏泉曳玉声。\n简书催俗驾，窗日两竿明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄苏台知府蒋密学","author":"胡宿","text":"清德临藩第二回，东南时望滞盐梅。\n武林间岁移星座，温树多年直斗魁。\n楚客江山供逸思，吴王风月属高才。\n空传宴寝凝香句，文酒无因得仰陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子美学士","author":"胡宿","text":"皋桥羁旅有梁鸿，洛下嘤嘤信未通。\n金谷轻为年少客，沧浪翻作主人翁。\n山川胜气生吟次，风月高情寄饮中。\n身外不须论得丧，傥来轩冕古今同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送太守晏大夫","author":"胡宿","text":"画角城头向晚悲，邓侯归旆已临歧。\n西郊祖帐倾簪绂，南国离声动管丝。\n千里去思歌邵父，三年遗爱泣吴儿。\n甘棠寂寞江边路，正是清阴蔽芾时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田舍","author":"胡宿","text":"农家秋物成，腰镰刈新谷。\n得食鸡豚肥，饱霜梨栗熟。\n牧童唱田歌，孺子宰社肉。\n野老醉亦讴，爱此羲皇俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感怀","author":"胡宿","text":"高秋感憀慄，中夜起盘桓。\n啼螀思月底，哀鸿查云端。\n遗蜩尚号节，初鵙早催寒。\n新霜沾客鬓，凄风入人肝。\n拂枕了无寐，取琴不能弹。\n壮图成龃龉，老泪空汍澜。\n逢辰今匪易，行志古良难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张公洞","author":"胡宿","text":"一室是仙乡，深岩石燕翔。\n隔云青瑟转，拂水紫芝香。\n滴露惊神冷，灵襟彻顶凉。\n浮云应不远，衣袂好相将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬杭州知府蒋密学以移漕见赠之什","author":"胡宿","text":"雕章传赠至苏台，盥手焚香日几回。\n玉札已叨三锡命，瑶华兼枉二南才。\n清明花卉迎前发，紫翠湖山满望来。\n曾是绛纱为弟子，故时经帙许重陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览海东相公伊川集","author":"胡宿","text":"将相文章主籥臣，风流曾冠玉堂人。\n梦回方丈停批凤，句就伊川止获麟。\n洛下胜游空绿野，郢中高调绝阳春。\n犹欣正始遗音在，三复能还旧观神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"胡宿","text":"风花飞有态，烟絮坠无痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"胡宿","text":"点笔乍惊蟾滴渍，□□□□□浆寒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"胡宿","text":"金掌气寒知露重，玉壶声近觉天低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"胡宿","text":"雨别荆台梦，风回越水樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"胡宿","text":"青女偷飞一夜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"胡宿","text":"武林天下奇，巽亭境中绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"王琪","text":"烟径掠花飞远远，晓窗惊梦语匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十","author":"王琪","text":"蚕寒冰茧瘦，蜂老露房攲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"孙沔","text":"新治甬上居，闲逸安暮齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"李柬之","text":"下客抛官独自回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐旧州驿亭上作","author":"宋庠","text":"废垒孤亭四面风，座疑身世五湖东。\n长天野浪相依碧，落日残云共作红。\n渔缶回环千艇合，巷蒲明灭百帆通。\n恍然归兴无人会，閒向青冥数塞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫保庞丞相以诗二首见寄次韵和答 其二","author":"宋庠","text":"出入台阶谢奋庸，白头持节更为公。\n临民不称瞻岩尹，慰俗犹依赠扇风。\n天许云鸿矰缴外，世怜池鹜稻粮中。\n一闻丽唱情何极，心结平津旧阁东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"宋庠","text":"草平天一色，风暖燕双高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其二","author":"李氏","text":"金珠富贵吾家事，常渴佳期乃寂寥。\n偶用至诚求雅合，良媒未必胜红绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张亢","text":"张亢触墙成八字，王琪望月叫三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新秋普明院竹林小饮得高树早凉归 其二","author":"梅尧臣","text":"清梵隔寒流，乱蝉鸣古树。\n谁知林下游，复得杯中趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新秋普明院竹林小饮得高树早凉归 其三","author":"梅尧臣","text":"池上暑风收，竹间秋气早。\n回塘莫苦留，已变王孙草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新秋普明院竹林小饮得高树早凉归 其四","author":"梅尧臣","text":"未坠高梧叶，初生玉井凉。\n愁心异潘岳，独自向河阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新秋普明院竹林小饮得高树早凉归 其五","author":"梅尧臣","text":"不减阮家会，所嗟当北归。\n厌厌敢辞醉，明发此欢非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自急流口至长芦江入金陵","author":"梅尧臣","text":"始发碧江口，旷然谐远心。\n风清舟在鉴，日落水浮金。\n瓜步逢潮信，台城过雁音。\n故乡何处是，云外即乔林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师厚与胥氏妇来奠其姑","author":"梅尧臣","text":"双裾来此室，恸器拜灵床。\n魂衣想髣髴，薄酒湛其觞。\n含悽抚孤稚，拭泪问平常。\n我生都无如，仰看燕在梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘推官贡甫赴汝州","author":"梅尧臣","text":"苑路如绳直，郊亭一雨过。\n浅沙车辙稳，晴树昼阴多。\n牧马方鸣泽，芸瓜已满坡。\n今闻从事去，试听壤人歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭谢公仪学士","author":"梅尧臣","text":"道路传闻日，惊嗟尚复疑。\n疾因勤学得，命不与人期。\n贾谊年伤少，相如恨见迟。\n向来公辅器，看取李家知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂兴 其二","author":"梅尧臣","text":"东家月吐明，西家犬争吠。\n月兔在中天，曾何竞窥秽。\n姮娥虽夜行，莫比淫奔废。\n呶呶篱下音，胡不钤其喙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和吴长文舍人对雪怀永叔内翰","author":"梅尧臣","text":"紫禁低云拂绮栊，西垣人忆玉堂翁。\n撚髭觅句方传咏，著树成花尚舞空。\n不管因风吹塞外，任教飞片落杯中。\n晓来城郭遮无路，阮籍驱车莫叹穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀石昌言舍人 其二","author":"梅尧臣","text":"圣贤无不死，寿夭复何云。\n唯有名常在，其馀理莫分。\n朝荣金玉宝，莫殒蕙兰焚。\n今日寝门哭，绪言长绝君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀石昌言舍人 其三","author":"梅尧臣","text":"贾谊过秦毕，相如谕蜀归。\n二人名既大，一日命何微。\n痟似乌常渴，灾成鵩不飞。\n百年今已矣，冰结泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王景彝正月十四夜有感","author":"梅尧臣","text":"灯光暖热夜催春，天半楼开饮近臣。\n驰道横头起山岳，露台周匝簇朱轮。\n隔帘艳色多相照，下马轻豪各竞新。\n我已暮年殊趣向，浓油一盏桉边身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王舍人忆省中小桃寄江学士","author":"梅尧臣","text":"浅绽燕脂紫蜡芳，深斟吴酎白琼觞。\n凤池人忆去年艳，雉省客无今日狂。\n髣髴物华先上苑，依俙歌吹下昭阳。\n平明社雨莫催促，应玩移床欲近傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题白云环翠亭","author":"葛闳","text":"六月好风吹玉林，地浮鳌海越山深。\n爱师终日无馀事，一点尘埃不受侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"富弼","text":"古云伏日当早归，况今著令许休暇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"杨谔","text":"愿前明主席，一问洛阳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芸隐再和复用以酬 其二","author":"陈起","text":"芸隐抱奇伟，未可论苦空。\n吾皇乐询道，日御赋政宫。\n会看召严徐，敷奏陛殿中。\n鸣靴踏龙尾，岂久莲依红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋颂九首 其三 莫丑","author":"石介","text":"乃谋于渭，乃将于美。\n王师鹰扬，涉江万里。\n辟其城门，鋹号请死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访栗园有感","author":"石介","text":"游困归来访栗园，栗园树老再生孙。\n莫惊头上见白发，拾栗儿童长几番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"苏舜元","text":"断香浮缺月，古像守昏灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游紫云洞","author":"文彦博","text":"同登青云梯，远访紫云洞。\n黄冠既前导，绛韝亦后从。\n幽奇素所希，险绝曾无恐。\n况此岩谷游，不知双舄重。\n摄衣叩洞户，肃若心神悚。\n两崖势相嵚，左右如抱拥。\n万木傍森罗，一水中汹涌。\n信哉天下奇，岂适谷间用。\n赏景未尽兴，向夕遽旋踵。\n飘然御风行，恍若游仙梦。\n异日期再来，退闲心更勇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠华清观主大师","author":"文彦博","text":"五城三洞朝真客，紫房名隶神仙籍。\n玉案晨餐沆瀣精，椒庭夜饮流霞液。\n姑山绰约冰雪容，亭亭霞外脱尘踪。\n飙驭狂游紫贝阁，云装醉入白银宫。\n想陪桂父与金母，昆蓬春赏蟠桃红。\n愚亦放怀随澹泊，昆芝茹朮希彭朔。\n常秘六泥东灶丹，每求五色西山药。\n紫台久判浮丘袂，锦州绣岭三千里。\n羽驾鸾骖未载逢，经年望断函关气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭门贤守器之度支赵鼎记余生日过形善祝并惠黄石茶瓯怀素千字文一轴辄成拙诗仰答来意","author":"文彦博","text":"使从徐方来，执讯如双鱼。\n遗我黄石器，副之怀素书。\n素书与黄石，得之宜在徐。\n或在圯桥下，或在留城墟。\n因物以达意，思贤而警愚。\n愚今所叨窃，何必承明庐。\n位历二府重，年登七旬馀。\n陋躯贲华衮，微名得虚誉。\n三朝被宠遇，八难惭嘉谟。\n瞻言西洛汭，愿继东门疏。\n意者赤松子，果是吾之徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政太傅侍中曾鲁公","author":"文彦博","text":"天坛小有洞，神仙称福地。\n草木尽翅秀，灵寿物珍异。\n孑立无附枝，挺生出群类。\n既不假矫揉，复不烦削治。\n制杖待时用，训鸠循古义。\n献于君子堂，达此野人意。\n所献虽已微，其意亦有谓。\n愿公稍扶持，与国同安置。\n匪惟布私诚，兹乃出公议。\n岂图一羽轻，复委千钧赐。\n报之以宝鉴，百练粗明致。\n副之以雅章，二南风格备。\n蔀屋天光照，陋躯华衮贲。\n何以称尊贶，传家为重器。\n何以继希声，陈诗言鄙志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏蒙仆射侍中贾寄示游噀上弊园归至湖上诗一章研味钦服不能自已辄成拙句仰答来贶","author":"文彦博","text":"脩篁小坞潩水湄，略有亭观体甚微。\n陪京上宰乐幽趣，闲乘斋舫临荆扉。\n是时仲夏之晦日，日轮停午炎炎时。\n披襟岸帻意自适，林下穆若生凉飔。\n子猷爱竹不问主，鲁侯在泮因成诗。\n妍词丽句溢累幅，金壶酒墨何淋漓。\n公适东偏访颜陋，愚当北道承萧规。\n魏人思公过召伯，一言一话无所遗。\n畴昔篇章仅三百，至今琬琰罗珠玑。\n跨山飞阁常逃暑，白醪满泛黄金卮。\n沈李浮瓜信美矣，回船弄水曾无之。\n遥瞻德星方聚处，正与两两交光辉。\n颍川异迹冠天下，湖上胜景邻日围。\n鹿舆桂楫亟游览，即见零雨东山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子骏朝议归阙","author":"文彦博","text":"累年分领西台宪，留滞周南人共叹。\n蚤传文价出坤维，为有仙才生阆苑。\n桂籍登科既已失，兰筋飞步终难绊。\n两持漕节赋均平，历守藩符政宽简。\n圣皇继统始谋庙，哲辅官材专进善。\n巍巍云阙此归觐，禁严侍从须邦彦。\n离襟欲判重徘徊，林下相从池上杯。\n别后思君何处望，肩舆频上紫金台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送乾元寺`住持实大师","author":"文彦博","text":"乾元古道场，宛在香山阳。\n实师应请去，无滞于一方。\n飘然振镮锡，殊不事包囊。\n孤风尤可尚，静法固有常。\n真心得正住，安重如陵冈。\n况闻师议论，博洽而精详。\n和会禅与讲，若登圭峰堂。\n迎知向学众，汲汲趋门墙。\n洪钟既大叩，随宜为发扬。\n清伊自南来，长波极渺茫。\n所谓筏喻者，利济如侨梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]