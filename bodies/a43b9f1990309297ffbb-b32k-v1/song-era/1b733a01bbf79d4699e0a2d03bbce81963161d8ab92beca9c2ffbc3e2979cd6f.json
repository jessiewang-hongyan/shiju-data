[{"title":"广漠亭二首和陈宪益之旧韵 其二","author":"程公许","text":"万峰银雪排天险，千里封沟辟蜀都。\n尽揖渎灵趋几席，始知国相妙规模。\n心同典午深衣乐，褊笑荆文纸阁糊。\n元祐风流如可问，群贤登用是良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"项安世","text":"策策秋声起树枝，遥怜塞下雁来时。\n宁闻中夜荒鸡舞，肯拾他人竹马骑。\n短剑旧曾交侠客，小诗犹作将偏师。\n无情却是青铜镜，刚照书生两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其四","author":"刘克庄","text":"旋插疏篱设矮扉，仅容老子自娱嬉。\n国蜗角上何嫌小，巢鸟窠边不觉危。\n石椁无陈鸡絮者，朱门有设雀罗时。\n平泉花木奇樟桧，辛苦栽培竟属谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其八","author":"刘克庄","text":"诸公衮衮一番新，留得山林著放臣。\n鞍破马移它厩去，巢空燕觉主家贫。\n甥陪棋局何须客，儿举篮舆不觅人。\n膜外浮荣酒中趣，看来二者孰关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其三","author":"刘克庄","text":"少喜清谈拙自谋，行年至此复焉求。\n归休谁肯争幽谷，贫杀犹堪买沃洲。\n笛作曾垂安石泪，扇遮难护彦回羞。\n伯阳老去差奸黠，真出函关不少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其十","author":"刘克庄","text":"古书舛驳承讹久，新义支离折衷难。\n孔墨达观无异道，触蛮角立有争端。\n壁中科斗经传写，瓮里醯鸡味笔残。\n老子暮年亲勘破，束书阁上不须看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其九","author":"刘克庄","text":"回首危途尚可惊，三家村里送馀生。\n入无奥主常孤立，归有邻翁可耦耕。\n骂坐不闻因耳重，悬车已决觉身轻。\n小诗何必诸公诵，自向閒时咏太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其七","author":"刘克庄","text":"淳熙以后绍熙前，曹马灰寒不复燃。\n宁作归来词引避，可为劝进表求全。\n斜川妙语超言外，广武狂谈发酒边。\n赖有遗文堪可质，世谁陶阮岂其然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其二","author":"刘克庄","text":"曾忝开元供奉班，君恩全护放还山。\n诸公纵欲俎豆汝，老子安能笔砚间。\n试拂毛锥嗟已秃，便扶灵寿亦何颜。\n回头猿鹤休相笑，犹胜周颙去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其一","author":"刘克庄","text":"苍苔满意上庭除，应为新来客屦疏。\n老圃宁无螬半李，贫家尚有鼠馀蔬。\n身光退士吟招隐，儿劝尊公赋遂初。\n已与山灵盟歃了，龙钟断不就安车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其五","author":"刘克庄","text":"鬓发萧萧牙齿疏，耄荒不记兔园书。\n有时待月□□榭，蓦地看花命小车。\n早慕两龚辞病去，晚从二仲卜邻居。\n阿戎解执牙筹耳，嵇阮中间却顿渠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴十首 其六","author":"刘克庄","text":"何止才疏亦命悭，暮年身世寄田间。\n望尘早不游金谷，投笔今难戍玉关。\n日祷泥龙晴自若，昼骑秧马夕方还。\n跳丸只了东西走，不道能苍壮士颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次乡守赵计院鹿鸣韵","author":"刘克庄","text":"幸际龙飞策士年，灵岩仙水执鞭先。\n夺标文妙三场称，劝驾诗高万口传。\n昔忝词臣曾草诏，今为乡老预兴贤。\n春风到耳鳌头选，尚可扶衰候马前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次方寺丞方湖韵","author":"刘克庄","text":"晚来吉语到茅椽，太华诗翁约泛莲。\n况有邹枚同预宴，可能李郭独如仙。\n帝犹给我还山俸，天不需人买月钱。\n挥手闯门冠盖客，急归勿搅瓮间眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次方武成壶山韵","author":"刘克庄","text":"图经云此有神仙，曾见壶公跳入年。\n斫木人多山渐瘦，结庵僧去石谁眠。\n鸟归半岭衔斜日，樵返疏村起远烟。\n君若能抛尘里事，一龛共占野云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次王元度韵","author":"刘克庄","text":"占尽灵乌顾尽云，君恩宽大放归闽。\n一区二顷生缘薄，万绪千条素发新。\n铁马即今徵战士，金鸡何日赦累臣。\n殷勤说向西飞雁，多谢交游与吏民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次王实之家塾韵","author":"刘克庄","text":"新敞朱甍映碧岑，高门谁识庆源深。\n畤郊已解传家学，石礼皆堪直禁林。\n七叶文章真有种，二郎官职本无心。\n庭前玉树成阴未，著手栽培昉自今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次王玠投赠韵三首 其三","author":"刘克庄","text":"两被宸奎擢史官，曾参豹尾属车间。\n不能直笔公褒贬，安敢高谈到画珊。\n老有丹心犹恋阙，死无一字可藏山。\n儿童忘记翁年甲，但笑颜苍与鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次王玠投赠韵三首 其二","author":"刘克庄","text":"在野宜赓击壤歌，隐忧不禁亩忠何。\n殷生宰相安知否，逸少群贤感慨多。\n老觉鬓丝难掩覆，穷惟心铁未消磨。\n早知掷却毛锥子，有警犹为国荷戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次王玠投赠韵三首 其一","author":"刘克庄","text":"平生拙计类愚公，处处撑篙溯逆风。\n身已呻吟行泽畔，谁令剥啄到山中。\n历官蚁穴一场梦，闷事鸡窠百岁翁。\n颇恨暮年持酒戒，不能领客访无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次江权军宴新进士韵","author":"刘克庄","text":"病翁无计出愁城，喜甲科郎竞拾青。\n主礼尤隆真刺史，华宗相望两魁星。\n董生至论惟三策，韦氏单传只一经。\n举首爱身如拱璧，修于家肯献于廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次竹溪别后见怀韵","author":"刘克庄","text":"珍重山翁别病翁，归鞍欲发苦留侬。\n万言君视犹杯水，一镞吾难直箭锋。\n缩手可怜今落莫，攀髯未报昔遭逢。\n衰迟只愿低头拜，蛟变为龙愈亦从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次竹溪所和薛明府镜中我诗三首 其三","author":"刘克庄","text":"幪以衣冠类孙叔，被之蓑笠即玄真。\n未知这汉为谁子，如客他乡喜故人。\n皓白相看双鬓秃，丹青偏写两眉颦。\n吾闻四大皆虚假，曾向聃书悟谷神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次竹溪所和薛明府镜中我诗三首 其二","author":"刘克庄","text":"物我乖离果孰亲，色空捏合本非真。\n金狨马上惭穷相，玉镜台中识幻人。\n南北宗禅皆具眼，东西施貌各含颦。\n眉间一点元无喜，颊上三毛岂有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次竹溪所和薛明府镜中我诗三首 其一","author":"刘克庄","text":"搔白发翁疑是假，对青铜镜认为真。\n影形本合成同体，梦觉俄分作二人。\n欢至不期开口笑，愁来相对捧心颦。\n可怜怛化贪生者，刍狗元身学出神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次竹溪韵跋志仁工部柞木诗 其一","author":"刘克庄","text":"冥搜险韵搅枯肠，音义时乎取断章。\n吾窭仅能茅破屋，君材真可栋明堂。\n居然挺挺过苍柏，胜似萧萧种白杨。\n识草木名须博览，夜窗灯火恰新凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次竹溪韵跋志仁工部柞木诗 其二","author":"刘克庄","text":"白也诗高有别肠，弃馀分与老知章。\n邓林木大堪支厦，谢砌兰佳况肯堂。\n何必三年犹刻楮，便教百步亦穿杨。\n咸淳天子开文治，定起君赓殿阁凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次两紫薇共游黄檗韵","author":"刘克庄","text":"仰攀栖鹘手扪天，俯瞰灵虬卧沕渊。\n廉使昉于今易□，祖师曾向此安禅。\n绝怜雪瀑飞千丈，颇欲阴崖结数椽。\n老病不能扶杖出，让他李郭做神仙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次君畴洪卿韵送宗学赵优奏","author":"刘克庄","text":"欲为乾坤扫积阴，万言忠愤上穹临。\n相嗔平地风波恶，主圣如天雨露深。\n葛藟尚为庇根计，戎葵难改向阳心。\n明时安肯寻斤斧，自古高材出邓林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张使君韵","author":"刘克庄","text":"欲架茅堂久不成，萧然身世托专城。\n日无车辖非常静，月有餐钱未是清。\n髡首向来输白粲，短衣老去斸黄精。\n绝怜不及梁间燕，岁岁新巢巧自营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次林卿槟榔韵二首 其二","author":"刘克庄","text":"锦衣旋剖苞中实，栀面俄回镜里春。\n始信中华禁酒国，不如南粤主林神。\n金盘惟送渠矜贵，糟瓮酣眠子任真。\n赤脚蹈冰聊取快，谁能拥妓坐重茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次林卿槟榔韵二首 其一","author":"刘克庄","text":"芳洲弥望总荒榛，此物偏沾雨露春。\n海贾垂涎规互市，夷人嚼血赛媒神。\n扶留叶嫩供汤使，大腹形同混伪真。\n树下莓苔堪健倒，华堂何必锦为茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次铁笔堂韵谢朔斋贡馀","author":"刘克庄","text":"皇朝尽却九州贡，闽荈犹先百草花。\n正焙头纲驰御府，斜封三印到山家。\n秘藏蔡录珍无价，快睹侁星远有华。\n纵使搜肠五千卷，安能视草更操麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次黄殿讲鸣佩亭","author":"刘克庄","text":"谁引扶胥水入城，循除终日爱琮琤。\n天风何许佩环响，秋色自然竽籁声。\n尽洗珠犀宁受涴，少留琴鹤未须行。\n它年父老传都漕，名与濂翁一样清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵","author":"刘克庄","text":"不惟慵进取，兼亦断知闻。\n交友赤松子，弟兄孤竹君。\n共寻对床约，更割半山分。\n新敕冰衔峻，何须刻籍文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首 其一","author":"刘克庄","text":"阮生未老各情亲，谁道先生不觌邻。\n莫管弹丸惊鸭者，岂无沽酒与鱼人。\n何曾膝上推文度，亦许车中载小陈。\n赐第京师即山铸，得如跳出软红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首 其一","author":"刘克庄","text":"老懒尤于笔砚疏，难陪骑省赋闲居。\n去周柱下谁为史，传邺侯家尚有书。\n台馈不烦公粟肉，户租难办客车鱼。\n侧旁万一邻堪买，便拟诛茅近太初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首 其二","author":"刘克庄","text":"半生窃禄取禾廛，晚节休官失秫田。\n伴陆先生游甫里，同陶徵士访斜川。\n凤池信美其如夺，莺谷虽幽不愿迁。\n自笑刘墙如许短，谪仙坛未易扳缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首并呈仓使 其一","author":"刘克庄","text":"晚雾徐收月色鲜，承平物态尚依然。\n断无飓母起吹海，应有蚌胎还媚川。\n远俗熙恬犹乐土，孤臣流落谩忧天。\n夜归听得舆人语，且愿新年胜旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵二首并呈仓使 其二","author":"刘克庄","text":"归念常如危柱弦，春来梦绕白云边。\n不知新雪添头上，但见繁星满目前。\n即事有诗聊记节，救时无策但祈年。\n二公语妙堪传远，严杜何因可共编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵三首 其三","author":"刘克庄","text":"拂拂东风欲辨晨，新晴和气满郊闉。\n未妨吹雅存豳俗，何必沉巫怖邺民。\n田父扶携问鸡卜，村姑呼唤祭蚕神。\n柴门不识徵租吏，便是尧时击壤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵三首 其二","author":"刘克庄","text":"病怯春寒添絮衣，神情全减少年时。\n仅堪田舍陪乡饮，难向湖亭看水嬉。\n清旦羲和升日毂，回风王母带云旗。\n管箫声散人归晚，独有萤穿马季帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵三首 其一","author":"刘克庄","text":"邻鸡初唱晓妆忙，空郡疑开选色场。\n未许丛台誇袨服，却将淇水易渐裳。\n咏归惟点曾言志，驰骋虽聃亦发狂。\n闭目不窥惟地主，且祈麻麦接青黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵乡侯计院二首 其二","author":"刘克庄","text":"还山非敢厌承明，鹤唳莺啼若个清。\n警句摘稀惭杰思，博封冰少见交情。\n当年扈跸重金贵，他日飞空一剑轻。\n莫问路头何处去，出门万里水云程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵乡侯计院二首 其一","author":"刘克庄","text":"诸老皆曾接典型，鹅湖一辈亦豪英。\n晚持师说尤坚垒，不怕兵家会斫营。\n晴色极佳宜岁事，郊行因好访民情。\n朝家要采风谣否，第一君侯号治平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵丰守宴新进士","author":"刘克庄","text":"联镳共醉杏园春，英辟龙飞为作新。\n诸老破荒□□宋，三台接武辅乾淳。\n贤侯推广崇儒化，先辈□□□士仁。\n珍重黄堂一杯酒，也沾白发旧词臣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王元度二诗 其二","author":"刘克庄","text":"向来绮语祸机深，几效灵均欲自沉。\n周庙人曾铭在背，管城子已秃无心。\n今谁伯乐能酬价，后有钟期必赏音。\n老矣尚须君警策，昔人一字答千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王元度二诗 其一","author":"刘克庄","text":"留落而今两鬓秋，暮年出处愧前修。\n敢云余补韩公处，极喜君来谢客州。\n奇甚宝镡腾紫气，清于玉瓒荐黄流。\n后生不作先贤远，便合相推出一头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘帅出郊一首","author":"刘克庄","text":"竞逐朱轓载酒行，熙熙物态与人情。\n浴沂我欲寻儒服，涉洧公方厌郑声。\n试问冶容遨夜市，何如赤脚馌春耕。\n故山瓜圃应无恙，老去深知愧邵平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汤伯纪送别二首 其二","author":"刘克庄","text":"比似莆杭倾盖时，更崇古雅黜新奇。\n久栖衡泌宁非乐，不倚门墙未易麾。\n析理自应重讲席，论文吾合竖降旗。\n抚弦欲奏成三叹，何处而今有子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵汤伯纪送别二首 其一","author":"刘克庄","text":"尚在朝廷记忆中，敢于父命择西东。\n独怜家有百岁母，可使人嗤六十翁。\n芰制子能华岁晏，莼羹吾亦感秋风。\n书成藏向深山里，莫费君王遣所忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹子彬五言二首 其二","author":"刘克庄","text":"短章足光怪，夭矫暮天虹。\n俗子仙凡判，诗人伎俩同。\n君奚惭有道，吾欲访无功。\n肉眼非弘景，何由见碧瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹子彬五言二首 其一","author":"刘克庄","text":"甫暮书窗黑，俄瞻贯月虹。\n真知今绝少，好本古来同。\n孤垒吾无拔，偏师汝策功。\n暗投可借许，留取和重瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪一首","author":"刘克庄","text":"藏山覆瓿两相痴，辛苦才供世俗嗤。\n壮不如人徒自悔，老能学易未过时。\n懒犹堪草归田赋，钝岂能吟对御诗。\n惟有聃书宜北面，存元守黑畏人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪中书重脩县桥二首 其二","author":"刘克庄","text":"仲秋鸠僝迄穷冬，钜丽依稀似蔡公。\n濡足几年通国病，肯心一片有谁同。\n人言此庆钟双凤，天落其成见两虹。\n不是坡仙捐宝带，此桥安得往来通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪中书重脩县桥二首 其一","author":"刘克庄","text":"古者役人常以冬，据经端自紫薇公。\n杠舆梁涉犹徒步，龟筮民从见大同。\n不假洛阳抱桥蛎，宛如震泽卧波虹。\n春江浩渺风涛急，方待先生济不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪题达卿后坡 其四","author":"刘克庄","text":"贫士莫难乐不改，圣人固以遁为嘉。\n宁披龙具去耕野，奚事鹤书来起家。\n古有逸民逃举选，今无烈士矫贪誇。\n鬳翁晨遣诗筒至，昨夜寒灯屡结花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪题达卿后坡 其三","author":"刘克庄","text":"岁计无馀逢谷贵，晚餐有味觉蔬嘉。\n赊邻人酒堪留客，藏善和书尚满家。\n稍喜熊儿理精熟，常嫌犬子赋虚誇。\n鲁论新义何时毕，相约溪头共看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪题达卿后坡 其五","author":"刘克庄","text":"瘠地力耕禾倍入，荒山手植树皆嘉。\n同□炀者并吹者，融会儒家与墨家。\n见说杨雄太玄苦，非如宋玉大言誇。\n绝怜汝伯头成雪，羡汝才高笔有花。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪题达卿后坡 其六","author":"刘克庄","text":"郎陵后嗣尤推彧，太傅诸孙最数嘉。\n之子固无惭尔祖，此翁所望大吾家。\n夺标羞与儿童竞，佩印才堪妾妇誇。\n案上菖蒲勤洗沐，灵苗见说有时花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪题达卿后坡 其一","author":"刘克庄","text":"□反终身从李愿，有人半夜唤祁嘉。\n箪瓢斋颇奢颜巷，书画船堪埒米家。\n樗叟旧栖贫亦好，肤翁新句大非誇。\n谁云地僻交游少，鹤肯巢松鹿献花。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵竹溪题达卿后坡 其二","author":"刘克庄","text":"窗无童子窥桃熟，坐有骚人颂橘嘉。\n触氏不来争左角，颜渊亦只住西家。\n罗张门巷求吾乐，锦裹山林笑彼誇。\n红绿千株皆手种，绝胜人看担头花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]