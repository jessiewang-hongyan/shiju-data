[{"title":"汉老弟生朝","author":"虞俦","text":"风流曼倩碧云仙，惯见儿嬉寿母前。\n莫讶科名后馀子，要教富贵出长年。\n鹅黄新酿香浮瓮，雁翅横秋影接天。\n端的姮娥消息近，南坡丹桂已开先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉老弟寄示雪诗倡和已成轴矣因次韵 其一","author":"虞俦","text":"腊尽冰花堕渺茫，诗来爽气想清扬。\n润添陇麦知年熟，影浸溪梅见月将。\n闭户谁能呼白堕，回风却笑舞红妆。\n小桥梦入南坡路，并辔骑驴赋短章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉老弟寄示雪诗倡和已成轴矣因次韵 其二","author":"虞俦","text":"衡门虽设昼常关，人在琼楼玉宇间。\n一笑眼青馀老桧，相看头白祇高山。\n携壶索共梅花醉，著屐扶行竹杖斑。\n此兴此时吾不忘，倦飞深羡鸟知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉老弟寄示雪诗倡和已成轴矣因次韵 其三","author":"虞俦","text":"飞洒羞明不肯朝，徘徊待伴未全消。\n将花著袂元无迹，认柳吹绵别有条。\n璧月半规开水面，玉龙千丈转山腰。\n玄冥已自呈三白，青帝何须又一飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉溪梅株柯殊绝宣和间用事者尝图以进竟不报今乃弃置蔬畦摧折憔悴有可怜之态昨陪诸公往观共叹其不遇且约盛开时携壶酒为醉赏之适因循又不果因用韵吊之","author":"虞俦","text":"玉溪得得探芳期，孤负诗人尽醉归。\n消息向来空驿使，画图老去惜明妃。\n香魂月堕惊春梦，翠袖天寒怯暮晖。\n蜂蝶卑凡浑省识，良迷桃李趁狂飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用山门记游韵赋酴醾简林子长不蒙宠和岂不复作书生调度耶因以诗督之","author":"虞俦","text":"袅娜柔条不自持，锁窗深处最相宜。\n试教纤手簪双鬓，莫遣新愁上两眉。\n子建洛神空有赋，乐天杨柳可无诗。\n为君唤起温柔梦，春草池塘日正迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵和仲兄","author":"虞俦","text":"鼯鼠相将五技穷，东来岁月太匆匆。\n冷官敢恨知音少，直道难教与俗同。\n翻忆对床听夜雨，不堪举扇障西风。\n诗来唤起还家梦，目断成行天际鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵赋岁暮田家叹闻之者足以戒也","author":"虞俦","text":"催科里正莫频频，望麦登场更浃旬。\n纨裤向来无饿死，黄冠此去罢迎神。\n田间作苦谁怜汝，天上调元合有人。\n自叹农家消底物，百金斗米便回春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵酬翟曾二倅和章 其一","author":"虞俦","text":"那得朝朝琼树新，拥炉添炭费乌银。\n试呵冻笔还搜句，浅酌香醪未计巡。\n过眼年华休恨晚，转头天令即行春。\n纷纷桃李谁知问，祇有寒梅是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵酬翟曾二倅和章 其二","author":"虞俦","text":"诗成开府让清新，纸扫溪藤笔弄银。\n斗转苍龙归北望，日行黄道傒东巡。\n人情自是随时变，天意何私与物春。\n官里簿书殊未了，不知花事属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲寅十一月朔旦冬至适值先妣太夫人服阕从吉感而赋诗二首 其二","author":"虞俦","text":"维摩应待散花天，无复称觞寿母前。\n从隔蓬壶三万里，尚期华表一千年。\n弟兄黄发三人在，故旧青云众目怜。\n自愧阿奴真碌碌，不妨鉴井又蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲寅十一月朔旦冬至适值先妣太夫人服阕从吉感而赋诗二首 其一","author":"虞俦","text":"黄鸡催晓破霜天，起整冠裳拜影前。\n又见刺文添一线，谁知泣血已三年。\n蟠桃海上今应熟，双橘怀中祇自怜。\n未必儿童知此恨，綵衣依旧戏蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石芥","author":"虞俦","text":"杯酒流行四座倾，此君风味始峥嵘。\n捣残姜桂嫌无韵，扫尽茅柴不到酲。\n崖谷野人羞自荐，膏粱公子莫知名。\n攀萝采撷天寒甚，谁念终朝掬不盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石照劝农晚归有雨","author":"虞俦","text":"疏林拂拂见旌旗，短镫翩翩度翠微。\n十里好山供客醉，一犁春雨劝农归。\n水流花出红成队，麦雨天连绿打围。\n投老田园今晚矣，不须五十始知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春日雪","author":"虞俦","text":"占候农祥恰正晨，一天遽有散花人。\n飘扬柳絮犹疑早，点缀梅花欲乱真。\n但爱千峰如立鹄，谁怜百结有悬鹑。\n玄冥珍重丰年意，分付东皇作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙池祷雨","author":"虞俦","text":"御府金奁出宝薰，爇来池上定知闻。\n龙应覆手能为雨，岫岂无心漫出云。\n秧插高田犹未遍，泉流幽涧恐难分。\n奉常典礼吾方与，毋作神羞视秩文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲本别去才半月尔瞻恋不啻如隔岁奉此寄怀","author":"虞俦","text":"纷纷覆雨与翻云，只有吴人不世情。\n穷迫每怜长袖舞，别离愁听短歌行。\n春波碧草连南浦，朝雨垂杨拂渭城。\n丝竹未应陶写得，向来肝胆为渠倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲本索归甚遽前诗送行言之不足见示和篇览之益用慨然再用前韵","author":"虞俦","text":"幸有绨袍恋故人，不应回棹遽忘情。\n相逢且话十年事，此别又成千里行。\n归去我犹惭靖节，催科谁解恕阳城。\n黄堂今有仁人在，璧水当年盖已倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"休日欲报谒林子长值雨不能前用小诗以谢不敏","author":"虞俦","text":"朝雨城南柳色新，溪光溶漾宛如银。\n地偏心远开三径，风引船回欠一巡。\n二月欲来正月尽，三分已过一分春。\n莺啼燕舞非吾事，管领韶华自有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用难字韵简潘接伴","author":"虞俦","text":"当年名下无虚士，此日诗中有二难。\n方驾饭山何太瘦，拍肩东野不言寒。\n来章只好先呈佛，属和何当胜得官。\n珍重牛腰成巨轴，丁宁莫与俗人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵呈林子长","author":"虞俦","text":"痴儿谁识坐谈高，抚字年来亦漫劳。\n簿领何妨聊尔耳，湖山正是属吾曹。\n百年心事空三叹，五马人生却二毛。\n欲作报章还自笑，郊寒宁解敌韩豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵述怀","author":"虞俦","text":"少年发愤欲忘餐，信木能钻透石盘。\n灯火半生徒自苦，齑盐并日不嫌单。\n嗟来未肯低头拜，臭腐那须著眼看。\n何物马肝犹不悟，怜渠五利竟诛栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵谢王簿来诗褒借过当之意 其二","author":"虞俦","text":"旱魃争攘袂，群龙仅守龛。\n云峰疑燎火，天色转澄蓝。\n甘露元同注，丛林莫遍参。\n新来焦渴甚，无梦到沉酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵谢王簿来诗褒借过当之意 其一","author":"虞俦","text":"黄奶朝千卷，书灯夜一龛。\n玄文今尚白，袍色故应蓝。\n簿领聊尔耳，朝班行矣参。\n惊雷虽破柱，午寝不妨酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵赋木犀","author":"虞俦","text":"高枝曾折记前回，晚路重逢叹滞才。\n天上移来和月种，人间占得及秋开。\n香浮翠葆花藏叶，影动燃犀酒映杯。\n犹有黄花堪殿后，为渠留恋为渠催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵简王簿 其一","author":"虞俦","text":"山云泼墨度墙隈，信道鸣鸠唤雨来。\n骤泻竹梢青羃羃，乱翻荷盖白皑皑。\n尊前花落愁赊酒，地上钱流错认苔。\n更愿公家宽赋敛，斯民卒岁亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"虞俦","text":"天时人事日相煎，否泰俄惊在眼前。\n积闰尽归冬十月，纪元一似太初年。\n联珠合璧犹重见，华发苍颜益可怜。\n三抚祥琴无意绪，当筵那忍舞蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再委赵丞阳山送龙祷雨 其一","author":"虞俦","text":"传闻神姥产英灵，雷电当时亦晦冥。\n好雨固宜随祷应，夜窗曾误几番听。\n关心病守头空白，失喜农夫眼倍青。\n水溢旱乾宁有数，人间无路叩天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再委赵丞阳山送龙祷雨 其二","author":"虞俦","text":"老龙高卧复何求，韬敛风雷自一湫。\n不恨如麻无雨脚，却愁生耳有禾头。\n向来河内惭移粟，此去江边欲具舟。\n龙若有灵须早计，霖霪莫待火西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再促花","author":"虞俦","text":"珍重栽培意，商量仔细开。\n花心终有待，诗句漫劳催。\n莫恨三秋去，须教一笑回。\n但储千斛酒，端的奉徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同主簿过翠眉亭 其一","author":"虞俦","text":"墨绶低回叹陆沉，好山浑作翠眉颦。\n我聊尔耳宁违俗，仕有时乎亦为贫。\n老去催科非所学，向来凋瘵愧斯民。\n整襟再拜栾城像，幸剩残膏丐后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同主簿过翠眉亭 其二","author":"虞俦","text":"宦情元薄且浮沉，抚字劳心祇效颦。\n白首论交嗟已晚，青衫捧檄祇缘贫。\n简书岂不怀朋友，德意安能及吏民。\n误矣折腰成底事，谁欤高枕有閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回程泗州道中","author":"虞俦","text":"淮北燕南昔混同，相望却恨马牛风。\n往来未省谁为伴，言语从来自不通。\n百岁遗民愁绪外，数声羌笛梦魂中。\n径须争渡长淮去，三月烟尘一洗空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因次郊行韵眷然怀归","author":"虞俦","text":"杖藜何日返林坰，梦想西山几草亭。\n丛菊暂为三径别，垂杨又见两番青。\n宦游知己云中月，市道交情水上萍。\n多事不烦渔父问，餔糟久矣忘偏醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁除","author":"虞俦","text":"除日催人不奈频，那堪月小不圆旬。\n谁能椒颂花如锦，自写桃符笔有神。\n通夕留连分岁客，明朝多少贺年人。\n寿觞举处慈颜喜，却是萱堂剩得春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巩使君一新社稷坛宇次汪倅韵","author":"虞俦","text":"岿然坛宇俯清流，须信规摹跨别州。\n端为苴茅崇屏翰，要知束楚贵绸缪。\n治聋有酒烦分馈，宰肉何人叹滞留。\n天欲吾公安社稷，未宜小试羡三休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巩使君劝耕汪倅有诗次韵","author":"虞俦","text":"小队行春簇使旌，黄童白叟递逢迎。\n劝耕试向何山麓，竞渡还倾极乐城。\n画舫骁腾喧鼓吹，红妆凝伫傍轩楹。\n山公归路人争看，已有丰年笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏和东坡先生牛尾狸诗韵且效其体","author":"虞俦","text":"夜寒那得到帘帷，前拥红炉后翠眉。\n未致马蹄沙水鳖，且尝牛尾雪天狸。\n菹寒石芥愁辛鼻，鲊熟雏鹅怯带脂。\n端的为渠添酒兴，红颜相映玉肤肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏简林子长 其二","author":"虞俦","text":"崇桃积李巧争新，红胜胭脂白胜银。\n车骑每劳莺命唤，药栏聊伴蝶游巡。\n何须歌舞留连夜，漫与诗篇慰藉春。\n珍重海棠烦问讯，肯教空谷老佳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"收汉老弟近书知十全遂勿药之喜慰可知也但未卜来期诗以见意","author":"虞俦","text":"一日思君一度年，家山好在落霞边。\n飞鸿日去情何限，黄耳书来病已痊。\n攲枕池塘春草梦，闭门风雨落梅天。\n南坡政恐春留住，过我何时果著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早上过溪报谒林子长承约客回途作 其二","author":"虞俦","text":"画诺何如瑨，歌呼敢效曹。\n一饥才免死，千虑亦忘劳。\n酒里愁先醉，吟边句未豪。\n菟裘吾欲老，不是故为高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早上过溪报谒林子长承约客回途作 其一","author":"虞俦","text":"臭味还吾辈，炎凉笑若曹。\n相逢倾盖旧，可但泛舟劳。\n夜雨湖山好，西风鼓角豪。\n主人宁避客，祇觉杜门高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀广文俞同年 其三","author":"虞俦","text":"祝君努力且加餐，世路羊肠政屈盘。\n烹鲤何由问消息，割鸡政自困平单。\n书生说食真成癖，俗子疑人莫与看。\n搜搅枯肠有文字，玉州犹爱月团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀广文俞同年 其一","author":"虞俦","text":"宦游霜宿与风餐，环郭青山岂曰盘。\n馀暇每思亲丈席，新凉政喜入中单。\n交情老去才方见，世事年来亦饱看。\n颜色想君如李白，却疑明月满重栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀广文俞同年 其二","author":"虞俦","text":"客来愧乏牛心炙，茶罢空堆马乳盘。\n纵有诗篇惭和寡，了无心印可传单。\n平生黄卷能忘味，晚岁青山未厌看。\n归去吾庐吾亦爱，更须华屋羡雕栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀广文俞同年 其四","author":"虞俦","text":"万山深处祇空餐，报赠惭无双玉盘。\n日晏仅馀晨粥半，夜凉更觉夏衾单。\n怜渠许国丹心在，付与穷途白眼看。\n它日鸡豚燕同社，不烦父老见思栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀汉老弟 其三","author":"虞俦","text":"村童先遣扫柴门，检校园芳待置尊。\n丛菊稍斑漙露点，芙蓉已带著霜痕。\n诗篇纵好成孤讽，心事凭谁与共论。\n已是西风悲落木，那堪幽独更销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀汉老弟 其一","author":"虞俦","text":"先自无聊懒出门，南坡一到一思君。\n松筠俱是栽培力，亭榭无非卜筑勤。\n本约暮年栖息共，岂期中道死生分。\n风前试数当时雁，一雁今归何处云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀汉老弟 其二","author":"虞俦","text":"缺落槿篱须补缀，稀疏菜甲欠锄耘。\n芙蓉泣露坡头见，桂子飘香月下闻。\n策杖却愁成独往，举杯谁与醉浓芬。\n欢悰莫讶年来减，触目无非是忆君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀南坡盖雪阻旬日不到","author":"虞俦","text":"催年节物太频频，不涉南坡又一旬。\n苍桧风前应强项，玉梅雪里想精神。\n后车同载有名酒，折简欲呼无可人。\n说似阿连须早计，莺花休拟负青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱天永示仆二诗盖有激而云者因用其韵以广之 其二","author":"虞俦","text":"弹铗悲歌莫浪嗟，笔耕心织是生涯。\n区区子岂痴摹虎，事事吾犹错画蛇。\n不分缩头几类鳖，苦嫌怒目几遭蛙。\n凭君试读山君传，鹤岂能言为嫉邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱天永示仆二诗盖有激而云者因用其韵以广之 其一","author":"虞俦","text":"是非得丧一毫轻，蛮触何劳角上争。\n未可轻量天下士，渠知不是彀中英。\n平生我亦轻馀子，到处君安得此名。\n勿对秋花叹憔悴，春风回首又欣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张安国舍人读王侍郎诗有怀其人韵","author":"虞俦","text":"盖世声名紫府仙，平生襟袖著山川。\n一麾管领秋江月，千首凭陵杜曲天。\n畴昔风云馀感慨，归来文字带芳鲜。\n和韩何限惊人句，应有门人李汉编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次林正甫韵","author":"虞俦","text":"湖山梦想阻登临，柳色门前绿未深。\n老去青衫谁著眼，向来白战尚寒心。\n浇愁可欠杯中物，遣兴聊为洛下吟。\n倒指启关春已暮，直须修禊继山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵古梅","author":"虞俦","text":"怪底昌园一种梅，老枝强项独迟开。\n伶俜鹤膝翻嫌瘦，皴皵龙鳞不受摧。\n羞把冰肌混桃李，故将粉面映莓苔。\n广平铁石心犹在，宁有诗情似玉台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵汉老弟对月满饮","author":"虞俦","text":"鹤发金桃母，蛾眉萼绿华。\n月圆香度桂，饮罢烛生花。\n何惜尊空酒，能令春满家。\n更邀重九菊，醉里堕乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵曾使君和删定鲍倅喜谯楼双门复旧观之作","author":"虞俦","text":"公家文字足搜寻，间览容陪夏日临。\n句里江山元自旧，笔端造化速宜今。\n朱扉对启雄潭府，秀气平分入泮林。\n青佩龙门行在望，跃鞭莫负使君心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自中秋月圆木犀开后倡酬络绎今可以止矣再书数句殿其后","author":"虞俦","text":"秋月秋花自一回，锦囊收拾靡遗才。\n吟馀顾兔毫端满，赋罢文犀纸面开。\n十里清香供隐几，三人对影称挥杯。\n笑渠冷淡为生活，何似笙歌鼎沸催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自叹 其一","author":"虞俦","text":"落落高才岂晚收，枉将岁月送菟裘。\n未能鹏击三千里，空费龙骧万斛舟。\n明月有珠谁按剑，珊瑚作网漫沉钩。\n求田问舍非吾事，豪气元龙死不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自叹 其二","author":"虞俦","text":"明经青史不难收，怪底依然处士裘。\n谁谓封侯安事笔，我闻定霸必焚舟。\n骥腾夷路须联辔，鳌负三山好掷钩。\n对策清时看第一，未应蕴藉愧裴休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中","author":"虞俦","text":"寒日移阴短，清溪放溜迟。\n归田真晚矣，泛宅欲何之。\n鸿送天边目，山横雪后眉。\n诗中无限兴，一一报公知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中冬至","author":"虞俦","text":"阴阳消长际，新旧送迎中。\n异县他乡泊，天时人事同。\n世方期道泰，我岂坐途穷。\n儿女番为寿，衰颜借酒红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]