[{"title":"瑛上人","author":"许棐","text":"十二三时便出家，何曾顷刻离烟霞。\n晨持数卷日方上，夜梵千声月未斜。\n洗钵不经鸥浴水，插瓶嫌采蝶残花。\n儒冠误我骎骎老，何日蒲团共结跏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木芙蓉","author":"许棐","text":"芙蓉艳金谷，秋色锦机中。\n霜树不知丑，叶与花争红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东归道中","author":"许棐","text":"芙蓉波面出罾鱼，廉似城中买担蔬。\n欲试脍刀还不忍，恐伤千里寄人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"笼禽怨","author":"许棐","text":"千金新购入雕笼，恨在娇声断续中。\n昨夜羁雌何处宿，落花残月故巢空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破镜词","author":"许棐","text":"宝镜一从分破后，不堪磨拭照妆钿。\n倩谁携上青云去，补得今宵缺月圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龚彦质恕可二丈","author":"许棐","text":"两龚当暑客秦溪，旋买黄綀替熟衣。\n想见西湖风月里，藕花凝望载诗归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张声父","author":"许棐","text":"城中破屋妻儿住，自向招提借小房。\n壁上碑文皆古篆，案头书册半仙方。\n月嫌碎竹遮窗暗，风款飞花入座香。\n点检未如僧相处，只多髭鬓几茎霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉归","author":"许棐","text":"半醉归来卧不成，月华霜彩烂中庭。\n茶铛冻结香匜冷，只把梅花嗅得醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上曲","author":"许棐","text":"新晴旋蜡游春屐，半湿香泥恰好行。\n琢得小词腔未稳，往来花下怯歌莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵野云","author":"许棐","text":"载雨驾雷翻覆顷，漏星藏月卷舒间。\n若将云与诗人比，政恐云无日日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古砚送赵明府","author":"许棐","text":"一片端州古砚砖，翁孙相授当良田。\n寒梅涧下和冰洗，秋桂窗前滴露研。\n学字不工空费纸，吟诗虽苦未成编。\n赠君携去薇花畔，草诏闲时枕匣眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题花片","author":"许棐","text":"一片落花题一字，凑成一首怨春诗。\n纵横贴在窗纱上，巧似回文织锦时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄衣曲","author":"许棐","text":"芦花风紧雁飞飞，便寄边衣也是迟。\n妾把剪刀犹觉冷，况君披甲枕戈时。\n愿君百战图勋业，馘项歼嬴频献捷。\n博取貂蝉金印归，无负君王无负妾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画眉曲","author":"许棐","text":"日印花枝欲满窗，旋磨鸾镜试新妆。\n恩情只似春宵短，眉黛空如柳叶长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿闲林步","author":"许棐","text":"山禽栖定涧蛙鸣，时复鸱枭杂数声。\n昨夜酒添春睡重，幸无憎爱到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫女词","author":"许棐","text":"妍丑三千众，恩情一例轻。\n妾身虽寂寞，天下却升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真珠园","author":"许棐","text":"芭蕉叶上题诗字，雨后来看半不全。\n馀湿未胜浓墨补，且携卮酒到花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖边","author":"许棐","text":"湖边开到木芙蓉，攘尽荷花十里红。\n红蓼莫惭颜色浅，荣枯同是一秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读南岳新稿","author":"许棐","text":"春来游未遍湖山，已是风光一半残。\n细把刘郎诗读后，莺花虽好不须看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花","author":"许棐","text":"墙头新露一枝红，压尽隋人万綵工。\n香艳便栖云鬓老，也胜飘泊晚西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别友","author":"许棐","text":"分付离觞莫满斟，酒深还与恨同深。\n自怜不及春江燕，一路相随伴好吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"不语僧","author":"许棐","text":"默坐蒲龛若塑成，客来惟听小钟鸣。\n却嫌庭树无禅力，时有风枝雨叶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孔海翁","author":"许棐","text":"鉴湖湖上寄闲身，好景应同贺监分。\n梅下有船供载雪，荷边无地可锄云。\n吟人多倩删诗稿，名士争求作序文。\n画卷书编藏满屋，其他生计尽输君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题县楼呈丘竹坡","author":"许棐","text":"令君聊试栋梁材，结就谯楼亦壮哉。\n疑是海宫新涌出，不然仙府乍移来。\n无人敢带私心入，万户皆知正道开。\n细数代瓜能几日，晓筹昏鼓莫相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题竹坡","author":"许棐","text":"郭外移来费俸金，几年抬举玉成林。\n更无馀地栽闲树，尽有高枝著卧禽。\n寒影似传东野貌，清声如写伯夷心。\n呼童少杀青瑶简，染月濡云寄我吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数椽","author":"许棐","text":"数椽茅屋傍林塘，幽似山僧独住房。\n夜静只凭猿守宅，昼闲时有鹤升堂。\n旋收落叶供茶爨，细捣枯花作印香。\n书册满床诗满橐，别无生计亦何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送友人为僧","author":"许棐","text":"知心朋友云霄里，三尺官绫取不难。\n禅衲乍披身愈瘦，儒冠新脱顶微寒。\n数编诗稿聊收起，一藏经文旋取看。\n惟我尘缘推不去，萧萧华发倦渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"地炉","author":"许棐","text":"穴地为炉了一寒，肉屏毡帐任无缘。\n晨烧树下沾霜叶，夜煮山头泻月泉。\n已借阳和归故絮，更分光焰到残编。\n百年贫富灰埃尽，荒冢累累野烧边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪","author":"许棐","text":"东风吹雨作花飞，寒勒芳程几日迟。\n惟有庭前老梅树，谢渠添补落残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽沈晏如","author":"许棐","text":"不信诗人一例穷，如公半世又成空。\n湖边便欠寻梅友，篱下应无采菊翁。\n雪片堆平闲药灶，雨声敲碎旧渔篷。\n墓铭吟稿儿封寄，血泪斑斑浣纸红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠相士","author":"许棐","text":"涧水溪冰似镜清，自看寒貌已分明。\n烦君别相江湖友，来岁谁魁淡墨名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈裕斋墨戏","author":"许棐","text":"临帖钞书外，尤深破墨工。\n万峰千嶂趣，片纸尺绡中。\n云暗孤村月，潮生满树风。\n自嫌吾已老，摩砚一无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题吴秋潭隐居图","author":"许棐","text":"到处有茅堪盖屋，谁家迁槿不成篱。\n秋潭何事经营晚，应是无人会买诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题摩云","author":"许棐","text":"老松阴下访摩云，仰望青云隔几尘。\n不是倚空梯百尺，只缘中有道高人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田间","author":"许棐","text":"田间久不到，草木半萧疏。\n鸥占沉舟浴，蛩分破壁居。\n仆温携到酒，邻送卖残蔬。\n未说催租事，黏窗且读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题野处","author":"许棐","text":"数亩家园枕碧波，树桑疏处补花窠。\n檐低不碍儒冠入，桥矮才通钓艇过。\n云笛旋裁门外竹，雨衣新织槛前莎。\n有时牛背看书罢，一曲春风宁戚歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孙祺卿新居","author":"许棐","text":"几年铢累束脩钱，才向湖边置一廛。\n种竹庭深难得月，养鱼池小易为泉。\n山呈好画当书案，柳撒轻丝罩钓船。\n酒力半酣诗思倦，矮床相对白鸥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招高菊涧","author":"许棐","text":"归买秦溪屋一间，才如都下僦楼宽。\n门前养草如花赏，壁上黏碑当画看。\n自改旧诗多未稳，独斟新酒不成欢。\n髯仙只在渊明宅，泥泞相邀寸步难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李明府雪中小阅","author":"许棐","text":"令君蒙雪教千兵，一点妖氛不敢生。\n和气旋回弓力软，寒光微映剑花明。\n民居似倚银城壮，海道如铺玉簟平。\n入蔡归来方夜半，画堂歌管未收声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西真图","author":"许棐","text":"翠水池边宴早秋，云谣声里月西流。\n醉归不信乘鸾稳，却擘莲花作采舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书北庵门","author":"许棐","text":"十度来敲九不应，隔篱空见竹青青。\n不知池里黄金鲫，听讲楞伽几卷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠术士张痴","author":"许棐","text":"伶俐不如痴，从来我亦知。\n才吟诗好日，便是命穷时。\n鼠笑瓶无粟，蜗嫌壁有碑。\n五行修得否，髭鬓已丝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢毓斋李尚书惠诗序","author":"许棐","text":"绿野堂边种药成，已斑髭鬓复青青。\n谢庭子弟皆英物，汉殿公卿半学生。\n争捧溪藤求妙画，竞磨崖石乞新铭。\n如何海角孤吟者，文集中间也挂名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶充斋","author":"许棐","text":"歙浦租船只载诗，一廉如此似君稀。\n双亲犹道行装重，多带罗纹一砚归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赵子固春山上寺图","author":"许棐","text":"望得招提见，程犹半日间。\n马嘶曾到处，仆指未行山。\n风递松声远，云连草色闲。\n何如添个我，坐石听潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送写神李肖岩入道","author":"许棐","text":"一掣尘缘去学仙，鹤程风露渐高寒。\n白玉楼中逢鼻祖，为传吟貌寄予看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵仓","author":"许棐","text":"麾节交迎出帝城，满朝皆羡板舆荣。\n一州暂辍春风暖，八郡同瞻霁月明。\n吴苑莺花新管领，秦溪桃李旧生成。\n应怜倦卧寒窗者，煮药炉边听雪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵子梁","author":"许棐","text":"梅福舟行速，离觞不暇斟。\n虽然交日浅，颇觉别情深。\n宿处雁相伴，到时莺对吟。\n水心新冢下，替我一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得闲亭","author":"许棐","text":"柳风虽小丝丝袅，花雨无多点点香。\n惟有吟毫闲未得，染红濡绿一春忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题钱庆丰醒庵","author":"许棐","text":"不向杯中物，吟边仅有君。\n自无沉醉分，非效独醒人。\n捲箔进明月，开门放宿云。\n拣茶敲未遍，又摘露芽春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽周倅","author":"许棐","text":"真是分风月，归来无俸钱。\n人皆嗤拙宦，天又啬长年。\n旧宅寒潮外，新茔古树边。\n一诗哀不尽，檐雨对潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上赵兰坡","author":"许棐","text":"身迫云霄自不知，只如师友讲论时。\n驱龙驾凤阳冰字，剪月裁霞太白诗。\n雨院炷香熏画卷，晴窗添水浸花枝。\n十年漫走江湖上，只尺兰坡却到迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上嘉禾赵守","author":"许棐","text":"邦君一念只宽民，真个龚黄现后身。\n和气蒸为千耒雨，暖云裁作万襦春。\n座中长有清吟客，庭下浑无健讼人。\n诸郡尽能依此样，世间那有一家贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剑言","author":"许棐","text":"朝润郅支膏，暮泽楼兰血。\n何如沉土中，蚀为无用铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题常宣仲草堂","author":"许棐","text":"隔市能几步，幽趣踰山林。\n凿池小如斗，水浅鱼自深。\n檐任树枝碍，阶从草色侵。\n不肯一锄斫，恐伤春风心。\n朝出货仁义，暮归炊古今。\n客来无可款，石炉添水沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张俞仲竹屋","author":"许棐","text":"削成千蠹简，此屋是馀材。\n长有清风至，浑无俗客来。\n猿当吟案立，鹤趁钓船回。\n添足岁寒计，栽松复种梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李方庵款梅","author":"许棐","text":"梅花惆怅三年别，香锁空庭几风月。\n今年花发主人归，依旧主人贫彻骨。\n小枝分立砚屏边，无酒酬春烛焰寒。\n数叶残书翻未了，唤起山童敲凤团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐府 其二","author":"许棐","text":"小窗寒烛夜，结纽缀郎襟。\n不结寻常纽，结郎长远心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题舒王游半山图","author":"许棐","text":"驴载新诗仆抱书，松声禽语当传呼。\n不知邂逅耕田者，问著青苗免役无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题钱叔恭立斋铭后","author":"许棐","text":"拄义撑仁难著脚，十人著脚九斜攲。\n此铭不特为君助，今古儒家砥柱碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"旧渔竿","author":"许棐","text":"掣断江湖几线风，蓑衣闲挂饵瓢空。\n何因献入君王手，持向磻溪钓太公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草屦","author":"许棐","text":"江湖蓑笠旧交情，石滑泥深步转轻。\n恰是革华踪迹险，宦程高处越难行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠刘相士","author":"许棐","text":"满镜秋霜鬓影寒，此生堪笑复堪怜。\n烦君只相看书眼，更对青灯得几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宗之惠梅窠水玉笺","author":"许棐","text":"百幅吴冰千蕊雪，对吟终日不成诗。\n忆君同在孤山下，商略春风弄笔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月涧惠砚滴梅脑 其一","author":"许棐","text":"手不题诗已数年，砚砖相伴学枯禅。\n为君蘸湿玄晖笔，写出江山雪后天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月涧惠砚滴梅脑 其二","author":"许棐","text":"踏雪寻梅兴未偿，衣襟赖有隔年香。\n铜?更炷冰花脑，不到孤山也不妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春思","author":"许棐","text":"嫁得萧郎不恋家，几年流落在天涯。\n满怀多少伤春事，嫌杀门前叫卖花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵丞","author":"许棐","text":"竹梢风露松梢月，未抵吟丞气味清。\n笑问两年何所得，锦囊诗重俸囊轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠墨僧","author":"许棐","text":"老砚磨穿事不成，万书堆里鬓星星。\n愿随君去柯山下，收拾残烟写佛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重阳乏酒","author":"许棐","text":"黄花冷笑竹篱边，笑我床头乏酒钱。\n带雨折来无用处，碎挼金屑和茶煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烛","author":"许棐","text":"长身夜占银台立，焰焰光摇顶上珠。\n贪向华堂照歌舞，不知灰得寸心无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代术者言","author":"许棐","text":"不闻沸鼎烹夷叔，那有云台画四凶。\n自与心君消息了，却将甲乙问穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠钱相士","author":"许棐","text":"我貌君容一种寒，鹭漂鸥泊廿来年。\n我诗吟就无人买，君相公卿煞得钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观松岩画卷","author":"许棐","text":"老屐相随四十年，惯看苍翠听潺湲。\n今朝细玩松岩画，犹有吟行未到山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江道中","author":"许棐","text":"一别吴松二十秋，败荷枯柳总新愁。\n白头交友凋零尽，赖有寒江几个鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]