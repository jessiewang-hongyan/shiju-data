[{"title":"竹枝歌 其八","author":"苏辙","text":"去家千里未能归，忽听长歌皆惨悽。\n空船独宿无与语，月满长江归路迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹枝歌 其九","author":"苏辙","text":"路迷乡思渺何极，长怨歌声苦凄急。\n不知歌者乐与悲，远客乍闻皆掩泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其三 坐","author":"李吕","text":"春尽。\n敛新闷。\n暗傍银屏撩绿鬓。\n攒眉不许旁人问。\n帘外冷红成阵。\n银釭挑尽睡未肯。\n肠断秦郎归信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑转踏 其一","author":"郑仅","text":"归去。\n携笼女。\n南陌采桑三月暮。\n使君春思如飞絮。\n五马徘徊频驻。\n蚕饥日晚空留顾。\n笑指秦楼归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑转踏 其五","author":"郑仅","text":"春艳。\n桃花脸。\n笑倚银屏施宝靥。\n良人少有平戎胆。\n归路光生弓剑。\n青楼春永香帏掩。\n独把韶华都佔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑转踏 其七","author":"郑仅","text":"肠断。\n浙江岸。\n楼上青帘新酒软。\n吴姬绰约开金盏。\n的的娇波流盼。\n采菱歌罢行云散。\n望断侬家心眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑转踏 其十","author":"郑仅","text":"时节。\n白云阙。\n洞里春情百和爇。\n兰心底事多悲切。\n消尽一团冰雪。\n明皇恩爱云山绝。\n谁道蓬莱安悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑集句 其一","author":"无名氏","text":"千里。\n楚江水。\n明月楼高愁独倚。\n井梧宫殿生秋意。\n望断巫山十二。\n雪肌花貌参差是。\n朱阁五云仙子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑集句 其二 桃源","author":"无名氏","text":"相误。\n桃源路。\n万里苍苍烟水暮。\n留君不住君须去。\n秋月春风閒度。\n桃花零乱如红雨。\n人面不知何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑集句 其四 明妃","author":"无名氏","text":"相忆。\n无消息。\n目断遥天云自白。\n寒山一带伤心碧。\n风土萧疏胡国。\n长安不见浮云隔。\n纵使君来争得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑集句 其七 吴娘","author":"无名氏","text":"无处。\n难轻诉。\n锦瑟华年谁与度。\n黄昏更下潇潇雨。\n况是青春将暮。\n花虽无语莺能语。\n来道曾逢郎否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑 其三 盼盼","author":"毛滂","text":"无力。\n倚瑶瑟。\n罢舞霓裳今几日。\n楼空雨小春寒逼。\n钿晕罗衫烟色。\n帘前归燕看人立。\n却趁落花飞入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑 其五 灼灼","author":"毛滂","text":"憔悴。\n何郎地。\n密寄软绡三尺泪。\n传心语眼郎应记。\n翠袖犹芳仙桂。\n愿郎学做蝴蝶子。\n去去来来花里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑 其六 莺莺","author":"毛滂","text":"何处。\n长安路。\n不记墙东花拂树。\n瑶琴理罢霓裳谱。\n依旧月窗风户。\n薄情年少如飞絮。\n梦逐玉环西去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑 其七 苕子","author":"毛滂","text":"芳草。\n恨春老。\n自是寻春来不早。\n落花风起红多少。\n记得一枝春小。\n绿阴青子空相恼。\n此恨平生怀抱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其五 破子","author":"曾慥","text":"花好。\n被花恼。\n庭下嫣然如巧笑。\n曾教健步移根到。\n各是一般奇妙。\n赏心乐事知多少。\n乱插繁华晴昊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其六 破子","author":"曾慥","text":"酒美。\n直无比。\n小瓮新醅浮玉蚁。\n空传乌氏并程氏。\n不数云安麴来。\n十花更互来相对。\n常伴先生沉醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送菊","author":"胡铨","text":"卧病高秋留海浦，明日重阳更风雨。\n杜门不出长苍苔，令我天涯心独苦。\n篱角黄花亲手栽，近节如何独未开。\n含芳閟采亮有以，使君昨暮徵诗来。\n凌晨试遣霜根送，畚土虽微甚珍重。\n极知无意竞秋光，往作横窗岁寒供。\n忆我初客天子都，西垣植此常千株。\n结花年年应吹帽，始信南邦事尽殊。\n愿得封培自今日，何间朱崖万家室。\n秋香端不负乾坤，但嗔箫管乱畴匹。\n归去来兮虽得归，念归政自莫轻违。\n他日采英林下酌，谁向清霜望翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游南台闽粤王庙","author":"詹体仁","text":"海角钓龙人杳杳，云间待雁路迢迢。\n若为借得山头石，每到商秋坐看潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中观妓","author":"王氏","text":"梁王宴罢下瑶台，窄窄红靴步雪来。\n恰似阳春三月暮，杨花飞处牡丹开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天马峰","author":"范郁","text":"惆怅孙阳世久无，纷纷驽骥逐齐驱。\n不教神物俱湮灭，犹幸深山天马图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村行","author":"王炎","text":"青山护村落，暗水通沟渠。\n人行禾黍间，漫漫迷所之。\n里社压新醪，击鲜赛丛祠。\n田父相劳苦，雨旸无失时。\n龙骨挂屋敖，秋熟可预期。\n行行度岗涧，泉石多幽奇。\n微风发清籁，好鸟吟高枝。\n此中有佳趣，岂无幽人知。\n去住两不可，空吟招隐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李隐卿名谷与青城刘翁同舟至兰溪卿大夫修生者馆之道侣赠李诗云李郎涉世似虚舟片帆来渡楚江秋之句又毗陵家弟季文和此篇云梦蝶岂知真是蝶骑牛何必更寻牛老夫亦慕道者次韵和之记刘李事迹刘本书生工诗奇异飘然尘外也","author":"苏籀","text":"白公枉识郭虚舟，刘李飞符袒剑裘。\n兴轶壶中身混世，气酣酒里意横秋。\n运调朱凤啄白石，耕莳金钱掣牯牛。\n赤子返真标指妙，阿伽陀药肯言不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄答张五丈师夔明府","author":"张颉","text":"旧令龙溪有去思，移家喜与土风宜。\n人传张籍妙乐府，我识王维真画师。\n火米夏收畬稻早，海椒春放瘴花迟。\n客查不到天无雁，赖有輶轩可寄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无碍泉","author":"李弥大","text":"瓯研水月先春焙，鼎煮云林无碍泉。\n将谓苏州能太守，老僧还解觅诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苔梅 其一","author":"李龙高","text":"一夜蟠龙裂翠鳞，土花深护玉精神。\n苍寒满树黄昏月，碧老孤根太古春。\n姑射香薰荷制好，逋仙青入草衣新。\n料应不为天风冷，自恐冰肌受点尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李公麟阳关图二绝 其二","author":"苏辙","text":"西出阳关万里行，弯弓走马自忘生。\n不堪未别一杯酒，长听佳人泣渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河上莫归过南湖二绝 其二","author":"苏辙","text":"淤田水浅客来迟，解舫都门问几时。\n谁道两京鸡犬接，差除屈指未曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钓台 其二","author":"陈畴","text":"故人已了中兴事，赢得溪头一钓竿。\n唤起先生同一笑，青山自在白云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李成画","author":"米芾","text":"画号为真理或然，悠悠觉梦本同筌。\n殷勤封向青山去，要识江东李谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月旦作时立夏已十馀日","author":"陆游","text":"京尘相值各匆忙，谁信闲人日月长。\n争叶蚕饥闹风雨，趁虚茶懒斗旗枪。\n林中晚笋供厨美，庭下新桐覆井凉。\n堪笑山家太早计，已陈竹几与藤床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陇头泉","author":"张元干","text":"少年时，壮怀谁与重论。\n视文章、真成小技，要知吾道称尊。\n奏公车、治安秘计，乐油幕、谈笑从军。\n百镒黄金，一双白璧，坐看同辈上青云。\n事大谬，转头流落，徒走出修门。\n三十载，黄粱未熟，沧海扬尘。\n念向来、浩歌独往，故园松菊犹存。\n送飞鸿、五弦寓目，望爽气、西山忘言。\n整顿乾坤，廓清宇宙，男儿此志会须伸。\n更有几、渭川垂钓，投老策奇勋。\n天难问，何妨袖手，且作闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼","author":"杨亿","text":"危楼高百尺，手可摘星辰。\n不敢高声语，恐惊天上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀寄刘五","author":"杨亿","text":"世事悠悠未遽央，虚名真意两相忘。\n休誇失马曾归塞，未省牵牛解服箱。\n四客高风惊楚汉，五君新咏弃山王。\n秋来安有渔樵梦，多在箕峰颍水傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"杨亿","text":"眼中是面前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杨亿","text":"峭帆横渡官桥柳，叠鼓警飞海岸鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上许州吕相公嗣崧许康诗二首并序 其一 嗣崧诗","author":"宋祁","text":"彼岳惟崧，天作其神。\n嗣生我公，我公斤斤。\n嘉猷矢陈，柄国之均。\n帝亲命之，纂成前人。\n不显其道，惟申是保。\n公迈厥德，祗祗翼翼。\n柔嘉而直，模我彝伦。\n揉我方国，施于夷貊。\n百度是毗，庶绩允熙。\n罔敢不恪，惟公是若。\n帝诏执事，彻申土疆，衍沃腴良。\n赋舆溱溱，莫乐于申。\n昔在四岳，佑尧象禹，为国心膂。\n受民作邦，于今以光。\n帝告于公，绍胥尔宇。\n宪是文武，如申如甫，为周之辅。\n诞锡尔祉，惟申甫是似。\n乘车错衡，淑施英英，式遄其荣。\n公拜稽首，敢扬王休。\n祈天之久，为天子万寿。\n彼岳磐磐，松柏丸丸，公福禄实蕃。\n有崇而冈，有大而陵，公寿考是承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上许州吕相公嗣崧许康诗二首并序 其二 许康诗","author":"宋祁","text":"许丽而康，岳孙奠之。\n曰公之屏，实维似之。\n公徒增增，朱綅绿縢。\n不戁不惊，钩膺镂锡。\n称娖颜行，哕焉绥章。\n总我列侯，式时南疆。\n公之相攸，孔乐于许。\n其原膴膴，其川吁吁。\n有芃禾麻，有京稷黍。\n薮焉麋麇，渚焉鲂鱮。\n有李有桃，有柘有檀。\n树我之园，令居则安。\n公视于庭，师兵翼翼，孔武有力。\n公适于府，陪卿髦士，罔不就绪。\n公宴于堂，嘉宾我从。\n琴瑟鼓钟，或揳或摐。\n静好铿锵，万舞有容。\n左拂其殽，炰鳖燔羔，给鲜于庖。\n右烹其蔌，笋菭蒲菹，柔嘉惟馥。\n旨酒且多，其饮温克。\n摄尔攸仪，侑公宴嬉。\n俾胖而乐，俾艾而耆。\n明明天子，股肱一体。\n于蕃于宣，邦人咸喜。\n主芣之山，浚■之渠。\n弗童而材，弗竭而渔。\n皇惠斯人，俾公焉依。\n公报其成，帝曰还归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀三封墅 其二","author":"宋祁","text":"三封何所怀，怀我东南亩。\n方春原田秀，是时簦笠聚。\n杏花灿晴落，菖叶甲阴浦。\n泱泱云抱岑，眇眇林鸣扈。\n野老携晨馌，薄醪间炊黍。\n安知五熟滋，但慰四友苦。\n日作夕还家，烟火青林下。\n嗟我仕易稼，穷年宦三辅。\n誓毕尚生累，将从平子赋。\n自省非大人，请事学农圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到郡斋 其二","author":"宋祁","text":"省分由来拙，操心本自危。\n十年今得调，三匝此逢枝。\n攘臂贪丰粟，装怀倦诉词。\n竹林谁见忆，迢递始平麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归沐","author":"宋祁","text":"弥旬出沐道山头，僦庑萧萧避世游。\n枉是胸中存垒块，可能皮里有阳秋。\n驾车款段惭乡品，托乘鸱夷笑客愁。\n曲突不黔宾坐冷，时闻庭雀一啁啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自咏 其二","author":"宋祁","text":"上都频见岁华阴，偃息由来本茂林。\n醉若有乡须裂地，吏如逢隐即投簪。\n衔无窭数知容冗，病似支离亦挫针。\n况自疏家兄弟约，他年擉鳖故溪浔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自咏 其三","author":"宋祁","text":"误怀手版应弓招，汩汩尘容葆鬓凋。\n潘拙本无乡曲誉，嵇驽偏恃母兄骄。\n雨畦菘叶晨羞薄，风灶茶烟午睡销。\n纵到北山堪自笑，春萝秋桂久寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"守塞三年上北京留守贾相公 其二","author":"宋祁","text":"雨洗星街夜祲空，暂持鱼牧守离宫。\n皋陶旧曲明良内，郤縠高谈礼乐中。\n载笔后车云盖密，鸣铙前队锦褠红。\n不妨华发千官上，始称凌烟第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酴醾","author":"宋祁","text":"来自蚕丛国，香传弱水神。\n析酲疑破鼻，并艳欲留春。\n勿以媚兰味，误沾韩寿巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王君贶禁中寓直","author":"宋祁","text":"长乐疏钟断，昆池夕照收。\n晚风生似雨，仙雾爽如秋。\n钧曲来深殿，宫花出御沟。\n云天正如画，璧月在西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比日","author":"宋祁","text":"比日投簪隐，盂峰列舍椽。\n值岩因作牖，仍涧即疏泉。\n斧烂仙棋路，花飞佛雨天。\n谏帷他夜梦，犹在翠微巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俊上人游山","author":"宋祁","text":"股锡飘然指上方，翠微岩腹掩鹰房。\n江山极睇才多助，竿木投机戏有场。\n麝墨洗馀池溜变，玉瓷清极茗华香。\n秋风莫负重来约，净社霜莲遍碧塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十五","author":"宋祁","text":"于今尚未好，漠漠宜秋雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庄献太后哀挽应制二首 其一","author":"宋祁","text":"宝慈垂母训，一纪御璿除。\n地有占沙旧，天仍补石馀。\n轩星沦夕纬，翟辂去宸居。\n异日金縢启，方知复辟书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庄献太后哀挽应制二首 其二","author":"宋祁","text":"旰仄身无惮，寒暄疾有加。\n灾生纤女□，魂断濯龙车。\n廞翣浮辰旭，边箫咽暝霞。\n唯留长乐注，刊羡在皇家。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庄惠太后挽歌应制二首 其一","author":"宋祁","text":"妫幄柔明训，尧闱保卫贤。\n别居长乐寝，让给水衡钱。\n谨疾方加膳，收神亟去仙。\n宸襟增服纪，追报焕终天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庄惠太后挽歌应制二首 其二","author":"宋祁","text":"昔帝推嫔则，吾君赖母慈。\n陪陵汉家葬，异室閟宫祠。\n露暗星轩隐，天愁月御移。\n翟车参享路，无复庙中期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿曾相公","author":"宋祁","text":"翼藏三朝冕有蝉，归来今作地行仙。\n且开金阙萧何地，未泛江湖范蠡船。\n老境己怜周吕尚，庆门方似汉韦贤。\n一杯不足为公寿，愿赋长鲸吸百川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行路难","author":"范成大","text":"赠君以丹棘忘忧之草，青棠合欢之花。\n马瑙游仙之梦枕，龙综辟寒之宝纱。\n天河未翻月未落，夜长如年引春酌。\n昔人安在空城郭，今夕不饮何时乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读唐太宗纪 其二","author":"范成大","text":"弟兄相贼斁天伦，自古无如舜苦辛。\n掩井捐阶危万死，不闻亲杀鼻亭神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读唐太宗纪 其三","author":"范成大","text":"佐命诸公趣夜装，争言社稷要灵长。\n就令昆季尸神器，未必唐家便破亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读唐太宗纪 其四","author":"范成大","text":"建成回马欲驰归，元吉行趋武德闱。\n若使两人俱得去，却于何处极兵威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读唐太宗纪 其五","author":"范成大","text":"嫡长承祧有大伦，老公爱子本平均。\n只知世上寻常理，争信英雄解灭亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重读唐太宗纪 其二","author":"范成大","text":"承乾谋父保天年，青雀图兄亦两全。\n隐刺诸儿却孥戮，一私知隔几山渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重读唐太宗纪 其三","author":"范成大","text":"更张聊欲亢吾宗，仁孝承家合至公。\n天发杀机那可料，正投阿武祸胎中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古风上知府秘书二首 其二","author":"范成大","text":"大鹏上扶摇，南溟聒天沸。\n斥鴳有羽翼，意满蓬蒿里。\n不如附骥蝇，掣电抹荆蓟。\n谁云极么么，俛仰且万里。\n向来庭户间，决起不踰咫。\n飘飖托方便，意气乃如此。\n物生未可料，旦暮倘逢世。\n君看功名场，得失一交臂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵马少伊木犀 其二","author":"范成大","text":"水尾山腰树影苍，一天风露不供香。\n谁家镜里能消得，付与诗人古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵马少伊木犀 其三","author":"范成大","text":"密密娇黄侍翠舆，避风遮日小扶疏。\n画阑想见悬秋晚，无限宫香总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明日大雨复折赠再次韵","author":"范成大","text":"一天云叶翳朝霞，风卷泥沾不惜花。\n群玉山高春好在，人间烟雨暗千家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]