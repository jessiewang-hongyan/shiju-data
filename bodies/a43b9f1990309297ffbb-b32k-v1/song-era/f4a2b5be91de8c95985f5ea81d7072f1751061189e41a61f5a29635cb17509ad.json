[{"title":"虞美人 见梅","author":"方岳","text":"鸥清眠醉晴溪月。\n几梦寒蓑雪。\n断桥篱落带人家。\n枝北枝南初著、两三花。\n曾于春底横孤艇。\n香似诗能冷。\n娟娟玉立载归壶。\n渺渺愁予肯入、楚骚无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 其二 辛丑生日小尽月","author":"方岳","text":"今朝廿九，明朝初一。\n怎欠秋崖个生日。\n客中情绪老天知，道这月、不消三十。\n春盘缕翠，春缸摇碧。\n便泥做、梅花消息。\n雪边试问是耶非，笑今夕、不知何夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 其一 七夕送荷花","author":"方岳","text":"银河无浪，琼楼不暑。\n一点柔情如水。\n肯捐兰佩了渠愁，尽闲却、纤纤机杼。\n波心沁雪，鸥边分雨。\n剪得荷花能楚。\n天公煞自解风流，看得我、如何销汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月 其六 和君用","author":"方岳","text":"槎牙诗骨，想生来无分，史闱经幄。\n呵护九关多虎豹，谁道去天一握。\n奏赋两都，闻韶三月，雁远书难托。\n一寒如许，蟾枝莫倚高擢。\n空使满壑风烟，半村雪月，孤负梅花约。\n渺渺愁予初度也，山冱同云垂幕。\n鹤帐何如，牛衣无恙，麦陇占优渥。\n不如归去，檐花深夜春酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月 寿松山主人七月十九日","author":"方岳","text":"楚天秋早，过中元拈指，蓂飞四荚。\n怪得千门佳气满，恰值生申时节。\n蓬矢当年，椒盘今夕，瑞木金炉爇。\n主人情重，酒红潮上双颊。\n且看戏彩□□，鼎分丹桂，兰玉同班列。\n更喜萱庭南极老，亲授长生秘诀。\n养浩颐然，后昌青紫，天报公阴德。\n年年盛会，祝延椿算千百。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 其二 八月十四，小集郑子重帅参先月楼。是夕无月和朱希真插天翠柳词韵","author":"方岳","text":"绿尊翠勺，约秋风、一醉小楼先月。\n谁取宝奁奔帝所，深锁玉华宫阙。\n老桂香寒，疏桐云重，生怕金蛇掣。\n那知天柱，一峰别与天接。\n我欲飞佩重游，寘之衣袖，照我襟怀雪。\n玉斧难藏修月手，待做明宵清绝。\n天地无尘，山河有影，了不遗毫发。\n举杯相属，唤谁笺与天说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月 其三 寿老父","author":"方岳","text":"幅巾云麓。\n笑人生瓮等，何时是足。\n莫道年来无好处，第一秫田新熟。\n孙息乘鸾，大儿荐鹗，翁已恩袍绿。\n笑谭戎幕，尽教岳也碌碌。\n是则江南江北，月明飞梦，认得溪桥屋。\n多少睡乡闲日月，不老柯山棋局。\n唱个曲儿，吃些酒子，检点茅檐竹。\n问梅开未，一枝初破寒玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 其四 戊戍寿老父","author":"方岳","text":"且拌春醉。\n问人间、谁是十分如意。\n道不好来人又道，也有一分好处。\n管甚长贫，只消长健，切莫眉头聚。\n尽教江路，梅花依旧留住。\n儿辈虽不如人，有何不可，怎敢嫌迟暮。\n但喜吾翁躔度转，唤起烟霞深痼。\n否极而亨，剥馀而复，长至迎初度。\n龟图羲画，直从今日重数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 其一 梦雪","author":"方岳","text":"问天何事，雪垂垂欲下，又还晴却。\n春到梅梢香逗也，尽有心情行乐。\n剡曲舟回，灞桥诗在，一笑人如昨。\n此情分付，暮天寒月残角。\n谁道飞梦江南，群山如画，一一琼瑶琢。\n中有玉田三万顷，云是幼舆丘壑。\n招我归来，和春醉去，休跨扬州鹤。\n万花曾约，酒醒当有新作。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月 其五 万花园用朱行父韵呈制帅赵端明","author":"方岳","text":"花风初逗，喜边亭依旧，春闲营柳。\n烟草隋宫歌舞地，谁遣万红围绣。\n结酒因缘，装春富贵，也要经纶手。\n笙箫声里，一江晴绿吹皱。\n是处羽箭如飞，那知鹤府，花压阑干昼。\n油幕文书谈笑了，馀事尽堪茶酒。\n报答东风，流连西日，绿外沈吟久。\n与春无负，醉归香满襟袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月 其七 送吴丞入幕","author":"方岳","text":"祈山底处，为二松千竹，肯题崖壁。\n雪洒谈犀麾雁鹜，尔辈何烦涉笔。\n使者知乎，民其劳止，且莫闲耕织。\n片言金石，唤回春意无极。\n虽则王谢人家，一癯仙泽，面作苍烟色。\n茶灶笔床将雨屐，吟到梅花消息。\n贱子何为，老仙如问，莫道头今白。\n寒蓑几梦，研朱看点周易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三","author":"方岳","text":"秋水涵空如镜净。\n满镜清寒，倒碧摇山影。\n药户谁抨圆玉静。\n碧纱人怯黄昏醒。\n丛桂小山寒井井。\n唤起江南，一叶莼鲈兴。\n先自新愁愁夜永。\n不堪宋□重提省。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"方岳","text":"山抹修眉横绿净。\n浦溆生寒，立尽梧桐影。\n香灺未消帘幕静。\n醉红如洗风吹醒。\n一夜秋声连玉井。\n梦落孤篷，已尽山阴兴。\n戍角凄凉清漏永。\n江南烟雨何堪省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一 用韵秋怀","author":"方岳","text":"雁落寒沙秋恻恻。\n明月芦花，共是江南客。\n骑鹤楼高边羽急。\n柔情不尽淮山碧。\n世路只催双鬓白。\n菰菜莼羹，正自怜人忆。\n归梦不知江水隔。\n烟帆飞过平如席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"方岳","text":"一钱太守今贪吏，五柳先生歙富民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"方岳","text":"林暝鸟呼雨，径深童扫云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙津亭","author":"方武子","text":"龙津亭下水漫漫，坐久凝神杳霭间。\n说道浙江人不信，向南全似越州山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南中题壁","author":"方武子","text":"明月照齐州，玉龙栖欲起。\n壮士肠夜回，寒衾泼秋水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王大令移需岩王隐居手植木樨于郡庭赋诗以赠和黄通判韵","author":"方蘋","text":"分将翠色来雩邑，翛尔清风植府庭。\n先生高卧何由见，想在渔州弄紫萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十贤祠","author":"方信孺","text":"晋唐相望已千年，香火如今数十贤。\n不见古人空再拜，祠堂西去有贪泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三城","author":"方信孺","text":"三城不断郁相望，千里长江势渺茫。\n蛮獠传闻亦胆破，从知岭外有金汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三教殿","author":"方信孺","text":"大道茫茫鼎峙分，个中谁为破重籓。\n须知问礼当时地，不必西方两足尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义宁华岩洞和纯阳真人 其二","author":"方信孺","text":"跨鹤曾来不记年，洞中流水绿依然。\n紫箫吹彻无人见，万里西风月满天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"义宁华岩洞和纯阳真人 其一","author":"方信孺","text":"岩前绿水无人渡，洞里碧桃花正开。\n东望蓬瀛三万里，等閒飞去等閒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大小水帘洞","author":"方信孺","text":"碧涧东西春水添，四时疏雨落晴檐。\n珠宫贝阙无寻处，空见重重排玉帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大通寺","author":"方信孺","text":"老木槎牙欲擘云，门前流水我知津。\n过江一雨如盆泻，竞礼真如不动身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广平堂","author":"方信孺","text":"撤茅易瓦利无穷，盍种甘棠比召公。\n大手断碑何处觅，典型犹见此堂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞来殿","author":"方信孺","text":"嵯峨古殿记飞来，千古传闻亦怪哉。\n龙象渐随尘土化，却疑神物欲飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马蛟山","author":"方信孺","text":"耆老相传亦可嗟，深山大泽自龙蛇。\n老蛟变化初何怪，天马从来产渥洼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马鞍山","author":"方信孺","text":"堑山堙谷浪为谋，馀力犹穷岭外洲。\n见说揭竿从垄上，祖龙当日漫东游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五仙观","author":"方信孺","text":"蹁跹天上五仙人，羊驾何年到海滨。\n晋汉相传半无有，观中遗石自轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤皇台","author":"方信孺","text":"凤去台空岁月更，百年陈迹埽榛荆。\n清时已庆三登瑞，盍向朝阳更一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王登洲","author":"方信孺","text":"四渎初分有物尸，天开地辟共为期。\n齐东野语真堪笑，请诵昌黎十丈碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东七寺","author":"方信孺","text":"慈度天王更觉华，苍龙东角梵王家。\n普慈化乐成尘土，兴圣犹兼觉性誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙涌山","author":"方信孺","text":"龙伯何年钓巨鳌，两峰漂荡入洪涛。\n人间灵迹无寻处，仙涌罗浮相对高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卢循河南故城","author":"方信孺","text":"蛙据方州妄自尊，沈郎百万若云屯。\n归舟无路寻巢穴，空有卢亭旧子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甘溪","author":"方信孺","text":"甘溪依约旧城东，陵谷迁移一梦中。\n春尽踏青人不见，桄榔老大木棉红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云洞","author":"方信孺","text":"金刹凭陵尺五天，胜游何必羡登仙。\n安期想见身千亿，汗漫人间若个边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石门","author":"方信孺","text":"吕嘉积石浪相传，双阙天开尚宛然。\n成败古来俱一梦，千秋何似老楼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石屏堂","author":"方信孺","text":"月峡旁通玉液池，綵舟争胜出宫闺。\n荒台今日人相问，野草无言日自西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙窟","author":"方信孺","text":"变化灵踪亦可疑，玲珑数穴似仇池。\n沧溟咫尺不归去，安得神龙如许痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙磨角石","author":"方信孺","text":"旧说神龙水底蟠，何年电掣与雷奔。\n至今舟子相呼唤，犹指江边石上痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任嚣城","author":"方信孺","text":"五星自是汉家符，忍死任嚣亦太愚。\n今日朝台犹百尺，荒城不记旧规模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任嚣墓","author":"方信孺","text":"枯坟曾阅几兴亡，行客徘徊古道傍。\n茅屋一间无处觅，可怜不似楚昭王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"众妙堂","author":"方信孺","text":"妙处常存道岂高，个中得意自陶陶。\n空堂寂寞丰碑在，观里何人复种桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘氏山","author":"方信孺","text":"一径萦纡夹粉墙，向来台馆化僧房。\n周遭老木依然在，曾见刘家伪帝王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘氏双阙","author":"方信孺","text":"双阙岧峣即是碑，天荒初破此娥眉。\n行人来往手加额，解说当年旌表时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘氏郊坛","author":"方信孺","text":"一德由来可享天，东邻牛祭亦徒然。\n荒凉到处游麋鹿，谁识郊坛八面圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘氏铜像","author":"方信孺","text":"霸业凄凉一炬休，铸金为像亦狂谋。\n五湖但说鸱夷子，千古谁知恩赦侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘王花坞","author":"方信孺","text":"绿阴到处小舟藏，浅水漂红五里香。\n不见芳华旧亭苑，桃花应解笑刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老人松","author":"方信孺","text":"上古轮囷说寿樗，何人玉斧斸霜腴。\n有知定见非凡物，盍作堂堂五大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西七寺","author":"方信孺","text":"文殊千佛显真乘，水月光中见定林。\n昭瑞当时连集福，咸池今日应奎参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西竺山广果寺","author":"方信孺","text":"小桥横绝两峰环，白日松风为掩关。\n天半楼台矗金碧，直疑海上普陀山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"达磨石","author":"方信孺","text":"葱岭初无一字传，名山到处即为禅。\n只今石上留公案，面壁何须更九年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沉香浦","author":"方信孺","text":"一饮千金事已非，那容更载此香归。\n若教到此方投去，早落人间第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沉犀潭","author":"方信孺","text":"西来异兽路应迷，金锁何年落此溪。\n不比李侯心似水，归舟自掷石门西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵化寺","author":"方信孺","text":"黄木湾前一亩宫，庙灵规地古来雄。\n江头不见风雷恶，多谢禅师受戒功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花山寺","author":"方信孺","text":"万花春老正红酣，不是丛林优钵昙。\n山下女郎来问讯，未饶萱草解宜男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花田","author":"方信孺","text":"千年玉骨掩尘沙，空有馀妍剩此花。\n何似原头美人草，樽前犹作舞腰斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净慧寺千佛塔","author":"方信孺","text":"九井神光射斗牛，天开宝级镇南州。\n客船江上东西路，常识嶙峋云外浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卓锡泉","author":"方信孺","text":"泉源无处不流通，隐显何关卓锡功。\n欲识海潮连地脉，祗今双蟹出泉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和光洞","author":"方信孺","text":"和光深洞隐昌期，门锁烟萝不可窥。\n欲问榴花好消息，只今难问旧题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝象峰胜因寺","author":"方信孺","text":"鸿濛谁辟此山川，龙象新开二十年。\n最恨东坡早仙去，只教蒲涧入诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抱旂山","author":"方信孺","text":"面势翩翩天外山，彩旂常在翠云间。\n太平官府无公事，尽好高牙相对閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"法性寺","author":"方信孺","text":"金碧参差兜率天，曾煎诃子试新泉。\n荒园废宅无人问，门外桃花却是禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"波罗蜜果","author":"方信孺","text":"累累圆实大于瓜，想见移根博望槎。\n三百馀篇谁识此，世间宁复有张华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎头岩","author":"方信孺","text":"绝壁空岩踞虎头，鸟飞不渡野猿愁。\n人间有此真奇境，便好乘风访十洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎跑泉","author":"方信孺","text":"破寺高僧夜不眠，一声猛虎月明天。\n起来难觅新蹄迹，半滴空馀石罅泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贪泉","author":"方信孺","text":"泉本无贪人自清，何须一酌始忘情。\n回车胜母君知否，见说曾参亦好名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金芝岩","author":"方信孺","text":"碧落三洲天下奇，仙城谁复识金芝。\n可怜隔断黄茅路，不得骚人赋一诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台","author":"方信孺","text":"钓得神鱼金作鳞，废台百尺漫嶙峋。\n丝纶不入非熊梦，当日何人老渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南七寺","author":"方信孺","text":"井轸南宫焕宝光，千秋古胜并延祥。\n祗今两寺无名字，地藏旁联四实方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南海庙","author":"方信孺","text":"官阙参差海上开，吐吞波浪起风雷。\n英灵万古无宗社，奚丑区区何足摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]