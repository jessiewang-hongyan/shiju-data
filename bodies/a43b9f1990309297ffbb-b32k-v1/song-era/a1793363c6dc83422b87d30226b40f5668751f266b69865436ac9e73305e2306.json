[{"title":"题刘民用居士藏六庵 其二","author":"释昙华","text":"虚空正体没边涯，藏六如何盖覆伊。\n要听少林无孔笛，从来多是逆风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈参议中大大隐图","author":"释昙华","text":"荷锄居士隐云庄，竹屋茅堂瞰小江。\n祇这逍遥是知己，人间天上更无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞三将军","author":"释昙华","text":"家在归宗寺后山，洞中春色异人间。\n祇因亲受灵山记，长与归宗把要关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别俗兄","author":"释昙华","text":"此行安忍泛轻舟，无奈官差不自由。\n痛望老人修净业，莫教容易度春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠悟上人造华严塔","author":"释昙华","text":"山前马厩普光殿，门外牛栏正觉场。\n五十三人同日葬，善财走得脚生疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠晦叔秀才二首 其二","author":"释昙华","text":"少室岩前路不遥，毫芒才拟便迢迢。\n西湖湖上晚来看，小艇轻风落画桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠晦叔秀才二首 其一","author":"释昙华","text":"处世从教眼似眉，自然心地绝支离。\n翻身更透龙门浪，头角峥嵘宇宙低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"术人求颂","author":"释昙华","text":"造化付谁手，君来聊解颜。\n欲游天上路，先破鬼门关。\n祸福行藏内，高低方寸间。\n毫芒差错处，过犯重如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送六人禅者随宏长老住大智","author":"释昙华","text":"大智荒凉久，中兴六上人。\n机前施远略，句下要通津。\n事理无兼带，偏圆有主宾。\n风云今际会，弹指一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞睦州和尚","author":"释昙华","text":"稽首金容癞狗师，一生快活没人知。\n平田浅草翻身处，合水和泥换步时。\n垂手未施三寸刃，破关先下顶门槌。\n寥寥万古谁堪对，唯有嘉禾跛脚儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为南书记下火","author":"释昙华","text":"东湖莞岭及归宗，烨烨腾辉炉鞴中。\n铁眼铜睛烹不破，衲僧巴鼻好流通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卞禅人画布袋和尚求赞","author":"释昙华","text":"人谓是弥勒，且喜没交涉。\n拖个破布袋，到处纳败阙。\n祇有一味长，子细为君说。\n是什么，乾屎橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平江虞祖道写顶相求赞","author":"释昙华","text":"枯松下，盘陀上，独坐大方，横按拄杖。\n谓是应庵，无恁相状。\n谓非应庵，谁肯归向。\n分付祖道，试自定当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吉彬老二侄女绣普贤菩萨求赞","author":"释昙华","text":"吴门吉彬老，寿年可及百。\n骨目清且癯，施为有标格。\n行步快如风，谈笑气不乏。\n穷之无他术，一味好佛法。\n每亲善知识，言下究生杀。\n家有二侄女，贞姿迥超拔。\n自幼不茹荤，晨昏常燕默。\n从容定中起，痛念十使结。\n显尘劫大愿，运针发五色。\n幻普贤妙身，应现四菩萨。\n等十方虚空，皎若揭日月。\n大哉白象王，群狐悉弥灭。\n当知妙殊胜，岂在别处设。\n若从自己求，犹如病作热。\n如是名正观，不尔是邪说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"严教授画临济请赞","author":"释昙华","text":"喝下忽雷惊，声前休领略。\n当锋啮镞时，蹉过第一著。\n不在壁立处，岂向平地泊。\n野水白连天，秋空飞一鹗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李参政颂示鉴禅者","author":"释昙华","text":"清源居士顶门著，从本已来自寥廓。\n更透吾家向上关，活鱍鱍地难收捉。\n风尘草动鉴来端，临机八面初无作。\n才起分毫取与心，即被邪师笼罩却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"表微首座请赞","author":"释昙华","text":"左捺膝，右握拳。\n槌瞎正法眼，打破葛藤禅。\n奋迅西河爪距，踢出杨岐金圈。\n祇凭个一著，今古有人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杰侍者还乡","author":"释昙华","text":"大彻投机句，当阳廓顶门。\n相从今四载，徵诘洞无痕。\n虽未付钵袋，气宇吞乾坤。\n却把正法眼，唤作破沙盆。\n此行将省觐，切忌便垛根。\n吾有末后著，待归要汝遵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐伯寿求赞","author":"释昙华","text":"大海波涛阔，千峰气象雄。\n当头俱坐断，直下展家风。\n一喝分宾主，三玄辨正宗。\n其馀都莫问，今古有盲聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"积善普长老请赞","author":"释昙华","text":"天台南，石桥北，观音寺里有弥勒。\n顶门瞎却摩醯眼，肘后风雷轰霹雳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莞山净明庵小参示众","author":"释昙华","text":"三十三州七十僧，驴腮马颔得人憎。\n诸方若具罗笼手，今日无因到净明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莲道人自写像求赞","author":"释昙华","text":"凌行婆，莲道者。\n一个患聋，一个患哑。\n聋者善听，哑者能话。\n堪笑堪悲，可知礼也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其十","author":"释昙华","text":"苦瓠连根苦，甜瓜彻蒂甜。\n两般滋味恶，中后入黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其五","author":"释昙华","text":"急水滩头下钓时，锦鳞红尾尚迟疑。\n蓦然跳出洪波里，攫雾拿云宇宙低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其三","author":"释昙华","text":"出得出不得，满面是埃尘。\n愁人莫向愁人说，说向愁人愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十五","author":"释昙华","text":"一二三四五，五四三二一。\n从头点检来，笑杀维摩诘。\n带累李胡子，喷水髭须湿。\n洒净已周圆，次念波罗蜜。\n蒋山恁么道，千古谁人识。\n识不识，何处觅，堪与丛林为轨则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十六","author":"释昙华","text":"泥多佛大，水长船高。\n直饶说得道理分明，也须亲到一遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十九","author":"释昙华","text":"师子吼，无畏说，百兽闻之皆脑裂。\n香象奔波失却威，龙天寂听生欣悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十六","author":"释昙华","text":"药山道头，云岩知尾。\n虽然头尾相称，要且不知羞耻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十","author":"释昙华","text":"识得橙子，周匝有馀。\n识得橙子，天地悬殊。\n若向周匝有馀处会，理上偏枯。\n若向天地悬殊处会，事上偏枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其二","author":"释昙华","text":"九年面壁，坏却东土儿孙。\n只履西归，钝置黄面老子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十七","author":"释昙华","text":"天清地宁，时康道泰。\n摩醯正眼洞明，肘后灵符光彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四","author":"释昙华","text":"大丈夫，须猛烈。\n打破从前伎俩，直下斩钉截铁。\n拈却佛祖机，拔却系驴橛。\n岂不见睦州为人太亲切，拶得云门脚折。\n后来儿孙不辨端倪，却向推门处辨别。\n若也恁么参禅，驴年未得休歇。\n妙严不惜眉毛，与你当头拈出。\n南赡部洲人，常在北郁单越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十八","author":"释昙华","text":"金佛不度炉，木佛不度火。\n泥佛不度水，真佛屋里坐。\n万牛挽不回，千个与万个。\n好事积如山，祇缘轻放过。\n不放过今日，钟山甘话堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十一","author":"释昙华","text":"德章老瞎秃，从来没滋味。\n拈得口，失却鼻。\n三更二点唱巴歌，无端惊起梵王睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其六","author":"释昙华","text":"百草头上，罢却干戈。\n万仞峰前，纵横游戏。\n暗嗟鲁祖面壁，一味祇贪瞌睡。\n翻笑睦州见僧，与我提一桶水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十一","author":"释昙华","text":"金锡罢游留靠壁，草鞋乾晒待秋风。\n且那长夏深思省，看是平生有底功。\n真实行藏宜保惜，虚头伎俩疾销镕。\n老僧岂是多饶舌，要与诸人气味同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其二十九","author":"释昙华","text":"黄面老人乾屎橛，参随一火烂泥团。\n心肝肠胃皆条直，蔬饭茶花照胆寒。\n佛法虽然未梦见，神通却许入云端。\n应须痛念归宗寺，时复持盂下翠峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五十五","author":"释昙华","text":"五月五日端午节，天童为汝开真诀。\n驱释迦，逐弥勒。\n佛病祖病毛病顿清凉，魍魉邪神俱殄灭。\n相从唯喜本色人，非我同流谁与别。\n拄杖子，非列挈。\n公心一字更无说，千古万古休饶舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五十四","author":"释昙华","text":"一棒一条痕，一掴一手血。\n临济老瞎驴，至今犹未瞥。\n须弥顶上浪拍天，大洋海水无一滴。\n伟哉本色人，顶门亚三只。\n辨龙蛇百草头，擒虎兕一毫力。\n穿大地人鼻孔，坐断衲僧摇舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十三","author":"释昙华","text":"去年无此雪，今年有此雪。\n人皆怨此雪，不见元宵灯与月。\n莫怨雪，自是时人无辨别。\n堪辨别，一片清光倚寥泬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十二","author":"释昙华","text":"古来为法老尊宿，荷众曾无有倦时。\n况是年来衰落甚，动为多与行相违。\n应须痛念平生事，著意披襟善护持。\n颗粒果能无渗漏，少林初不隔毫釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其八","author":"释昙华","text":"千溪水冷，万壑云寒。\n无位真人乾屎橛，金刚宝剑破牢关。\n多年历日最灵验，百尺竿头子细看。\n瞎却眼，哑却口，无孔铁锤成队走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其二十二","author":"释昙华","text":"去时冒雨连宵去，回来带水又拖泥。\n自怪一生无定力，寻常多被业风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五十六","author":"释昙华","text":"青萝夤缘直上寒松之顶，白云澹泞出没太虚之中。\n狗子尾巴书梵字，野狐窟宅梵王宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五十一","author":"释昙华","text":"去年十一月，笑别下钟阜。\n今年九月中，行见朝天路。\n去住既无心，动静非取与。\n平生安乐法，此意同谁语。\n四明昔尝到，诸刹皆可数。\n山川气象雄，麟凤栖迟处。\n今思昔日游，岁月二纪许。\n岂谓临晚景，侯伯重相顾。\n开缄读来书，丁宁见毫楮。\n姑苏二千石，眼高照天宇。\n我昔昧平生，今见开心腑。\n欣然乐与行，方鸣集众鼓。\n先师未了底，今日应须去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十九","author":"释昙华","text":"思是闻之本，闻是思之用。\n青原白家三盏酒，吃了犹道未沾唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十七","author":"释昙华","text":"千说万说，不如亲见。\n把手共行，略通一线。\n打破漆桶，何曾见面。\n阿耨多罗三藐三菩提，也是灵验。\n蒋山恁么做颂，驴年也未梦见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五十三","author":"释昙华","text":"四月初八佛生日，天下丛林皆浴佛。\n佛身充满太虚空，何处更有虚空觅。\n见前僧俗等金躯，长短方圆皆显赫。\n放光动地二六时，从本至今无间隔。\n今有檀越女弟子，刘氏同男王承直。\n旷大劫来植善根，所行真实如菩萨。\n当知功德福无涯，回向癸未诞生日。\n唯愿岁君向此诚，诸天星曜同昭格。\n资持刘氏从此去，寿同赵州百二十。\n更祈不尽大功勋，保男察判官崇极。\n子子孙孙福禄昌，无量福田咸并集。\n此月十四往临安，龙天当护为般挈。\n三江九堰聪明神，稽首归依助英杰。\n全家既达九重城，母子忻欢仰天力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五","author":"释昙华","text":"簸箕有唇，米跳不出，天下衲僧赤??。\n更须拨转上头关，十方世界黑似漆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其二十七","author":"释昙华","text":"苦苦，苦中苦，乐中苦，谁道黄金如粪土。\n象骨老师曾辊毬，秘魔叉下捉老鼠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十三","author":"释昙华","text":"始从鹿野苑，终至跋提河。\n用尽自己心，笑破他人口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十","author":"释昙华","text":"道远乎哉，触事而真，善因招恶果。\n圣远乎哉，体之即神，刻粪作旃檀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其二十","author":"释昙华","text":"若作一句商量，吃粥吃饭阿谁不会。\n不作一句商量，屎坑里虫子笑杀阇梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其七","author":"释昙华","text":"九九九，释迦老子不知有。\n翻转面皮，伸出毛手，握金刚锤碎窠臼。\n突出无位真人，一一面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三","author":"释昙华","text":"黄檗老婆，大愚饶舌。\n佛法无多子，正眼瞎驴灭。\n妙严突出拄杖，三人證龟成鳖。\n拄杖子，善甄别。\n硬却脊梁，莫教漏泄。\n观音菩萨将钱买胡饼，放下却是一块生铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十一","author":"释昙华","text":"赵州吃茶，我也怕他。\n若非债主，便是冤家。\n倚墙靠壁成群队，不知谁解辨龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五十","author":"释昙华","text":"千年田，八百主。\n甜瓜彻蒂甜，苦瓠连根苦。\n君不见禾山解打鼓，又不见采菊东篱下，千山万山叠叠高门户。\n又不见光孝僧堂六七间，日日普请搬泥土。\n又不见临济主中宾宾中主，二三四七面相睹。\n报禅流莫莽卤闻，普请欢喜搀先去。\n去去实不去，途中好善为。\n来来实不来，路上莫亏危。\n又不见主中主，个个衲僧气如虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其四十四","author":"释昙华","text":"一茎两茎斜，其意毒如蛇。\n三茎四茎曲，无疑入地狱。\n言下若知非，心空及第归。\n堪笑蒋山老，无端入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十三","author":"释昙华","text":"西天四七，唐土二三。\n尽向者里钉桩摇橹，新东林为你诸人解缆放船。\n未说超宗异目，若得齐眉共瞩。\n亦可明窗下安排，未免栏腮掴出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其五十二","author":"释昙华","text":"禅禅，更不相煎。\n坐底自坐，眠底自眠。\n大家安乐，无法可传。\n禅禅，曹洞五位，临济三玄。\n大年三十夜，脚踏地，头顶天。\n禅禅，不直半文钱。\n海枯终见底，人死脚皮穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其二十四","author":"释昙华","text":"五月五日端午节，好事当阳难掩塞。\n归宗突出拄杖头，闲神野鬼俱消灭。\n俱消灭，砌下寒泉忽倒流，岭上白云不敢白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十四","author":"释昙华","text":"文殊据虎头，山僧取虎尾。\n中间诸菩萨，随列生欢喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十五","author":"释昙华","text":"云门不负者僧来问，未免落在陷阱中。\n是你诸人若向者里会得，许你高步毗卢顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其九","author":"释昙华","text":"云门露，猛如虎。\n达磨师，不是祖。\n岂不见盐官老须弥为槌，虚空为鼓。\n又不见禾山老解打鼓。\n休莽卤，甜瓜彻蒂甜，苦瓠连根苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十四","author":"释昙华","text":"心佛及众生，笑而还复喜。\n笑喜本无根，缁素诚有旨。\n千古万古人，几个识道理。\n道理深，何处寻。\n海枯终见底，人死不知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真请赞 其十一","author":"释昙华","text":"身心一如，身外无馀。\n不愿成佛，亦非凡夫。\n甘作上牢漆桶，无心计较锱铢。\n万古银山铁壁，更没者也之乎。\n是则活埋老僧，不是则打杀昙慧。\n暗透两重牢关，烈焰不藏蚊蚋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]