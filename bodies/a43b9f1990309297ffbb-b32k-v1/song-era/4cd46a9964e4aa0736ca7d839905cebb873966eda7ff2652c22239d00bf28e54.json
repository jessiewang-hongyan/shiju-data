[{"title":"题友人深居","author":"张炜","text":"閒中有真乐，深隐向林峦。\n?竹招山色，栽梅结岁寒。\n事因贫后少，心到老来安。\n拾芥取青紫，野人犹畏难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题可山梅花岩","author":"张炜","text":"高人深欲买山居，常办栽梅养鹤图。\n喜有名园邻水月，不妨清梦忆江湖。\n羲之坦腹应相爱，和靖掀髯足自娱。\n旦夕杖藜须践约，锦囊先束付奚奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题莲峰集后","author":"张炜","text":"夺得莲峰秀，英名馥迩遐。\n文章腾气燄，句律炼聱牙。\n一梗江湖客，三朝忠义家。\n欲评清绝处，雪月照梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题童宰盘隐","author":"张炜","text":"才了花阴入要涂，暂时归去友樵渔。\n远山数笔意不尽，流水一泓清有馀。\n我辈爱吟怀退步，谁人得计肯闲居。\n古梅树下三间屋，深掩柴门静读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买剑","author":"张炜","text":"袖携一剑三尺铦，试与豪士论丑妍。\n锋铓闪烁走冰雪，靶鞘激烈拿风烟。\n断蛟截犀挺灵怪，照人切玉光牵联。\n昔时欧冶不再出，纯钩磐郢名空传。\n越王苟不遇薛烛，万户骏马谁肯捐。\n物虽有价瑶无价，瑶逢识者逾精鲜。\n主人得之亦自壮，十袭珍秘轻万钱。\n何当佩服却戎羌，会令沙漠无戈鋋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂诗","author":"张炜","text":"笙簧世所贵，正调多溺沉。\n有人怀古心，临风理瑶琴。\n一弹秋月高，忽觉开尘襟。\n或疑涧泉声，忽作鸾凤吟。\n得意自怡悦，子期难再寻。\n铜壶一枝梅，尽可为知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过西兴渡","author":"张炜","text":"久不到西陵，重来扣便?。\n眼吞沧海碧，帆卷越山青。\n路远人烟盛，官清风浪停。\n片时登岸口，小立望云亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒二首 其二","author":"张炜","text":"白雪农家瑞，亦使天下寒。\n陋巷无饥民，此瑞古所难。\n上方播春仁，发粟赒饥餐。\n一饱生欢心，万户各获安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒二首 其一","author":"张炜","text":"北风吹枯桑，污注如语汝。\n窗虚夜少寐，展转莫宁处。\n衾裯冷如铁，凛凛不可禦。\n家居犹畏寒，何况远行旅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试宣毫","author":"张炜","text":"中山瑞兽久不出，天下笔工徒负名。\n近闻宛陵获数辈，束缚管制差专精。\n携入京师求鉴赏，一见不以他毫轻。\n呼童涤砚淬瑿玉，催我纸上云烟生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山制墨胡处士求隶字","author":"张炜","text":"有客落魄游京都，形服差类山泽臞。\n袖携一纸故友书，来求古隶铭墨模。\n我方临池且自娱，触拨雅兴生江湖。\n坐扣墨法果不诬，出示数饼泥金濡。\n质模温润凝龙酥，麝气酷烈清透肤。\n浣濯研沼尘滓无，磨动淳漆生金壶。\n吴笺半幅翻雪腴，碧云掩冉生兔须。\n豪家有钱贮金珠，谁肯淡好如吾徒。\n自怜我为贫所拘，倾囊尽易令无馀。\n临行束担付獠奴，就索诗句荣归途。\n天下具眼不可污，芳名岂借人言沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"张炜","text":"杨妃睡未足，西子妆太华。\n馀妖媚东君，化为枝上花。\n娇羞沁红玉，袅娜揉春霞。\n少陵恐添愁，不欲诗句誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虚谷","author":"张炜","text":"虚室既生白，空谷亦传声。\n山翁抱高标，借为虚谷名。\n中有如带水，流出心源清。\n我欲从之游，临风濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒和靖祠","author":"张炜","text":"先生遗隐迹，年古路荒凉。\n鹤唤诗魂去，梅留姓字香。\n孤山应似旧，荐菊谩流芳。\n翻作西湖梦，骚人为断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游葛岭玛瑙寺瞻孤山尊者像","author":"张炜","text":"柳风吹兰衿，藓晕识芒履。\n寻幽古招提，偶识尊者墓。\n断碣眠苍云，慈容惨香雾。\n孤山岂无诗，未若壁间句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢瑜首座寄黄龙茶","author":"张炜","text":"寄我黄龙茗一圭，旋烹竹雪试新奇。\n地炉火软汤初沸，先约梅花小赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题心远别墅","author":"张炜","text":"闻说藏修所，凭山更接溪。\n百花搀序发，万竹剪云齐。\n地胜尘无染，廛居俗正迷。\n二王诗绝唱，何用我留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题夏训武圭画牛","author":"张炜","text":"枯木立数茎，断岸走千尺。\n旁有牧牛儿，放牛倚拳石。\n牛闲芳草间，儿倦眠局蹐。\n画手笔入神，淡墨夺真迹。\n凭谁唤儿醒，落日归路僻。\n觉来横短笛，吹断远山碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出舍在浙江亭得父书开示题诗于亭","author":"张牧","text":"结束青山向日还，得书南望意悠然。\n少宽二老庭帏念，粗了生平灯火缘。\n去路虽遥心已近，短篇欲就意难圆。\n不妨静洗笙歌耳，稳接江涛到枕边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韶州秩满至清源道中闻子庠侄磻俱登第又题客邸","author":"张牧","text":"道路已三月，山川犹昔年。\n绣花红委地，刺水绿平田。\n生计付身外，儿曹慰眼前。\n愈知贫有味，无梦到愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梵才上人归天台","author":"张瑰","text":"往问维摩疾，来探般若心。\n本源虽自在，因地亦行深。\n洒落溪山色，苍凉竹树阴。\n宦途如磨蚁，何日重登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题径山怀郎简侍郎","author":"张瑰","text":"天地一洲渚，北平南攲危。\n幽并深以厚，江浙清且奇。\n武林颇英秀，川汇仍山卑。\n应接殚天巧，类非人力为。\n径山最佳处，有岩称玉芝。\n居防俗士驾，地乃贤人宜。\n郎公留名德，平时为羽仪。\n引年归故里，不复衣朝衣。\n留侯黄石心，白傅香山期。\n结宇名胜外，日与尘事违。\n泉石景物状，尽任诸贤诗。\n伊予来东藩，滥持使者麾。\n平生爱山水，弗惮命驾之。\n当候秋风高，远造岩下扉。\n浣濯缨上尘，散步松间綦。\n未能继高躅，聊用慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张瑰","text":"洲围淮口江形狭，亭上石头月色多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张瑰","text":"人间独有当时月，山际犹无后世樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读浯碑漫成一绝","author":"张知复","text":"开元天子乐升平，肯向华清戒履冰。\n纵有浯溪溪上石，元郎何意颂中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一盌泉","author":"张知退","text":"泉形如盌水波圆，一勺之多可悟全。\n试看灵湫轻洒处，甘霖顷刻遍秦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广福寺","author":"张祁","text":"老去丹心在，愁来酒兴浓。\n江山遗古意，云水淡秋容。\n落日孤村笛，微风远寺钟。\n平生善知识，却忆妙高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吏隐堂为郑参议题","author":"张祈","text":"平时谷口驰声名，只今朝市心如水。\n司马政成方外趣，官事莫能相料理。\n公堂卜筑在人境，钟阜孱颜是吾里。\n瑶林琼树风尘外，白雪阳春谈笑里。\n花间有酒可逃禅，客至忘吾还隐几。\n便应诏登金马门，乐此徜徉聊复尔。\n君王神圣相伊周，虎豹空山不可留。\n招我白云二三子，弹冠径出从公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹤峰","author":"张祉","text":"我登白鹤峰，下窥沧海日。\n色与朱橘同，形比弹丸一。\n夜半伫玩閒，无质而生质。\n所以神仙侣，色界须超出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其四","author":"张秉","text":"北斗城高禁漏多，汉家宫殿奏笙歌。\n漫教青鸟传消息，金简长生得也么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其三","author":"张秉","text":"香阶宝砌静无尘，遥指星河再拜人。\n若把离情今夕说，世间生死最伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其二","author":"张秉","text":"红蕖烂熳碧池香，罗绮三千侍汉皇。\n阿母暂来成底事，茂陵宫桂已苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其一","author":"张秉","text":"斜汉西倾桂魄新，停梭今夕度天津。\n世间纵有支机石，谁是成都卖卜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清风十韵","author":"张秉","text":"何处来蘋末，萧骚尽四邻。\n金茎吹晓露，玉宇动轻尘。\n易水离歌阕，齐纨怨思新。\n泛兰迷旧泽，落帽会佳辰。\n篱菊飘香远，庭桐坠叶频。\n帆开五湖客，槎去九霄人。\n曲沼铺纹簟，平芜偃绿茵。\n鸿飞资羽翮，鹰击助精神。\n仙驭归堪待，琴松韵更真。\n披襟同楚树，千古自相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其五","author":"张秉","text":"珠箔风轻月似钩，还看锦绣结高楼。\n堪伤乞巧年年事，未识君王已白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张秉","text":"叠石自然成雁塔，贮泓依旧作龙塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题宣圣庙石壁","author":"张绅","text":"前枕清流后倚山，殿堂高创白云间。\n幸因供职频经此，及过三年鬓渐班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小院","author":"张绍文","text":"小院春寒闭寂寥，东风吹雪未全消。\n山茶谢了梅花落，移得诗情上柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"张绍文","text":"金鸭香残酒半醒，夜深寒月过西棂。\n可怜心事无人识，诗眼与灯相对青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定林","author":"张绍文","text":"三间书屋年年在，一点禅灯夜夜明。\n门外青苗浑不见，半山松竹自秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵道中晚宿","author":"张绍文","text":"卸却征衣卧客窗，移床切莫近寒螀。\n空阶一雨凄凉甚，不怨梧桐怨夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句二首 其二","author":"张绍文","text":"雨过盘池起绿波，夜来添得几圆荷。\n单衣不奈春寒恶，却美杨枝挟纩多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句二首 其一","author":"张绍文","text":"晓云扶日上高梧，一枕春酲困未苏。\n山鸟不知如许事，隔窗犹自劝提壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉乡","author":"张绍文","text":"醉乡诗笔是生涯，短短蛮笺字字斜。\n沉水一株烟未断，半窗寒月上梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山庵夜宿呈深居先生","author":"张绍文","text":"松径转幽密，一程深一程。\n涛声在平地，月色正三更。\n僧定欲唤起，鹤眠频梦惊。\n晓来真富贵，露叶缀珠璎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江亭晚眺","author":"张绍文","text":"登高便可豁双明，吟外还能见物情。\n南北盛衰关大数，英雄得失总虚名。\n莫云千里乡心远，寒雁一声秋意清。\n江上白鸥应笑我，等闲虚负水边盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自淮阳还里中抵舍一夕即为通川之行","author":"张绍文","text":"喜得归来席未安，又携书剑上江干。\n莫陪亲戚话情愫，空指溪山说肺肝。\n客路几程来杳杳，天涯一棹去漫漫。\n故乡又被江云隔，写得诗成欲寄难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自维扬辞亲暂归里中登楼有作","author":"张绍文","text":"烂漫家山景物妍，西风收拾下蛮笺。\n半分寒事梅花里，一段幽怀夕照边。\n渔唱凄凉招野色，雁行缥缈带晴烟。\n淮山只在栏干北，目送飞云重黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其一","author":"张绍文","text":"电挟雷声迅，风将雨脚多。\n须臾寂无有，造化果如何。\n饥鼠撼帏竹，哀蛩语径莎。\n披衣起中夜，有感寄长歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其二","author":"张绍文","text":"地迥秋声远，山空野兴多。\n宦游聊尔耳，疏懒奈吾何。\n摇落惊黄叶，推敲步绿莎。\n新凉大自在，对酒且高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春闺怨效唐才调集体","author":"张绍文","text":"杨柳和烟翠不分，东风吹雨上离樽。\n茝弦调急难藏恨，燕子楼高易断魂。\n锦字书成春梦远，玉壶泪满夜灯昏。\n马蹄想过长亭路，细与萧郎认去痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梁中砥入道从三茅许松溪","author":"张绍文","text":"无意觅封侯，来从长史游。\n辞章唐韵度，人物晋风流。\n花影天坛午，松声月涧秋。\n登临尽诗境，分我半山不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山路间","author":"张绍文","text":"立马钟山路，斜阳锁乱峰。\n断碑生绿藓，古道立青松。\n春事梅边觉，乡愁酒后浓。\n兴亡多感慨，我辈复情钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云溪叔父赐饮大梅花下以疏影横斜暗香浮动分韵得动字","author":"张绍文","text":"清沟泂寒波，怪石乱扶拥。\n轻风捲浓云，天际孤月涌。\n主人宴亲宾，会合意弥重。\n列炬照寒梅，繁星粲脩陇。\n清香逼诗魂，吟兴欲飞动。\n酩酊归去来，严城角三弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 春晚","author":"张绍文","text":"日迟风软花香，困人天气情怀懒。\n牡丹谢了，酴醾开后，红稀绿暗。\n慵下妆楼，倦吟鸾镜，粉轻脂淡。\n叹韶华迤逦，将春归去，沉思处、空肠断。\n长是愁蛾不展。\n话春心、只凭双燕。\n良辰美景，可堪虚负，登临心眼。\n雁杳鱼沉，信音难托，水遥山远。\n但无言，倚遍阑干十二，对芳天晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 为叔父云溪主人寿","author":"张绍文","text":"数遍时贤，谁似云溪，未老得闲。\n自抽身州县，归休旧隐，灰心名利，跳出尘寰。\n卸却朝衣，笑拈拄杖，日在花阴竹径间。\n身轻健，任高眠晏起，渴饮饥餐。\n垂弧猛省当年。\n且约住春风开寿筵。\n况园亭池馆，新奇佳丽，弟兄子侄，歌笑团栾。\n绿鬓朱颜，纶巾羽扇，做个人间长寿仙。\n霞觞举，愿年年今日，长对南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壶中天/念奴娇 为兄风云水月主人寿","author":"张绍文","text":"丹台仙伯，记踪迹当年、琼楼金阙。\n底事来游人世界，为爱风云水月。\n结屋南园，境随人胜，不是溪山别。\n今朝初度，碧莲千顷齐发。\n况是鸳侣新偕，凤雏才长，占人间欢悦，且尽壶天终夕醉，听取妙歌千阕。\n待得西风，鹗书飞上，更复青毡物。\n功成名遂，赤松还伴高洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 淮城感兴","author":"张绍文","text":"举杯呼月，问神京何在，淮山隐隐。\n抚剑频看勋业事，惟有孤忠挺挺。\n宫阙腥膻，衣冠沦没，天地凭谁整。\n一枰棋坏，救时著数宜紧。\n虽是幕府文书，玉关烽火，暂送平安信。\n满地干戈犹未戢，毕竟中原谁定。\n便欲凌空，飘然直上，拂拭山河影。\n倚风长啸，夜深霜露凄冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景诗 其七 山市晴岚","author":"张经","text":"茅屋开山脚，岚光映日光。\n行人消野兴，个个醉壶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景诗 其四 平沙落雁","author":"张经","text":"唤侣下寒汀，争宿芦花萼。\n夜半渔翁过，惊起还飞落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景诗 其八 江天暮雪","author":"张经","text":"江上雪纷纷，风寒天已暮。\n中有泛舟人，兴尽迷归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景诗 其三 远浦归帆","author":"张经","text":"极浦一帆回，招招近岸开。\n倚船试相问，莫是故乡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景诗 其五 烟寺晚钟","author":"张经","text":"野烟寺初暝，僧添宝篆香。\n鲸音送残照，敲落楚天霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景诗 其六 渔村夕照","author":"张经","text":"日落大江头，返照江村里。\n独有羡鱼翁，垂纶收不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洞庭","author":"王质","text":"云可有无水，风能奔走沙。\n蟠深鸣老䖦，飞倦落长鸦。\n地有湘头尾，山无楚正斜。\n人间与天上，何处碍浮槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳阳楼望洞庭","author":"张经","text":"每因蜀水涨，横遏楚江流。\n气象吞云梦，波澜彻夏秋。\n风云几开阖，日月自沉浮。\n欲济谁舟楫，乾坤独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘八景诗 其二 洞庭夜月","author":"张经","text":"秋夜净无云，嫦娥展孤镜。\n灏气浸澄波，荡漾光还定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]