nce":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梁检法书怀八绝句于广文尉曹处次韵 其四","author":"赵蕃","text":"汉诏元从漏网宽，可将数罟作惊澜。\n幕中有此贤从事，我亦他时逭免冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梁检法书怀八绝句于广文尉曹处次韵 其一","author":"赵蕃","text":"文力纵横昔未窥，每闻二子说襟期。\n来朝借得新诗卷，起我閒窗病酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梁检法书怀八绝句于广文尉曹处次韵 其三","author":"赵蕃","text":"修眉画就莫求工，自昔常闻妒入宫。\n不为无人芳自吐，也胜能白又能红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梁检法书怀八绝句于广文尉曹处次韵 其六","author":"赵蕃","text":"辞好曾闻喻色丝，那知妙处本天姿。\n若穷句法源流远，曾见梅山唱和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梁检法书怀八绝句于广文尉曹处次韵 其七","author":"赵蕃","text":"中圣流风久未寒，渺然何但酒肠宽。\n渠诗下笔如山峡，我思攀危上七盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梁检法书怀八绝句于广文尉曹处次韵 其二","author":"赵蕃","text":"醉眠攲侧似乘舠，飒飒溪风吹鬓毛。\n颇念乘流觅归路，兀然惊起遇滩高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见紫荆有怀成父","author":"赵蕃","text":"一树幽花见紫荆，杜陵诗句属吾情。\n江东消息关河阔，况我平生寡弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓林寺用孙温叟韵","author":"赵蕃","text":"上天有路不为难，丈七坳头莫据鞍。\n小憩还寻去时寺，戏拈枯笔臂犹酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长田铺二首 其二","author":"赵蕃","text":"晚日东西路，秋风长短亭。\n悲歌浑欲绝，衰泪不胜零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长田铺二首 其一","author":"赵蕃","text":"野驿人稀到，空庭草自生。\n霜清殊未觉，雨细更含晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风","author":"赵蕃","text":"逆风忽作大王雄，客岸淹留半日中。\n亭午却回张席去，向来骇浪亦潜空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书示逸二首 其二","author":"赵蕃","text":"别日才留两月粮，况经裘葛变炎凉。\n未知别后端何似，不见寄来书一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书示逸二首 其一","author":"赵蕃","text":"风号窗外独株松，想汝看书趁晓钟。\n是我起行茅店月，禦寒还觉欠茏茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书送橘沈临江","author":"赵蕃","text":"谁贻新橘两筠笼，尚带霜林错落红。\n转送清江供寿酒，草书因病废匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄成父","author":"赵蕃","text":"已作南山半月留，欲行更复待新秋。\n不知几日潮当发，可及沙头一醉不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄张次律二首 其二","author":"赵蕃","text":"闻道浮家历上塘，寒山钟接洞庭霜。\n是中佳句知多少，傥有书来幸不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄张次律二首 其一","author":"赵蕃","text":"道入袁州首问君，却言守舍有宗文。\n不知木落风高际，何处登临对夕曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄周愚卿二首 其二","author":"赵蕃","text":"穷冈冈上欧阳子，荷屋屋中常不轻。\n邂逅论诗傥相及，为言即日鬓霜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄周愚卿二首 其一","author":"赵蕃","text":"友于阁上友于人，忽忽分携又两春。\n剩欲作书书不得，旧知吾懒是吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代简琛卿","author":"赵蕃","text":"是处梅花与雪融，竹间开晚正玲珑。\n陈君为我言如此，折赠当期慰眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰溪溪岸梅花","author":"赵蕃","text":"不用温家玉镜台，下临溪水静无埃。\n若非姑射冰肌至，即是罗浮缟袂来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北风","author":"赵蕃","text":"北风故应阴，南风还当晴。\n占风更占雨，巢穴寄吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发大通","author":"赵蕃","text":"五更催发船无限，及此风收浪不生。\n何事渔舟亦争进，始知为利总营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发石佛","author":"赵蕃","text":"石佛如今果有灵，尽驱昏翳作空青。\n松原白石今朝过，云洞月岩明日经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发豫章后二首 其二","author":"赵蕃","text":"诗成欲赋江山好，政尔多言恐害廉。\n只恨十分朝日美，可能身独负茅檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发豫章后二首 其一","author":"赵蕃","text":"枫林灭没橘林多，酒户渔家奈若何。\n剩欲与渠论久住，一官老矣尚奔波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对月赠答二首 其二","author":"赵蕃","text":"焚香拜月君怀我，对月停杯我忆君。\n莫羡月圆圆又缺，会看人合合无分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]