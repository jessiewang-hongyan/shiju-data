[{"title":"禅人并化主写真求赞 其二十八","author":"释正觉","text":"一相无相，虚空等量。\n一身多身，物像俱春。\n动也出岫之云，静也居谷之神。\n现形说法也，刹刹尘尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○八","author":"释正觉","text":"发白而老，面黄仍病。\n穷地水火风之根，得见闻觉知之柄。\n一气专柔，诸尘善应。\n魏臭而良，橘陈而令。\n尽大地药了调和之治方，满虚空身识起灭之缘性。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一三六","author":"释正觉","text":"寒雪一颠，秋云半肩。\n渊默曲木，月行霁天。\n转功能就位，借伴还入廛。\n机用也离虚坎实，变通也坤断乾连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一九","author":"释正觉","text":"内非可形，外还绝称。\n妙圆一句，通变诸乘。\n混十界心而静其念，吞三世佛而空其膺。\n真机了了，祖意绳绳。\n偏去正来兮闲闲受用，圆规方矩兮恰恰相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七九","author":"释正觉","text":"丘壑精神，云水陈人。\n心灯不夜，道树长春。\n珠胎养乎老蚌，龙雷跃于脩鳞。\n烂烂光辉兮明白之窟，棱棱浪级兮桃华之津。\n庄严三昧，游戏诸尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十四","author":"释正觉","text":"像兮非真，真兮非像。\n妙明四大之前，自出诸缘之上。\n不把一字之心传，有吞百川之器量。\n随方普应而不亏，的的夜光而在掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十三","author":"释正觉","text":"身兮芭蕉，口兮葛藤。\n雪乞人天饭，光传佛祖灯。\n机活作春像，念冷摩风棱。\n金针玉线兮，谁我绳绳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九三","author":"释正觉","text":"閒云之动，野水之流。\n体万像之平等，了一身而自由。\n机轮无滞兮，凿枘相投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二五","author":"释正觉","text":"须发老而覆霜，心念净而发光。\n妙照混三世，幽灵空十方。\n口吞诸佛而不为大，舌拄梵天而不觉长。\n刹尘无间说，鸥鸟不乱行。\n平等是道，自然成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一五","author":"释正觉","text":"体之湛存，潮缩海门。\n用之亡痕，春入华根。\n光明射珊瑚之魂，波澜派昆崙之源。\n影动非幡，声扬度垣。\n静以应繁，冲以待喧。\n骐骥之姿，千里之奔。\n云梦之量，八九之吞。\n斲轮之工兮拟谁授克家之学，抱瓮之朴兮将自灌丈人之园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十四","author":"释正觉","text":"白发星星，骨癯气清。\n雪浸山嵂屼，秋在水渟泓。\n流琥珀兮涧松老，射珊瑚而波月明。\n影落大千去也，何妨触处峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七五","author":"释正觉","text":"是个人，欠精神。\n家风青天没四壁，事业白云閒一身。\n古涧之津，枯木之春。\n水曲折而归大海，华次第而趁芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八七","author":"释正觉","text":"写出个僧，冷淡无能。\n默耕田地，力锄葛藤。\n入海泥牛绝消息，度河月兔有光棱。\n携去尘中成化事，更嫌何处不相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三二","author":"释正觉","text":"精神矍烁，化工模邈。\n我转一机，谁持六鉴。\n是非生夺璧之谋，黑白战烂柯之著。\n霁阔而河横，潭空而月落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五八","author":"释正觉","text":"兀然而然，湛存象先。\n曹溪昧横画，少室还默传。\n体不匿而了了，用不勤而绵绵。\n得麟角兮石头足，捋虎须兮林际颠。\n壁上如今谩撑起，知音自然闻说禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○八","author":"释正觉","text":"个是何人，气清骨贫。\n烟霞面目，丘壑精神。\n二仪自然一体，万像况与同尘。\n床上全威白额虎，钩头可意赤稍鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四八","author":"释正觉","text":"绝待而灵，无得而名。\n就位难辨，借功證成。\n合伴应时节，随事放光明。\n神歌社舞闲心适，块雨条风乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八九","author":"释正觉","text":"静而无像，动而无功。\n湛兮秋下水，应也树头风。\n到处随缘成佛事，超情只个是神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八六","author":"释正觉","text":"湛而不浑，妙而长存。\n秋水何色，野云无根。\n半夜天空河汉净，老兔濯濯明月魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三九","author":"释正觉","text":"静之不昏，湛而若存。\n动之不浑，用而亡痕。\n入见离微之根，出游幻化之门。\n赤水之求故罔象而珠得，庖丁之伎乃亡牛而刃奔。\n百川碧涨，三月红繁。\n海不失于潮信，华自得于春恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九○","author":"释正觉","text":"视之其夷，听之曰希。\n真声真色，何是何非。\n春山润而云起，秋水澄而月归。\n见闻断痕而外分变化，功勋转处而内尽玄微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七四","author":"释正觉","text":"个住山人，平生惯贫。\n寒枯青嶂骨，闲淡白云身。\n无影树头兮露鹤梦月，不萌枝上兮华蜂采春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七七","author":"释正觉","text":"衲僧顶相，不可近向。\n俯而九渊之下，仰而重霄之上。\n以法界为疆，以虚空为量。\n闹市里释提洹因，百草头俱胝和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七一","author":"释正觉","text":"白发寒岩雪，青眸古涧秋。\n身心明月磨田地，河汉清霜洗斗牛。\n识金鍮，用锥钩，万化区分拄杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十二","author":"释正觉","text":"髑髅历乾，鼻孔觉宽。\n廓空三际，不立毫端。\n面目风霜杀，身心水月寒。\n情尘净尽兮，万像齐观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四六","author":"释正觉","text":"秋生眉睫，雪积颠发。\n见偏正之往来，得离微之出没。\n閒閒霁雨之云，烂烂濯波之月。\n相随来也入诸尘，妙触门门自超越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十三","author":"释正觉","text":"寒肩自高，饥眼较大。\n乌藤瘦握拳，曲木默据座。\n无言而独灵，有唱而谁和。\n秋摩水色兮清绝瘢痕，春入华枝兮妙亡程课。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十二","author":"释正觉","text":"心闲不被身碍，饭饱仍嫌口多。\n妙应群机活卓卓，默传一句圆陀陀。\n呈似了也，还相识么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一二","author":"释正觉","text":"用得乎眉，体全乎鼻。\n香象不群，金毛无畏。\n明妙吉之初心，入普贤之幻智。\n回途放旷知不知，般若光中熟游戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一四","author":"释正觉","text":"山光寒点雪，水色冷磨秋。\n肝胆古鉴净，身世浮萍流。\n罔象而珠得，亡牛而刃游。\n瑞凤入网兮连鳌上钩，个般手段兮老不传休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二七","author":"释正觉","text":"发雪衰白而春昼长，目光寒碧而秋波扬。\n采华之滋而蜜蜂忙，齐物之梦而蝴蝶狂。\n体空影响，机动阴阳。\n玉烛静调天事业，薰风披拂水文章。\n诸尘三昧，分身十方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九二","author":"释正觉","text":"披风兮崇丘，玩月兮方舟。\n一身不羁兮太平时节，八纮无碍兮清白谁俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十三","author":"释正觉","text":"炯炯寒瞳，丝丝衰鬓。\n丘壑之姿，烟霞之韵。\n据坐而心空，森罗而海印。\n中虚也乾而成离，内动也艮而变震。\n云行而用闲，电掣而机迅。\n狤獠人不惹尘埃，黄梅祖亲传屈眴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十二","author":"释正觉","text":"妙传乎真，转侧而神。\n赤脚劫空归去路，白头借伴却来人。\n无心分物我，何处著根尘。\n烟柳莺华闹浩浩，太平时节大家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二四","author":"释正觉","text":"鼻直口阔，目深眉低。\n灯连少室，派接曹溪。\n恰恰混不得，堂堂类不齐。\n把手共语，出力相携。\n春风浩浩，秋风凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七六","author":"释正觉","text":"发际点白，眼眶含青。\n情枯历历，智照灵灵。\n形骸如槁木，踪迹肖流萍。\n月明四海犀通晕，春在百华蜂采馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○三","author":"释正觉","text":"祖祖家传，心心印全。\n混沌未受凿，威音不得专。\n蕉雷文象齿之所以，桂月晕犀角之能然。\n水自竹来兮绿非假借，风从华过兮香有因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九八","author":"释正觉","text":"影之神，物之春。\n莺喉颊之滑滑，柳眉目之津津。\n蜂股华须粉，蜡脾蜜酿醇。\n等闲谛了游戏事，端的还如幻化人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一三九","author":"释正觉","text":"心空观身，眼冷对尘。\n本来无物，幻起成春。\n动若行云而应，止犹虚谷而神。\n门门随事得三昧，机用纵横不倩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四五","author":"释正觉","text":"其来何从，云起孤峰。\n其去何诣，月落寒水。\n而今处处相随行，的的浑身是眼睛。\n万像森罗互为用，不许蝇泥黏鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四四","author":"释正觉","text":"一印印空，三乘莫穷。\n智了离微句，身分函盖同。\n弥勒驾来楼阁外，文殊家住觉城东。\n随身干木，到处家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七二","author":"释正觉","text":"形貌春寒，颠毛雪残。\n坐空生灭影，静见离微端。\n珊瑚树生玳瑁海，明月珠走琉璃盘。\n藏天下于天下兮一性自然平等，出世间于世间兮万像谁敢相谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五七","author":"释正觉","text":"尘净无馀，体明而虚。\n秋高夜永，河阔星疏。\n宛转兼而到，偏圆卷复舒。\n媚川果若珠含蚌，应物何妨井觑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一一","author":"释正觉","text":"目深额耸，口方鼻端。\n秋云消兮天青而阔，夜月上兮水白而寒。\n看看，影像随应兮明珠走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八一","author":"释正觉","text":"二仪之门，万象之根。\n有无难议，青白不痕。\n借功承祖祢，了事付儿孙。\n采华香负蜜蜂股，齐物梦翻蝴蝶槐。\n即相离相，知恩报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一○","author":"释正觉","text":"迹像而无，纯全而有。\n阴阳不测之神，生灭不到而寿。\n十方界聊现半身，三世佛不消一口。\n只个山形拄杖子，与君触处相随走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三七","author":"释正觉","text":"须发衰残，空山雪寒。\n眉目清淡，野水秋还。\n一念万年了尘劫，十方三世同正观。\n翡翠天晴而清虚廓彻，珊瑚海月而光焰波澜。\n现形说法应机感，笑指俱胝百草端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九三","author":"释正觉","text":"萎萎羸羸，病起风姿。\n跛跛挈挈，老来事业。\n坐稳三际平，心空百念绝。\n森罗万象信峥嵘，门门三昧从施设。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五六","author":"释正觉","text":"默而静专，体之妙全。\n情尽性传，心空觉圆。\n閒閒游幻世，了了应尘缘。\n灯笼露柱浑机用，翠竹黄华总说禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八六","author":"释正觉","text":"性成而不立玄微，智诣而难分是非。\n天空云澹泞，夜冷月依稀。\n蝴蝶梦魂兮春昼飞而齐物，白鸥盟事兮夕阳卧而亡机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十四","author":"释正觉","text":"衰发半白，笑面微红。\n野水秋无像，丛林春有功。\n华繁粉梦蝶，天远没飞鸿。\n借问分身几许，相随南北西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十","author":"释正觉","text":"须发老如，眉目清亮。\n秋生野水之中，雪照寒山之上。\n湛海之心，吞川之量。\n头头不爽机宜，处处相投稳当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三五","author":"释正觉","text":"巍巍堂堂，智不可量。\n炜炜煌煌，静自然光。\n松老西山雪，河明北斗霜。\n用之而行，舍之而藏。\n深林之晦三眠茧，绕指之柔百炼刚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十八","author":"释正觉","text":"静掩双皮，喜扬两眉。\n秋容清水色，春信闹华枝。\n跛跛挈挈，憨憨痴痴，摩触家风兮鼻孔累垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四八","author":"释正觉","text":"千年气温，琥珀松根。\n半夜光吞，珊瑚月魂。\n混沌凿开，德云下妙峰之顶。\n昆崙推倒，张骞到盟津之源。\n出岫之云意閒暇，盈科之水流势奔。\n诸尘历历，三昧门门。\n妙触应缘还出碍，成家事业付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四七","author":"释正觉","text":"远山之雪兮发毛衰白，大壑之秋兮眼棱寒碧。\n水云肝胆兮佛世之灯，丛林事业兮祖宗之脉。\n龙梭锦机，金刀玉尺。\n诸尘三昧兮还我自由，二仪万像兮与宅平出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四九","author":"释正觉","text":"天与之形，月皎河横。\n地与之仪，山高水低。\n华灯连有据，桃李默成蹊。\n十方三世混不得，万像森罗类莫齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十四","author":"释正觉","text":"兀兀心传，了了忘缘。\n叶零白露，云散青天。\n玉毂兔推而洗开夜色，银笼鹤出而飞度寒烟。\n借功明位，借伴入廛。\n应无爽而理之平等，用不勤而道之自然。\n相逢识者，便与开拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十一","author":"释正觉","text":"白发颅上，青瞳眉底。\n雪点疏林，秋明野水。\n万像自相投，一灵还不倚。\n默默一尘入正受，历历诸尘三昧起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○四","author":"释正觉","text":"像取模画，人成幻化。\n得失一阄，是非一马。\n建立摐摐，权行且且。\n平贴而安，放荡而野。\n科臼弗存，轨仪何暇。\n饥则餐，饱则罢。\n硬而枕，软而藉。\n出世间于世间，藏天下于天下。\n更问如何，之乎者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五四","author":"释正觉","text":"写出老僧，形容可憎。\n秋生眼角，雪点眉棱。\n胸次有丘壑，口头无葛藤。\n功忘自据菩提座，照尽谁传般若灯。\n借光施设，恰恰相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九六","author":"释正觉","text":"默默而游，月冷天秋。\n靡靡而周，云行水流。\n身心无畔岸，机用有锥钩。\n诸尘三昧纵横句，分付之人拄杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五三","author":"释正觉","text":"寒竹癯长，苍松老刚。\n身心铁石，肝胆冰霜。\n秋天湛湛远连水，宾雁冥冥初没行。\n却来借伴，随事成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二八","author":"释正觉","text":"亡牛刃游，罔象珠得。\n沙漠漠而鸥寒，天苍苍而雁没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七九","author":"释正觉","text":"碧寒眼脑，黧黑面皮。\n佛魔销铄处，自己住持时。\n针或联线，机不挂丝。\n风月渡河无夜色，水天连霁有秋姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]