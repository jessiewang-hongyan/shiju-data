[{"title":"句","author":"陈涣","text":"炊饼担头挑取去，白衣铺上喝将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴民女","author":"陈润道","text":"吴民嗜钱如嗜饴，天属之爱亦可移。\n养女日夜望成长，长成未必为民妻。\n百金求师教歌舞，便望将身赡门户。\n一家饱暖不自怜，傍人视之方垂涎。\n朱门列屋争妍丽，百计逢迎主人意。\n常时疏弃自悲啼，一旦承恩多妒忌。\n古人怕为荡子妇，夜夜孤眠泪如雨。\n今人甘为贵人妾，得意失意花上月。\n荡子不归宁空房，主人喜怒多不常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送水云归吴","author":"陈真淑","text":"天山雪子落纷纷，醉拥貂裘坐夜分。\n明日马头南地去，琴边应是有文君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"珍珠帘","author":"陈祥道","text":"东风飘拂雨纤纤，吹向空中草木沾。\n记得传喧三殿日，恍疑天半撒珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栟榈山","author":"陈称","text":"名蓝依净境，风物倍精神。\n翠巘藏山迹，寒潭绝世尘。\n岭猿吟送月，山鸟语留人。\n拟学栖真客，林泉老此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题泉州万安桥","author":"陈称","text":"跨海为桥布石牢，那知直下压灵鳌。\n基连岛屿规模壮，势截渊潭气象豪。\n铁马著行横绝漠，玉鲸张鬣露寒涛。\n缣图已幸天颜照，应得元丰史笔褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈称","text":"壶浆压境来迎拜，犹记溪山旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓","author":"陈继善","text":"灯火南城夜，春风借齿牙。\n阿蒙曾刮目，文举幸通家。\n尚渴霏霏诲，翻成起起嗟。\n向来觞咏地，衰柳夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代和陈郎中丹桂三首 其三","author":"陈耆卿","text":"露沐烟梳冉冉时，朗然新月似蛾眉。\n傍人尽向天边觅，不信蟾宫在树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代和陈郎中丹桂三首 其二","author":"陈耆卿","text":"春兰愧死菊羞黄，世上龙涎不敢香。\n独有含香人晚步，支筇一笑倚斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代和陈郎中丹桂三首 其一","author":"陈耆卿","text":"千古陵阳芳桂丛，凌风擎出蕊珠宫。\n渥丹自是天然质，不学桃花点注红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似村","author":"陈耆卿","text":"缚茅本不傍孤村，尽日焚香深闭门。\n陌上红尘高没马，谁知巢父个中存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访赵公戴","author":"陈耆卿","text":"西原仙境即西山，流水桃花隔世间。\n自笑重来湖海客，红尘惹到白云关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄临海咏雪","author":"陈耆卿","text":"剪水纷纷扑面来，须臾洒满旧琼台。\n今年不用笺丹极，闻说金穰百室开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏史 其二","author":"陈耆卿","text":"赤族诚非汉道洪，违时贾祸亦缘公。\n最怜老却从陈豨，不道先曾辟蒯通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏史 其一","author":"陈耆卿","text":"沛公家业本无能，休责渠曹不治生。\n看取帝王他日事，方知俗眼未分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读商君传二首 其二","author":"陈耆卿","text":"计事应须远作程，快心多酿后灾成。\n遁来关下无人舍，正为商君法太行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读商君传二首 其一","author":"陈耆卿","text":"大信之信本不约，至诚之诚乃如神。\n欲识唐虞感通处，泊然无物自相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日阻雨晚晴二首 其二","author":"陈耆卿","text":"年年此日竞跻攀，今日柴门雨遣关。\n不见白衣人送酒，难偕乌帽客登山。\n鸦声不断遥天暮，鸟影争回落照间。\n未识明年谁健在，逢时只合暂开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日阻雨晚晴二首 其一","author":"陈耆卿","text":"秋气重阳故故深，临栏极目一披襟。\n紫萸黄菊常年事，冷雨凄风此日心。\n节物将迎人易老，尘埃追逐我难任。\n笑驱万虑归何有，独自低头课楚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与二三友游天庆观","author":"陈耆卿","text":"适兴相携步晚凉，琳宫因得纵徜徉。\n月翻杨柳尽头影，风擢芙蓉闹处香。\n纵论从来难得友，清游似此喜逢场。\n石栏坐久笑分袂，无酒浑疑在醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东郊","author":"陈耆卿","text":"要拓郊原眼，短筇扶我东。\n秧寒针怯水，麦熟浪酣风。\n古寺荒烟外，孤禽落照中。\n得醪嫌独醉，犹及灌园翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代挽何知县二首 其二","author":"陈耆卿","text":"才非似舅辱心知，露豁襟期喜溢眉。\n县组秦淮久依托，宾筵建邺又追随。\n闻君驯雉未多日，洎我分鱼已后时。\n徒对弦歌诵遗爱，西风涕泪强裁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代挽何知县二首 其一","author":"陈耆卿","text":"一第声名动冕旒，渊源家学自梁丘。\n谁知雨化青衿日，最解风驰紫塞秋。\n幕府石洪嗟不作，河阳潘岳竟成休。\n雁行无复云边讯，愁绝萱堂正白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过龙潭澳","author":"陈耆卿","text":"久阔松楸信，因为龙澳来。\n四山黄恋叶，一水绿澄苔。\n地旷樵声出，天寒雁影回。\n无人且无酒，清坐兴悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿章参政","author":"陈耆卿","text":"声名早已压人寰，手握枢机鬓未斑。\n嘉会宛如鱼在水，远猷直放马归山。\n风生帷幄深沉处，春在边陲广莫间。\n闻说吴儿眠正熟，月明夜户不曾关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和清臣病后韵","author":"陈耆卿","text":"契阔芝眉两月中，往寻一笑思春融。\n知君近日能寻乐，款我昨宵多发蒙。\n快得联诗到侯喜，何当载酒过扬雄。\n交情须作霜松老，莫学翻翻桃李风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐","author":"陈耆卿","text":"空庭杳已夜，孤坐悄无言。\n雨后山疑活，云中月欲吞。\n清愁难独遣，古意与谁论。\n听罢琴中操，呼童早闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日书怀","author":"陈耆卿","text":"閒来情思浩无涯，徙倚东窗日未斜。\n乍雨乍晴莺唤柳，不寒不暖蝶穿花。\n读书有味慵拖杖，觅句新成自煮茶。\n未必贵游知此趣，乘除合付野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送叶子春赴官慈溪","author":"陈耆卿","text":"眼边英气郁嵯峨，甫及同堂奈别何。\n正以簿书观道力，且于言动卜天和。\n圣门克己勤登岸，后学褆身感逝波。\n三载归来话新益，梅花仍向腊前多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王吉父知县","author":"陈耆卿","text":"不把升沉挂舌端，排空剑气逼人寒。\n竟锄卉服功良易，及试花封事转难。\n病骨欲从閒里过，长身仍作梦中看。\n醒庵文献知多少，一子雍容尚耐官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈知县","author":"陈耆卿","text":"为讯华亭鹤唳无，琴声断处客悲渠。\n日边消息花争闹，露下光阴柳变疏。\n未叹子云新第宅，最怜定国旧门闾。\n风檐读罢閒居赋，向后何人奉板舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦林雪巢","author":"陈耆卿","text":"感旧空黄叶，经时又绿苔。\n未应天上去，犹解梦中来。\n雪亦本幻尔，巢今安在哉。\n淋浪诗万轴，花鸟自惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"磨镜","author":"陈耆卿","text":"蠹蚀宁堪久，挂揩长恨迟。\n浮云手底尽，明月眼中移。\n鉴垢浑能治，心尘不解医。\n休云磨者贱，此是主人师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以新凉入郊墟为韵简叶孟我丈 其三","author":"陈耆卿","text":"世事如车轮，可旋不可执。\n得者未须歌，失者何劳泣。\n我观人心躁，甚如西风急。\n役役几时休，山林可深入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以新凉入郊墟为韵简叶孟我丈 其一","author":"陈耆卿","text":"日月不相贷，四序如昏晨。\n话秋即秋随，化工一何神。\n今年既悲秋，明年复怀春。\n人心有去来，天道无故新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以新凉入郊墟为韵简叶孟我丈 其五","author":"陈耆卿","text":"萧散不耐事，常甘宾客疏。\n不见叶夫子，我心却踌躇。\n愿勿寒前盟，相从带经锄。\n羲黄未埃尘，周孔不丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以新凉入郊墟为韵简叶孟我丈 其四","author":"陈耆卿","text":"平生一饱足，大宴非珍肴。\n秋月拓绮罗，秋风奏笙匏。\n问此有何乐，无乐乐乃高。\n琴书足匡坐，干旌谢在郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以新凉入郊墟为韵简叶孟我丈 其二","author":"陈耆卿","text":"警夜听鸣蛩，聒午闻啼螀。\n不知谁使令，万态俱悠扬。\n宋玉辩已非，欧阳赋何忙。\n正念有冰壶，日日如此凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夷齐咏","author":"陈耆卿","text":"商道昔波荡，周王网九围。\n二子如冥鸿，翩然独高飞。\n周粟固可耻，薇亦周之薇。\n云胡挟孤愤，了不悟众诽。\n天地有正气，日月无斜晖。\n惜哉权一字，谬误无已时。\n武德纣之虐，贤者诚知之。\n为欲扶此教，之死不愿违。\n吁嗟臣道薄，千载常凄其。\n欲上西山望，草际露未晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂兴六首 其一","author":"陈耆卿","text":"万化逐流水，一往不复回。\n昨日栏中花，今晨安在哉。\n焚香心如冰，未受寒暑催。\n赠花以片言，自落还自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂兴六首 其四","author":"陈耆卿","text":"我不学楚人，滋兰以自馥。\n亦未羡东陵，种瓜以混俗。\n富贵自有时，贫贱宁可欲。\n达则济四海，穷则独善足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂兴六首 其五","author":"陈耆卿","text":"狂飙捲春去，永日送夏来。\n天地一剧戏，役人如婴孩。\n借使长青春，人生能几回。\n仰羡松心坚，雪里常崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂兴六首 其二","author":"陈耆卿","text":"稷契不明经，伊傅不决科。\n方册镌勋名，千古光不磨。\n百年等一死，自立须嵯峨。\n啾啾候虫鸣，辛苦如之何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂兴六首 其三","author":"陈耆卿","text":"墙西几筼筜，我昔手所种。\n年来饱风露，锦绷纷错综。\n种善如种竹，此语合擎诵。\n眇然方寸间，仁不可胜用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂兴六首 其六","author":"陈耆卿","text":"炉烟上疏棂，闭户白日静。\n尧舜亦人耳，万善吾所性。\n纸上空支离，言外独辉映。\n一笑千载宽，此乐无终竟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和芥庵韵","author":"陈耆卿","text":"孟轲谈一本，孔子号无我。\n圣贤超警趣，不作流俗堕。\n故能贯堪舆，中立而不颇。\n黄冠宗无为，衲子只打坐。\n言若高峭甚，又与圣贤左。\n须于真实处，大海稳扶柁。\n须于疑似间，曲户牢著锁。\n世道震遂泥，人心履俱跛。\n竞作夔怜蚿，徒劳螟祝裸。\n芥庵之心镜，渊珠光彻颗。\n常时足欢娱，此日类坎轲。\n乃能贞其颐，不为名利朵。\n敲棋声落枰，哦诗气摧垛。\n此外澹一视，泰山如草蓏。\n未妨师孔孟，匪涉佛老惰。\n汩余抱孤戆，匪惟絷庸琐。\n涉世虽云阔，诣理犹未妥。\n正性水下月，邪焰风中火。\n因子当自强，朝闻夕死可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种麦","author":"陈耆卿","text":"新谷未升陈谷罄，宵人托麦以为命。\n今年种麦如去年，去年满屋今空田。\n吁嗟皇天毋乃戾，去年浙右当死岁。\n湘中死寇淮死兵，留得东州仅旒缀。\n只今艰食遽如斯，岂是造化有乘除。\n我无一语活四海，对之泣下徒沾裾。\n催租官吏如束湿，里正打门急复急。\n眼中安得豳风图，绘出麦田蓑与笠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种菊","author":"陈耆卿","text":"手种黄金花，摩挲待其成。\n朝来风雨过，万汇秋竛竮。\n起问花知不，独立常亭亭。\n尝于清霜下，退然得此生。\n南山与东篱，我亦学渊明。\n久落尘网中，问花花不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻湖寇","author":"陈耆卿","text":"淮上兵戈血染川，浙河饿莩骨盈船。\n又闻寇盗湖南起，不觉迟回夜半眠。\n食肉贵人无恙否，剥肤巧吏尚依然。\n吾皇圣德如天大，谁采吾言作奏篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读经口占","author":"陈耆卿","text":"盘诰通凡民，风雅出贱隶。\n后世诸老生，怀疑以没世。\n喧呶挟训诂，洋溢满天地。\n多闻岂无取，大义恐憔悴。\n譬彼医之工，用药不相比。\n未足以愈病，或者反致祟。\n我欲刊众讹，引之于平易。\n当世无圣人，谁其哀此志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汤正仲墨梅","author":"陈耆卿","text":"閒庵笔底回三春，平生爱为梅写真。\n只今龙钟已八十，双瞳挟电摇青旻。\n芒鞋辙迹半天下，学语儿曹读君画。\n孤根踞铁几经年，转作平梢月倒挂。\n我家破屋同蜗牛，素壁悬来春复秋。\n试携纤练觅天巧，门外观者何其稠。\n真花著雪苔枝丑，君为描摸应添瘦。\n朝开暮落春不留，岂若墨本堪不朽。\n临风静玩意趣长，何当烂熳挥满床。\n孤山老人醉中见，便欲信手赋暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 再赋","author":"陈耆卿","text":"艳朵珍丛间舞衣。\n蹴球场外打红围。\n小舆穿入花深处，且住簪花醉一卮。\n秋欲尽，最怜伊。\n江梅未破菊离披。\n情知不与韶华竞，回首西风怨阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 母侯置酒南教场赏芙蓉","author":"陈耆卿","text":"莫惜花前泥酒壶。\n沙场千步锦平铺。\n将军闲试临边手，按出吴宫小阵图。\n清露里，晓霜馀。\n娇红淡白更怜渠。\n人间落木萧萧下，独倚秋江画不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"普惠院劝农","author":"陈致一","text":"青麻幪幪近人长，小麦青青大麦黄。\n令尹出郊闻好语，春来喜有半年粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈般","text":"四十三年住此间，八十八岁尚红颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简樊谦斋","author":"陈茝","text":"一疏辟人千，孤忠殊可贤。\n丈夫不至此，君子有加焉。\n事济民生福，言违臣职愆。\n还须誊谏草，痛哭九重前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"螺江庙","author":"陈谊","text":"庙里杉松萧飒风，庙前江水碧溶溶。\n凭阑不见当时事，落日远山千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一念","author":"陈起","text":"一念无尘杂，三更有梦回。\n同他石桥老，过水探寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一榻","author":"陈起","text":"一榻世缘轻，毋将事物萦。\n昔人言岂误，慧自静中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与适安夜饮忆葵窗","author":"陈起","text":"人在江干月上卮，不妨想像一篇诗。\n月来即是葵窗至，对景成三忆曩时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"井亭桥","author":"陈起","text":"桐花夹岸柳遮山，水面谁家燕子还。\n摩利阁边唐相井，濯衣人散暮潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕雨中偶成四绝奉寄东斋 其三","author":"陈起","text":"车驾行将享孟春，月收梅影可愁人。\n雨师不管閒歌舞，预向天街洒暗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕雨中偶成四绝奉寄东斋 其一","author":"陈起","text":"片云才起月无辉，一缕沉烟对雨时。\n病后情怀慵把酒，看他儿辈探官嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕雨中偶成四绝奉寄东斋 其二","author":"陈起","text":"歌吹萧条灯火稀，况逢连夕雨垂垂。\n黄堂景色非街市，应对山棚赋好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕雨中偶成四绝奉寄东斋 其四","author":"陈起","text":"浪儿归去抱愁眠，孤负霜蛾与孟蝉。\n润泽翻为田父喜，红灯带雨卜丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分得春禽效香奁体","author":"陈起","text":"数声应寄春消息，才转花梢浓绿隔。\n早知襟韵倦逢迎，莫遣临风情脉脉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"友人新息满月","author":"陈起","text":"兰砌欢传书种子，宝刀剃发月初弥。\n绝怜雅致高于俗，点易残朱抹囟儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]