[{"title":"到徐晚村点木?三首 其二","author":"陈著","text":"□□□□□□□，出门犹有梦悠扬。\n五更风里秋初旺，十里湖边雨亦香。\n才出江头腥满市，却行潮脚淖濡裳。\n□□□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到徐晚村点木?三首 其三","author":"陈著","text":"山民垦种不供炊，专把山林抵岁支。\n父子风涛关性命，官司分寸取便宜。\n泽梁无禁是三代，竹木有征何待时。\n便尽放宽能几许，低头不问只攒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到梅山次韵弟茝 其一","author":"陈著","text":"山家见秃翁，欢笑走儿童。\n坡竹势飞动，楚兰香暗通。\n盍分半席地，相扇一瓢风。\n世事非吾分，何妨诗自雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到梅山次韵弟茝 其二","author":"陈著","text":"相对两衰翁，此心无复童。\n幸叨无事坐，贫欠有钱通。\n菜粥琴书画，梅花雪月风。\n黄尘在门外，劳隐是英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"单君范过西皋迂途来访一诗道别","author":"陈著","text":"老境途迎作梦看，出门相送是愁端。\n分携不去有心在，长揖无言回首难。\n雾雨暗山家信远，春风吹笠客心寒。\n儒生例是多劳役，幸得琴书路尚宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周翁留饮酒","author":"陈著","text":"晓对山翁坐破窗，地炉拨火两相忘。\n茅柴酒与人情好，萝卜羹和野味长。\n外面干戈何日定，前头尺寸逐时量。\n而今难说山居稳，飞马穷搜过虎狼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吴竹修","author":"陈著","text":"滔滔世事黯难言，忽忽光阴况晚年。\n草野姓名萤爝里，江湖消息马风前。\n论交有得无新故，处变如常是圣贤。\n何幸相知足磨琢，言诗须到赐商边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和息庵呈蒙山韵","author":"陈著","text":"象骖来自海之滨，何幸相逢孤独园。\n好句不妨诗共屋，戏言敢及赋名坤。\n江湖自有清风调，云月难招流俗魂。\n千里文章本同味，几时樽酒细重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏孙常州飞蓬亭","author":"陈著","text":"藕花池上竹梅阴，一舣中閒用意深。\n画舫规模供燕适，虚舟世界看浮沉。\n快风未信千帆福，逆水难凭百丈心。\n惟有此蓬飞已定，更无惊浪怒涛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜酌丹山","author":"陈著","text":"石路深深著梵宫，绿阴截断出尘红。\n春风杖屦閒忙外，明月山林醒醉中。\n有酒何须白莲社，无诗可入碧纱笼。\n归途自有儿扶笑，不用过溪劳远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿倪庵坐雨二首 其二","author":"陈著","text":"连朝云霭霭，一夜雨飕飕。\n涨雾黑天晓，洗山黄涧流。\n润深麻长骨，湿重麦垂头。\n春水可农事，只愁兵未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿倪庵坐雨二首 其一","author":"陈著","text":"一自入庵来，翛然百念灰。\n松风晴后雨，涧水静中雷。\n邻户祈蚕母，樵翁挟雉媒。\n若无山外事，何必过天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孟春书怀","author":"陈著","text":"老健羲娥不住车，东君依样做年华。\n十来日雨洗梅萼，一半春风归杏花。\n醉里出门忘故我，閒心到处是吾家。\n临溪忽悟前程事，流水方生未到涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"季秋入城郡人迎鲍王有感","author":"陈著","text":"满城呵道涨黄尘，仪卫森严亚玉宸。\n幕帟游魂勋阀旧，鼓笳杀气谱家新。\n西风儿戏知何世，末俗民心只有神。\n兀坐僧窗增感慨，梁公已矣更谁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海","author":"陈著","text":"一夜南风便叶舟，天教偿我定川游。\n两崖踞海潮吞脚，万石封堤水掉头。\n家家活计鱼虾市，处处欢声鼓笛楼。\n不用丹青状风景，逢人且说小杭州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊丈亭","author":"陈著","text":"丈亭亭下浦，舣棹又终朝。\n船聚市声杂，风生江气骄。\n兹行未百里，已涉第三潮。\n去住向谁问，鹭飞云影飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范公亭归途","author":"陈著","text":"客窗连日雨，晨发趁晴光。\n秃鬓去秋老，倦心愁路长。\n终须山坐静，有感水流忙。\n更有难言处，乾坤事渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗送读易堂张碧窗之扬","author":"陈著","text":"占得资身话柄高，六鳌岛上足逍遥。\n南风又送飞霞佩，北道相期明月桥。\n要坐虎皮专说易，肯携凤侣共吹箫。\n此行直上青霄去，不比闲缠鹤背腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中旅怀呈郑耐轩","author":"陈著","text":"日日约归舟，谁知雨又留。\n满城为海市，数步有蓬洲。\n湿梦风难送，急心天与仇。\n今朝好晴色，著履可来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中留范晓村家","author":"陈著","text":"年来常闭户，一动自知非。\n坐雨诗消闷，思家梦当归。\n山林容自拙，道路目孤飞。\n便整回头步，西园笋薤肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后雪","author":"陈著","text":"深山雨易雪，片大不成花。\n翁媪热摩面，儿童寒战牙。\n如居峨顶寺，休问洛阳花。\n宜麦今虽兆，明年事未涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨留景山家","author":"陈著","text":"桂后菊花前，相逢梦觉然。\n閒心时外话，亲意雨中眠。\n投老会难必，临行留更坚。\n西风亦解事，未肯放晴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其九","author":"陈著","text":"道路尘方暗，田园事岂差。\n营巢难老鹤，谋啄拙饥鸦。\n时有诗题壁，多因病在家。\n学仙非骨相，枉是住丹霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其二","author":"陈著","text":"羡君培早学，人十己千之。\n燕雀谁知我，蛟龙自有时。\n文场魁众后，计幕主相知。\n天地如长泰，功名何可涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其四","author":"陈著","text":"人生无足处，知足是良方。\n自种荪成墅，时同云出乡。\n江湖残梦杳，山谷本心长。\n回首门前事，风潮战石塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其八","author":"陈著","text":"我才虽不武，纵靶洛阳桥。\n本是士行志，非因贫折腰。\n天风吹劫火，国事付回潮。\n待尽山深处，汗颜猿鹤邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其五","author":"陈著","text":"平平聊送目，咄咄不书空。\n静见蜗争国，穷知马福翁。\n逢人无眼白，耐是得颜红。\n如此閒光景，何须到弱蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其三","author":"陈著","text":"乾坤今似许，焮祸自非材。\n危活矛头米，惊愁笛里梅。\n世方淫佛老，谁肯问参回。\n太息复太息，吾徒何以哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其一","author":"陈著","text":"小小山前屋，深深竹里门。\n艰关谙世梦，宽绰养天根。\n趣涉诗书圃，名归耕钓村。\n日长无一事，笑诺子孙繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其七","author":"陈著","text":"世运空更禅，人情任覆翻。\n浮荣归堕甑，真味寄污尊。\n见客不问事，学农时踏村。\n兴公旧游处，长啸一招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其十","author":"陈著","text":"诗卷劳相寄，吟高欲和难。\n澹情如水接，秀句共霞餐。\n妄奏蛙声乐，叨盟马血盘。\n岂能无牴触，一笑幸吾宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞荪墅示以杂兴四首乃用危骊塘所次唐子西韵因次韵 其六","author":"陈著","text":"学得无名氏，游于何有乡。\n熟眠胜醉酒，清虑当焚香。\n富有书连架，贫无盗伏梁。\n只应诗社友，时节到门墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸淳元年乙丑冬同金陵制幕诸公游旧乌衣巷新来燕堂制参董静有诗因次韵","author":"陈著","text":"王谢风流堕渺茫，黯然怀旧见新堂。\n山无多树夕阳远，梅始一花春意长。\n燕去有时来画屋，鹤飞何日到青冈。\n休言枉洒新亭泪，犹胜如今似醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城中赴范纯甫酒有感","author":"陈著","text":"杜鹃啼断洛阳桥，心与萍流絮与飘。\n风雨故都同死梦，山林晚景十年饶。\n相逢得醉有今日，万事忘言付落潮。\n见说隐居归我里，尚堪鸡黍狎招邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城归憩吴竹修家一诗写怀","author":"陈著","text":"去时桃未蕊，归见石榴花。\n白首镫前酒，青山梦里家。\n鹃声心路梗，蚊毒面皮麻。\n劳苦书生事，堪嗟老未涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拜先外舅墓坐雨用赵景文韵二首 其二","author":"陈著","text":"卷怀经笥袖名鞭，千载阴何暗结缘。\n清似岁寒松独立，健于霜晓鹘争先。\n尘埃事与心相避，醉梦人看眼亦鲜。\n肯使鸡林浪传去，纷纷吟梓不同年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拜先外舅墓坐雨用赵景文韵二首 其一","author":"陈著","text":"说著韬翁泪泫然，得来展墓及春先。\n松楸旧垄惊如许，风雨寒宵坐有缘。\n馀味淡交微醉酒，回头流俗未烹鲜。\n明朝又别西山去，多少怀思集晚年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拜赵端斋墓有感而书","author":"陈著","text":"流俗滔滔逐乱尘，典刑卓卓老宗臣。\n山川在眼孤忠泪，风雨无家一梦身。\n及奠生刍吾已晚，忍看宿草自成春。\n方来世事谁能料，须认分兵护墓人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偶成二首 其二","author":"陈著","text":"乌兔催更日夜番，独于衰朽尚相存。\n世情富贵鲍鱼市，老眼风流麻鸟村。\n牢立诗肩撑雨屋，施营酒料续春樽。\n芒鞋又办游山计，我亦兴公不姓孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偶成二首 其一","author":"陈著","text":"老景还逢春一番，尚能消受自温存。\n蚕寒风雨梨花屋，蕨熟人烟桦角村。\n无事课儿多闭户，有时见客一开樽。\n旁观莫笑谋生拙，元是诗书旧子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春残","author":"陈著","text":"出门随意踏苍苔，过眼时光一笑陪。\n二十四风清绣地，两三点雨试轻雷。\n缬空舞絮随春去，钿水娇荷闯夏开。\n对景伤心儿女事，刚肠无奈祇衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚课摘茶","author":"陈著","text":"玉川子后是吾生，自课园中拾晚荣。\n搀雨金芒排世好，饱春香瓣见天成。\n不烦钲鼓腾山啖，剩有旗鎗战酒兵。\n凤舞赐团今绝想，只凭苦硬养幽清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柏溪岩头","author":"陈著","text":"晴色上游筇，西行二里中。\n荠花黄缬地，麦穗白潮风。\n纸杵鸣山屋，斋钟出梵宫。\n归途须傍早，要折石岩红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"段县尉以兄约斋二诗求和因次韵","author":"陈著","text":"兄弟谁无仕宦情，约斋好处最分明。\n自缘友□勤相逊，可是诗怀要独清。\n道义终身为日用，功名外物等云轻。\n闭门见说都无事，教子诗书是治生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸未生日书于本堂","author":"陈著","text":"与云俱卷十年强，百短难医独命长。\n自有青天看晚节，不将白发换时妆。\n田园活计雨声好，湖海醒心山气香。\n得一日閒胜一岁，老来免得别思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜偶成","author":"陈著","text":"小筑尘嚣外，清标秋气中。\n荻花浑妒月，梧叶已嫌风。\n钓箔惊檐马，册灯觅候虫。\n困来还倚竹，此意有谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚新晴","author":"陈著","text":"杖屦访郊晴，秋光泼眼明。\n溪痕经水没，山面拨云呈。\n霞影收虹影，砧声急雁声。\n芙蓉花在否，滑路倩人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胜因院","author":"陈著","text":"转路便幽深，曾来不用寻。\n寺依仙石脚，僧识老岩心。\n是处鬼无墓，此山松自林。\n滔滔未涯事，分付一蝉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵氏楼偶成","author":"陈著","text":"过耳南宫捷奏铃，功名宿梦顿呼醒。\n清风席上龟占古，细雨楼头鹊语灵。\n袖里瑰文珍白璧，眼中霜颖锐青萍。\n问津当继宣和躅，要得人言更妙龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送女清适宁海胡氏回次韵弟观净慈诗写情","author":"陈著","text":"自恨当年许嫁轻，临歧悲哽不能声。\n痛肠恃酒翻多病，险道登天仅得晴。\n女欲有家生世事，谁知与父别时情。\n是虽婿玉□堪抱，南望云山泪自倾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送东平赵孟益赴徽政院译史","author":"陈著","text":"秀出东平礼乐关，将车来览小南山。\n西风承命双亲下，上国媒身九译閒。\n腾踏青云金驿去，笑迎绿发锦衣还。\n气方锐处须珍重，莫把赠言为等閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同少野赴华藏寺二首 其二","author":"陈著","text":"落花流水去帆孤，风雨交情奈老夫。\n诗屋知谁共云月，笑图和我入江湖。\n千山遮眼梦自到，万笠传声书可无。\n家有寿翁垂百岁，尚因归省及桑榆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同少野赴华藏寺二首 其一","author":"陈著","text":"絮帽蒙头太白峰，忽然霹雳起虚空。\n遁庵强出本心退，荼毒高迁好样同。\n南北云山十年梦，东西浙水一家风。\n无边福量如何说，龙象都归禽纵中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江瑶与人","author":"陈著","text":"玉瑶分自海仙奁，藜腹新来约束严。\n入手颇忧穷鬼捩，收涎已绝老饕餍。\n何妨带甲归庖惯，相与调珍助齿甜。\n要识淡中滋味永，多加椒酒少施盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送阮子俊归池阳","author":"陈著","text":"袖携诸老义门诗，烨烨精神起病衰。\n千里远来风教地，一言不及浪游私。\n山家饭粟论交淡，驿路逢梅信步迟。\n古道蔼然三代上，由来好事要扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严心传鄞县学教任满","author":"陈著","text":"贤哉昔鲁山，心地出芝兰。\n不负义方教，相传本色官。\n三年脚根正，万里路头宽。\n须信功名事，要教人耐看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送严伯长教授邑庠任满","author":"陈著","text":"手扬教铎下龙汀，三载从容擅最称。\n禄釜半虚家继廪，书窗独冷仕如僧。\n狎曾问字春风坐，惜欠论心夜雨镫。\n此去兰台芸阁邃，尚须时寄一溪藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别单君范","author":"陈著","text":"寒山曾约醉梅香，桃李花时愿始偿。\n四海旧交知有几，三年一见去何忙。\n春光自好别情恶，老语无多赠意长。\n送到溪头重回首，东风吹不住垂杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张子乔之杭","author":"陈著","text":"文旆舞翩翩，西征兴浩然。\n树香三井路，花影六桥船。\n酒贵难为醉，诗清易得传。\n丈夫须衣锦，宝重黑头年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李仲实官郡学任满归馀姚","author":"陈著","text":"手分教雨□邻庠，咫尺何分明越乡。\n一正不为崖壁异，三年相与藻芹香。\n梅花时节催行色，藜燄风流要当行。\n应有青云扶健翼，摩挲老眼看翱翔。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送苏松轩路教解任","author":"陈著","text":"三载多材地，一团和气乡。\n蛙池疏道脉，蓬岛矗文芒。\n明日归舟稳，春风驿路长。\n词林是毡旧，此去足翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邑宰丁溉解任置酒取别因赋示","author":"陈著","text":"古道转悠悠，送君那值秋。\n恶怀醒似醉，苦语去难留。\n镫雨今宵酒，帆风明日舟。\n从今梦相见，老眼在心头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沿江制使姚橘州尚书自金陵赴召三首 其三","author":"陈著","text":"当年赤手战南宫，道眼收归造化中。\n欲把一陶成异日，已教两度受春风。\n登门英俊知何限，著意孤寒却最丰。\n但愿身如秋后菊，橘州深处寄霜丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沿江制使姚橘州尚书自金陵赴召三首 其二","author":"陈著","text":"阃寄当今第一难，三年裘带笑谈閒。\n宽扶民力野声乐，静压边风江水閒。\n□□有缘钟阜住，清朝却诏履星还。\n过家闻说须留憩，荷满江洲笋满山。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]