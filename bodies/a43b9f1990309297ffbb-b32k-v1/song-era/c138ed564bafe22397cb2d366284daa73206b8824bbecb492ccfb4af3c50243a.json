[{"title":"东津净行院","author":"李新","text":"老于春事无交涉，退作淘金榻底沙。\n蚕到两眠方健叶，柳成三倒却飞花。\n小桃涨浪堤痕润，绿麦翻风燕羽斜。\n不得毫釐稽古力，起人松竹问谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代张元老上许漕 其二","author":"李新","text":"文章摛锦已堆胸，直指威声俯仰中。\n蜀部星高千幛静，平舆龙起一渊空。\n阅人妙学函明镜，飞镝清心本素风。\n垂手污涂收酱瓿，为怜识字老扬雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代张元老上许漕 其一","author":"李新","text":"人在坤维久覆醯，故教使节出天西。\n后来武库成清职，平日家风归品题。\n欲见流钱凭马策，稍闻刮膜待金篦。\n鸰原曾冠仙鳌顶，应觉人间太华低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"令狐秀才书堂","author":"李新","text":"剩撷芸香辟蠹鱼，足音差远自逃虚。\n春醅已许暮留客，冻笔不妨寒著书。\n龟甲屏风云散漫，月窗花影树扶疏。\n他年子伯无閒暇，但遣儿曹访隐居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至夜宿颙口市","author":"李新","text":"宁辞举棹频，不觉又黄昏。\n有感逢冬节，无穷宿水村。\n客心愁待旦，杯酒强开樽。\n共祝同欢庆，亨途莫我论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出茂州","author":"李新","text":"日落城空鸟少知，战场依旧昔人非。\n雪花笼石商皓首，枫叶满山秦赭衣。\n月入空罍人自耻，尘蒙西榻客元稀。\n穷荒石纽那生禹，料得当时殛鲧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北窗偶成呈遗逸","author":"李新","text":"北窗冰研碎鱼鳞，未伏徐翁笔有神。\n止酒诗成三径晓，买山钱就一家春。\n饥鼯如市莫欺客，穷鬼作朋终笑人。\n未敢移文谢逋客，且看除道过蒲轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半方壶诗","author":"李新","text":"讘人未得老三山，半作方壶忆夜坛。\n鹤本令威来汉表，凤翔萧史下琼栏。\n到门佳客双凫落，入座清风六月寒。\n破灶黄金已无数，定知云翼说烧丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古塞","author":"李新","text":"曾经古塞间，万里控长关。\n卧日边鼙旧，嘶风战马閒。\n戍楼喧暮角，羌笛怨空山。\n应贺升平久，车书混八蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月晦书事","author":"李新","text":"业无家酿致邻翁，得有薪温引颊红。\n准拟片言能悟主，复求一饱定伤弓。\n诗书奴婢晨占鵩，盐米妻儿夜送穷。\n早晚郊原莫零涕，动摇葵麦有春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉江","author":"李新","text":"低霭横沙碧，长滩宿雁孤。\n樵薪窥树瘿，渔父就龟趺。\n落日骈游女，鸣波咽佩珠。\n啼乌与惊鹊，先我渡城隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉源馆","author":"李新","text":"消热层冰远，投凉嘉树稀。\n雨晴潇洒去，梦与泬寥归。\n禽静谷无语，云生山有衣。\n路行知水好，终不疗长饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子春趋太学过华山赋仙掌峰","author":"李新","text":"一掌巍然占碧巅，分明高举欲擎天。\n升沉尽待招携力，指点都归造化权。\n好与清霄扶日月，莫留寒嶂弄云烟。\n不知千古兴亡事，屈指而今是几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春前密雪应祈呈范内翰","author":"李新","text":"六出飞霙岁或愆，喜观琼砾晓滂然。\n水官休隶一时惨，木帝已誇群物妍。\n斗换石田皆沃坏，暗催云稼入丰年。\n吾君诚祷通旻昊，愿听氓谣被管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙兴行香游宝莲寺","author":"李新","text":"鱼舞天清日，经行小刹初。\n松柯青羽葆，贝叶细蝇书。\n杜画奇无敌，周妻俗有馀。\n业无支遁辈，难自卜幽居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙洞","author":"李新","text":"龙睡抱明月，我来窥碧浔。\n撄鳞徒有志，探颔本无心。\n雷去春霖足，云归夜水深。\n馀波应不惜，好为濯尘襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙游寺南屏轩和宋宏父韵","author":"李新","text":"平日江干过，南屏首重回。\n不妨图里见，曾是梦中来。\n近市楼台逼，高城鼓角催。\n老年知涉世，临事却衔枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴利山居","author":"李新","text":"江左风流恐未真，南州人物竟成尘。\n全家莫恨瘿张丑，四国且图山作邻。\n小漏天光浑失热，绿槐树盖始知春。\n柴扉昼钥能高枕，一到华胥胜路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘子常约赏海棠","author":"李新","text":"共愁明月照空杯，莫逐时人溺死灰。\n百日酒随山客尽，一年春逐海棠回。\n门无辙迹草自长，燕不世情贫肯来。\n豆饭芋羹容易继，明朝花落不重开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘小漕 其三","author":"李新","text":"五云入梦翠浮空，正在高阳巴里中。\n八叶蓂含天露绿，千年桃映海波红。\n流钱远裔争推晏，青史何人独比雄。\n白面门生指椿桧，愿肩华发倚春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘小漕 其二","author":"李新","text":"小槽轧玉逗琼浆，满酌金花荐寿觞。\n已有骏驹传骥足，莫辞持节下羊肠。\n护诗何处无灵物，报国新来有皂囊。\n要觅甘棠寻旧爱，莫云千里蔽柔桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘小漕 其一","author":"李新","text":"乱红缬眼柳花飞，烟抹沱溪秀一围。\n北背美人占梦去，夕阳行客舞雩归。\n三吴父老传冰节，两蜀江山识绣衣。\n预草封章千百纸，此身明日接天威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同宋长江登江店唐氏山阁","author":"李新","text":"白头记室朱颜令，山阁忙来去却迟。\n碍尽江天松不管，吹平沙篆雁应知。\n思倾竹叶疑无分，要赋梅花恰是时。\n王粲从军归信近，贮囊试看几多诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安溪","author":"李新","text":"岸草绵绵一叶舟，野烟开尽水光浮。\n寺连野竹微茫见，溪出寒山自在流。\n愁里诗情随浩渺，鸟边春梦入钩辀。\n泉嘶石鼎新茶熟，且为山僧更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早梅","author":"李新","text":"冥寞元崖宅有神，冷香寒色漏天真。\n感深暖日常为力，杰出飞霜恐后春。\n千里故人何以寄，一枝幽意望谁亲。\n孤标若值芳华菀，羞与妖红碧树邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子温检覆书事","author":"李新","text":"博山灰冷一星寒，散乱文书少读残。\n夕饮清冰消热易，梦为胡蝶过家难。\n潘郎桃树参差见，沈老腰围隐约宽。\n雅量故应容懒拙，功名同向镜中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵任使君咏梅二首 其二","author":"李新","text":"平时化力与扶持，莫道春工未肯私。\n暗有浮香通淡月，瘦无寒叶到空枝。\n腹中太白何多锦，句下韦郎自不知。\n阴谷未开公见否，葭灰暖律更烦吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵任使君咏梅二首 其一","author":"李新","text":"堂上高人解赏音，孤根未放草来侵。\n不妨此后颁春力，却得从前爱日心。\n模腊曾看黄淡淡，试妆犹恐晕深深。\n而今驿使行如织，听取新来塞上吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵员子春游马溪二首 其二","author":"李新","text":"树影阴蒙径，云衣浅扑门。\n禅心无冷暖，客意自晨昏。\n涧水鸣珰破，山花野血喷。\n再来何薄暮，驺从触狐蹲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵员子春游马溪二首 其一","author":"李新","text":"有花栽性地，馀法寄灯房。\n虬蜿骈松瘦，钟寒殷谷长。\n赤髯班石坐，白骥踏云骧。\n一夕参玄客，森森出虎场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张永锡待制留题通泉聚古堂","author":"李新","text":"及时瓜李任浮沉，畏景游云苦太侵。\n环县江流元渺渺，参天乔木自森森。\n七言妙语腾光焰，八法新题冠古今。\n闻道宵征最清处，风翻旌旆月流襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵苏必强见寄","author":"李新","text":"不知暗室鬼揶揄，曾入鱼凫伴蠹书。\n分背雁音清汉远，动帘风竹故人疏。\n小桃烟老三年树，白马原空百两车。\n消去泪流冰箸若，待凭浊酒一樽馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵重阳二首 其二","author":"李新","text":"故事登高会，流风落帽文。\n客樽常满满，篱菊任纷纷。\n马埒摅豪气，萸囊想旧闻。\n不须兰作佩，骚客恨如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵重阳二首 其一","author":"李新","text":"蜂愁节去已焉哉，宾友追称上宴台。\n诗韵此时传我和，酒樽当日为谁开。\n光阴碌碌驹奔过，气候新新毂转来。\n身赴令辰如舞袖，急忙须趁管弦催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵解君接感怀 其一","author":"李新","text":"能向风尘识马周，新丰饮尽得相留。\n后车惯载胡王缚，衰草频惊战马秋。\n灵武须公来辟土，桃林他日待归牛。\n承平卫霍知虚老，剩著新篇继日休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵解君接感怀 其二","author":"李新","text":"太平事业按商周，麟阁仪形待子留。\n壮士长歌三箭定，鸱夷归老五湖秋。\n生涯底事空藏剑，英气平时已食牛。\n歌扇舞衫今太寂，暮云佳句敌汤休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江提仓生日二首 其二","author":"李新","text":"自应骑鹤下浮丘，雅意人间事俊游。\n长久方壶新岁月，飘飖江左旧风流。\n岩椿骨老三千尺，佳气春回十五州。\n温诏趋归行有日，此封端是富民侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江提仓生日二首 其一","author":"李新","text":"青锁沈烟暝著沙，芙渠云帐晓吞霞。\n南金人物无双士，宫锦文章自一家。\n赏过十分银汉月，采归千岁海桃花。\n蜀仙行劝长生酒，燕寝凝香碧雾斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西岗重九","author":"李新","text":"天涯一角见重阳，萧洒西风客断肠。\n麻纻未更今日白，菊花还似去年黄。\n陶潜把酒重开解，宋玉临墙乍感伤。\n借问龙山歌会者，座中谁认绿衣郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观前古美人图","author":"李新","text":"璧月尘昏琼树秋，无从百媚一回眸。\n荼蘼香度梅妆冷，鹦鹉声低玉笛幽。\n唾背但能知祸水，逢春且莫上迷楼。\n归来安守无盐女，不宠无惊共白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梁辅之晓阅","author":"李新","text":"羽林出戍死忘家，坐作行趋听虎牙。\n碧月初生弓入抱，青蛇不动剑藏花。\n风吹细柳旗阴转，日过寒溪阵脚斜。\n回笑书生头白早，空将笔砚战年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观澜堂 其一","author":"李新","text":"风观生凉底事雄，五湖烟浪一堂中。\n公方观水那无术，客欲工诗正坐穷。\n翻出秋潮真是幻，化成蓬峤本来空。\n笔端造化浑奇特，为扫茅茨半亩宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观澜堂 其二","author":"李新","text":"铃阁文书得少休，故将湖水慁清眸。\n似从天姥逡巡坐，拟放仙槎自在流。\n具眼不随千派转，此身元并一沤浮。\n羌谁戏墨通三昧，信是人间万法俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长滩","author":"李新","text":"尾劄泥涂贱此身，手提鸡肋恋虚名。\n芦花伴我头俱白，山色迎秋意转清。\n沙软马留金袅印，雁归滩列水犀兵。\n尚能趁得黄花酒，听取东篱笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过冯十夜饮见烛花有作","author":"李新","text":"世事不知浑井底，巴音犹在已天涯。\n攻愁有酒杯吹浪，报喜非春烛自花。\n贾谊长才空赋鵩，东陵馀地欲栽瓜。\n诏书许逐阳和至，宁乞西山度岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过永安院","author":"李新","text":"山暗云垂地，溪回树倒流。\n诗随梅冷落，梦入鸟钩辀。\n欲住无佳致，重来即旧游。\n村眉攒八字，已解作春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过江游灵泉寺","author":"李新","text":"徐卿才力已无双，几日飞书约渡江。\n岸石有纹欺锦绣，野芦无数认旌幢。\n酒投渤澥难招偶，诗筑长城欲受降。\n玉麈清谈更通昔，定容寒月半侵窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过何权道幽居不遇","author":"李新","text":"水部风流小隐居，别来眼法定何如。\n雾中不见空峒子，世外空传珞琭书。\n今岁紫荆簪未得，后溪黄鲊食无馀。\n素冠如遇文园宅，为我慇勤借子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过卧龙先生幽居","author":"李新","text":"手调鼎剂作清凉，不秘千金肘后方。\n閒数岭云松自翠，卧听梅雨药初香。\n三山梦断黄粱熟，一径莓封白日长。\n我欲从公结幽隐，不干泉石解膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问田尉公俞丐菊栽","author":"李新","text":"冷官厅外病阴阴，犹向西风拥鼻吟。\n梅福尽藏云外宅，陶潜难老菊边心。\n许因秋社前头雨，分与东篱匝后金。\n待到重阳不开放，却收樽酒去相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问张兴州觅酒","author":"李新","text":"䟃?云阵暮天低，家在云天西畔西。\n雪片未容欺白发，貂裘不管污黄泥。\n梅寒花晚休吹笛，水瘦江空莫照犀。\n便有绨袍怜过客，不如春酿亟封题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问俗","author":"李新","text":"穷极天窥涘，幽阴地绝春。\n石坛荒誓鬼，药媪下羌神。\n斗雀分疏事，晴山亲近人。\n刲羊留髓骨，正欲卜归辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阴伯庸悼词","author":"李新","text":"妙年词墨一何工，汉苑家声戚里雄。\n居避飞尘门似水，客投漫刺袂生风。\n香消绛帐鱼难蠹，月照银杯酒不空。\n阳报岂须穷宝箧，凤雏行看赤霞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈恩主户部郎中 其二","author":"李新","text":"何必庭皋木叶黄，秋风无处不凄凉。\n莫言短发游郎署，且伴閒云入故乡。\n汉殿早瞻新日月，剑屏犹带旧冰霜。\n一飞碧落三千里，还向瑶池浴凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈恩主户部郎中 其三","author":"李新","text":"翠轺行色倦秋阴，且听新来泽畔吟。\n云起已知山有助，鸟啼争奈竹无心。\n斗光指客求佳气，桐尾收烟得好音。\n他日欲通千里信，西风吹雁亦浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋隐君挽词","author":"李新","text":"贵口轻翾意自融，鸣柯芥羽逐春风。\n猗欤宋氏青云器，师我缁川白发翁。\n沃壤可彰千载义，旧窗空负一生功。\n新阡无用栽凡木，待看奇才长碧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿王提举二首 其一","author":"李新","text":"新岁祥分葆羽车，老君抱送浃云霞。\n夏正更籥称觞近，蜀道占星故国赊。\n尚忆前时司玉牒，试簪明日剪金花。\n这回飞燕知恩旧，肯到寻常百姓家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿安夫人挽词","author":"李新","text":"闺门秀色擢冰清，行佩兰苕八十春。\n传道先生为择配，起家著作不忧贫。\n金花贴子分双轴，子舍登瀛有几人。\n千仞龙华松竹域，妇姑虽死亦相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张安化重阳日置酒挽同官游灵泉寺登高时适有客占牧之诗一联因缉成一首书寺垣","author":"李新","text":"白发新迁客，黄云古战场。\n自然堪堕泪，何必更重阳。\n山削孤城起，河兮细水长。\n蜀峰高处望，犹是隔秦乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜鹃","author":"李新","text":"终日欲归去，蹉跎空岁华。\n只知催客泪，何处是君家。\n寄子他巢稳，颁春故国赊。\n林梢啼不尽，流恨入山花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还三嵎先寄舍弟","author":"李新","text":"客宦乘流同木偶，入村随俗自猴冠。\n鸰飞原上正相应，豆泣釜中当少宽。\n貂阙长忧狗尾续，客来应借凤毛看。\n陇西衣钵传无尽，熟看群儿现宰官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闺重阳","author":"李新","text":"凤历推移二十霜，一回重见闰重阳。\n糯田收早醪将熟，朔气来时菊整香。\n绿鬓不堪禁晚景，醉杯聊可浣愁肠。\n幽人百万扬州鹤，鼎足成欢未易当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈丈挽诗","author":"李新","text":"七十飘生世所稀，初休利锁便忘机。\n清朝有子方干禄，白屋无尘自掩扉。\n高论竞推猗顿富，梦魂翻逐楚庄飞。\n素车白马春郊道，鸾凤相呼旧穴归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮田家洞","author":"李新","text":"日脚归云到坐隅，冻禽唧㗚树扶疏。\n望穷野麦绿不断，春入山梅香有馀。\n恐是滕公千载室，定无汲冢五车书。\n人间可乏贤公子，长铗歌成食有鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和任普州冬至日作","author":"李新","text":"诗成椽笔一何工，元有英声妙洛中。\n已是少师扶日手，更看公子钓鳌风。\n书云宝筴开新瑞，脱木香山堕晚红。\n经济通才犹补外，与骑星鹤问圆穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]