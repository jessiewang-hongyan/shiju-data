provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十一","author":"释印肃","text":"决定说，表真僧，处处和光勿自能。\n有时鼻孔撩天笑，个个众生目患盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一七四","author":"释印肃","text":"菩提达磨为初祖，梁王未契如聋瞽。\n廓然无圣尚求名，拂袖魏邦无处所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○五","author":"释印肃","text":"不是山僧逞人我，此事元来无两个。\n教诠十八不共法，共不共时是什么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其十九","author":"释印肃","text":"无罪福，无损益，不消更念波罗蜜。\n念来年久却成魔，返谤修行无圣力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二二四","author":"释印肃","text":"空拳指上生实解，巡行数墨看经快。\n圆蟾光体指俱迷，枉入三途虚受罪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二二九","author":"释印肃","text":"了即业障本来空，兔角拄丈击狂风。\n龟毛索子穿云鼻，理会乾坤空不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一三四","author":"释印肃","text":"般若锋兮金刚燄，无说无闻非顿渐。\n倚天长放白毫光，祈雨祈晴无不验。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其八十九","author":"释印肃","text":"入深山，住兰若，离色离声无昼夜。\n撞钟击鼓不知鸣，地转天回全不怕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二一九","author":"释印肃","text":"种性邪，错知解，不体玄机持五戒。\n行行坐坐执空观，见境见尘增鬼怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五六","author":"释印肃","text":"体若虚空勿涯岸，通身是口说得半。\n三种病人也会医，灯笼露柱常相伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五七","author":"释印肃","text":"不离当处常湛然，神光也不往西天。\n德山话堕龙潭笑，忍气吞声更不言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○七","author":"释印肃","text":"非不非，是不是，是非不入三摩地。\n一念普观无量劫，无去无来亦无住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一六一","author":"释印肃","text":"默时说，说时默，佛祖妙机无法则。\n除非亲到此门中，棒头取正参方客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一四九","author":"释印肃","text":"一切具足一切地，凡夫不了争名利。\n名利何曾得到头，空能夜壑劳关闭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一六六","author":"释印肃","text":"逆行顺行天莫测，邓隐峰破禅规则。\n丛林动念几千般，倒立归真谁胜得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五一","author":"释印肃","text":"弹指圆成八万门，有无无有岂堪论。\n假设千经并万论，直应迦叶不闻闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十五","author":"释印肃","text":"游江海，涉山川，披云带雨足连天。\n道得亦来叉下死，三千里外为君传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其十五","author":"释印肃","text":"顿觉了，如来禅，岂独东方与竺乾。\n充塞虚空无空缺，一毛孔里现三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五三","author":"释印肃","text":"一切数句非数句，□你玄言并好注。\n灵明烜赫塞虚空，不住色声光布施。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二十七","author":"释印肃","text":"放四大，莫把捉，本无毫发堪依托。\n地水火风亦假名，十二缘生如兔角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二十","author":"释印肃","text":"寂灭性中莫问觅，恰似他乡迷路客。\n东西南北总无知，祇个无知大奇特。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂断觜瓶","author":"释印肃","text":"心法无断灭，踢倒一净瓶。\n华林不奈何，不脱声色名。\n真如俱是戏，心境一等平。\n不落有无用，三昧本空清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十四","author":"释印肃","text":"木匠休愁无酒肉，大家免得落群魔。\n但管来年了，应教不动波。\n随心做个殿，别事莫多罗。\n更有一般好，只个阿弥陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十一","author":"释印肃","text":"骊珠一颗印千峰，越古腾今处处通。\n元禅道贯纤毫绝，方知佛法不曾穷。\n孤云片片标心法，野鹤翘松表自容。\n千眼难观谁解见，赤幡直下起清风。\n妙觉十方无影像，灵知三界绝行踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十","author":"释印肃","text":"陇西达士重标立，万行圆明道果成。\n举目含灵俱是佛，应无所住得其心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其九","author":"释印肃","text":"心月孤圆时，光非十五六。\n迷者以圆观，智者应妙触。\n印危崖，鉴川陆，一性圆通无委曲。\n了非心外逐尘缘，下坂不走天然速。\n谁道速，有佛之处不得住，无佛之处一时足。\n时来铁解放光明，运至石头成白玉。\n幸逢施主大开张，古佛慧命汝今续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其七","author":"释印肃","text":"君不见烂柯仙，一局知他几度年。\n自出洞来谁作对，未曾学手早赢先。\n高不高，玄不玄，默然轻转不能言。\n得失都卢无个事，一时收拾华堂前。\n若人要问消息，落落真风印碧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]