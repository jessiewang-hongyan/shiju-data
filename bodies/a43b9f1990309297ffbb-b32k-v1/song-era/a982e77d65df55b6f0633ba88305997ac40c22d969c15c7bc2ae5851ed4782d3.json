[{"title":"次韵广东芮漕时闻其部中寇退而湖湘之民方避地来此 其一","author":"周必大","text":"笑酌贪泉为赋诗，凛然清节照南夷。\n厩空不纳如羊马，才大常嗤捕鼠狸。\n盗已奔秦非地险，心迟去鲁只天知。\n爱君勤把归鞍促，莫待鸾旗访具茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵广东芮漕时闻其部中寇退而湖湘之民方避地来此 其二","author":"周必大","text":"病废壶觞懒废诗，渐参禅悦学希夷。\n志非鸿鹄宁憎燕，路怯豺狼更畏狸。\n节物匆匆愁里度，人情扰扰静中知。\n已营二顷亲籉笠，何日三间看塈茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王少府送焦坑茶","author":"周必大","text":"昏然午枕困漳滨，醒以清风赖子真。\n初似参禅逢硬语，久如味谏得端人。\n王程不趁清明宴，野老先分浩荡春。\n敢向柘罗评绿玉，待君同碾试飞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王仲谟仲宁唱酬二首 其二","author":"周必大","text":"别日无多似隔年，每逢佳句辄欣然。\n词倾江汉无留碍，语转珠玑更浑全。\n目共荆溪千里月，人居吴郡五湖天。\n兴来傥有山阴作，即上扁舟往执鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王仲谟仲宁唱酬二首 其一","author":"周必大","text":"公子翩翩正妙年，修能姱节本天然。\n弟兄况自逢三益，事业悬知定十全。\n厚意绸缪华映鄂，新诗绮丽月流天。\n乘黄騄耳方争骏，应笑驽骀强自鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵务观迎驾","author":"周必大","text":"法驾朝西内，诸臣许后陪。\n跸烦民更喜，鸢载路无埃。\n我辈犹簪笔，君才合面槐。\n如何车九九，独不与偕来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵白莲","author":"周必大","text":"污沟浊水叶田田，又见新栽京府莲。\n玉井谩传青壁外，雪肤如在射山前。\n泛红入幕王家俗，种白开池陆子贤。\n不用若耶溪畔女，兰桡夜采月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵江州林黄中上巳日会邛州刘侍郎梓漕任直阁于庾楼","author":"周必大","text":"牙旗排槛晓鸣风，楼上何人清宴同。\n东道主开军府盛，西都宾共圣贤中。\n词锋永日论坚白，辇路他年记软红。\n颇念平生故人否，羽觞寂寞坐谈空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵红白莲间生","author":"周必大","text":"閒花不遣倚门墙，独挹芙蕖冉冉香。\n艳质施朱窥宋玉，冰姿傅粉试何郎。\n青茎翠盖元相映，缟袂霞裾各自芳。\n闻道金銮行豹直，炬莲先已兆嘉祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邦衡哭季怀","author":"周必大","text":"谈锋激烈剑芒寒，素蕴光辉珠在箪。\n万里未行骐骥死，百围将半豫章残。\n山中宰相今谁继，地下修文古亦难。\n一读名章三太息，泪流何待雍门弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨文发承议","author":"周必大","text":"才思春江下濑船，腹藏经笱更便便。\n坐观林谷升初日，吟到云山合暮烟。\n忆昨倾囊携过我，知君得句总堪传。\n古来虚诞相如赋，枉使刘郎意欲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀待制二首 其二","author":"周必大","text":"官府新辞上界仙，碧瑶洞口晋桃源。\n默存常在清都境，归去休芜靖节园。\n为问隆楼并杰阁，何如易野及平原。\n明年大作南溪社，会访拾遗花柳村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀待制二首 其一","author":"周必大","text":"十年不侍殿东头，临水登山隐者流。\n一眼瞳方无异相，三层勾曲有巍楼。\n幸殊王粲非吾土，何事庞公不入州。\n至后腊前天欲雪，扁舟乘兴肯来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵芮漕国器忆去年上元二首 其二","author":"周必大","text":"门外人随月，窗前竹动风。\n老便佳节静，病幸绿樽空。\n春至鸿声北，人遥蝶梦东。\n隔年诗有债，生理固知穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵芮漕国器忆去年上元二首 其一","author":"周必大","text":"使节番禺重，中朝社稷臣。\n喜沉刁斗夜，远布玉墀春。\n古寺看红叶，蕃街试幻人。\n馀欢曾尽否，应记绕梁尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陆务观送行二首 其二","author":"周必大","text":"议论今谁及，词章更可宗。\n三年依玉树，一别送尘容。\n尽日寻山寺，思君傍塞烽。\n五言何敢续，持用当缄封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陆务观送行二首 其一","author":"周必大","text":"蓬阁虚生白，兰台汗杀青。\n英游迷岁月，神武动风霆。\n迁擢恩频忝，黔黎困未醒。\n空希范蠡去，羞对浙江亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周德友运干","author":"周必大","text":"曾见麻姑过蔡经，却陪王导宴新亭。\n博文正自鄙木彊，操论未应谈竹形。\n入幕久依池水绿，读书行照杖藜青。\n箧中知有还丹在，不用临溪怜鬓星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵秋日禅房","author":"周必大","text":"官閒未觉往来妨，疏懒从公意自长。\n松柏有心寒始见，芝兰入室久弥香。\n送秋容我无何饮，畦夏怜渠有底忙。\n霜倒池莲雨荒菊，禅房真似赞公房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵胡邦衡二首 其二","author":"周必大","text":"姚魏纷纷殆百家，天香一出自无哗。\n伤多莫厌扶头醉，贵少翻嫌满眼花。\n康乐旧闻宜水竹，翰林新调带烟霞。\n从渠草木呈新巧，终愧吾公正且葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵胡邦衡二首 其一","author":"周必大","text":"冯翊当年助匪颁，殊方此日奉宾欢。\n浅斟想对销金帐，生意重寻白玉槃。\n蚁泛似缘膻足慕，海凝如得毳逃寒。\n十羊百榼何须辨，试问东风可味酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵胡邦衡相迎","author":"周必大","text":"路逢驿使岭头回，喜得新诗胜得梅。\n情似春风缲楚柳，句如腊雪屑韩瑰。\n祇今皇侧求贤席，底事公衔乐圣杯。\n台路六符行复焕，丹心一寸未应灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵贺胡邦衡除龙图阁学士且为六月三日眉寿之祝","author":"周必大","text":"马负羲图二百春，荣光犹属大河津。\n细推班列论思旧，谁似耆英宠数新。\n龙阁便为黄阁老，洞岩应继紫岩人。\n他年笑视孙思邈，只自开皇至永淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐元敏榷货同年","author":"周必大","text":"当年驾鹤共骖鸾，对蹑丹梯上广寒。\n绿鬓旋同依帅府，华颠今并列王官。\n文才似我无多子，契分于君有四般。\n念旧不妨频枉驾，瓮头随意酌甘酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵真父著庭缃梅","author":"周必大","text":"茧黄织就费天机，付与园林晚出枝。\n东观奇童承诏后，南昌故尉欲仙时。\n芳心向日重重展，清馥因风细细知。\n诗老品题犹误在，红梅未是独开迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵章茂献谢茶","author":"周必大","text":"墨谈名高笔有花，胸中五色补皇家。\n谏书夜奏常焚稿，讲舌时乾每赐茶。\n秘祝重寻丹灶火，长生元笑紫河车。\n新诗有味知何似，双井春来试白芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢丰叔贾运使","author":"周必大","text":"锦衾留画省，绣斧上清湘。\n儒以真无敌，臣于远有光。\n二天临宴席，五字冠文场。\n昼接行蕃锡，权奇下八方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江西美复送四景诗再次韵","author":"周必大","text":"酉岁应知富酒浆，频年暂辍奏伊凉。\n沼莲不使红侵碧，池鹄聊容白护黄。\n照坐虽无骈火实，洁尊幸有络丝娘。\n西风早晚驱残暑，何日寻盟到野塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤孺人挽词","author":"周必大","text":"叹息闺房秀，霜摧鬓未华。\n女功丞相念，妇道里人嗟。\n石窌脂田废，涛江粉旐斜。\n西风看花泪，寂寞小窗纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"臣恭和御制晚秋曲宴近体诗一首缮写投进冒渎天威臣无任战惧俟罪之至","author":"周必大","text":"宸游不为菊丛生，观宴元因谷顺成。\n阁御芙蓉称曼寿，殿开选德奏和声。\n玉觞未饮心先醉，宝墨遥瞻眼倍明。\n身在金坡空感遇，论思深愧策平平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行忆永和兄弟","author":"周必大","text":"一挂吴帆不计程，几回系缆几回行。\n天寒有日云犹冻，江阔无风浪亦生。\n数点家山常在眼，一声寒雁正关情。\n长年忽得南来鲤，恐有音书急遣烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西美司书赋生玳瑁佳篇仍索鄙句奉和一首","author":"周必大","text":"衷甲藩身却误身，谁教全体点斑鳞。\n幸容生致池中物，忍使刳为席上珍。\n剩买鱼盐便尔性，閒随龟鹤称吾真。\n却思御合纹如豆，侍食钧天二十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡生日用旧岁韵","author":"周必大","text":"翊戴南阳第一春，驰驱北伐太原津。\n天开今代风云会，运应中兴岁月新。\n霖雨正宜苏大旱，清风未可作闲人。\n一杯安足为公寿，看饮思堂万斛醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡再和再次韵","author":"周必大","text":"金华绝出气凌霞，不愧君王坐赐茶。\n商岭烹来思旧样，洛泉煎处叹新芽。\n诗评未怕人生瘿，盐济惟防贼破家。\n剩欲苍生苏息否，刚严须是相王嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡再送二诗一和为甚酥二和牛尾狸 其一","author":"周必大","text":"金谷烹煎岂我徒，磨舂争语夜阑厨。\n六年不赐汤官饵，除日犹分刺史酥。\n小惠无多真画饼，大篇有味胜清醐。\n遥知发羃烘堂处，不见蒸鹅只瓠壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡再送二诗一和为甚酥二和牛尾狸 其二","author":"周必大","text":"追迹犹应怨猎徒，截肪何敢恨庖厨。\n鲙鲈湖上休誇玉，煮豆瓶中未是酥。\n伴食偏宜十字饼，先驱正赖一卮糊。\n却因玉面新名字，肠断元正白兽壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡再送皇字韵诗来次韵","author":"周必大","text":"宾鸿列阵竞随阳，却向丹山隐凤凰。\n银管题诗纷满帙，金钗度曲俨分行。\n汉宫早促三更席，梁苑行称万寿觞。\n顾我飘零无著处，非公湔祓尚谁望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡侄季怀亦惠二诗再次韵二首一颂其叔侄之美一解季怀生日不送茶之嘲 其二","author":"周必大","text":"萧散玄真吏少霞，樵青日日为煎茶。\n莫因闽粤皋芦叶，却厌神仙掌上芽。\n竹户胜棋非我事，菊潭试水是君家。\n不须更酹蘋洲冢，世以诗鸣句自嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡侄季怀亦惠二诗再次韵二首一颂其叔侄之美一解季怀生日不送茶之嘲 其一","author":"周必大","text":"竹林终日醉流霞，下客穷空祇厄茶。\n更欲打门奴酪粥，何殊敛手捧姜芽。\n赐金指日挥疏傅，盛馔常时设谢家。\n莫为唱酬供一笑，从今便废尔殽嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡侍郎用旧韵庆予生朝赓续为谢","author":"周必大","text":"蓬山落拓复经春，宦海茫洋懒问津。\n志节渐消平日壮，鬓毛空比去年新。\n午桥早并绯衣相，一月还同赤壁人。\n天遣驽骀追骥騄，无如才德异疵醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡侍郎用洪范五行推薄命而成杰句叹仰大手几至阁笔勉赓盛意兼叙天人之应庶知托契辱爱如此其厚决非偶然耳","author":"周必大","text":"五行陈范推箕子，三寿为朋及鲁申。\n二纪环周元附骥，四辰鳞次岂因人。\n交承紫掖追随旧，递宿金銮契分申。\n人事天时已如此，更看坯甈累陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡侍郎再惠春字韵诗次韵怀旧叙谢且致登庸之祝","author":"周必大","text":"年年郡圃共寻春，夜夜神冈醉问津。\n公从鸡翘恩典厚，我游麟省宠光新。\n愿闻玉铉调元日，幸摄金銮草制人。\n致主勋华端有望，浇风于此合还醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡侍郎作一字韵诗赠麻姑观道士李惟宾次韵仍效其体","author":"周必大","text":"盖世成功陋汉黥，翩翩弨挂许谁檠。\n气凌霄汉哮崖鹘，文阔波澜掣海鲸。\n囊水谩疑韩信怯，栅淮终畏晋兵勍。\n先生馀事为诗老，天宇行将一柱擎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡侍郎留金陵再用津字韵赋诗谢送赐茗复以丙申小春四銙寄赠","author":"周必大","text":"淳熙又贡第三春，驿骑新驰度剑津。\n七祖师泉难话旧，八功德水且尝新。\n雪亭烹处休装景，火阁煎时却可人。\n只恐春从官柳动，乐天还欲醉精醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邦衡置酒出小鬟予以官柳名之闻邦衡近买婢名野梅故以为对","author":"周必大","text":"浊水难攀清路尘，偶曾先后掌丝纶。\n归来久侍茵凭旧，至后初逢梅柳新。\n湖水攲斜应有意，春光漏泄不无因。\n绛帷幸许天荒破，日日当为问道人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余石月挽词 其二","author":"周必大","text":"自我居洪府，从公父子游。\n至言今在耳，往事忍回头。\n风急唐山垄，云埋石月楼。\n生刍无路奠，洒泪寄东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余石月挽词 其一","author":"周必大","text":"学重今颜子，年高汉伏生。\n鲤庭传道德，鳣序列公卿。\n忠孝平生事，诗书后世名。\n于公无一憾，多士自伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵部宋尚书挽词二首 其二","author":"周必大","text":"识面嗟虽晚，论心乐未央。\n经帷叨并席，官舍许连墙。\n俶讶亲针石，俄惊授印章。\n梅花佳句在，无复铁心肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵部宋尚书挽词二首 其一","author":"周必大","text":"北客今无几，公才合奋飞。\n再期骞禁密，仍世摄途归。\n星动尚书履，霜留御史威。\n桑榆初未逼，何乃露先晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗皇帝挽诗二首 其二","author":"周必大","text":"移御重华意，微臣粗探端。\n思陵三载服，文母万年欢。\n方侍瑶池宴，俄藏禹穴冠。\n馀生卧江海，空有泪成丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗皇帝挽诗二首 其一","author":"周必大","text":"圣德高难继，天心远莫推。\n如何尧舜主，不与武宣时。\n勤政精弥厉，平戎志竟赍。\n唯留大风句，千古日星垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庐陵主簿李子贤东顷示长笺用刘元城主簿可教事去秋复惠楚词皆未果答今代还索言老谬勿哂","author":"周必大","text":"地跨江闽秀气兼，玉成界尺直方廉。\n西曹久处习凿齿，高士谁知孙子严。\n我愧元城题品重，君能楚些笔锋铦。\n天门底用相吹送，公道今方拔滞淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张待制挽词","author":"周必大","text":"桂籍声名早，松门岁月赊。\n镇东多惠爱，使北有光华。\n岂料寻春骑，翻成会葬车。\n珠园旧亭馆，细雨泫新花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张渊道侍郎挽词二首 其二","author":"周必大","text":"南国频移镇，西清叠进班。\n衮衣元缱绻，贝锦谩斓斑。\n斜日逢单阏，流金识大还。\n惟馀千字诔，传诵满人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张渊道侍郎挽词二首 其一","author":"周必大","text":"籍甚中兴日，归欤载戢秋。\n周旋黄石法，邂逅赤松游。\n名与衡山埒，身随楚水流。\n若为窥智勇，家世本留侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张朝宗挽词二首 其二","author":"周必大","text":"甲第开邻里，蜗庐遂不孤。\n相从期晚岁，太息奠生刍。\n凉吹飞丹旐，残阳咏白驹。\n伤心松柏路，螭首载龟趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张朝宗挽词二首 其一","author":"周必大","text":"耆旧推西洛，于公见典刑。\n全名高白璧，利刃拂青萍。\n日者瞻卿月，天乎陨使星。\n平生精藻鉴，桃李半槐庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张履妻王氏挽词","author":"周必大","text":"逮事尊嫜日以严，退从娣姒一何谦。\n不愁囊橐金珠减，但喜园林锦绣添。\n四德助成家赫赫，一身宁计病恹恹。\n归寻二稚应无憾，况有良人为发潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李子权屡求所居江月亭浴沂斋诗老病未能作坐上示及和花妃诗甚工即席次韵一首所谓一彩两赛也","author":"周必大","text":"姚皇去后几菲菲，湘水依然从二妃。\n双泪一时红作鬣，连枝千载绿为衣。\n槛前斑竹应同伴，波面文鸳欲共飞。\n吟遍世间閒草木，何如江月咏沂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李仁甫赋诗送其子塾下第归次韵为赠","author":"周必大","text":"馀力犹能诵稗官，奥篇隐帙复何难。\n求贤正市千金骏，当赋终徵百羽抟。\n唤渡吴江秋水涨，解鞍蜀道雪山寒。\n归来趁贺郎罢相，东阁重寻一笑欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨子直示还寿皇御批制草熟状将以新诗叹服匠手走笔奉酬既谢厚贶且为王春度玉墀之祝","author":"周必大","text":"病渴相如思苦迟，至今梦怯草麻时。\n鼎湖铸就龙新去，云汉章成露尚垂。\n冬日茅檐虽可曝，春风浴殿岂忘思。\n使君自有如纶笔，会踏金銮契主知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨文甫主簿顷惠佳篇今赴松溪次韵送别","author":"周必大","text":"投林倦翼久知还，尚客君家伯仲间。\n入市每嫌妨杖屦，临岐那忍问河山。\n家声好在金陵簿，人物争看玉笋班。\n他日银黄夸里后，不妨徐伴野夫閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]