[{"title":"寂体咸周","author":"释清远","text":"妙体无方具遍知，近邦远利绝毫釐。\n根尘应念周沙界，坐断毗卢发大机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应缘不错","author":"释清远","text":"法法无差是正修，见闻从此绝漂流。\n穷心未到忘心处，一聚根尘安得休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖师地种花及总颂四首 其一 地","author":"释清远","text":"性地本无生，因生说有地。\n流传古至今，非愚亦非智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖师地种花及总颂四首 其二 种","author":"释清远","text":"从昔未曾迷，于今何所悟。\n祇缘种性深，更亦无别路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖师地种花及总颂四首 其三 花","author":"释清远","text":"有种有心地，因缘花自开。\n要知成果处，却笑祖师来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖师地种花及总颂四首 其四 总","author":"释清远","text":"五叶花开后，山长水更深。\n乱云横谷口，游子谩追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六句偈六首 其一 前念是凡","author":"释清远","text":"前念是凡，短布裁衫。\n长亭送客，落日张帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六句偈六首 其二 后念是圣","author":"释清远","text":"后念是圣，一拳打正。\n干戈丛里，拾得性命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六句偈六首 其三 前念非凡","author":"释清远","text":"前念非凡，语正言谗。\n天高海阔，毛羽毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六句偈六首 其四 后念非圣","author":"释清远","text":"后念非圣，万象明镜。\n不假薰修，本来清净。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六句偈六首 其五 前念即凡","author":"释清远","text":"前念即凡，凡不能测。\n若人要知，终不指划。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六句偈六首 其六 后念即圣","author":"释清远","text":"后念即圣，圣不能知。\n铁牛过海，石女生儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆少林","author":"释清远","text":"一从三拜后，千古错流通。\n永日无人到，萧萧桧柏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆曹溪","author":"释清远","text":"叶落归根后，曹溪一滴深。\n山居人少到，真实好知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆南泉","author":"释清远","text":"一归方丈后，何处觅南泉。\n昨夜三更月，寒光照座前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆赵州","author":"释清远","text":"不下禅床后，曾无善巧言。\n平常安乐事，今古谩流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆南阳","author":"释清远","text":"丹霞相访后，从此话南阳。\n草作青青色，春风任短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆双林","author":"释清远","text":"一入双林后，天宫事可猜。\n卖鱼人不厌，何处见如来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆寒山","author":"释清远","text":"一住天台后，身单布亦穿。\n虽然筋骨露，歌笑不堪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆庞翁","author":"释清远","text":"石上栽花后，生涯自是春。\n若逢亲切问，端的不饶君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆先师","author":"释清远","text":"一见先师后，堪悲复堪笑。\n为问何以然，八十重年少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十忆偈 忆伊余","author":"释清远","text":"忆著伊余后，呵呵笑未休。\n何人知此意，有语不堪酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 宴坐","author":"释清远","text":"清虚之理竟无身，一念归根万法平。\n物我顿忘全体露，个中殊不计功程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 入室","author":"释清远","text":"问道趋师印自心，入门端的访知音。\n此生不踏曹溪路，到老将何越古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 普请","author":"释清远","text":"拈柴择菜师先匠，进业修身见古人。\n若到诸方须审实，龙门此法是通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 粥饭","author":"释清远","text":"三下板鸣生死断，十声佛唱古今通。\n开单展钵亲明取，不可粗心昧苦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 扫地","author":"释清远","text":"田地生尘便扫除，房廊萧洒共安居。\n装香扫地无馀事，默耀韬光示智珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 洗衣","author":"释清远","text":"临流洗浣莫疏慵，入众衣裳垢不中。\n上下邻肩薰炙久，身心动念肯消镕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 经行","author":"释清远","text":"石上林间鸟道平，斋馀无事略经行。\n归来试问同心侣，今日如何作么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 诵经","author":"释清远","text":"夜静更深自诵经，意中无恼睡魔惺。\n虽然暗室无人见，自有龙天侧耳听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 礼拜","author":"释清远","text":"礼佛为除憍慢垢，由来身业获清凉。\n玄沙有语堪归敬，是汝非他事理长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十可行十颂 道话","author":"释清远","text":"相逢话道莫虚头，大语高声笑上流。\n言下若能穷本末，肯将无义结朋俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感兴二首 其一","author":"释清远","text":"空里形骸梦里身，梦中身世莫追寻。\n可怜一脉岩前水，流入人间古到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感兴二首 其二","author":"释清远","text":"梦幻空花祇自知，潜思二十九年非。\n夕阳芳草曾行处，谁料红莲步步随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海会辞老和尚","author":"释清远","text":"来时无有语，去亦不知闻。\n此曲谁能和，轰轰出白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和五祖老和尚寄铁牛歌","author":"释清远","text":"混沌未分先剖判，生成不假阴阳煅。\n头角前来是好牛，皮毛更不重更换。\n满目平田无寸草，饥餐渴饮无生老。\n威音王佛是如今，有甚众生可寻讨。\n哮吼一声天地动，达人见处吾无用。\n坐断毗卢世界宽，自是衲僧眼皮重。\n一遇知音和始齐，自馀总是闲陪从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山偈","author":"释清远","text":"动境遍娑婆，以之成逼迫。\n安心一处坐，从是虚生白。\n逼迫何逼迫，膏火煎魂魄。\n虚白何虚白，广教扬孤翮。\n良哉静者心，四海犹为窄。\n匹彼在动士，天地何辽隔。\n故兹审观究，二者俱介僻。\n弃彼而奔此，安得有深益。\n乐者自何至，苦者自何适。\n苦乐忘根绪，由夫征路陌。\n路陌苟不征，耽耽本家宅。\n昔未厌瓦砾，今岂重金璧。\n金璧有所重，瓦砾未可掷。\n瓦砾谓金璧，杀盗应非逆。\n金璧谓瓦砾，圣贤失踪迹。\n金璧而金璧，瓦砾而瓦砾。\n苦乐各平等，法法无假借。\n大空离众念，真实无改易。\n乐而无乐相，苦亦无苦迹。\n苦乐同十虚，心门广开辟。\n龙吟而凤鸣，天渊发金液。\n人不念诸道，饥口枉求食。\n一也及夫此，曹溪称上客。\n因思贤圣人，不寐彻残夕。\n时哉各勉旃，升沉在咫尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题四面法智禅师塔","author":"释清远","text":"珍重灵知者，绵绵亘古今。\n人居千圣外，塔锁乱云深。\n碧落杉松色，丹崖虎豹音。\n回光如到此，必也见师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与太平四面夜坐","author":"释清远","text":"城中应接同摩诘，云外无心似老卢。\n月白风清深夜坐，出家全不费工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示看经僧","author":"释清远","text":"句义纵横那畔彰，五千馀卷总含藏。\n如何不觅根头意，空看枝边木叶黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读传灯录二首 其一","author":"释清远","text":"虚名虚说传来久，真语真踪示后人。\n虚实灼然知下落，清风千古见芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读传灯录二首 其二","author":"释清远","text":"家家门前火把子，半夜愚夫说相似。\n碧天如水月如钩，古今流落闲名字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示栽松僧","author":"释清远","text":"一寸灵苗手自栽，前岗后陇作良材。\n敢将不朽传他日，唯把青青示后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中偶作三首 其一","author":"释清远","text":"分明不了却成迷，无限风光付与谁。\n若得家山田地稳，自然处处不思议。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中偶作三首 其二","author":"释清远","text":"旧事成空莫可追，旧心将把再思惟。\n古今不隔丝毫许，会得如斯也大奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中偶作三首 其三","author":"释清远","text":"休处言休便好休，五湖踪迹任遨游。\n莫嫌活计无多子，此个牟尼用到头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示众","author":"释清远","text":"求心心未谛，等人人不来。\n岩花晓来雨，寂寞为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三句颂","author":"释清远","text":"禹穴龙门寺，探珠欲问龙。\n骊珠吞在腹，","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读灵源十二时歌","author":"释清远","text":"一日日，一时时。\n龙门老，心自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师常以六只骰子示禅人六面皆六点复作三颂 其一","author":"释清远","text":"六只骰子满盆红，不用安排祇么通。\n拟欲进前求解会，大似西行却向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师常以六只骰子示禅人六面皆六点复作三颂 其二","author":"释清远","text":"六只骰子满盆红，尘墨河沙用莫穷。\n谁能解展金刚手，祖佛亲来亦扫脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师常以六只骰子示禅人六面皆六点复作三颂 其三","author":"释清远","text":"六只骰子满盆红，马载驴驼一掷空。\n赫赤穷来无可赛，请君从此现神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迷逢达磨","author":"释清远","text":"信步游梁魏，乘时别少林。\n长安车马客，无限利名心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因法眼颂","author":"释清远","text":"咒咀毒药，形声之逆。\n眼耳若通，本人何适。\n根问本人何所适，涂割等平忘顺逆。\n有为虽伪性常真，法法无依称善吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无情说法","author":"释清远","text":"无情说法异盲聋，听得之人眼耳通。\n不但近尘并远刹，十方度尽显全功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食礼先师真五首 其一","author":"释清远","text":"云水参寻访此宗，十年磨刮太虚空。\n区区力尽还依旧，方知万法本来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食礼先师真五首 其二","author":"释清远","text":"一悟吾师心便息，信门入处还无入。\n二十年中事密如，向人殊不劳心力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食礼先师真五首 其三","author":"释清远","text":"前人说法后人听，由来两个总无情。\n祇缘口耳都相似，所以流通道自成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食礼先师真五首 其四","author":"释清远","text":"去人去矣叮咛嘱，住者相承无断续。\n若遇知音一和时，乃知去住常充足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食礼先师真五首 其五","author":"释清远","text":"清明寒食与诸人，共礼先师不动身。\n万法本闲心亦尔，将来谁是得吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圭首座二颂 其一","author":"释清远","text":"祇论亲切不论时，回笑诸方陷虎机。\n一句未容开口对，片帆先逐便风归。\n头头有路堪行履，物物无差莫弃违。\n不见黄梅足奇士，卢公却得祖师衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圭首座二颂 其二","author":"释清远","text":"愧尔相求识岁寒，不嫌危磴路千盘。\n归堂一剳曾亲访，闭户深山肯自瞒。\n月下篇章应独和，壶中天地共谁看。\n临机大用全收放，何必区区握雪团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭大夫知钜野","author":"释清远","text":"东归半载渔樵乐，北去三年父母来。\n金马玉堂弹指入，宝楼香阁一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈子美息阴堂","author":"释清远","text":"湛湛寒溪叠叠山，息阴投老得身闲。\n武陵花好春常在，渔棹歌清事不关。\n眼底儿孙从富贵，樽前鬓发任斓斑。\n天机日有真消息，频许禅僧共往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题孙钦之养素轩","author":"释清远","text":"善养不教声色乱，素丝无染是天真。\n有时来此轩中坐，作个忘机混沌人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智海化士乞颂","author":"释清远","text":"乞食山城归帝里，毗耶钵饭香而美。\n莫念故园桃李春，更参上国西来旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示围炉僧","author":"释清远","text":"炉边静坐默无言，勿论粗疏若市廛。\n冷暖此中看火色，祖师心印为亲传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题徐四翁壁","author":"释清远","text":"徐翁活计天真，年老无喜无嗔。\n参取面前桑树，乾坤不出一尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题祇园庵","author":"释清远","text":"祇园谁住此，谓是钁头通。\n物外庵边竹，人间耳畔风。\n露畦青戢戢，烟浦绿濛濛。\n祇个潜心处，分明古者同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏散辄病既病且恼因书山偈示一一禅者","author":"释清远","text":"万劫一瞬视，尘沙不动移。\n若为论过未，并总入无时。\n海阔波仍匝，心通佛可齐。\n床头木枕子，推出恐人迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题侍者寮香林阁","author":"释清远","text":"葛厨松枕午窗凉，卧看风云草木香。\n弹指遍游尘刹尽，故山归路笑羊肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送常侍者西归省亲","author":"释清远","text":"本从绵竹过南方，依前归入绵竹去。\n井舍犹为旧日居，山川不改当时处。\n邻人见之莫惊愕，亲里欢迎断思虑。\n有问南方所得时，瘦藤为我聊轻据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师崇坚乞偈","author":"释清远","text":"事办须寻道，方明尔本来。\n禅关无锁钥，祇要用心开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门偶作五首 其一","author":"释清远","text":"明月何皎皎，永夜入我室。\n照出万古心，念此百年质。\n隔窗风露泫，拥毳衣衾密。\n迟迟不能寐，馀光在东壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门偶作五首 其二","author":"释清远","text":"叨叨林鸟啼，披衣中夜坐。\n拨火悟平生，穷神归破堕。\n事皎人自迷，曲淡谁能和。\n念之永不忘，门开少来过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]