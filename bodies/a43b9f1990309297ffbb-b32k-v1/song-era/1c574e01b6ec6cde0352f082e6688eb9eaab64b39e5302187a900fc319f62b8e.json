[{"title":"哭环州先生 其二","author":"艾性夫","text":"曾随计吏上青霄，折翅归来困一瓢。\n湖海十年乌绕树，功名两字鹿眠蕉。\n山图不及生前买，诗板姑留死后雕。\n地下修文应未恶，寒蛩虚馆雨萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭菊存蕙山二兄","author":"艾性夫","text":"黄台瓜蔓已凄凉，五雁飘零不著行。\n一脉仅馀三老在，半年又哭两兄亡。\n菊园霜熟秋香寂，蕙帐云寒春梦长。\n愁绝吟魂招不得，西楼风雨忆连床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悯蟹","author":"艾性夫","text":"落阱都缘奔火明，林然多足不支倾。\n是谁贻怒到公等，怜汝无肠受鼎烹。\n支解肯供浮白醉，壳空竟弃外黄城。\n江湖好是横行处，草浅泥污过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花","author":"艾性夫","text":"秋树婆娑风露凉，老蟾落子种虚堂。\n胚浑天地中央色，漏泄神仙上界香。\n贫里忽惊添粟满，老来不动买花狂。\n带愁莫上黄楼去，归隐淮山兴味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涤砚","author":"艾性夫","text":"淙淙瀑布泉，濯濯刷丝石。\n坐令黟川漆，涨作梁州黑。\n以涅定不缁，欲玄终尚白。\n适与吾道同，持归试新墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留城","author":"艾性夫","text":"夜半辽东白鹤归，旧来巢处立多时。\n门关落日千家静，旗飐秋风万马嘶。\n文堰石台空有谶，画堂翠幕更无诗。\n悠悠往事俱尘土，只有寒流是古溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中即事","author":"艾性夫","text":"支身惟首健，随事与心违。\n病久药为饭，寒深火是衣。\n矮窗看日度，远梦傍云飞。\n可比梅花瘦，呼童试折归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中闻雁有感","author":"艾性夫","text":"我病无眠守夜阑，汝来何暮尚云端。\n去乡万里关河隔，带月一声风露寒。\n口腹累人菰米饭，弟兄何处荻花滩。\n营门射手桑弓健，止好冥冥惜羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"艾性夫","text":"似是轮囷老蠹鱼，尚饶兰露入铜蜍。\n诗亡正恐鲁无史，士贱岂容秦有书。\n世味几时回橄榄，秋山随地著蘧庐。\n多情樵客能相问，莫有馀閒赋子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿洪岩寺","author":"艾性夫","text":"形枯面冷住山人，彷佛钱塘老惠勤。\n寺窭不充黄粟饭，佛寒添绣碧苔纹。\n秋声茅屋三间雨，野色松岩几树云。\n嚼菜薰香清语久，一灯明灭夜将分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄清旷邓隐夫","author":"艾性夫","text":"去年菊里辱经过，秋思萧萧又草坡。\n兵火东南关气数，交游湖海隔风波。\n书缘辟乱经年少，诗想忧时近日多。\n倘有鳞鸿幸相寄，青灯无奈忆君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼亡 其一","author":"艾性夫","text":"秋瑟凄凉忽断弦，自砻山石志新阡。\n稍閒即病身无福，竟死难医命有天。\n会绩忍看烧烛泪，遗簪聊抵买花钱。\n最惭误看刘蕡策，辜汝相依四十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼亡 其二","author":"艾性夫","text":"死生最怕堕危机，乱世全身正自稀。\n满地干戈殊不定，盖棺丘陇未为非。\n鹿门不共庞公隐，凤褐谁缝杜老衣。\n愁绝梧楸烟雨地，藁砧百岁拟同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晞发","author":"艾性夫","text":"射透秋林晓日红，谩晞衰发竹篱东。\n旧曾过膝今垂耳，老已成翁反似童。\n辛苦一生多沐雨，萧颾几缕易梳风。\n岁寒万绿凋零尽，春在梅花白雪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"检历即事","author":"艾性夫","text":"古来系日欠长绳，节物相催老自惊。\n岁里春为花早计，蛰前雷是雪先声。\n移家燕子商量熟，开国蜂王去就轻。\n最忆长安三月事，有谁重赋丽人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"深冬","author":"艾性夫","text":"冻透松边屋两间，孤床盘礴数更阑。\n无情风雪偏欺老，经乱衣裘不禦寒。\n春意一炉红榾柮，故人两坐绿蒲团。\n敲冰自换瓷瓶水，浸取梅花仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"深村","author":"艾性夫","text":"索居无远兴，晚憩傍深村。\n涧涩水争道，桑空草托根。\n断桥回老马，熟果聚饥猿。\n解后僧同话，归来人掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移家寄诸丈","author":"艾性夫","text":"十弓荒圃百弓山，缚草编茅屋两间。\n鸡瓮不知天广大，鹤巢已觉地宽閒。\n胜心扰扰双蜗角，畏路岩岩九虎关。\n退一步行差得计，野云深处即商颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧寺秋夜","author":"艾性夫","text":"藤护颓垣石靠门，竹垆香穗篆馀熏。\n醉来终夜不知雨，梦觉四山都是云。\n半局棋枯僧入定，一声松响鹤离群。\n缺权癞可风流尽，招隐归来有此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪尽","author":"艾性夫","text":"雪尽孤峰瘦，家贫老梦寒。\n春鞭双影动，岁节五更残。\n努力三餐饭，滋身九转丹。\n时危从道丧，不敢弃儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪销","author":"艾性夫","text":"红日行天熨绛绡，一番阳长便阴消。\n青山又现本来面，瘦竹方伸久折腰。\n枯沼暗通泉细细，晴檐忽听雨萧萧。\n独怜点入吟翁鬓，费尽东风不肯销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食后","author":"艾性夫","text":"寒具油乾火已新，流觞水暖酒初醺。\n蔷薇半树花孤注，杜宇一声春二分。\n薄晚草心先浥露，久晴山意欲生云。\n老来尚费閒精力，自种窗前辟蠹芸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖阴故人家","author":"艾性夫","text":"水痕落尽见晴沙，步入湖阴处士家。\n梅一两花春尚小，雁三五字日初斜。\n百年耆旧多思洛，五夜精魂半梦华。\n珍重瑶琴莫轻拂，西风江上沸芦笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"番城晚眺","author":"艾性夫","text":"独眺秋愈远，孤城日渐曛。\n地平浮楚泽，天阔见吴云。\n风静渔歌合，波摇雁影分。\n未应陵谷变，不得问番君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登六和塔","author":"艾性夫","text":"崒峍浮图插翠微，长连山影浸江湄。\n地高直见海穷处，天近先知日上时。\n香绕五云宫里梦，墨浓千佛顶头诗。\n无风最喜铃相语，切莫丁宁说秀支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答诸友","author":"艾性夫","text":"霜叶吹红鹤影孤，雨苔封绿屐痕疏。\n风才敲竹便疑客，雁不入山难寄书。\n自有乾坤心最大，稍无根柢学皆虚。\n闭门未了研朱事，多谢梅花慰索居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢了心聪上人以恶诗入逡巡碑","author":"艾性夫","text":"茧纸铅华字字新，不须刀笔勒坚珉。\n分明能守玄中白，彷佛难知赝与真。\n怀素草书争媚妩，韩湘奇术斗逡巡。\n正惭野语多流落，幻作横碑更累人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢吕云叔饷墨","author":"艾性夫","text":"苍苍乌玉笏，岁岁到山翁。\n君眼何曾白，吾颜自觉红。\n一生磨不死，万事写成空。\n回首柯山路，凄凉不复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢吴子与惠诗","author":"艾性夫","text":"解后西风野菊黄，别来冉冉历三霜。\n未偿诗债如山重，曾结交盟引梦长。\n老病终年亲药裹，清谈何日倒书囊。\n闻君读罢多娱乐，萱草春深棣萼芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢屏山吴显父惠歙砚","author":"艾性夫","text":"苍玉光寒篆紫烟，重重封裹到梅边。\n得君一片歙溪石，即我终身绵上田。\n少达必穿维翰铁，尽穷共守子云玄。\n老坡莫遣穷居后，远在茶坑凤咮前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠楮衾","author":"艾性夫","text":"厚于布被拥公孙，清似荷衣伴屈原。\n捲送春云香入梦，剪成秋水淡无痕。\n五更葭琯嘘寒谷，一榻梅花近雪村。\n直作黄紬纹锦看，日高睡稳不开门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋太和寺同根红白梅","author":"艾性夫","text":"雪影萧萧带晚霞，胭脂灼灼傍铅华。\n孤山夜合连枝木，一树春分二色花。\n牛继马来几换骨，鹤乘鸾去忽通家。\n向来逋老题诗处，曾有红裙拂碧纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中 其一","author":"艾性夫","text":"共僧分晚供，呼渡立桥东。\n雁背西风紧，渔梁落照红。\n云添疏树影，叶补败船篷。\n旧日津亭酒，黄垆蔓草中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中 其二","author":"艾性夫","text":"觅宿村溪远，逢人面目生。\n习移多佩犊，气怒斗呼鹰。\n天阔秋阴重，风高夜柝惊。\n迟明怀宿饱，股慄履春冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"意行","author":"艾性夫","text":"意行行到野人家，门带清溪石径斜。\n落日轻烟山可画，短篱颓堑菊能花。\n归迟误客频敲竹，坐久劳人再煮茶。\n那得宽閒无点事，日搔短发问桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼中故书连被兵尽亡去","author":"艾性夫","text":"楼无长物只遗编，直当山翁负郭田。\n累世相传俱扫地，斯文忽丧岂非天。\n不归老子茶肠里，知堕谁家酱瓿边。\n我固道穷书更厄，西风危涕倍潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"煎后山峰上人新茶","author":"艾性夫","text":"拣芽穰穰鹰爪黄，活火濈濈鱼眼汤。\n扫花席地白日静，穿帘透户春风香。\n唤醒松根渴睡汉，五更清梦从渠短。\n泠泠灌顶欲通仙，稽首法云甘露椀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简敬轩何行叟觅墨","author":"艾性夫","text":"兵尘漠漠暗穷山，零落难寻堕水丸。\n见说陈玄老居士，独留何逊旧诗坛。\n快刀肯截乌龙角，破砚犹存紫马肝。\n一笑磨人磨未了，晓窗搔首雪霜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辟乱逢故人","author":"艾性夫","text":"乱里相逢各自忙，少依松影话凄凉。\n古来尚有种桃处，今去当传辟谷方。\n马蹴黄尘遮日暗，鬼吹青燐隔林光。\n海田未必非天数，空对西风老泪滂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬杨簿正父子和诗 其二","author":"艾性夫","text":"谁把蛩吟过草堂，烨然引玉照奚囊。\n喜看彪固能联笔，愧杀曹刘有短墙。\n千古风骚几绝响，一壶冰雪忽增光。\n客来谩寄山中稿，莫笑梅花只淡妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬杨簿正父子和诗 其一","author":"艾性夫","text":"落落冥鸿惜羽毛，黄尘不把涴青袍。\n关西夫子经犹在，水北山人价自高。\n吾道不昌该气数，密林虽寂少风涛。\n半园花木能招隐，早晚相从问种桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬邻僧惠古杭芦管兔毫","author":"艾性夫","text":"黄芦笠泽剪秋雨，褐兔中山俘饱霜。\n千里能随云衲远，数君肯顾草庐荒。\n无情书传方高阁，何处尘埃有画墙。\n留与素翁修菊谱，寒花吹入墨云香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬庭翠陈善夫","author":"艾性夫","text":"家在文昌古堰西，红蕖环映碧涟漪。\n饱钟天地清脾气，厌作江湖近体诗。\n雪茧草书香不断，玉壶冰壑梦相随。\n自怜未到参禅处，欠问彭城老祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"撚髭","author":"艾性夫","text":"细撚寒髭缕缕霜，未须惆怅惜流光。\n近山归鹭分明白，过雨斜阳浅淡黄。\n春入桑榆花影瘦，门无车马草心长。\n暮年一卷参同契，觅得安神不老方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滕王阁","author":"艾性夫","text":"木老江空雁阵秋，阑干倚尽思悠悠。\n舞衫歌扇落春梦，山雨浦云牵暮愁。\n半壁夕阳千古在，几朝王气一时休。\n献陵无树供寒雀，信是劳生枉白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题友人归隐图","author":"艾性夫","text":"买山长说欲栖身，画得图成隐始真。\n半枕虚堂生草梦，一溪流水种桃人。\n但知樵客当辞汉，莫与渔郎说避秦。\n早晚相从弄明月，细听唤铁响苍筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题古洪周君会梅阁","author":"艾性夫","text":"此花不受俗人知，为汝移家亦绝奇。\n至冷淡中参古意，极高明处见南枝。\n栋帘相望滕王屋，风月重添水部诗。\n梦入梨云香不断，有人携笛倚阑吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题艾溪","author":"艾性夫","text":"睦城西下柳阴阴，以艾名溪古到今。\n鼻祖桑弧蓬矢地，耳孙乔木故家心。\n应无别姓争墩住，曾有高人对客吟。\n欲向原头拜宗老，西风落日暮云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题陈朝玉爱竹轩","author":"艾性夫","text":"阴森窗外万琅玕，尽日吟翁此倚阑。\n曾借春风闲管勾，喜从劫火报平安。\n四时青眼相看易，三世同盟耐久难。\n千古溪林遗事在，不妨标致共高寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题洪崖仙坛","author":"艾性夫","text":"树精不死卧松关，呵护仙翁旧禁坛。\n天阔难寻骑去鹤，井香疑有炼成丹。\n山如辟谷秋逾瘦，屋尚凌虚夏亦寒。\n行遍苍崖无石髓，空和凉月倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题贱容","author":"艾性夫","text":"骨多肉少与梅同，老向江南风雪中。\n万事羞称司马好，一生不送退之穷。\n偶贪识字头先白，稍欲工竽面即红。\n说与丹青莫饶笔，肩山只合付何充。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕去十年复来巢","author":"艾性夫","text":"双燕窥帘认主人，十年不见忽过门。\n乌衣故国今何在，苍箓遗民老幸存。\n芹沼不香惊绿暗，草堂无语对黄昏。\n从今不必依王谢，只好寻常烟雨村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"穆陵大礼图","author":"艾性夫","text":"丹青百丈鹅溪绢，缥轴南郊大礼图。\n官隶威仪犹是汉，山河风景已非吴。\n秋阴汾水年年雁，月黑连昌夜夜狐。\n辇路莫惊荒草暗，鮧膏灯灭出金凫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠广信医博士陈云泉","author":"艾性夫","text":"见说云泉深又深，定知巢入海棠林。\n君医尚副穷时愿，吾道全孤壮岁心。\n药笼有方玄白发，苋肠无分服黄金。\n近来觅得安身法，诸老先生夜气箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠邻僧游杭","author":"艾性夫","text":"道潜五月过临平，师又挑云把瘦藤。\n饱听西湖莲叶雨，密传灵鹫雪峰灯。\n空城潮打三千丈，荒殿烟寒十二层。\n愁绝旧时行脚处，而今分付与闲僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠画鱼李生","author":"艾性夫","text":"李生画鱼天下无，得心应手神为徒。\n虚堂素壁扫尘土，远趣一笔移江湖。\n青鱼洋洋翻荇带，鳜鱼猎猎穿蒲稗。\n醉来屡欲呼霜刀，为我樽前斫新鲙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谈数陈改之","author":"艾性夫","text":"投老江南黄叶村，菊花时节雨昏昏。\n矮窗孤梦正攲枕，拄杖一声谁打门。\n三字头衔康节数，一编心易华山孙。\n吾年渐似璜溪老，尚把灵光许独存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠绳伎","author":"艾性夫","text":"绝艺当场万目倾，两竿朽索半空横。\n反提双女摩肩过，仰射孤鸿信脚行。\n胆似子龙身里满，体如飞燕掌中轻。\n弄潮已叹吴儿险，更有人从死处生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠数学姜兄","author":"艾性夫","text":"向来涂抹趁春妍，老去栖迟叹雪颠。\n一倍法灵君说数，三生缘定我随天。\n正须花外羁奔马，莫向桥南听杜鹃。\n见说侯封容易觅，紫茸靴裤锦鞍鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠新中郭四翁","author":"艾性夫","text":"几人到得白头翁，生老痾沉是始终。\n浊秽腥膻除寿算，悭贪嫉妒转昏蒙。\n有憎有爱难超世，无欲无情定脱空。\n幸有天堂地狱路，圣凡迷悟总由公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蟋蟀","author":"艾性夫","text":"不从草际伴啼螀，偏逐西风入我床。\n心事甚如愁欲诉，秋吟直与夜俱长。\n一年时节虫声早，半树梧桐月影凉。\n忆得重胡衰柳下，健儿笼汝斗斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与图书工罗翁","author":"艾性夫","text":"木天荒寒风雨黑，夜气无人验东壁。\n天球大玉生土花，虞歌鲁颂谁能刻。\n翁持铁笔不得用，小试印材蒸栗色。\n我今白首正逃名，运与黄杨俱受厄。\n藏锋少俟时或至，精艺终为人爱惜。\n固不必附名党锢碑，亦不必寄姓麻姑石。\n江湖诗板待翁来，传与鸡林读书客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与林止庵叶半隐分赋郡中古迹得鲁公祠右军墨池 其一","author":"艾性夫","text":"遗像犹能立懦夫，悬知生气摄萑苻。\n三郎阿堵知何用，只识营州阿荦奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与觿轴工郑老","author":"艾性夫","text":"君不见世南人间行秘书，撑肠拄腹搜不枯。\n眼空千古不留物，更用芸香祛蠹鱼。\n又不见王家楼中五百车，锦奁玉轴签红牙。\n夜生光怪射东壁，神鬼错愕相惊嗟。\n无形之书不复见，有形之书今亦鲜。\n吴侬鞭马驰京尘，何曾著眼鸡林人。\n弓刀自带封侯相，黄金不博青藜杖。\n请翁少待三十年，怕有米家书画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]