[{"title":"丙戌人日与内侄汪景渊同饮于宜晚二首 其一","author":"陈著","text":"忆昔儿嬉祖母旁，如今甲子一周强。\n昼窗三世亲亲话，分付儿孙此意长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其九 飞花","author":"陈著","text":"独占初春早卸芳，肯随桃李炫侬妆。\n如今不到寿阳额，自做孤村流水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其八 风前","author":"陈著","text":"打头二十四番信，吹透天香雪里枝。\n总被诗人收拾去，封姨正自未能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其二 古枝","author":"陈著","text":"分甘冷落傍朱门，傲雪欺霜百岁根。\n惆怅西湖人不见，暗香依旧月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其一 先春","author":"陈著","text":"才得江南第一春，竹篱茅舍便精神。\n百花头上无相识，只有东风是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其六 依竹","author":"陈著","text":"香在溪头古晋林，潇潇风雨惯曾禁。\n休寻白玉堂前梦，自有此君知此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其五 依松","author":"陈著","text":"处子从来不世妆，老苍相对本相忘。\n犹嫌曾受秦封污，冷笑无言祇自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其四 卧烟","author":"陈著","text":"生香自恨玉为容，谁放晨光浅碧笼。\n隐约风标难画处，邯郸人在梦炊中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其三 宜月","author":"陈著","text":"斜斜瘦影两三枝，只许寒窗人自知。\n犹恨嫦娥收不尽，却归羌管曲中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其十 结实","author":"陈著","text":"碧实圆成重压枝，万红千紫竟何知。\n是虽不入甜人口，留得青酸有用时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代弟茝咏梅画十景 其七 雪里","author":"陈著","text":"天花包尽世閒羞，也到孤山老树头。\n寄语东风为吹拂，本来面目自风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出门偶成","author":"陈著","text":"双鹭飞飞高复低，复低飞下近山溪。\n一声樵唱山前路，却又飞归翡翠西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"外孙黄相儿求写送春三首并示","author":"陈著","text":"相儿一揖笑嬉嬉，要写酴醾架下诗。\n留取他年时展看，外家风景有当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用梅山醉中韵三首 其三","author":"陈著","text":"吟搜菜味诗宜瘦，睡足花时梦亦香。\n閒也曾忙老彭泽，存而无用古灵光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用梅山醉中韵三首 其二","author":"陈著","text":"满世杨花桃李妆，自家采采芷兰香。\n无从捉鼻如安石，相与齐眉有孟光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用梅山醉中韵三首 其一","author":"陈著","text":"一窗桃李夹垂杨，一卷离骚一炷香。\n闭眼坐来开眼笑，到无言处是春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示侄泳求牡丹","author":"陈著","text":"见说东家有牡丹，有花欲觅数枝看。\n若还溺爱悭分送，却与无花是一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤春","author":"陈著","text":"杜鹃非是翠芳残，底事年年叫出山。\n纸帐竹床清到底，不堪声入梦魂閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似居简","author":"陈著","text":"老岁虽寻相近寺，危时欲见得交人。\n平生自有凌云志，只恐峰高不受邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似僧一宁","author":"陈著","text":"邂逅交情云水閒，茶瓯香鼎话清閒。\n他年燕坐千峰上，认取一山山外山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"似僧耕野云","author":"陈著","text":"浮云一片出天涯，南北东西总是家。\n飞到五山山绝顶，风雷变化雨河沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"陈著","text":"天将转冷热连日，云欲开晴雨数丝。\n造物从容消长处，盍将人事此中推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次儿瀹以诗四首道各意因两用其韵 其七","author":"陈著","text":"俗氛炎郁攸，世燄毒恶来。\n清当友孤竹，隐当友仙梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次云岫惠茶","author":"陈著","text":"满啜禅林五味茶，清风吹散事如麻。\n客中邂逅真奇绝，不比寻常贼破家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次儿泌韵","author":"陈著","text":"门外风尘付一吁，何妨稼圃学樊须。\n由由本自人难浼，皎皎奚忧我易污。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵东平赵益三首 其二 凤花","author":"陈著","text":"翠红翼翼宝坊閒，曾入瑶宫白玉阑。\n飞上朝阳瑞天下，灵根变化本无难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵东平赵益三首 其一 龙松","author":"陈著","text":"修鳞化作偃松寒，数百年閒一梦看。\n何似起来云拥去，为天行雨万民欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次单君范袖来汪西皋所撰咏秋十章以示因和之十绝 其九","author":"陈著","text":"梦断康衢立极谣，心如泥絮看萍飘。\n一清盍与金溪水，同味谁争盐海潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次单君范袖来汪西皋所撰咏秋十章以示因和之十绝 其四","author":"陈著","text":"自古年年自有秋，悲秋元只是閒愁。\n感时祇有长庚子，说到衣冠成古邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次单君范袖来汪西皋所撰咏秋十章以示因和之十绝 其六","author":"陈著","text":"木犀风了桂花风，几日中閒景不同。\n惟有黄花偏耐老，饱收霜露玉成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次单君范袖来汪西皋所撰咏秋十章以示因和之十绝 其十","author":"陈著","text":"昏眵望杳水云村，好句从来风月人。\n瓦缶不量追大吕，冰壶何惜受纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d