[{"title":"赋陈子在瓢饮","author":"薛嵎","text":"羡尔甘贫居陋巷，遥知清德继前脩。\n平时所乐从中得，外物虽微不过求。\n自枕曲肱安澹泊，闲挑拄杖亦风流。\n百千年内谁相望，寂寞箕山一许由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山纪游七首 其三 大龙湫","author":"薛嵎","text":"深冬雷未蛰，雨雹半空飞。\n久立怪生眼，回看日变晖。\n万松声不出，尺蜃鬣犹威。\n僧说分流阔，长年无旱饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山纪游七首 其一 寿昌寺","author":"薛嵎","text":"野服挂僧单，禅扉月未关。\n桂香清近佛，秋色老依山。\n目尽遥峰出，步回流水闲。\n相传登荡路，数处可跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山纪游七首 其四 灵岩寺","author":"薛嵎","text":"千岩崚骨露，随怪各生形。\n目力到天尽，心旌倚佛宁。\n夜钟传谷杳，石气逼灯青。\n崖腹猕猴住，多年性亦灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山纪游七首 其六 灵峰寺","author":"薛嵎","text":"神功开地秘，怪石尽为峰。\n佛界虚空造，龙居十二重。\n睛瞳随境役，蟾兔及秋逢。\n却忆谢灵运，岭头迷去踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山纪游七首 其五 净明寺","author":"薛嵎","text":"入寺嫌僧俗，独行松径幽。\n夜扉崖室寂，斋磬铁盂秋。\n谷栈云迷级，石溪霜迸流。\n维摩不语坐，何日病能瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山纪游七首 其七 宝冠灵云二寺","author":"薛嵎","text":"夜钟寥阒远相闻，古佛青山自结邻。\n片石挂空平可渡，两峰侵汉立如人。\n云归荡顶无多路，僧住岩根老此身。\n为忆龙湫重回首，来看瀑布独逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁山纪游七首 其二 能仁寺","author":"薛嵎","text":"过尽盘山险，登临意忽平。\n殿灯摇佛影，瀑布杂钟声。\n湫阔龙居顶，路回峰换名。\n晓行林日薄，海气接云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廉村族人命赋唐补阙薛公墓 其二","author":"薛嵎","text":"何处青山无白骨，先生高节死犹存。\n古今人物一抔土，闽浙诗书百世孙。\n乡邑有祠尊往哲，樵刍知禁避荒垣。\n断碑残碣堪摩拭，惭愧年年宿草蕃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廉村族人命赋唐补阙薛公墓 其一","author":"薛嵎","text":"一自东宫吟苜蓿，吁嗟直道竟难容。\n精忠夙伫危邦虑，明哲宁高避世踪。\n疏傅有心辞汉陛，甘盘无梦佐商宗。\n寥寥千载闻风者，引领犹能式墓松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感兴","author":"薛嵎","text":"箪瓢吾道在，此乐语人难。\n遗却形骸累，始知天地宽。\n远山不辨树，高屋易生寒。\n数夜雪风急，编芦壁未完。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新年换桃符","author":"薛嵎","text":"桃符频换句难新，休对春风诉旧贫。\n近日儿童谈道学，几时徵诏及闲人。\n山田收薄官输在，树雪吹残曙色真。\n慨昔巢由老岩穴，终身击壤作尧民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新筑湖外草阁","author":"薛嵎","text":"挥手红尘吾老矣，断堤流水草堂新。\n几年荆棘无行路，一日云山有主人。\n未许园丁知姓字，先从渔父问仁邻。\n谢他鸥鹭烟光里，飞去飞来伴隐沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲍靖之左藏","author":"薛嵎","text":"一门期负荷，太息此生终。\n世道不如古，君心谁与同。\n官清馀橐在，虞返故堂空。\n作善宁须报，悠悠付彼穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霁雪亭","author":"薛嵎","text":"千树玉成林，远香清可寻。\n几疑安道在，直得老逋吟。\n迥与春风异，唯宜昼日阴。\n尘中无此景，羡尔弃华簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潘氏可轩","author":"薛嵎","text":"可人居此地，称此可轩名。\n力学倘无倦，终身集大成。\n言辞寓深浅，权度要分明。\n体认工夫到，何妨缓作程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潘氏梅所","author":"薛嵎","text":"种梅营数椽，四壁但萧然。\n清带山林气，香来笔砚边。\n云深天向晚，人立鹤趋前。\n余亦岁寒者，相从恰暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潘怀古参学","author":"薛嵎","text":"同吟四十过三四，常恨诗衔欠一官。\n人事中年多感慨，仕途今日更艰难。\n炉亭围坐推前辈，夜店单床定薄寒。\n最喜亲庭佳阙近，尽携儿女入长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潘南夫察院出台乡人荣其归拉余迎访因赋七言","author":"薛嵎","text":"囊封朝上暮身挤，谗口何如万目齐。\n昔谓椒兰诚择地，今知萧艾适同畦。\n波涛不动中流砥，风雨难瘖晦旦鸡。\n自著渔蓑厌趋谒，晨钟欣出郭门西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题山中井泉","author":"薛嵎","text":"井口依山缺，更无沙砾浑。\n相传海眼出，久视石碑存。\n定案星辰位，不多穿凿痕。\n旱年人尽汲，汲尽复源源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题中川张氏所居","author":"薛嵎","text":"鸥鸟往来处，此翁甘隐沦。\n地因人物著，名入郡图新。\n夜月情怀淡，茅茨意态真。\n高风无识拔，老却采薇身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仙岩玉桂花","author":"薛嵎","text":"生在龙居最上层，重重碎玉簇孤藤。\n灵根旧说宜丹汞，仙种元无到马塍。\n风过乍疑吹佩响，日笼还似点酥凝。\n三年刻楮成何事，除却天工人不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题扶疏亭竹","author":"薛嵎","text":"风晴雨雪天，无趣不萧然。\n影过邻家月，根通石下泉。\n长因终日看，忆得故山眠。\n物性今方会，心虚节自坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其十","author":"薛嵎","text":"柴门长日关，不碍溪水流。\n桃花树难寻，怅望回轻舟。\n虽无武陵源，事与昔人侔。\n已矣勿复言，白首安吾丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其九","author":"薛嵎","text":"老妻倦缝纫，痴儿厌藜藿。\n一贫谁复言，多累吾已错。\n山半云可耕，山下泉可凿。\n轩冕亦傥来，岂得长如昨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其八","author":"薛嵎","text":"古调今谁弹，至乐非外假。\n渊明爱无弦，此意知者寡。\n放鹤未归来，时倚长松下。\n旁观彼何人，笑我衣裳野。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其七","author":"薛嵎","text":"木落山转空，景驶寒亦早。\n百草无愠容，低头就枯槁。\n形生复形化，安用置怀抱。\n千古丘蹠分，所论非寿夭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其六","author":"薛嵎","text":"午睡不觉长，童子入城回。\n地炉散微烟，煨芋已成灰。\n独酌无佳宾，梅花为吾开。\n须臾山月高，顾影空徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其五","author":"薛嵎","text":"龙居洞云深，飞泉泻绝壁。\n不闻耳边喧，但觉心境寂。\n富贵由他人，得失俱抱戚。\n孰能全其天，山中樗与栎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其四","author":"薛嵎","text":"前村雨脚收，斜阳挂高树。\n老翁牵牛归，颇亦有幽趣。\n山风响茅屋，崖月导芒屦。\n平生江湖心，于此谢驰骛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其三","author":"薛嵎","text":"名利能移人，智者为之愚。\n历观古英雄，鲜或全其躯。\n幸逃世网牵，园绮真吾徒。\n勿令千载下，叹惜斯人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其二","author":"薛嵎","text":"阴壑生暮寒，白云如炊烟。\n麋鹿不识人，时复近我前。\n青松三四株，石床在其边。\n意思清且闲，可以终馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居十首 其一","author":"薛嵎","text":"深涧游群鱼，高树鸣幽禽。\n山中白日长，同此逍遥心。\n脱粳香可炊，浊酒聊自斟。\n过兹非所求，孰为升与沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为归云师赋野航","author":"薛嵎","text":"遇坎与乘流，谁能舍迹求。\n即空皆是境，大渡本无舟。\n风浪随机息，乾坤任泡浮。\n可怜迷岸者，漂荡几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆汪氏山亭旧游并简","author":"薛嵎","text":"因山为址屋无多，中有幽人衣薜萝。\n自撷溪毛充野腹，频敲牛角和渔歌。\n舟车相过情难数，姓字长留石可磨。\n遥想对床风雨际，一灯终夜照吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归云壁上人游方归","author":"薛嵎","text":"亦是无心出，不如归意闲。\n一身随铁锡，十载住金山。\n定石沾花雨，清斋带病颜。\n常云迷觉路，只在片言间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘荆山过惟扬再谒贾秋壑","author":"薛嵎","text":"扉屦践淮雪，故人师帅欢。\n灯前话畴昔，时事又艰难。\n陪宴平山晓，寻梅古署寒。\n却归访泉石，珍重慰团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈子渊台州添倅","author":"薛嵎","text":"高志爱官闲，来从玉笋班。\n离家买湖石，开印对巾山。\n风月添新句，朋游记旧颜。\n桃花元有约，猥贱未能攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佺上人游方","author":"薛嵎","text":"燕鸿来去尽，萧索此时心。\n杖锡投何寺，风霜别故林。\n夜床煨叶火，朝谷应樵音。\n往往长松下，看山坐独吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定庵远山主","author":"薛嵎","text":"修持功行满，不堕劫中尘。\n龙象西天邃，杉松卵塔新。\n腊高同辈尽，敛薄小师贫。\n生灭理无二，交深独怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松阜弟于宝成寺祖墓之侧营创别业为赋得闲亭诗取又得浮生半日闲之句","author":"薛嵎","text":"陟巘心已清，复此风雨蔽。\n高人疏凿馀，理道颇超诣。\n卜筑谐素志，缁侣欣共济。\n脩竹尚无恙，巢鹤亦数世。\n空山岚欲滴，近水石可憩。\n春睡朝旭升，夜语孤烛继。\n高扁出林麓，先垄记苗裔。\n严钟警晨昏，群岫罗扈卫。\n身同野鹿游，迹许巢父媲。\n蜗角自为雄，蚁磨卒至毙。\n靡怀半日羡，讵识终老计。\n吾庐并渔村，兴往辄鼓枻。\n野衣裁芰荷，败屋粘薜荔。\n川陆阻会面，岁月迅流逝。\n兹情不可忘，淡交慎勿替。\n及时毕婚嫁，即事无芥蒂。\n相从丘壑真，永使心迹契。\n泉石闻斯言，庶以当盟誓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡贤良进史","author":"薛嵎","text":"白首裒遗传，难甘閟一丘。\n表成趋阙拜，路左别家愁。\n文字归中秘，科名异杂流。\n当年韩吏部，何自抱深忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送潘道士","author":"薛嵎","text":"春渚微茫碧草连，千花飞尽柳飞绵。\n孤云野鹤生遥思，明月清风共一船。\n破褐还寻栖隐地，空囊唯乞送行篇。\n先生自有修真诀，不倚丹砂驻少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游雁山分得六题 其三 天聪洞","author":"薛嵎","text":"天听本非耳，形容独费吟。\n岂伊穿凿力，能探杳冥心。\n混沌开中窍，空虚纳众音。\n下临千仞险，当暑骨毛森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭槐径弟","author":"薛嵎","text":"孤僻由天性，看山独展眉。\n岂无身后虑，犹课病中诗。\n泉石宁非祟，苍旻不可知。\n平生唯爱菊，增我九秋悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢旧友生","author":"薛嵎","text":"交游半零落，身在复长贫。\n对语寒灯尽，相看白发新。\n兵兴无乐土，市近少闲人。\n遥忆桃源路，鸟啼花自春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼薛君载","author":"薛嵎","text":"衣被唯綀褐，长闲未觉贫。\n将何折君寿，不尽百年身。\n竹树多于屋，禽鱼近得人。\n生无世情恋，宁复怨苍旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父","author":"薛嵎","text":"一笠一蓑衣，空江雨雪霏。\n得鱼虽假饵，于世本无机。\n晚唱教儿和，闲身尽醉归。\n沧浪犹未足，长羡白鸥飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瓢饮陈子在病后见寄次韵奉答","author":"薛嵎","text":"闻君卧病长于悒，文会过从迹顿疏。\n空对秋风惊节物，无因杯酒具园蔬。\n柴荆昼掩听残雨，灯火凉生理故书。\n一启来缄拜佳什，清泠如奉笑谈馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题采药图","author":"薛循祖","text":"江山奇峰雨后多，千层飞瀑洒青萝。\n扶筇亦觉溪桥滑，尚有幽人采药过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋园咏物 其二 雁","author":"薛循祖","text":"风急翅纷纷，遥空自作群。\n到来秋塞月，鸣入暮江云。\n乱起千行字，俱飞一片文。\n高楼有思妇，嘹呖岂堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋园咏物 其一 蟋蟀","author":"薛循祖","text":"怪尔知时节，逢时辄自鸣。\n空阶一夜响，短榻几人惊。\n唧唧催寒色，萧萧助叶声。\n无人悲物意，徒语不堪情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟泊五圣祠前","author":"薛琦","text":"叶落古祠前，村安许宿船。\n人声齐到客，月色独归禅。\n野火明秋渚，山钟出寺烟。\n推蓬不成寐，霜气览江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题荆浩画青山白云卷","author":"薛琦","text":"渺渺山上山，隐隐树边树。\n鸡犬不闻声，居人在何处。\n扁舟载酒来相寻，古木苍苔一径深。\n白云不飞青山舞，谁悟荆生点笔心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栖岩寺","author":"薛嗣昌","text":"出郭自然尘事少，携家况作栖岩行。\n千寻尽处暮云碧，万籁息时霜月明。\n林外扶疏竹影碎，岭头依约松风声。\n他年若此卜幽隐，兴来更遂登临情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿草堂寺","author":"薛嗣昌","text":"驰车晚叩古禅林，乔木参天一径深。\n门外乱山连翠色，竹间流水漱清音。\n幽怀暂喜来栖处，高士遗踪悉访寻。\n谁会宗风当日意，庭前苍桧尚青阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泄潭瀑布","author":"薛寘","text":"秋高水壮雪飞涛，岩木招风怒窍号。\n不是玉虹低涧饮，白龙拖雨下山腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望金山用唐人韵","author":"薛靖","text":"一柱支空立，涛声春寺闻。\n消来巴地雪，飞到润州云。\n寂寞江山色，纵横盗贼群。\n不堪形胜里，北望涕纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁久旱喜雨","author":"薛靖","text":"东南苦亢阳，吴越重罹厄。\n流徙罄村墟，入夏地尚赤。\n讵无沟中人，矧乃急往役。\n赖兹天心慈，弗终閟膏泽。\n凯风将雨至，蓬蓬亘昕夕。\n水势千涧呼，云阴四郊积。\n祁祁沾洒均，欢声遍南陌。\n秋秧布有种，万一偿春麦。\n相率理长镵，幸可谋担石。\n我亦歌豳风，忧心庶几释。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"薛魁祥","text":"霜风猎猎催寒冬，诸君马首将欲东。\n出门浩气如长虹，举手欲挂扶桑弓。\n君家渭阳盖世功，黄沙万里归兵戎。\n牙旗金甲照天红，江南草木皆春风。\n黄金筑台高巃嵷，三千珠履誇豪雄。\n君今联辔登仙篷，绿水依依泛芙蓉。\n貂蝉出自兜鍪中，猬锋螳斧一扫空。\n我忝吴下旧阿蒙，铁砚磨尽平生工。\n于山未见泰华峰，于人未见欧阳公。\n借君谈天荐口为先容，他日四方上下追逐如云龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立夏","author":"薛澄","text":"渐觉风光燠，徐看树色稠。\n蚕新教织绮，貂敝岂辞裘。\n酷有烟波好，将图荷芰游。\n田间读书处，新笋万竿抽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋得一年将尽夜","author":"薛澄","text":"可惜惟兹夕，须臾即旧年。\n人间岁穷处，客馆夜分边。\n应逐银缸谢，聊凭玉漏延。\n晓风虽未至，残腊几时天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效朱公叔绝交诗","author":"薛澄","text":"东山有枭，不祥其名。\n恶木是息，恶声是鸣。\n食不弃腐，饮不择清。\n宜飞求伏，以晦为明。\n凶残满志，嗜欲惟撄。\n伸颈招凤，使凤自惊。\n岂有凤口，而和枭声。\n奈何伊人，弗审物情。\n请从此别，各自谋生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子","author":"薛燧","text":"柳色锁重楼。\n楼上轻寒不满钩。\n堆径落红深半指，悠悠。\n飞絮帘栊几许愁。\n逐日望归舟。\n暖藕全宽玉臂韝。\n待得君来春去也，休休。\n未老鸳鸯早白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿波亭","author":"衡泌","text":"清泪斑斑洒绿波，年来转觉别离多。\n扁舟南浦分携处，水远山长愁奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大涤洞天留题","author":"霍正夫","text":"长虹舞涧石磷磷，胜践还怜雨送春。\n云木千章森翠幄，洞天九锁绝红尘。\n丹藏仙谷生奇箬，香到龙祠泽旱民。\n山有旧盟来更好，斋心恭对玉晨真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]