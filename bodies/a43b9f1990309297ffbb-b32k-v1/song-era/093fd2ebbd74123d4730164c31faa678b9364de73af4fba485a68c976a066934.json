1dd506c738b4292a","dynasty":"宋"}},{"title":"和周明瞻秋香五首 其三","author":"吴芾","text":"恼人风味冠江南，浪蕊浮花总觉凡。\n对此自宜文字饮，不须更倩玉纤掺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周明瞻秋香五首 其二","author":"吴芾","text":"月窟仙人冷淡妆，鹅黄衫子翠罗裳。\n虽无妖艳誇尘俗，别是人家一种香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周明瞻秋香五首 其一","author":"吴芾","text":"落叶初辞万木林，谁将翡翠屑寒金。\n朝来散入亭前树，着处幽香欲满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林大任三首 其三","author":"吴芾","text":"花绕禅房水更深，静中啼鸟有嘉音。\n我来已觉心如水，不用临流更洗心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林大任三首 其二","author":"吴芾","text":"兰舟泛泛漾轻风，十里桃花一望中。\n疑是馀霞天外落，不应花解满山红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林大任三首 其一","author":"吴芾","text":"融融春色满花源，杨柳阴中系画船。\n笑逐鳌头花下去，旌旗夹道鼓渊渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和金功叟二首 其二","author":"吴芾","text":"君家今岁受恩封，共庆夫夫妇妇同。\n况遇诞弥尤可乐，愿拚沉醉似仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和金功叟二首 其一","author":"吴芾","text":"两家诞日俱延客，长恨无缘笑语同。\n辄奉朋尊聊介寿，愿言百岁亦如翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和康伯可重阳","author":"吴芾","text":"过了重阳又一阳，梅开亦拟共壶觞。\n病中无复成狂饮，且作前贤醒里狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梁次张谢得酒见寄四首 其四","author":"吴芾","text":"平生性僻有诗耽，每恨才悭不得兼。\n独嗜君诗无厌斁，从教人笑我多馋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梁次张谢得酒见寄四首 其三","author":"吴芾","text":"妙龄才气压同升，谈笑端能却五兵。\n况复锦囊新且丽，粲如春树万枝荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梁次张谢得酒见寄四首 其二","author":"吴芾","text":"春入横塘绿胜醅，更将清浅照寒梅。\n试吟秀句临流坐，引得疏枝一晌开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梁次张谢得酒见寄四首 其一","author":"吴芾","text":"传得仙家不老方，酿成春色瓮头香。\n一樽聊尔资杯酌，争似相携入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅花前见鹤","author":"吴芾","text":"双鹤翩翩到我前，与花斗白更争妍。\n低头自觉形仪秽，安得飘然跨上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和隐老见怀二首 其二","author":"吴芾","text":"咫尺经时阻笑言，春归空想给孤园。\n一声啼鸟山深处，宴坐蒲团未觉喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和隐老见怀二首 其一","author":"吴芾","text":"独立溪头怅望时，高人遗我送春诗。\n不知春色归何处，月落空庭费梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和龚漕二首 其二","author":"吴芾","text":"人生笑口苦难开，故事当修戏马台。\n已许为君拚一醉，何妨今日且衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和龚漕二首 其一","author":"吴芾","text":"我老强来分外阃，君才端合在中台。\n语离正欲连宵醉，应笑清斋不举杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和潘大卿芍药二首 其二","author":"吴芾","text":"拂拂轻黄染御衣，出群标韵异繁枝。\n此身已分京华隔，不谓天香尚许披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和潘大卿芍药二首 其一","author":"吴芾","text":"落尽群花春已残，忽惊庭下锦新翻。\n夜深领客穷清赏，一笑开怀倒数尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戴解元雄飞瑞香二首 其二","author":"吴芾","text":"碧玉扶疏自可观，花头缠锦更团圞。\n坐来已觉明人眼，况有幽香馥鼻端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戴解元雄飞瑞香二首 其一","author":"吴芾","text":"芳心似与春风约，绝艳还宜晓日笼。\n虽谢幽人持赠我，对花无奈忆山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏松 其一","author":"吴芾","text":"古人长抱济人心，道上栽松直到今。\n今日若能增种植，会看百世长青阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏松 其二","author":"吴芾","text":"古邑荒凉但有松，浓阴夹道势腾空。\n行人破暑忙归去，未必茅檐有此风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏松","author":"吴芾","text":"幸不生涧底，杰出苍苍崖。\n岁寒只孤秀，万木非吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏海棠呈子肃","author":"吴芾","text":"海棠元自有天香，底事时人故谤伤。\n不信请来花下坐，恼人鼻观不寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹闻笛","author":"吴芾","text":"三十年前此凭栏，醉听渔笛暮江寒。\n重来虽复闻三弄，老去终无旧日欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜与作霖避暑南园登江月台二首 其二","author":"吴芾","text":"俯瞰江流万尺台，暑天长引好风来。\n若为今夕如相避，怀抱何由一快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]