[{"title":"藤州道上","author":"李孟博","text":"道上何尝识故侯，解鞍聊发小迟留。\n莫向漳江更南望，四十八驿是藤州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江太守生日","author":"李季可","text":"道路尽歌贤太守，祈颂万人同一口。\n只应悯及黄衣儿，亦使衔环致君寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花/玉楼春 惜春","author":"李季萼","text":"东风忽起黄昏雨。\n红紫飘残香满路。\n凭阑空有惜春心，浓绿满枝无处诉。\n春光背我堂堂去。\n纵有黄金难买住。\n欲将春去问残花，花亦不言春已暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李宗孟","text":"空遗费仙迹，不见庾公游。\n草木皆新色，江山馀故愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静居","author":"李宗易","text":"大都心足身还足，祇恐身闲心未闲。\n但得心闲随处乐，不须朝市雨云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居有感","author":"李宗易","text":"进退荷君恩，孤怀岂易论。\n以闲销日月，何力报乾坤。\n架上书千卷，花前酒一尊。\n相持两成癖，此外尽忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重建羊太傅祠和王原叔句","author":"李宗易","text":"叔子祠荒岁已深，异时贤守重登临。\n岘山岑寂瞻风概，汉水灵长想德音。\n奉诏始闻新缔茸，有知那复叹湮沈。\n又刊翠琰留南夏，先后功名照古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题秀江亭","author":"李宗勉","text":"经行塔下几春秋，每叹无缘到上头。\n今日登临方觉险，不如归去卧林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"李宗谔","text":"戴了宫花赋了诗，不容重睹赭黄衣。\n无聊独出金门去，恰似当年下第归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝石集贤饮","author":"李宗谔","text":"都门祖軷绮筵张，举白无由诉羽觞。\n石室紬书勤亦至，金貂换酒醉何妨。\n瓮间吏部宁须问，席上车公不可忘。\n应念朝来犹眊氉，解酲谁用蔗为浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代意","author":"李宗谔","text":"雾鸾晓影忽参差，云雨阳台役梦思。\n自是胶弦无续日，不同圭月有圆时。\n洞房斗帐承新爱，河汉星桥隔后期。\n绮榭凝尘断消息，抒情空拟四愁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉武","author":"李宗谔","text":"建章宫阙郁岧峣，露掌脩茎倚泬寥。\n平乐馆中观角抵，单于台上慑天骄。\n蓬莱望气沧波阔，太一祈年紫府遥。\n西母不来东朔去，茂陵松柏冷萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕寄献内翰虢略公","author":"李宗谔","text":"东城南陌尽游人，陌上香车起暗尘。\n历历星榆光夺昼，煌煌火树艳争春。\n章沟五鼓催行乐，卫尉千庐罢徼巡。\n应念鳌山方并宿，紫泥封后独频伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南朝","author":"李宗谔","text":"仙华玉寿夜沉沉，三阁齐云复道深。\n平昔金铺空废苑，于今琼树有遗音。\n珠帘映寝方成梦，麝壁飘香未称心。\n惆怅雷塘都几日，吟魂醉魄已相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何水部蒙出牧袁州","author":"李宗谔","text":"三省郎曹素发垂，两朝频赐五时衣。\n一麾又守江城去，千骑方从泽国归。\n酾酒河梁秋草阔，卸舟湖岸暝烟微。\n宜阳郡客多才子，谁伴山公醉夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗送士龙腹兄","author":"李宗谔","text":"铜鱼四明守，竹马十年兄。\n掺袂河梁别，鸣桡泽国行。\n登楼知日近，傍海见潮生。\n郡政应多暇，新诗几首成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆中新蝉","author":"李宗谔","text":"雨过新声出苑墙，烟轻馀韵度回塘。\n短亭疏柳临官道，平野西风更夕阳。\n八斗陈思饶赋咏，二毛潘岳易悲凉。\n感时偏动骚人思，不问天涯与帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏华林书院","author":"李宗谔","text":"华林有胡氏，孝义共知名。\n宅对千峰秀，家传双桂荣。\n书楼藏六籍，讲席聚诸生。\n官序新春拜，门闾往岁旌。\n儿孙多力学，兄弟亦躬耕。\n一院松篁影，满山猿鹤声。\n傍溪挑蕨煮，就树采茶烹。\n客恋琴樽乐，僧依水石清。\n官途空扰扰，尘世自营营。\n他日林泉约，何当遂此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归天宁万年禅院","author":"李宗谔","text":"师住天台寺，天台水石幽。\n眼前皆胜境，门下尽名流。\n法号君恩赐，精蓝国力修。\n渡杯来凤阙，振锡谒珠旒。\n内殿从容对，神都委曲游。\n高僧类云鹤，归思在林丘。\n御札全编得，宸毫几处收。\n遥思到时节，烟树赤城秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清风十韵","author":"李宗谔","text":"閒馆方回暑，商飙乍应金。\n天高初起籁，松澹更宜琴。\n汾棹传歌远，班诗托兴深。\n东阳仁自布，西颢气还侵。\n太液翻晴旭，灵和乱翠阴。\n舟轻飞燕袂，台迥楚王襟。\n阮啸经时尽，齐蝉度日吟。\n愁生孤戍角，响续暮城砧。\n空静销云镂，庭虚转蕙心。\n贤哉吉甫颂，千载有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李宗谔","text":"一溪晓绿浮鸂鶒，万树春红叫杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李宗谔","text":"上饶多胜景，樽酒不应空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李宗谔","text":"金銮后记人争写，玉署新碑帝自书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李宗谔","text":"门外溪山荆渚路，马前梅杏汉江春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万春洞","author":"李宗道","text":"何山凿出洞岩深，置屋悬崖映竹林。\n像设金园崇梵宇，壁间石室塑观音。\n接天远岫巍千古，跨涧飞虹映百寻。\n极目凭栏多少景，一回到此一寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天香 宛委山房拟赋龙涎香","author":"李居仁","text":"瀛峤浮烟，沧波挂月，潜虬睡起清晓。\n万里槎程，一番花信，付与露薇冰脑。\n纤云渐暖，凝翠席、氤氲不了。\n银叶重调火活。\n珠帘日垂风悄。\n螺屏酒醒梦好。\n绣罗帱、依旧痕少。\n几度试拈心字，暗惊芳抱。\n隐约仙舟路杳。\n谩佩影玲珑护娇小。\n素手金篝，春情未老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 浮翠山房拟赋白莲","author":"李居仁","text":"蕊仙群拥宸游，素肌似怯波心冷。\n霜裳缟夜，冰壶凝露，红尘洗尽。\n弄玉轻盈，飞琼绰约，淡妆临镜。\n更多情、一片碧云不掩，笼娇面、回清影。\n菱唱数声乍听。\n载名娃、藕丝萦艇。\n雪鸥沙鹭，夜来同梦，晓风吹醒。\n酒晕全消，粉痕微渍，色明香莹。\n问此花，盍贮瑶池，应未许、繁红并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同丁致远司户游东掖山 其二","author":"李庚","text":"与君共饱桑门饭，愧我曾非莲社人。\n若问生公讲堂事，青山门外自横陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同丁致远司户游东掖山 其一","author":"李庚","text":"不见诗人老郑虔，谁知衣钵此中传。\n尚馀杰阁惊人句，更结今秋未了缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画扇","author":"李庚","text":"睡起小楼春又残，半垂云袖傍栏干。\n杨花飞过鞦韆索，一阵东风作晓寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其三 玉霄亭","author":"李庚","text":"亭亭玉霄峰，列仙皆羽化。\n把酒碧桃间，吹箫明月下。\n嗟我落尘凡，鹤背应难跨。\n夫子真癯儒，好上班麟驾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其二 双岩堂","author":"李庚","text":"吾州山水窟，城郭拥寒绿。\n戢戢群峰间，峙此一双玉。\n相对如佳宾，可敬不可渎。\n空翠扑衣裳，夜来雨新沐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其六 乐山堂","author":"李庚","text":"青山如避世，讵肯诣公府。\n仁人如好贤，招邀入庭户。\n拄笏对朝气，卷帘当暮雨。\n是中有佳趣，莫与儿辈语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其十二 节爱堂","author":"李庚","text":"吾爱巴扬州，夜不然官烛。\n吾爱阳道州，日炊米二斛。\n使君美无度，力蹈前贤躅。\n宜尔海云边，十万户蒙福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其八 君子堂","author":"李庚","text":"文简为州时，不求赫赫誉。\n温恭君子儒，岂弟民父母。\n黄堂能几年，清风霭千古。\n愿公踵前修，特此相明主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其一 参云亭","author":"李庚","text":"元公来把麾，与民脱水厄。\n当时游息地，危亭冠州宅。\n梁栋宿寒云，去天才一握。\n尚馀手种木，甘棠思邵伯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其十一 驻目亭","author":"李庚","text":"吏散长廊静，杖藜巾一幅。\n只图宽眼界，不管穷脚力。\n野水露微湾，寒山出寸碧。\n待拍洪崖肩，蓬莱真咫尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其四 匿峰亭","author":"李庚","text":"新亭方半丈，众山之所宗。\n悭容半窗月，劣受一帘风。\n傍人笑老子，游戏如儿童。\n乱峰徒颉颃，不与汝争雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其七 清平阁","author":"李庚","text":"彼美东堂下，方池谁凿成。\n萧侯慨不见，亦足窥典刑。\n湛湛鱼可数，怗怗鸥不惊。\n此心有如水，通国号神明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其九 静镇堂","author":"李庚","text":"海邦本淳古，山民亦颛蒙。\n汝不探赤丸，我无为缿筒。\n熙熙樵与牧，蔼蔼春风中。\n何必师齐相，虚堂舍盖公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其五 凝思斋","author":"李庚","text":"孙绰赋天台，伻人以图至。\n公今身见之，情亲心更醉。\n坐想复行吟，商颂得十二。\n寄语范荣期，金声重掷地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题尤使君郡圃十二诗 其十 霞起堂","author":"李庚","text":"赤城古洞天，彤霞照山谷。\n烂烂九光垂，馀辉借草木。\n伊予有痼疾，企望常不足。\n待与马练师，耘芝灌松竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹤山","author":"李建中","text":"玉箫峰下仙君宅，一树岩花几百春。\n当日会稽王内史，如何不见竹间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早朝","author":"李建中","text":"著衣香重海棠风，人在瀛洲御苑东。\n将对赤墀班未定，井斡楼角且先红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直宿","author":"李建中","text":"春风夜急铜龙漏，淡月半斜金井阑。\n已觉亚枝花露重，宿莺犹睡怯馀寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄英公大师","author":"李建中","text":"往岁潇湘一相见，诗成野逸笔狂颠。\n近闻归住长安寺，松老书窗又岁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题洛阳寺壁","author":"李建中","text":"杉松倒涧雪霜乾，屋壁麝煤风雨寒。\n我亦平生有书癖，一回入寺一回看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题洛阳观音院牡丹 其二","author":"李建中","text":"花谱名将第一论，洛中最是此花繁。\n不当更道木芍药，枝上恐伤妃子魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题洛阳观音院牡丹 其一","author":"李建中","text":"微动风枝生丽态，半开檀口露浓香。\n秦时避世宫娥老，旧日颜容旧日妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题菩提寺","author":"李建中","text":"龙门双阙涌云烟，雪未飞花雁下前。\n彻底清流照车马，分台御史过伊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀湘南旧游寄起居刘学士","author":"李建中","text":"老情诗思关何处，浑是湘南水岸头。\n残白晚云归岳麓，浓香秋菊满汀洲。\n静寻绿径煎茶寺，遍上红墙卖酒楼。\n西洛分台素拘检，绣衣不得等闲游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杭州望湖楼","author":"李建中","text":"小艇闲撑处，湖天景物微。\n春波无限绿，白鸟自由飞。\n落日孤汀远，轻烟古寺稀。\n时携一壶酒，恋到晚凉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽偶书七言四韵奉承采览","author":"李建中","text":"粉闱丹地白头深，书殿分廊寓直人。\n不怕花枝惊老眼，可无诗句送残春。\n因嗟红影随风去，犹为青丛绕槛频。\n更把华灯照深夜，一年情味隔音尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"李建中","text":"紫殿谒宸极，赤城归旧山。\n气清玄鹤下，语淡白云閒。\n路入翠微外，岩栖瀑布间。\n何当一携手，相与语灵关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡斋偶书寄同院彭城学士兼简兵部同年采览","author":"李建中","text":"閒情閒忆事如空，静读离骚向郡中。\n冠剑老年伤远别，关诃夜月许相同。\n晚花天气孤庄雨，流水人间小阁风。\n行乐及时聊强饮，不须嫌作白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福圣观","author":"李建中","text":"永怀閒访道，斗上上仙居。\n瀑水磬声外，桂花林影疏。\n山名孙绰赋，观额葛玄书。\n已负秋来约，诛茅兴有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"李建中","text":"山绕华林气象和，此心犹恨未相过。\n门闾世表曾颜德，榜帖人登晁董科。\n春暖花开飘几砚，晚归云影在松萝。\n公卿无限新诗什，雅咏悠然地益□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开垣曲山路成","author":"李建中","text":"为郡同卧理，民情识我情。\n三秋得公事，一月绕山行。\n砥柱全抛险，黄河日接平。\n周遭到垣曲，尊大近神京。\n借助林盐润，增饶国计成。\n虞州访遗迹，吴坂念长鸣。\n董泽蒲侵绿，巫咸水傍清。\n人怀绛县老，地叹夏台倾。\n下马听泉发，登原待月生。\n盘桓读碑版，扶持立刀兵。\n晚霭闻钟断，微阳喜雨晴。\n峭空崖背落，斗截岭西横。\n仙恐临王屋，高疑见析城。\n去车知轨辙，连亩有农耕。\n彩错翻朝旆，铮鏦击夜钲。\n凿开青石壁，填贮白云坑。\n旧幕怜才俊，嘉言许道亨。\n何当议险阻，始信说分明。\n不倦共廉使，常存济物诚。\n计时聊就笔，千古愧题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬杨少监见寄退居遣兴之什","author":"李建中","text":"贤哲道相扶，经纶本近侍。\n风云如有会，霄汉宁无志。\n月窟桂抱林，粉闱丹漆地。\n一何华给束，而谓浮名遂。\n堆积图史书，朝昏铅椠事。\n登瀛才力劣，对问神魂愧。\n步骤古人踪，含虚郡子器。\n献言既无状，出守连移次。\n持宪怀真刚，退藏生寤寐。\n欲邀丘壑老，静坐樵鱼帅。\n颢气留丹田，尺宅分品位。\n寥寥洞府境，落落烟霞意。\n金简题上青，与兹尘土异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题仙都山","author":"李建中","text":"岩岩仙都山，肃肃黄帝宫。\n巨石临广泽，千仞凌高穹。\n肇当融结初，全得造化功。\n深可蟠厚壤，峭疑接冥鸿。\n云軿去路存，丹鼎遗迹空。\n抽润草心碧，敷香莲叶红。\n升龙扳矫矫，飞凤鸣噰噰。\n而我集仙署，尝比瀛洲雄。\n星移婺女间，凤驾析木东。\n到觉毛骨爽，坐如羽翼冲。\n万事皆氛埃，一气归鸿濛。\n遐哉上圣道，貌与元化同。\n金简奠至诚，玉书铭代工。\n功成解冠剑，栖息期此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"澹山岩","author":"李建中","text":"常思羽衣人，宅此岩崖傍。\n□□通大道，玄关掩中黄。\n古朴宫殿□，偃亚松桂香。\n洞户漏夕月，木罅生□阳。\n叠齿上层巅，露井连曲房。\n断壁广横幕，矗石排吟□。\n蛰痕燕穴空，乳溜虬鳞张。\n清泉弄春□，灵草经冬芳。\n自笑老倒容，谁□刀圭霜。\n金版佩上籍，玉音歌洞章。\n□□夜森立，绛节朝飞扬。\n咫尺仙路高，喧嚣机世忙。\n浮埃走车马，奔迸多事场。\n真地拥烟霞，根本无为乡。\n不到久叹息，一来徒悲伤。\n但听铿华钟，所得心耳凉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"李建中","text":"按部先春凤林野，写怀空望鹿门山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"李建中","text":"睛山云罨画，孤屿水含棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李建中","text":"频年水国饫鲑鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李建中","text":"山程授馆闻鸿夜，水国还家欲雪天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李建中","text":"涨烟春气重，贮月夜痕深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]