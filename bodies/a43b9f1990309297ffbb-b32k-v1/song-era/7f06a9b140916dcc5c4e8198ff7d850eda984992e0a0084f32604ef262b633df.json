[{"title":"送心上人","author":"王之道","text":"西城畦稼卧黄云，似说千门许见分。\n驴载马驮应不厌，一?牙齿正须君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送浮屠宗立东游二首 其二","author":"王之道","text":"西走漫偿行脚债，南游聊勘坐禅翁。\n不知色力能强健，又复观潮过浙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送浮屠宗立东游二首 其一","author":"王之道","text":"抚掌相逢一笑同，自言参学百无功。\n蜜甜忘却十年苦，雷吼嚇成三日聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送浮屠善慧","author":"王之道","text":"云涛霜巘正峥嵘，梦里清游觉尚惊。\n师到西湖如得句，不妨频寄老书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送浮屠道廓","author":"王之道","text":"一宿已先觉，四明那更游。\n去来无所着，风日海山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送贾教授伟满罢东归","author":"王之道","text":"妙年才气擅超群，试吏来司泮水芹。\n行矣玉堂应召直，忍将风袂与君分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送顾渚茶与孔纯老","author":"王之道","text":"晓来飞雪似欺春，尽把群芳点缀匀。\n莫讶两旗分顾渚，要令佳句斗清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曾式古归建昌","author":"王之道","text":"两年说归明日归，江头草软花芬菲。\n风调江净船行驶，好看芳草怀春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送道者史宝通作丐","author":"王之道","text":"昔日山前寺，兵馀扫地空。\n汝今能协力，真是宝林通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳示二三友","author":"王之道","text":"龙山何处暮云黄，坐想前贤落帽狂。\n萸实菊花良不恶，为君沽酒作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"王之道","text":"亭亭青盖倚宫妆，新浴温泉体自香。\n暂借青风来一霎，欲披云锦见蜂房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书","author":"王之道","text":"万事秋来只信缘，为谁清嚏晚风前。\n断虹收尽廉纤雨，喜见江南八月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿大泉遇雨","author":"王之道","text":"我行常苦雨相随，旱甚民心若倒垂。\n坐久云容肤寸合，愿同焦槁被甘滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄二儿","author":"王之道","text":"老懒谁能教子孙，静中犹喜读书声。\n有如双凤传家学，令我闻风畏后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄梅花与曾子修","author":"王之道","text":"待船聊复驻征骖，手撚梅花望翠岚。\n花似若人清绝俗，故从江北寄江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴 其一","author":"王之道","text":"飞霰飘飘堕晚风，乱山无数暮云同。\n天工却似怜羁旅，又变霜华见碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚憩闻雷","author":"王之道","text":"湖外山光入座来，水晶宫阙翠屏开。\n纤纤细落催花雨，隐隐轻鸣启蛰雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其十","author":"王之道","text":"花前倾步溅狂澜，花外扶疏竹数竿。\n带雪精神清更好，冰肌元惯朔风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其五","author":"王之道","text":"檐花厌浥细如尘，渡口舟横不见人。\n独喜霜蕤清照坐，旅怀虽恶未孤春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其二","author":"王之道","text":"晓来飞雪缀林端，冰玉肌肤巧耐寒。\n折得一枝红半吐，自挼香蕊当朝飧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其七","author":"王之道","text":"素艳忽从江上见，清香还向雪中闻。\n谁能送酒来相劳，为尔开尝对马军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其六","author":"王之道","text":"凌霜冒雪报花期，大小群芳例是儿。\n屈指春风无十日，东君元是旧相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其一","author":"王之道","text":"额黄肌粉斗新妆，春入园林度暗香。\n留滞江南归未得，一枝聊复沃愁肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其四","author":"王之道","text":"竹外山前见嫩黄，水沉清渍雪肌香。\n应嫌桃李风姿俗，故作寻常淡淡妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其九","author":"王之道","text":"别后开园日就荒，对花还忆少年狂。\n东荣几树应无恙，待得予归破嫩黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝追和张文潜韵 其三","author":"王之道","text":"年年常是犯凝寒，换骨曾凭九转丹。\n结实和羹知不晚，试尝花蕊味应酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花和黄觉民四首 其四","author":"王之道","text":"夜来春信到南枝，姑射神人逞雪肌。\n多谢长须解予意，送将羁客换新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花和黄觉民四首 其三","author":"王之道","text":"依倚春风雨净瓶，暮林摇落避真清。\n暗香似与常娥约，来借黄昏淡淡明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花和黄觉民四首 其二","author":"王之道","text":"萧然清映水边枝，似向温泉见玉肌。\n被恼诗人应不彻，怪来言语总成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花和黄觉民四首 其一","author":"王之道","text":"净几閒窗小小瓶，一枝春色为谁清。\n吾今老去心如水，销得诗人与證明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿萼梅","author":"王之道","text":"天然腻玉细生香，斜倚东风伫淡妆。\n可是春寒犹料峭，晓窗犹试绿罗裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊","author":"王之道","text":"千林摇落见孤芳，色映青松破嫩黄。\n玉露凄凉三径晚，金英芬馥几丛香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游毛公洞六首 其六","author":"王之道","text":"偶因青鸟遂幽寻，翠壁苍崖白日阴。\n三扣石扉人不识，满山松竹自悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游毛公洞六首 其五","author":"王之道","text":"徘徊银穴送斜晖，散遣长须上翠微。\n青鸟似知予意确，故传仙语傍人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游毛公洞六首 其四","author":"王之道","text":"山前踊跃见樵人，欲问神仙更问津。\n指点长柯向东去，不知银穴又非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游毛公洞六首 其三","author":"王之道","text":"须信桃源路易迷，野人遥指过山西。\n由来石室非仙窟，漫向云中觅旧蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游毛公洞六首 其二","author":"王之道","text":"旋披荆棘入山来，洞口晴烟翳不开。\n试问真人竟何处，他年相就谒蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游毛公洞六首 其一","author":"王之道","text":"说诗人去想云车，千古青岩倚碧虚。\n训诂未容端拜议，一言聊复问关雎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落梅入砚池","author":"王之道","text":"玉佩翻然下帝傍，墨池照影妒新妆。\n时人莫作飘零看，收拾毫端无尽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢潘寿卿惠笺并诗","author":"王之道","text":"饷厚东阳一万番，从今难放笔头閒。\n新诗正与花笺似，文彩纵横咳唾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道上杂花盛开","author":"王之道","text":"涓涓流水雨晴初，夹道山花簇綵舆。\n千骑不辞迎候远，物情春意竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集英殿赐第出马上口占","author":"王之道","text":"鞭丝曳雪缭官槐，绿阵中间一道开。\n高下未劳轻喜愠，相公曾作榜梢来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬孔纯老送海错三首 其三","author":"王之道","text":"恶语岂堪酬妙句，粗餐曾不餍常珍。\n得君海错俱奇绝，从此鄞江发兴新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬孔纯老送海错三首 其二","author":"王之道","text":"螺头已荷兼三和，凤髓何须贵八珍。\n多谢邦君怜不饮，只将诗句巧争新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬孔纯老送海错三首 其一","author":"王之道","text":"海错东来自四明，感君怜我故分珍。\n拜嘉何必须豪饮，大嚼姑从得句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴花","author":"王之道","text":"看花令我忆金明，五月尊罍竹叶青。\n窈窕宝津楼下路，断肠千里四周星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题大龙寺","author":"王之道","text":"万松邀我上崔嵬，入寺山屏次第开。\n无说欲知真说法，松声还送出山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题大泉寺","author":"王之道","text":"六峰环翠绕金蓝，下马初尝一酌甘。\n久旱喜看云气浃，晚风吹雨过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题大善寺","author":"王之道","text":"絮帽曳丝云带雨，琼梳环髻水围山。\n江村五月黄梅过，十里人烟渺莽间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题乌江官舍木芙蓉","author":"王之道","text":"桃叶萧疏柳叶黄，清寒应怯夜来霜。\n芙蓉雅与秋相好，独对层台试晓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太湖驿竹轩","author":"王之道","text":"粉节储霜竞出篱，我来犹及笋生时。\n清风一榻君休问，明月半窗予自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题华严院泽上人西韵轩用前韵","author":"王之道","text":"疏帘如雾隐窗纱，虹影青红雨脚斜。\n坐久清风起何处，一盆昌歜映葵花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题许市施水坊","author":"王之道","text":"梦断蓬窗特地愁，卧闻溪水啮船头。\n夜航又逐东风去，重叹因人此滞留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题许市接待院壁","author":"王之道","text":"一檐冬日送清温，疏竹萧萧覆短垣。\n来就老僧同曝背，不妨危坐默无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题苦竹寺海棠洞三首 其三","author":"王之道","text":"一径封苔知雨足，贰车行县昔时迁。\n对花啜茗思春日，拂拭新诗益怅然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题苦竹寺海棠洞三首 其二","author":"王之道","text":"隔夜西风为办严，扫除氛曀出晴天。\n正逢翠幄张青绮，应念朱唇拂紫绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题苦竹寺海棠洞三首 其一","author":"王之道","text":"翠袖朱唇一笑开，依风无力竞相隈。\n阳城岂是僧家物，端恐齐奴步障来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南巢地藏寺","author":"王之道","text":"蚊觜生花夜更长，睡乡蝴蝶正悠飏。\n山僧不恤秋眠熟，连打钟声到枕旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宿松薤山寺","author":"王之道","text":"小驿隳颓不见容，著鞭东走梵王宫。\n怪禽落日休相恐，五里松篁一径通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题崇因院清轩","author":"王之道","text":"肥松瘦竹古招提，轩槛重游识旧题。\n清意不曾吟得尽，夜来明月浸寒溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题德山涓老无句堂","author":"王之道","text":"峰头示众合如何，一棒由来已自多。\n空去空回还信否，至今疑杀那人诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题德章山","author":"王之道","text":"丛玕泼黛千峰色，急雨奔霆万壑声。\n莫讶祖师来入梦，祇应知我欲山行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题德章山亲公塔","author":"王之道","text":"凭陵风雨上崔嵬，一见亲公病眼开。\n似是前生师弟子，两年今日入山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠林山善相老荣师","author":"王之道","text":"至哉择术妙难论，邂逅何妨丐一言。\n我已无心求富贵，馀生归命给孤园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠桐林老僧","author":"王之道","text":"绕屋青桐碧玉椽，坐来岩石起云烟。\n过门竟日奔驰者，应羡山僧去道边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠浮屠道本二首 其二","author":"王之道","text":"一去禅关忽五春，异乡惊见眼终清。\n问师参学今何解，云在青天水在瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠浮屠道本二首 其一","author":"王之道","text":"暑雨初晴江上村，藕花无数午风温。\n梁山正帖淮南岸，到得精蓝日未昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠道上人","author":"王之道","text":"道人知我过山来，旋扫蓬门对水开。\n惟有温菘荐樽俎，一畦疏绿隐蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠蔡道人","author":"王之道","text":"宝盖山前蔡道人，十年学佛颇安贫。\n似闻亲见天衣老，为改今名作惠新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日阻雨和王冲之韵","author":"王之道","text":"韨除聊复对江亭，樽酒相从一笑倾。\n那得此时仍此乐，况逢难弟与难兄。\n潺潺暮雨檐间溜，滑滑春泥柳外声。\n好在海棠红閤泪，向人悽怆益多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久客和子薳用老杜韵","author":"王之道","text":"舟解风还顺，江神亦世情。\n滞留三月过，攀送一帆轻。\n行止关吾道，穷通任此生。\n梅梢春已动，冰雪漫纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广济道中","author":"王之道","text":"晓日挂林麓，秋风入涧阿。\n野禽飞自语，田父笑相过。\n村疃仓箱富，山蹊芋栗多。\n一鞭聊策蹇，驰上小罗坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋 其一","author":"王之道","text":"静院三更雨，楼台一点风。\n新诗愁恨里，故国梦魂中。\n节物它乡异，交情我辈同。\n眼前多怪事，咄咄强书空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋 其二","author":"王之道","text":"出户喜折屐，江天来翠岑。\n看云忘久立，待月动微吟。\n关塞重回首，简编劳系心。\n琴中有山水，应解遇知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋和彦立兄韵悼伯父仲球","author":"王之道","text":"月华秋气共清圆，千古佳时句一联。\n节物伤心还惙惙，山光经雨自涓涓。\n潢池兵火今方炽，沟壑饥羸正可怜。\n怊怅去年人已矣，乱离谁复问招延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丹阳湖阻风二首 其二","author":"王之道","text":"老去心犹壮，诗成喜欲颠。\n时危思报主，穷极待呼天。\n归梦先湖外，离情到酒边。\n晚来风更恶，舟卧不成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丹阳湖阻风二首 其一","author":"王之道","text":"水阔风还怒，舟轻浪更颠。\n云容初过雨，湖势欲吞天。\n沙觜青枫外，鱼罾白鸟边。\n夕阳应到岸，沉醉酒家眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]