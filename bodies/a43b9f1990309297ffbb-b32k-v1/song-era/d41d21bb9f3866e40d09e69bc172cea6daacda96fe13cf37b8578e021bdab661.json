[{"title":"三韵杂咏七首 其二","author":"李若川","text":"斯人异好恶，是非汩真情。\n鹅有翅莫飞，蛇无足能行。\n世事亦如此，未可一概评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三韵杂咏七首 其一","author":"李若川","text":"础润湿欲雨，月晕知有风。\n大哉天地理，机熟潜可通。\n念彼在世人，心隐无由穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村社歌","author":"李若川","text":"清晓鼕鼕鸣社鼓，前村后村走儿女。\n田家醵钱共赛神，谢神时晴复时雨。\n案有肴酒炉有香，老巫祷祝躬案傍。\n愿得年年被神福，秋宜稻谷春宜桑。\n人淳礼简酒无数，歌笑喧阗日将暮。\n田翁攲侧醉归来，山头明月山前路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊富阳","author":"李若川","text":"弭节富春岸，江潮侵夜生。\n扁舟人未寐，风动菰蒲声。\n群物渐以息，客怀有馀清。\n开篷坐深夜，月在云间明。\n远眺江水阔，仰视天河横。\n念此复何极，旷然千古情。\n恨阻心中侣，浊醪相与倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独酌","author":"李若川","text":"兀坐起往念，新愁忽来侵。\n郁郁不自怡，开尊独盈斟。\n举杯对孤影，浩荡生幽襟。\n百虑遂消散，无复萦我心。\n修篁尔何情，风中来清音。\n不觉日已晏，四面山沈沈。\n超遥醉中适，颓然忘古今。\n染翰记所寓，音属自成吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚕妇词","author":"李若川","text":"舍前舍后桑成林，锄垦不放青草侵。\n东风满条新叶大，村家爱此轻黄金。\n日暖春蚕大眠起，戢戢盈箱齐若指。\n看蚕新妇夜不眠，蚕老登山满家喜。\n阿姑嗔办缲车迟，小姑已催修织机。\n杀鸡沽酒赛神福，今岁不怕寒无衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途中阻雨","author":"李若川","text":"高云无急雨，飞洒如丝轻。\n幽人动羁思，冒雨登归程。\n风来晓烟乱，云破春山明。\n眷言憩荒馆，我怀有馀情。\n壶中载浊酒，饮罢还自倾。\n酒尽兴不尽，关关山鸟鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"理舟","author":"李若川","text":"为客始逾月，迢迢若经年。\n昼永空馆寂，古木参云烟。\n我生闻道浅，未能超世缘。\n念此方寸地，忧来相萦缠。\n今晨动幽兴，沙岸泊归船。\n岸远望不极，归思随长川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳","author":"李若水","text":"小桃脱萼柳梢柔，春色无边破客愁。\n好与永和修故事，一时人物尽风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从赵彦特求茶","author":"李若水","text":"饭馀日影转修廊，攲枕桐花堕小窗。\n为觅春风洗残梦，要令诗思敌澄江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归家","author":"李若水","text":"半载长安客意寒，一鞭归兴旧家山。\n妻孥问我成何事，买得虚名满世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用张济川所举诗韵漫作","author":"李若水","text":"经霜落叶金堆地，过雨奇峰碧满门。\n要识丰年在何处，牧儿横笛下烟村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵马循道春怀","author":"李若水","text":"何郎风味梅花瘦，楚客孤高蕙草芳。\n二子寥寥去人远，一编青竹姓名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵公实兄途中","author":"李若水","text":"断云横碧暗平野，落照曳红明远村。\n回首半天云破处，一眉新月报黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王深之二首 其二","author":"李若水","text":"酒薄仅能浮颊赤，灯寒故意学山青。\n新来鼻观无遮碍，觉得功名一味腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王深之二首 其一","author":"李若水","text":"事纵未涯心已老，山虽许远梦能归。\n团蒲稳坐亦不恶，扪虱工夫趁早晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋周臣留别","author":"李若水","text":"行旌此去隔关山，顿觉幽斋笑语阑。\n后夜月明空似水，孤桐横膝向谁弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张济川二首 其二","author":"李若水","text":"父老沾襟讼不平，千岩鬼哭乱泉声。\n乌鸢误饱忠义肉，点检战功谁眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张济川二首 其一","author":"李若水","text":"涧底战骸霜雪枯，笼烟万瓦半荒墟。\n流离赤子马前泣，争问九重知也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵倪巨济春怀 其二","author":"李若水","text":"近郭一廛殊未涯，不堪眼底又春华。\n宦游趁食负惭色，大似田头拾粒鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵倪巨济春怀 其一","author":"李若水","text":"青衫一领缚闲身，饱识官街肥马尘。\n昨日友生双鲤至，怪人不忆故溪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高子文","author":"李若水","text":"归计茫然殊未涯，倦游日久似无家。\n十年灯火有何效，赢得眼前生眩花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舒伯源雪晴偶书四首 其四","author":"李若水","text":"银涛万顷涨烟村，寂历茅檐上晓暾。\n春傲馀寒邀不住，夜来偷入杏花园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舒伯源雪晴偶书四首 其三","author":"李若水","text":"雪意融融旋作泥，故山应是费攀跻。\n而今把笏谢樵子，马踏御街闻晓鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舒伯源雪晴偶书四首 其二","author":"李若水","text":"化工错玉满京都，尚有痴云似积酥。\n马上官人冻颜赤，拥炉还羡老生无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舒伯源雪晴偶书四首 其一","author":"李若水","text":"朝阳飞影战馀寒，楼上高人久屈蟠。\n想见倚栏三盏后，醉横诗眼与天宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百井寨次高子文留题原韵","author":"李若水","text":"破篱残屋是谁家，一片斜阳万点鸦。\n驻马冈头无处问，漙漙清露湿黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西游","author":"李若水","text":"绿暗红疏春事休，此身孑孑又西游。\n不堪回首斜阳外，一片黄云万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"李若水","text":"暮凉浮座暑光微，竹底风来暗举衣。\n假寐不知清夜久，挂檐星斗向人稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日郊外 其一","author":"李若水","text":"毵毵官柳绿藏鸦，傍郭人烟三五家。\n见说今年寒食好，踏青归路看梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日郊外 其二","author":"李若水","text":"谁家临水亚朱扉，楼外风闲柳线垂。\n昨夜濛濛春雨小，杏花开到背阴枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日途中","author":"李若水","text":"一川晴日破春容，柳絮桃红赴望中。\n莫喜芳辰又来到，少年能耐几东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书斋","author":"李若水","text":"昼闲人静睡相寻，幽鸟时时荐好音。\n唤起新秋一襟恨，南窗摇膝费孤吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李无陂还乡","author":"李若水","text":"休辞十驿犯埃尘，花柳无边政可人。\n我坐宦囚归未得，仗君说与古溪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁冠道士寄书","author":"李若水","text":"金甲将军传好梦，铁冠道士寄新书。\n我与云长隔异代，翻疑此事太荒虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后二首 其二","author":"李若水","text":"玉霙著砌晓斑斑，天惜丰年特地悭。\n爽气一屏山倚碧，冷光千叠水回环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后二首 其一","author":"李若水","text":"黄沙苦染鬓毛斑，乞得琼瑰一寸悭。\n径欲南楼试鹤氅，拍天清气月如环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登敛翠亭","author":"李若水","text":"伫立危亭醉眼宽，无边秋色夕阳间。\n牧儿腰笛挽牛去，却放半川云水闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡觉","author":"李若水","text":"布衾纸帐饯残冬，老眼俄惊晓日红。\n好梦追寻忘首尾，但闻窗外竹摇风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中偶题","author":"李若水","text":"小人拙直颇近真，放论动取儿曹嗔。\n何似饮醇浇舌本，醉来卧唱江南春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题观城驿壁","author":"李若水","text":"半篙寒碧秋垂钓，一笛疏风夜倚楼。\n多少巫山旧家事，老来分付与东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画扇","author":"李若水","text":"坡头霜木秋半老，沙际水禽时一双。\n乞我短篷归去好，醉听夜雨卧荒江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵进夫胜轩诗","author":"李若水","text":"山色堆蓝重，水光拖练寒。\n主人看不足，终日凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵司空彦修送行","author":"李若水","text":"仆夫已饭车已巾，再拜别君愁始新。\n一事未成双鬓秃，百年能几半生贫。\n云山不断骎骎暮，花柳无边在在春。\n它日还家稍安稳，杖藜相过莫嫌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与沈信翁对饮忆雍节夫高子文","author":"李若水","text":"北门昔日吾三友，今日樽前得一人。\n雍老滑稽垂白首，高郎文雅最青春。\n一飞小篆追秦相，两吐新诗近楚臣。\n落落星辰各千里，请君休说恐伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与诸公游葆真宫","author":"李若水","text":"晏坐芸堂情太幽，仙家有地供闲游。\n冷官经月未尝醉，好景向人那得愁。\n宫殿风清鹤翅冷，池塘水白荷花秋。\n尊前不乐定痴煞，明日簿书堆案头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太行道中","author":"李若水","text":"千山倚奇峭，十日寄登临。\n宇宙蜂房小，功名虎穴深。\n诗多马上得，家只梦中寻。\n头白双亲健，飘零寸草心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张济川夜雪二首 其二","author":"李若水","text":"天公应恐点琼葩，先遣飞廉卷恶沙。\n才短谬将身许国，岁寒还是客成家。\n故乡亲友驰清梦，老境文书眩碧花。\n须信玉妃仪卫肃，砌蛩庭鹊静无哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张济川夜雪二首 其一","author":"李若水","text":"雪彩鳞鳞照夜徂，化工游戏剪轻酥。\n竹声摇破梦千里，蓬迹转来天一隅。\n寒压短檠花自落，风惊别浦雁相呼。\n平明携杖前溪去，误入仙人白玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张济川雪","author":"李若水","text":"云将剪水戏微茫，草木非春也自芳。\n坐上落来千片急，鬓间添得数丝长。\n气淩诗骨笺毫健，味借茶瓯齿颊香。\n久客天涯衣缝断，梦魂合眼到亲旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李子建怀归","author":"李若水","text":"寸心已老自宜休，误别云山岁几周。\n疏远骤依双凤阙，清贫仅剩一貂裘。\n与人不偶缘方凿，于世无求类直钩。\n何日张帆旋故国，坐呼明月醉江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李元量见赠","author":"李若水","text":"先生学业自无双，当代闻人共叹降。\n文采羡君高楚梦，诗声笑我类吴江。\n槐花过雨金堆砌，山色经秋碧满窗。\n一幅珠玑照尘眼，龙文端信笔能扛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李嗣表夜坐","author":"李若水","text":"霜梧一叶落，尘鬓几茎秋。\n夜久灯仍暗，人閒室自幽。\n文书遮眼具，仕宦活身谋。\n此话有谁领，寸心横百忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵倪巨济诗换怪石","author":"李若水","text":"纷纷儿辈只轻肥，不爱笼烟小黛眉。\n唯有幽人负高韵，为怜奇物直新诗。\n尘埃不染溪山梦，冠盖政妨麋鹿姿。\n何日茅檐列千嶂，倚藜细看碧参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高子文村居","author":"李若水","text":"幽人厌城市，结屋近松萝。\n一笛秋风急，千岩晚照多。\n竹根邻叟醉，牛背牧儿歌。\n笑杀青云友，朝绅换短蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高子文秋尽怀归","author":"李若水","text":"把酒送秋去，此怀难具陈。\n十年江海梦，一几簿书尘。\n自叹栖栖者，谁怜落落人。\n渊明归思切，篱菊带霜新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高子文留别","author":"李若水","text":"之子欲西笑，我怀难具陈。\n从来妙风雅，此去脱埃尘。\n拟倩杯中物，暂留灯下人。\n可堪分手处，月色半林新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵高子文途中见寄","author":"李若水","text":"人生半在客途中，休著狂踪比断蓬。\n别后梦烦庄叟蝶，迩来书误子卿鸿。\n月同千里水云隔，天各一涯谈笑空。\n趁取重阳复诗社，要看红叶醉西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别向德深","author":"李若水","text":"岁晚霜风劲，束装千里行。\n别离交义重，老大宦情轻。\n歧路共人远，关山空月明。\n旗亭有浊酒，挥泪与君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎亲途中","author":"李若水","text":"久伫白云下，兹晨慰所思。\n一鞭游宦处，三釜及亲时。\n宿雨开蔬甲，薰风卧麦旗。\n马头浮喜色，已被鹊先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉使太原途中呈王坦翁副使 其一","author":"李若水","text":"中山忠义定何人，数月相从笑语真。\n未信功名孤壮志，不妨诗酒寄闲身。\n此来饱看千岩秀，归去遥知两鬓新。\n就使牧羊吾不恨，汉旄零落落花春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀 其三","author":"李若水","text":"破扇委高壁，病骨苏微凉。\n罗阶竹千挺，秀质颀而长。\n呼奴约疏箔，窗几延翠光。\n欠伸睡稍足，夕影上东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀","author":"李若水","text":"满眼羁愁不可裁，西风楼阁独持杯。\n一檠短梦寻家去，万瓦新霜逐雁来。\n富贵未涯身半老，云山何处首空回。\n呼儿涤砚酬佳句，试我胸中隐隐雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种荔枝核有感","author":"李若水","text":"荔子欲传种，他年养老饕。\n试将千颗植，已喜寸萌高。\n岂耐雪霜苦，空惭浇灌劳。\n何殊茂陵客，藏核种蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送行","author":"李若水","text":"去意浮长汴，离怀咏晓灯。\n明时非不遇，幽黜坐无能。\n岁月惊双鬓，林泉许曲肱。\n从今藏羽翼，敢复觊飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何文植趋京","author":"李若水","text":"问君何日赴神京，明日扬鞭数去程。\n风雪一天行客恨，关山千里故人情。\n铜台曾见三都赋，金阙行传二陆名。\n自许孤高谢凡客，从今有酒对谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宋周臣赴殿试","author":"李若水","text":"近侍传呼到集英，参差宫殿晓霞明。\n丹墀日对三千字，云翼风高九万程。\n天子临轩应动色，诸生阁笔总销声。\n胪传指日承新渥，千佛名经第姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦会之题绝尘亭","author":"李若水","text":"脱迹尘嚣外，悠然寄此亭。\n池平一鉴净，山远数螺青。\n身世惊残梦，行藏忌独醒。\n惟闲即近道，不必玩丹经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途中","author":"李若水","text":"马足疲长路，林端霁色开。\n客程经十驿，村酒只三杯。\n病叶迎秋落，疏云送雨回。\n何当旋故里，趁日坐墙隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"李若水","text":"自怜畴昔抱痴顽，不惯黄埃日跨鞍。\n荒径露沾旗尾润，幽窗尘锁笔头乾。\n半林残照人烟晚，一笛秋风雁影寒。\n还有田园得归去，谁能俯首缚微官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄宋周臣","author":"李若水","text":"盍簪当日话殷勤，便著金兰较此心。\n相去不堪千里远，别来何况一年深。\n江山有路通幽梦，鱼雁无情断好音。\n管鲍贫交君记否，少陵曾为发悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]