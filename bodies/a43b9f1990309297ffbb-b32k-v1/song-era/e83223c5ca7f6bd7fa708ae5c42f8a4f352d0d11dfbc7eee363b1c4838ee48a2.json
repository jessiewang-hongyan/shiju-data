[{"title":"十一日同诸友登南台二绝 其二","author":"陈文蔚","text":"脚底云山叠叠低，面前一带绕清溪。\n秋光总可供吟笔，写作登高第一题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月十四夜诵康节诗至忆弟三首潸然有感","author":"陈文蔚","text":"人生虽是有愚贤，到底天伦只一般。\n惆怅同安何处所，不堪岁暮更天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月望后同徐子融黄子功送先生归闽是夕宿分水岭头遇雪次早别先生二兄北归约联诗不成自赋一绝","author":"陈文蔚","text":"先生风节本高寒，千仞峰头雪正漫。\n一夕诸生聆妙论，时人莫作剡溪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月廿三日举故事访黄冈梅","author":"陈文蔚","text":"岁披草棘访槎牙，为爱凌霜傲雪花。\n不学春花娇女面，朱帘翠幕几重遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月三夜省愆二绝 其一","author":"陈文蔚","text":"亲为父子须还爱，分属君臣合用钦。\n细算天心无负我，我生犹有负天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月三夜省愆二绝 其二","author":"陈文蔚","text":"孔子九思频点检，曾参三省重绸缪。\n事来若也能思省，事过何因有悔尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铅山县石井院","author":"洪炎","text":"两年再踏铅山路，今日初尝石井泉。\n碧玉岩边瀹汤饼，全胜五鼎击肥鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和载酒过竹涧韵","author":"陈文蔚","text":"名园一水绿潆洄，消得风流太守来。\n把酒哦诗真不恶，此时怀抱十分开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和清明日兀坐用前韵","author":"陈文蔚","text":"天理流行不用寻，鸢飞鱼跃自升沉。\n细观自有昭然处，始信严师是此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月八日晚步溪上二绝 其一","author":"陈文蔚","text":"绿杨芳草两边洲，不碍晴川日夜流。\n我到忘机每终日，为谁飞去怪沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月八日晚步溪上二绝 其二","author":"陈文蔚","text":"画笔难描蘋渚意，诗情难状柳堤风。\n若令妙处人皆会，甘把渔竿伴钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月望访徐子颜","author":"陈文蔚","text":"近有平林远有山，先生无日不开颜。\n杜门有味心千古，何用浮名落世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子京又以长篇告别值予欲出一绝谢之","author":"陈文蔚","text":"二年不作上方游，一日重寻旧话头。\n却恨婵娟成两处，清尊无分共中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子融和答三首再用韵赋一绝以谢","author":"陈文蔚","text":"登楼触目皆诗料，难写风烟尽笔端。\n不但绿阴晴后好，亦便山色雨中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书窗碧桃","author":"陈文蔚","text":"铜瓶只插碧桃花，日对幽人静不哗。\n为尔细观冰雪艳，就中便觉牡丹夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予酷爱桂香置两枝于萧寺之寓室日出不得对花夜归月影在窗撒灯清坐为赋二十八字","author":"陈文蔚","text":"惜香故剪碧云枝，却负花香花有辞。\n为辍清眠陪永夜，月窗相对恰相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以寿山石绦环寄赵昌甫将以廿八字","author":"陈文蔚","text":"连城价重虽非玉，千古名存寿此山。\n野服閒居颇相称，无端因得玩如环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公美约同游龙安寺僧留小饮归途一绝","author":"陈文蔚","text":"几年无便到招提，沙路徐行趁碧溪。\n花竹禅房成小款，笑谈不觉到斜西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十七夜待月","author":"陈文蔚","text":"凝伫虚亭未惬心，清光隐隐隔疏林。\n欲观玉鉴呈全体，独倚朱栏到夜深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十四夜独坐无喧阁","author":"陈文蔚","text":"凭栏无事此时情，一阕欣闻欸乃声。\n归去夜阑谁管领，付他风月自清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬午三月廿三日偕诸生携酒过公美家公美宅前山花烂开极可爱为赋一绝","author":"陈文蔚","text":"青春深处每徘徊，为爱花城锦绣堆。\n谁似君家奇绝处，坐迎春色入门来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天王寺佛塔灯隔林见之奇绝因成口占","author":"陈文蔚","text":"上元灯火九衢中，何似金莲下半空。\n要识隔林奇绝处，星毬带叶荔枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜观花","author":"陈文蔚","text":"底事更深睡不感，惜花爱月两关情。\n黑甜一枕虽云美，未省人间有此清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"火田郑次山贫士也家有燕坐之处五为赋之 槁木寮","author":"陈文蔚","text":"夜半一阳动，万木总皆春。\n当观向荣意，从此识吾仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见梅","author":"陈文蔚","text":"晓鸡残月更离程，只见梅花不忍行。\n水郭山村谁是伴，惟