[{"title":"挽周晋仙二首 其二","author":"苏泂","text":"雪跨冰悬句尽珍，生前已自外其身。\n重来不见长安道，犹恐虚空遇若人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周晋仙二首 其一","author":"苏泂","text":"酷爱金陵二百诗，自痴那得使人痴。\n草堂寂寞荆公死，泉下相逢试质疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效张文潜雪体 其二","author":"苏泂","text":"楼高谁上最高层，独客思家见祇憎。\n半夜樵归逢说虎，隔溪罾罢约留灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效张文潜雪体 其一","author":"苏泂","text":"布衾如铁衣生角，学道终宵免醉昏。\n儿女呻吟惟有睡，老人独自起开门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花 其一","author":"苏泂","text":"手种秋风碧玉成，花开如粟水沉惊。\n人间商略年年事，到底其如一字清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花 其三","author":"苏泂","text":"远于沉水淡于云，一段秋清孰可分。\n毕竟素娥留不得，人间天上一时闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花 其四","author":"苏泂","text":"东西南北日团圆，洗涤肝膺立树边。\n料得痴蟾别有药，只餐金粟径升天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花下","author":"苏泂","text":"羽服悬知澹不妍，五更清吹月明前。\n明朝多少尘劳事，自倚虚檐一怅然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣花溪","author":"苏泂","text":"抱郭清溪一带流，浣花溪水水西头。\n重来杜老谁相识，沙上凫雏水上鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠花放简冯元咨二首 其二","author":"苏泂","text":"坡仙不作黄州去，更把嫣红向阿谁。\n后夜秦庄照华烛，几时冯圃折高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠花放简冯元咨二首 其一","author":"苏泂","text":"游丝无赖小庭空，梦想君家合树红。\n曾向西川亲画得，举家终日看屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"爱九兄旧句","author":"苏泂","text":"眼看绿樽花下去，情知清话竹边留。\n禊觞岂是荒耽具，晋士那无经济谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耕堂弟妇生日 其二","author":"苏泂","text":"了却蚕缫备雪天，耰锄只在屋头边。\n青筇绿蚁相扶醉，妇馌夫耕过百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耕堂弟妇生日 其一","author":"苏泂","text":"偕老杯盘最喜欢，酒中纯渌浸南山。\n莺莺解作娇娥唱，窗外垂杨是小蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"苏泂","text":"荷花宫样美人妆，荷叶临风翠作裳。\n昨夜夜凉凉似水，羡渠宛在水中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱塘渡","author":"苏泂","text":"百年鬓发春风晚，十二阑干落照微。\n多事钱塘江上水，送人离别送人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高兄示夫妇观月诗和韵","author":"苏泂","text":"德耀梁鸿两不凡，闺中桂影醉同看。\n却怜当夜鄜州月，空咏清辉玉臂寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄内","author":"苏泂","text":"瓮头留得菊花春，过了重阳即诞辰。\n想见闺中为寿酒，只同儿女说归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄白石姜尧章","author":"苏泂","text":"稽山却棹酒船回，泠水湾头两意开。\n一路有诗吟不稳，当时悔不共君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄尧章","author":"苏泂","text":"闻似磻溪隐姓名，阿鬟仍是许飞琼。\n凉风昨夜惊新雁，想见吹箫又月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄尧章并简铦老","author":"苏泂","text":"山绕楼台水接天，袈裟同上闇门船。\n相思一夜梅花落，傥有人来寄短篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李简夫宫使五首 其五","author":"苏泂","text":"节第茫茫逝水如，髯朱宁复与之俱。\n绝怜老子经行地，一笑知心更有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李简夫宫使五首 其四","author":"苏泂","text":"扁舟来往雪模糊，一句当头道得无。\n不是诗人磨不死，欲将身凑剡川图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李简夫宫使五首 其三","author":"苏泂","text":"觅得骊龙颔下珠，几年参请遍江湖。\n只今同味仍同病，惟有亲朋李简夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李简夫宫使五首 其二","author":"苏泂","text":"嘉言深味道之腴，启钥抽关许自如。\n顾我但将行脚误，输君全得病工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李简夫宫使五首 其一","author":"苏泂","text":"归来手接一封书，累幅春冰字字珠。\n便欲篮舆从此去，好风吹过烛溪湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼杨梅","author":"苏泂","text":"凡物从来遇合难，烂甜中故有微酸。\n自怜生晚空同姓，不得杨妃带笑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"接齐叟总干兄榇","author":"苏泂","text":"人生何者遽宜休，如此诗书未白头。\n舍棹灯明烟雨里，居人那识在原愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨起 其一","author":"苏泂","text":"晓鸡将梦出华胥，起看新霜积槁梧。\n迟顷日高霜作水，可怜黄叶半边无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨起 其二","author":"苏泂","text":"攲枕邯郸梦忽残，黄紬被稳日三竿。\n起来门外霜如雪，始信人间有夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹娥","author":"苏泂","text":"游子心情岁暮时，画船来往几欢悲。\n夫人祠下寒潮水，自展醪牲读蔡碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望前山雪寄叶山人","author":"苏泂","text":"烟云出没微微白，知道前山雪也来。\n应在山中望城郭，烂银宫阙是蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望秦山残雪","author":"苏泂","text":"山脚斓斑日到迟，清连秦树夜猿悲。\n因思上古英雄帝，不见苍苍白白时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"苏泂","text":"清贞表独立，半蕊便风流。\n信有魁天下，群芳未转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅雨 其三","author":"苏泂","text":"双飞蛱蝶情何厚，百啭仓庚韵可听。\n肯为螳螂看黄鹤，忍从燕子乞蜻蜓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅雨 其二","author":"苏泂","text":"篱根日日系扁舟，衣桁才乾水又流。\n老子病馀凡事懒，但薰沉炷瀹茶瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅雨 其一","author":"苏泂","text":"江南四月苦风波，细雨天寒柰若何。\n梅子之黄如弹子，菘窠其白柰花窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中作","author":"苏泂","text":"青灯一盏照青编，月色霜华两皓然。\n交友岁寒何所忆，水仙王庙竹林边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦卢子高","author":"苏泂","text":"魂梦依稀欲见君，须臾为月又为云。\n起来接得如鸦字，谈笑声音了不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦句","author":"苏泂","text":"元日新春又一年，剡溪仍是旧山川。\n白头野叟无时事，独自寻僧雪满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦尧章桂花下","author":"苏泂","text":"扑鼻清香两绝诗，分明参到小山辞。\n如今独自秋风下，不似当初并马时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦退堂师","author":"苏泂","text":"碧眼霜颅事已非，梦中相见祇攒眉。\n推敲有法犹分付，一似高丽寺里时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦游","author":"苏泂","text":"殿前入醉索催茶，玉女传宣赋綵霞。\n谁道尘缘犹未断，碧桃花下却思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦游海山二首 其二","author":"苏泂","text":"绀幰行空半簇花，太真扶辔极夭斜。\n一声何处宁王笛，吹入春风百万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦游海山二首 其一","author":"苏泂","text":"海山青碧一千重，楼观飞霞朵朵峰。\n薄晚维舟浑不得，飘残女乐趁天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"苏泂","text":"渔翁年几雪垂肩，钓罢归来月一船。\n明日酒醒寻伴侣，卖鱼依旧禹祠前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"续旧句","author":"苏泂","text":"人人不识句中眼，请问吾家岩壑翁。\n只把荒耽讥晋士，那知经济在其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿阴 其一","author":"苏泂","text":"绿树阴中石枕头，功成不愿割鸿沟。\n君看上蔡牵黄犬，悔杀人间万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿阴 其二","author":"苏泂","text":"佳木丰交午荫稠，门阑青草没阶头。\n道人洗净筝琶耳，睡起一声黄栗留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿萼梅 其二","author":"苏泂","text":"水仙分御六铢衣，云作中单翠作蕤。\n占断芳园无两树，月明倒影浸愁漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿萼梅 其一","author":"苏泂","text":"弃得丹成卸羽衣，更餐日彩弄晨曦。\n九疑魂断归无计，自倚湘筠醉几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野兴","author":"苏泂","text":"蚕绩桑空又一年，村姑携手看花园。\n冬来保得儿孙暖，自解麻裙当酒尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野航","author":"苏泂","text":"山青水绿思悠悠，几处滩头复渡头。\n任是无人竞来往，不妨终日自横舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野望","author":"苏泂","text":"盈盈一水宛秋蛇，鸡犬无声野客家。\n雨后绿添沿径草，风回红谢隔墙花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒鸦诗","author":"苏泂","text":"点点飞来绕水村，不缘街鼓识黄昏。\n当年口腹成疏弃，却保生全反哺恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"提举刘学士以某论守江之策未行作诗见遗谨次 其二","author":"苏泂","text":"自是群公气未平，黠羌何虑不休兵。\n欲成江左收贤俊，叹息无人致二生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"提举刘学士以某论守江之策未行作诗见遗谨次 其一","author":"苏泂","text":"福胎当日起燕然，始信兴亡不属天。\n谋国自知无秘计，何时归把牧羊鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游天意寺","author":"苏泂","text":"午后钟鸣鹳鹤飞，日高岚气湿人衣。\n回头但见青松树，不信城中有是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴台","author":"苏泂","text":"朱弦牢落更谁闻，青草台高鹤唳云。\n尚有茂陵多病后，眼前相对卓文君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琼花","author":"苏泂","text":"一树婆娑种月华，夜阑依旧护风沙。\n今年不往扬州过，曾看夫人庙里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼","author":"苏泂","text":"越客西来隐姓名，扁舟浩荡逐江行。\n岳阳楼上三更后，自倚栏干看月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼","author":"苏泂","text":"秋林薄薄半栖鸦，城脚荷花一带斜。\n碧色暮云三万里，不知鱼网是谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葛仙钓石","author":"苏泂","text":"天上丹成鹤上飞，溪边留得钓渔矶。\n千年二谢风流尽，谁复行吟送落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢月林寄诗次韵","author":"苏泂","text":"重入都门又许时，旧巢新燕欲何之。\n清风忽送苕溪便，满纸云烟七字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道上梅","author":"苏泂","text":"栗棘蓬边父老家，不知来历便横斜。\n思量却是无心种，逢著春风偶自花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感旧","author":"苏泂","text":"小箱留得旧裳衣，母氏亲缝衣此儿。\n近日著来浑短窄，猛思泉下许多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感时","author":"苏泂","text":"欲寻春物了无凭，留得黄鹂一两声。\n昨夜荷风清溽暑，岸头还有小虫鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滟滪堆","author":"苏泂","text":"滟滪堆头一叶舟，半年人共水东流。\n平生快意才如此，不数东南数十州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简刘武子","author":"苏泂","text":"落拓刘郎醉未醒，少年名字以诗行。\n流传谩有南朝体，萧寺如今白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简赵世卿","author":"苏泂","text":"舍弟归承折简来，知君琴剑返天台。\n人生百岁都能几，两度经过见一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赖婆桥诗","author":"苏泂","text":"赖婆桥下粼粼水，几见居人说废兴。\n自笑年来车马迹，得如桥畔白头僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣心四首 其四","author":"苏泂","text":"租田已旱仍遭水，饱饭明年岁月长。\n未见桂花先一笑，满山金粟拟为粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣心四首 其三","author":"苏泂","text":"西风飒飒动蒿莱，江上芦花似雪开。\n甚喜茅斋清睡熟，却忧边面有尘来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣心四首 其二","author":"苏泂","text":"眼看飞蝗乱似蚊，伤禾害稼不堪闻。\n人言所在如飞雨，恐是淮南懒战军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣心四首 其一","author":"苏泂","text":"秋旸如火灼肌肤，世念功名一点无。\n晚洞龙归带飞雨，卧看檐溜落阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣兴","author":"苏泂","text":"曲径萦纡入翠林，无人风自落来禽。\n山中不记今为晋，一刻清闲直万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午日宫宴二首 其二","author":"苏泂","text":"香萱夹和宜男草，高下山栀安石榴。\n一样薰风分五色，蜀葵林畔按凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午日宫宴二首 其一","author":"苏泂","text":"仙装宫样一群群，花外花间蔼若云。\n羞涩葵榴无举止，尽倾颜色向南薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题三高亭","author":"苏泂","text":"千顷飞花特地寒，又随渔艇泊苍湾。\n三高问讯来何巧，趁得冰湖看雪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题千秋观","author":"苏泂","text":"不见风流贺季真，酒船回棹莫逡巡。\n如今湖上千秋观，逢著黄冠亦可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]