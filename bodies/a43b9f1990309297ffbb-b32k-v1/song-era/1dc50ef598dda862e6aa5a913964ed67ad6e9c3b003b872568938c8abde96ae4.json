[{"title":"次韵张守酴醾二首 其一","author":"刘子翚","text":"荣华休羡黑头公，且对芳辰赏丽丛。\n十万青条寒挂雨，三千粉面笑临风。\n莫将拟雪才情赋，盍与观梅兴味同。\n只恐春归有遗恨，典刑犹在浊醪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈成季郡会","author":"刘子翚","text":"疾雨狂风恨若何，芳晨坐觉等闲过。\n惜花意欲春长在，对酒年来饮不多。\n雅会欣闻珠履集，新词好付雪儿歌。\n风流阁老推前辈，喜客温颜似醉酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲游北岩","author":"刘子翚","text":"云岩藏胜绝，何路不潜通。\n信步迷时远，冥心乐处同。\n乱松风索索，悬瀑雨濛濛。\n陶谢多清兴，招邀有远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲赠六四叔之作","author":"刘子翚","text":"平生一笑轻离别，林下相从各壮年。\n绝爱步兵胸垒块，更欣阿大语蝉连。\n杖藜只作寻常出，卮酒何辞一再传。\n燕颔虎头经赏识，定应接武向甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林吉甫游天宫","author":"刘子翚","text":"闻说星郎隐翠峰，鹓鸾回首大明宫。\n倦游壮岁抛朝绂，归梦清江忆钓筒。\n贤圣相期黄卷里，是非都付浊醪中。\n更闻莲社多幽侣，我欲时来问苦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵茂元茉莉花诗二首 其二","author":"刘子翚","text":"三尺婆娑树，千英一律妆。\n眼孤犹眩彩，鼻熟不知香。\n向月资清润，承风发素凉。\n众芳如不忌，移植近潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵茂元茉莉花诗二首 其一","author":"刘子翚","text":"翠叶光如沃，冰葩淡不妆。\n一番秋早秀，彻日坐傍香。\n色照祇园静，清回瘴海凉。\n傥堪纫作佩，老子欲浮湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵栀坑七言","author":"刘子翚","text":"酒香浑若过新丰，心事悠悠冷笑中。\n彻夜道傍栀叶雨，几年马上桂枝风。\n高情未许愁能挽，归意惟应梦可通。\n准拟今秋剩追逐，暗泉锵佩月潭东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵清献阴字诗","author":"刘子翚","text":"石磴云房隐涧阴，昔年清献此清吟。\n凤池人物终难继，花县风流直到今。\n三尺翠碑遗墨在，一林寒竹暮烟深。\n平生景仰高名久，敢负它时直爱心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵原仲竹","author":"刘子翚","text":"夕烟浮野圃，春竹过邻墙。\n石涧深深影，风轩远远凉。\n禅心敲有韵，翠袖倚生香。\n不有冰霜劲，蒿莱到汝长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵温其元日诗","author":"刘子翚","text":"晓来飞雨挟风颠，洗出韶容换故年。\n花动一红明屋角，山寒乱碧到樽前。\n病如夜鹤孤还警，老似春蚕饱即眠。\n赖有故人开寂寞，锦囊诗句许时传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵温其种竹诗","author":"刘子翚","text":"种竹应须我辈人，茅檐对此可忘贫。\n攲风带雨看无厌，淡夜寒绡画不真。\n青女侵凌馀瘦节，箨龙盘屈更分身。\n会裁一管招鸣凤，千亩何须羡渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵温其雪","author":"刘子翚","text":"侵凌腊尾近春前，冻色冥冥不见天。\n一洗氛埃终自洁，暗催花柳为谁妍。\n单衣窭巷无朝爨，垂箔高门有醉眠。\n闻道江头消息好，玉旌瑶帜满楼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵新乡诸公雪诗二首 其二","author":"刘子翚","text":"贪行璀璨意无寒，不管飞花著鬓斑。\n一段清光贻老境，十年胜览在家山。\n遥知物外徜徉乐，肯放毫端造化閒。\n寸铁不携当百战，欲申前令愧辞艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵新乡诸公雪诗二首 其一","author":"刘子翚","text":"腊里天公未得閒，重阴先殿晚来寒。\n数丝绰约流空际，一陈缤纷糁夜阑。\n已傍馀光窥蠹简，更消清液试龙团。\n杜门自觉心神瑩，老去追随只强欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵熊叔雅七言","author":"刘子翚","text":"只今漂荡贾长沙，来往三山蹑纬霞。\n马上新诗犹忆友，枕边幽梦不离家。\n风惊枯苇连汀雨，霜著寒枫满树花。\n却记梁园初识面，干戈岂料落天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日","author":"刘子翚","text":"客中双鬓老尘埃，海角仍逢至日来。\n近腊风光初染荔，新阳气力仅浮灰。\n豆糜厌胜怜荆俗，云物书祥忆鲁台。\n搔首故园心欲断，少陵赖有掌中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中寄似表","author":"刘子翚","text":"溪流元自急，积雨更兼旬。\n曲渚方移棹，高城忽背人。\n艰难争避地，去住不由身。\n客食怜诗李，相期一问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访士特举和六四叔诗因次韵","author":"刘子翚","text":"闻道归舟泊浅沙，篮舆出郭日初斜。\n新传赋咏来梁苑，旧识芝兰向谢家。\n遣兴只凭樽有酒，感时愁见树飞花。\n相逢未款还相别，回首长亭鬓欲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访原仲","author":"刘子翚","text":"布衣自昔有遗才，白首穷经隐涧隈。\n门掩青山朝暮色，客来浊酒两三杯。\n鸿冥岂复惊尘网，鹗荐虚闻达帝台。\n我亦放情依一壑，云间杖屦喜相陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访原仲山居","author":"刘子翚","text":"寂寂临湖屋，湖风为掩门。\n鸟声幽谷树，山影夕阳村。\n好事长留客，虽贫亦置樽。\n平生枯淡意，去此欲谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过丹峰庵","author":"刘子翚","text":"杖策到丹峰，开轩对绿丛。\n禅心清似水，客鬓乱如蓬。\n鼓角谯门日，莺花上巳风。\n逢人相借问，何地隐庞翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过天竺寺","author":"刘子翚","text":"一径联镳去，身疑在画图。\n林阴穿欲尽，山霭近还无。\n下榻聊盘礴，裁诗屡嗫嚅。\n道人留客意，片月出云孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过东阳","author":"刘子翚","text":"小箔鸣机几万家，时清犹想旧繁华。\n楼台夜映双溪月，箫鼓春迷后坂花。\n回首十年真梦寐，停骖四顾但风沙。\n却过萧寺无人语，独对枯林数暝鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过邺中","author":"刘子翚","text":"逐鹿营营一梦惊，事随流水去无声。\n黄沙日傍荒台落，绿树人穿废苑行。\n遗恨分香怜晚节，胜游飞盖想高情。\n我来不暇论兴废，一点西山入眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过致思新斋","author":"刘子翚","text":"酷爱鹅溪水，潺潺傍马流。\n落梅寒崦静，啼鸟暮村幽。\n我病今朝已，君家有酒不。\n新斋最奇绝，犹得少淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问明仲游武夷日","author":"刘子翚","text":"兀兀听凉雨，开门雪涨川。\n独行枫叶底，秋兴雁行边。\n老去无多事，閒知有胜缘。\n何时纵仙舸，我亦愿周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯胜文本袖诗见访辄成长句奉酬盛意","author":"刘子翚","text":"懒逐交游户昼扃，客来曳履亦逢迎。\n旧知吾里多豪隽，亲识君家好弟兄。\n瓜芋满畦聊卒岁，琴书一榻寄平生。\n骅骝历块终千里，俗眼悠悠未可轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴公路作功德院记成同居安入山书丹","author":"刘子翚","text":"净坊疏宠自吾君，盍有丰碑载策勋。\n方见隳崖砻翠琰，忽惊落笔散彤云。\n言言未索西山气