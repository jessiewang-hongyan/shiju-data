164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李丞相挽诗三首 其一","author":"刘子翚","text":"委质艰难际，精忠日月昭。\n引裾尧浸缩，断鞅虏氛消。\n顾眄安诸夏，风声动一朝。\n南迁谁辨谤，公论付刍荛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李似表见访","author":"刘子翚","text":"石磴荆藩隐薜萝，岂知迢递枉鸣珂。\n交游奈久如君少，邂逅成欢此夕多。\n千斛敢求身后传，一樽聊和饮中歌。\n云鹏欲举那留得，南浦伤心又绿波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杖藜","author":"刘子翚","text":"乱后惟忧死，无心问岁华。\n故园依草莽，今日见梅花。\n闽俗尝三饭，僧房但一茶。\n海濒犹未稳，更拟访仙槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花椒","author":"刘子翚","text":"欣忻笑口向西风，喷出元珠颗颗同。\n采处倒含秋露白，晒时娇映夕阳红。\n调浆美著骚经上，涂壁香凝汉殿中。\n鼎餗也应知此味，莫教姜桂独成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周元仲将出山有愁别园林后夜春之句因作此诗留之","author":"刘子翚","text":"山馆春来特地幽，岸巾何日不同游。\n花随石壁高低发，水绕茅檐左右流。\n叵我三杯真性适，咍台一枕万缘休。\n山中乐事端如许，为底周郎不肯留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特南浦诗","author":"刘子翚","text":"羽檄分兵控上流，时传烽火过邻州。\n楼船半渡旌旗晓，胡马欲来江汉秋。\n淝水投鞭真浪语，幄中借箸有奇谋。\n吾儒雅有康时意，不把诗轻万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李巽伯","author":"刘子翚","text":"浦树冥茫茫，云山浅淡中。\n客愁生远望，春意入晴空。\n酒忆相如病，途怜阮籍穷。\n慇勤桃叶句，欲和愧难工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐从道韵二首 其二","author":"刘子翚","text":"拂袖归来日，柴门稚子迎。\n贫甘守藜藿，名不愧公卿。\n宝剑空藏匣，良弨惜解檠。\n中兴谁草诏，君盍在承明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐从道韵二首 其一","author":"刘子翚","text":"高轩遥肯顾，扫室惯逢迎。\n酒喜频中圣，官惭四至卿。\n忧时论曲突，感物咏长檠。\n古道难开口，微君孰与明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晁应之大暑书事","author":"张耒","text":"蓬门久闭谢来车，畏暑尤便小阁虚。\n青引嫩苔留鸟篆，绿垂残叶带虫书。\n寒泉出井功何有，白羽邀凉计已疏。\n忍待西风一萧瑟，碧鲈斫鲙意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"刘子翚","text":"客里惊秋晚，慵眠但曲肱。\n夜阑深院雨，人过隔墙灯。\n远思千端恶，寒威一倍增。\n梦孤浑易破，哀柝故登登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奇仲和诗有吸尽西江说是公之句","author":"刘子翚","text":"南邻袖手只如愚，东里谈玄亦甚都。\n可是据鞍方矍铄，须防鬻璞得卢胡。\n春空潮响来何自，秋浦天容落欲无。\n万古西江只如许，何烦呼吸费工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬少稷道旧之什","author":"刘子翚","text":"少日胸怀辄自奇，与君谈笑叩天扉。\n南宫试艺联裾出，上苑寻芳结骑归。\n乱后交游今孰在，向来心事已多违。\n双鱼忽得平安信，回首家乡梦欲飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居仁报李季言论养生之益","author":"刘子翚","text":"平生外骛已知非，木枕藤衾老可依。\n春半风光唯掩户，病边怀抱自忘机。\n不知静守绵绵息，何似閒随栩栩飞。\n欲寄勤渠问仙李，玄关底处是真归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"府会次士特韵","author":"刘子翚","text":"夜宴芙蓉苑，华榱烛影光。\n史君频会客，侍女惯新妆。\n剧饮不胜醉，论诗非所长。\n倚栏霄汉近，宫殿郁相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊舟","author":"刘子翚","text":"莽莽荒茨岸，回回乱石滩。\n雨寒收市早，风急泊舟难。\n㝢县兵犹斗，乾坤网正宽。\n慇勤嘱龙剑，莫久卧波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试弓","author":"刘子翚","text":"结束拟从戎，秋堂试宝弓。\n角寒开拒手，弦劲响流空。\n巧习穿杨技，神誇饮羽功。\n挽强吾有待，狐兔莫争雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"转秩奉祠蒙朝佐子静庆以四六戏裁长句为谢","author":"刘子翚","text":"一岭无情阻面谈，鸣翰忽堕得双函。\n抽黄对白虽云妙，刻朽嘘枯祇益惭。\n小转只缘官带右，雄飞无复梦图南。\n借留赖有天台侣，老矣真成七不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵怀古","author":"刘子翚","text":"荒城莽莽蔽荆榛，虎踞龙蟠迹已陈。\n赤壁战争江照晚，青楼歌舞鸟鸣春。\n十年王气雄图尽，一叠寒笳客恨新。\n折屐风流犹可想，只今高卧岂无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剑潭赠李似表","author":"刘子翚","text":"夜窗把酒对鹅峰，分手悠悠各转蓬。\n舣棹相逢烟浪际，有家皆在乱离中。\n胡儿久占清河地，壮士谁收赤壁功。\n它日著鞭先后耳，飘零不用叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客路","author":"刘子翚","text":"客路经春雨，淹留未得归。\n径泥黄染屦，林雾白侵衣。\n直气何由吐，愁心只欲飞。\n东风如解事，吹梦落渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫亭湖","author":"刘子翚","text":"近湖黯黯气常寒，指点宫亭渺莽间。\n素色夜浮全楚月，绿光春浸十州山。\n醉思天末骑鲸去，老怯风头听雁还。\n柔橹声中知禹烈，愧无椽笔画孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屏迹","author":"刘子翚","text":"屏迹山樊避世喧，晚风落日静柴门。\n寒泉绕竹通幽圃，小径穿田入别村。\n散策微吟霜叶脱，钩帘宴坐碧云翻。\n閒中兴味知何晚，绝口名途不更言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思贤堂怀薛令","author":"刘子翚","text":"创始人何在，空堂草棘侵。\n冲门狐窜急，穴柱蠹藏深。\n羽化王乔舄，尘昏子贱琴。\n独嗟民困甚，谁继昔贤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨","author":"刘子翚","text":"暝色春朝雨，滋荣喜及时。\n云昏遥莫辨，地渴久方知。\n柳岸游车歇，涛江钓舸移。\n拒寒须把酒，病骨况支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望","author":"刘子翚","text":"杳杳尽寒色，乘高望更迷。\n晓晴山气上，春涨野桥低。\n幽鸟啼无伴，閒花发欲齐。\n几多沈寂景，醉笔为提撕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]