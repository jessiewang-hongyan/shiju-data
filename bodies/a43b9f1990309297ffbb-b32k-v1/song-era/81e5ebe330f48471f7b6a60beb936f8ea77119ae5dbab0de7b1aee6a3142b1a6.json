[{"title":"偈颂一百一十七首 其六十八","author":"释绍昙","text":"亲随弥勒下长汀，一字王书奉化名。\n辅国功成归内院，子孙恩被锦衣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十三","author":"释绍昙","text":"成癖襟怀为爱山，不逢佳处不开颜。\n锦屏剑阁重相见，疑在岷峨翠霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十五","author":"释绍昙","text":"远望蓬莱去学仙，途中忽遇李先生。\n还丹一粒吞还吐，回首空山独自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十四","author":"释绍昙","text":"上林春色正繁华，公子联镳去赏花。\n贪弄玉杯泥样醉，笙歌丛里簇归家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十三","author":"释绍昙","text":"厮扑场中作断交，拳来趯去不相饶。\n谁知用尽平生力，却傍被人夺锦标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十一","author":"释绍昙","text":"万金包裹烂泥团，不惜当场撮弄看。\n败阙遭人窥觑了，末梢依旧被渠瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十四","author":"释绍昙","text":"忠清千古灿奎文，盖世功名富贵生。\n旌佩拥云何处去，毗卢楼阁款经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十二","author":"释绍昙","text":"太阿久瘗丰城剑，才遇张华便发光。\n积世冤雠都扫却，蛰龙银匣袭珍藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十九","author":"释绍昙","text":"善护菩提树有年，金枝玉叶荫儿孙。\n大功难纪人间世，千佛名书补处尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十八","author":"释绍昙","text":"鈯斧埋藏岁月深，岩居日与白云邻。\n业风无奈重飘鼓，又作担柴卖筊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十","author":"释绍昙","text":"茧足寻庄到海门，天衣往事与谁论。\n长空雁影沉寒水，瘦立西风几断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十七","author":"释绍昙","text":"万里澄江雪霁时，玉壶一色冷含辉。\n渔翁认得烟村路，柳线穿鱼带月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十六","author":"释绍昙","text":"不拟寒山落韵诗，未传卢老泼禅衣。\n脚头活取通霄路，来透庭前刬草机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十六","author":"释绍昙","text":"花禁冷叶红，草敌虚岚翠。\n清净卢舍那，全身荆棘里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十四","author":"释绍昙","text":"玉栏花药斗春工，雨湿胭脂脸晕红。\n丝管纷纷来赏玩，可怜吹落五更风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十三","author":"释绍昙","text":"浪荡贪观野鸭儿，犯丛林合讲清规。\n鼻头捏破知惭愧，烧炷枫香供养伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十三","author":"释绍昙","text":"出匣神锋瑩鸊鹈，将军珍袭已多时。\n相承不是屠龙手，只作三文补履锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十七","author":"释绍昙","text":"烟雨溟濛望眼迷，兰舟小泊画桥西。\n儿童不识春流涨，却怪湖边柳树低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十","author":"释绍昙","text":"卢老无端飏下柴，碓头舂出古菱花。\n恶声千载成狼籍，养子谁人解克家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十二","author":"释绍昙","text":"岁除生怕管筵空，品味无多只要丰。\n掇转虚空为桉板，薄?明月切清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十","author":"释绍昙","text":"塞北安南几战争，老来卜筑傍烟村。\n却将旧斩楼兰剑，换得黄牛教子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一","author":"释绍昙","text":"西子湖边泛渺茫，一堤寒绿看垂杨。\n谁知业债难逃避，开眼堂堂入镬汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十五","author":"释绍昙","text":"万戟森严细柳营，信威独许汉将军。\n谁知袖隐屠龙手，却把蒿枝箭策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十七","author":"释绍昙","text":"读破灯窗万卷书，经纶勋业付洪儒。\n古今鼎鼐调羹手，幼学谁人不顺朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十八","author":"释绍昙","text":"钩饵深抛五十年，鲸鳌吞海误吞钩。\n急翻身逐洪波去，暗织沧溟一片愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十九","author":"释绍昙","text":"桑畴雨过罗纨腻，麦陇风来饼饵香。\n揭示西来端的意，好商量处错商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十五","author":"释绍昙","text":"祖翁田地绝边垠，契券分明孰敢侵。\n削尽春风闲草木，松涛翻月竹筛金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十九","author":"释绍昙","text":"一块松根石，顽然自古来。\n更无人觑著，岁岁长莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十九","author":"释绍昙","text":"烟晴竹树啼姑恶，月冷松梢哭子规。\n莫谓一声声破梦，未归须忆到家时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十三","author":"释绍昙","text":"红锦缠头舞醉身，笙歌声沸凤楼春。\n百花丛里扶归去，谁道儿郎彻骨贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十一","author":"释绍昙","text":"仙苑名花取次妆，鼕鼕羯鼓谩催芳。\n春风不费纤毫力，拂掠枝头便有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二","author":"释绍昙","text":"奴颜婢膝走人间，羞见羊裘七里滩。\n文叔虽为天子贵，子陵只作故人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○○","author":"释绍昙","text":"雪径封寒蝶未知，暗香谁遣好风吹。\n野桥漏泄春光处，正是横斜一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十九","author":"释绍昙","text":"三十馀僧眼似眉，白云深处聚头嬉。\n烧枯柴火煨山芋，拽木罗笼总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十八","author":"释绍昙","text":"不守蜡人冰，不怜鹅护雪。\n互用六根门，大地一团铁。\n百杂碎了也，妙尽依亡。\n肱枕绿萝形影绝，献花百鸟自空忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十","author":"释绍昙","text":"凤辇升遐恰一周，思君心切泪交流。\n攀龙无路空摧哽，凝望苍梧几许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其一○四","author":"释绍昙","text":"百戏场中赛锦标，蜜脾古马舞儿多。\n头筹暗被夺将去，行主喃喃强说呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十七","author":"释绍昙","text":"花禁冷叶红，草滴虚岚翠。\n清净卢舍那，全身荆棘里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十六","author":"释绍昙","text":"九曲明珠久蕴藏，走盘时见发寒光。\n当阳拈出还收拾，瞎眼波斯自著忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十八","author":"释绍昙","text":"焚香书写佛名经，窗外幽禽报喜声。\n次补数中添一位，大唐国里圣人生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十三","author":"释绍昙","text":"九曲黄河彻底清，六龙乾会圣人生。\n周行七步称尊处，山岳齐呼万岁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十九","author":"释绍昙","text":"五千黄叶止儿啼，不异渝江碧落碑。\n古篆分明无赝本，具看经眼不难窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十六","author":"释绍昙","text":"东村王老夜烧钱，拈引山云海月魂。\n贫极瑞岩轻助荐，尽教无佛处称尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其十四","author":"释绍昙","text":"不业农商不业儒，菑田弗下寸根株。\n驴年斫倒菩提树，羞见新州个老卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"高荷","text":"沙软绿头相并鸭，水深红尾自跳鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其八","author":"释绍昙","text":"抛舍箕裘要出家，学卢行者去担柴。\n脊梁不具黄金骨，碓米坊中被活埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其七","author":"释绍昙","text":"绿萝深处卧云烟，触战蛮征事悄然。\n临老无端重出丑，借婆裙子拜婆年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其六","author":"释绍昙","text":"千丈岩头太险生，无端更掘陷人坑。\n深深叠石防颓岸，要汝临崖撒手行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其五","author":"释绍昙","text":"一茎草外隐全形，翳尽丛林活眼睛。\n破绽莫教轻捉著，堂前高挂赎金名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其四","author":"释绍昙","text":"槽厂安身不记年，一心希慕岭南能。\n肩头飏下泼柴担，要汝来传佛祖灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其二","author":"释绍昙","text":"宫花压鬓坠乌云，倾国风流宛胜秦。\n玉笛插藏人不见，夜深吹起凤楼春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十九首 其一","author":"释绍昙","text":"草舍开张小小筵，炊无米饭爨无烟。\n通身饱暖憨憨睡，梦到沧洲白鸟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石溪和尚自雁宕归","author":"释绍昙","text":"雁峰削玉锁层阴，彷佛梅阳瘴面春。\n回首揭天挝毒鼓，声怨何止十三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄华严赜讲师","author":"释绍昙","text":"半生不睹德云翁，悬想经行在别峰。\n破一微尘相见了，揭翻华藏十三重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄贺天童灭翁和尚","author":"释绍昙","text":"接人筹室肯雷同，用治兵机不犯锋。\n把定牢关轻放过，一人标记一株松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄贺钱?荐福东林和尚 其二","author":"释绍昙","text":"钱王活业付东林，古墓埋藏暗箭深。\n机正发时谁中的，空山落日几惊心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄贺钱?荐福东林和尚 其三","author":"释绍昙","text":"法身边事会多时，端的枯桩弗用疑。\n无柄铁锤轻击碎，心花粲发不萌枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄贺钱?荐福东林和尚 其一","author":"释绍昙","text":"烹金炉去杳无踪，沉影愁看雁过空。\n出手与渠重结了，未应碧眼是顽铜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄紫箨茶与虎丘石溪","author":"释绍昙","text":"箨龙衔味噀春英，香入萝窗午梦清。\n笑汲新泉烦陆羽，贵图尊宿眼增明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼云泉老师","author":"释绍昙","text":"夺得犀牛便跺跟，蘋洲玩月角生纹。\n翻身入海无消息，惊散沙鸥白鹭群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼时愚庵主","author":"释绍昙","text":"诏书飏在破床头，高枕松根睡觉休。\n啼尽山禽惊不醒，萝窗空锁暮云愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼芳洲忏首 其一","author":"释绍昙","text":"不忍萤窗赚一生，翻身义虎顶头行。\n金篦刮尽空花膜，喜得天台教眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹溪六祖大师赞","author":"释绍昙","text":"辛州飏下两肩樵，又被黄梅石坠腰。\n虽得栽松衣钵在，暗思追逐几魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦庵","author":"释绍昙","text":"肱枕萝窗饱黑甜，华胥游遍鹤蹁跹。\n不思议境全机路，何待逢人竖起拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清凉礼先师遗像","author":"释绍昙","text":"白云迷谷雪铺阶，老倒清凉眼著沙。\n若问普通年远事，三千里外摘杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔篮妇赞","author":"释绍昙","text":"短裳褰起露珠珍，云鬓慵梳惑乱人。\n弄得篮中鱼再活，禹门未必解翻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"猪头和尚赞","author":"释绍昙","text":"手把猪头不自噇，面前背后鬼分赃。\n重重败阙无人识，赢得涂糊老定光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琏监寺 其一","author":"释绍昙","text":"烹金炉里脱胚腪，妙斲初无斧凿痕。\n汝质自成瑚琏器，我侬甘作破沙盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琏监寺 其二","author":"释绍昙","text":"曾把杨岐破屋撑，闲骑驴子弄蹄行。\n犯寒踏月慈溪上，冷笑梅兄太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维石","author":"释绍昙","text":"一路机先滑似苔，葛藤窠里出头来。\n等闲击著火星迸，霍得大唐人眼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"船子赞","author":"释绍昙","text":"千钧重寄一丝轮，三寸离钩抑逼人。\n莫道踏翻船便了，夹山未必是金鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"船子赞","author":"释绍昙","text":"心含恶毒气炎炎，倒捉粗桡管甚天。\n打得夹山撺入水，趁无入见急翻船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚叟","author":"释绍昙","text":"千圣机尘一洗清，心渊绝滓自灵明。\n白头谩说无功用，种得空花结果成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐山","author":"释绍昙","text":"触战蛮征一扫空，和云占断最高峰。\n单提破钁头边事，佛祖当机不见踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪牛","author":"释绍昙","text":"堕在虚凝一色边，完全头角不完全。\n溪东西岸难收放，纯白何妨露地眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪崖 其二","author":"释绍昙","text":"空花翳眼没根茎，平白谁知太险生。\n穷一色边须撒手，且无玄路与人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒拾赞","author":"释绍昙","text":"笑里藏刀语诈淳，握生苕帚鼓烟尘。\n谩将心污秋潭月，未必渠侬肯比伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化赞","author":"释绍昙","text":"大悲院里趁村斋，卒死无人出地埋。\n捏怪凌空摇木铎，春风处处露尸骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]