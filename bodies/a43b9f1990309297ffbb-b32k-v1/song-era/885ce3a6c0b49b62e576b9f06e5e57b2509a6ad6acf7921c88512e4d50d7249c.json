[{"title":"游雁荡山 石门庵","author":"徐照","text":"庵是何年立，其中有一僧。\n苍崖从古险，白日少人登。\n众物清相映，吾生隐未能。\n夜来新过虎，抓折树根藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁荡山 寿昌道中","author":"徐照","text":"碣字芙蓉驿，喜行行不难。\n路侵沧海过，人得异山看。\n圆石蚝黏满，平涂鹭立寒。\n一游期一月，回日必冬残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁荡山 灵岩","author":"徐照","text":"雁荡最奇处，众岩生此间。\n问名僧尽识，得句客方闲。\n洞峻猕猴入，天晴瀑布悭。\n古时山未显，谢守只空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁荡山 灵峰","author":"徐照","text":"我来无一语，闲认昔游踪。\n谁种路傍树，却遮山上峰。\n潭乾沉石露，人立去禽冲。\n樵说仙桥险，因思在上封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁荡山 宝冠寺","author":"徐照","text":"寺基低且狭，半被石岩分。\n水响常如雨，林寒忽聚云。\n空房人暂宿，半夜雁初闻。\n此处能通荡，僧家却不云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁荡山 能仁寺","author":"徐照","text":"寺置有碑传，观音岩石前。\n殿高灯焰短，山合磬声圆。\n窗静吹寒雪，舂鸣落夜泉。\n清游人岂识，谓不似秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁荡山 赠东庵约公","author":"徐照","text":"白发白髭须，僧年八十馀。\n已成重阁在，别置一庵居。\n客喜逢煎茗，童寒免灌蔬。\n小师南北去，近日各无书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游潇东和徐文渊","author":"徐照","text":"天吏今如隐，相随步野坡。\n山高临古郡，天小入江波。\n香草春生遍，幽禽暮见多。\n更增游岳思，昨有寺僧过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘口","author":"徐照","text":"庙前物景非人世，独独来看路径遥。\n船板鹭行乾有迹，菊花鹿践曲生苗。\n合流水急声难尽，过片云轻色易销。\n黄叶未成伤远思，西风先向客衣飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘中中秋","author":"徐照","text":"出望月轮小，不如临海生。\n又疑今夜看，难比故乡明。\n立柏正无影，清猿偏有声。\n数家弦管外，专此照离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘中寒夜","author":"徐照","text":"本自家于越，何期滞楚邦。\n吟多头易白，归切思难降。\n但听风收竹，谁知雪满江。\n叉鱼中夜急，烧火照楼窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登祝融峰","author":"徐照","text":"祝融高莫比，身到胜传闻。\n日动洞庭水，风开衡岳云。\n老僧冬离寺，群狖夜归坟。\n后洞连方广，山头路即分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登歙山寺","author":"徐照","text":"石径半攲倾，山头路始平。\n步因花树息，吟忘寺僧迎。\n一面门无水，东隅路入京。\n青峰三十六，霜晓见分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答徐玑","author":"徐照","text":"君有新诗题我石，我因吟赏每登亭。\n塞门雁到云边失，海口山来树里青。\n几度寄书亲入郭，有谁载酒更过汀。\n欲知生事全无长，买纸闲传相鹤经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢徐玑惠茶","author":"徐照","text":"建山惟上贡，采撷极艰辛。\n不拟分奇品，遥将寄野人。\n角开秋月满，香入井泉新。\n静室无来客，碑黏陆羽真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道书记房老梅","author":"徐照","text":"香有竹风知，无尘杂野姿。\n为怜新白发，重记旧题诗。\n藓带龙鳞剥，蜂沾蠹屑垂。\n不来三十载，半树是孙枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁","author":"徐照","text":"今春北归雁，秋至又南征。\n冷避燕关雪，暖逢湘水晴。\n连行冲烧断，并食杂鸥行。\n沙上无缯弋，相呼一夜鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁","author":"徐照","text":"愁与诗相似，能令须发新。\n意清尘不没，道直事多屯。\n水石惟宜夏，田桑独致贫。\n不除闲懒性，前世必僧身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪行寄灵舒","author":"徐照","text":"滩恶过金水，波声远亦闻。\n诗同家信发，灯向钓船分。\n数夜仍无月，看山半是云。\n又须登岸宿，回望却思君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"猿皮","author":"徐照","text":"路逢巴客买猿皮，一片蒙茸似黑丝。\n常向小窗铺坐处，却思空谷听啼时。\n弩伤忍见痕犹在，笛响谁誇骨可吹。\n古树团团行路曲，无人来作野宾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筠州同陈主簿游园","author":"徐照","text":"一见情先熟，相同野外行。\n林园仙士守，笔砚小童擎。\n鸟上阶除近，冰悬石窦明。\n知君吟易就，清思逼寒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筠州送赵判院归九江","author":"徐照","text":"相逢今半月，夜雨厌同闻。\n远地长为客，还家极羡君。\n诗低劳尽写，茶美许重分。\n一马冲寒去，庐峰正雪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筠州赠邓汉卿","author":"徐照","text":"客路相逢欣道合，未尝一日不相随。\n仙坛观水天晴后，古苑寻梅雪落时。\n不娶自然忘世累，云山何苦动归思。\n行年未老头全白，只我知君为作诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"路逢杨嘉猷赴官严州","author":"徐照","text":"诗合诚斋意，难将片石镌。\n相逢因在道，惜别未移船。\n野步僧同话，宵吟吏废眠。\n思君还有梦，前到钓台边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬翁常之","author":"徐照","text":"半掩柴门一径深，山中免见俗尘侵。\n愁因有酒春生面，老不饶贫雪满簪。\n旧井远通幽谷水，翠藤新长小窗阴。\n扁舟莫负林间约，好把清诗慰此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬赠徐玑","author":"徐照","text":"每到斋门敲始应，池禽双戏动清波。\n爱闲却道无官好，住僻如嫌有客多。\n字学晋碑终日写，诗成唐体要人磨。\n山民百事今全懒，祇合烟江著短莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝉","author":"徐照","text":"叶落无蝉在，又随林叶生。\n不离荒苑处，偏感异乡情。\n幽韵松风合，枵肠竹露清。\n无端溪鸟逐，飞落地中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丁少瞻林园","author":"徐照","text":"州分低岭外，来向此园行。\n路改初栽树，堂成未有名。\n药苗如草长，岩溜入池清。\n欲识怀君意，时闻鹤一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题永州唐德明竹园","author":"徐照","text":"渭川千亩空闻说，得似君家亦是难。\n畦仆不知生凤实，野翁祇欲乞鱼竿。\n忽惊残粉飘苍雪，最喜幽声胜远滩。\n六月火云飞不尽，谁知此处独清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江心寺","author":"徐照","text":"两寺今为一，僧多外国人。\n流来天际水，截断世间尘。\n鸦宿腥林径，龙归损塔轮。\n却疑成片石，曾坐谢公身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题芗林","author":"徐照","text":"祇为登山远，当门叠石为。\n人来嗟故迹，景胜入名诗。\n立鹤高过槛，攲花半在池。\n百年庭际木，新长挂冠枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题何仙姑旧居","author":"徐照","text":"身居何处洞，潇岸看云行。\n既已通仙籍，奚烦赠道名。\n幌红花日影，香断寺钟声。\n题句君应识，君诗亦自清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李商叟半村壁","author":"徐照","text":"一径苍苔合，连年不出门。\n风高松有韵，溪满石无痕。\n不自知名重，令人觉道尊。\n更忧徵诏至，移室向深村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题罗隐故居","author":"徐照","text":"片水静无尘，青山是四邻。\n上天如有意，此地著诗人。\n吟得物俱尽，罚令生世贫。\n因来寻古迹，只见石为麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓台","author":"徐照","text":"当时廊庙去，此地也成空。\n草木多年换，儿孙近代穷。\n无言伤末俗，久立慕高风。\n梅福神仙者，新知是妇翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题信州赵昌甫林居","author":"徐照","text":"谱接江西派，声名过浙间。\n弃官从早岁，买屋向深山。\n文集通僧借，渔舟载鹤还。\n待予归旧里，又得到柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题夏景清湘中阁","author":"徐照","text":"湘中山似水，自古有人云。\n此是曾游地，今来尽属君。\n残风吹岸草，空庙入江云。\n却忆还乡梦，清猿半夜闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题桃花夫人庙","author":"徐照","text":"一树桃花发，桃花即是君。\n空祠临野水，何处觅行云。\n事迹樵人说，炉香过客焚。\n雨添碑上藓，难读古时文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题浯溪","author":"徐照","text":"知是漫郎宅，舟中闻寺钟。\n小溪通正港，高石叠群峰。\n绿木成春荫，荒台见古踪。\n唐碑三十本，独免野苔封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题真娘墓","author":"徐照","text":"骨成泉下土，何物是游魂。\n一代颜容尽，千年名姓存。\n善缘依佛地，巧咏任人言。\n几听钱塘曲，风松静似喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题翁卷山居 其二","author":"徐照","text":"空山无一人，君此寄闲身。\n水上花来远，风中树动频。\n虫行黏壁字，茶煮落巢薪。\n若有高人至，何妨不裹巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题翁卷山居 其一","author":"徐照","text":"十年前有约，今却在城居。\n羡尔能携子，深山自结庐。\n引泉移岸石，栽药就园蔬。\n见说高林外，樵人听诵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陶贞白故居","author":"徐照","text":"徵君上天后，有屋在松根。\n一片仙坛石，却当僧寺门。\n居山称宰相，隔代绝儿孙。\n太傅新为记，今来亦不存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淡岩","author":"徐照","text":"一石高千尺，惟留一面空。\n寸窥横嶂绿，圆透夕阳红。\n僧定遗人世，猿藏畏雪风。\n却怜黄太史，不至雁山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题筠州赵县丞寒谷","author":"徐照","text":"栽梅一百树，有屋二三间。\n此地长宜隐，为官却未闲。\n路移存古井，城逼失前山。\n喜共红蕖客，来吟至夕还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题鲍史君林园","author":"徐照","text":"水波一带隔秋城，不许尘埃接地生。\n浓露渐成红蓼色，野风添作小松声。\n客来喜自开楼锁，病去逢人语药名。\n闲意却多官意懒，旁人传说似渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题薛景石瓜庐","author":"徐照","text":"何地有瓜庐，平湖四亩馀。\n自锄畦上草，不放手中书。\n人远来求字，童闲去钓鱼。\n山民山上住，却羡水边居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题衢州石壁寺","author":"徐照","text":"岸上横生脉，平林一里溪。\n众船寒渡集，高寺远山齐。\n残磬吹风断，眠禽压竹低。\n自嫌昏黑至，难认壁间题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠大罗山李秀才","author":"徐照","text":"大罗山上客，后主是宗亲。\n莫是为诗苦，却令生世贫。\n荒年家口众，少日鬓毛新。\n近又重遭祸，虚星必照身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠不食姑","author":"徐照","text":"衣以青为色，谓如天骨青。\n近年全不食，饮水自通灵。\n心信生狂语，清羸改俗形。\n半空仙乐奏，曾向静中听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠从善上人","author":"徐照","text":"骨气清泠无片尘，即应僧可是前身。\n诗因缘解堪呈佛，棋与禅通可悟人。\n扫地就凉松日少，煮茶消困石泉新。\n不能来住城中寺，去买青山约我邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠邓都监","author":"徐照","text":"能吟能画俱精到，多得声名在世间。\n少病高年惟发白，为官远地却身闲。\n深林有寺唐碑在，古庙无人楚竹斑。\n物景可吟兼可画，乞君篇幅未应悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘明远","author":"徐照","text":"一生嫌世俗，不向市中居。\n既是未攀桂，却堪同钓鱼。\n疾除禅老药，诗答野人书。\n又说成丹鼎，吾生愧不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠朱道士","author":"徐照","text":"新营一间屋，种柳是前春。\n此地已逃俗，何时可卜邻。\n吟诗能愈疾，得酒自忘贫。\n九十头无雪，多应笑野人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠江心寺钦上人","author":"徐照","text":"客至启幽户，笋鞋行曲廊。\n潮侵坐禅石，雨润读经香。\n古砚传人远，新篁过塔长。\n城中如火热，此地独清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠实老","author":"徐照","text":"夏高头半白，不肯住招提。\n汲井篱花落，挂衣巢鸟啼。\n林间曾有约，世上尽如迷。\n却把南华卷，从人论物齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠溪上翁","author":"徐照","text":"生事付诸儿，日高眠起迟。\n本无尘内事，亦有鬓边丝。\n远取泉烹茗，新移棘补篱。\n晚来持钓出，一犬自相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠潘德久","author":"徐照","text":"住近容成洞，归来发未霜。\n出骑随驾马，晴晒入朝裳。\n收帖重开画，煎茶即当觞。\n诗书难得力，戎力重清漳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹭鸶","author":"徐照","text":"一点白如雪，顶黏丝数茎。\n沙边行有迹，空外过无声。\n高柳巢方稳，危滩立不惊。\n每看闲意思，渔父是前生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"露","author":"徐照","text":"立久衣襟润，空中气结成。\n光凝兰叶腻，冷逼鹤阴清。\n又觉为霜近，犹能向日明。\n惟知汉宫内，千尺有金茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈待制五月十四日生朝","author":"徐照","text":"羲辔迟中夏，生贤国世宁。\n隔宵蟾欲满，经溽雨初停。\n分派来沩水，储神应德星。\n高楼参造物，健笔倒沧冥。\n几郡流威惠，今人识典刑。\n随行惟一鹤，堆案有群经。\n道直言皆壮，心和鬓益青。\n即须调鼎铉，未许在林坰。\n斸石逢云母，栽松长茯苓。\n龟巢莲叶上，公见却千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜翁卷至","author":"徐照","text":"开裳坐岩石，静僻胜尘区。\n禽落闲庭果，荷侵湿岸蒲。\n高情天外远，暑气竹间无。\n浅井瓦瓶汲，低床桃簟铺。\n江声空槛树，烧影照巢乌。\n困睡抛书册，悲吟缺玉壶。\n浮生如梦幻，世事任凫卢。\n但得过从乐，无嫌此地迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈待制湖楼","author":"徐照","text":"天游观妙化，人世事皆轻。\n沆瀣藏仙境，津涯截海城。\n一身凌汗漫，品类仰高明。\n有道行藏小，无心视听精。\n上疑灵蜃吐，下觉巨鳌擎。\n雨气西帘入，月华东槛生。\n山临左辅近，湖自会昌成。\n风起僧钟直，村回野艇横。\n莲枯收绣段，松静发琴声。\n濠濮观鱼鸟，潇湘欠药蘅。\n一层休更上，百尺有谁评。\n昏日寒峰淡，残星远笛鸣。\n醉如元亮兴，归引仲宣情。\n阆苑琼为贵，黄州竹过清。\n郡图添圣迹，画轴记新营。\n奏乐渔人听，投车坐客盈。\n八篇移古咏，四字立嘉名。\n未必终成隐，清朝待秉衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三峡吟","author":"徐照","text":"山水七百里，上有青枫林。\n啼猿不自愁，愁落行人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三阁词 其二","author":"徐照","text":"三阁变瓦砾，欢乐一时休。\n草没石井栏，草亦为汝羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三阁词 其一","author":"徐照","text":"龚孔与丽华，迷昏竟宵昼。\n只知欢似前，岂知祸萌后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上木詹事生日十月十五","author":"徐照","text":"客花十月开湘桃，蓬天春浅霞烟高。\n仙郎玩世跨鹏海，红龙紫仗青童翿。\n星斗心胸□□□，笔端衮衮惊沧涛。\n天皇庚申开凤历，百八十岁生夔皋。\n彤庭射策鬼斗□，虎符分寄梁悬刀。\n承华出入汉长吏，画图周室诸侯朝。\n绫绮连钱蔽华屋，神奎秘画黄金标。\n鹤嘴瓶深贮沆瀣，西峰倒碧翻蒲萄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"徐照","text":"世事已无营，翛然物外形。\n野蔬僧饭洁，山葛道衣轻。\n扫叶烧茶鼎，标题记药瓶。\n敲门旧宾客，稚子会相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]