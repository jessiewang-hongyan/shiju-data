[{"title":"自永丰玉山回宿南豅","author":"韩淲","text":"章泉风日来时路，烟雨南豅归去时。\n已过重阳犹菊蕊，又将十月忽梅枝。\n周游放浪家家酒，展转流连处处诗。\n信道山间深更好，尽閒尤与老相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初六日归汎南豅已三鼓矣","author":"韩淲","text":"乍凉天气翠烟霏，多少林花露未晞。\n十里幽香秋醉去，一溪新月夜吟归。\n岂无僧舍居高远，定有人家在隐微。\n夜半鹤鸣猿啸冷，滩声鸣绕钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十六日送曾守遇伯辉于南豅","author":"韩淲","text":"周瑜隐地春曾住，秋以为期玉斗游。\n只道参差无此适，要知拓落有何谋。\n经行二姓忽相聚，辗转一身终自由。\n四树木樨花正发，幽香随处且忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晦日冲雨过同官赵大小楼眺望江山","author":"韩淲","text":"一楼烟雨更横江，吴越苍山入混茫。\n霁色未分无远树，潮声初过有归艎。\n檐楹高处閒登眺，市井中间任迫忙。\n日日痴儿了官事，暂时相赏试持觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登一杯亭 其一","author":"韩淲","text":"当年丞相一登临，酒畔峥嵘万古心。\n重整乾坤归庙社，却留岁月在山林。\n荒寻野阁甘棠蔽，名占高台岘首深。\n见说治中新筑就，肯堂三叹有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登一杯亭 其二","author":"韩淲","text":"旄麾谁不典方州，何事邦人记昔游。\n时令纵非名转盛，灵山如画水西流。\n吾侪只得诗模仿，尔辈焉知酒拍浮。\n却忆环滁最佳处，醉翁亭子至今留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭后乘日过东家","author":"韩淲","text":"霜晴已是探梅时，野趣轩茶更合诗。\n才出门来唯独往，不看山去亦何知。\n试听石濑无尘滓，如觉林梢有好枝。\n心与眼明知兴熟，朗吟惟老转相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十三夜携杯浮桥看月","author":"韩淲","text":"一轮秋月到天心，此夜全无云片侵。\n雅静每于閒后见，孤高难向闹中寻。\n渐圆渐好形神正，愈大愈明精气深。\n最是溪间波影里，金光摇动玉沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一日郡守饭灵山阁夜坐新浮桥月中","author":"韩淲","text":"使君襟抱中秋月，閒饮宾僚醉野人。\n倒载去寻高阁古，落成未试一桥新。\n山城明岁当回首，云路兹时好发身。\n唤起嫦娥驾轮玉，不知何处著纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十三日方斋 其一","author":"韩淲","text":"麦秋蚕月雨收晴，城郭山林到处行。\n不是惜春寻小醉，忍教投老转多情。\n啼鹃渺渺翻梁燕，梦蝶蘧蘧出谷莺。\n记取招邀一杯酒，与君宜戏也宜惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十三日方斋 其二","author":"韩淲","text":"捉得春风住三日，明年依旧百花香。\n酒杯满后同谁饮，诗句成时只自狂。\n金缕声销非幻景，玉华烟散任仙乡。\n灵山翠滴冰溪水，只这閒情话更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上乘寺","author":"韩淲","text":"禾黍登场秋已深，暮天寒日起层阴。\n不论世路有夷险，但觉此心无古今。\n黄帽青鞋聊自适，高山流水付知音。\n解鞍野寺黄昏后，犬吠疏篱鸦满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上富春滩","author":"韩淲","text":"唤得扁舟一叶轻，钓台波上夕阳明。\n固宜烟鸟知人意，只为云山识我情。\n篷日午前虽较热，帆风晚后却尤清。\n吾庐更在楚溪口，归卧北窗听竹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十六日至章泉水","author":"韩淲","text":"山愈深时地愈高，春寻积李散崇桃。\n林庐但觉无尘话，田里那知有载醪。\n华发苍颜俱老大，清泉白石更周遭。\n常年每厌居城郭，时复从翁敢惮劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪行","author":"韩淲","text":"突兀荒荒漫挈瓶，泓澄窈窈且扬舲。\n隔山鸡犬三家聚，近水鱼虾一岸腥。\n说梦休誇巫峡赋，移文何愧草堂灵。\n交游少得亲相识，临眺多为旧所经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"携秉垓千散步","author":"韩淲","text":"湿云收动碧山空，松叶桐花日影中。\n开尽一轩无曲折，扫除三径有幽通。\n耘耔不厌农田雨，流憩居多野水风。\n解断浮航尘迹少，苇间何地觅渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜间自东楼溪游甚适寄吴推赵将","author":"韩淲","text":"满船载得高溪月，吹落东楼万里风。\n岸上未收灯火处，城头初动角声中。\n抚怀定自閒相觅，抵掌还知醉亦同。\n三百年来无此作，谪仙飞过水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过冠秋","author":"韩淲","text":"来年要作冠秋诗，今日花时合自知。\n我觉为吟真老丑，人疑取酒若儿嬉。\n收香宿雨初浮蕊，弄色晴风定满枝。\n莫道空山漫遗句，传家垂后有深规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同世昌寻春","author":"韩淲","text":"春风清晓尚微霜，近午寒收日渐长。\n步稳路平山涤霭，眼明溪净水生光。\n珍禽啼鸟犹能乐，野草闲花亦自香。\n回首红尘是城市，林间诗酒试平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚寒散步涧上","author":"韩淲","text":"支吾老态懒成言，勃窣蹒跚试出门。\n脚底路回篱外屋，眼前梅发涧边村。\n雪霜欲下天回互，烟雾不收山吐吞。\n归到寒窗卷书坐，地炉深火过黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚立涧旁","author":"韩淲","text":"水边独立看黄昏，梅蕊能销客子魂。\n淡霭清钟知隔寺，微风幽笛是前村。\n牛羊径路生寒色，鹅鸭陂池裂冻痕。\n一种清怀几多景，鸦栖密木更翩翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪上行至傅庵蹊间崩石险涩几踣","author":"韩淲","text":"无酒无诗只意行，水边林下偶然晴。\n缓移野步微攲侧，细比凡心尽旷平。\n白发去来同遁迹，青春交往定蜚英。\n小庵供佛安禅地，只合僧家一味清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纳凉濠上","author":"韩淲","text":"夕阳偏占绿荷风，夏气浮凉酒满钟。\n人胜不讥吾拓落，身閒何恨尔从容。\n唤回今古风骚体，消得乾坤运化功。\n只是灵山照冰水，莫教忧乐系穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同吴永伯行田宿小寺","author":"韩淲","text":"冉冉春烟山半昏，远林荒草际斜曛。\n人家几点望中见，鸡犬数声何处闻。\n不奈客愁惊晚岁，空馀诗思入行云。\n青松影下归来路，野寺对床还醉醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫同汎舟归宿涧房","author":"韩淲","text":"山阴溪曲古何年，今日南豅棹复旋。\n夹岸暖风吹麦秀，钓竿清浪出鱼鲜。\n诸儿挈饮能迎劳，耆旧谈围信解悬。\n放溜归来月初夜，林间应独与翁便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登跨鹤台有怀 其一","author":"韩淲","text":"山头跨鹤旧登台，今日那知我独来。\n忆昨儒先追杖屦，因尝乡老共尊罍。\n呼儿且伴闲身健，好客何由笑口开。\n落魄使君王道甫，几回和月醉崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日登跨鹤台有怀 其二","author":"韩淲","text":"西风吹我上危台，鹤驾仙人跨海来。\n虽少菊花犹破帽，既多枫落合倾罍。\n玉溪净泻秋容淡，灵岫森罗夕照开。\n老去悲伤易如许，人心何苦自崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"倚楼","author":"韩淲","text":"湖山咫尺懒追游，独倚危楼已白头。\n初夏风光还荏苒，乍晴云物正飞浮。\n长吟自可千篇在，小醉谁能万事休。\n毂击肩摩争辇路，不知虚度几春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"锄治山椒可置胡床远览","author":"韩淲","text":"荒秽诛锄山径开，更于高爽敞平台。\n眼明庶以闲登眺，步稳因之数往来。\n载斸坡陀曾树蕙，缘通茂密待移梅。\n城南自是多幽处，一曲今藏古涧隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小泊桥南书院","author":"韩淲","text":"欲浮一舸过东吴，小泊桥南兴有馀。\n尽道久悬高士榻，岂知重见故人车。\n诗家情味从来别，书院言谈分外舒。\n莲实藕花秋露滴，坐多题句转清虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新辟小室自适","author":"韩淲","text":"扫除闲室置书琴，偃仰之间万古心。\n饭了欠伸因小憩，睡馀消散得孤斟。\n辉辉白日回初暑，拂拂清风动晚阴。\n门巷喜无车马至，傍檐时自听鸣禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暑中思涧上之适","author":"韩淲","text":"野趣池头莲正香，潩泉亭上水生凉。\n有时并舍闲题句，尽日荒园浪举觞。\n隘巷泥涂谁下榻，一楼风雨自移床。\n青衫白发今何事，苦恋明时在帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉田道中得诗二句因足之","author":"韩淲","text":"秋晚晴原上玉田，水边林下过金仙。\n寺钟欲动黄昏月，野鸟时横碧落天。\n萸糁人家皆取醉，菊花篱槛亦争妍。\n三叉路入孤村去，九日閒投物外缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何山有苏沧浪苏玉局诗乃唐何楷书堂也","author":"韩淲","text":"亭上清诗得两苏，空留精舍作僧庐。\n地因人胜合题句，山以姓知缘读书。\n一径虚明连别屿，小溪清浅过平湖。\n笋舆少憩烹茶去，转觉秋来兴有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟峰","author":"韩淲","text":"系船散策到龟峰，人意从容景不穷。\n点检形容多变态，纵观面势更穹崇。\n并边幽草丛丛碧，绝顶残枫树树红。\n山翠著人寒更早，岚光明灭鸟声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悠然堂","author":"韩淲","text":"公堂柱笏文书省，日月青山在眼前。\n吟到有诗端自肯，醉中因酒亦天全。\n霜高远树参差外，风落孤鸿灭没边。\n却笑柴桑穷处士，篱根把菊始知然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵十重整山堂南北苍翠在望","author":"韩淲","text":"水南常只见灵山，城市谁曾顾此间。\n空占巃嵷成晻霭，安能嵽嵲尽回环。\n高堂知整轩窗静，曲径应多草木閒。\n眼界一亲心更远，属联佳句不当悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同孟守出溪亭视涨和严解元韵","author":"韩淲","text":"滚滚溪亭雨未休，偶陪小队得来游。\n蚕桑时候将何望，燕麦风前信隐忧。\n民力已殚诚易与，天心非远不难筹。\n果然香火开晴色，从此年登定有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周倅以诗来索翠微堂题因周韵为末后句","author":"韩淲","text":"翠微分得閒风月，再葺斯堂若画图。\n旧观岂专希白有，新题还拟汗青无。\n隔林闻杼情何寄，与客携壶景不殊。\n山上群仙司下土，蓬莱归路莫踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莫堂为柴丈参议题","author":"韩淲","text":"冲风冲雨傍孤城，旋借篮舆上岸行。\n零落交游难屈指，峥嵘耆旧可寻盟。\n共披庄列心何妙，更话曹刘眼倍明。\n但愿先生博长健，笑看犬吠与鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃花台","author":"韩淲","text":"倚棹扪萝步古堤，井边池上访招提。\n荒荒草满平原外，寂寂洲横流水西。\n一叶小舟渔自乐，数行高树鸟频啼。\n人间俯仰仙凡隔，丹灶空留占葛溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅月台","author":"韩淲","text":"山路难嫌脚力登，尽高高处又凭陵。\n岂无道院烧仙药，定有僧龛供佛灯。\n一任荐绅多习熟，都缘书册易因仍。\n屋头巷尾谁连壁，凉冷秋来老莫胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跨鹤台","author":"韩淲","text":"台占溪南最上峰，政成民乐得从容。\n彼时高李情如许，此地苏丁事偶逢。\n可是吾身羡轻举，肯令人眼溷尘踪。\n昂昂紫府飞来处，一片笙箫酒满钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵邱簿对碧轩","author":"韩淲","text":"淡烟晴景鸟关关，香净茶甘宴坐间。\n竹碧便宜终日对，僧清输与一生闲。\n此时薄宦经行地，万里思乡梦处山。\n心寄飞鸿在云眇，数声零落下沧湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题笑轩","author":"韩淲","text":"伸眉为作笑轩诗，胡广中庸天下知。\n展转此身俱老矣，纷拿何事不儿嬉。\n从教流俗千般巧，莫受荣华一点欺。\n几度归来抚空案，清风明月总相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贫乐轩","author":"韩淲","text":"林深自爱玉溪滨，肯问囊空甑有尘。\n但扫轩窗置书册，时将樽俎醉诗人。\n幽寻灵运登山屐，静寄渊明漉酒巾。\n南渡百年青社远，如君终不负閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题司马寺丞约汪倅赵倅携酒相过涧亭","author":"韩淲","text":"溪山前后簇双旌，暇日城南取次行。\n因到小园寻胜事，更于野寺畅幽情。\n联翩别乘同歌吹，落拓閒民亦兕觥。\n元祐相家文物在，唤回洛社旧升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茅斋","author":"韩淲","text":"鹭鸶林下得周旋，回首凄凉十五年。\n岂谓交游寻旧约，不堪朋友话新编。\n翠连山色高还耸，绿满湖波散复圆。\n小酌更多今古意，薰风吹树听鸣蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题山光亭","author":"韩淲","text":"晚春天气绿园林，小上危亭酒未深。\n紫燕归来知倦翼，黄鹂飞去有清音。\n水烟望望山明灭，风雨时时景晦阴。\n莫问痴儿了官事，尊前容我短长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"抗云亭","author":"韩淲","text":"淡烟晴日近重阳，整屐荒山野路长。\n世事是非同胶扰，人生今古一悲凉。\n望穷千里乾坤外，清绝小园松菊香。\n此日此时真可惜，西风催酿满林霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"成趣小隐","author":"韩淲","text":"今年春色在山家，到处寻梅看落花。\n成趣园中乘日往，最高台上受风斜。\n棋声与我诗无尽，酒力因君兴未涯。\n拓落不知天蚤暮，更呼急管度芳华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"成趣","author":"韩淲","text":"春到名园花下门，画梁迎燕落泥芹。\n海棠径暖红争艳，鱼藻波肥绿飐文。\n兴逸自怜真野老，醉归谁问故将军。\n一时觞咏留连处，更得清酬信不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题邓器先北窗","author":"韩淲","text":"古寺虚廊石壁阴，幽人高卧一窗深。\n绝胜移病听朝鼓，大似归田理素琴。\n棋酒定知交有味，轩裳得路可无心。\n何时下榻容吾语，共挹清风抵万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题溪堂柏阁","author":"韩淲","text":"循除㶁㶁水长鸣，柏阁溪堂静处深。\n出处清朝为得路，卷舒黄卷足知音。\n鸡豚里社高人酒，风月山林野客吟。\n好在秋残一樽后，直须怀玉伴幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐和卿所居潘阆巷","author":"韩淲","text":"知道逍遥巷里居，彼时此地复何如。\n岂无草木稀人迹，那有尘埃污我书。\n将鹤清狂应望海，骑驴颠倒想临湖。\n他年好事流传去，又说徐公旧隐庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池上","author":"韩淲","text":"池上松龙长子孙，池东佳气抱天回。\n争高蚁垤峻不已，强聒蚊雷去复来。\n白笈囊空嫌薏苡，碧云旧路足苍苔。\n清溪无限春桃种，岂是刘郎一手栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题新居","author":"韩淲","text":"泉石堂前四十秋，青山横北水西流。\n萧萧木叶下高树，寂寂河梁浮小舟。\n喜有诗人寻胜迹，可无閒客共清游。\n翛然更占南屏曲，应待我来盟白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题庐陵曾氏新居","author":"韩淲","text":"孝哉有子作斯堂，孺慕终身信不忘。\n橘熟可能怀陆绩，枕凉无复扇黄香。\n庭闱深处空萱盛，门户高时合桂芳。\n退傅之诗人所敬，从今名字表江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑盱眙郊居 其一","author":"韩淲","text":"年来有味是琴书，喜见新园更结庐。\n万事从教无造物，一身终是在寰区。\n贤愚衮衮多前古，富贵纷纷满后车。\n倒著接䍦扶杖去，从公秋水看清渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑盱眙郊居 其二","author":"韩淲","text":"一邱一壑本同然，老去心情懒问禅。\n野外江山天转大，秋深风露月还圆。\n栽花种柳无馀日，问舍求田有尽年。\n只恐功名相逼逐，未容著意到閒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晁十哥旧居新辟种竹","author":"韩淲","text":"旧家庭院新栽竹，却忆本闲南渡初。\n生聚百年推甲族，流传四世尚同居。\n清风不负堂前燕，长日犹堆案上书。\n根本既深枝叶在，时时培土莫轻锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题玉真高隐","author":"韩淲","text":"楚山突兀起危亭，消得登临醉复醒。\n云锦地连无俗客，玉真天与集仙灵。\n烟霞明灭心逾远，松竹回环眼自青。\n何日主人同胜赏，小舟波上待重经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞竹寺","author":"韩淲","text":"白云夜伴岩扉宿，虚籁幽幽意自春。\n回首驱驰因薄宦，平生萧散本閒人。\n风摧老木岚光静，霜逼早梅天气新。\n眼底明朝更清绝，便成西去也逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋晚同德久湖寺晚望","author":"韩淲","text":"云薄湖山入暮天，近看容淡远苍然。\n秋生旷暮时藏日，野外荒寒更起烟。\n柳下不知多少屋，苇间惟听往来船。\n今年情味诗全减，只合灵虚唤水仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]