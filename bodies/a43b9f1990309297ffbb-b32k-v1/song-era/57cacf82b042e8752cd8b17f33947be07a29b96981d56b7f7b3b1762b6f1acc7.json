[{"title":"次叔厚韵","author":"洪咨夔","text":"梦断红尘踏九衢，云山佳处借楼居。\n采将瓠叶随宜煮，拾得榴皮信意书。\n未问我今忘我世，须知吾本爱吾庐。\n黄公垆在花阴里，磊砢从君一破除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次洪漕韵 其二","author":"洪咨夔","text":"和月梅花共一寒，兜牟未必尽粗官。\n醉来抱膝吟梁父，睡起搔头著说难。\n富贵冰山何用倚，功名盘石自须钻。\n朔风衰草腥狐兔，猎火归鞭夹市看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次洪漕韵 其一","author":"洪咨夔","text":"塞垣拥雪髑髅寒，多少将军博美官。\n莫恨知心今世鲜，须知行道古来难。\n时穷地狭何能舞，命好天高亦可钻。\n此理乘除应会得，梅边索酒笑相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次费伯矩护印道中韵","author":"洪咨夔","text":"合着丝絇侍建章，却随靴裤踏苍凉。\n灯前针线为谁好，镜里黛铅如许忙。\n野水无心鸥等伍，秋风有味菊颜行。\n到头灵运终成佛，妙境须闻戒定香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次徐云叟赋桃源无脚桥","author":"洪咨夔","text":"经始西风八月秋，桃花春涨已无忧。\n横飞阁道虚空度，直放银河自在流。\n倚岸斜看疑是洞，循坡稳上认为楼。\n遍行吴蜀今才识，却笑浮桥谩造舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次徐隆庆寿诗韵 其二","author":"洪咨夔","text":"史君笔斡万牛回，脚底春风舌底雷。\n一夜剧谈逢野阆，百年高谊见欧梅。\n客心衮衮江流去，老色翩翩岁事来。\n堕地渠侬天已定，酒边赢得笑颜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次徐隆庆寿诗韵 其一","author":"洪咨夔","text":"牛奋箕张小丙申，熟知命驳不能纯。\n年来颇怪刀头蜜，老去难供席上珍。\n闯霭千章森戟纛，鏖风万壑绎韶钧。\n剑山拾得商山橘，醉共仙翁脯白麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次黄宰早春韵","author":"洪咨夔","text":"胜里春来早，迟君秉烛游。\n煖如三月暮，香老百花头。\n心事付桑落，风光催栗留。\n人生行乐耳，任命不须求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次程岳州廷迈春行昨访天梯佛龛今约乌奴","author":"洪咨夔","text":"汗血嘶风草正青，眼中万马敛春坰。\n檄书纵不烦师鲁，荐藁犹当出古灵。\n杜若扶疏明远渚，荼蘼猗靡馥中庭。\n天梯行遍乌奴去，到手深杯莫暂停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵七夕","author":"洪咨夔","text":"弄巧拙逾甚，合欢愁转多。\n擘金盟似海，搔玉泪成河。\n天运真旋磨，人生特掷梭。\n身闲凉月好，且与醉无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵可庵梅","author":"洪咨夔","text":"点雪非耶果是耶，紫千红万未曾芽。\n苍苔有晕龙钟树，幽谷无人自在花。\n地暖孤鸿来索伴，天空双鹭下通家。\n诗翁快整春风脚，山路霜泥踏马牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵西山","author":"洪咨夔","text":"山深莫道得春迟，云漏晴光已大奇。\n夹径幽香吹艾纳，隔林绝艳点燕支。\n一川远近迷渔屋，两市东西认酒旗。\n锦野着亭坡老后，曾来可惜独无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵夏日","author":"洪咨夔","text":"乍晴云更黑，顿冷日如青。\n饱饭真成蠹，幽居又见萤。\n灯光翻露柱，琴叠舞黄庭。\n猛作逃儒去，沉酣几个醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵夏日","author":"洪咨夔","text":"秧青水白四郊同，召雨无烦访守宫。\n槐叶煮?随市俗，莲花捣曲称家风。\n过从久谢三千客，嬉戏长娱七十翁。\n已是太平农圃老，更揩两眼看升中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高蓼","author":"洪咨夔","text":"隰荭照眼似船窗，只欠沙头野鸭双。\n花引穟垂丹作佩，叶扶节起翠为幢。\n妇收滋味归羹鼎，儿挹馨香赴酒缸。\n老我为渠牵午梦，白蘋风冷钓烟江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曹提管梅","author":"洪咨夔","text":"凌寒峭立向庭除，晋宋渊明汉二疏。\n面冷不堪相妩媚，心清聊为一轩渠。\n月来月去香仍在，春少春多意自如。\n皎洁孤芳谁与共，作诗我欲寄东徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曹提管楚东之作","author":"洪咨夔","text":"萧骚两岸落秋蓬，楚水西流不肯东。\n好酒但须知妇有，新凉莫问与谁同。\n片心置向嚚尘外，万事留将醉眼中。\n喜得建安标格在，何曾诗解使人穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵遣怀","author":"洪咨夔","text":"不用忧春雨，时来百草芳。\n猫头肥可锸，雀舌嫩堪囊。\n旧酒闻香烈，新诗索味长。\n樱桃空落去，吾老白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次缪仲右韵 其二","author":"洪咨夔","text":"窗暖杨花扑，庭空燕子过。\n年侵欢易减，春恼病宜多。\n搅涕论兵事，扶头读凯歌。\n日来能饮未，正好醉亡何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次缪仲右韵 其一","author":"洪咨夔","text":"心绪千丝结，年华一鸟过。\n可人元自少，知己不须多。\n咄咄君休怪，呜呜我亦歌。\n将军浑健在，醉尉莫谁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江陵","author":"洪咨夔","text":"三海先声壮，重城大势连。\n竹为人世界，灯结水因缘。\n风物诗囊里，英雄泪眼边。\n江平洲露碧，沙市稳开船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤泉","author":"洪咨夔","text":"水府燃犀处，扶桑浴日时。\n能观雷复地，始信坎生离。\n净垢元无着，温凉祇自知。\n骊山殷鉴在，莫受阿环缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百合花","author":"洪咨夔","text":"日月飞双毂，如何驻黑头。\n才看敷密友，又见拆彊仇。\n叶聚棱棱峭，花垂娜娜稠。\n晚凉芬烈甚，欲睡更迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老人生朝为寿","author":"洪咨夔","text":"迎侍京华又见春，天时人事一番新。\n丙申儿遇丙申岁，己卯爷逢己卯辰。\n本分法门行得熟，长生样子学来真。\n斑衣奉酒多为寿，满眼光风正可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老人晚得女真真又曾孙女金华皆再周而殇葬塔院后今春焚化用前韵赋诗谨和","author":"洪咨夔","text":"窣波影里诵陀伽，古佛灯笼护绛纱。\n智慧竭罗虽正果，慈悲妙善亦空花。\n怕寒婉娈初拳蕨，望雨醒松细舌茶。\n节物感人还自解，有儿何用女当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老人赋郑医芝隐楼敬次韵","author":"洪咨夔","text":"鹊经心诀在，鸿宝肘方全。\n为问春痟首，何如夏胁肩。\n楼居高进月，园涉细疏泉。\n学得种芝法，疑君今稚川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自和","author":"洪咨夔","text":"得寮便住似西资，谁暇安巢更择枝。\n閤密不妨中酒圣，楼明大好养书痴。\n志公分料存刀尺，庞老家风欠笊篱。\n大厦千间宵八尺，傍人莫笑太穷猗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至节前一日游汪茫田","author":"洪咨夔","text":"圣主亲郊肸蚃通，风恬日霁作春容。\n好从辇路听清跸，却向深山把瘦筇。\n樵子径随萝薜上，道人屋借竹茅封。\n一杯旋煮山泉荡，浣尽平生磊砢胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至节前十日游胜因寺","author":"洪咨夔","text":"霜霁午曦暖，潦收沙路晞。\n束山知寺古，避客怪僧稀。\n箨滑涉危屐，藤钩穿密衣。\n月黄风不动，灯火虹桥归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行三盘蟆颐栈道 其三","author":"洪咨夔","text":"虎爪滩头棹，蟆颐阁上车。\n危机知略似，薄命听何如。\n鸬筏陵飞景，鸠巢架太虚。\n乾坤真一阱，着眼莫踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行三盘蟆颐栈道 其二","author":"洪咨夔","text":"息女頩相问，危途骨欲摧。\n儿知缘底去，耶自为官来。\n野圃榴多子，山田芋有魁。\n乞归吾计决，一粲且传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行三盘蟆颐栈道 其一","author":"洪咨夔","text":"栈险涎鱼蛤，梯危啸虎貙。\n室人交谪我，客子倍愁予。\n后殿推腰上，前行掉臂呼。\n龙眠如得见，写作赴州图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西龙道院","author":"洪咨夔","text":"溪影山光浸晓寒，空庭人马报平安。\n梦回非想天中界，身是无怀国里官。\n桑葚青红鸠澒洞，麦花开落雉蹒跚。\n好班嘉定中兴诏，尽与蓬婆滴博看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观物 其二","author":"洪咨夔","text":"薄命天元定，深居日转长。\n塔铃空洛度，车铎惯琅珰。\n笋长竹还老，莲迟荷自香。\n羡他雏又乳，双燕胜春忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观物 其一","author":"洪咨夔","text":"饱饭茶瓯罢，闲观万物情。\n狗加狮立号，猫冒虎为名。\n故沼慈姑王，新畦腐婢荣。\n蝉从何许变，忽送出林声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遇风出陆金陵道中次程及甫韵","author":"洪咨夔","text":"留滞周南命使然，莫疑上水逆风船。\n乡山故故随人后，客月依依堕我前。\n半夜索樽同决计，五更回柂不成眠。\n笋舆吹面新凉入，须信封姨正自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过四望山","author":"洪咨夔","text":"人远鹭孤立，湖平天四垂。\n柂移船解语，帘舞酒求知。\n望眼倾三笑，骚吟寄九思。\n今宵吾计得，解鳖荐鸱夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯矩同登牛头","author":"洪咨夔","text":"两翼城包险，三分寺占奇。\n市嚣芳草隔，古意落花知。\n岁熟人情乐，时清物态熙。\n江山输眼底，尽是太平诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何正言挽诗","author":"洪咨夔","text":"隽手芥拾紫，忠肝蒲伏青。\n婴龙云气直，缚虎雪毛腥。\n炊枕梦何短，书棺名更馨。\n眇然人物几，墓草涕交零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何正言母安人挽诗","author":"洪咨夔","text":"凤采生丹穴，萤光聚绛帏。\n两登黄甲去，一佩皂囊归。\n萱老悲方切，兰枯梦又非。\n青山秋寂历，客泪不胜挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"洪咨夔","text":"鹤帐华缨绝，牛蹊老屐穿。\n薄晴生晚哢，深绿护馀妍。\n万卷不堪煮，百怀空自煎。\n朱樱黄苦笋，小酌便陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏即事一首谢俞德远惠茶","author":"洪咨夔","text":"病眼昏花懒读书，闭门恬养冉溪愚。\n一帘草色蛤呼伴，四壁树阴鸡护雏。\n已是归来何用引，本无太极不须图。\n小团自汲新泉试，凉满松风石铫炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初酿","author":"洪咨夔","text":"手臼登新秫，头缸试嫩醪。\n蒲城寒信早，栗里旷怀高。\n重熟鱼沾面，微生蟹带糟。\n老侬元不饮，随喜亦陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈同行诸丈","author":"洪咨夔","text":"秋风俱白发，万里锦城官。\n箭贯双雕易，琴随一鹤难。\n国宽同是福，民病独何安。\n前见乖崖老，烦君举似看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿邹茶使 其二","author":"洪咨夔","text":"手挈蓬弧挂井参，筹边楼下瑞云深。\n传将绝学圣贤脉，会得初阳天地心。\n议论文章胸万甲，功名富贵腹三壬。\n春风禁柳东华路，扈驾催行荔子金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿邹茶使 其一","author":"洪咨夔","text":"鹤雁旌旗导紫軿，方瞳秋水照人明。\n泰山可碎胆常定，沧海自浑心转清。\n万事至公如正献，片言不妄即元城。\n擎天正要坚牢柱，长与皇家植太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岑公洞","author":"洪咨夔","text":"洞从开辟有，翁独擅真清。\n磴古苍苔涩，岩空细溜明。\n谁刊新即事，尽剔旧题名。\n太息今犹古，江山不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应提刑招饮北山","author":"洪咨夔","text":"万绿梢头眼，双江合处城。\n山如人有立，水与市俱横。\n啼鸟春风暖，飞花晚照明。\n笙歌推使去，缓屧当车行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李致远母夫人挽诗 其二","author":"洪咨夔","text":"日与夫人子，相随若弟兄。\n羡渠犹有母，使我欲无生。\n未病思求药，方餐念遗羹。\n此情今已矣，泪雨待同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李致远母夫人挽诗 其一","author":"洪咨夔","text":"有子何蕃似，悬知母训贤。\n市赊留客酒，邻贷买书钱。\n苦过莲心后，甜回蔗境边。\n一朝风木憾，谁与问苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杏","author":"洪咨夔","text":"万山筑底作春妍，一树繁红直几钱。\n深院日长来燕后，平池水暖浴鹅天。\n弦歌礼乐诗书地，榜帖功名富贵天。\n儿辈对花须自勉，莫教空恼少陵颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社前一日点检山房用呵字韵","author":"洪咨夔","text":"不论塌扱与娄罗，判却风光屐齿磨。\n老柳强颜翻拓跋，新禽满意奏娑陀。\n山如欲雨何妨住，僧不能禅亦足多。\n须信斯文天未丧，龙蛇虎豹底烦呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花狮","author":"洪咨夔","text":"雪氄吾家虥，知亲翰墨妍。\n渴来趋研饮，饱去枕书眠。\n弄影窥清镜，收声听素弦。\n最能持大体，鼠辈任便儇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谷帘泉","author":"洪咨夔","text":"山椒飞派落寒空，斗水曾收第一功。\n万马铁衣行夜雪，六虬银甲动秋风。\n分甘晚到玉川子，知味早输桑苧翁。\n手弄潺湲坐盘石，苍凉新月上孤桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎秋","author":"洪咨夔","text":"热不能堪又便秋，天公底暇与人谋。\n形容如许马非马，气力几何牛戴牛。\n勃勃松梢云片起，琤琤藕叶雨声留。\n新凉收拾归歌板，钿合金钗万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居","author":"洪咨夔","text":"暑设青綀幕，晴更皂葛巾。\n家贫犹气象，人老亦精神。\n蜂闹花生计，蛾翾茧化身。\n静中观物变，同是一天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侄寿叔祖","author":"洪咨夔","text":"鹊噪梅梢喜报晴，催开几叶砌边蓂。\n和薰爱日如春日，光动文星映寿星。\n宾客称觞应满座，儿孙戏綵自盈庭。\n萱堂幸继芝兰末，仰祝百千龟鹤龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和礼灭翁感钱氏旧事","author":"洪咨夔","text":"民不知兵物自华，表忠消得老碑誇。\n虎符龙节故王国，凤舞鸾飞今帝家。\n遗庙断垣低槲叶，荒村旧井湿桐花。\n冯夷尚怕潮头弩，一望西兴渡口沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和何伯温见寄 其二","author":"洪咨夔","text":"青山流水晓葱胧，读遍黄庭万境空。\n羔瓮无缘浇舌本，貘屏有分护头风。\n人谋历历既未济，民力班班大小东。\n陶写此怀须好句，殷勤时与寄来鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和何伯温见寄 其一","author":"洪咨夔","text":"问字无人过草堂，昨非今是两俱忘。\n鹤何肮脏寒方警，梅许凄凉静更香。\n万古江山穷太白，一帘风月老张苍。\n多君不作炎凉语，识我平生铁石肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和何特夫见寄","author":"洪咨夔","text":"人从万里蜀天归，御柳藏鸦絮又飞。\n风细炉熏摇穗直，日长漏箭出花稀。\n九重旰食图无逸，四塞宵征赋采薇。\n爱国书生心更苦，夜占列象候璿玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虞仲易送行 其二","author":"洪咨夔","text":"岁月双蓬鬓，风沙一老兵。\n气惟凭义养，命不与穷争。\n鼎正中边沸，船须左右平。\n半筹无可画，空赋洗兵行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和虞仲易送行 其一","author":"洪咨夔","text":"霜晓沧江路，梅花对此君。\n清明涵止水，变灭送浮云。\n论事强人意，挥毫张我军。\n雍公衣钵在，好策后来勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和雪","author":"洪咨夔","text":"肃容盛气下璇霄，不作投壶玉女娇。\n坡老堂前微扑面，伊川门外骤齐腰。\n得风还解掀天起，带雨才能控地飘。\n无限陈根生意动，早看绿长后园蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄伯渊见寄 其二","author":"洪咨夔","text":"锦野西头始识君，便期垩鼻着风斤。\n馀甘到底有遗味，薝卜本来无异芬。\n忽忽又弦凉榭月，亭亭还合暮山云。\n玉泉道士穷于我，也买新鹅约右军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄伯渊见寄 其一","author":"洪咨夔","text":"流转风光不暂违，等无地角与天涯。\n故人书到几青李，生面客来时紫芝。\n穷里埋头倾哑酒，凉边趁手应盲棋。\n寂寥简短君应笑，郎罢吟诗囝和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]