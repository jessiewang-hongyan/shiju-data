[{"title":"送吴子明知阆州","author":"袁说友","text":"圣主方勤西顾忧，大朝临遣遴贤侯。\n兰香昔在潜郎地，符竹今分古阆州。\n蜀道难时虽万里，汉川佳处正三秋。\n莫嗟身落江湖远，魏阙心存记子牟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送诚斋二首 其二","author":"袁说友","text":"长裾端欲曳宾墀，人事何乖遽别离。\n未尽胸中怀旧意，又吟江上送行诗。\n公名此去如山重，我老谁怜似足踦。\n凭得征鸿寄消息，书来犹记别君时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送诚斋二首 其一","author":"袁说友","text":"谁作朝阳一凤鸣，公朝今复叹斯人。\n抗章宁夺三军帅，去国尤轻一叶身。\n政以青蒲姑夕驻，更闻白简为前陈。\n只今小试回天力，它日擎天看柱臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送柯伯东省试","author":"袁说友","text":"道义如君只几人，相从了不见尘侵。\n一樽但觉论文细，三画从知得意深。\n自是强年应折桂，不妨期月早传音。\n我今已办如椽笔，拟称琼林最后吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送资深知潼川府","author":"袁说友","text":"昔日班行忆旧游，天涯今已说离愁。\n珠玑咳唾频倾倒，风月江山几倡酬。\n三接自应还北阙，一麾犹欲惠东州。\n与君久赋莼鲈约，更约同登竹笮舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送彭世昌山台小饮","author":"袁说友","text":"象山只在水西头，云木犹高瀑更流。\n往事何能话师友，时情徒与惜交游。\n东风又绿溪边草，明月还归天际舟。\n白发苍颜吾亦老，一尊台上洗春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送惠老往住上方","author":"袁说友","text":"又作西山去，潮音鼓一通。\n丛林推此老，诗社得诸公。\n著眼浮生外，冲风逆水中。\n殷勤三请已，此意不雷同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送惠县丞之官","author":"袁说友","text":"立之何事屈蓝田，隐忍功名古已然。\n预信鹓鸿只他日，莫嫌凫鹜尚频年。\n征帆夜湿三更雨，去路人欣八月天。\n话别匆匆毋重惜，一封丹诏下天边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送惠补之昆仲秋试","author":"袁说友","text":"斑斑兰玉不胜清，长羡于门久日荣。\n共庆两苏离蜀道，从今二宋到神京。\n三年刻楮真馀事，一日乘槎定策名。\n想得颐山来岁好，绿袍黄里照溪明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送楼攻愧知婺州二首 其二","author":"袁说友","text":"三十年间企绝尘，久同朝迹话平生。\n论文密处虽朋友，投分深时即弟兄。\n自恨我无分袂语，但输君已著鞭行。\n东阳一苇杭之便，毋惜公馀蚤寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送楼攻愧知婺州二首 其一","author":"袁说友","text":"壮年才气压词场，众已相期白玉堂。\n垣制孰非经大手，斯文无复数他杨。\n诸公政尔需调鼎，一语翻然忽抗章。\n汲黯固知当大用，得君徒欲重淮阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送聘儒侄秋试","author":"袁说友","text":"八月灵槎万里秋，乘风得隽要遨头。\n吾家连已跻儒级，汝业今宜济巨舟。\n掘井莫令嗟九仞，善刀终自见全牛。\n儒冠岂解真相误，有志应当万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送薛公叔秋试","author":"袁说友","text":"流落相逢霅水滨，与君倾盖即平生。\n湖山十里双溪畔，宾主三年一日情。\n学海波澜誇健笔，夜窗灯火几长檠。\n不堪送客杭州路，更听惊人快一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顺风至采石","author":"袁说友","text":"快哉真得楚王风，钲鼓喧江四面雄。\n但欲帆樯催上水，敢辞井路傍西戎。\n江空岁晚飞烟外，人静霜明过浪中。\n少泊山腰羌笛断，一樽那肯为诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏至日雨","author":"袁说友","text":"烟暝千岩木，溪明一带楼。\n片云封旧恨，急雨罥新愁。\n节又匆匆过，诗从轧轧抽。\n病躯无耐暑，老鬓不禁秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴许成子魏华文二魁吴文伯节判陈表之教授卢仲修军资以考西省试同集","author":"袁说友","text":"昼绣归来自帝京，魁星双照锦官城。\n持衡称职真能事，劝驾何功亦与荣。\n细与论文重款接，要看落笔更纵横。\n我归便作江湖计，试目需君辅太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家信报仲子目疾已平用前韵","author":"袁说友","text":"岘也平安久，书云传遽迟。\n意宽千里远，归更一旬期。\n眼过无非景，身閒足可诗。\n江湖终欲老，鸥鸟已先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"展扫先茔","author":"袁说友","text":"寂寞千松老，萦纡一水通。\n重来惊鬓雪，遗恨满春风。\n拱木人何在，伤心泪已穷。\n羁怀不成寐，月落半山空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"展扫先茔省伯氏用前韵","author":"袁说友","text":"久作弟兄别，相看笑语通。\n寒窗酬酒夜，落月对床风。\n志得宁论晚，名高不畏穷。\n君看天下事，一一漫彫空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和御制赐进士诗韵二首 其二","author":"袁说友","text":"尧言不数汉文章，漫说唐人万丈光。\n百辟共知尊上指，群儒何止戴言扬。\n丝纶甫幸来中禁，琬琰俄欣奏上方。\n京邑小臣观盛事，愿输忠悃赞明康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和御制赐进士诗韵二首 其一","author":"袁说友","text":"云汉昭回下建章，鸾翔凤翥灿龙光。\n宸奎错落皆谟训，圣语丁宁示抑扬。\n自古求言开数路，只今兼听极群方。\n一篇默寓忧勤意，正为成王不敢康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扇画雪景","author":"袁说友","text":"杖屦祁寒里，林峦幻景同。\n生绡明月影，淡墨老霜丛。\n点染三冬雪，招邀六月风。\n呼童小挥手，残吹袭帘栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂椿堂","author":"袁说友","text":"欈李于门伯仲佳，声名籍籍到天涯。\n一经早已传韦氏，五桂今重说窦家。\n满眼衣冠真盛事，几年棠棣看联华。\n兰台曷与编青史，要使文风万世誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"袁说友","text":"江行了不按春光，江路欣看得海棠。\n浅蘸深红丛蓓蕾，细开浓白巧梳妆。\n蜀花但斗胭脂湿，荆种新傅腻粉香。\n行客纷纷正寥落，为渠著语快飞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫子章惠蒲萄","author":"袁说友","text":"惯病宜秋早，分甘荷岁寒。\n骊珠初压架，马乳又堆盘。\n酒美誇重醒，书成欠百端。\n不须烦广利，移种眩长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢德华郎中将漕福建","author":"袁说友","text":"畴昔相从在帝关，更于岁晚接清班。\n同朝所恨常疏阔，一岁之中几往还。\n便合横翔来楚路，未应清梦落闽山。\n谁将好雪留征棹，毋疾其驱有诏颁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"被旨往许浦阅兵风雨中舟过梅里","author":"袁说友","text":"浓云障日卧前山，已觉林深寸步难。\n风雨于人本无意，筋骸如我不禁寒。\n小窗饱听喧江浪，萧寺时惊落岸滩。\n慨念兴亡千古事，夜阑相对说江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"袁说友","text":"宦牒刚驰逐，篇章半扫除。\n稍寻无事日，重理旧诗书。\n笔砚寒灯寂，轩窗昼景舒。\n政须堂下问，糟粕意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阅兵给赉","author":"袁说友","text":"小臣衔命入云屯，圣主如天诏语温。\n万甲冲风隆士气，一言挟纩荷君恩。\n颇惊霹雳烧残垒，更想蒙冲上海门。\n欲挽长江问豪杰，岂无击楫叹中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高庙灾董仲舒推说其意稿未上主父偃候仲舒私见嫉之窃其书而奏焉上召视诸儒吕步舒以为大愚下仲舒吏当死诏赦之","author":"袁说友","text":"老学推占后，奸人娼嫉初。\n怀私真诡计，候见窃成书。\n猛欲挤贤辙，宁思戒覆车。\n那知一回首，身已毙诛锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"袁说友","text":"老眼慵开阖，閒窗独欠伸。\n梦残亭过午，漏永箭浮申。\n黄卷卷舒足，黑甜滋味真。\n生涯惟一枕，百虑不关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李兼善","author":"袁说友","text":"湖山昔日记清游，百遍相过语未休。\n远迩漫劳人室念，东西空望浙江流。\n中年别去情尤恶，幅纸书来意转愁。\n岁晚渐于诗兴好，待君归后饱赓酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常通判惠虞美人花亦名双鱼儿花","author":"袁说友","text":"好景无穷巷，名园有异姿。\n春今十分好，花又一番奇。\n比目红绡结，双鱼碧玉枝。\n孤窗还遣伴，空忆美人词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜春","author":"袁说友","text":"不缘雨雪不缘风，九十风光半已穷。\n袅娜熟眠杨柳绿，夭娆浓醉海棠红。\n客怀不直韶光好，诗兴犹因景物雄。\n投分东君未应薄，乞花偿酒强迎逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春过雨","author":"袁说友","text":"酒恶病成恼，春深愁转加。\n园林三月事，风雨一庭花。\n燕幕自相语，蜂屯争趁衙。\n傍栏迎霁色，溪上几人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅雨踰月始晴甫两日复大雨","author":"袁说友","text":"猛作连朝雨，愁添一尺溪。\n颓云惊满坐，涨水急平堤。\n泽国几成壑，田家未半犁。\n关心独朝暮，刚认勃姑啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨花","author":"袁说友","text":"东风日日点征衣，野阔林疏四望奇。\n景物剩供行客眼，梨花更索老夫诗。\n登山趁得春三月，带月犹看雪一枝。\n七日崎岖三百里，倡条冶叶故相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清晖阁","author":"袁说友","text":"清晖杰阁几朝昏，吟咏曾喧白下门。\n一别朱栏陪绮席，重来青草接荒村。\n名章尚忆江秋句，短些谁招月夜魂。\n老去情怀更萧瑟，懒从孤馆觅清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨于保福寺是日大雨至","author":"袁说友","text":"常旸为虐势流金，稽首长松幸屈临。\n一佛等慈清苦海，众生度厄浴甘霖。\n沛然而下期中熟，可以无饥免大祲。\n好雨㥄人愁抱释，退思畴昔尚熏心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒洪泽镇龙祠","author":"袁说友","text":"平生忠孝彻幽冥，稽首龙祠鉴此诚。\n自是皇灵频震叠，也知神力解因成。\n片帆以往无多路，百里之间只一程。\n目断长淮嗟往事，孤哀有泪落边城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铜铁堆","author":"袁说友","text":"千峰插碧绕江面，两石中分铜铁堆。\n东岫附庸方崒嵂，西山俨立更崔嵬。\n悬知造物精神巧，几误良工斧凿来。\n万里西舟今蜀境，安流到此莫辞杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿鸣宴","author":"袁说友","text":"秋影涵江暇日长，银袍济济宴公堂。\n九华佳气眉间色，千佛高名马上郎。\n剩数连珠誇瑞应，会看仙桂满枝芳。\n春风得意归来好，衣锦联镳入故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雪","author":"袁说友","text":"玉龙方急战寒声，满阵江风雪作茵。\n准拟丰年须造物，编排佳境付诗人。\n莫辞樽酒偏劳劝，更喜江梅欲斗新。\n愧我为州无善状，杨花何事已先春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴","author":"袁说友","text":"梦断窗全曙，儿童竞报晴。\n层云擘轻絮，飞鹊噪新声。\n一水长天静，双溪万橹鸣。\n傍檐聊觅句，乐处漫蝇营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴放海棠","author":"袁说友","text":"春日海棠早，媚云开远岚。\n醉容犹未足，睡态已微酣。\n嫩绿千枝衬，殷红一点含。\n东君真有助，落笔为渠谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惠相之惠顾渚芽答以建茗","author":"袁说友","text":"一室环三径，诸郎读五车。\n山高空锁翠，涧阔自流花。\n辍我闽山焙，酬君顾渚芽。\n书来惊岁晚，老去各天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景山寺古鼎","author":"袁说友","text":"小憩山前路，清谈得道僧。\n爱渠惟一鼎，持此供三乘。\n制作前无古，摩挲喜不胜。\n兹游真可乐，著句忆吾曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑夜得月","author":"袁说友","text":"风搅桐声碎，蝼鸣鼓吹长。\n半山蟾吐影，一水鉴浮光。\n冷碧迎秋色，清飙借久凉。\n不堪鸡唱晓，归枕报朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑雨","author":"袁说友","text":"猎猎蒲攲岸，斑斑藓渍墙。\n檐低泣蛛网，叶落溅蜂房。\n西嶂暮凝色，北窗新送凉。\n晚来池上过，风擘藕花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"植花于假山","author":"袁说友","text":"岩石棱棱巧，盆池浅浅开。\n空山初幻化，方丈小飞来。\n屈曲清泉溜，参差细草栽。\n只今山在眼，著眼便徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游扬子云墨池","author":"袁说友","text":"平堤修柏转林塘，飞盖同升吐凤堂。\n后世有传由准易，斯文无复数他扬。\n草玄大启天人奥，池色犹关翰墨场。\n吊古怀贤尚遗恨，不然晁董可相颃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游江渎庙用故侯吴龙图韵","author":"袁说友","text":"马嘶杨柳泊林塘，六月城南趁晓凉。\n万古丛祠千木暗，五风十雨一炉香。\n翚飞栋宇新轮奂，鼓奏牺牲荐豆觞。\n努力为民祈福地，年丰今已格阴阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武昌东湖","author":"袁说友","text":"只说西湖在帝都，武昌新又说东湖。\n一围烟浪六十里，几队寒鸥千百雏。\n野木迢迢遮去雁，渔舟点点映飞乌。\n如何不作钱塘景，要与江城作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游金焦二山至汲江亭用前韵","author":"袁说友","text":"江山万里忆徐州，十月迎风度小舟。\n极目不知天外景，乱云遥接水中丘。\n此身五十昔未到，著语再三今可酬。\n欲把边尘聊一洗，只今更吸大江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游清凉寺逢说命者傅会云帅垣星照西方","author":"袁说友","text":"奔走才千里，辛勤说五行。\n星躔初下照，君命趣东征。\n万壑乾坤注，千艘日夜横。\n江山看不暇，此役快平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游慈感寺用壁间赵安石韵","author":"袁说友","text":"薄俗冷还暖，馀年春复秋。\n诗穷无限意，身老半生愁。\n饱睡书慵展，居閒客强留。\n功名羞镜里，白发奈盈头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登屋后城","author":"袁说友","text":"笑傲愁如失，登临酒半醒。\n故将双眼碧，割断半山青。\n土沃差宜竹，城高未著亭。\n可人东郭外，绡翠舞娉婷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登第一山","author":"袁说友","text":"极目俄登最上岩，秋风衰草塞云閒。\n漫游江浙几千里，今识东南第一山。\n志士逢时宁恨晚，壮怀有泪不须潸。\n兴亡自古知多少，天道何曾不好还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登蓬莱閤","author":"袁说友","text":"痴儿官事苦相临，每到蓬莱慰赏心。\n一水萦湖连海去，片云带雨入山深。\n自怜老客从渠晚，喜有诗翁到此寻。\n中外升沉政悬绝，强抽荒思续高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊雪二首 其二","author":"袁说友","text":"无计遮留岁月残，颇惊节物愧才悭。\n可人腊雪偏宜处，屈指春风未到间。\n犹得微吟供午枕，不须高卧闭晨关。\n晚来碎玉零珠后，已老苏州一半山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊雪二首 其一","author":"袁说友","text":"岁事无多腊近残，谢渠飞屑破天悭。\n褥祠空愧兼旬力，造物惟消一夜间。\n是则化工端有意，要于官政亦相关。\n雪催诗后诗催雪，更欲堆盐满四山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢吴斗南教授惠贡茶","author":"袁说友","text":"我愧周行久，君方戴席重。\n一缄驰素茧，五玉卧乌龙。\n滴雪浮瓯浅，濡香过齿浓。\n欲酬新句好，官事正填胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢李兼善书库寄近作","author":"袁说友","text":"笔下陈无己，香分一瓣奇。\n有孙今见嫡，得髓政忘皮。\n怀旧书来日，惊人语妙时。\n犹思频咀嚼，咽子百篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢侃老惠乳糕","author":"袁说友","text":"多病柘浆酒，閒愁梅雨天。\n婆娑清梦断，剥啄好音传。\n怜我齑盐薄，从渠乳酪鲜。\n莫嗟闻道晚，著意问师禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢周唐卿分惠宣梨二首 其二","author":"袁说友","text":"澹澹夕阳远，行秋塞雁高。\n卷舒连夜烛，长短几檠膏。\n贫岂嗟悬磬，家犹及卖刀。\n藜肠惯羞涩，更觉近来饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢周唐卿分惠宣梨二首 其一","author":"袁说友","text":"啄木门初扣，分甘味占高。\n风标誇饤坐，津润忆流膏。\n剩受千梨户，宁辞五藏刀。\n一杯须领意，老欲为渠饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]