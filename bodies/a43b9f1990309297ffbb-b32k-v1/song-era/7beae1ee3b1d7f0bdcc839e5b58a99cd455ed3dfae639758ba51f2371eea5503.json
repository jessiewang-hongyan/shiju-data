[{"title":"送刘惠卿二首 其二","author":"杨万里","text":"旧病诗狂与酒狂，新来泉石又膏肓。\n不医则是医还是，更问无方定有方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘惠卿二首 其一","author":"杨万里","text":"活却千人药一囊，阴功吹作满城香。\n灵椿丹桂君家有，莫羡燕山窦十郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠阁皂山懒云道士诗客张惟深二首 其二","author":"杨万里","text":"羽客来从阁皂山，殷勤告诉病诗癫。\n古今此病元无药，癫到阴何便是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠阁皂山懒云道士诗客张惟深二首 其一","author":"杨万里","text":"阁皂峰头半朵云，化为道士到吾门。\n问渠真个如云懒，为许随风处处村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士蓑衣道人杜需二首 其二","author":"杨万里","text":"坐来小歇过眉拄，客里那能满眼酤。\n肯脱蓑衣借侬著，鸥边雨外且江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士蓑衣道人杜需二首 其一","author":"杨万里","text":"与子生疏有底仇，谈间容易说封侯。\n病身更遣冰山倚，野鹤孤云也替愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠剪字吴道人","author":"杨万里","text":"宝晋云烟杂海涛，玉溪花月写风骚。\n一生不倩毛锥子，只倩并州快剪刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠曾相士二首 其二","author":"杨万里","text":"抛了儒书读相书，却将冷眼看诸儒。\n曾生肯伴诚斋否，共个渔舟入五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠曾相士二首 其一","author":"杨万里","text":"富贵真成一聚尘，饥寒选得万年名。\n心知那有扬州鹤，更问侬当作么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壕上","author":"杨万里","text":"壕上朝来眼顿明，小风浅水写秋清。\n新霜杀尽浮萍草，放出靴纹水面生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壕上书事","author":"杨万里","text":"十里长壕展碧漪，波痕只去不曾归。\n鹭鸶已饱浑无干，独立朝阳理雪衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"檐滴","author":"杨万里","text":"檐滴疏疏亦几何，滴将苔砌出圜窠。\n就中漱涤偏精巧，泥土都无石子多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藏船屋二首 其二","author":"杨万里","text":"非港非沟别一涯，茅檐元不是人家。\n不居黔首居青雀，动地风涛不到它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藏船屋二首 其一","author":"杨万里","text":"望见官旗衔舳舻，渔船争入沼中芦。\n藏船芦底犹有雨，屋底藏船雨也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏青","author":"杨万里","text":"雨换溪溪玉，花呈岭岭春。\n秧田暄处早，茅屋补痕新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜","author":"杨万里","text":"天欲吹霜不作难，连宵也费许多寒。\n新装琼甲为蔬甲，仍化朱栏作玉栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜夜","author":"杨万里","text":"月影全无只有星，如何夜色照人清。\n素娥未必饶青女，不道霜明胜月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜夜无睡闻画角孤雁二首 其二","author":"杨万里","text":"梅边玉琯月边横，吹落银河与晓星。\n城里万家都睡著，孤鸿叫我起来听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜夜无睡闻画角孤雁二首 其一","author":"杨万里","text":"画角声从枕底鸣，愁霜怨月不堪听。\n拥紬起坐何人伴，只有残灯半晕青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜夜望月","author":"杨万里","text":"人静蛩喧天欲霜，不眠独自步风廊。\n闲看月走仍云走，知是云忙复月忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜草","author":"杨万里","text":"霜前乱碧未全枯，霜后纷黄却更苏。\n偷吃瑶台青女粉，都生琼发与银须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜晓","author":"杨万里","text":"霜重晓未觉，日高融始寒。\n空墙半根湿，落叶片声乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜晓","author":"杨万里","text":"荒荒瘦日作秋晖，稍稍微暄破晓霏。\n只有江枫偏得意，夜挼霜水染红衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翻破箧得张钦夫唱和诗","author":"杨万里","text":"年年不是不吟诗，吟得诗成寄阿谁。\n留取朱弦不须断，只将瑶匣锁蛛丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衢州近城果园","author":"杨万里","text":"未到衢州五里时，果林一望蔽江湄。\n黄柑绿橘深红柿，树树无风缒脱枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑改元开禧元日","author":"杨万里","text":"开禧元祀更元正，宿雨新收放晓晴。\n夜半梅花添一岁，梦中爆竹报残更。\n方知人喜天亦喜，作么钟鸣鸡未鸣。\n老子年龄君莫问，屠苏饮了更无兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯春日三三径行散有感","author":"杨万里","text":"东园一日走千巡，又见龙飞第一春。\n桃李成阴侬已老，江山依旧岁还新。\n穿花踏影浑无日，隔径闻声不见人。\n学省同寮各星散，白云珍重伴闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙未和杨谨仲教授春兴","author":"杨万里","text":"归欤还复换年芳，不分官梅恼石肠。\n黄帽政堪供短棹，白头可更献长杨。\n忽逢社里催搜句，安得花边对举觞。\n天上含香有知己，弹冠端复为王阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙酉社日偶题","author":"杨万里","text":"愁边节里两相关，茶罢呼儿检历看。\n社日雨多晴较少，春风晚暖晓犹寒。\n也思散策郊行去，其奈缘溪路未乾。\n绿暗红明非我事，且寻野蕨作蔬盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕后一夜月中露坐二首 其二","author":"杨万里","text":"今古诗人爱月圆，未堪商略玉婵娟。\n脩眉半璧各自好，团镜磨镰俱可怜。\n一夜一般新样出，几回几换为人妍。\n教渠也学金鸦扇，未必清光直一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕后一夜月中露坐二首 其一","author":"杨万里","text":"火云散作郁金云，檐际移床偃病身。\n古井石崖新汲水，花洲苔砌荡晴尘。\n风才小动即停吹，竹自不凉那及人。\n独感今宵上弦月，桂梢分露滴纱巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七字敬饯周彦敷府判直阁之官虎城","author":"杨万里","text":"碧落仙人出作州，青原诗伯佐承流。\n江山得助催新句，风月平分入胜游。\n清献濂溪两宾主，崆峒章贡再赓酬。\n旧时绿水红莲客，南望旗幢鬓已秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七字谢绍兴帅丘宗卿惠杨梅二首 其二","author":"杨万里","text":"越绝诸杨盛一时，与侬瓜葛不曾知。\n老夫自笑吾衰矣，此客何从梦见之。\n也解过江寻德祖，政缘作尹是丘迟。\n渠伊不是南村派，未分先驱事荔支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七字谢绍兴帅丘宗卿惠杨梅二首 其一","author":"杨万里","text":"梅出稽山世少双，情知风味胜他杨。\n玉肌半醉红生粟，墨晕微深染紫裳。\n火齐堆盘珠径寸，醴泉绕齿柘为浆。\n故人解寄吾家果，未变蓬莱阁下香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日即事呈尤延之","author":"杨万里","text":"昨日茱萸未苦香，今朝篱菊顿然黄。\n浮英泛蕊多多著，旧酒新醅细细尝。\n节里且追千载事，鬓边管得几茎霜。\n正冠落帽都儿态，自笑狂夫老不狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日都下黄雀食新","author":"杨万里","text":"九日新霜薄，群飞一网遮。\n裘披杨柳絮，色染木犀花。\n下箸欣乡味，知侬忆故家。\n金杯浮菊蕊，相映两光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月一日夜宿盈川市","author":"杨万里","text":"下滩一日抵三程，到得盈川也发更。\n两岸渔樵稍灯火，满江风露更波声。\n病身只合山间老，半世长怀客里情。\n西畔大星如玉李，伴人不睡向人明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日菊未花","author":"杨万里","text":"旧说黄杨厄闰年，今年并厄菊花天。\n但挼青蕊浮新酒，何必黄金铸小钱。\n半醉嚼香霜月底，一枝却老鬓丝边。\n阿谁会得开迟意，暗展重阳十月前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十三日谒西庙早起","author":"杨万里","text":"起来洗面更焚香，粥罢东窗未肯光。\n古语旧传春夜短，漏声新觉五更长。\n近来事事都无味，老去波波有底忙。\n还忆山居桃李晓，酴醾为枕睡为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月望日递宿南宫和尤延之右司郎署疏竹之韵","author":"杨万里","text":"此君见我眼犹青，笑我吟髭雪点成。\n忆昔与君同舍日，听渠将雨作秋声。\n夜来递宿三更悄，叶底春寒一倍生。\n梦入故园数新笋，穿篱破藓几茎茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入弋阳界道旁两石山一曰芦山绝妙一曰石人峰次焉上有一石起立如人形云","author":"杨万里","text":"一色将苍玉，双堆作假山。\n峰峦妙天下，花草半岩间。\n旧瘦天风骨，新晞雨髻鬟。\n何人缘底恨，化石立孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入玉山七里头","author":"杨万里","text":"诸村不雨数旬馀，此地濒江万宝苏。\n晚紫豆花初总角，早黄稻穗已长须。\n回头金步野径远，当面玉山秋塔孤。\n偶见年时解船处，客愁依旧挂菰蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入建平界二首 其二","author":"杨万里","text":"一岁升平在一收，今年田父又无愁。\n接天稻穗黄娇日，照水蓼花红滴秋。\n风有炎凉才顷刻，雨无朝暮政滂流。\n浪言出却金陵界，入却庐陵界始休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入建平界二首 其一","author":"杨万里","text":"溧水南头接建平，丫头儿子便勤耕。\n疏麻大豆已前辈，荞麦晚菘初后生。\n席卷千山为一囿，天怜春种赐秋成。\n不如老圃今真个，樊子何曾透圣扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入浮梁界","author":"杨万里","text":"湿日云间淡，晴峰雨后鲜。\n水吞堤柳膝，麦到野童肩。\n沤漩嬉浮叶，炊烟倒入船。\n顺流风更顺，只道不双全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入溧水界阅堠子","author":"杨万里","text":"才入溧水界，休教勤吏民。\n是谁差堠子，久立待车尘。\n苔藓今仍古，风霜秋复春。\n不知双与只，迎送几行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月朔晓起趣办行李","author":"杨万里","text":"雨后晨先起，花间湿也行。\n破除婪尾暑，领略打头清。\n蠹果无迟落，枯枝忽再荣。\n便须秣吾马，及此半阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月朔早起","author":"杨万里","text":"抛笏投簪四见秋，宦情世味两俱休。\n尘随日影穿窗喜，叶卷风声刮地愁。\n文武自匀香底火，圣贤教带老时篘。\n夜来富贵非人世，梦钓沧浪雪满舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十一日迎春","author":"杨万里","text":"星淡孤萤月一梳，迎春早起正愁予。\n土牛只解催人老，春气自来何事渠。\n官柳野梅残雪后，金幡玉胜晓光初。\n却思归跨春山犊，茧栗仍将挂汉书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十七日立春夜不寐","author":"杨万里","text":"冬夜嫌长只望春，春宵又永更何言。\n睫梢强合终无睡，脚底相摩也不温。\n竟夕松风听到晓，忽明灯火看来昏。\n拥裯却起蒙头坐，顾影真成一病猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十五日明发石口遇顺风","author":"杨万里","text":"溯流浅水刺楼船，百棹千篙祇不前。\n一夜波声喧到晓，北风气力欲翻天。\n挂帆未了青泥过，转眼相将玉笥边。\n无数小舟俱在后，追侬不及指为仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日夜再同子文巨济李叔粲南溪步月","author":"杨万里","text":"际晚溪游暮欲归，追凉逐胜却成迟。\n月如醉眼生红晕，山作愁眉带淡姿。\n天下无人闲似我，秋边有句说从谁。\n弟兄一再更相送，行到更深笑不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月久雨妨农收二十八日得霜遂晴喜而赋之","author":"杨万里","text":"雨脚麻相似，禾头耳欲生。\n风收白痴雾，霜作上牢晴。\n逗晓双栖鹊，巡檐数喜声。\n呼儿洗尘甑，忍饿待新粳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和见喜病间","author":"杨万里","text":"初病杨花犹乱飞，即今梅子已黄稀。\n卧惊节物遽如许，起得沉绵更解肥。\n云寺耶溪招布袜，斜风细雨欠蓑衣。\n半生不结脩门梦，只梦家山唤早归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和春雨","author":"杨万里","text":"向来一旱鬓成丝，敢道新年雨脚垂。\n未必催诗真强管，端令学稼失愁思。\n只今且莫倾三峡，此后时须示一犁。\n未爱少陵红湿句，可人却是道知时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又追和功父病起寄谢之韵","author":"杨万里","text":"霜何曾傍绣帘寒，酒不能令客脸丹。\n勤向竹炉温手脚，懒寻铜镜正衣冠。\n无人孤坐月将落，拥鼻清吟夜向阑。\n忽忆约斋诗债在，自吹灯火起来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又跋东坡太白瀑布诗示开先序禅师","author":"杨万里","text":"东坡太白两诗翁，诗到庐山笔更锋。\n倒挂银河分一派，擘开玉峡出双龙。\n天孙织锦机全别，仙子裁云手自缝。\n界破青山安用洗，涴它瀑布却愁侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又题郑店立春后一日","author":"杨万里","text":"石壁仍丛竹，江亭更小楼。\n滩声清客梦，灯影动诗愁。\n春日已虚过，元宵看又休。\n谁令不行乐，蹙破两眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月一日过摩舍那滩阻雨泊清溪镇二首 其二","author":"杨万里","text":"过尽危滩百不堪，忽惊绝壁翠巉巉。\n倒垂不死千年树，下拂奔流万丈潭。\n隔岸数峰如笔格，倚天一色染春蓝。\n真阳此去无多子，到日应逢三月三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月一日过摩舍那滩阻雨泊清溪镇二首 其一","author":"杨万里","text":"一声霹雳霁光收，急泊荒茅野渡头。\n摩舍那滩冲石过，曼陀罗影漾江流。\n山才入眼云遮断，船欲追程雨见留。\n夜宿清溪望清远，举头不见隔英州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十六殿试进士待罪集英殿门二首 其二","author":"杨万里","text":"九虎遮藏造化机，御题过午始闻知。\n乾坤阖辟兼文武，云汉昭回具训词。\n武帝上嘉真戏耳，放勋清问政如斯。\n诸儒莫作公孙子，千载何曾遇圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十六殿试进士待罪集英殿门二首 其一","author":"杨万里","text":"金戺瑶阶日月边，晓风花柳带非烟。\n千官剑佩鸣双阙，万国英豪到九天。\n玉座忽临黄伞正，御题初出紫衣传。\n小臣何幸陪诸老，待罪重来十六年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三花斛三首 其二 水仙","author":"杨万里","text":"生来体弱不禁风，匹似蘋花较小丰。\n脑子醲薰众香国，江妃寒损水精宫。\n银台金盏谈何俗，矾弟梅兄品未公。\n寄语金华老仙伯，凌波仙子更凌空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三花斛三首 其三 兰花","author":"杨万里","text":"雪径偷开浅碧花，冰根乱吐小红芽。\n生无桃李春风面，名在山林处士家。\n政坐国香到朝市，不容霜节老云霞。\n江蓠圃蕙非吾耦，付与骚人定等差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三花斛三首 其一 瑞香","author":"杨万里","text":"侵雪开花雪不侵，开时色浅未开深。\n碧团栾里笋成束，紫蓓蕾中香满襟。\n别派近传庐阜顶，孤芳元自洞庭心。\n诗人自有薰笼锦，不用衣篝炷水沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳前一日欲雨复晴","author":"杨万里","text":"去年上巳政南来，明日初三忽又催。\n雨压云头浑欲落，风翻日脚急吹开。\n莫因岭外无花卉，便对春光废酒杯。\n只拣茂林脩竹处，兰亭禊事足追回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳寒食同日后圃行散","author":"杨万里","text":"百五重三并一朝，风光不怕不娇饶。\n鹿葱引道心犹卷，杨柳应门手对招。\n筇未唤随非是强，扇聊作伴不须摇。\n先生道是无歌舞，花劝莺酬酒自销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元前大雪即晴","author":"杨万里","text":"腊前三白已奇绝，年后六花仍作团。\n才定忽斜偏有思，欲消还冻不胜寒。\n且留大地万银屋，要伴青天孤玉盘。\n今岁上元君记取，红灯白月雪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]