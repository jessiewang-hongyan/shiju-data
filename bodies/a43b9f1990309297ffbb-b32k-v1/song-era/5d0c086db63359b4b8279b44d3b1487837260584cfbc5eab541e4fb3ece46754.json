[{"title":"春词 其五","author":"谢逸","text":"院落帘垂春日长，嫩晴天气牡丹香。\n细看玉面天然白，不及姚家宫样黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春词 其六","author":"谢逸","text":"门前杨柳暗沙汀，雨湿东风未放晴。\n点点落花春事晚，青青芳草暮愁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南 其一","author":"谢逸","text":"院落轻寒犹侧侧，园林黄鸟未交交。\n韶光幸自无人觉，谁遣东风染柳梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南 其二","author":"谢逸","text":"长恐归时已闭关，西坛虽好敢盘桓。\n可怜月夜杉松影，输与沙鸥野鹤看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和饶正叔碧桃绝句","author":"谢逸","text":"未折香枝插鬓鸦，月和疏影上檐牙。\n诗人莫作夭桃看，不是玄都观里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梨花已谢戏作二诗伤之 其一","author":"谢逸","text":"冷香消尽晚风吹，脉脉无言对落晖。\n旧日郭西千树雪，今随蝴蝶作团飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梨花已谢戏作二诗伤之 其二","author":"谢逸","text":"剪剪轻风漠漠寒，玉肌萧瑟粉香残。\n一枝带雨墙头出，不用行人著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄查多闻 其一","author":"谢逸","text":"谁能货马即求船，分袂都门又一年。\n翳翳夏槐联骑语，萧萧秋雨对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄查多闻 其二","author":"谢逸","text":"大梁客舍虽无事，博塞欢娱未称情。\n不若夷门搔首坐，倘逢黄发识侯嬴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉中排闷 其一","author":"谢逸","text":"白发逢春老更狂，衰颜得酒脸生光。\n旋张裙幄林中醉，不管槐花开后忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉中排闷 其二","author":"谢逸","text":"春来莫学虎头痴，趁取风光二月时。\n剩觅吴笺呼阿买，醉中准拟写新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉中排闷 其三","author":"谢逸","text":"溪堂日日春光好，问柳中丞殊未来。\n暂辍老妻棋局手，白头相对酌新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉中排闷 其四","author":"谢逸","text":"武昌门外柳如烟，想见潘侯枕曲眠。\n欲借一帆春水去，江边皆是楚州船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹圣延刘济道归宜春 其一","author":"谢逸","text":"曹刘翰墨有家风，不学随时语更雄。\n莫似溪堂老居士，十年林下坐诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹圣延刘济道归宜春 其二","author":"谢逸","text":"家在集云峰下居，门前翠竹尽真如。\n道人若许通消息，邀我须凭雁足书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午绝句二首 其一","author":"谢逸","text":"白发无端种种生，每逢佳节只心惊。\n老妻稚子知人意，但把菖蒲酒细倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午绝句二首 其二","author":"谢逸","text":"病臂懒缠长命缕，破衣羞带赤灵符。\n樽中有酒不得醉，忆著三闾屈大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖绝句戏高彦应司理 其一","author":"谢逸","text":"平湖奁镜净无尘，地接西坛共一云。\n安得御风如列子，更邀明月访元君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖绝句戏高彦应司理 其二","author":"谢逸","text":"野情萧散不便书，老大无心赋子虚。\n待借南湖双艓子，绿荷阴里看游鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖绝句戏高彦应司理 其三","author":"谢逸","text":"芰荷香里文章静，蘋藻汀边职事清。\n若使渊明知此味，折腰五斗可忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖绝句戏高彦应司理 其四","author":"谢逸","text":"山色波光入座中，笑谈不觉酒杯空。\n掾曹莫作刑官看，兼有江湖隐者风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖绝句戏高彦应司理 其五","author":"谢逸","text":"碧瓦朱甍午影凉，软风翻袂送清香。\n荷花也似知秋近，故敛羞容避夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文美约游南湖戏作绝句 其一","author":"谢逸","text":"疏疏小雨阁春云，步屧轻便不涴尘。\n湖上沙鸥莫惊顾，吾曹岂是觅鱼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文美约游南湖戏作绝句 其二","author":"谢逸","text":"沙井泉甘自试茶，匆匆一饭野僧家。\n翛然放棹各归去，不踏城西晚鼓衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王禹锡 其一","author":"谢逸","text":"江南山水只供愁，征雁来时正倚楼。\n十里珠帘皆可意，西风吹梦到扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王禹锡 其二","author":"谢逸","text":"西风撩竹作秋声，勾引诗人太瘦生。\n安得昭华吹玉笛，满船明月送君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭胡民望 其一","author":"谢逸","text":"才闻歌板情难忍，支枕呻吟二竖婴。\n天上楼成邀李贺，山中石老失初平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭胡民望 其二","author":"谢逸","text":"翻手成文同舍惊，长安日饭五侯鲭。\n只因太史多饶舌，曼倩方知是岁星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金石台","author":"谢逸","text":"江边怪石老嶙峋，雨洗斑斑翠藓纹。\n本是人间无用物，岂应丞相等閒分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和智伯绝句 其一","author":"谢逸","text":"平生学道慕裴休，投老无心赏莫愁。\n特买扁舟载明月，谁人伴我五湖游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和智伯绝句 其二","author":"谢逸","text":"红旗黄纸不关身，世事如云日日新。\n对客莫谈非圣语，人生要醉五经醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和智伯绝句 其三","author":"谢逸","text":"黄四娘家花有声，杜陵野老最关情。\n恐遭江上春风恼，岂是哦诗太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和智伯绝句 其四","author":"谢逸","text":"攀条弄蕊不须忙，家有名园饮辟疆。\n但得胸怀了无累，尘中宾主可相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日","author":"谢逸","text":"竹风烟静午阴凉，饭罢呼童启北窗。\n试拂横床供昼寝，且容幽梦绕清江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜兴","author":"谢逸","text":"梧桐叶落覆东墙，院落风清枕簟凉。\n梦觉疏钟鸣远寺，一池明月芰荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亡友潘邠老有满城风雨近重阳之句今去重阳四日而风雨大作遂用邠老之句广为三绝句 其一","author":"谢逸","text":"满城风雨近重阳，无奈黄花恼意香。\n雪浪翻天迷赤壁，令人西望忆潘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亡友潘邠老有满城风雨近重阳之句今去重阳四日而风雨大作遂用邠老之句广为三绝句 其二","author":"谢逸","text":"满城风雨近重阳，不见修文地下郎。\n想得武昌门外柳，垂垂老叶半青黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亡友潘邠老有满城风雨近重阳之句今去重阳四日而风雨大作遂用邠老之句广为三绝句 其三","author":"谢逸","text":"满城风雨近重阳，安得斯人共一觞。\n欲问小冯今健否，云中孤雁不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送通上人归上高 其一","author":"谢逸","text":"复忆敖峰万叠山，云中归路踏弯环。\n霜乾木落重阳后，莫见黄花便破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送通上人归上高 其二","author":"谢逸","text":"一筇归去旧庵居，卧听修廊吼木鱼。\n寄语堂头老尊宿，祇题数字答君书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲邦惠菊花诗以戏之","author":"谢逸","text":"重九登高折未残，霜蕤犹带晚香寒。\n莫嫌烂熳开何益，秀色侵人若可餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行即事","author":"谢逸","text":"碧浪鳞鳞浅见沙，丹枫林里两三家。\n舟横渡口渔翁醉，梦觉西江芦荻花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正觉寺","author":"谢逸","text":"避暑访禅客，顷作城南遨。\n秋风飒然来，草木鸣萧骚。\n复起水东兴，两桨摇轻舫。\n何处可盘礴，有寺临江皋。\n门户颇幽邃，野径深蓬蒿。\n升堂脱冠坐，洗盏倾浊醪。\n初筵谈名理，清言洗尘劳。\n徐徐杂诙谐，坦率真吾曹。\n尚馀清净业，诗成漫挥毫。\n人生一瞬间，逝水行滔滔。\n归与不秉烛，楼头霜月高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明水寺","author":"谢逸","text":"城西三十里，山林深且杳。\n群峰如连环，缘崖一径小。\n土润禾稼重，地僻居民少。\n老桂耸亭亭，乔松高矫矫。\n幽露泣溪毛，清风摇绿筱。\n朝来爽气浮，轻烟横木杪。\n日暖天清明，野雉鸣有鷕。\n石涧嗽寒泉，泠泠泻幽沼。\n嵯峨双石门，屡经樵火燎。\n祇园焕觚棱，十雉周墙缭。\n扫地炷妙香，房栊深窈窕。\n嗟予嵚崎人，平生百忧扰。\n好古嗜简编，僻性乐鱼鸟。\n每逢山水佳，耳听眸子瞭。\n况同佳士游，意气溢云表。\n望远视眈眈，临危忧悄悄。\n险韵吟竞病，怪语作危了。\n华鲸吼脩廊，僧窗曙迷晓。\n炊黍馔来牟，土芝杂荓蓼。\n他时子来归，伐木芟萝茑。\n考室山之阳，高明远隘湫。\n第恐恋君恩，紫禁烟花绕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北津渡","author":"谢逸","text":"竹篱茅舍掩柴扉，衰草寒烟野径迷。\n只有白鸥无俗韵，何年相伴老清溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺恨","author":"谢逸","text":"汲井浣我衣，伐石固我墉。\n尘埃不被体，绝无人迹通。\n洋洋西江水，我车不敢渡。\n夙驾岂不早，早行畏多露。\n行止既有义，离合亦有时。\n众人岂无心，不如我所止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁柱观","author":"谢逸","text":"豫章城南老子宫，阶前一柱立积铁。\n云是旌阳役万鬼，夜半舁来老蛟穴。\n插定三江不沸腾，切勿摇撼乾坤裂。\n苍苔包裹鳞皴皮，我欲摩挲手屡掣。\n旌阳挈家上天去，只留千夫应门户。\n西山高处风露寒，兹事恍惚从谁语。\n安得猛士若朱亥，袖往南山击猛虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂花 其一","author":"谢逸","text":"白雪凝酥点额黄，蔷薇清露湿衣裳。\n西风扫尽狂蜂蝶，独伴天边桂子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋","author":"谢逸","text":"异乡寒觉早，故国信来稀。\n秋风江上望，一雁正南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅 其一","author":"谢逸","text":"老杜骑驴入草堂，独怜江路野梅香。\n定知深院黄昏后，疏影横斜更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅 其二","author":"谢逸","text":"琼酥滴滴缀斜枝，想见香心未吐时。\n但有仙人殷七七，从教横笛月中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琴","author":"谢逸","text":"风撼丝桐带月明，羽人乘醉截秋声。\n七弦妙制饶仙品，二尺良材称道情。\n池小未开春浪泛，岳低犹欠暮云生。\n何妨乞与元中术，临化无妨膝上横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"右军墨池","author":"谢逸","text":"张芝学书池水黑，章草如芝古无敌。\n右军睥睨难抗行，恨不临池作书癖。\n云何汝水之上崔嵬峰，到今方池有遗墨。\n此事不特古老传，往往故事书简册。\n南丰先生欣得之，手挥巨笔飞霹雳。\n云是逸少徜徉山水间，笔墨淋漓此其迹。\n呜呼胜事妙入神，千年尺水清粼粼。\n有时水面浮墨过，纷纷郁郁非烟云。\n我书敧倾不成字，秋雁斜行落窗纸。\n印泥沙法安可传，独抚馀踪玩清泚。\n但当一日书一箱，笔踪或在子钦行。\n他年若榜凌云殿，定不悬橙白头如仲将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝴蝶","author":"谢逸","text":"粉翅双翻大有情，海棠庭院往来轻。\n当时只羡滕王巧，一段风流画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅 其一","author":"谢逸","text":"朝见一枝吐，暮吟疏影寒。\n亭亭不解语，助我青毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅 其二","author":"谢逸","text":"毫端直似林逋鬼，千年万年作知己。\n孤山忆有咏残枝，洗尽铅华对寒水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"就陈仲邦乞菊","author":"谢逸","text":"芙蓉狼藉拒霜残，只有黄花巧耐寒。\n盈把已供陶令醉，落英分与屈原餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彩烟山","author":"谢逸","text":"吾闻沃洲天姥间，又有彩烟之高山。\n山上之冈三十里，平视天姥浮青鬟。\n其中隐者吾所羡，身世长与浮云閒。\n种朮可疗九州疾，种稻自给千家餐。\n橘柑枣栗与桑柘，种者不少资者繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"谢逸","text":"贪夫蚁旋磨，冷官鱼上竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"谢逸","text":"典刑尚可窥前辈，赖有徐洪在豫章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"谢逸","text":"山寒石发瘦，水落溪毛彫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"谢逸","text":"细雨来时麋角解，春风归去马蹄香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"谢逸","text":"萧萧白露催黄落，剪剪凉飙瘦碧鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"谢逸","text":"百叶梅梢拂掠黄，风摇雨练亦凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"谢逸","text":"未于莲社添宗衲，已向兰亭识道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"谢逸","text":"千点落花乱春思，杜宇一声生客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"谢逸","text":"狂随柳絮有时见，舞入梨花何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十","author":"谢逸","text":"江天春晚暖风细，相逐卖花人过桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十一","author":"谢逸","text":"少陵苦被诗相恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"谢逸","text":"姚黄魏紫莫相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十三","author":"谢逸","text":"身似何郎全傅粉，心同韩寿暗偷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜晴","author":"赵鼎臣","text":"我田既臧，零雨其濛。\n嗟我农夫，忧心冲冲。\n谷旦于差，薄言往愬。\n谓天盖高，上帝临汝。\n杲杲出日，有嘒其星。\n穫之挃挃，我仓既盈。\n薄采其芹，于彼行潦。\n神之听之，无德不报。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昔我往矣思君子也高阳之从事过瀛之野作河广诗而匿其名使者唐侯独见而知之故赋是诗","author":"赵鼎臣","text":"昔我往矣，作为此诗。\n凡百君子，谅不我知。\n惟彼硕人，眷眷怀顾。\n彼何人斯，可与晤语。\n召彼故老，周爰咨询。\n予忖度之，所谓伊人。\n实获我心，将恐将惧。\n颜如渥丹，畏此谴怒。\n维彼硕人，顾我则笑。\n如切如磋，匪怒伊教。\n自古在昔，哀鸣嗷嗷。\n袖如充耳，莫我肯劳。\n嗟我农夫，出自幽谷。\n如蜩如螗，其何能淑。\n维彼硕人，追琢其章。\n欲报之德，不可弭忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]