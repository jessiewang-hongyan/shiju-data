[{"title":"作坊魏使知隰州","author":"杨亿","text":"几年供奉宣徽殿，一旦腰悬刺史鱼。\n戚里园林甲京洛，将坛家世阅诗书。\n离筵惜别空银榼，官舍思归梦玉除。\n四十专城谁不羡，骖驔千骑拥干旟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋夜坐","author":"杨亿","text":"明河如练出城隅，朱火西流暑气徂。\n顾兔一轮浮月桂，流萤数点入烟芜。\n迢迢宫漏传银箭，淅淅天风下白榆。\n岸帻微吟自忘寐，披衣閒起绕庭梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋属疾","author":"杨亿","text":"潘郎已是入秋悲，属疾犹贪桂补羸。\n密雪才高閒赋笔，流波意远托琴丝。\n离愁尽日吟青案，蠲渴何人寄紫梨。\n昨夜西楼凉月满，清谈偏忆庾元规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别赋赏花一首","author":"杨亿","text":"仙山灵沼五城西，晓日花光照彩霓。\n露濯冰蚕铺瑞锦，风吹水麝拆香脐。\n芳葩散采添蜂蜜，红片狂飘杂燕泥。\n曾识壶中旧春色，桃源重到路犹迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别聪道人归缙云","author":"杨亿","text":"二年假守栝苍城，郡榻唯师即送迎。\n捣药几怜春漏永，调琴长待夜蟾生。\n心猿已伏都无念，海鸟相逢自不惊。\n送别秋郊岂成恨，白云青嶂是归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即日","author":"杨亿","text":"急雨度前轩，池荷相对翻。\n峰奇云待族，蹊闇李无言。\n掩鼻生愁咏，披襟爽醉魂。\n一廛今已废，犹恋汉庭恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席赋得笔送宗人大著通判广州","author":"杨亿","text":"著作蓬山局，职司华衮褒。\n已能成马史，何况梦江毫。\n金劲鸡摇距，霜寒兔堕毛。\n归来批凤诏，弄翰莫辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴延年宰武义","author":"杨亿","text":"精神满腹富青春，烧尾曾看上禹门。\n献赋多年梁苑客，谪仙重世武夷孙。\n一同印绶光初命，几驿桑麻接故园。\n泽国归程秋欲尽，丹枫黄菊动吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴待问之蒙城簿","author":"杨亿","text":"西来赴调合关繻，黄绶风尘厌九衢。\n祖席且同开口笑，公庭未免折腰趋。\n长安车马偏欺客，鲁国衣冠肯戏儒。\n共忆故园归计晚，旧游烟树隔重湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"坐中朱博士言今荆南张谏议典襄阳日尝留意一妓公颇畏内终不得近及移郡荆渚泣别邮亭乃为歌词流布巴郢予感其事赓而成诗","author":"杨亿","text":"骎骎五马江陵去，寂寂双娥汉水头。\n一曲歌终眉黛敛，十分酒尽泪珠流。\n阳春郢客传新唱，暮雨高堂梦昔游。\n琼树无人敢亲近，章台京兆不胜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋玉","author":"杨亿","text":"兰台清吹拂冠緌，薙草新居对渺瀰。\n丽赋朝云无处所，羁怀秋气动赍咨。\n三年送目愁邻媛，七泽迷魂怨楚词。\n独有江南哀句在，更传馀恨到黄旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋殿丞广南东路转运","author":"杨亿","text":"天子忧南越，公卿荐陆生。\n九年须富国，万里便扬旌。\n封部诸蛮接，官曹六尚荣。\n交州何日到，鼓吹定相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弟伋归宁","author":"杨亿","text":"一夕西风木叶飞，长安久客念庭闱。\n去随塞雁衔芦远，归值家鸡啄黍肥。\n负郭生涯同季子，澄江诗景属玄晖。\n帝城紫陌多尘土，免化轻云白纻衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弟伸归乡","author":"杨亿","text":"泽国思归咏采兰，束书携剑出长安。\n天涯朝暮倚门望，岁晏风霜行路难。\n闽岭夕岚乡树老，楚江寒浪客衣单。\n岩前旧勒移文处，到日重须拂藓看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弟称归乡","author":"杨亿","text":"吾家文雅占关西，五十年来桂两枝。\n突弁后生还可畏，籯金素业未应衰。\n江湖去为思鲈鲙，雾雨还归养豹姿。\n摩厉词锋莫中辍，惊人专听一鸣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弟僓归乡","author":"杨亿","text":"客儿诗思掩春塘，杖策来观上国光。\n举白万钱酤酒饮，杀青千卷买书藏。\n梁园绿筱将攲雪，楚岸苍葭已变霜。\n跃马还家那隔岁，预应乾鹊报高堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张兖下第随桂阳乔监使之湘中","author":"杨亿","text":"建溪曾共听猿声，十载文场未策名。\n流落只应孤剑在，穷愁已有二毛生。\n荆州暂去依刘表，汉殿无由荐马卿。\n一路骚人旧山水，登临且莫动归情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀旧居","author":"杨亿","text":"武夷仙穴近吾庐，斗鸭阑摧菌阁虚。\n千匹岁储妨种橘，百金春事废观渔。\n北山烟雾迷归辙，南陌风尘化客裾。\n堂上金丝应已歇，岂惟兰菊旧丛疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀寄枢密王左丞","author":"杨亿","text":"高陪七圣从轩游，帷幄深严日运筹。\n口里雌黄归品藻，盘中薤白想风流。\n珠宫地密妨趋谒，铜钵声沉断唱酬。\n独喜修书依绛帐，时登阙里受春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李四赴歙州","author":"杨亿","text":"分直蓬邱未再期，江东去去拥旌麾。\n名通南省郎官籍，卷续新安郡政诗。\n虎观清风留汗简，鸰原高韵忆吹篪。\n故人别后频南望，想见森森琼树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李舍人独直","author":"杨亿","text":"阁凤巢高拂綵霓，玉芝香杂武都泥。\n十行汉札如丝出，六幕尧天倚杵低。\n露井冰销垂素绠，仙茎日转射璇题。\n赫蹄云落知谁见，馀力何妨颂碧鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李殿丞知广济军","author":"杨亿","text":"钩盾从来司六尚，上林寻见惣三官。\n颁条忽去凭熊轼，赐对还曾近露盘。\n民瘼乍求应有术，天伦少别不成欢。\n陶朱旧邑无多远，魏阙归心且自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵隐长老归旧山","author":"杨亿","text":"浮杯心与海鸥亲，驻锡王城忽过春。\n麟殿九旬谈妙法，曹溪一滴渡迷津。\n狂翻竹箭波随棹，侧布黄金地绝尘。\n白黑欢迎猿鸟喜，绀园风定雨花新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏寺丞维甫知简州阳安县兼携家之任","author":"杨亿","text":"神鸡缥碧马金精，西海桑田一掌平。\n苜蓿度关风渐劲，莓苔登栈雨新晴。\n琴斋尽室无归梦，锦里当垆奈宿酲。\n麈柄清谈且为政，莫贪蒟酱学论兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"译经惣持大师致宗之泗上礼塔","author":"杨亿","text":"早传心印得衣珠，不学声闻證有馀。\n犀柄屡登三殿讲，琅函新译五天书。\n莲华塔下焚香去，竹箭波间解缆初。\n随顺世缘无所住，经行宴坐自如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赤日","author":"杨亿","text":"赤日亭亭昼正赊，长风万里忆星槎。\n铜盘琼蕊三危露，素绠寒浆五色瓜。\n兰室冷光浮玉簟，柳营清吹逐金笳。\n翠微泉石终南路，千古离宫倚曙霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邵奉礼归乡","author":"杨亿","text":"应制曾亲白玉除，桐君溪畔是幽居。\n末登王子洛宾岁，已读黄香东观书。\n万里归宁承汉诏，三牲供膳奉潘舆。\n水衡得俸诚堪喜，莫便挥金学二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈小著从易知邵武军","author":"杨亿","text":"奏牍金门奉帝俞，平明鸾省剖铜符。\n北堂送喜应占鹊，南国思归不为鲈。\n岁月天涯乡树老，烟波江上客帆孤。\n会稽友婿堪羞死，邑令今来负弩驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈尧拱廷评致仕归蜀","author":"杨亿","text":"一家今有十朱轮，独忆云山欲退身。\n天邑繁华行乐厌，月曹清要命书新。\n西风跃马经秦甸，东道椎牛宴孟邻。\n秋稼万箱僮百指，羲皇之上更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京府狱空降诏因寄大尹学士","author":"杨亿","text":"长安恶少罢探丸，桴鼓声沉禁网宽。\n三尺旧章闲玉律，八行优诏下金銮。\n帝临宣室方前席，民值唐年耻画冠。\n终日讼庭无一事，早调伊鼎佐汤盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和集贤李学士千字诗","author":"杨亿","text":"千仞溪何险，千仓稻已收。\n出骑千里马，醉典千金裘。\n千年河诞圣，千树橘封侯。\n千钟不及乱，千钱坐上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和酬秘阁钱少卿夜直见寄次韵","author":"杨亿","text":"甘瓜朱李郢醪浓，素绠银床荫碧桐。\n赐第旧连丹凤阙，直庐今在未央宫。\n承云仙掌延年露，转蕙薰弦解愠风。\n此夕蓬山好逃暑，月轩清话恨难同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏醉","author":"杨亿","text":"刘伶石五斗，康成三百杯。\n攲斜星弁侧，嵬峨玉山颓。\n人语蜩螗沸，天形帟幕开。\n应知是狂药，何不学颜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宴","author":"杨亿","text":"华堂高宴卜良宵，宾客当筵半珥貂。\n天转玉绳星落落，风传银箭漏迢迢。\n连浮大白须判醉，促驾鸣驺又趁朝。\n月落乌啼人散后，衣香数日未能销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和御制中和","author":"杨亿","text":"佳节更春晦，长标令甲名。\n天渊摇绿浪，仙杏吐丹荣。\n连鼓将惊蛰，高枝已变莺。\n云谣传下土，汉曲被新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和御制社日诗","author":"杨亿","text":"仙掌凌空沆瀣秋，大田多稼似云浮。\n天边霁景芙蓉阙，江上残芳杜若洲。\n东观群儒宣宴乐，南荆遗俗重嬉游。\n宸章忽降容瞻睹，疑是神龟负九畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和御制重阳五七言诗 其二","author":"杨亿","text":"民在华胥正乐康，高秋宾雁指衡阳。\n蒹葭渐见凝清露，鶗鴂先惊歇众芳。\n节值登高真胜会，年逢大有是殊祥。\n宸心悦豫流新唱，星汉垂文示八方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和御制喜降时雪七言四韵诗","author":"杨亿","text":"一夕香街布玉尘，檀栾劲节露贞筠。\n兔园置酒皇欢洽，柏殿赓歌睿唱新。\n麦秀原田初望岁，花开苑树忽惊春。\n丰穰荐瑞民心悦，高下还随帝泽均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和翰林诸公贺阁长李公领银台之什","author":"杨亿","text":"西汉公车主上章，官曹秘邃接明光。\n天书时草凤凰诏，边奏亲开赤白囊。\n咫尺青规频借箸，离披金蕊阻飞觞。\n瀛洲仙侣相期处，铜马门中白玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妹婿黄补下第归乡","author":"杨亿","text":"家风早占无双誉，乡荐曾居第一流。\n昆岭本期争片玉，庖刀谁料失全牛。\n风尘不住梁王苑，烟水还依楚客舟。\n应负男儿四方志，故园归去莫淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"始皇","author":"杨亿","text":"衡石量书夜漏深，咸阳宫阙杳沈沈。\n沧波沃日虚鞭石，白刃凝霜枉铸金。\n万里长城穿地脉，八方驰道听车音。\n儒坑未冷骊山火，三月青烟绕翠岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其一 武夷山","author":"杨亿","text":"灵岳标真牒，孤峰入紫氛。\n藤萝暗仙穴，猿鸟骇人群。\n古道千年在，悬流万壑分。\n汉坛秋藓驳，谁祀武夷君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其七 大中塔","author":"杨亿","text":"鸡园开净土，雁塔倚寒空。\n风铎和清梵，晴幡映彩虹。\n香花倾海国，金碧拟天宫。\n绝顶登临处，溪山一掌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其九 延平津","author":"杨亿","text":"积水深无际，神龙此屈蟠。\n媚川珠彩动，射斗剑光寒。\n燕脯谁能寄，犀灯岂易看。\n负图当瑞圣，何苦蛰洪澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其二 北苑焙","author":"杨亿","text":"灵芽呈雀舌，北苑雨前春。\n入贡先诸夏，分甘及近臣。\n越瓯犹借渌，蒙顶敢争新。\n鸿渐茶经在，区区不遇真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其八 仙人洲","author":"杨亿","text":"寒潭吞别派，孤屿屹中流。\n昔有骖鸾客，因名坠马洲。\n洪波长赴海，碧树几经秋。\n城郭何年变，空闻鹤语愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其十 毛竹洞","author":"杨亿","text":"洞门生异竹，冉冉接同亭。\n石迸狂鞭怒，霜封密叶青。\n实应容凤食，杖欲变龙形。\n逋客归何日，岩阿已勒铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其五 梨山庙","author":"杨亿","text":"唐季临兹郡，生祠已荐馨。\n声诗传乐府，庙猊载图经。\n画壁流尘暗，金碑古藓青。\n细民时请福，挝鼓赛遗灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建溪十咏 其六 勤公亭","author":"杨亿","text":"危亭压波面，屹若抃灵鳌。\n浮蚁酡颜数，飞鸿送目劳。\n吏围披簿领，僧伴话风骚。\n何日登悬榻，州民刺有毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"择良上人归天台","author":"杨亿","text":"片席然犀经水府，几程登陆望霞标。\n吟情晚日繁云合，归路秋风密叶凋。\n行道六时庐岳漏，浮杯千里浙江潮。\n旧房宴坐观空后，香积多年饭顿销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明皇","author":"杨亿","text":"玉牒开观检未封，斗鸡三百远相从。\n紫云度曲传浮世，白石标年凿半峰。\n河朔叛臣惊舞马，渭桥遗老识真龙。\n蓬山钿合愁通信，回首风涛一万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明德皇太后挽歌词五首 其四","author":"杨亿","text":"世载河山誓，门无恩泽侯。\n公桑空茧馆，仙药阻蓬丘。\n悯册藏幽壤，哀笳咽素秋。\n后宫彤管在，千古纪徽猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又五首 其一","author":"杨亿","text":"太姒徽音盛，长秋命数崇。\n黄图分丙殿，玄象应轩宫。\n记注无穷美，声诗内助功。\n云阳复土后，陵柏自悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明德皇太后挽歌词五首 其一","author":"杨亿","text":"母仪垂二纪，坤顺翊玄功。\n望断苍梧野，尊归长乐宫。\n金涂烘晓日，椒壁起香风。\n奄忽违尘世，攀号泣舜瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又五首 其三","author":"杨亿","text":"轩游云杳杳，舜孝日蒸蒸。\n椒壁还生沴，铜台亦罢登。\n亲桑宁复见，尝药遂无徵。\n拱木玄堂闵，凄凉烟雾凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明德皇太后挽歌词五首 其二","author":"杨亿","text":"轩星光太极，阴教正中闱。\n外戚黄金穴，深宫大练衣。\n雀台愁雾隔，驹隙暗尘飞。\n贝阙三山路，飘飖仙驭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又五首 其五","author":"杨亿","text":"外族长安盛，尊名永乐崇。\n初陵凄草露，旧殿阒椒风。\n巩树迷凶仗，周原掩寿宫。\n圣君悲望处，泪雨泣重瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又五首 其二","author":"杨亿","text":"甲族传仙李，遗言在濯龙。\n后宫皆率职，外戚早辞封。\n彤管流阴教，金根盛国容。\n真游一何遽，罢望九疑峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明德皇太后挽歌词五首 其五","author":"杨亿","text":"阃范留椒闼，神游返玉清。\n鱼灯照玄寝，骑吹咽重城。\n运迫升仙日，人伤丧妣情。\n宫中旧长御，行哭尽吞声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明德皇太后挽歌词五首 其三","author":"杨亿","text":"德契河洲什，心依黄老书。\n濯龙规诫在，飞羽豫游疏。\n复土文园接，凝尘丙殿虚。\n蒸蒸天子孝，泣血望涂车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又五首 其四","author":"杨亿","text":"外家金穴贵，曩日玉衣祥。\n万寿瑶觞举，三朝复道长。\n小侯亲俎豆，女史焕缣缃。\n遽厌人间世，乘云归帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杭州严从事","author":"杨亿","text":"柳岸兰桡片席飞，秋风泽国季鹰归。\n幕中莲渚红衣脱，江外莼羹紫线肥。\n十部须知从事贵，双鱼莫遣尺书稀。\n西陵正接家山路，试为因人问钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欧阳使者监和州军","author":"杨亿","text":"新剖牙璋出护军，使车归养指江濆。\n綵衣楚国老莱子，白首长安万石君。\n虎眼波狂征棹急，鲈鱼鲙美寿杯醺。\n东南极目无氛祲，不假横戈看阵云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泪二首 其二","author":"杨亿","text":"寒风易水已成悲，亡国何人见黍离。\n枉是荆王疑美璞，更令杨子怨多歧。\n胡笳暮应三挝鼓，楚舞春临百子池。\n未抵索居愁翠被，圆荷清晓露淋漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泪二首 其一","author":"杨亿","text":"锦字梭停掩夜机，白头吟苦怨新知。\n谁闻陇水回肠后，更听巴猿拭袂时。\n汉殿微凉金屋闭，魏宫清晚玉壶攲。\n多情不待悲秋气，祗是伤春鬓已丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直夜","author":"杨亿","text":"缭垣峣阙庆云深，画烛熏炉对拥衾。\n三殿夜签传漏箭，九秋霜籁入风琴。\n阶前槁叶惊寒雨，天际孤鸿答迥砧。\n欹枕便成鱼鸟梦，岂知名路有机心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]