[{"title":"登谢公楼","author":"邹应龙","text":"沿岸城廓开翠屏，南山毓秀欲腾云。\n寺院宝塔耸苍吴，江上群峰排众青。\n沽酒自作太白醉，凭栏独向曲江斟。\n风流江左令何处，吊古吟诗谁解听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 寿母","author":"邹应龙","text":"满二望三时，春景方明媚。\n又见蟠桃结子来，王母初筵启。\n无数桂林山，不尽漓江水。\n总入今朝祝寿杯，永保千千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 寿伯母太夫人上官氏","author":"邹应龙","text":"吾家二老。\n前有高平生癸卯。\n若到今辰。\n讵止荣华九十龄。\n共惟伯母。\n九十新年还又五。\n五五相承。\n好看重逢乙巳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 在朝日寿母昌国叶夫人","author":"邹应龙","text":"帝里风光别是天。\n花如锦绣柳如烟。\n还逢令节春三二，又庆慈闱岁八千。\n斟寿斝，列长筵。\n子孙何以咏高年。\n各裒千首西湖什，一度生朝献一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"邹应龙","text":"寿母开年九十三。\n佳辰就养大江南。\n缇屏晃耀新宁国，绣斧斓斑老朴庵。\n倾玉斝，擘黄柑。\n两孙垂绶碧于蓝。\n便当刊颂崆峒顶，留与千年作美谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 任静江经略安抚日元夕奉亲出郊","author":"邹应龙","text":"彩结轻车五马随。\n倾城争出看花枝。\n笙歌十里岩前去，灯火千门月下归。\n莲炬引，老莱衣。\n蛾眉无数卷帘窥。\n谁知万里逢灯夕，却胜寻常三五时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"邹应龙","text":"九十吾家两寿星。\n今夫人赛昔夫人。\n百年转眼新开帙，十月循环小有春。\n生日到，转精神。\n目光如镜步如云。\n年年长侍华堂宴，子子孙孙孙又孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感皇恩 知平江日寿母上官太夫人","author":"邹应博","text":"觅得个州儿，稍供彩戏。\n多谢天公为排备。\n一轮明月，酝作清廉滋味。\n倾入寿杯里，何妨醉。\n我有禄书，呈母年万计。\n八十三那里暨。\n便和儿算，恰一百四十地。\n这九千馀岁，长随侍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"邹应博","text":"天遣丰年祝母龄。\n人人安业即安亲。\n探支十日新阳福，来献千秋古佛身。\n儿捧盏，妇倾瓶。\n更欣筵上有嘉宾。\n紫驼出釜双台馈，玉节升堂两使星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 家居日寿词","author":"邹应博","text":"诸佛林中女寿星。\n千祥百福产心田。\n喜归王母初生地，满劝麻姑不老泉。\n吾梦佛，半千员。\n一年一佛护庭萱。\n数过九十从头数，四百馀零一十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄宫","author":"邹杞","text":"天柱古名山，形势友列岳。\n神人巢其巅，咳唾半天落。\n白昼见云旗，清夜闻笙鹤。\n花源或流红，仙禽犹捣药。\n长歌不可见，清风洒寥廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题古城岩","author":"邹补之","text":"依然雉堞古城基，开创由来自汉隋。\n南北两门馀旧日，黔黎百岁话当时。\n循山㶁㶁陈公堨，凿石岩岩葛令碑。\n万丈悬崖如削玉，也应容我恣题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"邹补之","text":"曲江丞相言不售，范阳烽火连京畿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"邹宗谟","text":"远继杜参谋，近追苏玉局。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过杜工部祠","author":"邹定","text":"畴昔哦诗忆耒阳，兹因捧檄过祠堂。\n一生忠义孤吟里，千载凄凉古道旁。\n自是风霜侵病骨，非干牛酒涴诗肠。\n明朝解缆秋江上，问讯先生一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘露岩","author":"邹恕","text":"兰若半空中，云山第几重。\n瀑流千丈练，鹤宿五株松。\n晓雨禅房黑，霜林木叶红。\n悬崖回首望，归思过前峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈满堂","author":"邹浩","text":"满堂当日亦飞升，金笋无根不复生。\n惟有明皇留辇处，至今云雾半山横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参寥示简元规诗用其韵寄之 其一","author":"邹浩","text":"千岩万壑久青天，一钵新从淮上旋。\n昨日浮云今止水，谁知庵内更无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参寥示简元规诗用其韵寄之 其二","author":"邹浩","text":"人间何向不盐梅，江海元从蚁穴开。\n列戟门庭扫踪迹，只应飞矢亦潜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柄生日","author":"邹浩","text":"南极星中见老人，祥光垂照喜生春。\n身如龟鹤心如石，进德功夫常日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病卧读书","author":"邹浩","text":"山为屏障草为裀，黄犊群中早奋身。\n骨立诗书亦何有，不如参取坐忘人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋漳浦李大忠微叔所藏书画尾","author":"邹浩","text":"岭表归来饭不足，负郭有田多未赎。\n何当卖剑成此谋，耕遍雨馀春雨绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲龚彦和","author":"邹浩","text":"衣领从教虱子缘，夜深拜得席儿穿。\n道乡活计君知否，饥即须餐困即眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白龙洞","author":"邹浩","text":"洞门寂寂昼常阴，谁识行天济物心。\n金翅影沉超永劫，玉毫光现契圆音。\n滂沱普润三千界，叆叇浓兴一万寻。\n天子六龙方在御，不应头角閟幽深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯和见过","author":"邹浩","text":"参军跋马瘴江滨，一笑相逢意转亲。\n偶复面论前日事，恍疑身是隔生人。\n风随玉麈倾新盖，暑避冰姿返旧轮。\n八桂森森照归路，为君留饮判经旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别由正","author":"邹浩","text":"许汝相望无百里，政声文誉益惊人。\n岂知今日俱长路，重慰平生仰后尘。\n云澹京山黄鹄举，风回汉水白鸥驯。\n归来有约天从否，准拟冥行细问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵端夫闻江北水磨","author":"邹浩","text":"万事根本初难明，声之所发由声声。\n不有智者抉其□，直如宝剑埋丰城。\n风生风济孰嘘吸，制作解成琴与筝。\n矧兹江汉泻荆楚，含桃初熟飞流莺。\n波涛暗逐岁月长，激激滩际春雷谹。\n白沙湖边更湍急，五磨因缘资养生。\n城中鞭驴喘欲死，亦或人劳僵自横。\n借令麦破面浮玉，青蝇遽集争营营。\n乃知此策最长利，朱墨岂复嗤南荣。\n天轮地轴骇昼夜，彷佛飓扇吹苍瀛。\n游江夫人俨然坐，蛟龙不动如石鲸。\n只应神物亦持护，我辈何妨双耳清。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别昭平","author":"邹浩","text":"江山本无情，别去亦何语。\n向来爽气中，食息三月许。\n来非吾所求，去非吾所禦。\n回首谢江山，吾今若轻举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别零陵","author":"邹浩","text":"零陵讵中邦，道阻五千里。\n我以放逐来，本非心乐只。\n身止高山巅，忽忽弥半祀。\n人情久自亲，况复多可喜。\n坐使故乡念，如火沃之水。\n罪大不得留，今兹动行李。\n昭州虽岭南，流寓盖均耳。\n倘未还庭闱，在彼犹在此。\n胡然当作离，耿耿殊不已。\n物我要兼忘，咄哉从此始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岑老书云远老法堂上草深一丈矣","author":"邹浩","text":"建隆无复旧行踪，石塔开堂得远公。\n衣挂六铢收法界，草深一丈见家风。\n也知是汝远狮子，不分饶他岑大虫。\n何日扬州船子去，木兰花里问真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏路","author":"邹浩","text":"赤路如龙蛇，不知几千丈。\n出没山水间，一下复一上。\n伊予独何为，与之同俯仰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"班超","author":"邹浩","text":"功名从古病难成，况作天西绝域行。\n纵有平陵同落落，其如卫候尚营营。\n杀妻吴起终遭逐，上疏鸿卿不免刑。\n定远独能逢圣主，千年万岁蔼嘉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲仲益","author":"邹浩","text":"低檐荫茅竹，陋如野人居。\n夫子莞尔笑，曰此真吾庐。\n庭前郁乔木，庭后犹榛芜。\n芟削随手净，春兰植扶疏。\n光影动窗几，馨香袭文书。\n皎然纫佩心，邂逅同三闾。\n尔来基构新，百事凌往初。\n突兀焕华屋，茅竹扫莫馀。\n双楠庭之珍，斩代殊荣枯。\n要知碧油幢，特立当阶除。\n念念入勋业，不与蓬荜俱。\n兰虽不生门，安能逭诛锄。\n剖琴如剖薪，烹鹤如烹鱼。\n珠玉抵飞鸟，镈钟委洪炉。\n逝矣覆辙存，来车犹此涂。\n尚欲取脩竹，永以娱朝晡。\n问竹竹无言，冷风一虚徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送大受赴天官","author":"邹浩","text":"元祐真人初御天，四门穆穆来忠言。\n阆风学士望朝野，即日赐环司谏垣。\n当时同列继登用，独先朝露归九原。\n位不酬身在孙子，嶷嶷诸子声名喧。\n叔也纵横五经内，娱目未始窥家园。\n苟闻某所有贤者，弊车趼仆从之奔。\n甘陵南北正分党，攘臂其间无怨恩。\n未见其止见其进，会须一指收乾坤。\n素冠俛首琴复御，鹏飞九万方化鲲。\n于今怙恃只明主，肯与世俗均寒暄。\n早年妙笔三千牍，矧已恸哭论元元。\n韩城父老傥改作，为报及此高闾门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈瑩中画像赞 其一","author":"邹浩","text":"凤阁鸾台何许，天涯地角周游。\n此老老而益壮，超然一段风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈瑩中画像赞 其二","author":"邹浩","text":"了了了时非了，非非非处何非。\n要识此翁端的，试看笔下形仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"邹浩","text":"有个头陀修苦行，头上头发毵毵。\n身披一副醦裙衫。\n紧缠双脚，苦苦要游南。\n闻说度牒朝夕到，并除颔下髭髯。\n钵中无粥住无庵。\n摩登伽处，只恐却重参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"邹浩","text":"慧眼舒光无不见。\n尘中一一藏经卷。\n闻说大千摊已遍。\n门方便。\n法轮尽向毫端转。\n月挂烛笼知再见。\n西方可履休回盼。\n要与老岑同掣电。\n酬所愿。\n欣逢十二观音面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"邹惇礼","text":"疏直拙依附，清高无匹俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临终歌","author":"邹梦遇","text":"嘉木扶疏兮，鸟鸣关关。\n暑风舒徐兮，庭中閒閒。\n起视天宇兮，浩乎虚澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"全州尹氏观","author":"邹野夫","text":"不嫁当年自薄情，一朝跨鹤上青冥。\n人间有女能如此，羞杀天边织女星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华子冈","author":"邹斌","text":"风流晋人物，康乐性乐山。\n文选数十诗，大半皆林泉。\n未知当时士，多少肥遁贤。\n投书犯世网，何如康乐阡。\n小隐华子冈，世事成云烟。\n高风辋川期，师法角里传。\n倘悟神仙诀，千载如眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长门怨","author":"邹登龙","text":"怨杀宫门不忍开，无情孤月暗苍苔。\n而今痛惜珊瑚枕，曾是君王赐御来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江南春","author":"邹登龙","text":"玲珑楼阁江城晚，杨柳丝丝凝碧烟。\n飞燕不归春满地，百花香里听啼鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词","author":"邹登龙","text":"内人倚遍玉楼东，晓色开云腊雪融。\n羯鼓一声花尽拆，三郎自唤作天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽事","author":"邹登龙","text":"闲携小斧删梅树，自缚枯藤补菊篱。\n烧柏子香读周易，滴荷花露写唐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"邹登龙","text":"约臂金寒拓绮疏，搔头玉重压香酥。\n含章檐下新妆额，试启菱花得似无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入投龙洞","author":"邹登龙","text":"行入投龙洞，青青见竹竿。\n暮云生道树，夜月满仙坛。\n枯藓沿崖古，长松绕涧寒。\n三生清净福，独此愧黄冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上慧力寺","author":"邹登龙","text":"今代空王宅，前朝处士家。\n牛车回象藏，鹿苑发龙华。\n松密风生树，江空月在沙。\n阇黎饭钟后，邀我试新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月洲李贾友山捧檄来淦访我梅下示教禁体物语咏梅佳句今岁梅开月洲仙去追和元韵感此良友","author":"邹登龙","text":"庭前有奇树，幽艳发寒柯。\n寂寂众芳歇，绵绵生意多。\n孤根依岭表，高节委岩阿。\n清友今何在，悠悠空逝波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭","author":"邹登龙","text":"阑槛玲珑直又横，半临池水着新亭。\n拟招鹭宿栽添苇，怕碍鱼行掠去萍。\n五月藕花千样锦，四时山色一般青。\n有闲来此寻幽赏，莫看人间淡墨屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王氏山居","author":"邹登龙","text":"闻道山居好，林深远俗情。\n茶烟熏壁暗，萝月射窗明。\n学稼修禾谱，栽花识药名。\n无人觉幽隐，为有读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江居","author":"邹登龙","text":"独作幽居计，江边屋数间。\n水流天自在，心远地宽闲。\n锄月栽梅树，移云叠石山。\n白鸥盟欲结，倚杖看潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西郊梅开怀吟轩周献父","author":"邹登龙","text":"仲冬寒气盛，玄云停故阴。\n嘉树厉清节，孤芳洁素心。\n幽幽荧岁落，皎皎隔尘侵。\n折寄无来使，山川迥且深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和竹里苏材叔见梅怀友韵","author":"邹登龙","text":"徘徊江路侧，何以慰相思。\n阳彩来寒树，贞姿倚暮篱。\n飘零怀远道，辽索负芳时。\n伫立幽吟苦，馀怀将诉谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵承远云扃","author":"邹登龙","text":"闻道幽居好，栖云结数椽。\n庭深关竹雨，衣润染茶烟。\n岚气生朝壁，湍声入夜弦。\n半生飞动意，未得痼林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送云巢曾校勘赴召","author":"邹登龙","text":"高卧云巢久，云生处士衣。\n忽闻颁诏札，催入侍经帏。\n朝野名虽盛，山林志莫违。\n好归清涧隐，富贵有危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送表兄赵奏院赴南外知宗","author":"邹登龙","text":"御屏往往题名字，朝路彬彬蔼荐书。\n天许留中监邸奏，日求补外得堂除。\n暂烦龙种司瑶籍，行立鸳班侍玉舆。\n丙枕或思前夜席，庚邮宁肯后锋车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄云林杨少云自衡之桂","author":"邹登龙","text":"问讯杨夫子，经年客异乡。\n南浮湘水远，西望楚天长。\n五岭梅花发，孤城草色荒。\n白云遥满目，曷久住炎方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄呈后村刘编修","author":"邹登龙","text":"众作纷纷等噪蝉，先生中律更钩玄。\n如开元可二三子，自晚唐来数百年。\n人竞宝藏南岳藁，商留金易后村编。\n傥令舐鼎随鸡犬，凡骨从今或可仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄苍山曾子实","author":"邹登龙","text":"东湖从此别，嘉会邈无期。\n望远音书阻，思君岁月驰。\n春云山隔断，秋雨雁归迟。\n欲见崆峒使，梅花寄一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游玉笥山","author":"邹登龙","text":"玉笥凌空后，玄都诏吏仙。\n荒坛深覆草，峭壁响流泉。\n石洞随龙蛰，金丹许鹤传。\n夜深捣药鸟，啼破翠微烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仰山寺","author":"邹登龙","text":"施地开金刹，神因结佛缘。\n怪松盘獭径，古木护龙渊。\n云裹春山乱，禽啼夜月圆。\n路遥归不得，好借上方眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪村","author":"邹登龙","text":"兀兀小桥西，人家住绕溪。\n云山当户入，竹树出檐齐。\n风急花初尽，春深莺乱啼。\n稻畦新雨足，稚子亦锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滕阁怀古","author":"邹登龙","text":"凭高独展眺，风叶乱鸣秋。\n銮舞自空阁，渔歌尚晚舟。\n卷帘山历历，倚槛水悠悠。\n月出江城暮，凄凉万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杜少陵草堂图","author":"邹登龙","text":"背郭好林塘，诛茅作草堂。\n因吟白鸦谷，为卜碧鸡坊。\n笼竹和烟净，江梅带雪香。\n四松经丧乱，阅世几风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戴式之来访惠石屏小集","author":"邹登龙","text":"诗翁香价满江湖，肯访西郊隐者居。\n瘦似杜陵常戴笠，狂如贾岛少骑驴。\n但存一路征行藁，安用诸公介绍书。\n篇易百金宁不售，全编遗我定交初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]