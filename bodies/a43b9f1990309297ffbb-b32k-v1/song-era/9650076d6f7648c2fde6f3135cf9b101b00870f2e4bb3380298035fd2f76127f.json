eror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日江上颇有春色偶成绝句遣兴五首 其二","author":"程俱","text":"错莫江梅春信迟，晴熏寒蕊雪团枝。\n年来顿失寻春意，一任高楼玉笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日江上颇有春色偶成绝句遣兴五首 其三","author":"程俱","text":"远树参差数点烟，目穷天际水黏天。\n背人叶叶风帆去，应有鸱夷万里船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日江上颇有春色偶成绝句遣兴五首 其四","author":"程俱","text":"不奈江头春色何，暖光摇日涨晴波。\n凭栏何处牵幽兴，杨柳沙洲一钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日江上颇有春色偶成绝句遣兴五首 其五","author":"程俱","text":"露压浓烟染远山，垂虹真在画图间。\n平湖渺渺思无限，何日浮云伴我闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄朱元益","author":"程俱","text":"小园桃杏已欣荣，华发逢春祇自惊。\n闻说江城多暇日，想教于蔿入新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未秋金陵怀古三首 其一","author":"程俱","text":"壮士狂歌击唾壶，追风老骥望长驱。\n山川形势端如此，当日宁无一伯符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4