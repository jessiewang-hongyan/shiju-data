[{"title":"送黄寺丞商伯浙仓罢归南康 其一","author":"韩淲","text":"邂逅登临胜，从容杯酒閒。\n脱身方甫里，满眼已庐山。\n此道天能会，端人世所悭。\n丹心空磊磊，绿鬓只斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄寺丞商伯浙仓罢归南康 其二","author":"韩淲","text":"问学无穷事，功名有定期。\n古今诚可见，治否老尤知。\n袖手寻幽隐，存心付崄巇。\n一时还别去，何日更追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"施教授考校他州","author":"韩淲","text":"陶冶于文举，才贤定靡遗。\n三年钦掌教，一旦庆衡持。\n过虑同官杂，焉知监试谁。\n无为我先达，不念士人时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑一浙运使","author":"韩淲","text":"好在春秋学，宜乘笔力初。\n邦畿缘伯讨，王道付儒书。\n超乘亦人尔，焚舟其我欤。\n两年嘉尚意，东上赴传胪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄靖州子孙江西漕试","author":"韩淲","text":"淬砺酬先志，家传合奏功。\n子孙当决胜，词赋况同风。\n南浦联名处，西江一战中。\n乡闾飞榜到，丹桂满芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵五哥秋试","author":"韩淲","text":"才俊毋轻敌，精神急护持。\n寓乡能取友，官路必修为。\n胄监秋高日，礼闱春盛时。\n龙蛇飞健步，好好对丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送叶卿湖南转运判官 其一","author":"韩淲","text":"野路荷花发，薰风使者车。\n老怀谙万事，雅俗问三闾。\n岳麓只如此，湘江应可居。\n时平閒护漕，历览且舒徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送叶卿湖南转运判官 其二","author":"韩淲","text":"自恨登门久，飘零岁月深。\n近知无复旧，后定不如今。\n声迹嗟贫病，形容入醉吟。\n经行才顷刻，何日奉书琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送顾丞沿檄徽饶","author":"韩淲","text":"柳暗烟霏绿，花残雨润红。\n梦思今夜远，别恨一枝同。\n杖舄经行处，江山兴寄中。\n纷纷莺蝶闹，得意正东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送顾丞赴张军师辟书","author":"韩淲","text":"细雨春帆外，江波漫漫流。\n人情虽忍别，风景可言愁。\n时命岂大缪，功名宁罢休。\n倚天长剑在，谈笑即公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送俞司户","author":"韩淲","text":"喜见魁乡士，薰风唱第归。\n岂惟荣里社，亦足庆庭闱。\n仕路当亨奋，儒家要发挥。\n一杯饯行色，灵鹫想烟霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送施仲益何文蔚余子任及蒋吴二友赴省","author":"韩淲","text":"会适章丘役，寒梅满路生。\n逢花百馀韵，顾我不胜情。\n祖送寻言句，相期岂利营。\n南宫三数子，能赋复经明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送履常中州买渔艇归半溪二三友放溜来迎","author":"韩淲","text":"送客中州外，乘流只自看。\n日斜孤棹晚，月上一溪寒。\n离合原非易，行藏似不难。\n归来理幽伴，莫负酒杯宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送矩恭回贵池","author":"韩淲","text":"乃祖朱轓地，铜章又若翁。\n江山应似旧，郡邑本来同。\n浙右还围棘，湖边又舣篷。\n思常游宦处，为子送秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十五日玉山道中见文蔚买酒送之","author":"韩淲","text":"雪岭吹寒雾，行田过远村。\n班荆得佳士，促席置清尊。\n官业从兹始，离怀不用论。\n洋洋晁董对，指日上金门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱塘送元立","author":"韩淲","text":"凤阙追随外，龙山判别中。\n怒涛翻夕照，远树起秋风。\n我亦情何限，君应兴与同。\n举杯淩浩渺，挂席看空濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别德久丈","author":"韩淲","text":"四海转庵老，清诗晚更传。\n几回看点笔，顷刻诵成篇。\n顾我直瞠若，别公还惘然。\n放怀琴酒地，不觉已三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别陈平甫","author":"韩淲","text":"清暑莲堂上，何心咏别诗。\n敢云归计早，常恨结交迟。\n林馆主人胜，江山客子宜。\n相看在霄汉，折取桂高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别郑盱眙","author":"韩淲","text":"谷口从游久，流光恰六年。\n湖山常尽日，樽酒或谈天。\n世岂无他士，公应自昔贤。\n有閒应念我，归去白云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别希之","author":"韩淲","text":"雪里江亭醉，何时复赋诗。\n岂无閒地饮，那有主人奇。\n忍别君言论，徒劳我梦思。\n尺书频寄取，莫负此襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子功过别","author":"韩淲","text":"细酌林亭久，风烟起近钟。\n苍苍虽暮色，淅淅是秋容。\n老眼浑相对，幽怀不易逢。\n人生几两屐，小榼尚能供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客楼南窗晴日中与坐客论别","author":"韩淲","text":"楼馆南窗暖，追随欲别时。\n青衫空自老，白发未相知。\n研墨因成事，炉烟静入诗。\n家山有泉涧，休问我归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄章泉","author":"韩淲","text":"苔竹轩前笋，薰风已布阴。\n清诗谁可和，白酒自成斟。\n顾我尘埃迹，思君泉石心。\n一贫驱就禄，不觉二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄斯远","author":"韩淲","text":"不识后田路，林庐近石阿。\n卜居谁晤语，屏迹自婆娑。\n木落灵山出，风凉玉水波。\n明年当共醉，尽日为长哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄周景瑜","author":"韩淲","text":"春山风物美，秋半复如何。\n岩桂香仍发，芙蓉花更多。\n绩文应委曲，猎德且婆娑。\n閒僻离群久，新凉入短歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄章丘","author":"韩淲","text":"扬雄一区宅，今乃在章丘。\n老树叶丛茂，小溪滩乱流。\n鸡豚为岁计，谷米望秋收。\n晓暮襟怀里，携琴得句不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄杨伯升","author":"韩淲","text":"趁虚鸡犬杂，清有草玄家。\n支径开山嘴，长桥过水涯。\n岁寒梅弄蕊，春到柳舒芽。\n城里归时晚，年华与物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄亨中","author":"韩淲","text":"冬至后踰月，风霜欠雪霏。\n团源新市井，高隐旧书帏。\n薪水谁为给，山园自不归。\n岁前春事动，佚老是忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巩仲至和张少卿韵约同寄一首","author":"韩淲","text":"叹息南湖老，诗禅只自深。\n雨花归宴坐，风叶对孤斟。\n城郭舟车会，斋房翰墨林。\n遥知定中起，吟啸也如瘖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王教授同寄昌甫器远无为临漳 其一","author":"韩淲","text":"长哦招隐句，待月坐黄曛。\n望望前村雨，行行别渚云。\n敢期千里共，常恨一桥分。\n鬓影吹凉处，楼高孰与论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王教授同寄昌甫器远无为临漳 其二","author":"韩淲","text":"月到章泉白，冥濛入杳茫。\n四边山影乱，一路水声长。\n促织吟方动，流萤起复藏。\n梦思飞羽翼，已堕晏斋傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王教授同寄昌甫器远无为临漳 其三","author":"韩淲","text":"清时朝迹后，休道不知津。\n城市谁多客，山林自少人。\n尽常开老眼，应甚惜閒身。\n爱月闻吴咏，无嫌更荐绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王教授同寄昌甫器远无为临漳 其四","author":"韩淲","text":"濡须谁筑坞，玉兔王迷离。\n两岁能为守，五言应报诗。\n息峰延月夜，稔稻得秋时。\n湖海惊零落，无痴了事儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王教授同寄昌甫器远无为临漳 其五","author":"韩淲","text":"瓯闽何处是，绝岭更危溪。\n乘障消蛮虺，望洋蒐水犀。\n庾公情不浅，朱老世思齐。\n乘月胡床坐，角巾随意低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫回自大明见过别后二诗寄之 其一","author":"韩淲","text":"袖遗大明果，编因徐照题。\n骚吟归是正，香味得非迷。\n邻邑十方转，到城还重携。\n新霜林路滑，山远羡高栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫回自大明见过别后二诗寄之 其二","author":"韩淲","text":"早鬻翁归去，窗寒自拨灰。\n算程明日到，失记去年来。\n雨叶频仍堕，雪梅相次开。\n吾生亦华发，易怕惹尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄郑一","author":"韩淲","text":"禅月台高冷，溪虚城背山。\n人烟知井络，鸟雀见湾澴。\n竹里繁霜后，梅边欲雪间。\n读书有幽子，岁晚更怡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄履道","author":"韩淲","text":"宰上庐深迥，将书定苦心。\n夜声寒柏惨，晴色古苔侵。\n径侧牛羊履，山空雁鹜临。\n明灯拨残火，幽梦理寒衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄尹一","author":"韩淲","text":"寻丈方斋地，移居城市东。\n灯窗唯刻苦，编集入磨砻。\n北客家能尔，南游事不同。\n常思文献大，祖道古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄王二万顷","author":"韩淲","text":"一曲清江上，君能静结庐。\n年丰时酿黍，身老更收书。\n家世遗风在，闾阎是事疏。\n只宜沮溺地，著我伴耕锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十九日归寄郑一","author":"韩淲","text":"野外青岩寺，城边禅月台。\n收功行药后，排闷坐舆来。\n宿雨苗当熟，新凉桂已开。\n谁知老丘壑，自不奈尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浙运寄声子任子恕","author":"韩淲","text":"浙水文场好，成才属少年。\n龙游看过锁，渔浦发潮船。\n才地当强仕，朝廷正选贤。\n会逢余与赵，为报各扬鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄敖器之","author":"韩淲","text":"绝代敖夫子，春来定若何。\n新丰逆旅市，叩角饭牛歌。\n汉相延东阁，成周在泰和。\n汇征调玉烛，小用亦金坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄仁□","author":"韩淲","text":"分外僧家好，如今更住山。\n都无城市闹，只有水云閒。\n打供随缘后，罢参开净间。\n纷纷底荣宦，何事复相关。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵寺丞之子来代书寄","author":"韩淲","text":"只有心情在，都无言语吟。\n子官忻见面，翁节苦为心。\n霜雪岁云暮，风雷冬已深。\n老身相望处，徒益鬓华侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬周五哥","author":"韩淲","text":"我欲春山去，呼儿取杖藜。\n弄晴方见日，吹雨又生泥。\n怅望还归舍，怀思未隔溪。\n会当舒此兴，花草步芳蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵十监试","author":"韩淲","text":"先朝重词赋，人道小贤良。\n善记推才博，雕章验识长。\n宗英龙首盛，名字雁行香。\n王舍城中试，月华仙桂芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵十 其一","author":"韩淲","text":"泉石何关尔，多应洁我尘。\n试揩双泪眼，徒惜一吟身。\n选甚年年别，须当物物亲。\n相遭虽澹泊，秋得雨方新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵十 其二","author":"韩淲","text":"薄梦惊秋晓，穷原喜夕阴。\n只知閒迤逦，不觉老侵寻。\n鸟翼应知倦，蝉声亦和吟。\n酒阑诗更逸，岩寺记同临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠成季子任","author":"韩淲","text":"心迹能閒淡，何劳数面亲。\n沙坑元似故，坎石更常新。\n陶写非流俗，寻思隔几尘。\n清溪舟楫句，乃复在兹辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠勤老","author":"韩淲","text":"客路何曾好，禅林一味清。\n钟声回短梦，梵呗入幽情。\n绮语多生债，尘劳宿念轻。\n诗边怀抱懒，聊复为君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵成父","author":"韩淲","text":"教得儿登第，儒科一素风。\n故家欣未艾，吾党不应穷。\n拭目行都里，兴怀寓里中。\n如君老兄弟，好去一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠子任","author":"韩淲","text":"每恨沙坑远，十年才两过。\n閒人身则尔，君子意如何。\n古井无惊浪，乔林不改柯。\n留连因缱绻，踯躅为婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠曾承务","author":"韩淲","text":"绍兴人物志，赣上盛诸曾。\n积厚培应固，流长续更兴。\n四明愁独散，二浙喜相承。\n再缉文盟日，吾侪岂面朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初六日呈仲至兄闻告假欲还婺","author":"韩淲","text":"已是多疏隔，更言当暂归。\n岁新云未解，风转雪还飞。\n晓岸苍山古，春江白浪肥。\n过家无宿留，急此醉芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈坐客","author":"韩淲","text":"酒在诗情外，诗成酒量中。\n气清吟奥妙，神受醉朦胧。\n到手千钟在，回身一笑空。\n故家人有几，我辈兴无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王有道诗刊成谢林教授","author":"韩淲","text":"七卷灵溪集，有谁能为传。\n既劳亲校勘，便得与雕镌。\n从昔诗虽在，因兹名可全。\n摩挲新叙引，羡尔广文贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月十九日头昏痛忽教授过别","author":"韩淲","text":"卧病空山里，公来忽语离。\n风行残叶日，霜净早梅时。\n湖上探龙井，天边入凤池。\n西畴富鱼蟹，能复寄清诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡教授","author":"韩淲","text":"犹记到阶除，虚怀不自居。\n从容姑借酒，厌饫惬于书。\n物物徒娱客，人人足胜予。\n年来数相过，此道定谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用处晦韵送蕲州赵教授有怀寺簿王圣俞丈","author":"韩淲","text":"得官居上第，掌教喜青春。\n敩学须相长，仁贤必可亲。\n举文元不易，斯道本常亲。\n若理中州话，应逢旧德人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和孟五十六韵","author":"韩淲","text":"沙净水争流，舆篮呼渡幽。\n酒行因缱绻，诗到得夷犹。\n盛日腾高步，飞云裂醉眸。\n江山无尽藏，楚尾又吴头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫梦中见寄","author":"韩淲","text":"高人山枕晓，何必问钧天。\n自觉无他梦，谁言有此篇。\n交游疑是熟，时序亦非便。\n寒食蘧蘧里，清江忆钓鳊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫题徐仙民诗集因和韵两篇 其一","author":"韩淲","text":"断自晚唐后，人人尽做诗。\n生前由我集，名后得谁碑。\n眇眇三灵见，萧萧一叶知。\n塔山林覆土，若奠替芳卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫题徐仙民诗集因和韵两篇 其二","author":"韩淲","text":"东南蟠海峤，天也斲閒民。\n岁月高侪侣，江湖竞比伦。\n杨刘万代手，温李再生身。\n雪跨水悬处，游魂不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和子仁","author":"韩淲","text":"古达多从隐，巢由复卞随。\n既拚身似叶，何藉命如丝。\n世道无庸憾，人生有不为。\n深山穷谷里，莫负酒盈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周七有诗续至和韵","author":"韩淲","text":"净坊成野约，乐地可清论。\n士以世何贵，佛于人转尊。\n茫茫空远志，历历任惊魂。\n连日岩花发，佳哉月下门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和履道出会宗伯回访赵晏叟 其一","author":"韩淲","text":"山行仍野次，零落数家村。\n积雨浮秧把，随风护笋根。\n去来应自喜，将送与谁论。\n寝饭朝昏处，翛然付五言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和履道出会宗伯回访赵晏叟 其二","author":"韩淲","text":"江山迎世父，芒种夏将深。\n家道修遗事，人生怀好音。\n衰荣元自古，雅俗况居今。\n归兴寻幽隐，柴门月色侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫有诗和韵","author":"韩淲","text":"寒食家家酒，谁人不赋诗。\n久阴忻霁日，馀润入花时。\n此老非三略，今朝欲四维。\n落红供醉卧，松底著残棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫入城席上和韵","author":"韩淲","text":"因人虽暂赏，分韵偶然成。\n不道觥慵举，那知仆屡更。\n老成关世道，交旧岂时情。\n檐雨林逾静，桥风境过清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]