[{"title":"上知府大同王太尉六首 其三","author":"魏野","text":"五等诸侯稀五福，三朝官只欠三台。\n下车一变熙熙景，宾閤多开印少开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府大同王太尉六首 其二","author":"魏野","text":"暂辍居留从洛邑，坐棠亦恐不多时。\n皇储新策闻求辅，位冠春宫更是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府大同王太尉六首 其一","author":"魏野","text":"两地曾辞最重权，功如温树懒能言。\n从来富贵知何限，少有元戎是状元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乞笺纸寄犀浦王专著作","author":"魏野","text":"故人何处暂驱鸡，犀浦封疆濯锦西。\n五色彩笺宜寄惠，知君管得浣花溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书三门开化院琳师房","author":"魏野","text":"四边浪打山疑动，寺在半空山顶头。\n绕槛门窗多昼掩，应嫌坐卧见沉舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书黄池谷王山长屋壁","author":"魏野","text":"仲先曾到仲淹家，书院穿云一径斜。\n劝酒莫言无乐送，音声鸟语在山花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太保琅琊相公见惠酒因成二绝用为纪谢 其一","author":"魏野","text":"从前相辅皆频出，独在中书十五秋。\n太岳汾阴封祀了，这回好共赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太保琅琊相公见惠酒因成二绝用为纪谢 其二","author":"魏野","text":"玉液定从金口辍，曹樽分又到颜瓢。\n虽无愁闷凭销处，曲糵恩浓岂易销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安龙图陈学士宠示重阳日翠微楼上见览拙诗之作兼蒙寄翠微楼长乐亭二记各述一绝寄而谢之","author":"魏野","text":"京兆重阳大尹家，翠微楼上赏黄花。\n秦娥应怪停歌吹，看我狂诗到日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安龙图陈学士宠示重阳日翠微楼上见览拙诗之作兼蒙寄翠微楼长乐亭二记各述一绝寄而谢之 翠微楼","author":"魏野","text":"斗城谁建翠微楼，富贵陈家小状头。\n和记从今为四绝，凤毛玉箸与银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日述怀","author":"魏野","text":"瘿枕闲攲苇箔褰，浩然情性雪晴天。\n却嫌雏鹤饶声气，惊觉茅檐曝背眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用晦上人游渼陂","author":"魏野","text":"渼陂寒水碧溶溶，野客江僧望不穷。\n更值晚来风雨歇，终南一半浸波中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白菊","author":"魏野","text":"浓露繁霜著似无，几多光彩照庭除。\n何须更待萤兼雪，便好丛边夜读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹇 其三","author":"魏野","text":"水国笼来到水村，也应怀土也怀恩。\n曾为闲客还同我，今日俱遥旧相门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹇 其四","author":"魏野","text":"李白诗中闻未识，谢庄赋里见长思。\n今朝得尔心虽喜，致谢惭无吐凤诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹇 其一","author":"魏野","text":"万里南禽未说珍，且论得处到来因。\n尚书远托谁相寄，制策登科第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹇 其二","author":"魏野","text":"山鸡形状鹤精神，纹似涟漪动白蘋。\n物异恩殊堪郑重，庙堂人寄草堂人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同闰师宿三门开化院二首 其二","author":"魏野","text":"瘦筇轻锡共携游，砥柱峰前宿寺楼。\n各有溪居懒归去，经旬不是两相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同闰师宿三门开化院二首 其一","author":"魏野","text":"白莲社主碧溪人，同宿三门寺里云。\n四面涛声秋更怒，并床犹恐话难闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬知开封县钱易学士见寄三首 其三","author":"魏野","text":"珠落银钩向玉笺，不还合浦到溪边。\n无双双美真堪爱，似听湘娥鼓舜弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张生示予咏菊诗且古之作者迟晚之意颇同体状之功未尽因书一绝以答之","author":"魏野","text":"正当摇落独芳妍，向晚吟看露泫然。\n还似六宫人竞怨，几多珠泪湿金钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和长安龙图陈学士登熙熙台之什二首 其二","author":"魏野","text":"台号熙熙倚半空，新秋景好与春同。\n朱衣吏列登临处，百二山河一望中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和江南提刑王国博见寄","author":"魏野","text":"欲写情怀难一一，拟寻山水隔千千。\n输他吴越闲鸥鹭，朝夕常亲画舫前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和薛田察院咏雪三首 其三","author":"魏野","text":"密压溪筠入户斜，照开睡眼不须茶。\n谁言落处无偏党，牵率诗家比酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和薛田察院咏雪三首 其二","author":"魏野","text":"七字空吟六出花，与君无酒祇烹茶。\n门前俱绝行踪迹，还似袁安卧在家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和薛田察院咏雪三首 其一","author":"魏野","text":"林间踏去宜沽酒，石上收来好煮茶。\n除却子猷当此景，高情偏忆戴逵家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和薛察院同龙门知县刘大著洎数公禹庙留题","author":"魏野","text":"七人庙下立徘徊，相顾闲心几欲摧。\n落日堪伤四散去，再来难得一齐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府石太尉闲抱瑶琴荣临圭窦烧笋供膳刻竹题名因成二绝纪而谢之 其二","author":"魏野","text":"笋就林烧厌八珍，烟为翠幕草为茵。\n功臣名姓留何处，自把金刀刻翠筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知府石太尉闲抱瑶琴荣临圭窦烧笋供膳刻竹题名因成二绝纪而谢之 其一","author":"魏野","text":"分茆人忽到茅斋，踏破溪边万点苔。\n却恐歌钟喧静境，随轩祇背古琴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"魏野","text":"谁人把我狂诗句，写向添苏绣户中。\n闲暇若将红袖拂，还应胜得碧纱笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"魏野","text":"城里争看城外花，独来城里访僧家。\n辛勤旋觅新钻火，为我亲烹岳麓茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柽师告归庐岳赠之筇杖","author":"魏野","text":"瘦筇生本接西蛮，我已携来二十年。\n辍赠柽师归老处，称将吟倚虎溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独酌吟","author":"魏野","text":"独酌独吟谁与共，天为知己月为朋。\n水边醉卧无人见，席有烟莎枕有肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盆池萍","author":"魏野","text":"乍认庭前青藓合，深疑鉴里翠钿稠。\n莫嫌生处波澜小，免得漂然逐众流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜与陈孟话别","author":"魏野","text":"草堂灯暗雨萧萧，欲话分携重郁陶。\n何事琴中犹怨切，凄凉调里鼓离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王甲宰青石县","author":"魏野","text":"陶潜但植当门柳，潘岳惟栽满县花。\n争似伯玄青石去，教民先只种桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王希赴任衢州判官","author":"魏野","text":"秋江四十有馀程，称作红莲泛去清。\n从阙到州堪羡处，船中坐卧看山行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王国博赴江南提刑 其三","author":"魏野","text":"江南大半旧经过，君称心多我恨多。\n好景阻陪游赏去，空萦老病动悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王国博赴江南提刑 其一","author":"魏野","text":"江南按察去如何，诏敕虽然密赐多。\n不断仙舟来往处，狎鸥载鹤听渔歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王国博赴江南提刑 其二","author":"魏野","text":"江南刑省到时和，十郡应从宴乐多。\n自有山迎兼水送，清阴不断胜清歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘法曹东归","author":"魏野","text":"上官多是叹穷途，得替行装尽有馀。\n唯有甘棠刘法掾，来时骑马去骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送寿师新加命服后归蜀","author":"魏野","text":"日照孤云作彩霞，帝乡风送去天涯。\n野人遥望归何处，万里峨嵋便是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送俞太中山人归终南","author":"魏野","text":"俞贯之辞魏仲先，终南归去落花天。\n如何相见还相别，早晚溪云一处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宣笔与成都司理刘大著","author":"魏野","text":"宣城彩笔真堪爱，蜀色红笺更可誇。\n雅称风流刘大著，闲时题咏海棠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐肃察院赴东川提刑","author":"魏野","text":"按察东川十四州，几多山水似蓬丘。\n清时应喜无冤雪，赢得乘骢到处游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送袁景宗之荆渚宁觐","author":"魏野","text":"荆渚北堂宁圣善，棠阴东阁别严君。\n雪村山馆思亲梦，二十馀宵两处分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谔师赴王寺丞召写碑","author":"魏野","text":"才高吐凤欺黄绢，墨妙回鸾命碧云。\n双美便堪传万古，羲之书法退之文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛阶迎觐察院","author":"魏野","text":"知心人去野人孤，犹赖时时见凤雏。\n病里凤雏辞又去，老身纵健不如无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻张师德状元登第因以寄贺兼呈梁固状元","author":"魏野","text":"科场消息到柴扉，皇宋风流事可知。\n封禅汾阴连岁榜，状元俱是状元儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻潘阆新授滁州散参因以寄贺","author":"魏野","text":"江乡去想胜还乡，官职寻常事不常。\n会得圣君无别意，只应图继贾司仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓","author":"魏野","text":"露侵短褐晓寒轻，星斗阑干野外明。\n寂寞小桥和梦过，豆花深处草虫鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题仙游寺","author":"魏野","text":"将从三峡泛扁舟，先向仙游寺里游。\n水石却惊偏怪异，江山狂兴一时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题浐川姚氏鸣琴泉","author":"魏野","text":"琴里休誇石上泉，争如此处听潺湲。\n爱于琴里无他意，落砌声声是自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题敷水李先生隐居","author":"魏野","text":"棠树阴中来得得，莲花峰下去迟迟。\n好将门外岩磨取，为刻西巡御赐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈越学士","author":"魏野","text":"损之不见数年馀，万种相思一事无。\n唯有近来茅屋梦，为君时复到皇都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庞房","author":"魏野","text":"爱于瘦马上吟诗，孟浩然真更似谁。\n雅称自将图画看，况君小笔胜王维。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄俞太中山人","author":"魏野","text":"太白空来数百年，贯之今称隐其閒。\n静应笑我藏名拙，惹得人多到竹关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题洪州华林胡氏书斋","author":"魏野","text":"江僧昨日到茅斋，曾向华林挂锡来。\n因说胡家宗族盛，御书楼对义门台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄盩厔知县解旦著作","author":"魏野","text":"盩厔乐天初任地，此时君又继多才。\n閒应时到游仙寺，石上题诗扫绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日离蓝田白鹿原寄王太博","author":"魏野","text":"白鹿原东晓色中，人家新火翠烟浓。\n岂惟心友难为别，驴上回头恋玉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪竹","author":"魏野","text":"溪南一向几多垂，欲咏终难比并伊。\n应是彤庭将御试，麻衣群见折腰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢大著刘烨寄惠玉笺","author":"魏野","text":"皎洁分明如我鬓，卷舒方正似君心。\n三千里外情多少，一幅真堪值万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢王耿太博惠藤床王虞部惠藤枕","author":"魏野","text":"藤床藤枕睡腾腾，软胜眠莎与曲肱。\n知似边韶偏寄惠，梦中长亦感心朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢龙图李待制见寄 其一","author":"魏野","text":"烟霄闲似在烟霞，唯有龙图学士家。\n和了御诗垂锦帐，卧听仙乐出宫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢龙图李待制见寄 其二","author":"魏野","text":"遥知清贵孰能攀，天上闲胜地上闲。\n除对圣君论道外，时题诗句落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢孙大谏惠茶","author":"魏野","text":"卢仝曾谢谏官茶，狂作长歌任过誇。\n争似君今相惠者，分从金口到村家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢孙舍人题名水亭因有纪赠","author":"魏野","text":"紫微客写青苔壁，不与寻常姓字同。\n多谢溪烟知我意，预先替作碧纱笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢知府寇相公降访 其一","author":"魏野","text":"昼睡方浓向竹斋，柴门日午尚慵开。\n惊回一觉游仙梦，村巷传呼宰相来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢知府寇相公降访 其二","author":"魏野","text":"中书两入寇尚书，出镇雄藩半载馀。\n棠树阴中无讼听，闲骑宝马到茅庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢益州司理刘大著寄惠筇竹杖","author":"魏野","text":"虽胜斑竹与红藤，绝远羸躯岂易凭。\n争得化龙归锦水，老身骑去见心朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢薛省判寄惠鹤","author":"魏野","text":"早辍仙禽寄逸民，年来亦似厌家贫。\n时时东望长鸣处，应忆朱门旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢薛端公寄惠素纱","author":"魏野","text":"鹤色纱蒙乌府寄，裁衣不称著林中。\n水亭君有亲题处，留待他时染碧笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王太博见寄","author":"魏野","text":"锦川谁为寄阳春，清净堂中清净人。\n二十八言刊石处，长如列宿照闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬薛田推官见赠","author":"魏野","text":"红莲客惠碧云篇，未及他山买石镌。\n且选眼前粗竹上，和烟大刻两三联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮秋怀闰师","author":"魏野","text":"风清月白树红时，无奈重城隔闰师。\n却羡潺湲阶下水，夜深流入白莲池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题闰师禅庭双竹","author":"魏野","text":"离丛并长对禅扃，乍见翻疑是一茎。\n我恨与师居隔郭，他生愿似此君生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题僧寺","author":"魏野","text":"世情冷暖由分别，何必区区较异同。\n但得常将红袖拂，也应胜似碧纱笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]