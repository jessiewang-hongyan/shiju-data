[{"title":"尝卢橘","author":"释德洪","text":"皮似柿椑发易剥，核如龙眼味芳鲜。\n满盘的砾如金弹，丛手分尝忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新竹","author":"释德洪","text":"琅玕数本倚墙阴，新笋均条忽作林。\n昨夜小轩添得境，却烦佳月碎筛金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚三首 其一","author":"释德洪","text":"梨杖晚经桑柘坞，园林秋尽露人家。\n破篱犬吠柴门掩，寒犊自归山日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚三首 其二","author":"释德洪","text":"碧云红树晚相间，伫立不堪游子情。\n划破秋空一行雁，断肠南去两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚三首 其三","author":"释德洪","text":"紫梨红枣八九树，竹屋柴门三四家。\n机杼声迟秋日晚，绕篱寒菊自开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中山茶","author":"释德洪","text":"绿罗架上破红裙，占得春多独有君。\n那料晓来犹带雪，素衣丹顶鹤成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙高梅花","author":"释德洪","text":"戏折寒梅画里传，便知香爨揽佳眠。\n爱吾花木逡巡有，乾笑春风入暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琛上人所蓄妙高墨戏三首 其一","author":"释德洪","text":"年年长恨春归速，脱手背人收拾难。\n那料高人笔端妙，一枝留得雾中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琛上人所蓄妙高墨戏三首 其二","author":"释德洪","text":"脩叶闹花增秀色，为谁幽径撒秋香。\n还如此元行藏处，不为无人亦自芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琛上人所蓄妙高墨戏三首 其三","author":"释德洪","text":"一幅湘山千里色，碧天如水盖秋宽。\n磨钱作镜时一照，乞与禅斋坐卧看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵翁教授见寄","author":"释德洪","text":"仙郎落笔敏惊鸿，文字追回两汉风。\n脱腕旧闻供十吏，探怀行看取三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作","author":"释德洪","text":"无赖春风试怒号，共乘一叶傲惊涛。\n不知两岸人皆愕，但觉中流笑语高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦","author":"释德洪","text":"玉纤金钏隔窗纱，醉整残妆满镜花。\n撼地跳珠千丈白，骨飞宁复用毛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过小院僧窗有假山绝妙作庐山势书此","author":"释德洪","text":"庐阜归心久未降，梦魂时复渡湓江。\n忽惊古寺秋庭上，翠蹙烟峦对矮窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五首 其一","author":"释德洪","text":"成破须臾知世相，雨云翻覆见交情。\n何时一叶春湖阔，塞管横风夜月清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五首 其二","author":"释德洪","text":"正尔思山想归路，偶行看雪立阶除。\n忽惊昼永轩窗迥，推抵清寒拥燎垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五首 其三","author":"释德洪","text":"怀中但自除衣垢，面上从教有唾痕。\n负日风檐成坐睡，梦随鸥鹭落江村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五首 其四","author":"释德洪","text":"莓苔遍地榆钱满，院落无人柳絮飞。\n信手翻书香篆冷，夕光山翠上窗扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵五首 其五","author":"释德洪","text":"措置已落古人后，猛省令人愧衲裙。\n庐山好处轩窗在，留眼归看五老云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵巽中见寄四首 其一","author":"释德洪","text":"君才俊却海东青，鼻笑生华笔有灵。\n寄我小诗足风味，展开如对镜中形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵巽中见寄四首 其二","author":"释德洪","text":"卧念高人最起予，时时想见秀眉疏。\n石门自古无佳句，寄语云山莫放渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵巽中见寄四首 其三","author":"释德洪","text":"停蓄幽怀万顷波，一倾要及少年时。\n正当清啸寻君去，已办登山绿玉枝。\n别后梦归关不住，得归车已走先锋。\n催诗疥子捞春瓮，有味难言却皱容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢人惠芦雁图","author":"释德洪","text":"道林烟雨久不到，忽见橘州芦雁行。\n笑里笔端三昧力，坐中移我过潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湓江宿舟中","author":"释德洪","text":"琵琶亭下孤舟宿，夜静风清水四围。\n蝴蝶梦中江月白，芦花鸣笛钓船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过芜湖晚望","author":"释德洪","text":"尽日舟中情思疲，晚来何处最幽奇。\n沙鸥数只妆江面，云带两条山画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东流阻风","author":"释德洪","text":"秋叶丛边风索索，迎宾亭下水瀰瀰。\n蓼花深处老渔父，更把床头羌笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙先辈见寄二首 其一","author":"释德洪","text":"从来佳句出寒饿，太白飘零子美穷。\n箸下万钱如有意，作诗遣兴不须工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙先辈见寄二首 其二","author":"释德洪","text":"长欲探怀取卿相，对人信口比伊周。\n安知投老空拳在，句法不医双鬓秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过湘江题慈云寺壁","author":"释德洪","text":"慈云寺在古城隈，月阁风轩照水开。\n独倚阑干秋雨后，青山相逐渡江来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游读旧题","author":"释德洪","text":"渡头路入白云隈，断岸柴门窈窕开。\n忽忆去年曾过此，拂尘闲看旧题来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚归福严寺","author":"释德洪","text":"浅抹浓堆翠却烟，老松无数更苍然。\n石梯又入千峰去，时见楼台夕照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵亭上人长沙雪中怀古二首 其一","author":"释德洪","text":"楚国楼台凌九霄，软风行复弄柔条。\n当年弦管今何处，飞雪满空如舞腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵亭上人长沙雪中怀古二首 其二","author":"释德洪","text":"数峰江上晓不见，指点先烦楖标条。\n却望苍崖寻折干，偃松梢重压龙腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书白水寺壁","author":"释德洪","text":"寒岩花木斗迎春，古寺修筠战雨声。\n负日晴轩成坐睡，朦胧何处鹧鸪鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过长马市","author":"释德洪","text":"长马人家古道旁，秋来禾黍已登场。\n池塘水落菱蒲冷，篱落霜晴橘柚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书湛然亭","author":"释德洪","text":"家在匡庐叠翠层，云开彷佛见微棱。\n褰衣欲上千岩去，隔岸扁舟唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张敏叔画桃梅二首 其一","author":"释德洪","text":"要看红雨滴残春，作阵惊飞乱蝶群。\n好在一枝长不死，谩烦诗笔扫烟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张敏叔画桃梅二首 其二","author":"释德洪","text":"玉骨冰姿过眼空，却烦摹刻倩诗工。\n暗香错莫知谁写，多谢黄昏一阵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉先归大梁二首 其一","author":"释德洪","text":"残秋千里游梁去，破浪扁舟别我来。\n对坐无言看山月，一庭松雨在莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉先归大梁二首 其二","author":"释德洪","text":"闲人忙事莫参差，各梦同床暗发嗟。\n相值一欢难把玩，摩头输子看京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题贲远书房","author":"释德洪","text":"轩上仙郎面如玉，槛前修竹翠于葱。\n壁开他日春眠足，应对同僚话故丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李商老自山北道中作诗见寄次韵","author":"释德洪","text":"蹇驴醉颊兀红酣，眼艳秋波望翠岚。\n长向诗中见风度，爱君笔力似黔南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至崖州吃荔枝","author":"释德洪","text":"口腹平生厌事治，上林珍果亦尝之。\n天公见我流涎甚，遣向崖州吃荔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至海昏三首 其一","author":"释德洪","text":"前身定是赤头璨，风帽自攲麻苧衣。\n久客琼崖看诗律，袖中藏得海山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至海昏三首 其二","author":"释德洪","text":"我老又穷交旧绝，姓名面目畏知闻。\n餐痂是病竟不悟，裹饭相从独有君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至海昏三首 其三","author":"释德洪","text":"天公无计奈此老，时复致之拴索间。\n寄语故人休念我，幸因王事得游山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵壁间蒋侯诗","author":"释德洪","text":"轩前丛玉是谁种，笑里风姿件件宜。\n耐久节高真不屈，此情惟有雪霜知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石台寺","author":"释德洪","text":"岁晏身心无一事，江山信美又吾乡。\n去年今日黄河北，夜趁明驼上太行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永固登小阁","author":"释德洪","text":"老僧乞食城郭去，小阁无人独自登。\n急雨忽来添瞑色，诸峰领略露寒层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会性之山中二首 其一","author":"释德洪","text":"秋来林下偶相寻，松雨风泉一径深。\n小立听君临水语，十分知我住山心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会性之山中二首 其二","author":"释德洪","text":"江山千里笑谈中，暖热寒泉出伏龙。\n却看秋容能拂掠，夕阳无语敛眉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"守道太尉醉乡","author":"释德洪","text":"欢伯平生数往还，个中城郭未尝关。\n暮归健倒三四五，凭仗酪奴扶玉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世明九客同登滕王阁索诗口占","author":"释德洪","text":"西山出云青未了，九客凭栏一笑时。\n秋天便是一张纸，写取江南觉范诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其一","author":"释德洪","text":"小县风光秀句传，太平无象宰君贤。\n虽非社日长闻鼓，不是炊时亦有烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其二","author":"释德洪","text":"作官要自有家法，童稚熏蒸饱见闻。\n堆案文书谈笑了，先将勤政报君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其三","author":"释德洪","text":"去年苛政如狼虎，盗贼纵横民散居。\n那料春来见天日，抱孙门巷买犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其四","author":"释德洪","text":"社饮扶携春日和，柘冈麦垄竟相过。\n不因旧岁追胥苦，安得春来喜气多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其五","author":"释德洪","text":"无数花红霞委地，几重云碧幕摊空。\n遥知客退西园里，尽落登临语笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其六","author":"释德洪","text":"庭讼凋残道气增，早衙清磬夜香灯。\n吏人莫作官人看，我是南州有发僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其七","author":"释德洪","text":"弄晴雨过秧针出，花信风来麦浪寒。\n想见丰登民讼少，长官行摺道书看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠胡子显八首 其八","author":"释德洪","text":"烟鬟散乱犹梳月，谷口含胡欲吐云。\n山寺闭门春睡足，可怜凭槛不同君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何忠孺出芝草三本皆黄色指其小者曰昔登第时产此今重华为作此","author":"释德洪","text":"家山又产灵芝瑞，天独于君著意深。\n层秀已成重盖兆，色黄更类笏头金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古鼎","author":"释德洪","text":"器分三足真神物，具体而微有旨哉。\n我识地灵先献瑞，知公才业足盐梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟行书所见","author":"释德洪","text":"剩水残山惨淡间，白鸥无事小舟閒。\n个中著我添图画，便似华亭落照湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡羹","author":"释德洪","text":"分外浓甘黄竹笋，自然微苦紫藤心。\n东坡铛内相容摄，乞与馋禅掉舌寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿芙蓉峰书方丈壁三首 其一","author":"释德洪","text":"二十六窝猿臂上，夜晴引手酌星河。\n忽惊此地羊肠险，世路羊肠崄更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿芙蓉峰书方丈壁三首 其二","author":"释德洪","text":"赤髭病客烟瘴面，漆瞳道人冰雪容。\n俯槛夜残看落月，不知脚下有千峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿芙蓉峰书方丈壁三首 其三","author":"释德洪","text":"人间热恼不到处，一室篝灯到晓明。\n枕臂聊为吉祥卧，雪猿声与梦俱清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过宝应访达川不遇书其壁","author":"释德洪","text":"屋老僧残湘水滨，丛林气象傲比邻。\n莫嫌川客贫彻骨，满院青春不借人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵曾侯分春亭","author":"释德洪","text":"杖藜庭下花如海，红浪颠风急雨时。\n分得春归无著处，都将裁刻入新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晚起","author":"释德洪","text":"春眠失晓殊可喜，红日曈昽闻唤起。\n平生嚼蜡观世间，一觉梦乡如此矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵春风","author":"释德洪","text":"吹鬓风俱小雨来，残红扫尽露苍苔。\n稻畦绿锦无边幅，更欲烦君为剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题葆光庵","author":"释德洪","text":"一庵万事不挂眼，孤坐枵然龟六藏。\n漆园摸索太饶舌，强为立名为葆光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵棋堂","author":"释德洪","text":"画戟丛中小寝惊，日长闲试道衣轻。\n含风广厦过微雨，宾从时闻下子声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵西楼","author":"释德洪","text":"万古湘江绕故城，水光夕照动檐楹。\n行人仰看春风软，吹落凭栏笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月登湘阴景醇湖山堂时江涨而雨未止","author":"释德洪","text":"烟雨溟濛暗小窗，湖山堂下水连江。\n已欣一叶浮千顷，更爱飞来白鸟双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又登邓氏平远楼纵望见小庐山作","author":"释德洪","text":"倚栏天际数归帆，春在沧州数笔间。\n我与小楼俱是画，雨中犹复见庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"意行入古寺见邓生之富以谷量牛马寺旧藉余赋诗","author":"释德洪","text":"清明雨过快晴天，古寺寻春亦偶然。\n浓笑春风穷似我，也将柳絮当榆钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]