[{"title":"赐陈抟 其二","author":"赵炅","text":"餐霞成鹤骨，饵药驻童颜。\n静想神仙事，忙中道路闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐陈抟 其一","author":"赵炅","text":"苍生往世弊凋残，今我如同赤子看。\n大阐无为三教盛，承平方说四夷宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐陈抟 其三","author":"赵炅","text":"曾向前朝出白云，后来消息杳无闻。\n如今若肯随徵召，总把三峰乞与君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十二","author":"赵炅","text":"万灵通有感，臧否在名人。\n志诚昭明德，清净见于真。\n奉道惟恭谨，修持愿本因。\n广将求利益，苦乐救生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"逍遥闲物外，大道体柔刚。\n山河穷不尽，人心自短长。\n尘泥常暧昧，日月瑩辉光。\n出没机关内，调持迥有方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十一","author":"赵炅","text":"伏藏终不见，巧拙是兼非。\n至道光怀古，周通隐圣机。\n清天何物性，浊地故相依。\n修鍊真堪惜，疏慵有顺违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十","author":"赵炅","text":"千年福寿自由人，万象星罗仰在身。\n宝马不教龟鳖乳，嘉禾须问谷田神。\n根株种植华池内，药鼎煎催运火匀。\n混沌分来皆是道，二仪交感八方亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十七","author":"赵炅","text":"真空修鍊永长年，不识还丹在眼前。\n一得清来光宇宙，千朝须是用烹煎。\n人间天上分明录，汞里花开岂偶然。\n达取但教依理路，勿贪世利误周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"一受诸同气，熙和理道平。\n乘云无滞碍，大树种而生。\n尘垢勿教染，江河顺不争。\n机智潜弃用，方显贵佳名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十五","author":"赵炅","text":"流砂一味细堪观，万象笼罗几百般。\n须向铅中相假合，分成鼎内见其端。\n烟霞聚散归深谷，水火相逢不用乾。\n养就大还升世界，月宫乞取桂花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其九","author":"赵炅","text":"犹龙景象驾翔鸾，道在虚无天地间。\n一二合将归大体，五千言外不开关。\n仪形眇邈难相类，圣迹希夷语默闲。\n昔日西游如似梦，化胡异域却应还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十六","author":"赵炅","text":"善念销嗔恚，无差本自然。\n花开凡叶木，水打急风船。\n拘执恒如缚，能仁学昔贤。\n神明皆正定，消息更深玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"还丹未就且降魔，二八从教细搅和。\n离火摧驱凡入圣，坎铅功力甚偻儸。\n红尘自化真堪贵，白雪增盈不用多。\n九转龙吟成虎啸，人非人是状巍峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十七","author":"赵炅","text":"照然明道德，万象有其端。\n变化疑谁信，超凡入圣看。\n幽玄深自在，眇邈就中难。\n但味风尘里，方知宇宙宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"神丹妙道故延年，岂是凡流识大仙。\n老子尚犹能讳事，轩皇不许乱相传。\n谁知造化功夫力，罕见今生度宿缘。\n猛虎伏来龙驾驭，云腾五色思悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"先贤所诫恐心邪，不说神明道理耶。\n岂信炉中生白雪，是非汞内产丹砂。\n华池自有延龄药，龙虎相逢王几家。\n十月阴阳须满足，馀残审细勿教差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"群生各自意，未有一般般。\n名利贪嗔贼，愚迷道路宽。\n避烦如雨散，清静入云端。\n善想因缘理，经穷子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十七","author":"赵炅","text":"十洲洞府养神仙，岁说桑田屡变迁。\n老子商周为柱史，刘安拔宅上青天。\n名山隐遁非堪守，鍊药修真本自然。\n想取仪形通感应，徒劳运智乱烹煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"五金并八石，一一注仙经。\n雅有深仁行，无非不暂停。\n日华精汞法，月魄鍊砂灵。\n入圣超凡骨，变化本真形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"至药家家有，谁人解得么。\n玄通真法界，妙理谕恒河。\n年岁销风水，芝兰间棘窠。\n阴功阳造化，善少恶中多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"日照光文彩，周通无不关。\n天恩功最大，地载莫休闲。\n绝顶孤松老，飞云野鹤还。\n玄珠名隐奥，杳霭路岐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"天地为炉我自知，人无远虑必生疑。\n功夫未至劳悬想，增外声闻不改移。\n机巧岂逢容易得，是非终究欲何之。\n思量大海深渊理，光阴虚度影参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"道者强名立，清虚隐显深。\n欲行千里路，别探一般心。\n景象空天远，何劳意马寻。\n玄谈通智慧，曩劫至从今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其五","author":"赵炅","text":"一法从何有，三皇五帝前。\n周知多异境，猛利要精专。\n我命须依道，阴功及物缘。\n善心通感应，动静理深玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"物情通万象，达者便忘机。\n各具含灵性，狐疑有是非。\n知天修福惠，如日瑩光辉。\n认取好歧路，恶去善相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其三","author":"赵炅","text":"逍遥通物性，大道有圆方。\n山谷高深浅，人心自短长。\n阴阳穷岂竭，造化入无疆。\n尘埃飞作垢，惊雁不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"还源根本杳难穷，秘密玄微造化中。\n白日昏迷常不见，青龙雾晓大家同。\n阴阳表里和烟碧，天地相鲜似火红。\n直要审详知道理，丹成千载上升功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十六","author":"赵炅","text":"志节还难得，刚柔说是非。\n秋霜明至道，春日丽光辉。\n桂影芳红树，馨香入紫微。\n无穷天地理，语默自依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"冥搜多景趣，悟则顿神清。\n拘束终难得，冲和入道情。\n知微通理性，滋味好研精。\n妙用天然法，阴功蕴大名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十七","author":"赵炅","text":"溟溟沧海浪涛深，雾蔽山峦不易寻。\n紫盖洞庭人驾鹤，虹霓城郭道为林。\n幽玄相去何多少，巧拙无由智慧侵。\n尽是同缘相引接，从容语话八仙心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"天非爱道许人修，学士愚迷不到头。\n内境拟将何所用，杳知深邃故难求。\n丹霞隐密堪依仗，雪月纵横入品流。\n消息顿然潜世虑，凡岐圣路有刚柔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"难求的当问愚痴，那个堪言好事知。\n名利猛贪无有足，多端动止没规仪。\n浮生不实将何用，欲把非常乱作为。\n谩语饶教能配类，一朝患害殢他谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十","author":"赵炅","text":"穷真妙理访仙乡，云水青山地久长。\n闻说洞中诸境异，谁知鼎内有非常。\n遭逢祇是因缘感，费力无成枉用忙。\n瑞气青天含象彩，十洲闲坐论阴阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其三","author":"赵炅","text":"我自常安乐，凡情勿笑耶。\n云生诸洞府，棘不放仙花。\n地卑三光照，天开五色霞。\n未知何所是，善愿理交加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其八","author":"赵炅","text":"道高人世礼周旋，语默如痴似不言。\n洗涤要教心地静，狐疑勿类水萍翻。\n经书说尽修真理，岁月休防罢引援。\n雅合无为深见识，阴阳去住促寒暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","