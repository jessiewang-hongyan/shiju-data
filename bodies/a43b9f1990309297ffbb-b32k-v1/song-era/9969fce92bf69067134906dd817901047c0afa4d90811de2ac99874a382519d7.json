[{"title":"练湖春霁","author":"谭知柔","text":"春入池塘绿涨初，蒲根水暖戏鸥凫。\n杂花开处自深浅，细雨漾空如有无。\n风外钟声闻远寺，柳间帆影出平湖。\n冥搜竟日耽佳句，不负宗生来画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五泄山","author":"郭亢","text":"不到兹山三十年，重来风物自依然。\n两源秋色排千嶂，五级泉声落半天。\n绝唱尚传闲老句，幽栖犹想默诗禅。\n回头迥与尘寰隔，何必蓬莱始是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和榴皮题壁韵 其一","author":"郭椿年","text":"回仙画像留东壁，薜荔团圞拱尺馀。\n昔日丹青今是否，断编何处觅全书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和榴皮题壁韵 其二","author":"郭椿年","text":"欲知古寺传神处，便是东庵饮酒馀。\n谁道逍遥蓬岛客，最能提唱竺乾书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和榴皮题壁韵 其三","author":"郭椿年","text":"百岁光阴殊迅速，满堂金玉谩赢馀。\n岂无白日升天事，未有阴功紫府书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王司理持平堂","author":"王俊","text":"淑问皋陶晞在泮，奉公不挠幕中参。\n仰思弼教刑明五，深念求情法以三。\n虞诩为卿宜有自，于公比德盖无惭。\n圄空草茂庭柯绿，行咏甘棠踵召南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"依韵和董弥大郎中祷雨诗","author":"王俊","text":"雷嗔旱魃蕴烦冤，海底驱龙碧浪翻。\n飞上九天作霖雨，端知昭格佑宸轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林塘双头莲 其一","author":"雷孚","text":"绿柄亭亭拆两枝，开花成实亦如之。\n诗翁想像浑无事，疑是昌宗总角时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林塘双头莲 其二","author":"雷孚","text":"一干双花一扑红，秾花彫尽两心同。\n红成珠实心犹苦，疑是英皇怨舞宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游鲤湖","author":"张?","text":"暝云竹径湿苍苔，岩顶珠宫绝点埃。\n涧水远分山色断，林猿时带笛声来。\n唐朝百载惟诗在，汉事千年若梦回。\n湖鲤犹传灵异迹，无人不道是天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓望 其一","author":"卢奎","text":"武陵都会俗豪奢，井邑云连几万家。\n东望李洲馀橘实，西迎秦洞出桃花。\n宦游稔识衣冠盛，罢去犹怜道路赊。\n十九年来人事改，暮山依旧锁烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓望 其二","author":"卢奎","text":"郡枕寒江卧虎形，池饶千里势宽平。\n曾劳秦楚雄吞并，几误孙刘力战争。\n尚忆笙歌游绿野，岂期牛马牧芜城。\n夕阳杖策闲登赏，怀古观今一怆情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓望 其三","author":"卢奎","text":"郭外临沅一水长，朝宗东下合潇湘。\n昔观竞渡皆游舸，今听鸣鼙尽战航。\n自古胜妖无过德，到头兼弱亦因强。\n看看一洗腥膻尽，千里还闻有芷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自咏","author":"任忠厚","text":"有个官人靡恃己，著领蓝袍罔谈彼。\n面上带些天地玄，眼中更有陈权委。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万岁山","author":"吴致尧","text":"赤藤可扶险，青藜堪照书。\n老师竟何为，暮齿随安车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五盖山","author":"吴致尧","text":"紫盖修连延，五峰似随轩。\n何如惠我民，飞雪遍冈原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圣寿寺","author":"冯安上","text":"特起孤峰耸白云，又环双涧隔红尘。\n枯崖有字唐元杰，古庙无碑舜二臣。\n草木怪灵千种药，山川浓秀四时春。\n邦人竞效封人颂，寺额金书圣寿新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凌烟嶂","author":"冯安上","text":"南山山下多佳石，过眼欣逢诗思得。\n最怜小嶂隔窗前，透出烟光露秋碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门","author":"洪壮","text":"锁断山川秀，包藏云雾深。\n只留禅客在，不许俗尘侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"半月池","author":"洪壮","text":"凿破苍苔地，湾湾月半边。\n既能清到底，何必十分圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拥秀堂","author":"洪壮","text":"松带飞雪暮，檐支落日闲。\n重岩看不厌，绝胜五台山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"止斋即事","author":"娄寅亮","text":"居与仙岩邻，未悉仙岩路。\n片棹偶相及，山僧频礼数。\n指点觅馀迹，行行道其故。\n是为梅雨潭，排空成瀑布。\n常生六月寒，輶轩每相顾。\n嗟哉往来者，宁不忝尸素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"讲易","author":"丘程","text":"易理分明在画中，谁知易道画难穷。\n不知画意空笺注，何异丹青欲画风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题大慈寺","author":"陆焕","text":"天下纷纷吹战尘，我来佛陇悟修身。\n依然猿鹤如相识，知是山中几世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"欧阳焘","text":"冰井有泓闲漱玉，火山无焰谩生烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"欧阳焘","text":"恭公遗治传耆旧，元结雄文载简编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辞官","author":"余嗣","text":"试把人间比梦间，也须回首旧家山。\n人生待足何时足，未老偷闲却是闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"杨友","text":"可怜鳞细闲惊跃，误把新蟾作钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重游超化寺","author":"黄觐","text":"西山背水古招提，经岁重来觅旧堤。\n槭槭鼓秋黄叶下，阴阴结雨黑云低。\n平生恐负林泉约，明日还愁步履迷。\n睡足一瓯汤饼满，更休作礼问曹溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"政和太学生","text":"博陵公子真文虎，占断儒官第二人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"范溶","text":"兰汀六雁图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草堂","author":"黄舣","text":"径入小庭迂，登登岂按图。\n主人缘雅趣，有客爱规模。\n鸥与邻翁狎，船从稚子呼。\n何当迎接汝，有梦隔江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送士特兄下第之衡湘","author":"李纲","text":"都城三月春暮时，通津两岸杨花飞。\n送君结束适南楚，使我叹息生长悲。\n男儿功名致须早，夫子声誉久已驰。\n文章黼黻虽自许，时运龃龉将安施。\n霜蹄暂蹶未为失，云翮高举终非迟。\n人生且求适意处，天命会有不否期。\n潇湘千里渺烟浪，浮家早逐秋鸿归。\n娥英事实素难考，来时为读黄陵碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子房","author":"李纲","text":"汉楚存亡谈笑中，子房初不有其功。\n闭门辟谷思轻举，肯叹淮阴犬与弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读楚元王传","author":"李纲","text":"设醴当年为穆生，偶忘微礼便辞荣。\n固知申白无先见，衣赭髡钳始自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒告迎奉闻亲闱有醴泉之除不胜庆抃作诗寄叔易季言二弟","author":"李纲","text":"薄宦便甘旨，两载官南徐。\n江山富佳致，足以为亲娱。\n昆弟尽在傍，承颜欢有馀。\n宁知驿书召，结束趋征途。\n旅食寓京华，梦想怀庭除。\n宸恩赐清燕，天语闻都俞。\n兰省幸备员，匪才惭冒居。\n思亲动归兴，谒告之东吴。\n晓出通津门，轻舠泛汴渠。\n莺花已烂熳，榆柳正扶疏。\n去去指苕霅，行行远神都。\n中途闻吉语，动色观除书。\n天子隆孝治，朝廷优老儒。\n犬马志欲养，获此伸区区。\n丘山恩施重，蝼蚁轻捐躯。\n寓书东飞鸿，早早达吾庐。\n季也在亲侧，援琴方舞雩。\n聆音想慰怿，具驾无踟蹰。\n会言亦近止，期以薰风初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬胡俊明博士见寄","author":"李纲","text":"载笔螭坳侍九天，谪来山泽作臞仙。\n鸣冈敢并喈喈凤，感气聊同嘒嘒蝉。\n引义每惭爰叔直，著鞭常恐祖生先。\n庭闱一去三千里，自叹飘零曷日还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵留别诸弟","author":"李纲","text":"久陪鸳鹭日朝天，却爱江湖作散仙。\n但有园林种松菊，便胜冠冕著貂蝉。\n棣华春早相辉映，雁序风高自后先。\n暂此睽离休怅望，为荒三径徯予还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同叔易季言游虎丘寺邂逅何得之","author":"李纲","text":"理棹适闽粤，虎丘聊舣航。\n霜林正摇落，翠柏森成行。\n入门蹑磴道，乔木间疏篁。\n秦帝试剑石，破瓜分路傍。\n生公雨花台，说法今不亡。\n苍藓衣峭壁，枯荷响回塘。\n遂游剑池上，毛发森以张。\n沈沈下无底，疑有虬龙藏。\n镌削露天巧，胚胎劳混茫。\n清奇俨图画，秘怪叵测量。\n薜荔叠秀色，枇杷吐幽香。\n行行造梵宇，金碧相荧煌。\n危脊耸古殿，长腰曼脩廊。\n凭虚架云阁，凿险通禅房。\n开轩俯吴会，蜂窠缭池隍。\n风烟寄远目，心逐征鸿翔。\n列岫霭遥碧，平湖湛孤光。\n追寻殊未倦，策杖登崇冈。\n幽独诗句苦，阖庐丘冢荒。\n五圣瞻象设，羽泉酌甘芳。\n西庵何闲寂，修竹自苍苍。\n脱履足生茧，解衣汗如浆。\n却携二三子，置酒白云堂。\n念旧已悽恻，感时增慨慷。\n况我方远涉，狷介怀刚肠。\n一杯且相属，世事都茫茫。\n冠冕志已冷，山林兴偏长。\n逝将脱羁束，超然傲羲皇。\n斯游信清绝，去去何时忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江五首 其一","author":"李纲","text":"重过松江忆旧游，依然风景照行舟。\n危桥跨水虹垂影，高阁凭虚蜃吐楼。\n渺渺冲烟归钓艇，轻轻点浪舞沙鸥。\n暮天横笛江村起，激烈能令逐客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江五首 其二","author":"李纲","text":"木落水寒天气清，江湖合处一桥横。\n波涛万顷琉璃滑，栏槛千寻螮蝀明。\n茶灶笔床随陆子，莼羹鲈鲙忆张生。\n他时若我归来后，定向江头事钓耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江五首 其三","author":"李纲","text":"返照澄波彻底明，江边弭棹若为情。\n风烟漠漠无今古，舟楫纷纷尽利名。\n潮落片帆归浦屿，云寒一雁过江城。\n孤臣放逐三千里，此去龙津尚几程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江五首 其四","author":"李纲","text":"系缆江头日脚沈，鲈肥酒美只孤斟。\n长桥千步风涛稳，横笛一声烟水深。\n契阔离亲宁素愿，迂愚报国祗丹心。\n远游自是男儿事，更把离骚细细寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江五首 其五","author":"李纲","text":"鲈乡宜旷望，烟霭起层阴。\n讴轧橹声急，苍茫江色深。\n归潮寒入浦，宿鸟暝投林。\n谁识登临意，愁来遽不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过吴江阻风游宁境寺","author":"李纲","text":"扁舟渡松江，惨淡天色恶。\n胜游得禅房，旷望倚虚阁。\n轩楹俯巨浸，云水互参错。\n长风驾惊浪，飞雪相喷薄。\n未应神龙怒，端有蛟鼍作。\n片帆天际来，飘忽如陨箨。\n波涛浩无涯，撑突殊不愕。\n奈何操我舟，惴慄缆添索。\n蜚廉也世情，逐客正落寞。\n深夜始归眠，蓬窗听鸣铎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松江第四桥","author":"李纲","text":"松江第四桥，风雨不可过。\n下有百尺蛟，蜿蜒枕桥卧。\n窟宅据要津，口腹长饥饿。\n每凭波涛势，能作舟楫祸。\n安得佽飞手，坐使神奸破。\n往来水无虞，时鼓清江柁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"操舟","author":"李纲","text":"吴儿便操舟，衣服皆楚制。\n出没波涛中，端如履平地。\n江湖渺千里，鼓柁等游戏。\n临深讵保身，涉险惟射利。\n天风难与期，飘骤出非意。\n倾覆瞬息间，永为鱼鳖饵。\n愿言戒畏涂，巧手不可恃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴四首 其一","author":"李纲","text":"邑犬惊行客，林乌啼晓霜。\n山村云冉冉，泽国水茫茫。\n移棹轻舟稳，钩帘野兴长。\n谁知因谪宦，得到水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"李纲","text":"肃肃岁华暮，霏霏烟霭深。\n轻冰依浅渚，寒日映疏林。\n故邑怀亲日，扁舟去国心。\n凝眸无限景，愁绝不成吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴四首 其三","author":"李纲","text":"片帆随鸟翼，离恨满江乡。\n风细云衣薄，日斜波影光。\n牧童寒哨笛，渔艇静鸣榔。\n景物正清绝，桑榆还夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴四首 其四","author":"李纲","text":"暮天来远色，行客尚贪行。\n棹急浪花碎，月高云缕轻。\n巢乌栖更起，渔火暗还明。\n独寝不成梦，夜寒闻雁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韩贾","author":"李纲","text":"退之守潮阳，戚嗟见章表。\n贾生傅长沙，自广托鵩鸟。\n拘达言虽殊，均为未能了。\n今我谪龙津，管库素所晓。\n粗令职事办，便觉溪山好。\n燕坐一室间，妄念悉除扫。\n岂复计穷通，端亦忘寿夭。\n回观古人心，颇叹二子小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家四首 其一","author":"李纲","text":"江村烟水远，茅屋两三家。\n断岸垂衰柳，疏篁隐细沙。\n田畴剩粳稻，网罟足鱼虾。\n不识宦游味，见人还叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家四首 其二","author":"李纲","text":"场圃事方毕，稻粱成已勤。\n儿童自逐逐，鸡犬亦欣欣。\n啼鸟霜林暮，卧牛烟草昏。\n田夫乐岁稔，斗酒共醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家四首 其三","author":"李纲","text":"柴门临小浦，竹径绕幽庄。\n雨剪葵韭滑，夜舂粳稻香。\n年丰饱妻子，日夕下牛羊。\n谁识田家乐，拂衣归兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家四首 其四","author":"李纲","text":"谁谓田家苦，田家乐甚真。\n鸡豚燕同社，箫鼓祭瘟神。\n高廪方有岁，西畴行复春。\n但令租赋足，终老得相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘉禾道中遇夏侯子阳","author":"李纲","text":"京华契阔已再冬，扁舟野岸欣相逢。\n天寒水远飞霜风，谈笑坐觉回春容。\n年踰七十两颊红，真气上溯泥丸宫。\n剖符南海窥祝融，欲求丹砂访葛洪。\n问予执笔侍九重，胡为谪堕溪山中。\n迂愚久合亲耕农，君恩未报徒忡忡。\n飘零孤迹随断蓬，他日相忆看云鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初到临平见山二首 其一","author":"李纲","text":"我见青山若故人，峰峦照眼自相亲。\n只应今日爱山意，便是他时傲世因。\n点缀白云春缥渺，萦回绿水晚奫沦。\n君恩若许归田里，定卜山间老此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初到临平见山二首 其二","author":"李纲","text":"孤舟渺渺两山间，终日钩帘只看山。\n落日半衔霞未散，疏林远暝乌初还。\n悽凉离恨谁能寄，浩荡诗愁自莫删。\n赖有青山可人意，与君相对且开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小雨","author":"李纲","text":"小雨晚初急，暝云深不收。\n霏霏暗烟树，索索响篷舟。\n山色增远翠，渔蓑生暮愁。\n凄凉苏季子，寒觅敝貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将次钱塘","author":"李纲","text":"岁晚飘零日，舟行杳霭间。\n江乡多雾雨，风物近湖山。\n独鹤徊翔久，飞云自在閒。\n远游殊未已，萧飒鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵隐宫","author":"李纲","text":"我昔曾游飞来峰，白猿昼挂峰上松。\n晔然灵光如彩虹，钟磬自响金仙宫。\n宦游漂泊西复东，虽欲再到无由从。\n帝居钧天陋瀛蓬，螭坳载笔侍重瞳。\n逆鳞聊试摩神龙，谪堕剑浦山重重。\n征鞍来此寻旧踪，恍如梦落烟霞中。\n朱楼宝殿飞玲珑，寒泉幽石欣相逢。\n门前池馆虚含风，一洗尘虑清心胸。\n明朝南去随征鸿，惆怅胜游回首空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望潮","author":"李纲","text":"樟亭一望浙江潮，震地凌空气象骄。\n十万军声来海峤，三千银界混烟霄。\n素车白马纵横骛，翔鹭飞鸥散漫飘。\n好是波平风稳后，一帆千里不崇朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自哂","author":"李纲","text":"自哂何为者，南游亦偶然。\n未登离垢地，端有散花天。\n遇境聊为戏，安心不离禅。\n幽怀谁与共，深炷一炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张南仲置酒心渊堂值雨","author":"李纲","text":"自别西湖日置怀，却因谪宦得重来。\n云深不见孤山寺，风急难乘摇碧斋。\n未放幽情穷水石，且将离恨泥樽罍。\n胜游须遍山南北，何日晴天为一开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北望","author":"李纲","text":"迢迢休北望，汩汩正南迁。\n出处岂无意，阨穷那问天。\n销愁凭酒盏，遣兴赖诗篇。\n诗酒吾家事，从今号谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]