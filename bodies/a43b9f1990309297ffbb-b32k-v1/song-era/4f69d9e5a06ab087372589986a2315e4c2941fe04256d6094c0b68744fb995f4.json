[{"title":"真宗永定陵 其一","author":"宋祁","text":"金石凝虚笋，旌旗落暗尘。\n唐尧遂不见，空有进羹人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真宗永定陵 其二","author":"宋祁","text":"洛水萦祠外，嵩云泊栋端。\n桥山何必问，只是葬衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"脩竹","author":"宋祁","text":"北户静无尘，萧萧玩翠筠。\n此时刀笔手，惭愧杀青人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读巷伯章","author":"宋祁","text":"孤节区区是爱君，危言未达已危身。\n豺牙虎爪铦于剑，不为诗人食谮人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读退之集","author":"宋祁","text":"素瑟朱家古韵长，有谁流水辨汤汤。\n东家学嗜蒲菹味，蹙頞三年试敢尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读桓伊传","author":"宋祁","text":"上前奏笛串奴髯，自倚哀筝咏刺谗。\n太傅一闻流涕久，使君于此信非凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途次清明","author":"宋祁","text":"漠漠轻花著早桐，客瓯饧粥对禺中。\n遥知阙下颁新火，百炬青烟出汉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都街见缘橦伎感而成咏二阕 其二","author":"宋祁","text":"孑孑危橦突倒投，负材骄压汉场优。\n如何日到危身地，只丐旁人一笑休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都街见缘橦伎感而成咏二阕 其一","author":"宋祁","text":"迥望场中百尺竿，趫材飞捷过跳丸。\n垂堂亦有千金子，不敢中衢徙倚看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒胡","author":"宋祁","text":"谁刻优胡象，来为饮席珍。\n不因君屦指，几作独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶记洛下旧游","author":"宋祁","text":"洛阳三月见梨花，遥认清香识钿车。\n今日风光两无赖，莫愁应已嫁卢家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作","author":"宋祁","text":"隼被鴳姿知有累，豺惊羊质固非真。\n谩誇鲁国多儒士，敢到君门止一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作","author":"宋祁","text":"薄暮歌钟宴平乐，黎明车骑过宜春。\n身长六尺饥将死，唯是平原厌次人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶思桓景登高故事","author":"宋祁","text":"桓景全家遂得仙，佩萸吹菊对陶然。\n汝南鸡犬缘何事，不似淮王许上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄君贶王学士","author":"宋祁","text":"鸡檄防边未得休，久停欢酌为前筹。\n良辰床赏何忧晚，他日三公尚黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惊乌","author":"宋祁","text":"远梦回时路已迷，三更霜月倚楼西。\n惊乌有底无穷恨，取向琴中作夜啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扈从至奉先寺回","author":"宋祁","text":"宝刹虹幡蔽曙霞，中天凝跸转云车。\n不妨归路王城远，满袖飞花杂雨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"宋祁","text":"露花裛裛开还遍，风絮飞飞去不休。\n春解无情春亦老，欲将寥落与谁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚夏西园二首 其二","author":"宋祁","text":"日晏坐中园，清襟注迥轩。\n轻飙逢叶动，小雨得荷喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚夏西园二首 其一","author":"宋祁","text":"道樾阴阴密，畦泉活活流。\n梨成津向润，瓜熟子相钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹景宗","author":"宋祁","text":"快马如龙度埒尘，射獐放饮藉汀蘋。\n鼻头出火风生耳，宁愿扬州作贵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望仙亭北轩晚思","author":"宋祁","text":"北顾吾庐安在哉，天涯望眼到天回。\n碧云向晚无情合，思杀离人未肯开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮山","author":"宋祁","text":"不见当年丛桂枝，空山崄崒但霞霏。\n眼看春草萋萋遍，身是王孙未得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虚名","author":"宋祁","text":"身外虚名莫妄求，强关事事判悠悠。\n试看云将三年役，止博鸿蒙一掉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野路见棠梨红叶为斜日所照尤可爱","author":"宋祁","text":"叶叶棠梨战野风，满枝哀意为秋红。\n无人解赏如丹意，抛在荒城斜照中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪里寻梅","author":"宋祁","text":"雪里逢梅近腊时，梅姿雪态两相宜。\n羡君此处留清赏，看遍溪头南北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄罗?","author":"宋祁","text":"袁褚声华约略同，到头忠佞两成功。\n先皇谩赐黄罗?，不识明眸有贯虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄葵","author":"宋祁","text":"黄葵贵丽不夭饶，一朵新晴松下高。\n还似迩英临黼座，曈昽晓日照天袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食夜偶题","author":"宋祁","text":"前尘露气压轻埃，风漾花阴聚复开。\n苦恨浮云心不净，月中时污太清来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御爱山","author":"宋祁","text":"翠嶂奔腾一气间，六飞留赏暂怡颜。\n君王草草非真爱，心愧东方检玉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上 其二","author":"宋祁","text":"湖上烟光九月天，于今墟落古西偏。\n风波罢后汀洲静，两两凫鹥曝翅眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上 其三","author":"宋祁","text":"嵩騩凌秋爽气来，川原高下一屏开。\n溪云尽日无还意，正自天边作雨回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上","author":"宋祁","text":"雪后云归露晚暾，冻舟犹自滞溪门。\n潜鱼不上湖光静，漠漠寒沙印雁痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上 其一","author":"宋祁","text":"萧萧露白蒹葭老，索索风乾杨柳疏。\n坐见渔舟归浦尽，小篷明灭上灯初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上二首 其二","author":"宋祁","text":"楼迥衔空雾，郊长占暝霏。\n戏鱼晴自掷，寒鸭夜还飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上二首 其一","author":"宋祁","text":"秋水自然碧，秋花何意红。\n乾坤摇落恨，只是为西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上见担稻者","author":"宋祁","text":"压塍霜稻报丰年，镰响枷鸣野日天。\n辅郡不知为水耨，楚农新教命家田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琼花","author":"宋祁","text":"唐昌观中树，曾降九天人。\n銮驾久何许，雪英如旧春。\n岂无遗佩者，来效捧心颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答客 其二","author":"宋祁","text":"承明年老厌文书，尺奏朝通暮剖符。\n数领近藩君莫笑，犹胜长被鬼揶揄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答客 其一","author":"宋祁","text":"十年通籍向苍龙，孤直何缘免讳穷。\n欲识深心似鱼鸟，不将山海换池笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答梵才见贺忝承旨之作","author":"宋祁","text":"玉署重来访旧游，蟠桃熟遍碧城秋。\n不知身是真仙未，上到鳌山最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答道卿舍人桐竹之嘲","author":"宋祁","text":"桐竹连云阿阁西，脩茎浓叶蔽璇题。\n本来鸾鸑排翔地，正恐羁禽不借栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答燕侍郎谢与端明李学士见过之什","author":"宋祁","text":"方外仙乡岸幅巾，三竿红日照霜晨。\n当关不用惊驺唱，共是扬家载酒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫宸赐宴","author":"宋祁","text":"戴斗通欢瑞节来，新年共上万年杯。\n宫花杂珥天心悦，并觉春从殿里回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舒雁","author":"宋祁","text":"庄周悲杀雁，本为不能鸣。\n宁识山阴误，能鸣亦就烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花","author":"宋祁","text":"前溪夜雨锦张红，坠萼残英绕暗丛。\n已与吹开复吹谢，无情毕竟是春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋成中丞临川侍郎西园杂题十首 其一 双假山","author":"宋祁","text":"佛螺双髻矗层岚，云穴呀空藓晕衔。\n异日主公求肖像，居然认得傅溪岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋成中丞临川侍郎西园杂题十首 其三 牡丹","author":"宋祁","text":"上国名园买地栽，试知韩令是雄猜。\n香根斸尽成何事，不识骚人托讽才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋成中丞临川侍郎西园杂题十首 其五 柳","author":"宋祁","text":"散漫飞绵阿娜枝，家家眺赏霁霜威。\n尽将烟叶偷眉妩，不为章街走马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋成中丞临川侍郎西园杂题十首 其六 射堋","author":"宋祁","text":"栖鹄云侯迥势开，主人留客侑金罍。\n欲知谢尚风流极，赌得将军鼓吹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋成中丞临川侍郎西园杂题十首 其二 烟竹","author":"宋祁","text":"烟梢露叶贯冬荣，高出危墙近覆亭。\n闻道兰台有图籍，故留春粉助蒸青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋成中丞临川侍郎西园杂题十首 其四 酴醾架","author":"宋祁","text":"媚条无力倚风长，架作圆阴覆坐凉。\n露蕊一春清袭袂，有人知是令君香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪上","author":"宋祁","text":"杖策溪边兴尽归，片云何事逐人飞。\n飘然自是无心物，欲去还来上客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧房白莲","author":"宋祁","text":"水风披玉蘤，溪露泫瑶津。\n花意如师意，宗雷社里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漱玉斋前杂卉皆龙图王至之所植各赋一章凡得八物或赏或否亦应乎至之意欤遂写寄至之 其一 牡丹","author":"宋祁","text":"压枝高下锦，攒蕊浅深霞。\n叠綵晞阳媚，鲜葩照露斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漱玉斋前杂卉皆龙图王至之所植各赋一章凡得八物或赏或否亦应乎至之意欤遂写寄至之 其三 蜀葵","author":"宋祁","text":"红白相嗣繁，色纯香亦浅。\n相对庭户间，俗尚焉能免。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漱玉斋前杂卉皆龙图王至之所植各赋一章凡得八物或赏或否亦应乎至之意欤遂写寄至之 其六 竹","author":"宋祁","text":"脩脩稍出类，辞卑不肯丛。\n有节天容直，无心道与空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漱玉斋前杂卉皆龙图王至之所植各赋一章凡得八物或赏或否亦应乎至之意欤遂写寄至之 其八 芭蕉","author":"宋祁","text":"不枝惟叶茂，无干信中空。\n所以免摧折，为依君子风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漱玉斋前杂卉皆龙图王至之所植各赋一章凡得八物或赏或否亦应乎至之意欤遂写寄至之 其七 菊","author":"宋祁","text":"纤茎寒始密，秀叶晚逾滋。\n芳意君须识，群葩摇落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漱玉斋前杂卉皆龙图王至之所植各赋一章凡得八物或赏或否亦应乎至之意欤遂写寄至之 其四 萱草","author":"宋祁","text":"修茎无附叶，繁萼攒庭首。\n每欲问诗人，定得忘忧否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊上人见过谈理颇未得尽忆王侍郎共加研讨","author":"宋祁","text":"拄杖萧然陋庑开，茗花熬绿浅浮杯。\n清言未到忘言处，正待裴家驿骑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝉","author":"宋祁","text":"晓腹清呼饱露津，本求仙蜕远嚣尘。\n貂温范蜜非吾族，枉共花冠托此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北郭巨然山水","author":"宋祁","text":"钿点峰头矗太虚，远帆遥岸水平铺。\n不知真到云波上，得似工毫可爱无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朱四郊墅","author":"宋祁","text":"菌阁平窥倚杵天，绮塍鳞隰逗春泉。\n谁将六国黄金印，拟换东周二顷田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题挽邓亭","author":"宋祁","text":"邓守挽不住，眷予番久留。\n决非人所挽，胡不理归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题提举公会亭","author":"宋祁","text":"一翚轩翼四檐通，草树依然接旧宫。\n苑外自飘新岁雪，台边谁识故王风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"儒林","author":"宋祁","text":"穷巷空伤老治经，由来命薄是诸生。\n正须尽力排黄老，刺彘才能得利兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濠上","author":"宋祁","text":"惠非蒙叟叟非鱼，濠上全知鱼乐无。\n春水未深鱼易乐，要须真乐是江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藉田礼毕因成七言","author":"宋祁","text":"青旗斜倚耕坛雾，膏壤遥迎御耦春。\n二步不应踰旧礼，天心自欲劝蒸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一百五日官舍作","author":"宋祁","text":"晋歌本自传幽愤，楚俗缘何作胜游。\n宴豆雕文誇瀹卵，侠场星影斗飞毬。\n光翻蘋吹都无力，暖著花烟不肯流。\n捣杏沃饧纷节物，更惭多病怯寒瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一雨","author":"宋祁","text":"一雨初收细细凉，碧云西畔见残阳。\n归期只觉刀头远，别恨偏教带眼长。\n梅驿使稀谁托信，蕙盘烟冷不成香。\n酒泉已是三千里，何况关门未得望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕 其二","author":"宋祁","text":"西南新月玉成钩，奕奕神光渡饮牛。\n素彩低浮承露掌，清香不散曝衣楼。\n天边华幄催云卷，星外横桥伴客愁。\n莫使银河到沧海，人间沟水易东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕 其一","author":"宋祁","text":"开秋七夕到佳辰，里俗争誇节物新。\n乌鹊桥头已凉夜，黄姑渚畔暂归人。\n裴回月御斜光敛，宛转蛛丝巧意真。\n卜肆沈冥谁复问，年年槎路上天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月二十七日","author":"宋祁","text":"客雁归何处，寒螀鸣不休。\n兼之清夜永，副以长年愁。\n家令有移带，中郎馀白头。\n此怀诚自感，何赖怨高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月二十八日","author":"宋祁","text":"秋物向摇落，客心真悄然。\n高风已凉夜，澹月始晴天。\n拂幌单綀怯，凝尘故扇捐。\n露华休早滴，羁鹄不曾眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"宋祁","text":"商馆冯高爽气浓，露萸千穗亚枝红。\n饼餐交遗嘉笾上，蕊菊争吹寿斝中。\n击隼厉威平隰阔，戏骖沈响故台空。\n何人盛继龙山集，醉帽须防谷郁风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日至卫南","author":"宋祁","text":"良辰独据鞍，节物强相干。\n酒驻衰颜浅，风吹客帽寒。\n暂吟非有属，倦曲不成欢。\n多谢黄花意，还如故国看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]