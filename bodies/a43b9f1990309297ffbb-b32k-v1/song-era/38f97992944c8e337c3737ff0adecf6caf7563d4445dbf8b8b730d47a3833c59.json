[{"title":"偈颂七十六首 其十九","author":"释子益","text":"一日复一日，眨眼过半夏。\n兴化老无知，钵盂安柄把。\n引得四海参玄人，三三两两聚头商量这个话。\n阿呵呵，六月卖松风，人间恐无价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十八","author":"释子益","text":"名不得，状不得。\n脱胎换骨方，起死回生诀。\n信得及底，不消一服，诸病顿除，脱体安乐。\n何必善财重采药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十六","author":"释子益","text":"泼天声价陈睦州，咬人火急瞌睡虎。\n行不到处行一步，道不到处道一句。\n德山临济眼?■，棒喝交驰无所措。\n兴化忍俊不禁，随例赫日光中飞白雨，照顾湿却袈裟角。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十五","author":"释子益","text":"二千年前，通身是垢。\n二千年后，满面埃尘。\n直饶九曲黄河水，洗到驴年也不清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十四","author":"释子益","text":"昨日雨，今日晴。\n桃花开口笑，无处觅灵云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十三","author":"释子益","text":"四九三十六，夜眠如露宿。\n银海眩生花，玉楼寒起粟。\n翻笑二祖立雪谩齐腰，活埋一片无瑕玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十二","author":"释子益","text":"信手拈来，万选万中。\n轻若鸿毛轻，重似丘山重。\n虽是死蛇，也要活弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十一","author":"释子益","text":"与么寒，何处避。\n冰棱上，深雪里。\n有来由，没巴鼻。\n丹霞烧木佛，院主眉须堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十","author":"释子益","text":"去年今日逢冬节，扑头扑面迎霜雪。\n今年冬节又来临，屋角梅花弄晓晴。\n笑它鲁史谩书云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其九","author":"释子益","text":"向上一路，千圣不传。\n未曾拟议，早隔大千。\n雪峰辊毬，禾山打鼓，仰山插锹，地藏种田。\n短绠那汲深泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其八","author":"释子益","text":"天上月圆，人间月半。\n明眼衲僧，见似不见。\n盏子扑落地，楪子成七片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七","author":"释子益","text":"一槌便就，颟颟顸顸。\n不假一槌，无端无端。\n忙里工夫闲处觅，闹中消息静中观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六","author":"释子益","text":"最初句，向上机。\n瞿昙不会，达磨不知。\n知不知，雨馀千嶂碧，春水一溪肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四","author":"释子益","text":"行不到处行一步，说不到处道一句。\n径山诸公见义勇为，灵隐师伯拔剑相助。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三","author":"释子益","text":"一字不著画，八字没两丿。\n文彩甚分明，何待重饶舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二","author":"释子益","text":"不行喝，不行棒。\n负命衲僧，不钓自上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其一","author":"释子益","text":"我此一门，初无关键。\n半合半开，东扇西扇。\n千闻不如一见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绵州昙上人求语上径山","author":"释子益","text":"解唱东山瓦鼓歌，不知节拍有誵讹。\n要教声响如当日，快向凌霄走一遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题瑞云峰","author":"释子益","text":"山行百折路重重，到顶回头眼界空。\n但觉衲衣冰样冷，不知身在瑞云峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哑子观音赞","author":"释子益","text":"赞者舌秃，画者口哑。\n篮里锦鳞，愈增高价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其五","author":"释子益","text":"出与未出，莲花荷叶。\n老倒智门，舌头无骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十一","author":"释子益","text":"律管吹灰，勾芒布令。\n六国风清，九天云静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十一","author":"释子益","text":"作家相见，啐啄尤乖。\n达士相逢，握鞭回首。\n捡点将来，已落第二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十九","author":"释子益","text":"伏暑未收，金风渐作。\n弹指声中，门开楼阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十","author":"释子益","text":"欲明此道，须遇其人。\n其人既遇，十倍收成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十七","author":"释子益","text":"世事悠悠，不如山丘。\n卧藤萝下，块石枕头。\n许由洗耳，巢父饮牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五","author":"释子益","text":"黄梅夜半，鸡足峰前。\n承虚接响，互相热瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释子益","text":"俗气不除，病在一默。\n扁鹊卢医，医你不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十三","author":"释子益","text":"语底默底不是，非语非默亦非。\n虚庵有一转语，用处绝毫绝厘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈","author":"释子深","text":"衲僧日日是好日，要行便行无固必。\n虚空天子夜行船，摩诃般若波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹霞誧法弟新建暖堂以颂庆之","author":"释子淳","text":"暖堂新构侵云表，桂月松风常满抱。\n玉烛光中静应时，言前妙唱般阳道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无缝塔","author":"释子淳","text":"月皎渔舟瑞气旋，芦花深处夜涛寒。\n可怜无限垂丝者，随例忙忙失钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日寄住庵僧","author":"释子淳","text":"落叶积莓苔，柴扉半不开。\n幽林云密覆，花鸟恨空来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"任善友求颂","author":"释子淳","text":"差别道难通，应须识自宗。\n无根枯树子，月夜影重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因禅人发明以颂示之","author":"释子淳","text":"水阔云深古路赊，五湖禅侣共同家。\n夜来喜得真消息，无影林中圬木花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自宗","author":"释子淳","text":"空劫自己无依守，佛祖从来难启口。\n九年面壁太多端，那堪更强分妍丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居","author":"释子淳","text":"回途玉马休相伴，背角泥牛莫下鞭。\n多谢乾坤垂覆载，闲云芳草姿情眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和无尽居士牧牛颂","author":"释子淳","text":"头角峥嵘未兆前，乱云深处任安眠。\n不随芳草遥山去，何用芒童更著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张伯威见寄","author":"释子淳","text":"今日重来坐暖霞，故人笑谓老年华。\n劫空别有壶春在，云对青山兴莫涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张居士","author":"释子淳","text":"默讷虚明履趣深，蟾蜍推月照天心。\n松风未作寒林静，一弄无弦琴上音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和章阳叔见寄二首 其二","author":"释子淳","text":"师旷离娄不我徒，昭然罔象得玄珠。\n心萌口拟成途辙，底事圆明异有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和章阳叔见寄二首 其一","author":"释子淳","text":"休将水乳试鹅王，妙识醇醨别有方。\n本地不消春气力，灵枝劫外有馀芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居后以二偈示预环二禅者 其一","author":"释子淳","text":"十年同此振网维，万种誵讹悉共知。\n今日脱然无一事，坐观明月照琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居后以二偈示预环二禅者 其二","author":"释子淳","text":"水最为清月最圆，月光含水水涵天。\n混融不落威音世，到此如何语正偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送升长老住大乘","author":"释子淳","text":"皎月流辉千嶂冷，泥牛徐步出云烟。\n玄徒若问西来意，直指胞胎未具前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王汝弼宣教","author":"释子淳","text":"平生活计都消尽，锥地殊无付子孙。\n撒手便辞青嶂去，翛然却返白云村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送法弟应首座","author":"释子淳","text":"落叶纷纷万卉凋，云衣轻卷下岧峣。\n他年花萼?荣日，灵树无根暗长苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送俊化主回乡丐簟","author":"释子淳","text":"昔年百丈曾轻卷，今日重归故国求。\n顿使云堂三伏里，哭天忽尔变清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉上人","author":"释子淳","text":"异类潜行未兆前，昂藏头角耸摩天。\n回途莫守寒岸草，耕破威音那畔田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒲君锡赴湖南提刑","author":"释子淳","text":"携筇挥汗别文星，匝地清风耸百城。\n佛祖位中留不住，琉璃殿上绿苔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送静上人","author":"释子淳","text":"本自圆成不在言，泥牛耕破劫初田。\n夜来风月霜威重，天晓昆崙戴雪还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其二十一","author":"释子淳","text":"威音那畔不能行，撒手还家懒问程。\n寝殿无人空寂寂，满窗唯有月虚明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其三","author":"释子淳","text":"卓尔难将正眼窥，回超今古类难齐。\n苔封古殿无人侍，月锁苍梧凤不栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其六十四","author":"释子淳","text":"瑞霭祥烟锁玉楼，妙年王子恣优游。\n琉璃殿上骑金马，明月堂前辊绣毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其二","author":"释子淳","text":"相好巍巍大丈夫，一生无智恰如愚。\n从来佛祖犹难望，地狱天堂岂可拘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其二十九","author":"释子淳","text":"太平乡国路空赊，归兴悠悠思莫涯。\n撒手到家何所有，琉璃宝殿锁蟾华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其三十三","author":"释子淳","text":"父子相逢眼倍明，灵苗丛里坦然行。\n个中若为金毛子，已是盐梅触大羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其一○一","author":"释子淳","text":"灵然不涉古来今，三界都卢一点心。\n槛外桃花春蝶舞，门前杨柳晓莺吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其五十七","author":"释子淳","text":"色自色兮声自声，新莺啼处柳烟轻。\n门门有路通京国，三岛斜横海月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其五","author":"释子淳","text":"玄微及尽本翛然，若谓渠闲万八千。\n月印澄江鱼不见，钓人何必更抛筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其三十六","author":"释子淳","text":"前后三三不失宗，迥迢千圣数难穷。\n金刚脑后全轩露，叠叠青山锁翠空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其六十一","author":"释子淳","text":"宝杖亲携挂翠缨，徘徊常绕玉阶行。\n转身就父无标的，拈却花冠不得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其十四","author":"释子淳","text":"从来父子不相离，石女何劳更问伊。\n昨夜寒岩无影木，白云深处露横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其一○○","author":"释子淳","text":"此树不从天地生，登山涉水承渠力。\n如今掷向乱峰前，免致丛林为轨则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其五十八","author":"释子淳","text":"九重深密视听难，玉殿琼楼宿雾攒。\n燮理尽归臣相事，轮王不戴宝花冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其二十七","author":"释子淳","text":"拾得疏慵非觉晓，寒山懒惰不知归。\n声前一句圆音美，物外三山片月辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其二十三","author":"释子淳","text":"淘金岂假披沙得，不触波澜犹费力。\n露柱三更忽放光，此时未审何人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其五十九","author":"释子淳","text":"盲聋瘖哑迥天真，眼似眉毛道始邻。\n昨夜东君潜布令，黄莺啼处绿杨春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其五十一","author":"释子淳","text":"清风吹动钓鱼船，鼓起澄波浪拍天。\n堪笑锦鳞争戏水，到头俱被钓丝牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其十一","author":"释子淳","text":"烧香人静杳无声，苔满丹墀皓月明。\n入户当堂慵正坐，出门尤懒下阶行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其八十九","author":"释子淳","text":"虚空为鼓须弥槌，击者虽多听者稀。\n半夜髑髅惊破梦，港头明月不思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首","author":"释子淳","text":"四海烟尘已晏然，当轩明月照人寒。\n大功不赐将军赏，宝马金枪顿懒观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其三十八","author":"释子淳","text":"带角披毛异类身，寒灰枯木眼中尘。\n虽然未曾先师意，争奈临行一著亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其十九","author":"释子淳","text":"当机一句玉珊珊，内外玲珑溢目寒。\n无漏国中曾不住，月华影里见应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其十六","author":"释子淳","text":"镬汤炉炭几何般，地狱三途未苦酸。\n须信新丰亲切语，袈裟之下莫颟顸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其六十七","author":"释子淳","text":"故国清平久有年，白头犹自恋生缘。\n牧童却解忘功业，懒放牛儿不把鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其九十七","author":"释子淳","text":"等闲应问岂安排，一句全提隐显该。\n薄雾依依笼古径，孤峰终不露崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一○一首 其三十九","author":"释子淳","text":"多是从人学得来，一生空把口胡开。\n欲穷此片虚明地，七佛前前总不该。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]