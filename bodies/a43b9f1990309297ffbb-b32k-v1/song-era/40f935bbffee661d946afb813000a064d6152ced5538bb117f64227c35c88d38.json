[{"title":"次韵曾吉父见简","author":"韩驹","text":"往岁沧波转地流，是身如沫信沉浮。\n初闻盗贼奔他境，渐见衣冠集此州。\n病欲深耕归谷口，禅须末句问岩头。\n膺门也自知人喜，有客清真似子不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月二十一日子文待制见访热甚追记馆中纳凉故事漫成一首","author":"韩驹","text":"汉阁西头千步廊，与君长夏对胡床。\n阴阴桧色连宫草，寂寂棋声度苑墙。\n细乳分茶纹簟冷，明珠擘芡小荷香。\n身今老病投炎瘴，最忆冰盘贮蔗浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送子文待制归蜀","author":"韩驹","text":"家近锦江归未得，见人之蜀便凄然。\n闻君细说开州好，劝我来依刺史贤。\n当路尚多屯虎兕，远湖曾否息戈鋋。\n何时万里云沙静，稳上沙头上水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"世谓七夕后雨为洗车雨又七夕后鹊顶毛落俗谓架桥致然戏作二绝 其一","author":"韩驹","text":"云阶月地一相过，未抵经年别恨多。\n最恨明朝洗车雨，不令回脚渡天河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"世谓七夕后雨为洗车雨又七夕后鹊顶毛落俗谓架桥致然戏作二绝 其二","author":"韩驹","text":"上界鸾骖凤驾多，不消野翮强填河。\n可怜无数颠毛落，只得云軿一再过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜广寿寺偶书 其一","author":"韩驹","text":"水浊山昏暑未清，风枝不动月微明。\n忽惊零露先秋戒，更放蟭蟟一月鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜广寿寺偶书 其二","author":"韩驹","text":"城郭初鸣定夜钟，苾刍过尽法堂空。\n移床独向西南角，卧看琅珰动晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送范叔器次路公弼韵","author":"韩驹","text":"晚涂淹泊向谁论，白发名卿肯见存。\n雒邑风流馀此老，故家文献有诸孙。\n寺连狭径曾倾盖，船拥清溪尚一樽。\n小驻鄱阳未宜远，欲凭书尺问寒温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日谢人送酒","author":"韩驹","text":"木末炎风晚更无，火云低傍古城隅。\n正嫌酒作鸡冠赤，洗盏惊看白玉腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又谢送凤团及建茶 其一","author":"韩驹","text":"白发前朝旧史官，风炉煮茗暮江寒。\n苍龙不复从天下，拭泪看君小凤团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又谢送凤团及建茶 其二","author":"韩驹","text":"山瓶惯识露芽香，细蒻匀排讶许方。\n犹喜晚涂官样在，密罗深碾看飞霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘲蚊","author":"韩驹","text":"物微深可悯，畏雨复兼风。\n适见传呼宠，俄成扑地空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘲蝉","author":"韩驹","text":"资身惟朽壤，得意只繁阴。\n浪自声凄急，人谁听汝音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘲萤","author":"韩驹","text":"孤光辞腐草，强拟帖天飞。\n中路霜风急，还寻腐草归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘲蝇","author":"韩驹","text":"忆昔趋阊阖，朝鸡促晓声。\n何关蝇辈事，也复强飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顷年侍立集英殿见周表卿唱名第二客居临川表卿为宜黄丞岁满访别以诗送之","author":"韩驹","text":"往时束带侍明光，曾看挥毫点御床。\n只道骅骝已腾蹋，不知雕鹗尚摧藏。\n官居四合峰峦雨，驿路千林橘柚霜。\n莫为艰难归故里，汉庭今重甲科郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问江西漕使乞酒及牛乳 其一","author":"韩驹","text":"中郎玉节驻江西，饮惯黄封厌赤泥。\n寄与衰翁时一醉，四山摇落雨凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问江西漕使乞酒及牛乳 其二","author":"韩驹","text":"近闻酥酪出中厨，想肯分留寄病夫。\n不为长斋饭粗粝，暮年消渴亦时须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬青","author":"韩驹","text":"离宫见尔近天墀，雨露常私养种时。\n寂寞一株岚雾里，无人识是万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢江州陆签判寄糖蟹 其一","author":"韩驹","text":"故人书札访林泉，郭索相随到酒边。\n未擘团脐先一笑，二螯能覆两觥船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢江州陆签判寄糖蟹 其二","author":"韩驹","text":"只讶平原驿使稀，不嗔彭泽寄来迟。\n劝君莫以无肠故，忍见纷纷躁扰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吉父曾园梅花 其一","author":"韩驹","text":"路入君家百步香，隔帘初识汉宫妆。\n只疑梦到昭阳殿，一簇轻红绕淡黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吉父曾园梅花 其二","author":"韩驹","text":"春风并力著寒梅，浅白轻黄一道开。\n竹屋西头如有路，扶藜不问主人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬泉使君寄荔枝子鱼 其一","author":"韩驹","text":"烂红初擘使君盘，走送柴门色未乾。\n著意裁诗终不近，遥怜醉眼若为看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬泉使君寄荔枝子鱼 其二","author":"韩驹","text":"驿骑持书自海旁，开篮剩喜子鱼香。\n红螺紫蛤俱羞避，独许渠侬近酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李大夫移宰新喻","author":"韩驹","text":"治声临颍复临川，籍甚临江已预传。\n但怪骅骝在泥滓，会看鸿雁撇云天。\n杯翻竹叶深留客，浦涨桃花小系船。\n别后更谁从此老，频将书尺问沉绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送翁县丞赴部 其一","author":"韩驹","text":"不谓张罗地，时能问字过。\n欲为衰朽托，将奈别离何。\n比岁开三馆，君才中十科。\n待平澶卫了，加思颂元和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送翁县丞赴部 其二","author":"韩驹","text":"昔坐甘陵党，频年堕崄巇。\n斯文今烜赫，隐吏已衰迟。\n俊茂推之子，飞腾值圣时。\n诸公宜改观，相国旧深知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"似矩尚书帅桂道由临川赋诗三首贻彦章内翰谨次元韵送行 其一","author":"韩驹","text":"丧乱乖离数，衰慵问讯疏。\n新霜上须鬓，老泪湿襟裾。\n忽报迎车骑，遥知奉玺书。\n岂惟谋郤縠，文亦似相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"似矩尚书帅桂道由临川赋诗三首贻彦章内翰谨次元韵送行 其二","author":"韩驹","text":"有人谈五岭，崷崒象衡庐。\n地长十寻竹，波跳三尺鱼。\n看公罗鈇钺，笑我老耕锄。\n敢望频书札，相望万里馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"似矩尚书帅桂道由临川赋诗三首贻彦章内翰谨次元韵送行 其三","author":"韩驹","text":"郡戟苍山上，平分二水流。\n四时无疠气，五管有贤侯。\n静契罗公远，禅参帛道猷。\n人生一麾乐，不必向中州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吉父食笋乳长句 其一","author":"韩驹","text":"酪乳抨来自释宫，流膏散液竹萌中。\n我方厌苦饥虚病，公已深知识界空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吉父食笋乳长句 其二","author":"韩驹","text":"只漫轑羹送邻舍，岂能搜句搅诗翁。\n山城异味宁长有，却傍春畦撷芥菘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程待制见简","author":"韩驹","text":"病鹤羞垂翅，疲驽困络头。\n空悬彭泽印，看上汝南州。\n好去营茆栋，相依老荻洲。\n忘忧得佳句，不敢比扶留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹山老送笋蕨与诸禅客同食戏成","author":"韩驹","text":"野寺瓶罂至，吾庐水竹幽。\n开缄喜风韵，唤客少淹留。\n蕨带寒山酱，笋兼头子油。\n谁能知许味，一饱并无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送宜黄宰任满赴调 其一","author":"韩驹","text":"故老凋零尽，君犹识了翁。\n深知名节似，不但里闾同。\n政府方交辟，高贤岂久穷。\n他年汝溪上，伴我钓秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送宜黄宰任满赴调 其二","author":"韩驹","text":"听说宜黄政，他邦总不如。\n里门喧诵读，村落罢追胥。\n纵未分侯印，犹当拥使车。\n此诗无丽句，聊代荐贤书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张右司赴召","author":"韩驹","text":"老夫晏坐临川寺，五见君为万里行。\n病马不辞遭掣顿，云鹏那复计期程。\n遥知此去常乖隔，莫惜书来访死生。\n早与朝廷定巴蜀，故山迟暮欲归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"令人生日以画十六大阿罗汉为寿仍作三颂以祝长年 其一","author":"韩驹","text":"悟得玄机已数年，曾蒙老宿印明禅。\n定知凡物难为寿，故仗高人结胜缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"令人生日以画十六大阿罗汉为寿仍作三颂以祝长年 其二","author":"韩驹","text":"数枝西国芬陀利，一瓣南天波律香。\n持作诞辰罗汉供，愿如罗汉寿无央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"令人生日以画十六大阿罗汉为寿仍作三颂以祝长年 其三","author":"韩驹","text":"生朝欲作祈年供，长寿玉圭天上来。\n定是从今有家庆，世人传作画图开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某已被旨移蔡贼起旁郡未果进发今日上城部分民兵阅视战舰口号五首 其一","author":"韩驹","text":"永安城外山危立，赤壁矶边水倒流。\n此地能令阿瞒走，小偷何敢下芦洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某已被旨移蔡贼起旁郡未果进发今日上城部分民兵阅视战舰口号五首 其二","author":"韩驹","text":"病守虽闲鬓未苍，尚能谈笑坐胡床。\n指挥一扫妖氛尽，便自关山向汝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某已被旨移蔡贼起旁郡未果进发今日上城部分民兵阅视战舰口号五首 其三","author":"韩驹","text":"昨夜黄州得蜡书，老臣恨已解兵符。\n莫将箭污偷儿血，留与官家北射胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某已被旨移蔡贼起旁郡未果进发今日上城部分民兵阅视战舰口号五首 其四","author":"韩驹","text":"百忧前日总薰心，一笑朝来得好音。\n绝域不须遮虏障，今年自有杀胡林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某已被旨移蔡贼起旁郡未果进发今日上城部分民兵阅视战舰口号五首 其五","author":"韩驹","text":"沙场腊送亡胡月，泽国春生贺汉年。\n说与胡儿莫轻出，黄冈直下有戈船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咸平生日 其一","author":"韩驹","text":"昔年亲擢校书郎，夜梦苍龙绕屋梁。\n异时那知今日应，六龙深驻载赓堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咸平生日 其二","author":"韩驹","text":"已向丛霄侍玉宸，朅来端为付经纶。\n不须更说人间事，曾是仙中第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题孙子绍所藏王摩诘渡水罗汉","author":"吕本中","text":"问渠褰裳欲何往，彷徨徙倚沧波上。\n至人入水固不濡，何以有此恐怖状。\n我知摩诘意未真，欲以笔端调世人。\n此水此渡俱非实，摩诘亦未尝下笔。\n孙郎宝藏今几年，往来周旋兵火间。\n世人险阻更百难，彼渡水者安如山。\n请君但作如此观，莫更思维寻笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏太平宰相","author":"韩驹","text":"万里青霄发轫时，骅骝绝足看奔驰。\n太平宰相何人识，惟有巫咸得预知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代妓送葛亚卿","author":"韩驹","text":"刘郎底事去匆匆，花有深情只暂红。\n弱质未应贪结子，细思须恨五更风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠向巨源","author":"韩驹","text":"老子真祠地，君来觅纸题。\n文如士衡后，年与正平齐。\n闻说钟陵郡，官居章水西。\n涪翁诗律在，佳处可提携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"改王智兴诗","author":"韩驹","text":"三十年前一乞儿，荆公曾为替梅诗。\n如今输了无人替，莫向金陵更下棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十五夜小雨同二弟作","author":"韩驹","text":"去年看月思君处，醉后狂歌和影舞。\n今年与君待月时，金樽未尽雨催诗。\n乐事良辰难并有，一生费诗仍费酒。\n君不见绿幕朱帘蜡炬香，何须拂地觅孤光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十四日夜作","author":"韩驹","text":"三更欲眠灯挂壁，被冷何曾双脚直。\n西风一夜枕边鸣，令我下床三叹息。\n君莫悲秋且自悲，朱颜白发来相随。\n天公造作悲欢事，要令百岁如狂痴。\n达人大观无不可，岂合坐受天公欺。\n我惭无处看明月，一掌荒庭秋草没。\n去年忆上黄神山，笑看万里清光发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张子文中秋夜月","author":"韩驹","text":"平湖下明月，湛如奁湿银。\n遥怜钟陵客，卧看繁台云。\n我欲故山去，向来车已巾。\n淹留属中秋，顾愁愁单身。\n停杯问青天，谁驾此玉轮。\n分光到蓬屋，殷勤月夫人。\n张郎嗜读书，佔毕闻比邻。\n胡为叹今夕，长歌击匏尊。\n似君岂终穷，努力逢休辰。\n他年和此唱，寄我东南垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春二首 其一","author":"韩驹","text":"春风吹绿原头草，草色雨馀晴更好。\n堂前帘静燕初忙，江上麦齐蚕欲老。\n腐儒饱食欣自得，日长但酣春昼眠。\n户屦无人足清绝，觉来幽响落山泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春二首 其二","author":"韩驹","text":"东风著物犹未惊，忽听林间鹎鵊鸣。\n濑水生波先泛泛，烧痕破暖渐青青。\n农家且喜春耕足，未晓呼儿饭黄犊。\n谁家跃马来探春，却笑澜翻啼布谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋","author":"韩驹","text":"秋风淅淅摇密竹，乍觉凉生洗炎溽。\n豆田雨过麦毛肥，蘋渚风轻浪痕蹙。\n田家社日试新篘，相过一饭百在忧。\n却笑儒生真自苦，发如衰草不胜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题曾公卷采菊图","author":"韩驹","text":"九日东篱采落英，白衣遥见眼能明。\n向令自有杯中物，一段风流可得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"韩驹","text":"此时造化何容易，终日飘零似等闲。\n截断琼田馀白水，放开琪树出青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏千叶桃","author":"韩驹","text":"灼灼开元销恨花，连昌春苑盛恩华。\n如今妖艳无人比，笑倚东风日自斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃","author":"韩驹","text":"云锦涨春坞，霞绡炫夕阳。\n东风多乐意，不特为红芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅","author":"韩驹","text":"断堑疏篱一水滨，压枝冰雪眼中春。\n悬知东阁一端兴，不减扬州千载人。\n晚岁风霜从惨淡，寒梢气象自清真。\n此来定做西湖梦，疏影横斜访旧邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上丘漕司生辰诗","author":"韩驹","text":"淮海钟神秀，逢时出伟人。\n熊罴符吉梦，弧矢记佳辰。\n瑞世仪丹凤，占祥得石麟。\n心田平若砥，学海阔无津。\n道任司衡重，儒传孟氏醇。\n雄文追灏噩，雅意蕴经纶。\n大策登商第，英名动搢绅。\n含香登粉署，画诺拥朱轮。\n画戟声称远，星轺宠数频。\n一时推厚德，列郡仰深仁。\n櫜紫殊恩近，官黄墨诏新。\n风云看际会，廊庙喜同寅。\n寿斝霞纹细，香莲露脸匀。\n愿赓难老颂，阅岁等庄椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上钟太守生辰诗","author":"韩驹","text":"道在轲雄出，时平稷契生。\n荆山方秀整，金气与高明。\n磊落难藏器，峥嵘易得名。\n宏才须视草，大手本调羹。\n欲赋龙骧远，方看凤翥横。\n海门迎五马，桂岭换双旌。\n渐许含香侍，宁为剖竹行。\n悠悠真任物，扰扰不关情。\n札有十行赐，政应期月成。\n风流前辈似，文采后来倾。\n日月开黄道，云烟焕赤城。\n还朝充柱石，与世作权衡。\n仙果千年实，洪涛几度清。\n于公一俯仰，几杖表馀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上赵倅生辰诗","author":"韩驹","text":"世运千龄遇，皇图永绍休。\n天方祚尧舜，家自产伊周。\n戟路炎风转，弧门喜气浮。\n九苞惟得凤，三日已窥牛。\n祖牒绵瓜瓞，亲庭结冕旒。\n朱轓资佐理，黄屋得分忧。\n白贺才名远，毛原德业优。\n维城流雅咏，戏綵晢民讴。\n暂出丞侯度，行归炳帝猷。\n职堪调玉铉，名已覆金瓯。\n甲第开华旦，琼筵盛荐羞。\n宝钗分乐队，珠玉萃宾游。\n龟鹤齐称寿，觥船递献酬。\n后天长不老，仙袂拍浮丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上卢运使生辰二四首 其一","author":"韩驹","text":"有玉山自辉，无蠹木不疾。\n人心渺难测，天理坐可必。\n我公仁者静，寿骨已崷嵂。\n岂比山泽儒，辛苦饵芝朮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]