[{"title":"大涤洞","author":"叶漙","text":"青山曲折锁瑶扉，俗客频劳揽芝衣。\n更看临流轻指顾，翠蛟化作玉龙飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠月洞先生","author":"叶碧峰","text":"跳出尘关百念轻，大元羽士宋儒生。\n易参羲圣通玄妙，诗比唐人并驾行。\n咒水洒时天地净，符文书处鬼神惊。\n洞中静夜天留月，心与梅花一样清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姜邦杰感兴","author":"叶翥","text":"枌梓交游尽，灵光岿独存。\n声名今绮皓，公论自推尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送芍药 其二","author":"叶翥","text":"枌社光荣昼锦归，新移红药著花时。\n慇勤折赠难虚掷，要向诗翁觅好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同姜邦杰游南湖","author":"叶翥","text":"联骑上南明，清谭意自倾。\n云垂山掩翠，风静雨飞声。\n幽壑藏舒景，清溪漾晚晴。\n从容共樽酒，欲别正关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姜邦杰赠别","author":"叶翥","text":"研席当时辈，凋零只两翁。\n荣归会面喜，话旧此心同。\n景物诗篇富，交情古道隆。\n明朝斟别酒，问讯付邮筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送芍药 其一","author":"叶翥","text":"清和天气属良辰，芳事枝头迹已陈。\n閒涉小园销永昼，尚留红药殿馀春。\n栽培元是根宜地，幻化须知花有神。\n约定明年身更健，诗篇又见一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题谢清音道人扇面","author":"叶翥","text":"归休谢去世间忙，看画题诗引兴长。\n忽见远山来几席，方知妙笔出闺房。\n百杯歌彻行云住，万象心营点墨香。\n珍重制成团月扇，清风满座自生凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题兴道院蓝光轩","author":"叶翥","text":"出郭才咫尺，便觉山意幽。\n招提立绝顶，宝塔凌空浮。\n小轩足娱客，下有清溪流。\n翠岫供远眺，直欲明双眸。\n平芜草肥软，饱饲眠吴牛。\n沙头水色静，飞上驯白鸥。\n人稀日亭午，野渡横孤舟。\n坐久意逾爽，吹袂风飕飕。\n想当三伏天，凛然如素秋。\n簿书丛里来，恍若脱羁囚。\n乘兴偶登览，不谓成胜游。\n平生志所愿，一壑与一邱。\n脚力到佳处，须作信宿留。\n南峰只在眼，不必劳冥搜。\n当时辋川图，景物有此不。\n学贵守所见，出处各异谋。\n渊明亦高哉，未肯屈督邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送水云归吴","author":"叶静慧","text":"塞上砧声响似雷，怜君骑马望南回。\n今宵且向穹庐醉，后夜相思无此杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过黄杨奥孝子董公墓","author":"叶澄","text":"我陟黄杨奥，我怀董孝君。\n怀君君不见，冢草裹晴云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三里塘掐梅","author":"叶樾","text":"扶疏不耐繁华，意足自然清绝。\n壁间幻出横斜，祇欠纱窗明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿田寺集杜五言","author":"叶衡","text":"水花分堑弱，山木抱云稠。\n更宿招提境，还同惠远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝乘寺","author":"叶衡","text":"巍巍画栋插晴空，时有芳馨四面通。\n好为高禅参鼻观，未应公子斗薰笼。\n帘前一炷沉檀晕，窗外数番兰蕙风。\n信道杜陵佳句在，心清浑赋此堂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昆山吕正之三男子连中神童科盖奇事也次严别驾韵","author":"叶衡","text":"三秀标姿颖不凡，姓名联列紫微间。\n已知凤穴梧栖稳，谁谓鹏程云路艰。\n孔释当年亲抱送，由庄逸驾定追攀。\n发挥更有文章伯，高压淮南大小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"叶衡","text":"东家屋被西家盖，仔细思量无利害。\n他时折屋别陈词，如今且以壁为界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题光华亭","author":"叶簬","text":"画栋朱帘势翼然，鼎新气象冠山川。\n鹅黄杨柳浮春晚，鸭绿烟波送客船。\n轮奂不妨农事日，风光好近麦秋天。\n佐君治简有馀暇，杯酒从教尽日传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千顷云","author":"司马允中","text":"且与祖龙相颉颃，大施霖雨谩悠扬。\n归来好护安禅石，莫作巫山一梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆羽井","author":"司马允中","text":"百尺寒泉浸崖腹，藓蚀题名不堪读。\n只今此味属谁论，自把铜瓶汲新渌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈公楼","author":"司马允中","text":"陈公汲深实奇计，转向人间作丰岁。\n辘轳声晓潜虬寒，玄猿啼在深深树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点易亭","author":"司马伋","text":"洞天占胜作新亭，曲槛危檐揖翠屏。\n四顾风烟入怀里，一湾溪水抱沙汀。\n羽人不见论平昔，双鹤犹存有典型。\n幸得官闲成吏隐，何妨续说旧羲经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪尚书大猷归鄞 其二","author":"司马伋","text":"日者真奇中，春风画鹢行。\n东山须继起，南浦独伤情。\n越岸江山丽，都门祖道荣。\n里闾高卧际，趣诏逐追程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪尚书大猷归鄞 其一","author":"司马伋","text":"忆昔铨衡地，为郎得并游。\n惟公合明陟，顾我分夷犹。\n功业行将遂，轩车去莫留。\n祠庭固诚请，帝眷益绸缪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登麻蔺坂","author":"司马光","text":"客路逢佳节，无欢更益愁。\n前山造云日，登陟不因游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十七日邀子骏尧夫赏西街诸花","author":"司马光","text":"今年节物非常晚，春尽西街花尚多。\n试问二三真率友，小车篮舁肯重过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十六日作真率会伯康与君从七十八岁安之七十七岁正叔七十四岁不疑七十三岁叔达七十岁光六十五岁合五百一十五岁口号成诗用安之前韵 其二","author":"司马光","text":"经春无事连翩醉，彼此往来能几家。\n切莫辞斟十分酒，尽从他笑满头花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十六日作真率会伯康与君从七十八岁安之七十七岁正叔七十四岁不疑七十三岁叔达七十岁光六十五岁合五百一十五岁口号成诗用安之前韵 其一","author":"司马光","text":"七人五百有馀岁，同醉花前今古稀。\n走马斗鸡非我事，纻衣丝发且相晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月六日初见待漏房前柳色微绿欣然成咏","author":"司马光","text":"宫城映出丝丝绿，顿觉皇州春意回。\n从此不辞驱瘦马，六街终日踏尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十四日馆宿兴宗舍后桃花盛开偶书牖上","author":"司马光","text":"金马春寂寂，秾桃随意开。\n夕风零落尽，不待主人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十四日小园置茶招宗圣应之皆辞以醉为诗赠之","author":"司马光","text":"草树弄春晖，家家倒载归。\n谁怜独醒客，日暝掩双扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又七言","author":"司马光","text":"闻道山家门镇开，独驱瘦马出尘埃。\n白云明月先无约，何事今宵亦此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又即事二章上呈 其一","author":"司马光","text":"雨不成游半路归，逢花值柳倍依依。\n朝来赖饮三杯酒，醉卧西斋昼掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又即事二章上呈 其二","author":"司马光","text":"觉后追思气味长，欢情愁绪两俱忘。\n近来方得醉中趣，熟寐沈沈是醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和上元日游南园赏梅花","author":"司马光","text":"中令园陪丞相游，百分劝酒不须愁。\n春风陌上醒归去，只恐更为桃李羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和游吴氏园二首 其二","author":"司马光","text":"名园易主似行邮，美竹高松景自幽。\n谁信本来天地物，长为已有固无由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和游吴氏园二首 其一","author":"司马光","text":"天气清和无喘牛，花林烂熳竹林幽。\n临风高咏足为乐，