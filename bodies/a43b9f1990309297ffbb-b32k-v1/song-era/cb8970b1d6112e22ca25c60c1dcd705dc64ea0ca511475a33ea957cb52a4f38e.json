9a283ba061d3","dynasty":"宋"}},{"title":"过湖","author":"赵蕃","text":"杯珓吉难同，开船得转风。\n无云仗神道，人厄匪天穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过湖偶题书于邬子之津","author":"赵蕃","text":"洞庭厥大九州间，此地吞潴未觉悭。\n一抹远青为四望，亦云髣髴似君山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过湖得便风舟甚驶","author":"赵蕃","text":"鸟飞不尽水黏天，隐隐青山若个边。\n六幅蒲帆去如箭，江神有意特相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严从礼求先照轩诗","author":"赵蕃","text":"日上照万物，心明观一身。\n为光讵资火，在我不关人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严先辈送鲤鱼","author":"赵蕃","text":"严郎得鱼不敢食，走送茅斋嫌步迟。\n却愧家贫惯粗粝，无人为我脍银丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯山因其侄来惠书报以二绝 其二","author":"赵蕃","text":"蕙亩兰开梅吐枝，近来凡有几篇诗。\n已令经纪江头竹，早晚为君修短篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯山因其侄来惠书报以二绝 其一","author":"赵蕃","text":"昔日穷岗今竹溪，更生臣向复奚疑。\n此中安否渠能说，懒复作书聊寄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀干登眺有怀 其二","author":"赵蕃","text":"溪山虽好政须人，终日伥伥此水滨。\n试并栏干一回首，祇馀鸥鸟似相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀干登眺有怀 其一","author":"赵蕃","text":"溪山得意竟忘归，岁月飘零两鬓稀。\n祇有裴回与搜句，老无笔力愧传衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余客长沙寒热骤作其證未分理掾次律张君为致医王生述治之药与病合两日愈作七言二韵诗二首赠之 其二","author":"赵蕃","text":"频能通汗信柴胡，亦是于君想报珠。\n传闻治?更多活，岂止飘零一老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余客长沙寒热骤作其證未分理掾次律张君为致医王生述治之药与病合两日愈作七言二韵诗二首赠之 其一","author":"赵蕃","text":"士不知闻未易轻，问医谁复话君名。\n殷勤多谢长沙掾，为我致之分死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初九日 其一","author":"赵蕃","text":"一片花飞春未知，杜陵野客已深悲。\n况堪昨夜狂风雨，吹折东家桃树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初九日 其二","author":"赵蕃","text":"日日题诗待海棠，要从地主借绳床。\n偶因风雨愆期至，已是飘零学退妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初八日微雨明日犹有赐意作两绝句 其二","author":"赵蕃","text":"不堪积暑滞烦疴，幸甚新凉脱网罗。\n闻道重阳更逢闰，今年节意属秋多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初八日微雨明日犹有赐意作两绝句 其一","author":"赵蕃","text":"小雨那能救旱禾，定催粟玉放庭柯。\n一从赋罢横斜影，谁复风流似汝多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒无衾买纸被以纾急作四绝 其四","author":"赵蕃","text":"识字谁令胜烂奚，自应无褐更无衣。\n宵安亦念明朝计，儿报屋檐生早晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒无衾买纸被以纾急作四绝 其二","author":"赵蕃","text":"瑟缩从渠体尚生，不妨攲拥度天明。\n书生活计能消底，太息牛衣王仲卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒无衾买纸被以纾急作四绝 其三","author":"赵蕃","text":"度夕阴风吹扊扅，布衾如铁念娇儿。\n夜来例拜奇温赐，但觉安眠晓不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒无衾买纸被以纾急作四绝 其一","author":"赵蕃","text":"平生结得楮生缘，觅句抄书日费捐。\n只有夜窗宜暂舍，也须包裹伴幽眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事呈斯远三首 其三","author":"赵蕃","text":"一花固觉有馀香，况此寒梢数尺长。\n怪底诗来总清绝，始知逸韵与相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事呈斯远三首 其二","author":"赵蕃","text":"去却蔫花意转新，是知疏密总宜人。\n正由秽去清虚集，不碍萧然冠与巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事呈斯远三首 其一","author":"赵蕃","text":"并湖微径曲通村，步步看梅遂款门。\n犬似不能知客意，苦相唐突吠篱根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听雨堂二首 其二","author":"赵蕃","text":"曾见宋公及可公，自应诗句有家风。\n不因避疾小盘礴，那得清谈半日同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听雨堂二首 其一","author":"赵蕃","text":"竹径参差人不知，窈然终日坐题诗。\n我来欲去仍遗恨，不见萧萧风雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈子肃三首 其三","author":"赵蕃","text":"牢落空房我挂包，忆君过我夜推敲。\n东南大半行将遍，应有新诗许借钞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈子肃三首 其二","author":"赵蕃","text":"忆过君家黄堰居，春风杨柳政扶疏。\n人生离合自多感，邂逅更当摇落馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈子肃三首 其一","author":"赵蕃","text":"坊静行人昼成绝，柳吹黄叶落毵毵。\n知君不作官居看，陋巷旧谙人不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其十","author":"赵蕃","text":"道山峻峙不容攀，咫尺今遭风引还。\n闻道公曾踞其上，莫憎官府久人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其九","author":"赵蕃","text":"客舍潭州又一春，花时风雨困频频。\n欲知夏木扶疏处，好挂陶翁洒酒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其八","author":"赵蕃","text":"如闻欲印葆真诗，我亦犹多未见之。\n副本傥蒙轻乞与，真成暴富诧穷儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其七","author":"赵蕃","text":"旧有园林新近开，凿池培址遂成台。\n台颠纵有蒙笼处，不碍遥山次第来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其六","author":"赵蕃","text":"相逢几说李端公，未报舒州谢表通。\n要识淮南佳绝地，灊山皖水莫之同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其五","author":"赵蕃","text":"曾门昔作广文官，先正曾同苜蓿盘。\n交道不惟当日见，遗风更俾后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其四","author":"赵蕃","text":"不惟句律有家风，笔阵仍推大令工。\n兹道祗今殊寂寞，求公须向古人中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其三","author":"赵蕃","text":"故家人物几沈沦，公独风流似昔人。\n不但金声吐佳句，尚馀玉立耸长身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其二","author":"赵蕃","text":"朝廷经略在中原，西北人才要讨论。\n节传曾闻付吾属，潇湘可俾卧林园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈折子明丈十首 其一","author":"赵蕃","text":"儿时已见葆真诗，写诵抄藏不惮疲。\n白首始游衡岳寺，扶藜处处读苔碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈杨谨仲二首 其二","author":"赵蕃","text":"南浦相逢使蜀船，为余高举送行篇。\n我行纵有荣枯异，可乏新诗处处传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈杨谨仲二首 其一","author":"赵蕃","text":"清江郭内千竿竹，爱此浑如屋上乌。\n我亦山中富此物，若何奔走为饥驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈宜之兄八首 其六","author":"赵蕃","text":"书中道何似，诗有林霏寄。\n怪其句律工，定自工夫至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈宜之兄八首 其二","author":"赵蕃","text":"别来才一书，似若向兄疏。\n逢人问江右，说兄不敢虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔七首 其七","author":"赵蕃","text":"伯威虽拙诗故巧，我拙似渠诗欠工。\n竹溪想见梅花发，问讯穷冈今不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔七首 其六","author":"赵蕃","text":"岁寒谁觅此穷交，只有梅花发故梢。\n我坐多言得穷祟，不应于汝更轻嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔七首 其五","author":"赵蕃","text":"手种竹边梅一株，地幽终觉病而癯。\n不然我尔要相似，异日重看瘠解腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔七首 其四","author":"赵蕃","text":"一枝自可不须多，少已难知多奈何。\n汉殿纷纷锵剑佩，桐江但有一渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔七首 其三","author":"赵蕃","text":"屋角梅开才一枝，道人眼净得先窥。\n寒厅政尔犹官舍，不似茅檐见汝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔七首 其二","author":"赵蕃","text":"今年梅愈去年多，我亦催行奈汝何。\n此树与君同所植，交情要保岁寒柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔七首 其一","author":"赵蕃","text":"近郭梅开应已多，几思扶策奈慵何。\n兴来起觅墙阴树，点检无花除病柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈愚卿昆仲二首 其二","author":"赵蕃","text":"忆过君家梅半开，梅花未落我重来。\n寻常一饭履迹扫，独向君家不记回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈愚卿昆仲二首 其一","author":"赵蕃","text":"百个脩篁一树梅，蕙盆兰斛共相陪。\n客来不但翻书帖，兴至更能传酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其十","author":"赵蕃","text":"臂膝真成具老形，每逢趋走叹伶仃。\n故园松菊幸亡恙，何日扶藜得屡经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其九","author":"赵蕃","text":"满城游女竞纷纷，柳岸桃蹊昼复曛。\n不道贫家有机杼，夜窗灯火尚加勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]