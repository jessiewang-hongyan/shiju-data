[{"title":"偈颂一百五十首 其三十八","author":"释心月","text":"我有一机，对面提持。\n石火莫及，电光罔追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十七","author":"释心月","text":"我有一语，通今贯古。\n全主全宾，全规全矩。\n直下承当，未敢相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十六","author":"释心月","text":"我有一言，彻根彻源。\n举之不全，听之不圆。\n拟问如何，苍天苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪峰真觉禅师赞","author":"释心月","text":"出岭超方，九上三到。\n一槌便成，未是性燥。\n诵过水偈，闻色空义。\n搅炒肝肠，睡不成睡。\n棒头领旨，句下明宗。\n夜半鳌山，如鹤抛笼。\n象骨岩高，中有鳖鼻。\n千五百人，中伤者几。\n三毬并辊，大用全提。\n石火莫及，电光罔追。\n大地撮来，如粟米粒。\n今昔行人，看之不出。\n望州乌石，日炙风吹。\n万福曾郎，眼戴双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞寂岩忠和尚","author":"释心月","text":"师之出处，师之面颜。\n云横楚甸，雨过淮山。\n阅其语录，见其作用。\n玉转珠回，云兴泉涌。\n寂岩之道，莫能形容。\n我今赞之，持尺量空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过桥遭攧有省作偈","author":"释守端","text":"我有明珠一颗，久被尘劳关锁。\n今朝尘尽光生，照破山河万朵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其一四五","author":"释心月","text":"参禅须是铁汉，著手心头便判。\n直趣无上菩提，一切是非莫管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其一一六","author":"释心月","text":"一人跨三脚驴，一人骑三角虎。\n三家村里交肩，万仞崖头移步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十四","author":"释心月","text":"去年七月十五，去去留之不住。\n今年七月十五，住住推之不去。\n去也师子翻身，住也象王回顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释心月","text":"善恶不思，名为顶句。\n内外绝依，名为得住。\n时时寂寂惺惺，时时退步荐取。\n如是三十年，觅之总无处。\n觅无处，赢得双眉时陡聚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狗子无佛性","author":"释心道","text":"狗子佛性无，老蚌吐明珠。\n西川鸣杜宇，江南啼鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣和二年复僧作偈","author":"释心道","text":"不挂田衣著羽衣，老君形相颇相宜。\n一年半内闲思想，大底兴衰各有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烧木佛","author":"释心道","text":"彭祖八百乞延寿，秦皇登位更求仙。\n昨向天津桥上过，石崇犹自送穷船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勘婆","author":"释心道","text":"三月春光上国游，祥云瑞气锁龙楼。\n亲从宣德门前过，更问行人觅汴州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野狐","author":"释心道","text":"石崇富贵篯铿寿，潘岳容仪子建才。\n但愿东风齐著力，一时吹入我门来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈佛鉴禅师偈","author":"释心道","text":"赵州有个柏树话，禅客相传遍天下。\n多是摘叶与寻枝，不能直向根源会。\n觉公说道无此语，正是恶言当面骂。\n禅人若具通方眼，好向此中辨真假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"举临济人灭嘱三圣因缘作偈","author":"释心道","text":"正法眼藏瞎驴灭，临济何曾有是说。\n今古时人皆妄传，不信但看后三月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣和改元改僧为德士作偈","author":"释心道","text":"祖意西来事，今朝特地新。\n昔为比丘相，今作老君形。\n鹤氅披银褐，头包蕉叶巾。\n林泉无事客，两度受君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释心道","text":"师子嚬呻，象王哮吼。\n云门北斗里藏身，白云因何唤作手。\n三世诸佛不能知，狸奴白牯却知有。\n雨打梨花蛱蝶飞，风吹柳絮毛毬走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释心道","text":"契丹打破波斯寨，夺得宝珠村里卖。\n十字街头穷乞儿，腰间挂个风流袋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台石桥","author":"释文礼","text":"桥横飞涧上崔嵬，涧瀑千寻吼怒雷。\n五百声闻看不破，至今活葬在岩隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示圆證知客","author":"释文礼","text":"莫年结屋傍山椒，门外荆芜没半腰。\n几度赚君来扣击，老无气力举藤条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛光炤公首依于梁渚今往下竺参北峰印禅师二首 其二","author":"释文礼","text":"拣境分明妙药方，馀之分别更须忘。\n晚风吹落残红片，休向枝头觅旧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛光炤公首依于梁渚今往下竺参北峰印禅师二首 其一","author":"释文礼","text":"送子参寻灵鹫山，诸方多是落前三。\n自从开异归同后，玄旨于今亦倦谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送晦岩佛光法师归天竺 其一","author":"释文礼","text":"飏下天台故纸堆，为搜言外蒋山来。\n浙翁拶到无栖泊，谓实情忘撒手回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送晦岩佛光法师归天竺 其二","author":"释文礼","text":"归去相依有鹫山，渠家一向斥前三。\n谁知开异来同了，圆旨如今亦厌谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归雁山","author":"释文礼","text":"秋来归去雁山阿，为问龙湫诺讵那。\n贪看高崖千丈雪，伽梨打湿竟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其五十三","author":"释文礼","text":"白牛烹了正熙熙，皮角官中却要追。\n将下帽檐输纳了，灯前更鼓夜迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其五十二","author":"释文礼","text":"大龙景物最幽妍，涧水山花照眼鲜。\n坚固法身何必问，风光长在劫壶先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其五十一","author":"释文礼","text":"贺家湖上天华寺，一一轩窗面水开。\n不是闭门防俗客，爱闲能有几人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十九","author":"释文礼","text":"天地广无边，何云藏北斗。\n跛脚老云门，未明三八九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十八","author":"释文礼","text":"读书人报来，岂在之乎者。\n孔子与周公，皆不及门也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十七","author":"释文礼","text":"因我得礼你，事从叮嘱起。\n谁知白蘋风，不在秋江里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十六","author":"释文礼","text":"磐陀漠漠秘苍苔，终日跏趺两鬓摧。\n纵使不曾呼唤著，何尝谩得阿师来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十四","author":"释文礼","text":"从来六个不知音，一个全抛恶浪深。\n义断情忘无处觅，三千刹海冷沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十三","author":"释文礼","text":"不动蒲帆问一言，大鱼却被小鱼吞。\n直从意外超唇吻，始信岩头无脑门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十二","author":"释文礼","text":"法战场开验克宾，解施武略对将军。\n如何有罪全无赏，待展奇谋自策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十","author":"释文礼","text":"庵僧真实济凶人，一喝分明出差珍。\n莫道贼魁非别者，当头雪刃用来亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十九","author":"释文礼","text":"住山境界问如何，女子双鬟鬓已皤。\n觌面不逢休更会，白云飞过旧山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十七","author":"释文礼","text":"亲到龙潭已暗投，夜深谁共御街游。\n纸灯吹灭狼烟息，坐断中原四百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十六","author":"释文礼","text":"师之一字太孤危，文□□无作者知。\n不领韶阳提起处，且从默处认残碑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十五","author":"释文礼","text":"乌藤倒挂向平田，便把羸牛痛下鞭。\n更说养来经五岁，始终只是老婆禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十三","author":"释文礼","text":"祸福无门口自招，三遭瞎棒打驴腰。\n可怜败国亡家恨，万古春风吹不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十二","author":"释文礼","text":"阶头放下劫初铃，相扑呼它马使名。\n五棒打来无雪处，却言渠不是官行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十一","author":"释文礼","text":"剩噇生菜似头驴，临济堂前捉败渠。\n耸耳长鸣随踢踏，不知业债倩谁除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十","author":"释文礼","text":"以此振铃伸召请，旋风连架打将来。\n大悲院里逻斋去，肘露皮穿可怪哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十五","author":"释文礼","text":"散席迢迢到海涯，点头桡下丧全机。\n父南子北今何在，月冷渔歌落钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十四","author":"释文礼","text":"天地同根物一体，大夫曾举向南泉。\n庭前指出花如夜，几个亲曾到槛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十三","author":"释文礼","text":"百千诸佛居何士，崔颢曾题黄鹤楼。\n倒腹倾肠犹不会，长江千古自东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十二","author":"释文礼","text":"不作青黄见，其如稻穗何。\n鹅王能择乳，鹞子过新罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十一","author":"释文礼","text":"看破牛皮彻底穿，到头无义亦无文。\n问伊遮得何人眼，梵语唐言总不分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十","author":"释文礼","text":"作舞金牛错用心，唤人吃饭笑忻忻。\n黄金自有黄金价，何必和沙卖与人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十九","author":"释文礼","text":"说理谈真面紫宸，鹅湖大义枉劳神。\n由来佛性难名邈，争似君王默契亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十八","author":"释文礼","text":"山忘孤峻玉忘瑕，到处仙源是我家。\n堪笑葛洪曾未悟，远从勾漏问丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十七","author":"释文礼","text":"薤歌声咽些声长，听得哀哀忽断肠。\n依旧红轮西畔没，大千无地著凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十六","author":"释文礼","text":"扇子分明都破了，盐官却又索犀牛。\n须知侍者难开口，无可还他即便休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十五","author":"释文礼","text":"南泉水牯忘鞭索，南北东西共一家。\n王税及时都纳了，牧童横笛远山斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十四","author":"释文礼","text":"南泉捧钵入堂来，宾主分明肯自乖。\n莫把威音论戒腊，本无位次可差排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十一","author":"释文礼","text":"即心便是佛，姮娥不画眉。\n才将脂粉污，妍好却成媸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其九","author":"释文礼","text":"满头白发老岩隈，万本青松懒更栽。\n皮袋累他周氏女，难寻踪迹去还来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其八","author":"释文礼","text":"强将不识鼓唇牙，胡语如何乱得华。\n若使老萧皮有血，定应赶逐过流沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其七","author":"释文礼","text":"不汝还者复是谁，残红流在钓鱼矶。\n日斜风定无人扫，燕子衔将水际飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其六","author":"释文礼","text":"舍尽家财与己财，只将真法供如来。\n当初一路今何在，触目灵山翠作堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其五","author":"释文礼","text":"长汀汀上风颠子，曳杖回头等阿谁。\n向道那人元不在，汝须知有转身时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四","author":"释文礼","text":"贤圣中来不杀生，其家子母自团圆。\n阴阳造化初无迹，春在花枝特地妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三","author":"释文礼","text":"策起眉毛示育王，分明佛面露堂堂。\n至今阿耨池中水，流落人间润八荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二","author":"释文礼","text":"雪岭六年修苦行，今朝打失主人公。\n普天匝地无寻处，百亿分身是脱空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其一","author":"释文礼","text":"未曾撞入摩耶腹，两手知他甚处安。\n右胁出来魔境现，只堪惆怅不堪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释文礼","text":"此力分明在不欺，不欺能有几人知。\n要明象兔全提句，看取升阶正笏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄真寂深居圆鉴净和尚","author":"释文礼","text":"垦土耕烟四十年，了无禅教与人传。\n钁头边事谁相委，八月深居有笋鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞应庵华","author":"释文礼","text":"亭亭相对两苍松，不觉当门触祖翁。\n后代儿孙无著莫，忍听萧瑟起凄风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其一","author":"释文礼","text":"咄咄胡僧，齿缺面黑。\n满口乡谈，无人译得。\n只知结果自然成，不知满地花狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其四","author":"释文礼","text":"破头山前，三辞诏旨。\n教坏小儿，卖弄唇嘴。\n无端又上牛头山，更与懒融说道理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其六","author":"释文礼","text":"倩人书偈，巧说脱空。\n传衣宵遁，丧尽英雄。\n非风幡动惟心动，依旧埋身草莽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其三","author":"释文礼","text":"内外中间，觅罪不得。\n瞌睡醒来，眼睛突出。\n一从归去皖公山，直至如今没踪迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其二","author":"释文礼","text":"哀哉断臂，甘受欺瞒。\n心既不有，何处求安。\n寂寂少林人不见，一庭风雪夜漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]