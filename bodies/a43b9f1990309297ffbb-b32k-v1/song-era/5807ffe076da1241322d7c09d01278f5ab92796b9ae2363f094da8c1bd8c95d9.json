[{"title":"浣溪沙","author":"苏轼","text":"几共查梨到雪霜。\n一经题品便生光。\n木奴何处避雌黄。\n北客有来初未识，南金无价喜新尝。\n含滋嚼句齿牙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 咏橘","author":"苏轼","text":"菊暗荷枯一夜霜。\n新苞绿叶照林光。\n竹篱茅舍出青黄。\n香雾噀人惊半破，清泉流齿怯初尝。\n吴姬三日手犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 绍圣元年十月二十三日与程乡令侯晋叔、归善簿谭汲同游大云寺。野饮松下，乃设松黄汤，作此阙。余近酿酒。名之曰万家春。盖岭南万户酒也。","author":"苏轼","text":"罗袜空飞洛浦尘。\n锦袍不见谪仙人。\n携壶藉草亦天真。\n玉粉轻黄千岁药，雪花浮动万家春。\n醉归江路野梅新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 惠州改前韵","author":"苏轼","text":"九十日春都过了，贪忙何处追游。\n三分春色一分愁。\n雨翻榆荚阵，风转柳花毬。\n我与使君皆白首，休誇少年风流。\n佳人斜倚合江楼，水光都眼净，山色总眉愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"殢人娇 赠朝云","author":"苏轼","text":"白发苍颜，正是维摩境界。\n空方丈、散花何碍。\n朱唇箸点，更髻鬟生彩。\n这些个，千生万生只在。\n好事心肠，著人情态。\n閒窗下、敛云凝黛。\n明朝端午，待学纫兰为佩。\n寻一首好诗，要书裙带。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 端午","author":"苏轼","text":"轻汗微微透碧纨。\n明朝端午浴芳兰。\n流香涨腻满晴川。\n綵线轻缠红玉臂，小符斜挂绿云鬟。\n佳人相见一千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 同君生日放鱼取金光明经救鱼事","author":"苏轼","text":"泛泛东风初破五。\n江柳微黄，万万千千缕。\n佳气郁葱来绣户。\n当年江上生奇女。\n一盏寿觞谁与举。\n三个明珠，膝上王文度。\n放尽穷鳞看圉圉。\n天公为下曼陀雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 梅花","author":"苏轼","text":"玉骨那愁瘴雾，冰姿自有仙风。\n海仙时遣探芳丛。\n倒挂绿毛么凤。\n素面常嫌粉涴，洗妆不褪唇红。\n高情已逐晓云空。\n不与梨花同梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"苏轼","text":"定场贺老今何在。\n几度新声改。\n怨声坐使旧声阑。\n俗耳只知繁手、不须弹。\n断弦试问谁能晓。\n七岁文姬小。\n试教弹作辊雷声。\n应有开元遗老、泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 己卯儋耳春词","author":"苏轼","text":"春牛春杖。\n无限春风来海上。\n便丐春工。\n染得桃红似肉红。\n春幡春胜。\n一阵春风吹酒醒。\n不似天涯。\n捲起杨花似雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千秋岁 次韵少游","author":"苏轼","text":"岛边天外。\n未老身先退。\n珠泪溅，丹衷碎。\n声摇苍玉佩。\n色重黄金带。\n一万里。\n斜阳正与长安对。\n道远谁云会。\n罪大天能盖。\n君命重，臣节在。\n新恩犹可觊。\n旧学终难改。\n吾已矣。\n乘桴且恁浮于海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 以大琉璃杯劝王仲翁","author":"苏轼","text":"海南奇宝。\n铸出团团如栲栳。\n曾到昆崙。\n乞得山头玉女盆。\n绛州王老，百岁痴顽推不倒。\n海口如门。\n一派黄流已电奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 陈公密出侍儿素娘歌紫玉箫曲，劝老人酒。老人饮尽，为赋此词","author":"苏轼","text":"笑撚红梅亸翠翘。\n扬州十里最妖饶。\n夜来绮席亲曾见，撮得精神滴滴娇。\n娇后眼，舞时腰。\n刘郎几度欲魂消。\n明朝酒醒知何处，肠断云间紫玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水龙吟 雁","author":"苏轼","text":"露寒烟冷蒹葭老，天外征鸿寥唳。\n银河秋晚，长门灯悄，一声初至。\n应念潇湘，岸遥人静，水多菰米。\n□望极平田，徘徊欲下，依前被、风惊起。\n须信衡阳万里，有谁家、锦书遥寄。\n万重云外，斜行横阵，才疏又缀。\n仙掌月明，石头城下，影摇寒水。\n念征衣未捣，佳人拂杵，有盈盈泪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哨遍","author":"苏轼","text":"睡起画堂，银蒜押帘，珠幕云垂地。\n初雨歇，洗出碧罗天，正溶溶养花天气。\n一霎暖风回，芳草萦光浮动，捲皱银塘水。\n方杏靥匀酥，花须吐绣，园林排比红翠。\n见乳燕、捎蝶过繁枝。\n忽一线、炉香逐游丝。\n昼永人閒，独立斜阳，晚来情味。\n便乘兴、携将佳丽。\n深入芳菲里。\n拨胡琴语，轻拢慢撚总伶俐。\n看紧约罗裙，急趣檀板，霓裳入破惊鸿起。\n颦月临眉，醉霞横脸，歌声悠扬云际。\n任满头红雨落花飞。\n渐鳷鹊、楼西玉蟾低。\n尚徘徊、未尽欢意。\n君看今古悠悠，浮幻人间世。\n这些百岁，光阴几日，三万六千而已。\n醉乡路稳不妨行，但人生、要适情耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木兰花令","author":"苏轼","text":"经旬未识东君信。\n一夕薰风来解愠。\n红绡衣薄麦秋寒，绿绮韵低梅雨润。\n瓜头绿染山光嫩。\n弄色金桃新傅粉。\n日高慵捲水晶帘，犹带春醪红玉困。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"苏轼","text":"闻道双衔凤带，不妨单著鲛绡。\n夜香知与阿谁烧。\n怅望水沈烟袅。\n云鬓风前绿卷，玉颜醉里红潮。\n莫教空度可怜宵。\n月与佳人共僚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华清引","author":"苏轼","text":"平时十月幸兰汤。\n玉甃琼梁。\n五家车马如水，珠玑满路旁。\n翠华一去掩方床。\n独留烟树苍苍。\n至今清夜月，依前过缭墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏幕遮 咏选仙图","author":"苏轼","text":"暑笼晴，风解愠。\n雨后馀清，暗袭衣裾润。\n一局选仙逃暑困。\n笑指尊前、谁向青霄近。\n整金盆，轮玉笋。\n凤驾鸾车，谁敢争先进。\n重五休言升最紧。\n纵有碧油，到了输堂印。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙","author":"苏轼","text":"冬夜夜寒冰合井，画堂明月侵帏。\n青缸明灭照悲啼。\n青缸挑欲尽，粉泪裛还垂。\n未尽一尊先掩泪，歌声半带清悲。\n情声两尽莫相违。\n欲知肠断处，梁上暗尘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 赠王友道","author":"苏轼","text":"谁道东阳都瘦损，凝然点漆精神。\n瑶林终自隔风尘。\n试看披鹤氅，仍是谪仙人。\n省可清言挥玉麈，真须保器全真。\n风流何似道家纯。\n不应同蜀客，惟爱卓文君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲 送张元康省亲秦川","author":"苏轼","text":"一曲阳关情几许。\n知君欲向秦川去。\n白马皂貂留不住。\n回首处。\n孤城不见天霏雾。\n到日长安花似雨。\n故关杨柳初飞絮。\n渐见靴刀迎夹路。\n谁得似，风流膝上王文度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲","author":"苏轼","text":"临水纵横回晚鞚。\n归来转觉情怀动。\n梅笛烟中闻几弄。\n秋阴重。\n西山雪淡云凝冻。\n美酒一杯谁与共。\n尊前舞雪狂歌送。\n腰跨金鱼旌旆拥。\n将何用，只堪妆点浮生梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定风波 重阳括杜牧之诗","author":"苏轼","text":"与客携壶上翠微。\n江涵秋影雁初飞。\n尘世难逢开口笑。\n年少。\n菊花须插满头归。\n酩酊但酬佳节了。\n云峤。\n登临不用怨斜晖。\n古往今来谁不老。\n多少。\n牛山何必更沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子","author":"苏轼","text":"冰雪透香肌。\n姑射仙人不似伊。\n濯锦江头新样锦，非宜。\n故著寻常淡薄衣。\n暖日下重帏。\n春睡香凝索起迟。\n曼倩风流缘底事，当时。\n爱被西真唤作儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 双荔支","author":"苏轼","text":"天与化工知。\n赐得衣裳总是绯。\n每向华堂深处见，怜伊。\n两个心肠一片儿。\n自小便相随，绮席歌筵不暂离。\n苦恨人人分拆破，东西。\n怎得成双似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 集句","author":"苏轼","text":"寒玉细凝肤。\n清歌一曲倒金壶。\n冶叶倡条遍相识，争如。\n豆蔻花梢二月初。\n年少即须臾。\n芳时偷得醉工夫。\n罗帐细垂银烛背，欢娱。\n豁得平生俊气无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 集句","author":"苏轼","text":"怅望送春杯。\n渐老逢春能几回。\n花满楚城愁远别，伤怀。\n何况清丝急管催。\n吟断望乡台。\n万里归心独上来。\n景物登临閒始见，徘徊。\n一寸相思一寸灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 集句","author":"苏轼","text":"何处倚阑干。\n弦管高楼月正圆。\n胡蝶梦中家万里，依然。\n老去愁来强自宽。\n明镜借红颜。\n须著人间比梦间。\n蜡烛半笼金翡翠，更阑。\n绣被焚香独自眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"苏轼","text":"城隅静女何人见。\n先生日夜歌彤管。\n谁识蔡姬贤。\n江南顾彦先。\n先生那久困。\n汤沐须名郡。\n惟有谢夫人。\n从来是拟伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"傅粉郎君又粉奴。\n莫教施粉与施朱。\n自然冰玉照香酥。\n有客能为神女赋，凭君送与雪儿书。\n梦魂东去觅桑榆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"道字娇讹语未成。\n未应春阁梦多情。\n朝来何事绿鬟倾。\n綵索身轻长趁燕，红窗睡重不闻莺。\n困人天气近清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"桃李溪边驻画轮。\n鹧鸪声里倒清尊。\n夕阳虽好近黄昏。\n香在衣裳妆在臂，水连芳草月连云。\n几时归去不销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"徐邈能中酒圣贤。\n刘伶席地幕青天。\n潘郎白璧为谁连。\n无可奈何新白发，不如归去旧青山。\n恨无人借买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"画隼横江喜再游。\n老鱼跳槛识清讴。\n流年未肯付东流。\n黄菊篱边无怅望，白云乡里有温柔。\n挽回霜鬓莫教休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"风捲珠帘自上钩。\n萧萧乱叶报新秋。\n独携纤手上高楼。\n缺月向人舒窈窕，三星当户照绸缪。\n香生雾縠见纤柔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"苏轼","text":"花满银塘水漫流。\n犀槌玉板奏凉州。\n顺风环佩过秦楼。\n远汉碧云轻漠漠，今宵人在鹊桥头。\n一声敲彻绛河秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子","author":"苏轼","text":"紫陌寻春去，红尘拂面来。\n无人不道看花回。\n惟见石榴新蕊、一枝开。\n冰簟堆云髻，金尊滟玉醅。\n绿阴青子莫相催，留取红巾千点、照池台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子","author":"苏轼","text":"寸恨谁云短，绵绵岂易裁。\n半年眉绿未曾开。\n明月好风閒处、是人猜。\n春雨消残冻，温风到冷灰。\n尊前一曲为谁哉。\n留取曲终一拍、待君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子","author":"苏轼","text":"云鬓裁新绿，霞衣曳晓红。\n待歌凝立翠筵中。\n一朵彩云何事、下巫峰。\n趁拍鸾飞镜，回身燕漾空。\n莫翻红袖过帘栊。\n怕被杨花勾引、嫁东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"苏轼","text":"晓来风细。\n不会鹊声来报喜。\n却羡寒梅。\n先觉春风一夜来。\n香笺一纸。\n写尽回纹机上意。\n欲卷重开。\n读遍千回与万回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"苏轼","text":"琵琶绝艺。\n年纪都来十一二。\n拨弄么弦。\n未解将心指下传。\n主人瞋小。\n欲向东风先醉倒。\n已属君家。\n且更从容等待他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 雪","author":"苏轼","text":"云容皓白。\n破晓玉英纷似织。\n风力无端。\n欲学杨花更耐寒。\n相如未老。\n梁苑犹能陪俊少。\n莫惹閒愁。\n且折江梅上小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 花","author":"苏轼","text":"玉房金蕊。\n宜在玉人纤手里。\n淡月朦胧。\n更有微微弄袖风。\n温香熟美。\n醉慢云鬟垂两耳。\n多谢春工。\n不是花红是玉红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"苏轼","text":"莺初解语。\n最是一年春好处。\n微雨如酥。\n草色遥看近却无。\n休辞醉倒。\n花不看开人易老。\n莫待春回。\n颠倒红英间绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行香子","author":"苏轼","text":"清夜无尘。\n月色如银。\n酒斟时、须满十分。\n浮名浮利，虚苦劳神。\n叹隙中驹，石中火，梦中身。\n虽抱文章，开口谁亲。\n且陶陶、乐尽天真。\n几时归去，作个閒人。\n对一张琴，一壶酒，一溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行香子 病起小集","author":"苏轼","text":"昨夜霜风。\n先入梧桐。\n浑无处、回避衰容。\n问公何事，不语书空。\n但一回醉，一回病，一回慵。\n朝来庭下，华英如霰，似无言、有意伤侬。\n都将万事，付与千钟。\n任酒花白，眼花乱，烛花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皂罗特髻","author":"苏轼","text":"采菱拾翠，算似此佳名，阿谁消得。\n采菱拾翠，称使君知客。\n千金买、采菱拾翠，更罗裙、满把珍珠结。\n采菱拾翠，正髻鬟初合。\n真个、采菱拾翠，但深怜轻拍。\n一双手、采菱拾翠，绣衾下、抱著俱香滑。\n采菱拾翠，待到京寻觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"苏轼","text":"持杯遥劝天边月。\n愿月圆无缺。\n持杯更复劝花枝。\n且愿花枝长在、莫离披。\n持杯月下花前醉。\n休问荣枯事。\n此欢能有几人知。\n对酒逢花不饮、待何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮郎归","author":"苏轼","text":"绿槐高柳咽新蝉。\n薰风初入弦。\n碧纱窗下水沈烟。\n棋声惊昼眠。\n微雨过，小荷翻。\n榴花开欲然。\n玉盆纤手弄清泉。\n琼珠碎却圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮郎归 梅花","author":"苏轼","text":"暗香浮动月黄昏。\n堂前一树春。\n东风何事入西邻。\n儿家常闭门。\n雪肌冷，玉容真。\n香腮粉未匀。\n折花欲寄岭头人。\n江南日暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门","author":"苏轼","text":"秋帷里。\n长漏伴人无寐。\n低玉枕凉轻绣被。\n一番秋气味。\n晓色又侵窗纸。\n窗外鸡声初起。\n声断几声还到耳。\n已明声未已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门","author":"苏轼","text":"秋池阁。\n风傍晓庭帘幕。\n霜叶未衰吹未落。\n半惊鸦喜鹊。\n自笑浮名情薄。\n似与世人疏略。\n一片懒心双懒脚。\n好教閒处著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门","author":"苏轼","text":"今夜雨。\n断送一年残暑。\n坐听潮声来别浦。\n明朝何处去。\n孤负金尊绿醑。\n来岁今宵圆否。\n酒醒梦回愁几许。\n夜阑还独语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"苏轼","text":"烟外倚危楼，初见远灯明灭。\n却跨玉虹归去、看洞天星月。\n当时张范风流在，况一尊浮雪。\n莫问世间何事、与剑头微吷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天仙子","author":"苏轼","text":"走马探花花发未。\n人与化工俱不易。\n千回来绕百回看，蜂作婢。\n莺为使。\n谷雨清明空屈指。\n白发卢郎情未已。\n一夜剪刀收玉蕊。\n尊前还对断肠红，人有泪。\n花无意。\n明日酒醒应满地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻香令","author":"苏轼","text":"金炉犹暖麝煤残。\n惜香更把宝钗翻。\n重闻处，馀熏在，这一番、气味胜从前。\n背人偷盖小蓬山。\n更将沈水暗同然。\n且图得，氤氲久，为情深、嫌怕断头烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃源忆故人","author":"苏轼","text":"华胥梦断人何处。\n听得莺啼红树。\n几点蔷薇香雨。\n寂寞閒庭户。\n暖风不解留花住。\n片片著人无数。\n楼上望春归去。\n芳草迷归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷华媚 荷花","author":"苏轼","text":"霞苞电荷碧。\n天然地、别是风流标格。\n重重青盖下，千娇照水，好红红白白。\n每怅望、明月清风夜，甚低迷不语，夭邪无力。\n终须放、船儿去，清香深处住，看伊颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"占春芳","author":"苏轼","text":"红杏了，夭桃尽，独自占春芳。\n不比人间兰麝，自然透骨生香。\n对酒莫相忘。\n似佳人、兼合明光。\n只忧长笛吹花落，除是宁王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一斛珠","author":"苏轼","text":"洛城春晚。\n垂杨乱掩红楼半。\n小池轻浪纹如篆。\n烛下花前，曾醉离歌宴。\n自惜风流云雨散。\n关山有限情无限。\n待君重见寻芳伴。\n为说相思，目断西楼燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 咏梅","author":"苏轼","text":"马趁香微路远，沙笼月淡烟斜。\n渡波清彻映妍华。\n倒绿枝寒凤挂。\n挂凤寒枝绿倒，华妍映彻清波。\n渡斜烟淡月笼沙。\n远路微香趁马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]