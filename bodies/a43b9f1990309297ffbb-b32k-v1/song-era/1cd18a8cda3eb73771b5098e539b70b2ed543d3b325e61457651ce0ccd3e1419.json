[{"title":"和至日北园宴集","author":"晏殊","text":"清晓融风肃桂堂，郡寮多暇舞筵张。\n台高已验云容媚，日暖悬知刻漏长。\n溪子弩寒千命中，兰英酒熟百传觞。\n官曹事集神都近，预拜需函庆一阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋子京召还学士院 其二","author":"晏殊","text":"暮召三山峻，晨趋一节回。\n乍维青雀舫，还直右银台。\n陟降丹涂密，论思武帐开。\n欲谈当世务，元藉轶群才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宋子京召还学士院 其一","author":"晏殊","text":"网索轩窗邃，銮坡羽卫重。\n鹢舟还下濑，星使出飞龙。\n赋待三英集，词须五吏供。\n会看边燧息，横霈紫泥封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和枢密侍郎因看海棠忆禁苑此花最盛","author":"晏殊","text":"青琐曾留眄，珍丛宛未移。\n幸分霖雨润，犹见艳阳姿。\n岸帻来朱槛，攀条忆绛蕤。\n能令人爱树，不独召南诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制上巳日","author":"晏殊","text":"青阳三巳日，佳气九城中。\n洛饮传周俗，溱诗载郑风。\n停轮浮桂醑，解袂泛兰丛。\n选胜开慈宴，多欢组绶同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制上元 其二","author":"晏殊","text":"凤掖千门迥，金缸四照然。\n市阛通夜阙，歌肆与云连。\n叠鼓迷清漏，游车际晓天。\n泛膏仍洁祀，蚕麦伫登年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制上元 其三","author":"晏殊","text":"鹑火告中时，皇州盛若兹。\n九阳同化洽，万汇得春熙。\n楼月将收晚，歌云度欲迟。\n布和周海域，翾蠕遂收宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制上元 其一","author":"晏殊","text":"协风阳律应，满砌荚蓂新。\n绛阙罗千卫，华灯曜百轮。\n悠悠未央夜，粲粲彼都人。\n万宇今无外，登台共乐春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制上元夜","author":"晏殊","text":"勾芒司节令，鹑火中星规。\n广陌消尘雾，重城集宴嬉。\n仙韶闻玉琯，宝焰列琼枝。\n万国同嘉会，胥庭即此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制上元夜","author":"晏殊","text":"兰灯照夕开南阙，星弁飞楼拱北辰。\n在镐正逢全盛日，祝尧皆是太平人。\n流风舞妙翻成字，积雪歌长迥绕尘。\n鸾鹊宝函颁睿什，明良赓载想同伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制元日 其一","author":"晏殊","text":"夏正标吉朔，尧历载初辰。\n柏叶清樽举，椒花绮颂陈。\n年芳随律盛，皇泽与时均。\n共有华封意，升平亿兆民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制元日 其二","author":"晏殊","text":"人正肇届时多祜，凤历惟新景载阳。\n双阙布和云气郁，千门献寿玉声长。\n东风入律三边静，北斗回春万物芳。\n朝暇肃诚颁睿藻，搢绅交抃捧尧章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制立春日 其一","author":"晏殊","text":"紫宙星回后，青郊斗建时。\n上林莺啭早，南亩雪消迟。\n云矞千祥集，风条万类滋。\n皇情同率土，黔首颂昌期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制立春日 其二","author":"晏殊","text":"阴阳自协璇玑运，和煦潜随缇管升。\n十二紫关鱼籥启，九重晓阙绛烟凝。\n芳华稍变青门柳，寒冻微消北陆冰。\n宸藻下颁羲日丽，八纮民庶保年登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制除夜 其二","author":"晏殊","text":"珠躔回碧落，绛燎烛青规。\n琐闼琼签度，层台玉漏移。\n纳新皇泽普，顺节圣情怡。\n万宇长安陌，乡傩集此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制除夜 其一","author":"晏殊","text":"秘掖楯轩严万户，庆宵躔次会三辰。\n丹闱肃穆犹凝夕，佳气葱珑渐报春。\n调历自将穹厚永，圣辞常与岁时新。\n送寒旁磔迎和令，率土群生仰昊旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和真宗御制后苑杂花海棠","author":"晏殊","text":"太液波才绿，灵和絮未飘。\n霞文光启旦，珠琲密封条。\n积润涵仙露，浓英夺海绡。\n九阳资造化，天意属乔繇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制中和节","author":"晏殊","text":"正元崇吉序，实历记良辰。\n营室彤曦转，勾芒令祀新。\n尧蓂方告朔，汉酎更宜春。\n菖叶农耕候，如膏洒泽频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"转运度支得青州资政黄素书韩吏部伯夷颂许昌相以以诗跋尾遂为七言因而寄及谨用拙篇纪咏","author":"晏殊","text":"首阳垂范远，吏部属辞深。\n染翰著嘉尚，系言光德音。\n褒崇亘千?，精妙极双金。\n题咏益珍秘，用昭贤彦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"晏殊","text":"十二重环閟洞房，愔愔危树俯回塘。\n风迷戏蝶闲无绪，露裛幽花冷自香。\n绮席醉吟销桂酌，玉台愁作涩银簧。\n梅青麦绿江城路，更与登高望楚乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸酉岁元日中书致斋感事","author":"晏殊","text":"一叶春王拆瑞筇，八斋西省夕香浓。\n多年不宿金闺署，半夜再闻长乐钟。\n却展旧编探史汉，更惭高步接夔龙。\n十思三省无荒豫，千载亨辰岂易逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送凌侍郎归乡","author":"晏殊","text":"江南藩郡古宣城，碧落神仙拥使旌。\n津吏戒船东下稳，悬僚负弩昼归荣。\n江山谢守高吟地，风月朱公故里情。\n曾预汉庭三独坐，府中谁敢伴飞觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送铅山周尉","author":"晏殊","text":"风烟古上饶，属邑寄山椒。\n仇览同栖棘，陶潜共折腰。\n安舆方就养，黄绶岂辞遥。\n善绩青箱业，兴廉有汉条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送董信州","author":"晏殊","text":"凤阙承丹诏，麟符得旧乡。\n雨中吴岫碧，林罅楚梅黄。\n使节江湖外，城楼翼轸旁。\n吾知召南树，从此接维桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归护国寺","author":"晏殊","text":"海峤黄金刹，安禅不记秋。\n来膺臣宰召，归泛越人舟。\n达性融三界，随缘极四流。\n还持双股锡，拂藓坐岩幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳夕内宿","author":"晏殊","text":"把菊醒陶酒，扬鞭入汉闱。\n聚蚊秋未息，独鸟暮先归。\n世有凉暄隔，人无今昨非。\n悠然倒冠佩，频梦北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠 其一","author":"晏殊","text":"轻盈千结乱樱丛，占得年芳近碧栊。\n逐处间匀高下萼，几番分破浅深红。\n烟晴始觉香缨绽，日极犹疑蜡蒂融。\n数夕朱栏未飘落，再三珍重石尤风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠 其二","author":"晏殊","text":"杳霭何惊目，鲜妍欲荡魂。\n向人无限思，当昼不胜繁。\n浩露晴方浥，游蜂暖更喧。\n只应春有意，留赠子山园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扈从观灯","author":"晏殊","text":"诘旦雕舆下桂宫，盛时为乐与民同。\n三千世界笙歌里，十二都城锦绣中。\n行漏不能分昼夜，游人无复辨西东。\n归来更坐嶕峣阙，万乐铮鏦密炬红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"麻姑山","author":"晏殊","text":"昔年权暂领军城，静爱仙山咏过春。\n天下云车曾祖驾，城中鳌海几生尘。\n明知绿发升真籍，堪笑苍颜预宪臣。\n我若粗成忠国事，赤松曾羡汉廷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食游王氏城东园林因寄王虞部","author":"晏殊","text":"谢墅林亭汴水滨，偶携佳客共寻春。\n看花纵拟思君子，对竹何曾问主人。\n促席正逢羲日缓，酡颜仍有郢醪醇。\n朝中九列无闲暇，愿作新诗赠季伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄远","author":"晏殊","text":"宝毂香轮不再逢，峡云巫雨杳无踪。\n梨花院落溶溶月，柳絮池塘淡淡风。\n几日寂寥伤酒后，一番萧索禁烟中。\n鱼书欲寄无由达，水远山长处处同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"棋盘石","author":"晏殊","text":"洞仙遗下石棋盘，人到壶天静处看。\n十九路谁弹黑界，几千年自带云寒。\n面平可步流星势，尘净元无旧藓瘢。\n乾雹声中闻子响，不知还许采樵观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋得秋雨","author":"晏殊","text":"点滴行云覆苑墙，飘萧微影度回塘。\n秦声未觉朱弦润，楚梦先知薤叶凉。\n野水有波增澹碧，霜林无韵湿疏黄。\n萤稀燕寂高窗暮，正是西风玉漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东湖涵虚阁","author":"晏殊","text":"水有支流树有孙，重重门巷挂朱轩。\n三君雅望标人杰，千里澄波隔世喧。\n西对户庭徐孺宅，北传钟梵给孤园。\n欲知嗣续无穷胜，两两荣归汉使轓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙寅中秋咏月","author":"晏殊","text":"玉籥秋初半，冰轮岁有期。\n苦吟含翰久，清宴下楼迟。\n雁怯波光动，蛩愁叶影危。\n烘帘频卷押，温酎旋凝澌。\n皎外蟾生滴，寒中桂有枝。\n星文藏熠耀，露彩见华滋。\n苑静疏萤湿，巢空惊鹤移。\n渐穿鸣瑟幌，偏鉴读书帷。\n濛谷徒催晓，纤阿莫放亏。\n陈王收妙舞，疑待仲宣辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和司空相公闰秋重九中书对菊","author":"晏殊","text":"两掖仪台峻，珍丛应序黄。\n积分回令节，伏槛赏幽芳。\n昧谷重延律，仙州剩借霜。\n冒寒知薏苦，逾分得荃香。\n汉幄群生遂，虞廷万事康。\n与人同所乐，留玩属澄觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过华夫书屋","author":"晏殊","text":"西斋辉赫亘山隅，嘉致清风世莫如。\n乡党名流依绛帐，烟萝幽境似仙居。\n趋庭子弟皆攀桂，弹铗宾朋总食鱼。\n汗简传经亚邹鲁，粉牌留咏尽严徐。\n杯盘互进先生馔，门巷应停长者车。\n坟籍岂惟精四部，弦歌常见习三馀。\n玳簪珠履延豪士，缥帙牙签刊赐书。\n碧沼暮凉浮菡萏，纱窗秋静漏蟾蜍。\n闲庭潇洒移泉石，华表峥嵘冠里闾。\n我恨羁游在芸阁，不陪诸彦曳长裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制冬至","author":"晏殊","text":"吉序冠三正，民时顺盛成。\n岁穰千亩实，气爽六符平。\n肆乐遵年律，迎长蔼颂声。\n云浓燕雁度，雪霁楚兰荣。\n异域梯航集，诸侯篚贡盈。\n尧仁敷万有，同此一阳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和圣制新春","author":"晏殊","text":"斗柄东回六合春，尧天历象与时新。\n铜壶瑞气延疏漏，青辂祥风绕画轮。\n云里楼台高郁郁，雨中原隰碧鳞鳞。\n千枝彩萼梅英吐，百尺金丝柳带匀。\n秉箓调元功有序，在璿观妙政惟醇。\n仰瞻魏阙宣和会，共识皇恩子万民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瞿生还拜亲","author":"晏殊","text":"门标杨氏阙，家有汉皇书。\n射策淹前志，鸣榔省旧居。\n仙山人罕到，幽境画难如。\n云窦开宾馆，芝田足岁储。\n修祠穷五际，为学慕三馀。\n努力文明代，翘翘托乘车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日北郡登高见寄","author":"晏殊","text":"前日登高泛玉卮，击铜赓唱有新辞。\n如何偶作销魂别，又复重吟把菊诗。\n上苑盍簪延景刻，北都投辖盛官仪。\n烦君见想欢言者，可奈衡门绝贡綦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古瓦砚诗 其一","author":"晏殊","text":"邺城宫殿久荒凉，缥瓦随波出禁墙。\n谁约藓文成古砚，放闲裁破碧鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石榴","author":"晏殊","text":"开从百花后，占断群芳色。\n更作琴轸房，轻盈琐窗侧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"列子有力命王充论衡有命禄极言必定之致览之有感","author":"晏殊","text":"大钧播群物，零茂归自然。\n默定既有初，不为智力迁。\n籞寇导其流，仲任派其源。\n智愚信自我，通塞当由天。\n宰世曰皋伊，迷邦有颜原。\n吾道诚一概，彼途钟百端。\n卷之入纤毫，舒之盈八埏。\n进退得其宜，夸荣非所先。\n朝闻可夕陨，吾奉圣师言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和致仕陈相公除夜","author":"晏殊","text":"从来岁除咏，托讽情非一。\n公在维师年，久谐归政逸。\n辛盘具芳郁，柏酒澄嘉栗。\n犹厌贺车烦，晨门效圭筚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢借观五老图","author":"晏殊","text":"道明回诏乐清闲，便向中朝脱冕冠。\n百日秉枢登相府，千年青史表旌桓。\n泰运正隆嫌气热，乾纲初整畏冰寒。\n逍遥唱和多高致，仪象霜风俾后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张太傅生日诗","author":"晏殊","text":"三陟槐庭二将坛，册书文武载勋贤。\n辞荣尚峻经邦秩，养素方临钓渭年。\n清会别开金谷墅，新吟多杂蕊珠篇。\n惊姜今日增华耀，海内簪绅共祝延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其三 东宫阁","author":"晏殊","text":"鲛冰千片解华池，神水香醪满爵卮。\n旭日九门凝瑞露，东厢朝拜奉宸慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王校勘中夏东园","author":"晏殊","text":"东园何所乐，所乐非尘事。\n野竹乱无行，幽花晚多思。\n闲窥鱼尾赤，暗辨蜂腰细。\n树影密遮林，藤梢狂罥袂。\n潘蔬足登膳，陶秫径取醉。\n幸获我汝交，都忘今昔世。\n欢言捧瑶佩，愿以疏麻继。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御制社日","author":"晏殊","text":"天官考历占元日，浃宇祈农协盛时。\n芟柞尚传周室颂，枌榆仍秩汉家祠。\n三农普遂耕耘乐，万象均承雨露滋。\n推策授人敷景化，穰穰喜贶亿年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳","author":"晏殊","text":"河柳擅佳名，青条发红穗。\n因愁百卉娇，强作芳菲意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题越州石氏山斋","author":"晏殊","text":"书仙十阁壮儒宫，灵越山川宝势雄。\n岫柏亚香侵几席，岩花回影入帘栊。\n千秋碧锁东南竹，一水清含旦暮风。\n文酒雅宜频宴集，谢家兰玉有新丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巢父井","author":"晏殊","text":"禀生值尧年，率性在庞厚。\n安巢一枝上，岂曰鹑居陋。\n颍波人洗耳，曾不污牛口。\n谅兹耕耒暇，凿饮隈林薮。\n含饴鼓其腹，帝力予何有。\n遂令千载外，此地存遗甃。\n泓然逼乔木，宛若栖嵵旧。\n乡人揭题榜，行旅谐瞻觏。\n我来观古迹，愕立徘徊久。\n凄其望清风，不获见师友。\n愿言?一勺，拭面洗心垢。\n翘勤慕高躅，感慨陈卮酒。\n思齐胡可望，庶以宽容瞀。\n夙驾恨长途，凭高重回首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食东城作","author":"晏殊","text":"王城五百车马繁，重帷黕幕纷郊原。\n游人得意惜光景，恣寻复树登高轩。\n平芜远水知何许，眼入迢迢空处所。\n梨花澹艳柳丝长，百计撩春作烟雨。\n歌哭声中半落晖，雕鞍绣毂尚迟归。\n荒田野草人间事，谁向伶玄泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"椿","author":"晏殊","text":"峨峨楚南树，杳杳含风韵。\n何用八千秋，腾凌诧朝菌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太祖庙","author":"晏殊","text":"炎宋肇英主，初九方潜鳞。\n尝因蓍蔡占，地决天地屯。\n庚庚大横兆，謦咳如有闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠会稽道士","author":"晏殊","text":"藐姑容化三阴馆，句漏砂封六乙泥。\n五练夜穷青玉枕，七明晨采碧云梯。\n冠霞高把浮丘袂，握体深藏鬼谷奚。\n知有山西驻龄药，何妨相赠一刀圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山亭柳 赠歌者","author":"晏殊","text":"家住西秦，赌博艺随身。\n花柳上，斗尖新。\n偶学念奴声调，有时高遏行云。\n蜀锦缠头无数，不负辛勤。\n数年来往咸京道，残杯冷炙漫消魂。\n衷肠事，托何人？\n若有知音见采，不辞遍唱《阳春》。\n一曲当筵落泪，重掩罗巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤衔杯 其二","author":"晏殊","text":"留花不住怨花飞。\n向南园、情绪依依。\n可惜倒红斜白、一枝枝。\n经宿雨、又离披。\n凭朱槛，把金卮。\n对芳丛、惆怅多时。\n何况旧欢新恨、阻心期。\n空满眼、是相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤衔杯 其一","author":"晏殊","text":"青苹昨夜秋风起。\n无限个、露莲相倚。\n独凭朱阑、愁望晴天际。\n空目断、遥山翠。\n彩笺长，锦书细。\n谁信道、两情难寄。\n可惜良辰好景、欢娱地。\n只恁空憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤衔杯 其三","author":"晏殊","text":"柳条花颣恼青春。\n更那堪、飞絮纷纷。\n一曲细丝清脆、倚朱唇。\n斟绿酒、掩红巾。\n追往事，惜芳辰。\n暂时间、留住行云。\n端的自家心下、眼中人。\n到处里、觉尖新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年游 其二","author":"晏殊","text":"霜华满树，兰凋蕙惨，秋艳入芙蓉。\n胭脂嫩脸，金黄轻蕊，犹自怨西风。\n前欢往事，当歌对酒，无限到心中。\n更凭朱槛忆芳容。\n肠断一枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年游 其四","author":"晏殊","text":"谢家庭槛晓无尘。\n芳宴祝良辰。\n风流妙舞，樱桃清唱，依约驻行云。\n榴花一盏浓香满，为寿百千春。\n岁岁年年，共欢同乐，嘉庆与时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]