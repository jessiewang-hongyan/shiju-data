[{"title":"绍兴亲享明堂二十六首 其二 升堂用《仪安》。","author":"郊庙朝会歌辞","text":"于赫明堂，肇称禋祀。\n祖宗来游，亦侑于帝。\n九州骏奔，百辟咸事。\n敛时纯休，锡我万世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其六 皇地祇位奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"至哉坤元，持载万物。\n继天神圣，观世治忽。\n颂祇之堂，荐以圭黻。\n孰为邦休，四海无拂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十三 皇地祇位酌献用《彰安》。","author":"郊庙朝会歌辞","text":"地祀泰折，歌同我将。\n黝牲纯洁，丝竹发扬。\n博厚而久，含洪以光。\n扶持宗社，曰笃不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十一 尚书捧俎用《禧安》。","author":"郊庙朝会歌辞","text":"展牲登俎，箫韶在庭。\n羞陈五室，意彻三灵。\n匪物斯享，惟诚则馨。\n永作祭主，神其亿宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十二 昊天上帝位酌献用《庆安》。","author":"郊庙朝会歌辞","text":"日在东陆，维时上辛。\n肇开阳馆，恭礼尊神。\n苍玉辉夜，紫烟炀晨。\n祖宗并配，天地同禋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十 皇帝还位用《仪安》。","author":"郊庙朝会歌辞","text":"耳听鋗玉，目瞻熉珠。\n乐备周奏，仪参汉图。\n神人并况，天地同符。\n亦既见帝，王心则愉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其二十一 皇帝饮福用《胙安》。","author":"郊庙朝会歌辞","text":"孰谓天远，至诚则通。\n孰谓地厚，与天则同。\n惠我纯嘏，克成大功。\n握图而治，如日之中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其八 太宗位奠币用《化安》。","author":"郊庙朝会歌辞","text":"帝神来格，靡祀不从。\n侑坐而食，独升祖宗。\n在庭祗肃，展采错重。\n三献之礼，百年之容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其五 上帝位奠玉币用《镇安》。","author":"郊庙朝会歌辞","text":"皇皇后帝，周览四方。\n眷我前烈，燕娭此堂。\n金支秀发，黼帐高张。\n世歆明祀，曰宋是常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其一 皇帝入门用《仪安》。","author":"郊庙朝会歌辞","text":"惟我有宋，昊天子之。\n三年卜祀，百世承基。\n施及冲眇，奉牲以祠。\n敢忘斋栗，偏举上仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其三 降神用《诚安》。","author":"郊庙朝会歌辞","text":"噫神何亲，惟德是辅。\n玉牲具陈，诚则来顾。\n我开明堂，遵国之故。\n尚蒙居歆，以笃宗祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其二十二 彻豆用《歆安》。","author":"郊庙朝会歌辞","text":"工祝告休，笙镛云阕。\n酒茅既除，牲俎斯彻。\n幽明罔恫，中外咸悦。\n礼成伊何，天地同节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十八 文舞退、武舞进用《穆安》。","author":"郊庙朝会歌辞","text":"神之歘至，庆阴杳冥。\n风马云车，恍若有承。\n备形声容，于昭文明。\n庶几嘉虞，来享来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 酌献用《德安》。","author":"郊庙朝会歌辞","text":"炎运中兴，苍生载宁。\n九秩燕豫，三纪丰凝。\n精祀上帝，陟配威灵。\n锡羡胙祉，万世承承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 高宗位奠币用《宗安》。","author":"郊庙朝会歌辞","text":"赫赫高庙，于尧有光。\n覆被万祀，冠冕百王。\n有量斯币，蠲洁是将。\n在帝左右，维时降康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 送神用《景安》。","author":"郊庙朝会歌辞","text":"帝在合宫，鉴观盛礼。\n黍稷惟馨，神心则喜。\n礼备乐成，亦既归止。\n亿万斯年，以贶多祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"温厚严凝，于皇上帝。\n文德武功，列圣并配。\n舞缀象成，肃雍进退。\n秉翟踆踆，总干蹈厉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 太宗位酌献用《德安》。","author":"郊庙朝会歌辞","text":"受命溥将，勋高百王。\n寰宇大定，圣治平康。\n有严陟配，宗祀明堂。\n神保是格，申锡无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 上帝位酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"烨彼房心，明明有融。\n维圣享帝，礼行合宫。\n祀事时止，粢盛洁丰。\n昭受申命，万福攸同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"备物昭陈，工祝告具。\n维羊维牛，孔硕孔庶。\n有嘉维馨，加食宜饫。\n敛时五福，永膺丰胙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 太宗位奠币用《宗安》。","author":"郊庙朝会歌辞","text":"穆穆皇祖，丕昭圣功。\n声律身度，乐备礼隆。\n祗荐量币，祀于合宫。\n玉帛万国，驩心载同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 上帝位奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"大享季秋，百执扬厉。\n明明太宗，赫赫上帝。\n祗荐忱诚，式严圭币。\n祚我明德，锡兹来裔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"皇祖配帝，岁祀明堂。\n冕服陟降，玉佩玱玱。\n疾徐有节，进止克庄。\n维时右享，日靖四方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49