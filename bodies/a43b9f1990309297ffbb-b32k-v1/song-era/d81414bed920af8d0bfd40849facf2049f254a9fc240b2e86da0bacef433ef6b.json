[{"title":"赵推寄朱氏楚辞","author":"韩淲","text":"回雁峰前寄楚辞，古时人语已如斯。\n少翔幕下宁天定，近入台中信已知。\n连帅朱今当共学，故侯刘昔尚谁思。\n春来草满南池水，何日薰兮又屈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坡翁","author":"韩淲","text":"鸡豚社酒属东坡，秋到黄州奈若何。\n主圣自应无所损，时清到了不能磨。\n后来海上归犹在，今则文忠谥孰过。\n三叹志林真不朽，儿童楚语任吴歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读徐湖雪句","author":"韩淲","text":"坐看何如更步行，草低叶滑小桥平。\n沾泥不作凡心浊，积水浑疑仙骨轻。\n云逼晓园几欲雨，烟开晚寺却嫌晴。\n一溪绕我山前去，未信溪山有我情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"今年数日雪连年所少也","author":"韩淲","text":"两年无雪今年雪，山积溪浮垄复横。\n消尽尘埃犹畏俗，酿成雅洁仅能清。\n烟绵细麦添生意，风飐枯梅更有情。\n蔌蔌声中见疏密，近多昏暗远如明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘克庄潜夫诗编","author":"韩淲","text":"等闲温李相游戏，有底应刘独怒嗔。\n雅调纵教胜俗调，古人疑不似今人。\n时閒作吏元非达，官满归乡必是贫。\n既往岩居惟野处，由来泽畔则江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋提刑少卿诗藁喜自其曾孙传写","author":"韩淲","text":"分明山隐是诗家，零落残编久易赊。\n忽见子孙能缮录，敢言人士得谁誇。\n衣冠祖业多流品，文雅儒风有等差。\n细读一篇寻一句，馀芳宁不擅词华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周子静示诗卷 其一","author":"韩淲","text":"湖山风雨烟霏处，莲叶翻翻百顷宽。\n我已尘埃无可写，谁将诗卷对之看。\n蓬莱地近初抟翮，阊阖门开更整冠。\n此段情怀久寥阔，沉吟犹为洗悲酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周子静示诗卷 其二","author":"韩淲","text":"陆羽泉头忻考德，林逋湖面得敦诗。\n交情未觉非前日，雅道那知又一时。\n逼塞古今空上下，凄凉人物易推移。\n申言保社吾何敢，但惜中含屈宋姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵推官诗卷昌甫数称许之","author":"韩淲","text":"句句芳华字字香，章泉巨擘意深长。\n为渠力挽抉云汉，与众争光扫秕糠。\n每以成章能脍炙，孰于行卷敢权量。\n南池自是风流地，波撼水村荷气凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题桥南书院图卷","author":"韩淲","text":"几年来往柯山下，合到桥南书院中。\n邂逅立谈知地胜，从容抵掌见诗穷。\n心情信自一廛足，眼力从他万马空。\n煮茗烧香了吾事，试听滩濑落秋鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨秘监江东集","author":"韩淲","text":"江东集里好清诗，未看争知看便知。\n句句多般都有格，篇篇出众不趋时。\n包藏许大冰霜骨，搭带些儿锦绣皮。\n却被铁钱赶归去，诚斋老子也便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题昌甫所得陆待制手书次韵昌甫之题句","author":"韩淲","text":"放翁遗墨几何年，云绕秋山月满川。\n摸索空惊久零落，追思犹恨少留连。\n贞元人事诚如梦，正始文风信若仙。\n江海凄凉易陈迹，山阴茅宇贺家船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题鱼计编后","author":"韩淲","text":"积水閒题鱼计名，一亭元自野而清。\n几年来往疑无谓，举世行藏定不惊。\n郑圃赋留南渡久，瓢泉曲到老来平。\n诗编多少临渊兴，徒得旁观句眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昔先公欲刊白蘋集今教授刊之","author":"韩淲","text":"吴兴好在白蘋洲，先友云亡不那愁。\n空对遗编想容止，休论往事记从游。\n吾翁甚欲流传远，贱子常疑埋没休。\n赢得虚名付残断，风流终古藉西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"来子仪监庙见假诗藁","author":"韩淲","text":"伏波老气肯消除，磊块撑肠万卷书。\n愤世疾邪吟讽里，伤心思古笑谈馀。\n一轩漫占琳宫静，四壁空悬客舍虚。\n隐隐龙光射牛斗，东湖烟浪绕吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从王仲可求近诗","author":"韩淲","text":"推门喜见王摩诘，种树栽花兴寄中。\n一旦青衫遽如许，几年黄卷亦书功。\n人间文物惊无有，天与诗名定不同。\n乞取成编山里去，坐堆残叶读清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"永嘉林氏集云庵索诗","author":"韩淲","text":"太半交清曾著句，独馀师道更铭碑。\n海山磅礴知何处，人物联翩信一时。\n以似诗书端可尚，允怀今古不堪悲。\n百年所种皆先德，宰木云庵过者思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艳歌行","author":"韩淲","text":"翠幕朱帘苏小家，浓熏兰麝竞奢华。\n繁弦度曲柱争雁，媚脸持杯眉拂鸦。\n锦帐春馀情未极，宝钗分处梦无涯。\n红楼何在香尘合，恨不都将命乞花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫寄近诗一卷","author":"韩淲","text":"诗情閒雅笔舒明，吟到平时字亦成。\n老不厌山怀玉秀，静宜流水章泉声。\n殷勤题寄情何过，展转看来眼自惊。\n一任人间无此作，近闻巩至得同盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗逢","author":"韩淲","text":"诗逢恶境无一字，酒为可人须百杯。\n醉眼却愁天地窄，颓龄肯受岁华催。\n秋生远树吹红叶，雨过空庭满绿苔。\n饮罢从教黄鹄举，吟边宜看白鸥来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉成叟书来索诗","author":"韩淲","text":"赣上书来寄近诗，经行已得蔡邕碑。\n老年文力能如此，壮日交游定可知。\n贾马以前须有作，应刘而下复推谁。\n冰霜满眼梅开未，想见翛然句益奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江湖集钱塘刊近人诗","author":"韩淲","text":"才华未若一杯酒，行业尚贪千首诗。\n今贵几何名得志，古贫最底谓知时。\n雕残沈谢陶居首，披剥韦陈杜不卑。\n谁把中兴后收拾，自应江左久参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄子功示近诗一卷因思昔年湖上同林德久访铦朴翁之适石城明月雁声中刘武子诗也子功诗有和武子句","author":"韩淲","text":"西湖南畔访诗僧，小艇浮游酒屡倾。\n犹是三人同眷眷，岂知一别各营营。\n有怀旧约空如梦，忽见新编复畅情。\n依约小山酬唱处，石城明月雁声清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伯皋丈届七十寄诗庆之","author":"韩淲","text":"老来谁不惜光阴，世态消磨鹤发深。\n化道喜经蘧瑗岁，遇文应动太公心。\n极思吟啸知如旧，且愿丰登得似今。\n闻道田园足强健，云山深处好书琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶登科八人所识者四","author":"韩淲","text":"乡邦为作四贤诗，所识还知盛一时。\n高质静专还朴厚，熙心坚正却平夷。\n新尤胆略无回曲，适且才华不诡时。\n他日要当为国器，喜看虎榜大名垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫生日","author":"韩淲","text":"南枝今已十分开，天寿高人玉雪梅。\n不问冰霜惊岁晚，要看风月唤春来。\n镇常兄弟游山杖，间或交亲奉酒杯。\n忽到窗前花更好，暗香吹梦竹轩苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵十将入山避生日","author":"韩淲","text":"已御祥琴又一年，忍因初度醉宾筵。\n为君煮饼邀朋旧，容我寻诗话古先。\n信义自应如皎日，功名谁不上凌烟。\n宗盟祖业非他比，长夏相期玉水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"看士人应举","author":"韩淲","text":"六年不到秋场屋，懒散低回强自宽。\n本谓有缘居上第，可令无分作粗官。\n小来勇往痴心在，老去羞将冷眼看。\n笑杀杜陵纨裤句，只知多误是儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访耿运干不值","author":"韩淲","text":"束结新楼挟带湖，月台凌厉雪晴初。\n主人不见望犹美，客子空归兴亦舒。\n支径草黄飞野鸟，露洲莎绿下舂锄。\n梅梢过腊花争发，城里分明物外居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十一日治园成季过","author":"韩淲","text":"满地霜风吹晓色，荒寒犹有菊枝香。\n不知篱外舆篮入，正尔亭前扫叶忙。\n急取绳床坐夫密，旋寻酒盏引而长。\n老怀老眼老谁语，閒处閒人閒自伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫约过施仲益","author":"韩淲","text":"章泉常为诵清诗，今日山行又见之。\n新辟轩窗知雅玩，更拈书帖发佳思。\n杯深旨酒留连夜，炉拨寒灰领略时。\n信道人间好甥舅，不妨酷似有襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巩仲至到浙江急往见之继而以诗来乞次韵","author":"韩淲","text":"相从我自慰无聊，物换星回又斗杓。\n近市少霜梅欲动，长沟无雨水全消。\n几年冠盖东南会，逐日舟帆上下潮。\n见说公来便寻觅，老怀何更得诗邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过常山魏寺丞","author":"韩淲","text":"潇洒薰风佚老堂，溪山围绕水云乡。\n高怀不与凡情杂，胜槩全无时世忙。\n须信贞元朝士在，应怜元祐故家荒。\n馀生来往奉谈麈，商略吟边饮最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯夕颇盛郡中相招不能往也","author":"韩淲","text":"满城歌舞事元宵，溪外苍山雪乍销。\n红日渐迟花信动，银蟾初上烛光摇。\n幽人自笑居空谷，游子从教往丽谯。\n一盏青灯对编简，旧欢如梦壮心凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过傅骥院竹间","author":"韩淲","text":"竹深留客南山下，只许幽閒话晚凉。\n酒尽更须拚酩酊，诗来犹可共徜徉。\n无端薄俗从它转，有底浮华不自忙。\n意气如君天地在，床头书大且韬藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欲过履道庵不果因以诗送饼饵","author":"韩淲","text":"乘晴欲过雨岩去，草木空疏霜后寒。\n老苦疮疡行又止，閒将饼饵问平安。\n夜炉挟册应三复，晓径舂禾可一餐。\n蕙帐藜床同梦寐，试回头作去年看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十九日过耿运干","author":"韩淲","text":"春风池馆水溶溶，杏浅梅深柳意浓。\n拄杖横皋穿麦垄，倾壶中沚见云峰。\n有来好事能同适，尽把閒吟不自供。\n莫道涧湖相去远，要惊心赏每难逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄耿运干","author":"韩淲","text":"霍庙湖深浙水边，雪村来往定翛然。\n薰风六月上塘路，得雨九秋东坝田。\n酒政应缘因禄仕，诗家拔俗在吟篇。\n翩翩银笔经年别，岩壑风流想后先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送耿运干当湖酒所","author":"韩淲","text":"一自西风散芰荷，殷勤风雪更婆娑。\n经年谁谓酒边少，此日我云林下多。\n才俊荣亲当折桂，时清禄仕且嘉禾。\n论交论契无馀语，收入离筵入短歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻孟使君到子颜隐庐次韵余安叔所赋","author":"韩淲","text":"祝家山映一荒途，霜满晴空树色虚。\n太守去寻高士宅，比邻只道野人居。\n朱轮不碍檐前橘，白屋惟堆案上书。\n想见猿惊鹤飞走，袁安卧雪画堪如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王寺簿过山园","author":"韩淲","text":"小园才放一枝梅，便有传呼别驾来。\n领略风光归草木，经行野路踏莓苔。\n人间襟韵须吟笔，花底风流入酒杯。\n公亦暂时相赏识，诏回天上肯重陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫约诸人茶山病不能往次韵其所赋","author":"韩淲","text":"幽人何许不怀贤，忍把清诗与世传。\n可惜吕曾祠宇地，独留香火寺僧缘。\n入林去踏山头月，裹茗来烹井底泉。\n病著偶辜城北约，尚吟馀意得同焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中上巳宋六成甫见过留饮","author":"韩淲","text":"风光流转景常新，且乐林泉自在身。\n曲水流觞知上巳，落花啼鸟近残春。\n快倾座上一壶酒，莫染人间半点尘。\n兀兀篮舆好归去，路平微雨草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山徐子融茅斋留饮次其韵","author":"韩淲","text":"茅山从此占西湖，须信高人德不孤。\n临水未能忘汝颍，爱山还肯羡匡庐。\n眼前孤劲竹尊者，世上浮名松大夫。\n浩气已充真乐地，宁论实相与虚无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹一留饮次其韵","author":"韩淲","text":"冬来何意酒杯宽，旧话新愁转转难。\n落叶满城吹薄暮，浮波夹岸起清寒。\n方斋留客情无已，上郭归人兴若阑。\n天地之间是襟谊，淋浪赢得洗悲酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曾广漕见过","author":"韩淲","text":"舟车亦过水村来，猿鸟无惊自不猜。\n化雨江西贵先觉，宣风广右属行台。\n诗书发冢人千里，桃李成蹊酒一杯。\n雪岸舣蓬春动处，寻诗野老亦清哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲至至日相过","author":"韩淲","text":"微官谁复肯来过，名胜凋零已不多。\n忍为故人疏酒盏，漫将佳节付诗歌。\n闲情只道山林好，老态其如岁月何。\n静夜小楼相对久，盈编新语但摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谭南恩见过","author":"韩淲","text":"正在山前看木犀，儿童惊报故人来。\n急扶藜杖过桥去，喜见朱轓作牧回。\n岭外山川多瘴疠，江南朝市有尘埃。\n经行又泥冰溪水，且折清香荐一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斯远入吴就春官试因相过偶成","author":"韩淲","text":"春风閒日小楼居，门外欢迎长者车。\n道旧祇如前日事，别来不觉近年馀。\n烟花帝里宜同醉，杖屦湖山可自如。\n趁取好怀寻好句，人生何必爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫携渭南诗见过","author":"韩淲","text":"长笛残星赵倚楼，吟边供断一生愁。\n渭南作尉诚微宦，江上逢人忆远游。\n风景不因今古异，琴樽宁与是非休。\n章泉传到涧泉上，凉意满天河影秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张以道见过","author":"韩淲","text":"霜檐明日晓晴天，忽有骚人到眼边。\n煮饼漫留寻旧话，烹茶还得写新篇。\n旅怀但且官天地，世道全凭酒圣贤。\n回首山鸣钟暮起，水浮桥外耿墟烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十二月初九日雪尹子潜来","author":"韩淲","text":"九峰庵上雪中眠，夜半寒枝落枕前。\n虚旷益知身老大，静深惟觉梦清圆。\n山围漠漠无通路，田缺幽幽有暗泉。\n雅志能来得同榻，雨岩人必为吟传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弋阳徐宰见过","author":"韩淲","text":"幽深终日冷清清，谁肯乘春过水行。\n杂踏轩车虽达宦，从容杯酒信豪英。\n静看声利身何绊，閒惜芳华意转倾。\n相对弦歌有馀咏，苦遭风雨也宜晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵馀干宰允中","author":"韩淲","text":"梦寐湖山同雅集，溪篷还送宰馀干。\n苍忙写句求诗律，邂逅持醪得笑欢。\n花事纤浓春又过，麦天清淡雨初乾。\n琵琶洲畔弦歌地，一上乘风眼更宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潘德久置酒柳洲小楼","author":"韩淲","text":"几年九日西湖酒，此际从公把菊花。\n酬唱不知留客舍，登临无奈得诗家。\n水舟又掠空潭浪，山屐经行两岸沙。\n白发清尊乃如许，数株杨柳傍楼斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初六日民瞻古梅下留饮","author":"韩淲","text":"眼到梅花便有诗，园居支径入疏篱。\n崔嵬自与人高古，烂熳谁知我笑嬉。\n烟湿远荒吟不尽，雨收幽隐醉为宜。\n新年陡觉新愁少，坐对南枝更北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过杨解元看古梅","author":"韩淲","text":"春风晴日草玄家，城北坡陀一径斜。\n远以云山供境界，静惟书籍是生涯。\n敲门忽有醉吟客，隔屋初无桃李花。\n夭矫龙蛇饶古意，孤芳真足对年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亨中送梨枣","author":"韩淲","text":"年年梨枣寄西风，近喜豅岩一笑同。\n坐石弄筇泉汩没，望云搜句月朦胧。\n经时话著犹疑画，尽日来思又若空。\n珍重交情两相望，鹿门深处见庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后昌甫将归章泉斯远诸兄偕来留饮因咏林逋诗约同赋 其一","author":"韩淲","text":"风烟溪嘴转山腰，起觉清寒坐拥貂。\n林薄晓光吹蔌蔌，水流暮色下潇潇。\n相期胜士来推户，更想归人远度桥。\n会取试寻诗句写，还鸣高树许由瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后昌甫将归章泉斯远诸兄偕来留饮因咏林逋诗约同赋 其二","author":"韩淲","text":"年来閒得傲山林，肯怪连天雪作阴。\n苏武不眠身自健，袁安高卧兴何深。\n懒穿东郭先生履，细和西湖处士吟。\n无限目前今古意，岁华如许老骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后昌甫将归章泉斯远诸兄偕来留饮因咏林逋诗约同赋 其三","author":"韩淲","text":"竹边松外最清新，烟敛风回净辟尘。\n江阔远分垂钓叟，山空时过采樵人。\n摩挲望眼寻幽径，抖擞闲身访近邻。\n三白会须能一饱，茗盂聊且寄吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗谢文显兄弟载酒并简子畅二首 其一","author":"韩淲","text":"几椽牢落依僧住，二妙慇勤载酒来。\n名节似君真有道，交游著我定怜才。\n谭高屡激清风起，归近何嫌落日催。\n苦忆平生溧阳尉，驱车政尔犯黄埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗谢文显兄弟载酒并简子畅二首 其二","author":"韩淲","text":"柱杖敲门借竹看，步随纾曲转林端。\n架边绿蔓阴成幄，桥下清流春有湍。\n君作屋庐嫌近俗，我因岩谷遂深盘。\n傥思出郭少尘事，或命巾车初不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]