[{"title":"次韵朱新仲白菊三绝句 其二","author":"刘才邵","text":"练帨云衣天上装，月中光透只闻香。\n世间百宝难相称，珠露荧荧映靓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱新仲白菊三绝句 其三","author":"刘才邵","text":"苦节寒心独异常，尽枯终欲护幽香。\n纷纷花蕊那知此，已落犹誇半面妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日牡丹五绝句 其一","author":"刘才邵","text":"百花头上有江梅，更向江梅头上开。\n便使诗人惭未识，春前还解上楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日牡丹五绝句 其二","author":"刘才邵","text":"天公用意太勤勤，时遣花王为报春。\n从此梅花应有语，漏他消息莫冤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日牡丹五绝句 其三","author":"刘才邵","text":"谁谓冰霜惨刻辰，暗中和气自生春。\n花神显现东君意，说似何劳解语人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日牡丹五绝句 其四","author":"刘才邵","text":"聊将芳醑发微殷，岂是冰肌不耐寒。\n对立亭亭真妙绝，可将近侍乏雌丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日牡丹五绝句 其五","author":"刘才邵","text":"芳丛不遣雪霜封，已是青腰独见容。\n更祝春风重著意，行看拂槛露华浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德源道人水墨画二绝句 其一","author":"刘才邵","text":"脩竹寒禽伴写真，细看更觉妙通神。\n早知终有飘摇患，应选深林寄此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德源道人水墨画二绝句 其二","author":"刘才邵","text":"霜枯荷叶半攲斜，水落寒溪蹙浪花。\n雁足更须添系帛，似传远信度龙沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鉴上人通内外学遍游访方晚栖旧隐年来示疾遂不出山牡丹四窠见寄因成三绝句以谢 其一","author":"刘才邵","text":"闻说栽时正出家，春风四纪阅芳华。\n如今示疾空山里，怕引诸天来散花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鉴上人通内外学遍游访方晚栖旧隐年来示疾遂不出山牡丹四窠见寄因成三绝句以谢 其二","author":"刘才邵","text":"远寄灵根自梵家，小园景物顿增华。\n何当写在屏帏上，一任高禅笑眼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鉴上人通内外学遍游访方晚栖旧隐年来示疾遂不出山牡丹四窠见寄因成三绝句以谢 其三","author":"刘才邵","text":"学道何妨只在家，谩栽花草记年华。\n个中本自无荣悴，浮世何曾似落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠段成之","author":"刘才邵","text":"粟庵宴坐正安禅，不踏城闉已十年。\n送别今朝不辞远，信知高义薄云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄芍药","author":"刘才邵","text":"游沛曾闻汉帝魂，梦中名实未应分。\n看花莫动枝头蝶，惊觉徐州老使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玛瑙数珠偈","author":"刘才邵","text":"一切有为法，幻相有去来。\n如来真实义，无去亦无住。\n我原宝珠光，遍照大千界。\n随光所照处，见者悉成佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"默斋偈","author":"刘才邵","text":"稽首金刚狮子座，紫金光聚妙色身。\n微尘刹土转法轮，演出无边殊胜义。\n燃灯如来昔授记，初无一法可得者。\n云何种种方便门，多劫宣扬不能尽。\n观音妙力不思议，元从耳门得昧。\n烁迦罗首八万馀，随处说法度众生。\n云何现身蛤蜊中，不假语言法亦显。\n当知是法本无法，语默两涂俱解脱。\n二乘知见妄分别，偏执所见自缠缚。\n解缚不离缚处解，还从语默證圆湛。\n良哉居士具通眼，一切不随根境转。\n了知诸法不可碍，刹那真入三摩地。\n我愿初没这见闻者，悉悟真常成正觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"刘才邵","text":"见说木天犹突兀，暂时金地亦清闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"丁浚明","text":"从前谑浪今收拾，尽听人呼张大王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陇口作","author":"郭浩","text":"陇口山深草木荒，行人到此断肝肠。\n耳中不忍听鹦鹉，犹在枝头说上皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音院德云堂","author":"胡松年","text":"小舟乘风飞鸟过，万顷云涛纵掀簸。\n此行要是快平生，无数青山笑迎我。\n山根隐约见人家，槿篱茅屋埋烟霞。\n宛似秦人种桃处，川原远近纷香葩。\n杖藜径踏华山去，试问莲开今何许。\n路迷绝壑荫松筠，身到半山听鱼鼓。\n道人为我开云堂，是中境界浑清凉。\n幽磬时和野鸟语，飞泉暗泻岩花香。\n文书照眼本吾事，雁鹜著行败人意。\n造物似怜厌世嚣，挈置湖山烦一洗。\n何人夜呼隐去来，向来得丧真山崖。\n金庭玉柱永不改，人间劫火空飞灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顾亭林","author":"胡松年","text":"海山荡佳气，千载传古居。\n平生读书地，竹柏静以疏。\n忠义贯白日，名不埋幽墟。\n苗裔今几何，谁能补其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞庭","author":"胡松年","text":"白蘋风静碧波沉，画舸来游着意深。\n愿觅灵文窥秘钥，更追遗范写良金。\n姓名便合联真隐，出处何妨拟醉吟。\n畴昔光阴费行乐，中原鼙鼓正伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"赵思诚","text":"抗章恳避公槐位，卜筑千岩紫翠间。\n园锁幽深似仙境，堂开华丽远尘寰。\n貂冠虎骑荣新宠，云阁琼台许暂闲。\n帷幄谋谟待元老，未容高蹈占东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"赵思诚","text":"经济奇谋有祖风，渭川卜猎旧非熊。\n风云遇会千龄运，社稷扶倾万世功。\n偃息郊园酬雅志，咨询庙算简清衷。\n更须整顿乾坤了，绿野归来效晋公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其一","author":"释道闲","text":"全机敌胜，犹在半途。\n啐啄同时，白云万里。\n才生朕兆，已落二三。\n不露锋铓，成何道理。\n诬人之罪，以罪加之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其二","author":"释道闲","text":"荡荡无迂曲，明明透古今。\n晓云笼碧岫，残叶落疏林。\n脱体全收放，当堂定浅深。\n饶君亲荐得，未是我智音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释道闲","text":"雪压怪松露，风高野渡横。\n将谓众生苦，更有苦众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其二","author":"释善悟","text":"祖师远远没东土，面壁少林坐九年。\n二祖传心亲得髓，算来早是已轮先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其三","author":"释善悟","text":"宝剑连飞急，透顶便通神。\n有时轻按处，惊动五湖宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其四","author":"释善悟","text":"寻思去此地，清凉离烦暑。\n暮雨朝云乐太平，青山绿水人难睹。\n不难睹，深林有个白额虫，元来却是玄沙虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其五","author":"释善悟","text":"老清源，没缝罅。\n问佛法，酬米价。\n衲僧一粒若沾唇，拄杖横担绕天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其六","author":"释善悟","text":"马祖才升堂，百丈便卷席。\n春风一阵来，满地花狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其七","author":"释善悟","text":"一口吸尽西江水，岭上桃华香扑鼻。\n枝枝叶叶尽含春，也是因我得礼你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其八","author":"释善悟","text":"台山路坦平，婆子苦商量。\n赵州勘破了，清风满大唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古九首 其九","author":"释善悟","text":"因我得礼你，牵牛去饮水。\n岸上蹄踏蹄，水中觜对觜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得仙亭","author":"程瑀","text":"危亭谁结据山椒，名第仙人不可招。\n绕郭溪山敞图画，万家楼阁插云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拜程刚悯公墓","author":"程瑀","text":"早从宾客傅青扉，晚举丝纶对紫微。\n忠愤欲先同列死，尘沙惊绕属车飞。\n墓间挂剑心犹在，帐下谈经事已非。\n太学诸生皆白发，汪汪老泪湿征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留隐轩","author":"程瑀","text":"先生肮脏与谁同，直道何妨竟不容。\n欲约故人酬素志，苦求晚节隐青松。\n图开胜地诗篇重，客倦僧房野兴浓。\n问舍求田端有日，从他百尺卧元龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青峰山壮图轩","author":"程瑀","text":"溪流汹涌激溪垠，土木颓移岁月新。\n为问寺前圆也未，不应久负壮图人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"程瑀","text":"七年三破桃花浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忠节庙","author":"刘岑","text":"皇天祐宋生虎臣，奋身櫜鞬起西秦。\n勇义智略卫霍伦，西平云亡愬复兴。\n疾首匈奴敢凭陵，恨不一举空朔廷。\n鸣剑抵掌志幽并，提兵北趋指神京。\n遇虏大点符离城，绛衣铁冠目怒瞑。\n虏众辟易屡窜奔，飞矢洞胁陨其身。\n帝心震悼诏廷绅，一旦失此飞将军。\n作宫庙食妥其灵，生为人雄死明神。\n虽殁不愧远与巡，气冲斗牛叩穹旻。\n臣魄尚能厉女真。\n镇山之南勒坚珉，百世祀兮慰忠魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贞女祠","author":"刘岑","text":"贞女已云远，芳名闻至今。\n烟波濑江上，松柏古祠深。\n暮色留残照，悲风动远林。\n谪仙文不死，读罢为沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题宝相寺","author":"陈尧臣","text":"白云楼殿翠林开，终日轩窗四面山。\n却愧劳生多事客，清凉分得片时闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠妙靖鍊师","author":"柯庭坚","text":"绝粒栖神知几年，闭关终日更翛然。\n高风默与麻姑契，妙法亲从婴女传。\n功行素超三界外，姓名清彻九重天。\n凭谁与问西王母，师是金华第几仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游莺脰湖","author":"吴亿","text":"树色烟光两岸分，棹歌声里散鸥群。\n船浮春水天疑近，人对春风酒易醺。\n翠袖不须花下舞，洞箫还待月中闻。\n仙游钓客今何在，湖上年年自白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"磨崖中兴颂","author":"吴亿","text":"借问江头人钓鱼，为言灵武事何如。\n磨崖岂是当时意，两字噫嘻金镜书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读邈上人翠微集","author":"郑亿年","text":"几年祠馆乐安闲，诗笔无闻老思悭。\n谩把清篇遮病眼，每逢妙语解愁颜。\n定知道行超尘外，不使才名落世间。\n从此丛林推绝唱，未应后学便相班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和孙大夫赠开江沈察判","author":"郑亿年","text":"缔构拥苍岑，空林一径深。\n岚蒸四壁润，云锁半窗阴。\n都寂世尘影，但清天籁音。\n若教支遁买，应倍沃洲金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送知县赵通直 其一","author":"郑亿年","text":"仁政三年有始终，阳关声彻去匆匆。\n森严治已冰霜比，慈爱临民父母同。\n解印远瞻京阙路，挂帆高飐楚天风。\n不须更问昆山事，已有歌谣达帝聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送知县赵通直 其二","author":"郑亿年","text":"大门治邑岁年深，诒厥孙谋又到今。\n遗爱联绵民结恋，归途迢递柳垂阴。\n九茎芝草曾呈瑞，并蒂荷花已赏心。\n或会朝廷求政绩，何妨袖出野人吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"郑亿年","text":"人逢岁稔家馀粟，地近岭南冬不冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金泉步虚台","author":"郑庭芳","text":"平生酷信退之诗，谢女仙踪颇自疑。\n不到步虚台下看，琼台瑶佩有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"郑庭芳","text":"洗笔池头烟淡淡，鸣琴台畔水悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日","author":"赵?之","text":"拂床攲枕昼初长，好梦惊回燕语忙。\n深竹有花人不见，直应风转得幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题父墓亭","author":"林若渊","text":"虎踞龙蟠经几春，靖康孤节照苍旻。\n至今凛凛有生气，愧死当年膜拜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"赵彦政","text":"所历登临尽，愁新屈子居。\n青脩一嶂远，红蓼几花疏。\n直节乾坤外，骚文雅颂馀。\n殷勤酹江月，生气凛如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中访友不遇","author":"赵师固","text":"久思成德士，家居山裹山。\n云深何惮远，路险不知难。\n幽鸟藏林语，残花点石斑。\n行踪无觅处，惆怅自空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门岩","author":"赵师立","text":"胜境传天下，曾封第七山。\n一岩悬石际，万木插云间。\n鸟过暮天碧，牛眠冬日闲。\n歌声初隐隐，疑自武陵还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"秦观女","text":"眼前虽有还乡路，马上曾无放我情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"贾如讷","text":"洞房人不见，相望摘杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苕溪","author":"贾安宅","text":"广苕山下有源深，发此清流去不浑。\n直抵太湖三百里，滔滔分入海天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题山谷寺","author":"陆宰","text":"芙蓉已入双林寂，山谷今传佛祖衣。\n千里客来何所遇，夜堂人静雨霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别东阳","author":"陆宰","text":"前身疑是此山僧，猿鹤相逢亦有情。\n珍重岭头风与月，百年常记老夫名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"陆宰","text":"岁月悠悠悲往事，川原冉冉梦重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗二首 其一","author":"薛弼","text":"济南从古多名士，崛起皋夔蓟北空。\n君喜有堂堪逸老，上嫌无职可酬功。\n苍生日愿起安石，绿野今难留晋公。\n盛烈屡勤铭鼎鼐，龙韬犹冀感云风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗二首 其二","author":"薛弼","text":"卜筑追寻九老游，江南最好是丹丘。\n乞将金鼎调元手，暂向磻溪理钓舟。\n东阁蚤延天下隽，画堂春锁海中洲。\n他年共看车书一，举目山河笑楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"薛弼","text":"南县富角盐，沿田劳少休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庞祐甫卜居白蘋洲走笔寄感","author":"何铸","text":"君爱白蘋洲，携家面碧流。\n皇程惟百里，宦迹只扁舟。\n过尽江淮地，何如宛洛游。\n行宫催种柳，禾黍满神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凫山庙","author":"李宏","text":"凫山高与苍旻训示，根盘八里雄坤维。\n油然出云为风雨，泽周一境无凶饥。\n重楼复殿据山腹，蜿蜒攫护神□□。\n威灵如在骇闻听，至今父老能言之。\n断碑刓缺尚可读，湮埋岁久人无知。\n高高一峰独秀出，上有蝉蜕真仙居。\n似闻尝任石埭尹，化流德洽真民师。\n持竿戏投白龙饵，隐雾深韬玄豹姿。\n手披蕊笈校丹篆，足蹑飞升腾紫微。\n相逢邂逅一笑粲，真将莫逆论心期。\n从兹来往因无间，遗踪所至犹可推。\n弦歌标乡里犹在，望仙纪地名独垂。\n栖真发寄伟曾税驾，绝顶尚留丹灶基。\n近邻眢井数盈九，石甃坚深端可窥。\n神既庙食还旧隐，仙亦偶坐应祷祈。\n合堂荐享异肴蔌，乞灵修敬倾里闾。\n政和天子谨祠祭，郡县有请咸勿违。\n一朝飞章达旒扆，往往一夜曾躬披。\n俞音载锡降芝简，庞贲徽名昭典彝。\n神兮仙兮服君赐，福庇斯民无已时。\n仙将出游神速往，霓旌绛节相追随。\n神既来归仙至止，衮衣羽帔瞻光仪。\n繄予顶谒亦云屡，淋漓醉墨聊一挥。\n词虽芜颣事摭实，庶几传信祛群疑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]