[{"title":"长安道中","author":"潘阆","text":"游子辞乡早，高堂亲已老。\n燕来不东飞，寄书何日到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金山寺留题","author":"潘阆","text":"金山碧崔嵬，我泛扁舟来。\n虚阁登还下，长廊去复回。\n梵刹绝顶立，僧房八面开。\n波涛起蛟蜃，洞穴生风雷。\n千载有高松，万古无纤埃。\n葛衣惹秋云，草履黏苍苔。\n孤城寒角动，片帆暮钟催。\n朗吟成此章，欲返犹徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日旅舍感怀","author":"潘阆","text":"秋色入檐楹，閒门开复扃。\n愁长欲长醉，薄酒又还醒。\n揽照头将白，逢谁眼暂青。\n只应南与北，唯此念飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王长洲禹称赴阙","author":"潘阆","text":"蒿兰不并香，泾渭安同流。\n小人有千险，君子生百忧。\n名重圣主徵，道光史策收。\n一鹗秋空飞，鸟雀徒啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙学士两浙转运使兼简杭州知府张侍郎","author":"潘阆","text":"晓帆叠叠飞，夜橹连连鸣。\n贪吏诫守廉，饥民苏念生。\n岸花有异态，沙鸟无娇声。\n钱塘太守贤，好共致升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙学士两浙转运使兼简杭州知府张侍郎","author":"潘阆","text":"吴山挂魂碧，浙江入梦清。\n旦暮东南望，徒使华发生。\n君今运邦计，不得同舟行。\n即听江仓丰，伫见汴廪盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送崇教大师惠思归山","author":"潘阆","text":"受知圣眷与谁同，师号封题寄梵宫。\n为谢国恩来阙下，又承天泽去山中。\n禅馀静对江亭月，吟苦凉生海树风。\n若到赤城逢羽客，但言孤鹤在金笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓泊嶀浦寄剡县刘贶员外","author":"潘阆","text":"晓汎剡溪水，晚见剡溪山。\n徘徊驻行棹，待月思再还。\n渔唱深潭上，鸟栖高树间。\n应当金石交，念我无暂閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人回文五首 其四","author":"苏轼","text":"前堂画烛夜凝泪，半夜清香荔惹衾。\n烟锁竹枝寒宿鸟，水沉天色霁横参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人回文五首 其五","author":"苏轼","text":"蛾翠敛时闻燕语，泪珠弹处见鸿归。\n多情妾似风花乱，薄倖郎如露草晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜腊雪","author":"潘阆","text":"久旱腊月如夏热，夜来忽降一尺雪。\n叫谢上天声应彻，且压瘴气不作孽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游龙虎山赠天师 其一","author":"潘阆","text":"远挹高风自汉迁，老松犹带昔年青。\n留侯高卧衣冠冷，鼻祖重来印剑灵。\n鹤和猿吟清彻底，龙蟠虎踞翠为屏。\n真人一笑梅花发，三十六天春不扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游当涂","author":"潘阆","text":"扁舟不复见袁宏，故垒犹连谢尚城。\n骑鲸仙子千年恨，化石佳人万古情。\n牛渚矶前浪如屋，区区名利与生轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题思归鸟","author":"潘阆","text":"高枝枝上鸟，终日叫思归。\n如斯羽翼全，何不望乡飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠冯德之道士","author":"潘阆","text":"上清消息久不闻，紫鸾丹凤应离群。\n羲和纵辔日又曛，九衢旦暮徒纷纷。\n谁识天书数行字，识者便是真仙子。\n直言铅汞成还丹，炼之饵之身不死。\n嵩阳道士早来别，才承天泽辞玉阙。\n紫章深秘莫漏泄，他年华顶为君说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠道士王介","author":"潘阆","text":"头冠星斗光，七十鬓不苍。\n箧有化金方，诗无入俗章。\n举步云霞轻，出语芝术香。\n约我游罗浮，绝顶天风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扫市舞","author":"潘阆","text":"出砒霜，价钱可。\n赢得拨灰兼弄火。\n畅杀我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆馀杭十首 其一","author":"潘阆","text":"长忆钱塘，不是人寰是天上，万家掩映翠微间。\n处处水潺潺。\n异花四季当窗放，出入分明在屏障。\n别来隋柳几经秋，何日得重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆馀杭十首 其十","author":"潘阆","text":"长忆观潮，满郭人争江上望，来疑沧海尽成空。\n万面鼓声中。\n弄涛儿向涛头立，手把红旗旗不湿。\n别来几向梦中看，梦觉尚心寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆馀杭十首 其六","author":"潘阆","text":"长忆西山，灵隐寺前三竺后，冷泉亭上旧曾游。\n三伏似清秋。\n白猿时见攀高树，长啸一声何处去。\n别来几向画阑看，终是欠峰峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送淡公二首 其一","author":"苏轼","text":"燕本冰雪骨，越淡莲花风。\n五言双宝刀，联响高飞鸿。\n翰苑钱舍人，诗韵铿雷公。\n识本不识淡，仰咏嗟无穷。\n清韵生物表，朗玉倾壶中。\n常于冷竹坐，相语道意冲。\n嵩洛兴不薄，稽江事难同。\n明日若不来，我作黄石翁。\n何以兀其心，为君学虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆馀杭十首 其五","author":"潘阆","text":"长忆孤山，山在湖心如黛簇，僧房四面向湖开。\n轻棹去还来。\n芰荷香喷连云阁，阁上清声檐下铎。\n别来尘土污人衣，空役梦魂飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆馀杭十首 其七","author":"潘阆","text":"长忆高峰，峰上塔高尘世外，昔年独上最高层。\n月出见觚棱。\n举头咫尺疑天汉，星斗分明在身畔。\n别来无翼可飞腾，何日得重登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆馀杭十首 其九","author":"潘阆","text":"长忆龙山，日月宫中谁得到，宫中旦暮听潮声。\n台殿竹风清。\n门前岁岁生灵草，人采食之多不老。\n别来已白数茎头，早晚却重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆馀杭十首 其八","author":"潘阆","text":"长忆吴山，山上森森吴相庙，庙前江水怒为涛。\n千古恨犹高。\n寒鸦日暮鸣还聚，时有阴云笼殿宇。\n别来有负谒灵祠，遥奠酒盈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘阆","text":"滁上相逢俱禁烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘阆","text":"何须三叫绝，已恨一声多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘阆","text":"到底不能成一曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘阆","text":"归来遍检登科记，未见连年放弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘阆","text":"土床安睡稳，纸被转身鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘阆","text":"散拽禅师来鞠蹴，乱拖游女上秋千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金山","author":"潘景良","text":"嵌岩穹窿，屹立乎江中。\n崩湍下瞰不见底，巨石崛出高摩空。\n混沌破来到今几万岁，雄奇秀丽胡为乎此山兮独钟。\n长江西来一万里，当空削出金芙蓉。\n上有金仙居，下有冯夷宫。\n宝坊栉比列霄汉，塔影倒置惊鱼龙。\n有时洪钟咽烟响，潮音属和驱群聋。\n鸟飞竟力不得到，我尝拿舟一抵其云峰。\n摄衣步楼阁，矫首观无穷。\n齐州九点落眼底，岷峨西望沧溟濛。\n忽闻长风破巨浪，芥蒂一洗平生胸。\n山僧喜殊常，握手何从容。\n杯擎陆羽水，茶汎玉川风。\n鹤庵散仙，恒斋老翁，把臂大笑声融融。\n天风吹袂欲轻举，白云缥缈将何从。\n不知海外之三山，群仙之乐与此将异而或同。\n迄今别去五六载，我舟又复来掀篷。\n山灵偃蹇我倨傲，尘怀汩没不得追前踪。\n风帆一笑金山过，山头日落飞冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香岩院","author":"潘景夔","text":"晚入招提路，山风冷透裳。\n寒鸦互分合，霜稻半青黄。\n习讼伤浇俗，思闲慰故乡。\n牧童如有感，扣角唱斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金鳌山如画轩 其四","author":"潘朝英","text":"倦客登临力已疲，高僧故索小窗诗。\n江山最好君知否，春去秋来烟雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金鳌山如画轩 其三","author":"潘朝英","text":"乱壑收云接涨澜，一天风露夜漫漫。\n金鳌不动涵坤轴，海月腾空万宇寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金鳌山如画轩 其二","author":"潘朝英","text":"春潮暮落海门山，百艇齐飞牡蛎滩。\n分得鱼虾归野市，满江鸥鹭夕阳閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金鳌山如画轩 其一","author":"潘朝英","text":"古木摇阴绿插空，梵宫寂寞草髼松。\n可怜昔日掀天事，曾对君王跨六龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏钓台 其一","author":"潘畤","text":"不到危台久，重来恰十年。\n壮怀今扫尽，遗象只依然。\n老我从疏拙，微官合弃捐。\n归来营钓艇，长此卧风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏钓台 其二","author":"潘畤","text":"古屋颠岩上，荒祠落叶中。\n乞灵无俗驾，垂世有高风。\n鸟语谷相答，鱼游溪若空。\n徘徊欲忘去，船背夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"休洗红","author":"潘葛民","text":"休洗红，洗多红色浅。\n不似妾挼蓝，挼蓝手先染。\n蓝深如妾心，郎心红不禁。\n去去趁春华，封侯早还家。\n愿作兔丝蔓，莫学菖蒲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝴蝶花","author":"潘葛民","text":"风光白日长，蝴蝶飞过墙。\n飞飞不停去何忙，墙外谁家菜花黄。\n出门不知南陌路，心随蝴蝶寻郎处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禁林宴会之什","author":"潘慎修","text":"红药深严肃广筵，嘉招仍许厕群仙。\n忽窥宸翰云龙动，乍揭天辞日月悬。\n散作楷模争宝惜，永刊金石共流传。\n况当枚马从容地，仍集班扬侍从贤。\n敢窃休明为盛观，愿陈风咏播薰弦。\n不辞胜引承欢醉，长洽升平亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘慎修","text":"如今纵得仙翁术，也怯君王四路饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月十八日之桐川","author":"潘献可","text":"白鸟苍烟外，黄鹂绿树间。\n雨晴初有路，云薄不藏山。\n村酒成孤酌，征鞍厌独攀。\n日长人自倦，更觉马蹄悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至庄舍","author":"潘献可","text":"鹭立汀沙晚，牛眠径草深。\n黄花浮荇带，红叶下枫林。\n客路溪中断，柴门水半侵。\n一廛收岁晚，聊复此幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"固城怀归","author":"潘献可","text":"税驾蚕将老，旋车燕欲归。\n人情秋思薄，酒力晚风微。\n青鬓愁边改，丹心老去违。\n吾庐元不远，望断白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚三客同出郊归途甚醉","author":"潘献可","text":"寻友逢三益，追欢且一时。\n买鱼呼野艇，沽酒认村旗。\n暂觉行歌乐，何妨醉舞僛。\n牧儿休骇愕，横笛且须吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓舍偶题","author":"潘献可","text":"习懒身无用，幽偏性所欣。\n校书随马队，临帖爱鹅群。\n公子悲春草，佳人隔暮云。\n北山归计决，未信有移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居","author":"吴潜","text":"竹院秋逾静，柴门昼不开。\n病先携老去，懒渐逐衰来。\n莫遣新缘结，都将旧念灰。\n川鱼与云鸟，从此莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子","author":"潘熊飞","text":"十日后重阳。\n甘菊阶前满意黄。\n生日无钱留贺客，何妨。\n尚有儿曹理寿觞。\n双鬓已沧浪。\n休问金门与玉堂。\n二仲相期三径在，徜徉。\n何用功成似子房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题忠悯公送婿邢得昭归婺女诗后","author":"潘霆孙","text":"胡谪亦由广帅，李还不出郴阳。\n相慨冰清在纸，至今遗墨犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其七","author":"潜放","text":"吉文江口到临川，半是康衢半是船。\n泛绿依红春正好，鱼轩来往綵衣边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其六","author":"潜放","text":"记得迎承过葛川，稚金未肃嫩凉天。\n当时若径趋金阙，安得庐陵有此缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其三","author":"潜放","text":"笑著斑襕学乳儿，民情物意总相宜。\n嬉嬉同在春风里，父样尊严母样慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其五","author":"潜放","text":"只把双珠学道功，可占椿算与萱同。\n平反阴德知多少，尽在慈祥岂弟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其二","author":"潜放","text":"见说团栾醉寿觥，椒盘长近岁峥嵘。\n今年腊里欣逢闰，直待春回却举行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其八","author":"潜放","text":"君王宣室正兴思，尺一催归四辈驰。\n寿宴明年当此日，蟠桃宣劝在瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其一","author":"潜放","text":"盛事于今苏老泉，郡侯端的是坡仙。\n棣华咫尺龙颜近，竞诧皆出孟母贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆江检详太夫人 其四","author":"潜放","text":"谁谓庐陵是富州，反成穷匮省支收。\n寿筵只作家常办，不学豪奢逞异羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"手中乌啄食","author":"潜说友","text":"灵乌浑觉不相猜，啄食翩翩手上来。\n自笑老躯顽似石，被渠认作出生台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其二","author":"潜说友","text":"句落孤山压老林，横枝解识燮调心。\n众贤戛击宗韶頀，外域流传洗靺任。\n不有鹿矶功许大，那能兔苑乐如今。\n非才久愧班东上，抱瓮何当学汉阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贾魏公冬大雪诗 其二","author":"潜说友","text":"云气峥嵘众俊林，圣朝事事合天心。\n梅根依傍蒙嘉泽，竹力低垂愧重任。\n有美江山祗如旧，无尘宇宙幸逢今。\n坐令清昼閒铃索，白战工夫效汝阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贾魏公冬大雪诗 其一","author":"潜说友","text":"海水飞花到上林，气形和处总由心。\n采薇指日休兵甲，宿麦连云办辇任。\n炽炭酒行怀往昔，老枝诗句诏来今。\n燮调妙用谁知得，端在崇阳与抑阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其一","author":"潜说友","text":"突兀琼楼照武林，淋漓黄榜快群心。\n成功共说平淮度，经世谁如钓海任。\n后乐园应看最好，娄丰年又数从今。\n太平君子方宵旰，想读豳风到凌阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潮州士人","text":"潮民遗爱处，八十里长堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投蒲寿宬 其一","author":"潮州书生","text":"梅花落地点苍苔，天意商量要入梅。\n蛱蝶不知春去也，双双飞过粉墙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投蒲寿宬 其二","author":"潮州书生","text":"剑戟纷纷扶主日，山林寂寞闭门时。\n水声禽语皆时事，莫道山翁总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狱中寄酒友","author":"颜几","text":"龟不灵兮祸有胎，刀从林甫笑中来。\n忧惶囚系二十日，辜负醺酣三百杯。\n病鹤虽甘低羽翼，罪龙尤欲望风雷。\n诸豪俱是知心友，谁遣尊罍向北开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"颜几","text":"白日尊中短，青山枕上高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿冯北部","author":"颜太初","text":"五百年终遘圣朝，相门何日降英髦。\n星杓影射金枢正，月魄光浮碧汉高。\n三世密传张颢印，贰车新得吕虔刀。\n他年善继良弓慕，金字重重有赐袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]