[{"title":"和刘端礼 其二","author":"王庭圭","text":"白面书生铁作肝，风雨未动剑长闲。\n何时去斩匈奴首，直取西凉尽处山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘端礼 其三","author":"王庭圭","text":"才如天马岂能羁，争看云霓笔下飞。\n龌龊不须谈细务，健毫留对冕旒挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"国材侄送林檎","author":"王庭圭","text":"嫩红轻拂女儿脸，浅绿深堆玛瑙盘。\n草木若能成好字，来年早寄一枝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠清首座","author":"王庭圭","text":"上堂何事更论量，还我珠来本自光。\n未识飞猿岭头峻，两回掀倒夹山床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和裴主簿桃花","author":"王庭圭","text":"近水浅桃不忍看，似临清镜惜红颜。\n骑驴主簿吟诗瘦，应秃千毫笔管斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兰寄知县陈邦直","author":"王庭圭","text":"昨夜西风茁紫芽，不应独著野人家。\n安仁未倦栽桃李，添此清香一种花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答邦直二首 其一","author":"王庭圭","text":"惠爱如兰正吐芽，芳风吹落几千家。\n明年催直金銮殿，龙口飘香看百花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答邦直二首 其二","author":"王庭圭","text":"系出拾遗扬马后，清词丽句复名家。\n岂惟草木遭题品，大笔行当判五花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"美胡烈臣晚年生子","author":"王庭圭","text":"老蚌生珠喜可涯，穷阎得宝亦堪誇。\n如今七岁诵千字，他日端能读五车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和彭养正陈令尹","author":"王庭圭","text":"气压秋园百草芽，风流宜在令君家。\n但倾绿蚁伴清客，莫羡黄金刻藓花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘元弼见招","author":"王庭圭","text":"玉壶沽酒挈青丝，及取春风花发时。\n便把一樽留客醉，莫教红雨洗残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠相士","author":"王庭圭","text":"富贵本非吾辈事，老来宁复问穷通。\n馀龄几许君知否，愿作升平一老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问讯王道之病","author":"王庭圭","text":"居士病从何处起，我今往问与谁俱。\n室中三万二千座，更许卢溪下语无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠宜春笔工","author":"王庭圭","text":"宜城一变宣城样，入手便如锥画沙。\n但喜中书头未秃，不妨诗老梦生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步芳园","author":"王庭圭","text":"密栽桃李碍车轮，柳下风微不动尘。\n已办寻春蜡双屐，飞花满地草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖头观桃李四绝句 其一","author":"王庭圭","text":"路转烟村万木春，村深疑有避秦人。\n山农出谷惊相问，不信边头有战尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖头观桃李四绝句 其二","author":"王庭圭","text":"朝骑一马暮还归，尽日花间觅句迟。\n黄四娘家谁敢道，古来惟有少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖头观桃李四绝句 其三","author":"王庭圭","text":"城里池台俗俭穷，却来城外探东风。\n曲栏幽槛趣不远，春在郊原浩荡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖头观桃李四绝句 其四","author":"王庭圭","text":"春入千林烟雨中，桃花李花能白红。\n一时草木披锦绣，十里吹香坠晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茉莉花三绝句 其一","author":"王庭圭","text":"纤云捲尽日西流，人在瑶池宴未休。\n王母欲归香满路，晓风吹下玉搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茉莉花三绝句 其二","author":"王庭圭","text":"火云烧野叶声乾，历眼谁知玉蕊寒。\n疑是群仙来下降，夜深时听佩珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茉莉花三绝句 其三","author":"王庭圭","text":"逆鼻清香小不分，冰肌一洗瘴江昏。\n岭头未负春消息，恐是梅花欲返魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘美中尚书","author":"王庭圭","text":"公方持橐我休官，握手平生出肺肝。\n岂是尚书先著履，须知处士不弹冠。\n文章进直金銮殿，槽枥空馀宝马鞍。\n忍看铭旌下螺浦，再携斗酒饯江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽彭子从郎中","author":"王庭圭","text":"岭北岭南持使节，湖西兼总大农钱。\n庙堂正赖持国计，蓬岛祗为蜕骨仙。\n郎省尚虚丹禁地，铭旌忽上洞庭船。\n衣冠不许挂神武，端谓犹堪济巨川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王自然二首 其一","author":"王庭圭","text":"耆旧风流绝后尘，尚容晚岁接冠巾。\n英豪取友半天下，论议常倾一座人。\n横槊阵前工草檄，结庐江上老垂纶。\n只今遗像髯如棘，犹足堂堂耸缙绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王自然二首 其二","author":"王庭圭","text":"衣冠南渡塞螺川，始识蓬莱王自然。\n舌捲风雷翻海岳，学穷精祲出人天。\n归来元亮荒三径，老去扬雄有一廛。\n斗酒只鸡思欲致，无因下马拜新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王夫人","author":"王庭圭","text":"忆昔诸郎从板舆，当时人物渡江初。\n蓬莱阙外双飞鹤，葬会漳南数郡车。\n魄已成仙归阆苑，儿方着足上云衢。\n紫微即日趋严召，八座无因问起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽卢宜人二首 其一","author":"王庭圭","text":"崔卢唐旧族，谱系自名门。\n子舍三珠树，思刘七耳孙。\n是行将贵显，不及问平反。\n坐脱无凡语，人传有至言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽卢宜人二首 其二","author":"王庭圭","text":"高风林下闺门里，几岁长斋绣佛前。\n夫子雄才尹天邑，清魂独乐上蓬仙。\n化为双鹤何方客，来置束刍南郡贤。\n会致送车填广陌，他时彤史亦须编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽黄忠臣二首 其一","author":"王庭圭","text":"忆昔相逢子少年，诗书从我日磨研。\n平生极力欲推挽，世事惊人忽变迁。\n未辩嘘枯送天上，忍收遗骨葬江边。\n双亲白发终身恨，不见青衫落眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽黄忠臣二首 其二","author":"王庭圭","text":"书报登科墨未乾，已闻吊客在门阑。\n只传金榜升华省，不得丹梯上广寒。\n赋就两番随计吏，花开一日遍长安。\n谁知鬼录南宫籍，却作修文地下官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽戴彦成通判","author":"王庭圭","text":"早岁同充上国宾，与君先占广寒春。\n青云尚记当时事，黄土今埋如此人。\n别驾朱幡泥饰屏，萦纡茜绶带铜银。\n生前富贵无馀恨，痛念堂遗白发亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘公弼","author":"王庭圭","text":"弟兄词赋喧场屋，晚岁乡闾誉益哗。\n窗下残编雕草木，壁间遗翰走龙蛇。\n蜡馀几緉游山屐，书满千篇载鹿车。\n痛惜蒲轮迎未果，寝门来哭泪横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王修华","author":"王庭圭","text":"督赋宁居中上科，治身从此得名多。\n不闻老父踰垣走，且听儿童载道歌。\n吏不捉人真快乐，庭无留事足中和。\n邦民尽作婴儿泣，忍送輀车返烂柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘英臣","author":"王庭圭","text":"累世以赀雄里闾，惟公挟策似寒儒。\n欲将那律九经库，定胜江陵千木奴。\n玉树诸郎新命贵，锦囊丹诰宠光殊。\n当时籍甚吴丞相，恩泽今归两凤雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽徐子平 其一","author":"王庭圭","text":"数椽破屋临溪水，日日读书喧四邻。\n白首传经穷到骨，清风入座静无尘。\n堆窗史传千张纸，过隙光阴一转轮。\n富贵掀天亦埃灭，今时何必叹斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽徐子平 其二","author":"王庭圭","text":"季子过徐因挂剑，吾诗似剑敢欺徐。\n才华本自轻场屋，诂训犹堪授里闾。\n踏雪打门人问字，载殽从学酒盈车。\n儿童诵得平生赋，不是兔园遗下书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽罗荆老","author":"王庭圭","text":"初挟儒书战举场，弟兄旗鼓亦相当。\n探囊聊复起人死，系肘空馀济世方。\n汉苑旧尝知姓字，壶天今别有仙乡。\n老龙犹抱玉函诀，夜扣柴门乞酒浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽郑教授","author":"王庭圭","text":"仰高虽未接华裾，清论时容著野夫。\n挂剑未能临死穴，隔江何处奠生刍。\n凄凉陶令松三径，寂寞扬雄宅一区。\n插架尚馀三万轴，传家宜有凤凰雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽曾氏安人","author":"王庭圭","text":"令仪早出闺中秀，少日来归丞相家。\n能以功名勉夫子，忍看旌旐起悲笳。\n锦囊篆字金装出，玉佩鸣裾帔有霞。\n赠典有加儿亦贵，诰黄新墨字如鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽范孺人","author":"王庭圭","text":"少日来归奉藻蘋，一门冠盖拥朱轮。\n平生未识德公嫂，比岁才依孟母邻。\n魂返蓬莱三万里，鹤归华表几千春。\n南州高士应匍匐，忍看灵车下北津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽瞿氏","author":"王庭圭","text":"徒身诸福寿尤丰，魄返仙曹第几宫。\n西土梦星生太白，东床选婿得梁鸿。\n岂无名士当时论，自有夫人林下风。\n来吊不知何处客，化为双鹤却飞空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽易氏","author":"王庭圭","text":"媪有才子邻我居，父老欲起高门闾。\n此媪不知家有无，但典髻鬟供买书。\n今朝恸哭城南道，忍送丧车入秋草。\n预愁来岁寒食时，不见襄阳德公嫂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘子仪","author":"王庭圭","text":"鬼伯歌朝露，归魂掩夜泉。\n起家诗礼盛，折桂弟兄贤。\n箭落双雕日，君当化鹤年。\n阿鸿今已贵，飞去欲摩天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽欧阳仁叟","author":"王庭圭","text":"郡从簪缨贵，驺僮意气华。\n呼卢晋公子，大侠鲁朱家。\n锦臂誇豪放，银鞍走狭斜。\n忍寻桃径里，无主亦开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽张氏安人","author":"王庭圭","text":"母子未相识，哀号彻九穹。\n一生何敢望，万里忽相逢。\n綵服旧儿戏，锦囊新诰封。\n悲歌满行路，千载想遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽欧阳宜人","author":"王庭圭","text":"渤海家声赫，先朝御史孙。\n霞冠宜象服，腰笏拥鱼轩。\n五福寿尤贵，两儿名更喧。\n惟嗟汉阳远，不及问平反。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王氏夫人","author":"王庭圭","text":"岁歉倾禾粟，宾来剪发鬟。\n其人今已朽，此事古尤难。\n斜日衔峰顶，秋风想佩环。\n出门惊吊客，双鹤下云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王氏孺人","author":"王庭圭","text":"赐爵逢千载，皇恩下九关。\n诰词金篆字，珩佩玉连环。\n陶母今有后，莱衣不复斑。\n哀歌堪挽绋，徒有泪潸潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽郭氏孺人","author":"王庭圭","text":"择对真佳婿，传家好弟兄。\n魂飞瑶海岸，风断玉箫声。\n举案人何在，埋文谁作铭。\n潘郎今未老，他日看褒荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽聂氏孺人","author":"王庭圭","text":"陇上庞公女，相家裴十娘。\n空门参白足，佳婿得黄香。\n木马风前响，莲花火里芳。\n弥陀真乐土，环佩响锵锵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽露氏恭人","author":"王庭圭","text":"华胄东京旧，青楼大道边。\n渡江离险阻，举族得安全。\n追赏荣身后，褒封及眼前。\n清魂在蓬岛，彷佛缀群仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽丁陶明县尉","author":"王庭圭","text":"东南作尉本神仙，化鹤家声亦宛然。\n临欲骑鱼归海岛，犹能跃马拓弓弦。\n花间载酒经旬日，陌上悲歌隔九泉。\n尚有读书台下月，夜深还照碧池边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘宗望","author":"王庭圭","text":"何年来卧北山霞，犹指海边团练家。\n手把方书妙耕种，门高闾巷独清华。\n两儿驹齿日千里，万卷牙签架五车。\n风动松篁起萧瑟，不堪回首听悲笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧泷庙迎神诗","author":"王庭圭","text":"泷神何年此列宫，神之来兮雨溟濛。\n雷公击鼓驱群龙，神之灵兮与天通。\n十日五日一雨风，物无疵疠年谷丰。\n泷民事神甚严恭，牲羞荐酒罗鼓钟。\n湍虽汹涌长年工，不闻船石相撞舂。\n孰知此者神之功，宜歌此曲传无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乾龙节致语口号","author":"王庭圭","text":"红日初生碧海边，蓬莱金殿起晴烟。\n几重瑞气笼双阙，万室欢声动九天。\n百二山河扶宝祚，两阶干羽舞文砖。\n遥闻葱岭新都护，愿举霞觞祝万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天申节致语","author":"王庭圭","text":"乐事初从天上传，慈宁宫在曰华边。\n庆逢诞节张钧乐，奏举遐方锡御筵。\n满殿薰风旗彩动，一墀鸣玉佩声喧。\n遥闻仪凤随韶奏，报道君王寿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阅军致语口号","author":"王庭圭","text":"秀岭东边今日晴，千兵绕出阵云平。\n长枪大剑遮行路，后虎前貔拥使旌。\n看拓弓弦声霹雳，愿回甲马扫欃枪。\n山农野叟何曾识，来听秋风鼓角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高峰禅寺修殿疏偈","author":"王庭圭","text":"绀殿倾颓几十秋，佛应不语阿难愁。\n诸方檀越宜兴念，共出把茅来盖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"迁善斋铭","author":"王庭圭","text":"击石出火，鼓钟得声。\n不鼓不击，寂无声形。\n人之有善，物中最灵。\n揉以学问，其识乃明。\n跛鳖千里，六骥不行。\n玉不加琢，器何由成。\n吾观成叔，挺挺有立。\n学有渊源，家声赫熠。\n深山大泽，龙蛇蟠蛰。\n实无所迁，假迁而入。\n犹天之升，不落阶级。\n参辰殊途，追莫能及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠端琴铭","author":"王庭圭","text":"大江之西，卢水之阴。\n有三昧手，斲无量音。\n震动法窟，是为老端之琴。\n盖尝求师于海中，登蓬莱阆风之岑，听海水林木之萧森。\n采枯桐以寄其妙绝，信哉点瓦砾而成金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琴铭","author":"王庭圭","text":"桐生高冈，斧出月窟。\n斲而成器，神藏鬼没。\n此一物也，与宝剑相携于卢溪之上，三者皆天下之英物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠门寺钟铭","author":"王庭圭","text":"万动俱寂，如大虚空。\n虚空无椎，何物为钟。\n傍震万壑，高闻九穹。\n声缘何起，吾知所从。\n钟邪椎耶，莫尸其功。\n隐如雷霆，在大千中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝珠寺钟铭","author":"王庭圭","text":"蠢然冥顽孰与觉，空中雷电忽磅礴。\n大音希声本无作，回禄奋怒飞廉恶。\n一鼓成钟神所托，剑蟠蛟螭怒牙角。\n六种震动天雨雹，铸此铭诗呵不若。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仁山五百罗汉赞","author":"王庭圭","text":"迦叶天中五百尊，目连罗睺皆骏奔。\n阿难啼哭佛日昏，谁为设法沙林园。\n帝释拥护六凿根，习气脱尽婆罗门。\n仁山金碧耀人天，瞻礼愿见前世缘。\n法螺一吹天上闻，还报十方罗汉恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圆通赞","author":"王庭圭","text":"太山秋毫两微尘，巨细本无不二门。\n四方八面开户牖，是中元有不动尊。\n如大圆镜万象入，如大海水百谷奔。\n维摩倒用那罗印，用證初心岂或沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洪觉范画赞","author":"王庭圭","text":"谓公为佛，乃工文章。\n谓公为儒，乃是和尚。\n非佛非儒，是虚空藏。\n画虽逼真，实非真相。\n作如是见，亦未离妄。\n水在瓶中，月在天上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李伯时画像赞","author":"王庭圭","text":"非佛非仙，亦非儒者。\n硉硉矹矹，名满天下。\n孰貌其真，非真非假。\n读东坡诗，乃识此画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欧阳公制赞","author":"王庭圭","text":"如马放逸兮不羁，如松磥砢兮多节。\n伟干如谢康乐之眉须，雄辩如楼君卿之唇舌。\n其高处可以上可以下，其妙处不可画不可说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]