[{"title":"邕州 其三","author":"陶弼","text":"汉节护诸蛮，徘徊瘴疠间。\n少希铜马式，老厌玉门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邕州","author":"陶弼","text":"南极诸蛮傲典刑，斗门时复见飞星。\n君王仁恕将军老，五十溪州六万丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄石康县曹元道","author":"陶弼","text":"屡与南僧谈瘴溪，独推君县好封圻。\n不同合浦人民众，虽接交州寇盗稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄苏州徐处士弁","author":"陶弼","text":"平南无策鬓如霜，七十峰前隐旧乡。\n相约祝融孤顶上，借君吟笔画潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄钦州洪迩侍禁","author":"陶弼","text":"僧怜海石为棋子，客惧蛮螺作酒杯。\n自笑平生喜韬略，此时何计上金台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄郁林郡守姚道源","author":"陶弼","text":"越裳济海喜天晴，五叶戈船不度兵。\n尧舜远方皆乐国，汉唐诸将本书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄桃源管明菩","author":"陶弼","text":"野鹤孤云无定踪，桃花流水合相容。\n夜来月满群山阁，知在秦人第几峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄梧守","author":"陶弼","text":"川流八桂末，地势九疑馀。\n不惮勤酬唱，江通丙穴鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊","author":"陶弼","text":"九月严霜杀草根，独开黄菊伴金樽。\n东篱故事何重叠，醉倒花前是远孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登桂州永宁阁","author":"陶弼","text":"五代浮屠阁，危层不易攀。\n晓光诸寺塔，晴露别州山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登邕州城","author":"陶弼","text":"夜半孤城百尺台，乱虫声里一樽开。\n忧边日绕南云下，恋阙心随北斗回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登潮月亭","author":"陶弼","text":"渡头人语知潮上，下看南江东北流。\n试引轻帆学归去，茶山溪浅却回舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫薇花","author":"陶弼","text":"人言清禁紫薇郎，草诏紫薇花影旁。\n山木不知官况别，也随红白上东廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滴露花","author":"陶弼","text":"九天瑞露滴成芽，不是榆花即桂花。\n星女月娥宫不锁，天风吹落野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端研诗赠王欲","author":"陶弼","text":"端石如池状，润疑云雨通。\n粗官不识字，好去伴诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题净因寺","author":"陶弼","text":"歌吹深秋节，香灯古佛园。\n细泉初落石，远岫正当门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题武溪龙书庙壁","author":"陶弼","text":"路到龙栖处，阴森觉有灵。\n山腰过云黑，石眼出泉腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题献花铺","author":"陶弼","text":"德裕南迁瘴海涯，路逢山女献山花。\n平泉公子伤春处，唯有东风吹草芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"融州仙岩","author":"陶弼","text":"溪僧过此说山公，游遍真仙洞府中。\n乳石岩边得灵草，可能封裹寄衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡州三首 其三","author":"陶弼","text":"兜率一峰旁，林开见宝幢。\n鸟行高避县，山骨下连江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡州三首 其一","author":"陶弼","text":"七十峰前敞县扉，湘云湘树满郊圻。\n衡阳春暖雁飞过，兜率雨昏龙战稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠章使君","author":"陶弼","text":"善战无如新息侯，汉兵才度绿萝州。\n爱君挽我陶溪粟，直到牂牁水口头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入桂林","author":"陶弼","text":"满耳洋洋分岭泉，早秋时候晚凉天。\n稻花斑白初经雨，竹色青苍薄带烟。\n安得孤臣能虑患，不劳明主更忧边。\n东坡故老知谁在，望我车尘若望仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"那霸泉 其二","author":"陶弼","text":"路下牂牁水石閒，三分才过二分山。\n年光欲尽家犹远，岚气虽疏鬓已斑。\n宾从谈笑机独进，儿曹音信喜生还。\n南风一夜吹乡梦，数刻飞过五岭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山亭","author":"陶弼","text":"三山亭下水悠悠，山耸潮平地欲浮。\n草木秀多穷海角，栋梁高处压鳌头。\n莫辞樽俎金船夜，曾驻旌旗玉帐秋。\n好景眼前题不尽，恍然神鬼在瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三公亭落成","author":"陶弼","text":"北原乔木外，三将旧屯营。\n草没金锤迹，山应玉管声。\n路随关地迥，江背瘴天轻。\n异日谁相继，来书第四名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三海岩","author":"陶弼","text":"灵邑西南古洞天，我来方信海为田。\n无名不入州图载，有路空闻野老传。\n此日登山人采蚌，当时饮马客留钱。\n颜公昔记麻姑说，三变柔桑事果然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中湖","author":"陶弼","text":"宁越佳山水，中湖赏称心。\n环流随郡堑，倒影动禅林。\n夏簟一般冷，春瓶相对深。\n使君少仁智，赖得会高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五溪","author":"陶弼","text":"六月五溪边，溪深气象偏。\n昼阴疑雨后，久冷觉秋先。\n栈倚临崖石，竿通隔岭泉。\n片帆云里现，知是贡賨船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公安县","author":"陶弼","text":"门沿大堤入，路趁浅莎行。\n树短云根拔，山穷地势倾。\n孤舟难泊岸，远水欲沈城。\n半夜求津济，烟中荻火明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天涯亭","author":"陶弼","text":"雨色丝丝风色娇，天涯亭上觉魂消。\n一家生意付秋瘴，万里归心随暮潮。\n兵送远人还海界，吏申迁客入津桥。\n山公对此聊酣饮，怕见醒来两鬓凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木芙蓉","author":"陶弼","text":"孤芳托寒木，一晓一翻新。\n春色不为主，天香难动人。\n丹枫见流落，黄菊坐因循。\n莫讶偏相爱，衰迟似我身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖","author":"陶弼","text":"宁越佳山水，东湖带郡城。\n月天高寺影，春雨一桥声。\n石上青蒲合，沙中白鸟横。\n天涯正寥落，独往若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出岭题石灰铺","author":"陶弼","text":"马度严关口，生归喜复嗟。\n天文离卷舌，人影背含沙。\n江势一两曲，梅梢三四花。\n登高休问路，云下是吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北湖","author":"陶弼","text":"宁越佳山水，城楼枕北湖。\n丘陵助形势，沟洫借膏腴。\n晚景群峰会，春流众壑趋。\n自知千载后，歌调有农夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永平寨道中","author":"陶弼","text":"叠帐深千里，穷途令一隅。\n北风家信息，南斗客程途。\n岭势频开合，猿声乍有无。\n过溪人语笑，隔岸戍烟孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙州秀岭","author":"陶弼","text":"路随云磴石梯行，限隔华夷天意明。\n自与大君为外屏，何劳诸将作长城。\n福民可拜三公爵，寿圣能呼万岁声。\n海国未疆崖石老，待谁来此勒功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再过阳朔寄人","author":"陶弼","text":"昔日儒衫今武车，重来耆老尚奔趋。\n后人相继皆清德，小吏回看半白须。\n条教谩为新楷法，官资犹作旧称呼。\n里门不闭田畴辟，好买丹青别画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖","author":"陶弼","text":"宁越佳山水，西湖似浙城。\n桂多天竺子，潮欠海门声。\n路向林梢转，天随野色横。\n从兹栖泊者，无复渡江情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过龙平","author":"陶弼","text":"数家深峡里，灯火似渔村。\n客梦稀星外，虫声短草根。\n发疏怜枕软，意倦觉灯昏。\n待晓酤蛮酒，苍梧奠舜魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"高荷","text":"亲祠堂主鸾曾驻，善梦先生蝶不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过思明","author":"陶弼","text":"几年来瘴外，此夜宿溪中。\n照枕残鸡月，吹灯落叶风。\n卢循犹伪国，杨仆已衰翁。\n起戴寒星去，前村烧影红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过清湘","author":"陶弼","text":"岭开蛮壤断，此地下湘川。\n绿水文如染，丹枫色欲然。\n瘴消还爱酒，我醉尚忧边。\n故里谁相访，孤帆出晓烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"那霸泉 其一","author":"陶弼","text":"昔年观地志，此水出牂牁。\n断岸深无底，平流暗起波。\n感恩来客少，射影短狐多。\n未老诸蛮在，楼船空再过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阳朔县","author":"陶弼","text":"五管新多事，轻车屡往还。\n勤劳成白发，故旧是青山。\n树色才分楚，江声未出蛮。\n自惭迎候少，无惠及孤鳏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟石","author":"陶弼","text":"守边无一事，江上得閒吟。\n醉呓歌微出，狂书墨不深。\n潮痕没高岸，月色透疏林。\n此意无人解，宵分泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芙蓉亭","author":"陶弼","text":"边柝无声狱讼疏，芙蓉池上避金乌。\n民收果实充田赋，匠写空形入画图。\n白鸟知机远冠盖，紫鳞贪饵落盘盂。\n主人非为清香护，爱此烟波似五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辰州","author":"陶弼","text":"诏条符节古连今，王泽渐濡岂不深。\n赋役未行中国法，讴歌犹带远人音。\n采金户簇青莎岸，射虎兵围黄叶林。\n寄语湖南滩上客，预将忠信待浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辰州","author":"陶弼","text":"东海旧场屋，南江新塞垣。\n玺书行绝域，铜柱入中原。\n草暖闻鸣鹿，江清对饮猿。\n何时一樽酒，重上谢公轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡头","author":"陶弼","text":"三伏池塘沸，鸡头美可烹。\n香囊连锦破，玉指剥珠明。\n叶皱非莲盖，根甘似竹萌。\n不应徒适口，炎帝亦曾名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宜阳","author":"陶弼","text":"孤城溪洞里，闻说已堪哀。\n蛮水如鲜血，瘴天已死灰。\n吏忧民置毒，巫幸鬼为灾。\n风土如斯恶，吾来胡为哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拦蛮山","author":"陶弼","text":"西去万重山，兹峰独限蛮。\n天生贼多计，民赖汝为关。\n设险数州地，防危一日间。\n守边须以道，绝顶可跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直钓亭","author":"陶弼","text":"半载持竿野水东，山翁心不类渔翁。\n何须巧饵悬钩上，会使奸鳞落鼎中。\n西伯道高来吕望，文宗才短失卢仝。\n纵人能取鳞中意，南海波澜一夜空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗秀山","author":"陶弼","text":"寻山入罗秀，旋结草堂居。\n花露生瓶水，松风落架书。\n闻猿得句后，见月出行初。\n此夕云林下，无因梦使车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓石","author":"陶弼","text":"守边无一事，坐石钓东桥。\n水色连山叠，泥痕上海潮。\n饵经沙日暖，纶动水风飘。\n客正思新绘，鳅鲸气莫骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南宁昆崙关","author":"陶弼","text":"关路下昆崙，蛮封迤逦分。\n春光偏著草，雨意不离云。\n俗异君修德，时平将用文。\n临溪照绿水，老鬓雪纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南湖","author":"陶弼","text":"宁越佳山水，南湖水浅清。\n暗泉通古庙，凉气入军城。\n有禁鱼常乐，无机鸟不惊。\n远蕃?舶至，海角暮潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南湖亭","author":"陶弼","text":"山城春昼橘花开，祓禊相将上古台。\n一片晚云含落照，数分残酒伴新梅。\n谈高绮席终无况，诗落金笺谩有才。\n多谢南亭湖与月，醉中相送画船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春野亭","author":"陶弼","text":"二纪看花瘴雾中，野园今日又东风。\n人心有感时时别，春色无私处处同。\n长笛一声诸曲尽，巨觥双饮百愁空。\n风清水暖群鱼上，谁向荆溪占钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳","author":"陶弼","text":"杨子江头流水凘，长安陌上暖风吹。\n黄金璎珞雪晴后，碧玉珑璁春尽时。\n端的园林俱不及，等閒台榭便相宜。\n思量也是多情物，占与人间赠别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日登南城台","author":"陶弼","text":"江国家书少，秋台寒草生。\n无人来远渡，尽日上高城。\n落照悬渔市，孤烟起戍营。\n东篱故园菊，又向酒中倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶溪亭","author":"陶弼","text":"茶溪亭上绿沿回，溪上孤城照水开。\n谁趁落潮离晚渡，自寻芳草上春台。\n年华有限忙中去，人事无涯暗里来。\n安得病躯开病眼，碧云瞻拱帝星回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕涛典狱之梧州","author":"陶弼","text":"峡口苍梧县，城依南斗魁。\n江浑海潮上，地热火山来。\n草没嘉鱼穴，云封拜表台。\n到应无狱讼，豆蔻酒频开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送临桂令戴若纳出岭","author":"陶弼","text":"五岭生还少，无辞酒满觞。\n共经边寇事，先出瘴烟乡。\n楚树蝉声早，湖天日影凉。\n此行休问路，宫阙斗杓旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵枢寺丞宰虔化县","author":"陶弼","text":"路入虔云去，如何轻解携。\n人烟五岭北，星斗大江西。\n暖雪梅花树，晴雷赣石溪。\n青衫欲无泪，不奈鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阁皂","author":"陶弼","text":"万仞天然皂阁形，阴阳不似众山青。\n一区海上神仙宅，数曲人间水墨屏。\n华表鹤归春谷响，玉京龙起夜潭腥。\n可怜张葛无人继，三级高坛拂杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"容管","author":"陶弼","text":"一年勾漏守，寻尽洞中天。\n佛记卢藏用，仙坛葛稚川。\n醒心西驿水，烧眼碧池莲。\n我岂无新事，诗碑与酒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂风亭","author":"陶弼","text":"新亭序立郡城楼，樽酒登楼未免愁。\n家住斗星天北野，路随潮水海南头。\n古忧蛟蜃今思济，众说鱼虾不直钩。\n民俗不知官况薄，上书重把寇君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄沅州新守谢麟","author":"陶弼","text":"险尽天开溪路平，诗书新将典新城。\n三千戍卒今无几，十万屯田古未耕。\n属县乞除防虎槛，生蛮愿献采砂坑。\n从兹预拟风尘息，尽是仁威下旆旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望海岭","author":"陶弼","text":"望海楼高目力宽，海潮来处是天根。\n日边市舶程途远，水外亭台景象昏。\n巨鳄出时防患害，大雕当北各飞翻。\n将军有意还铜柱，俯看南溟气欲吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野香亭","author":"陶弼","text":"野香亭下新开萼，半是夭桃半是梅。\n旧说武陵源上去，今疑大庾岭边来。\n人闲亭上醒还醉，夭暖墙头落又开。\n宾客笑谈民鼓舞，不知何者号春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄陵庙","author":"陶弼","text":"溪上龙蛇屋，萧条帝子祠。\n竹痕当日泪，山色后人疑。\n仙服霞留绮，新装月印眉。\n楚民亡水旱，箫鼓谢神禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游龙洞访僧不遇留诗","author":"陶弼","text":"一锡游何处，岩端静掩扃。\n独寻危石坐，闲把细泉听。\n野鼠缘斋钵，山花落静瓶。\n斜阳过溪去，回首乱峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]