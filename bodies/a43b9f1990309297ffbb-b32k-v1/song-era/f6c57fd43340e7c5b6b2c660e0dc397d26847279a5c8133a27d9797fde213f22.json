[{"title":"二花","author":"薛绍彭","text":"鲜鲜中园菊，粲粲篱东畔。\n的的秋水莲，袅袅西风岸。\n迢迢白衣人，皓皓涉江腕。\n重阳尊酒亲，雾夕容光烂。\n物生各有宜，不计年华晏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马伏波事","author":"薛绍彭","text":"人生在衣食，但取饱与温。\n下泽驾款段，曾不羡华轩。\n仕为郡掾吏，身自守丘园。\n乡里称善人，此外不足论。\n志大心自劳，福厚祸有根。\n提兵泊浪间，薏苡谗谤喧。\n飞鸢跕跕堕，卧视瘴水昏。\n永怀平生时，空愧少游音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云顶山","author":"薛绍彭","text":"山压众峰首，寺占紫云顶。\n西游金泉来，登山缓归轸。\n昨暮下三峡，出谷已延颈。\n山名高剑外，回首陋前岭。\n跻攀困难到，赖此昼亦永。\n巍巍石城出，步步松径引。\n青霄屋万楹，下俯二川境。\n玉垒连金雁，西轩列阡畛。\n青城与岷峨，天际暮云隐。\n少城白烟里，水墨澹微影。\n江流一练带，不复辨渔艇。\n东惭梓隘阙，右喜锦川迥。\n磐陀石不转，枯蘖弄芒颖。\n四更月未出，蕙帐天风紧。\n客行弊帤垢，到此凡虑屏。\n暂时方外游，聊惬素心静。\n明朝武江路，拘窘逐炎景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"左绵山中多青松风俗贱之止供樵爨之用郡斋僧刹不见一本余过而太息辄讽通守晋伯移植佳处使人知为可贵东川距绵百里馀入境遂不复有晋伯因以为惠沿流而来至此皆活作诗述谢并代简师道史君","author":"薛绍彭","text":"越王楼下种成行，濯濯分来一苇杭。\n偃盖可须千岁干，封条已傲九秋霜。\n含风便有笙竽韵，带雨偏垂玉露光。\n免作爨烟茅屋底，华轩自在拂云长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉高帝试剑石","author":"薛绍彭","text":"丰沛布衣吴芮客，回首咸秦坐悽恻。\n漫随霸楚西道迁，未甘汉地山河窄。\n随身三尺青龙子，曾断当涂素灵死。\n手提岩上试秋水，大石迎风开披靡。\n东归欲整堂堂阵，吴儿未足劳馀刃。\n炎灵天启定中原，大言成事人方信。\n君不见不侯飞将能射虎，误中他山犹饮羽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"论笔砚间物","author":"薛绍彭","text":"研滴须琉璃，镇纸须金虎。\n格笔须白玉，研磨须墨古。\n越竹滑如苔，更须加万杵。\n自封翰墨卿，一书当千户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和米芾为梁唐不收慰问帖寄诗","author":"薛绍彭","text":"圣贤尺牍间，吊问相酬答。\n下笔或无意，兴合自妍捷。\n名迹后人贵，品第分真杂。\n前世无大度，危乱相乘蹑。\n白发如莲帽，騧马似瓜贴。\n触事为不祥，凶语弃玉躞。\n料简纯吉书，乃有十七帖。\n当时博搜访，所得固已狭。\n于此半千岁，历世同灰劫。\n真圣扫忌讳，尽入淳化箧。\n巍巍覆载量，细事见广业。\n唐人工临写，野马成百叠。\n硬黄脱真迹，勾填本摹榻。\n今惟典刑在，后世皆可法。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和米芾李公炤家二王以前帖宜倾囊购取寄诗","author":"薛绍彭","text":"圣草神踪手自持，心潜模范识前规。\n惜哉法书垂世久，妙帖堂堂或见遗。\n宝章大轴首尾俱，破古欺世完使离。\n当时鉴目独子著，有如痼病工难医。\n至今所收上卷五，流传未免识者嗤。\n世间无论有晋魏，几人解得真唐隋。\n文皇鉴定号得士，河南精识能穷微。\n即今未必无褚獠，宁馨动俗千金赀。\n古囊织褾可复得，白玉为躞黄金题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和米芾越竹纸诗","author":"薛绍彭","text":"书便瑩滑如碑版，古来精纸惟闻茧。\n杵成剡竹光凌乱，何用区区书素练。\n细分浓淡可评墨，副以溪岩难乏砚。\n世间此语谁复知，千里同风未相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"薛绍彭","text":"晋大司马至洛阳，威略已著推砍羌。\n声驰江龙传国光，右军笔阵争堂堂。\n妙用作意驱后铓，惊鸿乍起游龙翔。\n仁祖无奕乌衣郎，排名篇末流遗芳。\n开元散落王涯藏，联翩飞动茂密行。\n料简鉴赏盛有唐，传授视此真印章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秘阁观书","author":"薛绍彭","text":"访古求书二十年，二王真迹几人传。\n每寻同好得消息，闻韶忘味心拳拳。\n诸家真赝可屈指，缇巾入手分媸妍。\n道山东观富奇古，世人想望如云天。\n此生尘俗分不到，九重有路来无缘。\n岂知司存预符玺，芸台高议开宾筵。\n翰林入坐中执法，未容凡吏陪诸仙。\n酒阑接武上秘阁，皇居紫禁凌非烟。\n晋康法书在宝椟，傍架牙签一一穿。\n紫衣黄门许一见，忽开复闭严关键。\n右军尽善历代宝，八法独高东晋贤。\n宏文旧物印章在，开元小篆朱犹鲜。\n草行无穷少真楷，硬黄色净昏麻笺。\n凤翥龙翔斜复直，烟霏雾结断还连。\n溟涨笔力老转剧，临池尚叹张学专。\n言奴得法号神俊，逼人体势殊翩翩。\n自方家尊聘豪翰，骎骎欲过骅骝前。\n崇虚鹅群最真迹，万里古色星日悬。\n笔乾墨淡不可拓，拙手添晕难磨湔。\n小玺肥书两贞观，每角一字居四边。\n南朝妙鉴各题检，怀充在后前僧权。\n争妍取势押缝尾，磐石卧虎推满骞。\n琅琊世谱今乃识，宝章十代何蝉联。\n忠良贼孽无去取，茂宏处仲同一编。\n其间楷真特萧散，南平秘法传僧虔。\n卷杪题官记年月，方庆疏封在石泉。\n当时盛事今不泯，曾看崔序传遗篇。\n想见举朝推好尚，小钟发论头风痊。\n髹奁别贮古杂迹，历代作者堪比肩。\n叔怀陈人有晋法，伯英汉帖疑吴颠。\n诚悬送瓜特枯硬，欧取方险虞劲圆。\n虞文发愿乃合作，壮古遒丽功力全。\n世间此帖岂有二，孔庙破石人犹怜。\n阿武章草五字句，画松分行如直弦。\n牝鸡司晨足才致，蛾眉文墨争蝉娟。\n青绫高标卷二十，淳化刻在诸帖先。\n仲尼夏禹谢太傅，山涛汉章东晋宣。\n体凡格陋漫收掇，一手临写烦雕镌。\n二王妙迹半遗落，宝章虞柳俱见捐。\n无盐刻画废西子，骐骥不御蹇著鞭。\n永熙圣学贵斯事，讨论王著何备员。\n百年文物盛于昔，继文真主方御乾。\n岩廊道业仰夔禹，太平黼藻宗云渊。\n宝书传世久未辑，明时盛事犹缺然。\n谁能借辨达聪听，愿求精识重评诠。\n收遗去陋再刊勒，鸠工不费数万钱。\n嗟哉百卷顷刻过，安得放意徐穷研。\n归来欲说急记取，瀛洲回首情悁悁。\n心存默想尚可记，以指画被夜不眠。\n休论顽仙与才鬼，但得典掌甘终焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇宁元年闰六月廿五日道祖再按盐亭经光禄坂留题顿轩","author":"薛绍彭","text":"光禄坂高盐亭东，潼江直下如弯弓。\n山长水远快望眼，少陵过后名不空。\n当时江山意不在，草动怕贼悲途穷。\n客行益远心益泰，即今何羡开元中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清閟阁","author":"薛绍彭","text":"虚堂幽幽竹森森，直节常便静者心。\n秋槛风高声戛玉，夜庭月白影筛金。\n檀栾相对复何有，挂壁丹青古名手。\n飞泉激石涌崖间，更爱霜鸿下苇滩。\n锦题玉轴照清閟，夐无一点尘埃气。\n百寻砌下日相亲，千亩渭川空自翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"薛绍彭","text":"看云醒醉眼，乘月棹回澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十九","author":"薛绍彭","text":"微波拂凉吹，澹烟生远树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十四","author":"薛绍彭","text":"曾梦春塘题碧草，偶来雾夕看红蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"薛绍彭","text":"一马春风过微雨，竹间归路净无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十三","author":"薛绍彭","text":"绿径无行路，苍苔露未晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"薛绍彭","text":"寒临重阁迥，影带乱山流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十七","author":"薛绍彭","text":"不眠听竹雨，高卧枕风湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二十二","author":"薛绍彭","text":"自然鸥鸟亲，日与渔樵遇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"薛绍彭","text":"山水三更月，烟中一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二十一","author":"薛绍彭","text":"乘月多忘归，往往带霜露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十六","author":"薛绍彭","text":"晓露凝芜径，斜阳满画桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"薛绍彭","text":"平林映日疏，野草经寒短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二十","author":"薛绍彭","text":"天寒湘水秋，雨暗苍梧暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"薛绍彭","text":"霜乾叶飘零，日出水清浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"薛绍彭","text":"桥横云壑连朝渡，雨暗灯窗半夜棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"薛绍彭","text":"官冷系怀非吏事，地偏相访定閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"薛绍彭","text":"雨不湿行径，云犹依故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十","author":"薛绍彭","text":"鸥鹭惊飞起，秋风菱荇花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"薛绍彭","text":"水云生四面，常恐世人迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"薛绍彭","text":"暮烟秦树暗，落日渭川明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十五","author":"薛绍彭","text":"无人云闭户，深夜月为灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅山","author":"薛修竹","text":"薜荔坛高秋十分，汉时笙鹤杳无闻。\n平明一觉西风梦，吹落人间半是云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆越州 其一","author":"薛奎","text":"照湖方干吟格高，搜清研奇含烂毫。\n天中无云水中月，虚明晶曜忘回舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄金绳院正因大师","author":"薛奎","text":"僧中忆艺本超群，释氏蒙求见讨论。\n儒行合为文畅侣，诗名雅作贯休孙。\n心灯久已传宗意，命服仍尝锡帝恩。\n宴坐栴檀消篆字，眼前阛阓任嚣喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆越州 其二","author":"薛奎","text":"千岩万壑争清奇，天地灵秀应无遗。\n吟舟恐在碧霄上，湖心澄波涵月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"薛奎","text":"千林如有喜，一气自无私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"薛奎","text":"囊书空自负，早晚达明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊申年七夕五绝 其四","author":"薛映","text":"月露庭中锦绣筵，神光五色一何鲜。\n世间工巧如求得，四至卿曹亦偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊申年七夕五绝 其二","author":"薛映","text":"碧天如水月如钩，金露盘高玉殿秋。\n青鸟潜来报消息，一时西望九花虬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊申年七夕五绝 其五","author":"薛映","text":"银河耿耿露漙漙，彩缕金针玉佩环。\n天媛贪忙为灵匹，几时留巧与人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊申年七夕五绝 其一","author":"薛映","text":"月放冰轮傍绛河，相期宝婺夜经过。\n嫦娥不惜宫中桂，乞与天香分外多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊申年七夕五绝 其三","author":"薛映","text":"汉殿初呈楚舞时，月台风榭镇相随。\n如何牛女佳期夕，又待銮舆百子池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曲水亭","author":"薛映","text":"台盘疏石渠，激流环四面。\n夏屋有馀清，羽觞随意转。\n宾告醉言归，主称情未惓。\n虽非禊饮辰，岂谢兰亭宴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高学士知越","author":"薛映","text":"晋朝名理汉循良，胡粉宫闱紫界墙。\n得请仍辞史官笔，忆归重换会稽章。\n閒寻岳寺茶香细，盛会江楼鲙缕长。\n官是秋曹俱老大，异时同约棹沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清风十韵","author":"薛映","text":"爽气乘秋至，凉飙荡暑初。\n泠泠含远籁，槭槭动轻裾。\n翠幕波无际，修篁韵有馀。\n潜惊塞草绿，乍拂井桐疏。\n素发悲郎将，霜纨感婕妤。\n窗光流熠耀，帘影乱蟾蜍。\n尘袭青丝骑，香飘绀幰车。\n故宫经馺娑，别馆度储胥。\n薄暮来金埒，凌晨上玉除。\n宁同起穷巷，剩欲赋愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"薛映","text":"黄鹄晨霞傍楼起，头陀秋草绕碑荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏柳","author":"薛美","text":"一撮娇黄染不成，藏鸦未稳早藏莺。\n行人自谓伤离别，枉折无情赠有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薛瓜庐吾宗人也吾不得而见之得见其诗斯可矣太息而题于卷杪","author":"薛美","text":"结庐兄弟近长安，弊却儒冠竟不弹。\n自茹芝来轻汉召，肯将瓜去博唐官。\n贫多乐事清无尽，手写新诗墨未乾。\n史笔须评隐君传，姓名应作古人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳","author":"薛海隐","text":"不问章台与楚楼，一根半树亦风流。\n看来的是多情物，爱杀春光怕杀秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞云潭","author":"薛珩","text":"一派寒潭阚碧虚，閒云自有卷还舒。\n夜来数仞祥光起，早去溪头听诏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三姝媚","author":"薛梦桂","text":"蔷薇花谢去。\n更无情、连夜送春风雨。\n燕子呢喃，似念人憔悴，往来朱户。\n涨绿烟深，早零落、点池萍絮。\n暗忆年华，罗帐分钗，又惊春暮。\n芳草凄迷征路。\n待去也，还将画轮留住。\n纵使重来，怕粉容销腻，却羞郎觑。\n细数盟言犹在，怅青楼何处。\n绾尽垂杨，争似相思寸缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"薛梦桂","text":"柳映疏帘花映林。\n春光一半几销魂。\n新诗未了枕先温。\n燕子说将千万恨，海棠开到二三分。\n小窗银烛又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚 绿笺","author":"薛梦桂","text":"碧筒新展绿蕉芽。\n黄露洒榴花。\n蘸烟染就，和云卷起，秋水人家。\n只因一朵芙蓉月，生怕黛帘遮。\n燕衔不去，雁飞不到，愁满天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"薛梦桂","text":"单衣乍著。\n滞寒更傍东风作。\n珠帘压定银钩索。\n雨弄新晴，轻旋玉尘落。\n花唇巧借妆红约。\n娇羞才放三分萼。\n樽前不用多评泊。\n春浅春深，都向杏梢觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中梅花 其二","author":"薛嵎","text":"已有梅花未有诗，青山相对动愁眉。\n山翁只在山中住，花落花开总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中梅花 其一","author":"薛嵎","text":"诗人魂在梅花上，不比垂杨管别离。\n野鹤声声声渐远，定应飞报月明知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山云惠二物 画竹","author":"薛嵎","text":"跬步园林种亦难，渭川还有几千竿。\n山云遗我冰绡轴，得与梅花相对看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山云惠二物 梅枝","author":"薛嵎","text":"赠我江南一朵春，独清滋味自相亲。\n只愁月下推敲拙，难与梅花作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆嵇师奥观梅并贵行弟殁后之思","author":"薛嵎","text":"不到嵇师今几春，凄凉疋马去无因。\n同游人葬梅花下，应笑花开不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日杂言五首 其五","author":"薛嵎","text":"布被烘来暖似汤，蒙头高卧未昏黄。\n道人不是贪鼾睡，省事门中第一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日杂言五首 其四","author":"薛嵎","text":"鹤唳柴门月过墙，梅花如雪满林香。\n风光直许闲人占，不耐闲人夜亦忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日杂言五首 其三","author":"薛嵎","text":"竹炉槁叶坐烧残，冷屋荒村夜更寒。\n冻得形模龟样缩，谁知方寸似天宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日杂言五首 其二","author":"薛嵎","text":"古藤荒草乱成堆，自课园丁日日来。\n只有梅花耐清苦，霜风枝上犯寒开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日杂言五首 其一","author":"薛嵎","text":"茅檐日出胜重裘，饱饭看山倦即休。\n识得个中真气味，自然无梦到封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]