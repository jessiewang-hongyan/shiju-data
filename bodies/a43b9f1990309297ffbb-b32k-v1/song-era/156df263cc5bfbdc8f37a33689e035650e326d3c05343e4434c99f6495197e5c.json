[{"title":"舍北行饭书触目二首 其二","author":"陆游","text":"落雁昏鸦集远洲，青林红树拥平畴。\n意行舍北三叉路，闲看桥西一片秋。\n小妇破烟撑去艇，丫童横笛唤归牛。\n形容野景无馀思，自怪痴顽不解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北独步","author":"陆游","text":"霜露沾衣迫岁徂，天公欲为老人娱。\n断云新月供诗句，苍桧丹枫列画图。\n风叶萧萧归独鹤，烟波渺渺漾双凫。\n孤村薄暮谁从我，惟是诗囊与酒壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北晚步","author":"陆游","text":"漠漠炊烟村远近，鼕鼕傩鼓埭西东。\n三叉古路残芜里，一曲清江淡霭中。\n外物已忘如弃屣，老身无伴等羁鸿。\n天寒寂寞篱门晚，又见浮生一岁穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北晚眺","author":"陆游","text":"平野沉寒日，远村生暮烟。\n离离立红树，点点散乌犍。\n暂出不逾岁，告归仍一廛。\n江湖初见雁，著眼送云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北望牛头山山有延胜寺先太傅书堂在焉六年前尝泛小江往游寺焚于睦寇书堂无复存矣","author":"陆游","text":"太傅读书处，秋风曾问途。\n江如青弋险，山似白盐孤。\n路尽还登岭，林开忽见湖。\n草堂无复识，流涕想规模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北野望四首 其三","author":"陆游","text":"溪彴通西崦，山蹊缭北村。\n残霞明水面，落叶拥篱根。\n野父编龙具，樵儿习兔园。\n吾今井蛙耳，敢复慕鹏鲲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北野望四首 其四","author":"陆游","text":"早岁遭逢异，中年促召频。\n驰驱犹许国，卧起已须人。\n药石三秋病，风波万里身。\n篱门残照里，惨淡易伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北摇落景物殊佳偶作五首 其二","author":"陆游","text":"路拥新霜叶，溪馀旧涨沙。\n栖乌初满树，归鸭各知家。\n世事元堪笑，吾生固有涯。\n南村闻酒熟，试遣小僮赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北摇落景物殊佳偶作五首 其五","author":"陆游","text":"草径人稀到，柴扉手自开。\n林疏鸦小泊，溪浅鹭频来。\n檐角除瓜蔓，墙隅斸芋魁。\n东邻膰肉至，一笑举新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北摇落景物殊佳偶作五首 其一","author":"陆游","text":"今年冬候晚，仲月始微霜。\n野日明枫叶，江风断雁行。\n穷涂多藉躏，老境易悲伤。\n自笑诗情懒，萧然旧锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北摇落景物殊佳偶作五首 其三","author":"陆游","text":"小聚鸥沙北，横林蟹舍东。\n船头眠醉叟，牛背立村童。\n日落云全碧，霜馀叶半红。\n穷鳞与倦翼，终胜在池笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍北溪上垂钓","author":"陆游","text":"大耋还家万事非，垂竿好在绿苔矶。\n风和山雉挟雌过，村晚吴牛将犊归。\n春涨新添塘滟滟，夕云仍带雨霏霏。\n此生自笑狂颠足，依旧人间一布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍西夕望","author":"陆游","text":"茆舍菱陂北，柴门药圃西。\n奇云去人近，澹月傍檐低。\n野迥羊牛下，林昏鸟雀栖。\n郊墟少还往，父子自扶携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍西晚眺示子聿","author":"陆游","text":"秋涛常记犯灵胥，季子双髦尚髧如。\n薄饭不为明日计，短檠相对十年馀。\n嗟予久合堕鬼录，怜汝犹能读父书。\n西望牛头渺天际，永怀吾祖起家初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍南杂兴三首 其二","author":"陆游","text":"莎径依山曲，柴扉并水开。\n不因行药出，即为觅诗来。\n戒婢挑蔬甲，催儿斸芋魁。\n随宜也能饱，漂母未须哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍南杂兴三首 其一","author":"陆游","text":"淅淅暮风生，晖晖残月明。\n开门喜闲望，扶杖得徐行。\n霜薄树多绿，泉流沟有声。\n儿童殊可念，画地作棋枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍南杂兴三首 其三","author":"陆游","text":"麻菽连枝熟，柴荆尽日关。\n临池惊鹭起，倚柱待云还。\n倦憩石腰鼓，行携铜博山。\n老人无定意，所到即开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍南野步","author":"陆游","text":"枯蔓络荆篱，幽花映荻扉。\n驯獐惊不起，归鹤倦犹飞。\n野色连收网，边愁入捣衣。\n壮图空自笑，事事与心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍傍晚步二首 其一","author":"陆游","text":"蒲团初起定，藤杖偶闲行。\n鸟语如相命，鱼浮忽自惊。\n麦苗经雨绿，枫叶得霜赪。\n野老淳风在，悠然不送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍傍晚步二首 其二","author":"陆游","text":"养疾便居僻，寻幽喜雨晴。\n偶因将鹿出，遂作放鱼行。\n木落塔初见，潦收滩自生。\n霜清念游衍，渐拟问山程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦贫","author":"陆游","text":"老作清时版籍民，深耕迨及故山春。\n熟思岂是天贫我，妄计还忧鬼笑人。\n但使甑中馀麦饭，何妨涧底采荆薪。\n此穷正坐清狂尔，莫向瞿昙问宿因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦贫戏作","author":"陆游","text":"五穷作祟不容支，蝉腹龟肠旋过时。\n客散难求门外辙，衣穿徒有鬓边丝。\n儿能解事甘藜藿，婢苦无薪睨扊扅。\n箕踞浩歌君会否，书痴终觉胜钱痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨二首","author":"陆游","text":"烟水茫无际，空阶滴不休。\n一窗闲隐几，四月澹如秋。\n箔冷蚕迟绩，泥深麦未收。\n家贫村酒薄，曷解老农忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热","author":"陆游","text":"万瓦鳞鳞若火龙，日车不动汗珠融。\n无因羽翮氛埃外，坐觉蒸炊釜甑中。\n石涧寒泉空有梦，冰壶团扇欲无功。\n馀威向晚犹堪畏，浴罢斜阳满野红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦寒","author":"陆游","text":"终日频添季子裘，经旬不上仲宣楼。\n摩挲酒榼虽堪喜，疏索梅花未免愁。\n正苦冰生退吟笔，却思雪作润耕畴。\n乘除扰扰殊多事，独拥青毡觅睡休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范参政挽词二首 其二","author":"陆游","text":"孤拙知心少，平生仅数公。\n凋零遂无几，迟暮与谁同。\n琼树世尘外，神山云海中。\n梦魂宁复接，恸哭向西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范参政挽词二首 其一","author":"陆游","text":"屡出专戎阃，遄归上政途。\n勋劳光竹帛，风采震羌胡。\n签帙新藏富，园林胜事殊。\n知公仙去日，遗恨一毫无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茅亭","author":"陆游","text":"终日坐茅亭，萧然倚素屏。\n儿圆点茶梦，客授养鱼经。\n马以鸣当斥，龟缘久不灵。\n诗成作吴咏，及此醉初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茅斋","author":"陆游","text":"茆斋虽绝小，老子策新勋。\n硙落霏霏雪，炉生袅袅云。\n心将鸥共远，巢与鹤中分。\n几许人间事，吾庐寂不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茆亭","author":"陆游","text":"读罢楞伽四卷经，其馀终日坐茆亭。\n静听溪碓舂云母，细斸松根采茯苓。\n大道粗尝闻海若，高情未至愧山灵。\n寒泉新渫甘于乳，晨起何妨挈半瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"表侄江坰种竹名筠坡来求诗","author":"陆游","text":"奉常遗绪冷如秋，闭户知君颇好修。\n千里可嗟妨晤语，两书犹喜免沉浮。\n但令有竹能医俗，何患无天可寄愁。\n一事却须常自勉，勿容凡子得同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视东皋归","author":"陆游","text":"抱耒新湖葑，烧畬古庙壖。\n宦游悲肮脏，归卧困沉绵。\n日隐啼鸦戍，舟回落雁天。\n衰残知迫死，不忍负青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视东皋归小酌二首 其一","author":"陆游","text":"筑陂下麦晚归来，围火烘衣始此回。\n但得诸孙传素业，真无一事挂灵台。\n井桐叶落垂垂尽，篱菊花残续续开。\n不负初寒蟹螯手，床头小瓮拨新醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视东皋归小酌二首 其二","author":"陆游","text":"少年误计慕浮名，更事方知外物轻。\n身誓生生辞禄食，家当世世守农耕。\n授时尧典先精读，陈业豳诗更力行。\n最好水村风雪夜，地炉烟暖岁猪鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视陂至崇仁村落","author":"陆游","text":"津亭徙倚客衣单，秋尽江南亦已寒。\n雁翅不禁疏雨湿，枫林初染早霞丹。\n少年已叹儒冠误，暮境更知行路难。\n倦马归来踏残日，长吟聊得写忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试茶","author":"陆游","text":"苍爪初惊鹰脱韝，得汤已见玉花浮。\n睡魔何止避三舍，欢伯直知输一筹。\n日铸焙香怀旧隐，谷帘试水忆西游。\n银瓶铜碾俱官样，恨欠纤纤为捧瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试茶","author":"陆游","text":"强饭年来幸未衰，睡魔百万要支持。\n难从陆羽毁茶论，宁和陶潜止酒诗。\n乳井帘泉方遍试，柘罗铜碾雅相宜。\n山僧剥啄知谁报，正是松风欲动时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院春晚","author":"陆游","text":"病思萧条掩绿樽，闲坊寂历锁朱门。\n故人别久难寻梦，远客愁多易断魂。\n漫漫晚花吹瀼岸，离离春草上宫垣。\n此生飘泊何时已，家在山阴水际村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗酒","author":"陆游","text":"酒隐凌晨醉，诗狂彻旦歌。\n悯怜蜗左角，嘲笑蚁南柯。\n风月随长笛，江湖入短蓑。\n平生会心处，最向漆园多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗酒","author":"陆游","text":"诗酒平生乐，无如老病侵。\n才衰愁韵险，量退怯杯深。\n宿露滋金藟，微霜点缬林。\n呼鹰五陵路，惆怅少年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫中自戏","author":"陆游","text":"种枳为篱草结庐，人间知足更谁如。\n涧深松老忘荣谢，天阔云闲任卷舒。\n门冷并无残客迹，家贫常读绝编书。\n有金可散还关念，多事从来笑汉疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫乐","author":"陆游","text":"萧然曲肱地，自号直心翁。\n拙宦三灾过，劳生一笑空。\n新蔬经雨绿，晚稻得霜红。\n饱食真无事，浩歌明月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫叹","author":"陆游","text":"老叟年年病，书生世世贫。\n盗宁窥破橐，雀亦弃空囷。\n屋坏须撑拄，衣穿厌补纫。\n今朝风日美，且复过比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫叹","author":"陆游","text":"贫到今年极，萧然四壁家。\n弊袍生虮虱，粗饭杂泥沙。\n浩浩乾坤大，茫茫岁月赊。\n故乡烟水窟，别拟卜生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居","author":"陆游","text":"囊空如客路，屋窄似僧寮。\n得饭多菰米，烹蔬半药苗。\n草生初失径，笋放欲干霄。\n不道弓旌误，虞人自畏招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居即事六首 其三","author":"陆游","text":"月黑枭鸣树，灯残鼠穴墙。\n床空围纸被，室静爇枫香。\n不恨言伤直，惟忧欲败刚。\n回头顾名利，百世永相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居即事六首 其二","author":"陆游","text":"地偏人罕到，秋晚日犹长。\n病去筇枝赘，家贫菜粥香。\n流泉通药垄，积雨润书囊。\n欲谱幽居事，疏慵久未遑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居即事六首 其五","author":"陆游","text":"意绪丧家狗，形骸槁木枝。\n曲肱虽自适，纵理固当饥。\n买絮初寒后，畦蔬小雨时。\n穷途何用卜，吾道即蓍龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居即事六首 其四","author":"陆游","text":"米竭炊烟静，村深客屦稀。\n庭除荒宿莽，篱落带斜晖。\n风恶披书卷，鸥驯傍钓矶。\n邻家殊耐久，相伴荷锄归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居即事六首 其六","author":"陆游","text":"守道常违俗，存心不愧天。\n终年饥过半，动步谤居前。\n力倦少行立，气昏多睡眠。\n今宵风月好，扶杖到溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居即事六首 其一","author":"陆游","text":"筮易常逢坎，推星但值箕。\n老虽齐渭叟，穷不减湘累。\n巷月鸣衣杵，庖烟爨豆萁。\n秋深病良已，且复强伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫居时一肉食尔戏作","author":"陆游","text":"身老便居僻，山寒喜屋低。\n时犹赖僧米，那惜贷邻醯。\n汤饼挑春荠，盘餐设冻齑。\n怪来食指动，异味得豚蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫述","author":"陆游","text":"寒生肌粟苦衣单，瘦减头围觉帽宽。\n荒寂在家犹逆旅，穷空养老亦蔬餐。\n柴青灶突腾烟细，膏尽灯缸照字难。\n犹喜新醅三斗熟，半窗梅影助清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫甚戏作长句示邻曲","author":"陆游","text":"百屋堆钱四壁空，人生志愿孰能同。\n萧条齿发难藏老，冷落杯盘可讳穷。\n斸笋不思鄣夏日，典衣那计禦霜风。\n知心幸有邻翁在，一笑相从草莽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫甚自励","author":"陆游","text":"忍病停朝药，捐书省夜灯。\n都门下第客，山寺退居僧。\n天每临幽隐，人何与废兴。\n能轻马千驷，肯慕稷三升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫病","author":"陆游","text":"贫至今年剧，真无地置锥。\n判愁停贳酒，忍病罢迎医。\n性懒非关老，天穷岂坐诗。\n秋风还欲到，便可数期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫病","author":"陆游","text":"行年七十尚携锄，贫悴还如白纻初。\n好事邻僧勤送米，过门溪友强留鱼。\n客来旋过墙头酒，睡起闲抽架上书。\n要信荣枯元不动，胸中浩浩著空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贫病","author":"陆游","text":"穷愁病思两茫茫，衰发元知合变霜。\n酒要解酲犹有策，食求祝噎更无方。\n凋零坐上亲朋少，寂寞人间岁月长。\n默计有时还自幸，幼安垂老始归乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀二首 其一","author":"陆游","text":"尺寸虽无补县官，此心炯炯实如丹。\n羯胡未灭敢爱死，尊酒在前终鲜欢。\n亚父抱忠撞玉斗，虞人守节待皮冠。\n纵言老病摧颓甚，壮气犹凭后代看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀二首 其二","author":"陆游","text":"谤誉纷纷笑杀侬，此身本自等虚空。\n大鹏境界纤尘里，旷劫年光掣电中。\n翻动烟霞长镵在，招呼风月一尊同。\n是凡是圣谁能测，试问西邻织屦翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀","author":"陆游","text":"情怀犹是昔年人，岂料侵寻八十身。\n灯下看书方觉老，花前阙酒始知贫。\n玉非鼠朴何劳辨，鱼与熊蹯各自珍。\n万事回头已陈迹，为君一笑落纱巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀","author":"陆游","text":"宦游轻用不赀身，敛退今为省事人。\n唾俟面乾元不校，羹忧手烂更谁嗔。\n时分邻瓮双瓶绿，永谢官仓五斗陈。\n最好暮秋溪上路，柴门月色向人新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述闲","author":"陆游","text":"披衣按摩罢，据榻欠伸馀。\n香暖翻心字，茶凝出草书。\n客稀门每闭，意闷发重梳。\n赖有盆山树，幽情得少摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述意","author":"陆游","text":"忧患无穷生有涯，惟须百事屏纷华。\n人谁敢侮修身士，天不能穷力穑家。\n频唤老僧同夜粥，间从邻叟试秋茶。\n结茅林下从来事，瓦屋三间已太奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述感","author":"陆游","text":"断简承孤学，穷阎负壮心。\n方忧一齿落，何止二毛侵。\n买地开幽圃，招僧理废琴。\n浮生祇如此，感慨不须深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行","author":"陆游","text":"凄风吹雨过江城，缓策羸骖并水行。\n古路初惊秋叶堕，荒郊已放候虫鸣。\n壮心耿耿人谁识，往事悠悠恨未平。\n斜日半竿羌笛怨，西陵寂寞又潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行","author":"陆游","text":"山色扫石黛，江流涨曲尘。\n春晴不终日，老病动经旬。\n竹密有啼鸟，村深多醉人。\n东阡与南陌，处处寄闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行","author":"陆游","text":"春郊无处不堪行，满路人家笑语声。\n卖剑买牛知盗息，乞浆得酒喜时平。\n西村日落川云暝，东岭虹收海气清。\n农事方兴戒游惰，为君来往主齐盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]