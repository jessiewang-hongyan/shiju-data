[{"title":"送薛十水部通判并州","author":"梅尧臣","text":"并州自古近胡地，牛酒常行十万兵。\n少尹曾为五府辟，将军况有旧家声。\n桑麻故已知风俗，丘垄何须访姓名。\n闻说至今犹好马，试求安稳众中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送董传秀才之汝阴","author":"梅尧臣","text":"社燕已归尽，秋莺犹绕林。\n久为梁国客，不起灞陵心。\n徒步赴朋馆，远游无橐金。\n江君丈人意，莫入楚乡深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蟾上人游南岳","author":"梅尧臣","text":"叶下潇湘阔，杯浮岂道迟。\n宾鸿不到处，危彴独行时。\n翠岭祝融宅，乔松虞舜祠。\n云霞游遍日，振锡更何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡阁阅书投壶和呈相国晏公","author":"梅尧臣","text":"较量人世无穷乐，罗列平生未见书。\n聊奉投壶祭征虏，休言系剑马相如。\n画楼晚去闻寒角，缥帙看来落蠹鱼。\n日获诲言皆旧学，不惭贫贱带经锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送宋中道","author":"梅尧臣","text":"陇草陈根发，山樱宿雾蒸。\n将过周故宅，先下汉诸陵。\n柏道春经雨，官沟暗溜冰。\n莼羹休定价，羊酪易为胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送李逢原归苏州","author":"梅尧臣","text":"吴客归从楚，霜华著马蹄。\n倦童持弊橐，呼艇过寒溪。\n索寞区中饭，依稀日午鸡。\n张仪犹舌在，不必愧于妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送周都官","author":"梅尧臣","text":"水上朱楼画角鸣，濛濛雨里榜舟轻。\n未逢甫里先生谒，多见吴兴太守迎。\n荷叶半黄莲子老，霜苞微绿橘林明。\n十年不到风烟改，君去将诗与昼评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送祖择之北使","author":"梅尧臣","text":"文章世德已能传，得桂高枝二十年。\n持节欲同苏武劲，下帷曾似董君贤。\n衣裘衽领无嫌左，饮食杯盂暂厌膻。\n一过范阳应感槩，归来图画彼山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送袁世弼","author":"梅尧臣","text":"临川内史谢康乐，贝叶翻经有故台。\n春草生塘犹梦句，秋蕖出水似君才。\n驐鸡肥脆聊供膳，篘酒甘浓可荐杯。\n亦说右军遗迹在，墨池科斗喜风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送曾子固","author":"梅尧臣","text":"楚泽多年一卧龙，新春雷雨起鳞踪。\n谁知天上争腾跃，偶落池中杂噞喁。\n且自摧藏随浪去，何当驾驭使云从。\n刘累只说古来有，暂屈泥蟠莫便慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺思","author":"梅尧臣","text":"望日赤如橘，游梁音信稀。\n愁心常似醉，春絮等闲飞。\n江鲚看将烂，芹牙吐尚微。\n何时凭燕子，寄取锦书归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻王景彝雪中禖祀还","author":"梅尧臣","text":"二月漫漫雪，斋宫夜寂寥。\n坛场祠乙鸟，桑柘响阴枭。\n履带春泥重，驹回广野骄。\n还批五色诏，池上踏琼瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻永叔出守同州寄之","author":"梅尧臣","text":"冕旒高拱元元上，左右无非唯唯臣。\n独以至公持国法，岂将孤直犯龙鳞。\n茱萸欲把人留楚，苜蓿方枯马入秦。\n访古寻碑可销日，秋风原上足麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻永叔复馆因以寄贺","author":"梅尧臣","text":"东方有铩禽，已喜羽翰插。\n重来金马门，莫忘黄牛峡。\n黄牛无冬春，远水生鳞甲。\n今非昔日忧，贺酒特新压。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻尹师鲁谪富水","author":"梅尧臣","text":"朝见谏臣逐，暮章从谪官。\n附炎人所易，抱义尔惟难。\n宁作沉泥玉，无为媚渚兰。\n心知归有日，时向斗牛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻角","author":"梅尧臣","text":"一声催客梦，星斗转西檐。\n风卷梅花去，愁从柳塞添。\n马鸣霜满鬣，龙泣冻生髯。\n高树朝光动，城头落海蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻卖韭黄蓼甲","author":"梅尧臣","text":"百物冻未活，初逢卖菜人。\n乃知粪土暖，能发萌芽春。\n柔美已先荐，阳和非不均。\n芹根守天性，憔悴涧之滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻欧阳永叔谪夷陵","author":"梅尧臣","text":"共在西都日，居常慷慨言。\n今婴明主怒，直雪谏臣冤。\n谪向蛮荆去，行当雾雨繁。\n黄牛三峡近，切莫听愁猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻语十方琏长老","author":"梅尧臣","text":"旧居庐岳寺，新化给孤园。\n还享国人供，应无尘事喧。\n有来听喻筏，一悟见吹幡。\n不忆炉峰下，临溪看饮猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻高平公殂谢述哀感旧以助挽歌三首 其三","author":"梅尧臣","text":"一出屡更郡，人皆望酒壶。\n俗情难可学，奏记向来无。\n贫贱常甘分，崇高不解谀。\n虽然门馆隔，泣与众人俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻高平公殂谢述哀感旧以助挽歌三首 其二","author":"梅尧臣","text":"京洛同逃酒，单袍跨马归。\n明朝各相笑，此分不为稀。\n公既参炉冶，予将事蕨薇。\n悲哀无以报，有涕向风挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻高平公殂谢述哀感旧以助挽歌三首 其一","author":"梅尧臣","text":"文章与功业，有志不能成。\n尝以隮高位，终然屈大名。\n遗风犹可见，逝水更无情。\n归卜青乌垄，韩城苦雾平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻雁寄欧阳夷陵","author":"梅尧臣","text":"闲坐独无寐，雁来更未阑。\n声长河汉迥，影落户庭寒。\n荆楚橘包熟，潇湘枫叶丹。\n南飞过三峡，试问故人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻韩仲文使归","author":"梅尧臣","text":"传道使车回，柳条黄未开。\n晓寒非绝漠，春色近章台。\n名马北方至，宾鸿南国来。\n明朝斋祓见，天子始称才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻橹","author":"梅尧臣","text":"静夜有舟下，中流闻橹声。\n隔窗灯已暗，卷幔月微明。\n渐向寒湾远，遥应宿枕惊。\n客心何苦急，曾是不缘名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夕与家人饮","author":"梅尧臣","text":"莫嫌寒漏尽，春色来应早。\n风开玉砌梅，薰歇金炉草。\n稚齿喜成人，白头嗟更老。\n年华个里催，清镜宁长好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜雪","author":"梅尧臣","text":"击鼓人驱鬼，漫天雪送寒。\n腊从今日尽，花作旧年看。\n著树多还堕，随风积更乾。\n明朝预王会，畏湿两梁冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食橙寄谢舍人","author":"梅尧臣","text":"洞庭朱橘未弄色，襄水锦橙已变黄。\n玉臼捣齑怜鲙美，金盘按酒助杯香。\n虽生南土名犹重，未信中州客厌尝。\n欲寄白苞凭驿去，只应佳味怯风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香炉","author":"梅尧臣","text":"铁铸小香炉，壁环平口铺。\n麝焚葵叶大，兽齧竹根趺。\n净几群书外，闲堂一物无。\n中间任灰烬，终与蕙兰俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"原有禽倏鸣升遽默下","author":"梅尧臣","text":"小禽不盈握，羽翮自轻捷。\n袅袅上云鸣，声穷如陨叶。\n雀怀啄粟娱，鴳有栖蒿惬。\n嗟嗟力甚微，枉与鹰鹯接。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭尹师鲁","author":"梅尧臣","text":"谪死古来有，无如君甚冤。\n文章不世用，器业欲谁论。\n野鸟灾王傅，招辞些屈原。\n平生洛阳友，零落几人存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭王几道职方三首 其三","author":"梅尧臣","text":"得君音信近，安稳在缑山。\n不是国医误，宁辞蜀道艰。\n终然有脩短，犹免历间关。\n便作千秋别，沾襟涕泪班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭王几道职方三首 其二","author":"梅尧臣","text":"我今过五十，万事日消磨。\n熟识世间寡，故交泉下多。\n叶秋知易陨，松耐竟如何。\n尝亦悲前哲，荒坟野鼠窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭王几道职方三首 其一","author":"梅尧臣","text":"前罢邯郸守，孤高与世违。\n青云旧知在，白首故园归。\n既没无儿女，元贫只帐帏。\n平生洛阳友，从此更应稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭孙明复殿丞三首 其三","author":"梅尧臣","text":"自古春秋学，皆知不可过。\n生前恩礼少，殁后荐章多。\n妻子将焉托，田园有几何。\n汶阳秋树里，黄鸟谩听歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭孙明复殿丞三首 其二","author":"梅尧臣","text":"旧业居东岱，中年谒紫庭。\n要涂无往迹，至死守残经。\n诏许求遗稿，朋邻与葬铭。\n世人无怪我，涕泪为之零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭孙明复殿丞三首 其一","author":"梅尧臣","text":"鲁国先生殁，夷门吉士哀。\n因谗君席远，时赙帝恩该。\n寂寞蒿宫启，悠扬茜旐回。\n昔贤皆不免，松下作寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐寺丞知南雄州","author":"梅尧臣","text":"前林尚含冻，南国使君行。\n逆水春风峭，孤舟桂席轻。\n踏歌闻旧俗，信鬼有颓氓。\n当识朱衣贵，壶浆拥道迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日对雨偶成寄韩仲文兄弟","author":"梅尧臣","text":"日日城头雨，还愁湖上波。\n窗中人自听，门外潦应多。\n不畏车生耳，还愁麦化蛾。\n吾庐无所有，频看壁间梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日汴中作","author":"梅尧臣","text":"倚棹望平野，低云密未收。\n黄鹂度高柳，归燕拂行舟。\n浊水不堪照，清江空忆游。\n晚晴蒸润剧，喘月见吴牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日晚霁与崔子登周襄故城","author":"梅尧臣","text":"雨脚收不尽，斜阳半古城。\n独携幽客步，闲阅老农耕。\n宝气无人发，阴虫入夜鸣。\n余非避喧者，坐爱远风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏雨","author":"梅尧臣","text":"林梅初弄熟，密雨闭重关。\n润裛衣巾上，凉生竹树间。\n水声通远涧，云色暝前山。\n野鸟寂无语，公庭尽昼闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏侯彦济武陟主簿","author":"梅尧臣","text":"怀县曾余往，风谣为尔知。\n寒先太行近，润接大河卑。\n宾酒栽公秫，晨羹剪露葵。\n簿书行正委，何似布衣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徒步访李宣叔宣叔有诗依韵答","author":"梅尧臣","text":"渡河谁道去，我重子云才。\n鸿雁汀洲去，牛羊井落徕。\n乍行初觉倦，暂语不能该。\n日色看看暮，将归意复回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓","author":"梅尧臣","text":"乌蟾不出海，天地无明时。\n万国睡未觉，一声鸡已知。\n树头星渐没，枝上露应垂。\n人世纷纷事，劳劳只自为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮来山","author":"梅尧臣","text":"秦鬼驱卯沙，聚结无苍翠。\n谁云海上移，能与潮浮至。\n洞嘘蛟鼍腥，庙画风雷异。\n云母今有无，庶为仙药饵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"梅尧臣","text":"江燕入朱閤，海棠繁锦条。\n醉生燕玉颊，瘦聚楚宫腰。\n曾未分香去，尤宜著意描。\n谁能共吹笛，树下想前朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"梅尧臣","text":"要识吴同蜀，须看线海棠。\n燕脂色欲滴，紫蜡蒂何长。\n夜雨偏宜著，春风一任狂。\n当时杜子美，吟遍独相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涂中遇雪寄希深","author":"梅尧臣","text":"方为郡邑吏，日与故人违。\n极目千山碧，驰心一鸟飞。\n岸傍村杳杳，波上雪霏霏。\n欲寄洛阳信，溯流行客稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涡口","author":"梅尧臣","text":"秋水见滩底，浅沙交浪痕。\n白鱼跳处急，宿雁下时昏。\n带月入涡尾，落帆防石根。\n清淮行未尽，明日又前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留守相公新创双桂楼","author":"梅尧臣","text":"藻栋起霄间，芳条俯可攀。\n晚云谈次改，高鸟坐中还。\n日映城边树，虹明雨外山。\n唯应谢池月，来照衮衣闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别乐和之","author":"梅尧臣","text":"雪消潭水绿，轻舸下滩时。\n渐转青山去，还将故国辞。\n野林看欲动，江燕欲逢迟。\n君语随州体，余惭晚始知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别李君锡学士","author":"梅尧臣","text":"淮南尚喜风流在，客有殷勤载酒过。\n不醉不归情可见，相看相笑意如何。\n瞭眸自解持高论，长颈稀逢缺善歌。\n旧爱阳关亦休唱，西还从此故人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题希深美桧亭","author":"梅尧臣","text":"幽深有佳趣，曾不减林泉。\n众绿经新雨，残红堕夕烟。\n栽萱北堂近，梦草故池连。\n乘月时来往，清歌思浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离芜湖至观头桥","author":"梅尧臣","text":"江口泊来久，菰蒲长旧苗。\n争雏洲鹊斗，遗子浦鱼跳。\n宿岸欣逢戍，归船竞趁潮。\n时时望乡树，已恨白云遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莺","author":"梅尧臣","text":"绿柳阴犹薄，黄鹂啭已清。\n年年舟上客，处处树头声。\n髣髴佳人语，依稀太子笙。\n夕阳听不足，飞入旧荒城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚊","author":"梅尧臣","text":"向晚化污积，群飞来户庭。\n蟭螟许巢睫，琥珀为留形。\n夜色遍容蔽，雷音亦感听。\n犹矜负山力，血食也沾醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁大监挽词三首 其三","author":"梅尧臣","text":"不向斗牛望，已闻风雨哀。\n沉埋太阿剑，毁折豫章材。\n百鍊饱于锻，九层谁起台。\n平生嗟泯泯，逝水讵重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁大监挽词三首 其二","author":"梅尧臣","text":"西蜀何夫子，濡毫作冢铭。\n辽辽传耳目，炳炳若丹青。\n罢市知遗爱，存祠识旧形。\n生刍莫能置，江阔底沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁大监挽词三首 其一","author":"梅尧臣","text":"昔罢宣城守，将归尚抚予。\n殷勤为开径，惨怆遂登车。\n告老闻还楚，遗荣喜效疏。\n西山忽埋玉，松露助涟如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸韩来会别","author":"梅尧臣","text":"诸韩行有日，别思更依依。\n独叹从予少，还看似子稀。\n呼童聊奏酒，洒水为开扉。\n苏合染裘美，雪中阊阖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读黄节推卷","author":"梅尧臣","text":"磊落黄从事，清吟古气多。\n少年知任侠，欲老解登科。\n辨起公卿坐，时为慷慨歌。\n又持珠玉赠，将奈老贫何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"较艺和王禹玉内翰","author":"梅尧臣","text":"分庭答拜士倾心，却下朱帘绝语音。\n白蚁战来春日暖，五星明处夜堂深。\n力搥顽石方逢玉，尽拨寒沙始见金。\n淡墨榜名何日出，清明池苑可能寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"较艺将毕和禹玉","author":"梅尧臣","text":"窗前高树有栖鹊，记取明朝飞向东。\n家在望春门外住，身居华省信难通。\n夜闻相府催张榜，晓听都堂议奏中。\n龙阁凤池人渐隔，犹因朝谒望鳌宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"较艺赠永叔和禹玉","author":"梅尧臣","text":"今看座主与门生，事事相同举世荣。\n并直禁林司诏令，又来西省选豪英。\n飞龙借马天边下，光禄供醪月底倾。\n食叶蚕声句偏美，当时曾记赋将成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪淮南转运魏兵部游颖州女郎台寺","author":"梅尧臣","text":"旧传妫氏女，将适楚人时。\n筑馆自临水，故台空此基。\n因为楚宫媵，来与使车期。\n楼上望湖上，烟林晚蔽亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"难知","author":"梅尧臣","text":"自古难知不遇人，朝为蛇鼠暮龙麟。\n魏齐客溺箦中死，亭长妻轻胯下贫。\n白石夜歌谁与进，黄金怀印自能伸。\n丈夫只患无才业，何恨区区逐路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高士王君归建业","author":"梅尧臣","text":"风雨起春寒，乘潮晓帆送。\n目看瓜步云，心近茅家洞。\n忽觉柳已青，来时枝尚冻。\n羡尔向江南，正开新酿瓮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"啄木二首 其一","author":"梅尧臣","text":"城头啄枯杨，城下啄枯桑。\n朝啄不停咮，暮啄不充肠。\n寒风正洌洌，蠹穴虫且僵。\n况兹园林迥，剥剥响何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]