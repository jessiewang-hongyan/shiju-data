[{"title":"丁未春五首 其五","author":"刘克庄","text":"朝领诸儒上木天，夕同野老话茅椽。\n何须支枕思残梦，宫锦渔蓑总偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁未春五首 其四","author":"刘克庄","text":"屡批龙鳞眷未衰，孤臣万死负恩私。\n玉阶方寸从容语，惟有天知与上知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁未春五首 其三","author":"刘克庄","text":"道是生姜树上生，不应一世也随声。\n暮年受用尧夫语，莫与张程几个争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁未春五首 其二","author":"刘克庄","text":"生死荣枯一付天，谁能裸露自求全。\n殷勤寄语袁司隶，滥及无须或可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁未春五首 其一","author":"刘克庄","text":"端平淳祐两匆匆，过眼光阴掣电同。\n六十一翁无出理，孤山长寄梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉重九日宿顺昌步云阁绝句七首呈味道明府 其三","author":"刘克庄","text":"小休绿树濯清泉，垢尽身轻意欲仙。\n岂必鲁儒知此乐，舞雩风止在溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉重九日宿顺昌步云阁绝句七首呈味道明府 其四","author":"刘克庄","text":"九月南州菊未黄，芙蓉取次献新妆。\n不妨折取繁红插，四海皆知两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉重九日宿顺昌步云阁绝句七首呈味道明府 其五","author":"刘克庄","text":"只了年年作逐臣，衣冠褴缕面埃尘。\n偶逢令尹留连我，不畏狂生点涴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉重九日宿顺昌步云阁绝句七首呈味道明府 其一","author":"刘克庄","text":"傍邑曾为劫火尘，独兹犹是太平民。\n儿时所历今三纪，便唤溪山作故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉重九日宿顺昌步云阁绝句七首呈味道明府 其六","author":"刘克庄","text":"先倩清风扫水轩，更呼凉月倒金樽。\n定知明府归侵夜，县郭留灯未闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉重九日宿顺昌步云阁绝句七首呈味道明府 其二","author":"刘克庄","text":"老子痴顽耐远游，平生腹不贮闲愁。\n今年天赐登高地，身在云峰最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉重九日宿顺昌步云阁绝句七首呈味道明府 其七","author":"刘克庄","text":"长君论事天为动，季子居官水似清。\n双眊不能钞谏草，偏聋尚可听琴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其十","author":"刘克庄","text":"虽瞎吾眼犹劬书，平生无泪如唐衢。\n爱鹤天鲸海空阔，嫌羊肠鸟道崎岖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其九","author":"刘克庄","text":"业缘在东震旦国，参礼遍南赡部州。\n欠明眼人与谈道，就圆机士语九流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其八","author":"刘克庄","text":"旧田庐我先人业，某水丘吾童子游。\n有杞菊姑安甫里，无蒲萄可博凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其七","author":"刘克庄","text":"经书上卿曰刘子，史称三老为董公。\n赵章泉自号晏叟，朱先生一字遁翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其六","author":"刘克庄","text":"适闻有诏追阳子，又说厚礼迎申公。\n莫教涑水疑四皓，且伴横渠吟八翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其五","author":"刘克庄","text":"向来热血泼虚庸，卮酒凭谁酹二公。\n老作地仙差□了，洞宾相约听松风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其四","author":"刘克庄","text":"多作恶诗供世笑，晚持孤论谁予同。\n才名压倒豁□老，官职火迫乖崖翁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其三","author":"刘克庄","text":"便有凤从千仞下，更无虎守九重门。\n拔茅初喜仕途泰，起蕝乃知皇帝尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其二","author":"刘克庄","text":"仕宦端平甲子岁，结局景定壬戌年。\n有北窗凉来枕畔，无南风尘傍扇边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七十九吟十首 其一","author":"刘克庄","text":"阅世桑田变海波，谩存铜狄共谁摩。\n钓璜岁日明年是，驰隙光阴一霎过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月九日二首 其二","author":"刘克庄","text":"樵子俄从间路回，因言溪谷响如雷。\n分明雨怕城中去，只隔前峰不过来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月九日二首 其一","author":"刘克庄","text":"海激天翻电雹嗔，苍松十丈劈为薪。\n须臾龙卷它山去，误杀田头望雨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七窍凿","author":"刘克庄","text":"自从七窍凿，无复六根全。\n鲸死彗星出，蟆枯月魄圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月初十日值宿玉堂七绝 其六","author":"刘克庄","text":"形槁心灰一秃翁，偶来视草禁林中。\n幼吹葱叶还堪听，老画葫芦却未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月初十日值宿玉堂七绝 其二","author":"刘克庄","text":"制书挥就进明光，天笔批还墨尚香。\n草本偶然无贴改，非关臣亿怕商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月初十日值宿玉堂七绝 其四","author":"刘克庄","text":"内厨进膳惟蔬素，御帕封香遍竹宫。\n明日金乌迎玉辂，始知圣主与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月初十日值宿玉堂七绝 其一","author":"刘克庄","text":"西山遗业付门人，岁晚推迁接后尘。\n綵笔梦中先索去，不知持底作词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月初十日值宿玉堂七绝 其三","author":"刘克庄","text":"转枕依然梦不成，小窗颇觉晓寒生。\n昏花却怕宫莲照，垂下纱幮听六更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月初十日值宿玉堂七绝 其七","author":"刘克庄","text":"四壁蠹书常锁闭，数行苏墨半模糊。\n院中老吏无存者，谁记南塘与雁湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月初十日值宿玉堂七绝 其五","author":"刘克庄","text":"窗外茶梅几树斜，薄寒生意已萌芽。\n主人不作明朝计，愁绝无因见放花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其四","author":"刘克庄","text":"贵家选色斛量珠，洗尽铅华绝代无。\n老子效颦聊复尔，名昆崙婢作琼奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其八","author":"刘克庄","text":"门户重重绣幕遮，十分国艳属侯家。\n谁知蔡琰燕山北，愁听胡笳对雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其一","author":"刘克庄","text":"商略红儿何足比，丁宁青女不须嗔。\n故横瘦影禁持月，时送微香漏泄春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其七","author":"刘克庄","text":"名见商书又见诗，畹兰难拟况江蓠。\n灵均苦要群芳聚，却怪骚中偶见遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其五","author":"刘克庄","text":"薄薄中单掩塞酥，不知眉黛有愁无。\n微颦莫是尝梅子，好事讹为齿痛图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其六","author":"刘克庄","text":"国色名花俱绝代，玉人甘后本双身。\n劝君薄薄施朱粉，莫遣名花妒玉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其二","author":"刘克庄","text":"翠袖佳人寒倚竹，素衣仙子昼看花。\n村墟忽有殊尤观，茅屋俄成富贵家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其十","author":"刘克庄","text":"新咏平生陋玉台，梨园以后更堪哀。\n宁随太白金鞍去，莫放花奴羯鼓来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九叠 其九","author":"刘克庄","text":"和靖终身欠孟光，只留一鹤伴山房。\n唐人未识花高致，苦欲为渠聘海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十日再锁宿四绝 其三","author":"刘克庄","text":"才薄何堪草两麻，封题进了鼓三挝。\n平明掣锁无公事，闲看金鱼咽落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十日再锁宿四绝 其一","author":"刘克庄","text":"角门闭了晓方开，坐撚霜髭尽雪灰。\n纵有浩然堪共直，法严不敢唤渠来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2924