32d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月初七日寿溪十绝 其十","author":"刘克庄","text":"城郭有时变，市朝回首非。\n谁为辽鹤说，第一莫来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月初七日寿溪十绝 其二","author":"刘克庄","text":"士不论穷达，离乡即可哀。\n白头孙七十，岁岁埽松来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月初七日寿溪十绝 其八","author":"刘克庄","text":"□□□夜里，折箭传黄旗。\n野老心无事，闻之忽皱眉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月初七日寿溪十绝 其七","author":"刘克庄","text":"□□宽裁领，蓬头乱插花。\n相呼挈牲酒，再拜祷桑麻。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月初七日寿溪十绝 其五","author":"刘克庄","text":"锁却藏舟屋，丁宁勿浪开。\n渔郎最饶舌，曾去引人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月初七日寿溪十绝 其九","author":"刘克庄","text":"□□眼中人，累累原上坟。\n昔作夸毗子，今为冥漠君。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二世","author":"刘克庄","text":"失国之君多咎政，兴王者作著休符。\n亡秦天告由胡亥，非谓长城外有胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二吕","author":"刘克庄","text":"韩吕真乔木，蟠根与国同。\n伯泰太史氏，子约大愚公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其一","author":"刘克庄","text":"晚作园翁自荷锄，春风那肯到吾庐。\n且须怜意著芳洁，才说和羹俗了渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其九","author":"刘克庄","text":"呕出心肝撚短髭，篱边沙际动移时。\n獠奴窃笑翁迂阔，因斲梅诗忘午炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其七","author":"刘克庄","text":"暮年鼻塞等薰莸，高摘浓薰两罢休。\n奴折长枝汲薪水，老夫不复置香篝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其十","author":"刘克庄","text":"锦囊玉笛昔追从，度曲联诗雪月中。\n老对梅花无意味，欠诗欠笛欠花翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其四","author":"刘克庄","text":"浮休叹柳斫为薪，子美怜梅傍战尘。\n只愿玉关烽燧息，老身长作看花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其五","author":"刘克庄","text":"环子丽华皆已美，谪仙狎客两堪悲。\n悬知千载难湔洗，留下沉香结绮诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其三","author":"刘克庄","text":"汉魏诸贤韵已卑，六朝人物复何为。\n平生老子羞由径，不识虫儿与玉儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其八","author":"刘克庄","text":"看来天地萃精英，占断人间一味清。\n唤作花王应不忝，未应但做水仙兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其六","author":"刘克庄","text":"百卉凋零独凛然，谷风栗烈涧冰坚。\n阴山餐雪有臣节，中野履霜无母怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二叠 其二","author":"刘克庄","text":"生在荒山野水傍，可曾倚市更窥墙。\n幽妍丑杀施朱女，高洁贤于傅粉郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入浙","author":"刘克庄","text":"浦城南畔只轻阴，入浙方惊雪许深。\n梅皓枫丹三百里，笑人短幅写寒林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其十","author":"刘克庄","text":"伯伦酒颂老叉诗，腹愤胸奇略泄之。\n别著潜书并悔藁，后千百载有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其七","author":"刘克庄","text":"纵心以后决求归，曰耄之年永息机。\n蔬食不消人祝饐，布裘安用妾熏衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其九","author":"刘克庄","text":"试笔懒题新郁垒，拂尘聊挂古钟馗。\n斑衣纪节诸孙喜，白首添年一老悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其五","author":"刘克庄","text":"逃秦博士浮丘伯，传说今犹在海中。\n自古仙多儒者做，安知吾不蹑高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其八","author":"刘克庄","text":"诚翁仅有四千首，惟放翁几满万篇。\n老子胸中有残锦，问天乞与放翁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其一","author":"刘克庄","text":"就莆食菜国恩优，昼锦全胜万里侯。\n却笑向来师尚父，磻溪不老老营丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其三","author":"刘克庄","text":"汉承秦后古书亡，太息高文总未遑。\n六叶蒲轮迎一老，元来却是议明堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其二","author":"刘克庄","text":"至道之精以治身，推其土苴足经纶。\n矢诗自儆侬衰惰，未有工夫儆国人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其六","author":"刘克庄","text":"八十馀岁老儒生，见帝谆谆劝力行。\n应被伏生辕固笑，两贤终是十年兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八十吟十绝 其四","author":"刘克庄","text":"文叔差增似往时，君房只是向来痴。\n谁知有个羊裘叟，汉鼎悬渠一钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]