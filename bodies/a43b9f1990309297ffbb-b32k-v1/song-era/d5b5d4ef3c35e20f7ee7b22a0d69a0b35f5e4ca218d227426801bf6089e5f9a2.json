[{"title":"桥上口占二首 其二","author":"吕本中","text":"风雨属连春事休，十日九日转城头。\n虽无俗物败人意，可使澄江消客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵逊叔直门见寄兼请尧明同和","author":"吕本中","text":"纷纷尘土计秋豪，忽送长江八月涛。\n陶令且为州祭酒，邓公才可掾功曹。\n但看秋到犹絺绤，即是花时合缊袍。\n待得公归吾已老，满田荼蓼与谁薅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后至城外","author":"吕本中","text":"日日思归未就归，只今行露已沾衣。\n江村过雨蓬麻乱，野水连天鹳鹤飞。\n尘务却嫌经意少，故人新更得书稀。\n鹿门纵隐犹多事，苦向人前说是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庞公","author":"吕本中","text":"卧龙雏凤不曾闲，举世皆危子独安。\n应念桥公无特操，晚将情话向曹瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卫青","author":"吕本中","text":"将军相继出天山，汉主吞胡意未阑。\n本自无心接宾客，故人犹有一任安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗三首 其一","author":"吕本中","text":"烹葵去王畿，剥枣在海角。\n岁序忽已周，月亦频告朔。\n向来手中扇，今此已倦捉。\n尚嫌簿领繁，不厌朋友数。\n尘埃向奔走，文字费雕琢。\n途人有前知，子乃独未觉。\n出门见大路，夫子焉不学。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗三首 其二","author":"吕本中","text":"结发在简编，俗事方刺促。\n往来三十年，未见可栖宿。\n微官不能去，尚恐遭逼逐。\n归栖则在念，所望一枝足。\n频蒙故人误，岂有邻可卜。\n出门虽无车，径自骑黄鹄。\n重寻置锥地，青灯一盂粥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗三首 其三","author":"吕本中","text":"饥蚊青而化，怒目虬两须。\n黄昏与我遇，且复少踟蹰。\n肌肤恣啖齧，熟视不可驱。\n中宵盛徒党，意气若有馀。\n伤哉陷阱虎，有时被囚拘。\n求食至摇尾，曾此蚊不如。\n云龙困蝼蚁，此语不可诬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日三首 其一","author":"吕本中","text":"诸卿谈笑赏先登，我欲从之病不能。\n门闭日长公事少，祇疑身是住庵僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日三首 其二","author":"吕本中","text":"尘满文书灯暗檠，荒城相望数残更。\n莫言愁罢无佳处，睡正熟时闻雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日三首 其三","author":"吕本中","text":"往来奔走看渠忙，疾病低回却未妨。\n唤客不须嫌酒恶，隔墙时喜送橙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"橙二首 其一","author":"吕本中","text":"西风吹雁欲斜行，小槛寒花却未香。\n将谓诸公频载酒，枉留橙菊十分黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"橙二首 其二","author":"吕本中","text":"不辞玉露著新行，漫作人间彻骨香。\n知道输棋偿旧约，故留残菊一时黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄京师亲旧","author":"吕本中","text":"屋头橙实如李梅，庭下葵花深覆杯。\n豆田失雨不称意，野菊出苗虚见猜。\n故人相望一尊酒，问我此住何时回。\n江山空自污敲扑，笔砚洗复生尘埃。\n交情自惜少同调，人事只今多好乖。\n欲随明月觅公处，限以白浪摇长淮。\n舟楫误逢蛟鳄横，岁月苦遭霜露催。\n侧身西望莫回首，堂上书生心已灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和成士瑴鹿女泉诗","author":"吕本中","text":"成子东游十日程，驼裘颠倒帽攲倾。\n新诗顿数神仙事，病耳忽闻京洛声。\n去住闲经几尘刹，往来相望一牛鸣。\n再寻六月山前路，分我寒泉数勺清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春申君","author":"吕本中","text":"少年谈笑解秦兵，便欲连从却未成。\n莫谓江东可长保，暮年无意引朱英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日三首 其一","author":"吕本中","text":"罢马厌鞭策，征鸿思稻粱。\n终年在泥土，永路困风霜。\n慎勿鞍鞯爱，直须矰缴防。\n吾衰亦已甚，念尔不能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日三首 其二","author":"吕本中","text":"交游大半死，吾亦老相侵。\n古木十围大，寒泉百尺深。\n恨犹能切骨，愁或至伤心。\n寄语南飞雁，君无笑苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日三首 其三","author":"吕本中","text":"狱掾酸寒极，官曹冗长催。\n真同鹤久住，不学雁轻回。\n妇女能相笑，儿童忍见猜。\n犹怜旧耆老，时有一书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和成士瑴海安道中见寄","author":"吕本中","text":"成侯老更懒，处世一虚舟。\n暂脱尘埃梦，还寻江海秋。\n从来仙圣宅，不数凤麟洲。\n有意相随否，因公更一游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送虞澹季然之官京师","author":"吕本中","text":"车如鸡栖马如狗，劝君莫美循墙走。\n车如流水马如龙，不如还家行御风。\n以尻为轮神为马，世人计出车马下。\n出门险阻道里远，只今谁是能行者。\n海陵事剧俸则薄，得公相从亦不恶。\n小吏相欺官长怒，我自作烦公笑乐。\n庾公故是丰年玉，道貌更自见不足。\n断崖独立老松柏，青天何处飞鸿鹄。\n汴堤六月尘自障，请公登高更南望。\n马烦车怠早归来，且从夫子濠梁上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵病中 其二","author":"吕本中","text":"先生高卧了残冬，我亦年来不讳穷。\n夜半打窗人不会，满天风雨角声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵病中 其三","author":"吕本中","text":"客游历历都如梦，身事悠悠略似僧。\n只么随缘作官去，不知从古更谁曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵病中 其四","author":"吕本中","text":"往来车马闹泥涂，一室萧然百事无。\n语默二途俱不涉，不劳辛苦对文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵病中 其五","author":"吕本中","text":"久谙罢卧懒呼医，剩读文书不疗饥。\n数有故人来问疾，更烦耆旧与传诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季叔友贺尧明登第叔友丹阳人也本中得其人之详于王尧明恨未之识也尧明擢第叔友作诗贺之尧明令继作既喜叔友能不妄许可又嘉尧明进退取舍皆中乎道也三首 其一","author":"吕本中","text":"柴桑无复陶元亮，谷口虚传郑子真。\n二子风流知有在，且留馀味及吾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季叔友贺尧明登第叔友丹阳人也本中得其人之详于王尧明恨未之识也尧明擢第叔友作诗贺之尧明令继作既喜叔友能不妄许可又嘉尧明进退取舍皆中乎道也三首 其二","author":"吕本中","text":"澄江虽近不容亲，亦是人间可喜人。\n枯木岩前有岐路，一杯浊酒自成春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季叔友贺尧明登第叔友丹阳人也本中得其人之详于王尧明恨未之识也尧明擢第叔友作诗贺之尧明令继作既喜叔友能不妄许可又嘉尧明进退取舍皆中乎道也三首 其三","author":"吕本中","text":"二子深居笔吐虹，从来节气万夫雄。\n欲知圣主求贤意，不为相如词赋工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明见和因及李萧远五诗 其一","author":"吕本中","text":"小阁才堪置一床，病躯虽在鬓沧浪。\n随身行李无长剑，犹胜堆钱与窟郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明见和因及李萧远五诗 其二","author":"吕本中","text":"交游潦倒漫虚名，误结他生文字盟。\n踏尽尘埃公莫厌，不应因酒爱江清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明见和因及李萧远五诗 其三","author":"吕本中","text":"故人飘散各穷途，诸老交情却未疏。\n赖有清诗在书案，时时翻读伴更初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明见和因及李萧远五诗 其四","author":"吕本中","text":"万里星河指顾间，此中何自著江山。\n精金百鍊终无用，才与佳人照指镮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明见和因及李萧远五诗 其五","author":"吕本中","text":"阮公游宦喜东平，贺监从来忆四明。\n但得从容饱粗粝，不须辛苦辨肴鲭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西归舟中怀通泰诸君","author":"吕本中","text":"一双一只路傍堠，乍有乍无天际星。\n乱叶入船侵破衲，疾风吹水拥枯萍。\n山林何谢难方驾，诗语曹刘可乞灵。\n酒碗茶瓯俱不厌，为公醉倒为公醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄马巨济察院时监泰州酒得宫祠归南京","author":"吕本中","text":"新春款南园，积雨寒不歇。\n起望海陵城，幸未还往缺。\n闻公得安还，未放车轨折。\n毫端倒江海，胸次湛明月。\n东风片帆来，乃复为此别。\n田园到荒芜，岁事有曲折。\n不见南山松，高卧拥霜雪。\n鬓髯凛可畏，此岂念容悦。\n愿公考其然，一向鼻头说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵十弟","author":"吕本中","text":"十年流落各西东，再见初非旧阿蒙。\n晋邑自思栾孺子，鲁儒空望叔孙通。\n宦情潦倒三荒径，世味衰颓一秃翁。\n石室度筹吾岂敢，且看鲜健胜庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叔度季明学问甚勤而求于余甚重其将必有所成也因作两诗寄之 其一","author":"吕本中","text":"两章后来秀，头角固崭然。\n但语强弩末，不争驽马先。\n寓言有十九，曲礼至三千。\n所要在守节，末言能与权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叔度季明学问甚勤而求于余甚重其将必有所成也因作两诗寄之 其二","author":"吕本中","text":"念我少年日，结交皆老苍。\n曹南见颜石，甬上拜饶汪。\n敢幸江海浸，得沾藜藿肠。\n诸郎但勉力，馀事及文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与季宏子植同过信中饮薜荔亭下夜分乃散别后奉怀遂成长韵","author":"吕本中","text":"残花无言卧风雨，小亭寂寞延初暑。\n范侯置酒呼我来，共坐阶前洗尘土。\n坐间问有李与韩，文字峥嵘各奇古。\n起卧逡巡失杯杓，笑语澜翻杂歌舞。\n满城车马閧侵淫，谁解墙阴着樽俎。\n薜荔扶疏出枝叶，老气横空君一吐。\n人生此会不可常，昔者各在天一方。\n簿书相急如探汤，好风吹我来君旁。\n莺啼燕乳各自忙，明日酒醒空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日呈颜夷仲","author":"吕本中","text":"老去身已衰，事过意愈懒。\n斯人未寂寞，吾此归亦晚。\n疏篱带落叶，秋色忽已满。\n南窗可炙背，唤妇同茗盌。\n旧读无新功，亦复费编纂。\n凝尘乱朱墨，妙句折编简。\n往者荷蓧翁，实具世外眼。\n不能与之游，只有兴尽返。\n曹南二三老，夙昔荷推挽。\n平生万卷书，未尽一日款。\n微词绝端兆，自怪识者罕。\n愿闻片言佳，庶用收褊短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢任伯夫人挽诗","author":"吕本中","text":"幽兰在深山，无人终自芳。\n岂伊桃李颜，取媚少年肠。\n高氏有潜德，奕世被辉光。\n自其父祖来，低首不肯昂。\n夫人生既贤，岂止秀闺房。\n出身事夫子，和鸣更锵锵。\n笙镛列两序，圭币罗中堂。\n云何去日远，遂弃凌风翔。\n伋也奉慈训，将见久必昌。\n瞻彼汝南路，松柏泣新霜。\n凄然马鬣封，千岁终不亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠笔工安伋","author":"吕本中","text":"昔人三年学屠龙，技成不试身已穷。\n安生不愿洴澼封，嗜好乃与屠龙同。\n使世淬砺磨其锋，侧出逆曳求新功。\n伋也中立无适从，随所欲用吾能供。\n歙溪孕石南山松，四方万里时一逢。\n病夫乍闲百念空，败毫破管尘埃蒙。\n明窗净几聊从容，眼无列宿罗心胸。\n使汝得见文章公，展卷略书吾已慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄共诚贾秀才","author":"吕本中","text":"万里归来四壁空，旧游浑在默然中。\n明年我欲江南去，何处留诗可寄公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题大名官舍","author":"吕本中","text":"宿昔尚残暑，晚风吹欲无。\n不知留此住，更白几茎须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日即事四首 其一","author":"吕本中","text":"瓦炉香烬欲凝尘，小槛黄花更一新。\n络纬戒寒鸠唤雨，世间那有自由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日即事四首 其二","author":"吕本中","text":"鬓发苍然雪欲垂，问君何苦读书为。\n旁人不会回头意，犹记田光盛壮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日即事四首 其三","author":"吕本中","text":"簿书尘土乱蒙茸，无复江船万里风。\n卧听秋声满檐溜，不知墙下有梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日即事四首 其四","author":"吕本中","text":"何处螳螂欲捕蝉，主人初未觉鸣弦。\n稍知东里能堪事，一任神龙斗洧渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰月九日","author":"吕本中","text":"疏林渺渺下新霜，留得黄花小槛香。\n莫道穷秋少风味，一时顿有两重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"恶木","author":"吕本中","text":"恶木不忍伐，留我窗户前。\n人皆笑我拙，我独为汝贤。\n共生天地间，谁不愿长年。\n如何枝叶内，便纵斤斧穿。\n人或甚于斯，同被恩爱缠。\n燕昭与汉武，所享固已偏。\n乐极未肯休，更欲求神仙。\n孰能以此心，扩为无尽泉。\n大哉周文王，尚结枯胔缘。\n伤生有禁止，亦具月令篇。\n好木虽云好，不须公爱怜。\n恶木虽云恶，莫自生雠冤。\n岁晏霜雪稳，夏深雷雨颠。\n扶疏有震落，与公常晏然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上二首 其一","author":"吕本中","text":"南山稍疏阔，病眼不能明。\n月挟清霜下，风随细浪行。\n未蒙青鸟信，虚负白鸥盟。\n不见台城路，年年春草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上二首 其二","author":"吕本中","text":"甚欲从此去，作烦渠未休。\n风期竹万个，活业橘千头。\n汉水觅二老，青门寻故侯。\n情知作寒士，不解杀袁刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄外弟蔡明善","author":"吕本中","text":"相见还须未白头，只今君是富春秋。\n莺花与梦飞腾去，甲子如川日夜流。\n白酒可浇千卷读，青山欲唤十年愁。\n无因早办归耕计，更就深公买沃洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜","author":"吕本中","text":"鸣鸠唤雨入西楼，草树虫声旋作秋。\n明月自如常夜好，晚山仍发去年愁。\n久抛诗酒寻思去，胜与儿童作队游。\n辜负禅心多少事，石城看渡木兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蛇","author":"吕本中","text":"山云楼起风旋磨，百毒乘阴出相贺。\n中庭夜夜蛇作堆，草堂病夫愁欲破。\n时须兵子设符咒，更遣狸奴旁坐卧。\n虽非当道白帝子，恐是多年老书佐。\n蛟龙变化未可量，草莽连岗足逋播。\n农夫催租正苦辛，莫向零陵作奇货。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢新酒螃蟹","author":"吕本中","text":"提壶满送小槽春，尖团未霜亦可人。\n略借毕郎左右手，为公一洗庾公尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄诸子","author":"吕本中","text":"南国旱愈甚，西郊雨复休。\n蝇蛆作残暑，蛙黾斗清秋。\n草暗黄沙尽，风吹白日愁。\n祇应有相忆，时倚仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘水","author":"吕本中","text":"湘水一番竹，下有千亩阴。\n宁知竹上泪，是妾一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顷与知止相别于曹州西门外盖今十四年矣闻尝自澶渊过此感叹","author":"吕本中","text":"昔别是兹土，今游还偶然。\n似闻尝少憩，犹自未真传。\n所过有陈迹，相逢多少年。\n长涂守病马，何敢更争先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双庙","author":"吕本中","text":"唐四叶孙德下衰，久厌坐稳思奔驰。\n外由骄胡内艳妻，杨李气燄相夺移。\n太宗之业甚整齐，尔曹忽来撞㨋之。\n旁人为之掩涕悲，处之甚安渠不疑。\n贼风忽来吹白陂，翠舆走避弯弓追。\n倒立却视千熊罴，猛将不解河北围。\n睢阳失守东南危，城中月馀析骨炊。\n两公奋髯死不回，鼎镬在前惟恐迟。\n蜀中消息未可期，此辈未易折箠笞。\n念公不量势力微，本自不辱国士知。\n大厦又非一木支，何必感慨如此为。\n往时开元全盛时，公胡不念鲈鱼归，亦不往吊湘江累。\n死后声名何足奇，商山老人吾所归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归自成园","author":"吕本中","text":"新春今几时，忽有檐外朵。\n病眼久不明，念此岁月颇。\n桥南数亩园，风雨与关锁。\n主人厌敲门，荆棘生道左。\n还家续残章，妙句仍帖妥。\n虽无炉锤工，亦有盘礴裸。\n归帆渺江湖，宿疾眩风火。\n扶犁伴老农，此语当自我。\n君看乡闾斗，则有闭户可。\n慎无学春蚕，作茧自缠裹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与诸舍弟游董村","author":"吕本中","text":"来往无十里，颇能妨昼眠。\n疏篱董村水，远树洛城烟。\n酒薄诗牵强，身闲病接连。\n荒田点残雪，知在甬山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见信民旧书有感","author":"吕本中","text":"蜗涏狼籍阁残书，仿佛黄公旧酒垆。\n试问东山谢安石，不知能似此人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]