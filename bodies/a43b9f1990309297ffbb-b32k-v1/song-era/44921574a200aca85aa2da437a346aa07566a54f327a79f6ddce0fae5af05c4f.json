[{"title":"送外","author":"龙辅","text":"榜人㰕舟待，催饭送郎行。\n独谙郎食性，厨下自调羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外","author":"龙辅","text":"绿柳千条映远空，郎君欲别思忡忡。\n愿得化为江上水，与郎直到赤门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外 其二","author":"龙辅","text":"君言游宦向华京，不得临歧一送行。\n行行惟有杨花路，飞去飞来是妾情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏闺","author":"龙辅","text":"日斜未理妆，昼长人易倦。\n回扑砚上蝇，墨花溅团扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓景","author":"龙辅","text":"春日映朝霞，新妆出绛纱。\n开帘惊宿鸟，倚树落危花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"龙辅","text":"绣窗同刺绣，女伴喜天晴。\n剪刀当日暖，妆镜隐霜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"龙辅","text":"情弱抽思长，腕娇运笔拙。\n口诵恐易忘，笺书还自裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄外","author":"龙辅","text":"面约随时改，离情睹物含。\n君风愁少女，妾卉最宜男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄外用前韵","author":"龙辅","text":"未得相携约尚空，小笺一见一忡忡。\n妾意原非渌江水，无端只向画桥东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄外读书处","author":"龙辅","text":"主人之室隔清洲，日日华笺空自酬。\n书似岘碑看即泪，人非萱草遇还愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄怀 其二","author":"龙辅","text":"何处最难禁，思君直至今。\n双鱼浮水面，对鸟下庭心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答外","author":"龙辅","text":"君信问平安，闺中差可欢。\n竹佳连露倚，云好下阶看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答外","author":"龙辅","text":"金徽只自秘，玉匣不曾开。\n梅花难独弄，袖手待郎来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答外","author":"龙辅","text":"郎书来问近何如，性癖如郎只似初。\n忍冷临风因爱雪，抱疴点烛为看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起","author":"龙辅","text":"下帏恣午睡，怪杀鸟相呼。\n起来慵刺绣，窗下理菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮闺","author":"龙辅","text":"暮闺翘首觉愁添，凿壁书生隔翠烟。\n独向嫦娥再三拜，殷勤为我到郎边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠外","author":"龙辅","text":"远别当霜雪，留郎且过冬。\n只愁春色里，离恨更重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"镜","author":"龙辅","text":"徐淑古铜镜，背多青绿花。\n收藏敢轻慢，曾得照秦嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄怀 其一","author":"龙辅","text":"莫怪书频断，难传恨万端。\n虽承结发爱，难作比肩看。\n泪续笺恒湿，思长笔屡乾。\n临封沾臂血，使识寸心丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题书斋","author":"龙辅","text":"深闺渐老大，始学谢娘诗。\n描笔题成句，良人事作师。\n白头惭卓女，团扇愧班姬。\n岂敢传千载，聊将遣一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又为子夜歌","author":"龙辅","text":"明朝将解缆，叮嘱不曾离。\n文无识顷刻，不久便当归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中寄外 其六","author":"龙辅","text":"脚下绣宫鞋，殷勤为郎做。\n今日贪看山，凤头半已破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中寄外 其一","author":"龙辅","text":"泊舟古岸傍，松柏日已煦。\n本非同心期，空似西陵路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中寄外 其八","author":"龙辅","text":"山中白日暗，霏霏云雨动。\n信此非巫山，安能入郎梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中寄外 其三","author":"龙辅","text":"一到空山下，回看远俗尘。\n松枝堪作麈，无计赠情人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀","author":"龙辅","text":"藁砧不可期，莲子空相托。\n欲寄一封书，惟愁被姑觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其一","author":"龙辅","text":"风吹花香薰洞房，白日照镜光射梁。\n后园草暖双蝶晒，堂前尘落对燕翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外 其一","author":"龙辅","text":"与君非一身，同户恒相忆。\n而况出门去，宁知南复北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲子诗比成自觉丑甚戏题此作以解发君一笑耳","author":"龙辅","text":"书罢题钟字，要君知妾心。\n虽然非白雪，却是重黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲子寄外","author":"龙辅","text":"莲房新摘袖中携，剖寄青青子数枚。\n若识心头最清净，莫嫌根脚本污泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"龙辅","text":"阶下莓苔烂熳，墙边竹色萧疏。\n彩凤绣来有恨，疏鸿读外无书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 题滕王阁","author":"龙紫蓬","text":"雨帘云栋重寻处，青红半空飞去。\n槛影侵鸥，檐光送雁，摇荡秋容千里。\n歌珠舞翠。\n怎禁得无情，一江流水。\n可是西山，半眉新绿向人觑。\n千年留下胜赏，尽登临无限，须付才思。\n坏堞闲愁，危樯往恨，欲拍阑干无路。\n新碑旧记。\n更今古匆匆，一番兴废。\n立尽斜阳，共谁评半语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆旧游 题南楼","author":"龙端是","text":"问南楼月色，十载相疏，何似今宵。\n旧雨菰蒲国，想波光雁影，远撼沅潇。\n拟苏堤上杨柳，烟碧为谁摇。\n叹庾扇尘深，胡床梦浅，翠减香销。\n迢迢。\n谩回首，记酹酒江山，曾共金镳。\n暮色沈西垒，几狂朋来往，舟叶招招。\n浩歌拍手归去，风月两长桥。\n算此会何时，刘郎去后多嫩桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池荷","author":"乔行简","text":"萱草轩窗处处幽，酒中不著客中愁。\n芭蕉叶上无多雨，分与池荷一半秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游三丘山","author":"乔行简","text":"疑是乘风到九天，不知身在此山巅。\n万家攒簇炊烟底，一水萦纡去鸟边。\n便觉尘缘轻似羽，何妨诗意涌如泉。\n停杯更待林梢月，归去家僮想未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中兴寺环翠阁","author":"乔梦符","text":"□尽烟波阔，风多客袂凉。\n清谈饶有致，白日不知长。\n麦陇高低熟，缫车哑轧忙。\n归来犹怪早，人影在斜阳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鼠莽草","author":"乔梦符","text":"闻有一草名鼠莽，食之随死不可医。\n非惟自己受毒烈，辄使妻儿常号悲。\n本图将此报私忿，不知官府诚难欺。\n人生乐国岂易得，轻命如此何愚痴。\n县令惭无功及民，徒有勤恳形诸辞。\n后来有问谁为此，但道东阳田家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平江守祷晴即应时近元夕矣寄呈五绝句 其一","author":"仲并","text":"丹邱雨里看春回，密雾浓云拨不开。\n怪底寒窗烘晓日，朱轓亲祷梵宫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平江守祷晴即应时近元夕矣寄呈五绝句 其三","author":"仲并","text":"梅经多雨玉飘零，就有残枝困未醒。\n安得吴侬不歌舞，满畦扶起麦青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平江守祷晴即应时近元夕矣寄呈五绝句 其五","author":"仲并","text":"安排灯火作鳌头，人乐公来再有秋。\n转雨作晴谈笑事，他州谁得似吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平江守祷晴即应时近元夕矣寄呈五绝句 其二","author":"仲并","text":"投晓家家笑语声，夜来风促雨如倾。\n都缘默祷胸中久，一瓣香焚唤得晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平江守祷晴即应时近元夕矣寄呈五绝句 其四","author":"仲并","text":"东风吹断雨如绳，一夜仍开曲沼冰。\n便试元宵强半月，孰知天意欲催灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过宜兴舟中见芍药数枝忆淮乡此花之盛为之怅然辄成三绝 其一","author":"仲并","text":"故眼相看未作疏，平生风味是吾庐。\n娉娉袅袅谁家子，浪说倾城总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过宜兴舟中见芍药数枝忆淮乡此花之盛为之怅然辄成三绝 其三","author":"仲并","text":"却是溪头消息真，故园十载漫风尘。\n如今不问黄楼子，浅白轻红自可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过宜兴舟中见芍药数枝忆淮乡此花之盛为之怅然辄成三绝 其二","author":"仲并","text":"少时暮暮复朝朝，一水相望恨未消。\n岸曲横舟试回首，隔帘斜立数妖娆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有客来从阳羡闻元绩离家已月馀由昆山过临安桐庐计今合归矣元绩当不惜迂路一访仆于苕霅间也戏为一绝招之元绩纯孝人每在道念亲殊切","author":"仲并","text":"风露侵人曷往哉，白云飞处棹徘徊。\n平时识面尽经过，莫为茅檐偏不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵病起二首 其二","author":"仲并","text":"闻道车书未一家，平时苦苦念京华。\n新来忽得幽居味，竹屋茅檐政自嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵病起二首 其一","author":"仲并","text":"不妨佳句太频频，还得愁中眼渐明。\n好是维摩病初醒，又将口业起纷争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵耿荐可催菊三首 其三","author":"仲并","text":"年来花意亦难猜，陶令东篱独未开。\n伴赋落英吾岂敢，狂言聊复为君催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵耿荐可催菊三首 其二","author":"仲并","text":"衔杯采菊久寻医，白发苍颜渐可期。\n准拟新来强作意，又从愁里过花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵耿荐可催菊三首 其一","author":"仲并","text":"黄花应自惜离披，欲放清香故故迟。\n病客高眠防不肯，剩裁好语报花知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芜城","author":"仲并","text":"莺歌燕语戏晴晖，日暮行人缓缓归。\n十里芜城春色晚，回头往事已全非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜抵德清县偶题","author":"仲并","text":"溪山夺目壮哉县，风露侵肌老矣身。\n断岸横舟偏得月，小桥曳杖不逢人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其十","author":"仲并","text":"裁剪群英荷化工，閒中无计答春风。\n自锄花径平如掌，要使荆榛一扫空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其九","author":"仲并","text":"燕羽差池何处归，衔恩春傍主人飞。\n定须借与一巢稳，十载飘零事事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其八","author":"仲并","text":"门外烟花看不厌，东风故为客开帘。\n如今乐极思畴昔，长是春深未解严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其七","author":"仲并","text":"锦带吴钩轻薄儿，三三五五竞花时。\n太平乐事从谁得，费尽经纶尔不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其六","author":"仲并","text":"春服何当咏舞雩，凤池今是鲁真儒。\n向令未解边城戍，能对东风一笑无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其五","author":"仲并","text":"花径风来百样香，捲帘春水绿池塘。\n如今万事销磨尽，四卷楞伽味最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其四","author":"仲并","text":"枉费花工著意催，漫山桃李总非材。\n要令千古芬香在，能作和羹自有梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满趋朝留滞吴门即事书怀十首 其三","author":"仲并","text":"小楼巀嶭乱山横，独倚朱栏度晚晴。\n忽听如簧语音好，祗缘高处最宜莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27331,"sha256":"18413bf73b9d113baa963a979