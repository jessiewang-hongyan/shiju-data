[{"title":"减字木兰花 其十一","author":"王观","text":"春光景媚。\n花褪残红炎天气。\n蝉噪高枝。\n雁叫长空雪乱飞。\n四时如箭。\n八节忙忙频改换。\n满捧金彝。\n祝寿如同海岳齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其七","author":"王观","text":"角声三品。\n银漏更残将欲尽。\n盏遍华筵。\n玉粒琼瓯散又圆。\n知君洪量。\n不用推辞须一上。\n满劝殷勤。\n祝寿如同福禄星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其十二","author":"王观","text":"才鸣□鼓。\n曲奏仙音如乐府。\n美似梨园。\n一派箫韶列玳筵。\n使人清耳。\n满尘宾朋皆欢喜。\n劝饮金荷。\n祝寿延长福更多。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"王观","text":"天之美禄。\n会饮思量平生福。\n一硕刘伶，五斗将来且解酲。\n百年长醉。\n三万六千能几日。\n劝饮瑶觞。\n祝寿不如岁月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其九","author":"王观","text":"百年能几。\n似数巡环无了日。\n有限时光。\n玉兔金乌晓夜忙。\n幸逢清世。\n最好排筵斟绿蚁。\n满捧金蕉。\n祝寿如松永不凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其五","author":"王观","text":"多愁早老。\n着甚由来闲烦恼。\n休管浮名。\n安乐身康似宝珍。\n酒逢知己，好向尊前朝日醉。\n满劝瑶觥。\n祝寿如山岁岁青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"王观","text":"三皇五帝。\n古代英雄闲争气。\n勇猛韩彭。\n十大功劳空有名。\n休谈人我。\n大限催煎如何亸。\n前酌觥船。\n祝寿如同海月圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其六","author":"王观","text":"今晨佳宴。\n昨夜南极星光现。\n鹤舞青霁，丹凤呈祥瑞气飘。\n仙书来诏。\n绿鬓朱颜长不老。\n满劝香醪。\n祝寿如云转转高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 拟太白应制","author":"王观","text":"宜春小苑。\n处处花开满。\n学得红妆红要浅。\n催上金车要看。\n君王曲宴瑶池。\n小舟掠水如飞。\n夺得锦标归去，匆匆不惜罗衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 应制","author":"王观","text":"黄金殿里。\n烛影双龙戏。\n劝得官家真个醉。\n进酒犹呼万岁。\n折旋舞彻伊州。\n君恩与整搔头。\n一夜御前宣住，六宫多少人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 归思","author":"王观","text":"单于吹落山头月。\n漫漫江上沙如雪。\n谁唱缕金衣。\n水寒船舫稀。\n芦花枫叶浦。\n忆抱琵琶语。\n身未发长沙。\n梦魂先到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北岩院","author":"王观国","text":"云岩乱石漱寒泉，通夕泉声到枕边。\n宛似昔年严濑口，五更风雨宿溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王观国","text":"雨昏兰芷湘君浦，烟锁沧浪渔父家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王过","text":"荔子雨晴红点点，葡萄江涨绿流流。\n梦魂不啻三千里，倦翮难胜九万风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王过","text":"危亭北据水南流，槛外频来海上舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王过","text":"心存北阙驰魂梦，身渐东归出鬼关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山郭检踏途中闻杜鹃","author":"王迈","text":"已成客里清明过，更听山深谢豹啼。\n衮衮春愁无处着，试拚一饮醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元宵观灯","author":"王迈","text":"元宵灯火出游敖，斗巧争妍照綵鳌。\n官府只知行乐好，谁知点点是民膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙子诏后需捷四绝 其二","author":"王迈","text":"促织墙阴唧唧吟，早催衣褐上寒砧。\n砧声似助蛩声切，勾引征夫万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙子诏后需捷四绝 其三","author":"王迈","text":"战罢归来月再盈，悬知得失系心旌。\n应门稚子占蛛信，刺绣佳人听鹊声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙子诏后需捷四绝 其一","author":"王迈","text":"一面飞来打叠秋，农场已筑管无忧。\n吾侬种殖三年学，未省书田还有收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙子诏后需捷四绝 其四","author":"王迈","text":"胜负相持日已多，看棋人已烂仙柯。\n淮淝非久捷书到，还折门前屐齿么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红蛛","author":"王迈","text":"空里游丝十丈长，直垂一颗绛纱囊。\n侬无喜事何须尔，往报槐花举子忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自赞善相","author":"王迈","text":"三分相士七分非，又似枯臞又似肥。\n好待功成名遂后，烦君只画着蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观风堂观丛刻","author":"王迈","text":"古碑真赝递相承，俗刻纷纷满笥縢。\n最是可怜越山石，不应只吊剡溪藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问邵武守刘无竞克逊求邵武红朱三首 其三","author":"王迈","text":"自怜凡骨本难仙，安得泥坛七返丹。\n欲使身轻生羽翼，乞丹须是问刘安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问邵武守刘无竞克逊求邵武红朱三首 其二","author":"王迈","text":"阅君吟稿日频哦，句法金镕字玉磋。\n自是集中多好处，从头点滴费朱多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问邵武守刘无竞克逊求邵武红朱三首 其一","author":"王迈","text":"见说归装只载书，书囊拍塞载红朱。\n不知滴露研磨剩，惠我刀圭点易无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"参部至三山简王宗教子文野二首仍寄观潮拙稿子文旧诗名为碧云楼集 其二","author":"王迈","text":"别来双鬓忽惊秋，一笑哦诗宽百忧。\n草舍绳枢聊尔尔，如何比得碧云楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"参部至三山简王宗教子文野二首仍寄观潮拙稿子文旧诗名为碧云楼集 其一","author":"王迈","text":"昔舣归舟傍浅沙，逢君跃马看梅花。\n匆匆相见还相别，三十六湾天一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和马伯庸尚书四绝句 其二","author":"王迈","text":"步障随车起暗尘，画罗难隔艳阳春。\n水边争羡春阳柳，一岁东风一岁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和马伯庸尚书四绝句 其一","author":"王迈","text":"晴澜金色漾琉璃，日落春风拍岸时。\n鸥鸟不惊人去远，掖垣南下树参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和马伯庸尚书四绝句 其四","author":"王迈","text":"丝丝垂柳拂金沟，学就宫娃舞态柔。\n莫遣落红飘一点，长门春色不禁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和马伯庸尚书四绝句 其三","author":"王迈","text":"玉泉山下水潺潺，不比温泉洗玉环。\n濯罢九龙池内锦，才教流出到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画工又作道装","author":"王迈","text":"扬州节钺非吾爱，肯要腰缠十万钱。\n只愿天公多与寿，道巾野服伴胎仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试五墨五首 其五","author":"王迈","text":"墨上署臣字，必曾经进来。\n一年磨一寸，须作墨中魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},