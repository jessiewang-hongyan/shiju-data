[{"title":"上故相留公 其一","author":"汪梦斗","text":"苍天有意不能违，行迈心摇赋黍离。\n弼既遭艰寻罢政，质如在位必迟疑。\n身逢今日多休问，事在当年偶少思。\n缘是庚申轻放入，力争不似甲辰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上故相留公 其二","author":"汪梦斗","text":"明伦一疏笔如椽，痛扫凶邪四海传。\n故使北人骑屋望，时闻南面独班宣。\n虽言上眷尤浓甚，只著前衔固怆然。\n旧日恩堂炊已熟，夕阳败柳奈号蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留示逯云甫秀才 其一","author":"汪梦斗","text":"万里舟车要觅诗，衰年忍负始来时。\n未成班氏两京赋，仅见韩山一片碑。\n归信正须传雁帛，秋风不为忆莼丝。\n今朝再渡桑乾水，月朗风清谁系思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留示逯云甫秀才 其二","author":"汪梦斗","text":"遗山诸老号儒宗，窃与余怀正不同。\n了得高吟犹小技，穷知实理是全功。\n生民皆本诗书出，宇宙元包性分中。\n来此无人同我意，拳拳望子革颓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"车出范阳界望太行已不见","author":"汪梦斗","text":"又别太行去，征衫浥泪班。\n仙游在北岳，骚兴满西山。\n世换碧如古，云收意似閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雄州回阳柳在城南郝庄有碑","author":"汪梦斗","text":"败柳能消药一圆，鹅黄袅袅复春妍。\n世间真有回阳事，却道枯骸不解仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日车行风寒","author":"汪梦斗","text":"不奈凄风透敝裘，高眠车上被蒙头。\n自怜病骨生来弱，莫恨客途寒可忧。\n雅操素持四不出，狂吟且和二宜休。\n家乡才喜清无暑，露下芙蓉一院秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贝丘道中看王莽所塞黄河旧迹","author":"汪梦斗","text":"从来四渎各入海，底事黄河今乱淮。\n新莽智欲出神禹，坐令四渎名实乖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东平道中追思来途","author":"汪梦斗","text":"去时薰入五弦琴，汶上繁阴暑气清。\n寂寞荒村惊叶落，又驱双毂过龟阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日前一日过东平城中见卖糕有感","author":"汪梦斗","text":"猎猎霜飙飐菊枝，盘中粉饵趁时炊。\n承平节物今犹见，却忆刘郎旧欠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汶阳重九","author":"汪梦斗","text":"烧灯才了客天涯，秋过重阳未到家。\n自叹满梳搔白发，不堪好酒对黄花。\n折腰肯使羞元亮，落帽多应罪孟嘉。\n寂寞汶阳溪上路，寒风拂柳晚阴斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"济州至鲁桥镇即事","author":"汪梦斗","text":"过了潘郎一句诗，涂中风雨尚垂垂。\n少人耕处地最阔，多日阴时秋更悲。\n山向近来青淡淡，树因远看黑离离。\n鲁桥有水租船去，明眼先朝一片碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明发鲁桥镇舟行","author":"汪梦斗","text":"泗水阻小艇，孤汀恰水生。\n一炊云外熟，双棹雨中行。\n衣醭梅天润，蓬疏腊月清。\n江南稍有侣，鹊报晓来晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟次耿山喜霁","author":"汪梦斗","text":"晓来乘雨过留城，屈指徐州一百程。\n到得耿山程已半，云收特地放新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向晓风顺挂帆","author":"汪梦斗","text":"顽阴破处见秋空，十幅枯蒲饱晚风。\n惊得野凫连族起，蓼花两岸献生红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡中过彭城","author":"汪梦斗","text":"惊残晓梦语啾啾，频唤移篙看石头。\n已过徐州元不觉，依前不得上黄楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重题吕梁洪","author":"汪梦斗","text":"新安江最险，此险越艰难。\n乱石纷如错，涓流曲若环。\n危争分寸地，只在折旋间。\n何似平夷了，轻舟利往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜舟行晚发吕梁洪下近更馀到双沟","author":"汪梦斗","text":"荧起长庚落，霁空秋意宽。\n水光涵月白，霜气挟风寒。\n舟取北为近，川流泗最安。\n雁声重嘹唳，莫是夜将阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟过桃源至下流近申刻舟人欲取小清河出淮谓可省路四十里既入小清河乘潮亟行舟去如駃次早已至山阳","author":"汪梦斗","text":"前来不得由捷径，今日才能据要津。\n水趁晚潮势殊顺，岸陈秋绿迹相亲。\n因知客路无多日，喜到家时恰小春。\n晓绝淮流却扶杖，逢人便谓即乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"易舟泛邗沟有怀来涂","author":"汪梦斗","text":"过得淮来便是家，沿流草树尚芳华。\n幽燕回首黄云外，想见寒风舞雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"维扬见陈孝先制机辱授馆因呈小诗见意","author":"汪梦斗","text":"倦客秋帆归较迟，亦闻采藻鲁侯池。\n不烦下榻眠高士，宁复登楼卧小儿。\n病菊耐霜癯似我，寒风吹面鬓如丝。\n君非能出不能处，心事相同因得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈隆兴总管王都水友直 其一","author":"汪梦斗","text":"南朝旧名族，贵盛数诸王。\n亡国恨何极，馀生计尚长。\n风流豫章守，人物水曹郎。\n客里吟尤苦，秋江卧夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈隆兴总管王都水友直 其二","author":"汪梦斗","text":"当日凤台下，鹿鸣同著鞭。\n鱼龙既悬绝，鸡犬竟难仙。\n危叶愁霜病，寒花纷晚妍。\n幽窗论旧事，客抱固凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扬子桥","author":"汪梦斗","text":"又撑舴艋下邗沟，霁色横空宿雨收。\n已入伊娄河里去，来朝稳稳饭真州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡江至龙潭即事","author":"汪梦斗","text":"败芦衰柳落江隈，才见黄云接亩堆。\n舟趁澜狂斜入浦，帆因风饱不依桅。\n青山数阅世兴废，白鸟静窥人去来。\n地暖江南未吹雪，小春天气正寻梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹筱村店肆笔","author":"汪梦斗","text":"西望武昌东夏口，下窥铁瓮固依然。\n英雄争战几编史，狂客浮游一叶船。\n把酒临风怀古处，题诗记我过江年。\n谩言足迹半天下，未必诗名所在传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上宣副定甫十二韵","author":"汪梦斗","text":"建邺古都会，东南气势雄。\n宣流分汉使，礼乐有周公。\n自是通儒术，元非急治功。\n一江秋色外，九郡月明中。\n云泽遍田里，声华彻昊穹。\n藩方小盘薄，廊庙即舂容。\n力可安燕祚，学能传孔宗。\n经纶方寸起，勋德古人同。\n妄息五官寂，灵存万虑空。\n井寒那起浪，木静不惊风。\n定者心之主，行兮用以充。\n苍生望霖雨，宁久蛰泥龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送宗人熙甫入都","author":"汪梦斗","text":"栖栖我辈只如斯，壮矣如君百倍宜。\n若是胸襟合西豹，未应位置下丘迟。\n波涵雁影日欲落，霜净蝉枝风乱吹。\n一路尽皆怀古处，任城多有汉时碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登雨华台读马华国碑","author":"汪梦斗","text":"寒江如梦夕阳斜，休笑诸贤误晋家。\n雨打风吹碑已泐，英辞空自雨天华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈金陵教授陈宜之钺前进士三人居慈湖","author":"汪梦斗","text":"文物依然故燕园，扶持云是有师门。\n□花似醒醉夫梦，頖藻如招骚客魂。\n门户固缘太丘重，乡人素仰后山尊。\n曹溪一滴西江涨，欲乞开堂旧偈翻。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题乡友叶景星号洪堂因所居之村而名","author":"汪梦斗","text":"心胸欲闳肆，意气要恢张。\n力可弘吾道，方能大此堂。\n帘开容燕入，庭阔受花香。\n于以警为学，非惟志故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"当涂轿行口占","author":"汪梦斗","text":"笋舆咿轧乱山隈，拥鼻清吟当探梅。\n我已少知忧责少，人皆喜慰远乡回。\n树犹绿暗知霜薄，云渐红深欲雪来。\n自说江南好风景，江南尤更有奇才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南园歌伤吴履斋旧景","author":"汪梦斗","text":"寂寞南园今如此，主人一斥循州死。\n南园如此未足悲，宗周随歌黍离离。\n丞相当年坐黄阁，正是北兵渡荆鄂。\n不知宣阃有何功，却以钧轴逊狡童。\n丞相身谋固已失，坐此谋失亡人国。\n梅花岭外羁魂哀，蓟门降王亦再来。\n南园池馆不似旧，百花憔悴竹树瘦。\n不堪回首望钱塘，宫阙倾颓禁苑荒。\n鄙夫奸人如王蔡，又无惠卿才可爱。\n丞相有见非不长，而乃升之中书堂。\n我行南园泪雨下，不免寒心怒欲骂。\n不特要写平泉诗，更复要草连宫辞。\n呜呼吴丞相，手提双笔岩廊上。\n艺皇有训垂日星，非读书人毋用相。\n博饮好色不肖子，可以公台作边赏。\n履翁之计早出此，老骨不死椒花瘴。\n西湖一碧无片尘，南园花草千年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中晓行","author":"汪梦斗","text":"马上鸡声黄叶村，拥衾人卧闭柴门。\n征裘尘土休烦洗，留取灯前看涴痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁川道中口占","author":"汪梦斗","text":"缓兀吟鞍去，鞭长袖里垂。\n烟分村远近，水见地高卑。\n风紧鸟飞疾，川寒鱼上迟。\n拥炉坐残雪，久已数归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入丛山隘见雪","author":"汪梦斗","text":"天公有意相归程，晓起千峰照眼明。\n一白自能遮百丑，只疑风味太清生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇德道中","author":"汪梦斗","text":"忽忆西窗昼掩扉，却缘残照水边归。\n杜陵夔府坡南海，都似西窗此夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思家五首竹枝体 其一","author":"汪梦斗","text":"六旬馀父身长健，九十重亲发不华。\n高堂无人供滫瀡，如何游子不思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思家五首竹枝体 其二","author":"汪梦斗","text":"淮阴母家田未买，汾曲先庐屋已斜。\n人生墓宅颇关念，如何游子不思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思家五首竹枝体 其三","author":"汪梦斗","text":"妇挼草汁浴蚕子，婢炙松明治枲麻。\n东阡西陌要耕麦，如何游子不思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思家五首竹枝体 其四","author":"汪梦斗","text":"儿多废学自浇花，女近事人今抱牙。\n儿女长成忧失教，如何游子不思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思家五首竹枝体 其五","author":"汪梦斗","text":"荷净轩前水浮鸭，翠眉亭下柳藏鸦。\n亦要丁宁春照管，如何游子不思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋忠悯公送婿邢德昭归婺女诗后","author":"释自闲","text":"玉洁冰清五十六，北山草木亦含芳。\n自如胡李堪同传，璧合珠联有耿光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张天师正殿","author":"黄仲元","text":"至人学道师赤松，神姿逸气心芙蓉。\n手五明扇腰雌雄，凭空架铁超鸿濛。\n玉距痕深雕锼工，巨迹千古镇蜍峰。\n狂飓怒涛锁鱼龙，夜醒月凉水笙镛。\n骑吏无鞍鸾鹤从，朝侍玉堂朵云红。\n天乐隐隐声彻空，俗耳可闻不可逢。\n渺视齐州等蠛蠓，沧海有时扬尘风。\n独此琼馆留人封，神仙之说非梦梦。\n士民尸祝社稷同，椒醑鞠?瓜枣供。\n余非紫阳山人翁，若为诗之铭新宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋浦楼义训","author":"赵溍","text":"人生五马贵，岂直荣其身。\n千里民社寄，委任至不轻。\n西风塞枣红，边备最为急。\n军政无他长，事事须责实。\n公足以服众，谦足以来贤。\n善政培根本，宽民乃其先。\n人生皆有性，感动须诚悫。\n当知愚而神，勿以术笼络。\n夫人当壮岁，血气未易平。\n喜怒不可从，反而求诸心。\n赏罚国之权，毋以逞私欲。\n断者不可续，黥者亲族辱。\n忠孝关大节，清白守家传。\n汝看简册载，不以名利言。\n吾年七十馀，自觉犹矍铄。\n勉力报君恩，步步踏实着。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"焦山顽石偈","author":"赵溍","text":"丹石无光古刹存，芦沙渔鼓□朝昏。\n江淮门户天分合，日月轩窗海吐吞。\n山足半沉曾瘗鹤，云腰中断可呼猿。\n丁宁为我留佳处，茅屋三间护竹根。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄诗交顾梅山","author":"杨镇","text":"谁与吟翁气味同，松梢明月竹梢风。\n能诗多是穷人事，不到穷时诗不工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上秋感","author":"房元龙","text":"淘尽英雄气未平，西风触绪倍心惊。\n愁人发涌三千丈，国士胸吞十万兵。\n杜老裁诗多慷慨，祖生击楫自纵横。\n芙蓉摇落哀鸿切，无那滔滔日夜声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题马伏波像","author":"董烈","text":"眉目真如画，英姿迥不凡。\n识高能择主，功大不胜谗。\n马革忠何壮，壶头怒尚衔。\n谁甘骑款段，长服野人衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒朱夫子祠","author":"林天瑞","text":"天下有明月，人世苦昏昏。\n山色无今古，谷云常吐吞。\n微言谁与析，妙理独难论。\n万树秋风老，先生道自尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武夷即事","author":"林天瑞","text":"长卿非慢世，陶令已辞官。\n解组投莲社，逢人戴鹖冠。\n青天不可问，白发若为看。\n偶遇壶丘子，皈心授大丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"捣油翁","author":"陈谔","text":"忽遇深山避世翁，居然沮溺古人风。\n老来一出为身计，不满先生一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"襄鄂百咏","author":"陈谔","text":"久戍蕃兵已念家，将军何不奏胡家。\n今朝忽报严围解，白雪纷纷亦散花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怡堂","author":"刘祖尹","text":"结庐投老瞯群峰，隐隐松杉曲径通。\n剩种池边千纛竹，近营林下一巢风。\n攲眠尽绝春来梦，趺坐闲看月堕空。\n检点吾生诸事了，子孙更与护其终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复泸凯歌 其一","author":"梅应春","text":"重壁山前瑞色开，浮环夜渡捷骑来。\n一旗金鼓辕门晓，唤得满城生意回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复泸凯歌 其二","author":"梅应春","text":"休讶朝家奏报迟，平生忠孝鬼神知。\n但留一片丹心在，会有天回地转时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元兵俘至合沙诗寄仲子","author":"陈文龙","text":"斗垒孤危势不支，书生守志誓难移。\n自经沟渎非吾事，得死封疆是此时。\n须信累臣堪衅鼓，未闻烈士树降旗。\n一门百指沦胥北，惟有丹衷天地知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意五首 其一","author":"俞德邻","text":"迢迢长安道，古堠双复只。\n游子辞家去，去去何所适。\n素商昔转玄，朱羲今由白。\n悠悠世路艰，江湖虎豹宅。\n杨朱泣途穷，鲁叟悲麟获。\n愿言弛负担，归与慰岑寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意五首 其二","author":"俞德邻","text":"亹亹天上云，滔滔海中波。\n时哉不我与，况复未息戈。\n浮氛冒曾岭，君去将如何。\n君吟行路难，妾思扊扅歌。\n积忧傥心痗，采蕨南山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意五首 其三","author":"俞德邻","text":"悠悠君何之，茕茕妾影只。\n萧萧两鬓丝，寒衣不堪织。\n纵使堪织衣，练能成几尺。\n西窗暗雨鸣，孤灯耿复灭。\n君心如妾心，妾心匪木石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意五首 其四","author":"俞德邻","text":"皎皎天上月，辉光烛蓬门。\n蓬门亦何有，古镜堂上悬。\n妾心如古镜，磨尽明不昏。\n君心镜上尘，磨去不复存。\n猗嗟贱妾心，与君难具论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意五首 其五","author":"俞德邻","text":"忆妾初嫁时，感君涂蔇茨。\n嫁君未三载，君行河北陲。\n长庚耿天际，饭粟羹伏雌。\n君云去不远，五月当来归。\n闻君往从军，裘马事轻肥。\n蓬蒿没深巷，风露凄妾衣。\n夫君岂不念，将由道路逶。\n道路或孔迩，妾忧宁不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴郡斋遣怀","author":"俞德邻","text":"斋居苦无悰，散屧步芳圃。\n花柳度暖风，莓苔滋宿雨。\n叠嶂隐檐牙，幽禽哢林莽。\n池光瓦蔽亏，日气石吞吐。\n迥眺觌层城，狂歌隘天宇。\n倏欢景已流，俄思愁复聚。\n楚奏钟仪悲，越吟庄舄苦。\n人情异穷达，土思渺今古。\n信美非吾乡，归心属兰杜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龚圣予号翠岩晚岁更号岩翁为赋","author":"俞德邻","text":"春风桃李颜，岁寒松柏心。\n达人步大方，静爱无弦琴。\n无弦岂堪听，弦外多遗音。\n世涂甚风水，对面商与参。\n孤芳忌群处，散材辞众侵。\n霜降水归源，日旭星就阴。\n浮华剥落尽，古道谁复今。\n吾家雁山下，翠巘高千岑。\n清秋灏气塞，万里纤埃沈。\n安得与君去，结架聆清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居遣怀三首 其一","author":"俞德邻","text":"莓墙荫薜萝，中有一亩宅。\n花竹分四时，野鸟鸣格磔。\n浩歌引清觞，微风岸低帻。\n百骸任舒伸，一笑天地窄。\n剥啄谁叩门，门外有佳客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]