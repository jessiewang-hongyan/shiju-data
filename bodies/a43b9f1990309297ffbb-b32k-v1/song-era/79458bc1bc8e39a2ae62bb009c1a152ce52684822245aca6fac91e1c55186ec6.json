[{"title":"到淮南","author":"沈遘","text":"吴山已远见淮山，未觉风尘上客颜。\n家在沧浪重回首，彷徉且作半年闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏卢中甫钱才翁","author":"沈遘","text":"晴日春风花气浮，少年嬉逐满扬州。\n谁怜居士身常病，独坐空船理白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山光寺一首","author":"沈遘","text":"高台已倾曲池平，江都宫殿野草生。\n隋家事远不须问，淮南非复百年城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢太傅庙","author":"沈遘","text":"功业由来出偶然，晋师岂必胜苻坚。\n谢公更欲收民望，故筑新城坐自全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自扬州与中甫才翁偕行","author":"沈遘","text":"相遇得所好，相从如所期。\n平生慕朋友，形迹无牵羁。\n道路远千里，冬春踰再时。\n要将穷吾乐，勿厌行迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和才翁行次山阳","author":"沈遘","text":"滟滟春波绕廓回，飞花无数逐风埃。\n山阳旧客谁相识，尪病区区又到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甓社湖","author":"沈遘","text":"青天澹无云，白水平无波。\n拖舟镜中行，奈此清绝何。\n我行不自亟，三日才百里。\n卷卷何所感，似泛吴江水。\n湖水清无际，清极不可触。\n吾缨初自洁，将安濯吾足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和中甫新开湖","author":"沈遘","text":"渺渺清波百里浮，昔游曾是一扁舟。\n十年人事都如梦，犹识湖边旧客邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和中甫吕氏园亭","author":"沈遘","text":"长日阴阴雨与风，病夫高卧一舟中。\n少年欢气谁能遏，纵走名园看落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题扬州山光寺","author":"沈遘","text":"高台已倾池已平，隋家宫殿春草生。\n千年前事何足叹，淮南非复旧时城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五言出都","author":"沈遘","text":"十年中都官，未审去宫阙。\n一朝使万里，驿骑催早发。\n徘徊景阳道，瞻望未央闼。\n高城接浮云，佳气正蟠郁。\n我马何迟迟，中情屡如失。\n王事戒靡盬，臣心敢它恤。\n曷月还归哉，归期幸可必。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五言出都日大雪","author":"沈遘","text":"朔风万里来，一夜卷飞雪。\n漫漫国门路，转毂失故辙。\n鸟翼压不开，马蹄僵欲折。\n问我行安之，衔命使胡羯。\n君恩念勤远，敦遣礼无缺。\n赐金戒私装，卜日出汉节。\n太官载供张，厩马先简阅。\n光华自难胜，敢复诉劳苶。\n独哀徒御众，驱驰犯寒切。\n每怀实靡及，勖尔保嘉烈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五言陈桥驿","author":"沈遘","text":"天命岂人力，神功非智窥。\n艺祖昔臣周，周德久已衰。\n上将分六师，北征在郊圻。\n士卒中夜起，神器仓猝移。\n谁言一朝变，乃定万世基。\n国门一舍地，传舍犹当时。\n故老无复存，遗话嗟何知。\n维留威神在，凛然万方归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五言城北别亲友","author":"沈遘","text":"朝出北门道，后车何轰轰。\n顾皆我亲友，送我胡中行。\n置酒古寺堂，劝酌纷纵横。\n饮阑视四坐，悄若意弗平。\n试问坐上客，客言安敢承。\n谓我自慷慨，固无儿女情。\n幸当无事时，奚忽为北征。\n怜我不受辱，往拜单于营。\n忧我衰病馀，跋涉万里程。\n二者所不堪，奈何谁使令。\n我笑谓坐客，我岂徇利名。\n仕既不得已，王命方丁宁。\n上羞傅介子，下愧苏子卿。\n第结匈奴心，以保先帝盟。\n惓惓谢亲友，敢辞釂馀觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五言信武殿","author":"沈遘","text":"匈奴昔南牧，先帝躬濯征。\n旌旗从天下，龙虎百万兵。\n元臣坐帷幄，大将当鼓钲。\n黄盖临城楼，城下万岁声。\n卷起黄河波，飘入单于营。\n单于胆先破，犬羊乱纵横。\n大黄殪贤王，京观封鲵鲸。\n甘雨洗原野，清风扫膻腥。\n王师奏凯归，残胡稽颡盟。\n于今五十载，北塞维蚕耕。\n黎民亦何知，但见原庙成。\n下臣方奉使，过谒剽若惊。\n威神敢云测，尚冀通精诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五言道中见新月寄内","author":"沈遘","text":"离别始十日，已若十岁长。\n行行见新月，泪下不成行。\n念我一身出，万里使临湟。\n王命不得辞，上马犹慨慷。\n一日不见君，中怀始徊徨。\n我行朔方道，风沙杂冰霜。\n朱颜最先黧，绿发次第苍。\n腰带减旧围，衣巾散馀香。\n邮亭苦夜永，灯火寒无光。\n独歌使谁和，孤吟讵成章。\n辗转不得寐，感极还自伤。\n思君知何如，百语不一详。\n胡雁方南飞，玉音未可望。\n愿君爱玉体，日看庭树芳。\n欲知归期蚤，东风弄浮阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言烽火台二首 其一","author":"沈遘","text":"历历相望隐旧堆，狐穿兔穴半空摧。\n行人不识问野老，云是昔时烽火台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言烽火台二首 其二","author":"沈遘","text":"烽火销来五十年，居民初不识戈鋋。\n耕桑满野帝何力，千里边城自晏然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言老农问","author":"沈遘","text":"使者輶车岁不停，金缯兼载价连城。\n洛阳年少今何怯，未省传闻敢请缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言答老农","author":"沈遘","text":"圣主仁恩务息民，收兵方外卷威神。\n老农自保太平乐，焉用空言羞使臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言将至瀛州从事张祥寄诗和答","author":"沈遘","text":"驿骑驱驰万里身，锦貂浑欲变缁尘。\n平生未识行边地，今日初欣遇故人。\n洗眼已惊双鲤至，相看应讶二毛新。\n羡君独得从军乐，三岁高阳幕里宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言道中示三使二首 其一","author":"沈遘","text":"初持诏节下宫衙，四牡临门敢顾家。\n稍远郊畿还感慨，却瞻原隰自光华。\n使行万里谁非病，义重千钧始拜嘉。\n遥指燕山数归日，都城犹未有多花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言道中示三使二首 其二","author":"沈遘","text":"汉家恩信抚群戎，坐息边民乐岁丰。\n自古所求中国治，于今无复四夷功。\n金缯但取一州赋，使介何辞万里通。\n顾我衰羸岂堪此，共扬威命赖诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七言雄州遇唐子方奉使先还奉赠","author":"沈遘","text":"拥节才临塞北垣，正逢归骑下幽燕。\n昔初并命银台下，今独先还赭案前。\n胡地风沙辞异域，汉家日月望中天。\n边城尊酒虽云乐，闻说腥膻更惨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使还雄州曹使君夜会戏赠三首 其一","author":"沈遘","text":"风霜满面使胡归，洗眼看君喜可知。\n更出佳人对红烛，今宵醉倒欲何辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使还雄州曹使君夜会戏赠三首 其二","author":"沈遘","text":"法曲新声出禁坊，边城一听醉千觞。\n明朝便是南归客，已觉身飞日月傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使还雄州曹使君夜会戏赠三首 其三","author":"沈遘","text":"粉面娇环红绣裙，主翁独遣劝佳宾。\n它时金谷重相遇，还许尊前问故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发瓦桥十里而河梁败还坐客亭复上马戏咏道旁垂柳二首 其一","author":"沈遘","text":"客亭门外纤纤柳，解使行人去复还。\n为谢春风摇荡意，上林桃杏正堪攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发瓦桥十里而河梁败还坐客亭复上马戏咏道旁垂柳二首 其二","author":"沈遘","text":"行尽塘陂日已西，回头绿树却迟迟。\n柔条秀绝向人甚，忍不从容折一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过","author":"沈遘","text":"风沙敝尽旧狐裘，走马归来过冀州。\n闻报故人当邂逅，便临近馆为迟留。\n不容倾盖论时事，空寄新诗写客愁。\n却望后车尘已合，箫声清断去如流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至澶州遇吴长文谒告归奉赠","author":"沈遘","text":"万里风霜一病身，归来初喜渡河津。\n举头已近长安日，洗眼先逢玉署人。\n平昔每嫌疏馆舍，今兹暂许接车尘。\n延英对后应多暇，东阁期谁共赏春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还家自戏二首 其一","author":"沈遘","text":"忆昨边城初见春，纤纤垂柳正矜新。\n不知远客贪归意，欲把狂丝系画轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还家自戏二首 其二","author":"沈遘","text":"远客归来眼自明，小桃满院笑相迎。\n当时若折边城柳，定负春风薄行名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出都","author":"沈遘","text":"秋风归梦入东吴，乞得城居占越湖。\n圣主恩深未知报，岂如张翰为莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李审言","author":"沈遘","text":"使节葳蕤出汉宫，我方受瑞守江东。\n解还印绶甘元礼，霁去威严幸弱翁。\n金佩并辞丹屏下，画舲相接汴波中。\n过江弩矢应交路，敛避须如御史骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王平甫","author":"沈遘","text":"轻舟喜出大梁城，更得高才共载行。\n海内相知君与操，从容尊酒论平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漕舟","author":"沈遘","text":"漕舟上太仓，一钟且千金。\n太仓无陈积，漕舟来无极。\n畿兵已十万，三垂戍更多。\n庙堂方济师，将奈东南何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴河赠审言","author":"沈遘","text":"黄流千里从天来，中贯帝居萦斗魁。\n与君共宣圣主德，馀波渐暨东南垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平甫许诗未至还赠","author":"沈遘","text":"平生每愧不能诗，今与诗豪昼夜随。\n已许大篇须强和，少收锋锷始相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮阴侯庙","author":"沈遘","text":"淮阴本自市人子，始定三齐便请王。\n明哲保身非所责，如何终欲比张良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和平甫寄介甫羡会稽之行","author":"沈遘","text":"君家兄弟古人期，入直西垣已恨迟。\n莫羡迂疏乞州去，朝廷多事待论思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和平甫越州","author":"沈遘","text":"六朝开国尽东州，此地常居第一流。\n四海今皆归圣主，万兵犹得视元侯。\n江山执胜登临好，市邑空残赋役稠。\n我去正应千百虑，不知能复纵吟不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮山","author":"沈遘","text":"淮山万重紫，淮波千里清。\n聊兹快吾目，又以洁吾缨。\n夷门多尘埃，黄河自泥浊。\n我行何迟迟，回望未央阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至钱塘先寄施侍郎","author":"沈遘","text":"忆时送公公索诗，欲从公醉亦狂辞。\n今叨东镇恩方厚，更过邻城喜可知。\n已分尊前非敌量，独怜湖上失春期。\n江南地煖霜无力，橘绿莼丹蟹自肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送十二叔归巴陵","author":"沈遘","text":"读书不遇古所有，閒居得地今日稀。\n世故纷纷定难了，况独身已与众违。\n洞庭水清君山碧，白酒满市鱼满矶。\n都门一到十日耳，犹恨风尘污我衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至乐斋","author":"沈遘","text":"至人得至美，乃能游至乐。\n兹理难与言，纷纷徒尔学。\n五经陈纵横，夫岂非糟粕。\n吾方任常然，来者尚吾觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼寐","author":"沈遘","text":"衙退冠佩捐，吏休簿书却。\n山城宾客稀，永日卧高阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中乐","author":"沈遘","text":"谁言府中居，自得山中乐。\n独醉还自醒，无人事酬酢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鉴湖","author":"沈遘","text":"鉴湖千顷山四连，昔为大泽今平田。\n庸夫况可与虑始，万年之利一朝毁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"爱山","author":"沈遘","text":"朝凭秦望紫玉几，莫倚卧龙青锦屏。\n平生爱山今日足，尚恨轩冕萦吾形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和韩子华游赵氏园亭","author":"沈遘","text":"春色先从禁苑来，侯家次第竞池台。\n清明已近鞦韆动，上巳相寻曲水开。\n绣幕风微花自舞，金炉日永麝销灰。\n病夫欢意那能强，漫作山公倒载回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭州使郎中寄示怀旧之篇辄次韵奉酬","author":"沈遘","text":"昔下承明得善藩，初无佳政可胜残。\n与民共乐湖山好，遭世承平法制宽。\n当日清谈羞俗士，归来白发困尘鞍。\n羡君正逐春遨盛，岂减东州旧赏欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴会稽过杭州宝月大师法喜堂","author":"沈遘","text":"悠悠十年别，惚惚一梦中。\n故人已白发，相对一病翁。\n日短语不尽，潮生舟复东。\n自笑更自愧，此身犹飞蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴淮南再过萧山昭庆寺阇梨叔师所居","author":"沈遘","text":"始作山阴行，还寻广陵路。\n此身未许闲，长负沧洲趣。\n往来古寺居，再与高僧遇。\n俗虑虽暂空，劳生竟难诉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和杭州施正臣与李审言王道粹宴有美堂唱酬","author":"沈遘","text":"昔为邻政愧难参，今读新诗叹召南。\n美化由来称乐国，胜游还足发清谈。\n江山临眺乘秋霁，旌节联归卷夕岚。\n病客区区方北去，尚思堂下暂停骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和李审言见赠叙旧","author":"沈遘","text":"自与公家三世旧，坐看高闬压亨衢。\n楩楠屡构明堂厦，麟凤更参圣代符。\n结友固应皆以义，论诗何独取于愚。\n归舟早晚乘潮度，犹得西湖一笑无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和施正臣游圣果寺二首 其一","author":"沈遘","text":"盘崖绝巘与天通，汗漫烟霞谢世笼。\n耸起浮图山突兀，自然衙石玉青葱。\n古人兴废千年上，游客登临一啸中。\n谁为燕然愧班窦，弧城羁据亦铭功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和施正臣游圣果寺二首 其二","author":"沈遘","text":"长爱高僧住绝岑，定知无复俗缘侵。\n人生扰扰应从昔，世事悠悠岂独今。\n轩冕傥来真可愧，山林归去莫嫌深。\n孟轲事业谁能及，告子唯先不动心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠剡县桃源宫王道士","author":"沈遘","text":"我昔剡溪游，道人亦相遇。\n重来十岁馀，颜色宛如故。\n顾我病衰早，鬓毛已苍然。\n乃知世上荣，讵若山中闲。\n道人家东都，问胡不归北。\n北方多风尘，素衣化为黑。\n斯言吾所信，吾志亦江湖。\n潇洒会稽守，平生欣莫如。\n君恩容苟安，顾奉三年计。\n幸尔数到城，閒谈北方事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和不疑借书邻几遇其寝","author":"沈遘","text":"嗟我江湖人，野性实疏简。\n况从衰病侵，事事益以懒。\n岂不思自强，所资乃有限。\n但爱江夫子，平生事高散。\n维于读书动，昼夜不去眼。\n每劳从事贤，独使簿书绾。\n挥署曾不劳，兼人信无赧。\n有时倦欲休，就席初不煖。\n邻友更借书，丁丁叩门版。\n尤厌吏舍喧，牛羊閧棚栈。\n不如归吾庐，静对日晼晚。\n诗成还示我，足以惊幽孱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和冲卿中秋不见月","author":"沈遘","text":"木叶飘飘客正悲，浮云更起蔽朱曦。\n分无好月临清夜，且共芳樽乐盛时。\n密户那忧风荡烛，重帘宁怯露侵肌。\n金壶漏尽玉山倒，天外晴阴谁复知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝挽歌辞五首 其一","author":"沈遘","text":"正统千龄接，端朝四纪长。\n无为独高拱，博施极多方。\n昔也称何力，今焉怨彼苍。\n维应传圣嗣，有以慰民望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝挽歌辞五首 其二","author":"沈遘","text":"历数当兴运，讴歌属太平。\n成康能述业，文景善持盈。\n海外咸来献，区中不识兵。\n至仁终莫报，何以尽群情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝挽歌辞五首 其三","author":"沈遘","text":"欲识承平事，君王五十年。\n耕桑连万里，歌吹被三边。\n德至消群慝，恩深极漏泉。\n如何一朝变，群恸诉苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝挽歌辞五首 其四","author":"沈遘","text":"四海苍生众，真知不世逢。\n方将请巡幸，然后议登封。\n铸鼎未云就，乘云安所从。\n尤哀此下国，无路望髯龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行皇帝挽歌辞五首 其五","author":"沈遘","text":"西望陵台远，阴阴白日错。\n孤臣欲从死，累世未酬恩。\n身隔千官列，心随万国奔。\n维临沧海上，泣血就湔痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]