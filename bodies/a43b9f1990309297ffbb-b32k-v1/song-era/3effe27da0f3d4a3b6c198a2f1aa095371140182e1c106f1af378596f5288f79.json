[{"title":"戏答持烛之句依韵和永叔","author":"梅尧臣","text":"卢仝只有赤脚婢，吏部曾吟似笑仝。\n红烛射眸从结客，清歌帖耳苦怜翁。\n归时虽已过寒食，芳物犹能逐暖风。\n但点纱笼续清夜，西园游兴古何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早发大信口","author":"梅尧臣","text":"犬吠知船解，村墟尚闭门。\n霜泥黏缆尾，冰水阁潮痕。\n撇撇鸊鹈去，纤纤舴艋昏。\n梅湖到不远，寄信向田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早至颖上县","author":"梅尧臣","text":"夜发晓未止，独行淮水西。\n明知寒草露，暗湿瘦骢蹄。\n半灭竹林火，数闻茅屋鸡。\n秋天畏残暑，不为月光迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春田行","author":"梅尧臣","text":"风雪双羊路，梅花溪上村。\n鸟呼知木暖，云湿觉山昏。\n妇子来陂下，囊壶置树根。\n予非陶靖节，老去爱田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早梅","author":"梅尧臣","text":"江南近腊时，梅亚雪中枝。\n一夜欲开尽，百花犹未知。\n人心空共惜，天意不教迟。\n莫讶无秾艳，芳筵最好吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早渡长芦江","author":"梅尧臣","text":"带月出寒浦，残星浸水濆。\n帆开风色正，舟急浪花分。\n雾气横江白，鸡声隔岸闻。\n天晴建业近，钟岫起孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曲渚桥送张秘校赴庆州幕","author":"梅尧臣","text":"野客伐山桂，横为曲渚桥。\n势危宁过马，径狭欲通樵。\n小艇何妨系，离魂正此销。\n想君回首处，虹影在林椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱樱","author":"梅尧臣","text":"明珠摘木末，红露贮金盘。\n始见侍臣赐，已为黄雀残。\n味兼羊酪美，食厌楚梅酸。\n苑囿东周盛，累累映叶丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王景彝正月十六夜省宿过景灵街","author":"梅尧臣","text":"宫街不闭东城月，圆影才亏夜色春。\n自跃金羁来宿省，从他锦帐欲誇人。\n灯光远近疑争昼，歌韵高低竞起尘。\n我老都无游乐意，似君清枕睡侵晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和王景彝十四日冒雪晚归","author":"梅尧臣","text":"子猷多兴怜飞雪，向晚归时又见飘。\n拂马随人如著莫，舞空吹面亦胜消。\n闭门我作袁安睡，呵笔君为谢客谣。\n记取明朝朝谒去，毳裘重戴冷寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和长文社日禖祀出城","author":"梅尧臣","text":"晓出春风已摆条，应逢社伯马蹄骄。\n坛边宿雨微沾麦，水上残冰壅过桥。\n燕子飞来依约近，雁行归去试教调。\n北扉西掖多才思，相与飘飘在泬寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和长文禖祀郊外见寄并呈韩子华","author":"梅尧臣","text":"鹁鸪知雨在桑中，雄逐雌飞自不同。\n胡粉未生轻蝶白，燕脂先绽野樱红。\n高高树里鞦韆月，猎猎墙头蓓蕾风。\n晓下祠坛多寄咏，衣冠方侍大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和永叔","author":"梅尧臣","text":"省树高槐雪压条，沉沉古屋蔽疏寮。\n每嗟守印如枯木，欲弃明珠学纬萧。\n渐老但知贫贱乐，向来徒用岁时销。\n新年不管鱼龙跃，安得乘风入剡樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和永叔雨中寄原甫舍人","author":"梅尧臣","text":"赖得春巢燕未归，高檐终日雨衰衰。\n细笼芳草踏青后，欲打梨花寒食时。\n美景已嗟空过尽，名园犹许误相随。\n锦鞍切莫九衢去，拍拍一如鹅鸭池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和永叔退朝马上见寄兼呈子华原甫","author":"梅尧臣","text":"公归初退内朝班，驰道南头跃锦鞍。\n欲雨浮云犹复暗，背阴残雪愈生寒。\n穿槐已觉春禽语，载酒重思结客驩。\n吟寄侍臣知有意，翠鬟争唱口应乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和永叔原甫致斋集禧","author":"梅尧臣","text":"庙蚃灵祠属二公，齐心相望切朱宫。\n绿渠缭绕壖垣水，广沼清泠涨殿风。\n已咏应麟来五畤，仍歌翔雁杂殊翁。\n遥知毕事期寻胜，尚问衰羸未厌穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和永叔新岁书事见寄","author":"梅尧臣","text":"尖风细细欲穿帘，残雪微销冻结檐。\n盏里醇醪无限满，镜中白发不知添。\n妍童喜舞开罗幕，小吏愁凘入砚蟾。\n幸得从公持直笔，定应无复叹齑盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和玉汝对月见怀西轩","author":"梅尧臣","text":"坐见沙头月，复怜衣上辉。\n正如从我饮，还欲照君归。\n相逐影徒是，共嗟欢已非。\n夜深依岸落，寒色入伤违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和冲卿元日","author":"梅尧臣","text":"天心欲销变，元会罢来朝。\n新岁起今日，旧年犹昨宵。\n冻云低覆阙，残雪稍封条。\n又听驱傩鼓，群邪不可饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和吴长文舍人即事见寄","author":"梅尧臣","text":"莫问春风有后先，但逢佳处去扬鞭。\n桃花洞远迷应久，杏树坛荒迹自传。\n放与晓寒能几许，即看芳意不多偏。\n古来閒气争强弱，谩费黄金抛楚权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和吴仲庶舍人送德化郭尉","author":"梅尧臣","text":"蒲叶高帆十二幅，秋风逆水满樯开。\n是时不畏浪头起，到日定将船尾堆。\n用舍东方言虎鼠，贱疏梅福比蒿莱。\n少年才辨无如美，庐岳峰前莫滞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和吴冲卿伤何济川","author":"梅尧臣","text":"生爱虚名苦辩亡，沦精竭智可哀伤。\n谁将事附三公传，自有文誇古战场。\n坟土未乾还卜穴，挽声才绝又新章。\n是非从此方应定，弟子犹争左氏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和吴冲卿岁暮有怀","author":"梅尧臣","text":"旧历卷将尽，慨然增永怀。\n唯希步兵醉，莫作太常斋。\n孟浪从人笑，疏愚共世乖。\n定知当汨没，名不与功偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和吴季野题岳上人澄心亭","author":"梅尧臣","text":"空山旧径绿苔满，古寺斋盂白薤蒸。\n暑雨坐中飞漠漠，野泉林外落层层。\n从来胜绝皆离俗，未有幽深不属僧。\n唯爱溪头一寻水，莫闻流浪莫闻澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和表臣惠符离去岁重酝酒时与杜挺之李宣叔王平甫饮于阻水仍有笋酱之遗","author":"梅尧臣","text":"赠以榴花酒，沉清贵隔年。\n不忧航滞碛，为汎盏如船。\n加品盈盘内，无花到眼前。\n还招李杜醉，野酿莫称贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和原甫阁下午寝晚归见示","author":"梅尧臣","text":"殿阁风来夏日长，青林抽嫩见馀芳。\n笔供五吏词休敏，簟展双纹睡正凉。\n故事早归何独晚，旧交新咏尚无忘。\n不言偃仰中园乐，还爱眉间喜色黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和景彝元夕雨晴","author":"梅尧臣","text":"春云收暮城，九陌洒然清。\n星出紫霄下，月从沧海明。\n车音还似昼，鼓响已知晴。\n静闭衡门卧，无心学后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和景彝对月","author":"梅尧臣","text":"萧萧风雨变凉意，索索晚云开斗晴。\n已洗浮埃天外静，忽生圆月树头明。\n草根虫穴吟来久，屋角星河落更清。\n我愧西垣侍臣比，景寒霜鬓两三茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和景彝闰腊二十五日省宿","author":"梅尧臣","text":"君尝编史似吴兢，又值甘泉马踏冰。\n重腊雪花方漫漫，宿厅书架自层层。\n桉头美酒初温火，帘底微风欲动灯。\n永夜未眠钟已发，此心閒寂似高僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和景彝省闱宿斋二首 其二","author":"梅尧臣","text":"新月斜光依约见，夜蝉高树有时鸣。\n曲眉不想西家样，馁腹还思二子清。\n迭代物华何足较，古今荣辱岂须惊。\n静来应觉能閒少，人事区区逐日生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和景彝省闱宿斋二首 其一","author":"梅尧臣","text":"昼日南宫雨后凉，斋严官重静于常。\n庭前斗雀堕还起，栏下秋花落自香。\n看尽云容天漏碧，读残书帙卷披黄。\n九衢尘土莫能到，萧瑟微风叶响廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和韩子华内翰于李右丞家移红薇子种学士院","author":"梅尧臣","text":"红薇花树小扶疏，春种秋芳赏爱馀。\n丞相旧园移带土，侍臣清署看临除。\n薄肤痒不胜轻爪，嫩干生宜近禁庐。\n此地结根千万岁，联华荣莫比茅茹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和酬刁景纯春雪戏意","author":"梅尧臣","text":"雪与春归落岁前，晓开庭树有馀妍。\n杨花扑扑白漫地，蛱蝶纷纷飞满天。\n胡马嘶风思塞草，吴牛喘月困沙田。\n我贫始觉今朝富，大片如钱不解穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和酬裴寺丞喜子修书","author":"梅尧臣","text":"唐宋典册竟骈罗，汉诏重令与削磨。\n古圣规模犹可法，众贤驰骋必无蹉。\n既除太史来为尹，遂用非才往补讹。\n代匠只忧伤手甚，君宜怜我不遑他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景彝三月十六日范景仁家同饮还省宿","author":"梅尧臣","text":"种桃依竹似仙家，邀对春风共泛霞。\n席上未观双舞凤，城头已觉聚啼鸦。\n匆匆跨马人归省，羃羃生烟树敛花。\n稚子候门知我醉，东方明月照扉斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景彝祀高禖书事","author":"梅尧臣","text":"闻说郊禖喜气翔，曾由乙卯命封商。\n今朝钟鼓登歌祀，何日熊罴作梦祥。\n扫雪野庐风凛凛，升坛公衮佩锵锵。\n君门赐胙予何有，不似矜誇凤沼傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景彝春宴","author":"梅尧臣","text":"法座初瞻户牖间，衮衣垂处见云山。\n满斟玉酒传宣尽，齐插宫花拜赐閒。\n红线织成庭下毯，明珠结出耳中环。\n斗鸡旗底蓬蓬鼓，逐胜争名利害关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景彝赴省宿马上","author":"梅尧臣","text":"乌纱帽底青眸转，朱雀街头玉辔摇。\n灯火高楼吹短笛，帘栊斜巷隘初宵。\n身归兰省唯看月，心在天津欲倚桥。\n枕上夜深应不寐，羡他年少酒微销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景彝阁后紫薇花盛开","author":"梅尧臣","text":"禁中五月紫薇树，阁后近闻都著花。\n薄薄嫩肤搔鸟爪，离离碎叶剪晨霞。\n凤皇浴去池波响，鳷鹊阴来日影斜。\n六十无名空执笔，颠毛应笑映簪华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汝州后池听水","author":"梅尧臣","text":"春水泉脉动，分岩临涧源。\n津津出石齿，泠泠萦竹根。\n犹和野云翠，复落郡池喧。\n心静意自适，不知朝市烦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江邻几寄羊羓","author":"梅尧臣","text":"细肋胡羊卧苑沙，长春宫使踏霜羓。\n蒺藜苗尽初蕃息，苜蓿盘空莫叹嗟。\n自乏良谋甘更鄙，犹能大嚼快无涯。\n磨刀为削朝霞片，时引清杯兴转嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池州进士陈生惠然见过不日且行因以诗赠别","author":"梅尧臣","text":"呼童具鸡黍，颇识故人期。\n竹馆忽枉驾，山樽聊解颐。\n醉歌返北郭，春雨生东陂。\n便与千峰隔，登高空复思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红梅","author":"梅尧臣","text":"家住寒溪曲，梅先杂暖春。\n学妆如小女，聚笑发丹唇。\n野杏堪同舍，山樱莫与邻。\n休吹江上笛，留伴庾园人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老马","author":"梅尧臣","text":"吴人惜燕骏，燕马卧吴家。\n毛骨从前贵，关山欲去赊。\n草深闲楚泽，力尽忆胡沙。\n御史乘来久，时逢避路騧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自和","author":"梅尧臣","text":"沉水香焚金博山，杜陵谁复与车还。\n马寻绮陌知何曲，人在珠帘第几间。\n法部乐声长满耳，上樽醇味易酡颜。\n更贫更贱皆能乐，十二重门不上关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏 其二","author":"胡宿","text":"闭户无还往，端居废礼容。\n花为贫富焰，燕是旧过从。\n持屐对人蜡，绽衣看妇缝。\n非同叔夜傲，切莫怪疏慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自感 其二","author":"梅尧臣","text":"我不嫌髭白，白髭何自落。\n虽然失丑衰，将恐日疏薄。\n有生无不老，岁事看秋箨。\n一身忧已大，毫发谁能度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自感 其一","author":"梅尧臣","text":"左目忽昏花，愁心乱剧麻。\n文书都莫见，药物近凭他。\n眸子终何似，形躯且愿嘉。\n唯期一开泰，再望日中鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至和元年四月二十日夜梦蔡紫微君谟同在阁下食樱桃蔡云与君及此再食矣梦中感而有赋觉而录之","author":"梅尧臣","text":"朱樱再食双盘日，紫禁重颁四月时。\n滉朗天开云雾阁，依稀身在凤皇池。\n味兼羊酪何由敌，豉下莼羹不足宜。\n原庙荐来应已久，黄莺犹在最深枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至香山寺报秀叔","author":"梅尧臣","text":"家近心还速，川长马易疲。\n望山孤寺出，渡水夕阳迟。\n来向林间宿，归须月上时。\n只应庭际鹊，已报汝先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟上采菊","author":"梅尧臣","text":"泯泯平慢流，行当季秋月。\n演漾过汀洲，汀洲芳杜歇。\n白露夜正霏，黄菊寒更发。\n采以泛酒卮，不独映华发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中值雨裴刁二君相与见过","author":"梅尧臣","text":"江上渰凄凄，天形接野低。\n岸痕生旧水，马迹踏春泥。\n风急侵衣重，山昏卷幔迷。\n谁惊二客论，不愧巨源妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中遇雪","author":"梅尧臣","text":"晓风鸣大泽，春雪下长河。\n沙草缘堤没，杨花拂水多。\n惊鸥不知远，候雁几闻过。\n欲问耶溪转，今朝奈兴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次朱家曲寄许下故人","author":"梅尧臣","text":"蔼蔼桑柘岸，喧喧鸡犬村。\n晚云连雨黑，秋水带沙浑。\n稍听邻船语，初分异土言。\n虽嗟远朋友，日喜近田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行次颍州闻张甥宗亮不捷乡荐以诗唁而迎之","author":"梅尧臣","text":"风前汝阴道，雨冷江南书。\n始叹与意异，何惭定鉴疏。\n但能存楚玉，切莫道黔驴。\n不负当时约，驰迎一乘车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖对雪","author":"梅尧臣","text":"独玩湖中雪，移舟水冻湾。\n寒塘起孤雁，危树失前山。\n著物偏能积，冲风不碍还。\n无惭子猷兴，都尽剡溪间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖观新出鹅儿道损持国曼叔请予赋之","author":"梅尧臣","text":"春抱畏雷后，鷇开形已完。\n嫩毛轻染檗，小掌未全丹。\n见物初能啑，浮波尚怕寒。\n山阴无道士，更长换应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观文丁右丞挽辞二首 其二","author":"梅尧臣","text":"春风百花发，露挽九原归。\n白马悲鸣驻，黄鹂下上飞。\n垄边新柏盛，门外吊人稀。\n独见东床客，攀车泪湿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观文丁右丞挽辞二首 其一","author":"梅尧臣","text":"预政公槐亚，谈经帝席陈。\n俭恭齐国相，清净汉廷人。\n去梦尝为蝶，遗文不解麟。\n一闻车马幸，丰赐及孤臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观水","author":"梅尧臣","text":"秋水漫长堤，郊原上下迷。\n孤城闭板筑，高树见巢栖。\n耳厌蛙声极，沤生雨点齐。\n渚间牛不辨，谁为扫阴霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观理稼","author":"梅尧臣","text":"稂莠日已长，匆匆芟薙初。\n来时露沾屩，归去月侵锄。\n一腹馁犹甚，百骸勤有馀。\n吾无力耕苦，谬读古人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许仲涂屯田以新诗见访","author":"梅尧臣","text":"许氏世工诗，浑棠格力微。\n独能兼古律，无不是珠玑。\n捧卷光蓬室，停车照竹扉。\n阳春复高调，自昔和人稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许昌晚晴陪从过西湖因咏谢希深蘋风诗怆然有怀","author":"梅尧臣","text":"疏云漏斜照，残雨叶间明。\n飞盖城头去，澄湖水正平。\n荷盛鲛客泪，蔓濯野人缨。\n公独思康乐，临流诵句清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许待制遗双鳜鱼因怀顷在西京于午桥石濑中得此鱼二尾是时以分饷留台谢秘监遂作诗与留守推欧阳永叔酬和今感而成篇辄以录上","author":"梅尧臣","text":"昔时三月在西洛，始得午桥双鳜鱼。\n墨藓点衣鳞细细，红盘铺藻尾舒舒。\n麟台老监分烹去，莲幕佳宾唱和初。\n今日扬州使君赠，重思二十九年馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访矿坑老僧","author":"梅尧臣","text":"山深无外事，日夕爱潺湲。\n趺坐树间石，力耕溪上田。\n解言南国事，能咏碧云篇。\n莫贳远公酒，余非陶令贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]