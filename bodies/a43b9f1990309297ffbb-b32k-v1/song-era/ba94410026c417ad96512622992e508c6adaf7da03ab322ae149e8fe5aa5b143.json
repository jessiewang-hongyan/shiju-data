[{"title":"潘少白前岁惠予零陵石一片方不及尺而文理巧秀有山水烟云之状予以作砚屏始成因赋长吟以遗之","author":"舒岳祥","text":"白云际天隅，峰峰争秀出。\n浩浩水石滩，归鸟时灭没。\n我欲茅三间，巢此重叠峰。\n我欲舟一叶，钓此苍茫中。\n君从何处得此石，千岩万壑在方尺。\n李成范宽格深秀，关仝荆浩骨峭特。\n殆非一人之所能，欲穷其源不可得。\n君言此物出零陵，远近来去皆天成。\n是中能著元次山，刻诗勒颂留孱颜。\n后来柳子曾作守，铭记摹写无遗闲。\n二子去后精魄在，文章散落水石间。\n鬼神往往窃馀巧，戏弄笔墨留斑斑。\n赠我以作书砚屏，林风石月秋泠泠，萧斋静对如有聆。\n元子柳子突出也大奇，今日之事我为之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"稻花桑花","author":"舒岳祥","text":"稻花花中王，桑花花中后。\n馀花皆嫔妃，以色媚左右。\n稻花吹早香，风露千万亩。\n上以奉玉食，粢盛及醴酒。\n下以饱苍生，亿兆餔其口。\n桑花虽无华，红葚映纤手。\n皇后首亲蚕，六宫承傅姆。\n天生众裸虫，无羽毛飞走。\n匪此皆冻死，性命安得有。\n予谓二花者，斯民之父母。\n昔予赋麦花，适当来牟候。\n未及歌二花，三花谁可后。\n请续时夏诗，以为风化首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"篆畦春日有怀正仲","author":"舒岳祥","text":"别来成隔岁，即是久相疏。\n咏物追唐律，名亭学史书。\n荑柔春霰后，花韵午晴初。\n閒日有閒课，人生无逸居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王德渊水西藁","author":"舒岳祥","text":"子有婉微句，藏之平淡间。\n想子无愠色，熙熙好容颜。\n吉人罕暴戾，详缓心自閒。\n吾知子用意，欲挽陶韦还。\n欲以静息竞，欲以柔镌顽。\n坐使听者心，悠然和且安。\n子来索我语，我与子无言。\n评茶及品水，此事在舌端。\n还有分别否，归鸿没远天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题余文叔山间四时之楼","author":"舒岳祥","text":"轻财好事余文叔，磊落襟期端不俗。\n外方避地客来多，我亦从君借书屋。\n屋前曲径绕沦漪，池上高楼新结束。\n一条碧涧贯虹飞，几片青霞排闼宿。\n四时自换景自留，是中云月无春秋。\n家家见山长在眼，处处有山堪起楼。\n不如此楼能著我，磨墨题诗楼上头。\n主人之贤乐复乐，青山曾见此客不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李唐松月","author":"舒岳祥","text":"明月青松枝，幽人岩下步。\n劝君早归来，草头已多露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵大年小景","author":"舒岳祥","text":"三株五株依岸柳，一只两只钓鱼船。\n水天鹎鸭斜飞去，细草平沙兴渺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照画卷","author":"舒岳祥","text":"远峰没空苍，近树森立壁。\n丛篁郁长汀，茅茨露半脊。\n归舟何处家，中流弄长笛。\n或恐画师身，留此黯淡迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题零陵石屏 其一","author":"舒岳祥","text":"大山插洪澜，定是关仝笔。\n缣素不能永，壁石写雄逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题零陵石屏 其二","author":"舒岳祥","text":"青峰插天隅，淡月如可吸。\n江流疑有声，孤舟舞蓑笠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题零陵石屏 其三","author":"舒岳祥","text":"大山如大国，小山如小邦。\n低树无附丽，洪涛恣舂撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题零陵石屏 其四","author":"舒岳祥","text":"大浪所簸摇，青山为俯仰。\n云何峰外雪，亦与相下上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题潘少白诗","author":"舒岳祥","text":"海飓既过天泬寥，瓦檠弄焰静自摇。\n特山吟稿适在案，读罢不知山月高。\n早从唐体入圆妥，更向派家事掀簸。\n尽囊六卷要我删，子自得之何必我。\n燕骑纷纷尘暗天，少陵诗史在眼前，我才衰退空茫然。\n君能于此更著力，唐体派家俱可捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樵童自故园来献海棠因赋二章 其二","author":"舒岳祥","text":"只道娇春日，谁知战朔风。\n轻霜去人远，爱景入枝红。\n依旧风情在，难将艳冶同。\n年年摇落后，来恼白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠冯法师","author":"舒岳祥","text":"我昔登巾山，曾题翠微阁。\n清诗照江月，月落诗不落。\n踏露沐长松，辽东一只鹤。\n千载还归来，塔杪栖寥廓。\n过我沧海东，复作羽衣客。\n问客何处来，乃是巾山郭。\n旧题雷卷去，恐我有新作。\n赠之锦绣段，归哦耿林壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠医博士范心斋","author":"舒岳祥","text":"疾病之所生，风寒燥湿毒。\n浸淫侵脏腑，脉络起丝粟。\n有药所不攻，针砭功始录。\n有如龙潜见，岩穴通隐伏。\n又如善用兵，洞窟皆驱逐。\n毛皮与腠理，一二数可烛。\n刺俞已及髓，投穴不中肉。\n春回九地底，冰崖芽众绿。\n范子故书生，于此见也独。\n十年从良师，神秘卷箧椟。\n我疑秦卢扁，垣墙能外瞩。\n又疑华佗子，披脏先剖腹。\n范生何大奇，方书可无读。\n我老目已昏，烦君为濯涤。\n更阅十年书，细字蝇头黑。\n与子作佳传，当与太史续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠杨佳孙","author":"舒岳祥","text":"作诗意得在句先，下笔直写意所到。\n世间惟俗最难医，剖石得玉加精巧。\n初如面壁无所睹，一点圆明通万窍。\n杨生杨生听我言，老语谆谆毋乃耄。\n生平十九未可量，淘洗晶荧方入妙。\n一再三见志愈坚，嘉子至意为倾倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠周此山","author":"舒岳祥","text":"梅花台越路，来往此番新。\n风月三间屋，乾坤六尺身。\n枕中铅汞术，笔下蕙兰春。\n听说西江事，庐山面目真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避地李山","author":"舒岳祥","text":"山居门早闭，雪后树重青。\n不为艰危迫，谁能险阻登。\n寒机与舂应，村诵隔溪听。\n绝顶观沧海，海平峰上层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞩物","author":"舒岳祥","text":"灼灼日及华，朝荣夕已坠。\n牵牛泫碧露，见晛歘憔悴。\n拒霜舒晓红，惟愁夕阴至。\n蜻蛚庇其根，亦复多愁思。\n容色岂不佳，浮脆何足贵。\n念此令人嗟，百年何流驶。\n所以靖节翁，把菊有深意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鬓边娇","author":"舒岳祥","text":"天工施巧亦无穷，开尽枝头入草中。\n先借豆花来作样，旋将槐蕊缀成丛。\n淡匀弄色蔷薇紫，深蒂含胎豆蔻红。\n可是夏英无胜汝，鬓云一朵爱珑松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯夷","author":"舒岳祥","text":"士如圭璋，自然廉隅。\n一日无耻，不可以居。\n上帝降衷，毁败是虞。\n迁史作传，爰首饿夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后月明起坐戏成","author":"舒岳祥","text":"雨后月明，如醉而醒。\n不见其形，但见其影。\n我梦初回，非曙非暝。\n道人无言，起舞弄景。\n水鸟无声，一鹤自警。\n清风南来，露坠炯炯。\n我病不饮，酌此清泠。\n超然顿悟，九万俄顷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"停云诗 其四","author":"舒岳祥","text":"俯仰换世，昨梦蚁柯。\n故交零落，屈指无多。\n孔时尹任，夷清惠和。\n各言尔志，夫也如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"停云诗 其三","author":"舒岳祥","text":"小园宛宛，水木鲜荣。\n子念及此，我宁忘情。\n曩岁中都，我归子征。\n以子出处，用观我生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"停云诗 其一","author":"舒岳祥","text":"我怀同人，如暵望雨。\n天地崩裂，干戈间阻。\n陈编孤哦，槁梧自抚。\n思而不见，援桂延伫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"停云诗 其二","author":"舒岳祥","text":"千山月白，露气濛濛。\n四顾惝慌，素霭成江。\n飞萝扫屋，悬泉挂窗。\n之子不至，世孰吾从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲁二儒","author":"舒岳祥","text":"叔孙事秦，以谀蔽愚。\n至于归汉，荐进狡夫。\n灭我王道，甚于焚书。\n是以二儒，确乎其居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"管鲍","author":"舒岳祥","text":"为管则易，为鲍则难。\n相马失瘦，相士失寒。\n管贫鲍富，坦然相安。\n于利不疚，于义斯完。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成石屏诗后再赋六言","author":"舒岳祥","text":"蜡屐枝筇穿峤，蓑衣一笛横江。\n试向屏风一揽，千山万水秋窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚易斋 其二","author":"舒岳祥","text":"泳道东湖联句，正仲篆畦和篇。\n半世清风朗月，十年闷雨愁烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚易斋 其一","author":"舒岳祥","text":"百年客鬓双白，四海春风一青。\n百舌枝头分付，黄鹂叶底丁宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感兴","author":"舒岳祥","text":"梦与黄粱并熟，路寻白社同归。\n深欲蜘蛛结网，长勤络纬鸣机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"舒岳祥","text":"从来明月无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钓台","author":"舒杲","text":"会心林木已成欢，登览还知天地宽。\n莫讶钓台有真赝，一潭秋月照人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎晖阁","author":"舒清国","text":"蔼蔼复依依，朝晖以夕晖。\n岩花寒不落，檐鸟静忘飞。\n僧自眠黄叶，人多梦翠微。\n云边时见鹿，饮水近禅扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苏子瞻观百步洪原韵","author":"舒焕","text":"先生何人堪并席，李郭相逢上舟日。\n残霞明灭日脚沈，水面浮空天一色。\n磷磷石若铁林兵，翻激奔冲精甲白。\n岸头旌旗簇五马，一橹飞艎信东下。\n入夜寒生波浪间，汗衣如逐秋风乾。\n相忘河鱼互出没，得性沙鸟鸣关关。\n委蛇二龙乃神物，游乐诸溪诚为难。\n筑亭种柳恐不暇，天下龙雨须公还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦学涪翁夜过其家戏作","author":"舒焕","text":"先生堂前雪月苦，弟子读书喧两庑。\n撞门入室书纵横，蜡纸灯笼似云母。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太守王公植松因赋","author":"舒雄","text":"滁上分忧老外郎，昔年曾此典南漳。\n双旌引过题桥路，五里迎归衣锦乡。\n种是万株松树在，至今民唤作甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归护国寺","author":"舒雅","text":"偶思皇泽来丹阙，却为禅斋返旧林。\n岭上白云终挂念，人间馀事不关心。\n澄潭雨过秋涵月，古桧风生夜对琴。\n闻道石桥多胜境，几时相伴一閒寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答内翰学士","author":"舒雅","text":"清贵无过近侍臣，多情犹忆旧交亲。\n金莲烛下裁诗句，麟角峰前寄隐沦。\n和气忽飘燕谷暖，好风徐起谢庭春。\n缄藏便是山家宝，留与儿孙世不贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答刘学士","author":"舒雅","text":"往岁别京畿，栖山与众违。\n君心似松柏，雁足寄珠玑。\n学道情难笃，烧丹力尚微。\n云中鸡犬在，祇候主人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答钱少卿","author":"舒雅","text":"蓬莱阁下旧邻居，偶别俄惊四载馀。\n每见寒葭思倚玉，忽临秋水得双鱼。\n人间贵盛君谁及，物外优闲我自如。\n闻说归艎向春渚，深知不与道情疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"舒雅","text":"江外力为儒，荣华表里闾。\n后生多折桂，数世必同居。\n筑室寒留谷，穿池夏养鱼。\n买山添胜境，移席讲新书。\n竹鸟邻僧刹，溪亭入野蔬。\n姓名喧魏阙，行止到公车。\n顾我曾游此，多年尚忆诸。\n未能重得去，寄咏一踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一落索 其二","author":"舒亶","text":"叶底枝头红小。\n天然窈窕。\n后园桃李谩成蹊，问占得、春多少。\n不管雪消霜晓。\n朱颜长好。\n年年若许醉花间，待拼了、花间老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一落索 其一 蒋园和李朝奉","author":"舒亶","text":"正是看花天气。\n为春一醉。\n醉来却不带花归，诮不解、看花意。\n试问此花明媚。\n将花谁比。\n只应花好似年年，花不似、人憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 分题得苔","author":"舒亶","text":"池台小雨乾，门巷香轮少。\n谁把青钱衬落红，满地无人扫。\n何时斗草归，几度寻花了。\n留得佳人莲步痕，宫样鞋儿小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丑奴儿/采桑子 次师能韵","author":"舒亶","text":"一池秋水疏星动，寒影横斜。\n满坐风花。\n红烛纷纷透绛纱。\n江湖散诞扁舟里，到处如家。\n且尽流霞。\n莫管年来两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木兰花 其三 蒋园口号","author":"舒亶","text":"琉璃一片春湖面。\n画舫游人帘外见。\n水边风嫩柳低眠，花底雨乾莺细啭。\n秋千寂寂垂杨岸。\n芳草绿随人渐远。\n一番乐事又将离，金盏莫辞红袖劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木兰花 其一 次韵赠歌妓","author":"舒亶","text":"十二阑干褰画箔。\n取次穿花成小酌。\n彩鸾舞罢凤孤飞，回首东风空院落。\n杳杳桃源仙路邈。\n晴日晓窗红薄薄。\n伤春还是懒梳妆，想见绿云垂鬓脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木兰花 其二","author":"舒亶","text":"金丝络马青钱路。\n笑指玉皇香案去。\n点衣柳陌堕残红，拂面风桥吹细雨。\n晓钗压鬓头慵举。\n恨里歌声兼别苦。\n西湖一顷白菱花，惆怅行云无觅处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"舒亶","text":"十年马上春如梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"舒亶","text":"箫鼓却微寒，犹是芳菲时节。\n分付塞鸿归后，剩一钩寒月。\n双垂锦幄谢残枝，馀香恋衣结。\n又被鸟声呼醒，似征鞍催发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 周园分题得湖上闻乐","author":"舒亶","text":"紫雾香浓，翠华风转花随辇。\n洞天云暖。\n一片笙歌远。\n水殿龙舟，忆侍瑶池宴。\n闲庭院。\n梦回春半。\n雪鬓无人见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"舒亶","text":"白鹭飞飞点碧塘。\n雨荷风卷绿罗裳。\n管弦竞奏杂鱼榔。\n游女谩能歌白纻，使君不学野鸳鸯。\n桃花空解误刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其三 和仲闻对棋","author":"舒亶","text":"黑白纷纷小战争。\n几人心手斗纵横。\n谁知胜处本无情。\n谢傅老来思别墅，杜郎闲去忆鏖兵。\n何妨谈笑下辽城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二 和葆先春晚饮会","author":"舒亶","text":"金缕歌残红烛稀。\n梁州舞罢小鬟垂。\n酒醒还是独归时。\n画栋日高来语燕，绮窗风暖度游丝。\n几多落叶上青枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 次权中韵","author":"舒亶","text":"燕外青楼已禁烟。\n小寒犹自薄胜绵。\n画桥红日下秋千。\n惟有樽前芳意在，应须沈醉倒花前。\n绿窗还是五更天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其四 劝酒","author":"舒亶","text":"雨洗秋空斜日红。\n青葱瑶辔玉玲珑。\n好风吹起□江东。\n且尽红裙歌一曲，莫辞白酒饮千钟。\n人生半在别离中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其二 赋锦带","author":"舒亶","text":"碎红如绣。\n摇曳东风垂彩绶。\n拟倩柔条。\n约住佳人细柳腰。\n蜀江春绿。\n争似枝头能结束。\n纤手攀时。\n欲绾同心寄与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其一 用旧韵戏吴奉议","author":"舒亶","text":"眉山敛额。\n往事追思空手拍。\n雁字频飞。\n生怕人来说著伊。\n闲抛绣履。\n愁殢香衾浑不起。\n莫似扬州。\n只作寻常薄倖休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十三","author":"舒亶","text":"小亭露压风枝动。\n鹊炉火冷金瓶冻。\n悄悄对西窗。\n瘦知罗带长。\n欲眠思殢酒。\n坐听寒更久。\n无赖是青灯。\n开花故故明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"舒亶","text":"疏英乍蕾馀寒浅。\n蹋枝小鹊娇犹颤。\n谩炷水沈香。\n帘波不是湘。\n清愁支酒力。\n畏听江城笛。\n恁忍说华年。\n垂垂欲暮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十九","author":"舒亶","text":"绿窗酒醒春如梦。\n小池犹见红云动。\n露湿井干桐。\n翠阴生细风。\n雨过芳塘净。\n清昼闲中永。\n门外立双旌。\n隔花闻笑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"舒亶","text":"忆曾把酒赏红翠。\n舞腰柳弱歌声细。\n纵马杏园西。\n归来香满衣。\n宝车空犊驻。\n事逐孤鸿去。\n搔首立江干。\n春萝挂暮山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]