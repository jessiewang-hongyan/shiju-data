[{"title":"奉寄朔翁","author":"周密","text":"苕风蘋月隔吴波，尚想追随寤寐歌。\n花外小车游甚处，春风三十六行窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谷日野步","author":"周密","text":"过了梅花第一风，东皋南陌渐融融。\n柔桑弱柳俱青眼，看见春归阿堵中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姚湾别墅","author":"周密","text":"别墅有幽事，閒移书画船。\n白田吹落雁，红树咽衰蝉。\n诗酒消闲日，功名负壮年。\n此中如可隐，何用买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送友人及第后归","author":"周密","text":"贾生年正少，危掇奉常科。\n拾第便堪贵，读书何用多。\n御黄闻喜酒，宫绿上方罗。\n见谓清流选，归鸣里巷珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂","author":"周密","text":"小山招隐树，独占九秋凉。\n清对月中影，静闻天上香。\n露侵犀透粟，云染麝生黄。\n莫待吹金雨，花边把一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日口号","author":"周密","text":"侵晨书吉向门楣，愿得新正事事宜。\n手把屠苏揩睡眼，灯前吟足隔年诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"香奁","author":"周密","text":"宽损罗裙叠损眉，芳年心事有谁知。\n朱门锁合春宵雨，独立空堂烛暗时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春宵怨","author":"周密","text":"华缸摇燄飘金虫，愁铅堕睫鲛绡红。\n琼窗尘锁十三雁，春庭月暗梨花空。\n城乌鸦鸦怨孤宿，谁倚东风叫横玉。\n宝屏掩梦蜀云轻，野蒿开尽菖蒲绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春夜怀张去非","author":"周密","text":"芳事将三月，虚堂近二更。\n薄阴禁害月，小雨护持春。\n静得琴书味，閒知草木情。\n薄篘今日熟，洗杓待幽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病后窥园","author":"周密","text":"柳已成花草上阶，一程多病不曾来。\n春寒定似知人意，要勒花枝未尽开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋季实为作山水清远图","author":"周密","text":"绿云涨脩堤，红雾迷横桥。\n烟村近城郭，楼台郁岧峣。\n春风二三月，一舸浮清苕。\n枕水何人居，倚户看轻桡。\n回头见南山，孤塔峨山椒。\n耕牛引闲犊，秧水浮新苗。\n悠然爱吾庐，楚语何待招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枕上","author":"周密","text":"一棂霜月一篝灯，残梦新诗两不成。\n唤醒少年湖海意，五更枕上听潮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毗山晚归","author":"周密","text":"短榜归来晚，船头对夕阳。\n乱钟城市近，一雁水天长。\n草眼矜春碧，梅心弄晚香。\n霜风吹酒醒，系缆欲昏黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"触热行","author":"周密","text":"役役复役役，连山草头赤。\n千里无寸阴，赫日蒸砂石。\n黄尘眯我眼，白汗流我绤。\n仆羸渴欲死，马瘏喘而瘠。\n触热者何人，京华利名客。\n何如归去卧北窗，桃笙八尺昼梦长。\n素琴枕籍书数卷，受用不尽南风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"锦带花","author":"周密","text":"化工机杼未能休，织出东风锦一篝。\n双蝶舞春犹未竟，乱红飞下为缠头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和亲老苍玉洞韵","author":"周密","text":"去郭仅数里，岩关忽深秀。\n人工莫窥测，天巧自成就。\n瑶草覆蓬莱，箭砂藏勾漏。\n如入万宝山，如坐群玉囿。\n赑屃撑巨鳌，回翔舞飞鹫。\n肉醉猛虎卧，雷轰懒蛟走。\n远绝人世尘，静阅古今宙。\n或若赴壑蛇，或如回顾兽。\n喷者如鲸呿，?者如龙吼。\n诡然足变幻，不可穷步骤。\n土清多芷兰，石瘦少薪槱。\n松柏森古姿，寒暑不得寇。\n风静柳新梳，云收山免胄。\n石镜磨古诗，玉钗泻寒溜。\n郊原遍红紫，川谷成锦绣。\n玄猿叫老木，石乳滴嵌窦。\n寺建开平初，亭创宣和后。\n客屦踏花香，僧衣卧云绉。\n碧萝暗雨意，绿阴靓春昼。\n高吟领景趣，玩物惊节候。\n晴箔收早蚕，烟蓑正初耨。\n暇日多胜游，嘉宾从贤守。\n歌声振林木，妆影摇涟甃。\n鸟啼觉山静，湍急和云漱。\n清谭杂觞咏，骑竹喧童幼。\n乌丝扫奇句，碧筒汲春酎。\n千里嗟漫浪，一醉成邂逅。\n莫采西山薇，莫歌南山豆。\n满泛一盎春，持介百年寿。\n万壑天籁清，我琴不须奏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日","author":"周密","text":"转头还九日，风雨阻登临。\n绿酒自醒醉，黄花无古今。\n凄凉三径意，感慨百年心。\n唤醒斜川梦，持杯且一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江楼晚眺","author":"周密","text":"楼外千帆送夕阳，水烟山色共沧茫。\n吴蝉已老豆花落，江雁欲宾芦叶黄。\n帘影梦回千里月，鬓丝愁染九秋霜。\n红兰佩古荷裳冷，泽畔行吟赋短章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花边小勺杂言","author":"周密","text":"我花今日开，我酒今日熟。\n我今适无事，可以歌我曲。\n花意向我红，酒意向我绿。\n重此花酒意，一醉不翅足。\n富贵如飞埃，岁月如转毂。\n醉舞君勿嗤，一笑未易卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚气","author":"周密","text":"晚气吹澄鲜，幽碧弄秋卉。\n得意双蜻蜓，竟日挂竹尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜读书","author":"周密","text":"剪烛听秋雨，新凉入简编。\n心能无一事，意可到千年。\n治乱无今古，扶持有圣贤。\n邻翁应笑我，漏断未成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨泊双林","author":"周密","text":"疏雨滴秋篷，扁舟宿苇丛。\n水灯寒聚蟹，霜橹夜惊鸿。\n梦入沧茫外，诗成惨淡中。\n无成空白首，来往愧溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖边逢陈高父","author":"周密","text":"湖边重见处，柳下共听蝉。\n人老如前度，诗工似往年。\n醉乡消白日，身事付苍天。\n自得吟千首，他时定可传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绣谷即事","author":"周密","text":"春苦无多已绿阴，重来泉石快幽寻。\n碧桃一院无人到，独自闻莺独自吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"度小岭","author":"周密","text":"前山青未了，又踏翠千寻。\n衣冷度云影，耳清闻涧音。\n早衰占足力，多崄见人心。\n切勿临高望，三吴草色深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄巢战场","author":"周密","text":"腐儒阶乱亦堪伤，故老犹传古战场。\n怨血已销朝代远，平冈春草似人长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古别怨","author":"周密","text":"吴王高城栖暮鸦，江南草绿人离家。\n流黄空织不成匹，门前莫种菖蒲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉还山西诗卷","author":"周密","text":"诗肠抱饥馋，嗜句如嗜炙。\n长年齰鸡蹠，有味如啖蔗。\n轑釜轰腹雷，每遭丘嫂骂。\n辛勤谋一饱，索米谁肯借。\n忽来五侯鲭，心目为惊诧。\n大羹足真味，禁脔增重价。\n仙露承金茎，天浆滟琼斝。\n何修乃得此，咀嚼日不暇。\n每拟赋老饕，欲作口屡嗄。\n锦鲸出光怪，把玩涉秋夏。\n珍重十袭藏，常恐六丁下。\n每思随?御，不足攀逸驾。\n清晨呼墨卿，为我再四谢。\n莫能赞一辞，泚颡惭久假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘江风雨图","author":"周密","text":"黯黯秋空漠漠云，瑟声依约听湘灵。\n夜篷碎滴风灯暗，犹记孤舟泊洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"神弦","author":"周密","text":"棘栎丛祠昼凄楚，隐画廊深山鬼语。\n香火千年古像昏，十围老木藏飞鼠。\n芳兰藉地罗蕙蒸，阴风窸窣吹神灯。\n舞蛮姣服炫红纬，云旂飙御声䡌䡌。\n茧瓮千车麦双穗，社主蚕姑拜神赐。\n鼓声坎坎酒频酾，神来不来巫自醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽菊坡赵侍制二首 其一","author":"周密","text":"贵胄才华自昔悭，如公名德世难攀。\n杏园新赐金花帖，荷橐高跻玉笋班。\n麾节一生多浙右，诗书千载接河间。\n感怀空抱羊昙恨，遥望西州泪雨潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽菊坡赵侍制二首 其二","author":"周密","text":"一从弓剑鼎湖游，有诏王孙记玉楼。\n天上晓班催听履，人閒夜壑忽移舟。\n霜残旧菊荒三径，雨泣新松掩一丘。\n别墅甫成清梦断，梅花空老水空流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽张运干","author":"周密","text":"同里复同寅，相过意最亲。\n我方贤此老，天不憖斯人。\n有记书先友，无车送后尘。\n平生交旧泪，一洒霅溪滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽韩子爽户曹二首 其一","author":"周密","text":"朋辈凋疏重可伤，不堪歌哭献文堂。\n宝灯卜夜笙箫暖，芳槛移春锦绣香。\n乐事可怜蕉梦短，哀辞忽引薤歌长。\n忍看玉树埋黄壤，泪湿东风酒一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽韩子爽户曹二首 其二","author":"周密","text":"蓝衣槐笏色方新，贺者才稀吊在门。\n骖凤风流秦穆婿，停鸾高爽北平孙。\n兰阶有子堪扶殡，麟窟无香可返魂。\n愁绝里山山下路，老梅残雪月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小沧浪亭","author":"周密","text":"绕屋双流碧玉交，了然清浊不相挠。\n吾心泾渭本无混，有味淄渑自莫逃。\n酾派欲笺鸿渐品，濯缨堪赋楚平骚。\n人间此是无波处，已办天随一叶舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烈帝庙","author":"周密","text":"英风千载后，溪上有遗祠。\n异鹊巢神桧，灵鼋集庙池。\n烟云昏古像，苔藓蚀丰碑。\n细把图经考，孤忠事更奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚泊","author":"周密","text":"清霜微月夜，红叶古塘西。\n野港沿村曲，秋云接树低。\n蟹灯寒照水，凫弋远侵溪。\n未践天随约，诗成意自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"藏书示儿","author":"周密","text":"少年诵诗书，颇有稽古志。\n中焉得良师，讲说击蒙昧。\n步趋古圣贤，千载俨如对。\n岂惟收放心，中自有乐地。\n维持识纲常，讨访极根柢。\n同异辩坚白，委曲穷琐细。\n精微究七略，猎涉到百类。\n近求事物间，远探天人际。\n研朱极雠校，钩玄谨书识。\n扬子喜问奇，中郎欣得异。\n源委本六经，上下猎众智。\n虽为吏坌汩，此事亦不置。\n矻矻常穷年，何敢叹劳勚。\n初非事进取，盖亦志平治。\n庶几致吾君，不负学古意。\n岂期事大缪，分寸不可冀。\n或病元凯癖，或嘲孝先睡。\n亦惟殖卤莽，何敢望穫刈。\n穮蓘当益勤，会见逢有岁。\n謏闻愧博识，钝质无强记。\n少习日寖忘，瞠若殊有愧。\n夜行笑老学，鸡蹠不忍弃。\n正如蠹书鱼，龁纸犹有味。\n千卷善和藏，万签邺侯庋。\n心惟与口诵，尚欲见所未。\n辛勤三十年，正尔窥一二。\n波澜浩如海，不可辩涯涘。\n要之自信笃，土炭各有嗜。\n勿以多岐亡，勿以半涂废。\n孰云道甚远，不息行可至。\n学问之所尊，尊在道与义。\n苟为不能然，虽多亦奚谓。\n道之充诸身，如人有元气。\n气以实而刚，气以弱而踬。\n浩然在存养，不可以力致。\n文辞乃枝叶，界限在义利。\n油然悟真筌，于此得良贵。\n立言吾岂敢，识字亦未易。\n我家有书种，谨守毋或坠。\n诗成付吾儿，永以诏来世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"记梦","author":"周密","text":"刚风吹翠冰，倒景浮玄枢。\n萧台万八千，上有真仙居。\n冰绡絅清气，宝笈龛琼书。\n至人青瑶冠，风动云霞裾。\n顾我一笑粲，勺以青琳腴。\n泠冷彻昆崙，肝鬲生明珠。\n玉童发清谣，引鹤开金铺。\n授我碧露笺，字字如琼琚。\n跽受九拜起，云气随捲舒。\n灵文眩五色，奥语探皇初。\n青高不可极，玄晤常集虚。\n玉苗日茂茂，珠蕊春如如。\n天妙不费言，悟解超仙衢。\n飞楼入紫翠，笑语多天姝。\n驯龙耕玉田，小凤扶金车。\n香满十二帘，春动红流苏。\n脩栏瞰云雨，黄道通清都。\n忆昔游五城，十载才须臾。\n正坐一念差，不觉秋尘污。\n华池涤凡髓，重佩三元符。\n凛凛不可留，欲去还踟蹰。\n仰天发长啸，万窍皆笙竽。\n约我更百年，来此骑鲸鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春归","author":"周密","text":"草满闲塘絮满溪，万株烟柳一鹃啼。\n开帘恰见春归处，花片东流日景西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜张九至","author":"周密","text":"相逢头尽白，握手便言诗。\n不患吟难好，翻愁世少知。\n琴书存雅道，年运有通时。\n且醉花前酒，毋劳赋五噫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感村晚泊有怀","author":"周密","text":"短航桥外泊，暮霭湿荷衣。\n风正千帆上，溪虚一鸟飞。\n潦黄山雨过，烧绿野春归。\n欲寄新诗句，东风雁影稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹫峰","author":"周密","text":"碧岫岧峣若画图，何年西竺到西湖。\n猿声带月离仙国，鳌背移山入帝都。\n松撼翠涛双涧冷，桂飘金雨一亭孤。\n却疑舞鹫随风去，欲把云关锁得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄武昌友","author":"周密","text":"楚月东随沔水流，相思应上庾公楼。\n楼前一片垂杨色，中有江南万里愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章台柳","author":"周密","text":"章华台外千株柳，翠影如云照碧天。\n霜叶露条应剪尽，可怜愁杀树头蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对月","author":"周密","text":"空寒坐庭玉，四至皆白天。\n千林无俗声，一叶时琤然。\n竹高散飞霜，池冷镕流铅。\n月以虚而明，心以虚而玄。\n心光射月彩，炯炯彻九渊。\n高吟撼老桂，惊起秋兔眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有以渔舟唱晚作图命题拟试者因戏成三首 其一","author":"周密","text":"绝妙王郎句，无声小米图。\n舷歌天地阔，笠钓水烟孤。\n暮色分浓淡，馀音似有无。\n卧游千里外，展卷欲思鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有以渔舟唱晚作图命题拟试者因戏成三首 其二","author":"周密","text":"展卷身疑在，西山南浦前。\n数声秋水笛，一叶夕阳船。\n兴寄沧浪外，机忘欸乃边。\n欲参声画趣，细玩濯缨篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有以渔舟唱晚作图命题拟试者因戏成三首 其三","author":"周密","text":"浦云山雨意，都向笔端生。\n一笛山水绿，半篙烟浪清。\n浅深天似暝，聚散雁如惊。\n谁写无声句，无声胜有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞寒曲","author":"周密","text":"千里惊沙眯人目，天愁地暗乌鸢哭。\n铁甲霜浓彻骨寒，万马无声虎貔缩。\n红弰角劲雁影高，朔风栗栗铦于刀。\n衔枚夜战路如漆，冰须堕指誇粗豪。\n将军毳幕愁春热，猎骑如云踏燕雪。\n何处关楼起远思，一声霜竹吹梅裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春郊即事","author":"周密","text":"野步足幽事，行行柳港边。\n鼓声何处碓，帆影隔溪船。\n节序多风雨，莺花动岁年。\n徘徊归向夕，山崦起炊烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽陈体忠二首 其一","author":"周密","text":"方惊成鵩赋，忽怆绝麟经。\n才反能为累，天乎不与龄。\n高堂慈母泪，幽志长公铭。\n西望哀笳发，潸然涕泗零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽陈体忠二首 其二","author":"周密","text":"同僚同里闬，臭味最相投。\n有暇多徵逐，无诗不唱酬。\n方欣衣尚絅，不料玉为楼。\n欲赋招魂些，秋云凝古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重游孤山有感二首 其一","author":"周密","text":"茗碗清分六一泉，暗香曾赋月娟娟。\n别来短鬓如梅白，闲却东风十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重游孤山有感二首 其二","author":"周密","text":"年年云木长苍苔，瀛屿春寒鹤不来。\n千尺粉垣围苑树，野梅今日是官梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次德范韵二首 其一","author":"周密","text":"客里光阴委逝波，问奇无客肯相过。\n素封未办千头橘，野服惟消一袭荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次德范韵二首 其二","author":"周密","text":"万卷牙签负善和，秋芸香浅蠹鱼多。\n近来始识书真味，意倦才荒柰老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春次韵二首 其一","author":"周密","text":"帘外残灯照夜愁，秭归啼梦五更头。\n捲春一夜东风紧，倒约飞花入小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春次韵二首 其二","author":"周密","text":"单衣初试觉身轻，芳径无花午气清。\n风罥断丝庭宇静，日长时听打茶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归春曲次韵","author":"周密","text":"花尘眯目日脚昏，枝头蜀鸟吟归魂。\n喷天狂雨浣香尽，绿填红阙春无痕。\n醉踏苍烟古台上，老柳无情擘残纩。\n寂历芳条宿孕莺，倒尽斜霞暗悲怆。\n东风恍恍如梦中，江吴烟醉蔷薇红。\n湘帘古春唤不应，孀娥泪眼空茸茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五更","author":"周密","text":"处处清砧砌砌蛩，客眠不着五更风。\n起来推户寻诗句，一树秋声月色中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"逸人居","author":"周密","text":"避俗入山居，孤云意自如。\n养丹文武火，插架古今书。\n岁酿常千石，朝飧止一蔬。\n畏人知住所，草径不曾锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]