[{"title":"西轩","author":"孔平仲","text":"新作朱门向水开，虽临行路少尘埃。\n久藏胜境因人发，尽放青山入坐来。\n树影转檐棋未散，荷香飘枕梦初回。\n晚年事事皆疏懒，赖得閒官养不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏昼","author":"孔平仲","text":"落花宁是秽，啼鸟不为喧。\n野水从侵道，青山任塞门。\n吏身閒似隐，官舍静于村。\n开卷何曾读，风来只自翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和唐林夫游家园","author":"孔平仲","text":"荒园忽报枉高旌，旋设屏帷当小亭。\n重复江山天外远，回还松竹坐中青。\n劝斟美酒罍频耻，看跋名书墨尚馨。\n莫笑区区身未退，待公鹏击我鸿冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庾楼","author":"孔平仲","text":"高城枕浩渺，层层压崔嵬。\n路绕清阴上，山分爽气来。\n天低风动幕，空迥月浮杯。\n远眼征帆尽，凉襟细雨开。\n行人望蓬岛，游客比春台。\n岂独登临胜，扶倾不易才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏夜","author":"孔平仲","text":"小雨初收深夜凉，杖藜徐步立回塘。\n一天星月清人意，四面芙蕖遗我香。\n大隐尝闻在朝市，昔人何必濯沧浪。\n应官粗了心无事，便是逍遥物外乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种花口号 其一","author":"孔平仲","text":"幽居装景要多般，带雨移花便得看。\n禁奈久长颜色好，绕阶更使种鸡冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种花口号 其二","author":"孔平仲","text":"蜀葵萱草陈根在，金凤鸡冠著地栽。\n并作暑天庭户景，深丛时见一花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上 其一","author":"孔平仲","text":"汲水添池池已深，小鱼无数乱浮沉。\n绿萍荷叶皆凉冷，更有庭柯百尺阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上 其二","author":"孔平仲","text":"群鱼散漫吸新水，好鸟间关啼翠阴。\n悠然物我俱自得，一霎南风吹我襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂堂","author":"孔平仲","text":"团团浓绿隔窗纱，曾见丛生瘴海涯。\n太守作堂真好事，谪仙题榜更增华。\n孤根直节非今日，秀气清香自一家。\n气候人间应较晚，月中子落此开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"通判成郎中生日人凡送香合寿星皆不受独以诗献","author":"孔平仲","text":"和似阳春静似山，讴谣千里祝公年。\n暂留卑湿江城地，且庆舒长夏景天。\n盛德自当增寿考，高才行且复蕃宣。\n香奁画轴知无用，只有诗篇不值钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗致卓道士灵座","author":"孔平仲","text":"阴阳藻鉴两俱优，落落高谈气似秋。\n仙驭晚留山水国，客星曾入帝王州。\n却乘眇莽归三岛，空葬衣冠付一丘。\n作颂驰书谢人世，知君平昔悟浮休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王通叟","author":"孔平仲","text":"春生湘浦即当还，穷览云山得据鞍。\n洒落文章终不俗，从容谈笑尚能欢。\n千金骏马将辞主，一曲胡琴遂掩棺。\n世事相因古如此，谁知鲁国累邯郸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日甘寝","author":"孔平仲","text":"回风动木叶，细雨湿蛛丝。\n心下无閒事，人间有此时。\n微凉纱半捲，幽梦角徐吹。\n此兴惟吾解，儿曹莫使知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚兴","author":"孔平仲","text":"骤雨行荷叶，嘈嘈如语言。\n高斋正薄暮，宴坐不知喧。\n极静开心地，新凉入鬓根。\n交游何用绝，自罕到吾门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张子明自庐山归云十五夜桂子落于太平观乡人谓之大熟子丰年之兆也","author":"孔平仲","text":"谁撼月中丹桂枝，堕阶圆实似珠玑。\n山中道士拾不尽，湖上仙人携得归。\n半夜香风飘涧壑，一时甘雨遍郊圻。\n与公寄籍皆江国，且喜田园岁不饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄唐林夫","author":"孔平仲","text":"北音融结本轻清，欲学含糊想未能。\n晚节弦歌应自笑，终朝簿领更相仍。\n九江土壤多卑湿，三伏云氛正郁蒸。\n宴坐知君无暑气，风标自敌玉壶冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏蜀葵","author":"孔平仲","text":"绰约佳人淡薄妆，天真自恃不熏香。\n低头无语娇尤甚，更著新翻浅色黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏荷花","author":"孔平仲","text":"一花一叶自相连，待得花开叶已圆。\n应为施朱嫌太赤，故将嫩绿间婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚兴","author":"孔平仲","text":"展簟当檐卧，微风送晚凉。\n云移自徐疾，蕉舞更低昂。\n结网蛛萦足，归巢鸟乱行。\n支离聊度日，那复论行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴全甫中舍倅无为","author":"孔平仲","text":"海沂歌舞待王祥，喜得淮南一道堂。\n军号无为已閒暇，地连秋浦更清凉。\n进趋黾勉心应懒，退食优游策最长。\n我住庐山欲招隐，为君先去种松篁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚凉 其一","author":"孔平仲","text":"晚凉睡觉欲何之，散步徜徉曲沼西。\n更上曹亭望江水，画船却舣白龙堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚凉 其二","author":"孔平仲","text":"晚凉睡觉坐前轩，悄寂无人共语言。\n近见南山片云起，满塘荷叶雨声喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋程氏云庵","author":"孔平仲","text":"萧然隐几坐，终日白云间。\n触石未全起，无心聊与閒。\n幽篁相映带，绝顶有跻攀。\n最称侵寒望，淮南雪满山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常父相率作吴丞相挽词 其一","author":"孔平仲","text":"久倦调羹手，新寻辟谷方。\n谓还周衮绣，重补舜衣裳。\n忽报中台拆，同嗟一鉴亡。\n森然栋梁气，今此掩黄肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常父相率作吴丞相挽词 其二","author":"孔平仲","text":"鸣玉东西府，藏舟辰巳年。\n盐梅捐鼎实，箕尾返星躔。\n阴德元丰政，遗书太史编。\n后人瞻彷佛，图像在凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚望","author":"孔平仲","text":"秋江水自壮，更值雨滂沱。\n落日增野兴，连天吹细波。\n城依湓浦近，舟傍柳湖多。\n吾已忘清浊，安知孺子歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禾熟三首 其二","author":"孔平仲","text":"丰年气象慰人心，鸟雀啾嘲亦好音。\n玉食儿郎岂知此，田家粒粒是黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禾熟三首 其三","author":"孔平仲","text":"雨足川原还聚晴，天心断送此秋成。\n谷收颗颗皆坚好，想见新炊照盌明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深夜","author":"孔平仲","text":"阒寂方深夜，清凉别一天。\n临风但独立，爱月不成眠。\n戍漏传声小，庭柯转影圆。\n露寒侵背侧，移榻近堂前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱君况卜居","author":"孔平仲","text":"吾身当老此园中，世路崎岖几万重。\n且饱稻粱随雁鹜，尽将云雨付蛟龙。\n求閒有志终须得，招隐何人肯见从。\n且为莆田朱处士，比邻先种七株松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和项元师见遗柳书","author":"孔平仲","text":"古今诸柳孰为强，矫矫针悬术最良。\n自富诗才堪继恽，兼深儒学有如芳。\n当时屡献箴规益，末世惟传翰墨光。\n石刻见贻真雅赐，峥嵘笔力有馀刚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸡冠花","author":"孔平仲","text":"萌芽浇灌已成丛，一一深红间浅红。\n偏近黄昏颜色好，分明秋景画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"孔平仲","text":"睡起西风掠鬓轻，萧然庭院晚寒生。\n浮云便作飞鸿意，细雨仍兼落叶声。\n物不求馀随处足，事如能省即心清。\n山林朝市皆相似，何必区区隐钓耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郎祖仁奉礼","author":"孔平仲","text":"碧落声华盖世高，哀乌才业亦时豪。\n灵渊自出驹千里，丹穴今看凤一毛。\n方略从容能处事，精神洒落见挥毫。\n东行想足资清兴，江上秋风捲怒涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙亨甫见寄","author":"孔平仲","text":"进多龃龉退为安，未省乘轩胜抱关。\n半世青衫贫为禄，新秋明镜老催颜。\n纷纷江上风吹叶，漠漠淮南雨暗山。\n欲和佳篇寄相忆，韵严词峭不容攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐林夫累惠书字法绝精以诗谢之","author":"孔平仲","text":"每承劳问意何穷，尤喜真行字颇工。\n萧散正如君子性，颉颃兼得古人风。\n曾经廷诤毫端直，自有家藏砚色红。\n雅称玉堂词翰手，枉留山邑簿书中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至城南别祖仁未归约文之不至","author":"孔平仲","text":"送客柳亭晚，倚栏秋雨酣。\n风烟满湖上，景物似江南。\n萧洒怜神往，从容忆手谈。\n老来心易折，离绪已难堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对菊有怀郎祖仁","author":"孔平仲","text":"庭下金铃菊，花开已十分。\n多情能惠我，对景独思君。\n秀色三秋好，清香一室闻。\n扁舟今夜雨，何处宿江云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓兴","author":"孔平仲","text":"薄寒初著裌衣裳，日景中分不短长。\n池馆虚明开水石，园林摇落受风霜。\n黄花满槛金铃秀，白酒盈樽玉液香。\n未老不须云母粉，且教弦管奏清商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知郡太博临宴公宇诗以为谢唐林夫在席","author":"孔平仲","text":"眷深贤守已忘形，肯屈旌旗到小亭。\n坐有嘉宾仙骨秀，门无俗客暮山青。\n荐樽施遣供蔬甲，秉烛相随看菊铃。\n欲识主人书馆淡，短檠灯火漆函经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕旅馆谈禅用元韵呈林夫","author":"孔平仲","text":"义以酬知不愿形，孤标直气蔚亭亭。\n天涯调官头将白，江上论文眼倍青。\n自性本空观水月，外尘相染喻风铃。\n昨宵共说无生话，胜读西来一藏经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林夫访及书室夜话又用元韵","author":"孔平仲","text":"珠玉相辉愧我形，正如朽壤附云亭。\n宦情已比春云薄，交义犹期老柏青。\n坐久北窗号过雁，谈馀荒戍咽疏铃。\n知君不厌寒宵景，世上风霜已屡经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至城东作 其一","author":"孔平仲","text":"地形磅礴接匡庐，旷野人烟乍有无。\n栖亩稻粱方待穫，识家鸡犬各随呼。\n农耕半岭如僧衲，牧跨羸牛似画图。\n官守投閒省坟柏，满林霜露涕沾濡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至城东作 其二","author":"孔平仲","text":"出郭二十里，依山八九家。\n茅冈风卷烧，土井两推沙。\n冻蝶依残菊，幽禽立卧槎。\n路边桃李木，犹发小春花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜菊","author":"孔平仲","text":"碧玉枝条手自分，花开晚节最怜君。\n斜簪短发能回老，满泛清樽要助醺。\n著雨半荒犹烂漫，绕栏三嗅倍氤氲。\n更收残蕊缝为枕，长得好香深夜闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋冬夕","author":"孔平仲","text":"平生疏野得江湖，岁暮西斋拥一炉。\n雨滴空阶如自语，风吹长木更相呼。\n世间宠辱收棋局，楼上光阴入酒壶。\n近日睡时全少梦，攀缘狂想自知无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夕即席作","author":"孔平仲","text":"烛滴胡桃泪，香蟠春蚓灰。\n酒花随煖聚，酥蕊带寒开。\n自有清歌送，惟闻画角催。\n隔帘疑晓色，雪压数枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日作","author":"孔平仲","text":"年光吹尽任飞灰，且庆舒长举寿杯。\n积晦弥旬三尺雨，新阳半夜一声雷。\n家人环坐相酬劝，贺客先期戒往来。\n熟醉腾腾成小睡，晚寒更起耻残罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小庵初成奉酬元师","author":"孔平仲","text":"伐竹诛茅挂织蒲，半规小榻一方炉。\n不随健鹘摩空去，且免穷猿失木呼。\n自有琴书增道气，别开世界在仙壶。\n幽人欲到知何意，若说真庵彼岂无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口占","author":"孔平仲","text":"东皇旌节下蓬壶，一夕芳菲遍海隅。\n红破露花将引蝶，绿深烟柳已藏乌。\n异乡旅食频年久，故国风光此日殊。\n常是登高牵望眼，醉吟今喜在江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父","author":"孔平仲","text":"红莲绿水本优游，清绝东南七宝州。\n见说新书亦多事，每闻沿檄少归休。\n少年共计驹千里，末路堪嗟貉一丘。\n正是江边桃李月，鸡鸣度曲寄离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘江宁韵送张天觉同年三首 其一","author":"孔平仲","text":"倾盖逢吾喜，开樽为子斟。\n笑谈天下事，忠义古人心。\n戢翼丹霄远，藏鳞赤壁深。\n弹冠行且起，朝列迟华簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘江宁韵送张天觉同年三首 其二","author":"孔平仲","text":"酒可平孤闷，无辞满满斟。\n剑横斗牛气，松抱雪霜心。\n泽国波涛壮，春天雾雨深。\n清哀记风采，白笔旧曾簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘江宁韵送张天觉同年三首 其三","author":"孔平仲","text":"戏挹东溟水，期将北斗斟。\n大鹏谁振翼，老鹳未偿心。\n卷箔江天静，停樯野岸深。\n晨羞聊一饱，荻笋正如簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题萧升之姨夫竹轩","author":"孔平仲","text":"开轩君子意，种竹岁寒心。\n高节凌云秀，孤根得地深。\n秋暄溪上雨，暝宿岭头禽。\n预约疏三径，他时伴醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席上送孙知损通直广东漕","author":"孔平仲","text":"度峡经泷行路难，岭猿越鸟避旌竿。\n身从日下恩光暖，声落天南暑气寒。\n事国以忠宁计远，与人为福莫如安。\n观公才大宜高位，岂复区区久外官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚遣兴","author":"孔平仲","text":"纷纷柳絮入帘飞，正是酴醾花发时。\n断送日长惟有睡，留连春去可无诗。\n狂鞭迸笋偏当户，绿叶成阴巧覆墀。\n百舌声中斜照晚，翛然衰鬓任风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳饮于湖上","author":"孔平仲","text":"城南春已老，湖上雨初晴。\n草作忘忧绿，风为解愠清。\n杨花轻欲下，菱叶细方生。\n酒影低云木，歌声伴画莺。\n赏心残蕊在，幽曲小舟横。\n却笑兰亭会，吟诗半不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口占","author":"孔平仲","text":"积水深踰丈，高林绕若城。\n虾蟆朝合吹，鸲鹆夜传更。\n难转长沙袖，空尘孺子缨。\n生涯吾尚阙，浥浥羡农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题萧文照阁","author":"孔平仲","text":"虚明敞高阁，清浅对方塘。\n轩冕忘怀久，江湖寓兴长。\n红蕖开细雨，白鸟下残阳。\n不挂人间事，逍遥自一乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢郏正甫","author":"孔平仲","text":"当年辇毂参农正，今日江湖望岁星。\n冷局自安心有素，故人相厚眼偏青。\n幅巾舒散殊官属，华衮腾骧入帝庭。\n一荐未为门下德，荷公敦笃好忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周文之主簿","author":"孔平仲","text":"俊逸驹千里，孤高桂一枝。\n清才比栖棘，馀事付枯棋。\n小邑今官满，当涂半己知。\n扬舲发江浦，策马望京师。\n待诏须金马，支床笑玉龟。\n都尘亦可畏，莫遣素衣缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日游湖亭","author":"孔平仲","text":"漫漫湖水拍堤浮，欲到南亭泛小舟。\n平日登临如别境，后来语笑尚中流。\n采菱斫鲤皆新美，赌酒围棋自献酬。\n对面火云高万丈，谁知此地有清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倦夜","author":"孔平仲","text":"灭烛恐招蚊，迎风罢掩门。\n读书都已废，就枕益加烦。\n缺月笼烟淡，群星带暑昏。\n徐行得住处，荷叶满南轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与张子明饮湖亭","author":"孔平仲","text":"小艇冲湖过，幽亭枕水虚。\n风来荷气外，人在木阴馀。\n湿印开新酒，长茭族贯鱼。\n遥看鹤归处，便是谪仙居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大暑","author":"孔平仲","text":"泽国已炎暑，夏天仍永朝。\n炙床炉燄炽，薰野水波摇。\n飞鸟不敢度，鸣蝉应自焦。\n可怜花叶好，憔悴苦霜凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入山马上口占","author":"孔平仲","text":"奕奕秋光照眼明，野香山秀互相迎。\n路穿蒙密无人见，天借阴凉助我行。\n水窦溅流如贝玉，松风疏韵作韶茎。\n一重一掩尘埃远，故比城中分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]