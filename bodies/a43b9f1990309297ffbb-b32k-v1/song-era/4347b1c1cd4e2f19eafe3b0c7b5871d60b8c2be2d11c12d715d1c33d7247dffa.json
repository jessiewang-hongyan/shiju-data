[{"title":"瑞鹧鸪 其二","author":"赵希蓬","text":"把定离觞不肯斟。\n闻君未醉尽衷情。\n丁香空结千般恨，柳线难萦一片心。\n只把文章酬素愿，莫贪歌舞阻归程。\n凭君试问湘江竹，班是阿谁旧染成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹧鸪 其四","author":"赵希蓬","text":"温柔乡里睹春容。\n无语闲将脚带松。\n魂梦阳台迷暮雨，丰姿洛浦挹仙风。\n追陪梅下黄昏路，仿佛槐安富贵宫。\n旧恨上心空有感，扫除全付一杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角","author":"赵希蓬","text":"枕痕如斫。\n一线红生肉。\n睡起娇羞无语，远山坐对横轴。\n烧香频祷祝。\n偷把简儿读。\n字在那人何在，泪珠飞下蔌蔌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次雪林李龏苕溪寄来之韵 其二","author":"赵希㯝","text":"风梧声里万家秋，一片吟心不著愁。\n夜半酒醒银烛冷，月移凉梦过西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次雪林李龏苕溪寄来之韵 其一","author":"赵希㯝","text":"云散烟收渺渺秋，蛩声四壁起新愁。\n西风万里乾坤眼，不到斜阳十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次萧冰崖梅花韵","author":"赵希㯝","text":"冰姿琼骨净无瑕，竹外溪边处士家。\n若使牡丹开得早，有谁风雪看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦洞","author":"赵希鹗","text":"白鸥曾此识机心，渭水翻波自不禁。\n当日尚嫌文网阔，后来谁测武陵深。\n西风落叶吹秦晋，流水桃花迭古今。\n世岂避人人避世，九垓同此夕阳阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋玉岩","author":"赵希融","text":"君不见陶令门前栽五柳，聊为折腰辞五斗。\n归来三径足欢娱，琴书得趣人谁有。\n又不见和靖卜筑临西湖，湖山胜景天下无。\n至今疏影横斜句，人与梅花共清癯。\n古来逸士皆如此，一节纯全能终始。\n三叹古风挽莫回，幸有玉岩人足比。\n二十馀年养浩深，厌居朝市入山林。\n此身出处无非道，忧世谁知一寸心。\n愧予朱墨尘埃里，恨不岩前濯清泚。\n想象入室芝兰馨，有□清庙遗音美。\n闻说当年赠监书，蒲公之见特其粗。\n要知命义吾儒事，愿学同游周邵苏。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋蕊香","author":"赵希?","text":"髻稳冠宜翡翠。\n压鬓彩丝金蕊。\n远山碧浅蘸秋水。\n香暖榴裙衬地。\n亭亭二八馀年纪。\n恼春意。\n玉云凝重步尘细。\n独立花阴宝砌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 桂","author":"赵希","text":"姮娥戏剧。\n手种长生粒。\n宝干婆娑千古，飘芳吹满虚碧。\n韵色。\n檀露滴。\n人间秋第一。\n金粟如来境界，谁移在、小亭侧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宿峡石寺下","author":"赵抃","text":"淮岸浮图半倚天，山僧应已离尘缘。\n松关暮锁无人迹，唯放钟声入画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵孔宪蓬莱阁","author":"赵抃","text":"山巅危构傍蓬莱，水阁风长此快哉。\n天地涵容百川入，晨昏浮动两潮来。\n遥思坐上游观远，愈觉胸中度量开。\n忆我去年曾望海，杭州东向亦楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杜子美书室","author":"赵抃","text":"直将骚雅镇浇淫，琼贝千章照古今。\n天地不能笼大句，鬼神无处避幽吟。\n几逃兵火羁危极，欲厚民生意思深。\n茅屋一间遗像在，有谁于世是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人题曹娥庙二首 其二","author":"赵抃","text":"哀哀江上救沈尸，墓木留形世所悲。\n得旨春秋参祀典，孝诚今日再逢时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折新荷引/折新荷","author":"赵抃","text":"雨过回廊，圆荷嫩绿新抽。\n越女轻盈，画桡稳泛兰舟。\n芳容艳粉，红香透、脉脉娇羞。\n菱歌隐隐渐遥，依约回眸。\n堤上郎心，波间妆影迟留。\n不觉归时，淡天碧衬蟾钩。\n风蝉噪晚，馀霞际、几点沙鸥。\n渔笛、不道有人，独倚危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游石室","author":"赵时","text":"假守圣朝多宰辅，纪题昔日尽名贤。\n我今始会由来意，此境栖迟本列仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题姚雪蓬骑牛像","author":"赵时习","text":"骑牛无笠又无蓑，断陇横冈到处过。\n暖日暄风不常有，前村雨暗却如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种兰花","author":"赵时伐","text":"深林瘦径傲朝昏，牙发消疏气骨存。\n九畹谁移炎海角，半庭新补冷云痕。\n圃翁认叶非漳种，墨客知花是楚魂。\n从此国香春不断，光风满地长儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄塘岩","author":"赵时朴","text":"平地有石室，玲珑户牖空。\n重门疑鬼凿，六月与天通。\n乳窦如滴雨，幡幢欲舞风。\n僧言岩下水，窈窕到骊宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南","author":"赵时行","text":"霜月湿，人睡矮篷秋。\n惊觉夜深儿女梦，渔歌风起白蘋洲。\n别岸又潮头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四景诗和孙佥判颖叔韵 其四 仙矶晴雪","author":"赵时远","text":"敛尽同云放日晖，寒光凛凛透重衣。\n扁舟清晓寻溪转，髣髴王猷访戴归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四景诗和孙佥判颖叔韵 其三 平湖秋月","author":"赵时远","text":"楼台两岸枕长流，落日行人竞舣舟。\n清夜湖光平似镜，冰轮冷浸玉壶秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四景诗和孙佥判颖叔韵 其一 荻塘柳影","author":"赵时远","text":"午天云淡日迟迟，水面长条带影垂。\n不是纤腰浑不定，自缘无力受风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四景诗和孙佥判颖叔韵 其二 禅院风荷","author":"赵时远","text":"荷风细细晚生凉，暑气絪缊入座香。\n饮尽碧筒人笑语，花边惊起睡鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莺脰湖","author":"赵时远","text":"莺去湖存事渺茫，梵宫占断水云乡。\n四围烟树浪涛阔，六月桥亭风露凉。\n远近征帆归别浦，高低渔网挂斜阳。\n翠微深处一声笛，惊起眠沙鸥鹭行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春","author":"赵时奚","text":"霜皎千林，正石桥人静，春满横塘。\n寒花自开自落，晓色昏黄。\n明沙暗草，对东风、深锁闲堂。\n金漏短，江南路远，梦回云冷潇湘。\n重到旧时花下，按玉笙歌彻，月正西廊。\n亭亭爱伊素影，粉薄新妆。\n经年瘦损，漫谁知、心事凄凉。\n休更听，城头画角，一声声断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多丽 西湖","author":"赵时奚","text":"敛吴云，翠奁推上红晴。\n渺澄流、鳞光寒碎，远峰螺绀低凝。\n杏香引、画船影湿，柳阴趁、骄马蹄轻。\n桥限宽平，堤横南北，去来人入绣围行。\n渐际晚，梅妆游困，十里曳歌声。\n苍烟润，飞鸦妒春，一梦催醒。\n认名园、当时宴幸，缆痕犹在危亭。\n露花浓、静迎直砌，雾藓冷、淡护飞甍。\n几对东风，留连丽景，年□□老越山青。\n夜深月、照人依旧，何处最关情。\n欢娱地，星移世换，客恨还盈。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恋绣衾 其一","author":"赵时奚","text":"迢迢江路日又曛。\n为春迟、长是怨春。\n小立马、千林下，寄寒香、归赠故人。\n相逢细说经年恨，早匆匆、吹散霁云。\n算惆怅、芳菲事，粉蝶知、应自断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恋绣衾 其二","author":"赵时奚","text":"江南烟水几万重。\n记玉人、花底旧容。\n待欲寄、飞鸿信，望前山、夕照冷红。\n塞笳月下声凄楚，怨百花、春事梦空。\n倩谁共、东君说，把阳和、分付朔风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓","author":"赵时清","text":"诸老凋零不忍闻，奈何天又夺斯人。\n汉初贾谊曾前席，晋后渊明耻屈身。\n尚想醉归松路月，可堪梦断草池春。\n同宗闻讣尤伤感，老泪无多暗损神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏山 其二","author":"赵时焕","text":"重访招提恰六年，松风萝月故依然。\n世间万事都休问，燕坐看山是好禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日山送客","author":"赵时焕","text":"频来因送客，携酒访仙灵。\n归去成何事，重来愧此亭。\n天宽野水白，松润石崖青。\n倚杖思今古，寒鸥落远汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅","author":"赵时焕","text":"梅龙阅世今几春，皮毛剥破生苍鳞。\n通身苔藓云气湿，恰如初蜕离海滨。\n蜿蜒恍惚露半腹，花光补之难貌真。\n祇恐天上行雨去，呼吸风雷惊世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏山 其一","author":"赵时焕","text":"两到临川愧罔功，只凭心事对苍穹。\n江乡又喜今年熟，一笑归田作好冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武夷","author":"赵时?","text":"千古武夷山，来寻九转丹。\n云封拜章石，月洗步虚坛。\n白玉何劳煮，丹霞自可餐。\n未穷溪九曲，赖有画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈少阳先生上书稿后","author":"赵时瓈","text":"胡马昔长驱，高屋建瓴水。\n权奸误国家，和议甘骫骳。\n遂令九庙尊，冒没在棘枳。\n带甲百馀万，一啸自披靡。\n堂堂谏议公，屹若颓波砥。\n叩阍斥时宰，不惜用一死。\n此死不足道，闻者自兴起。\n一木支大厦，于时不可尔。\n使早定大计，何物摩壁垒。\n可怜绍兴间，赙赠官其子。\n我得睹遗稿，感慨宁已矣。\n千载凛如生，作者书于纸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其十二","author":"赵时韶","text":"花下朦胧作桂看，细评香影一般般。\n唤醒二十年前梦，依旧身游在广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其十","author":"赵时韶","text":"小桥飘泊淡生涯，曾送清香入酒杯。\n疏影不随流水去，夜深和月过溪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其五","author":"赵时韶","text":"春在枝头有浅深，疏疏冷冷小溪阴。\n好风一阵香如洗，明月三更影不沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其三","author":"赵时韶","text":"山前抹出连云树，窗外拖来带月枝。\n数点塞鸿相伴好，一声羌笛不须吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其十一","author":"赵时韶","text":"一夜霜风吃紧吹，晓惊飞鸟蹴花枝。\n谁知窗外纷纷意，正是山阴雪下时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其六","author":"赵时韶","text":"繁华朽腐休相溷，冷淡幽闲大逼真。\n断得世间烟火气，前身恐是首阳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其十四","author":"赵时韶","text":"风雨潇潇日又曛，因香认得半溪云。\n平生不作朦胧事，立待明时折赠君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其一","author":"赵时韶","text":"寂寞篱边野水涯，三花雨蕊带春来。\n且图冷淡为生活，不傍门庭闹热开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其八","author":"赵时韶","text":"万籁沉沉境寂寥，寻香不见过溪头。\n小奚摸索枝头笑，谁把明珠蓦地投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其十三","author":"赵时韶","text":"前山日落已栖鸦，老树槎牙竹半遮。\n沙岸寒雪迷晚眺，祇疑金色界中花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其九","author":"赵时韶","text":"气味风标见似人，群芳合让作先生。\n尽烧龙脑三千斛，不抵花心一点清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园小梅得疏影横斜水清浅暗香浮动月黄昏十四诗 其四","author":"赵时韶","text":"一枝倚竹偏宜雪，半树歌檐转怕风。\n客意不平花又拗，和愁挂在夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云峰","author":"赵时韶","text":"淡似衡山雾已开，浓如雨意黯阳台。\n黄昏天际迷归鸟，错认林梢不下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日梅","author":"赵时韶","text":"红日移阴上粉墙，烘乾花底夜来霜。\n不须水月黄昏景，疏影风前午更香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"占尽风情向小园","author":"赵时韶","text":"月下相逢当丽人，嫣然体态皎然身。\n谁知一角闲田地，包括乾坤不尽春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叹梅","author":"赵时韶","text":"梅花千古长如许，堪叹十年人事非。\n记得大平楼上醉，一枝和月插头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"布谷","author":"赵时韶","text":"社前社后雨纷纷，山北山南处处闻。\n田父不知墙壁字，此声便是劝农文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟梅","author":"赵时韶","text":"安得梅开向四时，骚人日日可吟诗。\n年来万事心都懒，只有吟梅兴未衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折梅","author":"赵时韶","text":"行到颓墙与断桥，试和明月拗枝头。\n江南多少闲儿女，带着梅花便带愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芭蕉","author":"赵时韶","text":"摇摇如扇叶，风颤午窗阴。\n素不生枝节，人皆见赤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜窗","author":"赵时韶","text":"候虫鸣砌冷萧萧，半点残灯伴寂寥。\n桐叶亸秋黄不彻，那堪小雨学芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚辰春疥西峰壁 其二","author":"赵时韶","text":"山中亦有薇堪采，海上那无节可持。\n野老不知人事改，相逢犹话旧年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚辰春疥西峰壁 其一","author":"赵时韶","text":"三五年时折桂来，也曾班底戴花回。\n而今四十还流落，却被人呼老秀才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下","author":"赵时韶","text":"山前山后雪漫漫，输与田夫野老看。\n驿路自知荆棘甚，一枝远赠故人难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻杜鹃","author":"赵时韶","text":"雨过山山翠欲流，杜鹃要好莫啼休。\n锦城宫殿多烟草，枉与春风作对头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"爱梅","author":"赵时韶","text":"独自敲推到夜深，情知未称惜花心。\n玉儿已死云英嫁，谁唱梅词伴我吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"粉蝶如知合断魂","author":"赵时韶","text":"一自英台魄化时，生来长是宿芳菲。\n伤心只欠含章梦，不得枝头作雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚊雷","author":"赵时韶","text":"朝来伏地悄无声，入夜轰轰屋底鸣。\n堪笑不能惊蛰户，空将胡蝶梦魂惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅债","author":"赵时韶","text":"拟把吟篇倚阁休，见梅时复上心头。\n家贫幸免抨■苦，诗债还添一段愁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅答","author":"赵时韶","text":"向背稀稠各自宜，荣枯开谢且随时。\n春风最是无凭据，到底真心不属伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅癖","author":"赵时韶","text":"几度溪桥恋影香，冲风冒雨也思量。\n尽教人笑成梅癖，死不将诗到海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦梅","author":"赵时韶","text":"梦醒春风笑一场，揽衣推枕起思量。\n草塘梦句有何好，梦到梅花字字香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁和彦山韵","author":"赵时韶","text":"叫月声声到枕儿，稻粱虽饱岂能肥。\n夜深且傍潇湘宿，明日晴空万里飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感梅","author":"赵时韶","text":"清清白白天然态，皎皎翘翘玉立身。\n雪虐霜饕千万变，此花到底是全人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]