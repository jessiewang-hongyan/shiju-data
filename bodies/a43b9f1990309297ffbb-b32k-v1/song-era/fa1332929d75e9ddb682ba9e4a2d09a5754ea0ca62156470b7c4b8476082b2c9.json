[{"title":"早夏","author":"贺铸","text":"吏役初无补，端令乐事妨。\n不知春遂去，但爱日何长。\n薄雨梅含核，温风麦擢芒。\n须容退食暇，一枕梦吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有僧自峡中来持黄黔州手制茶兼能道其动静与潘豳老赋二首 其二","author":"贺铸","text":"平生得禄仅荣亲，持底天涯料理贫。\n夜户不关无长物，晨炊待火乞诸邻。\n山?颇侠能来虎，水弩何知枉中人。\n少减家园旧年调，携笼先采雨前春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有僧自峡中来持黄黔州手制茶兼能道其动静与潘豳老赋二首 其一","author":"贺铸","text":"未闻东观奏书成，俄见西南万里行。\n从坐何关李都尉，补亡犹待褚先生。\n心悬黄犬沈来耗，耳惯青驹祗旧鸣。\n时节私庭差自慰，凤将雏去雁随兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行写望","author":"贺铸","text":"斜照侵疏箔，微凉逗小窗。\n青蒲故依渚，白鸟屡横江。\n遣兴诗三百，煎愁橹一双。\n前舟定未远，叠鼓听逄逄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江夏秋怀三首 其一","author":"贺铸","text":"陈物纷然眼界中，长年何与偶书空。\n沧浪难为俗子唱，络纬漫催贫女工。\n风月少容休吏役，烟波长与济途穷。\n功成身退非吾事，犹办扁舟东复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江夏秋怀三首 其三","author":"贺铸","text":"此身岂复系西东，流浪江湖伴塞鸿。\n曲突非图三爵客，直钩何羡六鳌翁。\n千年陈迹祇今日，万里故园犹个中。\n冗散偶逃人指数，未应吟啸坐妨公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤泉道中","author":"贺铸","text":"青石冈西下，灵泉产药苗。\n山英如有待，木客可相招。\n蝉带风移树，尘随马度桥。\n飏鞭吟旧句，归路不知遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自讼","author":"贺铸","text":"朝听明钟出，暮随衙鼓归。\n朝朝复暮暮，是是与非非。\n迹寄升沈路，言投祸福机。\n何穷百年事，端使一心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自郓还徐道中","author":"贺铸","text":"八月过新雨，行云弄晚凉。\n山川乍明晦，禾黍半青黄。\n西去真何事，东还非故乡。\n悠悠尘土里，无路不亡羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟发金陵望历阳作","author":"贺铸","text":"尚识历阳道，依然西照间。\n风烟石碛戍，林麓楚王山。\n隔水一凝伫，当年百往还。\n谁怜跃马客，衰病再投闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次广陵怀寄京都交旧","author":"贺铸","text":"朋游冠盖满京华，病客东流迹自赊。\n音驿未闻来日下，邻墙不见亦天涯。\n尚惭斗粟烦官廪，已指扁舟是我家。\n莫谓因风无可寄，雪梅开遍腊前花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次淮阴呈邑令田望","author":"贺铸","text":"狂吟醉约昔悠悠，衰病方谐散浪游。\n蔬粥满杯供我饱，兰舟系岸判君留。\n尘埃古刹寻遗篆，香火严祠谒故侯。\n晚具不须烹赤鲤，聊凭别后作书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西城有怀旧游","author":"贺铸","text":"西郭天泉里，依依得旧游。\n绮罗红芰晓，丝管万蝉秋。\n柳碍鞦韆陌，萍沈祓禊舟。\n华年勿复道，谁为驻东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许永席上赋","author":"贺铸","text":"流浪江湖跨两年，西风犹驻木兰船。\n可人方外二三子，与尔樽中十八仙。\n处士妄同公子议，曲生未减索郎贤。\n自怜衰病方轰饮，也在刘家幕下天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访金陵王闲叟不遇留别","author":"贺铸","text":"歌成五噫赁舂者，药不二价夺牛翁。\n衰俗何知贵公子，清贫颇有昔人风。\n君方上冢渡沔去，我适乘舟投剡中。\n差池相失重回首，好住海鸥忘塞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴江送客","author":"贺铸","text":"送别松陵道，轻舟助客拿。\n湖空剪葭菼，市隘集鱼虾。\n薄雨啼残雪，新潮蚀嫩沙。\n镜中羞沓飒，行复见春花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈李之仪","author":"贺铸","text":"淹卧疲筋快晓晴，屋头相报鹁鸪鸣。\n病侵老境可怜许，春入故园何似生。\n坐想兰亭通曲水，行闻上巳接清明。\n明年强健陪嘉集，定夺三觥赋不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"快哉亭朝暮寓目二首 其一","author":"贺铸","text":"夙起喜舒旷，径趋城上楼。\n初阳动禾黍，积雨失汀洲。\n水牯负鸲鹆，山枢悬栝蒌。\n坐惭真隐子，物我两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"快哉亭朝暮寓目二首 其二","author":"贺铸","text":"积潦际危堞，登临西照中。\n苔衣罥白羽，槐荫悬青虫。\n不浅胡床兴，无多团扇功。\n目穷犹起羡，演漾一渔篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀寄寇元弼","author":"贺铸","text":"君投筦库可知非，我饱官粮又愿违。\n旧国秋高鸿雁过，长淮水落白鱼肥。\n西风吹梦端相觅，南物留人也念归。\n何日芦轩下双榻，满持樽酒洗尘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀寄潘孝本兼简其子言","author":"贺铸","text":"春色先梅岭，秋声后桂林。\n溪通五羊险，云近九疑阴。\n无雁难逢信，有猿能伴吟。\n一樽烧酒美，应对阿戎斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投宿清凉寺","author":"贺铸","text":"建业衣冠集，秦淮舟楫屯。\n东西万里客，朝暮两潮浑。\n何处契心赏，片时清耳根。\n仆夫浪见问，但出石城门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟南梁慧侃法师独杵捣衣","author":"贺铸","text":"峄阳桐杵鸣，莲岳石砧平。\n待谁相应节，要自不胜情。\n吹衣风稍急，吊影月微明。\n会有不眠客，听此断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴上有怀李易初","author":"贺铸","text":"何处经行特惘然，津头曾送木兰船。\n桃花春水生前夜，杨柳秋风忆故年。\n驿路尺书疑断绝，官仓斗米愧留连。\n飘飖复作江湖计，从此长安是日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴上留别李智父","author":"贺铸","text":"一马西投汴水滨，自惊秋鬓带尘纷。\n秋风尽日吹黄叶，心事经年寄白云。\n去矣尺书勤访我，醉来樽酒强酬君。\n北窗络纬寒声急，明夜伤心独自闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴渠夜泊示毕绍彦祖","author":"贺铸","text":"耿耿度中夜，浩歌谁与酬。\n屋头风罨岸，枕底浪澎舟。\n春物行飘忽，乡心久滞留。\n须明投吏部，一醉驿西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芜湖王敦城下作","author":"贺铸","text":"斗立孤城日四围，贼奴曾未慑天威。\n风生虎帐豺声厉，尘犯龙颜鱼服归。\n首揭大航遗臭在，歌流乐府旧音非。\n当时不慕桓文举，草满中原胡马肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛未兴龙节日怀历阳王掾元胥","author":"贺铸","text":"昨岁东溪口，扁舟欲下江。\n伴愁灯映幔，欺睡月侵窗。\n漫寄书连纸，谁同酒一缸。\n何当见之子，聊使我心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈留南城马上简李公年","author":"贺铸","text":"南郭何人卜筑幽，平田高树带清沟。\n隔墙野鸟啼晴昼，驻马行人照白头。\n二顷难寻归老计，一樽宜结探春游。\n步兵不惜供厨费，更作东风数日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟山晚泊","author":"贺铸","text":"春候半寒温，维舟淮上村。\n长林补山豁，青草际潮痕。\n久厌浮家役，重招去国魂。\n禅房欲舒写，烟雨促黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居春日遣怀","author":"贺铸","text":"青梅小叶柳长条，相对春风各动摇。\n物色依依如有待，人情忽忽自无聊。\n五陵剑侠知谁健，三径车工不我招。\n好去广津门下水，新秋稳送木兰桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京居感兴","author":"贺铸","text":"为问长安客，何人识要津。\n长持一马箠，浪走六街尘。\n城阙烟中晓，关河雪后春。\n故园桃李在，樽酒愿相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人游白云庄二首 其一","author":"贺铸","text":"原野正春风，登临一醉同。\n阴晴时未定，今古思何穷。\n山势落还起，溪流噎复通。\n隐君方自得，可羡尔冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人游白云庄二首 其二","author":"贺铸","text":"可爱白云翁，前溪舣钓篷。\n耕樵一径下，井臼四邻同。\n倦宦终何得，馀生寄此中。\n预烦多种秫，毋使酒杯空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田录事君义咏雪","author":"贺铸","text":"千里龙沙失旧荒，四来云物助苍凉。\n直疑见月应无影，未必因风始解狂。\n枉费铅华□楚女，不禁汤饼试何郎。\n回中自是人间世，怊怅龟台去路长。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田录事新燕","author":"贺铸","text":"新巢故国两依依，似与春华秋叶期。\n雨过池塘得泥近，日高台榭卷帘迟。\n鞦韆节后初相见，祓禊人归有所思。\n双侣多情拟凭杖，小笺封就碧云诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和别清凉和上人","author":"贺铸","text":"明朝解携白鹭洲，后日相望黄鹤楼。\n建业水清供白酌，武昌鱼贱足音邮。\n著身物外不无处，俛首人群非有求。\n愿报西庵落成会，待公退卧侬归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杜仲观青字诗二首 其一","author":"贺铸","text":"青袍少年子，独出青门游。\n逢人少青眼，凝笑望青楼。\n窗中青蛾女，正为青春愁。\n心事属青鸟，青骢能少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和钱德循书怀","author":"贺铸","text":"咄嗟世与我相疏，岁月推排负壮图。\n狂客大难兼外监，方回小得胜常奴。\n胸中累块亦何有，鬲上督邮非所须。\n径买一舟归自好，五云溪接当家湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彭城王生悼歌人盼盼","author":"贺铸","text":"东园花下记相逢，倩盼偷回一笑浓。\n书簏尚缄香豆蔻，镜奁初失玉芙蓉。\n歌阑燕子楼前月，魂断凤皇原上钟。\n寄语虞卿谩多赋，九泉无路达鱼封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答郑郎中见寄","author":"贺铸","text":"客子由来怀故乡，苏门冷落白云旁。\n梦随夜月钟前断，诗入秋风草共荒。\n操板镰靴游宦厌，开樽挥麈旧欢长。\n泜川逸老应相念，为倚阑干向夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘豳老汉上属目","author":"贺铸","text":"白云蒙山头，清川山下流。\n芳洲采香女，薄暮漾归舟。\n并蒂双荷叶，逢迎一障羞。\n持情不得语，大妇在高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝应野泊","author":"贺铸","text":"伏枕漳滨后，维舟楚泽边。\n筋骸非壮日，节物迫穷年。\n夜雨侵床漏，晨炊凑鼻烟。\n劳生我其分，十口亦飘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放舟下江留寄王元胥","author":"贺铸","text":"桧楫淹留已涉旬，小窗犹得酒相亲。\n寒潮不应溪流涩，病客未行舟子嗔。\n挥手便分今夜月，断肠先见隔江春。\n凤皇台上长回首，何处高城与故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"易官后呈交旧","author":"贺铸","text":"当年笔漫投，说剑气横秋。\n自负虎头相，谁封龙额侯。\n聊辞哙等伍，滥作诗家流。\n少待高常侍，功名晚岁收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦竹村南马上","author":"贺铸","text":"楚泽薰风后，林皋夕照间。\n渔船沿绿岸，鸟道转荒山。\n久负杯中乐，长偷马上闲。\n悠悠白门路，何日杖藜还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵怀寄历阳王掾","author":"贺铸","text":"征虏亭边路，望夫山下舟。\n长江不隔梦，明月祇供愁。\n促席歌尘断，闲窗醉墨留。\n惜芳桥畔柳，谁系木兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨馀晚望","author":"贺铸","text":"相应乳鸠鸣，桑间返照平。\n明津小舫度，高陇一牛耕。\n林薮归心健，尘埃病骨轻。\n屈骚魂爽在，未许独君清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴西郊寓目","author":"贺铸","text":"城中厌雨过清和，偶出西郊野意多。\n蚕簇趁晴初摘茧，麦场经润欲生蛾。\n营巢黄鸟啼深树，引犊青牛饮暮河。\n老圃念人留伫久，挽衣沽酒愿相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临汴亭送客还马上作","author":"贺铸","text":"衮衮尘埃与愿违，可堪持酒送将归。\n壮心已服驽骀老，羁思常先鸿雁飞。\n十口无厌太仓粟，四邻分采故山薇。\n何时偃卧柴桑里，自讼渊明昨日非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冠氏寺居书怀","author":"贺铸","text":"古刹荒凉昼掩门，鸣鸡吠犬接西村。\n窗间自记曾归梦，楼外谁招欲断魂。\n漫赋新诗题琬琰，少逢佳客佩兰荪。\n更堪愁肺经春病，负尔商歌酒一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冠氏县斋书事寄滏阳朋游","author":"贺铸","text":"小阁烧香麝煎浓，翠苔庭院绿阴风。\n卷帘燕自双飞去，敧枕人方半梦中。\n秋鬓先于怀县令，春愁多似义城公。\n西园酒伴无消息，欲寄鱼笺水自东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将发永城留题李氏斋壁","author":"贺铸","text":"匹马扁舟寄此身，可怜投老尚迷津。\n黄尘是处随游子，明日相逢即故人。\n东道琴樽能惜夜，西园花絮欲伤春。\n分携后日匆匆去，灯火虹桥梦更频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将发彭城作","author":"贺铸","text":"四年吟笑老东徐，满目溪山不负渠。\n得米径须偿酒债，有田便拟卜吾庐。\n明朝门外扁舟雪，别夜灯前满纸书。\n会问匆匆解携客，相思命驾定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"度黄叶岭怀寄清凉白云庵主","author":"贺铸","text":"黄叶岭头黄叶飞，白云庵畔白云归。\n叶随游子终相失，云伴禅翁得所依。\n会解腰间斩马剑，肯寻江上钓鱼矶。\n焚香扫地双林下，愿赎今生种种非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"待晓朝谒天庆作","author":"贺铸","text":"望晓谒琳宫，荒庭雾气浓。\n曾陪羽林仗，如待景阳钟。\n薄宦情无几，劳生梦不容。\n樵朋与渔伴，它日会相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春书","author":"贺铸","text":"新蚕经浴罢，旧燕未来前。\n吏局坐如梦，物华行可怜。\n藻生南浦钓，雨足东皋田。\n故国负归约，尘埃年复年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春怀有寄代同行作","author":"贺铸","text":"未应一笑为千金，且解樽前绿绮琴。\n归雁不将书北去，行云长伴日西沉。\n楚兰径远飞黄蝶，湘水帘空对绿阴。\n无复赏心酬节物，断肠翻咏白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋衣闻雨晨兴偶书","author":"贺铸","text":"故国心驰北，扁舟计漫东。\n寒生一夜雨，病涉两秋风。\n落泊篱根叶，幽忧屋角虫。\n何情悲节物，聊自况衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"贺铸","text":"室迩人尚远，况乎千里间。\n岂徒道路长，重水复重山。\n清霜老芳物，嘉树不堪攀。\n欲寄陇头信，春风殊未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舣舟当利口待风累日怀寄城中朋游二首 其一","author":"贺铸","text":"一叶寄津口，怒涛安可乘。\n朝风占酒旆，夜爨乞渔灯。\n牛渚逢新月，秦淮想结冰。\n故人它夕梦，歌吹满金陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舣舟当利口待风累日怀寄城中朋游二首 其二","author":"贺铸","text":"离忧不可解，罢酒独登临。\n潮落江空阔，云繁岁晏阴。\n愁鸱守渔罧，怒犬突神林。\n触目增悽断，聊为泽畔吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舣舟当利港作","author":"贺铸","text":"为问溪头潮浅深，片帆长挂北归心。\n夜风吹雪晓尤怒，午日破云寒复阴。\n江淮行役殊未已，京洛朋游安事寻。\n何时稳坐饱粗饭，鼓腹东皋农父吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送历阳潘司户瑶移令归东鲁","author":"贺铸","text":"衰俗纷纷务近功，几人心迹与君同。\n低回州县青衫列，踊跃圣贤黄卷中。\n牛渚江山空夜月，河阳桃李再春风。\n相望鲁卫无多远，异日能寻卖药翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送方安行之官高密令","author":"贺铸","text":"平世功名输阿童，束书洗剑栖渔篷。\n晚交东武百里长，想见桐庐三拜风。\n白雪兴阑吟社远，绿槐阴合讼庭空。\n它年朱绂指东道，试访钓鳌浮玉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送左禹赴江夏尉","author":"贺铸","text":"汎汎青翰舟，亭亭黄鹤楼。\n江山信清洒，人物想风流。\n美酒遣归思，新诗题旧游。\n有鱼知不食，端作置书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]