[{"title":"送净应老道源往浙右","author":"林表民","text":"片云离海屿，吴地去随缘。\n托钵应行乞，升床亦坐禅。\n舟停上塘雪，寺隔过山烟。\n刺史知闻旧，无须觅镜传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送薛子范明府归永嘉","author":"林表民","text":"天台邑债今还了，未上清班意若何。\n行李比如初到少，鬓丝赢得近来多。\n民输界首攀车送，君向城隅枉骑过。\n恨满东风不能到，柳边莺语即骊歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽开府宋公","author":"林表民","text":"五朝大老今谁是，晓月长庚可怆然。\n王某曾当挥制日，伏生将及授书年。\n雁峰去就朱轮养，台岭归从白布缠。\n秩视冢司优赠典，夜台光宠射穹躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王房州伯洪","author":"林表民","text":"崇牙出镇古边头，名与龚黄共一流。\n方见勒碑歌善政，忽惊罢市哭仁侯。\n燕飞古巷人千里，梅落寒溪月一楼。\n前事已非那可问，晚云零落绿山稠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽新昌王明府吉甫","author":"林表民","text":"不见高人祇自悲，每哦佳句望乌衣。\n浣花风月参谋去，采药溪山茂宰归。\n万里险艰头已白，半生功业梦还非。\n阿戎盍上青云路，奕世清门要发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄圣水老法照","author":"林表民","text":"五载禅林结净缘，又飞一锡过甘泉。\n晓池洗钵云常润，夜阁翻经月自圆。\n碧眼谁参庭畔柏，赤身难并社中莲。\n饱看胜景多佳句，好为闲人寄一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄饯赵清中主上元簿","author":"林表民","text":"六代旧都遗迹在，词人怀古去登临。\n长干塔上青山远，玄武湖边碧草深。\n肯把簿书遮望眼，但图方略副焦心。\n平江大海虽吾愿，台阁须材必访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台邵明府履善遗牡丹各赋一绝 其一","author":"林表民","text":"人间兴废手搏沙，乔木犹存少故家。\n不见石边题甲乙，空馀姓氏落名花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台邵明府履善遗牡丹各赋一绝 其四","author":"林表民","text":"一枝美过玉柈盂，岁晚何由复遇苏。\n我欲命名名不得，有名无实不如无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘允叔丈主簿读予所编天台集见赠之作","author":"林表民","text":"楼头残月映储胥，人在西窗酒醒馀。\n梦里都忘阆风路，吟边如到玉霄居。\n邻墙共作无何饮，别墅期看未见书。\n祇恐弓旌便招去，汉家答诏待相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬陈之道明府见赠","author":"林表民","text":"为政鄱君日，劬然似苦吟。\n光前还照后，行古却居今。\n危世道犹直，故山春正深。\n露生观庶物，清坐更观心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送祖太长老住虎丘","author":"林表民","text":"吴国前朝寺，悬知补处难。\n岳云迎外度，海月定中观。\n子去挥犀拂，吾当卖布单。\n梅花知别意，无语澹相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送宗镜上人归剡因寄声高九万孙季蕃 其四","author":"林表民","text":"随处禅房有水声，我来石上坐忘形。\n临行更酌潭中渌，要洗多生业障清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重建神秀楼","author":"林表民","text":"慨昔淳熙初，忠定守郡时。\n树楼城南门，众秀皆来归。\n插空缭千峤，注海合两溪。\n云眉扁古隶，蛟凤跃出飞。\n西瞻建标霞，东頫采菊篱。\n循环一甲子，天假兹良期。\n象贤宣祖烈，布政轶吏师。\n乘暇陟危级，更新敞前规。\n肆开落成宴，镫月交明辉。\n杰栋小芳桂，修梁薄辛夷。\n空阔渺纳纳，青红湿离离。\n太平毕文简，庆历元厚之。\n猗彼三硕辅，勋业畴或非。\n公今继其躅，岁月几推移。\n魏谟宝遗笏，郑武缁旧衣。\n过者登斯楼，咸诵金石词。\n却笑楚臣作，空因秋气悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽处士张君","author":"林表民","text":"扣龙泉了探慈湖，倦矣归携一束书。\n白首功名销壮气，清溪游钓乐闲居。\n山人宁有趋戎幕，方伯今谁顾草庐。\n乡旧凋零无复见，北风吹雨更愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽都梁太守洪季辅寺丞","author":"林表民","text":"鼓吹舟归日，军门巷哭时。\n身抛淮郡印，事入岘山碑。\n敌在家何用，城危孰与持。\n墓门今已闭，千载使人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀仙居赞府尤贵端","author":"林表民","text":"乐安山水佳，游屐独未至。\n复有县佐贤，欲见形梦寐。\n忆昨交际初，篝灯饮文字。\n数卷出宝储，三人若鼎峙。\n相忘略形骸，同道许气义。\n间之欻半期，仰止惟一志。\n咸言居官清，或说立趣异。\n对松悟诗玄，饮水乐书味。\n于此可怡悦，视彼持游戏。\n芸隐示倡酬，玉川辱简记。\n不敏既重惭，有碍亦每喟。\n牖月揖耿光，瓶梅想幽致。\n思苦夜无眠，吟成托邮骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题郑熙宁夫玉轩","author":"林表民","text":"良玉本不琢，大音无希声。\n观君命轩意，欲以诗自鸣。\n君诗志古调，考击参差韺。\n泠泠涧泉泣，切切溪条清。\n孚尹露涵采，润美月泛英。\n昔闻洛山中，种者须其成。\n非希咸阳价，椟韫那敢轻。\n用之荐穹昊，何但鬼神惊。\n凉欲觉庭叶，夜疏耿镫惊。\n一读一启予，古调真难评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简许远元寮","author":"林表民","text":"问云从何来，明月翳光景。\n须臾忽破散，依旧寒炯炯。\n问月何能照，月亦不自领。\n云来非我过，云去非我幸。\n无心付无事，虽巧不能逞。\n幽人起寤叹，婆娑弄清影。\n世人有万端，令人发深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题大慈寺兼简照讲师","author":"林表民","text":"来从金地过银地，智者修禅古道场。\n叠嶂倚空围日月，穹耸松壑饱风霜。\n碑文多是唐人刻，经卷犹随炀帝藏。\n偶值故交初入院，一镫留宿水声房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徐无竞所藏花光仁老墨梅","author":"林表民","text":"江路冥迷飞霰密，道人定起幽情逸。\n忽邀龙子幻新妆，粉淡香乾春一笔。\n寒梢瘦著苔衣昏，坏色空留梦里身。\n几回月堕交疏晓，霜发相看不知老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉漏迟 和赵立之","author":"林表民","text":"并湖游冶路。\n垂堤万柳，曲尘笼雾。\n草色将春，离思暗伤南浦。\n旧日愔愔坊陌，尚想得、画楼窗户。\n成远阻。\n凤笺空寄，燕梁何许。\n凄凉瘦损文园，记翠管联吟，玉壶通语。\n事逐征鸿，几度悲欢休数。\n莺醉乱花深里，悄难替、愁人分诉。\n空院宇。\n东风晚来吹雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游瑞岩","author":"林诚仲","text":"岩半松门敞不关，芒鞋竹杖重跻攀。\n天涵鉴水澄清里，人入披云杳蔼间。\n烧药炉寒烟草碧，镌诗石古雨苔斑。\n干戈满目何从适，日日青山共往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵廷秀待制玉蕊","author":"周必大","text":"姑射山前雪照人，长安水畔态尤真。\n步摇翘玉中心整，璎珞涂金四面匀。\n常笑荼醾藏浪蕊，独陪芍药殿馀春。\n自从唐代来天女，直到平园见后陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"教授两为玉蕊花赋长韵富赡清新老病无以奉酬辄用杨史君韵为谢","author":"林迪","text":"广行行实称才华，如节鸾和驭宝车。\n曾燕琼林天一幄，却吟玉蕊市三家。\n大篇追补唐诗阙，盛事常流鲁頖誇。\n别有冰姿延客住，白池剩种白莲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题","author":"林迪","text":"暇日来游九锁山，登龙踞虎恣跻攀。\n方瞳皓豁小天下，仙隐清越非人间。\n秘籍琼科辉映簇，白云朱鹤镇长闲。\n洞中丹灶开还未，愿觅刀圭驻瘠颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄陵题咏二首 其二","author":"林采","text":"地接熊湘尾，天开龙寿山。\n精蓝依石峡，远岫点烟鬟。\n青草渺茫外，黄陵顾盼间。\n攀缘寻古迹，足倦不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄陵题咏二首 其一","author":"林采","text":"舣棹黄陵岸，虔趋帝女祠。\n奠椒随楚俗，拂石读韩碑。\n北渚来何远，南巡事莫追。\n凄然鼓灵瑟，起舞想冯夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝耕","author":"林采","text":"钓螺江上一耕夫，误挂簪裳计已疏。\n来此劝农申告诫，要渠僇力事耕锄。\n田畴耒耜能无倦，禾稼收成自有馀。\n户晓更烦诸父老，俾知太守意劝渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登览","author":"林采","text":"二十四峰排玉苍，天开岩洞若堂堂。\n坛星七点夜横斗，石佛三身时放光。\n神护奎文常炳焕，仙遗丹灶久凄凉。\n登临不觉江村暮，归旗翩翩渡野航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"林采","text":"江浙东头六劝耕，随缘却到古南平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友至飞云渡","author":"林亮功","text":"五里风涛路，人烟隔岸洲。\n去帆攲绿水，别棹会中流。\n西岘钟声晓，东山塔影浮。\n何人有机事，惊起一沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彩云轩","author":"林俛","text":"沧海扬尘已几回，麻姑缓步此峰来。\n綵云缥缈闻仙乐，绿篆淋漓锁翠苔。\n仙境长留闲日月，飞仙宜号小蓬莱。\n凤箫鹤驭还相待，名籍今应在玉台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游罗浮","author":"林俛","text":"此日鹅城第一山，我来登览足清欢。\n心灰久不作春梦，食淡何须辍晚餐。\n宝积山中多佛刹，药槽峰外是仙坛。\n凭谁为扣葛翁诀，乞与当年九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏瑞桧","author":"林坰","text":"右殿当年欲葺时，槎牙高桧碍檐榱。\n人间斤斧难容手，天上风雷为转枝。\n烟色并来春益重，月华饶得夜相宜。\n真皇一驻銮舆赏，从此声名四海知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮江探梅","author":"林宪","text":"清游可以愈宿疾，梅花自能来好人。\n嗅花徐步沙碛里，天风液液回三春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其二 参云亭","author":"林宪","text":"孤云不可攀，浩气相与遥。\n著亭翠微顶，飞檐侵泬寥。\n紫麟迂远驾，黄鹄回扶摇。\n云收天籁息，亭影摩重霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州兜率寺淳熙三年孟春作 其一","author":"林宪","text":"一榻江色近，夜气欲空濛。\n柔橹晚潮上，寒灯深树中。\n四山杳烟雾，月华忽陵空。\n我亦众念息，帘影空玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹丘书怀","author":"林宪","text":"灵凤山前花片飞，读书窗下碧云栖。\n断崖流水春不尽，苦竹纹禽日夜啼。\n禽声不歇日欲暮，一点青灯照环堵。\n镆铘挂壁龙影寒，默坐焚香听春雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台万年山罗汉树","author":"林宪","text":"罗汉岭头罗汉树，开辟馀工所钟聚。\n百围直上摩紫霄，铁剥犀空自无蠹。\n积年魔怪不敢栖，暂过鸾凰却回顾。\n初晴偃干碍云霓，欲雨蟠根起烟雾。\n声回浪吼东海鲸，影落云侵石桥路。\n气陵太古化儿惊，势压群材梓人惧。\n阳开阴闭资指南，地弼天承赖撑拄。\n凡斤俗斧远遁逃，黛色苍皮未须疏。\n岩灵树异如相语，杰叶豪柯翠云覆。\n冰霜坐阅无古今，合抱云仍仰雄据。\n岂同涧梓与壑楠，未历千年随草腐。\n我来骇识天下奇，斗酒浇之共轩翥。\n行人莫拟明堂柱，险径无来万牛处。\n盛时要用真栋梁，宜使巇危可平骛。\n指呼刊凿动六丁，匠氏仍烦修月户。\n辅隆广厦蔽苍生，何止增华万年趣。\n悬崖黯惨阴风吐，振谷徘徊忽号怒。\n纤梢啸舞山雨来，石走雷轰鬼神怖。\n未容造次搜奇句，五百尊师所呵护。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台道中 其一","author":"林宪","text":"月色在野水，云痕澹前林。\n篮舆转松竹，襟袖翠霭深。\n灯火见仍隐，机杼有遗音。\n境静众念息，泠然发微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其一 双岩堂","author":"林宪","text":"两崖玉巉然，秀色真可餐。\n岚烟落窗几，惨澹云水閒。\n幽人美清夜，和月凭栏干。\n天空山影直，八表生晴寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其六 乐山堂","author":"林宪","text":"兹堂虽不华，三面受山色。\n直东接溟海，云雾时振翮。\n几年芜秽深，一日洞天折。\n悠然舒啸中，自得仁所宅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其四 玉霄亭","author":"林宪","text":"蜿蜒龙顾山，霄汉在人境。\n古亭压虚无，云气倒天景。\n天澄碧芙蕖，一叶一亭影。\n凝然千叶上，有客动深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其十二 节爱堂","author":"林宪","text":"圣人定规模，用节民自爱。\n后来巧施为，民害深可慨。\n先生寿正脉，吾道灿然在。\n揭以榜屋梁，流风万千载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其十 君子堂","author":"林宪","text":"古人不可逢，岂徒慕其名。\n兹堂号君子，想像劳我情。\n高山仰后世，作者追前声。\n何处见文简，堂虚风更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其十一 驻目亭","author":"林宪","text":"郡斋多胜览，随处山拱揖。\n一亭更留人，小立云百级。\n峰峦方献状，霾雾且无集。\n是中颇空洞，不碍山色入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其八 匿峰亭","author":"林宪","text":"千岭随指顾，一峰不可匿。\n如何超逸士，勘破造化迹。\n隐然胸中奇，盘礴岩烟碧。\n夜半秋月寒，人境俱峻极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其九 清平阁","author":"林宪","text":"饮浊斯贵清，路险斯贵平。\n明明古君子，日用无非诚。\n寒潭寒彻底，坦道安无倾。\n日用傥如此，政化天与成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其七 静镇堂","author":"林宪","text":"天下本无事，智者欣有作。\n谁能此堂上，静坐对寥廓。\n鱼游鸟翔回，千里受真乐。\n从渠锦绣肠，天壤自卜度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其三 凝思堂","author":"林宪","text":"远思八表外，澹然何所凝。\n苍岩窅空阒，修竹风泠泠。\n秋老竹亦瘦，月上岩更清。\n手持玉如意，天豁河汉明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州郡治十二诗太守尤延之命赋 其五 霞起堂","author":"林宪","text":"赤城在何处，明霞坐中起。\n大千无色界，向背五云里。\n羽人跨丹凤，千载一来止。\n咽漱餐泰和，琼田结珠蕊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州兜率寺淳熙三年孟春作 其二","author":"林宪","text":"春江泼天明，萧寺踞山坞。\n荒阶下鸟雀，古木飒风雨。\n徐行石苔花，徙倚望江渚。\n日暮山更寒，檐头铃自语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州兜率寺淳熙三年孟春作 其三","author":"林宪","text":"寺门阚南江，江势浩相向。\n风云互吞吐，山色豁林?。\n潮头捲飞烟，白雨挟春涨。\n中夜鹅鹜喧，谁家海船上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州兜率寺淳熙三年孟春作 其五","author":"林宪","text":"老树半藤萝，野色入窗户。\n空明浮屋梁，萧爽发幽趣。\n晚凉进微风，平江泻烟露。\n露久山月来，蝉声发高树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台州兜率寺淳熙三年孟春作 其四","author":"林宪","text":"月色半古寺，虫声杂疏钟。\n江城缭山色，星斗摇空濛。\n徐行不自觉，徙倚树影中。\n忽然变烟雨，江上东南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李才翁懒窝 其八","author":"林宪","text":"檐雀乐俦侣，砌蛩相叫吟。\n如何片云外，一点征遥禽。\n望极杳无伴，细听有遗音。\n迟迟去却返，启我怀故林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李才翁懒窝 其六","author":"林宪","text":"长镵长长柄，矮窗矮矮棂。\n西风已踰月，胡能不凄清。\n晴空舞皓鹤，夜气纷流萤。\n木叶不自觉，无风辄秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李才翁懒窝 其五","author":"林宪","text":"风雨日萧瑟，轩窗浸虚凉。\n清灯闪复定，寒漏为之长。\n老觉世念少，病须药物良。\n晨兴涤颤手，供此一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李才翁懒窝 其三","author":"林宪","text":"终日云气厚，寖寖雨将倾。\n如何才入夜，月轮皎如冰。\n云去露飞洒，星稀天熨平。\n正恐中秋节，未必如许清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李才翁懒窝 其一","author":"林宪","text":"鸮鸣夜沉沉，蛩语露泥泥。\n飞云带月来，投我襟袖里。\n心自彻太虚，痱颣忽一洗。\n世念傥尽消，万法亦聊尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李才翁懒窝 其七","author":"林宪","text":"月华浴沆瀣，天容注琉璃。\n皎如大圆镜，照彻清境晖。\n繁星敛芒曜，群动生霏微。\n尘世宁有此，玉虚楼观低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李才翁懒窝 其四","author":"林宪","text":"山林日月长，城市炎凉急。\n方看夏太清，已觉秋淅瑟。\n因之念故山，鹤归松露滴。\n收足否愿馀，此舟徒役役。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]