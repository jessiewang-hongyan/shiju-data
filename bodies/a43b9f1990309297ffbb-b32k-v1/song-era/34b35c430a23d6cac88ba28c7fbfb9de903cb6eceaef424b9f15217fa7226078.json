[{"title":"题懒庵 其一","author":"刘子翚","text":"幔亭隐沦翁，作庵更名懒。\n纷纭万念繁，要以一理遣。\n我衰百无长，此兴复不浅。\n他时傥卜邻，心赏符二阮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"橙子四首 其四","author":"刘子翚","text":"花瓷泛蜜小剂供，极有痛快鏖邪功。\n生枝滋味虽可口，流品故应甘下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"橙子四首 其三","author":"刘子翚","text":"自从天籞守吏散，老树零落烟云凄。\n今朝我为作知己，小摘秋风黄欲齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"橙子四首 其一","author":"刘子翚","text":"尚怀细雨初移日，著子已见清霜潸。\n绝怜面有贵人色，偶致吾侪樽俎间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕子","author":"刘子翚","text":"燕子何光彩，飞飞引众雏。\n营巢终老草，解语只含胡。\n贺厦恩非浅，焚宫祸亦殊。\n寥寥鸿鹄志，嗟汝岂能俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠宗周宾","author":"刘子翚","text":"我车南，君车北，相逢总是天涯客。\n拥炉谈笑一灯残，出门风雨千山隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霖雨","author":"刘子翚","text":"霖雨遂兼旬，瘴雾盈川谷。\n霏阴入户浮，润气滋帷褥。\n溟濛飞泽远，散漫何时足。\n骤响决流渠，惊洪发平陆。\n翔禽困滞翼，穴兽思冯木。\n衡茅日萎坏，环堵无完筑。\n昽匆晚色霁，草树晞华沐。\n长雷夜复兴，濯濯鸣高屋。\n抚枕不能寐，沈忧萃心曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邃老寄龙涎香二首 其二","author":"刘子翚","text":"知有名香出海隅，幽人得得寄吾庐。\n明窗小爇跏趺坐，更觉胸怀一事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言二首 其二","author":"刘子翚","text":"黄卷箧中昆友，白醪杯里圣贤。\n我愿长闲足矣，人怜独处萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言二首 其一","author":"刘子翚","text":"鼎食鼎烹谋拙，山南山北兴长。\n片梦彭殇寿夭，一枰汉楚兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春圃六言三首 其三","author":"刘子翚","text":"小冻犹残柳雪，新□□□□□。\n□□□□□□，□酒时须一中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春圃六言三首 其二","author":"刘子翚","text":"南堂面山已胜，北槛俯涧仍幽。\n千岩莫非石友，万壑总是清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春圃六言三首 其一","author":"刘子翚","text":"候骑不侵南海，好山多近吾庐。\n醒歌醉眠任我，朝奏暮召从渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致明惠莲栽","author":"刘子翚","text":"玉井初浮翠出，禅风渐扇红开。\n长梯顾我安得，净社如君盍来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题陈良臣颐轩四首 其四","author":"刘子翚","text":"道醇泮宫识面，德润梓里知名。\n相从固应未晚，畏君难弟难兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题陈良臣颐轩四首 其三","author":"刘子翚","text":"奇峰一叠两叠，乱涧清流浊流。\n那识高人胜处，阒然心地能幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题陈良臣颐轩四首 其二","author":"刘子翚","text":"啼鹃底用流血，渴水犹贪饮河。\n勿谓山雷象浅，人生口祸常多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题陈良臣颐轩四首 其一","author":"刘子翚","text":"七事疑生何晏，三爻梦感虞翻。\n独养灵龟不昧，有人高卧颐轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题郑尚明煮茶轩三首 其三","author":"刘子翚","text":"一点春回枯蘖，万家噪动寒墟。\n凤饼龙团玉食，伤心半入穹庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题郑尚明煮茶轩三首 其二","author":"刘子翚","text":"鼋鼎从渠染指，曲车绝念流涎。\n犹有清馋未已，茶瓯日食万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题郑尚明煮茶轩三首 其一","author":"刘子翚","text":"过耳飕飕未歇，装怀愦愦俄空。\n它日宁逃水厄，会须一访髯翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其二","author":"刘子翚","text":"伎俩无多子，逍遥自许时。\n闲愁且莫著双眉。\n恰有梅香一点、到幽闺。\n宠辱棋翻局，光阴鸟度枝。\n颓然径醉是便宜。\n拟倩潭风吹绿、涨瑶卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 和章潮洲二首 其一","author":"刘子翚","text":"卜夜容三献，微欢极一时。\n风流太守未庞眉。\n放出笔头光焰、压金闺。\n藻丽花骈蕊，清高雪亚枝。\n曼声恰与贯珠宜。\n听此直教拚得、醉翻卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 和明仲木犀花词","author":"刘子翚","text":"秋入微阴，凉生平远，小山愁绝天南。\n似闻还断，飞策遍千岩。\n叶底轻黄纂纂，恼人是、微裂芳缄。\n翛然胜，清真冷淡，无艳寄尘凡。\n澄潭。\n敧两岸，波光摇动，碧影相参。\n任西风十里，吹度松杉。\n我自寒灰槁木，□神处、不觉醺酣。\n归来晚，飞花无迹，明月满空函。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 寄宝学","author":"刘子翚","text":"浮烟冷雨，今日还重九。\n秋去又秋来，但黄花、年年如旧。\n平台戏马，无处问英雄；茅舍底，竹篱东，伫立时搔首。\n客来何有？\n草草三杯酒。\n一醉万缘空，莫贪伊、金印如斗。\n病翁老矣，谁共赋归来？\n芟垄麦，网溪鱼，未落他人后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 题小竿岭","author":"刘子寰","text":"今来古往吴京道。\n岁岁荣枯原上草。\n行人几度到江滨，不觉身随风树老。\n蒲花易晚芦花早。\n客里光阴如过鸟。\n一般垂柳短长亭，去路不如归路好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉漏迟 其二 秋","author":"刘子寰","text":"暮天初过。\n雨凄清，顿觉今年秋早。\n夜景虚明，仿佛露华清晓。\n蕙草繁花竞吐，向暗里、幽香缥缈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉漏迟 其一 夏","author":"刘子寰","text":"翠草侵园径。\n阴阴夏木，鸣鸠相应。\n纵目江天，窈窈雨昏烟暝。\n屋角黄梅乍熟，听落颗、时敲金井。\n深院静。\n闲阶自长，花砖苔晕。\n楼居簟枕清凉，尽永日阑干，与谁同凭。\n旧社鸥盟，零落断无音信。\n辽鹤追思旧事，向华表、空吟遗恨。\n萦念损。\n休怪暮年多病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"刘子寰","text":"长条袅袅串红绡。\n无风时自摇。\n十分娇艳更苗条。\n殢春情态娇。\n风影舞，露痕潮。\n买来和蝶饶。\n故园愁绝楚宫腰。\n相逢恨怎销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 寿史沧洲","author":"刘子寰","text":"雅歌堂下新堤路。\n柳外行人相语。\n碧藕开花，金桃结子，三见使君初度。\n楼台北渚。\n似画出西湖，水云深处。\n彩鹢双飞，水亭开宴近重午。\n溪蒲堪荐绿醑。\n幔亭何惜，为曾孙留住。\n碧水吟哦，沧洲梦想，未放舟横野渡。\n维申及甫。\n正夹辅中兴，擎天作柱。\n愿祝嵩高，岁添长命缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 西岩三涧","author":"刘子寰","text":"云壑泉泓，小者如杯，大者如罂。\n更石筵平莹，宽容数客，淙流回激，环绕飞觥。\n三涧交流，两崖悬瀑，捣雪飞霜落翠屏。\n经行处，有丹荑碧草，古木苍藤。\n徘徊却倚山楹。\n笑山水娱人若有情。\n见傍回侧转，峰峦叠叠，欲穷还有，岩谷层层。\n仰视云间，茅茨鸡犬，疑是仙家来避秦。\n青林表，望烟霞缥缈，隐隐鸾笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 庆叶镇五月初八","author":"刘子寰","text":"长寿真人，玉佩琼裾，霞衣月裳。\n趁桃迎初度，千年方熟，蒲经端午，三日留春。\n兰杜绥旌，芙蓉搴盖，飞下清源云水乡。\n摛烟雾，引天机组织，官样文章。\n丁年璧水横翔。\n馀剩馥残膏沾四方。\n仰平生声望，九霄星斗，方来事业，万里风樯。\n经世规模，出尘丰骨，须合盛之白玉堂。\n轩腾去，看雍容槐棘，福艾耆庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花发沁园春 呈史沧洲","author":"刘子寰","text":"换谱伊凉，选歌燕赵，一番乐事重起。\n花新笑靥，柳软纤腰，济楚众芳围里。\n年年佳会。\n长是傍、清明天气。\n正魏紫衣染天香，蜀妆红破春睡。\n一簇猩罗凤翠。\n遍东园西城，点检芳事。\n铃斋吏散，昼馆人稀，几阕管弦清脆。\n人生适意。\n流转共、风光游戏。\n到遇景，取次成欢，怎教良夜休醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼锦堂","author":"刘子寰","text":"思纵步，时自驻篮舆，策杖荒郊。\n为有柔荑可坐，野菜时挑。\n思忆家山行乐处，片心时逐野云飘。\n歌长铗、遥寄故人，归路赋隐辞招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 寄刘令君潜夫","author":"刘子寰","text":"风餍雨足，也解为花地。\n收拾浮云放新霁。\n爱调亭小翠，点滴猩红，新妆了，妃子朝来睡起。\n遥知春有主，整顿欢娱，兴在新亭锦围底。\n便选歌燕赵，授简邹枚，须记作他日，城山盛事。\n笑东君不用管杨花，任飞去天涯，在东风里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 登玉田峰","author":"刘子寰","text":"柱杖凌高绝。\n望千山隐隐，波澜动摇天末。\n下有白云平远壑，涌起潮头喷雪。\n浸绝岛、孤峰出没。\n赤县神州何处是，但风烟、杳杳迷空阔。\n呼不见，古人物。\n碧松枝下青瑶石。\n举头看、长空湛湛，淡琉璃色。\n上界屋辰多官府，夸父忙鞭日月。\n任兔走、乌飞超忽。\n宇宙茫茫如许大，百年间、何用争优劣。\n身世事，一毛发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 风泉峡观泉","author":"刘子寰","text":"云壑飞泉，蒲根下、悬流陆续。\n堪爱处、石池湛湛，一方寒玉。\n暑际直当磐石坐，渴来自引悬瓢掬。\n听泠泠、清响泻琮琤，胜丝竹。\n寒照胆，消炎燠。\n清彻骨，无尘俗。\n笑幽人忻玩，滞留空谷。\n静坐时看松鼠饮，醉眠不碍山禽浴。\n唤仙人、伴我酌琼瑶，餐秋菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解语花 雪","author":"刘子寰","text":"龙沙殿腊，兔苑留寒，花照冰壶夜。\n乱山平野。\n装珠树满眼，买春无价。\n墙头苑下。\n浑不见、桃夭杏冶。\n疑趁风、庾岭寒梅，触处都飘谢。\n吹面峭寒未怕。\n览瑶池万里，飞观高榭。\n霓旌鹤驾。\n歌黄竹、胜跃踏青骄马。\n峰峦似画。\n但点缀、片时相借。\n惊望中、玉宇琼楼，残溜空鸳瓦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 其一 寿参政","author":"刘子寰","text":"正霜浮菊浅，露染枫深，九秋佳景。\n梅报南枝，一点和羹信。\n峻岳生申，太山瞻鲁，瑞启千年运。\n飞帛奎文，仪皇韶祉，明良相庆。\n岁值丰登，道方开泰，塞骑尘收，海鲸波静。\n几斗璇枢，仰三阶平正。\n保定乾坤，亲扶日月，万宇同歌咏。\n比寿彭聃，侔勋周召，致君尧舜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 其二 寿史令人","author":"刘子寰","text":"正花深绣阁，带拂流酥，暖帘初试。\n窈窕笙歌，拥新鲜珠翠。\n艳菊留金，早梅催粉，趁得瑶池会。\n画馆凝香，仙家正住，芙蓉城里。\n裼寝开祥，玉枝祝寿，列院欢娱，满堂佳瑞。\n福寿双星，现碧霄云际。\n京兆时妆，如皋乐事，占世间荣贵。\n象服鱼轩，疏封大国，齐眉千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱","author":"刘子寰","text":"访莺花陈迹，姚魏遗风，绿阴成幄。\n尚有馀香，付宝阶红药。\n淮海维阳，物华天产，未觉输京洛。\n时世新妆，施朱傅粉，依然相若。\n束素腰纤，捻红唇小，鄣袖娇看，倚阑柔弱。\n玉佩琼琚，劝王孙行乐。\n况是韶华，为伊挽驻，未放离情薄。\n顾盼阶前，留连醉里，莫教零落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 子庆母八十","author":"刘子寰","text":"满前儿女。\n今日都欢聚。\n今也阿弥八十，儿也五十五。\n瓷瓯并瓦注。\n山歌和社舞。\n但管年年强健，妆成个、西王母。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 春愁","author":"刘子寰","text":"横阴漠漠。\n似觉罗衣薄。\n正是海棠时候，纱窗外、东风恶。\n惜春春寂寞。\n寻花花冷落。\n不会这些情味，元不是、念离索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"刘山老","text":"跛子年来，形容何似，俨然一部髭须。\n世间许大，拐上做工夫。\n选甚南州北县，逢著处、酒满葫芦。\n醺醺醉，不知明日，何处度朝晡。\n洛阳，花看了，归来帝里，一事全无。\n又还与瓠羹，再作门徒。\n蓦地思量下水，浪网上、芦席横铺。\n呵呵笑，睢阳门外，有个大南湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"刘丰禄","text":"海水奔腾朔风急，巨鳌震动坤轴折。\n茫茫水与云相连，中有仙人渺独立。\n槁梧三尺操南音，轻视功名等秋叶。\n调高韵古泣鬼神，毡帐轻弹燕蓟月。\n锦囊万里诗一编，字字丹心沥青血。\n回首铜仙旧梦寒，抚卷令人双鬓雪。\n祇今复作潇湘游，拟续离骚吊忠魄。\n独夜何心闻杜鹃，云暗苍梧正愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天封寺","author":"刘丹","text":"桂旗芝盖翳浓阴，严宇峥嵘枕柰林。\n蜺座有花和法雨，龙渊如鉴彻麸金。\n锡杖化去圆泉在，石志文昏乱藓侵。\n尘寰渐遥天路近，慈云辉物已灰心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三 寿陈山泉","author":"刘云甫","text":"一点郎星光彻晓。\n许大乾坤，难著经纶手。\n拂袖归来应自笑。\n山翁偏爱林泉好。\n庭下儿孙歌寿酒。\n不献蟠桃，不数安期枣。\n且喜今朝云出岫。\n定知霖雨苍生早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 赠傀儡人刘师父","author":"刘仁父","text":"不假牵丝，何劳刻木。\n天然容貌施妆束。\n把头全仗姓刘人，就中学写秦城筑。\n伎俩优长，恢谐软熟。\n当场喝采醒群目。\n赠行无以表殷勤，特将谢意标芳轴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雨剪春韭","author":"刘允成","text":"杜老情何恨，东风夜雨春。\n炊粱留客款，剪韭荐时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翻帙得菊叶","author":"刘元茂","text":"何年霜后黄花叶，色蠹犹存旧卷诗。\n曾是往来篱下读，一枝闲弄被风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次花翁览镜韵","author":"刘元茂","text":"世事磨砻石退棱，此心何爱复何憎。\n门因候客时时扫，楼为看山日日登。\n分粟可留巢树鹤，种蔬堪供在家僧。\n形容每笑临清镜，相对骎骎作老朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早梅","author":"刘元载妻","text":"南枝向暖北枝寒，一种春风有两般。\n凭仗高楼莫吹笛，大家留取倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冶城楼","author":"刘元高","text":"俯仰明知尽可悲，西风还此立多时。\n偶然唤醒东山客，便有淮淝一局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦淮","author":"刘元高","text":"横凿南山贯北津，安知丰沛有真人。\n六朝不得中原土，犹使英雄欲过秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 寿女人二月十一","author":"刘公子","text":"搀先四日花朝节。\n红紫争罗列。\n传言玉女降生朝。\n箕宿光联婺宿、灿云霄。\n斑衣红袖齐歌舞。\n称颂椒觞举。\n群仙列侍宴瑶池。\n王母麻姑同寿、更无期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观北山先生可友亭帖子有索余著句辞不敢僭而请益坚辄题二十八字因勉后人善断先志云","author":"刘六芝","text":"古道今人慨不同，世情对面九疑峰。\n四尖山色元如旧，会构新亭始亢宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘卞","text":"木围三寺影，川合两江波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一萼红 夜闻南妇哭北夫","author":"刘天迪","text":"拥孤衾，正朔风凄紧，毡帐夜生寒。\n春梦无凭，秋期又误，迢递烟水云山。\n断肠处、黄茅瘴雨，恨骢马、憔悴只空还。\n揉翠盟孤，啼红怨切，暗老朱颜。\n堪叹扬州十里，甚倡条冶叶，不省春残。\n蔡琰悲笳，昭君怨曲，何预当日悲欢。\n谩赢得、西邻倦客，空惆怅、今古上眉端。\n梦破梅花，角声又报春阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤栖梧 舞酒妓","author":"刘天迪","text":"一剪晴波娇欲溜。\n绿怨红愁，长为春风瘦。\n舞罢金杯眉黛皱。\n背人倦倚晴窗绣。\n脸晕潮生微带酒。\n催唱新词，不应频摇手。\n闲把琵琶调未就。\n羞郎却又垂红袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 严县尹度上和李观我韵","author":"刘天迪","text":"瑞麟香软飞瑶席，吟仙笑陪欢宴。\n桐影吹香，梅阴弄碧，一味微凉堪荐。\n停杯缓劝。\n记罗帕求诗，琵琶遮面。\n十载扬州，梦回前事楚云远。\n人生总是逆旅，但相逢一笑，如此何限。\n采石宫袍，沈香醉笔，何似轻衫小扇。\n流年暗换。\n甚新雨情怀，故园心眼。\n明日西江，斜阳帆影转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 书事","author":"刘天迪","text":"一笑相逢，依稀似是桃根旧。\n娇波频溜。\n悄可灵犀透。\n扶过危桥，轻引纤纤手。\n频回首。\n何时还又。\n微月黄昏后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 春残念远","author":"刘天迪","text":"子规解劝春归去。\n春亦无心住。\n江南风景正堪怜。\n到得而今不去、待何年。\n无端往事萦心曲。\n两鬓先惊绿。\n蔷薇花发望春归。\n谢了蔷薇、又见楝花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]