[{"title":"溪村 其一","author":"朱继芳","text":"榉柳正当官道，渔舟偏系柴门。\n今年春水深浅，看取层层岸痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪村 其二","author":"朱继芳","text":"雨洗山光绿净，波涵天影清空。\n草际自浮鹅鸭，柳阴分坐儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少年游","author":"朱继芳","text":"紫陌寻芳爱马迟，一春能得几晴时。\n海棠露重衣全透，杨柳风微帽半攲。\n大白引浮银凿落，小红吹彻玉参差。\n人生行乐须年少，莫等星星满镜丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石通洞","author":"朱翁","text":"披棘扪萝入洞中，拂尘剥藓识涪翁。\n我缘直道来施右，君为清诗到石通。\n定后寂寥无异议，危初萋菲竟何功。\n投豺畀北言犹在，厄宋饥陈道不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹤仙 寿秦伯和侍郎","author":"朱耆寿","text":"樱桃抄乳酪。\n正雨厌肥梅，风忺吹箨。\n咸瞻格天阁。\n见十眉环侍，争鸣弦索。\n茶瓯试瀹。\n更良夜、沈沈细酌。\n问间生、此日为谁，曾向玉皇、案前持橐。\n龟鹤。\n从他祝寿，未比当年，阴功堪托。\n天应不错。\n教公议，细评泊。\n自和戎以来，谋国多少，萧曹卫霍。\n奈胡儿自若，惟守绍兴旧约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画堂春","author":"朱埴","text":"绿窗睡起小妆残。\n玉钗低堕云鬟。\n回纹枉寄见伊难。\n心绪阑珊。\n翠袖两行珠泪，画楼十二阑干。\n销磨今古霎时间。\n恨杀青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子","author":"朱埴","text":"花柳隔重扃。\n送过秋千笑语声。\n檐鹊也嗔人起晚，天晴。\n孤负东风趁踏青。\n细细砑红绫。\n小字相思写不成。\n心上可人云样远，寒盟。\n只恐恩情薄似云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"朱埴","text":"绣被鸳鸯，宝香熏透蔷薇水。\n枕边一纸。\n明月人千里。\n宿酒初醒，全不忺梳洗。\n抬纤指。\n微签玉齿。\n百色思量起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题","author":"朱堂","text":"地胜群峰秀，山高宿雾昏。\n灵宫从昔著，仙迹至今存。\n嵌洞窥天巧，飞泉挟石奔。\n尘缘何日了，小筑占云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"朱惟贤","text":"层檐月印高低影，寒壑风号远近声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一华亭","author":"朱敏功","text":"自闻达摩西来意，五叶敷荣祇一花。\n从此祖风传不泯，灵芝到处有奇华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叠綵岩登越亭","author":"朱晞颜","text":"不到越亭久，榴花今已红。\n江流寒泻玉，山色翠浮空。\n百粤薰风里，三湘夕照中。\n行藏仗忠信，六合本同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子","author":"朱晞颜","text":"影落三秋月，寒生六月霜。\n是谁幻出玉筼筜。\n乞与一枝和雪、钓漓湘。\n劲节依琳馆，虚心陋草堂。\n笔端元自有雌黄。\n疑是化龙蜚到、葛仙旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陆子静先生","author":"朱桴","text":"此理于人无间然，昏明何事异天渊。\n自从断却閒牵引，俯仰周旋只事天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"朱梅居","text":"物态却从无处有，世情偏向苦中甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二色梅","author":"朱淑真","text":"缀雪融酥各自芳，两般颜色一般香。\n瑶池会罢朝元客，缟素仙裳问道装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书窗即事二首 其一","author":"朱淑真","text":"花落春无语，春归鸟自啼。\n多情是蜂蝶，飞过粉墙西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长春花","author":"朱淑真","text":"一枝才谢一枝殷，自是春工不与闲。\n纵使牡丹称绝艳，到头荣瘁片时间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长宵","author":"朱淑真","text":"月转西窗斗帐深，灯昏香烬拥寒衾。\n魂飞何处临风笛，肠断谁家捣夜砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长宵","author":"朱淑真","text":"霜月照人悄，迢迢夜未阑。\n鸳帏梦展转，珠泪向谁弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东马塍","author":"朱淑真","text":"一塍芳草碧芋芋，活水穿花暗护田。\n蚕事正忙农事急，不知春色为谁妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代谢人见惠墨竹","author":"朱淑真","text":"纷纷桃李皆凡俗，四时之中惟有竹。\n非惟苍翠列风轻，对之自觉清人肉。\n羡君年少多才艺，笔墨潜偷造化力。\n扫出一枝爰惠我，清阴翠色惊满幅。\n嗟我得之喜何以，贪夫忽获珠盈斛。\n朝夕捧玩不知疲，如在太白楼上宿。\n遽令标轴挂壁间，劲节直日长目前。\n不必溪边寻六逸，不必林间访七贤。\n岂使阎本与王维，独擅古念称神师。\n又有屏间名浪得，误墨成形何足奇。\n未若一笔扫一枝，渭川移来人莫疑。\n珍藏欲默默不得，命笺索笔成新诗。\n诗穷纸满意不尽，阁笔无语愧才稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日梅窗书事四首 其一","author":"朱淑真","text":"明窗瑩几净无尘，月映幽窗夜色新。\n惟有梅花无限意，射人又放一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日梅窗书事四首 其二","author":"朱淑真","text":"爱日烘檐暖似春，梅花描摸雪精神。\n清香未寄江南梦，偏恼幽闲独睡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日梅窗书事四首 其三","author":"朱淑真","text":"病起眼前俱不喜，可人唯有一枝梅。\n未容明月横疏影，且得清香寄酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日梅窗书事四首 其四","author":"朱淑真","text":"的皪江梅浅浅春，小窗相对自清新。\n幽香特地成牵役，不似梨花入梦频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜不寐","author":"朱淑真","text":"推枕鸳帏不奈寒，起来霜月转阑干。\n闷怀脉脉与谁说，泪滴罗衣不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹 其二","author":"朱淑真","text":"百竿直节拂云霁，千亩谁人羡渭溪。\n燕雀谩教来唧噪，虚心终待凤凰栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对秋有感","author":"朱淑真","text":"风倍凄凉月倍明，人间占得十分清。\n可怜宋玉多才子，只为多情苦怆情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对景漫成","author":"朱淑真","text":"半窗残照一帘风，小小池亭竹径通。\n枫叶醉红秋色里，两三行雁夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧愁二首 其一","author":"朱淑真","text":"银屏屈曲障春风，独抱寒衾睡正浓。\n啼鸟一声惊梦破，乱愁依旧锁眉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧愁二首 其二","author":"朱淑真","text":"花影重重叠绮窗，篆烟飞上枕屏香。\n无情莺舌惊春梦，唤起愁人对夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝 其一","author":"朱淑真","text":"管弦催上锦裀时，体段轻盈祇欲飞。\n若使明皇当日见，阿蛮无计况杨妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝 其二","author":"朱淑真","text":"香茵稳衬半钩月，来往淩波云影灭。\n弦催紧拍捉将遍，两袖翻然做回雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝 其三","author":"朱淑真","text":"柳腰不被春拘管，凤转鸾回霞袖缓。\n舞彻伊州力不禁，筵前扑簌花飞满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝 其五","author":"朱淑真","text":"烛花影里粉姿闲，一点愁侵两点山。\n不怕带他飞燕妒，无言相逐省弓弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝 其四","author":"朱淑真","text":"占断京华第一春，清歌妙舞实超群。\n只愁到晓人星散，化作巫山一段云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊林和靖二者 其一","author":"朱淑真","text":"不见孤山处士星，西湖风月为谁清。\n当时寂寞冰霜下，两句诗成万古名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊林和靖二者 其二","author":"朱淑真","text":"短篷载影夜归时，月白风清易得诗。\n不识酌泉拈菊意，一庭寒翠蔼空祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春有感","author":"朱淑真","text":"倦对飘零满径花，静闻春水闹鸣蛙。\n故人何处草空碧，撩乱寸心天一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约游春不去二首 其二","author":"朱淑真","text":"少年意思懒能酬，爱好心情一向休。\n若到旧家游冶处，只应满眼是春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约游春不去二首 其一","author":"朱淑真","text":"邻姬约我踏青游，强拂愁眉下小楼。\n去户欲行还自省，也知憔悴见人羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自责二首 其一","author":"朱淑真","text":"女子弄文诚可罪，那堪咏月更吟风。\n磨穿铁砚成何事，绣折金针却有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自责二首 其二","author":"朱淑真","text":"闷无消遣只看诗，又见诗中话别离。\n添得情怀转萧索，如知伶俐不如痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行即事七首 其四","author":"朱淑真","text":"满江流水万重波，未似幽怀别恨多。\n目断亲闱瞻不到，临风挥沔独悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行即事七首 其五","author":"朱淑真","text":"对景如何可遣怀，与谁江上共诗裁。\n江长景好是难尽，每自临风愧乏才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行即事七首 其三","author":"朱淑真","text":"画舸寒江江上亭，行舟来去泛纵横。\n无端添起思乡意，一字天边归雁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行即事七首 其六","author":"朱淑真","text":"岁暮天涯客异乡，扁舟今又度潇湘。\n颦眉独坐水窗下，泪滴罗衣暗断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行即事七首 其一","author":"朱淑真","text":"帆高风顺疾如飞，天阔波平远又低。\n山色水光随地改，共谁裁剪入新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋雨晴","author":"朱淑真","text":"雨后风凉暑气收，庭梧叶叶报初秋。\n浮云尽逐黄昏去，楼角新蟾挂玉钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏二首 其二","author":"朱淑真","text":"冰蚕欲茧二桑阴，粉箨彫风曲径深。\n长日渐成微暑意，喜看楼影浸波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清昼","author":"朱淑真","text":"竹摇清影罩幽窗，两两时禽噪夕阳。\n谢却海棠飞尽絮，困人天气日初长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"朱淑真","text":"旋妆冷火试龙涎，香绕屏山不动烟。\n帘幕半垂灯烛暗，酒阑时节未忺眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔷薇花 其二","author":"朱淑真","text":"满地红影蘸秋光，始觉芙蓉植在旁。\n赖有佳人频醉赏，和将红粉更施妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闷怀二首 其一","author":"朱淑真","text":"黄昏院落雨潇潇，独对孤灯恨气高。\n针钱懒拈肠自断，梧桐叶叶剪风刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雨二首 其一","author":"朱淑真","text":"抱影无眠坐夜阑，窗风战雨下琅玕。\n我将好况供陪梦，只恐灯花不耐寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画眉","author":"朱淑真","text":"晓来偶意画愁眉，种种新妆试略施。\n堪笑时人争彷佛，满城将谓是时宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨别","author":"朱淑真","text":"调朱弄粉总无心，瘦觉宽馀缠臂金。\n别后大拚憔悴损，思情未抵此情深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨春五首 其一","author":"朱淑真","text":"樱桃初荐杏梅酸，槐嫩风高麦秀寒。\n惆怅东君太情薄，挽留时暂也应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上小集","author":"朱淑真","text":"门前春水碧于天，坐上诗人逸似仙。\n白璧一双无玷缺，吹箫归去又无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其二","author":"朱淑真","text":"柳丝拂拂弄东风，日色春容一样同。\n嫩草破烟开秀绿，小桃和露拆香红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其三","author":"朱淑真","text":"松松丽日约馀寒，春向梅边柳上添。\n蜂蝶自知新得意，展须忙翅入层帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其四","author":"朱淑真","text":"柳垂新绿腻烟光，紫燕惺松语画梁。\n午睡忽惊鸡唱罢，日移花影上窗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其五","author":"朱淑真","text":"捲帘月挂一钩斜，愁到黄昏转更加。\n独坐小窗无伴侣，凝情羞对海棠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其六","author":"朱淑真","text":"斗草寻花正及时，不为容易见芳菲。\n谁能更觑闲针线，且殢春光伴酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其七","author":"朱淑真","text":"月筛窗幌好风生，病眼伤春泪欲倾。\n写字弹琴无意绪，踏青挑菜没心情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其八","author":"朱淑真","text":"一年好处清明近，已觉春光大半休。\n点检芳菲多少在，翠深红浅已关愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其九","author":"朱淑真","text":"濛濛细雨湿香尘，似欲藏鸦柳色新。\n斗草工夫浑忘却，祇凭诗酒破除春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂书十首 其十","author":"朱淑真","text":"自入春来日日愁，惜花翻作为花羞。\n呢喃飞过双双燕，嗔我帘垂不上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日闲坐","author":"朱淑真","text":"社燕归来春正浓，摧花雨倩一番风。\n倚楼闲省经由处，月馆云藏望眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日亭上观鱼","author":"朱淑真","text":"春暖长江水正清，洋洋得意漾波生。\n非无欲透龙门志，只待新雷震一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春归五首 其一","author":"朱淑真","text":"片片飞花弄晚晖，杜鹃啼血诉春归。\n凭谁碍断春归路，更且留连伴翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春归五首 其二","author":"朱淑真","text":"满地落花初过雨，一声啼鸟已春归。\n午窗梦觉情怀恶，风絮欺人故著衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春归五首 其三","author":"朱淑真","text":"狼藉花因昨夜风，春归了不见行踪。\n孤吟茕坐清如水，忆得轻离十二峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春归五首 其四","author":"朱淑真","text":"一点芳心冷若灰，寂无梦想惹尘埃。\n东君总领莺花处，浪蝶狂蜂不自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]