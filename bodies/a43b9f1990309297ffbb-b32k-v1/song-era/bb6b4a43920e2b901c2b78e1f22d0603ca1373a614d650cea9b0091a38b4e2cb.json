[{"title":"即事","author":"陈元晋","text":"庭草茸茸书带碧，槛榴粲粲舞裙红。\n静观物化机无息，又转薰琴一信风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"陈元晋","text":"金幡胜里唤春归，却后新正八日期。\n红紫莫嫌春较晚，开迟应是落还迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独夜 其一","author":"陈元晋","text":"月转庭除夜未央，坐看梧影上东墙。\n金风玉露方清绝，只欠探枝桂子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独夜 其二","author":"陈元晋","text":"雨作寒声落枕边，搅人愁绪不成眠。\n非关独夜难排遣，为怕秋风在眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅仙峰","author":"陈元晋","text":"文陛无阶寄履声，骖鸾有路学仙灵。\n长安宫殿今何处，祇有梅峰万古青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁字","author":"陈元晋","text":"超然圣处过张颠，整整斜斜落照边。\n好写人间不平事，叫开阊阖为笺天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西斋","author":"陈元晋","text":"唔咿一室特蘧庐，要读人间未见书。\n快著先鞭问前路，西昆玉府富珍储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈氏镜湖 其一","author":"陈元晋","text":"贺监归欤百不求，问天只觅鉴湖秋。\n夫君剩有闲田地，凿破天悭得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈氏镜湖 其二","author":"陈元晋","text":"水上观心即是禅，此心如镜察天渊。\n一尘不著风波静，俯水何惭镜里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾审言所寓僧舍梅屋 其一","author":"陈元晋","text":"作屋延梅更凿池，是花最与水相宜。\n横斜清浅黄昏月，画出孤山两句诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾审言所寓僧舍梅屋 其二","author":"陈元晋","text":"倾盖知心两玉人，竹君邂逅更情亲。\n能同此味花君子，来共团栾一笑春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月初十夜对月呈留粹中","author":"陈元晋","text":"人间寒信到阶蛩，天外清商入井桐。\n孤馆无人同夜月，长年作客又秋风。\n想君局促重帘底，似我栖迟逆旅中。\n何事人生苦拘束，得闲来此一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上留提刑寿 其一","author":"陈元晋","text":"中秋清绝冠秋天，间气生贤得月先。\n一念来从金粟洞，三生曾伴赤松仙。\n绣衣踏遍江湖上，线履催归雨露边。\n且别崆峒朝帝去，它年来拍广成肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上留提刑寿 其二","author":"陈元晋","text":"展开南极老人图，是处青烟鹊尾炉。\n秋露九原沦厚泽，春风一道泳康衢。\n万金药散疲羸活，三尺刑清怨叹苏。\n只此阴功谁比大，中书有考可酬无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仓檄出惠阳督诸邑捕蝗","author":"陈元晋","text":"古来传说驱蝗法，近岁惊闻田有蝗。\n无耐吏饕甘地恶，何辜民病重天殃。\n秋风要满扶犁望，夏日宁辞走檄忙。\n高廪更令无雀鼠，使星尸祝几炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王推官载酒来会于逍遥堂","author":"陈元晋","text":"路入烟萝杳霭中，良宵一笑美人同。\n壶觞尽揽平湖月，弦管时飘别岸风。\n三宿未忘缘境胜，一灯相对坐诗穷。\n姓名要共青山久，看取当年玉局翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代饯转运判官赵帑辖 其二","author":"陈元晋","text":"憔悴湘滨客，怀哉有此逢。\n二星欣照映，三月惬游从。\n公事如羹沸，归心似酒醲。\n从今殊出处，别语且从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代饯转运判官赵帑辖 其一","author":"陈元晋","text":"今代汉宗英，如公不数人。\n清标高岳柱，和气蔼湘春。\n宣室思才子，甘泉欠侍臣。\n平生刘子政，晚节更精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代挽寺丞吴公","author":"陈元晋","text":"国事须才急，如公亦古人。\n江淮老麾节，俎豆哭军民。\n图忆筹边旧，官传结绶新。\n朔风吹老泪，泉路湿寒燐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"帅节留先生两年粤服氓獠安之一日疏十宜归欲袖手板还丞相言者犹不之置上命以釐廷之禄解印东归门生临川陈元晋援后山送坡仙故事至惠之海丰而别作诗四章云 其二","author":"陈元晋","text":"描画终无说，归来岂不荣。\n事难工拙较，我自去留轻。\n过眼风波恶，悬空日月明。\n人生只恁是，孤鹤九皋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"帅节留先生两年粤服氓獠安之一日疏十宜归欲袖手板还丞相言者犹不之置上命以釐廷之禄解印东归门生临川陈元晋援后山送坡仙故事至惠之海丰而别作诗四章云 其四","author":"陈元晋","text":"木种十年计，苓培千岁根。\n三生疑宿植，九殒志酬恩。\n远送竟须别，百怀难具论。\n任安穷自分，义不辱公门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲申乙酉丙戌四过钓台有感","author":"陈元晋","text":"三年四过子陵台，老我风霜两鬓催。\n望见云山心已愧，梦登钓石眼为开。\n乾坤清气长如许，钟鼎元勋安在哉。\n近百年来几帆过，登临多是觅官来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和涂宣义喜雨","author":"陈元晋","text":"郡邑同寅祷旱乾，风霆来会雨千山。\n真成雨粟从天下，只在为云翻手间。\n神不素餐无愧色，农期一饱足欢颜。\n丰年酒熟鸡豚社，二老从今请往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安抚徽猷郎中被召欲东赋诗见志乃以得归闲退为喜门人小子知先生之心也辄和严韵用畅高风 其二","author":"陈元晋","text":"聱叟挥车倦且归，钓游旧处足娱嬉。\n客怀自分三宜去，世事那无一可为。\n昼日高眠甘茗乳，秋风清饮饱莼丝。\n何当为背奚奴锦，收拾潭州归后诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安抚徽猷郎中被召欲东赋诗见志乃以得归闲退为喜门人小子知先生之心也辄和严韵用畅高风 其一","author":"陈元晋","text":"莫管声名草木知，人生待足是何时。\n兴才尽处须回棹，涂到迷时漫泣岐。\n老我昨非今似是，笑渠小黠大还痴。\n山林晚觉中多味，不怪商颜只茹芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆涂权尉三首 其三","author":"陈元晋","text":"朝忧猛虎夕长蛇，吊战场文忆李华。\n自笑病来宽带眼，那能老去植幢牙。\n如君政合登东阁，顾我惟堪老北涯。\n宾主秋风南浦路，旗铃好听捷音哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆涂权尉三首 其二","author":"陈元晋","text":"岁月遒于赴壑蛇，功名政要及年华。\n平淮犹自须裴度，钓渭那能老子牙。\n舞袖巧悬嫌地褊，酒杯相属记天涯。\n期君酣战秋风里，鼓率衔枚阵不哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆涂权尉三首 其一","author":"陈元晋","text":"袖中光焰吐青蛇，献策军门鬓未华。\n岂是轻身探虎穴，要将赤手拔鲸牙。\n向来笔研浑无力，此去功名正未涯。\n小试柳营新号令，六花排阵寂无哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪游再用前韵","author":"陈元晋","text":"松篁一径夹长蛇，云锦重重肃九华。\n长夏飞泉倾石眼，半空悬磴啄檐牙。\n要知酒兴并诗料，不在山巅即水涯。\n记取松间休喝道，山灵应怕俗声哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过南安道中 其二","author":"陈元晋","text":"火乘金伏势方骄，天地围炉万物焦。\n那信炎蒸天六月，却闻优渥雨三朝。\n顿添秋思生庭树，颇觉春痕涨市桥。\n分我清风陪独夜，又愁明月渺难招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过桐庐县","author":"陈元晋","text":"严陵耕钓处，清淑故依然。\n楼馆危临水，人烟近倚天。\n客行桑下路，晨垦岭头田。\n迟我风帆便，津头更觅钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵市","author":"陈元晋","text":"暝色低平野，霜风放霁天。\n买杯逢竹所，索句立梅前。\n山曲云归寺，溪寒水带烟。\n茅檐听残雪，愁绝拥衾眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈守喜雨诗 其一","author":"陈元晋","text":"垤鹳无声口舌乾，谁驱雷雨遍千山。\n顿苏赤地千里旱，特出黄堂一念间。\n泽物功深无德色，丰年愿遂有欢颜。\n为霖祇恐思贤佐，千骑东随凤诏还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈守喜雨诗 其二","author":"陈元晋","text":"谁念东南膏血乾，文移督迫积如山。\n平时素号镬汤底，不雨岂逃沟壑间。\n民病向来犹在耳，天威此去不违颜。\n从容宣室如前席，乞与枯荄生意还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柴大监留郎中游郁孤及喜雨之什 其二","author":"陈元晋","text":"农亩皇皇望有秋，肩赪背裂汗衣流。\n疲氓不得一饭饱，我辈应惭多食浮。\n乌尾督逋无迫遽，鼠牙有讼怕淹留。\n两君一念回天速，天雨看看粟满畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柴大监留郎中游郁孤及喜雨之什 其一","author":"陈元晋","text":"冰壶清对玉衡秋，台府同时尽胜流。\n南国恩波如海阔，西江和气接天浮。\n山川真借两贤重，翰墨仍为八境留。\n见说九重思魏笏，书帷更欲学君畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和留少微丰湖怀坡仙韵","author":"陈元晋","text":"吊古谁翻楚些歌，百年陈迹怆怀多。\n春风草绿松根寺，夜雨灯寒窣堵波。\n老鹤旧曾陪杖履，闲鸥今尚护烟莎。\n凭君莫忆当时事，惆怅人间春梦婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯余倅鼎叟官满东归","author":"陈元晋","text":"丙年同佐牧，相与最情亲。\n乘月登楼夜，随风步屧春。\n报来升转速，归去召除新。\n一剑旧肝胆，持将问大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信国鲁夫人挽诗二首 其二","author":"陈元晋","text":"曾是王圭坐上人，孰知孟母德无邻。\n长怀就养板舆日，一笑能回花县春。\n诗感棘风知痛苦，歌翻薤露亦酸辛。\n送车千两瑶塘路，奔走无从愧负薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信国鲁夫人挽诗二首 其一","author":"陈元晋","text":"讵有陈平解久贫，共看眉案久如宾。\n从夫荣荷西清橐，承祖恪共南涧蘋。\n玉树庭前双使节，金花天上九恩纶。\n绣衣綵服今非昔，忍见堂萱雪后春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邓帅参文举得南雄守归","author":"陈元晋","text":"风流耆旧传，悃愊静无华。\n来重青油幕，归乘皂盖车。\n离筵倾柏叶，客路看梅花。\n闻有南来信，门前迓骑哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽饶武博二首 其二","author":"陈元晋","text":"内集侪甥舅，同登齿弟兄。\n忘年情好密，开口肺肝倾。\n恍尔同醒醉，伤哉隔死生。\n朔风吹老泪，哀些不成声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽饶武博二首 其一","author":"陈元晋","text":"方客戎幢右，俄旌墓道傍。\n堂虚空老桂，星冷落魁芒。\n留世程文样，传家奏稿香。\n乡评偕李谢，虽死有幽光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽德庆涂守二首 其二","author":"陈元晋","text":"乡枌生也晚，岭外偶同寅。\n齿我子侄行，情如兄弟亲。\n不嫌同幕辩，要作一州春。\n满涧多题字，回头更怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽德庆涂守二首 其一","author":"陈元晋","text":"九京嗟已矣，今吏孰如君。\n律己严三尺，活人宽一分。\n清名寒蜀雪，嘉诵蔼南云。\n杉柏风凄切，黄陂原上坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步","author":"陈元晋","text":"鼓钟灯火后，袖手过栏干。\n素月空中寂，疏星竹里看。\n溪毛行步湿，潭影古心寒。\n此意我方适，亭亭夜未残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪作","author":"陈元晋","text":"帘捲虚堂晓，儿童笑语哗。\n恍疑开月窟，浑是散天花。\n竹里闻清响，江边看玉槎。\n访梅乘好兴，著屐过邻家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨上项帅","author":"陈元晋","text":"精祈三日竟成霖，一瓣心香格帝歆。\n苗若遂枯无此水，粟将暴贵涌于金。\n时方多垒农为急，公在三湘泽已深。\n自愧侏儒叨一饱，愿推德意答天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韶石使君年丈扁舟过我于松桂林敬哦小诗留为一日款就寄石洲主人以发千里外一笑也 其二","author":"陈元晋","text":"黄雀长行万里馀，烦渠就寄数行书。\n常怀李白诗无敌，莫怪韦郎迹也疏。\n玉节荣光何恨速，石洲风物正关渠。\n同年相逐云龙处，应念吾侬乃一猪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韶石使君年丈扁舟过我于松桂林敬哦小诗留为一日款就寄石洲主人以发千里外一笑也 其一","author":"陈元晋","text":"十五年前会五羊，都门再别九年强。\n君荣韶石州麾出，我窘文江县债偿。\n人世能消几离别，征涂何用许奔忙。\n梅前菊后风光好，且为侬留共一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题罗浮山中阁","author":"陈元晋","text":"大海漫天驾叶舟，来登中阁问仙游。\n泉声急泻三更雨，云气深藏六月秋。\n雾湿中天龙出洞，日腾沧海蜃收楼。\n禅床静数愔愔息，身在清都最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题颜秀才夔诗编","author":"陈元晋","text":"延年一印付闻孙，文采风流今尚存。\n生长见闻诚叟里，交游唱和澹庵门。\n苦思那有酸寒气，妙斲浑无斧凿痕。\n问子何为暗投璧，令吾端欲竖降幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠欧阳承务","author":"陈元晋","text":"谈天多巧中，名在士夫间。\n行遍西江路，来游南岳山。\n病侵心绪懒，穷惯面皮顽。\n莫说功名事，禄书从捲还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后 其一","author":"陈元晋","text":"忽雨乾坤变，将秋气候宽。\n林亭欣濯濯，柳岸渺漫漫。\n一饭饱无那，连村枕可安。\n举觞属明月，急雨放云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上刘计使","author":"陈元晋","text":"水心吾师今昌黎，如椽巨笔光虹蜺。\n先公潜德粲碑版，却恨不识嵇中散。\n九苞五彩丹穴雏，不巢阿阁翔海隅。\n南来只影方自笑，天假之逢挹光耀。\n一寒顿坐春风温，贱子亦许扳龙门。\n子期九原不可叫，筝琶纷纷不同调。\n明公派自南轩来，祇今砥柱狂澜回。\n一麾两节岭南北，尽是周程旧扬历。\n书生彊附善类心，莫道冶跃非祥金。\n偶然短簿令公喜，上下云龙固其志。\n山谷昔见苏长公，自比小草依长松。\n牵联名字香闻素，未必今人不如古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上姚赣州镛寿","author":"陈元晋","text":"东南之镇曰会稽，扶舆清淑拱帝畿。\n千岩万壑气盘礴，更有寿桧天与齐。\n托根后土阅千古，黛色苍皮天一柱。\n钟为人杰堪栋国，恰似嵩高降申甫。\n君侯胸中百万兵，年未四十俄专城。\n精神满腹秋水瑩，谈笑两颊春风生。\n崎岖赣右三百里，蛟鳄垂涎波浪起。\n溯流张胆作风帆，信如王尊乃勇耳。\n脱略边幅柔凶顽，解除苛娆绥创残。\n唤回和气豁氛祲，事有至难谈笑间。\n人口如碑沸传诵，帝曰吾徒得君重。\n天风吹下紫泥封，趣入班行作仪凤。\n大夫何以假守为，真除属厌民所期。\n虎头岌嶪要弹压，凝香森戟聊娱嬉。\n璇杓插子日南至，黄钟飞灰雷出地。\n崆峒春早梅已香，酿入黄堂寿觞里。\n醉来含笑看吴钩，龙光夜半干斗牛。\n关河北望令人老，忠臣心与天为谋。\n潢池正尔兵不弄，又说边尘时澒洞。\n筹边筦钥宁无人，知待人豪为国用。\n貂蝉冠高剑拄颐，丹青正与绿鬓宜。\n碧油幢下白羽扇，貔虎百万惟指麾。\n雍容传檄定三辅，颈缚单于归衅鼓。\n手扶銮驾还东都，宫殿千门总如故。\n摩挲与问金城柳，颇尝见有此举否。\n策勋饮至未央宫，腰下悬金印如斗。\n万年觞捧月氐头，虎拜稽首扬王休。\n功高福与宋无极，紫枢黄阁三千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"击毬口号戏陈统制","author":"陈元晋","text":"筑场千步柳营东，樽俎精神坐折冲。\n星弹流空惊过鸟，霜蹄追电捷游龙。\n身轻鞍马人如画，胆落猩鼯穴已空。\n归去翠眉环玉帐，钗儿多乞锦缠红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"帅节留先生两年粤服氓獠安之一日疏十宜归欲袖手板还丞相言者犹不之置上命以釐廷之禄解印东归门生临川陈元晋援后山送坡仙故事至惠之海丰而别作诗四章云 其三","author":"陈元晋","text":"拙无谐俗韵，老眼独相奇。\n寒谷迟春到，东风尽日吹。\n身将三尺律，心不一毫欺。\n公与梅花外，南来谁我知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"帅节留先生两年粤服氓獠安之一日疏十宜归欲袖手板还丞相言者犹不之置上命以釐廷之禄解印东归门生临川陈元晋援后山送坡仙故事至惠之海丰而别作诗四章云 其一","author":"陈元晋","text":"手疏宜归十，心知昨梦非。\n鸿冥空费弋，鸥舞早知机。\n风急推潮落，云闲剩雨归。\n攀辕多少泪，海岸湿斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家谣","author":"陈元晋","text":"长年饭不足，背裂赤日中。\n忍饥不肯懒，辛苦求年丰。\n今秋幸一熟，天意亦惮穷。\n庶几债可了，或有馀粟舂。\n团栾共妻子，糠秕一笑同。\n焚香答天赐，力作人何功。\n君不见前年三百青铜米一斗，又不见去年蕨根掘尽不充口。\n妻孥长恐不相守，敢拟如今苏息否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"陈元晋","text":"寒声战梧楸，风色岁行暮。\n谁念天涯人，貂裘敝尘土。\n一饱亦易营，局促良自苦。\n安得八骏蹄，驾言观玄圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]