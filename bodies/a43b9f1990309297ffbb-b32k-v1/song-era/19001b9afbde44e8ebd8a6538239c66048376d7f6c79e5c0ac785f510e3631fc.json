[{"title":"答汪明道见示画雪梅诗","author":"朱松","text":"诗人未见雪梅画，只识前村横水枝。\n百巧摹香摹不出，此诗风味略相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夹路天宁谒僧不遇","author":"朱松","text":"支公去不锁禅扉，熟境应留梦里归。\n我却寄眠公榻上，此心浑似片云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野步","author":"朱松","text":"悲歌厌听久无襦，倦客翻嫌出有车。\n杖策岸巾山下路，百钱聊欲饮樵夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山僧斋假山","author":"朱松","text":"擘开华岳三峰秀，叠就层峰数石寒。\n等是世间儿戏事，道人莫作两般看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门寺四首 其一","author":"朱松","text":"橘刺藤梢罥客衣，直缘微禄得奔驰。\n悬知投老归田味，只似登山困睡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门寺四首 其二","author":"朱松","text":"行穿苍麓瞰平冈，踏破青鞋到上方。\n城市纷纷足机阱，却从山路得康庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门寺四首 其三","author":"朱松","text":"林栖相唤出幽谷，我亦欲起天未明。\n枕中决决响山溜，一似荒城长短更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门寺四首 其四","author":"朱松","text":"真功那复叹蒸沙，静笑饥肠日夜哗。\n老褐不须供茗粥，朝餐吾已办丹霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹斋","author":"朱松","text":"谁云山僧贫，而有千椽玉。\n幽眠岂无处，爱此晴窗绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将宿松溪罗汉舟小不果渡乃宿资寿二首 其一","author":"朱松","text":"霜馀野水尚能深，隔见僧檐出短林。\n一苇欲航心未稳，故穿危径取墙阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将宿松溪罗汉舟小不果渡乃宿资寿二首 其二","author":"朱松","text":"败絮如蓑不可连，书灯相对耸吟肩。\n明朝定有茅檐日，借我乌犍曝背眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将还政和","author":"朱松","text":"归去来兮岁欲穷，此身天地一宾鸿。\n明朝等是天涯客，家在大江东复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以研墨送卢师予","author":"朱松","text":"明窗子石滟松腴，万卷卢郎正要渠。\n何似黄梅碓下客，夜翻半偈倩人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯夕在试院用去年韵","author":"朱松","text":"隔墙歌吹聒悲凉，信马狂心堕渺茫。\n报答风光吾老矣，小窗读易静焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南溪道中","author":"朱松","text":"千峰踏遍一筇随，草软沙平步却宜。\n细径忽攀飞鸟外，故知腰脚未应衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送周时用自别业还永嘉","author":"朱松","text":"陌上花残客未归，故乡自合去迟迟。\n红香洲渚收归桨，却胜池塘草绿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午憩龙山上方","author":"朱松","text":"税鞅云扉屧响廊，困眠拾得小窗凉。\n逢人莫说梦魂好，厌见客尘吹上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观张上达家惠崇芦雁图二首 其一","author":"朱松","text":"先生衰眼失孤鸿，久著瓮天尘雾中。\n谁卷秋空开四壁，丹青三昧道人崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观张上达家惠崇芦雁图二首 其二","author":"朱松","text":"道人一锡攀飞鸟，颇悉南来北去情。\n画出江南遵渚态，尚馀风味叫群声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示谢彦翔 其一","author":"朱松","text":"满川秀色野阴疏，知有儒仙隔水庐。\n借我玉函河上语，只看尺许定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示谢彦翔 其二","author":"朱松","text":"后身梅福与谁论，正有幽人夙契敦。\n更欲上书陈世事，却来微服守吴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示金确然","author":"朱松","text":"牢落天涯身百忧，故人千里肯相投。\n知君强记当年事，莫说家山恐泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游妙峰庵二首 其一","author":"朱松","text":"朝暖南冈一杖藜，忽投深壑得禅栖。\n共言伐翳通樵径，后日重来路恐迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游妙峰庵二首 其二","author":"朱松","text":"手开茅棘养疏慵，不著尘中车马踪。\n只许幽人来别岭，卧听石磴响枯筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招谢居安","author":"朱松","text":"暗中摸索故难忘，客舍相逢话最长。\n更有异书分我读，只无名酒与君觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花","author":"朱松","text":"霜溪咽绝照冰姿，谁见无人弄影时。\n香逐晓风穿暗户，梦随落月挂寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"社日游南台","author":"朱松","text":"作社无人唤拾遗，不妨步屧趁儿嬉。\n一壶春色千峰顶，回首他年忆此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨二绝句 其一","author":"朱松","text":"摵摵初鸣竹，涓涓稍滴檐。\n忽然幽梦断，更觉晓寒添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨二绝句 其二","author":"朱松","text":"纤纤花入麦，漫漫雨黄梅。\n泥径无人度，风帘为燕开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招卓民表来白云寺","author":"朱松","text":"剥啄浑无去客嗔，丁宁招唤只怀人。\n南风殿角凉如水，来洗眼前朱墨尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿石龙寺二绝句 其一","author":"朱松","text":"风传万籁有喧寂，月入千波无浅深。\n应信此身非我有，窗间谁伴夜虫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿石龙寺二绝句 其二","author":"朱松","text":"触处为家底是归，浮生南北未忘机。\n道人身似南枝鹊，更尽秋宵一再飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠匀送粟既归其直作两偈 其一","author":"朱松","text":"山僧分粟配蒿藜，百亿须弥一钵携。\n但得十方罗汉饱，不辞身作老金鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠匀送粟既归其直作两偈 其二","author":"朱松","text":"惠休老去谩论诗，圆泽西游未有期。\n但解留连元亮酒，不须料理玉川饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄人","author":"朱松","text":"西山相对卧寒斋，耿耿思君不满怀。\n比似持云来寄我，何如君自作云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书护国上方","author":"朱松","text":"久知喧寂两空华，分别应缘一念邪。\n为问脱靴吟芍药，何如煮茗对梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元声许茶绝句督之","author":"朱松","text":"凤山一震卷春回，想见香芽几焙开。\n未办倩君持券买，故应须我著诗催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人寄茶","author":"朱松","text":"寄我新诗锦绣端，解包更得凤山团。\n分无心赏陪颠陆，只有家风似懒残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与匀道人蔬饭作两绝句 其一","author":"朱松","text":"道人一计了平生，肯笑寒儒不糁羹。\n若识先生晚食肉，万钱何处著膻腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与匀道人蔬饭作两绝句 其二","author":"朱松","text":"牛羊触藩笋成竹，鹅鹜成群饱倒藤。\n一饭罗摩未为孽，要知我是在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"匀道人之玉山戏作两小诗送之 其一","author":"朱松","text":"小雨敛尘芒屩轻，玉峰一点笠边明。\n向来目尽鸟飞处，一锡今随只影行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"匀道人之玉山戏作两小诗送之 其二","author":"朱松","text":"道眼无尘万景随，沧江秋色入新诗。\n归时人问江南好，只道君行到自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿鹅湖寺和同行匀道人","author":"朱松","text":"人间狡兔开三窟，天上夜叉守九关。\n欲伴衲僧林下住，会须石似此心顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题廓见亭","author":"朱松","text":"危栏缥缈跨鸿濛，城郭溪山一览空。\n何处更容君著眼，大千浑在六窗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花","author":"朱松","text":"春归幽谷转微和，已觉粘枝玉蕊多。\n天女净香焚月下，相逢依约到无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书钊家园壁 其一","author":"朱松","text":"梅花梦向笛中残，子著深枝一一酸。\n肠断来迟双燕子，暗香消歇粉泥乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书钊家园壁 其二","author":"朱松","text":"心空无地著尘沙，对镜何曾一念差。\n戏取大千归丈室，未妨衣襋乱天花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南浦五小诗迎劳二弟 其一","author":"朱松","text":"鳞生雨后东西倦，雪落竹间南北枝。\n将母方勤弟行役，春风应满锦囊诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南浦五小诗迎劳二弟 其二","author":"朱松","text":"苟禄劳生不为身，强颜来此算征人。\n莫将朝市轻分别，等是低回一鬨尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南浦五小诗迎劳二弟 其三","author":"朱松","text":"堂前春日媚珍盘，稚子相群舞袖斑。\n斗酒寿亲逢一笑，不知身在市门间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南浦五小诗迎劳二弟 其四","author":"朱松","text":"青山北界大江东，了了乡关在眼中。\n归得一廛吾愿足，此生初不问穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南浦五小诗迎劳二弟 其五","author":"朱松","text":"健碧倚天无数峰，眼前浑似故人逢。\n问来识面知何处，应在颐斋诗卷中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其一","author":"朱松","text":"心亲千里不辞遥，咫尺衡门接市桥。\n万卷舌端真历历，一丘胸次更嚣嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其二","author":"朱松","text":"平生学道著功深，世事萦人负此心。\n赖有关西门下士，洛川流派得重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其三","author":"朱松","text":"屹屹龟山障末流，藩墙一望渺无由。\n胸中万里平生事，肯蹋寻常只么休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其四","author":"朱松","text":"两翁相对语更阑，想见风生席石间。\n诗就南枝三转鹊，樽前秋月半衔山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其五","author":"朱松","text":"残书倦展水沉烧，那有堂前学子嘲。\n卧读萧陈秋夕句，不知烟暝鸟争巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其六","author":"朱松","text":"凛凛臞仙千载人，当年许卜一枝邻。\n天高鬼恶堂堂去，谁识渠侬不坏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其七","author":"朱松","text":"不见陈公岁又除，七峰深处食无鱼。\n终烦指似龟山路，会使人疑得异书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其八","author":"朱松","text":"一筇楚尾见春风，遥想诗成顾盻中。\n心逐孤云天外去，恍疑身在大江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其九","author":"朱松","text":"沙界豪端久自知，笔锋一戏更何疑。\n江南春色花千里，幻入幽人半幅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和几叟秋日南浦十绝句简子庄寄几叟 其十","author":"朱松","text":"风雨交交耿夜灯，天涯兄弟对床听。\n莫嫌诗作江南语，一梦家山眼亦青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答子庄见和","author":"朱松","text":"老去温柔失旧乡，北窗一枕午风长。\n梦回未觉羲皇下，句好全胜殿阁凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答国镇见迓之什 其一","author":"朱松","text":"平津栏槛倚高秋，一掬寒波醉眼流。\n莫话风流云散事，九河翻泪若为收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答国镇见迓之什 其二","author":"朱松","text":"渊明把菊对清秋，醉里诗豪万象流。\n画出多情愁绝处，七峰明灭断云收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答梦得送荆公墨刻","author":"朱松","text":"相马评书世未知，要从风骨识权奇。\n半山妙墨翻风雨，尚有典刑今复谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与许簿同游南山二首 其一","author":"朱松","text":"步携婉娩上巉岩，北望云山紫翠搀。\n了了大江东岸路，欲攀风驭脱羁衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与许簿同游南山二首 其二","author":"朱松","text":"秋空如水莫留尘，脚底千峰翠浪奔。\n未暇与君游八表，且当索酒赋鹍鹏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游报国院用壁间韵示同游二首 其一","author":"朱松","text":"招提一叶弄新晴，却信朝檐鹊有灵。\n犹有幽花堪系缆，为言轻手惜飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游报国院用壁间韵示同游二首 其二","author":"朱松","text":"老僧弥勒久同龛，应笑游人世味甘。\n小数何曾工九九，深禅聊欲问三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪桥纳凉晚归小景","author":"朱松","text":"谁共溪边沆瀣杯，惊鱼不睡棹歌来。\n风生蘋末无多子，更待冰轮作伴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水精念珠颂","author":"朱松","text":"百八么珠水玉寒，客囊无复一钱看。\n只应袖里灵山在，无数如来转指端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卧疾初起示逢年兼简绰中德粲五首 其一","author":"朱松","text":"观身已作水溶溶，投瓦云何觉病攻。\n造物小儿真一戏，未妨居士却谈空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卧疾初起示逢年兼简绰中德粲五首 其二","author":"朱松","text":"病馀都作鹤联拳，谁识臞儒是列仙。\n如我角犀将底用，藜羹相对却超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卧疾初起示逢年兼简绰中德粲五首 其三","author":"朱松","text":"清风白雨洒炎荒，林下听时恰对床。\n一洗微痾何足道，请观何处不清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卧疾初起示逢年兼简绰中德粲五首 其四","author":"朱松","text":"蚤岁功名不自量，近从颜禹识行藏。\n万钱本是忧时饵，除却箪瓢莫谩尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卧疾初起示逢年兼简绰中德粲五首 其五","author":"朱松","text":"一溪风月浩无边，病起吟觞总未便。\n欲作二豪知未办，恐君爱我沐猴禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以月团为十二郎生日之寿戏为数小诗 其一","author":"朱松","text":"凤山团饼月朣朦，老桂横枝出旧丛。\n小友他年春入手，始知蟾窟本来空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]