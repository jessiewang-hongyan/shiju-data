[{"title":"因见佛印自称二浙云游老比丘遂成绝句","author":"刘季孙","text":"二浙云游老比丘，苏州一宿过湖州。\n钱塘江上乘杯去，雁荡天台更自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖泛舟呈东坡","author":"刘季孙","text":"西湖春意胜当年，公领笙箫泛画船。\n锦绣一林生水面，衣冠万堵立山前。\n仁恩在物禽鱼遂，喜气随人草木妍。\n半醉插花风调别，写真须是李龙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪东坡中和堂赏月","author":"刘季孙","text":"中和堂上月，盛夏似高秋。\n天泻银河水，人披紫绮裘。\n气飘闻赤壁，语胜踊黄楼。\n归袂接夫子，适从何处游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡赏枇杷","author":"刘季孙","text":"夏木有馀绿，山僧知胜春。\n日长寻卧榻，花落断游人。\n红旆来虽晚，清风到亦新。\n成林卢橘熟，翠羽杂金鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中过城东仰怀平甫学士","author":"刘季孙","text":"马蹄踏雪过东城，暂喜京尘不上缨。\n寒木乌惊花散漫，败檐人怯玉峥嵘。\n岂无良燕容枚老，定有高才忆戴生。\n未负物华聊一赋，知君丽句已先成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题子瞻扬州借山寺","author":"刘季孙","text":"给事风流在，虚亭景越闲。\n全临故宫水，尽致别州山。\n峰势晴相向，岚光夜不还。\n无时供胜赏，历历白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西山老人行","author":"刘季孙","text":"善冶一家称主人，奴耕婢爨鸡司晨。\n置之得所生取备，何必百事皆躬亲。\n为主汲汲尽无获，道路锥刀长苦辛。\n君不见西山老人不出户，索酒烹羊呼四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过范村呈元礼","author":"刘季孙","text":"渐老犹奔走，风埃过范村。\n岭寒催马疾，村晚待鸦喧。\n世路穷迷久，人情应接繁。\n渊明吾所慕，高意在田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酒隐堂","author":"刘季孙","text":"醉乡王绩比华胥，酒隐堂名意岂殊。\n五斗乐真何所累，一樽随分亦其徒。\n高才未愧人知少，老句曾容客和无。\n尘事万端君莫问，到头酩酊胜区区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"刘季孙","text":"每过杨子宅，时醉庾公楼。\n黄鹄云霄志，白蘋江海流。\n读书非世用，种树是吾谋。\n自识文章贵，多寻潇洒侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送江宁知府林公修撰十韵律","author":"刘季孙","text":"昭代尊儒学，惟公简拔频。\n文章分造化，事业在经纶。\n天马来夷路，人龙抚要津。\n几年刊大典，四海属名臣。\n汲引亲疏共，光华出入均。\n玄晖赋江练，文畅咏汀蘋。\n道契岩廊久，恩隆建邺新。\n七朝皆故事，十郡得仁人。\n岂晚还西掖，终朝对北辰。\n一言调鼎味，膏泽被斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至王屋先寄张明府","author":"刘季孙","text":"诗仙假色管天坛，早晚真除碧落官。\n境内雨频春亩润，门前山聚晓云寒。\n十年不见应题塔，万事休论拟挂冠。\n同是清源骚雅客，欲言流涕已汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至济源府先寄姜明府","author":"刘季孙","text":"识君风概有三堂，别后频惊鬓有霜。\n经耳万端人事近，动心千里客途长。\n读书学剑全相误，临水登山独未忘。\n路入济源牵赋咏，此行真发鄙夫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑令狐明府","author":"刘季孙","text":"行当腊候晚，共惜岁阴残。\n闻道巴山远，何如蜀路难。\n荒林藏积雪，乱石起惊湍。\n君有亲人术，应令劳者安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早发承甫馆寄登州待制","author":"刘季孙","text":"水亭潇洒离尘开，一醉扁舟载月回。\n马首西归怀底事，只随晓日望蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠贾收处士十韵","author":"刘季孙","text":"君家霅溪上，日食霅溪鱼。\n无钱买钓艇，貌古常有馀。\n遇人喜谈笑，贳酒日不虚。\n浩歌出尘表，白鸟来徐徐。\n清风入窗牖，散乱床头书。\n有琴坏徽轸，渊明意何如。\n我欲脱尘网，筑室邻君居。\n有地植松竹，有水种芙蕖。\n作诗赋生理，起居当和予。\n相顾可忘老，醉饱遗君诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠朱象先处士十韵","author":"刘季孙","text":"前身应画师，摩诘初自许。\n咫尺论万里，宰也少陵与。\n朱翁趣岂凡，山水忘羁旅。\n晴窗布风云，夏木回炎暑。\n坐来摧虎头，兴尽秃鸡矩。\n况其尘外怀，出门皆胜侣。\n一画不轻付，俗子吾避汝。\n能令希世迹，千载得处所。\n斯人定何如，箧有东坡语。\n画以适其意，能文不求举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三高祠咏古三首 其一","author":"刘季孙","text":"大湖际天碧，浩荡浮万象。\n中有洞庭山，天作蓬壶样。\n芦苇秋萧萧，时闻发渔唱。\n风顺如可寻，月明迷所向。\n有人在扁舟，发白意夷旷。\n扣舷了不顾，出没信波浪。\n心已类水石，何由知得丧。\n遗民至如今，自古惟越相。\n初为吴都囚，君臣忧醢酱。\n忍耻人谓愚，祈生世知妄。\n尪癯脱万死，归国奇谋创。\n行师舞群姓，下令跃诸将。\n夜半覆姑苏，夫差始悲怆。\n安恻宽晷刻，反掌成伯王。\n江山入会稽，功高谁与抗。\n宠利速祸败，忠臣半诛放。\n遁去举邦求，君王铸形状。\n寂寥数千年，相见霜缣上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三高祠咏古三首 其二","author":"刘季孙","text":"吴江净如镜，吴艇轻如飞。\n吴山远如画，此景天下稀。\n秋风晓槭槭，秋雨凉霏霏。\n谁将菰菜撷，正是鲈鱼肥。\n时有季鹰者，怀此知所归。\n浩歌有馀乐，肯乐首阳饥。\n亲朋不可挽，飘忽云边衣。\n亦闻有富贵，大第严朱扉。\n食必列钟鼎，侍妾鸣珠玑。\n簪裾望颜色，宾从生光辉。\n一言转造化，枯朽生芳菲。\n功高责更重，势或干天威。\n福深祸亦称，颠覆始知机。\n斯人悟兹理，吊世潜欤欷。\n浮沉顾宠禄，安能与心违。\n沧波浩无际，草木情依依。\n可以恣幽步，白云藏钓矶。\n静引一杯酒，高歌怜昨非。\n数峰太湖上，斜阳明翠微。\n虚亭展遗像，想见犹忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三高祠咏古三首 其三","author":"刘季孙","text":"人物盛东南，莫如吴郡陆。\n汉季逮唐来，班班闻史牍。\n门庭迭辉赫，龙虎争驰逐。\n风流郁兰桂，气象鲜车服。\n鲁望乃其裔，清标映宗族。\n文章及者鲜，意趣超然独。\n宁从一瓢饮，不枉万钟禄。\n云烟蔼巾袖，星斗粲胸腹。\n来居笠泽旁，萧萧数间屋。\n厨中甑起尘，笔下珠盈斛。\n吟须僧舍题，醉就友人宿。\n醒将太玄解，卧把离骚读。\n心惟近渔钓，迹亦混樵牧。\n韵高谁可听，皮子往还熟。\n唱酬数百篇，名流必雌伏。\n业书类有道，不赋长沙鵩。\n晚泊松江上，遗图见眉目。\n分明孤鹤姿，轩昂骇鸡鹜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游越山寺看泉","author":"刘季孙","text":"龟溪有路莲花引，鹫岭无时云雾生。\n聊放此身留舴艋，不逢人处听泉生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其一","author":"刘季孙","text":"中宫在天半，其上乃吾家。\n纷纷鸾凤舞，往往芝朮华。\n挥手谢世人，耸身入云霞。\n公暇咏天海，我非世人哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其二","author":"刘季孙","text":"仙都非世间，天神绕楼殿。\n高低霞雾匀，左右龙蛇遍。\n云车山岳耸，风鼙天地颤。\n从兹得旧渥，万物毫端变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其三","author":"刘季孙","text":"从来英杰自消磨，好笑人间事更多。\n艮上巽宫为进发，千车安稳渡银河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"刘季孙","text":"江心净带三秋月，岩腹斜收万里云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻侯舅应辟南征诗","author":"程颐","text":"辞华奔竞至道离，茫茫学者争驱驰。\n先生独奋孟轲舌，扶持圣教增光辉。\n志期周礼制区夏，人称孔阴生阙西。\n当途闻声交荐牍，苍生无福徒尔为。\n道大不为当世用，著书将期来者知。\n今朝有客关内至，闻从大幕征南垂。\n南垂凶冠陷州郡，久张螳臂抗天威。\n圣皇赫怒捷书缓，虎侯秉钺驱熊罴。\n宏才未得天下宰，良谋且作军中师。\n蕞尔小蛮何足殄，庶几聊吐胸中奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游嵩山","author":"程颐","text":"鞭羸百里远来游，岩谷阴云暝不收。\n遮断好山教不见，如何天意异人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢王佺期寄药","author":"程颐","text":"至诚通圣药通神，远寄衰翁济病身。\n我亦有丹君信否，用时还解寿斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睢阳五老图","author":"程颐","text":"天朝罢命锡归闲，富寿康宁老税冠。\n国史标名知骨鲠，邦人图像胜楹桓。\n龙飞天上时还暖，鱼跃波心气未寒。\n惟我潜心于易理，备知先哲应时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆浑乐游","author":"程颐","text":"东郊渐微绿，驱马欣独往。\n舟萦野渡时，水乐春山响。\n身闲爱物外，趣逸谐心赏。\n归路逐樵歌，落日寒山上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"程颐","text":"尧舜几千年，其心至今在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午帖子 其一","author":"赵彦若","text":"扬子江中方铸镜，未央宫裹更飞符。\n菱花欲共朱灵合，驱尽神奸又得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午帖子 其二","author":"赵彦若","text":"扬子江中百炼金，宝奁疑是月华沉。\n争如圣后无私鉴，明照人间万善心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"赵彦若","text":"江心百炼青铜镜，架上双纫翠缕衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"赵彦若","text":"花随红意发，叶就绿情新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄灵岩长老确公大师 其一","author":"盛陶","text":"适见随州住，谁教复在齐。\n君看历山北，何似善光西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄灵岩长老确公大师 其二","author":"盛陶","text":"传法仙城后，流名上国高。\n游方缘渐契，无亦太忉忉。\n灵岩山下草，今古几回春。\n不有开堂日，焉知卷席人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"教授推官出示米元章诗词翰俱美三四读而不能休敬书二十八字谢之","author":"程节","text":"万□□南泮水遥，清风来拂瘴烟消。\n袖中突兀龙蛇出，聊慰天涯久寂寥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花","author":"丰稷","text":"桃杏二三月，此花泥滓中。\n人心正畏暑，水面独摇风。\n净刹如金涌，嘉宾照幕红。\n谁歌采菱曲，舟在晓霞东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其一 西园","author":"丰稷","text":"仙化二十四，境远难遍探。\n锦城使君园，雅与云洞参。\n回光试一览，紫翠绝西南。\n池映金波静，花沾玉露甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其二 玉溪堂","author":"丰稷","text":"一水从何来，应是昆山顶。\n酾成渌玉池，虚堂逗清影。\n公退泠然赏，了非心外境。\n鱼泳阳光动，鸟啼春昼永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其三 雪峰楼","author":"丰稷","text":"雪峰在何许，楼倚青霄端。\n每来注心目，不觉生羽翰。\n终藉好风力，云散银阙攒。\n只履西归客，应笑空倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其三 海棠轩","author":"丰稷","text":"文锦初动机，晨霞欲敷照。\n香传雪楼浓，影落玉溪倒。\n子美不能赋，春工一何妙。\n惟有赏心人，相逢祇微笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其五 月台","author":"丰稷","text":"石印鱼在屏，犀透星入角。\n乃知明月光，日用心不觉。\n陟此百尺台，馀念坐消剥。\n洞晓弦望机，仙丹兹可学。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其六 翠锦亭","author":"丰稷","text":"檐外列修木，凛凛正人气。\n有德必有文，烂兮五色备。\n岂同夭韶花，弄春张绣被。\n须信轮囷材，堪为万乘器。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其七 潺玉亭","author":"丰稷","text":"养源在西山，如玉抱精白。\n引之落锦渠，历耳不可择。\n风雨杂鸣球，珠玑写云液。\n恰似偃溪声，醒悟迷途客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其八 茅庵","author":"丰稷","text":"覆以洁白茅，环以琅玕竹。\n天籁旁鼓笙，月沼对铺玉。\n借问清坐翁，此外更何欲。\n笑指博山炉，香飞柏子绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其九 水阁","author":"丰稷","text":"长虹卧松江，一苇航大河。\n岂如此安稳，无复畏风波。\n幽香萃花岛，鱼藻旨且多。\n徙倚小栏曲，月色透薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运司园亭 其十 小亭","author":"丰稷","text":"东西对孤骞，杖屦可幽歇。\n容光日月来，矧此明四彻。\n鳞木张幄翠，蜃泉飞玉洁。\n往往得意时，宛在广寒阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幸太学","author":"丰稷","text":"凤幄云开日月章，九霄呜跸下虞庠。\n朝元俊士鸿成列，拱极名臣玉照行。\n问道贾生称五学，乞言戴圣美三王。\n上心夙悟周公戒，天下安危自一堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"丰稷","text":"日来月往无成期，好把心源早夜思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其一","author":"徐守信","text":"遥望南庄景色幽，前人田土后人收。\n儿孙自有儿孙福，莫与儿孙作马牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其二","author":"徐守信","text":"富贵贫穷各有由，宿缘分定莫罔求。\n不曾下得春时种，空守荒田望有收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其三","author":"徐守信","text":"南庄北宅眼前花，好儿好女莫缦誇。\n我若一朝身死后，又属张三李四家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"徐守信","text":"天地一尺，四海一滴。\n把眼一眨，不见踪迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"徐守信","text":"牡蛎滩头一艇横，夕阳西去待潮生。\n与君不负登临约，同上金鳌背上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高峰","author":"关咏","text":"独爱高峰最上头，夕阳烟树见严州。\n子陵贪向溪边钓，应未曾来此地游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题左溪齐云阁","author":"关咏","text":"白云来轩户，清风生涧壑。\n山僧不管春，岩花开自落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苏唐卿","author":"张颂","text":"重惜欧阳滁记好，模刊翠琰费堂新。\n文华起焰冲星斗，篆法通灵动鬼神。\n观妙每多师道客，仰高常有慕贤人。\n璨然辉日如辰象，不朽宜为万世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张颂","text":"人散鞦韆闲挂月，露零蝴蝶冷眠风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"沈希颜","text":"帝恩耆德帅江东，铜虎分符锡我公。\n侍从暂辞仙殿秘，蕃宣聊拥使麾雄。\n过吴衣锦誇乡曲，人越褰帷广听聪。\n莫恋湖山经岁住，早归黄阁亮天功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"沈希颜","text":"此处离朝路几千，为官不取半文钱。\n平生不养无情鸟，遮莫妖禽夜哭天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈述古仙居岩老堂诗","author":"王振","text":"政暇此观书，心闲渭水渔。\n宛然山叟室，移入县庭居。\n雨霁群峰秀，风生一谷虚。\n我朝求治功，好顾卧龙庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枫桥","author":"郭附","text":"师子山云漠漠，越来溪水悠悠。\n钟到客船未晓，月和渔火俱愁。\n咫尺横塘古塔，连绵芳草长洲。\n一老翛然自在，时时来系扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台","author":"张绶","text":"范蠡功成始遁逃，渊明五斗便辞劳。\n先生二事俱无一，名与青山万古高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题奣岩","author":"张绶","text":"岩口呀然向日开，小桥飞入势萦回。\n幽深自可逃烦暑，况有寒泉石下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泻洪亭","author":"张绶","text":"潺潺石磴泻红泉，路蹑丹梯入紫烟。\n岩有高人无问处，庵罗双树碧参天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]