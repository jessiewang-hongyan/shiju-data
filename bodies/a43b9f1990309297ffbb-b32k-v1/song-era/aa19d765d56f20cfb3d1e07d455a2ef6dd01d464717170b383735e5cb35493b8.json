[{"title":"荷花","author":"郑清之","text":"一样娉婷绝代无，水宫鱼贯出琼铺。\n缘何买得凌波女，为有荷盘万斛珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲房洗砚","author":"郑清之","text":"圆长已褪青云子，芳软犹存绿玉房。\n留伴陶泓共新浴，要令毛颖沃清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪窗董寺丞将指平谳安晚来访因举似偃溪为下一则语","author":"郑清之","text":"佛法方当恶剧时，偃溪笑里袖钳锤。\n不教管领千云衲，打彻头关更问谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成呈林郑二友两绝 其二","author":"郑清之","text":"声名谷口吾宗秀，风调西湖我辈人。\n自是山岩着不得，天教暂此伴闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旌德观 其三","author":"郑清之","text":"半生东甬数间屋，一日西湖十首诗。\n回首风光少年客，春山拥翠作蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚景","author":"郑清之","text":"斜照染成金色界，嫩霞蘸出水红天。\n个中买得皆真境，不遣诗人费一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴","author":"郑清之","text":"濯翠筛红献晚晴，为渠日脚护归程。\n碧云四合如相妒，才剩西边一缕明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明有感","author":"郑清之","text":"井泉槐火几清明，白发红颜管送迎。\n荣落智愚千古恨，一时分付子规声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔舟","author":"郑清之","text":"明月清风住钓船，新秋世界落诗编。\n渔翁若遣骚人作，肯食人间一点烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游松山溪塘晴日荡漾","author":"郑清之","text":"红染花梢未是真，一川晴绿最关人。\n谁知属玉双飞处，占断西湖几许春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖风不顺","author":"郑清之","text":"推篷滉漾失船踪，万顷玻瓈在沌东。\n政恋湖光挟山色，知心龙伯赠横风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登飞来峰","author":"郑清之","text":"悬崖石路擘苍苔，川窦岩扉处处开。\n信是拔山人有力，一峰搦碎总飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢天童老秋兰 其二","author":"郑清之","text":"秋色追随入慧光，肯携幽卉问行藏。\n深林未省炎凉态，来为闲人特地香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢天童老秋兰 其三","author":"郑清之","text":"绿叶青青带紫光，拈来笑处没遮藏。\n密圆应具楞严偈，非木非空出妙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢天童老秋兰 其一","author":"郑清之","text":"楚畹春曾汎晓光，直留雅艳到虹藏。\n山中不把一枝到，世外那闻千佛香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢送桂花 其二","author":"郑清之","text":"道眼如如了色空，维摩方病散花中。\n杜陵有酒勤相觅，留俟清斋出梵宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢送桂花 其一","author":"郑清之","text":"金阙真黄入靓妆，仙葩何事到鳣堂。\n只缘风雨要人甚，窖取旃林百斛香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赐第登楼 其三","author":"郑清之","text":"病思归心走兔迒，自嗤幻境未渠忘。\n并州便作咸阳看，设若桑乾亦故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赐第登楼 其二","author":"郑清之","text":"桃李漫山不是春，纷纷蜂蝶趁游人。\n梅花已带春归了，分付垂杨浥露尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"催觉际殖芥","author":"郑清之","text":"淡交耐久最宜蔬，风味清严莫芥如。\n沃壤深畦须蚤计，雪中满拟饫冰菹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事","author":"郑清之","text":"退之硫黄药成疾，伯仁金印恩为仇。\n眼前世事尽如此，十日峭寒春作秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起戏笔","author":"郑清之","text":"范蠡功成便五湖，鸱夷未了复陶朱。\n争如终老严陵钓，千古清名一事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"督觉际莳菜","author":"郑清之","text":"秋后从来数晚菘，自锄稀甲几多丛。\n莫辞榾榾频携瓮，准拟清馋玉糁翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"督觉际植花 其一","author":"郑清之","text":"桂后秋兰解出奇，幽香元不许春知。\n移根好向它山觅，承受风光到菊篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"督觉际植花 其二","author":"郑清之","text":"兄弟梅矾是水仙，曝根向暖种宜先。\n银台金盏惟须酒，不可无渠对雪天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简雪窗董寺丞 其一","author":"周端臣","text":"世路机心走兔迒，雪窗一缕不遮藏。\n籋云梯月真游戏，茅舍何曾外玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简雪窗董寺丞 其二","author":"周端臣","text":"圣贤事业在心槃，禹稷颜回岂异观。\n世故波澜同起灭，姓名千古要清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静极","author":"郑清之","text":"磨砖岂解成明镜，打坐如何作佛身。\n静闹头头须认着，暑中冰冻雪中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"頔上人持瑩萝月五诗见示因走笔和韵聊禦睡魔 其五","author":"郑清之","text":"病著心华须佛治，老僧眼缬要经遮。\n勿逢萝月五禅偈，绝胜卢仝七椀茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"頔上人持瑩萝月五诗见示因走笔和韵聊禦睡魔 其二","author":"郑清之","text":"须弥境界含方广，芥子中间见福昌。\n但使有船堪载月，不应无佛漫留堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"頔上人持瑩萝月五诗见示因走笔和韵聊禦睡魔 其一","author":"郑清之","text":"萝月禅机莫强猜，如来无去亦无来。\n霜凝寒绿归松鬓，春染轻红入杏腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"頔上人持瑩萝月五诗见示因走笔和韵聊禦睡魔 其三","author":"郑清之","text":"竺乾心法拈花笑，洙泗家风鼓瑟希。\n一问已应居第二，更询来处落三机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东山上方","author":"郑清之","text":"谢公雅志在东山，一入黄扉不复还。\n公去我来山属我，为公偿却半生閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题偃溪闻长老尧民击壤图","author":"郑清之","text":"炊烟万井着僧居，人在康衢画不如。\n寄语偃溪崖淡墨，图中添我一柴车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠李相士","author":"郑清之","text":"未遇公卿尽好看，会将碧眼照人寒。\n邯郸梦觉君休问，试卜何时可挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠育王堪笑翁","author":"郑清之","text":"问讯瞿昙老比丘，灵山何似雪山头。\n笑翁底事真堪笑，面似靴皮笑未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"檐前蜘蛛","author":"郑清之","text":"如蚕吐纬自萦缠，出没无踪屋陋边。\n怀毒满身如蝎大，谩张罗网欲谩天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"臂疼医令灼艾戏成","author":"郑清之","text":"幻体当如泡影观，法身清净本坚完。\n四千八万陀罗臂，艾炷教君何处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月初五日城中大风雨","author":"郑清之","text":"飓风超海撼官城，吹断银河彻晓倾。\n瓦阵飞翻千鹄起，屐声旁午万蛙鸣。\n骈肩重足人如醉，涌溜奔云气未平。\n谁与笺天如帝律，毒龙斥去锁东瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日即事 其二","author":"郑清之","text":"瓮畦篱户小园林，独鹤相陪省一琴。\n老视官年从实录，贫依国息寄横金。\n诗盈弓力犹能寸，客值骚醒且枉寻。\n枫叶似知酤令缓，漂摇醉脸出墙阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日即事 其一","author":"郑清之","text":"安晚闲身晚更安，蛩宵无梦落金鞍。\n通心白发难为染，对面青编尽耐看。\n多谢紫萸占老健，喜招黄菊伴秋寒。\n江城借黓生轻暖，忽有鸣蛙却为官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日即事 其三","author":"郑清之","text":"童孙竞爽祝鸡翁，点勘凡将句读中。\n戏指丈兄誇少壮，懒推庚甲问雌雄。\n穷秋对展三更月，迥夜传呼万窍风。\n逗晓东窗相管领，举头滟滟日车红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月末泛湖","author":"郑清之","text":"半晴阴更重，乍煖冷犹争。\n坠叶蒲芽缀，新莼荇面生。\n钟声带雨涩，帆力贮风横。\n客至双飞鹤，归欤茗可烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上清宫 其二","author":"郑清之","text":"上清山腹正便便，剩纳风光似辋川。\n晓雨洗开新绿岸，晚霞蘸出嫩红天。\n鞭浮野竹数茎笋，叶俯秋荷几柄莲。\n不是西湖最佳景，更于何处著癯仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小轩偶成","author":"郑清之","text":"斋馀宴坐息深深，万法皆闲境会心。\n轻浪飐荷珠溜玉，晴曦穿竹翠笼金。\n岸头舟楫人归语，槛外菰蒲鸟去音。\n谩说陶车并谢屐，如如不动胜登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"郑清之","text":"山行心迹已双清，骤见清溪眼为明。\n鬼谷洞前符竹在，观音岩下魶鱼行。\n宗师宴坐空馀石，龙女分流不作声。\n人影交横到林薄，绿烟深处一猿惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山房秋日即事 其一","author":"郑清之","text":"雨后鸣湍走碧溪，水声秋意恰相宜。\n窥蝉螳臂方衷甲，啄蚓鸡群竞济师。\n初月挂檐窗未觉，新凉入牖簟先知。\n西风早已催征棹，管领莼鲈入梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山房秋日即事 其二","author":"郑清之","text":"失惊墙外已飘黄，屈指秋来十日强。\n暑寇负顽犹出没，风师未壮且翱翔。\n橘包捧腹微藏叶，桂蕾呈身只欠香。\n扫尽暮天疑浴罢，半眉淡月画新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山房秋日即事 其三","author":"郑清之","text":"稻花经雨已脱白，枫叶未霜先借绯。\n入纻蚊牙千计巧，挂檐蛛腹十分肥。\n田翁看水携锄去，山妇临炊抱蔓归。\n唯有诗肠无一事，隔溪数尽暮鸦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书斋独坐","author":"郑清之","text":"避事宁违俗，端居悟及身。\n颖泓供媵御，方册替亲宾。\n室闇月阑入，庭空花自陈。\n所安惟适耳，谁复辨秋春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"比以拙诗戏调张籍不知作者已盈轴矣辄和两韵 其二","author":"郑清之","text":"虓虎宁如龟有知，陆行端自触危机。\n缚渠吕布还须急，驱以王寻谩失威。\n肯使黔驴呈短技，直教猎骑合边围。\n恶盈讵必分人兽，猛获终擒自卫归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"比以拙诗戏调张籍不知作者已盈轴矣辄和两韵 其一","author":"郑清之","text":"展也虞朝庶绩熙，合修厥贡暨熊狸。\n兕容于野虽非地，豹泽其文似识时。\n毛革正须供有用，血牙安事杀为嬉。\n国侨惠政人谁犯，虎听多应谢子皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东归越上","author":"郑清之","text":"急雨先声入芰荷，傍船鱼跃弄新波。\n东西黑白投林鸟，高下青黄异亩禾。\n村竖相呼骑犊背，小舟斜舣问渔蓑。\n秋来物物供吟笔，不着黄秦可若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月六日早行松山道","author":"郑清之","text":"五更河鼓尚横陈，小立晨光渐可人。\n日出野鸡犹唱晓，雪晴山鸟竞呼春。\n溪筠拂袖霜花落，石路支筇藓迹新。\n惭愧明朝江国近，买鱼沽酒祓征尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和村边解嘲 其二","author":"郑清之","text":"暖足番君老更便，摩挲笑问阿婆年。\n聊吟夜月移花影，肯向春风逐柳绵。\n自有散花居丈室，何妨姹女共壶天。\n铅华列屋诸君事，乞与寒梅了世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和村边解嘲 其一","author":"郑清之","text":"闲身惟向静中便，莫景侵寻绛县年。\n失解真精昏默默，且观玄牝息绵绵。\n温柔乡里谁能老，冷澹生涯别有天。\n笑抚脚婆为法喜，漆园何必问经缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和村边解嘲 其三","author":"郑清之","text":"造化真机动静便，谁云巧智可同年。\n蓝田日暖烟生玉，闽峤霜浓木有绵。\n万象为春皆是物，一花不实岂其天。\n吾身太极元同运，阳长阴消在所缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因会来诗再赓元韵","author":"郑清之","text":"组练横陈壮士貔，想因舞羽去穷奇。\n千山白发存公道，十日清吟费老诗。\n待伴易销春有脚，交光最胜月如眉。\n只愁无著梅花处，东绢平章付伯时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安晚园戏占","author":"郑清之","text":"横塘雨过水初平，浪影窥窗一孔明。\n篱下触羝五鹿角，林间反舌百禽声。\n柳公权可送行客，梅子真能宽渴兵。\n谁道夏园无所有，莲花端可傲张卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安晚轩竹","author":"郑清之","text":"松号大夫交可绝，梅为清客志相同。\n英英凤实卑馀子，楚楚龙孙过乃翁。\n晚际一弓櫜素月，暑中千斛粜清风。\n小轩政欲供晨坐，付女遮阑晓日东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏调长鸣鹤","author":"郑清之","text":"瘦鹤云霄志，相从伴独清。\n可堪三径寂，频作九皋鸣。\n博字输鹅颈，横空避雁声。\n终辞华表去，汗漫逐骑鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏续前韵简幕掾林治中","author":"郑清之","text":"梅霖妒日强遮藏，西雨东边漏隙光。\n黄口禽鸣应乳臭，白花栀坼似衙香。\n排根荷出怜嵇绍，遁迹莼肥哂孟尝。\n闲处便成清境界，底须沂水羡雩凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余自东山往金峨住山戒师迎于中涂到上方泉石幽胜有心匠助天巧者因成数语以赠","author":"郑清之","text":"一奁鸣瀑写天绅，怪石鲸奔欲化鳞。\n灵隐飞来真相后，老坡重證戒师身。\n居山活计今成趣，造物工夫总待人。\n自喜爱閒逢胜绝，杖藜端不负残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余识頔云岑已三十年晚居觉际又八载矣近因山行疑接谈麈偈语奉赠","author":"郑清之","text":"懒把无生话更参，月移梅影到枝南。\n身心识破梦中蝶，头角老来春后蚕。\n笑斸野泉畦露菊，巧寻煖地圃霜柑。\n蒲团睡足书遮眼，贝叶丛间会孔聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村边以汤婆样惠示与诗俱来依元韵","author":"郑清之","text":"惠中秀外更清便，娅姹娇羞二八年。\n无奈畏涂生衽席，宁教寒夜折冰绵。\n遣来绩妪知君状，拟伴涪翁到晓天。\n只恐砖花陶学士，风流未了续胶缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛丑仲春同黄制属自延寿雨过禅寂","author":"郑清之","text":"箯舆掠雨到僧门，带得清闲一二分。\n素喜堂中无偃月，朅来寺里作穿云。\n赤心莫逆唯松友，青眼相看有竹君。\n烧叶更联东野句，纸窗钻隙候晴曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还云岑鲁直诗","author":"郑清之","text":"蟠空健笔虎蛟腾，九折羊肠万马登。\n裁剸燠寒真见圣，牢笼泉石肯输僧。\n命意得了兔走穴，放字未安狐听冰。\n句法当头飞棒喝，就渠言下辨三乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中偶成 其一","author":"郑清之","text":"病觉身名小，闲知日月忙。\n篆香云四合，盆筱竹千章。\n慧性乾成障，愁怀弱未张。\n何如庄宇定，虚室自天光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净明院","author":"郑清之","text":"斋宿虚閒只净明，俗氛暂洗觉身轻。\n半山云脚炊烟湿，一枕松声涧水鸣。\n对语老禅真法器，译经新谛出僧檠。\n归翻贝叶莲花颂，犹带招提月影清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到龙井寺 其一","author":"郑清之","text":"竹门斜倚酒家帘，石路高低记水帘。\n炙背老农惊伛偻，乘肩痴女笑窥觇。\n数羝人立攀篱落，一蝶儿嬉掠伞檐。\n款约朋从归去路，马头应有月纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]