[{"title":"谢建阳宰刘潜夫寄酒","author":"陈宓","text":"建阳则有王，桐城则有孟。\n王酝清而淳，孟盎和而劲。\n一酌适我情，再酌养我性。\n充腹皆阳和，阴慝不得并。\n或隔千里遥，或馀百里径。\n水陆有远近，非好遂无胫。\n苟不遇益友，吾瓶讵能罄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢郑夹漈子惠诗索草堂扁榜 其一","author":"陈宓","text":"五十种书今几见，数千年史尚堪传。\n草堂底用标遗迹，自是乡人苦爱贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢傅监仓","author":"陈宓","text":"昔年常侍紫枢仙，风骨森然在眼前。\n一览十行俱默诵，三更残卷尚朱笺。\n诗书自古称难继，衣钵于今信有传。\n每拜名章唯自愧，思悭莫和短长篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢蔡知县白莲栽","author":"陈宓","text":"忠惠当年种，濂溪此日分。\n开筵胜玉碗，围坐当冰盆。\n性地元无染，心源自有根。\n江湖情渐懒，乐在闭柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道间驰荔","author":"陈宓","text":"六月炎天下丹子，带露凌风日千里。\n吾皇慈俭却献来，六宫不袭唐朝事。\n王公厌饫远域珍，岂识宵驰常暍死。\n郡侯何用苦区区，暑气隆时劳送似。\n色香俱坏仅存名，鸟飞不到人何胜。\n登盘乍试犹嫌味，颗颗谁知血汗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春","author":"陈宓","text":"兰亭明日禊馀春，风冷难回积雨云。\n不惜芳菲倦游赏，雅宜竹下闭门人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云石深趣堂","author":"陈宓","text":"广文官舍先无尘，谁著岚光几上陈。\n个里尽消三伏暑，胸中长作四时春。\n不因泉石耽成癖，那识箪瓢味更真。\n顾我年来羁吏鞅，清闲羞见读书人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题开先","author":"陈宓","text":"距城近只十五里，三度来游两载中。\n山骨漱来成白玉，水痕深处见苍龙。\n竹间待月为佳友，柱上留题忆长公。\n此去重来知几日，携家恋别莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题延平李氏宅","author":"陈宓","text":"延平李氏庐，仙翁扁盘谷。\n虚堂纳水石，兰萱和修竹。\n距城才咫尺，作吏愧真俗。\n年馀始一到，赖有客如玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈君肯堂","author":"陈宓","text":"昔人创业无穷思，张大由来在子孙。\n轮奂已成张老室，驷轩行看汉于门。\n诗书古训时时习，孝友家风世世存。\n闻道董帷勤课子，不妨游息有名园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 百花径","author":"陈宓","text":"谁言四时殊，春色镇长有。\n秀萼皆可餐，采采泛卮酒。\n殷红一月时，发挥仍有抑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 净凉","author":"陈宓","text":"何物擢仙质，天然契吾性。\n不染浊水泥，明月水中映。\n只许此君看，风清雨娟净。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 宜月","author":"陈宓","text":"海底初上时，柳末清光发。\n满窗璠玙映，我胸中月地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 种杏","author":"陈宓","text":"夭桃太繁媚，清瘦却怜梅。\n酌此二妙质，为君出奇开。\n酿作千日酒，高仙下崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 浮花","author":"陈宓","text":"古来诧范蠡，功名付沧洲。\n可惜所见小，只挟婵娟游。\n如公真爱世，请具济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 颂橘","author":"陈宓","text":"潇湘秋气高，群木秃如指。\n粲粲朱实繁，傲霜如有喜。\n愿言事封殖，勿使间棘枳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 晚香","author":"陈宓","text":"春风斗妍丽，众卉芳可掬。\n丁时良亦好，暮景苦不足。\n独擅晚秋香，金英照寒渌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 袭芳","author":"陈宓","text":"红紫事鼎盛，嫣然媚日风。\n香气袅不断，郁若篝衣烘。\n请勿别高下，一种春阳回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 滋兰","author":"陈宓","text":"猗猗深林中，有类事谨独。\n采弃信所遭，幽芳孰荣辱。\n苦与群卉殊，千年犹有馥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 筠坞","author":"陈宓","text":"萍彩日相鲜，柳绵时暗度。\n无风亦生凉，有月助奇趣。\n偶来独坐时，爱此那能去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 锦步障","author":"陈宓","text":"白傅落草堂，茶果替鱼肉。\n不妨天与富，锦绣以为谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 橘浦桥","author":"陈宓","text":"素药到眼明，浓香满怀入。\n不忍度方桥，斜阳更凝立。\n千里洞庭秋，一杯还可挹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蒲岩次陈侍郎韵 其二","author":"陈宓","text":"我亦年来养气工，黄茅丹鼎欲生茸。\n蓬莱咫尺真堪玩，底恨三年弱水风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蒲岩次陈侍郎韵 其一","author":"陈宓","text":"纤巧难誇刻楮工，四时不改绿茸茸。\n祇应松桧堪为友，阅尽人间桃李风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赞勉斋黄先生像","author":"陈宓","text":"貌之癯有颜之乐，气之刚得轲之养。\n以身任道，老而益壮。\n仰止朱门，孰出其上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠喻景山","author":"陈宓","text":"去时恨轻分，归路喜忽值。\n如何七八月，两作别离味。\n方冲腊雪还，可待秋风至。\n读书我无诀，须君授奇秘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠寒谷道人","author":"陈宓","text":"我昔过君门，心闲懒问君。\n君今来深谷，无心似孤云。\n淋浪身上衣，磊落袖中文。\n相违复相别，去宿白鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"檄中原","author":"陈宓","text":"大哉我宋得天下，仁比三代泽过之。\n太祖太宗贻典则，真宗仁考父母慈。\n熙丰足国振百度，要使宇内无蛮夷。\n哲宗元祐建皇极，敬用贤哲如蓍龟。\n百年上下享安泰，万里一域惟熙熙。\n春阳浩荡不肃物，遂使异类窥京师。\n当时臣子不知义，视虏豺豹身狐狸。\n曲生苟活竟亦死，甘堕狡计宁非痴。\n三光晦昧五岳坠，二圣北狩无还期。\n忠臣至今痛入髓，下逮童騃犹歔欷。\n嗟尔中原旧豪杰，久效左衽心何为。\n譬如屈伏猛兽下，荷戈伺便当乘机。\n如何颜厚不愧耻，反助貙虎为熊罴。\n数穷六十又且半，天意悔祸人知思。\n王师六月降时雨，洒尔万国苏鳏嫠。\n汝犹不念汝祖父，靖康狄祸几无遗。\n子孙壮大不能报，臣妾雠虏称男儿。\n天戈所麾速响应，拯汝涂炭革汝非。\n吾皇仁圣又恭俭，视民如子伤如饥。\n汝今效顺谨勿迟，同我四海长欢嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东莱吕氏官箴以觅举求上官保庇书为第一戒今仕者往往十犯八九虽贤不免陷焉为诗以谢兼用奉勉","author":"陈宓","text":"凡厥女子，号为无知。\n十年不字，迟归有时。\n正节必守，淑行惧亏。\n孰谓君子，身不自持。\n不艮其背，顾朵其颐。\n自鬻苟售，宁不忸怩。\n莫答盛意，聊赠鄙词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新池答问","author":"陈宓","text":"即宅见湖，移园就宅。\n以果易谷，以宽补窄。\n以娱亲姻，以燕宾客。\n曰田曰园，孰失孰得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞麦","author":"陈宓","text":"维此瑞麦，十有三茎。\n伊谁所树，中夏以生。\n丰年之庆，圣治之臻。\n我作此赞，播之颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赞文公朱先生像","author":"陈宓","text":"貌温而严，德刚而粹。\n春融秋肃，渊澄岳峙。\n道光二程，识高百氏。\n生遇明时，进难退易。\n天假之间，斯文大备。\n伟哉夫子，教垂万祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赞梅溪王先生像","author":"陈宓","text":"先生之道，得天之全。\n气刚以和，如四时然。\n功在王室，惠留于泉。\n不怒而教，恶遏善迁。\n为政以德，信哉格言。\n先生之逝，四十三年。\n有庙有祠，民奉益虔。\n紫帽可砺，清名不骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与潘王二丈同游南康郡圃致爽亭","author":"陈宓","text":"瀑秩秩而可闻，山靡靡而旁绕。\n待皓月于台端，睇明河于木杪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈宓","text":"君自成龙我成道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题拿洋驿","author":"陈宗","text":"畬田高下趁春耕，野水涓涓照眼明。\n孰道深山最深处，人人解说长官清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明前一日友人招泛东湖 其一","author":"陈宗仁","text":"僧舍经旬只病眠，不知春事满湖边。\n相携步出城东去，杨柳桃花气欲烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明前一日友人招泛东湖 其二","author":"陈宗仁","text":"令节正逢一百五，轻舟閒泛两三人。\n弄珠楼下波如酒，酝碧摇红潏潏新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游大涤山","author":"陈宗古","text":"洞天三十六，奇邃此无俦。\n笙鹤有时下，神仙何处游。\n岩花自照水，谷鸟不啼秋。\n尽日松阴底，闲听寒涧流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"陈宗古","text":"闲访洞霄宫，幽奇景莫穷。\n溪山虽极远，岩穴自相通。\n若不寻尘外，无由到此中。\n高真在何处，笑我白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉岩 其二","author":"陈宗礼","text":"翠屏青紫互高低，清净仙人薜荔衣。\n正好观心坐岩下，忘归却是不忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉岩 其一","author":"陈宗礼","text":"山蹊屈曲石玲珑，今古游人兴不穷。\n一一圆明人不识，却寻石□任中通。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石仙观","author":"陈宗礼","text":"千丈飞崖倚半空，火云时节此清风。\n身闲一日俱仙思，何用藏形古木中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偕彭雅林游翠即席求和","author":"陈宗礼","text":"往事镌镵一梦同，游人聊此可从容。\n神仙已逝境犹在，洞府虽深户不封。\n阅遍古今云木老，洗空尘土石泉舂。\n此怀清白堪超世，何必星精特地逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题虞帝庙","author":"陈宗礼","text":"南国熏风入帝歌，至今遗庙只嵯峨。\n一天晓色怀明哲，四野春光想太和。\n存古尚瞻虞衮冕，抚时几换禹山河。\n海滨乐可忘天下，解写灵明是老轲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"陈宗礼","text":"川原绿已张，春去今何在。\n深树涵幽姿，微云弄晴态。\n禽声互酬应，林霏閒明晦。\n渐远人迹稀，清音自虚籁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓行","author":"陈宗礼","text":"披衣起遐征，微茫认前路。\n哀鸿天际云，残月水边树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚出","author":"陈宗礼","text":"落日山气清，归禽噪林杪。\n意行忘远近，吟过深烟表。\n㶁㶁水萦田，幽幽云反峤。\n忽闻邻寺钟，沿途发长啸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫霄观","author":"陈宗礼","text":"平陂复峻坂，曲折劳攀跻。\n中道忽孤绝，恍然遇安期。\n授以度世术，呼吸随风飞。\n长跪受隐文，三复叹且疑。\n变化岂不神，勾谲莫予期。\n回鞭指故山，从此问所归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澹山岩","author":"陈宗礼","text":"永州澹岩天下稀，山灵妙斲涪翁知。\n蹲猊翔凤献颖异，中有仙佛来娱嬉。\n我生骨相□冰雪，心境相□生怿悦。\n缘轻自笑来已迟，犹见岩前古时月。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈宗礼","text":"山川半为蛮烟累，人物多因谪籍香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东洞","author":"陈宗臣","text":"蔚蓝胜概世应稀，中有高人隐翠微。\n那日徵书来古洞，恩光荣耀倍山辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行","author":"陈宗远","text":"鸥鹭滩头帆卸雨，牛羊影外草生烟。\n渔人撒网潮平晚，柳岸维舟取次眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵溪舟中风雨","author":"陈宗远","text":"斜风吹雨打篷窗，独棹孤舟向晓江。\n沙岸竹洲烟漠漠，青山飞鹭一双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牵牛花","author":"陈宗远","text":"绿蔓如藤不用栽，淡青花绕竹篱开。\n披衣向晓还堪爱，忽见蜻蜓带露来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人","author":"陈宗远","text":"黄梅浦远草萋萋，风细孤帆雨后低。\n渔笛一声何处作，故山回首白云迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悯农","author":"陈宗远","text":"条桑事了蒸麻急，刈麦人兼种稻归。\n作苦那能衣食足，几多游冶厌轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢石庵见示棹歌叹时因以见意","author":"陈宗远","text":"芦花袅袅西风急，独立高楼闻雁声。\n志士最伤秋夜月，江南塞北两般明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月初五日有怀旧事","author":"陈宗远","text":"看来扰扰总何谋，且把行藏用酒酬。\n篱菊趁阴移别径，江枫向晚落行舟。\n秋虫在壁催人织，归燕辞巢恋主愁。\n今日去年风物异，钱塘还在望山楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代寿","author":"陈宗远","text":"自上黄枢赞万机，曾将谋略定边陲。\n平淮便放裴公逸，去越犹嫌范相迟。\n潋滟池塘莲万朵，婵娟亭馆竹千枝。\n居东剩有明农志，归衮应赓七月诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代寿帅书三首 其一","author":"陈宗远","text":"欲看棠阴续世传，重移星履下鄞川。\n风薰辕戟清官府，日暖瀛壶小洞天。\n塞外不传青海箭，幕边稳泛绿池莲。\n个中便是神仙境，何必崆峒访偓佺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代寿帅书三首 其三","author":"陈宗远","text":"笑谈樽俎有馀欢，不独民安吏亦安。\n竞喜鲰生兼盛赐，那堪鹗表录微官。\n投机已发千钧弩，速化仍资九转丹。\n青眼相逢尤异处，他年翘馆旧门阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代寿帅书三首 其二","author":"陈宗远","text":"勋业从来简帝聪，东溟还复奏肤公。\n庭前修竹添新绿，洞里蟠桃依旧红。\n野渡横舟人未老，大川作楫路将通。\n愿观整顿乾坤手，不负当年射六蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代寿某帅二首 其二","author":"陈宗远","text":"三年姬衮尚居东，官府清平冠六雄。\n仙洞蟠桃红映日，山亭修竹绿梳风。\n已将儒雅安时俗，更即人和验岁丰。\n俭幕栖身无以颂，元龟游戏出莲丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代寿某帅二首 其一","author":"陈宗远","text":"当年禁履上星辰，便合登庸秉国钧。\n盖海旌幢纡出镇，济川舟楫已知津。\n但从渤澥清沂泗，肯把关河自越秦。\n酝酿早成六月雨，一朝翻手洗炎尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"传闻八月十四日唱名","author":"陈宗远","text":"北斗三魁夜吐芒，竞传胪唱擢王扬。\n遥知天上轮光满，先放人间桂籍芳。\n失笑月乌空绕匝，那知云雁不成行。\n姮娥留取十分好，万里清辉分外彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因雨遣兴","author":"陈宗远","text":"细雨冥冥风顿凄，微沾沙路不成泥。\n珠排檐网凝丝重，琼积荷盘压柄低。\n青草岸头三月暮，黄梅叶外一山迷。\n小塘水满鱼过堑，随浪流沟入古溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安仁楼间晚晴时送默斋伯回星江","author":"陈宗远","text":"已是悲秋客，那堪送远人。\n乱山残照惨，落叶晚风频。\n去恨随帆远，回头转意亲。\n明朝相忆处，鳞雁达情真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寺深","author":"陈宗远","text":"寺深幽寂寂，四月似秋天。\n夜久听山雨，晚来添石泉。\n断岩风啸木，疏竹鸟栖烟。\n钟鼓林梢动，空堂已罢禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]