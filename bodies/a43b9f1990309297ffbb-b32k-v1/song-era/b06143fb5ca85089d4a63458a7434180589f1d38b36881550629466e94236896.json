[{"title":"晓出城祀风师坛马上作","author":"宋庠","text":"风穴灵坛背汉皋，肃将祀典会诸曹。\n城头五鼓催关钥，席上双笾荐沼毛。\n冠岭昕霞迎霁旭，冒畴农橛渍春膏。\n箕扬毕好宜流惠，江外刀耕楚俗劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓汲","author":"宋庠","text":"晓汲过春畦，高梧待凤攲。\n瓮思閒凿?，瓶险畏居湄。\n照影香钗坠，蠲烦素绠垂。\n寂寥无醉辖，瓢饮共栖迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓谒城东岳祠回马上作","author":"宋庠","text":"洚水成灾后，霜原落木秋。\n浊河虽自复，寒潦不知收。\n路坏停轺馆，城摧却敌楼。\n民廛无黍稷，何术望神休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"流杯小宴偶成拙诗奉呈运使王密学紫微韩舍人","author":"宋庠","text":"溪斋元巳得嘉宾，曲曲烟渠逗翠沦。\n泼火乍经三月雨，泛觞重记九年春。\n风前小舞惊馀雪，梁外清歌落暗尘。\n此会贵交应绝拟，斗枢星掖两贤臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浩叹","author":"宋庠","text":"鼻浊哀吟倦，空怀浩叹盈。\n心同注钩怯，功比画墁轻。\n俗态惊狙怒，刚肠谢鹜争。\n淹回江外客，日夕望尧旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮桥","author":"宋庠","text":"东潬双津隘，浮梁古制存。\n滩移淤岸势，标谑涨波痕。\n逆浪船排首，周阿缆植根。\n祀劳如举典，元凯有英魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涉淮溯清迫于冰涸舟次下邳先寄彭门赵侍御二首 其二","author":"宋庠","text":"此地淮壖极，连樯北转初。\n风烟寒背楚，陂泽远通徐。\n葆发惊秋外，葵心恋阙馀。\n不忧芳岁晚，松柏自扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涉淮溯清迫于冰涸舟次下邳先寄彭门赵侍御二首 其一","author":"宋庠","text":"病骨忧南土，孤怀念北迁。\n欣承紫泥诏，且向汶阳田。\n夜雪淮冰合，朝暾海气鲜。\n风波虽缭绕，自有故交怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疾风","author":"宋庠","text":"天陆箕躔动，林箫万籁空。\n扶摇庄海北，悲眩鲁门东。\n贪诫诗人隧，清思赋客雄。\n何因知劲草，霜陌尽飞蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病臂痛踰月不能御刀笔","author":"宋庠","text":"百疾乘衰运，双肱怯痹摇。\n身知九折痛，肉讶半分销。\n掉市将谁羡，拘原莫我邀。\n惟堪楚林下，如槁学承蜩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致仕得请泛舟归第","author":"宋庠","text":"辅郡初辞节，孤舟始去官。\n桥头帆影急，枕底浪声寒。\n好爵云谁宠，危心且自安。\n赐车诚可爱，閒共子孙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政张郎中惠亲画墨竹二㡧以诗为报","author":"宋庠","text":"南宫仙老本多才，素幅珍纨绘境开。\n高节自缘心匠出，野丛还拥笔端来。\n挂馀粉箨疑飘席，玩久风枝欲扫苔。\n俗眼莫惊无藻丽，岁寒颜色抵琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读贾谊新书","author":"宋庠","text":"谁谓贾生学，兼之文帝朝。\n死忧王坠马，生赋鵩如鸮。\n被召宣温密，矜功绛灌骄。\n勤勤论五饵，史笔未相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"豹隐堂","author":"宋庠","text":"昔日蒸青地，今兹坐啸居。\n人瞻分虎出，庭记堕鳣馀。\n萧墨斋犹宝，庄环室旧虚。\n嘉名传郡志，宁减武侯庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都官谢员外今年春榜舟奉使予饯别于东亭孟夏之初不幸卒于中道其孤迎丧还都予又出吊于饯所俯仰陈迹因为诗以寄哀","author":"宋庠","text":"沟水新伤掺袂人，何言便作死生分。\n地中玉树无期见，琴上牙弦忍再闻。\n几日离觞成渍酒，平时芳札代遗文。\n东亭哭罢愁回首，落照铭旌隔野氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱侯东斋","author":"宋庠","text":"北里开公第，东斋集俊游。\n秘书家有副，甲令世传侯。\n凤竹供联册，鲭盘入宴羞。\n门前多鹤盖，不为骋长楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乾兴诏罢自咏","author":"宋庠","text":"忍当昭世卧隆中，西笑无谋始讳穷。\n鸥散海边渔事废，炙残京口客盘空。\n乡魂怨晓虚为蝶，头葆悲秋不后蓬。\n欲把遗编论兴废，诸儒争奈喜嘲雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿斋太一宫寄天休","author":"宋庠","text":"入暮凫钟警，乘凉鹄帐褰。\n雾来灯欲湿，萤过草疑燃。\n野气樽浮桂，幽香席藉荃。\n无因招傲吏，同宿一壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄许师孟","author":"宋庠","text":"鶗鴂三惊楚泽秋，回肠更用斛添愁。\n燕台市骏千金骨，汉客逃名九罭鳅。\n木断华樽俱失性，瓢空陋巷独堪忧。\n夏畦墦食非吾事，终访班生问一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李端明献臣","author":"宋庠","text":"学道年嗟晚，知非骨已惊。\n世纷誇要路，天意罪浮名。\n汶上朱轓宠，淮南白发生。\n惟馀方寸地，留贮岁寒情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄武昌胡从事","author":"宋庠","text":"君家酥酪弟兄贤，督府从军滞幕莲。\n江上归音鱼失素，天边离思月成弦。\n阮毫答记无遗草，楚赋悲秋有剩篇。\n玉骨道风沈俊久，汉条新计会甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄致政杜相国","author":"宋庠","text":"多年零雨咏公归，得谢高怀与世违。\n池凤何尝嗟见夺，冥鸿终不更低飞。\n寿觞应举三朋酒，师衮閒抛一品衣。\n我亦摧颓踰耳顺，异时惇史托馀辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题奉宁枢密直谏议新葺漱玉斋","author":"宋庠","text":"闻说西斋水，潺湲逼画楹。\n虽添新窦响，不改故源清。\n花落波浮乱，杯迟屈曲行。\n无因陪夜宿，同赏瀑岩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得天经书问","author":"宋庠","text":"久卧堪忧巷，惊闻不灭书。\n高风五柳外，深意八行馀。\n努力邀加饭，相逢约下车。\n殷勤长跪读，双睫费涟如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得充国书报都中葺所居初成辄以自慰作一首寄子京","author":"宋庠","text":"昔贵三公第，今营一亩居。\n聊堪避燥湿，兼欲贮琴书。\n兽窟犹思骋，鹪巢不愿馀。\n长安穷僻地，吾亦爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得许六书","author":"宋庠","text":"车笠论交夙契深，文麒江海获归音。\n流光过隙偏惊驷，危睫沾衣不为琴。\n宁扣几劳歌白石，庄昏犹欲注黄金。\n无因一答瑶华问，南国洪乔牍易沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得告上冢","author":"宋庠","text":"拜墓标唐令，褒亲漏汉恩。\n永怀凄欲寄，忠训蔼如存。\n宰树锦城陌，农畴颍曲村。\n异时裁叙传，容或记皋门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"掖门待漏","author":"宋庠","text":"晓陌千槐落，严扉万盖留。\n浮云低观阙，残漏急章沟。\n斗柄遥临殿，参旗侧映楼。\n如何轩上鹤，独忆海天秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚出池上","author":"宋庠","text":"憭慄梧楸似楚骚，霜馀寒水失溪毛。\n游鳞泼泼心应乐，乱雀飞飞意不高。\n平世功名难强立，昔贤卿相是真逃。\n人间万事无涯际，争得先生一藉糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚台","author":"宋庠","text":"霁色秋空送目劳，小台摇落更平皋。\n红垂海树乌栖日，清溢江沱鹭浴涛。\n天势暮围鳞隰阔，雁行斜转翼云高。\n楚风摵摵迷魂地，可在扬雄独广骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归驰道遇雨马上作","author":"宋庠","text":"朝雨杂轻霾，浓阴暮未开。\n天低五里雾，日晦九成台。\n宫溜轻淙玉，坊车小隐雷。\n不愁驰道远，宝色夹千槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚岁感旧寄永兴相国晏公","author":"宋庠","text":"误知三十载，顽鲁寄洪钧。\n物比青毡旧，年惊白发新。\n河冰斜界陕，关树曲遮秦。\n何日陪师席，孤怀跪自陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚坐观风亭三首 其三","author":"宋庠","text":"我来秋色逼霞曛，更作凭阑远望人。\n山口远衔遥白渡，水头斜略小平津。\n年华有恨惊心去，世事无端刺眼新。\n深愧具茨芝朮在，挂冠终拟狎尧民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚坐观风亭三首 其二","author":"宋庠","text":"百尺空台河上城，远波虚籁助秋声。\n过穷旅雁书难得，啼杀饥乌曲未成。\n急节何当容白发，流尘只欲傍华缨。\n临高莫讶频东顾，忧国思君不为名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚坐观风亭三首 其一","author":"宋庠","text":"戍楼西北最凌空，倦客凭阑八月风。\n一曲黄河连野浊，半规残日背人红。\n山林枉负沉冥志，刀笔终无尺寸功。\n犹喜不迷存阙地，绛英瑶斗虎牢东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚坐高明台","author":"宋庠","text":"悔倚危栏望夕霏，临高无事亦依依。\n天长去鸟几时返，风罢孤云何处归。\n一世功名惭击节，百年耕凿愿忘机。\n衔恩感旧谁能免，犹喜荒洲在日围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚泊白村登舟回望因成拙句寄淮阳龙图王给事","author":"宋庠","text":"临艎西溯近神坰，六辅联疆见驿亭。\n千里暮霞烘日脚，一篙春水皱天形。\n野桥烟火微分市，曲岸渔樵别有汀。\n忽忆主人恩意厚，倚樯回首涕空零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚庭","author":"宋庠","text":"苍霤秋霖歇，高轩夕景迟。\n桐凋金井恨，兰老玉琴悲。\n巢燕寒初失，风蝉晚屡移。\n黄昏禽语闹，相唤宿何枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春小园观物","author":"宋庠","text":"小园乘暖敞孤斋，畦埒经春尽绿苔。\n新笋偶随枯筱出，野花閒抱故藤开。\n双桐夹路元标井，酸枣依墙本乏台。\n北户清风时一至，此身疑到上皇来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春出郭游北山佛寺","author":"宋庠","text":"幽刹寻春傍翠微，游人谁解惜芳菲。\n阴晴野日不常见，红白路花相杂飞。\n一世功名催俊杰，千金歌舞属轻肥。\n左迁病守真无用，试学山公倒载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚望京邑","author":"宋庠","text":"暮垒初休角，孤谯半掩门。\n鸿声骋寥泬，鸦意恋黄昏。\n远岫排头碧，春河彻底浑。\n关东三百里，依约是天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴","author":"宋庠","text":"斜日红初敛，晴山翠欲流。\n休歌陌妇怨，宁作贾胡留。\n物意如相乐，吾生有底愁。\n早分好风月，更上庾公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登东楼怀子京镇阳二首 其二","author":"宋庠","text":"周界西穷陕，常山北尽边。\n关河相望日，容鬓各衰年。\n蓬乱将风野，禽稀欲雪天。\n治戎如有暇，莫惜赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登东楼怀子京镇阳二首 其一","author":"宋庠","text":"洛表楼堪倚，燕陲望不穷。\n秋声南送雁，寒意北随风。\n敛暝关云黑，衔规苑日红。\n凋年霜霰恶，慎勿损荆丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚霁","author":"宋庠","text":"断续檐声歇，徘徊隙影赊。\n归云冲树破，残雨入楼斜。\n径绿都成草，丛薰尚隐花。\n便同江海思，春水照军牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨兴春冷","author":"宋庠","text":"玉骨临风怯，华钉恨带宽。\n冻醪催卯醉，小雪造春寒。\n锦瑟弦声润，山炉蕙炷乾。\n良辰他日意，慎勿怨花残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨兴读书","author":"宋庠","text":"老病何为者，陵晨缥帙开。\n终无经世略，似有著书才。\n史记金藏匮，春秋玉作杯。\n吾心聊自适，万事已焉哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨谒书所见","author":"宋庠","text":"绀幰鸣珂万盖翔，九门冠剑拥晨光。\n城连南北长安斗，殿倚东西太极堂。\n云里铜乌风作籁，天边金掌露成霜。\n微生备位如葵藿，只有倾心奉圣王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨谒宫门小雨初过","author":"宋庠","text":"宫漏签声急，天街雨脚微。\n晓寒凌禁树，春气裛朝衣。\n瑞雾轻犹湿，香尘重不飞。\n鸡人传钥出，华旭满彤闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨谒感怀","author":"宋庠","text":"早拂华簪谒冕旒，五更残点便鸣驺。\n星沈长乐钟声外，月挂觚棱阙影头。\n弱翮讵堪仪振鹭，孤怀终欲信群鸥。\n更惭晨坐鸿枢府，容鬓先于省树秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"宋庠","text":"花落亭亭素脸开，忍寒刚欲背春来。\n已迷江令琼花树，更傍周王璧水台。\n楚馆娇云愁梦断，洛廛香雪待风回。\n一枝寄远真何益，费尽南朝陆凯才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上","author":"宋庠","text":"晚岁清淮路，淹留数问津。\n风平天合水，舟进树迎人。\n饥鹜贪鱼没，高鸿望渚遵。\n楚乡梅柳意，相慰似先春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮南早春风雨连日俗以为宜","author":"宋庠","text":"淮海岁方新，层阴便浃辰。\n山山能作雨，物物解呈春。\n野鸟千声异，江芜一色匀。\n农区田溜满，偏慰守藩臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮南自讼","author":"宋庠","text":"偶然人乏贰中枢，赐罢犹专督府居。\n发白自伤闻道晚，心丹谁识报恩馀。\n淮天目极风帆驶，韩野魂销宰树疏。\n却顾病身何所用，只堪归钓颍滩鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮南汶上三见春物有感","author":"宋庠","text":"一麾南北数移官，三见莺花送雁寒。\n双鬓欺人还似雪，寸心忧国本如丹。\n雕虫曲艺论文浅，乘障迂儒破敌难。\n惟有归耕初志在，故田西接饮牛滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳之九兄以仆承乏制曹幸联局事向当成绩猥辱裁篇谨抒拙诗以谢来贶","author":"宋庠","text":"汉家挈令赖诸公，末至缘何玷选中。\n马尾不知书画误，鸟声偏乐友心同。\n忘忧日接三杯善，轧思时分一溉功。\n敢向明廷邀异赏，从来儒术比司空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳之太尉相公寄示赴镇小编三复成诵研味之馀理当酬继但难于遍和辄取首题赋成拙句一首既伸高山仰止之愿并以为谢","author":"宋庠","text":"西北遮胡晋部疆，更烦儒将下文昌。\n久调玉铉三司贵，出倚金城万里长。\n唐亩岁丰禾自合，汾波秋景草应黄。\n须知外警从兹罢，閒杀边邮赤白囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"添色红","author":"宋庠","text":"景淑能藏媚，情多不顿开。\n初疑香色老，终伴綵烟来。\n夕露濡仙缬，晴阳染醉腮。\n施朱应有意，并为楚人材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日东归舟次滞雨","author":"宋庠","text":"月弦离毕破芳辰，舟子招招数问津。\n压岸晚阴云著野，蘸渠春色柳随人。\n烟畴雊雉逢谁叹，风碛惊鸥莫我亲。\n赐告有程归棹急，赧然归水愧游鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明出沐","author":"宋庠","text":"晓树阴岑客舍春，卿舆不访著书人。\n长楸有地金成埒，曲突无烟桂徙薪。\n自欠解兰抛北阜，更堪鸣磬是南邻。\n饧香酝冷沈欢绪，枉负山郎出沐辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谋退","author":"宋庠","text":"家家皋稷会亨辰，老丑无谋念孰亲。\n自乐一麾称外守，耻将三物诅谗人。\n灌园路僻苍烟晓，洗耳滩长碧溜春。\n此地敢言逃楚相，他年终拟作尧民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谋退四首 其四","author":"宋庠","text":"济世才无取，登朝运所遭。\n濡鹈真窃禄，汗马本非劳。\n汉重商贤隐，尧嗟颍客高。\n古今閒自况，何翅九牛毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谋退四首 其三","author":"宋庠","text":"昔日于陵子，遗荣自灌园。\n三分轻国爵，一世谢人諠。\n野笠锄春陇，横槔汲晓源。\n区区冒荣者，天壤亦何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谋退四首 其二","author":"宋庠","text":"常闻疏少傅，知足遽辞官。\n祖道宾仪盛，挥金里宴欢。\n畏途非蠖屈，高志自鹏抟。\n行路贤哉叹，吾心良所安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谋退四首 其一","author":"宋庠","text":"勤勤念耦耕，不是钓虚名。\n皓魄圆犹缺，芳卮满故倾。\n佩韦防事急，分肉倚心平。\n此意将谁语，临深坐冶城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒龙门无畏师塔祈雨作","author":"宋庠","text":"梵圣遗灵骨，洪缘福故都。\n慈深云不断，法遍雨常俱。\n使节开真椁，天香奉供炉。\n拳拳依帝力，馀润冀昭苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"善惠师禅斋","author":"宋庠","text":"象马王城地，禅扃此独开。\n漏声随叶换，风意绕幡来。\n驯鸽依斋树，飞花恋讲台。\n朝珂时一集，并为碧云才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]