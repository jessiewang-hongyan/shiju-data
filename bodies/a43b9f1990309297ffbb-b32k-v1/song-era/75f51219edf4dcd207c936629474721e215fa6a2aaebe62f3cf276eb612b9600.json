[{"title":"赠魏宪","author":"魏宪叔","text":"炎祚无疆越万龄，如何夷卤尚凭陵。\n中兴事业须王导，拨乱韬钤要孔明。\n剧盗已分齐钺定，端星行指泰阶平。\n呼韩朝渭非难事，好继当时丙魏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开府李公挽章 其二","author":"秦观","text":"戚里薨耆旧，哀荣世未如。\n襚加三事衮，奠致两宫舆。\n卤簿前衢隘，歌钟后院虚。\n英风知不坠，芝玉茂庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈用之学士挽词 其二","author":"秦观","text":"岧峣芸阁上参天，直舍相依欲二年。\n愿写此情歌挽者，泪沾毫素不成篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王昭君","author":"秦观","text":"汉宫选女适单于，明妃敛袂登毡车。\n玉容寂寞花无主，顾影低回泣路隅。\n行行渐入阴山路，目送征鸿入云去。\n独抱琵琶恨更深，汉宫不见空回顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐昌公主","author":"秦观","text":"金陵往昔帝王州，乐昌主第最风流。\n一朝隋兵到江上，共抱悽悽去国愁。\n越公万骑鸣笳鼓，剑拥玉人天上去。\n空携破镜望红尘，千古江枫笼辇路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔徽","author":"秦观","text":"蒲中有女号崔徽，轻似南山翡翠儿。\n使君当日最宠爱，坐中对客常拥持。\n一见裴郎心似醉，夜解罗衣与门吏。\n西门寺里乐未央，乐府至今歌翡翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无双","author":"秦观","text":"尚书有女名无双，蛾眉如画学新妆。\n伊家仙客最明俊，舅母唯只呼王郎。\n尚书往日先曾许，数载暌违今复遇。\n闻说襄江二十年，当时未必轻相慕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灼灼","author":"秦观","text":"锦城春暖花欲飞，灼灼当庭舞柘枝。\n相公上客河东秀，自言那得傍人知。\n妾愿身为梁上燕，朝朝暮暮长相见。\n云收月堕海沉沉，泪满红绡寄肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盼盼","author":"秦观","text":"百尺楼高燕子飞，楼上美人颦翠眉。\n将军一去音容远，只有年年旧燕归。\n春风昨夜来深院，春色依然人不见。\n只馀明月照孤眠，回望旧恩空恋恋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔莺莺","author":"秦观","text":"崔家有女名莺莺，未识春光先有情。\n河桥兵乱依萧寺，红愁绿惨见张生。\n张生一见春情重，明月拂墙花影动。\n夜半红娘拥抱来，脉脉惊魂若春梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采莲","author":"秦观","text":"若耶溪边天气秋，采莲女儿溪岸头。\n笑隔荷花共人语，烟波渺渺荡轻舟。\n数声水调红娇晚，棹转舟回笑人远。\n肠断谁家游冶郎，尽日踟蹰临柳岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烟中怨","author":"秦观","text":"鉴湖楼阁与云齐，楼上女儿名阿溪。\n十五能为绮丽句，平生未解出幽闺。\n谢郎巧思诗裁剪，能使佳人动幽怨。\n琼枝璧月结芳期，斗帐双双成眷恋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离魂记","author":"秦观","text":"深闺女儿娇复痴，春愁春恨那复知。\n舅兄唯有相拘意，暗想花心临别时。\n离舟欲解春江暮，冉冉香魂逐君去。\n重来两身复一身，梦觉春风话心素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江月楼 其二","author":"秦观","text":"苍梧云气眉山雨，玉箫三年无今古。\n九天雨露蛰蛟龙，琅玕长凭清虚府。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹤观","author":"秦观","text":"复殿重楼堕杳冥，故基乔木尚峥嵘。\n银河不改三千尺，铁马曾经十万兵。\n华表故应终化鹤，谪仙未解独骑鲸。\n井泉一一儿童旧，白发衰颜祇自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"秦观","text":"雨砌堕危芳，风檐纳飞凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"秦观","text":"城晚通云雾，亭深到芰荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思诗呈同院诸公三首 其一","author":"李公麟","text":"苦学邓夫子，仁风良可依。\n颜回乐也内，曾点咏而归。\n盛德弥年劭，知音贵我稀。\n潇湘逢此地，咳唾得明玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思诗呈同院诸公三首 其二","author":"李公麟","text":"琉璃墨客堂，太乙助灯光。\n紬史探金匮，摛辞和柏梁。\n近传江綵笔，远缉汉珠囊。\n吏部文难可，犹称万丈长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思诗呈同院诸公三首 其三","author":"李公麟","text":"共校南宫艺，多年复此回。\n群贤主堂奥，一榻占廊隈。\n步屧朝追逐，诗筒夜往来。\n故人情不浅，无乃困悭才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思秋日同文馆诗三首 其一","author":"李公麟","text":"锁寂身如隐，幽清物向齐。\n忘忧经露菊，苏肺到霜梨。\n白发知谈笑，朱签历品题。\n贤书天下望，鹊喜遍深闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思秋日同文馆诗三首 其二","author":"李公麟","text":"呦呦鸣鹿野，皎皎白驹场。\n朋盍连茅茹，文程琢玉章。\n门通三级峻，桂露一年香。\n庆及飞龙旦，同歌庶事康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思秋日同文馆诗三首 其三","author":"李公麟","text":"寄栖容幕燕，覆节等醯鸡。\n欲雨风多北，穷秋日易西。\n官书便夜读，家报索亲题。\n早晚骖騑入，重门坼印泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思未试即事杂书率用秋日同文馆为首句三首 其一","author":"李公麟","text":"树乾风索索，霜叶到书闱。\n枝并鹪鹩宿，床吟蟋蟀归。\n幽人知坦履，游子念缝衣。\n暗喜还家近，承颜慰久违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思未试即事杂书率用秋日同文馆为首句三首 其二","author":"李公麟","text":"莫以多为赘，须知寸有长。\n抡才何济济，顾我独凉凉。\n雷雨龙皆起，江湖鱼两忘。\n攀依聊假手，贤立本无方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思未试即事杂书率用秋日同文馆为首句三首 其三","author":"李公麟","text":"今朝庭鹊喜，灯为一花开。\n侧指皂囊去，转头骢马来。\n新橙家斫鲙，残菊客浮杯。\n乐事连休日，须凭酒作媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思天启有少年真喜事之句用其韵和","author":"李公麟","text":"秋日同文馆，凄风动九回。\n乱云收暑去，一雨送寒来。\n猥与英躔接，惭非藻鉴陪。\n雍畿兹吁俊，元祐看新魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思初入试院","author":"李公麟","text":"敕使书囊问队行，聚星深馆粲诸英。\n云随襟袖来蓬岛，香散房栊宿化城。\n振鹭充庭天有幕，珊瑚入网海无声。\n范模一世尊先觉，况此提平慰后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和余樗年试院即事呈诸公","author":"李公麟","text":"盍簪闻善若江河，帘幕疏閒笑语过。\n月照飞笺穿户绮，风生挥麈动衣罗。\n已张英彀收三俊，更赋离骚续九歌。\n凉夜沉沉清不寐，空庭无奈叶声何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思重九考罢试卷书呈同院诸公二首 其一","author":"李公麟","text":"吁俊天畿合辟雍，愧将瓦釜缀黄钟。\n听穷一一竽无滥，拨遍磷磷玉似逢。\n龟列春庭先壤奠，龙飞天路得云从。\n吾曹莫念拘萦久，求称公朝庆赏浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思重九考罢试卷书呈同院诸公二首 其二","author":"李公麟","text":"鞅掌栖迟一亩宫，愤听更柝及晨钟。\n黄华慰眼祗尔许，绿蚁于人亦漫逢。\n几日囊篇赓不逮，三时庭步笑相从。\n近来寻却家山梦，投枕和衣睡更浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓慎思己未年春与伯时校试南宫同年被命者六人今兹西馆唯同伯时一人而已因书奉呈","author":"李公麟","text":"忆锁南宫会友文，天梯相摄看云津。\n白头笑我成今日，青眼逢君尚昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谨次元韵奉酬慎思学士年友","author":"李公麟","text":"君家祝融水一方，平生书闱食可忘。\n云河漱润搴瑶芳，天帝璧府雠书郎。\n驰骋千载凌子长，神清骨秀颜色苍。\n书淫传癖笑舆狂，十年此会同都堂。\n上楼吟春碾旗枪，诗筒吴歈赓楚羌。\n一律校文公否臧，日饱大官沆瀣粮。\n朱鸾入网空南冈，贤书奏牍纷满床。\n朝出粉闱暮帝旁，骎骎天路群龙骧。\n病鸱帖帖乃污隍，白云陇望因俶装。\n放歌长林声激扬，佩兰思馨虽朋亡。\n云出鸟还聊自偿，羽扇麈尾随经囊。\n龙眠乃是无何乡，朝游不辞麋鹿行。\n归卧展图观骕骦，宪贫颂古时歌商。\n徜徉兴罢住云房，焚柏翻经究法王。\n冉冉暗度岁月光，山头草青还叶黄。\n洞明已死閒骨香，凡志未就嗟凉凉。\n亲颠向白每称觞，旨甘鞭后难翱翔。\n朅来窃食天中央，古人千岁空相望。\n同文锁密御史霜，得公再集评文章。\n亦说种松辋口庄，使我梦蝶栩栩忙。\n便欲负郭占农祥，门开傥容倚孔墙。\n想挽北斗下挹浆，箜篌更对高秋张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠蔡天启","author":"李公麟","text":"上溯虞姒亦易尔，下者始置周秦间。\n造端宏大町畦绝，往往世俗遭讥讪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小诗并画卷奉送汾叟同年机宜奉议赴熙河幕府","author":"李公麟","text":"画出离筵已怆神，那堪真别渭城春。\n渭城柳色休相恼，西出阳关有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春社出郊","author":"李公麟","text":"千寻古栎笑声中，此日春风属社公。\n开眼已怜花压帽，放怀聊喜酒治聋。\n携刀割肉馀风在，卜瓦传神俚俗同。\n闻说已栽桃李径，隔溪遥认浅深红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题醒心亭","author":"常安民","text":"为爱昌黎湖上句，醉来直上醒心亭。\n烦酲不待山风解，卧读残碑已自醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀嵩楼","author":"常安民","text":"当年谩作嵩山想，末路难回瘴海身。\n斜日西风总如昨，风流只欠倚栏人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游师埪寺留题","author":"程奇","text":"尘中总总谁青眼，黄发苍颜世情短。\n坐看前溪一片云，安得相从任舒卷。\n浩歌聊咏北山薇，不有归心真自欺。\n欲借养和延昼梦，数声啼鸟日平西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘阮洞","author":"王沔之","text":"流传晨肇隐无踪，搜发仙源属郑公。\n百尺灵泉清澈底，千寻苍玉势凌空。\n飘香故迹人虽到，采药巅崖路不通。\n二女深沉断消息，桃花依旧笑春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题耿氏温凊堂","author":"满中行","text":"密牖疏棂次第施，却寒清暑两相宜。\n惟知堂上双亲乐，不觉人间四序移。\n美酒先春和气满，茂林亭午绿阴垂。\n閒居就养如君少，无负南陔孝子诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真仙岩二首 其一","author":"钱师孟","text":"巨石何争此结成，老君有像亦难名。\n以身为患言犹在，漫使当时分重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汝坟驿壁三首 其一","author":"廖正一","text":"阿怜二十颇有馀，秀眉丰颊冰琼肤。\n无端欲作商人妇，更枉方寻海畔夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汝坟驿壁三首 其二","author":"廖正一","text":"阿梅笄岁得同欢，懊恼情深解梦兰。\n莺语轻清花里话，柳条柔嫩掌中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汝坟驿壁三首 其三","author":"廖正一","text":"淮源距襄阳，亭候逾十舍。\n征鞍背绣帏，云雨□四夜。\n双艳尽倾城，一姝偏擅价。\n独怒蕙心轻，误许商人嫁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张十八画","author":"廖正一","text":"玉人风味夙相亲，骨法多奇巫峡神。\n何幸丹青烦右相，坐令虚室四时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴可权长官","author":"廖正一","text":"士元应展骥，百里聊尔绊。\n函继三异声，江述凭东观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李主簿彦和","author":"廖正一","text":"李侯持尺璧，十五城不换。\n倦飞偶栖棘，孤鸣异巢鹳。\n淮海一俊乂，博洽识理乱。\n国论匪与闻，偷将经术断。\n君家文多豪，陵峤贺白观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和补之梅花","author":"廖正一","text":"蕙兰芳草久睽离，偶泄春光此一枝。\n自许轻盈羞粉白，何人閒丽得邻窥。\n寒欺薄酒魂消夜，月入重帘梦破时。\n幸有暗香襟袖暖，江南归信不应迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘阮洞","author":"郑至道","text":"采药归来世代赊，洞门方此扫烟霞。\n碧潭清泚弄明月，翠巘高低飘落花。\n芳草已迷当日路，白云空想旧人家。\n自惭不是浮觞侣，谩向山前醉帽斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"郑至道","text":"近村得雨远村同，上圳流波下圳通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安适轩","author":"唐最","text":"卧听潮音坐看山，烟萝静处闭禅关。\n都将物外红尘隔，占得壶中白日閒。\n吟罢寒猿号木末，定回清磬落云间。\n高僧隐几无馀事，应笑劳生去又还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高盖名山院二首 其一","author":"施常","text":"白云来去自闲闲，锁勒千山与万山。\n仙客已归霄汉去，虚堂流水漫潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高盖名山院二首 其二","author":"施常","text":"步尽千山与万山，白云步处叩禅关。\n晓猿夜鹤应相笑，笑问劳生几度闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"击瓯楼","author":"邵叶","text":"驻旌元帅遗风在，击缶高人逸兴酣。\n水转巴文清溜急，山连蒙岫翠光涵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麓阴亭","author":"邵叶","text":"山腰路转响湾泉，一径悠然陟翠巅。\n满眼祥云绕法供，刊岩瑞像俨金仙。\n元戎孝感诸天护，古木歌题峭壁镌。\n俯仰岩亭尽幽绝，夜深灯火更流连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"徐常","text":"词赋切宜师二宋，文章须是学三苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遗贾耘老蟹","author":"沈偕","text":"黄粳稻熟坠西风，肥入江南十月雄。\n横跪蹒跚钳齿白，圆脐吸胁斗膏红。\n齑须园老香研柚，羹藉庖丁细擘葱。\n分寄横塘溪上客，持螯莫放酒杯空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"报贾耘老诗仍次韵","author":"沈偕","text":"虫腹无端苦动风，团雌还却胜尖雄。\n水寒且弄双钳利，汤老难逃一背红。\n液入几家烦海卤，醢成何处污园葱。\n好收心躁潜蛇穴，毋使雷惊族类空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烟雨楼","author":"李丹","text":"乾坤交泰气氤氲，烟雨标名望意云。\n自是圣时多瑞霭，莫疑蛮徼有妖氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天堂地狱偈","author":"李丹","text":"释迦生中国，设教如周孔。\n周孔生西方，设教如释迦。\n天堂无则已，有则君子登。\n地狱无则已，有则小人入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题真阳南山","author":"李丹","text":"南山地久与天长，磐石安基势永昌。\n亿世皇图齐不拔，万年圣寿等无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李丹","text":"二顷田园祇旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝗不入青丘","author":"林磐","text":"赈济饥荒尚未苏，旱蝗何幸我疆无。\n悲愁远宦天应闵，不复乡村闹鼓桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同黄秘校游连江玉泉","author":"林迥","text":"泉山好景微，权尹讼庭希。\n晓马破云去，夜船乘月归。\n妓歌珠不断，人醉玉相依。\n薄宦自拘者，咄哉多是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时山丹","author":"林迥","text":"叶剪青油药渥丹，春风随众出栏干。\n碧桃黄菊凋残后，谁伴长松到岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长春","author":"林迥","text":"洞门深不放春归，客到寻芳莫问时。\n迟日暖风花草丽，照人红艳一枝枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题林子默隐居","author":"林迥","text":"先生平昔命何非，万卷诗书一布衣。\n回首长安成底事，吴山苍翠几时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]