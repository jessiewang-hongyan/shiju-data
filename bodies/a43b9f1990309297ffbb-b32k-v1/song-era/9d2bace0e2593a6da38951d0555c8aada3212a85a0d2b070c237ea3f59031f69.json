[{"title":"凭高怀古","author":"罗必元","text":"凭高怀古思悠悠，遥想骑驴白下游。\n不是龙眠图画里，如今亲到蒋山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周处台","author":"罗必元","text":"周处豪雄亦可人，勇于迁善罕前闻。\n区区未说除蛟虎，一念中间舜蹠分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定林寺","author":"罗必元","text":"罢相归来再读书，定林庵内守清虚。\n少年错解周官处，悔杀当朝是误渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金莲步","author":"罗必元","text":"金陵佳丽不虚传，浦浦荷花水上仙。\n未会与民同乐意，却于宫里看金莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵作","author":"罗必元","text":"六朝遗迹旧山川，万里长江当守边。\n一念易骄人事废，不关飞渡北来船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨花台","author":"罗必元","text":"萧帝倾心向佛家，谩言天女坠天花。\n芦僧一叶横江去，回首梁园日脚斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驻马坡","author":"罗必元","text":"一登伟观眇山河，下有将军驻马坡。\n不是胸中兵十万，长江天险误人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南轩","author":"罗必元","text":"万松盘岭势回环，才抱青溪浸碧山。\n莫道南轩专一壑，古今天下共曾颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦淮","author":"罗必元","text":"秦淮横贯帝王州，万瓦鳞鳞枕碧流。\n系艇莫愁何处去，绿杨深巷有青楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清凉寺竹","author":"罗必元","text":"清凉世界竹如云，旧日君王爱此君。\n时代改迁龙变化，荒山啼鸟不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏心亭","author":"罗必元","text":"胜地分明可赏心，江山满目饱登临。\n洛阳黯淡烟云远，多少英雄泪染襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭","author":"罗必元","text":"五马来时集宴游，江山风景勿关愁。\n合思戮力中原语，对泣何须作楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题半山寺","author":"罗必元","text":"道德文章一世师，只伤学术欠通时。\n不思翻动熙宁祸，却欲重修作福基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"罗必元","text":"振衣快上凤凰游，极目中原泪欲流。\n慨叹兴亡思太白，永言眇邈忆齐丘。\n乌衣已往人千古，白鹭依然月一洲。\n君子坐朝今在治，重恢关洛不须愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梅山云悦楼","author":"罗永之","text":"曾读杨诗识懒云，只今云悦即云孙。\n龙无怒色常归匣，鹤有欢颜独守门。\n春态乐寻吟客伴，心闲喜共野人言。\n要知出岫晴方好，楼外濛濛烟雨昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其五 义塾书灯","author":"罗仲舒","text":"夜深展书读，伊吾声比屋。\n掩映杖头光，穿破西园竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其一 东桥柳色","author":"罗仲舒","text":"河桥数株柳，偏受东风多。\n柔条慎勿折，生意全天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其四 后江钓月","author":"罗仲舒","text":"先将补衮线，绾作钓鳌丝。\n投向苍江月，经纶小试之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其七 芦山樵唱","author":"罗仲舒","text":"秋山草木落，樵夫日相寻。\n幽歌出空谷，金石有馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其三 前野耕云","author":"罗仲舒","text":"春雨鸣布谷，土膏三月足。\n举趾事深耕，竟亩水云绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与张枢密","author":"罗仲舒","text":"孤愤全凭尺素书，一官牢落竟何如。\n兵威似火难言熄，世事犹棋祇报输。\n鱼弃青蒲归浅渚，鸟忘白粒堕枯株。\n杞人纵有忧天志，忍见鸱夷赐子胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题","author":"罗仲舒","text":"世情落落疏，林树森森密。\n乘兴一登临，峭然风景别。\n飞云去不停，狂涧流无歇。\n巢许是何人，万古称豪杰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其八 竹林梵钟","author":"罗仲舒","text":"晨昏礼法供，击鼓齐七众。\n堪笑木兰僧，饭了空声送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其二 西浦潮痕","author":"罗仲舒","text":"潮涨复潮退，盈缩痕常存。\n渡口孤舟横，济川应有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芦江八咏 其六 祠堂议礼","author":"罗仲舒","text":"春秋思报本，忠孝原有祠。\n仪物修孔时，击鼓吹豳诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"批赵氏卷","author":"罗壮","text":"汗牛试卷浩无涯，刬尽雷同别一家。\n冰鉴不容心潦草，风檐宁复眼昏花。\n嘉文似织鲛人组，健笔如轮虎士挝。\n收拾真才报天子，此行端不负皇华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永安寺遇父老","author":"罗巩","text":"复水横山清且长，弦歌亹亹过黉堂。\n相迎父老争冠带，自是泾川礼义乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙峰庵","author":"罗巩","text":"龙山僧舍多，亦自少佳处。\n妙峰正可人，正以深远故。\n我行困炎歊，肩舆特纡路。\n穿林入幽洞，木石尤怪古。\n飒飒清风来，忻然惬胜趣。\n耆阁有老禅，恨未款语晤。\n即对石莲池，一诵碧云句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒苏仙祠","author":"罗汝楫","text":"绛节回白马，青书收赤龙。\n仙人在何计，烟霞锁晴峰。\n荒祠冠其岭，千古凛灵踪。\n粉堵尘网悬，石凹苔钱重。\n我来款遗像，再拜虔且恭。\n檀烟泄云白，茗粥浮新浓。\n世事非所期，真游誓相从。\n云轺几时来，微风韵寒松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"震山岩","author":"罗克开","text":"身倚层岩兴莫穷，若为郁郁在樊笼。\n故人话别伤心里，尊酒论文醉眼中。\n万井叠鳞烟霭暝，一江如练水云同。\n卫公慷慨风流在，却愧新诗力未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗克开","text":"抚摩二字圭三复，公直一心衡不欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗君章","text":"赤岸若朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蹑云亭","author":"罗孝芬","text":"出山不愧草堂灵，乱后看山山更青。\n馀烬岂容遗大厦，蹑云端为护危亭。\n参差春燕依华浦，断续霜猿绕翠屏。\n物色趣君归早晚，已看兰玉照阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗寿可","text":"追思往事真堪恨，误却南兵是蔡州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"讽留梦炎","author":"罗志仁","text":"齧雪苏郎受苦辛，庾公老作北朝臣。\n当年龙首黄扉者，犹是衡门一样人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其十","author":"罗志仁","text":"杨柳苏堤欠补栽，谁能瀛屿种添梅。\n去年我与西湖别，健在明年又会来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其九","author":"罗志仁","text":"丰乐华楼已劫灰，涌金春色未尘埃。\n道人有道轩窗静，那处湖光不好来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其八","author":"罗志仁","text":"曾住西湖画幅间，楚乡久客亦良难。\n先生道眼无分别，浙水江云一样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其七","author":"罗志仁","text":"销尽黄金是此窝，高人攲枕看晴波。\n钱塘门里九曲寺，得似先生一曲多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其六","author":"罗志仁","text":"西子西湖只一般，翠云珠髻恣君看。\n世间尤物移人处，高鼻虬须也被瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其五","author":"罗志仁","text":"绿幕红帘没柁船，船头日日扑花钱。\n笙歌水面盈盈去，过眼笙歌正可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其四","author":"罗志仁","text":"灵隐冷泉图画开，奇峰西竺远飞来。\n天然苍翠都消减，无奈满山金碧堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其三","author":"罗志仁","text":"斜阳葛岭少人行，一片荒山系废兴。\n留得临湖春雨观，东风摇落木香棚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其二","author":"罗志仁","text":"八盘九曲已荒凉，四圣三贤半在亡。\n乍见少年犹眼缬，只缘山色与湖光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其一","author":"罗志仁","text":"歌舞儿嬉度岁年，当时先见忆龙川。\n绝怜遗俗依然在，日日百花金胜船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花慢 禁酿","author":"罗志仁","text":"汉家糜粟诏，将不醉、饱生灵。\n便收拾银瓶，当垆人去，春歇旗亭。\n渊明权停种秫，遍人间，暂学屈原醒。\n天子宜呼李白，妇人却笑刘伶。\n提葫芦更有谁听。\n爱酒已无星。\n想难变春江，蒲桃酿绿，空想芳馨。\n温存鸬鹚鹦鹉，且茶瓯淡对晚山青。\n但结秋风鱼梦，赐酺依旧沈冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风流子 泛湖","author":"罗志仁","text":"歌咽翠眉低。\n湖船客、尊酒谩重携。\n正断续斋钟，高峰南北，飘零野褐，太乙东西。\n凄凉处，翠连松九里，僧马溅障泥。\n葛岭楼台，梦随烟散，吴山宫阙，恨与云齐。\n灵峰飞来久，飞不去，有落日断猿啼。\n无限风荷废港，露柳荒畦。\n岳公英骨，麒麟旧冢，坡仙吟魄，莺燕长堤。\n欲吊梅花无句，素壁慵题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州慢","author":"罗志仁","text":"危榭摧红，断砖埋玉，定王台下园林。\n听樯干燕子，诉别后惊心。\n尽江上、青峰好在，可怜曾是，野烧痕深。\n付潇湘渔笛，吹残今古销沈。\n妙奴不见，纵秦郎、谁更知音。\n正雁妾悲歌，雕奚醉舞，楚户停砧。\n化碧旧愁何处，魂归些、晚日阴阴。\n渺云平铁坝，凄凉天也沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金人捧露盘 丙午钱塘","author":"罗志仁","text":"湿苔青，妖血碧，坏垣红。\n怕精灵、来往相逢。\n荒烟瓦砾，宝钗零乱隐鸾龙。\n吴峰越巘，翠颦锁、苦为谁容。\n浮屠换、昭阳殿，僧磬改、景阳钟。\n兴亡事、泪老金铜。\n骊山废尽，更无宫女说元宗。\n角声起，海涛落，满眼秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮慢","author":"罗志仁","text":"晓莺催起。\n问当年秀色，为谁料理。\n怅别后、屏掩吴山，便楼燕月寒，鬓蝉云委。\n锦字无凭，付银烛、尽烧千纸。\n对寒泓静碧，又把去鸿，往恨都洗。\n桃花自贪结子。\n道东风有意，吹送流水。\n谩记得当日、心嫁卿卿，是日暮天寒，翠袖堪倚。\n扇月乘鸾，尽梦隔、婵娟千里。\n到嗔人、从今不信，画檐鹊喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 净慈尼","author":"罗志仁","text":"君王曾惜如花面。\n往事多恩怨。\n霓裳和泪换袈裟。\n又送鸾舆北去、听琵琶。\n当年未削青螺髻。\n知是归期未。\n天花丈室万缘空。\n结绮临春何处、泪痕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霓裳中序第一 四圣观","author":"罗志仁","text":"来鸿又去燕。\n看罢江潮收画扇。\n湖曲雕阑倚倦。\n正船过西陵，快篙如箭。\n凌波不见。\n但陌花、遗曲凄怨。\n孤山路，晚蒲病柳，淡绿锁深院。\n谁恨。\n五云深处宫殿。\n记旧日、曾游翠辇。\n青红如写便面。\n下鹄池荒，放鹤人远。\n粉墙随岸转。\n漏碧瓦、残阳一线。\n蓬莱梦，人间那信，坐看海涛浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗志仁","text":"冷吸蝉吭露，清摇鹤背霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留蓝溪驿","author":"罗时用","text":"寂寥孤馆白日静，酣睡有魔那得降。\n扣户故人风动竹，龁萁羸马浪翻江。\n飞残蝙蝠灯留壁，啼尽栖鸦日到窗。\n堪笑浪游成住此，一秋赢得鬓丝霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在金陵宦邸别乡友宋碧溪司训","author":"罗杞","text":"十年颜范此睽违，邂逅邮亭亦解颐。\n春满皋皮君彻早，尘蒙章甫我归迟。\n云龙嘉会逢今日，鸡黍真情忆旧时。\n明发愁为江上别，依然回首各天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏家史","author":"罗杞","text":"荫资嘉木当知本，水馀甘泉必究源。\n忆昔东昭分以后，相传瓜瓞世绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵秋晓","author":"罗附凤","text":"发轫功名发未华，转头世事已堪嗟。\n晚栽栗里归田菊，早看长安得意花。\n空忆去鸿留爪迹，祇今旧燕傍谁家。\n重寻陈迹真如梦，疏柳残烟噪暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京中怀归","author":"罗孟郊","text":"一自题名后，思归何日归。\n虽然著宫锦，不及无斑衣。\n故里桑榆晚，他乡雨雪霏。\n庭前停玉轸，目送雁南归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗尚友","text":"人间酒客兼诗客，天上文星与将星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗松野","text":"惊舟出瞿塘，还有平流安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双秀亭","author":"罗知古","text":"亭下波光亭外山，高低融泄照人寒。\n最宜风月虚明夜，不著秋毫眼界宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉笥山邓仙","author":"罗知古","text":"骚人胸次几江山，更著危亭山水间。\n群鹜齐飞残照落，双凫自在白云闲。\n平芜萦绕青罗带，远岫参差绿髻鬟。\n此意何人共幽独，我来终日欲忘还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗知古","text":"层层碧嶂来无尽，衮衮清江远莫追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡季昭二首 其二","author":"罗茂良","text":"频寄书回洗我愁，莫言无雁到南州。\n长相思外加餐饭，计取承君旧话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡季昭二首 其一","author":"罗茂良","text":"好读床头易一编，盈虚消息总天然。\n峥嵘齿颊皆冰雪，肯怕炎方有瘴烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾云巢被召","author":"罗茂良","text":"泰华山人上赤墀，上嗟安在见何迟。\n老于尚父投竿日，少似辕生对策时。\n怨鹤惊猿辞旧隐，鞭鸾笞凤总新知。\n早陈经国平边策，归领云巢旧住持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家","author":"罗南山","text":"逐壮鸡飞过短墙，茅柴烧尽满林霜。\n酿成社酒家家醉，炊得新粳处处香。\n牵犊负犁朝种麦，开渠引水晚浇桑。\n老农不管催租急，未夜烘衣先上床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建茶 其二","author":"罗拯","text":"草木英华聚，楼台紫翠重。\n山形仙苑凤，泉脉御池龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建茶 其一","author":"罗拯","text":"自昔称吴蜀，芳鲜尚未真。\n于今盛闽粤，冠绝始无伦。\n地占群山秀，时先百卉春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙岩寺","author":"罗点","text":"直上龙岩第一层，参回斗转夜纵横。\n试将拄杖敲岩石，唤觉蟠龙速起行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"褒禅山有于湖所题宝塔二字","author":"罗点","text":"古刹浮屠映碧山，状元题墨最为娴。\n游人倦憩尘心寂，云自青天水自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]