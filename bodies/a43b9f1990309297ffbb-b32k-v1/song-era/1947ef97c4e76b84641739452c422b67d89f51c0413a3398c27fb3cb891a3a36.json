[{"title":"金丹诗诀 其四十二","author":"陈楠","text":"莫谓金丹事等闲，切须勤苦力钻研。\n殷勤好问师资学，不在他边在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其四十三","author":"陈楠","text":"夫鍊还丹先养铅，龟蛇一气产先天。\n虚心实腹方和合，结就灵砂一粒圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其四十四","author":"陈楠","text":"同行同坐又同眠，终日相随在目前。\n认得这些须急采，见之便是水乡铅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其四十五","author":"陈楠","text":"不是灯光日月星，灵药自有异常明。\n垂帘久视光明处，一颗堂堂现本真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其四十六","author":"陈楠","text":"终日如愚岂有无，谩将闲里著工夫。\n初时玉液飞空雪，渐见流金满故庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其四十七","author":"陈楠","text":"灵汞通真变化多，只宜存守不宜过。\n神符默运三关彻，铅趁黄河入大罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其四十八","author":"陈楠","text":"甲龙庚虎镇相随，铅汞同炉始可为。\n曾取地天交泰事，自然交媾坎和离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其四十九","author":"陈楠","text":"周天火候至幽显，运动抽添尽有时。\n气候何须分八节，只防片饷失毫釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十","author":"陈楠","text":"五行四象坎并离，诗诀分明说与伊。\n只有工夫下手处，几人会得几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十一","author":"陈楠","text":"若未逢师且看诗，诗中藏诀好修持。\n虽然不到蓬莱路，也得人间死较迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十二","author":"陈楠","text":"昼运灵旗夜火芝，抽添运用且防危。\n若无同志相亲赏，时照炉中火候非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十三","author":"陈楠","text":"震卦行归西兑乡，三阳姹女弄明珰。\n巽风吹动珊瑚树，入艮归坤又一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十四","author":"陈楠","text":"握拳闭目守流珠，这个元来是入途。\n不见悟真篇内说，真金起屋几时枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十五","author":"陈楠","text":"谁知前短后长机，十二时中只一时。\n晦朔望弦明进退，鍊成九转结婴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十六","author":"陈楠","text":"昆崙山上火星飞，金木相逢坎电时。\n药到月圆须满秤，急教进火莫蹉迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十七","author":"陈楠","text":"大药须凭神气精，采来一处结交成。\n丹头只是先天气，鍊作黄芽发玉英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十八","author":"陈楠","text":"分明只在片言间，老去殊途有易难。\n先自刀圭言下悟，渐收九转大还丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其五十九","author":"陈楠","text":"两处擒来共一炉，一泓真水结真酥。\n刀圭滋味吞归腹，浇灌黄芽产玉符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十","author":"陈楠","text":"捉将百脉倒归源，自会天然汞见铅。\n大地山河皆至宝，谁知身里觅先天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十一","author":"陈楠","text":"宫中眼底火星飞，雷电掀翻白雪垂。\n身里漏声闻滴滴，三尸精血可充饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十二","author":"陈楠","text":"五行四象外边寻，只在当人一寸心。\n运用阴阳成妙道，直教瓦砾尽成金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十三","author":"陈楠","text":"偃月炉中煅坎离，片时自有一刀圭。\n寄言师祖张平叔，万圣千贤总在西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十四","author":"陈楠","text":"醉倒酣眠梦熟时，满船载宝过曹溪。\n一才识破丹基处，放去收来绝在伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十五","author":"陈楠","text":"西南路上月华明，大药还从此处生。\n记得古人诗一句，曲江之上鹊桥横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十六","author":"陈楠","text":"一月三旬一日同，修丹法象夺天功。\n交加二八为丹母，望远徒劳觅虎龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十七","author":"陈楠","text":"尾闾白气贯丹田，一颗真珠软似绵。\n满地冷光生玉笋，两池秋水漾红莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十八","author":"陈楠","text":"鼎炉火候密推排，鍊得纯阳气上来。\n地户闭时骨体实，天门积渐自然开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其六十九","author":"陈楠","text":"水为灵符冲和液，火是丹枢混沌精。\n会在宫中凝结处，自然结蕊复生英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十","author":"陈楠","text":"男儿怀孕是胎仙，只为蟾光夜夜圆。\n夺得天机真造化，身中自有玉清天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十一","author":"陈楠","text":"鼎中朱橘亘天红，此是时时养火功。\n元气归炉神不散，春山春水自春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十二","author":"陈楠","text":"金鼎先乾活水银，水银乾了大丹成。\n分明有个长生草，点铁成金不误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十三","author":"陈楠","text":"涕唾精津气血液，真伪混淆须辨惑。\n从无生有是药材，不可滞他虚幻物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十四","author":"陈楠","text":"经文变化在须臾，迷者何求日月疏。\n但守火爻三百刻，产成一颗夜明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十五","author":"陈楠","text":"天源一派接昆崙，最隐无过九曲湾。\n百万玉龙嘶未断，一江春月趁渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十六","author":"陈楠","text":"精神冥合气归时，骨肉融和都不知。\n关节自开通畅也，形容光泽似婴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十七","author":"陈楠","text":"分两须当应两弦，此般法象合天渊。\n回头问取黄婆看，何必区区待口传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十八","author":"陈楠","text":"铅汞之宗龙虎根，玄牝之户戊已门。\n只向玉壶春色里，摘枝花去问羲轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其七十九","author":"陈楠","text":"近则三朝远九旬，须知变化有时辰。\n不知造化长生药，点汞成金也动人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十","author":"陈楠","text":"鼎鼎元无药裹寻，寻来出去一般金。\n铸成大小多随意，便是冰壶妙理深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十一","author":"陈楠","text":"入鼎须凭重一斤，秤来却是十六星。\n一星水里真金妙，合作流珠二八停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十二","author":"陈楠","text":"坎府坳塘石脚泉，星斗相对射高天。\n潺湲阳脉通青白，沐浴要教金体坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十三","author":"陈楠","text":"尽道真人总默然，如何也不示言诠。\n若不骄傲事无语，只是胸中欠汞铅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十四","author":"陈楠","text":"天地初分日月高，状如鸡子复如桃。\n阴阳真气知时节，直待三年脱战袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十五","author":"陈楠","text":"龙虎丹砂义最幽，五神金内汞铅流。\n千朝变紫飞云去，直至大罗天上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十六","author":"陈楠","text":"用铅须得汞相和，二姓为亲女唱歌。\n鍊到紫河车地动，白云相伴鹤来过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十七","author":"陈楠","text":"红黑相将妇嫁夫，一年一度入丹枢。\n洞房深处真云雨，产个婴儿一似渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十八","author":"陈楠","text":"坎男离女往乾天，买药烧丹不用钱。\n偃月炉中烹造化，一些妙药要真铅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其八十九","author":"陈楠","text":"怪事教人笑几回，男儿今也会怀胎。\n自家精血自交结，身里夫妻是妙哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十","author":"陈楠","text":"三姓名含二物交，赤龙飞上碧云霄。\n夜来甘露空中过，片月横空对鹊桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十一","author":"陈楠","text":"复姤修持水火宗，兔鸡沐浴内丹红。\n周天六六寒炉后，十月胎圆显圣功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十二","author":"陈楠","text":"水火同精间木金，火木知他甚处寻。\n脱黄著紫因何事，只为河车数转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十三","author":"陈楠","text":"玉符金液鍊天仙，月照昆崙一沼莲。\n试指北方玄武事，龟蛇因甚两相缠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十四","author":"陈楠","text":"雨洗新篁双凤飞，玉芝花下一灵龟。\n抱琴弹尽舞仙曲，却放姮娥宴小池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十五","author":"陈楠","text":"透体金光骨髓香，金筋玉骨尽纯阳。\n鍊教赤血流为白，阴气消磨身自康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十六","author":"陈楠","text":"一旦工夫尽志诚，凝神聚气固真精。\n颜容如玉无饥渴，方显金丹片饷成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十七","author":"陈楠","text":"翠娥独立水晶宫，体态娇娆有意浓。\n半夜黄婆来叩户，作媒嫁去与金翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十八","author":"陈楠","text":"太乙玄珠金液丹，还元返本驻童颜。\n更须亲听明师语，方可教君见一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其九十九","author":"陈楠","text":"夜来一朵碧芙渠，内有红丸滴滴珠。\n滴下华池是神水，丹田结聚作丹枢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丹诗诀 其一○○","author":"陈楠","text":"离坎名为水火精，本是乾坤二卦成。\n但取坎精点离穴，纯乾便可摄飞琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盘栊颂","author":"陈楠","text":"终日盘盘圆又圆，中间一位土为尊。\n磨来磨去知多少，个里全无斧凿痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"箍桶颂","author":"陈楠","text":"有漏教无漏，如何水泄通。\n既能圆密了，内外一真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尸解颂","author":"陈楠","text":"顶上雷声霹雳，混沌落地无踪。\n今朝得路便行，骑个无角火龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵龟洞","author":"郭允升","text":"谁将快剑斫苍石，涌出玉虹三百尺。\n漭流直注古潭心，卷雾喷空潭影澄。\n大声隐隐非雷霆，一洗万古山无青。\n崖崩谷断供奇秀，至今犹有龟蛇灵。\n我疑神龙宅幽邃，颔有骊珠贪熟睡。\n为君鞭起跨玉京，坐致商霖藓旱气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简州","author":"程敦临","text":"郡城好处西州无，两江回合东南隅。\n江平浪稳去自在，净色浸透银蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题温州江心寺","author":"程嘉量","text":"东西两寺绝尘嚣，斋饭全凭早晚潮。\n解事江流更分断，为君题作小金焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩七咏 其一 定惠像","author":"张雍","text":"昔闻海岸落伽山，今日灵岩得谛观。\n莫问前身后身事，会须明眼一盘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩七咏 其二 證明龛","author":"张雍","text":"不倦千寻谒證明，凭栏下瞰白云生。\n更期进步孤峰顶，要向如来头上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩七咏 其三 双鹤泉","author":"张雍","text":"双鹤飞来知几年，至今山腹有泓泉。\n直应为办高僧供，挹取无穷金湛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩七咏 其四 灵龟泉","author":"张雍","text":"山作灵龟势愿游，滴泉奔涌岂常流。\n谁当一的能知味，认取心源莫躁求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩七咏 其五 明空窍","author":"张雍","text":"横看空洞贯山南，人说当年卧佛岩。\n渠识老婆心太切，直将一点示愚凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩七咏 其六 铁袈裟","author":"张雍","text":"浅蹊针孔费掺掺，铁作袈裟信不凡。\n大庾岭头提不起，岂知千古付灵岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩七咏 其七 三十二罗汉","author":"张雍","text":"此山罗汉极□常，当日威容俨在堂。\n谁信盗中诚有道，智过君子实难量。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铁袈裟 其一","author":"李懋远","text":"宦游飘忽十年间，持节重来见旧山。\n惟有潺湲庭下水，无心犹伴白云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铁袈裟 其二","author":"李懋远","text":"路转山腰十里阴，参差楼殿倚云平。\n青蛇白鹤今何在，泉石空留四绝名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠吕居仁","author":"曾续","text":"吕家三相盛天朝，流泽于今有凤毛。\n世业中微谁料理，却收才具入风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登證明观","author":"释子千","text":"欲知相续振宗风，常似泉源昼夜通。\n若使为霖布寰宇，每随云雾下高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登證明观","author":"释子明","text":"欲凭双虎说家风，透顶清泉到处通。\n已觉心源无望碍，何须更上證明峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张敏叔祠部压云轩韵","author":"释冲邈","text":"础润藏云族，檐虚压树梢。\n经常逢夜讲，斋不过中庖。\n有井龙庆蛰，无泥燕不巢。\n登临增野兴，四顾尽寒郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]