[{"title":"游齐山寺寻陈鸿断碑","author":"孙迈","text":"万木参天绕寺篱，一声孤磬彻江湄。\n楼边已失陈鸿记，亭上犹存杜牧诗。\n细雨乍经岩溜响，嫩苔长积石桥危。\n知予好古心常切，僧与前山觅断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"孙迈","text":"浔阳风景接洪都，传说胡君四世居。\n诗句满朝皆诵咏，君王旌孝表门闾。\n数闻过客谈多惠，几欲凭僧去借书。\n若把公卿名刻石，共瞻驷马慕相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿筠轩","author":"孙邦","text":"年来宦拙喜跻攀，门枕溪流四面山。\n时过邻僧话浮世，一轩长对此君闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白莲堂 其一","author":"孙邦","text":"大智西归不肯回，只今莲社喜重开。\n会中独有遗民在，十五年间两度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕城谒祖庙","author":"孙邦","text":"吾祖持兵镇此都，投身九死定全吴。\n一朝流矢中眸子，千载忠魂列霸图。\n墓木但遗枫合抱，庙庭还有像完躯。\n英雄未必输张许，青史功名定有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐氏林亭","author":"孙邦","text":"华屋沈沈野外居，茂林清荫绕门闾。\n移花植果心无事，抱子弄孙欢有馀。\n闲过西畴观刈穫，懒寻南郭命巾车。\n问君为圃嗟予晚，便拟归休学二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和史经 其一","author":"孙邦","text":"渊明遇佳趣，欲辩每忘言。\n道安对胜士，高论矜弥天。\n斯人已往不可得，悠悠俗驾徒争先。\n梦尸梦秽了不悟，宁论掷足与裸颠。\n虽知香臭在得丧，一朝十获岁九迁。\n谁能休沐过僧语，聊问我林仍我泉。\n贤哉令尹得此趣，颇厌世味如荤膻。\n学人荐取妙香句，莫学大珠空饭眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠行医龙杖道人","author":"孙伯容","text":"忽报求诗有客来，诗魔正此费驱催。\n内丹却喜君能炼，青眼何妨我为开。\n袖里蛇应传似续，手中龙漫事剸裁。\n传玄神物经当合，道合仙陂试验哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游麻姑山瀑布泉","author":"孙伯温","text":"九关守不严，失却两玉龙。\n尘世著不得，忽来此山中。\n雷霆白昼间，冰雪诗人胸。\n天公不汝尤，为人作年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元雨","author":"孙何","text":"淡月微云外，街泥小雨馀。\n人如墟市散，灯似晓星疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"孙何","text":"张乐鱼龙侵岸听，赋诗贾客倚船看。\n他年得第彤庭直，拜疏终求鄂渚官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送弟侑","author":"孙何","text":"武昌古名地，英秀森琳琅。\n既号诗书窟，复称云水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正旦病中","author":"孙何","text":"千官簪笏俨成行，春逐銮舆出建章。\n丹凤案明分曙色，绛纱袍暖起天香。\n旌旗影里陈方物，金石声中举寿觞。\n可惜龙墀立班处，刘生独自卧清漳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴江","author":"孙何","text":"晚滩如雪起沙鸥，咫尺姑苏亦胜游。\n逸势泻归沧海远，冷声分作太湖秋。\n葑田几处连僧寺，橘岸谁家对驿楼。\n鲁望不存无可语，片帆中夜渡清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏","author":"孙何","text":"殷红鄙桃艳，淡白笑梨花。\n落处飘微霰，繁时叠碎霞。\n苑宜开帝里，坛称在儒家。\n丽日明珠箔，清香袭绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗三首 其一","author":"孙何","text":"贝阙琳宫紫雾深，凤凰仙乐尚愔愔。\n鼎湖往事三千载，石笋青春一万寻。\n挺立不教凡草长，削成应免俗尘侵。\n霓旌绛节知何处，空有莲花送好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐柏观","author":"孙何","text":"玉坛三级接秋空，此是仙家第几重。\n羽客有时来驾鹤，王人无岁不投龙。\n微吟海月生岩桂，长啸天风起涧松。\n司马先生何处去，篆碑犹有白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧","author":"孙何","text":"去路馀千里，行行雪洒衣。\n诸峰何日别，一锡犯寒归。\n夜宿谁闻磬，晨斋自采薇。\n遥知到禅宇，猿鸟共开扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题石桥","author":"孙何","text":"六月岩崖似九秋，兴公辞赋好淹留。\n杉松迤逦连华顶，钟磬依稀近沃洲。\n枕水古碑卿相撰，拂云新刹帝王修。\n高僧尽解飞金锡，谁是当年白道猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏华林书院","author":"孙何","text":"六阙旌门事若何，诸生常不绝弦歌。\n鲤庭共禀诗书训，隐巷齐登俊造科。\n宗族有光传孝弟，乡闾无讼化淳和。\n芝兰子弟相薰习，金石交朋互切磋。\n遥望楚江波迥急，却分庐阜影偏多。\n题名石鼓围松桂，讲易高堂绕芰荷。\n采药路从洪井出，买书船自孺亭过。\n我惭已在瀛洲直，不得西山隐薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗三首 其三","author":"孙何","text":"黄帝升天去不还，空留片石在人间。\n千寻杳杳撑红日，倚云乔木羽林閒。\n时人不信飞升路，辙迹龙髯竟可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗三首 其二","author":"孙何","text":"薜荔无因挂一毫，化工镌削亦应劳。\n圭形直指明河落，桂影遥分涨海涛。\n发地五千何足贵，去天三百未为高。\n轩辕辙迹今犹在，斗上丹枕著羽袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"孙何","text":"飞泉落翠巘，爽籁生寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"孙何","text":"谁如张璪工松石，拟裂鲛绡画作图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"孙何","text":"美人与月正同色，客子折梅空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"孙何","text":"欲谒元戎无介绍，薛能诗版在雕堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁来红","author":"孙吴会","text":"眩碧成朱被眼瞒，分明是叶作花看。\n道人本不知香色，只与窗前草一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 题甘露寺多景楼","author":"孙吴会","text":"八窗空、展宽秋影，长江流入尊俎。\n天围绀碧低群岫，斜日去鸿堪数。\n沈别浦。\n但目断、烟芜莽苍连平楚。\n晨钟暮鼓。\n算触景多愁，关人底事，倚槛听鸣橹。\n英雄恨，赢得名存北府。\n寄奴今寄何所。\n西风依旧潮来去，山海颉颃吞吐。\n霜月古。\n直耐冷、相随燕我瑶芝圃。\n掀髯起舞。\n看羱伏苍苔，龙吟翠葆，天籁奏韶舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"孙吴会","text":"游人只解游晴昼，风雨朝昏尽属君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双桂桥","author":"孙应凤","text":"桥前巧匠剪春罗，桥上亭亭景物和。\n明夜元宵一团玉，连波还解似金波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝藏寺洪钟","author":"孙应凤","text":"枕畔鍧然宝藏钟，声从何处入高墉。\n蜀颅衰臂今如许，唤起穹庐一卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奖溪桥","author":"孙应凤","text":"夕照斜阳柳外鸦，杏园衰谢野人家。\n欲寻春色无寻处，尽在桥边野草花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠政桥","author":"孙应凤","text":"百仞崖边有此桥，地平路稳玉骢骄。\n惠而知政今如此，拈起桥名问国侨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西塔","author":"孙应凤","text":"忆昨慈恩登绝顶，今朝眼界更分明。\n飞檐高泻银河水，隔岸遥传宝铎声。\n翥凤呈辉看欲下，浔龙露角望尤勍。\n凌风好向蓬莱去，一片香云绕足生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎岩纪游","author":"孙应凤","text":"月出山越高，云行月益忙。\n树影遍空白，疏星避月光。\n总非往者见，不从意内量。\n聪明此一进，境界因久忘。\n深坐庭露淹，山僧促回廊。\n鼓钟奏天乐，经行重山堂。\n暮楫动朝梵，初日升屋梁。\n佛心光见日，林晖洞八方。\n细雨霏日中，飞烟青逐黄。\n出门绕山径，两道夹修篁。\n茗根千百个，却于山隈藏。\n径深见奇巘，云与戴云望。\n因之曳竹杖，集伴凌高冈。\n他年记此际，风花带天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入福昌寺","author":"孙应时","text":"风日萧萧林翠开，支筇古寺独徘徊。\n山中不怪无人识，十五年前一度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"孙应时","text":"中年意与山林会，胜日身兼杖屦轻。\n正有百钱堪独往，不将一赏负秋晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山庵即事","author":"孙应时","text":"田田荷叶作老色，楚楚菊丛生细香。\n落日空山归鸟尽，扶筇独自到池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书西溪僧壁 其二","author":"孙应时","text":"碧天如水水明霞，雁字横风一一斜。\n袖手行吟不知晚，满川霜月浸芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书西溪僧壁 其一","author":"孙应时","text":"问讯前贤沧海边，遥堤烟草故依然。\n谁言筦库功名薄，已活淮民二百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书西溪僧壁 其三","author":"孙应时","text":"悠悠身世客心惊，十宿西溪梦未曾。\n笑把新诗留日月，碧纱黄垩听山僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巴东秋风亭怀寇公 其二","author":"孙应时","text":"袖手穷山一少年，何曾有楚到澶渊。\n英雄正自无人识，盖世功名却偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巴东秋风亭怀寇公 其一","author":"孙应时","text":"秋风亭上思悠哉，想见鸣琴日日来。\n野水孤舟故如昨，为公长啸一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石灶","author":"孙应时","text":"石灶沧潭上，烹茶定几回。\n舟人因记得，俗客未经来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其一","author":"孙应时","text":"文章富贵自两事，脱欲其全天定悭。\n平生萧瑟也不恶，未妨诗赋动江关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其五","author":"孙应时","text":"衮衮诸公鸳鹭群，年来看熟已忘情。\n四明相寻风雨过，一丘一壑便悭盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其三","author":"孙应时","text":"君诗音节中弦歌，报我英瑶百倍过。\n江村老人衣钵在，同参今更有人么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其四","author":"孙应时","text":"欲望中原双目断，听谈往事几心酸。\n百年故家好人物，尘沙流落太无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次日湖上","author":"孙应时","text":"山南山北水平湖，屏障天开画不如。\n好在风流王谢宅，扁舟来往未应疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次仲氏韵 其三","author":"孙应时","text":"故人惊我鬓丝多，一叹相逢可若何。\n勋业向来无此梦，菱花何必遣重磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次仲氏韵 其二","author":"孙应时","text":"枵腹贪书颇自强，年来得失正相当。\n须知耳目尘埃尽，始见山林日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次仲氏韵 其一","author":"孙应时","text":"曲生真得圣之清，风味超然一座倾。\n肯向春寒慰牢落，令人心事转和平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江北梅开殊晚和林实之别驾韵 其四","author":"孙应时","text":"清诗吟赏慰花神，唤起风情寂寞滨。\n正是参军旧题处，须公还作一家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江北梅开殊晚和林实之别驾韵 其二","author":"孙应时","text":"楚江横月一枝明，想见江南半落英。\n等是春风有先后，不妨调鼎看功成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江北梅开殊晚和林实之别驾韵 其一","author":"孙应时","text":"水边篱落影疏疏，一见风姿意豁如。\n驿使莫嫌时节晚，少留春半作春初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江北梅开殊晚和林实之别驾韵 其五","author":"孙应时","text":"一笑无言桃李场，从教遥夜斗寒香。\n红梅何意败家法，便欲从时作闹妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江北梅开殊晚和林实之别驾韵 其六","author":"孙应时","text":"许氏南园十里间，嗟跎胜赏怯春寒。\n寄声行客如回首，莫把寻常醉眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江北梅开殊晚和林实之别驾韵 其三","author":"孙应时","text":"地远天寒饱雪霜，深林依旧十分香。\n玉堂茅舍公休问，一种风流压众芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池口阻风雨 其二","author":"孙应时","text":"一江风雨送春归，漠漠汀洲白鹭飞。\n舟子相呼更添缆，水来新没钓船矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池口阻风雨 其一","author":"孙应时","text":"江头三日系扁舟，秋浦齐山欠一游。\n已自无人念羁客，更禁风雨作春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西溪僧舍昼卧","author":"孙应时","text":"燕子风微春昼长，独携书卷卧禅房。\n悠然一笑无人领，只有蔷薇满院香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别越中诸生 其二","author":"孙应时","text":"切磋长恨我空疏，甚喜同门各起予。\n赠别懒为名利语，洗心深读圣贤书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别越中诸生 其一","author":"孙应时","text":"三年一榻占清閒，门外苍然是种山。\n步月迎风行乐地，从今应入梦魂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其二","author":"孙应时","text":"江梅玉立故清妍，心友猗兰弟水仙。\n终日相看静无语，一时风味也堪怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李季章校书西湖即事三首 其三","author":"孙应时","text":"匆匆清明了，能馀几许春。\n花开更风雨，肠断惜春人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李季章校书西湖即事三首 其二","author":"孙应时","text":"舴艋填芳渚，鞦韆闹粉墙。\n人争桃李节，吾忆藕花凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李季章校书西湖即事三首 其一","author":"孙应时","text":"风日都门外，楼台十万家。\n西湖春事足，不话洛阳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈及之 其二","author":"孙应时","text":"诗无彫刻未为癖，战胜纷华聊自肥。\n万里归期劳梦想，百年世事几从违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈及之 其一","author":"孙应时","text":"不妨客子归路滑，且喜雨来天破悭。\n剑南剑北好颜色，吾徒心事略相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈及之 其三","author":"孙应时","text":"蟠龙山头行且歌，嘉陵江上重相过。\n人生知音不易得，举似诸人委悉么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑信卿 其三 惜春","author":"孙应时","text":"舞絮飞花别茂林，狂蜂乱蝶度繁阴。\n乾坤不尽春长在，莫遣伤春意太深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑信卿 其一 牡丹","author":"孙应时","text":"天与风情压众芳，雕栏翠幄奉君王。\n猗兰自欠倾城色，空作深林一味香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑信卿 其二 春怀","author":"孙应时","text":"绮罗丝竹沸名园，想见春风玉树前。\n况是天公饶一月，何妨行乐倍他年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和真长木犀 其二","author":"孙应时","text":"香传万里到蚕丛，依旧江南林下风。\n忆著小山招隐句，不堪流落更相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]