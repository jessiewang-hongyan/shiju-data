[{"title":"西湖雨中同公懿诸君饮","author":"韩维","text":"十月平湖上，繁霜藻荇空。\n柳枝横堕雨，波白细生风。\n水鸟飞幽碧，寒花折浅红。\n谁能尽一醉，灯火宿船篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西墅","author":"韩维","text":"城居不为惬，言适西陂冈。\n雀噪野堂静，鸡鸣春日长。\n书棚落幽蠹，佛幔掩馀香。\n释子庐岩至，清谈殊未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观安公亭戏呈观文主人","author":"韩维","text":"十五年来此地行，白头重到不胜情。\n寒梅未放黄金蕊，冰绽初流碧玉声。\n憔悴霜松如有诉，纷披风竹似相迎。\n红裙散后歌音绝，海鹤阶前时一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音精舍期邻几未至","author":"韩维","text":"懒驱羸马傍朱门，来对祇园寂寞春。\n撩乱绕楼唯有燕，萧条垂箔更无人。\n未回山简池头马，空愧陶公顶上巾。\n留得清风满衣袖，为君吹尽鬓边尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许昌道中","author":"韩维","text":"荒郊不可望，极目尽伤心。\n日薄不开冻，风凄还作阴。\n倦鸦飞趁马，寒犬吠依林。\n赖有瓢中酒，愁来一独斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过卞氏园亭","author":"韩维","text":"桃李郊扉静，东风拂面柔。\n偶陪连骑客，来作探春游。\n斜日池边树，轻云城上楼。\n不须花艳动，一醉且淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过杜甫坟","author":"韩维","text":"三尺孤坟墓，空留万古名。\n风骚谁是主，天地太无情。\n入夜月虚白，逢春草自生。\n耒阳江色迥，吊罢恨难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过邵先生居","author":"韩维","text":"竹坞斜开径，茅檐半卷书。\n幽闲入高卧，淡薄见平居。\n乱水随酾引，残花不扫除。\n因君动高兴，回首想吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何龙图赴上秘阁同诸君赋诗","author":"韩维","text":"华阁岧峣冠道山，群公清晓集初筵。\n独持金印承新命，重对牙签识旧编。\n英俊雍容欣接袂，文章疏阔愧怀铅。\n一时高会形风什，留作儒林故事传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"况之席上作","author":"韩维","text":"桐叶翻飞荷芰香，好风吹暑作清凉。\n便惊帘幕生秋气，径促金丝尽羽觞。\n浮世已谙身是幻，高歌莫笑老仍狂。\n知君不久还符竹，烂醉犹须教十场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈诸先辈","author":"韩维","text":"谢事归来老白头，杜门终日绝营求。\n顾惭义礼非先得，窃幸英豪许并游。\n介寿又逢春酒熟，贻诗常骇暗珠投。\n自惭筋力难为礼，不及低回奉献酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运判再以前韵见寄","author":"韩维","text":"突兀朱堂冠北城，云峰满目互阴晴。\n凭栏不负思山意，对酒何烦考鼓声。\n清话从容双麈秃，雕章温丽百金轻。\n归轩未必能相迟，梦绕西湖春水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"连日休务过邻几","author":"韩维","text":"广文自古无羁束，况复三逢著令休。\n纵酒不防官长骂，驱车聊过故人游。\n闲中日月随方罫，远外风云入小舟。\n准拟墙根菊花好，共乘清露赏高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮方君舍晚归","author":"韩维","text":"惨淡秋原思，归鞍暮向城。\n野风吹酒散，寒日上衣明。\n踯躅樵儿聚，喧呼猎骑轻。\n村醪处处熟，准拟数来行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和十侄喜象之来饮兼简龙阳孔先生","author":"韩维","text":"世事茫然剧转蓬，一樽何意与君同。\n从容谈笑皆尘外，恍忽游从似里中。\n还有桂华来静夜，稍惊梧叶下秋风。\n欲论归去令人愧，高卧襄阳有德公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三兄晚饮","author":"韩维","text":"乍去炎氛浊暑中，高怀幽事不如穷。\n乍怜老竹梢云碧，已见新梨著露红。\n回雪舞腰来洛浦，仰天歌韵有秦风。\n雄图壮节消磨尽，所得清樽一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三兄游湖","author":"韩维","text":"竹阴回抱柳阴敷，石色青青润不枯。\n暂到已经风力劲，更清须待月轮孤。\n波涵天影迷高下，云覆山光变有无。\n暑退疾清人意健，纵吟狂醉是良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三哥立春即事","author":"韩维","text":"青帝收寒岁令回，綵幡今胜下天来。\n人声恺乐归歌缶，风气恬和拂寿杯。\n发逐时光明似雪，心谙世味冷于灰。\n西堂梅蕊今年晚，应待安舆到始开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和之美春日对酒","author":"韩维","text":"高轩怒马一憧憧，夫子端居寂寞中。\n绿酒细斟消暇日，朱弦缓拨对春风。\n官闲势利无从入，道胜纷华岂易攻。\n即此便堪遗万虑，可怜夸者自穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华见寄","author":"韩维","text":"松柏无心自后凋，此心无物更寥寥。\n伯夷岂是归周晚，孟子空嗟出昼遥。\n谈道每嗤犹有待，当官常欲取非招。\n荒园寂寞无谁语，兰菊幽香没艾萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华兄太素泛舟香菜门","author":"韩维","text":"霜髯照四坐，宛是商颜来。\n舟移一水远，楼对群峰开。\n谈笑尽永日，声利轻浮埃。\n既同剡溪往，亦类稽山回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华兄方惜莺声之晚今忽闻之","author":"韩维","text":"山鸟凡禽处处鸣，独怜清啭久无声。\n起从岩谷春风晚，飞过林塘霁日明。\n不为好音轻俗耳，自逢真赏动诗情。\n少年乐事今抛尽，节物催人只自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华兄同永叔饮三班官舍兼约明日饮永叔家","author":"韩维","text":"视草名臣润色才，玉墀晨退共徘徊。\n朝廷无事文书省，台阁相欢笑语开。\n少厌赓酬停落笔，旋寻歌舞约衔杯。\n广文主簿官閒冷，不是诗情岂合来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华兄闻布谷声而莺声寂然","author":"韩维","text":"杨花飞尽叶成阴，坐阅啼禽百种声。\n戴胜催耕当是月，杜鹃遗恨岂今生。\n及时燕乐风骚急，感物伤嗟老大情。\n自笑拙艰成底事，十年不听上林莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华兄喜雨","author":"韩维","text":"膏润涵濡万物中，欣然生意满和风。\n■飘先动吟毫紫，急洒疑催舞袂红。\n病手便甘千日醉，疲农又得一年丰。\n欢声定有歌尧壤，喜气遥瞻绕汉宫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华同程中散燕湖上","author":"韩维","text":"林塘潇洒夏阴初，翠窦红芳助燕娱。\n不用俗音流乐府，自期仙御下蓬壶。\n金跳巨鲤开纹浪，雪洒群鸦度绿梧。\n日落人归尤胜绝，篮舆回首尽城隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华安国明空颂","author":"韩维","text":"欲识真空理，须明动用间。\n色心全不碍，生死岂相关。\n卷箔凉风动，焚香昼景閒。\n回头大行路，满目是青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华湖上书事","author":"韩维","text":"清霜彫远木，潩水溢西陂。\n画鹢凌空界，鸣鸥矫翠漪。\n菊残犹可折，竹密不容窥。\n物我同真际，谁当惮四知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华湖上避暑","author":"韩维","text":"堤边杨柳无穷碧，亭下芙蓉四面红。\n岛影低回明镜里，荷香浮动绿樽中。\n清心不厌飞山雨，动发时欣过水风。\n鼎足坐谈非俗侣，不归名教即真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子履再游李氏园","author":"韩维","text":"翠竹苍林颜色老，游人安得故时同。\n沾衣似对金城柳，握管翻悲楚水枫。\n新鬓旋惊吟后白，好花犹记折来红。\n须知世事徒劳耳，惟有清樽不负公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和六弟苦雨","author":"韩维","text":"雷激霆奔夜复晨，天街流潦没车轮。\n清风皎日收无迹，妖蜧顽蛟亦有神。\n荐至已惊占习坎，汨陈深恐败彝伦。\n苍生可念非吾力，漏屋颓垣不庇身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太素大雪苦寒","author":"韩维","text":"晨兴出户望，一色四方齐。\n旋委清池失，偏欺翠竹低。\n杯深怜绝景，毫健得新题。\n丽藻思风絮，衰颜怯冻梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王都尉","author":"韩维","text":"乘槎天上客，脱帽酒中仙。\n谈笑非俗韵，欢欣忘我年。\n浩歌轻白雪，密意得青莲。\n诗就西楼月，留为好事传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和乐道","author":"韩维","text":"红旆重来镇故乡，吏民欢喜拂牙床。\n忽颁优渥垂天诏，仍许衰残守郡章。\n自笑木鸡犹独立，人嗟竹马漫相将。\n君皇念旧恩非浅，南北圭符各一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣俞天津桥闻歌","author":"韩维","text":"飞雪朝来霁，朱楼月下过。\n绝云看丽构，裂玉堕清歌。\n醉烛轻摇箔，游鞍不动珂。\n回头少年乐，惨淡一悲哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔从驾谒景灵宫","author":"韩维","text":"驰道尘清生紫烟，帝临原庙拜衣冠。\n日华先向金舆动，霜气犹通玉仗寒。\n后骑绵裘明粲粲，侍臣瑶佩响珊珊。\n一闻佳句歌熙盛，不减都人夹路观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔内直晨出马上口占","author":"韩维","text":"天门朝日照崔嵬，车骑雍容下禁台。\n清景每将诗思遣，高情不为宠名回。\n山林岂要须长往，轩冕当知是傥来。\n欲与明公论出处，会乘飞雪旁金罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔思滁州幽谷","author":"韩维","text":"滁阳山水翳荒榛，公为开治物物新。\n自作嘉名遍华榜，连题秀句入青岷。\n泉声尚记岩寒夜，花思偏怜谷暖春。\n绝境坐驰高兴动，安能碌碌久风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔病中寄诸君子","author":"韩维","text":"几日东风独掩门，忽传佳咏感芳辰。\n应缘高位须忧国，未必多情便负春。\n过眼只看花艳疾，惊心初见草芽新。\n狂吟烂醉无拘束，始信光阴属散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔雪","author":"韩维","text":"浴凤池边雪舞风，题诗高揖杜陵翁。\n怀人共惜车音断，对酒须论盏底空。\n授简久虚梁苑候，引舟谁过剡溪中。\n今朝白雪闻君咏，千载风流未觉穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和玉汝弟甘雨应祈","author":"韩维","text":"后稷明农佐有妫，耻令世有一夫饥。\n勤民事业能如古，闵雨精诚必应时。\n顿觉微凉生水际，尚思馀润浃天涯。\n恤人自享宜君福，小疾何须更祝釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太素喜景仁新宅","author":"韩维","text":"处仁由智古常然，贤者宁同聚所寰。\n植木便知如渭水，结茅仍得见箕山。\n杯深不许嘉宾诉，花小须防稚子攀。\n投绂归来无异事，许公诗酒断生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲连兄城上晚步","author":"韩维","text":"久积端居滞，聊为散步游。\n青苔跳怒黾，绿树矫鸣鸠。\n雨暗横舟浦，凉生调角楼。\n不妨乘晚兴，更尽水西头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲巽在高阳日作诗见怀而不见寄","author":"韩维","text":"常记当年并马鞍，翛然无事世尘间。\n独怜交契如君少，仍喜官曹共我闲。\n却顾旧游空岁月，欲传佳句邈河关。\n从今会合尤须数，此别相看鬓已斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冲公上人","author":"韩维","text":"远色分诸岛，清光湛一陂。\n鸟行排夕照，竹影乱风漪。\n道体烦摩撮，禅心绝占窥。\n由来输范老，佛法不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安国天钵拈香","author":"韩维","text":"杖策乘缘利有生，闻风犹得耳根清。\n去年俱是凝然体，存殁徒伤妄者情。\n灵骨不随烟共尽，真心常与月孤明。\n世人欲识泥洹路，问取师今第几程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和尧夫思湖上秋时见寄","author":"韩维","text":"落尽芙蕖十顷红，败荷衰草满秋风。\n夷犹画鹢来天外，嘹唳惊鸿入镜中。\n亭榭装成如待我，樽罍开处便思翁。\n粗官岂得君留滞，府第深严合在东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱主簿游园","author":"韩维","text":"白首昏昏度岁年，忽闻春至便开颜。\n溪头冻水晴初涨，竹下名园昼不关。\n旋得歌辞教妓唱，远寻梅艳唤人攀。\n如今尚有官拘束，解组归来始是闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯寿秘监","author":"韩维","text":"曾陪道论接清欢，屈指于今四十年。\n不用笙歌娱上客，直将风月待高眠。\n黄花一醉犹能否，白首相逢是偶然。\n便欲投冠结闲伴，家山况与碧嵩连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和况之","author":"韩维","text":"湖上和风艳翠漪，柳枝摇动草芽齐。\n珍禽綵翼嬉晴日，游女红裙上大堤。\n新试画船浮鹢首，却惭美盎乏驼蹄。\n喜君不负持杯约，正是桃花水满溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和况之提刑途中遇雪","author":"韩维","text":"云凝野旷接高低，切切寒侵使者衣。\n客路恍惊霜鬓改，家山回望玉觞飞。\n更添宿雨催花润，未放春雷起蛰威。\n柳色压堤清溜满，舣船持酒待君归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君俞岁暮偶成","author":"韩维","text":"冻水迎风解，芳芽逐日新。\n不惊身渐老，还喜物皆春。\n发短频添雪，心虚不受尘。\n鸡豚如有燕，莫忘社中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君俞春暮书事","author":"韩维","text":"举俗从多事，惟君独闭关。\n废觞岂为戒，开卷不妨闲。\n小雨清湖面，飞花乱席间。\n应怜狂太守，心不到灵山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君俞偶成","author":"韩维","text":"窃比淮阳卧，幸非庄舄吟。\n政馀无异事，物外得同心。\n遇兴倾浮蚁，投闲作戏禽。\n世间并出世，于我两沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君俞喜雨","author":"韩维","text":"一夜歊炎散烈风，清和从令气潜通。\n诚微敢谓天心应，政拙惟希岁事丰。\n便有欢声南亩俗，首传佳句少陵翁。\n心灰鬓雪无馀愿，饱食安居与众同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张太中馆于西湖","author":"韩维","text":"湖榭从来与众同，况于清晏奉群公。\n驱车即日趋翔凤，就馆初寒听过鸿。\n霜雪满髯仍自壮，珠玑落笔不知穷。\n太平鱼鳖今咸若，岂系区区一老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杜七学士见寄","author":"韩维","text":"谋猷久恨辜明主，骸骨终蒙赐老臣。\n绝口敢论当世事，放怀重老故园春。\n闲寻物外忘言客，喜遇杯中得趣人。\n能作新诗仍寄我，知君心不在埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贡甫","author":"韩维","text":"十年灯翳视浮荣，兀坐翛然槁木形。\n别后情怀非往日，老来光景似流星。\n厚恩未报心徒赤，多病何从发复青。\n一览彫章思旧好，忽如醒病得初酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邵兴宗再还馆","author":"韩维","text":"莫嗟华发尚蓬瀛，自古儒生半滞荣。\n学似杨雄老天禄，才如严助厌承明。\n一箪聊喜安吾道，几骑当知达此生。\n闻说东郊可携手，能来从我并鞍行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邻几前岁同济川原甫赏阁后杏花今兹对之有怀二君","author":"韩维","text":"春风几日到蓬莱，仙伯初惊杏蕊开。\n绕树独听清夜漏，怀人空对昔年杯。\n坐怜珍赏同心隔，愁见新芳入眼来。\n欲折繁枝有所赠，九重丹禁照瑶魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周仲章出郊","author":"韩维","text":"万里青天洗曙霜，秋曦满眼对晴光。\n扫残遗秉川原静，折过寒花径隧荒。\n偶入名园逢漆吏，远寻香刹问支郎。\n浮生宠辱何须道，幸有田家浊酒尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和定国廷评","author":"韩维","text":"孤身万里逐流人，两见炎洲末利春。\n勋族每蒙朝念旧，圣恩方与士更新。\n忘忧自有禅心静，禦瘴无先道气醇。\n傅野为霖非我事，愿闻雷雨跃穷鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和昌言太中","author":"韩维","text":"眉秀瞳青却少容，精神强健几如公。\n相逢细雨开篱菊，自愧繁霜满鬓蓬。\n谈道远追西域祖，题诗今得少陵翁。\n锋车北去归何日，且愿从容一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和昌言谒见景仁所居话及洛事","author":"韩维","text":"重迁岂是贤人累，乐内非期俗子誇。\n万瓦生烟新起第，一经消日旧传家。\n浮舟共爱清湖色，披竹时寻曲水涯。\n未信闲中无事役，隔年贪看别都花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和昌言喜雪","author":"韩维","text":"万里多仁德有邻，故交仍佩左鱼新。\n欢娱每恨流阴驶，谈笑几还太古淳。\n浮蚁生光盈寿斝，惊鸿取势落华茵。\n题诗寂寞高眠冷，笑杀尊前起舞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]