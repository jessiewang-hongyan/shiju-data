[{"title":"次韵常之秋日郊居十首 其二","author":"许及之","text":"田里逢年岁，江山净物华。\n栖粮供野雀，输赋答官蛙。\n觳觫眠穰圃，龙钟卧酒家。\n不须听击壤，平世此何加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其三","author":"许及之","text":"年光本尅期，秋闰似移时。\n断雁馀新绠，残蝉泥旧枝。\n黄华随露展，乌帽受风攲。\n预有登高兴，秋风入梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其四","author":"许及之","text":"穷巷家何隘，秋郊景自舒。\n草涂飞蚱蜢，蓼岸点舂锄。\n虾菜通潮信，鱼蒲傍海居。\n饭廉称柳市，别业计非疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其五","author":"许及之","text":"寄种侪孙稻，株株欲竞齐。\n年丰催酿蚁，夜半想闻鸡。\n野老同杯酌，忘形绝町畦。\n虽无花泛水，终恐世人迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其六","author":"许及之","text":"涉世味何疏，师心道与俱。\n古风诗入律，远景句成图。\n一语中标的，千篇徒嗫嚅。\n秋光照轩豁，我辈未囚拘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其七","author":"许及之","text":"学阃难优入，诗堂仅许升。\n百年从皓首，一盏爱秋灯。\n次第挂冠老，晨昏有发僧。\n未能逃兀兀，祇欲任腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其八","author":"许及之","text":"龙翔江上水，万折只朝宗。\n依倚惟危槛，扶持有短筇。\n秋山成自献，落日为谁容。\n临眺馀嘉菊，重阳酒自供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其九","author":"许及之","text":"诗分缘稼穑，别墅故人多。\n又过中秋闰，无如明月何。\n违离增寂寞，衰病废吟哦。\n十首撩人甚，重翻古井波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之秋日郊居十首 其十","author":"许及之","text":"觅句无新语，怀人有故情。\n归音苏酒渴，诗法酿秋清。\n近种芙蓉发，低铺锦绣成。\n虽赊新瓮熟，腊酝待同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴季行秋怀","author":"许及之","text":"弹冠惊野马，束带响吴钩。\n意远秋多思，诗清语过愁。\n君当仪省户，我合老林丘。\n何日苕溪上，相从不系舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日邀友同赏","author":"许及之","text":"令温风有信，林静叶无哗。\n别种桃舒萼，先期梅著花。\n成蹊馀屐齿，索笑见檐牙。\n未饮朝来酒，何妨饭后茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"念九日早闻雪","author":"许及之","text":"去岁一冬暖，开春逾月晴。\n伸眉来雨意，变色起雷声。\n摇动园林喜，欢呼鸟雀鸣。\n閒中多感激，诗句亦生成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁除日见白发","author":"许及之","text":"四十明朝是，俄惊白发新。\n旧诗曾探借，今语遂为真。\n不恨身将老，惟怜学转贫。\n婆娑花县底，谁复念安仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夜斋宿","author":"许及之","text":"老境惭年长，斋居惜岁徂。\n难分阿戎炬，只拥玉川炉。\n夜雨知时落，朝阳谪见无。\n君王素修德，安意饮屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新晴二首 其一","author":"许及之","text":"入院馀旬浃，今朝始快晴。\n才闻乌鹊语，已有蜜蜂声。\n到眼花枝暖，粘须柳絮轻。\n重门无个事，诗意正关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新晴二首 其二","author":"许及之","text":"宿雨居然阁，顽云扫似开。\n岚光湖上出，霁色柳边来。\n铃鸽抟风转，筝鸢掣线回。\n脩廊閒勃窣，花影上苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祷雨有喜","author":"许及之","text":"已用计然策，犹烦傅说霖。\n绵延三日往，慰藉九重深。\n柱础收馀润，摩围散薄阴。\n何庸尸祝力，圣主自诚心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵转庵喜雨二首 其一","author":"许及之","text":"通夕闻鸣霤，凌晨起炷熏。\n映山高见雨，隔坞远留云。\n卢橘明金弹，安榴染绛裙。\n楼居堪护足，终羡蝶飞纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵转庵喜雨二首 其二","author":"许及之","text":"榴绽千重束，葵开一丈红。\n为怜花寂寞，却念雨溟濛。\n此去须时若，相将喜屡丰。\n閒中有忙事，祇得挠邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵酬转庵 其一","author":"许及之","text":"经梅多过溽，转蕙拟吹薰。\n山脚昏酣日，檐牙晓堕云。\n病忺添御裌，笔懒习书裙。\n那得惊人句，聊将绝世纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵酬转庵 其二","author":"许及之","text":"万木稠新绿，孤花委晚红。\n山容随隐见，云影度空濛。\n农老无嫌问，人言不害丰。\n破愁还作喜，结句答邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德久雨迁鱼庄赋诗纵臾","author":"许及之","text":"漫雪蜗争席，翻泥蚓近床。\n不堪听鹳垤，应喜得鱼庄。\n带雨移行李，携孥问野航。\n西湖第一义，佳句已难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵答转庵","author":"许及之","text":"岚光趋泽笏，波影漾湖床。\n借竹欣移宅，看花拟宴庄。\n钟声来佛屋，镜面济慈航。\n莫便疏城市，诗盟未可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和二首 其一","author":"许及之","text":"晴日烘船屋，薰风傍笔床。\n未穿三益径，已想百花庄。\n野火明僧寺，樵歌度客航。\n山头明月上，酒兴故难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和二首 其二","author":"许及之","text":"城市从疏出，何人独拜床。\n不辞乘下泽，久已厌康庄。\n借屋欣凭阁，临湖似舣航。\n风波无用避，端与世相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡会游湖怀南床复次韵","author":"许及之","text":"名园乡党敬，莫可致南床。\n盛事联千佛，诸公竞一庄。\n建侯期朔漠，驻跸尚馀杭。\n报国平生志，他年幸勿忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再戏和转庵","author":"许及之","text":"孰裹经旬饭，谁同夜雨床。\n何妨散花女，聊伴食鱼庄。\n拟唤桃根渡，还思范蠡航。\n江湖真落手，身世可兼忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓居","author":"许及之","text":"野水生洲面，閒云傍屋颠。\n钟鸣人已定，月满句初圆。\n花径经过少，苔文长养便。\n行藏随处是，安用买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得东山居主人恋家不出因借戴希周渔乡居赋杂兴六首 其一","author":"许及之","text":"借得渔乡住，分明似水仙。\n好山排座右，明月到尊前。\n挂綵迎朝日，飞霞带晚烟。\n往来真自在，易觅钓渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得东山居主人恋家不出因借戴希周渔乡居赋杂兴六首 其二","author":"许及之","text":"借得渔乡住，蟾光忽满轮。\n金波随短棹，银汉有通津。\n几度中秋月，今宵自在身。\n一尊消得醉，眼底欠诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得东山居主人恋家不出因借戴希周渔乡居赋杂兴六首 其三","author":"许及之","text":"借得渔乡住，心安即是家。\n客来时举酒，饭后定分茶。\n野老从争席，山童解献花。\n扁舟随意坐，不羡斗边槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得东山居主人恋家不出因借戴希周渔乡居赋杂兴六首 其四","author":"许及之","text":"借得渔乡住，閒居气味长。\n新霜浓淡白，早橘浅深黄。\n勋业锦囊句，光阴宝篆香。\n故人如访问，宛在水中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得东山居主人恋家不出因借戴希周渔乡居赋杂兴六首 其五","author":"许及之","text":"借得渔乡住，诗家物色宜。\n苇声鱼拨剌，竹影月参差。\n风铎时成曲，山童解答诗。\n閒居多乐事，惟有此心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得东山居主人恋家不出因借戴希周渔乡居赋杂兴六首 其六","author":"许及之","text":"借得渔乡住，清霜已著秋。\n丹枫如锦障，黄菊似钱流。\n物理观诸妄，吾生等一沤。\n得閒闻健好，随寓且夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵石谦伯山居","author":"许及之","text":"地僻人为胜，居閒乐自知。\n书声山响亮，琴韵水逶迟。\n为药藤修架，因花槿结篱。\n蓝田冷松竹，那得久怡怡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘德久借居西湖张氏园诗","author":"许及之","text":"竹居元为竹，闻借帚湖阴。\n齐物千言就，巢枝一径深。\n岚光开句眼，虚籁试禅心。\n赓得西湖咏，何须更姓林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木瓜园","author":"许及之","text":"近郭梅根古，临流野兴长。\n结亭从寄乐，隔坞得浮香。\n度锦趋莲渚，吹云映柳庄。\n棠阴无可纪，题作小河阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵木缊之题挹爽书院","author":"许及之","text":"岁月多歧路，生涯几短亭。\n归来故人眼，相对旧时青。\n诗带烟霞寄，园知杖屦经。\n预愁逃社去，湖外渺沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题江心寺","author":"许及之","text":"屹立中川屿，江行结斗城。\n千滩界岩下，两塔涌波擎。\n布地有沙涨，中天惟月明。\n清宵挠禅定，端是棹歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行过沛城","author":"许及之","text":"人日晴还暖，游丝舞复翻。\n湖平开镜面，岸静见芦根。\n舟昔几番过，地今何处村。\n沛城多美酒，弭棹一开樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"籴舟泊高沙为境内所逐却泊天长","author":"许及之","text":"官薄谋先拙，才疏食更浮。\n抱关从委吏，贷粟向河侯。\n遏籴还逾境，迎风更溯流。\n百年俱逆旅，处顺一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行次外舅吾字韵","author":"许及之","text":"橹滑谁催汝，山迎似唤吾。\n意行从改岸，瞑坐得还珠。\n黄卷真如奶，骚经未可奴。\n霏微隔江雨，昨夜湿菰蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阻风泊塘阴寨登四望山用前韵","author":"许及之","text":"行藏端在我，富贵本非吾。\n不是迷邦宝，休云被褐珠。\n官方邻厮役，贤有隐佣奴。\n所至何妨乐，车轮未朽蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行得顺风再次韵","author":"许及之","text":"抱关真漫仕，所好合从吾。\n易乞高霞佩，难投明月珠。\n飘蓬谙岁月，泛宅挈僮奴。\n万事乘流耳，殷勤十幅蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入淮","author":"许及之","text":"淮水限南北，舟行洛水滨。\n底须分尔界，何处不吾民。\n好在关河旧，期来日月新。\n片云无可翳，岂待净妖尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日过左蠡","author":"许及之","text":"未识康庐面，惟闻左蠡名。\n一朝窥壮观，五节记经行。\n细把离骚读，时将浊酒倾。\n波涛元不恶，风力更生成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸暨道中早行","author":"许及之","text":"飞雪夜无声，窗虚倍得明。\n司晨鸡有误，破梦蝶先惊。\n何处吹烟湿，谁行马迹轻。\n篮舆吾未稳，愧尔仆夫征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪霁早行","author":"许及之","text":"蓐食挑镫晕，篮舆破晓氛。\n雪开千嶂日，冰合一溪云。\n久客年华度，求官道力分。\n还乡定春及，物意觉欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"括苍道中次陈颐刚韵","author":"许及之","text":"山色随诗瘦，波光际野空。\n行装秋思里，情话雨声中。\n无补身如赘，多愁鬓似蓬。\n惟馀沧海兴，酒后忆郫筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬居甫登后山","author":"许及之","text":"人老东山隐，春归北斗城。\n精庐青嶂合，华盖碧云擎。\n落日不愁晚，半蟾方接明。\n端能数过访，无惜夜车声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送钱大受帅广东 其一","author":"许及之","text":"妙算无遗策，私忧有剧谈。\n丰功期漠北，小试见湖南。\n煖席君何暇，妨贤我甚惭。\n诏将须尺一，象可应魁三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送钱大受帅广东 其二","author":"许及之","text":"淮甸为寮日，私钱奉令时。\n同拚愞弱罢，争忍碎烦为。\n报国存忠赤，逢人惜鬓丝。\n相从又相别，勋业迫男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送才叔宰乌程","author":"许及之","text":"铛坐萤窗夜，肩随鹗荐年。\n科名虽独后，官业更无前。\n剧县三千水，修门尺五天。\n秋风满孤屿，难驻处州船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘茂实赴连江丞二首 其一","author":"许及之","text":"三山七闽右，千竹二松间。\n官地今为乐，官名丞更閒。\n离支明夏谷，格磔响秋山。\n收拾吟哦课，湘中寄一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘茂实赴连江丞二首 其二","author":"许及之","text":"弈以旁观审，书难掣肘绳。\n一同兼利害，贰邑易声称。\n但使知贤令，端为不负丞。\n兹行子馀事，著语我何能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送潘才叔赴合肥录事二首 其一","author":"许及之","text":"镫火寒窗夜，声名弱冠年。\n掇科君恨晚，用世我奚先。\n饷道曾争辟，公车合荐贤。\n圜扉聊鞠草，幕府且依莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送潘才叔赴合肥录事二首 其二","author":"许及之","text":"官业盘根见，生涯破甑轻。\n才堪当一面，句可敌长城。\n亲待平反笑，时须慷慨清。\n十连筹正远，三语意犹倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张说道县尉之官襄阳","author":"许及之","text":"一尉襄阳去，三年别旧游。\n烦君登岘首，拭泪望神州。\n勋业男儿事，依违我辈羞。\n为言贤府帅，问讯橘乡侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送薛子明赴歙县尉二首 其一","author":"许及之","text":"家世联三凤，才名擅一夔。\n诗章谢池草，经术董生帷。\n雁塔题名近，龙门点额迟。\n一官聊一尉，民事是良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送薛子明赴歙县尉二首 其二","author":"许及之","text":"新安今太守，癸未昔同年。\n老手亲师范，良规得吏筌。\n径须如渭尉，切勿效梅仙。\n閒暇何妨学，科名是世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈伯寿之子仲至迎侍赴嘉兴秋官","author":"许及之","text":"欈李官为李，春风饯此行。\n义方非禄养，祖武是家声。\n画诺须三语，哀矜在一成。\n黄堂应坐啸，执别寸心倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潘茂和才叔远访雨后饯别 其一","author":"许及之","text":"连璧远相访，断金情有加。\n不因鱼抚铗，自是客思家。\n好雨知人意，深杯艳烛花。\n今宵真语别，孤屿在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潘茂和才叔远访雨后饯别 其二","author":"许及之","text":"许种飞霞竹，仍求瓯浦梅。\n思乡常梦寐，报国乏涓埃。\n玉叶裁云脍，榴花染雪醅。\n朝三吾已定，谪百便来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送术士吴国材诗","author":"许及之","text":"自昔名家子，于今卖卜翁。\n亲逢黄石老，曾验黑头公。\n无术自医命，有奇祇堕空。\n吹嘘吾岂敢，怜子又西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪萃之太社真率之集三首 其一","author":"许及之","text":"畴昔三洪并，声名四海知。\n灵光一老在，鸑鷟九成仪。\n近有同朝喜，今无远室思。\n双瞻最良誉，合瑞圣明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪萃之太社真率之集三首 其二","author":"许及之","text":"鼎来那有说，铛坐太无哗。\n击缶聊三奏，吹埙信一家。\n劝时几礼醵，真率胜笾加。\n老愧诗无律，新篇极叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵洪萃之太社真率之集三首 其三","author":"许及之","text":"诗翁甘独殿，我辈岂其班。\n爝火自不息，斤风祇似閒。\n秋容蟾桂里，归梦雁芙间。\n物理因诗悟，新来豹一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人见寄","author":"许及之","text":"一别三年久，无书堪往还。\n自怜供吏役，长羡似僧閒。\n契阔诗情在，提撕鬓影斑。\n敲门湖上寺，居士已开山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]