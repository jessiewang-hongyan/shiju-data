[{"title":"春到湖庄","author":"曹彦约","text":"堤南堤北水溶溶，旁倚群山不碍风。\n收拾田园供老境，栽培桃李课新功。\n墙头向长千章耸，润下潜流一线通。\n脚力尚堪行乐在，年来天不负衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋分后十日得暴雨","author":"曹彦约","text":"负固骄阳不忍回，执迷凉意误惊猜。\n倾盆雨势疑飞瀑，揭地风声敌迅雷。\n阶下决明添意气，庭前甘菊剩胚胎。\n可怜岁事今如此，麦垄蔬畦尚可培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日出郊","author":"曹彦约","text":"早是清和便束装，只今庭叶报新凉。\n山应险尽饶宽大，水欲平来尚激昂。\n已服官常犹潦草，未纾民力要商量。\n鲜于司马经行处，文物彬彬意绪长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵知宗挽诗三首 其三","author":"曹彦约","text":"汇水誇同邑，桐江事事贤。\n骨寒谁与地，言重却笺天。\n游宦常千里，归来共一川。\n西门今日路，忍泪入资延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵知宗挽诗三首 其二","author":"曹彦约","text":"三桂先猷远，公来应瑞芝。\n子能传世业，令欲遍孙枝。\n笏盛床应满，端闿橐已持。\n挂冠犹进秩，天意卜深知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵知宗挽诗三首 其一","author":"曹彦约","text":"壮日民师帅，中年国典刑。\n六分名郡竹，两粲使华星。\n綵戏方娱侍，丹旌忽篆铭。\n空馀泉一滴，万古叹清泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送十三郎赴尉汉阳二首 其二","author":"曹彦约","text":"此地关情久，淳庞好士民。\n向来同患难，今历几秋春。\n綵棒迎新尉，绨袍说旧人。\n为言昌谷老，寄语益相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送十三郎赴尉汉阳二首 其一","author":"曹彦约","text":"宦路今如此，亲闱望已深。\n是谁门户责，慰我父兄心。\n镜里休频看，杯中但浅斟。\n前贤官业处，端的要追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送子通司法之官括苍","author":"曹彦约","text":"议礼蠲租两有声，老坡元不计身荣。\n为民受屈今谁似，有子能传近得名。\n此去掾曹无暖席，是中科律定持衡。\n公馀更欲翻经籍，古道时才孰重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送以道赴汉东兵官因呈绣使吴胜之同年兼简李伯行检法许定夫军使三首 其三","author":"曹彦约","text":"李许相从久，时方混武文。\n议刑新幕府，保塞旧将军。\n二士俱人物，三贤更主君。\n春兰秋菊意，他日共风云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送以道赴汉东兵官因呈绣使吴胜之同年兼简李伯行检法许定夫军使三首 其二","author":"曹彦约","text":"仗斧暴公子，酌泉吴隐之。\n斯人未易得，于我最相知。\n见义为常勇，求贤信不疑。\n典刑今在此，此去有馀师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送以道赴汉东兵官因呈绣使吴胜之同年兼简李伯行检法许定夫军使三首 其一","author":"曹彦约","text":"久入功名会，新携辟召书。\n忠勤曾策励，奋迅此权舆。\n当路心知己，长城指望渠。\n只将真实地，持守足安居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人","author":"曹彦约","text":"药裹包回碾臼声，得閒消息病先轻。\n谓予不信看舟楫，之死无他况利名。\n积雨晴边花蒂耐，好风吹外叶声平。\n只愁岸送樯留后，却忆湘南老友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送权次翁赴湖北计幕","author":"曹彦约","text":"万灶貔貅趣上边，皇华新遣墨犹鲜。\n何人共了飞刍事，有客同称入幕贤。\n举酒便惊分袂处，挂帆直到赏音前。\n不妨勋业高前哲，却与山寮作后编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送易彦章以太学正召","author":"曹彦约","text":"涵养书生二百春，为渠文物有经纶。\n只今领袖贤关地，畴昔锱铢舍法人。\n吾道年来多落落，士风从此却彬彬。\n不应小折陈蕃角，谩谓朝家弃直臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡倅辟书不遂复到选部","author":"曹彦约","text":"便饱蒲帆纵木兰，王阳时节好弹冠。\n官身台历星迟速，世路天香篆屈盘。\n人去边头三策在，春回天上五溪寒。\n归飞未戢青冥翅，却与朝廷作羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵主簿","author":"曹彦约","text":"新诗燕婉似花繁，好在鹓行接羽翰。\n一笑相逢江海客，三年犹老簿书官。\n见闻我阙犹干禄，矍铄君能欲据鞍。\n却似岑参寮友会，阳春一曲和皆难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵安卿召除考功 其二","author":"曹彦约","text":"五老重湖一腐儒，强令随牒应时须。\n杜陵身世霜前鬓，陶令田园雨后芜。\n梅菊满怀忧岁晚，松楸关念怯春濡。\n知音自是调元手，乞与还山护命符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵侍郎被召 其二","author":"曹彦约","text":"祇为分忧辍近臣，不应持久费经纶。\n暂来制阃无多日，归去朝天及早春。\n红旆绿油生羽翼，落霞秋水动精神。\n行行但说长安近，辜负攀留几许人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送真希元侍郎得祠西归","author":"曹彦约","text":"愿治方凝伫，求归竟得閒。\n空令如我辈，忍愧尚朝班。\n望重忠嘉上，身轻去就间。\n渺然人物虑，少壮亦衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钱文季国博赴召 其一","author":"曹彦约","text":"每向招贤看典刑，中间人物似零丁。\n只因朋党排诸老，无复纷纶任五经。\n一节何如归帝所，赐环元不为郎星。\n古来官职论车斗，只有忠嘉可篆铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送章致远贤良赴招抚司机幕","author":"曹彦约","text":"穷经知国更知兵，梁楚中间播此声。\n唐幕亟招温处士，汉廷徐策董先生。\n平时未识人贤否，用处方关国重轻。\n露布便多机事少，寄书因到武昌城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送绵竹王主簿","author":"曹彦约","text":"渴想才名不计年，得诗甜处彻中边。\n知君眼里藏青白，托意杯中别圣贤。\n万里偶逢多幸耳，一朝相别两茫然。\n荣归蜀道川涂稳，莫漫嚱吁信谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送萧季然倅均州","author":"曹彦约","text":"持家远与立朝同，善继何人似乃翁。\n国史但书萧傅直，乡评更仰伯夷风。\n只今边备艰难际，自古官箴谨饬中。\n四帙亲朋今健者，尚看褒诏诧江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送湖口尉王德高解印东归","author":"曹彦约","text":"笑解龟符指郑乡，应从凤口得书忙。\n平生璧水功名志，壮岁钟山姓字香。\n恶少何人窥瓮牖，长官无事燕琴堂。\n从今我亦南州吏，乞取梅仙已验方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送腊","author":"曹彦约","text":"谓向年前稍自宽，恼人时序故多端。\n几回水落还添浦，百样天晴却转寒。\n未有梅开供探讨，若无酒遣太衰残。\n明朝便是春来处，暖律丁宁著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蓬丘山人张以道归吉州","author":"曹彦约","text":"山人曾著宰官衫，了事还为马口衔。\n别我三年无瞬息，思君一节尚巉岩。\n人生契合常如此，吾道年来见大凡。\n雨后只愁风力健，江空无计款归帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送雷赴漕召 其一","author":"曹彦约","text":"诏书隐隐下穹窿，已觉朝廷后此翁。\n儒雅久称唐吏部，典刑今对汉申公。\n薰风使者驱驰外，暇日斯民长养中。\n麦陇秧田政如许，定应归报不言功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送雷赴漕召 其二","author":"曹彦约","text":"几年分阃作遨头，又拥皇华岁两周。\n岂有休声勤注倚，尚持英簜但咨诹。\n只今衮职须谁补，自古官身可自由。\n相业青徐宁有定，好将功业张吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送雷赴漕召 其三","author":"曹彦约","text":"我生虽晚亦匡庐，得见先生喜有馀。\n止为包荒安邸舍，敢将入幕论乡闾。\n一官贪禄无他望，四海安身即定居。\n幽谷若因明主问，莫言臣邑有相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送魏使君归宛陵二首 其二","author":"曹彦约","text":"我无郡绩合归与，君有时名孰舍诸。\n其事颇同人颇异，此心相照亦相疏。\n一时风力天容改，后夜月华云气舒。\n同是江南易回首，人来多寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送魏使君归宛陵二首 其一","author":"曹彦约","text":"姓名久已御屏间，合上锋车入帝关。\n岂有荐书喧笔橐，但留声价惠江山。\n簿书袖手诗还在，出处忘情意自閒。\n不分爱江楼下水，隔人无计可追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳湖庄无菊走笔招赵季清黄一之登高","author":"曹彦约","text":"摇落江村菊就荒，苦无节物报重阳。\n病来欲废传杯旧，老去唯思著帽强。\n已变枫丹秋尽力，仅存萸紫晚添香。\n登高有景那能赋，唤取骚人赵与黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻官军收复新息","author":"曹彦约","text":"降敌知无日，和戎事已休。\n百年艰国步，九世忆家雠。\n获蔡驰新捷，收京有定谋。\n可无蜂虿虑，马健更防秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻道旁有死于贼者","author":"曹彦约","text":"义气穷群策，妖氛惨一隅。\n分忧吾弗职，殊死尔何辜。\n智者连千虑，天乎愧匹夫。\n诸军犹请战，此道不榛芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日漫兴","author":"曹彦约","text":"广厦仍炎热，疏慵疾病中。\n赋诗当夏日，鼓棹近南风。\n自觉尘氛少，依然乐事同。\n夜来凭眺处，明月隐墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽致政朝散王大夫章二首 其二","author":"曹彦约","text":"子贵人间有，亲难及盛年。\n出藩先使节，入从冠经筵。\n问政承颜日，归乡属纩前。\n谁能碑有道，还合传先贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽致政朝散王大夫章二首 其一","author":"曹彦约","text":"风流江左后，今不愧诸王。\n弓冶儒非误，衣冠晚见偿。\n当时独立处，千载状元乡。\n天定常如此，三槐有二郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽蔡祭酒诗二首 其二","author":"曹彦约","text":"昔缔金昆好，慈恩有旧题。\n及今如社燕，与子共朝鸡。\n未见星常北，相逢日易西。\n定应湖上路，塞色黯招提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽蔡祭酒诗二首 其一","author":"曹彦约","text":"旧说乘骢老，新来衣绣人。\n眷方隆嗣圣，世已厌成均。\n景晚迟鹓序，边秋忆虎臣。\n家声传庆历，忠惠岂前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朔日迎客之章诸贤多有和者使君再赋仍次韵以谢","author":"曹彦约","text":"霜清石出水分流，邂逅骚人得志秋。\n落日断霞增逸气，小窗低户愧英游。\n苦无酒量能陪饮，只有诗盟可避愁。\n此地何哉添此瑞，建章新识九牙驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂阳走笔呈以道","author":"曹彦约","text":"别后蓬丘老，分杯岁又阑。\n发因求道白，心但济时丹。\n疟鬼三秋热，河鱼六月寒。\n不图梅影夜，对榻共平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠 其一","author":"曹彦约","text":"彼美花兮宜晚春，柔姿淑艳是何人。\n十分国色妆须淡，数点胭脂画未匀。\n带雨容开浑是恨，出墙头望恰如真。\n几时谪下蓬莱岛，霞染仙衣痕尚新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠 其二","author":"曹彦约","text":"一度相逢一度春，不知名姓是何人。\n十分国色妆须淡，数点胭脂画未匀。\n好把东皇为上客，便堪宋玉作西邻。\n临邛道士今何在，说与唐宗是太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中有感欲落不落雪旧事偶成唐律","author":"曹彦约","text":"东皇雅欲破玄冥，滕六终怀可否情。\n岂不愿丰招瑞气，又虞加力困饥氓。\n柳虽阁絮心犹壮，梅不能妆意自倾。\n只恐玉龙禁不得，便输鳞甲赋群英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秘阁修撰雷文卿挽章二首 其二","author":"曹彦约","text":"访我鸣琴日，闻公吐屑言。\n循良临武政，忠愤大奚冤。\n厥后依英簜，新来近达尊。\n却归桑梓路，忍对建昌门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秘阁修撰雷文卿挽章二首 其一","author":"曹彦约","text":"殄瘁连乡党，凋零及老成。\n玉亡修水秀，星掩寿沙明。\n不上论思直，空馀馈饟名。\n盖棺隆眷在，论撰见哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政检法牛公挽章三首 其三","author":"曹彦约","text":"门户关州县，交游及弟昆。\n每于尊俎后，窥见典刑存。\n岂不昏姻重，常疏药石言。\n矧闻丹旐发，心绪正沄沄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政检法牛公挽章三首 其二","author":"曹彦约","text":"瘠甚都昌境，民无晚种田。\n乐输虽欲速，乞籴最堪怜。\n帅阃施长技，王人改旧弦。\n本原谁任责，阴德至今传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政检法牛公挽章三首 其一","author":"曹彦约","text":"结屋明经好，经明身欲修。\n平生仓廪实，不为稻粱谋。\n宦路门方盛，容台志已酬。\n莫言馀八帙，犹欠少迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸丈和野园之诗乃复次韵","author":"曹彦约","text":"骧首弥年闭六关，倦飞今日遍千山。\n也知心醉非从事，顿觉身轻有大还。\n酒债人生频检点，宦情山色正孱颜。\n不须作恶悲儿女，更放羁人到席间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读乞归不允诏","author":"曹彦约","text":"有赫丝纶宠，空贻老病羞。\n命从今日下，事比去年愁。\n已向祠官去，犹为讲席留。\n谁知蝴蝶梦，栩栩到吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"课花木","author":"曹彦约","text":"旋饰芳菲真草莱，强加湔祓敌尘埃。\n春将紫翠笼丹桂，晚觉苍黄植绿槐。\n鼻观已通蜂蝶闹，酒杯频到燕莺猜。\n官居未胜閒居乐，乞得三年野兴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郭承禧同年解倅印趋朝 其一","author":"曹彦约","text":"昔在慈恩会，交新意已亲。\n相逢游宦处，不比后来人。\n共度衡阳夏，平分岳麓春。\n夤缘如此少，欲别倍伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郭承禧同年解倅印趋朝 其二","author":"曹彦约","text":"仕路何曾乐，迎亲却是荣。\n诸公新引类，难弟久专城。\n便恐班朝著，无劳仗友生。\n长沙风月夜，炯炯自清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪李监税饮刘园","author":"曹彦约","text":"剩栽花木闹低墙，满刻诗文榜画堂。\n郁李齐开枝尚弱，牡丹垂谢蕊犹香。\n书生野趣人间少，游子佳时客里忙。\n准拟灯前儿女问，得君全不负春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪总卿戎帅登高因至郊外","author":"曹彦约","text":"万木阴阴覆女萝，一川佳处宝峰多。\n因晴领客催萸菊，恐雨妨农访麦禾。\n付我江山须领略，可人时节易蹉跎。\n心閒更了官中事，未必秋风奈老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪总卿路钤相麦观花修出郊故事","author":"曹彦约","text":"二月春光最恼人，不禁春恼更寻春。\n关心秀入青青陇，适意红临滟滟津。\n开阖雨晴天气巧，铺张桃李世情均。\n病夫已作庐山梦，尚拥篮舆托后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成 其二","author":"杨简","text":"脚踏和风步步春，石鱼楼上等閒人。\n兴来冲口都成句，老去游山不动尘。\n李白谁知他意思，桃红漏泄我精神。\n忽逢借问难酬对，只恐流莺说得真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿苏坊","author":"曹彦约","text":"客久嚣尘外，冬深驿舍前。\n乱山宽处日，野水暮时烟。\n契分新篘酒，生涯旧物毡。\n悠然归兴动，依约探梅天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得雨","author":"曹彦约","text":"局蹐民无地，焦熬岁不天。\n雨方宽赵日，数已入汤年。\n调饷今方尔，蠲租恐未然。\n古来勋业盛，根本讳沉绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惊蛰后雪访徐孟坚不遇坐待甚久","author":"曹彦约","text":"忽忽弄明珠，纷纷拥塞酥。\n都忘春老大，复作冷工夫。\n甲拆迟先达，芳菲约后图。\n兴来还兴尽，呵手复须臾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惊蛰后雪作未已阻之湖庄","author":"曹彦约","text":"甲拆多应满药栏，跨骡心已拂轻鞍。\n正疑阴固仍飞雪，岂有春中却冱寒。\n启蛰候虫犹自闭，向阳梅子自能酸。\n误成严冷非天意，说与人心作好看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚梅","author":"曹彦约","text":"去年浮月动微薰，陨箨忧寒正杂群。\n今日得春张万玉，采繁迎煖尚从军。\n花时十月连正月，岁事三分占一分。\n酒煮和羹还好在，预除芜秽莫纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴","author":"曹彦约","text":"剩水浸秋碧，馀霞占晚红。\n浩歌鸣鹤后，柔橹泛鸥中。\n酒戒情难遣，诗吟老未工。\n怀哉真面目，助顺企清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]