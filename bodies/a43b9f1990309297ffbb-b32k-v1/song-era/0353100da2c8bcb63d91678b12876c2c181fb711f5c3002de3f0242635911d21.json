[{"title":"永安荣仲谋秘校访别三首 其二","author":"郭祥正","text":"相逢投老愈情深，不独开怀又吐心。\n更上高台同一醉，十年陈迹漫追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永安荣仲谋秘校访别三首 其三","author":"郭祥正","text":"行义都无一点瑕，诗书满腹贮英华。\n老来方得青衫着，便近庐山五柳家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达观台黄鲁直名之二首 其一","author":"郭祥正","text":"戴氏山头一席平，集仙椽笔写台名。\n长江自与天为镜，不用风云变晦明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达观台黄鲁直名之二首 其二","author":"郭祥正","text":"高台千尺俯江干，达观宁论眼界宽。\n但见青山围远水，不知何处是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"靖节真像乃庸画思得伯时貌之遂以一绝寄简","author":"郭祥正","text":"古帐萧萧画不真，空祠犹与狄公邻。\n凭君妙手重图貌，不是寻常行路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招德观见老道士李如海年八十六矣","author":"郭祥正","text":"弃官归去又重来，三十三年几人在。\n玉虹横截碧云溪，不见腾空见如海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与吴子正言怀","author":"郭祥正","text":"山南山北屡相逢，年少今成二老翁。\n不向烟霄共飞舞，且来倾倒玉瓶空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承天院清辉阁","author":"郭祥正","text":"一轩谁与写清辉，地近城闉却少知。\n只待中秋深夜看，玉蟾低蘸碧琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁卯十月十日游开先瀑布绝流","author":"郭祥正","text":"山源久涸旱尘飘，想见潺湲泻石桥。\n只道海风吹不断，为谁收起玉鲛绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吉守李献父二首 其一","author":"郭祥正","text":"半月樽罍为我开，琵琶围座殷晴雷。\n船头一转如天上，犹有新声入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吉守李献父二首 其二","author":"郭祥正","text":"昭亭交旧半存亡，只有君家近我乡。\n终约月明搥鼓过，贺公须爱李生狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次芙蓉渡和颖叔修撰旧题","author":"郭祥正","text":"绰约芙蓉照碧湍，红绡衫薄不胜寒。\n吹香洗露情多少，只得元戎一饷看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次南蛮驿和颖叔修撰旧题","author":"郭祥正","text":"南来匹马厌红尘，喜见梅花似玉人。\n都为岭头无腊雪，故教六出占先春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次凌江先寄太守黎东美二首 其一","author":"郭祥正","text":"去岁同班别帝庭，君先度岭我方行。\n纵横才力知无敌，到未期年政已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次凌江先寄太守黎东美二首 其二","author":"郭祥正","text":"晖晖寒日溪云开，北客新过庾岭来。\n闻说凌江风物好，清香先见数枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次曲江先寄太守刘宜翁五首 其一","author":"郭祥正","text":"行彻淩江到曲江，史君才业世无双。\n前人俗政应除尽，盛赋新诗倒玉缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次曲江先寄太守刘宜翁五首 其二","author":"郭祥正","text":"路绝曹溪孰敢过，主君才辨泻悬河。\n一时风物应丕变，入眼山川秀气多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次曲江先寄太守刘宜翁五首 其三","author":"郭祥正","text":"韩愈莫吟泷吏问，梁鸿休赋五噫歌。\n百年荣辱能多少，且倒芳樽养粹和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次曲江先寄太守刘宜翁五首 其四","author":"郭祥正","text":"学佛学仙君自悟，多愁多病我难任。\n兵厨酒熟青梅小，且置玄谈伴醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次曲江先寄太守刘宜翁五首 其五","author":"郭祥正","text":"落尽梅花君未归，且携樽酒赋新诗。\n逢人少说瑶台事，得道宁要俗子知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次五羊先寄帅公颖叔","author":"郭祥正","text":"玉帐元戎金马儒，还同严武在成都。\n新诗欲得何人和，席上能容杜老无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻五羊今岁有雪口号寄颖叔修撰","author":"郭祥正","text":"南人不识白皑皑，直怪狂风舞乱梅。\n向道元戎召和气，岭云翻雪入城来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古羊江口","author":"郭祥正","text":"古羊江口两山阴，野客停挠为一吟。\n面逆寒风望苍翠，老来唯有爱山心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四恩禅院","author":"郭祥正","text":"石斗双崖控碧溪，榕阴冉冉与云齐。\n寺门欲出浑无路，直上青天万丈梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙庭观","author":"郭祥正","text":"楼阁依稀踞凤凰，入门松桧自然香。\n蟠桃已熟桑田变，应与皇家共久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入清远峡","author":"郭祥正","text":"舟绕苍崖转碧津，层层云树画屏新。\n分明便是桃源路，底事无花不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出清远峡","author":"郭祥正","text":"轧轧孤舟两橹鸣，悠悠山阔白沙平。\n回瞻苍峡来时路，只得银潢半日行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双溪呈帅座颖叔","author":"郭祥正","text":"双溪流过碧湾湾，两带青罗绕玉环。\n入海未甘随咸卤，助公吟笔泻潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颖叔别后见寄","author":"郭祥正","text":"白头方得岭南麾，却望长安恨不飞。\n毒雾腥烟非我乐，未从公辟敢言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨霁小饮示曾令","author":"郭祥正","text":"岚云送雨一番凉，把酒休言忆故乡。\n荔子鲥鱼相伴熟，画船搥鼓下灵羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颖叔为余亲札补到难并和篇开刻既成以二绝句送上 其一","author":"郭祥正","text":"投老文章遇已知，感公书我到难诗。\n银钩玉纽徒称妙，大庾岭南无此碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颖叔为余亲札补到难并和篇开刻既成以二绝句送上 其二","author":"郭祥正","text":"英词妙翰两无双，彼有浯溪此北江。\n下视尘寰真一撮，到无难处为公降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王侃主簿弃官归南城三首 其一","author":"郭祥正","text":"纷纷岚翠扑征衣，蒲酌离觞对落晖。\n忆着故园心已醉，更堪临水送人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王侃主簿弃官归南城三首 其二","author":"郭祥正","text":"侵侵尘土欲何为，满腹诗书不遇知。\n归去青山终我老，挂冠全胜拜官时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王侃主簿弃官归南城三首 其三","author":"郭祥正","text":"泠泠风露菊花时，有客言归便得归。\n自是不归归便得，灵羊峡口棹如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再送颖叔待制度岭","author":"郭祥正","text":"迹滞端江心欲飞，要将清泪洒行衣。\n云间骥尾终难附，梅子黄时公自归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙诏许归二首 其一","author":"郭祥正","text":"众人应笑乞归忙，自分生缘不久长。\n舞棹呈桡无伴侣，冷云寒水是家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙诏许归二首 其二","author":"郭祥正","text":"昨日恩书许拂衣，今朝著句咏将归。\n芦花明月无人占，一笑劳生早息机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别吴漕翼道","author":"郭祥正","text":"岁晚分符出瘴烟，樗材无用只公怜。\n此身乞得生前去，却向江南云水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林和中家观画卷五首 其一 寒芦飞雁仍和子中修撰旧韵","author":"郭祥正","text":"芦黄水落秋将暮，鼓翼各寻云外路。\n为问归飞归底处，我今亦向江南去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林和中家观画卷五首 其二 曹霸画马王荆公手写杜甫丹青引跋其尾","author":"郭祥正","text":"曹将军画少陵诗，林氏家藏相国题。\n不动精神瞻御座，风云万里入霜蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林和中家观画卷五首 其三 王摩诘捕鱼图","author":"郭祥正","text":"鱼跃鱼沉都不知，垂竿只要得鱼归。\n天寒浪急鱼难得，愁入芦花日又西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林和中家观画卷五首 其四 王昭君上马图","author":"郭祥正","text":"飘飘秀色夺仙春，只恐丹青画不真。\n能为君王罢征戍，甘心玉骨葬边尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林和中家观画卷五首 其五 蕃马图","author":"郭祥正","text":"唐时胡马入长安，下马胡儿倚马鞍。\n今日升平无此物，樽前聊写画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余八月十六日携家玉笥山观月览颖叔待制寄题绝句然公之往还终不暇游也故次其韵以寄颖叔","author":"郭祥正","text":"玉笥深深路更幽，骖鸾不到欲谁尤。\n公临瓠子方忧决，输我携家踏月游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉涧桥","author":"郭祥正","text":"桥名玉涧玉淙琤，覆水松阴两岸清。\n野草已香仙露湿，客从此去问长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入承天观二首 其一","author":"郭祥正","text":"飘飘飞盖入仙山，楼阁初逢碧霭间。\n为问蟠桃今熟未，客来一食欲忘还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入承天观二首 其二","author":"郭祥正","text":"云舒云卷晓风凉，千尺松梢鹤唳长。\n昨夜月宫飘桂子，至今楼殿带天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出观","author":"郭祥正","text":"沉沉楼殿五云藏，草木长春水石香。\n一榻可能容我住，桃源迷路笑渔郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次新淦先寄刘中丈","author":"郭祥正","text":"平生志愿各怀归，今日江湖乐自知。\n一艇一蓑明月夜，竿头丝动得鱼时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新淦西禅绿野庵 其一","author":"郭祥正","text":"草心回暖春风香，柳眼半开春日长。\n老禅隐几万事毕，春去春归春自忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新淦西禅绿野庵 其二","author":"郭祥正","text":"圆如鹄卵压沧洲，一榻攲眠颇自由。\n春色解回林野绿，如何只白老人头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游生米施真君观阅李德素旧题五绝句遂次韵和之 其一","author":"郭祥正","text":"寄语人间学道人，无真可学乃为真。\n施郎昔日投竿处，直下寻纶透海滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游生米施真君观阅李德素旧题五绝句遂次韵和之 其二","author":"郭祥正","text":"学道多年未得仙，漫将芝草种瑶田。\n索纶不起龙吞钓，为问渔翁直几钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游生米施真君观阅李德素旧题五绝句遂次韵和之 其三","author":"郭祥正","text":"水鸦山鹊语相传，风阻归航未得前。\n老桧一株坛石静，道人无事看残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游生米施真君观阅李德素旧题五绝句遂次韵和之 其四","author":"郭祥正","text":"来寻遗事问神仙，坐石垂纶不记年。\n水鸟自来云自去，月和蟾影几回圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游生米施真君观阅李德素旧题五绝句遂次韵和之 其五","author":"郭祥正","text":"晴云落日似横金，水鸟松风伴我吟。\n题壁高人竟何在，犹应施老笑无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈同行黎东美朝散","author":"郭祥正","text":"风日萧萧暑气无，橹声相逐转江湖。\n西山庐阜青如淀，应有新诗入画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望庐山二首 其一","author":"郭祥正","text":"西山行彻见羌庐，碧玉棱棱奠一区。\n南去北来头白尽，不知五老鬓斑无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望庐山二首 其二","author":"郭祥正","text":"三十年前湓浦尉，五千里外解符归。\n庐山相见应相笑，为借云泉一濯衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庙湾夜泊","author":"郭祥正","text":"薄昏洲渚鸥凫静，照网渔家灯火红。\n尽道龙归井泉浊，明朝愿借一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"槠溪怀亡友张慎微","author":"郭祥正","text":"秋风入夜透征衣，点点渔灯各自归。\n投老重来江上泊，庐山如旧故人非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日游净社院二首 其一","author":"郭祥正","text":"旋披榛棘寻山径，忽绕松篁入寺门。\n九日临高无此处，佛香禅味解尘昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日游净社院二首 其二","author":"郭祥正","text":"前年九日别家时，黄菊才开一两枝。\n今岁重阳归未得，却寻莲社步迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉院五老亭","author":"郭祥正","text":"五峰相向碧参差，插地擎天力不衰。\n要学世人头亦白，晴烟时起数条丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入万杉","author":"郭祥正","text":"翠霭纷纷蔽一岩，何年人种万株杉。\n天翁已许虬龙卧，匠石不劳斤斧劖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出万杉","author":"郭祥正","text":"禅庭欲别更迟迟，犹恋凉风洒客衣。\n无力便分青嶂住，满怀空带白云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香涧","author":"郭祥正","text":"涉溪攀磴兴何长，隔岸人家桃杏香。\n便是武陵迷路处，只无鸡酒劝渔郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静明轩","author":"郭祥正","text":"道人得道万缘灰，栏下幽花手自栽。\n终日开轩无客到，清风时引竹声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无思轩","author":"郭祥正","text":"妙妙无心岂有思，一轩幽瞰碧涟漪。\n篆香销尽月华午，知是高僧定起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别寻真观","author":"郭祥正","text":"寻真幽径入深源，一宿清虚寄洞天。\n归去姑溪度残日，无因重到五峰前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢东林旧僧","author":"郭祥正","text":"宝陀岩下种松篁，旧客欣逢煮术汤。\n忆着东林携手处，十年添得两眉霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追和杜牧之贵池亭","author":"郭祥正","text":"悠悠江水绿于苔，杨柳迎风眼半开。\n行客不如沙上雁，每逢春暖即知回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观德亭画壁","author":"郭祥正","text":"画手非工本亦佳，四时景物寓天涯。\n最怜荷折秋容晚，双雁徘徊下软沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄耿天骘二首 其一","author":"郭祥正","text":"海棠妍媚露桃红，高卧遥知锦绣中。\n欲问何时渡江去，看花准拟趁春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄耿天骘二首 其二","author":"郭祥正","text":"北山曾赏浪山梅，梅蕊含冰一半开。\n国老自亡梅自发，送梅人在亦悲哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]