[{"title":"州宅十二咏 四望亭","author":"王十朋","text":"有泽宜观水，无檐不见山。\n鄱君千里国，俯仰一亭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅十二咏 绮霞亭","author":"王十朋","text":"孤鹜同飞处，澄江共赋时。\n晚来亭上看，真是谢公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅十二咏 清香亭","author":"王十朋","text":"高架添风韵，芳醪共姓名。\n苏州凝燕寝，疑是此香清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅十二咏 百花楼","author":"王十朋","text":"昔日风流守，公馀种百花。\n春风不检点，红紫落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅十二咏 鄱江楼","author":"王十朋","text":"郭外山横阁，江边水照楼。\n粗官无暇日，何以得消忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅十二咏 蜀锦亭","author":"王十朋","text":"亭废名犹在，春来花自芳。\n犹馀蜀中锦，爱惜比甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅十二咏 景卢赠人面竹杖","author":"王十朋","text":"奔走方嗟力不任，得公一杖直千金。\n竹能有面如人面，人亦虚心似竹心。\n渡水只愁龙欲化，入山应与凤联吟。\n翰林虞部相酬赠，同舍交情复见今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡人项服善宰鄱阳有政声人惜其去用郡圃栽花韵作诗数篇叙别遂和以送之 其一","author":"王十朋","text":"七岁名师世胄赊，云孙行实副文华。\n仁心驯及鲁恭雉，和气种成潘岳花。\n清白见知鄱水月，高明相照楚天霞。\n送君撩我思乡意，遥想吾庐日长麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡人项服善宰鄱阳有政声人惜其去用郡圃栽花韵作诗数篇叙别遂和以送之 其二","author":"王十朋","text":"鄱江同事半年赊，直谅何人似去华。\n吏报圜扉多鞠草，民歌枯木再生花。\n暂留萧寺行逢雨，剩作新诗语带霞。\n褒德自应侯卓茂，清朝知己况如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡人项服善宰鄱阳有政声人惜其去用郡圃栽花韵作诗数篇叙别遂和以送之 其三","author":"王十朋","text":"江东回首莫云赊，寒食令人感岁华。\n皎皎丹心惟望日，星星短发不簪花。\n书传何处山名雁，酒忆吾乡水似霞。\n故旧相逢如问我，为言多病服天麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乡人项服善宰鄱阳有政声人惜其去用郡圃栽花韵作诗数篇叙别遂和以送之 其四","author":"王十朋","text":"公真有德如元令，我愧无才似李华。\n话别芝堂倾竹叶，送行鄱水涨桃花。\n眼看三匝乌逢月，心羡齐飞鹜趁霞。\n它日相期访刘阮，分桃采药饮胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予向年少不自量因读韩诗辄和数篇未尝敢出以示人盖二十年矣近因嘉叟见之不能自掩且赠以长篇蒙景卢继和用韵以谢","author":"王十朋","text":"少小思尚奇，薰风琴欲和。\n规模与时背，场屋屡摧挫。\n大道窥五原，高论读二过。\n神游京城南，思渺蒸水左。\n竹看金影碎，菊撷霜风破。\n论文摩巨刃，荐士躬彊笴。\n萧兰发秋怀，木雁吟齿堕。\n飞飞双鸟鸣，不数鹂两个。\n幽幽十琴操，可仆兰台些。\n光馀万丈长，照我一床卧。\n未终三百篇，正坐短檠课。\n不敢示友朋，惧遭泥滓唾。\n文章吉太守，臭味夙相荷。\n索我旧诗案，赠以千金货。\n郡斋哦好句，艳艳月照坐。\n端如陈琳檄，快读痊轗轲。\n滥把江湖麾，谬声惭日播。\n祈寒兼苦雨，怨嗟吾岂奈。\n窃效衡山祷，因思鉴湖贺。\n鹏鴳各逍遥，溟蓬无巨么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈阜卿读洪景卢追和玉板诗 其一","author":"王十朋","text":"风采棱棱御史官，旌麾所至庶民安。\n渭川千亩填匈臆，散作毫端风雨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈阜卿读洪景卢追和玉板诗 其二","author":"王十朋","text":"前世书鱼化宰官，肺肠元与竹相安。\n侯生韩子相酬赠，诗句惊人魂胆寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何宪脩途倦游怀鄱阳唱和之乐","author":"王十朋","text":"马上诗成驿使驰，社中犹恨使来迟。\n不堪冀北群空后，况是江东日莫时。\n春半莺犹懒呼唤，雨多鸠亦厌分离。\n论文尊酒何时共，公说归期我去期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何宪太平道中书事","author":"王十朋","text":"明刑清诏使，行部近清明。\n况有太平象，想亡愁叹声。\n问民知疾苦，按郡戒将迎。\n更向金陵看，六朝馀故城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何宪题鲁池州通隐堂","author":"王十朋","text":"朝市隐诚好，山林通更嘉。\n出非专为米，去亦不期瓜。\n下惠何妨介，东方未用夸。\n池州知此道，无愧仲连家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芝山劝农","author":"王十朋","text":"出门非为采灵芝，端为农时不可违。\n我欲劝农农劝我，田园薄有早须归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月十五日祈晴十七日雷雨再作","author":"王十朋","text":"清香一瓣乞晴回，准拟阳光万里开。\n风伯未吹云阵破，雷公又唤雨声来。\n补天石烂畴能鍊，陷泞车深不易推。\n谁坐黄堂称太守，深惭无术救天灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜晴再用前韵","author":"王十朋","text":"天闵斯民意已回，群阴不扫自应开。\n扶桑晓日曈曈出，玉宇清风习习来。\n水绿渔翁声欸乃，月明诗客手敲推。\n秧针刺水麦摇浪，定有丰年无后灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日天气朝阴莫晴复用前韵","author":"王十朋","text":"忍饥面目类颜回，仅得青天半日开。\n且愿催诗无雨至，只宜送月有风来。\n出游偶以文昌霁，待满当为桀溺推。\n曰雨曰旸皆帝力，麦苗无害免书灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭何子应 其一","author":"王十朋","text":"籍甚何夫子，文章擅美名。\n金华传语宝，鄱水主诗盟。\n心印横渠学，相门无尽甥。\n人间一梦觉，卿月堕台城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭何子应 其二","author":"王十朋","text":"肮脏宜三黜，飘零到九疑。\n忠膺黄屋眷，音遇紫岩知。\n共理符频绾，明刑节屡持。\n青天万里蜀，无复话归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭何子应 其三","author":"王十朋","text":"公作皇华使，予乘郡守轓。\n江湖吴芮国，襟抱杜陵尊。\n翰墨频挥染，诗文细讨论。\n新编刊未就，楚些已招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同官会饮鄱江楼送谷帘泉二尊戏成小诗","author":"王十朋","text":"闻说楼中会八仙，郡斋分送谷帘泉。\n好将投向鄱江水，共作长鲸吸百川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"名郡之东门曰永平书一绝","author":"王十朋","text":"鄱水新门号永平，永平何止一鄱城。\n愿言广此平天下，黎庶长无愁叹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"主簿程同年和永平门诗再赋四绝因以赠别 其一","author":"王十朋","text":"迂儒政事只平平，滥守鄱阳十里城。\n赖有同年更同事，公馀时作苦吟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"主簿程同年和永平门诗再赋四绝因以赠别 其二","author":"王十朋","text":"高唱犹嫌二谢平，偏师能破五言城。\n鄱人口诵新门记，已作雷门振大声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"主簿程同年和永平门诗再赋四绝因以赠别 其三","author":"王十朋","text":"才知端如杜下平，异时何止任专城。\n三年俛首栖榛棘，行作冲霄鸾凤声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"主簿程同年和永平门诗再赋四绝因以赠别 其四","author":"王十朋","text":"春尽湖如镜面平，扁舟送别古鄱城。\n相将我亦为行客，征雁来时好寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送春","author":"王十朋","text":"杨花榆荚满天飞，九十风光别我时。\n凫鹜成行报公事，簿书中作送春诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州院狱空赠知录孙听","author":"王十朋","text":"把麾承乏楚邦东，狱及期年始报空。\n顾我自惭无德政，同僚深喜有于公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鄱江楼分韵得月字","author":"王十朋","text":"尊酒相逢人二八，年少壮夫予白发。\n明年何处更登楼，遥望鄱阳江上月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前端午一日会饮鄱江楼十有六人既分韵赋诗又戏成短篇","author":"王十朋","text":"佳节江楼上，同僚共把杯。\n人如舜才子，名半汉云台。\n诗占城南首，音参古磬枚。\n宜添两学士，相约访蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月二十日闵雨","author":"王十朋","text":"仲夏百谷长，中沐群龙分。\n此邦得何龙，行天莫辞勤。\n愿于呼吸间，山川走风云。\n亟下霈然泽，救我心如焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叶枢密言别","author":"王十朋","text":"流落江湖岁月侵，九重侧席念公深。\n汉庭宽大颁纶綍，楚阁清和襆枕衾。\n大壑巨鱼欣复纵，虚舟积羽可能沉。\n乾坤整顿须元老，芝岭柯山未许寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洪景卢以郡酿饮客于野处园赋诗见寄次韵","author":"王十朋","text":"老境厌吏事，归心绕丘园。\n日月忽有夏，炎蒸变春温。\n芝堂孰新酿，谁共论文尊。\n缅怀蓬山旧，情好素所敦。\n殷勤十从事，往扫东坡轩。\n深杯滑琉璃，不比田家盆。\n醉吟到高处，舞月成清欢。\n我独坐空斋，静对忘忧萱。\n萱多忧未忘，香清思犹昏。\n怀君不成寐，两处一声猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡纸赠嘉叟以诗为谢次韵","author":"王十朋","text":"仁义知君学子舆，岂惟词赋似相如。\n剡溪百幅敲冰纸，换得临池小草书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏日四望亭分韵得月字","author":"王十朋","text":"伏日何处游，危亭阴清樾。\n十客同我登，诗兴浩然发。\n四檐山在眼，奚用更拄笏。\n小饮未成醺，天边见新月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵通判喜雨","author":"王十朋","text":"政拙时时费祷求，心忧赤子饿填沟。\n一声霹雳中宵雨，洗出江湖万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐孺子亭","author":"王十朋","text":"一室不暇扫，心期扫天下。\n一榻不妄设，所待必贤者。\n南州杰出士，林泉事潇洒。\n闭门谢弓招，道合不吾舍。\n谁云性少通，得一不为寡。\n豫章岂私交，端欲重宗社。\n汉廷无此贤，忍使遗在野。\n交章荐天阙，聘礼备车马。\n高人竟不屈，清风凛华夏。\n寄声郭有道，一木难支厦。\n肯同樊处士，声名祇虚假。\n鸡酒吊知音，韬光老松槚。\n倘令居孔门，行藏似回也。\n江西今仲举，吏事饰儒雅。\n神交千载友，丹青妙摹写。\n作亭古东湖，鳞鳞万椽瓦。\n序嗤滕阁王，词偪长沙贾。\n佳客从公游，湖光瑩尊斝。\n孺子真可师，世途何土苴。\n行矣浙东西，锄犁各归把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张安国舍人以南陵鄱阳雨旸不同示诗次韵","author":"王十朋","text":"春水平原天可拍，夏日如焚天可拆。\n哀哉农民亦良苦，厌见常旸与常雨。\n去秋鄱阳偶中熟，巨室犹言廪无谷。\n万亩家输数千斛，路旁安得黔敖粥。\n吾君罪己同禹汤，思起傅岩调雨旸。\n暂勤千骑作南伯，要使炎峤无馀殃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又次韵闵雨","author":"王十朋","text":"长夏蚊蝇倦驱拍，忽得缄封手亲拆。\n新诗首及民疾苦，更闵鄱阳境无雨。\n鄱阳假守仁不熟，作郡端如种焦谷。\n匈中剩有愁千斛，阖门百指颜公粥。\n紫微好善嗤弘汤，眉间和气如时旸。\n行归廊庙赞化育，善人宜赏淫人殃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵安国读楚东酬唱集","author":"王十朋","text":"麾把江湖遇列仙，赓酬篇什满鄱川。\n窦家兄弟联珠日，庐阜峰峦夕照天。\n三郡美名俱赫赫，一台遗墨尚鲜鲜。\n紫微妙语题诗后，光艳真能照简编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安国读酬倡集有平生我亦诗成癖却悔来迟不与编之句今欲编后集得佳作数篇为楚东诗社之光复用前韵","author":"王十朋","text":"六逸中无李谪仙，诗筒忽得旧临川。\n枝芳又类燕山桂，马立欣瞻刺史天。\n公似虞臣宜作牧，我惭鼠技滥烹鲜。\n新诗不减颜公咏，贵若山王定不编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵安国读荐福壁间何卿二诗怅然有感","author":"王十朋","text":"金华遽作鬼中仙，叹息真同子在川。\n何逊诗犹在东阁，杜陵家不上青天。\n忠随奏疏留丹阙，字落禅房照碧鲜。\n客过楚东吟楚些，唱酬新集定须编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月二十五日饯安国舍人于荐福洪右史王宗丞来会坐间用前韵","author":"王十朋","text":"尊酒相逢半八仙，鬓丝我类杜樊川。\n江东渭北四方客，楚尾吴头五月天。\n莲社滥陪陶令饮，兵厨聊击陆生鲜。\n待将红药翻阶句，别作鄱阳一集编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵送安国","author":"王十朋","text":"辟谷留侯早得仙，庆钟苗裔福如川。\n少年为佛魁千佛，今日生天作二天。\n西掖代言词俊逸，东湖题壁墨澄鲜。\n此行定有诗千首，莫惜因风寄数编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"易芝山五老亭名曰五峰安国书之因成短篇","author":"王十朋","text":"三秀呈祥处，危亭压众坡。\n眼惊庐阜近，峰类夏云多。\n乔岳神咸会，苍穹顶共摩。\n紫微新铁画，辉映楚江波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵安国题馀干赵公子养正堂堂张魏公所名也并为作铭","author":"王十朋","text":"去岁西来路偶同，一言不肯话飘蓬。\n铭成养正首示我，室坐不欺深念公。\n大盗欲缠遥拱北，群言交乱卒居东。\n可怜未战身先死，贯日精忠化白虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵安国题清音堂","author":"王十朋","text":"堂上清音乐奏仙，洲如孤屿媚中川。\n馀干遥服三苗国，陆羽高飞百越天。\n风过琵琶声不断，水来云锦色长鲜。\n留题重遇张公子，又入诗中第一编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡斋旧有假山暇日命工葺之取石之嵌者繂置山顶汲水筒竹引而激之自顶而下有悬崖飞瀑之状予既以萧洒名斋因镌二字于石戏成古风","author":"王十朋","text":"山从何来石无根，水从何来山无源。\n忽然幻出如自然，群峰崒嵂声潺湲。\n石工貌愚性机巧，两手顷刻成陶甄。\n坐移野景到城郭，解使平地生林泉。\n香炉瀑布名天下，雁荡龙湫更萧洒。\n名山不见典刑存，得趣何须论真假。\n君不见晋公元勋兼盛德，绿野堂前罗涧石。\n又不见行行正直韩退之，汲井埋盆成小池。\n二公匈中有佳致，涧石盆池聊自戏。\n世间万事皆戏耳，何止兹山与兹水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予自饶易夔以七月九日行饶人遮道挽留易轿由间道而去提点何德献相追不及以诗见寄云断桥截镫亦堪怜始信林间别有天微见兵机第一义朱轓暂席广文毡因次其韵","author":"王十朋","text":"误辱鄱阳士庶怜，闭门不许出朝天。\n间行虽乏相如璧，得句全胜子敬毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同官酌别","author":"王十朋","text":"无德于民愧寇恂，断桥留我荷鄱人。\n同僚送别四十里，满酌不辞三数巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"途中寄何德献","author":"王十朋","text":"邂逅江湖两白头，公方东驾我西游。\n韩张呼酒情虽重，孔李通家好未修。\n庆朔诗高魏提点，秋香赋愧范饶州。\n驿筒从此相来往，别后何妨却倡酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿何山孙氏竹轩观张安国题壁因用其韵","author":"王十朋","text":"往来真个及瓜期，见竹还思种竹时。\n今日赋诗添旧集，明朝不是楚东诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望庐山怀鄱阳同官","author":"王十朋","text":"五峰亭上同登日，遥望庐山在杳冥。\n今日庐山真满眼，回头却望五峰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦观八阵图","author":"王十朋","text":"易任夔子国，身犹在重湖。\n梦魂辄先往，临江观阵图。\n奇才盖三国，壮志吞两都。\n惜哉功不遂，英雄为欷歔。\n胡为恍惚间，微茫见规模。\n清时耻谈兵，武侯其戏予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读喻叔奇送行六诗","author":"王十朋","text":"鄱阳同事九十日，尊酒相呼恨不多。\n送别六诗诗似杜，绝胜刘子竹枝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"都昌道中望庐山思故乡","author":"王十朋","text":"肩舆终日在山间，忽见庐山忆雁山。\n我亦无心入莲社，愿随征雁及秋还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过五柳湾","author":"王十朋","text":"出守江湖日念还，又扶衰病入巴山。\n不能早作归田计，愧过渊明五柳湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿栖真寺","author":"王十朋","text":"林间古刹号栖真，高躅难寻晋宋人。\n我正迷途倦奔走，何繇来向此栖身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀鄱阳士民","author":"王十朋","text":"来去鄱阳各有因，却疑行止亦由人。\n此心可鉴惟天日，公论难欺有士民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观渊明画像","author":"王十朋","text":"萧洒风姿太绝尘，寓形宇内任天真。\n弦歌只用八十日，便作田园归去人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]