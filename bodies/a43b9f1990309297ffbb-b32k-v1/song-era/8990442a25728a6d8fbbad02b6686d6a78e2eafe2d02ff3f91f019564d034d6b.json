[{"title":"送蒲霖中舍致仕归阆中","author":"文同","text":"急趋长拜倦劳劳，自笑风埃满绿袍。\n官味十年如水薄，归心一日共云高。\n毫釐已悟蜗争角，文彩须知凤得毛。\n且喜还家收拾在，锦屏山下旧东皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送潘司理秘校 其二","author":"文同","text":"曲栈绕斜谷，钩栏天际分。\n吟鞭摇岭月，倦枕拂溪云。\n好景不关俗，新诗皆属君。\n西南有归客，一一幸相闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送潘司理秘校 其一","author":"文同","text":"已自多时赋式微，五峰佳景梦长飞。\n四年远地为官去，万里高堂喜客归。\n下马便呈新授敕，开箱争认旧缝衣。\n乡人觅次来相贺，莼菜鲈鱼正软肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重过旧学山寺","author":"文同","text":"当年读书处，古寺拥群峰。\n不改岁寒色，可怜门外松。\n有僧皆老大，待客转从容。\n又下白云去，楼头敲暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"面川亭","author":"文同","text":"幽亭最孤绝，直入乱丛间。\n近晚独来此，有谁相与闲。\n卷帘通大野，临槛数前山。\n便欲教携酒，陶然踏月还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夕","author":"文同","text":"池馆萧然夜欲分，满林虫鸟寂无闻。\n风吹松子下如雨，月照荷花繁若云。\n泉作小滩声淅沥，笋成新竹气氤氲。\n清阴正覆吟诗石，更引高梧拂练裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日官舍","author":"文同","text":"省事公多暇，虚心景更长。\n舍书无可乐，就枕不能忘。\n短葛沾肌薄，寒泉沃肺凉。\n何当逢靖节，相与话羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日南园","author":"文同","text":"阴阴乔木下，翠影若云浮。\n满地紫桑椹，数枝黄栗留。\n迎风湖上去，避日竹间游。\n定作今宵雨，绕墙啼晓鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日翠漪堂","author":"文同","text":"湖水碧溶溶，寒漪四望通。\n龟鱼游浩渺，凫鹜下虚空。\n爽气吟窗外，清光钓艇中。\n一襟时自快，多谢北轩风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花","author":"文同","text":"种近短墙边，开临小槛前。\n倚风无限意，笑日有馀妍。\n枝软围深密，苞秾堕碎圆。\n祗应芳树下，时见武陵仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衰晚","author":"文同","text":"衰晚得洋川，劳生只自怜。\n文移供尽日，心力付流年。\n咄咄空书字，便便声昼眠。\n其如昏嫁在，了即赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读渊明集","author":"文同","text":"吏人已散门阑静，公事才休耳目清。\n窗下好风无俗客，案头遗集有先生。\n文章简要惟华衮，滋味醇醲是太羹。\n也待将身学归去，圣时争奈正升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读蒋都官画像记","author":"文同","text":"闻昔妖氛满巴蜀，所临州县偃如风。\n其城陷者尽从贼，以义死之惟有公。\n节与岷山高莫敌，名随皂水注无穷。\n兰台秉笔今谁氏，舍此何由壮史功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陵井喻氏岁寒山居","author":"文同","text":"蕨平处士居山日，手种青松一万根。\n岁月渐深枝尽偃，雪霜虽厚叶仍繁。\n本营胜概逃轩冕，更结清风遗子孙。\n寄语后人须爱护，莫教空有令名存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高堂山兜率寺","author":"文同","text":"孤绝不可状，此山馀旧闻。\n因官多暇日，与客到深云。\n门外一尘断，座中千里分。\n劳生当自去，缭绕下西曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿斗山奉真宫","author":"文同","text":"山形如斗势坡陀，魁枕杓携万尺高。\n近世无人知火枣，当年有客得蟠桃。\n灵蟾尚隐凝琼髓，神鹤常归堕玉毛。\n一夜杉松响天籁，满空疑是奏云璈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿隆平精舍","author":"文同","text":"万木罗青盖，双峰敞翠屏。\n风埃愁客路，钟鼓喜禅扃。\n下马穿蒙密，随僧入杳冥。\n俗襟如见濯，试为泻铜瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄子骏运使","author":"文同","text":"西乡巴岭下，崄道入孱颜。\n使骑到荒驿，野禽啼乱山。\n问民青霭里，访古白云间。\n几日南城路，新诗满轴还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄冯永州","author":"文同","text":"山水永最善，守居闻更优。\n烟云万石古，风月九岩秋。\n几案少俗事，壶觞多雅游。\n无因陪后乘，幽意满湘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄成都赵资政","author":"文同","text":"才承宠诏联公鼎，便谒除书别帝阍。\n万口一词歌盛德，四年三度福遐藩。\n已为魁垒无双士，更入摩诃不二门。\n应笑临邛病痟客，最先参见在江原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄成都监库石屯田远叔","author":"文同","text":"一年同住夹城中，小圃高斋幸见容。\n吟尽物题春唱和，讲穷人事夜过从。\n寻芳待去门前约，访古邀回道上逢。\n别后西楼不堪倚，满川林木暮云重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张郎中","author":"文同","text":"常愧无才动有权，十年乡里但留连。\n养成答飒人应笑，学得支离自谓贤。\n三馆旧游层汉上，一麾今守乱峰前。\n幸逢别驾如张轨，免对苏章说二天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄杨归一","author":"文同","text":"出处久异矣，居常劳所思。\n烟霄惟子未，鬓发已翁为。\n世故岂须问，人生当自知。\n林泉闻幸好，足可乐明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄彦思时在长安言游终南","author":"文同","text":"日日望车马，君当何日还。\n谈谐思衮衮，篇什爱关关。\n大道风埃恶，长河冰雪顽。\n相招早来此，拟欲问南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄夏文州左藏佾 其二","author":"文同","text":"寄语文州守，谋边想甚劳。\n封疆通鸟鼠，种落杂猿猱。\n甲马廉颇少，诗书郤縠高。\n当须办乃事，不用耻弓刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄夏文州左藏佾 其一","author":"文同","text":"翩翩贵公子，佳誉本能文。\n大第辞京辇，高旌拥塞云。\n劝农唐刺史，养士汉将军。\n莫刻和戎誓，朝廷立功勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄景逊","author":"文同","text":"别后西城上，来须到日曛。\n目迎秦塞雁，心过陇山云。\n寡合无如我，高怀少似君。\n相思只相望，徒尔托云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄景孺提刑","author":"文同","text":"江由岩崄地，万木与云齐。\n弭节山中宿，思归夜半啼。\n麝香沾野草，虎迹滑春泥。\n到此须凭酒，何人手可携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄楞严大师","author":"文同","text":"锦官城里寺，一室若云峰。\n水缩秋吟鼎，霜低夜讲松。\n住斋尘入钵，出定藓生筇。\n曾听三摩义，居常梦晓钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题何靖山人隐居","author":"文同","text":"门外铺寒水，墙头立好山。\n先生忘势利，高隐寄中间。\n凫鹜应同乐，烟云已共闲。\n几时能少暇，携酒到松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庶先北谷","author":"文同","text":"路自西溪入，园当北谷开。\n月亭诗作客，雨馆睡为媒。\n摘果衣沾露，寻泉屐渍苔。\n闲居正无事，莫问我频来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚兴","author":"文同","text":"众吏晚已散，西园常访寻。\n覆棋苔阁静，行药草桥深。\n草色晴承屐，松阴密洒襟。\n山蚿欲重赋，倚竹听清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"文同","text":"寒梅引旧枝，映竹复临池。\n朵露深开处，香闻瞥过时。\n凌兢侵腊雪，散漫入春诗。\n赠我岁寒色，怜君冰玉姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清景堂","author":"文同","text":"公外捐尘虑，闲中见物情。\n蕉花红炬密，竹节粉环轻。\n燕泊帘钩语，蜂寻笔架鸣。\n静能知此趣，吃吃笑劳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野径","author":"文同","text":"山圃饶秋色，林亭近晚晴。\n禽虫依月令，药草带人名。\n排石铺衣坐，看云缓带行。\n官闲惟此乐，与世欲无营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食","author":"文同","text":"蜀客寓秦城，寒威怯夜生。\n火床功甚小，酒榼力何轻。\n月外天无色，霜中地有声。\n王章龙具薄，数彻郡楼更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食书事感怀","author":"文同","text":"寥寥官舍静于僧，虽有园亭亦倦登。\n桃杏花阴流似水，图书滋味冷如冰。\n坐观棨戟惭无状，归扫松楸恨未能。\n得报君恩便休去，虞卿前日本担簦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭州南楼","author":"文同","text":"百尺压城端，飞檐欲上抟。\n湖光摇埤堄，山影转栏杆。\n秀野含春煦，乔林拥暮寒。\n回头大岷雪，千仞玉巑岏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"提刑司勋示及瞑禽图作诗咏之","author":"文同","text":"朱华盛发穿疏竹，寒蘖齐枯遍野矶。\n大雪蔽天方乱下，众禽争地各相依。\n非公好事谁能得，此画如今自已稀。\n试待晴明挂轩壁，定开群眼一时飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"揖山阁","author":"文同","text":"一问此孤高，苍苍欲上摩。\n有时临缥缈，尽日对嵯峨。\n绝底秋阴重，危层晚照多。\n无由从隐者，空自愧云萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普州三亭 东溪亭","author":"文同","text":"短彴逶迤渡，高檐夭矫沉。\n波光环堵净，日色綵梁深。\n萍荇翻金鲫，兰苕超翠禽。\n主人公事简，时此照清襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普州三亭 均逸亭","author":"文同","text":"亭宇跨城端，新苔磴道盘。\n风光晴水石，烟景暮林峦。\n簿领仍多暇，宾从每尽欢。\n何由掉尘鞅，聊问借阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普州三亭 碧崖亭","author":"文同","text":"断巘渌溪边，危亭翠壁前。\n轩窗谁是客，诗酒自称仙。\n远壑春藏雨，长波昼起烟。\n吏人休报事，高兴正陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴步西园","author":"文同","text":"急雨正新霁，林端明晚霞。\n松亭临旷绝，竹径入攲斜。\n花落留深草，泉生上浅沙。\n稚圭贫亦乐，一部奏池蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴登北城","author":"文同","text":"积雨已逾月，久妨于此行。\n云山劳梦想，风日幸晴明。\n常爱往来处，尽皆苔藓生。\n一壕新草木，强半不知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登山亭","author":"文同","text":"登临平楚外，徙倚夕阳间。\n归鸟乱飞叶，暮云凝远山。\n行知筋力倦，愁欲鬓毛斑。\n坐久成搔首，疏慵好强颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登山城书事","author":"文同","text":"节物感羁旅，连空生塞阴。\n乱鸿寒渚远，群雀晚丛深。\n霜重泾滩出，烟高陇树沉。\n岁华徒自老，幽愤满登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登邠州城楼","author":"文同","text":"试此望摇落，秋襟成惘然。\n客怀伤薄莫，节物感穷边。\n断烧侵高垒，微阳入晚川。\n年来旧山意，常与雁翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登陵阳云山阁寄上吴尹","author":"文同","text":"云山高阁倚危墙，晚意无穷在渺茫。\n极望不知云几许，满空惟见雁交相。\n与谁把酒邀明月，独自吟诗到夕阳。\n因念平台有佳兴，邹生枚叟奉梁王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答马子山节推见寄","author":"文同","text":"曾陪参画从櫜鞬，文雅当时最盛传。\n玉挂好风横饮簟，翠漪明月漾吟船。\n石渠金马余何者，绿水红莲子尚然。\n好养江边鸿渐翼，诏书非久下菑川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫骝马","author":"文同","text":"翩翩紫骝马，烂烂黄金鞍。\n流水四蹄急，飞星双目寒。\n拥头青玉釳，蔽臆彩丝鞶。\n谁取交州鼓，摸将骨去看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢许判官惠茶图茶诗","author":"文同","text":"成图画茶器，满幅写茶诗。\n会说工全妙，深谙句特奇。\n尽将为远赠，留与作闲资。\n便觉新来癖，浑如陆季疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢夏文州寄金线狨","author":"文同","text":"天地生奇兽，朝廷宠近臣。\n覆鞍须用此，投网为何人。\n梨栗恩虽厚，云山梦想频。\n烦君远相惠，时为一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢黄森惠诗并草书","author":"文同","text":"南䣢黄夫子，生平气凛然。\n吟诗旧有癖，写字近方颠。\n可惜空山老，须为后世传。\n兰溪修禊否，愿续永和年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈济院双楠","author":"文同","text":"双楠高耸绿氤氲，密叶长柯荫四邻。\n佛现宝幢经几劫，天开云帐待何人。\n护持必有诸贤圣，触犯宁无恶鬼神。\n付嘱寺僧常洒扫，莫令向下有纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴山月","author":"林之奇","text":"高松漏疏月，落影如画地。\n徘徊爱其下，夜久不能寐。\n怯风池荷卷，病雨山果坠。\n谁伴予苦吟，满林啼络纬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"猿","author":"文同","text":"岷岭高无敌，来从第几层。\n攀缘殊不倦，趫捷尔诚能。\n晚啸思危石，晴悬忆古藤。\n王孙非汝类，只可以文憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起","author":"文同","text":"寥寥公馆静，门掩似山家。\n竹簟屡移枕，石盘频浸花。\n闲多新得策，事少早休衙。\n一觉高舂睡，谁来伴试茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"稠桑见荆山","author":"文同","text":"万岭郁丛丛，盘云气势雄。\n纵横谁画笔，屈折自屏风。\n倒树出断外，乱云生掩中。\n无由更停马，此意恨如蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬仲几秦州道上见寄","author":"文同","text":"送子入秦处，纷纷黄叶间。\n孤舟渡野水，疋马转遥山。\n明月每夜望，清风何日还。\n新诗慰牢落，为一破愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦鸡","author":"文同","text":"高原濯濯弄春晖，金碧冠缨綵绘衣。\n石溜泻烟晴自照，岩枝横月夜相依。\n有时勃窣盘跚舞，忽地钩辀格磔飞。\n寄语人间用矰缴，瑶台鸾凤好同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉川道中寄周正孺","author":"文同","text":"草木春深后，山川雨过时。\n清佳常满目，衰倦敢忘诗。\n好尚旧若此，飘零今比谁。\n争如画堂上，日日听新词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墅居","author":"文同","text":"不复入城市，乱山围一村。\n云霞供几席，水石佐琴樽。\n病久筋力缓，眠多头目昏。\n无人来谷口，苔藓上松门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墅居","author":"文同","text":"林下览清旷，此怀殊不羁。\n散行轻帻便，独酌小瓯宜。\n自可追三乐，何须作五噫。\n世情歌笑外，纷扰竟何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"誓鬼碑","author":"文同","text":"正一受天箓，腰垂神虎章。\n群魔狱幽隐，秘篆刻青苍。\n故事骇前志，馀威惊大荒。\n谁能识奥诀，禹步学魁罡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静林诗僧已老","author":"文同","text":"七十吟中老，清风满旧林。\n倚筇秋岸远，围衲夜房深。\n未得云空在，将成月已沉。\n生平苦如此，谁是识师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静庵","author":"文同","text":"问此初谁筑，经营羡尔能。\n依深还巨木，就荫覆高藤。\n坐与境同寂，来无人可憎。\n一床黄卧具，茂灌本如僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题凤凰山后岩","author":"文同","text":"此景又奇绝，半空生曲栏。\n蜀尘随眼断，蕃雪满襟寒。\n涧下雨声急，岩头云色乾。\n归鞍休报晚，吾待且盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题何靖山人隐居二首 其二","author":"文同","text":"因循失计下青山，却恨溪云占断闲。\n黄卷圣贤忻对语，青云岐路祗低颜。\n月墙槐影侵阶暗，雨槛秋花满目斑。\n自爱萧条真吏隐，心清不累有无间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]