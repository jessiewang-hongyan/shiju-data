[{"title":"读三学士人论事三书 其一","author":"戴复古","text":"邦计伤虚耗，边民苦乱离。\n诸公事缄默，三学论安危。\n灾异天垂戒，脩为国可医。\n传闻上元夜，绝似太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读王幼学上殿劄子","author":"戴复古","text":"才到朝廷被论归，孤忠幸有九重知。\n神医能识未苏病，国手难翻已败棋。\n四海争传治安策，诸公如在太平时。\n老夫怀抱缘何事，未到秋来早自悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读严粲诗风撼潇湘覆江空雪月明以其一联隐括为对","author":"戴复古","text":"笔端有神助，句法自天成。\n风撼潇湘覆，江空雪月明。\n苦吟非草草，妙趣若平平。\n李杜诗坛上，为君题姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读改元诏口号 其三","author":"戴复古","text":"国以人为重，人惟德可招。\n九重方厉政，诸老尽归朝。\n盛事追三代，清风动百僚。\n切闻天上语，欢喜到渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读改元诏口号 其二","author":"戴复古","text":"喜见新除目，焚香洗眼看。\n老儒居翰苑，正士作台官。\n有道为时用，非才处位难。\n寄声崔与李，催促到长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读改元诏口号 其一","author":"戴复古","text":"伏读改元诏，仍观拜相麻。\n竞传新政事，方见好官家。\n雪作丰年瑞，梅开近腊花。\n路逢江上客，立马问京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读放翁先生剑南诗草","author":"戴复古","text":"茶山衣钵放翁诗，南渡百年无此奇。\n入妙文章本平澹，等闲言语变瑰琦。\n三春花柳天裁剪，历代兴衰世转移。\n李杜陈黄题不尽，先生模写一无遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭外翁","author":"戴复古","text":"郭外生涯少，城中籴米归。\n种花无处卖，挑菜入篮稀。\n风撼倾欹屋，寒生蓝缕衣。\n此翁何所乐，谈笑傲轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭伯秀约联骑春游不去有诗","author":"戴复古","text":"心老寻春懒，年衰跨马难。\n便能相强去，未必有真欢。\n独酌三杯妙，高眠一枕安。\n好花如可折，觅取数枝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都下书怀","author":"戴复古","text":"京华作梦十年馀，不道南山有弊庐。\n白发生来美人笑，黄金散尽故交疏。\n明知弄巧翻成拙，除却谋归总是虚。\n出处古人都说尽，功名未必胜鲈鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都下书怀","author":"戴复古","text":"半月不把镜，羞看两鬓尘。\n读书增意气，携刺减精神。\n道路谁推毂，江湖赋采蘋。\n从来麋鹿性，那作帝乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都中书怀二首 其二","author":"戴复古","text":"雪化晴檐雨，炉烘冻壁春。\n穷犹恋诗酒，懒不正衣巾。\n寂寞安吾分，奔驰失我真。\n枯桐就煨烬，容有赏音人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都中书怀二首 其一","author":"戴复古","text":"醉卧长安市，思归东海涯。\n瓶馀残腊酒，梅老隔年花。\n日与愁为地，时凭梦到家。\n乡书三两纸，一读一咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都中次韵申季山","author":"戴复古","text":"车马喧临十二门，乐从闲处度朝昏。\n诗书岂为功名重，轩冕何如道谊尊。\n志士不能行所学，明君亦或讳忠言。\n世间事事如人意，未必商山有绮园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都中怀竹隐徐渊子直院","author":"戴复古","text":"手携漫刺访朝官，争似沧洲把钓竿。\n万事看从今日别，九原叫起古人难。\n菊花到死犹堪惜，秋叶虽红不耐观。\n多谢天公怜客意，霜风未忍放深寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅世 其一","author":"戴复古","text":"一懒一愚兼一痴，从教智士巧能为。\n坦途失脚溪山险，暗室萌心天地知。\n江水长流无尽意，夕阳虽好不多时。\n老夫阅遍人间事，欲和寒山拾得诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅世 其二","author":"戴复古","text":"积镪多金生怨尤，一温饱外更何求。\n自甘韬遁陶元亮，不爱赢馀马少游。\n何取累累兼若若，终成莫莫与休休。\n花前适意三杯酒，万事忘机对白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅四家诗卷","author":"戴复古","text":"阅尽四家诗卷子，自然优劣在其中。\n石龟野鹤心相合，菊涧花翁道不同。\n鸣凤翱翔上霄汉，乱蝉萧瑟度秋风。\n一篇论尽诸家体，忆著当年巩睡翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅旧稿见乔丞相诗跋因成此诗","author":"戴复古","text":"三十年前旧诗册，两行钧翰俨如新。\n自甘白屋为寒士，敢说黄扉有故人。\n五雨十风勤燮理，九州四海费经纶。\n年踰八十貂蝉贵，不负明君恐负身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪虞使君登岳阳楼","author":"戴复古","text":"片帆飞过洞庭来，百尺巍巍水面开。\n疑泛灵槎上河汉，如从弱水到蓬莱。\n钧天广乐无闻矣，袖剑仙人安在哉。\n物物尽随波浪去，君山一点独崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶见飞蝶追思旧游录之","author":"戴复古","text":"早被春情误，浑身著粉衣。\n最宜花上见，解向梦中飞。\n蜂媵为游伴，蛛丝设祸机。\n滕王小图画，一一造精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿农家","author":"戴复古","text":"宿此屋头阁，瓦窗通月明。\n夜深鸲鹆噪，人静桔槔声。\n村落有古意，田园关客情。\n儒衣成底事，所得是虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿农家","author":"戴复古","text":"门巷规模古，田园气味长。\n小桃红破萼，大麦绿衔芒。\n稚犬迎来客，归牛带夕阳。\n儒衣愧飘泊，相就说农桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄山台赵庶可二首 其二","author":"戴复古","text":"顷上山台谒，临行辱赠诗。\n相思寸心在，莫讶尺书迟。\n好月登楼夜，清秋落木时。\n见君花萼集，梦到谢公池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄山台赵庶可二首 其一","author":"戴复古","text":"天族文章士，会稽山水州。\n地灵钟秀异，人物信风流。\n要自用卿法，如何与妇谋。\n功名须早计，莫为海云留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄广西漕陈鲁叟诰院","author":"戴复古","text":"回首元龙百尺楼，一时诗酒记同游。\n好山历历在人眼，流水滔滔任客舟。\n归雁欲从何处去，落花恨不为春留。\n锦囊佳句无人问，自别君来白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄永嘉太守赵茂实 其二","author":"戴复古","text":"身为吟诗瘦，家因好谊贫。\n如何贤太守，不念可怜人。\n橘井谁知处，桃源莫问津。\n秋风吹白发，沧海老垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄永嘉太守赵茂实 其一","author":"戴复古","text":"龚黄古贤牧，政事见于今。\n疾恶风霜手，活人天地心。\n躬行循吏传，时作谢池吟。\n我欲依刘表，常忧老病侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄节斋陈叔方寺丞","author":"戴复古","text":"今时古君子，玉立众人间。\n再世黄叔度，三生元鲁山。\n把麾浑细事，忧国欲愁颜。\n恨不频相见，空书谩往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄寻梅","author":"戴复古","text":"寄声说与寻梅者，不在山边即水涯。\n又恐好枝为雪压，或生幽处被云遮。\n蜂黄涂额半含蕊，鹤膝翘空疏带花。\n此是寻梅端的处，折来须付与诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄朱仲是兼佥","author":"戴复古","text":"光阴日夜催吾老，已作鸡皮鹤发翁。\n万事装成百年梦，五行注定一生穷。\n残花但有凋零分，枯木难沾造化功。\n若见黄堂烦寄语，何如停我雪楼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄耒阳令严坦叔","author":"戴复古","text":"士元堂上坐，千载仰清规。\n百里宜民政，数篇怀古诗。\n江连杜甫墓，水落蔡伦池。\n公暇登临处，宁无忆我时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴明辅秘丞 其一","author":"戴复古","text":"吾乡幸有吴夫子，星斗网罗文字胸。\n百鸟收声听鸣凤，千山落木秀孤松。\n旁通沧海江山水，高压云城帢帻峰。\n每见一斑三叹息，白头未得奉从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴明辅秘丞 其二","author":"戴复古","text":"七十七翁犹眼明，三台星畔见奎星。\n文章有气吞馀子，议论无差本六经。\n愧我不能攀逸驾，得君自足振颓龄。\n玉溪常与荆溪接，分得馀波到石屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄抚州楼使君","author":"戴复古","text":"梦上江西江上船，行随五马五峰前。\n临川太守贤无敌，攻愧先生学有传。\n佳政可书循吏传，斯民共乐太平年。\n不知拟岘台前景，公暇清吟得几篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄沈庄可","author":"戴复古","text":"无山可种菊，强号菊山人。\n结得诸公好，吟成五字新。\n红尘时在路，白发未离贫。\n吾辈浑如此，天公似不仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄建康留守制使赵用父都丞侍郎 其一","author":"戴复古","text":"蛮貊闻名姓，当今有此人。\n片心天共广，一笑物为春。\n花满金陵路，风清玉塞尘。\n九重方简注，四海望经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄建康留守制使赵用父都丞侍郎 其二","author":"戴复古","text":"燕许文章笔，片言轻万金。\n先人十诗序，孝子一生心。\n入手方为宝，三年等到今。\n九泉应有望，取璧照山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄郑润甫提干","author":"戴复古","text":"吾乡有佳士，官小患才多。\n文可登词苑，直宜居谏坡。\n春风能活物，砥柱不随波。\n客里喜相遇，飘零柰我何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄南昌故人黄存之宋谦甫二首 其二","author":"戴复古","text":"久客归来后，家如旧日贫。\n青山何处隐，白发也愁人。\n畎亩一生事，乾坤百病身。\n时无嵇吕驾，相忆莫相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄南昌故人黄存之宋谦甫二首 其一","author":"戴复古","text":"谦甫多才思，存之重谊襟。\n一书愁话别，千里梦相寻。\n南浦扁舟上，东湖万柳阴。\n旧时行乐处，何事不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄复斋陈寺丞二首 其二","author":"戴复古","text":"长忆西湾系小舟，野人曾伴使君游。\n夜浮星子邀明月，雨对庐君说好秋。\n坐拥红妆磨宝砚，醉歌赤壁写银钩。\n当时一段风流事，翻作相思一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄复斋陈寺丞二首 其一","author":"戴复古","text":"岂说从来用处难，出乘五马看庐山。\n凤凰览德下千仞，虎豹憎人上九关。\n持论太高天动色，忧时未老鬓先斑。\n平生风节谁其似，汲黯朱云伯仲间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄姚楚州 其一","author":"戴复古","text":"人材当世用，缓急敢辞难。\n身挟天威重，名惊贼胆寒。\n临机一著妙，入境众心安。\n闻已诛元恶，仍须问祸端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄姚楚州 其二","author":"戴复古","text":"庸将几误国，流民亦弄兵。\n康时仗豪杰，了事是功名。\n车马长淮路，貔貅细柳营。\n山阳还旧观，并使虏尘清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵茂实大著二首 其二","author":"戴复古","text":"词臣工笔墨，亦足致功勋。\n细草平戎策，兼为谕蜀文。\n一言关治乱，千载有知闻。\n应笑垂纶叟，愁吟对海云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵茂实大著二首 其一","author":"戴复古","text":"久坐图书府，方登著作庭。\n人知才可敬，公以德为馨。\n议论参诸老，文章本六经。\n省中相别后，夜夜望奎星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵漳州话病","author":"戴复古","text":"听雨无聊赖，高眠独掩扉。\n塞鸿书不到，海燕约同归。\n吾道关通塞，人情有是非。\n荆州相别后，王粲更谁依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵德行","author":"戴复古","text":"平生幸甚识诸公，未免归为田舍翁。\n诗稿敢求经御览，客身自笑坐天穷。\n肯将钓手遮西日，独耸吟肩诉北风。\n枉使西山有遗恨，不能置我玉堂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄项宜甫兼简韩右司","author":"戴复古","text":"匆匆不暇去相违，草草吟成送别诗。\n千里江山客行远，三秋风雨桂开迟。\n安居但欲无公事，举枉终须有直时。\n若见右司烦寄语，世间公道要扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄栗斋巩仲至","author":"戴复古","text":"几度观朝报，差除不到君。\n山林自台阁，文字即功勋。\n吟苦孟东野，潜深杨子云。\n一官虽偃蹇，千载有知闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄梅屋赵季防县尉","author":"戴复古","text":"畴昔交游密，暌违岁月多。\n石屏今老矣，梅屋病如何。\n世路生荆棘，家山足薜萝。\n共寻深处隐，此计莫蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄清流王令君","author":"戴复古","text":"朴直存吾道，一心唯向公。\n知非巧宦者，直有古人风。\n行志非为矫，洁身能固穷。\n如何有廉吏，不入荐书中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄虚斋赵侍郎 其二","author":"戴复古","text":"灾异天垂戒，安危事可知。\n试将黄雨證，请问白云司。\n对客论孤愤，伤时赋五噫。\n醉中忘万虑，安得酒如池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄虚斋赵侍郎 其一","author":"戴复古","text":"老眼开还阖，愁怀醉不醒。\n乾坤多变故，人物晓天星。\n药石匡时切，蓍龟见事灵。\n得公十数辈，亦足壮朝廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄湖州杨伯子监丞","author":"戴复古","text":"宛如公干卧漳滨，枕上穷吟过一春。\n遣病每怀诗眷属，访医因问药君臣。\n钻龟小卜占灾数，览镜羸形类别人。\n寄语霅川贤太守，新诗莫厌话愁频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄韩仲止","author":"戴复古","text":"何以涧泉号，取其清又清。\n天游一丘壑，孩视几公卿。\n杯举即时酒，诗留后世名。\n黄花秋意足，东望忆渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄镇江王子文总卿","author":"戴复古","text":"一代文章手，官如水样清。\n三军皆饱德，诸将共谈兵。\n铁瓮横天立，金山压浪平。\n北人向南望，□□月分明。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常宁县访许介之途中即景","author":"戴复古","text":"竹径入茅屋，松坡连菜畦。\n深潴沤麻水，斜竖采桑梯。\n区别邻家鸭，群分各线鸡。\n行人来少憩，假道过东溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得古梅两枝","author":"戴复古","text":"老干百年久，从教花事迟。\n似枯元不死，因病反成奇。\n玉破稀疏蕊，苔封古怪枝。\n谁能知我意，相对岁寒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"族侄孙子荣之子神童颜老不幸短命而死哭之不足三诗以悼之 其二","author":"戴复古","text":"昨应童科日，群儿立下风。\n丰姿倾众目，文采动诸公。\n两耳能兼听，六经皆暗通。\n相期到杨晏，有始柰无终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"族侄孙子荣之子神童颜老不幸短命而死哭之不足三诗以悼之 其一","author":"戴复古","text":"亘古英灵在，颜回有后身。\n年才十三岁，才过万千人。\n学到由天悟，文高见理真。\n再生仍再夭，无路问鸿钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春次韵","author":"戴复古","text":"酒醒愁难醒，春归客未归。\n鶑啼花雨歇，燕立柳风微。\n世路多殊辙，人生贵识机。\n低头饱一粟，仰首愧云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚望怀长沙故人","author":"戴复古","text":"却扇清风起，楼头坐晚凉。\n青山连远水，绿树带斜阳。\n客路伤离别，人情果在亡。\n定应今夜梦，随月到潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望花山张老家","author":"戴复古","text":"元从边上住，来此避兵兴。\n麦麨朝充食，松明夜当灯。\n蔽门麻菶菶，护壁石层层。\n老妪逢人哭，吾儿在谢陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅","author":"戴复古","text":"孤标粲粲压群葩，独占春风管岁华。\n几树参差江上路，数枝装点野人家。\n冰池照影何须月，雪岸闻香不见花。\n绝似林间隐君子，自从幽处作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"戴复古","text":"细把南枝看，百花无此奇。\n夜深钟月魄，□□□□□。\n古树龙其似，寒香蝶不知。\n幽兰开亦早，二妙喜同时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]