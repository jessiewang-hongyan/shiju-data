[{"title":"叙伦五言二十首 其二","author":"刘克庄","text":"千古灵胥怒，惟知有伍奢。\n安知崇伯子，北面事重华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叙伦五言二十首 其一","author":"刘克庄","text":"杞辱中丞世，歆臣二姓廷。\n如何出腹子，反不以螟蛉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叙伦五言二十首 其五","author":"刘克庄","text":"季历并公旦，均为未尽伦。\n吾评千万世，两个采薇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叙伦五言二十首 其八","author":"刘克庄","text":"二王与二阮，尊幼自相推。\n却恐外人笑，儿痴叔亦痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城南","author":"刘克庄","text":"濒江多海物，比屋尽闽人。\n四野方多垒，三间欲卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客问宗旨一首","author":"刘克庄","text":"万物泛观皆我闼，诸君何事入吾裈。\n不须苦问侬宗旨，醉里闻之洛诵孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其四","author":"刘克庄","text":"先帝宫人总道妆，遥瞻陵柏泪成行。\n旧恩恰似蔷薇水，滴在罗衣到死香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其三","author":"刘克庄","text":"一夜秋风入碧梧，蝉声永巷月华孤。\n几回梦里羊车过，又是银床转辘轳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其二","author":"刘克庄","text":"凉殿吹笙露满天，木犀花发月初圆。\n君王少御珊瑚枕，多就宫人玉臂眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词四首 其一","author":"刘克庄","text":"出海新蟾玉半钩，风翻荷荡起栖鸥。\n女郎定有穿针约，偷看明河记立秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"封邑","author":"刘克庄","text":"发似芦花面削瓜，躬圭锦袄忽高华。\n愿还封邑九百户，小筑茆茨三两家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至海丰","author":"刘克庄","text":"渔盐旧俗惯恬熙，兵火新民脱乱离。\n石路树阴三十里，今犹髣髴太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日二首 其二","author":"刘克庄","text":"隙地新锄一径通，野中手自植芳丛。\n生来不惯游金谷，屋角花开也自红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日二首 其一","author":"刘克庄","text":"睡起无人小院空，南华一卷磬声中。\n鼻端老去齐香臭，分别柑花是晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其五","author":"刘克庄","text":"晓风细细雨斜斜，僝僽书生屋角花。\n想见水南僧寺里，一株落尽病山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其四","author":"刘克庄","text":"老懒何心更出嬉，闭门终日读陶诗。\n湘南二月花如扫，恰似扶疏绕屋时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其三","author":"刘克庄","text":"归到城门欲发更，马头惟有暮鸦迎。\n小窗了却观书课，几首残诗旋补成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其二","author":"刘克庄","text":"步入西峰不见人，数声涧鸟自啼春。\n下山欲与唐碑语，先遣奴兵细拂尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日五首 其一","author":"刘克庄","text":"眼边桃李过匆匆，镜里衰颜岂再红。\n久觉胃寒疏建焙，新因血热戒郫筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱四首 其四","author":"刘克庄","text":"清明未雨下秧难，小麦低低似剪残。\n穷巷萧然惟饮水，家童忽报井源乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱四首 其三","author":"刘克庄","text":"屋山无笋圃无蔬，釜冷樽空客至疏。\n说与厨人稀作粥，老夫留腹要盛书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱四首 其二","author":"刘克庄","text":"去冬玉塞静无埃，春雪虽迟亦压灾。\n大士送归天竺去，相公宣入浙江来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱四首 其一","author":"刘克庄","text":"一春闵雨动龙颜，晓殿权停贺雪班。\n林下散人看邸报，也疏把酒废游山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴","author":"刘克庄","text":"春阴欺得病夫身，偶值晴天一欠伸。\n客舍无谁相管领，半檐红日苦留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱忽雨五绝 其一","author":"刘克庄","text":"秧愁晴暴死，花怕雨摧残。\n野老非常惧，天公不自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱忽雨五绝 其四","author":"刘克庄","text":"周匝荒原遍，延缘断港通。\n马鬃渠有力，龙骨尔何功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱忽雨五绝 其三","author":"刘克庄","text":"雨似黄流决，云如黑汁翻。\n未言丰九扈，已觉饱千村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春旱忽雨五绝 其二","author":"刘克庄","text":"乐岁何尝饱，春阴忽又晴。\n一之其可再，四者每难并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柬春谷工部","author":"刘克庄","text":"假使富埒国，何如贫在家。\n尚存侬汉札，宁夺我齐瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳","author":"刘克庄","text":"静是无憀动是狂，秋蝉两两抱斜阳。\n不知才思能多少，瘦得腰肢似沈郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉州南郭二首 其二","author":"刘克庄","text":"海贾归来富不赀，以身殉货绝堪悲。\n似闻近日鸡林相，祇博黄金不博诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉州南郭二首 其一","author":"刘克庄","text":"闽人务本亦知书，若不耕樵必业儒。\n惟有桐城南郭外，朝