[{"title":"寄燕山帅幕家侄季高一首","author":"刘一止","text":"畴昔江湖自在身，而今骑马犯边尘。\n宁无楚尾吴头梦，历遍燕南赵北春。\n壮士似渠终有遇，衰年如我尚谁亲。\n屈州抑县不伸里，老此嵚嵚可笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禹庙一首","author":"刘一止","text":"苗山风驭日翩翩，人道桐棺葬此巅。\n今事独闻鸦种麦，故村不见鸟耘田。\n远忧边塞清无日，更望仓箱屡有年。\n收揽封疆归禹贡，忍看兵气污山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢会稽守翟内相临学行乡饮酒之礼","author":"刘一止","text":"清晓传呼振戟衣，泮林云日炫旌旗。\n风尘贴妥投戈后，色笑雍容劝学时。\n先世流芳今有继，圣衷图旧正畴咨。\n王褒愿草得贤颂，可但中和宣布诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵方允迪秘监会稽相遇怀吴兴旧游二首 其一","author":"刘一止","text":"故山畴昔奉英游，老去功名失路头。\n江海一官如许冷，田园三载不知秋。\n谢公塘外千峰紫，何楷庐边一径幽。\n心折少陵存殁句，恨无酒力破劳愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵方允迪秘监会稽相遇怀吴兴旧游二首 其二","author":"刘一止","text":"鉴湖列嶂自天开，云色岚光入酒杯。\n忽遣同游有陶谢，故应交契拟陈雷。\n他乡日日典衣醉，公事时时牵马来。\n要买扁舟穷胜绝，共追樵径晚风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"携家从允迪借居鸬鹚源上沈必先侍御有诗宠其行次韵并呈二公二首 其一","author":"刘一止","text":"飘零暮景今如许，惭愧高人久卧庐。\n好客儿童总欢喜，多情草木自扶疏。\n百年梦幻真何有，一壑风烟尚借居。\n寄谢南台温御史，此身休戚正关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"携家从允迪借居鸬鹚源上沈必先侍御有诗宠其行次韵并呈二公二首 其二","author":"刘一止","text":"向来多病更多忧，命与谁谋出怨仇。\n坐念甘泉方避暑，不知楚泽又悲秋。\n长蛇肆毒心犹在，战马何时鞚暂休。\n横榻故人身卫主，素书能复讯侬不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵呈允迪秘监江子我郎中二首 其一","author":"刘一止","text":"二纪风埃长作客，了知身世是蘧庐。\n老来诗酒都无味，乱后交亲未肯疏。\n曾见雄风追楚赋，尚堪雌霓读郊居。\n愿公先卜嵌岩隐，秦利宁忘郑国渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵呈允迪秘监江子我郎中二首 其二","author":"刘一止","text":"异时畎亩不忘忧，避俗今犹若避仇。\n直指威声曾震岳，封章义气欲横秋。\n诗成故客知无敌，酒尽凭谁为起谋。\n岁晚相逢山在眼，从公脚历颇能不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵必先侍御和郑维心忆梅并寄维心","author":"刘一止","text":"紫梅溪上春先到，馀不沙边草未芳。\n五字真曾赋桑落，四弦犹忆调枫香。\n雪中孤艳应愁绝，竹外斜枝不掩藏。\n永望佳人在空谷，此时幽独未须伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵寄沈次律学士","author":"刘一止","text":"溪上青云覆短墙，杖藜谁共掇幽芳。\n忽惊候馆梅花破，想见山斋竹叶香。\n倦客鬓丝今点染，使君心事独韬藏。\n何当归赴春盘约，苦苣嘉蔬未足伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵维心赋次律见一亭二首 其一","author":"刘一止","text":"向来金埒与铜山，可是无田未得闲。\n纸上功名追逸景，镜中心事迫摧颜。\n溪云惯作多时别，陇月今迎一个还。\n始信柯田梨枣地，不令榛棘有遗删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵维心赋次律见一亭二首 其二","author":"刘一止","text":"循除春水渐淙淙，心静魔军久已降。\n未省芳菲谁是伴，不妨鹦燕自成双。\n眼中浊酒倾如海，门外清溪欲拟江。\n会见扶藜添一老，共听疏竹响风窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵维心赴次律赏芍药一首","author":"刘一止","text":"岩前红药媚深幽，更为馀春一笑留。\n畴昔邹枚俱倦客，而今陶谢得同游。\n真香雨裛来无尽，妆艳风熏喜欲浮。\n未羡木奴千户比，主人原是醉乡侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵维心赠葛鲁卿待制求花栽一首","author":"刘一止","text":"此日宁无健步移，春前行近着花时。\n故园乐地今馀几，小县风光客不知。\n剩买名裁令乱眼，却嫌芳思只撩诗。\n属公归赋丹青手，问圃寻农独我宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢叔才相过夜话戏成一首","author":"刘一止","text":"七年诗酒恨难同，未省相看作么容。\n多病襄阳长瑟缩，古心冬夜更龙钟。\n已知昔者非今者，莫问渠侬胜我侬。\n手剪西窗深夜烛，细听吴语话心胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄云门长老持公一首","author":"刘一止","text":"梦境清游记昔曾，而今双鬓已鬅鬙。\n此生有分寻云水，到处逢人说葛藤。\n紫芋波棱真在眼，青鞋布袜未输僧。\n会投枯木堂中老，只恐诗情罢不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宋希仲贻故人虞仲容一首","author":"刘一止","text":"乱前交旧今馀几，道故伤时得涕零。\n门外溪山无赖碧，眼中须鬓可怜青。\n十年持橐气横出，三斗朝天心独醒。\n却喜元龙豪放在，不妨下马索银瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送希仲出守三衢一首","author":"刘一止","text":"临别溪山眼重开，秋风扬旆更悠哉。\n平生气概今逾壮，一郡清平欲挽回。\n丧乱有谁谈旧事，论思此日要真才。\n公行勿亟朝天路，帝有甘泉密诏来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄怀王元渤舍人一首","author":"刘一止","text":"倦飞鸾省戢脩翎，乞与云山作卧屏。\n醉里书床堆束笋，梦馀楸局见稀星。\n君心傥似当时赤，吾发应无耐久青。\n老手尚堪驱使在，会持归楫到溪亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林懿成检正见贻次韵谢之林乃同年","author":"刘一止","text":"集英唱第偶追攀，老着青衫独汗颜。\n富贵逼公那得谢，云泉招我久应闲。\n鸾台看展经纶手，鳌禁行趋供奉班。\n黄发故人空跂想，应无春梦到林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将如会稽用允迪韵留别子我诸公一首","author":"刘一止","text":"对酒休悲落木秋，霜花犹足当传筹。\n每怜别赋空多感，晚信离骚并是忧。\n盏底圣贤何足论，眼中泾渭正争流。\n时危忍袖经纶手，行见聘书如鹤头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送方务德提干赴官浙西一首","author":"刘一止","text":"二十年前湖海旧，而今人物粲琅玕。\n文章自袭家风美，骨相仍无父客寒。\n会有忠诚能贯日，不应漫浪懒为官。\n他年鹓鹭行中见，傥似鸬鹚谷里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵沈必先尚书见别一首","author":"刘一止","text":"翩翩旗尾破新晴，颇似龙驹脱在坰。\n再上封章辞雨露，故令高节焕丹青。\n卿云媚日怀仙隐，白鹭迎舟宿晚汀。\n预想山斋春酒熟，可无残梦到南屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅子骏右司见贻一首","author":"刘一止","text":"大旆华镳昼掩扉，松门沙步带山围。\n循除涨水春来急，释峤孤云懒后归。\n试看青鞋缘磴道，不妨野服坐苔矶。\n应嗟客路风尘暗，绕树惊乌未得依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵无言兄卜筑二首 其一","author":"刘一止","text":"求田问舍岂徒为，晚悟前言不我欺。\n地占玉杯初应卜，门临苕水宛分枝。\n乡关怪客归何早，圣主思贤降不迟。\n磊落胸中三万字，不应无意拯时危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵无言兄卜筑二首 其二","author":"刘一止","text":"石枕方床绿浪藤，清谈散带似怀冰。\n蔬盘尚杂水中蟹，羽翣莫挥瓜上蝇。\n五斗为贫真世业，一廛归隐岂人能。\n冥鸿万里今何慕，应笑饥飞侧翅鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张仲宗判监别近三十年经由馀不访余有诗次其韵","author":"刘一止","text":"乱前犹省当时事，乱后浑如隔世人。\n得见升平且欢喜，莫将心念到亨屯。\n衔杯倘办中山醉，觅句谁如小庾新。\n三十年前痴半黠，相逢终不忘天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵沈次律家并蒂芍药一首","author":"刘一止","text":"习家池馆酒如淮，为破幽人一日斋。\n前庑芳菲骈蒂萼，后堂莺燕啸朋侪。\n忽惊暗绿将成幄，却喜双红欲缀钗。\n草木会为门户庆，而今兰玉已当阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵牧庵禅师持公见贻一首","author":"刘一止","text":"衲底摩尼直万金，半生空探九渊寻。\n波离忏罪何名罪，老可安心不见心。\n碧涧寒泉流自古，斋厨煮菜味常今。\n牧庵已断人牛迹，纯白何妨黑半侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑禹功见贻一首","author":"刘一止","text":"当年负笈京华客，振臂论交法从班。\n何武诵诗来蜀郡，士龙持论出云间。\n杯觞引满风流甚，岁月惊心昨梦还。\n短楫未妨相访觅，要看拄颊面西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵徐季山学正释奠先圣之作","author":"刘一止","text":"阙里躬祠通古昔，升平礼乐信光明。\n威仪复见周多士，迂鄙何求汉两生。\n佩委霜侵裳绣冷，庠开风振戟衣鸣。\n使君肃穆神心格，更看雍容佐国衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴兴守到官见贻一首","author":"刘一止","text":"步武初辞玉笋中，旌麾疑是到珠宫。\n窗间岩岫如争入，笔下云烟洗不空。\n千里喜深车后雨，一堂仁浃扇时风。\n宾筵浪许陪真赏，底用蹒跚一秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴兴守雨中即事一首","author":"刘一止","text":"雨槛风檐欲垫巾，护花常恐减青春。\n融怡已复生頩颊，料峭真应恕老人。\n睡鸭吹香空结恋，远峰攒碧似凝颦。\n野棠泪湿愁如许，半面徐妃不受匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵春日书怀二首 其一","author":"刘一止","text":"居士而今有底忙，生涯草草度年芳。\n平林渐见蔫红委，野店初开煮酒香。\n尚有佳人来得得，不甘春事去堂堂。\n胜游早晚追千骑，更看挥戈驻日光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵春日书怀二首 其二","author":"刘一止","text":"水面红云次第铺，东君未肯向人疏。\n兴高碧嶂千寻外，春在黄堂一笑馀。\n只怕玉醅浮盏斝，不嫌花片落襟裾。\n公归行侍甘泉宴，留得新诗锦不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴兴纪事一首","author":"刘一止","text":"怀绂初辞玉帝宫，白蘋洲在乱云中。\n劝耕汉守宣恩诏，卖剑吴侬袭古风。\n花好未应惭洛浦，酒香何羡过新丰。\n他年图画宾筵胜，锦瑟傍边有病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九日四首 其一","author":"刘一止","text":"九日佳名今古重，凤城秋色正明楼。\n厨供清酿香浮袂，恩赐黄花忆满头。\n千里风烟殊未恶，五亭吟啸不应休。\n明年归觐酬前赏，倘念衰翁尚四愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九日四首 其二","author":"刘一止","text":"怀绂欣临柳恽州，据床宁羡庾公楼。\n云横浦溆无重数，花绕岩峦最上头。\n诗遣羊何聊共和，语惊陶谢未知休。\n自缘风物撩人意，不为闲情作许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九日四首 其三","author":"刘一止","text":"蒲团趺坐冷知秋，笳鼓声传出郡楼。\n阅世梦中知是梦，说禅头上更安头。\n邦君化得俱吟咏，居士年应赋莫休。\n只恐官梅能动兴，从梁江草唤人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九日四首 其四","author":"刘一止","text":"向来风韵照清秋，气压元龙百尺楼。\n倒载时时忆池上，朝回日日醉江头。\n甘泉正念论思旧，辅郡仍推誉望休。\n勃窣媻姗老归客，赖公与酒得浇愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雪中听琵琶一首","author":"刘一止","text":"燕堂曾许陪真赏，似识唐昌一树花。\n鹤骨松声公耐雪，龟肠蝉腹我羞茶。\n星弰万点疏还密，月帔千寻整复斜。\n要趁回风看舞态，莫令矫恨入琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题毗山吴约仲旷远亭一首","author":"刘一止","text":"追思五十年前梦，山压平湖水次门。\n白鹭未惭公子贵，青松不屈大夫尊。\n文辞朴凸推鼻祖，标置孤高到耳孙。\n更喜新亭名意好，吴郎清峻芮郎温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至汴下早行有感一首","author":"刘一止","text":"刺促惊时节，侵寻念物华。\n半生多客里，今日又天涯。\n晓月看眉妩，飞云乱眼花。\n穷途随物感，不必是思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和族兄无言题能仁寺当云轩一首","author":"刘一止","text":"绿树新回合，斜窗旧邃深。\n壶觞如栗里，岁月似山阴。\n半世怀清隐，何年得此心。\n借床眠不熟，酒力横相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵袁审渊道旧思归四首 其一","author":"刘一止","text":"寂寞襄阳老，南山忆弊庐。\n病来惟喜酒，叹罢每捐书。\n道路风尘暗，关河信息疏。\n逢人说沙漠，不忍问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵袁审渊道旧思归四首 其二","author":"刘一止","text":"十载溪亭旧，挥毫见古风。\n相如今病渴，东野尚鸣穷。\n眼界便乡物，风流忆乃翁。\n一枰如梦断，归思渺千峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵袁审渊道旧思归四首 其三","author":"刘一止","text":"城郭如村步，官身等俗闲。\n对棋论小墅，拄颊望西山。\n异县故交重，闲心幽事关。\n犹馀少年意，不计晚途艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵袁审渊道旧思归四首 其四","author":"刘一止","text":"虞氏隋唐后，当时尺五天。\n风烟鼻祖宅，翰墨耳孙贤。\n筇屐容相蹑，杯觞得共传。\n济时吾老矣，看着祖生鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵江子我雪句一首","author":"刘一止","text":"头白高山早，千林一夜花。\n云深乌鬼屿，风乱白鸥沙。\n刺促伤时事，飘零念岁华。\n天今洗兵马，勿复问浮槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅山一首","author":"刘一止","text":"伊昔市门隐，山今尚姓梅。\n危言关社稷，仙迹混蒿莱。\n此事谁云者，斯人安在哉。\n伤今更怀古，老意独悲哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送太学旧同舍及第归乡一首","author":"刘一止","text":"辇毂当年别，簪裳末路同。\n江湖人已老，家国恨何穷。\n山有伤心碧，尘无没马红。\n举鞭还送客，落日泪痕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子我得俸一首","author":"刘一止","text":"祠官资薄俸，肥遁要清贫。\n载酒久无客，乞醯惟有邻。\n广文宁厌肉，方朔漫长身。\n莫遣陈苌到，先生甑尚尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风气东南异","author":"刘一止","text":"风气东南异，阴晴早晚间。\n日光时透隙，云影半遮山。\n扫径残红尽，开窗绿荫还。\n寄声桑苧友，幽兴合相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绿暗山前路","author":"刘一止","text":"绿暗山前路，柔桑宛宛垂。\n稻秧分陇后，蚕茧下山时。\n白日缫车急，中宵织妇悲。\n老年官赋了，不长一絇丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事一首","author":"刘一止","text":"何物当门户，青松及我长。\n佳山忘岁月，同汝过风霜。\n北涧花应尽，南荣草欲芳。\n病来欢意少，一醉未全忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"览镜一首","author":"刘一止","text":"契阔三年梦，飘零一寸心。\n青青今变雪，种种仅齐簪。\n览镜浑相似，弹冠各不任。\n论交如许酒，情寄一杯深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"居士寮一首","author":"刘一止","text":"龙钟居士相，落魄宰官身。\n长史风吹帽，林宗雨垫巾。\n安心惟壁观，乞米赖僧邻。\n曾并鸳行立，当时梦不真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵朱宾老过我对月小酌一首","author":"刘一止","text":"老人论旧事，感慨思悠哉。\n暗喜生眉宇，新凉入酒杯。\n竹风谁汝和，檐月要人陪。\n此客非凡客，斯时得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴一首","author":"刘一止","text":"杯案惟菘韭，何因老骨强。\n昨朝方住雪，今日又加霜。\n寂历僧廊暮，支离野步芳。\n岁时浑不省，得酒是春阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴兴守春日书怀一首","author":"刘一止","text":"百榼偿春酒，人言有别肠。\n披风醒午醉，撷蕊眷馀芳。\n白日何曾短，游丝得许长。\n向来情浩荡，今者梦微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐叔镇知县罢官赴调一首","author":"刘一止","text":"剧论追前辈，忧思独在民。\n雪霜吾岁晚，金玉子心真。\n曾见除书旧，行膺荐墨新。\n君王问田叔，长者更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送邹德章教授之官合淝二首 其一","author":"刘一止","text":"晚色溪亭路，风帆去莫遮。\n交情寄桑落，离恨渺天涯。\n志行今谁及，声名莫谩誇。\n淮人问规范，说似道乡家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送邹德章教授之官合淝二首 其二","author":"刘一止","text":"古寺疏钟里，因依孰并游。\n歌行如短李，邂逅得髯邹。\n皎月林塘夜，青霜雉免秋。\n从今两相忆，一酌酹侬不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]