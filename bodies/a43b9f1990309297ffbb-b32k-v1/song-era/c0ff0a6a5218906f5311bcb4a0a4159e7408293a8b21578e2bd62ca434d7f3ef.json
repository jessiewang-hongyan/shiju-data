[{"title":"和张总管菊 其二","author":"李复","text":"开落纷纷不自知，春秋莫较后先期。\n清霜满地凋零急，正是黄花得意时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张总管菊 其一","author":"李复","text":"云里霓裳闲俨雅，霜前黄鹄独轩昂。\n不从春意装褫巧，却被秋风漏泄香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和崔珙望子岭观梅","author":"李复","text":"高枝疏淡小花头，开向残春破客愁。\n点墨空山慰寒晚，却如何逊在扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟嘉","author":"李复","text":"不将得失供谈笑，此语宜为盛德人。\n千里同风皆默契，褚裒故识坐中身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋庭夜閒步","author":"李复","text":"高秋夜气声惊竹，寒月徘徊影趁人。\n此境静观如啖蔗，后来细嚼味尤真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"项城主簿赵岍求书惹云亭为系二绝 其一","author":"李复","text":"东西飘忽本无心，留碍危檐便不禁。\n向晚前山风力薄，等閒相引作轻阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"项城主簿赵岍求书惹云亭为系二绝 其二","author":"李复","text":"白云曾与閒人约，为怪贪忙久不来。\n飞过孤亭访消息，也还遮莫未能回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题北禅院","author":"李复","text":"偶到丛林访可休，南山依旧满晴楼。\n垂钩漫有深潭兴，遍满乾坤是即收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陶渊明","author":"李复","text":"接舆歌凤溺沮耕，独往何堪与世亲。\n投绂归来眠北牖，高风自是葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿兴德寺","author":"李复","text":"东峰霁月出，林丛寒露明。\n夜久风渐息，深院无人声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崔珙推官话王园再如昔年为梅下之会并示绝句和来韵","author":"李复","text":"王家梅树春常早，露坐曾侵月影来。\n闻道去年还得意，新花还似旧时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹参庙","author":"李复","text":"百战皆收第一功，几回旁叹泣良弓。\n白头始识人间事，归向东州问盖公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒诗僧慧益不遇","author":"李复","text":"昼公昔在云门寺，曾笑陈丘久不归。\n草坐麻衣今不见，独来林下钓寒矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阎先复朝议园牡丹一本四月始开予与李成季同往观阎求诗遂书绝句于其壁","author":"李复","text":"浅蕊凡葩不自持，纷纷竞斗早春时。\n高情独负无人识，落尽群花晚始知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登后峡寨北山","author":"李复","text":"薄落山前菊未开，郁孤水畔独登台。\n明朝匹马冲霜去，直到鸣沙北始回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题甘茂祠","author":"李复","text":"奋身孤旅相秦王，欲去忧谗论乐羊。\n不有私金助公赏，可能明日拔宜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题严贤良东山集","author":"李复","text":"谢公高志渺浮云，对弈从容静世纷。\n坐客偶然谈小草，无言徒愧郝参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画马图","author":"李复","text":"龙种天驹产渥洼，五云毛色散成花。\n瑶池一去无消息，只许丹青纸上誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙卯七月十六日忽报罢任","author":"李复","text":"掩关忽报被刑书，自笑无堪涉世疏。\n白昼曾闻惊市虎，残灰今见祸池鱼。\n莫嗟静影逢沙矢，犹恐馀猜及鼠蔬。\n逆境自观还自喜，片心无碍一舟虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日过介之推庙","author":"李复","text":"荒祠久零落，秋日故山阿。\n椒菊持新奠，龙蛇忆旧歌。\n论功嗟晋粟，流怨动汾波。\n千岁遗灵在，乡民禁火多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月十三日夜偶书","author":"李复","text":"林叶纷纷已半凋，阴云不放眼周遭。\n稍知风逐青娥动，更觉天腾北海高。\n万里无心思假翼，百年多事喜持螯。\n山前沙井通幽圃，待得春深弄桔槔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十八日园中作","author":"李复","text":"决决清溪漱绕堂，兴来随意转藜床。\n畏人野鸟疑花动，收蜜山蜂误酒香。\n杏子带须红半抱，药苗退甲绿新长。\n风光须是閒时见，身世今欣已两忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上延帅沈内翰 其一","author":"李复","text":"昔年图史守岩幽，每仰高文动斗牛。\n千里来登徐孺榻，一时如上李膺舟。\n激昂囊颖思先出，慰藉泥涂欲晚收。\n曾笑王筠无事业，但题草木作风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上延帅沈内翰 其二","author":"李复","text":"荣路回翔简帝衷，坐烦谈笑静西戎。\n金銮学士承新诏，乌垒将军有古风。\n关塞星烽葱岭远，尘沙毳幕贺兰空。\n平时未便知颇牧，今日亲逢出禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乞罢未报承延晋秦庆皆惠书","author":"李复","text":"东西南北阅光阴，边意萧条老境侵。\n四府飞书惭过誉，数畴废壤愧初心。\n倾怀敢望时情合，论事须思后计深。\n髀肉久消筋力倦，但能操笔谢知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卫奕其兄被劾得雪惠书及诗","author":"李复","text":"去岁书传叹鹡鸰，新诗甚喜字纵横。\n龟虽有智犹罹网，雁为能鸣得免烹。\n须信箧中多谤语，莫矜堂上有奇兵。\n滔滔天下常如此，无慕功名取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"女几山女仙庙","author":"李复","text":"绛节高翔不可攀，尚留遗几在空山。\n月明曾有芳箫过，松老时看旧鹤还。\n岩下春归花寂寂，壁间云暗藓斑斑。\n开元已远霓裳绝，野草青青辇路閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋客至不赴郡会次范君武韵","author":"李复","text":"经岁相期尽赏心，虚堂有客阻趋尘。\n登楼君似庾老子，挟策我为臧丈人。\n清据胡床兴不浅，来寻奇字夜相亲。\n莫言糟粕无佳味，未许桓公愧斲轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予昔为河东漕属吏部郎中吕得和出总漕计与予情均兄弟后开府荆渚惠书有人生难得相知之语予后官守镇京兆闻吕之讣因发箧得旧诗感而作此","author":"李复","text":"三年发箧墨犹新，踪迹虽疏意更亲。\n云雾渚宫迷远梦，兵戈青海困飞尘。\n飘零剑外参谋客，怆恻山阳感旧人。\n今古交情如覆水，为君涕泪洒新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云岩","author":"李复","text":"径转随高下，攲危乱石中。\n寒岩朝起雾，空谷夜生风。\n疏竹连残屋，惊麇逐断蓬。\n求栖问茅舍，非浅爱田翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分按洛西诸邑登山出永宁西望晚宿韶山寺","author":"李复","text":"双旌明灭转委蛇，行遍秋山意若何。\n暗谷路穷平野阔，回峦石断乱泉多。\n崤陵东尽开周邑，熊耳中分放洛河。\n欲举因缘寻只履，夜深随雨到岩阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天竺僧金总持","author":"李复","text":"金轮风火转无涯，震旦观光渡海沙。\n八万言诠归贝叶，三千世界聚莲花。\n有缘禽鸟来波第，随喜天人尽木叉。\n今古少林风月在，闭门常御白牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天辅归休再用前韵并其弟恪子勉所和诗见寄再酬之","author":"李复","text":"西北秋风动碧云，经年忽忽惨离群。\n去辞北阙投新绶，归老东山缀旧文。\n诗遇惠连须长价，书从阿买可张军。\n平生胜理思悬解，糟粕徒观愧运斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月","author":"李复","text":"玉露漳川月，相看几上弦。\n气横秋浦白，轮带女城偏。\n半魄蟾犹隐，分枝桂未圆。\n云衢谁可到，柅辙驻流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王夫人挽词 其一","author":"李复","text":"家声昔冠秦中望，妇学今传颍上风。\n百岁流光方过半，新春逝水忽驰东。\n丹山凤泣归巢冷，寒月乌啼反哺空。\n他日拂弦悲旧曲，应将哀恨寄孤桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王氏园置烛观梅","author":"李复","text":"堂前梅树花初遍，露坐看花对夕风。\n苦恨夜收春色去，故移灯入素光中。\n乱争短发愁边白，清映衰颜酒后红。\n醉眼却来寻不见，只疑林月碎玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王谷节推画草虫花竹求诗","author":"李复","text":"细羽争飞翠蔓长，窗间留影点绡光。\n宁知臂朽专蜩翼，但见心精妙楮芒。\n诗学虫鱼增旧谱，药图草木验仙方。\n请君放笔开高臆，纵意云龙五色章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出村","author":"李复","text":"风露已凄凄，郊原百草腓。\n负樵山木下，转粟戍人归。\n野旷羊牛远，场荒鸟雀稀。\n南山经月雨，犹有乱云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圣容寺","author":"李复","text":"应感虽无地，栖真自有缘。\n宝坊开泗水，香露散秦川。\n草乱遗庵废，珠明旧相圆。\n丰碑传异事，细字刻诚悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甘罗庙","author":"李复","text":"纵横争擅势，之子独尊秦。\n弱齿能专国，奇谋不借人。\n拳峰凌九仞，勺粒动千钧。\n过客瞻遗构，临溪野草春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用周作韵送范忱夫举归","author":"李复","text":"白日高悬照九垓，天门欲上却飞回。\n虽闻西蜀题桥去，未放东都走马来。\n丰剑有神须会合，荆珉蕴璞且徘徊。\n明年八翮乘风起，一振鹏程九万开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白沙驿","author":"李复","text":"转侧下层巅，江流出断壖。\n寒云生古戍，野店引山泉。\n雨暗疏茅湿，堂危倒石悬。\n去程无限险，心落渭城边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会圣宫朝谒","author":"李复","text":"七叶丹成不可攀，蕊珠宫殿翠微间。\n千年空怨龙髯断，亿世曾闻宝筴还。\n宫女祠归朝路静，岳神綦退晓风閒。\n五云高宴蟠桃罢，鹤驭时应会此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴慈寺观君俞旧题","author":"李复","text":"松院前年到，同君共五人。\n今来观旧迹，君已是前身。\n遽掩千秋夜，空伤两岁春。\n向风无可语，泪洒壁间尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴德寺逢张居士","author":"李复","text":"扫叶开新径，携瓶汲晓泉。\n偶逢岩下客，来问室中禅。\n鸟去空还寂，薪穷火自传。\n四方行已遍，归老旧林边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再过方山驿","author":"李复","text":"春过方山驿，依然柳色新。\n昔游尝弭节，旧记已埋尘。\n往岁雠书客，新恩守土臣。\n南来心不竞，时羡北归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和叔弼暑饮","author":"李复","text":"古制虽存事一新，奇峰时作火云升。\n凭风高栋能虚爽，欲雨炎天故郁蒸。\n适意浮沉多野果，热中咀嚼喜清冰。\n别裁伪体亲风雅，若比阴铿岂敢膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊朱给事","author":"李复","text":"筮仕西州佐邑时，高才不厌簿书卑。\n清修与众初难合，真节当朝晚始知。\n谏苑尘埃多旧藁，佛宫粉绘有生祠。\n与君家世重重契，祖奠灵车涕满颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同君俞自牛头寺至兴教院又会文师","author":"李复","text":"杜曲樊川旧化城，东西相峙两牛鸣。\n岩前宝塔藏遗烬，殿里长灯续旧明。\n万法分流皆有相，一心息妄自无生。\n丛林是处经行遍，会向东山记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后园小池 其一","author":"李复","text":"凿地开方断石根，润通草树亦欣欣。\n筑基偏傍孤亭阔，引水初从曲径分。\n风约落花回近岸，露垂攲竹滴圆纹。\n春晴山鸟常来浴，浅处喧喧故作群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后园小池 其二","author":"李复","text":"城陬荒僻自开锄，野性难忘水竹居。\n岸侧星机支锦石，波心仙仗立红蕖。\n閒中有客唯来鹤，静去无竿不钓鱼。\n八卦神灵今可问，玄夫时出御辎车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕子固置会有诗张芸叟邀予席上依韵和","author":"李复","text":"故国归来晚，相逢共老年。\n聊从浮白饮，莫拟畔牢篇。\n花近红侵坐，槐新绿媚天。\n还丹消息断，无惜放杯传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕司空寿","author":"李复","text":"飘飘仙驭出蓬莱，时节新阳动琯灰。\n庆阀拱魁三象近，祥源引派九天回。\n磻溪龙虎家璜在，申国风云旧岳开。\n闻说清台占异事，弧南星步入中台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守郑易陈方及境改信都过大名书呈吕太尉","author":"李复","text":"淮阳闭閤欲偷閒，新捧除书墨未乾。\n五日御风方假翼，两河试郡别移官。\n生缘有定随流易，世事无端用力难。\n今日得陪门下客，一枝容息便心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏答山人赵颖忆山居","author":"李复","text":"绿发年来改，相看忆去频。\n青山不厌客，黄屦自迷尘。\n耳冷泉声淡，松残药灶贫。\n白云他日见，应问世间春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"托人求田","author":"李复","text":"绿绕随城潏水流，百年那免问菟裘。\n泉甘易汲能蠲疾，土沃翻耕每报秋。\n欲托高人论地券，共期他日老渔舟。\n归身未到心先到，得此馀无一事求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次马承议韵","author":"李复","text":"浮云飘忽竟多姿，苍狗须臾化白衣。\n对客莫思扪虱语，乘风且共跨鲸归。\n岩岩清壁三千仞，郁郁寒松四十围。\n君看时光易流转，新霜高叶又朝稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕元钧给事嘉川驿来诗","author":"李复","text":"相逢莫厌重留连，邂逅浮云只偶然。\n前日一樽穷乐事，今朝千里感流年。\n尘侵遗迹留漳水，风入高吟动蜀鞭。\n锦鲤往来出江浦，应传秀句满嘉川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李忱承议所惠诗","author":"李复","text":"人生飘荡若浮云，邂逅乘风忽聚群。\n嗟我淹留今倦宦，喜君倾倒细论文。\n扬舲觉海宗提印，授钺诗坛勇冠军。\n荒学漫劳无所得，鼻端聊假一挥斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李信叔","author":"李复","text":"不见吟翁近十年，驿亭相遇两欣然。\n旋临野岸烹河鲤，剩向邻家送酒钱。\n对雨张灯留夜榻，傍篱系柳泊归船。\n此生自断君休问，早晚须芸杜曲田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵鲜于之武游南谷","author":"李复","text":"山光娱客古城东，云散春阴望处空。\n畏影戏鱼依藻绿，避人飞鸟动岩红。\n林间野坐分溪石，岸曲晴行喜水风。\n旧事共高文字饮，新游尽寄语言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江公著举棋无偶忽败于予有诗戏用其韵","author":"李复","text":"忘暑怜楸局，含风爱竹窗。\n料兵闻旧怯，筑垒纳新降。\n舟渡焚秦水，兵分泣楚江。\n君知猿臂将，国誉世无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹","author":"李复","text":"园竹三年种，今春绿始稠。\n未知能却暑，但爱不悲秋。\n影补颓垣缺，枝多暮翼留。\n近因开小径，时有客相投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自吴岳归","author":"李复","text":"鸣凤冈边路，秋风动夕岚。\n閒云依绝壁，独鸟下空潭。\n畴昔经行惯，重来委曲谙。\n试寻遗墨在，投策访僧龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自寿安之长水","author":"李复","text":"夜宿锦屏下，晓行伊水长。\n露寒荷叶紫，秋晚稻花香。\n女几仙风断，连昌辇路荒。\n二年浑作客，山驿过重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自京之楚州","author":"李复","text":"隋柳桥边一问津，便将行止付舟人。\n土风入眼乡闾异，客路关心童仆亲。\n淮水烟开渔市晓，龟山云动佛香春。\n共传米价年来贱，取次东游不畏贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西溪酬孙倚李圭二同年依韵","author":"李复","text":"水部张员外，中书白舍人。\n曾闻三绝句，同赏曲江春。\n且逐追随旧，休悲老大身。\n花今千树发，有底不来因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观山郊阅武 其一","author":"李复","text":"叠锦联貂帽，飞光散羽旗。\n虎文双箙重，金粟小鞦垂。\n望鹘翻云没，呼鹰驻马迟。\n更闻传令去，先促羽林儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]