"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汪守宗博二首 其二","author":"刘克庄","text":"还笏归为负耒农，清谈常许奉从容。\n刍荛孰肯来询汝，薤水吾无可语公。\n怀惠俱垂岘碑泪，旌廉合有寝丘封。\n莆人谩课招魂些，应伴迂斋返甬东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汪守宗博二首 其一","author":"刘克庄","text":"虽则凝香无几日，攽条下教得民和。\n迎来境内风谣美，仙去城中巷哭多。\n应似柳侯驱疠鬼，又疑包老作阎罗。\n眼看青史常如此，命制于天可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽贡士方清卿","author":"刘克庄","text":"矫俗非崖异，诛奸似刻深。\n世无爱才意，天有不平心。\n陋巷贫犹乐，孤坟死尚吟。\n绝怜蔚宗史，未及共研寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽连夫人","author":"刘克庄","text":"渡江门户已华簪，嫁得黔娄作藁砧。\n畴昔曾为宾截发，暮年亲见子腰金。\n泷阡新刻丰碑妙，防墓重封宿草深。\n忆与夏卿联禁路，些辞题罢一酸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽邵武洪倅","author":"刘克庄","text":"不识监州面，闻名似旧知。\n空馀商榷恨，竟失合并时。\n昔作大苏客，今观小谢诗。\n西风丹旐过，一为士林悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈北山二首 其二","author":"刘克庄","text":"握笔临池惯，残书映雪勤。\n今宁无古篆，宋复有唐文。\n荒草周颙宅，空山董相坟。\n何时携斗酒，一酹墨溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈北山二首 其一","author":"刘克庄","text":"虽拜龙图号，自称槃涧翁。\n生难招此老，死可见文公。\n断简功夫久，深衣笑语终。\n空馀藏藁在，虹气贯山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈司直二首 其二","author":"刘克庄","text":"隆乾事契姑休论，岁晚相看成两翁。\n吾女偶沾郊霈下，君儿亦脱县滩中。\n清伊高会耆英少，碧濑新丘伉俪同。\n我有蔡邕书欲付，未知何日兆非熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈司直二首 其一","author":"刘克庄","text":"五朝际遇诸家少，四叶封崇一品荣。\n不似莺花贵公子，宛然萤雪老书生。\n交游绿野旧宾客，濡染沧洲贤父兄。\n吾老埋辞失之约，馀哀翻入薤歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈师复寺丞二首 其二","author":"刘克庄","text":"岁晚沧洲筑草堂，却将逢掖换轩裳。\n市朝共叹凤高翥，世俗或疑麟不祥。\n童子举扶犹忼慨，门人要绖各凄凉。\n衰残无复相镌切，遗墨常留几案傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈师复寺丞二首 其一","author":"刘克庄","text":"已奏囊封墨尚新，又携袖疏榻前陈。\n小臣忧国言无隐，先帝如天笑不嗔。\n阙下举幡空太学，路傍卧辙几遗民。\n愚儒未解天公意，偏寿它人夭此人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈判官","author":"刘克庄","text":"偶然倾盖欣初识，蓦地分襟惜久暌。\n太末谩称三语掾，上林未借一枝栖。\n空烦樗叟招魂些，赖有薇郎积善题。\n他日广文燎黄诰，原头鹤表与云齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈判官","author":"刘克庄","text":"□□□兵少，匹马命如丝。\n宝玦化为烬，锦囊存者诗。\n无丹驻光景，有雪上须眉。\n坐阅君三世，如之何勿思。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈岩方隐君二首 其二","author":"刘克庄","text":"溪墅山房委折通，每分半榻听松风。\n篘成昔喜同浮白，荔熟今悲自擘红。\n宰上碑何惭有道，城中人少识庞公。\n单鸡勺酒新丘远，迢递扶衰别殡宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈岩方隐君二首 其一","author":"刘克庄","text":"长鲁申公数岁馀，占天随子百弓居。\n久抛科举寻初服，不愿君王载后车。\n里有学人来问字，朝无掌故就传书。\n新春农告西畴事，谁伴樗翁共荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈建昌","author":"刘克庄","text":"一麾踰峤几星霜，岁晚乘云觐帝傍。\n方喜吾丘来春计，又闻翁子去怀章。\n百弓别业虽清旷，九尺长身已老苍。\n原上悲风吹宰树，伤心鸡絮莫携将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈常卿二首 其二","author":"刘克庄","text":"族甲莆鄞鲜拟伦，儿班玉笋婿朱轮。\n析财遍及棣华子，艎粟均沾菜色民。\n乡饮酒希先酌者，洛英会失戴花人。\n与君世世联墙住，晚筑新阡亦卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈常卿二首 其一","author":"刘克庄","text":"幼共从师长五年，暮龄彼此各华颠。\n我辞台斗先还笏，君望蓬莱忽引船。\n差胜于朝于市者，相携某水某丘边。\n老儒未至忘情地，便是瞿聃亦泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈梧州二首 其二","author":"刘克庄","text":"小室夷之筑，荒州舜所藏。\n身过冰檗苦，面带瘴茅黄。\n察使临阳子，遗民笑化光。\n定知廉吏传，他日一名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈梧州二首 其一","author":"刘克庄","text":"谷目多名士，西轩与石门。\n族皆通一谱，君独秀诸孙。\n叔季斯人少，耆英几个存。\n可怜同社叟，反袂赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈惠倅","author":"刘克庄","text":"昔预八仙饮，深知七子才。\n云何埋玉树，不复倒金罍。\n锦制曾三试，罗浮欠一来。\n吾衰惭诔笔，搔首寄馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈潮州伯霆","author":"刘克庄","text":"当年舍选最居优，上到青云亦白头。\n律赋数篇天下诵，遗书几卷馆中留。\n入游太乙曾临地，出牧昌黎所典州。\n耆旧凋零今欲尽，伤心笳吹掩新丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈孺人","author":"刘克庄","text":"昨吊空闺涕未收，忍闻绋翣向斯丘。\n不为尚子了家事，似与庞公圆话头。\n天下断无胶可续，人间最有剑难求。\n潘郎文笔尤宜诔，想见新碑字字愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈孺人","author":"刘克庄","text":"乡井公评推内则，掖垣铭笔写徽音。\n不烦陶子羞蚶鲊，肯与黔娄共布衾。\n三语未酬将母志，九原无负托孙心。\n樗翁阅世头如雪，二纪前曾挽藁砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽参与蔡公三首 其三","author":"刘克庄","text":"昔任高阳里，登堂执束脩。\n深知二郎故，曾接两翁游。\n面棘新班峻，然藜旧话休。\n空藏笥中帖，世世宝银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽参与蔡公三首 其二","author":"刘克庄","text":"磊落多奇节，源流自父师。\n力扶举幡士，显拒卖珠儿。\n无复金瓯覆，空令玉钺悲。\n太常谁议谥，可不采吾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽参与蔡公三首 其一","author":"刘克庄","text":"蔡公遂委笃，朝野共歔欷。\n子不税冕去，王将以衮归。\n风涛如此急，人物眇然稀。\n自古难全传，今无一可讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽建昌詹使君二首 其二","author":"刘克庄","text":"稍喜佩铜鱼，邅回四纪馀。\n早无人料理，晚有鬼揶揄。\n把酒言犹在，凝香梦竟虚。\n斯人止如此，恐坐太清臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽建昌詹使君二首 其一","author":"刘克庄","text":"南渡钧枢后，宣和节义门。\n依然窭人子，不似贵公孙。\n苦李无谁采，甘棠在处存。\n遥知宦游地，巷哭更招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林夫人","author":"刘克庄","text":"奉使年三十，声名满四夷。\n奇哉何物媪，生此丈夫儿。\n墓竟同孙窆，家犹有妇持。\n向来称寿地，忍听鼓箫悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林计院二首 其二","author":"刘克庄","text":"检点齐年友，凋零重可悲。\n君逢庚子鵩，我叹甲辰雌。\n鸥社同盟少，蟆陵会哭谁。\n暮龄多感慨，邻笛更须吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林计院二首 其一","author":"刘克庄","text":"材名汉廷选，文学孔门科。\n不仿治安策，宜赓喜起歌。\n三麾老龚遂，一榻病维摩。\n此事悬于命，吁嗟可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林安人","author":"刘克庄","text":"薄宦周旋广及邕，一生甘苦藁砧同。\n孟光事远嗟谁继，督护歌悲听未终。\n鹤表魂栖高燥地，凤毛名在广寒宫。\n病翁空自吟哀些，撚断霜髭竟欠工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林进士","author":"刘克庄","text":"一门皆擢第，君独老儒冠。\n试卷年年纳，经书日日看。\n文为前辈赏，命合主司难。\n遥想泉台恨，铭旌未写官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林侍郎二首 其二","author":"刘克庄","text":"玉殿龙墀元会日，千官拜舞奉尧樽。\n问周大老今安在，叹鲁灵光尚独存。\n次对职清褒橐从，中书君秃愧□□。\n自怜洛社归差晚，旧话无人可共论。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林侍郎二首 其一","author":"刘克庄","text":"端平初偶忝朝班，亲见仙枝折广寒。\n揭晓名高推虎榜，凌云赋奏动龙颜。\n烹桑犹记攻京尹，谏草何妨上史官。\n膜外浮荣姑勿论，长留公是在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林学录五言二首 其二","author":"刘克庄","text":"昔报尊公讣，奔丧万里程。\n生居诸子下，身代二兄行。\n负骨叹纯孝，分财见不争。\n九原面先舅，应问白头甥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林学录五言二首 其一","author":"刘克庄","text":"节麾三世显，萤雪一生贫。\n愈积家馀庆，咸称里善人。\n幼常推李泌，老忽哭卢纶。\n圣恶无从涕，那堪是外亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林宜人","author":"刘克庄","text":"曾究西方学，儒书亦有闻。\n赐金存日施，遗珥病时分。\n白首夫同穴，青山子结坟。\n吾诗非溢美，字字考埋文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林承奉","author":"刘克庄","text":"性与聃书合，平生宝俭慈。\n鹿门妻采药，蟾窟子攀枝。\n君可先贤传，吾惭幼妇碑。\n衰年窘才思，呵冻课哀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林法曹实甫二首 其二","author":"刘克庄","text":"昔我叨驰驲，惟君伴聚萤。\n病翁尚佔毕，良友忽幽冥。\n古有东方赞，今无贞曜铭。\n不知吟几些，叫得屈原醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林法曹实甫二首 其一","author":"刘克庄","text":"老学多推谊，诸公孰荐雄。\n却行吾日暮，渴睡汝冬烘。\n宰木经春雨，园花逐晓风。\n寝门哀未尽，寓在薤歌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林推官内方孺人","author":"刘克庄","text":"身畔无钗泽，何由葬礼奢。\n明时选人妇，先帝近臣家。\n白首持巾帨，青灯缉苧麻。\n寺西同窆处，风日怆寒笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林焕章二首 其二","author":"刘克庄","text":"束帛徵诸老，深衣立一儒。\n乡人偕猎较，童子共风雩。\n屑屑羞来往，兢兢迨举扶。\n自惭衰竭久，书墓觉词芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林焕章二首 其一","author":"刘克庄","text":"昔在端平际，临朝想老成。\n但闻辕固召，不见伏生行。\n霜柏无寒暑，朝华有悴荣。\n由来天所靳，上寿与高名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林新恩君用","author":"刘克庄","text":"汗血早曾空北野，苍颜晚始对南廊。\n风云志懒功名左，月旦评佳意味长。\n玉镜相从归吉兆，锦衣不待拜高堂。\n吾铭未必堪传远，留与贤郎自表冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林韶州 其二","author":"刘克庄","text":"东起平戎策，铃斋昼掩扉。\n身留峤南老，饷至洛中稀。\n瘴自茅花起，丧同薏苡归。\n不知汤介子，朝论是耶非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林德遇主学","author":"刘克庄","text":"摛掞多新意，研寻最苦心。\n可怜策名晚，谁遣读书深。\n兄老悲长枕，妻贤敛短衾。\n近书犹未答，展玩一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽表叔赵君任安抚二首 其二","author":"刘克庄","text":"叔在兵间日，书常笑我孱。\n初云机会易，晚叹事功难。\n寂寞郎官省，荒凉上将坛。\n遥怜会稽窆，新种短松寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽表叔赵君任安抚二首 其一","author":"刘克庄","text":"丞相规恢策，家庭已习闻。\n宁论乘一障，真可帅中军。\n玉麈无能对，金钱有即分。\n心知伏波病，多半为忠勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑子敬都承二首 其二","author":"刘克庄","text":"向来俱触相君嗔，里社追随二十春。\n尚记残编灯下共，忽看华表路傍新。\n行车不忍过三步，临穴应难赎百身。\n岁晚空山风雨横，奠刍归去倍伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑子敬都承二首 其一","author":"刘克庄","text":"重入脩门两鬓丝，延和累疏竭忠规。\n立朝颇慕汲生戆，谋国不知晁氏危。\n老去故人能有几，古来君子例无时。\n传闻近事堪悲慨，说向重泉亦皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑夫人二首 其二","author":"刘克庄","text":"昔事征西幕，年年拜寿闱。\n那知丹旐至，曾劝板舆归。\n元帅抛金印，诸生返布衣。\n感恩惟有泪，来向路傍挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑夫人二首 其一","author":"刘克庄","text":"九秩复何憾，生荣没更哀。\n闺门天下则，地位佛中来。\n贝叶从头看，庭槐一手栽。\n侍儿闻晓磬，犹恐坐禅回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑计院","author":"刘克庄","text":"方与誉髦连茹进，忽然避弋下乔来。\n空令归访盟鸥社，不使重登市骏台。\n古有孟尝能好客，今无鲍叔肯分财。\n吾衰难秉铭幽笔，短些凄凉不尽哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]