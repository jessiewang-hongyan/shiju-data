[{"title":"就舜谐觅石","author":"邹浩","text":"数峰寂寂卧苍苔，醉眼何曾略为开。\n乞与茅檐淡相对，要令云雨出山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智岸将往钱塘索妙乐庵诗勉此为句","author":"邹浩","text":"向来杨处士，今作岸禅师。\n懒散元非我，熙怡竟有谁。\n长应心似水，不复口如碑。\n此处真安稳，何人妙得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈明远","author":"邹浩","text":"尔来无酒可沾唇，只恐傍人怪独醒。\n自笑金龟已当了，惠然谁复遣银瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枢侄以诗来次韵示之","author":"邹浩","text":"酷爱日长萤可聚，几人如古惜分阴。\n胸中万顷清凉地，莫遣俗尘乘间侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读书","author":"邹浩","text":"谁能也学读书痴，园圃三年忘了窥。\n却恐主人如泄柳，谩携藜杖去何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇仁县君魏氏挽词 其一","author":"邹浩","text":"出自高明盛，归从望族贤。\n崇仁膺帝命，积善信家传。\n翌翌才三世，冥冥忽九泉。\n空馀可铭事，追继采蘩篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇仁县君魏氏挽词 其二","author":"邹浩","text":"猎猎霜郊路，铭旌捲朔风。\n堂前萱尚北，门外水犹东。\n貌入丹青冷，恩留祭享丰。\n乡人仰闺范，方看子孙隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故通直强君挽词 其一","author":"邹浩","text":"白发将年往，青衫甫宦游。\n从来四方志，曾未一分酬。\n幕府残机画，闾门失好修。\n惟馀旧秦月，寂寂照新丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故通直强君挽词 其二","author":"邹浩","text":"金丹犹在鼎，马鬣已成封。\n梦断飞云鹤，春归绕墓松。\n韦编元自若，藜杖竟谁从。\n赖有承家子，流光得所钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙图胡公挽词 其一","author":"邹浩","text":"华屋初成后，安车未用时。\n谁知五朝旧，俄与九原期。\n德映文恭显，名参修简垂。\n凄凉独心事，无复尽施为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙图胡公挽词 其二","author":"邹浩","text":"正尔逢千载，何为不百年。\n龙图虚旧阁，马鬣启新阡。\n方寸留天鉴，清规入世传。\n韦平向来盛，端属子孙贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙图胡公挽词 其三","author":"邹浩","text":"知己如公少，还乡特地亲。\n分携能几日，闻语歘惊人。\n永念恩常在，深惭报未伸。\n从横泪交下，空洒朔风频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡公郡君李氏挽词 其一","author":"邹浩","text":"先别人间去，由来天意微。\n初心在偕老，此日遽同归。\n镜掩孤鸾舞，津藏双剑飞。\n空存锦囊诰，依旧照霞衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡公郡君李氏挽词 其二","author":"邹浩","text":"正是家肥日，香奁晓不开。\n侍儿犹扇枕，良药已停杯。\n蘋老残初荐，萱閒冷旧栽。\n只应有馀庆，从此亘云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故通仕孙公挽词 其一","author":"邹浩","text":"少微星忽坠，畴昔梦初圆。\n乡社崇新祭，书帷掩旧编。\n亭依金斗固，儿戏彩衣偏。\n踵续谁为傅，吁嗟高士贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故通仕孙公挽词 其二","author":"邹浩","text":"君子不可见，先生无复遭。\n凶传俄一旦，吉养谩三刀。\n德与诸郎远，门将驷马高。\n伤心独南陌，松桧朔风号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故成纪李季侔挽词 其一","author":"邹浩","text":"命也端难诘，时乎竟莫来。\n门庭方白昼，冠带掩黄埃。\n万卷虚料理，千金废剸裁。\n遵承子将显，犹得慰泉台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故成纪李季侔挽词 其二","author":"邹浩","text":"师门深往好，姻党厚新情。\n正尔追谈笑，那知隔死生。\n松风传挽铎，垄月照铭旌。\n莫预东郊送，悲凉空此诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故文安郡君刘氏挽词 其一","author":"邹浩","text":"鹫峰成记别，聊现大家身。\n瞬目超尘劫，随方得本真。\n忘忧残旧草，供祭冷初蘋。\n独有闺门泪，潸然冬复春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故文安郡君刘氏挽词 其二","author":"邹浩","text":"愿力坚如母，翛然亦坐忘。\n羞兰虚孝养，偕老误荣光。\n净域端何许，遗经只自香。\n它年盛追赠，犹得贲馀芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故承议李公挽词 其一","author":"邹浩","text":"荦荦豪英内，如公迥不群。\n胸中妙庄老，笔下蔼机云。\n勋业知谁睹，声名只自闻。\n空馀柏庄柏，弥望拱高坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故承议李公挽词 其二","author":"邹浩","text":"甫毕荣亲愿，归休不计年。\n心冥尘竟远，善积子皆贤。\n万事残初梦，千龄掩逝川。\n登门独无路，追感倍悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亡原作忘，据四库本改友皇甫民望挽词 其一","author":"邹浩","text":"八行宜高选，胡为不享年。\n乡闾推往躅，几席积遗编。\n俛仰成千古，凄凉到九原。\n须知天报在，有子共称贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亡原作忘，据四库本改友皇甫民望挽词 其二","author":"邹浩","text":"超然遗象数，非古亦非今。\n过我每终日，惟君同此心。\n绝编犹可续，折角竟难寻。\n已矣无由作，高山空自琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阎求仁太博挽词 其一","author":"邹浩","text":"东国论交处，于今马鬣归。\n江山愁欲变，冠剑歘成非。\n事业知谁睹，声名只自飞。\n苍苍不容问，落日掩晴晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阎求仁太博挽词 其二","author":"邹浩","text":"踵门寒日后，留语竟黄昏。\n能得几日别，遽为千古魂。\n根尘元自了，生死更何言。\n独有人间泪，随风落九原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"强评事挽词 其一","author":"邹浩","text":"池亭春未改，宰木已鸣风。\n夙负三吴望，今邻万鬼中。\n潜光虽不耀，遗泽定难穷。\n它日高门泪，犹知驷马通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"强评事挽词 其二","author":"邹浩","text":"不为明世得，已矣旧山川。\n青眼谁樽俎，黄金自简编。\n乡闾今昔异，门户子孙贤。\n我独从君晚，追惟更惨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闾丘大夫挽词 其一","author":"邹浩","text":"鸳鸾纷集日，松桧掩新茔。\n持节空诸路，分符谩列城。\n闽山馀旧峻，淮水漾前清。\n地下虽难作，功名凛似生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闾丘大夫挽词 其二","author":"邹浩","text":"营邱何处是，不复问归期。\n世事三吴冷，风霜八月悲。\n生平虽爵禄，身后只书诗。\n恩报嗟无及，初心折涕洟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹山尹文老画像赞","author":"邹浩","text":"有时皱聚双眉，有时笑开双脸。\n澹山不解谩人，一任诸方点检。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道乡赞二首 其一","author":"邹浩","text":"青草黄茅梦破，东阡西陌年丰。\n长与老农击壤，不知身世穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道乡赞二首 其二","author":"邹浩","text":"昔时吏部侍郎，今日道乡居士。\n毕竟这个是谁，一任更安名字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普融阁","author":"邹浩","text":"前身善财后老平，善知识处靡不到。\n十信生行回向地，等觉妙觉诸法门。\n一法门中义一句，须弥聚笔海量墨。\n亘未来际力书写，未来可尽写不尽。\n何况六位一切法，一一算谕莫能及。\n老平于此不思议，第三手把龟手笔。\n一刹那间能事竟，一一微尘出经卷。\n三千世界微尘偈，一四天下微尘品。\n龙树传持所未会，悉在而今轮字里。\n字字无增亦无减，四十二字谁举偈。\n大宝莲花忽开敷，帝网重重清净土。\n十方三世佛菩萨，一时会集作證明。\n弥勒辨说巧称扬，文殊师利欣按顶。\n日用纵横日日新，此身普贤身内现。\n若人欲识老平身，即是毗卢无尽藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莲华经赞","author":"邹浩","text":"心为工师笔斤斧，巧取莲花以为材。\n愿力基构次第崇，一刹那间能事毕。\n菩萨众星佛孤月，歘然出现此土中。\n种种说法利群生，一一慈悲大方便。\n如父诱子出火宅，如主导商移宝城。\n如雨灌溉药品殊，花实根茎同一长。\n获普门通靡不应，道与非道对病药。\n过现未来佛所说，不增不减悉如是。\n宝积如来为證明，嶪岌巍峨分半座。\n此塔彼塔两现前，非一非二叵思议。\n谁将手擎至感慈，八万四千真塔样。\n无碍光从无纵出，遍非非想无间处。\n疑情照脱罪垢空，同證一乘无上觉。\n有如不信视龙女，八岁何知顿成佛。\n时不待人勿后悔，速向塔前勤忏礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书合论后","author":"邹浩","text":"华严佛菩萨，悲智咸遍周。\n广开方便门，主伴互酬请。\n于无言说中，说法无数量。\n我读诵思惟，获从信根入。\n闇逢照世灯，病遇雪山药。\n无价大宝珠，衣内忽然得。\n愿尽未来际，满足普贤行。\n一切导师前，一一兴供养。\n一切众生前，一一作利益。\n持经继有人，悉冀同我愿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书楞伽经后","author":"邹浩","text":"牟尼净虚空，大慧舒光明。\n森然万象形，有目咸欣睹。\n疑解二俱脱，一切本如如。\n一一楞伽山，演说修多罗。\n稽首方便慈，功德无穷尽。\n我今如是了，是为报佛恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡横策像赞","author":"邹浩","text":"东坡未作儋耳行，此相已入龙眠笔。\n大海中央谁与邻，万事一条横榔栗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云溪文庆长老画像赞","author":"邹浩","text":"不选在在处处，长是哆哆啝啝。\n饭了要睡便睡，睡了要歌便歌。\n呵呵呵呵呵呵，且道一把茅下。\n翁子三家村里，老婆相去几何。\n咦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集经文为要诀","author":"邹浩","text":"黄童妙音难可闻，若得三宫存玄丹。\n中有童子冥上玄，回紫抱黄入丹田。\n闭塞三关握固停，三气右回九道明。\n恍惚之间至清灵，散化五形变万神。\n千千百百自相连，共入太室璇玑门。\n三老同坐各有朋，高拱无为魂魄安。\n玉笢金籥常完坚，内守坚固真之真。\n真人既至使六丁，内挟列月列宿陈。\n物物不干泰而平，百二十年犹可还。\n使人长生升九天，上清紫霞虚皇前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠广陵马推官","author":"邹浩","text":"有才何事老青衫，十载低徊北斗南。\n肯伴雪髯千日醉，此心真与古人参。\n今见故人今几年，年来风物尚依然。\n遥知闲望登临处，极目江山万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滑石泉","author":"邹浩","text":"马头今日度严关，十九年前去复还。\n惟有流泉声似旧，凭栏重听响潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿珠井","author":"邹浩","text":"玉容捐委画楼尘，一死甘酬石氏恩。\n古庙有碑旌节义，西风无主逐香魂。\n孤村夜静鸣归鹤，双岭云寒唳断猿。\n试向绿萝寻旧迹，断碑遗井见清源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春词 其十","author":"毛滂","text":"庶草将蕃庑，群阴自退消。\n迟迟杏梁日，长照紫宸朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙居禅院","author":"毛滂","text":"潇洒仙居院，楼台烟霭中。\n夜泉清浸月，午铎冷摇风。\n转目已成昨，累名俱是空。\n一尊林下醉，此兴谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仙居禅院怀舒阁","author":"毛滂","text":"织水联珠未是奇，舒王留咏夺天机。\n神光已比箕星立，文燄长依舜日晖。\n一沼蛟龙涎半积，两檐鸾鹤势双飞。\n名山从此流传永，自昔因人重发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"毛滂","text":"贪恋恩波未肯飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"范习父","text":"可笑祖龙游不得，欲于何处访蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"郭思","text":"落星一石几千年，门外何人扣汉川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有所思","author":"李新","text":"洞庭始波秋风起，舟人怨遥心在水。\n眸寒不见潇湘云，天碧江沉一千里。\n西洲莲老谁愁红，兰桡欲采悲秋容。\n采得秋容咽无语，白日长安在何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父曲 其二","author":"李新","text":"秋山远，秋木黄，斜汀曲屿苕花香。\n归云带暝卷寒色，晚吹吹回双雁行。\n鲈肥酒熟莼丝美，独钓孤舟老烟水。\n故人停浆问生涯，湘水光摇碧千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠翟提刑 其二","author":"李新","text":"虬龙金璧走天阍，下有高陵几代孙。\n赋掷玉声那问价，笔生春意自无痕。\n尚书补去由高第，廷尉除归不署门。\n元圃长生新酿熟，一庭椿露滴黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题兴化小阁 其三","author":"李新","text":"钵囊有润何癯瘠，鱼鼓无声太寂寥。\n更向冲衢见车马，可能不过虎溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"李新","text":"云迷夏禹从前宅，雪压姜维最后城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"李新","text":"山外浮云云外城，江边羌角水中声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"李新","text":"谁道图书府，不通毡罽乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"高荷","text":"勃兴连谷雨，闰位次花王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"高荷","text":"佳人斗草百，稚子击毬双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"高荷","text":"辨虽豪白马，谗亦困青蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"晁咏之","text":"伤心有恨关存殁，袖手无人问姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"晁咏之","text":"旌旗太一三山外，车马长杨五柞中。\n柳外雕鞍公子醉，水边纨扇丽人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"晁咏之","text":"唤得梅蕊要同韵，羞杀梨花不解香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其九","author":"释文准","text":"钻真珠解玉板即易，看窟笼著楔却难。\n月色和云白，松声带露寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简鲍钦止","author":"吴则礼","text":"剧谈解人颐，湖海鲍工部。\n端能于口前，截断第二句。\n瘦藤寻上方，住此鼓钟暮。\n快办呼酒尊，梅花已无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯时三马图","author":"吴则礼","text":"从来画马称神妙，至今只说江都王。\n将军曹霸实仲季，沙苑丞辈犹诸郎。\n龙眠老人亦画马，独与三子遥相望。\n两马骈立真骕骦，一马脱去仍腾骧。\n龙眠老人今则亡，呜呼三马谁平章。\n北湖居士两鬓苍，初无长吉古锦囊。\n饭豆不足将游梁，手持三马三太息，樯乌已复催船樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次公采赠太希先密云团韵","author":"吴则礼","text":"道人祝融屩，胡为堕南州。\n都无作相但粥饭，平生衲被姑蒙头。\n曾郎手中大圆镜，朵颐赠之非暗投。\n快烧铜瓶作蟹眼，铸成八载心如抽。\n吾行踽踽饱阅世，葵苋独与衲子游。\n君来适逢小摇落，水天拍拍团沧州。\n唤醒北固龛底梦，拟披袈裟上扁舟。\n且浇玉川七椀句，仍洗船子三寸钩。\n摩挲正焙连城璧，少林老僧初不识。\n他时一笑示灵源，五百比丘端失色。\n幽丛鲜鲜凉雨馀，亦有黄花净供无。\n知渠肉团久炯炯，玷翳浑灭如大珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又再至山阳作","author":"吴则礼","text":"楚州白菘大于臂，天乞吾曹作好春。\n北湖食来如食肉，塔里僧伽不笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷仙架船岩","author":"翁彦约","text":"西溪漂渺接明河，鼓棹仙人泛立波。\n却御长风天上去，虚舟千古插嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷仙机石","author":"翁彦约","text":"辛苦支机耐寂寥，肯同嬴女只吹箫。\n金梭昨夜成龙去，上与天孙织绛绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]