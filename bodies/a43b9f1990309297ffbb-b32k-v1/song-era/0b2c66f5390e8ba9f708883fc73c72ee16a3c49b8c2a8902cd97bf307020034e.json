[{"title":"次韵温伯谋归","author":"范成大","text":"官路驱驰易折肱，官曹随处是愁城。\n随风片叶乡心动，过雨千峰病眼明。\n一脔何须尝世味，寸田久已废吾耕。\n羡君早作归欤计，屈指从今几合并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答吴江周县尉饮垂虹见寄","author":"范成大","text":"垂虹亭上角巾倾，鼍怒龙吟醉不听。\n安得对君浮大白，想应嗤我汗新青。\n梦魂舞蝶随春草，时节宾鸿点暮汀。\n湖海扁舟须及健，莫教明月照星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢李叔玠追路送笋","author":"范成大","text":"堕地锦绷茁，解衣温玉姿。\n来偿食竹债，大胜伏雌炊。\n少日羹藜子，老来煨芋师。\n盘餐登异味，指动已先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵韩无咎右司上巳泛湖","author":"范成大","text":"休沐辰良不待晴，径称闲客此闲行。\n春衫欺雨任教冷，病眼得山元自明。\n抹黛浓岚围坐晚，揉蓝新渌没篙清。\n栖鸦未到催归去，想被东风笑薄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵甄云卿晚登浮丘亭","author":"范成大","text":"宾筵旧压三千客，燕榭新高十二城。\n泼墨云头连树暗，垂丝雨脚过溪生。\n葛巾羽扇吾身健，雪椀冰瓯子句清。\n从此相从须痛饮，故应此事胜公荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蜀客西归者来过石湖并寄成都旧僚","author":"范成大","text":"走遍尘埃倦鸟还，故乡元在水云间。\n黄粱饭里梦魂醒，青箬笠前身世閒。\n鸥鹭飞来俱玉立，松篁岁晚各苍颜。\n岷峨交旧如相问，铁锁无扃任客攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵魏端仁感怀俳谐体","author":"范成大","text":"浪学骚人赋远游，大千何事不悠悠。\n酒边点检颜红在，镜里端详鬓雪羞。\n过眼浮云翻覆易，曲肱短梦破除休。\n孤烟落日冥鸿去，心更冥鸿最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江安道中","author":"范成大","text":"秾绿连村荔子丹，瘴云将雨暗前湾。\n张旗且喜三滩驶，叱驭曾惊九折艰。\n泸水舟閒迷古渡，马湖碑缺伴荒山。\n威名功业吾何有，无事飘飘犯百蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池州九日用杜牧之齐山韵","author":"范成大","text":"年年佳节歌式微，秋浦片帆还欲飞。\n万里蜀魂思远道，九歌楚调送将归。\n杯中山影分秋色，木末江光借夕晖。\n细撚黄花一枝尽，霏霏金屑满征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏瘦悴","author":"范成大","text":"皮下多无肉，秋来瘦不禁。\n骨棱春焙銙，筋蹙海山沉。\n虮虱从何有，蚊蝇枉见侵。\n惟馀老筇杖，相伴两虚心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西楼夜坐","author":"范成大","text":"抗尘怀抱若为宽，绕屋蛙声亦在官。\n岩桂无香秋遂晚，江鲈有约岁将寒。\n文书散乱嘲痴绝，灯火凄清语夜阑。\n病倦百骸非复我，但思禅板与蒲团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西楼秋晚","author":"范成大","text":"楼前处处长秋苔，俛仰璿杓又欲回。\n残暑已随梁燕去，小春应为海棠来。\n客愁天远诗无托，吏案山横睡有媒。\n晴日满窗凫鹜散，巴童来按鸭炉灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过鄱阳湖次游子明韵","author":"范成大","text":"春工酿雪无端密，大块囊风不肯收。\n休问巉岩与欹侧，我今弟靡共波流。\n野鹰兀兀平沙上，折苇萧萧古渡头。\n满眼荒寒底处所，令人肠断五湖舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问月堂酌别","author":"范成大","text":"半明灯火话悲酸，此会情知后会难。\n四海宦游多聚散，一生情事足悲欢。\n鬓丝今夜不多黑，酒量彻明无数宽。\n醉梦登舟都不记，但闻风雨满江寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴寒终日兀坐","author":"范成大","text":"东风微解缀檐冰，仍喜朝来井水清。\n腊浅得春全未煖，雪悭和雨最难晴。\n小窗日煖犹棋局，穷巷更深尚屐声。\n莫把摧颓嫌暮景，且将閒散替劳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"但能之提刑相别十年自曲江远寄二诗叙旧良厚次韵为谢亦以首章奉怀略道湘南分携故事末篇自述年来衰病不复故吾也 其二","author":"范成大","text":"濩落枵虚似瓠壶，新添雪鬓与霜须。\n也知病叟形容变，非是仙儒骨相癯。\n岁晚山林如自献，年丰田野亦多娱。\n无端拙恙妨清乐，未许扁舟到五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"但能之提刑相别十年自曲江远寄二诗叙旧良厚次韵为谢亦以首章奉怀略道湘南分携故事末篇自述年来衰病不复故吾也 其一","author":"范成大","text":"忆昔骖鸾识俊英，朱幡绣斧尽能名。\n书随庾岭一枝寄，句挟韶江九奏成。\n吴粤交驰清夜梦，参辰不隔故人情。\n何时重醉金槽曲，一洗阳关别恨平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"体中不佳偶书","author":"范成大","text":"生平人比似维摩，试比尪孱不啻过。\n旧摘衰髯今雪遍，频揩病眼转花多。\n从来世味聊复尔，此去官身如老何。\n收拾颓龄加药饵，尚堪风月对婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀杭道中","author":"范成大","text":"落花流水浅深红，尽日帆飞绣浪中。\n桑眼迷离应欠雨，麦须骚杀已禁风。\n牛羊路杳千山合，鸡犬村深一径通。\n五柳能消多许地，客程何苦镇匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初入大峨","author":"范成大","text":"烟霞沉痼不须医，此去真同汗漫期。\n曾款上清临大面，仍从太白问峨眉。\n山中缘法如今熟，世上功名自古痴。\n剩作画图归挂壁，他年犹欲卧游之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初入巫峡","author":"范成大","text":"钻火巴东岸，摐金峡口船。\n束江崖欲合，漱石水多漩。\n卓午三竿日，中间一罅天。\n伟哉神禹迹，疏凿此山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初冬","author":"范成大","text":"节令坚冰始，民风古意淳。\n星行穷少皞，正岁述咸秦。\n俗礼嫌端拜，头风强裹巾。\n红泥炉畔酒，从此卜亲邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏古十六首 其四","author":"华镇","text":"长剑寄宝匣，往往夜鸣吼。\n芒针补弊履，虽贱不为丑。\n藏器贵有施，斯人自吾偶。\n汲汲出疆贽，皇皇丧家狗。\n无愧三宿行，未多沮溺耦。\n营丘执羔客，乃是射钩手。\n解缚履文陛，低颜亦含垢。\n鲁堂品藻中，茂实帝王后。\n君子当际会，所学问行否。\n南阳三顾日，不羡商岩叟。\n相期等钓璜，兹为兆熊后。\n宿将轻少年，前席亦何有。\n恢恢王景略，落落秦关右。\n周旋二十年，初心了无负。\n何必逐桓温，联翩东南走。\n松柏傥莫依，嵩岱皆培塿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初归石湖","author":"范成大","text":"晓雾朝暾绀碧烘，横塘西岸越城东。\n行人半出稻花上，宿鹭孤明菱叶中。\n信脚自能知旧路，惊心时复认邻翁。\n当时手种斜桥柳，无限鸣蜩翠扫空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初约邻人至石湖","author":"范成大","text":"窈窕崎岖学种园，此生丘壑是前缘。\n隔篱日上浮天水，当户山横匝地烟。\n春入葑田芦绽笋，雨倾沙岸竹垂鞭。\n荒寒未办招君醉，且吸湖光当酒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"判命坡","author":"范成大","text":"钻天岭上已飞魂，判命坡前更骇闻。\n侧足三分垂坏磴，举头一握到孤云。\n微生敢列千金子，后福犹几万石君。\n早晚北窗寻噩梦，故应含笑老榆枌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别后寄题汉嘉月榭","author":"范成大","text":"隐吏诗情卜筑幽，同年惜别劝淹留。\n试倾万景湖亭酒，来看半轮江月秋。\n川路虽长犹共此，夜船空载且归休。\n碧岩胜处频回首，好事谁能更小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别拟太上皇帝挽歌词六首 其六","author":"范成大","text":"甫贺蝇传赦，俄惊鹤驭风。\n首山铜鼎就，前殿玉卮空。\n日岂挥戈及，天无鍊石功。\n如何千万寿，不待九龄终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别拟太上皇帝挽歌词六首 其五","author":"范成大","text":"舞羽修文后，投歌讲艺时。\n天章云汉丽，国典日星垂。\n麟绝仲尼笔，猿啼神禹碑。\n伤心河洛水，无处问龙龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别拟太上皇帝挽歌词六首 其四","author":"范成大","text":"与子传神器，承家得圣人。\n阶庭天下养，壶峤海中春。\n四叶斑衣乐，三加玉册新。\n寿宫如帝所，何必上霄晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别拟太上皇帝挽歌词六首 其三","author":"范成大","text":"敛福开皇极，储祥握赤符。\n寇降千猰㺄，胡拜两单于。\n洗甲民安枕，垂衣国覆盂。\n有生何以报，寿域亘绵区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别拟太上皇帝挽歌词六首 其二","author":"范成大","text":"大孝天孚佑，精诚敌可摧。\n龙輴迁座至，騩驭及泉回。\n永祐千章木，慈宁万寿杯。\n古今无此事，绝德诏方来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别拟太上皇帝挽歌词六首 其一","author":"范成大","text":"身济投艰业，时乘拨乱机。\n荆榛荒帐殿，风雨颒戎衣。\n有日临黄道，无星彗紫微。\n至今淮海上，犹咏六龙飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巫山县","author":"范成大","text":"借马巫山县，盘舟掉石滩。\n梅肥朝雨细，茶老暮烟寒。\n门对高唐起，江从滟滪难。\n流堆三尺在，旅梦一枝安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张正字母夫人朱氏挽词","author":"范成大","text":"蘋藻仪邦媛，诗书了岁华。\n籯金宁遗子，群玉竟传家。\n厚施心无斁，浮生自有涯。\n空馀报恩子，三载亦苴麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀归寄题小艇","author":"范成大","text":"日出尘生万劫忙，可怜虚费隙驹光。\n若教閒里工夫到，始觉淡中滋味长。\n岁晚角巾思芋栗，年来手版愧耕桑。\n松风萝月须相信，春水深时上野航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李正之提点行至郴用予忙字韵寄和答","author":"范成大","text":"天涯逢我病，秋晚送君忙。\n感慨交情厚，留连别恨长。\n宾筵犹雪观，客路已云庄。\n摇落郴江路，应须忆醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李郎中挽词二首 其二","author":"范成大","text":"忆昔单车使，惟君勇辅行。\n马隤招共载，羝乳约同盟。\n老去长怀旧，悲来遽隔生。\n故人凋落尽，衰涕不胜横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李郎中挽词二首 其一","author":"范成大","text":"剧郡思贤牧，名曹失望郎。\n六参能几日，两鬓未全霜。\n霅水新阡远，桐川旧隐荒。\n绝怜垂白母，泪血独还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李翚知县作亭西湖上余用东坡语名之曰饮绿遂为胜概","author":"范成大","text":"芷葺莲巢唤客游，芦鞭席帽为君留。\n未论吹水堪添酒，且要移床学枕流。\n乍霁却阴梅酿雨，暂暄还冷麦催秋。\n石湖也似西湖好，烦向苍烟问白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李粹伯侍御挽词二首 其二","author":"范成大","text":"公昔参敷纳，人期到辨章。\n珠光空月皎，玉气忽虹藏。\n岁晚东方骑，生平北海觞。\n玳簪风雨散，几客奠楸行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李粹伯侍御挽词二首 其一","author":"范成大","text":"奕叶邯郸后，乘骢第一人。\n交情多旧雨，到处有阳春。\n磊落功名意，摧颓梦幻身。\n黄垆高可隐，何地著经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨君居士挽词","author":"范成大","text":"孝至兰陔茂，身脩梓里恭。\n名场儿中鹄，姻党婿乘龙。\n驹隙惊年运，蝉嫣有庆钟。\n幽光定无憾，丰刻妙形容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步入衡山","author":"范成大","text":"应有人家住隔溪，绿阴亭午但闻鸡。\n松根当路龙筋瘦，竹笋漫山凤尾齐。\n墨染深云犹似瘴，丝来小雨不成泥。\n更无骑吹喧相逐，散诞閒身信马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"没冰铺晚晴月出晓复大雨上漏下湿不堪其忧","author":"范成大","text":"晚色熹微煖似薰，儿童欢喜走相闻。\n无端星月照湿土，依旧山川生雨云。\n旅枕梦寒涔屋漏，征衫潮润冷炉熏。\n快晴信是行人愿，又恐田家曝背耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灼艾","author":"范成大","text":"血忌详涓日，尻神谨避方。\n艾求真伏道，穴按古明堂。\n谢去群巫祝，胜如几药汤。\n起来成独笑，一病搅千忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甬东道院午坐","author":"范成大","text":"一夜西风转酒旗，午馀残暑不多时。\n绿荷半蚀霜前叶，丹桂全封雨后枝。\n忙里有诗偿日课，老来无赋为秋悲。\n梳头小隶那知此，强向窗前数鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社山放船","author":"范成大","text":"社下钟声送客船，凌波挝鼓转沧湾。\n横烟袅处鸡豚社，落日浓边橘柚山。\n八表茫茫孤鸟去，万生扰扰一舟閒。\n湖心行路平如镜，陆地风波却险艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花山村舍","author":"范成大","text":"潦退滩滩露，沙虚岸岸颓。\n涧声穿竹去，云影过山来。\n柳菌粘枝住，桑花共叶开。\n庵庐少来往，门巷湿苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进思堂夜坐怀故山","author":"范成大","text":"尘事潮来不可推，身如病鹤强毰毸。\n簿书遮断寻诗路，风雨惊残问月杯。\n想得竹门无客到，直须雪夜有船回。\n鲈乡望眼双明处，袛欠凌霄万仞台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月四日石湖众芳烂熳","author":"范成大","text":"北垞南冈总是家，儿童随逐任驩哗。\n开尝腊尾蒸来酒，点数春头接过花。\n尽把园林蒙锦绣，多添门户锁烟霞。\n杖藜想被春风笑，扶却衰翁管物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈侍御园坐上","author":"范成大","text":"愁眼逢欢春水明，诗情得酒春云生。\n花梢蝴蝶作团去，竹里鹁鸠相对鸣。\n邂逅浮生此日好，缠绵俗累何时轻。\n擘笺沫墨乏奇句，擪笛当筵惭妙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周畏知司直得湖南帅属过吴门复用己丑年倡和韵赠别","author":"范成大","text":"邂逅婆娑失少年，剧谈抵掌尚超然。\n君犹拄笏看山去，我且披蓑听雨眠。\n京洛分襟疑后会，江吴把酒悟前缘。\n暂来忽去都如梦，疑是陈卿竹叶船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周德万携孥赴龙舒法曹道过水阳相见留别女弟","author":"范成大","text":"草草相逢小驻船，一杯和泪饮江天。\n妹孤忍使行千里，兄老那堪别数年。\n马转不容吾怅望，橹鸣肯为汝留连。\n神如相此俱强健，绿发归来慰眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏吴中二灯 其一 琉璃毬","author":"范成大","text":"龙综缫冰茧，鱼文镂玉英。\n雨丝风外绉，云网日边明。\n叠晕重重见，分光面面呈。\n不深閒里趣，争识个中情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏怀自嘲","author":"范成大","text":"檐溜春犹冻，门扉晚未开。\n退閒惊客至，衰懒怕书来。\n日日教浇竹，朝朝遣探梅。\n园丁应窃笑，犹自说心灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜发昆山","author":"范成大","text":"岁寒人墐户，霜重独登舟。\n弱橹摇孤梦，疏篷盖百忧。\n但吟今不乐，岂计几宜休。\n惭愧沙湖月，年年照薄游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泊归州州有宋玉宅、昭君台","author":"范成大","text":"旧国风烟古，新凉瘴疠清。\n片云将客梦，微月照江声。\n细和悲秋赋，遥怜出塞情。\n荒山饮阀阅，儿女擅嘉名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝公祈雨感应用陈申公韵赋诗为谢","author":"范成大","text":"膴原龟坼暮春时，夹路炉薰共祷祠。\n唤起云头千嶂涌，飞来雨脚万丝垂。\n无情梅坞犹红绽，有意秧田尽绿滋。\n大施门开须满愿，愿均此施匝天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"府公录示和提干喜雨之作辄次元韵","author":"范成大","text":"雨挟潮痕涨具区，流渠决决绕幽居。\n荷锄日课都忘倦，抱瓮天机本不疏。\n且喜水平昌谷稻，莫教雷假介休车。\n老翁饱外还多事，更把林间种树书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明日分弓亭按阅再用西楼韵","author":"范成大","text":"眼看白露点苍苔，岁月飞流首屡回。\n老去读书随忘却，醉中得句若飞来。\n闻鸡午夜犹能舞，射雉西郊不用媒。\n自笑支离聊复尔，丹心元未十分灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明日至邻水又雨","author":"范成大","text":"昨日方无雨，今朝又不晴。\n满山皆屐齿，随处有泉声。\n颇怪阴霖差，应催老病成。\n泥涂千骑士，与我共劳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上","author":"范成大","text":"一枕经春似宿酲，三衾投晓尚凄清。\n残更未尽鸦先起，虚幌无声鼠自惊。\n久病厌闻铜鼎沸，不眠惟望纸窗明。\n摧颓岂是功名具，烧药炉边过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上作","author":"范成大","text":"绕枕蚊相聒，翻釭鼠自忙。\n早衰秋梦乱，不寝晓更长。\n赋拟骚人屈，吟成病客庄。\n安心无可觅，随处且为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]