[{"title":"刘伶巷","author":"陈炜","text":"有酒宜成颂，知君耻独醒。\n回车经巷口，荷锸信丘冥。\n死岂人埋得，言犹妇可听。\n闭关当日饮，想象只忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垂虹亭","author":"陈直卿","text":"西望洞庭突兀，东连仙里人家。\n笑指阑干三百，醉来就此乘槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涵清阁","author":"陈知柔","text":"追忆唯庵真可人，诗成咳唾笔如神。\n使登是阁一快扫，当有银钩铁画新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登巾山","author":"陈知柔","text":"司马胸中著云梦，杜陵眼底盖乾坤。\n吾衰不复论兹事，饱看孤帆落远村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩木 其一","author":"陈知柔","text":"层江波静鳄如扫，一亩寒阴禽自呼。\n莫把甘棠比韩木，令人洒涕共长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩木 其二","author":"陈知柔","text":"康成迹寄书带草，玄德祥标羽葆桑。\n名与此山俱不朽，何如烟杪郁苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山石","author":"陈知柔","text":"山花有空相，江月多清晖。\n野意写不尽，微吟浩忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次海上长亭村","author":"陈知柔","text":"行到山穷处，微茫岛屿青。\n百年多逆旅，万事一长亭。\n风雨晚潮急，鱼虾晓市腥。\n平生诵佳句，今见海冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"环翠亭","author":"陈知柔","text":"当年把臂入龙山，犹记相逢醉梦间。\n君似孤云了无碍，我如倦翼早知还。\n茅檐负日真成算，竹榻论诗整破颜。\n欲问太平真气象，夜来风月到松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读潮本韩集","author":"陈知柔","text":"大雅寥寥不复还，如公几得古人全。\n格高枯淡复志赋，意到浑沦原道篇。\n赵子遗编今复乱，欧公校本孰能传。\n古音秘矣尤难识，聊与磨铅一究研。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒姜相坟次邓经略韵","author":"陈知柔","text":"欲将兴废问洪钧，来谒孤坟独怆神。\n千载高风馀凛凛，一池秋水自粼粼。\n门前帆影来天际，林杪钟声落海滨。\n此道寥寥今复振，不应渔水是东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒韩祠","author":"陈知柔","text":"斯文何罪窜南荒，来谒孤祠泪数行。\n恐有遗书藏坏壁，岂无哀赋吊沅湘。\n精神不受氛烟蔽，道义长涵日月光。\n四壁萧萧香火冷，何人能与作堂皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石桥","author":"陈知柔","text":"巨石横空岂偶然，万雷奔壑有飞泉。\n好山雄压三千界，幽处常栖五百仙。\n云际楼台深夜见，雨中钟鼓隔溪传。\n我来不作声闻想，聊试茶瓯一味禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题洪景伯通判清閟堂","author":"陈知柔","text":"别乘清名满世间，却来堂下植檀栾。\n已无俗物败人意，且与此君同岁寒。\n夜月半庭金影碎，秋风一枕玉声残。\n雁行吏退铃斋静，想见巍冠独倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题秦隐君祠次邓经略韵","author":"陈知柔","text":"人境初无车马喧，卜居原得近姜村。\n山围古寺苔生砌，花落前汀潮打门。\n已许揭身如日月，不妨为客任乾坤。\n清诗海内流传久，亭下空馀石砚存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台游山","author":"陈知柔","text":"烟萝穿几重，柴车倦驱驾。\n忽寻钟磬音，山腰得僧舍。\n主僧闻我来，曳杖出相迓。\n揖我坐虚阁，登临欠台榭。\n老屋数椽馀，风物自闲暇。\n古木出云杪，遥岑来竹罅。\n下临一泓水，涵光冷相射。\n但能了此生，未遽惭大厦。\n我本山中人，偶失学圃稼。\n为米聊复留，两同僧过夏。\n得舟家可浮，遇竹宅便借。\n是处皆南山，何必东篱下。\n悠悠去忘归，宁畏长官骂。\n松月苦留客，徘徊度清夜。\n明朝过桃溪，溪女莫相诧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲花峰","author":"陈知柔","text":"多病登台今古情，菊花摇荡午凉生。\n山前木落石岩出，海上潮来秋渚平。\n野兴已随芳草远，归鞭更傍落霞明。\n愧无十丈开花句，独卧禅房心自清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿天台万年寺","author":"陈知柔","text":"古寺来投宿，云岩第几层。\n有诗堪供佛，无事且依僧。\n小阁泉喧枕，修廊雨暗灯。\n好峰看未足，梦绕碧崚嶒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人月圆","author":"陈知柔","text":"鬓缘心事随时改，依旧在天涯。\n多情惟有，篱边黄菊，到处能华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高学士知越","author":"陈知微","text":"会稽新命剖鱼符，又向蓬山锁直庐。\n林壑萦回多洞府，人烟高下半楼居。\n知音好采柯亭竹，博物应探禹穴书。\n公暇仙舟宜案部，鉴湖晴色照乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈知微","text":"千重浪里平安过，百尺竿头稳下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"陈秉文","text":"山涌银涛，屏间绣巘，太平今日皇州。\n共惟京牧，昭裔本宗周。\n好是王春正月，维岳降，膺此神休。\n尧阶下，蓂存八荚，长应八千秋。\n优游。\n兼国计，丰财重谷，首善承流。\n更刑清讼简，政入歌讴。\n已副貂蝉眷宠，夸中外，耸动□讴。\n居恩重，苍生望切，好个富民侯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归田","author":"陈绍年","text":"咫尺天关隔，丹心空上书。\n便随迁客返，还就野人居。\n竹里烟喧雀，溪头沙汎鱼。\n飞泉观物性，俯仰自舒徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿昌寺碧溪轩","author":"陈绎","text":"萧疏华薄隐山村，清浅浮桁带郭门。\n竹倚栏杆水边寺，兴来题作碧溪轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈绎","text":"榕叶堂前生昼阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七星杉","author":"陈肃","text":"峭石七星杉，凌云势森耸。\n月照林影寒，风起龙势动。\n高低松桧枝，环如众星拱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"半山亭","author":"陈肃","text":"蹑屐上高山，亭在半山侧。\n猿鸟戏层台，烟霞含秀色。\n复知名利心，到此堪俱息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投龙潭","author":"陈肃","text":"流瀑落深潭，叠响如惊雷。\n跳波夹乱石，突兀寒如堆。\n潭上片云起，千山风雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源洞","author":"陈肃","text":"轻烟绿满溪，夭桃红夹岸。\n春风吹百花，香逐春风散。\n花落与花开，年光不知换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流水池","author":"陈肃","text":"积水环巨石，石面如砥平。\n当知达者心，来此浮杯觥。\n酒中有贤圣，常愿娱闲情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧莲池","author":"陈肃","text":"爱此东南池，澄湛通泉脉。\n昔日碧莲根，香英今变白。\n颜色本神仙，霞衣无定格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔡经宅","author":"陈肃","text":"岩扉生翠霭，石壁凌朱霞。\n草木状多怪，鸾鹤归如家。\n谁嫌狡狯心，满地投丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瀑布泉","author":"陈肃","text":"山高激迅湍，清振林下响。\n飞雪溅千岩，白虹垂万丈。\n来此坐移时，森然毛发爽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙都山","author":"陈若拙","text":"发地便擎天，根盘数亩烟。\n化工成突兀，辙迹似雕镌。\n峭拔殊无倚，孤高众莫肩。\n轩辕从此去，知复几千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 游人涤赋","author":"陈若晦","text":"五洞深沈，九峰回抱，望中云汉相侵。\n暮春天气，宫殿翠烟深。\n一片山光澹净，溪月上、碧水浮金。\n琼楼杪，仙人度曲，空外响虚音。\n龙香，时暗引，青鸾白鹤，飞下秋阴。\n露华冷、琼珠点缀瑶林。\n犹记华胥梦断，从别后、几许追寻。\n人间世，逝川东注，红日又西沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卧龙潭","author":"陈范","text":"半岩欲堕潭渚深，昼阳不到午阴阴。\n洞箫一曲瑶笙断，千山万山云水沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈范","text":"倘来轩冕心无必，见在诗书足自娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈诗","text":"如何五载后，不问九疑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陈诗","text":"瑩光连烛动，月影带河流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之咏震山岩彭徵君钓台","author":"陈诜","text":"东有徵君真逸居，有台可钓傍渔矶。\n志高不在鱼吞饵，回笑荥阳血染衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其十","author":"陈诜","text":"鸿鹄远矰弋，鱼鸟脱池笼。\n始觉一无物，方知万事空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其七","author":"陈诜","text":"洗竹遥山出，流泉到曲池。\n可怜波万顷，黾勉对沦漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其八","author":"陈诜","text":"道院今犹古，閒中事可书。\n鹭鸥驯不去，谁可得亲疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其六","author":"陈诜","text":"园涉日成趣，穷诗懒缀装。\n梁间冰雪句，屈指岁华长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其三","author":"陈诜","text":"穷谷寓形久，惭无问俗方。\n文章古刺史，今昔窃馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其二","author":"陈诜","text":"有象阶前景，无声膝上琴。\n何劳今郑卫，视听不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其一","author":"陈诜","text":"时丰公事少，笔砚任横斜。\n环郭江山秀，人情等物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其五","author":"陈诜","text":"秀泉开旧甃，初试仰山茶。\n寂寂有馀意，池莲三五花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其四","author":"陈诜","text":"秽草诛还密，浮萍去又生。\n辄污如鉴净，有客若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖择之学士袁州庆丰堂十咏 其九","author":"陈诜","text":"登堂方再月，已许庆丰年。\n偶继前贤迹，承流颇裕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 钱别","author":"陈诜","text":"鬓边一点似飞鸦。\n休把翠钿遮。\n二年三载，千拦百就，今日天涯。\n杨花又逐东风去，随分入人家。\n要不思量，除非酒醒，休照菱花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题严子陵钓台","author":"陈贯道","text":"足加帝腹似痴顽，讵肯折腰求好官。\n明主莫将臣子待，故人只作友朋看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"何宪","text":"铁面金华谁氏子，要须相与嗣前尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"何宪","text":"人间正作云霓望，天半忽惊霖雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上林归鸦","author":"陈郁","text":"夕阳鸦背敛残红，万点飞归傍帝宫。\n应是上林栖宿稳，可曾惊散月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为古艾郑子刚赋可轩 其一","author":"陈郁","text":"未赴功名且钓船，忽勤王事即貂蝉。\n丈夫出处随时变，须卜此心然不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为僧如赋深居","author":"陈郁","text":"禅居自合入山林，阛阓之中岂是深。\n须信道人清似水，佳城如住海波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为薛叔载赋海隐","author":"陈郁","text":"见有阑干便舣航，不知炎日熬沙场。\n多应高枕归篷下，梦到此亭都是凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书江亭壁","author":"陈郁","text":"人间风浪最倾危，君自深藏了不知。\n只恐随流禹门去，又翻头角露天池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"友人官满","author":"陈郁","text":"三年官满冰霜洁，一日春回宇宙宽。\n曾向厅前种杨柳，绿阴留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆古襄州西教场打毬","author":"陈郁","text":"忆参元帅古襄州，几度莎场马打毬。\n鞍辔闹装都一样，野夫不着皂貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园书所见","author":"陈郁","text":"娉婷游女步东园，曲径相逢一少年。\n不肯比肩花下过，含羞却立海棠边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木庵为吴应祥隃赋","author":"陈郁","text":"木主乎东义近仁，斯庵名此称斯人。\n遥知虚室萧閒地，生意满怀都是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石湖归途","author":"陈郁","text":"人与西风结约来，芙蓉花气扑吟杯。\n曲塘好处都行遍，带得一身秋色回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过列山庙下","author":"陈郁","text":"挝鼓扬旗向石头，列山山下使人愁。\n风前独倚危樯立，遥认西淮四五州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闭户","author":"陈郁","text":"坐到心清有妙香，蒲团纸帐任更长。\n闭门不受庭前月，分付梅花自主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏堤晓望","author":"陈郁","text":"荷边清露袭人衣，风里明蟾浴晓池。\n凉影润香吟不得，手扳堤柳立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦吟","author":"陈郁","text":"水驿荒寒天正霜，夜深吟苦未成章。\n闭门不管庭前月，分付梅花自主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城东看柳","author":"陈郁","text":"翻煖为寒一信风，画桥南北岸西东。\n春归杨柳无私意，深浅青黄自不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪桥客窗枕上","author":"陈郁","text":"桐叶飘零月似冰，并河灯火夜寒生。\n阑干倦倚投床去，卧听趋朝过马声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看落花","author":"陈郁","text":"飞红飘白自交加，过了春光只叹嗟。\n识得岁寒松竹耐，始知园圃谩栽花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人赴乡举","author":"陈郁","text":"我方治地种秋芳，君亦濡毫拟擅场。\n待得君归醉重九，捷旗如我菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚楼","author":"陈郁","text":"一声新雁一声秋，独向江楼倚莫愁。\n江上片云将雨去，却留残照管汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倦游","author":"陈郁","text":"水于东江皆臣妾，山到衡阳无弟兄。\n两处经行都已遍，老夫谁更别关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"射雁马上口占","author":"陈郁","text":"脱手弦声破晓寒，雁身和箭衮花团。\n檐前曝背山翁喜，催唤儿孙逐马看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莺燕","author":"陈郁","text":"红杏墙连柳外门，春风池接暖烟村。\n阳和世界无分别，各自营巢长子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]