[{"title":"澹轩","author":"李吕","text":"穷耽世味不期骄，安得羹墙暂见尧。\n未到闻韶饱三月，且求陋巷乐箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠朱少南别二首 其二","author":"李吕","text":"朱君精到古人趣，踏遍东南称独步。\n祇今应诏非乏材，预烦拈出栋梁具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠朱少南别二首 其一","author":"李吕","text":"外貌休寻饾座梨，应知石里蕴瑰奇。\n从来善相书前史，为识英雄未遇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辨义丰老人师傅闻疑大乾事迹","author":"李吕","text":"义宁欲末隋鼎迁，解符西溯心悠然。\n沉舟甘作夷齐鬼，不与宇文同戴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕次韵","author":"李吕","text":"天上佳期岁一来，人间急管莫相催。\n鹊桥成后天孙度，雨泣悬知飙驭回。\n儿女欢呼争乞巧，楼台罗列剩传杯。\n欲搜好句陪年少，病士惭无工部才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元应制次韵","author":"李吕","text":"华灯不夜照青春，鳌背缯山迥绝尘。\n已遣烛龙衔火炬，更开璧月驻飙轮。\n长疑化国烟霄近，未觉壶天晚日宾。\n知是奎文临海外，赐章今夕宠光频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元漫兴","author":"李吕","text":"天上元宵放月明，张灯何苦浪经营。\n一毬积日方呈巧，千片轻绡仅凑成。\n里巷禽呼倾坐去，街衢蚁聚侧身行。\n谁人能向循良道，何不留心劝耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予一病七十日心事牢落作诗自解","author":"李吕","text":"抱病懒巾栉，自度作黄冠。\n披褐襟便短，拖鞋步稍安。\n忘机任俗薄，遮眼把书看。\n未必不为福，善乎能自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天章阁成应制次韵","author":"李吕","text":"宝构云屯珍木才，璇题金榜倚天开。\n高连色界非非境，光动星躔两两台。\n上帝图书开玉府，从臣冠佩继麟台。\n诏音亦许赓宸唱，荣胜邹枚后乘陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见菊","author":"李吕","text":"病夫省睡起凌晨，迟菊朦胧破萼新。\n雨细正应添润泽，烟轻尤觉长精神。\n近来霜重伤禾死，几见民忧洒涕频。\n却是东篱剩黄菊，不堪易粟当金银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人次韵","author":"李吕","text":"当时选胜入经营，杖履宁论阴与晴。\n丘壑只应胸次有，溪山故著面前横。\n可怜永隔笑谈乐，何况从来兄弟情。\n岘首人登休堕泪，搅林风雨作秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人挽妻父号道者","author":"李吕","text":"里闬推高足善良，不才何幸玷东床。\n修容方喜超宾馆，奠雁翻成举酹觞。\n晚铎飘声空有恨，酸风吹泪不成行。\n诸郎头角多馀庆，褒赠行看为显扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代怀祖上舅氏","author":"李吕","text":"天上玉麒麟，横秋爽气新。\n书痴心笃好，綵戏日长春。\n直去攀丹桂，须为近紫宸。\n外家多庆事，接武有名人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自南康寄怀朱使君","author":"李吕","text":"过尽重湖复过山，阴凝忽变雪花团。\n路迷曲折易成远，风助横斜巧送寒。\n忆昨片帆离渡口，特烦千骑驻江干。\n如今想在芙蓉观，独据胡床烂漫看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吉祥寺旧名永寿初李昪为徐温养子徐知训不能容置酒欲杀之行酒吏刁彦能以手爪昪悟而逃伏此寺山谷作记无咎书","author":"李吕","text":"招提一径入垂杨，翠竹千竿粉箨香。\n正要银丝好看客，不须雪乳苦搜肠。\n兴亡徐李一弹指，文字晁黄两擅场。\n八十老僧无个事，犹将经卷佞空王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊霍光","author":"李吕","text":"官安胥饮贵仍骄，父子同诛韪孝昭。\n博陆时方专国柄，济阴早已被弓弨。\n老妻安得谋灵妪，劣女刚将冠内貂。\n白去副封奇祸作，后车倾覆更萧条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多病","author":"李吕","text":"守静偏多病，争先素不能。\n材非经世具，分合出家僧。\n利路防深阱，穷居任曲肱。\n息交休扰扰，藏拙要儚儚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"师正堂二首 其一","author":"李吕","text":"物我虽殊理本同，算来身教易为功。\n表端岂但日间影，德盛应如草上风。\n作字心君生笔下，照人眸子验胸中。\n平生得力今拈出，尤见操存合至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"师正堂二首 其二","author":"李吕","text":"颓垣荒蔓几经霜，今喜崇成背郭堂。\n雅欲援琴追宓子，时从退食咏羔羊。\n溪流碧绕如平篆，山木阴连不断行。\n祇恐诏公台省去，空教南国爱甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次涪陵游北岩寺伊川谪居尝传易于此有钩深堂鲁直名且书之故寺有四贤像伊川鲁直康节尹和靖","author":"李吕","text":"隔江定佳处，放艇得幽寻。\n直上云根径，尽行霜叶林。\n昔人非避世，此地可钩深。\n何物能熏染，幽禽亦好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次黄象之韵","author":"李吕","text":"疏山元是读书山，相望麻姑旧醮坛。\n梵刹雄誇今日胜，隐居谁作故人看。\n閒随米运川涂迥，喜入林亭境界宽。\n我已经营谢公屐，伫君好去九迁官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观荷","author":"李吕","text":"适当寒沼上，更在月明中。\n露重鲛珠湿，天高奁镜空。\n参差千盖绿，淡伫数枝红。\n华发秋风里，持杯属老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忧旱","author":"李吕","text":"田圃如燔木叶黄，火轮从早出扶桑。\n伫观罪己侔汤德，更愿求言举汉章。\n冤死岂能无孝妇，当烹应复有弘羊。\n可怜野老吞声哭，此意何由达上苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投赠钱侍郎端礼三篇 其二","author":"李吕","text":"仙风道骨本飘飘，万卷诗书乐一瓢。\n落笔云烟盘锦绣，满腔星斗绝尘嚣。\n悬知可使邦风美，岂但能令国计饶。\n四海徯公归致主，方今天子舜承尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投赠钱侍郎端礼三篇 其三","author":"李吕","text":"天地生成无用躯，青箱世业一愚儒。\n几同海上屠龙术，空守岩前待兔株。\n自信平生非木石，谁怜半世混泥涂。\n幸逢点铁为金手，乞与投身造化炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投赠钱侍郎端礼三篇 其一","author":"李吕","text":"人间富贵岂须论，三百年来积庆门。\n名纪太常高大父，气钟仁祖外曾孙。\n心存忠孝源流远，义薄云天色笑温。\n屈指前时功德辈，悠悠谁似典型存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗勉粹夫进学兼示诸子","author":"李吕","text":"閒忆当年闯孔门，未能无意觉斯民。\n浮名浮利虽关命，多病多愁故恼人。\n九十春光浑易老，二三子者莫因循。\n老夫耄矣诚堪笑，何惜同来试问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣和殿新竹应制次韵","author":"李吕","text":"千竿倏忽散层云，疑有风雷为骏奔。\n峻擢已应烦地媪，巧裁仍复借天孙。\n已惊虎豹留皮处，更看龙蛇起陆痕。\n圣主工夫同造物，坐令温诏发霜根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追挽游大夫","author":"李吕","text":"大夫古君子，不可今人求。\n蝇营鄙世态，贪吟口不休。\n一朝膺事任，卓尔茂勋猷。\n此道今已远，天乎公首丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追挽刘平父二首 其二","author":"李吕","text":"高才入用合求闻，却向丘园号隐君。\n驰骋古人真我事，泥涂轩冕付时人。\n黄粱未熟惊尘世，白璧空埋惨暮云。\n赖得相门馀庆在，诸郎峙玉正诜诜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追挽刘平父二首 其一","author":"李吕","text":"奕世旂常记姓名，屏山道学蔼馀馨。\n流风与世为标的，好义于君见典型。\n琴韵祗求追古意，吟怀偏喜旁林扃。\n相逢恨晚情犹厚，怅望音容隔杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王晋卿赴廷试","author":"李吕","text":"怪底先生思涌泉，少年笔势已翩翩。\n马嘶长道空骧首，龙擘沧波竟上天。\n分付风云身九万，更看礼乐字三千。\n期君未可班行去，细听胪音黼座前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲秉赴廷试五首 其五","author":"李吕","text":"元龙湖海士，可但著茅庐。\n诗老经从地，禹功疏凿馀。\n蜀峰帆影隔，郢树鸟行疏。\n太史行天下，归来好著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲秉赴廷试五首 其四","author":"李吕","text":"一元谁破碎，河洛漏微芬。\n星斗昭乾纬，葩华粲地文。\n班扬浑细事，伊傅有殊勋。\n补履非神剑，相期敬所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲秉赴廷试五首 其三","author":"李吕","text":"欲献琅玕腹，君诗有宿盟。\n云天宸极邃，日月衮衣明。\n太守荐何武，诸公倾贾生。\n三山移步到，寄语问玄卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲秉赴廷试五首 其二","author":"李吕","text":"雾豹文章异，渊鲸爪角雄。\n荒陂寒泣露，空谷暮号风。\n突起能无意，平沉未分穷。\n不知貂冕地，冷砚破窗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲秉赴廷试五首 其一","author":"李吕","text":"乱石搜琮璧，修梧待凤凰。\n地灵真间阔，世眼但寻常。\n我友更谁子，平生唯此郎。\n连城不当价，容易莫商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许尉子云二首 其二","author":"李吕","text":"济人曾现斩蛟手，慢学吴门作陆仙。\n雪月精神资句法，经纶器识得天全。\n评君合在羲皇上，许我难堪叔度贤。\n出处相悬同臭味，寄怀犹望捧来篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许尉子云二首 其一","author":"李吕","text":"秦望排空插鉴湖，先生气禀旧东吴。\n胸中今古几千载，笔下波澜雄万夫。\n綵棒垂门奸自肃，土神应梦昔何殊。\n荣归快作朝天计，台阁欢传得巨儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨文赴廷试","author":"李吕","text":"只今冠盖盛诸杨，连岁科名属雁行。\n笔下戈矛吾退舍，胸中珠琲海倾藏。\n鸡群有鹤人谁识，熊掌兼鱼子厌尝。\n一振斯文千古事，凭君更为引天潢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv"