[{"title":"留别徐斯远时斯远将赴朱晦庵之约三首 其二","author":"赵蕃","text":"君质故甚美，加之仍得师。\n今为李君御，何后老人期。\n念欲通名姓，还忧辱弃遗。\n何当武夷下，与子共追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别徐斯远时斯远将赴朱晦庵之约三首 其一","author":"赵蕃","text":"共有山林趣，相期问学功。\n一官重此去，三径几时同。\n我鬓因诗白，君颜非酒红。\n从游纵有日，羸疾柰相攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题竹隐","author":"赵蕃","text":"逐日身频役，来归岁两徂。\n已悲松老大，更觉径荒芜。\n筑室期终隐，干时耻异图。\n因声里中老，为护竹边雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事","author":"赵蕃","text":"病态与时关，炎凉仅覆翻。\n秋风已吹鬓，沴气尚留根。\n比屋均如此，吾生敢自论。\n苦嗟诗总废，斗水汲深浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其十五","author":"赵蕃","text":"风雨虽如晦，鸡鸣不废晨。\n窗明惊次第，吾卧特逡巡。\n泣豆因煮豆，柏人何迫人。\n为家疑宿业，旧学似前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其十四","author":"赵蕃","text":"雨湿云衣敛，风沉月镜昏。\n谁家宵急杵，何处苦啼猿。\n睡思浑无思，吟魂欲断魂。\n钟声才近寺，鸡叫已遥村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其十三","author":"赵蕃","text":"雨合湍流急，风高松韵寒。\n中宵空耿耿，长夜苦漫漫。\n梦去无多地，愁来匪一端。\n明朝对清镜，政恐觉凋残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其十二","author":"赵蕃","text":"暮与牛羊夕，朝随鸦鹊兴。\n山林真可乐，轩冕梦何曾。\n供给欠升斗，往还无友朋。\n粗成酬二事，老此讵难能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其十一","author":"赵蕃","text":"精庐名负郭，古路别通村。\n落叶多新积，苍苔半宿根。\n杖藜溪见影，步屐雨流痕。\n更羡儿童辈，骑牛不驾辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其十","author":"赵蕃","text":"懒命鸡栖驾，分安龙具寒。\n枕肱朝日美，拥鼻北风酸。\n伪异公孙被，甘同陋巷箪。\n啼号从强聒，忧乐听旁观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其九","author":"赵蕃","text":"丛菊虽云薄，秋花独此芳。\n祇愁霜后槁，宁虑雨前荒。\n蝶冷飞无迹，恐哀咽更长。\n嗟予自失所，对汝益增伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其八","author":"赵蕃","text":"蒲柳望秋衰，风霜况此时。\n人今非少壮，病祇益清羸。\n几诵立名语，频哦看镜诗。\n浮生那足恃，迅景不容追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其七","author":"赵蕃","text":"晚食以当肉，人言蠋巧贫。\n茹蔬何不可，设说未为真。\n既屏猪肝累，何须鲑菜珍。\n夜煨牛粪芋，朝罨破铛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其六","author":"赵蕃","text":"莽莽前山隔，冥冥独树遮。\n断行迷白鹭，垂翅湿归鸦。\n暝色看仍合，羁愁望愈赊。\n不应缘一病，全失醉生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其五","author":"赵蕃","text":"端居念朋友，多病懒书题。\n怀旧频搔首，看云独杖藜。\n鱼沉秋水阔，鸿远暮天低。\n直恐乖离久，相逢老少迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其四","author":"赵蕃","text":"宵晴朝复雨，夜雨晓还晴。\n未识冬天尔，浑疑春令行。\n人人忧疟疠，物物败生成。\n襘法繇来古，官居孰用情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其三","author":"赵蕃","text":"炎凉自时态，何乃战胸中。\n谴句追韩子，辟碑摹鲁公。\n闻尘非为蚁，是境不因工。\n要使神明复，毋辞瞑眩攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其二","author":"赵蕃","text":"汀袍犹拥绿，林幄尚遮青。\n霖雨秋冬接，商飙早晚经。\n枯荄明野烧，槁叶暗深坰。\n荣谢何终极，衰迟孰所令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中即事十五首 其一","author":"赵蕃","text":"半百还过半，平安殊未平。\n饥寒兼抱病，造物此何情。\n讵敢怀尤怨，那能问否亨。\n独怜无以养，深愧下帘生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病卧闻益卿未行不能晤语成四十字","author":"赵蕃","text":"卧听晚来雨，悬知明日行。\n破床空辗转，高论阻峥嵘。\n文选君精理，江西我滥名。\n官曹敢论契，翰墨且寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其八","author":"赵蕃","text":"去矣不为难，山长水又宽。\n未曾摇短棹，已自失危栏。\n厚意烦三友，相要下急滩。\n虽然赊执手，顾免别辞酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其七","author":"赵蕃","text":"相从宁见乐，相别乃知悲。\n况辱平生友，而坚晚岁期。\n已醒临别酒，还读送行诗。\n何况维舟处，苍然暮色时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其六","author":"赵蕃","text":"一纸日边裁，千山徼外开。\n所同惟甲子，绝异是人才。\n学问须传授，君家有自来。\n嗟余独何者，道阻乃从洄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其五","author":"赵蕃","text":"时论归台阁，交情异笠车。\n不甘腰为折，宁使鬓成华。\n莽莽湖之北，悠悠海一涯。\n铜鱼偶逢使，书寄阿戎家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其四","author":"赵蕃","text":"几岁天台住，今年雁荡游。\n心期在康乐，人谓作监州。\n骑从真能屏，烟霞定赏幽。\n他时期一访，好为著诗留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其三","author":"赵蕃","text":"月上侵衣薄，风来飒鬓秋。\n有觞宽偪仄，无意计沈浮。\n谁念千山底，深怀二老游。\n更阑竟忘寝，诗就不成讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其二","author":"赵蕃","text":"雨后林园合，风前裘褐轻。\n当游元不恶，有士与同行。\n定识田中趣，殊胜俗里情。\n谁过江驿静，日听笋舆声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真游觅唐德舆题诗不见有怀其人八首 其一","author":"赵蕃","text":"险绝辰州路，曾闻一再行。\n看岩有留句，扪石欠题名。\n四世斯文事，平生一壑情。\n何当从此去，感念在先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"笔答","author":"赵蕃","text":"拔毛知不免，受缚叹何穷。\n屡沐虽蒙赐，披心每尽忠。\n愤然成臆对，老矣实头童。\n醉素今安在，归真托此公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莘夫再用前韵作诗谢余过其居复用韵答之 其一","author":"赵蕃","text":"漫道平生风马牛，也能历历记吾州。\n相从大胜十年读，肯过轻为一饭留。\n气合未知投分晚，腹虚终苦和诗搜。\n我方羁旅君当去，契阔何时重与游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莘夫再用前韵作诗谢余过其居复用韵答之 其二","author":"赵蕃","text":"盐车骥服驾罢牛，政使斯人此佐州。\n大策本收经济用，三年何有课程留。\n爱其义重云天薄，怜我诗穷肺腑搜。\n子见悬知问何似，为言归决梦成游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫万安以甘雨应候用社日韵作诗见贻次韵","author":"赵蕃","text":"今君忧乐皆农务，信有雨来晴便晴。\n宁似倦游伤偪仄，不堪终日屡昏明。\n归舟净绿不可唾，旧舍小滩浑欲平。\n元是江湖竿钓伴，可须钓叟自为名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫万安要平题知津阁","author":"赵蕃","text":"势并江矶起，檐因佛屋高。\n青罗一萦带，石黛四周遭。\n谓我其留句，谁知老不豪。\n暂来还亟去，岂亦病滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲荡","author":"赵蕃","text":"舟涉越溪悲，梯攀玉井危。\n何如澹成映，更有绿相攲。\n不作骚人恨，频成谢客诗。\n钓船如许坐，蓑笠不辞披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州北崇胜寺二首 其二","author":"赵蕃","text":"故人贻我壁间诗，何处飘零负此期。\n蹭蹬我今惭薄宦，飞腾君合趁明时。\n虽然不用逢人说，老矣何庸觅世知。\n借问还家底为计，儿能樵木妇能炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州北崇胜寺二首 其一","author":"赵蕃","text":"病中曾觅扊扅炊，别后东西无自知。\n似说诸侯枉行卷，却从群彦赴明时。\n相如定辱君王问，郑老宁容尔汝期。\n几欲寄书愁不达，偶因閒暇一酬诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公皆和诗再用韵并属湛挺之七首 其七","author":"赵蕃","text":"旧作游梁倦，今成去鲁迟。\n跳珠先集霰，冻雨乱棼丝。\n萧瑟夜来酒，悲凉别后诗。\n洞庭归雁蚤，枉寄莫迟为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公皆和诗再用韵并属湛挺之七首 其六","author":"赵蕃","text":"投老知何地，此生休问天。\n未须悲坎轲，聊复寄蹁跹。\n但觉官如缚，浑忘诗似禅。\n不堪儿子诵，敢望故人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公皆和诗再用韵并属湛挺之七首 其五","author":"赵蕃","text":"和我閒中句，俱来作者人。\n步吟才勃窣，耸咏忽嶙峋。\n浪说能声喜，端虞试问巡。\n天资固有分，野性杂难驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公皆和诗再用韵并属湛挺之七首 其四","author":"赵蕃","text":"吴楚他乡外，沅湘久客间。\n已知身若赘，讵惜鬓成斑。\n酒债贫常有，诗坛老倦攀。\n穷猿难择木，怨鹤望还山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公皆和诗再用韵并属湛挺之七首 其三","author":"赵蕃","text":"翰墨平生友，江山数面亲。\n诵骚悲楚国，访古失秦民。\n丘壑岂无趣，尘埃空此身。\n风行思数数，粮食厌频频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公皆和诗再用韵并属湛挺之七首 其二","author":"赵蕃","text":"戢戢一天翮，纷纷凡马群。\n回头异生死，对面或公君。\n渐欲薰莸等，反嫌黑白分。\n居然撄众怒，政尔怯孤军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公皆和诗再用韵并属湛挺之七首 其一","author":"赵蕃","text":"谊也期淹速，渊乎任去留。\n服来占夏首，归去及春头。\n岂必忧怀累，当从乐处求。\n控揣终异物，窈窕一孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读子进浙行诗轴中有二诗见寄次韵报之 其二","author":"赵蕃","text":"何夕佳风月，仍陪笑语清。\n依依数行李，了了尽平生。\n要使交游态，浑如手足情。\n居閒有此乐，那用占时名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读子进浙行诗轴中有二诗见寄次韵报之 其一","author":"赵蕃","text":"近有平安使，新诗得尽传。\n深怀行役苦，更忆弟昆贤。\n笠水鸱夷子，荆溪玉局仙。\n经行如有访，小为系归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读山谷文","author":"赵蕃","text":"深居度日浑亡赖，小役踰旬抑又疲。\n到处青山恃青眼，随行黄卷有黄诗。\n少陵授受后千载，此老风流彼一时。\n众作沛然虽莫禦，要云万折必东之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读东坡和陶诗","author":"赵蕃","text":"食已无馀事，坡诗信手翻。\n飘零落蛮蜑，收拾重玙璠。\n未易穷关键，才能味语言。\n向来陶谢并，今日要重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读东湖集二首 其一","author":"赵蕃","text":"世竞江西派，人吟老杜诗。\n五言真有律，徐稚是吾师。\n不但时相似，还能猛出奇。\n平生误学处，深恐不能医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读东湖集二首 其二","author":"赵蕃","text":"赖尔破孤闷，读之惟恐残。\n行间虽旧熟，句外得新看。\n已后平生学，悬知欲到难。\n堂堂宁复有，凛凛故疑寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读林子仁诗","author":"赵蕃","text":"连林泥滑滑，遍地苹青青。\n多病愁难却，春风梦已经。\n曾过蕲水郡，不见少微星。\n独行惭方驾，清诗许乞灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"课诗","author":"赵蕃","text":"滩长有馀逸，滩迥不胜迟。\n山帽堆云絮，水纹飞雨丝。\n鸥鸣如避弋，鸟倦盍投枝。\n无计繁忧整，聊因课小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贾丈用昂字韵作诗中有见及复用韵奉呈并简徐谢二丈","author":"赵蕃","text":"人谓先生老，诗坛近一昂。\n共知文力健，何有鬓毛霜。\n自料才非敌，从今气减狂。\n同宗有徐谢，我亦漫窥墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通问赣州留尚书并寄三首 其三","author":"赵蕃","text":"陛下胡为先一州，是公岂合久诸侯。\n东江西江水且涨，南山北山春正浮。\n促席久思宣室问，都人愿睹翰林游。\n我家怀玉山之下，亦拟探奇谒道周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通问赣州留尚书并寄三首 其一","author":"赵蕃","text":"去冬曾作送行诗，岂料重临岁甫移。\n盍遣德星均四海，愿令竹马快并儿。\n使君不独符仍剖，刺史还闻节再持。\n吏治久安民则化，九重于此有深思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通问赣州留尚书并寄三首 其二","author":"赵蕃","text":"畴昔王门耻曳裾，每怀端拜献公书。\n简编讫补遗忘后，馈赆分沾忧患馀。\n只信此心无改事，讵知彼谮欲何如。\n属闻盛府重开幕，适此故山归驾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铅山道中怀故兴化令贾元放故郁林教授贾季承","author":"赵蕃","text":"驶雨更冷风，长松十里中。\n欲吟吟不尽，将语语谁同。\n赋鵩人安在，骖羸我欲穷。\n枕流还泊泊，幽梦恐难通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"赵蕃","text":"阴云不肯放朝阳，雾雨真成作早霜。\n窗静网丝萦棐几，壁疏虫语撼藜床。\n故人秦越自肥瘠，世事鹤凫随短长。\n病不衔觞惟觅句，不须吟咏转凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"赵蕃","text":"落尽群芳未肯晴，重寻破褐尚寒生。\n风轻檐庑频来燕，雨合林园未有莺。\n慷慨董生悲不遇，萧条靖节赋閒情。\n倚楼看镜徒增叹，散发采薇真是清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作二首 其二","author":"赵蕃","text":"未仕思从仕，言归盍赋归。\n世方疏直道，身亦堕危机。\n旧宅存松桂，春山富蕨薇。\n渊明觉今是，伯玉悟前非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作二首 其一","author":"赵蕃","text":"旧箑已成挥，还披御腊衣。\n乘除固人事，变化亦天机。\n道路飘零久，形容少壮非。\n无徒微禄眷，长与故人违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"堂下梅一枝开迟而花极小疑地势使然感叹而作","author":"赵蕃","text":"梅发无衰盛，根生有瘠腴。\n都缘托地薄，故使著花癯。\n渺小吾怜尔，伶仃尔念吾。\n讵须诗欠兴，何用竹相娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿永福院","author":"赵蕃","text":"白塔转青林，微闻谷鸟音。\n行馀四回顾，风至一披襟。\n半日春游当，劳生落景沈。\n眷焉聊税驾，老矣盍抽簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿龙须山 其一","author":"赵蕃","text":"俯仰犹前日，侵寻已半春。\n行因累符檄，来为阅松筠。\n著脚尽可隐，是身宁属人。\n云泉混麋鹿，冠剑上麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿龙须山 其二","author":"赵蕃","text":"密竹复疏竹，老松仍稚松。\n担肩元近俗，吟趣得深供。\n要宿招提景，犹赊日暮钟。\n殷勤问邻寺，指点说前峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿柞树下见赵行之所题诗","author":"赵蕃","text":"人道朝霞不出门，今朝失喜见晴暾。\n长林未减霜前翠，叠巘全收雨后昏。\n兀兀不知为底日，悠悠又复度前村。\n眼明见此壁间句，回忆东江数过村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿野人家","author":"赵蕃","text":"凛若将崩石，狂哉既倒流。\n诗危欠好语，日晚觅安投。\n劳我行何苦，嗟渠戍未休。\n田居与官籍，俱坐有身忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿彭湖寺怀斯远","author":"赵蕃","text":"路仄山崖滑，庭中桂树苍。\n骤冲疏雨过，徐步晚风长。\n沽酒寻官道，哦诗绕佛廊。\n旷怀思我友，林趣忆支郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]