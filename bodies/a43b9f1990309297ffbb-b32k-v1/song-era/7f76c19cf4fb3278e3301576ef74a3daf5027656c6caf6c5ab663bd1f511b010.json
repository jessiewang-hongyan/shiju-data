[{"title":"再次韵子仪侍郎用沈察院韵","author":"许及之","text":"杜宇来时忆故山，簿书丛里且闻閒。\n流传旧体湖山外，赓唱新声伯仲间。\n雨霁园林莺亦喜，风轻帘幕燕知还。\n苏公堤上明寒食，逸驾翩翩不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次王宣甫韵","author":"许及之","text":"一春无计接茵凭，野草閒花漫自荣。\n留得小栏红药在，待看新径绿阴成。\n亦怜酒盏疏谈柄，肯寄诗筒督课程。\n多病感君勤问劳，肱三折后万缘轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重阳前两日集转庵同社而今日忽雨次转庵韵","author":"许及之","text":"搀先登眺高为节，片段芙蓉锦作花。\n赖得前朝曾此集，有如今雨欲何加。\n欢浓未分玄成白，客醉犹怜酒胜茶。\n犹恨梅川无好句，更须君赋为传誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次常之韵","author":"许及之","text":"身閒城市即郊坰，况是秋高气倍清。\n酬唱篇章惊句眼，往来节物见交情。\n重阳槛菊明朝摘，细雨檐花昨夜鸣。\n晚霁嘉宾不重赏，灵山空自爱嘉明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄陈颐刚","author":"许及之","text":"眼见交游半陆沈，可无百丈引清深。\n注成兵法有奇志，閒过壮年应苦心。\n几度梅花开怅望，有时杨叶梦追寻。\n男儿机会何终极，莫遣愁将鬓发侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简转庵","author":"许及之","text":"扣门有碍吾何适，排户顿疏君作难。\n不对桃花倾社酒，谁怜燕子怯春寒。\n便过熟食过元巳，尚看酴醾看牡丹。\n却笑今年诗厄闰，略无好语入毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简才叔","author":"许及之","text":"坐看母竹长龙材，衣上新痕染碧苔。\n杜宇不随春老去，黄鹂偏傍水光来。\n摇摇书带连香草，冉冉凌霄上古梅。\n此意转庵同领解，更须潘令好怀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入南乡检旱纪所见","author":"许及之","text":"分宜南北两乡分，路入南乡过所闻。\n荞麦满山明积雪，晚禾匝野涨黄云。\n寸田必垦怜农父，五斗空餐愧令君。\n惜许早田成旱损，不成乐岁答民勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪所见","author":"许及之","text":"百年厦屋尽良材，客位经年长紫苔。\n失马塞翁翻有得，抚松陶令盍归来。\n门前婀娜千行柳，墙角轮囷一树梅。\n满壁图书非诧事，锦囊成箧未曾开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜渡分宜水南","author":"许及之","text":"一水弯环抱县流，水南物色总清幽。\n案头故纸看成叶，眼底青山见即愁。\n夜唤扁舟乘月渡，静听鱼网沥波收。\n忽思孤屿中川畔，满意秋风落钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"括苍道中次陈颐刚韵","author":"许及之","text":"诗翁四十九行年，说著行边喜欲癫。\n介妇滩头随水宿，冯公岭上伴云眠。\n趋时萍实甜于蜜，阅世匏壶老更坚。\n冀北须君空一洗，眼前驽马太劳鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿建德驿追次张于湖壁间韵","author":"许及之","text":"此驿阅人多似我，于湖去后有谁来。\n诗留版壁经年在，门对岩扃尽日开。\n天上有文修白玉，人间无句对苍苔。\n相逢莫问滔滔事，荷蒉曾过有意哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行早起处州溪上","author":"许及之","text":"溪容雾气扑清芬，野色微兼晓色分。\n樯表已迎山背日，缆端犹系石根云。\n打头风信看来转，当面滩声语不闻。\n遥唤渔舟倦回首，人鸥那得更同群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早起","author":"许及之","text":"归来百事尽摧藏，卦气行年分所当。\n未晓不眠真是老，才明便起有何忙。\n移山种石愚翁癖，遇酒逢歌楚客狂。\n此外胸中无个事，有时信口作篇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起","author":"许及之","text":"饭了晴窗睡足时，杖藜徐步出荆扉。\n若无俗事关人意，只有杨花点客衣。\n黄鸟怨春浑不住，杜鹃知我亦思归。\n邻家酒熟容赊买，竹笋初生韭菜肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书债山积久逋余丞相报缄连发二书毕喜作口号","author":"许及之","text":"自思堪笑亦堪怜，懒与顽兼不可镌。\n两纸书成大功业，三杯酒罢小神仙。\n每当静处常追悔，何似閒时旋补填。\n害性苦心从古病，不如归去乐残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汤晋卿善谈命求诗纪实","author":"许及之","text":"已近无闻半百年，枉烦明镜照华颠。\n湴河驿马妨乘鄣，氐宿苍龙分委天。\n告我三阳闻好语，验君三命有真传。\n预愁一字终无补，何日归欤阿对泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德久和韵以予请外之力预为怅然再用前韵","author":"许及之","text":"已是于思去复来，自惭无补效涓埃。\n粗官只合供烦使，昭代惟须急异才。\n名士不应诗作祟，诸公方拟管吹灰。\n且容一舸江湖去，庐阜烟萝锁碧嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"才叔调倅归","author":"许及之","text":"五月征行思竹院，半年赓倡负松庐。\n水西风月分归后，巷北交朋过访馀。\n携具洗泥曾醉否，逃禅得句定真如。\n涉斋终日攒眉坐，正赖清新为起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病赤目从薛山甫借荷叶巾","author":"许及之","text":"赤目朝来势转加，病身观妄有生涯。\n火平文武宽心地，酒远圣贤疏肺家。\n虚白已能生暗室，空青不用点昏花。\n小冠预拟更名字，借与团圆藕叶纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲归病中垂问","author":"许及之","text":"痼疾多年久一翁，医方验后自难功。\n已惭兀者犹尊足，敢企泠然欲御风。\n觅句未能生处熟，论交正要苦辞攻。\n凭君莫话沙堤事，此语终谀不是公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵呈支茂先贤良","author":"许及之","text":"烟蓑不尽四山青，古道长将古意评。\n辟谷久知疏药裹，纂言今见满书檠。\n尧年请祝新抛隐，宋范争抄近荐名。\n圣世埋光那可得，清台恰奏少微明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜宣甫至戏呈","author":"许及之","text":"陶溪路远强跻攀，犹得诗筒暂往还。\n有便催租俄败意，无心听鹊忽承颜。\n菊花满径成三老，梅萼穿林见一斑。\n肯为转庵聊且住，预愁约束裹粮悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次王宣甫题媚川图韵","author":"许及之","text":"底须屏障写天吴，绝境横前与画俱。\n两塔屹波流不去，千帆破浪远如无。\n空明水月光争媚，开阖云山妙莫摹。\n扁榜首蒙摩诘句，小亭从此有诗图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韩干四马诗戏赠世京","author":"许及之","text":"吾闻北马来西极，骧首蹑云无定姿。\n俯视双瞳真皎镜，遥怜一骨独权奇。\n何年惨澹经营处，此日飞扬奔放时。\n把玩不须嗟岁晚，会看天厩著金羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢鲍潮州惠归正李媪所作外国图因题卷后二首 其一","author":"许及之","text":"两年贰郡半专州，濠上鱼涵惠泽游。\n慨念中原变荆棘，图成外国别冠裘。\n故宫禾黍悲清汴，落日风沙惨白沟。\n汉节提携曾记别，居然展卷涕横流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢鲍潮州惠归正李媪所作外国图因题卷后二首 其二","author":"许及之","text":"健妇真能胜丈夫，丹青人物妙难摹。\n百年画手承平久，万折归心守节孤。\n辄此珍藏为我有，从渠远致更能无。\n伤心故国流风在，不是成周王会图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题元祐诸公跋窦三川诗卷后","author":"许及之","text":"门前流水古犹今，不见钟期但苦心。\n每忆承平爱人物，有谁埋没向山林。\n一官黄绶甘肥遁，百首清诗共赏音。\n自笑抱关人录录，亦将名字托碑阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲归渔父","author":"许及之","text":"风静波恬没是非，雨蓑烟笠当冠衣。\n移将兰棹垂纶去，钓得金鳞带月归。\n到处茅柴赊可准，有时莼菜滑仍肥。\n旁人道是忘机叟，到底从来不识机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王宣甫以新妇鱼能斗为胜负鱼有诗释其讹谬次韵戏答","author":"许及之","text":"斓斑红黛斗芳塘，新妇鱼儿著底忙。\n岂为长陵矜先后，不知濠上乐彷徉。\n诗来解辨吾伊谬，我欲兼将胜负忘。\n蚌鹬相持堪惜许，须知旁有谢三郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻砧","author":"许及之","text":"秋来风物自凄清，叶叶枝枝策策鸣。\n近砌不堪催织语，远砧更送断肠声。\n苦心且作丁当和，积恨终凭熨帖平。\n寒女终身无褐彩，绮罗通夕课寒檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观郭殿岩打毬于冲天观旁","author":"许及之","text":"峰顶毬场剪似平，汾阳号令素精明。\n万蹄攒逐一星过，两队欢呼众乐鸣。\n静看穿杨矜妙手，醉观过翼觉身轻。\n摩挲亭下排衙石，拟赋将军射虎行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听转庵弹琴","author":"许及之","text":"竞春人去客苔侵，喜对安仁理玉琴。\n百尺游丝非助我，一声啼鴂是知音。\n湘桃作意红兼白，碧柳随宜浅更深。\n昨日胭脂今日雪，可怜墙角两来禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲归观弈","author":"许及之","text":"绿阴昼静熟观棋，横出宁分正与奇。\n要处不容留活眼，忙时翻笑敛愁眉。\n手谈大似衔枚战，坐隐几同过枕师。\n著罢了然无胜负，机心却许白鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬转庵畏酒之什","author":"许及之","text":"绝境夤缘有路攀，隔波楼影塔中间。\n才收梅溽经旬雨，已放莲峰几朵山。\n胜处得閒真阆苑，醉馀忘世即函关。\n诗高不饮妨何事，恐对湖光自忸颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢鲍潮州送新酒","author":"许及之","text":"浊醪青蕊作重阳，才入开炉月果良。\n佳酿遣销彭泽恨，好怀肯对马军尝。\n清新有句须留待，风味如君不可忘。\n只俟高轩共杯酌，四时岩桂尚能香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还杜叔高诗卷送酒","author":"许及之","text":"三衢三杜人能说，我亦曾窥仲叔间。\n软语接来真有味，好诗吟到祇如閒。\n名场偪仄云垂翅，泽国冥濛雨蔽山。\n不有客楼何地著，可无尊酒破天悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬显庵寄茶","author":"许及之","text":"显庵多别又多年，小草蝇头越瞭然。\n觅句不为禅所缚，住山长是佛相怜。\n无从饮酒过莲社，尚肯分茶到玉川。\n肉食正惭无补报，归心已驶不须鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑文之许惠乌髭方戏简","author":"许及之","text":"堕甑功名久任缘，形骸老丑孰蚩妍。\n了知白发关吾事，敢学乌髭趁少年。\n人谓黄金容可作，君藏鸿宝乃能铅。\n一皤正博妻孥笑，许惠良方试与传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王宣甫以予有诗求郑文之染髭法与其旧作暗合因录示次韵酬之","author":"许及之","text":"细看绿绕与红围，此地何曾著白髭。\n顾我全惊缁鬓改，羡君犹有黑丝垂。\n一皤博笑几同调，两丑相看莫敛眉。\n正使醉中巾帻堕，不妨齐唱赤壶词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏赠","author":"许及之","text":"不鼓君家爨下材，渴心古井欲生苔。\n柳枝未放行云去，巫峡又还为雨来。\n似染霜髭欺黑漆，尚禁醋齿试青梅。\n不妨雨过同心赏，一架酴醾花正开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三赓许令侄砚之什","author":"许及之","text":"转庵蓄砚有奇材，受墨逡巡落海苔。\n异品已堪相甲乙，馀波足可畀云来。\n许分阮侄邀金竹，预想将军慰渴梅。\n尤物匪珍才可惜，芝兰正要满庭开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王宣甫谢笔","author":"许及之","text":"笔冢前头几泣鱼，笔耕无获匪才疏。\n寄将毛颖烦为传，恰值虞卿正著书。\n千兔难酬终送似，两家托契更谁如。\n词章老去输豪放，琼玉从君要佩琚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢益老寄英石","author":"许及之","text":"淡交如水足生平，晚岁烦师托石兄。\n曾解点头听半偈，定能发笑验三生。\n丛林住遍归来好，长物分将过去轻。\n闻道肯为邻舍佛，锦衣只在雁山行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"旧藏英石沈俭夫族人处谢俭夫转为取还","author":"许及之","text":"百好残年心已灰，石君久去绝嫌猜。\n故人诺重金难比，族里言温璧径回。\n曾与话禅听翠竹，亦资醒酒卧青苔。\n如今相见休相叹，各是因人归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"济叔辍案上石菖蒲为惠石与菖蒲俱佳拙语奉酬","author":"许及之","text":"苍然拳石具林峦，上有菖蒲八节滩。\n洛浦毵毵馀玉佩，蓝田拂拂长琅玕。\n著身便恐移天姥，濯发还疑借洧盘。\n割爱赠予铭座右，斓斑鬓影照应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺太庙产芝草","author":"许及之","text":"太室晶瑩粲玉芝，慈闱恰遇未央时。\n两宫喜色腾尧采，万岁欢声动汉卮。\n发祉有来增裔叶，产祥方至在孙枝。\n从今庆事频频有，准拟赓歌剩赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得禁中花喜而有作","author":"许及之","text":"阶前红少绿多时，尚有名花巨压枝。\n珠璧直疑天上得，琼瑶难报世间奇。\n悬知丹禁莺花绕，始觉仙家日月迟。\n珍重十洲蓬岛客，津津喜色见双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵宣甫探梅","author":"许及之","text":"姑射山头冰雪姿，自应不负岁寒期。\n一枝已共巡檐笑，半树宁忘欲雪诗。\n未许佳人和月摘，且容老子受风吹。\n城中诗社新牢落，绝喜陶山慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王宣甫催梅","author":"许及之","text":"摇落驱驰自岁年，今年惭愧得身安。\n小园亦有先春意，短思惟知著句难。\n看水看山从昔好，爱风爱雪待今寒。\n故人远寄催梅作，唤起新愁有万端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次王宣甫韵","author":"许及之","text":"江南春讯漫年年，月下推敲句未安。\n好语得来元不易，爱花开后却无难。\n霜晴屋角偏先暖，雪色枝头已破寒。\n为向催梅居士语，杖藜肯复过苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王宣甫催梅","author":"许及之","text":"犯寒时访岁寒姿，经闰何缘却后期。\n珍重故人勤问讯，剪裁新意作催诗。\n一阳潜与飞灰动，九奏深凭画角吹。\n莫遣诗筒成断绝，日来频为起愁思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初得梅花呈似参议刘二十九丈","author":"许及之","text":"江南驿使是知津，剪送琼枝裹绿筠。\n触发家山春意思，唤回天地雪精神。\n护持惟有壶瓶水，映带全无几案尘。\n一夜梅坡清入梦，不妨持恼谢岩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张舍人惠古梅酬以拙言","author":"许及之","text":"孤标耻付寿阳妆，薜荔为衣藓作裳。\n映竹蒙茸初破白，倚松鳞甲亦生香。\n分无疏影追同辈，肯逐群英殿后芳。\n珍重折枝烦寄与，恍思千树故山旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵奉酬","author":"许及之","text":"未信时新有俭妆，缟衣趺坐赤帷裳。\n已甘槁项终肥遁，无奈酸风发暗香。\n心苦故应如貌古，林深正不为人芳。\n须知已是丈人行，领略群英顾在旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同寮约过包山因问讯玉津牡丹再次韵呈子仪侍郎","author":"许及之","text":"传闻有约过包山，节遇天祺得暂閒。\n便有啼莺迎柳外，不妨飞蝶导花间。\n东吴壮观随潮长，西洛风光指日还。\n独恨微臣无补报，勋名分寸盍跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢惠牡丹","author":"许及之","text":"未叹春光去有涯，诗翁时为送名葩。\n娼条冶叶从过眼，魏紫姚黄始是花。\n洗涤壶瓶晨井水，护持风雨夜窗纱。\n十眉已觉成羞涩，且向樽前领物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵漕从善送吴门牡丹","author":"许及之","text":"看花檐上眼长寒，惭愧邻翁送牡丹。\n和露擎来香可染，拢云争插玉成团。\n传闻西洛名千变，排释东风恨万端。\n茂苑去天真尺五，羡君花信报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芍药","author":"许及之","text":"扬州千叶旧生涯，诗到坡仙正复葩。\n喜见故家翻瑞药，送将新句续名花。\n日高髲剃醺含露，时样梳妆肉映纱。\n窈窕留春春不住，诗翁留得鬓边华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵","author":"许及之","text":"莫问无涯及有涯，眼前万绿替千葩。\n故人访我跫然喜，小阁留春圣得花。\n美酒急倾门候钥，清歌未彻烛笼纱。\n匆匆似此频能过，犹胜逢人说梦华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三用韵","author":"许及之","text":"绿遍山颠与水涯，苦吟且不到春葩。\n新篁已接三竿日，红药犹开四月花。\n好句更烦衔两袖，嫩寒犹觉怯重纱。\n留连小饮无须醉，明月翩翩扈翠华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花药相接可观复用韵","author":"许及之","text":"净尽天香溢夏寒，满奁谁掷狡仙丹。\n洛花不逐林花老，禁药犹堪木药团。\n试问丁香和恨结，何如萱草破忧端。\n翠屏红粉腰如束，我是村中老谢安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"传芍药复用韵","author":"许及之","text":"阶药留春逗晚寒，鬓丝敢傍脸霞丹。\n肯分骑鹤红千叶，喜见盘龙绿一团。\n妖格流传如有恨，狂香横出亦无端。\n慇勤为换瓶中水，排比窗前两行安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]