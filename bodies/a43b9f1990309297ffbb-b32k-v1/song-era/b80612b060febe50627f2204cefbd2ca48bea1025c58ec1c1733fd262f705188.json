[{"title":"观山郊阅武 其二","author":"李复","text":"榆落山连垒，川平水带城。\n张兵图野旷，吹角怨秋清。\n移帐高云动，开镡碧海惊。\n归风回胜气，西北埽欃枪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梅","author":"李复","text":"轥藉霜威欲断肌，傲霜挺挺发南枝。\n微风披拂香来去，皎月勾添光陆离。\n已入鸾台弄妆手，犹存谷口出尘姿。\n苦无疏影横斜句，深愧林逋处士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过万泉县","author":"李复","text":"邑屋连山麓，萧条去路斜。\n卤田无美井，旱港足飞沙。\n逃室多攲栋，残林有断槎。\n荒墟人不见，墙角自开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过天门关","author":"李复","text":"龙钟双袖马骎骎，来往榆关日向深。\n多病出门愁远道，早寒平野苦层阴。\n泉流危栈新冰滑，风入长林暮叶吟。\n触目凄然何所补，高枝巢稳感归禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过叶县","author":"李复","text":"南对黄山百里峰，双溪夹路碧溶溶。\n难追旧事飞仙舄，但有馀风喜画龙。\n柳际秋晴分䆉稏，亭阴晚色见芙蓉。\n襄城已远方城近，图志分疆入楚封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过李氏园","author":"李复","text":"伊川北首始知春，问路停骖仆候门。\n垂柳万颦梅一笑，苍松四出石双蹲。\n高人旧隐家风远，祥兆开先国邑尊。\n昔岁往来曾驻跸，从臣遗刻在云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过沔池驿","author":"李复","text":"崤陵皋墓几摧轮，秋暮重过白发新。\n小雨廉纤能滑径，乱山回互欲迷人。\n客心苦厌孤程晚，驿舍频来旧吏亲。\n明日问途知更远，又须呼仆待初晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过黄牛峡","author":"李复","text":"转首黄牛百里西，便风不断满归旗。\n青山随客岂辞远，白浪催船常恐迟。\n多米渐闻荆渚近，故宫欲问楚人知。\n今朝共话平安喜，更得长鱼伴晚炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初至郑州","author":"李复","text":"二年青海困征鞍，归望天威咫尺间。\n雨露忽颁西辅印，鸳鸾阻缀紫宸班。\n往来扰扰无虚日，应接纷纷祗强颜。\n吏责无穷人事拙，梦魂时到旧家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别夔州众官","author":"李复","text":"半年渔浦巴城守，两任云台太华宫。\n岂欲背时聊免俗，但能省事略成风。\n玉泉古刹须留客，峡水安流好向东。\n祖帐联翩催棹急，临溪洒泪落丹枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴安老罢制举赴安吉任","author":"李复","text":"南北飞鸿迹影孤，青衫相见十年馀。\n中铨简士归绳墨，小邑沉才谨簿书。\n游刃屠龙传世学，飞章荐鹗待公车。\n太平藻绘须文彩，今日何人诵子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中独坐","author":"李复","text":"高树风轻叶影齐，新荷破卷绿犹低。\n日长松下少人到，坐久竹间闻鸟啼。\n万里惊波逢宝筏，百年病膜快金篦。\n虽知赤水遗珠在，问路襄城举世迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李无玷自左正言出守永州召为吏曹外郎尚阻叙旧先贻此诗","author":"李复","text":"初伏青蒲拜皂囊，忽驱五马下潇湘。\n入承上閤尚书牒，分掌中铨吏部郎。\n焚藁旧垣犹寂寞，拱枢列宿顿辉光。\n闻归未便能倾倒，五日朝班得缀行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李氏园","author":"李复","text":"城近斜临南郭路，地宽分得奉诚园。\n垂竿引水穿回径，种竹成阴补坏垣。\n晓露不收荷已败，新霜将落柿初繁。\n天晴野旷秋风厉，借榻虚堂负午暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜城陈文惠公园","author":"李复","text":"杜曲西游访物华，门前潏水渌涵沙。\n南城天近无双誉，北斗魁前第一家。\n当日不知龙卧久，今朝空羡桂交花。\n高文遗墨皆漫灭，林下祠堂春日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还王天倪诗卷","author":"李复","text":"素尚跻遐旷，平生厌浅浮。\n锦囊刀尺古，江渚蕙荃幽。\n翘首孤云远，疏林暮叶秋。\n十年人不问，寂默老荒丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆浑王秀才园","author":"李复","text":"两岁伊川拥传行，往来屡喜访云扃。\n四时溪水喧岩石，六月山阴满户庭。\n每到似开双眼翳，久居应涤百骸醒。\n露香浮座供宾饷，凉叶生风野草青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈再有诗诮梅开晚戏酬","author":"李复","text":"漠漠飞香散不收，无言对客似含羞。\n虽非雪里孤根暖，却免黄时细雨愁。\n争意竞先多浅俗，高情持重自风流。\n一株又见垂垂发，肯学江边取次休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京西初归作","author":"李复","text":"少年轻喜欲凭虚，误落尘中二纪馀。\n生事萧条寒叶散，故人寥落晓星疏。\n残骸已脱风波晚，清枕方回醉梦初。\n却觅渔蓑寻旧钓，一溪烟雨伴春锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和秦倅陈无逸观梅","author":"李复","text":"渭水冰消意始回，肌肤玉雪本仙材。\n江南气暖常先见，陇坻山寒不易开。\n二月莫伤春色晚，一枝岂待岭边来。\n风光切莫轻流转，未放悲云画角哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵答俞承议","author":"李复","text":"南北相望已十年，白头相见喜留连。\n风埃异国君多感，朱墨劳心我自怜。\n事可寸心能有几，生无百岁漫忧千。\n一闻新赋思归去，韦杜溪边访旧田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵酬张公燮","author":"李复","text":"城下清溪照病容，溪边开席豆笾丰。\n故应举酒殷勤处，欲慰疏花索莫中。\n短发萧萧羞帽侧，强颜咄咄学书空。\n青山行卜他年乐，深结茅庐访德公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵酬蔡阳叔赴永倅留别","author":"李复","text":"朱绂翩翩别乘行，候人楚语喜秋晴。\n君山木落洞庭阔，帝子魂归湘水清。\n曾叹选官称一字，旧闻世誉重三明。\n啜醨若访垂纶客，苇岸夷犹鼓枻声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人汰竹","author":"李复","text":"与世论交独厌数，此君多冗岂无烦。\n欲期虚静延清影，莫懒芟除去恶根。\n渐见远山开晻霭，更无繁鸟乱黄昏。\n直须放手留閒地，别待春雷见子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尹宗闵书记四月二日候客溪上潞守李献甫具饭有诗","author":"李复","text":"溪园经岁不曾开，逸兴何妨候客回。\n春色堂堂辞我去，暑风咄咄逼人来。\n追凉故绕池边树，分坐时侵石上苔。\n皂盖归城鱼鸟乐，更延虚静独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘丈招与康集同游韦杜","author":"李复","text":"潏水桥边纵客车，去天尺五访寻初。\n按图韦杜风烟在，遗址隋唐锦绣馀。\n雨后晚花寒寂历，霜前老树半彫疏。\n松间有酒来招我，远约相依造隐庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘君俞游华严寺谒文禅师 其一","author":"李复","text":"华严法界出诸天，帝网重重绝世缘。\n昔有高僧开宝刹，今留飞阁耸琼田。\n身游色相无穷境，心悟虚空不住禅。\n碧眼胡人香一炷，分来今欲对师燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘君俞游华严寺谒文禅师 其二","author":"李复","text":"灵山胜致古今同，下种开花一线通。\n岘首道安酬凿齿，江西马祖对庞翁。\n圆珠迥耀千渊黑，滴乳微倾六斛空。\n我有宿缘香火念，閒来相与论幡风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孙俣朝奉立春","author":"李复","text":"闰馀随腊报迎春，便觉勾芒令有神。\n流转光阴频著物，峥嵘岁序苦惊人。\n花装宝蜡馀枝弱，菜点彫盘小绿匀。\n从此试听枝上鸟，渐传芳信语言新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和成季","author":"李复","text":"芸阁磨铅勘旧经，昔闻同舍此同升。\n九楹置榻从颓偃，百尺浮空远湿蒸。\n玉鲙堆盘鱼胜雪，绿荷倾饮酒凝冰。\n家风牢落承推奖，深愧龙门昔有膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱公掞给事喜雨","author":"李复","text":"喜雨高吟夜不眠，飘飘秀句选青钱。\n已推覆斗占穰岁，谁事操豚祝下田。\n满泽新秧初放溜，连云高树欲生烟。\n未知美价堪多少，洗尽人间苦暍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱给事上元早雪","author":"李复","text":"玉花清晓作馀寒，云暗重城晻霭间。\n初逐细风飞寂寂，旋随小雨润斑斑。\n万家灯火方行乐，九陌轮蹄肯放閒。\n向晚霁开斜照在，门前柳色未藏山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和江晦叔喜雨","author":"李复","text":"千里人怀闵旱心，轻将岁事叩天阍。\n骤倾江海繁声合，尽涤山川沴气昏。\n官责时丰聊共喜，归休兴动欲谁论。\n更思田父相邀乐，步屧春风倒社尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张裁推官游湖","author":"李复","text":"閒弄香兰楫，斜开紫绮襟。\n回风收雨脚，静月到湖心。\n高柳留疏翠，前山动夕阴。\n兴来行处惬，乐罢感还深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和进樱桃上宣谕近臣洛中今年进樱桃甚大当日分赐","author":"李复","text":"四月樱桃始烂红，拜章驰驿岁常同。\n留都旧事修邦贡，荐庙清朝广孝风。\n翠笼摘从西后苑，彩奁进入大明宫。\n近臣曾见天颜喜，清晓分颁到省中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周湜雪 其二","author":"李复","text":"六合天人竞散花，坐惊门地亦清华。\n川原霁后龙鳞出，岛屿平时鸟篆斜。\n秀发园林春万里，寒生楼观月千家。\n待看阳律还暄早，破润乘凌见翠牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周湜雪 其一","author":"李复","text":"云表争飞镂玉花，冲烟照水弄光华。\n遍妆庭树能多巧，乱入风帘不奈斜。\n漠漠杨花迷客径，纷纷蝴蝶满人家。\n寒檐向晚凝清滴，乳洞春硝长马牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周湜雪 其四","author":"李复","text":"毰毸乱舞出烟林，落久临阶试浅深。\n平尽高低宽眼界，放开虚白见天心。\n狂倾月窟愁将竭，厚压坤舆恐未任。\n润泽功成本无迹，便回春意欲同寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林次中秘阁题五龙庙","author":"李复","text":"头角蟠潜岁月沉，腥风不散古祠深。\n曾闻惊电开岩壁，常见屯云宿殿阴。\n苍蜴吐冰藏暗穴，彩虹收雨出长林。\n荒碑磨灭无遗事，犹冠龟跗压翠岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范君武出郊","author":"李复","text":"九月天高客喜晴，篮舆因兴度溪行。\n身逢乐岁留漳浦，心逐秋风入渭京。\n日暖登场多稼熟，桑阴具饷野盘盈。\n丰年社后多馀酒，处处神林箫鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡吏部醇夫","author":"李复","text":"妙语飘飘慰旅穷，自怜饥味得甘丰。\n朱弦恨废高山久，明月惊投按剑中。\n垂翅为逢勍敌勇，倾囊但愧鄙夫空。\n相从知便忘形迹，一鹗先曾玷至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡漕斗茶分药","author":"李复","text":"万里飞香入晋山，高真秘箓露谈端。\n春雷发地岩惊绿，夜鹤飞坛鼎转丹。\n仙桂清风生两腋，玉壶五色抱神丸。\n虚谈论罢无尘事，林外娟娟月半残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和夏日园中即事","author":"李复","text":"雨过深园暑气清，拂云松竹映重阍。\n预期节物移承露，自验方书采合昏。\n片影有缘聊暂寄，寸心无事得閒论。\n风光未信随流转，犹见飞花落酒尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐发承议怀归","author":"李复","text":"骎骎长路倦羸骖，搔首飞尘苦战酣。\n猿过故山惊晓帐，苔生旧钓暗秋潭。\n土风膏润田耕熟，物意清幽井汲甘。\n一别几年劳客梦，会携藜杖破晴岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郭户部中秋月","author":"李复","text":"重云宿霭风收尽，千丈银毫吐海涯。\n露气洗开青玉阙，龙宫浮出白莲华。\n寒惊栖鹊翻庭树，阴引灵珠耀浦沙。\n我是襆巾修月手，玉皇应许上仙槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韩丞相玉汝登见山阁","author":"李复","text":"丹青岌嶪冠鳌丘，地辟天开洗百忧。\n万窍倚空号一噫，八川盘野会千流。\n浮云晚日悲馀翠，废苑荒陵怨暮秋。\n自昔登临思善赋，高吟岂向世间求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和楚倅怀归","author":"李复","text":"雨断他乡梦，风沉故国音。\n山城黄叶落，兰畹白云深。\n寄食衣裘敝，凭鞍岁月侵。\n流尘昏斗剑，万里愧初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏槐 其二","author":"李复","text":"古槐疏惨倚颓墙，病叶先秋已半黄。\n封植不知何岁月，彫零今困几风霜。\n老根傍出人供爨，蠹腹多穿马系缰。\n叹惜他年承爱赏，清阴曾借暑天凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏槐 其一","author":"李复","text":"当年夹路绿参差，曾拥金舆拂羽旗。\n得地偶逃斤斧幸，闻风非与雪霜期。\n犹残腊火燔空腹，时有惊雷起蠹枝。\n想见妖灵占上象，龟山猎罢旧都移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂拱殿赐对蒙恩入省","author":"李复","text":"黼座亲瞻咫尺威，恭承天语慰衰迟。\n锦书殿陛初传赐，白发郎潜且漫为。\n九日重分番直夜，六参便赴早朝时。\n自知麋鹿难驯习，深愧鹓鸾接羽仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜意","author":"李复","text":"山雾连城白，虚庭待月生。\n雨馀秋叶润，露重葛衣轻。\n阴壁鸣虫涩，风枝宿鸟惊。\n淹留禾黍兴，怅望故园情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定昆池","author":"李复","text":"风烟当日竞豪华，故里犹传贵主家。\n何处可寻楼下水，平南不见面前花。\n阴机鬼伏天沉海，危祸波翻骨委沙。\n游客乘秋兴永叹，高林不觉见栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屈原庙","author":"李复","text":"古庙荒山暗水云，岁时歌舞感乡民。\n几伤谗口方离国，欲悟君心岂爱身。\n惨惨飞魂号帝阙，冥冥赍志托江神。\n千年自有遗文在，光焰长如日月新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抱瓮轩","author":"李复","text":"扰扰谁知巧丧生，惟君智巧不关心。\n为能悬解如庄叟，会识真风在汉阴。\n閒笑重轻争俯仰，静忘身世任浮沉。\n堪嗟混沌亡来久，今独怜君踵息深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊居","author":"李复","text":"閒原渺渺散疏襟，风舞渊潜自乐生。\n春到云山惟杖履，日长天地独柴荆。\n百年虽健犹亲药，一饭无多懒问耕。\n常羡子乔仙驭远，笑悲沧海世人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青布道人","author":"李复","text":"逸意閒云野鹤孤，药苗山叶缀衣裾。\n新蒸石卵将留饭，戏酌铜盘便得鱼。\n疗疾但分庵畔草，吐言不出世间书。\n五年密密求真诀，始露三元御气车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀秦金部","author":"李复","text":"少年书卷是生涯，白屋清朝自起家。\n数上封章思有补，一生悃愊静无华。\n初瞻玉节星轺下，俄见铭旌粉篆斜。\n天理冥冥谁可度，但伤零落掩淮沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山阻风","author":"李复","text":"黄牛白马渡惊滩，两目盲飙更险艰。\n天地容身惟一榻，江湖骇浪动千山。\n豪商竞利能争捷，阴鬼多私故作悭。\n叹息邻家田舍稳，柴门深掩日高閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡州渡江入寺 其二","author":"李复","text":"江上招提古，萧疏对郡城。\n延宾竹榻静，过雨石堂清。\n斋接荆州供，题多蜀士名。\n老僧飞锡倦，归坐听江声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡州渡江入寺 其一","author":"李复","text":"雪暗离秦地，春归入楚邦。\n平生怜匹马，将老渡长江。\n解缆辞亭树，中流见寺窗。\n舟人喜风色，略得寸心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦桓奉檄将行同饭素于龙泉寺","author":"李复","text":"西江吸水试庞翁，再访祇园问色空。\n古殿香寒消宿篆，晴林叶暗退残红。\n衰年再乞千家饭，逸驭初乘五日风。\n晓去清明边檄急，前旌高下乱山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日北园早起","author":"李复","text":"雨断云犹在，风回气已明。\n林花含宿润，露沼散馀清。\n喜静心常澹，居閒意寡营。\n流光随转盼，所向达吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中寓直次刘巨济职方韵兼示祠部张台卿","author":"李复","text":"锒铛司钥禁门重，寓直高秋此夜同。\n楼外归云迎霁月，宫中传漏带疏风。\n衰迂岂合参新论，俊少何堪接野翁。\n华省分曹占列宿，经时饱食愧无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚北园","author":"李复","text":"野兴乘俄顷，扶行锦竹长。\n碎蔬残宿圃，乱叶散寒塘。\n地僻柴门静，人稀草径荒。\n晓霜今几见，犹有菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种说山居 其二","author":"李复","text":"客来稚子出应门，洁洒虚庭屡汲深。\n西泽千塍连别岸，南山一带是家林。\n泉清野果浮苍玉，灯散灵峰见紫金。\n晚日已收凉气动，客归相送步松阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]