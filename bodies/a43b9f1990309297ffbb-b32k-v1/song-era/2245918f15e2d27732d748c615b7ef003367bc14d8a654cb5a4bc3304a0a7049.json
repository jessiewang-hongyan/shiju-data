[{"title":"偈颂一百五十首 其六十一","author":"释心月","text":"蜀山楚水，江北江南。\n步步稳密，念念相谙。\n前三三后三三，眨上眉毛早不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其六十","author":"释心月","text":"进一步，退一步，钁头钁底无回互。\n以一机，夺一机，没便宜处讨便宜。\n插锹叉手田中事，是即担泉带月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十七","author":"释心月","text":"鳞皴拄杖子，非长亦非短。\n东行西行处十分著力，归家稳坐时一味不管。\n著力处是我同流，不管时吾之道伴。\n且道伴同流是一是二，见成公案。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十六","author":"释心月","text":"一句如铁橛子，少室秤提不起，曹溪摇撼不动。\n有伎俩者一任左扶右持，无伎俩者不妨全体受用。\n巴蓬集壁，去天一尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十五","author":"释心月","text":"长安甚闹，我国晏然。\n古人一期酬对，不妨奇特。\n未有出身之路，唤什么作我国。\n纵遇锋刀常坦坦，假饶毒药也闲闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十四","author":"释心月","text":"青山为家，白云作户。\n稳密田园，鸦飞不度。\n鼓腹台前一转头，不觉四月二十五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十三","author":"释心月","text":"禅禅万万千，眉插鬓，耳垂肩。\n千花影里，百草头颠。\n或时虚空里钉橛，或时旱地上生莲，引得寒山子笑掀天。\n吟得新诗一两联，足成三百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十二","author":"释心月","text":"不见一法在门外，平地无端自活埋。\n若是金毛师子子，急须移步入门来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十一","author":"释心月","text":"三月二十五，芳春馀几许。\n一道平常心，颠言及倒语。\n谩道举手摘杨花，那知漫空飞柳絮。\n趁流光，猛提取。\n吃粥了也，洗钵盂去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其四十九","author":"释心月","text":"瓯阜山头，龙蛇阵上，将头不猛，累及三军。\n自此江西湖南，便与么去，吴山蜀水，纷纷纭纭。\n重城夜月，青山白云，一度思君复恨君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其四十八","author":"释心月","text":"昼见日，夜见星，妙高山色青又青。\n便与么去，不惟打失鼻孔，亦乃失却眼睛。\n且过在于何，黄河从源浊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其四十七","author":"释心月","text":"厨库对僧堂，三门朝佛殿。\n南来与北来，一见一切见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其四十三","author":"释心月","text":"青山白云，红尘闹市，见成公案，理当即行。\n为什么不知有，公验分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其四十二","author":"释心月","text":"烹金之炉，铸人之模，净名一默。\n国师三呼，你诸人又向甚么处摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其四十一","author":"释心月","text":"跛跛挈挈，列列??。\n跛跛挈挈处，匙挑不上。\n列列??时，炎天散雪。\n十有二年，来住此地，杨岐家风，未曾漏泄。\n今漏泄，秤锤元是一团铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十五","author":"释心月","text":"混不得，类不齐，六爻宛转见重离。\n夜深下视千山白，不是其中人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十三","author":"释心月","text":"以大圆觉，为我伽蓝。\n过去诸佛罪不重科，见在菩萨理无曲断。\n未来学人，咄，切忌草里辊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十二","author":"释心月","text":"瓯峰布铁连阵，我曾长袖拂开。\n瓯峰掷金刚圈，我曾铁鞭击碎。\n没仇雠处起仇雠，无怨对中作怨对。\n今日何以报之，报之以此为最。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十一","author":"释心月","text":"去年今年，八月九月。\n一树两树，丹桂离披。\n三枝四枝，黄花漏泄。\n于斯见面不相逢，于斯相逢复相别。\n老丰干心未歇，骑个无齿大虫，只管见人饶舌。\n阿呵呵，南北东西，一团生铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十","author":"释心月","text":"古人底，今人底。\n道著道不著，一场没巴鼻。\n象王回旋，师子游戏，洎合扶不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十九","author":"释心月","text":"散夏馀五日，那事稳也未。\n争似长汀子，低头打觉睡。\n不管你金乌东升，玉兔西坠。\n生死到来，甚处回避。\n低声低声，墙壁有耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十八","author":"释心月","text":"六月火边坐，有眼无耳朵。\n铁蛇钻不入，铁牛冲不破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十七","author":"释心月","text":"九十日安居，二千年圣制。\n念念三世十方，步步十方三世。\n何如闹市里保寿面目全露，肉案头盘山自心密契。\n使府近有指挥，不许攀条援例。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十六","author":"释心月","text":"月不破五，岁不满百。\n窄处放教宽，宽处捻教窄。\n如冲天之俊鹞，如当路之白额。\n敢有近傍者么，骼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十五","author":"释心月","text":"九年面壁，有理难伸。\n三日耳聋，无辞可措。\n堪悲堪笑，自昔自今。\n尽道以心传心，一向将错就错。\n年代深远，疑案难稽。\n既然呷汁罪同，合与一状领过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十四","author":"释心月","text":"至人无己，言犹在耳。\n万法作本根，天地相终始。\n一占帝与九龄梦，三听山呼万岁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十三","author":"释心月","text":"闹中静悄悄，静中闹浩浩。\n侧耳听不闻，举步行不到。\n没誵讹，勿寻讨。\n鸦作鸦鸣，鹊作鹊噪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十二","author":"释心月","text":"六阴剥，一阳复。\n寒谷交肩，春容可掬。\n少室山高难措足，断弦须是鸾胶续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十一","author":"释心月","text":"得也与么，未得也与么。\n寒灰烧杀人，冷地不可卧。\n丹霞烧木佛，因甚院主眉须堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二十","author":"释心月","text":"拄杖子，无规绳，有准则。\n长不得，短不得，恰好亦不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十九","author":"释心月","text":"一夜春风浩浩，拂尽千花百草。\n十二危楼一倚栏，珊瑚枝头日杲杲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十八","author":"释心月","text":"打圆相，女人拜。\n老杨岐，偏捏怪，依稀兔子吃牛奶。\n今日薰香瀹盏茶，岂是贫人思旧债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十七","author":"释心月","text":"一九二九，百拙千丑。\n昨日今朝，地迥天寥。\n少林门下客，立处雪齐腰，千载令人恨不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十六","author":"释心月","text":"一夏三个月，已过两个月。\n子细好生观，只馀一个月。\n说与林下人，莫空度岁月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十五","author":"释心月","text":"九旬禁足，三月护生。\n护生须杀，禁足须行。\n云收天迥，雨过山青。\n出门句里入门句，鼻直眼横眉亦横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十三","author":"释心月","text":"夜寒错认定盘星，金屑霏霏翳眼睛。\n教坏平人至今日，惺惺刬地不惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十二","author":"释心月","text":"一叶落，天下秋，布袋今朝又解头。\n古路不曾生寸草，慈明何事过汾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十一","author":"释心月","text":"一即三，三即一。\n剩则不足，少则有馀。\n相续得去底，道将一句来。\n七十三，八十四。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其十","author":"释心月","text":"上刀山，攀剑树。\n双暗双明，裂开捻聚。\n倒跨杨岐三脚驴，踢断岩头末后句。\n谁是其人，目前荐取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其九","author":"释心月","text":"与么则易，不与么则难。\n不与么则易，与么则难。\n金乌飞上玉栏干，眨上眉毛子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其八","author":"释心月","text":"竺土大仙心，东西密相付。\n谨白参玄人，光阴莫虚度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其七","author":"释心月","text":"无背面，有孔窍，转相亲，转料掉。\n凤台平，石城小。\n日下孤灯，果然失照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其六","author":"释心月","text":"金乌飞，玉兔走。\n目前事，看不透。\n十日前，五日后，谁敢咳嗽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三","author":"释心月","text":"元正启祚，万物咸新。\n山形拄丈子，只么黑鳞皴，时来也解笑翻身。\n倒腹倾肠为君说，唱歌须是帝乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其二","author":"释心月","text":"披牯牛皮，辊瞎驴队。\n带水拖泥，东倒西㹠。\n黄梅七百无人会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其一","author":"释心月","text":"寰中天子敕，塞外将军令。\n佛祖出头，也须乞命。\n今日合作么生，将逐符行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蒋山痴绝和尚 其一","author":"释心月","text":"急水上旗翻五色，飞流中毬辊百花。\n相逢相笑勿相笑，人途在中未到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蒋山痴绝和尚 其二","author":"释心月","text":"没弦琴三弄五弄，无孔笛一声两声。\n明月浮空天似水，长安归梦恰三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"添藏经施主水陆升座说偈","author":"释心月","text":"大悲心上流出底，呼为切脚若为评。\n不知切脚什么字，写不成兮呼不成。\n依依稀稀如半月，髣髣髴髴若三星。\n分付老昭诸善士，生生世世寿康宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释心月","text":"呵二乘，弹十地。\n以强词，夺正理。\n问疾人，根到底。\n语与默，都不是。\n金粟如来居士身，尽大地人扶不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪牛","author":"释心月","text":"露迥迥地趁不去，时复深村荒草行。\n一色皮毛都换了，荷担须是者众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"善禅人登径山侍痴绝","author":"释心月","text":"三年共住不相识，眉目横分鼻脩直。\n狭路逢渠何所之，欲上凌霄峰顶立。\n凌霄一峰插天高，馀峰起伏皆儿曹。\n我曾眺目察秋毫，三千刹海空劳劳。\n峰顶老人八十二，湛湛双眸映秋水。\n戏笑怒骂謦欬声，总是吾家第一义。\n老人问汝来何从，进前叉手宜当胸。\n更看武步生清风，何愁老人无笑容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化赞 其一","author":"释心月","text":"者风僧，甚举止。\n木铎一摇，声在人耳。\n邈吾真处点著便行，咬生菜时触著便讳。\n明头暗头拶著便转，今日昨日扶著便醉。\n或于道吾手里倒送鎗头，或于临济面前满倾恶水。\n如斯伎俩，果能成褫人，建立黄檗宗旨者耶。\n况其掣狂掣颠，有头无尾，是皆不逃大仰之谶盘山之记。\n末后若不向东门南门西门北门觅个走路，定不免新妇子老婆禅小厮儿抚掌笑你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳穿破衲赞","author":"释心月","text":"檐前负日暖烘烘，败坏重加补缀工。\n尽大地人穷性命，都卢劄在一针锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞东山五祖和尚","author":"释心月","text":"辊绣毬，打瓦鼓。\n半巴音，半鲁语。\n心胆倾，面目露。\n不可描，不可塑。\n故天下称之曰东山演祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞北涧和尚","author":"释心月","text":"调古风高，神清气逸。\n闻一唯升素王之堂，见微笑入空王之室。\n恢恢绰绰兮以一而贯万，寂寂寥寥兮会万而归一。\n此岂非八十三，住龙床角边。\n南山之净慈，佛照之真子，北涧老贼者耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞痴绝和尚","author":"释心月","text":"破蛰之雷，指南之龟。\n斫圆玉斧，刮膜金篦。\n噫，非师而谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藕丝观音赞","author":"释心月","text":"顶戴阿弥，不假花冠之累累。\n肩披藕丝，不必璎珞之垂垂。\n孤然不倚，俨然若思。\n我于一十九类三十二应身中次第观之，而无如是抱膝安闲大自在之风规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师正知画师顶相请赞","author":"释心月","text":"高厚同源，万殊一体。\n卓尔何来，湛然非止。\n览蜀天云，挹龙渊水。\n际会如斯，孰穷所以。\n正知知之，不出乎是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师正恭写松源掩室并师山行图请赞 其二","author":"释心月","text":"清空片云，古潭万象。\n飘然何来，湛然何往。\n识则不识，知而无知。\n铁壁银山，挨开者谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西竺净长老请赞","author":"释心月","text":"色见声求，二俱不是。\n离声色外，转没巴鼻。\n石火光中，掣电影里。\n要见石溪，且莫瞌睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思惟相观音赞 其一","author":"释心月","text":"春禽昼啼，秋虫夜吟。\n有耳皆闻，何独观音。\n如是而知，如是而觉。\n面目现前，超诸馀学。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思惟相观音赞 其二","author":"释心月","text":"燕语莺吟，鸦鸣鹊噪。\n声有差殊，闻无颠倒。\n闻性既寂，声尘亦空。\n一点悲心，在处圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其二十一","author":"释心月","text":"龙起沧海，虎出林端。\n直下来也，急著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十六首 其八","author":"释心月","text":"头上漫漫，脚下漫漫。\n拄定即易，瞥转还难。\n金刚宝剑逼人寒，不堕机锋句外看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其一","author":"释心月","text":"日永风清，雷奔电卷。\n无位真人，略通一线。\n急须著眼看仙人，莫看仙人手中扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其一○一","author":"释心月","text":"天高地迥，海阔山遥。\n秋风袭衣，拄杖?跳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其六十五","author":"释心月","text":"于食等者，于法亦等。\n于法等者，于食亦等。\n法食双运，平等普薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十八","author":"释心月","text":"龙蟠虎踞，今古嶷然。\n楚水秦淮，滔滔无间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其四十","author":"释心月","text":"我有一句，非默非语。\n日用见成，一时分付，依前罔措。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其三十九","author":"释心月","text":"我有一要，千差齐照。\n未曾拈花，不劳微笑。\n拟问如何，云横海峤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]