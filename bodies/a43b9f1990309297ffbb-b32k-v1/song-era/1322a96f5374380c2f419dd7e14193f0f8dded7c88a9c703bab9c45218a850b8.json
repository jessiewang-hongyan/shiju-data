[{"title":"醉思仙 寓居妙湛悼亡作此","author":"孙道绚","text":"晚霞红。\n看山迷暮霭，烟暗孤松。\n动翩翩风袂，轻若惊鸿。\n心似鉴，鬓如云，弄清影，月明中。\n谩悲凉，岁冉冉，蕣华潜改衰容。\n前事销凝久，十年光景匆匆。\n念云轩一梦，回首春空。\n彩凤远，玉箫寒，夜悄悄，恨无穷。\n叹黄尘久埋玉，断肠挥泪东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 力修宝学贤表宴胡明仲侍郎，遣歌姬来乞词，作醉蓬莱令歌之","author":"孙道绚","text":"看鸥翻波溅，蘋末风轻，水轩消暑。\n云叠奇峰，破桐阴亭午。\n列岫连环，溜泉鸣玉，对幅巾芒屦。\n况有清时，风流故人，剧谈挥麈。\n才冠一时，论高两汉，书扇豪踪，吐凤辞语。\n昼锦归来，庆长年老母。\n且尽绿尊，莫怀归兴，听扇歌高举。\n会见登庸，泥封诏下，促朝天去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三高祠 江东步兵","author":"孙锐","text":"秋风不为紫鲈香，适志徒劳梦水乡。\n惟是此生一杯酒，宦情无日不沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三高祠 甫里先生","author":"孙锐","text":"数顷荒田负郭耕，笔床茶灶看锄云。\n一盏清泉荐秋菊，不知何处吊参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三高祠 鸱夷子皮","author":"孙锐","text":"苧萝仙子总无双，一棹烟波气未降。\n如何铸像劳臣节，却是吴江非越江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从军行","author":"孙锐","text":"边笳动地吹，铁衣寒未卸。\n壮士冢累累，骨香千载下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孔明八阵石","author":"孙锐","text":"八阵图矶天下奇，无端变化出山时。\n要知抱膝南阳卧，早了三分一局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四景图 其四 仙矶晴雪","author":"孙锐","text":"湖天雪景弄朝晖，清彻如云散雨衣。\n肌骨已随云影去，玄真仙代竟忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四景图 其三 平湖秋月","author":"孙锐","text":"月浸寒泉凝不流，棹歌何处泛归舟。\n白蘋红蓼西风里，一色湖光万顷秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四景图 其一 荻塘柳影","author":"孙锐","text":"日出烟消春昼迟，柳条无力万丝垂。\n韶光新染鹅黄色，偏爱东风款款吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四景图 其二 禅院风荷","author":"孙锐","text":"碧筒注酒晚风凉，浇得新诗字字香。\n吟罢临风开佛座，撚花笑指浴鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石湖别墅","author":"孙锐","text":"一水遥通西渡头，乱山零落树还稠。\n先生唱罢村田乐，戴月披蓑理钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过震泽别业次壁间韵","author":"孙锐","text":"一棹烟波震泽空，笔床茶灶满清风。\n桑磐自是君家味，何羡区区涪上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖湄閒适二首 其二","author":"孙锐","text":"推窗笑指浣溪纱，点点飞鸥拍浪沙。\n侬自有心禽解语，抛砖水激落天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖湄閒适二首 其一","author":"孙锐","text":"荻花塘外老渔家，夜夜湖边倚钓槎。\n打起秋风鱼数尾，调羹尽可荐胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元夜送沈伯时赴南康山长","author":"孙锐","text":"十载从游吾道南，山斋苜蓿澹于甘。\n飞鱼想得三台兆，待雪空馀□丈函。\n席冷几番驯白鹿，罗传此夜赋黄柑。\n太平不日经筵召，好把鳞书早晚探。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长干送别","author":"孙锐","text":"君子于行东渡头，江村烟雨看眠鸥。\n秋风不借游山屐，客梦长呼问酒楼。\n八斗才怜新鹤发，十千囊尽敝貂裘。\n不须刎颈酬知己，一曲琵琶在远舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早朝","author":"孙锐","text":"烛光剑佩拥千官，载月临轩拜紫銮。\n仙掌禁寒承露稳，天颜霁晓傍云看。\n朝阳鸣凤谐宫律，沧海□鳌献羽翰。\n咫尺圣明三舞蹈，报恩岂敢负弹冠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兵火","author":"孙锐","text":"胡马倏南侵，膻尘夜犯心。\n丧鱼索枯肆，倒屣问焦琴。\n狼烟乘惨势，鬼燐带愁吟。\n庐舍人无几，还家何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿杨广文六十解组南还时署邑篆事","author":"孙锐","text":"五载琴堂奏未央，乌纱紫绶鬓苍苍。\n三鳣已集弘农兆，五柳仍分彭泽芳。\n廉石一车归吏部，清风两袖付中郎。\n山间甲子君知否，好向关西卧夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨郡王还乡","author":"孙锐","text":"貤恩乘传别金銮，老大门楣翠凤冠。\n咫尺玉阶沾露后，尚方丹诏落云端。\n新谐甥舅瞻蒲璧，世笃明良洒紫翰。\n遥拜圣明归梓里，望风父老笑歌欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨阻秦溪宿马养拙林下","author":"孙锐","text":"棹入江村暮，扣门求友生。\n青衫新鹿梦，白发旧鸥盟。\n巷僻苔痕滑，林深鸟舌清。\n共寻物外味，溪上老渔声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桑磐赠赵隐居","author":"孙锐","text":"湖南茅屋里，避世隐墙东。\n瀹茗知泉味，栽桑助女工。\n高歌牛背笛，稳棹艇头风。\n忆昔天随子，相逢乐在中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"殊胜院柬悟雪禅人","author":"孙锐","text":"百年萧寺古云间，五夜焚修昼掩关。\n雪岭衣传方丈室，虎丘石点可中山。\n天开罨黛成仙境，地接琉璃映佛颜。\n我亦挂冠为弟子，同参肯许是耕閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"避虏入洞庭","author":"孙锐","text":"朔风一夜渡江村，北望云飞不忍言。\n仙隐老寻双橘柚，避秦人爱小桃源。\n烟波乱逐鸱夷舸，烽火遥腾马偾辕。\n闻道此山真福地，不知何处更离魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耀武亭别周申团练","author":"孙锐","text":"湖光一片绮筵开，老矣将军去复来。\n漫说风尘轻似叶，岂教笳鼓动如雷。\n悲歌气喷三河少，武略功高八阵才。\n平望塞亭曾耀武，汉家空数单于台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云长公赞","author":"孙锐","text":"千载人，百世士。\n知正统，明大义。\n汉丞相，蜀先主。\n同公心，烛三光。\n为岳渎，为星云。\n今不死，髯将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊平望吊玄真子","author":"孙锐","text":"仙非胜地仙不升，地非仙迹地不灵。\n古今绝胜天下景，多为羽客梯云軿。\n松江之南平望驿，千古清名垂载籍。\n遗基废井虽不存，依旧湖光接天碧。\n我闻在昔张玄真，平生活计一钓纶。\n浮家泛宅戏人世，龟鱼为友蒹葭邻。\n故人分符刺苕水，东游历遍溪山美。\n翩然联璧至此乡，回视尘寰如敝屣。\n酒酣水戏身甚轻，席行水面同舟声。\n祥云瑞鹤歘然至，泛此凌空归太清。\n西塞山边飞白鹭，其间尽有朝元路。\n绿蓑平日恣遨游，何忍临岐弗相顾。\n争知万顷玻璃中，清都紫府遥相通。\n故来成此一奇事，欲将名姓传无穷。\n风帆过后沙鸟坠，灵迹虽存人不记。\n白蘋红蓼自争妍，谁识此为真福地。\n何人好事能挥金，结庐绘像湖之阴。\n寒泉一盏荐秋菊，往来不负诗人心。\n玄真今在天何处，独立河梁望飙驭。\n丹台玉籍若相容，携手乘风共归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虏警","author":"孙锐","text":"载将倾国尔为真，我梦扁舟作比邻。\n今日避兵真是梦，可知夙世有奇因。\n五湖烟水罨如画，鸱夷老子舍其下。\n千秋声气梦相通，此地居停尔当借。\n仙乎仙乎与世忘，何年归老耕閒堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家书和陶渊明问来使作","author":"孙锐","text":"我家平湖边，碧水豁清目。\n儿读谁氏书，庭开几株菊。\n绿笋可曾抽，银鱼想当馥。\n尔归语细君，涤圃秫须熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖中蚬蚌甚佳村妇调羹名曰水菜余珍嗜之作水羹吟","author":"孙锐","text":"春风一夜浪花起，大蚌小蚌浮江沚。\n渔蓑撒网唶嚄音，满载论斗不论斤。\n寄语庖厨煮白汤，脱壳击肉和椒浆。\n烂蒸鲜美波臣选，倾壶泼面供早膳。\n调羹娘子善刀藏，尚方滋味何分辩。\n不须更说毳与皛，江南水菜人知少。\n总道奇哉君善烹，明日饷君君当扰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨学士廷秀过访","author":"孙锐","text":"握手别君东渡，衔杯当我西归。\n少微星动百里，弹冠亦属忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 玄真子吟","author":"孙锐","text":"渔钓有遗逸，天子宠玄真。\n赐之奴仆，得随妫艳下神京。\n几度蘋汀蓼岸，不问金钩无饵，谈笑取冰鳞。\n珍重主人意，名我曰樵青。\n肩兰桨，萦桂棹，出波津。\n凌虚上□□□，□□会群真。\n卸下绿蓑青笠，付与渔童收管，相与□红尘。\n归去又□□，同赏洞中春。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词和玄真子","author":"孙锐","text":"平湖千顷浪花飞，春后银鱼霜更肥。\n菱叶饭，芦花衣，酒酣载月忙呼归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵隐莲峰堂","author":"孙雄飞","text":"堂开金色界，梵客为钩帘。\n山影碧侵座，水声清绕檐。\n粉云埋石脚，珠露泣松髯。\n终拟携孤笛，凭栏唤玉蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱塘感兴","author":"孙雄飞","text":"百年承袭地，和气媚芳尘。\n车马当吴会，山川与楚邻。\n酒楼弦管暮，花市绮罗春。\n风俗真佳丽，多应笑鲁民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上天竺","author":"孙雄飞","text":"行穷湖上径，迤逦到林峦。\n地瘦马蹄涩，水清山骨寒。\n楼台栖树杪，钟磬闹云端。\n自笑利名役，未能来挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"孙鼎","text":"北游不羡筑台金，忽解儒冠雪满簪。\n短剑空横无侠气，破琴欲抚且悲吟。\n啼猿声堕楚江碧，游鹿梦迷吴苑深。\n若见麻姑閒问讯，桃花千树正阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又书画船五首 其五","author":"孙嵩","text":"切莫清狂更隐沦，浮家泛宅断知闻。\n明朝我欲观书画，何处将诗寄水云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又书画船五首 其四","author":"孙嵩","text":"不听挐音分外闲，稳装书画一蓬间。\n今朝风雨苕川上，扑洒沙鸥第几湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又书画船五首 其三","author":"孙嵩","text":"幸自消除长物缘，尚留遮眼卷三千。\n分明更有江湖债，搬入人家赝钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又书画船五首 其二","author":"孙嵩","text":"书画生憎世上尘，不嫌蓑笠渺无津。\n扁舟去住浑林间，了是江湖旧散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又书画船五首 其一","author":"孙嵩","text":"足踏江陵一舸空，襄阳亲手结孤蓬。\n流传别有黔川样，安稳舲斋不亸风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书雨","author":"孙嵩","text":"阴谷幽林热似焚，阿香鸣鼓骤殷殷。\n天公作雨须臾事，用得东山一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开岁连日有阴雨 其三","author":"孙嵩","text":"新草天涯入断魂，若为有意眺郊原。\n只因老子春愁少，须著萧萧雨暗村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开岁连日有阴雨 其二","author":"孙嵩","text":"日日岚阴守翠微，清溪平没钓鱼矶。\n流莺一任无来意，直恐梅花半树稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开岁连日有阴雨 其一","author":"孙嵩","text":"老杜诗章五百年，为吾替写早春篇。\n恰从元日踰人日，重有阴阴冷落天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归途旅思","author":"孙嵩","text":"虚市斜阳早掩门，萧条州县抵深村。\n残梅与客迎新岁，明月随人作上元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生日 其二","author":"孙嵩","text":"鸿雁关河秋满眼，梧桐风雨冷吹衣。\n蓼莪自是长休废，独立苍苔一叹欷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生日 其一","author":"孙嵩","text":"云外荒村半掩扉，门孤事业与心违。\n悠悠岁月山林老，纳纳乾坤道路非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其四","author":"孙嵩","text":"汹浪砰雷蛇饮溪，阴崖天暗虎丘泥。\n万里中原那有此，怜君更过鬼门西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其九","author":"孙嵩","text":"峡山削出青嵯峨，峡水匀成绿不波。\n顿平山林未能得，奈此猿声朝夕何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其八","author":"孙嵩","text":"黄牛庙前鸦鹳栖，黄魔宫外枭鵩啼。\n估客酹神巫妪醉，青林日转风凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其五","author":"孙嵩","text":"峡路阴阴无四时，寒云鸟道挂天危。\n荒亭败驿此何处，望帝江山号子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其一","author":"孙嵩","text":"滟滪滩头君莫行，瞿塘峡里不论程。\n龙吟小雨蜀天黑，等有明朝春水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其二","author":"孙嵩","text":"行尽三巴三曲头，一滩自有一生愁。\n明朝已过巴陵岸，更宿江陵渔笛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其三","author":"孙嵩","text":"云外猩猩何处声，终朝出没只深菁。\n前有悬崖菁几里，行人到此古今情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其七","author":"孙嵩","text":"汉世明妃犹有村，荒祠歌舞与招魂。\n胡琴好入巴渝曲，万里还乡酾酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹枝歌 其六","author":"孙嵩","text":"巴子城荒非昔人，公孙何处问遗民。\n千年惟有武侯碛，留与踏歌行早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邵康节","author":"孙嵩","text":"真隐由中土，行窝赏太平。\n生无皱眉事，单为杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏元夕","author":"孙嵩","text":"茂苑长洲满地春，吴儿歌舞逐时新。\n风流百巧花灯手，犹是夫差国里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交四首 其四","author":"孙嵩","text":"拂槛逍遥絮，浮空自在丝。\n幽香来远近，山侧有酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交四首 其三","author":"孙嵩","text":"村落赪桐日，茅茨白楝风。\n闲阶沾雨菊，又绿去年丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交四首 其二","author":"孙嵩","text":"悄悄瞻青壁，悠悠瞩翠林。\n流莺无一事，声远薜萝阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交四首 其一","author":"孙嵩","text":"江花江水意，春色为谁多。\n极目天涯草，凄凄奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭程晦夫 其二","author":"孙嵩","text":"尚谓乡邦离有合，忍闻丘垄夜无晨。\n夕阳古道曾经别，肠断西风泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭程晦夫 其一","author":"孙嵩","text":"握手论交意气真，旧游四顾暗伤神。\n陪从金马门中客，和唱铜驼陌上春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阅秦纪二首 其二","author":"孙嵩","text":"泰岳聊逃雨，湘山偶阻风。\n伐树仍封树，元无罪与功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阅秦纪二首 其一","author":"孙嵩","text":"初逃揕未亡，又遇朴无伤。\n如何博浪祸，更使副车当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作","author":"孙嵩","text":"更勿穷通算此生，文章玄白付谁评。\n凄凉例薄佳人命，邂逅多成竖子名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫阳夜坐","author":"孙嵩","text":"一夜灯前白纻单，沉吟有此夏初寒。\n露零若与人相语，松杪潇潇下石坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]