[{"title":"和邻僧韵","author":"陈德翔","text":"七八年来住水心，喜邻萧寺共僧吟。\n古池暗有泉相接，春地从教笋自侵。\n兴到浓时因坐久，交于淡处见情真。\n极怜对立河梁暮，海月初生日正沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春膏纸","author":"陈槱","text":"膏润滋松雨，孤高表竹君。\n夜砧寒捣玉，春几瑩铺云。\n越地虽呈瑞，吴天乃策勋。\n莫言名晚出，端可大斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百字令 寿虞守正月十二","author":"陈潜心","text":"梅峰孕秀，庆仙翁、咫尺元宵三夕。\n盛德温温如玉粹，多少殊勋嘉绩。\n两拥朱幡，独清节，高谊真难屈。\n景疏堂下，台星长伴南极。\n雅羡椿桂联芳，金章紫绶，拜舞欢声溢。\n福备宜高仁者寿，喜占人间八十。\n汉重申公，周登尚父，盛事今犹昔。\n九重注想，蒲车行聘遗逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽友","author":"陈颜","text":"去与来相引，修随短共旋。\n只争生有骨，方信死无权。\n老友身前法，文章觉后圆。\n知君能悟此，哭唁一徒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散怀","author":"陈颜","text":"世乱无尔我，安心伏草茅。\n从今离虿尾，向晚转花稍。\n笔墨徜徉事，溪山淡泊肴。\n祇留兰与菊，傍我作知交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日送人","author":"陈颜","text":"今夕遂独坐，今晨已别离。\n同此良宵中，秋意各自知。\n滟滟潮与汐，来往亦何为。\n嗟尔扁舟子，何时老藩篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赞郑贞娘","author":"陈赞","text":"宋主南奔闽海头，至元铁骑震山丘。\n守臣不识归降耻，处女独怀污辱羞。\n云气古今和恨结，潮声日夜带哀流。\n死生大义须臾事，留取芳名几百秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日山亭","author":"陈壑山","text":"青竹题犹在，黄花课又供。\n浮生闲日少，清赏几人从。\n老木有豪气，秋山无媚容。\n凭高政怀古，江上夕阳舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵柯弟太博见示超化牡丹 其二","author":"陈襄","text":"一朵鞓红折寺园，忽惊寒律动春暄。\n非关花好难栽接，自是天时变木根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵柯弟太博见示超化牡丹 其一","author":"陈襄","text":"百草萧条病朔风，双枝成染魏家红。\n直疑天与凌霜色，不假东皇运化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过江外感怀","author":"陈襄","text":"江水无情含野烟，江风还似旧时天。\n先生隐去思成死，今日重来十六年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过罨画溪","author":"陈襄","text":"五云无处问新亭，月里乘舟夜半行。\n不见藤花相掩映，乡人遥指画溪名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余自白阳驰谒宜都周梦得长官饮于清江亭爱其山水之胜留题","author":"陈襄","text":"丹山西去水东流，亭在山南隔蓼洲。\n船系白杨归不得，清江如画主人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和如晦二首 其二","author":"陈襄","text":"一别瀛山岁未期，三州声称已齐飞。\n欲将吏事文经术，独恐迂儒取世讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和如晦二首 其一","author":"陈襄","text":"俱为泽国朱轓守，同是冰厅白首郎。\n且喜朝廷忧外寄，故从书府辍班扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和如晦桃杏","author":"陈襄","text":"一色胚红染露柯，谁栽安石旧岩阿。\n自嗟老大无心赏，不及流莺管顾多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张运使题长乐台","author":"陈襄","text":"云暗驺鸣出谷时，一方生齿庇馀辉。\n知君才业非张翰，莫为鲈鱼有意归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和定慧超胜长老寄谢紫衣颂三首 其三","author":"陈襄","text":"得道无求幻与真，一筇一衲似閒云。\n忽闻师唱报恩曲，百草千花特地春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和定慧超胜长老寄谢紫衣颂三首 其二","author":"陈襄","text":"童子南来遗我诗，维摩方丈一伸眉。\n不劳言语通消息，夏热春寒各自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和定慧超胜长老寄谢紫衣颂三首 其一","author":"陈襄","text":"恩袍出挂壮禅扉，试问何人达此机。\n船子夜来亲下钓，碧潭明月有馀辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宛丘长官赏花","author":"陈襄","text":"遗我新诗雅兴长，一时花谱为传芳。\n不须满县栽桃李，却羡风流骑省郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程大卿荔枝","author":"陈襄","text":"棠阴为政有光晶，号令风行鬼亦惊。\n和气发来藏不得，直教丹荔背时生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程大卿新辟诸寺门","author":"陈襄","text":"政绝多门寺却通，灵山胜境尽牢笼。\n应怜去鲁迟迟意，令遍诸天国土中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"陈襄","text":"朝居晦息与山邻，物理由来有屈伸。\n独把一心经万事，逍遥须养谷中神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兴教净慈二长老","author":"陈襄","text":"老来为郡苦间关，不及江云自往还。\n忽忆湖边二禅老，等閒骑马入南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄戏刘道渊","author":"陈襄","text":"陆羽茶亭枕水隈，为言无酒且徘徊。\n山中此物尤难得，应是刘生不肯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常州郡斋六首 其六","author":"陈襄","text":"一麾来此下岩丘，也学东山谢傅游。\n今日鸟声并水色，不知何似五亭幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常州郡斋六首 其五","author":"陈襄","text":"荀令当年此谪居，空文惟有七篇馀。\n我今亦作兰陵守，不忍援毫便著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常州郡斋六首 其四","author":"陈襄","text":"使君非是爱山閒，道在盈虚消息间。\n不见白云无一事，等閒为雨却归山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常州郡斋六首 其三","author":"陈襄","text":"桐花著地雪成痕，时有幽禽巧语言。\n应笑使君林野性，日依山水避尘喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常州郡斋六首 其二","author":"陈襄","text":"山亭侧畔构山房，便是耕云钓月乡。\n未达功名穷饮水，此生应不误行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常州郡斋六首 其一","author":"陈襄","text":"近来无事学撄宁，聊得斋居养性灵。\n卧著麻衣穿草履，谁知参鲁解忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游善权洞二首 其二","author":"陈襄","text":"水洞深无百尺泉，白龙奋蛰已多年。\n谁知此物能云雨，常济山南万顷田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游善权洞二首 其一","author":"陈襄","text":"阴阳融结此山川，便有盐堆与石田。\n风俗每来占水旱，即疑乾洞有神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程大卿书宿猿洞","author":"陈襄","text":"闻说山光是旧山，衣冠家此百年间。\n自嗟亦有同来祖，两处松楸得往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颍川赏花二首 其二","author":"陈襄","text":"千骑重来此建旟，新年花发旧年株。\n东皇应是怜孤宦，十里全归锦帐铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颍川赏花二首 其一","author":"陈襄","text":"閒入郊园驻隼旟，百花红紫万千株。\n如何春意多风雨，不惜漫天锦绣铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颍州府学释奠先圣郡中童子亦来拜谒以诗勉之","author":"陈襄","text":"蔼蔼青衿子，来修谒庙仪。\n怜他眉宇秀，中有起家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"携家游东园","author":"陈襄","text":"红塔寺前千顷稻，青山门外百家村。\n年丰米贱无公事，不惜时来倒一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简子直","author":"陈襄","text":"吴郡三年困水灾，昔时从事建麾来。\n遥知到后疏游燕，不比苏韦放酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简子容","author":"陈襄","text":"同馆分飞来右浙，一麾潇洒出南河。\n琴书满榻王常在，不独西湖胜赏多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简如晦","author":"陈襄","text":"登阁始闻公府荐，出轓俄拥使旌随。\n无人不说南徐守，儒雅风流独一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙居伟羌山六绝 其三","author":"陈襄","text":"天鞠精灵久贮储，中间豪杰出无虚。\n乡民世世家于此，争使儿孙不读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙居伟羌山六绝 其一","author":"陈襄","text":"去年曾揽伟羌图，云有仙人古篆书。\n千尺石岩无路到，不知科斗字何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙居伟羌山六绝 其四","author":"陈襄","text":"峭壁回环几百区，其间岩石可耕锄。\n如何得片山如此，白首相将老母居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙居伟羌山六绝 其五","author":"陈襄","text":"古意巑岏与世疏，一官羁绊可归欤。\n此山未及西山好，下有仙人结草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙居伟羌山六绝 其六","author":"陈襄","text":"四友之贤世莫如，白头须作一乡居。\n此山不惜将钱买，叹息无人共结庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙居伟羌山六绝 其二","author":"陈襄","text":"盘盘英气四纡馀，定有仙人此地居。\n天子正求伊与吕，如何不见起耕渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张渚道中","author":"陈襄","text":"班春无术劝污莱，五十年间此一回。\n黄发路傍应怪问，使君何事入山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杭州宝岩寺垂云亭","author":"陈襄","text":"小亭巉绝出云间，万象升沉不得閒。\n莫怪诗翁头白早，时来向此写湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题毗陵郡图","author":"陈襄","text":"平湖千里接荆溪，万顷良田不可堤。\n我欲决渠疏积水，干塘江口地形低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠禅者","author":"陈襄","text":"昔年曾到此山中，正见山花满砌红。\n今日花开还照眼，分明见处本来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠鹭鸶","author":"陈襄","text":"两个鹭鸶相对立，江边无物蓼花疏。\n知君洁白如霜雪，何必临川更羡鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日与浦城县学诸生游南峰院","author":"陈襄","text":"九日黄花节，新樽绿蚁浮。\n投壶鸣鲁鼓，歌者似商讴。\n诸子衣冠盛，先儒礼乐修。\n西岩山景好，为尔作阳秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夕霁","author":"陈襄","text":"积雨向宵晴，氛埃荡杳冥。\n高楼微射月，腐草半流萤。\n电女千娇敛，云台一梦醒。\n上皇归未得，歌断雨中铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水口赠别大吉祖师长老","author":"陈襄","text":"直向此间明，纵横语论精。\n山中曾出世，海上未知名。\n一雨春溪涨，千峰晓雪晴。\n临分无别说，相送水边行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园观雪","author":"陈襄","text":"风毛雨絮小园东，天幕低垂惨澹空。\n蘋浦万家云覆瓦，花蹊千树玉雕笼。\n穿林已夺春梅早，夹陇潜滋夏麦丰。\n湘酎狐衣虽可赋，岂无捐瘠在沟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙居县署岩老亭","author":"陈襄","text":"手持养性书，此地学耕渔。\n身似龙蛇蛰，情忘木石居。\n地迷成远复，政静得中虚。\n何必求深隐，幽蒙即所庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古城","author":"陈襄","text":"芦苇萧疏天气清，水含山色照重城。\n绿芜何处管弦地，碧落旧时钟鼓声。\n三峡桥边秋雨过，六鳌宫里夜潮生。\n萧郎秦女无归约，十二瑶台空月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对景偶书","author":"陈襄","text":"天角暝光收，空中爽气流。\n雨回巫峡暮，波起洞庭秋。\n塞阔归鸿远，林疏败叶稠。\n碧云音信绝，目断五城楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白头","author":"陈襄","text":"白头四十未逢知，锻石裨天已后时。\n正好中行求独复，岂能上施学颠颐。\n生荣死辱如观火，吉去凶来莫问龟。\n若有名山归便隐，一编周易是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵友人郑穆病起感怀","author":"陈襄","text":"五老村中会隐时，投梭即是十年期。\n自谙海燕归巢早，祗恐山桃结实迟。\n伊吕功名何日到，轲扬辞业是人知。\n如君未忍抛簪去，买取青山寄岭陲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李学士勾院海棠","author":"陈襄","text":"幽芳宁贵俗人知，北省仙郎只自奇。\n颜色定应西蜀品，馨香不减上林枝。\n胭脂著雨深红日，葆发临风半白时。\n几欲相从花下饮，许昌词藻愧难追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和程少卿省宿寄齐熙业少卿","author":"陈襄","text":"名卿犹此滞閒曹，贲育何须举一毫。\n夜直甘泉西掖近，晓趋峣阙北辰高。\n蒙庄吏隐机心息，老杜诗成笔力豪。\n祗恐多才难久次，不同新进累资劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"此景","author":"陈襄","text":"晚崿残霞断，晴空宿霭收。\n绿芜天共远，明月水同流。\n落叶填秋望，孤砧答旅愁。\n提壶伴诗笔，独醉庾公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次巴峡","author":"陈襄","text":"江流何险阻，次第入三巴。\n崖断时无路，山深更有家。\n林蔬饶竹笋，乡果足枇杷。\n况有荆州酒，淹留不用嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观太原丞相寄惠紫霞园庵新居诗和太素先生","author":"陈襄","text":"翠竹庵前白藕池，修真常惜寸阴移。\n别生五气根原固，妙乐三清出处宜。\n黄阁主人思访道，绛纱弟子许观颐。\n兴来即到维摩室，岂待留侯脱屣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀友人陈烈","author":"陈襄","text":"思君苦节直艰难，四十穷经草野间。\n文为周衰能力救，礼遭秦祸欲重删。\n时无正说非杨墨，天与多才继孔颜。\n吾主聘贤方仄席，好将书币起东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李侍郎修路","author":"陈袖","text":"路馀百里两山间，水驿山程总不安。\n谁把千金平滑蹬，免教一叶委惊滩。\n行人感叹何时已，贤守功名百世看。\n次第吾闽都似掌，却嗤蜀道号泥盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏明允府君挽词","author":"陈襄","text":"礼阁仪新奏，延英席久虚。\n自从掩关卧，无复草玄书。\n东府先生诔，西山孝子庐。\n谁言身后事，文止似相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使还咸熙馆道中作","author":"陈襄","text":"土旷人稀使驿赊，山中殊不类中华。\n白沙有路鸳鸯泊，芳草无情妯娌花。\n毡馆夜灯眠汉节，石梁秋吹动胡笳。\n归来揽照看颜色，斗觉霜毛两鬓加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和通判徐郎中毗陵重阳","author":"陈襄","text":"自怆宫车别帝台，寄言篱菊不须开。\n心丧忍到行春浦，耳病慵携迟月杯。\n天色阴沈鸣雁过，物华零落暗蛩催。\n却输小杜怜嘉节，酩酊齐山夜始回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和解空长老雪颂","author":"陈襄","text":"片片分明是六花，迷人只见乱如麻。\n穷阎处士愁穿屐，明眼高僧笑点茶。\n十二玉楼开阆苑，三千银界遍河沙。\n解空老子能提唱，郢曲幽兰未足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]