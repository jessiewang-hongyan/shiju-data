[{"title":"年老逢春十三首 其七","author":"邵雍","text":"年老逢春春莫厌，春工慎勿致猜嫌。\n红芳若得眼前过，白发任从头上添。\n雨后艳花零泪颗，风馀新月露眉尖。\n轻醇酒面斟来凸，举盏长忧不易拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其六","author":"邵雍","text":"年老逢春春意多，波光谁染柳谁搓。\n池亭正好爱不彻，草木向荣情奈何。\n便把樽罍通意思，须防风雨害清和。\n千红万翠中间里，似我闲人更有么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其五","author":"邵雍","text":"年老逢春始识春，春妍都恐属闲身。\n能知青帝功夫大，肯逐后生撩乱频。\n酒趁嫩醅尝格韵，花承晓露看精神。\n大凡尤物难分付，造化从来不负人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其四","author":"邵雍","text":"年老逢春莫厌春，住家况复在天津。\n既将水竹为生计，须与风花作主人。\n故宅废功除瓦砾，新畦加意种兰薰。\n未知去此闲田地，何地更能容此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其三","author":"邵雍","text":"年老逢春雨乍晴，雨晴况复近清明。\n天低宫殿初长日，风暖园林未啭莺。\n花似锦时高阁望，草如茵处小车行。\n东君见赐何多也，又复人间久太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其二","author":"邵雍","text":"年老逢春春正妍，春妍况在禁烟前。\n才寒却暖养花日，行雨便晴消酒天。\n进退樽罍宜有主，栽培桃李岂无权。\n清谈已是欢情极，更把狂诗当管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年老逢春十三首 其一","author":"邵雍","text":"年老逢春春莫猜，老年方自少年回。\n人情少悦酒不解，天气却寒花未开。\n堤外有风斜送柳，墙阴经雨半生苔。\n去年波水东流去，旧渌奈何新又来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有客吟","author":"邵雍","text":"伊嵩有客欲无言，进退由来尽俟天。\n好静未能忘水石，乐闲非为学神仙。\n休嗟紫陌难为客，且喜清风不用钱。\n枉尺直寻何必较，此心都大不求全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老去吟 其二","author":"邵雍","text":"行年六十有三岁，二十五年居洛阳。\n林静城中得山景，池平坐上见江乡。\n赏花长被杯盘苦，爱月屡为风露伤。\n看了太平无限好，此身老去又何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老去吟","author":"邵雍","text":"老去无成鬓已斑，纵心年纪合清闲。\n如何得意云山外，更欲游心诗酒间。\n大字写诗酬素志，小杯斟酒发酡颜。\n春雷惊起千年蛰，笔下苍龙自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自乐吟","author":"邵雍","text":"麟凤何尝不在郊，太平消得苦譊譊。\n才闻善事心先喜，每见奇书手自抄。\n一瓦清泉来竹下，两竿红日上松梢。\n窝中睡起窝前坐，安得闲辞解客嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自处吟","author":"邵雍","text":"尧夫自处道如何，满洛阳城都似家。\n不德于人焉敢异，至诚从物更无他。\n眼前只见罗天爵，头上谁知换岁华。\n何止春归与春在，胸中长有四时花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自和打乖吟","author":"邵雍","text":"安乐窝中好打乖，自知元没出人才。\n老年多病不服药，少日壮心都已灰。\n庭草刬除终未尽，槛花抬举尚难开。\n轻风吹动半醺酒，此乐直从天外来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏","author":"邵雍","text":"天下更无双，无知无所长。\n年颜李文爽，风度贺知章。\n静坐多茶饮，闲行或道装。\n傍人休用笑，安乐是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述二首 其二","author":"邵雍","text":"陆海卧龙收爪甲，辽天老鹤戢毛衣。\n难攀骐骥日千里，易足鹪鹩巢一枝。\n最好朋侪同放适，博高台榭与登跻。\n云山胜处追寻遍，似我清闲更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述二首 其一","author":"邵雍","text":"何者堪名席上珍，都缘当日得师真。\n是知佚我无如老，惟喜放怀长似春。\n得志当为天下事，退居聊作水云身。\n胸中一点分明处，不负高天不负人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自遣","author":"邵雍","text":"读书忘岁月，人竞笑蹉跎。\n但得甘旨足，宁辞辛苦多。\n龙泉去铓刃，蜗角亦风波。\n知我为亲老，不知将谓何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至福昌县作","author":"邵雍","text":"清景几人爱，爱之当远寻。\n及临韩岳近，始见洛川深。\n县在云山腹，民居水竹心。\n无机类闲物，愈觉少知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观三国吟","author":"邵雍","text":"桓桓鼎峙震雷音，绝唱高踪没处寻。\n箫鼓一方情未畅，弓刀万里力难任。\n论兵狼石宁无意，饮马黄河徒有心。\n虽曰天时亦人事，谁知虑外失良金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观书吟","author":"邵雍","text":"吁嗟四代帝王权，尽入区区一旧编。\n或让或争三万里，相因相革二千年。\n唐虞事业谁能继，汤武功夫世莫传。\n时既不同人又异，仲尼恶得不潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观五代吟","author":"邵雍","text":"自从唐季坠皇纲，天下生灵被扰攘。\n社稷安危悬卒伍，朝廷轻重系藩方。\n深冬寒木固不脱，未旦小星犹有光。\n五十三年更五姓，始知除扫待真王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观西晋吟","author":"邵雍","text":"承平未必便无忧，安若忘危非善谋。\n题品人材凭雅诮，雌黄时事用风流。\n有刀难剖公闾腹，无木可枭元海头。\n祸在夕阳亭一句，上东门啸浪悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观有唐吟","author":"邵雍","text":"天生神武奠中央，不尔群凶未易攘。\n贞观若无风凛凛，开元安有气扬扬。\n凭高始见山河壮，入夏方知日月长。\n三百年间能浑一，事虽成往道弥光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观两汉吟","author":"邵雍","text":"秦破河山旧战场，岂期民复见耕桑。\n九千来里开封域，四百馀年号帝王。\n剥丧既而遭莽卓，经营殊不念高光。\n当时文物如斯盛，城复何由更在隍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观盛化吟 其二","author":"邵雍","text":"吾曹养拙赖明时，为幸居多宁不知。\n天下英才中遁迹，人间好景处开眉。\n生来只惯见丰稔，老去未尝经乱离。\n五事历将前代举，帝尧而下固无之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观盛化吟 其一","author":"邵雍","text":"纷纷五代乱离间，一旦云开复见天。\n草木百年新雨露，车书万里旧山川。\n寻常巷陌犹簪绂，取次园亭亦管弦。\n人老太平春未老，莺花无害日高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观隋朝吟","author":"邵雍","text":"始谋当日已非臧，又更相承或自戕。\n蝼蚁人民贪土地，泥沙金帛悦姬姜。\n征辽意思縻荒服，泛汴情怀厌未央。\n三十六年都扫地，不然天下未归唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观棋小吟","author":"邵雍","text":"谁言博弈尚优游，利害相磨未始休。\n初得手时宜顾望，合行权处莫迟留。\n二年乃正三监罪，七日能尸两观囚。\n天下太平无一事，南阳高卧更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观嬴秦吟","author":"邵雍","text":"轰轰七国正争筹，利害相磨未便休。\n比至一雄心底定，其如四海血横流。\n三千宾客方成梦，百二山河又变秋。\n谩说罢侯能置守，赵高元不是封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过比干墓","author":"邵雍","text":"精诚皎于日，发出为忠辞。\n方寸已尽破，独夫犹不知。\n高坟临大道，老木无柔枝。\n千古存遗像，翻为谄子嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过永济桥二首 其二","author":"邵雍","text":"一水一溪门，溪门云复屯。\n珍禽啭乔木，幽鹿走荒榛。\n雨脚拖平地，稻畦扶远村。\n高城半颓缺，兴废事休论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过永济桥二首 其一","author":"邵雍","text":"山背锦屏开，河临永济回。\n土田平似掌，桑柘大如槐。\n斜日射虹去，低云将雨来。\n无涯负清景，长是愧非才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过陕","author":"邵雍","text":"吾祖道何光，二南分一方。\n开周为太保，封陕辅成王。\n岁月装辽邈，山川造渺茫。\n世孙虽不肖，犹解忆甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过潼关","author":"邵雍","text":"禁密因离乱，机闲为太平。\n山河虽设险，道德岂容争。\n不究千一义，空传百二名。\n遐方久无外，何复用鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问人丐酒","author":"邵雍","text":"百病筋骸一老身，白头今日愧因循。\n虽无紫诏还朝速，却有青山入梦频。\n风月满天谁是主，林泉遍地岂无人。\n市沽酒味难醇美，长负襟怀一片春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问春吟","author":"邵雍","text":"自古言花须说莺，莺花本合一时行。\n因何花谢莺才至，浪得莺花相与名。\n辄欲问春春不应，私于蜂蝶有何情。\n流莺不伏春辜负，啼了千声又万声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何处是仙乡","author":"邵雍","text":"何处是仙乡，仙乡不离房。\n眼前无冗长，心下有清凉。\n静处乾坤大，闲中日月长。\n若能安得分，都胜别思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲吟","author":"邵雍","text":"绿杨深处啭流莺，莺语犹能喜太平。\n人享永年非不幸，天生珍物岂无情。\n牡丹谢后紫樱熟，芍药开时斑笋生。\n林下一般闲富贵，何尝更肯让公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别谢君实端明","author":"邵雍","text":"曹王八斗才，今日为余催。\n锦绣佳章里，芝兰秀句开。\n烦痾熸躯体，溽暑烁楼台。\n宜把君诗讽，清风当自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事吟","author":"邵雍","text":"事到患来频，何由得任真。\n就新须果敢，从善莫因循。\n盗亦自有道，人而或不仁。\n义缘无定体，安处是行身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县尉廨宇莲池","author":"邵雍","text":"县尉小斋前，水清池有莲。\n岂唯观菡萏，兼可听潺湲。\n宛类江湖上，殊非尘土边。\n古人用心处，料得不徒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听琴","author":"邵雍","text":"琴宜入夜听，别起一般清。\n才觉哀猿绝，还闻离凤鸣。\n青山无限好，白发不须惊。\n会取坐忘意，方知太古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿安县晚望","author":"邵雍","text":"休叹浮生荣与辱，且听终日水潺潺。\n遥穿暝霭孤鸿去，横截野烟双鹭还。\n佳树排青岩下圃，好峰环翠县前山。\n报言名利差轻者，少辍光阴到此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弄笔","author":"邵雍","text":"行年五十二，老去复何忧。\n事贵照至底，话难言到头。\n上有明天子，下有贤诸侯。\n饱食高眠外，自馀无所求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"求信吟","author":"邵雍","text":"始则求人信，有知有不知。\n既而求自信，人或多知之。\n今我不求信，何人更起疑。\n无可无不可，安往不熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穷冬吟","author":"邵雍","text":"十二月将终，还惊岁律穷。\n藏冰方北陆，解冻未东风。\n草昧徒寻绿，花梢强觅红。\n探春春不见，元只在胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苍苍吟","author":"邵雍","text":"人人共戴天，我戴岂徒然。\n须识天人理，方知造化权。\n功名归酒盏，器业入诗篇。\n料得闲中乐，无如我得全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诏三下答乡人不起之意","author":"邵雍","text":"生平不作皱眉事，天下应无切齿人。\n断送落花安用雨，装添旧物岂须春。\n幸逢尧舜为真主，且放巢由作外臣。\n六十病夫宜揣分，监司无用苦开陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还圆益上人诗卷","author":"邵雍","text":"瓶锡相从更一巾，一巾曾拂十州尘。\n心通佛性久无碍，口道儒言殊不陈。\n吴越江山前日事，伊嵩风月此时身。\n闲行闲坐松阴下，应恃眼明长笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中吟 其一","author":"邵雍","text":"闲中气味长，长处是仙乡。\n富有林泉乐，清无市井忙。\n烂游千圣奥，醉拥万花香。\n莫作伤心事，伤心易断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中吟 其二","author":"邵雍","text":"闲中气味真，真处是天民。\n富有林泉乐，清无市井尘。\n烂游千圣奥，醉拥万花春。\n莫作伤心事，伤心愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲行吟 其二","author":"邵雍","text":"投吴走越觅青天，殊不知天在眼前。\n开眼见时犹有病，举头寻处更无缘。\n颜渊正在如愚日，孟子方当不动年。\n安得功夫游宝肆，爱人珠贝重忧钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲吟四首 其四","author":"邵雍","text":"欲有一瓢乐，曾无二顷田。\n丹诚未贯日，白发已华颠。\n云意寒尤淡，松心老益坚。\n年来疏懒甚，时忆旧林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲吟四首 其三","author":"邵雍","text":"居洛八九载，投心唯二三。\n相逢各白首，共坐多清谈。\n人事已默定，世情曾久谙。\n酒行勿相逼，徐得奉醺酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲吟四首 其二","author":"邵雍","text":"予年四十七，已甫知命路。\n岂意天不绝，生男始为父。\n且免散琴书，敢望大门户。\n万事尽如此，何用过忧惧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲吟四首 其一","author":"邵雍","text":"平生如仕宦，随分在风波。\n所损无纪极，所得能几何。\n既乖经世虑，尚可全天和。\n樽中有酒时，且饮复且歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲坐吟","author":"邵雍","text":"当年计过之，今日事难随。\n天命不我祐，云山聊自怡。\n无何缘淡薄，遂得造希夷。\n却欲嗤真宰，劳劳应不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲步吟","author":"邵雍","text":"何者谓知音，知音难漫寻。\n既无师旷耳，安有伯牙琴。\n虽逼桑榆景，宁忘松桂心。\n独行月堤上，一步一高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适吟五首 其四","author":"邵雍","text":"南窗睡起望春山，山中霏微烟霭间。\n千里难逃两眼净，百年未见一人闲。\n情如落絮无高下，心似游丝自往还。\n又恐幽禽知此意，故来枝上语绵蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适吟五首 其二","author":"邵雍","text":"六尺眼前安乐身，四时争忍负佳辰。\n温凉气候二八月，道义宾朋三五人。\n量力杯盘随草具，开怀语笑任天真。\n劝君似此清闲事，虽老何须更厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适吟五首 其五","author":"邵雍","text":"谁将造化属东风，一属东风事莫穷。\n残腊也宜先作策，新正其那便要功。\n柳梢借暖浑摇软，梅萼偷春半露红。\n安得向时情意在，轻衫撩乱少年中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适吟五首 其一","author":"邵雍","text":"为士幸而居盛世，住家况复在中都。\n虚名浮利非我有，绿水青山何处无。\n选胜直宜寻美景，命俦须是择吾徒。\n乐闲本属闲人事，又与偷闲事更殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮酒吟","author":"邵雍","text":"时时醇酒饮些些，颐养天和以代茶。\n无雨将成大凶岁，负城非有好生涯。\n身居畎亩须忧国，事委男儿尚恤家。\n人问老来何长进，鉴中添得鬓边华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和三王少卿同过弊庐","author":"邵雍","text":"洛中诗有社，马上句如神。\n白首交情重，黄花节物新。\n见过心可荷，知愧道非淳。\n寂寞西风里，身闲半古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王不疑少卿见赠","author":"邵雍","text":"不把忧愁累物华，光阴过眼疾如车。\n以平为乐忝知分，待足求安恐未涯。\n食罢有时寻蕙圃，睡馀无事访僧家。\n天津风月胜他处，长是思君共煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王不疑少卿招饮","author":"邵雍","text":"经难忆浮丘，吾乡足胜游。\n风前惊白发，雨后喜新秋。\n仕宦情虽薄，登临兴未休。\n人间浪忧事，都不到心头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之少卿见戏安之非是弃尧夫吟","author":"邵雍","text":"安之殊不弃尧夫，亦恐傍人有厚诬。\n开叔当初言得罪，希淳在后说无辜。\n悄然情意都如旧，刬地杯盘又见呼。\n始信岁寒心未替，安之殊不弃尧夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]