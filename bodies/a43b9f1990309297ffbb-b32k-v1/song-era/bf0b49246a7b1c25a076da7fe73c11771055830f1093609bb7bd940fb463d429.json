[{"title":"宋任著作宰江宁溧水","author":"韩琦","text":"讯察无冤善最闻，剸繁南邑遇盘根。\n还将决狱平反意，去作临民抚字恩。\n淮上月高生丽思，浦前春老醉离魂。\n知君阴德终阳报，容驷何妨大里门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道卿学士领二浙漕赋得酒","author":"韩琦","text":"倾酿留佳客，秋亭弭使旄。\n奉觞归养切，行算别魂劳。\n上若名乡近，长安美价高。\n清怀思酌水，惠政忆投醪。\n论德堪成颂，评诗更助豪。\n行闻趋节觐，同我怨持螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋柳枝词二阕 其一","author":"韩琦","text":"曲江风暖晓阴斜，翠色相宜拂钿车。\n自有春眠慵未起，日高人困又飞花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋柳枝词二阕 其二","author":"韩琦","text":"叶叶新长约黛蛾，丝丝轻软任风梭。\n啼莺便学歌喉啭，知是春来舞意多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离都","author":"韩琦","text":"握节背都门，春天景半温。\n柔鞭难驻马，芳草易销魂。\n远目和烟重，离怀助酒昏。\n好花无奈野，时复映遥村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳","author":"韩琦","text":"远道今逢祓禊辰，雨馀风物一番新。\n等闲临水还思旧，取次看花使当春。\n絮雪暖迷西苑路，车雷晴起曲江尘。\n台英正约寻芳会，谁是山阴作序人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓目","author":"韩琦","text":"拥传脩途倦，逢春旅思长。\n远烟含树色，细雨起尘香。\n陇麦成行绿，林莺并对黄。\n扬鞭聊自慰，举目见韶光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"韩琦","text":"脂辖行伤早，扬旌兴莫穷。\n水遥天色共，云细月波通。\n巧舌争啼晓，香牙尽入风。\n纵吟殊未已，初旭放晴红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食","author":"韩琦","text":"汉宫新蜡未开烟，寒食东郊跃骏天。\n人面映花谁感事，客心燃火独成篇。\n塞鸿归渚遥书字，营柳因风强破眠。\n赖有目前随分景，数村如树起鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登永济驿楼","author":"韩琦","text":"远烟芳草媚斜阳，萧索邮亭一望长。\n尽日倚栏还独下，绿杨风软杏花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中暑热忆诸同舍","author":"韩琦","text":"振野惊风拂面尘，赫曦流烁犯征轮。\n酒非逃暑虚成会，花未忘忧谩映人。\n绿水已伤春别旧，碧云长起暮愁新。\n朝来记得瀛洲梦，目断英游极怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻角","author":"韩琦","text":"古堞连云暝霭收，呜呜清调起边楼。\n雍琴垂泪虚情恨，羌笛残梅未胜愁。\n数曲伴风吹戍垒，几番侵梦入宾邮。\n听来便觉春心破，素发生多不待秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雄州遇雪","author":"韩琦","text":"云压孤城势渐低，昏昏台榭雪霏霏。\n人游兔苑何妨醉，使适龙沙未得归。\n夜馆月明交素影，晓涂霜重借严威。\n风前似慰征轺意，先学杨花二月飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫濛遇风","author":"韩琦","text":"草白岗长暮驿赊，朔风终日起平沙。\n寒鞭易促鄣泥跃，冷袖难胜便面遮。\n迥岭卷回云族破，远天吹入雁行斜。\n土囊微乞缄馀怒，留送归程任摆花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使回戏成","author":"韩琦","text":"专对惭非出使才，拭圭申好敛旌回。\n礼烦偏苦元正拜，户大犹轻永寿杯。\n攲枕顿无归梦扰，据鞍潜觉旅怀开。\n明朝便是侵星去，不怕东风拂面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过虎北口","author":"韩琦","text":"东西层巘郁嵯峨，关口才容数骑过。\n天意本将南北限，即今天意又如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题仙掌","author":"韩琦","text":"三峰晴晓碧相挨，仙掌分明出雾开。\n莫向巍峨衒高手，也曾先得桂枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题利州昭化驿","author":"韩琦","text":"嘉陵源出本朝宗，地险无因直赴东。\n从此逆流归顺去，恬波遥与峡江通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过三泉龙门二阕 其一","author":"韩琦","text":"洞户呀然透碧溪，竹轩茅榭映高低。\n行人不待桃花发，一到仙扃已自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过三泉龙门二阕 其二","author":"韩琦","text":"欣过龙门柅使车，顿惊凡目识仙都。\n海中知有三山在，未信能加此景无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漫天岭","author":"韩琦","text":"欲使行人直过难，倚江凌汉任盘盘。\n纡回到顶终须下，如此天高甚处漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题嘉州嘉望亭","author":"韩琦","text":"欲知藩境得嘉名，试策筇枝上此亭。\n江色照城平似练，岚光堆槛活如屏。\n好遨民阜充衢乐，出品花奇袭坐馨。\n使驲暂来闲寓目，几多高意在鸿冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋一阕","author":"韩琦","text":"槛外风光触处奇，岭头金像对巍巍。\n主人偏恋南犍乐，只恐瓜时示肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩渎学士领益漕","author":"韩琦","text":"去年巴蜀失秋成，西顾饥流恻睿情。\n尝忝乘轺宣渥命，更烦持节拯遐氓。\n夜亭微雨多侵梦，春峡繁花少记名。\n到日莫辞行部数，属城凋瘵望君生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇子诞庆五言十二韵","author":"韩琦","text":"圣统垂千祀，天仁覆万方。\n思贤咏场藿，兴俭缉帷囊。\n宽法均疏网，忧民甚纳隍。\n画衣期不犯，行苇见无伤。\n列庙灵潜佑，高穹意默彰。\n故教生嗣晚，欲示卜年长。\n帝梦前推吉，郊禖此报祥。\n协辰初告望，纪节正迎商。\n和气城铜律，休符集画堂。\n清飙来美应，瑞旭荐荣光。\n九县欢声沸，三都惠泽滂。\n非才尘近掖，援笔颂无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆历甲申郊礼告成五言十韵","author":"韩琦","text":"圣飨申精意，灵心察至虔。\n因知斋次雪，为显祭时天。\n清庙陈丰洁，中坛致吉蠲。\n乐和来瑞物，景霁见非烟。\n卜日灰飞管，通祠火举权。\n短茵新礼重，虚幄睟容专。\n盛美推穹昊，釐祥被幅员。\n庆成朝万玉，霈泽谨三钱。\n有幸瞻熙事，无才列奏篇。\n为民祈福应，亲记德音宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云","author":"韩琦","text":"郁郁疑非雾，融融散薄阴。\n油然天下泽，淡若岭头心。\n适意自舒卷，有容谁浅深。\n朝来殊未起，幽谷閟龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霜","author":"韩琦","text":"霜威昨夜肃天区，平晓蒿兰一槩枯。\n一寤春仁入根本，只凭秋惨及皮肤。\n寒锋刺甲过矛戟，皓色禁人著鬓须。\n料得西风如未紧，且来枝上作明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初雨","author":"韩琦","text":"乍觉尘香动，风前细若缫。\n无声犹似雪，得润已如膏。\n美利存南亩，馀滋付小桃。\n谁知青皞德，意不为嬉遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新柳二阕 其一","author":"韩琦","text":"弄黄含绿叶开眉，最有春来次第知。\n生计任随栽者意，却嗤松柏不禁移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新柳二阕 其二","author":"韩琦","text":"驿路行人东复西，等闲攀折损芳枝。\n有生自是无根物，忍向乐风赠别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜花","author":"韩琦","text":"看花关有分，分薄亦蹉跎。\n蜂蝶争无限，笙歌得几何。\n利名长自役，风雨不须多。\n趁取红香在，高吟卷醉螺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦被堆","author":"韩琦","text":"不管莺声向晓催，锦衾春晚尚成堆。\n香红若解知人意，睡取东君不放回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹初芽为鸦啄之感而成咏","author":"韩琦","text":"牡丹经雨发香芽，满地新红因饿鸦。\n利嘴可能伤国艳，只教春色入凡花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游蜂","author":"韩琦","text":"游蜂纷扑竞花繁，未到香须只自喧。\n尽日却输蝴蝶计，闹红心里默无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新燕","author":"韩琦","text":"出入高堂性似驯，泥巢深稳足容身。\n雕梁并宿嫌频看，巧语多应是骂人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过隋城","author":"韩琦","text":"信马隋城下，行春访旧传。\n楼台在何处，瓦砾半耕田。\n远籁悲笳咽，馀花坠靥圆。\n只留荒侈迹，千古监青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦雨方霁蛙声不已","author":"韩琦","text":"暑雨朝来已厌多，蛙鸣犹更幸滂沱。\n虽然快尔狂跳志，争奈良田有害何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题翠钟亭","author":"韩琦","text":"钟峰隐隐隔江湍，翠色偏宜雨后看。\n大抵兴王须恃德，饶君终古作龙盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀葵","author":"韩琦","text":"炎天花尽歇，锦绣独成林。\n不入当时眼，其如向日心。\n宝钗知自弃，幽蝶或来寻。\n谁许清风下，芳醪对一斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月二首 其一","author":"韩琦","text":"自古中秋月，风骚昨意难。\n几人亭醉笔，终夕凭危栏。\n海际掀鲸目，云端擢露盘。\n一年相别恨，并与此时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月二首 其二","author":"韩琦","text":"月满中秋夜，人人惜最明。\n悲欢徒自感，圆缺本无情。\n天外有相忆，世间多江平。\n嫦娥难借问，寂寞趁西倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张逸人归杭","author":"韩琦","text":"不因疔适出中林，尘外高踪岂易寻。\n鸿在碧霄谁可慕，云归苍岛本无心。\n堤奁一鉴平湖满，寺枕千屏叠嶂深。\n知己重留多下榻，故栖猿鹤莫惊吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答丹阳李公素学士","author":"韩琦","text":"与君为郡不相遥，只隔瓜洲一信潮。\n诲字屡传来客素，治声常逐过江桡。\n词垣暂尔淹鸿笔，宴席何妨引巨蕉。\n诗句满筒烦借誉，爰居空自愧虞韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢丹阳李公素学士惠鹤","author":"韩琦","text":"高笼携得意何勤，玉树惭无可待君。\n只爱羽毛欺白雪，不知魂梦托青云。\n孤标直好和松画，清唳偏宜带月闻。\n自有三山归去路，莫辞时暂处鸡群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和润倅王太博林畔松","author":"韩琦","text":"郁郁山头翠色攒，就中高格出林端。\n霜凌劲节难摧抑，石缠危根任屈盘。\n古鬣自随仙日老，孤风不入俗人看。\n时来匠者须回顾，且禀幽姿待岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊","author":"韩琦","text":"万卉趁枯死，香金斗晚葩。\n甘名应得露，野色岂如家。\n俗态惜迟暮，芳情谁怨嗟。\n重阳樽酒伴，不见牡丹花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九会光化二阕 其一","author":"韩琦","text":"寺枕隋家废苑前，登高还此会僚贤。\n凭轩莫赋悲秋事，剩撚黄花送酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九会光化二阕 其二","author":"韩琦","text":"谁言秋色不如春，及到重阳景自新。\n随分笙歌行乐处，菊花萸子更宜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄通尉郧乡","author":"韩琦","text":"古邑万山里，区区一尉行。\n高堂方待养，寸禄岂宜轻。\n身屈何伤道，才多少晦名。\n赠言如可取，荣路坦然平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答湖恢推官","author":"韩琦","text":"当年都寺接贤初，屈指光阴一纪馀。\n自说三茆深处稳，不逢又鲤寄来书。\n隔江闻授诸生业，命驾因烦长者车。\n得见新诗与高论，积年劳吝已全祛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晴","author":"韩琦","text":"霁色破春昏，高楼日未曛。\n林稍零旧雨，山顶入残云。\n醉粉匀花颊，风罗绉水纹。\n踏青入误约，芳思几纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春霖","author":"韩琦","text":"咫尺东郊路，春霖绝未通。\n销闲生弈思，醒睡费茶功。\n楼迥昏昏雾，窗寒霎霎风。\n待晴桑陌上，五马恣?珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上成春雪二阕 其一","author":"韩琦","text":"二月风光尽属春，六霙何苦妒芳辰。\n东君等是回生意，须与莺花作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上成春雪二阕 其二","author":"韩琦","text":"晓来飞雪抑香芽，料峭轻寒特地加。\n青帝似矜春意早，更妆新萼与梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过梁山泊","author":"韩琦","text":"巨泽渺无际，斋船度日撑。\n渔人骇铙吹，水鸟背旗旌。\n蒲密遮如港，山遥势似彭。\n不知莲芰里，白昼苦蚊虻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移帅真定次韵答致政杜公","author":"韩琦","text":"常山画野直天街，寄重如何付不才。\n跃马敢辞奔命去，捍羌曾是奋身来。\n军中纪律劳人葺，林下樽罍得意开。\n引领恩轩无路到，几临风月独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常山出郊马上口占","author":"韩琦","text":"旌旗乘晓出郊原，五马临风一慨然。\n山势似屏西限晋，地形如掌北擒燕。\n麦含丰泽催齐秀，蚕饱柔桑起大眠。\n守帅勉希廉与蔺，九重高枕不忧边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登西大悲阁","author":"韩琦","text":"蔼蔼西蓝阁，烦襟一望开。\n山川归盛德，奸杰委尘埃。\n城迥云连堞，烽闲草蔽台。\n谁知太守意，不为纳凉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别潭","author":"韩琦","text":"一潭嘉景四时新，不得经年作主人。\n莲芰风前忘九夏，绮罗香里醉三春。\n勤劳疆场诚无避，妆点蓬瀛惜未真。\n多少胜游休结恋，报君须自立涓尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和兖州王待制过汶上见寄","author":"韩琦","text":"浅局虽难继大才，溪堂佳致亦添来。\n奇花并蒂宜新种，芳树连柯得旧栽。\n良执假途形咏叹，邻封为治惜淹徊。\n想君醉问歌人处，不向风前酹一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋不见月","author":"韩琦","text":"中秋宜月不教晴，人倚危楼意未平。\n任是他时圆更好，争如今夜略分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北岳","author":"韩琦","text":"四海尊方岳，常推朔镇雄。\n阳为中夏胜，阴与北胡穷。\n孕秀贤豪出，宣灵造化通。\n斗乘天位正，乾发帝基隆。\n盛畜严凝气，横障广莫风。\n举头瞻峻极，危坐压崆峒。\n殖物资坤德，栖真固坎宫。\n星躔函毕昴，祀典轶王公。\n俗仰良材富，年随喜泽丰。\n左肱挥渤澥，右股跨獯戎。\n地险祠庭革，时平戍垒空。\n岚光朝扑黛，宝色夜舒虹。\n有药皆奇种，无花不异丛。\n层巅健雕鹗，怪穴老罴熊。\n肆觐仪虽阔，斯民望未充。\n何时清大漠，封牒纪宸功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雪","author":"韩琦","text":"朔雪飞残腊，融和变凛严。\n徐来花出在，骤急霰声兼。\n数住天应惜，争繁酒易添。\n积深函久润，济大略微嫌。\n雅意明书幌，多情入宴帘。\n舞腰难学转，峰顶尚饶尖。\n露蕊仙盘挹，风毛鬣囿燖。\n宫墙胡粉画，梅梗蜀酥黏。\n影澹三春絮，光寒八月蟾。\n垣涂谁复辨，巨壑有何厌。\n狂助诗毫逸，清驱厉气潜。\n欢谣腾紫塞，喜色上彤幨。\n凝霤收冰乳，堆庭镂虎盐。\n吾民无足虑，丰岁可前占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元罢灯","author":"韩琦","text":"灯夕何萧索，朝家恤殣灾。\n民心无奈郁，春意有谁开。\n明月舒云懒，游人怯漏回。\n堪嗤愚太守，独欲上熙台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡西斋有夜合萱草对开因成二阕 其一","author":"韩琦","text":"合欢香影拂西斋，萱草前临小槛开。\n待尔忘忧与蠲忿，争如无事起灵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡西斋有夜合萱草对开因成二阕 其二","author":"韩琦","text":"合欢萱草两含芳，一见令人乐兴长。\n唯是忧边与忧国，对花终日不能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢真定李密学惠牡丹","author":"韩琦","text":"穷边无处睹春荣，咫尺常山似洛城。\n会得主人将雅意，欲教邻境伏香名。\n全开正弄朝霞色，半谢犹含暮雨情。\n只上宾筵共一醉，也胜浑不见芳英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]