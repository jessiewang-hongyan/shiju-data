[{"title":"偶书二绝 其二","author":"张侃","text":"久知凫短鹤长语，谁赋花荣竹脆诗。\n物理无穷难测识，且倾美酒乐天时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"张侃","text":"夜深水冷无香饵，若个黄鳞肯上钩。\n我欲钓鳌安尔用，一竿风月好回舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题司马才叔诗后","author":"张侃","text":"司马才名世所贤，银钩珠唾尚依然。\n尘埃试看蛛丝壁，倒指于今六十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言 其一","author":"张侃","text":"梅长官深有味，木居士喜清游。\n未用三熏三沐，且占一壑一邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言 其二","author":"张侃","text":"色惟有用文子，翠亦堪餐此君。\n未须歌南浦雨，终是望渭北云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡寒山拾得赞","author":"张侃","text":"人居火宅无不有，你亦投身携扫帚。\n一朝放下困腾腾，明月寒潭只依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧熊画布袋赞","author":"张侃","text":"弄尽精神真捏怪，横拖拄杖街头卖。\n忽然两步走归来，四大不收图睡快。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏李松石图赞","author":"张侃","text":"东坡先生，锦绣心胸。\n戏作怪石，一时告功。\n当其落笔，雨霈风从。\n齐安赤壁，惠州鹤峰。\n十年饱览，孰可撄锋。\n温润枯淡，变态不同。\n一卷之石，作倚盘松。\n龙眠居士，孰羁其踪。\n一瞬八表，如鹤在空。\n东坡颂美，佳名日穹。\n明窗展观，松古石窿。\n天下之宝，岂间穷通。\n东坡之节，龙眠之隐。\n一异出处，如琴加轸。\n吁嗟二公，人中之龙。\n百馀岁后，仰止英风。\n我生后时，何以形容。\n纪述惟赞，愧非扬雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辛巳自赞","author":"张侃","text":"徐永升画时，予弱冠而缀文。\n赵可大画时，予三十而有立。\n钱诵画时，予究道之出入。\n盖尝晦其声名，谢其等级。\n恶脂韦而取容，与傲世而长揖。\n客问直夫，处事太执。\n直夫俛而笑曰，人各是其所习。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊寅自赞","author":"张侃","text":"有伯夷之清，而无万世之准。\n有孟郊之古，而无一代之名。\n能操守而冰洁，视富贵如云轻。\n前乎直夫是一臞叟，后乎直夫是一书生。\n既不能润乎诗书，又不能事乎纵横。\n客有过者曰：嘻，视彼拙貌，徒污丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客有诵唐诗者又有诵江西诗者因再用斜川九日韵","author":"张侃","text":"泛观今人诗，机巧由心生。\n镂冰与铸木，未免求虚名。\n岂知制作妙，浑然同水清。\n尘埃数张纸，亦足传佳声。\n群趋不知守，辛勤到莫龄。\n奈何口耳间，一见意已倾。\n投身入诗社，被褐生光荣。\n党同伐异说，初非出本情。\n我愿剖藩篱，学力随所成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探野航古梅","author":"张侃","text":"池边梅未绽，不是怯霜风。\n待得阳和到，清香一线通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠句容士人","author":"张侃","text":"山川清美天下稀，五瑞同时盍纪碑。\n碑上只言人物盛，若言德政愧无之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"张侃","text":"剩喜联官忘尔汝，故令元化夺胚胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月波楼","author":"袁似道","text":"绣节移华屋，下照鸳湖阔。\n飞梯驾秋旻，杰观压云堞。\n铢积日用间，经营妙无迹。\n图画划天开，景物劖地绝。\n简静还乐邦，登览追逸辙。\n彩舫回波心，芳樽浮月夕。\n清吟开酣饮，长啸杂横笛。\n新诗纪游情，□酒惊醉魄。\n传看大轴盈，准拟坚珉刻。\n□□望其成，抑以观稼穑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"丁大全","text":"云从百丈潭中起，雨向九重天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至钱塘净慈寺写古松于壁因题","author":"马宋英","text":"磨尽一锭两锭墨，扫出千年万年树。\n月明乌鹊误飞来，踏枝不著空归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋梅","author":"林靖之","text":"与月淡交连影瘦，于春无竞著花疏。\n细雨敛尘栖萼润，轻云度谷压香低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"垂虹亭","author":"陈武子","text":"行乐江亭上，情弥天壤间。\n舟讥王访雪，妓鄙谢登山。\n佳致输公擅，清欢愧尔悭。\n宾僚陪宴笑，兴尽莫轻还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"歌","author":"开禧牧童","text":"朝出耕田暮饭牛，林泉风月共悠悠。\n九重虽窃阿衡贵，争得功名到白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"开禧牧童","text":"玉津园内行天讨，怨血空啼杜宇红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晓","author":"尤带","text":"东方看欲曙，三五斗参横。\n月影斜穿竹，鸡声远逐莺。\n花街红露腻，柳浪翠烟轻。\n沧海升朝日，春光满太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"释皓","text":"楚雁传归信，吴鸥候过船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江郊旅舍","author":"毛沧洲","text":"京旅江郊僻，楼居剩得清。\n柳风罗带袅，荷雨水银倾。\n日夜潮来去，东西山送迎。\n悠悠千古兴，吴越暮云平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赐宜春易太极","author":"徐经孙","text":"易有太极，在天地先。\n两仪四象，是谓后天。\n春台得之，云自希夷。\n吉凶祸福，予以前知。\n八十二宫，颇与俗殊。\n数往知来，亶其然乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元旦训孙","author":"徐经孙","text":"咨尔潭生，今岁十六。\n弃汝幼志，企慕老宿。\n收汝放心，归就检束。\n业必精思，书必勤读。\n敬事父母，出入必告。\n钦奉师模，传习必熟。\n友爱同气，如手如足。\n珍重自身，如圭如玉。\n非礼勿视，祇污青目。\n非礼勿听，祇乱心曲。\n非礼勿言，言必招辱。\n非礼勿动，动必非福。\n翁作箴言，尔其佩服。\n念哉敬哉，中有天禄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其一 龙门春浪","author":"徐经孙","text":"雷奔石壁间，瀑泻洞门侧。\n蜿蜒乘洪涛，变化莫可测。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其二 鳌头秋风","author":"徐经孙","text":"西风吹石岐，鳞甲起深辙。\n借问去来人，谁是骑鲸客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其三 罗阜朝云","author":"徐经孙","text":"初生半崖阴，渐失双峰翠。\n倏忽满太虚，苍生望霖雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其四 潘溪夜月","author":"徐经孙","text":"溪月濯银盘，溪桥卧脩軏。\n沙净碧波寒，分明见蟾阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其五 隆福晚钟","author":"徐经孙","text":"山围古寺阴，曙隔鲸音发。\n悠扬三四声，唤上东林月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其六 骊塘暮雨","author":"徐经孙","text":"飘萧鸥鹭群，淅沥孤蒲晚。\n云断山月明，新泉落前涧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其七 水北书声","author":"徐经孙","text":"林馆碧溪阴，弦歌杂灯影。\n夜分犹吾伊，学海在人境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉溪八景 其八 东源诗社","author":"徐经孙","text":"诗家在东皋，鸡林价争售。\n作者复几人，风月三千首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题施山观音阁","author":"徐经孙","text":"阁道连云栈，檐牙覆竹阴。\n南来天马渡，北落水龙吟。\n林鸟疑谭偈，田花欲布金。\n凭栏观下界，洞见远公心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长子思訦赴江西庾幕","author":"徐经孙","text":"三年永丰簿，两载半临川。\n纳满无多日，奇逢有二天。\n临民须近厚，减价要重蠲。\n莫道违离远，常如在膝前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思訦生朝分忠勤酒侑之以诗","author":"徐经孙","text":"帝正才五五，吾子始生时。\n潘县花将锦，陶门柳欲丝。\n与民同乐意，在我即琴棋。\n酒自忠勤出，公馀荐一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中有感","author":"徐经孙","text":"习懒多成病，旬馀久覆杯。\n帐中闻燕语，瓶里看花开。\n医已肱三折，愁来肠九回。\n何时得疏散，屐齿印苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幼子思谊举次孙命名阳生","author":"徐经孙","text":"吾年七十四，始见两孙枝。\n阳德初回候，蟾光欲满时。\n传家惟简册，愿汝似兰芝。\n何日解言语，能吟公此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送思訦之官鳌峰","author":"徐经孙","text":"我如汝年时，昉问便江戍。\n选阱如海深，望洋吁可怖。\n汝今亦宜教，去作鳌峰主。\n有民环百里，待汝字而抚。\n何以奉宽条，何以抚黎庶。\n惟公则生明，平心阅牒诉。\n惟廉则寡过，莫受脂膏污。\n惟勤则集事，慎勿习逸豫。\n惟俭可无求，只学我清苦。\n持此四字符，便是作县谱。\n去家三百里，两地无多路。\n安问来与往，时走一健步。\n居官而民宜，暌隔非所虑。\n三年课最归，可以见君父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咸淳壬申六月不暑","author":"徐经孙","text":"常年六月六，暑气何其酷。\n犬有吐舌烦，猫得负背燠。\n今日胡不然，萧然凉气足。\n阳乌潜其辉，小雨时霢霂。\n重袂犹未温，浴了肌起粟。\n老病固宜然，壮者亦不浴。\n短至未及间，秋阴如许毒。\n本朝王火德，德与尧运续。\n文明耀四海，年世不待卜。\n吾君乾六龙，刚健粹如玉。\n吾相泰九二，夬夬出苋陆。\n君臣德既同，讵有此阴伏。\n吾闻氛气恶，杀气盛西北。\n襄城既失守，生灵烂鱼肉。\n匹夫尚怀忧，知此妄屠戮。\n臣固告上天，忍泪不敢哭。\n愿言扫阴邪，日月舜耳目。\n中国盛阳明，从今调玉烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题伴云樵唱","author":"徐经孙","text":"佛法生憎绮语，道人安用樵歌。\n有时言外悟意，不觉山中烂柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞夏端甫所绘真","author":"徐经孙","text":"老我不堪位置，归来久混渔樵。\n忽然珠玉在侧，见之令人意消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春班遇雪","author":"徐经孙","text":"拜赐通班近玉墀，小臣今日睹朝仪。\n雪花飞在蓝袍上，洁白其身正此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和端茶训子 其一","author":"徐经孙","text":"东坡月窟天香远，山谷云涛味玉温。\n相对两翁元祐老，说茶风味到今存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和端茶训子 其二","author":"徐经孙","text":"写诗只到黄山谷，又失西川苏子贤。\n更把名章细商略，续弦那可惜胶煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和端茶训子 其三","author":"徐经孙","text":"三日君诗当刮目，看来字字到云和。\n从今喜入圣人手，孔杏坛中取瑟歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南英会芳亭","author":"徐经孙","text":"众芳会处得春多，草色随人气亦和。\n闻道吾宗好兄弟，棣花香里细吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过严子陵钓滩","author":"徐经孙","text":"仰止高风不可攀，且图生出鬼门关。\n稽首台前无复过，归家斩却钓鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其一","author":"徐经孙","text":"仰止高风早赋归，晚生自恨不同时。\n公如岭上孤松秀，我亦松间百尺丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其二","author":"徐经孙","text":"尚记千官拱帝尧，日随环佩早趋朝。\n螭坳毡下从容际，咫尺天颜未觉遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其三","author":"徐经孙","text":"乔山却似会稽阴，千里孤臣泪满襟。\n沐浴恩波无地报，始知沧海未为深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其四","author":"徐经孙","text":"咸淳天子怜臣老，紫殿清华极邃情。\n赋禄玉隆真昼锦，有时听得步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其五","author":"徐经孙","text":"九重忧责讵能分，不雨羞为出岫云。\n累疏丐归今得请，保全晚节荷明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其六","author":"徐经孙","text":"北窗自有来薰处，长夏何妨一枕高。\n竹薄未能遮照遍，西风我欲障葡萄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其七","author":"徐经孙","text":"活水一溪如玉瑩，好山四面似螺堆。\n个中自足归吾老，莫待北山文勒回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其八","author":"徐经孙","text":"家有园池幸未荒，客来有酒或传觞。\n秋宵玩月冬观雪，春日寻芳夏纳凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其九","author":"徐经孙","text":"人心易溺谁能拯，世道如澜孰与回。\n赖有圣贤遗训在，好怀每为古书开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和临湘奉议孙敷山归田十咏 其十","author":"徐经孙","text":"早眠晏起自安恬，头上从教白发添。\n和了十诗赊七字，太平时节效陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题安原寺","author":"徐经孙","text":"杜老曾留脩觉句，韩公亦有岳山题。\n愧无健笔希前哲，谩把飞红当踏泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病起 其一","author":"徐经孙","text":"去年习懒因成癖，瘦骨支离怯病魔。\n今日团圆环四世，玉蒲细切泛金荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病起 其二","author":"徐经孙","text":"上高殊邑尚吾乡，千里相忘是建康。\n王事贤劳宜不废，师生义重讵能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其一","author":"徐经孙","text":"归来好，篱下菊花应未老。\n晚香犹可荐清樽，渊明醉后和衣倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其二","author":"徐经孙","text":"归来好，两岁引年章屡草。\n圣恩宽辱不容闲，今得生还真大造。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其三","author":"徐经孙","text":"归来好，颜巷安居乐吾道。\n此行不敢怨风闻，只恨舒君言不早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其四","author":"徐经孙","text":"归来好，一入山林迹如扫。\n杜门谢客免愆尤，几净窗明读庄老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其五","author":"徐经孙","text":"归来好，菊后梅前宜问道。\n退朝羽翼此心生，从此五更无起早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其六","author":"徐经孙","text":"归来好，从此五更无起早。\n虽然?亩瓣香心，天子万年多寿考。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其七","author":"徐经孙","text":"归来好，三径须宜有花草。\n于中竹柏可耐寒，更种长松成四老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其八","author":"徐经孙","text":"归来好，饮食起居随晏早。\n闲身乐得未龙钟，东阡西陌寻芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其九","author":"徐经孙","text":"归来好，茅檐曝背无烦恼。\n欣时读易困时眠，个中输与痴顽老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出朝赋归来好 其十","author":"徐经孙","text":"归来好，龙门有山名七宝。\n宿生泉石颇有缘，往来尽可休吾老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]