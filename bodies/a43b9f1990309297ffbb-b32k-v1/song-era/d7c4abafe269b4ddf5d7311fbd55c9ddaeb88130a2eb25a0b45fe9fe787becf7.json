[{"title":"陈武帝钓台","author":"周弼","text":"路才容马尽荒茅，谁识仙人旧钓鳌。\n流水不随船影断，乱山犹带弹痕高。\n春烟粉黑重生葑，暮雨灰红半拆桃。\n今日故宫何处问，东风应长对江涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳阳楼","author":"周弼","text":"凭高望尽寂寥天，与我闲情共渺然。\n平展暮云三百里，积停春水二千年。\n沙洲横渡荆江雨，石塔遥分岳麓烟。\n老我未闻飞剑术，想须今度遇回仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招郑服之","author":"周弼","text":"归心同一路，况复在新年。\n梦著登山屐，闲随渡水船。\n宿蒿迷旧陇，春葑起闲田。\n醉卧天池上，知君在我先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枫桥寒山寺","author":"周弼","text":"江枫吟咏工，幽寺冷遗踪。\n不改前朝路，犹闻半夜钟。\n地凉汀月皎，村迥水烟浓。\n试问谁曾见，惟应独有松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗家洲","author":"周弼","text":"对港近村俱有路，扁舟倍觉往来频。\n入秋破褐惟存线，尽日收钱不满缗。\n远岸冷沙衔坠叶，浅滩寒水卧枯蘋。\n未知行役何时断，纵使更深亦唤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采香径","author":"周弼","text":"缯甲如荼护此台，玉颜憔悴锦帆来。\n一蹊香草无蜂过，千里空葭有雁回。\n响屧藓埋丹凤迹，缕衣花变粉蛾灰。\n谁知子夜歌残日，树满西山似绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨花台","author":"周弼","text":"细藓柔莎琐旧堆，昔年曾见异僧回。\n如何天上飞灵雨，不为人间洗劫灰。\n江接潮头诸脉应，地连岗势一支来。\n只今不假虚无事，别是春风歌舞台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南楼怀古五首 其五","author":"周弼","text":"夕阳光退杳难凭，欲问江鸥只怨憎。\n得意举帆烧北岸，伤心流梅锁西陵。\n雪消蜀货千樯下，风顺吴盐万斛增。\n且趁一樽相暖热，自非乘醉莫来登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南楼怀古五首 其四","author":"周弼","text":"幸际清时息五兵，舌顽无处说纵横。\n蚁封一梦难分别，蜗角千年强斗争。\n丹壁邮亭新蜀道，白楼烽戍古邾城。\n自知夜半徒兴舞，移远寒鸡不使鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南楼怀古五首 其三","author":"周弼","text":"茫茫迂曲度平川，何处孤村近水边。\n烟护刘琮残壁垒，雨沉黄祖旧楼船。\n寒沙细拥菰芦地，破陇斜耕苜蓿田。\n见说去年秋潦后，更无茅屋起炊烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南楼怀古五首 其二","author":"周弼","text":"事久销沉只等闲，好将深意递相参。\n舳舻宵遁谁思忖，裙屐春游自笑谈。\n西日瘴回迷汉沔，北风波逆上江潭。\n隔城方唱招魂引，一拍殷勤至再三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南楼怀古五首 其一","author":"周弼","text":"昔人有意久经营，极望寒芜远更平。\n三国旆旌群鹊散，六朝楼阁一鸠鸣。\n雪消晴嶂沉孤垒，风打寒潮入废城。\n多少怨魂销不尽，草根烧断又还生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居漫成 其二","author":"周弼","text":"乍归无定业，萧索带村居。\n神树当中朽，人家著外疏。\n藻痕千漂絮，花影一床书。\n何必为真隐，相安便有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庭下枯梅有感","author":"周弼","text":"庭下同栽两树梅，一株摇落一株开。\n无缘春色相亏曲，有分晴光亦往来。\n雪打枯枝愁汉驿，雨翻雕萼梦荆台。\n绮窗不断横斜影，犹有东风管碧苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"施潭","author":"周弼","text":"归程风强阻，春色有如无。\n上水千帆健，中流一碇孤。\n雨冲寻屋燕，云背立樯乌。\n尽说明朝顺，江行旧有图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暮登黄鹤楼","author":"周弼","text":"欲尽残春酒，登临事已违。\n听残怀旧笛，添尽禦寒衣。\n鸟向青山没，人来赤壁稀。\n最怜城侧树，无可作花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵东麓归自房陵","author":"周弼","text":"一年辛苦后，收聚若为丰。\n摄职全无吏，携家仅有童。\n乳舂花下管，漆溜叶间筒。\n自此嬉游地，应须且浙中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之汉上","author":"周弼","text":"木落千山怨别离，自知难驻马行蹄。\n上书季子穷归洛，献赋荀卿老向齐。\n驿店破旗秋雨细，戍楼残角夕阳低。\n袖藏秘策君门远，应望中原泣鼓鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之京口","author":"周弼","text":"竞携书剑去纷纷，谁解登临对日曛。\n北道荆夔一江下，南朝徐兖二州分。\n高楼角晓鸣秋雨，远戍烽寒起暮云。\n莫把寻常望瓜步，恐惊边雁不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之荆门","author":"周弼","text":"昔年此路达王畿，荒烧畬烟事已非。\n山向崤函空北望，水随江汉自东归。\n凄凉坂路征车远，寂寞邮亭候火稀。\n遥想思乡怨岐路，杜鹃花发鹧鸪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游边","author":"周弼","text":"平世绝边筹，怜君古塞游。\n谁听蒯缑剑，虚弊黑貂裘。\n宵柝鸣荒戍，寒烽起废楼。\n到应先吊古，恸哭岘山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人持节岭南","author":"周弼","text":"吴云迢递楚云鲜，从此南征路几千。\n汉使五羊登岭日，鲁经三豕渡河年。\n榕穿白草飞蛮雨，椒落黄芽起瘴烟。\n待及戍瓜多载石，定无番货入归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送迁客","author":"周弼","text":"自谓别离难会面，如何此地又相寻。\n往来云物他乡意，轻薄风尘久客心。\n夜雨泥涂三里郭，夕阳烟火数家林。\n送君好去加餐饭，莫听哀猿彻晓吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈云崖游三衢","author":"周弼","text":"吟得诗成若等闲，为吾开尽锦囊斑。\n不专瘦岛元和末，要且长城大历间。\n帆入乱潮随涨水，帽冲残雪度危山。\n从今便少春游伴，才过新正可得还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送姚希声令弟归剡中","author":"周弼","text":"客程何太急，岁月半途分。\n想暂归天姥，还来伴使君。\n晓吟千嶂雪，春思一江云。\n若再经过此，囊诗可得闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡宗原还台山","author":"周弼","text":"故里杉松表，归程笋薤初。\n杯多常失饭，囊罄只留书。\n海墨收秦弃，山粮拾禹馀。\n古来仙隐者，多在赤城居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵山台赴江阴","author":"周弼","text":"匆匆何事解朝衣，甫为君王领一麾。\n历考近来成故事，就迁长是未多时。\n寒更夜彻防淮柝，晓舶晴翻出海旗。\n不久赤蹄应已到，只须略赋练江诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送惟德上人还鼋溪","author":"周弼","text":"为爱林间寺，幽闲少是非。\n因抛荜门业，来著稻田衣。\n石蕨冲云细，山蔬腻雨肥。\n禅居安稳后，更莫启柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄同甫","author":"周弼","text":"人生各有安，出易欲归难。\n古道春泥重，孤城暮雪寒。\n酒锋精似将，诗业远于官。\n野谷如堪饱，从君借鹖冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送惠嵩上人住西山兰若","author":"周弼","text":"孤云无定迹，又入乱山居。\n既息禅机稳，从教世网疏。\n晓香岩屋像，寒咒石潭鱼。\n待我寻诗境，看君坐隐庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒋云启之湘中","author":"周弼","text":"出门歧路分，愿往不辞勤。\n萤影侵湘月，蝉声隔楚云。\n频烧霜后箨，多饭雨中蕡。\n若过黄陵庙，椒浆奠小君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归旧隐","author":"周弼","text":"自言归去后，只在故山边。\n纱帽临溪盥，铜瓶傍水禅。\n昼闲松塔雨，春尽草堂烟。\n何故相抛舍，沉浮逐世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧妙通游平江万寿","author":"周弼","text":"故乡离几日，何处蹑秋陵。\n梵叶床头树，唐衣壁面僧。\n雨花粘旧锡，风箨扫寒簦。\n新偈期相寄，呵弹破小乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣沙秋日五首 其五","author":"周弼","text":"清溪楼阁暮沉沉，不觉登临夜欲深。\n几处捲帘催酒笛，谁家闭户捣衣砧。\n一朝野雾三朝湿，十日江天九日阴。\n暗喜碍人公事少，自来收拾送秋吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣沙秋日五首 其四","author":"周弼","text":"自惭尸素尝多暇，未放秋风变楚颜。\n一梦别离抛白水，三年端的守青山。\n野鸡避鹘遮雏去，沙翮衔鱼趁母还。\n纵有乱愁消遣尽，淡云残日共人闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣沙秋日五首 其三","author":"周弼","text":"长江淡淡树疏疏，扫却闲庭即故居。\n虫入暗床频促织，萤穿虚壁屡翻书。\n破除暮色惟荒菊，荐送秋华有嫩蔬。\n料得故园分社酒，小苞青橘四腮鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣沙秋日五首 其二","author":"周弼","text":"当前滩号西施碛，对碛看秋得句清。\n五色悬门秦一尉，六经充栋汉诸生。\n石丛细火团荒砌，野蔓疏金出废城。\n目送浣沙人去后，又闻街鼓报新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣沙秋日五首 其一","author":"周弼","text":"衣裳单薄鬓萧骚，独凭危栏首屡搔。\n出壁乱云分片段，隔江飞雨见丝毫。\n庭前断续蛩争响，檐外轻便蝶斗高。\n多少好山俱在眼，愧无短屐共游遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮远","author":"周弼","text":"横障瀰漫恃此丘，长江东骛转湍流。\n波间去海无多里，沙际铺淮辄数州。\n风势起花山郭暗，潮声侵树野田浮。\n无由望彻苍茫外，回首斜阳总是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别唐栖云泉上人","author":"周弼","text":"水宿唐栖寺，何缘更浃旬。\n千山今日路，三岁异乡人。\n小殿眠身佛，空廊折臂神。\n归时重作礼，又拂一番尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题唐栖寺","author":"周弼","text":"僧房十日相留恋，为怯生寒未到家。\n插岸断冰妨荡桨，入檐飞雪助煎茶。\n香台穴碎逃秋蚁，古殿巢翻失暮鸦。\n惟有溪梅最禁耐，傍篱争发向阳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起幽园检校","author":"曾由基","text":"病起无情绪，池边日几回。\n虫声低覆草，螺壳细生苔。\n暑退芦将变，秋残蓼续开。\n久消环绕迹，全若未尝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荻港","author":"周弼","text":"波眼沄沄浪复轻，稍苏羁束过清明。\n倩人觅路先寻酒，久客怀乡始见饧。\n松下紫芽肥野菜，竹间青叶带山樱。\n自从一别齐安后，直到今朝始听莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杜北山","author":"周弼","text":"一曲小湖滨，幽居不厌贫。\n坐容禅子憩，家就曲生邻。\n檐竹侵灯众，篱花落灶频。\n几时吟得句，寄与豫章人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄鹤林智福上人","author":"周弼","text":"深山高顶寺，黄鹤旧曾留。\n鹤去无踪迹，山僧几白头。\n鸟闲斋鼓静，猿啸佛灯幽。\n宿约何时践，题诗向瀑流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庾楼","author":"周弼","text":"欲望江山夜转真，胡床曾此对嘉宾。\n伤心皓月长流水，回首清风不见人。\n花落雉楼横角暮，草生鸥渚破船春。\n归程岂暇频登览，分付羁愁与白蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊","author":"周弼","text":"芳草渡头猿夜吟，孤舟一系百年心。\n旧游零落不知数，客路经过空复寻。\n暮雪关山千里雁，夕阳烟火数家林。\n明朝叹息东征士，发垢冠攲不欲簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登黄鹤楼","author":"周弼","text":"戚戚登临地，凄凄欲暮天。\n相看数株柳，不听一声蝉。\n山冷云生絮，江空月上弦。\n无缘舍尘事，闲对白鸥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"检校金盖别业","author":"周弼","text":"独棹一溪云，山回景自分。\n露花藏岸势，风叶乱泉纹。\n短箭催年急，微阳近草曛。\n断猿将落木，清夜不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩提废寺","author":"周弼","text":"野寺孤僧住，当春亦掩扉。\n晓钟三板去，昏杵一盂归。\n古屋垂山榧，幽窗养石韦。\n未容行客憩，荒树雨鸠飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野桥","author":"周弼","text":"日暮野桥边，都归醉客船。\n数竿沙际日，一片水中天。\n影落冲烟鸟，声移带雨蝉。\n殆非人境得，江月又初圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野望","author":"周弼","text":"春日晚荒荒，平沙极渺茫。\n楼攲三面水，城卧数条岗。\n白草吴京甸，黄桑楚战场。\n长江俱不问，一片泻斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野赛","author":"周弼","text":"客心怀避忌，地险自多神。\n枫叶藏山魅，松根抱石人。\n鹘翻苍黑翅，鱼曝赤斑鳞。\n未必知风候，惟闻酹酒频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿苑寺","author":"周弼","text":"分半作民栖，犹藏一曲溪。\n鹊窥莲叶座，僧占菜花畦。\n白蠹鱼销粉，青乾兽剥泥。\n幸留唐刻在，相伴峻廊题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄溪","author":"周弼","text":"匆匆宁不恨飘零，转更分岐过别汀。\n世事总如迂曲路，年华都付短长亭。\n冢桃褪蕊无人色，社栎盘根作鬼形。\n心自感伤人岂识，回头犹顾岘山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游道场山遇雨","author":"周弼","text":"飘然久作登临想，才遇名山雨亦游。\n林尾乱声犹间响，枝头残滴未全收。\n濯翻野竹从教亸，冲落岩花放出流。\n欲把姓名书石上，几回拈笔又成休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中有感","author":"周弼","text":"远程已过经行处，别有逶迤古道存。\n寺已寂寥犹有殿，水才穷尽又逢村。\n一株枯木人分路，十里飞花客过门。\n必竟悉依生处乐，不知何事别家园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事","author":"周弼","text":"书剑悠悠屡变迁，老谙多故始知天。\n汗青每愧抛长日，发白无由逐少年。\n暮雨暗消江岸柳，晓霜初透野池莲。\n此心悬解何须语，人问惟应一指禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪馆送别","author":"周弼","text":"旅馆成佳集，临觞送远征。\n厨烟含烛焰，溪雨夺琴声。\n愁动草边色，恨牵花外情。\n明朝过平望，应念隔春更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬李达可","author":"周弼","text":"归心终自遂，何必恋虚声。\n转觉青衫恶，谁怜白发生。\n扫花山石瘦，洗药野泉清。\n应有忘机者，时来伴我行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬杜八同宿西山兰若","author":"周弼","text":"西山龙井路，俱有旧行踪。\n待得城中暇，重期石上逢。\n冷霜粘破屐，落月带残钟。\n拟践相邻约，烦君买一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"誓节渡","author":"周弼","text":"仿佛经行地，还寻古渡边。\n山禽多白练，溪药间黄连。\n漠漠将晴雨，迢迢欲暝烟。\n恍然惊梦醒，二十有三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题夏肯父晓山图","author":"周弼","text":"旦旦自天成，中全一气清。\n渐分平与峻，俄转晦为明。\n竹閟铺沙影，松涵出谷声。\n机心都不动，稳看日初生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题逸人壁","author":"周弼","text":"深僻人稀到，天然野意成。\n荷冲崩岸出，草入废泉生。\n曝朮充山货，抽茶当地征。\n未须寻伴侣，时有自来莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题滕王阁","author":"周弼","text":"高阁巍峨接水滨，兴亡才问便伤神。\n鸣鸾东阁知何处，跨鹤西山别有人。\n柳映落霞江渚暮，草铺斜日野田春。\n群鸥亦厌多悲感，偏与忘机客最亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠唐栖寺僧","author":"周弼","text":"山门寂寞唐栖寺，别去闲居又一年。\n草暗暮田群雁远，花明春院一僧禅。\n云房夕磬浮清雨，水殿寒灯宿细烟。\n作得诗成无寄处，几回遥认隔溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠雪林李和甫","author":"周弼","text":"忽地相逢便解颜，况兼终日看青山。\n精神摘柳哦诗际，标度寻梅集句间。\n春淡野桥孤艇远，暮寒溪寺一钟闲。\n匆匆又作经旬别，两处东风各闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]