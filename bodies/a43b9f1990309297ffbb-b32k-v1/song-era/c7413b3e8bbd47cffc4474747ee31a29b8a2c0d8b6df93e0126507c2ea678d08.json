e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠道士","author":"张镃","text":"虎向深渊绕，龙归猛火蟠。\n昆崙飞日月，奚但鼎中安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜节堂","author":"张镃","text":"风冽前村有堕巢，何心寒苦自为高。\n堪怜让杀閒桃李，只得虚堂两字褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜橘","author":"张镃","text":"半霜黄绿尚斓斑，笑指清芬数日间。\n会得此中堪乐意，洞庭端合傲商山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藤枕诗","author":"张镃","text":"为爱江湖细雨声，短篷欹听买随行。\n那堪老去便轻软，肯羡珊瑚与夜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵书事四首 其四","author":"张镃","text":"人生富贵尽浮云，何必须因不义分。\n若有一丘能作主，更惭寇邓立功勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵书事四首 其三","author":"张镃","text":"曲涧斜穿竹最奇，岂容长夏有炎曦。\n林深纵怯湖风猛，更为支筇立少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵书事四首 其二","author":"张镃","text":"老藤横路几星霜，骨相清坚寿自长。\n敢惮侧巾方可过，折枝为子也何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵书事四首 其一","author":"张镃","text":"畦丁相引绕园行，指说亭基不记名。\n因想后湖题柱处，树林曾见作诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"张镃","text":"秋近疏飙未转凉，綵盘珠阁巳传觞。\n佳期天上频逢节，却老人间未有方。\n蟾魄嫩明情缱绻，鹊河斜界色沧浪。\n瓜盘华锦空儿剧，祷旱于今仰圣皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕前一夜翠樾堂设醮","author":"张镃","text":"矫首千寻古杏櫩，远林空处月钩纤。\n龙蛇薮泽秋声起，牛女虚空夜气添。\n满荡荷开从北看，危栏塔立向西瞻。\n绿笺封事精忱达，髴郁天香羽袖沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月菊","author":"张镃","text":"幽芳何事独开迟，寂寞寒金照短篱。\n老子樽罍方欠此，春风景物最相宜。\n要随得煖南枝发，肯趁登高九日悲。\n翻笑陶家门外柳，夜深零落舞腰肢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又呈坐客","author":"张镃","text":"天假南湖一段奇，宾朋胥会只论诗。\n人生未老肯閒日，春色无边方盛时。\n林外好山看独惯，尘中新事问宁知。\n从来邂逅宜真率，花下杯传却莫迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月十四夜观月思南湖","author":"张镃","text":"期会纷言不到诗，拙哉前计只心知。\n纵当吏散庭空后，争似山行水泛时。\n柳影半笼明处路，苇声轻窣暗边篱。\n波神擅此三更月，定讶今宵欠笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与诸弟游天竺","author":"张镃","text":"出门残月带晨鸦，飞盖相从纵五花。\n风绰败芦依岸老，水分洲渚抱山斜。\n櫜鞬未遂书生志，钟磬聊寻衲子家。\n何物最能舒望眼，晓云吹霁不成霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山寺小憩","author":"张镃","text":"趋寺松杉夹径栽，解鞍流憩得莓苔。\n尘昏金篆牌犹挂，灯暗纱笼殿不开。\n老鹤就凉临古井，幽禽寻食下生台。\n诗成漫记檐间柱，去矣何时复此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山茶花","author":"张镃","text":"翠翼高攒叶，朱缨澹拂花。\n来从山堑侧，开称画檐牙。\n影薄谁停绣，香清似煮茶。\n几多轻敛态，月动夹窗纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山堂晚兴","author":"张镃","text":"小堂清占景无哗，不向阶前种俗花。\n过雨家茶脱黄玉，近霜天竹缀丹沙。\n静眠宁羡蚁来梦，孤坐屡谙蜂报衙。\n万事一身安分定，关河休用发长嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书东迁褚氏壁","author":"张镃","text":"风晴舒望绿吹林，舣棹蒿田曲径深。\n淳朴山川追古俗，萧閒林谷许幽寻。\n籯金不必多留子，种德先须善用心。\n动我耕耘平日兴，浊醪归缓肯辞斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"张镃","text":"剩喜居园野趣成，今春添得四桥横。\n猿猴渐解擎书策，鹦鹉新能唤佛名。\n酒旆静垂墙杏雨，茶铛閒试砌莎晴。\n连年固自穷幽讨，新试频伽一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五日荥阳郡王饷酒","author":"张镃","text":"閒中滋味谙来惯，懒费心情为节辰。\n丹篆但期诗祟去，红泥俄见酒壶新。\n移船遣送随鱼信，洗盏开尝对鹤宾。\n绝胜渊明过重九，东篱空伴白衣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月十六日夜南湖观月","author":"张镃","text":"良宵观月岂无人，未必能看到四更。\n山载塔灯金笔立，水摇亭槛玉帘横。\n歌从菡萏香中起，酒向玻瓈盏内明。\n谁信南湖当暑夜，葛衣风透觉寒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五用前韵咏丹桂花","author":"张镃","text":"遍看韶淑万花林，谁似秋风巧力深。\n点注红泥千日酒，剪裁紫磨十分金。\n色迷仙令疑勾漏，香醉姮娥忘藁砧。\n莫把钓竿烟外去，珊瑚休道海中沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五林方沈氏居","author":"张镃","text":"路转苍湾静者家，抱墙脩竹舞薝斜。\n佛灯镜照无尽像，书馆池栽成行花。\n粗有田园真可乐，不维车服更何加。\n晚来清致因閒取，非故邀君一煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以洞庭橘寄杨秘监","author":"张镃","text":"橘色浑如柿色黄，诚斋有句合分尝。\n岂为都市颇难得，要是洞庭亲寄将。\n雨露山中今有味，星辰天上旧无香。\n遥知老监开奁处，为釂椒花雨一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以道次韵因再和二首 其二","author":"张镃","text":"顷年寻地喜初来，墙下松飘满径钗。\n屈指五经寒暑候，教人一扫利荣怀。\n南湖又共诗翁住，东寺须连单位排。\n触景未尝瞒昧得，肯从颜氏学心斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]