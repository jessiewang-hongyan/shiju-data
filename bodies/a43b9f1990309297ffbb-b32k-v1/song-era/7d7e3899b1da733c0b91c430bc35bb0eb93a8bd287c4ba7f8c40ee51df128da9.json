[{"title":"郑侍郎挽歌辞","author":"司马光","text":"云梦气回复，比肩生隽豪。\n司农家学富，廷尉里门高。\n骐骥昔千里，凤凰今一毛。\n即邱馀庆在，终应吕虔刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山寺","author":"司马光","text":"香刹冠嵯峨，松门络薜萝。\n风清尘不到，岸阔鸟难过。\n欲雨江声怒，新晴海气多。\n行舟未摇棹，回望隔烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南园杂诗六首 莲房","author":"司马光","text":"莲房前后熟，供啖不须齐。\n肉嫩山蜂子，棱深天马蹄。\n尚连馀蕊在，深映乱荷低。\n脆美知新采，近根犹带泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南园杂诗六首 萤","author":"司马光","text":"林塘荒湿地，向夕已飞萤。\n月没蛩吟砌，露凉人在庭。\n随风疑落烬，过水乱疏星。\n学子灯前寝，谁将尔照经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南园饮罢留宿诘朝呈鲜于子骏范尧夫彝叟兄弟","author":"司马光","text":"园僻青春深，衣寒积雨阕。\n中宵酒力散，卧对满窗月。\n旁观万象寂，远听群动绝。\n只疑玉壶冰，未足比明洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖 其二","author":"司马光","text":"海雁长桥北，乘闲日日来。\n游鱼自应乐，宿鸟不相猜。\n弱柳周遭合，芳花次第开。\n梁王昔游集，后乘列邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南湖 其一","author":"司马光","text":"宋都南野水，花柳媚名园。\n鸟起沙留迹，鱼惊浪结痕。\n朱桥通别岛，白路出荒村。\n城邑虽云迩，常无车马喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复古诗首句云独步复静坐辄继二章 其一 独步","author":"司马光","text":"踽踽出东轩，徐徐步小园。\n何须从吏卒，亦不引儿孙。\n蹑屐寻莎径，携筇拨水源。\n愁闻俗客到，唯说市朝喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复古诗首句云独步复静坐辄继二章 其二 静坐","author":"司马光","text":"一榻仅容膝，身心俱寂然。\n直缘知乐内，亦不为安禅。\n棐几陈编掩，竹窗残局捐。\n尚馀喧噪在，野鸟与林蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用三公燕集韵酬子骏尧夫","author":"司马光","text":"官闲虚室白，粟饱太仓红。\n朝夕扫三径，往来从二公。\n蒹葭徒倚玉，燕雀岂知鸿。\n相遇辄同醉，惟愁樽酒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣徽使河东经略使郑文肃公挽歌 其二","author":"司马光","text":"柳翣丧容盛，江山故国遥。\n清时独长往，何日重来朝。\n事与秋云断，荣如晓梦消。\n西风虎丘路，马鬣又嶕峣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣徽使河东经略使郑文肃公挽歌 其一","author":"司马光","text":"璿玑敷帝命，金节护边兵。\n尽付将军制，真为儒者荣。\n扶摇方上击，濛汜忽西倾。\n罢市人相吊，纷纷满百城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍读王文公挽歌二首 其二","author":"司马光","text":"杖底潜蛇影，门阴集戴鵀。\n玉楼新记就，石椁旧铭沈。\n箧有封峦札，籯无遗子金。\n寂寥封马鬣，秋色净松林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍读王文公挽歌二首 其一","author":"司马光","text":"石室书编富，金华讲席重。\n荐神归博洽，鸣玉称雍容。\n贰负累囚象，尸臣古瑑踪。\n老成今已矣，咨访欲谁从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故侍读学士张公哀辞二首 其二","author":"司马光","text":"凶梦歌洹水，妖巢集戴鵀。\n未尝馀俸禄，无以具衣衾。\n袁涣分仓谷，翁归赐府金。\n佗年纯固传，宁使令名沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故侍读学士张公哀辞二首 其一","author":"司马光","text":"喜愠与荣枯，居之悉晏如。\n稍门多执笔，至老不抛书。\n常愧无能极，曾沾清论馀。\n秋风郭门外，雨泣望丧车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故相国颍公挽歌辞三首 其三","author":"司马光","text":"沧波与邓林，鱼鸟久飞沉。\n一旦成陈迹，何人识寸心。\n高山亡景行，流水失知音。\n泪尽离东阁，归来破故琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故相国颍公挽歌辞三首 其二","author":"司马光","text":"铭旌远明灭，骑吹去低昂。\n三鼎功名大，重泉日月长。\n鹤飞来吊客，牛卧卜连冈。\n车马还城郭，悲风满白杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故相国颍公挽歌辞三首 其一","author":"司马光","text":"儒衣临绝塞，庙略运奇兵。\n缓带羌尘静，灵旗海雾清。\n公心结明主，阴德庇群生。\n名遂身仍退，人间五福并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故绛城","author":"司马光","text":"文公恢霸略，征讨辅周衰。\n奕世为盟主，诸侯听会期。\n山河表里在，朝市古今移。\n欲访虒祁处，乡人亦不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故翰林彭学士挽歌 其三","author":"司马光","text":"祖奠垂将撤，笳箫俨欲行。\n野寒嘶故马，树转出新旌。\n泉路幽无底，鱼灯暧不明。\n如何赍美志，郁郁向佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故翰林彭学士挽歌 其一","author":"司马光","text":"夙昔游清贯，时流籍重名。\n雠书石渠秘，视草玉堂荣。\n吉兆虚三鳝，凶期告两楹。\n子云思故国，坟树必西倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日思景仁","author":"司马光","text":"去岁洛城中，嬉游处处同。\n从离崿岭北，常梦潩泉东。\n草绕春街碧，花繁夕市红。\n临风默惆怅，想像白眉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春祠致斋寄呈景仁次道","author":"司马光","text":"比日聚官舍，笑言曾未厌。\n暂成挥手别，各有侍祠严。\n晴景朝朝丽，春容物物添。\n解斋当共醉，莫遣此期淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春猎","author":"司马光","text":"小苑微寒春雁飞，石关宫外草萋萋。\n汉家旌旆连围合，秦国山川入望低。\n花色才临珠缀发，柳阴欲傍金堤齐。\n韩嫣承恩来视兽，飞尘遥出建章西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳溪对雪","author":"司马光","text":"春风不胜雪，散漫度龙沙。\n密映缘溪柳，争飞乱眼花。\n鸱夷赊美酒，油壁系轻车。\n塞下芳菲晚，聊将当物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉水诗送吴都官分司归和州","author":"司马光","text":"泉水出幽谷，原流本自清。\n萦回遍中国，浩荡入东瀛。\n峡口春雷怒，潭心晓鉴平。\n悠悠随所值，行止两无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独乐园新春","author":"司马光","text":"春风与汝不相关，何事潜来入我园。\n曲沼揉蓝通底绿，新梅剪綵压枝繁。\n短莎乍见殊堪喜，鸣鸟初闻未觉喧。\n凭仗东君徐按辔，旋添花卉伴芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相国广平文简程公挽歌二首 其二","author":"司马光","text":"帝诰封泥紫，皇坟杀简青。\n坐谈安玉垒，专对詟龙庭。\n黼黻昭文理，冰霜瑩典刑。\n英灵入箕尾，终古作天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24303,"s