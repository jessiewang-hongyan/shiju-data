[{"title":"吴执中有两鹅为余烹之戏赠","author":"黄庭坚","text":"学书池上一双鹅，宛颈相追笔意多。\n皆为涪翁赴汤鼎，主人言汝不能歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴君送水仙花并二大本","author":"黄庭坚","text":"折送南园栗玉花，并移香本到寒家。\n何时持上玉宸殿，乞与宫梅定等差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈外舅孙莘老二首 其二","author":"黄庭坚","text":"甓社湖中有明月，淮南草木借光辉。\n故应剖蚌登王府，不若行沙弄夕霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈外舅孙莘老二首 其一","author":"黄庭坚","text":"九陌黄尘乌帽底，五湖春水白鸥前。\n扁舟不为鲈鱼去，收取声名四十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈杨康国","author":"黄庭坚","text":"君家秋实罗浮种，已作累累半拂墙。\n莫遣儿童酸打尽，要看霜后十分黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张仲谋家堂前酴醾委地","author":"黄庭坚","text":"沈水衣笼白玉苗，不蒙湔拂苦无聊。\n烦君斫取西庄柳，扶起春风十万条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李右司以诗送梅花至潞公予虽不接右司想见其人用老杜和元次山诗例次韵","author":"黄庭坚","text":"凡花俗草败人意，晚见琼蕤不恨迟。\n江左风流尚如此，春功终到岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李宗古出示谢李道人苕帚杖从蒋彦回乞葬地二颂作二诗奉呈 其二","author":"黄庭坚","text":"诗书传女似中郎，杞菊同盘有孟光。\n今日鹧鸪鸣蹇蹇，他年鹦鹉恨堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李宗古出示谢李道人苕帚杖从蒋彦回乞葬地二颂作二诗奉呈 其一","author":"黄庭坚","text":"提携禅客扶衰杖，断当姻家葬骨山。\n因病废棋仍废酒，鹧鸪鹦鹉伴清閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜似吟院二首 其二","author":"黄庭坚","text":"吟院虚明如画舫，想成槛外是长江。\n杜郎忽作扬州梦，雨带风沙打夜窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜似吟院二首 其一","author":"黄庭坚","text":"日长吟院无公事，燕入花开必有诗。\n莫道南风吹雁去，春来亦有北风时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨朴墓","author":"黄庭坚","text":"三尺孤坟一布衣，人言无复似当时。\n千秋万岁还来此，月笛烟莎世不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"求范子默染鸦青纸二首 其二","author":"黄庭坚","text":"深如女发兰膏罢，明似山光夜月馀。\n为染溪藤三百个，待渠湔拂一床书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"求范子默染鸦青纸二首 其一","author":"黄庭坚","text":"学似贫家老破除，古今迷忘失三馀。\n极知鹄白非新得，谩染鸦青袭旧书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔谢王朴居士拄杖","author":"黄庭坚","text":"投我木瓜霜雪枝，六年流落放归时。\n千岩万壑须重到，脚底危时幸见持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邹松滋寄苦竹泉橙曲莲子汤三首 其三","author":"黄庭坚","text":"新收千百秋莲菂，剥尽红衣捣玉霜。\n不假参同成气味，跳珠椀里绿荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邹松滋寄苦竹泉橙曲莲子汤三首 其二","author":"黄庭坚","text":"天将金阙真黄色，借与洞庭霜后橙。\n松滋解作逡巡曲，压倒江南好事僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邹松滋寄苦竹泉橙曲莲子汤三首 其一","author":"黄庭坚","text":"松滋县西竹林寺，苦竹林中甘井泉。\n巴人漫说虾蟆培，试裹春芽来就煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻水戏呈几复二首 其二","author":"黄庭坚","text":"月明遥夜见秋高，桂影依稀数兔豪。\n散发行歌野田上，一樽可慰百年劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻水戏呈几复二首 其一","author":"黄庭坚","text":"秋风落木秋天高，月入金樽动酒豪。\n过眼衰荣等昏晓，勿嗟迟速把心劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈说道约日送菜把","author":"黄庭坚","text":"南山畴昔从诸父，雨甲烟苗手自锄。\n三径就荒归计拙，溷烦僚友送园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮李氏园三首 其三","author":"黄庭坚","text":"手挼红杏醉繁香，回首春前梦一场。\n便与经营百船酒，再来应是菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮李氏园三首 其二","author":"黄庭坚","text":"日暮凉风特特来，醉呼红烛更传杯。\n歌阑兴尽须归去，不用繁蝉抵死催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮李氏园三首 其一","author":"黄庭坚","text":"小摘来禽兴未厌，蔬畦经雨绿纤纤。\n坐分紫石蒲萄下，不怕龙须罥帽檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮南禅梅下戏题","author":"黄庭坚","text":"新春江上使星回，不为离人寄早梅。\n爱惜幽香意如此，一樽岂是等闲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟壳轩","author":"黄庭坚","text":"紫极宫中三百楹，道人独藏一神屋。\n开轩纳息星月明，时有白云来伴宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到官归志浩然二绝句 其一","author":"黄庭坚","text":"雨洗风吹桃李净，松声聒尽鸟惊春。\n满船明月从此去，本是江湖寂寞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到官归志浩然二绝句 其二","author":"黄庭坚","text":"鸟乌未觉常先晓，笋蕨登盘始见春。\n敛手还他能者作，从来刀笔不如人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其十","author":"黄庭坚","text":"荣禄常思泽九宗，山摧梁坏床成空。\n百年遗恨谁昭洗，他日诸郎有父风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其九","author":"黄庭坚","text":"廊庙从来不在边，黄扉青琐庆登贤。\n除书未试回天笔，何意佳城到马前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其八","author":"黄庭坚","text":"陇上千山汉节回，扫除民蜮不为灾。\n蜀茶总入诸蕃市，胡马常从万里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其七","author":"黄庭坚","text":"军容百万转风雷，独料王师不战摧。\n三箧飞书公对狱，元丰天子照奸回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其六","author":"黄庭坚","text":"晋地无戎卧贼曹，民兵赐笏解弓刀。\n六年讲武儒冠在，不踏金门著战袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其五","author":"黄庭坚","text":"曾发公家钜万钱，沟中襁褓却生全。\n三齐水后皆禾稼，不杀耕牛更可传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其四","author":"黄庭坚","text":"更生苦讼石中书，宰掾非人欲引裾。\n两猾论兵几败国，同时御史更谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其三","author":"黄庭坚","text":"三晋山河数十州，频年水旱不能秋。\n我公出把司农节，粟麦还于地上流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叔父给事挽词十首 其二","author":"黄庭坚","text":"平生治狱有阴功，忠孝临民父母同。\n赣上樵夫谈卓令，宣城老吏识于公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe52