[{"title":"人送双雁","author":"姜特立","text":"卑栖笼槛尚成双，莫叹凋零未著行。\n犹胜孤飞千万里，洞庭波上冷吴霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人送岩桂二首 其二","author":"姜特立","text":"香馥清晨可疗饥，饱人胜食斋房芝。\n便好架巢枝上宿，不愁无酒只愁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人送岩桂二首 其一","author":"姜特立","text":"七月浊暑气氤氲，天香忽堕明月轮。\n一枝先入西风手，洗我三伏胸中尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人惠酴醾","author":"姜特立","text":"少年著意玩时芳，每爱风枝玉雪扬。\n老去此心浑忘却，不堪犹作故时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月","author":"姜特立","text":"十月气候变，园林霜叶黄。\n馀粮栖下亩，宿霭罩寒塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千叶海棠","author":"姜特立","text":"二八女儿初弄容，妆成意态有纤秾。\n点乱胭脂痕片片，潮生醉脸晕重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大笑菊","author":"姜特立","text":"玉瓣金心磊落花，天姿高洒出常葩。\n标名大笑缘何事，开口相逢有几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子陵","author":"姜特立","text":"足加帝腹狂奴态，自是君王礼数宽。\n四海但知天子贵，先生只作故人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子陵祠堂后两崖对起可高百丈或者指为钓台","author":"姜特立","text":"壁立双台百丈馀，如何竿线掷空虚。\n时人不会先生意，只钓清名不钓鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小池观鱼","author":"姜特立","text":"戏投饼饵方塘上，无限鱼儿翻翠浪。\n向来瓠瑟听遗音，今日梅山识清唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小桥","author":"姜特立","text":"小桥横野涧，物色自孤清。\n终日相晤语，松声与水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"姜特立","text":"不到山中久，山寒景益奇。\n冻泉零雪谷，坠叶弄风丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山间晓望","author":"姜特立","text":"老来活计不堪闻，啸月吟风自策勋。\n不爱黄金三万镒，只求清晓一山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山圃","author":"姜特立","text":"山圃归来花半空，尊前一别五春风。\n新松已自高三箠，旧堑还须广十弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"门外","author":"姜特立","text":"门外青山列髻螺，园中花木锦成窠。\n惭无功业报明主，空占閒居乐事多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不贪","author":"姜特立","text":"人间五福少，世事罕兼全。\n将此不贪宝，延予有限年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不寐","author":"姜特立","text":"老人夜不瞑，宿鸟未安栖。\n送睡凭杯酒，思晨听晓鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋追和李方叔咏舞者","author":"姜特立","text":"乐声催遍上华裀，回雪光中不见尘。\n今日山间易惆怅，当筵踏月更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中夏","author":"姜特立","text":"正此恢台夏，园池绿荫交。\n高荷擎羽盖，新笋出旗梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公馆","author":"姜特立","text":"公馆当清夜，移樽近北墉。\n秋声连蟋蟀，月色淡芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六十七守岁","author":"姜特立","text":"少时守岁喜蹁跹，老境衰颓只益眠。\n明日未应添白发，怕人问处是增年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六十遇明主","author":"姜特立","text":"六十遇明主，家空无一廛。\n百年今共尽，五福晚兼全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"友人招饮适云气大作雨意甚凉","author":"姜特立","text":"永日南薰入舜琴，故人邀我共披襟。\n歌姬可是能留客，故遏行云作午阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双桃寄巩经略三首 其三","author":"姜特立","text":"忽见双桃入眼新，捧看惊动坐间宾。\n老夫得此浑无为，持寿高堂两玉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双桃寄巩经略三首 其二","author":"姜特立","text":"世间固有无情物，天上宁无有欲仙。\n想得武陵人去后，精神交感此因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双桃寄巩经略三首 其一","author":"姜特立","text":"只说瓜莲并蒂生，几曾仙实见双成。\n却疑西母犹多事，戏作人间儿女情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬子岁送方叔","author":"姜特立","text":"经年怀抱几曾开，面上康衢一寸埃。\n已向西偏营小筑，高悬一榻待公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"心迹","author":"姜特立","text":"心迹清虚绝点尘，更无俗虑得相亲。\n可怜一片浮云性，付与逍遥自在人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆仲子","author":"姜特立","text":"吟哦五字有规模，妙处时时亦起予。\n送老百年将付汝，岂知颜路请吾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文潞公洛中会四同甲皆丙午七十八予乙巳生与丙午相属岁数偶同戏作","author":"姜特立","text":"洛中四老会同甲，太岁俱生丙午年。\n我亦联翩七十八，惜无一客伴华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方叔元振元老同令侄舍人见访","author":"姜特立","text":"联翩三凤接华裀，小阮驱车复后尘。\n嵇吕相思千古事，后来命驾更无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月","author":"姜特立","text":"万古长空月，亏盈不计年。\n魄生蟾共没，光满蛤同圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下","author":"姜特立","text":"晚来暑退坐前墀，袅袅南薰动翠微。\n便欲乘风游汗漫，白云顶上玩清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月俸至","author":"姜特立","text":"禄厚君恩重，才疏德性迂。\n入门随手散，不作守钱愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水村","author":"姜特立","text":"一水泻寒玉，数峰罗翠屏。\n渔樵自来往，不悟落丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王方叔丧耦","author":"姜特立","text":"人生大患身为累，火宅啼号更累身。\n闻道中郎唯有女，不妨半世作閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王思叔惠象牙笋","author":"姜特立","text":"鱼煮船头笋煮园，一时风味最甘鲜。\n君家象齿先春发，为我携锄斸翠烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风色","author":"姜特立","text":"风色作吴霜，山中草木黄。\n冷烟笼碧瓦，露叶遍寒塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍还里舍","author":"姜特立","text":"十载弹冠始一归，暗惊草露湿征衣。\n自怜犹胜辽东鹤，故旧相逢未尽非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至","author":"姜特立","text":"老来心绪怯年光，又见春来报一阳。\n未必暗添宫线永，只应先引鬓丝长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出处","author":"姜特立","text":"草木偃时龙入洞，鸟乌噪处虎行冈。\n大贤出处须惊俗，伊尹如何五就汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出关","author":"姜特立","text":"宦路崎岖阅岁华，更无佳思发诗葩。\n出关便有山林兴，续稿从今渐有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出西湖至天竺","author":"姜特立","text":"宝叔山前翠打围，涌金门外水涟漪。\n出关便有渔讴起，底事公卿都不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出闽中四首 其二","author":"姜特立","text":"千里携家一秃翁，一尊倒尽百愁空。\n野梅可是工迎客，排日开花到浙中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出闽中四首 其一","author":"姜特立","text":"山行十日到吾家，腊尽归人惜岁华。\n斗酒只鸡谁劳我，更须踏雪看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出郭","author":"姜特立","text":"岁暮偶出郭，斜阳带远村。\n雪松含腊意，沙水动春痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去燕","author":"姜特立","text":"去燕忽若失，断蝉凄复连。\n不唯观物化，且以感流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古意","author":"姜特立","text":"共绾同心结，那知有别离。\n对人争忍说，不敢画蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对花戏作","author":"姜特立","text":"八十衰翁岁月高，可怜老气尚粗豪。\n春来纵被花相恼，半是无心半搭猱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其八 归耕","author":"姜特立","text":"归耕此计未为迟，畎亩艰难已素知。\n伊尹佐商功业盛，却思前日有莘时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其二十一 多稼","author":"姜特立","text":"富贵多为居养移，田家作苦记农时。\n亭名多稼非无意，后代儿孙却要知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其九 夹芳","author":"姜特立","text":"四时花木巧玲珑，夹路纷纷紫映红。\n步障不须西蜀锦，相公行处裹春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十三 岁寒","author":"姜特立","text":"森森翠色密藏烟，雾鬣风髯上拂天。\n应伴我公长不老，不知化石在何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十八 红香","author":"姜特立","text":"子因南岳仙人得，花自蓬莱海上来。\n每岁枝头春意闹，香风红艳满楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其七 西湖洞天","author":"姜特立","text":"洞天别是一蓬瀛，桂馆时时吹玉笙。\n中有仙翁长不老，不知几个董双成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其二 许閒","author":"姜特立","text":"裴相功成归绿野，谢公人望起东山。\n巨川欲济须舟楫，只恐求閒未许閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十四 忘机","author":"姜特立","text":"机心已尽自虚明，滓翳宁容点太清。\n寄语堂前鸥与鹭，五湖烟水莫寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十九 远尘","author":"姜特立","text":"高亭迥出人寰表，须信仙凡路已分。\n世上俗尘那得到，如今步步是青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其三 和容","author":"姜特立","text":"君侯不与力科同，能事都归德行中。\n矍相圃间唯孔子，和容堂上独韩公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其一 南园","author":"姜特立","text":"南园山水神仙窟，上世源流忠献家。\n昼锦堂中诗句好，因诗名榜更光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其二十 幽翠","author":"姜特立","text":"万竿翠竹拥山隅，时有风前一鸟呼。\n公若来时罢箫鼓，尽收幽意入蓬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十二 矜春","author":"姜特立","text":"莫疑造物擅天工，先借孤根暖气通。\n待得乾坤生意广，一时散施与东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其六 凌风","author":"姜特立","text":"花木楼台锦不如，关门下瞰更凌虚。\n他时老子如相过，认取东来青犊车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十六 堆锦","author":"姜特立","text":"天机织处纷红绿，丹凤衔梭自往来。\n全似蜀江初濯罢，风和日暖锦千堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其四 寒碧","author":"姜特立","text":"千层山色参空碧，十里波光照眼寒。\n六月火云横障日，好来此处凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十五 照香","author":"姜特立","text":"华池岛屿屹中间，花木毵毵水一环。\n恰似诸姬梳洗罢，一时窥镜弄娇颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十一 鲜霞","author":"姜特立","text":"蟠桃花发景争新，流水漂香几换春。\n洞口霞光长蔽日，须知中有武陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其五 藏春","author":"姜特立","text":"牡丹过后看红药，赖有藏春得少留。\n恰似隋宫千綵女，锦帆一夜下扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平原郡王南园诗二十一首 其十 豁望","author":"姜特立","text":"高亭四望与天开，乘兴登临亦快哉。\n胸次如公无滞念，时时只合眺崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归乡二首 其二","author":"姜特立","text":"五十馀年别故山，今朝底事挈家还。\n老来报本思宗祖，不为豪夸里巷间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归乡二首 其一","author":"姜特立","text":"忆昔东坡老，曾吟陌上花。\n我今归故里，卉木正光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归老","author":"姜特立","text":"归老得閒浑可事，最怜白傅更能诗。\n舞馀歌罢宾朋去，八节滩头醉卧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归括苍如山堂挈家出宅 其二","author":"姜特立","text":"且唱还乡曲，初非衣锦衣。\n不须华表望，丁令此时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归括苍和杨嗣之吏部烟雨楼韵四首 其四","author":"姜特立","text":"宴坐帘旌捲翠微，朝昏万变发新姿。\n锦囊莫怕岚霏湿，带取风光入凤池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归括苍和杨嗣之吏部烟雨楼韵四首 其三","author":"姜特立","text":"绝唱从前恨未多，骚人墨客浪经过。\n直须吏部杨夫子，始奈楼中烟雨何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归括苍和杨嗣之吏部烟雨楼韵四首 其二","author":"姜特立","text":"几重绿树暗罗纨，多少空濛远近山。\n物色联翩吟不断，使君佳句玉连环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归括苍和杨嗣之吏部烟雨楼韵四首 其一","author":"姜特立","text":"谁发天悭得胜游，佳名收拾更无留。\n郑虔祁岳今谁是，为扫阴沈万壑秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归故园二首 其一","author":"姜特立","text":"向来叨趁内朝班，宫漏鸡声晓梦间。\n今日身閒无一事，五年睡债一时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归故园二首 其二","author":"姜特立","text":"桃李归来已半空，不堪春事去匆匆。\n落红犹自留连客，故向尊前舞晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]