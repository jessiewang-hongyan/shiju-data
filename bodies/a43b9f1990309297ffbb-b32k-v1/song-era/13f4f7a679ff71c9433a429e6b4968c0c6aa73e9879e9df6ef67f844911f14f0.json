[{"title":"蓼花","author":"朱松","text":"长年心事只悠悠，衰鬓难禁岁月流。\n红蓼垂垂烟雨里，不应摇落始知秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃花","author":"朱松","text":"核裹黄泥洒石崖，今年繁蕊便争开。\n游人要识春多处，但觅红云逐水来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔父用儿甥韵","author":"朱松","text":"绿蓑青箬一身轻，卧看行云舟自横。\n米贱鱼肥美无度，不知东海正掀鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送山老住三峰寺 其一","author":"朱松","text":"未办同穿荦确行，西风挥手最关情。\n只应勃窣喧卑里，认得峰头啸月声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送山老住三峰寺 其二","author":"朱松","text":"钵中忽见三峰影，便觉市廛尘涴人。\n寄语阶前石池水，老夫衰发已盈巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏代作送住郎","author":"朱松","text":"同攀梅蕊便分携，回雁峰前试綵衣。\n学就浯溪崖上字，雁回莫遣信音稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄范伯达","author":"朱松","text":"名籍丹丘号散人，何时香火共朝真。\n只应经世平生意，未合归愚便问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试笔","author":"朱松","text":"老来诗思如焦谷，自愧霜毫来故乡。\n乞与杨家枣心样，要将掣管试诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"篁竹笋","author":"朱松","text":"梅雨冥冥稻已齐，连云篁竹暗蛮溪。\n短萌解箨登雕俎，错落黄金騕袅蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日桃李华","author":"朱松","text":"北风日日卷尘沙，桃李凌寒强自葩。\n莫作春光流转想，要知枯蘖是狂华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题范才元湘江唤舟图用李居仁韵","author":"朱松","text":"天涯投老鬓惊秋，梦想长江碧玉流。\n忽对画图揩病眼，失声便欲唤归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赵守中江行初雪图","author":"朱松","text":"江阔云垂满袖风，急须下马一尊同。\n正应无奈催诗雪，句在渠侬拥鼻中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送五二郎读书","author":"朱松","text":"尔去事斋居，操持好在初。\n故乡无厚业，旧箧有残书。\n夜寝灯迟灭，晨兴发蚤梳。\n诗囊应令满，酒盏固宜疏。\n貘羁宁似犬，龙化本由鱼。\n鼎荐缘中实，钟鸣应体虚。\n洞洞春天发，悠悠白日除。\n成家全赖汝，逝此莫踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古七首 其四","author":"释祖璿","text":"安贴邦乡老赵州，时辰使得最风流。\n今朝有酒今朝醉，明日愁来明日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访姚雪蓬贬所","author":"释渊","text":"故里田园抛弟妹，异乡灯火对妻儿。\n十年漂泊孤篷雪，谁补梅花入楚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吏部张尚书帅成都一百韵","author":"朱翌","text":"一代亨衢上，明公逸步超。\n河东书具作，圯下老相邀。\n海阔云垂翼，天清斗压杓。\n三人前鼎甲，千佛仰孤飙。\n弟子师尊董，诸儒称述萧。\n西昆收俊乂，东壁绝尘嚣。\n别乘将离汴，轻舟径指苕。\n湖山纵清美，家国尚飘摇。\n恸哭天倾柱，归情户见蛸。\n奉祠投里闬，招隐向山椒。\n并海屯千卫，披榛拱百僚。\n回銮须故国，负靮且今朝。\n光列哀乌位，星驰封马轺。\n贤裾来接武，阴沴自潜消。\n香案依丹陛，螭坳立紫霄。\n飞鸿九天去，归鹤一声嘹。\n主上思图旧，王人促见招。\n起居还左史，议论鄙南朝。\n大吕声扬远，元圭质匪彫。\n掖垣裁诏密，禁路赐缨彯。\n灭浇图兴夏，巡方首从姚。\n自南瞻析木，直北望玄枵。\n玉海千寻浪，江南五色鹞。\n矫如出尘隼，凛若在秋雕。\n去国还追信，刓章岂易尧。\n光华司马甲，整顿路车鞗。\n国事烦参决，廷询得具条。\n乘时笑乾没，许国敢轻佻。\n河洛干戈满，陵原草木焦。\n青春深仗节，久雨更乘橇。\n取道先辕楚，扬旌转望萧。\n一抔藏万世，九庙正三昭。\n遂使仪如汉，将令乐奏韶。\n路迷彪过迹，涧涸夜生潮。\n去日春仍浅，归期暑正熇。\n君王喜不寐，天下首方翘。\n疏奏忠无隐，臣生苦不聊。\n戴天那忍共，得地岂宜骄。\n内治今当亟，高名不敢要。\n铨衡真有托，启事复何辽。\n道直咸推汲，谋深岂计晁。\n定非挥扇羽，宁要插蝉貂。\n褒贬书方举，奸谀骨合销。\n怀开真坦坦，燕处自夭夭。\n当宁西南顾，常怀参井迢。\n遍询医国效，立遣愈民痟。\n文武资兼禀，诗书气不恌。\n众皆可郤縠，一以委张昭。\n除目凌晨下，行装即日撩。\n被携犹剌刺，涉远乃翛翛。\n帆影三江水，车声万里桥。\n丈人峰嵂屼，神女峡岧峣。\n石室画闇淡，草堂人寂寥。\n山围玉垒峻，水减石犀遥。\n石表笋双立，铜青柏未凋。\n锦江喧士女，药市混仙樵。\n劫堕乾坤坏，流横海岳漂。\n惟兹井络外，依旧角弓弨。\n自昔三刀梦，多传五裤谣。\n威馀严仆射，功说李文饶。\n文定棠尤美，乖崖福可徼。\n事今难悉数，公亦岂其苗。\n秦地新通栈，瞿塘稳泛桡。\n虎貔环外阃，耨耜得深穮。\n正可供壶奕，随宜列鼓箫。\n蒲鞭束高阁，竹马戏垂髫。\n好阅相如赋，终閒李广刁。\n奎文天象转，延阁士林标。\n此去庭无愈，行闻众选陶。\n付之枢极运，咸仰泰阶霄。\n贱子无三径，平生有一瓢。\n老将书蠹槁，时作草虫喓。\n大笑玉三刖，不求银十腰。\n古今同阅宙，南北信吹薸。\n已类蜂粘网，真成鹿覆蕉。\n屡经多盗境，几至独身跳。\n何处地堪避，知谁战敢挑。\n月明三匝鹊，巢比一枝鹩。\n钓濑长烹鲤，穷山饱听鸮。\n临书池尽黑，就局博嫌么。\n臂有七贤把，丹亡九转烧。\n唯堪贯薜荔，未肯摋芳虈。\n卖药难争价，为农等寓侨。\n稍能羞野葛，初未识江珧。\n已罢寻蛩駏，欣闻退猲獢。\n谁怜人为米，敢有意迁乔。\n过我深披藋，追凉薄曳绡。\n狐裘怜晏子，缟带与公侨。\n挽引烦推毂，陶甄为置窑。\n清时容潦倒，策府著刍荛。\n忆昨西湖上，随公羽盖飘。\n青山迎晋履，绿水泛湖?。\n上相尊仍美，将军勇正骁。\n道争棋屡覆，壶响箭呈枭。\n茶乳晴尤发，香云净更翲。\n晚花栖嫩菊，近岸俯游鲦。\n四望天连水，群簪玉及瑶。\n政亲连榻坐，倏见锡戈雕。\n良月霜枫冷，佳晴雪霰销。\n留公已无策，鼎食望加调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"投壶 其二","author":"朱翌","text":"哨壶枉矢乐初筵，列坐分曹看令传。\n龙跃隼飞惊背手，云开电击笑通天。\n齐侯晋侯誇酒肉，鲁鼓薛鼓排方圆。\n何事吾人无一事，竹床高卧听铮然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"投壶 其三","author":"朱翌","text":"五扶新拓室中筵，列算姑从旧制传。\n百发纵横惟所命，一时胜负岂非天。\n功成只许全为上，手熟犹如左画圆。\n卜昼未厌仍卜夜，铜槃高捧烛花然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"投壶 其四","author":"朱翌","text":"三代遗文叹寂寥，考评今古得愁消。\n中行穆子虽争隽，司马温公不贵枭。\n鈇钺他年专将阃，羽仪从此冠天朝。\n倒囊剩欲陪宾戏，零落空馀一弊貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"朱翌","text":"天气未佳宜且住，风涛如此亦安归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感白发","author":"姚孝锡","text":"弹铗凭谁听客歌，震雷那复化鱼梭。\n梳头白雪惊新有，障眼元花比旧多。\n乡问阻兵犹断绝，羁怀凭酒暂消磨。\n不须更问今朝客，门外元无雀可罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜀葵","author":"姚孝锡","text":"倾心知向日，布叶解承阴。\n空侧黄金盏，谁人与对斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂三十首 其十四","author":"释慧晖","text":"棱棱一气未生，凄凄一神未现。\n默默风未起波，皎皎月未发光。\n历历万象未乱，明明森罗未参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"何麟","text":"梁山韭黄妙天下，玉箸金钗盈大把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"释慧日","text":"溪绕茅堂山绕溪，溪山深处是真栖。\n山人若问西来意，云自高飞鸟自啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十四","author":"释智朋","text":"六载将身草里埋，当时有眼几曾开。\n果然见得明星现，未到门庭冷似灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三一","author":"释智朋","text":"人天眼目，渥洼真产。\n踏杀天下人，今古何曾间。\n马师不曾过去，衲僧自生隔远。\n不隔远，蜀旱不旱，蜀有彭汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一七○","author":"释智朋","text":"白首儒生困路歧，残杯冷炙饱还饥。\n一朝得意春风里，便把驴儿作马骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉步前溪示彦冲","author":"胡寅","text":"溪南溪西渺双溪，中有良苗绿千畦。\n参差人家傍脩竹，隐约负戴通山蹊。\n南溪先生冰雪胸，虚堂坐咏荷花风。\n西溪散人晞汗发，半夜泉头饮明月。\n欲赏奇文析疑义，蕴隆当路不可越。\n安得阿香轻著鞭，驱龙噀雨玄云边。\n径携枕簟就公宿，对床饱听秋声悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题泉石轩","author":"胡寅","text":"过桥忽与平畴对，石路鳞鳞蹴蛇背。\n登堂面势脩竹林，百叠青瑶衬其外。\n就中新著小轩奇，湩乳披崖草树滋。\n苍牙砑然如虎饮，一泓寒碧湛琉璃。\n雪花茗盌浮谈席，欲去泠然生两腋。\n留诗聊足记岁年，更写轩题号泉石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和坚伯梅六题一孤芳二山间三雪中四水边五月下六雨后每题二绝禁犯本题及风花雪月天粉玉香山水字十二绝 其七","author":"胡寅","text":"东阁题诗得绪馀，溪头千树绕幽居。\n来禽青李曾何算，底事犹传逸少书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆端子三首 其三","author":"胡寅","text":"不见佳儿正一年，钟情难遣故依然。\n久知朝菌同年寿，终惜童乌早弃捐。\n箧里诗书迷白日，堂中珠玉堕黄泉。\n汝翁去此知多少，安得忘怀未死前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自君之出矣二首 其一","author":"曹勋","text":"自君之出矣，龙香消宝衣。\n思君共明月，千里奉光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自君之出矣二首 其二","author":"曹勋","text":"自君之出矣，妆台生网丝。\n思君拂团扇，相与共提携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮阴庙","author":"曹勋","text":"当年汉室已兴隆，自是侯居太半功。\n火德正炎神预否，他时为造楚王宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题应之二扇 其二","author":"曹勋","text":"一带晴林散晓鸦，山边理棹钓云沙。\n有人策蹇春风里，应向溪头问酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄节夫问疾以偈答之","author":"曹勋","text":"四大和合成我身，四大损增成我病。\n我病在枕谁为起，我艾在身谁为痛。\n惟此疾痛切身时，毕竟二事谁复代。\n公今累纸示格言，愿示免疾痛一句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"吴说","text":"出峡名标第一楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乞赀曹绩","author":"释法空","text":"一梦江湖已十春，芒鞋不践马头尘。\n只知今日了今日，岂料一身愁一身。\n南阮固应惭北阮，越人哪得累秦人。\n西风不但吹游子，吹老天涯白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短歌行","author":"郭世模","text":"天东衔烛龙，光景照四溟。\n羲和揽龙辔，鞭策日夜征。\n露华以春晖，霜叶当秋零。\n危柱无弱弦，急辕无留旌。\n华发不再绿，彫颜宁重荣。\n良辰足行乐，羁旅难为情。\n乌程有美饷，为人驻颓龄。\n玉指陈兰藉，歌钟閒鸾笙。\n短章可娱日，意气聊相倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与仲弥性同次唐人二诗韵 其二","author":"李衡","text":"天面无纤霭，平川灏气吞。\n支筇临阁道，拂石憩云根。\n柳映山前路，烟摇水北村。\n醉归风满袖，斜月在蓬门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐庵所藏柳影及松梅二画因作二绝摹作砑花笺至今盛行于吴门 其一","author":"李衡","text":"三月江南花满枝，风轻帘幕燕争飞。\n游人休惜夜秉烛，杨柳阴浓春欲归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小立","author":"王铚","text":"茅屋藤萝外，凭栏烟霭间。\n乱蝉催暑去，急雨带秋还。\n路入双溪口，门当四面山。\n诗成题未有，翰墨伴清閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆左丞夫人郑氏挽词四首 其一","author":"王铚","text":"家学开皇纪，淑声通德门。\n内朝班早贵，中壸誉尤尊。\n闻说百年事，扶携两世孙。\n从夫得文伯，万古姓名存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"王铚","text":"惨惨风林叫竹鸡，冥冥山路晓光微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庵居 其二","author":"释仲皎","text":"无地卓锥生计难，且空双手到林间。\n猥随碧水瞻明月，坚订白云赊好山。\n岩石空边依草舍，藤萝低处著松关。\n年来老去知何许，合向人间占断闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪作望剡溪","author":"释仲皎","text":"玉楼琼树晓烟披，拥衲开门四望迷。\n清旷世人谁似我，雪中更对子猷溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安仁道中","author":"刘子翚","text":"汩汩复汩汩，著鞭鸡一号。\n老身缘底急，长路只徒劳。\n石乱春溪恶，山深晓月高。\n村沽得微醉，犹足张馀豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李伯时画十古图郑尚明作诗诗辞多振绝因为同赋 醉山简","author":"刘子翚","text":"倒载山公岂酒狂，群儿拍手岘山旁。\n汗青等是虚填耳，不把云台唤酒乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和黄德钦韵赠公路二孙","author":"刘子翚","text":"佩鲽趋跄政妙年，阶庭兰玉固天然。\n人间百艺皆由学，惟有读书知子贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡湘江吊严子陵","author":"詹慥","text":"光武亲征血战回，举朝谁识渭川才。\n熊罴果有周王卜，未必先生恋钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"刘奇仲","text":"玄中一著是吾宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"王晞鸿","text":"红尘紫陌江声外，绿嶂青岚书几间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴五首 其一","author":"范浚","text":"雉骄有擅泽，鸡雄亦专栖。\n乘人肆桀傲，未异雉与鸡。\n虚张尽客气，不知堕危机。\n雉骄或登俎，鸡雄亦为牺。\n嗟尔桀傲子，不戒将安之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴五首 其二","author":"范浚","text":"荆枭昔见恶，去楚将巢吴。\n妖音不知革，吴岂荆人殊。\n枭能戒颊舌，勿复轻鸣呼。\n虽荆亦容尔，何必他邦居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴五首 其三","author":"范浚","text":"高蝉荫嘉木，未省螗斧危。\n勇虫亦何愚，不顾黄雀饥。\n痴痴挟弹子，已复露沾衣。\n世事无不然，古今同一悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴五首 其四","author":"范浚","text":"鹊噪得欢喜，乌鸣得憎嗔。\n乌鹊自有口，噪鸣何预人。\n乌飞声哑哑，鹊飞声啧啧。\n凡鸟从纷纷，未用置肝鬲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂兴五首 其五","author":"范浚","text":"彭亨著冠猪，踉蹡上车鹤。\n皇家一清明，此辈束高阁。\n龙夔杂鹓鹭，庶位已参错。\n少安真可待，四海得耕凿。\n我亦幸丰年，从容一丘壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴五首 其一","author":"范浚","text":"商山园绮徒，雪发映松露。\n山间谓终老，不踏市朝路。\n一朝前星匿，羽翼起调护。\n婆娑古衣冠，笑定国储副。\n留侯计偶尔，曷遽动贞素。\n因知古今士，出处自冥数。\n功名苟不免，四老犹一助。\n宁庸巧驰驱，失尔邯郸步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴五首 其二","author":"范浚","text":"少陵古诗伯，未必真豪人。\n胡为冷炙辱，自分潜悲辛。\n莫倚善题赋，未悟严武嗔。\n徒言磊落士，不肯异其身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴五首 其三","author":"范浚","text":"我逢刘颍川，竟夕不向枕。\n馀人偶对面，白昼辄欲寝。\n生来不耐俗，敢妄作题品。\n犹嫌太分明，客至姑与饮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴五首 其四","author":"范浚","text":"庞眉困郎署，白首命不遭。\n猿臂无侯封，徒负射虎豪。\n两者阨天运，材智俱莫逃。\n向来邓氏子，志行劣可褒。\n藉非逢际会，未免掾功曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴五首 其五","author":"范浚","text":"翻云覆忽雨，昨火今已冰。\n三涂九州险，未似今人情。\n人言馀耳事，令我不忍听。\n嗟哉泜水上，刎颈遂寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]