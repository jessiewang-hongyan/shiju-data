[{"title":"重过凤山高氏","author":"张镃","text":"屋负山陲晚，篱侵水泺秋。\n农桑能自力，鹅鸭岂它求。\n逆数曾来日，遮留更觉稠。\n夜歌听欸乃，催兴满沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叔祖户部侍郎诗四首 其四","author":"张镃","text":"内典存心久，家居戒行僧。\n同尘聊且尔，著相亦何曾。\n脱却当来裤，传将不尽灯。\n欲知归甚处，一月万波澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叔祖户部侍郎诗四首 其三","author":"张镃","text":"小小为知己，常常说向人。\n论情宗族异，问事见闻新。\n囊锦将谁管，湖园看未真。\n伤心啸庵路，不复送亲宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叔祖户部侍郎诗四首 其二","author":"张镃","text":"八郡恢成绩，江山入壮图。\n风流羊叔子，才术管夷吾。\n绝笔诗犹在，酬君志不渝。\n经纶如有位，肯堕浅规摹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叔祖户部侍郎诗四首 其一","author":"张镃","text":"从此无因见，南园老叔翁。\n朝廷世臣少，文献我家穷。\n达宦谁无分，全材不易逢。\n先王勋第一，号恸仰天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓出海会过新溪渡","author":"张镃","text":"喧喧人语俶行装，广殿灯寒暗古廊。\n桥截漫滩收夜色，路经层岫吐朝阳。\n鳞差白石中流见，栉比篬筠夹坞香。\n爽气正浓诗兴薄，归途应愧挈空囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓探晴观梅","author":"张镃","text":"天鸡催日界窗横，蹑屐看花兴便成。\n正尔飞霞舒綵佩，尽渠宿雨结珠缨。\n飘零未带溪边笛，缥缈如临海上城。\n身世长吟谁会得，华祠梅市总逃名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓寝喜成","author":"张镃","text":"人间一事最幽奇，病醉皆非半睡时。\n经纸屏低心正惬，木绵衾暖足慵移。\n蘧蘧蝶梦萦孤枕，呃呃鸡声过短篱。\n无奈冲寒早朝客，不知疏拙是便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂树下作","author":"张镃","text":"芳桂年年种，今秋两倍开。\n略无蜂敢傍，为是月中来。\n幸自晴多日，须?醉几回。\n便教香杀了，犹胜别人呆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂隐花正开得诚斋木樨七言次韵奉酬","author":"张镃","text":"未说香高众卉林，清名先巳入人深。\n衣青萼绿不见佩，屋贮阿娇纯用金。\n久恨酒肠悭似盏，更输诗字响如砧。\n公能为办归休计，肯向花前叹陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花","author":"张镃","text":"园翁能好客，折赠小春桃。\n却为开花少，翻成占格高。\n来年红烂漫，绕涧碧周遭。\n莫忘阊门外，曾将进浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烟波观月示客","author":"张镃","text":"半年殊少夜间来，湖上今宵绝点埃。\n人老纵教过百岁，月圆难保看千回。\n舒眉酒饮休辞满，冲口诗成不待催。\n自有一般堪乐处，却言山水近亭台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离无锡夜入溪庄港口","author":"张镃","text":"出山犹自雨随车，到得溪桥一点无。\n冷月半明云未去，垂杨成行叶全枯。\n竹添东墅方清荫，人在南湖巳白须。\n应是田翁喜侬至，旋吹灯火竞欢呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离城中","author":"张镃","text":"雨后溪流尔许深，枕堤楼阁静沉沉。\n暂来殊郁登临恨，欲别难禁去住心。\n倚槛乍离桥百尺，系船犹恋柳千寻。\n黄昏最喜林端月，影掠波寒彻底金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读乐天诗","author":"张镃","text":"诗到香山老，方无斧凿痕。\n目前能转物，笔下尽逢源。\n学博才兼裕，心平气自温。\n随人称白俗，真是小儿言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谁谓","author":"张镃","text":"谁谓閒无事，閒中事日生。\n和香雕印脱，记石假云名。\n水取从龙井，花移自马城。\n若将朝市比，忙处却多争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书 其四","author":"张镃","text":"野水因晴自少文，淡云当昼不容昏。\n夹泥船小才通港，洗菜人归定入村。\n布谷飞鸣随燕去，舂锄俛啄得鱼吞。\n春风有得诗如许，妙处从来复细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书 其三","author":"张镃","text":"清晓啁啾响众禽，共忻暄色上穹林。\n巳如料峭春初景，不作萧条岁暮心。\n堆径尚看桐叶在，绕篱那顾菊丛深。\n秦正嘉月将何祝，长寿新芽当酒斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书 其二","author":"张镃","text":"花柳无情浪占春，浴鹅波煖早方熏。\n催耕野旷鸣黄犊，瞰客篱疏立茜裙。\n?睡工夫便日永，得閒滋味苦愁分。\n行行快趁风烟阁，莼鲙诗坛要策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿八尺月色陡明","author":"张镃","text":"将谓无佳月，贪程过上湖。\n才来八尺住，却见一轮孤。\n带露寒于水，和烟白似酥。\n江天空想望，高下两明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿西菩山明智寺诗","author":"张镃","text":"路转溪山果大奇，茂林门径古苔滋。\n坐馀沿石閒听水，茶罢巡檐遍读碑。\n飞白洒然前辈字，养鱼浴却向来池。\n菖蒲葺葺仙人发，随我归来与静宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿治平院长老善忍自绍兴癸酉四月住持余是年三月生","author":"张镃","text":"治平前代寺，幽胜占唐昌。\n我始生弥月，师初踞上方。\n百年虽未半，三纪独偏忙。\n一事尤堪哂，相随两鬓苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈尤侍郎二首 其二","author":"张镃","text":"珍重尤夫子，逢人问死生。\n扫门那惮远，出户直须晴。\n为国鬓先白，因官名更清。\n何时容卜夜，灯畔听文衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈尤侍郎二首 其一","author":"张镃","text":"卧疾暌人事，逾旬只掩扉。\n野情添懒惰，宗伯极瞻依。\n篱落寻黄独，檐楹接翠微。\n健来方数日，诗又不教肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈史太师二首 其二","author":"张镃","text":"自怜冰氏子，父祖已登门。\n屏迹千官外，驰书一品尊。\n华戎心处活，经传语前论。\n欲理西风棹，因瞻祇树园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄呈史太师二首 其一","author":"张镃","text":"昔为金阙相，曾是玉皇师。\n近即维垣拜，还从彭祖期。\n传闻风景胜，多赋洞天诗。\n肯示渔樵否，林间要勒碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题任子严漕使盘园","author":"张镃","text":"身即林园不世功，喜惊今乃有人同。\n规模内相雄文里，景物时贤杂咏中。\n前辈风流何敢似，后来评论想能公。\n谁曾寤寐声形隔，真乐从兹触处通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步池上","author":"张镃","text":"藤杖徐穿竹径凉，地宽那更水云乡。\n山明屋背髻鬟耸，蝉奏树头丝吹长。\n蓑笠钓船家自有，轩裳朝路梦俱忘。\n英雄本志今朝得，十亩香荷著醉狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦觉 其二","author":"张镃","text":"二十年前事，浑如梦觉时。\n漫行荒路径，难认旧亭基。\n尚记因逃暑，曾来学赋诗。\n如今无可好，植杖欲耘耔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦觉 其一","author":"张镃","text":"梦觉西窗晓，听风过曲廊。\n好诗非易辨，閒坐尽无妨。\n人静鸟乌喜，雨来花草香。\n寸心经患难，况复近秋凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清夏堂","author":"张镃","text":"去岁临池未盖堂，暑天来看巳多凉。\n穿花鹭立青为伞，放棹人眠锦作床。\n今夏好风帘影动，良宵閒坐月华香。\n低头笑向阑干说，有汝诗中味更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晖阁在柳洲寺旧址二首 其二","author":"张镃","text":"幽寺知何处，风钟送远撞。\n孤花明几席，阴树惜轩窗。\n唤渡轻舟竞，窥人白鸟双。\n寸心方自适，肯易利荣降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晖阁在柳洲寺旧址二首 其一","author":"张镃","text":"去市无多地，重游净客心。\n何人偏种柳，今日屡鸣禽。\n浩兴生孤桨，归情恋远岑。\n梁间满题咏，宁欠我窥临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒客不值夜梦见之","author":"张镃","text":"澄湖楼畔梵王宫，门外陂塘尽日风。\n来访故人嗟未值，绝怜秋色与谁同。\n不遑将母君应叹，始可言诗我未工。\n须信梦多因境熟，夜深犹在寺门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野芳亭写望","author":"张镃","text":"晚雨凄微叶未斑，小亭非但揖西山。\n船行半出青蒲末，塔立参排杂树间。\n了事儿痴妨剧醉，澹阴天气合清閒。\n幽居不与红尘隔，退食何能一往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野芳亭偶书","author":"张镃","text":"岁岁閒为福，今朝命最通。\n看蒲逢紫燕，弄柳得青虫。\n但愿诗妥帖，何心技拙工。\n山林过轩绂，谁谓只相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"张镃","text":"阖夜惊飙落树巢，平明沟瓦渐迷坳。\n鍪函静听来千骑，圭璧遥知委四郊。\n再白呈祥矜大稔，积阴嘘气遏方苞。\n池边废沼邀閒立，乍合冰澌怯杖敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴希稷次韵再赋为答","author":"张镃","text":"冻蘖归禽易辨巢，烛龙分耀入堂坳。\n长须喜戒锄荒圃，小队閒思猎近郊。\n坐许刚筠全直节，行看弱柳发新苞。\n僧炉遥想煨松柮，犬逐应门认客敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪霁","author":"张镃","text":"山负红铜日，云披绿玉天。\n一晴聊饯腊，三白已迎年。\n贵气楼台满，春声松竹先。\n诗成缘底事，鸟迹印篷船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜杨诚斋赴召","author":"张镃","text":"病中何事却欢欣，闻召高安老使君。\n碧落岂容留绮夏，紫微端要著卿云。\n朝天续集开新咏，解易元谈记古文。\n应笑清臞约斋子，湖边犹恋白鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食","author":"张镃","text":"地僻人稀到，檐虚燕未过。\n清愁诗酒少，寒食雨风多。\n名字因农具，襟怀属钓蓑。\n莫惊时节换，安分看如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食不出遨","author":"张镃","text":"湖南寒食又今年，宿雨连朝洗旧烟。\n竹叶酒边閒凿落，杏梢墙畔出秋千。\n游欢殆类前生事，老态惟思白昼眠。\n明日水边晴更好，只愁归思渺秦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓舍听雨忆园中梅花","author":"张镃","text":"阴霏非是妒春华，薄命诗人带累花。\n烟逼艳低侵竹冷，风拦香横逐溪斜。\n开时数日曾邀客，别后连旬阻到家。\n檐溜可堪声彻晓，梦中馀恨亦无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中杨伯虎见访翌日有诗来因走笔次韵","author":"张镃","text":"领取无多话，频年顿不疏。\n幽寻尘土外，高韵笑谈馀。\n既悟蕉中鹿，宁求木上鱼。\n论诗能避暑，此意复谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾无逸饷风澜十团扇报以七言","author":"张镃","text":"君才霁月破阴分，因物还将比似君。\n水上风云真解悟，目前意到便成文。\n轻涛浡突羊头起，急溜爬髿虎爪分。\n枕重南丰横别派，洗空浮浊几人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游九锁山 其一","author":"张镃","text":"九锁非凡境，烟云路不分。\n山寒长带雨，洞古不收云。\n夜宿听林鹤，晨炊摘野芹。\n黄冠皆好事，添注石炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游大中乾元寺","author":"张镃","text":"突兀前朝寺，维舟又一来。\n殿空金像暗，径断石幢摧。\n物相依成坏，尘缘漫乐哀。\n僧残无悟语，犹幸结宗雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石湖","author":"张镃","text":"几年飞梦越来城，试扣柴荆恰快晴。\n松菊正愁閒客意，烟波真似主人情。\n黑头据要方行志，绿野当年浪得名。\n我亦邻乡植桑柘，访公非为忆莼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游叔祖次对宅南新园诗","author":"张镃","text":"入门疑是洞中天，有此人间事两全。\n深窈高明俱要景，安閒荣盛未衰年。\n轩窗处鹤千层竹，风雨催诗十亩莲。\n闻道从今毕婚嫁，阴功专为子孙传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游俞氏庵次叔祖韵","author":"张镃","text":"青山稳处衲僧家，得趣应难向客誇。\n春砌浪生金凤草，夏窗低映木龙花。\n安禅旧日参临济，照影新游爱水涯。\n酩酊讵论归路晚，壁间贪纵墨翻鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游南山普宁院院中止有数僧别立堂处村仆几百人号师翁道友分执薪水负戴扫除苴补之役暇即乞米赡众溪南二里许名石口闻冬时梅花甚多","author":"张镃","text":"入港晴芜远际山，鹭群翻处绿回环。\n林隈隐寺僧慵出，桥底通船客正閒。\n乍喜身心俱寂静，足怜名相惑愚顽。\n兴阑犹约寒梅发，月下来观侧近湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游昭庆寺","author":"张镃","text":"招提徐步已身轻，礼忏僧忙不出迎。\n侧殿挂灯窥塑像，小廊流水爱经声。\n心安久矣空尘想，梦异当年记宿生。\n目送绕门山更好，肯閒何处不堪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游韩氏园有客先归","author":"张镃","text":"风日催荷作老香，便将新句责胡床。\n重山抱屋临幽爽，四月边湖纳晚凉。\n扇景不惊蛙黾坐，槃飧还爱笋蔬长。\n佳宾壮论能投俗，归路谁怜鬓雪光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游新市赵侍郎园","author":"张镃","text":"步屧沾泥得望新，霁光飞上杂花明。\n渔篷就向池旁入，山翠尽从窗外横。\n因想主人持酒兴，直须居士咏诗声。\n浮生果解随缘足，适意真强爵与名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游臞庵","author":"张镃","text":"入门黄叶拥危桥，竹里山茶刺乱梢。\n钓雪亭修人未坐，浮天阁废鹭应巢。\n百年劳役终奚为，一段风流忍独抛。\n寄语王家早营葺，他时相对我衡茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上呈虞仲房","author":"张镃","text":"谒客冲泥路有声，笋舆风里转高城。\n秋山正要一意看，晓日倍添双目明。\n浅泺鸱盘思腐啄，孤汀鹤立念遐征。\n世间似我诗多有，莫漫逢人道姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖边夜兴","author":"张镃","text":"夜月虽愆约，秋云却荐凉。\n桥明缘水净，树近觉风香。\n众论轻閒适，幽怀贵老狂。\n从今无复病，处处养生方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖南舟中赠日者","author":"张镃","text":"坐上君但笑，人间我最愚。\n百年休较命，今日且航湖。\n地旷山霏薄，风薰水叶粗。\n寸阴方解惜，总是已工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登梅桥望桂隐","author":"张镃","text":"常日居园不自奇，今朝胜处上桥知。\n平湖百亩横当户，茂树千章翠绕篱。\n邻寺钟鱼初历历，里闾鸡犬亦熙熙。\n隔城更有青山在，朝揖吾家出好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"稍负","author":"张镃","text":"稍负园亭约，新篁带可围。\n看山真耐久，临水易忘机。\n野角呼蛇出，轻舟趁鹜归。\n还家欣未晚，池藻弄晴晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道院书壁","author":"张镃","text":"约客探名胜，停辀得所欣。\n山寒多作雨，洞古不收云。\n夜宿听鸣麂，晨斋饤野芹。\n黄冠尤喜事，添注石炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起述兴","author":"张镃","text":"功用今年百倍加，圃中添就好生涯。\n大于桤树夜合树，肥似桃花巴榄花。\n煮酒未尝先问日，裌衣初制渐裁纱。\n起来不是贪眠在，斋后僧怜未瀹茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简马架阁","author":"张镃","text":"江浙闻人马少伊，识公因诵雪窗诗。\n交驰刺字休嫌阻，一见人生自有期。\n城郭村翁谁问我，亲王娇客罕如斯。\n鸡声风雨相望处，情致先多会面时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简陈监仓二首 其二","author":"张镃","text":"因病诗全少，春中忽夏深。\n清幽百亩地，安静六时心。\n树茂晴方好，荷新雨未禁。\n泥乾容后日，閒步酒随斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简陈监仓二首 其一","author":"张镃","text":"自到南湖日，邻翁识长方。\n一官甘寂寞，万事绝思量。\n疏见秖缘懒，频来致不妨。\n松林浑似旧，相伴踞胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简周晞稷","author":"张镃","text":"尘土真堪畏，君髯美亦衰。\n登楼才会面，促坐便论诗。\n社日休持酒，秋香待满枝。\n客涂书旋买，犹似向来痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]