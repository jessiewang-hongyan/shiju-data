[{"title":"真仙岩二首 其二","author":"钱师孟","text":"岩前流水碧潺潺，鹤驭翩翩去复还。\n堪笑世人求不死，岂知得道有无閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日醉中作","author":"徐璹","text":"惊雷殷殷南山曲，一夜山前春雨足。\n美人睡起怯轻寒，衣褪香绡红减玉。\n朝云霭霭弄晴态，野柳狂花无管束。\n东风也自足春情，吹皱两溪烟水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇教院","author":"徐璹","text":"岩僧结栋何勤勤，殿合岧峣势欲奔。\n秋洗江光浮绀瓦，山盘树影入青轩。\n相逢未免同尘眼，何日安禅慰病魂。\n欲借上方留一枕，梦随寒磬过天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"徐璹","text":"满城风物来春色，万里江山入酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孔司封题蓬莱阁","author":"江衍","text":"巍据龙蟠最胜山，神仙琳馆落人间。\n差差万井庭阑布，矗矗群峰屏障环。\n入座湖光浮荡漾，俯檐云影遇斓谝。\n登临自有飘然思，便觉身同白日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘景文登介亭","author":"袁毂","text":"东南富山水，所病在卑溽。\n阴晴变朝暮，梅雨大田足。\n翰苑宴高堂，金斝浮蚁渌。\n诗泠四座耳，醉饱五经腹。\n亭午登介亭，萦纡俯山麓。\n行路愁暍死，是月丁初伏。\n乘高瞰群峰，刚后浪奔逐。\n三吴在指掌，百粤入双目。\n汉忧分朱蟠，尧意注黄屋。\n下舆曾未几，传命甚邮速。\n霸遂伏下风，元白仰高躅。\n倡予而和汝，谈笑唾珠玉。\n所恨继者贫，囊箱无寸幅。\n刘侯世良将，文史三冬读。\n坐啸胡骑却，行歌燕旦哭。\n儒将久寂寥，断弦今日绩。\n所得最在诗，铦利锋莫触。\n唱酬黄卷上，如响答深谷。\n王侯富方丈，熊掌我所欲。\n独馁不得饱，中心但诚服。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"袁毂","text":"本是林泉客，来居山水州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"袁毂","text":"沧浪不须濯，缨上本无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"袁毂","text":"邦人游冶处，尽在月轮中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"袁毂","text":"晓瘴万重烟漠漠，舂台四顾俗熙熙。\n天钟秀气魁文陛，池涌仙源接武夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"袁毂","text":"手掬樵溪尘可濯，恨无雄笔继苏为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"袁毂","text":"营古杳难寻白石，山灵惭未识乌君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"袁毂","text":"笋供四宇庖相继，酒酿多年饮易醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"袁毂","text":"白日青天沛然下，皂盖青旗犹未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁山瀑布","author":"蔡瑗","text":"会稽之南罗浮北，中有大梁神仙宅。\n瀑流今占挂长虹，泻下银河数千尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雉山院","author":"蔡瑗","text":"白雉闻经向此山，转身来伴老僧闲。\n大都见善能开悟，天上人间任往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新建双门奉呈知府郎中","author":"蔡瑗","text":"巍雉云丛十万家，台门新筑更豪华。\n春笼碧瓦浮佳气，日上朱栏夺绛霞。\n众水回环来卫府，千峰朝挹自排衙。\n吾州形胜今如此，文物彬彬正可嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巾山广轩","author":"胡宗哲","text":"昔人亭榭久荒残，今复高轩峙翠峦。\n眺望可周千里景，宴游非止一时欢。\n楼台远近看如画，日月高低转似丸。\n最好使君登览罢，夕阳群骑簇雕鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临海净土院","author":"周弁","text":"一径森森入翠微，翠微深处见禅扉。\n倚云殿阁光相照，蔽日松杉碧四围。\n竹引涧泉寒绕屋，雨蒸山霭润侵衣。\n十年游宦今重到，景物依前旧识稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"王陟臣","text":"出疆直欲请长缨，绝域皆知郑众名。\n拥节初闻归禁闼，怀章非是厌承明。\n淩虚观阁仙鳌晓，倒景湖山鉴水清。\n遥想兰亭多胜集，早传佳句到都城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永明寺四香亭 其一","author":"盛次仲","text":"扰扰红尘为底忙，僧家白日自舒长。\n朱帘著地寂无事，百刻青春一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永明寺四香亭 其二","author":"盛次仲","text":"四围老绿夏阴凉，一枕南风睡思长。\n梦里不知身是蝶，等闲飞入白莲香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永明寺四香亭 其三","author":"盛次仲","text":"霜晴却见湖山好，境静方知日月长。\n陶令醉多难入社，时来采菊饮秋香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永明寺四香亭 其四","author":"盛次仲","text":"趁雪看山坐小床，白云影里玉虹长。\n不知砌下梅花发，只怪开帘有暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东寺松石小轩呈同游关彦长明府","author":"盛次仲","text":"一松偃蹇苍龙蟠，一石巉岩怒虎踞。\n我来题作龙虎轩，便恐风云卷将去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"盛次仲","text":"看来天地不知夜，飞入园林总是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"任贯","text":"一岩冷落高宗雨，满洞清凉吉甫风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题双流保国观古柏","author":"胡宗师","text":"孔明庙前古柏奇，此木气象犹过之。\n干东彷佛烟焰起，铁龙空驾焚一枝。\n真人丹诚何所适，世传乘鹤冲天飞。\n求诗道士心弥坚，试听一诵工曹诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王公觌望日与诸公会于大慈同赏山茶梅花","author":"胡宗师","text":"锦水黄金密印开，东南时望滞盐梅。\n得随剑外同为客，幸逐花前醉倒杯。\n白玉蕊高枝瘦碧，胭脂萼嫩叶低徊。\n绮罗不识清诗骨，须趁春风摸石来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谨次君倚舍人寄题惠山翠麓亭韵","author":"焦千之","text":"余爱兹山昔屡游，回环气象冷清幽。\n茂林滃郁叠苍翠，宴坐潇洒风飕飗。\n密甃积藓迸泉眼，飞翚比翼参云头。\n径边谁开青步障，客来共泛紫玉瓯。\n每思乘兴可独往，尘缨未濯莫我留。\n胜处尽至心未厌，健步历览势挟辀。\n平生趣向与时背，泉石夙志略已酬。\n兹山独以泉品贵，乃得嘉名传九州。\n譬人其中贵有物，源深混混难穷搜。\n支公此去久愈爱，自我佳句忘百忧。\n忽蒙远寄煮岩壑，而我方欲千里求。\n愿公早见疑蛇解，急诏当应易剡舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀峰轩","author":"焦千之","text":"可怜均是山中寺，惟有幽轩对此山。\n云拥秀峰来户外，烟和浓翠入窗间。\n回环似觉天形曲，登眺应疑地势悭。\n他景纵能穷目力，争如疏静养疏闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听松轩","author":"焦千之","text":"山头未吐三更月，枕上惟间万窍风。\n疑是怒涛声不敢，夜深飞雨过寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"砚池","author":"焦千之","text":"萧公事迹久尘泥，独有当年洗砚池。\n世俗所传应彷佛，僧人独得耿颓隳。\n小亭新构藏幽趣，一水中分叠旧基。\n遗泽泯然无处问，清风缅邈竹阴垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文君宅","author":"焦千之","text":"曾是文君宅，幽深镇翠岑。\n涧松迷白鹤，溪石隐黄金。\n丹灶今犹在，箫台尚可寻。\n予来不能厌，谁共听泉音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题兑溪驿","author":"鲍娘","text":"溪驿旧名彡，烟光满翠岚。\n须知今夜好，宿处是江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次蒋颖叔韵","author":"李孝博","text":"维舟亭下号三湾，万叠青山一水间。\n偏爱澄江照天碧，飞来几片白云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别韩魏公","author":"石苍舒","text":"□□□□□□□，帘前二圣拥千官。\n唯有扫门霜鬓客，却随社燕入长安。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"王珫","text":"公住吴门枕太湖，风波不到十年馀。\n过家乞得蓬莱郡，去国初抛丽正庐。\n阙下旧容乘驷马，江头急趁鲙鲈鱼。\n都门送客今何盛，百首诗轻百两车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游西湖","author":"刘庭式","text":"胜地留连久，西湖得再游。\n芰荷围画舫，杨柳护红楼。\n风月苏堤夜，烟云葛岭秋。\n买鲜沽美酒，且莫计觥筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题松下老人图","author":"刘庭式","text":"古松苍髯枝屈缴，失笑相惊在岩穴。\n老翁手持绿玉杖，独立西风双鬓雪。\n修然野服山家容，平生我亦怀高风。\n彭泽归来入图画，真有人间靖节翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倚楹操 其二","author":"王令","text":"亡羊奔奔，岂不有邻。\n子可闭门，亡羊不复。\n去何自逐，身则非牧。\n雾濛濛兮水漰漰，谓兄无行兮兄行。\n不忍一失于邻而忍失厥身，虽然殒子之身兮，其亦如亡羊之邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄任道歌 其二","author":"王令","text":"敖耶学耶，为来往耶。\n衣之荼荼，冠膝膝耶。\n何进趋之舒，不若退走之速耶。\n虽终不吾听兮，犹无贻我嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上词 其二","author":"王令","text":"江之水兮东流，济欲济兮何由。\n水浸浸兮滩露，暮涛下兮夜潦收。\n舟不行兮推之于陆，力不足兮汗颜，行无由兮涂足。\n时不逝兮奈何，归日暮兮涂远，去风高兮水波。\n行踌躇兮伫望，聊逍遥兮永歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上词 其三","author":"王令","text":"江之水兮东流，沿湍流兮望归舟。\n舟来归兮何时，步芳洲兮濯足，陟南山兮采薇。\n江风波兮日暮，望夫人兮未来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上词 其四","author":"王令","text":"江之水兮东流，沿湍流兮望归舟。\n风滔滔兮浪波苦，嗟往者兮未还，惜行人兮将去。\n去何适兮归何时，执子手兮牵子衣。\n行何如兮来复，济岂无兮他时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李定资深 其二","author":"王令","text":"凤虽谓灵畜，无竹或死饥。\n竹今无方无，凤云非其时。\n使之群鸱鸢，饥饱为止飞。\n非惟失所灵，亦与弹射期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李定资深 其三","author":"王令","text":"坦坦谁之田，施施缴且弋。\n乌来玩其机，鹊至喜其食。\n长鸿飞冥冥，志与万里极。\n岂无啄饮心，宁饥不人得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李定资深 其四","author":"王令","text":"湍激日蹙蹙，风棱势漫漫。\n奈何舟上人，试死才一间。\n苟不以利涉，安坐思诚艰。\n客虽惧谋梁，而木嗟在山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗 其一","author":"王令","text":"关雎后之淑，棫朴君之明。\n兔罝尚好德，况乃公与卿。\n所以彼行苇，敦然遂其生。\n谁能弦此歌，为我发古声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗 其二","author":"王令","text":"召公方伯尊，材亦圣人亚。\n农时惮烦民，听讼小棠下。\n嗟今千里长，已耻问耕稼。\n弹琴高堂上，欲以无为化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答友","author":"王令","text":"客尝疑西伯，何至羑里辱。\n瞽鳏虽父子，尚脱井廪酷。\n昏主虽圣臣，飞祸安可卜。\n致命遂其志，虽穷不为戮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不愿渔 其二","author":"王令","text":"采薇南山阿，归耕南山下。\n食苦心无虞，守约自闲暇。\n出处皆有义，在理无用讶。\n今人举一隅，何足语学稼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗效孙莘老 其二","author":"王令","text":"犬羊养于人，壮则人食之。\n猛虎嗜人肉，终昧猎者机。\n豺狼与狗同，为害岂必威。\n封狐能为人，还作行子妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东城","author":"王令","text":"昔予出东城，初见垄上耕。\n忽忽自北至，岁月令人惊。\n虽云一草死，万物尚华荣。\n谁能当此时，叹息微阴生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答弟逢原","author":"王氏","text":"无求子乐我何悲，且与儿曹并日饥。\n子道合人终不苟，有求虽欲可从谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王氏","text":"不缘燕子穿帘幕，春去春来那得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第一青原阶级颂","author":"释义青","text":"无见顶露云攒急，劫外灵枝不带春。\n那边不坐空王殿，争肯耘田向日轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二非但曹溪颂","author":"释义青","text":"白云藏王凤，红日照无寥。\n隐隐星攒处，无私镇九霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三云岩游山颂","author":"释义青","text":"大鹏无伴遇天池，师子将儿绝后随。\n昆崙触犯归行路，一吼吞云万像驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四道吾深深颂","author":"释义青","text":"骊龙海卧瑞云高，四望归宗万派潮。\n木人来问西宫事，回惠东园一颗桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五岩参药山颂","author":"释义青","text":"行尽千山路转高，肯归方忆旧云房。\n贪寻古调单于曲，暨蹉胡家一韵长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六夹山船子颂","author":"释义青","text":"泛舟驾崄三十春，击处竿头活死人。\n夹岭桂分千古韵，朗江山翠万重新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七我国宴然颂","author":"释义青","text":"兴亡云去舆云来，渠无国上绝尘埃。\n须弥顶上无根草，不受春风花自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八僧问石霜颂","author":"释义青","text":"三更月落两山明，古道程遥苔满生。\n金镇摇时无手犯，碧波心月兔常行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九洞山祖意颂","author":"释义青","text":"古源无水月何生，满岸西流一派分。\n葱岭罢询熊耳梦，雪庭休话少林春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十夹山答佛颂","author":"释义青","text":"亲言言处几人知，今古无俦类莫齐。\n玉马雪行归半夜，羚羊挂角月沉西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十一万户俱开颂","author":"释义青","text":"古殿岩开月锁松，霜凝雪露韵无穷。\n星前人卧千峰室，佛祖无因识得侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十二九峰丹青颂","author":"释义青","text":"荆山美玉卞人寻，至宝无瑕绝见因。\n铁牛带子踏沧海，撞月石龟长羽鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十三韶山是非颂","author":"释义青","text":"白云不到中峰顶，满目烟萝景象殊。\n一句曲寒千古调，万重青碧月来初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十四粱山祖意颂","author":"释义青","text":"国令严严拟者危，毫釐才动铁轮随。\n心萌口应三千里，齿露言来苦怨谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十五龙牙乌龟颂","author":"释义青","text":"石龟语话是谁闻，无耳髑髅夜听深。\n天晓便藏无影树，太阳虽照不能寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十六灵云桃花顼","author":"释义青","text":"山前桃发故园春，花绽红枝省此身。\n證据谢君傍著力，笑颜虽展意生瞋。\n烟锁绿杨莺啭缓，雨侵石笋倚空邻。\n金乌放去无消息，木马嘶声过汉秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]