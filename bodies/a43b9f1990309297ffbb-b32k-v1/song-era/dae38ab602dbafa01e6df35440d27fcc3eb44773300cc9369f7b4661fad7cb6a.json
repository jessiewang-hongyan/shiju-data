[{"title":"偈颂一百零二首 其四十二","author":"释绍昙","text":"水洗硬石头，浪打枯杨树，净智庄严功德聚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十二","author":"释绍昙","text":"这一灯，处甚起。\n没踪由，难拟议。\n三贤十圣眼见如盲，芥狗泥猪放光动地。\n大家吹灭暗中行，然灯佛在你脚底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十","author":"释绍昙","text":"一不做，二不休。\n得人一马，还人一牛。\n岂不见临济三遭白棒，大愚肋下三拳痛?，不共戴天雠。\n休休，说著令人满面羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十四","author":"释绍昙","text":"太白峰前施小伎，渊嘿雷霆人自畏。\n瓦砾翻成释梵宫，古佛门风重振起。\n不堕功勋，等闲游戏。\n金毛狮子忽翻身，草木昆虫俱收泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十四","author":"释绍昙","text":"死柴头，无烟火。\n信口一吹，面门烁破。\n可怜龙门远知客礼首座。\n火炉头热血相喷，分争你我，笑倒嵩山破灶堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○一","author":"释绍昙","text":"四十馀年，白云高卧。\n无端刺脑胶盆，日夜烹煎家火。\n庄田淹没，与死为邻，屋舍倾颓，安身难保。\n山僧冷地思量，不觉呵呵大笑。\n定业难逃，何妨笑破。\n赖有东村王老知，绕笆篱唱哩哩啰，何似大石调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十二","author":"释绍昙","text":"地僻云深，秋高境寂。\n堂户凄凉，无人面壁。\n虽然，净地上谁肯狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十一","author":"释绍昙","text":"公灯不照私，渡水不湿脚。\n连累老北堂，此错非常错。\n功回位转，偏正中来。\n凤宿龙巢金殿晓，香车应不碾宸苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十八","author":"释绍昙","text":"乳窦相从几弟兄，忘形骸外又忘情。\n炊香好甑和箩饭，鼠粪无端污却羹。\n邻僧扣齿，诉不平声。\n折箸何妨挑剔去，壁根不到碍人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十","author":"释绍昙","text":"醭醭红尘，炎炎火聚。\n著脚无踪，翻身有路。\n去时山色惨愁容，归来幽鸟啼芳树。\n不涉去来，如何吐露。\n碧眼黄头总不知，问讯粼皴拄杖子，逢人不得错举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十四","author":"释绍昙","text":"坐断白云，万机寝息。\n黄叶止啼，总不消得。\n闲倚危阑看瀑花，纵乾坤眼清无极。\n清无极，自谓太平僧，岂知尧舜力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十一","author":"释绍昙","text":"一口吸西江，赤土涂牛奶。\n荡尽圣凡情，犹欠这一解。\n丹霞马祖，眼见如盲，灵照庞婆，口说如哑。\n蓦劄相逢露一机，惊翻岩瀑苍龙挂。\n虽然斫额望乡关，前头大有路在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十三","author":"释绍昙","text":"父豩顽，子恶毒。\n热血相喷，嗔拳相?。\n如风吹水自成纹，医得耳聋成瞎秃。\n冷地思量，笑不成哭。\n乳峰将底报深冤，捩鼻木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十二","author":"释绍昙","text":"半夜客船钟，渔火愁眠省。\n不见老寒山，泪湿吴云冷。\n幽鸟啼霜月影斜，野桥枫叶翻红锦。\n击碎重关，枯山未泯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十一","author":"释绍昙","text":"寂寞万峰头，佳节成虚度。\n贫无一盏灯，好有多般事。\n洞山姜索价太穹，无缝塔入门辨主。\n厕筹子动地放光，利市官招财满库。\n不作佛法商量，亦非世谛流布。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十八","author":"释绍昙","text":"趁晴盖却屋，捉空种了麦。\n安身立命既无忧，只须体究庭前柏。\n坚守岁寒，青无变色。\n唤作西来直指宗，瞎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十三","author":"释绍昙","text":"箨包角黍，茶点菖蒲。\n香浮毛孔，清透肌肤。\n肱枕藜床心醉月，驱邪何用挂神符。\n汨罗人去远，还有独醒无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十","author":"释绍昙","text":"关雎颂德，樛木垂阴。\n八荒开寿域，万国奉君心。\n亘古今为诸佛母，昙花时现觉园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十九","author":"释绍昙","text":"月下扣朱门，不会推敲句。\n满面是埃尘，低头陪笑语。\n不重己灵，诸圣不慕。\n拍盲入草寻人去，归来羞对白云，倦倚寒岩枯树。\n笑倒粼皴拄杖子，逢人但恁么举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十四","author":"释绍昙","text":"云收麦垄，水足秋田。\n茧缲白雪，莺弄朱弦。\n无象太平还有象，蒉桴土鼓乐尧年。\n谁知声色里，心印是渠传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十五","author":"释绍昙","text":"绿暗红稀，人家翠微。\n杜鹃啼月，紫燕衔泥。\n莫春者，浴乎沂，风乎舞雩，咏而归。\n本是儒家闲戏剧，刚言漏泄祖师机。\n是不是，非不非，老倒乳峰那得知。\n松根憨睡足，闲把瘦藤戏，侍者无事相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十五","author":"释绍昙","text":"达磨眼睛，天台骨髓。\n钩锁连环，提掇不起。\n提得起，湖头春水绿成纹，竹外清风来未已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十一","author":"释绍昙","text":"昨夜唧蟟吞跛鳖，天明屙出一团铁。\n平地翻身触险崖，擘破昆崙成八橛。\n捻土为香供养伊，细问因由不肯说。\n不肯说，太饶舌。\n莫管他人屋上霜，自家扫取门前雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十八","author":"释绍昙","text":"迅瀑千寻，悬崖万仞。\n说法声高，验人机峻。\n要扶法眼门风，花衲元非古锦。\n堪笑高丽四九僧，面门搭了冬瓜印。\n乳窦谤沉无香，是可忍孰不可忍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十六","author":"释绍昙","text":"庾岭春归，溪梅早知。\n雪破寒英，一点半点，月横疏影，三枝两枝。\n未放高楼吹笛，且听茆舍吟诗。\n十分潇洒，一段清奇。\n将谓黄梅消息绝，暗香犹有好风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四","author":"释绍昙","text":"丈夫膝下有黄金，争肯与他人作礼。\n须弥灯王，脚头脚底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六","author":"释绍昙","text":"南山灿灿，白石烂烂。\n觌当面机，瞎人天眼。\n拄杖子，闻如是语，从定而起，向香积世界，乳窦峰前。\n转法轮，抟香饭。\n听之双耳聋，嗅之舌头烂。\n何似杨岐栗棘蓬，秦时?轹钻。\n哑，仁义尽从贫处断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二","author":"释绍昙","text":"鸩鸟毛，乌喙药。\n毒无医，休动著。\n轻动著，尽大地人，皮肤脱落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十七","author":"释绍昙","text":"灵江月，中岩月。\n交影松萝，断猿啼切。\n声色纯真见一边，骑声盖色天然别。\n别别，明觉掀眉，长庚吐舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十四","author":"释绍昙","text":"活马骝，百十个。\n乳窦峰前，追风跳灶。\n杨岐三脚驴，尽力跂步不前；江西千里驹，奋鬣追踪不到。\n更饶伊象头檀特，九十六种，见鞭影而行，蹶蹄不少。\n未奏沙场汗血功，便思嚼啮天闲草。\n好则甚好，明觉老人笑须绝倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十四","author":"释绍昙","text":"水牯牛，偏捩拗。\n酷暑云林，恣情?跳。\n山前祖父田园，忍见离离荒草。\n秋风正要及时耕，脱落鞭绳无鼻窍。\n去住自如，收放在我。\n牧笛声声送暮霞，故家深入千峰杳。\n呜咿呜咿，莫教忘却来时道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十九","author":"释绍昙","text":"图画天开，春风剪裁。\n烂银庭院，白玉楼台。\n将谓乳峰贫彻骨，敌君王富自何来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十一","author":"释绍昙","text":"乾非上，坤非下。\n一画先天，包含八卦。\n推穷爻象，凶吉不分，说尽系辞，疑难未解。\n吉凶分，疑难解。\n阿魏无真，水银无假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十九","author":"释绍昙","text":"柳条弓，蒿枝箭，射中虚空成两片。\n狸奴白牯，雷厉风行。\n碧眼黄头，星飞电卷，拟搆珠林啮镞机。\n险。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十九","author":"释绍昙","text":"虚空包不包，大地坏不坏。\n行脚不遇人，出语无赖聊。\n谩言密室不通风，湿纸如何裹大虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十七","author":"释绍昙","text":"庭院春深，和风翠阴。\n桃花簇锦，柳线摇金。\n无眼灵云徒说悟，一生埋没祖师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十三","author":"释绍昙","text":"积癈未苏，连遭荒旱。\n铁作心肠，也须寸断。\n山僧自小不喜煎熬，幸遇中秋，何妨赏玩。\n皓月流辉，觉天云散。\n倒跨杨岐三脚驴，深村荒草闲行看。\n光境俱忘，瞎乾坤眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十四","author":"释绍昙","text":"天巧剪瑶花，六出缤纷落。\n二祖立腰酸，杨岐嗟项缩。\n争似火炉头柮榾高烧，纸衾包却暖烘烘。\n憨睡著，不堕凝寒一色边，错错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其一○二","author":"释绍昙","text":"寺踞千峰，十方同聚。\n家贼难防，令人惊怖。\n正法明王，怒发冲冠。\n作如是言休惊怖，侬家自有降魔杵。\n粉碎髑髅，裂开肠肚。\n热铁洋铜满满盛，鼻绳牵入泥犁去。\n佛子将谓出家行菩提路，谁知反不如狼虎，累及七代先灵，生身父母。\n号天血泪啼红雨，哑，怨恨凭谁诉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十六","author":"释绍昙","text":"万本青松，后人标榜。\n临济儿孙，当机不让。\n千古清凉树荫人，法门梁栋真堪赏。\n初莫学黄梅道者，贪传破钵盂，连累周家女。\n无地著浑身空惆怅，丛林难免无根谤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十六","author":"释绍昙","text":"乳窦家私，寸无可取。\n分明彻骨贫，刚道薰天富。\n纲宗委地，力要匡扶。\n大厦倾颓，直须撑拄。\n不学老杨岐，破屋雪真珠，缩项暗嗟吁。\n不学大愚芝，脱粟淡黄齑，不吃从君去。\n千圣头边露一机，灵踪不在猿啼处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十五","author":"释绍昙","text":"一二千硕谷，四五百箩粟。\n䆉稏熟天风，高低布云麓。\n辛勤收拾归来，碓捣明玑，钵盛香玉。\n无位真人手扪腹，口唱无生曲。\n花簇簇，听不足，欸乃一声山水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十四","author":"释绍昙","text":"如来禅，祖师意，落叶锦翻空，乱山云积翠。\n见得分明隔万层，道得完全失千里。\n非不非，是不是。\n达磨大师，无当门齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十八","author":"释绍昙","text":"天地不仁，以万物为刍狗。\n圣人不仁，以百姓为刍狗。\n拄杖子不仁，以三世诸佛历代祖师四圣六凡为刍狗。\n化育春阳煦妪前，摧残霜雪凭陵后。\n截鹤续凫，折衡剖斗。\n力尽神疲困壁根，笑破他人口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十五","author":"释绍昙","text":"撮药场中验作家，一枝手髂两条蛇。\n刘寄奴草虽灵验，已是遭它毒口来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十七","author":"释绍昙","text":"二月十五，瞿昙灭度。\n足示双趺，胸摩卐字。\n山愁惨莫云，花泪啼红雨。\n去年一次，今年一次，明年一次。\n辄莫明年更明年百千年，年年一次。\n狼籍涅槃心，此恨凭谁诉。\n赖有粼皴拄杖子，牢记取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十三","author":"释绍昙","text":"史笔书云，绣闺添线。\n爱日舒长，丰年取验。\n衲僧不被四时迁，妙应圆机辘辘转。\n喝散岭上白云，掣断脚跟红线，阴极阳生总不知。\n曝背晴檐，手摘寒梅。\n一点两点三四点，拈花微笑今重见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其一○○","author":"释绍昙","text":"三伏炎蒸，汗流如雨。\n一茎草上建琼楼，彻骨贫穷敌国富。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十","author":"释绍昙","text":"小春才过，冬至相催。\n光阴驹过隙，须鬓雪成堆。\n松根石上，槁木寒灰。\n冻膝拥深霜树叶，禅心清点野桥梅。\n唤起来打，更莫迟回。\n蛰龙须奋跃，何待禹门雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五","author":"释绍昙","text":"妙摄化权，使不辱命。\n鹤唳东皋，云归乳岭。\n拄杖子，黑粼皴，困卧壁根，声前唤醒。\n舞蹈清风两腋生，安闲又入萝窗定。\n宾主历然，头正尾正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十五","author":"释绍昙","text":"复见天地心，举世皆知有。\n山意冲寒欲放梅，岸容待腊将舒柳。\n惟有拄杖子，黑粼皴，元依旧。\n受霜冻不枯，遇阳和不秀。\n壁角落头，块然拙守。\n终日谈玄口不开，喷嚏也成狮子吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其五十二","author":"释绍昙","text":"玉版阿师，锦绷稚子。\n颖脱丛林，头角呈露。\n参透油煎石磉盘，饱经鳌炼翻身去。\n塞断咽喉，更须吞吐。\n毗耶未识香来处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其三十九","author":"释绍昙","text":"春日晴，春雨足，玉龙怒喷悬崖瀑。\n花簇簇，锦簇簇，满山桃李嫌粗俗。\n休捏目，直饶伊向声色堆头。\n密透重尘，坐卧经行，了无拘束。\n砒霜未是毒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十八","author":"释绍昙","text":"蒿篱关猛虎，笔管养苍龙。\n稳帖帖藏牙伏爪，黑漫漫怪雨颠风。\n临济小厮儿惊心欲折，丰干老冻脓睡思方浓。\n山濛濛，水溶溶。\n乾坤无碧落，收放绝行踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十","author":"释绍昙","text":"巴南巴西，水流巴字。\n古篆分明，心画显著。\n游泳江湖四十年，与世同波无彼此。\n朅来千丈岩前路，截流机透险崖句，辨龙蛇眼明今古。\n何侣老赵州，略彴桥头，滴水丈波。\n吃茶去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十一","author":"释绍昙","text":"统御金轮四十春，笃行舜德与尧仁。\n莫言过去无踪踪，卢舍时时现本身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其十一","author":"释绍昙","text":"八月秋，何处热，尽大地，一团铁。\n衲僧家向南北东西，草鞋跟踏得裂，拄杖头挑得折。\n蓦劄相逢，德山棒，临济喝，百怪千妖，如何计结。\n恶，邪法难扶，莫说莫说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其二十二","author":"释绍昙","text":"统御金轮四十年，拱垂衣化育黎元。\n万机休罢升遐去，四海无思不断魂。\n林间衲子，感戴深恩。\n合掌迎归兜率院，当来成佛补慈尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其八十六","author":"释绍昙","text":"瞿昙丑恶，临死犹多。\n足下轮辐显露，胸前卐字揩磨。\n抱桥澡洗，寄帽投河。\n举世无人援手得，竟随残梦入无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十四","author":"释绍昙","text":"共住不知名，千圣亦不识，无端平地生荆棘。\n兄呼弟应，与世同波，笑独醒人死汨罗。\n恁么也好，不恁么也好。\n手拍阑干唱竹枝，哩哩啰，天涯望远无人到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其七十二","author":"释绍昙","text":"吴江风急浪翻空，声击枫林半夜钟。\n惊起客船尘梦破，踏翻大地去无踪。\n寒山抚掌，庞老槌胸。\n少室门庭空寂寂，凝寒古路绿苔封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其四十七","author":"释绍昙","text":"仙苑蟠桃不老春，三千年实荐芳新。\n锡开王母瑶池宴，满簇金盘寿圣人。\n虽云绝品，未足为珍。\n幸有菩提真妙果，年年同献佛生辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其九十","author":"释绍昙","text":"落赖门风，大家撑拄。\n量田底量田，种树底种树。\n带雨扶犁绿野耕，和云荷钁千峰去。\n有甚心情，管得南泉猫儿，赵州狗子，勘證平田婆，连累周家女。\n棘林中有通天路，饱饭狂歌，閒行几步，脚头山色无重数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]