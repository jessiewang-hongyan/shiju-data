[{"title":"登彼公堂燕贡士 其二","author":"陈襄","text":"登彼公堂，有松有柏。\n君子燕湑，其仪孔特。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登彼公堂燕贡士 其一","author":"陈襄","text":"登彼公堂，维水汤汤。\n君子燕湑，其言有章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楼上曲","author":"陈襄","text":"金徒抱箭寒更起，寂寞孤城一千里。\n姮娥擎出月华来，白玉楼台瑩如水。\n上有佳人红粉妆，妙年学得吹霓裳。\n呼儿将出紫玉笛，一声天外流宫商。\n清商欲尽何幽咽，曲调不成声断绝。\n罗衣掩泪愁向天，手把瑶华歌一阕。\n寒蟾出兮明星稀，良人阻兮天一涯。\n凭轩遥望兮心伤悲，愿随鸿鹄兮高飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈襄","text":"西风斜日鲈鱼香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行","author":"陈璧","text":"江阔天低，楼高思迥。\n春烟蘸淡如秋景。\n今年芳草去年愁，分明又报明年信。\n燕子还来，归期未定。\n可堪醉梦红尘境。\n世间万事尽消磨，水流不尽青山影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈璹","text":"活计鱼虾蟹，此事属渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题朝阳岩","author":"陈瞻","text":"岩面郡楼前，岩崖瀑布悬。\n晓光分海日，碧影转江天。\n向暖盘栖鹤，迎寒簇钓船。\n次山题红处，千古与人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九峰过重阳 其二","author":"陈藻","text":"登高却是今最高，九峰寺上诵庄骚。\n茶话恰宜汤饼素，满身风痒怕村醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九峰过重阳 其一","author":"陈藻","text":"算来七十五重阳，无酒今朝对菊黄。\n记得苏杭船上坐，一番醒眼咏诗章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九峰僧房看山","author":"陈藻","text":"寺前寺后木弯环，殿里庄严佛一般。\n衲子开窗还礼拜，生株何用巧彫残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月一日毗陵作","author":"陈藻","text":"听得常州多菜色，到来市井亦安然。\n今朝正值焦糟节，车马翩翩上墓田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三教","author":"陈藻","text":"枉费工夫是学仙，圣门妙处与僧传。\n百年合死千年赘，一物都无万物全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上东山坟寄敬之弟","author":"陈藻","text":"东山零落古三丘，力薄那能抑得周。\n赖有阿连沾寸禄，我惭到老一来休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与宗上人同饮","author":"陈藻","text":"同年同月又同时，邂逅僧房把酒卮。\n五十年来未相识，邻州两舍贺生儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久不到黄石故人相见多喜余红颜吴世执友喻之霜柿谓其熟而将坠也","author":"陈藻","text":"年将四十客莆阳，丱角相看笑语长。\n今日生男行冠礼，老如霜柿又逢场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久为尘事关怀因成一绝","author":"陈藻","text":"读书得趣是神仙，未若神仙断火烟。\n解把老夫埋俗窟，多时不放上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"口占寄林子六","author":"陈藻","text":"日月相催不放迟，寄诗又是去年时。\n近来未省开怀否，还似从前尚皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"土风","author":"陈藻","text":"钱塘直出过长洲，质直都无俗太浮。\n路入馀杭昌化境，土风淳朴似闽瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小除过卢子俞作","author":"陈藻","text":"今夜人间是小除，归途迂曲访君居。\n村深事简携杯外，閒把诗篇细卷舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中有感","author":"陈藻","text":"每看风月非人世，错认江山是画图。\n谁解吟诗追李杜，何须涉海访蓬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山泉","author":"陈藻","text":"山山迸出细泉流，更泻高峰瀑布幽。\n尽入大溪滩石里，古今翻覆几人舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中元连宿竹园刘叔嘉宅","author":"陈藻","text":"朝朝风雨过中元，已熟之禾未易存。\n正是忙时人却暇，且偷佳节倒芳尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋","author":"陈藻","text":"诗书读罢问耕牛，待得时来死便休。\n一带空村无润屋，聊因社肉作中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书子诲所寄诗后","author":"陈藻","text":"摇膝支颐体渐康，入门已作白家香。\n从今休傍官人俗，但向林泉呼二郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕同社众携灯上山谒神祠","author":"陈藻","text":"城中箫鼓闹鳌山，灯火千村别一般。\n今夕崔嵬行乐处，向时模仿仰头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日平江作","author":"陈藻","text":"草粿京团要贺年，玉融风俗不同天。\n元正卯醉长洲市，又忆浮家厌海鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月望夜纪饮","author":"陈藻","text":"年老聊依年少游，月圆庭上似中秋。\n举杯问月争多少，一度犹行甲子周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆母","author":"陈藻","text":"萧小八娘弃我去，我生方始十三年。\n如今七十零单五，生死途分竟杳然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中夏夜即事","author":"陈藻","text":"上缀珠玑为屋盖，旁堆翡翠作屏风。\n醉翁不见身贫贱，卧向凉飙清露中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丘叔乔七十生朝二首 其二","author":"陈藻","text":"大儿别有论文眼，朴实无他是次丁。\n长女嫁夫能俭约，小娘骂婿见财轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丘叔乔七十生朝二首 其一","author":"陈藻","text":"人生七十为稀有，强健如公有几人。\n况是上元灯火夜，儿孙楚楚贺生辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23425,"sha256":"8