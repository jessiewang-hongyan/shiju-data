[{"title":"送赵君十绝 其六","author":"汪莘","text":"一榼村醪插别筵，清风急雨送归船。\n望中未是湖州境，便有吴歌唱采莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳赵使君惠酒","author":"汪莘","text":"何尝自觅王弘酒，颇怪曾麾道济粱。\n处士固应高一着，江州太守味尤长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除日寄黟山周尊师","author":"汪莘","text":"眼有神光射霭山，不须更问列仙班。\n道人四海都游遍，只有先生一介闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其十","author":"汪莘","text":"藕蒂嚼来殊解渴，荷香闻得亦忘饥。\n幽人不趁槐花课，收得西湖几句诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其九","author":"汪莘","text":"醉把青荷当箬笠，乱披红芰作蓑衣。\n渔翁家在蓬瀛上，欲驾莲舟一叶归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其八","author":"汪莘","text":"清夜湖心把酒杯，花间风月共徘徊。\n金钟何事催天晓，又恐游人相逐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其七","author":"汪莘","text":"露冷风清斗柄迁，芙蕖零落谢家船。\n都人正作黄粱梦，独占西湖明月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其六","author":"汪莘","text":"一曲波光彻太虚，四垂碧汉罩湖鱼。\n游人眼被荷花碍，不觉琉璃泡里居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其五","author":"汪莘","text":"修竹祠堂曲水滨，寒泉菊盏久埃尘。\n道傍车马无心到，似我频来有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其四","author":"汪莘","text":"晚风吹动碧琳寒，初日花房露未乾。\n谁道幽人无伴侣，红蕖万朵竹千竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其三","author":"汪莘","text":"每叹西湖境未殊，向来人物有还无。\n红蕖绿竹浑相得，明月清风亦不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其二","author":"汪莘","text":"急管繁弦樽俎閒，何人静眼对湖山。\n怪来水面无鸥鹭，多在残蒲落照湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日西湖闲居十首 其一","author":"汪莘","text":"十里湖山苦见招，柳堤荷荡赤栏桥。\n待他朝市人归后，独泛扁舟吹玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真直院招饮道山群玉堂自陈秘监而下凡八人坐上赋绝句","author":"汪莘","text":"压架春风十万条，护檐霜干自萧萧。\n一朝尽识群贤面，陡觉星辰共碧霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途中再咏金陵","author":"汪莘","text":"石头城上望斜晖，览尽金陵寂寞归。\n叹息青天如许大，可无一个凤凰飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题","author":"汪莘","text":"浮云散尽月孤明，月里仙人影更清。\n忆昔相逢不相识，如今同坐复同行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴即事","author":"汪莘","text":"君平帘外雨霏霏，寂寞何人识少微。\n怪得湖边天色好，小舟争载夕阳归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿阴","author":"汪莘","text":"绿阴窗底蔚蓝光，习习清风入座凉。\n五月人间同此意，故知彭泽到羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒真直院杨花满路口占一绝见直院诵之","author":"汪莘","text":"三月天寒尚腊衣，钱塘游子叹斜晖。\n柳间苏小无由见，惹得杨花满袖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食节有感 其二","author":"汪莘","text":"寒食原头杜宇声，谁家不起古今情。\n纸钱烧罢人归后，一树梨花冻月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食节有感 其一","author":"汪莘","text":"江南儿女尚多情，为爱芳晨载酒行。\n幸自不知惆怅事，鸟啼花落是清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓清湖桥夜枕闻雨","author":"汪莘","text":"要识人间过去愁，春宵风雨到湖楼。\n如今此恨无分处，应有知人在后头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游南山","author":"汪莘","text":"山蹊黄叶从过满，石案苍苔不用除。\n坛上古松岩畔竹，切须留伴老僧居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上早秋偶兴","author":"汪莘","text":"坐卧芙蓉花上头，清香长绕饭中浮。\n金风玉露玻璃月，并作诗人富贵秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"程朝望送梅花","author":"汪莘","text":"昨夜灯前把酒杯，鄱阳主簿送春来。\n只疑天地无清气，都在江头一树梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊日晚过杨村写望","author":"汪莘","text":"万里溪光一望穿，潜鱼世界白鸥天。\n若为移得溪光去，落日茅斋相对眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感白发","author":"汪莘","text":"一枕黄粱梦欲残，死生大海浪漫漫。\n鬓边白发休除却，时向窗前把镜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感秋","author":"汪莘","text":"年年不是要悲秋，秋气愁人不自由。\n谁见江南魂断处，潇湘帝子在眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春二十八夜枕上有怀 其一","author":"汪莘","text":"迩来尤觉光阴速，昼夜分明似水流。\n却是光阴无变动，谩教浮世有春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春二十八夜枕上有怀 其二","author":"汪莘","text":"茅檐环走两金轮，二十九番杨柳春。\n回首半生无觅处，祗应留得见前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潘别驾自祁门回","author":"汪莘","text":"白马嘶风入紫阳，使君一笑列壶觞。\n秋原是处堪图画，豆子花红稻半黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"篱阴","author":"汪莘","text":"篱阴双蝶趁春晖，轻展新黄试舞衣。\n点草扑花如得意，因何相逐背人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月 其五","author":"汪莘","text":"诗人长以月为心，对月题诗随浅深。\n缺此作钩圆作鉴，白将如玉紫如金。\n鍊丹道士绵绵守，见性禅师了了吟。\n今夜谁家杀风景，聒天鼓吹到横参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月 其四","author":"汪莘","text":"吟诗竞尽月精微，自昔谁明造化机。\n近作金波千道去，远成玉鉴一团飞。\n阳魂满处因乾父，阴魄亏时自巽妃。\n笠泽渔舟都不问，醉中倒着绿蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月 其三","author":"汪莘","text":"万派寒芒一道飞，阴精盛处远成围。\n抱回红日浴东井，横截碧天朝太微。\n惟有中秋金正王，复当子夜水生肥。\n溶溶满掬乾坤髓，说向傍人是泄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月 其二","author":"汪莘","text":"对月题诗过几人，不知何句与渠亲。\n精神尤向水中活，形状直须天上真。\n紫磨一轮开作屋，桂花千朵斫为薪。\n寒儒老矣心犹在，诚念唐虞有野臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月 其一","author":"汪莘","text":"今宵何处惬清游，震泽波心太华头。\n初出海张红锦扇，到中天挂水晶毬。\n兔蟾迸作双轮现，金火镕成一鉴秋。\n惟有飞仙知表里，入他宫殿又焉廋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其三","author":"汪莘","text":"群处那相合，单栖正自如。\n好言天外事，懒读世间书。\n指直笔难把，唇濡砚屡嘘。\n倾壶有馀沥，窥瓮得残菹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其一","author":"汪莘","text":"出郭已超俗，住溪尤近真。\n青天素知我，白雪便随人。\n守道何妨贱，藏书不尽贫。\n长怀社中友，共发瓮头春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其二","author":"汪莘","text":"世事偏宜假，吾生只认真。\n少知行路恶，老爱在家贫。\n宁接古时鬼，怕逢今世人。\n涧松方卧雪，野草亦争春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其五","author":"汪莘","text":"彻骨寒谁觉，回骸暖自醒。\n直须人悄悄，方得物亭亭。\n性伏涵三极，心开烛万灵。\n有僧肥臃肿，怪我瘦竛竮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其四","author":"汪莘","text":"每恨投南鹊，尤怜向北枝。\n虽蒙今士笑，恐有后人思。\n运火解朝冻，咽津充夜饥。\n不来溪上住，那得雪中诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其六","author":"汪莘","text":"脱命市朝隘，侧身桑梓深。\n山含首阳色，水带汨罗音。\n中夜不能寐，万端都上心。\n邻鸡犹未动，沙鸟已相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其七","author":"汪莘","text":"茅屋冻将压，柴扉寒不开。\n交朋几竿竹，兄弟数枝梅。\n渡口月初出，沙头人正回。\n客居殊自在，岁事亦相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其十","author":"汪莘","text":"筑室深山里，开门古涧边。\n月高猿子叫，日晏虎儿眠。\n带雪挑黄菜，敲冰取碧泉。\n不知居士乐，空受俗人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其八","author":"汪莘","text":"朱减颜逾皱，霜添鬓却新。\n文章应舍我，富贵不如人。\n照破生前物，思穷死后神。\n谓宜休仕汉，何必只逃秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开禧元年四月自中都挈家还乡寓居城南十二月迁居柳溪上其夜大雪初一日盖宰来访约过县斋为一日款深夜而归赋此 其九","author":"汪莘","text":"积雪滴还冻，斜阳阴复明。\n千峰浓淡碧，一水浅深清。\n医卜犹真禄，樵渔亦美名。\n人皆云有命，我独得无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其八","author":"汪莘","text":"百岁已过半，只身谁与偕。\n得因徵悟道，失在太开怀。\n且托山花宿，时从水竹斋。\n神回天上活，骨付月中埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其二","author":"汪莘","text":"三万六千刻，四千三百时。\n不思人事汩，只怪岁华驰。\n拚命尝因道，忘家亦为诗。\n幽怀聊自遣，俗子莫令知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其五","author":"汪莘","text":"白昼常陪俗，清宵得养魂。\n几时成草屋，终日掩柴门。\n事迫文方出，身闲道始尊。\n世方怀祖逖，吾已吊刘琨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其四","author":"汪莘","text":"事体向晚境，情怀非少年。\n平生不得地，至死亦由天。\n坐背暑弥胜，行膺寒愈坚。\n愿言过去苦，莫与后来贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其六","author":"汪莘","text":"无象始无假，有形斯有邪。\n盈虚怜日月，聚散笑烟霞。\n一性亦无我，五行何况他。\n谁能离火宅，吾与上牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其十","author":"汪莘","text":"谁和阳春曲，仍操白雪音。\n郊寒犹有骨，岛瘦未无心。\n云到散时看，月当亏处寻。\n可怜持玉尺，终不度金针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其七","author":"汪莘","text":"残腊天垂老，新春日始孩。\n玄君归浑沌，青帝出胚胎。\n楼上独倚处，海边相见来。\n闲思栽五柳，怒欲拔三槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其三","author":"汪莘","text":"生死何时了，盈虚祇足伤。\n谁能一刻静，大胜百年忙。\n反己求中帝，逢时说外王。\n纷纷徒藉藉，踽踽亦凉凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其九","author":"汪莘","text":"兴发花开处，情生叶落边。\n既为欣厌惑，未脱死生缠。\n凿破心中月，冲开顶上天。\n俗儒应大笑，古佛不曾传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其一","author":"汪莘","text":"性静无一物，心生有万端。\n曾将魂魄鍊，不被鬼神瞒。\n纵步地虽窄，仰头天自宽。\n裁诗偏得偶，遇卦只成单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶自咏 其十一","author":"汪莘","text":"直写胸中事，谁拈纸上尘。\n兴来那暇懒，得处不容廑。\n行有鬼神觑，诗防天地嗔。\n欧苏寻后辈，郊岛是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉堂中赓任宫讲希夷惠诗韵","author":"汪莘","text":"宫讲先生句子香，晦庵衣钵有馀芳。\n松篁性本参天直，杨柳情仍庇地长。\n自恨此身真逆旅，不知何日更传觞。\n山人初向山中出，还欲归来水一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访杨湖州 其一","author":"汪莘","text":"一道西江隔水云，夜瞻牛斗共天文。\n圣之清必先夫子，仁者勇须今使君。\n天下山川居一半，湖州风月占三分。\n锦囊幸许传抄去，预取兰香手自薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿何尚书","author":"汪莘","text":"雪艇风帆去玉京，故家猿鹤相欢迎。\n九天气母壶中足，十月婴儿顶上行。\n曾问何修能至此，但云无欲自然成。\n夜来梦向山庄立，一炷清香彻太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿高内翰 其一","author":"汪莘","text":"胸次包天烛九垓，正须博大济时材。\n朝从碧落抟风角，暮泛灵槎出斗魁。\n别墅已将修竹隐，朱门仍向镜湖开。\n如今且为苍生起，一取前贤气燄回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿高内翰 其三","author":"汪莘","text":"鹤立青松老令威，佳辰山水倍清辉。\n曾扶东壁排云出，几跨苍龙带雨飞。\n竹簟水风须得意，玉堂春日即催归。\n愿公与国为梁栋，千载煌煌照太微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿高内翰 其二","author":"汪莘","text":"璞玉浑金表里同，心知言动有阴功。\n一门人杰成龙种，三世科名各继宫。\n华盖共瞻天座北，勾陈长扈帝垣中。\n野人只待秋风起，去向西湖作钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿高秘书","author":"汪莘","text":"万壑千岩映翠霞，越王城下竞传誇。\n青天白日秘书舫，乳燕鸣鸠内相家。\n高浪趣潮沧海直，大鹏横击五云斜。\n自吹玉笛相为寿，昨夜菖蒲吐紫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜兴","author":"汪莘","text":"倚天长剑为谁收，欲献君王镇九州。\n世事漫随红日下，壮心空逐碧江流。\n雁横西塞偏愁客，菊绽东篱始当秋。\n抖擞向来尘土梦，便提蓑笠上渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄潘倅","author":"汪莘","text":"梦魂何事练溪滨，起自新春向晚春。\n红杏园林催百舌，绿杨洲渚荐重唇。\n一年好处是寒食，三月水边多丽人。\n遥想使君行乐处，牡丹如障草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游甘露寺","author":"汪莘","text":"扁舟京口意踌躇，北固峰头泪满裾。\n闻道昔时兵可用，未知今日事何如。\n伤心南渡英雄尽，屈指中原岁月疏。\n待见太平心始足，不妨归去老樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又叙谢","author":"汪莘","text":"竹翁恶俗客，屡举却尘翁。\n云何一见我，捉手形深眷。\n坐呼兰溪酒，即取太白劝。\n阶前抱关卒，为我颜色变。\n解榻经两眠，天寒恐冰霰。\n主意厚且真，惜别如挽牵。\n握手紫竹杖，眩转含飞电。\n端作临水送，沙溪清练练。\n还家甫席暖，书到惊一县。\n特遣赠行诗，水剪梨花片。\n且约二三子，同煮竹洲面。\n岂意古人事，乃复今日见。\n理发叙心曲，所属加餐饭。\n无事觉昼长，明窗试笔砚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]