[{"title":"六桥闲步 其一","author":"薛师传","text":"出郭青岑近，临流白鸟飞。\n笙歌春雨歇，草树夕阳微。\n山色邀藜杖，湖风飐葛衣。\n虚亭林处士，不见鹤来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六桥闲步 其二","author":"薛师传","text":"向晚西湖路，烟霞淡水汀。\n垂杨拂波绿，芳草幔堤青。\n地僻渔樵聚，山深殿阁扃。\n平生卜投老，梦寐有南屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上别友人","author":"薛师传","text":"秋江涓涓帆乱飞，秋山皎皎含斜晖。\n君趁江流去已远，立对青山不忍归。\n知君不惜南来信，只恐衡阳雁足稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬答张安抚伯玉先生","author":"薛师点","text":"寡交率天性，积疴攻妙药。\n干禄念烝尝，著书恣谈谑。\n永矢离畏途，何况縻好爵。\n感子故人意，屏吏延铃阁。\n时剖千秋心，兼订三山约。\n风流张平子，文采谢康乐。\n潜鱼媚幽潭，高鸟昵林薄。\n物类既参差，天地亦寥廓。\n但愁霜霰多，石出兼水落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其八","author":"薛师董","text":"散尽浮军换铁缗，香烟何处不氤氲。\n苏郎非是谀人者，今日真成说古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其七","author":"薛师董","text":"尊嘉堂上崔嵬老，制阃新开欲辟吾。\n又约来游游不得，风流输与五云苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其六","author":"薛师董","text":"定林草木也风骚，曾睡山中听桔槔。\n春雨江湖八年事，空肠只忆吃丝糕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其五","author":"薛师董","text":"扫阶杨柳败荷风，春晚秋初下观中。\n两度不能吟一句，愧君且说事匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其四","author":"薛师董","text":"交朋存没八篇诗，自恨论心独觉迟。\n也记涌金门外别，不蒙登赏忽相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其三","author":"薛师董","text":"方泉周四半生痴，语辄惊人不自奇。\n渠句却题君集后，要寻梨木共传之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其二","author":"薛师董","text":"刘郎之后更苏郎，不枉随人入建康。\n秦水钟山几相识，前年忽识好文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金陵杂兴诗后八首 其一","author":"薛师董","text":"舒王不让杜樊川，二十八字今断弦。\n可怪苏郎呈好手，剪花排锦蒋山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后秋风","author":"薛师董","text":"去年病后咏秋风，今日秋风病里逢。\n好句不曾书落叶，孤灯长自守鸣蛩。\n故人音问天来远，茅舍光阴睡正浓。\n江上白鸥忙胜我，衔鱼引子与潮冲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋风","author":"薛师董","text":"秋风有落枝，天籁动埙篪。\n鼓角山河壮，襟怀岁月迟。\n阮生狂一啸，汉武老多悲。\n虽有秦歌激，终堪理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬外湖楼诗","author":"薛师董","text":"小雨润蔬荚，凉风展梧影。\n云连沙际白，天开数峰净。\n湖楼百尺高，坐觉秋日永。\n宽锄十亩园，馀事一笑领。\n荷枯水却清，桂晚霜未冷。\n谁能悲寒螀，聊忻小蛙黾。\n饱客新豆菹，驾我双舴艋。\n放浪诚有道，居然惜俄顷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过王处士竹庄","author":"薛师鲁","text":"临流结屋植琅玕，中有高人咏考槃。\n一曲秋烟青欲滴，满林春雨翠堪看。\n山僧过乞归云杖，渔父来分钓月竿。\n千古王猷惟此癖，但知此外别无欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦雪","author":"薛师鲁","text":"六出夫何甚，经旬散野堂。\n喜心翻作厌，瑞物恐为殃。\n岁晚思新火，天寒望太阳。\n荒村风雪里，赖有隔年粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扬州送别","author":"薛廷玉","text":"匹马扬州路，香开几树花。\n春光无拣择，淮地亦繁华。\n日沸长江水，风昏古战沙。\n争雄旧时事，君去莫思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其七","author":"薛式","text":"此道至灵至圣，无令泄漏轻为。\n全凭德行两相宜。\n言语须防避忌。\n要籍五行生旺，须明阳盛阴衰。\n三人同志谨防危。\n进火工夫仔细。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其四","author":"薛式","text":"内有五行相制，包含一粒红铅。\n相生相杀自天然。\n此药殊无贵贱。\n会向我家园里，栽培一亩天田。\n中男小女共相连。\n种得黄芽满院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其八","author":"薛式","text":"炼就光明莹玉，回来却入黄泉。\n升腾须假至三年。\n携养殷勤眷恋。\n九九才终变化，神功岂假言宣。\n分明顷刻做神仙。\n永驾鸾车凤辇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其五","author":"薛式","text":"凿破玄元三五，拨开造化圭璋。\n希夷妙旨在中央。\n咫尺无名罔象。\n片饷工夫便得，教君地久天长。\n蓬莱仙岛是吾乡。\n怎不留心信向。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其六","author":"薛式","text":"竹破须还竹补，人衰须假铅全。\n思量只是眼睛前。\n自是时人不见。\n日月相交离坎，龙蛇产在先天。\n长生妙药在家园。\n一饷工夫便现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其一","author":"薛式","text":"一是金丹总数，河图象出真机。\n谁知罔象尽玄微。\n大道从兹孕起。\n斗柄璇玑正位，阴中却抱阳辉。\n昆崙子母著绯衣。\n此是乾坤真理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其二","author":"薛式","text":"偃月炉中金鼎，三台两曜形神。\n尊卑简易汞中真。\n握固休推心肾。\n白虎长存坎户，青龙却与南邻。\n阴魂阳魄似窗尘。\n大意不离玄牝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其九","author":"薛式","text":"一气初回遇朔，鼎中神水温温。\n刚柔相会气均匀。\n妙在无过浑沌。\n八卦循回循绕，推排九窍追奔。\n东西沈静合朝昏。\n莫与常人议论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 其三","author":"薛式","text":"天上三清真境，三皇五帝规模。\n瞿昙老氏仲尼徒。\n经史深藏妙素。\n间有真人出世，来明赤子玄珠。\n蟾光终日耀昏衢。\n满目黄芽显露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊居写志","author":"薛扬祖","text":"过庭闻曲礼，在野习王风。\n世乱思休否，儿愚藉发蒙。\n云霞海色里，烟火雨声中。\n所喜田间事，比邻自昔同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送表弟朱拙夫以县尉赴新安","author":"薛扬祖","text":"散金结客不求偿，落落生平此热肠。\n七尺许君何慷慨，一朝用世果循良。\n满城山色侵官舍，遍地溪声度女墙。\n邑长若逢潘岳辈，肯教名独起河阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与张枢密话旧作","author":"薛扬祖","text":"羸躯苦善病，日与药裹亲。\n藉彼参苓功，扶此忧患身。\n思君若饥渴，相怜同病人。\n余身本蒲柳，宁俟秋风晨。\n君诚松柏姿，何患不长春。\n容面一若丹，鬓发一若银。\n来日安可期，往事曷足陈。\n不能罄君罍，奚以浣我尘。\n吹笙将鼓瑟，惭余非嘉宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其七","author":"薛抗","text":"焚香坐清昼，此心自如如。\n我知拙催科，考甘下下书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其五","author":"薛抗","text":"我无割鸡刀，乃当万家县。\n飞蝗不入境，感谢年谷贱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其八","author":"薛抗","text":"桐乡文章伯，我欲执鞭从。\n明堂选擎天，云壑卧老松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其二","author":"薛抗","text":"斗牛不能神，枭卢无好采。\n碌碌甘抱关，谁能媚时宰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其一","author":"薛抗","text":"春花弄晴风，昼帘垂永日。\n公退卧黄紬，放衙头懒出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其六","author":"薛抗","text":"五斗虽甚微，偃鼠饮满腹。\n大书归来赋，有味数过读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其十","author":"薛抗","text":"援琴鼓流水，弦绝无知音。\n为语逐臭夫，兰芷生深林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其三","author":"薛抗","text":"二亭岿然立，紫薇为题颜。\n朝晖射银钩，伟观压海山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其四","author":"薛抗","text":"讼牒如蜂房，未易谈笑理。\n却思买扁舟，归钓荆溪水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃十绝和朱待制 其九","author":"薛抗","text":"寿亲发斑斑，綵服老莱戏。\n欲赋招隐诗，小山念松桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题观政堂","author":"薛极","text":"野水瀰茫春更多，文昌观政意如何。\n了无惭色清相照，试听当年襦裤歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"薛纯","text":"郡阁讼稀秋正爽，伫携书剑一相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴公仲庶游海云寺","author":"薛繗","text":"寺占灵峰更近州，喧阗驺从锦缠头。\n歌钟乍奏晴雷殷，戈甲急趋春水流。\n几处醉眠方枕籍，一城谣俗重嬉游。\n贤侯惠意民知否，几刻严闉为尔留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"它山堰","author":"薛叔振","text":"官为唐令尹，心切禹蒸民。\n叠石流川水，分波及稼云。\n万涛惊不夜，千古见如新。\n更有朝宗脉，声容匪独鄞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题楼观","author":"薛周","text":"结草终南下，云萝一径深。\n人穷文始迹，谁到伯阳心。\n古木含天理，清风快客襟。\n劳车行计促，空愧负长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种兰","author":"薛季宣","text":"兰生林樾间，清芬倍幽远。\n野人坐官曹，兹意极不浅。\n西窗蔽斜日，松钗架春晚。\n墙阴莳花木，憔悴根日损。\n植此山谷香，坐与前事反。\n扶疏可纫佩，心绪端有本。\n芽生仅盈坛，高风成九畹。\n群芳颜色好，祇自誇园苑。\n何如淡嚼蜡，草莽曾谁混。\n对我静无言，忘形如苯䔿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老妓自称汴京宫人泣而赠之","author":"黄介","text":"薄妆自叙老深宫，一曲悲歌听不终。\n黑发尚沾梁苑雪，素衣还带上林风。\n残春柳叶萧条绿，破国桃花冷落红。\n收拾琵琶蹙眉黛，教人同在泪痕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇太后挽歌","author":"黄介","text":"夹日光先业，寒星聚夜台。\n慈名千古重，哀诏九天来。\n地底鸡人少，云中鹤使催。\n宫门芳草遍，从此不须开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日看云","author":"黄介","text":"晓雨沾山路，秋云看野亭。\n薄从川上起，低向屋边停。\n合处山林白，消来天地青。\n人生无定迹，不止是浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故旧相送出城门","author":"黄介","text":"策马国门南，行役感时节。\n唧唧寒螀乱，皎皎层峦洁。\n脩途遵广川，衰林夕阳灭。\n含情不忍语，眷旧讵忍别。\n抱疴谢绂冕，寄情恋岩穴。\n树临越海潮，山背吴门雪。\n各勉畴昔心，音书戒辽绝。\n傥讯幽栖子，杜关理丹诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太清轩","author":"薛昂","text":"雨馀山色千螺翠，风定湖光一鉴明。\n我是水晶宫里客，暂来犹爱此轩清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题万竹山","author":"薛昂","text":"万竹山中数十家，重重流水绕桑麻。\n饱餐鼓腹成何事，桃李春来任自花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题回山人画像","author":"薛昂","text":"道骨仙风一伟人，相逢东老最情亲。\n榴皮幻化人间世，藤叶牢笼物外身。\n璚蚁满壶方丈晓，青蛇衔袖洞庭春。\n高名不朽垂千古，笑指西邻几劫尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖堂","author":"薛昂","text":"一段风烟不可关，出门满目是湖山。\n昔人华厦今何在，此日渔舟任自閒。\n风观斩新霄汉上，龙洲依旧水云间。\n归来丘壑多幽趣，愿与诸贤约往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"薛昂","text":"欢声如凤来衔诏，喜气如鸡去揭竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洞霄","author":"薛泳","text":"群山皆玉立，中有一峰危。\n天近秋云薄，松深夜月迟。\n洞因寻药入，席为听泉移。\n此趣无人会，临风酒一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青玉案 守岁","author":"薛泳","text":"一盘消夜江南果。\n吃果看书只清坐。\n罪过梅花料理我。\n一年心事，半生牢落，尽向今宵过。\n此身本是山中个。\n才出山来便希差。\n手种青松应是大。\n缚茅深处，抱琴归去，又是明年话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"薛泳","text":"归心如病叶，一片落江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"薛泳","text":"柳断桥方出，烟深寺欲浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大涤洞天留题","author":"薛炎","text":"我有爱山癖，苦无买山钱。\n平生天柱梦，今日地行仙。\n九锁何曾碍，三椽若有缘。\n鹅溪三百幅，唤起老龙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"续和漕司高斋韵","author":"薛绂","text":"坦情渠侬嫌我真，斗升谁给太仓陈。\n悠悠江汉飘零客，落落乾坤老病身。\n心历百艰弥感奋，诗留千古越清新。\n高斋高处齐文焰，付与从今仰止人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二十三","author":"薛绍彭","text":"去意已轻千里陌，深杯难醉九回肠。\n灞陵叶落秋风里，忍对霜天数雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白石潭","author":"薛绍彭","text":"轻舟系石依蒹葭，春后清江便是家。\n蓬底爨烟将稚子，共携渔网晒晴沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经行三首 其三","author":"薛绍彭","text":"月分圆影委金波，峰面无尘瑩不磨。\n应是飞仙梳洗处，碧台青绶挂云萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经行三首 其二","author":"薛绍彭","text":"水石相迎击目新，两峰秀色引朱轮。\n使君自比兰亭后，金字磨崖更几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经行三首 其一","author":"薛绍彭","text":"辩士祠边半岭松，不容凡木乱江风。\n筇枝拄到峰头阁，天籁都归十八公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"薛绍彭","text":"东晋风流胜事多，一时人物尽消磨。\n不因醉本兰亭在，后世谁知旧永和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇华","author":"薛绍彭","text":"橘树松林绿径长，竹篱萦绕当城隍。\n皇华何异投荒客，已过山川是夜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荼蘼","author":"薛绍彭","text":"野白荼蘼夹路长，迎风不断挹浓芳。\n凤池荀令曾来否，几许薰炉敌此香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和巨济韵","author":"薛绍彭","text":"通泉字法出官奴，日日临池恨不如。\n双鲤可无轻素练，数行惟作硬黄书。\n乡关何处三秦路，马足经年万里馀。\n多谢玉华宫畔客，新诗未觉故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄鲁直学士","author":"薛绍彭","text":"瘴地经行促棹讴，周南太史几年留。\n后来遥识犹青眼，别久悬知半白头。\n宋玉又经巫峡去，谪仙初罢夜郎游。\n长江风水追难及，怅望春波一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]