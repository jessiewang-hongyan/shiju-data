[{"title":"遍阅斋房题名独不见永叔戏作七言","author":"刘敞","text":"十二楼居五碧城，祠官多识汉名卿。\n蓬莱仙客飞升早，不向丹台稍刻名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自东门泛舟至竹西亭登昆丘入蒙谷戏题二首 其一","author":"刘敞","text":"汎汎扁舟春水平，缘蘋白芷欲齐生。\n王孙自喜山中客，莫唱淮南招隐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自东门泛舟至竹西亭登昆丘入蒙谷戏题二首 其二","author":"刘敞","text":"万竿苍翠隔晴川，寂寞芜城三百年。\n此地重闻歌吹发，扬州风物故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"养鸡","author":"刘敞","text":"耆旧漂零汉汝南，长鸣独与古无惭。\n萧萧风雨思君子，欲倚空窗听尔谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"受诏俟代先遣家人南归发后一日寄内七言","author":"刘敞","text":"年长渐难禁远别，宵长初信有相思。\n天寒展转不得寐，一夜风吹庭树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一百五多叶白牡丹答陈度支二首 其一","author":"刘敞","text":"玉色天香无与俦，猝风暴雨判多愁。\n君知大半春将过，初识人间第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一百五多叶白牡丹答陈度支二首 其二","author":"刘敞","text":"嵩少雨晴寒食时，年年驿使按瑶墀。\n尘埃落莫长安陌，笑倚春风不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题新开花呈永叔","author":"刘敞","text":"野客赏春怜物华，不将手触新开花。\n且留林下引狂蝶，看舞东风倾绿霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山","author":"刘敞","text":"独孤刺史提千骑，飞盖驩游向此中。\n高岸如今已成谷，还如岘首忆羊公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五色蔷薇","author":"刘敞","text":"春来百花次第发，红白无数竞芳菲。\n解向人间占五色，风流不尽是蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄蔷薇","author":"刘敞","text":"绿叶黄花相映深，水边台畔结浮阴。\n何人解赏倾城态，一笑春风与万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嶰林","author":"刘敞","text":"已看秀色动高林，会见翛翛满翠岑。\n不学渭川千亩富，欲闻嶰谷凤凰音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜鹘花","author":"刘敞","text":"嫩红轻紫仙姿贵，合是山中寂寞开。\n九陌风尘肯相顾，可怜空使下山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阁后丛筱中自生梧桐手封殖之因作口号呈范七王八二阁老","author":"刘敞","text":"常咏椅桐待高凤，忽经阿阁见孙枝。\n朝恩未放江湖去，更看亭亭百尺时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种梧桐","author":"刘敞","text":"欲种梧桐满碧轩，春风岑寂映琴樽。\n虽未能令丹凤至，要须长绝众禽喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别永叔后记事","author":"刘敞","text":"醉中不记别君时，卧载征车南向驰。\n惊觉尚疑君在侧，满身明月正相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"刘敞","text":"梅靥稀疏无剩白，柳眉繁弱未全青。\n墙头红杏春多少，醉看愁吟意总醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒芦","author":"刘敞","text":"洞庭木落风霜秋，兼葭处处使人愁。\n可怜一见京尘里，却忆孤槎天际浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈主人二首 其一","author":"刘敞","text":"世上年华似车毂，俗中形态若樊笼。\n解开绛帐陈红粉，何必通儒独马融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈主人二首 其二","author":"刘敞","text":"雨催春意苦无多，柳色花香奈汝何。\n谁举一樽属明月，小垂手舞缓声歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎春花二首 其一","author":"刘敞","text":"秾李繁桃刮眼明，东风先入九重城。\n黄花翠蔓无人顾，浪得迎春世上名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎春花二首 其二","author":"刘敞","text":"沈沈华省锁红尘，忽地花枝觉岁新。\n为问名园最深处，不知迎得几多春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自淮南移东平兼西路安抚使六月五日初入东界得快雨是时齐鲁久旱欣然作小诗示攽奉世等聊志一时意耳","author":"刘敞","text":"东郊问俗拥征辕，天与为霖破郁烦。\n惭愧泰山云触石，误疑刺史雨随轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偃师驿观先帝所植两松及钱丞相壁记","author":"刘敞","text":"华封耆老望车尘，故以青松祝圣人。\n云去帝乡桑变海，旧枝重叠长龙鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月二日","author":"刘敞","text":"十月黄河冰未凘，柳条若若草离离。\n寒蛩逐马声相续，都似江南秋半时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"便坐廷中稆生嘉禾两本因成二十八字呈同僚诸君","author":"刘敞","text":"报政三年愧鲁公，将何归奏未央宫。\n便廷嘉谷知天意，因得从容贺岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事二首 其一","author":"刘敞","text":"长日熏风春欲回，啼莺鸣鴃乱相催。\n不嫌柳絮都飞尽，惜许酴醾取次开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事二首 其二","author":"刘敞","text":"白社不知天上乐，残芳可惜逐东风。\n谁家酴醾花正发，走马平明看醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种花五首 其一","author":"刘敞","text":"粉萼朱华俱满丛，莺喧蝶舞乱春风。\n前年手种今年看，自觉淹留已老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种花五首 其二","author":"刘敞","text":"弱柳海棠虽晚栽，翠眉红脸已齐开。\n蜀姬艳色巴姬舞，并送春愁入眼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种花五首 其三","author":"刘敞","text":"长爱武陵溪上人，种花无数碧溪滨。\n莫轻野客时情薄，看尽灵桃岁岁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种花五首 其四","author":"刘敞","text":"行绕新芳不拟回，春光二月已全催。\n江南寒食饶风雨，未落应须日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种花五首 其五","author":"刘敞","text":"忆昔空园今作林，墙头枕上总成阴。\n废兴人事非天意，时暂纷华亦赏心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探花郎送花坐中与邻几戏作七首 其一","author":"刘敞","text":"两郎探花如顾山，红紫黄白俱可怜。\n春风过此即埽地，尔复碌碌慰眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探花郎送花坐中与邻几戏作七首 其二","author":"刘敞","text":"两郎放荡不自羁，春物寂寥宁得知。\n能读离骚饮美酒，头白江翁殊复奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探花郎送花坐中与邻几戏作七首 其三","author":"刘敞","text":"春服始成天气新，沂水风起如鱼鳞。\n由来舞咏吾与点，童子与公凡几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探花郎送花坐中与邻几戏作七首 其四","author":"刘敞","text":"眼昏头白老冯唐，三十馀年离举场。\n春色年年在琼苑，曾经十榜探花郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探花郎送花坐中与邻几戏作七首 其五","author":"刘敞","text":"溱洧芍药堂背萱，浓红柔绿相映繁。\n郑卫之风久寂寞，坐无诗翁谁使言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探花郎送花坐中与邻几戏作七首 其六","author":"刘敞","text":"酴醾蔷薇香最奇，古人不闻今始知。\n世间此辈复何限，零落深林方足悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探花郎送花坐中与邻几戏作七首 其七","author":"刘敞","text":"牡丹开尽群芳少，红药丹萱亦可怜。\n眼看春事已如此，有酒不饮讵为贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花三首 其一","author":"刘敞","text":"消露浓霞满眼春，攀香弄影地无尘。\n仙源一入吾将老，不学武陵溪上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花三首 其二","author":"刘敞","text":"碧海仙山拂太微，春风蟠木发瑶池。\n人间日月知多少，坐见高花烂漫时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵伯言明发登西楼望桃花 其二","author":"释道潜","text":"小楼西望那人家，出屋香梢几树花。\n只恐东风能作恶，乱红如雨堕窗纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻御试毕寄同人","author":"刘敞","text":"鹏欲图南鱼戴角，风云变化不踰时。\n谁知遁世聱牙者，翻覆西窗数局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠省判沈郎中","author":"刘敞","text":"休文零落向千年，一世风流几许传。\n锦袋牙签二万卷，羡君能似昔人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"在北得家书","author":"刘敞","text":"论从定约欲车回，笑领双鱼手自开。\n便觉长安近于日，不闻人自日边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉天门观汝水","author":"刘敞","text":"流水回还萦雉堞，乱山苍翠拥层楼。\n会将绿蚁捐长日，幸有高风送麦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昆丘台","author":"刘敞","text":"重峦似欲学层城，上有帝宫人不行。\n访古寻幽复观化，垂杨生肘未曾惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪泽阻风","author":"刘敞","text":"风振苍山海逆流，扁舟未济使人愁。\n聊把钓竿消永日，溪翁沙鹭共悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时会堂二首 其一","author":"刘敞","text":"雪霁苍山未有尘，阳崖气色已含春。\n不关南国年芳早，自有东藩欲贡新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时会堂二首 其二","author":"刘敞","text":"江涌岷山万里来，地蟠昆岭百寻开。\n故移蒙顶延年味，共献无穷甘露杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月雷后作","author":"刘敞","text":"腊破春光逼眼来，暄风膏雨杂轻雷。\n黑貂已敝京尘里，兴发犹堪贳酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄贺隐直捷开封府解","author":"刘敞","text":"高士何须轻主簿，客星今欲上灵槎。\n题名趁取台中旧，前后龙头属当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻张给事倍道兼程已过古北戏作七言","author":"刘敞","text":"叱驭勤王肯暂留，边沙朔雪犯貂裘。\n飞黄一日须千里，应笑迂儒骑土牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雷雨","author":"刘敞","text":"寂寞荒居草木深，商歌犹足玩愁霖。\n仰头笑问丰隆苦，亦未妨人倚柱吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棕榈","author":"刘敞","text":"纛影吒挲竿影直，雪中霜里伴松筠。\n可怜憔悴凌云色，还是昂藏独立人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江梅","author":"刘敞","text":"江南谁折一枝春，玉骨冰肤画不真。\n撩乱清香随驿使，尘埃满眼正愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观儿童逐兔辄失之戏呈希元二首 其一","author":"刘敞","text":"碧眼儿童誇绝伦，竞驰奔兔蹙飞尘。\n俯身捷下重冈去，空听弦歌不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观儿童逐兔辄失之戏呈希元二首 其二","author":"刘敞","text":"满目苍山宿草衰，雪残深谷正多岐。\n莫将弓箭穷飞走，笑杀黄须邺下儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初出古北口大风","author":"刘敞","text":"我持汉节议和亲，北上边关极海滨。\n宜有鬼神阴受命，劲风来埽幕南尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月十二日斋祠西太一宫是日大风","author":"刘敞","text":"绛阙碧城天与通，世间惟望气浑融。\n神仙定与尘埃隔，自怪来时亦驭风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣俞逢卖梅花五首 其一","author":"刘敞","text":"送腊迎年越岭梅，几时随驿过江来。\n上林桃杏矜颜色，已老东风寂寞开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣俞逢卖梅花五首 其二","author":"刘敞","text":"三月都城雪卷沙，幽芳偏恨杂群花。\n九衢何处江南客，一笑相知越女家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣俞逢卖梅花五首 其三","author":"刘敞","text":"东阡北陌竞春游，弄雪翻云为少留。\n落去能无怨羌笛，折来端是乱乡愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣俞逢卖梅花五首 其四","author":"刘敞","text":"安得繁英种满园，风前月下共方樽。\n放歌起舞浓阴里，长使清香濯醉魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和圣俞逢卖梅花五首 其五","author":"刘敞","text":"可怜风雨逼流阴，无奈芳菲恼客心。\n暂引江南春入眼，不辞多掷袖中金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观城上梅花忆和","author":"刘敞","text":"城头梅树花初发，每到花前忆剡中。\n白水碧山应不少，与谁携手过春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张译归","author":"刘敞","text":"雪霜载涂春欲晞，江流水驻君北归。\n南方遐夐久共住，可怜不及双凫飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","pa