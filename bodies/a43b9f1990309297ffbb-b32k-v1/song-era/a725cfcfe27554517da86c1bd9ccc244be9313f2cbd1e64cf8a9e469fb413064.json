[{"title":"宿濠州高唐馆","author":"阎钦爱","text":"借问襄王安在哉，山川此地胜阳台。\n今朝寓宿高唐馆，神女何曾入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梅坛","author":"甘邦俊","text":"火德中微否未倾，朝阳一疏凤先鸣。\n如公忠论能旋听，彼莽奸谋未易成。\n万古仙名香宇宙，几人遗臭腐公卿。\n至今风吼松声怒，似为先生诉不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"贾仲颖","text":"尽开窗户容秋月，遍倚阑干看晚山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其二","author":"方九功","text":"莫惜寒花开太晚，孤怀深喜客来双。\n疏枝最耐存霜圃，晚节偏宜映月窗。\n同调自应兰是籍，浊醪何有玉为缸。\n篱边无限陶潜兴，倒著纶巾醉未降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其二","author":"洪师中","text":"九曲青山一曲溪，仙人住处自春迟。\n笋舆切莫匆匆返，要作春行卷里诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登翠微亭 其二","author":"余迪","text":"池阳胜迹翠微峰，今古才人咏不穷。\n僧寺宛如仙仗里，人家俨若画图中。\n迎风杨柳依依绿，带雨桃花淡淡红。\n沉醉不知归去晚，匆匆回首月升东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"紫姑仙为诗索和因用其韵赠范法官 其二","author":"翁溪园","text":"范君仙吏术何高，欲祷灵扃祇一敲。\n借箸立谈神斡运，画灰成字势盘坳。\n三钱舞卜堪为侣，五斗师来可缔交。\n神力也须人力附，寄言诗将莫轻嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆游宝制 其二","author":"吴同山","text":"时事枰棋著固难，奕秋袖手却旁观。\n汉庭持论卑皋朔，洛社论年参潞韩。\n富贵无心来则受，行藏有道处之安。\n金笼放鸽徒誇诩，静处乾坤分外宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游东禅院","author":"郭某","text":"地去关城远，无人□□□。\n泉流溪路窄，石显洞门深。\n□□□□□，□□竹树阴。\n□□□□□，□日解题襟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真人 其二","author":"彭徵","text":"散发披襟万仞冈，天池风度碧莲香。\n洞云去作人间雨，留下瑶坛月影凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真人 其三","author":"彭徵","text":"老桂吹香入古瓢，月华如水碧天寥。\n酒醒夜半谁惊觉，鹤背仙人紫玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真人 其四","author":"彭徵","text":"山中无历任光阴，梅正开时雪意深。\n弹罢蕊珠香满座，天花几个落瑶琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"普通禅寺 其二","author":"释德惠","text":"问讯岩中主，形枯雪满头。\n住山何岁月，坏衲几春秋。\n傍石千间屋，腾空百尺楼。\n尽从心地出，声价甲西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"占胜亭 其二","author":"王阜寿","text":"湖气昏昏雾气漫，泊舟亭下水生寒。\n幽人醉卧篷窗月，喝起痴龙倒挂看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烟波亭","author":"吴珠","text":"汉水连天阔，江云护晓寒。\n青青山数点，最好倚栏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"省谒观文之茔留题 其二","author":"范公","text":"赞书褒显下重泉，嗣圣初临建武年。\n河洛图书光似日，商周盘诰远如天。\n孤墓岂意留空谷，直意犹能禦二边。\n彷佛音尘如在目，遗风雅颂纪新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚对亭","author":"虞亿","text":"落日下青嶂，归云独未安。\n倚杖无言久，夕阴生翠寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄雪蓬姚监丞","author":"蔡槃","text":"忆昔青灯夜对床，断猿声里早梅香。\n一从去棹冲寒雪，几度凭阑到夕阳。\n秋思渐于蝉外觉，别愁偏向雁边长。\n梧桐解得离人意，不遣西风吹叶黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其二","author":"史铸","text":"霜里鲜鲜照眼明，人言此解制颓龄。\n怜香擘破花心嗅，酌尽斋中竹叶瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其三","author":"史铸","text":"一夜清霜殒物华，寒芳开晚独堪嘉。\n折来嗅了依前嗅，不是寻常儿女花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其四","author":"史铸","text":"篱菊含风暗度香，栽多不为待重阳。\n愈风明目须真物，梦寐宜人入枕囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其五","author":"史铸","text":"露丛芬馥敌兰芽，清赏终存好事家。\n莫遣儿童容易折，此花开后更无花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其六","author":"史铸","text":"露裛幽花冷自香，药中功效不寻常。\n祛风偏重山泉渍，胡广随缘却寿长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其七","author":"史铸","text":"清香裛露对高斋，端仗兹花慰老怀。\n欲折一枝来侑酒，登高能赋属吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其八","author":"史铸","text":"八月九月天气凉，绕栏种菊一齐芳。\n好风应会幽人意，时去时来管送香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其九","author":"史铸","text":"不趁盛时随众卉，幽姿高韵独萧然。\n别开小径连松路，常爱陶潜远世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其十","author":"史铸","text":"篱菊开时寒有信，幽香还酿客怀清。\n折归忍负金蕉叶，欲伴骚人赋落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其十一","author":"史铸","text":"菊花有意浮杯酒，秋老霜浓满槛开。\n多谢主人相管领，尽收清致助吟才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花 其十二","author":"史铸","text":"一夜新霜著瓦轻，照窗寒菊近人清。\n白发年年不负盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其二","author":"史铸","text":"白露黄花自绕篱，幽香深谢好风吹。\n陶公没后无知己，岁岁花开知为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其三","author":"史铸","text":"绕篱黄菊自开花，开日仍逢小雨斜。\n自得金行真正色，肯参红紫斗纷华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其四","author":"史铸","text":"金英寂寞为谁开，底许清香鼻观来。\n篱下先生时得醉，馀风千载出尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其五","author":"史铸","text":"满园佳菊郁金黄，寿质清癯独傲霜。\n且喜年年作花主，依然相伴向秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其六","author":"史铸","text":"五行正气产黄花，不在诗家即酒家。\n诗笔酒杯俱有味，亦同元亮旧生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其七","author":"史铸","text":"满地黄花得意秋，移来庭槛助清幽。\n自缘禀性天生异，不与繁华混一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其八","author":"史铸","text":"篱边黄菊为谁开，转忆陶潜归去来。\n插了满头仍渍酒，且谋欢洽玉山颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其九","author":"史铸","text":"倚风黄菊绕疏篱，自有清香处处知。\n今日王孙好收采，浊醪霜蟹正堪持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十","author":"史铸","text":"金蕊繁开晓更清，薄霜浓露倍多情。\n归田谁是渊明兴，独绕东篱万事轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十一","author":"史铸","text":"丛菊疏疏著短篱，重阳前后始盈枝。\n托根占得中央色，不比凡花儿女姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十二","author":"史铸","text":"自有渊明方有菊，因人千古得嘉名。\n一年好处君须记，翠叶金华刮眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十三","author":"史铸","text":"东篱黄菊为谁香，不学群葩附艳阳。\n直待素秋霜色里，自甘深处作孤芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十四","author":"史铸","text":"香雾霏霏欲噀人，黄花又是一番新。\n陶家旧已开三径，直到如今迹未陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十五","author":"史铸","text":"满眼黄花慰素贫，年年结侣采花频。\n要收节物归觞咏，只许閒人作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十六","author":"史铸","text":"菊花天气近新霜，节近花须满意黄。\n陶令篱边常留宿，朝来满把得幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十七","author":"史铸","text":"东篱九日富黄花，节物惊心祇自嗟。\n尽日馨香留我醉，银瓶索酒不须赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十八","author":"史铸","text":"斜照明明射竹篱，黄花能与岁寒期。\n人疑五柳先生宅，消得携觞与赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其十九","author":"史铸","text":"黄花弄色近重阳，风拆霜苞细细香。\n似与幽人为醉地，随晴随雨一传觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊二十首 其二十","author":"史铸","text":"可意黄花是处开，芝兰风味合相陪。\n应须学取陶彭泽，左把花枝右把杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花五首 其一","author":"史铸","text":"不受阳和一点恩，不嫌青女到孤根。\n年年岁岁花相似，谁为陶潜买酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花五首 其二","author":"史铸","text":"粲粲秋香雨露葩，天教晚发赛诸花。\n轻烟细雨重阳节，且尽芳樽恋物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花五首 其三","author":"史铸","text":"渐觉西风换物华，秋丛绕舍似陶家。\n世人若觅长生药，百草枯时始见花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花五首 其四","author":"史铸","text":"代谢相因寒事催，绕篱疏菊又花开。\n霜晴日淡虚庭里，多少清香透入来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花五首 其五","author":"史铸","text":"不是餐英泥楚骚，重阳菊蕊泛香醪。\n寻常不醉此时醉，陶令抛官意独高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其一","author":"史铸","text":"百卉千花了不存，独开黄菊伴金樽。\n欲知却老延龄药，谁信幽香是返魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其二","author":"史铸","text":"菊是去年依旧黄，风从花里过来香。\n杯中要作茱萸伴，更领诗人入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其三","author":"史铸","text":"白酒新熟山中归，黄花漠漠弄秋晖。\n东篱采菊隐君子，醉觉人间万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其四","author":"史铸","text":"羽葆层层间彩金，醉来不厌绕丛吟。\n满头且应良辰插，不插满头辜此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其五","author":"史铸","text":"篱外黄花菊对谁，应知彭泽久思归。\n有花堪折直须折，新酒初篘蟹正肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其六","author":"史铸","text":"无限黄花簇短篱，幽香深谢好风吹。\n劝君终日酩酊醉，莫待无花空折枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其七","author":"史铸","text":"花里风神菊擅名，绿枝黄蕊有高情。\n诗人不悔衣沾露，步入芳丛脚自轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其八","author":"史铸","text":"幸无风雨近重阳，折取萧萧满把黄。\n酒面浮英爱芬馥，银觥须引十分强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄菊九首 其九","author":"史铸","text":"不与群芳竞，宜乎殿颢商。\n露从今夜白，菊是去年黄。\n九日陶公酒，一生青女霜。\n有同高士操，得尔慰凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读徐伯远书外家遗事作二绝句以纪之并序 其二","author":"周紫芝","text":"杀气骎骎战舰骄，春江漫漫湿金翘。\n但将红袖供歌舞，却为周郎笑二乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦中诗","author":"叶李","text":"通明殿逼紫微垣，一朵红云拥至尊。\n下土小臣勤稽首，愿将惠泽溥元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瘦马图","author":"龚开","text":"一从云雾降天关，空尽天朝十二闲。\n今日有谁怜瘦骨，夕阳沙岸影如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自题中山出游图","author":"龚开","text":"髯君家本住中山，驾言出游安所适？\n谓为小猎无鹰犬，以为意行有家室。\n阿妹韶容见靓妆，五色胭脂最宜黑。\n道逢驿舍须少憩，古屋无人供酒食。\n赤帻乌衫固可烹，美人清血终难得。\n不如归饮中山酿，一醉三年万缘息。\n却愁有物觑高明，八姨豪买他人宅。\n侍得君醒为埽除，马嵬金驮去无迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"连文凤","text":"老我无心出市朝，东风林壑自逍遥。\n一犁好雨秧初种，几道寒泉药旋浇。\n放犊晓登云外垄，听莺时立柳边桥。\n池塘见说生新草，已许吟魂入梦招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"冯澄","text":"编阑春思倩吟鞭，著面和风软似绵。\n黄犊乌犍秧谷候，雄蜂雌蝶菜花天。\n把锄健妇踏烟垄，抱瓮丈人分野泉。\n忙事关心在何处？\n流莺不听听啼鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴二首 其一","author":"杨本然","text":"春风建业马如飞，谁肯田园拂袖归？\n栗里久无彭泽赋，松江仅有石湖诗。\n踏歌槌鼓麦秧绿，沽酒裹盐菘芥肥。\n吴下风流今莫续，杜鹃啼处草离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴二首 其二","author":"杨本然","text":"露畦烟陌里，名利等秋毫。\n引犊随牛放，祈蚕望茧缫。\n和根挑荠菜，带叶摘樱桃。\n读罢归来赋，临风欲和陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"方德麟","text":"绕畦晴绿弄潺湲，倚杖东风却黯然。\n往梦更谁怜秀麦，閒愁空自托啼鹃。\n犁锄相踵地力尽，花柳无私春色偏。\n白发老农犹健在，一蓑牛背听鸣泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"林子明","text":"一点阳和薰万宇，最饶佳致是山庄。\n鸡豚祝罢成长席，莺燕听来隔短墙。\n嗜酒不嫌多种秫，无襦长恨少栽桑。\n东郊劝相何烦尔，农圃吾生自合忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"周暕","text":"蛙声似吹雨初足，桑椹欲红风始和。\n少妇每忧蚕利薄，老夫惟喜秫苗多。\n旧栽花木山莺识，新买陂塘野鹭过。\n此境东风元自好，当年金谷事如何？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"姚潼翔","text":"壁写新年百事昌，春盘次第蓼芽香。\n烧灯过了争挑菜，祭社归来便撒秧。\n布谷几声催耜亩，吴蚕三伏正条桑。\n一春忙过无多日，又听鹂鹒报麦黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"胡南","text":"世数有迁革，田园无古今。\n鸟喧争树暖，牛倦憩墙阴。\n水活土膏动，风微花气深。\n渊明千古士，伫立此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]