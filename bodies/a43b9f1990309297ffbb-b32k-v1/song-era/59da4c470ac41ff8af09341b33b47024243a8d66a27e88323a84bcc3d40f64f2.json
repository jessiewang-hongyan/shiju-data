[{"title":"偈颂一百六十九首 其三十四","author":"释智朋","text":"得力句子，全身担荷。\n水长船高，泥多佛大。\n西风雁字新，东篱菊花老，四十九年谈不到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十一","author":"释智朋","text":"不舍诸道法，而现凡夫事。\n万人游仰处高挂锦标，千波竞起时要须好手。\n还如曾斗快龙舟，一度赢来方始休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十","author":"释智朋","text":"暮春初，修禊事。\n少长咸集，群贤毕至。\n数树松花，一溪流水。\n知惭愧底足以畅叙幽情，无摸索底正好顿张意气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十九","author":"释智朋","text":"诸佛出世，标拍荒郊，达磨西来，冢添新土。\n保福今日，向拜扫无门处打开一路，冬至寒食一百五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十八","author":"释智朋","text":"黄檗棒头，马祖喝下。\n家家春风二三月，处处绿杨堪系马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十五","author":"释智朋","text":"坐底坐杀，立底立杀。\n不知谁是赤须胡，转身句子活鱍鱍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十三","author":"释智朋","text":"提折脚铛，各出只手。\n释迦不先，弥勒不后。\n妙用临机，如盘珠走。\n鼓腹笑复歌，面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十二","author":"释智朋","text":"滞货无价，烂钱无索。\n咬定牙关，将错就错。\n天将以夫子为木铎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十一","author":"释智朋","text":"冬不寒，腊后看。\n酸风刮地，冻破泥团。\n毗卢楼阁前，少林深雪里，谁知犹隔万重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二十","author":"释智朋","text":"一叶落，天下秋。\n回避不及底眼睛突出，窥觑无门底南州北州。\n有来由处没来由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其十八","author":"释智朋","text":"胞胎才出播殃尘，直至如今毒害人。\n一杓兰汤无限恨，腕头何止重千斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其十六","author":"释智朋","text":"达磨西来，卦文不识。\n胡卜乱卜，传至今日。\n佛日等是开个铺席，敢向朕兆未分已前。\n端平元年正月一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其十五","author":"释智朋","text":"黄面老子性命，今日落在朋上座手里。\n扶起放倒，不为差事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其十四","author":"释智朋","text":"旧岁昨宵去，新年今日来。\n灯笼与露柱，不觉笑咍咍。\n达磨面壁，云门念七。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其十三","author":"释智朋","text":"全身坐在正觉山中，要行便行要用便用。\n明星现处路头通，十倍慈悲成脱空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其十二","author":"释智朋","text":"楖?木卷而曲，回天关转地轴。\n群阴时时剥尽，一阳日日来复。\n为甚罗汉山中冷门难向，不是苦心人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其十","author":"释智朋","text":"大地皆冻锁，遍界热如火。\n时节不放过，衲僧多蹉过。\n不蹉过，深雪之中有一个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九","author":"释智朋","text":"日卓午，夜半子。\n千门万户俱开，一声两声砧杵。\n流沙浪阔，葱岭无路，达磨何曾归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其八","author":"释智朋","text":"秋雨凄凄，秋云黯黯。\n修成八万四千斧，不比寻常三五圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七","author":"释智朋","text":"卒风暴雨，鼓荡无前。\n石裂崖崩，回避不及。\n总教丧尽生涯，方见时清道泰。\n功不浪施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其六","author":"释智朋","text":"未举先知，未言先领。\n赵州无关，玄沙有岭。\n万别千差一印定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五","author":"释智朋","text":"事同一家，万别千差。\n云门糊饼，赵州吃茶。\n何似南山鳖鼻蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其四","author":"释智朋","text":"一灯分灯灯无尽，一处明处处齐透。\n闹浩浩中一法不舍，静悄悄处一尘不受。\n灯明如来，一场漏逗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其二","author":"释智朋","text":"佛身无为，不堕诸数。\n土块泥团，灯笼露柱。\n凤栖不在梧桐树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四五","author":"释智朋","text":"安居禁足，护生杀生。\n无依倚处，百匝千层。\n柏山手里有乌藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四四","author":"释智朋","text":"一棒一喝，疾雷破山，一提一唱，崩空峭壁。\n诸佛傍观有分，诸祖拈掇不出。\n只如入已还闭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四三","author":"释智朋","text":"雪山中，夜半子。\n眼见星，丑恶露。\n四十九年分疏不去，儿孙千古遭涂污，腊八年年是一度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四二","author":"释智朋","text":"七日来复，宫添一线。\n衲僧分上作么生，石笋抽条，冰河发焰。\n柏山拄杖子，放一头低，与你相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四一","author":"释智朋","text":"人情浓厚道情微，道用人情世岂知。\n盐咸醋酸，阿谁不知。\n只要熟处放教生，生处放教熟。\n道用人情日久，自然打成一片。\n犹是蹲坐在净地上，要得大方独步，柏山与你草鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一四○","author":"释智朋","text":"黄檗归本位坐，陷虎机深。\n保寿打推出僧，钓鳌力巨。\n一举三山连，未称全提处。\n把断要津，辉腾今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三九","author":"释智朋","text":"草舍家风，少富多贫。\n牙根齧定，七纵八横。\n有炉无火烧杀人，有火无炉走杀人，说甚杨岐鬼眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三八","author":"释智朋","text":"护生杀生，遍界刀鎗。\n柏山结也如常，解也如常。\n如常恰似秋风至，无意凉人人自凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三七","author":"释智朋","text":"柏山小小丛林，安居九十日。\n五日不升堂，隔日不入室。\n与么承当去，已是拗曲作直。\n吹糠著米，无赃考贼。\n沛公斗智，项羽斗力。\n南无甚深般若波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三六","author":"释智朋","text":"罢拈金锡，七尺军前。\n今春看又过，何日是归年，辜负春山啼杜鹃。\n樊将军向补陀山上礼观音大士，不知不觉，在五台峨嵋见文殊普贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三五","author":"释智朋","text":"爱圣憎凡，蜗牛上壁。\n凡圣情尽，独鹤下田。\n向外驰求，乡关转远。\n百尺竿头进得一步，脚跟下正好一锥。\n如是我闻，一时佛在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三三","author":"释智朋","text":"衲僧相见，或彼或此。\n水出龙宫，云生岳坞。\n壁立千仞放行，合水和泥把住。\n仁义道中是第几句，举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三二","author":"释智朋","text":"依时及节，岁岁元正启祚。\n葭管灰飞，勾芒布令。\n春牛头黄，岁稔年康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一三○","author":"释智朋","text":"散为器者，乃道之漓。\n适于变者，乃法之弊。\n衲僧家，如何是事事无碍底句。\n济北老秃兵，明州憨布袋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二八","author":"释智朋","text":"柏山高，秋风高。\n打失登山屐，吹落炙脂帽。\n应节应不及，登高登不到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二七","author":"释智朋","text":"一月普现一切水，一切水月一月摄，从上佛祖不出这影子。\n只今雨暗乾坤，月明如昼，衲僧眼目，瞒他一点不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二六","author":"释智朋","text":"旃檀林，无杂树。\n拈出片片皆香，收来枝枝显露。\n门头户底一等打开时如何，吃茶去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二五","author":"释智朋","text":"三回四度，不曾入得径山门。\n万恨千愁，今日落在弟子手。\n只得欢喜忍受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二四","author":"释智朋","text":"三处度夏，开拓封疆，眉毛在么，抱赃叫屈。\n柏山今夏，逢人不得错举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二三","author":"释智朋","text":"立中就中，渗漏难尽。\n不见一法，始是半提。\n向上全提，诸佛诸祖。\n明不出，标不起。\n龙女献珠，狼藉净地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二二","author":"释智朋","text":"大方无外，大圆无内。\n是凡是圣，同此安居。\n淈淈??，瞒瞒盰盰，富不足而乐有馀，是马何曾唤作驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一二一","author":"释智朋","text":"齐进退，正纪纲。\n提向上事，建光明幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一九","author":"释智朋","text":"倒卓须弥，揭翻大海。\n鱼龙变化，禽鸟欢呼。\n且放佛祖出头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一七","author":"释智朋","text":"平地起堆从古有，青天霹雳避犹难。\n杖头自有通方眼，风月一天非等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一六","author":"释智朋","text":"孤峰顶上无出身路，十字街头亦无向背。\n临济老瞎秃，明州憨布袋。\n正令不行，东倒西擂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一五","author":"释智朋","text":"肤寸生层云，已具瀰漫势。\n尽瞩晴空目，且非烟雾比。\n首座行脚，首座来也，落在第二。\n看看，云行雨至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一四","author":"释智朋","text":"正不立玄，偏无所附。\n三十年异类中行，末后句月圆古渡。\n夜船拨转琉璃殿，白鸟飞宿无影树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一三","author":"释智朋","text":"放下身心，仁义礼智。\n黄面瞿昙，捞天摸地。\n四月十五，唤作结制，东行不见西行利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一一二","author":"释智朋","text":"南州北州，万绪千头。\n钓丝绞水，纸撚无油。\n鹤神飞上天，土宿骑黄牛。\n大海有十件奇特事，未曾说著。\n海底蓬尘起，千江水逆流。\n维摩丈室，有三万二千狮子座，收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦宅","author":"释智朋","text":"六窗深闭大槐宫，一枕清风瞬息中。\n穷劫至今佛与祖，楼头知是几声钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山赞","author":"释智朋","text":"五字忍饥吟，十年忘归路。\n著不著大笑，一场吐不出。\n相似底句，是真文殊。\n无二文殊，苏卢㗭哩，㗭哩苏卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒拾赞","author":"释智朋","text":"放下苕帚，对坐岩穴。\n眼看不亭，口说不歇。\n想得峨眉五台，无此一天明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳穿破衲二首 其二","author":"释智朋","text":"骨相寒，毳寒衲。\n不朝阳，难提掇。\n正与么时，大地火发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳穿破衲二首 其一","author":"释智朋","text":"褴襂衣，能多少。\n破不尽，补不了。\n新罗夜半日轮红，线路何曾穿得透。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渡芦达磨赞二首 其一","author":"释智朋","text":"江水无极，茎芦可折。\n离了梁朝，未到魏阙。\n此恨波心向谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莲叶观音赞","author":"释智朋","text":"刹海无数，分身遍普。\n莲华叶上，如日卓午。\n应作如是观，圆通二十五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鳌山接待","author":"释智朋","text":"到得安眠饱饭中，东西南北路头通。\n三更夜半鬼嫁祸，莫著岩头与雪峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一六七","author":"释智朋","text":"西天此土，十万馀程。\n胡言易会，汉语难明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一六六","author":"释智朋","text":"夜半明星，打失眼睛。\n胡人多诈，未可全凭。\n遭他冤害，始报不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一五八","author":"释智朋","text":"贫到无锥，正好进步。\n王舍城中，有条活路。\n一声金锡，千门万户。\n全放全收，全宾全主。\n多宝如来，何曾过去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一五五","author":"释智朋","text":"丛林圣制，有解有结。\n透脱重关，红炉点雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一五四","author":"释智朋","text":"即心是佛，非心非佛。\n东涌西没，穿皮透骨。\n十字街头，孤峰绝顶，是离窠臼，不离窠臼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一五三","author":"释智朋","text":"至尊至贵，无去无来。\n体若虚空，迥绝安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其一○五","author":"释智朋","text":"虚空迸绽，山岳起舞。\n拔舌犁耕，罪恶俱露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其九十五","author":"释智朋","text":"坐一走七，横三竖四。\n大力量人，全身担负。\n普化铃铎，杨岐驴子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其七十九","author":"释智朋","text":"莺老花残，春事已过。\n明眼衲僧，多是蹉过。\n楝花信风，不肯放过。\n万户千门，一时俱过。\n筑著磕著，是谁之过。\n转换不得，也要验过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其五十一","author":"释智朋","text":"此大楼阁，无住无去。\n此楼阁门，无开无闭。\n作者同归，不劳弹指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十三","author":"释智朋","text":"心月孤圆，光吞万像，起模画样。\n光非照境，境亦非存，收拾不上，光境俱亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十九首 其三十二","author":"释智朋","text":"动弦别曲，落叶知秋。\n普天匝地，骑牛觅牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]