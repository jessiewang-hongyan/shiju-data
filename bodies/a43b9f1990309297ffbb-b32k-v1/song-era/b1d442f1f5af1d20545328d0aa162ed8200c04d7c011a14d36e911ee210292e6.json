[{"title":"春词 其十五","author":"毛滂","text":"宝历垂无极，璿玑转未央。\n绣楹膏露润，玉殿紫芝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其八","author":"毛滂","text":"柏酒勤称寿，椒涂蚤却寒。\n静无游乐事，殊阔濯龙欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十一","author":"毛滂","text":"八风调养力，九地发生深。\n共被年丰赐，谁知日昃心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其一","author":"毛滂","text":"春逐东风行地上，德随和气散寰区。\n圣人中正观天下，道本无言教已孚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十四","author":"毛滂","text":"日养千花气，风和百和香。\n君王自仁寿，柏叶更称觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其四","author":"毛滂","text":"精华初结纽，璧水再逢春。\n杞梓扶疏见，君王自作新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其一","author":"毛滂","text":"日催红?鞢，雪放绿蒙茸。\n莫向东郊去，王春在九重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其五","author":"毛滂","text":"仙桃欲拂朝真脸，禁柳忙催望幸眉。\n不会君王春思别，杏花菖叶在农时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十七","author":"毛滂","text":"玉甃兰封麝，瑶池柳养金。\n宸章先造化，摛藻自春林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其四","author":"毛滂","text":"天光地气与年新，不觉人间一物陈。\n初令雷霆端有信，旧馀霰雪敢无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十六","author":"毛滂","text":"琐窗朱户无寒到，长似春光日日来。\n自是螽斯载风什，可烦箫磬祀高禖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十六","author":"毛滂","text":"穆穆清光外，葱葱佳气中。\n云天看斗柄，寰海受和风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十三","author":"毛滂","text":"粉壁椒花馥，瑶钗彩燕翩。\n东风呼唤得，随意作春妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其八","author":"毛滂","text":"玉殿重帘捲水晶，椒花柏叶圣人清。\n千春万岁承明主，长听云韶歌管声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其六","author":"毛滂","text":"冰开御水龙鳞细，日照宫梅麝炷烘。\n欲看人间花灼灼，不妨葛藟共春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其二十","author":"毛滂","text":"风来太液冰先泮，日照延和柳未知。\n翠辇不缘花事出，行看荇带绿参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十八","author":"毛滂","text":"日射觚棱气郁葱，露华犹冷玉芙蓉。\n琐窗朱户春光暖，珠蕊琼花无数重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其六","author":"毛滂","text":"君恩破寒色，天笑觉春回。\n先暖延和柳，曾无羯鼓催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其三","author":"毛滂","text":"雪尽牙签暖，芸生竹简香。\n夜分犹乐此，定喜日舒长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其二","author":"毛滂","text":"云母春冰薄，氍毹晓气暾。\n尚垂宵旰意，加惠及元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其二","author":"毛滂","text":"冰销玉液凫鹥喜，日暖宜春草木长。\n忠厚家风传八叶，太平光景接三王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其五","author":"毛滂","text":"云避南山晓，天回北斗春。\n荣光生八彩，寿色两嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十二","author":"毛滂","text":"截肪初见昭华玉，刀出昆吾宝籀开。\n天助君王敷大喜，安排春色探先来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其七","author":"毛滂","text":"诞敷文德金铃振，尽纳熙河玉律谐。\n御柳宫梅动春意，朝来黄鸟亦喈喈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十","author":"毛滂","text":"君心与物为春久，唤得春风破腊回。\n天近自应通信息，梅花不用犯寒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其三","author":"毛滂","text":"好生恰对发生时，宽大恩流涣汗飞。\n雷雨解成僵蘖动，蓼萧诗就远人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十四","author":"毛滂","text":"宫漏迟迟不受催，出花光景渐徘徊。\n万方日日春台上，不道东风恰始来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十九","author":"毛滂","text":"腊寒辟易沉香火，春意侵寻玉琯灰。\n阴德承天专静厚，发生有助到根荄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其七","author":"毛滂","text":"瑞日晖晖上，非烟冉冉收。\n晴川蚕可浴，翠潋荇初流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十一","author":"毛滂","text":"春色年年染御沟，鸭头轻绿弄花柔。\n今年春到昆崙上，九折委蛇舞翠虬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十七","author":"毛滂","text":"靧面桃花有意开，光风转蕙日徘徊。\n昭阳天近知春早，玉琯东风破雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其十五","author":"毛滂","text":"雕云燎馥沉香暖，綵胜风翩玉燕寒。\n天上春光来咫尺，琼花瑶草遍阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓 其一","author":"毛滂","text":"东皋纷绮水潺潺，翠拂官桥柳欲眠。\n出谷黄莺终好在，辞风红树稍萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓 其二","author":"毛滂","text":"酴醾春晓与谁芳，自是新来雨露香。\n燕子觅巢终软媚，杨花满路尚颠忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓 其三","author":"毛滂","text":"炉香烬冷夹衣寒，雨过园林翠作团。\n剩得风光何处著，红蔷薇搭小栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓 其四","author":"毛滂","text":"池塘绿净了无尘，造化裁馀十日春。\n月树清深语鶗鴂，几时归去亦谩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼寝石颐寺","author":"毛滂","text":"何人支枕古邯郸，孤卧僧房四面山。\n故遣白云遮谷口，不教幽梦落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某获造司空府得至便座见文禽五六夷犹曲池上意甚得所慨然有感于衷戏作二绝句 其二","author":"毛滂","text":"几年不解向沧洲，矰缴曾伤质转幽。\n端倚主人怜采色，要随鹓鹭濯清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某获造司空府得至便座见文禽五六夷犹曲池上意甚得所慨然有感于衷戏作二绝句 其一","author":"毛滂","text":"许近清池养羽仪，恩波稳暖自忘归。\n长依竹石供潇洒，不学苍鹰饱便飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送茶宋大监 其一","author":"毛滂","text":"凤凰山畔雨前春，玉骨云腴绝可人。\n寄与青云欲仙客，一瓯相映两无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送茶宋大监 其二","author":"毛滂","text":"玉兔瓯中霜月色，照公问路广寒宫。\n绝胜自酌寒窗下，睡减悲添愁事丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送茶琳老","author":"毛滂","text":"道人诗思前溪水，流出山来亦自清。\n谩寄凤凰台畔雪，不妨竹里润琴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻琳老欲入山今少雨想未成行奉寄一绝","author":"毛滂","text":"野僧报我泉新白，此老居庵山更清。\n雨涩故应须小住，云寒端未出相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竞渡","author":"毛滂","text":"风旆悠悠水薄船，浪花翻覆自摇天。\n汨罗谁复追忠义，争快儿郎一棹先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罢官次常山寄郑叔详","author":"毛滂","text":"閒身已置参军帻，归路仍推处士车。\n石室散仙当醉起，试传消息过烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成二首 其二","author":"毛滂","text":"此生弱草寄轻尘，辜负南山笋蕨春。\n好去桃花破浪暖，清风明月不辜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成二首 其一","author":"毛滂","text":"随风出岫不知归，身落黄尘梦翠微。\n本亦无心肤寸事，故山却合自由飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶得佳酒分寄陈巨中","author":"毛滂","text":"南岳夫人绿酒春，近来未及玉膏醇。\n穆生不许聊须强，他日瀛洲是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常山孙令见过仆未起孙题壁而去作绝句寄之 其二","author":"毛滂","text":"门外初为罗雀地，壁间偶见换鹅书。\n忽然兴尽何由揖，拟遣长须致鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常山孙令见过仆未起孙题壁而去作绝句寄之 其一","author":"毛滂","text":"醉乡冉冉梦游閒，一夜凉风唤未还。\n可是应门无稚子，双凫仙去定谁攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常山孙令见过仆未起孙题壁而去作绝句寄之 其三","author":"毛滂","text":"夹道老槐分晓色，出楼寒鼓报衙声。\n解牛敏手仍投暇，梦蝶閒身尚未惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欲访天柱山阇黎寄一绝句","author":"毛滂","text":"三年不到上人家，目断晨烟与暮霞。\n急遣寄声堂下水，便来洗眼看天花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜山","author":"毛滂","text":"拟共孤云结往还，更名居士小香山。\n他年谁复寻遗赏，为到云山杳霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食日过翠峰塔院示法海道人","author":"毛滂","text":"云烟七级赤旃檀，龙护金函佛骨寒。\n问讯道人春到否，瑞香花谢倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"散药过东湖戏作绝句寄陈巨中","author":"毛滂","text":"谁为苍生起病癯，参军药裹欲何如。\n湖东道义为针石，不用先生肘后书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石桥寄郭庭晦","author":"毛滂","text":"乱峰攒剑护清幽，万壑云烟暮不收。\n欲就诗坛借旗鼓，为君争取一桥秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游翠峰寺","author":"毛滂","text":"隔墙杨柳舞腰斜，傍砌鹅梨玉作花。\n此地风光谁管领，小诗收入长官家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琳老送瑶花数叶云作香烧气甚清馥","author":"毛滂","text":"璀璨谁将玉作春，天魔故恼老诗人。\n金炉送在东堂手，便有清香通四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琳老惠麸乾走笔奉寄","author":"毛滂","text":"何人弹铗苦思鱼，食肉而飞亦任渠。\n谁见东堂病居士，山僧乞食亦分馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋李伯时醉僧图","author":"毛滂","text":"道人三昧一壶中，笔下惊蛇怖小童。\n日日松间好消息，酒香先过野桥风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福庆寺","author":"毛滂","text":"栏干倚尽赤旃檀，卢橘花开秀巘寒。\n会取虚庵留客意，小窗疏日上蒲团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔡天逸以诗寄梅诗至梅不至","author":"毛滂","text":"应念萧寒槁木身，殷勤分寄岭头春。\n冰肌玉骨终安在，赖有清诗为写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德清五兄寄清茶","author":"毛滂","text":"玉角苍坚已照人，冰肝寒洁更无尘。\n凤凰雨露生珍草，不比榛芜亦漫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题上元雪作题證道寺","author":"毛滂","text":"故岁婵娟独自来，今年更唤玉妃陪。\n要知霁色本无际，端放眼中云雾开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题贵溪翠颜亭二首 其二","author":"毛滂","text":"船中自带红泥灶，亭上亲煎白乳泉。\n唯有溪山知此意，水风吹面晚萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题贵溪翠颜亭二首 其一","author":"毛滂","text":"寒声著叶冥冥雨，晚色遮山冉冉云。\n且喜翠颜长好在，水边小住可无君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题琳老所携二苏书帖","author":"毛滂","text":"道人此书欲在眼，扁舟一宿亦随身。\n霁月光风开玉轴，千年彷佛见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠程巽山人","author":"毛滂","text":"十年贫贱欲如饧，愧客殷勤话此生。\n试与宋君寻卜肆，长安东市雨新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月二十八日挈家泛舟游上渚诗","author":"毛滂","text":"秋色向幽处，浮家聊远寻。\n醉来蓬鬓乱，卧入蓼花深。\n云壑封诗物，烟波留客心。\n未应儿辈觉，馀醁且勤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十六日出郊访无畏诗禅暮归奉寄","author":"毛滂","text":"寒郊独往兴悠哉，问讯山翁破腊回。\n犀轴冰寒苕水句，衲衣雪暗锦营埃。\n归时烟树鸦声集，望处溪窗山色来。\n此意儿童终不觉，闭门脱屩拂莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月十日访琳道人于禅静寺与之徘徊泉石间甚久道人云有大龙团藏亦数年食且几尽因出刀圭许而龙躯仅馀一爪色理极苍古又云赵清献公尝得须菩提画像乃张画壁间煎所谓龙爪以饷仆迫夜来归坐县之东堂见月奉寄一首","author":"毛滂","text":"道人泉石畔，饷我欲盘桓。\n见爪苍龙古，颦眉古佛寒。\n家风真草草，诗句自珊珊。\n今夜东堂梦，云披月万竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元夜","author":"毛滂","text":"翠辇遥窥日角丰，阳光浮喜散云同。\n海山不动双龙矫，天信频颁一鹤通。\n胡越照临清景内，唐虞消息笑声中。\n六街鼓舞谁能强，三尺儿童识帝功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上执政","author":"毛滂","text":"廊庙无尘鉴色寒，私门谁启手亲关。\n万邦和气君臣里，一代文章伯仲间。\n多士扬眉诣东閤，真人拱手倚南山。\n青天白日才亭午，不遣云随霰雪还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上林内翰二首 其二","author":"毛滂","text":"短褐风霜可奈何，懒求长袖舞阳阿。\n九迁行辈青云满，百谪形骸白发多。\n束带壮怀浑龃龉，角巾闲约亦蹉跎。\n山公有意相题目，季绪无容独诋诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上林内翰二首 其一","author":"毛滂","text":"内廷吴陆善文书，绝代如公可数渠。\n科斗他年载深厚，楞伽终日伴清虚。\n济时即展经纶业，华国聊施采色馀。\n想为君王话尧舜，玉堂对罢夜何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下渚湖","author":"毛滂","text":"春渚连天阔，春风夹岸香。\n飞花渡水急，垂柳向人长。\n远岫分苍紫，澄波映渺茫。\n此身萍梗尔，泊处即吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀寄赠曾公衮","author":"毛滂","text":"宦情光景半樵渔，病惰仍忘百纸书。\n赋就祇堪供酱瓿，齿残未可释盐车。\n朱蓝要使辞秋断，芝菌犹当出腐馀。\n惭愧少翁能下士，马曹知马自应疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]