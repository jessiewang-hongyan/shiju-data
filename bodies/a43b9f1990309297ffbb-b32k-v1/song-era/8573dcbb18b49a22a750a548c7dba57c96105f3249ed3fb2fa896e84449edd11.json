[{"title":"次韵谢陈守伯固","author":"陈造","text":"投老登龙借齿牙，可能病骥待挥挝。\n清篇久矣窥修月，谹论琅然听粲花。\n小却御屏书姓字，行当宣室拜亨嘉。\n恩章衮衮从天下，浓墨疏行砌乱鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢程帅复游习池见寄二首 其二","author":"陈造","text":"风流羊杜不劳追，况复轻裘缓带时。\n醉倒莫孤桃李月，诏归恐便凤凰池。\n政传西蜀中和颂，笔跨东京大小儿。\n我亦抄诗支郡去，公馀吟玩取娱嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢程帅复游习池见寄二首 其一","author":"陈造","text":"名园壮观还前日，禊事追游可后时。\n试问绣筵张绿野，何如诗客到昆池。\n绮罗香外莺偷眼，花柳稀间鸟哢儿。\n定许此民同此乐，春城无处不嬉嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵漕使张守二首 其二","author":"陈造","text":"授书天佐汉，鼓箧客师韩。\n气宇包溟渤，辞锋凛莫干。\n经纶股肱似，姓字齿牙寒。\n不作规随起，谁令九鼎安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵漕使张守二首 其一","author":"陈造","text":"政绩新皇眷，功名旧壮怀。\n人才双立玉，笔势各排淮。\n鹏路天惟咫，鲰生骨未埋。\n行看仲淹弼，接武冠尧阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵犒士","author":"陈造","text":"万灶连连俨旧屯，朝来喜气袭人温。\n固知除器须平日，政复投醪亦至恩。\n帝綍函春周垒壁，使星回耀照和门。\n文经武纬君王圣，汗简须公纪治原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵翟元卿 其二","author":"陈造","text":"我困枘投凿，君才瓴建高。\n要之同臭味，政以借熏陶。\n觞咏聊真乐，媸妍付尔曹。\n能来缓诗颊，芋火荐松醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵翟元卿 其一","author":"陈造","text":"君是儒冠秀，源流况父兄。\n文堪一战霸，气欲五郎卿。\n与世甘多遌，谋生迄未成。\n其谁为推挽，小试合承明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵樊汊","author":"陈造","text":"荒政赖贤守，湛恩推上方。\n龚黄真父母，秦越肯圻疆。\n手自起僵仆，术先销暴强。\n膏肓得司命，铭肺可能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赠高宾王二首 其二","author":"陈造","text":"滞留无地豁闲愁，诗将坛高许客投。\n过我肯论新旧雨，即君如望蓘穮秋。\n几时雾縠搴蛟室，快意湍涛放鹢舟。\n搯抉肾肠须小息，请携霜竹上危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赠高宾王二首 其一","author":"陈造","text":"瓦注缘穷也自昏，扫除胶扰近清樽。\n瘦田可谷宜投劾，小子今年亦抱孙。\n惯病已拚疏药物，就闲聊免怆吟魂。\n径当云卧山南北，芋火醅缸昼掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约二同年游虎丘","author":"陈造","text":"兼旬闭户耐寒威，起视晴空碧四围。\n黄鸟啼边忽游子，白龙去后渐单衣。\n年时尚记寻芳约，老境仍怜得醉希。\n红影幽香虎丘路，杖藜携酒莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约二赵棋集雨不果来","author":"陈造","text":"客子离群意，萧斋只睡宜。\n得无新雨叹，漫有故人期。\n日力须棋局，风凉入酒卮。\n转头车妇去，相忆各儿痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约吕徐二友游净慈二首 其二","author":"陈造","text":"一笑成行不待营，可无条约谂同盟。\n盘餐取饱真君事，杯酒邀欢太俗生。\n拨冗得闲殊自乐，吸光饮渌不胜清。\n即今冷眼聚蚊梦，彼此劣优君试评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约吕徐二友游净慈二首 其一","author":"陈造","text":"芒鞋明日踏晴沙，肯学渠侬走狭斜。\n天井巷前休倦足，暗门城外把煎茶。\n暂同佛屋僧庖饭，徐访姚黄魏紫花。\n要及钱唐尚留钥，共揄吟袂缓归家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约徐南卿出游","author":"陈造","text":"古寺周围锦树窠，清湖演漾曲尘波。\n偷闲已计三餐反，败兴其如一雨何。\n政复小孤鸥鹭约，未妨来校鲁鱼讹。\n春光尚有三之一，徐办苏堤一再过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行都","author":"陈造","text":"露冷河倾斗柄低，望仙桥外独归时。\n风梳御柳娟娟静，月度觚棱故故迟。\n几处清歌留客醉，谁家长笛倚楼吹。\n太平喜乐朝仍暮，帝力何曾尔辈知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行都夜归","author":"陈造","text":"灯火通衢苦未稀，望仙桥外独归时。\n风梳御柳娟娟净，月傍觚棱故故迟。\n隐地轮蹄忘夜旦，几家楼閤不金丝。\n时平睿泽天无外，帝力何曾尔辈知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西林访铦师","author":"陈造","text":"天将宿雨净春空，却著湖山鼓吹中。\n载酒言辞藉花伴，运斤来看斲泥工。\n前身师定参寥子，拙宦吾今张长公。\n俛首人间皆长物，未妨分飨北窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观山刑鹅夜归","author":"陈造","text":"巢鹊枝蜩已罢鸣，风声露气可胜清。\n人谙浅濑安然度，月隔高林未肯明。\n却乱宿云寻去路，渐因更鼓辨孤城。\n谁知岁事关心切，翻忆冲泥傍险行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观诸公射于城北书壁二首 其二","author":"陈造","text":"尘我玉蟾蜍，弦君金仆姑。\n分曹双壁立，中隽万人呼。\n壮岁功名地，从渠山泽儒。\n他年玉音问，册府起孙吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观诸公射于城北书壁二首 其一","author":"陈造","text":"旧约已汤饼，新欢仍碧香。\n小闲障日手，同憩卧云庄。\n群彦矢复沓，老夫诗在囊。\n蔬畦暝晚色，野兴为谁长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过八叠山","author":"陈造","text":"路入于平舒倦眼，襄阳佳处亦班班。\n烧香岘好思三岘，八叠山高似万山。\n喜此经行无雨阻，向来游览坐天悭。\n山灵定笑贵野鹜，默遣归求邦域间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过八叠铺问宿","author":"陈造","text":"平野俄空阔，遥山且有无。\n斜阳对扪虱，暝树忽啼乌。\n老去犹羁旅，生平颇壮图。\n田翁诧丰岁，不拟话为儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过伏龙祠","author":"陈造","text":"蜀栈荆江志未酬，两京直拟笑谭收。\n仅容孱后存酅祀，谁遣东吴解魏仇。\n制敌岂应无法正，为谋不合有谯周。\n伏龙祠上长烟霭，愤气堂堂恐未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过樊村","author":"陈造","text":"几日囚笼鸟，今朝纵壑鱼。\n空劳计迟速，凡百有乘除。\n岸势惊禽过，江声午梦馀。\n心融得新句，澄水滴铜蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别赵文卿明府","author":"陈造","text":"人品推君第一流，论文向我肯绸缪。\n日从红粉追谭笑，家置青编纪唱酬。\n转首各乘凫背去，几时同作凤城游。\n临风莫道书难寄，旅雁飞还是便邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劳农净居赠皎启二僧","author":"陈造","text":"劳农今喜复南辕，夹道扶携亦笑諠。\n县尹庶几无疾病，山人迎送耐频烦。\n芼葱汤饼聊堪饱，出瓮春醪半带浑。\n惟有为民真实意，异时陈迹付公言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陈造","text":"泛蚁醪敷且命斟，中年节物自关心。\n风前千柳竞春态，烟际一鸠啼晏阴。\n急景绝怜添鬓雪，芳辰犹阻盍朋簪。\n年时醉藉梨花地，回首鸥盟可得寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陈造","text":"江漾晨光入县门，楼斜晚影到渔村。\n海声不为无风静，山色居常带雾昏。\n问俗即今防愒日，来时抚事错销魂。\n浮生寄寓君恩重，未觉天涯异故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陈造","text":"平昔功名念，如今冷似灰。\n藏书堪乐死，望岁待归来。\n小宅依城筑，虚檐枕水开。\n溪翁诗社侣，有酒剩追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陈造","text":"侧径苔竹润，短篱鸡鹜喧。\n小停障日手，聊憩卧云村。\n绿影乌皮几，新醅老瓦盆。\n平生农圃计，重与野人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县西","author":"陈造","text":"一径斜穿荦确行，身闲尤觉马蹄轻。\n坡头嘉树千幢立，烟际长江匹练横。\n茶鼓适敲灵鹫院，夕阳欲压赭圻城。\n一春簿领沈迷里，野鸟山花眼最明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县圃酴醾","author":"陈造","text":"北园红紫已蜚尘，始放幽亭烂熳春。\n叠翠影低珠幰重，洗妆人倦玉容真。\n蔷薇清露疑分派，茉莉评香且外臣。\n领略浓芳须好语，即令袖手恐花嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿皇圣帝挽章三首 其三","author":"陈造","text":"慈俭遵先志，刚明肖上乾。\n题期千一遇，跻治五三前。\n他日山藏壑，终天泽漏泉。\n稽山穿望眼，松影五云连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿皇圣帝挽章三首 其二","author":"陈造","text":"受授光尧禹，规摹陋汉唐。\n皇图开寿域，国步坦康庄。\n检玉方慈范，乘云忽帝乡。\n华夷均孺慕，矫首涕滂浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿皇圣帝挽章三首 其一","author":"陈造","text":"孝俭超千古，初终秉一心。\n时前未央酒，每惜露台金。\n遗范天同久，湛恩海与深。\n攀摧恸夷夏，悲泪作秋霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张丞再有诗次韵","author":"陈造","text":"仰高排奡玩清圆，学力卑摧旧判年。\n后进或夸金掷地，前修犹是斗横天。\n晚规省语安衰病，暇复分题搅醉眠。\n祇有君诗追古作，未忘缃素遣儿传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李粹伯挽章二首 其二","author":"陈造","text":"病酒漳滨久，传闻信复疑。\n为郎真地下，哭友漫天涯。\n雨绋何由挽，风松想助悲。\n自今思有道，时展蔡邕碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李粹伯挽章二首 其一","author":"陈造","text":"今代论时杰，如公未易量。\n冰壶钟器质，绣段粲文章。\n遂郁鸾台望，俄成马鬣藏。\n忠贤如此尔，天意竟茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜母","author":"陈造","text":"杜母遗芳岂远求，田功谁比此邦优。\n麦疄桑陇疑淮左，近水遥山似秀州。\n楼识景疏知俗美，亭因思孟各风流。\n我来眷眷淳厖处，比屋嬉嬉路载讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨侍郎召饭再用韵","author":"陈造","text":"升沉渠敢话齐年，妙句推褒辈行然。\n高燕况叨琼作醴，凡骀底称玉为鞭。\n歌终画扇犹遮面，舞困攲花半压肩。\n此去隽游萦客梦，梦陪笙鹤下琼田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨家会小坐","author":"陈造","text":"断蜺收尽有云屯，月映苍茫山敛昏。\n白露素空犹暑意，碧林危叶已秋痕。\n鸟乌定为何人乐，络纬惟能竟夕喧。\n老阅流光易悽惋，惜无佳客共清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其二","author":"陈造","text":"杨园骞绝岭，万象赴窥临。\n坐久岚霏润，来时翠碧深。\n莺花自佳处，鱼鼓亦丛林。\n谁在飞埃外，芸芸付陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其三","author":"陈造","text":"山寺曾题竹，寻诗记所临。\n缘云俯空旷，扪石探幽深。\n倦鸟低平野，蔫花下碧林。\n沙头催唤渡，空水远沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其一","author":"陈造","text":"载酒幽寻地，乘闲得再临。\n丽黄啼晓霁，魏紫笑春深。\n抚事挥犀管，他时梦鹤林。\n心期更阒寂，物理付升沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其八","author":"陈造","text":"诗课逭离索，萧窗谁肯临。\n语方逢众怒，自诧用功深。\n未议辞穷鬼，才堪补笑林。\n旧交多册府，肯信有湮沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其七","author":"陈造","text":"西湖千顷画，政用好诗临。\n鉴揭雾解駮，屏纡云浅深。\n钿车随宝马，红舫度青林。\n归去开囊锦，君先炷水沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其四","author":"陈造","text":"水月春犹浅，携壶记此临。\n云烟澹闲寂，鱼鸟媚清深。\n堤路俄人海，侯家或肉林。\n高楼下金弹，帘影眇深沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其五","author":"陈造","text":"徐子学诗苦，砚池宁暂临。\n课功初赑屃，著语遽精深。\n更积岁月力，傥陪英俊林。\n人生才业地，渠辈分平沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步西湖次韵徐南卿 其六","author":"陈造","text":"徐郎小隐处，爱我许迂临。\n多遌话岁晚，言归忘夜深。\n祛愁倚诗酒，结伴卜山林。\n更喜檀栾旧，风烟挺绿沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汪叔量白酒","author":"陈造","text":"妙诀何年受异人，酿成珍齐祇逡巡。\n端忧肯念霜髯客，取醉时分玉色春。\n篘处想如君德厚，饮来浑类我诗醇。\n借书问字渠须计，走马鸣鞭莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"言怀二首 其二","author":"陈造","text":"自是三生贺季真，亟应收拾水云身。\n蜚凫吏隐聊同俗，饭犊生涯且耐贫。\n林壑风烟当未慭，利名缰锁听横陈。\n世间静者犹张邴，老境婆娑定笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"言怀二首 其一","author":"陈造","text":"此身与世分相违，可是平生不见几。\n知己方占白鸡梦，寸心已傍碧山飞。\n周旋觞咏须三益，斟酌行藏欠一归。\n甓社湖西隐君子，为翁应扫钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谷城道中","author":"陈造","text":"何许珠襟绣袂娘，额黄胸粉自新妆。\n野芳贪折髻丫重，蝴蝶乱随裙幅香。\n缓唱采菱空答响，小留挑菜翠盈筐。\n汉风未许休乔木，行客相逢莫漫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近榆亭 其七","author":"陈造","text":"少日接为构，无何了桑榆。\n邀食有馀地，何事须千奴。\n此亭与此木，到眼聊为娱。\n五诗信睡语，定博君卢胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还王编修诗卷","author":"陈造","text":"奕奕长篇间短吟，子綦天籁伯牙琴。\n几人不溺西昆体，老我亲聆正始音。\n得宝浑惊探骊颔，换金当复售鸡林。\n还诗正恐非子助，昼易忘饥夜易深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适二首 其二","author":"陈造","text":"丁年故纸枉埋头，老去时名底用求。\n得句盖尝身被谤，屏书姑免眼为仇。\n关门工作橐驼坐，阅世已冥鹏鴳游。\n槁木山麋真适适，从来里舍议家丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲适二首 其一","author":"陈造","text":"人间火烈更风蜚，笑杀幽人咏桧枝。\n贪赴敌场争腐鼠，宁知造物玩痴儿。\n百年扰扰玄驹聚，万化悠悠野马驰。\n老子床头但周易，尚容隐几耐支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒题","author":"陈造","text":"自笑冠裳裹沐猴，只今江海信虚舟。\n断无贝阙珠宫梦，好在黄鸡紫蟹秋。\n诗外尽为闲日月，人间分占素公侯。\n政须鸥鹭供青眼，未厌山林映白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮客","author":"陈造","text":"暑气凭秋已自消，可能枯策伴良宵。\n试开玉友招诗客，共吸金波对舞腰。\n人近笙歌堪耐老，天非风月定无聊。\n簿书正使无闲暇，卜夜时须慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮殖轩","author":"陈造","text":"病骨今朝觉倍轻，云天昨夜已全晴。\n烂游花木欣荣处，剩喜风烟指顾生。\n春草池塘频入梦，夜窗灯火会寻盟。\n怅然又与禽鱼别，波影沉堤晚照明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口呈张閤学 其二","author":"陈造","text":"色辞他日慰凄凉，别去吴山楚水长。\n蚁国槐安消几梦，鹤归华表恐千霜。\n安排久餍冷官饮，软语重登君子堂。\n所惜将迎无暇日，妨人诗律悟濠梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口呈张閤学 其一","author":"陈造","text":"归怀未用话南园，卧治于今又北门。\n但息儿啼宽上意，小稽霆击取中原。\n虎头锐视非无种，狮子当觞且勿喧。\n更恐谭公家世事，断无宣劝定惊魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到任交权州事筵致语口号","author":"陈造","text":"假印侯封付继承，教条久已洽山城。\n政成何异徵黄霸，日接宁惟拜水衡。\n春酒入杯红浪涨，晚花荐座靓妆明。\n良辰便合同沉醉，且置阳关叠后声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张秀才","author":"陈造","text":"山川向晚点尘无，忽讶筛琼屑玉铺。\n巧与梅花争便旋，试将姑射比肌肤。\n破寒春酒何曾酽，荐箸穷鸠不料臞。\n陵藉东君从作意，未妨芽甲暗昭苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]