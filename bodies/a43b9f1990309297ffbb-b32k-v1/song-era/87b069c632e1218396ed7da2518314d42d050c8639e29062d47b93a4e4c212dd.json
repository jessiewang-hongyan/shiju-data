e":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曹泰宇居士三首 其三","author":"陈著","text":"匆匆相聚处，未足满平生。\n镫雨对眠梦，花晴携话行。\n前盟空在耳，外哭若为情。\n已矣不可作，高山孤月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曹泰宇居士三首 其二","author":"陈著","text":"滔滔彼居士，谁得似君真。\n盍驻香山社，俄抛病室身。\n首邱存故我，手泽付何人。\n此理本来悟，浮生一窖尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曹泰宇居士三首 其一","author":"陈著","text":"忠义垂青脉，癯然独饭蔬。\n生涯一身寄，禅学九经馀。\n有教宁分类，逢人只借书。\n世方餍粱肉，视此愧何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄祖勉三首 其三","author":"陈著","text":"夙是通家契，姻盟又此时。\n相依百罹世，多活几年期。\n辰龙竟归梦，子书谁续为。\n九京不可作，乔梓北风悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄祖勉三首 其二","author":"陈著","text":"平生不行怪，流俗自难同。\n原明无仕志，公休有父风。\n肯堂劳未艾，反席寿俄终。\n谁料生刍奠，今年又乃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄祖勉三首 其一","author":"陈著","text":"世远太和散，儒门有若人。\n沈潜勤汲古，澹静肯妍春。\n识到寡轻语，触来无量颦。\n渊乎莫澄挠，叔度乃其伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄提举震三章 其三","author":"陈著","text":"当年时事谁，咄咄赋归与。\n同是无枝鹊，危如游釜鱼。\n偷生盟世好，访远记山居。\n已矣向谁恸，儿孙书满庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄提举震三章 其二","author":"陈著","text":"文弊莫如今，独存师古心。\n汲深六经海，茹实百家林。\n公有传贤笔，私无谀墓金。\n晚年北山北，谁识醒中吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄提举震三章 其一","author":"陈著","text":"江山古四明，独立表平生。\n敏处经纶密，癯中气局宏。\n鸿毛看势利，虎口见功名。\n麾节那能究，东南天已倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽舒亦山少母邹氏","author":"陈著","text":"我与亦山连，因闻少母贤。\n顺柔知自分，勤检乐吾便。\n心积儿孙福，家修香火缘。\n平生庶无憾，此去坐青莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽董监镇","author":"陈著","text":"宿善有君□，幽铭岂溢言。\n何妨儒鹖弁，自可客龙门。\n瑞竹松根见，丛编手泽存。\n寿终无一憾，更是好儿孙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽蒋质甫","author":"陈著","text":"谁能传耆旧，善誉在乡关。\n教子籯金外，和家棣萼閒。\n死心多佛悟，生世半诗閒。\n逝矣夫何憾，逍遥玉女山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽樊君修","author":"陈著","text":"忆昨会山中，危时苦话同。\n老枝期共雪，乔木虑摧风。\n弟有文铭竁，儿能礼送终。\n九京无可憾，后死愧衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浦城外界梨岭西水碓头阻雪三日","author":"陈著","text":"小小篮舆出远林，南来长苦路崎嵚。\n一千里外乡山杳，十二月中风雪深。\n清夜到家惟有梦，少年触事易酸心。\n须知行止元非我，阴六阳三古到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留西山","author":"陈著","text":"老惫无如汗枕何，起看玉宇泻银河。\n残山剩水凄凉甚，明月清风感怆多。\n无计闭门遮外事，真成开眼梦南柯。\n坐来不觉东方白，又是馀生一夜过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留西山","author":"陈著","text":"西崦已非旧，庵居犹自妍。\n树头擎月直，山腹转风圆。\n閒坐忙尘外，清谈浊酒边。\n悠悠一俯仰，今日是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留范景山","author":"陈著","text":"满天风雨作新正，下访劳君一日程。\n长揖不交随俗礼，苦言惟有隔年情。\n镫生晕处醒相对，犬吠声中心自惊。\n人事难齐时事险，聚头时节且迟行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留范景山家闻夜警有作","author":"陈著","text":"镫窗坐无寐，吾亦自怜吾。\n活在虎狼窟，老犹风雨途。\n世情多短气，心事一长吁。\n幸有秋成好，仍闻夜警呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留前人处有感","author":"陈著","text":"友婿从来义断金，旧春一别到如今。\n琴帏绝奏香镫冷，花圃犹荒风雨深。\n三夜书窗同话古，十年人事百伤心。\n杜鹃只管催归去，不道□行有苦吟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起","author":"陈著","text":"西风唤起眼中仙，竹榻饶凉不爱眠。\n数树秋声窗著雨，一帘山影屋浮烟。\n案头古帖无完纸，壁上焦琴不具弦。\n小摘畦蔬炊脱粟，与妻閒话孟光贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]