[{"title":"次韵晦之沿牒楚泗二州","author":"彭汝砺","text":"鹢首争先鸟翼飞，宦游容易即天涯。\n渐生世事无由尽，已去年华不易追。\n芍药遂输淮上乐，樱桃终念水边期。\n雨馀亭外山争出，几日相看一酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦吟","author":"彭汝砺","text":"苦吟遂见诗锋锐，独乐宁思饮社豪。\n别去性情生淡泊，老来风致长清高。\n纷纷行李君休叹，琐琐乘田吾正劳。\n争似扁舟碧江上，几回风物入秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚风","author":"彭汝砺","text":"南北东西万里通，往来长与水无穷。\n役心一日空隋力，馀泽千年谢禹功。\n满道柳阴低翠幄，夹堤桥影卧长虹。\n乐游不及先生快，坐看千航起晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四方","author":"彭汝砺","text":"四方难缀游人足，万里无嗟客子蓬。\n红满桃花生细浪，白翻蘋叶起清风。\n路当吴楚尘相接，源出淮夷势未穷。\n闻说夜吟清不尽，月明如近水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中寄妻兄宁文渊","author":"彭汝砺","text":"百年流转寄风波，老态欺人病更多。\n赖有子能知管仲，即无人可向维摩。\n悠悠世味祇如此，扰扰人生能几何。\n南北有时归计就，考槃终欲共山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晦之所感","author":"彭汝砺","text":"万物初还白帝秋，新寒苒苒上衣裘。\n红泥烂醉须千日，皓发悲吟漫四愁。\n气挹风云诗易取，分投胶漆意难酬。\n簿书久废游从乐，最负江山翠满楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送济叔兄","author":"彭汝砺","text":"风起青蘋去鹢催，江山无路笑言陪。\n泪生病眼朝千里，愁入枯肠夜九回。\n秋水忍看鸿独宿，春风好与燕俱来。\n别期重有文章约，老稚应须眼为开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送樊秀才召倪先生","author":"彭汝砺","text":"群言分散寄遗经，天乞吾侪照未明。\n犹惜是非迷后世，旁求规矩遗诸生。\n骐驎始信能千里，雕鹗终须看一鸣。\n杖屦从容问孤迹，为言心寄海边城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治平谅闇元夕 其一","author":"彭汝砺","text":"上元无乐送长宵，泪洒城阳泣帝尧。\n云障月华寒淡薄，风吹雨点细飘摇。\n物随世事生悽怆，天与人心长寂寥。\n不用灯花斗光景，火炉诗笔慰无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治平谅闇元夕 其二","author":"彭汝砺","text":"仙乐谁家奏管箫，异香到处合椒聊。\n风生雨后声悲惨，月在云间影动摇。\n幽径小溪春寂寂，淡灯寒烛夜寥寥。\n香焚敢效封人意，睿算年年祝帝尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄济叔兄长","author":"彭汝砺","text":"东南路径走江淮，万里波声日夜回。\n流水会将孤梦去，游鳞不寄尺书来。\n风吹云影东西散，雨点花枝在处开。\n节物伤人心总碎，一春归兴满兰陔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次致政张大夫韵二首 其一","author":"彭汝砺","text":"石城山水有清音，贾堑烟萝路更深。\n松竹门阑初作径，蒲荷池沼旧成林。\n騑騑出适穷周道，汩汩归休傍汉阴。\n莫诧大夫能作赋，但逢故老数挥金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次致政张大夫韵二首 其二","author":"彭汝砺","text":"李郭曾同溪上船，途人指点作神仙。\n松篁老长芰荷密，凫雁飞浮鸂鶒前。\n霖雨未终岩野地，阳春方擅郢中天。\n文章不敢兰亭比，翰墨才能记岁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宴亭一首","author":"彭汝砺","text":"未得从君醉宴亭，坐无酒意正醒醒。\n云飞野壁春心远，蝶误花枝昼梦惊。\n草履踏泥寻曲径，纱衣冒雨上重城。\n金丝不厌幽闺地，时向高风叶一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇甫乞诗为赠因次其韵","author":"彭汝砺","text":"忆昔丹书下粉闱，诸公接武上瑶池。\n势淩雕鹗双鸿翼，香满蟾蜍一桂枝。\n议论所存无赘学，声华此去有真知。\n风松无限溪山乐，时倩秋风寄数诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"合肥府学中赓诸公韵和正寺翔甫总翠亭","author":"彭汝砺","text":"危亭缥缈压城端，总拾澄虚入画栏。\n地势西连金斗峻，山容东际湫湖寒。\n行瞻日月光华近，坐觉乾坤器度宽。\n闻说南州画工在，可能收作一屏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济叔灯花","author":"彭汝砺","text":"灯花一点照花枝，今夕相看孰是非。\n冷艳几时开密室，春光半夜到重闱。\n稚儿戏蹙寒心落，羁妇争持喜信归。\n寄语帘风莫催促，冷吟赢得看芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏诗 其一","author":"彭汝砺","text":"诗轴亲题乞一寮，清心洗濯渴心焦。\n云移星月来幽隐，风引英茎下寂寥。\n肝胆尘生知几日，齿牙病起自今朝。\n疏愚强笑为生计，不识鳌宫路径遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏诗 其二","author":"彭汝砺","text":"朔风吹雪满天涯，寂寂朝云冷万家。\n试步城头望坊巷，玉枝无处认梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦旱和俞都官","author":"彭汝砺","text":"焚烧纵炎日，长养误薰风。\n责己君临厚，劳心县宰忠。\n十州饥馑后，万里郁陶中。\n欲寄精诚祷，天心或可通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上留守侍读生辰","author":"彭汝砺","text":"素节于今杰，青春此日生。\n地还坤德重，天给露华清。\n鸿鹄飞昭旷，骐驎瑞太平。\n云浮朱槛细，星入画图明。\n簪绂师先进，旒綖望老成。\n千龄逢盛际，万里起修程。\n客献南山颂，人期北户荣。\n学高才称副，仁厚福兼并。\n香荐芝兰秀，诗言犬马诚。\n祝公比松柏，早晚席台衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日独登城上台感怀寄兄长 其一","author":"彭汝砺","text":"九日独登城上台，南山望尽祇尘埃。\n黄华虽富纷纷菊，绿蚁谁同滟滟杯。\n时节独催双鬓雪，利名还见此心灰。\n池阳星子多朋旧，能有音书万里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日独登城上台感怀寄兄长 其二","author":"彭汝砺","text":"孤城幽谷晚烟重，事绪无过与此同。\n寒夜独吟风静后，扁舟应宿月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日独登城上台感怀寄兄长 其三","author":"彭汝砺","text":"秋来常苦客飘蓬，身羡归鸿飞复东。\n欲问江南是何处，乱山扰扰自无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和应诏吟","author":"彭汝砺","text":"又得华笺是浣溪，短窗翰墨自光辉。\n寒梅不动情相炤，幽鸟无声意欲飞。\n数四恩嘉成海渎，百千文字粲珠玑。\n风花未称相望意，特为君王述万机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋风","author":"彭汝砺","text":"风战江湖飞断梗，露零霄汉听征鸿。\n身虽流俗志万里，昔是少年今老翁。\n双眼久因尘事黑，病颜今为酒樽红。\n夜深胡蝶归魂梦，飞尽蓬瀛岛屿中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山林","author":"彭汝砺","text":"鹤瘦松枯不自禁，穷愁千万欲相侵。\n山林谁识谢公意，风月独高梁甫吟。\n行视水痕嗟未息，静看云影爱无心。\n懒随尘土趋时态，欲就丝桐丐古音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"船中见庐山","author":"彭汝砺","text":"翠色苍茫杳蔼间，船人指点是庐山。\n浮云作意深藏护，未许行人取次看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩歌","author":"彭汝砺","text":"歌尽绿洲千古意，陶然初到性情真。\n试临华岳题诗笔，欲走沧浪买钓纶。\n苔润一瓢贫气味，草荒三径久埃尘。\n我心自有青云在，安得羁留浊水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壮心","author":"彭汝砺","text":"锐气销磨一水平，壮心非欲避功名。\n穷通有属都天意，忧乐无端自物情。\n拂地延留山月影，褰帘收拾水风声。\n清吟又得松陵侣，谁惜花前酒重倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大笑","author":"彭汝砺","text":"大笑花开倾屈卮，狂来不惜典春衣。\n飘浮世态知惟我，淡泊天真得者稀。\n云汉露寒沾玉液，江天风静拂金徽。\n樽罍易竭情无尽，海岳苍茫一梦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步入","author":"彭汝砺","text":"步入浮游淡泊中，红尘无计到心胸。\n微之散落诗千首，白也飘零酒百钟。\n天地寂寥窥夜月，风霜悲惨看春松。\n清晨试引青铜照，一点朱丹入病容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师言","author":"彭汝砺","text":"尝就师言卜所从，万为都起至诚功。\n天枢亹亹时长北，溪水悠悠夜亦东。\n陋迹已生千古后，微怀方醉六经中。\n竹林交友多才力，应念南轩一病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县舍小饮因就伯逢求馔具","author":"彭汝砺","text":"霜凋老木青枫碎，雪尽空山夜月新。\n收拾村醪欲歌笑，咨嗟破突久埃尘。\n分为白屋穷宾客，回眷青云旧主人。\n天地苦寒今有备，醉横诗笔觉精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"累承见酬因谢之","author":"彭汝砺","text":"千夫拱默看文阵，百战纵横及醉乡。\n齐晋亦当忧鲁弱，韩吴终是怯秦强。\n威容敌国矜豪迈，气压羸兵急遁藏。\n他日相期坐帷幄，为君穷力破戎羌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"匪躬先之桐庐因作诗送之","author":"彭汝砺","text":"男子生当自树立，莫令寂默终无名。\n膏粱孰与文章乐，锦绣不如仁义荣。\n予病淹留岂得已，子今閒暇固当行。\n竹林交契知安否，议论从容为寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晦之楚泗道中","author":"彭汝砺","text":"白日红尘身世劳，羡君诗兴自陶陶。\n敢因锦绣邀青玉，漫把瑶琼报木桃。\n冰雪正寒心始见，骐驎已老气终豪。\n一言起拜先生辱，羞愧无才及楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮雨","author":"彭汝砺","text":"暮雨忽随江上舟，寒风彷佛转清秋。\n兴随烟月成千首，醉忤莺花长四愁。\n不系可怜波上叶，忘机应喜海边鸥。\n一声画角吹魂梦，散落淮天晓未收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扁舟","author":"彭汝砺","text":"扁舟满眼送波涛，一夜霜华上鬓毛。\n雨脚已收朝日薄，潮头忽上晓风高。\n江山须信游人乐，簿领还知俗吏劳。\n见说指挥功利白，馀才今见解牛刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲寄","author":"彭汝砺","text":"欲寄予声无使还，平安始见一书间。\n偶从淝水经淮水，应对龟山忆蜀山。\n浮世并知俱物役，利途曾复见人闲。\n每言庾信愁难解，果道安仁鬓已斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古庙","author":"彭汝砺","text":"严严遗庙水岩幽，想像迟回物为秋。\n堂陛终须辨臣主，山河空复誓王侯。\n地全东海疑先兆，力尽淮阴意未休。\n可恨游人满门下，不将敧器与君谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楚野","author":"彭汝砺","text":"楚野云寒山点缀，淮天波尽水徘徊。\n古今寥廓归谈笑，气象纵横费剪裁。\n愁日远随双锦翼，离情满寄百金杯。\n清风正引城头望，淮上车音几日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘景文见寄","author":"彭汝砺","text":"万里飘蓬失旧游，汴堤别去又三秋。\n朔风怅望心先去，夜月相瞻影独留。\n偶得篇章还自失，喜因文字会忘忧。\n几时樽俎追平昔，熟醉灵芝最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题程则之瑞墨阁","author":"彭汝砺","text":"仁宗事业望唐虞，翰墨仍兼八体书。\n长叹仙游今寂寞，不知遗迹在樵渔。\n凰鸾影落新安水，奎壁光临处士庐。\n北望昭陵云杳霭，倚栏双泪染衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将及下蔡寄仲求","author":"彭汝砺","text":"不见大夫行五年，渡淮欲见泪潺湲。\n忧怀荏苒今衰矣，仕宦迟回亦偶然。\n眼看飞云难自定，身随去鸟拟争先。\n更鞭驽马登横岭，即借长桥济大川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日同仲求登高有感","author":"彭汝砺","text":"曾侍灵芝九日觞，登高从此共凄凉。\n故乡江外烟波阔，上国云中道路长。\n世事祇催蓬鬓雪，秋风不减菊花黄。\n坐看鸿雁天涯远，甘醉茱萸盏面香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别子容","author":"彭汝砺","text":"衣衫尘土待光辉，议论渊源慰渴饥。\n鄙远尚思同旧学，疲驽常恐误真知。\n壮怀销落非前日，孤宦邅回强此时。\n万事纷纷知有在，斋心更欲问蓍龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自北归夜梦侍亲闱久之既觉感而成诗","author":"彭汝砺","text":"中宵八九梦亲闱，笑逐儿童戏綵衣。\n起觉片身犹逆旅，化为双泪落征衣。\n祇嗟轻逐孤蓬转，安得争先去鸟飞。\n薄宦自伤无以养，亦知从昔戒脂韦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兄弟约芝山共学未暇辱以诗督之因次元韵","author":"彭汝砺","text":"弟兄相寄玉为音，洗尽尘埃一寸心。\n欲以蚊虻看势利，能将珠璧现光阴。\n雅游潇洒知难废，故约迟留惜未寻。\n北望灵芝山在处，暮云回合碧沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读书","author":"彭汝砺","text":"读书虽苦亦何知，仕宦纷纷强此时。\n旧学望君真短短，新诗爱我已枝枝。\n清生野槛晨风远，暖度山窗昼日迟。\n出处从今能自卜，不庸蓍蔡已无疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日仲永游荐福先秋亭晚过芝山他日有坐客献诗者仲永见率同和","author":"彭汝砺","text":"行背林梢转水湾，乐游与物共安闲。\n旌旗影散烟波上，金竹声流岛屿间。\n宿雨未乾花焰焰，晨风不动鸟关关。\n久晴见说春尤好，何日重来访旧山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邹秘丞广汉赴御史","author":"彭汝砺","text":"清论从来满士林，君王今日为虚襟。\n谋维已熟言难废，势位虽隆望亦深。\n可否谨须要至理，穷通知不异丹心。\n北风会到江南路，日上城头听好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广汉言事得陵州仁寿县将以诗迎之","author":"彭汝砺","text":"昨日除书下禁林，诏言明白洒宸襟。\n诚留魏阙初非浅，望系朝廷晚更深。\n议论自关天下计，功名非系古人心。\n秋风行李归来未，旦暮虚怀迟玉音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张同年德父移松杉石楠海棠各赋一首 其一","author":"彭汝砺","text":"孝思知欲寄无穷，手插松枝宅兆东。\n始听灵根来涧底，会看高节入云中。\n纷纷泪滴枝头露，扰扰愁随叶上风。\n老尽雪霜终不变，亦知因此议穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张同年德父移松杉石楠海棠各赋一首 其二","author":"彭汝砺","text":"张子纷纷非世情，栽杉为径护坟茔。\n烟冥接叶愁俱满，露落低枝涕泗横。\n直干森森才满握，微阴细细欲盈城。\n栽培会与风霜老，爱护无容蝼蚁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张同年德父移松杉石楠海棠各赋一首 其三","author":"彭汝砺","text":"石楠梭木照春山，颜色纷纷乱碧丹。\n剩叶如云散幽冢，清阴为盖覆灵坛。\n沾濡细雨生秋色，摇撼惊风长夜寒。\n应并孤松长共老，好栽慈竹与同看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张同年德父移松杉石楠海棠各赋一首 其四","author":"彭汝砺","text":"见说无因寄孝心，自移花种碧山岑。\n栽培蒙密春先暖，想像迟回日为阴。\n多恨祇悲新雨露，遗灵如得旧园林。\n黄鹂不会人情思，亦向枝头送好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄学芝山正叔寄诗有想叹之意次元韵","author":"彭汝砺","text":"想望独登城上台，重云不见首勤回。\n久分笑语心几塞，忽得诗书眼为开。\n草褐岸巾随鹿豕，佳山野水外尘埃。\n公名方与风霆远，未可窥余寂寞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗寄兄长并示十二十四舍弟","author":"彭汝砺","text":"去年马走途中雪，今日舟行湖上风。\n吾分自天俱有定，此忧如水自无穷。\n谁知云汉双飞雁，自笑江湖一断蓬。\n祇有綵衣情最乐，复嗟不与弟兄同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏六月公济与弟六人游安国竹园某有诗","author":"彭汝砺","text":"万竹纷纷光欲流，花亭况在竹林幽。\n阴藏绝径为深谷，风起炎天见早秋。\n此地遂为千亩胜，吾侪非止七贤游。\n清凉可爱无朝夕，无问昏鸦故未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚行竹林兄弟相率赋诗 其一","author":"彭汝砺","text":"苒苒秋风吹我衣，留连清胜夜忘归。\n眉横云外新蟾上，雪落林梢白鹭飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚行竹林兄弟相率赋诗 其二","author":"彭汝砺","text":"碧竹侵云一万竿，挟书时此共盘桓。\n湘沅见说官期逼，预惜朋游别去难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某在合肥尝梦同子直在横川旧游递中有诗往还子直见招因用前韵来寄","author":"彭汝砺","text":"春风把酒共溪边，南北纷纷遂五年。\n绿绶终朝寄尘俗，青云昨夜梦神仙。\n诗多老格知难继，易外新闻念未传。\n彷佛异时佳句在，吾游不敢负横川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴水呈祖道","author":"彭汝砺","text":"万事无庸轻是非，扁舟吾与子同归。\n不知心逐征云远，安得身先去鸟飞。\n月入江湖生夜色，风吹花木长春晖。\n鬓毛每笑多新雪，衣带频惊缓旧围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]