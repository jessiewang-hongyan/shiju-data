[{"title":"琴书斋","author":"顾逢","text":"不道邺侯家，有人如伯牙。\n七弦真得趣，万卷足生涯。\n石鼎时添火，铜瓶日换花。\n高山流水罢，笔下走龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登姑苏怀古","author":"顾逢","text":"高台登眺处，凉思爽衰颜。\n只此阑干外，不知多少山。\n龙收残雨去，鹤带断云还。\n一片兴亡恨，越来溪上閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落叶","author":"顾逢","text":"秋林霜后红，恰与染来同。\n风雨一番过，亭台几树空。\n乱飘窗纸上，流出水沟中。\n待看春三月，浓阴万绿丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花","author":"顾逢","text":"树底飞红雨，园林一望空。\n寂寥春去路，狼籍晓来风。\n乱影斜阳里，馀香流水中。\n可怜衰谢日，不与乍开同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢叶诚斋金丹","author":"顾逢","text":"往岁因痰壅，几为病废人。\n金丹如不服，粉骨已成尘。\n去死仅一线，更生又五春。\n再深诗里债，笔砚日相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢徐容斋见访","author":"顾逢","text":"问病来车马，穷檐非所宜。\n拘挛眠枕席，扶策唤妻儿。\n鹊信今朝报，灯花昨夜知。\n从前潘阆巷，无此宠荣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雁影","author":"顾逢","text":"万里衡阳别，翱翔背夕晖。\n数行天外过，一片水中飞。\n无迹留沙渚，有声过钓矶。\n回头还自顾，上下带云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷峰寺听琴","author":"顾逢","text":"尽日山窗下，松风细细吹。\n喜于同坐处，乐在听琴时。\n幽几静相对，斜阳过不知。\n江湖襟谊好，临别问来期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧涧同饮丽景楼分韵得花字","author":"顾逢","text":"醉倚歌楼上，归来帽欲斜。\n山衔半规日，云间一棱霞。\n砌雪胶庭草，檐冰坠瓦花。\n明朝重有约，同访赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"慧山","author":"顾逢","text":"空山尘不到，白昼定僧禅。\n龙口一泓水，人间第二泉。\n殿高云气湿，屋断树阴连。\n张祜曾题品，唐碑尚俨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居图","author":"顾逢","text":"展卷拟曾到，柴门非一湾。\n抱琴随白鹤，坐石看青山。\n隐者有馀乐，贵人无此閒。\n更须添数笔，著我在其间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方家峪刘寺山门","author":"顾逢","text":"洒墨起云端，神威耸众观。\n直疑鲜甲动，相对骨毛寒。\n瞠目真如活，腾空似不难。\n传闻风雨夜，雷电绕阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题风雨楼","author":"顾逢","text":"湖上晴看好，雨中犹更奇。\n无穷凭槛趣，正是捲帘时。\n鸥鹭飞相失，山林晚不知。\n烟云多变态，难画亦难诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题厉竹溪诗稿","author":"顾逢","text":"觅句如禅定，君应入悟门。\n淡中真有味，空处妙难言。\n下字去花草，读书为本根。\n莫疑知者少，清气入乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题可耕渔处","author":"顾逢","text":"自得田园趣，临溪屋数椽。\n最堪犁钓处，只在水云边。\n细雨归庄犊，斜阳晒网船。\n烹鲜供一饱，垂老正相便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题直上天津","author":"顾逢","text":"欲向银河去，唐家有画船。\n更无风浪险，竟到斗牛边。\n笑傲琼楼上，歌吟玉宇前。\n乘槎今有便，不必羡张骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题诗境楼","author":"顾逢","text":"白昼钩帘坐，湖山静里看。\n分明吟世界，尽在此阑干。\n妙处写不就，题来句转难。\n几回风雪际，遥忆灞桥寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵蒙斋子山居诗集","author":"顾逢","text":"用书全不觉，地步有馀宽。\n如此自然句，还须识者观。\n空中圆未易，妙处到尤难。\n草圣更奇特，龙蛇走一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徐容斋先生爱兰轩","author":"顾逢","text":"入得善人室，尘凡一洗空。\n三闾心上事，九畹国香中。\n坐对清幽地，时来旎□风。\n纷纷桃与李，不与此花同。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题善权寺","author":"顾逢","text":"英台修读地，旧刻字犹存。\n一阁出霄汉，万松连寺门。\n洞深云气冷，池浅鹿行潭。\n山下流来水，风雷日夜喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"儒巾","author":"顾逢","text":"儒冠同昔日，吾道未尝衰。\n毕竟犹存古，从教不入时。\n簪花何足逊，漉酒尚堪为。\n懒把青铜照，伤心两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠广淳破衣 其一","author":"顾逢","text":"包笠皆为累，游方仅此身。\n从教粗褐碎，不用一丝纫。\n赴供无闲日，得钱回施人。\n生平甘忍辱，性地本来淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠广淳破衣 其二","author":"顾逢","text":"禅外亲文墨，年来更用情。\n三椽趺坐后，彻晓读书声。\n破砚雨窗润，孤灯雪屋明。\n更参诸大老，莫计万山程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠不食姑","author":"顾逢","text":"绝粒非凡术，仙丹固得存。\n一龛常瞑目，长日不开门。\n浴水无冬夏，逢人少语言。\n飞来天际鹤，时见下庭轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠天台徐秋岩","author":"顾逢","text":"马乳真堪摘，曾参日观师。\n云随笔落处，月上架来时。\n写意元非画，无声只是诗。\n寒藤吹不动，颗颗自攒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠叶肖岩","author":"顾逢","text":"笔底妙如神，传来面目真。\n便教知本相，不必问何人。\n一幅元非画，百年留此身。\n山林樵穫者，只是旧衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠四明月岩永昌上人","author":"顾逢","text":"杖锡游方外，丛林历几春。\n息心修道者，铁脊坐禅人。\n泉落岩千丈，天空月一轮。\n眼前清境界，不识世间尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠白云","author":"顾逢","text":"蒲团穿几个，性地忽然开。\n禅向静中透，诗从悟处来。\n三椽青嶂里，一榻白云堆。\n自说为僧后，浮生百念灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠吾世衍","author":"顾逢","text":"士友多交接，惟君有敬心。\n少年精古篆，诸老喜新吟。\n箫品神仙曲，琴弹山水音。\n无人知此乐，只有竹房深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠护国寺山上宏道者","author":"顾逢","text":"三十年趺坐，何曾下此山。\n忘形超物外，无梦到人间。\n窗暗月来照，门开风自关。\n虎狼情亦狎，夜夜庙前还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠林东之","author":"顾逢","text":"往年曾赴召，万里涉修途。\n乐府师长吉，名家祖老逋。\n云烟生笔砚，风月乐江湖。\n金殿朝天日，宫衣宠渥殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠僧庆云衲","author":"顾逢","text":"赴供归来后，跏趺对篆熏。\n三椽忘岁月，一衲老烟云。\n俗客无门入，闲情有砚分。\n山中高卧好，城市正纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠僧足庵","author":"顾逢","text":"幽居不可寻，高卧白云深。\n举眼皆贪者，何人有止心。\n三衣了冬夏，一钵饱山林。\n此外无他事，听松生绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠薛野鹤子继野","author":"顾逢","text":"老鹤传遗韵，君诗尽可观。\n江湖为客易，父子得名难。\n草色烟城暗，蛩声秋寺寒。\n自言乡仆至，束担又长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下竺寺堂前独坐","author":"顾逢","text":"风舞花幡万缕轻，石炉香冷一灯明。\n坐来耳目身心静，髣髴慈云礼忏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天童寺","author":"顾逢","text":"双峨聚首去年冬，知得还归太白峰。\n二十里松山色里，天晴时节一枝筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月宫沙戏","author":"顾逢","text":"兔舂金臼药，幻出广寒宫。\n时听数声响，皆归一转功。\n云霄大境界，几案小屏风。\n何独沙为戏，人间万事同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓觉非寓舍即事","author":"顾逢","text":"老屋幽深静掩门，四围多有古碑存。\n庭前黄叶无人扫，留得秋风在树根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石湖山居 其一","author":"顾逢","text":"湖光终日对，且喜绝尘纷。\n时事年来别，山中人不闻。\n霜林晴滴雨，寒井晚云生。\n门掩松风里，知心有范君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西瓜","author":"顾逢","text":"多自淮乡得，天然碧玉团。\n破来肌体瑩，嚼处齿牙寒。\n清敌炎威退，凉生酒量宽。\n东门无此种，雪片簇冰盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访明月堂","author":"顾逢","text":"山路亦迢迢，殷勤访久要。\n三门虽未入，一仆已相邀。\n枕臂眠平石，扶筇过险桥。\n诗翁归步醉，空费酒旗招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄卢梅岩","author":"顾逢","text":"梅边灯下别，又见石榴开。\n人入多番梦，书无一字来。\n背风花下落，冲雨燕双回。\n却忆中秋夜，杯馀醉讲台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄四明干月庭厉二友","author":"顾逢","text":"无言独倚楼，故人在心头。\n几作宵中梦，多生别后愁。\n溪声疏竹下，月色一庭秋。\n此景皆诗料，何时共唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵碧澜 其一","author":"顾逢","text":"窗下看书坐，挑灯庭欲分。\n秋声鸣处远，落叶静中闻。\n庭月一方雪，炉香数朵云。\n寄来诗在几，读著又思君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢徐容斋送米","author":"顾逢","text":"米囊入户甑无尘，一室欢声四壁春。\n高廪如山堆积者，肯思白发老人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墙外见梅","author":"顾逢","text":"隔水园林剩有梅，重门扃钥少曾开。\n主翁只恐吹香出，不道花梢过屋来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题虎邱","author":"顾逢","text":"此山虽小众山尊，半近吴城半近村。\n一壑风烟龙窟宅，满堂巾盔佛儿孙。\n生公说法台空在，陆羽煎茶井不存。\n唤起幽人无限意，塔铃独语到黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠峡山胡半村","author":"顾逢","text":"四邻鸡犬地，花竹自我阴。\n去郭不多远，入山犹未深。\n林峦常在望，樵牧久知心。\n他日如全隐，深居不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落梅","author":"顾逢","text":"孤山花已老，片片受风吹。\n莫叹凋残去，曾誇烂熳时。\n香痕留宿雨，春色恋空枝。\n看取成青子，何尝生意衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史云麓先生席上赠顾梅山","author":"顾逢友","text":"五字诗名著少年，端嘉诸老喜相传。\n几回春雨堂中醉，笑拍阑干月正圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顾君际号梅山","author":"顾逢友","text":"数亩萧疏一径宽，散飞香雪遍林端。\n应思处士桥边路，吟绕横枝月影寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顾君际近集","author":"顾逢友","text":"有诏曾求魏仲先，草堂飞鹤避茶烟。\n晚营馁鬼今何限，弱冠诗名六十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御览所同顾君际检书","author":"顾逢友","text":"金锁朱门次第开，万签黄册绝尘埃。\n此中亦有先生稿，应是曾经御览来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴田园杂兴诗","author":"顾逢友","text":"一卷田园杂兴诗，世人传诵已多时。\n其中字字有来处，不是笺来不得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜游","author":"顾梦日","text":"路转歌声杳，夜深云露浓。\n美人行月下，秋水汎芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞 其二","author":"顾然","text":"山头赤日炙手热，檐底鸣泉玉击枞。\n惭愧龙公作馀戏，梦中浑认雨翻江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞 其一","author":"顾然","text":"清凉不着人间暑，三伏来游九锁山。\n箬底神丹末须问，平生宁有此时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渊明祠 其二","author":"顾禄","text":"葛巾漉酒艳流霞，长向东篱醉菊花。\n不分宋公移晋祚，只将甲子纪年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渊明祠 其一","author":"顾禄","text":"黄阁彤扉尽宋臣，归来松菊伴闲身。\n举头谁识悠然意，只有南山是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独酌","author":"顾禧","text":"江色侵枫冷，松风入暮幽。\n莫愁樽酒尽，明月在高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登吴山作","author":"顾禧","text":"紫雁高飞晓雾浓，西风峭削玉芙蓉。\n谁携谢朓惊人句，更上吴山第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日吴山","author":"顾禧","text":"第一峰头逢九日，振衣直上莫踌躇。\n丹梯苔冷仙人迹，祇树云深帝子居。\n图画天然看不厌，啸歌自得意何如。\n茱萸醉插游丝倦，雁影参差夕照馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登浮屠","author":"顾禧","text":"浮屠百尺绝花尘，一望霜林暮色匀。\n啸傲自然能远俗，步趋何必不随人。\n参军帽落嘲谁解，□□□残草作茵。\n却羡东篱陶处士，菊花犹插碧纱巾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不寐","author":"顾禧","text":"英雄不世出，竖子自成名。\n谁谀美新笔，曾怜覆楚兵。\n轻霜零病叶，急雁过寒城。\n入夜愁无似，悲笳处处声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同人看梅","author":"顾禧","text":"梅花引我入溪深，半绕青松半翠林。\n已耐岁寒成好友，还将春色作幽岑。\n苍烟踏破鞋无迹，明月挑来杖有心。\n赢得清芬盈客袖，莫愁归路暮云侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过徐稚山居","author":"顾禧","text":"曲径秋高竹影斜，多君此日淡浮华。\n笛声远落幽人泪，月色清宜孺子家。\n世事尽劳五斗米，我来常醉一园花。\n不须更读閒情赋，元亮风流自足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮谭子钦斋","author":"顾禧","text":"取次梅花放，樽前白雪楼。\n人非分洛蜀，才岂逊曹刘。\n姜桂存馀辣，芝兰忆旧游。\n文章千古事，未许卧南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林庇民保以诗见赠次韵奉答","author":"顾禧","text":"萧萧竹影閒桐阴，有客携琴慰素心。\n秋老登楼频作赋，愁深抱膝共高吟。\n招寻丛桂香初散，快读残书酒满斟。\n莫恨龙门策未报，十年声价重南金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林庇民保留宿夜话","author":"顾禧","text":"踪迹忘疏密，情怀历晦明。\n携琴时一至，倒屣辄相迎。\n枕发中郎秘，尊馀北海酲。\n浣花多胜侣，风雨话深更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊太湖寄内","author":"顾禧","text":"草草出门去，孤帆落暮烟。\n笑谈卿宛在，辛苦梦难传。\n雨礴蛟龙窟，云乘橘柚边。\n从来轻远别，此夕倍凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苧村烟雨","author":"顾禧","text":"湖南几曲石桥底，细雨濛濛暗碧溪。\n欸乃渔歌声不断，参差桑树望中迷。\n花田香散泥初湿，柳圃烟深莺乱啼。\n此地千年多买犊，耕男谁复怨征鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客湖上","author":"顾禧","text":"对酒拂吴钩，光随湖水流。\n碧寻堤上草，红落竹边楼。\n春老莺啼倦，山空鹤唳收。\n买花钱欲尽，何事再句留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]