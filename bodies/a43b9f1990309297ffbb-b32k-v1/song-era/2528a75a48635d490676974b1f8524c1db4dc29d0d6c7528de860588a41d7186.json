[{"title":"寿应茶马 其二","author":"李曾伯","text":"太微一宿烛鱼凫，已奏平反课转输。\n绿碾雨前舒凤爪，青镰雪外长龙颅。\n班崇东壁图书府，惠畅西夷道德涂。\n伫佐修壤歌六月，载铭石鼓会东都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿应茶马 其三","author":"李曾伯","text":"汉昴殷箕谩拟伦，天将平治启儒真。\n钟英宝婺金华地，敛福铜梁玉垒民。\n冰壑雪山无点暑，桃溪棠荫有馀春。\n绵绵寿脉无穷处，一派根源在至仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陈制垣 其三","author":"李曾伯","text":"东皇妆就牡丹天，来献蓬莱不老仙。\n耆旧喜增羊祜传，蛮夷欣问晋公年。\n休怀苕水清风适，且醉檀溪绿草边。\n愿向衣冠图上看，银屏千岁映貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陈制垣 其一","author":"李曾伯","text":"十载青油驻汉关，勋名高压岘南山。\n雨滋万顷春犁乐，月淡三边夜柝闲。\n为小朝廷留宿望，升真学士重崇班。\n九重银信知非远，白玉阶前一武间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陈制垣 其二","author":"李曾伯","text":"向来荆楚说边州，人士今誇乐国游。\n千里潢池自交扰，一江汉水独安流。\n兵无敢惰身为率，民有犹饥惠亟赒。\n阴德活人无量大，不须香火祝王侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿岳漕 其一","author":"李曾伯","text":"渡江人物照乾坤，盟府勋庸奕叶存。\n崧岳千年申伯雅，汉台几世仲华孙。\n自将翠节临南纪，更佐金城护北门。\n禁柳官梅正春色，好看鸣玉上天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿岳漕 其二","author":"李曾伯","text":"檀溪翠雾晓轮囷，共庆皇华诞玉辰。\n偻指明宵三五夜，从头新岁八千春。\n且烦皎月清边徼，行逐东风造禁宸。\n留取棠阴蔽南岘，为陪羊杜寿苍珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿城围解制参向君玉贶以凯歌和韵 其二","author":"李曾伯","text":"中流岌岌此舟同，对越皇天只寸衷。\n今夜千艘趋险进，明朝万马举群空。\n将军争上平戎捷，老子惭无守塞功。\n局面莫贪边用利，共思稳著待西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿城围解制参向君玉贶以凯歌和韵 其一","author":"李曾伯","text":"谁知匕箸落轰雷，三月新城两月围。\n吉语虽传淮鹤捷，惊心几动海鸥机。\n公毋誇伐称全璧，我为忧疑已佩韦。\n何处无鱼堪荐饭，不须跕跕看鸢飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿城凯还宴将帅乐语口号","author":"李曾伯","text":"新墉屹屹解严围，十万全师破贼回。\n元帅拥旄朝授策，将军画箠夜衔枚。\n椎牛脔炙欢声动，伐鼓传觞哀拍催。\n尽道平淮勋业盛，总须图像上云台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿遂宁李漕 其一","author":"李曾伯","text":"今世儒宗一泰山，暂乘紫气下函关。\n主盟道学周程上，伯仲诗名李杜间。\n少府暂分肤使节，甘泉合在侍臣班。\n春江一碧平于掌，好趣牙樯待赐环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿遂宁李漕 其二","author":"李曾伯","text":"自从岳牧著民庸，十载岷峨帝眷隆。\n草带雨锄周圃绿，粟和烟挽汉关红。\n活人阴德深无尽，寿国良方用不穷。\n一转钧间黄阁去，天涯岁岁囿东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿蜀帅 其三","author":"李曾伯","text":"不用江山当寿卮，年年一佛住峨眉。\n崧高复见歌申伯，坰野宁无颂鲁僖。\n岁比绛人逾甲子，日逢皇览揆庚寅。\n书生愧乏梅花赋，引领东风上北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿蜀帅 其二","author":"李曾伯","text":"霄汉当年把绣衣，载持斋钺建侯圭。\n春城月淡铜梁北，夜柝星沉玉垒西。\n外阃规模萧葛上，中朝勋望范韩齐。\n枫宸侧席亲贤久，早晚鸣珂步相堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬州宴交代丘总领乐语口号","author":"李曾伯","text":"騑騑牡驾暂临边，淮海东头护玉旃。\n春满四郊耕谷雨，云屯万灶饱炊烟。\n平山柳絮随丝辔，新水桃花飏綵船。\n潋滟一杯拚却醉，明朝有诏侍甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛丑都司公廨与陈景清诸友小集作 其二","author":"李曾伯","text":"当才谁可柱中流，我辈何如避一头。\n旧隐要寻鸥作伴，薄田足与鹤为谋。\n蒹葭白露嗟今老，榆柳西风感昔游。\n新秫已登鲈蟹贱，溪头何日舣归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛丑都司公廨与陈景清诸友小集作 其一","author":"李曾伯","text":"几年漫浪尚萍流，汩没京尘雪满头。\n得意正浓须却顾，奉身而退是良谋。\n未忘雅志怀安石，长忆平生愧少游。\n归去何求闲足矣，数椽村屋一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥元夕坐间和刘景文韵 其二","author":"李曾伯","text":"多谢孀娥得得来，肯陪绿鬓映黄台。\n剪成绛蜡灯间艳，移向青油幕底栽。\n万目竞拚通夕看，两眉赢得片时开。\n祗怜人亦牵丝戏，任向当场弄几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥元夕坐间和刘景文韵 其一","author":"李曾伯","text":"客心似向汉槎来，便盍观光近斗台。\n王俭池边新节物，刘郎观里旧根栽。\n饶人老月添春好，特地痴云际晚开。\n明岁传柑天上宴，马头犹记渚宫回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛酉首夏余云谷自四明来访且录示丙辰年所和永国韵恍然唤起昨梦嗟壮健之不可复得今病废无它问谩书五十六字谢之时病犹未愈","author":"李曾伯","text":"禅榻相逢六载前，当时驽力尚堪鞭。\n继更烟瘴为形役，遍历风涛不意全。\n思旧仙游嗟已远，老躯痿废抑谁怜。\n而今莫问人间事，得正狐丘是甚年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连日过滩","author":"李曾伯","text":"一滩才过一滩催，虽若危哉亦壮哉。\n白狗甫随狼尾去，黄牛又逐虎头来。\n狂澜逐淖几成沸，坠石穿江乱作堆。\n堪笑舟人诧春涨，溯流难及顺流回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风池州界","author":"李曾伯","text":"拟以风斯下，胡然日在兹。\n一头聊且避，八面欲何施。\n坎有险如此，需于沙待之。\n姑陪鹏力厚，万里看南为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风固城湖","author":"李曾伯","text":"历峡浮江万里归，一湖乃尔尼留之。\n由吾天籁偶相值，岂汝川灵敢肆欺。\n上水虽饶趋下便，北风会有转南时。\n浮生只作无心看，何用咨咨咄咄为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈次贾归以二诗言别和韵送之 其二","author":"李曾伯","text":"手袖朱弦绿绮琴，身虽湖海调山林。\n家园千里归心切，朋友中年别恨深。\n国事艰难殚我力，世情巧令听渠任。\n海门雁过应相忆，塞上征人正苦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈次贾归以二诗言别和韵送之 其一","author":"李曾伯","text":"百尺楼前舣去桅，元龙豪气肯低徊。\n昔从桂岭访梅去，今自荆江载月回。\n敢拟王刘曾主客，应嗤瑜逊等舆台。\n转头落日阳关外，三叹可人呼不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侍亲劳监游雪峰","author":"李曾伯","text":"一水横桥碧作弯，两山排闼翠成环。\n寺居野色烟光外，春在人情物意间。\n点检花稍香浅浅，摩娑苔刻字斑斑。\n门前车马空来去，云自无心鸟自还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凯还又宴王宣使乐语口号","author":"李曾伯","text":"八年一柱屹长城，此老胸中百万兵。\n有造于西棠播颂，穷荒之北草知名。\n喧天笳鼓归时乐，揭日旂常旷世荣。\n且为平山应少驻，莫辞酩酊尽欢情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和八窗叔雪中登楼韵","author":"李曾伯","text":"不夜城头著此亭，山川幻化抑何神。\n高低地势平于水，穷富人家等是春。\n一气中间知有造，四方上下了无尘。\n烹茶读易从古适，不羡梁园作赋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邓巽坡见寄元夕韵","author":"李曾伯","text":"一笑芳宵万虑平，诗翁犹自假诗鸣。\n名邦想见灯成市，病骨相忘月暗城。\n人事谁能记今昨，天公都莫管阴晴。\n窗前细读梅花句，但觉身轻眼倍明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘舍人咏雪","author":"李曾伯","text":"怪见漫空万蝶狂，须臾色界眩昏黄。\n风姨知费几番信，天女才施半面妆。\n笔底诗徒和冰柱，酒边舞已失霓裳。\n梁园甚恨孤佳约，一笑吟梅且擅场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘舍人夏雨喜霁","author":"李曾伯","text":"古戍春归叹寂寥，老槐阴下鬓萧萧。\n正愁雨久人情厌，且喜天晴物意饶。\n歌吹遏云传白苧，旌旗拂日翳红蕉。\n月边休听啼鹃恨，只把诗篇与酒销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘清叔檀溪韵","author":"李曾伯","text":"一溪清入汉江东，千载兴亡指顾中。\n自昔霸图成匹马，至今生气贯长虹。\n当时枉驾先诸葛，底事浮江后阿童。\n髀肉已生骓逝矣，空馀款段踏尘红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘疏轩雪堂韵","author":"李曾伯","text":"因君郢调问前踪，贤者斯能乐雪宫。\n四海香名寰宇外，百年公论党碑中。\n癯然鹤骨存生气，寂甚鸾胶续古风。\n留得墨池芳润在，草玄犹可忆扬雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和别制垣金陵劝驾韵","author":"李曾伯","text":"殷勤儒帅饯图南，文物彬彬岁比三。\n远业相期唐进士，流风一洗晋清谈。\n歌陈呦鹿筵初宴，分揣庸驽乘莫骖。\n好向琼林待公衮，杏园春色正红酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴叔永见寄韵 其二","author":"李曾伯","text":"诗怀今古浩无垠，谁寄梅花陇首人。\n刍豢悦心文字趣，筌蹄忘象性情真。\n相望夜月袁宏渚，一洗西风庾亮尘。\n我欲莼鲈便归去，雁来应问五湖春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴叔永见寄韵 其一","author":"李曾伯","text":"眼空凡马绝全牛，肯念江萍万里浮。\n一倡朱弦补骚雅，片言华衮续春秋。\n礼罗自昔须温造，文馆而今欠薛收。\n要任丘墟百年责，慎毋樽俎上南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴居父江陵雄楚楼韵","author":"李曾伯","text":"岁月等新戍，风烟只旧游。\n柳薇今堡障，蘋蓼古沧洲。\n索句惭巴和，怀人笑楚优。\n中原虽在目，无事莫登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和制干陈循道惠鹤韵","author":"李曾伯","text":"怪得中宵梦羽衣，诗来恍见九皋飞。\n期君与共淮淝捷，舍我曷为缑岭归。\n愧乏缠腰娱綵服，喜将闻唳到柴扉。\n凌云岂是笼中物，要学当年老令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周炳仲过踏洞滩","author":"李曾伯","text":"堪怜濆淖上舟难，争似山坳住舍安。\n雷鼓喧呼人挽缆，风鬟笑语女盘滩。\n倦凭秫酒生春思，愁怯衾裘禦夜寒。\n多谢新诗慰牢落，灯前一笑病怀宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗季能上巳习池送客","author":"李曾伯","text":"一雨洗红蔫，春深昼欲眠。\n绿潭波滉漾，紫陌骑联翩。\n禊事怀觞豆，官身苦槛圈。\n只今王逸少，重见习池边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邓巽坡咏菊并见寄韵 其二","author":"李曾伯","text":"转蓬又是几三秋，客里常宜视鼎羞。\n岭首舍梅无所有，衡阳断雁寄何由。\n凄凉陈迹几年事，缱绻高情一夕留。\n圣代断无车盖禁，诗筒毋惜到南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邓巽坡咏菊并见寄韵 其一","author":"李曾伯","text":"天涯秋晚见孤芳，华发萧骚易感伤。\n对酒未尝忘北海，因诗惟恐瘦东阳。\n古心翻得风霜白，冷艳宁随草木黄。\n惟屈可餐陶可采，蝶蜂争得识寒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邓巽坡韵","author":"李曾伯","text":"身虽湖海常怀主，忠在朝廷肯具臣。\n为国未尝知有己，此心可以质诸神。\n绸缪旧话方樽酒，拂涤征涂满袂尘。\n雍齿且封君岂虑，正须珍重保千钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋志父春风亭韵 其一","author":"李曾伯","text":"不须举扇障西风，且付黄花一笑中。\n渐喜卢㕙成两毙，仍愁蜂蚁起群雄。\n未能长策辕从北，果有真儒辙岂东。\n老我数奇何所用，快教儿辈学从戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋志父春风亭韵 其二","author":"李曾伯","text":"谁能草檄愈头风，有酒时时共一中。\n莫把丹青羡苏武，且将玄白玩扬雄。\n将军事在龙荒北，客子心驰马首东。\n休笑晋朝人物少，犹知口不道和戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和总幕刘景文题杜立斋遗翰诗韵","author":"李曾伯","text":"一老风流两社间，至今膏馥尚留残。\n典刑已矣墨犹润，生死以之盟未寒。\n淮海属心知士苦，山林投分只儒酸。\n灯前掩袂空三叹，盍与传诸琬琰看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晦庵先生定王台韵","author":"李曾伯","text":"前王千载后，奕代几人来。\n汉事一抔土，湘祠数仞台。\n山容青拱揖，树影绿周回。\n客有登临者，犹存陟屺哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧石城袖示壬午李漕革夫劝驾诗","author":"李曾伯","text":"阅三十载墨犹新，公是当时第一人。\n马革伏波惭立柱，羊裘严濑老垂纶。\n观宾可以观其主，在子胜如在乃身。\n多少汗颜君袖手，凭谁举酒问穹旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧应父赠黄子芸韵","author":"李曾伯","text":"久负诗坛第一评，肯教栖凤久榛荆。\n西堂有梦堪追谢，北海何书可荐衡。\n匹马归来嗟我俗，孤鸿吟对羡君清。\n霜前蟹嫩新篘美，为问江头潮已生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父喜雨韵 其二","author":"李曾伯","text":"柔金老火苦相鏖，千里骎骎地不毛。\n忽遂所祈欣欲舞，举蒙其利润于膏。\n昭苏田畯禾千顷，饱满舟人水一篙。\n我老发挥无好句，须拈健笔付诗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅山父喜雨韵 其一","author":"李曾伯","text":"骄阳赫赫正当空，化作甘霖覆手中。\n洗涤四郊无点翳，作兴群槁有新功。\n惟方寸地能精格，信咫尺天随感通。\n毋以喜书安仅足，更行好事答高穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和疏轩琵琶亭韵","author":"李曾伯","text":"高亭俯瞰蓼蘋洲，人老香山月自秋。\n过耳好音堪一笑，伤心往事只轻沤。\n休嗟塞上明妃调，且送江头过客舟。\n壮士肯为儿女泪，柔肠一任恼苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和幕府税巽父吊陈任二谏议韵","author":"李曾伯","text":"出门三十里平原，仰止高山礼甚专。\n烈日秋霜千祀后，寒烟荒草两茔前。\n一瞻文献生何晚，三叹奸邪死不先。\n臣也不忠宜共戒，烝尝何惜更加笾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和褚县丞韵","author":"李曾伯","text":"哦松之去争能诵，载月而归取甚廉。\n诲掖尚无忘后进，典刑真不愧前瞻。\n新诗慰藉知三复，雅意勤渠示一谦。\n愿问閒中读书味，鱼熊何以得而兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和褚县丞韵 其二","author":"李曾伯","text":"拍拍新书一纸春，相逢牢落易相亲。\n霸陵李广方嗟老，阙里原思乃叹贫。\n顾我栖迟甘一壑，感君慰藉重千钧。\n灯前欲和梅花引，病发飘飘满面尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和褚县丞韵 其一","author":"李曾伯","text":"世味宁如道味浓，谁令小屋卧元龙。\n何当谈笑与双璧，乃假吟哦对二松。\n倾盖正欣留槜李，归樯底事取潘葑。\n先生且办弦歌计，莫虑瓶无斗粟舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和阙干雪中韵 其二","author":"李曾伯","text":"青女欺寒未肯霜，先将银铄散祥光。\n芙蓉晓院不禁老，薝卜满林惟欠香。\n冷入宝环销翠羽，声随石鼎煮羊肠。\n兔园赋罢谁能继，留得诗人祝岁穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和阙干雪中韵 其一","author":"李曾伯","text":"夜来白凤下天潢，幻得人间玉样光。\n万里园林变春景，几家篱落失秋香。\n黄紬歌枕水为骨，纸帐吟梅铁作肠。\n争似城南老夫妇，地炉相对拥蒲穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和夔门开济堂韵","author":"李曾伯","text":"世事纷更局面棋，滔滔逝水只东之。\n几堆顽石鬼神护，一节高风今古奇。\n司马岂能无战垒，卧龙祗合在筹帷。\n将星一落空遗恨，费尽诗人几许诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"固城湖边即事","author":"李曾伯","text":"孤舟横岸水潺湲，野色天成一段闲。\n十数牧儿黄犊侧，两三钓叟白鸥间。\n丛丛烟树谁家市，浅浅云峦甚处山。\n风定浪平归路稳，更无魂梦到萧关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜分和郑小山韵 其二","author":"李曾伯","text":"塞上萧萧雨更风，秋来兴味与谁同。\n短檠聊和灯前句，长槊休誇马上功。\n挽二石弓陪一校，操方寸管较诸公。\n到头等是为形役，尽付掀髯一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜分和郑小山韵 其一","author":"李曾伯","text":"弓剑相随几历年，鬓毛斑剥饱风烟。\n可怜芦叶胡笳地，又过菊花新酒天。\n耳听骅骝还紫逻，梦随白鹭过青田。\n家僮久问谋归未，想笑吾顽不可镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雨复晴","author":"李曾伯","text":"雨欲今朝忽又晴，客涂忧纬为关情。\n木多未叶春几槁，桃已皆花水未生。\n宿麦既辜秋陇种，新秧正候早田耕。\n蛰龙何处深渊睡，乞取霆声为唤惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]