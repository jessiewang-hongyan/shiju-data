[{"title":"早起赴行香","author":"曾巩","text":"枕前听尽小梅花，起见中庭月未斜。\n微破宿云犹度雁，欲深烟柳已藏鸦。\n井轳声急推寒玉，笼烛光繁秉绛纱。\n行到市桥人语密，马头依约对朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":85,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次道子中书问归期","author":"曾巩","text":"窃食东州岁未期，蓬莱人问几时归。\n凭阑到处临清泚，开阁终朝对翠微。\n两印每闲军市静，双旌多偃送迎稀。\n一枝数粒身安稳，不羡云鹏九万飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":86,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江湖","author":"曾巩","text":"江湖俗畏远，幽好自相宜。\n沦迹异惊众，辞嚣如避时。\n优游可以学，薇蕨易为私。\n胡然弃回棹，霜雪有驱驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":87,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上即席送况之赴宣城","author":"曾巩","text":"池上红深绿浅时，春风荡漾水逶迤。\n南州鼓舞归慈惠，东观壶觞惜别离。\n远岫烟云供醉眼，双溪鱼鸟付新诗。\n陵阳岂是迟留地，趣驾追锋自有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":88,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芍药厅","author":"曾巩","text":"小碧阑干四月天，露红烟紫不胜妍。\n肯为云住阳台女，恐逐风飞饰室仙。\n洧外送归情放荡，省中番直势拘挛。\n何如萧洒山城守，浅酌清吟济水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":89,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西园席上","author":"曾巩","text":"省阁名郎国羽仪，瀛洲仙客众蓍龟。\n山蹊向日花开早，海聚经寒酒熟迟。\n下榻笑谈红旆偃，引觞醉醒玉钗随。\n唯惭别乘疏顽甚，满面尘埃更有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":90,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西亭","author":"曾巩","text":"团扇频挥到此亭，他乡愁坐思冥冥。\n空羞避俗无高节，转觉逢人恶独醒。\n岁月淹留随日老，乾坤狼狈几时宁？\n欲知事事今何似，万里波涛一点萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":91,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖二首 其二","author":"曾巩","text":"湖面平随苇岸长，碧天垂影入清光。\n一川风露荷花晓，六月蓬瀛燕坐凉。\n沧海桴浮成旷荡，明河槎上更微茫。\n何须辛苦求天外，自有仙乡在水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":92,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖二首 其一","author":"曾巩","text":"左符千里走东方，喜有西湖六月凉。\n塞上马归终反覆，泰山鸱饱正飞扬。\n懒宜鱼鸟心常静，老觉诗书味更长。\n行到平桥初见日，满川风露紫荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":93,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖纳凉","author":"曾巩","text":"问吾何处避炎蒸，十顷西湖照眼明。\n鱼戏一篙新浪满，鸟啼千步绿阴成。\n虹腰隐隐松桥出，鹢首峨峨画舫行。\n最喜晚凉风月好，紫荷香里听泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":94,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过高士坊","author":"曾巩","text":"一亩萧然绝世喧，抗怀那肯就笼樊。\n功名晚更为馀事，灾异初尝出至言。\n郡阁已空徐孺榻，里人犹识郑公门。\n斯文未丧如繇我，后代当知李仲元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":95,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯常少留别业寄诗索酒因以奉报","author":"曾巩","text":"未拥双驺谒汉庭，暂留车马憩林坰。\n多情置驿邀佳客，好事磨铅勘旧经。\n芳草连门三径远，朝云临幌数峰青。\n春醪有禁无繇寄，谁为江潭访独醒？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":96,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初冬道中","author":"曾巩","text":"潦退蛟螭不可逃，溪潭清澈见秋毫。\n欲霜日射西山赤，渐冷天腾北极高。\n秀色更浓唯竹柏，孤根先动是蓬蒿。\n感时一抚青萍叹，马踏西风气自豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":97,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿圣院昌山主静轩","author":"曾巩","text":"一峰潇洒背成阴，碧瓦新堂地布金。\n花落禅衣松砌冷，日临经帙纸窗深。\n幽栖鸟得林中乐，燕坐人存世外心。\n应似白莲香火社，不妨篮舆客追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":98,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岘山亭置酒","author":"曾巩","text":"石磴萦回入杳冥，筠松高下簇虚亭。\n春归野路梅争白，雪尽沙田麦正青。\n马窟飞云临画栋，凤林斜日照疏棂。\n长年酒量殊山简，却上篮舆恨独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":99,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李供奉","author":"曾巩","text":"一身得禄从孤客，千里还丧获旧林。\n清节萧条妻子计，白头敦笃弟兄心。\n能抛印绶高应少，自筑丘坟达更深。\n我与往来无力荐，褒传唯有北窗吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩寺兼简重元长老二刘居士","author":"曾巩","text":"法定禅房临峭谷，辟支灵塔冠层峦。\n轩窗势耸云林合，钟磬声高鸟道盘。\n白鹤已飞泉自涌，青龙无迹洞常寒。\n更闻雷远相从乐，世道嚣尘岂可干？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲行","author":"曾巩","text":"草软沙匀野路晴，竹枝乌帽称闲行。\n鸟啼绿树穿花影，风出青山送水声。\n转觉所忧非己事，尽从多难见人情。\n闲中我乐人应笑，忙处人争我不争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈君式恭轩","author":"曾巩","text":"不要墙头俗眼看，故开苍藓种檀栾。\n虚心得处从天性，劲节知来在岁寒。\n叶养风烟誇酒美，枝留冰雪送歌残。\n名郎感慕同桑梓，手植依然一亩宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和酬提刑都官寒食阻风见寄","author":"曾巩","text":"画船齐泊倚青山，正值春风阻往还。\n江作鼓鼙声浩渺，树为城障绿回环。\n幽花婀娜偏当眼，啼鸟交加亦解颜。\n使者文章工不浅，尽将模写寄柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到郡一年","author":"曾巩","text":"薄材何幸拥朱轩，窃食东州已一年。\n陇上雨馀看麦秀，桑间日永问蚕眠。\n官名虽冗身无累，心事长闲地自偏。\n祇恐再期官满去，每来湖岸合留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孔平仲","author":"曾巩","text":"园池方喜共追寻，正是槐榆夹路阴。\n双烛纵谈樽酒绿，一枰销日纸窗深。\n波涛万字惊人笔，尘土千钟异俗心。\n佳句从来知寡和，愧将沙砾报黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和史馆相公上元观灯","author":"曾巩","text":"九衢仙仗豫游归，宝烛星繁换夕晖。\n传盏未斜清禁月，散花还拂侍臣衣。\n天香暗度金虬暖，宫扇双开彩凤飞。\n法曲世人听未足，却迎朱辇下端闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙少述侯职方同燕席","author":"曾巩","text":"两翁头白喜追陪，好事铃斋燕席开。\n腊在未消盈尺雪，春归先放一枝梅。\n况无庭下书投缿，更尽筵中酒满杯。\n周召二南皆绝唱，抑扬赓和愧非材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张伯常自郢中将及敝境先寄长句","author":"曾巩","text":"拔薤威名高外服，握兰风力冠中台。\n好音忽有双鱼至，喜气遥知五马来。\n梨颗玉腴含雨重，菊房金粉傍寒开。\n池边且欲留同醉，思拙难酬白雪才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张伯常岘山亭晚起元韵","author":"曾巩","text":"挥手红尘意浩然，夙兴招客与扳联。\n烟云秀发春前地，草木清含雪后天。\n已卜耕桑临富水，暂抛鱼鸟去伊川。\n更追羊杜经行乐，况有风骚是谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邵资政","author":"曾巩","text":"拂衣久欲求三径，窃食聊须把一麾。\n世路贱贫从所好，老年胸臆固无奇。\n樊笼偶得沧洲趣，芜类难酬白雪辞。\n督府繇来恩礼厚，每容商也与言诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈郎中","author":"曾巩","text":"材薄安时甘寂寞，身闲乘兴喜登临。\n每寻香草牵狂思，曾向幽兰费苦吟。\n明月几人非按剑，高山从古少知音。\n数篇清绝赓歌意，默见冯唐异俗心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郑微之","author":"曾巩","text":"故人容下榻，清宴得传杯。\n地秀偏宜竹，天寒未见梅。\n云林千嶂出，烟艇一帆开。\n且醉休言别，归期信召催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和御制上元观灯","author":"曾巩","text":"翠幰霓旌夹露台，夜凉宫扇月中开。\n龙衔烛抱金门出，鳌负山趋玉座来。\n砀极戏添夷客喜，柏梁篇较从臣材。\n共知天意同民乐，愿奏君王万寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬王平甫道中见寄","author":"曾巩","text":"安危魁柄倚谁操，敛笏千官拱赭袍。\n能有本根持国论，岂须毫发间戎韬。\n征求藉藉人多困，羁旅皇皇我亦劳。\n栖宿与君何计得，半生飘荡似风毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬孙少述","author":"曾巩","text":"自信箪瓢乐，宁羞猿鹤惊。\n论高知峻节，交淡见纯诚。\n自昔心无间，相逢眼更明。\n何当荐有道？\n坐想软轮迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬赵宫保致政言怀二首 其二","author":"曾巩","text":"爱国忧民有古风，米盐亲省尚嫌慵。\n衮衣天上归何晚，霖雨人间望正浓。\n三少官仪虽赫赫，五湖心事肯容容。\n角巾藜杖经行处，知在云山第几重？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬赵宫保致政言怀二首 其一","author":"曾巩","text":"谠论危言望素隆，独于声利性偏慵。\n龙楼调护官虽宠，鸠杖跻攀兴已浓。\n不变松篁心转劲，无边江海量兼容。\n磻溪纵老宁闲得，会为苍生起更重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招泽甫竹亭闲话","author":"曾巩","text":"偶归塞马应何定，粒食鹪鹩颇自安。\n云压楚山春后雪，风吹襄水坐来寒。\n诗豪已分材难强，酒圣还谙量未宽。\n赖有佳宾堪下榻，且将清话对檀栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"环波亭","author":"曾巩","text":"水心还有拂云堆，日日应须把酒杯。\n杨柳巧含烟景合，芙蓉争带露华开。\n城头山色相围出，檐底波声四面来。\n谁信瀛洲未归去，两州俱得小蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦雨","author":"曾巩","text":"雾围南山郁冥冥，狭谷荒风驱水声。\n只疑日失黄道去，又见雨含沧海生。\n如催病骨夜寒入，似送客心衰思惊。\n扬州青铜不在照，应有白须添数茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"英宗皇帝挽词二首 其二","author":"曾巩","text":"继文犹旦暮，归启已讴吟。\n画手传英气，书筠见德音。\n铸铜馀故鼎，啄草付春禽。\n试望桥山路，萧萧翠柏深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"英宗皇帝挽词二首 其一","author":"曾巩","text":"已应南阳气，犹迟代邸来。\n范熔归独化，纲理付群材。\n禹会方无外，虞巡遂不回。\n空惊柏城仗，箫鼓送馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中","author":"曾巩","text":"愁烟苦雨今朝是，小屋深扉野性怜。\n偶似鲁连能肆志，肯如刘备耻求田。\n贫谙亲友难过饮，病笑诗书可枕眠。\n欲会此心何自适，平生消长任陶甄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中王驾部席上","author":"曾巩","text":"鸠呼连日始成阴，薄雨聊宽望岁心。\n浴雁野塘新浪细，藏鸦宫柳嫩条深。\n春寒巧放花迟发，人老嗟辞酒满斟。\n英隽并游知最幸，名园偷暇更追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南轩竹","author":"曾巩","text":"密竹娟娟数十茎，旱天萧洒有高情。\n风吹已送烦心醒，雨洗还供远眼清。\n新笋巧穿苔石去，碎阴微破粉墙生。\n应须万物冰霜后，来看琅玕色转明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"厚卿子中使高丽","author":"曾巩","text":"并使时推出众材，异方迎拜六城开。\n宣风直到东西部，仗节遥临大小梅。\n沧海路从三岛去，玉山人到二星回。\n黄金白氎饶君用，铜器应馀寄我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庭桧呈蒋颖叔","author":"曾巩","text":"樛枝高下秀森森，曾寄名卿异俗心。\n草舍一时成往事，松身千尺见新阴。\n声清不受笙竽杂，气劲能遗霰雪侵。\n汉节从来纵真赏，谢庭兰玉载芳音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盆池","author":"曾巩","text":"环环清泚旱犹深，炳炳芙蓉近可寻。\n苍壁巧藏天影入，翠奁微带藓痕侵。\n能供水石三秋兴，不负江湖万里心。\n照影独怜身老去，日添华发已盈簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看花","author":"曾巩","text":"春来日日探花开，紫陌看花始此回。\n欲赋妍华无健笔，拟酬芳景怕深杯。\n但知抖擞红尘去，莫问鬅鬙白发催。\n更老风情转应少，且邀佳客试徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日感事示介甫","author":"曾巩","text":"秋日气已盛，阴虫朝暮声。\n烟云断溪树，风雨入山城。\n沙碛有遗虏，旌旗多远行。\n生民苦未息，吾党耻论兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡太傅挽词二首 其二","author":"曾巩","text":"远略参基命，雄文入典章。\n輤车俄就路，瑞节始还乡。\n象物陈虚寝，哀歌寄奠觞。\n惟应九原上，松桧日苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡太傅挽词二首 其一","author":"曾巩","text":"谠言留简册，恭德载闺门。\n福履三朝盛，官仪一品尊。\n九原无复起，万事付谁论。\n不必诸儒记，清名久自存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元厚之资政致仕归苏州","author":"曾巩","text":"笑指家园是五湖，画船东下载图书。\n收功玉铉丹青后，得老铜楼羽翼初。\n醒醉放怀从野服，登临乘兴属安车。\n都门饮饯光华盛，不独当年有二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送双渐之汉阳","author":"曾巩","text":"楚国封疆最上流，夹江分命两诸侯。\n何年南狩牙樯出，六月西来雪浪浮。\n夏口楼台供夕望，晴川风物待春游。\n可能频度渔阳曲，不负当年鹦鹉洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王补之归南城","author":"曾巩","text":"瘦马君将去，清樽我谩开。\n眼看新雨露，身带旧尘埃。\n但喜丹心在，休惊白发催。\n穷通莫须问，功业有时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送关彦远","author":"曾巩","text":"莫辞为我百分饮，从此送君千里行。\n物情簪屦尚须念，人道交亲那可轻？\n渚梅江柳弄佳色，林鸟野蜂吟好声。\n对之但醉馀可置，明日此杯谁共倾？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送关彦远赴江西","author":"曾巩","text":"食蘖饮冰廉士操，敝衣穿履古人风。\n溪堂兴足登临后，滕阁今归啸傲中。\n一榻高悬宾阁峻，二龙俱化县池空。\n因过胜境须行乐，驿召方当急诏东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送关彦远赴河北","author":"曾巩","text":"子明高谊众人知，苗裔清材世所推。\n诗作士林誇刻烛，赋成天路喜同时。\n岂当白首淹风力，自合青云纵羽仪。\n北部经营应不久，玉阶朝夕是归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙颖贤","author":"曾巩","text":"穰穰秦州铁马群，青衫吾子仕犹屯。\n高谈消长才惊世，藐视公侯行出人。\n古气欲遵奔日月，畏涂曾触滞荆榛。\n明夷夬决应斟酌，自向穷通有屈伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送抚州钱郎中","author":"曾巩","text":"名郎元是足风流，得郡东南地更优。\n翠幕管弦三市晚，画堂烟雨五峰秋。\n黄柑巧缀星垂槛，香稻匀翻雪满瓯。\n应与谢公资健笔，邦人才薄讵能酬？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李莘太博","author":"曾巩","text":"郪道鸣弦去，容台抱蕝初。\n尘沙开祖帐，冰雪映征车。\n久待连城价，谁腾一鹗书。\n君王览豪俊，应复召严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈谏议","author":"曾巩","text":"东南经济得时英，方底除书下汉庭。\n将幕鼓旗惊白昼，谏垣冠剑动青冥。\n指撝瓯越归谈笑，镇压江吴出醉醒。\n金鼎盐梅须大用，九霄应已梦仪刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈世脩","author":"曾巩","text":"沙渚鸿飞入楚云，远林樵爨宿烟昏。\n娟娟野菊经秋淡，漠漠沧江带雨浑。\n归路赏心应驻节，客亭离思暂开樽。\n莫嗟问俗淹翔久，从此频繁不次恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈郎中还京兼过九江新宅","author":"曾巩","text":"鹢舟金碧照溪沙，帆上风吹五两斜。\n罢郡紫泥催向阙，过江红旆引还家。\n因将旧社人携酒，应喜新林树见花。\n莫作山斋久留意，中台虚位有清华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送英州苏秘丞","author":"曾巩","text":"远民歌舞戴升平，碧阁朱楼照眼明。\n乡馔雨馀收白蕈，客樽秋后对红英。\n泷鸣浈水遥通海，路入南山不隔城。\n材术如君有馀暇，出游应数拥双旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉祖院明上人","author":"曾巩","text":"冠石新墙日月回，丰堂瑰殿起崔嵬。\n钟随秋势金声壮，佛隐寒云玉座开。\n流水远奔双涧去，平林高拥四山来。\n麒麟细草南东路，一望松门意自哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵资政","author":"曾巩","text":"镇抚西南众望倾，玉书天上辍持衡。\n春风不觉岷山远，和气还从锦水生。\n学舍却寻馀教在，棠郊应喜旧阴成。\n归来促召调炉冶，莫为儿童竹马迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高秘丞","author":"曾巩","text":"簿书壅处精神健，风俗浇时质性淳。\n公退种花常满县，政成驯雉不惊人。\n指麾细柳通河外，歌咏《甘棠》付汉滨。\n惆怅不能留自助，谩将樽酒驻车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]