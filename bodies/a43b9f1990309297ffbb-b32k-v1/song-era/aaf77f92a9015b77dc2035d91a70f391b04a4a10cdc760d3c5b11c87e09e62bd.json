[{"title":"次及甫入峡杂咏 钓鱼石翁","author":"洪咨夔","text":"刀耕火种皆丘甲，背负腰缠尽算缗。\n独有石翁鱼得计，至今疑是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次及甫入峡杂咏 虾蟆培泉","author":"洪咨夔","text":"丹墀万字中兴策，西蜀人材待细抡。\n好把玉蜍留水去，直言莫问近前嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张义立登九顶三绝 其一 大像","author":"洪咨夔","text":"坐断江山现法身，大光明里万波旬。\n东风归棹津头过，同是慈航得度人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张义立登九顶三绝 其三 乌尤","author":"洪咨夔","text":"酒壮千林如欲舞，诗豪万景不容骄。\n山中肯着如斯客，来听春风婆饼焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其七","author":"洪咨夔","text":"近山气候易凉温，云为阴晴半吐吞。\n草木趋新千万态，芸芸何者是归根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其九","author":"洪咨夔","text":"燕子将雏鹿养茸，年华冉冉鬓成翁。\n拂开万古瞢腾眼，多少英豪老彀中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其二","author":"洪咨夔","text":"藉地残花五色茵，东风来去寂无痕。\n馀香不肯污尘土，留得蜂房活计温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其一","author":"洪咨夔","text":"缡褷瘦鹤耻乘轩，踏遍莓苔十亩园。\n欲下横塘还决去，涨痕一尺晚来浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其八","author":"洪咨夔","text":"绿阴羃定蔚蓝天，庭户萧然有漏仙。\n麦饭熟时蚕百箔，山中啼鸟识丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其五","author":"洪咨夔","text":"屋角春声几样翻，勾牵春梦绕丘樊。\n三桃二李成阴早，恨不安仁老灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其十","author":"洪咨夔","text":"潼关杀气渺春阴，渭水泱泱柳色深。\n为问草庐人起否，汉家遗老尚讴吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李参政晚春湖上口占十绝 其四","author":"洪咨夔","text":"雨过桃花尽处源，庭前新绿长芳荪。\n目前点检燕支篆，手汲清泉洗着樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李阆州禀议三首 其二 立春日风","author":"洪咨夔","text":"千骑行春雪未消，早乘羊角问逍遥。\n明年好与供春帖，淑景祥飙近九霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李阆州禀议三首 其一 训狐","author":"洪咨夔","text":"顽民迁洛风随改，佞士归唐操立更。\n勿怪训狐知气转，铜丸落落便春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李阆州禀议三首 其三 益昌","author":"洪咨夔","text":"长恨诗人挽不来，东风无赖又帆开。\n城南城北佳山水，多少甘棠手自栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵保之清明即事 其一","author":"洪咨夔","text":"饼吃红绫空复忆，钱分白打底曾知。\n推排风雨清明过，只有梨花三两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵保之清明即事 其二","author":"洪咨夔","text":"草草携家去踏青，旧阡新冢纸钱轻。\n触怀易作中年恶，羡杀儿童笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵保之清明即事 其四","author":"洪咨夔","text":"看花何必只长安，到处韶华总一般。\n可是家贫风物晚，郎当莴笋斗春盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵保之清明即事 其三","author":"洪咨夔","text":"花信东风第几回，萧条门巷老苍苔。\n汉宫尽有新钻火，无分传将一点来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次虞宪日近即事 其二","author":"洪咨夔","text":"丙中甲上奇章石，水底山巅杜预碑。\n矻矻一生图不朽，光风好处几曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次虞宪日近即事 其四","author":"洪咨夔","text":"急雨萧萧撼瓦沟，梦随潮落浙江头。\n倚门白发迟归信，不为莼丝烂熳秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次虞宪日近即事 其一","author":"洪咨夔","text":"风落虚檐燕子声，屋头屋尾菜花明。\n炉熏燕坐参消息，理本无亏莫望盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次虞宪日近即事 其三","author":"洪咨夔","text":"衾寒更着痴儿踏，背痒时令丑妇搔。\n骨肉团栾穷亦好，谁能膏火自煎熬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次虞宪日近即事 其五","author":"洪咨夔","text":"梅桃结子绿阴浓，饶与葵榴自在红。\n只有道根须猛进，未甘四下二之中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张提刑送行 其二","author":"洪咨夔","text":"伊川去后几多年，道在离堆沫水边。\n身任兹文须着力，莫将人事属之天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张提刑送行 其四","author":"洪咨夔","text":"太白尝嗟蜀道艰，少陵欲铲剑门山。\n何如推起蓬窗看，万里江天碧鸟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张提刑送行 其六","author":"洪咨夔","text":"云边江树作离声，回首秋光满渭城。\n蜀水吴山无间断，只应明月识人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张提刑送行 其五","author":"洪咨夔","text":"了无薏苡可囊珠，解事家人气甚都。\n日试西川煎茗法，半投白垩半鸡苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵闵饥 其二","author":"洪咨夔","text":"巷头巷尾几夷齐，日为饥肠不肯西。\n只愿天公多雨粟，便教米价贱如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵闵饥 其一","author":"洪咨夔","text":"贵人生长不知田，丝竹声中醉饱眠。\n渠信春山青草尽，排门三日未炊烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵娑罗花","author":"洪咨夔","text":"摩耶树老无多子，天女花妍有许般。\n莫把东边枝便斫，堂堂留与碧霄干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵荼蘼 其一","author":"洪咨夔","text":"璎珞垂垂萼绿华，光明淡伫自成家。\n枕帏酝藉风流足，甘放朝来被底衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵荼蘼 其二","author":"洪咨夔","text":"爱春留得琼英在，添竹扶将翠蔓高。\n更着金沙相间种，主人四壁锦周遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其八","author":"洪咨夔","text":"不提长剑斩江蛟，便揭脩竿钓海鳌。\n纵老无成犹自许，一溪流水两山桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其七","author":"洪咨夔","text":"稻花秋晚蟹洗手，荠菜春初饧胶牙。\n筑底空山谁办此，留君只有石边茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其二","author":"洪咨夔","text":"欲访天池水发源，倒骑北斗挟飞仙。\n高低八节滩头路，俛仰三生石上缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其十","author":"洪咨夔","text":"平明出去日斜回，小立岩花涧草隈。\n光景留连非我事，此心曾点漆雕开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其九","author":"洪咨夔","text":"不知我者谓何哉，布袜青鞋日日催。\n长啸一声啼鸟外，朵颐有象著山雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其五","author":"洪咨夔","text":"武陵溪上迷津处，衡岳峰头失道时。\n珍重牧儿相指似，隔林招手不吾欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其三","author":"洪咨夔","text":"拍手东风唤白猿，划开元盖洞天门。\n可能路指虚无去，两脚须留点地跟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其六","author":"洪咨夔","text":"飞泉溅雪林华湿，盘石生云古藓乾。\n早著些词招隐去，泰山有贼脍人肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游龙门十绝 其一","author":"洪咨夔","text":"若木扶桑莫苦攀，芙蓉薜荔不妨闲。\n封三万户烟云里，化百千身水石间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江头寄致远 其二","author":"洪咨夔","text":"客窗翻遍竹炉香，楼外更声作许长。\n解事灯花相报似，拥炉儿女说荒唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江头寄致远 其一","author":"洪咨夔","text":"箕斗光移析木津，踏霜扶醉不惊尘。\n夜寒应是梅花觉，半敛愁容婉待春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯夕独酌 其一","author":"洪咨夔","text":"钿车罗帕禁街夜，珂伞炬城沙路春。\n少不自强今老矣，落梅风暖酒生鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯夕独酌 其二","author":"洪咨夔","text":"海涛风定柳枝曲，江楫波明桃叶歌。\n剪烛停杯听宛转，不妨白雪映青蛾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日欢喜口号 其一","author":"洪咨夔","text":"太平宝庆第三年，万乘初郊大报天。\n恰应汉家辛巳日，八觚泰畤立甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日欢喜口号 其二","author":"洪咨夔","text":"青城矗矗紫坛深，碧宇无风挂斗参。\n亿万苍生齐合爪，圣明天子得天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至节出谒回 其二","author":"洪咨夔","text":"巧笑声摇六博盆，纤纤人在绿窗根。\n隔纱想见春风面，云滑金钗欲溜痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至节出谒回 其一","author":"洪咨夔","text":"一脉阳从地底回，人情物意便春台。\n鲜衣稚子面红醉，知向外家参节来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西庵晚步","author":"洪咨夔","text":"荷披菰折似秋严，茀草丛中菊露尖。\n只有木犀荒不得，媻跚勃窣上亭檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过三鹤山 其一","author":"洪咨夔","text":"造物工夫拙剪裁，群芳各自得春开。\n梨花嫁与东风去，随后荼蘼作媵来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵道上杂咏 其七","author":"洪咨夔","text":"细草护沙连不断，疏风略雨散还收。\n山田麦熟不归去，三百里江都是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵道上杂咏 其六","author":"洪咨夔","text":"高高下下客行路，整整斜斜人住家。\n端的今年蚕较晚，石榴花下响缫车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵道上杂咏 其五","author":"洪咨夔","text":"闯巢抟黍待晨饷，投岸舂锄寻暮栖。\n总是心为形所役，搔头独立渡桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵道上杂咏 其四","author":"洪咨夔","text":"石坛千尺薜萝古，沙径百盘苔藓香。\n不是先生求矫世，懒将日月趁人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵道上杂咏 其三","author":"洪咨夔","text":"玄英范老闻风起，俱为羊裘一钓丝。\n堂扁三贤非本意，何如只号子陵祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵道上杂咏 其二","author":"洪咨夔","text":"半江云湿欲成雨，两岸水浑初退潮。\n短短竹篱花朵压，深深麦坞雉媒娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵道上杂咏 其一","author":"洪咨夔","text":"江上送行潮汛小，船头回首夕阳多。\n人生有几柳如此，客思不禁花柰何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初霜","author":"洪咨夔","text":"庭下晓来霜，菰顿芭蕉折。\n络石瘦菖蒲，独抱青青节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崔帅卿 其七","author":"洪咨夔","text":"垂弧节过便春风，入侍猩袍一点红。\n殿上兽樽谁得饮，汉廷诸老定输公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崔帅卿 其四","author":"洪咨夔","text":"弄兵澒洞射阳秋，一纸招呼杀气收。\n十万苍生惊魄定，活人阴德过宾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崔帅卿 其六","author":"洪咨夔","text":"纷纷传檄方言战，猝猝囊金又说和。\n谁信规摹须早定，计然半策不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崔帅卿 其二","author":"洪咨夔","text":"连蜷雌霓堕晴空，光照书楼卷纸红。\n天为斯文开瑞应，海南海北一宗工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崔帅卿 其五","author":"洪咨夔","text":"夕烽旁午彻甘泉，独有淮东一臂全。\n若使尽从持重计，庙谟底用更忧边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崔帅卿 其三","author":"洪咨夔","text":"塞下人家盎盎春，又推馀泽及流民。\n庆州小范青州富，合作先生社稷身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿崔帅卿 其一","author":"洪咨夔","text":"岭右山川间出贤，开元宰相最居先。\n中间不数余安道，恰到于今五百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀程及甫 其二","author":"洪咨夔","text":"石马门前万里回，向人似亦笑颜开。\n独寻旧日题诗处，却恨骚翁不共来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀程及甫 其一","author":"洪咨夔","text":"撇濆梢涡稳下舟，狼牙鹿角又黄牛。\n儿曹脱险欢呶甚，数到家山十二州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨汉州见和答之 其二","author":"洪咨夔","text":"春随落絮去堂堂，白发相看作许长。\n人物如公犹未节，诸生何敢薄淮阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨汉州见和答之 其一","author":"洪咨夔","text":"西楼伴食老西堂，拆袜浑无半线长。\n推向万山深处去，沉犀桥北望龙阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨花","author":"洪咨夔","text":"旧雨人无半迹来，惺惺独坐眼慵开。\n却嫌飞絮犹多事，点破门前一径苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"里人送芍药用韵","author":"洪咨夔","text":"诗墨淋漓似小王，殷勤包赠暖红香。\n扬州金系腰何在，随分留春共一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月廿六日奉御香祈天竺观音于昭庆寺是日得霁","author":"洪咨夔","text":"大士慈悲出补陀，扫除阴翳作人和。\n武康芋子盐官枣，遇着丰年也倍多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻风呈赵史君 其三","author":"洪咨夔","text":"迟速乘除转晚飙，布帆快意定明朝。\n庐山试问高多少，欲望西川万里桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻风呈赵史君 其二","author":"洪咨夔","text":"倚风晴缆着烟莎，一抹斜阳白鸟过。\n脱手簿书无半点，细翻黄卷课龟罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻风呈赵史君 其一","author":"洪咨夔","text":"长红送酒出江城，樯燕喃喃第二程。\n风色似知攀卧意，打头未肯放船行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"取凉 其一","author":"洪咨夔","text":"六月冷官还解热，解衣盘礴坐苍苔。\n微风只在松梢顶，着意招呼不下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]