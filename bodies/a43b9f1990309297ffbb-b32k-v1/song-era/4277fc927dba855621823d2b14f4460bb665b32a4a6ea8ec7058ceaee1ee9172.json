[{"title":"恭和","author":"吕公著","text":"雪消春动气清微，夹道都人望帝晖。\n法部已调丝竹管，御袍初进赭红衣。\n康衢弥节严三卫，真馆焚香降六飞。\n宴罢瑶池回跸晚，五云通夜拥端闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题龙门二首 其一","author":"邵雍","text":"融结成来不记秋，断崖苍壁锁烟愁。\n中分洪造夏王力，横截大山伊水流。\n八节滩声长在耳，一川风景尽归楼。\n行人莫动凭栏兴，无限英雄浪白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十二日晚步天津次日有诗","author":"邵雍","text":"溪翁昨晚步天津，步到天津伫立频。\n洛水只闻煎去棹，西风唯解促行人。\n山川惨淡笼寒雨，楼观参差锁暮云。\n此景分明谁会得，欲霜时候雁来宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分题得瘿木壶","author":"吕公著","text":"天地产众材，任材谓之智。\n栋桷与楹杙，小大无有弃。\n方者以矩度，圆者中规制。\n嗟尔木之瘿，何异肉有赘。\n生成拥肿姿，赋象难取类。\n檃括所不施，钩绳为尔废。\n大匠睨而往，恻然乃有意。\n孰非造化功，而终朽不器。\n刳剔虚其中，朱漆为之伪。\n斟浆挹酒醴，施用惟其利。\n牺象非不珍，金罍岂不贵。\n设之于楹阶，十目肯注视。\n幸因左右容，反见为奇异。\n人之于才性，夫岂远于是。\n性虽有不善，在教之揉励。\n才亡不可用，由上所措置。\n饰陋就其长，皆得为良士。\n执一以废百，众功何由备。\n是惟圣人心，能通天下志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天津晚步","author":"邵雍","text":"芝盖久稀疏，暮云空坱北。\n千年旧都城，一片闲宫阙。\n禁籞尚连延，觚棱犹巀嶭。\n桥势横雌霓，堤形偃初月。\n瀍涧岸已深，汉唐时既歇。\n危亭独坐人，浪把兴亡阅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和王安之少卿六老诗仍见率成七首 其五","author":"邵雍","text":"六客同游一醉乡，又非流俗所言狂。\n追游共喜清平久，唱和争寻警策忙。\n荐酒月陂林果熟，发茶金谷井泉香。\n千年松下麾谈麈，襟袖无风亦自凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开寿寺壁记","author":"吕午","text":"四顾云山满目前，却从此地得牛眠。\n问君此计何为早，且住人间五百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞留题","author":"吕午","text":"武皇御宇好神仙，帝遣初开此洞天。\n山转九回藏紫府，涧萦百折走寒泉。\n栖真飞鼠□当日，大涤神龙似昔年。\n解与名山传不朽，祇今惟有大苏篇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马城花窠","author":"吕午","text":"老子西城住，今踰十载期。\n栽花成茂树，种柳长高枝。\n移接从渠巧，誇传到处知。\n担头挑卖去，一一是趋时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和岳王庙壁上韵","author":"吕午","text":"当年唯说岳家军，纪律森严孰与邻。\n师过村村皆按堵，功成处处可镌珉。\n威名千古更无敌，词翰数行俱绝尘。\n拟取中原报明主，亦劳馀刃到黄巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台","author":"吕午","text":"古台曾说少年游，弹指惊嗟岁月流。\n山似三神浮碧海，城如一虎卧崇丘。\n凤凰去后遗陈迹，白鹭来时认旧洲。\n但得风寒无罅隙，江河举目不须愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题仁义寺","author":"吕午","text":"寺以仁义名，当求仁义实。\n祇在毫釐间，遂分儒与释。\n千载几万言，未能合为一。\n大笑出门去，莫问成陈迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吕午","text":"杏城西城翁幽居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吕午","text":"四时鸥鹭窥图画，千古鱼龙听管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题武夷 其二","author":"吕天泽","text":"乘兴来寻杜使君，乱山矗矗白云深。\n武夷仙子能知己，谩写新诗诉此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题武夷 其一","author":"吕天泽","text":"书林追慕紫阳翁，出入尝沾教雨中。\n缅仰高山难企及，大开茅塞径能通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题武夷 其三","author":"吕天泽","text":"南北相看一岭分，长怀欲谒武夷君。\n个中果隐神仙客，握手交谈迥不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院 其一","author":"吕文仲","text":"世世趋庭列雁行，烟萝泉石绕书堂。\n分题月下联书版，聚宴花前献寿觞。\n旌表异恩逢圣代，隐居佳致接仙乡。\n因知孝治垂风化，青史留名道允光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院 其三","author":"吕文仲","text":"君家高谊冠南州，旧辑书堂聚北流。\n此饭未尝轻下客，名园不羡觅封侯。\n挂冠令有陶彭泽，访道人希许远游。\n他年濯缨江海去，终期此日挹浮邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院 其二","author":"吕文仲","text":"簪裾几世住南昌，讲学旌闾晔日光。\n旧里葛山同井邑，远方庐阜出门墙。\n康成业自诗书显，卜世家由孝弟彰。\n二隐昔惭联懿分，同将姓字列东堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禁林宴会之什","author":"吕文仲","text":"青葱温树非尘境，鳌岫金銮近日边。\n石壁天章垂雨露，璇题宸翰动云烟。\n西垣贾马徵辞客，东观蓬瀛集列仙。\n宴喜酡颜飞玉斝，铿锵奋藻擘花笺。\n唐虞盛化高千古，葵藿倾心祝万年。\n自顾薄才诚有愧，不知何以奉群贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日田园杂兴","author":"吕文老","text":"月筒纪闰附青炜，民野陶然化日熙。\n祀备枌榆祈稔岁，宴酣花柳乐清时。\n洛中富贵斜阳恨，绵上勋劳千古思。\n浩兴归来吟不尽，陶诗和后和豳诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吕氏","text":"前身当是陶渊明，爱酒不入远公社。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄犊岭","author":"吕纮","text":"畴昔闻高隐，红尘隔远林。\n间乘黄犊出，踏破白云深。\n自得忘归乐，应多扣角吟。\n如今秋草没，几约与僧寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连州阳山归路三绝 其二","author":"吕本中","text":"稍离烟瘴近湘潭，疾病衰颓已不堪。\n儿女不知来避地，强言风物胜江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海陵病中 其一","author":"吕本中","text":"病知前路资粮少，老觉平生事业非。\n无数青山隔沧海，与谁同往却同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兵乱后自嬄杂诗 其一","author":"吕本中","text":"晚逢戎马际，处处聚兵时。\n后死翻为累，偷生未有期。\n积忧全少睡，经劫抱长饥。\n欲逐范仔辈，同盟起义师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兵乱后自嬄杂诗 其九","author":"吕本中","text":"黄事多反覆，萧兰不辨真。\n汝为误国贼，我作破家人。\n求饱羹无糁，浇愁爵有尘。\n往来梁上燕，相顾却情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兵乱后自嬄杂诗 其十四","author":"吕本中","text":"蜗舍嗟芜没，孤城乱定初。\n篱根留敝屦，屋角得残书。\n云路惭高鸟，渊潜羡巨鱼。\n客来阙佳致，亲为摘山蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事二首 其二","author":"吕本中","text":"病起多情白日迟，强来庭下探花期。\n雪消池馆初春后，人倚栏干欲暮时。\n乱蝶狂蜂俱有意，兔葵燕麦自无知。\n池边垂柳腰肢活，折尽长条为寄谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳州开元寺夏雨","author":"吕本中","text":"风雨翛翛似晚秋，鸦归门掩伴僧幽。\n云深不见千岩秀，水涨初开万壑留。\n钟唤梦回空怅望，人传书到竟沈浮。\n面如田字非吾相，莫羡班超封列侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书","author":"吕本中","text":"老去有馀业，读书空作劳。\n时闻夜虫响，每伴午鸡号。\n久静能忘病，因行得出遨。\n胡为良自苦，膏火自煎熬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后","author":"吕本中","text":"谩遣儿童扫雪开，却穿篱落看春回。\n溪山冷淡泥三尺，故旧飘零酒一杯。\n近买芒鞋供踏雨，更收藜杖与寻梅。\n玉川老去生涯在，时有邻僧送米来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮步至江上","author":"吕本中","text":"客事久输鹦鹉杯，春愁如接凤凰台。\n树阴不碍帆影过，雨气却随潮信来。\n山似故人堪对饮，花如遗恨不重开。\n雪篱风榭年年事，辜负风光取次回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦","author":"吕本中","text":"梦入长安道，萋萋尽春草。\n觉