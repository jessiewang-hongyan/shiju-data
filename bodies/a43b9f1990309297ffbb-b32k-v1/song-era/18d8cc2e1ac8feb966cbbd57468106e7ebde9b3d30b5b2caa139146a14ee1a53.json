[{"title":"偈颂一百零二首 其五十二","author":"释绍昙","text":"智与理冥，神与境会。\n碎维摩床，断毗卢髻。\n碧眼黄头著眼觑，百杂碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十六","author":"释绍昙","text":"一月行空，千门赏玩。\n自己光明，几人著眼。\n马师父子尽力揩磨，不得一半。\n诸人要见真月么，何似破漆碗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十六","author":"释绍昙","text":"拽杖出烟霞，红尘去路赊。\n淡金垂柳线，寒玉点梅花。\n触目分群象，当机裂万差。\n岂不见太原孚上座，楼头吹画角，丧尽泼生涯。\n活与深深掘窖埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十五","author":"释绍昙","text":"有一物，无人识。\n或在东南，或居西北。\n破草鞋跟踏著，价重千金；折拄杖头挑来，分文不直。\n识不识，吴地冬瓜，镇州萝卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十四","author":"释绍昙","text":"触翻茶瓢，眉毛挂剑。\n杀活不分，邪正难辨。\n古今同辙不同途，妙悟玄机辘辘转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十一","author":"释绍昙","text":"十二峰前块石头，雨洗风磨净无染。\n苔衣剥落耿光寒，因甚诸人觑不见。\n覤得见，丈六金身，时时出现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十七","author":"释绍昙","text":"花锦蝶翻红，柳烟莺织晓。\n曾不动机丝，夺尽春工巧。\n玄中玄，妙中妙。\n三世诸佛觑不破，历代祖师穷不到。\n穷得到，寒食清明，家家拜扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十九","author":"释绍昙","text":"瑞岩彻骨穷，最苦冤憎会。\n厨无糁聚蝇，将何物分岁。\n拟烹露地牛，催纳筋角反为忧。\n拟取凤凰髓，伤损太平祥瑞气。\n拟吞栗棘蓬，塞断咽喉气不通。\n拟包铁酸馅，欠紫丝头难措办。\n不如据见定，随家丰俭。\n泉?圣井，盘簇灵芝，鲙缕绿云，饼翻剪月，饭后更煎茶一盏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十","author":"释绍昙","text":"衲僧拄杖头，一升三合米。\n今年春雨多，一饱应难拟。\n觉海山仙，闻如是语。\n怒发冲冠，驱神驾鬼。\n诛云师，扫烟翠。\n放出金乌出海门，且听歌舞乐丰年，只图一个不知恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十一","author":"释绍昙","text":"山鬟风急坠松钗，冷灶凝烟午未斋。\n黄独煨香不能熟，老僧忍冻拾枯柴。\n见成活业，出格安排。\n懒瓒穷不彻，粪火一生埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十六","author":"释绍昙","text":"妙斲鼻头墁，巧运风斤手。\n千圣头边盖覆来，密密绵绵无渗漏。\n不辞合土和灰，成就牛栏马厩。\n只图一个不知恩，噇饭噇眠，易宵为昼。\n翻笑胁尊者，胁不至席不唧?。\n又笑棱道者，坐破七蒲团，驴前马后，至今湖海扬家丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十一","author":"释绍昙","text":"显大机，明大用，六月黄河连底冻。\n千圣不携，已灵不重。\n带角披毛异类行，漆桶漆桶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十九","author":"释绍昙","text":"墅里山前，一棚傀儡。\n个东个西，或进或退。\n打东山鼓乐，断送及时。\n著杨岐戏衫，编排合制。\n虽由行主线牵抽，妙舞三台谁不会。\n谁不会，喝彩一声，鸦飞鹊喙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十一","author":"释绍昙","text":"高价卖生姜，雪真珠满床。\n清贫虽彻骨，富敢斗君王。\n灼然如是，脍身为食，渍血为浆，尽情供养，犹未相当。\n若也未是，和烟耕绿野，枯笛送斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十九","author":"释绍昙","text":"鸩鸟毛，蛊毒水。\n毒不伤人，何妨服饵。\n只有这些儿，含毒喷人，深入骨髓。\n三世诸佛畏之如兔见苍鹰，历代祖师远之如龙怖金翅。\n唯有活衲僧，嗜之如鼎味，粉骨碎身犹未已。\n贪他底，著他底。\n佛也如何救得你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十七","author":"释绍昙","text":"万机休罢住云间，门掩青萝竟日闲。\n时听呜咿歌一曲，倒骑黄犊出松关。\n若作佛法会，锦包特石。\n若作世谛会，铁裹泥团。\n惆怅无人知此意，临风拍碎石阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十二","author":"释绍昙","text":"以大圆觉，为我伽蓝。\n牛头向北，马头向南。\n身心安居，平等性智。\n背负须弥，无息肩地。\n释迦老子，不善用心，掘窖埋人，无一个出头得，只得短气。\n瑞岩一众，善恶不思，机智俱泯。\n青松白石，饱饭憨眠。\n成龙升天，成蛇窜草，一丝毫羁绊他不得。\n凤雏自有冲霄志，肯学鹪鹩恋一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十七","author":"释绍昙","text":"觌体全彰，曾无覆藏。\n蝉声集古寺，鸟影度寒塘。\n眼里无筋，偷观即瞎，耳中有窍，绝听何伤。\n堪笑勤川孟八郎，不知诸佛出身处，错抟量。\n薰风自南来，殿阁生微凉。\n引得傍人斗热荒，鹊石何曾解放光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十五","author":"释绍昙","text":"憎金以黄，谤沉无香。\n达磨不会，历魏游梁。\n更有不识好恶底，齐腰立雪，寄食穷乡，巴峡闻猿空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十七","author":"释绍昙","text":"钵饭糁桃花，釜羹烹野菜。\n吃了日烘烘，曝背茅檐下。\n佛法身心烂似泥，千圣眼觑无缝罅。\n吽吽，伎死禅和，唤起来打。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十九","author":"释绍昙","text":"西风簇浪花，太湖连底冻。\n冷照玉奁清，一片无瑕缝。\n面目分明，眼睛定动。\n不墯虚凝裂万差，漆桶漆桶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十七","author":"释绍昙","text":"百鸟啼春风，村村自花柳。\n揭示目前机，大地人知有。\n随声逐色，活陷重围。\n盖色骑声，翻成窠臼。\n牢关击碎，海岳平沈。\n山鸟自啼花自笑，到头一点不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十二","author":"释绍昙","text":"路隔重湖，一尘不到。\n片段白云，绵蛮幽鸟。\n静倚石阑听，稳拂苔衣卧，此乐只应林下有，人间少。\n衲僧家，眼里著得须弥山，耳里著得四大海，声色堆头，闲行闲坐，全身入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十八","author":"释绍昙","text":"一雨润枯焦，扫尽流金暑。\n薰风殿阁凉，诸佛出身处。\n堪笑勤川无义语，引得花木瓜，变成烂苦瓠。\n走遍衡梅卖与谁，一十三人声怨鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十五","author":"释绍昙","text":"虬龙一滴涎，凤凰五色髓。\n扑扑喷清香，穿却衲僧鼻。\n通身是，遍身是，吾无隐乎尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十一","author":"释绍昙","text":"灵鹫峰前，热血相喷。\n觉城东际，陷坑无底。\n失脚休论后与先，痴翁何似我风颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十八","author":"释绍昙","text":"有服药，甚功效。\n不收肘后方书，不入神农本草。\n善财采处不识真，文殊用之不得妙。\n佛垄信手拈来，百病根源俱扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十九","author":"释绍昙","text":"毒窠蜂，恶相从。\n棒不至心死，喝不到耳聋。\n拨玄枢于机轮转处，丧家私于小玉声中。\n怨无穷，恨无穷。\n有口不能分雪得，一年一度，且听落花啼鸟诉春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十八","author":"释绍昙","text":"祝融峰，万年松。\n翠阴笼鹤，瑞气蟠龙。\n用献圣明天子寿，枝枝叶叶自春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十六","author":"释绍昙","text":"判虚空笔，摛锦绣文。\n光腾万丈，入石三分。\n恶迹既被点破，只得饮气吞声。\n自有傍人道不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十五","author":"释绍昙","text":"四十九年，欺胡谩汉。\n疾入涅槃，救得一半。\n谛观紫磨金色身，涴却娘生眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十七","author":"释绍昙","text":"枕石安眠，山云四屯。\n救不得也，浣盆浣盆。\n更说甚德山临际，棒如雨点，喝似雷奔。\n草迷人去路，月挂客愁村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十一","author":"释绍昙","text":"不可以智知，金刚手把八棱槌。\n不可以识识，镇州出个大萝卜。\n不可以语言造，山禽聚集啼清晓。\n不可以寂默通，赤眼乌龟吞大虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一","author":"释绍昙","text":"大解脱门，无入作处。\n掣断玄关，头头活路。\n信脚何妨行数步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十","author":"释绍昙","text":"小小青山，丛丛翠竹。\n野景无多，怡然纵目。\n明觉老人，向独脱无依处。\n闲坐解疏慵，为静胜所缚。\n拄杖子，一夏同辙不同途。\n见山不是山，居竹不见竹。\n业识忙忙卒未休，忙中解唱阳春曲，欸乃一声山水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十","author":"释绍昙","text":"云居闻板声，见神见鬼。\n瑞岩闻板声，普请瞌睡。\n梦中唤醒主人翁，鼻孔元来在眼底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十二","author":"释绍昙","text":"旱地奔雷，青天撒雨。\n六户不扃，龙无龙句。\n田地稳密底死汗迸流，妙用纵横底寒毛卓竖。\n万别千差透密机，撼动憨眠拄杖子。\n拄杖子喏，老老大大。\n百念灰寒，因甚被人唆使。\n只向道，四皓出商山，汉业归明主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十三","author":"释绍昙","text":"弃万乘金轮，栖六年雪岭。\n相从外道游，不离那伽定。\n无奈凶星照命宫，积世箕裘都丧尽。\n虽云自业所招，且喜因邪打正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五","author":"释绍昙","text":"未入鸡足山，不踏黄梅路。\n恶业苦无多，平白披毛去。\n明眼人前，一场笑具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十四","author":"释绍昙","text":"枯木糁瑶花，虚庭封玉砌。\n少室谩安心，神光空折臂。\n不堕功勋一色边，阑干谁共倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二","author":"释绍昙","text":"德山软顽，云门放憨。\n救不得也，瞿昙瞿昙。\n我也无端入闹篮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十三","author":"释绍昙","text":"薄福住山，浑无暇日。\n忙时直是闲，缓处非常急。\n驱园夫奴子，锄菜地，扫松行；指莫监杨团，拆东篱，补西壁。\n眼前事乱如麻，脚跟下黑如漆。\n蓦有个汉出来道，长老何太区区，只向道，任是七佛祖师，亦无这个消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十六","author":"释绍昙","text":"共饭江湖，何须晙斗。\n含血喷人，先污其口。\n结成不共戴天冤，句句无非是骂门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十","author":"释绍昙","text":"大道无方，至尊无位。\n睿哲文明，垂衣而治。\n尧风舜日万斯年，举世无思不戴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十三","author":"释绍昙","text":"秋叶飘零，秋虫夜鸣。\n色不是色，声不是声。\n达磨九年会不得，急携只履问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十四","author":"释绍昙","text":"借家传帝网丝，下公子仙鳌钓。\n捩转衲僧鼻头，撩拨诸方一笑。\n鲲化鹏飞总未知，推蓬对月平分破。\n却请维那，扬帆鼓棹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十八","author":"释绍昙","text":"大康山，杨浮山。\n撞头搕额，共打乡谈。\n其中切脚无人会，一大藏教，华梵重翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十三","author":"释绍昙","text":"威音前，咸淳后。\n一个黑粼皴，机发牢关透。\n全身游戏生死园林，信脚踏翻圣凡窠臼。\n笑释迦客梦未醒，耻弥勒藩篱未剖。\n客梦醒，藩篱剖，贬入无何有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十六","author":"释绍昙","text":"落寞山家，忙如火急。\n趁晴刈茆，带霜收橘。\n山僧冷地思量，尽把家私狼籍。\n日日日东上，日日日西没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十七","author":"释绍昙","text":"唤作如如，早是变了也。\n那堪世尊拈花，百鸟衔花，南泉一枝花，灵云见桃花，石上栽花。\n总是虚花，且莫眼花。\n野老不知亡国恨，隔江犹唱后庭花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十一","author":"释绍昙","text":"玩犀牛，呼小玉。\n一种风标，十分尘俗。\n勤巴子病入膏肓，老盐官笑含鸩毒。\n花簇簇，锦簇簇，云峰老人曾刮目。\n我从山水窟中来，自谓一生看不足。\n看不足，眨得眼来，云归幽谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十五","author":"释绍昙","text":"有一物，黑似漆，常在面门出入。\n骑声盖色，妙密中险崖。\n倒用逆施，险崖中妙密。\n三世诸佛远之愈亲，白牯狸奴得之转失。\n法华不惜眉毛，为汝当阳拈出。\n夭夭矫矫，粼粼皴皴，将谓南山鳖鼻，却是天台楖?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十六","author":"释绍昙","text":"头上漫漫，脚下漫漫。\n拈掇不得，地阔天宽，老僧住持事繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十八","author":"释绍昙","text":"高不高肤寸，低不低太华。\n深不深蹄涔，浅不浅溟渤。\n法华高低深浅，瞒诸人一点不得。\n诸人高低深浅，亦瞒法华一点不得。\n尽情画断，更莫论量。\n缀钵饭抄云子白，晴瓯茶泛雪花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十四","author":"释绍昙","text":"八月初，何处热。\n出门荒草离披，四壁寒蛩凄切。\n衲僧家眼里著得须弥山，耳里著得四大海。\n声色纯真，只得一橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十八","author":"释绍昙","text":"山木阴阴，寒花浅深。\n巢云鹤怨，挂月猿吟。\n王维妙手画不得，神光徒自觅安心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十五","author":"释绍昙","text":"佛垄山上云，一片三四片。\n忽遇客推门，零乱舒还卷。\n有踪由却没踪由，通身是眼寻难见。\n寻得见，木落千林，光浮碧巘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十","author":"释绍昙","text":"这一粒，甚处生。\n阴阳未判，芽孽先萌。\n开花也一川雪霁，结实也万顷云横。\n收拾归来香满钵，饭馀散步自闲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○一","author":"释绍昙","text":"是是，荆棘丛林，黄金田地。\n非非，伊兰旃卜，甘露蒺藜。\n是不是，非不非，鹤健将雏去，猿闲抱子归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十","author":"释绍昙","text":"拽转十二时，不与诸尘对。\n饱和罗饭，瘦策闲嬉。\n三个成团，四个作队。\n向云坳涧曲，采蕨蕈煎茶，缕笋芹为脍。\n弥勒不知，释迦不会。\n刚被春风透密机，高林破晓莺吟碎。\n眼里闻声，且居门外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十一","author":"释绍昙","text":"生诸冯，御飞龙。\n升平寰宇，舜日尧风。\n林下野人思报德，只凭拄杖为流通。\n云卧难逃至化中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十四","author":"释绍昙","text":"陌上语声喧，贺岁人来去。\n鞦韆擘晓烟，绿盖翻春雾。\n佛法无多，两手分付。\n更问如何与若何，咸淳丙寅正月五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十五","author":"释绍昙","text":"结夏已十日了也，寒山子作么生。\n村诗吟落韵，竹管贮残羹。\n结夏已十日了也，水牯牛作么生。\n爱从荒草去，不向坦途行。\n精神陡顿，头角峥嵘。\n好把一坑埋瘗却，千峰云静月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十三","author":"释绍昙","text":"住院恰周年，日夜荒忙杀。\n园荒手自锄，屋老身惊压。\n费尽心神，百丑千拙。\n翻思三条椽下，噇饭噇眠。\n凡圣情空，心行处灭，赤条条地生涯别。\n生涯别，羊头车子推明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]